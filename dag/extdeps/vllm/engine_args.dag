module extdeps.vllm.engine_args

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { TokenCount, Percent, BasisPoint, basis_point_count, ByteSize, byte_size_count }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vllm.server { VllmSourceRevision, vllm_source_revision_read }

// VLLM'S ENGINE ARGUMENTS AS THE UPSTREAM SHAPE, held apart from extdeps.vllm.server because that
// module owns the SERVED ROUTES and this one owns what the engine is LAUNCHED with. Both cite the
// same pinned revision; neither enumerates the other's population.
//
// WHY THIS MODULE EXISTS AT ALL, stated so it is not read as speculative inventory: gunbc.spark's
// desired row currently fuses WHAT is served with HOW, through an Ollama-only launch profile. The
// second runtime cannot be expressed until its arguments have an authority of their own, and
// extdeps.ollama.api's own header states the rule from the other side -- adding vLLM must not
// require editing that file and must not widen a central product enum.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.vllm.ai/en/latest/configuration/engine_args.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.vllm.engine_args",
      decl_name: "VllmEngineArgs",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE MEMORY FRACTION IS OF THE WHOLE DEVICE POOL, WHICH IS THE FACT THAT COST DAYS ON A SPARK.
// On a discrete-VRAM host `--gpu-memory-utilization` reserves a fraction of VRAM and the host's DRAM
// is untouched. On a GB10 the pool is UNIFIED, so the same fraction reserves that share of the ONE
// 128 GB pool and everything else -- kernel, driver, Ray, vLLM's own CPU side, NCCL buffers -- lives
// in what is left. The flag is identical; its consequence is not, and the difference is a property
// of the HOST's memory kind rather than of this argument. That join is policy and lives in gunbc.
// ── WHAT THE LAUNCH REQUESTS ABOUT MEMORY, INCLUDING WHAT IT DECLINES TO SAY ───────────────────
//
// `VllmMemoryUtilization { fraction: Percent }` STOOD HERE AND COULD NOT SPELL EITHER OF THE TWO
// STATES THIS FLEET ACTUALLY LAUNCHES IN. It was mandatory and integral, so a launch that OMITS
// `--gpu-memory-utilization` -- which is what the GLM canary does -- had no representation at all,
// and the omission had to be recorded somewhere else. It was: a parallel `glm_canary_memory_request`
// carrier said "both omitted" while THIS field, the one the argv is rendered from, still had to name a
// fraction. Two carriers describing one launch's memory, with nothing making them agree, is the fork
// DESIGN section 3 forbids -- and the receipt printed the second while the engine ran the first.
//
// THE INTEGRAL PERCENT WAS THE SECOND DEFECT. The engine's own guidance on this fleet names 0.9112 and
// 0.9288; a Percent cannot carry either, so the type could not express the values upstream prints even
// when a launch does state one.
//
// SO THE REQUEST IS THE FIELD, AND OMISSION IS ONE OF ITS VALUES. Rendering argv, resolving the
// effective value, and identifying the execution profile now read the SAME declaration, which is what
// makes disagreement between them unwritable rather than merely unobserved.
type VllmMemoryRequest {
  utilization: BasisPoint?
  kv_cache_bytes: ByteSize?
}

// PREFIX CACHING IS THE SAME SHAPE: omitted is a real state with a real consequence, and a Boolean
// would have collapsed "this launch said nothing" into "this launch said false".
type VllmPrefixCachingRequest
  = PrefixCachingOmitted
  | PrefixCachingExplicit { enabled: Bool }

// ── THE FLAGS THESE REQUESTS RENDER TO, ONCE, FOR EVERY ROUTE ─────────────────────────────────
//
// THE RENDERING LIVES WITH THE ARGUMENT AND NOT AT EACH LAUNCH SITE. Two serving routes build vLLM
// command lines in this repository, and before this they spelled these flags independently -- the
// pair route emitted a hardcoded `--enable-prefix-caching` string, and the canary emitted nothing.
// Two spellings of one upstream flag is the nicknaming DESIGN section 3 forbids at the wire layer,
// and it is also how the pair route came to render a flag its request did not carry.
//
// AN OMITTED FIELD RENDERS NOTHING, which is what makes omission expressible end to end: the argv,
// the resolved effective value and the profile identity all read the same field, so a launch that
// says nothing cannot acquire a flag on its way to a container.
fn vllm_memory_request_argv(r: VllmMemoryRequest) -> List<String> {
  concat(
    match r.utilization {
      Absent => []
      Present { value: bp } => ["--gpu-memory-utilization", vllm_basis_point_fraction_wire(bp: bp)]
    },
    match r.kv_cache_bytes {
      Absent => []
      Present { value: b } => ["--kv-cache-memory", to_string(byte_size_count(b: b))]
    })
}

// THE FRACTION IS RENDERED AT BASIS-POINT PRECISION, because that is the precision the request
// carries. Rendering 9112 as `0.91` would emit a launch line that does not match the value this
// repository resolved against -- the disagreement this whole shape exists to make unwritable.
//
// AND TRAILING ZEROS ARE TRIMMED, WHICH IS NOT COSMETIC. A zero-padded `0.8200` is numerically the
// `0.82` the pair route has always sent, but it is not the same BYTES -- and the running engine's
// observed launch line (gunbc.spark.pair_serving_observed) carries `0.82`. Convergence compares
// rendered argv against running argv, so padding would have manufactured a drift against a healthy
// server and asked for a restart to fix a difference nobody made. The minimal decimal renders 8200 as
// `0.82` and 9112 as `0.9112`: existing lines keep their bytes, and the new precision costs nothing
// until something asks for it.
fn vllm_basis_point_fraction_wire(bp: BasisPoint) -> String {
  let n = basis_point_count(bp: bp)
  let frac = n % 10000
  if frac == 0 { join([to_string(n / 10000), ".0"], "") }
  else { join([to_string(n / 10000), ".", vllm_trim_fraction(text: vllm_pad_four(n: frac))], "") }
}

fn vllm_pad_four(n: Nat) -> String {
  if n >= 1000 { to_string(n) }
  else if n >= 100 { join(["0", to_string(n)], "") }
  else if n >= 10 { join(["00", to_string(n)], "") }
  else { join(["000", to_string(n)], "") }
}

fn vllm_trim_fraction(text: String) -> String {
  if text.length() > 1 && text.ends_with(suffix: "0") {
    vllm_trim_fraction(text: text.substring(start: 0, end: text.length() - 1))
  } else {
    text
  }
}

// ── THE REQUEST AS AN IDENTITY TERM ───────────────────────────────────────────────────────────
//
// OMISSION GETS ITS OWN SPELLING, not an empty string and not a zero. This key is a component of an
// execution profile's identity, and two launches that differ in whether they NAMED a fraction are
// different launches even when the effective value turns out the same -- one owns the number and one
// inherits whatever the image's revision defaults to. Rendering omission as `omitted` keeps that
// distinction visible in the identity rather than collapsing it into a value nobody requested.
fn vllm_memory_request_key(r: VllmMemoryRequest) -> String {
  join([
    match r.utilization {
      Absent => "util:omitted"
      Present { value: bp } => join(["util:", vllm_basis_point_fraction_wire(bp: bp)], "")
    },
    "/",
    match r.kv_cache_bytes {
      Absent => "kvbytes:omitted"
      Present { value: b } => join(["kvbytes:", to_string(byte_size_count(b: b))], "")
    },
  ], "")
}

fn vllm_prefix_caching_argv(r: VllmPrefixCachingRequest) -> List<String> {
  match r {
    PrefixCachingOmitted => []
    PrefixCachingExplicit { enabled: e } =>
      if e { ["--enable-prefix-caching"] } else { ["--no-enable-prefix-caching"] }
  }
}

// THE KV CACHE DTYPE AS REQUESTED, WHICH IS NOT THE DTYPE AS RESOLVED. Passing `fp8` for a
// DeepSeek MLA checkpoint resolves to `fp8_ds_mla`, and the engine says so on its own startup line.
// A realization that records the REQUESTED spelling and calls it the served format has recorded the
// argument it sent, not the behaviour it got.
// fp8_ds_mla is the DeepSeek MLA-specific fp8 KV layout; read back from the srv6 front door on
// 2026-09-03 (gunbc.spark.vllm_observed) and the operator's pair tuple.
type VllmKvCacheDtypeRequest = KvAuto | KvFp8 | KvFp16 | KvBf16 | KvFp8DsMla

// THE WIRE SPELLINGS, CORRECTED AGAINST THE ENGINE'S OWN CHOICE LIST. This map carried
// KvFp16 => "fp16" and KvBf16 => "bf16", which no consumer had ever sent -- the pair requests fp8
// spellings only -- so the error was invisible until 2026-09-17, when the GLM native arm launched
// with `--kv-cache-dtype bf16` and vLLM v0.28.1rc1.dev580+g385dce36b refused at argument parse:
// `invalid choice: 'bf16' (choose from 'auto', 'bfloat16', 'float16', 'fp8', 'fp8_ds_mla',
// 'fp8_e4m3', 'fp8_e5m2', 'fp8_inc', 'fp8_per_token_head', 'int4_per_token_head',
// 'int8_per_token_head', 'nvfp4', 'nvfp4_4over6', 'nvfp4_ds_mla', 'turboquant_3bit_nc',
// 'turboquant_4bit_nc', 'turboquant_k3v4_nc', 'turboquant_k8v4')`. The engine's list is the
// authority for the two spellings fixed here; the request type remains the five variants any
// consumer has a reason to name, which is why most of that list has no variant.
fn vllm_kv_cache_dtype_wire(request: VllmKvCacheDtypeRequest) -> NonEmptyStr {
  match request {
    KvAuto => "auto" as NonEmptyStr
    KvFp8 => "fp8" as NonEmptyStr
    KvFp16 => "float16" as NonEmptyStr
    KvBf16 => "bfloat16" as NonEmptyStr
    KvFp8DsMla => "fp8_ds_mla" as NonEmptyStr
  }
}

// ── WHETHER A DRAFT MODEL WAS PROPOSING TOKENS, WHICH IS A MEASUREMENT AXIS ────────────────────
//
// WHY THIS IS MODELLED HERE RATHER THAN BESIDE A MEASUREMENT. gunbc.spark.prefill_batch_sweep states
// the consequence in its own prose: "a budget measurement taken with speculation OFF does not
// describe a product served with it ON" -- draft tokens consume the same batch budget, and a step
// that accepts a BURST instead of exactly one decode token has a different felt cadence at the same
// step duration. So a measurement's speculative policy decides whether it transfers, which makes it
// an engine argument like the others rather than a fact about any one experiment.
//
// EVERY ARM IS A POLICY THAT WAS READ. The fleet's existing measurements do not record this, and
// answering "off" for them would be a fabricated default on an axis whose whole purpose is to expire
// a number -- but the fix is not a third arm saying "unread". Absence of a reading is the absence of
// this value, spelled by an optional at the use site; a policy type whose arms include "no policy
// was observed" forces every consumer to carry a bespoke guard for a state the option already has.
type VllmSpeculativePolicy
  = SpeculativeDecodingOff
  | SpeculativeDecodingOn { proposer: NonEmptyStr }

fn vllm_speculative_policy_wire(p: VllmSpeculativePolicy) -> NonEmptyStr {
  match p {
    SpeculativeDecodingOff => "speculation-off" as NonEmptyStr
    SpeculativeDecodingOn { proposer: n } => join(["speculation-on:", n as String], "") as NonEmptyStr
  }
}

type VllmDistributedExecutorBackend = ExecutorMp | ExecutorRay | ExecutorExternalLauncher

fn vllm_distributed_executor_backend_wire(backend: VllmDistributedExecutorBackend) -> NonEmptyStr {
  match backend {
    ExecutorMp => "mp" as NonEmptyStr
    ExecutorRay => "ray" as NonEmptyStr
    ExecutorExternalLauncher => "external_launcher" as NonEmptyStr
  }
}

// ── THE PREFILL SCHEDULING AXIS, WHICH IS A REQUEST AND NOT AN EFFECTIVE VALUE ────────────────
//
// A launch that omits `--max-num-batched-tokens` has NOT thereby chosen a value. This build
// resolves a default from the device-memory probe, the usage context and the parallel
// configuration, and that resolution can be driven by the probe REFUSING rather than answering --
// which is what happens on a GB10 and is modelled at extdeps.vllm.batch_defaults.
//
// So `none` below means UNREQUESTED and nothing more. The effective budget is a different fact
// from the requested one, it is knowable only by reading it back off the running engine, and it
// has its own type over there. Reading absence here as "no chunking" or as any particular number
// is the mistake this field exists to make unwritable.
type ChunkedPrefillRequest
  = ChunkedPrefillRequested
  | ChunkedPrefillNotRequested

type VllmPrefillSchedulingPolicy {
  max_num_batched_tokens: TokenCount
  chunked_prefill: ChunkedPrefillRequest
}

// THE ARGUMENTS A LAUNCH ACTUALLY CARRIES.
type VllmEngineArgs {
  prefill_scheduling: VllmPrefillSchedulingPolicy?
  tensor_parallel_size: Nat
  memory_request: VllmMemoryRequest
  prefix_caching_request: VllmPrefixCachingRequest
  max_model_len: TokenCount
  max_num_seqs: Nat
  kv_cache_dtype: VllmKvCacheDtypeRequest
  distributed_executor_backend: VllmDistributedExecutorBackend
}

// ── VERIFIED NEGATIVES ─────────────────────────────────────────────────────────────────────────
//
// PARSING A FLAG IS NOT ACCEPTANCE, AND ONLY ENGINE-INIT SUCCESS COUNTS. Each row below is a
// configuration the CLI accepts as syntax and the engine then refuses at initialisation, carrying
// the upstream's own error text so the refusal is falsifiable against a version rather than
// remembered. A negative with no error text is a belief; a negative with one is a citation.
type VllmVerifiedNegative {
  subject: NonEmptyStr
  error_text: NonEmptyStr
  observed_at_revision: VllmSourceRevision
}

// nvfp4 KV is unreachable for EVERY MLA model: it is absent from the accepted Literal, so validation
// rejects it before any device work.
data vllm_negative_nvfp4_kv_for_mla: VllmVerifiedNegative = VllmVerifiedNegative {
  subject: "--kv-cache-dtype nvfp4 on an MLA model" as NonEmptyStr,
  error_text: "nvfp4 is not among the accepted kv-cache-dtype values for MLA attention" as NonEmptyStr,
  observed_at_revision: vllm_source_revision_read
}

// Decode context parallelism is refused for a sliding-window backend, which is what this checkpoint
// selects (DEEPSEEK_SPARSE_SWA). The assertion fires at engine init, after the flag parses cleanly.
data vllm_negative_dcp_with_sliding_window: VllmVerifiedNegative = VllmVerifiedNegative {
  subject: "--decode-context-parallel-size with a sliding-window attention backend" as NonEmptyStr,
  error_text: "DCP not support sliding window" as NonEmptyStr,
  observed_at_revision: vllm_source_revision_read
}

// ── THE DO-NOT-SET ROW FOR --max-num-batched-tokens IS WITHDRAWN, AND FOR A LAYER REASON ──────
//
// It read: "on a unified-memory GB10 this only reduces the KV pool; prefill is compute-bound so a
// larger batch buys no throughput". Both halves have now been measured, and the row was wrong in
// its LOCATION before it was wrong in its content.
//
// WHAT THE MEASUREMENT SAID (gunbc.spark.prefill_batch_sweep, four launches, 2026-09-07). "It
// reduces the KV pool" is TRUE and was never the objection: 11,767,856 tokens at 2048 against
// 5,836,755 at 16384. "A larger batch buys no throughput" is NEARLY true -- 7.5% across an 8x
// range -- but the ground offered for it was not: it was inferred from average RoCE link
// utilisation, and a low average is equally consistent with latency-bound collectives or host gaps.
// What the row missed entirely is the axis that actually decides the trade: the budget IS the
// duration of one uninterruptible step, so it sets what a co-tenant decoder waits, measured at
// 30.1ms alone against 2168.2ms beside a cold prefill.
//
// WHY IT IS NOT REPLACED WITH A CORRECTED ROW HERE. Whether to set the flag, and to what, is a
// PRODUCT decision that trades interactive latency against prefill throughput against KV capacity.
// extdeps owns the argument's SHAPE; the policy belongs to the consumer, and modelling it here was
// the layer inversion DESIGN section 3 names. The measured trade and the standing decision live at
// gunbc.spark.prefill_batch_sweep, and the upstream resolution that currently supplies the value in
// the flag's absence lives at extdeps.vllm.batch_defaults.
//
// The `VllmDiscouragedArg` type goes with it: it had exactly one row, and a general "arguments we
// advise against" vocabulary in extdeps is that same inversion waiting for its second instance.

data vllm_verified_negatives: List<VllmVerifiedNegative> = [
  vllm_negative_nvfp4_kv_for_mla,
  vllm_negative_dcp_with_sliding_window,
]

// ── THE READBACK DIRECTION: WHAT A RUNNING ENGINE'S OWN ARGUMENTS SAY ─────────────────────────
//
// WHY THIS LIVES HERE. The projections above render this CLI's flags; reading a value back OUT of a
// rendered argv is the same grammar asked in the other direction, so it is one authority rather than
// two. A consumer that split on "--node-rank" itself would be a second, positional spelling of a
// grammar this module already owns.
//
// AND THIS IS WHAT MAKES THE RANK READABLE AT ALL. Group B's rank order is NOT its address order --
// 192.168.1.236 is rank 0, .237 rank 1, .239 rank 2, .238 rank 3 -- so a reader that derived the rank
// from a host roster would mislabel two of the four ranks and then attribute their readings to each
// other. The rank a container IS, is the one in the argv it was created with, and nothing else.
type VllmArgvValueRead
  = VllmArgvValue { value: String }
  | VllmArgvFlagAbsent
  | VllmArgvFlagWithoutValue
  | VllmArgvFlagRepeated { values: List<String> }

type VllmArgvScan {
  values: List<String>
  awaiting: Bool
}

// A FLAG AT THE END OF THE ARGV WITH NOTHING AFTER IT IS A DISTINCT FACT, not an absent flag. It
// means the argv was truncated or mis-assembled, and reporting it as "not set" would let a readback
// agree with a plan that does not set it either. The scan carries that as `awaiting` still true when
// the list runs out.
//
// ONE LEFT-TO-RIGHT PASS, and the value position is consumed rather than re-searched: a word taken as
// a value is never also read as a flag, so `--node-rank --node-rank` reads as ONE occurrence whose
// value is the literal second word rather than as two occurrences. Indexing into the list per word
// would have made this quadratic for no additional fact.
fn vllm_argv_scan(argv: List<String>, flag: String) -> VllmArgvScan {
  fold(argv, init: VllmArgvScan { values: [], awaiting: false }, f: (acc, word) =>
    if acc.awaiting {
      VllmArgvScan { values: concat(acc.values, [word]), awaiting: false }
    } else if word == flag {
      VllmArgvScan { values: acc.values, awaiting: true }
    } else {
      acc
    })
}

// A FLAG GIVEN TWICE IS REFUSED RATHER THAN RESOLVED. argparse takes the last occurrence, so a
// reader could answer -- but a launch carrying one flag twice is a launch nobody wrote on purpose,
// and silently answering with one of the two values would hide the only evidence that the argv was
// assembled wrong. The refusal carries BOTH values so the reader can see what happened.
fn vllm_argv_value(argv: List<String>, flag: String) -> VllmArgvValueRead {
  let scan = vllm_argv_scan(argv: argv, flag: flag)
  if count(scan.values) > 1 {
    VllmArgvFlagRepeated { values: scan.values }
  } else {
    match scan.values.first() {
      Present { value: v } => VllmArgvValue { value: v }
      Absent => if scan.awaiting { VllmArgvFlagWithoutValue } else { VllmArgvFlagAbsent }
    }
  }
}

fn vllm_argv_value_text(r: VllmArgvValueRead, flag: String) -> String {
  match r {
    VllmArgvValue { value: v } => v
    VllmArgvFlagAbsent => join(["the argv carries no ", flag], "")
    VllmArgvFlagWithoutValue => join(["the argv ends with ", flag, " and no value after it"], "")
    VllmArgvFlagRepeated { values: vs } => join(["the argv carries ", flag, " ", to_string(count(vs)), " times: ", join(vs, ", ")], "")
  }
}

// EVERY FLAG THIS MODULE RENDERS OR READS IS SPELLED HERE ONCE. A consumer that wants to reason about
// one of these arguments -- which axis a changed word sits on, say -- takes the name from this module
// rather than repeating the literal, because a second spelling of a flag is a second authority for
// the grammar this module exists to own, and it drifts silently the first time upstream renames one.
data vllm_node_rank_flag: String = "--node-rank"
data vllm_gpu_memory_utilization_flag: String = "--gpu-memory-utilization"
data vllm_max_num_seqs_flag: String = "--max-num-seqs"

type VllmArgvNatRead
  = VllmArgvNat { value: Nat }
  | VllmArgvNatUnread { cause: NonEmptyStr }

fn vllm_argv_nat(argv: List<String>, flag: String) -> VllmArgvNatRead {
  let read = vllm_argv_value(argv: argv, flag: flag)
  match read {
    VllmArgvValue { value: v } =>
      match parse_int(s: v) {
        Absent => VllmArgvNatUnread { cause: join([flag, " carries ", v, ", which is not an integer"], "") as NonEmptyStr }
        Present { value: n } =>
          if n < 0 {
            VllmArgvNatUnread { cause: join([flag, " carries ", v, ", which is negative"], "") as NonEmptyStr }
          } else {
            VllmArgvNat { value: n }
          }
      }
    VllmArgvFlagAbsent => VllmArgvNatUnread { cause: vllm_argv_value_text(r: read, flag: flag) as NonEmptyStr }
    VllmArgvFlagWithoutValue => VllmArgvNatUnread { cause: vllm_argv_value_text(r: read, flag: flag) as NonEmptyStr }
    VllmArgvFlagRepeated { values: _ } => VllmArgvNatUnread { cause: vllm_argv_value_text(r: read, flag: flag) as NonEmptyStr }
  }
}

fn vllm_argv_node_rank(argv: List<String>) -> VllmArgvNatRead {
  vllm_argv_nat(argv: argv, flag: vllm_node_rank_flag)
}

// ── THE UTILIZATION FRACTION, READ BACK INTO THE BASIS POINTS IT WAS RENDERED FROM ────────────
//
// `vllm_basis_point_fraction_wire` renders 8567 basis points as `0.8567`; this inverts exactly that
// projection, so the two are one grammar and a round trip is a real question. IT REFUSES A FRACTION
// IT CANNOT INVERT EXACTLY: `0.84` is 8400 basis points and `0.856789` is not representable, so the
// second is a refusal rather than a rounding. A readback that rounded would report agreement between
// a plan and a container that were given different numbers.
fn vllm_argv_utilization_basis_points(argv: List<String>) -> VllmArgvNatRead {
  let flag = vllm_gpu_memory_utilization_flag
  let read = vllm_argv_value(argv: argv, flag: flag)
  match read {
    VllmArgvValue { value: v } => vllm_basis_points_of_fraction(text: v, flag: flag)
    VllmArgvFlagAbsent => VllmArgvNatUnread { cause: vllm_argv_value_text(r: read, flag: flag) as NonEmptyStr }
    VllmArgvFlagWithoutValue => VllmArgvNatUnread { cause: vllm_argv_value_text(r: read, flag: flag) as NonEmptyStr }
    VllmArgvFlagRepeated { values: _ } => VllmArgvNatUnread { cause: vllm_argv_value_text(r: read, flag: flag) as NonEmptyStr }
  }
}

fn vllm_basis_points_of_fraction(text: String, flag: String) -> VllmArgvNatRead {
  let parts = split(s: text, delimiter: ".")
  if count(parts) != 2 {
    VllmArgvNatUnread { cause: join([flag, " carries ", text, ", which is not a decimal fraction of the form the renderer produces"], "") as NonEmptyStr }
  } else {
    match parts.first() {
      Absent => VllmArgvNatUnread { cause: join([flag, " carries ", text, ", which has no whole part"], "") as NonEmptyStr }
      Present { value: whole } =>
        match parts |> skip(1) |> first {
          Absent => VllmArgvNatUnread { cause: join([flag, " carries ", text, ", which has no fractional part"], "") as NonEmptyStr }
          Present { value: fraction } =>
            if string_length(s: fraction) > 4 {
              VllmArgvNatUnread { cause: join([flag, " carries ", text, ", whose ", to_string(string_length(s: fraction)), " fractional digits cannot be held exactly in basis points; it is refused rather than rounded"], "") as NonEmptyStr }
            } else {
              match parse_int(s: whole) {
                Absent => VllmArgvNatUnread { cause: join([flag, " carries ", text, ", whose whole part is not an integer"], "") as NonEmptyStr }
                Present { value: w } =>
                  match parse_int(s: vllm_pad_fraction_to_basis_points(fraction: fraction)) {
                    Absent => VllmArgvNatUnread { cause: join([flag, " carries ", text, ", whose fractional part is not an integer"], "") as NonEmptyStr }
                    Present { value: f } =>
                      if w < 0 || f < 0 {
                        VllmArgvNatUnread { cause: join([flag, " carries ", text, ", which is negative"], "") as NonEmptyStr }
                      } else {
                        VllmArgvNat { value: w * 10000 + f }
                      }
                  }
              }
            }
        }
    }
  }
}

// `0.84` is 8400 basis points and NOT 84, so the fractional digits are right-padded to four before
// they are read as a number. This is the inverse of vllm_pad_four above, which is why both live in
// this module: a padding rule split across two modules is a fork that disagrees the first time one
// of them is edited.
fn vllm_pad_fraction_to_basis_points(fraction: String) -> String {
  if string_length(s: fraction) >= 4 {
    fraction
  } else {
    vllm_pad_fraction_to_basis_points(fraction: join([fraction, "0"], ""))
  }
}
