module extdeps.vllm.server

import std.types { Bool, List, NonEmptyStr, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

// VLLM AS ITS OWN UPSTREAM AUTHORITY, for the reason extdeps.ollama.api states from the other side:
// an independently versioned product gets its own module rather than a variant in a generic
// serving-runtime enum. That file says adding vLLM "must not require editing this file, and must not
// widen a central product enum". This is that module, and it was written without touching it.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/vllm-project/vllm"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.vllm.server",
      decl_name: "VllmRoute",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// EVERY FACT BELOW IS BOUND TO ONE BUILD, AND THE REPOSITORY-ROOT ANCHOR ABOVE DOES NOT GROUND THEM.
//
// A project URI is an adequate subject anchor -- it says which product this module is about. It is
// NOT a citation for route populations, executor health behaviour, or what a metric does and does not
// report, because every one of those is version-sensitive and this project moves fast. Carrying the
// exact build the facts were established against is what stops a later reader applying them to a
// different one, and it is what makes them falsifiable: a claim about "vLLM" cannot be checked, and a
// claim about this build can.
// SELF-REPORTED, AND THE NAME NOW SAYS SO. /version returns what the process says about itself. That
// is not a build identity: it is not a digest of the executed image, nothing cross-checks it, and a
// process can report a version string it was not built from. It is adequate for what this module
// uses it for -- distinguishing incarnations and scoping version-sensitive facts -- and inadequate
// for any claim about what code is running, so the type refuses to be called an identity.
type VllmSelfReportedVersion sole_constructor {
  version_string: NonEmptyStr
}

fn vllm_self_reported_version(version_string: NonEmptyStr) -> VllmSelfReportedVersion {
  VllmSelfReportedVersion { version_string: version_string }
}

data vllm_version_reported_2026_09_03: VllmSelfReportedVersion = vllm_self_reported_version(version_string: "0.21.1rc1.dev339+g1967a5627bc3" as NonEmptyStr)

// THE ROUTE SPLIT IS THE LOAD-BEARING FACT IN THIS MODULE, not the route list.
//
// vLLM serves two populations from one port. One answers on an ordinary deployment. The other is
// registered only when the server was LAUNCHED with development mode enabled -- not a capability a
// running server can be asked to grow.
//
// THE NAMES ARE DELIBERATELY WEAKER THAN "ALWAYS". An earlier spelling called the first population
// AlwaysServed, which claims every such route answers on every deployment. That is not establishable
// from having probed one server: /metrics in particular is suppressible by launch configuration. The
// honest distinction is which population a route BELONGS to -- ordinarily registered versus gated
// behind a launch flag -- and that is what decides whether evidence is reachable without a relaunch.
type VllmRoutePopulation
  = OrdinarilyRegistered
  | RegisteredOnlyUnderDevelopmentMode

type VllmRoute sole_constructor {
  path: NonEmptyStr
  population: VllmRoutePopulation
  established_against: VllmSelfReportedVersion
}

fn vllm_route(path: NonEmptyStr, population: VllmRoutePopulation) -> VllmRoute {
  VllmRoute { path: path, population: population, established_against: vllm_version_reported_2026_09_03 }
}

data vllm_route_models: VllmRoute = vllm_route(path: "/v1/models" as NonEmptyStr, population: OrdinarilyRegistered)
data vllm_route_version: VllmRoute = vllm_route(path: "/version" as NonEmptyStr, population: OrdinarilyRegistered)
data vllm_route_health: VllmRoute = vllm_route(path: "/health" as NonEmptyStr, population: OrdinarilyRegistered)
data vllm_route_ping: VllmRoute = vllm_route(path: "/ping" as NonEmptyStr, population: OrdinarilyRegistered)
data vllm_route_metrics: VllmRoute = vllm_route(path: "/metrics" as NonEmptyStr, population: OrdinarilyRegistered)

data vllm_route_server_info: VllmRoute = vllm_route(path: "/server_info" as NonEmptyStr, population: RegisteredOnlyUnderDevelopmentMode)
data vllm_route_get_world_size: VllmRoute = vllm_route(path: "/get_world_size" as NonEmptyStr, population: RegisteredOnlyUnderDevelopmentMode)
data vllm_route_collective_rpc: VllmRoute = vllm_route(path: "/collective_rpc" as NonEmptyStr, population: RegisteredOnlyUnderDevelopmentMode)

// WHAT EACH EVIDENCE ROUTE ACTUALLY ESTABLISHES, WHICH IS NOT THE SAME THING FOR ALL THREE.
//
// Treating them as one interchangeable population is a real defect and this repository committed it:
// a consumer concluded that resolved parallel configuration was in hand because SOME evidence route
// answered. Only one of them returns it.
//
// /get_world_size returns a PRODUCT. A world size of 2 is consistent with TP=2, with PP=2, and with
// DP=2, so on its own it cannot establish a tensor-parallel topology -- it narrows the space without
// deciding it. /collective_rpc fans a named method out across workers, which is evidence about
// POPULATION and says nothing about how the parallelism is decomposed. Only /server_info returns the
// resolved configuration itself.
//
// So the kind travels with the route, and a consumer asking "is the configuration known" must look
// for the configuration-bearing kind rather than for any answer at all.
type VllmEvidenceKind
  = ResolvedParallelConfiguration
  | DerivedWorldSizeProduct
  | PerWorkerFanOut

// THE KIND IS CARRIED ON THE ROUTE, NOT DERIVED BY MATCHING ITS PATH. A first attempt dispatched on
// the path literal, which makes a semantic fact depend on a spelling: rename the route upstream and
// the kind silently becomes the fallback arm, with nothing red. Pairing them at construction means a
// route cannot exist in the evidence population without its kind being stated.
// WHAT AN EVIDENCE ROUTE ACTUALLY RETURNED, WHICH A BOOL CANNOT CARRY.
//
// `answered: Bool` conflates three different states and lets the most important one be inferred: a
// route that 404'd, a route that returned something nobody parsed, and a route that returned a
// resolved configuration are not one bit. The middle case is the dangerous one -- a 200 whose body
// was never read is not knowledge, and a Bool records it identically to a parsed answer.
//
// Only the third arm can move the refusal stage, so an unparsed 200 leaves the refusal exactly where
// a 404 does. That makes the later stage unreachable from production today, which is correct: no
// parser for this payload exists yet, and pretending otherwise is what the Bool allowed.
type VllmResolvedParallelConfigurationCapture sole_constructor {
  tensor_parallel_degree: NonEmptyStr
  pipeline_parallel_degree: NonEmptyStr
  data_parallel_degree: NonEmptyStr
}

fn vllm_resolved_parallel_configuration_capture(
  tensor_parallel_degree: NonEmptyStr,
  pipeline_parallel_degree: NonEmptyStr,
  data_parallel_degree: NonEmptyStr,
) -> VllmResolvedParallelConfigurationCapture {
  VllmResolvedParallelConfigurationCapture {
    tensor_parallel_degree: tensor_parallel_degree,
    pipeline_parallel_degree: pipeline_parallel_degree,
    data_parallel_degree: data_parallel_degree,
  }
}

type VllmEvidenceRouteResponse
  = EvidenceRouteNotServed { http_status: NonEmptyStr }
  | EvidenceRouteAnsweredWithoutParse
  | EvidenceRouteResolvedConfiguration { capture: VllmResolvedParallelConfigurationCapture }

fn vllm_response_establishes_configuration(response: VllmEvidenceRouteResponse) -> Bool {
  match response {
    EvidenceRouteResolvedConfiguration { capture: _ } => true
    EvidenceRouteAnsweredWithoutParse => false
    EvidenceRouteNotServed { http_status: _ } => false
  }
}

type VllmEvidenceRoute sole_constructor {
  route: VllmRoute
  kind: VllmEvidenceKind
}

fn vllm_evidence_route(route: VllmRoute, kind: VllmEvidenceKind) -> VllmEvidenceRoute {
  VllmEvidenceRoute { route: route, kind: kind }
}

fn vllm_evidence_kind_establishes_configuration(kind: VllmEvidenceKind) -> Bool {
  match kind {
    ResolvedParallelConfiguration => true
    DerivedWorldSizeProduct => false
    PerWorkerFanOut => false
  }
}

// The routes capable of answering a distributed-topology question. Named as a set because that is
// the fact consumers need: not "these three paths exist" but "the parallel question is answerable
// ONLY from this population", which is what makes its unavailability a vantage limit.
data vllm_evidence_route_server_info: VllmEvidenceRoute = vllm_evidence_route(route: vllm_route_server_info, kind: ResolvedParallelConfiguration)
data vllm_evidence_route_get_world_size: VllmEvidenceRoute = vllm_evidence_route(route: vllm_route_get_world_size, kind: DerivedWorldSizeProduct)
data vllm_evidence_route_collective_rpc: VllmEvidenceRoute = vllm_evidence_route(route: vllm_route_collective_rpc, kind: PerWorkerFanOut)

data vllm_parallel_evidence_routes: List<VllmEvidenceRoute> = [
  vllm_evidence_route_server_info,
  vllm_evidence_route_get_world_size,
  vllm_evidence_route_collective_rpc,
]

data vllm_routes: List<VllmRoute> = [
  vllm_route_models, vllm_route_version, vllm_route_health, vllm_route_ping, vllm_route_metrics,
  vllm_route_server_info, vllm_route_get_world_size, vllm_route_collective_rpc,
]

// /health DOES NOT PROBE DISTRIBUTED WORKERS UNDER THE RAY EXECUTOR, and this row exists so nobody
// reads a 200 as if it did.
//
// THE FACT IS BACKEND-BOUND, WHICH THE FIRST VERSION OF THIS ROW MISSED. It is not a property of the
// health route; it is a property of a particular executor's implementation of engine health, which
// assumes its workers are healthy and returns without contacting them, marked by upstream's own TODO.
// A different executor may probe. So the row names the backend it holds for, and a consumer asking
// about some other backend gets no answer here rather than a borrowed one.
// Two arms because vLLM genuinely has more than one distributed executor and they do not share this
// behaviour -- which is the whole reason the fact is backend-bound rather than route-bound.
type VllmExecutorBackend
  = RayDistributedExecutor
  | MultiprocessingDistributedExecutor

type VllmHealthWorkerCoverage
  = HealthDoesNotProbeDistributedWorkers
  | HealthProbesEveryDistributedWorker

type VllmHealthCoverageFact sole_constructor {
  backend: VllmExecutorBackend
  coverage: VllmHealthWorkerCoverage
  established_against: VllmSelfReportedVersion
}

data vllm_ray_health_coverage: VllmHealthCoverageFact = VllmHealthCoverageFact {
  backend: RayDistributedExecutor,
  coverage: HealthDoesNotProbeDistributedWorkers,
  established_against: vllm_version_reported_2026_09_03,
}

// WHICH EVIDENCE MAY ESTABLISH KV CAPACITY -- AS A DECISION OVER PROPOSED EVIDENCE, NOT AS A CHOICE
// BETWEEN TWO SIMULTANEOUS FACTS.
//
// An earlier spelling was a coproduct whose arms were `GroupAwareStartupLogLine` and
// `BlockCountTimesMinimumBlockSizeIsNotCapacity`. Those are not alternatives -- BOTH hold at once:
// the startup line IS the authority AND the multiplication is NOT. Selecting one arm therefore left
// the rejection carried by prose and by the spelling of an uninhabited alternative, which is the
// decorative-wall shape this repository refuses.
//
// As a decision it becomes executable: propose a kind of evidence, get an admission or a typed
// refusal, and both directions are reachable from a test. THE REFUSAL IS ALSO STATED AS THE GENERAL
// LAW rather than as an arithmetic complaint -- for a uniform cache layout the product may happen to
// be numerically right, and a rule that says "this product is wrong" would be falsified by that
// coincidence. What is universally true is that those two cache-config fields are not a GENERALLY
// SUFFICIENT authority, because a multi-group layout can carry per-group block sizes the gauge's
// resolved minimum does not represent.
// THE ADMISSION CARRIES THE CAPTURE IT ADMITS, WHICH IS WHAT STOPS IT BEING VACUOUS.
//
// An earlier version admitted a bare GroupAwareStartupLogCapture arm with no payload. That is an
// admission of nothing: it says a KIND of evidence would be acceptable, which no capacity claim can
// ever be built from, so the positive direction was permanently unreachable and the decision was a
// refusal wearing two arms. Carrying the parsed capture means admitting requires having one.
type VllmGroupAwareCapacityCapture sole_constructor {
  pool_tokens: NonEmptyStr
  per_request_tokens: NonEmptyStr
}

fn vllm_group_aware_capacity_capture(
  pool_tokens: NonEmptyStr,
  per_request_tokens: NonEmptyStr,
) -> VllmGroupAwareCapacityCapture {
  VllmGroupAwareCapacityCapture { pool_tokens: pool_tokens, per_request_tokens: per_request_tokens }
}

type VllmCapacityEvidenceProposal
  = GroupAwareStartupLogCapture { capture: VllmGroupAwareCapacityCapture }
  | CacheConfigBlockFields

type VllmCapacityEvidenceVerdict
  = CapacityEvidenceAdmitted { capture: VllmGroupAwareCapacityCapture }
  | CapacityEvidenceRefused { cause: String }

fn decide_vllm_capacity_evidence(proposal: VllmCapacityEvidenceProposal) -> VllmCapacityEvidenceVerdict {
  match proposal {
    GroupAwareStartupLogCapture { capture: c } => CapacityEvidenceAdmitted { capture: c }
    CacheConfigBlockFields =>
      CapacityEvidenceRefused {
        cause: "cache-config block fields are not a generally sufficient KV capacity authority: the gauge reports a resolved MINIMUM block size across ranks, and a multi-group cache layout can carry per-group block sizes and windows that minimum does not represent, so the product is not the engine's group-aware capacity even where it coincides with it",
      }
  }
}
