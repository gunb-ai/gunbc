module extdeps.vllm.memory_profile

import std.types { String, Bool, List, NonEmptyStr, Int }
import std.algebra { trim }
import std.nat { Nat }
import std.measure { BasisPoint, ByteSize, byte_size }
import extdeps.vllm.server { VllmSourceRevision }

// THE MEMORY-PROFILE LINE PRINTS TWO KINDS OF NUMBER, AND TYPING THEM ALIKE WOULD FABRICATE
// PRECISION. Measured on the GLM canary's line, exactly two figures are exact: the byte arguments of
// the two `--kv-cache-memory` recommendations. Every other term -- device total, startup availability,
// requested envelope, consumed, peak activation, graph, current KV -- is printed as a rounded GiB
// value with two decimals, and there is no byte figure behind them anywhere in the log.
//
// THE ROUNDED TERMS DO NOT RECONCILE, AND THAT IS EXPECTED RATHER THAN A DEFECT. On this launch
// 82.52 + 7.42 + 0.1 + 22.02 = 112.06 against a stated envelope of 111.95. The residual is real but
// the arithmetic is performed upstream in bytes and only then rounded for display, so a consumer that
// summed these and refused on the mismatch would be refusing the ROUNDING, not the engine. Any
// admission arithmetic must therefore run on the exact recommendation bytes or on separately observed
// device totals -- never on these readings.
//
// SO THE ROUNDED HALF IS CARRIED AS WHAT IT IS: a printed reading, in hundredths of a gibibyte,
// beside the literal text it came from. It is comparable and orderable, which is all a rounded figure
// honestly supports, and it cannot be mistaken for a byte count by any consumer because it is not one.
type GibibyteReading sole_constructor {
  hundredths: Nat
}

fn gibibyte_reading(hundredths: Nat) -> GibibyteReading {
  GibibyteReading { hundredths: hundredths }
}

fn gibibyte_reading_hundredths(r: GibibyteReading) -> Nat {
  r.hundredths
}

// ── THE READING ────────────────────────────────────────────────────────────────────────────────
//
// EVERY FIELD NAME CARRIES ITS TEMPORAL MEANING, because the terms are not the same KIND of quantity
// and the earlier report treated them as one table of comparable numbers. `startup_available` is an
// instantaneous allocatability estimate -- on unified memory this vLLM reads host MemAvailable, which
// includes reclaimable memory and is NOT an inventory of resident bytes. `peak_activation` is a
// headroom figure, not a persistent allocation. `current_kv` is an allocated pool. The two
// recommendations are derived candidates, not settings.
//
// THE CAPTURED TEXT IS RETAINED, not summarised. A receipt that kept only the parsed fields could not
// be re-read when a later revision reworded the line, and the digest of the capture is what lets a
// consumer decide whether two receipts describe the same observation.
type VllmMemoryProfileReading sole_constructor {
  device_total: GibibyteReading
  startup_available: GibibyteReading
  requested_utilization: BasisPoint
  requested_envelope: GibibyteReading
  persistent_consumed: GibibyteReading
  peak_activation_headroom: GibibyteReading
  cudagraph_allocated: GibibyteReading
  current_kv: GibibyteReading
  recommended_kv_within_requested_envelope: ByteSize
  recommended_kv_using_startup_availability: ByteSize
  captured_text: NonEmptyStr
  observed_at_revision: VllmSourceRevision
}

// THE RECOMMENDATIONS ARE THE ONLY EXACT TERMS, AND NEITHER IS A POLICY. The larger one is what the
// engine calculates would fully use the device given the availability IT OBSERVED AT THAT LAUNCH; the
// smaller is what fits inside the requested envelope. Reading either as capacity, as proven-safe, or
// as an amount permanently unused is the error this type exists to prevent -- they are candidates for
// a selection decision that has not been made, bound to one launch's snapshot.
type VllmKvRecommendation
  = KvRecommendationWithinRequestedEnvelope
  | KvRecommendationUsingStartupAvailability

fn vllm_kv_recommendation_bytes(r: VllmMemoryProfileReading, which: VllmKvRecommendation) -> ByteSize {
  match which {
    KvRecommendationWithinRequestedEnvelope => r.recommended_kv_within_requested_envelope
    KvRecommendationUsingStartupAvailability => r.recommended_kv_using_startup_availability
  }
}

// ── THE PARSE ──────────────────────────────────────────────────────────────────────────────────
//
// TOTAL AND REFUSING: every term is required, and a line missing any one of them yields Unreadable
// rather than a receipt with plausible fields. That is the whole reason to parse rather than transcribe
// -- a hand-filled receipt cannot tell "the engine did not print this" from "nobody typed it".
//
// THE ANCHORS ARE THE LINE'S OWN PUNCTUATION, not offsets. A position would rot the first time upstream
// added a clause; the delimiters below are the phrases the sentence is built from, and their ABSENCE is
// what a reworded line produces -- which refuses, loudly, instead of silently reading the wrong number.
type VllmMemoryProfileParse
  = VllmMemoryProfileParsed { reading: VllmMemoryProfileReading }
  | VllmMemoryProfileUnreadable { captured_text: String, cause: NonEmptyStr }

// A ROUNDED GIB FIGURE BECOMES HUNDREDTHS, and the decimal places vary. The line prints 114.93, 82.52
// and also 0.1 -- one digit, not two -- so a parse that assumed two places would read 0.1 as 0.01 and
// under-report CUDAGraph memory by a factor of ten. The fractional part is scaled by its own length.
fn parse_gib_hundredths(text: String) -> Nat? {
  let fields = split(s: trim(s: text), delimiter: ".")
  if fields.length() == 1 {
    parse_gib_whole_only(whole_text: fields.first())
  } else if fields.length() == 2 {
    parse_gib_whole_and_fraction(whole_text: fields.first(), fraction_text: fields.skip(n: 1).first())
  } else {
    none
  }
}

fn parse_gib_whole_only(whole_text: String) -> Nat? {
  match parse_int(s: whole_text) {
    Absent => none
    Present { value: whole } => parse_gib_combine(whole: whole, frac: 0, digits: 2)
  }
}

fn parse_gib_whole_and_fraction(whole_text: String, fraction_text: String) -> Nat? {
  match parse_int(s: whole_text) {
    Absent => none
    Present { value: whole } => parse_gib_with_whole(whole: whole, fraction_text: fraction_text)
  }
}

fn parse_gib_with_whole(whole: Int, fraction_text: String) -> Nat? {
  match parse_int(s: fraction_text) {
    Absent => none
    Present { value: frac } => parse_gib_combine(whole: whole, frac: frac, digits: length(fraction_text))
  }
}

fn parse_gib_combine(whole: Int, frac: Int, digits: Int) -> Nat? {
  if whole < 0 || frac < 0 { none }
  else if digits == 1 { Present { value: whole * 100 + frac * 10 } }
  else if digits == 2 { Present { value: whole * 100 + frac } }
  else { none }
}

// THE TEXT BETWEEN TWO ANCHORS, or nothing. Both anchors must be present and in order; a caller
// receiving `none` has learned the line does not have the shape this parser was written against.
fn between(text: String, open: String, close: String) -> String? {
  let after = split(s: text, delimiter: open)
  if after.length() < 2 { none }
  else {
    let tail = split(s: after.skip(n: 1).first(), delimiter: close)
    if tail.length() < 2 { none } else { Present { value: tail.first() } }
  }
}

fn parse_gib_between(text: String, open: String, close: String) -> Nat? {
  match between(text: text, open: open, close: close) {
    Absent => none
    Present { value: inner } => parse_gib_hundredths(text: inner)
  }
}

// THE TWO EXACT FIGURES. These are the only byte counts the line prints, and the only terms any
// admission arithmetic may use -- every other number in the sentence is a rounded rendering whose sum
// deliberately does not reconcile.
fn parse_kv_recommendation_bytes(text: String, occurrence: Nat) -> Nat? {
  let parts = split(s: text, delimiter: "--kv-cache-memory=")
  if parts.length() < occurrence + 1 { none }
  else {
    match parse_int(s: split(s: parts.skip(n: occurrence).first(), delimiter: "`").first()) {
      Absent => none
      Present { value: b } => if b < 0 { none } else { Present { value: b } }
    }
  }
}

fn vllm_parse_memory_profile(
  captured_text: String,
  requested_utilization: BasisPoint,
  observed_at_revision: VllmSourceRevision,
) -> VllmMemoryProfileParse {
  match parse_gib_between(text: captured_text, open: "Free memory on device (", close: "/") {
    Absent => VllmMemoryProfileUnreadable { captured_text: captured_text, cause: "no startup-available figure in `Free memory on device (`" as NonEmptyStr }
    Present { value: avail } =>
      match parse_gib_between(text: captured_text, open: "/", close: " GiB) on startup") {
        Absent => VllmMemoryProfileUnreadable { captured_text: captured_text, cause: "no device-total figure before ` GiB) on startup`" as NonEmptyStr }
        Present { value: total } =>
          match parse_gib_between(text: captured_text, open: "Actual usage is ", close: " GiB for consumed memory") {
            Absent => VllmMemoryProfileUnreadable { captured_text: captured_text, cause: "no consumed-memory figure after `Actual usage is `" as NonEmptyStr }
            Present { value: consumed } => vllm_parse_memory_profile_rest(
              captured_text: captured_text, requested_utilization: requested_utilization,
              observed_at_revision: observed_at_revision, avail: avail, total: total, consumed: consumed)
          }
      }
  }
}

fn vllm_parse_memory_profile_rest(
  captured_text: String,
  requested_utilization: BasisPoint,
  observed_at_revision: VllmSourceRevision,
  avail: Nat,
  total: Nat,
  consumed: Nat,
) -> VllmMemoryProfileParse {
  match parse_gib_between(text: captured_text, open: "), ", close: " GiB for peak activation") {
    Absent => VllmMemoryProfileUnreadable { captured_text: captured_text, cause: "no peak-activation figure before ` GiB for peak activation`" as NonEmptyStr }
    Present { value: activation } =>
      match parse_gib_between(text: captured_text, open: "and ", close: " GiB for CUDAGraph memory") {
        Absent => VllmMemoryProfileUnreadable { captured_text: captured_text, cause: "no CUDAGraph figure before ` GiB for CUDAGraph memory`" as NonEmptyStr }
        Present { value: graph } =>
          match parse_gib_between(text: captured_text, open: "Current kv cache memory in use is ", close: " GiB") {
            Absent => VllmMemoryProfileUnreadable { captured_text: captured_text, cause: "no current-KV figure after `Current kv cache memory in use is `" as NonEmptyStr }
            Present { value: kv } => vllm_parse_memory_profile_recommendations(
              captured_text: captured_text, requested_utilization: requested_utilization,
              observed_at_revision: observed_at_revision, avail: avail, total: total,
              consumed: consumed, activation: activation, graph: graph, kv: kv)
          }
      }
  }
}

fn vllm_parse_memory_profile_recommendations(
  captured_text: String,
  requested_utilization: BasisPoint,
  observed_at_revision: VllmSourceRevision,
  avail: Nat, total: Nat, consumed: Nat, activation: Nat, graph: Nat, kv: Nat,
) -> VllmMemoryProfileParse {
  match parse_gib_between(text: captured_text, open: ", ", close: " GiB). Actual usage") {
    Absent => VllmMemoryProfileUnreadable { captured_text: captured_text, cause: "no requested-envelope figure before ` GiB). Actual usage`" as NonEmptyStr }
    Present { value: envelope } =>
  match parse_kv_recommendation_bytes(text: captured_text, occurrence: 1) {
    Absent => VllmMemoryProfileUnreadable { captured_text: captured_text, cause: "no first --kv-cache-memory recommendation" as NonEmptyStr }
    Present { value: fit } =>
      match parse_kv_recommendation_bytes(text: captured_text, occurrence: 2) {
        Absent => VllmMemoryProfileUnreadable { captured_text: captured_text, cause: "no second --kv-cache-memory recommendation" as NonEmptyStr }
        Present { value: full } =>
          VllmMemoryProfileParsed { reading: VllmMemoryProfileReading {
            device_total: gibibyte_reading(hundredths: total),
            startup_available: gibibyte_reading(hundredths: avail),
            requested_utilization: requested_utilization,
            requested_envelope: gibibyte_reading(hundredths: envelope),
            persistent_consumed: gibibyte_reading(hundredths: consumed),
            peak_activation_headroom: gibibyte_reading(hundredths: activation),
            cudagraph_allocated: gibibyte_reading(hundredths: graph),
            current_kv: gibibyte_reading(hundredths: kv),
            recommended_kv_within_requested_envelope: byte_size(count: fit),
            recommended_kv_using_startup_availability: byte_size(count: full),
            captured_text: captured_text as NonEmptyStr,
            observed_at_revision: observed_at_revision,
          } }
      }
  }
  }
}
