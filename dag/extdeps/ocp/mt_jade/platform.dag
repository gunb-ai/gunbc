fn clock_tree_contains_part_number(nodes: List<ClockTreeNode>, part: std.types.NonEmptyStr) -> Bool {
  fold(nodes, init: false, f: fn(acc, n) {
    acc || ((n.ordering_part_number as String) == (part as String))
  })
}

fn reference_part_roles_include(rows: List<MtJadeReferencePartRow>, wanted: ReferencePartRole) -> Bool {
  fold(rows, init: false, f: fn(acc, r) { acc || r.role == wanted })
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = mt_jade_model_scope
