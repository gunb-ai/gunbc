module extdeps.ocp.mt_jade.platform


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.ocp.mt_jade.subject.mt_jade_subject_authority_anchor

data platform_subject_edge_note: String = "PLATFORM FACTS MUST JOIN THE ENTITY THEY DESCRIBE IN THE GRAPH, NOT ONLY THE SHARED OCP LOCATOR. extdeps.ocp.mt_jade.subject owns mt_jade_reference_platform; this row is the typed subject edge that binds every mechanical, sequencing, CPLD, clock and reference-part fact in this module to that declaration — the same pattern as extdeps.sec.issuer.gitlab_facts gitlab_facts_subject."

data mt_jade_platform_subject: extdeps.ocp.mt_jade.subject.MtJadeReferencePlatform = mt_jade_reference_platform

data platform_note: String = "PLATFORM FACTS FROM THE PUBLIC OCP MT. JADE SPECIFICATION, REV 1.0 (2021-09-17). Section 7.2 carries the motherboard outline; section 7.3 names the ILM4926 socket; section 7.10 carries clocks, reset and power-on sequence; sections 7.6–7.8 carry BMC, I2C, JTAG and GPIO facts that define the board CPLD's role. Nothing here transcribes pin tables or Appendix A/B content."

// SECTION 7.2 AND 7.3 CARRY THE BOARD ENVELOPE AND SOCKET DESIGNATION. Micrometres are used so
// 479.36 mm is exact rather than rounded — the specification quotes 428 mm by 479.36 mm.
type MtJadeMotherboardMechanical {
  outline_width: std.measure.Micrometer
  outline_depth: std.measure.Micrometer
  cpu_socket_designation: std.types.NonEmptyStr
  processor_socket_count: Int
  ddr4_dimms_total: Int
}

data mt_jade_motherboard_mechanical: MtJadeMotherboardMechanical = MtJadeMotherboardMechanical {
  outline_width: micrometer(count: 428000),
  outline_depth: micrometer(count: 479360),
  cpu_socket_designation: "ILM4926",
  processor_socket_count: 2,
  ddr4_dimms_total: 32,
}

// THE SOCKET ROLES ARE NAMED IN THE SPEC'S POWER-ON NARRATIVE. Socket 0 is the master socket
// whose firmware must start first; socket 1 is the slave socket whose reset release is gated
// through the board CPLD after master-socket firmware asserts ALERT9_N and pulses ALERT3_N.
type ProcessorSocketRole
  = MasterSocket
  | SlaveSocket

fn processor_socket_role_name(role: ProcessorSocketRole) -> std.types.NonEmptyStr {
  match role {
    MasterSocket => "socket0 master"
    SlaveSocket => "socket1 slave"
  }
}

// THE PER-SOCKET RAIL ORDER IS CITED VERBATIM FROM SECTION 7.10.3. It is a closed ordered list
// rather than a free-form string because the specification gives an explicit enable sequence and
// a design that reorders rails is not implementing the same platform even if the rail names look
// similar.
type ProcessorPowerRail
  = VddSoc
  | VddRcax
  | Vdd1v8Soc
  | VddhRcax
  | VddhRcbx
  | VddqDdr0123_4567
  | Vdd3v3Soc

fn processor_power_rail_name(rail: ProcessorPowerRail) -> std.types.NonEmptyStr {
  match rail {
    VddSoc => "VDD_SOC"
    VddRcax => "VDD_RCAx"
    Vdd1v8Soc => "VDD1V8_SOC"
    VddhRcax => "VDDH_RCAx"
    VddhRcbx => "VDDH_RCBx"
    VddqDdr0123_4567 => "VDDQ_DDR0123/4567"
    Vdd3v3Soc => "VDD3V3_SOC"
  }
}

data processor_power_rail_enable_order: List<ProcessorPowerRail> = [
  VddSoc,
  VddRcax,
  Vdd1v8Soc,
  VddhRcax,
  VddhRcbx,
  VddqDdr0123_4567,
  Vdd3v3Soc,
]

// SOC_PWRGD must be asserted for more than thirty-two system clock cycles before the reset
// release chain continues. The count is carried as an Int from the cited text rather than as a
// duration because the specification states a cycle count against the system clock, not a time.
data soc_pwrgd_minimum_system_clock_cycles: Int = 32

// THE RESET AND FIRMWARE-HANDSHAKE CHAIN AFTER POWER GOOD. These are separate named steps
// rather than one "booted" Bool because each step has a different owner and a different remedy
// when it fails.
type PlatformSequencingHandshake
  = SocPwrgdObserved { socket: ProcessorSocketRole }
  | SysResetReleased { socket: ProcessorSocketRole }
  | TimerResetReleased { socket: ProcessorSocketRole }
  | PcpRailEnabled { socket: ProcessorSocketRole }
  | PcpPwrgdObserved { socket: ProcessorSocketRole }
  | SlaveStartHandshake {
      alert9_asserted: Bool,
      alert3_one_microsecond_pulse: Bool,
      cpld_releases_slave_sys_reset: Bool,
    }

// THE SLAVE-SOCKET START PULSE IS A TYPED DURATION, not prose beside a Bool. Section 7.10.3
// names a one-microsecond delay on ALERT3_N; carrying it as Microsecond makes the unit part of
// the fact rather than a comment that a reader could misread as a cycle count or an arbitrary
// delay.
data slave_socket_alert3_pulse_width: std.measure.Microsecond = microsecond(count: 1)

data platform_sequencing_handshake_chain: List<PlatformSequencingHandshake> = [
  SocPwrgdObserved { socket: MasterSocket },
  SysResetReleased { socket: MasterSocket },
  TimerResetReleased { socket: MasterSocket },
  TimerResetReleased { socket: SlaveSocket },
  PcpRailEnabled { socket: MasterSocket },
  PcpPwrgdObserved { socket: MasterSocket },
  SlaveStartHandshake {
    alert9_asserted: true,
    alert3_one_microsecond_pulse: true,
    cpld_releases_slave_sys_reset: true,
  },
  PcpRailEnabled { socket: SlaveSocket },
]

// THE BOARD CPLD IS NOT A FOURTH FIRMWARE STACK — it is glue logic between processors, BMC and
// PCIe devices. The specification spreads the facts across GPIO, JTAG, reset and clock sections;
// this coproduct is the single authority for what the CPLD DOES so product layers do not re-list
// responsibilities in prose.
type MtJadeBoardCpldResponsibility
  = CpuBmcGpioVoltageIsolation
  | CpuJtagDaisyChainMux
  | BmcJtagMasterProgramsCpld
  | PciePerstDecodeFromCpuGpio
  | GlobalTimerClockGeneration
  | SlaveSocketSysResetReleaseGating
  | SysResetPathWithBmc

fn mt_jade_board_cpld_responsibility_name(r: MtJadeBoardCpldResponsibility) -> std.types.NonEmptyStr {
  match r {
    CpuBmcGpioVoltageIsolation => "CPU/BMC GPIO voltage isolation"
    CpuJtagDaisyChainMux => "CPU JTAG daisy-chain mux and single-socket bypass"
    BmcJtagMasterProgramsCpld => "BMC JTAG master programs CPLD image"
    PciePerstDecodeFromCpuGpio => "PCIe PERST decode from six CPU GPIO bits per socket"
    GlobalTimerClockGeneration => "50 MHz oscillator to dual 25 MHz processor timer clocks"
    SlaveSocketSysResetReleaseGating => "slave socket SYS_RESET release after ALERT9/ALERT3 handshake"
    SysResetPathWithBmc => "SYS_RESET_L orchestration with BMC GPIO"
  }
}

data mt_jade_board_cpld_responsibilities: List<MtJadeBoardCpldResponsibility> = [
  CpuBmcGpioVoltageIsolation,
  CpuJtagDaisyChainMux,
  BmcJtagMasterProgramsCpld,
  PciePerstDecodeFromCpuGpio,
  GlobalTimerClockGeneration,
  SlaveSocketSysResetReleaseGating,
  SysResetPathWithBmc,
]

// CLOCK TREE ROWS NAME THE PART, THE FREQUENCY WHERE THE SPEC DOES, AND THE CONSUMERS. The
// specification sometimes groups a generator and buffer sentence; here each cited part number is
// its own row so a future board that swaps one generator does not fork the entire tree.
type ClockTreeNodeRole
  = ProcessorPcieReferenceClock
  | ProcessorSerdesReferenceClock
  | PcieFanoutClock
  | BmcAndNicProgrammableClock
  | ProcessorUartBaudClock
  | CrystalReferenceInput

type ClockTreeNode {
  ordering_part_number: std.types.NonEmptyStr
  vendor_label: std.types.NonEmptyStr
  role: ClockTreeNodeRole
  output_frequency: std.measure.Hertz?
  consumers: List<std.types.NonEmptyStr>
}

// THE CPLD'S TIMER CLOCKS ARE NOT A PURCHASED PART ROW. Section 7.10.1 states the CPLD divides a
// board 50 MHz oscillator into two 25 MHz synchronous processor timer clocks; modelling that as
// an ordering part number would invent a component the specification does not name.
type CpldDerivedClock {
  input_frequency: std.measure.Hertz
  output_frequency: std.measure.Hertz
  consumers: List<std.types.NonEmptyStr>
}

data mt_jade_cpld_timer_clock: CpldDerivedClock = CpldDerivedClock {
  input_frequency: hertz(count: 50000000),
  output_frequency: hertz(count: 25000000),
  consumers: [
    "master socket global timer clock",
    "slave socket global timer clock",
  ],
}

