// REFERENCE PART PRECEDENT — the OCP spec names specific orderable parts for several platform
// roles. This is the pattern later board articles should cite rather than retyping part numbers
// in product-layer prose.
type ReferencePartRole
  = BaseboardManagementController
  | BootI2cEeprom
  | HostQspiFlash
  | BmcSpiFlash
  | BmcEthernetPhy
  | PcieClockGenerator
  | PcieClockBuffer
  | ProgrammableClockGenerator

type MtJadeReferencePartRow {
  ordering_part_number: std.types.NonEmptyStr
  vendor_label: std.types.NonEmptyStr
  role: ReferencePartRole
  authority: extdeps.external_authority.ExternalAuthority
}

// THE OCP REFERENCE-PART ROW NAMES AST2500 IN PROSE; THE CHIP FACTS LIVE IN THE ASPEED
// AUTHORITY. This edge joins the platform BMC role to extdeps.bmc.aspeed_ast2500 rather than
// retyping the part number as the only source of chip identity.
data mt_jade_bmc_chip_catalog: extdeps.bmc.aspeed_ast2500.AspeedAst2500CatalogRow = aspeed_ast2500_catalog

