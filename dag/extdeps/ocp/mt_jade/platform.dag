fn clock_tree_contains_part_number(nodes: List<ClockTreeNode>, part: NonEmptyStr) -> Bool {
  fold(nodes, init: false, f: fn(acc, n) {
    acc || ((n.ordering_part_number as String) == (part as String))
  })
}

fn reference_part_roles_include(rows: List<MtJadeReferencePartRow>, wanted: ReferencePartRole) -> Bool {
  fold(rows, init: false, f: fn(acc, r) { acc || r.role == wanted })
}

// FEATURE LIST AND SECTION 7.2: FAN CONNECTOR POPULATIONS ARE CHASSIS-HEIGHT SPECIFIC. The
// motherboard carries both connector sets; a 2U chassis uses six 6056 dual-rotor fans and a 1U
// chassis uses eight 4056 dual-rotor fans. PWM/TACH in Table 9 restates the same split.
type MtJadeFanConnectorPopulation {
  chassis_height: RackUnit
  connector_count: Nat
  frame_width: Millimeter
  frame_thickness: Millimeter
  dual_rotor: Bool
}

data mt_jade_fan_connectors_2u: MtJadeFanConnectorPopulation = MtJadeFanConnectorPopulation {
  chassis_height: rack_unit(count: 2),
  connector_count: 6,
  frame_width: millimeter(count: 60),
  frame_thickness: millimeter(count: 56),
  dual_rotor: true,
}

data mt_jade_fan_connectors_1u: MtJadeFanConnectorPopulation = MtJadeFanConnectorPopulation {
  chassis_height: rack_unit(count: 1),
  connector_count: 8,
  frame_width: millimeter(count: 40),
  frame_thickness: millimeter(count: 56),
  dual_rotor: true,
}

// FEATURE LIST: DUAL CRPS, 1+1, HOT-PLUG. The specification names the PSU mechanical class and
// redundancy and does not name IEC 60320 sheet, AC voltage range, or a wattage rating of any
// fitted module. Inventing C14 vs C20 from "CRPS" would be a fabricated inlet.
type MtJadeCrpsPower {
  psu_count: Int
  redundancy_label: NonEmptyStr
  hot_plug: Bool
}

data mt_jade_crps_power: MtJadeCrpsPower = MtJadeCrpsPower {
  psu_count: 2,
  redundancy_label: "1+1",
  hot_plug: true,
}

data mt_jade_crps_ac_inlet: CitedFigureStanding = TranscribedUncited {
  read_obligation: "OCP Mt. Jade Rev 1.0 names two CRPS connectors and 1+1 hot-plug redundancy. It does not name an IEC 60320 inlet (C14 vs C20), a 120 V vs 200-240 V rating, or the cord the seller ships. Discriminator: a photograph or FRU of the fitted PSU face, or a PSU ordering part whose own datasheet names the inlet and AC range.",
}

// FEATURE LIST: "MGMT 1x 1GbE from BMC to Rear RJ45 Connector". Section 7.6.1 names BMC ETH at
// 10/100/1000 and RTL8211E as the PHY (already a reference-part row). Bottom-side I/O is common
// between 1U and 2U: BMC UART/ETH/VGA sit with the power-supply end of the board.
type MtJadeBmcManagementNetwork {
  network: OnboardNetworkController
  location_label: NonEmptyStr
}

data mt_jade_bmc_management_network: MtJadeBmcManagementNetwork = MtJadeBmcManagementNetwork {
  network: OnboardNetworkController {
    controller: NamedOnboardController { part: "RTL8211E" },
    port_count: 1,
    per_port_bandwidth: bandwidth(count: 1000000000),
    purpose: "BMC manageability",
  },
  location_label: "rear RJ45, power-supply / bottom-side I/O",
}

// FEATURE LIST "BMC AMI MegaRAC, OpenBMC" IS A DISJUNCTION, NOT A DEFAULT. The specification
// names both stacks. A unit's family is a workflow observation (gunbc.machine_intake_access),
// never this row. megaRAC_* folds may run only after AmiMegaRac is observed.
type MtJadeCitedBmcFirmwareOption
  = CitedAmiMegaRac
  | CitedOpenBmc

data mt_jade_cited_bmc_firmware_options: List<MtJadeCitedBmcFirmwareOption> = [
  CitedAmiMegaRac,
  CitedOpenBmc,
]

fn mt_jade_cited_bmc_firmware_options_include(
  options: List<MtJadeCitedBmcFirmwareOption>,
  wanted: MtJadeCitedBmcFirmwareOption,
) -> Bool {
  fold(options, init: false, f: fn(acc, o) { acc || o == wanted })
}

data extdeps_model_scope: ExternalModelScope = mt_jade_model_scope
