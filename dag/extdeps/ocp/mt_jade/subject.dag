  OcpContributionLicenseAgreement,
  ExcludedNonNormativeAppendix,
  AppendixA,
  AppendixB,
}

// THE LOCATOR IS THE CITATION; READ PROVENANCE IS SEPARATE. An unauthenticated fetch of
// www.opencompute.org/documents/open-compute-specification-mt-jade-rev-1-0-pdf-1 returned HTTP
// 403 on 2026-08-14. Facts in extdeps.ocp.mt_jade were therefore read from operator-supplied
// specification text, not from this repository retrieving the PDF. Recording that honestly is
// what keeps the citation from pretending to be an independent fetch receipt.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.opencompute.org/documents/open-compute-specification-mt-jade-rev-1-0-pdf-1"
  }
}

data mt_jade_subject_note: String = "MT. JADE AS AN OCP-ACCEPTED REFERENCE PLATFORM, NOT AS A PACKAGE FACT. extdeps.cpu.ampere_altra_package correctly separates the public Altra package datasheet from the NDA reference-board collateral listing Mt. Jade among four Ampere boards. This module is the third axis: the OCP-published motherboard specification, which names platform architecture facts without being the full Customer Connect design-file drop. THE PUBLISHER LOCATOR REMAINS THE CITATION EVEN WHEN UNREACHABLE: an unauthenticated fetch returned HTTP 403 on 2026-08-14 and that refusal is recorded separately from operator-supplied specification text that grounds extdeps.ocp.mt_jade.platform facts. THE LICENCE IS WHAT MAKES PUBLIC MODELLING ADMISSIBLE: usage is under OWFa 1.0 (Open Web Foundation Final Specification Agreement), contributions are under the OCP Contribution License Agreement, and the licence explicitly does NOT apply to the Appendices — they are reference-only and non-normative, so no fact in this repository may be attributed to Appendix A or Appendix B."

type MtJadeRev1_0 {}

type MtJadeSpecificationRevision = MtJadeRev1_0

data mt_jade_specification_version_label: NonEmptyStr = "v1.0"

data mt_jade_specification_publication_date: SpecificationDocumentDate = SpecificationDocumentDate {
  year: 2021,
  month: 9,
  day: 17,
}

data mt_jade_specification_license: OcpSpecificationLicense = Owfa1_0FinalSpecificationAgreement {}

data mt_jade_contribution_license: OcpContributionLicense = OcpContributionLicenseAgreement {}

data mt_jade_excluded_non_normative_appendices: List<ExcludedNonNormativeAppendix> = [
  AppendixA {},
  AppendixB {},
]

data mt_jade_publisher_citation_read_provenance: SpecificationCitationReadProvenance = DocumentLocatorFetchRefused {
  http_status: 403,
  detail: "unauthenticated fetch of the OCP publisher document locator returned 403; the publisher copy remains unread in this repository",
}

data mt_jade_ingested_citation_read_provenance: SpecificationCitationReadProvenance = OperatorSuppliedDocumentText {}

type MtJadeReferencePlatform {
  marketing_name: NonEmptyStr
  revision: MtJadeSpecificationRevision
  version_label: NonEmptyStr
  publication_date: SpecificationDocumentDate
  contributor: Vendor<Hardware>
  specification_license: OcpSpecificationLicense
  contribution_license: OcpContributionLicense
  excluded_appendices: List<ExcludedNonNormativeAppendix>
  publisher_citation_read_provenance: SpecificationCitationReadProvenance
  ingested_citation_read_provenance: SpecificationCitationReadProvenance
}

data mt_jade_reference_platform: MtJadeReferencePlatform = MtJadeReferencePlatform {
  marketing_name: "Mt. Jade",
  revision: MtJadeRev1_0 {},
  version_label: mt_jade_specification_version_label,
  publication_date: mt_jade_specification_publication_date,
  contributor: ampere_vendor,
  specification_license: mt_jade_specification_license,
  contribution_license: mt_jade_contribution_license,
  excluded_appendices: mt_jade_excluded_non_normative_appendices,
  publisher_citation_read_provenance: mt_jade_publisher_citation_read_provenance,
  ingested_citation_read_provenance: mt_jade_ingested_citation_read_provenance,
}

data mt_jade_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ocp.mt_jade.subject",
      decl_name: "mt_jade_reference_platform",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

data extdeps_model_scope: ExternalModelScope = mt_jade_model_scope
