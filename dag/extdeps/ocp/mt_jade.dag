module extdeps.ocp.mt_jade

import std.types { NonEmptyStr }
import std.measure { Micrometer, micrometer }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.opencompute.org/documents/open-compute-specification-mt-jade-rev-1-0-pdf-1"
  }
}

// Ampere Altra/AltraMax Motherboard Specification v1.0, contributed to OCP and licensed OWFa 1.0,
// read 2026-08-14. TWO FACTS, NEITHER OF THEM A PART NUMBER. Section 12 Mechanical names the
// ILM4926 socket as soldered on the motherboard to hold the CPU -- an Independent Loading
// Mechanism designation with 4926 contacts, a socket TYPE, not a vendor, not an orderable part,
// and not a land pattern. Section 7.2 Motherboard Placement states the Mt. Jade board is 428 mm
// wide by 479.36 mm deep and fits an EIA 19 inch 1U/2U rack. Those dimensions describe Mt. Jade,
// which is dual-socket with 32 DIMMs; they are not an outline for a different board.
// THE PACKAGE LINE IN THE SAME SPEC, 77 mm by 67 mm with 4926 pins, corroborates the datasheet
// mechanicals already cited in extdeps.cpu.ampere_altra_package and is not transcribed here -- a
// second, rounded copy would be a nickname for a more precise authority.
data ilm4926_designation: NonEmptyStr = "ILM4926"

data mt_jade_board_width: Micrometer = micrometer(count: 428000)

data mt_jade_board_depth: Micrometer = micrometer(count: 479360)

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ocp.mt_jade",
      decl_name: "ilm4926_designation",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
