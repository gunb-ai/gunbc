  OcpContributionLicenseAgreement,
}

// MT. MITCHELL IS A SEPARATELY GOVERNED OCP SPECIFICATION, NOT A REVISION OF MT. JADE.
// Ampere and Inspur contributed it as an improvement on the Jade reference platform; the open-
// licence family matches extdeps.ocp.mt_jade, but the document authority, version row and any
// future ingested facts live here rather than being folded into the Jade module.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.opencompute.org/documents/mt-mitchell-ocp-hardware-spec-v0-80-2-pdf",
  }
}

data internet_archive_mt_mitchell_capture_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "web.archive.org/web/20221026103641id_/https://www.opencompute.org/documents/mt-mitchell-ocp-hardware-spec-v0-80-2-pdf",
  }
}

data mt_mitchell_subject_note: String = "OCP-CONTRIBUTED REFERENCE PLATFORM SPECIFICATION FOR MT. MITCHELL. Usage is under the same OWFa 1.0 / OCP CLA family as Mt. Jade when the document is admitted. THE PUBLISHER LOCATOR REMAINS THE CITATION EVEN WHEN UNREACHABLE: an unauthenticated fetch returned HTTP 403 on 2026-08-14 and that refusal is recorded separately from a dated Internet Archive capture of the same URL that peer session neat-hawk-428 read in full. THIS MODULE IS THE SUBJECT ANCHOR ONLY; PLATFORM FACTS ARE OWNED BY extdeps.ocp.mt_mitchell.platform AND LAND IN #8260, GROUNDED ON THE MIRROR INGEST BELOW — NOT ON A CLAIM THAT THE PUBLISHER COPY WAS READ."

type MtMitchellRev0_80 {}

type MtMitchellSpecificationRevision = MtMitchellRev0_80

data mt_mitchell_specification_version_label: NonEmptyStr = "v0.80"

data mt_mitchell_specification_license: OcpSpecificationLicense = Owfa1_0FinalSpecificationAgreement {}

data mt_mitchell_contribution_license: OcpContributionLicense = OcpContributionLicenseAgreement {}

data mt_mitchell_publisher_citation_read_provenance: SpecificationCitationReadProvenance = DocumentLocatorFetchRefused {
  http_status: 403,
  detail: "unauthenticated fetch of the OCP publisher document locator returned 403; the publisher copy remains unread in this repository",
}

data internet_archive_mt_mitchell_capture_date: SpecificationDocumentDate = SpecificationDocumentDate {
  year: 2022,
  month: 10,
  day: 26,
}

data mt_mitchell_mirror_citation_read_provenance: SpecificationCitationReadProvenance = DatedPublisherLocatorMirrorTextIngested {
  mirror: internet_archive_mt_mitchell_capture_authority,
  capture_date: internet_archive_mt_mitchell_capture_date,
  peer_session: "neat-hawk-428",
  detail: "full PDF text of the dated Internet Archive capture of the publisher locator was decoded by peer session neat-hawk-428; this is a second artifact from the publisher copy and may not match what the publisher serves today",
}

type MtMitchellReferencePlatform {
  marketing_name: NonEmptyStr
  revision: MtMitchellSpecificationRevision
  version_label: NonEmptyStr
  contributor: Vendor<Hardware>
  specification_license: OcpSpecificationLicense
  contribution_license: OcpContributionLicense
  publisher_citation_read_provenance: SpecificationCitationReadProvenance
  mirror_citation_read_provenance: SpecificationCitationReadProvenance
}

data mt_mitchell_reference_platform: MtMitchellReferencePlatform = MtMitchellReferencePlatform {
  marketing_name: "Mt. Mitchell",
  revision: MtMitchellRev0_80 {},
  version_label: mt_mitchell_specification_version_label,
  contributor: ampere_vendor,
  specification_license: mt_mitchell_specification_license,
  contribution_license: mt_mitchell_contribution_license,
  publisher_citation_read_provenance: mt_mitchell_publisher_citation_read_provenance,
  mirror_citation_read_provenance: mt_mitchell_mirror_citation_read_provenance,
}

data mt_mitchell_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ocp.mt_mitchell.subject",
      decl_name: "mt_mitchell_reference_platform",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [internet_archive_mt_mitchell_capture_authority],
}

data extdeps_model_scope: ExternalModelScope = mt_mitchell_model_scope
