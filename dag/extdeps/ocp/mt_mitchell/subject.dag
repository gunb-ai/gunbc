module extdeps.ocp.mt_mitchell.subject

import std.types { String, NonEmptyStr, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.vendor.ampere { ampere_vendor }
import extdeps.publication {
  SpecificationDocumentDate,
  SpecificationCitationReadProvenance,
}
import extdeps.ocp.publication {
  OcpSpecificationLicense,
  OcpContributionLicense,
