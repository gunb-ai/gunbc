    publication_date: extdeps.publication.SpecificationDocumentDate { year: 2022, month: 9, day: 9 },
  },
]

// ARCHITECTURE OPTIONS (section 7.4). The specification states three, and they
// are a closed set: a socket-and-DIMM combination outside them is unspecified
// rather than a smaller version of a supported one. DIMMs per channel is
// DERIVED from the option instead of stored, so an option whose slot count does
// not divide by its channel count fails a join rather than reading plausibly.
type MtMitchellArchitectureOption {
  socket_count: std.integer.Int
  ddr_channels_per_socket: std.integer.Int
  dimm_slot_total: std.integer.Int
}

data mt_mitchell_two_socket_eight_channel: MtMitchellArchitectureOption = MtMitchellArchitectureOption {
  socket_count: 2,
  ddr_channels_per_socket: 8,
  dimm_slot_total: 32,
}

data mt_mitchell_two_socket_twelve_channel: MtMitchellArchitectureOption = MtMitchellArchitectureOption {
  socket_count: 2,
  ddr_channels_per_socket: 12,
  dimm_slot_total: 24,
}

data mt_mitchell_one_socket_twelve_channel: MtMitchellArchitectureOption = MtMitchellArchitectureOption {
  socket_count: 1,
  ddr_channels_per_socket: 12,
  dimm_slot_total: 24,
}

data mt_mitchell_architecture_options: List<MtMitchellArchitectureOption> = [
  mt_mitchell_two_socket_eight_channel,
  mt_mitchell_two_socket_twelve_channel,
  mt_mitchell_one_socket_twelve_channel,
]

fn architecture_channel_total(option: MtMitchellArchitectureOption) -> std.integer.Int {
  option.socket_count * option.ddr_channels_per_socket
}

fn architecture_dimms_per_channel(option: MtMitchellArchitectureOption) -> std.integer.Int {
  option.dimm_slot_total / architecture_channel_total(option: option)
}

fn architecture_slot_count_divides_channels(option: MtMitchellArchitectureOption) -> Bool {
  let per_channel = architecture_dimms_per_channel(option: option)
  let channels = architecture_channel_total(option: option)
  (per_channel * channels) == option.dimm_slot_total
}

// MEMORY (section 7.1 feature table): DDR5 RDIMM with ECC.
data mt_mitchell_memory_generation: extdeps.memory.types.DramGeneration = dram_generation_ddr5

data mt_mitchell_dimm_buffering: extdeps.memory.types.DimmBuffering = Registered

data mt_mitchell_dimm_ecc_required: Bool = true

// EXPANSION (sections 7.1 and 7.5): the board's PCIe generation is Gen5.
data mt_mitchell_pcie_generation: extdeps.storage.types.PcieGeneration = Gen5

// CONNECTORS (section 7.2). Thirteen MCIO connectors, six carrying CPU0 PCIe
// ports and seven carrying CPU1 ports; the total is derived so the document's
// own cross-foot is the check rather than three independent literals.
data mt_mitchell_mcio_connectors_cpu0: std.integer.Int = 6

data mt_mitchell_mcio_connectors_cpu1: std.integer.Int = 7

data mt_mitchell_mcio_connector_total: std.integer.Int = 13

fn mt_mitchell_derived_mcio_connector_total() -> std.integer.Int {
  mt_mitchell_mcio_connectors_cpu0 + mt_mitchell_mcio_connectors_cpu1
}

// OCP 3.0 NIC connectors (sections 7.2 and 7.5.2.4): two SFF-TA-1002 4C+
// connectors, each reaching one of three states decided by which jumper is
// strapped. Single-host x8 is the UNSTRAPPED state named by the specification,
// not a fallback the board falls back to, and host count is separate from lane
// width because the two x16 states differ only in host count.
type OcpNicHostMode
  = SingleHostX8
  | SingleHostX16
  | MultiHostX16

data mt_mitchell_ocp_nic_connector_count: std.integer.Int = 2

data mt_mitchell_ocp_nic_connector_family: std.types.NonEmptyStr = "SFF-TA-1002 4C+"

fn ocp_nic_host_mode_lane_count(mode: OcpNicHostMode) -> std.integer.Int {
  match mode {
    SingleHostX8 => 8
    SingleHostX16 => 16
    MultiHostX16 => 16
  }
}

fn ocp_nic_host_mode_is_multi_host(mode: OcpNicHostMode) -> Bool {
  match mode {
    SingleHostX8 => false
    SingleHostX16 => false
    MultiHostX16 => true
  }
}

fn ocp_nic_unstrapped_host_mode() -> OcpNicHostMode {
  SingleHostX8
}

// INTER-PROCESSOR LINKS (section 7.5.1, Table 6). Four root-complex ports carry
// inter-processor links in the dual-socket configuration: S0_RC0, S0_RC5,
// S1_RC3 and S1_RC6. The port identities are carried rather than a bare count
// of four, because a count cannot be checked against the table it came from.
type MtMitchellInterProcessorLinkPort
  = Socket0RootComplex0
  | Socket0RootComplex5
  | Socket1RootComplex3
  | Socket1RootComplex6

data mt_mitchell_inter_processor_link_ports: List<MtMitchellInterProcessorLinkPort> = [
  Socket0RootComplex0,
  Socket0RootComplex5,
  Socket1RootComplex3,
  Socket1RootComplex6,
]

fn inter_processor_link_socket(port: MtMitchellInterProcessorLinkPort) -> std.integer.Int {
  match port {
    Socket0RootComplex0 => 0
    Socket0RootComplex5 => 0
    Socket1RootComplex3 => 1
    Socket1RootComplex6 => 1
  }
}

// MANAGEMENT (sections 7.1 and 7.6): a discrete ASPEED AST2600 BMC carried on a
// DC-SCM 1.0 module rather than soldered to the motherboard. Placement is part
// of the fact because a board built to this specification must provide the
// module connector, not a BMC site.
type MtMitchellBmcPlacement
  = BmcOnDcScmModule { module_revision: std.types.NonEmptyStr }

data mt_mitchell_bmc_part: std.types.NonEmptyStr = "ASPEED AST2600"

data mt_mitchell_bmc_placement: MtMitchellBmcPlacement = BmcOnDcScmModule {
  module_revision: "DC-SCM 1.0",
}

// MECHANICAL (section 7.2). Micrometres keep 424.9 mm and 422.9 mm exact: both
// are tenths of a millimetre, so a millimetre-grained carrier would have had to
// round the specification's own figures.
data mt_mitchell_board_width: std.measure.Micrometer = micrometer(count: 424900)

data mt_mitchell_board_depth: std.measure.Micrometer = micrometer(count: 422900)

data mt_mitchell_chassis_height: std.measure.RackUnit = rack_unit(count: 2)

data mt_mitchell_master_socket_boot_note: String = "Section 7.2: the master CPU socket sits on the right side of the motherboard and is REQUIRED to boot the system when a single CPU is populated. That is an asymmetry between the two sockets, so a dual-socket board with one socket filled is not the one-socket architecture option — it is a specific population of the dual-socket board, and which socket is filled decides whether it boots at all."

data mt_mitchell_coverage_note: String = "WHAT THIS MODULE MODELS AND WHAT IT LEAVES IN THE DOCUMENT. MODELLED: the revision table; the three architecture options and their memory generation, buffering and ECC requirement; the expansion generation; the MCIO and OCP NIC connector populations and host modes; the inter-processor link ports; BMC part and placement; board outline and chassis height. NOT MODELLED: the connector pin definition tables (7.5.2.1 through 7.5.2.5), the I2C network, GPIO and debug interface maps (7.6 through 7.8), clocks, reset and power-on sequencing (7.10), thermal requirements (8), the I/O and rear-side subsystems (9 and 10), the power delivery block diagram (12), environmental and prescribed-materials sections (13 and 14), and the appendices, which the licence itself excludes as non-normative. The per-pin tables are exactly the material a board bring-up will need; they are not carried on speculation, and the consumer that needs one is what earns its transcription."
