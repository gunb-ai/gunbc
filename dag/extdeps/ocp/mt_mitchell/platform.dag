module extdeps.ocp.mt_mitchell.platform


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = mt_mitchell_subject_authority_anchor

data platform_subject_edge_note: String = "THE SPECIFICATION IDENTITY IS NOT RE-DECLARED HERE. extdeps.ocp.mt_mitchell.subject owns the marketing name, revision, version label, contributor and licence rows; this module carries the board facts the specification states and binds them to that declaration through the subject edge below — the extdeps.ocp.mt_jade.platform shape. Mt. Mitchell and the Ampere Altra Platform Hardware Design Specification stay separate authorities for the reason DESIGN section 3 gives: OCP publishes and licenses this document under the Open Web Foundation agreements with its own revision series and contributor population, Ampere publishes the other under a proprietary marking, and neither may require editing the other's module. Nothing here dispatches between them and neither module imports the other; a consumer that needs both joins them downstream. This module likewise does not widen extdeps.boards.types BaseboardModel — adding a board must not edit a generic product enum."

data mt_mitchell_platform_subject: extdeps.ocp.mt_mitchell.subject.MtMitchellReferencePlatform = mt_mitchell_reference_platform

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.ocp.mt_mitchell.subject",
      decl_name: "mt_mitchell_reference_platform",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.ocp.mt_mitchell.platform.extdeps_external_authority_anchor,
  further_citations: [internet_archive_mt_mitchell_capture_authority]
}

data mt_mitchell_ingestion_note: String = "READ, NOT RECALLED — AND READ FROM A CAPTURE, NOT FROM THE PUBLISHER. The publisher locator is the anchor because that is where the document lives, and an unauthenticated fetch of it returned HTTP 403 on 2026-08-14; the bytes behind every row here came from the dated Internet Archive capture of that same URL, which the subject module owns as internet_archive_mt_mitchell_capture_authority and this module cites rather than re-mints (review 51969). Saying we read Mt. Mitchell without that distinction would assert we read the publisher copy, which we did not. The licence is what makes carrying it admissible: usage is under the Open Web Foundation Modified Final Specification Agreement quoted in the document's own licence section, and that section states the licence does NOT apply to the Appendices, which are reference-only and non-normative. No row in this module is attributed to an appendix. The revision-table rows below are the document's section 3 and are carried because the subject module fixes ONE revision label: the series is what makes 0.80 the current one rather than a bare string, and a later revision would join against these rows instead of silently replacing a literal."

// THIS DOCUMENT'S OWN PUBLICATION STATUS. An OCP contribution is public under
// an explicit open licence its publisher wrote down, which is a different KIND
// of status from the Ampere specification's public-but-marked — same permission
// today, different provenance, and kept distinct so the mapping can diverge in
// one place rather than being reconstructed from prose.
data mt_mitchell_publication_status: extdeps.publication.DocumentPublicationStatus = extdeps.publication.PubliclyPublishedUnderOpenLicense {
  license: "Open Web Foundation Modified Final Specification Agreement (OWFa 1.0)",
}

type OcpSpecificationRevisionRow {
  revision: std.types.NonEmptyStr
  publication_date: extdeps.publication.SpecificationDocumentDate
}

data mt_mitchell_revision_table: List<OcpSpecificationRevisionRow> = [
  OcpSpecificationRevisionRow {
    revision: "0.50",
    publication_date: extdeps.publication.SpecificationDocumentDate { year: 2022, month: 6, day: 6 },
  },
  OcpSpecificationRevisionRow {
