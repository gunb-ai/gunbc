module extdeps.standards.rfc_8118



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc8118#section-3"
  }
}

data iso_32000_2_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.iso.org/standard/75839.html"
  }
}

data rfc_8118_normative_relationship_note: String = "RFC 8118 (Informational, March 2017) specifies PDF Open Parameters for fragment identifiers and OBSOLETES RFC 3778. Where RFC 8118 and ISO 32000-2 disagree on PDF document semantics, ISO 32000-2 controls — cited as iso_32000_2_authority in extdeps_model_scope.further_citations. This module models the upstream RFC 8118 section-3 vocabulary and wire semantics only. gunbc product admission policy lives in gunbc.citation.pdf_safe_profile."

// RFC 8118 section 3: PDF fragment parameters are an ORDERED sequence separated by ampersand; later parameters override earlier ones. Parameter values may be URI-encoded (RFC 8118); wire serialization routes through extdeps.uri uri_percent_encode_component.
data citation_cit1_witness_split_note: String = "CIT-1 witnesses split across citation_cit1_witness_test and citation_cit1_consumer_witness_test because extdeps_external_authority_anchor is not module-scoped in v1-seed. dissolve-on: namespace-only resolution lane gives declarations module-scoped identity so one witness file can import both rfc_8118 and sysv_amd64 without homonym shadowing."

type NavigableUriRefusalCause
  = BaseLocatorAlreadyCarriesFragment { locator: std.types.NonEmptyStr }
  | PdfOpenParameterPercentEncodeRefused {
      parameter: PdfProfileParameter,
      cause: extdeps.uri.UriPercentEncodeRefusalCause,
    }
  | CitationSelectorConstructionRefused { cause: std.citation.SelectorRefusalCause }

type NavigableUriProjection
  = NavigableUriProjected { uri: extdeps.uri.Uri }
  | NavigableUriRefused { cause: NavigableUriRefusalCause }

data rfc_8118_section_3_locator: std.types.NonEmptyStr = "www.rfc-editor.org/rfc/rfc8118#section-3" as std.types.NonEmptyStr

data rfc_8118: std.types.NonEmptyStr = "RFC 8118"

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.standards.rfc_8118",
      decl_name: "rfc_8118",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [iso_32000_2_authority],
}

type PdfOpenPage {
  page: std.integer.PositiveInt
}

type PdfOpenNamedDest {
  name: std.types.NonEmptyStr
}

type PdfOpenStructElem {
  struct_id: std.types.NonEmptyStr
}

type PdfOpenZoom {
  scale_percent: std.integer.PositiveInt
}

type PdfOpenComment {
  comment_id: std.types.NonEmptyStr
}

type PdfOpenView {
  keyword: std.types.NonEmptyStr
  position: String
}

type PdfOpenViewRect {
  left: std.integer.PositiveInt
  top: std.integer.PositiveInt
  width: std.integer.PositiveInt
  height: std.integer.PositiveInt
}

type PdfOpenHighlight {
  left: std.integer.PositiveInt
  right: std.integer.PositiveInt
  top: std.integer.PositiveInt
  bottom: std.integer.PositiveInt
}

type PdfOpenSearch {
  words: std.types.NonEmptyStr
}

type PdfOpenFdf {
  uri: extdeps.uri.Uri
}

type PdfProfileParameter
  = OpenPage(PdfOpenPage)
  | OpenNamedDest(PdfOpenNamedDest)
  | OpenStructElem(PdfOpenStructElem)
  | OpenZoom(PdfOpenZoom)
  | OpenComment(PdfOpenComment)
  | OpenView(PdfOpenView)
  | OpenViewRect(PdfOpenViewRect)
  | OpenHighlight(PdfOpenHighlight)
  | OpenSearch(PdfOpenSearch)
  | OpenFdf(PdfOpenFdf)

type PdfProfileParameterConstruction
  = ParameterConstructed(PdfProfileParameter)

type PdfOpenParameterSequence {
  parameters: List<PdfProfileParameter>
}

type PdfOpenParameterSequenceConstruction
  = SequenceConstructed(PdfOpenParameterSequence)

fn pdf_open_page(page: std.integer.PositiveInt) -> PdfProfileParameterConstruction {
  ParameterConstructed(OpenPage(PdfOpenPage { page: page }))
}

fn pdf_open_nameddest(name: std.types.NonEmptyStr) -> PdfProfileParameterConstruction {
  ParameterConstructed(OpenNamedDest(PdfOpenNamedDest { name: name }))
}

fn pdf_open_structelem(struct_id: std.types.NonEmptyStr) -> PdfProfileParameterConstruction {
  ParameterConstructed(OpenStructElem(PdfOpenStructElem { struct_id: struct_id }))
}

fn pdf_open_zoom(scale_percent: std.integer.PositiveInt) -> PdfProfileParameterConstruction {
  ParameterConstructed(OpenZoom(PdfOpenZoom { scale_percent: scale_percent }))
}

fn pdf_open_comment(comment_id: std.types.NonEmptyStr) -> PdfProfileParameterConstruction {
  ParameterConstructed(OpenComment(PdfOpenComment { comment_id: comment_id }))
}

fn pdf_open_view(keyword: std.types.NonEmptyStr, position: String) -> PdfProfileParameterConstruction {
  ParameterConstructed(OpenView(PdfOpenView { keyword: keyword, position: position }))
}

fn pdf_open_viewrect(left: std.integer.PositiveInt, top: std.integer.PositiveInt, width: std.integer.PositiveInt, height: std.integer.PositiveInt) -> PdfProfileParameterConstruction {
  ParameterConstructed(OpenViewRect(PdfOpenViewRect {
    left: left,
    top: top,
    width: width,
    height: height,
  }))
}

fn pdf_open_highlight(left: std.integer.PositiveInt, right: std.integer.PositiveInt, top: std.integer.PositiveInt, bottom: std.integer.PositiveInt) -> PdfProfileParameterConstruction {
  ParameterConstructed(OpenHighlight(PdfOpenHighlight {
    left: left,
    right: right,
    top: top,
    bottom: bottom,
