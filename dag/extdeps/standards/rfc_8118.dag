module extdeps.standards.rfc_8118

import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc8118#section-3"
  }
}

data rfc_8118_supersedes_rfc_3778_note: String = "PDF fragment identifiers for application/pdf are specified by RFC 8118 (Informational, March 2017), which OBSOLETES RFC 3778. This module cites RFC 8118 section 3 as the single authority for the parameter set modeled in extdeps.pdf_citation; RFC 3778 is historical only. The supersession is itself a worked example of tier-1 version anchoring: cite the current standard, not the obsoleted one."

data pdf_open_parameter_sequence_note: String = "RFC 8118 section 3: a PDF fragment has one or more parameters separated by ampersand or pound; parameters process left to right and later actions override earlier ones, so page should precede zoom. extdeps.pdf_citation models an ORDERED sequence as a closed coproduct list — never a string — so fragment semantics cannot be smuggled into Uri.locator."

data rfc_8118: NonEmptyStr = "RFC 8118"

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.standards.rfc_8118",
      decl_name: "rfc_8118",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps.standards.rfc_8118.extdeps_external_authority_anchor,
  further_citations: [],
}
