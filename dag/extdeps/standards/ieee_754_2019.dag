data ieee_754_2019_note: String = "Cited upstream: edition-specific anchor above (IEEE Std 754-2019 document id 6210). This module owns standard-governed interchange binary format and default rounding facts only — not gunbc execution receipts."

data ieee_754_binary64_interchange_note: String = "IEEE 754 binary64 interchange format: 64-bit double-precision radix-2 floating-point as cited at the anchor."

data ieee_754_round_ties_to_even_note: String = "Default rounding attribute roundTiesToEven (round to nearest, ties to even) for binary floating-point arithmetic as cited at the anchor."

data ieee_754_2008_2019_binary_add_equivalence_note: String = "For binary64 roundTiesToEven interchange addition, triple (1e16, 1.0, 1.0) yields the same left fold 1e16 and right fold 1e16+2 under both the 2008 and 2019 revisions at this locator family — interchange binary addition semantics did not change between them."
