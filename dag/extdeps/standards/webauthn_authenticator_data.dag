module extdeps.standards.webauthn_authenticator_data

import std.types { Int, List }
import std.logic { Bool }
import std.integer { UInt8 }
import std.measure { ByteSize, byte_size, byte_size_count }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.standards.rfc_8949 { CborValue, CborDecode, CborDecoded, CborRefused, CborRefusal, cbor_decode_item }

// W3C Web Authentication: An API for accessing Public Key Credentials, Level 3, §6.1 Authenticator
// Data. The byte layout an authenticator emits and a relying party parses:
//
//   rpIdHash               32 octets   SHA-256 of the RP ID
//   flags                   1 octet    bit 0 UP, bit 2 UV, bit 3 BE, bit 4 BS, bit 6 AT, bit 7 ED
//   signCount               4 octets   big-endian
//   attestedCredentialData  variable   present iff AT: aaguid (16) || credentialIdLength (2, BE)
//                                       || credentialId || credentialPublicKey (COSE_Key, CBOR)
//   extensions              variable   present iff ED: a CBOR map
//
// Apple App Attest emits this structure in both its objects (extdeps.apple.app_attest): the
// attestation's authData carries AT with the App Attest AAGUID and the credential key; an
// assertion's authenticatorData is the 37-octet prefix alone -- WITH THE AT BIT SET AND NOTHING
// FOLLOWING (extdeps.apple.app_attest_sample_ios_14_4), so an assertion is read by
// decode_authenticator_data_prefix and would be refused as truncated by the full decoder. Apple's
// verification steps 5..8 read rpIdHash, signCount, aaguid and credentialId from here.
data webauthn_authenticator_data_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.w3.org/TR/webauthn-3/#sctn-authenticator-data"
  }
}

data extdeps_external_authority_anchor: ExternalAuthority = webauthn_authenticator_data_external_authority_anchor

// The fixed widths of §6.1 as measured sizes (std.measure ByteSize, the corpus's one carrier for
// an octet count -- review 69674 of gunbc#11970), and the offsets the layout derives from them:
// flags follow the hash, the counter follows the flags, the prefix is hash + flags + counter.
data authenticator_data_rp_id_hash_size: ByteSize = byte_size(count: 32)
data authenticator_data_flags_size: ByteSize = byte_size(count: 1)
data authenticator_data_sign_count_size: ByteSize = byte_size(count: 4)
data authenticator_data_aaguid_size: ByteSize = byte_size(count: 16)
data authenticator_data_credential_id_length_size: ByteSize = byte_size(count: 2)

fn authenticator_data_flags_offset() -> Int {
  byte_size_count(b: authenticator_data_rp_id_hash_size)
}

fn authenticator_data_sign_count_offset() -> Int {
  authenticator_data_flags_offset() + byte_size_count(b: authenticator_data_flags_size)
}

// rpIdHash || flags || signCount: 37 octets.
data authenticator_data_prefix_size: ByteSize = byte_size(count: byte_size_count(b: authenticator_data_rp_id_hash_size) + byte_size_count(b: authenticator_data_flags_size) + byte_size_count(b: authenticator_data_sign_count_size))

type AuthenticatorFlags {
  user_present: Bool
  user_verified: Bool
  backup_eligible: Bool
  backup_state: Bool
  attested_credential_data_included: Bool
  extension_data_included: Bool
}

// THE FLAG BITS ARE A CLOSED SUM, not an Int a caller could name a seventh of (review 69692 of
// gunbc#11970): each arm carries its bit position from §6.1 Table 1, and the reader matches
// exhaustively, so there is no arm for an unnamed bit to fall through to.
type AuthenticatorFlagBit
  = UserPresentBit
  | UserVerifiedBit
  | BackupEligibleBit
  | BackupStateBit
  | AttestedCredentialDataIncludedBit
  | ExtensionDataIncludedBit

fn authenticator_flag_bit_divisor(bit: AuthenticatorFlagBit) -> Int {
  match bit {
    UserPresentBit => 1
    UserVerifiedBit => 4
    BackupEligibleBit => 8
    BackupStateBit => 16
    AttestedCredentialDataIncludedBit => 64
    ExtensionDataIncludedBit => 128
  }
}

fn flag_bit_set(flags: Int, bit: AuthenticatorFlagBit) -> Bool {
  (flags / authenticator_flag_bit_divisor(bit: bit)) % 2 == 1
}

fn authenticator_flags_of(octet: Int) -> AuthenticatorFlags {
  AuthenticatorFlags {
    user_present: flag_bit_set(flags: octet, bit: UserPresentBit),
    user_verified: flag_bit_set(flags: octet, bit: UserVerifiedBit),
    backup_eligible: flag_bit_set(flags: octet, bit: BackupEligibleBit),
    backup_state: flag_bit_set(flags: octet, bit: BackupStateBit),
    attested_credential_data_included: flag_bit_set(flags: octet, bit: AttestedCredentialDataIncludedBit),
    extension_data_included: flag_bit_set(flags: octet, bit: ExtensionDataIncludedBit),
  }
}

type AttestedCredentialData {
  aaguid: List<UInt8>
  credential_id: List<UInt8>
  credential_public_key: CborValue
}

type AuthenticatorData {
  rp_id_hash: List<UInt8>
  flags: AuthenticatorFlags
  sign_count: Int
  attested_credential: AttestedCredentialData?
  extensions: CborValue?
}

type AuthenticatorDataRefusal
  = AuthenticatorDataTruncated { at: Int, needed: ByteSize, available: ByteSize }
  | AuthenticatorDataCredentialKeyRefused { cause: CborRefusal }
  | AuthenticatorDataExtensionsRefused { cause: CborRefusal }
  | AuthenticatorDataTrailingOctets { consumed: ByteSize, total: ByteSize }

type AuthenticatorDataDecode
  = AuthenticatorDataDecoded { data: AuthenticatorData }
  | AuthenticatorDataRefused { cause: AuthenticatorDataRefusal }

// An octet read that refuses on absence rather than answering zero (review 69598 of
// gunbc#11970): every caller has already established the length, and the read still owes a
// located refusal instead of a fabricated value should that ever stop being true.
fn octet_at(octets: List<UInt8>, at: Int) -> Int? {
  match octets |> get(at) {
    null => none
    o => Present { value: o }
  }
}

fn big_endian_at(octets: List<UInt8>, at: Int, n: Int, acc: Int) -> Int? {
  if n <= 0 { Present { value: acc } } else {
    match octet_at(octets: octets, at: at) {
      Absent => none
      Present { value: o } => big_endian_at(octets: octets, at: at + 1, n: n - 1, acc: acc * 256 + o)
    }
  }
}

fn slice(octets: List<UInt8>, at: Int, n: Int) -> List<UInt8> {
  octets |> skip(at) |> take(n)
}

fn truncated_if_short(octets: List<UInt8>, at: Int, needed: Int) -> AuthenticatorDataRefusal? {
  let available = count(octets) - at
  if available < needed { Present { value: AuthenticatorDataTruncated { at: at, needed: byte_size(count: needed), available: byte_size(count: if available < 0 { 0 } else { available }) } } } else { none }
}

type AttestedCredentialRead
  = AttestedCredentialRead { credential: AttestedCredentialData, next: Int }
  | AttestedCredentialRefused { cause: AuthenticatorDataRefusal }

// aaguid || credentialIdLength || credentialId || credentialPublicKey, from `at`. The COSE key is
// one CBOR item whose end the CBOR decoder reports, which is what lets extensions follow it.
fn read_attested_credential(octets: List<UInt8>, at: Int) -> AttestedCredentialRead {
  match truncated_if_short(octets: octets, at: at, needed: byte_size_count(b: authenticator_data_aaguid_size) + byte_size_count(b: authenticator_data_credential_id_length_size)) {
    Present { value: r } => AttestedCredentialRefused { cause: r }
    Absent => {
      let aaguid = slice(octets: octets, at: at, n: byte_size_count(b: authenticator_data_aaguid_size))
      let id_at = at + byte_size_count(b: authenticator_data_aaguid_size) + byte_size_count(b: authenticator_data_credential_id_length_size)
      match big_endian_at(octets: octets, at: at + byte_size_count(b: authenticator_data_aaguid_size), n: byte_size_count(b: authenticator_data_credential_id_length_size), acc: 0) {
        Absent => AttestedCredentialRefused { cause: AuthenticatorDataTruncated { at: at + byte_size_count(b: authenticator_data_aaguid_size), needed: byte_size(count: byte_size_count(b: authenticator_data_credential_id_length_size)), available: byte_size(count: 0) } }
        Present { value: id_len } =>
      match truncated_if_short(octets: octets, at: id_at, needed: id_len) {
        Present { value: r } => AttestedCredentialRefused { cause: r }
        Absent =>
          match cbor_decode_item(octets: octets, at: id_at + id_len, depth: 0) {
            CborRefused { cause: c } => AttestedCredentialRefused { cause: AuthenticatorDataCredentialKeyRefused { cause: c } }
            CborDecoded { value: key, next: n } => AttestedCredentialRead {
              credential: AttestedCredentialData { aaguid: aaguid, credential_id: slice(octets: octets, at: id_at, n: id_len), credential_public_key: key },
              next: n,
            }
          }
      }
      }
    }
  }
}

type ExtensionsRead
  = ExtensionsRead { extensions: CborValue?, next: Int }
  | ExtensionsRefused { cause: AuthenticatorDataRefusal }

fn read_extensions(octets: List<UInt8>, at: Int, included: Bool) -> ExtensionsRead {
  if !included { ExtensionsRead { extensions: none, next: at } } else {
    match cbor_decode_item(octets: octets, at: at, depth: 0) {
      CborRefused { cause: c } => ExtensionsRefused { cause: AuthenticatorDataExtensionsRefused { cause: c } }
      CborDecoded { value: v, next: n } => ExtensionsRead { extensions: Present { value: v }, next: n }
    }
  }
}

fn authenticator_data_finish(octets: List<UInt8>, rp_id_hash: List<UInt8>, flags: AuthenticatorFlags, sign_count: Int, credential: AttestedCredentialData?, at: Int) -> AuthenticatorDataDecode {
  match read_extensions(octets: octets, at: at, included: flags.extension_data_included) {
    ExtensionsRefused { cause: r } => AuthenticatorDataRefused { cause: r }
    ExtensionsRead { extensions: ext, next: n } =>
      if n != count(octets) { AuthenticatorDataRefused { cause: AuthenticatorDataTrailingOctets { consumed: byte_size(count: n), total: byte_size(count: count(octets)) } } }
      else {
        AuthenticatorDataDecoded { data: AuthenticatorData { rp_id_hash: rp_id_hash, flags: flags, sign_count: sign_count, attested_credential: credential, extensions: ext } }
      }
  }
}

// THE WHOLE STRUCTURE, consuming every octet: what the flags say is present must be present and
// nothing else may follow. For the assertion reading see decode_authenticator_data_prefix.
fn decode_authenticator_data(octets: List<UInt8>) -> AuthenticatorDataDecode {
  match truncated_if_short(octets: octets, at: 0, needed: byte_size_count(b: authenticator_data_prefix_size)) {
    Present { value: r } => AuthenticatorDataRefused { cause: r }
    Absent => {
      match decode_authenticator_data_prefix(octets: octets |> take(byte_size_count(b: authenticator_data_prefix_size))) {
        AuthenticatorDataPrefixRefused { cause: r } => AuthenticatorDataRefused { cause: r }
        AuthenticatorDataPrefixDecoded { prefix: p } =>
          if p.flags.attested_credential_data_included {
            match read_attested_credential(octets: octets, at: byte_size_count(b: authenticator_data_prefix_size)) {
              AttestedCredentialRefused { cause: r } => AuthenticatorDataRefused { cause: r }
              AttestedCredentialRead { credential: c, next: n } =>
                authenticator_data_finish(octets: octets, rp_id_hash: p.rp_id_hash, flags: p.flags, sign_count: p.sign_count, credential: Present { value: c }, at: n)
            }
          } else {
            authenticator_data_finish(octets: octets, rp_id_hash: p.rp_id_hash, flags: p.flags, sign_count: p.sign_count, credential: none, at: byte_size_count(b: authenticator_data_prefix_size))
          }
      }
    }
  }
}

// ── The 37-octet prefix alone ────────────────────────────────────────────────────────────────
// rpIdHash || flags || signCount, and nothing else: exactly 37 octets, the flags carried but not
// interpreted as a promise of what follows. This is the assertion reading; a longer input is
// refused as trailing rather than parsed, because the caller asked for the prefix form.
type AuthenticatorDataPrefix {
  rp_id_hash: List<UInt8>
  flags: AuthenticatorFlags
  sign_count: Int
}

type AuthenticatorDataPrefixDecode
  = AuthenticatorDataPrefixDecoded { prefix: AuthenticatorDataPrefix }
  | AuthenticatorDataPrefixRefused { cause: AuthenticatorDataRefusal }

fn decode_authenticator_data_prefix(octets: List<UInt8>) -> AuthenticatorDataPrefixDecode {
  match truncated_if_short(octets: octets, at: 0, needed: byte_size_count(b: authenticator_data_prefix_size)) {
    Present { value: r } => AuthenticatorDataPrefixRefused { cause: r }
    Absent =>
      if count(octets) != byte_size_count(b: authenticator_data_prefix_size) {
        AuthenticatorDataPrefixRefused { cause: AuthenticatorDataTrailingOctets { consumed: authenticator_data_prefix_size, total: byte_size(count: count(octets)) } }
      } else {
        match octet_at(octets: octets, at: authenticator_data_flags_offset()) {
          Absent => AuthenticatorDataPrefixRefused { cause: AuthenticatorDataTruncated { at: authenticator_data_flags_offset(), needed: byte_size(count: byte_size_count(b: authenticator_data_flags_size)), available: byte_size(count: 0) } }
          Present { value: flags_octet } =>
            match big_endian_at(octets: octets, at: authenticator_data_sign_count_offset(), n: byte_size_count(b: authenticator_data_sign_count_size), acc: 0) {
              Absent => AuthenticatorDataPrefixRefused { cause: AuthenticatorDataTruncated { at: authenticator_data_sign_count_offset(), needed: byte_size(count: byte_size_count(b: authenticator_data_sign_count_size)), available: byte_size(count: 0) } }
              Present { value: sign_count } =>
                AuthenticatorDataPrefixDecoded { prefix: AuthenticatorDataPrefix {
                  rp_id_hash: slice(octets: octets, at: 0, n: byte_size_count(b: authenticator_data_rp_id_hash_size)),
                  flags: authenticator_flags_of(octet: flags_octet),
                  sign_count: sign_count,
                } }
            }
        }
      }
  }
}
