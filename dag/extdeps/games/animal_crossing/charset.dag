// 0x7F never draws: it opens a control code (extdeps.games.animal_crossing.message), so its table
// entry is not a glyph of any text.
data ac_control_prefix_octet: Int = 127
data ac_untranscribed_glyph: String = "�"

fn ac_glyph_is_single_code_point(glyph: String) -> Bool {
  count(chars(glyph)) == 1
}

type GlyphSearch {
  octet: Int
  found: Int
}

// The octet that draws `glyph`: the first one whose entry it is, never the control prefix. Absent
// for a glyph the font does not have, and for the two entries spelled with a combining mark, which
// are not one character of text.
fn ac_glyph_octet(glyph: String) -> Int? {
  if ac_glyph_is_single_code_point(glyph: glyph) == false || glyph == ac_untranscribed_glyph { none }
  else {
    let r = fold(ac_glyphs, init: GlyphSearch { octet: 0, found: -1 }, f: (acc, g) =>
      GlyphSearch { octet: acc.octet + 1, found: if acc.found < 0 && g == glyph && acc.octet != ac_control_prefix_octet { acc.octet } else { acc.found } })
    if r.found < 0 { none } else { Present { value: r.found } }
  }
}

// The text an octet reads as, when that text reads back as the same octet; absent otherwise (no
// transcribed glyph, a two-code-point entry, or a glyph another octet already owns), and such an
// octet is written as an escape instead.
fn ac_octet_glyph(octet: Int) -> String? {
  match get(ac_glyphs, octet) {
    null => none
    other =>
      if ac_glyph_octet(glyph: other) == Present { value: octet } { Present { value: other } } else { none }
  }
}
