// 0x7F never draws: it opens a control code (extdeps.games.animal_crossing.message), so its table
// entry is not a glyph of any text.
data ac_control_prefix_octet: Int = 127
data ac_untranscribed_glyph: String = "�"

fn ac_glyph_is_single_code_point(glyph: String) -> Bool {
  count(chars(glyph)) == 1
}

// The octet each glyph reads back as: the first octet drawing it, never the control prefix, and
// only for a glyph that is one character of text. Built once and looked up per character, so
// reading or writing a message costs its length, not its length times the table.
type GlyphIndexFold {
  octet: Int
  index: Map<String, Int>
}

fn glyph_index_step(acc: GlyphIndexFold, glyph: String) -> GlyphIndexFold {
  let admitted = acc.octet != ac_control_prefix_octet && ac_glyph_is_single_code_point(glyph: glyph) && glyph != ac_untranscribed_glyph
  let index = if admitted == false { acc.index } else {
    match map_get(acc.index, glyph) {
      Present { value: _ } => acc.index
      Absent => map_insert(acc.index, glyph, acc.octet)
    }
  }
  GlyphIndexFold { octet: acc.octet + 1, index: index }
}

fn ac_glyph_index() -> Map<String, Int> {
  fold(ac_glyphs, init: GlyphIndexFold { octet: 0, index: empty_map() }, f: (acc, g) => glyph_index_step(acc: acc, glyph: g)).index
}

fn ac_glyph_octet(index: Map<String, Int>, glyph: String) -> Int? {
  map_get(index, glyph)
}

// The text an octet reads as, when that text reads back as the same octet; absent otherwise (no
// transcribed glyph, a two-code-point entry, or a glyph another octet already owns), and such an
// octet is written as an escape instead.
fn ac_octet_glyph(index: Map<String, Int>, octet: Int) -> String? {
  match get(ac_glyphs, octet) {
    null => none
    other => if map_get(index, other) == Present { value: octet } { Present { value: other } } else { none }
  }
}
