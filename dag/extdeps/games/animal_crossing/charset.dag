// The glyph each octet draws in the English GameCube Animal Crossing font, as ACSE (Cuyler36's save
// editor) transcribes it in CharacterSets.AcCharacterDictionary. It is not ASCII: fifteen printable
// ASCII octets draw other glyphs -- 0x5B is "ã", not "[" -- which an in-game render of 0x5B confirms.
// An empty entry, or ACSE's "�", is an octet with no transcribed glyph.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/Cuyler36/ACSE/blob/23563b168f4afd705aa3b48da807978644c715df/ACSE.Core/Utilities/StringUtility.cs"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.games.animal_crossing.charset",
      decl_name: "ac_glyphs",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

