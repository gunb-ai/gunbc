// Animal Crossing (GameCube, GAFE01) dialogue as the game stores and draws it. Messages live in
// forest_2nd.arc as `data/message_data.bin` (every message concatenated) and
// `data/message_data_table.bin` (one big-endian u32 per message: the END offset of that message).
// A message id is an index into that table and is referenced from game code, so the number of
// messages is fixed. Inside a message, 0x7F starts a control code whose total size -- 0x7F, the
// code byte and its argument bytes -- is the game's `mFont_cont_info_tbl` entry; every other byte
// is one glyph of extdeps.games.animal_crossing.charset (0xCD is the line break). Names and sizes below are ac-decomp's
// (include/m_font.h `mFont_CONT_CODE_*`, src/game/m_font_main.c_inc `mFont_cont_info_tbl`).
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ACreTeam/ac-decomp/blob/09ca8e8b5b24e6ab44047ee980cf0088ad7ecb4c/include/m_font.h"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.games.animal_crossing.message",
      decl_name: "MessageToken",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data message_archive_path: String = "forest_2nd.arc"
data message_data_path: String = "data/message_data.bin"
data message_table_path: String = "data/message_data_table.bin"

data control_prefix: Int = 127
// The octet that ends a drawn line (the font table's "\n").
data message_line_break: Int = 205

// `size` counts every octet of the code: 0x7F, the code byte and its arguments.
type ControlCode {
  code: Int
  name: String
  size: Int
}

