module extdeps.games.animal_crossing.expression

import std.types { Bool, Int, List, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.algebra { filter }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

// What a villager does while it talks, as the message text orders it. A SET_DEMO_ORDER_* code
// carries three argument octets: a slot (0..9) and a big-endian u16 value, written into that row of
// the demo order table (src/game/m_msg_main.c_inc mMsg_Get_OrderCode_forData, m_msg_cursol.c_inc
// mMsg_Main_Cursol_SetDemoOrder_ControlCursol -> mDemo_Set_OrderValue). The rows are
// include/m_demo.h demo_order_type: PLAYER, three unnamed, NPC0 (the speaker), NPC1, NPC2, two
// unnamed, QUEST. The speaking villager polls its row every frame of the conversation
// (src/actor/npc/ac_npc_talk.c_inc):
//   slot 0  the expression: an index into that file's eff_idx animation table (aNPC_check_manpu),
//           0xFF..0xFD reset to the talking, sitting or "keke" wait animation (ac_npc.h
//           aNPC_MANPU_CODE_RESET*); once the animation stops, eff_idx2 plays its follow-up
//   slot 1  and slot 3: a timed action (aNPC_check_timing_demoCode): 2/4 hand an item over, 3/5
//           take one, 15 change clothes, 6/7 take out or put away the phone, with arguments in
//           the NPC1 row
//   slot 2  a change of the villager's persisted mood (aNPC_check_feel_demoCode ->
//           aNPC_set_feel_info), include/m_npc.h mNpc_FEEL_*, with slot 8 as its timer
// The QUEST row is read by the quest manager as (slot, value) orders (src/actor/ac_quest_manager.c
// aQMgr_talk_get_talk_order). So of everything a SET_DEMO_ORDER code can say, only the speaker's
// slot 0 is presentation; the rest is gameplay or state, and a rewrite keeps it exactly.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ACreTeam/ac-decomp/tree/09ca8e8b5b24e6ab44047ee980cf0088ad7ecb4c"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.games.animal_crossing.expression",
      decl_name: "expressions",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// ---- the speaker's order slots ----

data speaker_expression_slot: Int = 0
data speaker_mood_slot: Int = 2
data speaker_mood_timer_slot: Int = 8

// What one SET_DEMO_ORDER argument triple means for the speaking villager.
type SpeakerOrder
  = Expression { code: Int }
  | MoodChange { feel: Int }
  | MoodTimer { frames: Int }
  | TimedAction { slot: Int, value: Int }
  | OtherOrder { slot: Int, value: Int }
  | MalformedOrder { reason: String }

fn speaker_order(arguments: List<Int>) -> SpeakerOrder {
  if count(arguments) != 3 { MalformedOrder { reason: join(["a demo order carries 3 octets, got ", to_string(count(arguments))], "") } }
  else {
    let slot = get(arguments, 0) ?? 0
    let value = (get(arguments, 1) ?? 0) * 256 + (get(arguments, 2) ?? 0)
    if slot == speaker_expression_slot { Expression { code: value } }
    else if slot == speaker_mood_slot { MoodChange { feel: value } }
    else if slot == speaker_mood_timer_slot { MoodTimer { frames: value } }
    else if slot == 1 || slot == 3 { TimedAction { slot: slot, value: value } }
    else { OtherOrder { slot: slot, value: value } }
  }
}

// ---- the expressions ----

// One entry of ac_npc_talk.c_inc's eff_idx table: the code a message writes, the animation it
// starts, and a name a writer can use. The table is one for every actor built on ac_npc.c or
// ac_npc2.c -- villagers (ac_normal_npc) and the special characters (shop_master, police,
// restart, totakeke, ...) alike -- so any message may ask for any code; whether a given model
// carries the animation is per-model resource data this module has not read. Entries 24..31 and
// 33..42 are the upstream "_D", "_E" and "_R" variants of earlier expressions; in
// include/ac_npc_anim_def.h the _D names sit beside SITDOWN/TO_DECK, _E beside ENSOU (performing)
// and _R beside GEKIDO/KIEEEEI (rage, shriek), which suggests seated, performing and Resetti
// sets, but that is a reading of neighbours, not of the decompilation, so their names keep the
// suffix rather than a guess.
type ExpressionEntry {
  code: Int
  animation: String
  name: String
}

data expressions: List<ExpressionEntry> = [
  ExpressionEntry { code: 1, animation: "aNPC_ANIM_MUKA1", name: "annoyed" },
  ExpressionEntry { code: 2, animation: "aNPC_ANIM_GAAAN1", name: "shocked" },
  ExpressionEntry { code: 3, animation: "aNPC_ANIM_SMILE1", name: "smile" },
