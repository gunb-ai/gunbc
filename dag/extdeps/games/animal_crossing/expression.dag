// ac_npc.h aNPC_MANPU_CODE_RESET, _RESET_SIT, _RESET_KEKE: back to the animation the villager
// talks, sits or waits in.
data expression_reset: Int = 255
data expression_reset_sit: Int = 254
data expression_reset_keke: Int = 253

data reset_names: List<ExpressionEntry> = [
  ExpressionEntry { code: 255, animation: "aNPC_ANIM_TALK1", name: "neutral" },
  ExpressionEntry { code: 254, animation: "aNPC_ANIM_SITDOWN_WAIT_D1", name: "neutral-sit" },
  ExpressionEntry { code: 253, animation: "aNPC_ANIM_WAIT_E1", name: "neutral-keke" },
]

fn expression_named(name: String) -> Int? {
  match concat(expressions, reset_names) |> filter(e => e.name == name) |> first {
    null => none
    e => Present { value: e.code }
  }
}

fn expression_name(code: Int) -> String? {
  match concat(expressions, reset_names) |> filter(e => e.code == code) |> first {
    null => none
    e => Present { value: e.name }
  }
}

// ---- the moods a message can set ----

// include/m_npc.h mNpc_FEEL_*: the values slot 2 accepts, past which aNPC_check_feel_demoCode
// drops the order.
type MoodEntry {
  feel: Int
  name: String
}

data moods: List<MoodEntry> = [
  MoodEntry { feel: 0, name: "normal" },
  MoodEntry { feel: 1, name: "happy" },
  MoodEntry { feel: 2, name: "angry" },
  MoodEntry { feel: 3, name: "sad" },
  MoodEntry { feel: 4, name: "sleepy" },
  MoodEntry { feel: 5, name: "pitfall" },
]

fn mood_name(feel: Int) -> String? {
  match moods |> filter(m => m.feel == feel) |> first {
    null => none
    m => Present { value: m.name }
  }
}
