module extdeps.games.animal_crossing.dialogue_catalog

import std.types { Bool, Int, List, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

// Where the game chooses a conversation's first message by the speaker's personality: each entry
// is one place in ac-decomp (source, formula) that computes an entry message id from the villager's
// `looks`, with the id range every personality can reach there. Only entry ids are listed; the
// messages a conversation continues into are reached from control codes inside the text. Built by
// reading the decompilation at the commit below; `evidence` records whether the first message of the
// ranges was read and found to match the topic and personality (TextVerified, against the Animal
// Crossing Deluxe message table) or only follows from the formula (FormulaOnly).
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ACreTeam/ac-decomp/tree/09ca8e8b5b24e6ab44047ee980cf0088ad7ecb4c"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.games.animal_crossing.dialogue_catalog",
      decl_name: "dialogue_catalog",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// include/m_npc_personal_id.h mNpc_LOOKS_*, in `looks` order.
type Personality = Normal | Peppy | Lazy | Jock | Cranky | Snooty

data personalities: List<Personality> = [Normal, Peppy, Lazy, Jock, Cranky, Snooty]

fn personality_of_looks(looks: Int) -> Personality? {
  match get(personalities, looks) {
    null => none
    other => Present { value: other }
  }
}

fn personality_name(p: Personality) -> String {
  match p {
    Normal => "normal"
    Peppy => "peppy"
    Lazy => "lazy"
    Jock => "jock"
    Cranky => "cranky"
    Snooty => "snooty"
  }
}

fn personality_looks(p: Personality) -> Int {
  match p {
    Normal => 0
    Peppy => 1
    Lazy => 2
    Jock => 3
    Cranky => 4
    Snooty => 5
  }
}

// Dialogue lives in two tables: message_data (conversation) and the letter tables (mail).
type DialogueTable = MessageDataTable | MailTable

type CatalogEvidence = TextVerified | FormulaOnly

// The ids `looks` can reach for one entry: first_id .. first_id + count - 1.
type PersonalityRange {
  looks: Int
  first_id: Int
  count: Int
}

type CatalogEntry {
  topic: String
  context: String
  source: String
  formula: String
  table: DialogueTable
  evidence: CatalogEvidence
  ranges: List<PersonalityRange>
  notes: String
}

fn catalog_range(entry: CatalogEntry, p: Personality) -> PersonalityRange? {
  match entry.ranges |> filter(r => r.looks == personality_looks(p: p)) |> first {
    null => none
    other => Present { value: other }
  }
}

