module extdeps.connector.molex_mini_fit_jr

import std.types { NonEmptyStr, List }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.measure { Ampere, ampere, Micrometer, micrometer }
import extdeps.vendor.molex { molex }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, CitedFigureStanding, TranscribedUncited }
import extdeps.uri { Uri, Https }

// THE 4.2 MM PITCH POWER CONNECTOR FAMILY an ATX12V 8-pin input is built on.
//
// The board manual names the input "8-pin ATX 12V" and does not name the header part. The Mini-Fit
// Jr. family is the de-facto part every ATX12V/EPS12V 8-pin uses, and the board's rows cite it as
// the rating authority ONLY on that convention: whether ASRock populated a Mini-Fit Jr. header or a
// compatible from another maker is unread, so the current figure below bounds the CABLE side that
// the fleet crimps, and the header side inherits it by convention until a part number is read.
//
// Two ratings exist and they are not interchangeable. The standard terminal family rates up to
// 9 A per circuit (the distributor summaries relay "9 A for the smallest circuit, 6 A for the
// largest", i.e. derated by circuit count); the 45750 high-current terminal rates 13 A per circuit
// with 16 AWG. Both are relayed from distributor datasheet summaries, graded below.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.molex.com/en-us/products/connectors/wire-to-board-connectors/mini-fit-jr-connectors"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.connector.molex_mini_fit_jr",
      decl_name: "mini_fit_jr_family",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type MiniFitJrTerminalRating {
  terminal_series_label: NonEmptyStr
  wire_gauge_awg: Nat
  rated_current_per_circuit: Ampere
  standing: CitedFigureStanding
}

type MiniFitJrFamily {
  family_label: NonEmptyStr
  pitch: Micrometer
  ratings: List<MiniFitJrTerminalRating>
}

data mini_fit_jr_standard_terminal_rating: MiniFitJrTerminalRating = MiniFitJrTerminalRating {
  terminal_series_label: "5556/5558 standard terminal",
  wire_gauge_awg: 18,
  rated_current_per_circuit: ampere(count: 9),
  standing: TranscribedUncited {
    read_obligation: "Open Molex product specification PS-5556-001 (current derating by circuit count and wire gauge) and record the 8-circuit, 18 AWG, 30 C rise figure; 9 A is the family maximum relayed from distributor summaries on 2026-10-04 and is NOT the 8-circuit derated value.",
  },
}

data mini_fit_jr_hcs_terminal_rating: MiniFitJrTerminalRating = MiniFitJrTerminalRating {
  terminal_series_label: "45750 high-current terminal",
  wire_gauge_awg: 16,
  rated_current_per_circuit: ampere(count: 13),
  standing: TranscribedUncited {
    read_obligation: "Open Molex PS-45750-001 and confirm 13 A max per circuit with 45750 terminals crimped to 16 AWG, plus its derating table; relayed from distributor datasheet summaries on 2026-10-04.",
  },
}

data mini_fit_jr_family: MiniFitJrFamily = MiniFitJrFamily {
  family_label: "Molex Mini-Fit Jr.",
  pitch: micrometer(count: 4200),
  ratings: [mini_fit_jr_standard_terminal_rating, mini_fit_jr_hcs_terminal_rating],
}

data mini_fit_jr_vendor_note: NonEmptyStr = "Family owner extdeps.vendor.molex; header part on the ALTRAD8UD-1L2T unread."
