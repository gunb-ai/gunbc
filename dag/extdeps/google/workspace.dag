module extdeps.google.workspace

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developers.google.com/workspace"
  }
}

data google_workspace_credentials_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developers.google.com/workspace/guides/create-credentials"
  }
}

data google_workspace_product: NonEmptyStr = "Google Workspace"

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.google.workspace",
      decl_name: "google_workspace_product",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [google_workspace_credentials_citation]
}

data workspace_api_edition: NonEmptyStr = "workspace-apis"

data workspace_not_gcp_note: String = "Google Workspace is an independently governed product family from Google Cloud. GCP IAM, ADC and Secret Manager are how a service account is minted and held; they are not this product. A Sheets credential is a fleet secret under gunbc.secret_provision, not a second credential concept."
