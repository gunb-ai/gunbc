  viewport_height_px: 1100,
}

// THE MEASURED PALETTE, one row per scheme. Slots are named for where the colour was read: the
// content column behind the cards, a card, the comment field, body text, muted text, the
// hairline, the action colour and a card's leading bar. The light row reads
// the slots the 2026-09-22 token row already carries from that row, because the two captures
// agree and one colour has one spelling in this module. The dark row replaces the owner-directed
// dark tokens of 2026-09-23: it holds only what the dark capture shows, so a slot the capture
// did not reach (hover, highlight, error, pressed action) has no dark value here at all.
type IssueTrackerMeasuredPalette {
  ground: Srgb8
  card: Srgb8
  field: Srgb8
  text: Srgb8
  text_muted: Srgb8
  hairline: Srgb8
  action: Srgb8
  leading_bar: Srgb8
}

data issue_tracker_measured_palette_light: IssueTrackerMeasuredPalette = IssueTrackerMeasuredPalette {
  ground: issue_tracker_visual_tokens.background_subtle,
  card: Srgb8 { r: 255, g: 255, b: 255 },
  field: issue_tracker_visual_tokens.background_subtle,
  text: issue_tracker_visual_tokens.text_primary,
  text_muted: issue_tracker_visual_tokens.text_secondary,
  hairline: issue_tracker_visual_tokens.border_default,
  action: issue_tracker_visual_tokens.action,
  leading_bar: issue_tracker_visual_tokens.action,
}

data issue_tracker_measured_palette_dark: IssueTrackerMeasuredPalette = IssueTrackerMeasuredPalette {
  ground: Srgb8 { r: 24, g: 25, b: 27 },
  card: Srgb8 { r: 24, g: 25, b: 27 },
  field: Srgb8 { r: 36, g: 37, b: 40 },
  text: Srgb8 { r: 255, g: 255, b: 255 },
  text_muted: Srgb8 { r: 154, g: 160, b: 166 },
  hairline: Srgb8 { r: 60, g: 64, b: 67 },
  action: Srgb8 { r: 138, g: 180, b: 248 },
  leading_bar: issue_tracker_visual_tokens.action,
}

// THE MEASURED TYPE SCALE, one row per place the product sets text. Size is carried in tenths of
// a CSS px because the markdown heading computes to 18.2px (1.4em of the 13px body); line height
// is rounded to whole px (the card label computes to 15.23); tracking is hundredths of a px and is recorded only where the product sets it
// deliberately (the card label's 0.8px) -- the sub-pixel per-size tracking Material applies to
// every other row is not part of this model. The code face computes to a web-font alias for the
// platform monospace, so it is recorded as the generic family rather than under that alias.
type IssueTrackerMeasuredFace
  = IssueTrackerFaceBody
  | IssueTrackerFaceHeading
  | IssueTrackerFaceMonospace

type IssueTrackerMeasuredInk
  = IssueTrackerInkText
  | IssueTrackerInkMuted
  | IssueTrackerInkAction
  | IssueTrackerInkCode

type IssueTrackerMeasuredCase
  = IssueTrackerCaseAuthored
  | IssueTrackerCaseUppercase

type IssueTrackerMeasuredText {
  face: IssueTrackerMeasuredFace
  size_tenths_px: Int
  line_height_px: Int
  weight: Int
  ink: IssueTrackerMeasuredInk
  letter_case: IssueTrackerMeasuredCase
  tracking_hundredths_px: Int
}

type IssueTrackerMeasuredTypeScale {
  body: IssueTrackerMeasuredText
  field_label: IssueTrackerMeasuredText
  card_label: IssueTrackerMeasuredText
  section_heading: IssueTrackerMeasuredText
  control: IssueTrackerMeasuredText
  control_small: IssueTrackerMeasuredText
  title: IssueTrackerMeasuredText
  markdown_heading: IssueTrackerMeasuredText
  chip: IssueTrackerMeasuredText
  inline_code: IssueTrackerMeasuredText
}

data issue_tracker_measured_type_scale: IssueTrackerMeasuredTypeScale = IssueTrackerMeasuredTypeScale {
  body: IssueTrackerMeasuredText { face: IssueTrackerFaceBody, size_tenths_px: 130, line_height_px: 18, weight: 400, ink: IssueTrackerInkText, letter_case: IssueTrackerCaseAuthored, tracking_hundredths_px: 0 },
  field_label: IssueTrackerMeasuredText { face: IssueTrackerFaceBody, size_tenths_px: 120, line_height_px: 16, weight: 500, ink: IssueTrackerInkMuted, letter_case: IssueTrackerCaseAuthored, tracking_hundredths_px: 0 },
  card_label: IssueTrackerMeasuredText { face: IssueTrackerFaceBody, size_tenths_px: 110, line_height_px: 15, weight: 500, ink: IssueTrackerInkText, letter_case: IssueTrackerCaseUppercase, tracking_hundredths_px: 80 },
  section_heading: IssueTrackerMeasuredText { face: IssueTrackerFaceBody, size_tenths_px: 130, line_height_px: 18, weight: 700, ink: IssueTrackerInkMuted, letter_case: IssueTrackerCaseAuthored, tracking_hundredths_px: 0 },
  control: IssueTrackerMeasuredText { face: IssueTrackerFaceHeading, size_tenths_px: 140, line_height_px: 20, weight: 500, ink: IssueTrackerInkAction, letter_case: IssueTrackerCaseAuthored, tracking_hundredths_px: 0 },
  control_small: IssueTrackerMeasuredText { face: IssueTrackerFaceHeading, size_tenths_px: 130, line_height_px: 20, weight: 500, ink: IssueTrackerInkAction, letter_case: IssueTrackerCaseAuthored, tracking_hundredths_px: 0 },
  title: IssueTrackerMeasuredText { face: IssueTrackerFaceHeading, size_tenths_px: 180, line_height_px: 24, weight: 400, ink: IssueTrackerInkText, letter_case: IssueTrackerCaseAuthored, tracking_hundredths_px: 0 },
  markdown_heading: IssueTrackerMeasuredText { face: IssueTrackerFaceBody, size_tenths_px: 182, line_height_px: 24, weight: 500, ink: IssueTrackerInkText, letter_case: IssueTrackerCaseAuthored, tracking_hundredths_px: 0 },
  chip: IssueTrackerMeasuredText { face: IssueTrackerFaceBody, size_tenths_px: 120, line_height_px: 22, weight: 400, ink: IssueTrackerInkText, letter_case: IssueTrackerCaseAuthored, tracking_hundredths_px: 0 },
  inline_code: IssueTrackerMeasuredText { face: IssueTrackerFaceMonospace, size_tenths_px: 130, line_height_px: 18, weight: 400, ink: IssueTrackerInkCode, letter_case: IssueTrackerCaseAuthored, tracking_hundredths_px: 0 },
}

// Inline code ink, read on the light capture only (the dark capture shows no inline code).
data issue_tracker_measured_code_ink_light: Srgb8 = Srgb8 { r: 24, g: 128, b: 56 }

// THE MEASURED METRICS, in CSS px at device scale 1. One corner radius serves cards, chips,
