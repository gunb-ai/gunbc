    scheme: Https
    locator: "drive.google.com/drive/folders/14rcDZQtJAHzrAYimoRNmm7rBS1HqV_9b?usp=sharing"
  }
}

type IssueTrackerVisualCapture {
  captured_on: NonEmptyStr
  origin: ExternalAuthority
  local_copy: ExternalAuthority
  shared_copy: ExternalAuthority
  session: NonEmptyStr
  viewport_width_px: Int
  viewport_height_px: Int
}

data issue_tracker_visual_capture: IssueTrackerVisualCapture = IssueTrackerVisualCapture {
  captured_on: "2026-10-04",
  origin: issue_tracker_visual_capture_origin,
  local_copy: issue_tracker_visual_capture_local,
  shared_copy: issue_tracker_visual_capture_shared,
  session: "signed out",
