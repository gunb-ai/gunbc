  radius_px: Int
  code_radius_px: Int
  top_bar_height_px: Int
  tab_height_px: Int
  chip_height_px: Int
  button_small_height_px: Int
  button_height_px: Int
  relation_header_height_px: Int
  relation_row_height_px: Int
  grid_row_height_px: Int
}

data issue_tracker_measured_metrics: IssueTrackerMeasuredMetrics = IssueTrackerMeasuredMetrics {
  radius_px: 4,
  code_radius_px: 2,
  top_bar_height_px: 48,
  tab_height_px: 34,
  chip_height_px: 22,
  button_small_height_px: 24,
  button_height_px: 32,
  relation_header_height_px: 32,
  relation_row_height_px: 33,
  grid_row_height_px: 37,
}

// CARD ANATOMY: card-coloured fill, a hairline border, the shared radius, uniform padding and an
// outer margin; the description and status-update cards thicken the leading border into a bar in
// the action colour. The label row (the uppercase card label, with author, time and an overflow
// menu on the product) is 36px tall.
type IssueTrackerMeasuredCard {
  padding_px: Int
  outer_margin_px: Int
  border_px: Int
  leading_bar_px: Int
  label_row_height_px: Int
}

data issue_tracker_measured_card: IssueTrackerMeasuredCard = IssueTrackerMeasuredCard {
  padding_px: 16,
  outer_margin_px: 8,
  border_px: 1,
  leading_bar_px: 4,
  label_row_height_px: 36,
}

// STATUS CHIP ANATOMY: the chip height tall on the shared radius, with 4px side padding and a 1px
// ring drawn inside its box. Open statuses pair a pale tint with a saturated ring; Fixed is
// card-coloured text on a fill in the muted text colour with a ring of the same colour; Obsolete
// and Duplicate are body text on a pale grey with a ring in the muted text colour. The plain
// chip (component path, ancestor chain, type) is not modeled until an element consumes it.
type IssueTrackerMeasuredStatusChip {
  side_padding_px: Int
  ring_px: Int
}

data issue_tracker_measured_status_chip: IssueTrackerMeasuredStatusChip = IssueTrackerMeasuredStatusChip {
  side_padding_px: 4,
  ring_px: 1,
}

// BUTTON ANATOMY: three kinds on the shared radius, all in the heading face at weight 500. Filled
// is card-coloured text on the action colour; outlined is an action-coloured label on the card
// colour inside a hairline; text is the action-coloured label alone. Two sizes, the two button
// heights of the metrics row, with 10px and 12px side padding. A disabled button draws its label
// at 38% and its border or fill at 12% of one ink.
type IssueTrackerMeasuredButton {
  small_side_padding_px: Int
  side_padding_px: Int
  border_px: Int
  disabled_label_pct: Int
  disabled_boundary_pct: Int
}

data issue_tracker_measured_button: IssueTrackerMeasuredButton = IssueTrackerMeasuredButton {
  small_side_padding_px: 10,
  side_padding_px: 12,
  border_px: 1,
  disabled_label_pct: 38,
  disabled_boundary_pct: 12,
}

// THE ISSUE'S ACTIONS AND THE PRODUCT'S BUTTON IDIOMS (owner directive 2026-09-24: the
// issue-tracker's action surfaces must come from THIS model, never bespoke page markup). SOURCES,
// stated honestly per the module's citation discipline: (a) VERIFIED from the capture
// (docs/plans/buganizer-visual-contract.md, the app shell): the header's "Create Issue" button is
// a CONTAINED PRIMARY button, and the action blue is the token set above; (b) OWNER-DIRECTED
// 2026-09-24: Assign is the product's first-class issue action (assignment is the operation our
// workflow calls dispatch — the mapping is a workflow fact, stated in the consumer, not here),
// and the issue detail header carries an action bar with an overflow (the capture's 'action
// overflow'); the duplicate/mark actions the contract names ride that bar; (c) the flat TEXT
// button is the product's Material secondary idiom (the capture's builder/save affordances are
// text-style). What an organization's configured action matrix holds BEYOND these names is
// configuration, not interface — declared here rather than fabricated. The wire labels are the UI
// spellings.

// THE ACTION NAMES: the actions the product exposes on an issue. Assign claims the issue for a
// user; Create Issue mints a new issue (the shell's primary button); Mark as duplicate closes the
// issue into another.
type IssueActionKind
  = IssueActionAssign
  | IssueActionCreate
  | IssueActionMarkDuplicate
  | IssueActionStartWork

// THE ACTIONS' SEMANTICS (owner ruling 2026-09-24): Assign and Start Work are DISTINCT — Assign
// is DURABLE ASSIGNMENT, a recorded fact on the issue (who it is assigned to); Start Work is
// EXECUTION (dispatch), the workflow launching an attempt. Never one affordance doing both. Start
// Work is our execution verb on the tracker surface, owner-directed 2026-09-24 — the product's
// own execution verbs are not part of the captured session; the Assign/Create/MarkDuplicate
// labels remain the product's UI spellings. AMENDED 2026-09-25 (owner: "scrap the button stuff we
// have here for now ... just copy buganizer"): no tracker surface renders a Start Work button
// today — the detail page keeps the durable Assign action alone, and the execution entry points
// will be re-modeled later. The verb stays modeled here (the /dispatch route and the admission
// authority it answers remain live); only its rendered surface is retired.
fn issue_action_wire(kind: IssueActionKind) -> String {
  match kind {
    IssueActionAssign => "Assign"
    IssueActionCreate => "Create Issue"
    IssueActionMarkDuplicate => "Mark as duplicate"
    IssueActionStartWork => "Start Work"
  }
}

// THE BUTTON IDIOMS: a contained primary button (filled action blue, the "Create Issue" shape)
// for the surface's primary action, or a flat text button (action-blue label, no fill) for
// secondary actions. The outlined idiom (an action-blue label inside a hairline on the card
// colour) was measured on the 2026-10-04 capture: the issue header's "Hotlists" button and the
// relation sections' "Add" buttons.
type IssueActionButtonIdiom
  = IssueButtonContainedPrimary
  | IssueButtonOutlined
  | IssueButtonText

fn issue_button_idiom_wire(idiom: IssueActionButtonIdiom) -> String {
  match idiom {
    IssueButtonContainedPrimary => "contained-primary"
    IssueButtonOutlined => "outlined"
    IssueButtonText => "text"
  }
}

// THE UNAVAILABLE-ACTION IDIOM: the product RESTS an unavailable action — it stays visible but
// non-interactive, never disappears (owner directive 2026-09-24: the disabled idiom, checked
// against the contract's builder surfaces, which stay visible at rest). Availability itself is a
// workflow fact (for our surface, the launch admission verdict); this row is the product's
// RENDERING answer for an unavailable action.
type IssueActionAvailability
  = IssueActionEnabled
  | IssueActionDisabled

fn issue_action_availability_wire(a: IssueActionAvailability) -> String {
  match a {
    IssueActionEnabled => "enabled"
    IssueActionDisabled => "disabled"
  }
}

// THE DETAIL-PAGE ACTION BAR: the issue header's action surface — an ordered row of the issue's
// actions beside the overflow. The caller decides which of the modeled actions its surface
// renders (our detail page renders Assign — the dispatch mapping — today; create-issue and the
// duplicate/mark actions land with the intake slice); the bar carries no stock roster here
// because the product's per-organization action matrix is configuration, not interface.
type IssueActionBar {
  actions: List<IssueActionKind>
}

// A COMPONENT'S PLACEMENT IS ITS PATH (the type's own law): the browse tree derives from the
// paths, never a second spelling. "Browse components" is one of the four navigation/curation
// sidebar surfaces (stock_sidebar_roster) — the tree it renders is THIS derivation over the
// component set: one node per distinct path prefix, parents before children, each exactly once —
// the sidebar's ordered walk. Depth recurses while ANY component sits deeper — a level may be
// empty (a host's arm nests at depth 3 with nothing at depth 2) and the walk still reaches the
// deeper level; it stops only when no component's path extends past the current depth.
type ComponentTreeEntry {
  component: Component
  depth: Int
}

fn component_is_at_depth(path: List<String>, depth: Int) -> Bool {
  count(path) == depth
}

fn browse_component_tree(components: List<Component>) -> List<ComponentTreeEntry> {
  browse_component_tree_from(components: components, depth: 1)
}

fn browse_component_tree_from(components: List<Component>, depth: Int) -> List<ComponentTreeEntry> {
  let at = map(filter(components, c => component_is_at_depth(path: c.path, depth: depth)), c =>
    ComponentTreeEntry { component: c, depth: depth })
  let deeper = filter(components, c => count(c.path) > depth)
  if count(deeper) == 0 {
    at
  } else {
    concat(at, browse_component_tree_from(components: components, depth: depth + 1))
  }
}

// THE RESULTS ROW'S ASSIGNEE CELL (owner ruling 2026-09-25, "copy the UI semantics of assigned/etc
// from buganizer"; verified against the capture the same day). SOURCE, stated honestly:
// /home/briansrls/chromium-565764076/ "test - Chromium.html" — the ASSIGNEE cell renders the
// assignee's display identity as PLAIN TEXT: no chip, no button, no link, no menu. The capture's
// populated cells did not load in the saved HTML (the identity renders asynchronously in the live
// product, so the assigned rows' cells are empty in the artifact); the plain-text claim is the
// identity the interface's User type already names, and the unassigned spelling is DIRECTLY
// VERIFIED: every issue with no assignee renders the two-character placeholder "--" (34 of the
// capture's 50 rows), in the cell's own dimmed voice — never blank, never a widget.
data issue_assignee_unassigned_display: NonEmptyStr = "--"

// THE CELL'S DISPLAY RULE, one fn every results surface derives from: the assignee's email when
// one holds the issue, the unassigned placeholder when Absent — never a hand-rolled empties check
// downstream of this row.
fn issue_results_assignee_display(assignee: User?) -> String {
  match assignee {
    Present { value: a } => a.email
    Absent => issue_assignee_unassigned_display as String
  }
}

// THE ASSIGNMENT FIELD'S DISPLAY VOCABULARY (reshaped by the owner ruling 2026-09-25,
// docs/plans/human-identity-authorization.md): the durable principal identity lives in
// gunbc.principal_projection — email is the SELECTOR and a display fact, never the identity (the
// ruling bans subject = email outright: the a3fd5eb principal_from_email shape has no constructor
// anywhere in gunbc). THIS module keeps the interface's visible shapes: the fabric selector's
// email spelling (what the picker displays; the stored identity is principal:gunbc/workflows/
// fabric from the principal authority), the selector's shape validation, and the unassigned
// placeholder. The suggestion assembly and the principal chips ride the event-principal types in
// the page; the avatar chain below is the interface's display law (initials under the
// never-blocks rule).
data issue_assign_fabric_display: NonEmptyStr = "fabric@gunb.ai"

// THE AVATAR DISPLAY LAW (owner mandate 2026-09-25, docs/plans/issue-page-architecture.md): the
// resolution chain — internal principal profile → Google Workspace directory/Contacts photo →
// cached prior → deterministic initials — with THE NEVER-BLOCKS LAW: absent and unread render
// initials and NEVER refuse assignment, comments, or rendering. These are DISPLAY rows; the
// profile facts and the principal refs live in gunbc.principal_projection, and the /avatar
// endpoint + directory fetch are the realization (follow-up, A9).
type AvatarStanding
  = AvatarResolved
  | AvatarAbsent
  | AvatarUnread

type AvatarSource
  = AvatarFromInternalProfile
  | AvatarFromGoogleDirectory
  | AvatarFromCachedPrior
  | AvatarFromInitials

type AvatarProbe
  = AvatarProbeHit
  | AvatarProbeMiss
  | AvatarProbeUnread

type AvatarResolution {
  standing: AvatarStanding
  source: AvatarSource
}

// THE CHAIN over the probe results: the first HIT wins; no hit with any unread probe is
// AvatarUnread (degraded, still initials-rendered); all misses is AvatarAbsent.
fn avatar_resolve(probe_internal: AvatarProbe, probe_directory: AvatarProbe, probe_cache: AvatarProbe) -> AvatarResolution {
  if probe_internal == AvatarProbeHit {
    AvatarResolution { standing: AvatarResolved, source: AvatarFromInternalProfile }
  } else if probe_directory == AvatarProbeHit {
    AvatarResolution { standing: AvatarResolved, source: AvatarFromGoogleDirectory }
  } else if probe_cache == AvatarProbeHit {
    AvatarResolution { standing: AvatarResolved, source: AvatarFromCachedPrior }
  } else if probe_internal == AvatarProbeUnread || probe_directory == AvatarProbeUnread || probe_cache == AvatarProbeUnread {
    AvatarResolution { standing: AvatarUnread, source: AvatarFromInitials }
  } else {
    AvatarResolution { standing: AvatarAbsent, source: AvatarFromInitials }
  }
}

// THE INITIALS FALLBACK, deterministic from the display name: the first character of the first
// two words (one word yields one initial). No case folding — the name's own characters render.
fn avatar_initials_of(display_name: String) -> String {
  let words = split(s: display_name, delimiter: " ")
  let first = match words.first() { Present { value: w } => if string_length(s: w) == 0 { "" } else { substring(s: w, start: 0, end: 1) }  Absent => "" }
  let second = match words.skip(n: 1).first() { Present { value: w } => if string_length(s: w) == 0 { "" } else { substring(s: w, start: 0, end: 1) }  Absent => "" }
  join([first, second], "")
}

// THE NEVER-BLOCKS LAW, one spelling: rendering falls back to initials under exactly the
// standings that carry no image.
fn avatar_initial_fallback(a: AvatarStanding) -> Bool {
  match a {
    AvatarResolved => false
    AvatarAbsent => true
    AvatarUnread => true
  }
}

fn issue_avatar_standing_wire(a: AvatarStanding) -> String {
  match a {
    AvatarResolved => "resolved"
    AvatarAbsent => "absent"
    AvatarUnread => "unread"
  }
}

// THE ROUTE'S VALIDATION, exactly as ruled: non-empty and either an email spelling or the fabric
// endpoint (display or qualified); anything else refuses at 400, never becomes an event. An email
// spelling is one @ with a non-empty local part and a dotted domain, and no whitespace anywhere.
fn issue_assignee_input_is_email(s: String) -> Bool {
  let t = trim(s)
  if t == "" {
    false
  } else {
    let parts = split(s: t, delimiter: "@")
    match parts.first() {
      Absent => false
      Present { value: local } =>
        match parts.skip(n: 1).first() {
          Absent => false
          Present { value: domain } =>
            count(parts) == 2
              && local != ""
              && domain != ""
              && string_contains(s: domain, pattern: ".")
              && !string_contains(s: t, pattern: " ")
        }
    }
  }
}

// Served roster: capture amended by owner rulings. TITLE links to detail; ID and
// D VIEWS retired 2026-09-25. TYPE and the separate task-count slot retire 2026-09-27:
// descriptive labels do not determine structure, and progress belongs with status.
type IssueResultsColumnKind
  = IssueColumnPriority
  | IssueColumnTitle
  | IssueColumnAssignee
  | IssueColumnStatus
  | IssueColumnLastModified

// The shared grid derives from this roster. TITLE takes the dominant flexible
// share; short columns have fixed widths independent of filtered row populations.
// Sort keys are model facts, distinct from rendered labels. Empty values sort last
// in both directions. Text uses case-insensitive comparison; priority is numeric;
// last-modified uses an ISO timestamp. Ties preserve the preceding row order.
type IssueResultsSortKey
  = IssueSortPriority
  | IssueSortTitle
  | IssueSortAssignee
  | IssueSortStatus
  | IssueSortModified

fn issue_results_sort_key_wire(key: IssueResultsSortKey) -> String {
  match key {
    IssueSortPriority => "priority"
    IssueSortTitle => "title"
    IssueSortAssignee => "assignee"
    IssueSortStatus => "status"
    IssueSortModified => "last-modified"
  }
}

fn issue_results_sort_numeric(key: IssueResultsSortKey) -> Bool {
  match key {
    IssueSortPriority => true
    IssueSortTitle => false
    IssueSortAssignee => false
    IssueSortStatus => false
    IssueSortModified => false
  }
}

type IssueResultsColumn {
  kind: IssueResultsColumnKind
  sort_key: IssueResultsSortKey
  header: NonEmptyStr
  track: NonEmptyStr
}

data issue_results_columns: List<IssueResultsColumn> = [
  IssueResultsColumn { kind: IssueColumnPriority, sort_key: IssueSortPriority, header: "P", track: "4ch" },
  IssueResultsColumn { kind: IssueColumnTitle, sort_key: IssueSortTitle, header: "TITLE", track: "minmax(0, 2fr)" },
  IssueResultsColumn { kind: IssueColumnAssignee, sort_key: IssueSortAssignee, header: "ASSIGNEE", track: "9ch" },
  IssueResultsColumn { kind: IssueColumnStatus, sort_key: IssueSortStatus, header: "STATUS", track: "minmax(0, 1fr)" },
  IssueResultsColumn { kind: IssueColumnLastModified, sort_key: IssueSortModified, header: "LAST MODIFIED", track: "12ch" },
]

fn issue_results_column_kind_wire(kind: IssueResultsColumnKind) -> String {
  match kind {
    IssueColumnPriority => "priority"
    IssueColumnTitle => "title"
    IssueColumnAssignee => "assignee"
    IssueColumnStatus => "status"
    IssueColumnLastModified => "last-modified"
  }
}

// One track per declared column, shared by headers and all rows. No special
// project/task action track: every issue has the same row structure.
fn issue_results_row_tracks() -> String {
  join(map(issue_results_columns, c => c.track as String), " ")
}
