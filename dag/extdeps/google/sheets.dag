// The same credential the Drive service reads, and for the same measured reason: gunbc run passes
// arguments only as argv, and on this fleet an argv word is readable by any job payload a pull
// request can influence. One variable serves both services because it is one operator credential
// for one converge; splitting it would mean two secrets with the same blast radius and one more
// thing to rotate. The literal is repeated here because the config parse extracts a literal. What
// test.claim.review_sheet_transport_pin_witness sheets_token_env_matches_the_configured_literal
// pins is THIS ROW against a third copy inside the claim, not the auth_source literal in the config
// below, which no fold can read -- so the claim cannot go red for a drift confined to the transport
// spelling. The sibling claim drive_and_sheets_read_one_credential is the stronger of the two,
// because it compares two DECLARATIONS with no third copy between them. See the matching note in
// extdeps.google.drive for the construction fix that would make the duplicate unwritable.
data sheets_token_env: String = "GUNBC_REVIEW_SHEET_TOKEN"

data sheets_api_version: NonEmptyStr = "v4"

data sheets_api_base: NonEmptyStr = concat("https://sheets.googleapis.com/", sheets_api_version as String) as NonEmptyStr

data sheets_serviceusage_api_id: NonEmptyStr = "sheets.googleapis.com"

data sheets_spreadsheets_oauth_scope: NonEmptyStr = "https://www.googleapis.com/auth/spreadsheets"

data sheets_spreadsheets_readonly_oauth_scope: NonEmptyStr = "https://www.googleapis.com/auth/spreadsheets.readonly"

data sheets_read_requests_per_minute_per_project: UpstreamRateLimit = UpstreamRateLimit {
  upstream: "google_sheets" as NonEmptyStr,
  scope: "read_requests_per_project" as NonEmptyStr,
  requests: 300,
  period: PerMinute
}

data sheets_write_requests_per_minute_per_project: UpstreamRateLimit = UpstreamRateLimit {
  upstream: "google_sheets" as NonEmptyStr,
  scope: "write_requests_per_project" as NonEmptyStr,
  requests: 300,
  period: PerMinute
}

data sheets_requests_per_minute_per_user: UpstreamRateLimit = UpstreamRateLimit {
  upstream: "google_sheets" as NonEmptyStr,
  scope: "requests_per_user" as NonEmptyStr,
  requests: 60,
  period: PerMinute
}

data sheets_rate_limits: List<UpstreamRateLimit> = [
  sheets_read_requests_per_minute_per_project,
  sheets_write_requests_per_minute_per_project,
  sheets_requests_per_minute_per_user
]

type SheetsMajorDimension = DimensionRows | DimensionColumns

fn sheets_major_dimension_wire(d: SheetsMajorDimension) -> String {
  match d {
    DimensionRows => "ROWS"
    DimensionColumns => "COLUMNS"
  }
}

fn sheets_major_dimension_from_wire(raw: String) -> SheetsMajorDimension? {
  if raw == sheets_major_dimension_wire(d: DimensionRows) {
    Present { value: DimensionRows }
  } else {
    if raw == sheets_major_dimension_wire(d: DimensionColumns) {
      Present { value: DimensionColumns }
    } else {
      none
    }
  }
}

type SheetsValueInputOption = InputRaw | InputUserEntered

fn sheets_value_input_option_wire(o: SheetsValueInputOption) -> String {
  match o {
    InputRaw => "RAW"
    InputUserEntered => "USER_ENTERED"
  }
}

fn sheets_value_input_option_from_wire(raw: String) -> SheetsValueInputOption? {
  if raw == sheets_value_input_option_wire(o: InputRaw) {
    Present { value: InputRaw }
  } else {
    if raw == sheets_value_input_option_wire(o: InputUserEntered) {
      Present { value: InputUserEntered }
    } else {
      none
    }
  }
}

type SheetsValueRenderOption = RenderFormattedValue | RenderUnformattedValue | RenderFormula

fn sheets_value_render_option_wire(o: SheetsValueRenderOption) -> String {
  match o {
    RenderFormattedValue => "FORMATTED_VALUE"
    RenderUnformattedValue => "UNFORMATTED_VALUE"
    RenderFormula => "FORMULA"
  }
}

fn sheets_value_render_option_from_wire(raw: String) -> SheetsValueRenderOption? {
  if raw == sheets_value_render_option_wire(o: RenderFormattedValue) {
    Present { value: RenderFormattedValue }
  } else {
    if raw == sheets_value_render_option_wire(o: RenderUnformattedValue) {
      Present { value: RenderUnformattedValue }
    } else {
      if raw == sheets_value_render_option_wire(o: RenderFormula) {
        Present { value: RenderFormula }
      } else {
        none
      }
    }
  }
}

// A1 NOTATION: THE SHEET-TITLE TOKEN (sheets_a1_notation_citation). A qualified A1 range is
// `<title>!<cells>`; the guide spells a title with a space as `'My Custom Sheet'!A:A` and states
// single quotes are required for names with spaces, special characters or an alphanumeric
// combination, and an embedded single quote is doubled inside the quotes. The guide never forbids
// quoting a plain name, and `'Sheet1'!A1` is accepted, so the ENCODER ALWAYS QUOTES: one spelling,
// no "is this title a plain identifier" classifier to get wrong. That quoting a plain name is
// admitted is an observed API behaviour beside the guide, not a sentence the guide prints.
// The DECODER models what values.get actually returns in ValueRange.range: plain titles come back
// bare (`Sheet1!A1:Z1000`), others quoted (`'Buyer Review'!A1:C1`), so both spellings decode. The
// quoted title is scanned to its closing quote BEFORE any '!' is looked for, because a quoted
// title may itself contain '!'.

fn a1_sheet_title_wire(title: NonEmptyStr) -> String {
  concat("'", concat(replace(title as String, "'", "''"), "'"))
}

fn a1_qualified_range_wire(title: NonEmptyStr, cells: String) -> String {
  concat(a1_sheet_title_wire(title: title), concat("!", cells))
}

type A1SheetTitleRefusal
  = A1TitleUnterminatedQuote
  | A1TitleBadEscape { at: Int }
  | A1TitleEmpty

fn a1_sheet_title_refusal_text(refusal: A1SheetTitleRefusal) -> String {
  match refusal {
    A1TitleUnterminatedQuote => "A1 sheet title: unterminated quote"
    A1TitleBadEscape { at: i } =>
      concat("A1 sheet title: single quote not escaped as '' at offset ", to_string(i))
    A1TitleEmpty => "A1 sheet title: empty title"
  }
}

type A1RangeTitleDecode
  = A1TitleQualified { title: NonEmptyStr, cells: String }
  | A1TitleWholeSheet { title: NonEmptyStr }
  | A1TitleUnqualified { text: String }
  | A1TitleRefused { refusal: A1SheetTitleRefusal }

// Index of the closing quote of a quoted title that opened at 0; `''` is an escaped quote.
fn a1_quoted_title_close_from(s: String, i: Int, len: Int) -> Int? {
  if i >= len {
    Absent
  } else if char_at(s, i) != "'" {
    a1_quoted_title_close_from(s: s, i: i + 1, len: len)
  } else if (i + 1 < len) && (char_at(s, i + 1) == "'") {
    a1_quoted_title_close_from(s: s, i: i + 2, len: len)
  } else {
    Present { value: i }
  }
}

fn a1_bare_bang_from(s: String, i: Int, len: Int) -> Int? {
  if i >= len {
    Absent
  } else if char_at(s, i) == "!" {
    Present { value: i }
  } else {
    a1_bare_bang_from(s: s, i: i + 1, len: len)
  }
}

fn a1_bare_quote_from(s: String, i: Int, end: Int) -> Int? {
  if i >= end {
    Absent
  } else if char_at(s, i) == "'" {
    Present { value: i }
  } else {
    a1_bare_quote_from(s: s, i: i + 1, end: end)
  }
}

fn a1_range_title_decode(range: String) -> A1RangeTitleDecode {
  let len = string_length(s: range)
  if len == 0 {
    A1TitleRefused { refusal: A1TitleEmpty }
  } else if char_at(range, 0) == "'" {
    match a1_quoted_title_close_from(s: range, i: 1, len: len) {
      Absent => A1TitleRefused { refusal: A1TitleUnterminatedQuote }
      Present { value: close } => {
        let body = substring(s: range, start: 1, end: close)
        if body == "" {
          A1TitleRefused { refusal: A1TitleEmpty }
        } else if close + 1 == len {
          A1TitleWholeSheet { title: replace(body, "''", "'") as NonEmptyStr }
        } else if char_at(range, close + 1) == "!" {
          A1TitleQualified {
            title: replace(body, "''", "'") as NonEmptyStr,
            cells: substring(s: range, start: close + 2, end: len),
          }
        } else {
          A1TitleRefused { refusal: A1TitleBadEscape { at: close } }
        }
      }
    }
  } else {
    match a1_bare_bang_from(s: range, i: 0, len: len) {
      Absent =>
        match a1_bare_quote_from(s: range, i: 0, end: len) {
          Present { value: q } => A1TitleRefused { refusal: A1TitleBadEscape { at: q } }
          Absent => A1TitleUnqualified { text: range }
        }
      Present { value: bang } =>
        if bang == 0 {
          A1TitleRefused { refusal: A1TitleEmpty }
        } else {
          match a1_bare_quote_from(s: range, i: 0, end: bang) {
            Present { value: q } => A1TitleRefused { refusal: A1TitleBadEscape { at: q } }
            Absent =>
              A1TitleQualified {
                title: substring(s: range, start: 0, end: bang) as NonEmptyStr,
                cells: substring(s: range, start: bang + 1, end: len),
              }
          }
        }
    }
  }
}

type SheetsError {
  code: Int
  message: String
  status: String
}

type ValueRange {
  range: String
  majorDimension: String?
  values: List<List<String>>?
}

data structural_coverage_gap_value_range_cell_types: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "ValueRange" },
      JsonPending { field: "values[][] number-or-bool cells" }
    ],
    trigger: "a consumer needs unformatted numeric or boolean cells rather than FORMATTED_VALUE strings"
  }
]

// Proto3 JSON omits default integers, so a zero-cell batchUpdate may omit totalUpdatedCells.
// The operation output uses the same optionality; a required Int would refuse a legal body or mint 0.
// A REQUEST VALUE RANGE IS NOT A RESPONSE VALUE RANGE, and the first live write is what proved it.
// ValueRange.values is Optional because a response may omit it -- values.get on an empty range
// returns no values field at all -- but an Optional does not serialise to a bare array: it carries
// its variant, so a request body built from ValueRange reaches Sheets as
// {"values":{"_variant":"Present","value":[[...]]}} and is refused with "Unknown name _variant".
//
// The mock corpus could not catch this. PublishedMockCase fixes the RESPONSE shape, so a witness
// over it agrees with a request encoding nobody ever sent. That is shape agreement standing in for
// execution, and the wire is where the two part company.
//
// gunbc.review_sheet_sheets value_range_from_derived_write builds the Optional form and has never
// executed -- it is the caller live_sheets_transport_frontier reserved. It needs this type before
// its first write, and that is a defect in a landed module rather than a gap in a new one.
type BatchUpdateSpreadsheetResponse {
  spreadsheetId: String
}

// A SHEETS COLOUR CHANNEL IS A FLOAT IN [0,1] AND A SWATCH IS AN 8-BIT INTEGER. An earlier revision
// of the consuming module transcribed the quotient as a decimal and said the corpus could not
// compute it. That was wrong: std.coercion enrols Int -> Float as an admitted cast, and
// std.integer derives the 8-bit inclusive maximum, so the whole conversion is expressible and the
// consumer derives it. This type stays the wire shape and carries no arithmetic.
type SheetsColor {
  red: Float
  green: Float
  blue: Float
}

data spreadsheet_first_sheet_id: Int = 0

// THE READ SIDE OF A COLOUR, AND IT IS NOT THE WRITE SIDE'S TYPE. Google's JSON omits a field whose
// value equals the proto3 default, so a channel of zero comes back ABSENT rather than 0.0 -- the
// vermillion this sheet writes, Srgb8 { r: 213, g: 94, b: 0 }, reads back with no blue key at all.
// Modelling the read with the write's non-optional Float would make the decoder refuse a response
// the API is entitled to send, and defaulting absent to anything but zero would invent a colour.
// Absent IS zero here, and sheets_color_channel_read is the only place that says so.
type SheetsColorRead {
  red: Float?
  green: Float?
  blue: Float?
}

fn sheets_color_channel_read(channel: Float?) -> Float {
  match channel {
    Present { value: v } => v
    Absent => 0.0
  }
}

type SheetsTextFormatRead {
  foregroundColor: SheetsColorRead?
  bold: Bool?
}

type SheetsCellFormatRead {
  backgroundColor: SheetsColorRead?
  textFormat: SheetsTextFormatRead?
}

// userEnteredFormat IS WHAT THIS REPOSITORY WROTE; effectiveFormat is what a viewer sees after
// inheritance from the sheet and workbook defaults. They answer different questions and both are
// modelled so a consumer must choose: a converge verifying its own write reads userEnteredFormat,
// and a consumer asking what the sheet looks like on screen reads effectiveFormat. Folding them
// into one field would let a converge adopt a colour it never wrote.
type SheetsCellDataRead {
  userEnteredFormat: SheetsCellFormatRead?
  effectiveFormat: SheetsCellFormatRead?
}

type SheetsRowDataRead {
  values: List<SheetsCellDataRead>?
}

type SheetsGridDataRead {
  rowData: List<SheetsRowDataRead>?
}

// frozenRowCount is absent when no rows are frozen, for the same proto3 reason as a zero colour
// channel, so an unfrozen header and an unread response are distinguished by the OPTIONAL being
// absent versus the whole properties record being absent -- not by a count of zero.
type SheetsGridPropertiesRead {
  frozenRowCount: Int?
}

type SheetsSheetPropertiesRead {
  sheetId: Int?
  gridProperties: SheetsGridPropertiesRead?
}

type SheetsBooleanConditionValueRead {
  userEnteredValue: String?
}

type SheetsBooleanConditionRead {
  type: String?
  values: List<SheetsBooleanConditionValueRead>?
}

type SheetsBooleanRuleRead {
  condition: SheetsBooleanConditionRead?
  format: SheetsCellFormatRead?
}

type SheetsConditionalFormatRuleRead {
  booleanRule: SheetsBooleanRuleRead?
}

type SheetsSheetRead {
  properties: SheetsSheetPropertiesRead?
  data: List<SheetsGridDataRead>?
  conditionalFormats: List<SheetsConditionalFormatRuleRead>?
}

type SpreadsheetRead {
  spreadsheetId: String?
  sheets: List<SheetsSheetRead>?
}

type ValueRangeWrite {
  range: String
  majorDimension: String
  values: List<List<String>>
}

type BatchUpdateValuesResponse {
  spreadsheetId: String
  totalUpdatedRows: Int?
  totalUpdatedColumns: Int?
  totalUpdatedCells: Int?
  totalUpdatedSheets: Int?
  responses: List<ValueRange>?
}

// THE READ THAT MAKES FORMATTING CONVERGEABLE. Without it a format actuator can only report what
// the API answered to its write, never what the sheet now carries, so re-running re-applies
// instead of adopting and a conditional rule accumulates on every pass.
//
// TWO INPUTS KEEP THIS CHEAP AND THEY ARE NOT OPTIONAL IN PRACTICE. `range` bounds the grid data
// to the rows a caller actually inspects -- reading a whole prospect sheet to check one header row
// would grow with the census -- and `fields` is a field mask restricting the response to the
// branches read here. Sheets returns grid data only when the mask selects it, so the mask is what
// makes include_grid_data meaningful rather than a second switch that can disagree with it.
//
// ONE RANGE, NOT A LIST, AND THAT IS A TRANSPORT LIMIT STATED RATHER THAN PAPERED OVER. Upstream
// accepts `ranges` repeated, and the obvious modelling is List<String>. This transport cannot
// send a repeated query parameter: the interpreter renders a query value with Display, and a list
// renders as "[A1:Q1]", so a List input would have sent one bracketed literal that Sheets would
// read as a malformed range. A caller needing several ranges needs repeated-parameter support in
// the transport first, which is the trigger for widening this back.
//
// GetSpreadsheetMetadata CARRIES NO RANGE, AND THAT IS THE WHOLE REASON IT IS A SECOND OPERATION
// BESIDE GetSpreadsheet RATHER THAN A DIFFERENT ARGUMENT TO IT. `ranges` cannot be omitted by
// passing an empty string -- Sheets answers 400 "Unable to parse range: " -- and a declared query
// parameter cannot be left out, so a caller that needs sheet METADATA rather than grid data needs
// an operation that never names a range. It also must not name one: Sheets filters
// conditionalFormats to the rules INTERSECTING the requested ranges, so any range chosen to bound
// a grid read silently hides the rules that fall outside it, which is how a readback came to be
// unable to see its own work (gunbc.recurring_failure_mode readback_scoped_to_exclude_the_effect_it_verifies).
service sheets.Spreadsheets {
  config {
    endpoint: sheets_api_base
    auth: Bearer
    auth_source: EnvVar { name: "GUNBC_REVIEW_SHEET_TOKEN" }
  }

  operation GetSpreadsheet {
    input {
      spreadsheet_id: String
      range: String
      fields: String
      include_grid_data: Bool = false
    }
    output {
      result: SpreadsheetRead
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/spreadsheets/\{spreadsheet_id\}",
      query: { ranges: range, fields: fields, includeGridData: include_grid_data }
    }
    response {
      200 => SpreadsheetRead
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      500 => SheetsError
    }
  }
  operation GetSpreadsheetMetadata {
    input {
      spreadsheet_id: String
      fields: String
    }
    output {
      result: SpreadsheetRead
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/spreadsheets/\{spreadsheet_id\}",
      query: { fields: fields }
    }
    response {
      200 => SpreadsheetRead
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      500 => SheetsError
    }
  }
  operation GetValues {
    input {
      spreadsheet_id: String
      range: String
      value_render_option: SheetsValueRenderOption
    }
    output {
      value_range: ValueRange
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/spreadsheets/\{spreadsheet_id\}/values/\{range\}",
      query: { valueRenderOption: sheets_value_render_option_wire(o: value_render_option) }
    }
    response {
      200 => ValueRange
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }

  operation BatchUpdateValues {
    input {
      spreadsheet_id: String
      value_input_option: SheetsValueInputOption
      data: List<ValueRangeWrite>
      include_values_in_response: Bool = false
    }
    output {
      spreadsheet_id: String from "spreadsheetId"
      total_updated_cells: Int? from "totalUpdatedCells"
      outcome: RestOutcome
    }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}/values:batchUpdate",
      body: {
        valueInputOption: sheets_value_input_option_wire(o: value_input_option),
        data: data,
        includeValuesInResponse: include_values_in_response
      }
    }
    response {
      200 => BatchUpdateValuesResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }

  operation SetFrozenRows {
    input { spreadsheet_id: String, sheet_id: Int, frozen_row_count: Int }
    output { spreadsheet_id: String from "spreadsheetId", outcome: RestOutcome }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}:batchUpdate",
      body: {
        requests: [
          {
            updateSheetProperties: {
              properties: { sheetId: sheet_id, gridProperties: { frozenRowCount: frozen_row_count } },
              fields: "gridProperties.frozenRowCount"
            }
          }
        ]
      }
    }
    response {
      200 => BatchUpdateSpreadsheetResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }
  operation FormatCellRange {
    input {
      spreadsheet_id: String
      sheet_id: Int
      start_row: Int
      end_row: Int
      start_col: Int
      end_col: Int
      background: SheetsColor
      foreground: SheetsColor
      bold: Bool
    }
    output { spreadsheet_id: String from "spreadsheetId", outcome: RestOutcome }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}:batchUpdate",
      body: {
        requests: [
          {
            repeatCell: {
              range: {
                sheetId: sheet_id,
                startRowIndex: start_row,
                endRowIndex: end_row,
                startColumnIndex: start_col,
                endColumnIndex: end_col
              },
              cell: {
                userEnteredFormat: {
                  backgroundColor: background,
                  textFormat: { bold: bold, foregroundColor: foreground }
                }
              },
              fields: "userEnteredFormat(backgroundColor,textFormat)"
            }
          }
        ]
      }
    }
    response {
      200 => BatchUpdateSpreadsheetResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }
  operation AddTextColorRule {
    input {
      spreadsheet_id: String
      sheet_id: Int
      start_row: Int
      start_col: Int
      end_col: Int
      match_text: String
      foreground: SheetsColor
      rule_index: Int
    }
    output { spreadsheet_id: String from "spreadsheetId", outcome: RestOutcome }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}:batchUpdate",
      body: {
        requests: [
          {
            addConditionalFormatRule: {
              rule: {
                ranges: [
                  {
                    sheetId: sheet_id,
                    startRowIndex: start_row,
                    startColumnIndex: start_col,
                    endColumnIndex: end_col
                  }
                ],
                booleanRule: {
                  condition: { type: "TEXT_CONTAINS", values: [{ userEnteredValue: match_text }] },
                  format: { textFormat: { bold: true, foregroundColor: foreground } }
                }
              },
              index: rule_index
            }
          }
        ]
      }
    }
    response {
      200 => BatchUpdateSpreadsheetResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }
}
