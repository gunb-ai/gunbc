type SheetsMajorDimension = DimensionRows | DimensionColumns

fn sheets_major_dimension_wire(d: SheetsMajorDimension) -> String {
  match d {
    DimensionRows => "ROWS"
    DimensionColumns => "COLUMNS"
  }
}

fn sheets_major_dimension_from_wire(raw: String) -> SheetsMajorDimension? {
  if raw == sheets_major_dimension_wire(d: DimensionRows) {
    Present { value: DimensionRows }
  } else {
    if raw == sheets_major_dimension_wire(d: DimensionColumns) {
      Present { value: DimensionColumns }
    } else {
      none
    }
  }
}

type SheetsValueInputOption = InputRaw | InputUserEntered

fn sheets_value_input_option_wire(o: SheetsValueInputOption) -> String {
  match o {
    InputRaw => "RAW"
    InputUserEntered => "USER_ENTERED"
  }
}

fn sheets_value_input_option_from_wire(raw: String) -> SheetsValueInputOption? {
  if raw == sheets_value_input_option_wire(o: InputRaw) {
    Present { value: InputRaw }
  } else {
    if raw == sheets_value_input_option_wire(o: InputUserEntered) {
      Present { value: InputUserEntered }
    } else {
      none
    }
  }
}

type SheetsValueRenderOption = RenderFormattedValue | RenderUnformattedValue | RenderFormula

fn sheets_value_render_option_wire(o: SheetsValueRenderOption) -> String {
  match o {
    RenderFormattedValue => "FORMATTED_VALUE"
    RenderUnformattedValue => "UNFORMATTED_VALUE"
    RenderFormula => "FORMULA"
  }
}

fn sheets_value_render_option_from_wire(raw: String) -> SheetsValueRenderOption? {
  if raw == sheets_value_render_option_wire(o: RenderFormattedValue) {
    Present { value: RenderFormattedValue }
  } else {
    if raw == sheets_value_render_option_wire(o: RenderUnformattedValue) {
      Present { value: RenderUnformattedValue }
    } else {
      if raw == sheets_value_render_option_wire(o: RenderFormula) {
        Present { value: RenderFormula }
      } else {
        none
      }
    }
  }
}

// A1 NOTATION: THE SHEET-TITLE TOKEN (sheets_a1_notation_citation). A qualified A1 range is
// `<title>!<cells>`. The guide's lines this codec rests on, verbatim:
//   "Single quotes are required for sheet names with spaces or special characters."
//   "'My Custom Sheet'!A:A refers to all the cells in the first column of a sheet named
//   "My Custom Sheet.""
//   "A1 (without quotes) refers to cell A1 in the first visible sheet. 'A1' refers to a sheet
//   with the name A1."
//   "'Sheet1' refers to the sheet."
//   "'Jon's_Data'!A1:D5 refers to all the cells in the first five rows and four columns of a
//   sheet named "Jon's_Data.""
// So the ENCODER ALWAYS QUOTES: the guide itself says a quoted plain name ('Sheet1', 'A1') denotes
// the sheet, and one spelling needs no "is this a plain identifier" classifier.
// An APOSTROPHE inside a title is not grounded. The guide spells Jon's_Data UNDOUBLED, and whether
// the API accepts or returns the doubled form is unobserved (a1_title_apostrophe_spelling_standing).
// So the encoder REFUSES such a title rather than guess an escape, and the decoder reads only what
// is unambiguous under both spellings.

data a1_title_apostrophe_spelling_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "developers.google.com/sheets/api/guides/concepts#cell shows 'Jon's_Data'!A1:D5 with the apostrophe UNDOUBLED and states no escape rule; whether values.get returns, and values.batchUpdate accepts, a doubled '' inside a quoted title is unobserved. Discriminator: a live values.get and values.batchUpdate against a temporary tab whose title contains an apostrophe, reading the ValueRange.range spelling the API returns",
}

type A1RangeEncoding
  = A1RangeEncoded { wire: String }
  | A1TitleApostropheUnsupported { title: NonEmptyStr }

fn a1_range_encoding_text(e: A1RangeEncoding) -> String {
  match e {
    A1RangeEncoded { wire: w } => w
    A1TitleApostropheUnsupported { title: t } =>
      concat(
        "A1 sheet title contains an apostrophe, whose spelling is unobserved: ",
        concat(
          t as String,
          concat(
            " -- read obligation: ",
            match cited_figure_read_obligation(standing: a1_title_apostrophe_spelling_standing) {
              Present { value: o } => o as String
              Absent => ""
            },
          ),
        ),
      )
  }
}

// cells Absent is the whole-sheet range: the quoted title alone.
fn a1_range_encode(title: NonEmptyStr, cells: String?) -> A1RangeEncoding {
  if string_contains(s: title as String, pattern: "'") {
    A1TitleApostropheUnsupported { title: title }
  } else {
    let token = concat("'", concat(title as String, "'"))
    match cells {
      Absent => A1RangeEncoded { wire: token }
      Present { value: c } => A1RangeEncoded { wire: concat(token, concat("!", c)) }
    }
  }
}

type A1SheetTitleRefusal
  = A1TitleUnterminatedQuote
  | A1TitleBadEscape { at: Int }
  | A1TitleApostropheAmbiguous { at: Int }
  | A1TitleEmpty

fn a1_sheet_title_refusal_text(refusal: A1SheetTitleRefusal) -> String {
  match refusal {
    A1TitleUnterminatedQuote => "A1 sheet title: unterminated quote"
    A1TitleBadEscape { at: i } =>
      concat("A1 sheet title: apostrophe in an unquoted title at offset ", to_string(i))
    A1TitleApostropheAmbiguous { at: i } =>
      concat("A1 sheet title: apostrophe spelling is ambiguous, and the API's escape rule is unobserved; at offset ", to_string(i))
    A1TitleEmpty => "A1 sheet title: empty title"
  }
}

type A1RangeTitleDecode
  = A1TitleQualified { title: NonEmptyStr, cells: String }
  | A1TitleWholeSheet { title: NonEmptyStr }
  | A1TitleUnqualified { text: String }
  | A1TitleRefused { refusal: A1SheetTitleRefusal }

type A1TitleScan = A1ScanAt { index: Int } | A1ScanNone

type A1QuotedClose = A1QuotedClosedAt { index: Int } | A1QuotedAmbiguousAt { index: Int } | A1QuotedUnterminated

// Inside a quoted title opened at 0: an apostrophe followed by '!' or the end CLOSES the title; one
// followed by any other character is a literal apostrophe (the guide's 'Jon's_Data'); a pair ''
// is refused, because it reads as one escaped apostrophe or two literal ones and no source decides.
fn a1_quoted_title_close_from(s: String, i: Int, len: Int) -> A1QuotedClose {
  if i >= len {
    A1QuotedUnterminated
  } else if char_at(s, i) != "'" {
    a1_quoted_title_close_from(s: s, i: i + 1, len: len)
  } else if i + 1 == len {
    A1QuotedClosedAt { index: i }
  } else if char_at(s, i + 1) == "!" {
    A1QuotedClosedAt { index: i }
  } else if char_at(s, i + 1) == "'" {
    A1QuotedAmbiguousAt { index: i }
  } else {
    a1_quoted_title_close_from(s: s, i: i + 1, len: len)
  }
}

fn a1_char_from(s: String, ch: String, i: Int, end: Int) -> A1TitleScan {
  if i >= end {
    A1ScanNone
  } else if char_at(s, i) == ch {
    A1ScanAt { index: i }
  } else {
    a1_char_from(s: s, ch: ch, i: i + 1, end: end)
  }
}

fn a1_range_title_decode(range: String) -> A1RangeTitleDecode {
  let len = string_length(s: range)
  if len == 0 {
    A1TitleRefused { refusal: A1TitleEmpty }
  } else if char_at(range, 0) == "'" {
    match a1_quoted_title_close_from(s: range, i: 1, len: len) {
      A1QuotedUnterminated => A1TitleRefused { refusal: A1TitleUnterminatedQuote }
      A1QuotedAmbiguousAt { index: i } => A1TitleRefused { refusal: A1TitleApostropheAmbiguous { at: i } }
      A1QuotedClosedAt { index: close } => {
        let title = substring(s: range, start: 1, end: close)
        if title == "" {
          A1TitleRefused { refusal: A1TitleEmpty }
        } else if close + 1 == len {
          A1TitleWholeSheet { title: title as NonEmptyStr }
        } else {
          let cells = substring(s: range, start: close + 2, end: len)
          match a1_char_from(s: cells, ch: "'", i: 0, end: string_length(s: cells)) {
            A1ScanAt { index: q } =>
              A1TitleRefused { refusal: A1TitleApostropheAmbiguous { at: close + 2 + q } }
            A1ScanNone => A1TitleQualified { title: title as NonEmptyStr, cells: cells }
          }
        }
      }
    }
  } else {
    match a1_char_from(s: range, ch: "!", i: 0, end: len) {
      A1ScanNone =>
        match a1_char_from(s: range, ch: "'", i: 0, end: len) {
          A1ScanAt { index: q } => A1TitleRefused { refusal: A1TitleBadEscape { at: q } }
          A1ScanNone => A1TitleUnqualified { text: range }
        }
      A1ScanAt { index: bang } =>
        if bang == 0 {
          A1TitleRefused { refusal: A1TitleEmpty }
        } else {
          match a1_char_from(s: range, ch: "'", i: 0, end: bang) {
            A1ScanAt { index: q } => A1TitleRefused { refusal: A1TitleBadEscape { at: q } }
            A1ScanNone =>
              A1TitleQualified {
                title: substring(s: range, start: 0, end: bang) as NonEmptyStr,
                cells: substring(s: range, start: bang + 1, end: len),
              }
          }
        }
    }
  }
}

type SheetsError {
  code: Int
  message: String
  status: String
}

type ValueRange {
  range: String
  majorDimension: String?
  values: List<List<String>>?
}

data structural_coverage_gap_value_range_cell_types: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "ValueRange" },
      JsonPending { field: "values[][] number-or-bool cells" }
    ],
    trigger: "a consumer needs unformatted numeric or boolean cells rather than FORMATTED_VALUE strings"
  }
]

// Proto3 JSON omits default integers, so a zero-cell batchUpdate may omit totalUpdatedCells.
// The operation output uses the same optionality; a required Int would refuse a legal body or mint 0.
// A REQUEST VALUE RANGE IS NOT A RESPONSE VALUE RANGE, and the first live write is what proved it.
// ValueRange.values is Optional because a response may omit it -- values.get on an empty range
// returns no values field at all -- but an Optional does not serialise to a bare array: it carries
// its variant, so a request body built from ValueRange reaches Sheets as
// {"values":{"_variant":"Present","value":[[...]]}} and is refused with "Unknown name _variant".
//
// The mock corpus could not catch this. PublishedMockCase fixes the RESPONSE shape, so a witness
// over it agrees with a request encoding nobody ever sent. That is shape agreement standing in for
// execution, and the wire is where the two part company.
//
// gunbc.review_sheet_sheets once lowered a write plan to the Optional form, and it never executed
// -- it was the caller live_sheets_transport_frontier reserved. lower_write_plan now builds this
// type; the defect was in a landed module rather than a gap in a new one.
type BatchUpdateSpreadsheetResponse {
  spreadsheetId: String
}

// A SHEETS COLOUR CHANNEL IS A FLOAT IN [0,1] AND A SWATCH IS AN 8-BIT INTEGER. An earlier revision
// of the consuming module transcribed the quotient as a decimal and said the corpus could not
// compute it. That was wrong: std.coercion enrols Int -> Float as an admitted cast, and
// std.integer derives the 8-bit inclusive maximum, so the whole conversion is expressible and the
// consumer derives it. This type stays the wire shape and carries no arithmetic.
type SheetsColor {
  red: Float
  green: Float
  blue: Float
}

// THE FIELD PATHS A MASK IS BUILT FROM, NAMED ONCE, BECAUSE A MASK AND A DECODE ARE ONE FACT.
// A spreadsheets.get field mask is a list of upstream field paths, and every consumer that spells
// one as a literal is authoring a second representation of what its own decode reads. That fork
// is not theoretical: the format actuator's readback was changed to select a sheet by its
// sheetId while its two masks still asked for no sheetId at all, so the selector looked for a
// field the request had told Sheets not to send -- the grid read matched no sheet whatsoever and
// the converge refused every time (review 68553). Nothing caught it because a mask literal and a
// decode fold have no relation a compiler or a claim can check.
//
// These rows are that relation. A consumer composes its mask from the same named path its decode
// keys on, so widening the reading and widening the request are one edit rather than two that can
// drift. They are extdeps facts because the spelling is upstream's, not ours.
data sheets_field_sheet_id: String = "sheets.properties.sheetId"

data sheets_field_sheet_title: String = "sheets.properties.title"

data sheets_field_sheet_index: String = "sheets.properties.index"

data sheets_field_frozen_row_count: String = "sheets.properties.gridProperties.frozenRowCount"

data sheets_field_conditional_formats: String = "sheets.conditionalFormats"

data sheets_field_user_entered_format: String = "sheets.data.rowData.values.userEnteredFormat"

fn sheets_field_mask(paths: List<String>) -> String {
  join(paths, ",")
}


// THE READ SIDE OF A COLOUR, AND IT IS NOT THE WRITE SIDE'S TYPE. Google's JSON omits a field whose
// value equals the proto3 default, so a channel of zero comes back ABSENT rather than 0.0 -- the
// vermillion this sheet writes, Srgb8 { r: 213, g: 94, b: 0 }, reads back with no blue key at all.
// Modelling the read with the write's non-optional Float would make the decoder refuse a response
// the API is entitled to send, and defaulting absent to anything but zero would invent a colour.
// Absent IS zero here, and sheets_color_channel_read is the only place that says so.
type SheetsColorRead {
  red: Float?
  green: Float?
  blue: Float?
}

fn sheets_color_channel_read(channel: Float?) -> Float {
  match channel {
    Present { value: v } => v
    Absent => 0.0
  }
}

fn sheets_sheet_id_read(id: Int?) -> Int {
  match id {
    Present { value: v } => v
    Absent => 0
  }
}

fn sheets_sheet_index_read(index: Int?) -> Int {
  match index {
    Present { value: v } => v
    Absent => 0
  }
}

type SheetsTextFormatRead {
  foregroundColor: SheetsColorRead?
  bold: Bool?
}

type SheetsCellFormatRead {
  backgroundColor: SheetsColorRead?
  textFormat: SheetsTextFormatRead?
}

// userEnteredFormat IS WHAT THIS REPOSITORY WROTE; effectiveFormat is what a viewer sees after
// inheritance from the sheet and workbook defaults. They answer different questions and both are
// modelled so a consumer must choose: a converge verifying its own write reads userEnteredFormat,
// and a consumer asking what the sheet looks like on screen reads effectiveFormat. Folding them
// into one field would let a converge adopt a colour it never wrote.
type SheetsCellDataRead {
  userEnteredFormat: SheetsCellFormatRead?
  effectiveFormat: SheetsCellFormatRead?
}

type SheetsRowDataRead {
  values: List<SheetsCellDataRead>?
}

type SheetsGridDataRead {
  rowData: List<SheetsRowDataRead>?
}

// frozenRowCount is absent when no rows are frozen, for the same proto3 reason as a zero colour
// channel, so an unfrozen header and an unread response are distinguished by the OPTIONAL being
// absent versus the whole properties record being absent -- not by a count of zero.
type SheetsGridPropertiesRead {
  frozenRowCount: Int?
}

// title AND index ARE THE TAB'S IDENTITY AND THEY ARE NOT THE FILE'S. A spreadsheet is a Drive
// file with a display name, and every tab inside it carries its own title -- upstream calls the
// file a Spreadsheet and each tab a Sheet, and sheets.properties.title is the tab's. Modelling
// only sheetId left a consumer with no way to name the tab it had located, so the values path took
// a title from its caller and the format path addressed sheet 0. Both are here because both come
// back in one spreadsheets.get: sheetId is what a batchUpdate request addresses, title is what an
// A1 range qualifies with, and index is the tab's position in the workbook, carried because the
// response carries it and a consumer adjudicating two tabs needs to say which one it means.
//
// All three are Optional, and the three absences do NOT mean the same thing. sheetId and index
// are Int and a first tab has 0 for both, which equals the proto3 default and is therefore OMITTED
// from the JSON -- exactly as a zero colour channel and an unfrozen frozenRowCount are omitted, and
// absent IS zero for the same reason. sheets_sheet_id_read and sheets_sheet_index_read are the only
// places that say so, beside sheets_color_channel_read which already said it for a channel.
//
// title is NOT that case. Its proto3 default is the empty string and upstream never names a tab
// with one, so an absent title is a response this model could not read rather than a tab called
// nothing -- and a consumer that substituted a name there would be inventing the tab's identity.
// Nothing here decides that; the type keeps the distinction and the consumer refuses on it.
type SheetsSheetPropertiesRead {
  sheetId: Int?
  title: String?
  index: Int?
  gridProperties: SheetsGridPropertiesRead?
}

type SheetsBooleanConditionValueRead {
  userEnteredValue: String?
}

type SheetsBooleanConditionRead {
  type: String?
  values: List<SheetsBooleanConditionValueRead>?
}

type SheetsBooleanRuleRead {
  condition: SheetsBooleanConditionRead?
  format: SheetsCellFormatRead?
}

type SheetsConditionalFormatRuleRead {
  booleanRule: SheetsBooleanRuleRead?
}

type SheetsSheetRead {
  properties: SheetsSheetPropertiesRead?
  data: List<SheetsGridDataRead>?
  conditionalFormats: List<SheetsConditionalFormatRuleRead>?
}

type SpreadsheetRead {
  spreadsheetId: String?
  sheets: List<SheetsSheetRead>?
}

type ValueRangeWrite {
  range: String
  majorDimension: String
  values: List<List<String>>
}

type BatchUpdateValuesResponse {
  spreadsheetId: String
  totalUpdatedRows: Int?
  totalUpdatedColumns: Int?
  totalUpdatedCells: Int?
  totalUpdatedSheets: Int?
  responses: List<ValueRange>?
}

// THE HERMETIC values.get FIXTURE IS AN EMPTY WHOLE TAB. mock_response can publish one result, so
// the hermetic arm is the decoded-200 shape of values.get over a tab holding no values: the range
// Sheets reports for a whole-tab request (the quoted title, then the grid extent) and no values
// field, which is how the API spells an empty range. The title is the fixture's identity -- a live
// tab is not named this, and a live read of a non-empty tab cannot answer without values. Like the
// github.Users fixture, mock_response evaluates with an empty env, so every part is a data row.
data hermetic_get_values_tab: NonEmptyStr = "hermetic-mock-tab"
data hermetic_get_values_range: String = "'hermetic-mock-tab'!A1:Z1000"
data hermetic_get_values_value_range: ValueRange = ValueRange {
  range: hermetic_get_values_range,
  majorDimension: Absent,
  values: Absent,
}
data hermetic_get_values_outcome: RestOutcome = RestOk

// THE READ THAT MAKES FORMATTING CONVERGEABLE. Without it a format actuator can only report what
// the API answered to its write, never what the sheet now carries, so re-running re-applies
// instead of adopting and a conditional rule accumulates on every pass.
//
// TWO INPUTS KEEP THIS CHEAP AND THEY ARE NOT OPTIONAL IN PRACTICE. `range` bounds the grid data
// to the rows a caller actually inspects -- reading a whole prospect sheet to check one header row
// would grow with the census -- and `fields` is a field mask restricting the response to the
// branches read here. Sheets returns grid data only when the mask selects it, so the mask is what
// makes include_grid_data meaningful rather than a second switch that can disagree with it.
//
// ONE RANGE, NOT A LIST, AND THAT IS A TRANSPORT LIMIT STATED RATHER THAN PAPERED OVER. Upstream
// accepts `ranges` repeated, and the obvious modelling is List<String>. This transport cannot
// send a repeated query parameter: the interpreter renders a query value with Display, and a list
// renders as "[A1:Q1]", so a List input would have sent one bracketed literal that Sheets would
// read as a malformed range. A caller needing several ranges needs repeated-parameter support in
// the transport first, which is the trigger for widening this back.
//
// GetSpreadsheetMetadata CARRIES NO RANGE, AND THAT IS THE WHOLE REASON IT IS A SECOND OPERATION
// BESIDE GetSpreadsheet RATHER THAN A DIFFERENT ARGUMENT TO IT. `ranges` cannot be omitted by
// passing an empty string -- Sheets answers 400 "Unable to parse range: " -- and a declared query
// parameter cannot be left out, so a caller that needs sheet METADATA rather than grid data needs
// an operation that never names a range. It also must not name one: Sheets filters
// conditionalFormats to the rules INTERSECTING the requested ranges, so any range chosen to bound
// a grid read silently hides the rules that fall outside it, which is how a readback came to be
// unable to see its own work (gunbc.recurring_failure_mode readback_scoped_to_exclude_the_effect_it_verifies).

service sheets.Spreadsheets {
  config {
    endpoint: sheets_api_base
    auth: Bearer
    auth_source: EnvVar { name: "GUNBC_REVIEW_SHEET_TOKEN" }
  }

  operation GetSpreadsheet {
    input {
      spreadsheet_id: String
      range: String
      fields: String
      include_grid_data: Bool = false
    }
    output {
      result: SpreadsheetRead
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/spreadsheets/\{spreadsheet_id\}",
      query: { ranges: range, fields: fields, includeGridData: include_grid_data }
    }
    response {
      200 => SpreadsheetRead
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      500 => SheetsError
    }
  }
  operation GetSpreadsheetMetadata {
    input {
      spreadsheet_id: String
      fields: String
    }
    output {
      result: SpreadsheetRead
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/spreadsheets/\{spreadsheet_id\}",
      query: { fields: fields }
    }
    response {
      200 => SpreadsheetRead
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      500 => SheetsError
    }
  }
  operation GetValues {
    input {
      spreadsheet_id: String
      range: String
      value_render_option: SheetsValueRenderOption
    }
    output {
      value_range: ValueRange
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/spreadsheets/\{spreadsheet_id\}/values/\{range\}",
      query: { valueRenderOption: sheets_value_render_option_wire(o: value_render_option) }
    }
    response {
      200 => ValueRange
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
    mock_response {
      200 => { value_range: hermetic_get_values_value_range, outcome: hermetic_get_values_outcome } "hermetic values.get decoded-200 shape over an empty whole tab; the title is the fixture identity, not a live tab"
    }
  }

  operation BatchUpdateValues {
    input {
      spreadsheet_id: String
      value_input_option: SheetsValueInputOption
      data: List<ValueRangeWrite>
      include_values_in_response: Bool = false
    }
    output {
      spreadsheet_id: String from "spreadsheetId"
      total_updated_cells: Int? from "totalUpdatedCells"
      outcome: RestOutcome
    }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}/values:batchUpdate",
      body: {
        valueInputOption: sheets_value_input_option_wire(o: value_input_option),
        data: data,
        includeValuesInResponse: include_values_in_response
      }
    }
    response {
      200 => BatchUpdateValuesResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }

  operation SetFrozenRows {
    input { spreadsheet_id: String, sheet_id: Int, frozen_row_count: Int }
    output { spreadsheet_id: String from "spreadsheetId", outcome: RestOutcome }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}:batchUpdate",
      body: {
        requests: [
          {
            updateSheetProperties: {
              properties: { sheetId: sheet_id, gridProperties: { frozenRowCount: frozen_row_count } },
              fields: "gridProperties.frozenRowCount"
            }
          }
        ]
      }
    }
    response {
      200 => BatchUpdateSpreadsheetResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }
  operation FormatCellRange {
    input {
      spreadsheet_id: String
      sheet_id: Int
      start_row: Int
      end_row: Int
      start_col: Int
      end_col: Int
      background: SheetsColor
      foreground: SheetsColor
      bold: Bool
    }
    output { spreadsheet_id: String from "spreadsheetId", outcome: RestOutcome }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}:batchUpdate",
      body: {
        requests: [
          {
            repeatCell: {
              range: {
                sheetId: sheet_id,
                startRowIndex: start_row,
                endRowIndex: end_row,
                startColumnIndex: start_col,
                endColumnIndex: end_col
              },
              cell: {
                userEnteredFormat: {
                  backgroundColor: background,
                  textFormat: { bold: bold, foregroundColor: foreground }
                }
              },
              fields: "userEnteredFormat(backgroundColor,textFormat)"
            }
          }
        ]
      }
    }
    response {
      200 => BatchUpdateSpreadsheetResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }
  operation AddTextColorRule {
    input {
      spreadsheet_id: String
      sheet_id: Int
      start_row: Int
      start_col: Int
      end_col: Int
      match_text: String
      foreground: SheetsColor
      rule_index: Int
    }
    output { spreadsheet_id: String from "spreadsheetId", outcome: RestOutcome }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}:batchUpdate",
      body: {
        requests: [
          {
            addConditionalFormatRule: {
              rule: {
                ranges: [
                  {
                    sheetId: sheet_id,
                    startRowIndex: start_row,
                    startColumnIndex: start_col,
                    endColumnIndex: end_col
                  }
                ],
                booleanRule: {
                  condition: { type: "TEXT_CONTAINS", values: [{ userEnteredValue: match_text }] },
                  format: { textFormat: { bold: true, foregroundColor: foreground } }
                }
              },
              index: rule_index
            }
          }
        ]
      }
    }
    response {
      200 => BatchUpdateSpreadsheetResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }
}
