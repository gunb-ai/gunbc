}

// The same credential the Drive service reads, and for the same measured reason: gunbc run passes
// arguments only as argv, and on this fleet an argv word is readable by any job payload a pull
// request can influence. One variable serves both services because it is one operator credential
// for one converge; splitting it would mean two secrets with the same blast radius and one more
// thing to rotate. The literal is repeated here because the config parse extracts a literal --
// test.claim.review_sheet_transport_pin_witness sheets_token_env_matches_the_configured_literal pins it.
data sheets_token_env: String = "GUNBC_REVIEW_SHEET_TOKEN"

data sheets_api_version: NonEmptyStr = "v4"

data sheets_api_base: NonEmptyStr = concat("https://sheets.googleapis.com/", sheets_api_version as String) as NonEmptyStr

data sheets_serviceusage_api_id: NonEmptyStr = "sheets.googleapis.com"

data sheets_spreadsheets_oauth_scope: NonEmptyStr = "https://www.googleapis.com/auth/spreadsheets"

data sheets_spreadsheets_readonly_oauth_scope: NonEmptyStr = "https://www.googleapis.com/auth/spreadsheets.readonly"

data sheets_read_requests_per_minute_per_project: UpstreamRateLimit = UpstreamRateLimit {
  upstream: "google_sheets" as NonEmptyStr,
  scope: "read_requests_per_project" as NonEmptyStr,
  requests: 300,
  period: PerMinute
}

data sheets_write_requests_per_minute_per_project: UpstreamRateLimit = UpstreamRateLimit {
  upstream: "google_sheets" as NonEmptyStr,
  scope: "write_requests_per_project" as NonEmptyStr,
  requests: 300,
  period: PerMinute
}

data sheets_requests_per_minute_per_user: UpstreamRateLimit = UpstreamRateLimit {
  upstream: "google_sheets" as NonEmptyStr,
  scope: "requests_per_user" as NonEmptyStr,
  requests: 60,
  period: PerMinute
}

data sheets_rate_limits: List<UpstreamRateLimit> = [
  sheets_read_requests_per_minute_per_project,
  sheets_write_requests_per_minute_per_project,
  sheets_requests_per_minute_per_user
]

type SheetsMajorDimension = DimensionRows | DimensionColumns

fn sheets_major_dimension_wire(d: SheetsMajorDimension) -> String {
  match d {
    DimensionRows => "ROWS"
    DimensionColumns => "COLUMNS"
  }
}

fn sheets_major_dimension_from_wire(raw: String) -> SheetsMajorDimension? {
  if raw == sheets_major_dimension_wire(d: DimensionRows) {
    Present { value: DimensionRows }
  } else {
    if raw == sheets_major_dimension_wire(d: DimensionColumns) {
      Present { value: DimensionColumns }
    } else {
      none
    }
  }
}

type SheetsValueInputOption = InputRaw | InputUserEntered

fn sheets_value_input_option_wire(o: SheetsValueInputOption) -> String {
  match o {
    InputRaw => "RAW"
    InputUserEntered => "USER_ENTERED"
  }
}

fn sheets_value_input_option_from_wire(raw: String) -> SheetsValueInputOption? {
  if raw == sheets_value_input_option_wire(o: InputRaw) {
    Present { value: InputRaw }
  } else {
    if raw == sheets_value_input_option_wire(o: InputUserEntered) {
      Present { value: InputUserEntered }
    } else {
      none
    }
  }
}

type SheetsValueRenderOption = RenderFormattedValue | RenderUnformattedValue | RenderFormula

fn sheets_value_render_option_wire(o: SheetsValueRenderOption) -> String {
  match o {
    RenderFormattedValue => "FORMATTED_VALUE"
    RenderUnformattedValue => "UNFORMATTED_VALUE"
    RenderFormula => "FORMULA"
  }
}

fn sheets_value_render_option_from_wire(raw: String) -> SheetsValueRenderOption? {
  if raw == sheets_value_render_option_wire(o: RenderFormattedValue) {
    Present { value: RenderFormattedValue }
  } else {
    if raw == sheets_value_render_option_wire(o: RenderUnformattedValue) {
      Present { value: RenderUnformattedValue }
    } else {
      if raw == sheets_value_render_option_wire(o: RenderFormula) {
        Present { value: RenderFormula }
      } else {
        none
      }
    }
  }
}

type SheetsError {
  code: Int
  message: String
  status: String
}

type ValueRange {
  range: String
  majorDimension: String?
  values: List<List<String>>?
}

data structural_coverage_gap_value_range_cell_types: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "ValueRange" },
      JsonPending { field: "values[][] number-or-bool cells" }
    ],
    trigger: "a consumer needs unformatted numeric or boolean cells rather than FORMATTED_VALUE strings"
  }
]

// Proto3 JSON omits default integers, so a zero-cell batchUpdate may omit totalUpdatedCells.
// The operation output uses the same optionality; a required Int would refuse a legal body or mint 0.
// A REQUEST VALUE RANGE IS NOT A RESPONSE VALUE RANGE, and the first live write is what proved it.
// ValueRange.values is Optional because a response may omit it -- values.get on an empty range
// returns no values field at all -- but an Optional does not serialise to a bare array: it carries
// its variant, so a request body built from ValueRange reaches Sheets as
// {"values":{"_variant":"Present","value":[[...]]}} and is refused with "Unknown name _variant".
//
// The mock corpus could not catch this. PublishedMockCase fixes the RESPONSE shape, so a witness
// over it agrees with a request encoding nobody ever sent. That is shape agreement standing in for
// execution, and the wire is where the two part company.
//
// gunbc.review_sheet_sheets value_range_from_derived_write builds the Optional form and has never
// executed -- it is the caller live_sheets_transport_frontier reserved. It needs this type before
// its first write, and that is a defect in a landed module rather than a gap in a new one.
type ValueRangeWrite {
  range: String
  majorDimension: String
  values: List<List<String>>
}

type BatchUpdateSpreadsheetResponse {
  spreadsheetId: String
}

type BatchUpdateValuesResponse {
  spreadsheetId: String
  totalUpdatedRows: Int?
  totalUpdatedColumns: Int?
  totalUpdatedCells: Int?
  totalUpdatedSheets: Int?
  responses: List<ValueRange>?
}

data sheets_batch_update_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https locator: "developers.google.com/sheets/api/reference/rest/v4/spreadsheets/batchUpdate" }
}

data sheets_cell_format_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https locator: "developers.google.com/sheets/api/reference/rest/v4/spreadsheets/cells#cellformat" }
}

data sheets_color_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https locator: "developers.google.com/sheets/api/reference/rest/v4/spreadsheets/other#Color" }
}

// A SHEETS COLOR CHANNEL IS A FLOAT IN [0,1] AND A SWATCH IS AN 8-BIT INTEGER, and this repository
// cannot currently convert between them: there is no Int-to-Float conversion in the corpus, so
// 230/255 is not expressible and the channel values reaching this API are transcribed decimals
// rather than derived ones. That is a real gap and it is named rather than hidden -- the consuming
// module carries each triple beside the gunbc.design swatch it transcribes, so a reader can check
// the arithmetic by hand, and the dissolution is an Int-to-Float conversion landing in std.
type SheetsColor {
  red: Float
  green: Float
  blue: Float
}

data spreadsheet_first_sheet_id: Int = 0

service sheets.Spreadsheets {
  config {
    endpoint: sheets_api_base
    auth: Bearer
    auth_source: EnvVar { name: "GUNBC_REVIEW_SHEET_TOKEN" }
  }

  operation GetValues {
    input {
      spreadsheet_id: String
      range: String
      value_render_option: SheetsValueRenderOption
    }
    output {
      value_range: ValueRange
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/spreadsheets/\{spreadsheet_id\}/values/\{range\}",
      query: { valueRenderOption: sheets_value_render_option_wire(o: value_render_option) }
    }
    response {
      200 => ValueRange
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }

  operation SetFrozenRows {
    input { spreadsheet_id: String, sheet_id: Int, frozen_row_count: Int }
    output { spreadsheet_id: String from "spreadsheetId", outcome: RestOutcome }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}:batchUpdate",
      body: {
        requests: [
          {
            updateSheetProperties: {
              properties: { sheetId: sheet_id, gridProperties: { frozenRowCount: frozen_row_count } },
              fields: "gridProperties.frozenRowCount"
            }
          }
        ]
      }
    }
    response {
      200 => BatchUpdateSpreadsheetResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }

  operation FormatCellRange {
    input {
      spreadsheet_id: String
      sheet_id: Int
      start_row: Int
      end_row: Int
      start_col: Int
      end_col: Int
      background: SheetsColor
      foreground: SheetsColor
      bold: Bool
    }
    output { spreadsheet_id: String from "spreadsheetId", outcome: RestOutcome }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}:batchUpdate",
      body: {
        requests: [
          {
            repeatCell: {
              range: {
                sheetId: sheet_id,
                startRowIndex: start_row,
                endRowIndex: end_row,
                startColumnIndex: start_col,
                endColumnIndex: end_col
              },
              cell: {
                userEnteredFormat: {
                  backgroundColor: background,
                  textFormat: { bold: bold, foregroundColor: foreground }
                }
              },
              fields: "userEnteredFormat(backgroundColor,textFormat)"
            }
          }
        ]
      }
    }
    response {
      200 => BatchUpdateSpreadsheetResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }

  operation AddTextColorRule {
    input {
      spreadsheet_id: String
      sheet_id: Int
      start_row: Int
      start_col: Int
      end_col: Int
      match_text: String
      foreground: SheetsColor
      rule_index: Int
    }
    output { spreadsheet_id: String from "spreadsheetId", outcome: RestOutcome }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}:batchUpdate",
      body: {
        requests: [
          {
            addConditionalFormatRule: {
              rule: {
                ranges: [
                  {
                    sheetId: sheet_id,
                    startRowIndex: start_row,
                    startColumnIndex: start_col,
                    endColumnIndex: end_col
                  }
                ],
                booleanRule: {
                  condition: { type: "TEXT_EQ", values: [{ userEnteredValue: match_text }] },
                  format: { textFormat: { bold: true, foregroundColor: foreground } }
                }
              },
              index: rule_index
            }
          }
        ]
      }
    }
    response {
      200 => BatchUpdateSpreadsheetResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }

  operation BatchUpdateValues {
    input {
      spreadsheet_id: String
      value_input_option: SheetsValueInputOption
      data: List<ValueRangeWrite>
      include_values_in_response: Bool = false
    }
    output {
      spreadsheet_id: String from "spreadsheetId"
      total_updated_cells: Int? from "totalUpdatedCells"
      outcome: RestOutcome
    }
    transport rest {
      method: POST,
      path: "/spreadsheets/\{spreadsheet_id\}/values:batchUpdate",
      body: {
        valueInputOption: sheets_value_input_option_wire(o: value_input_option),
        data: data,
        includeValuesInResponse: include_values_in_response
      }
    }
    response {
      200 => BatchUpdateValuesResponse
      400 => SheetsError
      401 => SheetsError
      403 => SheetsError
      404 => SheetsError
      429 => SheetsError
      5xx => SheetsError
    }
  }
}
