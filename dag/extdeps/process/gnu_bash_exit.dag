// GNU Bash reserves exit status 2 for misuse of shell builtins (invalid arguments, syntax errors in builtin invocation). Distinct from POSIX.1-2017 exit status semantics (0 = success; nonzero = failure; 126/127/>128 reserved).
data exit_code_misuse: Int = 2
