module extdeps.process.posix_exit


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html"
  }
}

// POSIX.1-2017 Chapter 2 (Shell Command Language) exit status: 0 = success; values 1–125 and >128 reserved for implementation-defined errors; 126 = command found but not executable; 127 = command not found.
data exit_code_success: Int = 0

data exit_code_general_error: Int = 1
