module extdeps.pdf_citation

import std.types { NonEmptyStr, String, Int, List, Bool }
import std.content_hash { Sha256Digest, Sha256DigestHex }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, RealizationDispatch }
import extdeps.uri { Uri }

data pdf_citation_vocabulary_note: String = "Typed PDF citation anchors per RFC 8118 section 3 (authority: extdeps.standards.rfc_8118). Fragment parameters are a closed coproduct sequence — never a string in Uri.locator. Content pins record verification at citation time: Verified carries a Sha256Digest minted only through the content_hash wall; Unreachable carries an explicit cause rather than silent absence."

type PdfOpenPage {
  page: Int
}

type PdfOpenNamedDest {
  name: NonEmptyStr
}

type PdfOpenStructElem {
  struct_id: NonEmptyStr
}

type PdfOpenComment {
  comment_id: NonEmptyStr
}

type PdfOpenEmbeddedFile {
  name: NonEmptyStr
}

type PdfOpenZoom {
  scale_percent: Int
  left: Int?
  top: Int?
}

type PdfOpenView {
  keyword: NonEmptyStr
  position: String
}

type PdfOpenViewRect {
  left: Int
  top: Int
  width: Int
  height: Int
}

type PdfOpenHighlight {
  left: Int
  right: Int
  top: Int
  bottom: Int
}

type PdfOpenSearch {
  words: NonEmptyStr
}

type PdfOpenFdf {
  uri: Uri
}

type PdfOpenParameter
  = OpenPage(PdfOpenPage)
  | OpenNamedDest(PdfOpenNamedDest)
  | OpenStructElem(PdfOpenStructElem)
  | OpenComment(PdfOpenComment)
  | OpenEmbeddedFile(PdfOpenEmbeddedFile)
  | OpenZoom(PdfOpenZoom)
  | OpenView(PdfOpenView)
  | OpenViewRect(PdfOpenViewRect)
  | OpenHighlight(PdfOpenHighlight)
  | OpenSearch(PdfOpenSearch)
  | OpenFdf(PdfOpenFdf)

type PdfOpenParameterSequence {
  parameters: List<PdfOpenParameter>
}

type DocumentPinUnreachableCause
  = PaywalledSource
  | FetchRefused { http_status: Int }
  | SourceUnavailable

type DocumentContentPin
  = Unpinned
  | Verified { digest: Sha256Digest }
  | Unreachable { cause: DocumentPinUnreachableCause }

type PdfCitationDetail {
  open_parameters: PdfOpenParameterSequence
  content_pin: DocumentContentPin
}

type CitedPdfDocument {
  uri: Uri
  content_pin: DocumentContentPin
}

data cited_pdf_document_model_note: String = "One upstream PDF document, one authority row: uri and content_pin live on CitedPdfDocument so every citing module imports the row instead of re-authoring the digest (§3 single authority). Open-parameter fragments stay per-citation on PdfCitationDetail."

data pdf_verified_content_pin_reverification_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "test.claim.pdf_content_pin_reverification_witness",
    decl_name: "pdf_verified_content_pin_reverification_witness_scaffold_note",
    field: WholeDeclaration,
  },
}

data pdf_verified_content_pin_reverification_dissolve_on: String = "dissolve-on: pdf_verified_content_pin_reverification — Verified DocumentContentPin rows are recorded at citation time only; no CI fetch re-hashes them today. DISSOLVES WHEN test.claim.pdf_content_pin_reverification_witness enrolls on the affected-set-falsifier cadence (gunbc.falsifier_workflow affected-set-falsifier), wet-fetches each Verified pin locator, and refuses on digest drift against the cited CitedPdfDocument row."

fn pdf_open_page(page: Int) -> PdfOpenParameter {
  OpenPage(PdfOpenPage { page: page })
}

fn pdf_citation_detail(
  open_parameters: List<PdfOpenParameter>,
  content_pin: DocumentContentPin,
) -> PdfCitationDetail {
  PdfCitationDetail {
    open_parameters: PdfOpenParameterSequence { parameters: open_parameters },
    content_pin: content_pin,
  }
}

fn document_content_pin_verified(hex: Sha256DigestHex) -> DocumentContentPin {
  Verified {
    digest: Sha256Digest { hex: hex },
  }
}

fn pdf_page_number_is_valid(page: Int) -> Bool {
  page > 0
}

fn pdf_open_parameters_include_page(
  sequence: PdfOpenParameterSequence,
  page: Int,
) -> Bool {
  any(
    sequence.parameters,
    p => match p {
      OpenPage(PdfOpenPage { page: n }) => n == page
      _ => false
    },
  )
}

fn document_content_pin_digest_eq(left: DocumentContentPin, right: DocumentContentPin) -> Bool {
  match left {
    Verified { digest: l } =>
      match right {
        Verified { digest: r } => l.hex == r.hex
        _ => false
      }
    _ => false
  }
}
