module extdeps.tcgplayer.catalog

import std.types { NonEmptyStr, Timestamp, HttpMethod, AuthScheme }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.coverage { CoverageClosureEntry, CoverageClosureFact }
import extdeps.tcgplayer.tcgplayer { production_api_base, TcgplayerErrorEnvelope }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.tcgplayer.com/reference/catalog_getproducts-1"
  }
}

type CatalogProduct {
  productId: Int
  name: String
  cleanName: String?
  imageUrl: String?
  categoryId: Int
  groupId: Int
  url: String?
  modifiedOn: Timestamp?
}

data structural_coverage_gap_catalog_product_residual: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "CatalogProduct" },
      JsonPending { field: "extendedData" },
      JsonPending { field: "skus" }
    ],
    trigger: "catalog consumer needs extended fields or inline sku rows (getExtendedFields, includeSkus)"
  }
]

type ProductSku {
  skuId: Int
  productId: Int
  languageId: Int
  printingId: Int
  conditionId: Int
}

type CategoryCondition {
  conditionId: Int
  name: String
  abbreviation: String?
  displayOrder: Int?
}

type CardCondition
  = NearMint
  | LightlyPlayed
  | ModeratelyPlayed
  | HeavilyPlayed
  | Damaged
  | Unopened

fn card_condition_display_name(c: CardCondition) -> String {
  match c {
    NearMint => "Near Mint"
    LightlyPlayed => "Lightly Played"
    ModeratelyPlayed => "Moderately Played"
    HeavilyPlayed => "Heavily Played"
    Damaged => "Damaged"
    Unopened => "Unopened"
  }
}

fn parse_card_condition(raw: String) -> CardCondition? {
  if raw == "Near Mint" { Present { value: NearMint } }
  else if raw == "Lightly Played" { Present { value: LightlyPlayed } }
  else if raw == "Moderately Played" { Present { value: ModeratelyPlayed } }
  else if raw == "Heavily Played" { Present { value: HeavilyPlayed } }
  else if raw == "Damaged" { Present { value: Damaged } }
  else if raw == "Unopened" { Present { value: Unopened } }
  else { none }
}

data condition_id_grounding_note: List<String> = [
  "resolve_condition_id reads the conditionId from the live GetCategoryConditions",
  "response (conditionIds are category-scoped upstream), matched on the name TCGplayer",
  "prints — the same string card_condition_display_name emits — so both directions share",
  "one authority; the id is never a minted per-condition constant"
]

fn resolve_condition_id(conditions: List<CategoryCondition>, condition: CardCondition) -> Int? {
  let target = card_condition_display_name(c: condition)
  let matches = conditions |> filter(c => c.name == target)
  match matches.first() {
    Present { value: cc } => Present { value: cc.conditionId }
    Absent => none
  }
}

data sku_selection_granularity_note: List<String> = [
  "a listing is a SKU (product x condition x printing x language), never a product;",
  "select_sku_for_condition is a total, fail-closed decision over the product's SKU rows",
  "— zero matches refuses (SkuUnavailable), many refuses (SkuAmbiguous), never a fabricated pick"
]

type SkuSelection
  = SkuMatched { sku_id: Int }
  | SkuUnavailable
  | SkuAmbiguous { candidate_count: Int }

fn skus_matching(
  skus: List<ProductSku>,
  condition_id: Int,
  printing_id: Int,
  language_id: Int
) -> List<ProductSku> {
  skus |> filter(s =>
    s.conditionId == condition_id
      && s.printingId == printing_id
      && s.languageId == language_id
  )
}

fn select_sku_for_condition(
  skus: List<ProductSku>,
  condition_id: Int,
  printing_id: Int,
  language_id: Int
) -> SkuSelection {
  let matches = skus_matching(
    skus: skus,
    condition_id: condition_id,
    printing_id: printing_id,
    language_id: language_id
  )
  let n = count(matches)
  if n == 0 { SkuUnavailable }
  else if n == 1 {
    match matches.first() {
      Present { value: s } => SkuMatched { sku_id: s.skuId }
      Absent => SkuUnavailable
    }
  } else {
    SkuAmbiguous { candidate_count: n }
  }
}

type CatalogProductsResponse {
  totalItems: Int?
  success: Bool
  errors: List<String>?
  results: List<CatalogProduct>?
}

type ProductSkusResponse {
  success: Bool
  errors: List<String>?
  results: List<ProductSku>?
}

type CategoryConditionsResponse {
  success: Bool
  errors: List<String>?
  results: List<CategoryCondition>?
}

service tcgplayer.Catalog {
  config {
    endpoint: production_api_base
    auth: Bearer
    auth_input: bearer_token

    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503] }
  }

  operation SearchProducts {
    input {
      bearer_token: Secret
      product_name: String
      category_id: Int
      limit: Int = 10
      offset: Int = 0
      include_skus: Bool = false
    }
    output {
      total_items: Int from "totalItems"
      first_product_id: Int from "results/0/productId"
      first_product_name: String from "results/0/name"
    }
    readonly
    transport rest {
      method: GET,
      path: "/catalog/products",
      query: { productName: product_name, categoryId: category_id, limit: limit, offset: offset, includeSkus: include_skus }
    }
    response {
      200 => CatalogProductsResponse
      401 => TcgplayerErrorEnvelope
      404 => TcgplayerErrorEnvelope
      5xx => TcgplayerErrorEnvelope
    }
  }

  operation GetProductSkus {
    input {
      bearer_token: Secret
      product_id: Int
    }
    output {
      first_sku_id: Int from "results/0/skuId"
      skus: List<ProductSku> from "results"
    }
    readonly
    transport rest {
      method: GET,
      path: "/catalog/products/\{product_id\}/skus"
    }
    response {
      200 => ProductSkusResponse
      401 => TcgplayerErrorEnvelope
      404 => TcgplayerErrorEnvelope
      5xx => TcgplayerErrorEnvelope
    }
  }

  operation GetCategoryConditions {
    input {
      bearer_token: Secret
      category_id: Int
    }
    output {
      first_condition_id: Int from "results/0/conditionId"
      conditions: List<CategoryCondition> from "results"
    }
    readonly
    transport rest {
      method: GET,
      path: "/catalog/categories/\{category_id\}/conditions"
    }
    response {
      200 => CategoryConditionsResponse
      401 => TcgplayerErrorEnvelope
      404 => TcgplayerErrorEnvelope
      5xx => TcgplayerErrorEnvelope
    }
  }
}
