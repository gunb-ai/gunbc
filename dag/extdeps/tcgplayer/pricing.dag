module extdeps.tcgplayer.pricing

import std.types { NonEmptyStr, HttpMethod, AuthScheme }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.tcgplayer.tcgplayer { production_api_base, TcgplayerErrorEnvelope }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.tcgplayer.com/reference/pricing_getproductprices-1"
  }
}

type ProductPriceRow {
  productId: Int
  lowPrice: Float?
  midPrice: Float?
  highPrice: Float?
  marketPrice: Float?
  directLowPrice: Float?
  subTypeName: String?
}

data tcgplayer_pricing_money_measure_grounding_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.tcgplayer.pricing",
    decl_name: "ProductPriceRow",
    field: WholeDeclaration
  }
}

type ProductPricesResponse {
  success: Bool
  errors: List<String>?
  results: List<ProductPriceRow>?
}

type SkuPriceRow {
  skuId: Int
  lowPrice: Float?
  lowestShipping: Float?
  lowestListingPrice: Float?
  marketPrice: Float?
  directLowPrice: Float?
}

data tcgplayer_sku_pricing_money_measure_grounding_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.tcgplayer.pricing",
    decl_name: "SkuPriceRow",
    field: WholeDeclaration
  }
}

type SkuPricesResponse {
  success: Bool
  errors: List<String>?
  results: List<SkuPriceRow>?
}

data structural_coverage_gap_pricing_operations_residual: List<String> = [
  "sku-level pricing (GET /pricing/sku/ by sku id list) is now modeled as GetSkuPrices; the",
  "remaining gap is market price by product condition id (the pricing/product-by-conditionId",
  "path), unmodeled until a consumer needs the per-condition product price without a sku id"
]

service tcgplayer.Pricing {
  config {
    endpoint: production_api_base
    auth: Bearer
    auth_input: bearer_token

    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503] }
  }

  operation GetProductPrices {
    input {
      bearer_token: Secret
      product_ids: NonEmptyStr
    }
    output {
      market_price: Float? from "results/0/marketPrice"
      sub_type_name: String? from "results/0/subTypeName"
    }
    readonly
    transport rest {
      method: GET,
      path: "/pricing/product/\{product_ids\}"
    }
    response {
      200 => ProductPricesResponse
      401 => TcgplayerErrorEnvelope
      404 => TcgplayerErrorEnvelope
      5xx => TcgplayerErrorEnvelope
    }
  }

  operation GetSkuPrices {
    input {
      bearer_token: Secret
      sku_ids: NonEmptyStr
    }
    output {
      market_price: Float? from "results/0/marketPrice"
      low_price: Float? from "results/0/lowPrice"
      sku_prices: List<SkuPriceRow> from "results"
    }
    readonly
    transport rest {
      method: GET,
      path: "/pricing/sku/\{sku_ids\}"
    }
    response {
      200 => SkuPricesResponse
      401 => TcgplayerErrorEnvelope
      404 => TcgplayerErrorEnvelope
      5xx => TcgplayerErrorEnvelope
    }
  }
}
