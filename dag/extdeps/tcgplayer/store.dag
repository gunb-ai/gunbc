module extdeps.tcgplayer.store


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.tcgplayer.com/reference/stores_updatestoreskuprice-1"
  }
}

type StoreInventoryUpdateResponse {
  success: Bool?
  errors: List<String>?
}

data structural_coverage_gap_store_operations_residual: List<String> = [
  "modeled operations cover sku price and quantity updates for an authenticated store; the",
  "upstream store resource also carries product summaries, orders, and shipping options",
  "extend on demand when a consumer needs them"
]

service tcgplayer.Store {
  config {
    endpoint: extdeps.tcgplayer.tcgplayer.production_api_base
    auth: Bearer
    auth_input: bearer_token
  }

  operation UpdateSkuPrice {
    input {
      bearer_token: Secret
      store_key: std.types.NonEmptyStr
      sku_id: Int
      price: Float
      channel_id: Int = 0
    }
    output {
      success: Bool from "success"
    }
    idempotent
    transport rest {
      method: PUT,
      path: "/stores/\{store_key\}/inventory/skus/\{sku_id\}/price",
      body: { price: price, channelId: channel_id }
    }
    response {
      200 => StoreInventoryUpdateResponse
      401 => extdeps.tcgplayer.tcgplayer.TcgplayerErrorEnvelope
      403 => extdeps.tcgplayer.tcgplayer.TcgplayerErrorEnvelope
      404 => extdeps.tcgplayer.tcgplayer.TcgplayerErrorEnvelope
      5xx => extdeps.tcgplayer.tcgplayer.TcgplayerErrorEnvelope
    }
  }

  operation IncrementSkuQuantity {
    input {
      bearer_token: Secret
      store_key: std.types.NonEmptyStr
      sku_id: Int
      quantity: Int
      channel_id: Int = 0
    }
    output {
      success: Bool from "success"
    }
    transport rest {
      method: POST,
      path: "/stores/\{store_key\}/inventory/skus/\{sku_id\}/quantity",
      body: { quantity: quantity, channelId: channel_id }
    }
    response {
      200 => StoreInventoryUpdateResponse
      401 => extdeps.tcgplayer.tcgplayer.TcgplayerErrorEnvelope
      403 => extdeps.tcgplayer.tcgplayer.TcgplayerErrorEnvelope
      404 => extdeps.tcgplayer.tcgplayer.TcgplayerErrorEnvelope
      5xx => extdeps.tcgplayer.tcgplayer.TcgplayerErrorEnvelope
    }
  }
}

data tcgplayer_store_money_measure_grounding_disposition: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "extdeps.tcgplayer.store",
    decl_name: "UpdateSkuPrice",
    field: std.decl_ref.NamedField { field_name: "price" }
  }
}
