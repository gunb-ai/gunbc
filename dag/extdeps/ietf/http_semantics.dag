module extdeps.ietf.http_semantics

import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.types { Int, String, Bool, HttpStatus }
import std.nat { Nat, nat_range_inclusive }
import std.measure { Second, second, second_count }
import std.checked_arithmetic { checked_int_to_nat }

// RFC 9110 (HTTP Semantics, June 2022; obsoletes RFC 7231) section 9 METHODS, plus PATCH from
// RFC 5789 -- the one home of the request-method set. It was declared twice before this module: std.types HttpMethod with
// seven arms and v2.std.network HttpMethod with nine. Neither was the upstream: the method set is
// an IETF fact, so it lives beside the other extdeps.ietf modules and both std declarations are
// gone rather than one re-exporting the other (DESIGN section 3, external upstream decomposition).
// The seven-arm copy was not a narrower concept but an incomplete transcription: CONNECT (9.3.6)
// and TRACE (9.3.8) are registered methods, and a consumer that could not name them had no way to
// refuse them by name.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc9110#section-9"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ietf.http_semantics",
      decl_name: "HttpMethod",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.ietf.http_semantics.extdeps_external_authority_anchor,
  further_citations: [rfc5789_patch_authority, rfc9110_status_codes_authority, rfc9110_retry_after_authority]
}

// PATCH is not an RFC 9110 method: it is defined by RFC 5789, which is why it is cited separately.
data rfc5789_patch_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc5789"
  }
}

// The eight RFC 9110 section 9.3 method definitions in the RFC's order, then RFC 5789 PATCH. The
// IANA HTTP Method Registry also lists WebDAV and other extension methods; they are not modeled
// here, and a consumer reading a wire label outside this set refuses it by name
// (extdeps.http.server parse_http_method_label UnknownMethod).
type HttpMethod
  = GET
  | HEAD
  | POST
  | PUT
  | DELETE
  | CONNECT
  | OPTIONS
  | TRACE
  | PATCH

// RFC 9110 section 15 STATUS CODE CLASSES: "The first digit of the status code defines the class of
// response." Five classes, in the RFC's order. A status code itself is std.types HttpStatus (the
// 100-599 range); this is the class a code falls in, which is what a service declaration's `5xx`
// response arm names (XL-2 PR3a, extdeps.transports.rest RestResponseStatus). It is the IETF fact,
// so it lives beside HttpMethod rather than in the transport that first reads it.
data rfc9110_status_codes_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc9110#section-15"
  }
}

type HttpStatusClass
  = Informational
  | Successful
  | Redirection
  | ClientError
  | ServerError

// The class's leading digit, the spelling `1xx`..`5xx` names (RFC 9110 section 15).
fn http_status_class_digit(class: HttpStatusClass) -> Int {
  match class {
    Informational => 1
    Successful => 2
    Redirection => 3
    ClientError => 4
    ServerError => 5
  }
}

fn http_status_class_of(status: HttpStatus) -> HttpStatusClass {
  if status < 200 {
    Informational
  } else if status < 300 {
    Successful
  } else if status < 400 {
    Redirection
  } else if status < 500 {
    ClientError
  } else {
    ServerError
  }
}

// RFC 9110 section 10.2.3 Retry-After: delay-seconds is 1*DIGIT, or an HTTP-date. A value that is
// not all ASCII digits is carried as text and never interpreted as a duration (the date form's
// grammar is not decoded here). The integer parser accepts a leading sign, so the lexical shape is
// checked first.
data rfc9110_retry_after_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.rfc-editor.org/rfc/rfc9110#section-10.2.3",
  }
}

type HttpRetryAfter
  = RetryAfterSeconds { seconds: Second }
  | RetryAfterUnparsed { text: String }
  | RetryAfterAbsent
  | RetryAfterUnread { cause: String }

fn http_is_ascii_digits(text: String) -> Bool {
  length(text) > 0 && length(fold(nat_range_inclusive(lo: 0, hi: 9), init: text, f: (acc, i) => replace(acc, to_string(i), ""))) == 0
}

fn http_retry_after_from_text(text: String) -> HttpRetryAfter {
  if !http_is_ascii_digits(text: text) {
    RetryAfterUnparsed { text: text }
  } else {
    match parse_int(s: text) {
      Absent => RetryAfterUnparsed { text: text }
      Present { value: n } =>
        match checked_int_to_nat(n: n) {
          Absent => RetryAfterUnparsed { text: text }
          Present { value: sec } => RetryAfterSeconds { seconds: second(count: sec) }
        }
    }
  }
}

fn http_retry_after_wire(r: HttpRetryAfter) -> String {
  match r {
    RetryAfterSeconds { seconds: n } => join(["Retry-After ", to_string(second_count(s: n)), " s"], "")
    RetryAfterUnparsed { text: t } => join(["Retry-After '", t, "' (not delta-seconds; not interpreted)"], "")
    RetryAfterAbsent => "no Retry-After"
    RetryAfterUnread { cause: c } => join(["Retry-After unknown: the response headers could not be read (", c, ")"], "")
  }
}

