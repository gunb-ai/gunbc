module extdeps.memory.samsung

import std.measure { ByteSize, byte_size, bit_width, Celsius, CelsiusDelta }
import extdeps.memory.types { DramModuleCatalogRow, DimmBuffering, dram_generation_ddr4, DualDiePackage, ThreeDimensionalStacked }
import extdeps.vendor.samsung { samsung }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.cited_field { RowField, FromCitedFigure, NeedsReading }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/DDR4_SDRAM"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.memory.samsung",
      decl_name: "m386a4g40dm0_cpb_catalog",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data stick_capacity_bytes_32g: ByteSize = byte_size(34359738368)

// PROVENANCE, SPLIT BY WHAT ACTUALLY SUPPORTS EACH FACT, because the module scope binds its
// citation to this exact declaration and a generic DDR4 reference cannot carry a vendor SKU.
// No first-party Samsung document for this part was reachable: it is an EOL SKU, and the
// per-part paths under semiconductor.samsung.com now serve a generic DDR overview rather than
// a datasheet (checked 2026-08-12). So the exact figures below are LABEL facts supplied with
// the operator's procurement brief — 32GB, DDR4-2133, LRDIMM, 4Rx4 — and not a reading of a
// vendor datasheet. The module anchor cites DDR4 only. Load reduction is NOT cited here: it is
// grounded where DimmBuffering is declared, in extdeps.memory.types, which is the single place
// the Registered-memory citation belongs and the reason the duplicate anchor once carried in
// this module was deleted. A generic source can honestly support what DDR4 and load reduction
// MEAN; neither source says anything about this part.
// Dissolve-on: a Samsung product-selection guide or module datasheet carrying this part row,
// at which point these become cited facts and the label stops being the authority.
//
// WHAT THE MODEL ADDS IS A CHECK, NOT A RESTATEMENT. capacity, chip_width and rank_count are
// independent label facts, and dram_module_required_die_density divides them back out to a
// 4 Gbit die — which is the density the module is independently described as carrying. Three
// label numbers that could each have been mistyped agree on a fourth that was not authored
// here, so the row is corroborated rather than merely transcribed.
//
// ONE PRECISION, since the derived count reads as a package count and is not one: at x4 with
// ECC the module carries 18 dies per rank and 72 across four ranks, which this part reaches
// as 36 dual-die packages. dram_chips_per_rank counts DIES, the unit that determines density.
//
// die_stacking IS DualDiePackage FOR THE REASON THE SENTENCE ABOVE ALREADY GAVE (2026-09-12).
// Until DramDieStacking had a multi-load-stack arm this row was written MonolithicDie, which
// contradicted its own provenance: 72 dies on 36 packages is a dual-die package per site, the
// JEDEC "multi load stack" class, and not a monolithic device. The value has the same label
// standing as every other field of this row -- it is derived from the stated die and package
// counts, not read from a Samsung datasheet -- and it dissolves with the rest of the row when
// a Samsung document carrying this part lands. No consumer folds this row's stacking today;
// the correction is so the first one that does is not handed a class the part does not belong to.
data m386a4g40dm0_cpb_catalog: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "M386A4G40DM0-CPB",
  manufacturer: samsung,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_capacity_bytes_32g,
  data_rate_mts: 2133,
  ecc: true,
  buffering: LoadReduced,
  die_stacking: DualDiePackage,
  chip_width: bit_width(4),

  rank_count: 4,
}

data stick_capacity_bytes_64g: ByteSize = byte_size(68719476736)

// PROVENANCE, AND IT IS THE SAME STANDING AS THE ROW ABOVE RATHER THAN A STRONGER ONE.
// No first-party Samsung datasheet for M393A8G40D40-CRB0Q was reachable (checked 2026-08-22):
// the per-part paths under semiconductor.samsung.com serve a generic DDR overview, as they do
// for the EOL SKU above. What IS reachable is the Cisco OEM offering that resells this module
// (extdeps.memory.cisco_ucs), whose published description carries capacity, data rate, module
// type, rank organization, chip width and voltage. Those third-party distributor listings agree
// with each other and with the operator's physical label; none of them is Samsung.
//
// So this row's figures are the OEM description plus the label, NOT a manufacturer datasheet
// reading, and the module anchor cites DDR4 only. Dissolve-on: a Samsung product-selection guide
// or module datasheet carrying this part, at which point these become cited facts.
//
// THE ORGANIZATION AXES ARE THE POINT OF THIS ROW AND THEY DISAGREE WITH ONE OBSERVATION.
// Cisco describes the offering as OCTAL RANK, x4, 3DS/TSV. The BMCs on srv3 and srv4 report
// RankCount=2 for the installed modules. These are NOT competing answers to one field: a 3DS
// module presents stacked dies behind one package load, and a management controller reporting
// what the memory subsystem enumerates is a per-host observation, not a property of the part.
// rank_count here carries the module's LOGICAL rank organization, which is what both consumers
// of this field need -- see the field's own note in extdeps.memory.types. The Redfish figure
// lives with the host observation that produced it and is not authored back into this row.
//
// COROLLARY THE REALIZABILITY CHECK CANNOT CATCH, stated so nobody reads a green as proof:
// dram_module_required_die_density passes at BOTH 8 (4 Gbit/die) and 2 (16 Gbit/die, exactly
// the DDR4 monolithic ceiling), so a wrong rank_count here lands silently. The value is settled
// by the OEM description, not by the wall.
data m393a8g40d40_crb0q_catalog: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "M393A8G40D40-CRB0Q",
  manufacturer: samsung,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_capacity_bytes_64g,
  data_rate_mts: 2133,
  ecc: true,
  buffering: Registered,
  die_stacking: ThreeDimensionalStacked,
  chip_width: bit_width(4),

  rank_count: 8,
}

// A second Samsung DDR4 RDIMM SKU, installed on srv14/butch (measured 2026-11-10). This row's
// capacity, generation, data rate, ECC, buffering and rank come from a HOST read of the installed
// modules -- `sudo dmidecode -t 17` on butch (sudo dmidecode 3.5, 2026-11-10): every populated
// device reads Size 64 GB, Type DDR4, Type Detail "Registered (Buffered)", Speed/Configured Memory
// Speed 2666 MT/s, Total Width 72 / Data Width 64 (=> on-die ECC), Rank 2, part "M393A8K40B22-CWD"
// (serials 40CE1048 / 40CE0C2B / 40CFFBAA / 40CE0D1F in DDR4_A1,B1,E1,F1; C1,D1,G1,H1 empty). The
// dmidecode authority is a first-party OEM description plus the SPD label a controller publishes,
// the same rung the M393A8G40D40 row sits on; the four serials read as one batch, so the module
// batch and the module are read as ONE claim (the sibling row's note explains why that is honest
// here, not an inference).
//
// chip_width and die_stacking are NOT printed by dmidecode. They are carried from the part number's
// Samsung DDR4 module naming ("...K40..." is the x4 organization; a 64 GB 2-rank RDIMM at 2666 MT/s
// of this vintage is a 2Rx4 MONOLITHIC module on 16 Gbit monolithic dies, not 3DS). With x4, 2 ranks
// and 64 GB the per-die density is 64 GiB / (16 x4 chips/rank x 2 ranks) = 16 Gbit = 2 GiB, exactly
// the DDR4 monolithic ceiling in extdeps.memory.jedec -- so dram_module_realizable passes at the
// boundary, NOT comfortably, and this is one of the silent cases the sibling row's COROLLARY warns
// about: a wrong organization can still pass. Dissolve-on: Samsung's M393A8K40B22 datasheet /
// product-selection guide, at which point chip_width/die_stacking become cited facts.
data m393a8k40b22_cwd_catalog: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "M393A8K40B22-CWD",
  manufacturer: samsung,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_capacity_bytes_64g,
  data_rate_mts: 2666,
  ecc: true,
  buffering: Registered,
  die_stacking: MonolithicDie,
  chip_width: bit_width(4),
  rank_count: 2,
}

// PART-SPECIFIC TEMPERATURE FACTS the SAMSUNG PUBLICATION states for this registered 3DS module, each
// NeedsReading: no Samsung datasheet for M393A8G40D40-CRB0Q was reachable (see above), and nothing here is
// assumed equal to the JEDEC bands in extdeps.memory.jedec (themselves uncited). These are vendor assertions
// about the SKU only. What an installed unit shows (its SPD-reported sensor, a thermocouple case-to-sensor
// sweep) is an observation of one physical module and belongs downstream as a receipt keyed to that module
// or host assembly, never in this upstream module; P5 selects the applicable source.
// Consumer: declared frontier, the P5 decision subject and its margin derivation (trigger: P5 landing).
// Consumer: P5 hard constraint (part-specific TCASE ceiling). Trigger: P5 landing.
data m393a8g40d40_crb0q_tcase_limit: RowField<Celsius> = NeedsReading {
  read_obligation: "Read Samsung's module datasheet or product-selection guide for M393A8G40D40-CRB0Q: its maximum operating TCASE and whether the extended (85-95 C, doubled refresh) range is supported."
}

// The sensor model the Samsung publication says is fitted, as a symbolic reference to an upstream sensor
// model declaration (e.g. extdeps.memory.renesas_tse2004gb2b0 tse2004gb2b0), never a part-name string.
// Consumer: P5 margin derivation (selects the sensor-model accuracy row). Trigger: P5 landing.
data m393a8g40d40_crb0q_fitted_sensor: RowField<DeclarationRef> = NeedsReading {
  read_obligation: "Read Samsung's module datasheet for the temperature-sensor/SPD-hub model it states for M393A8G40D40-CRB0Q, and reference that model's declaration."
}

// The DRAM case temperature the JEDEC bands are stated on is not the module sensor's reading, so the
// P5 margin must not treat sensor accuracy alone as the gap.
// Consumer: P5 margin derivation (case-to-sensor term). Trigger: P5 landing.
data m393a8g40d40_crb0q_case_to_sensor_offset: RowField<CelsiusDelta> = NeedsReading {
  read_obligation: "Read Samsung's module datasheet or thermal application note for the stated DRAM-case-to-on-board-sensor offset of M393A8G40D40-CRB0Q; no source is held."
}
