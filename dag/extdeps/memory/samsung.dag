data stick_capacity_bytes_32g: ByteSize = byte_size(34359738368)

// PROVENANCE, SPLIT BY WHAT ACTUALLY SUPPORTS EACH FACT, because the module scope binds its
// citation to this exact declaration and a generic DDR4 reference cannot carry a vendor SKU.
// No first-party Samsung document for this part was reachable: it is an EOL SKU, and the
// per-part paths under semiconductor.samsung.com now serve a generic DDR overview rather than
// a datasheet (checked 2026-08-12). So the exact figures below are LABEL facts supplied with
// the operator's procurement brief — 32GB, DDR4-2133, LRDIMM, 4Rx4 — and not a reading of a
// vendor datasheet. The module anchor cites DDR4 only. Load reduction is NOT cited here: it is
// grounded where DimmBuffering is declared, in extdeps.memory.types, which is the single place
// the Registered-memory citation belongs and the reason the duplicate anchor once carried in
// this module was deleted. A generic source can honestly support what DDR4 and load reduction
// MEAN; neither source says anything about this part.
// Dissolve-on: a Samsung product-selection guide or module datasheet carrying this part row,
// at which point these become cited facts and the label stops being the authority.
//
// WHAT THE MODEL ADDS IS A CHECK, NOT A RESTATEMENT. capacity, chip_width and rank_count are
// independent label facts, and dram_module_required_die_density divides them back out to a
// 4 Gbit die — which is the density the module is independently described as carrying. Three
// label numbers that could each have been mistyped agree on a fourth that was not authored
// here, so the row is corroborated rather than merely transcribed.
//
// ONE PRECISION, since the derived count reads as a package count and is not one: at x4 with
// ECC the module carries 18 dies per rank and 72 across four ranks, which this part reaches
// as 36 dual-die packages. dram_chips_per_rank counts DIES, the unit that determines density.
data m386a4g40dm0_cpb_catalog: extdeps.memory.types.DramModuleCatalogRow = extdeps.memory.types.DramModuleCatalogRow {
  part_number: "M386A4G40DM0-CPB",
  manufacturer: samsung,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_capacity_bytes_32g,
  data_rate_mts: 2133,
  ecc: true,
  buffering: LoadReduced,
  die_stacking: MonolithicDie,
  chip_width: bit_width(4),

  rank_count: 4,
}

data stick_capacity_bytes_64g: ByteSize = byte_size(68719476736)

// PROVENANCE, AND IT IS THE SAME STANDING AS THE ROW ABOVE RATHER THAN A STRONGER ONE.
// No first-party Samsung datasheet for M393A8G40D40-CRB0Q was reachable (checked 2026-08-22):
// the per-part paths under semiconductor.samsung.com serve a generic DDR overview, as they do
// for the EOL SKU above. What IS reachable is the Cisco OEM offering that resells this module
// (extdeps.memory.cisco_ucs), whose published description carries capacity, data rate, module
// type, rank organization, chip width and voltage. Those third-party distributor listings agree
// with each other and with the operator's physical label; none of them is Samsung.
//
// So this row's figures are the OEM description plus the label, NOT a manufacturer datasheet
// reading, and the module anchor cites DDR4 only. Dissolve-on: a Samsung product-selection guide
// or module datasheet carrying this part, at which point these become cited facts.
//
// THE ORGANIZATION AXES ARE THE POINT OF THIS ROW AND THEY DISAGREE WITH ONE OBSERVATION.
// Cisco describes the offering as OCTAL RANK, x4, 3DS/TSV. The BMCs on srv3 and srv4 report
// RankCount=2 for the installed modules. These are NOT competing answers to one field: a 3DS
// module presents stacked dies behind one package load, and a management controller reporting
// what the memory subsystem enumerates is a per-host observation, not a property of the part.
// rank_count here carries the module's LOGICAL rank organization, which is what both consumers
// of this field need -- see the field's own note in extdeps.memory.types. The Redfish figure
// lives with the host observation that produced it and is not authored back into this row.
//
// COROLLARY THE REALIZABILITY CHECK CANNOT CATCH, stated so nobody reads a green as proof:
// dram_module_required_die_density passes at BOTH 8 (4 Gbit/die) and 2 (16 Gbit/die, exactly
// the DDR4 monolithic ceiling), so a wrong rank_count here lands silently. The value is settled
// by the OEM description, not by the wall.
data m393a8g40d40_crb0q_catalog: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "M393A8G40D40-CRB0Q",
  manufacturer: samsung,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_capacity_bytes_64g,
  data_rate_mts: 2133,
  ecc: true,
  buffering: Registered,
  die_stacking: ThreeDimensionalStacked,
  chip_width: bit_width(4),

  rank_count: 8,
}
