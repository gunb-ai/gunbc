module extdeps.memory.types



data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Registered_memory"
  }
}

type MemoryKind = Dram | Hbm | UnifiedShared

type MemoryFacts {
  capacity: ByteSize
  memory_kind: MemoryKind
}

type SdramSignalingFamily = | DoubleDataRate

type DramGeneration {
  signaling_family: SdramSignalingFamily

  generation_number: Int
}

data dram_generation_ddr4: DramGeneration = DramGeneration {
  signaling_family: DoubleDataRate,
  generation_number: 4,
}
data dram_generation_ddr5: DramGeneration = DramGeneration {
  signaling_family: DoubleDataRate,
  generation_number: 5,
}

data dram_generation_unknown: DramGeneration = DramGeneration {
  signaling_family: DoubleDataRate,
  generation_number: 0,
}

fn dram_generation_eq(a: DramGeneration, b: DramGeneration) -> Bool {
  (a.signaling_family == b.signaling_family) && (a.generation_number == b.generation_number)
}

fn dram_generation_number(gen: DramGeneration) -> Int {
  gen.generation_number
}

fn dram_generation_signaling_family(gen: DramGeneration) -> SdramSignalingFamily {
  gen.signaling_family
}

type JedecDdrGenerationCatalogRow {
  generation: DramGeneration

  max_monolithic_die_density: ByteSize

  jedec_standard: NonEmptyStr
}

type DimmBuffering = Unbuffered | Registered | LoadReduced

type DramModuleCatalogRow {
  part_number: NonEmptyStr
  manufacturer: Vendor<Hardware>

  generation: DramGeneration

  capacity_bytes: ByteSize
  data_rate_mts: Int
  ecc: Bool

  buffering: DimmBuffering

  chip_width: BitWidth

  rank_count: Int
}

data dram_data_word_width: BitWidth = bit_width(count: 64)
data dram_ecc_word_width: BitWidth = bit_width(count: 72)

fn dram_chips_per_rank(module: DramModuleCatalogRow) -> Int {
  bit_width_count(b: dram_ecc_word_width) / bit_width_count(b: module.chip_width)
}

fn dram_data_chips_per_rank(module: DramModuleCatalogRow) -> Int {
  bit_width_count(b: dram_data_word_width) / bit_width_count(b: module.chip_width)
}

fn dram_module_required_die_density(module: DramModuleCatalogRow) -> ByteSize {
  byte_size(count: byte_size_count(b: module.capacity_bytes) / (dram_data_chips_per_rank(module: module) * module.rank_count))
}

fn dram_module_is_realizable(module: DramModuleCatalogRow, jedec: JedecDdrGenerationCatalogRow) -> Bool {
  if !dram_generation_eq(a: module.generation, b: jedec.generation) {
    false
  } else {
    byte_size_count(b: dram_module_required_die_density(module: module)) <= byte_size_count(b: jedec.max_monolithic_die_density)
  }
}

type MemoryPopulationRow {
  module: DramModuleCatalogRow
  stick_count: Int
}

type HostMemoryPopulation {
  rows: List<MemoryPopulationRow>
}
