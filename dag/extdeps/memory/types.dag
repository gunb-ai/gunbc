module extdeps.memory.types



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Registered_memory"
  }
}

type MemoryKind = Dram | Hbm | UnifiedShared

type MemoryFacts {
  capacity: std.measure.ByteSize
  memory_kind: MemoryKind
}

type SdramSignalingFamily = | DoubleDataRate

type DramGeneration {
  signaling_family: SdramSignalingFamily

  generation_number: Int
}

data dram_generation_ddr4: DramGeneration = DramGeneration {
  signaling_family: DoubleDataRate,
  generation_number: 4,
}
data dram_generation_ddr5: DramGeneration = DramGeneration {
  signaling_family: DoubleDataRate,
  generation_number: 5,
}

data dram_generation_unknown: DramGeneration = DramGeneration {
  signaling_family: DoubleDataRate,
  generation_number: 0,
}

fn dram_generation_eq(a: DramGeneration, b: DramGeneration) -> Bool {
  (a.signaling_family == b.signaling_family) && (a.generation_number == b.generation_number)
}

fn dram_generation_number(gen: DramGeneration) -> Int {
  gen.generation_number
}

fn dram_generation_signaling_family(gen: DramGeneration) -> SdramSignalingFamily {
  gen.signaling_family
}

type JedecDdrGenerationCatalogRow {
  generation: DramGeneration

  max_monolithic_die_density: std.measure.ByteSize

  jedec_standard: std.types.NonEmptyStr
}

type DimmBuffering = Unbuffered | Registered | LoadReduced

// DIE STACKING IS ORTHOGONAL TO BUFFERING, and this axis exists because a real controller
// authority stated a class the buffering axis alone cannot name. The Ampere Altra Rev A1
// datasheet Issue 1.50 admits "RDIMMs, LRDIMMs, and Stacked (3DS) RDIMMs" — three classes over
// two axes, not three points on one. A 3DS RDIMM is registered AND stacked; folding it into
// DimmBuffering as a fourth variant would make "registered, monolithic" and "registered, 3DS"
// indistinguishable in the buffering field while claiming to be a buffering fact.
//
// 3DS is through-silicon-via die stacking presenting multiple logical ranks behind one physical
// package load, which is precisely why a controller can admit it separately from ordinary
// registered modules: the electrical load and the rank arithmetic differ.
type DramDieStacking = MonolithicDie | ThreeDimensionalStacked

// The module class a controller admits, as the product of the two independent axes. Carried as a
// record rather than an enum of named combinations so that a newly admitted pairing is a value,
// never a new variant every consumer must re-match.
type DramModuleClass {
  buffering: DimmBuffering
  stacking: DramDieStacking
}

fn dram_module_class_eq(a: DramModuleClass, b: DramModuleClass) -> Bool {
  (match a.buffering {
    Unbuffered => match b.buffering { Unbuffered => true  Registered => false  LoadReduced => false }
    Registered => match b.buffering { Registered => true  Unbuffered => false  LoadReduced => false }
    LoadReduced => match b.buffering { LoadReduced => true  Unbuffered => false  Registered => false }
  })
    && (match a.stacking {
      MonolithicDie => match b.stacking { MonolithicDie => true  ThreeDimensionalStacked => false }
      ThreeDimensionalStacked => match b.stacking { ThreeDimensionalStacked => true  MonolithicDie => false }
    })
}

// WHY die_stacking IS A REQUIRED FIELD ON THE ROW AND NOT AN OPTION (2026-08-22).
// DramDieStacking already existed as an axis, declared above for the controller-admission
// question, but the catalog row could not say which value a module carried -- so a 3DS RDIMM
// and a monolithic RDIMM were indistinguishable in the only carrier a consumer reads. That is
// the fused-axis defect the DramModuleClass comment above repairs for the CONTROLLER, left
// standing in the MODULE. The two must agree or the admission check answers about a class no
// row can claim membership in.
//
// It is required rather than optional because the state it excludes is exactly the one that
// caused this: a stacked module authored by someone who did not know the axis existed, landing
// as a monolithic-looking row that the Altra admission check then grades against the wrong
// class. An Option would have made forgetting it representable and re-opened that door
// (DESIGN 5 -- prefer the shape in which the bad state cannot be written).
//
// rank_count STAYS ONE FIELD, and that is a deliberate finding rather than an omission. Both
// of its consumers are correct for a stacked part when it carries the module's LOGICAL rank
// organization: dram_module_required_die_density divides capacity by (data chips x ranks) to
// get PER-DIE density, which is the figure JEDEC's monolithic ceiling actually bounds, and
// devices_per_stick multiplies chips-per-rank by ranks to get a DIE count, which is what a
// stacked package contains. Neither wanted a package count. A management controller's own
// reported rank number is a DIFFERENT fact -- an observation of one host's slot, not a
// property of the part -- and belongs in the observing layer, never authored back here
// (DESIGN 3, external upstream decomposition).
type DramModuleCatalogRow {
  part_number: std.types.NonEmptyStr
  manufacturer: extdeps.vendor.Vendor<extdeps.hardware.Hardware>

  generation: DramGeneration

  capacity_bytes: std.measure.ByteSize
  data_rate_mts: Int
  ecc: Bool

  buffering: DimmBuffering
  die_stacking: DramDieStacking

  chip_width: std.measure.BitWidth

  rank_count: Int
}

data dram_data_word_width: std.measure.BitWidth = std.measure.bit_width(count: 64)
data dram_ecc_word_width: std.measure.BitWidth = std.measure.bit_width(count: 72)

fn dram_chips_per_rank(module: DramModuleCatalogRow) -> Int {
  std.measure.bit_width_count(b: dram_ecc_word_width) / std.measure.bit_width_count(b: module.chip_width)
}

fn dram_data_chips_per_rank(module: DramModuleCatalogRow) -> Int {
  std.measure.bit_width_count(b: dram_data_word_width) / std.measure.bit_width_count(b: module.chip_width)
}

fn dram_module_required_die_density(module: DramModuleCatalogRow) -> std.measure.ByteSize {
  byte_size(count: std.measure.byte_size_count(b: module.capacity_bytes) / (dram_data_chips_per_rank(module: module) * module.rank_count))
}

fn dram_module_is_realizable(module: DramModuleCatalogRow, jedec: JedecDdrGenerationCatalogRow) -> Bool {
  if !dram_generation_eq(a: module.generation, b: jedec.generation) {
    false
  } else {
    std.measure.byte_size_count(b: dram_module_required_die_density(module: module)) <= std.measure.byte_size_count(b: jedec.max_monolithic_die_density)
  }
}

// --- OEM RESALE IDENTITY -------------------------------------------------------------------------
//
// AN OEM OFFERING AND THE MODULE INSIDE IT ARE TWO INDEPENDENTLY GOVERNED FACTS (DESIGN 3,
// external upstream decomposition). Cisco assigns a PID and a Cisco part number, publishes its
// own specification, and controls that offering's lifecycle; Samsung manufactures a module with
// its own part number and its own organization. Flattening them into one catalog row -- an
// "OEM part_number" field, or a Cisco row duplicating the Samsung organization axes -- makes one
// authority answer for the other, and the duplicate drifts the moment either side revises.
//
// So the offering REFERENCES the module rather than restating it. Adding a second OEM that
// resells the same Samsung part is then a new offering row and no edit at all to the module.
type OemModuleOffering {
  oem: extdeps.vendor.Vendor<extdeps.hardware.Hardware>
  oem_product_id: std.types.NonEmptyStr
  oem_part_number: std.types.NonEmptyStr
  underlying_module: DramModuleCatalogRow
  link_evidence: OemModuleLinkEvidence
}

// HOW WE KNOW THE OFFERING CONTAINS THAT MODULE, and the arms are not interchangeable.
// A supplier document is an upstream claim we can cite and re-read. A physical label read off
// the part in hand is an OBSERVATION this repository produced -- a receipt in the observing
// layer, admissible and often the only thing available for an EOL SKU, but never citable as
// though the OEM had documented it. Recording which one we have is the difference between a
// grounded row and one that merely looks grounded (DESIGN 4b, rung honesty).
type OemModuleLinkEvidence
  = OemLinkDocumentedBySupplier { citation: extdeps.external_authority.ExternalAuthority }
  | OemLinkPhysicalLabelObserved { label_text: std.types.NonEmptyStr, observer: std.types.NonEmptyStr }

type MemoryPopulationRow {
  module: DramModuleCatalogRow
  stick_count: Int
}

type HostMemoryPopulation {
  rows: List<MemoryPopulationRow>
}
