data mta36ads2g72pz_2g1a1_primary_package: SPD4_PRIMARY_SDRAM_PACKAGE_TYPE_STRUCT = SPD4_PRIMARY_SDRAM_PACKAGE_TYPE_STRUCT { Data: 145 }
