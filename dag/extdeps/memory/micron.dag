// THE ANCHOR IS MICRON'S OWN PART CATALOG, NOT AN ENCYCLOPAEDIA. micron.com serves one
// catalogue record per Micron part number from its product database ("data-source":
// "DATABASE" in the record itself), and that record carries the module's full JEDEC DDR4 SPD
// image plus a details table (density, industry speed, CAS latency, component configuration,
// die count, package, status). The page renders client-side; the record it renders is the
// same origin's _jcr_content.products.json/getproductinfo/-/-/-/en_US/-/<part> resource under
// the part-detail path, fetched 2026-09-12 with HTTP 200 and no credentials. An SPD image
// published by the manufacturer is the manufacturer's statement of the module's organization
// at byte grain, which is stronger evidence than a marketing table and is what every row in
// this module is read from.
data micron_part_catalog_mta36ads2g72pz_2g1a1: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.micron.com/products/obsolete/obsolete-vlp-rdimm/part-catalog/part-detail/mta36ads2g72pz-2g1a1"
  }
}

data micron_part_catalog_mta36asf2g72pz_2g1a2: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.micron.com/products/obsolete/obsolete-rdimm/part-catalog/part-detail/mta36asf2g72pz-2g1a2"
  }
}

// Micron "DDR4 Module Part Numbering System", Rev. 05-Dec-2018, © 2016 Micron Technology,
// Inc., the sheet Micron publishes at micron.com/numbering. Micron's asset host answered
// "Request Rejected" to this session (2026-09-12), so the locator is a distributor-hosted copy
// of Micron's PDF, sha256 7d52c2ad719c2aec1ff3298a0c785e82395e503810a07dcf2591abae2da5c6a2;
// re-cite the Micron locator when it is reachable. It is the authority for what the letters
// of a Micron module part number DENOTE, which no catalogue record states.
data micron_ddr4_module_part_numbering_rev_2018_12_05: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "siewert-kau.info/micron/wp-content/uploads/2020/05/Nomenklatur_Micron.pdf"
  }
}

// Micron "288-Pin DDR4 RDIMM Core Product Description", CCM005-341111752-10541,
// ddr4_rdimm_core.pdf Rev. B 12/2021. Same hosting situation as the numbering sheet: Micron's
// own copy sits behind the rejecting asset host, so this is DigiKey's copy of Micron's PDF,
// sha256 ea054b3d5774bffe78814bb670601b3fc919b59706ea84e3b1d2d2e849628abc. It is the family
// specification the per-part addendum supplements, and it carries the two facts a part record
// cannot: the module outlines (Figure 1 RDIMM 31.25 ± 0.15 mm; Figure 2 VLP RDIMM 18.75 ± 0.15
// mm, both 133.35 mm long) and the DDP-versus-3DS pin semantics quoted at DramDieStacking.
data micron_ddr4_rdimm_core_rev_b_2021_12: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "media.digikey.com/pdf/Data%20Sheets/Micron%20Technology%20Inc%20PDFs/DDR4_SDRAM_RDIMM_Core_RevB_Dec2021.pdf"
  }
}

data extdeps_external_authority_anchor: ExternalAuthority = micron_part_catalog_mta36ads2g72pz_2g1a1

