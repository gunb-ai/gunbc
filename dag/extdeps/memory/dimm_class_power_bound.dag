module extdeps.memory.dimm_class_power_bound

import std.types { Bool, List, NonEmptyStr }
import std.nat { Nat }
import std.optional { Absent, Present }
import std.measure { byte_size, byte_size_count, milliwatt }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }
import extdeps.memory.types {
  DramClassPowerBound,
  DramModuleCatalogRow,
  DramModuleClass,
  Registered,
  LoadReduced,
  MonolithicDie,
  DualDiePackage,
  ThreeDimensionalStacked,
  dram_generation_ddr4,
  dram_generation_eq,
  dram_module_class_eq,
}

// THE CONSERVATIVE DIMM POWER CLASS BOUND (host thermal plan P2, finding B). It applies whenever a
// module has no part-specific current evidence. Every row is an ENGINEERING CEILING typed as a bet:
// TranscribedUncited, naming what would ground it (the part's IDD table or a bench measurement). A
// reader who consumes a class bound as a measured figure is the defect (DESIGN 4d); the standing
// travels with the figure into product.node_power_envelope's reading.
//
// The plan's estimate is 8 to 12 W per 64 GB stick under load; the rows sit at or above the top of
// that range so a bound never undercounts heat. The extended figure is the normal figure plus the
// doubled-refresh increment for 85 to 95 C. A module whose generation, class or capacity no row
// covers has NO bound: dram_class_power_bound_for answers Absent and the consumer refuses.
data dimm_class_bound_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "per-part IDD table from the vendor module datasheet, or a bench-measured stick under load: the class ceiling is an engineering bound, not a read figure" as NonEmptyStr,
}

fn ddr4_bound(stacking_class: DramModuleClass, max_gib: Nat, normal_mw: Nat, extended_mw: Nat) -> DramClassPowerBound {
  DramClassPowerBound {
    generation: dram_generation_ddr4,
    class: stacking_class,
    max_capacity: byte_size(count: max_gib * 1073741824),
    normal_milliwatts: milliwatt(count: normal_mw),
    extended_milliwatts: milliwatt(count: extended_mw),
    standing: dimm_class_bound_standing,
  }
}

data ddr4_class_power_bounds: List<DramClassPowerBound> = [
  ddr4_bound(stacking_class: DramModuleClass { buffering: Registered, stacking: MonolithicDie }, max_gib: 16, normal_mw: 6000, extended_mw: 7000),
  ddr4_bound(stacking_class: DramModuleClass { buffering: Registered, stacking: MonolithicDie }, max_gib: 32, normal_mw: 8000, extended_mw: 9500),
  ddr4_bound(stacking_class: DramModuleClass { buffering: Registered, stacking: MonolithicDie }, max_gib: 64, normal_mw: 10000, extended_mw: 12000),
  ddr4_bound(stacking_class: DramModuleClass { buffering: LoadReduced, stacking: DualDiePackage }, max_gib: 32, normal_mw: 10000, extended_mw: 12000),
  ddr4_bound(stacking_class: DramModuleClass { buffering: LoadReduced, stacking: DualDiePackage }, max_gib: 64, normal_mw: 12000, extended_mw: 14500),
  ddr4_bound(stacking_class: DramModuleClass { buffering: Registered, stacking: ThreeDimensionalStacked }, max_gib: 64, normal_mw: 12000, extended_mw: 14500),
  ddr4_bound(stacking_class: DramModuleClass { buffering: Registered, stacking: ThreeDimensionalStacked }, max_gib: 128, normal_mw: 16000, extended_mw: 19500),
  ddr4_bound(stacking_class: DramModuleClass { buffering: LoadReduced, stacking: ThreeDimensionalStacked }, max_gib: 128, normal_mw: 18000, extended_mw: 22000),
]

fn dram_class_bound_applies(row: DramClassPowerBound, module: DramModuleCatalogRow) -> Bool {
  dram_generation_eq(a: row.generation, b: module.generation)
    && dram_module_class_eq(a: row.class, b: DramModuleClass { buffering: module.buffering, stacking: module.die_stacking })
    && byte_size_count(b: module.capacity_bytes) <= byte_size_count(b: row.max_capacity)
}

// The tightest covering row: among the rows that apply, the one no other applying row undercuts.
fn dram_class_power_bound_for(
  bounds: List<DramClassPowerBound>,
  module: DramModuleCatalogRow,
) -> DramClassPowerBound? {
  let applying = filter(bounds, r => dram_class_bound_applies(row: r, module: module))
  let tightest = filter(applying, r => !any(applying, o => byte_size_count(b: o.max_capacity) < byte_size_count(b: r.max_capacity)))
  tightest.first()
}
