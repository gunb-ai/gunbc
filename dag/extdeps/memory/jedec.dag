module extdeps.memory.jedec

import std.measure { byte_size, celsius, celsius_delta, nanosecond, Celsius, CelsiusDelta, Nanosecond }
import std.types { NonEmptyStr }
import extdeps.memory.types {
  DoubleDataRate,
  DramGeneration,
  JedecDdrGenerationCatalogRow,
  dram_generation_ddr4,
  dram_generation_ddr5,
  dram_generation_unknown,
  dram_generation_number,
  dram_generation_signaling_family,
}
import extdeps.external_authority { ExternalAuthority, CitedCelsiusFigure, CitedFigureStanding, TranscribedUncited }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/JEDEC_memory_standards"
  }
}

data ddr4_generation_catalog: JedecDdrGenerationCatalogRow = JedecDdrGenerationCatalogRow {
  generation: dram_generation_ddr4,
  max_monolithic_die_density: byte_size(count: 2147483648),
  jedec_standard: "JESD79-4",
}

data ddr5_generation_catalog: JedecDdrGenerationCatalogRow = JedecDdrGenerationCatalogRow {
  generation: dram_generation_ddr5,
  max_monolithic_die_density: byte_size(count: 8589934592),
  jedec_standard: "JESD79-5",
}

data unknown_ddr_generation_catalog: JedecDdrGenerationCatalogRow = JedecDdrGenerationCatalogRow {
  generation: dram_generation_unknown,
  max_monolithic_die_density: byte_size(count: 0),
  jedec_standard: "UNKNOWN",
}

fn jedec_ddr_generation_catalog_row(dram_gen: DramGeneration) -> JedecDdrGenerationCatalogRow {
  match dram_generation_signaling_family(dram_gen) {
    DoubleDataRate => match dram_generation_number(dram_gen) {
      4 => ddr4_generation_catalog
      5 => ddr5_generation_catalog
      _ => unknown_ddr_generation_catalog
    }
  }
}

// DDR4 OPERATING TEMPERATURE BANDS (component limits, P1 of gunbc.plans.host_thermal_operating_point).
// The bands are stated on the DRAM CASE temperature (TCASE), not on a module sensor reading: the gap
// between the two is the sensor's accuracy below plus an unmodeled case-to-sensor offset, and a consumer
// must not equate them.
//
// STANDING IS TranscribedUncited, NOT CitedToAuthority. JESD79-4 is distributed by JEDEC behind
// registration and this repository holds no copy. What WAS read (2026-11-05) is Samsung's public DDR4
// SDRAM specification, which lists a normal refresh mode for 0 C <= TCASE <= 85 C and an extended mode
// for 0 C <= TCASE <= 95 C (a vendor restatement of JEDEC, not JEDEC). The 7.8 us / 3.9 us tREFI values
// are the standard's normal and doubled refresh intervals and were NOT confirmed against a held document.
// Dissolve-on: JESD79-4 (name the revision, the operating temperature table and the refresh section)
// ingested, at which point these become CitedToAuthority.
//
// Consumers: none executing in this change. Declared frontier consumed by the P5 decision subject (the
// 85 C hard constraint, section 7) and the B5 guard (the 95 C emergency floor) of
// gunbc.plans.host_thermal_operating_point; the trigger is P5 landing.
fn ddr4_band_standing(what: NonEmptyStr) -> CitedFigureStanding {
  TranscribedUncited { read_obligation: join(["Read JEDEC JESD79-4 (name the revision and the table) for ", what as String, ". Corroborated, not cited, by Samsung's public DDR4 SDRAM specification (normal mode 0-85 C TCASE, extended mode 0-95 C TCASE); the standard is registration-gated and this repository holds no copy."], "") }
}

type Ddr4RefreshBand {
  upper_tcase: CitedCelsiusFigure
  refresh_interval: Nanosecond
}

data ddr4_normal_refresh_band: Ddr4RefreshBand = Ddr4RefreshBand {
  upper_tcase: CitedCelsiusFigure { value: celsius(85), standing: ddr4_band_standing(what: "the top of the normal operating TCASE band and its tREFI of 7.8 us") },
  refresh_interval: nanosecond(7800),
}

// Above the normal band and up to 95 C the part must refresh twice as often. Above this band the part is
// out of specification: there is no band, so no row, and a consumer that needs the edge reads upper_tcase.
data ddr4_extended_refresh_band: Ddr4RefreshBand = Ddr4RefreshBand {
  upper_tcase: CitedCelsiusFigure { value: celsius(95), standing: ddr4_band_standing(what: "the top of the extended operating TCASE band and its doubled refresh (tREFI 3.9 us)") },
  refresh_interval: nanosecond(3900),
}

// DIMM ON-BOARD TEMPERATURE SENSOR ACCURACY, the margin the plan's "85 C less the P1 margin" acceptance
// derives from. The figure is the JEDEC TSE2004av class's: a Renesas TSE2004GB2B0 datasheet (a part
// compliant to the JEDEC TSE2004av device specification) read 2026-11-05 lists typical +-0.5 C and maximum
// +-1.0 C over the 75-95 C active range, +-2.0 C maximum over 40-125 C, +-3.0 C maximum over -40-125 C.
// THAT IS A FACT ABOUT THAT PART, NOT ABOUT THE SAMSUNG MODULE: which sensor part sits on
// M393A8G40D40-CRB0Q is unread, so the standing is TranscribedUncited and the obligation names it.
// Consumer: declared frontier, the P5 margin derivation (trigger: P5 landing).
type DimmSensorAccuracy {
  max_error: CelsiusDelta
  range_low: Celsius
  range_high: Celsius
  standing: CitedFigureStanding
}

data tse2004av_class_active_range_accuracy: DimmSensorAccuracy = DimmSensorAccuracy {
  max_error: celsius_delta(1),
  range_low: celsius(75),
  range_high: celsius(95),
  standing: TranscribedUncited { read_obligation: "Read the SPD-hub or TSE2004av temperature-sensor datasheet of the sensor part actually fitted to the DIMM (identify it from the module's SPD, JEDEC 21-C) for its accuracy over 75-95 C. The +-1.0 C maximum was read from the Renesas TSE2004GB2B0 datasheet (renesas.com/en/document/dst/tse2004gb2b0-datasheet), a TSE2004av-compliant part that is not shown to be the fitted one." },
}
