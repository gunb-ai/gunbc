module extdeps.memory.te_ddr4_dimm_socket

import std.types { String, NonEmptyStr }
import std.nat { Nat }
import std.measure { Micrometer, micrometer }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.vendor.tyco_electronics { tyco_electronics }
import extdeps.land_pattern.types {
  BoardAttachmentStyle,
  MountingPatternStanding,
  ThroughHoleSolderTail,
  VendorPatternNotEstablished,
}

// Application Specification 114-115012 Rev A, "DDR4 DIMM Socket Solder Tail", dated Nov 24 2016,
// read 2026-08-14. It covers the 288-position solder-tail DDR4 DIMM socket and names 2308107 as
// the representative base product part number for that product line.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.te.com/commerce/DocumentDelivery/DDEController?Action=showdoc&DocId=Specification+Or+Standard%7F114-115012%7FA%7Fpdf%7FEnglish%7FENG_SS_114-115012_A.pdf%7F2308107-5"
  }
}

data te_ddr4_dimm_socket_note: String = "THE PART IS SELECTED AND ITS BOARD PATTERN IS NOT ESTABLISHED, AND THOSE ARE TWO FACTS. The specification states what this row carries — 288 positions, 0.80 mm contact spacing, solder tail through plated holes, FR-4 or G-10 board material — and it also carries the pc board layout as Figure 3, whose dimension callouts are drawn rather than typed and were not readable by the route available here. So the socket is a real, cited, selected part whose hole pattern remains outstanding, and the standing below says exactly that instead of letting a selected part imply an established pattern. THE BASE PART NUMBER IS NOT AN ORDERABLE PART NUMBER, and the document says so: 2308107 identifies the product line so that inquiries reach the right service network, and the orderable variants differ in tail length for different board thicknesses, which the customer drawing carries. Recording it as an ordering part number would have been a more confident-looking row that was false. THE SPECIFICATION ALSO YIELDS TO THE CUSTOMER DRAWING by its own terms where the two conflict, so a later reader who obtains that drawing is reading a higher authority for this part, not a second opinion."

type DimmSocketCatalogRow {
  base_part_number: NonEmptyStr
  vendor: Vendor<Hardware>
  position_count: Nat
  contact_pitch: Micrometer
  attachment: BoardAttachmentStyle
  board_pattern: MountingPatternStanding
}

data ddr4_dimm_socket_solder_tail_288: DimmSocketCatalogRow = DimmSocketCatalogRow {
  base_part_number: "2308107",
  vendor: tyco_electronics,
  position_count: 288,
  contact_pitch: micrometer(count: 800),
  attachment: ThroughHoleSolderTail,
  board_pattern: VendorPatternNotEstablished {
    what_is_missing: "the plated-hole pattern of application specification 114-115012 Figure 3; its layout dimensions and tolerances are drawn callouts that were not readable from the document, and the specification defers to the per-part customer drawing where the two conflict",
  },
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.memory.te_ddr4_dimm_socket",
      decl_name: "ddr4_dimm_socket_solder_tail_288",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
