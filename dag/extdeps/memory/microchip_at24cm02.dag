data at24cm02_note: String = "THE FETCH SUCCEEDED AND THE READ DID NOT, WHICH ARE DIFFERENT FAILURES. This document is served at the recorded locator - it is not gated, not missing and not refused - but its text could not be extracted here, and no PDF rasteriser is installed to read it as an image. That is a property of this session's toolchain rather than of the document, and it has now been observed across EVERY Microchip datasheet attempted, so it is a vendor-wide extraction failure rather than three unlucky documents. It matters for planning: Microchip DOES publish recommended land patterns beside its package outlines, so this row is expected to complete in full once anyone can read the file, unlike the connector rows whose layouts are drawn callouts even when the text extracts. Ampere's Mt. Jade reference names this part for the Altra SCP firmware EEPROM, which is what selects it; nothing about its capacity, interface or package is recorded here because none of it was read."

data at24cm02: CatalogPartIdentity = CatalogPartIdentity {
  ordering_part_number: "AT24CM02",
  vendor: microchip_technology,
  board_pattern: VendorPatternNotEstablished {
    what_is_missing: "the 8-lead SOIC package outline and the recommended land pattern from the Packaging Information section of datasheet DS20006197; the document is served but its text is not extractable by any route available to this session, and no PDF rasteriser is installed to read it as an image",
  },
}

