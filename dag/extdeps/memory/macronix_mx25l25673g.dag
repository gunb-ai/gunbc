  vendor: macronix,
  board_pattern: extdeps.land_pattern.types.MountingPatternObligation {
    what_is_missing: "the package outline and recommended land pattern that the MX25L25673G datasheet publishes for the ordering variant's package, none of which is transcribed here",
  },
}

