module extdeps.ssh.password_session

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { Bool, Int, NonEmptyStr, Secret, String }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "man7.org/linux/man-pages/man1/ssh.1.html",
  },
}

data sshpass_password_fd_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "sourceforge.net/projects/sshpass/",
  },
}

data password_ssh_transport_security_note: String = "PasswordSsh.ExecScript feeds the password to sshpass through inherited file descriptor 0 (-d 0), never argv or the remote script. The non-secret script is the single SSH remote-command argv member; OpenSSH transmits that command to the remote login shell without requiring a utility such as base64 on the constrained BMC image. StrictHostKeyChecking=no plus UserKnownHostsFile=/dev/null is the fleet's declared interim LAN BMC posture, shared with extdeps.exec.command; it dissolves when BMC host keys are pinned in fleet intent. Password auth itself dissolves to a provisioned automation key or controller-native OAuth transport."

type PasswordSshExecResult {
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
}

service ssh.PasswordSsh {
  operation ExecScript {
    input {
      host: NonEmptyStr
      username: NonEmptyStr
      password: Secret
      script: String
    }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "sshpass",
        "-d",
        "0",
        "ssh",
        "-T",
        "-o",
        "PreferredAuthentications=password,keyboard-interactive",
        "-o",
        "PubkeyAuthentication=no",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "LogLevel=ERROR",
        "-o",
        "ConnectTimeout=10",
        "{username}@{host}",
        "{script}",
      ]
      stdin: password
    }
    exit {
      0 => Unit
      nonzero => String "password SSH remote script failed"
    }
  }
}

fn password_ssh_exec_script(
  host: NonEmptyStr,
  username: NonEmptyStr,
  password: Secret,
  script: String,
) -> PasswordSshExecResult {
  let result = ssh.PasswordSsh.ExecScript(
    host: host,
    username: username,
    password: password,
    script: script,
  )
  PasswordSshExecResult {
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}
