module extdeps.ssh.password_session

import extdeps.external_authority { ExternalAuthority }
import extdeps.exec.command { ArgvCommand, shell_command_render }
import extdeps.uri { Uri, Https }
import std.types { Bool, Int, List, NonEmptyStr, Secret, String }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "man7.org/linux/man-pages/man1/ssh.1.html",
  },
}

data sshpass_password_fd_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "sourceforge.net/projects/sshpass/",
  },
}

data password_ssh_transport_security_note: String = "PasswordSsh.ExecRenderedArgv and PasswordSsh.CopyFile feed the password to sshpass through inherited file descriptor 0 (-d 0), never argv, environment, remote command text, or transferred content. OpenSSH does not preserve trailing local argv as remote argv: it joins them into one command interpreted by the remote login shell. password_ssh_exec_argv therefore accepts typed ArgvCommand data and serializes it exactly once with extdeps.exec.command.shell_command_render before the transport boundary. Every word is single-quoted and embedded apostrophes are closed, escaped, and reopened. CopyFile carries local and remote paths as distinct transport arguments. StrictHostKeyChecking=no plus UserKnownHostsFile=/dev/null is the fleet's declared interim LAN BMC posture; it dissolves when BMC host keys are pinned in fleet intent. Password auth itself dissolves to a provisioned automation key or controller-native OAuth transport."

type PasswordSshExecResult {
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
}

type PasswordSshSession {
  host: NonEmptyStr
  username: NonEmptyStr
  password: Secret
}

fn password_ssh_render_remote_argv(argv: List<String>) -> String {
  shell_command_render(command: ArgvCommand { argv: argv })
}

service ssh.PasswordSsh {
  operation ExecRenderedArgv {
    input {
      host: NonEmptyStr
      username: NonEmptyStr
      password: Secret
      remote_command: NonEmptyStr
    }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "sshpass",
        "-d",
        "0",
        "ssh",
        "-T",
        "-o",
        "PreferredAuthentications=password,keyboard-interactive",
        "-o",
        "PubkeyAuthentication=no",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "LogLevel=ERROR",
        "-o",
        "ConnectTimeout=10",
        "{username}@{host}",
        "--",
        "{remote_command}",
      ]
      stdin: password
    }
    exit {
      0 => Unit
      nonzero => String "password SSH rendered remote argv exec failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock-password-ssh-argv", stderr: "" } "hermetic password SSH rendered argv"
    }
  }

  operation CopyFile {
    input {
      host: NonEmptyStr
      username: NonEmptyStr
      password: Secret
      source_path: NonEmptyStr
      destination_path: NonEmptyStr
    }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "sshpass",
        "-d",
        "0",
        "scp",
        "-q",
        "-o",
        "PreferredAuthentications=password,keyboard-interactive",
        "-o",
        "PubkeyAuthentication=no",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "LogLevel=ERROR",
        "-o",
        "ConnectTimeout=10",
        "{source_path}",
        "{username}@{host}:{destination_path}",
      ]
      stdin: password
    }
    exit {
      0 => Unit
      nonzero => String "password SCP file transfer failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "", stderr: "" } "hermetic password SCP copy"
    }
  }
}

fn password_ssh_exec_argv(
  host: NonEmptyStr,
  username: NonEmptyStr,
  password: Secret,
  argv: List<String>,
) -> PasswordSshExecResult {
  let remote_command = password_ssh_render_remote_argv(argv: argv)
  if remote_command == "" {
    PasswordSshExecResult {
      exit_code: 2,
      success: false,
      stdout: "",
      stderr: "password SSH refuses an empty remote argv",
    }
  } else {
    let result = ssh.PasswordSsh.ExecRenderedArgv(
      host: host,
      username: username,
      password: password,
      remote_command: remote_command as NonEmptyStr,
    )
    PasswordSshExecResult {
      exit_code: result.exit_code,
      success: result.success,
      stdout: result.stdout,
      stderr: result.stderr,
    }
  }
}

fn password_ssh_copy_file(
  host: NonEmptyStr,
  username: NonEmptyStr,
  password: Secret,
  source_path: NonEmptyStr,
  destination_path: NonEmptyStr,
) -> PasswordSshExecResult {
  let result = ssh.PasswordSsh.CopyFile(
    host: host,
    username: username,
    password: password,
    source_path: source_path,
    destination_path: destination_path,
  )
  PasswordSshExecResult {
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}

fn password_ssh_session_exec_argv(
  session: PasswordSshSession,
  argv: List<String>,
) -> PasswordSshExecResult {
  password_ssh_exec_argv(
    host: session.host,
    username: session.username,
    password: session.password,
    argv: argv,
  )
}

fn password_ssh_session_copy_file(
  session: PasswordSshSession,
  source_path: NonEmptyStr,
  destination_path: NonEmptyStr,
) -> PasswordSshExecResult {
  password_ssh_copy_file(
    host: session.host,
    username: session.username,
    password: session.password,
    source_path: source_path,
    destination_path: destination_path,
  )
}
