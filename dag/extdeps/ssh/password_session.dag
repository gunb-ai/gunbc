module extdeps.ssh.password_session

import extdeps.external_authority { ExternalAuthority }
import extdeps.exec.command { sshpass_authority }
import extdeps.uri { Uri, Https }
import std.types { Bool, Int, List, NonEmptyStr, Secret, String }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "man7.org/linux/man-pages/man1/ssh.1.html",
  },
}

data sshpass_password_fd_authority: ExternalAuthority = sshpass_authority

// PasswordSsh.CopyFile feeds the password to sshpass through inherited fd 0 (-d 0), never argv,
// environment, remote command text, or transferred content. Remote execution is deliberately absent
// here: each dependency owns a closed operation algebra whose transport exposes only fixed
// operation-specific argv, so callers cannot submit arbitrary argv or authored shell. CopyFile
// carries local and remote paths as distinct transport arguments and requires strict verification
// against the caller's target-specific known-hosts file. Password auth itself dissolves to a
// provisioned automation key or controller-native OAuth transport.

type PasswordSshExecResult {
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
}

type PasswordSshSession {
  host: NonEmptyStr
  username: NonEmptyStr
  password: Secret
  known_hosts_path: NonEmptyStr
}

service ssh.PasswordSsh {
  operation CopyFile {
    input {
      host: NonEmptyStr
      username: NonEmptyStr
      password: Secret
      known_hosts_path: NonEmptyStr
      source_path: NonEmptyStr
      destination_path: NonEmptyStr
    }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "sshpass",
        "-d",
        "0",
        "scp",
        "-q",
        "-o",
        "PreferredAuthentications=password,keyboard-interactive",
        "-o",
        "PubkeyAuthentication=no",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile={known_hosts_path}",
        "-o",
        "LogLevel=ERROR",
        "-o",
        "ConnectTimeout=10",
        "{source_path}",
        "{username}@{host}:{destination_path}",
      ]
      stdin: password
    }
    exit {
      0 => Unit
      nonzero => String "password SCP file transfer failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "", stderr: "" } "hermetic password SCP copy"
    }
  }
}

// sshpass -f reads the password from a file and leaves stdin untouched for the remote command;
// measured on srv1 with sshpass 1.09 on 2026-09-05: `-d 0` over-reads the pipe and the remote
// command receives nothing, `-f` passes every stdin line through. The file path is what argv
// carries; the caller owns the owner-only write and the shred around this call.
service ssh.PasswordFileSsh {
  operation ExecPortableWordsWithStdin {
    input { password_file: NonEmptyStr, client_args: List<String>, stdin_payload: String }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["sshpass", "-f", "{password_file}", "ssh", client_args]
      stdin: stdin_payload
    }
    exit {
      0 => Unit
      nonzero => String "password-file ssh portable-words exec with stdin failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock-password-file-ssh-portable-words-stdin", stderr: "" } "hermetic"
    }
  }
}

fn password_file_ssh_exec_portable_words_with_stdin(
  password_file: NonEmptyStr,
  client_args: List<String>,
  stdin_payload: String,
) -> PasswordSshExecResult {
  let result = ssh.PasswordFileSsh.ExecPortableWordsWithStdin(
    password_file: password_file,
    client_args: client_args,
    stdin_payload: stdin_payload,
  )
  PasswordSshExecResult {
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}

fn password_ssh_copy_file(
  host: NonEmptyStr,
  username: NonEmptyStr,
  password: Secret,
  known_hosts_path: NonEmptyStr,
  source_path: NonEmptyStr,
  destination_path: NonEmptyStr,
) -> PasswordSshExecResult {
  let result = ssh.PasswordSsh.CopyFile(
    host: host,
    username: username,
    password: password,
    known_hosts_path: known_hosts_path,
    source_path: source_path,
    destination_path: destination_path,
  )
  PasswordSshExecResult {
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}

fn password_ssh_session_copy_file(
  session: PasswordSshSession,
  source_path: NonEmptyStr,
  destination_path: NonEmptyStr,
) -> PasswordSshExecResult {
  password_ssh_copy_file(
    host: session.host,
    username: session.username,
    password: session.password,
    known_hosts_path: session.known_hosts_path,
    source_path: source_path,
    destination_path: destination_path,
  )
}
