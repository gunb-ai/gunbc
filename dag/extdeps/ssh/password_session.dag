module extdeps.ssh.password_session


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "man7.org/linux/man-pages/man1/ssh.1.html",
  },
}

data sshpass_password_fd_authority: extdeps.external_authority.ExternalAuthority = sshpass_authority

data password_ssh_transport_security_note: String = "PasswordSsh.CopyFile feeds the password to sshpass through inherited file descriptor 0 (-d 0), never argv, environment, remote command text, or transferred content. Remote execution is intentionally absent from this generic session module: each dependency owns a closed operation algebra whose transport exposes only fixed operation-specific argv, so callers cannot submit arbitrary argv or authored shell. CopyFile carries local and remote paths as distinct transport arguments and requires strict verification against the caller's target-specific known-hosts file. Password auth itself dissolves to a provisioned automation key or controller-native OAuth transport."

type PasswordSshExecResult {
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
}

type PasswordSshSession {
  host: std.types.NonEmptyStr
  username: std.types.NonEmptyStr
  password: Secret
  known_hosts_path: std.types.NonEmptyStr
}

service ssh.PasswordSsh {
  operation CopyFile {
    input {
      host: std.types.NonEmptyStr
      username: std.types.NonEmptyStr
      password: Secret
      known_hosts_path: std.types.NonEmptyStr
      source_path: std.types.NonEmptyStr
      destination_path: std.types.NonEmptyStr
    }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "sshpass",
        "-d",
        "0",
        "scp",
        "-q",
        "-o",
        "PreferredAuthentications=password,keyboard-interactive",
        "-o",
        "PubkeyAuthentication=no",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile={known_hosts_path}",
        "-o",
        "LogLevel=ERROR",
        "-o",
        "ConnectTimeout=10",
        "{source_path}",
        "{username}@{host}:{destination_path}",
      ]
      stdin: password
    }
    exit {
      0 => Unit
      nonzero => String "password SCP file transfer failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "", stderr: "" } "hermetic password SCP copy"
    }
  }
}

fn password_ssh_copy_file(
  host: std.types.NonEmptyStr,
  username: std.types.NonEmptyStr,
  password: Secret,
  known_hosts_path: std.types.NonEmptyStr,
  source_path: std.types.NonEmptyStr,
  destination_path: std.types.NonEmptyStr,
) -> PasswordSshExecResult {
  let result = ssh.PasswordSsh.CopyFile(
    host: host,
    username: username,
    password: password,
    known_hosts_path: known_hosts_path,
    source_path: source_path,
    destination_path: destination_path,
  )
  PasswordSshExecResult {
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}

fn password_ssh_session_copy_file(
  session: PasswordSshSession,
  source_path: std.types.NonEmptyStr,
  destination_path: std.types.NonEmptyStr,
) -> PasswordSshExecResult {
  password_ssh_copy_file(
    host: session.host,
    username: session.username,
    password: session.password,
    known_hosts_path: session.known_hosts_path,
    source_path: source_path,
    destination_path: destination_path,
  )
}
