module extdeps.ssh.session

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { Bool, FilePath, Int, List, NonEmptyStr, Unit, String }
import std.measure { Second }
import std.optional { Absent }
import std.resources { Network }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc4254"
  }
}

// This anchor moved from RFC 4253 to RFC 4254 (review 45901). What this module declares is Exec,
// ExecScript and Reachability - channel requests, which RFC 4254 (SSH Connection
// Protocol) defines. RFC 4253 is the SSH Transport Layer Protocol: key exchange, encryption, MAC.
// It underlies every SSH session but defines none of the operations here, so it was the authority
// for a layer this module does not model, and a note grounding an exec fact in it would have been
// citing the wrong document.\n\nThe sibling modules keep their own anchors and are untouched; this
// is a fidelity correction for this file's declarations, not a fleet-wide repoint.

// These operations take CLIENT_ARGS -- everything after argv[0] -- and the transport supplies the
// literal `ssh` itself. An earlier revision spliced the whole argv from the input, which the
// operation-argv executable-position wall refused, correctly: argv[0] decided by a bound input
// means a CALLER decides which program runs, and std.operation_argv states that a generic binder
// over the executable position is strictly worse than the hardcoded list it replaces. The shaper's
// own prepending of `ssh` was no defense -- the OPERATION could not know that, and a second caller
// could have passed anything. The wall found this within one CI run of the operations landing.

// ExecPortableWords is the successor to the deleted ExecArgv — the take-client_args shape (the
// `ExecPortableWords` operation below) instead of the earlier take-host+argv shape, because a
// literal in a service block cannot be called by a witness and RFC 4254 §6.5 gives the exec request
// a single string-typed command field. What holds locally is the portable-word allowlist at
// gunbc.typed_argv_exec; ExecPortableWords names exactly that.

fn shape_scp_copy_to_argv(
  host: NonEmptyStr,
  local_path: FilePath,
  remote_path: FilePath,
) -> List<String> {
  [local_path as String, join([host as String, ":", remote_path as String], "")]
}

// ssh(1) EXIT STATUS (OpenBSD 7.6): "ssh exits with the exit status of the remote command or with 255
// if an error occurred." 255 is the CLIENT's status: it does not establish that the remote command
// did not run -- a connection lost after the command started, or before its status came back, also
// ends here. A command that itself exits 255 is indistinguishable from it at this boundary.
data ssh_client_error_exit_status: Int = 255

type SshSessionExecResult {
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
  // A fleet leg that ran PAST its caller-passed total-wall deadline is a VALUE, not an error: the
  // sink sets overran=true ONLY when its own kill fired -- never inferred from the exit code, because
  // a real remote command can exit any code. The echoed deadline rides ONLY the overran case as an
  // Option (Absent otherwise) -- no 0-means-none sentinel. Non-fleet dispatches (no deadline passed)
  // and the Exec/ExecScript shapes never set these; they default false/Absent and keep today's
  // behavior. The exit code stays the child's real code, irrelevant when overran is true.
  overran: Bool = false
  wall_deadline_seconds: Optional<Second> = Absent
}

// THE MODEL VIEW OF A FLEET LEG'S SESSION EXEC.
//
// A leg either COMPLETED (a real remote exit code, with whatever stdout/stderr came back) or it
// OVERRAN the total-wall deadline its CALLER passed (the sink's kill fired), in which case the
// deadline is a VALUE it carries. The wire record `SshSessionExecResult` keeps `overran: Bool` +
// `wall_deadline_seconds: Optional<Second>` because that pair is the service JSON shape; this SUM is
// what the model consumes. It is produced at exactly ONE site (`ssh_session_exec_outcome` below),
// which REFUSES, by name, the two combinations the wire admits but the model forbids: an overrun
// with no deadline, and a completed leg carrying a deadline. After this, no consumer reads the Bool.
type SshSessionExecOutcome
  = SessionCompleted { exit_code: Int, success: Bool, stdout: String, stderr: String }
  | SessionOverran { deadline: Second }
  | SessionWireInconsistent { fault: SshSessionWireFault }

// The two illegal wire combinations, named. Each is a sink/transport bug surfaced as a typed
// refusal, never silently coerced into completion or a fabricated deadline.
type SshSessionWireFault = OverrunWithoutDeadline | DeadlineWithoutOverrun

fn ssh_session_exec_wire_refusal_text(fault: SshSessionWireFault) -> String {
  match fault {
    OverrunWithoutDeadline => "ssh session reported overran=true but echoed no wall deadline: a tripped per-leg deadline must be echoed as its value"
    DeadlineWithoutOverrun => "ssh session echoed a wall deadline but overran=false: a leg that completed does not report a deadline it never tripped"
  }
}

// THE ONE DECODE SITE: wire record -> model sum. The illegal combinations are refused HERE and
// nowhere else; every consumer matches the sum instead of reading `overran`/`wall_deadline_seconds`.
fn ssh_session_exec_outcome(result: SshSessionExecResult) -> SshSessionExecOutcome {
  match result.overran {
    true => match result.wall_deadline_seconds {
      Present { value: d } => SessionOverran { deadline: d }
      Absent => SessionWireInconsistent { fault: OverrunWithoutDeadline }
    }
    false => match result.wall_deadline_seconds {
      Absent =>
        SessionCompleted {
          exit_code: result.exit_code,
          success: result.success,
          stdout: result.stdout,
          stderr: result.stderr,
        }
      Present { value: _ } => SessionWireInconsistent { fault: DeadlineWithoutOverrun }
    }
  }
}

service ssh.Session {
  operation Exec {
    requires Network
    input { host: NonEmptyStr, command: NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "{command}"]
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote command failed"
    }
  }

  operation ExecPortableWords {
    requires Network
    input { client_args: List<String>, wall_deadline: Optional<Second> }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
      overran: Bool from "overran"
      wall_deadline_seconds: Optional<Second> from "wall_deadline_seconds"
    }
    transport shell {
      argv: ["ssh", client_args]
      // THE TRANSPORT DECLARES THE CEILING, exactly as it declares `stdin`. The interpreter
      // arms the per-leg kill because THIS block says so -- never because a parameter happens
      // to be spelled `wall_deadline` (review 96999). A transport without this field runs
      // exactly as it did before this field existed: no group, no kill, no overrun arm.
      wall_deadline: wall_deadline
    }
    exit {
      0 => Unit
      nonzero => String "ssh portable-words exec failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock-ssh-portable-words", stderr: "", overran: false } "hermetic ssh.Session.ExecPortableWords"
    }
  }

  operation ExecPortableWordsWithStdin {
    requires Network
    input { client_args: List<String>, stdin_payload: String, wall_deadline: Optional<Second> }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
      overran: Bool from "overran"
      wall_deadline_seconds: Optional<Second> from "wall_deadline_seconds"
    }
    transport shell {
      argv: ["ssh", client_args]
      stdin: stdin_payload
      // THE TRANSPORT DECLARES THE CEILING, exactly as it declares `stdin`. The interpreter
      // arms the per-leg kill because THIS block says so -- never because a parameter happens
      // to be spelled `wall_deadline` (review 96999). A transport without this field runs
      // exactly as it did before this field existed: no group, no kill, no overrun arm.
      wall_deadline: wall_deadline
    }
    exit {
      0 => Unit
      nonzero => String "ssh portable-words exec with stdin failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock-ssh-portable-words-stdin", stderr: "", overran: false } "hermetic"
    }
  }

  operation ExecScript {
    requires Network
    input { host: NonEmptyStr, script: String }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "bash", "-s"]
      stdin: script
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote script failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock ssh stdin script executed", stderr: "" } "ok"
    }
  }

  operation Reachability {
    requires Network
    input { host: NonEmptyStr }
    output { reachable: Bool from "exit_success" }
    readonly
    transport shell { argv: ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "{host}", "true"] }
    exit {
      0 => Unit
      nonzero => String "ssh unreachable"
    }
  }
}

fn ssh_session_exec_result_from_service(
  exit_code: Int,
  success: Bool,
  stdout: String,
  stderr: String,
  overran: Bool = false,
  wall_deadline_seconds: Optional<Second> = Absent,
) -> SshSessionExecResult {
  SshSessionExecResult {
    exit_code: exit_code,
    success: success,
    stdout: stdout,
    stderr: stderr,
    overran: overran,
    wall_deadline_seconds: wall_deadline_seconds,
  }
}

fn ssh_session_exec(host: NonEmptyStr, command: NonEmptyStr) -> SshSessionExecResult {
  let result = ssh.Session.Exec(host: host, command: command)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}

// NO DEFAULT: a leg that states no ceiling is a compile error, not an unbounded ssh. A caller that
// genuinely has no ceiling says so by passing Absent by name (gunbc.typed_argv_exec
// typed_argv_exec_over_ssh, the non-fleet host transport); every FLEET path arms its ceiling from the
// leg (gunbc.fleet.fleet_known_hosts_anchor fleet_ssh_armed_key_leg).
fn ssh_session_exec_portable_words(client_args: List<String>, wall_deadline: Optional<Second>) -> SshSessionExecResult {
  let result = ssh.Session.ExecPortableWords(client_args: client_args, wall_deadline: wall_deadline)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
    overran: result.overran,
    wall_deadline_seconds: result.wall_deadline_seconds,
  )
}

// NO DEFAULT, same rule as ssh_session_exec_portable_words.
fn ssh_session_exec_portable_words_with_stdin(client_args: List<String>, stdin_payload: String, wall_deadline: Optional<Second>) -> SshSessionExecResult {
  let result = ssh.Session.ExecPortableWordsWithStdin(client_args: client_args, stdin_payload: stdin_payload, wall_deadline: wall_deadline)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
    overran: result.overran,
    wall_deadline_seconds: result.wall_deadline_seconds,
  )
}

fn ssh_session_exec_script(host: NonEmptyStr, script: String) -> SshSessionExecResult {
  let result = ssh.Session.ExecScript(host: host, script: script)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}
