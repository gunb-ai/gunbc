module extdeps.ssh.session


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc4253"
  }
}

data ssh_remote_exec_carries_a_command_string_note: String = "What ExecArgv does and does not carry. Its transport argv is [ssh, host, --, argv], so the LOCAL invocation is structured: the words reach the ssh client as distinct argv members and no local shell sees them. The REMOTE side is a different fact. RFC 4254 section 6.5 defines the exec channel request as carrying a single `command` field of type string, so the protocol has no argv vector to carry: the client joins the words with spaces into that one string, and the server hands it to the user's shell, which re-parses it. A word containing a space, a quote, or a metacharacter therefore arrives as several words or as syntax.\\n\\nThis is a property of the SSH protocol, not of one client, so no ExecArgv-shaped operation over SSH can promise structured argv end to end. An operation that wants that promise needs a receiver on the far side that accepts a structured invocation and calls exec itself - a different mechanism, which ssh.Session does not implement and must not be read as implementing.\\n\\nThe consequence for callers is a policy fact and is stated once, at the realization edge that enforces it: gunbc.typed_argv_exec typed_argv_exec_note.\\n\\nCorrection receipt: this note previously read `ExecArgv splices a List<String> remote argv without embedding a shell command string`, which is false for the remote half and contradicted the note at the enforcing edge, which said the opposite in the same corpus. Nothing depended on the false half - the allowlist was already fail-closed - so the defect was that the corpus asserted both readings and a reader could reach either."

fn shape_scp_copy_to_argv(
  host: NonEmptyStr,
  local_path: FilePath,
  remote_path: FilePath,
) -> List<String> {
  [local_path as String, join([host as String, ":", remote_path as String], "")]
}

type SshSessionExecResult {
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
}

service ssh.Session {
  operation Exec {
    input { host: NonEmptyStr, command: NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "{command}"]
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote command failed"
    }
  }

  operation ExecArgv {
    input { host: NonEmptyStr, argv: List<String> }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "--", argv]
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote argv exec failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock-ssh-argv", stderr: "" } "hermetic ssh.Session.ExecArgv"
    }
  }

  operation ExecScript {
    input { host: NonEmptyStr, script: String }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "bash", "-s"]
      stdin: script
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote script failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock ssh stdin script executed", stderr: "" } "ok"
    }
  }

  operation Reachability {
    input { host: NonEmptyStr }
    output { reachable: Bool from "exit_success" }
    readonly
    transport shell { argv: ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "{host}", "true"] }
    exit {
      0 => Unit
      nonzero => String "ssh unreachable"
    }
  }
}

fn ssh_session_exec_result_from_service(
  exit_code: Int,
  success: Bool,
  stdout: String,
  stderr: String,
) -> SshSessionExecResult {
  SshSessionExecResult {
    exit_code: exit_code,
    success: success,
    stdout: stdout,
    stderr: stderr,
  }
}

fn ssh_session_exec(host: NonEmptyStr, command: NonEmptyStr) -> SshSessionExecResult {
  let result = ssh.Session.Exec(host: host, command: command)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}

fn ssh_session_exec_argv(host: NonEmptyStr, argv: List<String>) -> SshSessionExecResult {
  let result = ssh.Session.ExecArgv(host: host, argv: argv)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}

fn ssh_session_exec_script(host: NonEmptyStr, script: String) -> SshSessionExecResult {
  let result = ssh.Session.ExecScript(host: host, script: script)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}
