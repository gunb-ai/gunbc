module extdeps.ssh.session


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "datatracker.ietf.org/doc/html/rfc4254"
  }
}

data session_authority_is_the_connection_protocol_note: String = "This anchor moved from RFC 4253 to RFC 4254 (review 45901). What this module declares is Exec, ExecArgv, ExecScript and Reachability - channel requests, which RFC 4254 (SSH Connection Protocol) defines. RFC 4253 is the SSH Transport Layer Protocol: key exchange, encryption, MAC. It underlies every SSH session but defines none of the operations here, so it was the authority for a layer this module does not model, and a note grounding an exec fact in it would have been citing the wrong document.\\n\\nThe sibling modules keep their own anchors and are untouched; this is a fidelity correction for this file's declarations, not a fleet-wide repoint."

data ssh_exec_portable_words_executable_position_note: String = "These operations take CLIENT_ARGS -- everything after argv[0] -- and the transport supplies the literal `ssh` itself. An earlier revision spliced the whole argv from the input, which the operation-argv executable-position wall refused, correctly: argv[0] decided by a bound input means a CALLER decides which program runs, and std.operation_argv states that a generic binder over the executable position is strictly worse than the hardcoded list it replaces. The shaper's own prepending of `ssh` was no defense -- the OPERATION could not know that, and a second caller could have passed anything. The wall found this within one CI run of the operations landing."

data ssh_exec_portable_words_supersedes_exec_argv_note: String = "ExecPortableWords is the successor to ExecArgv and lands BESIDE it rather than replacing it, so the migration is a counted population rather than one edit that reds twenty call sites at once. Two differences, both corrections. ONE: it takes an argv already shaped by gunbc.fleet_known_hosts_anchor shape_fleet_ssh_exec instead of building [ssh, host, --, argv] inside a transport literal. A literal in a service block cannot be called by a witness, which is how this corpus came to hold one site requiring host-key verification and another disabling it, spelled as indistinguishable strings with no test able to name the disagreement. TWO: the NAME. ExecArgv promised a remote argv vector, and RFC 4254 section 6.5 gives the exec channel request a single string-typed command field, so no SSH client carries argv structure across that boundary -- a caller reading ExecArgv reasonably concludes its words survive as words, and they do not. What holds is the LOCAL half plus the portable-word allowlist, and ExecPortableWords names exactly that. DISSOLVE-ON: ExecArgv and this note are deleted together when the remaining consumers (host_effect_realize, live_deploy, systemctl/hostname reads, roadmap actuators) route through a FleetSshExecutionContext."

data ssh_remote_exec_carries_a_command_string_note: String = "What ExecArgv does and does not carry, separated into what the PROTOCOL fixes and what an IMPLEMENTATION chooses, because those carry different weight and the earlier revision of this note fused them (review 45901).\\n\\nLOCAL, from this operation's own declaration: the transport argv is [ssh, host, --, argv], so the words reach the ssh client as distinct argv members and no local shell sees them. The local invocation is genuinely structured.\\n\\nPROTOCOL, from the anchored authority: RFC 4254 section 6.5 defines the exec channel request as carrying a single `command` field of type string. There is no argv vector in the request for structure to travel in. This is the universal half - it holds for every SSH client and server, so no ExecArgv-shaped operation over SSH can carry argv structure across the boundary AS STRUCTURE, and an operation wanting that promise needs a receiver on the far side accepting a structured invocation and calling exec itself. ssh.Session does not implement that and must not be read as implementing it.\\n\\nIMPLEMENTATION, which the protocol does NOT mandate and which this note therefore scopes rather than asserts: the OpenSSH client (ssh(1)) joins the command words into that single string, and OpenSSH's server (sshd(8)) executes it through the user's login shell, which re-parses it. RFC 4254 says the server starts execution of the given command; it does not say the command is joined a particular way, nor that a shell interprets it. A different server could exec the string directly.\\n\\nWHICH HALF CARRIES WHICH CONCLUSION, since they are not interchangeable: loss of argv structure follows from the PROTOCOL and is unavoidable. Re-splitting on spaces and interpretation of quotes, redirects and metacharacters follows from the OpenSSH client and server behavior above, and that is what the portable-word allowlist at gunbc.typed_argv_exec exists to bound. A note claiming the second as protocol-mandated would be overstating an extdeps authority, which is the defect this revision fixes.\\n\\nCorrection receipt: before this PR the note read `ExecArgv splices a List<String> remote argv without embedding a shell command string`, which is false for the remote half and contradicted the note at the enforcing edge, which said the opposite in the same corpus. Nothing depended on the false half - the allowlist was already fail-closed - so the defect was that the corpus asserted both readings and a reader could reach either."

fn shape_scp_copy_to_argv(
  host: std.types.NonEmptyStr,
  local_path: std.types.FilePath,
  remote_path: std.types.FilePath,
) -> List<String> {
  [local_path as String, join([host as String, ":", remote_path as String], "")]
}

type SshSessionExecResult {
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
}

service ssh.Session {
  operation Exec {
    input { host: std.types.NonEmptyStr, command: std.types.NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "{command}"]
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote command failed"
    }
  }

  operation ExecArgv {
    input { host: std.types.NonEmptyStr, argv: List<String> }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "--", argv]
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote argv exec failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock-ssh-argv", stderr: "" } "hermetic ssh.Session.ExecArgv"
    }
  }

  operation ExecPortableWords {
    input { client_args: List<String> }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", client_args]
    }
    exit {
      0 => Unit
      nonzero => String "ssh portable-words exec failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock-ssh-portable-words", stderr: "" } "hermetic ssh.Session.ExecPortableWords"
    }
  }

  operation ExecPortableWordsWithStdin {
    input { client_args: List<String>, stdin_payload: String }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", client_args]
      stdin: stdin_payload
    }
    exit {
      0 => Unit
      nonzero => String "ssh portable-words exec with stdin failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock-ssh-portable-words-stdin", stderr: "" } "hermetic"
    }
  }

  operation ExecScript {
    input { host: std.types.NonEmptyStr, script: String }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "bash", "-s"]
      stdin: script
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote script failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock ssh stdin script executed", stderr: "" } "ok"
    }
  }

  operation Reachability {
    input { host: std.types.NonEmptyStr }
    output { reachable: Bool from "exit_success" }
    readonly
    transport shell { argv: ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "{host}", "true"] }
    exit {
      0 => Unit
      nonzero => String "ssh unreachable"
    }
  }
}

fn ssh_session_exec_result_from_service(
  exit_code: Int,
  success: Bool,
  stdout: String,
  stderr: String,
) -> SshSessionExecResult {
  SshSessionExecResult {
    exit_code: exit_code,
    success: success,
    stdout: stdout,
    stderr: stderr,
  }
}

fn ssh_session_exec(host: std.types.NonEmptyStr, command: std.types.NonEmptyStr) -> SshSessionExecResult {
  let result = ssh.Session.Exec(host: host, command: command)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}

fn ssh_session_exec_argv(host: std.types.NonEmptyStr, argv: List<String>) -> SshSessionExecResult {
  let result = ssh.Session.ExecArgv(host: host, argv: argv)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}

fn ssh_session_exec_portable_words(client_args: List<String>) -> SshSessionExecResult {
  let result = ssh.Session.ExecPortableWords(client_args: client_args)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}

fn ssh_session_exec_portable_words_with_stdin(client_args: List<String>, stdin_payload: String) -> SshSessionExecResult {
  let result = ssh.Session.ExecPortableWordsWithStdin(client_args: client_args, stdin_payload: stdin_payload)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}

fn ssh_session_exec_script(host: std.types.NonEmptyStr, script: String) -> SshSessionExecResult {
  let result = ssh.Session.ExecScript(host: host, script: script)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}
