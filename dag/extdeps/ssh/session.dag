module extdeps.ssh.session

import extdeps.ssh.client_options { serialize_ssh_client_options, ssh_verified_host_options }


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc4254"
  }
}

data session_authority_is_the_connection_protocol_note: String = "This anchor moved from RFC 4253 to RFC 4254 (review 45901). What this module declares is Exec, ExecArgv, ExecScript and Reachability - channel requests, which RFC 4254 (SSH Connection Protocol) defines. RFC 4253 is the SSH Transport Layer Protocol: key exchange, encryption, MAC. It underlies every SSH session but defines none of the operations here, so it was the authority for a layer this module does not model, and a note grounding an exec fact in it would have been citing the wrong document.\\n\\nThe sibling modules keep their own anchors and are untouched; this is a fidelity correction for this file's declarations, not a fleet-wide repoint."

data ssh_remote_exec_carries_a_command_string_note: String = "What ExecArgv does and does not carry, separated into what the PROTOCOL fixes and what an IMPLEMENTATION chooses, because those carry different weight and the earlier revision of this note fused them (review 45901).\\n\\nLOCAL, from this operation's own declaration: the transport argv is [ssh, host, --, argv], so the words reach the ssh client as distinct argv members and no local shell sees them. The local invocation is genuinely structured.\\n\\nPROTOCOL, from the anchored authority: RFC 4254 section 6.5 defines the exec channel request as carrying a single `command` field of type string. There is no argv vector in the request for structure to travel in. This is the universal half - it holds for every SSH client and server, so no ExecArgv-shaped operation over SSH can carry argv structure across the boundary AS STRUCTURE, and an operation wanting that promise needs a receiver on the far side accepting a structured invocation and calling exec itself. ssh.Session does not implement that and must not be read as implementing it.\\n\\nIMPLEMENTATION, which the protocol does NOT mandate and which this note therefore scopes rather than asserts: the OpenSSH client (ssh(1)) joins the command words into that single string, and OpenSSH's server (sshd(8)) executes it through the user's login shell, which re-parses it. RFC 4254 says the server starts execution of the given command; it does not say the command is joined a particular way, nor that a shell interprets it. A different server could exec the string directly.\\n\\nWHICH HALF CARRIES WHICH CONCLUSION, since they are not interchangeable: loss of argv structure follows from the PROTOCOL and is unavoidable. Re-splitting on spaces and interpretation of quotes, redirects and metacharacters follows from the OpenSSH client and server behavior above, and that is what the portable-word allowlist at gunbc.typed_argv_exec exists to bound. A note claiming the second as protocol-mandated would be overstating an extdeps authority, which is the defect this revision fixes.\\n\\nCorrection receipt: before this PR the note read `ExecArgv splices a List<String> remote argv without embedding a shell command string`, which is false for the remote half and contradicted the note at the enforcing edge, which said the opposite in the same corpus. Nothing depended on the false half - the allowlist was already fail-closed - so the defect was that the corpus asserted both readings and a reader could reach either."

fn shape_scp_copy_to_argv(
  host: NonEmptyStr,
  local_path: FilePath,
  remote_path: FilePath,
) -> List<String> {
  [local_path as String, join([host as String, ":", remote_path as String], "")]
}

type SshSessionExecResult {
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
}

// THE HOST-KEY TRUST ANCHOR, modeled as an INPUT to the operation that needs it.
//
// Until this carrier existed, ExecArgv's contract was (host, argv) and nothing else: HOW a host
// gets verified was not an input to the operation doing the verifying. The anchor was instead
// injected as a SIDE EFFECT on ambient user state -- a workflow module (gunbc.fleet_host_key_
// enrollment) appending a `Host` block to $HOME/.ssh/config so that a later, unrelated `ssh`
// invocation would happen to pick it up. That is a layer inversion (extdeps' transport configured
// from above by a consumer) and it made the real input invisible to the graph.
//
// Every defect measured on 2026-08-11 is downstream of that one omission, which is why the fix is
// here and not at any of the sites that suffered:
//   - the anchor lived in mutable shared state, so an absolute path baked once by `$(pwd)` into one
//     runner slot's workspace was silently reused by nine sibling slots that shared /home/ghrunner;
//   - a marker guard made the block write-once, so neither the path nor the endpoint list could
//     ever be refreshed, while an unconditional `touch` kept the file's mtime current so it read as
//     maintained;
//   - the enrollment's own readback checked the fragment file it had just written rather than the
//     binding ssh would resolve, so it reported success for six hosts in the same job whose next
//     step could verify none of them;
//   - and nothing anywhere REQUIRED an anchor, so a probe whose enrollment had refused outright
//     still ran, produced sixteen host-key failures, and exited success -- refusals that read as
//     principal absence to anyone consuming the receipt.
//
// With the anchor as a required input none of those states is reachable. There is no ambient
// configuration to go stale, no second representation for a check to diverge from, and no way to
// invoke a verified exec without naming the anchor it verified against: an unanchored ssh has no
// constructor rather than being a thing we hope did not happen (DESIGN 4b -- the class moves from
// mitigatable to structurally impossible). It also decouples execution from any particular host
// environment: the modeled probe entries become runnable wherever the key and network reach exist,
// with no writable $HOME and no GitHub Actions runner in the path.
//
// sole_constructor, sealed to the enrollment authority, is what stops this from being cosmetic. A
// transparent `= String where ...` brand would let any module conjure an anchor out of a path and
// re-open exactly the ambient-trust hole the carrier exists to close (DESIGN 4b -- a richer type
// name is not safety until construction enforces the distinction). Adding a minter is an edit to
// the admit_callers list in THIS module: a conspicuous, counted review event.
type KnownHostsAnchor sole_constructor {
  path: NonEmptyStr
}

fn known_hosts_anchor_seal(path: NonEmptyStr) -> KnownHostsAnchor
  admit_callers: [
    decl_ref(module_path: "gunbc.fleet_host_key_enrollment", decl_name: "fleet_host_key_enroll_apply"),
  ]
  = KnownHostsAnchor { path: path }

service ssh.Session {
  operation Exec {
    input { host: NonEmptyStr, command: NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "{command}"]
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote command failed"
    }
  }

  operation ExecArgv {
    input { host: NonEmptyStr, argv: List<String>, options: List<String> }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    // The option words arrive ALREADY SERIALIZED from extdeps.ssh.client_options, so neither "-o"
    // nor a Key=Value join appears in this file. That matters because a transport literal cannot
    // call a function and therefore cannot be reached by a witness: the previous revision of this
    // line hand-wrote `-o StrictHostKeyChecking=yes`, which is the same unpinnable shape that let
    // `StrictHostKeyChecking=no` sit elsewhere in the corpus indistinguishable from it. The pairs
    // are now built and asserted in ssh_client_options_witness_test, and this operation splices a
    // flat argv it does not interpret.
    //
    // The anchor travels on the INVOCATION, not in ambient configuration, and the verification
    // posture is not a caller parameter: an unverified exec is a different operation, not a lenient
    // form of this one, so ssh_verified_host_options fixes both halves together and a caller has no
    // seam to omit one.
    transport shell {
      argv: ["ssh", options, "{host}", "--", argv]
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote argv exec failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock-ssh-argv", stderr: "" } "hermetic ssh.Session.ExecArgv"
    }
  }

  operation ExecScript {
    input { host: NonEmptyStr, script: String }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["ssh", "{host}", "bash", "-s"]
      stdin: script
    }
    exit {
      0 => Unit
      nonzero => String "ssh remote script failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "mock ssh stdin script executed", stderr: "" } "ok"
    }
  }

  operation Reachability {
    input { host: NonEmptyStr }
    output { reachable: Bool from "exit_success" }
    readonly
    transport shell { argv: ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "{host}", "true"] }
    exit {
      0 => Unit
      nonzero => String "ssh unreachable"
    }
  }
}

fn ssh_session_exec_result_from_service(
  exit_code: Int,
  success: Bool,
  stdout: String,
  stderr: String,
) -> SshSessionExecResult {
  SshSessionExecResult {
    exit_code: exit_code,
    success: success,
    stdout: stdout,
    stderr: stderr,
  }
}

fn ssh_session_exec(host: NonEmptyStr, command: NonEmptyStr) -> SshSessionExecResult {
  let result = ssh.Session.Exec(host: host, command: command)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}

fn ssh_session_exec_argv(host: NonEmptyStr, argv: List<String>, anchor: KnownHostsAnchor) -> SshSessionExecResult {
  let result = ssh.Session.ExecArgv(
    host: host,
    argv: argv,
    options: serialize_ssh_client_options(options: ssh_verified_host_options(known_hosts: anchor.path)),
  )
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}

fn ssh_session_exec_script(host: NonEmptyStr, script: String) -> SshSessionExecResult {
  let result = ssh.Session.ExecScript(host: host, script: script)
  ssh_session_exec_result_from_service(
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  )
}
