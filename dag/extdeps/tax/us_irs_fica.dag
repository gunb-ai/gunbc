module extdeps.tax.us_irs_fica

import std.types { Int, List }
import std.measure { MoneyAmountMicro, basis_point, money_amount_micro }
import extdeps.currency.currency { Usd }
import extdeps.payroll.contribution {
  ContributionSpec,
  FromFirstDollarUncapped, CappedAtAnnualLimit, AboveAnnualThreshold,
  Employer, Worker,
  CalendarYearAssessed, EmployerWorkerRelationship,
}
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }

// The Federal Insurance Contributions Act taxes, as the Internal Revenue Service publishes them
// in Publication 15 (Circular E), Employer's Tax Guide. The IRS is one independently governed
// authority and gets one module; New Jersey's unemployment and disability contributions are a
// different authority on a different schedule and will get their own, importing nothing from
// here. That separation is the point - a federal rate change must not require editing New
// Jersey, and adding New Jersey must not widen anything federal.
//
// Every row is assessed over the CALENDAR YEAR and accumulates per EMPLOYER-WORKER
// RELATIONSHIP. The second is a real fact and not a default: US OASDI restarts its wage base at
// each employer, so a worker with two jobs has the cap applied twice and reconciles the
// over-withholding on their own return. A row that failed to say so could silently receive a
// worker-lifetime position and under-withhold.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.irs.gov/publications/p15"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tax.us_irs_fica",
      decl_name: "fica_specs_2025",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// TWO KINDS OF NUMBER LIVE IN THIS FILE AND THEY HAVE DIFFERENT STANDING.
//
// The RATES are fixed in statute and have not moved in decades: OASDI at 6.2 percent per side,
// Hospital Insurance at 1.45 percent per side, Additional Medicare at 0.9 percent on the employee
// alone. The 200,000 dollar Additional Medicare threshold is likewise statutory and carries no
// indexation mechanism, which is why it is the same figure in both year cohorts below while the
// OASDI base moves.
//
// The SOCIAL SECURITY WAGE BASE is indexed and republished every year, so it is an observed
// external fact with a date and gets one row per year. Both figures below were verified against
// Publication 15 for their own year: 176,100 dollars for 2025 and 184,500 dollars for 2026, the
// latter corroborated by the Social Security Administration's published contribution and benefit
// base. The 2026 figure carries its own arithmetic check - 184,500 at 6.2 percent is exactly
// 11,439 dollars, which is the maximum OASDI contribution SSA publishes for each side - and the
// witness asserts that number rather than one this repository computed for itself.
//
// A YEAR WITH NO ROW REFUSES. That is the whole reason effective_year exists: reusing 2025's base
// through 2026 would have understated it by 8,400 dollars per worker who reaches the cap, which
// is a plausible wrong number that reaches a filing. A 2027 period refuses today for the same
// reason, and the row lands when someone reads the published figure.

data us_social_security_wage_base_2025: MoneyAmountMicro = money_amount_micro(count: 176100000000)

data us_social_security_wage_base_2026: MoneyAmountMicro = money_amount_micro(count: 184500000000)

data us_additional_medicare_withholding_threshold: MoneyAmountMicro = money_amount_micro(count: 200000000000)

data us_social_security_employee_2025: ContributionSpec = ContributionSpec {
  name: "us-irs-oasdi-employee-2025",
  effective_year: 2025,
  currency: Usd,
  rate: basis_point(count: 620),
  band: CappedAtAnnualLimit { annual_limit: us_social_security_wage_base_2025 },
  borne_by: Worker,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

data us_social_security_employer_2025: ContributionSpec = ContributionSpec {
  name: "us-irs-oasdi-employer-2025",
  effective_year: 2025,
  currency: Usd,
  rate: basis_point(count: 620),
  band: CappedAtAnnualLimit { annual_limit: us_social_security_wage_base_2025 },
  borne_by: Employer,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

data us_medicare_employee_2025: ContributionSpec = ContributionSpec {
  name: "us-irs-hi-employee-2025",
  effective_year: 2025,
  currency: Usd,
  rate: basis_point(count: 145),
  band: FromFirstDollarUncapped,
  borne_by: Worker,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

data us_medicare_employer_2025: ContributionSpec = ContributionSpec {
  name: "us-irs-hi-employer-2025",
  effective_year: 2025,
  currency: Usd,
  rate: basis_point(count: 145),
  band: FromFirstDollarUncapped,
  borne_by: Employer,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

// THIS ROW IS THE EMPLOYER'S WITHHOLDING RULE AND ITS NAME SAYS SO. The IRS directs an employer
// to begin withholding the 0.9 percent in the pay period in which it pays that employee more than
// 200,000 dollars, WITHOUT REGARD TO FILING STATUS, and there is no employer share. The
// employee's eventual liability on their own return is a different rule with different
// thresholds - 250,000 married filing jointly, 125,000 married filing separately, 200,000
// otherwise - and it is not modeled here. DESIGN 3 forbids one name carrying two materially
// different contracts, so the withholding rule is named as the withholding rule; a future
// final-liability authority gets its own row and its own name rather than widening this one.
//
// borne_by is Worker because the worker bears the cost. That is a separate fact from the employer
// being the withholding agent, which this kernel does not yet carry as a field because every row
// it holds is withheld by the employer.
data us_additional_medicare_employer_withholding_2025: ContributionSpec = ContributionSpec {
  name: "us-irs-additional-medicare-employer-withholding-2025",
  effective_year: 2025,
  currency: Usd,
  rate: basis_point(count: 90),
  band: AboveAnnualThreshold { annual_threshold: us_additional_medicare_withholding_threshold },
  borne_by: Worker,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

data us_social_security_employee_2026: ContributionSpec = ContributionSpec {
  name: "us-irs-oasdi-employee-2026",
  effective_year: 2026,
  currency: Usd,
  rate: basis_point(count: 620),
  band: CappedAtAnnualLimit { annual_limit: us_social_security_wage_base_2026 },
  borne_by: Worker,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

data us_social_security_employer_2026: ContributionSpec = ContributionSpec {
  name: "us-irs-oasdi-employer-2026",
  effective_year: 2026,
  currency: Usd,
  rate: basis_point(count: 620),
  band: CappedAtAnnualLimit { annual_limit: us_social_security_wage_base_2026 },
  borne_by: Employer,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

data us_medicare_employee_2026: ContributionSpec = ContributionSpec {
  name: "us-irs-hi-employee-2026",
  effective_year: 2026,
  currency: Usd,
  rate: basis_point(count: 145),
  band: FromFirstDollarUncapped,
  borne_by: Worker,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

data us_medicare_employer_2026: ContributionSpec = ContributionSpec {
  name: "us-irs-hi-employer-2026",
  effective_year: 2026,
  currency: Usd,
  rate: basis_point(count: 145),
  band: FromFirstDollarUncapped,
  borne_by: Employer,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

data us_additional_medicare_employer_withholding_2026: ContributionSpec = ContributionSpec {
  name: "us-irs-additional-medicare-employer-withholding-2026",
  effective_year: 2026,
  currency: Usd,
  rate: basis_point(count: 90),
  band: AboveAnnualThreshold { annual_threshold: us_additional_medicare_withholding_threshold },
  borne_by: Worker,
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
}

data fica_specs_2025: List<ContributionSpec> = [
  us_social_security_employee_2025,
  us_social_security_employer_2025,
  us_medicare_employee_2025,
  us_medicare_employer_2025,
  us_additional_medicare_employer_withholding_2025,
]

data fica_specs_2026: List<ContributionSpec> = [
  us_social_security_employee_2026,
  us_social_security_employer_2026,
  us_medicare_employee_2026,
  us_medicare_employer_2026,
  us_additional_medicare_employer_withholding_2026,
]
