module extdeps.tax.new_york_city_sales_and_use

import std.types { NonEmptyStr }
import std.measure { PartsPerMillion, parts_per_million }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }

// Combined New York City sales and use tax on ordinary tangible personal property.
// Separate authority from New Jersey's statewide rate. The combined figure is the
// destination rate a New York use-tax residual is measured against; it is not a
// dollar amount and it is not a lot's collected tax.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nyc.gov/site/finance/business/business-nys-sales-tax.page"
  }
}

data nyc_pub718_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.tax.ny.gov/pdf/publications/sales/pub718.pdf"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tax.new_york_city_sales_and_use",
      decl_name: "nyc_combined_sales_tax_rate",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [nyc_pub718_authority]
}

// NYC Department of Finance / Pub 718: 8.875 percent combined
// (4 percent state + 4.5 percent city + 0.375 percent MCTD), reporting code 8081.
// Percent is whole points; this is that published rate at Micro scale.
data nyc_combined_sales_tax_rate: PartsPerMillion = parts_per_million(count: 88750)

data nyc_combined_rate_composition: NonEmptyStr = "NYC Department of Finance: City 4.5 percent, New York State 4 percent, MCTD 0.375 percent, combined 8.875 percent on most personal property"
