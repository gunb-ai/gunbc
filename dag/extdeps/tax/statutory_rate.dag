module extdeps.tax.statutory_rate

import std.types { NonEmptyStr, Bool }
import std.measure { PartsPerMillion }
import extdeps.publication { SpecificationDocumentDate }
import std.decl_ref { DeclarationRef }

// THE SHARED SHAPE OF A PUBLISHED STATUTORY TAX RATE, and nothing about any jurisdiction.
//
// DESIGN section 3's external-upstream decomposition governs the split: each independently
// governed taxing authority - New Jersey, New York City, and whoever comes next - owns its own
// module and its own rows, and this hub owns only the agnostic shape they inhabit. It enumerates
// no jurisdiction, carries no rate, and dispatches among none; adding a third state must not
// widen anything here.
//
// WHY A RATE IS NOT JUST A NUMBER. A statutory rate is a figure that was true from a date, under
// a citable instrument, and the date is the part that rots silently: a rate row carrying its
// effective date in a COMMENT reads as current forever, because nothing in the type can tell a
// later reader that the comment describes a superseded version. New Jersey publishes 6.625 percent
// on and after 2018-01-01 - that qualifier is load-bearing, and it belonged in the carrier rather
// than beside it.
//
// AND AN UNKNOWN EFFECTIVE DATE IS AN ARM, NOT A BLANK. Some rates here were transcribed from a
// publication that states the rate without stating when it took effect. That is a real epistemic
// state and it is not the same as a rate known to be current; DESIGN section 4d forbids asserting
// as deduced what is only inferred, so the unread arm carries what would ground it.

type StatutoryRateEffectiveVersion
  = EffectiveFrom { date: SpecificationDocumentDate, instrument: NonEmptyStr }
  | EffectiveDateUnread { obligation: NonEmptyStr }

fn effective_date_is_read(v: StatutoryRateEffectiveVersion) -> Bool {
  match v {
    EffectiveFrom { date, instrument } => true
    EffectiveDateUnread { obligation } => false
  }
}

// The rate, its version AND ITS JURISDICTION travel together, so a consumer cannot take one
// without the others. Splitting them into separate declarations would let a caller read the figure
// and never learn which version it is - which is the state this carrier exists to make unwritable.
//
// WHY THE JURISDICTION IS IN HERE AND NOT BESIDE THE RATE AT EACH USE SITE. A consumer that holds
// a rate and, in a sibling field, a separate name for where the rate came from holds two sources
// for one fact: repoint the rate at a different authority's module and the sibling goes on saying
// what it always said, with nothing to catch it. The first attempt at this fix deleted the sibling
// field on the premise that evaluating a module's data row retains the module it came from - it
// does not; a record value carries no trace of its declaration site, so that deletion would have
// erased the destination rather than derived it (royal-koi-731, review of this change). Carrying
// the reference in the rate itself is the construction that premise assumed: ONE field, authored
// once beside the figure it qualifies, and a consumer PROJECTS the destination instead of
// restating it.
//
// It is a DeclarationRef and deliberately not an enum - DESIGN section 3's external-upstream rule
// forbids this hub from enumerating jurisdictions, and the corpus already settled the shape at
// gunbc.product.fabric.provider_route, whose header states that jurisdictions are open declaration
// references with no central enum.
type StatutoryRate {
  rate: PartsPerMillion
  effective: StatutoryRateEffectiveVersion
  jurisdiction: DeclarationRef
}

fn statutory_rate_value(r: StatutoryRate) -> PartsPerMillion {
  r.rate
}

// The projection that makes a sibling destination field unnecessary: a consumer holding the rate
// can always say which authority published it.
fn statutory_rate_jurisdiction(r: StatutoryRate) -> DeclarationRef {
  r.jurisdiction
}

fn statutory_rate_version_is_read(r: StatutoryRate) -> Bool {
  effective_date_is_read(v: r.effective)
}
