module extdeps.w3c.svg

import std.types { String, List, Int, NonEmptyStr }
import std.algebra { Empty, FreeSemigroup }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.markup {
  Fragment,
  Element,
  FragmentText,
  Attribute,
  attr,
  MarkupMedium,
  CommentGrammar,
  DeclaresDocument,
  MarkupBracket,
  EscapeHtml,
  SelfClose,
  serialize_fragment_with,
  MarkupSerializeResult,
}
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.w3.org/TR/SVG2/"
  }
}

// Cited upstream: W3C Scalable Vector Graphics (SVG) 2, Recommendation-track. Element names, the
// SVG namespace, and the XML serialization medium live here so a product projection cites this
// authority rather than minting a second SVG vocabulary. Serialization uses std.markup's generic
// fragment algebra with an SVG medium; it does not route through HTML, which is a separately
// governed language.
data svg_spec_edition: String = "W3C SVG 2"

type SvgLanguage
  = | Svg2

data svg_language: SvgLanguage = Svg2

data svg_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.w3c.svg",
      decl_name: "svg_language",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: ExternalModelScope = svg_model_scope

data svg_root_tag: String = "svg"
data svg_rect_tag: String = "rect"
data svg_circle_tag: String = "circle"
data svg_text_tag: String = "text"
data svg_g_tag: String = "g"
data svg_style_tag: String = "style"

data svg_xmlns: String = "http://www.w3.org/2000/svg"
data svg_role_img: String = "img"

data svg_xml_brackets: MarkupBracket = MarkupBracket {
  tag_open: "<",
  end_tag_open: "</",
  tag_close: ">",
  attr_sep: " ",
  attr_assign: "=",
  attr_quote: "\"",
}

// XML's comment and document-type spellings, in THIS module. They coincide character-for-character
// with HTML's, and they are still not imported from extdeps.languages.html: HTML and XML agree by
// coincidence of ancestry, not because one specification defers to the other (which is the
// relationship that makes Markdown's import of the HTML rows a read rather than a copy — CommonMark
// 0.30 §6.6/§4.2 pass HTML blocks through). Two languages that happen to spell the same thing are two
// facts, each with its own home, so XML's can be corrected without touching HTML's.
// XML 1.0 §2.5 for comments, §2.8 for the document type declaration.
data xml_comment_open_sequence: NonEmptyStr = "<!-- " as NonEmptyStr
data xml_comment_close_sequence: NonEmptyStr = " -->" as NonEmptyStr
// ONE MEMBER, and that is XML's grammar rather than an omission. XML has no comment-end-bang state: a
// comment ends at "-->" and XML 1.0 §2.5 forbids "--" inside a comment at all, so "--!>" cannot appear
// in well-formed XML. Contrast html_comment_terminators, where the tokenizer does have the second exit.
// Same carrier in both, so std.markup asks one question of every medium.
data xml_comment_terminators: FreeSemigroup<NonEmptyStr> = FreeSemigroup {
  head: "-->" as NonEmptyStr,
  tail: Empty,
}
data xml_doctype_open_sequence: NonEmptyStr = "<!DOCTYPE " as NonEmptyStr

// XML's own copy of the boundary character (XML 1.0 §2.8's ExternalID production is terminated by
// whitespace). Not imported from the HTML module: XML and HTML agree on this by ancestry, not because one
// specification defers to the other, and a row each is what lets either be corrected alone.
data xml_doctype_name_end_whitespace: NonEmptyStr = " " as NonEmptyStr

fn svg_markup_medium() -> MarkupMedium {
  MarkupMedium {
    tag_overrides: [],
    bracket: svg_xml_brackets,
    text_escape: EscapeHtml,
    void_tags: [svg_rect_tag, svg_circle_tag],
    void_rendering: SelfClose,
    raw_text_tags: [],
    // Filled because this change gave the serializer a comment arm and a Document arm: a medium that
    // left these unset would have its comment's delimiters silently dropped — the body emitted as
    // markup, which is §5's silent degradation, not a refusal. Filling them from XML's own rows is
    // what makes a comment through this medium serialize as a comment.
    comment_grammar: CommentGrammar {
      open: xml_comment_open_sequence,
      close: xml_comment_close_sequence,
      terminators: xml_comment_terminators,
    },
    // XML documents carry a document type declaration (XML 1.0 §2.8), so a Document node is meaningful
    // through this medium even though nothing builds one for SVG today.
    document_grammar: DeclaresDocument {
      open: xml_doctype_open_sequence,
      name_end_whitespace: xml_doctype_name_end_whitespace,
    },
  }
}

fn svg_element(tag: String, attributes: List<Attribute>, children: List<Fragment>) -> Fragment {
  Element { tag: tag, attributes: attributes, children: children }
}

fn svg_document(view_box: String, class_name: String, aria_label: String, children: List<Fragment>) -> Fragment {
  svg_element(
    tag: svg_root_tag,
    attributes: [
      attr(name: "viewBox", value: view_box),
      attr(name: "class", value: class_name),
      attr(name: "xmlns", value: svg_xmlns),
      attr(name: "role", value: svg_role_img),
      attr(name: "aria-label", value: aria_label),
    ],
    children: children
  )
}

// A STYLE ELEMENT, WHICH SVG 2 DEFINES AND THE MEDIUM ALREADY SUPPORTS. Without one an emitted
// document carries semantic class names and no presentation, so its text renders at the user
// agent's default size inside a coordinate space measured in micrometres -- legible only through
// an external stylesheet somebody writes by hand, which makes the artifact not self-contained.
// The content is emitted through the ordinary text escape, so a selector may not use the child
// combinator or an ampersand; descendant selectors express everything this document needs.
fn svg_style(css: String) -> Fragment {
  svg_element(tag: svg_style_tag, attributes: [], children: [FragmentText { content: css }])
}

fn svg_group(class_name: String, children: List<Fragment>) -> Fragment {
  svg_element(tag: svg_g_tag, attributes: [attr(name: "class", value: class_name)], children: children)
}

fn svg_rect(x: Int, y: Int, width: Int, height: Int, class_name: String, fill: String, stroke: String, stroke_width: String) -> Fragment {
  svg_element(tag: svg_rect_tag, attributes: [
    attr(name: "x", value: to_string(x)),
    attr(name: "y", value: to_string(y)),
    attr(name: "width", value: to_string(width)),
    attr(name: "height", value: to_string(height)),
    attr(name: "class", value: class_name),
    attr(name: "fill", value: fill),
    attr(name: "stroke", value: stroke),
    attr(name: "stroke-width", value: stroke_width),
  ], children: [])
}

fn svg_text(x: Int, y: Int, label: String, class_name: String) -> Fragment {
  svg_element(tag: svg_text_tag, attributes: [
    attr(name: "x", value: to_string(x)),
    attr(name: "y", value: to_string(y)),
    attr(name: "class", value: class_name),
  ], children: [FragmentText { content: label }])
}

// The typed result, for the same reason as the HTML and JSX serializers: this is a route straight to the
// emitter, and the comment / raw-text checks now live in the emitter.
fn serialize_svg_document(doc: Fragment) -> MarkupSerializeResult {
  serialize_fragment_with(frag: doc, medium: svg_markup_medium())
}
