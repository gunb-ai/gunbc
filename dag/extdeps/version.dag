module extdeps.version

import std.types { NonEmptyStr, brand }
import std.algebra { Ordering }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Software_versioning"
  }
}

type VersionIdentity = NonEmptyStr where brand("VersionIdentity")

// Ordering? — a scheme's precedence is defined over the identity grammar the scheme names.
// A pair the grammar does not cover yields none: a typed, located refusal of the precedence
// question, never a fabricated order (DESIGN section 5: a failure arm must refuse, never widen).
type VersionScheme {
  compare: fn(VersionIdentity, VersionIdentity) -> Ordering?
}

type VersionConstraint = NonEmptyStr where brand("VersionConstraint")
