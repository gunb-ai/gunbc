module extdeps.version


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Software_versioning"
  }
}

type VersionIdentity = std.types.NonEmptyStr where brand("VersionIdentity")

type VersionScheme {
  compare: fn(VersionIdentity, VersionIdentity) -> std.algebra.Ordering
}

type VersionConstraint = std.types.NonEmptyStr where brand("VersionConstraint")
