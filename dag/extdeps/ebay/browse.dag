module extdeps.ebay.browse

import std.types { NonEmptyStr, String, Int, Bool, List }
import std.measure { MoneyAmountMicro, money_amount_micro_count }
import std.decimal { fixed_point_wire }
import v2.std.algebra { filter, fold_list }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.coverage { CoverageClosureEntry }
import extdeps.currency.currency { CurrencyCode, currency_alphabetic_code }
import extdeps.ebay.ebay { production_api_base }
import extdeps.ebay.errors { EbayErrorShape }
import extdeps.ebay.inventory {
  ConditionEnum, New, LikeNew, NewOther, NewWithDefects, ManufacturerRefurbished,
  CertifiedRefurbished, ExcellentRefurbished, VeryGoodRefurbished, GoodRefurbished,
  SellerRefurbished, UsedExcellent, UsedVeryGood, UsedGood, UsedAcceptable,
  ForPartsOrNotWorking, PreOwnedExcellent, PreOwnedFair,
  FormatTypeEnum, format_type_wire_label, condition_wire_label
}

// THE BUY-SIDE SCOPE OF THE SAME UPSTREAM. The eBay module family already models the Sell
// Inventory scope; Browse is an additional scope of that one subject, so it lands here beside
// inventory.dag rather than in a second eBay module tree (DESIGN section 3, external upstream
// decomposition). Types carry a `Browse` prefix because bare names resolve corpus-wide and the
// upstream schema names (`Item`, `Image`, `Product`, `Seller`) are generic enough to fork against
// existing declarations; each type names its upstream schema in its own annotation.
//
// PROVENANCE OF THE READ. developer.ebay.com answers HTTP 403 to this repository's fetches, so
// the response shape below was read from eBay's published OpenAPI contract
// buy_browse_v1_oas3.json at info.version 1.20.4 (mirrored in github.com/hendt/ebay-api
// specs/), and the prose facts (call limits, production access, condition IDs, filter grammar)
// from web.archive.org captures of the cited eBay pages taken 2026-05 and 2026-06.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.ebay.com/api-docs/buy/browse/resources/methods"
  }
}

data browse_api_contract_version: NonEmptyStr = "1.20.4"

data browse_buy_requirements_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.ebay.com/api-docs/buy/static/buy-requirements.html"
  }
}

data browse_condition_id_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.ebay.com/api-docs/sell/static/metadata/condition-id-values.html"
  }
}

data browse_field_filters_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.ebay.com/api-docs/buy/static/ref-buy-browse-filters.html"
  }
}

// The subject is the versioned Browse contract; the call limits it is metered by are cited in
// extdeps.ebay.rate_limits beside the other eBay scopes.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ebay.browse",
      decl_name: "browse_api_contract_version",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [browse_buy_requirements_citation, browse_condition_id_citation, browse_field_filters_citation]
}

// PRODUCTION ACCESS IS NOT A PROPERTY OF HOLDING A KEYSET. eBay's Buy APIs Requirements page:
// "Many of the Buy APIs are a (Limited Release). The use of eBay's Buy APIs in production is
// intended for eBay partners only. You must apply for production access through the eBay
// Partner Network ... There is no guarantee that your application for production use of the APIs
// will be approved." The sandbox is open to any developer account and carries no real listings.
// A consumer that reads production listings therefore owes an application whose outcome may be a
// refusal, not only a credential.
type BrowseProductionAccess {
  application_route: NonEmptyStr
  approval_guaranteed: Bool
  sandbox_open_to_any_developer_account: Bool
  authority: ExternalAuthority
}

data browse_production_access: BrowseProductionAccess = BrowseProductionAccess {
  application_route: "eBay Partner Network production-access application for the Buy APIs",
  approval_guaranteed: false,
  sandbox_open_to_any_developer_account: true,
  authority: browse_buy_requirements_citation
}

// search: "Max: 200, Default: 50", and "This method can return a maximum of 10,000 items in one
// results set"; offset must be zero or a multiple of limit.
data browse_search_limit_max: Int = 200

data browse_search_result_window: Int = 10000

// upstream schema ConvertedAmount: the Sell scope's Amount (extdeps.ebay.inventory EbayAmount,
// the same decimal-string value and CurrencyCode currency) plus the pre-conversion pair Buy adds
// when it converts a listing's price into the marketplace currency.
type BrowseConvertedAmount {
  value: String
  currency: CurrencyCode
  convertedFromValue: String?
  convertedFromCurrency: CurrencyCode?
}

// upstream schema Image.
type BrowseImage {
  imageUrl: String
  height: Int?
  width: Int?
}

// upstream schema TypedNameValue: one item-specific aspect (e.g. name "Capacity", value "64GB").
type BrowseTypedNameValue {
  name: String
  value: String
  type: String?
}

// upstream schema Product: the catalog product the listing is matched to, when there is one.
type BrowseProduct {
  title: String?
  brand: String?
  mpns: List<String>?
  gtins: List<String>?
}

// upstream schema Seller (search) and SellerDetail (getItem) share these fields.
type BrowseSeller {
  username: String?
  feedbackPercentage: String?
  feedbackScore: Int?
  sellerAccountType: String?
}

// upstream schema ShippingOptionSummary (search) / ShippingOption (getItem). shippingOptions is
// "only returned if the X-EBAY-C-ENDUSERCTX header is supplied" for calculated shipping, so a
// delivered price needs browse_contextual_location_header on the request.
type BrowseShippingOption {
  shippingCost: BrowseConvertedAmount?
  shippingCostType: String?
  additionalShippingCostPerUnit: BrowseConvertedAmount?
  quantityUsedForEstimate: Int?
  minEstimatedDeliveryDate: String?
  maxEstimatedDeliveryDate: String?
  guaranteedDelivery: Bool?
}

// upstream schema EstimatedAvailability.
type BrowseEstimatedAvailability {
  estimatedAvailabilityStatus: String?
  estimatedAvailableQuantity: Int?
  availabilityThreshold: Int?
  availabilityThresholdType: String?
}

// upstream schema TimeDuration.
type BrowseTimeDuration {
  unit: String
  value: Int
}

// upstream schema ItemReturnTerms.
type BrowseReturnTerms {
  returnsAccepted: Bool?
  returnPeriod: BrowseTimeDuration?
  returnShippingCostPayer: String?
}

// upstream schema ItemLocationImpl (search) / Address (getItem); `country` is ISO 3166 alpha-2.
type BrowseItemLocation {
  country: String?
  stateOrProvince: String?
  postalCode: String?
}

// upstream schema ItemSummary: one search hit. It carries NO item aspects -- no localizedAspects,
// no mpn, no product -- so a compatibility attribute cannot be read from a search page at all; it
// costs one getItem per candidate.
type BrowseItemSummary {
  itemId: NonEmptyStr
  legacyItemId: String?
  title: String?
  itemWebUrl: String?
  price: BrowseConvertedAmount?
  condition: String?
  conditionId: String?
  buyingOptions: List<String>?
  seller: BrowseSeller?
  shippingOptions: List<BrowseShippingOption>?
  itemLocation: BrowseItemLocation?
  image: BrowseImage?
}

