// upstream schema SearchPagedCollection.
type BrowseSearchPagedCollection {
  itemSummaries: List<BrowseItemSummary>?
  total: Int?
  limit: Int?
  offset: Int?
  next: String?
  href: String?
}

data structural_coverage_gap_search_collection_residual: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "BrowseSearchPagedCollection" },
      JsonPending { field: "autoCorrections" },
      JsonPending { field: "prev" },
      JsonPending { field: "refinement" },
      JsonPending { field: "warnings" }
    ],
    trigger: "a Browse consumer requests fieldgroups refinements or auto-correction"
  }
]

// upstream schema Item: the full listing. The compatibility attributes a buyer adjudicates live
// in `localizedAspects`, `mpn` and `product`; the photographs in `image` and `additionalImages`.
type BrowseItem {
  itemId: NonEmptyStr
  legacyItemId: String?
  title: String?
  subtitle: String?
  itemWebUrl: String?
  price: BrowseConvertedAmount?
  condition: String?
  conditionId: String?
  conditionDescription: String?
  buyingOptions: List<String>?
  brand: String?
  mpn: String?
  gtin: String?
  product: BrowseProduct?
  localizedAspects: List<BrowseTypedNameValue>?
  image: BrowseImage?
  additionalImages: List<BrowseImage>?
  lotSize: Int?
  quantityLimitPerBuyer: Int?
  estimatedAvailabilities: List<BrowseEstimatedAvailability>?
  shippingOptions: List<BrowseShippingOption>?
  returnTerms: BrowseReturnTerms?
  seller: BrowseSeller?
  itemLocation: BrowseItemLocation?
  itemEndDate: String?
}

