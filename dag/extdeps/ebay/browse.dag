// NUMERIC CONDITION IDS ARE THE SAME CONCEPT AS THE INVENTORY API'S ConditionEnum, on a different
// wire. eBay's "Item condition ID and name values" table (browse_condition_id_citation) pairs every numeric ID with its ConditionEnum value;
// these rows are that table. MANUFACTURER_REFURBISHED has no numeric ID there, so encoding it
// refuses. Browse returns `conditionId` as a string and says to "gracefully handle any future
// changes to this list", so an unlisted ID decodes to Absent rather than to a guessed condition.
type BrowseConditionIdRow {
  condition_id: Int
  condition: ConditionEnum
}

data browse_condition_id_rows: List<BrowseConditionIdRow> = [
  BrowseConditionIdRow { condition_id: 1000, condition: New },
  BrowseConditionIdRow { condition_id: 1500, condition: NewOther },
  BrowseConditionIdRow { condition_id: 1750, condition: NewWithDefects },
  BrowseConditionIdRow { condition_id: 2000, condition: CertifiedRefurbished },
  BrowseConditionIdRow { condition_id: 2010, condition: ExcellentRefurbished },
  BrowseConditionIdRow { condition_id: 2020, condition: VeryGoodRefurbished },
  BrowseConditionIdRow { condition_id: 2030, condition: GoodRefurbished },
  BrowseConditionIdRow { condition_id: 2500, condition: SellerRefurbished },
  BrowseConditionIdRow { condition_id: 2750, condition: LikeNew },
  BrowseConditionIdRow { condition_id: 2990, condition: PreOwnedExcellent },
  BrowseConditionIdRow { condition_id: 3000, condition: UsedExcellent },
  BrowseConditionIdRow { condition_id: 3010, condition: PreOwnedFair },
  BrowseConditionIdRow { condition_id: 4000, condition: UsedVeryGood },
  BrowseConditionIdRow { condition_id: 5000, condition: UsedGood },
  BrowseConditionIdRow { condition_id: 6000, condition: UsedAcceptable },
  BrowseConditionIdRow { condition_id: 7000, condition: ForPartsOrNotWorking }
]

fn browse_condition_from_id(raw: String) -> ConditionEnum? {
  match filter(xs: browse_condition_id_rows, predicate: fn(r) { to_string(r.condition_id) == raw }).first() {
    Present { value: row } => Present { value: row.condition }
    Absent => none
  }
}

fn browse_condition_id(c: ConditionEnum) -> Int? {
  match filter(xs: browse_condition_id_rows, predicate: fn(r) { condition_wire_label(c: r.condition) == condition_wire_label(c: c) }).first() {
    Present { value: row } => Present { value: row.condition_id }
    Absent => none
  }
}

// THE SEARCH FILTER GRAMMAR, from eBay's "Buy API Field Filters" reference
// (browse_field_filters_citation). Fields are joined by ",";
// a multi-valued field is "{a|b}". The price field "must be used with the priceCurrency filter",
// so the one variant renders both and a price without a currency cannot be written. buyingOptions
// shares its FIXED_PRICE and AUCTION tokens with FormatTypeEnum's wire; BEST_OFFER and
// CLASSIFIED_AD have no variant until a consumer filters on them. The upstream notes buyingOptions
// "is defined at the leaf category level and should be used with a leaf category ID"; search takes
// no category_ids input here until a consumer carries a cited leaf category.
type BrowseSearchFilter
  = BrowsePriceAtMost { max: MoneyAmountMicro, currency: CurrencyCode }
  | BrowseBuyingOptionsAnyOf { formats: List<FormatTypeEnum> }
  | BrowseConditionAnyOf { conditions: List<ConditionEnum> }
  | BrowseDeliveryCountry { country: NonEmptyStr }

type BrowseFilterRender
  = BrowseFilterRendered { param: String }
  | BrowseFilterEmptyValueSet { field: NonEmptyStr }
  | BrowseFilterConditionHasNoId { condition: ConditionEnum }

fn browse_filter_value_set(values: List<String>) -> String {
  join(["{", join(values, "|"), "}"], "")
}

fn browse_render_filter(f: BrowseSearchFilter) -> BrowseFilterRender {
  match f {
    BrowsePriceAtMost { max: m, currency: c } => BrowseFilterRendered {
      param: join(["price:[..", fixed_point_wire(value: money_amount_micro_count(m: m), decimals: 6), "],priceCurrency:", currency_alphabetic_code(c: c)], "")
    }
    BrowseBuyingOptionsAnyOf { formats: fs } => if length(fs) == 0 {
      BrowseFilterEmptyValueSet { field: "buyingOptions" }
    } else {
      BrowseFilterRendered { param: join(["buyingOptions:", browse_filter_value_set(values: map(fs, x => format_type_wire_label(f: x)))], "") }
    }
    BrowseConditionAnyOf { conditions: cs } => if length(cs) == 0 {
      BrowseFilterEmptyValueSet { field: "conditionIds" }
    } else {
      browse_wrap_condition_ids(r: fold_list(
        xs: cs,
        empty: BrowseFilterRendered { param: "" },
        cons: fn(acc, c) {
          match acc {
            BrowseFilterRendered { param: p } => match browse_condition_id(c: c) {
              Present { value: id } => BrowseFilterRendered {
                param: if p == "" { to_string(id) } else { join([p, "|", to_string(id)], "") }
              }
              Absent => BrowseFilterConditionHasNoId { condition: c }
            }
            _ => acc
          }
        }
      ))
    }
    BrowseDeliveryCountry { country: k } => BrowseFilterRendered { param: join(["deliveryCountry:", k as String], "") }
  }
}

fn browse_wrap_condition_ids(r: BrowseFilterRender) -> BrowseFilterRender {
  match r {
    BrowseFilterRendered { param: ids } => BrowseFilterRendered { param: join(["conditionIds:{", ids, "}"], "") }
    _ => r
  }
}

// THE WHOLE `filter` QUERY VALUE: the first refusal wins and no partial filter is ever returned,
// because a dropped field widens the result set silently.
fn browse_render_filters(filters: List<BrowseSearchFilter>) -> BrowseFilterRender {
  fold_list(
    xs: filters,
    empty: BrowseFilterRendered { param: "" },
    cons: fn(acc, f) {
      match acc {
        BrowseFilterRendered { param: p } => match browse_render_filter(f: f) {
          BrowseFilterRendered { param: q } => BrowseFilterRendered {
            param: if p == "" { q } else { join([p, ",", q], "") }
          }
          refused => refused
        }
        _ => acc
      }
    }
  )
}

// X-EBAY-C-ENDUSERCTX: "contextualLocation=country%3DUS%2Czip%3D19406" -- the value is the
// URL-encoded "country=<ISO 3166 alpha-2>,zip=<postal code>". Without it calculated shipping is
// not returned, and a delivered price cannot be formed.
fn browse_contextual_location_header(country: NonEmptyStr, postal_code: NonEmptyStr) -> String {
  join(["contextualLocation=country%3D", country as String, "%2Czip%3D", postal_code as String], "")
}

// Both methods authorize with an application token minted by client_credentials against
// extdeps.ebay.oauth api_scope_root. X-EBAY-C-MARKETPLACE-ID is an input rather than omitted:
// upstream "If the marketplace ID value is invalid or missing, the default value of EBAY_US is
// used", which is a silent substitution a caller must not rely on.
service ebay.Browse {
  config {
    endpoint: production_api_base
    auth: Bearer
    auth_input: access_token
  }

  operation SearchItemSummaries {
    input {
      access_token: Secret
      marketplace_id: NonEmptyStr
      end_user_ctx: String
      q: NonEmptyStr
      filter: String
      limit: Int = browse_search_limit_max
      offset: Int = 0
    }
    output {
      total: Int from "total"
    }
    readonly
    transport rest {
      method: GET,
      path: "/buy/browse/v1/item_summary/search",
      headers: { "X-EBAY-C-MARKETPLACE-ID": marketplace_id, "X-EBAY-C-ENDUSERCTX": end_user_ctx },
      query: { q: q, filter: filter, limit: limit, offset: offset }
    }
    response {
      200 => BrowseSearchPagedCollection
      400 => EbayErrorShape
      409 => EbayErrorShape
      5xx => EbayErrorShape
    }
  }

  operation GetItem {
    input {
      access_token: Secret
      marketplace_id: NonEmptyStr
      end_user_ctx: String
      item_id: NonEmptyStr
    }
    output {
      item_id: NonEmptyStr from "itemId"
    }
    readonly
    transport rest {
      method: GET,
      path: "/buy/browse/v1/item/\{item_id\}",
      headers: { "X-EBAY-C-MARKETPLACE-ID": marketplace_id, "X-EBAY-C-ENDUSERCTX": end_user_ctx }
    }
    response {
      200 => BrowseItem
      400 => EbayErrorShape
      404 => EbayErrorShape
      409 => EbayErrorShape
      5xx => EbayErrorShape
    }
  }
}
