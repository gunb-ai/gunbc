type OfferResponse {
  offerId: NonEmptyStr
  warnings: Json?
}

type PublishResponse {
  listingId: NonEmptyStr
  warnings: Json?
}

type EbayOfferDetailsWithAll {
  offerId: NonEmptyStr
  sku: NonEmptyStr?
  marketplaceId: MarketplaceEnum?
  format: FormatTypeEnum?
  availableQuantity: Int?
  pricingSummary: PricingSummary?
  listing: Json?
}

data structural_coverage_gap_offer_row_residual: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "EbayOfferDetailsWithAll" },
      JsonPending { field: "listing/listingStatus" },
      JsonPending { field: "listing/soldQuantity" },
      JsonPending { field: "status" },
      JsonPending { field: "statusReason" }
    ],
    trigger: "eBay offer consumer needs published-listing status fidelity"
  }
]

type Offers {
  offers: List<EbayOfferDetailsWithAll>?
  total: Int?
  size: Int?
  limit: Int?
  href: String?
  next: String?
  prev: String?
}

data structural_coverage_gap_inventory_operations_residual: List<String> = [
  "modeled operations cover the single-item listing path; the upstream resource set also carries",
  "bulk ops, inventory item groups, listing migration, locations, withdrawOffer, and getListingFees",
  "extend on demand when a consumer needs them"
]

data default_inventory_items_limit: Int = 25

service ebay.Inventory {
  config {
    endpoint: production_api_base
    auth: Bearer
    auth_input: access_token

    rate_limit: { requests: 2000000, per: day, scope: sell_inventory }

    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503] }
  }

  operation CreateOrReplaceInventoryItem {
    input {
      access_token: Secret
      sku: NonEmptyStr
      content_language: NonEmptyStr
      item: InventoryItem
    }
    output {
      warnings: Json from "warnings"
    }
    idempotent
    transport rest {
      method: PUT,
      path: "/sell/inventory/v1/inventory_item/\{sku\}",
      headers: { "Content-Language": content_language, "Content-Type": "application/json" },
      body: { availability: item.availability, condition: item.condition, conditionDescription: item.conditionDescription, product: item.product }
    }
    response {
      200 => BaseResponse
      201 => BaseResponse
      400 => EbayErrorShape
      401 => EbayErrorShape
      403 => EbayErrorShape
      429 => EbayErrorShape
      5xx => EbayErrorShape
    }
  }

  operation GetInventoryItem {
    input {
      access_token: Secret
      sku: NonEmptyStr
    }
    output {
      item_sku: NonEmptyStr from "sku"
    }
    readonly
    transport rest {
      method: GET,
      path: "/sell/inventory/v1/inventory_item/\{sku\}"
    }
    response {
      200 => InventoryItemWithSkuLocaleGroupid
      401 => EbayErrorShape
      404 => EbayErrorShape
      5xx => EbayErrorShape
    }
  }

  operation GetInventoryItems {
    input {
      access_token: Secret
      limit: Int = default_inventory_items_limit
      offset: Int = 0
    }
    output {
      total: Int from "total"
      size: Int from "size"
    }
    readonly
    transport rest {
      method: GET,
      path: "/sell/inventory/v1/inventory_item",
      query: { limit: limit, offset: offset }
    }
    response {
      200 => InventoryItemsWithTotal
      400 => EbayErrorShape
      401 => EbayErrorShape
      5xx => EbayErrorShape
    }
  }

  operation CreateOffer {
    input {
      access_token: Secret
      content_language: NonEmptyStr
      offer: EbayOfferDetailsWithKeys
    }
    output {
      offer_id: NonEmptyStr from "offerId"
    }
    transport rest {
      method: POST,
      path: "/sell/inventory/v1/offer",
      headers: { "Content-Language": content_language, "Content-Type": "application/json" },
      body: { sku: offer.sku, marketplaceId: offer.marketplaceId, format: offer.format, availableQuantity: offer.availableQuantity, categoryId: offer.categoryId, listingDescription: offer.listingDescription, listingDuration: offer.listingDuration, listingPolicies: offer.listingPolicies, pricingSummary: offer.pricingSummary, merchantLocationKey: offer.merchantLocationKey }
    }
    response {
      201 => OfferResponse
      400 => EbayErrorShape
      401 => EbayErrorShape
      403 => EbayErrorShape
      409 => EbayErrorShape
      5xx => EbayErrorShape
    }
  }

  operation GetOffers {
    input {
      access_token: Secret
      sku: NonEmptyStr
    }
    output {
      total: Int from "total"
    }
    readonly
    transport rest {
      method: GET,
      path: "/sell/inventory/v1/offer",
      query: { sku: sku }
    }
    response {
      200 => Offers
      400 => EbayErrorShape
      401 => EbayErrorShape
      404 => EbayErrorShape
      5xx => EbayErrorShape
    }
  }

  operation PublishOffer {
    input {
      access_token: Secret
      offer_id: NonEmptyStr
    }
    output {
      listing_id: NonEmptyStr from "listingId"
    }
    transport rest {
      method: POST,
      path: "/sell/inventory/v1/offer/\{offer_id\}/publish"
    }
    response {
      200 => PublishResponse
      400 => EbayErrorShape
      401 => EbayErrorShape
      404 => EbayErrorShape
      5xx => EbayErrorShape
    }
  }
}
