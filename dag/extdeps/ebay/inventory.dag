module extdeps.ebay.inventory


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.ebay.com/api-docs/sell/inventory/resources/methods"
  }
}

data inventory_api_contract_version: NonEmptyStr = "1.18.5"

type ConditionEnum
  = New
  | LikeNew
  | NewOther
  | NewWithDefects
  | ManufacturerRefurbished
  | CertifiedRefurbished
  | ExcellentRefurbished
  | VeryGoodRefurbished
  | GoodRefurbished
  | SellerRefurbished
  | UsedExcellent
  | UsedVeryGood
  | UsedGood
  | UsedAcceptable
  | ForPartsOrNotWorking
  | PreOwnedExcellent
  | PreOwnedFair

data structural_coverage_gap_condition_codec_hand_rolled: List<String> = [
  "parse_condition and condition_wire_label hand-roll the ScreamingSnakeCase mapping",
  "already declared in condition_wire_contract. Dissolve when the codec-from-contract bridge",
  "derives decode and encode from CoproductWireContract rows directly."
]

fn condition_wire_label(c: ConditionEnum) -> String {
  match c {
    New => "NEW"
    LikeNew => "LIKE_NEW"
    NewOther => "NEW_OTHER"
    NewWithDefects => "NEW_WITH_DEFECTS"
    ManufacturerRefurbished => "MANUFACTURER_REFURBISHED"
    CertifiedRefurbished => "CERTIFIED_REFURBISHED"
    ExcellentRefurbished => "EXCELLENT_REFURBISHED"
    VeryGoodRefurbished => "VERY_GOOD_REFURBISHED"
    GoodRefurbished => "GOOD_REFURBISHED"
    SellerRefurbished => "SELLER_REFURBISHED"
    UsedExcellent => "USED_EXCELLENT"
    UsedVeryGood => "USED_VERY_GOOD"
    UsedGood => "USED_GOOD"
    UsedAcceptable => "USED_ACCEPTABLE"
    ForPartsOrNotWorking => "FOR_PARTS_OR_NOT_WORKING"
    PreOwnedExcellent => "PRE_OWNED_EXCELLENT"
    PreOwnedFair => "PRE_OWNED_FAIR"
  }
}

fn parse_condition(raw: String) -> ConditionEnum? {
  if raw == "NEW" { Present { value: New } }
  else if raw == "LIKE_NEW" { Present { value: LikeNew } }
  else if raw == "NEW_OTHER" { Present { value: NewOther } }
  else if raw == "NEW_WITH_DEFECTS" { Present { value: NewWithDefects } }
  else if raw == "MANUFACTURER_REFURBISHED" { Present { value: ManufacturerRefurbished } }
  else if raw == "CERTIFIED_REFURBISHED" { Present { value: CertifiedRefurbished } }
  else if raw == "EXCELLENT_REFURBISHED" { Present { value: ExcellentRefurbished } }
  else if raw == "VERY_GOOD_REFURBISHED" { Present { value: VeryGoodRefurbished } }
  else if raw == "GOOD_REFURBISHED" { Present { value: GoodRefurbished } }
  else if raw == "SELLER_REFURBISHED" { Present { value: SellerRefurbished } }
  else if raw == "USED_EXCELLENT" { Present { value: UsedExcellent } }
  else if raw == "USED_VERY_GOOD" { Present { value: UsedVeryGood } }
  else if raw == "USED_GOOD" { Present { value: UsedGood } }
  else if raw == "USED_ACCEPTABLE" { Present { value: UsedAcceptable } }
  else if raw == "FOR_PARTS_OR_NOT_WORKING" { Present { value: ForPartsOrNotWorking } }
  else if raw == "PRE_OWNED_EXCELLENT" { Present { value: PreOwnedExcellent } }
  else if raw == "PRE_OWNED_FAIR" { Present { value: PreOwnedFair } }
  else { none }
}

type FormatTypeEnum
  = Auction
  | FixedPrice

data structural_coverage_gap_format_codec_hand_rolled: List<String> = [
  "parse_format_type and format_type_wire_label hand-roll the ScreamingSnakeCase mapping",
  "already declared in format_type_wire_contract. Dissolve when the codec-from-contract bridge",
  "derives decode and encode from CoproductWireContract rows directly."
]

fn format_type_wire_label(f: FormatTypeEnum) -> String {
  match f {
    Auction => "AUCTION"
    FixedPrice => "FIXED_PRICE"
  }
}

fn parse_format_type(raw: String) -> FormatTypeEnum? {
  if raw == "AUCTION" { Present { value: Auction } }
  else if raw == "FIXED_PRICE" { Present { value: FixedPrice } }
  else { none }
}

type EbayAmount {
  value: String
  currency: CurrencyCode
}

type ShipToLocationAvailability {
  quantity: Int
}

type InventoryItemAvailability {
  shipToLocationAvailability: ShipToLocationAvailability
}

type InventoryItemProduct {
  title: NonEmptyStr
  description: String?
  aspects: Json?
  imageUrls: List<String>?
}

type InventoryItem {
  availability: InventoryItemAvailability?
  condition: ConditionEnum?
  conditionDescription: String?
  product: InventoryItemProduct?
}

