  {
    facts: [
      Subject { path: "InventoryItem" },
      JsonPending { field: "packageWeightAndSize" },
      JsonPending { field: "conditionDescriptors" },
      JsonPending { field: "availability/pickupAtLocationAvailability" },
      JsonPending { field: "product/brand" },
      JsonPending { field: "product/mpn" },
      JsonPending { field: "product/upc" },
      JsonPending { field: "product/isbn" },
      JsonPending { field: "product/ean" },
      JsonPending { field: "product/epid" },
      JsonPending { field: "product/subtitle" },
      JsonPending { field: "product/videoIds" }
    ],
    trigger: "eBay inventory consumer needs full item fidelity (package dimensions, pickup availability, product identifiers)"
  }
]

type InventoryItemWithSkuLocaleGroupid {
  sku: NonEmptyStr
  locale: String?
  condition: ConditionEnum?
  availability: InventoryItemAvailability?
  product: InventoryItemProduct?
}

data structural_coverage_gap_inventory_item_row_residual: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "InventoryItemWithSkuLocaleGroupid" },
      JsonPending { field: "groupIds" },
      JsonPending { field: "inventoryItemGroupKeys" }
    ],
    trigger: "eBay inventory consumer needs item-group (multi-variation listing) fidelity"
  }
]

type InventoryItemsWithTotal {
  inventoryItems: List<InventoryItemWithSkuLocaleGroupid>?
  total: Int?
  size: Int?
  limit: Int?
  href: String?
  next: String?
  prev: String?
}

