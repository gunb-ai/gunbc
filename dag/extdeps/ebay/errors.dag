module extdeps.ebay.errors

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.ebay.ebay_contracts { error_category_wire_contract }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.ebay.com/api-docs/static/handling-error-messages.html"
  }
}

// Reading: eBay's error-handling reference owns the REST error structure; type EbayError transcribes its documented fields (errorId, domain, subdomain, category, message, longMessage, input/outputRefIds, parameters) and is dispatched by the ebay client routes, so the type is the surface this citation owns.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.ebay.errors", decl_name: "EbayError", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type EbayErrorCategory
  = Application
  | Business
  | Request

data structural_coverage_gap_error_category_codec_hand_rolled: List<String> = [
  "parse_error_category and error_category_wire_label hand-roll the ScreamingSnakeCase mapping",
  "already declared in error_category_wire_contract. Dissolve when the codec-from-contract bridge",
  "derives decode and encode from CoproductWireContract rows directly."
]

fn error_category_wire_label(c: EbayErrorCategory) -> String {
  match c {
    Application => "APPLICATION"
    Business => "BUSINESS"
    Request => "REQUEST"
  }
}

fn parse_error_category(raw: String) -> EbayErrorCategory? {
  if raw == "APPLICATION" { Present { value: Application } }
  else if raw == "BUSINESS" { Present { value: Business } }
  else if raw == "REQUEST" { Present { value: Request } }
  else { none }
}

type EbayErrorParameter {
  name: String
  value: String
}

type EbayError {
  errorId: Int
  domain: String
  subdomain: String?
  category: EbayErrorCategory
  message: String
  longMessage: String?
  inputRefIds: List<String>?
  outputRefIds: List<String>?
  parameters: List<EbayErrorParameter>?
}

type EbayErrorShape {
  errors: List<EbayError>
  warnings: List<EbayError>?
}
