module extdeps.procps.kill

import std.types { Int, List, NonEmptyStr, String }
import extdeps.exec.program { ProgramIdentity, uncataloged_program }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, CitedFigureStanding, CitedToAuthority }
import extdeps.uri { Uri, Https }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// procps-ng kill(1): a negative PGID must be separated from options by `--`. In procps-ng 4.0.4,
// `kill -TERM -<pgid>` returns 0 and signals nothing — the `-<pgid>` token is consumed as another
// option, not as a process-group operand. The form that reaches the group is
// `kill -TERM -- -<pgid>`. THIS MODULE OWNS THAT UPSTREAM BEHAVIOUR. A host row says which procps-ng
// version that host has.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "gitlab.com/procps-ng/procps/-/blob/master/man/kill.1"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.procps.kill",
      decl_name: "procps_ng_kill_term_pgid_argv",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

fn procps_kill_standing() -> CitedFigureStanding {
  CitedToAuthority { authority: extdeps_external_authority_anchor }
}

fn kill_program() -> ProgramIdentity = uncataloged_program(invocation: "/usr/bin/kill")

fn procps_ng_kill_term_pgid_argv(pgid: Int) -> List<String> {
  ["kill", "-TERM", "--", concat("-", to_string(pgid))]
}

fn procps_ng_kill_term_pgid_without_end_of_options_argv(pgid: Int) -> List<String> {
  ["kill", "-TERM", concat("-", to_string(pgid))]
}
