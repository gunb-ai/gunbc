module extdeps.virtualization.qemu

import std.types { Bool, String, NonEmptyStr, FilePath }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.exec.program { ProgramIdentity, uncataloged_program }
import extdeps.os.ubuntu_ports_archive { UbuntuArchiveBinaryPackage }

// QEMU IS AN INDEPENDENTLY VERSIONED UPSTREAM (qemu.org), so it owns its own extdeps module beside
// extdeps.virtualization.firecracker rather than sharing a generic "vmm" hub (DESIGN 3, external
// upstream decomposition). The names kept are QEMU's own: the system emulator binary for the arm64
// guest is `qemu-system-aarch64`, and its version banner is "QEMU emulator version <x.y.z>".
//
// THE UPSTREAM VERSION AND THE DISTRIBUTION BUILD ARE TWO FACTS. The binary on an Ubuntu host is
// Ubuntu's build of an upstream release, shipped in the package `qemu-system-arm` (which carries
// qemu-system-aarch64). The upstream version fixes the behaviour QEMU documents; the package
// version and its archive digest fix the exact bytes. A row naming only "8.2.2" would not identify
// which build a host ran.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.qemu.org/docs/master/system/arm/virt.html",
  }
}

// The Ubuntu archive's arm64 Packages index for noble-updates, read 2026-09-30, is where the
// package row below was transcribed from: Package qemu-system-arm, Version 1:8.2.2+ds-0ubuntu1.18,
// Filename pool/main/q/qemu/qemu-system-arm_8.2.2+ds-0ubuntu1.18_arm64.deb, SHA256 3f702445....
data qemu_noble_packages_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "ports.ubuntu.com/ubuntu-ports/dists/noble-updates/main/binary-arm64/Packages.gz",
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.virtualization.qemu",
      decl_name: "qemu_8_2_2_ubuntu_noble_arm64",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [qemu_noble_packages_authority],
}

// The installed_binary is the path INSIDE the package (its data member), not a claim about where a
// host carries it: a consumer that extracts the archive under a root reads it at <root><path>.
// THE INSTALLED IDENTITY IS A DIGEST, NOT A BANNER. A banner establishes what a binary REPORTS; the
// sha256 of the file the package installs establishes WHICH bytes are there. Both were read
// 2026-09-30 from the archive below after it matched the Packages index SHA256: dpkg-deb -x, then
// sha256sum of usr/bin/qemu-system-aarch64, and the exact banner string the binary carries.
type QemuDistributionBuild {
  upstream_version: NonEmptyStr
  archive: UbuntuArchiveBinaryPackage
  installed_binary: FilePath
  installed_binary_sha256: NonEmptyStr
  version_banner: NonEmptyStr
}

data qemu_8_2_2_ubuntu_noble_arm64: QemuDistributionBuild = QemuDistributionBuild {
  upstream_version: "8.2.2",
  archive: UbuntuArchiveBinaryPackage {
    package: "qemu-system-arm",
    version: "1:8.2.2+ds-0ubuntu1.18",
    architecture: "arm64",
    filename: "pool/main/q/qemu/qemu-system-arm_8.2.2+ds-0ubuntu1.18_arm64.deb",
    sha256: "3f7024459848a11bd171045da5d3c8f2e0a93e67e5651ab6b164f45bad954200",
  },
  installed_binary: "/usr/bin/qemu-system-aarch64",
  installed_binary_sha256: "e19e11bd054ccf0f3cfcea8e0acdcc4288de6abd2ed6c30f743092c362eb2673",
  version_banner: "QEMU emulator version 8.2.2 (Debian 1:8.2.2+ds-0ubuntu1.18)",
}

// The system emulator for an AArch64 guest, invoked at the path whose digest is being judged, so
// the banner read and the bytes hashed are the same file rather than whatever PATH resolves.
fn qemu_system_aarch64_program(binary: FilePath) -> ProgramIdentity = uncataloged_program(invocation: binary as NonEmptyStr)

fn qemu_version_command(binary: FilePath) -> ArgvCommand {
  argv_command(program: qemu_system_aarch64_program(binary: binary), arguments: ["--version"])
}

// The first line `--version` prints is judged EXACTLY against version_banner: a banner that merely
// starts with the upstream version, or merely contains the package version, is a different string.
fn qemu_banner_is_pinned(build: QemuDistributionBuild, banner: String) -> Bool {
  banner == (build.version_banner as String)
}
// accel=kvm opens the host's KVM device (QEMU docs, system/introduction "Virtualisation
// Accelerators": KVM on Linux hosts). The device is the kernel's; this row is QEMU's requirement
// of it, stated where QEMU is modeled so the observe reads QEMU's requirement and not Firecracker's.
data qemu_kvm_accelerator_device: FilePath = "/dev/kvm"
