module extdeps.virtualization.firecracker

import extdeps.exec.command { ArgvCommand, argv_command }
import std.types { String, NonEmptyStr, Int, Bool, List, FilePath }
import std.disposition { Disposition, Terminal }
import std.measure { ByteSize, byte_size, HardwareThreadCount, hardware_thread_count, hardware_thread_count_value }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.languages.json.emit {
  JsonValue, json_kv, json_string, json_int, json_bool, json_array, json_object, serialize_json,
}

// FIRECRACKER IS AN INDEPENDENTLY VERSIONED UPSTREAM, so it owns its own extdeps module and its
// real names are kept (DESIGN section 3). The configuration surface below is Firecracker's OWN
// vocabulary -- boot-source, drives, network-interfaces, machine-config -- not a nickname for it,
// and the field names are the ones its API accepts. A generic "vm config" hub that enumerated
// Firecracker beside another VMM would be the external-decomposition violation: two independently
// governed products under one authority.
data firecracker_authority_disposition: Disposition = Terminal {
  reason: "Single authority for the Firecracker VMM's configuration surface and its host requirements. It models what the upstream API accepts; it does NOT decide what a runner VM should contain, which is a product fact owned downstream."
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "github.com/firecracker-microvm/firecracker/blob/main/docs/getting-started.md",
  }
}

// THE VERSION IS DECLARED RATHER THAN FLOATING, and the architecture is part of the identity: the
// release artifact is per-arch, so a row that named only the version would not identify a binary.
type FirecrackerRelease {
  version: NonEmptyStr
  arch: NonEmptyStr
}

data firecracker_release_aarch64: FirecrackerRelease = FirecrackerRelease {
  version: "v1.16.1",
  arch: "aarch64",
}

// THE vCPU RANGE THE PINNED RELEASE ACCEPTS, AS UPSTREAM STATES IT. Firecracker's machine
// configuration admits `vcpu_count` in 1..=32 (docs/api_requests: "Number of vCPUs (either 1 or
// an even number)" was the pre-1.0 wording; the current MachineConfig schema constrains the field
// to minimum 1, maximum 32, and the VMM refuses a PUT /machine-config outside that range before
// any boot). It is a fact about this RELEASE and lives beside its row, so a consumer that admits
// a guest topology can refuse a count the VMM would refuse, rather than discovering it at boot as
// an API error. A later release that widens the range changes this row and nothing downstream.
// THE BOUNDS RIDE THE SAME CARRIER AS THE COUNT THEY BOUND: std.measure HardwareThreadCount, the
// one place a vCPU count lives in this corpus (extdeps.cloud.hetzner and extdeps.github.hosted_runners
// read vendor vCPU figures onto it the same way). The API field itself stays the bare Int upstream's
// schema declares (FirecrackerMachineConfig.vcpu_count); the boundary conversion is one call, here.
type FirecrackerVcpuRange {
  of_release: FirecrackerRelease
  minimum: HardwareThreadCount
  maximum: HardwareThreadCount
}

data firecracker_vcpu_range_v1_16_1: FirecrackerVcpuRange = FirecrackerVcpuRange {
  of_release: firecracker_release_aarch64,
  minimum: hardware_thread_count(count: 1),
  maximum: hardware_thread_count(count: 32),
}

type FirecrackerVcpuAdmission
  = VcpuCountAdmitted { count: HardwareThreadCount }
  | VcpuCountUnsupported { requested: HardwareThreadCount, minimum: HardwareThreadCount, maximum: HardwareThreadCount }

fn firecracker_vcpu_count_admission(range: FirecrackerVcpuRange, count: HardwareThreadCount) -> FirecrackerVcpuAdmission {
  let n = hardware_thread_count_value(t: count)
  if n < hardware_thread_count_value(t: range.minimum) || n > hardware_thread_count_value(t: range.maximum) {
    VcpuCountUnsupported { requested: count, minimum: range.minimum, maximum: range.maximum }
  } else {
    VcpuCountAdmitted { count: count }
  }
}

// THE HOST REQUIREMENT IS ONE FACT AND IT IS NOT NEGOTIABLE. Upstream states it as read/write
// access to /dev/kvm exposed by the KVM module. Modeled as a datum rather than prose because a
// consumer must be able to refuse on it, and prose cannot be read by an Accepted program.
data firecracker_requires_kvm_device: FilePath = "/dev/kvm"
// The group udev hands /dev/kvm to on Ubuntu (50-udev-default.rules: KERNEL=="kvm", GROUP="kvm",
// MODE="0660"); a process that is not a member cannot open the device.
data kvm_device_group: NonEmptyStr = "kvm" as NonEmptyStr

// THE RELEASE ARTIFACT IS IDENTIFIED BY VERSION, ARCHITECTURE AND DIGEST, all three read from the
// upstream release page on 2026-09-05: firecracker-v1.16.1-aarch64.tgz and the sha256 upstream
// publishes beside it. The tarball unpacks to release-<version>-<arch>/firecracker-<version>-<arch>.
fn firecracker_release_tarball_filename(rel: FirecrackerRelease) -> String {
  join(["firecracker-", rel.version as String, "-", rel.arch as String, ".tgz"], "")
}

fn firecracker_release_download_url(rel: FirecrackerRelease) -> String {
  join([
    "https://github.com/firecracker-microvm/firecracker/releases/download/",
    rel.version as String, "/", firecracker_release_tarball_filename(rel: rel),
  ], "")
}

fn firecracker_release_binary_path_in_tarball(rel: FirecrackerRelease) -> String {
  join([
    "release-", rel.version as String, "-", rel.arch as String,
    "/firecracker-", rel.version as String, "-", rel.arch as String,
  ], "")
}

data firecracker_release_aarch64_tarball_sha256: NonEmptyStr = "8d0e69f6d6f9a1724551f607f18504052c16c1828ee3d4d7b6e6c73380871e0e" as NonEmptyStr

// `firecracker --version` prints `Firecracker v<version>` on its first line; the readback compares
// the modeled version against that line rather than trusting a path.
fn firecracker_version_command(binary: String) -> ArgvCommand {
  argv_command(program: binary as NonEmptyStr, arguments: ["--version"])
}

fn firecracker_version_line(rel: FirecrackerRelease) -> String {
  join(["Firecracker ", rel.version as String], "")
}

// THE VENDOR'S CI GUEST ARTIFACTS ARE A CITED SMOKE IMAGE, NOT THE RUNNER GUEST IMAGE. Upstream
// publishes a kernel and an Ubuntu 24.04 rootfs per architecture for its own CI; they prove that a
// host can boot a Firecracker guest, and nothing about what a runner guest should contain (that is
// gunbc.runner_microvm's RunnerGuestImage). Digests are not published beside them (the manifest is
// a package list), so these carry URL identity only -- a declared gap, refused rather than
// fabricated: a consumer needing integrity must pin a digest it measured.
data firecracker_ci_artifacts_prefix: String = "https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.12/aarch64/"

data firecracker_ci_smoke_kernel_url: String = "https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.12/aarch64/vmlinux-6.1.128"

data firecracker_ci_smoke_rootfs_url: String = "https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.12/aarch64/ubuntu-24.04.squashfs"

// SUPPORTED GUEST ARCHITECTURES, AS A CLOSED SET. Upstream supports exactly x86_64 and aarch64;
// an open string here would admit a target Firecracker cannot boot and defer the refusal to
// runtime, which is the state-space conflation DESIGN section 4b asks construction to close.
type FirecrackerArch
  = FirecrackerX86_64
  | FirecrackerAarch64

fn firecracker_arch_label(a: FirecrackerArch) -> String {
  match a {
    FirecrackerX86_64 => "x86_64"
    FirecrackerAarch64 => "aarch64"
  }
}

// --- the configuration surface, in upstream's own shape ---

// The kernel is an UNCOMPRESSED image and the boot args are the guest kernel's, not Firecracker's.
type FirecrackerBootSource {
  kernel_image_path: FilePath
  boot_args: NonEmptyStr
}

// A DRIVE IS EXPOSED TO THE GUEST IN WHOLE 512-BYTE SECTORS, AND A PARTIAL TAIL IS DROPPED.
// firecracker v1.16.1 src/vmm/src/devices/virtio/block/virtio/mod.rs: SECTOR_SIZE = 1 << SECTOR_SHIFT
// (9). device.rs, on opening the backing file: "If the image is not a multiple of the sector size,
// the tail bits are not exposed" -- it logs a warning and the guest sees the size rounded down. A
// backing file whose content matters to its last byte must therefore be a whole number of these.
data firecracker_block_sector_size: ByteSize = byte_size(count: 512)

// A drive is identified by a caller-chosen id and is EITHER the root device or not. Upstream lets
// both flags be set independently; modelling is_root_device as a Bool beside is_read_only keeps
// the upstream shape rather than inventing a coproduct the API does not have.
type FirecrackerDrive {
  drive_id: NonEmptyStr
  path_on_host: FilePath
  is_root_device: Bool
  is_read_only: Bool
}

// host_dev_name is the HOST's tap device. The guest MAC is caller-assigned; upstream generates one
// when it is absent, but an unassigned MAC is not a fact a consumer can plan against, so this
// model requires it and leaves absence to a caller that has no interface at all.
type FirecrackerNetworkInterface {
  iface_id: NonEmptyStr
  host_dev_name: NonEmptyStr
  guest_mac: NonEmptyStr
}

// vcpu_count and mem_size_mib are CARDINALITIES, not unit-bearing magnitudes in the std.measure
// sense -- mem_size_mib carries its unit in the upstream field name, which this module preserves
// rather than converting, because converting would make the row disagree with what the API accepts.
type FirecrackerMachineConfig {
  vcpu_count: Int
  mem_size_mib: Int
}

type FirecrackerVmConfig {
  boot_source: FirecrackerBootSource
  drives: List<FirecrackerDrive>
  network_interfaces: List<FirecrackerNetworkInterface>
  machine_config: FirecrackerMachineConfig
}

// EXACTLY ONE ROOT DEVICE IS AN UPSTREAM RULE, and it is checkable from the config alone. A config
// with none does not boot and a config with two is ambiguous; both are refusals a consumer can
// make before a VM is ever started, so this is the decidable fragment that belongs here rather
// than a runtime discovery.
fn firecracker_root_drive_count(config: FirecrackerVmConfig) -> Int {
  count(filter(config.drives, d => d.is_root_device))
}

fn firecracker_config_has_single_root(config: FirecrackerVmConfig) -> Bool {
  firecracker_root_drive_count(config: config) == 1
}

// WHICH GUEST DEVICE A DRIVE BECOMES IS ITS POSITION IN `drives`. Firecracker attaches the
// virtio-blk devices in the order of the configuration's drives array, and the Linux virtio_blk
// driver names them vda, vdb, ... in the order it probes them (virtblk_name_format). On this fleet's
// aarch64 hosts that order was observed, not only read: the Mt. Collins run
// (gunbc.runner.runner_first_job_receipt execution_chain) booted root=/dev/vda and read its second
// drive's credential off /dev/vdb. Only the first 26 drives are named here; a drive beyond them, or
// one that is not attached, has no name rather than a guessed one.
type DriveIndexScan {
  next: Int
  found: Int?
}

data firecracker_guest_block_letters: String = "abcdefghijklmnopqrstuvwxyz"

fn firecracker_guest_block_device_of_index(index: Int) -> String? {
  if index >= string_length(s: firecracker_guest_block_letters) {
    none
  } else {
    Present { value: concat("/dev/vd", substring(s: firecracker_guest_block_letters, start: index, end: index + 1)) }
  }
}

fn firecracker_drive_guest_device(drives: List<FirecrackerDrive>, drive_id: NonEmptyStr) -> String? {
  let scan = fold(drives, init: DriveIndexScan { next: 0, found: none }, f: fn(acc, d) {
    let found = match acc.found {
      Present { value: i } => Present { value: i }
      Absent => if d.drive_id == drive_id { Present { value: acc.next } } else { none }
    }
    DriveIndexScan { next: acc.next + 1, found: found }
  })
  match scan.found {
    Absent => none
    Present { value: i } => firecracker_guest_block_device_of_index(index: i)
  }
}

// --- the configuration FILE, which is upstream's own wire shape and not a rendering of ours ---

// FIRECRACKER READS ONE JSON DOCUMENT WHOSE KEYS ARE HYPHENATED WHERE THE API PATHS ARE. The
// `--config-file` document spells `boot-source`, `network-interfaces` and `machine-config` with
// hyphens, while the MEMBER names inside each are the underscore field names the API accepts. That
// asymmetry is upstream's, and it is reproduced here rather than normalized: a model that tidied it
// would disagree with what the binary parses, which is the one thing an extdeps module may not do.
//
// THIS IS THE SAME ROWS READ IN THE OTHER DIRECTION, not a second authority for what a VM is. The
// types above say what a Firecracker configuration IS; this says how that value is spelled on the
// wire. A hand-authored JSON template beside them would be a second spelling of one VM, and the two
// would drift the moment either moved.
fn firecracker_boot_source_json(b: FirecrackerBootSource) -> JsonValue {
  json_object(members: [
    json_kv(key: "kernel_image_path", value: json_string(s: b.kernel_image_path as String)),
    json_kv(key: "boot_args", value: json_string(s: b.boot_args as String)),
  ])
}

fn firecracker_drive_json(d: FirecrackerDrive) -> JsonValue {
  json_object(members: [
    json_kv(key: "drive_id", value: json_string(s: d.drive_id as String)),
    json_kv(key: "path_on_host", value: json_string(s: d.path_on_host as String)),
    json_kv(key: "is_root_device", value: json_bool(b: d.is_root_device)),
    json_kv(key: "is_read_only", value: json_bool(b: d.is_read_only)),
  ])
}

fn firecracker_network_interface_json(n: FirecrackerNetworkInterface) -> JsonValue {
  json_object(members: [
    json_kv(key: "iface_id", value: json_string(s: n.iface_id as String)),
    json_kv(key: "host_dev_name", value: json_string(s: n.host_dev_name as String)),
    json_kv(key: "guest_mac", value: json_string(s: n.guest_mac as String)),
  ])
}

fn firecracker_machine_config_json(m: FirecrackerMachineConfig) -> JsonValue {
  json_object(members: [
    json_kv(key: "vcpu_count", value: json_int(n: m.vcpu_count)),
    json_kv(key: "mem_size_mib", value: json_int(n: m.mem_size_mib)),
  ])
}

fn firecracker_vm_config_json(config: FirecrackerVmConfig) -> JsonValue {
  json_object(members: [
    json_kv(key: "boot-source", value: firecracker_boot_source_json(b: config.boot_source)),
    json_kv(key: "drives", value: json_array(elements: map(config.drives, d => firecracker_drive_json(d: d)))),
    json_kv(
      key: "network-interfaces",
      value: json_array(elements: map(config.network_interfaces, n => firecracker_network_interface_json(n: n))),
    ),
    json_kv(key: "machine-config", value: firecracker_machine_config_json(m: config.machine_config)),
  ])
}

fn firecracker_vm_config_document(config: FirecrackerVmConfig) -> String {
  serialize_json(v: firecracker_vm_config_json(config: config))
}

// `--no-api` IS PART OF THE OPERATION, NOT A TUNING FLAG. Without it Firecracker starts, binds its
// API socket and WAITS for an InstanceStart request that nobody here sends; the process would sit
// there until the step's timeout and the run would report a hang rather than a boot. With it the
// binary boots the configuration it was handed and exits when the guest powers off, which is the
// lifetime a per-job VM has. A caller cannot reach the waiting form through this builder.
//
// THE GUEST'S SERIAL CONSOLE ARRIVES ON THIS PROCESS'S STDOUT, which is what makes the console
// observable from outside the VM at all: the boot args carry `console=ttyS0`, Firecracker attaches
// that port to its own stdout, and a caller capturing this command's output is reading the guest.
fn firecracker_run_config_command(binary: String, config_path: String) -> ArgvCommand {
  argv_command(
    program: binary as NonEmptyStr,
    arguments: ["--no-api", "--config-file", config_path],
  )
}

// `--cgroup-version` SELECTS AN IMPLEMENTATION, IT DOES NOT PLACE A PROCESS. Upstream documents
// the flag; a live run showed the VMM still at cgroup 0::/ when the supervisor never joined a
// leaf. Treating the flag as placement would re-author the unbounded-attempt defect.
data firecracker_jailer_cgroup_version_2: String = "2"

// THE `--` IS THE BOUNDARY BETWEEN JAILER FLAGS AND VMM FLAGS. Everything after it is what
// Firecracker would have taken on a direct exec, including `--no-api` (without which the VMM
// binds its API socket and waits). Config paths here are INSIDE the jail after pivot: a host
// path would fail open as a missing artifact rather than as the containment boundary working.
fn firecracker_jailer_run_command(
  jailer_binary: String,
  jailer_id: String,
  exec_file: String,
  uid: Int,
  gid: Int,
  chroot_base_dir: String,
  config_path_in_jail: String,
) -> ArgvCommand {
  argv_command(
    program: jailer_binary as NonEmptyStr,
    arguments: [
      "--id", jailer_id,
      "--exec-file", exec_file,
      "--uid", to_string(uid),
      "--gid", to_string(gid),
      "--chroot-base-dir", chroot_base_dir,
      "--cgroup-version", firecracker_jailer_cgroup_version_2,
      "--",
      "--no-api",
      "--config-file", config_path_in_jail,
    ],
  )
}

// THE JAILER'S CHROOT ROOT ON THE HOST is `<chroot-base-dir>/<exec-file-basename>/<id>/root`.
// Upstream creates that tree and pivots into `root`; config `path_on_host` values are then
// names inside that root (`/work.img`), while the supervisor still has to CREATE the files
// at the host path below. The basename is the last `/`-separated segment of `--exec-file`.
fn firecracker_jailer_exec_file_basename(exec_file: String) -> String {
  fold(split(s: exec_file, delimiter: "/"), init: "", f: (acc, seg) => if seg == "" { acc } else { seg })
}

fn firecracker_jailer_chroot_root(
  chroot_base_dir: String,
  exec_file: String,
  jailer_id: String,
) -> String {
  join([
    chroot_base_dir,
    "/",
    firecracker_jailer_exec_file_basename(exec_file: exec_file),
    "/",
    jailer_id,
    "/root",
  ], "")
}
