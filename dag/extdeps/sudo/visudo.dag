// THE VISUDO (SUDOERS-VALIDATE) OPERATION. Three consumers validate sudoers files with the same
// two elevated commands -- the deploy preamble's staged and installed drop-in checks (W1) and the
// microVM-controller install's staged check (W5) -- and each spelled the argv as shell text. This
// module is the single owner of the two typed commands, so a change to how the validate command
// renders reaches every consumer at once.

// BOTH COMMANDS ARE ELEVATED, and the elevation lives in the argv: /usr/bin/sudo, its -n, the
// visudo binary by absolute path. visudo is an ARGUMENT to sudo, not a program this repository
// execs, so it carries no ProgramIdentity row and no program-roster entry -- the shape the
// extdeps.systemd.systemctl daemon-reload op already records.
//
// THE BINARY PATH IS THE SINGLE AUTHORITY for /usr/sbin/visudo. gunbc.fleet.fleet_posix_accounts
// derives fleet_visudo_binary_path from this row, so the value is spelled once and the fleet
// roster cannot disagree with it.

module extdeps.sudo.visudo

import std.types { NonEmptyStr, String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.sudo.elevation { sudo_program, sudo_non_interactive_flag }

// visudo(8) is the authority for the flag vocabulary: -c check-only pass, -f names the file,
// -O/-P enforce the default owner and mode.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.sudo.ws/docs/man/visudo.man/"
  }
}
data visudo_authority: ExternalAuthority = extdeps_external_authority_anchor

data visudo_binary_path: NonEmptyStr = "/usr/sbin/visudo"
data visudo_binary_name: NonEmptyStr = "visudo"

// -cf is the SINGLE combined word, not two words: the shell builder the swap replaces spelled it
// `-cf`, and the op must render the argv the shell rendered, byte for byte.
fn visudo_check_command(file: String) -> ArgvCommand {
  argv_command(
    program: sudo_program(),
    arguments: [
      sudo_non_interactive_flag as String,
      visudo_binary_path as String,
      "-cf",
      file,
    ],
  )
}

// -c -O -P -f as four separate words: -O and -P are independent enforcement rules (owner, mode)
// with no combined form in visudo(8). The check runs on the INSTALLED file, where the ownership it
// enforces is the fact under test.
fn visudo_policy_check_command(file: String) -> ArgvCommand {
  argv_command(
    program: sudo_program(),
    arguments: [
      sudo_non_interactive_flag as String,
      visudo_binary_path as String,
      "-c",
      "-O",
      "-P",
      "-f",
      file,
    ],
  )
}
