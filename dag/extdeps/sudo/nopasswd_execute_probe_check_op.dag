module extdeps.sudo.nopasswd_execute_probe_check_op

import std.types { NonEmptyStr, Bool, Int, List, Unit }
import extdeps.sudo.nopasswd_execute_probe {
  SudoNopasswdExecuteProbeShape,
  SudoNopasswdGrantListProbeShape,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.algebra { length }
import v2.extdeps.languages.bash_build {
  bash_build_command_from_lits,
  bash_build_pipe,
  bash_build_with_redir,
  bash_build_or_else,
  bash_build_subshell_from_stmts
}
import v2.std.node { Node }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.sudo.ws/docs/man/sudo.man/"
  }
}

// Typed argv transport for sudo.NopasswdExecuteProbe.Check and sudo.NopasswdGrantList.Read —
// program+args dispatch at the realization edge without shell.Exec.Run (Wave C5 typed-argv
// slice). Grant-list authorization is not inferred from exit zero: sudoers listpw may permit a
// noninteractive list query because some other entry is NOPASSWD. The typed observation must also
// contain an exact NOPASSWD row for the requested command path.

fn sudo_nopasswd_execute_probe_argv(probe: SudoNopasswdExecuteProbeShape) -> List<String> {
  ["sudo", "-n", probe.command_path as String, probe.check_argv as String]
}

fn sudo_nopasswd_grant_list_argv() -> List<String> {
  ["sudo", "-n", "-l"]
}

// THE ALL GRANT IS A GRANT OF EVERY COMMAND, and sudo lists it as `ALL`, not as each path: an
// operator principal whose entry is `(ALL) NOPASSWD: ALL` read as holding no roster command, so an
// operator-local deploy refused every grant-list probe after installing the drop-in (srv1 lab apply,
// 2026-10-10; the 2026-10-09 bringup ran as the CI job user for the same reason). Only a run-as of
// every user or of root admits it -- `(gunbc-ntfy) NOPASSWD: ALL` grants nothing as root, so its
// run-as is read rather than stripped. The shell twin (sudo_nopasswd_grant_list_shell_condition)
// admits exactly these run-as spellings.
data sudo_nopasswd_all_grant_runas: List<String> = ["(ALL)", "(ALL : ALL)", "(root)"]

fn sudo_nopasswd_grant_list_line_admits_probe(
  line: String,
  probe: SudoNopasswdGrantListProbeShape,
) -> Bool {
  let parts = split(s: line.trim(), delimiter: "NOPASSWD:")
  if length(xs: parts) != 2 {
    false
  } else {
    match parts.skip(n: 1).first() {
      Present { value: second } =>
        second.trim() == probe as String
          || (second.trim() == "ALL" && match parts.first() {
            Present { value: runas } => any(xs: sudo_nopasswd_all_grant_runas, predicate: r => r == runas.trim())
            Absent => false
          })
      Absent => false
    }
  }
}

fn sudo_nopasswd_grant_list_admits_probe(
  listing: String,
  probe: SudoNopasswdGrantListProbeShape,
) -> Bool {
  any(
    xs: split(s: listing, delimiter: "\n"),
    predicate: fn(line) {
      sudo_nopasswd_grant_list_line_admits_probe(line: line, probe: probe)
    }
  )
}

service sudo.NopasswdExecuteProbe {
  operation Check {
    requires opaque
    input { probe: SudoNopasswdExecuteProbeShape }
    output { success: Bool from "exit_success" }
    readonly

    transport shell {
      argv: ["sudo", "-n", "{probe.command_path}", "{probe.check_argv}"]
    }
    exit {
      0 => Unit
      nonzero => String "sudo nopasswd execute probe failed"
    }
    mock_response {
      0 => { success: true } "hermetic sudo.NopasswdExecuteProbe.Check"
    }
  }
}

service sudo.NopasswdGrantList {
  operation Read {
    requires none
    input {}
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly

    transport shell {
      argv: ["sudo", "-n", "-l"]
    }
    exit {
      0 => Unit
      nonzero => String "sudo nopasswd grant-list read failed"
    }
    mock_response {
      0 => {
        exit_code: 0,
        success: true,
        stdout: "User ghrunner may run the following commands:\n    (ALL) NOPASSWD: /usr/bin/tailscale",
        stderr: ""
      } "hermetic sudo.NopasswdGrantList.Read"
    }
  }
}
