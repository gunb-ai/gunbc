module extdeps.sudo.nopasswd_execute_probe

import std.types { String, NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.sudo.ws/docs/man/sudo.man/"
  }
}

data sudo_nopasswd_execute_probe_note: String = "Non-interactive sudo execute probe: sudo -n <command_path> <check_argv>. Interface shape only — typed argv transport lives in extdeps.sudo.nopasswd_execute_probe_check_op at the realization edge. check_argv is one argv token for command_path (not a shell fragment): fleet roster rows use single-token probes only (--version, --help, -V, version, probe). Multi-token probes require a List<String> shape change, not space-embedding in NonEmptyStr — emit concat and typed argv agree only when check_argv is single-token."

data sudo_nopasswd_grant_list_probe_note: String = "Non-interactive sudoers grant probe: read sudo -n -l (no target binary execution), then require an exact NOPASSWD row for command_path. Used when the binary may be absent before package ensure — exec failure would mis-diagnose absence as a grant miss (review 41039). Exit zero from the list query is not authorization evidence by itself because sudoers listpw may admit listing through a different NOPASSWD entry; extdeps.sudo.nopasswd_execute_probe_check_op owns both the typed read and exact-row parser. Its one-field probe shape is the typed command path itself; the parser, host effect, and callers consume that single authority directly."

type SudoNopasswdExecuteProbeShape {
  command_path: NonEmptyStr
  check_argv: NonEmptyStr
}

type SudoNopasswdGrantListProbeShape = NonEmptyStr where brand("SudoNopasswdGrantListProbeShape")

type SudoNopasswdProbeKind
  = NopasswdExecuteCheck { check_argv: NonEmptyStr }
  | NopasswdGrantListCheck
