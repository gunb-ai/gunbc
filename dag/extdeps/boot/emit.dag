module extdeps.boot.emit


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "refspecs.linuxfoundation.org/elf/gabi4+/ch4.eheader.html"
  }
}

data pixel_writer_payload_digest_label: std.types.NonEmptyStr = "freestanding-elf64-slice-0.5"

data freestanding_load_vaddr: Int = 4194304

data freestanding_phoff: Int = 64

data freestanding_code_file_offset: Int = 120

data freestanding_page_align: Int = 4096

data pixel_writer_code_bytes: List<Int> = [
  72, 184, 0, 128, 11, 0, 0, 0, 0, 0,
  102, 199, 0, 72, 15,
  244,
]

fn freestanding_elf_ident() -> extdeps.formats.elf.types.ElfIdent {
  extdeps.formats.elf.types.ElfIdent {
    mag0: elf_mag0,
    mag1: elf_mag1,
    mag2: elf_mag2,
    mag3: elf_mag3,
    class: ElfClass64,
    data: ElfData2Lsb,
    version: 1,
    osabi: 0,
    abiversion: 0,
  }
}

fn freestanding_elf64_ehdr(code_bytes: List<Int>) -> extdeps.formats.elf.types.Elf64Ehdr {
  extdeps.formats.elf.types.Elf64Ehdr {
    ident: freestanding_elf_ident(),
    file_type: EtExec,
    machine: EmX86_64,
    version: 1,
    entry: freestanding_load_vaddr,
    phoff: freestanding_phoff,
    shoff: 0,
    flags: 0,
    ehsize: elf64_ehdr_size,
    phentsize: elf64_phdr_size,
    phnum: 1,
    shentsize: 0,
    shnum: 0,
    shstrndx: 0,
  }
}

fn freestanding_pt_load_phdr(code_bytes: List<Int>) -> extdeps.formats.elf.segments.Elf64Phdr {
  extdeps.formats.elf.segments.Elf64Phdr {
    segment_type: PtLoad,
    flags: pf_r + pf_x,
    offset: freestanding_code_file_offset,
    vaddr: freestanding_load_vaddr,
    paddr: freestanding_load_vaddr,
    filesz: count(code_bytes),
    memsz: count(code_bytes),
    align: freestanding_page_align,
  }
}

fn emit_freestanding_elf64(code_bytes: List<Int>) -> List<Int> {
  append(
    append(
      extdeps.formats.elf.encode.encode_elf64_ehdr(freestanding_elf64_ehdr(code_bytes)),
      items: extdeps.formats.elf.encode.encode_elf64_phdr(freestanding_pt_load_phdr(code_bytes)),
    ),
    items: code_bytes,
  )
}

fn freestanding_payload_digest(_bytes: List<Int>, _entry: Int) -> std.types.NonEmptyStr {
  pixel_writer_payload_digest_label
}

fn emit_pixel_writer_payload() -> extdeps.boot.freestanding_payload.FreestandingPayloadRef {
  let code = pixel_writer_code_bytes
  let bytes = emit_freestanding_elf64(code)
  let entry = freestanding_load_vaddr
  EmittedPayload {
    digest: freestanding_payload_digest(bytes, entry),
    entry: std.exec_format.EntryPoint { virtual_address: entry },
  }
}

fn witness_vga_base_matches_framebuffer_fact() -> Bool {
  vga_text_mode_base == 753664
}

fn witness_pixel_writer_code_uses_vga_base() -> Bool {
  extdeps.formats.elf.types.byte_at_in_bounds(pixel_writer_code_bytes, 2) == 0
    && extdeps.formats.elf.types.byte_at_in_bounds(pixel_writer_code_bytes, 3) == 128
    && extdeps.formats.elf.types.byte_at_in_bounds(pixel_writer_code_bytes, 4) == 11
}

fn witness_emitted_file_size() -> Bool {
  let bytes = emit_freestanding_elf64(pixel_writer_code_bytes)
  count(bytes) == freestanding_code_file_offset + count(pixel_writer_code_bytes)
}

fn witness_emitted_digest_non_empty() -> Bool {
  match emit_pixel_writer_payload() {
    EmittedPayload { digest: d, entry: _ } => d == pixel_writer_payload_digest_label
    extdeps.boot.freestanding_payload.PrebuiltPayload { digest: _, entry: _ } => false
    extdeps.boot.freestanding_payload.HollowPrebuiltInit { digest: _, entry: _ } => false
  }
}
