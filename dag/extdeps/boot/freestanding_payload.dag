module extdeps.boot.freestanding_payload


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "refspecs.linuxfoundation.org/elf/gabi4+/contents.html"
  }
}

type FreestandingPayloadRef
  = EmittedPayload { digest: std.types.NonEmptyStr, entry: std.exec_format.EntryPoint }
  | PrebuiltPayload { digest: std.types.NonEmptyStr, entry: std.exec_format.EntryPoint }
  | HollowPrebuiltInit { digest: std.types.NonEmptyStr, entry: std.exec_format.EntryPoint }
