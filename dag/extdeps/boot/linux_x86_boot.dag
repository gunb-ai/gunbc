module extdeps.boot.linux_x86_boot


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.boot.freestanding_payload { FreestandingPayloadRef, HollowPrebuiltInit, PrebuiltPayload }
import std.types { List, NonEmptyStr, String }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.kernel.org/doc/html/latest/arch/x86/boot.html"
  }
}

// Reading: www.kernel.org owns the surface this module models, cited by the authority above. The
// module's subject under that citation is its type declaration LinuxX86BootImage, so that is the scope's
// subject and the citation above is its first citation.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.boot.linux_x86_boot",
      decl_name: "LinuxX86BootImage",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type LinuxX86BootImage {
  kernel_digest: NonEmptyStr,
  cmdline: List<String>,
  init: FreestandingPayloadRef,
}

type BootImageOutcome
  = BootImageAccepted { value: LinuxX86BootImage }
  | BootImageRejected { reason: BootImageRejectReason }

type BootImageRejectReason
  = HollowInitNotEmitProof
  | BootImageRejectUnspecified

fn accept_linux_x86_boot_image(img: LinuxX86BootImage) -> BootImageOutcome {
  match img.init {
    HollowPrebuiltInit { digest: _, entry: _ } =>
      BootImageRejected { reason: HollowInitNotEmitProof }
    EmittedPayload { digest: _, entry: _ } => BootImageAccepted { value: img }
    PrebuiltPayload { digest: _, entry: _ } => BootImageAccepted { value: img }
  }
}
