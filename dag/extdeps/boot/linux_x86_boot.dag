module extdeps.boot.linux_x86_boot


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.kernel.org/doc/html/latest/arch/x86/boot.html"
  }
}

type LinuxX86BootImage {
  kernel_digest: std.types.NonEmptyStr,
  cmdline: List<String>,
  init: extdeps.boot.freestanding_payload.FreestandingPayloadRef,
}

type BootImageOutcome
  = BootImageAccepted { value: LinuxX86BootImage }
  | BootImageRejected { reason: BootImageRejectReason }

type BootImageRejectReason
  = HollowInitNotEmitProof
  | BootImageRejectUnspecified

fn accept_linux_x86_boot_image(img: LinuxX86BootImage) -> BootImageOutcome {
  match img.init {
    extdeps.boot.freestanding_payload.HollowPrebuiltInit { digest: _, entry: _ } =>
      BootImageRejected { reason: HollowInitNotEmitProof }
    EmittedPayload { digest: _, entry: _ } => BootImageAccepted { value: img }
    extdeps.boot.freestanding_payload.PrebuiltPayload { digest: _, entry: _ } => BootImageAccepted { value: img }
  }
}
