module extdeps.physics.double_slit

import std.types { String }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doi.org/10.1088/1367-2630/15/3/033018"
  }
}

type BachEtAl2013DoubleSlitExperiment
  = BachEtAl2013DoubleSlit {}

data bach_et_al_2013_double_slit: BachEtAl2013DoubleSlitExperiment = BachEtAl2013DoubleSlit {}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.physics.double_slit",
      decl_name: "bach_et_al_2013_double_slit",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.physics.double_slit.extdeps_external_authority_anchor,
  further_citations: []
}

data double_slit_citation_note: String = "Cited upstream: Bach, R., Pope, D., Liou, S.-H. and Batelaan, H., 'Controlled double-slit electron diffraction', New Journal of Physics volume 15, article 033018, 2013 (doi 10.1088/1367-2630/15/3/033018). Locator is the publisher DOI redirect.\n\nWHAT THIS MODULE OWNS. Apparatus vocabulary for this one experiment and abstract-level cited facts only. It does NOT carry per-band arrival totals, qualitative verdict functions, classical reasoning, lattice law vocabulary, or downstream coverage obligations for missing axes."

data abstract_observed_distributions_note: String = "Abstract verbatim: By placing a movable mask in front of a double-slit to control the transmission through the individual slits, probability distributions for single- and double-slit arrangements were observed."

data per_band_quantitative_gap_note: String = "PER-BAND QUANTITATIVE GAP. The publisher landing page and abstract were reachable at the DOI locator; full-text figure extraction with a declared per-band method was NOT performed in this change. This module therefore carries NO per-band arrival_count rows. A quantitative path-additivity fold over Bach et al. 2013 is blocked pending extractable per-band data — the refusal and mechanism fixture live in gunbc."

data which_path_upstream_gap_note: String = "Bach et al. controlled which SLITS were open, not whether WHICH-PATH information existed. Missing which-path observations are a downstream coverage obligation in gunbc, not an Unobserved property authored here."

data slit_arrangement_note: String = "Mask positions are the experiment control axis from the cited apparatus description."

type SlitArrangement
  = BothSlitsOpen
  | OnlyLeftSlitOpen
  | OnlyRightSlitOpen
  | BothSlitsBlocked

data screen_band_note: String = "Three logically distinguished screen bands for downstream modeling — not fitted coordinates transcribed from figures."

type ScreenBand
  = CentralBand
  | FirstMinimumBand
  | FirstSideMaximumBand

data matched_exposure_note: String = "Matched exposure session type for structural exposure-keying when per-band quantitative rows land with a declared extraction method."

type BachMatchedExposureSession
  = Bach2013MatchedExposureOne {}

data trial_versus_ensemble_grain_note: String = "Trial grain: one localized electron detection at a band. Ensemble grain: accumulated totals across many trials at matched exposure — not carried as numeric rows until figure extraction lands."

data single_electron_note: String = "The cited experiment detects one electron at a time; distributions accumulate from individual arrivals (abstract-level apparatus fact)."
