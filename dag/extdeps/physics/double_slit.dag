data single_electron_note: String = "Detection is one electron at a time; ensemble rows accumulate individual arrivals."

data which_path_refusal_note: String = "Fail-closed arm for the uncited which-path axis."

type WhichPathOutcome
  = WhichPathOutcomeUncited { missing_authority: NonEmptyStr }

fn observed_under_which_path_detection() -> WhichPathOutcome {
  WhichPathOutcomeUncited {
    missing_authority: "a cited which-path or quantum-eraser experiment; extdeps.physics.double_slit models Bach et al. 2013 slit transmission only" as NonEmptyStr,
  }
}
