module extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "doi.org/10.1103/P3783"
  }
}

type ChapmanEtAl1995AtomInterferometerExperiment
  = ChapmanEtAl1995AtomInterferometer {}

data chapman_et_al_1995_atom_interferometer: ChapmanEtAl1995AtomInterferometerExperiment = ChapmanEtAl1995AtomInterferometer {}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path",
