data bach_et_al_2013_citation_note: String = "Cited upstream: Bach, R., Pope, D., Liou, S.-H. and Batelaan, H., 'Controlled double-slit electron diffraction', New Journal of Physics volume 15, article 033018, 2013 (doi 10.1088/1367-2630/15/3/033018). arXiv:1210.6243. WHAT THIS MODULE OWNS: Bach et al. 2013 apparatus vocabulary and source-grounded categorical and buildup observation rows."

data abstract_observed_distributions_note: String = "Abstract verbatim: By placing a movable mask in front of a double-slit to control the transmission through the individual slits, probability distributions for single- and double-slit arrangements were observed."

data raw_count_not_evaluable_note: String = "RAW COUNT PATH ADDITIVITY NOT EVALUABLE. Figures 1 and 2 present normalized probability distributions; the paper sums frames then normalizes. It does not supply a raw matched-exposure per-band arrival triplet for N_both = N_slit_one + N_slit_two. No raw-count observation rows are authored until that grain is grounded."

data which_path_upstream_gap_note: String = "Bach et al. controlled which slits were open, not whether which-path information existed. Missing which-path evidence is a downstream coverage obligation in gunbc."

data slit_mask_note: String = "Mask can block slit 1, slit 2, both, or neither (figure caption). BothSlitsBlocked is an apparatus configuration only — not an arrival observation."

type SlitMaskConfiguration
  = BothSlitsOpen
  | SlitOneOpen
  | SlitTwoOpen
  | BothSlitsBlocked

data single_electron_rate_note: String = "Paper states roughly one detected electron per second and only one electron in the apparatus at a time."

data trial_versus_ensemble_grain_note: String = "Trial grain: one localized detection event. Ensemble grain: accumulated buildup panels and summed normalized distributions."

type BachDistributionObservation
  = SlitOneSingleSlitDiffractionObserved
  | SlitTwoSingleSlitDiffractionObserved
  | BothSlitsDoubleSlitDiffractionObserved

data bach_slit_one_single_slit_diffraction_observed: BachDistributionObservation = SlitOneSingleSlitDiffractionObserved

data bach_slit_two_single_slit_diffraction_observed: BachDistributionObservation = SlitTwoSingleSlitDiffractionObserved

data bach_both_slits_double_slit_diffraction_observed: BachDistributionObservation = BothSlitsDoubleSlitDiffractionObserved

data bach_distribution_observations: List<BachDistributionObservation> = [
  bach_slit_one_single_slit_diffraction_observed,
  bach_slit_two_single_slit_diffraction_observed,
  bach_both_slits_double_slit_diffraction_observed,
]

type PatternStatus
  = PatternNotYetDiscernible
  | PatternDiscernible
  | PatternClearlyVisible

type BachBuildupObservationRow {
  apparatus: BachEtAl2013DoubleSlitExperiment
  detected_electrons: NonNegativeInt
  pattern_status: PatternStatus
}

