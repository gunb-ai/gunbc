module extdeps.currency.currency

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.iso.org/iso-4217-currency-codes.html"
  }
}

data iso_4217_version_note: String = "ISO 4217:2015 authority for std.currency.CurrencyCode and currency_minor_unit_exponent. Cited minor-unit rows land here once std-over-extdeps layering allows std to consume extdeps without a parallel table in dag/std."
