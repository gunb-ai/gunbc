module extdeps.currency.currency


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.iso.org/iso-4217-currency-codes.html"
  }
}

// ISO 4217:2015 authority for std.currency.CurrencyCode and currency_minor_unit_exponent.
data iso_4217_cited_rows_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "std.currency",
    decl_name: "currency_minor_unit_exponent",
    field: std.decl_ref.WholeDeclaration
  }
}
