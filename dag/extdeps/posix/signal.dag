// TerminateProcess sends SIGTERM only. The reaper's bound is at the CALLER (residual
// reap only ever names a pid it read out of an inactive unit's own cgroup.procs, per
// gunbc.host_hygiene_reaper_remediate) rather than at the signal — this service does not
// accept an arbitrary signal name, and does not accept a process group or -1/0 pid, which
// is the shape that turns "kill one pid" into "kill everything the caller can reach".
//
// KillProcess sends SIGKILL, and it is a SECOND operation rather than a signal parameter on the
// first, so a caller that holds only the graceful arm cannot reach the forced one by changing a
// value. Its one consumer is the bounded force-stop of gunbc.runner_microvm_lifecycle_realize,
// which names a pid read out of the attempt's own cgroup subtree after SIGTERM and its bound have
// been given, and which reads the subtree back afterwards rather than believing this exit: kill(2)
// reports delivery, not death, and a task in uninterruptible sleep is delivered SIGKILL and does
// not die. The reaper stays on TerminateProcess; nothing here changes its bound.
service posix.Signal {
  operation TerminateProcess {
    input { pid: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["kill", "-TERM", "{pid}"] }
    exit {
      0 => Unit
      nonzero => String "kill -TERM failed"
    }
    mock_response {
      0 => { success: true, stderr: "" } "hermetic posix.Signal.TerminateProcess"
    }
  }
  operation KillProcess {
    input { pid: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["kill", "-KILL", "{pid}"] }
    exit {
      0 => Unit
      nonzero => String "kill -KILL failed"
    }
    mock_response {
      0 => { success: true, stderr: "" } "hermetic posix.Signal.KillProcess"
    }
  }
}
