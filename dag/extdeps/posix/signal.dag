  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/kill.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.posix.signal",
      decl_name: "posix.Signal",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// TerminateProcess sends SIGTERM only. The reaper's bound is at the CALLER (residual
// reap only ever names a pid it read out of an inactive unit's own cgroup.procs, per
// gunbc.host.host_hygiene_reaper_remediate) rather than at the signal — this service does not
// widen to SIGKILL, does not accept an arbitrary signal name, and does not accept a
// process group or -1/0 pid, which is the shape that turns "kill one pid" into "kill
// everything the caller can reach".
service posix.Signal {
  operation TerminateProcess {
    requires none
    input { pid: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["kill", "-TERM", "{pid}"] }
    exit {
      0 => Unit
      nonzero => String "kill -TERM failed"
    }
    mock_response {
      0 => { success: true, stderr: "" } "hermetic posix.Signal.TerminateProcess"
    }
  }
}

// THE LINUX SIGNAL NUMBERS FOR THE STANDARD SIGNALS, by the name systemd reports them under
// ($EXIT_STATUS when $EXIT_CODE is killed or dumped: the name without its SIG prefix). signal(7),
// "Standard signals": the numbering below is the one shared by x86, ARM and most other Linux
// architectures (the table's middle column); alpha, sparc, mips and parisc number some of these
// differently, and no host this repository runs on is one of them. A name not listed is refused
// with Absent rather than guessed -- including the realtime signals, which have no fixed number.
data linux_signal_numbers_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man7/signal.7.html"
  }
}

// The closed set of names, so a misspelled or unlisted signal has no constructor; the one string
// parse is linux_standard_signal_of_name, at the systemd $EXIT_STATUS boundary.
type LinuxStandardSignal
  = SignalHup
  | SignalInt
  | SignalQuit
  | SignalIll
  | SignalTrap
  | SignalAbrt
  | SignalBus
  | SignalFpe
  | SignalKill
  | SignalUsr1
  | SignalSegv
  | SignalUsr2
  | SignalPipe
  | SignalAlrm
  | SignalTerm
  | SignalStkflt
  | SignalChld
  | SignalCont
  | SignalStop
  | SignalTstp
  | SignalTtin
  | SignalTtou
  | SignalUrg
  | SignalXcpu
  | SignalXfsz
  | SignalVtalrm
  | SignalProf
  | SignalWinch
  | SignalIo
  | SignalPwr
  | SignalSys

fn linux_standard_signal_of_name(name: String) -> LinuxStandardSignal? {
  if name == "HUP" { Present { value: SignalHup } }
  else if name == "INT" { Present { value: SignalInt } }
  else if name == "QUIT" { Present { value: SignalQuit } }
  else if name == "ILL" { Present { value: SignalIll } }
  else if name == "TRAP" { Present { value: SignalTrap } }
  else if name == "ABRT" { Present { value: SignalAbrt } }
  else if name == "BUS" { Present { value: SignalBus } }
  else if name == "FPE" { Present { value: SignalFpe } }
  else if name == "KILL" { Present { value: SignalKill } }
  else if name == "USR1" { Present { value: SignalUsr1 } }
  else if name == "SEGV" { Present { value: SignalSegv } }
  else if name == "USR2" { Present { value: SignalUsr2 } }
  else if name == "PIPE" { Present { value: SignalPipe } }
  else if name == "ALRM" { Present { value: SignalAlrm } }
  else if name == "TERM" { Present { value: SignalTerm } }
  else if name == "STKFLT" { Present { value: SignalStkflt } }
  else if name == "CHLD" { Present { value: SignalChld } }
  else if name == "CONT" { Present { value: SignalCont } }
  else if name == "STOP" { Present { value: SignalStop } }
  else if name == "TSTP" { Present { value: SignalTstp } }
  else if name == "TTIN" { Present { value: SignalTtin } }
  else if name == "TTOU" { Present { value: SignalTtou } }
  else if name == "URG" { Present { value: SignalUrg } }
  else if name == "XCPU" { Present { value: SignalXcpu } }
  else if name == "XFSZ" { Present { value: SignalXfsz } }
  else if name == "VTALRM" { Present { value: SignalVtalrm } }
  else if name == "PROF" { Present { value: SignalProf } }
  else if name == "WINCH" { Present { value: SignalWinch } }
  else if name == "IO" { Present { value: SignalIo } }
  else if name == "PWR" { Present { value: SignalPwr } }
  else if name == "SYS" { Present { value: SignalSys } }
  else { none }
}

fn linux_standard_signal_wire_name(signal: LinuxStandardSignal) -> String {
  match signal {
    SignalHup => "HUP"
    SignalInt => "INT"
    SignalQuit => "QUIT"
    SignalIll => "ILL"
    SignalTrap => "TRAP"
    SignalAbrt => "ABRT"
    SignalBus => "BUS"
    SignalFpe => "FPE"
    SignalKill => "KILL"
    SignalUsr1 => "USR1"
    SignalSegv => "SEGV"
    SignalUsr2 => "USR2"
    SignalPipe => "PIPE"
    SignalAlrm => "ALRM"
    SignalTerm => "TERM"
    SignalStkflt => "STKFLT"
    SignalChld => "CHLD"
    SignalCont => "CONT"
    SignalStop => "STOP"
    SignalTstp => "TSTP"
    SignalTtin => "TTIN"
    SignalTtou => "TTOU"
    SignalUrg => "URG"
    SignalXcpu => "XCPU"
    SignalXfsz => "XFSZ"
    SignalVtalrm => "VTALRM"
    SignalProf => "PROF"
    SignalWinch => "WINCH"
    SignalIo => "IO"
    SignalPwr => "PWR"
    SignalSys => "SYS"
  }
}

fn linux_standard_signal_of_number(n: Int) -> LinuxStandardSignal? {
  if n == 1 { Present { value: SignalHup } }
  else if n == 2 { Present { value: SignalInt } }
  else if n == 3 { Present { value: SignalQuit } }
  else if n == 4 { Present { value: SignalIll } }
  else if n == 5 { Present { value: SignalTrap } }
  else if n == 6 { Present { value: SignalAbrt } }
  else if n == 7 { Present { value: SignalBus } }
  else if n == 8 { Present { value: SignalFpe } }
  else if n == 9 { Present { value: SignalKill } }
  else if n == 10 { Present { value: SignalUsr1 } }
  else if n == 11 { Present { value: SignalSegv } }
  else if n == 12 { Present { value: SignalUsr2 } }
  else if n == 13 { Present { value: SignalPipe } }
  else if n == 14 { Present { value: SignalAlrm } }
  else if n == 15 { Present { value: SignalTerm } }
  else if n == 16 { Present { value: SignalStkflt } }
  else if n == 17 { Present { value: SignalChld } }
  else if n == 18 { Present { value: SignalCont } }
  else if n == 19 { Present { value: SignalStop } }
  else if n == 20 { Present { value: SignalTstp } }
  else if n == 21 { Present { value: SignalTtin } }
  else if n == 22 { Present { value: SignalTtou } }
  else if n == 23 { Present { value: SignalUrg } }
  else if n == 24 { Present { value: SignalXcpu } }
  else if n == 25 { Present { value: SignalXfsz } }
  else if n == 26 { Present { value: SignalVtalrm } }
  else if n == 27 { Present { value: SignalProf } }
  else if n == 28 { Present { value: SignalWinch } }
  else if n == 29 { Present { value: SignalIo } }
  else if n == 30 { Present { value: SignalPwr } }
  else if n == 31 { Present { value: SignalSys } }
  else { none }
}

fn linux_standard_signal_render(n: Int) -> String {
  match linux_standard_signal_of_number(n: n) {
    Present { value: s } => join(["SIG", linux_standard_signal_wire_name(signal: s)], "")
    Absent => join(["signal ", to_string(n)], "")
  }
}

fn linux_standard_signal_number(signal: LinuxStandardSignal) -> Int {
  match signal {
    SignalHup => 1
    SignalInt => 2
    SignalQuit => 3
    SignalIll => 4
    SignalTrap => 5
    SignalAbrt => 6
    SignalBus => 7
    SignalFpe => 8
    SignalKill => 9
    SignalUsr1 => 10
    SignalSegv => 11
    SignalUsr2 => 12
    SignalPipe => 13
    SignalAlrm => 14
    SignalTerm => 15
    SignalStkflt => 16
    SignalChld => 17
    SignalCont => 18
    SignalStop => 19
    SignalTstp => 20
    SignalTtin => 21
    SignalTtou => 22
    SignalUrg => 23
    SignalXcpu => 24
    SignalXfsz => 25
    SignalVtalrm => 26
    SignalProf => 27
    SignalWinch => 28
    SignalIo => 29
    SignalPwr => 30
    SignalSys => 31
  }
}
