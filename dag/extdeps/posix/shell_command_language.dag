module extdeps.posix.shell_command_language

import std.types { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data posix_authority_duplication_note: String = "THE LOCATOR IS DECLARED IN FIVE MODULES AND THE CONSOLIDATION WAS ATTEMPTED, EXECUTED, AND REVERTED — a measured incompatibility, not an unexamined duplication (cursor review 48163 and the CI receipt that refuted its fix, 2026-08-04). The review is CORRECT that this locator appears verbatim in extdeps.shell, extdeps.shell.exec, extdeps.transports.shell, extdeps.process.posix_exit and here, and correct that consume-never-fork is the governing rule. The consolidation was built the right way round — this subject module as the authority, the four consumers aliasing it, so a transport module never owns the specification citation its own subject module consumes — and it reduced the corpus from five copies to one. IT ALSO TURNED v2.lens.mandatory_tag's corpus_live_clean_tree_wall_holds RED, measured by execution rather than predicted: the wall projects each extdeps module's extdeps_external_authority_anchor and reads a scheme identity off it, and that projection resolves a LITERAL construction, not an alias to one. So a module whose anchor is an alias projects no readable scheme and counts as a violation. THE FINDING, which is worth more than the cleanup: the mandatory-tag corpus scan STRUCTURALLY REQUIRES the duplication section 3 forbids. As mechanized today, 'every extdeps module declares its own anchor' is satisfiable only by re-declaring the literal per module, so any two modules governed by one upstream must copy its URI. That is a real conflict between two live rules and it is NOT mine to resolve inside a review round: it turns on whether the anchor is a CITATION VALUE (one authority, shared) or a PER-MODULE DECLARATION of which upstream governs this module (inherently repeated, and then five copies are five different facts that share a string). Escalated; the wall stays green meanwhile. DISSOLVE-ON: the corpus-scan projection resolves an aliased anchor to its literal, or the anchor's role is settled as per-module declaration and this note records that instead. Reverting was the only landing state that did not either ship a red wall or leave the consolidation half-applied — the four modules keep their literals and so does this one."

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html"
  }
}

data posix_shell_subject_note: String = "THE POSIX SHELL COMMAND LANGUAGE, as its own subject rather than as a citation of GNU Bash (review relayed through the operator, 2026-08-04). It was previously stored as a further_citation on the GNU Bash ExternalModelScope, while the Bash carrier's own prose said the two were independently governed entities — so the file asserted the decomposition and then violated it one declaration later. DESIGN section 3's external-upstream decomposition rules on exactly this: multiple citations may ground ONE subject, but a second INDEPENDENTLY GOVERNED subject is not a citation of the first. The Open Group governs this specification; the GNU project governs Bash; neither versions with the other, and a change to one must not require editing the other's module — the Chromium/Safari test from that section. WHAT THIS SUBJECT IS: the Shell Command Language chapter of IEEE Std 1003.1-2017 (POSIX.1-2017), the shell syntax and semantics an implementation may conform to. It is NOT registered as a language target today and this module makes no such claim; it exists so that Bash's conformance can be stated as a relation between two named subjects instead of being smuggled into one scope. If a POSIX-shell target is ever claimed in its own right — a real possibility, since extdeps.shell.exec already routes shell.Exec.Check through 'sh -c' rather than through bash — it registers against THIS declaration and needs no new grounding."

type PosixShellCommandLanguage
  = | PosixShellCommandLanguageSpecification

data posix_shell_command_language: PosixShellCommandLanguage = PosixShellCommandLanguageSpecification

data posix_shell_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.posix.shell_command_language",
      decl_name: "posix_shell_command_language",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: ExternalModelScope = posix_shell_model_scope
