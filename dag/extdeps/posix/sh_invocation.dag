// WHY THIS IS A SEPARATE MODULE FROM extdeps.posix.shell_command_language, AND IT IS A CYCLE, NOT A
// PREFERENCE. The invocation builder was authored inside that module and the corpus refused with a
// circular dependency: extdeps.exec.command imports it for posix_single_quote, so it cannot import
// extdeps.exec.command back for the ArgvCommand carrier. The subject module owns the SPECIFICATION
// (the shell command language, its quoting rules); this module owns one INVOCATION SHAPE over the
// utility that implements it, and depends on the carrier -- exactly the split
// extdeps.languages.bash.invocation has from extdeps.languages.bash.subject, for the same reason.

// THE `sh -c` INVOCATION, AND IT IS THE RESIDUAL CLASS OF THIS SEAL RATHER THAN A HOLE IN IT.
//
// What the ArgvCommand wall makes unwritable is a hand-spelled WORD LIST: the flags of a tool this
// repository does not own, typed at a call site where nothing can check them. That is a different
// class from a shell PROGRAM, which is one argument to one program (`sh`) whose own contract is
// "interpret this text". A builder that took a script and returned an argv is not a place a flag can
// be dropped -- there are no flags to drop -- so sealing the record does not and should not make a
// shell program unwritable. The text itself is modeling debt, and it is the shell -> dag lane's
// debt: gunbc.retained_shell_script and extdeps.shell.exec TransportScript already own the route by
// which a script body becomes a modeled program, and the sites that reach for this builder are the
// ones that have not yet been carried through it.
//
// POPULATION AT THE SEAL, counted rather than estimated: eleven call sites. Ten are production host
// probes in the fleet observation and enrollment path (gunbc.fleet.fleet_probe_identity_observe x6,
// gunbc.fleet.fleet_host_key_enrollment x4) whose bodies use $(...), && and || -- genuine shell
// composition, not an argv wearing a costume. The eleventh is a manual receipt test that needs a
// program which exits nonzero while printing nothing, and reaches for `sh -c "exit 3"` because no
// utility has that as its contract.
//
// DISSOLVED (DP-M2 PR3, session witty-wren-554, 2026-10-04): the ten production sites are cut
// over. The getent|cut home pipeline became a typed getent invocation plus a pure field
// extraction (extdeps.posix.getent, gunbc.fleet.fleet_probe_identity_observe passwd_home_observation);
// the env echoes became shell.Env.Get reads; the `command -v` presence checks became
// shell.PosixCommandV.Check; the gcloud auth list became the typed
// extdeps.tools.gcloud.gcloud_auth_list_accounts_command; the `test -f` check became
// extdeps.posix.test_utility.test_regular_file_command through a named exit-status ruling; the
// authorized_keys greps became modeled reads decided by
// authorized_keys_admits_line (whole-line semantics kept); the ssh-config pin and the
// mkdir/chmod/touch/cat>> bootstrap became declared sequences over shell.Env.Get, a captured pwd
// (extdeps.tools.gnu_coreutils pwd_command), the put-if-absent create, and typed chmod builders.
// WHAT REMAINS is a measurement, not a count: `git grep -n "posix_sh_program_command("` is the
// instrument (the ROADMAP DP-M2 row names it). The PRODUCTION sites are gone on this head; the
// remaining callers are the manual receipt test above and the wet-lane test fixtures that still
// build shell text as strings (the approval_ntfy, machine_intake, and spark witness tests among
// them). When every remaining caller has moved -- the manual test's exit-nonzero-print-nothing
// contract settled (the fabric compute reorganization that
// gunbc.guarantee_stall.compile_pool_provision_wired_but_unreachable_stall names for the
// neighboring lane, or any future lane), and the fixture scripts rebuilt on typed carriers -- the
// instrument returns zero and this builder is deleted with its last call. It is NOT an escape hatch for a new argv: a caller reaching for it to run a single
// program with flags is spelling that program's argv inside a string, which review must refuse
// exactly as it refuses the record literal.
fn posix_sh_program_command(script: String) -> ArgvCommand {
  argv_command(program: posix_sh_program(), arguments: ["-c", script])
}

// THE FILE FORM: `sh` reads its commands from the named file rather than from a `-c` word. This is
// NOT another arm of the residual class above -- it is the form a script takes once its text has
// become DATA: written to the far side as a staged, readback-verified file
// (gunbc.typed_remote_file_write), so the only words the portable-word wall ever sees are the two
// literals `sh` and the path, and the script's content is never re-parsed as a word. A caller that
// holds its script as a verified file belongs here; a caller holding it as a string belongs to the
// shell -> dag lane's debt, as above.
// THE WORDS OF "run this script file", WITHOUT the program identity attached. The reason this is split
// out is elevation: a converge that installs packages has to run its staged script as root, and the
// elevated wrappers take WORDS, not an ArgvCommand. Handing the words to one of those wrappers after
// re-spelling "sh" at the call site would put a second spelling of the interpreter in the fleet, and a
// call site that typed "bash" there would quietly change which shell parses the script — a difference
// that shows up as a syntax error only on the host that has no bash. ONE NAME ROW below feeds both this
// and the ArgvCommand form, so they cannot drift.
fn posix_sh_script_argv(path: NonEmptyStr) -> List<String> {
  [posix_sh_program_name as String, path as String]
}

data posix_sh_program_name: NonEmptyStr = "sh"

fn posix_sh_script_command(path: NonEmptyStr) -> ArgvCommand {
  argv_command(program: posix_sh_program(), arguments: posix_sh_script_argv(path: path))
}

// PATH-resolved program name, deliberately: this repository has made no filesystem observation of
// the host this command runs on, and an absolute path is a claim about one. The full reasoning, the
// criterion for climbing to an absolute row, and the counter-example that makes the distinction
// load-bearing are recorded once at extdeps.exec.command program_spelling_is_an_observation_claim.
fn posix_sh_program() -> ProgramIdentity = uncataloged_program(invocation: posix_sh_program_name)

// EXPORT ONE VARIABLE FROM A FILE, THEN EXEC A COMMAND (POSIX sh: command substitution, export,
// exec). The value is read by the shell itself and placed only in the exec'd command's environment;
// it never appears in any process's argument vector, which every local user can read. The file path
// is $0 and the command is "$@", so neither is ever spliced into the program; the name is a
// PosixShellName. A file that cannot be read exits 78 before the command runs, never an empty value
// exported.
//
// THE PROGRAM IS A NODE, NOT A STRING (reviews 76293, 76372, 76385). It is built from the bash grammar
// constructors (v2.extdeps.languages.bash_build) and serialized by the grammar-row emitter
// (v2.workflow.bash_emit bash_emit_stmts), which renders, for name N:
//   N=$('cat' '--' "$0") || exit 78
//   'export' 'N'
//   'exec' "$@"
// -- measured under dash. An emitter refusal is a typed arm, never a fallback spelling.
//
// WHY THIS IS HOMED IN extdeps AND NOT IN THE CREDENTIAL LAYER (review 76372 point 3, stated
// divergence). The ArgvCommand mint (extdeps.exec.command argv_command) admits only per-tool builders
// homed in the tool's own extdeps module, and this is one POSIX sh operation parameterized by a name,
// a path and a command. The POLICY (which variable, which credential, which custody file) is supplied
// by the caller -- gunbc.claude_code_credential owns all three for the Claude credential.
data posix_sh_export_from_file_unreadable_exit: Int = 78

// WHETHER THE FILE OUTLIVES THE READ. A one-shot snapshot (one credential, one child) is removed by
// the shell right after it is read and before the exec, so the value exists afterwards only in that
// child's environment; a file another reader still needs is kept. A SUCCESSFUL REMOVAL IS A
// PRECONDITION OF THE EXEC (side-chat finding, 2026-10-05): measured under dash with the parent
// directory readable but not writable, a bare `rm -f` failed and the command still ran, and a second
// launch ran again with the same value. So the removal carries its own failure arm and a snapshot
// that cannot be consumed refuses the launch with exit 79 -- distinct from 78 (unreadable).
data posix_sh_export_from_file_unremovable_exit: Int = 79

type PosixShFileDisposition
  = PosixShKeepFile
  | PosixShRemoveFileAfterRead
  | PosixShReplaceFileAfterRead { body: String }

fn posix_sh_export_replace_statements(body: String) -> List<Node> {
  [
    bash_build_or_else(
      left: bash_build_assign(
        name: "t",
        value: bash_build_word_cmdsubst(
          body: bash_build_command_with_words(words: [
            bash_build_word_lit(text: "mktemp"),
            bash_build_word_lit(text: "--"),
            bash_build_word_concat_from_nodes(parts: [bash_build_word_var(name: "0"), bash_build_word_lit(text: ".XXXXXX")]),
          ]),
        ),
      ),
      right: bash_build_exit(code: to_string(value: posix_sh_export_from_file_unremovable_exit)),
    ),
    bash_build_or_else(
      left: bash_build_with_redir_to_file(
        inner: bash_build_command_with_words(words: [
          bash_build_word_lit(text: "printf"),
          bash_build_word_lit(text: "%s"),
          bash_build_word_lit(text: body),
        ]),
        path: bash_build_word_var(name: "t"),
      ),
      right: bash_build_and_then(
        left: bash_build_command_with_words(words: [bash_build_word_lit(text: "rm"), bash_build_word_lit(text: "-f"), bash_build_word_lit(text: "--"), bash_build_word_var(name: "t")]),
        right: bash_build_exit(code: to_string(value: posix_sh_export_from_file_unremovable_exit)),
      ),
    ),
    bash_build_or_else(
      left: bash_build_command_with_words(words: [
        bash_build_word_lit(text: "mv"),
        bash_build_word_lit(text: "-f"),
        bash_build_word_lit(text: "--"),
        bash_build_word_var(name: "t"),
        bash_build_word_var(name: "0"),
      ]),
      right: bash_build_and_then(
        left: bash_build_command_with_words(words: [bash_build_word_lit(text: "rm"), bash_build_word_lit(text: "-f"), bash_build_word_lit(text: "--"), bash_build_word_var(name: "t")]),
        right: bash_build_exit(code: to_string(value: posix_sh_export_from_file_unremovable_exit)),
      ),
    ),
  ]
}

fn posix_sh_export_remove_statements(disposition: PosixShFileDisposition) -> List<Node> {
  match disposition {
    PosixShKeepFile => []
    PosixShRemoveFileAfterRead =>
      [
        bash_build_or_else(
          left: bash_build_command_with_words(words: [bash_build_word_lit(text: "rm"), bash_build_word_lit(text: "-f"), bash_build_word_lit(text: "--"), bash_build_word_var(name: "0")]),
          right: bash_build_exit(code: to_string(value: posix_sh_export_from_file_unremovable_exit)),
        ),
      ]
    PosixShReplaceFileAfterRead { body } => posix_sh_export_replace_statements(body: body)
  }
}

// THE ONE EXPORT-THEN-EXEC BODY, over where the value is read from. The source word list is the only
// difference between a value held in a file and one arriving on stdin; the exit-on-unreadable arm,
// the export and the exec of the remaining argv are the same statements either way.
fn posix_sh_export_then_exec_program(name: PosixShellName, read_words: List<Node>, middle: List<Node>) -> Outcome<String> {
  let spelling = name.spelling as String
  bash_emit_stmts(
    statements: concat(concat([
      bash_build_or_else(
        left: bash_build_assign(
          name: spelling,
          value: bash_build_word_cmdsubst(body: bash_build_command_with_words(words: read_words)),
        ),
        right: bash_build_exit(code: to_string(value: posix_sh_export_from_file_unreadable_exit)),
      ),
    ], middle), [
      bash_build_command_from_lits(lits: ["export", spelling]),
      bash_build_command_with_words(words: [bash_build_word_lit(text: "exec"), bash_build_word_var(name: "@")]),
    ]),
    set_e: false,
  )
}

fn posix_sh_export_from_file_then_exec_program(name: PosixShellName, disposition: PosixShFileDisposition) -> Outcome<String> {
  posix_sh_export_then_exec_program(
    name: name,
    read_words: [bash_build_word_lit(text: "cat"), bash_build_word_lit(text: "--"), bash_build_word_var(name: "0")],
    middle: posix_sh_export_remove_statements(disposition: disposition),
  )
}

// THE VALUE ARRIVES ON STDIN AND TOUCHES NO FILE. The caller pipes the value in over a stdin-carrying
// exec (gunbc.host.host_effect_realize run_argv_stdin_over_host_effect_transport), so it is in neither
// the argv (gunbc.credential_argv_exposure) nor any path on disk; the child holds it only in its
// environment. Nothing is removed because nothing was written.
fn posix_sh_export_from_stdin_then_exec_command(name: PosixShellName, command: List<String>) -> PosixShExportExecCommand {
  match posix_sh_export_then_exec_program(name: name, read_words: [bash_build_word_lit(text: "cat")], middle: []) {
    Accepted { value: program, diagnostics: _ } =>
      PosixShExportExecReady {
        command: argv_command(
          program: posix_sh_program(),
          arguments: concat(["-c", program, "sh"], command),
        ),
      }
    Rejected { diagnostics: _ } => PosixShExportExecEmitRefused { name: name.spelling }
  }
}

type PosixShExportExecCommand
  = PosixShExportExecReady { command: ArgvCommand }
  | PosixShExportExecEmitRefused { name: NonEmptyStr }

fn posix_sh_export_from_file_then_exec_command(
  name: PosixShellName,
  path: NonEmptyStr,
  command: List<String>,
  disposition: PosixShFileDisposition,
) -> PosixShExportExecCommand {
  match posix_sh_export_from_file_then_exec_program(name: name, disposition: disposition) {
    Accepted { value: program, diagnostics: _ } =>
      PosixShExportExecReady {
        command: argv_command(
          program: posix_sh_program(),
          arguments: concat(["-c", program, path as String], command),
        ),
      }
    Rejected { diagnostics: _ } => PosixShExportExecEmitRefused { name: name.spelling }
  }
}

// SAME OPEN OBJECT FOR METADATA AND BYTES. Stats `/dev/stdin` (the wrapper's descriptor, GNU `-L`)
// and cats it. Built once; the wrapper prepends `exec < "$0"`, and the replacement / character-device
// REDs emit this body alone so `$0` is the held path.
fn posix_sh_receipt_object_body_stmt() -> Node {
  bash_build_and_then(
    left: bash_build_command_with_words(words: [
      bash_build_word_lit(text: stat_program().invocation as String),
      bash_build_word_lit(text: "-L"),
      bash_build_word_lit(text: "-c"),
      bash_build_word_lit(text: "%F|%U|%a"),
      bash_build_word_lit(text: "/dev/stdin"),
    ]),
    right: bash_build_command_from_lits(lits: ["cat"]),
  )
}

fn posix_sh_receipt_object_body_program() -> Outcome<String> {
  bash_emit_stmts(statements: [posix_sh_receipt_object_body_stmt()], set_e: false)
}

// THE WRAPPER IS A GRAMMAR ROW, NOT A DATA SPLICE. `bash_build_with_redir_from_file` emits
// `exec < "$0"`: `$0` is an argv word, never concatenated into the program text.
fn posix_sh_receipt_object_program() -> Outcome<String> {
  bash_emit_stmts(statements: [
    bash_build_with_redir_from_file(
      inner: bash_build_command_from_lits(lits: ["exec"]),
      path: bash_build_word_var(name: "0"),
    ),
    posix_sh_receipt_object_body_stmt(),
  ], set_e: false)
}

type PosixShReceiptObjectCommand
  = PosixShReceiptObjectReady { command: ArgvCommand }
  | PosixShReceiptObjectEmitRefused

fn posix_sh_receipt_object_command(path: NonEmptyStr) -> PosixShReceiptObjectCommand {
  match posix_sh_receipt_object_program() {
    Accepted { value: program, diagnostics: _ } =>
      PosixShReceiptObjectReady {
        command: argv_command(
          program: posix_sh_program(),
          arguments: ["-c", program, path as String],
        ),
      }
    Rejected { diagnostics: _ } => PosixShReceiptObjectEmitRefused
  }
}
