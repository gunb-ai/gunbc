module extdeps.posix.getent

import extdeps.exec.program { ProgramIdentity, uncataloged_program }
import std.types { NonEmptyStr, Int }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/getent.1.html"
  }
}

fn getent_program() -> ProgramIdentity = uncataloged_program(invocation: "getent")

// getent passwd <key> answers the passwd database entry for key, one line:
// name:passwd:uid:gid:gecos:home:shell. The fleet probe modules used to reach the same entry
// through a shell pipeline (`getent passwd "$(whoami)" | cut -d: -f6`); the pipeline's field
// selection now happens in the corpus (extdeps.linux.etc_passwd parses the seven passwd(5) fields;
// its etc_passwd_home_of answers the home, consumed by
// gunbc.fleet.fleet_probe_identity_observe::passwd_home_observation and
// gunbc.runner.runner_gpu_container_toolchain::job_user_home_from_passwd), so this
// module owns only the invocation: the database, the key, and nothing else.
fn getent_passwd_command(key: NonEmptyStr) -> ArgvCommand {
  argv_command(program: getent_program(), arguments: ["passwd", key as String])
}

// getent(1), EXIT STATUS: "2  One or more supplied key could not be found in the database." It is
// the one status that says the entry is ABSENT rather than unreadable, so a caller that creates an
// absent entry reads this value instead of treating every non-zero exit as absence.
data getent_key_not_found_exit: Int = 2

// getent group <key> answers the group database entry for key, one line: name:passwd:gid:members.
// gunbc.fleet.approval_ntfy_retirement reads it for the group a retired service account leaves
// behind: userdel(8) removes the identity, and a group of the same name that has any OTHER member
// survives, so a retirement that stops at the account leaves a member of the roster on the host.
// The invocation is the database and the key, and nothing else; field selection, if a caller wants
// one, happens in the corpus. THE SAME NOT-FOUND CODE ANSWERS FOR EVERY DATABASE: getent(1) exits 2
// when "one or more supplied key could not be found in the database", so getent_key_not_found_exit
// above is the value a group read compares against too -- verified on srv1, where `getent group` on a
// name no database resolves exited 2 and printed nothing.
fn getent_group_command(key: NonEmptyStr) -> ArgvCommand {
  argv_command(program: getent_program(), arguments: ["group", key as String])
}

// getent shadow <login> is how the boot medium reader probe reads whether the reader account's password
// field is ACTUALLY locked, rather than inferring it from the `--system` account being created with
// `useradd --system` (gunbc.executor_privileged_operation EnsureSystemAccount). The inference is what the
// probe exists to check, so the probe reads the field itself; `passwd` cannot see field two of the shadow
// map, and reading /etc/shadow directly would need a path the fleet does not declare. OPERAND key is the
// login; the utility resolves the database, so this row does not name a file or an account.
fn getent_shadow_command(key: NonEmptyStr) -> ArgvCommand {
  argv_command(program: getent_program(), arguments: ["shadow", key as String])
}

// getent ahostsv4 <name> is the READ-OF-RECORD for "does this name resolve ON THIS HOST, through the
// resolver the host's own programs use". gunbc.tailscale_join_converge's srv1 read-back runs it against a
// joined host's tailnet name, and it is the right instrument precisely because of what the man page says
// it is NOT: getent(1) "displays entries from databases supported by the Name Service Switch libraries,
// which are configured in /etc/nsswitch.conf", and ahostsv4 is "Same as ahosts, but use the address family
// AF_INET" -- ahosts being the database that passes each key "in succession to getaddrinfo(3)". So an
// answer here is an answer from the same NSS path the router's own upstream lookups take, which is the
// question the fleet owes when upstreams are addressed by tailnet name rather than by a LAN IP.
//
// WHY THIS IS NOT REDUNDANT WITH `tailscale ping` (extdeps.tailscale.join): the ping resolves a machine
// name from Tailscale's own peer list, not from NSS (cmd/tailscale/cli/ping.go), so a pong says the peer is
// reachable OVER THE TAILNET while saying nothing about whether sshd(8)-era resolver consumers -- nginx, an
// ssh target string, a cron entry -- can resolve the name. The two legs answer different failures, which is
// why they are two legs.
//
// THE OUTPUT SHAPE IS NOT CLAIMED. getent(1) documents the databases and the address family, not a column
// layout for ahostsv4, so no field indexing happens here and this module does not parse the reply at all;
// the caller judges non-emptiness and looks for the name it asked about
// (@ref(gunbc.tailscale_join_converge::tailscale_join_observe_name_resolution)), and the raw reply
// travels in any refusal rather than being
// silently re-shaped into a success. THE NOT-FOUND CODE IS THE SAME ONE as every other database above:
// getent(1) EXIT STATUS "2 One or more supplied key could not be found in the database".
fn getent_hosts_command(name: NonEmptyStr) -> ArgvCommand {
  argv_command(program: getent_program(), arguments: ["ahostsv4", name as String])
}
