// THE STANDALONE UTILITY, NOT THE SHELL BUILTIN, and that is why this module exists at all rather
// than the question being answered by a shell fragment. Every shell also implements `test` as a
// builtin, so a caller that reaches for a shell to ask it pays for a shell parse and inherits that
// shell's own quoting rules. Spawning the utility asks the same question of a real program with a
// real argv, which is exactly what this repository's ArgvCommand carrier is for.
// PATH-resolved program name, deliberately: this repository has made no filesystem observation of
// the host this command runs on, and an absolute path is a claim about one. The full reasoning, the
// criterion for climbing to an absolute row, and the counter-example that makes the distinction
// load-bearing are recorded once at extdeps.exec.command program_spelling_is_an_observation_claim.
fn test_program() -> ProgramIdentity = uncataloged_program(invocation: "test")

// -f IS "EXISTS AND IS A REGULAR FILE", which is a stronger claim than -e ("exists"): a directory, a
// socket or a dangling symlink at that path answers false here and true under -e. The two are not
// interchangeable and this builder commits to the one its callers mean -- a unit file that turned
// out to be a directory is not present, it is broken.
fn test_regular_file_command(path: String) -> ArgvCommand {
  argv_command(program: test_program(), arguments: ["-f", path])
}

fn test_exists_command(path: String) -> ArgvCommand {
  argv_command(program: test_program(), arguments: ["-e", path])
}

// -L IS "EXISTS AND IS A SYMBOLIC LINK" (POSIX test, OPERANDS -h/-L), and it is the only primitive test
// operand that does NOT resolve the final component: POSIX specifies -h/-L through lstat() semantics
// (the link itself) while every other file operand, -e included, is stat()-based and follows the link.
// A dangling link, a link to a referent in an unsearchable directory and a self-referencing link all
// answer false under -e and true here.
fn test_symbolic_link_command(path: String) -> ArgvCommand {
  argv_command(program: test_program(), arguments: ["-L", path])
}

fn test_writable_command(path: String) -> ArgvCommand {
  argv_command(program: test_program(), arguments: ["-w", path])
}

// -r IS "EXISTS AND IS READABLE BY THE EFFECTIVE UID" (POSIX test, OPERAND -r), and it is the operand the
// boot medium reader probe needs and no other row offered. It is NOT -e: a file can exist and be readable,
// and a file can exist and NOT be readable, and the reader account's whole question is which of those the
// served image is. The account whose readability is in question is chosen by the CALLER's privilege (the
// probe runs it under `sudo -u <reader>`), so this row stays about the utility and not about any account.
fn test_readable_command(path: String) -> ArgvCommand {
  argv_command(program: test_program(), arguments: ["-r", path])
}

fn test_executable_command(path: String) -> ArgvCommand {
  argv_command(program: test_program(), arguments: ["-x", path])
}

// -d IS "EXISTS AND IS A DIRECTORY" (POSIX test, OPERANDS -d).
fn test_directory_command(path: String) -> ArgvCommand {
  argv_command(program: test_program(), arguments: ["-d", path])
}

// WHETHER A PATH IS THERE, OR WHY THAT COULD NOT BE DECIDED -- ONE DECLARATION, AT THE BOUNDARY THAT
// OWNS THE UTILITY.
//
// POSIX gives `test` exit 0 for true and 1 for false, and reserves anything else for the utility
// itself failing. So exit 1 is the only status that can mean absent; every other nonzero one is an
// instrument that did not answer.
//
// BUT EXIT 1 IS NOT ONLY ABSENCE, AND TREATING IT AS ABSENCE IS THE DEFECT THIS CARRIER NOW REFUSES
// TO HIDE. `test -e` is false when the path does not exist AND when it exists but cannot be
// STATTED -- a parent directory without search permission, a dead mount, an I/O error on the inode.
// The utility reports both as 1 and offers nothing to tell them apart. For a sanitation readback that
// is the worst possible conflation, because ABSENT is the answer that RELEASES A CELL: a directory
// whose parent lost +x would read as "the attempt's storage is gone" while the tenant's files sit
// under it.
//
// SO EXIT 1 IS NOT A VERDICT HERE, IT IS A QUESTION, and the caller must establish containment to
// answer it. That is the repair the recurring-failure-mode row for this class names: establish the
// PARENT absent and inherit for its descendants; preserve unreadability when the parent is
// unreadable. A path under a parent that demonstrably does not exist cannot exist; a path under a
// parent nobody could read is unknown, not gone.
type PathExistenceReading
  = PathPresent
  | PathAbsentOrUnstattable
  | PathExistenceUnreadable { reason: NonEmptyStr }

// THE ONE READER OF WHAT A `test` STATUS MEANS. Every consumer that obtains a `test` status from some
// transport -- a ProcessOutcome here, a run-argv outcome in gunbc.host.host_effect_realize's removal
// read-back -- maps it to a PathExistenceReading through THIS, so the 0/1/other law lives in exactly
// one place: 0 is present; 1 is absent-or-unstattable, which containment then decides; any other
// status is the host failing to answer and stays unreadable. A consumer that re-implements this
// mapping is a second reader of the same status, and the two drift.
//
// It reads `test` statuses and nothing else. Whether ONE NAMED ENTRY is in a directory is a different
// question, asked without `test` so the host's reason survives: extdeps.filesystem.filesystem_io's
// filesystem_entry_lookup_reading_of_exit owns that one.
fn path_existence_reading_of_exit(path: String, exit_code: Int, stderr: String) -> PathExistenceReading {
  if exit_code == 0 {
    PathPresent
  } else if exit_code == 1 {
    PathAbsentOrUnstattable
  } else {
    PathExistenceUnreadable {
      reason: join(["`test ", path, "` exited ", to_string(exit_code), ": ", trim(s: stderr)], "") as NonEmptyStr,
    }
  }
}

fn path_existence_reading(path: String, outcome: ProcessOutcome) -> PathExistenceReading {
  match outcome {
    ProcessOutputPresent { text: _ } => path_existence_reading_of_exit(path: path, exit_code: 0, stderr: "")
    ProcessOutputAbsent => path_existence_reading_of_exit(path: path, exit_code: 0, stderr: "")
    ProcessRefused { exit_code: code, stderr: e } => path_existence_reading_of_exit(path: path, exit_code: code, stderr: e)
  }
}

// THE ENTRY, NOT ITS REFERENT. `test -e` answers whether the path RESOLVES, which is a different
// question from whether an entry is there to remove: a symlink whose target is missing, unreachable or
// itself reads false under -e though the entry exists, and rm removes the entry. The no-follow
// reading is `test -L` (lstat: the link itself) OR `test -e` (stat: any other entry), each a POSIX
// operand. Either one present is the entry present; an unreadable answer is never folded into absent;
// only two exit-1 answers together are absent-or-unstattable, which containment then decides.
fn entry_existence_reading(link: PathExistenceReading, follow: PathExistenceReading) -> PathExistenceReading {
  match link {
    PathPresent => PathPresent
    PathExistenceUnreadable { reason: r } =>
      match follow {
        PathPresent => PathPresent
        PathAbsentOrUnstattable => PathExistenceUnreadable { reason: r }
        PathExistenceUnreadable { reason: _ } => link
      }
    PathAbsentOrUnstattable => follow
  }
}

// CONTAINMENT: WHAT A PARENT'S READING ESTABLISHES ABOUT A PATH UNDER IT.
//
// This is the only route from a `test -e` false to a real ABSENT, and it takes both readings so the
// inheritance cannot be asserted without the evidence for it. The parent's own false is itself
// ambiguous -- but a parent that is absent-or-unstattable containing a child that is
// absent-or-unstattable is a subtree nothing can be read under, and for a SANITATION question that
// is still not "gone": it is "unreadable". Only a parent that is PRESENT and readable makes the
// child's false mean absent, because then the directory was searched and the child was not in it.
//
// ONE LEVEL, which is what a lone parent reading can carry: the parent's own false is exactly as
// ambiguous as the child's, and where the walk may not stop is the question
// absent_under_nearest_present_ancestor below answers -- the same law, one level at a time, until an
// ancestor that IS present and searchable is reached or the ancestors run out.
type ContainedExistence
  = ContainedAbsent
  | ContainedPresent
  | ContainedUnreadable { reason: NonEmptyStr }

fn contained_existence(
  path: String,
  parent: String,
  parent_reading: PathExistenceReading,
  child_reading: PathExistenceReading,
) -> ContainedExistence {
  match child_reading {
    PathPresent => ContainedPresent
    PathExistenceUnreadable { reason: r } => ContainedUnreadable { reason: r }
    PathAbsentOrUnstattable => absent_under(path: path, parent: parent, parent_reading: parent_reading)
  }
}

fn absent_under(path: String, parent: String, parent_reading: PathExistenceReading) -> ContainedExistence {
  match parent_reading {
    PathPresent => ContainedAbsent
    PathAbsentOrUnstattable =>
      ContainedUnreadable {
        reason: join([
          "`test -e ", path, "` is false and so is its parent ", parent,
          ", so nothing under that parent could be read and the path's absence is not established",
        ], "") as NonEmptyStr,
      }
    PathExistenceUnreadable { reason: r } =>
      ContainedUnreadable {
        reason: join([
          "`test -e ", path, "` is false and its parent ", parent, " could not be read (", r as String,
          "), so the path's absence is not established",
        ], "") as NonEmptyStr,
      }
  }
}

// ---------------------------------------------------------------------------
// THE ANCESTOR WALK: how a `test -e` false becomes an ABSENCE when the parent is absent too.
//
// `absent_under` stops at the immediate parent. For ONE parent reading that is right -- an
// absent-or-unstattable parent cannot carry an inheritance it cannot itself prove. It stops one level
// too early as the END of the proof, because the walk does not have to stop there. Absence is
// established by the nearest ancestor that IS present and SEARCHABLE: that directory was searched, the
// component of the path under it was not in it, so that component is absent; and a component that is
// absent has no subtree, so everything below it -- including the path the probe was asked about -- is
// absent with it. Requiring the ancestor to be searchable, and not merely present, is what makes the
// search claim real: `test -e` true says the entry exists, not that anything under it can be looked up.
//
// What the walk may NOT do is run PAST an ancestor that is present but not searchable. `test -x` false
// is the same two-valued ambiguity as `test -e` false -- absent OR unsearchable -- and an ancestor that
// exists with its search bit off (mode 000, the very shape the sanitation guarantee exists for) may
// still hold the whole subtree. So every level the walk passes is read TWICE: `test -x` for
// present-and-searchable, and, only where that is false, the ENTRY (`test -L` or `test -e`,
// entry_existence_reading) to tell "not in its parent" from "there, but I may not look inside". An
// ancestor that is present and not searchable stops the walk WITHOUT an answer, and the path stays
// ContainedUnreadable, exactly as it did before the walk existed.
//
// The chain is NEAREST FIRST and the walk stops at the first ancestor that answers: a refusal below a
// searchable ancestor is still a refusal, so a farther reading never overwrites a nearer one, and no
// amount of readable ground above an unreadable directory repairs it.

// WHAT ONE LEVEL OF THE WALK ANSWERED, declared as a coproduct rather than as a reading plus a
// presence rule. Two fields -- a `test -x` reading and an optional entry -- would make the illegal
// combinations writable: an ancestor absent-or-unstattable with NO entry reading, or a searchable one
// carrying an entry nobody asked for. The first is precisely the ambiguity this walk exists to refuse,
// so refusing it at run time would be a second representation of a constraint the model can simply
// carry: `AncestorNotSearchable` cannot be written without the entry reading that settles it, and
// `AncestorSearchable` cannot carry one at all (gunbc.design_argument::fail_closed section 5).
//
// THE TWO UNREADABLE ALTERNATIVES ARE SIBLINGS, AND EACH ONE IS ABOUT A DIFFERENT PROBE. `test -x`
// unanswered and `test -L` unanswered are not the same event: the first is asked of every level before
// anything else is, the second is asked only of a level that already answered `-x` and `-d` and has to say
// whether it is a link. A refusal that names `-x` about a level whose `-x` answered cleanly is not
// conservative, it is false, and an operator following it goes looking at the wrong probe. So each unreadable
// case carries its own reason and the law below words each one; a driver that found a probe unreadable picks
// the alternative that names the probe it actually asked.
type AncestorSearchReading
  = AncestorSearchable
  | AncestorSearchUnreadable { reason: NonEmptyStr }
  | AncestorLinkReadingUnreadable { reason: NonEmptyStr }
  | AncestorNotADirectory { cause: AncestorNotADirectoryCause }
  | AncestorNotSearchable { entry: PathExistenceReading }

// WHY A LEVEL THAT `test -x` ANSWERED PRESENT STILL CANNOT HAVE BEEN SEARCHED. This is a declared sum
// rather than a `directory` reading sitting beside a `link` reading for the same reason the level itself
// is one: two independent readings would make "is a directory AND is not a link" -- the searchable case --
// writable as a refusal, and every mixed pair with it. Each cause below is a fact one probe answered, and
// the law owns the wording of what it refuses.
//
//  - A file's OWN execute bit answers `test -x` with 0, so a level can be present-and-"executable" and
//    still have no entries to search: `stat` under a regular file is ENOTDIR, which is not "searched and
//    not found". Whether the verdict turns on this is not something a mode bit should decide.
//  - A symlink answers `test -x` (and `test -d`) by following ITSELF, so such a level reports on its
//    referent while the removal works at the link's own name. This module reads an entry as the entry it
//    is, not as whatever it points at, and a level that resolves elsewhere cannot vouch for what lives
//    under this name.
//  - And where the directory probe itself was not answered, nothing was established either way.
type AncestorNotADirectoryCause
  = AncestorDirectoryReadingUnreadable { reason: NonEmptyStr }
  | AncestorIsNotADirectory
  | AncestorIsASymlink

// One ancestor of the path: which level it is, and what its two readings settled.
type AncestorExistenceProbe {
  ancestor: String
  search: AncestorSearchReading
}

// What one ancestor's readings say about the walk.
type AncestorWalkStep
  = AncestorEstablishesAbsence
  | AncestorRefuses { reason: NonEmptyStr }
  | AncestorIsAbsentOrUnstattable

fn ancestor_walk_step(path: String, probe: AncestorExistenceProbe) -> AncestorWalkStep {
  match probe {
    AncestorExistenceProbe { ancestor: ancestor, search: search } =>
      match search {
        // Present AND searchable: the component toward the path was searched for and not found.
        AncestorSearchable => AncestorEstablishesAbsence
        AncestorSearchUnreadable { reason: r } =>
          AncestorRefuses {
            reason: join([
              "`test -x ", ancestor, "` could not be read while establishing the absence of ", path,
              " (", r as String, "), so the path's absence is not established",
            ], "") as NonEmptyStr,
          }
        // A level `test -x` AND `test -d` answered for, whose LINK probe could not be read. It is not the
        // `-x` failure the alternative above describes, and saying so would send the operator to a probe
        // that answered cleanly: what is missing is whether the level is a plain directory or a link
        // resolving elsewhere, and a level that resolves elsewhere cannot vouch for what lives under this
        // name -- so the walk refuses, naming the probe that actually failed.
        AncestorLinkReadingUnreadable { reason: r } =>
          AncestorRefuses {
            reason: join([
              "`test -L ", ancestor, "` could not be read while establishing the absence of ", path,
              ": `test -x` and `test -d` both answered for the level, so it is present and a directory, but",
              " whether it is a plain directory or a LINK answering for what it points at was not answered,",
              " and a level that resolves elsewhere cannot vouch for what lives under this name (",
              r as String, "), so the path's absence is not established",
            ], "") as NonEmptyStr,
          }
        AncestorNotADirectory { cause: cause } =>
          match cause {
            AncestorIsNotADirectory =>
              AncestorRefuses {
                reason: join([
                  "`test -d ", ancestor, "` is false while establishing the absence of ", path,
                  ": the level is present and `test -x` answered for it, but it is not a directory and has",
                  " no entries that could have been searched, and a reading of ENOTDIR under it is not a",
                  " search that did not find the component",
                ], "") as NonEmptyStr,
              }
            AncestorIsASymlink =>
              AncestorRefuses {
                reason: join([
                  "`", ancestor, "` is a symlink while establishing the absence of ", path,
                  ": `test -x` and `test -d` follow the link, so the level answered for what it POINTS AT",
                  " and not for itself, and a level that resolves elsewhere cannot vouch for what lives",
                  " under this name",
                ], "") as NonEmptyStr,
              }
            AncestorDirectoryReadingUnreadable { reason: r } =>
              AncestorRefuses {
                reason: join([
                  "`test -d ", ancestor, "` could not be read while establishing the absence of ", path,
                  " (", r as String, "), so the level was never established to be a directory that could",
                  " have been searched",
                ], "") as NonEmptyStr,
              }
          }
        AncestorNotSearchable { entry: entry } =>
          match entry {
            // There, but not searchable (or unreadable): the walk stops WITHOUT an answer, because
            // nothing under this ancestor could have been searched, so its child's false proves nothing.
            PathPresent =>
              AncestorRefuses {
                reason: join([
                  "`test -x ", ancestor, "` is false while establishing the absence of ", path,
                  " and the ancestor is present, so it is not searchable and nothing under it could be",
                  " searched: the path's absence is not established",
                ], "") as NonEmptyStr,
              }
            PathExistenceUnreadable { reason: r } =>
              AncestorRefuses {
                reason: join([
                  "`test -x ", ancestor, "` is false and its entry could not be read while establishing",
                  " the absence of ", path, " (", r as String, "), so the path's absence is not established",
                ], "") as NonEmptyStr,
              }
            // Not in its own parent: the answer waits for the level above, which is why the walk climbs.
            PathAbsentOrUnstattable => AncestorIsAbsentOrUnstattable
          }
      }
  }
}

// THE WALK, PURE OVER THE CHAIN a driver collected nearest-first. The first ancestor that answers
// decides; when none answers present-and-searchable the absence is NOT established, and the answer is
// ContainedUnreadable rather than a quiet ContainedAbsent.
fn absent_under_nearest_present_ancestor(path: String, chain: List<AncestorExistenceProbe>) -> ContainedExistence {
  match chain {
    Empty =>
      ContainedUnreadable {
        reason: join([
          "`test -e ", path, "` is false and no ancestor of it read present and searchable, so nothing",
          " searched for ", path, " and the path's absence is not established",
        ], "") as NonEmptyStr,
      }
    Cons { head: probe, tail: rest } =>
      match ancestor_walk_step(path: path, probe: probe) {
        AncestorEstablishesAbsence => ContainedAbsent
        AncestorRefuses { reason: r } => ContainedUnreadable { reason: r }
        AncestorIsAbsentOrUnstattable => absent_under_nearest_present_ancestor(path: path, chain: rest)
      }
  }
}
