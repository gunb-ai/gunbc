module extdeps.netfilter.iptables_legacy

import std.types { String, NonEmptyStr, List, FilePath }
import extdeps.tools { CliTool, SourceApt }
import extdeps.apt { apt_sbin_dir, apt_installed_bin_path, package_iptables }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "git.netfilter.org/iptables/tree/iptables/iptables-save.c"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.netfilter.iptables_legacy",
      decl_name: "iptables_legacy_save_program",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE LEGACY xtables PATH, WHICH IS A DIFFERENT KERNEL SURFACE FROM nftables AND NOT A SPELLING OF
// IT. `iptables-legacy-save` is the variant linked against the xtables (ip_tables) backend rather
// than the nf_tables backend `iptables-nft` uses, so it reads rules that `nft list ruleset` cannot
// see. A host carrying legacy rules alongside an nft ruleset has two rule sets in two kernel
// subsystems, and only reading both says what is actually installed.
data iptables_legacy_save_program: NonEmptyStr = "iptables-legacy-save"

// NO ArgvCommand BUILDER HERE, DELIBERATELY. The only consumer in this repository reaches this
// program through a privileged read projection that prepends its own sudo binary path, so it needs
// the ARGUMENT WORDS and not a command whose program field it would discard. Adding a builder
// nothing calls would be the dangling declaration DESIGN 3c refuses; it belongs here the day a
// direct invocation exists to consume it.
//
// SAVE TAKES NO ARGUMENTS FOR A WHOLE-HOST DUMP. iptables-save(8) prints every table it can read on
// stdout; the arguments it does accept (-t, -c) NARROW that, so the empty list is the complete
// reading rather than a default.
data iptables_legacy_save_arguments: List<NonEmptyStr> = []

// WHERE iptables-legacy-save IS INSTALLED IS STATED ONCE, HERE. Ubuntu noble ships it in the `iptables` package
// at /usr/sbin/iptables-legacy-save (packages.ubuntu.com/noble/amd64/iptables/filelist). The apt row below and
// gunbc.fleet_posix_accounts' exec path both derive from iptables_legacy_save_bin_dir, so they cannot disagree.
data iptables_legacy_save_bin_dir: FilePath = apt_sbin_dir

fn iptables_legacy_save_installed_path() -> FilePath {
  apt_installed_bin_path(bin_dir: iptables_legacy_save_bin_dir, binary: iptables_legacy_save_program)
}

data iptables_legacy_save_cli_tool: CliTool = CliTool {
  name: iptables_legacy_save_program,
  min_version: none,
  installable_via: [SourceApt { package: package_iptables, bin_dir: iptables_legacy_save_bin_dir }],
}
