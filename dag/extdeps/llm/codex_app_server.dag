  JsonValue,
  json_kv,
  json_int,
  json_string,
  json_object,
  json_array,
  serialize_json,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openai/codex"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.llm.codex_app_server",
      decl_name: "CodexAppServerTransport",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.llm.codex_app_server.extdeps_external_authority_anchor,
  further_citations: []
}

data codex_app_server_subject_note: String = "THE SUBJECT IS the Codex app-server control interface (stdio/JSON-RPC methods) — not exec --json and not gunbc product policy. Method strings below are cited from `codex app-server generate-json-schema` against @openai/codex 0.146.0 (ClientRequest oneOf enum values). Wire request/response shapes land with the JSON-AST reader next; do not invent alternate method spellings."

type CodexAppServerTransport
  = CodexAppServerStdio
  | CodexAppServerUnixSocket {
      path: FilePath
    }

type CodexAppServerMethod
  = CodexAppServerInitialize
  | CodexAppServerAccountRead
  | CodexAppServerAccountRateLimitsRead
  | CodexAppServerThreadStart
  | CodexAppServerTurnStart

fn codex_app_server_method_wire_name(method: CodexAppServerMethod) -> NonEmptyStr {
  match method {
    CodexAppServerInitialize => "initialize" as NonEmptyStr
    CodexAppServerAccountRead => "account/read" as NonEmptyStr
    CodexAppServerAccountRateLimitsRead => "account/rateLimits/read" as NonEmptyStr
    CodexAppServerThreadStart => "thread/start" as NonEmptyStr
    CodexAppServerTurnStart => "turn/start" as NonEmptyStr
  }
}

data codex_app_server_method_note: String = "FIRST PRESS SLICE method sequence from the generated ClientRequest schema: initialize → account/read → account/rateLimits/read → thread/start → turn/start. There is no `thread/turn` or bare `rateLimits/read` method in 0.146.0."

type CodexAppServerExecutable {
  path: FilePath
}

// The `generate-json-schema` subcommand is a separate invocation of the SAME executable this
// module cites the protocol schema from (codex_app_server_subject_note) — it is the tool this
// module's method vocabulary was derived from, not a different product surface.
service codex_app_server.Cli {
  operation GenerateJsonSchema {
    input { executable: CodexAppServerExecutable, output_dir: FilePath }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["{executable.path}", "app-server", "generate-json-schema", "-o", "{output_dir}"]
    }
    exit {
      0 => Unit
      nonzero => String "codex app-server generate-json-schema failed"
    }
  }
}

data codex_app_server_request_line_emit_note: String = "Request lines are BUILT through extdeps.languages.json.emit, not hand-authored as escaped string literals (review 50540). The literals they replace carried their own JSON grammar — braces, quoting and separators spelled out in \\{ and \\\" escapes — which is a second JSON representation sitting beside the module that already owns one (DESIGN §3 dual representation), and it is the representation that cannot escape a value: a method name or client field containing a quote would have produced a malformed frame with nothing to refuse it. serialize_json applies the escaping, so the wire bytes are a consequence of the modeled value rather than of an author getting the backslashes right."

fn codex_app_server_jsonrpc_request(id: Int, method: String, params: JsonValue) -> NonEmptyStr {
  serialize_json(
    v: json_object(
      members: [
        json_kv(key: "jsonrpc", value: json_string(s: "2.0")),
        json_kv(key: "id", value: json_int(n: id)),
        json_kv(key: "method", value: json_string(s: method)),
        json_kv(key: "params", value: params),
      ],
    ),
  ) as NonEmptyStr
}

fn codex_app_server_initialize_request_line() -> NonEmptyStr {
  codex_app_server_jsonrpc_request(
    id: 1,
    method: "initialize",
    params: json_object(
      members: [
        json_kv(
          key: "clientInfo",
          value: json_object(
            members: [
              json_kv(key: "name", value: json_string(s: "gunbc")),
              json_kv(key: "title", value: json_string(s: "gunbc")),
              json_kv(key: "version", value: json_string(s: "0")),
            ],
          ),
        ),
        json_kv(key: "capabilities", value: json_object(members: [])),
      ],
    ),
  )
}

fn codex_app_server_initialized_notification_line() -> NonEmptyStr {
  serialize_json(
    v: json_object(
      members: [
        json_kv(key: "jsonrpc", value: json_string(s: "2.0")),
        json_kv(key: "method", value: json_string(s: "initialized")),
      ],
    ),
  ) as NonEmptyStr
}

fn codex_app_server_account_read_request_line() -> NonEmptyStr {
  codex_app_server_jsonrpc_request(
    id: 2,
    method: "account/read",
    params: json_object(members: []),
  )
}

fn codex_app_server_rate_limits_read_request_line() -> NonEmptyStr {
  codex_app_server_jsonrpc_request(
    id: 3,
    method: "account/rateLimits/read",
    params: json_object(members: []),
  )
}

data codex_supervised_session_rpc_id_note: String = "Supervised turn session ids: initialize=1, account/read=2, account/rateLimits/read=3, thread/start=4, turn/start=5. account/read and account/rateLimits/read run in the same app-server occurrence as turn/start; standing is parsed from that session stdout, not from a prior preflight receipt. turn/start json-rpc id is fixed at 5; client_command_id on CodexRunnerTurnTerminalReceipt is the attempt/turn identity string for exactly-once correlation, not necessarily equal to the wire id."

data codex_supervised_thread_start_id: Int = 4
data codex_supervised_turn_start_wire_id: Int = 5

data codex_thread_start_result_thread_key: NonEmptyStr = "thread" as NonEmptyStr
data codex_turn_start_result_turn_key: NonEmptyStr = "turn" as NonEmptyStr
data codex_entity_id_key: NonEmptyStr = "id" as NonEmptyStr
data codex_turn_start_params_thread_id_key: NonEmptyStr = "threadId" as NonEmptyStr
data codex_turn_start_params_input_key: NonEmptyStr = "input" as NonEmptyStr
data codex_turn_input_text_type_key: NonEmptyStr = "type" as NonEmptyStr
data codex_turn_input_text_value_key: NonEmptyStr = "text" as NonEmptyStr

fn codex_app_server_thread_start_request_line(cwd: FilePath) -> NonEmptyStr {
  codex_app_server_jsonrpc_request(
    id: codex_supervised_thread_start_id,
    method: "thread/start",
    params: json_object(
      members: [
        json_kv(key: "cwd", value: json_string(s: cwd as String)),
      ],
    ),
  )
}

fn codex_app_server_turn_start_request_line(
  thread_id: NonEmptyStr,
  user_input: String,
) -> NonEmptyStr {
  codex_app_server_jsonrpc_request(
    id: codex_supervised_turn_start_wire_id,
    method: "turn/start",
    params: json_object(
      members: [
        json_kv(
          key: codex_turn_start_params_thread_id_key as String,
          value: json_string(s: thread_id as String),
        ),
        json_kv(
          key: codex_turn_start_params_input_key as String,
          value: json_array(
            elements: [
              json_object(
                members: [
                  json_kv(
                    key: codex_turn_input_text_type_key as String,
                    value: json_string(s: "text"),
                  ),
                  json_kv(
                    key: codex_turn_input_text_value_key as String,
                    value: json_string(s: user_input),
                  ),
                ],
              ),
            ],
          ),
        ),
      ],
    ),
  )
}

data codex_app_server_initialized_handshake_note: String = "After initialize succeeds the client MUST send the initialized ClientNotification (method initialized, no id) before account/rateLimits/read. Without it the server may return no id=3 response at all — a missing-handshake Incomplete, not a wrong method name."

data codex_app_server_response_shape_note: String = "Response carriers for initialize / account/read / account/rateLimits/read are grounded here as cited wire field keys from the 0.146 generate-json-schema ClientRequest companion responses. Full AST decoder types that bind protocol_schema_identity are the dissolve-on; until then product modules MUST consume these keys rather than invent alternate spellings."

