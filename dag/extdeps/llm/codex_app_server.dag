module extdeps.llm.codex_app_server

import std.types { NonEmptyStr, String, FilePath }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openai/codex"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.llm.codex_app_server",
      decl_name: "CodexAppServerTransport",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.llm.codex_app_server.extdeps_external_authority_anchor,
  further_citations: []
}

data codex_app_server_subject_note: String = "THE SUBJECT IS the Codex app-server control interface (stdio/JSON-RPC methods) — not exec --json and not gunbc product policy. Method strings below are cited from `codex app-server generate-json-schema` against @openai/codex 0.146.0 (ClientRequest oneOf enum values). Wire request/response shapes land with the JSON-AST reader next; do not invent alternate method spellings."

type CodexAppServerTransport
  = CodexAppServerStdio
  | CodexAppServerUnixSocket {
      path: FilePath
    }

type CodexAppServerMethod
  = CodexAppServerInitialize
  | CodexAppServerAccountRead
  | CodexAppServerAccountRateLimitsRead
  | CodexAppServerThreadStart
  | CodexAppServerTurnStart

fn codex_app_server_method_wire_name(method: CodexAppServerMethod) -> NonEmptyStr {
  match method {
    CodexAppServerInitialize => "initialize" as NonEmptyStr
    CodexAppServerAccountRead => "account/read" as NonEmptyStr
    CodexAppServerAccountRateLimitsRead => "account/rateLimits/read" as NonEmptyStr
    CodexAppServerThreadStart => "thread/start" as NonEmptyStr
    CodexAppServerTurnStart => "turn/start" as NonEmptyStr
  }
}

data codex_app_server_method_note: String = "FIRST PRESS SLICE method sequence from the generated ClientRequest schema: initialize → account/read → account/rateLimits/read → thread/start → turn/start. There is no `thread/turn` or bare `rateLimits/read` method in 0.146.0."

type CodexAppServerExecutable {
  path: FilePath
}

fn codex_app_server_initialize_request_line() -> NonEmptyStr {
  concat(
    "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":",
    "\{\"clientInfo\":\{\"name\":\"gunbc\",\"title\":\"gunbc\",\"version\":\"0\"\},\"capabilities\":\{\}\}\}",
  ) as NonEmptyStr
}
