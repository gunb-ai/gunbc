module extdeps.llm.codex_app_server

import std.types { NonEmptyStr, String, FilePath }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openai/codex"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.llm.codex_app_server",
      decl_name: "CodexAppServerTransport",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.llm.codex_app_server.extdeps_external_authority_anchor,
  further_citations: []
}

data codex_app_server_subject_note: String = "THE SUBJECT IS the Codex app-server control interface (stdio/JSON-RPC methods) — not exec --json and not gunbc product policy. Method strings below are cited from `codex app-server generate-json-schema` against @openai/codex 0.146.0 (ClientRequest oneOf enum values). Wire request/response shapes land with the JSON-AST reader next; do not invent alternate method spellings."

type CodexAppServerTransport
  = CodexAppServerStdio
  | CodexAppServerUnixSocket {
      path: FilePath
    }

type CodexAppServerMethod
  = CodexAppServerInitialize
  | CodexAppServerAccountRead
  | CodexAppServerAccountRateLimitsRead
  | CodexAppServerThreadStart
  | CodexAppServerTurnStart

fn codex_app_server_method_wire_name(method: CodexAppServerMethod) -> NonEmptyStr {
  match method {
    CodexAppServerInitialize => "initialize" as NonEmptyStr
    CodexAppServerAccountRead => "account/read" as NonEmptyStr
    CodexAppServerAccountRateLimitsRead => "account/rateLimits/read" as NonEmptyStr
    CodexAppServerThreadStart => "thread/start" as NonEmptyStr
    CodexAppServerTurnStart => "turn/start" as NonEmptyStr
  }
}

data codex_app_server_method_note: String = "FIRST PRESS SLICE method sequence from the generated ClientRequest schema: initialize → account/read → account/rateLimits/read → thread/start → turn/start. There is no `thread/turn` or bare `rateLimits/read` method in 0.146.0."

type CodexAppServerExecutable {
  path: FilePath
}

fn codex_app_server_initialize_request_line() -> NonEmptyStr {
  concat(
    "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":",
    "\{\"clientInfo\":\{\"name\":\"gunbc\",\"title\":\"gunbc\",\"version\":\"0\"\},\"capabilities\":\{\}\}\}",
  ) as NonEmptyStr
}

fn codex_app_server_initialized_notification_line() -> NonEmptyStr {
  "\{\"jsonrpc\":\"2.0\",\"method\":\"initialized\"\}" as NonEmptyStr
}

fn codex_app_server_account_read_request_line() -> NonEmptyStr {
  "\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"account/read\",\"params\":\{\}\}" as NonEmptyStr
}

fn codex_app_server_rate_limits_read_request_line() -> NonEmptyStr {
  "\{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"account/rateLimits/read\",\"params\":\{\}\}" as NonEmptyStr
}

data codex_app_server_initialized_handshake_note: String = "After initialize succeeds the client MUST send the initialized ClientNotification (method initialized, no id) before account/rateLimits/read. Without it the server may return no id=3 response at all — a missing-handshake Incomplete, not a wrong method name."

data codex_app_server_response_shape_note: String = "Response carriers for initialize / account/read / account/rateLimits/read are grounded here as cited wire field keys from the 0.146 generate-json-schema ClientRequest companion responses. Full AST decoder types that bind protocol_schema_identity are the dissolve-on; until then product modules MUST consume these keys rather than invent alternate spellings."

data codex_initialize_result_user_agent_key: NonEmptyStr = "userAgent" as NonEmptyStr
data codex_account_read_result_requires_openai_auth_key: NonEmptyStr = "requiresOpenaiAuth" as NonEmptyStr
data codex_account_read_result_account_key: NonEmptyStr = "account" as NonEmptyStr
data codex_rate_limits_result_rate_limits_key: NonEmptyStr = "rateLimits" as NonEmptyStr
data codex_rate_limits_result_by_limit_id_key: NonEmptyStr = "rateLimitsByLimitId" as NonEmptyStr
data codex_rate_limits_snapshot_limit_id_key: NonEmptyStr = "limitId" as NonEmptyStr
data codex_rate_limits_snapshot_primary_key: NonEmptyStr = "primary" as NonEmptyStr
data codex_rate_limits_snapshot_secondary_key: NonEmptyStr = "secondary" as NonEmptyStr
data codex_rate_limits_snapshot_spend_control_reached_key: NonEmptyStr = "spendControlReached" as NonEmptyStr
data codex_rate_limits_snapshot_rate_limit_reached_type_key: NonEmptyStr = "rateLimitReachedType" as NonEmptyStr
data codex_rate_limits_window_used_percent_key: NonEmptyStr = "usedPercent" as NonEmptyStr
data codex_rate_limits_window_resets_at_key: NonEmptyStr = "resetsAt" as NonEmptyStr
