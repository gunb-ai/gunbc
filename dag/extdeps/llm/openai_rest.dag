module extdeps.llm.openai_rest


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "platform.openai.com/docs/api-reference/introduction"
  }
}

service llm.OpenAI {
  config {
    endpoint: "https://api.openai.com"
    auth: Bearer
    auth_input: api_key

    rate_limit: { requests: 500, per: minute, scope: chat }
  }

  operation ChatCompletion {
    input {
      api_key: Secret
      model: String
      messages: List<extdeps.llm.openai.OpenAiChatMessage>
      temperature: Float?
      max_tokens: Int?
    }
    output {
      content: String from "choices/0/message/content"
      model: String from "model"
      finish_reason: extdeps.llm.openai.OpenAiFinishReason from "choices/0/finish_reason"
      prompt_tokens: Int from "usage/prompt_tokens"
      completion_tokens: Int from "usage/completion_tokens"
    }
    transport rest {
      method: POST,
      path: "/v1/chat/completions",
      body: { model: model, messages: messages, temperature: temperature, max_tokens: max_tokens }
    }
    response {
      200 => extdeps.llm.openai.OpenAiChatCompletion200Body
      400 => extdeps.llm.openai_errors.OpenAiErrorShape
      401 => extdeps.llm.openai_errors.OpenAiErrorShape
      403 => extdeps.llm.openai_errors.OpenAiErrorShape
      404 => extdeps.llm.openai_errors.OpenAiErrorShape
      429 => extdeps.llm.openai_errors.OpenAiErrorShape
      5xx => extdeps.llm.openai_errors.OpenAiErrorShape
    }
  }

  operation Responses {
    input {
      api_key: Secret
      model: String
      input: Json
      instructions: String?
      max_output_tokens: Int?
    }
    output {
      content: String from "output/0/content/0/text"
      model: String from "model"
      output_tokens: Int from "usage/output_tokens"
      input_tokens: Int from "usage/input_tokens"
    }
    transport rest {
      method: POST,
      path: "/v1/responses",
      body: { model: model, input: input, instructions: instructions, max_output_tokens: max_output_tokens }
    }
    response {
      200 => extdeps.llm.openai.OpenAiResponses200Body
      400 => extdeps.llm.openai_errors.OpenAiErrorShape
      401 => extdeps.llm.openai_errors.OpenAiErrorShape
      403 => extdeps.llm.openai_errors.OpenAiErrorShape
      404 => extdeps.llm.openai_errors.OpenAiErrorShape
      429 => extdeps.llm.openai_errors.OpenAiErrorShape
      5xx => extdeps.llm.openai_errors.OpenAiErrorShape
    }
  }
}
