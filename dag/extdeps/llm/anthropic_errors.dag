module extdeps.llm.anthropic_errors

import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.anthropic.com/en/api/errors"
  }
}

type AnthropicErrorEnvelopeType
  = AnthropicErrorEnvelope {}

data anthropic_error_envelope_error_wire: String = "error"

fn anthropic_error_envelope_type_label(kind: AnthropicErrorEnvelopeType) -> String {
  match kind {
    AnthropicErrorEnvelope {} => anthropic_error_envelope_error_wire
  }
}

type AnthropicErrorType
  = AnthropicAuthenticationError
  | AnthropicInvalidRequestError
  | AnthropicRateLimitError
  | AnthropicOverloadedError
  | AnthropicNotFoundError
  | AnthropicApiError
  | AnthropicErrorTypeOther { raw: NonEmptyStr }

data anthropic_error_authentication_wire: String = "authentication_error"
data anthropic_error_invalid_request_wire: String = "invalid_request_error"
data anthropic_error_rate_limit_wire: String = "rate_limit_error"
data anthropic_error_overloaded_wire: String = "overloaded_error"
data anthropic_error_not_found_wire: String = "not_found_error"
data anthropic_error_api_wire: String = "api_error"

fn parse_anthropic_error_type(raw: String) -> AnthropicErrorType {
  if raw == anthropic_error_authentication_wire { AnthropicAuthenticationError }
  else if raw == anthropic_error_invalid_request_wire { AnthropicInvalidRequestError }
  else if raw == anthropic_error_rate_limit_wire { AnthropicRateLimitError }
  else if raw == anthropic_error_overloaded_wire { AnthropicOverloadedError }
  else if raw == anthropic_error_not_found_wire { AnthropicNotFoundError }
  else if raw == anthropic_error_api_wire { AnthropicApiError }
  else { AnthropicErrorTypeOther { raw: raw } }
}

fn anthropic_error_type_label(kind: AnthropicErrorType) -> String {
  match kind {
    AnthropicAuthenticationError => anthropic_error_authentication_wire
    AnthropicInvalidRequestError => anthropic_error_invalid_request_wire
    AnthropicRateLimitError => anthropic_error_rate_limit_wire
    AnthropicOverloadedError => anthropic_error_overloaded_wire
    AnthropicNotFoundError => anthropic_error_not_found_wire
    AnthropicApiError => anthropic_error_api_wire
    AnthropicErrorTypeOther { raw: r } => r
  }
}

type AnthropicErrorDetails {
  type: AnthropicErrorType
  message: String
}

type AnthropicErrorShape {
  type: AnthropicErrorEnvelopeType
  error: AnthropicErrorDetails
}

data anthropic_error_example: AnthropicErrorShape = {
  type: AnthropicErrorEnvelope {},
  error: {
    type: AnthropicAuthenticationError,
    message: "invalid x-api-key"
  }
}
