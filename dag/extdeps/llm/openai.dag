data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "platform.openai.com/docs/api-reference/chat/create"
  }
}

// THE SECOND ANCHOR, AND WHY THERE IS ONE. platform.openai.com answers 403 to a programmatic fetch,
// so a claim made "from the docs, read today" cannot be re-checked by anyone who tries. The
// openai-python client's types are GENERATED from OpenAI's OpenAPI spec by that vendor, so they are
// the docs' own machine-readable form and a reader can fetch the same bytes: the tree below is pinned
// to a commit, and the package version at that commit is 3.42.0. Where this section cites a member's
// name, optionality or enumerated values, it is read off these generated types; where the prose
// explains a meaning, it is the docs anchor. DESIGN section 3 -- cite the source, keep its real names,
// declare its version.
data extdeps_generated_sdk_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openai/openai-python/tree/0dcd904bc2fed26c737d9740bca5f6b0ecc4cb7f/src/openai/types"
  }
}

