module extdeps.llm.anthropic_rest

import extdeps.ietf.http_semantics { POST }
import extdeps.llm.anthropic_messages_api {
  AnthropicChatMessage,
  AnthropicMessages200Body,
  AnthropicStopReason,
  current_api_version
}
import extdeps.llm.anthropic_errors { AnthropicErrorShape }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { NonEmptyStr, Unit, Secret }
import std.optional { Present, Absent }
import extdeps.api_rate_limit { UpstreamRateLimit, RateLimitPeriod, PerMinute }
import std.resources { Network }
import extdeps.ietf.http_semantics { POST }
import extdeps.transports.rest { RestResult, RestRefusal, rest_credential_absent }
import extdeps.shell.credentials { env_credential }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.anthropic.com/en/docs/claude-code"
  }
}

service llm.Anthropic {
  config {
    endpoint: "https://api.anthropic.com"
    auth: Header("x-api-key")
    auth_input: api_key

  }

  operation Messages {
    requires Network
    input {
      api_key: Secret
      model: String
      messages: List<AnthropicChatMessage>
      max_tokens: Int = 4096
      temperature: Float?
      system: String?
    }
    output {
      content: String from "content/0/text"
      model: String from "model"
      stop_reason: AnthropicStopReason from "stop_reason"
      input_tokens: Int from "usage/input_tokens"
      output_tokens: Int from "usage/output_tokens"
    }
    transport rest {
      method: POST,
      path: "/v1/messages",
      body: { model: model, messages: messages, max_tokens: max_tokens, temperature: temperature, system: system },
      headers: { "anthropic-version": current_api_version.version }
    }
    response {
      200 => AnthropicMessages200Body
      400 => AnthropicErrorShape
      401 => AnthropicErrorShape
      403 => AnthropicErrorShape
      404 => AnthropicErrorShape
      429 => AnthropicErrorShape
      529 => AnthropicErrorShape
      5xx => AnthropicErrorShape
    }
  }

  operation CliPrompt {
    requires opaque
    input {
      prompt: String
      model: String = "opus"
      effort: String = "max"
      output_format: String = "text"
      permission_mode: String = "plan"
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "claude", "-p",
        "--output-format", "{output_format}",
        "--permission-mode", "{permission_mode}",
        "--model", "{model}",
        "--effort", "{effort}",
        "{prompt}"
      ]
    }
    exit {
      0 => Unit
      nonzero => String "Claude CLI failed"
    }
  }
}

// The Messages API request limit for this account tier as published: 1,000 requests per minute.
data anthropic_messages_rate_limit: UpstreamRateLimit = UpstreamRateLimit { upstream: "anthropic" as NonEmptyStr, scope: "messages" as NonEmptyStr, requests: 1000, period: PerMinute }


// THE KEY IS SELECTED BY ITS CALLER. The service once also declared `auth_source: EnvVar { name:
// "ANTHROPIC_API_KEY" }` beside `auth_input: api_key`, and the interpreter read that variable whenever
// the input was empty, so `api_key: ""` silently meant the process environment. A caller that means the
// environment's key reads it here; an unset variable is refused before any request is built.
data anthropic_api_key_env: NonEmptyStr = "ANTHROPIC_API_KEY" as NonEmptyStr

type AnthropicApiKeyRead
  = AnthropicApiKeyObserved { key: Secret }
  | AnthropicApiKeyUnavailable { refusal: RestRefusal }

fn anthropic_api_key_from_environment() -> AnthropicApiKeyRead {
  match env_credential(env_var: anthropic_api_key_env).token {
    Present { value: key } => AnthropicApiKeyObserved { key: key }
    Absent => AnthropicApiKeyUnavailable {
      refusal: rest_credential_absent(evidence: anthropic_api_key_env, profile: "extdeps.llm.anthropic_rest", action: "present an Anthropic API key"),
    }
  }
}
