module extdeps.llm.codex_app_server_stdio_session

import std.types { String, NonEmptyStr, Int, List, FilePath }

data codex_app_server_stdio_session_authority_note: String = "Typed transport shape for a held-open Codex app-server --stdio JSON-RPC session (initialize through turn/start). Wire lines are modeled values serialized through extdeps.llm.codex_app_server serialize_json emitters — never hand-built JSON in shell. Coprocess mechanics (fifo, setsid, held stdin fd, poll-to-terminal, process-group kill) realize through host_effect_apply on a session driver that writes preamble_lines, polls stdout for thread/start id=4, builds turn/start via JSON parse+re-serialize (no sed), persists client_command_id, then captures stdout/stderr/exit. Operator verdict #8166 RejectAndFinishNow: hand-built bash coprocess scaffold deleted; this shape is the replacement authority."

data codex_supervised_worker_turn_driver_frontier_note: String = "NATIVE SESSION DRIVER NOT LANDED. CodexSupervisedWorkerTurn routes through host_effect_apply; realize_codex_supervised_worker_turn_on_host refuses until the coprocess driver lands (argv/thin-run session helper or interpreter builtin). Wet terminal receipt must execute through this path."

type CodexAppServerStdioSessionIntent {
  executable: FilePath
  codex_home: FilePath
  cwd: FilePath
  preamble_lines: List<NonEmptyStr>
  user_input: String
  client_command_id_path: String
  thread_start_rpc_id: Int
  turn_start_wire_id: Int
}
