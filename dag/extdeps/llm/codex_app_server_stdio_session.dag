data codex_app_server_stdio_session_authority_note: String = "Typed transport shape for a held-open Codex app-server --stdio JSON-RPC session (initialize through turn/start). Wire lines are modeled values serialized through extdeps.llm.codex_app_server serialize_json emitters — never hand-built JSON in shell. Coprocess mechanics (fifo, setsid, held stdin fd, poll-to-terminal, process-group kill) realize through host_effect_apply on a session driver that writes preamble_lines, polls stdout for thread/start id=4, builds turn/start via JSON parse+re-serialize (no sed), persists client_command_id, then captures stdout/stderr/exit. Operator verdict #8166 RejectAndFinishNow: hand-built bash coprocess scaffold deleted; this shape is the replacement authority. Subject: the Codex app-server stdio session transport (same upstream as extdeps.llm.codex_app_server @openai/codex 0.146.0 ClientRequest slice through turn/start)."

data codex_supervised_worker_turn_driver_frontier_note: String = "LANDED (#8166): native session driver at target/release/codex_app_server_stdio_session, invoked through gunbc.host_effect_codex_supervised_turn + host_effect_apply CodexSupervisedWorkerTurn. Coprocess uses pipe stdin, setsid process group, JSON turn/start (no sed). Wet terminal receipt must execute through this path."

type CodexAppServerStdioSessionIntent {
  executable: std.types.FilePath
  codex_home: std.types.FilePath
  cwd: std.types.FilePath
  preamble_lines: List<std.types.NonEmptyStr>
  user_input: String
  client_command_id_path: String
  thread_start_rpc_id: Int
  turn_start_wire_id: Int
}
