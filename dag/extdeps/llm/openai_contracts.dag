module extdeps.llm.openai_contracts


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "platform.openai.com/docs/api-reference/chat/create"
  }
}

data wire_contract: VariantEncoding = llm_snake_wire_contract

data openai_chat_message_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.llm.openai", decl_name: "OpenAiChatMessage", field: WholeDeclaration },
  encoding: InternallyTaggedObject { tag_field: "role", naming: StripPrefixAndSnakeCase { prefix: "OpenAiChatMessage" } }
}

data openai_chat_message_part_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.llm.openai", decl_name: "OpenAiChatMessagePart", field: WholeDeclaration },
  encoding: InternallyTaggedObject { tag_field: "type", naming: StripPrefixSuffixAndSnakeCase { prefix: "OpenAiChatMessage", suffix: "Part" } }
}

data openai_chat_message_content_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.llm.openai", decl_name: "OpenAiChatMessageContent", field: WholeDeclaration },
  encoding: UntaggedVariant
}
