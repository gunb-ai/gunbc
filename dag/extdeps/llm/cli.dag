module extdeps.llm.cli

import std.types { List, String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openai/codex"
  }
}

data claude_cli_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.claude.com/en/docs/claude-code/cli-reference"
  }
}

fn shape_claude_invoke_argv(
  session_id: String,
  node_id: String,
  effort: String,
  settings_json: String,
  append_system_prompt: String,
  start_prompt: String,
  permission_args: List<String>,
) -> List<String> {
  concat(
    ["claude"],
    concat(
      permission_args,
      [
        "--settings", settings_json,
        "--effort", effort,
        "--session-id", session_id,
        "-n", node_id,
        "--append-system-prompt", append_system_prompt,
        start_prompt,
      ],
    ),
  )
}

service llm.Codex {
  operation Review {
    input {
      prompt: String
      cwd: String
      model: String = "o4-mini"
      reasoning_effort: String = "high"
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "codex", "exec",
        "-m", "{model}",
        "-c", "model_reasoning_effort=\"{reasoning_effort}\"",
        "-C", "{cwd}",
        "-"
      ]
      stdin: prompt
    }
    exit {
      0 => Unit
      nonzero => String "Codex CLI failed"
    }
  }
}

service claude.Invoke {
  operation Run {
    input {
      session_id: String
      node_id: String
      effort: String
      settings_json: String
      append_system_prompt: String
      start_prompt: String
      permission_args: List<String> = []
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "claude", permission_args,
        "--settings", "{settings_json}",
        "--effort", "{effort}",
        "--session-id", "{session_id}",
        "-n", "{node_id}",
        "--append-system-prompt", "{append_system_prompt}",
        "{start_prompt}"
      ]
    }
    exit {
      0 => Unit
      nonzero => String "Claude CLI invocation failed"
    }
  }
}

service llm.Gemini {
  operation CliPrompt {
    input {
      prompt: String
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "gemini", "-p", "{prompt}",
        "--output-format", "text",
        "--approval-mode", "plan"
      ]
    }
    exit {
      0 => Unit
      nonzero => String "Gemini CLI failed"
    }
  }
}
