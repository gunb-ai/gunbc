data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.anthropic.com/en/api/messages"
  }
}

// THE SUBJECT IS THE SPECIFICATION, NOT THE COMPANY THAT PUBLISHES IT. The messages/tool-use wire
// shape is a shared standard with more than one independently governed implementation, so under
// DESIGN section 3's external-upstream-decomposition rule it gets its own module and each
// implementation cites it — the extdeps.whatwg.html_navigation position, not the
// extdeps.browser.chromium one. It keeps the publisher's real names because section 3 forbids
// coining a neutral second name for a concept that already has one; extdeps.llm.anthropic keeps
// only what is a fact about the API PRODUCT (its model roster), and extdeps.ollama.api declares its
// own conformance against this module rather than restating the shape.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.llm.anthropic_messages_api",
      decl_name: "AnthropicApiVersion",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [
    ExternalAuthority {
      uri: Uri {
        scheme: Https
        locator: "github.com/anthropics/anthropic-sdk-python/blob/main/src/anthropic/types/message_param.py"
      }
    },
    ExternalAuthority {
      uri: Uri {
        scheme: Https
        locator: "github.com/anthropics/anthropic-sdk-python/blob/main/src/anthropic/types/plain_text_source_param.py"
      }
    }
  ]
}

// THE SPECIFICATION'S OWN VERSION AXIS, which is what makes this a citable standard rather than a
// snapshot: the revision is selected by a request header, so it is a fact about the spec and not
// about any one implementation.
type AnthropicApiVersion {
  version: String
  header: String
}

data current_api_version: AnthropicApiVersion = {
  version: "2023-06-01",
  header: "anthropic-version"
}

// HOW AN IMPLEMENTATION TREATS THE VERSION HEADER IS PART OF ITS CONTRACT, not a detail. The
// publisher selects a spec revision with it; a second implementation may accept it and ignore it,
// which means a caller cannot conclude from an accepted request that the revision it asked for is
// the revision it got. Modeling the two as one Bool would erase that, so the axis is a coproduct
// and every conformance row must state its arm.
type MessagesApiVersionBinding
  = VersionHeaderSelectsRevision {}
  | VersionHeaderAcceptedUnused {}

// The carrier by which an IMPLEMENTATION declares that it serves this specification. It is
// deliberately product-agnostic: this module names no implementation, enumerates no product and
// dispatches among no authorities — each implementation module declares its own row, pointing
// symbolically at the declaration of its own that serves the spec, and citing its own upstream for
// that claim. Carrying a roster here instead would be the enumerate-concrete-products violation the
// external-upstream-decomposition rule names.
//
// The request path is NOT a field: each implementation already owns its own endpoint authority
// (extdeps.ollama.api ollama_endpoint_path, extdeps.llm.anthropic_rest's transport row), and a path
// restated here would be a second authority for it.
type MessagesApiImplementation {
  implementation: ExternalSubjectRef
  spec_version: AnthropicApiVersion
  version_binding: MessagesApiVersionBinding
  citation: ExternalAuthority
}

fn messages_api_version_header_is_honored(binding: MessagesApiVersionBinding) -> Bool {
  match binding {
    VersionHeaderSelectsRevision {} => true
    VersionHeaderAcceptedUnused {} => false
  }
}

type AnthropicImageMediaType
  = ImageJpeg
  | ImagePng
  | ImageGif
  | ImageWebp
  | AnthropicImageMediaTypeOther { raw: NonEmptyStr }

data anthropic_image_jpeg_wire: String = "image/jpeg"
data anthropic_image_png_wire: String = "image/png"
data anthropic_image_gif_wire: String = "image/gif"
data anthropic_image_webp_wire: String = "image/webp"

fn parse_anthropic_image_media_type(raw: String) -> AnthropicImageMediaType {
  if raw == anthropic_image_jpeg_wire { ImageJpeg }
  else if raw == anthropic_image_png_wire { ImagePng }
  else if raw == anthropic_image_gif_wire { ImageGif }
  else if raw == anthropic_image_webp_wire { ImageWebp }
  else { AnthropicImageMediaTypeOther { raw: raw } }
}

fn anthropic_image_media_type_label(kind: AnthropicImageMediaType) -> String {
  match kind {
    ImageJpeg => anthropic_image_jpeg_wire
    ImagePng => anthropic_image_png_wire
    ImageGif => anthropic_image_gif_wire
    ImageWebp => anthropic_image_webp_wire
    AnthropicImageMediaTypeOther { raw: r } => r
  }
}

type ImageSource
  = Base64Image { media_type: AnthropicImageMediaType, data: String }
  | UrlImage { url: String }

type AnthropicToolResultContent
  = ToolResultText(String)
  | ToolResultBlocks(List<AnthropicToolResultBlock>)

type AnthropicToolResultWireTextTag
  = Text {}

type AnthropicPlainTextDocumentMediaType
  = TextPlain {}

type AnthropicToolResultTextBlock {
  type: AnthropicToolResultWireTextTag
  text: String
}

type AnthropicSearchResultCitationsConfig {
  enabled: Bool
}

type AnthropicToolResultBlock
  = AnthropicTextBlock { text: String }
  | AnthropicImageBlock { source: ImageSource }

  | AnthropicDocumentBlock { source: AnthropicToolResultPlainTextDocumentSource }
  | AnthropicSearchResultBlock {
      source: String
      title: String
      content: List<AnthropicToolResultTextBlock>
      citations: AnthropicSearchResultCitationsConfig?
      cache_control: CacheControl?
    }
  | AnthropicToolReferenceBlock { tool_name: String }

