module extdeps.publication

import std.integer { Int }
import std.logic { Bool }
import std.types { NonEmptyStr, String }
import extdeps.external_authority { ExternalAuthority }

// PURE PUBLICATION VOCABULARY — no upstream document subject of its own (same class as
// extdeps.external_authority and extdeps.uri). SpecificationDocumentDate and
// DocumentPublicationStatus are shared types. Document rows, anchors, and status values live on
// per-document modules. Machinery admission is via external_authority_machinery_exempt_module_paths
// in cli_run.rs. Read observations live in gunbc.specification_citation_read_provenance; the
// carriage rule lives in gunbc.upstream_document_carriage.

type SpecificationDocumentDate {
  year: Int
  month: Int
  day: Int
}

// PUBLICATION STATUS IS AN UPSTREAM FACT, WHICH IS WHY IT IS DECLARED HERE AND
// NOT IN THE MODULE THAT ACTS ON IT. Whether a publisher put a document where
// anyone can reach it, and under what licence or marking, is something the
// publisher did; whether THIS repository may then carry the document's facts is
// our policy, and it lives in gunbc.upstream_document_carriage (operator ruling,
// 2026-08-14). Keeping the type here and the rule there is what stops a fact and
// a policy from fusing into one carrier. The axis is public availability: the
// restrictive-marking arm records a marking that grants nothing and decides
// nothing, and the access-gated arm is the only one that bars carriage.
type DocumentPublicationStatus
  = PubliclyPublishedUnderOpenLicense {
      license: NonEmptyStr
    }
  | PubliclyPublishedWithRestrictiveMarking {
      marking: NonEmptyStr
    }
  | PubliclyPublishedWithoutStatedTerms {
      absence_basis: NonEmptyStr
    }
  | AccessGatedNotPubliclyPublished {
      gate: NonEmptyStr
    }

// A PUBLIC DOCUMENT MAY STATE NOTHING AT ALL, and the coproduct has to be able to say so. With
// only the licence and marking arms, an author facing an artifact that carries neither must invent
// one of them to describe it - which is exactly what happened: the Mt. Collins 2022 V2 brief was
// given marking "no licence granted", a CONCLUSION placed in a field that holds an upstream FACT
// (review 5084368000). The gap in the state space produced the false row, so the repair is the arm,
// not author discipline.
//
// The arm carries absence_basis rather than being nullary, because "this document states no terms"
// is a claim about a document that was READ, not a default for one that was not. An empty
// observation with no basis is indistinguishable from an unexamined one, and would make this the
// cheapest arm to select instead of the one that must be earned.
//
// THE PROJECTIONS ARE PROPERTIES OF THE STATUS, NOT OF OUR POLICY. Public
// availability is the axis the ruling turns on, and the marking is recorded so
// a reader can see it decides nothing: an open licence and a restrictive
// marking both project publicly-published, and only the second yields a
// marking. Neither answers whether gunbc may carry the document's facts — that
// is upstream_fact_carriage in gunbc.upstream_document_carriage, and keeping
// these two total over the coproduct is what lets that rule stay one match.
// WHICH REVISION OF A HELD SPECIFICATION WE ACTUALLY HOLD, relative to what the publisher serves
// now. Re-homed here from extdeps.cpu.ampere_altra_platform_hw_design.subject, where it was
// authored first: the type names no product, so a SECOND document needing it would otherwise have
// to import the platform specification's own subject module to describe its datasheet, which is a
// layer inversion. Its home is the shared publication vocabulary that already owns
// SpecificationDocumentDate and DocumentPublicationStatus.
//
// THE THIRD ARM IS NOT A REFINEMENT OF THE SECOND, it is a different fact. "A newer revision is
// listed in an index but the cited locator still serves ours" and "a newer revision is publicly
// served right now at a locator we fetched" carry different obligations: the first is a standing
// we may hold indefinitely because there is nothing to read, the second is a live citation debt.
// Collapsing them would let a retrievable supersession hide behind the unretrieved arm's excuse.
//
// THE SERVED ARM POINTS AT THE SUCCESSOR, it does not describe where the successor lives. An
// earlier revision carried the locator as a bare NonEmptyStr, which admits any prose at all and
// stands up a second, untyped citation scheme beside the ExternalAuthority system this file
// already owns. A retrieved document has an authority; that is the whole point of having retrieved
// it.
// NO is_current PREDICATE LIVES HERE, and its absence is the point. An earlier revision carried
// supersession_standing_is_current, which matched this coproduct into true for exactly ONE arm.
// That is a variant test wearing a predicate's name, and it is the shape the 2026-07-12 predicate
// dissolution deleted -- std.execution_mode records the criterion: execution_mode_is_wet_dispatch
// SURVIVED that cut because it is a two-variant semantic partition whose host branches on exactly
// that partition at two dispatch sites, not because predicates over coproducts are permitted.
// This one grouped no partition and had no production consumer at all; only witnesses read it.
// Consumers match the coproduct directly, which is what the exhaustive match already guarantees:
// adding a fourth arm must red every reader, and a predicate collapsing three arms to a Bool is
// precisely what would let a new arm slip past them.
type HeldSpecificationSupersessionStanding
  = HeldRevisionIsCurrentPublicCopy
  | NewerRevisionExistsUnretrieved {
      newer_version_label: NonEmptyStr,
      newer_publication_date: SpecificationDocumentDate,
      index_authority: ExternalAuthority,
      held_version_label: NonEmptyStr,
      detail: NonEmptyStr,
    }
  | NewerRevisionPubliclyServed {
      newer_version_label: NonEmptyStr,
      newer_authority: ExternalAuthority,
      index_authority: ExternalAuthority,
      held_version_label: NonEmptyStr,
      detail: NonEmptyStr,
    }

fn publication_status_is_publicly_published(status: DocumentPublicationStatus) -> Bool {
  match status {
    PubliclyPublishedUnderOpenLicense { license: _ } => true
    PubliclyPublishedWithRestrictiveMarking { marking: _ } => true
    PubliclyPublishedWithoutStatedTerms { absence_basis: _ } => true
    AccessGatedNotPubliclyPublished { gate: _ } => false
  }
}

fn publication_status_restrictive_marking(status: DocumentPublicationStatus) -> NonEmptyStr? {
  match status {
    PubliclyPublishedUnderOpenLicense { license: _ } => Absent
    PubliclyPublishedWithRestrictiveMarking { marking } => Present { value: marking }
    PubliclyPublishedWithoutStatedTerms { absence_basis: _ } => Absent
    AccessGatedNotPubliclyPublished { gate: _ } => Absent
  }
}
