module extdeps.publication

import std.integer { Int }
import std.types { Bool, NonEmptyStr, String }

data publication_status_axis_note: String = "UPSTREAM DOCUMENT FACTS ONLY. SpecificationDocumentDate and DocumentPublicationStatus record what the publisher published and when, on subjects that carry those fields. How this repository read or failed to read a cited locator is an observation in gunbc.specification_citation_read_provenance, not here. DocumentPublicationStatus is defined for platform modules that populate it (#8260); OCP subject anchors in #8257 carry licence terms on OcpSpecificationLicense instead. The rule mapping a status to whether gunbc may carry facts lives in gunbc.upstream_document_carriage."

type SpecificationDocumentDate {
  year: Int
  month: Int
  day: Int
}

type DocumentPublicationStatus
  = PubliclyPublishedUnderOpenLicense {
      license: NonEmptyStr
    }
  | PubliclyPublishedWithRestrictiveMarking {
      marking: NonEmptyStr
    }
  | AccessGatedNotPubliclyPublished {
      gate: NonEmptyStr
    }

fn publication_status_is_publicly_published(status: DocumentPublicationStatus) -> Bool {
  match status {
    PubliclyPublishedUnderOpenLicense { license: _ } => true
    PubliclyPublishedWithRestrictiveMarking { marking: _ } => true
    AccessGatedNotPubliclyPublished { gate: _ } => false
  }
}

fn publication_status_restrictive_marking(status: DocumentPublicationStatus) -> NonEmptyStr? {
  match status {
    PubliclyPublishedUnderOpenLicense { license: _ } => Absent
    PubliclyPublishedWithRestrictiveMarking { marking } => Present { value: marking }
    AccessGatedNotPubliclyPublished { gate: _ } => Absent
  }
}
