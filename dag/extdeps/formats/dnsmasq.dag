module extdeps.formats.dnsmasq

import std.types { Int, String, List, Bool, NonEmptyStr }
import std.algebra { trim, string_contains }
import std.list { first_where }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalAuthority, CitedFigureStanding, TranscribedUncited }
import std.layout {
  Doc,
  LayoutProtocol,
  doc_concat, doc_line_of,
  render
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "thekelleys.org.uk/dnsmasq/docs/dnsmasq.conf.example"
  }
}

data dnsmasq_man_page_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "thekelleys.org.uk/dnsmasq/docs/dnsmasq-man.html"
  }
}

// IN PROXY-DHCP MODE THE BOOT FILE IS A pxe-service, NOT A dhcp-boot. The man page: with the proxy
// keyword on dhcp-range, "dnsmasq simply provides the information given in --pxe-prompt and
// --pxe-service to allow netbooting". A tagged pxe-service carries at least one tag by construction
// (first_tag): an untagged one applies to every PXE client on the segment, so an empty tag list would
// silently invert a restricted boot line into a permissive one.
// THE CLIENT SYSTEM TYPE IS RENDERED AS AN INTEGER, never one of dnsmasq's names. The man page's named
// types follow RFC 4578's table (x86-64_EFI is 9, BC_EFI is 7), while x64 UEFI firmware presents 7
// under the IANA Processor Architecture Types registry; the integer is what the wire carries, and the
// man page admits "an integer ... for other types". The basename is a filename complete with its
// suffix, so PXE adds no layer suffix; one menu item per client type boots without a prompt.
// A TAG CONDITION, as the man page spells it: tag:<tag> requires the tag to be set, tag:!<tag> requires it to
// be unset ("the tag:!<tag> format"; the --tag-if and --dhcp-option entries). Negation is its own arm, so it is
// not a '!' typed into a tag name.
type DnsmasqTagMatch
  = DnsmasqTagSet { tag: String }
  | DnsmasqTagNotSet { tag: String }

fn dnsmasq_tag_match_word(m: DnsmasqTagMatch) -> String {
  match m {
    DnsmasqTagSet { tag: t } => concat("tag:", t)
    DnsmasqTagNotSet { tag: t } => concat("tag:!", t)
  }
}

// dhcp-mac maps a MAC address to a tag ("--dhcp-mac=set:<tag>,<MAC address>", the man page). It is
// independent of dhcp-host, so one host can carry a second tag without a second dhcp-host line for its MAC.
type DnsmasqDirective =
    DnsmasqComment { text: String }
  | DnsmasqPort { value: Int }
  | DnsmasqDhcpRangeProxy { network_address: String }
  | DnsmasqDhcpMatchSet { tag: String, option: String, value: String }
  | DnsmasqDhcpOptionForceTag { tag: String, option: String, value: String }
  | DnsmasqDhcpHostSetTag { mac: String, tag: String }
  | DnsmasqDhcpMacSetTag { mac: String, tag: String }
  | DnsmasqPxeServiceTags { first_tag: String, more_tags: List<DnsmasqTagMatch>, client_system_type: Int, menu_text: String, basename: String, server_address: String }
  | DnsmasqLogDhcp
  | DnsmasqEnableTftp
  | DnsmasqTftpRoot { path: String }

data dnsmasq_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

fn dnsmasq_directive_line(d: DnsmasqDirective) -> String {
  match d {
    DnsmasqComment { text: t } => concat("# ", t)
    DnsmasqPort { value: v } => concat("port=", to_string(v))
    DnsmasqDhcpRangeProxy { network_address: n } => concat(concat("dhcp-range=", n), ",proxy")
    DnsmasqDhcpMatchSet { tag: tag, option: option, value: value } =>
      concat(concat(concat("dhcp-match=set:", tag), concat(",", option)), concat(",", value))
    DnsmasqDhcpOptionForceTag { tag: tag, option: option, value: value } =>
      concat(concat(concat("dhcp-option-force=tag:", tag), concat(",", option)), concat(",", value))
    DnsmasqDhcpHostSetTag { mac: mac, tag: tag } =>
      concat(concat("dhcp-host=", mac), concat(",set:", tag))
    DnsmasqDhcpMacSetTag { mac: mac, tag: tag } =>
      join(["dhcp-mac=set:", tag, ",", mac], "")
    DnsmasqPxeServiceTags { first_tag: first, more_tags: more, client_system_type: csa, menu_text: menu, basename: basename, server_address: address } =>
      join([
        "pxe-service=tag:", first, ",",
        fold(more, init: "", f: (acc, t) => concat(acc, concat(dnsmasq_tag_match_word(m: t), ","))),
        to_string(csa), ",\"", menu, "\",", basename, ",", address,
      ], "")
    DnsmasqLogDhcp => "log-dhcp"
    DnsmasqEnableTftp => "enable-tftp"
    DnsmasqTftpRoot { path: path } => concat("tftp-root=", path)
  }
}

fn dnsmasq_to_doc(directives: List<DnsmasqDirective>) -> Doc {
  doc_concat(parts: map(directives, d => doc_line_of(text: dnsmasq_directive_line(d: d))))
}

fn serialize_dnsmasq(directives: List<DnsmasqDirective>) -> String {
  render(doc: dnsmasq_to_doc(directives: directives), proto: dnsmasq_protocol)
}

// A CONFIGURATION AS READ BACK, which this module did not necessarily render: a proxy-DHCP config
// (a dhcp-range line ending ",proxy") that carries a dhcp-boot line names a boot file dnsmasq does not
// offer in that mode (man page, --pxe-service). The rendering above cannot spell dhcp-boot at all, so
// this judges bytes that came from elsewhere, and names the first offending line.
type DnsmasqProxyBootStanding
  = DnsmasqProxyBootByPxeService
  | DnsmasqProxyBootIgnoredDhcpBoot { line: String }
  | DnsmasqNotProxyMode

fn dnsmasq_proxy_boot_standing(config: String) -> DnsmasqProxyBootStanding {
  let lines = map(split(s: config, delimiter: "\n"), l => trim(s: l))
  if any(lines, l => starts_with(s: l, prefix: "dhcp-range=") && ends_with(s: l, suffix: ",proxy")) {
    match first_where(xs: lines, keep: l => starts_with(s: l, prefix: "dhcp-boot=")) {
      Present { value: l } => DnsmasqProxyBootIgnoredDhcpBoot { line: l }
      Absent => DnsmasqProxyBootByPxeService
    }
  } else {
    DnsmasqNotProxyMode
  }
}

// THE LINE SHAPE `log-dhcp` MAKES dnsmasq WRITE, as this repository reads it (the man page's --log-dhcp entry owns the option, not these lines). A request line
// is `<KIND>(<interface>) [<address>] <client MAC>`: the kind word is one of the three request kinds below and the sender's hardware address is the last
// word. A PXE client's class is a separate `vendor class: PXEClient...` line that carries no MAC, so it is never joined to a sender here.
data dnsmasq_log_dhcp_line_shape_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "read dnsmasq's log-dhcp output (src/rfc2131.c and src/dhcp-common.c of the installed dnsmasq-base version) for the DHCPDISCOVER/DHCPREQUEST/DHCPINFORM line layout and the vendor class line; the shape was transcribed from a prior run's reading, and its version is not yet declared here"
}

data dnsmasq_log_dhcp_request_markers: List<String> = ["DHCPDISCOVER(", "DHCPREQUEST(", "DHCPINFORM("]

data dnsmasq_log_pxe_vendor_class_marker: String = "vendor class: PXEClient"

fn dnsmasq_log_line_is_dhcp_request(line: String) -> Bool {
  dnsmasq_log_dhcp_request_markers |> any(m => string_contains(s: line, pattern: m))
}

fn dnsmasq_log_line_is_pxe_vendor_class(line: String) -> Bool {
  string_contains(s: line, pattern: dnsmasq_log_pxe_vendor_class_marker)
}

fn dnsmasq_log_request_sender_text(line: String) -> String? {
  match filter(split(s: trim(s: line), delimiter: " "), w => w != "").last() {
    Absent => none
    Present { value: w } => Present { value: w }
  }
}
