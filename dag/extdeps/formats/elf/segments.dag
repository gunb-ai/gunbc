module extdeps.formats.elf.segments


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "refspecs.linuxfoundation.org/elf/gabi4+/ch5.pheader.html"
  }
}

type Elf64Phdr {
  segment_type: extdeps.formats.elf.primitives.ElfSegmentType
  flags: Int
  offset: Int
  vaddr: Int
  paddr: Int
  filesz: Int
  memsz: Int
  align: Int
}

fn decode_elf_segment_type(raw: Int) -> extdeps.formats.elf.types.ElfDecodeOutcome<extdeps.formats.elf.primitives.ElfSegmentType> {
  if raw == pt_load { extdeps.formats.elf.types.ElfDecoded { value: PtLoad } }
  else if raw == pt_null { extdeps.formats.elf.types.ElfDecoded { value: PtNull } }
  else { extdeps.formats.elf.types.ElfRejected { reason: extdeps.formats.elf.types.UnsupportedElfSegmentType { raw: raw } } }
}

fn decode_segment_permissions(flags: Int) -> std.exec_format.SegmentPermission {
  std.exec_format.SegmentPermission {
    readable: flags == pf_r || flags == (pf_r + pf_w) || flags == (pf_r + pf_x) || flags == (pf_r + pf_w + pf_x),
    writable: flags == pf_w || flags == (pf_r + pf_w) || flags == (pf_w + pf_x) || flags == (pf_r + pf_w + pf_x),
    executable: flags == pf_x || flags == (pf_r + pf_x) || flags == (pf_w + pf_x) || flags == (pf_r + pf_w + pf_x),
  }
}

fn decode_elf64_phdr(bytes: List<Int>, offset: Int) -> extdeps.formats.elf.types.ElfDecodeOutcome<Elf64Phdr> {
  if count(bytes) < offset + elf64_phdr_size {
    extdeps.formats.elf.types.ElfRejected {
      reason: extdeps.formats.elf.types.Truncated {
        required_bytes: offset + elf64_phdr_size,
        available_bytes: count(bytes),
      },
    }
  } else {
    match decode_elf_segment_type(read_u32_le_in_bounds(bytes, offset)) {
      extdeps.formats.elf.types.ElfDecoded { value: segment_type } => extdeps.formats.elf.types.ElfDecoded {
        value: Elf64Phdr {
          segment_type: segment_type,
          flags: read_u32_le_in_bounds(bytes, offset + 4),
          offset: read_u64_le_in_bounds(bytes, offset + 8),
          vaddr: read_u64_le_in_bounds(bytes, offset + 16),
          paddr: read_u64_le_in_bounds(bytes, offset + 24),
          filesz: read_u64_le_in_bounds(bytes, offset + 32),
          memsz: read_u64_le_in_bounds(bytes, offset + 40),
          align: read_u64_le_in_bounds(bytes, offset + 48),
        },
      }
      extdeps.formats.elf.types.ElfRejected { reason: r } => extdeps.formats.elf.types.ElfRejected { reason: r }
    }
  }
}

fn elf64_phdr_to_load_segment(phdr: Elf64Phdr) -> std.exec_format.LoadSegment {
  std.exec_format.LoadSegment {
    file_offset: phdr.offset,
    virtual_address: phdr.vaddr,
    file_size: phdr.filesz,
    memory_size: phdr.memsz,
    permissions: decode_segment_permissions(phdr.flags),
    alignment: phdr.align,
  }
}
