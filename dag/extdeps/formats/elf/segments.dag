module extdeps.formats.elf.segments


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "refspecs.linuxfoundation.org/elf/gabi4+/ch5.pheader.html"
  }
}

type Elf64Phdr {
  segment_type: ElfSegmentType
  flags: Int
  offset: Int
  vaddr: Int
  paddr: Int
  filesz: Int
  memsz: Int
  align: Int
}

type PhdrDecodeReason
  = PhdrTruncated { required_bytes: Int, available_bytes: Int }
  | UnsupportedPhdrType { raw: Int }

type PhdrDecodeOutcome<T>
  = PhdrDecoded { value: T }
  | PhdrRejected { reason: PhdrDecodeReason }

fn decode_elf_segment_type(raw: Int) -> PhdrDecodeOutcome<ElfSegmentType> {
  if raw == pt_load { PhdrDecoded { value: PtLoad } }
  else if raw == pt_null { PhdrDecoded { value: PtNull } }
  else { PhdrRejected { reason: UnsupportedPhdrType { raw: raw } } }
}

fn decode_segment_permissions(flags: Int) -> SegmentPermission {
  SegmentPermission {
    readable: flags == pf_r || flags == (pf_r + pf_w) || flags == (pf_r + pf_x) || flags == (pf_r + pf_w + pf_x),
    writable: flags == pf_w || flags == (pf_r + pf_w) || flags == (pf_w + pf_x) || flags == (pf_r + pf_w + pf_x),
    executable: flags == pf_x || flags == (pf_r + pf_x) || flags == (pf_w + pf_x) || flags == (pf_r + pf_w + pf_x),
  }
}

fn decode_elf64_phdr(bytes: List<Int>, offset: Int) -> PhdrDecodeOutcome<Elf64Phdr> {
  if count(bytes) < offset + elf64_phdr_size {
    PhdrRejected {
      reason: PhdrTruncated {
        required_bytes: offset + elf64_phdr_size,
        available_bytes: count(bytes),
      },
    }
  } else {
    match decode_elf_segment_type(read_u32_le_in_bounds(bytes, offset)) {
      PhdrDecoded { value: segment_type } => PhdrDecoded {
        value: Elf64Phdr {
          segment_type: segment_type,
          flags: read_u32_le_in_bounds(bytes, offset + 4),
          offset: read_u64_le_in_bounds(bytes, offset + 8),
          vaddr: read_u64_le_in_bounds(bytes, offset + 16),
          paddr: read_u64_le_in_bounds(bytes, offset + 24),
          filesz: read_u64_le_in_bounds(bytes, offset + 32),
          memsz: read_u64_le_in_bounds(bytes, offset + 40),
          align: read_u64_le_in_bounds(bytes, offset + 48),
        },
      }
      PhdrRejected { reason: r } => PhdrRejected { reason: r }
    }
  }
}

fn elf64_phdr_to_load_segment(phdr: Elf64Phdr) -> LoadSegment {
  LoadSegment {
    file_offset: phdr.offset,
    virtual_address: phdr.vaddr,
    file_size: phdr.filesz,
    memory_size: phdr.memsz,
    permissions: decode_segment_permissions(phdr.flags),
    alignment: phdr.align,
  }
}
