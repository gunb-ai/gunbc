module extdeps.cache



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/cache"
  }
}

fn cache_interface_facts_from_catalog(row: extdeps.cache.types.CacheInterfaceCatalogFacts) -> std.cache_interface.CacheInterfaceFacts {
  std.cache_interface.CacheInterfaceFacts {
    identity: row.identity
    backing_surface: row.backing_surface
    transport_encoding: match row.transport_encoding {
      CatalogOpaqueStringEncoding => OpaqueStringEncoding
      CatalogCasContentEncoding => CasContentEncoding
      SccacheInternalEncoding => NativeInternalEncoding
      CargoFingerprintEncoding => CasContentEncoding
    }
    vendor_transport_encoding_collapsed: catalog_transport_encoding_collapsed_in_std_projection(encoding: row.transport_encoding)

    key_derivation: {
      vendor_only_key_inputs_omitted: catalog_has_vendor_only_key_inputs(inputs: catalog_inputs_considered(kd: row.key_derivation))
      overwritable: row.key_derivation.overwritable
      prefix_fallback_allowed: row.key_derivation.prefix_fallback_allowed
      content_verified_on_read: row.key_derivation.content_verified_on_read
      visibility_scope: row.key_derivation.visibility_scope
      invalidation_triggers: row.key_derivation.invalidation_triggers
    }
    lookup_semantics: row.io.lookup_semantics
    write_semantics: row.io.write_semantics
    miss_semantics: row.io.miss_semantics
    value_shape: row.placement.value_shape
    locality: row.placement.locality
    retention: row.placement.retention
    atomicity: row.placement.atomicity
    auth: row.placement.auth
    read_latency: row.placement.read_latency
    consistency: row.placement.consistency
    evidence: row.evidence
  }
}

fn cache_key_projection_provider_key<T>(
  artifact: std.cache_interface.ArtifactIdentity<T>,
  backend: extdeps.cache.types.CacheInterfaceCatalogFacts,
) -> extdeps.cache.types.CatalogProviderKey {
  match backend.transport_encoding {
    CatalogOpaqueStringEncoding => extdeps.cache.types.CatalogOpaqueStringKey { key: artifact.subject_digest }
    SccacheInternalEncoding => extdeps.cache.types.SccacheInternalHash { digest: artifact.subject_digest }
    CatalogCasContentEncoding => extdeps.cache.types.CatalogCasContentDigest { digest: artifact.subject_digest }
    CargoFingerprintEncoding => extdeps.cache.types.CargoFingerprint { digest: artifact.subject_digest }
  }
}

fn cache_key_projection_transport<T>(
  artifact: std.cache_interface.ArtifactIdentity<T>,
  backend: extdeps.cache.types.CacheInterfaceCatalogFacts,
) -> extdeps.cache.types.CatalogBackendCacheKey {
  extdeps.cache.types.CatalogBackendCacheKey {
    store: backend.identity
    key: cache_key_projection_provider_key(artifact: artifact, backend: backend),
  }
}

fn cache_verified_hit_receipt<T>(
  artifact: std.cache_interface.ArtifactIdentity<T>,
  backend: extdeps.cache.types.CacheInterfaceCatalogFacts,
  producer: ProducerReceipt<T>,
  content_digest: std.content_hash.ContentHash,
) -> CatalogCachedArtifactReceipt<T> {
  extdeps.cache.types.CatalogCachedArtifactReceipt {
    artifact: artifact
    backend_key: cache_key_projection_transport(artifact: artifact, backend: backend)
    producer: producer
    content_digest: content_digest
  }
}

data gha_actions_cache: extdeps.cache.types.CacheInterfaceCatalogFacts = extdeps.cache.github_actions.gha_actions_cache_facts
data sccache_local: extdeps.cache.types.CacheInterfaceCatalogFacts = sccache_local_facts
data buildbuddy_cas: extdeps.cache.types.CacheInterfaceCatalogFacts = buildbuddy_cas_facts
data cargo_target_dir: extdeps.cache.types.CacheInterfaceCatalogFacts = extdeps.cache.cargo.cargo_target_dir_facts
data rustup_toolchain_store: extdeps.cache.types.CacheInterfaceCatalogFacts = extdeps.cache.rustup.rustup_toolchain_store_facts
data resolved_graph_cache: extdeps.cache.types.CacheInterfaceCatalogFacts = extdeps.realization.resolved_graph.resolved_graph_cache_facts
data parse_table_memo: extdeps.cache.types.CacheInterfaceCatalogFacts = parse_table_memo_facts
data compile_stage_memo: extdeps.cache.types.CacheInterfaceCatalogFacts = compile_stage_memo_facts

data cache_catalog: List<extdeps.cache.types.CacheInterfaceCatalogFacts> = [
  gha_actions_cache,
  sccache_local,
  buildbuddy_cas,
  cargo_target_dir,
  rustup_toolchain_store,
  extdeps.realization.reconcile_in_process.parse_cache_facts,
  extdeps.realization.reconcile_in_process.typed_module_cache_facts,
  resolved_graph_cache,
  parse_table_memo,
  compile_stage_memo_facts,
]

data cache_catalog_rows: List<std.cache_interface.CacheInterfaceFacts> = cache_catalog
  |> map(row => cache_interface_facts_from_catalog(row: row))

data sccache_local_projected: std.cache_interface.CacheInterfaceFacts = cache_interface_facts_from_catalog(sccache_local)
data parse_table_memo_projected: std.cache_interface.CacheInterfaceFacts = cache_interface_facts_from_catalog(parse_table_memo)
data cargo_target_dir_projected: std.cache_interface.CacheInterfaceFacts = cache_interface_facts_from_catalog(cargo_target_dir)

data cache_layer_default_order: List<std.cache_identity.CacheInterfaceId> = [
  parse_table_memo_id,
  extdeps.realization.reconcile_in_process.parse_cache_id,
  typed_module_cache_id,
  cargo_target_dir_id,
  sccache_local_id,
  resolved_graph_cache_id,
  rustup_toolchain_store_id,
  extdeps.cache.buildbuddy.buildbuddy_cas_id,
  extdeps.cache.github_actions.gha_actions_cache_id,
  compile_stage_memo_id,
]
