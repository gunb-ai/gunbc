module extdeps.cache.cache

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

import extdeps.cache.buildbuddy { buildbuddy_cas_facts, buildbuddy_cas_id }
import extdeps.cache.cargo { cargo_target_dir_facts, cargo_target_dir_id }
import extdeps.cache.github_actions { gha_actions_cache_facts, gha_actions_cache_id }
import extdeps.cache.rustup { rustup_toolchain_store_facts, rustup_toolchain_store_id }
import extdeps.cache.sccache { sccache_local_facts, sccache_local_id }
import extdeps.cache.types {
  CacheInterfaceCatalogFacts,
  CatalogBackendCacheKey,
  CatalogProviderKey,
  CatalogCachedArtifactReceipt,
  catalog_inputs_considered,
  catalog_has_vendor_only_key_inputs,
  catalog_transport_encoding_collapsed_in_std_projection,
  SccacheInternalHash,
  CargoFingerprint,
  SccacheInternalEncoding,
  CargoFingerprintEncoding,
  CatalogOpaqueStringEncoding,
  CatalogCasContentEncoding,
  CatalogOpaqueStringKey,
  CatalogCasContentDigest,
}
import extdeps.realization.parse_table_memo { parse_table_memo_facts, parse_table_memo_id }
import extdeps.realization.compile_stage_memo { compile_stage_memo_facts, compile_stage_memo_id }
import extdeps.realization.reconcile_in_process {
  parse_cache_facts,
  typed_module_cache_facts,
  parse_cache_id,
  typed_module_cache_id,
}
import extdeps.realization.resolved_graph { resolved_graph_cache_facts, resolved_graph_cache_id }
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  ArtifactIdentity,
  ProducerReceipt,
  CacheInterfaceFacts,
  OpaqueStringEncoding,
  CasContentEncoding,
  NativeInternalEncoding,
}
import std.types { ContentHash, List }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/cache"
  }
}

fn cache_interface_facts_from_catalog(row: CacheInterfaceCatalogFacts) -> CacheInterfaceFacts {
  CacheInterfaceFacts {
    identity: row.identity
    backing_surface: row.backing_surface
    transport_encoding: match row.transport_encoding {
      CatalogOpaqueStringEncoding => OpaqueStringEncoding
      CatalogCasContentEncoding => CasContentEncoding
      SccacheInternalEncoding => NativeInternalEncoding
      CargoFingerprintEncoding => CasContentEncoding
    }
    vendor_transport_encoding_collapsed: catalog_transport_encoding_collapsed_in_std_projection(encoding: row.transport_encoding)

    key_derivation: {
      vendor_only_key_inputs_omitted: catalog_has_vendor_only_key_inputs(inputs: catalog_inputs_considered(kd: row.key_derivation))
      overwritable: row.key_derivation.overwritable
      prefix_fallback_allowed: row.key_derivation.prefix_fallback_allowed
      content_verified_on_read: row.key_derivation.content_verified_on_read
      visibility_scope: row.key_derivation.visibility_scope
      invalidation_triggers: row.key_derivation.invalidation_triggers
    }
    lookup_semantics: row.io.lookup_semantics
    write_semantics: row.io.write_semantics
    miss_semantics: row.io.miss_semantics
    value_shape: row.placement.value_shape
    locality: row.placement.locality
    eviction: row.placement.eviction
    atomicity: row.placement.atomicity
    auth: row.placement.auth
    read_latency: row.placement.read_latency
    consistency: row.placement.consistency
    evidence: row.evidence
  }
}

fn cache_key_projection_provider_key<T>(
  artifact: ArtifactIdentity<T>,
  backend: CacheInterfaceCatalogFacts,
) -> CatalogProviderKey {
  match backend.transport_encoding {
    CatalogOpaqueStringEncoding => CatalogOpaqueStringKey { key: artifact.subject_digest }
    SccacheInternalEncoding => SccacheInternalHash { digest: artifact.subject_digest }
    CatalogCasContentEncoding => CatalogCasContentDigest { digest: artifact.subject_digest }
    CargoFingerprintEncoding => CargoFingerprint { digest: artifact.subject_digest }
  }
}

fn cache_key_projection_transport<T>(
  artifact: ArtifactIdentity<T>,
  backend: CacheInterfaceCatalogFacts,
) -> CatalogBackendCacheKey {
  CatalogBackendCacheKey {
    store: backend.identity
    key: cache_key_projection_provider_key(artifact: artifact, backend: backend),
  }
}

fn cache_verified_hit_receipt<T>(
  artifact: ArtifactIdentity<T>,
  backend: CacheInterfaceCatalogFacts,
  producer: ProducerReceipt<T>,
  content_digest: ContentHash,
) -> CatalogCachedArtifactReceipt<T> {
  CatalogCachedArtifactReceipt {
    artifact: artifact
    backend_key: cache_key_projection_transport(artifact: artifact, backend: backend)
    producer: producer
    content_digest: content_digest
  }
}

data gha_actions_cache: CacheInterfaceCatalogFacts = gha_actions_cache_facts
data sccache_local: CacheInterfaceCatalogFacts = sccache_local_facts
data buildbuddy_cas: CacheInterfaceCatalogFacts = buildbuddy_cas_facts
data cargo_target_dir: CacheInterfaceCatalogFacts = cargo_target_dir_facts
data rustup_toolchain_store: CacheInterfaceCatalogFacts = rustup_toolchain_store_facts
data resolved_graph_cache: CacheInterfaceCatalogFacts = resolved_graph_cache_facts
data parse_table_memo: CacheInterfaceCatalogFacts = parse_table_memo_facts
data compile_stage_memo: CacheInterfaceCatalogFacts = compile_stage_memo_facts

data cache_catalog: List<CacheInterfaceCatalogFacts> = [
  gha_actions_cache,
  sccache_local,
  buildbuddy_cas,
  cargo_target_dir,
  rustup_toolchain_store,
  parse_cache_facts,
  typed_module_cache_facts,
  resolved_graph_cache,
  parse_table_memo,
  compile_stage_memo_facts,
]

data cache_catalog_rows: List<CacheInterfaceFacts> = cache_catalog
  |> map(row => cache_interface_facts_from_catalog(row: row))

data sccache_local_projected: CacheInterfaceFacts = cache_interface_facts_from_catalog(sccache_local)
data parse_table_memo_projected: CacheInterfaceFacts = cache_interface_facts_from_catalog(parse_table_memo)
data cargo_target_dir_projected: CacheInterfaceFacts = cache_interface_facts_from_catalog(cargo_target_dir)

data cache_layer_default_order: List<CacheInterfaceId> = [
  parse_table_memo_id,
  parse_cache_id,
  typed_module_cache_id,
  cargo_target_dir_id,
  sccache_local_id,
  resolved_graph_cache_id,
  rustup_toolchain_store_id,
  buildbuddy_cas_id,
  gha_actions_cache_id,
  compile_stage_memo_id,
]
