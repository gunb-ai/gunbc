module extdeps.fans.types

import std.types { Bool, Int, List, NonEmptyStr }
import std.measure { Millimeter, Percent, RevolutionsPerMinute, percent_count, rpm, rpm_count }
import std.acoustic { AWeightedSoundPressureLevel, dba_tenths }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Computer_fan"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.fans.types",
      decl_name: "FanCatalogRow",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// A FAN IS ITS OWN UPSTREAM SUBJECT, not a field on the cooler that ships it. The Dynatron W1
// and the Noctua NH-D9 AMP-4926 4U are separately governed products, and so are the fans inside
// them - DF126025BU-PWMH and NF-A9 HS-PWM are separately specified parts with their own
// published tables. Modelling the fan as a cooler attribute would fuse two independently
// versioned authorities and leave nowhere to put a chassis fan, which belongs to no cooler at
// all.

type FanBearing
  = SleeveBearing
  | DoubleBallBearing
  | FluidDynamicBearing
  | SelfStabilisingOilPressure
  | FanBearingUnpublished

// ONE ROW OF A VENDOR'S PUBLISHED TABLE. Vendors publish a handful of duty points, not a curve,
// and every field here is something a datasheet actually prints. sound_pressure is optional
// because publishing speed without noise is common - the Noctua states 600 rpm at 20% PWM and
// no dBA figure to go with it.
type FanPublishedOperatingPoint {
  duty: Percent
  speed: RevolutionsPerMinute
  sound_pressure: AWeightedSoundPressureLevel?
}

// HOW STRONGLY A LEVEL IS KNOWN AT A GIVEN SPEED. The distinction this type exists to keep is
// between a number the manufacturer printed and a number someone computed - and, separately,
// between either of those and what a person would actually hear in another room.
//
// PublishedAnchor is the vendor's own figure at the vendor's own test point.
// InterpolatedFromAnchors would be a value derived between two anchors - NOT offered here,
//   because deriving it needs a logarithm and no log builtin exists in this substrate. A fan
//   whose level someone wants at an unpublished speed gets a refusal, not an estimate.
// NEITHER is a receiver-position observation. Ducting, grilles, panels, the wall and the room
//   all sit between a fan's rated level and what is audible elsewhere, so no arm here may ever
//   be read as "what you would hear". That claim requires a measurement at the listening
//   position and has no representation in this module by design.
type FanSoundPressureResult
  = FanSoundPressurePublished { level: AWeightedSoundPressureLevel }
  | FanSoundPressureNotPublishedAtSpeed { speed: RevolutionsPerMinute }
  | FanSoundPressureUnderdetermined { published_level_count: Int }

// THE FAIL-CLOSED GATE, AT THREE ARMS RATHER THAN TWO. Anchor count decides not just whether a
// law can be APPLIED but whether it can be TESTED, and those are different states with different
// owners:
//
//   <= 1 anchor  fixes no slope at all               -> Underdetermined
//   == 2 anchors fix a two-parameter law EXACTLY,    -> TwoPointLawAssumed
//                leaving zero residual, so the law
//                is ASSUMED and never validated
//   >= 3 anchors leave residual to test the law      -> LawFittable
//                against
//
// Collapsing the middle two would be the state-space conflation DESIGN names: a level derived
// under an assumed law and one derived under a law the evidence could have refuted are not the
// same claim, and the remedy differs - the first needs a second independent source, the second
// needs only a residual bound. The Dynatron publishes three levels and the Noctua exactly one,
// so both outer arms are live fleet states today and the middle one is not yet inhabited.
//
// This is why the W1's fitted noise law must never be reused for the Noctua. Whoever adds a log
// builtin later inherits this gate rather than having to remember the rule.
type FanAcousticEvidence
  = FanAcousticLawFittable { published_level_count: Int }
  | FanAcousticTwoPointLawAssumed { published_level_count: Int }
  | FanAcousticUnderdetermined { published_level_count: Int }

// A SPEED RANGE IS NOT TWO OPERATING POINTS, and this arm exists because writing it as two was
// the defect that produced this type. A vendor that prints "200-3000 rpm" has stated the ends of
// the controllable range and has NOT stated which duty produces either end. Spelling that as a
// FanPublishedOperatingPoint forces a duty field the datasheet never printed, so the author
// invents one - percent(0) and percent(100) - and every consumer downstream then reads a
// fabricated duty as a published anchor. A 4-pin fan is not required to reach its minimum at 0%
// duty; many hold a floor and some stop entirely.
//
// The two shapes are therefore separate fields rather than one list, and a row may carry either,
// both, or neither. That is a construction wall, not a check: with no duty field on this arm
// there is no place for the invented number to go.
// THE MINIMUM IS THE NONZERO FLOOR, NOT THE SLOWEST ATTAINABLE SPEED, and the field is named for
// that because the two readings differ by exactly the stop behavior below. ARCTIC prints
// "200-3000 rpm (0 rpm below 5 % PWM)": 200 is where the fan settles while it is still turning,
// and 0 rpm is reachable. A field called `minimum` invites the reading that this fan never turns
// slower than 200, which the same sentence refutes.
type FanPublishedSpeedRange
  = FanSpeedRangePublished { nonzero_minimum: RevolutionsPerMinute, maximum: RevolutionsPerMinute }
  | FanSpeedRangeUnpublished

// WHETHER THE FAN STOPS, AND WHERE. A PWM fan that stops below a duty threshold and one that
// holds a floor all the way down are different machines to a controller: the first has a duty
// band in which its tach reads zero for a healthy fan, so a zero reading there is not a fault.
// Modelling this as absent would leave a consumer unable to tell a stopped P8 from a failed one.
type FanPublishedStopBehavior
  = FanStopsBelowPwm { threshold: Percent }
  | FanStopBehaviorUnpublished

// THE MAXIMUM IS A REFUSAL AND NOT A ZERO. Folding an empty published set to rpm(0) reports
// "this fan does not spin" where the honest answer is "the vendor published no speed" - the
// empty-observation narrow DESIGN names, with ARCTIC as the live specimen the moment its
// fabricated points are removed.
type FanMaximumSpeed
  = FanMaximumSpeedKnown { speed: RevolutionsPerMinute }
  | FanMaximumSpeedUnpublished

type FanCatalogRow {
  model: NonEmptyStr
  manufacturer: Vendor<Hardware>
  frame_size: Millimeter
  bearing: FanBearing
  pwm_controlled: Bool
  published_points: List<FanPublishedOperatingPoint>
  published_speed_range: FanPublishedSpeedRange
  published_stop_behavior: FanPublishedStopBehavior
}

fn fan_point_has_level(point: FanPublishedOperatingPoint) -> Bool {
  match point.sound_pressure {
    none => false
    Present { value } => true
  }
}

fn fan_published_level_count(row: FanCatalogRow) -> Int {
  fold(
    row.published_points,
    init: 0,
    f: (acc, point) => if fan_point_has_level(point: point) { acc + 1 } else { acc },
  )
}

fn fan_acoustic_evidence(row: FanCatalogRow) -> FanAcousticEvidence {
  let n = fan_published_level_count(row: row)
  if n >= 3 {
    FanAcousticLawFittable { published_level_count: n }
  } else {
    if n == 2 {
      FanAcousticTwoPointLawAssumed { published_level_count: n }
    } else {
      FanAcousticUnderdetermined { published_level_count: n }
    }
  }
}

fn fan_speed_range_maximum(range: FanPublishedSpeedRange) -> FanMaximumSpeed {
  match range {
    FanSpeedRangeUnpublished => FanMaximumSpeedUnpublished
    FanSpeedRangePublished { nonzero_minimum, maximum } => FanMaximumSpeedKnown { speed: maximum }
  }
}

fn fan_maximum_speed_over(acc: FanMaximumSpeed, candidate: RevolutionsPerMinute) -> FanMaximumSpeed {
  match acc {
    FanMaximumSpeedUnpublished => FanMaximumSpeedKnown { speed: candidate }
    FanMaximumSpeedKnown { speed } =>
      if rpm_count(candidate) > rpm_count(speed) {
        FanMaximumSpeedKnown { speed: candidate }
      } else {
        FanMaximumSpeedKnown { speed: speed }
      }
  }
}

// BOTH SOURCES ARE CONSULTED because a row may carry either and neither dominates: the Dynatron
// publishes duty-paired points and no range, ARCTIC publishes a range and no points. Reading only
// one field would answer Unpublished for half the catalogue.
fn fan_max_speed(row: FanCatalogRow) -> FanMaximumSpeed {
  fold(
    row.published_points,
    init: fan_speed_range_maximum(range: row.published_speed_range),
    f: (acc, point) => fan_maximum_speed_over(acc: acc, candidate: point.speed),
  )
}

fn fan_level_at_published_speed_rec(
  points: List<FanPublishedOperatingPoint>,
  speed: RevolutionsPerMinute,
) -> AWeightedSoundPressureLevel? {
  fold(
    points,
    init: none,
    f: (acc, point) =>
      match acc {
        Present { value } => Present { value: value }
        none =>
          if rpm_count(point.speed) == rpm_count(speed) {
            point.sound_pressure
          } else {
            none
          }
      },
  )
}

// THE ONLY WAY TO GET A LEVEL OUT OF THIS MODULE. It answers at a published anchor and refuses
// everywhere else. FanSoundPressureNotPublishedAtSpeed is the arm that fires for every real
// operating speed the fleet actually runs at, which is the honest result: the fleet's fans sit
// between the vendor's test points almost all of the time.
fn fan_sound_pressure_at(
  row: FanCatalogRow,
  speed: RevolutionsPerMinute,
) -> FanSoundPressureResult {
  match fan_acoustic_evidence(row: row) {
    FanAcousticUnderdetermined { published_level_count } =>
      FanSoundPressureUnderdetermined { published_level_count: published_level_count }
    FanAcousticTwoPointLawAssumed { published_level_count } =>
      match fan_level_at_published_speed_rec(points: row.published_points, speed: speed) {
        Present { value } => FanSoundPressurePublished { level: value }
        none => FanSoundPressureNotPublishedAtSpeed { speed: speed }
      }
    FanAcousticLawFittable { published_level_count } =>
      match fan_level_at_published_speed_rec(points: row.published_points, speed: speed) {
        Present { value } => FanSoundPressurePublished { level: value }
        none => FanSoundPressureNotPublishedAtSpeed { speed: speed }
      }
  }
}

fn fan_evidence_is_anchored(evidence: FanAcousticEvidence) -> Bool {
  match evidence {
    FanAcousticLawFittable { published_level_count } => true
    FanAcousticTwoPointLawAssumed { published_level_count } => true
    FanAcousticUnderdetermined { published_level_count } => false
  }
}
