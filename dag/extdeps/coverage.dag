module extdeps.coverage

import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/blob/main/dag/extdeps/coverage.dag"
  }
}

// Reading: github.com owns the surface this module models, cited by the authority above. The
// module's subject under that citation is its type declaration CoverageClosureFact, so that is the scope's
// subject and the citation above is its first citation.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.coverage",
      decl_name: "CoverageClosureFact",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type CoverageClosureFact
  = Subject { path: NonEmptyStr }
  | VariantPending { variant: NonEmptyStr }
  | JsonPending { field: NonEmptyStr }
  | Residue { description: NonEmptyStr }
  | Paid { item: NonEmptyStr }
  | Missing { item: NonEmptyStr }
  | DeclaredMetadata { field: NonEmptyStr }
  | ExternalSpecWatch { item: NonEmptyStr }
  | Blocked { reason: NonEmptyStr }
  | PathRef { path: NonEmptyStr }
  | RequiresArm { arm: NonEmptyStr }

type CoverageClosureEntry {
  facts: List<CoverageClosureFact>
  trigger: NonEmptyStr?
}
