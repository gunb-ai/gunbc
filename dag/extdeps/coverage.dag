module extdeps.coverage


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/gunb-ai/gunbc/blob/main/dag/extdeps/coverage.dag"
  }
}

type CoverageClosureFact
  = Subject { path: std.types.NonEmptyStr }
  | VariantPending { variant: std.types.NonEmptyStr }
  | JsonPending { field: std.types.NonEmptyStr }
  | Residue { description: std.types.NonEmptyStr }
  | Paid { item: std.types.NonEmptyStr }
  | Missing { item: std.types.NonEmptyStr }
  | DeclaredMetadata { field: std.types.NonEmptyStr }
  | ExternalSpecWatch { item: std.types.NonEmptyStr }
  | Blocked { reason: std.types.NonEmptyStr }
  | PathRef { path: std.types.NonEmptyStr }
  | RequiresArm { arm: std.types.NonEmptyStr }

type CoverageClosureEntry {
  facts: List<CoverageClosureFact>
  trigger: std.types.NonEmptyStr?
}
