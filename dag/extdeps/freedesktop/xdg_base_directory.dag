module extdeps.freedesktop.xdg_base_directory

import std.types { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

// THE XDG BASE DIRECTORY SPECIFICATION, AT THE VERSION ITS ANCHOR LOCATOR PINS (published 08 May
// 2021), AS THE ONE AUTHORITY FOR WHERE A USER'S CACHE HOME IS, so a per-user store root need not take
// a path from its caller or restate the spec's rule at the call site.
//
// THE VERSION IS STATED ONCE, in extdeps_external_authority_anchor's locator (the versioned page),
// and nowhere else in this module: there is no separate version row for it to disagree with. The
// locator stays a string LITERAL rather than being derived from such a row, because the corpus-cadence
// anchor projection behind v2.lens.mandatory_tag.corpus_scan_witness_test
// corpus_live_clean_tree_wall_holds reads the anchor structurally and projects a derived locator as
// refused -- the same measured constraint extdeps.pin and extdeps.posix.shell_command_language record
// for an aliased anchor.
//
// THE UPSTREAM'S OWN WORDS. Section "Environment variables": "$XDG_CACHE_HOME defines the base
// directory relative to which user-specific non-essential data files should be stored. If
// $XDG_CACHE_HOME is either not set or empty, a default equal to $HOME/.cache should be used."
// Section "Basics": "All paths set in these environment variables must be absolute. If an
// implementation encounters a relative path in any of these variables it should consider the path
// invalid and ignore it." xdg_cache_home is exactly those three rules and nothing else; every arm of
// its result names which rule decided it.
//
// WHAT THE SPEC DOES NOT SAY, AND WHAT THIS MODULE DOES THERE. The default is "$HOME/.cache", which
// presumes a usable HOME; the spec does not say what an implementation does without one. Here an
// unset, empty or relative HOME REFUSES (XdgCacheHomeRefused). It is never answered with a
// substitute directory: a relative HOME would derive a relative base directory, which is the very
// thing the spec calls invalid, and inventing a location (the working directory, /tmp) would put a
// user's cache somewhere the spec never named. This is the one rule in this module that is not a
// transcription, and it is stated as such.
//
// XdgCacheHome IS sole_constructor, so the only way to hold one is through xdg_cache_home: no
// consumer can name a cache home the spec's rules did not select from the readings it was handed.
// The readings themselves are supplied by the caller (they are the process environment, which only
// a host can read); what is closed by construction is the RULE, not the observation.
//
// NOT DECLARED HERE YET: the spec's directory-creation rule ("create it with permission 0700 ... If
// the destination directory exists already the permissions should not be changed", section
// "Referencing this specification"). It lands with its only consumer, the store's first-use
// initialization in M1.c landing unit L5b, so it is not declared ahead of a reader. TRIGGER: L5b's
// first-use initialization creates a missing store root, and declares the 0700 rule here.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "specifications.freedesktop.org/basedir/0.8/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.freedesktop.xdg_base_directory",
      decl_name: "XdgCacheHome",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type XdgCacheHome sole_constructor {
  path: String
}

// What XDG_CACHE_HOME said when it did NOT decide the answer. Unset and empty are the spec's
// "either not set or empty"; a relative value is its "invalid and ignore it". Three arms rather than
// one, because a receipt that reports "the cache moved to $HOME/.cache" should say which of the
// three sent it there -- a relative value the user thinks is honoured is the one worth naming.
type XdgVariableStanding
  = XdgVariableUnset
  | XdgVariableEmpty
  | XdgVariableRelativeIgnored { value: String }

type XdgCacheHomeBasis
  = CacheHomeFromVariable
  | CacheHomeDefaultUnderHome { variable: XdgVariableStanding }

type HomeUnusable
  = HomeUnset
  | HomeEmpty
  | HomeNotAbsolute { value: String }

type XdgCacheHomeResolution
  = XdgCacheHomeResolved { cache_home: XdgCacheHome, basis: XdgCacheHomeBasis }
  | XdgCacheHomeRefused { home: HomeUnusable, variable: XdgVariableStanding }

data xdg_cache_home_default_relative_path: String = ".cache"

// "relative to which ... files should be stored": the join of a base directory and a relative path
// for this module's consumers (the $HOME/.cache default and xdg_cache_path), so a base that already
// ends in "/" (HOME=/ for root, or a trailing slash on the variable) never yields a doubled
// separator. It is NOT the corpus's one such join: the same ends-with-"/" directory-child join is
// spelled in extdeps.realization.materialization_store_local store_path, gunbc.source_root_read
// source_root_child_path and extdeps.filesystem.filesystem_io filesystem_established_absence_path,
// so this is the fourth copy of one concept (DESIGN section 2). Consolidating the four into one
// directory-child join in extdeps.filesystem is a later unit, deferred so the move does not collide
// with M1.c landing unit L3's edits to extdeps.filesystem.filesystem_io. TRIGGER: L3 has landed.
fn xdg_base_join(base: String, relative: String) -> String {
  if base.ends_with(suffix: "/") { concat(base, relative) } else { concat(base, "/", relative) }
}

fn xdg_cache_path(cache_home: XdgCacheHome, relative: String) -> String {
  xdg_base_join(base: cache_home.path, relative: relative)
}

// DECLARED FRONTIER (DESIGN section 3c). Consumers today: test.claim.xdg_base_directory_witness,
// which executes every arm, and test.claim.materialization_store_capacity_witness and
// test.claim.materialization_store_grant_witness, which mint UserCacheRoots through it. The
// production reader of the two environment variables lands with M1.c's store root in landing unit
// L8: the route root reads XDG_CACHE_HOME and HOME as observations and mints the root through this
// function. TRIGGER: L8's route root calls xdg_cache_home with the process's own readings.
fn xdg_cache_home(cache_variable: String?, home_variable: String?) -> XdgCacheHomeResolution {
  match cache_variable {
    Absent => xdg_cache_home_default(variable: XdgVariableUnset, home_variable: home_variable)
    Present { value: v } =>
      if v == "" {
        xdg_cache_home_default(variable: XdgVariableEmpty, home_variable: home_variable)
      } else if v.starts_with(prefix: "/") {
        XdgCacheHomeResolved { cache_home: XdgCacheHome { path: v }, basis: CacheHomeFromVariable }
      } else {
        xdg_cache_home_default(variable: XdgVariableRelativeIgnored { value: v }, home_variable: home_variable)
      }
  }
}

fn xdg_cache_home_default(variable: XdgVariableStanding, home_variable: String?) -> XdgCacheHomeResolution {
  match home_variable {
    Absent => XdgCacheHomeRefused { home: HomeUnset, variable: variable }
    Present { value: h } =>
      if h == "" {
        XdgCacheHomeRefused { home: HomeEmpty, variable: variable }
      } else if h.starts_with(prefix: "/") {
        XdgCacheHomeResolved {
          cache_home: XdgCacheHome { path: xdg_base_join(base: h, relative: xdg_cache_home_default_relative_path) },
          basis: CacheHomeDefaultUnderHome { variable: variable }
        }
      } else {
        XdgCacheHomeRefused { home: HomeNotAbsolute { value: h }, variable: variable }
      }
  }
}
