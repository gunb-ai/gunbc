module extdeps.bootloader.grub


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.gnu.org/software/grub/manual/grub/grub.html#Simple-configuration"
  }
}

type GrubMenuEntry {
  title: std.types.NonEmptyStr
  linux_image: std.types.NonEmptyStr
  linux_cmdline: List<extdeps.firmware.kernel_cmdline.KernelCmdlineArg>
  initrd_image: std.types.NonEmptyStr
}

type GrubConfig {
  timeout_seconds: std.types.Seconds
  default_entry: Int
  entries: List<GrubMenuEntry>
}

fn grub_cmdline_arg_render(arg: extdeps.firmware.kernel_cmdline.KernelCmdlineArg) -> String {
  let wire = kernel_cmdline_arg_wire(arg: arg)
  if string_contains(s: wire, pattern: ";") {
    concat("\"", concat(wire, "\""))
  } else {
    wire
  }
}

fn grub_linux_line(entry: GrubMenuEntry) -> String {
  join(
    [
      "  linux",
      entry.linux_image as String,
      join(map(entry.linux_cmdline, a => grub_cmdline_arg_render(arg: a)), " "),
    ],
    " ",
  )
}

fn grub_menuentry_render(entry: GrubMenuEntry) -> String {
  join(
    [
      concat(concat("menuentry \"", entry.title as String), "\" {"),
      grub_linux_line(entry: entry),
      join(["  initrd", entry.initrd_image as String], " "),
      "}",
    ],
    "\n"
  )
}

fn grub_config_render(cfg: GrubConfig) -> String {
  let header = join(
    [
      join(["set timeout=", to_string(cfg.timeout_seconds)], ""),
      join(["set default=", to_string(cfg.default_entry)], ""),
    ],
    "\n"
  )
  let body = join(map(cfg.entries, e => grub_menuentry_render(entry: e)), "\n")
  join([header, body], "\n")
}
