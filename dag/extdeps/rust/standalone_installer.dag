module extdeps.rust.standalone_installer

import std.types { NonEmptyStr, String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.program { ProgramIdentity, uncataloged_program }
import extdeps.exec.command { ArgvCommand, argv_command }

// THE RUST STANDALONE INSTALLER (forge.rust-lang.org "Other installation methods", "Standalone
// installers"): a per-target tarball `rust-<version>-<target>.tar.xz` from static.rust-lang.org/dist,
// published beside its `.sha256`, which unpacks to `rust-<version>-<target>/` holding an `install.sh`.
// Running `install.sh --prefix=<dir>` installs rustc, cargo and the standard library under <dir>
// without rustup and without network; `--disable-ldconfig` skips the host ldconfig step, which an
// install into a guest tree (not the running system) must not run.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "forge.rust-lang.org/infra/other-installation-methods.html#standalone-installers"
  }
}

fn rust_dist_archive_name(version: NonEmptyStr, target: NonEmptyStr) -> NonEmptyStr {
  join(["rust-", version as String, "-", target as String, ".tar.xz"], "") as NonEmptyStr
}

fn rust_dist_url(version: NonEmptyStr, target: NonEmptyStr) -> NonEmptyStr {
  concat("https://static.rust-lang.org/dist/", rust_dist_archive_name(version: version, target: target) as String) as NonEmptyStr
}

fn rust_dist_unpacked_dir_name(version: NonEmptyStr, target: NonEmptyStr) -> NonEmptyStr {
  join(["rust-", version as String, "-", target as String], "") as NonEmptyStr
}

// The installer is the unpacked dist's own script, at a path only the unpacked directory names.
fn rust_standalone_installer_program_at(path: NonEmptyStr) -> ProgramIdentity = uncataloged_program(invocation: path)

fn rust_standalone_install_command(unpacked_dir: String, prefix: String) -> ArgvCommand {
  argv_command(
    program: rust_standalone_installer_program_at(path: concat(unpacked_dir, "/install.sh") as NonEmptyStr),
    arguments: [concat("--prefix=", prefix), "--disable-ldconfig"],
  )
}
