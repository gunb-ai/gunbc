module extdeps.rust.cargo_build

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { Bool, FilePath, NonEmptyStr, Unit }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command, env_prefixed_command_in }
import std.env_binding { EnvSet }
import std.resources { Network }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/commands/cargo-build.html"
  }
}

data cargo_compile_env: Map<String, String> = empty_map()

// cargo.Build.TestWithCwdEnv: env composes cwd (-C) and process env vars (leading VAR=val argv
// words) into ONE argv vector, matching the shell.Find.Files precedent of argv-native env -C
// workdir substitution — no shell is needed to chain a cd/export prefix onto a cargo invocation
// (SHELL-DAG dissolution of the interpreter_dispatch_bijection_real_roster_transport
// retained_foreign multi-line script: set -euo pipefail; cd; export; two cargo test invocations,
// now two sequential typed calls with caller-side short-circuit).

// PATH-resolved program name, deliberately, for the reason extdeps.exec.command
// program_spelling_is_an_observation_claim records once: an absolute path is a filesystem
// observation this repository has not made about the host the command runs on.
fn cargo_program() -> ProgramIdentity = uncataloged_program(invocation: "cargo")

// THE ONE PLACE THE CLIPPY VERB AND ITS LINT SEPARATOR ARE SPELLED. The Clippy operation below
// carries the same shape fused to `transport shell`, which is unreachable from any expression --
// the fork repo_self_build_authority_note measured and named. This builder is the first step of the
// de-fusion that note declares as its dissolution trigger: the operation's argv shape, expressed
// once as a value, so a SECOND realization of it (a workflow YAML line) is a projection of this
// node rather than a second spelling of cargo's vocabulary in a consumer. `--` is part of the
// operation and not the caller's, because it is what separates cargo's own arguments from the lint
// levels rustc receives, and a caller free to omit it would hand `-D warnings` to cargo.
fn cargo_clippy_command(extra_args: List<String>, lint_args: List<String>) -> ArgvCommand {
  argv_command(
    program: cargo_program(),
    arguments: append(append(["clippy"], items: extra_args), items: append(["--"], items: lint_args))
  )
}


// A RELEASE BUILD OF ONE BIN OF ONE PACKAGE THAT CANNOT FETCH. One bin, because a caller that runs one
// binary should not pay the memory and time of building the package's every target. `--locked` refuses a Cargo.lock that would have to
// change, and `--offline` refuses any network access, so a dependency the vendored source does not
// hold is a build failure rather than a download; cargo verifies each vendored crate against its
// .cargo-checksum.json, so a vendor set that does not match the lockfile refuses too. The source
// replacement that points cargo at the vendor directory is configuration (a .cargo/config.toml the
// caller places), not an argument here.
fn cargo_build_release_bin_offline_command(package: String, bin: String) -> ArgvCommand {
  argv_command(program: cargo_program(), arguments: ["build", "--release", "-p", package, "--bin", bin, "--locked", "--offline"])
}

// `cargo run`: the same offline, locked release build for a package named by its manifest, into a
// target directory the caller names, then the package's binary run with cargo's own exit status --
// for a package outside the workspace the caller sits in. Build output goes to stderr and the
// program's to stdout. The source replacement is still configuration cargo discovers from the
// working directory.
fn cargo_run_release_manifest_offline_command(manifest_path: String, target_dir: String) -> ArgvCommand {
  argv_command(program: cargo_program(), arguments: ["run", "--release", "--manifest-path", manifest_path, "--target-dir", target_dir, "--locked", "--offline"])
}

// THE DEPENDENCY SOURCES A LOCKFILE PINS, written to a directory. `--locked` refuses a lockfile that
// would change; `--versioned-dirs` names each crate directory with its version so two versions of
// one crate cannot collide. Its output layout and .cargo-checksum.json files are cargo's, so a
// vendor set is keyed by the cargo that wrote it as well as by the lockfile (cargo_version_command).
//
// CARGO READS ITS CONFIGURATION FROM THE WORKING DIRECTORY'S ANCESTORS AND FROM CARGO_HOME, NEVER FROM
// THE MANIFEST'S DIRECTORY. A caller vendoring an UNTRUSTED tree (the revision job, as root) must
// therefore keep that tree off both paths, or the tree's own .cargo/config.toml configures the
// vendoring cargo (source replacement, credential providers that EXECUTE a program). So this builder
// fixes the working directory to `/` (the typed env_prefixed_command_in over the cargo command, so the program identity stays cargo) and takes an isolated, empty-by-construction
// CARGO_HOME from the caller; the manifest and output are named by absolute path.
fn cargo_vendor_command(manifest_path: String, output_dir: String, cargo_home: String) -> ArgvCommand {
  cargo_vendor_command_from(directory: "/", manifest_path: manifest_path, output_dir: output_dir, cargo_home: cargo_home)
}

// The same argv with the working directory a parameter, so the claim that `/` is what keeps the tree's
// configuration unread has a control that names the tree instead (the red the production form avoids).
fn cargo_vendor_command_from(directory: String, manifest_path: String, output_dir: String, cargo_home: String) -> ArgvCommand {
  env_prefixed_command_in(
    directory: directory,
    bindings: [EnvSet { name: "CARGO_HOME", value: cargo_home }],
    command: argv_command(program: cargo_program(), arguments: ["vendor", "--locked", "--versioned-dirs", "--manifest-path", manifest_path, output_dir]),
  )
}

// The cargo identity: `cargo --version` prints `cargo <semver> (<commit> <date>)`.
fn cargo_version_command() -> ArgvCommand {
  argv_command(program: cargo_program(), arguments: ["--version"])
}

fn cargo_build_jobs_flag(count: Int) -> List<String> {
  ["--jobs", to_string(count)]
}

fn cargo_nextest_build_jobs_flag(count: Int) -> List<String> {
  ["--build-jobs", to_string(count)]
}

data cargo_check_manifest_messages_note: String = "Cargo's structured check surface is distinct from BuildManifestMessages: check asks rustc for metadata and therefore reaches type checking and borrow checking without codegen."

service cargo.Build {
  operation Build {
    requires opaque
    input { extra_args: List<String> = [], env: Map<String, String> = cargo_compile_env, build_jobs_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "build", build_jobs_args, extra_args] }
    exit {
      0 => Unit
      101 => String "Compilation failed"
    }
  }

  operation BuildInheritEnv {
    requires opaque
    input { workdir: FilePath, extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["env", "-C", "{workdir}", "cargo", "build", extra_args] }
    exit {
      0 => Unit
      101 => String "Compilation failed"
    }
  }

  operation BuildManifest {
    requires opaque
    input { workdir: FilePath, manifest_path: FilePath, target_dir: FilePath, extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["env", "-C", "{workdir}", "CARGO_TARGET_DIR={target_dir}", "cargo", "build", "--manifest-path", "{manifest_path}", extra_args] }
    exit {
      0 => Unit
      101 => String "Compilation failed"
    }
  }

  operation BuildManifestMessages {
    requires opaque
    input { workdir: FilePath, manifest_path: FilePath, target_dir: FilePath, extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["env", "-C", "{workdir}", "CARGO_TARGET_DIR={target_dir}", "cargo", "build", "--message-format=json", "--manifest-path", "{manifest_path}", extra_args] }
    exit {
      0 => Unit
      101 => String "Compilation failed"
    }
  }

  operation CheckManifestMessages {
    requires opaque
    input { workdir: FilePath, manifest_path: FilePath, target_dir: FilePath, extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["env", "-C", "{workdir}", "CARGO_TARGET_DIR={target_dir}", "cargo", "check", "--message-format=json", "--manifest-path", "{manifest_path}", extra_args] }
    exit {
      0 => Unit
      101 => String "Check failed"
    }
  }

  operation Test {
    requires opaque
    input { extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }

    transport shell { argv: ["cargo", "test", extra_args] }
    exit {
      0 => Unit
      101 => String "Tests failed"
    }
  }

  operation TestWithCwdEnv {
    requires opaque
    input { workdir: FilePath, cargo_bin: NonEmptyStr, env: List<String> = [], extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["env", "-C", "{workdir}", env, "{cargo_bin}", "test", extra_args] }
    exit {
      0 => Unit
      101 => String "Tests failed"
      nonzero => String "cargo test error"
    }
  }

  operation Nextest {
    requires opaque
    input { extra_args: List<String> = [], build_jobs_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "nextest", "run", build_jobs_args, extra_args] }
    exit {
      0 => Unit
      100 => String "Tests failed"
      nonzero => String "Nextest run error"
    }
  }

  operation Clippy {
    requires opaque
    input {
      extra_args: List<String> = []
      lint_args: List<String> = []
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "clippy", extra_args, "--", lint_args] }
    exit {
      0 => Unit
      101 => String "Clippy warnings or errors"
    }
  }

  operation Fmt {
    requires opaque
    input { extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "fmt", extra_args] }
    exit {
      0 => Unit
      1 => String "Formatting check failed"
    }
  }

  operation Check {
    requires opaque
    input { extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "check", extra_args] }
    exit {
      0 => Unit
      101 => String "Check failed"
    }
  }

  operation Doc {
    requires opaque
    input { extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell { argv: ["cargo", "doc", extra_args] }
    exit {
      0 => Unit
      101 => String "Documentation generation failed"
    }
  }

  operation Run {
    requires opaque
    input { package: String, bin: String, args: List<String> }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }

    transport shell { argv: ["cargo", "run", "-p", package, "--bin", bin, "--", args] }
    exit {
      0 => Unit
      101 => String "Run failed"
      nonzero => String "Binary exited with error"
    }
  }
}

// `cargo --version` prints ONE line naming the release, the short commit hash and the commit date.
// It lives HERE rather than in extdeps.rust.cargo because this module is where cargo's COMMAND
// INVOCATIONS are modelled -- cargo.Build binds argv and shell transports -- while extdeps.rust.cargo
// owns the manifest vocabulary. A self-report is an invocation, not a manifest fact.
//
// It is bound separately from the rustc reading beside it in extdeps.rust.rustc: the two binaries are
// separately versioned, and a toolchain can carry a cargo that a rustc release line does not name.
service cargo.Identity {
  operation Version {
    requires none
    input {}
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
    }
    transport shell { argv: ["cargo", "--version"] }
    exit {
      0 => Unit
      nonzero => String "cargo did not report its version"
    }
  }
}
