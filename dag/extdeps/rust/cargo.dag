module extdeps.cargo

data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/"
  }
}

type RustEdition
  = Edition2015
  | Edition2018
  | Edition2021
  | Edition2024

fn rust_edition_str(edition: RustEdition) -> String {
  match edition {
    Edition2015 => "2015"
    Edition2018 => "2018"
    Edition2021 => "2021"
    Edition2024 => "2024"
  }
}

data default_rust_edition: RustEdition = Edition2021

data min_cargo_version: extdeps.cargo_version.CargoToolVersionFloor = ">= 1.56"

type CargoPackage {
  name: String
  version: extdeps.cargo_version.CargoPackageVersion
  edition: RustEdition
  path: String
}

type CargoDepSource
  = RegistryDep  { version: extdeps.cargo_version.CargoVersionRequirement, features: List<String> }
  | LocalPathDep { path: String }

type CargoDependency {
  name: String
  source: CargoDepSource
}

type CargoTarget
  = Lib
  | Bin { name: String }
  | CargoTest { name: String }
  | Example { name: String }
  | Bench { name: String }

fn cargo_target_source_path(target: CargoTarget, package_name: String) -> std.types.FilePathParts {
  match target {
    Lib => std.types.FilePathParts { segments: ["src", "lib.rs"] }
    Bin { name: name } =>
      if name == package_name {
        std.types.FilePathParts { segments: ["src", "main.rs"] }
      } else {
        std.types.FilePathParts { segments: ["src", "bin", concat(name, ".rs")] }
      }
    CargoTest { name: name } => std.types.FilePathParts { segments: ["tests", concat(name, ".rs")] }
    Example { name: name } => std.types.FilePathParts { segments: ["examples", concat(name, ".rs")] }
    Bench { name: name } => std.types.FilePathParts { segments: ["benches", concat(name, ".rs")] }
  }
}

fn rust_module_candidate_paths(stem: String) -> List<std.types.FilePathParts> {
  [
    std.types.FilePathParts { segments: ["src", concat(stem, ".rs")] },
    std.types.FilePathParts { segments: ["src", stem, "mod.rs"] }
  ]
}

type CargoProfile = String

data canonical_profiles: List<String> = ["dev", "release", "test", "bench"]

type CargoFeature {
  name: String
  dependencies: List<String>
}

type TestHarness = Harness | NoHarness

data default_profile: CargoProfile = "dev"

// The variables named here are CARGO'S OWN INTERFACE, not a devboot or CI convention: the cargo
// book's environment-variables reference lists what cargo reads, and a caller that spells
// "CARGO_TARGET_DIR=" inline is a second authority for a name upstream already owns. The failure
// that authority prevents is silent rather than loud -- a misspelled variable is not an error to
// cargo, it is simply not read, so the build runs to completion under a default the caller
// believed it had overridden and the divergence surfaces as an artifact built somewhere else.
//
// RUSTUP_HOME is deliberately ABSENT from this coproduct. Rustup is an independently governed
// upstream product with its own book and its own release cadence (DESIGN section 3, external
// upstream decomposition), so its variable lives in extdeps.rustup; enumerating it here would
// make a rustup change require editing cargo's module.
data cargo_environment_variables_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/reference/environment-variables.html"
  }
}

type CargoEnvironmentVariable
  = CargoHomeEnv
  | CargoTargetDirEnv
  | CargoBuildJobsEnv
  | RustcWrapperEnv

// THE NAMES LIVE HERE, THE OPERAND FORM DOES NOT, and an earlier revision of this module got that
// wrong. It carried a cargo_environment_assignment rendering "NAME=value" beside these names,
// following what extdeps.ollama.server_env and extdeps.cache.sccache already did. That form is
// env(1)'s argument syntax, not cargo's -- cargo owns WHICH NAMES IT READS and nothing about how a
// process launcher spells an assignment -- so extdeps.tools.env is its single authority, and
// rendering it again here would be the DESIGN section 3 fork this migration exists to remove,
// committed by the change removing it. Callers pair a name from this function with an EnvSet
// binding and let extdeps.tools.env env_bindings_argv render the operand.
fn cargo_environment_variable_name(variable: CargoEnvironmentVariable) -> NonEmptyStr {
  match variable {
    CargoHomeEnv => "CARGO_HOME"
    CargoTargetDirEnv => "CARGO_TARGET_DIR"
    CargoBuildJobsEnv => "CARGO_BUILD_JOBS"
    RustcWrapperEnv => "RUSTC_WRAPPER"
  }
}
