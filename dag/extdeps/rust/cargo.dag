module extdeps.rust.cargo

import extdeps.rust.version { CargoPackageVersion, CargoVersionRequirement, CargoToolVersionFloor }
import std.types { Bool, FilePathParts, NonEmptyStr, String, List }
import std.workspace_artifact { WorkspaceFootprint, WorkspaceArtifact, FootprintProvenance, CitedUpstream, RegenerableFromSource, LocalCacheState }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/"
  }
}

type RustEdition
  = Edition2015
  | Edition2018
  | Edition2021
  | Edition2024

fn rust_edition_str(edition: RustEdition) -> String {
  match edition {
    Edition2015 => "2015"
    Edition2018 => "2018"
    Edition2021 => "2021"
    Edition2024 => "2024"
  }
}

data default_rust_edition: RustEdition = Edition2021

data min_cargo_version: CargoToolVersionFloor = ">= 1.56"

type CargoPackage {
  name: String
  version: CargoPackageVersion
  edition: RustEdition
  path: String
}

// `default_features` is Cargo's `default-features` key on a registry dependency
// (doc.rust-lang.org/cargo/reference/specifying-dependencies.html, "Dependency features"): false
// opts the dependency out of its own default feature set.
type CargoDepSource
  = RegistryDep  { version: CargoVersionRequirement, default_features: Bool, features: List<String> }
  | LocalPathDep { path: String }

type CargoDependency {
  name: String
  source: CargoDepSource
}

type CargoTarget
  = Lib
  | Bin { name: String }
  | CargoTest { name: String }
  | Example { name: String }
  | Bench { name: String }

fn cargo_target_source_path(target: CargoTarget, package_name: String) -> FilePathParts {
  match target {
    Lib => FilePathParts { segments: ["src", "lib.rs"] }
    Bin { name: name } =>
      if name == package_name {
        FilePathParts { segments: ["src", "main.rs"] }
      } else {
        FilePathParts { segments: ["src", "bin", concat(name, ".rs")] }
      }
    CargoTest { name: name } => FilePathParts { segments: ["tests", concat(name, ".rs")] }
    Example { name: name } => FilePathParts { segments: ["examples", concat(name, ".rs")] }
    Bench { name: name } => FilePathParts { segments: ["benches", concat(name, ".rs")] }
  }
}

fn rust_module_candidate_paths(stem: String) -> List<FilePathParts> {
  [
    FilePathParts { segments: ["src", concat(stem, ".rs")] },
    FilePathParts { segments: ["src", stem, "mod.rs"] }
  ]
}

type CargoProfile = String

data canonical_profiles: List<String> = ["dev", "release", "test", "bench"]

type CargoFeature {
  name: String
  dependencies: List<String>
}

type TestHarness = Harness | NoHarness

data default_profile: CargoProfile = "dev"

// The variables named here are CARGO'S OWN INTERFACE, not a devboot or CI convention: the cargo
// book's environment-variables reference lists what cargo reads, and a caller that spells
// "CARGO_TARGET_DIR=" inline is a second authority for a name upstream already owns. The failure
// that authority prevents is silent rather than loud -- a misspelled variable is not an error to
// cargo, it is simply not read, so the build runs to completion under a default the caller
// believed it had overridden and the divergence surfaces as an artifact built somewhere else.
//
// RUSTUP_HOME is deliberately ABSENT from this coproduct. Rustup is an independently governed
// upstream product with its own book and its own release cadence (DESIGN section 3, external
// upstream decomposition), so its variable lives in extdeps.rust.rustup; enumerating it here would
// make a rustup change require editing cargo's module.
data cargo_environment_variables_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/reference/environment-variables.html"
  }
}

type CargoEnvironmentVariable
  = CargoHomeEnv
  | CargoTargetDirEnv
  | CargoBuildJobsEnv
  | RustcWrapperEnv
  | RustflagsEnv

// THE NAMES LIVE HERE, THE OPERAND FORM DOES NOT, and an earlier revision of this module got that
// wrong. It carried a cargo_environment_assignment rendering "NAME=value" beside these names,
// following what extdeps.ollama.server_env and extdeps.cache.sccache already did. That form is
// env(1)'s argument syntax, not cargo's -- cargo owns WHICH NAMES IT READS and nothing about how a
// process launcher spells an assignment -- so extdeps.tools.env is its single authority, and
// rendering it again here would be the DESIGN section 3 fork this migration exists to remove,
// committed by the change removing it. Callers pair a name from this function with an EnvSet
// binding and let extdeps.tools.env env_bindings_argv render the operand.
fn cargo_environment_variable_name(variable: CargoEnvironmentVariable) -> NonEmptyStr {
  match variable {
    CargoHomeEnv => "CARGO_HOME"
    CargoTargetDirEnv => "CARGO_TARGET_DIR"
    CargoBuildJobsEnv => "CARGO_BUILD_JOBS"
    RustcWrapperEnv => "RUSTC_WRAPPER"
    RustflagsEnv => "RUSTFLAGS"
  }
}

// WORKSPACE FOOTPRINT. Cargo introduces a build output tree (the target directory,
// doc.rust-lang.org/cargo/reference/build-cache.html) and a registry/cache home
// (CARGO_HOME, doc.rust-lang.org/cargo/guide/cargo-home.html). WHERE those live in a
// given repository is that repository's policy — the location patterns are parameters —
// but WHAT they are and why they are never tracked is a fact about cargo, declared here.
fn cargo_workspace_footprint(target_dir_patterns: List<String>, cargo_home_pattern: String) -> WorkspaceFootprint {
  WorkspaceFootprint {
    provenance: CitedUpstream { display: "Cargo build artifacts", upstream: "doc.rust-lang.org/cargo/" },
    artifacts: concat(
      map(target_dir_patterns, p => WorkspaceArtifact {
        pattern: p,
        meaning: "cargo build output tree (compiled artifacts, incremental state)",
        reason: RegenerableFromSource
      }),
      [WorkspaceArtifact {
        pattern: cargo_home_pattern,
        meaning: "CARGO_HOME registry/cache; may include git checkouts",
        reason: LocalCacheState
      }]
    )
  }
}

// THE DEFAULT TARGET-DIRECTORY LOCATION. Where cargo puts a build's output tree when nothing
// overrides it: the cargo book's build-cache page, "target directory" section, states cargo
// creates the output directory in target/ under the package root (for a workspace, the
// workspace root), and that CARGO_TARGET_DIR overrides this location. That is upstream's
// convention, not gunbc policy -- distinct from gunbc.owned_cargo_target, which is gunbc's OWN
// partition for targets with an identity-scoped owner (C4); the two shapes never merge into one
// fn, because collapsing them would let one change silently retarget the other. A caller with an
// exclusive, disposable build root (a scratch checkout that only ever hosts this one build)
// wants THIS layout, not the ownership partition: the disposable root is the isolation boundary,
// there is no second tenant to name. The failure this home prevents is the silent one: a site
// re-spelling the join by hand keeps compiling green when upstream's default moves (cargo has
// discussed relocating it), and the divergence surfaces as artifacts written somewhere the
// caller's read-back never looks.
//
// The segment is the one constant and the fn is its only absolute spelling: some consumers bind
// the layout RELATIVE to a working directory they do not name (a CI job's cwd, a bash word whose
// root is a shell var), so they take the segment and never re-spell "target". An empty build_root
// yields the absolute-from-root form ("/target"), which is what a word composed from a $ROOT var
// needs.
data cargo_default_target_relative_segment: String = "target"

fn cargo_default_target_dir(build_root: String) -> String {
  join([build_root, "/", cargo_default_target_relative_segment], "")
}

// The same layout's PROFILE faces. "target/release" is not a second fact -- it is the default
// layout plus the profile cargo builds when asked for (--release to target/release, unoptimized to
// target/debug, same cited page) -- so the join exists once here, in cargo's own profile names, and
// no consumer appends "/release" or "/debug" to a target dir by hand. A second local join beside
// the home is the §6b leaf this migration exists to delete.
data cargo_default_dev_profile: String = "debug"
data cargo_default_release_profile: String = "release"

// Profile under an ALREADY-NAMED target directory: the join exists only here, so a site holding a
// target dir from another authority (gunbc.owned_cargo_target's partition, say) still gets its
// profile face from this module rather than re-spelling the append.
fn cargo_profile_dir_under_target_dir(target_dir: String, profile: String) -> String {
  join([target_dir, "/", profile], "")
}

fn cargo_default_profile_dir(build_root: String, profile: String) -> String {
  cargo_profile_dir_under_target_dir(
    target_dir: cargo_default_target_dir(build_root: build_root),
    profile: profile
  )
}

fn cargo_default_release_dir(build_root: String) -> String {
  cargo_default_profile_dir(build_root: build_root, profile: cargo_default_release_profile)
}

// The relative face of the release layout, for sites bound to a working directory they do not name
// (a CI job's cwd, a bash word whose root is a shell var).
data cargo_default_release_dir_rel: String = join([cargo_default_target_relative_segment, "/", cargo_default_release_profile], "")