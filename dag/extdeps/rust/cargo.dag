module extdeps.cargo



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/"
  }
}

type RustEdition
  = Edition2015
  | Edition2018
  | Edition2021
  | Edition2024

fn rust_edition_str(edition: RustEdition) -> String {
  match edition {
    Edition2015 => "2015"
    Edition2018 => "2018"
    Edition2021 => "2021"
    Edition2024 => "2024"
  }
}

data default_rust_edition: RustEdition = Edition2021

data min_cargo_version: extdeps.cargo_version.CargoToolVersionFloor = ">= 1.56"

type CargoPackage {
  name: String
  version: extdeps.cargo_version.CargoPackageVersion
  edition: RustEdition
  path: String
}

type CargoDepSource
  = RegistryDep  { version: extdeps.cargo_version.CargoVersionRequirement, features: List<String> }
  | LocalPathDep { path: String }

type CargoDependency {
  name: String
  source: CargoDepSource
}

type CargoTarget
  = Lib
  | Bin { name: String }
  | CargoTest { name: String }
  | Example { name: String }
  | Bench { name: String }

fn cargo_target_source_path(target: CargoTarget, package_name: String) -> std.types.FilePathParts {
  match target {
    Lib => std.types.FilePathParts { segments: ["src", "lib.rs"] }
    Bin { name: name } =>
      if name == package_name {
        std.types.FilePathParts { segments: ["src", "main.rs"] }
      } else {
        std.types.FilePathParts { segments: ["src", "bin", concat(name, ".rs")] }
      }
    CargoTest { name: name } => std.types.FilePathParts { segments: ["tests", concat(name, ".rs")] }
    Example { name: name } => std.types.FilePathParts { segments: ["examples", concat(name, ".rs")] }
    Bench { name: name } => std.types.FilePathParts { segments: ["benches", concat(name, ".rs")] }
  }
}

fn rust_module_candidate_paths(stem: String) -> List<std.types.FilePathParts> {
  [
    std.types.FilePathParts { segments: ["src", concat(stem, ".rs")] },
    std.types.FilePathParts { segments: ["src", stem, "mod.rs"] }
  ]
}

type CargoProfile = String

data canonical_profiles: List<String> = ["dev", "release", "test", "bench"]

type CargoFeature {
  name: String
  dependencies: List<String>
}

type TestHarness = Harness | NoHarness

data default_profile: CargoProfile = "dev"
