module extdeps.cargo

import extdeps.cargo_version { CargoPackageVersion, CargoVersionRequirement, CargoToolVersionFloor }
import std.types { FilePathParts, NonEmptyStr }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/"
  }
}

type RustEdition
  = Edition2015
  | Edition2018
  | Edition2021
  | Edition2024

fn rust_edition_str(edition: RustEdition) -> String {
  match edition {
    Edition2015 => "2015"
    Edition2018 => "2018"
    Edition2021 => "2021"
    Edition2024 => "2024"
  }
}

data default_rust_edition: RustEdition = Edition2021

data min_cargo_version: CargoToolVersionFloor = ">= 1.56"

type CargoPackage {
  name: String
  version: CargoPackageVersion
  edition: RustEdition
  path: String
}

type CargoDepSource
  = RegistryDep  { version: CargoVersionRequirement, features: List<String> }
  | LocalPathDep { path: String }

type CargoDependency {
  name: String
  source: CargoDepSource
}

type CargoTarget
  = Lib
  | Bin { name: String }
  | CargoTest { name: String }
  | Example { name: String }
  | Bench { name: String }

fn cargo_target_source_path(target: CargoTarget, package_name: String) -> FilePathParts {
  match target {
    Lib => FilePathParts { segments: ["src", "lib.rs"] }
    Bin { name: name } =>
      if name == package_name {
        FilePathParts { segments: ["src", "main.rs"] }
      } else {
        FilePathParts { segments: ["src", "bin", concat(name, ".rs")] }
      }
    CargoTest { name: name } => FilePathParts { segments: ["tests", concat(name, ".rs")] }
    Example { name: name } => FilePathParts { segments: ["examples", concat(name, ".rs")] }
    Bench { name: name } => FilePathParts { segments: ["benches", concat(name, ".rs")] }
  }
}

fn rust_module_candidate_paths(stem: String) -> List<FilePathParts> {
  [
    FilePathParts { segments: ["src", concat(stem, ".rs")] },
    FilePathParts { segments: ["src", stem, "mod.rs"] }
  ]
}

type CargoProfile = String

data canonical_profiles: List<String> = ["dev", "release", "test", "bench"]

type CargoFeature {
  name: String
  dependencies: List<String>
}

type TestHarness = Harness | NoHarness

data default_profile: CargoProfile = "dev"

// The variables named here are CARGO'S OWN INTERFACE, not a devboot or CI convention: the cargo
// book's environment-variables reference lists what cargo reads, and a caller that spells
// "CARGO_TARGET_DIR=" inline is a second authority for a name upstream already owns. The failure
// that authority prevents is silent rather than loud -- a misspelled variable is not an error to
// cargo, it is simply not read, so the build runs to completion under a default the caller
// believed it had overridden and the divergence surfaces as an artifact built somewhere else.
//
// RUSTUP_HOME is deliberately ABSENT from this coproduct. Rustup is an independently governed
// upstream product with its own book and its own release cadence (DESIGN section 3, external
// upstream decomposition), so its variable lives in extdeps.rustup; enumerating it here would
// make a rustup change require editing cargo's module.
data cargo_environment_variables_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/reference/environment-variables.html"
  }
}

type CargoEnvironmentVariable
  = CargoHomeEnv
  | CargoTargetDirEnv
  | CargoBuildJobsEnv
  | RustcWrapperEnv

fn cargo_environment_variable_name(variable: CargoEnvironmentVariable) -> NonEmptyStr {
  match variable {
    CargoHomeEnv => "CARGO_HOME"
    CargoTargetDirEnv => "CARGO_TARGET_DIR"
    CargoBuildJobsEnv => "CARGO_BUILD_JOBS"
    RustcWrapperEnv => "RUSTC_WRAPPER"
  }
}

// THE OPERAND FORM, RENDERED BESIDE THE NAME rather than joined at the call site, following the
// same shape extdeps.ollama.server_env and extdeps.cache.sccache already use for their own
// variables. An EMPTY value is a real cargo state and not an absent one: RUSTC_WRAPPER= tells
// cargo to use no wrapper, which is a different instruction from leaving the variable unset and
// inheriting an ambient one. The value is a plain String for exactly that reason -- refusing the
// empty string here would make the only spelling of "no wrapper" unwritable.
fn cargo_environment_assignment(variable: CargoEnvironmentVariable, value: String) -> String {
  join([cargo_environment_variable_name(variable: variable) as String, "=", value], "")
}
