type StdProcessSpawnOutcome
  = SpawnSucceeded
  | SpawnFailed

fn spawn_outcome_log_fragment(outcome: StdProcessSpawnOutcome) -> String {
  match outcome {
    SpawnSucceeded => ""
    SpawnFailed => "failed to spawn"
  }
}
