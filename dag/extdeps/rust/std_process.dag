module extdeps.rust.std_process


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "doc.rust-lang.org/std/process/struct.Command.html"
  }
}

type StdProcessSpawnOutcome
  = SpawnSucceeded
  | SpawnFailed

fn spawn_outcome_log_fragment(outcome: StdProcessSpawnOutcome) -> String {
  match outcome {
    SpawnSucceeded => ""
    SpawnFailed => "failed to spawn"
  }
}
