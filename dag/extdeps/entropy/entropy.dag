module extdeps.entropy


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, RealizationDispatch, Scaffold, SingleAuthority }
import std.types { Int }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man4/random.4.html"
  }
}

data entropy_transport_linux_gnu_only: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.os",
    decl_name: "cited_operating_system_surface",
    field: WholeDeclaration
  }
}

data entropy_count_bytes_unit_debt: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.measure",
    decl_name: "ByteSize",
    field: WholeDeclaration
  }
}

data entropy_password_count_chars_unit_debt: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.measure",
    decl_name: "Measure",
    field: WholeDeclaration
  }
}

data urandom_read_bytes_producer_status_note: String = "A PIPELINE REPORTS ITS LAST STAGE'S STATUS, AND base64 SUCCEEDS ON EMPTY INPUT. The argv was `head -c \{count} /dev/urandom | base64 -w 0`, so a failing `head` was reported as EXIT 0 WITH EMPTY OUTPUT -- a successful entropy draw that drew nothing, and the `nonzero` arm could never fire for the stage that actually knows. That is DESIGN section 5's fabricated plausible output on the one operation whose fake is indistinguishable from the real one by inspection: a consumer cannot tell an empty draw from a short one. MEASURED, not inferred from the shape: `sh -c 'head -c 16 /nonexistent | base64 -w 0'` exits 0, and base64 of empty input succeeds. `set -o pipefail` is NOT the remedy -- /bin/sh is dash here and aborts on it rather than accepting it, also measured -- so the status is captured from the producing stage directly, following the in-tree exemplar extdeps.rust.rustc (`...; rc=$?; rm -rf \"$d\"; exit $rc`). The bytes travel through a file rather than a shell variable because command substitution strips NULs and trailing newlines and would corrupt the draw. NOT REPAIRED HERE and needing its own owner: ReadPassword below builds its components with unchecked `$(tr ... | head -c1)` substitutions, so a failing component silently yields a SHORTER password rather than a refusal -- a different and more serious defect than the pipe status, and fixing it is a redesign of the generator rather than an argv repair."

service Urandom {
  operation ReadBytes {
    input { count: Int }
    output { octets_b64: String from "stdout" }
    readonly
    transport shell { argv: ["sh", "-c", "d=$(mktemp -d) || exit 1; head -c {count} /dev/urandom > \"$d/b\"; rc=$?; if [ $rc -eq 0 ]; then base64 -w 0 < \"$d/b\"; rc=$?; fi; rm -rf \"$d\"; exit $rc"] }
    exit {
      0 => Unit
      nonzero => String "Urandom.ReadBytes: /dev/urandom or base64 failed"
    }
  }

  operation ReadPassword {
    input { count: Int }
    output { password: String from "stdout" }
    readonly
    transport shell { argv: ["sh", "-c", "U=$(LC_ALL=C tr -dc 'A-Z' </dev/urandom | head -c1); L=$(LC_ALL=C tr -dc 'a-z' </dev/urandom | head -c1); D=$(LC_ALL=C tr -dc '0-9' </dev/urandom | head -c1); S=$(LC_ALL=C tr -dc '_.@#%-' </dev/urandom | head -c1); R=$(LC_ALL=C tr -dc 'A-Za-z0-9_.@#%-' </dev/urandom | head -c {count}); printf '%s%s%s%s%s' \"$U\" \"$L\" \"$D\" \"$S\" \"$R\" | head -c {count}"] }
    exit {
      0 => Unit
      nonzero => String "Urandom.ReadPassword: /dev/urandom failed"
    }
  }
}
