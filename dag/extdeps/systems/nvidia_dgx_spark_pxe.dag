data spark_pxe_bootloader_filename: std.types.NonEmptyStr = "grubnetaa64.efi.signed"

type SparkPxeBootImageKind
  = FastOsRecoveryTarball
  | DgxOsIsoImage

type SparkPxeTftpRelativePath
  = TftpBootloader
  | TftpGrubConfig
  | TftpKernelImage
  | TftpInitrdImage

fn spark_pxe_tftp_relative_path(p: SparkPxeTftpRelativePath, image: SparkPxeBootImageKind) -> std.types.NonEmptyStr {
  match image {
    FastOsRecoveryTarball =>
      match p {
        TftpBootloader => spark_pxe_bootloader_filename
        TftpGrubConfig => "grub/grub.cfg"
        TftpKernelImage => "fastos/vmlinuz"
        TftpInitrdImage => "fastos/initrd"
      }
    DgxOsIsoImage =>
      match p {
        TftpBootloader => spark_pxe_bootloader_filename
        TftpGrubConfig => "grub/grub.cfg"
        TftpKernelImage => "baseos/vmlinuz"
        TftpInitrdImage => "baseos/initrd"
      }
  }
}

fn spark_pxe_http_install_image_path(image: SparkPxeBootImageKind) -> std.types.NonEmptyStr {
  match image {
    FastOsRecoveryTarball => "fastos/usb.customer.tar.gz"
    DgxOsIsoImage => "base_os_7.0.0/base_os_7.0.0.iso"
  }
}

type SparkInstallerKernelParameterName
  = SparkInstallerUsbSkipFw
  | SparkInstallerUsbShell
  | SparkInstallerNoui
  | SparkInstallerAutoinstall
  | SparkInstallerPxeInstall

fn spark_installer_kernel_parameter_name(p: SparkInstallerKernelParameterName) -> std.types.NonEmptyStr {
  match p {
    SparkInstallerUsbSkipFw => "usb.skipfw"
    SparkInstallerUsbShell => "usb.shell"
    SparkInstallerNoui => "noui"
    SparkInstallerAutoinstall => "autoinstall"
    SparkInstallerPxeInstall => "pxeinstall"
  }
}

type SparkPxeSecureBootPrerequisite
  = SecureBootDisabledForPxe
  | BootloaderEnrolledForPxe { bootloader: std.types.NonEmptyStr }

fn spark_fastos_unattended_kernel_cmdline(http_image_root: extdeps.uri.Uri) -> String {
  extdeps.firmware.kernel_cmdline.kernel_cmdline_render(args: [
    extdeps.firmware.kernel_cmdline.KernelKeyValue { key: "nouveau.modeset", value: "0" },
    extdeps.firmware.kernel_cmdline.KernelFlag { name: "console=tty0" },
    extdeps.firmware.kernel_cmdline.KernelFlag { name: "console=ttyS0,921600" },
    extdeps.firmware.kernel_cmdline.KernelKeyValue { key: "sbsa_gwdt.action", value: "1" },
    extdeps.firmware.kernel_cmdline.KernelFlag { name: spark_installer_kernel_parameter_name(p: SparkInstallerNoui) },
    extdeps.firmware.kernel_cmdline.KernelKeyValue {
      key: spark_installer_kernel_parameter_name(p: SparkInstallerPxeInstall),
      value: "true",
    },
    extdeps.firmware.kernel_cmdline.KernelKeyValue {
      key: "fastos_usbimg_url",
      value: concat(
        extdeps.uri.uri_wire(uri: http_image_root),
        concat("/", spark_pxe_http_install_image_path(image: FastOsRecoveryTarball) as String),
      ),
    },
    extdeps.firmware.kernel_cmdline.KernelFlag { name: "ip=dhcp" },
  ])
}

fn spark_dgx_os_unattended_kernel_cmdline(http_image_root: extdeps.uri.Uri) -> String {
  extdeps.firmware.kernel_cmdline.kernel_cmdline_render(args: [
    extdeps.firmware.kernel_cmdline.KernelFlag { name: "fsck.mode=skip" },
    extdeps.firmware.kernel_cmdline.KernelFlag { name: spark_installer_kernel_parameter_name(p: SparkInstallerAutoinstall) },
    extdeps.firmware.kernel_cmdline.KernelFlag { name: "ip=dhcp" },
    extdeps.firmware.kernel_cmdline.KernelKeyValue {
      key: "url",
      value: concat(
        extdeps.uri.uri_wire(uri: http_image_root),
        concat("/", spark_pxe_http_install_image_path(image: DgxOsIsoImage) as String),
      ),
    },
    extdeps.firmware.kernel_cmdline.KernelFlag { name: "nvme-core.multipath=n" },
    extdeps.firmware.kernel_cmdline.KernelKeyValue { key: "nouveau.modeset", value: "0" },
  ])
}

fn spark_pxe_client_boot_mode(tftp_root: extdeps.uri.Uri) -> extdeps.provisioning.network_boot.ClientNetworkBootMode {
  extdeps.provisioning.network_boot.UefiPxe { tftp_root: tftp_root }
}
