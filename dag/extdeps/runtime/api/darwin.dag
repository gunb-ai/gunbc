module extdeps.runtime.api.darwin

import std.os.invocation {
  ApiEntry,
  LibraryApiBoundary,
  LibraryApiBoundarySurface,
  StableInvocationSurface,
}
import std.types { Bool }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.apple.com/documentation/macos-release-notes/macos-15-release-notes"
  }
}

data libsystem_read: ApiEntry = ApiEntry { symbol: "read", module: "libSystem" }
data libsystem_write: ApiEntry = ApiEntry { symbol: "write", module: "libSystem" }
data libsystem_open: ApiEntry = ApiEntry { symbol: "open", module: "libSystem" }
data libsystem_mmap: ApiEntry = ApiEntry { symbol: "mmap", module: "libSystem" }
data libsystem_execve: ApiEntry = ApiEntry { symbol: "execve", module: "libSystem" }
data libsystem_exit: ApiEntry = ApiEntry { symbol: "exit", module: "libSystem" }

data macos_libsystem_exports: List<ApiEntry> = [
  libsystem_read,
  libsystem_write,
  libsystem_open,
  libsystem_mmap,
  libsystem_execve,
  libsystem_exit,
]

data macos_libsystem_boundary: LibraryApiBoundary = {
  exports: macos_libsystem_exports,
}

data macos_15_library_api_surface: StableInvocationSurface = LibraryApiBoundarySurface {
  boundary: macos_libsystem_boundary,
}

fn witness_libsystem_read_exported() -> Bool {
  libsystem_read.symbol == "read"
}

fn witness_libsystem_read_module() -> Bool {
  libsystem_read.module == "libSystem"
}

fn witness_macos_libsystem_exports_include_read() -> Bool {
  match macos_15_library_api_surface {
    LibraryApiBoundarySurface { boundary: b } => b.exports == macos_libsystem_exports
    _ => false
  }
}
