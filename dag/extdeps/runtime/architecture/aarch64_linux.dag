module extdeps.runtime.architecture.aarch64_linux



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/ARM-software/abi-aa/blob/main/aapcs64/aapcs64.rst"
  }
}

data aarch64_stack_grows_down: std.abi.StackLayout = { grows_down: true }

data aarch64_general_purpose_registers: List<std.abi.ArchitecturalRegister> = [
  extdeps.runtime.abi.aapcs64.aarch64_inhabitant_x0,
  extdeps.runtime.abi.aapcs64.aarch64_inhabitant_x1,
  extdeps.runtime.abi.aapcs64.aarch64_inhabitant_x2,
  extdeps.runtime.abi.aapcs64.aarch64_inhabitant_x3,
  extdeps.runtime.abi.aapcs64.aarch64_inhabitant_x4,
  extdeps.runtime.abi.aapcs64.aarch64_inhabitant_x5,
  extdeps.runtime.abi.aapcs64.aarch64_inhabitant_x8,
]

data aarch64_linux_architecture_profile: extdeps.toolchain.architecture_profile.ArchitectureProfile = {
  architecture: extdeps.toolchain.types.Aarch64,
  word_width: std.measure.bit_width(64),
  pointer_width: std.measure.bit_width(64),
  endianness: LittleEndian,
  page_size: std.measure.byte_size(4096),
  default_alignment: std.measure.byte_size(16),
  register_file: aarch64_general_purpose_registers,
  calling_convention: extdeps.runtime.abi.aapcs64.aapcs64_linux_syscall_convention,
  stack_layout: aarch64_stack_grows_down,
}

data aarch64_linux_deployment_target: extdeps.toolchain.architecture_profile.DeploymentTarget = {
  profile: aarch64_linux_architecture_profile,
  invocation: std.os.invocation.SyscallAbiSurface { abi: extdeps.runtime.syscalls.linux.linux_aarch64_syscall_abi },
}

fn witness_architecture_is_aarch64() -> Bool {
  aarch64_linux_architecture_profile.architecture == extdeps.toolchain.types.Aarch64
}

fn witness_word_width_is_64() -> Bool {
  std.measure.bit_width_count(aarch64_linux_architecture_profile.word_width) == 64
}

fn witness_page_size_is_4096() -> Bool {
  std.measure.byte_size_count(aarch64_linux_architecture_profile.page_size) == 4096
}

fn witness_convention_syscall_number_is_x8() -> Bool {
  aarch64_linux_architecture_profile.calling_convention.syscall_number == extdeps.runtime.abi.aapcs64.aarch64_inhabitant_x8
}

fn witness_stack_grows_down() -> Bool {
  aarch64_linux_architecture_profile.stack_layout.grows_down == true
}

fn witness_deployment_invocation_matches_linux_abi() -> Bool {
  match aarch64_linux_deployment_target.invocation {
    std.os.invocation.SyscallAbiSurface { abi: a } => a == extdeps.runtime.syscalls.linux.linux_aarch64_syscall_abi
    _ => false
  }
}
