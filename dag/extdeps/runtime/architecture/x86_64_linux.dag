module extdeps.runtime.architecture.x86_64_linux



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "refspecs.linuxfoundation.org/elf/x86_64-abi-0.99.pdf"
  }
}

data x86_64_stack_grows_down: std.abi.StackLayout = { grows_down: true }

data x86_64_general_purpose_registers: List<std.abi.ArchitecturalRegister> = [
  extdeps.runtime.abi.sysv_amd64.amd64_inhabitant_rdi,
  extdeps.runtime.abi.sysv_amd64.amd64_inhabitant_rsi,
  extdeps.runtime.abi.sysv_amd64.amd64_inhabitant_rdx,
  extdeps.runtime.abi.sysv_amd64.amd64_inhabitant_r10,
  extdeps.runtime.abi.sysv_amd64.amd64_inhabitant_r8,
  extdeps.runtime.abi.sysv_amd64.amd64_inhabitant_r9,
  extdeps.runtime.abi.sysv_amd64.amd64_inhabitant_rax,
  extdeps.runtime.abi.sysv_amd64.amd64_inhabitant_rcx,
]

data x86_64_linux_architecture_profile: extdeps.toolchain.architecture_profile.ArchitectureProfile = {
  architecture: extdeps.toolchain.types.X86_64,
  word_width: std.measure.bit_width(64),
  pointer_width: std.measure.bit_width(64),
  endianness: LittleEndian,
  page_size: std.measure.byte_size(4096),
  default_alignment: std.measure.byte_size(16),
  register_file: x86_64_general_purpose_registers,
  calling_convention: extdeps.runtime.abi.sysv_amd64.sysv_amd64_linux_syscall_convention,
  stack_layout: x86_64_stack_grows_down,
}

data x86_64_linux_deployment_target: extdeps.toolchain.architecture_profile.DeploymentTarget = {
  profile: x86_64_linux_architecture_profile,
  invocation: std.os.invocation.SyscallAbiSurface { abi: extdeps.runtime.syscalls.linux.linux_x86_64_syscall_abi },
}

fn witness_architecture_is_x86_64() -> Bool {
  x86_64_linux_architecture_profile.architecture == extdeps.toolchain.types.X86_64
}

fn witness_word_width_is_64() -> Bool {
  std.measure.bit_width_count(x86_64_linux_architecture_profile.word_width) == 64
}

fn witness_page_size_is_4096() -> Bool {
  std.measure.byte_size_count(x86_64_linux_architecture_profile.page_size) == 4096
}

fn witness_convention_arg3_is_r10() -> Bool {
  x86_64_linux_architecture_profile.calling_convention.arg3 == extdeps.runtime.abi.sysv_amd64.amd64_inhabitant_r10
}

fn witness_stack_grows_down() -> Bool {
  x86_64_linux_architecture_profile.stack_layout.grows_down == true
}

fn witness_deployment_invocation_matches_linux_abi() -> Bool {
  match x86_64_linux_deployment_target.invocation {
    std.os.invocation.SyscallAbiSurface { abi: a } => a == extdeps.runtime.syscalls.linux.linux_x86_64_syscall_abi
    _ => false
  }
}
