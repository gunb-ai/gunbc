module extdeps.runtime.local



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/runtime"
  }
}

type LocalDevRuntime {
  adc_env_var: std.types.NonEmptyStr
}

data local_dev_runtime: LocalDevRuntime = {
  adc_env_var: "GOOGLE_APPLICATION_CREDENTIALS"
}
