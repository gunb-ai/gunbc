data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "refspecs.linuxfoundation.org/elf/x86_64-abi-0.99.pdf"
  }
}

data x86_64_abi_pdf_authority: ExternalAuthority = extdeps_external_authority_anchor

data x86_64_abi_specification: NonEmptyStr = "System V AMD64 ABI"

data x86_64_abi_subject_ref: ExternalSubjectRef = ExternalSubjectRef {
  declaration: DeclarationRef {
    module_path: "extdeps.runtime.abi.sysv_amd64",
    decl_name: "x86_64_abi_specification",
    field: WholeDeclaration,
  }
}

data x86_64_abi_pdf_identity: CitedRepresentationIdentity = cited_representation_identity(
  source: x86_64_abi_subject_ref,
  access_route: x86_64_abi_pdf_authority.uri,
  byte_domain: RawResponseBody,
)

data x86_64_abi_pdf_draft_edition_note: String = "Document cover: Draft Version 0.99.6, dated July 2 2012 — NOT the filename 0.99. VersionIdentity carries the edition string 0.99.6."

data x86_64_abi_pdf_wet_receipt_note: String = "Pin establishment and byte retrieval are separate wet runs with distinct run_identity values. expected_identity on the pin is minted only from the pin-establishment receipt hex through sha256_hex_digest — never from the retrieval observation arm. The retrieval run independently hashes its own receipt hex into observed_identity. reconcile_citation_representation joins the two only after cited_representation_identity_eq; a malformed local receipt hex refuses as WetReceiptHexMalformed, never as an HTTP status."

data x86_64_abi_pdf_pin_establishment_activity: ProvActivityId = "x86-64-abi-pdf-pin-establishment" as ProvActivityId

data x86_64_abi_pdf_retrieval_activity: ProvActivityId = "wet-representation-retrieval" as ProvActivityId

data x86_64_abi_pdf_pin_establishment_observed_at: EpochMs = 1785801600000

data x86_64_abi_pdf_retrieval_observed_at: EpochMs = 1785844800000

data x86_64_abi_pdf_pin_establishment_receipt_hex: String = "69e117a13b560b1b957c15f05a61b130ca56828f05dca951e27cb8e2ada14283"

data x86_64_abi_pdf_wet_receipt_hex: String = "69e117a13b560b1b957c15f05a61b130ca56828f05dca951e27cb8e2ada14283"

fn x86_64_abi_pdf_wet_run_identity(activity: ProvActivityId, observed_at: EpochMs) -> Fnv1a64Structural {
  content_hash_combine_structural(
    left: content_hash_tagged_structural(
      tag: "x86-64-abi-pdf-wet-run-activity",
      payload: content_hash_atom(value: activity as NonEmptyStr),
    ),
    right: content_hash_tagged_structural(
      tag: "x86-64-abi-pdf-wet-run-observed-at",
      payload: content_hash_atom(value: to_string(observed_at) as NonEmptyStr),
    ),
  )
}

data x86_64_abi_pdf_pin_establishment_run_identity: Fnv1a64Structural = x86_64_abi_pdf_wet_run_identity(
  activity: x86_64_abi_pdf_pin_establishment_activity,
  observed_at: x86_64_abi_pdf_pin_establishment_observed_at,
)

data x86_64_abi_pdf_retrieval_run_identity: Fnv1a64Structural = x86_64_abi_pdf_wet_run_identity(
  activity: x86_64_abi_pdf_retrieval_activity,
  observed_at: x86_64_abi_pdf_retrieval_observed_at,
)

type X86_64AbiPdfWetReceiptHexRefusalCause = WetReceiptHexMalformed { hex: String }

type X86_64AbiPdfValidatedDigestConstruction = X86_64AbiPdfValidatedDigestConstructed(Sha256Digest) | X86_64AbiPdfValidatedDigestHexRefused { hex: String, cause: X86_64AbiPdfWetReceiptHexRefusalCause }

type X86_64AbiPdfPinEstablishmentDigestConstruction = X86_64AbiPdfPinEstablishmentDigestConstructed(Sha256Digest) | X86_64AbiPdfPinEstablishmentDigestRefused { hex: String, cause: X86_64AbiPdfWetReceiptHexRefusalCause }

type X86_64AbiPdfRetrievalObservationConstruction = X86_64AbiPdfRetrievalObserved(CitationRetrievalObservation) | X86_64AbiPdfRetrievalDigestHexRefused { hex: String, cause: X86_64AbiPdfWetReceiptHexRefusalCause }

type X86_64AbiPdfPinRefusalCause = PinEstablishmentDigestHexRefused { hex: String, cause: X86_64AbiPdfWetReceiptHexRefusalCause }

data x86_64_abi_application_pdf: MediaType = MediaType {
  top_level: TopLevelApplication,
  subtype: "pdf",
  parameters: [],
}

type X86_64AbiPdfExpectedDigestConstruction = X86_64AbiPdfExpectedDigestConstructed(Sha256Digest) | X86_64AbiPdfExpectedDigestRefused { cause: X86_64AbiPdfPinRefusalCause }

type X86_64AbiPdfCitationSelectorRefusalCause = X86_64AbiPdfCitationSelectorFragmentRefused { cause: NavigableUriRefusalCause } | X86_64AbiPdfCitationSelectorSafeSequenceRefused { cause: PdfProfileRefusalCause }

type X86_64AbiPdfCitationSelectorConstruction = X86_64AbiPdfCitationSelectorConstructed(CitationSelector) | X86_64AbiPdfCitationSelectorRefused { cause: X86_64AbiPdfCitationSelectorRefusalCause }

type X86_64AbiPdfNavigableUriProjection = X86_64AbiPdfNavigableUriProjected { uri: Uri } | X86_64AbiPdfNavigableUriRefused { cause: NavigableUriSafeRefusalCause }

type X86_64AbiPdfPinConstruction = X86_64AbiPdfPinConstructed(Pin<CitedRepresentationIdentity>) | X86_64AbiPdfPinRefused { cause: X86_64AbiPdfPinRefusalCause }

type X86_64AbiCitationFactConstruction = X86_64AbiCitationFactConstructed(RecordedFact<CitationRecordedFact<CitationSelector>>) | X86_64AbiCitationFactRefused { pin: X86_64AbiPdfPinConstruction, selector: X86_64AbiPdfCitationSelectorConstruction }

type X86_64AbiEvidenceLinkConstruction = X86_64AbiEvidenceLinkConstructed(EvidenceLink<CitationRecordedFact<CitationSelector>, ClaimId, ExternalAuthority, NonEmptyStr, ReadBackProbe>) | X86_64AbiEvidenceLinkRefused { fact: X86_64AbiCitationFactConstruction }

fn x86_64_abi_pdf_validated_digest_from_wet_receipt(hex: String) -> X86_64AbiPdfValidatedDigestConstruction {
  match sha256_hex_digest(hex: hex) {
    Present { value: digest } => X86_64AbiPdfValidatedDigestConstructed(digest)
    Absent =>
      X86_64AbiPdfValidatedDigestHexRefused {
        hex: hex,
        cause: WetReceiptHexMalformed { hex: hex },
      }
  }
}

fn assemble_x86_64_abi_pdf_pin_establishment_digest() -> X86_64AbiPdfPinEstablishmentDigestConstruction {
  match x86_64_abi_pdf_validated_digest_from_wet_receipt(hex: x86_64_abi_pdf_pin_establishment_receipt_hex) {
    X86_64AbiPdfValidatedDigestConstructed(digest) => X86_64AbiPdfPinEstablishmentDigestConstructed(digest)
    X86_64AbiPdfValidatedDigestHexRefused { hex: hex, cause: cause } =>
      X86_64AbiPdfPinEstablishmentDigestRefused { hex: hex, cause: cause }
  }
}

data x86_64_abi_pdf_pin_establishment_digest_construction: X86_64AbiPdfPinEstablishmentDigestConstruction = assemble_x86_64_abi_pdf_pin_establishment_digest()

fn x86_64_abi_pdf_retrieval_observation_from_hex(hex: String) -> X86_64AbiPdfRetrievalObservationConstruction {
  match x86_64_abi_pdf_validated_digest_from_wet_receipt(hex: hex) {
    X86_64AbiPdfValidatedDigestConstructed(digest) =>
      X86_64AbiPdfRetrievalObserved(
        RepresentationRetrieved {
          request: CitationRetrievalRequest {
            locator: x86_64_abi_pdf_authority.uri,
          },
          observed_at: x86_64_abi_pdf_retrieval_observed_at,
          http_status: 200,
          observed: observed_cited_representation(
            identity: x86_64_abi_pdf_identity,
            media_type: x86_64_abi_application_pdf,
            observed_identity: digest,
          ),
        },
      )
    X86_64AbiPdfValidatedDigestHexRefused { hex: refused_hex, cause: cause } =>
      X86_64AbiPdfRetrievalDigestHexRefused { hex: refused_hex, cause: cause }
  }
}

fn assemble_x86_64_abi_pdf_retrieval_observation() -> X86_64AbiPdfRetrievalObservationConstruction {
  x86_64_abi_pdf_retrieval_observation_from_hex(hex: x86_64_abi_pdf_wet_receipt_hex)
}

data x86_64_abi_pdf_byte_extraction_construction: X86_64AbiPdfRetrievalObservationConstruction = assemble_x86_64_abi_pdf_retrieval_observation()

data x86_64_abi_pdf_draft_version: VersionIdentity = "0.99.6" as VersionIdentity

fn assemble_x86_64_abi_pdf_expected_digest() -> X86_64AbiPdfExpectedDigestConstruction {
  match x86_64_abi_pdf_pin_establishment_digest_construction {
    X86_64AbiPdfPinEstablishmentDigestConstructed(digest) => X86_64AbiPdfExpectedDigestConstructed(digest)
    X86_64AbiPdfPinEstablishmentDigestRefused { hex: hex, cause: cause } =>
      X86_64AbiPdfExpectedDigestRefused {
        cause: PinEstablishmentDigestHexRefused { hex: hex, cause: cause },
      }
  }
}

data x86_64_abi_pdf_expected_digest_construction: X86_64AbiPdfExpectedDigestConstruction = assemble_x86_64_abi_pdf_expected_digest()

fn assemble_x86_64_abi_pdf_pin_construction() -> X86_64AbiPdfPinConstruction {
  match x86_64_abi_pdf_pin_establishment_digest_construction {
    X86_64AbiPdfPinEstablishmentDigestConstructed(digest) =>
      X86_64AbiPdfPinConstructed(
        citation_exact_pin(
          source: x86_64_abi_subject_ref,
          access_route: x86_64_abi_pdf_authority.uri,
          byte_domain: RawResponseBody,
          version: x86_64_abi_pdf_draft_version,
          expected_identity: digest,
        ),
      )
    X86_64AbiPdfPinEstablishmentDigestRefused { hex: hex, cause: cause } =>
      X86_64AbiPdfPinRefused {
        cause: PinEstablishmentDigestHexRefused { hex: hex, cause: cause },
      }
  }
}

data x86_64_abi_pdf_pin_construction: X86_64AbiPdfPinConstruction = assemble_x86_64_abi_pdf_pin_construction()

data x86_64_abi_pdf_version_cover_sequence: PdfSafeParameterSequenceConstruction = pdf_safe_parameter_sequence(
  constructions: [pdf_open_page(page: 1)],
)

data x86_64_abi_syscall_convention_authoritative_page: PositiveInt = 125

data x86_64_abi_pdf_syscall_convention_sequence: PdfSafeParameterSequenceConstruction = pdf_safe_parameter_sequence(
  constructions: [pdf_open_page(page: x86_64_abi_syscall_convention_authoritative_page)],
)

fn x86_64_abi_syscall_citation_page_is_authoritative(page: PositiveInt) -> Bool {
  page == x86_64_abi_syscall_convention_authoritative_page
}

fn x86_64_abi_pdf_fragment_selector_from_page(page: PositiveInt) -> X86_64AbiPdfCitationSelectorConstruction {
  match pdf_open_fragment_selector(
    sequence: match rfc_pdf_open_parameter_sequence(constructions: [pdf_open_page(page: page)]) {
      SequenceConstructed(seq) => seq
    },
  ) {
    PdfOpenFragmentSelectorConstructed(selector) => X86_64AbiPdfCitationSelectorConstructed(selector)
    PdfOpenFragmentSelectorRefused { cause: cause } =>
      X86_64AbiPdfCitationSelectorRefused {
        cause: X86_64AbiPdfCitationSelectorFragmentRefused { cause: cause },
      }
  }
}

fn x86_64_abi_pdf_citation_selector_from_safe(
  construction: PdfSafeParameterSequenceConstruction,
) -> X86_64AbiPdfCitationSelectorConstruction {
  match construction {
    SafeSequenceConstructed(sequence) =>
      match pdf_open_fragment_selector(
        sequence: pdf_safe_parameter_sequence_to_rfc(sequence: sequence),
      ) {
        PdfOpenFragmentSelectorConstructed(selector) => X86_64AbiPdfCitationSelectorConstructed(selector)
        PdfOpenFragmentSelectorRefused { cause: cause } =>
          X86_64AbiPdfCitationSelectorRefused {
            cause: X86_64AbiPdfCitationSelectorFragmentRefused { cause: cause },
          }
      }
    SafeSequenceConstructionRefused { cause: cause } =>
      X86_64AbiPdfCitationSelectorRefused {
        cause: X86_64AbiPdfCitationSelectorSafeSequenceRefused { cause: cause },
      }
  }
}

data x86_64_abi_pdf_version_fragment_selector: X86_64AbiPdfCitationSelectorConstruction = x86_64_abi_pdf_citation_selector_from_safe(construction: x86_64_abi_pdf_version_cover_sequence)

data x86_64_abi_pdf_syscall_fragment_selector: X86_64AbiPdfCitationSelectorConstruction = x86_64_abi_pdf_citation_selector_from_safe(construction: x86_64_abi_pdf_syscall_convention_sequence)

fn x86_64_abi_syscall_citation_fact_construction() -> X86_64AbiCitationFactConstruction {
  match x86_64_abi_pdf_pin_construction {
    X86_64AbiPdfPinConstructed(pin) =>
      match x86_64_abi_pdf_syscall_fragment_selector {
        X86_64AbiPdfCitationSelectorConstructed(selector) =>
          X86_64AbiCitationFactConstructed(
            citation_recorded_fact(
              id: "x86-64-abi-linux-syscall-arg3-r10-citation" as RecordedFactId,
              cited: citation_target(expected_pin: pin, selector: selector),
            ),
          )
        X86_64AbiPdfCitationSelectorRefused { cause: selector_cause } =>
          X86_64AbiCitationFactRefused {
            pin: X86_64AbiPdfPinConstructed(pin),
            selector: X86_64AbiPdfCitationSelectorRefused { cause: selector_cause },
          }
      }
    X86_64AbiPdfPinRefused { cause: pin_cause } =>
      match x86_64_abi_pdf_syscall_fragment_selector {
        X86_64AbiPdfCitationSelectorConstructed(selector) =>
          X86_64AbiCitationFactRefused {
            pin: X86_64AbiPdfPinRefused { cause: pin_cause },
            selector: X86_64AbiPdfCitationSelectorConstructed(selector),
          }
        X86_64AbiPdfCitationSelectorRefused { cause: selector_cause } =>
          X86_64AbiCitationFactRefused {
            pin: X86_64AbiPdfPinRefused { cause: pin_cause },
            selector: X86_64AbiPdfCitationSelectorRefused { cause: selector_cause },
          }
      }
  }
}

data x86_64_abi_syscall_convention_citation_fact_construction: X86_64AbiCitationFactConstruction = x86_64_abi_syscall_citation_fact_construction()

fn x86_64_abi_syscall_evidence_link_construction() -> X86_64AbiEvidenceLinkConstruction {
  match x86_64_abi_syscall_convention_citation_fact_construction {
    X86_64AbiCitationFactConstructed(fact) =>
      X86_64AbiEvidenceLinkConstructed(
        EvidenceLink {
          fact: fact,
          direction: EvidenceSupports,
          inference_rule: "citation-extraction-supports-syscall-arg3-claim" as InferenceRuleId,
          authority: x86_64_abi_pdf_authority,
          provenance: EvidenceProvenance {
            entity: "x86-64-abi-pdf-byte-extraction" as ProvEntityId,
            activity: x86_64_abi_pdf_retrieval_activity,
            agent: "gunbc-citation-extraction-receipt" as ProvAgentId,
          },
          freshness: EvidenceFreshness {
            maximum_conclusion: "x86-64-abi-linux-syscall-arg3-is-r10" as ClaimId,
            basis: "draft-edition-0.99.6-page-125-syscall-register-convention",
          },
          fidelity: EvidenceFidelity {
            boundary: "raw-response-body-sha256" as NonEmptyStr,
            losses: [],
          },
          probe_independence: ReadBackProbe {
            label: "independent-byte-extraction-receipt" as NonEmptyStr,
            subject: "x86-64-abi-pdf-raw-response-body" as NonEmptyStr,
            effect_on_subject: ProbeMayEstablish {
              mechanism: "wet retrieval hashes bytes independently of authored pin",
            },
          },
        },
      )
    X86_64AbiCitationFactRefused { pin: pin_construction, selector: selector_construction } =>
      X86_64AbiEvidenceLinkRefused {
        fact: X86_64AbiCitationFactRefused {
          pin: pin_construction,
          selector: selector_construction,
        },
      }
  }
}

fn witness_pin_establishment_and_retrieval_run_identities_differ() -> Bool {
  x86_64_abi_pdf_pin_establishment_run_identity != x86_64_abi_pdf_retrieval_run_identity
}

fn witness_syscall_citation_reconciles_pin_and_retrieval() -> Bool {
  match x86_64_abi_pdf_pin_construction {
    X86_64AbiPdfPinConstructed(pin) =>
      match x86_64_abi_pdf_byte_extraction_construction {
        X86_64AbiPdfRetrievalObserved(observation) =>
          match observation {
            RepresentationRetrieved { observed: o, request: _, observed_at: _, http_status: _ } =>
              reconcile_citation_representation(expected_pin: pin, observed: Present { value: o }) == RepresentationMatch
            _ => false
          }
        X86_64AbiPdfRetrievalDigestHexRefused { hex: _, cause: _ } => false
      }
    X86_64AbiPdfPinRefused { cause: _ } => false
  }
}

fn witness_syscall_evidence_link_binds_fact() -> Bool {
  match x86_64_abi_syscall_evidence_link_construction() {
    X86_64AbiEvidenceLinkConstructed(link) =>
      match x86_64_abi_syscall_convention_citation_fact_construction {
        X86_64AbiCitationFactConstructed(fact) => link.fact.id == fact.id
        X86_64AbiCitationFactRefused { pin: _, selector: _ } => false
      }
    X86_64AbiEvidenceLinkRefused { fact: X86_64AbiCitationFactConstructed(_) } => false
    X86_64AbiEvidenceLinkRefused { fact: X86_64AbiCitationFactRefused { pin: _, selector: _ } } => false
  }
}

fn x86_64_abi_pdf_navigable_uri_from_safe(
  construction: PdfSafeParameterSequenceConstruction,
) -> X86_64AbiPdfNavigableUriProjection {
  match project_navigable_uri_safe(
    base: x86_64_abi_pdf_authority.uri,
    construction: construction,
  ) {
    NavigableUriSafeProjected { uri: u } => X86_64AbiPdfNavigableUriProjected { uri: u }
    NavigableUriSafeRefused { cause: cause } => X86_64AbiPdfNavigableUriRefused { cause: cause }
  }
}

fn x86_64_abi_pdf_navigable_uri_from_nameddest_scalar_code_points(
  name: NonEmptyStr,
  code_points: List<Int>,
) -> X86_64AbiPdfNavigableUriProjection {
  match pdf_open_nameddest_wire_from_scalar_code_points(name: name, code_points: code_points) {
    PdfProfileParameterWireRefused { parameter: p, cause: cause } =>
      X86_64AbiPdfNavigableUriRefused {
        cause: PdfOpenParameterPercentEncodeRefusedFromSafe { parameter: p, cause: cause },
      }
    PdfProfileParameterWired { wire: wire } =>
      match navigable_uri_projection_from_sequence_wire(
        base: x86_64_abi_pdf_authority.uri,
        sequence_wire: PdfOpenParameterSequenceWired { wire: wire },
      ) {
        NavigableUriProjected { uri: u } => X86_64AbiPdfNavigableUriProjected { uri: u }
        NavigableUriRefused { cause: BaseLocatorAlreadyCarriesFragment { locator: l } } =>
          X86_64AbiPdfNavigableUriRefused {
            cause: BaseLocatorAlreadyCarriesFragmentFromRfc { locator: l },
          }
        NavigableUriRefused { cause: PdfOpenParameterPercentEncodeRefused { parameter: p, cause: c } } =>
          X86_64AbiPdfNavigableUriRefused {
            cause: PdfOpenParameterPercentEncodeRefusedFromSafe { parameter: p, cause: c },
          }
      }
  }
}

data x86_64_abi_pdf_version_navigable_uri_projection: X86_64AbiPdfNavigableUriProjection = x86_64_abi_pdf_navigable_uri_from_safe(construction: x86_64_abi_pdf_version_cover_sequence)

data x86_64_abi_pdf_syscall_navigable_uri_projection: X86_64AbiPdfNavigableUriProjection = x86_64_abi_pdf_navigable_uri_from_safe(construction: x86_64_abi_pdf_syscall_convention_sequence)

type Amd64Gpr = Rdi | Rsi | Rdx | R10 | R8 | R9 | Rax | Rcx

data amd64_inhabitant_rdi: ArchitecturalRegister = Rdi
data amd64_inhabitant_rsi: ArchitecturalRegister = Rsi
data amd64_inhabitant_rdx: ArchitecturalRegister = Rdx
data amd64_inhabitant_r10: ArchitecturalRegister = R10
data amd64_inhabitant_r8: ArchitecturalRegister = R8
data amd64_inhabitant_r9: ArchitecturalRegister = R9
data amd64_inhabitant_rax: ArchitecturalRegister = Rax
data amd64_inhabitant_rcx: ArchitecturalRegister = Rcx

data sysv_amd64_linux_syscall_convention: CallingConvention = {
  arg0: amd64_inhabitant_rdi,
  arg1: amd64_inhabitant_rsi,
  arg2: amd64_inhabitant_rdx,
  arg3: amd64_inhabitant_r10,
  arg4: amd64_inhabitant_r8,
  arg5: amd64_inhabitant_r9,
  syscall_number: amd64_inhabitant_rax,
  return_value: amd64_inhabitant_rax,
}

data sysv_amd64_wrong_arg3_convention: CallingConvention = {
  arg0: amd64_inhabitant_rdi,
  arg1: amd64_inhabitant_rsi,
  arg2: amd64_inhabitant_rdx,
  arg3: amd64_inhabitant_rcx,
  arg4: amd64_inhabitant_r8,
  arg5: amd64_inhabitant_r9,
  syscall_number: amd64_inhabitant_rax,
  return_value: amd64_inhabitant_rax,
}

fn witness_convention_arg3_identity() -> Bool {
  sysv_amd64_linux_syscall_convention.arg3 == amd64_inhabitant_r10
}

fn witness_convention_arg3_resolves_to_r10() -> Bool {
  sysv_amd64_linux_syscall_convention.arg3 == R10
}

fn witness_convention_number_resolves_to_rax() -> Bool {
  sysv_amd64_linux_syscall_convention.syscall_number == Rax
}

fn witness_convention_return_resolves_to_rax() -> Bool {
  sysv_amd64_linux_syscall_convention.return_value == Rax
}

fn witness_distinct_conventions_not_equal() -> Bool {
  sysv_amd64_linux_syscall_convention != sysv_amd64_wrong_arg3_convention
}
