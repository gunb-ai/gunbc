module extdeps.runtime.abi.sysv_amd64

import std.abi { ArchitecturalRegister, CallingConvention }
import std.types { Bool, NonEmptyStr, EpochMs }
import std.citation {
  CitedResource,
  RetrievedRepresentation,
  CitationSelector,
  cited_resource,
  citation_exact_pin,
  CitedRepresentation,
  RawResponseBody,
  CitationRetrievalObservation,
  RepresentationRetrieved,
  CitationRetrievalRequest,
  observed_cited_representation,
  retrieved_representation,
  citation_recorded_fact,
  CitationRecordedFact,
  CitationAccessRefused,
  CitationUnreachable,
  CitationRateLimited,
}
import extdeps.pin { Pin }
import extdeps.version { VersionIdentity }
import std.content_hash { Sha256Digest, Sha256DigestHex, sha256_hex_digest }
import extdeps.http.server { MediaType, TopLevelApplication }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.standards.rfc_8118 {
  pdf_open_fragment_selector,
  pdf_open_page,
  rfc_pdf_open_parameter_sequence,
  SequenceConstructed,
}
import gunbc.citation.pdf_safe_profile {
  PdfSafeParameterSequenceConstruction,
  SafeSequenceConstructed,
  SafeSequenceConstructionRefused,
