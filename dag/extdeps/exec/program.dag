module extdeps.exec.program

import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/functions/exec.html"
  }
}

// THE PROGRAM AN ARGV NAMES, BELOW THE COMMAND THAT INVOKES IT. execve takes the file to execute
// as its own parameter (the anchor above), and extdeps.exec.command ArgvCommand already carries it
// apart from the arguments. What it did not carry is WHICH program that is in any sense the
// corpus can count: the field was a NonEmptyStr, so "which executables does gunbc run, and which
// of them does anything install" had no answer short of reading every builder by hand.
//
// This leaf is the identity, and only the identity. It sits below extdeps.exec.command and below
// extdeps.tools so both can import it: the command layer names the program it invokes, and a
// CliTool row CARRIES the same identity together with how to acquire it. Acquisition, placement
// and convergence are installation policy and stay out of this module; the command layer must not
// depend on them (DESIGN §3, interface vs policy).
//
// `invocation` is the word handed to execve as the program: a bare name resolved on PATH, or an
// absolute path. Which of the two a program uses is today a fact of the row that mints it; a
// uniform placement is the business of the host-program lifecycle built on this identity, not of
// this leaf.
type ProgramIdentity sole_constructor {
  invocation: NonEmptyStr
  catalog: ProgramCatalogStanding
}

// EVERY IDENTITY ROW IS A NULLARY fn, NOT A data DECLARATION. That is a workaround of a language
// gap, not a modeling choice: admission names no caller for a data declaration, so a data row
// could never be admitted. The gap and its trigger are
// gunbc.recurring_failure_mode admit_callers_names_no_caller_for_a_data_declaration; when it
// climbs, the rows return to `data`.
//
// Whether a CliTool row carries this program. It is stamped at the mint rather than looked up,
// because the two mints below are separately sealed: which one a program's row calls is the
// classification, and the compiler holds it.
type ProgramCatalogStanding
  = CatalogCarried
  | UncatalogedDebt

// THE CATALOGED MINT. Every admitted caller is either the identity row of a program a CliTool row
// catalogs -- the CliTool's `program` field IS that row, so the tool that is probed and the program
// that is run are one declaration -- or a builder of a cataloged tool whose placement is still
// caller-supplied (busybox, node). An identity cannot be classified as cataloged without an edit to
// this list, and review of that edit is where carriage is checked: nothing here forces the CliTool
// row to exist. That residue would close by admitting the CliTool rows themselves, so an identity is
// born only inside the row that catalogs it, and that waits on two things: a CliTool row is a data
// declaration, which admission cannot name
// (gunbc.recurring_failure_mode admit_callers_names_no_caller_for_a_data_declaration), and the argv
// builders of extdeps.exec.command sit below extdeps.tools and could not then reach the identity.
fn cataloged_program(invocation: NonEmptyStr) -> ProgramIdentity
  admit_callers: [
    decl_ref(module_path: "extdeps.exec.command", decl_name: "sshpass_program"),
    decl_ref(module_path: "extdeps.tools.curl", decl_name: "curl_program"),
    decl_ref(module_path: "extdeps.tools.sed", decl_name: "sed_program"),
    decl_ref(module_path: "extdeps.tools.conntrack", decl_name: "conntrack_program"),
    decl_ref(module_path: "extdeps.tools.mosquitto_pub", decl_name: "mosquitto_pub_program"),
    decl_ref(module_path: "extdeps.tools.busybox", decl_name: "busybox_httpd_command"),
    decl_ref(module_path: "extdeps.tools.busybox", decl_name: "busybox_tftpd_over_udpsvd_command"),
    decl_ref(module_path: "extdeps.tools.busybox", decl_name: "busybox_dd_sparse_image_command"),
    decl_ref(module_path: "extdeps.tools.unzip", decl_name: "unzip_program"),
    decl_ref(module_path: "extdeps.tools.node", decl_name: "node_version_command"),
    decl_ref(module_path: "extdeps.tools.node", decl_name: "node_eval_command"),
    decl_ref(module_path: "extdeps.tools.xorriso", decl_name: "xorriso_program"),
    decl_ref(module_path: "extdeps.nftables.ruleset", decl_name: "nft_program"),
    decl_ref(module_path: "extdeps.crypto.hash", decl_name: "sha256sum_program"),
    decl_ref(module_path: "extdeps.tools.grep", decl_name: "grep_program"),
    decl_ref(module_path: "extdeps.tools.wc", decl_name: "wc_program"),
    decl_ref(module_path: "extdeps.tools.nbdkit", decl_name: "nbdkit_program"),
    decl_ref(module_path: "extdeps.tools.sha512sum", decl_name: "sha512sum_program"),
    decl_ref(module_path: "extdeps.tools.gzip", decl_name: "gzip_program"),
    decl_ref(module_path: "extdeps.tools.rustfmt", decl_name: "rustfmt_program"),
    decl_ref(module_path: "extdeps.tools.npm", decl_name: "npm_program"),
    decl_ref(module_path: "extdeps.tools.node", decl_name: "node_program"),
    decl_ref(module_path: "extdeps.tools.socat", decl_name: "socat_program"),
    decl_ref(module_path: "extdeps.tools.sleep", decl_name: "sleep_program"),
    decl_ref(module_path: "extdeps.tools.jq", decl_name: "jq_program"),
    decl_ref(module_path: "extdeps.tools.gh", decl_name: "gh_program"),
    decl_ref(module_path: "extdeps.tools.websocat", decl_name: "websocat_program"),
    decl_ref(module_path: "extdeps.tools.websocat", decl_name: "websocat_nbd_proxy_bridge_command"),
    decl_ref(module_path: "extdeps.tools.gcloud", decl_name: "gcloud_program"),
    decl_ref(module_path: "extdeps.tools.busybox", decl_name: "busybox_program"),
    decl_ref(module_path: "extdeps.tools.openssl", decl_name: "openssl_program"),
    decl_ref(module_path: "extdeps.netfilter.nfct", decl_name: "nfct_program"),
    decl_ref(module_path: "extdeps.netfilter.iptables_legacy", decl_name: "iptables_legacy_save_program"),
  ]
  = ProgramIdentity { invocation: invocation, catalog: CatalogCarried }

// THE DEBT ROSTER. This admit list IS the census of every program gunbc invokes through a typed
// argv that no catalog row models -- one entry per identity, and there is no second roster
// restating it. A new uncataloged program is a compiler refusal until it is added here, which is a
// conspicuous, counted review event rather than a string written at a call site.
//
// An entry leaves in one of three ways, each a typed change to its row: the row calls
// cataloged_program because a CliTool now carries it (modeled); the row is deleted because nothing
// invokes the program any more (retired); or a parameterized builder stops taking its program as
// a caller-supplied path and takes an identity instead (typed carrier). No fourth route exists.
//
// The entries after the identity rows are PARAMETERIZED BUILDERS: the program is a caller-supplied
// path, so the builder mints the identity itself. Each leaves this list by taking a
// ProgramIdentity parameter instead, which moves the identity to the caller's row.
//
// RUNG, stated at what was measured: the seals refuse an unlisted caller of either mint and a
// spelled record (test.claim.infer_program_identity_admission_witness). They do NOT refuse a
// NonEmptyStr handed to a ProgramIdentity position: that is accepted in silence today, which is
// gunbc.recurring_failure_mode refined_alias_argument_exempt_from_declared_type_inhabitance. Until
// that row climbs, an admitted argv builder could pass a string and skip both mints, so the census
// holds at admission plus review of the builder, not by construction alone.
//
// SCOPE, stated so it is not read as a clean bill: programs named inside STRING carriers -- a
// sudo/systemd-run/docker-exec argv carried as List<String>, a `sh -c` or bash script body, a
// systemd ExecStart line, a TransportScript -- never reach this mint and are outside the census
// until their carrier is typed.
fn uncataloged_program(invocation: NonEmptyStr) -> ProgramIdentity
  admit_callers: [
    decl_ref(module_path: "extdeps.languages.bash.invocation", decl_name: "bash_program"),
    decl_ref(module_path: "extdeps.cargo_build", decl_name: "cargo_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "cat_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "cp_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "install_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "ln_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "ls_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "mktemp_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "od_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "mkdir_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "mv_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "sort_program"),
    decl_ref(module_path: "extdeps.tools.ldd", decl_name: "ldd_program"),
    decl_ref(module_path: "extdeps.tools.dpkg_deb", decl_name: "dpkg_deb_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "printf_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "readlink_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "rm_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "rmdir_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "dd_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "timeout_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "tee_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "true_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "whoami_program"),
    decl_ref(module_path: "extdeps.tools.gnu_coreutils", decl_name: "pwd_program"),
    decl_ref(module_path: "extdeps.posix.getent", decl_name: "getent_program"),
    decl_ref(module_path: "gunbc.claim_executor_cli", decl_name: "claim_executor_program"),
    decl_ref(module_path: "extdeps.docker.cli", decl_name: "docker_program"),
    decl_ref(module_path: "extdeps.tools.e2fsprogs", decl_name: "dumpe2fs_program"),
    decl_ref(module_path: "extdeps.tools.e2fsprogs", decl_name: "mke2fs_program"),
    decl_ref(module_path: "extdeps.tools.env", decl_name: "env_absolute_program"),
    decl_ref(module_path: "extdeps.tools.env", decl_name: "env_path_resolved_program"),
    decl_ref(module_path: "extdeps.tools.findutils", decl_name: "find_program"),
    decl_ref(module_path: "extdeps.posix.getconf", decl_name: "getconf_program"),
    decl_ref(module_path: "extdeps.git", decl_name: "git_program"),
    decl_ref(module_path: "extdeps.tools.gnu_time", decl_name: "gnu_time_program"),
    decl_ref(module_path: "extdeps.tools.hostname", decl_name: "hostname_program"),
    decl_ref(module_path: "extdeps.tools.id", decl_name: "id_program"),
    decl_ref(module_path: "extdeps.iproute2.ip_neigh", decl_name: "ip_program"),
    decl_ref(module_path: "extdeps.tools.make", decl_name: "make_program"),
    decl_ref(module_path: "extdeps.package_managers.conda_forge", decl_name: "micromamba_program"),
    decl_ref(module_path: "extdeps.storage.nbd", decl_name: "nbd_client_program"),
    decl_ref(module_path: "extdeps.storage.nbd", decl_name: "nbd_server_program"),
    decl_ref(module_path: "extdeps.package_managers.pip", decl_name: "pip_program"),
    decl_ref(module_path: "extdeps.posix.sh_invocation", decl_name: "posix_sh_program"),
    decl_ref(module_path: "extdeps.cadquery.cadquery", decl_name: "python_program"),
    decl_ref(module_path: "extdeps.ssh.openssh_client_commands", decl_name: "scp_program"),
    decl_ref(module_path: "extdeps.ssh.openssh_client_commands", decl_name: "ssh_add_program"),
    decl_ref(module_path: "extdeps.ssh.openssh_client_commands", decl_name: "openssh_client_program"),
    decl_ref(module_path: "extdeps.ssh.openssh_client_commands", decl_name: "ssh_keygen_program"),
    decl_ref(module_path: "extdeps.ssh.openssh_client_commands", decl_name: "ssh_keyscan_program"),
    decl_ref(module_path: "extdeps.tools.stat", decl_name: "stat_program"),
    decl_ref(module_path: "extdeps.sudo.elevation", decl_name: "sudo_program"),
    decl_ref(module_path: "extdeps.systemd.systemctl", decl_name: "systemctl_absolute_program"),
    decl_ref(module_path: "extdeps.tailscale.serve", decl_name: "tailscale_program"),
    decl_ref(module_path: "extdeps.tools.tar", decl_name: "tar_program"),
    decl_ref(module_path: "extdeps.tools.btrfs_progs", decl_name: "btrfs_program"),
    decl_ref(module_path: "extdeps.tools.kopia", decl_name: "kopia_program_at"),
    decl_ref(module_path: "extdeps.virtualization.qemu", decl_name: "qemu_system_aarch64_program"),
    decl_ref(module_path: "extdeps.posix.test_utility", decl_name: "test_program"),
    decl_ref(module_path: "extdeps.tools.uname", decl_name: "uname_program"),
    decl_ref(module_path: "extdeps.tools.squashfs_tools", decl_name: "unsquashfs_program"),
    decl_ref(module_path: "extdeps.tools.util_linux_umount", decl_name: "umount_program"),
    decl_ref(module_path: "extdeps.tools.util_linux_flock", decl_name: "flock_program"),
    decl_ref(module_path: "extdeps.systemd.systemctl", decl_name: "systemctl_path_resolved_program"),
    decl_ref(module_path: "extdeps.systemd.systemd_run", decl_name: "systemd_run_program"),
    decl_ref(module_path: "extdeps.ntfy.serve", decl_name: "ntfy_version_command"),
    decl_ref(module_path: "extdeps.ntfy.access", decl_name: "ntfy_access_list_command"),
    decl_ref(module_path: "extdeps.printing.orca_slicer", decl_name: "orca_version_probe_command"),
    decl_ref(module_path: "extdeps.printing.orca_slicer", decl_name: "orca_slice_to_project_command"),
    decl_ref(module_path: "extdeps.tools.chmod", decl_name: "chmod_set_mode_command"),
    decl_ref(module_path: "extdeps.tools.chmod", decl_name: "chmod_recursive_set_mode_command"),
    decl_ref(module_path: "extdeps.tools.mkdir", decl_name: "mkdir_parents_command_at"),
    decl_ref(module_path: "extdeps.tools.mkdir", decl_name: "mkdir_exact_command_at"),
    decl_ref(module_path: "extdeps.virtualization.firecracker", decl_name: "firecracker_version_command"),
    decl_ref(module_path: "extdeps.virtualization.firecracker", decl_name: "firecracker_run_config_command"),
    decl_ref(module_path: "extdeps.virtualization.firecracker", decl_name: "firecracker_jailer_run_command"),
    decl_ref(module_path: "gunbc.gunbc_cli_command", decl_name: "gunbc_test_command"),
    decl_ref(module_path: "extdeps.browser.chromium", decl_name: "chromium_version_command"),
