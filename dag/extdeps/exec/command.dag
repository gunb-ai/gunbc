module extdeps.exec.command

import std.types { NonEmptyStr, String, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/ssh.1.html"
  }
}

type ShellCommand {
  argv: List<String>
}

type CommandTransport
  = LocalShell
  | SshExec { ssh_target: NonEmptyStr }

fn ssh_exec_prefix(target: NonEmptyStr) -> List<String> {
  [
    "sshpass", "-e",
    "ssh",
    "-o", "StrictHostKeyChecking=no",
    "-o", "UserKnownHostsFile=/dev/null",
    target as String,
  ]
}

fn command_over_transport(command: ShellCommand, transport: CommandTransport) -> ShellCommand {
  match transport {
    LocalShell => command
    SshExec { ssh_target: t } =>
      ShellCommand { argv: append(ssh_exec_prefix(target: t), items: command.argv) }
  }
}

fn shell_command_render(command: ShellCommand) -> String {
  join(command.argv, " ")
}
