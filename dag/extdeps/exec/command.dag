module extdeps.exec.command

import std.types { NonEmptyStr, String, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/ssh.1.html"
  }
}

type ArgvCommand {
  argv: List<String>
}

type CommandTransport
  = LocalExec
  | SshExec { ssh_target: NonEmptyStr }

data sshpass_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "sourceforge.net/projects/sshpass/"
  }
}

data ssh_host_key_verification_posture: String = "🟡 dissolve-on: ssh_exec_prefix — DECLARED SECURITY POSTURE, not an accident of argv building: StrictHostKeyChecking=no + UserKnownHostsFile=/dev/null disables SSH host-key verification for these fleet/BMC transports, so a LAN-position MITM would not be detected; accepted interim because the targets are LAN-scoped fleet members and BMCs whose host keys are not yet provisioned facts. sshpass (its own upstream, anchor above) feeds the password via -e (SSHPASS env), never argv. DISSOLVES WHEN known-hosts provisioning lands on gunbc.fleet_ssh_access (pinned host key per fleet member) and this prefix drops both overrides in favor of a pinned UserKnownHostsFile."

fn sshpass_prefix() -> List<String> {
  ["sshpass", "-e"]
}

fn ssh_host_key_override_opts() -> List<String> {
  ["-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null"]
}

fn ssh_exec_prefix(target: NonEmptyStr) -> List<String> {
  append(
    append(
      append(sshpass_prefix(), items: ["ssh"]),
      items: ssh_host_key_override_opts(),
    ),
    items: [target as String],
  )
}

fn scp_command(local_path: NonEmptyStr, remote_target: NonEmptyStr) -> ArgvCommand {
  ArgvCommand {
    argv: append(
      append(
        append(sshpass_prefix(), items: ["scp"]),
        items: ssh_host_key_override_opts(),
      ),
      items: [local_path as String, remote_target as String],
    )
  }
}

fn command_over_transport(command: ArgvCommand, transport: CommandTransport) -> ArgvCommand {
  match transport {
    LocalExec => command
    SshExec { ssh_target: t } =>
      ArgvCommand { argv: append(ssh_exec_prefix(target: t), items: command.argv) }
  }
}

fn shell_quote(arg: String) -> String {
  join(["'", join(split(s: arg, delimiter: "'"), "'\\''"), "'"], "")
}

fn shell_command_render(command: ArgvCommand) -> String {
  join(map(command.argv, a => shell_quote(arg: a)), " ")
}
