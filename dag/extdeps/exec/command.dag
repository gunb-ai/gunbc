module extdeps.exec.command

data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "man7.org/linux/man-pages/man1/ssh.1.html"
  }
}

type ArgvCommand {
  argv: List<String>
}

data ssh_exec_interpretation_note: String = "SshExec now carries the target's RemoteExecCommandInterpretation as a field, not an inferred fact: DESIGN §5 construction-over-validation -- whether the far side hands the RFC 4254 command string to a POSIX shell is a per-deployment implementation fact (gunbc.remote_shell_command remote_exec_command_interpretation_note), so the caller who knows which deployment it is targeting must declare it rather than command_over_transport guessing from the target string. A target this module cannot classify names Unknown explicitly; command_over_transport then refuses rather than picking a default (operator directive, 2026-08-19)."

type CommandTransport
  = LocalExec
  | SshExec { ssh_target: std.types.NonEmptyStr, interpretation: gunbc.remote_shell_command.RemoteExecCommandInterpretation }

data sshpass_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "sourceforge.net/projects/sshpass/"
  }
}

data ssh_host_key_verification_posture: String = "🟡 dissolve-on: ssh_exec_prefix — DECLARED SECURITY POSTURE, not an accident of argv building: StrictHostKeyChecking=no + UserKnownHostsFile=/dev/null disables SSH host-key verification for these fleet/BMC transports, so a LAN-position MITM would not be detected; accepted interim because the targets are LAN-scoped fleet members and BMCs whose host keys are not yet provisioned facts. sshpass (its own upstream, anchor above) feeds the password via -e (SSHPASS env), never argv. DISSOLVES WHEN known-hosts provisioning lands on gunbc.fleet_ssh_access (pinned host key per fleet member) and this prefix drops both overrides in favor of a pinned UserKnownHostsFile."

fn sshpass_prefix() -> List<String> {
  ["sshpass", "-e"]
}

fn ssh_host_key_override_opts() -> List<String> {
  ["-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null"]
}

fn ssh_exec_prefix(target: std.types.NonEmptyStr) -> List<String> {
  append(
    append(
      append(sshpass_prefix(), items: ["ssh"]),
      items: ssh_host_key_override_opts(),
    ),
    items: [target as String],
  )
}

fn scp_command(local_path: std.types.NonEmptyStr, remote_target: std.types.NonEmptyStr) -> ArgvCommand {
  ArgvCommand {
    argv: append(
      append(
        append(sshpass_prefix(), items: ["scp"]),
        items: ssh_host_key_override_opts(),
      ),
      items: [local_path as String, remote_target as String],
    )
  }
}

data command_over_transport_composition_note: String = "The SshExec arm no longer does append(ssh_exec_prefix, command.argv): that concatenated an outer local ssh/sshpass argv with an inner remote-shell argv as if they were one target's words, which is wrong in KIND (gunbc.remote_shell_command remote_exec_command_string_note) -- RFC 4254 section 6.5 carries the remote program as ONE command string, not a suffixed argv. The inner ArgvCommand is now folded through remote_exec_command_string into that one NonEmptyStr, cited to IEEE 1003.1-2017 section 2.2.2, and carried as the SINGLE final element of the outer ssh argv -- a composition of two targets, never a flattening of one into the other. Quoting stays a property of the interpretation arm named on SshExec, never of the transport itself: LocalExec never quotes anything, and an Unknown interpretation refuses here exactly as it refuses inside remote_exec_command_string, rather than this function inventing its own default."

type CommandOverTransportOutcome
  = CommandOverTransportBuilt { command: ArgvCommand }
  | CommandOverTransportRefused { cause: gunbc.remote_shell_command.RemoteExecCommandRefusalCause }

fn command_over_transport(command: ArgvCommand, transport: CommandTransport) -> CommandOverTransportOutcome {
  match transport {
    LocalExec => CommandOverTransportBuilt { command: command }
    SshExec { ssh_target: t, interpretation: interp } =>
      match gunbc.remote_shell_command.remote_exec_command_string(argv: map(command.argv, a => a as std.types.NonEmptyStr), interpretation: interp) {
        RemoteExecCommandRefused { cause: c } => CommandOverTransportRefused { cause: c }
        RemoteExecCommandBuilt { command: s } =>
          CommandOverTransportBuilt {
            command: ArgvCommand { argv: append(ssh_exec_prefix(target: t), items: [s as String]) }
          }
      }
  }
}

data shell_quote_provenance_note: String = "shell_quote delegates to extdeps.posix.shell_command_language posix_single_quote (operator finding, 2026-08-19): this was an independently hand-rolled THIRD copy of the single-quote wrap-and-escape encoding already consolidated once from v2.extdeps.languages.bash into the POSIX authority, and cited there against IEEE 1003.1-2017 section 2.2.2 -- split(s, delimiter: \"'\") then join with \"'\\''\" is the same operation as replace(s, \"'\", \"'\\''\"), so this is a pure internal-implementation swap: byte-identical output, unchanged signature, no diff for any of shell_command_render's 13+ existing consumers. DESIGN §2/§3: one escaping fact, one authority."

fn shell_quote(arg: String) -> String {
  extdeps.posix.shell_command_language.posix_single_quote(spelling: arg)
}

fn shell_command_render(command: ArgvCommand) -> String {
  join(map(command.argv, a => shell_quote(arg: a)), " ")
}

data argv_builder_note: String = "Typed ArgvCommand builders (§2): each derives the argv for one tool operation so the opaque flags (dash-f, dash-p, --strip-components, ...) live in ONE place, not hand-spelled per call site. A caller names the operation (curl_download_command, tar_extract_command, ...); the flags are the derived realization, not a magic string the caller must remember. This is the ArgvCommand-value analogue of the transport rest dissolution — see gunbc.plans.transport_argv_anemia_dissolution (Lane B)."

fn curl_download_command(url: String, destination: String) -> ArgvCommand {
  ArgvCommand { argv: ["curl", "-fsL", "-o", destination, url] }
}

fn mkdir_p_command(directory: String) -> ArgvCommand {
  ArgvCommand { argv: ["mkdir", "-p", directory] }
}

fn tar_extract_command(archive: String, into_directory: String, strip_components: Int) -> ArgvCommand {
  ArgvCommand {
    argv: ["tar", "xf", archive, "-C", into_directory, concat("--strip-components=", to_string(strip_components))]
  }
}

fn make_command(directory: String, arguments: List<String>) -> ArgvCommand {
  ArgvCommand { argv: append(["make", "-C", directory], items: arguments) }
}

fn sed_in_place_command(expression: String, path: String) -> ArgvCommand {
  ArgvCommand { argv: ["sed", "-i", expression, path] }
}

fn cp_command(source: String, destination: String) -> ArgvCommand {
  ArgvCommand { argv: ["cp", source, destination] }
}
