module extdeps.instrument.pip_boy_3000

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.thewandcompany.com/pip-boy-3000/"
  }
}

data pip_boy_3000_manual_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.thewandcompany.com/pip-boy-3000-manual/"
  }
}

data pip_boy_3000_retail_listing_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.amazon.com/dp/B0G6LX9ML8"
  }
}

type PipBoy3000
  = | PipBoy3000Replica

data pip_boy_3000: PipBoy3000 = PipBoy3000Replica

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.instrument.pip_boy_3000",
      decl_name: "pip_boy_3000",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [
    pip_boy_3000_manual_authority,
    pip_boy_3000_retail_listing_authority
  ]
}

data subject_separation_note: String = "This module models the Fallout 3 / New Vegas Pip-Boy 3000 ONLY. The Fallout TV series Pip-Boy 3000 Mk V is a SEPARATE independently governed product with its own module (extdeps.instrument.pip_boy_3000_mk_v), its own manual, its own settings menu, and — the fact that most plainly settles the question — a DIFFERENT LICENSOR: this product's retail listing states Bethesda, the Mk V listing states Amazon Studios. DESIGN section 3 'External upstream decomposition': one shared shape does not merge independently governed entities that inhabit it. A change to the Mk V's settings must not require editing this file, and the agnostic axis both inhabit lives in the downstream join (gunbc.design.reference_instrument), never in a hub here that enumerates both."

data manual_read_path_note: String = "PROVENANCE GRAIN: the manual URI above is the authority for every setting row below, but this session could not fetch it — www.thewandcompany.com returned HTTP 403 to every path tried (product page, both manuals, the WEBPRINT PDF). The manual_wording strings are therefore quotations surfaced through a search index rather than a direct read, and the retail-listing facts are the only ones this session read at first hand. The typed receipt for that read path — and the coverage obligation it creates — is a downstream observation and lives in gunbc.design.reference_instrument, not here (DESIGN section 3: observations this repository produces are receipts in the observing layer, never properties authored inside an upstream module)."

type PipBoy3000Setting
  = CrtJitter
  | VerticalShift
  | ShowDebugInfo
  | SoundEffectsVolume

fn pip_boy_3000_setting_label(s: PipBoy3000Setting) -> NonEmptyStr {
  match s {
    CrtJitter => "CRT jitter"
    VerticalShift => "Vertical shift"
    ShowDebugInfo => "Show Debug info"
    SoundEffectsVolume => "Sound Effects volume"
  }
}

type PipBoy3000SettingRow {
  setting: PipBoy3000Setting
  manual_wording: NonEmptyStr
  authority: ExternalAuthority
}

data crt_jitter_row: PipBoy3000SettingRow = PipBoy3000SettingRow {
  setting: CrtJitter,
  manual_wording: "Press click to toggle between on and off. CRT (cathode ray tube) jitter adds a varying blurriness to the screen graphics similar to the effect seen on a faulty CRT.",
  authority: pip_boy_3000_manual_authority,
}

data vertical_shift_row: PipBoy3000SettingRow = PipBoy3000SettingRow {
  setting: VerticalShift,
  manual_wording: "Moves the display position up or down by a few pixels.",
  authority: pip_boy_3000_manual_authority,
}

data show_debug_info_row: PipBoy3000SettingRow = PipBoy3000SettingRow {
  setting: ShowDebugInfo,
  manual_wording: "If the Pip-Boy software is misbehaving or gets itself in a muddle, then enabling this option will provide useful onscreen information that will help diagnose the issue. Show debug info is not required in normal operation.",
  authority: pip_boy_3000_manual_authority,
}

data sound_effects_volume_row: PipBoy3000SettingRow = PipBoy3000SettingRow {
  setting: SoundEffectsVolume,
  manual_wording: "Adjusts the volume of the sound effects and the alarm sound, including the two alarm tunes. Note that adjusting the volume here does not affect the radio volume (which is controlled in the Radio screen).",
  authority: pip_boy_3000_manual_authority,
}

data pip_boy_3000_settings: List<PipBoy3000SettingRow> = [
  crt_jitter_row,
  vertical_shift_row,
  show_debug_info_row,
  sound_effects_volume_row
]

data settings_roster_closure_note: String = "This roster is the display/audio settings this session's sources attribute to THIS product's settings menu. It is not asserted complete, and — load-bearing for the design lane that cites it — no 'Glitch on tap' or 'Tap threshold' row appears here: every source read attributes those two to the Mk V. Whether this product also exposes them is UNRESOLVED rather than denied, and the coverage obligation for resolving it lives downstream in gunbc.design.reference_instrument. Absence from this roster is not evidence of absence from the product (DESIGN section 5: a gap is a typed, located obligation, never a silent verdict)."

type PipBoy3000MotionFeature
  = | TiltDerivedGeigerSimulation

data motion_feature_wording: NonEmptyStr = "a tilt-to-click Geiger counter simulation"

data pip_boy_3000_motion_features: List<PipBoy3000MotionFeature> = [TiltDerivedGeigerSimulation]

data motion_feature_note: String = "The one motion-derived behaviour this session's sources attribute to this product: an onboard tilt reading drives a simulated Geiger readout. Recorded because it establishes that THIS product carries a usable motion sensor at all — which is what makes the impulse-driven behaviours modeled on the Mk V a question about this product's firmware rather than about its hardware."

data retail_listing_shape_note: String = "The listing facts below are flat cited leaves rather than a RetailListingFacts record, deliberately. The record shape has no single home today: it cannot live in either product module without the sibling re-declaring it (the section 2 failure — net concepts growing by re-invention), it cannot live in a generic extdeps hub because a hub may not carry product-specific rows, and it cannot live in the downstream join without inverting the citation direction. Two verbatim quotations beside an already-typed authority do not need a shape to be grounded. Dissolve-on: a second consumer needs the listing as a subject, at which point the shape gets a real home and both products reference it."

data pip_boy_3000_retail_listing_title: NonEmptyStr = "The Wand Company Pip-Boy 3000 Fallout 3 New Vegas die-cast Replica. FM Radio and Alarm, LCD Screen, with Memory Foam Cuff and Stand. Officially Licensed by Bethesda."

data pip_boy_3000_licensing_statement: NonEmptyStr = "Officially Licensed by Bethesda."

data licensing_statement_grain_note: String = "licensing_statement is the listing's own sentence, quoted — deliberately NOT a modeled licensor entity. Bethesda has no declaration in this repository, and minting a Vendor row for a company we reference exactly once, in order to hold a fact whose whole job is to distinguish two products, would invent an authority instead of citing one (DESIGN section 2: net concepts must not grow by re-invention). Dissolve-on: a consumer needs the licensor as a subject in its own right, at which point it gets a cited extdeps.vendor row and this field references it."
