module extdeps.instrument.fs_box_v4

import std.types { Bool, Int, List, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority {
  ExternalAuthority, ExternalModelScope, ExternalSubjectRef,
  CitedFigureStanding, CitedToAuthority,
}
import extdeps.uri { Uri, Https }

// FS BOX V4, THE ORDERABLE MULTI-FUNCTIONAL TRANSCEIVER TOOL KIT, as its 2023 data sheet states
// it. Per DESIGN section 3's external upstream decomposition this module owns this one product.
// The V3/V4/V5 FAQ is a separately published document and lives in
// extdeps.instrument.fs_box_v3_v4_v5_faq; a browser or OS list here is the data sheet's list, not
// a merge. The current fs.com catalog page is not a citation of this module: it was fetched and
// returned a JavaScript robot-check with no form-factor table, which is a fetch receipt in
// product.fs_box_published_claims, not an Unobserved property of this product.
//
// NO FS COMPANY ENTITY IS MINTED HERE. Same standing as extdeps.transceiver.fs_145681: no FS
// legal name was read from these documents as a citable legal-entity line.
//
// WHAT THIS MODULE DOES NOT CLAIM. The data sheet does not mention QSFP56, SFP56, breakout legs,
// per-leg programming, disconnection, write recoverability, EEPROM bytes, or NVIDIA (ETH)
// coding. Those absences are the point of reading it. Mechanical, connector, battery and warranty
// figures are carried as the sheet printed them (not converted into a unit that would round
// 28.7 mm or 3.7 V). The V3 line on the ordering table is a row of THIS document, not a V3
// product module.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "resource.fs.com/mall/doc/20230224114704wojcth.pdf"
  }
}

type FsBoxOrderingLine {
  part_number: NonEmptyStr
  description: NonEmptyStr
}

type FsBoxV4DataSheet {
  product_name: NonEmptyStr
  supported_form_factors: List<NonEmptyStr>
  configurable_media: NonEmptyStr
  operating_systems: List<NonEmptyStr>
  browsers: List<NonEmptyStr>
  customization_fields: List<NonEmptyStr>
  data_connector: NonEmptyStr
  bluetooth_protocol: NonEmptyStr
  charging_connector: NonEmptyStr
  power_source: NonEmptyStr
  battery_capacity: NonEmptyStr
  battery_endurance_low_power_sfp: NonEmptyStr
  battery_endurance_high_power_qsfp_dd: NonEmptyStr
  case_material: NonEmptyStr
  dimensions: NonEmptyStr
  weight: NonEmptyStr
  operating_temperature: NonEmptyStr
  ordering: List<FsBoxOrderingLine>
  warranty: NonEmptyStr
  standing: CitedFigureStanding
}

data fs_box_v4_data_sheet: FsBoxV4DataSheet = FsBoxV4DataSheet {
  product_name: "FS BOX V4" as NonEmptyStr,
  supported_form_factors: [
    "SFP" as NonEmptyStr,
    "SFP+" as NonEmptyStr,
    "SFP28" as NonEmptyStr,
    "XFP" as NonEmptyStr,
    "QSFP+" as NonEmptyStr,
    "QSFP28" as NonEmptyStr,
    "QSFP-DD" as NonEmptyStr,
  ],
  configurable_media: "FS transceivers and DAC/AOC cables with rates from 100M to 400G" as NonEmptyStr,
  operating_systems: [
    "Windows (10 or newer)" as NonEmptyStr,
    "Mac OS (10.13 or newer)" as NonEmptyStr,
    "Android (5.0 or newer)" as NonEmptyStr,
    "IOS (11.0 or newer)" as NonEmptyStr,
  ],
  browsers: ["Chrome (68 or newer)" as NonEmptyStr],
  customization_fields: [
    "part number" as NonEmptyStr,
    "compatible brand" as NonEmptyStr,
    "serial number" as NonEmptyStr,
    "vendor name" as NonEmptyStr,
  ],
  data_connector: "Bluetooth or USB Type-C" as NonEmptyStr,
  bluetooth_protocol: "Bluetooth Specification V4.2 BLE" as NonEmptyStr,
  charging_connector: "USB Type-C" as NonEmptyStr,
  power_source: "3.7V battery powered or 5V USB powered" as NonEmptyStr,
  battery_capacity: "3200mAh" as NonEmptyStr,
  battery_endurance_low_power_sfp: "9 hours without interrupting configuration" as NonEmptyStr,
  battery_endurance_high_power_qsfp_dd: "at least 3.5 hours without interrupting configuration" as NonEmptyStr,
  case_material: "Rubber, Polycarbonate" as NonEmptyStr,
  dimensions: "1.13 x 2.89 x 6.30 inches (28.7 x 73.5 x 160 mm)" as NonEmptyStr,
  weight: "0.2Kg" as NonEmptyStr,
  operating_temperature: "14F to 122F (-10C to 50C)" as NonEmptyStr,
  ordering: [
    FsBoxOrderingLine {
      part_number: "FS BOX V4" as NonEmptyStr,
      description: "FS BOX V4, Multi-Functional Transceiver Tool Kit, Support FS Transceivers & DAC/AOC Cables, Red" as NonEmptyStr,
    },
    FsBoxOrderingLine {
      part_number: "FS BOX V4" as NonEmptyStr,
      description: "FS BOX V4, Multi-Functional Transceiver Tool Kit, Support FS Transceivers & DAC/AOC Cables, Yellow" as NonEmptyStr,
    },
    FsBoxOrderingLine {
      part_number: "FS BOX V3" as NonEmptyStr,
      description: "FS BOX V3, Multi-Functional Transceiver Tool Kit, Support FS Transceivers & DAC/AOC Cables" as NonEmptyStr,
    },
  ],
  warranty: "5-year limited warranty against defects in materials or workmanship" as NonEmptyStr,
  standing: CitedToAuthority { authority: extdeps_external_authority_anchor },
}

fn fs_box_v4_ordering_names_part(name: NonEmptyStr) -> Bool {
  fold(
    fs_box_v4_data_sheet.ordering,
    init: false,
    f: (hit, line) => hit || (line.part_number as String) == (name as String),
  )
}

fn fs_box_v4_color_sku_count() -> Int {
  fs_box_v4_data_sheet.ordering
    |> filter(line => (line.part_number as String) == "FS BOX V4")
    |> count
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.instrument.fs_box_v4",
      decl_name: "fs_box_v4_data_sheet",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
