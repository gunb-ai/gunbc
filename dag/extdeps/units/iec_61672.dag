module extdeps.units.iec_61672

import std.types { Bool, Int }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "webstore.iec.ch/en/publication/19903"
  }
}

// A-WEIGHTED SOUND PRESSURE LEVEL, AND DELIBERATELY NOT A Measure.
//
// std.measure models LINEAR quantities: a Scale prefix means a fixed multiple of a base unit and
// two Measures of one Quantity add. A dBA is neither. It is a LOGARITHMIC RATIO against a fixed
// reference pressure, so Kilo of it means nothing and `a + b` would be wrong rather than merely
// unavailable - two 44.4 dBA fans are 47.4 dBA, not 88.8.
//
// This module exists because the repository ALREADY made this call once and made it the other
// way from a Measure: `product.placement_supply` `SignalStrength` carries a bare `dbm: Int`
// rather than `Measure<Power, Milli, Int>`, for exactly this reason. Filing dBA as a Measure
// would have put two representations of "logarithmic level" in the tree at once - the §3
// nicknaming violation, arrived at from the direction where both spellings look reasonable.
//
// The grain is TENTHS of a dBA because that is the grain vendors publish at: 44.4, 59.8, 30.6.
// Int rather than Nat because a level below the reference is representable and negative dBA is
// ordinary in a quiet room.
//
// NO ARITHMETIC IS OFFERED. Combining two levels is a power-domain fold needing a logarithm this
// substrate has no builtin for, and a difference of levels is a different type from a level.
// Offering a wrong operation would be worse than offering none, so this module offers ordering
// and equality only - both of which ARE meaningful on a monotone log scale.
//
// dissolve-on: std.measure grows a logarithmic scale family that can carry a reference pressure
// and forbid cross-family addition. At that point this type and `SignalStrength` become aliases
// of it in ONE move, which is why neither is dissolved separately.
type AWeightedSoundPressureLevel { tenths_dba: Int }

fn tenths_dba(count: Int) -> AWeightedSoundPressureLevel {
  AWeightedSoundPressureLevel { tenths_dba: count }
}

fn dba_tenths(level: AWeightedSoundPressureLevel) -> Int {
  level.tenths_dba
}

// A DIFFERENCE OF LEVELS IS NOT A LEVEL, which the block above already states as the reason no
// arithmetic is offered on the level type. This is the other half of that statement, added when a
// consumer needed to report HOW FAR over a ceiling a reading sat and had nowhere to put the answer
// but a bare Int with the unit spelled into the field name.
//
// The split is affine and it is not pedantry. Adding two levels is meaningless; SUBTRACTING two is
// perfectly meaningful and yields a decibel difference, which may then be added to a level to get a
// level. So the difference type exists, subtraction of levels produces it, and there is deliberately
// no way to construct a LEVEL from one - that would be the operation that lets a caller treat "6 dB
// over" as though it were "6 dBA".
type AWeightedLevelDifference { tenths_dba: Int }

fn dba_level_minus(a: AWeightedSoundPressureLevel, b: AWeightedSoundPressureLevel) -> AWeightedLevelDifference {
  AWeightedLevelDifference { tenths_dba: a.tenths_dba - b.tenths_dba }
}

fn dba_difference_tenths(d: AWeightedLevelDifference) -> Int {
  d.tenths_dba
}

fn dba_le(a: AWeightedSoundPressureLevel, b: AWeightedSoundPressureLevel) -> Bool {
  a.tenths_dba <= b.tenths_dba
}

fn dba_eq(a: AWeightedSoundPressureLevel, b: AWeightedSoundPressureLevel) -> Bool {
  a.tenths_dba == b.tenths_dba
}
