module extdeps.units.iso8601


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.iso.org/standard/70907.html"
  }
}

data iso8601_duration_units_note: String = "ISO 8601-1:2019 duration and time-unit vocabulary: 60 seconds per minute, 60 minutes per hour, 24 hours per day."

fn iso8601_seconds_per_minute() -> std.nat.Nat {
  60
}

fn iso8601_minutes_per_hour() -> std.nat.Nat {
  60
}

fn iso8601_hours_per_day() -> std.nat.Nat {
  24
}
