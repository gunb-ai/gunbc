module extdeps.units.iec_80000_13


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.iso.org/standard/31898.html"
  }
}

data iec_80000_13_version_note: String = "IEC 80000-13:2008 (Quantities and units — Part 13: Information science and technology): binary prefixes (kibi = 2^10) and the octet (8 bits) as the information-unit byte."

fn iec_kibi_factor() -> std.nat.Nat {
  1024
}

fn octet_bit_count() -> std.nat.Nat {
  8
}
