module extdeps.units.dimensionless


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.iso.org/standard/31887.html"
  }
}

data basis_point_authority_note: String = "Permyriad / basis-point unity: one part per ten thousand (1 bp = 0.01 percentage points = 1/10000 of unity). ISO 80000-1 quantity 'factor, unitless' applied to the ten-thousandth submultiple (permyriad, ‱); financial reporting convention names the same scale 'basis point'."

data percent_unity_note: String = "Percent unity: parts per hundred (1% = 1/100 of unity). ISO 80000-1 quantity 'factor, unitless' applied to the hundredth submultiple."

fn parts_per_ten_thousand_unity_count() -> std.nat.Nat {
  10000
}

fn percent_unity_hundred_count() -> std.nat.Nat {
  100
}
