module extdeps.units.iso_80000_3


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.iso.org/standard/64974.html"
  }
}

data iso_80000_3_amendment_1_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.iso.org/standard/87100.html"
  }
}

// THE SUBJECT: the standard itself, as an independently governed upstream entity. It is declared
// under a unique name with extdeps_model_scope as its alias, following the scope_alias_note reasoning
// in extdeps.languages.bash.subject: the mandated tag name is identical in every carrier and .dag
// has no import aliasing, so only a uniquely named declaration can be imported alongside another
// carrier's scope or pointed AT by a symbolic citation.
type Iso80000Part3
  = | Iso80000Part3Standard

data iso_80000_3_standard: Iso80000Part3 = Iso80000Part3Standard

data iso_80000_3_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.units.iso_80000_3",
      decl_name: "iso_80000_3_standard",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [iso_80000_3_amendment_1_authority]
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = iso_80000_3_model_scope

data iso_80000_3_version_note: String = "ISO 80000-3 (Quantities and units - Part 3: Space and time): the quantity definitions for length, area, volume, plane angle and solid angle. This module grounds ONLY the exact unit relations the spatial substrate needs; it is not a general physics authority, and no generic extdeps.physics hub is created for it. THE PIN, WITH ITS EVIDENCE STANDING STATED: base edition 2, ISO 80000-3:2019, published October 2019 (catalogue 64974), amended by ISO 80000-3:2019/Amd 1:2025 (catalogue 87100), which is why the amendment is a SECOND citation of this one subject rather than a second subject. HOW THAT WAS ESTABLISHED, and how it was not: iso.org returns HTTP 403 to every automated fetch from this environment, so the NORMATIVE TEXT HAS NOT BEEN READ HERE and no claim in this repository may rest on its exact wording. What was verified is the designation-to-catalogue mapping, from the iso.org page titles as indexed by search plus independent resellers agreeing on both ids. An earlier revision carried www.iso.org/standard/31887.html, which review reported is ISO 80000-2 (mathematical signs and symbols); a later one removed the locator entirely and left the edition unstated, on the ground that an unverifiable numeric id is worse than none. The correction to THAT is the distinction between a paywall and an unknown: a paywall lowers evidence standing, and a mutable search-results URL is not a terminal pin. The relations carried below are in any case not edition-sensitive - they are definitional and independently checkable (a turn is 360 degrees by definition of the degree; a square metre is the area of a square of side one metre)."

data iso_80000_3_plane_angle_note: String = "Plane angle is dimensionless in the SI sense - it is a ratio of two lengths - but it is NOT interchangeable with an ordinary dimensionless count, and the substrate keeps it a distinct Quantity so that adding an angle to a length, or reading an angle as a bare ratio, has no operation. ISO 80000-3 defines the radian as the coherent unit. The degree, arcminute and arcsecond are non-SI units accepted for use with the SI - a status stated by the BIPM SI Brochure, which is a SEPARATE independently governed subject and therefore neither a citation of this scope nor modeled here (the extdeps.languages.bash.subject / POSIX distinction: multiple citations may ground one subject, but a second governing body's document is never a citation of the first). Nothing below depends on that status; the subdivisions are carried as exact rational fractions of the turn."

fn degrees_per_turn() -> std.nat.Nat {
  360
}

fn arcminutes_per_degree() -> std.nat.Nat {
  60
}

fn arcseconds_per_arcminute() -> std.nat.Nat {
  60
}

fn arcseconds_per_degree_derived() -> std.nat.Nat {
  arcminutes_per_degree() * arcseconds_per_arcminute()
}

fn arcseconds_per_turn() -> std.nat.Nat {
  degrees_per_turn() * arcminutes_per_degree() * arcseconds_per_arcminute()
}

// Area and volume scale as the SQUARE and CUBE of the linear ratio. Carried explicitly because a
// generic linear scale conversion is wrong for both: reusing the length factor 1000 for area would
// understate a square metre by a factor of 1000.
fn square_millimetres_per_square_metre() -> std.nat.Nat {
  1000000
}

fn cubic_millimetres_per_cubic_metre() -> std.nat.Nat {
  1000000000
}
