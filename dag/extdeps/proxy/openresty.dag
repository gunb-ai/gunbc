module extdeps.proxy.openresty

import std.types { NonEmptyStr, brand, String, Int, List, Bool }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "openresty.org/en/ngx-lua-module.html"
  }
}

data openresty_proxy_pass_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "nginx.org/en/docs/http/ngx_http_proxy_module.html"
  }
}

type OpenResty
  = | OpenRestyProject

data openresty: OpenResty = OpenRestyProject

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.proxy.openresty",
      decl_name: "openresty",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.proxy.openresty.extdeps_external_authority_anchor,
  further_citations: [extdeps.proxy.openresty.openresty_proxy_pass_authority]
}

type OpenRestyVersion = NonEmptyStr where brand("OpenRestyVersion")

data openresty_1_27_1_1: OpenRestyVersion = "1.27.1.1" as OpenRestyVersion

type ProxyNextUpstream
  = | ProxyNextUpstreamOff

type ProxyBuffering
  = | ProxyBufferingOff

type ProxyRequestBuffering
  = | ProxyRequestBufferingOff

// A Lua hook the pinned build runs in a request phase. Each arm is one realization of a callout shape;
// the Lua text is rendered here, from the row's fields, and nowhere else.
type LuaHook
  = AuthzCapture { location: String, upstream_header: String, permit_header: String, refuse_status: Int }
  | StreamEndCallout { host: String, port: Int, path: String, permit_variable: String }

type LuaPhase
  = | AccessPhase
  | LogPhase

type NginxDirective
  = Simple { name: String, args: List<String> }
  | Block { name: String, args: List<String>, body: List<NginxDirective> }
  | LuaPhaseHook { phase: LuaPhase, hook: LuaHook }

fn proxy_next_upstream_directive(v: ProxyNextUpstream) -> NginxDirective {
  match v { ProxyNextUpstreamOff => Simple { name: "proxy_next_upstream", args: ["off"] } }
}

fn proxy_buffering_directive(v: ProxyBuffering) -> NginxDirective {
  match v { ProxyBufferingOff => Simple { name: "proxy_buffering", args: ["off"] } }
}

fn proxy_request_buffering_directive(v: ProxyRequestBuffering) -> NginxDirective {
  match v { ProxyRequestBufferingOff => Simple { name: "proxy_request_buffering", args: ["off"] } }
}

fn lua_hook_lines(h: LuaHook) -> List<String> {
  match h {
    AuthzCapture { location: l, upstream_header: u, permit_header: pm, refuse_status: r } => [
      "local res = ngx.location.capture('" + l + "', \{method = ngx.HTTP_POST\})",
      "if res.status ~= 200 then return ngx.exit(" + (r as String) + ") end",
      "ngx.var.up = res.header['" + u + "']",
      "ngx.var.permit = res.header['" + pm + "']",
    ]
    StreamEndCallout { host: h2, port: pt, path: path, permit_variable: pv } => [
      "if ngx.var." + pv + " == '' then return end",
      "ngx.timer.at(0, function(p)",
      "local s = ngx.socket.tcp()",
      "s:settimeout(2000)",
      "if not s:connect('" + h2 + "', " + (pt as String) + ") then return end",
      "s:send('POST " + path + " HTTP/1.1\\r\\nHost: x\\r\\nx-seat-permit: ' .. ngx.var." + pv + " .. '\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n')",
      "s:receive('*a')",
      "s:close()",
      "end)",
    ]
  }
}

fn lua_phase_name(ph: LuaPhase) -> String {
  match ph { AccessPhase => "access_by_lua_block" LogPhase => "log_by_lua_block" }
}

fn join_with(items: List<String>, sep: String) -> String {
  fold(items, init: "", f: (acc, e) => if acc == "" { e } else { acc + sep + e })
}

fn render_nginx_directive(d: NginxDirective, indent: String) -> String {
  match d {
    Simple { name: n, args: a } => indent + join_with(concat([n], a), " ") + ";\n"
    Block { name: n, args: a, body: b } =>
      indent + join_with(concat([n], a), " ") + " \{\n" + join_with(map(b, x => render_nginx_directive(d: x, indent: indent + "  ")), "") + indent + "}\n"
    LuaPhaseHook { phase: ph, hook: h } =>
      indent + lua_phase_name(ph: ph) + " \{\n" + indent + "  " + join_with(lua_hook_lines(h: h), "\n" + indent + "  ") + "\n" + indent + "}\n"
  }
}

fn render_nginx_directives(rows: List<NginxDirective>) -> String {
  join_with(map(rows, x => render_nginx_directive(d: x, indent: "")), "")
}

fn nginx_directive_name_is(d: NginxDirective, name: String) -> Bool {
  match d {
    Simple { name: n, args: _ } => n == name
    Block { name: n, args: _, body: _ } => n == name
    LuaPhaseHook { phase: _, hook: _ } => false
  }
}

data openresty_streaming_directives_note: NonEmptyStr = "These are the directives of the pinned build that decide whether a response is relayed as it arrives and whether the proxy may pick a second upstream: proxy_pass with a variable target (no upstream block, so no balancing or health state), proxy_next_upstream off (no retry onto another peer), proxy_buffering off and proxy_request_buffering off (chunks pass through), and the lua phase hooks access_by_lua (before forwarding) and log_by_lua (after the request finishes, on every end). Whether the log phase fires on client abort and on upstream reset was observed on this build; its outcome variables were not reliable on abort, so they are not modeled here." as NonEmptyStr
