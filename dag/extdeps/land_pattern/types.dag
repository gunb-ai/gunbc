module extdeps.land_pattern.types


// THE STANDARD IS CITED FOR THE CONCEPT AND ITS CONTENT IS DELIBERATELY NOT MODELLED. IPC-7351
// is the intersubjective authority for what a land pattern IS, and every vendor drawing this
// module carries points back at it — Texas Instruments prints "Publication IPC-7351 may have
// alternate designs" on the drawings below. The standard itself is sold rather than published,
// so this repository has NOT read its fillet tables and cannot derive a land pattern from a
// package outline. That is why the only land pattern representable here is one a vendor PRINTED,
// and why no function in this module takes a body dimension set and returns a pattern.
data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "shop.ipc.org/ipc-7351/ipc-7351-standard-only/Revision-b/english"
  }
}

data land_pattern_note: String = "THIS MODULE CARRIES MECHANICAL CANDIDATES. IT DOES NOT SELECT PARTS. A row here says a vendor publishes these dimensions for this part number; it does not say the part is right for any board, and nothing here establishes electrical suitability of any kind — no frequency, jitter or output topology, no reset threshold, polarity or sequencing, no regulator protocol or rail control, no host interface compatibility. Selection is a functional-compatibility join performed at the product layer over requirement, electrical interface, reference precedent, candidate part and package authority. This module supplies the last of those five and nothing else. FOUR FACTS, NOT ONE, AND THEY ARE ROUTINELY COLLAPSED. PACKAGE BODY DIMENSIONS are the plastic body's extent. The OVERALL TERMINAL ENVELOPE is larger wherever terminals project beyond the body, and it is NOT modelled here — a leaded package's leads span further than its body, so a body extent is not occupied volume and calling it that recreates the body-versus-footprint error this lane exists to eliminate. A VENDOR RECOMMENDED LAND PATTERN is what the vendor says to etch. A BOARD LAND PATTERN is what a particular board etches, which depends on a fabricator capability profile nobody has selected. The COURTYARD is a fifth thing and is also absent. This module carries the first and third; the second, fourth and fifth have no representation, and no function here produces any of them. THAT ABSENCE IS THE CONSTRUCTION: a consumer wanting occupied volume, board copper or a keepout cannot reach for the nearest available number, because there is no nearest available number."

// A LAND PATTERN AS THE VENDOR PRINTS IT, which is parametric rather than a list of pads. The
// drawing does not enumerate forty-eight rectangles; it states a land size, a pitch, a count and
// a span, and every pad follows. The land POPULATION is derived from these parameters below; the
// pads' individual coordinates are not produced here, because placing them needs a coordinate
// frame and an origin convention that belong to whatever consumes the pattern.
type SurfaceMountLandGeometry
  = DualRowLandGeometry {
      lands_per_row: std.nat.Nat
      pitch: std.measure.Micrometer
      row_span_centre_to_centre: std.measure.Micrometer
      land_length: std.measure.Micrometer
      land_width: std.measure.Micrometer
    }
  | QuadRowLandGeometry {
      lands_per_side: std.nat.Nat
      pitch: std.measure.Micrometer
      side_span_centre_to_centre: std.measure.Micrometer
      land_length: std.measure.Micrometer
      land_width: std.measure.Micrometer
      thermal_land_side: std.measure.Micrometer?
    }

fn peripheral_land_count(g: SurfaceMountLandGeometry) -> std.nat.Nat {
  match g {
    DualRowLandGeometry { lands_per_row: n, pitch: _, row_span_centre_to_centre: _, land_length: _, land_width: _ } => 2 * n
    QuadRowLandGeometry { lands_per_side: n, pitch: _, side_span_centre_to_centre: _, land_length: _, land_width: _, thermal_land_side: _ } => 4 * n
  }
}

fn land_pattern_pitch(g: SurfaceMountLandGeometry) -> std.measure.Micrometer {
  match g {
    DualRowLandGeometry { lands_per_row: _, pitch: p, row_span_centre_to_centre: _, land_length: _, land_width: _ } => p
    QuadRowLandGeometry { lands_per_side: _, pitch: p, side_span_centre_to_centre: _, land_length: _, land_width: _, thermal_land_side: _ } => p
  }
}

// A DRAWING IS ITS OWN VERSIONED DOCUMENT, separate from the datasheet that reprints it. Texas
// Instruments stamps every package page with a drawing number and a revision date — 4214840/G,
// 08/2024 — which move independently of the datasheet's own revision, so citing only the
// datasheet would leave a correction to the mechanical drawing invisible.
type PackageDrawingRef {
  drawing_number: std.types.NonEmptyStr
  revision_date: std.types.NonEmptyStr
  reprinted_in: extdeps.external_authority.ExternalAuthority
}

// THE BODY, AND ONLY THE BODY. This is named for what it holds after an earlier revision called it
// a package OUTLINE and its note called it how much volume the part occupies. Both were wrong in
// the same direction: for a leaded package the terminals project beyond the plastic, so the body
// extent under-states the space the part needs, and a clearance check built on it admits boards
// that cannot be assembled. The overall terminal envelope is a different measurement, present on
// the same vendor drawings, and it is deliberately NOT carried here rather than approximated from
// what is.
//
// The vendor's own min and max are kept because the drawings state extents that way and print no
// nominal; a single number would be a figure this repository invented by averaging.
type PackageBodyDimensions {
  designator: std.types.NonEmptyStr
  drawing: PackageDrawingRef
  terminal_count: std.nat.Nat
  terminal_pitch: std.measure.Micrometer
  body_length_min: std.measure.Micrometer
  body_length_max: std.measure.Micrometer
  body_width_min: std.measure.Micrometer
  body_width_max: std.measure.Micrometer
  height_max: std.measure.Micrometer
}

type VendorRecommendedLandPattern {
  package_designator: std.types.NonEmptyStr
  drawing: PackageDrawingRef
  geometry: SurfaceMountLandGeometry
}

// HOW A PART ATTACHES DECIDES WHAT KIND OF PATTERN IT NEEDS, and the two attested here need
// different kinds. A surface-mount terminal solders to a land. A solder tail passes through a
// PLATED HOLE, and a hole pattern is a drill schedule with finished hole sizes and plating
// requirements — not a land pattern with different numbers in it.
type BoardAttachmentStyle
  = SurfaceMountTerminals
  | ThroughHoleSolderTail

// SURFACE-MOUNT GEOMETRY HAS AN ESTABLISHED ARM BECAUSE THE GEOMETRY EXISTS TO PUT IN IT.
type SurfaceMountPatternStanding
  = SurfaceMountPatternEstablished { pattern: VendorRecommendedLandPattern }
  | SurfaceMountPatternNotEstablished { what_is_missing: std.types.NonEmptyStr }

// AND THIS IS A RECORD RATHER THAN A COPRODUCT, WHICH IS THE WHOLE POINT. An earlier revision gave
// through-hole parts a standing whose only success arm carried a VendorRecommendedLandPattern —
// surface-mount geometry. So the DDR4 socket, a solder-tail part, could never have reached that
// arm no matter which document arrived: the type promised a success that was unreachable for the
// very part it was carrying. The module note said a solder tail needs a drill schedule and the
// type did not. Until a plated-hole geometry carrier exists, the only representable state for a
// hole pattern is an obligation, and a record with no success arm says exactly that. The same
// carrier serves a part whose ATTACHMENT STYLE is itself unread, since a success arm cannot be
// chosen before the style is known.
type MountingPatternObligation {
  what_is_missing: std.types.NonEmptyStr
}

// COUNT AND PITCH AND DESIGNATOR DO NOT ESTABLISH THE PIN MAP, and a pattern that matches on all
// three can still be MIRRORED — routing every signal to the wrong terminal while passing every
// check in this module. What is missing is pin-one location, numbering direction, the top-versus
// bottom-view convention the drawing is stated in, the terminal-to-land identity relation, the
// exposed pad's identity and electrical role, and any exceptional lands.
//
// THERE IS NO ESTABLISHED ARM AND THAT IS NOT AN OVERSIGHT. Modelling one means modelling the pin
// map, which is a separate authority this lane has not built; an established arm today would be a
// record of strings that a reader would fill from the drawing's appearance. So indexing is an
// obligation on every candidate, the admission below refuses on it, and consequently NO candidate
// in this repository is admissible for footprint realization right now. That is the honest state
// and it is stated in the type rather than in prose.
type TerminalIndexingObligation {
  what_is_missing: std.types.NonEmptyStr
}

// A CANDIDATE IS FREELY CONSTRUCTIBLE AND CARRIES NO CLAIM. It says a vendor publishes these
// mechanical facts for this part number. It does NOT say the part suits any role, and it is not
// what a footprint realization may consume — only the admitted form below is.
type PartMechanicalCandidate {
  ordering_part_number: std.types.NonEmptyStr
  vendor: Vendor<extdeps.hardware.Hardware>
  body: PackageBodyDimensions
  land_pattern: VendorRecommendedLandPattern
  terminal_indexing: TerminalIndexingObligation
}

// A PART WHOSE DOCUMENT EXISTS AND HAS NOT BEEN READ. No dimension, count or pitch field, because
// every one would have to be filled and the only sources would be a distributor listing or a
// reader's expectation of what a part like this usually is. The upstream authority EXISTS and is
// citable whether or not anyone here has read it; what is unestablished is the geometry.
type CatalogPartIdentity {
  ordering_part_number: std.types.NonEmptyStr
  vendor: Vendor<extdeps.hardware.Hardware>
  board_pattern: MountingPatternObligation
}

// THE PATTERN AND THE BODY ARE JOINED, NOT ASSUMED TO MATCH. They are two transcriptions of two
// drawings, and the failure this refuses is the ordinary one: a land pattern copied from the
// neighbouring package on the same datasheet. A device offered in two packages prints two of each,
// and nothing about a record's field names stops the wrong pair from being bound together.
type LandPatternDisagreement
  = PatternDesignatorDiffersFromPackage { pattern_designator: std.types.NonEmptyStr, package_designator: std.types.NonEmptyStr }
  | LandCountDiffersFromTerminalCount { lands: std.nat.Nat, terminals: std.nat.Nat }
  | LandPitchDiffersFromTerminalPitch { land_pitch: std.measure.Micrometer, terminal_pitch: std.measure.Micrometer }

fn land_pattern_disagreements(p: PartMechanicalCandidate) -> List<LandPatternDisagreement> {
  let designator_cause = if (p.land_pattern.package_designator as String) == (p.body.designator as String) {
    []
  } else {
    [PatternDesignatorDiffersFromPackage {
      pattern_designator: p.land_pattern.package_designator,
      package_designator: p.body.designator,
    }]
  }
  let count_cause = if peripheral_land_count(g: p.land_pattern.geometry) == p.body.terminal_count {
    []
  } else {
    [LandCountDiffersFromTerminalCount {
      lands: peripheral_land_count(g: p.land_pattern.geometry),
      terminals: p.body.terminal_count,
    }]
  }
  let pitch_cause = if micrometer_count(m: land_pattern_pitch(g: p.land_pattern.geometry)) == micrometer_count(m: p.body.terminal_pitch) {
    []
  } else {
    [LandPitchDiffersFromTerminalPitch {
      land_pitch: land_pattern_pitch(g: p.land_pattern.geometry),
      terminal_pitch: p.body.terminal_pitch,
    }]
  }
  concat(concat(designator_cause, count_cause), pitch_cause)
}

type CandidateRefusal
  = MechanicalDisagreement { cause: LandPatternDisagreement }
  | TerminalIndexingUnestablished { what_is_missing: std.types.NonEmptyStr }

type CandidateRefusalSet {
  first: CandidateRefusal
  rest: List<CandidateRefusal>
}

// ADMISSION IS THE ONLY ROUTE TO THE ADMITTED TYPE, which is what an earlier revision got wrong.
// It named a type MountablePart, let anyone construct one — including one whose pattern and
// package disagree, as this module's own negative test does — and offered validity as a separate
// function a consumer had to remember to call. A malformed part stayed representable and reachable.
// Now the malformed case cannot inhabit the admitted type at all: AdmittedMountablePart is
// produced here or not at all, and a refusal carries its nonempty causes.
type PartAdmission
  = AdmittedMountablePart { part: PartMechanicalCandidate }
  | PartRefused { causes: CandidateRefusalSet }

fn push_candidate_refusal(acc: CandidateRefusalSet?, r: CandidateRefusal) -> CandidateRefusalSet? {
  match acc {
    Absent => Present { value: CandidateRefusalSet { first: r, rest: [] } }
    Present { value: s } => Present { value: CandidateRefusalSet { first: s.first, rest: concat(s.rest, [r]) } }
  }
}

fn candidate_refusals(p: PartMechanicalCandidate) -> List<CandidateRefusal> {
  let mechanical = fold(land_pattern_disagreements(p: p), init: [], f: fn(acc, c) {
    concat(acc, [MechanicalDisagreement { cause: c }])
  })
  concat(mechanical, [TerminalIndexingUnestablished { what_is_missing: p.terminal_indexing.what_is_missing }])
}

fn admit_part_candidate(p: PartMechanicalCandidate) -> PartAdmission {
  match fold(candidate_refusals(p: p), init: none, f: fn(acc, c) { push_candidate_refusal(acc: acc, r: c) }) {
    Absent => AdmittedMountablePart { part: p }
    Present { value: s } => PartRefused { causes: s }
  }
}

fn candidate_refusal_count(s: CandidateRefusalSet) -> std.nat.Nat {
  1 + fold(s.rest, init: 0, f: fn(acc, _c) { acc + 1 })
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.land_pattern.types",
      decl_name: "land_pattern_note",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.land_pattern.types.extdeps_external_authority_anchor,
  further_citations: []
}
