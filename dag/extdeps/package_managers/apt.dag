module extdeps.package_managers.apt

import std.types { NonEmptyStr, FilePath, Bool, List, Unit }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.exec.program { uncataloged_program }
import std.resources { Network }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "manpages.debian.org/testing/apt/apt.8.en.html"
  }
}

data apt_bin_dir: FilePath = "/usr/bin"
data apt_local_bin_dir: FilePath = "/usr/local/bin"
data apt_sbin_dir: FilePath = "/usr/sbin"

// An apt package's binary path is the directory its SourceApt row declares (apt_bin_dir for most,
// apt_sbin_dir for administrative tools such as nfct) plus the binary name. The directory is a
// parameter because it is a fact about the package, not a constant of apt.
fn apt_installed_bin_path(bin_dir: FilePath, binary: NonEmptyStr) -> FilePath {
  concat(bin_dir as String, concat("/", binary as String)) as FilePath
}

data package_coreutils: NonEmptyStr = "coreutils"     
data package_grep: NonEmptyStr = "grep"               
data package_diffutils: NonEmptyStr = "diffutils"     
data package_cargo: NonEmptyStr = "cargo"
data package_rustc: NonEmptyStr = "rustc"

data package_systemd_oomd_defaults: NonEmptyStr = "systemd-oomd-defaults"
data package_tailscale: NonEmptyStr = "tailscale"
data package_nodejs: NonEmptyStr = "nodejs"
data package_npm: NonEmptyStr = "npm"
data package_tmux: NonEmptyStr = "tmux"
data package_curl: NonEmptyStr = "curl"
data package_nbdkit: NonEmptyStr = "nbdkit"
data package_socat: NonEmptyStr = "socat"
data package_sshpass: NonEmptyStr = "sshpass"
data package_unzip: NonEmptyStr = "unzip"
data package_xz_utils: NonEmptyStr = "xz-utils"
data package_openssl: NonEmptyStr = "openssl"
data package_gh: NonEmptyStr = "gh"
data package_mosquitto_clients: NonEmptyStr = "mosquitto-clients"
data package_websocat: NonEmptyStr = "websocat"
data package_xorriso: NonEmptyStr = "xorriso"
data package_google_cloud_cli: NonEmptyStr = "google-cloud-cli"
data package_busybox: NonEmptyStr = "busybox-static"
