data apt_get_binary_path: NonEmptyStr = "/usr/bin/apt-get"

data apt_man_url: NonEmptyStr = "https://manpages.debian.org/testing/apt/apt.8.en.html"

// apt_install_argv was DELETED here for the reason dpkg.dag's Status row states: it was this
// Install row's argv authored a second time, and its last consumer now binds `package` against
// this declaration instead. InstallExactNonRemoving follows SimulateInstall's selection and
// removal policy and keeps needrestart in list-only mode during supervised host maintenance.
service apt.PackageManager {
  operation ShowExact {
    input { selection: NonEmptyStr }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    readonly
    transport shell { argv: ["apt-cache", "show", "--no-all-versions", "{selection}"] }
    exit { 0 => Unit nonzero => String "apt-cache could not read the selected version" }
    mock_response { 1 => { success: false, stdout: "", stderr: "no package metadata supplied" } "no fabricated package candidate" }
  }
  operation SimulateInstall {
    input { selection: NonEmptyStr }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    readonly
    transport shell { argv: ["env", "LC_ALL=C", "apt-get", "--simulate", "--no-install-recommends", "--no-remove", "install", "{selection}"] }
    exit { 0 => Unit nonzero => String "apt-get simulation refused" }
    mock_response { 1 => { success: false, stdout: "", stderr: "no package plan supplied" } "no fabricated install simulation" }
  }
  operation Install {
    requires Network
    input { package: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["apt-get", "install", "--yes", "{package}"] }
    exit {
      0 => Unit
      100 => String "apt-get install failed (lock held, fetch error, or unmet dependency)"
      nonzero => String "apt-get install failed"
    }
  }
  operation InstallExactNonRemoving {
    requires Network
    input { selection: NonEmptyStr }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell { argv: ["env", "LC_ALL=C", "DEBIAN_FRONTEND=noninteractive", "NEEDRESTART_MODE=l", "apt-get", "--yes", "--no-install-recommends", "--no-remove", "install", "{selection}"] }
    exit { 0 => Unit nonzero => String "apt-get exact non-removing install refused" }
    mock_response { 1 => { success: false, stdout: "", stderr: "no installation supplied" } "no fabricated package installation" }
  }
  operation Remove {
    requires none
    input { package: NonEmptyStr }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell { argv: ["env", "LC_ALL=C", "DEBIAN_FRONTEND=noninteractive", "NEEDRESTART_MODE=l", "apt-get", "--yes", "remove", "{package}"] }
    exit { 0 => Unit nonzero => String "apt-get remove refused" }
    mock_response { 1 => { success: false, stdout: "", stderr: "no removal supplied" } "no fabricated package removal" }
  }
}

// THE PACKAGE INSTALL AS A TYPED COMMAND, the leg a caller runs after its probe reports the package is
// not present. A THIN CALL INTO THE ONE REPARTITION: extdeps.exec.command's
// operation_row_argv_command materializes the Operation Row `PackageManager.Install` declared above in
// THIS module (whose transport shell argv is the only place these tokens are spelled) and seals the
// result; the row's executable token IS the sealed program identity, so this builder carries no program
// word and no match of its own, and nothing is ADDED because nothing may be: no `-y` alias (the row says
// `--yes`), no env prefix (that belongs to InstallExactNonRemoving, a different row with a different
// argv), no elevation -- the ensure-dependency route is the unprivileged one, so the elevation question
// stays with the caller rather than being decided inside an upstream's spelling of its own command. It
// exists to bind this row's coordinates and input name, and to answer with the domain's own refusal
// shape so a row that will not materialize stops its route before any process (gunbc.design_argument::fail_closed).
data apt_get_install_operation_path: String = "dag/extdeps/package_managers/apt.dag"
data apt_get_install_operation_service: String = "apt.PackageManager"
data apt_get_install_operation_name: String = "Install"
data apt_get_install_input_name: String = "package"

type AptGetInstallCommand
  = AptGetInstallCommandReady { command: ArgvCommand }
  | AptGetInstallCommandRefused { cause: String }

fn apt_get_install_command(package: NonEmptyStr) -> AptGetInstallCommand {
  match operation_row_argv_command(
    path: apt_get_install_operation_path,
    service: apt_get_install_operation_service,
    operation: apt_get_install_operation_name,
    binds: [operation_argv_bind_text(name: apt_get_install_input_name, text: package as String)],
  ) {
    OperationRowArgvCommandReady { command: command } =>
      AptGetInstallCommandReady { command: command }
    OperationRowArgvCommandRefused { cause: cause } =>
      AptGetInstallCommandRefused { cause: cause }
  }
}

// THE EXACT NON-REMOVING INSTALL AND THE REMOVE AS TYPED COMMANDS, each a thin call into the one
// repartition above (the Operation Row spells the tokens; nothing is added here, elevation stays
// with the caller). Same coordinates-and-refusal shape as apt_get_install_command.
fn apt_exact_non_removing_install_command(selection: NonEmptyStr) -> AptGetInstallCommand {
  match operation_row_argv_command(
    path: apt_get_install_operation_path,
    service: apt_get_install_operation_service,
    operation: "InstallExactNonRemoving",
    binds: [operation_argv_bind_text(name: "selection", text: selection as String)],
  ) {
    OperationRowArgvCommandReady { command: command } => AptGetInstallCommandReady { command: command }
    OperationRowArgvCommandRefused { cause: cause } => AptGetInstallCommandRefused { cause: cause }
  }
}

fn apt_remove_command(package: NonEmptyStr) -> AptGetInstallCommand {
  match operation_row_argv_command(
    path: apt_get_install_operation_path,
    service: apt_get_install_operation_service,
    operation: "Remove",
    binds: [operation_argv_bind_text(name: "package", text: package as String)],
  ) {
    OperationRowArgvCommandReady { command: command } => AptGetInstallCommandReady { command: command }
    OperationRowArgvCommandRefused { cause: cause } => AptGetInstallCommandRefused { cause: cause }
  }
}

// ──────────────────────────────────────────────────────────────────────────────────────────────────────
// A THIRD-PARTY APT REPOSITORY, MODELLED ONCE.
//
// WHY IT LIVES HERE: a vendor that serves a package over its own apt repository (tailscale today; the fleet
// already carries two leaves of this rule -- extdeps.container.docker_ce DockerCeAptRepo and
// extdeps.container.nvidia_container_toolkit NvidiaContainerToolkitAptRepo, each with its own source line,
// keyring path and install script) needs four facts stated together and verified together: the repository URI,
// its suite, its components, its architecture, the path its signing key is written to and PINNED at, and the
// fingerprint that key must match. Repeating that shape per vendor is the fork Single Authority forbids; the
// two existing leaves are named in
// gunbc.integration_concern.integration_concern_third_party_apt_repo_leaves_unified, and the trigger is the
// next edit to either -- moving them onto this shape is that concern's job, not this row's. This is the ONE
// general shape: a new vendor is a ROW (see extdeps.tailscale.apt_repo::tailscale_apt_repo_noble), not a new
// module.
//
// THE PUBLISHED KEY IS PINNED, NOT TRUSTED. `keyring_fingerprint` is a `PinnedAptKeyFingerprint`: a value plus
// its standing. The install script verifies the fetched key against the value and REFUSES on mismatch, before
// anything is written under the keyring directory as a trusted `signed-by=`: a key fetched by blind curl and
// trusted is a supply-chain fail-open (gunbc.design_argument::fail_closed). A wrong fingerprint means the route
// stops, it does not install. But the RUNTIME check is not the PIN's trust: a fingerprint transcribed from the
// same URL the route fetches proves only that the key did not change since someone read it, so such a row says
// so with `TranscribedUncited` and names the independent read that would ground it -- it is not presented as
// authenticated.
// ──────────────────────────────────────────────────────────────────────────────────────────────────────

// A PINNED SIGNING-KEY FINGERPRINT, WITH ITS EPISTEMIC STANDING STATED. A fingerprint is a value AND a claim
// about where it came from, and collapsing the two lets a value transcribed from the very URL the route later
// fetches pass as authenticated when it only proves the key did not change since someone looked. So the
// standing travels with the value (gunbc.design_argument::external_upstreams,
// extdeps.external_authority::CitedFigureStanding).
type PinnedAptKeyFingerprint {
  value: NonEmptyStr
  standing: CitedFigureStanding
}

type ThirdPartyAptRepo {
  // The armored signing key, fetched unprivileged and verified against `keyring_fingerprint` before dearmor.
  keyring_url: NonEmptyStr
  // Where the dearmored key lands, and the target of the source line's `signed-by=`.
  keyring_path: NonEmptyStr
  // The primary-key fingerprint the fetched key must carry, or the route refuses -- with its standing.
  keyring_fingerprint: PinnedAptKeyFingerprint
  // The repository URI, as apt spells it in the `deb` line (e.g. https://pkgs.tailscale.com/stable/ubuntu).
  repo_base: NonEmptyStr
  // The distribution codename (e.g. noble).
  suite: NonEmptyStr
  // The repository components (e.g. ["main"]); joined into the deb line in order.
  components: List<NonEmptyStr>
  // The dpkg architecture pinned into the line's `arch=`. A FIELD, not a constant, because the fleet is mixed
  // (aarch64 and x86_64 hosts exist): the caller supplies the host's own architecture, read the way the
  // serving model reads host.arch (gunbc.compute.remote_build_serving_converge), never a guessed pin.
  arch: NonEmptyStr
  // The sources file this repository's line is written to (e.g. /etc/apt/sources.list.d/tailscale.list).
  sources_list_path: NonEmptyStr
}

// The keyrings directory is created 0755, as every vendor's install guide states it. Rendered through
// extdeps.tools.gnu_coreutils (whose operand carries the set-id bits) rather than copied as four digits.
data apt_keyrings_directory: NonEmptyStr = "/etc/apt/keyrings"

data apt_third_party_keyrings_directory_mode: FileMode = FileMode {
  owner: PermissionBits { read: true, write: true, execute: true },
  group: PermissionBits { read: true, write: false, execute: true },
  other: PermissionBits { read: true, write: false, execute: true },
  setuid: false,
  setgid: false,
  sticky: false,
}

// Where the armored key is fetched and VERIFIED before it is ever dearmored into `keyring_path`. It lives
// OUTSIDE /etc/apt/keyrings so a key that fails the check never sits in the trusted keyring directory; the
// route's `umask 077` makes the fetch private. The path is fixed (not a shell variable) so the dearmor into
// `keyring_path` is a constant-word argv the sudo elevation can quote.
data apt_third_party_staged_key_path: NonEmptyStr = "/tmp/apt-third-party-keyring.armored"

// THE ONE SOURCE-LINE RENDERER. `deb [arch=X signed-by=Y] BASE SUITE COMP...` -- the apt line shape every
// third-party repository documents, rendered from the row so no vendor re-spells it and no caller hand-builds
// an apt line. Components are joined in order because the row owns their order.
fn apt_third_party_repo_source_line(repo: ThirdPartyAptRepo) -> String {
  join(
    [
      "deb [arch=",
      repo.arch as String,
      " signed-by=",
      repo.keyring_path as String,
      "] ",
      repo.repo_base as String,
      " ",
      repo.suite as String,
      " ",
      join(map(repo.components, c => c as String), " "),
    ],
    "",
  )
}

// THE KEYRING CHECK, AS A VALUE -- the security property, as a decision a witness can exercise.
//
// A fetched apt signing key is trusted only if it is EXACTLY ONE primary key (one `pub` record) whose primary
// `fpr` record equals the pinned fingerprint FIELD-FOR-FIELD. The naive check -- `grep -q <pin>` over gpg's
// --with-colons output -- is FAIL-OPEN: a fetched file holding the genuine key PLUS a second attacker key
// still contains the pin as a substring, passes, and then `signed-by=` trusts both keys. So this establishes
// the record structure (exactly one `pub`) and compares the primary fingerprint as a field (gpg's --with-colons
// puts it in colon field 10, index 9 after the leading `fpr`), never as a substring. Mirror of that exact check
// lives in the install route below (same single-primary rule, same field compare); the inhabitance claim ties
// the route to this module so the two cannot drift. A file that is not a single genuine key -- zero `pub`, two
// `pub`, or a differing primary fingerprint -- FAILS here and the route refuses.
fn apt_third_party_keyring_fingerprint_ok(show_keys_colons: String, pinned: NonEmptyStr) -> Bool {
  let lines = split(s: show_keys_colons, delimiter: "\n")
  let pub_count = filter(lines, l => starts_with(s: l, prefix: "pub:")).count()
  let primary_fpr = match filter(lines, l => starts_with(s: l, prefix: "fpr:")).first() {
    Present { value: fpr_line } =>
      match split(s: fpr_line, delimiter: ":").skip(n: 9).first() {
        Present { value: v } => trim(s: v)
        Absent => ""
      }
    Absent => ""
  }
  pub_count == 1
    && primary_fpr == (pinned as String)
}

// THE ONE INSTALL ROUTE: keyring directory, fetch the armored key to a PRIVATE staging file, VERIFY it there
// against the pinned fingerprint and REFUSE, and only THEN dearmor it into the trusted keyring location, write
// the source line, apt-get update, install the packages. The order is the security property: the fetched key is
// checked at a path OUTSIDE /etc/apt/keyrings, so a key that is not the single genuine pinned key never sits in
// the trusted directory at all. The check mirrors apt_third_party_keyring_fingerprint_ok exactly -- exactly one
// `pub` record, the primary `fpr` (colon field 10) equal to the pin field-for-field -- not a substring `grep -q`
// that an extra attacker key defeats. `umask 077` makes the fetch private. It is the docker/nvidia provisioning
// sequence with that fail-open corrected. Each simple privileged command is elevated through
// extdeps.sudo.elevation before shell quoting; the pipes and redirection belong to the surrounding shell, so
// gpg and tee still consume stdin while sudo refuses without prompting.
//
// This is a medium-as-string shell leaf and dissolves when host_effect_apply binds an AptRepoEnsure plus
// PackageInstall effect without the shell leaf -- the same dissolution the docker and nvidia leaves carry.
fn apt_third_party_repo_install_script(repo: ThirdPartyAptRepo, packages: List<NonEmptyStr>) -> String {
  join(
    [
      "set -e",
      "umask 077",
      join(
        map(
          sudo_elevate_argv(command: coreutils_install_directory_argv(mode: apt_third_party_keyrings_directory_mode, path: apt_keyrings_directory as String)),
          w => posix_single_quote(spelling: w),
        ),
        " ",
      ),
      // fetch the armored key to the private staging path, unprivileged
      join(["curl -fsSL ", repo.keyring_url as String, " -o ", apt_third_party_staged_key_path as String], ""),
      // read gpg's colon records from the STAGED file, never from the trusted keyring path
      join(["gpg --show-keys --with-colons ", apt_third_party_staged_key_path as String, " > ", apt_third_party_staged_key_path as String, ".colons"], ""),
      // VERIFY: exactly one primary key, primary fpr field-for-field equal to the pin. Refuse before install.
      join(
        [
          "pubs=$(grep -c '^pub:' ",
          apt_third_party_staged_key_path as String,
          ".colons || true); fpr=$(grep -m1 '^fpr:' ",
          apt_third_party_staged_key_path as String,
          ".colons | cut -d: -f10 || true); { [ $pubs -eq 1 ] && [ $fpr = ",
          repo.keyring_fingerprint.value as String,
          " ]; } || { echo 'AptThirdPartyKeyringFingerprintRefusal: the fetched key is not a single primary key carrying pinned fingerprint ",
          repo.keyring_fingerprint.value as String,
          " for ",
          repo.keyring_url as String,
          "' >&2; exit 1; }",
        ],
        "",
      ),
      // only after the check: dearmor the staged file into the trusted keyring path
      join(
        map(
          sudo_elevate_argv(command: ["gpg", "--dearmor", "--yes", "-o", repo.keyring_path as String, apt_third_party_staged_key_path as String]),
          w => posix_single_quote(spelling: w),
        ),
        " ",
      ),
      join(
        map(
          sudo_elevate_argv(command: ["chmod", "a+r", repo.keyring_path as String]),
          w => posix_single_quote(spelling: w),
        ),
        " ",
      ),
      join(
        map(
          sudo_elevate_argv(command: ["rm", "-f", apt_third_party_staged_key_path as String, concat(apt_third_party_staged_key_path as String, ".colons")]),
          w => posix_single_quote(spelling: w),
        ),
        " ",
      ),
      join(["echo '", apt_third_party_repo_source_line(repo: repo), "' | ", join(map(sudo_elevate_argv(command: ["tee", repo.sources_list_path as String]), w => posix_single_quote(spelling: w)), " "), " >/dev/null"], ""),
      join(
        map(
          sudo_elevate_argv(command: ["apt-get", "update", "-q"]),
          w => posix_single_quote(spelling: w),
        ),
        " ",
      ),
      join(
        map(
          sudo_elevate_argv(command: append(["apt-get", "install", "-y", "-q"], items: map(packages, p => p as String))),
          w => posix_single_quote(spelling: w),
        ),
        " ",
      ),
      "",
    ],
    "\n",
  )
}
