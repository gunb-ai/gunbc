data apt_get_binary_path: NonEmptyStr = "/usr/bin/apt-get"

data apt_man_url: NonEmptyStr = "https://manpages.debian.org/testing/apt/apt.8.en.html"

// apt_install_argv was DELETED here for the reason dpkg.dag's Status row states: it was this
// Install row's argv authored a second time, and its last consumer now binds `package` against
// this declaration instead. InstallExactNonRemoving follows SimulateInstall's selection and
// removal policy and keeps needrestart in list-only mode during supervised host maintenance.
service apt.PackageManager {
  operation ShowExact {
    input { selection: NonEmptyStr }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    readonly
    transport shell { argv: ["apt-cache", "show", "--no-all-versions", "{selection}"] }
    exit { 0 => Unit nonzero => String "apt-cache could not read the selected version" }
    mock_response { 1 => { success: false, stdout: "", stderr: "no package metadata supplied" } "no fabricated package candidate" }
  }
  operation SimulateInstall {
    input { selection: NonEmptyStr }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    readonly
    transport shell { argv: ["env", "LC_ALL=C", "apt-get", "--simulate", "--no-install-recommends", "--no-remove", "install", "{selection}"] }
    exit { 0 => Unit nonzero => String "apt-get simulation refused" }
    mock_response { 1 => { success: false, stdout: "", stderr: "no package plan supplied" } "no fabricated install simulation" }
  }
  operation Install {
    requires Network
    input { package: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["apt-get", "install", "--yes", "{package}"] }
    exit {
      0 => Unit
      100 => String "apt-get install failed (lock held, fetch error, or unmet dependency)"
      nonzero => String "apt-get install failed"
    }
  }
  operation InstallExactNonRemoving {
    requires Network
    input { selection: NonEmptyStr }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell { argv: ["env", "LC_ALL=C", "DEBIAN_FRONTEND=noninteractive", "NEEDRESTART_MODE=l", "apt-get", "--yes", "--no-install-recommends", "--no-remove", "install", "{selection}"] }
    exit { 0 => Unit nonzero => String "apt-get exact non-removing install refused" }
    mock_response { 1 => { success: false, stdout: "", stderr: "no installation supplied" } "no fabricated package installation" }
  }
  operation Remove {
    requires none
    input { package: NonEmptyStr }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell { argv: ["env", "LC_ALL=C", "DEBIAN_FRONTEND=noninteractive", "NEEDRESTART_MODE=l", "apt-get", "--yes", "remove", "{package}"] }
    exit { 0 => Unit nonzero => String "apt-get remove refused" }
    mock_response { 1 => { success: false, stdout: "", stderr: "no removal supplied" } "no fabricated package removal" }
  }
}

// THE PACKAGE INSTALL AS A TYPED COMMAND, the leg a caller runs after its probe reports the package is
// not present. A THIN CALL INTO THE ONE REPARTITION: extdeps.exec.command's
// operation_row_argv_command materializes the Operation Row `PackageManager.Install` declared above in
// THIS module (whose transport shell argv is the only place these tokens are spelled) and seals the
// result; the row's executable token IS the sealed program identity, so this builder carries no program
// word and no match of its own, and nothing is ADDED because nothing may be: no `-y` alias (the row says
// `--yes`), no env prefix (that belongs to InstallExactNonRemoving, a different row with a different
// argv), no elevation -- the ensure-dependency route is the unprivileged one, so the elevation question
// stays with the caller rather than being decided inside an upstream's spelling of its own command. It
// exists to bind this row's coordinates and input name, and to answer with the domain's own refusal
// shape so a row that will not materialize stops its route before any process (DESIGN §5).
data apt_get_install_operation_path: String = "dag/extdeps/package_managers/apt.dag"
data apt_get_install_operation_service: String = "apt.PackageManager"
data apt_get_install_operation_name: String = "Install"
data apt_get_install_input_name: String = "package"

type AptGetInstallCommand
  = AptGetInstallCommandReady { command: ArgvCommand }
  | AptGetInstallCommandRefused { cause: String }

fn apt_get_install_command(package: NonEmptyStr) -> AptGetInstallCommand {
  match operation_row_argv_command(
    path: apt_get_install_operation_path,
    service: apt_get_install_operation_service,
    operation: apt_get_install_operation_name,
    binds: [operation_argv_bind_text(name: apt_get_install_input_name, text: package as String)],
  ) {
    OperationRowArgvCommandReady { command: command } =>
      AptGetInstallCommandReady { command: command }
    OperationRowArgvCommandRefused { cause: cause } =>
      AptGetInstallCommandRefused { cause: cause }
  }
}

// THE EXACT NON-REMOVING INSTALL AND THE REMOVE AS TYPED COMMANDS, each a thin call into the one
// repartition above (the Operation Row spells the tokens; nothing is added here, elevation stays
// with the caller). Same coordinates-and-refusal shape as apt_get_install_command.
fn apt_exact_non_removing_install_command(selection: NonEmptyStr) -> AptGetInstallCommand {
  match operation_row_argv_command(
    path: apt_get_install_operation_path,
    service: apt_get_install_operation_service,
    operation: "InstallExactNonRemoving",
    binds: [operation_argv_bind_text(name: "selection", text: selection as String)],
  ) {
    OperationRowArgvCommandReady { command: command } => AptGetInstallCommandReady { command: command }
    OperationRowArgvCommandRefused { cause: cause } => AptGetInstallCommandRefused { cause: cause }
  }
}

fn apt_remove_command(package: NonEmptyStr) -> AptGetInstallCommand {
  match operation_row_argv_command(
    path: apt_get_install_operation_path,
    service: apt_get_install_operation_service,
    operation: "Remove",
    binds: [operation_argv_bind_text(name: "package", text: package as String)],
  ) {
    OperationRowArgvCommandReady { command: command } => AptGetInstallCommandReady { command: command }
    OperationRowArgvCommandRefused { cause: cause } => AptGetInstallCommandRefused { cause: cause }
  }
}
