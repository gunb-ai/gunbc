module extdeps.package_managers.dpkg
import extdeps.exec.command {ArgvCommand,argv_command}
import extdeps.exec.program {ProgramIdentity, uncataloged_program}

import std.types { NonEmptyStr, Bool, List, Int, Unit }
import std.algebra { Cons, Empty, trim }
import std.optional { Present, Absent }
import v2.std.operation_argv {
  ArgvMaterialized,
  ArgvMaterializationRefused,
  operation_argv_bind_text,
  operation_argv_cause_label,
}

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "manpages.debian.org/testing/dpkg/dpkg.1.en.html"
  }
}

// dpkg_status_argv was DELETED here rather than kept beside this row. It respelled this
// operation's own `transport shell { argv: [...] }` as a second List<String> authority, and its
// last consumer (gunbc.live_deploy.emit's package-ensure predicate) now derives argv from this
// declaration through v2.std.operation_argv. A witness comparing the two spellings for equality
// was all that held the fork together; equality is not single authority.
service dpkg.Package {
  operation Status {
    requires none
    input { package: NonEmptyStr }
    output { installed: Bool from "exit_success" }
    readonly
    transport shell { argv: ["dpkg", "-s", "{package}"] }
    exit {
      0 => Unit
      1 => Unit "package not installed"
      nonzero => String "dpkg -s failed"
    }
  }
}

// THE INSTALLED STATE, NOT MERE KNOWLEDGE OF THE PACKAGE. `dpkg -s` above exits zero for any package
// the database has a status record for -- including one REMOVED with its configuration files kept --
// so its exit status cannot answer "is this package installed". The answer is the record's Status
// field (dpkg-query(1), --status): "install ok installed" is installed; "deinstall ok config-files"
// is removed with config remaining; "install ok unpacked", "half-configured" and the rest are not
// installed. An unknown package makes dpkg-query exit 1.
//
// THE ARGV CARRIES NO FORMAT STRING, and that is measured rather than stylistic: the ${db:Status-Abbrev}
// --showformat form was refused on the fleet SSH edge on every package (fleet-converge run
// 36375956111, srv1: "remote words are not portable under the far-side shell re-parse"), because the
// word carries shell metacharacters. The Status line of the plain record is the same fact.
data dpkg_query_program: NonEmptyStr = "dpkg-query"
// THE dpkg BINARY ITSELF, a different program from dpkg-query above. dpkg(1) and dpkg-query(1) are
// two executables with two calling conventions: the Status row runs `dpkg -s`, the Query row runs
// `dpkg-query -s`. Naming both here keeps each program identity in the module that owns dpkg, so a
// caller never carries a bare binary word and never spells one as the other.
data dpkg_status_program: NonEmptyStr = "dpkg"

fn dpkg_query_identity() -> ProgramIdentity = uncataloged_program(invocation: dpkg_query_program)

fn dpkg_query_status_argv(package: NonEmptyStr) -> List<String> {
  [dpkg_query_program as String, "-s", package as String]
}

// THE QUERY'S WHOLE OUTCOME DECIDES, AND ONLY A UNIQUELY DECODED ANSWER MAY AUTHORIZE A MUTATION
// (side-chat review 5334435195 of gunbc#12500). dpkg-query -s exits 0 with the package's record, or
// exits 1 naming a package it has no information about. The record carries exactly one Status line of
// three words -- desired action, error flag, status (dpkg-query(1), "Package status and state"). So:
//   installed          exit 0, one Status line, want install|hold, flag ok, status installed
//   not installed      exit 0, one decodable Status line in any other state (config-files, unpacked,
//                      half-configured, ...), carried verbatim
//   unknown to dpkg    exit 1 with dpkg-query's "no information is available" refusal
//   undecidable        everything else: another exit, zero or several Status lines, an undecodable
//                      Status line, a refusal in other words
// Only the first three are answers. Undecidable is never read as absent, because absent authorizes an
// install and nothing was established.
data dpkg_query_unknown_package_marker: String = "no information is available"

type DpkgInstalledState
  = DpkgPackageInstalled
  | DpkgPackageNotInstalled { status: String }
  | DpkgPackageUnknown
  | DpkgQueryUndecidable { reason: String }

data dpkg_status_wants: List<String> = ["unknown", "install", "hold", "deinstall", "purge"]
data dpkg_status_flags: List<String> = ["ok", "reinstreq"]
data dpkg_status_states: List<String> = ["not-installed", "config-files", "half-installed", "unpacked", "half-configured", "triggers-awaited", "triggers-pending", "installed"]

fn dpkg_member(xs: List<String>, x: String) -> Bool {
  fold(xs, init: false, f: (acc, y) => acc || y == x)
}

fn dpkg_status_lines_of(record: String) -> List<String> {
  fold(split(record, "\n"), init: [], f: (acc, line) =>
    if starts_with(s: line, prefix: "Status:") { concat(acc, [trim(s: line)]) } else { acc })
}

// A status/cache stanza must name each identity field exactly once. Missing and duplicate
// fields remain unreadable; the caller checks the expected package, version and architecture.
fn dpkg_record_field(record: String, field: String) -> String? {
  let prefix = concat(field, ":")
  let rows = filter(split(s: record, delimiter: "\n"), line => starts_with(s: line, prefix: prefix))
  if rows.count() != 1 { none } else { match rows.first() {
    Present { value: row } => {
      let value = trim(s: substring(s: row, start: string_length(s: prefix), end: string_length(s: row)))
      if value == "" { none } else { Present { value: value } }
    }
    Absent => none
  } }
}

fn dpkg_words_of(text: String) -> List<String> {
  fold(split(text, " "), init: [], f: (acc, w) => if w == "" { acc } else { concat(acc, [w]) })
}

fn dpkg_status_decoded(status_line: String) -> DpkgInstalledState {
  match dpkg_words_of(text: status_line) {
    Cons { head: label, tail: Cons { head: want, tail: Cons { head: flag, tail: Cons { head: state, tail: Empty } } } } =>
      if label != "Status:" || dpkg_member(xs: dpkg_status_wants, x: want) == false || dpkg_member(xs: dpkg_status_flags, x: flag) == false || dpkg_member(xs: dpkg_status_states, x: state) == false {
        DpkgQueryUndecidable { reason: concat("the Status line does not decode: ", status_line) }
      } else if state == "installed" && flag == "ok" && (want == "install" || want == "hold") {
        DpkgPackageInstalled
      } else {
        DpkgPackageNotInstalled { status: status_line }
      }
    _ => DpkgQueryUndecidable { reason: concat("the Status line is not three words: ", status_line) }
  }
}

fn dpkg_query_status_verdict_of(exit_code: Int, stdout: String, stderr: String) -> DpkgInstalledState {
  if exit_code == 0 {
    match dpkg_status_lines_of(record: stdout) {
      Cons { head: line, tail: Empty } => dpkg_status_decoded(status_line: line)
      Empty => DpkgQueryUndecidable { reason: "dpkg-query exited 0 and printed no Status line" }
      _ => DpkgQueryUndecidable { reason: "dpkg-query printed more than one Status line" }
    }
  } else if exit_code == 1 && string_contains(s: stderr, pattern: dpkg_query_unknown_package_marker) {
    DpkgPackageUnknown
  } else {
    DpkgQueryUndecidable { reason: join(["dpkg-query exited ", to_string(exit_code), ": ", trim(s: stderr)], "") }
  }
}

// The same status query through the typed local command seam, preserving all three
// process outputs for dpkg_query_status_verdict_of.
fn dpkg_query_status_command(package:NonEmptyStr) -> ArgvCommand {
 argv_command(program:uncataloged_program(invocation:dpkg_query_program),arguments:dpkg_query_status_argv(package:package).skip(n:1))
}

// THE INSTALL-STATE PROBE AS A TYPED COMMAND, the `dpkg -s` a caller asks before installing anything.
// THE ARGV IS DERIVED FROM THIS MODULE'S OWN ROW, NOT REPEATED: this binds the package against the
// Operation Row `Package.Status` above and materializes it through shell_materialize_operation_argv,
// the pattern `gunbc.systemd_run_transient.systemd_run_transient_operation_argv` sets for
// systemd.SystemdRun. The row's transport-shell argv is the ONLY place these tokens are spelled. A
// hand-written ["-s", package] beside the row would re-mint the second authority this module's own
// tombstone above deletes, and a witness comparing the two spellings token by token -- the shape
// `systemd_run_transient_operation_argv_matches_authority` records, which `dpkg_status_command`
// copied -- is equality POLICING between two authors, not single authority; where a builder can
// consume the materializer directly, the comparison witness is not needed at all.
// WHY A SEALED COMMAND AND NOT THE MATERIALIZED TEXT AS IS. The row materializes to argv TEXT for the
// Bash emitter; the host-effect lane runs commands over an argument-vector transport with no shell in
// it, and that seam takes a sealed `ArgvCommand` -- a program identity beside its argument tail. So
// the materialized words are REPARTITIONED here, never re-spelled: token[0] is CHECKED to be the
// program identity this module's program.dag row names (an execve parameter per extdeps.exec.command),
// and the tail passes through untouched. A MATERIALIZATION REFUSAL STAYS A REFUSAL and is reported,
// not swallowed: the answer is a typed Refused naming the cause, so a caller that cannot tell refuses
// before its leg runs rather than execing a plausible-looking probe (the marker-not-empty-argv
// discipline src/v2/extdeps/languages/rust_fixtures.dag records, and DESIGN 5: refuse, never widen).
data dpkg_status_operation_path: String = "dag/extdeps/package_managers/dpkg.dag"
data dpkg_status_operation_service: String = "dpkg.Package"
data dpkg_status_operation_name: String = "Status"
data dpkg_status_input_name: String = "package"

type DpkgStatusCommand
  = DpkgStatusCommandReady { command: ArgvCommand }
  | DpkgStatusCommandRefused { cause: String }

fn dpkg_status_command(package: NonEmptyStr) -> DpkgStatusCommand {
  match shell_materialize_operation_argv(
    dpkg_status_operation_path,
    dpkg_status_operation_service,
    dpkg_status_operation_name,
    [operation_argv_bind_text(name: dpkg_status_input_name, text: package as String)],
  ) {
    ArgvMaterialized { argv: materialized } =>
      match materialized.first() {
        Present { value: head } =>
          if head == dpkg_status_program as String {
            DpkgStatusCommandReady {
              command: argv_command(
                program: uncataloged_program(invocation: dpkg_status_program),
                arguments: materialized.skip(n: 1),
              ),
            }
          } else {
            DpkgStatusCommandRefused {
              cause: concat("the dpkg.Package Status row materialized a token in its executable position that is not ", dpkg_status_program as String),
            }
          }
        Absent =>
          DpkgStatusCommandRefused { cause: "the dpkg.Package Status row materialized an empty argv" }
      }
    ArgvMaterializationRefused { at: _, cause: c } =>
      DpkgStatusCommandRefused { cause: operation_argv_cause_label(cause: c) }
  }
}
