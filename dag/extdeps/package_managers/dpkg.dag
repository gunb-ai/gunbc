module extdeps.dpkg

import std.types { NonEmptyStr, String, Bool, List }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "manpages.debian.org/testing/dpkg/dpkg.1.en.html"
  }
}

// dpkg_status_argv was DELETED here rather than kept beside this row. It respelled this
// operation's own `transport shell { argv: [...] }` as a second List<String> authority, and its
// last consumer (gunbc.live_deploy.emit's package-ensure predicate) now derives argv from this
// declaration through v2.std.operation_argv. A witness comparing the two spellings for equality
// was all that held the fork together; equality is not single authority.
service dpkg.Package {
  operation Status {
    input { package: NonEmptyStr }
    output { installed: Bool from "exit_success" }
    readonly
    transport shell { argv: ["dpkg", "-s", "{package}"] }
    exit {
      0 => Unit
      1 => Unit "package not installed"
      nonzero => String "dpkg -s failed"
    }
  }
}

// THE INSTALLED STATE, NOT MERE KNOWLEDGE OF THE PACKAGE. `dpkg -s` above exits zero for any package
// the database has a status record for -- including one REMOVED with its configuration files kept
// (status `deinstall ok config-files`) -- so it cannot answer "is this package installed".
// dpkg-query(1)'s db:Status-Abbrev field is the desired-action and status letters plus the error
// flag: `ii ` is install-requested and installed; `rc ` is removed with config remaining; `iU `,
// `iF `, `iH ` are unpacked, half-configured or half-installed. Only `ii` with no error flag is
// installed. An unknown package makes dpkg-query exit 1 with no output.
data dpkg_query_program: NonEmptyStr = "dpkg-query"

data dpkg_query_status_abbrev_format: String = "-f=$\{db:Status-Abbrev}"

fn dpkg_query_status_abbrev_argv(package: NonEmptyStr) -> List<String> {
  [dpkg_query_program as String, "-W", dpkg_query_status_abbrev_format, package as String]
}

type DpkgInstalledState
  = DpkgPackageInstalled
  | DpkgPackageNotInstalled { status_abbrev: String }

fn dpkg_installed_state_of(status_abbrev: String) -> DpkgInstalledState {
  if status_abbrev == "ii " || status_abbrev == "ii" { DpkgPackageInstalled } else { DpkgPackageNotInstalled { status_abbrev: status_abbrev } }
}
