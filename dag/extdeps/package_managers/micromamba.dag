module extdeps.package_managers.micromamba

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { String, NonEmptyStr, List }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.package_managers.conda_forge { CondaPackageRequirement, conda_requirement_spec }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/mamba-org/micromamba-releases/releases/tag/2.9.0-0"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.package_managers.micromamba",
      decl_name: "micromamba_linux_aarch64_release",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// MICROMAMBA IS ITS OWN UPSTREAM, separate from the channel it resolves against
// (extdeps.package_managers.conda_forge): mamba-org versions and publishes the solver binary, and
// conda-forge publishes the packages. One published release, as a single static executable per
// platform, with its SHA-256 as published beside it (micromamba-linux-aarch64.sha256) and as GitHub
// reports the asset digest; the two agree.
type MicromambaRelease sole_constructor {
  version: NonEmptyStr
  url: NonEmptyStr
  sha256: NonEmptyStr
}

data micromamba_linux_aarch64_release: MicromambaRelease = MicromambaRelease {
  version: "2.9.0-0",
  url: "https://github.com/mamba-org/micromamba-releases/releases/download/2.9.0-0/micromamba-linux-aarch64",
  sha256: "9f93b974adcb4d166996af969b6cd371287d1a3e52733704727884d9b74cb7a7",
}

// The binary is run from where the caller placed it, never resolved through PATH.
fn micromamba_at(executable: NonEmptyStr) -> ProgramIdentity = uncataloged_program(invocation: executable)

// ONE SOLVE OVER THE WHOLE REQUIREMENT LIST into a prefix the caller names, from the named channel
// only. --root-prefix places micromamba's own package cache under the caller's directory rather than
// the invoking user's home. Where both live is a deployment fact of the caller, not of micromamba.
fn micromamba_create_command(
  micromamba: ProgramIdentity,
  root_prefix: String,
  prefix: String,
  channel: NonEmptyStr,
  requirements: List<CondaPackageRequirement>,
) -> ArgvCommand {
  argv_command(
    program: micromamba,
    arguments: concat(
      ["create", "--yes", "--root-prefix", root_prefix, "--prefix", prefix, "--override-channels", "--channel", channel as String],
      map(requirements, r => conda_requirement_spec(r: r)),
    ),
  )
}
