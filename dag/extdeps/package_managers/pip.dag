// A PINNED REQUIREMENT, as PEP 440 spells it: one distribution name and one exact version. The
// version is not optional, and that is the reason the type exists: an unpinned install resolves to
// whatever the index serves at that moment, so two hosts could provision different toolchains from
// one declaration -- a meaning fork with the index as its author. Not sole_constructor: a name and
// a version admit no decision, and a seal that admits everything claims a check that does not exist.
type PythonDistributionRequirement {
  distribution: NonEmptyStr
  version: NonEmptyStr
}

fn python_distribution_name(r: PythonDistributionRequirement) -> NonEmptyStr { r.distribution }
fn python_distribution_version(r: PythonDistributionRequirement) -> NonEmptyStr { r.version }

fn pinned_requirement_specifier(r: PythonDistributionRequirement) -> String {
  join([r.distribution as String, "==", r.version as String], "")
}

// pip RUN AS ITS INTERPRETER'S MODULE (`<python> -m pip`), which is how pip documents installing into
// a specific interpreter's environment: a PATH `pip` belongs to whichever environment PATH finds
// first, so it can install into a different place than the interpreter that will import the result.
fn pip_module_install_command(interpreter: ProgramIdentity, requirements: List<PythonDistributionRequirement>) -> ArgvCommand {
  argv_command(
    program: interpreter,
    arguments: concat(["-m", "pip", "install", "--no-input", "--disable-pip-version-check"], map(requirements, r => pinned_requirement_specifier(r: r))),
  )
}
