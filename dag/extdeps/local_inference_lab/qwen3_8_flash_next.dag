// THE LOCAL-INFERENCE-LAB QWEN3.8-FLASH-NEXT NVFP4 CHECKPOINT, AS ITS PUBLISHER'S OWN EXTDEPS AUTHORITY.
// This is the carrier gunbc.plans.flex_supplier_generalization generalization_55 declared and nothing
// built: "the RentedWeightsPlacement shape generalizes ... over a Hugging Face repo at a pinned
// revision, and Flash-Next moves from WeightsNamedUnpinned to the pinned revision observed on the
// image." The row was declared; this module is the destination. The publisher is local-inference-lab,
// not Alibaba and not vLLM upstream — they can re-quantize and push a new revision tomorrow — so under
// DESIGN section 3's external-decomposition rule it is its own module, the shape
// extdeps.radixark.glm_5_3_nvfp4 already establishes for a different publisher's redistribution.
//
// WHAT THIS MODULE KNOWS AND WHAT IT DOES NOT (DESIGN 4d). It knows the Hub facts of the artifact: the
// repository, the exact revision serving runs at, the manifest the model API reports there, and the
// content digests of the files the engine reads at start. It does NOT assert the quantization method:
// the engine reports what it LOADED (`quantization=nvfp4_csf`, in the serving startup log, recorded by
// gunbc.serving.srv1_serving_launch), and the repository NAME containing "NVFP4" is a name, not a
// standing. Nothing here cites a paper or a release note for "NVFP4".

data qwen3_8_flash_next_hub_repo: HubRepoId = HubRepoId {
  kind: HubModelRepo,
  path: "local-inference-lab/Qwen3.8-Flash-Next-NVFP4-MXFP8-CSF-QAD" as NonEmptyStr,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: hub_repo_https_uri(repo: qwen3_8_flash_next_hub_repo),
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.local_inference_lab.qwen3_8_flash_next",
      decl_name: "qwen3_8_flash_next_hub_repo",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

// THE PINNED REVISION. It is pinned because the host proves the tree moves: serving downloads by
// revision, and the same tree was read on srv1's download cache at this revision (blob names matched,
// 2026-10-25). The manifest is the Hub model API's own answer for this revision — 39 files, 21 of them
// safetensors — read through the public model API 2026-10-25; the numbers are the API's, not a local
// walk, and the read record below says so.
data qwen3_8_flash_next_pinned_revision: NonEmptyStr =
  "dc5b8ab2fa14bc4fecd6886273b7ebc6095662e2" as NonEmptyStr

data qwen3_8_flash_next_manifest: HubCheckpointManifest = hub_checkpoint_manifest(
  revision: qwen3_8_flash_next_pinned_revision,
  safetensors_shard_count: 21,
  safetensors_bytes: byte_size(count: 102192011716),
  repository_total_bytes: byte_size(count: 102262354720),
  read_by: "the Hub model API tree for this repo at the revision above, read 2026-10-25; the per-file digests below are the same response's lfs.oid / oid members, and config.json plus the index were independently hashed on srv1's cache the same day and matched" as NonEmptyStr,
)

// THE TWO SMALL FILES WHOSE BYTES CHANGE ENGINE BEHAVIOR, digested at the pinned revision. config.json
// is what the loader dispatches its quantization config on; the index's shard map must match the shards
// on disk. Pinning only the shards would leave a substitution of either undetected by any digest check.
// config.json is git-stored (its digest is the content digest the API reports alongside the git blob
// oid, no LFS pointer); the index is LFS-stored, whose Hub `lfs.oid` IS the sha256.
data qwen3_8_flash_next_config_pin: HubFileDigest = hub_file_digest(
  path_in_repo: "config.json" as NonEmptyStr,
  revision: qwen3_8_flash_next_pinned_revision,
  bytes: byte_size(count: 75217),
  sha256_hex: "b50dbc52a0c83b0cd2a44a372c1fb6b5e0e6827d22f2611c97d4d030f92f6b28" as NonEmptyStr,
  lfs_stored: false,
)

data qwen3_8_flash_next_index_pin: HubFileDigest = hub_file_digest(
  path_in_repo: "model.safetensors.index.json" as NonEmptyStr,
  revision: qwen3_8_flash_next_pinned_revision,
  bytes: byte_size(count: 47280974),
  sha256_hex: "5fa166bbb1cf25adda455117563efa72a2072272001f459eedece131ffc913e1" as NonEmptyStr,
  lfs_stored: true,
)

// EVERY SAFETENSOR SHARD, digested at the pinned revision. Each `lfs_stored: true` digest is the Hub's
