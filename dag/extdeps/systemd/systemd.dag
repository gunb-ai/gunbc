module extdeps.systemd

import std.types { NonEmptyStr, String, Int }
import std.types { list_length }
import std.algebra { trim }
import std.types { List }
import std.nat { Nat }
import std.measure {
  ByteSize, byte_size, byte_size_count, Microsecond, microsecond, microsecond_count,
  HardwareThreadCount, hardware_thread_count_value,
  milli_per_unit, micro_per_unit, seconds_per_minute, minutes_per_hour,
}
import std.checked_arithmetic { checked_int_magnitude, CheckedNat, CheckedNatReady, CheckedNatOverflow }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.systemd.systemd_contracts { systemd_unit_active_state_wire_contract }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/systemctl.1.html#is-active"
  }
}

type SystemdUnitActiveState
  = Active
  | Inactive
  | Activating
  | Deactivating
  | Reloading
  | Failed

data systemd_parse_label_derivation_debt: List<NonEmptyStr> = [
  "dissolve-on: when contract-driven derivation is available (§3 single authority), derive parse/label from wire contract instead of hand-rolling",
]

// `MainPID` IS THE PROPERTY THAT SAYS WHICH PROCESS THE MANAGER BELIEVES IT IS SUPERVISING, and it
// is a magnitude like the cgroup evidence beside it rather than a lifecycle word like `LoadState`,
// which is why it joins this coproduct instead of taking its own operation the way LoadState did.
//
// It is read for a reason the other members cannot serve: every property here answers for the unit
// AS THE MANAGER SEES IT, and a consumer comparing the manager's view against the cgroup's actual
// occupants needs the manager's own nominated pid to make that comparison at all. Without it the
// two views cannot be joined -- a reader can see that a cgroup holds four processes and that the
// unit is active, and still not know which one systemd would signal.
//
// systemd answers `0` for a unit with no main process, which is not a pid; decoding that boundary
// belongs to the consumer, because "the manager supervises nothing" and "the manager supervises pid
// N" are different observations and this authority's job is to carry the wire value, not to decide
// what an absent main process means for any one unit.
type SystemdUnitProperty
  = MemoryMax
  | MemorySwapMax
  | MemoryHigh
  | CPUWeight
  | CPUQuota
  | CPUQuotaPerSecUSec
  | MemoryCurrent
  | TasksMax
  | TasksCurrent
  | ControlGroup
  | SliceProperty
  | ActiveEnterTimestampMonotonic
  | ActiveState
  | MainPID
  | LoadState
  | UnitFileState
  | SubState
  | Result
  | ExecMainStatus
  | SubState
  | ExecStartProperty
  | User
  | WorkingDirectoryProperty
  | RuntimeDirectoryProperty
  | Unit
  | NextElapseUSecMonotonic
  | AccuracyUSec
  | TimersMonotonic
  | NeedDaemonReload

fn systemd_unit_property_wire(property: SystemdUnitProperty) -> NonEmptyStr {
  match property {
    MemoryMax => "MemoryMax" as NonEmptyStr
    MemorySwapMax => "MemorySwapMax" as NonEmptyStr
    MemoryHigh => "MemoryHigh" as NonEmptyStr
    CPUWeight => "CPUWeight" as NonEmptyStr
    CPUQuota => "CPUQuota" as NonEmptyStr
    CPUQuotaPerSecUSec => "CPUQuotaPerSecUSec" as NonEmptyStr
    MemoryCurrent => "MemoryCurrent" as NonEmptyStr
    TasksMax => "TasksMax" as NonEmptyStr
    TasksCurrent => "TasksCurrent" as NonEmptyStr
    ControlGroup => "ControlGroup" as NonEmptyStr
    SliceProperty => "Slice" as NonEmptyStr
    ActiveEnterTimestampMonotonic => "ActiveEnterTimestampMonotonic" as NonEmptyStr
    ActiveState => "ActiveState" as NonEmptyStr
    MainPID => "MainPID" as NonEmptyStr
    LoadState => "LoadState" as NonEmptyStr
    UnitFileState => "UnitFileState" as NonEmptyStr
    SubState => "SubState" as NonEmptyStr
    Result => "Result" as NonEmptyStr
    ExecMainStatus => "ExecMainStatus" as NonEmptyStr
    SubState => "SubState" as NonEmptyStr
    ExecStartProperty => "ExecStart" as NonEmptyStr
    User => "User" as NonEmptyStr
    WorkingDirectoryProperty => "WorkingDirectory" as NonEmptyStr
    RuntimeDirectoryProperty => "RuntimeDirectory" as NonEmptyStr
    Unit => "Unit" as NonEmptyStr
    NextElapseUSecMonotonic => "NextElapseUSecMonotonic" as NonEmptyStr
    AccuracyUSec => "AccuracyUSec" as NonEmptyStr
    TimersMonotonic => "TimersMonotonic" as NonEmptyStr
    NeedDaemonReload => "NeedDaemonReload" as NonEmptyStr
  }
}

data systemd_unit_load_state_not_found_wire: NonEmptyStr = "not-found" as NonEmptyStr

data systemd_memory_max_property: NonEmptyStr = systemd_unit_property_wire(property: MemoryMax)

data systemd_memory_swap_max_property: NonEmptyStr = systemd_unit_property_wire(property: MemorySwapMax)

data systemd_memory_high_property: NonEmptyStr = systemd_unit_property_wire(property: MemoryHigh)

data systemd_cpu_weight_property: NonEmptyStr = systemd_unit_property_wire(property: CPUWeight)

// CPUQuota= IS A CEILING AND CPUWeight= IS A SHARE, AND THEY ARE NOT ALIASES.
// systemd.resource-control(5): CPUWeight assigns a RELATIVE share against sibling cgroups and
// guarantees no amount of anything; CPUQuota assigns an ABSOLUTE maximum of CPU time per wall
// second. A boundary that must not be exceeded is expressible in exactly one of them, so
// carrying only the weight -- as this vocabulary did -- left the ceiling unsayable rather than
// merely unset.
data systemd_cpu_quota_property: NonEmptyStr = systemd_unit_property_wire(property: CPUQuota)

data systemd_cpu_quota_per_sec_property: NonEmptyStr = systemd_unit_property_wire(property: CPUQuotaPerSecUSec)

data systemd_memory_current_property: NonEmptyStr = systemd_unit_property_wire(property: MemoryCurrent)

data systemd_tasks_max_property: NonEmptyStr = systemd_unit_property_wire(property: TasksMax)

data systemd_tasks_current_property: NonEmptyStr = systemd_unit_property_wire(property: TasksCurrent)

// systemd.time(7) TIME SPAN NORMALIZATION, the smallest slice launch standing needs: a span is one
// or more whitespace-separated <value><unit> parts (a bare value reads as seconds), and the units
// below are the documented spellings for the magnitudes systemd renders timer facts in (usec
// through hours). The result is microseconds, systemd's own internal resolution, so "60s" ==
// "1min" becomes decidable equality instead of a string comparison. Unknown units, empty input, or
// a malformed part refuse with Absent -- never a partial sum.
type SystemdTimeSpanPart {
  value: Nat
  unit: String
}

fn systemd_time_span_unit_usec(unit: String) -> Nat? {
  if unit == "usec" || unit == "us" {
    let one: Nat = 1
    Present { value: one }
  }
  else if unit == "msec" || unit == "ms" { Present { value: milli_per_unit() } }
  else if unit == "seconds" || unit == "second" || unit == "sec" || unit == "s" || unit == "" {
    Present { value: micro_per_unit() }
  }
  else if unit == "minutes" || unit == "minute" || unit == "min" || unit == "m" {
    Present { value: seconds_per_minute() * micro_per_unit() }
  }
  else if unit == "hours" || unit == "hour" || unit == "hr" || unit == "h" {
    Present { value: minutes_per_hour() * seconds_per_minute() * micro_per_unit() }
  }
  else { none }
}

fn systemd_time_span_split(part: String) -> SystemdTimeSpanPart? {
  let scan = fold(chars(s: part), init: 0, f: (n, c) =>
    if n < 0 { n } else if c >= 48 && c <= 57 { n + 1 } else { 0 - n - 1 })
  let digits = if scan < 0 { 0 - scan - 1 } else { scan }
  if digits == 0 {
    none
  } else {
    match parse_int(s: substring(s: part, start: 0, end: digits)) {
      Absent => none
      Present { value: v } =>
        if v < 0 {
          none
        } else {
          match checked_int_magnitude(a: v) {
            CheckedNatOverflow { cause: _ } => none
            CheckedNatReady { value: n } =>
              Present { value: SystemdTimeSpanPart { value: n, unit: substring(s: part, start: digits, end: string_length(s: part)) } }
          }
        }
    }
  }
}

fn systemd_duration_usec(text: String) -> Microsecond? {
  let parts = filter(split(s: trim(s: text), delimiter: " "), p => p != "")
  if list_length(items: parts) == 0 {
    none
  } else {
    let total = fold(parts, init: Present { value: 0 }, f: (acc, part) =>
      match acc {
        Absent => none
        Present { value: so_far } =>
          match systemd_time_span_split(part: part) {
            Absent => none
            Present { value: vu } =>
              match systemd_time_span_unit_usec(unit: vu.unit) {
                Absent => none
                Present { value: mult } => Present { value: so_far + vu.value * mult }
              }
          }
      })
    match total {
      Absent => none
      Present { value: n } => Present { value: microsecond(count: n) }
    }
  }
}

// THE CONFIGURED SPELLING AND THE READBACK SPELLING ARE DIFFERENT PROPERTIES. `CPUQuota=` is the
// configuration setting written as a percentage; `systemctl show` reports `CPUQuotaPerSecUSec`, a
// duration of CPU time permitted per wall second. Reading CPUQuota after writing it compares against
// a property systemd does not report.
//
// An UNSET quota reads back `infinity`, so CpuQuotaUnbounded is the host affirmatively reporting no
// ceiling. CpuQuotaAbsent is an empty show value (the property was not reported). CpuQuotaUndecodable
// is an observation failure and carries the unread text: folding it into unbounded or absent would
// report a cell of unknown standing as a known policy state.
type SystemdCpuQuotaPerSec
  = CpuQuotaUnbounded
  | CpuQuotaPerSec { usec: Microsecond }
  | CpuQuotaAbsent
  | CpuQuotaUndecodable { raw: String }

// 100% IS ONE CPU-SECOND PER WALL SECOND. A thread count is a multiple of that unit. The seconds-to-
// microseconds factor is std.measure micro_per_unit: the scale is a fact about the units, not about
// systemd.
fn systemd_cpu_quota_per_sec_of_threads(threads: HardwareThreadCount) -> Microsecond {
  microsecond(count: hardware_thread_count_value(t: threads) * micro_per_unit())
}

fn systemd_cpu_quota_per_sec_magnitude_identity(usec: Microsecond) -> String {
  to_string(microsecond_count(m: usec))
}

// SYSTEMD PRINTS THIS PROPERTY AS A FORMATTED TIME SPAN. Measured against systemd 255: `infinity`,
// `100ms`, `1s`, `6s`, and past sixty CPU-seconds per wall second the compound `1min`, `1min 500ms`,
// `1min 30s`. Fractional forms such as `1.500000s` are undecodable here because truncating them would
// report a lower ceiling than the host has. Compound spans decode through systemd_duration_usec so
// `60s` and `1min` are the same magnitude.
fn parse_systemd_cpu_quota_per_sec_show(raw: String) -> SystemdCpuQuotaPerSec {
  if trim(s: raw) == "" { CpuQuotaAbsent }
  else if trim(s: raw) == "infinity" { CpuQuotaUnbounded }
  else {
    match systemd_duration_usec(text: raw) {
      Present { value: u } => CpuQuotaPerSec { usec: u }
      Absent => CpuQuotaUndecodable { raw: raw }
    }
  }
}

// COMPARABLE ARMS HAVE AN IDENTITY STRING; UNDECODABLE HAS NONE. Desired never produces Undecodable:
// it renders through systemd_cpu_quota_per_sec_magnitude_identity of of_threads, which is total.
fn systemd_cpu_quota_per_sec_identity(q: SystemdCpuQuotaPerSec) -> String? {
  match q {
    CpuQuotaUnbounded => Present { value: "infinity" }
    CpuQuotaPerSec { usec: u } => Present { value: systemd_cpu_quota_per_sec_magnitude_identity(usec: u) }
    CpuQuotaAbsent => Present { value: "" }
    CpuQuotaUndecodable { raw: _ } => none
  }
}

type SystemdCgroupMemoryLimit
  = MemoryLimitUnbounded
  | MemoryLimitBytes { bytes: ByteSize }
  | MemoryLimitAbsent

fn parse_systemd_memory_limit_show(raw: String) -> SystemdCgroupMemoryLimit {
  if raw == "" { MemoryLimitAbsent }
  else { if raw == "infinity" { MemoryLimitUnbounded }
  else { match parse_int(s: raw) {
    Present { value: n } => MemoryLimitBytes { bytes: byte_size(count: n) }
    Absent => MemoryLimitAbsent
  } } }
}

fn systemd_memory_limit_wire_label(lim: SystemdCgroupMemoryLimit) -> String {
  match lim {
    MemoryLimitUnbounded => "infinity"
    MemoryLimitBytes { bytes: b } => to_string(byte_size_count(b: b))
    MemoryLimitAbsent => ""
  }
}

type SystemdCgroupTaskLimit
  = TaskLimitUnbounded
  | TaskLimitCount { count: Int }
  | TaskLimitAbsent

// parse_systemd_task_limit_show mirrors parse_systemd_memory_limit_show because a systemd
// cgroup limit shown by `systemctl show` is one wire shape — a decimal count or the literal
// "infinity" — differing only in the magnitude it grounds into (ByteSize vs a cardinal task
// count). 🟡 feature:task-count-measure-carrier dissolve-on: a single limit parse
// parameterized by magnitude (the SystemdCgroupLimit<M> consolidation) with the count arm
// grounding into a std.measure TaskCount carrier (the HardwareThreadCount shape) instead of
// bare Int, at which point both hand parses derive from it and the flat scalar retires.
fn parse_systemd_task_limit_show(raw: String) -> SystemdCgroupTaskLimit {
  if raw == "" { TaskLimitAbsent }
  else { if raw == "infinity" { TaskLimitUnbounded }
  else { match parse_int(s: raw) {
    Present { value: n } => TaskLimitCount { count: n }
    Absent => TaskLimitAbsent
  } } }
}

fn systemd_task_limit_wire_label(lim: SystemdCgroupTaskLimit) -> String {
  match lim {
    TaskLimitUnbounded => "infinity"
    TaskLimitCount { count: n } => to_string(n)
    TaskLimitAbsent => ""
  }
}

fn parse_systemd_unit_active_state(raw: String) -> SystemdUnitActiveState? {
  if raw == "active" { Present { value: Active } }
  else { if raw == "inactive" { Present { value: Inactive } }
  else { if raw == "activating" { Present { value: Activating } }
  else { if raw == "deactivating" { Present { value: Deactivating } }
  else { if raw == "reloading" { Present { value: Reloading } }
  else { if raw == "failed" { Present { value: Failed } }
  else { none } } } } } }
}

fn systemd_unit_active_state_wire_label(s: SystemdUnitActiveState) -> String {
  match s {
    Active => "active"
    Inactive => "inactive"
    Activating => "activating"
    Deactivating => "deactivating"
    Reloading => "reloading"
    Failed => "failed"
  }
}

type SystemdUnitStatus {
  name: NonEmptyStr
  active_state: SystemdUnitActiveState
}

// WHERE SYSTEMD'S CLIENT BINARIES LIVE, declared once because the corpus needs two spellings of the
// same binary and had been writing each by hand. A sudoers grant names a command by ABSOLUTE path --
// sudo matches on the resolved path and a relative spelling in a drop-in is a policy error -- while
// an argv handed to sudo names it BARE and lets secure_path resolve it. Those are both correct and
// they are not two facts: they are one binary rendered for two consumers.
//
// Rendering them from one row is what makes them unable to disagree. Measured on srv5 and srv6
// 2026-08-22, `command -v` reports /usr/bin for loginctl, systemctl and journalctl alike, which is
// the ordinary filesystem-hierarchy location for a distribution-packaged systemd; a host that
// installed systemd somewhere else would need this row and not a second spelling at the call site.
data systemd_binary_directory: NonEmptyStr = "/usr/bin" as NonEmptyStr

fn systemd_binary_path(name: NonEmptyStr) -> NonEmptyStr {
  join([systemd_binary_directory as String, "/", name as String], "") as NonEmptyStr
}
