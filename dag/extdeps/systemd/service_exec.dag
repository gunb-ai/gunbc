import extdeps.exec.command { ArgvCommand, argv_words }

// WHAT THE SERVICE MANAGER HANDS A STOP COMMAND, and how a command line is spelled to it. Two
// upstream facts, both from systemd's own manuals, and nothing about any one consumer: which unit
// carries a stop hook, what it writes and where are workflow facts that live with the workflow.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.freedesktop.org/software/systemd/man/latest/systemd.exec.html#Environment%20Variables%20Set%20or%20Propagated%20by%20the%20Service%20Manager"
  }
}

data systemd_service_command_lines_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.freedesktop.org/software/systemd/man/latest/systemd.service.html#Command%20lines"
  }
}

data systemd_exec_process_exit_codes_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.freedesktop.org/software/systemd/man/255/systemd.exec.html#Process%20Exit%20Codes"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.systemd.service_exec",
      decl_name: "ServiceStopVariable",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [systemd_service_command_lines_authority, systemd_exec_process_exit_codes_authority]
}

// systemd.exec(5), "Environment Variables Set or Propagated by the Service Manager":
//   $INVOCATION_ID  -- set for every process the manager spawns for the unit: the unit's current
//                      invocation, a 128-bit id formatted as 32 lowercase hex characters.
//   $SERVICE_RESULT -- set for ExecStop= and ExecStopPost= only: the service's result, one of the
//                      words below.
//   $EXIT_CODE      -- set for ExecStop= and ExecStopPost= only: how the main process ended:
//                      "exited", "killed" or "dumped" (empty if it never ran).
//   $EXIT_STATUS    -- set for ExecStop= and ExecStopPost= only: the numeric exit status when
//                      $EXIT_CODE is "exited", otherwise the signal NAME (e.g. "TERM").
// They exist only while the stop command runs, so a record of the main process's end that survives
// the unit has to be written by that command, from these values.
type ServiceStopVariable
  = InvocationIdVariable
  | ServiceResultVariable
  | ExitCodeVariable
  | ExitStatusVariable

fn service_stop_variable_name(variable: ServiceStopVariable) -> NonEmptyStr {
  match variable {
    InvocationIdVariable => "INVOCATION_ID" as NonEmptyStr
    ServiceResultVariable => "SERVICE_RESULT" as NonEmptyStr
    ExitCodeVariable => "EXIT_CODE" as NonEmptyStr
    ExitStatusVariable => "EXIT_STATUS" as NonEmptyStr
  }
}

// $SERVICE_RESULT's documented words (systemd.exec(5)). An unlisted word is carried, not dropped:
// a manager newer than this model may add one, and the reader must say so rather than guess.
type ServiceResult
  = ServiceResultSuccess
  | ServiceResultProtocol
  | ServiceResultTimeout
  | ServiceResultExitCode
  | ServiceResultSignal
  | ServiceResultCoreDump
  | ServiceResultWatchdog
  | ServiceResultStartLimitHit
  | ServiceResultResources
  | ServiceResultOomKill
  | ServiceResultUnlisted { word: String }

fn service_result_of_wire(word: String) -> ServiceResult {
  if word == "success" { ServiceResultSuccess }
  else if word == "protocol" { ServiceResultProtocol }
  else if word == "timeout" { ServiceResultTimeout }
  else if word == "exit-code" { ServiceResultExitCode }
  else if word == "signal" { ServiceResultSignal }
  else if word == "core-dump" { ServiceResultCoreDump }
  else if word == "watchdog" { ServiceResultWatchdog }
  else if word == "start-limit-hit" { ServiceResultStartLimitHit }
  else if word == "resources" { ServiceResultResources }
  else if word == "oom-kill" { ServiceResultOomKill }
  else { ServiceResultUnlisted { word: word } }
}

// $EXIT_CODE's documented words. "Exited" carries a numeric status; the other two carry a signal
// name, and the two are different facts -- a process killed by SIGTERM did not exit 15.
type ServiceExitCode
  = ServiceExitCodeExited
  | ServiceExitCodeKilled
  | ServiceExitCodeDumped
  | ServiceExitCodeUnlisted { word: String }

fn service_exit_code_of_wire(word: String) -> ServiceExitCode {
  if word == "exited" { ServiceExitCodeExited }
  else if word == "killed" { ServiceExitCodeKilled }
  else if word == "dumped" { ServiceExitCodeDumped }
  else { ServiceExitCodeUnlisted { word: word } }
}

// ONE PIECE OF A COMMAND-LINE WORD: text the manager passes through unchanged, or a variable it
// substitutes. systemd.service(5), "Command lines": "${FOO}" used as part of a word is replaced by
// the variable's value with no word splitting, which is the form used here; the bare "$FOO" form
// word-splits and is not modeled. Keeping the two pieces apart is what lets the renderer refuse a
// literal that would be read as an expansion, instead of trusting that a string happens not to
// contain one.
type ExecWordPart
  = ExecLiteral { text: String }
  | ExecVariable { variable: ServiceStopVariable }

type ExecWordRendering
  = ExecWordRendered { word: NonEmptyStr }
  | ExecWordRefused { reason: NonEmptyStr }

// A literal is refused, never escaped, when it holds a character the command-line parser would
// treat as syntax: whitespace or a quote (word boundaries), a backslash (escapes), "$" (expansion)
// or "%" (unit specifiers). Escaping would be a second grammar to get right; every literal this
// repository mints is a path or an identifier that has no need of those characters.
fn exec_literal_admissible(text: String) -> Bool {
  !(string_contains(s: text, pattern: " ") || string_contains(s: text, pattern: "\t") || string_contains(s: text, pattern: "\n") || string_contains(s: text, pattern: "\"")
    || string_contains(s: text, pattern: "'") || string_contains(s: text, pattern: "\\") || string_contains(s: text, pattern: "$") || string_contains(s: text, pattern: "%"))
}

fn exec_word_render(parts: List<ExecWordPart>) -> ExecWordRendering {
  let refused = parts |> flat_map(p => match p {
    ExecLiteral { text } => if exec_literal_admissible(text: text) { [] as List<String> } else { [text] }
    ExecVariable { variable: _ } => [] as List<String>
  })
  match refused.first() {
    Present { value: bad } =>
      ExecWordRefused { reason: join(["command-line literal carries a character systemd would read as syntax: ", bad], "") as NonEmptyStr }
    Absent => {
      let word = join(parts |> map(p => match p {
        ExecLiteral { text } => text
        ExecVariable { variable } => join(["${", service_stop_variable_name(variable: variable) as String, "}"], "")
      }), "")
      if string_length(s: word) == 0 {
        ExecWordRefused { reason: "an empty command-line word cannot be spelled to systemd" as NonEmptyStr }
      } else {
        ExecWordRendered { word: word as NonEmptyStr }
      }
    }
  }
}

type ExecCommandLineRendering
  = ExecCommandLineRendered { line: NonEmptyStr }
  | ExecCommandLineRefused { reason: NonEmptyStr }

// AN ARGV AS ONE ExecStart=/ExecStopPost= VALUE. The manager splits the value on whitespace into
// words, the first naming the program, and runs it directly: no shell is involved at any point
// (systemd.service(5), "Command lines"), which is why a typed argv can be handed over at all. Every
// word passes the same admissibility test as a literal part, except that a word rendered from parts
// by exec_word_render may carry the "${...}" its variables were spelled as; that form is re-checked
// below rather than trusted.
fn exec_command_line(command: ArgvCommand) -> ExecCommandLineRendering {
  let words = argv_words(command: command)
  let refused = words |> filter(w => !exec_literal_admissible(text: w) && !exec_word_is_rendered_expansion(word: w))
  match refused.first() {
    Present { value: bad } =>
      ExecCommandLineRefused { reason: join(["argv word carries a character systemd would read as syntax: ", bad], "") as NonEmptyStr }
    Absent => ExecCommandLineRendered { line: join(words, " ") as NonEmptyStr }
  }
}

// AN ARGV WHOSE WORDS MAY ALSO NAME VARIABLES THE UNIT LOADS FROM ITS ENVIRONMENT. systemd substitutes
// "${NAME}" in a command line from Environment= and EnvironmentFile= as well as from its own stop-time
// variables (systemd.service(5), "Command lines"). The caller declares which names its unit loads,
// and a word may carry "${NAME}" only for one of those; the remainder after stripping them must be an
// admissible literal, exactly as exec_word_is_rendered_expansion reads the modeled variables. An
// undeclared name, or a "$" anywhere else, refuses.
fn exec_command_line_with_environment(command: ArgvCommand, environment: List<NonEmptyStr>) -> ExecCommandLineRendering {
  exec_words_line_with_environment(words: argv_words(command: command), environment: environment)
}

fn exec_words_line_with_environment(words: List<String>, environment: List<NonEmptyStr>) -> ExecCommandLineRendering {
  let refused = words |> filter(w => !exec_literal_admissible(text: w) && !exec_word_is_rendered_expansion(word: w)
    && !exec_word_is_environment_reference(word: w, environment: environment))
  match refused.first() {
    Present { value: bad } =>
      ExecCommandLineRefused { reason: join(["argv word carries a character systemd would read as syntax: ", bad], "") as NonEmptyStr }
    Absent => match words.first() {
      Absent => ExecCommandLineRefused { reason: "an empty argv has no program" as NonEmptyStr }
      Present { value: _ } => ExecCommandLineRendered { line: join(words, " ") as NonEmptyStr }
    }
  }
}

fn exec_word_is_environment_reference(word: String, environment: List<NonEmptyStr>) -> Bool {
  let stripped = fold(environment, init: word, f: (acc, name) => replace(acc, join(["$", "{", name as String, "}"], ""), ""))
  stripped != word && exec_literal_admissible(text: stripped)
}

// THE "+" COMMAND-LINE PREFIX, from the special executable prefixes systemd.service(5) documents
// ("Command lines"): it runs that one command with full privileges -- outside the unit's file-system
// namespacing and sandboxing (ProtectSystem=, ProtectHome=, ReadWritePaths= and the rest), while the
// main process keeps them. That is what lets a stop hook write where the unit's own process may not.
// In a user manager "full privileges" are the user's own; the prefix never grants more than the
// manager's principal holds. It is the only prefix this repository uses, so it is one function rather
// than a coproduct of one.
data exec_full_privileges_prefix: String = "+"

fn exec_command_line_full_privileges(command: ArgvCommand) -> ExecCommandLineRendering {
  match exec_command_line(command: command) {
    ExecCommandLineRefused { reason } => ExecCommandLineRefused { reason: reason }
    ExecCommandLineRendered { line } => ExecCommandLineRendered { line: join([exec_full_privileges_prefix, line as String], "") as NonEmptyStr }
  }
}

// A WORD WHOSE ONLY SYNTAX IS "${NAME}" FOR A MODELED VARIABLE. Re-reading the rendered word, not
// trusting a flag beside it: strip every modeled expansion, and the remainder must be an
// admissible literal. A "$" anywhere else -- an unmodeled variable, a bare $FOO -- survives the
// strip and refuses.
fn exec_word_is_rendered_expansion(word: String) -> Bool {
  let stripped = fold(
    [InvocationIdVariable, ServiceResultVariable, ExitCodeVariable, ExitStatusVariable],
    init: word,
    f: (acc, v) => replace(acc, join(["${", service_stop_variable_name(variable: v) as String, "}"], ""), ""),
  )
  stripped != word && exec_literal_admissible(text: stripped)
}

// EXEC-SETUP FAILURES: systemd.exec(5), "Process Exit Codes". When the manager cannot finish
// preparing the child (namespaces, capabilities, user, ...) the child exits with a status from the
// reserved 200-series BEFORE the command's own main() runs, so that status says the command never
// executed. It is not the command's verdict, and a reader that takes any nonzero status for the
// command refusing something merges "never ran" with "ran and was refused".
// Transcribed from the table as published for systemd 255 (the user manager on srv1); statuses the
// table gaps over (223, 234) and anything past EXIT_CREDENTIALS are NOT modeled here, so they are
// absent from this list rather than guessed (DESIGN section 4d): a reader must not treat absence as
// proof the command ran, and a consumer must also require the command's own status.
type ExecSetupFailure = ExecSetupFailure { status: Int, name: NonEmptyStr }

data exec_setup_failures: List<ExecSetupFailure> = [
  ExecSetupFailure { status: 200, name: "EXIT_CHDIR" as NonEmptyStr },
  ExecSetupFailure { status: 201, name: "EXIT_NICE" as NonEmptyStr },
  ExecSetupFailure { status: 202, name: "EXIT_FDS" as NonEmptyStr },
  ExecSetupFailure { status: 203, name: "EXIT_EXEC" as NonEmptyStr },
  ExecSetupFailure { status: 204, name: "EXIT_MEMORY" as NonEmptyStr },
  ExecSetupFailure { status: 205, name: "EXIT_LIMITS" as NonEmptyStr },
  ExecSetupFailure { status: 206, name: "EXIT_OOM_ADJUST" as NonEmptyStr },
  ExecSetupFailure { status: 207, name: "EXIT_SIGNAL_MASK" as NonEmptyStr },
  ExecSetupFailure { status: 208, name: "EXIT_STDIN" as NonEmptyStr },
  ExecSetupFailure { status: 209, name: "EXIT_STDOUT" as NonEmptyStr },
  ExecSetupFailure { status: 210, name: "EXIT_CHROOT" as NonEmptyStr },
  ExecSetupFailure { status: 211, name: "EXIT_IOPRIO" as NonEmptyStr },
  ExecSetupFailure { status: 212, name: "EXIT_TIMERSLACK" as NonEmptyStr },
  ExecSetupFailure { status: 213, name: "EXIT_SECUREBITS" as NonEmptyStr },
  ExecSetupFailure { status: 214, name: "EXIT_SETSCHEDULER" as NonEmptyStr },
  ExecSetupFailure { status: 215, name: "EXIT_CPUAFFINITY" as NonEmptyStr },
  ExecSetupFailure { status: 216, name: "EXIT_GROUP" as NonEmptyStr },
  ExecSetupFailure { status: 217, name: "EXIT_USER" as NonEmptyStr },
  ExecSetupFailure { status: 218, name: "EXIT_CAPABILITIES" as NonEmptyStr },
  ExecSetupFailure { status: 219, name: "EXIT_CGROUP" as NonEmptyStr },
  ExecSetupFailure { status: 220, name: "EXIT_SETSID" as NonEmptyStr },
  ExecSetupFailure { status: 221, name: "EXIT_CONFIRM" as NonEmptyStr },
  ExecSetupFailure { status: 222, name: "EXIT_STDERR" as NonEmptyStr },
  ExecSetupFailure { status: 224, name: "EXIT_PAM" as NonEmptyStr },
  ExecSetupFailure { status: 225, name: "EXIT_NETWORK" as NonEmptyStr },
  ExecSetupFailure { status: 226, name: "EXIT_NAMESPACE" as NonEmptyStr },
  ExecSetupFailure { status: 227, name: "EXIT_NO_NEW_PRIVILEGES" as NonEmptyStr },
  ExecSetupFailure { status: 228, name: "EXIT_SECCOMP" as NonEmptyStr },
  ExecSetupFailure { status: 229, name: "EXIT_SELINUX_CONTEXT" as NonEmptyStr },
  ExecSetupFailure { status: 230, name: "EXIT_PERSONALITY" as NonEmptyStr },
  ExecSetupFailure { status: 231, name: "EXIT_APPARMOR_PROFILE" as NonEmptyStr },
  ExecSetupFailure { status: 232, name: "EXIT_ADDRESS_FAMILIES" as NonEmptyStr },
  ExecSetupFailure { status: 233, name: "EXIT_RUNTIME_DIRECTORY" as NonEmptyStr },
  ExecSetupFailure { status: 235, name: "EXIT_CHOWN" as NonEmptyStr },
  ExecSetupFailure { status: 236, name: "EXIT_SMACK_PROCESS_LABEL" as NonEmptyStr },
  ExecSetupFailure { status: 237, name: "EXIT_KEYRING" as NonEmptyStr },
  ExecSetupFailure { status: 238, name: "EXIT_STATE_DIRECTORY" as NonEmptyStr },
  ExecSetupFailure { status: 239, name: "EXIT_CACHE_DIRECTORY" as NonEmptyStr },
  ExecSetupFailure { status: 240, name: "EXIT_LOGS_DIRECTORY" as NonEmptyStr },
  ExecSetupFailure { status: 241, name: "EXIT_CONFIGURATION_DIRECTORY" as NonEmptyStr },
  ExecSetupFailure { status: 242, name: "EXIT_NUMA_POLICY" as NonEmptyStr },
  ExecSetupFailure { status: 243, name: "EXIT_CREDENTIALS" as NonEmptyStr },
]

fn exec_setup_failure_of_status(status: Int) -> Optional<ExecSetupFailure> {
  list_find_first(xs: exec_setup_failures, predicate: fn(row) { row.status == status })
}
