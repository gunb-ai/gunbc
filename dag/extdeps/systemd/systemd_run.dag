module extdeps.systemd.systemd_run

import std.types { NonEmptyStr, List, Bool, Int, Unit }
import std.nat { Nat }
import std.measure { ByteSize, byte_size }
import std.algebra { trim }
import std.string_type { String }

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.systemd { SystemdUnitProperty, systemd_unit_property_wire }

type SystemdRunProperty {
  property: SystemdUnitProperty,
  value: NonEmptyStr,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.freedesktop.org/software/systemd/man/latest/systemd-run.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.systemd.systemd_run",
      decl_name: "systemd.SystemdRun",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data systemd_run_authority: ExternalAuthority = extdeps_external_authority_anchor

// THE PROPERTY WORDS ARE RENDERED IN EXACTLY ONE PLACE, and that is the whole point of this
// function existing beside the full-line authority rather than inside it. A systemd unit property
// becomes an argv word here and nowhere else, so the operation's transport, the pure authority and
// every caller are reading one spelling. The transport CANNOT carry the typed record itself:
// push_shell_argv_tokens has arms for Str, List, ProcessArgvExpansion and a refusing arm for
// ambiguous free monoids, and a record reaches none of them — it lands in the catch-all, which
// Display-formats the value into a single argv word rather than refusing. So a record spliced into
// argv would hand systemd-run a fabricated argument at the exact seam that decides whether a unit
// is bounded. The typed population stays on this side of that boundary; only words cross it.
fn systemd_run_property_argv(properties: List<SystemdRunProperty>) -> List<String> {
  fold(
    properties,
    init: [],
    f: (acc, setting) => list_push(
      acc,
      concat(
        "--property=",
        concat(systemd_unit_property_wire(property: setting.property) as String, concat("=", setting.value as String)),
      ),
    ),
  )
}

// THE USER-MANAGER TRANSIENT UNIT, modelled beside the system-scope one above because the flags
// systemd-run actually accepts are upstream's, not ours: --user selects the calling user's manager,
// -p sets a unit property, and --setenv binds one environment variable in the started unit.
//
// NO --collect HERE, DELIBERATELY, and it is the difference that makes this worth a second
// function. --collect unloads the unit as soon as it exits, which discards Result and
// ExecMainStatus -- exactly the terminal state a caller starts a transient unit in order to be able
// to read afterwards. A unit that lingers in `failed` is evidence; one that was garbage collected
// is an absence indistinguishable from never having run. Callers that want no residue name a unit
// per attempt and reset it explicitly, which is a decision about evidence rather than a flag.
fn systemd_run_user_transient_arguments(
  unit: NonEmptyStr,
  properties: List<String>,
  setenv_bindings: List<String>,
  command_argv: List<String>,
) -> List<String> {
  let head = ["--user", concat("--unit=", unit as String)]
  let with_properties = fold(
    properties,
    init: head,
    f: (acc, p) => list_push(list_push(acc, "-p"), p),
  )
  let with_env = fold(
    setenv_bindings,
    init: with_properties,
    f: (acc, b) => list_push(acc, concat("--setenv=", b)),
  )
  fold(
    command_argv,
    init: list_push(with_env, "--"),
    f: (acc, arg) => list_push(acc, arg),
  )
}

// THE SYNCHRONOUS FORM: the caller blocks until the unit exits and receives its exit status and its
// stdio (`--wait --pipe`), so a build or a check runs under the unit's resource bounds while the
// process that asked for it observes the result directly. `--collect` unloads the unit afterwards
// whatever its result, so a failed compute unit does not accumulate as a failed unit to reap.
fn systemd_run_user_wait_arguments(
  unit: NonEmptyStr,
  properties: List<String>,
  setenv_bindings: List<String>,
  command_argv: List<String>,
) -> List<String> {
  concat(["--wait", "--pipe", "--collect"], systemd_run_user_transient_arguments(unit: unit, properties: properties, setenv_bindings: setenv_bindings, command_argv: command_argv))
}

fn systemd_run_property(name: String, value: String) -> String {
  join([name, "=", value], "")
}

// The full invocation, and the authority the materialized operation argv is checked against. It
// COMPOSES the property words rather than re-deriving them; if this fold and the transport template
// ever disagree about word order, systemd_run_transient_operation_argv_matches_authority goes red.
fn systemd_run_transient_unit_argv(unit: NonEmptyStr, properties: List<SystemdRunProperty>, command_argv: List<String>) -> List<String> {
  let launcher = ["systemd-run", concat("--unit=", unit as String), "--collect"]
  let with_properties = fold(systemd_run_property_argv(properties: properties), init: launcher, f: (acc, word) => list_push(acc, word))
  let with_separator = list_push(with_properties, "--")
  fold(command_argv, init: with_separator, f: (acc, arg) => list_push(acc, arg))
}

// Waiting is a different operation from starting. It owns the complete wait/quiet/collect
// vocabulary and returns the process status as data: a nonzero child status is an observation,
// not an operation refusal. Default transient service semantics are deliberate. Type=oneshot is
// excluded because it collapses normal nonzero statuses to 1 (systemd issue 22812, observed on
// systemd 245 / 245.4-4ubuntu3.15); the same report establishes that signal death is not reliably
// recoverable as an exact child status through this boundary.
fn systemd_run_transient_wait_unit_argv(unit: NonEmptyStr, properties: List<SystemdRunProperty>, command_argv: List<String>) -> List<String> {
  let launcher = ["systemd-run", concat("--unit=", unit as String), "--wait", "--quiet", "--collect"]
  let with_properties = fold(systemd_run_property_argv(properties: properties), init: launcher, f: (acc, word) => list_push(acc, word))
  let with_separator = list_push(with_properties, "--")
  fold(command_argv, init: with_separator, f: (acc, arg) => list_push(acc, arg))
}


// RunTransient AND RunTransientRetained DIFFER BY --collect AND THAT IS A DECISION ABOUT EVIDENCE.
//
// The argument is already made in this file for the user-manager variant and it holds identically
// here: --collect unloads the unit the moment it exits, which discards Result, ExecMainStatus and
// the unit's Environment -- exactly the terminal state a caller starts a transient unit in order to
// read afterwards. A unit lingering in `failed` IS the evidence; a collected one is an absence
// indistinguishable from never having run, and a caller reading an exit status through it gets a
// fabricated number.
//
// SO THE CHOICE IS THE CALLER'S AND IT IS NAMED. A fire-and-forget start that nobody will interrogate
// keeps --collect and leaves no residue. A caller that must later say WHY the unit ended, or which
// attempt it was started for, takes the retained form and owes an explicit reset of the unit when it
// is done with it -- gunbc.runner_microvm_lifecycle_realize does exactly that after its teardown
// readbacks. Making it a flag on one operation would have hidden that obligation.
service systemd.SystemdRun {
  operation RunTransient {
    input { unit: NonEmptyStr, property_argv: List<String>, command_argv: List<String> }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemd-run", "--unit={unit}", "--collect", property_argv, "--", command_argv] }
    exit {
      0 => Unit
      nonzero => String "systemd-run transient unit start failed"
    }
    mock_response {
      0 => { success: true, stdout: "Running as unit: demo.service", stderr: "" } "hermetic systemd.SystemdRun.RunTransient"
    }
  }


  operation RunTransientRetained {
    input { unit: NonEmptyStr, property_argv: List<String>, command_argv: List<String> }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemd-run", "--unit={unit}", property_argv, "--", command_argv] }
    exit {
      0 => Unit
      nonzero => String "systemd-run transient unit start failed"
    }
    mock_response {
      0 => { success: true, stdout: "Running as unit: demo.service", stderr: "" } "hermetic systemd.SystemdRun.RunTransientRetained"
    }
  }

  operation RunTransientAndWait {
    input { unit: NonEmptyStr, property_argv: List<String>, command_argv: List<String> }
    output {
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemd-run", "--unit={unit}", "--wait", "--quiet", "--collect", property_argv, "--", command_argv] }
    exit {
      0 => Unit
      nonzero => Unit
    }
  }
}

// ── WHAT `systemd-run --wait` REPORTS WHEN THE UNIT ENDS ──────────────────────────────────────
//
// THE SUMMARY IS THE ONLY INSTANT THE UNIT'S OWN PEAK AND RESULT ARE STILL READABLE, and that is why
// it is modeled rather than a property read afterwards. A `--wait --collect` transient unit is
// garbage-collected when it ends, so `systemctl show -p MemoryPeak` after the launcher returns
// answers for a unit the manager no longer has, and the cgroup whose memory.peak it mirrors is gone
// with it. systemd-run itself reads Result and MemoryPeak off the unit over D-Bus before it exits
// and logs them to stderr, unless --quiet was passed (src/run/run.c at v255, `if (arg_wait &&
// !arg_quiet)`): "Finished with result: <result>" when the result is non-empty, and "Memory peak:
// <FORMAT_BYTES>" when MemoryPeak is not UINT64_MAX. MemoryPeak itself arrives in v254
// (extdeps.systemd.systemctl systemd_memory_peak_minimum_version), and an older manager simply
// omits the line -- so ABSENCE IS A READING, and it is never a peak of zero.
//
// WHY THE LAST LINE AND NOT THE FIRST. Under --pipe the unit's own stderr and the launcher's summary
// arrive on one stream. The summary is written after the unit has ended and the pipe has drained,
// so it is the TAIL; a command that happens to print "Memory peak: 1K" on its own stderr prints it
// BEFORE the summary. Taking the last occurrence of each prefix is what that ordering entitles.
// It is an ordering fact about the launcher, stated here so a reader can falsify it.

// systemd.exec(5) "$SERVICE_RESULT": the closed vocabulary a service's Result property takes.
type SystemdServiceResult
  = ServiceResultSuccess
  | ServiceResultProtocol
  | ServiceResultTimeout
  | ServiceResultExitCode
  | ServiceResultSignal
  | ServiceResultCoreDump
  | ServiceResultWatchdog
  | ServiceResultStartLimitHit
  | ServiceResultResources
  | ServiceResultOomKill

fn systemd_service_result_wire(r: SystemdServiceResult) -> String {
  match r {
    ServiceResultSuccess => "success"
    ServiceResultProtocol => "protocol"
    ServiceResultTimeout => "timeout"
    ServiceResultExitCode => "exit-code"
    ServiceResultSignal => "signal"
    ServiceResultCoreDump => "core-dump"
    ServiceResultWatchdog => "watchdog"
    ServiceResultStartLimitHit => "start-limit-hit"
    ServiceResultResources => "resources"
    ServiceResultOomKill => "oom-kill"
  }
}

type SystemdServiceResultReading
  = ServiceResultRead { result: SystemdServiceResult }
  | ServiceResultUnrecognized { wire: String }
  | ServiceResultNotReported

fn systemd_service_result_parse(wire: String) -> SystemdServiceResultReading {
  let w = trim(s: wire)
  if w == "success" { ServiceResultRead { result: ServiceResultSuccess } }
  else if w == "protocol" { ServiceResultRead { result: ServiceResultProtocol } }
  else if w == "timeout" { ServiceResultRead { result: ServiceResultTimeout } }
  else if w == "exit-code" { ServiceResultRead { result: ServiceResultExitCode } }
  else if w == "signal" { ServiceResultRead { result: ServiceResultSignal } }
  else if w == "core-dump" { ServiceResultRead { result: ServiceResultCoreDump } }
  else if w == "watchdog" { ServiceResultRead { result: ServiceResultWatchdog } }
  else if w == "start-limit-hit" { ServiceResultRead { result: ServiceResultStartLimitHit } }
  else if w == "resources" { ServiceResultRead { result: ServiceResultResources } }
  else if w == "oom-kill" { ServiceResultRead { result: ServiceResultOomKill } }
  else { ServiceResultUnrecognized { wire: w } }
}

// A FORMAT_BYTES READING IS AN INTERVAL, NOT A NUMBER. format_bytes (src/basic/format-util.h, v255)
// is format_bytes_full with USE_IEC | BELOW_POINT | TRAILING_B: below 1024 it prints the exact count
// with a trailing "B"; otherwise the largest 1024-power suffix K/M/G/T/P/E with the whole part and
// ONE TRUNCATED tenth, and no "B". The tenth is computed as floor(floor(t / F') * 10 / 1024) mod 10
// with F' the next-smaller factor, which can read one tenth LOW, so the only sound upper bound for
// a printed W.d of factor F is (10W + d + 2) * F / 10. A capacity reading must carry the upper
// bound; carrying the printed figure would size a grant below the peak that produced it.
type SystemdFormattedBytes
  = FormattedBytesExact { bytes: ByteSize }
  | FormattedBytesBounded { printed: String, lower: ByteSize, upper: ByteSize }

type SystemdFormattedBytesReading
  = FormattedBytesRead { value: SystemdFormattedBytes }
  | FormattedBytesUnparseable { text: String }

fn systemd_iec_suffix_factor(suffix: String) -> Nat? {
  if suffix == "K" { Present { value: 1024 } }
  else if suffix == "M" { Present { value: 1048576 } }
  else if suffix == "G" { Present { value: 1073741824 } }
  else if suffix == "T" { Present { value: 1099511627776 } }
  else if suffix == "P" { Present { value: 1125899906842624 } }
  else if suffix == "E" { Present { value: 1152921504606846976 } }
  else { none }
}

fn systemd_formatted_bytes_parse(text: String) -> SystemdFormattedBytesReading {
  let t = trim(s: text)
  let n = string_length(s: t)
  if n < 2 {
    FormattedBytesUnparseable { text: t }
  } else {
    let suffix = substring(s: t, start: n - 1, end: n)
    let body = substring(s: t, start: 0, end: n - 1)
    if suffix == "B" {
      match parse_int(s: body) {
        Present { value: v } => if v < 0 { FormattedBytesUnparseable { text: t } } else { FormattedBytesRead { value: FormattedBytesExact { bytes: byte_size(count: v) } } }
        Absent => FormattedBytesUnparseable { text: t }
      }
    } else {
      match systemd_iec_suffix_factor(suffix: suffix) {
        Absent => FormattedBytesUnparseable { text: t }
        Present { value: factor } =>
          match split(body, ".") {
            Cons { head: whole_text, tail: rest } =>
              match rest {
                Cons { head: tenth_text, tail: more } =>
                  match more {
                    Cons { head: _, tail: _ } => FormattedBytesUnparseable { text: t }
                    Empty {} =>
                      match parse_int(s: whole_text) {
                        Absent => FormattedBytesUnparseable { text: t }
                        Present { value: w } =>
                          match parse_int(s: tenth_text) {
                            Absent => FormattedBytesUnparseable { text: t }
                            Present { value: d } =>
                              if w < 0 || d < 0 || d > 9 || string_length(s: tenth_text) != 1 {
                                FormattedBytesUnparseable { text: t }
                              } else {
                                FormattedBytesRead { value: FormattedBytesBounded {
                                  printed: t,
                                  lower: byte_size(count: (w * 10 + d) * factor / 10),
                                  upper: byte_size(count: ((w * 10 + d + 2) * factor + 9) / 10),
                                } }
                              }
                          }
                      }
                  }
                Empty {} => FormattedBytesUnparseable { text: t }
              }
            Empty {} => FormattedBytesUnparseable { text: t }
          }
      }
    }
  }
}

fn systemd_formatted_bytes_upper(b: SystemdFormattedBytes) -> ByteSize {
  match b {
    FormattedBytesExact { bytes } => bytes
    FormattedBytesBounded { printed: _, lower: _, upper } => upper
  }
}

type SystemdMemoryPeakReading
  = MemoryPeakRead { peak: SystemdFormattedBytes }
  | MemoryPeakUnparseable { text: String }
  | MemoryPeakNotReported

type SystemdRunWaitSummary {
  result: SystemdServiceResultReading
  memory_peak: SystemdMemoryPeakReading
}

data systemd_run_summary_result_prefix: String = "Finished with result: "
data systemd_run_summary_memory_peak_prefix: String = "Memory peak: "

fn systemd_run_summary_last_value(stderr: String, prefix: String) -> String? {
  fold(split(stderr, "\n"), init: none, f: (acc, line) =>
    if starts_with(s: line, prefix: prefix) {
      Present { value: substring(s: line, start: string_length(s: prefix), end: string_length(s: line)) }
    } else { acc })
}

fn systemd_run_wait_summary(stderr: String) -> SystemdRunWaitSummary {
  SystemdRunWaitSummary {
    result: match systemd_run_summary_last_value(stderr: stderr, prefix: systemd_run_summary_result_prefix) {
      Present { value: v } => systemd_service_result_parse(wire: v)
      Absent => ServiceResultNotReported
    },
    memory_peak: match systemd_run_summary_last_value(stderr: stderr, prefix: systemd_run_summary_memory_peak_prefix) {
      Present { value: v } =>
        match systemd_formatted_bytes_parse(text: v) {
          FormattedBytesRead { value: b } => MemoryPeakRead { peak: b }
          FormattedBytesUnparseable { text: x } => MemoryPeakUnparseable { text: x }
        }
      Absent => MemoryPeakNotReported
    },
  }
}
