module extdeps.systemd.systemctl

import std.types { NonEmptyStr, String, List, Bool, Int }
import extdeps.systemd { SystemdUnitProperty, systemd_unit_property_wire }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.freedesktop.org/software/systemd/man/latest/systemctl.html"
  }
}

data systemctl_authority: ExternalAuthority = extdeps_external_authority_anchor

fn systemctl_daemon_reload_argv() -> List<String> {
  ["systemctl", "daemon-reload"]
}

fn systemctl_enable_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "enable", unit as String]
}

fn systemctl_restart_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "restart", unit as String]
}

fn systemctl_disable_now_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "disable", "--now", unit as String]
}

fn systemctl_stop_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "stop", unit as String]
}

fn systemctl_set_property_argv(unit: NonEmptyStr, property: NonEmptyStr, value: NonEmptyStr) -> List<String> {
  [
    "systemctl",
    "set-property",
    unit as String,
    concat(property as String, concat("=", value as String)),
  ]
}

fn systemctl_revert_memory_caps_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "revert", unit as String, "MemoryMax", "MemoryHigh"]
}

fn systemctl_show_property_argv(unit: NonEmptyStr, property: SystemdUnitProperty) -> List<String> {
  [
    "systemctl",
    "show",
    unit as String,
    concat("--property=", systemd_unit_property_wire(property: property) as String),
    "--value",
  ]
}

// LoadState is a non-numeric unit lifecycle observation, so it has its own argv authority rather than joining SystemdUnitProperty, whose shared ShowProperty mock is numeric cgroup evidence. systemctl show exits nonzero on an unreadable manager; the load-state wire value not-found is the only observation that proves an absent unit.
// `is-enabled` answers the INSTALL state (whether the unit is wanted by a target), which is a
// different question from `is-active` (whether it is running now) and from LoadState (whether the
// manager could parse a unit file for it). A unit can be loaded and active yet not enabled, and
// would then not come back after a reboot -- so a convergence claim that reads only is-active is
// answering a question it was not asked.
fn systemctl_is_enabled_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "is-enabled", unit as String]
}

fn systemctl_user_is_enabled_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "--user", "is-enabled", unit as String]
}

// `is-active` answers whether the unit is RUNNING NOW, which is the fact `is-enabled` does not carry
// and cannot be derived from. Both directions are real: an enabled unit can be dead, and a running
// unit can be disabled and vanish at the next boot.
fn systemctl_user_is_active_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "--user", "is-active", unit as String]
}

// Enable and start are SEPARATE OPERATIONS, deliberately not `enable --now`. The fused form applies
// two remedies under one word, so a plan that needed only one of them pays for both, and -- worse --
// the two facts stop being separately observable in the actuation the way they are separately
// observable on the host.
fn systemctl_user_enable_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "--user", "enable", unit as String]
}

fn systemctl_user_start_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "--user", "start", unit as String]
}

fn systemctl_show_load_state_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "show", unit as String, "--property=LoadState", "--value"]
}

fn systemctl_status_argv(unit: NonEmptyStr) -> List<String> {
  ["systemctl", "status", "--no-pager", "--full", unit as String]
}

type UnitFileState
  = UnitEnabled
  | UnitEnabledRuntime
  | UnitLinked
  | UnitMasked
  | UnitStatic
  | UnitDisabled
  | UnitIndirect
  | UnitGenerated
  | UnitTransient
  | UnitBad

service systemd.Systemctl {
  operation Enable {
    input { unit: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "enable", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl enable failed"
    }
  }

  operation Restart {
    input { unit: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "restart", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl restart failed"
    }
  }

  operation DisableNow {
    input { unit: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "disable", "--now", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl disable --now failed"
    }
  }

  operation Start {
    input { unit: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "start", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl start failed"
    }
  }

  operation Stop {
    input { unit: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "stop", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl stop failed"
    }
    mock_response {
      0 => { success: true, stdout: "", stderr: "" } "hermetic systemd.Systemctl.Stop"
    }
  }

  operation SetProperty {
    input { unit: NonEmptyStr, property: NonEmptyStr, value: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "set-property", "{unit}", "{property}={value}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl set-property failed"
    }
    mock_response {
      0 => { success: true, stderr: "" } "hermetic systemd.Systemctl.SetProperty"
    }
  }

  operation RevertMemoryCaps {
    input { unit: NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "revert", "{unit}", "MemoryMax", "MemoryHigh"] }
    exit {
      0 => Unit
      nonzero => String "systemctl revert MemoryMax MemoryHigh failed"
    }
    mock_response {
      0 => { success: true, stderr: "" } "hermetic systemd.Systemctl.RevertMemoryCaps"
    }
  }

  operation DaemonReload {
    input {}
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "daemon-reload"] }
    exit {
      0 => Unit
      nonzero => String "systemctl daemon-reload failed"
    }
  }

  operation IsActive {
    input { unit: NonEmptyStr }
    output {
      state: String from "stdout"
      active: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["systemctl", "is-active", "{unit}"] }
    exit {
      0 => Unit
      3 => Unit "unit is not active"
      nonzero => String "systemctl is-active failed"
    }
    mock_response {
      0 => { state: "active", active: true } "hermetic systemd.Systemctl.IsActive active"
    }
  }

  operation ShowProperty {
    input { unit: NonEmptyStr, property: SystemdUnitProperty }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["systemctl", "show", "{unit}", "--property={property}", "--value"] }
    exit {
      0 => Unit
      nonzero => String "systemctl show failed"
    }
    mock_response {
      0 => { value: "8589934592", success: true } "hermetic systemd.Systemctl.ShowProperty"
    }
  }

  operation ListUnits {
    input {
      pattern: NonEmptyStr,
      unit_type: String = "service",
      state: String = "active",
    }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell {
      argv: [
        "systemctl",
        "list-units",
        "--type={unit_type}",
        "--state={state}",
        "--no-legend",
        "--plain",
        "{pattern}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "systemctl list-units failed"
    }
    mock_response {
      0 => {
        stdout: "actions-runner@srv3-01.service loaded active running GitHub Actions Runner\nactions-runner@srv3-02.service loaded active running GitHub Actions Runner\n",
        success: true,
      } "hermetic systemd.Systemctl.ListUnits (multi-column rows — consumer must take first field only)"
    }
  }

  operation Status {
    input { unit: NonEmptyStr }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["systemctl", "status", "--no-pager", "--full", "{unit}"] }
    exit {
      0 => Unit
      1 => Unit "unit dead, pid file remains (LSB init-script code)"
      2 => Unit "unit dead, lock file remains (LSB init-script code)"
      3 => Unit "unit not running (LSB init-script code)"
      4 => Unit "unit status unknown (LSB init-script code)"
      nonzero => String "systemctl status failed"
    }
    mock_response {
      0 => {
        stdout: "● demo.service - Demo\n     Loaded: loaded\n     Active: active (running)",
        success: true,
      } "hermetic systemd.Systemctl.Status active"
    }
  }
}
