module extdeps.systemd.systemctl

data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.freedesktop.org/software/systemd/man/latest/systemctl.html"
  }
}

data systemctl_authority: extdeps.external_authority.ExternalAuthority = extdeps.systemd.systemctl.extdeps_external_authority_anchor

fn systemctl_daemon_reload_argv() -> std.types.List<String> {
  ["systemctl", "daemon-reload"]
}

fn systemctl_enable_argv(unit: std.types.NonEmptyStr) -> std.types.List<String> {
  ["systemctl", "enable", unit as String]
}

fn systemctl_restart_argv(unit: std.types.NonEmptyStr) -> std.types.List<String> {
  ["systemctl", "restart", unit as String]
}

fn systemctl_disable_now_argv(unit: std.types.NonEmptyStr) -> std.types.List<String> {
  ["systemctl", "disable", "--now", unit as String]
}

fn systemctl_stop_argv(unit: std.types.NonEmptyStr) -> std.types.List<String> {
  ["systemctl", "stop", unit as String]
}

fn systemctl_set_property_argv(unit: std.types.NonEmptyStr, property: std.types.NonEmptyStr, value: std.types.NonEmptyStr) -> std.types.List<String> {
  [
    "systemctl",
    "set-property",
    unit as String,
    concat(property as String, concat("=", value as String)),
  ]
}

fn systemctl_revert_memory_caps_argv(unit: std.types.NonEmptyStr) -> std.types.List<String> {
  ["systemctl", "revert", unit as String, "MemoryMax", "MemoryHigh"]
}

fn systemctl_show_property_argv(unit: std.types.NonEmptyStr, property: extdeps.systemd.SystemdUnitProperty) -> std.types.List<String> {
  [
    "systemctl",
    "show",
    unit as String,
    concat("--property=", extdeps.systemd.systemd_unit_property_wire(property: property) as String),
    "--value",
  ]
}

// LoadState is a non-numeric unit lifecycle observation, so it has its own argv authority rather than joining SystemdUnitProperty, whose shared ShowProperty mock is numeric cgroup evidence. systemctl show exits nonzero on an unreadable manager; the load-state wire value not-found is the only observation that proves an absent unit.
fn systemctl_show_load_state_argv(unit: std.types.NonEmptyStr) -> std.types.List<String> {
  ["systemctl", "show", unit as String, "--property=LoadState", "--value"]
}

fn systemctl_status_argv(unit: std.types.NonEmptyStr) -> std.types.List<String> {
  ["systemctl", "status", "--no-pager", "--full", unit as String]
}

type UnitFileState
  = UnitEnabled
  | UnitEnabledRuntime
  | UnitLinked
  | UnitMasked
  | UnitStatic
  | UnitDisabled
  | UnitIndirect
  | UnitGenerated
  | UnitTransient
  | UnitBad

service systemd.Systemctl {
  operation Enable {
    input { unit: std.types.NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "enable", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl enable failed"
    }
  }

  operation Restart {
    input { unit: std.types.NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "restart", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl restart failed"
    }
  }

  operation DisableNow {
    input { unit: std.types.NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "disable", "--now", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl disable --now failed"
    }
  }

  operation Start {
    input { unit: std.types.NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "start", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl start failed"
    }
  }

  operation Stop {
    input { unit: std.types.NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "stop", "{unit}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl stop failed"
    }
    mock_response {
      0 => { success: true, stdout: "", stderr: "" } "hermetic systemd.Systemctl.Stop"
    }
  }

  operation SetProperty {
    input { unit: std.types.NonEmptyStr, property: std.types.NonEmptyStr, value: std.types.NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "set-property", "{unit}", "{property}={value}"] }
    exit {
      0 => Unit
      nonzero => String "systemctl set-property failed"
    }
    mock_response {
      0 => { success: true, stderr: "" } "hermetic systemd.Systemctl.SetProperty"
    }
  }

  operation RevertMemoryCaps {
    input { unit: std.types.NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "revert", "{unit}", "MemoryMax", "MemoryHigh"] }
    exit {
      0 => Unit
      nonzero => String "systemctl revert MemoryMax MemoryHigh failed"
    }
    mock_response {
      0 => { success: true, stderr: "" } "hermetic systemd.Systemctl.RevertMemoryCaps"
    }
  }

  operation DaemonReload {
    input {}
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["systemctl", "daemon-reload"] }
    exit {
      0 => Unit
      nonzero => String "systemctl daemon-reload failed"
    }
  }

  operation IsActive {
    input { unit: std.types.NonEmptyStr }
    output {
      state: String from "stdout"
      active: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["systemctl", "is-active", "{unit}"] }
    exit {
      0 => Unit
      3 => Unit "unit is not active"
      nonzero => String "systemctl is-active failed"
    }
    mock_response {
      0 => { state: "active", active: true } "hermetic systemd.Systemctl.IsActive active"
    }
  }

  operation ShowProperty {
    input { unit: std.types.NonEmptyStr, property: extdeps.systemd.SystemdUnitProperty }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["systemctl", "show", "{unit}", "--property={property}", "--value"] }
    exit {
      0 => Unit
      nonzero => String "systemctl show failed"
    }
    mock_response {
      0 => { value: "8589934592", success: true } "hermetic systemd.Systemctl.ShowProperty"
    }
  }

  operation ListUnits {
    input {
      pattern: std.types.NonEmptyStr,
      unit_type: String = "service",
      state: String = "active",
    }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell {
      argv: [
        "systemctl",
        "list-units",
        "--type={unit_type}",
        "--state={state}",
        "--no-legend",
        "--plain",
        "{pattern}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "systemctl list-units failed"
    }
    mock_response {
      0 => {
        stdout: "actions-runner@srv3-01.service loaded active running GitHub Actions Runner\nactions-runner@srv3-02.service loaded active running GitHub Actions Runner\n",
        success: true,
      } "hermetic systemd.Systemctl.ListUnits (multi-column rows — consumer must take first field only)"
    }
  }

  operation Status {
    input { unit: std.types.NonEmptyStr }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["systemctl", "status", "--no-pager", "--full", "{unit}"] }
    exit {
      0 => Unit
      1 => Unit "unit dead, pid file remains (LSB init-script code)"
      2 => Unit "unit dead, lock file remains (LSB init-script code)"
      3 => Unit "unit not running (LSB init-script code)"
      4 => Unit "unit status unknown (LSB init-script code)"
      nonzero => String "systemctl status failed"
    }
    mock_response {
      0 => {
        stdout: "● demo.service - Demo\n     Loaded: loaded\n     Active: active (running)",
        success: true,
      } "hermetic systemd.Systemctl.Status active"
    }
  }
}
