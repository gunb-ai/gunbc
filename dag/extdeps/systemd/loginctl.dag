module extdeps.systemd.loginctl

import std.types { NonEmptyStr, String, List, Int }
import std.algebra { trim, string_contains }
import extdeps.exec.program { ProgramIdentity, uncataloged_program }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.systemd { systemd_binary_path }

// loginctl is systemd's login-manager client, governed by the same upstream as systemctl but
// documented as its own command with its own verb set, so it gets its own module rather than more
// rows on systemctl's: they are independently documented surfaces of one project, and a verb added
// to one is not a verb on the other.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.freedesktop.org/software/systemd/man/latest/loginctl.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.systemd.loginctl",
      decl_name: "loginctl_binary_name",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data loginctl_authority: ExternalAuthority = extdeps_external_authority_anchor

data loginctl_binary_name: NonEmptyStr = "loginctl" as NonEmptyStr

fn loginctl_binary_path() -> NonEmptyStr {
  systemd_binary_path(name: loginctl_binary_name)
}

// enable-linger TAKES ITS SUBJECT, and the argument is not optional in any use this repository has.
// Upstream defaults the subject to the calling user when omitted, which is exactly why omission is
// dangerous here: a sudoers grant written without the subject authorizes `loginctl enable-linger`
// for the grantee to run as root, and root's own linger is not what the grant was for. The
// parameter is required so the subject cannot be dropped by forgetting it.
data loginctl_enable_linger_verb: NonEmptyStr = "enable-linger" as NonEmptyStr

fn loginctl_enable_linger_argv(subject: NonEmptyStr) -> List<String> {
  [loginctl_binary_name as String, loginctl_enable_linger_verb as String, subject as String]
}

// The same command rendered for a sudoers Cmnd_Spec: absolute path, same verb, same subject. It is
// this function and loginctl_enable_linger_argv that must not be able to disagree, which is why
// both fold the same three rows rather than each spelling the command.
fn loginctl_enable_linger_command(subject: NonEmptyStr) -> NonEmptyStr {
  join([
    loginctl_binary_path() as String,
    " ", loginctl_enable_linger_verb as String,
    " ", subject as String,
  ], "") as NonEmptyStr
}

// show-user READS THE LINGER PROPERTY OF ONE ACCOUNT, the record enable-linger writes. loginctl(1): show-user
// prints the user's properties as Key=value lines; --property= restricts them; Linger is "yes" or "no". An
// account logind holds no record of (no session, not lingering) is refused with "is not logged in or lingering",
// which is a reading of not-lingering, not an unreadable answer. Unelevated: logind answers it for any caller.
data loginctl_show_user_verb: NonEmptyStr = "show-user" as NonEmptyStr

// PATH-resolved, as systemctl_path_resolved_program is: the invoking host's layout is unobserved.
fn loginctl_path_resolved_program() -> ProgramIdentity = uncataloged_program(invocation: loginctl_binary_name as String)

fn loginctl_show_user_linger_command(subject: NonEmptyStr) -> ArgvCommand {
  argv_command(program: loginctl_path_resolved_program(), arguments: [loginctl_show_user_verb as String, subject as String, "--property=Linger"])
}

type LoginctlLingerReading
  = LoginctlLingerEnabled
  | LoginctlLingerDisabled
  | LoginctlLingerUnread { cause: String }

fn loginctl_linger_reading(exit_code: Int, stdout: String, stderr: String) -> LoginctlLingerReading {
  let line = trim(s: stdout)
  if exit_code == 0 && line == "Linger=yes" {
    LoginctlLingerEnabled
  } else if exit_code == 0 && line == "Linger=no" {
    LoginctlLingerDisabled
  } else if exit_code != 0 && string_contains(s: stderr, pattern: "is not logged in or lingering") {
    LoginctlLingerDisabled
  } else {
    LoginctlLingerUnread { cause: join(["loginctl show-user exit ", to_string(value: exit_code), ": stdout=", line, " stderr=", trim(s: stderr)], "") }
  }
}
