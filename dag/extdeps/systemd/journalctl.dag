module extdeps.systemd.journalctl

import std.types { NonEmptyStr, String, Bool }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/journalctl.1.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.systemd.journalctl",
      decl_name: "systemd.Journalctl",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// UnitLog reads the raw journal, unfiltered. Filtering for a specific marker line
// (gunbc.host_hygiene_liveness_observe's "Listening for Jobs" scan) and computing
// freshness are pure .dag folds over stdout, not a second grep/tail spliced into the
// argv — the piped `journalctl -u X | grep -F ... | tail -1` shell body this operation
// replaces did in one hand-written string what the typed model now does as two named,
// independently testable functions over one typed read.
service systemd.Journalctl {
  operation UnitLog {
    input { unit: NonEmptyStr }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["journalctl", "-u", "{unit}", "--no-pager", "-o", "short-unix"] }
    exit {
      0 => Unit
      nonzero => String "journalctl failed"
    }
    mock_response {
      0 => {
        stdout: "1734000000.000000 srv1 actions-runner[1234]: Listening for Jobs\n",
        success: true,
      } "hermetic systemd.Journalctl.UnitLog"
    }
  }
}

data journalctl_program: NonEmptyStr = "journalctl" as NonEmptyStr

// THE UNIT'S OWN OUTPUT, BARE. `-o cat` prints message bodies only, so a reader looking for a marker
// line the process printed (gunbc.runner_guest_image guest_console_observations over a VMM's serial
// console forwarded to the journal) matches the line the process wrote and not the journal's prefix.
// `--no-pager` because there is no terminal; the read is a command, not a session.
fn journalctl_unit_messages_command(unit: NonEmptyStr) -> ArgvCommand {
  argv_command(program: journalctl_program, arguments: ["-u", unit as String, "--no-pager", "-o", "cat"])
}
