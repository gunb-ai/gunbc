data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.systemd.journalctl",
      decl_name: "systemd.Journalctl",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [journal_fields_authority]
}

// UnitLog reads the raw journal, unfiltered. Filtering for a specific marker line
// (gunbc.host_hygiene_liveness_observe's "Listening for Jobs" scan) and computing
// freshness are pure .dag folds over stdout, not a second grep/tail spliced into the
// argv — the piped `journalctl -u X | grep -F ... | tail -1` shell body this operation
// replaces did in one hand-written string what the typed model now does as two named,
// independently testable functions over one typed read.
// UnitInvocationLog READS ONE INVOCATION OF A UNIT, NOT EVERY INVOCATION THAT EVER CARRIED ITS NAME.
// journalctl(1): a FIELD=VALUE match restricts output to entries carrying that field, and matches on
// DIFFERENT fields are ANDed with -u. systemd.journal-fields(7): _SYSTEMD_INVOCATION_ID is "the
// invocation ID for the runtime cycle of the unit the message was generated in", a trusted field the
// journal daemon adds, not one the logging process can set. (man7.org, read 2026-09-23.)
service systemd.Journalctl {
  operation UnitLog {
    input { unit: NonEmptyStr }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["journalctl", "-u", "{unit}", "--no-pager", "-o", "short-unix"] }
    exit {
      0 => Unit
      nonzero => String "journalctl failed"
    }
    mock_response {
      0 => {
        stdout: "1734000000.000000 srv1 actions-runner[1234]: Listening for Jobs\n",
        success: true,
      } "hermetic systemd.Journalctl.UnitLog"
    }
  }

  operation UnitInvocationLog {
    input { unit: NonEmptyStr, invocation_id: NonEmptyStr }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["journalctl", "-u", "{unit}", "_SYSTEMD_INVOCATION_ID={invocation_id}", "--no-pager", "-o", "short-unix"] }
    exit {
      0 => Unit
      nonzero => String "journalctl failed"
    }
    mock_response {
      0 => {
        stdout: "1734000000.000000 srv1 firecracker[1234]: gunbc-guest-observation guest-booted image=x\n",
        success: true,
      } "hermetic systemd.Journalctl.UnitInvocationLog"
    }
  }
}

// THE LAST N ENTRIES OF ONE UNIT, as a command rather than a service operation, because the count is
// an Int and a transport-shell argv binds only words. journalctl(1): `-n, --lines=` shows the most
// recent N entries; `-u` restricts to the unit; `--no-pager` because nothing reads interactively.
// Same output format as UnitLog, so a consumer reading both reads one grammar. Readonly: journalctl
// writes nothing to the journal it reads.
// journalctl ships in the same directory as systemctl, so it is addressed the same way.
fn journalctl_program() -> ProgramIdentity = uncataloged_program(invocation: systemd_binary_path(name: "journalctl" as NonEmptyStr))

fn journalctl_unit_tail_command(unit: NonEmptyStr, lines: Int) -> ArgvCommand {
  argv_command(program: journalctl_program(), arguments: [
    "-u", unit as String, "-n", to_string(lines), "--no-pager", "-o", "short-unix",
  ])
}
