module extdeps.systemd.oomd




data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.freedesktop.org/software/systemd/man/latest/oomd.conf.html"
  }
}


data systemd_oomd_unit: std.types.NonEmptyStr = "systemd-oomd.service"
data oomd_conf_path: std.types.FilePath = "/etc/systemd/oomd.conf"
data oomd_conf_dropin_dir: std.types.FilePath = "/etc/systemd/oomd.conf.d"

type ManagedOomAction
  = ManagedOomAuto
  | ManagedOomKill

type OomdGlobalConfig {
  swap_used_limit: std.measure.Percent
  default_memory_pressure_limit: std.measure.Percent
  default_memory_pressure_duration: std.measure.Second
}

data oomd_default_global_config: OomdGlobalConfig = OomdGlobalConfig {
  swap_used_limit: std.measure.percent(90),
  default_memory_pressure_limit: std.measure.percent(60),
  default_memory_pressure_duration: std.measure.second(30),
}

type UnitManagedOomPolicy {
  scope_unit: std.types.NonEmptyStr
  managed_oom_swap: ManagedOomAction
  managed_oom_memory_pressure: ManagedOomAction
  managed_oom_memory_pressure_limit: std.measure.Percent?
  managed_oom_memory_pressure_duration: std.measure.Second?
}

data oomd_managed_oom_memory_pressure_property: std.types.NonEmptyStr = "ManagedOOMMemoryPressure"
data oomd_managed_oom_memory_pressure_limit_property: std.types.NonEmptyStr = "ManagedOOMMemoryPressureLimit"
data oomd_managed_oom_swap_property: std.types.NonEmptyStr = "ManagedOOMSwap"

data oomd_managed_value_kill: std.types.NonEmptyStr = "kill"
data oomd_managed_value_auto: std.types.NonEmptyStr = "auto"

data systemd_managed_oom_pressure_limit_show_scale: Int = 4294967295

fn managed_oom_pressure_limit_show_value(p: std.measure.Percent) -> Int {
  std.measure.percent_count(p: p) * systemd_managed_oom_pressure_limit_show_scale / 100
}

fn parse_managed_oom_pressure_limit_show(raw: String) -> std.measure.Percent? {
  let trimmed = std.algebra.trim(raw)
  if trimmed == "" {
    none
  } else {
    match parse_int(s: trimmed) {
      Present { value: wire } =>
        Present { value: std.measure.percent(wire * 100 / systemd_managed_oom_pressure_limit_show_scale) }
      Absent => none
    }
  }
}

fn managed_oom_pressure_limit_wire_matches_percent(wire: Int, desired: std.measure.Percent) -> Bool {
  wire == managed_oom_pressure_limit_show_value(p: desired)
}

fn managed_oom_action_value(a: ManagedOomAction) -> std.types.NonEmptyStr {
  match a {
    ManagedOomKill => oomd_managed_value_kill
    ManagedOomAuto => oomd_managed_value_auto
  }
}

type OomdDropIn {
  target_unit: std.types.NonEmptyStr
  policy: UnitManagedOomPolicy
}

service systemd.Oomctl {
  operation Dump {
    input {}
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["oomctl", "dump"] }
    exit {
      0 => Unit
      nonzero => String "oomctl dump failed (systemd-oomd not running?)"
    }
  }
}
