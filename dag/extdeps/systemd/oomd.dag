module extdeps.systemd.oomd

import std.types { NonEmptyStr, String, FilePath, Bool }
import std.measure { Second, second, Percent, percent, percent_count }
import std.types { Int }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.freedesktop.org/software/systemd/man/latest/oomd.conf.html"
  }
}


data systemd_oomd_unit: NonEmptyStr = "systemd-oomd.service"
data oomd_conf_path: FilePath = "/etc/systemd/oomd.conf"
data oomd_conf_dropin_dir: FilePath = "/etc/systemd/oomd.conf.d"

type ManagedOomAction
  = ManagedOomAuto
  | ManagedOomKill

type OomdGlobalConfig {
  swap_used_limit: Percent
  default_memory_pressure_limit: Percent
  default_memory_pressure_duration: Second
}

data oomd_default_global_config: OomdGlobalConfig = OomdGlobalConfig {
  swap_used_limit: percent(90),
  default_memory_pressure_limit: percent(60),
  default_memory_pressure_duration: second(30),
}

type UnitManagedOomPolicy {
  scope_unit: NonEmptyStr
  managed_oom_swap: ManagedOomAction
  managed_oom_memory_pressure: ManagedOomAction
  managed_oom_memory_pressure_limit: Percent?
  managed_oom_memory_pressure_duration: Second?
}

data oomd_managed_oom_memory_pressure_property: NonEmptyStr = "ManagedOOMMemoryPressure"
data oomd_managed_oom_memory_pressure_limit_property: NonEmptyStr = "ManagedOOMMemoryPressureLimit"
data oomd_managed_oom_swap_property: NonEmptyStr = "ManagedOOMSwap"

data oomd_managed_value_kill: NonEmptyStr = "kill"
data oomd_managed_value_auto: NonEmptyStr = "auto"

data systemd_managed_oom_pressure_limit_show_scale: Int = 4294967295

fn managed_oom_pressure_limit_show_value(p: Percent) -> Int {
  percent_count(p: p) * systemd_managed_oom_pressure_limit_show_scale / 100
}

fn parse_managed_oom_pressure_limit_show(raw: String) -> Percent? {
  let trimmed = trim(raw)
  if trimmed == "" {
    none
  } else {
    match parse_int(s: trimmed) {
      Present { value: wire } =>
        Present { value: percent(wire * 100 / systemd_managed_oom_pressure_limit_show_scale) }
      Absent => none
    }
  }
}

fn managed_oom_pressure_limit_wire_matches_percent(wire: Int, desired: Percent) -> Bool {
  wire == managed_oom_pressure_limit_show_value(p: desired)
}

fn managed_oom_action_value(a: ManagedOomAction) -> NonEmptyStr {
  match a {
    ManagedOomKill => oomd_managed_value_kill
    ManagedOomAuto => oomd_managed_value_auto
  }
}

type OomdDropIn {
  target_unit: NonEmptyStr
  policy: UnitManagedOomPolicy
}

service systemd.Oomctl {
  operation Dump {
    input {}
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["oomctl", "dump"] }
    exit {
      0 => Unit
      nonzero => String "oomctl dump failed (systemd-oomd not running?)"
    }
  }
}
