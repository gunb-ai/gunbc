module extdeps.shell.exec

import std.types { String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.exec_arg_limit { host_exec_arg_max_strlen }
import std.measure { ByteSize }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html"
  }
}

// THE TRANSPORT-SCRIPT CONSTRUCTION WALL. TransportScript was `= String where brand(...)` — a
// TRANSPARENT brand, so every module could produce one, by cast or by simply passing a String into the
// `script:` position, and the class was guarded by a lens rather than by construction (DESIGN 5:
// construction over validation). It is now a sole_constructor RECORD: only this file may build one, and
// `transport_script_seal` below is the single admitted route in, caller-sealed to the production
// bridges by name. A String has no route to a shell invocation that does not pass through one of them.
//
// The transport reads `script.body` rather than the value itself — a record cannot be handed to a
// process, only its text can. That projection is what the wall costs, and it is proven by execution
// rather than assumed: a service transport may project a record field into stdin and into an argv
// interpolation slot.
type TransportScript sole_constructor {
  body: String
}

// The ONE mint. It takes a bare String — this is extdeps, which owns the transport's interface shape
// and must not know the product's policy carriers — and gates WHO may call it, so the policy that a
// script body carries a reason and a dissolve-on target stays in the product layer where it belongs
// (DESIGN 3: interface shape here, business policy in the workflow layer).
//
// admit_callers is the whole wall's load: adding a caller is an edit to THIS list in the dependency's
// own module, which is a conspicuous, counted review event rather than an import someone can write in
// their own file. No test declaration is admitted; a test obtains a TransportScript through a
// production bridge, the same way production does.
fn transport_script_seal(body: String) -> TransportScript
  admit_callers: [
    decl_ref(module_path: "gunbc.retained_shell_script", decl_name: "retained_shell_script_to_transport"),
    decl_ref(module_path: "gunbc.bash_materialized_transport", decl_name: "bash_materialized_transport"),
  ]
  = TransportScript { body: body }

data shell_exec_run_stdin_route_note: String = "shell.Exec.Run transport: argv is fixed [bash, -s]; the script input is routed through the transport stdin field. Large payloads belong here — they never become a single argv token, so they do not encounter the Linux per-argument exec ceiling modeled in extdeps.exec.exec_arg_limit.host_exec_arg_max_strlen (deploy Part A / #6711)."

data shell_exec_check_argv_embed_note: String = "shell.Exec.Check transport: argv is [sh, -c, command] — the entire command string is ONE argv element. On Linux hosts this is the surface that hits execve(2) MAX_ARG_STRLEN (extdeps.exec.exec_arg_limit.host_exec_arg_max_strlen): an oversized embed fails E2BIG (opaque os error 7) unless the interpreter refuses first at dispatch_shell (InterpError::ArgvExceedsHostArgMax). Prefer Run for payloads approaching the per-argument ceiling."

data shell_exec_transport_ceiling_authority: ByteSize = host_exec_arg_max_strlen

service shell.Exec {
  operation Run {
    input { script: TransportScript }

    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }

    transport shell {
      argv: ["bash", "-s"]
      stdin: script.body
    }
    exit {
      0 => Unit
      nonzero => String "Script failed"
    }
    mock_response {
      0 => { exit_code: 0, success: true, stdout: "", stderr: "" } "hermetic shell.Exec.Run success"
    }
  }

  operation Check {
    input { command: TransportScript }
    output { exists: Bool from "exit_success" }
    readonly

    transport shell { argv: ["sh", "-c", "{command.body}"] }
    exit {
      0 => Unit
      nonzero => String "Command failed"
    }
    mock_response {
      0 => { exists: true } "hermetic shell.Exec.Check success"
    }
  }
}
