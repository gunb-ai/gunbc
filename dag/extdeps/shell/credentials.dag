module extdeps.shell.credentials


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap08.html"
  }
}

// `shell.Env.Get` answers `value: String?` because the variable may be unset, and this pattern
// reached it with `as Secret`, which does not eliminate the absence -- it re-types the wrapper, so an
// unset variable produced a Secret whose contents were the literal text `Absent`: a nonempty,
// plausible-looking token that no consumer could tell from a real one. The compiler refuses that
// cast now (`OptionalCastNotEliminated`).
//
// The absence is CARRIED rather than papered over: the pattern answers `token: Secret?`, so a caller
// cannot reach a secret without eliminating the case where there is none. An earlier revision of
// this change substituted the empty secret here and deferred the surface change; the deferral was
// reversed on a measurement -- `env_credential` has exactly one consumer and that consumer has no
// callers at all, so the migration cost is at its minimum now and every caller added before the fix
// would have inherited a silent empty credential.
fn env_credential_token(value: String?) -> Secret? {
  match value {
    Present { value: token } => Present { value: token as Secret }
    Absent => none
  }
}

pattern env_credential(env_var: NonEmptyStr) -> { token: Secret? } {
  result = shell.Env.Get(name: env_var)
  return { token: env_credential_token(value: result.value) }
}
