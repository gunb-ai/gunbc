module extdeps.shell.credentials


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap08.html"
  }
}

pattern env_credential(env_var: std.types.NonEmptyStr) -> { token: Secret } {
  result = shell.Env.Get(name: env_var)
  return { token: result.value as Secret }
}
