module extdeps.shell.credentials

import extdeps.shell
import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap08.html"
  }
}

// `shell.Env.Get` answers `value: String?` because the variable may be unset, and this pattern
// reached it with `as Secret`, which does not eliminate the absence -- it re-types the wrapper, so an
// unset variable produced a Secret whose contents were the literal text `Absent`: a nonempty,
// plausible-looking token that no consumer could tell from a real one. The compiler now refuses that
// cast. The absent arm is the EMPTY secret, which every credential consumer must already reject, so
// the failure presents as an unusable credential rather than as a forged one.
//
// BOUND, STATED RATHER THAN CLAIMED AWAY: this is elimination, not a refusal. The honest shape is
// `token: Secret?` (or a typed refusal) so absence is carried to the caller, and that changes this
// pattern's declared surface and `GitHubAuthToken.token` with it -- a separate change from the wall
// that surfaced the site.
fn env_credential_token(value: String?) -> Secret {
  match value {
    Present { value: token } => token as Secret
    Absent => "" as Secret
  }
}

pattern env_credential(env_var: NonEmptyStr) -> { token: Secret } {
  result = shell.Env.Get(name: env_var)
  return { token: env_credential_token(value: result.value) }
}
