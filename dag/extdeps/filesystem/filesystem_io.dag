module extdeps.filesystem.filesystem_io


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/functions/write.html"
  }
}

data write_owner_only_realization_note: String = "v1 realization: Unix OpenOptions create_new + mode 0600 at creation (O_EXCL); non-Unix hosts refuse rather than degrading to unmodeled write."

service Filesystem {

  operation Write {
    input { path: String, content: String }
    output {
      success: Bool from "write_success"
      bytes_written: Int from "bytes_written"
      path: String from "path"
      error: String from "error"
    }
    transport file { path: "{path}" }
  }

  operation WriteOwnerOnly {
    input { path: String, content: String }
    output {
      success: Bool from "write_success"
      bytes_written: Int from "bytes_written"
      path: String from "path"
      error: String from "error"
    }
    transport file { path: "{path}", verb: "write_owner_only" }
  }

  operation Read {
    input { path: String }
    output {
      content: String from "content"
      success: Bool from "write_success"
      error: String from "error"
    }
    readonly
    transport file { path: "{path}" }
  }

  operation Delete {
    input { path: String }
    output {
      success: Bool from "write_success"
      error: String from "error"
    }
    transport file { path: "{path}", verb: "delete" }
  }

  operation List {
    input { path: String }
    output {
      entries: String from "content"
      success: Bool from "write_success"
      error: String from "error"
    }
    readonly
    transport file { path: "{path}", verb: "list" }
  }
}
