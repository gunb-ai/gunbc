module extdeps.filesystem.filesystem_io

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data filesystem_service_sketch_note: String = "The Filesystem service below is an unmodeled sketch, not a real transport: the generated Write/Read/Delete/List bodies read/write the OPERATION NAME as a literal path (e.g. base_path + \"/write\") rather than the input path argument, and the dry-run arm panics. It exists so a module can declare service Filesystem { operation Read } and thereby ground the filesystem_read v1 builtin's Hermetic-mode reachability check (see extdeps.filesystem.filesystem_io usage in v1.gunbc.namespace_reference_derived_closure_production_observations) — it is not wired as a real Filesystem realization anywhere and must not be treated as one until this service is properly modeled against a real transport. 🟡 dissolve-on: this service is re-modeled against a real Filesystem transport (the operation bodies dispatch on their input path argument instead of the operation name, and the dry-run arm returns a typed outcome instead of panicking) — owner is whoever next needs Filesystem.Read/Write to actually read/write, not this PR's scope (N3-A only imports the module for its hermetic-mode service_ops grounding side effect)."

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/functions/write.html"
  }
}

service Filesystem {

  operation Write {
    input { path: String, content: String }
    output {
      success: Bool from "write_success"
      bytes_written: Int from "bytes_written"
      path: String from "path"
      error: String from "error"
    }
    transport file { path: "{path}" }
  }

  operation Read {
    input { path: String }
    output {
      content: String from "content"
      success: Bool from "write_success"
      error: String from "error"
    }
    readonly
    transport file { path: "{path}" }
  }

  operation Delete {
    input { path: String }
    output {
      success: Bool from "write_success"
      error: String from "error"
    }
    transport file { path: "{path}", verb: "delete" }
  }

  operation List {
    input { path: String }
    output {
      entries: String from "content"
      success: Bool from "write_success"
      error: String from "error"
    }
    readonly
    transport file { path: "{path}", verb: "list" }
  }
}
