module extdeps.filesystem.filesystem_io


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { Bool, Int, List, String }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/functions/write.html"
  }
}

data read_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "pubs.opengroup.org/onlinepubs/9799919799/functions/read.html" }
}

data open_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "pubs.opengroup.org/onlinepubs/9799919799/functions/open.html" }
}

data rust_read_to_string_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "doc.rust-lang.org/std/fs/fn.read_to_string.html" }
}

// Shadow vocabulary for the referred Result<String, ReadError> replacement.
// POSIX names remain intact rather than being renamed locally. InvalidUtf8 is
// the String-decoding refusal specified by Rust read_to_string. The final arm is
// explicit because POSIX permits implementation-defined additional errors and
// Rust io::ErrorKind is non-exhaustive; unknown host conditions must not be
// fabricated into a known remedy.
type ReadError
  = ReadEacces
  | ReadEagain
  | ReadEbadf
  | ReadEbadmsg
  | ReadEintr
  | ReadEinval
  | ReadEio
  | ReadEisdir
  | ReadEloop
  | ReadEnametoolong
  | ReadEnoent
  | ReadEnotdir
  | ReadEoverflow
  | ReadInvalidUtf8
  | ReadErrorUnclassified { description: String }

data write_owner_only_realization_note: String = "v1 realization: Unix OpenOptions create_new + mode 0600 at creation (O_EXCL); non-Unix hosts refuse rather than degrading to unmodeled write."

service Filesystem {

  operation Write {
    input { path: String, content: String }
    output {
      success: Bool from "write_success"
      bytes_written: Int from "bytes_written"
      path: String from "path"
      error: String from "error"
    }
    transport file { path: "{path}" }
  }

  operation WriteOwnerOnly {
    input { path: String, content: String }
    output {
      success: Bool from "write_success"
      bytes_written: Int from "bytes_written"
      path: String from "path"
      error: String from "error"
    }
    transport file { path: "{path}", verb: "write_owner_only" }
  }

  operation Read {
    input { path: String }
    output {
      content: String from "content"
      success: Bool from "write_success"
      error: String from "error"
    }
    readonly
    transport file { path: "{path}" }
  }

  operation Delete {
    input { path: String }
    output {
      success: Bool from "write_success"
      error: String from "error"
    }
    transport file { path: "{path}", verb: "delete" }
  }

  operation List {
    input { path: String }
    output {
      entries: String from "content"
      success: Bool from "write_success"
      error: String from "error"
    }
    readonly
    transport file { path: "{path}", verb: "list" }
  }
}
