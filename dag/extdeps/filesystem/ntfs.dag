module extdeps.filesystem.ntfs


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "learn.microsoft.com/en-us/openspecs/windows_protocols/ms-fscc/"
  }
}

type NtfsEntryType
  = NormalFile
  | NtfsDirectory
  | SymlinkReparse
  | MountPointReparse

fn ntfs_entry_kind(t: NtfsEntryType) -> std.filesystem.types.EntryKind {
  match t {
    NormalFile         => RegularFile
    NtfsDirectory      => Directory
    SymlinkReparse     => Symlink
    MountPointReparse  => Other
  }
}
