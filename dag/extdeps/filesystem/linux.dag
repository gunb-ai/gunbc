module extdeps.filesystem.linux




data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "docs.kernel.org/filesystems/overlayfs.html",
  },
}

data linux_rename_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "man7.org/linux/man-pages/man2/html",
  },
}

data linux_sync_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "man7.org/linux/man-pages/man2/html",
  },
}

type LinuxFilesystemKind
  = LinuxOverlayFs
  | LinuxSquashFs
  | LinuxJffs2
  | OtherLinuxFilesystem { mount_type: std.types.NonEmptyStr }

// LinuxFilesystemKind is the upstream /proc/mounts filesystem-type wire axis needed to distinguish an overlay mount from squashfs/JFFS2 backing storage. It is not std.os.types.FileSystemSemantics, whose Posix/Ntfs/Apfs/WslPathTranslation arms describe cross-platform path and process semantics. Linux mount-type names are an open kernel/userspace vocabulary, so OtherLinuxFilesystem preserves the exact unrecognized wire value and cannot be mistaken for any persistence-relevant known arm.
type LinuxMountObservation {
  source: std.types.NonEmptyStr
  target: std.types.NonEmptyStr
  filesystem: LinuxFilesystemKind
}

type LinuxOverlayObservation {
  merged_mount: LinuxMountObservation
  lower_directory: std.types.NonEmptyStr
  upper_directory: std.types.NonEmptyStr
  lower_backing_mount: LinuxMountObservation
  upper_backing_mount: LinuxMountObservation
}

type LinuxProcMountRow {
  mount: LinuxMountObservation
  options: List<String>
  dump_frequency: Int
  fsck_pass: Int
}

type LinuxProcMountLineRefusal
  = LinuxProcMountWrongFieldCount { count: Int }
  | LinuxProcMountEmptyRequiredField
  | LinuxProcMountInvalidDumpFrequency { wire: String }
  | LinuxProcMountInvalidFsckPass { wire: String }

type LinuxProcMountLineParse
  = LinuxProcMountLineParsed { row: LinuxProcMountRow }
  | LinuxProcMountLineRefused { cause: LinuxProcMountLineRefusal }

type LinuxProcMountsParse
  = LinuxProcMountsParsed { rows: List<LinuxProcMountRow> }
  | LinuxProcMountsRefused {
      line_number: Int,
      cause: LinuxProcMountLineRefusal,
    }

type LinuxOverlayParseRefusal
  = LinuxOverlayProcMountsRefused {
      line_number: Int,
      cause: LinuxProcMountLineRefusal,
    }
  | LinuxOverlayRootMountMissing
  | LinuxOverlayRootIsNotOverlay
  | LinuxOverlayLowerDirectoryMissing
  | LinuxOverlayUpperDirectoryMissing
  | LinuxOverlayMultipleLowerDirectoriesUnsupported { wire: std.types.NonEmptyStr }
  | LinuxOverlayDirectoryNotAbsolute { path: std.types.NonEmptyStr }
  | LinuxOverlayLowerBackingMountMissing { directory: std.types.NonEmptyStr }
  | LinuxOverlayUpperBackingMountMissing { directory: std.types.NonEmptyStr }

type LinuxOverlayParse
  = LinuxOverlayParsed { observation: LinuxOverlayObservation }
  | LinuxOverlayRefused { cause: LinuxOverlayParseRefusal }

type LinuxFileReplacement
  = RenameReplaceWithinTargetDirectory
  | ReplacementAtomicityUnspecified

type LinuxFilesystemSynchronization
  = NoExplicitFilesystemSynchronization
  | SyncAllFilesystemsAfterReplacement

type LinuxFilePublicationProtocol
  = LinuxSynchronizedRenameReplacePublication
  | LinuxFilePublicationProtocolUnsynchronized {
      stage_in_target_directory: Bool
      staged_content_validated: Bool
      replacement: LinuxFileReplacement
      synchronization: LinuxFilesystemSynchronization
    }

data linux_synchronized_rename_replace_publication: LinuxFilePublicationProtocol = LinuxSynchronizedRenameReplacePublication

fn linux_filesystem_kind_from_mount_type(
  mount_type: std.types.NonEmptyStr,
) -> LinuxFilesystemKind {
  if mount_type == "overlay" {
    LinuxOverlayFs
  } else if mount_type == "squashfs" {
    LinuxSquashFs
  } else if mount_type == "jffs2" {
    LinuxJffs2
  } else {
    OtherLinuxFilesystem { mount_type: mount_type }
  }
}

fn linux_nonempty_whitespace_tokens(raw: String) -> List<std.types.NonEmptyStr> {
  split(s: std.algebra.trim(raw), delimiter: " ")
    |> filter(token => std.algebra.trim(token) != "")
    |> map(token => std.algebra.trim(token) as std.types.NonEmptyStr)
}

fn linux_proc_mount_unescape(field: String) -> String {
  replace(
    replace(
      replace(
        replace(field, "\\040", " "),
        "\\011",
        "\t",
      ),
      "\\012",
      "\n",
    ),
    "\\134",
    "\\",
  )
}

// THE ELIMINATION `first()` OWES. `first` answers `NonEmptyStr?` because a list may be empty, and
// the six sites below reached the value with `as String`, which does NOT eliminate the absence -- it
// re-types the wrapper, so a short row would have rendered `Present { value: /dev/sda }` (or the bare
// word `Absent`) INTO the parsed mount row. The compiler now refuses that cast outright
// (`OptionalCastNotEliminated`), and this is the elimination it demands. The Absent arm is the empty
// string on purpose rather than a fresh refusal variant: every consumer of a field already refuses on
// it -- source/target/mount_type through `LinuxProcMountEmptyRequiredField`, the two numeric fields
// through `parse_int` returning Absent -- so absence routes into a refusal that already exists
// instead of minting a second one beside it. It is unreachable in any case: the caller has already
// refused a row whose field count is not six.
fn linux_proc_mount_field(fields: List<NonEmptyStr>, index: Int) -> String {
  match fields.skip(n: index).first() {
    Present { value: field } => field as String
    Absent => ""
  }
}

fn linux_proc_mount_row_from_line(line: String) -> LinuxProcMountLineParse {
  let fields = linux_nonempty_whitespace_tokens(raw: line)
  if fields.length() != 6 {
    LinuxProcMountLineRefused {
      cause: LinuxProcMountWrongFieldCount { count: fields.length() },
    }
  } else {
    let source = linux_proc_mount_unescape(
      field: linux_proc_mount_field(fields: fields, index: 0),
    )
    let target = linux_proc_mount_unescape(
      field: linux_proc_mount_field(fields: fields, index: 1),
    )
    let mount_type = linux_proc_mount_unescape(
      field: linux_proc_mount_field(fields: fields, index: 2),
    )
    let raw_options = linux_proc_mount_field(fields: fields, index: 3)
    if source == "" || target == "" || mount_type == "" {
      LinuxProcMountLineRefused { cause: LinuxProcMountEmptyRequiredField }
    } else {
      match parse_int(s: linux_proc_mount_field(fields: fields, index: 4)) {
        Absent =>
          LinuxProcMountLineRefused {
            cause: LinuxProcMountInvalidDumpFrequency {
              wire: linux_proc_mount_field(fields: fields, index: 4),
            },
          }
        Present { value: dump_frequency } =>
          match parse_int(s: linux_proc_mount_field(fields: fields, index: 5)) {
            Absent =>
              LinuxProcMountLineRefused {
                cause: LinuxProcMountInvalidFsckPass {
                  wire: linux_proc_mount_field(fields: fields, index: 5),
                },
              }
            Present { value: fsck_pass } =>
              if dump_frequency < 0 {
                LinuxProcMountLineRefused {
                  cause: LinuxProcMountInvalidDumpFrequency {
                    wire: linux_proc_mount_field(fields: fields, index: 4),
                  },
                }
              } else if fsck_pass < 0 {
                LinuxProcMountLineRefused {
                  cause: LinuxProcMountInvalidFsckPass {
                    wire: linux_proc_mount_field(fields: fields, index: 5),
                  },
                }
              } else {
                LinuxProcMountLineParsed {
                  row: LinuxProcMountRow {
                    mount: LinuxMountObservation {
                      source: source as std.types.NonEmptyStr,
                      target: target as std.types.NonEmptyStr,
                      filesystem: linux_filesystem_kind_from_mount_type(
                        mount_type: mount_type as std.types.NonEmptyStr,
                      ),
                    },
                    options: split(s: raw_options, delimiter: ",")
                      |> filter(option => std.algebra.trim(option) != "")
                      |> map(option =>
                        linux_proc_mount_unescape(field: std.algebra.trim(option))
                      ),
                    dump_frequency: dump_frequency,
                    fsck_pass: fsck_pass,
                  },
                }
              }
          }
      }
    }
  }
}

type LinuxProcMountsParseFold {
  line_number: Int
  parse: LinuxProcMountsParse
}

fn linux_proc_mounts_parse(proc_mounts: String) -> LinuxProcMountsParse {
  let folded = fold(
    split(s: proc_mounts, delimiter: "\n"),
    init: LinuxProcMountsParseFold {
      line_number: 1,
      parse: LinuxProcMountsParsed { rows: [] },
    },
    f: (acc, line) =>
      match acc.parse {
        LinuxProcMountsRefused { line_number: _, cause: _ } =>
          LinuxProcMountsParseFold {
            line_number: acc.line_number + 1,
            parse: acc.parse,
          }
        LinuxProcMountsParsed { rows: rows } =>
          if std.algebra.trim(line) == "" {
            LinuxProcMountsParseFold {
              line_number: acc.line_number + 1,
              parse: acc.parse,
            }
          } else {
            match linux_proc_mount_row_from_line(line: line) {
              LinuxProcMountLineRefused { cause: cause } =>
                LinuxProcMountsParseFold {
                  line_number: acc.line_number + 1,
                  parse: LinuxProcMountsRefused {
                    line_number: acc.line_number,
                    cause: cause,
                  },
                }
              LinuxProcMountLineParsed { row: row } =>
                LinuxProcMountsParseFold {
                  line_number: acc.line_number + 1,
                  parse: LinuxProcMountsParsed {
                    rows: append(rows, items: [row]),
                  },
                }
            }
          }
      },
  )
  folded.parse
}

fn linux_proc_mount_row_for_target(
  rows: List<LinuxProcMountRow>,
  target: std.types.NonEmptyStr,
) -> LinuxProcMountRow? {
  rows
    |> filter(row => row.mount.target == target)
    |> first
}

fn linux_mount_target_contains_directory(
  target: std.types.NonEmptyStr,
  directory: std.types.NonEmptyStr,
) -> Bool {
  if target == "/" {
    starts_with(s: directory as String, prefix: "/")
  } else {
    target == directory
      || (
        starts_with(
          s: directory as String,
          prefix: target as String,
        )
        && directory.length() > target.length()
        && substring(
          s: directory as String,
          start: target.length(),
          end: target.length() + 1,
        ) == "/"
      )
  }
}

fn linux_more_specific_backing_mount(
  current: LinuxProcMountRow?,
  candidate: LinuxProcMountRow,
) -> LinuxProcMountRow? {
  match current {
    Absent => Present { value: candidate }
    Present { value: selected } =>
      if string_length(s: candidate.mount.target as String) > string_length(s: selected.mount.target as String) {
        Present { value: candidate }
      } else {
        current
      }
  }
}

fn linux_proc_mount_backing_row(
  rows: List<LinuxProcMountRow>,
  directory: std.types.NonEmptyStr,
  excluded_target: std.types.NonEmptyStr,
) -> LinuxProcMountRow? {
  fold(
    rows,
    init: none,
    f: (selected, row) =>
      if row.mount.target != excluded_target
        && linux_mount_target_contains_directory(
          target: row.mount.target,
          directory: directory,
        ) {
        linux_more_specific_backing_mount(
          current: selected,
          candidate: row,
        )
      } else {
        selected
      },
  )
}

fn linux_mount_option_value(
  row: LinuxProcMountRow,
  name: std.types.NonEmptyStr,
) -> std.types.NonEmptyStr? {
  fold(
    row.options,
    init: none,
    f: (selected, option) =>
      match selected {
        Present { value: _ } => selected
        Absent =>
          if starts_with(s: option, prefix: name as String)
            && option.length() > name.length() + 1
            && substring(
              s: option,
              start: name.length(),
              end: name.length() + 1,
            ) == "=" {
            Present {
              value: substring(
                s: option,
                start: name.length() + 1,
                end: option.length(),
              ) as std.types.NonEmptyStr,
            }
          } else {
            none
          }
      },
  )
}

fn linux_overlay_observation_from_rows(
  rows: List<LinuxProcMountRow>,
) -> LinuxOverlayParse {
  match linux_proc_mount_row_for_target(
    rows: rows,
    target: "/",
  ) {
    Absent => LinuxOverlayRefused { cause: LinuxOverlayRootMountMissing }
    Present { value: root } =>
      if !(root.mount.filesystem == LinuxOverlayFs) {
        LinuxOverlayRefused { cause: LinuxOverlayRootIsNotOverlay }
      } else {
        match linux_mount_option_value(row: root, name: "lowerdir") {
          Absent =>
            LinuxOverlayRefused { cause: LinuxOverlayLowerDirectoryMissing }
          Present { value: lower } =>
            if string_contains(s: lower as String, pattern: ":") {
              LinuxOverlayRefused {
                cause: LinuxOverlayMultipleLowerDirectoriesUnsupported {
                  wire: lower,
                },
              }
            } else if !starts_with(s: lower as String, prefix: "/") {
              LinuxOverlayRefused {
                cause: LinuxOverlayDirectoryNotAbsolute { path: lower },
              }
            } else {
              match linux_mount_option_value(row: root, name: "upperdir") {
                Absent =>
                  LinuxOverlayRefused {
                    cause: LinuxOverlayUpperDirectoryMissing,
                  }
                Present { value: upper } =>
                  if !starts_with(s: upper as String, prefix: "/") {
                    LinuxOverlayRefused {
                      cause: LinuxOverlayDirectoryNotAbsolute { path: upper },
                    }
                  } else {
                    match linux_proc_mount_backing_row(
                      rows: rows,
                      directory: lower,
                      excluded_target: root.mount.target,
                    ) {
                      Absent =>
                        LinuxOverlayRefused {
                          cause: LinuxOverlayLowerBackingMountMissing {
                            directory: lower,
                          },
                        }
                      Present { value: lower_row } =>
                        match linux_proc_mount_backing_row(
                          rows: rows,
                          directory: upper,
                          excluded_target: root.mount.target,
                        ) {
                          Absent =>
                            LinuxOverlayRefused {
                              cause: LinuxOverlayUpperBackingMountMissing {
                                directory: upper,
                              },
                            }
                          Present { value: upper_row } =>
                            LinuxOverlayParsed {
                              observation: LinuxOverlayObservation {
                                merged_mount: root.mount,
                                lower_directory: lower,
                                upper_directory: upper,
                                lower_backing_mount: lower_row.mount,
                                upper_backing_mount: upper_row.mount,
                              },
                            }
                        }
                    }
                  }
              }
            }
        }
      }
  }
}

fn linux_overlay_observation_from_proc_mounts(
  proc_mounts: String,
) -> LinuxOverlayParse {
  match linux_proc_mounts_parse(proc_mounts: proc_mounts) {
    LinuxProcMountsRefused {
      line_number: line_number,
      cause: cause,
    } =>
      LinuxOverlayRefused {
        cause: LinuxOverlayProcMountsRefused {
          line_number: line_number,
          cause: cause,
        },
      }
    LinuxProcMountsParsed { rows: rows } =>
      linux_overlay_observation_from_rows(rows: rows)
  }
}

fn linux_overlay_observation_is_flash_backed(
  observation: LinuxOverlayObservation,
) -> Bool {
  observation.merged_mount.target == "/"
    && observation.merged_mount.filesystem == LinuxOverlayFs
    && observation.lower_backing_mount.filesystem == LinuxSquashFs
    && observation.upper_backing_mount.filesystem == LinuxJffs2
    && linux_mount_target_contains_directory(
      target: observation.lower_backing_mount.target,
      directory: observation.lower_directory,
    )
    && linux_mount_target_contains_directory(
      target: observation.upper_backing_mount.target,
      directory: observation.upper_directory,
    )
}

data linux_file_publication_semantics_note: String = "Literal mechanism facts precede any durability judgment. Linux rename replacement is atomic when replacing an existing pathname on the same filesystem; Linux sync writes pending filesystem metadata and cached file data to the underlying filesystems and waits for I/O completion. OverlayFS names the writable upper directory separately from the lower directory. Synchronized durability commit is admitted only through the LinuxSynchronizedRenameReplacePublication unit variant; partial protocol records remain explicitly unsynchronized. This module records those operations and observed mount relationships; it does not itself claim survival across a lifecycle boundary."

data linux_proc_mounts_parser_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: a cited proc_mounts grammar row set lands in the shared grammar substrate with forward ingest and escape decoding. linux_proc_mount_row_from_line then becomes that grammar forward fold, and the same rows own any later serialization; until then this parser is the declared six-field Linux wire scaffold, fail-closed through LinuxProcMountLineRefusal rather than a second typed represent")
