module extdeps.filesystem.linux

import std.dissolution { DissolutionCondition, unbound_dissolution }

import std.algebra { trim }

import extdeps.external_authority { ExternalAuthority, CitedFigureStanding, CitedToAuthority, cited_figure_read_obligation }
import extdeps.uri { Https, Uri, uri_https }
import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Present, Absent }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "docs.kernel.org/filesystems/overlayfs.html",
  },
}

data linux_rename_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "man7.org/linux/man-pages/man2/rename.2.html",
  },
}

data linux_sync_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "man7.org/linux/man-pages/man2/sync.2.html",
  },
}

type LinuxFilesystemKind
  = LinuxOverlayFs
  | LinuxSquashFs
  | LinuxJffs2
  | LinuxMemoryOnlyFs { filesystem: LinuxMemoryOnlyFilesystem }
  | OtherLinuxFilesystem { mount_type: NonEmptyStr }

// THE KERNEL FILESYSTEMS WHOSE CONTENT EXISTS ONLY IN MEMORY: tmpfs and ramfs (and the initramfs rootfs, one of them)
// hold pages and nothing else, and the rest are kernel interfaces with no backing store, so a mount of one keeps
// nothing across a power cycle. Each arm's wire name and the authority that says so are linux_memory_only_filesystem_row.
// Deliberately NOT here: efivarfs and pstore (interfaces to firmware NVRAM, which persists), overlay (its persistence
// is its upper layer's), squashfs and jffs2 (images on a device). A type that is not an arm stays OtherLinuxFilesystem,
// which may persist: absence from this type is never evidence of volatility.
type LinuxMemoryOnlyFilesystem
  = LinuxTmpfs
  | LinuxRamfs
  | LinuxRootfs
  | LinuxProcFs
  | LinuxSysfs
  | LinuxDevtmpfs
  | LinuxDevpts
  | LinuxCgroupV1
  | LinuxCgroupV2
  | LinuxMqueue
  | LinuxSecurityfs
  | LinuxDebugfs
  | LinuxTracefs
  | LinuxConfigfs
  | LinuxFusectl
  | LinuxBpfFs
  | LinuxHugetlbfs
  | LinuxBinfmtMisc

// LinuxFilesystemKind is the upstream /proc/mounts filesystem-type wire axis needed to distinguish an overlay mount from squashfs/JFFS2 backing storage. It is not std.os.types.FileSystemSemantics, whose Posix/Ntfs/Apfs/WslPathTranslation arms describe cross-platform path and process semantics. Linux mount-type names are an open kernel/userspace vocabulary, so OtherLinuxFilesystem preserves the exact unrecognized wire value and cannot be mistaken for any persistence-relevant known arm.
type LinuxMountObservation {
  source: NonEmptyStr
  target: NonEmptyStr
  filesystem: LinuxFilesystemKind
}

type LinuxOverlayObservation {
  merged_mount: LinuxMountObservation
  lower_directory: NonEmptyStr
  upper_directory: NonEmptyStr
  lower_backing_mount: LinuxMountObservation
  upper_backing_mount: LinuxMountObservation
}

type LinuxProcMountRow {
  mount: LinuxMountObservation
  options: List<String>
  dump_frequency: Int
  fsck_pass: Int
}

type LinuxProcMountLineRefusal
  = LinuxProcMountWrongFieldCount { count: Int }
  | LinuxProcMountEmptyRequiredField
  | LinuxProcMountInvalidDumpFrequency { wire: String }
  | LinuxProcMountInvalidFsckPass { wire: String }

type LinuxProcMountLineParse
  = LinuxProcMountLineParsed { row: LinuxProcMountRow }
  | LinuxProcMountLineRefused { cause: LinuxProcMountLineRefusal }

type LinuxProcMountsParse
  = LinuxProcMountsParsed { rows: List<LinuxProcMountRow> }
  | LinuxProcMountsRefused {
      line_number: Int,
      cause: LinuxProcMountLineRefusal,
    }

type LinuxOverlayParseRefusal
  = LinuxOverlayProcMountsRefused {
      line_number: Int,
      cause: LinuxProcMountLineRefusal,
    }
  | LinuxOverlayRootMountMissing
  | LinuxOverlayRootIsNotOverlay
  | LinuxOverlayLowerDirectoryMissing
  | LinuxOverlayUpperDirectoryMissing
  | LinuxOverlayMultipleLowerDirectoriesUnsupported { wire: NonEmptyStr }
  | LinuxOverlayDirectoryNotAbsolute { path: NonEmptyStr }
  | LinuxOverlayLowerBackingMountMissing { directory: NonEmptyStr }
  | LinuxOverlayUpperBackingMountMissing { directory: NonEmptyStr }

type LinuxOverlayParse
  = LinuxOverlayParsed { observation: LinuxOverlayObservation }
  | LinuxOverlayRefused { cause: LinuxOverlayParseRefusal }

type LinuxFileReplacement
  = RenameReplaceWithinTargetDirectory
  | ReplacementAtomicityUnspecified

type LinuxFilesystemSynchronization
  = NoExplicitFilesystemSynchronization
  | SyncAllFilesystemsAfterReplacement

type LinuxFilePublicationProtocol
  = LinuxSynchronizedRenameReplacePublication
  | LinuxFilePublicationProtocolUnsynchronized {
      stage_in_target_directory: Bool
      staged_content_validated: Bool
      replacement: LinuxFileReplacement
      synchronization: LinuxFilesystemSynchronization
    }

data linux_synchronized_rename_replace_publication: LinuxFilePublicationProtocol = LinuxSynchronizedRenameReplacePublication

type LinuxMemoryOnlyFilesystemRow {
  mount_type: NonEmptyStr
  standing: CitedFigureStanding
}

fn linux_memory_only_cited(locator: NonEmptyStr) -> CitedFigureStanding {
  CitedToAuthority { authority: ExternalAuthority { uri: uri_https(locator: locator) } }
}

fn linux_memory_only_filesystem_row(filesystem: LinuxMemoryOnlyFilesystem) -> LinuxMemoryOnlyFilesystemRow {
  match filesystem {
    LinuxTmpfs => LinuxMemoryOnlyFilesystemRow { mount_type: "tmpfs", standing: linux_memory_only_cited(locator: "docs.kernel.org/filesystems/tmpfs.html") }
    LinuxRamfs => LinuxMemoryOnlyFilesystemRow { mount_type: "ramfs", standing: linux_memory_only_cited(locator: "docs.kernel.org/filesystems/ramfs-rootfs-initramfs.html") }
    LinuxRootfs => LinuxMemoryOnlyFilesystemRow { mount_type: "rootfs", standing: linux_memory_only_cited(locator: "docs.kernel.org/filesystems/ramfs-rootfs-initramfs.html") }
    LinuxProcFs => LinuxMemoryOnlyFilesystemRow { mount_type: "proc", standing: linux_memory_only_cited(locator: "docs.kernel.org/filesystems/proc.html") }
    LinuxSysfs => LinuxMemoryOnlyFilesystemRow { mount_type: "sysfs", standing: linux_memory_only_cited(locator: "docs.kernel.org/filesystems/sysfs.html") }
    LinuxDevtmpfs => LinuxMemoryOnlyFilesystemRow { mount_type: "devtmpfs", standing: linux_memory_only_cited(locator: "github.com/torvalds/linux/blob/v6.8/drivers/base/devtmpfs.c") }
    LinuxDevpts => LinuxMemoryOnlyFilesystemRow { mount_type: "devpts", standing: linux_memory_only_cited(locator: "docs.kernel.org/filesystems/devpts.html") }
    LinuxCgroupV1 => LinuxMemoryOnlyFilesystemRow { mount_type: "cgroup", standing: linux_memory_only_cited(locator: "docs.kernel.org/admin-guide/cgroup-v1/cgroups.html") }
    LinuxCgroupV2 => LinuxMemoryOnlyFilesystemRow { mount_type: "cgroup2", standing: linux_memory_only_cited(locator: "docs.kernel.org/admin-guide/cgroup-v2.html") }
    LinuxMqueue => LinuxMemoryOnlyFilesystemRow { mount_type: "mqueue", standing: linux_memory_only_cited(locator: "man7.org/linux/man-pages/man7/mq_overview.7.html") }
    LinuxSecurityfs => LinuxMemoryOnlyFilesystemRow { mount_type: "securityfs", standing: linux_memory_only_cited(locator: "github.com/torvalds/linux/blob/v6.8/security/inode.c") }
    LinuxDebugfs => LinuxMemoryOnlyFilesystemRow { mount_type: "debugfs", standing: linux_memory_only_cited(locator: "docs.kernel.org/filesystems/debugfs.html") }
    LinuxTracefs => LinuxMemoryOnlyFilesystemRow { mount_type: "tracefs", standing: linux_memory_only_cited(locator: "docs.kernel.org/trace/ftrace.html") }
    LinuxConfigfs => LinuxMemoryOnlyFilesystemRow { mount_type: "configfs", standing: linux_memory_only_cited(locator: "docs.kernel.org/filesystems/configfs.html") }
    LinuxFusectl => LinuxMemoryOnlyFilesystemRow { mount_type: "fusectl", standing: linux_memory_only_cited(locator: "docs.kernel.org/filesystems/fuse.html") }
    LinuxBpfFs => LinuxMemoryOnlyFilesystemRow { mount_type: "bpf", standing: linux_memory_only_cited(locator: "github.com/torvalds/linux/blob/v6.8/kernel/bpf/inode.c") }
    LinuxHugetlbfs => LinuxMemoryOnlyFilesystemRow { mount_type: "hugetlbfs", standing: linux_memory_only_cited(locator: "docs.kernel.org/admin-guide/mm/hugetlbpage.html") }
    LinuxBinfmtMisc => LinuxMemoryOnlyFilesystemRow { mount_type: "binfmt_misc", standing: linux_memory_only_cited(locator: "docs.kernel.org/admin-guide/binfmt-misc.html") }
  }
}

// THE PARSER'S ROSTER OF THE ARMS ABOVE. An arm missing here parses as OtherLinuxFilesystem, which may persist, so the
// omission refuses rather than admits; the witness round-trips every arm through the parser.
data linux_memory_only_filesystems: List<LinuxMemoryOnlyFilesystem> = [
  LinuxTmpfs, LinuxRamfs, LinuxRootfs, LinuxProcFs, LinuxSysfs, LinuxDevtmpfs, LinuxDevpts, LinuxCgroupV1, LinuxCgroupV2,
  LinuxMqueue, LinuxSecurityfs, LinuxDebugfs, LinuxTracefs, LinuxConfigfs, LinuxFusectl, LinuxBpfFs, LinuxHugetlbfs,
  LinuxBinfmtMisc,
]

fn linux_filesystem_mount_type(kind: LinuxFilesystemKind) -> NonEmptyStr {
  match kind {
    LinuxOverlayFs => "overlay" as NonEmptyStr
    LinuxSquashFs => "squashfs" as NonEmptyStr
    LinuxJffs2 => "jffs2" as NonEmptyStr
    LinuxMemoryOnlyFs { filesystem: f } => linux_memory_only_filesystem_row(filesystem: f).mount_type
    OtherLinuxFilesystem { mount_type: t } => t
  }
}

// WHETHER A MOUNT OF THIS KIND CAN KEEP ANYTHING ACROSS A POWER CYCLE, a property of the kind. A memory-only kind
// keeps nothing only while its row is cited: an uncited row is a bet (DESIGN 4d) and refuses with its read obligation.
type LinuxFilesystemPersistence
  = LinuxFilesystemKeepsNothing { filesystem: LinuxMemoryOnlyFilesystem }
  | LinuxFilesystemMayPersist
  | LinuxFilesystemPersistenceUncited { filesystem: LinuxMemoryOnlyFilesystem, read_obligation: NonEmptyStr }

fn linux_filesystem_persistence(kind: LinuxFilesystemKind) -> LinuxFilesystemPersistence {
  match kind {
    LinuxMemoryOnlyFs { filesystem: f } =>
      match cited_figure_read_obligation(standing: linux_memory_only_filesystem_row(filesystem: f).standing) {
        Absent => LinuxFilesystemKeepsNothing { filesystem: f }
        Present { value: o } => LinuxFilesystemPersistenceUncited { filesystem: f, read_obligation: o }
      }
    LinuxOverlayFs => LinuxFilesystemMayPersist
    LinuxSquashFs => LinuxFilesystemMayPersist
    LinuxJffs2 => LinuxFilesystemMayPersist
    OtherLinuxFilesystem { mount_type: _ } => LinuxFilesystemMayPersist
  }
}

fn linux_filesystem_kind_from_mount_type(
  mount_type: NonEmptyStr,
) -> LinuxFilesystemKind {
  match linux_memory_only_filesystems |> filter(f => linux_memory_only_filesystem_row(filesystem: f).mount_type == mount_type) |> first {
    Present { value: f } => LinuxMemoryOnlyFs { filesystem: f }
    Absent => linux_filesystem_kind_from_other_mount_type(mount_type: mount_type)
  }
}

fn linux_filesystem_kind_from_other_mount_type(
  mount_type: NonEmptyStr,
) -> LinuxFilesystemKind {
  if mount_type == "overlay" {
    LinuxOverlayFs
  } else if mount_type == "squashfs" {
    LinuxSquashFs
  } else if mount_type == "jffs2" {
    LinuxJffs2
  } else {
    OtherLinuxFilesystem { mount_type: mount_type }
  }
}

fn linux_nonempty_whitespace_tokens(raw: String) -> List<NonEmptyStr> {
  split(s: trim(raw), delimiter: " ")
    |> filter(token => trim(token) != "")
    |> map(token => trim(token) as NonEmptyStr)
}

fn linux_proc_mount_unescape(field: String) -> String {
  replace(
    replace(
      replace(
        replace(field, "\\040", " "),
        "\\011",
        "\t",
      ),
      "\\012",
      "\n",
    ),
    "\\134",
    "\\",
  )
}

// THE ELIMINATION `first()` OWES. `first` answers `NonEmptyStr?` because a list may be empty, and
// the six sites below reached the value with `as String`, which does NOT eliminate the absence --
// it re-types the wrapper, so a short row would have rendered `Present { value: /dev/sda }` (or the
// bare word `Absent`) INTO the parsed mount row. The compiler now refuses that cast outright
// (`OptionalCastNotEliminated`), and this is the elimination it demands. The Absent arm is the
// empty string rather than a fresh refusal variant: every consumer of a field already refuses on
// it -- source/target/mount_type through `LinuxProcMountEmptyRequiredField`, the two numeric
// fields through `parse_int` returning Absent -- so absence routes into an existing refusal
// instead of minting a second. It is unreachable in any case: the caller has already refused a
// row whose field count is not six.
fn linux_proc_mount_field(fields: List<NonEmptyStr>, index: Int) -> String {
  match fields.skip(n: index).first() {
    Present { value: field } => field as String
    Absent => ""
  }
}

fn linux_proc_mount_row_from_line(line: String) -> LinuxProcMountLineParse {
  let fields = linux_nonempty_whitespace_tokens(raw: line)
  if fields.length() != 6 {
    LinuxProcMountLineRefused {
      cause: LinuxProcMountWrongFieldCount { count: fields.length() },
    }
  } else {
    let source = linux_proc_mount_unescape(
      field: linux_proc_mount_field(fields: fields, index: 0),
    )
    let target = linux_proc_mount_unescape(
      field: linux_proc_mount_field(fields: fields, index: 1),
    )
    let mount_type = linux_proc_mount_unescape(
      field: linux_proc_mount_field(fields: fields, index: 2),
    )
    let raw_options = linux_proc_mount_field(fields: fields, index: 3)
    if source == "" || target == "" || mount_type == "" {
      LinuxProcMountLineRefused { cause: LinuxProcMountEmptyRequiredField }
    } else {
      match parse_int(s: linux_proc_mount_field(fields: fields, index: 4)) {
        Absent =>
          LinuxProcMountLineRefused {
            cause: LinuxProcMountInvalidDumpFrequency {
              wire: linux_proc_mount_field(fields: fields, index: 4),
            },
          }
        Present { value: dump_frequency } =>
          match parse_int(s: linux_proc_mount_field(fields: fields, index: 5)) {
            Absent =>
              LinuxProcMountLineRefused {
                cause: LinuxProcMountInvalidFsckPass {
                  wire: linux_proc_mount_field(fields: fields, index: 5),
                },
              }
            Present { value: fsck_pass } =>
              if dump_frequency < 0 {
                LinuxProcMountLineRefused {
                  cause: LinuxProcMountInvalidDumpFrequency {
                    wire: linux_proc_mount_field(fields: fields, index: 4),
                  },
                }
              } else if fsck_pass < 0 {
                LinuxProcMountLineRefused {
                  cause: LinuxProcMountInvalidFsckPass {
                    wire: linux_proc_mount_field(fields: fields, index: 5),
                  },
                }
              } else {
                LinuxProcMountLineParsed {
                  row: LinuxProcMountRow {
                    mount: LinuxMountObservation {
                      source: source as NonEmptyStr,
                      target: target as NonEmptyStr,
                      filesystem: linux_filesystem_kind_from_mount_type(
                        mount_type: mount_type as NonEmptyStr,
                      ),
                    },
                    options: split(s: raw_options, delimiter: ",")
                      |> filter(option => trim(option) != "")
                      |> map(option =>
                        linux_proc_mount_unescape(field: trim(option))
                      ),
                    dump_frequency: dump_frequency,
                    fsck_pass: fsck_pass,
                  },
                }
              }
          }
      }
    }
  }
}

type LinuxProcMountsParseFold {
  line_number: Int
  parse: LinuxProcMountsParse
}

fn linux_proc_mounts_parse(proc_mounts: String) -> LinuxProcMountsParse {
  let folded = fold(
    split(s: proc_mounts, delimiter: "\n"),
    init: LinuxProcMountsParseFold {
      line_number: 1,
      parse: LinuxProcMountsParsed { rows: [] },
    },
    f: (acc, line) =>
      match acc.parse {
        LinuxProcMountsRefused { line_number: _, cause: _ } =>
          LinuxProcMountsParseFold {
            line_number: acc.line_number + 1,
            parse: acc.parse,
          }
        LinuxProcMountsParsed { rows: rows } =>
          if trim(line) == "" {
            LinuxProcMountsParseFold {
              line_number: acc.line_number + 1,
              parse: acc.parse,
            }
          } else {
            match linux_proc_mount_row_from_line(line: line) {
              LinuxProcMountLineRefused { cause: cause } =>
                LinuxProcMountsParseFold {
                  line_number: acc.line_number + 1,
                  parse: LinuxProcMountsRefused {
                    line_number: acc.line_number,
                    cause: cause,
                  },
                }
              LinuxProcMountLineParsed { row: row } =>
                LinuxProcMountsParseFold {
                  line_number: acc.line_number + 1,
                  parse: LinuxProcMountsParsed {
                    rows: append(rows, items: [row]),
                  },
                }
            }
          }
      },
  )
  folded.parse
}

// proc_mounts(5) / fstab(5): the fourth field is the comma-separated mount options, and `ro` is the read-only one.
fn linux_proc_mount_is_read_only(row: LinuxProcMountRow) -> Bool {
  row.options |> any(option => trim(option) == "ro")
}

fn linux_proc_mount_row_for_target(
  rows: List<LinuxProcMountRow>,
  target: NonEmptyStr,
) -> LinuxProcMountRow? {
  rows
    |> filter(row => row.mount.target == target)
    |> first
}

fn linux_mount_target_contains_directory(
  target: NonEmptyStr,
  directory: NonEmptyStr,
) -> Bool {
  if target == "/" {
    starts_with(s: directory as String, prefix: "/")
  } else {
    target == directory
      || (
        starts_with(
          s: directory as String,
          prefix: target as String,
        )
        && directory.length() > target.length()
        && substring(
          s: directory as String,
          start: target.length(),
          end: target.length() + 1,
        ) == "/"
      )
  }
}

fn linux_more_specific_backing_mount(
  current: LinuxProcMountRow?,
  candidate: LinuxProcMountRow,
) -> LinuxProcMountRow? {
  match current {
    Absent => Present { value: candidate }
    Present { value: selected } =>
      if string_length(s: candidate.mount.target as String) > string_length(s: selected.mount.target as String) {
        Present { value: candidate }
      } else {
        current
      }
  }
}

fn linux_proc_mount_backing_row(
  rows: List<LinuxProcMountRow>,
  directory: NonEmptyStr,
  excluded_target: NonEmptyStr,
) -> LinuxProcMountRow? {
  fold(
    rows,
    init: none,
    f: (selected, row) =>
      if row.mount.target != excluded_target
        && linux_mount_target_contains_directory(
          target: row.mount.target,
          directory: directory,
        ) {
        linux_more_specific_backing_mount(
          current: selected,
          candidate: row,
        )
      } else {
        selected
      },
  )
}

fn linux_mount_option_value(
  row: LinuxProcMountRow,
  name: NonEmptyStr,
) -> NonEmptyStr? {
  fold(
    row.options,
    init: none,
    f: (selected, option) =>
      match selected {
        Present { value: _ } => selected
        Absent =>
          if starts_with(s: option, prefix: name as String)
            && option.length() > name.length() + 1
            && substring(
              s: option,
              start: name.length(),
              end: name.length() + 1,
            ) == "=" {
            Present {
              value: substring(
                s: option,
                start: name.length() + 1,
                end: option.length(),
              ) as NonEmptyStr,
            }
          } else {
            none
          }
      },
  )
}

fn linux_overlay_observation_from_rows(
  rows: List<LinuxProcMountRow>,
) -> LinuxOverlayParse {
  match linux_proc_mount_row_for_target(
    rows: rows,
    target: "/",
  ) {
    Absent => LinuxOverlayRefused { cause: LinuxOverlayRootMountMissing }
    Present { value: root } =>
      if !(root.mount.filesystem == LinuxOverlayFs) {
        LinuxOverlayRefused { cause: LinuxOverlayRootIsNotOverlay }
      } else {
        match linux_mount_option_value(row: root, name: "lowerdir") {
          Absent =>
            LinuxOverlayRefused { cause: LinuxOverlayLowerDirectoryMissing }
          Present { value: lower } =>
            if string_contains(s: lower as String, pattern: ":") {
              LinuxOverlayRefused {
                cause: LinuxOverlayMultipleLowerDirectoriesUnsupported {
                  wire: lower,
                },
              }
            } else if !starts_with(s: lower as String, prefix: "/") {
              LinuxOverlayRefused {
                cause: LinuxOverlayDirectoryNotAbsolute { path: lower },
              }
            } else {
              match linux_mount_option_value(row: root, name: "upperdir") {
                Absent =>
                  LinuxOverlayRefused {
                    cause: LinuxOverlayUpperDirectoryMissing,
                  }
                Present { value: upper } =>
                  if !starts_with(s: upper as String, prefix: "/") {
                    LinuxOverlayRefused {
                      cause: LinuxOverlayDirectoryNotAbsolute { path: upper },
                    }
                  } else {
                    match linux_proc_mount_backing_row(
                      rows: rows,
                      directory: lower,
                      excluded_target: root.mount.target,
                    ) {
                      Absent =>
                        LinuxOverlayRefused {
                          cause: LinuxOverlayLowerBackingMountMissing {
                            directory: lower,
                          },
                        }
                      Present { value: lower_row } =>
                        match linux_proc_mount_backing_row(
                          rows: rows,
                          directory: upper,
                          excluded_target: root.mount.target,
                        ) {
                          Absent =>
                            LinuxOverlayRefused {
                              cause: LinuxOverlayUpperBackingMountMissing {
                                directory: upper,
                              },
                            }
                          Present { value: upper_row } =>
                            LinuxOverlayParsed {
                              observation: LinuxOverlayObservation {
                                merged_mount: root.mount,
                                lower_directory: lower,
                                upper_directory: upper,
                                lower_backing_mount: lower_row.mount,
                                upper_backing_mount: upper_row.mount,
                              },
                            }
                        }
                    }
                  }
              }
            }
        }
      }
  }
}

fn linux_overlay_observation_from_proc_mounts(
  proc_mounts: String,
) -> LinuxOverlayParse {
  match linux_proc_mounts_parse(proc_mounts: proc_mounts) {
    LinuxProcMountsRefused {
      line_number: line_number,
      cause: cause,
    } =>
      LinuxOverlayRefused {
        cause: LinuxOverlayProcMountsRefused {
          line_number: line_number,
          cause: cause,
        },
      }
    LinuxProcMountsParsed { rows: rows } =>
      linux_overlay_observation_from_rows(rows: rows)
  }
}

fn linux_overlay_observation_is_flash_backed(
  observation: LinuxOverlayObservation,
) -> Bool {
  observation.merged_mount.target == "/"
    && observation.merged_mount.filesystem == LinuxOverlayFs
    && observation.lower_backing_mount.filesystem == LinuxSquashFs
    && observation.upper_backing_mount.filesystem == LinuxJffs2
    && linux_mount_target_contains_directory(
      target: observation.lower_backing_mount.target,
      directory: observation.lower_directory,
    )
    && linux_mount_target_contains_directory(
      target: observation.upper_backing_mount.target,
      directory: observation.upper_directory,
    )
}

// Literal mechanism facts precede any durability judgment. Linux rename replacement is atomic when
// replacing an existing pathname on the same filesystem; Linux sync writes pending filesystem
// metadata and cached file data to the underlying filesystems and waits for I/O completion.
// OverlayFS names the writable upper directory separately from the lower directory. Synchronized
// durability commit is admitted only through the LinuxSynchronizedRenameReplacePublication unit
// variant; partial protocol records remain explicitly unsynchronized. This module records those
// operations and observed mount relationships; it does not itself claim survival across a lifecycle
// boundary.

data linux_proc_mounts_parser_dissolve_on: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: a cited proc_mounts grammar row set lands in the shared grammar substrate with forward ingest and escape decoding. linux_proc_mount_row_from_line then becomes that grammar forward fold, and the same rows own any later serialization; until then this parser is the declared six-field Linux wire scaffold, fail-closed through LinuxProcMountLineRefusal rather than a second typed represent")
