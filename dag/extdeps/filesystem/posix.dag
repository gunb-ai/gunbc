module extdeps.filesystem.posix


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.filesystem.types { EntryKind }
import std.types { Int }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/basedefs/sys_stat.h.html"
  }
}

// Reading: POSIX sys_stat.h basedefs owns the file-type macros; type PosixFileType is the seven S_IF* constants exactly, so the type is the surface this citation owns.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.filesystem.posix", decl_name: "PosixFileType", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type PosixFileType
  = S_IFREG
  | S_IFDIR
  | S_IFLNK
  | S_IFIFO
  | S_IFSOCK
  | S_IFCHR
  | S_IFBLK

fn posix_entry_kind(t: PosixFileType) -> EntryKind {
  match t {
    S_IFREG  => RegularFile
    S_IFDIR  => Directory
    S_IFLNK  => Symlink
    S_IFIFO  => Other
    S_IFSOCK => Other
    S_IFCHR  => Other
    S_IFBLK  => Other
  }
}

// POSIX sys/stat.h: st_dev identifies the device containing the file and st_ino the inode on that
// device; neither number alone identifies a file. dev_t and ino_t are unsigned (64-bit on the Linux
// hosts this repository realizes), but a host channel carries Int and std.integer has no UInt64 value
// transport, so the fields are Int and the sole mint of a handle (extdeps.filesystem.filesystem_io
// filesystem_handle_open) REFUSES a negative reading, which is how an unsigned value above i64::MAX
// would arrive; it never wraps one into a plausible identity. This is a reading of a retained inode, not a permanent name
// after unlink and inode reuse: it identifies the file only while some descriptor holds it open.
type PosixFileIdentity {
  st_dev: Int
  st_ino: Int
}

// WHAT fstat(2) ANSWERS ABOUT AN OPEN DESCRIPTOR: the identity, the type, the owner and the mode,
// read together from one call so they describe the same inode.
type PosixFileStat {
  identity: PosixFileIdentity
  file_type: PosixFileType
  st_uid: Int
  st_gid: Int
  st_mode: Int
}
