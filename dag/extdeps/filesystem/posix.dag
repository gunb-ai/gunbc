module extdeps.filesystem.posix


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/basedefs/sys_stat.h.html"
  }
}

type PosixFileType
  = S_IFREG
  | S_IFDIR
  | S_IFLNK
  | S_IFIFO
  | S_IFSOCK
  | S_IFCHR
  | S_IFBLK

fn posix_entry_kind(t: PosixFileType) -> std.filesystem.types.EntryKind {
  match t {
    S_IFREG  => RegularFile
    S_IFDIR  => Directory
    S_IFLNK  => Symlink
    S_IFIFO  => Other
    S_IFSOCK => Other
    S_IFCHR  => Other
    S_IFBLK  => Other
  }
}
