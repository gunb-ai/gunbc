module gunbc.fleet_reach_endpoint


// Probe-endpoint resolution (bold-eagle-107's projection, offered via witty-raven
// msg_1c4e0bce; homed HERE — downstream of both gunbc.spark.dgx_procurement and the
// reach probe — so procurement never imports reach machinery). The srv5/srv6 resolution
// gap is NOT missing DNS: the addresses are already modeled as cited CR1000A DHCP-lease
// rows joined to fleet identity by an OperatorAllocation receipt, and nothing publishes
// 'srv5'/'srv6' as resolvable names. A probe that resolves HOSTNAMES therefore fails for
// every Spark forever regardless of host state; the fix is consuming the modeled
// endpoint. SlotAssigned projects the reservation's address; SlotUnassigned projects NO
// endpoint — never a placeholder (a fabricated address would be the §5 plausible-output
// trap aimed at the network).
fn spark_endpoint_for_binding(binding: gunbc.dgx_spark_procurement.DgxSparkRouterBinding) -> String? {
  match binding {
    gunbc.spark.dgx_procurement.SlotAssigned { identity: _, reservation: r, allocation: _ } =>
      Present { value: render_ipv4_address(addr: r.ipv4_address) as String }
    gunbc.spark.dgx_procurement.SlotUnassigned { identity: _ } => none
  }
}

// Fleet-wide: a host with a modeled endpoint probes AT that endpoint; every other host
// probes by name (srv1-srv4 resolve via the LAN today). The receipt stays keyed by the
// fleet IDENTITY either way — the endpoint is transport addressing, not identity.
fn fleet_probe_endpoint_for(host: String) -> String {
  fold(dgx_spark_router_bindings, init: host, f: fn(acc, b) {
    match b {
      gunbc.spark.dgx_procurement.SlotAssigned { identity: i, reservation: r, allocation: _ } =>
        if (i as String) == host {
          render_ipv4_address(addr: r.ipv4_address) as String
        } else {
          acc
        }
      gunbc.spark.dgx_procurement.SlotUnassigned { identity: _ } => acc
    }
  })
}

// The fleet reach roster — every identity a reach-layer consumer (probe, collector,
// key scan) walks. Homed HERE (moved from host_reach_identity_probe) so enrollment and
// probe can both consume it without an import cycle: enrollment -> endpoint <- probe.
data fleet_reach_probe_targets: std.types.List<String> = ["srv1", "srv2", "srv3", "srv4", "srv5", "srv6"]

// Ruling msg_43a8fd77 item 2: the REMOTE PRINCIPAL is an explicit typed fact per host,
// never the implicit ssh default (local-username inheritance is an absorbing default —
// a probe that authenticates as whatever account happens to run it is not probing a
// modeled principal). srv1-srv4: ghrunner, the runner account (its EXISTENCE on
// srv2-srv4 is verified by the first successful dispatch there, recorded not assumed —
// the self-enrollment receipt carries whoami). srv5/srv6: PENDING — bold-eagle-107's
// fleet-key verification used an account this module does not know yet
// (msg_a61db42c asked; the answer lands here with its receipt cited), and a pending
// principal keeps the bare endpoint (today's behavior) rather than fabricating a user.
// TARGET STATE, registered not built: ONE fleet-automation POSIX account fleet-wide as
// the probe principal (aligns with SPARK-SERVE-0 account subsumption), dissolving this
// per-host heterogeneity.
type FleetProbePrincipal
  = ProbeUserKnown { user: String }
  | PrincipalAllocationPending { allocated: String, note: String }
  | ProbeUserPending { note: String }

// Principal ruling (parent msg_acfd9e31 item C/D, applied msg_8cf3d762): the fleet
// automation principal is the DEDICATED login account gunbc-fleet — bold-eagle's
// allocation for FleetAccountAutomation, the SAME label on all four hosts (their
// ruling: independence is a property of the grant, not of the string). It is carried
// here as the explicit typed field ONLY — nothing may parse the name to recover role or
// host. NOT ghrunner: ghrunner holds NOPASSWD systemctl/install/rm (root-equivalent),
// stays nologin, and the automation account gets NO sudo — probe/collect need read
// reach only. Applied + readback-verified on srv1/srv2 (uid 1001, shell /bin/bash,
// password locked, sudo refused, authorized_keys 0600 with exactly the fleet key);
// srv3/srv4 carry the allocated name but the account is NOT yet created there
// (bootstrap actor unreachable) — a standing DISTINCT from refused and from reachable.

fn fleet_probe_remote_user_for(host: String) -> FleetProbePrincipal {
  if host == "srv5" || host == "srv6" {
    ProbeUserPending {
      note: "bold-eagle-107 (msg_7428d9fc): the account NAME briansrls is well-supported (operator-supplied login for both Sparks; operator confirmed the name collision with the human account is coincidence) but WHICH principal the fleet-key probe authenticated as is unverified recollection — no retained artifact records it, so this stays Pending until a receipt exists (re-measurement needs operator clearance, through the convergence path, per the interactive-Spark stop-order). The KEY axis is typed separately (fleet_ssh_access fleet_automation_ssh_key_fingerprint); both Sparks' authorized_keys carry exactly fleet-automation@gunbc today (bootstrap node-orch key installed then REMOVED from both).",
    }
  } else {
    if host == "srv1" || host == "srv2" {
      ProbeUserKnown { user: "gunbc-fleet" }
    } else {
      PrincipalAllocationPending {
        allocated: "gunbc-fleet",
        note: "account allocated but not yet created on this host (msg_8cf3d762: bootstrap actor unreachable); probe targets the allocated name so the refusal is typed at auth, never a fabricated reachable",
      }
    }
  }
}

// Repair #1 (operator scan of #8083, 2026-08-09): an unobserved principal MUST NOT reach
// SSH. The prior fleet_probe_ssh_target_for handed ProbeUserPending a BARE endpoint, so
// the ssh client picked the remote username from ambient config — the implicit-user
// behavior this module's own comments forbid — and if the ambient name authenticated the
// probe would report reach under an UNMODELED principal. FleetProbeTarget makes the
// principal part of the target: ProbeTargetReady carries an explicit remote_principal, and
// ProbeTargetRefused (PrincipalUnobserved | EndpointUnobserved) has NO endpoint at all, so
// there is nothing to hand ssh. PrincipalAllocationPending is Ready against the ALLOCATED
// name (a modeled principal — its auth refusal is the honest per-host signal); only
// ProbeUserPending — a genuinely unobserved principal, the Sparks today — refuses.
type ProbeTargetRefusalCause
  = PrincipalUnobserved { note: String }
  | EndpointUnobserved { note: String }

type FleetProbeTarget
  = ProbeTargetReady { host: String, endpoint: String, remote_principal: String }
  | ProbeTargetRefused { host: String, cause: ProbeTargetRefusalCause }

fn fleet_probe_target_for(host: String) -> FleetProbeTarget {
  match fleet_probe_remote_user_for(host: host) {
    ProbeUserKnown { user: u } =>
      ProbeTargetReady { host: host, endpoint: fleet_probe_endpoint_for(host: host), remote_principal: u }
    PrincipalAllocationPending { allocated: u, note: _ } =>
      ProbeTargetReady { host: host, endpoint: fleet_probe_endpoint_for(host: host), remote_principal: u }
    ProbeUserPending { note: n } =>
      ProbeTargetRefused { host: host, cause: gunbc.fleet_reach_endpoint.PrincipalUnobserved { note: n } }
  }
}

// The transport address for a READY target only — an "principal@endpoint" string. A
// refused target never reaches here (probe_host_reach_once matches the target first), so
// there is no bare-endpoint arm to fall through to an ambient username.
fn fleet_probe_ready_ssh_target(t_host: String, endpoint: String, remote_principal: String) -> String {
  join([remote_principal, "@", endpoint], "")
}
