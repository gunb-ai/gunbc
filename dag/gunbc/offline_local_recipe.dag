module gunbc.offline_local_recipe

import std.types { String, List, Bool, NonEmptyStr }
import std.execution_mode { ExecutionMode, Hermetic, Wet, Record }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import gunbc.ci_layer_roots {
  WitnessExclusionRow,
  witness_exclusion_frontier,
  witness_layer_roots
}
import gunbc.cli_invoke { source_root_transport_argv }
import std.witness_admission { OfflineLocalRecipe, witness_consumer_cadence_eq }

// THE LOCAL RECIPE IS THE CONSUMER OF RECORD FOR AN OFFLINE-CLASSIFIED WITNESS, AND
// UNTIL THIS MODULE IT WAS PROSE. gunbc.ci_layer_roots witness_admission_offline_note
// names six paired notes as the Phase 0(b) admission invariant and ends "Dissolves when
// each row graduates to a scheduled CI consumer or deletes". Every one of those six
// carried its recipe as a sentence inside a String. A sentence cannot fail: nothing
// resolves the entry path it names, nothing checks the functions it lists, and no
// cadence runs it -- so the consumer an operator-ruled CI exclusion STANDS ON can rot
// to nothing with no signal at all. That is DESIGN.md section 4c read from the inside:
// a recipe is a machine-consumed fact and belongs in a typed carrier.
//
// WHAT THIS CARRIER IS AND IS NOT. It is the authority for WHAT THE RECIPE IS -- the
// entry, the functions, the execution mode -- so that the recipe becomes a thing a
// consumer can read, join and refuse over. It is NOT a claim that the recipe ran: no
// row here asserts a verdict, and offline_recipe_consumer_defects below carries the
// separate, dated, declared population of recipes MEASURED not to produce one.
data offline_local_recipe_authority_note: String = "Typed authority for the documented OfflineLocalRecipe consumers named in gunbc.ci_layer_roots witness_admission_offline_note -- five of the six policies it enumerates, the sixth deliberately absent for the reason identity_captured_navigation_recipe_absence_note states. Replaces the prose recipe sentence in each paired note as the authority for the invocation; the notes keep their rationale and cite this carrier for the command. The rows carry no measurement -- a recipe row is a declaration, not a receipt -- and the measured non-executing population is the separate declared roster offline_recipe_consumer_defects."

// A recipe names either ONE entry file, or a directory HOME whose residents each take
// the same invocation shape. long_lane_exclusion_note is the second kind: test/claim/long/
// is a home with thirteen-plus residents and no fixed entry, so a row that stored one
// entry for it would be inventing a subject the note does not have.
type RecipeSubject
  = RecipeEntry { path: NonEmptyStr }
  | RecipeHome { path_prefix: NonEmptyStr }

// Which functions the invocation names. There is no whole-entry arm, and its absence is
// a fact about the tool rather than a modelling preference: claim_batch REFUSES an
// invocation carrying neither --function nor --functions ("--entry <e> has no --function
// or --functions", measured by execution on 7fbbb84202), so a recipe that names an entry
// and no function does not run. RecipeCallerChosen is the <fn> / <csv> template form --
// the recipe fixes the entry and the caller picks the function -- and it is a distinct
// state from RecipeFunctions rather than an empty name list, which would make "the caller
// chooses" and "this recipe names nothing" indistinguishable at the carrier.
type RecipeSelection
  = RecipeFunctions { names: List<NonEmptyStr> }
  | RecipeCallerChosen

type OfflineLocalRecipeRow {
  policy: NonEmptyStr
  subject: RecipeSubject
  selection: RecipeSelection
  mode: ExecutionMode
}

