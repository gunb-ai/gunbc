import gunbc.generated_workflow_provenance {
  generated_workflow_provenance_header, GeneratedWorkflowProvenanceHeaderProduced, GeneratedWorkflowProvenanceHeaderNotApplicable
}

// THE ARTIFACTS A SCHEDULED DRIFT CHECK JUDGES, PRODUCED WITHOUT THE REGISTRY'S CLOSURE.
//
// The workflows, the per-host runner sudoers, the githooks, .gitignore, .gitattributes and the fci1
// context are registry artifacts whose producers import no plan and no census. Asking
// gunbc.generated_artifact_emit artifact_generate for one loads every producer the registry names --
// a 2,659-file closure, 21.4 GiB peak measured for the whole-registry observation, too close to the
// 22 GiB slot ceiling to run on it. These producers need none of that, so a check that must fit the
// slot asks them here. gunbc.generated_artifact_emit delegates the same arms to this module: the
// content has one author and this is the narrow door to it, not a second path beside it.
//
// NOT HERE: GeneratedArtifactMergeDriverArtifact, whose body takes the registry's
// heal-regenerated path set and so cannot be produced without the registry; it stays with the
// whole-registry observation.
type TierOArtifactBody
  = TierOArtifactProduced { content: String }
  | TierOArtifactRefused { reason: String }
  | TierOArtifactNotTierO

fn tier_o_fixed_artifacts() -> List<GeneratedArtifact> {
  [
    WitnessFloorYamlArtifact,
    FleetConvergeYamlArtifact,
    MicrovmShakedownYamlArtifact,
    InstrumentDispatchYamlArtifact,
    HealWorkflowYamlArtifact,
    HealPublisherWorkflowYamlArtifact,
    BranchRunGrantBrokerWorkflowYamlArtifact,
    DriftWatchWorkflowYamlArtifact,
    GitignoreArtifact,
    GitattributesArtifact,
    GithooksPrePushArtifact,
    GithooksPreCommitArtifact,
    ReleaseBinsConsumerCheckScriptArtifact,
    Fci1BoundedExecutionContextArtifact
  ]
}

// The roster is the set of arms tier_o_artifact_body answers; a witness joins it to the registry by
// path so a Tier O artifact added to one and not the other is a located finding.
fn tier_o_artifacts() -> List<GeneratedArtifact> {
  concat(tier_o_fixed_artifacts(), map(fleet_intent_known_hosts, h => RunnerHostSudoersArtifact { host: h.identity }))
}

// THE GENERATED-WORKFLOW REFUSAL GATE (gunbc.design_argument::fail_closed). Committed workflow bytes are
// the route a refused run-step target actually harms through: CI RUNS them. A refusal reaching a committed
// workflow must therefore refuse at the generated-artifact gate, before the bytes are committed -- not at
// the argv crossing, where a witness building a bad script in memory harms nothing. So every arm above
// that produces a committed workflow passes its bytes through this one point, which both doors take
// (gunbc.generated_artifact_emit artifact_generate and tier_o_artifact_body above), and any generated
// workflow embedding a run-step emission refusal marker -- the __GUNBC_INVOKE_EMIT_REFUSED__ family, which
// includes gunbc.ci.ci_run_step_target's poison for a target whose module derives no storage path -- is
// refused here with a typed reason rather than committed. A generated workflow that renders cleanly
// returns unchanged: this gate refuses, it never rewrites.
fn tier_o_workflow_produced(content: String) -> TierOArtifactBody {
  if string_contains(s: content, pattern: "__GUNBC_INVOKE_EMIT_REFUSED__") {
    TierOArtifactRefused {
      reason: "generated workflow embeds a __GUNBC_INVOKE_EMIT_REFUSED__ emission refusal marker: a run-step target could not be rendered (word wall, orchestration refusal, or a module deriving no storage path through gunbc.source_layout layout_module_storage_path); refusing rather than committing a workflow whose step was refused (gunbc.design_argument::fail_closed)"
    }
  } else {
    TierOArtifactProduced { content: content }
  }
}

fn tier_o_unadorned_body(a: GeneratedArtifact) -> TierOArtifactBody {
  match a {
    WitnessFloorYamlArtifact => match expected_compiler_gate_yml() {
      WitnessFloorGenerated { content } => tier_o_workflow_produced(content: content)
      WitnessFloorGenerationRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    FleetConvergeYamlArtifact => match expected_fleet_converge_yml() {
      FleetConvergeYamlGenerated { content } => tier_o_workflow_produced(content: content)
      FleetConvergeYamlGenerationRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    MicrovmShakedownYamlArtifact => match expected_microvm_shakedown_yml() {
      MicrovmShakedownWorkflowGenerated { content } => tier_o_workflow_produced(content: content)
      MicrovmShakedownWorkflowGenerationRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    InstrumentDispatchYamlArtifact => match expected_instrument_dispatch_yml() {
      InstrumentDispatchWorkflowGenerated { content } => tier_o_workflow_produced(content: content)
      InstrumentDispatchWorkflowGenerationRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    HealWorkflowYamlArtifact => match expected_heal_workflow_yml() {
      HealWorkflowGenerated { content } => tier_o_workflow_produced(content: content)
      HealWorkflowGenerationRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    HealPublisherWorkflowYamlArtifact => match expected_heal_publisher_workflow_yml() {
      HealPublisherWorkflowGenerated { content } => tier_o_workflow_produced(content: content)
      HealPublisherWorkflowGenerationRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    BranchRunGrantBrokerWorkflowYamlArtifact => match expected_branch_run_grant_broker_workflow_yml() {
      BranchRunGrantBrokerWorkflowGenerated { content } => tier_o_workflow_produced(content: content)
      BranchRunGrantBrokerWorkflowGenerationRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    DriftWatchWorkflowYamlArtifact => match expected_drift_watch_workflow_yml() {
      DriftWatchWorkflowGenerated { content } => tier_o_workflow_produced(content: content)
      DriftWatchWorkflowGenerationRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    GitignoreArtifact => TierOArtifactProduced { content: expected_gitignore() }
    GitattributesArtifact => match expected_gitattributes() {
      GitattributesGenerated { content } => TierOArtifactProduced { content: content }
      GitattributesGenerationRefused => TierOArtifactRefused { reason: "generated projection path population refused" }
    }
    GithooksPrePushArtifact => TierOArtifactProduced { content: expected_githooks_pre_push_sh() }
    GithooksPreCommitArtifact => TierOArtifactProduced { content: expected_githooks_pre_commit_sh() }
    ReleaseBinsConsumerCheckScriptArtifact => TierOArtifactProduced { content: release_bins_consumer_key_check_script() }
    Fci1BoundedExecutionContextArtifact => match expected_fci1_bounded_execution_context_env() {
      Fci1BoundedExecutionContextEmitted { content } => TierOArtifactProduced { content: content }
      Fci1BoundedExecutionContextEmissionRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    RunnerHostSudoersArtifact { host } => match runner_host_sudoers_body(host: host, artifact_path: artifact_path(a: a)) {
      RunnerHostSudoersBodyProduced { content } => TierOArtifactProduced { content: content }
      RunnerHostSudoersBodyRefused { reason } => TierOArtifactRefused { reason: reason }
    }
    _ => TierOArtifactNotTierO
  }
}

// The committed bytes of a generated workflow open with its provenance header; every other Tier O
// artifact is committed as produced. gunbc.generated_workflow_provenance owns which is which, so
// this adds the header exactly where artifact_generate does.
fn tier_o_artifact_body(a: GeneratedArtifact) -> TierOArtifactBody {
  match tier_o_unadorned_body(a: a) {
    TierOArtifactProduced { content } => match generated_workflow_provenance_header(a: a) {
      GeneratedWorkflowProvenanceHeaderProduced { content: header } => tier_o_workflow_admitted(a: a, committed: concat(header, content), max: workflow_file_size_max)
      GeneratedWorkflowProvenanceHeaderNotApplicable => TierOArtifactProduced { content: content }
    }
    TierOArtifactRefused { reason } => TierOArtifactRefused { reason: reason }
    TierOArtifactNotTierO => TierOArtifactNotTierO
  }
}

// A WORKFLOW GITHUB WILL NOT START IS REFUSED HERE, NOT DISCOVERED ON DISPATCH. A workflow file over
// extdeps.github.actions workflow_file_size_max starts no runs: the dispatch reports startup_failure with
// no job, and nothing on the required path notices (gunbc.recurring_failure_mode::
// a_generated_workflow_grows_past_the_size_github_will_start). Every generated workflow's committed
// bytes are formed in tier_o_artifact_body, header included, so this one check covers all of them. The
// ceiling is a parameter so a witness can supply a small one; production passes workflow_file_size_max.
// The limit's scope is its citation's: "each workflow file in the .github/workflows directory". An artifact
// with a provenance header outside that directory (a script a workflow runs) is not a workflow file.
fn tier_o_workflow_admitted(a: GeneratedArtifact, committed: String, max: ByteSize) -> TierOArtifactBody {
  if artifact_directory(a: a) != github_actions_workflows_dir || workflow_file_within(content: committed, max: max) {
    TierOArtifactProduced { content: committed }
  } else {
    TierOArtifactRefused { reason: join([
      artifact_path(a: a), " is ", to_string(workflow_file_octets(content: committed)),
      " bytes, over GitHub's workflow file size limit of ", to_string(byte_size_count(max)),
      " (extdeps.github.actions workflow_file_size_max): GitHub would start no runs from it. Move shared steps into a composite action or split the workflow; never trim the check.",
    ], "") }
  }
}
