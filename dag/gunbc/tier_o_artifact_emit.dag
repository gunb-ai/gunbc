module gunbc.tier_o_artifact_emit

import std.types { List, String }
import extdeps.github.actions { workflow_file_size_max, workflow_file_within, workflow_file_octets }
import std.measure { ByteSize, byte_size_count }
import extdeps.github.ci { github_actions_workflows_dir }
import gunbc.generated_artifact { GeneratedArtifact, artifact_path, artifact_directory }
import gunbc.fleet.fleet_intent { fleet_intent_known_hosts }
import gunbc.generated_artifact_production {
  GeneratedArtifactProduction, ArtifactGenerated, ArtifactGenerationRefused,
  generated_workflow_provenance_header, GeneratedWorkflowProvenanceHeaderProduced, GeneratedWorkflowProvenanceHeaderNotApplicable
}
import gunbc.drift_watch_workflow { drift_watch_workflow_yaml_artifact_production }
import gunbc.fabric.fci1_bounded_execution_context_emit { fci1_bounded_execution_context_artifact_production }
import gunbc.fleet.branch_run_grant_broker_workflow { branch_run_grant_broker_workflow_yaml_artifact_production }
import gunbc.fleet.fleet_converge_workflow { fleet_converge_yaml_artifact_production }
import gunbc.fleet.fleet_release_bins_key { release_bins_consumer_check_script_artifact_production }
import gunbc.gitattributes_emit { gitattributes_artifact_production }
import gunbc.githooks.githooks_pre_commit_emit { githooks_pre_commit_artifact_production }
import gunbc.githooks.githooks_pre_push_emit { githooks_pre_push_artifact_production }
import gunbc.gitignore_emit { gitignore_artifact_production }
import gunbc.heal_publisher_workflow { heal_publisher_workflow_yaml_artifact_production }
import gunbc.heal_workflow { heal_workflow_yaml_artifact_production }
import gunbc.instruments.instrument_dispatch_workflow { instrument_dispatch_yaml_artifact_production }
import gunbc.runner.runner_host_grants { runner_host_sudoers_artifact_production }
import gunbc.runner.runner_microvm_shakedown_workflow { microvm_shakedown_yaml_artifact_production }
import gunbc.site.gunb_ai_pages_workflow { gunb_ai_pages_workflow_yaml_artifact_production }
import gunbc.witness.compiler_gate_workflow { witness_floor_yaml_artifact_production }
import gunbc.witness.hosted_runner_shadow_gate_workflow { hosted_runner_shadow_gate_yaml_artifact_production }

type TierOArtifactBody
  = TierOArtifactProduced { content: String }
  | TierOArtifactRefused { reason: String }

fn tier_o_fixed_productions() -> List<GeneratedArtifactProduction> {
  [
    witness_floor_yaml_artifact_production,
    fleet_converge_yaml_artifact_production,
    microvm_shakedown_yaml_artifact_production,
    instrument_dispatch_yaml_artifact_production,
    heal_workflow_yaml_artifact_production,
    heal_publisher_workflow_yaml_artifact_production,
    branch_run_grant_broker_workflow_yaml_artifact_production,
    hosted_runner_shadow_gate_yaml_artifact_production,
    drift_watch_workflow_yaml_artifact_production,
    gunb_ai_pages_workflow_yaml_artifact_production,
    gitignore_artifact_production,
    gitattributes_artifact_production,
    githooks_pre_push_artifact_production,
    githooks_pre_commit_artifact_production,
    release_bins_consumer_check_script_artifact_production,
    fci1_bounded_execution_context_artifact_production
  ]
}

fn tier_o_productions() -> List<GeneratedArtifactProduction> {
  concat(tier_o_fixed_productions(), map(fleet_intent_known_hosts, h => runner_host_sudoers_artifact_production(host: h.identity)))
}

fn tier_o_artifacts() -> List<GeneratedArtifact> {
  map(tier_o_productions(), p => p.artifact)
}

fn tier_o_artifact_body(production: GeneratedArtifactProduction) -> TierOArtifactBody {
  match production.generate() {
    ArtifactGenerated { content } => match generated_workflow_provenance_header(provenance: production.provenance) {
      GeneratedWorkflowProvenanceHeaderProduced { content: header } => tier_o_workflow_admitted(a: production.artifact, committed: concat(header, content), max: workflow_file_size_max)
      GeneratedWorkflowProvenanceHeaderNotApplicable => TierOArtifactProduced { content: content }
    }
    ArtifactGenerationRefused { reason } => TierOArtifactRefused { reason: reason }
  }
}

// A WORKFLOW GITHUB WILL NOT START IS REFUSED HERE, NOT DISCOVERED ON DISPATCH. A workflow file over
// extdeps.github.actions workflow_file_size_max starts no runs: the dispatch reports startup_failure with
// no job, and nothing on the required path notices (gunbc.recurring_failure_mode::
// a_generated_workflow_grows_past_the_size_github_will_start). Every generated workflow's committed
// bytes are formed in tier_o_artifact_body, header included, so this one check covers all of them. The
// ceiling is a parameter so a witness can supply a small one; production passes workflow_file_size_max.
// The limit's scope is its citation's: "each workflow file in the .github/workflows directory". An artifact
// with a provenance header outside that directory (a script a workflow runs) is not a workflow file.
fn tier_o_workflow_admitted(a: GeneratedArtifact, committed: String, max: ByteSize) -> TierOArtifactBody {
  if artifact_directory(a: a) != github_actions_workflows_dir || workflow_file_within(content: committed, max: max) {
    TierOArtifactProduced { content: committed }
  } else {
    TierOArtifactRefused { reason: join([
      artifact_path(a: a), " is ", to_string(workflow_file_octets(content: committed)),
      " bytes, over GitHub's workflow file size limit of ", to_string(byte_size_count(max)),
      " (extdeps.github.actions workflow_file_size_max): GitHub would start no runs from it. Move shared steps into a composite action or split the workflow; never trim the check.",
    ], "") }
  }
}
