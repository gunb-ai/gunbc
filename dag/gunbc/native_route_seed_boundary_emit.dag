module gunbc.native_route_seed_boundary_emit

import extdeps.bazel.target_pattern { TargetPattern, render_target_pattern }
import extdeps.languages.rust.string_literal { escape_rust_cooked_string_literal_body }
import gunbc.native_route_universe { native_route_default_pattern }
import std.types { String }

// THE NATIVE TEST ROUTE'S BOUNDARY, PROJECTED INTO THE SEED SO THE SEED STOPS MIRRORING IT.
//
// `gunbc test <operand>` must decide, before any binary exists, whether the operand belongs to the
// native route (the emitted compiler adjudicates it) or to another route. That decision needs the
// route's boundary, `gunbc.native_route_universe` `native_route_default_pattern`, and the seed used
// to carry its own hand-written copy of that one fact. A copy that nothing joins to its authority is
// a second authority for the boundary (DESIGN section 3): move the declaration and the seed routes by
// the old boundary, silently, until someone reads both.
//
// WHY A GENERATED CONSTANT AND NOT A RUNTIME READ OF THE DECLARATION. The decision is taken before
// the emitted compiler is built, and reading the declaration at that point means evaluating the
// module that owns it on every invocation, which is the interpreter-backed work the native route
// exists to leave. So the one declaration is rendered into the seed at regeneration instead, and the
// seed parses the constant with its own pattern parser. The reasoning is the one
// gunbc.release_locus_seed_constants_emit records for the release-locus spawn contract, and the
// consequence is the same: a spelling that moves on the .dag side moves in the seed at the next
// regeneration, and one hand-edited in the generated file is refused by the generated-artifact
// drift wall. Construction over validation (DESIGN section 5).
//
// WHY A DEDICATED ARTIFACT. Its subject is the native route's boundary as the seed's router reads
// it. Appending the constant to the release-locus file, whose subject is the spawn contract, would be
// the DESIGN section 3 fork that file's own note names.
//
// WHAT IS NOT PROJECTED. The claim route's universe, `gunbc.discovery_census` `claim_route_universe`,
// stays hand-mirrored in the seed (`target_invocation_host` `claim_route_universe`). That mirror is
// disclosed and out of scope here: this artifact removes the native boundary's second author, not
// every route constant's.
//
// THE LITERAL BELOW IS NOT AUTHORED HERE. This emitter evaluates the declaration, renders it with the
// pattern authority's own renderer and escapes the result; the boundary's text appears nowhere in
// this module. An emitter that spelled it in its own template would be a third authority, and the
// authority-movement claim -- supply a moved pattern, require its rendering in the generated Rust and
// zero occurrences of the old one -- would pass while proving nothing.
fn native_route_seed_boundary_generated_rs(pattern: TargetPattern) -> String {
  concat(
    concat(
      "// Generated by gunbc native_route_seed_boundary_emit — do not hand-edit.\n",
      "// Authority: gunbc.native_route_universe native_route_default_pattern. The native test route's\n// boundary, rendered so the seed's pre-binary routing reads it rather than mirroring it: regenerate\n// rather than edit.\n",
    ),
    concat(
      "pub(crate) const NATIVE_ROUTE_DEFAULT_PATTERN: &str = \"",
      concat(escape_rust_cooked_string_literal_body(s: render_target_pattern(pattern: pattern)), "\";\n"),
    ),
  )
}

fn expected_native_route_seed_boundary_generated_rs() -> String {
  native_route_seed_boundary_generated_rs(pattern: native_route_default_pattern())
}
