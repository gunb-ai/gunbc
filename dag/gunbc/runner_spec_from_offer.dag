module gunbc.runner_spec_from_offer

import extdeps.github.actions { RunnerSpec, SelfHosted }
import gunbc.ci_fleet { ComputeOffer, gunbc_ci_fleet_offer }
import gunbc.fleet_intent { compute_host_primary_cpu }
import extdeps.cpu { cpu_facts_architecture }
import extdeps.toolchain.types { Architecture }
import std.os.types { KernelFamily }

fn kernel_runner_label(kernel: KernelFamily) -> String {
  match kernel {
    Linux => "linux"
    Darwin => "macos"
    WindowsNt => "windows"
    LinuxGuestOnWindows => "linux"
  }
}

fn cpu_architecture_runner_label(arch: Architecture) -> String {
  match arch {
    Aarch64 => "arm64"
    X86_64 => "x64"
    X86 => "x86"
    Arm => "arm"
    Armv7 => "arm"
    Riscv64 => "riscv64"
    Wasm32 => "wasm32"
    Mips => "mips"
    Mipsel => "mipsel"
    Mips64 => "mips64"
    Mips64el => "mips64el"
  }
}

fn runner_spec_from_offer(offer: ComputeOffer) -> RunnerSpec {
  let os = offer.supply.execution.os
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      SelfHosted { labels: concat(["self-hosted"], [kernel_runner_label(kernel: os.kernel)]) }
    Present { value: cpu } =>
      SelfHosted {
        labels: concat(
          concat(["self-hosted"], [kernel_runner_label(kernel: os.kernel)]),
          [cpu_architecture_runner_label(arch: cpu_facts_architecture(cpu: cpu))],
        ),
      }
  }
}

data ubicloud_iteration_routing_note: String = "ITERATION-ONLY (operator call 2026-07-11, this stack): CI routed to the Ubicloud managed runner pool (label ubicloud-standard-16-arm, the shape the workload-class admission model generalizes) because self-hosted slots are saturated and this lane needs CI turnaround; the 64GiB shape also removes the ~15GiB slot memory.high throttle receipted on the timed-out floors. Ubicloud runners register as label-routed runners, so the SelfHosted carrier emits the correct runs-on list; the fleet-offer derivation below is the durable authority. REVERT this override before merge to main (the #6107 trial -> #6111 revert precedent: no standing Ubicloud routing without an operator ruling on the fleet model)."

fn gunbc_ci_runner_spec_fleet_derived() -> RunnerSpec {
  runner_spec_from_offer(offer: gunbc_ci_fleet_offer)
}

fn gunbc_ci_runner_spec() -> RunnerSpec {
  SelfHosted { labels: ["ubicloud-standard-16-arm"] }
}
