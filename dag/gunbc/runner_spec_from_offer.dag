module gunbc.runner_spec_from_offer


fn kernel_runner_label(kernel: std.os.types.KernelFamily) -> String {
  match kernel {
    Linux => "linux"
    Darwin => "macos"
    WindowsNt => "windows"
    LinuxGuestOnWindows => "linux"
  }
}

fn cpu_architecture_runner_label(arch: extdeps.toolchain.types.Architecture) -> String {
  match arch {
    Aarch64 => "arm64"
    X86_64 => "x64"
    X86 => "x86"
    Arm => "arm"
    Armv7 => "arm"
    Riscv64 => "riscv64"
    Wasm32 => "wasm32"
    Mips => "mips"
    Mipsel => "mipsel"
    Mips64 => "mips64"
    Mips64el => "mips64el"
  }
}

fn runner_spec_from_offer(offer: gunbc.ci_fleet.ComputeOffer) -> extdeps.github.actions.RunnerSpec {
  let os = offer.supply.execution.os
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      extdeps.github.actions.SelfHosted { labels: concat(["self-hosted"], [kernel_runner_label(kernel: os.kernel)]) }
    Present { value: cpu } =>
      extdeps.github.actions.SelfHosted {
        labels: concat(
          concat(["self-hosted"], [kernel_runner_label(kernel: os.kernel)]),
          [cpu_architecture_runner_label(arch: cpu_facts_architecture(cpu: cpu))],
        ),
      }
  }
}

fn gunbc_ci_runner_spec() -> extdeps.github.actions.RunnerSpec {
  runner_spec_from_offer(offer: gunbc_ci_fleet_offer)
}
