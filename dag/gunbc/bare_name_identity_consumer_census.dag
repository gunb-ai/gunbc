    fact_sought: "whether this type node realizes as the host Option",
    keys_on: "authored_name_at equals Optional, with at least one child",
    identity: AvailableAtSite { holder_expression: "type_reference_decl_file(n: n) -- the same node n the predicate is given", adjacent_consulting_call: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "rust_render_checkpoint_scalar_bare") },
    outcome: SilentWrongProviderAnswer { what_is_emitted: "Option<..>, for any declaration anywhere in the closure spelled Optional" },
    reach: ReachabilityUnmeasured { what_would_settle_it: "a second declaration spelled Optional in an emitted closure; no such declaration was searched for, and no divergence is claimed" },
    sibling: SiblingPresentButUnreachable { sibling: decl_ref(module_path: "v1.compiler.coercion", decl_name: "type_realization_decision"), why_unreachable: "sits on the SECOND line of five of the same six renderers, ahead of every identity-keyed arm" },
    call_site_count: 6,
