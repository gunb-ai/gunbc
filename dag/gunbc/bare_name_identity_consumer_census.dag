module gunbc.bare_name_identity_consumer_census

import std.types { List, String, Bool, Int }
import std.decl_ref { DeclarationRef, decl_ref }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// THE ROSTER OF PLACES THE v1 RUST EMITTER DECIDES A REALIZATION FROM A BARE NAME RATHER THAN FROM
// THE RESOLVED DECLARATION IDENTITY. The rule being censused against, stated once so every row below
// is read against the same proposition: the resolved provider identity is the terminal fact, and a
// spelling is an INPUT to resolution, never an identity a downstream consumer may reinterpret.
//
// WHY A ROSTER AND NOT A REPAIR. Each known instance of this class was found by somebody tripping
// over it while measuring something else, and at least one of them had two independent consumers
// making the same mistake. Nobody knew how many there were. This carrier is that number, at the
// grain of the deciding function rather than of the occurrence -- an occurrence census over one
// closure is a different instrument, owned by royal-dove-436, and the two do not substitute for
// each other: this one says WHICH DECISIONS can be wrong, that one says HOW OFTEN one of them is.
//
// THE SEQUENCING THIS CARRIER EXISTS TO PROTECT. gunbc.empty_decl_file_checkpoint_bypass states it
// for its own row and it generalises to every row here: the sweep is a PRECONDITION for adding a
// refusal, never a follow-up to it. A refusal landed ahead of the population converts an uncounted
// silence into an uncounted red -- a defect nobody can see traded for an outage nobody predicted.
// NOTHING IN THIS PR REPAIRS ANY ROW.

// WHAT THE SITE COULD HAVE CONSULTED, and the discriminator the brief asks for between a design gap
// and an oversight. A row may not claim identity was available without NAMING the expression that
// holds it, because "available" asserted bare is the claim a reader most wants to check and the one
// an author is most tempted to assume.
//
// AvailableAtSite is the oversight arm: the resolved declaration file is computable from a node the
// deciding call already has, and at several rows it is computed on an ADJACENT LINE for a different
// question. AvailableUpstreamNotThreaded is the design gap that is still closable: the caller holds
// a node, the callee's signature has nowhere to put it. UnavailableNoNodeAtSite is the genuine gap:
// the value flowing into the decision is a String that was severed from its declaration earlier,
// so threading identity here requires re-shaping what upstream carries, not editing this call.
type IdentityAvailability
  = AvailableAtSite { holder_expression: String, adjacent_consulting_call: DeclarationRef }
  | AvailableUpstreamNotThreaded { nearest_holder: DeclarationRef }
  | UnavailableNoNodeAtSite { severed_at: DeclarationRef }

// WHAT HAPPENS TODAY when the bare key is absent, ambiguous, or names the wrong provider. The
// variants are ordered by how hard the outcome is to notice, worst first, and the distinction that
// matters most is between the middle two: AmbiguityDetectedThenAnswered means the site COMPUTED the
// fact that it could not decide and then decided anyway, which is strictly worse than never having
// looked, because the detection is what makes the refusal one line away rather than a redesign.
type BareKeyOutcome
  = SilentWrongProviderAnswer { what_is_emitted: String }
  | AmbiguityDetectedThenAnswered { sentinel: String, what_is_emitted: String }
  | SilentDefaultNoAnswer { what_is_emitted: String }
  | TypedRefusal { refusal_site: DeclarationRef }

// REACH IS NOT PRESENCE, AND IT IS ITS OWN COLUMN. A site no current input can reach is a real
// member with a real ceiling, not a false positive -- the six-renderer short-circuit is exactly
// that from the other direction (the authority is present and nothing reaches IT). Rows are never
// filtered on this field.
//
// The evidence bar is deliberately asymmetric, because the two claims are not equally cheap to get
// wrong. ReachedByMeasuredPopulation costs a named measurement. UnreachableByConstantBody costs a
// total-function fact -- the body is a literal, so NO input reaches an answer, which is a stronger
// claim than any emitted-output diff could produce and is decidable by reading the body alone.
// ReachabilityUnmeasured exists so that "I did not measure this" has a spelling; without it the
// only way to file a row is to claim something about it, and the roster would acquire fabricated
// reach the moment an author met a site they could not price.
type Reachability
  = ReachedByMeasuredPopulation { measurement: String }
  | UnreachableByConstantBody { body_answer: String }
  | ReachabilityUnmeasured { what_would_settle_it: String }

// WHETHER AN IDENTITY-KEYED SIBLING IS ALREADY SITTING BESIDE THIS SITE UNUSED. This is the column
// that decides the shape of the terminal repair: a row with a sibling is a ROUTING question, a row
// without one needs the authority built first. DESIGN section 5 says the answer to a roster of
// routing questions is one identity-keyed authority rather than N repaired lookups, which is why
// the sibling is recorded per row rather than summarised in prose.
//
// SiblingPresentButOrdered carries the precedence because that is the whole mechanism at several
// rows: the sibling is not missing, it is CONSULTED SECOND, and a bare-name arm that answers first
// makes the second arm unreachable however correct it is.
type IdentityKeyedSibling
  = SiblingPresentButOrdered { sibling: DeclarationRef, precedence: String }
  | SiblingPresentButUnreachable { sibling: DeclarationRef, why_unreachable: String }
  | NoSiblingExists { what_would_have_to_be_built: String }

type BareNameConsumer {
  site: DeclarationRef
  fact_sought: String
  keys_on: String
  identity: IdentityAvailability
  outcome: BareKeyOutcome
  reach: Reachability
  sibling: IdentityKeyedSibling
  call_site_count: Int
}

// THE ROSTER. Every row was established by reading the deciding function and its call sites in the
// live tree on 2026-08-22; the per-row method and the exact call-site lines are in
// docs/probes/bare-name-identity-consumer-census-2026-08-22.md. Rows are NOT ordered by severity --
// ordering a roster by an author's severity judgement is what lets a reader stop reading early.
data bare_name_identity_consumers: List<BareNameConsumer> = [
  {
    site: decl_ref(module_path: "v1.compiler.coercion", decl_name: "lookup_checkpoint"),
    fact_sought: "which Rust type this dag type realizes as",
    keys_on: "the bare dag_name against the extdeps checkpoint table, whenever decl_file is the empty string. A SECOND WAY THE SAME KEY MISSES, added 2026-08-22: the comparison against cp.dag_name is EXACT, so a QUALIFIED spelling cannot match a bare-keyed row at all -- the table is missed rather than mis-answered. crisp-crab-430 completed the leaf reduction that would close it, MEASURED IT, found it changed no emitted output anywhere but its own mirror, and REVERTED it rather than land an inert change inside a result narrative. Recorded here as a measured-inert repair rather than as an open item, because the next person to notice the exact comparison will otherwise re-derive and re-land it",
    identity: AvailableUpstreamNotThreaded { nearest_holder: decl_ref(module_path: "v1.compiler.coercion", decl_name: "type_reference_decl_file") },
    outcome: SilentWrongProviderAnswer { what_is_emitted: "the table's spelling for the name, with the structural-declaration roster never consulted" },
    reach: ReachedByMeasuredPopulation { measurement: "v1.compiler.emit emit_literal passes the empty string for every String literal; executed as literal_suffix_production_call_site_never_threads_declaration_identity in v1.tests.claim.checkpoint_identity_keying_witness_test" },
    sibling: SiblingPresentButOrdered { sibling: decl_ref(module_path: "v1.compiler.coercion", decl_name: "decl_file_declares_structurally"), precedence: "the empty-string guard returns false before the roster is reached, so the roster runs only for callers that already threaded identity" },
    call_site_count: 10,
  },
  {
    site: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "is_host_text_carrier_type"),
    fact_sought: "whether this type node realizes as the host String",
    keys_on: "authored_name_at equals String, or equals FreeMonoid/List whose element is spelled Char",
    identity: AvailableAtSite { holder_expression: "type_reference_decl_file(n: n) -- the same node n the predicate is given", adjacent_consulting_call: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "rust_render_checkpoint_scalar_bare") },
    outcome: SilentWrongProviderAnswer { what_is_emitted: "the literal String, for a reference resolving to a module whose String is the structural FreeMonoid<Char>" },
    reach: ReachedByMeasuredPopulation { measurement: "34 live E0308 sites in the 03_ingest closure pairing a String-declared position against a FreeMonoid-realized value (royal-dove-436, docs/probes/t2_t3_realization_route_2026-08-21.md)" },
    sibling: SiblingPresentButUnreachable { sibling: decl_ref(module_path: "v1.compiler.coercion", decl_name: "type_realization_decision"), why_unreachable: "six type renderers call this predicate on their FIRST line and return, so no String-spelled reference in type position reaches the authority" },
    call_site_count: 11,
  },
  {
