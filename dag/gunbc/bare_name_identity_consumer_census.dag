    identity: AvailableAtSite { holder_expression: "the qualified key itself carries the providing module", adjacent_consulting_call: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "is_duplicate_qualified_item_registry_marker") },
    outcome: TypedRefusal { refusal_site: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "emit_qualified_value_ref_crate_ident") },
    reach: ReachedByMeasuredPopulation { measurement: "duplicate_qualified_item_registry_marker_note records the marker as define-and-consume with two named consuming refusals" },
    sibling: SiblingPresentButOrdered { sibling: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "duplicate_qualified_item_registry_marker"), precedence: "the collision arm runs INSTEAD of last-write-wins, which is the shape every row above is missing" },
    call_site_count: 2,
  },
]

// THE HISTOGRAM IS DERIVED, NEVER STORED. A stored count is a second representation of the roster
// (DESIGN sections 2 and 3) and it rots silently the moment a row is added; worse, a witness
// asserting a stored count against the roster it was copied from is the measure-equals-measure
// change detector DESIGN section 5 rejects. Every number this carrier reports is a fold over the
// rows, so adding a row moves the number and no author has to remember to.

fn consumer_identity_was_available(c: BareNameConsumer) -> Bool {
  match c.identity {
    AvailableAtSite { holder_expression: _, adjacent_consulting_call: _ } => true
    AvailableUpstreamNotThreaded { nearest_holder: _ } => true
    UnavailableNoNodeAtSite { severed_at: _ } => false
  }
}

fn consumer_has_unused_identity_sibling(c: BareNameConsumer) -> Bool {
  match c.sibling {
    SiblingPresentButOrdered { sibling: _, precedence: _ } => true
    SiblingPresentButUnreachable { sibling: _, why_unreachable: _ } => true
    NoSiblingExists { what_would_have_to_be_built: _ } => false
  }
}

fn consumer_answers_wrongly_today(c: BareNameConsumer) -> Bool {
  match c.outcome {
    SilentWrongProviderAnswer { what_is_emitted: _ } => true
    AmbiguityDetectedThenAnswered { sentinel: _, what_is_emitted: _ } => true
    SilentDefaultNoAnswer { what_is_emitted: _ } => false
    TypedRefusal { refusal_site: _ } => false
  }
}

fn consumer_reach_is_measured(c: BareNameConsumer) -> Bool {
  match c.reach {
    ReachedByMeasuredPopulation { measurement: _ } => true
    UnreachableByConstantBody { body_answer: _ } => false
    ReachabilityUnmeasured { what_would_settle_it: _ } => false
  }
}

fn census_member_count() -> Int {
  bare_name_identity_consumers |> count
}

fn census_call_site_total() -> Int {
  bare_name_identity_consumers |> fold(init: 0, f: (acc, c) => acc + c.call_site_count)
}

fn census_identity_available_count() -> Int {
  bare_name_identity_consumers |> filter(c => consumer_identity_was_available(c: c)) |> count
}

fn census_unused_sibling_count() -> Int {
  bare_name_identity_consumers |> filter(c => consumer_has_unused_identity_sibling(c: c)) |> count
}

fn census_wrong_answer_today_count() -> Int {
  bare_name_identity_consumers |> filter(c => consumer_answers_wrongly_today(c: c)) |> count
}

fn census_measured_reach_count() -> Int {
  bare_name_identity_consumers |> filter(c => consumer_reach_is_measured(c: c)) |> count
}

// THE CELL THAT DECIDES WHERE THE NEXT LANE GOES: reachable by a measured population AND answering
// from the wrong provider today. The brief asks to be interrupted for exactly this set, so it is
// derived here rather than left for a reader to intersect two columns by eye.
fn census_reachable_and_wrong_today() -> List<BareNameConsumer> {
  bare_name_identity_consumers |> filter(c => consumer_reach_is_measured(c: c) && consumer_answers_wrongly_today(c: c))
}

// POPULATION BASIS, stated in the same shape gunbc.empty_decl_file_checkpoint_bypass states its own,
// because the two carriers are read together and a reader must be able to compare their bounds.
//
// That carrier reports UncountedNoSweepRun with one instance. This carrier IS that sweep, for the
// emitter's realization decisions -- so its row is upgraded here from "no sweep run" to a swept
// population WITH A NAMED SCOPE, and the scope is what bounds the claim: the sweep read every
// top-level fn in v1.compiler.emit_rust, v1.compiler.emit, v1.compiler.infer_emit_info and
// v1.compiler.coercion that takes a name-shaped String parameter or hardcodes decl_file to the empty
// string, and followed each one's call sites.
//
// WHAT THAT SCOPE DOES NOT REACH, named rather than left as a silent edge: a decision keyed on a
// name that is neither a String parameter nor a decl_file argument -- a match on a name computed
// inline, a comparison against a literal inside a larger expression -- is outside the sweep's
// selector and would not have been found. Three rows here were found that way anyway, while reading
// call sites for something else, which is evidence that the selector is not complete rather than
// evidence that it is.
type CensusBasis
  = SweptByDeclaredSelector { selector: String, modules_read: String, known_blind_spot: String }
  | DerivedByLens { lens: String }

data bare_name_census_basis: CensusBasis = SweptByDeclaredSelector {
  selector: "top-level fns taking a name-shaped String parameter, plus every call passing decl_file as the empty string literal",
  modules_read: "v1.compiler.emit_rust, v1.compiler.emit, v1.compiler.infer_emit_info, v1.compiler.coercion",
  known_blind_spot: "a name compared against a literal inline, with no name-shaped parameter and no decl_file argument, is outside the selector",
}

// RUNG, at the honest grain and separated from the roster's own claims. The CLASS sits at
// MITIGATABLE: nothing refuses at any row except the contrast row, and this carrier does not change
// that -- it counts. The CARRIER sits lower than a reader might assume: its rows are hand-swept
// from source text, so an emitter edit that adds a bare-name decision does not move any number here
// and nothing detects the omission.
//
// The construction that IS carried, and it is the only rung claim this carrier makes: a row cannot
// assert that identity was available without naming the expression that holds it, cannot assert
// inertness without carrying the constant body that establishes it, and cannot omit reachability --
// ReachabilityUnmeasured has a spelling precisely so that an unpriced site can be filed honestly
// instead of being filed as reached. Those states are unwritable rather than checked.
//
// NEXT-RUNG TRIGGER: the roster is DERIVED by a lens over the emitter's own Node tree -- which
// declaring functions consult a declaration-identity expression and which do not is a question the
// containment tree can answer -- rather than swept by hand into rows. At that point the hand roster
// dissolves and the derived one keeps the dispositions.
data bare_name_census_next_rung_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: the roster above is derived by a lens over the v1 emitter's own Node tree instead of hand-swept, so a newly authored bare-name realization decision appears in the census without an author remembering to file it. Not satisfied by adding rows to the hand roster, however many: the defect this trigger names is that the roster cannot notice its own incompleteness, and a longer hand list has exactly the same blind spot.")

// PROVENANCE OF THE TWO HANDED-OVER ROWS, AND ONE RETRACTION CARRIED FORWARD RATHER THAN REPEATED.
//
// Row one arrives with its own carrier (gunbc.empty_decl_file_checkpoint_bypass) and is restated
// here as a member so the histogram is complete; that carrier remains the authority for it.
//
// Row two arrives from royal-dove-436 as "an authority that is present, correct and unreachable",
// and the word CORRECT WAS RETRACTED BY ITS OWN AUTHOR before this census was written. The retraction
// is load-bearing for anyone reading this roster as a work list: type_realization_decision takes
// decl_file as a parameter and derives nothing declaration-shaped internally, and its production key
// -- type_reference_decl_file -- falls back to the file the REFERENCE SITS IN whenever inference did
// not resolve, which is a different fact from where the type is DECLARED. So routing the six
// renderers to the authority would change which function computes the answer and leave the basis of
// the answer unchanged. Recorded here because this roster's sibling column would otherwise read as a
// routing work list, and for row two routing alone is measured to be insufficient.
//
// WHAT THIS CENSUS DOES NOT INHERIT FROM THAT LANE: the fallback-arm measurement that produced the
// retraction was taken on the PRE-RECONCILE tree and its author withdrew the production claim. What
// survives unconditionally is the SHAPE defect in type_reference_decl_file -- it cannot distinguish
// "this node is its own declaration" from "this reference was not resolved here" -- and that is what
// the paragraph above rests on, not the withdrawn count.
data bare_name_census_handover_provenance: List<DeclarationRef> = [
  decl_ref(module_path: "gunbc.empty_decl_file_checkpoint_bypass", decl_name: "empty_decl_file_bypass_instances"),
  decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "checkpoint_table_bypasses_identity_note"),
  decl_ref(module_path: "v1.compiler.coercion", decl_name: "type_reference_identity_note"),
]
