    identity: AvailableAtSite { holder_expression: "type_reference_decl_file(n: n) at the reference sites that test membership", adjacent_consulting_call: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "rust_render_checkpoint_scalar_bare") },
    outcome: SilentWrongProviderAnswer { what_is_emitted: "an Rc wrap or its absence decided by the authored spelling, so one carrier renders two ways depending on how the reference was spelled" },
    reach: ReachedByMeasuredPopulation { measurement: "the E0599 as_ref cluster on gunbc#8814: SymbolicCost::ConstantCost declared with a qualified spelling rendered bare while every consumer used Rc<Nat>. STRONGER SECOND MEASUREMENT, relayed from crisp-crab-430 on integration/namespace-cut and not run here: of the 21 shared_types MEMBERSHIP TESTS, only 7 were passing an already-leaf-reduced expression, so a dotted spelling missed the set and rendered UNWRAPPED while a leaf-reduced site rendered the same type WRAPPED -- the emitted tree disagreeing with itself about one type in both directions, 343 Rc-wrapped against 371 unwrapped for source_indices, collapsing to 714 against 0 once every test was leaf-reduced, which is the shape main already holds. NOTE ON WHY call_site_count STAYS AT 2 AND IS NOT 21: this column counts calls to the DECIDING function throughout the roster, and 21 is the count of membership tests CONSUMING its output. Both are true of this row and only one of them is what the column means; changing the semantic for one row would silently break every comparison across the histogram" },
    sibling: NoSiblingExists { what_would_have_to_be_built: "sharing is derived from the summary map, so it inherits the identity key that row nine would have to carry first" },
    call_site_count: 2,
