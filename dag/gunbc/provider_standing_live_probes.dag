module gunbc.provider_standing_live_probes


data provider_standing_live_probes_note: String = "Wet observation bridge: runs the same dashboard Codex probes as /provider.json readiness and projects the receipts into ProviderStanding. Not called from hermetic provider_inventory_for_instance — inventory keeps declared unobserved standing so substrate witnesses do not require Run mock_response. Superseded when nimble-owl-833 lands RecordedFact standing observations on inventory rows."

fn dashboard_codex_runtime_probe_identity_succeeded(result: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult) -> Bool {
  result.success
    && codex_runtime_version_identity_satisfied(
      combined_output: join([result.stdout, "\n", result.stderr], ""),
    )
}

fn dashboard_codex_provider_exec_probe_from_result(
  result: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult,
) -> gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbe {
  if dashboard_probe_refused(r: result) {
    provider_dashboard_exec_probe_transport_refused()
  } else {
    provider_dashboard_exec_probe_reported(
      succeeded: result.success,
      stdout: result.stdout,
      stderr: result.stderr,
    )
  }
}

fn dashboard_codex_runtime_probe_from_result(
  result: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult,
) -> gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbe {
  if dashboard_probe_refused(r: result) {
    provider_dashboard_exec_probe_transport_refused()
  } else {
    provider_dashboard_exec_probe_reported(
      succeeded: dashboard_codex_runtime_probe_identity_succeeded(result: result),
      stdout: result.stdout,
      stderr: result.stderr,
    )
  }
}

fn dashboard_codex_provider_probe_observation(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
  let state_root = dashboard_instance_provider_state_root(instance: instance)
  match dashboard_target_path_observe(
    instance: instance,
    flag: "-d",
    path: state_root,
  ) {
    PathObservationRefused { reason } =>
      gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
        state_root: gunbc.provider_standing_probe_bridge.CodexStateRootProbeRefused {
          reason: reason as std.types.NonEmptyStr,
        },
        runtime: provider_dashboard_exec_probe_transport_refused(),
        auth: provider_dashboard_exec_probe_transport_refused(),
      }
    PathObservedAbsent =>
      gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
        state_root: CodexStateRootAbsent,
        runtime: provider_dashboard_exec_probe_transport_refused(),
        auth: provider_dashboard_exec_probe_transport_refused(),
      }
    PathObservedPresent => {
      match dashboard_instance_provider_executable(instance: instance) {
        Absent =>
          gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
            state_root: CodexStateRootPresent,
            runtime: provider_dashboard_exec_probe_transport_refused(),
            auth: provider_dashboard_exec_probe_transport_refused(),
          }
        Present { value: codex_program } => {
      let runtime = dashboard_target_probe(
        instance: instance,
        program: dashboard_environment_binding_executable,
        args: shape_codex_version_env_args_for_program(
          program: codex_program as String,
          codex_home: state_root as String,
        ),
      )
      let auth = dashboard_target_probe(
        instance: instance,
        program: dashboard_environment_binding_executable,
        args: shape_codex_login_status_env_args_for_program(
          program: codex_program as String,
          codex_home: state_root as String,
        ),
      )
      gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
        state_root: CodexStateRootPresent,
        runtime: dashboard_codex_runtime_probe_from_result(result: runtime),
        auth: dashboard_codex_provider_exec_probe_from_result(result: auth),
      }
        }
      }
    }
  }
}

fn codex_provider_instance_for_inventory(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  executable: std.types.FilePath,
) -> extdeps.llm.cli_lifecycle.ProviderInstance {
  extdeps.llm.cli_lifecycle.ProviderInstance {
    kind: CodexCliProvider,
    host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "inventory row is declared, not observed at selection time" as std.types.NonEmptyStr,
    },
    executable: executable as std.types.NonEmptyStr,
    observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "inventory row is declared, not observed at selection time" as std.types.NonEmptyStr,
    },
    state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "account_state_root is the credential reference" as std.types.NonEmptyStr,
    },
    credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "codex stores credentials under account_state_root" as std.types.NonEmptyStr,
    },
    service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "inventory row is declared, not observed at selection time" as std.types.NonEmptyStr,
    },
  }
}

fn provider_standing_bundle_from_live_codex_probes(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> gunbc.provider_standing.ProviderStandingBundle {
  provider_standing_bundle_from_codex_dashboard_probes(
    observation: dashboard_codex_provider_probe_observation(instance: instance),
  )
}

fn provider_standing_from_live_codex_probes(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> gunbc.provider_standing.ProviderStanding? {
  match dashboard_instance_provider_executable(instance: instance) {
    Absent => none
    Present { value: executable } =>
      Present {
        value: provider_standing_from_observed_bundle(
          fact_id: provider_standing_live_probe_fact_id,
          provider: codex_provider_instance_for_inventory(
            instance: instance,
            executable: executable,
          ),
          bundle: provider_standing_bundle_from_live_codex_probes(instance: instance),
        ),
      }
  }
}
