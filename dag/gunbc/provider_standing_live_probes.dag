module gunbc.provider_standing_live_probes

import std.types { String, NonEmptyStr, List }
import extdeps.llm.cli {
  shape_codex_login_status_env_args_for_program,
  shape_codex_version_env_args_for_program,
}
import gunbc.package_delivery { codex_runtime_version_identity_satisfied }
import extdeps.llm.cli_lifecycle {
  ProviderInstance,
  ProviderInstanceFieldUnobserved,
  CodexCliProvider,
}
import gunbc.roadmap_dashboard_instance {
  HostDashboardInstance,
  dashboard_instance_provider_state_root,
  dashboard_instance_provider_executable,
}
import gunbc.roadmap_dashboard_instance_apply {
  DashboardExecResult,
  dashboard_target_path_observe,
  dashboard_target_probe,
  dashboard_probe_refused,
  dashboard_environment_binding_executable,
  PathObservedPresent,
  PathObservedAbsent,
  PathObservationRefused,
}
import gunbc.provider_standing {
  ProviderStanding,
  ProviderStandingBundle,
  provider_standing_from_observed_bundle,
  provider_standing_live_probe_fact_id,
}
import gunbc.provider_standing_probe_bridge {
  CodexProviderDashboardProbeObservation,
  CodexProviderStateRootProbe,
  CodexStateRootProbeRefused,
  CodexStateRootAbsent,
  CodexStateRootPresent,
  ProviderDashboardExecProbe,
  provider_dashboard_exec_probe_transport_refused,
  provider_dashboard_exec_probe_reported,
  provider_standing_bundle_from_codex_dashboard_probes,
}

data provider_standing_live_probes_note: String = "Wet observation bridge: runs the same dashboard Codex probes as /provider.json readiness and projects the receipts into ProviderStanding at inventory build. Superseded when nimble-owl-833 lands RecordedFact standing observations on inventory rows."

fn dashboard_codex_runtime_probe_identity_succeeded(result: DashboardExecResult) -> Bool {
  result.success
    && codex_runtime_version_identity_satisfied(
      combined_output: join([result.stdout, "\n", result.stderr], ""),
    )
}

fn dashboard_codex_provider_exec_probe_from_result(
  result: DashboardExecResult,
) -> ProviderDashboardExecProbe {
  if dashboard_probe_refused(r: result) {
    provider_dashboard_exec_probe_transport_refused()
  } else {
    provider_dashboard_exec_probe_reported(
      succeeded: result.success,
      stdout: result.stdout,
      stderr: result.stderr,
    )
  }
}

fn dashboard_codex_runtime_probe_from_result(
  result: DashboardExecResult,
) -> ProviderDashboardExecProbe {
  if dashboard_probe_refused(r: result) {
    provider_dashboard_exec_probe_transport_refused()
  } else {
    provider_dashboard_exec_probe_reported(
      succeeded: dashboard_codex_runtime_probe_identity_succeeded(result: result),
      stdout: result.stdout,
      stderr: result.stderr,
    )
  }
}

fn dashboard_codex_provider_probe_observation(
  instance: HostDashboardInstance,
) -> CodexProviderDashboardProbeObservation {
  let state_root = dashboard_instance_provider_state_root(instance: instance)
  match dashboard_target_path_observe(
    instance: instance,
    flag: "-d",
    path: state_root,
  ) {
    PathObservationRefused { reason } =>
      CodexProviderDashboardProbeObservation {
        state_root: CodexStateRootProbeRefused {
          reason: reason as NonEmptyStr,
        },
        runtime: provider_dashboard_exec_probe_transport_refused(),
        auth: provider_dashboard_exec_probe_transport_refused(),
      }
    PathObservedAbsent =>
      CodexProviderDashboardProbeObservation {
        state_root: CodexStateRootAbsent,
        runtime: provider_dashboard_exec_probe_transport_refused(),
        auth: provider_dashboard_exec_probe_transport_refused(),
      }
    PathObservedPresent => {
      let runtime = dashboard_target_probe(
        instance: instance,
        program: dashboard_environment_binding_executable,
        args: shape_codex_version_env_args_for_program(
          program: dashboard_instance_provider_executable(instance: instance) as String,
          codex_home: state_root as String,
        ),
      )
      let auth = dashboard_target_probe(
        instance: instance,
        program: dashboard_environment_binding_executable,
        args: shape_codex_login_status_env_args_for_program(
          program: dashboard_instance_provider_executable(instance: instance) as String,
          codex_home: state_root as String,
        ),
      )
      CodexProviderDashboardProbeObservation {
        state_root: CodexStateRootPresent,
        runtime: dashboard_codex_runtime_probe_from_result(result: runtime),
        auth: dashboard_codex_provider_exec_probe_from_result(result: auth),
      }
    }
  }
}

fn codex_provider_instance_for_inventory(
  instance: HostDashboardInstance,
) -> ProviderInstance {
  ProviderInstance {
    kind: CodexCliProvider,
    host: ProviderInstanceFieldUnobserved {
      reason: "inventory row is declared, not observed at selection time" as NonEmptyStr,
    },
    executable: dashboard_instance_provider_executable(instance: instance) as NonEmptyStr,
    observed_version: ProviderInstanceFieldUnobserved {
      reason: "inventory row is declared, not observed at selection time" as NonEmptyStr,
    },
    state_directory: ProviderInstanceFieldUnobserved {
      reason: "account_state_root is the credential reference" as NonEmptyStr,
    },
    credential_storage_method: ProviderInstanceFieldUnobserved {
      reason: "codex stores credentials under account_state_root" as NonEmptyStr,
    },
    service_identity: ProviderInstanceFieldUnobserved {
      reason: "inventory row is declared, not observed at selection time" as NonEmptyStr,
    },
  }
}

fn provider_standing_bundle_from_live_codex_probes(
  instance: HostDashboardInstance,
) -> ProviderStandingBundle {
  provider_standing_bundle_from_codex_dashboard_probes(
    observation: dashboard_codex_provider_probe_observation(instance: instance),
  )
}

fn provider_standing_from_live_codex_probes(
  instance: HostDashboardInstance,
) -> ProviderStanding {
  provider_standing_from_observed_bundle(
    fact_id: provider_standing_live_probe_fact_id,
    provider: codex_provider_instance_for_inventory(instance: instance),
    bundle: provider_standing_bundle_from_live_codex_probes(instance: instance),
  )
}
