module gunbc.ledger_row_coherence

import std.types { String, List, Bool }
import gunbc.generated_artifact {
  GeneratedArtifact,
  WitnessFloorYamlArtifact, FleetConvergeYamlArtifact, FleetDesiredAdmissionYamlArtifact,
  GitignoreArtifact, GitattributesArtifact, RoadmapArtifact, DesignArtifact,
  DesignFailureModesArtifact, DesignRungDropsArtifact,
  GithooksPrePushArtifact, GithooksPreCommitArtifact, GeneratedArtifactMergeDriverArtifact,
  RunnerDeployArtifact, Stage0CrateLayoutGeneratedDagArtifact, Stage0CrateLayoutGeneratedRsArtifact,
  Stage0CratePartitionGeneratedDagArtifact, Stage0ExecutableAssemblyGeneratedDagArtifact,
  V1InterpreterDispatchGeneratedRsArtifact, EvaluationBudgetConsequenceGeneratedRsArtifact,
  FileTransportRealizationGeneratedRsArtifact, CouponCadQueryProgramArtifact,
  AutoinstallUserDataArtifact, RunnerHostSudoersArtifact, PlanArtifact
}
import gunbc.recurring_failure_mode { RecurringFailureMode, authored }
import gunbc.recurring_failure_mode.roster { recurring_failure_mode_roster }
import gunbc.rung_drop { RungDrop, rung_drop_declaration_message }
import gunbc.rung_drop.roster { rung_drop_roster }

// WHY A BYTE DIFFERENCE ON A LEDGER NEEDED ITS OWN NAME, MEASURED RATHER THAN ARGUED.
//
// The generated-artifact phase already refuses when committed bytes differ from generated bytes,
// and that refusal is correct and sufficient AS A WALL. What it could not do is SAY WHAT KIND of
// difference it found, and one kind matters far more than the rest: the committed projection no
// longer renders rows its own authority still declares. The ledger's own header says it "carries
// the rows in full"; when this class is live that sentence is false and nothing says so.
//
// THE CLASS IS INVISIBLE BECAUSE IT IS REPAIRED, NOT BECAUSE IT IS RARE. Heal regenerates the two
// design ledgers after a provisional merge -- gunbc.generated_artifact concurrent_divergence_repair
// names exactly these two artifacts as HealRegeneratesAfterProvisionalMerge -- so the ordinary life
// of this defect is: a branch merges main, which imports a row FILE without regenerating the
// projection; the head is authority-ahead-of-projection; heal regenerates and the difference is
// gone. Every observable trace is one commit whose message is "regenerate drifted generated
// artifacts", identical to every other such commit. A repair and an absence of a defect produce the
// same observable, so the recorded frequency of the class is ZERO BY CONSTRUCTION and it never
// ranks for a wall.
//
// THAT IS THE ABSORBING-FALLBACK SHAPE OF DESIGN SECTION 5, ARRIVING THROUGH THE REPAIR ARM RATHER
// THAN THE FAILURE ARM, and this repository has already paid for the other half of it: the merge
// driver was once bound to `true`, whose failure arm ANSWERED instead of refusing and destroyed the
// one fact worth keeping -- that a provisional choice had been made at all -- so the deficit's
// frequency was zero by construction and nothing ranked it. Here the repair SUCCEEDS and destroys
// the same fact. A silent repair is indistinguishable from an absent defect.
//
// THE CLASS HAS A MEASURED POPULATION AND THIS FUNCTION IS THE INSTRUMENT THAT DERIVES IT, which is
// why no count appears in this comment. DESIGN section 6 says to name the instrument and never to
// transcribe its output: a number copied into prose is unreachable from the thing that owns it, so
// it rots without anyone touching either end, and the first re-measurement leaves this paragraph
// quietly wrong. The derivation is: for each heal commit -- a commit whose regeneration rewrote a
// committed projection -- classify its PARENT with ledger_row_coherence, taking the committed side
// from the parent tree and the generated side from the parent's own authorities. A parent that
// classifies LedgerRowsMissingFromCommitted is a repair that was performed and never recorded.
//
// TWO PROPERTIES OF THAT SERIES ARE STRUCTURAL RATHER THAN OBSERVED, so they belong here where a
// count does not, and both are about how its ZEROS must be read.
//
// FIRST, THE DENOMINATOR IS SMALLER THAN THE COMMIT COUNT. A heal commit whose parent predates the
// failure-mode preamble index cannot be classified from that index at all, so it is UNMEASURABLE
// rather than clean, and any rate quoted over all heal commits understates the class. What this
// series yields is a FLOOR over the measurable subset, never a rate over the whole.
//
// SECOND, A ZERO ON A SURFACE MAY MEAN UNREADABLE. The rung-drop ledger carries no identity index in
// its projection and its only machine-visible join is a count that is already off by one for a
// structural reason -- that projection injects a compile-phase-frontier heading which is not a row.
// A zero meaning "no defects" and a zero meaning "cannot be read" are the same character. Deriving
// the rows from the ROSTER, as ledger_rows does, is what removes that asymmetry: this classifier
// answers for both ledgers without either projection carrying an index.
//
// THE ZERO ON THE RUNG-DROP SURFACE MEANS UNREADABLE, NOT CLEAN, and the distinction is the whole
// reason this classifier keys off the AUTHORITY side. The retrospective measurement above could
// only read the failure-mode ledger, because that document carries an identity index in its
// preamble and the rung-drop document carries none -- its only machine-visible join is a count, and
// that count is already off by one for a structural reason (this projection injects a
// compile-phase-frontier `###` heading that is not a row). A zero that means "no defects" and a
// zero that means "cannot be read" are the same character. Deriving the rows from the ROSTER rather
// than from an index in the projection removes that asymmetry outright: neither document needs to
// carry an index for this to answer, and both are covered by the same construction.

type LedgerRow {
  identity: String
  body: String
}

// EVERY VARIANT IS WRITTEN OUT AND THERE IS NO WILDCARD, WHICH IS THE WHOLE PROPERTY THIS FUNCTION
// CLAIMS. An earlier revision ended in `_ => []` and carried a comment asserting that "a newly
// registered artifact does not silently acquire an empty row population by default". THAT COMMENT
// WAS FALSE WHILE THE WILDCARD STOOD: a new ledger added to GeneratedArtifact would have fallen
// into `_`, reported NotALedgerArtifact, and been excluded from coherence checking forever with
// nothing anywhere to say so. The required nfr_roster_receipt test caught the residue and refused
// the merge -- a wall doing exactly its job on an author who had written the right sentence over
// the wrong construction.
//
// With the coproduct exhausted, adding a variant to GeneratedArtifact FAILS TO COMPILE until
// somebody decides which arm it belongs in. That is the difference between a claim about behaviour
// and a construction that enforces it, and it is why the verbosity is the point rather than a cost:
// the twenty-two non-ledger arms are not noise, they are the record that each was CONSIDERED and
// classified. NotALedgerArtifact remains a distinct arm from LedgerRowsAllRendered, so "cannot
// speak for this" never reads as "this is fine".
fn ledger_rows(a: GeneratedArtifact) -> List<LedgerRow> {
  match a {
    DesignFailureModesArtifact =>
      map(recurring_failure_mode_roster, r => LedgerRow {
        identity: (r.identity as String),
        body: authored(r: r)
      })
    DesignRungDropsArtifact =>
      map(rung_drop_roster, d => LedgerRow {
        identity: (d.identity as String),
        body: rung_drop_declaration_message(d: d)
      })
    WitnessFloorYamlArtifact => []
    FleetConvergeYamlArtifact => []
    FleetDesiredAdmissionYamlArtifact => []
    GitignoreArtifact => []
    GitattributesArtifact => []
    RoadmapArtifact => []
    DesignArtifact => []
    GithooksPrePushArtifact => []
    GithooksPreCommitArtifact => []
    GeneratedArtifactMergeDriverArtifact => []
    RunnerDeployArtifact => []
    Stage0CrateLayoutGeneratedDagArtifact => []
    Stage0CrateLayoutGeneratedRsArtifact => []
    Stage0CratePartitionGeneratedDagArtifact => []
    Stage0ExecutableAssemblyGeneratedDagArtifact => []
    V1InterpreterDispatchGeneratedRsArtifact => []
    EvaluationBudgetConsequenceGeneratedRsArtifact => []
    FileTransportRealizationGeneratedRsArtifact => []
    CouponCadQueryProgramArtifact => []
    AutoinstallUserDataArtifact { spec: _ } => []
    RunnerHostSudoersArtifact { host: _ } => []
    PlanArtifact { plan: _ } => []
  }
}

// WHETHER AN ARTIFACT IS A LEDGER IS ASKED IN ONE PLACE. A consumer that needs to know -- to decide
// whether failing to judge it matters -- must not re-derive it by matching the coproduct again,
// because a second such match is a second authority for the same fact and the two drift the moment a
// ledger is added. This is a projection of ledger_rows, so a ledger is exactly an artifact that has
// rows to lose.
fn artifact_is_ledger(a: GeneratedArtifact) -> Bool {
  length(ledger_rows(a: a)) > 0
}

// NOT-A-LEDGER IS AN ARM, NOT AN EMPTY LIST, for the reason DESIGN section 5 gives about degradation
// arms: an artifact this classifier cannot speak for must not inhabit the same state as an artifact
// it examined and found whole. Collapsing the two would make every provisioning file report
// "no rows missing" and would let a future ledger with no arm here read as coherent forever.
type LedgerRowCoherence
  = NotALedgerArtifact
  | LedgerRowsAllRendered
  | LedgerRowsMissingFromCommitted { missing: List<String> }

// THE RELATION IS DIRECTED AND THE DIRECTION IS THE POINT. A row counts as missing only when the
// GENERATED bytes carry it and the COMMITTED bytes do not -- that is under-rendering, the class
// where the ledger stops showing something its authority still declares. The reverse case,
// committed carrying a row the generation does not, is a different defect (a stale row surviving a
// deletion) and is deliberately NOT folded in here: it is still caught by the byte wall, and naming
// two opposite conditions with one word is how a diagnostic stops discriminating.
//
// THE BOUND ON THIS INSTRUMENT, STATED SO IT IS NOT CITED PAST ITSELF: containment is a SUBSTRING
// test over the rendered row body, so a row whose entire body were a substring of another row's
// body would not be reported missing while that other row is present. That is a false NEGATIVE --
// this classifier can under-report, never over-report -- and it cannot turn a real difference green,
// because the byte comparison in gunbc.generated_artifact_assessment is what refuses. This is a
// diagnostic riding on a wall, not the wall.
fn ledger_row_coherence(a: GeneratedArtifact, generated_content: String, committed_content: String) -> LedgerRowCoherence {
  let rows = ledger_rows(a: a)
  if length(rows) == 0 {
    NotALedgerArtifact
  } else {
    let missing = fold(rows, init: [], f: fn(acc, row) {
      if string_contains(s: generated_content, pattern: row.body)
        && !string_contains(s: committed_content, pattern: row.body) {
        concat(acc, [row.identity])
      } else {
        acc
      }
    })
    if length(missing) == 0 { LedgerRowsAllRendered } else {
      LedgerRowsMissingFromCommitted { missing: missing }
    }
  }
}

// THE RENDERING IS HERE AND NOT AT THE CONSUMER so a second caller cannot spell the same finding a
// different way (DESIGN section 3). The identities are listed rather than counted: a count tells a
// reader that something went dark and not WHICH thing, and the recurrence of one identity across
// several branches is the fact that made this class rank at all.
fn ledger_row_coherence_rendered(c: LedgerRowCoherence) -> String {
  match c {
    NotALedgerArtifact => ""
    LedgerRowsAllRendered => ""
    LedgerRowsMissingFromCommitted { missing } => concat(
      " INCOHERENT: the committed projection does not render these rows its authority declares: ",
      fold(missing, init: "", f: fn(acc, id) {
        if acc == "" { id } else { concat(acc, concat(", ", id)) }
      })
    )
  }
}

// THE REPAIR MUST DECLARE ITSELF ON THE CARRIER THAT PERFORMS IT, AND THE CARRIER IS A COMMIT.
//
// Heal's regeneration IS a commit, so annotating that commit with what it repaired puts the mark on
// the thing that did the work rather than in a parallel ledger beside it -- which is what DESIGN
// section 6 asks for, and it is the reason the retrospective classification above was derivable at
// all: git history already carried enough to classify against, it simply never SAID anything.
//
// WHY A STRUCTURED TRAILER AND NOT A SENTENCE. DESIGN section 4c quarantines unclassified prose:
// an invariant, receipt or count belongs in a typed carrier, and a commit message full of free text
// would put a reader back where the six unmeasurable commits already are -- something happened, and
// no machine can say what. The trailer token is declared ONCE here and both the renderer and the
// parser read that one declaration, so the written form and the read form cannot drift apart.
//
// THE PARSER IS THE POINT, NOT THE RENDERER. With a declaration to read, classification stops being
// archaeology over a commit's parent and becomes a fact the repair states about itself. The
// parent-comparison route does not retire -- it becomes the CROSS-CHECK, which is what a declaration
// needs if it is to be trusted, since a repair that lies about its own scope is otherwise
// unfalsifiable. Two routes to one number, disagreeing loudly, is the shape this class was missing.

data ledger_repair_trailer_token: String = "Ledger-Rows-Repaired:"

// THE PATH IS DECLARED ONCE AND CONSUMED BY BOTH ENDS. The gate WRITES this file and the heal commit
// step READS it; if each spelled its own literal the two would drift and the failure would be
// silent -- heal would commit with no trailer and nothing would say the declaration had been written
// somewhere nobody looked. It lives under target/ because that directory is ignored, so the
// declaration cannot itself become a committed artifact the drift gate then has to adjudicate.
data heal_repair_declaration_artifact_path: String = "target/heal-repair-declaration.txt"

// THE DENOMINATOR IS DECLARED, BECAUSE A COUNT WITHOUT ONE UNDERCOUNTS SILENTLY. A commit carrying
// no repair trailer has two completely different meanings -- this heal judged the ledgers and found
// nothing to repair, or the declaration step never ran at all -- and with only the repair token
// those are the SAME BYTES. That is this module's own subject reappearing one level up: an absent
// observable read as a clean one. So every ledger artifact the declaration examined emits a JUDGED
// line whether or not it repaired anything, and a reader counts repairs against judged rather than
// against an unstated population.
//
// THE FAILURE THIS PREVENTS IS THE REASSURING ONE. Suppose heads start going unjudged -- the
// declaration step is skipped, or the run that would have executed it is suspended before any job
// starts. Repairs recorded falls toward zero while repairs OCCURRING is unchanged, and a ledger
// counting only the numerator reads that as the class being fixed. Coverage collapsing and the
// defect disappearing must not produce the same number.
data ledger_repair_judged_token: String = "Ledger-Repair-Judged:"

type LedgerRepairDeclaration {
  path: String
  identity: String
}

// ONE LINE PER IDENTITY rather than one line carrying a delimited list. A per-identity line survives
// truncation, wrapping and quoting with the loss confined to the lines actually lost, and it makes
// the count a line count rather than a parse of a separator that some tool may rewrite.
fn render_ledger_repair_trailers(path: String, c: LedgerRowCoherence) -> String {
  match c {
    NotALedgerArtifact => ""
    LedgerRowsAllRendered => concat("\n", concat(ledger_repair_judged_token, concat(" ", path)))
    LedgerRowsMissingFromCommitted { missing } =>
      fold(missing, init: concat("\n", concat(ledger_repair_judged_token, concat(" ", path))), f: fn(acc, id) {
        concat(acc, concat("\n", concat(ledger_repair_trailer_token, concat(" ", concat(path, concat(" ", id))))))
      })
  }
}

// THE JUDGED POPULATION IS PARSED BY THE SAME ROUTE AS THE REPAIRS, so a reader cannot obtain one
// without being able to obtain the other. A judged line carries a path and no identity, which is
// exactly the shape scan_trailer_fields rejects for a repair, so the two tokens cannot be confused
// even though they share a parse.
fn parse_ledger_repair_judged(message: String) -> List<String> {
  fold(split(s: message, delimiter: ledger_repair_judged_token), init: [], f: fn(acc, chunk) {
    let line = fold(split(s: chunk, delimiter: "\n"), init: "", f: fn(a, l) { if a == "" { l } else { a } })
    match scan_trailer_fields(fields: trailer_payload_fields(line: line)) {
      TrailerPathOnly { path } => concat(acc, [path])
      TrailerFieldsEmpty => acc
      TrailerPathAndIdentity { path: _, identity: _ } => acc
      TrailerOverlong => acc
    }
  })
}

// THE TOKENS ARE STRIPPED BEFORE SCANNING, and this is a repair rather than a refinement. The first
// version of this parse asserted that the two tokens could not contaminate each other because they
// share a field scanner -- and that was FALSE, caught by its own witness: splitting the message on
// the REPAIR token leaves a judged line intact in the leading chunk, where its token and path
// present as exactly two fields and read as a repair declaration for identity "docs/...". A claim
// that two things cannot collide is worth no more than the arm that would fail if they did.
//
// Stripping every known token leaves the scanner looking only at PAYLOAD, so arity alone
// discriminates: a judged line is one field and a repair line is two, whichever token was split on.
fn trailer_payload_fields(line: String) -> List<String> {
  filter(
    split(s: line, delimiter: " "),
    p => p != "" && p != ledger_repair_trailer_token && p != ledger_repair_judged_token
  )
}

// THE SHAPE OF A TRAILER LINE IS A COPRODUCT, NOT A COUNT. An earlier revision carried
// `TrailerScan { n: Int, path: String, identity: String }` and keyed every consumer on `n == 1` or
// `n == 2` -- an in-band discriminator with the arms living in the predicates that read it rather
// than in the type. DESIGN section 2 and section 3 both refuse that: the arity IS the classification,
// so representing it as an Int meant every reader re-derived the same case analysis, `identity` was
// present-but-meaningless in the path-only case, and nothing stopped a fourth caller inventing its
// own reading of `n == 3`.
//
// As a coproduct the arms are the type. A path-only line cannot carry an identity field to
// misread, an overlong line is a NAMED arm rather than a number nobody handles, and the match in
// each parser is exhaustive -- so a new trailer shape forces every reader to decide, which is the
// same construction property ledger_rows gets from exhausting GeneratedArtifact.
type TrailerScan
  = TrailerFieldsEmpty
  | TrailerPathOnly { path: String }
  | TrailerPathAndIdentity { path: String, identity: String }
  | TrailerOverlong

fn scan_trailer_fields(fields: List<String>) -> TrailerScan {
  fold(fields, init: TrailerFieldsEmpty, f: fn(a, x) {
    match a {
      TrailerFieldsEmpty => TrailerPathOnly { path: x }
      TrailerPathOnly { path } => TrailerPathAndIdentity { path: path, identity: x }
      TrailerPathAndIdentity { path: _, identity: _ } => TrailerOverlong
      TrailerOverlong => TrailerOverlong
    }
  })
}

// SPLITTING ON THE TOKEN RATHER THAN SCANNING LINES is what makes the parse indifferent to how the
// message was assembled -- leading whitespace, a wrapped body, a trailer block appended by another
// tool. The chunk before the first token is examined like any other and is rejected by the same
// field-count rule, so no arm exists that treats the message prologue specially.
fn parse_ledger_repair_trailers(message: String) -> List<LedgerRepairDeclaration> {
  fold(split(s: message, delimiter: ledger_repair_trailer_token), init: [], f: fn(acc, chunk) {
    let line = fold(split(s: chunk, delimiter: "\n"), init: "", f: fn(a, l) { if a == "" { l } else { a } })
    match scan_trailer_fields(fields: trailer_payload_fields(line: line)) {
      TrailerPathAndIdentity { path, identity } =>
        concat(acc, [LedgerRepairDeclaration { path: path, identity: identity }])
      TrailerFieldsEmpty => acc
      TrailerPathOnly { path: _ } => acc
      TrailerOverlong => acc
    }
  })
}

// THE DECLARATION IS NOT TRUSTED, IT IS CROSS-CHECKED. A repair that states its own scope is
// unfalsifiable on its own -- a heal that under-declared would look exactly like a heal that had
// nothing to declare, which is the state this whole change exists to leave. So the parent-comparison
// route does NOT retire when the declaration lands: it becomes the second route to the same number,
// and this type is where the two are joined. Disagreement is rendered as two directed sets rather
// than a Bool, because which side is missing decides which mechanism is wrong -- declared-only means
// the declaration over-claims, inferred-only means the repair happened and went unrecorded, and a
// single false cannot tell a reader which of those to go fix.
type LedgerRepairCrossCheck
  = DeclarationAgreesWithInference
  | DeclarationDisagrees { declared_only: List<String>, inferred_only: List<String> }

fn identity_in(xs: List<String>, wanted: String) -> Bool {
  fold(xs, init: false, f: fn(acc, x) { acc || x == wanted })
}

fn cross_check_ledger_repair(declared: List<LedgerRepairDeclaration>, inferred: LedgerRowCoherence) -> LedgerRepairCrossCheck {
  let declared_ids = map(declared, d => d.identity)
  let inferred_ids = match inferred {
    NotALedgerArtifact => []
    LedgerRowsAllRendered => []
    LedgerRowsMissingFromCommitted { missing } => missing
  }
  let declared_only = filter(declared_ids, d => !identity_in(xs: inferred_ids, wanted: d))
  let inferred_only = filter(inferred_ids, i => !identity_in(xs: declared_ids, wanted: i))
  if length(declared_only) == 0 && length(inferred_only) == 0 {
    DeclarationAgreesWithInference
  } else {
    DeclarationDisagrees { declared_only: declared_only, inferred_only: inferred_only }
  }
}
