module gunbc.ledger_row_coherence

import std.types { String, List, Bool }
import gunbc.generated_artifact { GeneratedArtifact }
import gunbc.recurring_failure_mode { RecurringFailureMode, authored }
import gunbc.recurring_failure_mode.roster { recurring_failure_mode_roster }
import gunbc.rung_drop { RungDrop, rung_drop_roster, rung_drop_declaration_message }

// WHY A BYTE DIFFERENCE ON A LEDGER NEEDED ITS OWN NAME, MEASURED RATHER THAN ARGUED.
//
// The generated-artifact phase already refuses when committed bytes differ from generated bytes,
// and that refusal is correct and sufficient AS A WALL. What it could not do is SAY WHAT KIND of
// difference it found, and one kind matters far more than the rest: the committed projection no
// longer renders rows its own authority still declares. The ledger's own header says it "carries
// the rows in full"; when this class is live that sentence is false and nothing says so.
//
// THE CLASS IS INVISIBLE BECAUSE IT IS REPAIRED, NOT BECAUSE IT IS RARE. Heal regenerates the two
// design ledgers after a provisional merge -- gunbc.generated_artifact concurrent_divergence_repair
// names exactly these two artifacts as HealRegeneratesAfterProvisionalMerge -- so the ordinary life
// of this defect is: a branch merges main, which imports a row FILE without regenerating the
// projection; the head is authority-ahead-of-projection; heal regenerates and the difference is
// gone. Every observable trace is one commit whose message is "regenerate drifted generated
// artifacts", identical to every other such commit. A repair and an absence of a defect produce the
// same observable, so the recorded frequency of the class is ZERO BY CONSTRUCTION and it never
// ranks for a wall.
//
// THAT IS THE ABSORBING-FALLBACK SHAPE OF DESIGN SECTION 5, ARRIVING THROUGH THE REPAIR ARM RATHER
// THAN THE FAILURE ARM, and this repository has already paid for the other half of it: the merge
// driver was once bound to `true`, whose failure arm ANSWERED instead of refusing and destroyed the
// one fact worth keeping -- that a provisional choice had been made at all -- so the deficit's
// frequency was zero by construction and nothing ranked it. Here the repair SUCCEEDS and destroys
// the same fact. A silent repair is indistinguishable from an absent defect.
//
// MEASURED POPULATION, 2026-09-04, and the caveats belong with the number rather than beside it:
// of 35 heal commits reachable from any branch in one 24-hour window, 18 had a parent that was
// authority-ahead-of-projection, 11 had a coherent parent and repaired something else, and 6 are
// UNMEASURABLE because their parent predates the failure-mode preamble index. So 18 is a FLOOR over
// a 29-commit measurable denominator, NOT a rate over 35. The distribution is the persuasive part
// and is not a uniform trickle: one repair covered 14 identities and another 11, against thirteen
// single-identity repairs. A branch head was rendering fourteen fewer rows than its own authority
// declared, and the whole record of it is one indistinguishable heal commit. This function is the
// instrument that re-derives that classification, so the number is its OUTPUT and not a fact in
// prose -- DESIGN section 6 names the instrument and never transcribes its output.
//
// THE ZERO ON THE RUNG-DROP SURFACE MEANS UNREADABLE, NOT CLEAN, and the distinction is the whole
// reason this classifier keys off the AUTHORITY side. The retrospective measurement above could
// only read the failure-mode ledger, because that document carries an identity index in its
// preamble and the rung-drop document carries none -- its only machine-visible join is a count, and
// that count is already off by one for a structural reason (this projection injects a
// compile-phase-frontier `###` heading that is not a row). A zero that means "no defects" and a
// zero that means "cannot be read" are the same character. Deriving the rows from the ROSTER rather
// than from an index in the projection removes that asymmetry outright: neither document needs to
// carry an index for this to answer, and both are covered by the same construction.

type LedgerRow {
  identity: String
  body: String
}

// THE TWO LEDGERS ARE NOT ENUMERATED BY NAME HERE AS A SECOND ROSTER. The match is over the closed
// GeneratedArtifact coproduct, so a newly registered artifact does not silently acquire an empty
// row population by default -- the wildcard arm answers NOT-A-LEDGER, which is the honest answer
// for provisioning files and plan documents, and the two ledger arms are the only ones that carry a
// row identity at all. If a third ledger is ever registered its arm must be written here, and until
// it is, this classifier reports NotALedgerArtifact for it rather than reporting zero missing rows,
// which is the difference between "cannot speak for this" and "this is fine".
fn ledger_rows(a: GeneratedArtifact) -> List<LedgerRow> {
  match a {
    DesignFailureModesArtifact =>
      map(recurring_failure_mode_roster, r => LedgerRow {
        identity: (r.identity as String),
        body: authored(r: r)
      })
    DesignRungDropsArtifact =>
      map(rung_drop_roster, d => LedgerRow {
        identity: (d.identity as String),
        body: rung_drop_declaration_message(d: d)
      })
    _ => []
  }
}

// NOT-A-LEDGER IS AN ARM, NOT AN EMPTY LIST, for the reason DESIGN section 5 gives about degradation
// arms: an artifact this classifier cannot speak for must not inhabit the same state as an artifact
// it examined and found whole. Collapsing the two would make every provisioning file report
// "no rows missing" and would let a future ledger with no arm here read as coherent forever.
type LedgerRowCoherence
  = NotALedgerArtifact
  | LedgerRowsAllRendered
  | LedgerRowsMissingFromCommitted { missing: List<String> }

// THE RELATION IS DIRECTED AND THE DIRECTION IS THE POINT. A row counts as missing only when the
// GENERATED bytes carry it and the COMMITTED bytes do not -- that is under-rendering, the class
// where the ledger stops showing something its authority still declares. The reverse case,
// committed carrying a row the generation does not, is a different defect (a stale row surviving a
// deletion) and is deliberately NOT folded in here: it is still caught by the byte wall, and naming
// two opposite conditions with one word is how a diagnostic stops discriminating.
//
// THE BOUND ON THIS INSTRUMENT, STATED SO IT IS NOT CITED PAST ITSELF: containment is a SUBSTRING
// test over the rendered row body, so a row whose entire body were a substring of another row's
// body would not be reported missing while that other row is present. That is a false NEGATIVE --
// this classifier can under-report, never over-report -- and it cannot turn a real difference green,
// because the byte comparison in gunbc.generated_artifact_assessment is what refuses. This is a
// diagnostic riding on a wall, not the wall.
fn ledger_row_coherence(a: GeneratedArtifact, generated_content: String, committed_content: String) -> LedgerRowCoherence {
  let rows = ledger_rows(a: a)
  if length(rows) == 0 {
    NotALedgerArtifact
  } else {
    let missing = fold(rows, init: [], f: fn(acc, row) {
      if string_contains(s: generated_content, pattern: row.body)
        && !string_contains(s: committed_content, pattern: row.body) {
        concat(acc, [row.identity])
      } else {
        acc
      }
    })
    if length(missing) == 0 { LedgerRowsAllRendered } else {
      LedgerRowsMissingFromCommitted { missing: missing }
    }
  }
}

// THE RENDERING IS HERE AND NOT AT THE CONSUMER so a second caller cannot spell the same finding a
// different way (DESIGN section 3). The identities are listed rather than counted: a count tells a
// reader that something went dark and not WHICH thing, and the recurrence of one identity across
// several branches is the fact that made this class rank at all.
fn ledger_row_coherence_rendered(c: LedgerRowCoherence) -> String {
  match c {
    NotALedgerArtifact => ""
    LedgerRowsAllRendered => ""
    LedgerRowsMissingFromCommitted { missing } => concat(
      " INCOHERENT: the committed projection does not render these rows its authority declares: ",
      fold(missing, init: "", f: fn(acc, id) {
        if acc == "" { id } else { concat(acc, concat(", ", id)) }
      })
    )
  }
}
