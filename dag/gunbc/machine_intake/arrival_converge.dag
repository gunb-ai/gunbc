// THE ARRIVAL CONVERGENCE PREFIX (docs/plans/managed-host-untangle.md, cuts O1c-1 through O1c-3): the
// first real consumer of gunbc.fleet.convergence_fold. Its four steps are the first four phases of
// gunbc.machine_intake.phase arrival_phases_all -- AccessDiscover, IdentityBindProvisional,
// PriorLifeBoundary and BmcSecure -- each a protocol step through gunbc.host_convergence_protocol
// HostEffectDomainProjection (observe, assess, decide) with its own row in
// gunbc.host_convergence_census. The first two are read-only: the only decision either can reach is
// Noop (the phase's goal is read back as already holding) or Refuse; neither has an Apply, so an Apply
// decision is itself a typed refusal, and the read each consumes is a committed capture.
// PriorLifeBoundary is the first effectful step: its archive arm writes the controller's prior-life
// records to the evidence store and reads them back, DRY in this cut
// (gunbc.machine_intake.prior_life_boundary), so it is the one step that can be INCOMPLETE.
// BmcSecure is the first GATED step: Apply refuses unless authorization is discharged for that unit
// and that run (standing grant, operator capability, or federated workload principal selected before
// the fold); Noop needs no discharge. Nothing here performs a live BMC credential write.
// gunbc.bmc.bmc_onboarding is not imported.
//
// ORDERING TIME. No field of the read-only steps is an ordering clock. The controller's own DateTime is
// kept as an AccessDiscover observation only; the observer clock (gunbc.clock_read) orders the
// archive write's leg against its deadline, and nothing here orders by the controller's clock.

data arrival_order_authority_ref: DeclarationRef = decl_ref(module_path: "gunbc.machine_intake.phase", decl_name: "arrival_phases_all")

data access_discover_step_ref: DeclarationRef = decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "access_discover")

data identity_bind_provisional_step_ref: DeclarationRef = decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "identity_bind_provisional")

data prior_life_boundary_step_ref: DeclarationRef = decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "prior_life_boundary")

data bmc_secure_step_ref: DeclarationRef = decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "bmc_secure")

// A read-only phase has no remedy. The plan type of its projection is sealed to this module and this
// module constructs none, so an Apply over a read-only phase has no value to carry.
type ReadOnlyPhaseRemedy sole_constructor {
  phase: ArrivalPhase
}

// ── ACCESSDISCOVER ─────────────────────────────────────────────────────────────────────────────

// What the current read establishes: the unit it is bound to, the endpoint it answered at, the
// discriminated firmware family and build, the controller's own clock reading, and the read receipt.
type AccessObservation {
  unit: NonEmptyStr
  endpoint: BmcControllerEndpoint
  family: BmcFirmwareFamily
  firmware: BmcFirmwareReleaseIdentity
  controller_clock: ControllerClockReading
  read_receipt: EvidenceRef
}

type AccessDiscoverGoal {
  unit: StepSubjectKey
}

type AccessObserveRefusal
  = ManagerReadRefused { gap: RecordedManagerCaptureGap }
  | FamilyNotDiscriminated { discriminator: NonEmptyStr }
  | FirmwareVersionUnread
  | EndpointUnobserved
  | ReadReceiptDigestUnreadable { capture_sha256: NonEmptyStr }

type AccessDeviation
  = AccessReadForAnotherUnit { read_unit: NonEmptyStr, goal_unit: StepSubjectKey }

fn observe_access(key: StepInstanceKey, read: CurrentManagerRead) -> ObservationAttempt<AccessObservation, AccessObserveRefusal> {
  let identity = read.identity
  match identity.decoded {
    RecordedManagerRefused { gap: g } => ObservationRefused { cause: ManagerReadRefused { gap: g } }
    RecordedManagerDecoded { observation: o } =>
      match family_standing_from_discrimination(discrimination: discriminate_family(observation: o)) {
        FamilyUnobserved { discriminator: d } => ObservationRefused { cause: FamilyNotDiscriminated { discriminator: d } }
        FamilyObserved { family: f } =>
          if length(o.firmware_version) == 0 {
            ObservationRefused { cause: FirmwareVersionUnread }
          } else {
            match mtjade1_observed_endpoint(network: identity.endpoint) {
              Absent => ObservationRefused { cause: EndpointUnobserved }
              Present { value: endpoint } =>
                match manager_read_receipt(read: identity) {
                  Absent => ObservationRefused { cause: ReadReceiptDigestUnreadable { capture_sha256: identity.capture_sha256 } }
                  Present { value: receipt } =>
                    ObservationEstablished {
                      observed: AccessObservation {
                        unit: identity.subject,
                        endpoint: endpoint,
                        family: f,
                        firmware: bmc_firmware_release_identity_of_wire(family: f, wire: o.firmware_version as NonEmptyStr),
                        controller_clock: read.controller_clock,
                        read_receipt: receipt,
                      },
                    }
                }
            }
          }
      }
  }
}

fn assess_access(goal: AccessDiscoverGoal, observed: AccessObservation) -> GoalAssessment<AccessObservation, AccessDeviation, NonEmptyStr, NonEmptyStr> {
  if (observed.unit as String) == ((goal.unit as NonEmptyStr) as String) {
    GoalSatisfied { evidence: observed }
  } else {
    GoalDiverged { deviations: FreeSemigroup { head: AccessReadForAnotherUnit { read_unit: observed.unit, goal_unit: goal.unit }, tail: Empty } }
  }
}

fn decide_read_only<E, D>(assessment: GoalAssessment<E, D, NonEmptyStr, NonEmptyStr>) -> UpsertDecision<ReadOnlyPhaseRemedy> {
  match assessment {
    GoalSatisfied { evidence: _ } => Noop
    GoalDiverged { deviations: _ } => Refuse { reason: "the read-only phase's goal diverges from what was read, and a read-only phase has no remedy" as NonEmptyStr }
    GoalIndeterminate { known_deviations: _, unknowns: _ } => Refuse { reason: "the read-only phase's goal is indeterminate over what was read" as NonEmptyStr }
    GoalAssessmentRefused { cause: c } => Refuse { reason: c }
  }
}

fn decide_access(assessment: GoalAssessment<AccessObservation, AccessDeviation, NonEmptyStr, NonEmptyStr>) -> UpsertDecision<ReadOnlyPhaseRemedy> {
  decide_read_only(assessment: assessment)
}

fn decide_identity(assessment: GoalAssessment<ProvisionalIdentity, NonEmptyStr, NonEmptyStr, NonEmptyStr>) -> UpsertDecision<ReadOnlyPhaseRemedy> {
  decide_read_only(assessment: assessment)
}

fn access_discover_projection() -> HostEffectDomainProjection<StepInstanceKey, AccessDiscoverGoal, CurrentManagerRead, AccessObservation, AccessObservation, AccessDeviation, NonEmptyStr, AccessObserveRefusal, NonEmptyStr, ReadOnlyPhaseRemedy> {
  HostEffectDomainProjection {
    observe: observe_access,
    assess: assess_access,
    decide: decide_access,
  }
}

// THE ACCESSDISCOVER RECEIPT, SEALED. Minted only by access_discover, so the CURRENT route standing it
// carries is derived inside this step from the read it consumed, at the endpoint that read answered,
// and is never passed in. A Manager read proves a Redfish Manager surface and no account write, so
// the standing is a qualification CANDIDATE naming the Redfish account-password write, and nothing
// stronger: gunbc.machine_intake.bmc_rotation_route admit_rotation_apply refuses it.
type AccessDiscoverEstablished sole_constructor {
  key: StepInstanceKey
  access: AccessObservation
  route: BmcRotationRouteStanding
}

fn current_route_standing_of(access: AccessObservation) -> BmcRotationRouteStanding {
  rotation_route_candidate(
    endpoint: access.endpoint,
    firmware: access.firmware,
    request: redfish_account_password_write(account: bmc_firmware_factory_account(family: access.firmware.family)),
    evidence: ObservedSurfaceRead { surface: SurfaceManagerIdentity, receipt: access.read_receipt },
  )
}

// ── IDENTITYBINDPROVISIONAL ────────────────────────────────────────────────────────────────────

// WHAT THE UNIT SUPPLIES, SEALED: its two board-serial reads, each a sealed observation minted only
// by its own fail-closed file read (gunbc.machine_intake.mtjade1_access_observation read_mtjade1_fru
// and read_mtjade1_smbios_type2), and the unit keys already bound elsewhere in the fleet. Constructed
// only in this module, by the per-unit function that performs those reads. No supplied-value path
// reaches the step: the supplied-value controls go to classify_board_serial_agreement, which returns
// no carrier. The access receipt is the step's precondition and is checked against the ledger.
type IdentityBindInputs sole_constructor {
  fru: FruRead
  smbios: SmbiosRead
  other_units: List<UnitKey>
}

type IdentityBindRequest {
  access: AccessDiscoverEstablished
  inputs: IdentityBindInputs
}

// WHY THE TWO SOURCES DO NOT AGREE ABOUT THIS UNIT. Pure, over supplied values, so every arm is
// exercisable; its only production consumer is observe_identity below, over sealed observations.
type BoardSerialAgreementRefusal
  = FruCaptureUnread { cause: NonEmptyStr }
  | SmbiosCaptureUnread { cause: NonEmptyStr }
  | FruObservedForAnotherUnit { subject: NonEmptyStr }
  | SmbiosObservedForAnotherUnit { subject: NonEmptyStr }
  | SmbiosSessionForAnotherController { attested: BmcControllerEndpoint, accessed: BmcControllerEndpoint }
  | BoardSerialsDisagree { fru: NonEmptyStr, smbios: NonEmptyStr }

// THE SOL SESSION CHECK, over an OPTIONAL attribution. An observation whose source is a witness fixture
// carries no session, and none is not "read through some unnamed controller": there is nothing to compare,
// so nothing contradicts the access and the arm cannot fire (mtjade1_access_observation.smbios_session_controller).
// A capture-backed SMBIOS observation always carries its attribution, where the arm does discriminate.
fn smbios_session_disagrees(attested: BmcControllerEndpoint?, accessed: BmcControllerEndpoint) -> Bool {
  match attested {
    Present { value: c } => (c.host as String) != (accessed.host as String)
    Absent => false
  }
}

fn classify_board_serial_agreement(
  unit: StepSubjectKey,
  accessed: BmcControllerEndpoint,
  fru_subject: NonEmptyStr,
  fru_serial: NonEmptyStr,
  smbios_subject: NonEmptyStr,
  smbios_controller: BmcControllerEndpoint?,
  smbios_serial: NonEmptyStr,
) -> BoardSerialAgreementRefusal? {
  if (fru_subject as String) != ((unit as NonEmptyStr) as String) {
    Present { value: FruObservedForAnotherUnit { subject: fru_subject } }
  } else if (smbios_subject as String) != ((unit as NonEmptyStr) as String) {
    Present { value: SmbiosObservedForAnotherUnit { subject: smbios_subject } }
  } else if smbios_session_disagrees(attested: smbios_controller, accessed: accessed) {
    // The guard is true only for a Present attestation naming another host, so the refusal names the
    // endpoint the session was actually attested to. There is no endpoint invented for an unattested
    // session (DESIGN §5: a value that looks real makes a false fact writable).
    match smbios_controller {
      Present { value: c } => Present { value: SmbiosSessionForAnotherController { attested: c, accessed: accessed } }
      Absent => none
    }
  } else if (fru_serial as String) != (smbios_serial as String) {
    Present { value: BoardSerialsDisagree { fru: fru_serial, smbios: smbios_serial } }
  } else {
    none
  }
}

// THE TWO-SOURCE AGREEMENT, SEALED and minted only in observe_identity: exactly one BMC FRU and one
// host SMBIOS observation, both of this unit, the SMBIOS session attested to the controller this run's
// AccessDiscover read, and equal board serials. IdentityBoundProvisional retains it, so a consumer can
// tell a two-source key from a one-source one; without both observations there is no agreement and
// the step does not converge.
type BoardSerialAgreement sole_constructor {
  fru: RecordedFruObservation
  smbios: RecordedSmbiosObservation
  serial: NonEmptyStr
}

type IdentityObservation {
  unit_key: UnitKey
  agreement: BoardSerialAgreement
  assembly: AssemblyManifest
  firmware: FirmwareManifest
}

type ProvisionalIdentity {
  subject: MachineIntakeSubject
  agreement: BoardSerialAgreement
}

type IdentityBindGoal {
  attempt: IntakeAttemptId
}

type IdentityObserveRefusal
  = BoardSerialsNotInAgreement { cause: BoardSerialAgreementRefusal }
  | UnitKeyNotBound { cause: UnitKeyRefusalCause }

// THE LIVE FIRMWARE MANIFEST: the build the controller reported in this run's AccessDiscover read.
// Only the BMC build is read before boot; host firmware and configuration digests join the manifest
// when an observation names them.
fn live_firmware_manifest(access: AccessDiscoverEstablished) -> FirmwareManifest {
  FirmwareManifest {
    entries: [FirmwareEntry { component: "bmc", version: access.access.firmware.raw_version }],
    configuration_digests: [],
  }
}

fn observe_identity(key: StepInstanceKey, request: IdentityBindRequest) -> ObservationAttempt<IdentityObservation, IdentityObserveRefusal> {
  match request.inputs.fru {
    FruReadRefused { gap: g } => ObservationRefused { cause: BoardSerialsNotInAgreement { cause: FruCaptureUnread { cause: fru_gap_text(gap: g) } } }
    FruObserved { observation: fru } =>
      match request.inputs.smbios {
        SmbiosReadRefused { gap: g } => ObservationRefused { cause: BoardSerialsNotInAgreement { cause: SmbiosCaptureUnread { cause: smbios_gap_text(gap: g) } } }
        SmbiosObserved { observation: smbios } =>
          match classify_board_serial_agreement(
            unit: key.subject,
            accessed: request.access.access.endpoint,
            fru_subject: fru.subject,
            fru_serial: fru.fields.board_serial,
            smbios_subject: smbios.subject,
            smbios_controller: smbios_session_controller(source: smbios.source),
            smbios_serial: smbios.serial,
          ) {
            Present { value: why } => ObservationRefused { cause: BoardSerialsNotInAgreement { cause: why } }
            Absent => observe_identity_from_agreement(request: request, agreement: BoardSerialAgreement { fru: fru, smbios: smbios, serial: fru.fields.board_serial })
          }
      }
  }
}

// The unit key through gunbc.machine_intake.subject bind_unit_key, unchanged, over the agreement's two
// observations; it still refuses a serial already bound to another unit.
fn observe_identity_from_agreement(request: IdentityBindRequest, agreement: BoardSerialAgreement) -> ObservationAttempt<IdentityObservation, IdentityObserveRefusal> {
  let inputs = UnitIdentityInputs {
    bmc_endpoint: BmcEndpoint { host: request.access.access.endpoint.host, protocol: Redfish },
    board_serial_observations: [
      BoardSerialObservation { source: BmcFru, serial: agreement.fru.fields.board_serial },
      BoardSerialObservation { source: HostSmbios, serial: agreement.smbios.serial },
    ],
  }
  match bind_unit_key(inputs: inputs, other_units: request.inputs.other_units) {
    UnitKeyRefused { cause: c } => ObservationRefused { cause: UnitKeyNotBound { cause: c } }
    UnitKeyBound { key: k } =>
      ObservationEstablished {
        observed: IdentityObservation {
          unit_key: k,
          agreement: agreement,
          assembly: provisional_assembly_of_fru(fru: agreement.fru),
          firmware: live_firmware_manifest(access: request.access),
        },
      }
  }
}

fn assess_identity(goal: IdentityBindGoal, observed: IdentityObservation) -> GoalAssessment<ProvisionalIdentity, NonEmptyStr, NonEmptyStr, NonEmptyStr> {
  GoalSatisfied {
    evidence: ProvisionalIdentity {
      subject: MachineIntakeSubject {
        subject: qualification_subject_of(unit_key: observed.unit_key, assembly: observed.assembly, firmware: observed.firmware),
        attempt_id: goal.attempt,
      },
      agreement: observed.agreement,
    },
  }
}

fn identity_bind_projection() -> HostEffectDomainProjection<StepInstanceKey, IdentityBindGoal, IdentityBindRequest, IdentityObservation, ProvisionalIdentity, NonEmptyStr, NonEmptyStr, IdentityObserveRefusal, NonEmptyStr, ReadOnlyPhaseRemedy> {
  HostEffectDomainProjection {
    observe: observe_identity,
    assess: assess_identity,
    decide: decide_identity,
  }
}

// THE IDENTITYBINDPROVISIONAL RECEIPT, SEALED. It names the AccessDiscover instance it consumed, so
// the fold can refuse a subject bound from another unit's or another run's access receipt, and it
// retains the two-source agreement the unit key was bound from.
type IdentityBoundProvisional sole_constructor {
  key: StepInstanceKey
  consumed_access: StepInstanceKey
  subject: MachineIntakeSubject
  agreement: BoardSerialAgreement
}

// ONE INTAKE ATTEMPT PER RUN, BY CONSTRUCTION: the attempt identity is the run identity.
fn intake_attempt_of_run(run: ConvergenceRunId) -> IntakeAttemptId {
  (run as NonEmptyStr) as IntakeAttemptId
}

// ── THE STEPS, AS THE FOLD SEES THEM ───────────────────────────────────────────────────────────

type ArrivalStepReceipt
  = AccessDiscoverReceipt { receipt: AccessDiscoverEstablished }
  | IdentityBindReceipt { receipt: IdentityBoundProvisional }
  | PriorLifeBoundaryReceipt { receipt: PriorLifeBoundaryEstablished }
  | BmcSecureReceipt { receipt: BmcSecureStepEstablished }

type ArrivalStepRefusal
  = AccessDiscoverObserveRefused { cause: AccessObserveRefusal }
  // CREDENTIAL UNKNOWN, IN-BAND ROUTE AVAILABLE. The third thing AccessDiscover can say, beside "I
  // observed access" and "the controller refused me": the out-of-band credential we hold is not the
  // credential this controller accepts, and this unit has a MODELED way back in -- the in-band recovery
  // route of gunbc.machine_intake.bmc_recovery_route. The cause is that route's own named judgement and
  // not AccessObserveRefusal, because ControllerUnreachable there means "the controller did not answer"
  // -- and a locked-but-alive BMC answers perfectly well; folding the two is how a board that needs a
  // rescue medium gets written off as dead metal. The cause names what the route still requires (no
  // reachable rescue host yet, firmware policy never measured yet, readback inconclusive yet), which is
  // the next physical action, not a retry. The arm carries NO receipt: an available route is not
  // access, and nothing downstream may treat it as such -- it stops the run exactly like any other
  // refusal. IntakePhase is untouched: this is a refusal of a step already in the phase order, not a
  // new phase, so IntakePhase in this module stays the only authority over the order (§3).
  // THE CALLER'S WIRING MISTAKE IS REFUSED, NOT IGNORED. The standing must name the unit the step instance
  // names -- both sides are branded strings from different modules, so they are compared as whole strings,
  // and compared at all rather than trusting the caller passed the right recovery. What this function may
  // NOT do is answer `none` to a mismatch: that is indistinguishable from "nobody supplied an observation",
  // so a caller that paired this board with another board's standing would send the run down the
  // out-of-band path as if nothing had been said -- the wrong-unit observation disappears and the defect
  // stays in the wiring. §5: "every path succeeds fully or fails with a typed, located diagnostic", and "a
  // failure arm refuses, never widens". This module already refuses the same class of mistake loudly
  // (IdentityBindAccessForAnotherInstance, BmcSecureIdentityForAnotherInstance, AccessReadForAnotherUnit),
  // which is why the silent `none` here was the outlier. Both keys travel so the pairing is checkable
  // from the refusal alone.
  | AccessDiscoverRecoveryStandingForAnotherUnit { standing_unit: NonEmptyStr, step_unit: StepSubjectKey }
  | AccessDiscoverCredentialUnknownRecoveryRouteAvailable { cause: RecoveryRouteUnavailable }
  | IdentityBindObserveRefused { cause: IdentityObserveRefusal }
  | IdentityBindAccessForAnotherInstance { access: StepInstanceKey }
  | ReadOnlyPhaseRefused { phase: ArrivalPhase, reason: NonEmptyStr }
  | ReadOnlyPhaseDecidedApply { phase: ArrivalPhase }
  | ReadOnlyPhaseSatisfiedWithoutEvidence { phase: ArrivalPhase }
  | PriorLifeIdentityForAnotherInstance { identity: StepInstanceKey }
  | PriorLifeBoundaryRefused { cause: PriorLifeRefusal }
  | BmcSecureIdentityForAnotherInstance { identity: StepInstanceKey }
  | BmcSecureAuthorizationUndischarged
  | BmcSecurePhaseDomainRefused
  | BmcSecureApplyInputsMissing
  | BmcSecureApplicationForAnotherInstance { subject: MachineIntakeSubject }
  | BmcSecureApplicationNotTheInspectedTransition
  // THE FORCED BUILD AND THE AUTHENTICATED READ DISAGREE (item 5). On a run that took the
  // ForcedFirstRotationPrecedesPriorLife row, the post-write authenticated firmware read MUST name the
  // build the 403 was inferred to be (gunbc.machine_intake.bmc_credential_policy
  // ForcedBuildInferredFromTheResponse, the obligation named by gunbc.machine_intake.bmc_rotation_route
  // forced_first_rotation_apply_frontier). The forced state proved nothing about the controller after the
  // write -- the authenticated read is its only confirmation -- so a read of a DIFFERENT build means the
  // credential was written on a controller that is not the one the 403 described, and BmcSecure refuses
  // rather than establishing a secured standing for the wrong firmware. Both builds travel so the
  // disagreement is checkable from the refusal alone. This arm is reachable only on the forced path; a
  // non-forcing build never runs the check.
  | BmcSecureForcedBuildDisagreesWithForcedResponse { inferred: BmcFirmwareReleaseIdentity, read: BmcFirmwareReleaseIdentity }

type ArrivalStepIncomplete
  = PriorLifeBoundaryIncomplete { cause: PriorLifeIncomplete }
  // THE PRIOR LIFE CANNOT BE DECIDED ACROSS THE FORCED WRITE. Not a refusal and not a pass: a run that
  // took the ForcedFirstRotationPrecedesPriorLife row read its archive after the forced root write, and
  // the post-write archive grounds no entry from before the write instant. That cannot, from here, tell a
  // genuinely factory-fresh controller from one whose history the write erased (both read as no pre-write
  // entry), so the boundary is neither passed (a BMC whose history the write erased must not enter the
  // fleet unexamined) nor refused (that would brick every genuinely new unit). The run is INCOMPLETE --
  // the standing is never established, so fleet admission reports the phase missing and the unit does not
  // enter the fleet -- and the verdict names the operator decision that would decide it. This is why it is
  // an INCOMPLETE and not one of the ArrivalStepRefusal arms above: a refusal would say the boundary
  // failed, which is a different claim.
  | ForcedWritePriorLifeIndeterminate { verdict: PriorLifeIndeterminateAcrossForcedWrite }

type BmcSecureStepEstablished sole_constructor {
  key: StepInstanceKey
  consumed_prior_life: StepInstanceKey
  phase: BmcSecurePhaseReceipt
}

fn bmc_secure_step_established(key: StepInstanceKey, consumed_prior_life: StepInstanceKey, phase: BmcSecurePhaseReceipt) -> BmcSecureStepEstablished
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "bmc_secure"),
    decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "bmc_secure_bound"),
  ]
{
  BmcSecureStepEstablished { key: key, consumed_prior_life: consumed_prior_life, phase: phase }
}

fn arrival_receipt_key(r: ArrivalStepReceipt) -> StepInstanceKey {
  match r {
    AccessDiscoverReceipt { receipt: a } => a.key
    IdentityBindReceipt { receipt: i } => i.key
    PriorLifeBoundaryReceipt { receipt: p } => prior_life_receipt_key(r: p)
    BmcSecureReceipt { receipt: b } => b.key
  }
}

fn arrival_receipt_consumed(r: ArrivalStepReceipt) -> List<StepInstanceKey> {
  match r {
    AccessDiscoverReceipt { receipt: _ } => []
    IdentityBindReceipt { receipt: i } => [i.consumed_access]
    PriorLifeBoundaryReceipt { receipt: p } => [prior_life_receipt_consumed_identity(r: p)]
    BmcSecureReceipt { receipt: b } => [b.consumed_prior_life]
  }
}

fn arrival_receipt_authorization_required(r: ArrivalStepReceipt) -> Bool {
  match r {
    AccessDiscoverReceipt { receipt: _ } => false
    IdentityBindReceipt { receipt: _ } => false
    PriorLifeBoundaryReceipt { receipt: _ } => false
    BmcSecureReceipt { receipt: b } =>
      match b.phase.decision {
        BmcSecurePhaseNoop { observation: _ } => false
        BmcSecurePhaseApplied { plan: _, application: _, post_read: _ } => true
      }
  }
}

fn arrival_receipt_projection() -> ConvergenceReceiptProjection<ArrivalStepReceipt> {
  convergence_receipt_projection(key_of: arrival_receipt_key, consumed_of: arrival_receipt_consumed, authorization_required_of: arrival_receipt_authorization_required)
}

fn read_only_refusal(phase: ArrivalPhase, decision: UpsertDecision<ReadOnlyPhaseRemedy>) -> ArrivalStepRefusal {
  match decision {
    Refuse { reason: r } => ReadOnlyPhaseRefused { phase: phase, reason: r }
    Apply { plan: _ } => ReadOnlyPhaseDecidedApply { phase: phase }
    Noop => ReadOnlyPhaseSatisfiedWithoutEvidence { phase: phase }
  }
}

// WHO BUILDS THE CREDENTIAL-UNKNOWN ARM. A locked unit is refused here, with the recovery route's own
// named requirement as the cause -- and the arm is REFUSED TO when the route has already handed off.
// That second half is the point: a standing whose recovery completed is not a refusal at all, it is the
// case where the out-of-band path is back in reach (bmc_secure's, not this module's), so minting a
// refusal from it would let a recovered unit be reported as locked. The recovery module cannot mint
// this arm (its standing is sealed, and the arm belongs to the arrival step), and this module cannot
// mint a recovery standing; the seam needs both, which is why it sits here.
fn access_discover_refusal_for_locked_credential(
  key: StepInstanceKey,
  standing: InBandRecoveryStanding?,
) -> ArrivalStepRefusal? {
  match standing {
    Absent => none
    Present { value: s } =>
      // The standing must name the unit the step instance names. Both sides are branded strings from
      // different modules, so they are compared as whole strings -- and compared at all, rather than
      // trusting that the caller passed the right recovery: minting this arm from another unit's locked
      // standing would send a healthy board off to find a rescue USB.
      if (s.subject.subject.unit_key as NonEmptyStr) != (key.subject as NonEmptyStr) {
        // REFUSED, NOT DROPPED. `none` here meant "no observation was supplied", which is a different fact:
        // an observation WAS supplied and it belongs to another unit. A caller that crossed two boards'
        // wires got a run that quietly continued as if nothing had been observed, so the only trace of the
        // defect was a healthy board walking the out-of-band path. §5: "every path succeeds fully or fails
        // with a typed, located diagnostic" -- and "a failure arm refuses, never widens".
        Present {
          value: AccessDiscoverRecoveryStandingForAnotherUnit {
            standing_unit: s.subject.subject.unit_key as NonEmptyStr,
            step_unit: key.subject,
          },
        }
      } else {
        match recovery_route_unavailability(standing: s) {
          Present { value: cause } =>
            Present { value: AccessDiscoverCredentialUnknownRecoveryRouteAvailable { cause: cause } }
          Absent => none
        }
      }
  }
}

// THE ACCESSDISCOVER STEP: observe the current read, assess it against the unit the instance names,
// decide; only Noop over a satisfied assessment mints the receipt.
fn access_discover(
  key: StepInstanceKey,
  read: CurrentManagerRead,
  locked: InBandRecoveryStanding?,
) -> StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete> {
  // CONSUMER OF THE LOCKED-CREDENTIAL ARM -- the reason it is not a dangling declaration. The recovery
  // standing is an OBSERVED input here, not inferred from the read: this module's out-of-band read cannot
  // distinguish "we do not hold the password" from "the manager would not answer", and pretending otherwise
  // is how a board needing a rescue medium gets written off as dead metal (that read's own refusals are
  // AccessObserveRefusal, whose arms are all capture-reading faults). So the caller supplies what was
  // actually observed by the in-band route, and if it observed nothing the step behaves exactly as before.
  // A standing that completed hands off `none` here, and the out-of-band path is taken on its merits.
  // CLASSIFIED, NOT HIDDEN (section 3c: "consumed by a named later change"): EVERY CALLER IN THE PRODUCT
  // passes `locked: none` today, and the only caller that supplies a real standing is
  // machine_intake_bmc_recovery_route_witness. That is honest rather than dangling -- the one unit whose
  // locked-BMC recovery is actually captured (the specimen under
  // artifacts/bmc/altrad8ud-1l2t-6-inband-recovery-2026-10-16/) is not the unit these arrival entries run,
  // so a live caller would have to invent a board that was never observed. When that specimen gets its own
  // arrival entry, its standing goes in at this parameter; until then the seam is exercised only by the
  // named witness, which is what the classification is for.
  match access_discover_refusal_for_locked_credential(key: key, standing: locked) {
    Present { value: refusal } => StepRefused { key: key, cause: refusal }
    Absent => access_discover_from_read(key: key, read: read)
  }
}

fn access_discover_from_read(key: StepInstanceKey, read: CurrentManagerRead) -> StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete> {
  let projection = access_discover_projection()
  match inspect_via_host_effect_projection(subject: key, goal: AccessDiscoverGoal { unit: key.subject }, request: read, projection: projection) {
    GoalObservationRefused { subject: _, goal: _, request: _, cause: c } => StepRefused { key: key, cause: AccessDiscoverObserveRefused { cause: c } }
    GoalInspected { subject: _, goal: _, request: _, observed: _, assessment: a } => {
      let decision = projection.decide(a)
      match decision {
        Noop =>
          match a {
            GoalSatisfied { evidence: access } =>
              StepEstablished {
                receipt: AccessDiscoverReceipt {
                  receipt: AccessDiscoverEstablished { key: key, access: access, route: current_route_standing_of(access: access) },
                },
              }
            GoalDiverged { deviations: _ } => StepRefused { key: key, cause: read_only_refusal(phase: AccessDiscover, decision: decision) }
            GoalIndeterminate { known_deviations: _, unknowns: _ } => StepRefused { key: key, cause: read_only_refusal(phase: AccessDiscover, decision: decision) }
            GoalAssessmentRefused { cause: _ } => StepRefused { key: key, cause: read_only_refusal(phase: AccessDiscover, decision: decision) }
          }
        Apply { plan: _ } => StepRefused { key: key, cause: read_only_refusal(phase: AccessDiscover, decision: decision) }
        Refuse { reason: _ } => StepRefused { key: key, cause: read_only_refusal(phase: AccessDiscover, decision: decision) }
      }
    }
  }
}

// THE IDENTITYBINDPROVISIONAL STEP: the unit key from bind_unit_key over the unit's board-serial
// observations, the provisional assembly, the live firmware manifest from the consumed access
// receipt, qualification_subject_of, then MachineIntakeSubject with this run's one attempt identity.
fn identity_bind_provisional(key: StepInstanceKey, access: AccessDiscoverEstablished, inputs: IdentityBindInputs) -> StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete> {
  if (access.key.run as NonEmptyStr) != (key.run as NonEmptyStr) || (access.key.subject as NonEmptyStr) != (key.subject as NonEmptyStr) {
    StepRefused { key: key, cause: IdentityBindAccessForAnotherInstance { access: access.key } }
  } else {
    identity_bind_for_access(key: key, access: access, inputs: inputs)
  }
}

// The access receipt is this instance's own (same run, same subject): the step binds from it.
fn identity_bind_for_access(key: StepInstanceKey, access: AccessDiscoverEstablished, inputs: IdentityBindInputs) -> StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete> {
  let projection = identity_bind_projection()
  let request = IdentityBindRequest { access: access, inputs: inputs }
  match inspect_via_host_effect_projection(subject: key, goal: IdentityBindGoal { attempt: intake_attempt_of_run(run: key.run) }, request: request, projection: projection) {
    GoalObservationRefused { subject: _, goal: _, request: _, cause: c } => StepRefused { key: key, cause: IdentityBindObserveRefused { cause: c } }
    GoalInspected { subject: _, goal: _, request: _, observed: _, assessment: a } => {
      let decision = projection.decide(a)
      match decision {
        Noop =>
          match a {
            GoalSatisfied { evidence: s } =>
              StepEstablished {
                receipt: IdentityBindReceipt {
                  receipt: IdentityBoundProvisional { key: key, consumed_access: access.key, subject: s.subject, agreement: s.agreement },
                },
              }
            GoalDiverged { deviations: _ } => StepRefused { key: key, cause: read_only_refusal(phase: IdentityBindProvisional, decision: decision) }
            GoalIndeterminate { known_deviations: _, unknowns: _ } => StepRefused { key: key, cause: read_only_refusal(phase: IdentityBindProvisional, decision: decision) }
            GoalAssessmentRefused { cause: _ } => StepRefused { key: key, cause: read_only_refusal(phase: IdentityBindProvisional, decision: decision) }
          }
        Apply { plan: _ } => StepRefused { key: key, cause: read_only_refusal(phase: IdentityBindProvisional, decision: decision) }
        Refuse { reason: _ } => StepRefused { key: key, cause: read_only_refusal(phase: IdentityBindProvisional, decision: decision) }
      }
    }
  }
}

// THE PRIORLIFEBOUNDARY STEP: the archive of the unit's prior-life records, dry, over the subject the
// IdentityBindProvisional receipt of this run and this subject bound. The platform's policy row is
// selected by the caller before the step (DESIGN §3d); the archive, its write, its deadline and its
// readback are gunbc.machine_intake.prior_life_boundary's. A refusal wrote nothing; an incomplete
// write is its own outcome and never converged.
fn prior_life_boundary(key: StepInstanceKey, identity: IdentityBoundProvisional, platform: DeclarationRef, world: DryPriorLifeWorld, across: PriorLifeForcedWriteContext?) -> StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete> {
  if (identity.key.run as NonEmptyStr) != (key.run as NonEmptyStr) || (identity.key.subject as NonEmptyStr) != (key.subject as NonEmptyStr) {
    StepRefused { key: key, cause: PriorLifeIdentityForAnotherInstance { identity: identity.key } }
  } else {
    match dry_archive_prior_life_across_forced_write(key: key, consumed_identity: identity.key, subject: identity.subject, platform: platform, world: world, across: across).outcome {
      PriorLifeArchiveEstablished { receipt: r } => StepEstablished { receipt: PriorLifeBoundaryReceipt { receipt: r } }
      PriorLifeArchiveRefused { cause: c } => StepRefused { key: key, cause: PriorLifeBoundaryRefused { cause: c } }
      PriorLifeArchiveIncomplete { cause: i } => StepIncomplete { key: key, cause: PriorLifeBoundaryIncomplete { cause: i } }
      // Across a forced write with no pre-write entry grounded: an INCOMPLETE, not a refusal. The standing
      // is never established, so fleet admission reports PriorLifeBoundary missing and the unit stays out of
      // the fleet, and the verdict travels with the operator decision it needs.
      PriorLifeArchiveIndeterminateAcrossForcedWrite { verdict: v } => StepIncomplete { key: key, cause: ForcedWritePriorLifeIndeterminate { verdict: v } }
    }
  }
}

type BmcSecureApplyInputs {
  application: BmcAccountApplication
  post_read: BmcAccountStateObservation
}

type BmcSecureInputs {
  goal: BmcSecureGoal
  reading: BmcAccountStateObservation
  grant: StandingOperatorGrant?
  capability: ScopedAuthorization<BmcAccountWriteApproval>?
  apply: BmcSecureApplyInputs?
  hold_release: RunnerThroughputAssessment<HostIdentity>?
}

// A federated principal is not a discharge input. StandingBmcSecureAccountWrite on the operator-ssh
// units is WorkloadIdentityUnbindable, so FederatedScopedGrant is not a selected pattern for this
// effect. A NonEmptyStr here was a silent widen (review 38602): any string minted Apply.

fn bmc_secure_account_rotation_site() -> DeclarationRef {
  decl_ref(module_path: "gunbc.machine_intake.bmc_secure", decl_name: "plan_bmc_account_action")
}

fn grant_discharges_bmc_secure_account_write(g: StandingOperatorGrant, host: HostIdentity) -> Bool {
  standing_grant_covers(g: g, scope: StandingGrantHost { host: host }, effect: StandingBmcSecureAccountWrite)
    && match standing_grant_arm_interlock(g: g, e: StandingBmcSecureAccountWrite) {
      InterlockPending { obligation: _ } => false
      InterlockedBy { hold: h } =>
        ruling_interlock_is_rostered(site_ref: bmc_secure_account_rotation_site(), interlock: h)
    }
}

// The operator's go for this write, read once (read_bmc_write_approval), and bound to this run: the
// grant's attempt is the run that filed the request, so a grant another run claimed discharges nothing.
fn capability_discharges_bmc_secure_account_write(
  r: ScopedAuthorization<BmcAccountWriteApproval>,
  standing: BmcRotationRouteStanding,
  request: BmcAccountWriteRequest,
  key: StepInstanceKey,
) -> NonEmptyStr? {
  match read_bmc_write_approval(approval: r, subject: route_subject_of(standing: standing, request: request), required: RotateCredential) {
    BmcWriteApprovalRefused { cause: _ } => none
    BmcWriteApproved { attempt: a, granted_by: by } =>
      if (a as NonEmptyStr) == (key.run as NonEmptyStr) { Present { value: by } } else { none }
  }
}

fn bound_bmc_secure_host(key: StepInstanceKey) -> HostIdentity? {
  operator_host_named(label: key.subject as NonEmptyStr)
}

// THE BOUND HOST'S CONTROLLER ROW ADMITS THIS ROUTE (gunbc.machine_intake.bmc_write_controller): the row's
// endpoint is the one the write targets, the row is not held (or `release` releases its hold), and its
// discharge admits the route. A held row refuses in dry and wet runs alike unless the inputs carry the
// assessment its hold names. Nothing produces that assessment from a real run yet (gunbc.runner
// runner_throughput_qualification qualification_run_producer_frontier).
fn bound_host_controller_admits(host: HostIdentity, endpoint: BmcControllerEndpoint, board: BoardAuthorityRef?, route: BmcWriteRoute, qualification: RunnerThroughputAssessment<HostIdentity>?) -> Bool {
  match select_bmc_write_controller(host: host, target: endpoint, board: board, route: route, qualification: qualification) {
    BmcWriteControllerSelected { row: _ } => true
    BmcWriteControllerRefused { cause: _ } => false
  }
}

fn bmc_secure_instance_joins_this_controller(
  key: StepInstanceKey,
  identity_subject: MachineIntakeSubject,
  reading: BmcAccountStateObservation,
  standing: BmcRotationRouteStanding,
) -> Bool {
  same_intake_subject(left: reading.subject, right: identity_subject)
    && (key.run as String) == (identity_subject.attempt_id as String)
    && (standing.endpoint.host as String) == (reading.endpoint.host as String)
}

fn capability_discharge(
  key: StepInstanceKey,
  inputs: BmcSecureInputs,
  standing: BmcRotationRouteStanding,
  request: BmcAccountWriteRequest,
) -> InstanceAuthorization?
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "discharge_bmc_secure_apply"),
  ]
{
  match inputs.capability {
    Present { value: r } =>
      match capability_discharges_bmc_secure_account_write(r: r, standing: standing, request: request, key: key) {
        Present { value: by } => Present { value: instance_authorization(key: key, principal: by) }
        Absent => none
      }
    Absent => none
  }
}

fn discharge_bmc_secure_apply(
  key: StepInstanceKey,
  identity_subject: MachineIntakeSubject,
  inputs: BmcSecureInputs,
  standing: BmcRotationRouteStanding,
  request: BmcAccountWriteRequest,
) -> InstanceAuthorization?
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "bmc_secure_bound"),
    decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "converge_arrival_through_bmc_secure"),
    decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "converge_arrival_forced_through_bmc_secure"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_bmc_secure_apply_uncovered_grant_falls_through_to_capability"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_bmc_secure_apply_uncovered_grant_refuses_a_capability_for_another_request"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_a_foreign_bound_host_key_cannot_mint_from_this_instance_controller"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "mtjade1_discharge_released_by"),
  ]
{
  if !bmc_secure_instance_joins_this_controller(key: key, identity_subject: identity_subject, reading: inputs.reading, standing: standing) {
    none
  } else {
    match bound_bmc_secure_host(key: key) {
      Absent => none
      Present { value: host } => {
        let by_capability = if bound_host_controller_admits(host: host, endpoint: standing.endpoint, board: inputs.reading.board, route: ByPerWriteApproval, qualification: inputs.hold_release) {
          capability_discharge(key: key, inputs: inputs, standing: standing, request: request)
        } else {
          none
        }
        match inputs.grant {
          Present { value: g } =>
            if grant_discharges_bmc_secure_account_write(g: g, host: host)
              && bound_host_controller_admits(host: host, endpoint: standing.endpoint, board: inputs.reading.board, route: ByStandingGrant, qualification: inputs.hold_release) {
              Present { value: instance_authorization(key: key, principal: g.principal) }
            } else {
              by_capability
            }
          Absent => by_capability
        }
      }
    }
  }
}

fn managed_generation_advances_the_requested(requested: ManagedCredentialReference, planned: ManagedCredentialReference) -> Bool {
  requested.account == planned.account
    && requested.role == planned.role
    && (requested.secret.project as String) == (planned.secret.project as String)
    && requested.secret.secret == planned.secret.secret
    && planned.credential_epoch > requested.credential_epoch
}

fn bmc_account_observation_is_the_inspected_pre_state(inspected: BmcAccountStateObservation, diverged: BmcAccountStateObservation) -> Bool {
  bmc_account_state_observation_same(a: inspected, b: diverged)
}

fn bmc_secure_application_joins_this_instance(
  identity_subject: MachineIntakeSubject,
  inspected_reading: BmcAccountStateObservation,
  requested_goal: BmcSecureGoal,
  application: BmcAccountApplication,
) -> ArrivalStepRefusal? {
  if !same_intake_subject(left: application.plan.subject, right: identity_subject) {
    Present { value: BmcSecureApplicationForAnotherInstance { subject: application.plan.subject } }
  } else if !bmc_account_observation_is_the_inspected_pre_state(inspected: inspected_reading, diverged: application.plan.diverged) {
    Present { value: BmcSecureApplicationNotTheInspectedTransition }
  } else if !managed_reference_same(a: requested_goal.published_break_glass, b: application.plan.goal.published_break_glass) {
    Present { value: BmcSecureApplicationNotTheInspectedTransition }
  } else if !content_hash_equal(left: machine_qualification_policy_digest(policy: requested_goal.policy), right: machine_qualification_policy_digest(policy: application.plan.goal.policy)) {
    Present { value: BmcSecureApplicationNotTheInspectedTransition }
  } else if !managed_generation_advances_the_requested(requested: requested_goal.managed, planned: application.plan.goal.managed) {
    Present { value: BmcSecureApplicationNotTheInspectedTransition }
  } else {
    none
  }
}

// Apply and discharge consume the bound subject's identity and the instance keys, not the
// AccessDiscover/IdentityBind capture parses. Those steps remain the prefix; this is the BMC
// grain after PriorLifeBoundary.
fn bmc_secure_bound(
  key: StepInstanceKey,
  identity_key: StepInstanceKey,
  identity_subject: MachineIntakeSubject,
  prior_key: StepInstanceKey,
  inputs: BmcSecureInputs,
) -> StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete>
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "bmc_secure"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "bmc_secure_bound_refuses_foreign_apply"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_bmc_secure_apply_without_authorization_refuses_after_a_real_apply"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_bmc_secure_apply_for_a_later_break_glass_generation_is_refused"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_bmc_secure_apply_of_another_channel_state_is_refused"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_bmc_secure_apply_of_a_different_present_controller_clock_is_refused"),
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "w_bmc_secure_apply_of_a_present_controller_clock_over_absent_is_refused"),
  ]
{
  if (identity_key.run as NonEmptyStr) != (key.run as NonEmptyStr) || (identity_key.subject as NonEmptyStr) != (key.subject as NonEmptyStr) {
    StepRefused { key: key, cause: BmcSecureIdentityForAnotherInstance { identity: identity_key } }
  } else if (prior_key.run as NonEmptyStr) != (key.run as NonEmptyStr) || (prior_key.subject as NonEmptyStr) != (key.subject as NonEmptyStr) {
    StepRefused { key: key, cause: BmcSecureIdentityForAnotherInstance { identity: prior_key } }
  } else {
    match inspect_bmc_secure_state(subject: identity_subject, goal: inputs.goal, reading: inputs.reading) {
      BmcSecureStateUnobserved { cause: _ } => StepRefused { key: key, cause: BmcSecurePhaseDomainRefused }
      BmcSecureStateInspected { observed: _, assessment: a, decision: d } =>
        match d {
          Noop =>
            match bmc_secure_phase_noop(subject: identity_subject, goal: inputs.goal, reading: inputs.reading) {
              BmcSecurePhaseConverged { receipt: phase } =>
                StepEstablished { receipt: BmcSecureReceipt { receipt: bmc_secure_step_established(key: key, consumed_prior_life: prior_key, phase: phase) } }
              BmcSecurePhaseRefused { cause: _ } => StepRefused { key: key, cause: BmcSecurePhaseDomainRefused }
            }
          Refuse { reason: _ } => StepRefused { key: key, cause: BmcSecurePhaseDomainRefused }
          Apply { plan: _ } =>
            match inputs.apply {
              Absent => StepRefused { key: key, cause: BmcSecureApplyInputsMissing }
              Present { value: ap } =>
                match bmc_secure_application_joins_this_instance(
                  identity_subject: identity_subject,
                  inspected_reading: inputs.reading,
                  requested_goal: inputs.goal,
                  application: ap.application,
                ) {
                  Present { value: c } => StepRefused { key: key, cause: c }
                  Absent =>
                    match discharge_bmc_secure_apply(
                      key: key,
                      identity_subject: identity_subject,
                      inputs: inputs,
                      standing: ap.application.plan.managed_write.route,
                      request: ap.application.plan.managed_write.request,
                    ) {
                      Absent => StepRefused { key: key, cause: BmcSecureAuthorizationUndischarged }
                      Present { value: _ } =>
                        match bmc_secure_phase_applied(application: ap.application, post_read: ap.post_read) {
                          BmcSecurePhaseConverged { receipt: phase } =>
                            StepEstablished { receipt: BmcSecureReceipt { receipt: bmc_secure_step_established(key: key, consumed_prior_life: prior_key, phase: phase) } }
                          BmcSecurePhaseRefused { cause: _ } => StepRefused { key: key, cause: BmcSecurePhaseDomainRefused }
                        }
                    }
                }
            }
        }
    }
  }
}

fn bmc_secure(key: StepInstanceKey, identity: IdentityBoundProvisional, prior: PriorLifeBoundaryEstablished, inputs: BmcSecureInputs) -> StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete> {
  bmc_secure_bound(
    key: key,
    identity_key: identity.key,
    identity_subject: identity.subject,
    prior_key: prior_life_receipt_key(r: prior),
    inputs: inputs,
  )
}

// ── THE PLAN: a prefix of the authority's order, never a second list ───────────────────────────

fn arrival_order_authority() -> ConvergenceOrderAuthority<IntakePhase> {
  ConvergenceOrderAuthority { authority: arrival_order_authority_ref, rank_of: intake_phase_rank }
}

// THE ONE BINDING OF THE ARRIVAL ORDER AS A PLANNING AUTHORITY: gunbc.machine_intake.phase's own
// ranking under its own name. gunbc.fleet.convergence_fold convergence_planning_authority admits this
// function and no other caller in this domain.
fn arrival_planning_authority() -> ConvergencePlanningAuthority<IntakePhase> {
  convergence_planning_authority(order: arrival_order_authority())
}

// The step each arrival phase is realized by in this cut. A phase of the prefix with no step refuses
// the plan; it is never skipped.
fn arrival_step_of_phase(phase: ArrivalPhase) -> ConvergenceStep<IntakePhase>? {
  match phase {
    AccessDiscover => Present { value: ungated_readonly_step(identity: access_discover_step_ref, order_member: Arrival { phase: AccessDiscover }, preconditions: []) }
    IdentityBindProvisional => Present { value: ungated_readonly_step(identity: identity_bind_provisional_step_ref, order_member: Arrival { phase: IdentityBindProvisional }, preconditions: [SameSubject { step: access_discover_step_ref }]) }
    PriorLifeBoundary => Present { value: ungated_readonly_step(identity: prior_life_boundary_step_ref, order_member: Arrival { phase: PriorLifeBoundary }, preconditions: [SameSubject { step: identity_bind_provisional_step_ref }]) }
    BmcSecure => Present { value: ConvergenceStep {
      identity: bmc_secure_step_ref,
      order_member: Arrival { phase: BmcSecure },
      preconditions: [SameSubject { step: prior_life_boundary_step_ref }],
      gate: StepGatedOnAuthorization,
    } }
    BootDeliveryEstablish => none
    DiagnosticBootAttest => none
    InventoryConform => none
    MemoryFastQualify => none
    MemoryAuthoritativeQualify => none
    SubsystemQualify => none
    AcceptanceSoak => none
    ArrivalCleanup => none
  }
}

// THE PREFIX OF arrival_phases_all THROUGH `last`, cut by intake_phase_rank: the authority's own
// members in its own order, none omitted and none added.
fn arrival_prefix_through(last: ArrivalPhase) -> List<IntakePhase> {
  match intake_phase_rank(phase: Arrival { phase: last }) {
    Absent => []
    Present { value: bound } =>
      arrival_phases_all |> filter(p => match intake_phase_rank(phase: p) {
        Present { value: r } => r <= bound
        Absent => false
      })
  }
}

data arrival_prefix_last: ArrivalPhase = PriorLifeBoundary

type ArrivalPrefixSteps
  = ArrivalPrefixStepped { steps: List<ConvergenceStep<IntakePhase>> }
  | ArrivalPrefixPhaseUnstepped { phase: IntakePhase }

fn arrival_prefix_steps(phases: List<IntakePhase>) -> ArrivalPrefixSteps {
  fold(phases, init: ArrivalPrefixStepped { steps: [] }, f: (acc, p) =>
    match acc {
      ArrivalPrefixPhaseUnstepped { phase: q } => ArrivalPrefixPhaseUnstepped { phase: q }
      ArrivalPrefixStepped { steps: ss } =>
        match p {
          Arrival { phase: a } =>
            match arrival_step_of_phase(phase: a) {
              Present { value: s } => ArrivalPrefixStepped { steps: concat(ss, [s]) }
              Absent => ArrivalPrefixPhaseUnstepped { phase: p }
            }
          Provisioning { phase: _ } => ArrivalPrefixPhaseUnstepped { phase: p }
          Placement { phase: _ } => ArrivalPrefixPhaseUnstepped { phase: p }
        }
    })
}

// ── THE RUN ────────────────────────────────────────────────────────────────────────────────────

type ArrivalPrefixVerdict
  = ArrivalPrefixUnstepped { phase: IntakePhase }
  | ArrivalPlanRefused { cause: ConvergencePlanRefusal<IntakePhase> }
  // A forced-change run whose row was NOT admitted: a non-forcing build, or a write admitted for another
  // controller, build, or run. It establishes nothing -- the prior life is not read before the write that
  // was in fact made -- so fleet admission reports the prefix missing. It is a distinct outcome from a
  // refused or incomplete STEP: the divergence itself was not licensed.
  | ArrivalForcedRowNotAdmitted { key: BmcCredentialPolicyKey }
  | ArrivalRunFolded { verdict: ConvergenceRunVerdict<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete> }

// THE PRIOR-LIFE INPUTS: the unit's platform (which selects its policy row) and the dry world the
// archive reads and writes.
type PriorLifeInputs {
  platform: DeclarationRef
  world: DryPriorLifeWorld
}

// The domain executes its steps in the admitted order, each consuming only the receipt its
// precondition produced in this run; a step whose precondition did not establish is not executed and
// the fold records it NotReached. Then the fold composes the outcomes into the run's ledger.
// The prefix ladder, ONCE. `across` is Absent for every ordinary unit; a run that took the
// ForcedFirstRotationPrecedesPriorLife row passes its sealed pre-write capture (item 6), and the
// BmcSecure step then carries the row's build-confirmation precondition. There is no second ladder.
fn arrival_prefix_outcomes(run: ConvergenceRunId, subject: StepSubjectKey, read: CurrentManagerRead, inputs: IdentityBindInputs, prior_life: PriorLifeInputs, across: PriorLifeForcedWriteContext?, locked: InBandRecoveryStanding?) -> List<StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete>> {
  let access = access_discover(key: step_instance_key(run: run, step: access_discover_step_ref, subject: subject), read: read, locked: locked)
  match step_outcome_receipt(outcome: access) {
    Absent => [access]
    Present { value: r } =>
      match r {
        AccessDiscoverReceipt { receipt: a } => {
          let identity = identity_bind_provisional(key: step_instance_key(run: run, step: identity_bind_provisional_step_ref, subject: subject), access: a, inputs: inputs)
          match step_outcome_receipt(outcome: identity) {
            Present { value: ir } =>
              match ir {
                IdentityBindReceipt { receipt: i } =>
                  [access, identity, prior_life_boundary(key: step_instance_key(run: run, step: prior_life_boundary_step_ref, subject: subject), identity: i, platform: prior_life.platform, world: prior_life.world, across: across)]
                AccessDiscoverReceipt { receipt: _ } => [access, identity]
                PriorLifeBoundaryReceipt { receipt: _ } => [access, identity]
                BmcSecureReceipt { receipt: _ } => [access, identity]
              }
            Absent => [access, identity]
          }
        }
        IdentityBindReceipt { receipt: _ } => [access]
        PriorLifeBoundaryReceipt { receipt: _ } => [access]
        BmcSecureReceipt { receipt: _ } => [access]
      }
  }
}

fn arrival_prefix_outcomes_through_bmc_secure(run: ConvergenceRunId, subject: StepSubjectKey, read: CurrentManagerRead, inputs: IdentityBindInputs, prior_life: PriorLifeInputs, bmc: BmcSecureInputs, across: PriorLifeForcedWriteContext?, forced: ForcedFirstRotationPrecedesPriorLife?, locked: InBandRecoveryStanding?) -> List<StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete>> {
  let prefix = arrival_prefix_outcomes(run: run, subject: subject, read: read, inputs: inputs, prior_life: prior_life, across: across, locked: locked)
  match prefix.last() {
    Absent => prefix
    Present { value: last } =>
      match step_outcome_receipt(outcome: last) {
        Absent => prefix
        Present { value: r } =>
          match r {
            PriorLifeBoundaryReceipt { receipt: p } =>
              match prefix |> filter(o => match step_outcome_receipt(outcome: o) { Present { value: ir } => match ir { IdentityBindReceipt { receipt: _ } => true  _ => false }  Absent => false }) |> first() {
                Absent => prefix
                Present { value: id_out } =>
                  match step_outcome_receipt(outcome: id_out) {
                    Absent => prefix
                    Present { value: ir } =>
                      match ir {
                        IdentityBindReceipt { receipt: i } => {
                          let bmc_key = step_instance_key(run: run, step: bmc_secure_step_ref, subject: subject)
                          // THE FORCED BUILD AND THE AUTHENTICATED READ MUST AGREE (item 5), BEFORE BmcSecure runs.
                          // On a forcing build the 403 inferred the firmware (ForcedBuildInferredFromTheResponse) and
                          // the post-write authenticated read is its ONLY confirmation (bmc_rotation_route
                          // forced_first_rotation_apply_frontier). With the row taken, the read's build is joined to
                          // the inferred build as a precondition of the step: a read naming any other build means the
                          // credential was written on a controller that is not the one the 403 came from, and
                          // BmcSecure refuses with its own arm -- never establishing on an unconfirmed inference, and
                          // the refusal is located (both builds named) rather than folded into a domain refusal. This
                          // check is the row's alone; with no row (every ordinary unit) it never runs.
                          let bs = match forced {
                            Absent => bmc_secure(key: bmc_key, identity: i, prior: p, inputs: bmc)
                            Present { value: row } =>
                              if !bmc_firmware_release_identity_eq(a: bmc.reading.firmware, b: row.write.forced.key.firmware) {
                                StepRefused { key: bmc_key, cause: BmcSecureForcedBuildDisagreesWithForcedResponse { inferred: row.write.forced.key.firmware, read: bmc.reading.firmware } }
                              } else {
                                bmc_secure(key: bmc_key, identity: i, prior: p, inputs: bmc)
                              }
                          }
                          concat(prefix, [bs])
                        }
                        AccessDiscoverReceipt { receipt: _ } => prefix
                        PriorLifeBoundaryReceipt { receipt: _ } => prefix
                        BmcSecureReceipt { receipt: _ } => prefix
                      }
                  }
              }
            AccessDiscoverReceipt { receipt: _ } => prefix
            IdentityBindReceipt { receipt: _ } => prefix
            BmcSecureReceipt { receipt: _ } => prefix
          }
      }
  }
}

fn fold_arrival_prefix(steps: List<ConvergenceStep<IntakePhase>>, run: ConvergenceRunId, subject: StepSubjectKey, outcomes: List<StepOutcome<ArrivalStepReceipt, ArrivalStepRefusal, ArrivalStepIncomplete>>, discharges: List<InstanceAuthorization>) -> ArrivalPrefixVerdict {
  match admit_convergence_plan(planning: arrival_planning_authority(), steps: steps) {
    ConvergencePlanRefused { cause: c } => ArrivalPlanRefused { cause: c }
    ConvergencePlanAdmitted { plan: plan } =>
      ArrivalRunFolded { verdict: fold_convergence_run(plan: plan, run: run, subject: subject, outcomes: outcomes, projection: arrival_receipt_projection(), discharges: discharges) }
  }
}

fn converge_arrival_prefix(run: ConvergenceRunId, subject: StepSubjectKey, read: CurrentManagerRead, inputs: IdentityBindInputs, prior_life: PriorLifeInputs, locked: InBandRecoveryStanding?) -> ArrivalPrefixVerdict {
  match arrival_prefix_steps(phases: arrival_prefix_through(last: arrival_prefix_last)) {
    ArrivalPrefixPhaseUnstepped { phase: p } => ArrivalPrefixUnstepped { phase: p }
    ArrivalPrefixStepped { steps: steps } =>
      fold_arrival_prefix(steps: steps, run: run, subject: subject, outcomes: arrival_prefix_outcomes(run: run, subject: subject, read: read, inputs: inputs, prior_life: prior_life, across: none, locked: locked), discharges: [])
  }
}

// Apply mints through discharge_bmc_secure_apply. Noop never requires a fold discharge
// (arrival_receipt_authorization_required is false on BmcSecurePhaseNoop), so a grant
// copied here would be unused.
fn converge_arrival_through_bmc_secure(run: ConvergenceRunId, subject: StepSubjectKey, read: CurrentManagerRead, inputs: IdentityBindInputs, prior_life: PriorLifeInputs, bmc: BmcSecureInputs, locked: InBandRecoveryStanding?) -> ArrivalPrefixVerdict {
  match arrival_prefix_steps(phases: arrival_prefix_through(last: BmcSecure)) {
    ArrivalPrefixPhaseUnstepped { phase: p } => ArrivalPrefixUnstepped { phase: p }
    ArrivalPrefixStepped { steps: steps } => {
      let key = step_instance_key(run: run, step: bmc_secure_step_ref, subject: subject)
      let discharges = match bmc.apply {
        Present { value: ap } =>
          match discharge_bmc_secure_apply(
            key: key,
            identity_subject: bmc.reading.subject,
            inputs: bmc,
            standing: ap.application.plan.managed_write.route,
            request: ap.application.plan.managed_write.request,
          ) {
            Present { value: d } => [d]
            Absent => []
          }
        Absent => []
      }
      fold_arrival_prefix(steps: steps, run: run, subject: subject, outcomes: arrival_prefix_outcomes_through_bmc_secure(run: run, subject: subject, read: read, inputs: inputs, prior_life: prior_life, bmc: bmc, across: none, forced: none, locked: locked), discharges: discharges)
    }
  }
}

// ── mtjade1 ────────────────────────────────────────────────────────────────────────────────────

// The unit keys already bound in this fleet, so a duplicated board serial refuses across units.
fn arrival_bound_unit_keys() -> List<UnitKey> {
  match mtcollins1_unit_key_standing {
    UnitKeyBound { key: k } => [k]
    UnitKeyRefused { cause: _ } => []
  }
}

// mtjade1 FROM ITS COMMITTED EVIDENCE AND NOTHING ELSE (all 2026-10-04, at 192.168.1.246):
// - AccessDiscover: the Redfish Manager capture (firmware 2.11.104000, MegaRAC, candidate route);
// - board serials: the BMC FRU capture (bound to the unit by Board Extra) and the host SMBIOS Type 2
//   capture (bound by an operator-attested SOL session to this controller), which agree
//   (B810301000412080005AJ0C1), so the step mints the two-source agreement and binds the unit key;
// - provisional assembly: from the FRU capture, chassis part number B60.0300E.0001 with the chassis
//   (serial 21000012N0A1) as its one component;
// - live firmware manifest: the bmc entry 2.11.104000 from this run's Manager read, nothing else;
// - PriorLifeBoundary: DRY ONLY. No capture of mtjade1's prior-life carriers is committed, so the
//   archive reads the dry world the caller supplies, under the Mt. Jade policy row, and its receipt
//   names the dry realization; the world claims no controller family.
// WITNESS-ONLY IDENTITY INPUTS (parent decision 2026-10-30). A unit whose board identity has no committed
// capture yet -- srv13 and srv14, the ALTRAD8UD units this lane drives -- can still carry an identity through
// an arrival fold UNDER TEST: the two observations it supplies carry IdentityWitnessSupplied
// (mtjade1_access_observation's witness mints), and this mint is admitted ONLY to
// machine_intake_arrival_converge_witness, so no production arrival can pass identity inputs that did not
// come from the capture readers above. Dissolves with
// mtjade1_access_observation.altrad8ud_identity_readers_frontier.
fn witness_identity_bind_inputs(fru: FruRead, smbios: SmbiosRead, other_units: List<UnitKey>) -> IdentityBindInputs
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "srv13_identity_bind_inputs"),
  ]
{
  IdentityBindInputs { fru: fru, smbios: smbios, other_units: other_units }
}

fn mtjade1_identity_bind_inputs() -> IdentityBindInputs uses fs: std.resources.Filesystem {
  IdentityBindInputs { fru: read_mtjade1_fru(), smbios: read_mtjade1_smbios_type2(), other_units: arrival_bound_unit_keys() }
}

fn converge_mtjade1_arrival_prefix(run: ConvergenceRunId, prior_life: DryPriorLifeWorld) -> ArrivalPrefixVerdict uses fs: std.resources.Filesystem {
  converge_arrival_prefix(
    run: run,
    subject: "mtjade1" as StepSubjectKey,
    read: read_mtjade1_current_manager_read(),
    inputs: mtjade1_identity_bind_inputs(),
    prior_life: PriorLifeInputs { platform: mt_jade_platform_ref, world: prior_life },
    locked: none,
  )
}

fn converge_mtjade1_arrival_through_bmc_secure(run: ConvergenceRunId, prior_life: DryPriorLifeWorld, bmc: BmcSecureInputs) -> ArrivalPrefixVerdict uses fs: std.resources.Filesystem {
  converge_arrival_through_bmc_secure(
    run: run,
    subject: "mtjade1" as StepSubjectKey,
    read: read_mtjade1_current_manager_read(),
    inputs: mtjade1_identity_bind_inputs(),
    prior_life: PriorLifeInputs { platform: mt_jade_platform_ref, world: prior_life },
    bmc: bmc,
    locked: none,
  )
}

// ── THE ONE DECLARED FORCED-CHANGE DIVERGENCE ROW ────────────────────────────────────────────────
//
// (gunbc.machine_intake.phase arrival_phases_all is UNTOUCHED: it stays the order of the ESTABLISHED
// standings for every unit, forced or not. What follows adds NO phase and reorders NO standing. It
// declares the one place an EFFECT may precede a standing, as a §3b divergence ROW, and the admission
// that alone permits it. merry-fox-82 approved this design 2026-10-29; the arrival phase order is
// theirs, so this is not a new order -- it is the single effect placed before PriorLifeBoundary's
// standing, and nothing else may do so.)
//
// THE PREMISE THE ROW RESTS ON is typed as an inference in its own right -- it is about the PRIOR LIFE
// surviving the write, so its home is gunbc.machine_intake.prior_life_boundary
// (ForcedWritePreservesArchiveInference, forced_write_preserves_archive_inference), where the established
// receipt can carry it (§4d: the inference stays typed, and it stays on the fact it qualifies). It is
// imported here for the row's `reason` field below.

// THE DECLARED ROW: the one effect (this run's admitted forced root password write) placed before the
// PriorLifeBoundary standing, together with both admission grounds and its reason. It is a ROW, not a
// branch: the fold's plan and order are the untouched arrival_phases_all; this row is the sole authority
// for the effect's placement, and it is consulted by a named admission, not by an inline test on a build.
type ForcedFirstRotationPrecedesPriorLife sole_constructor {
  row: BmcCredentialPolicyKey
  forced: PublishedCredentialChangeForced
  write: AdmittedForcedFirstRotation
  reason: ForcedWritePreservesArchiveInference
}

// THE UNAUTHENTICATED AccessDiscover VERDICT ON A FORCING BUILD. The service root answered and the one
// authenticated read answered the build's measured 403; that is the run's own forced state. It is NOT
// established -- there is no secured reading to stand on until the admitted forced write is made -- so it
// is a typed pending, and the row admission consumes it. The established AccessDiscover standing for a
// forced unit comes from the authenticated read the forced driver runs AFTER the write. Its executing route
// is the declared frontier forced_change_arrival_route_frontier below (§3c).
type AccessForcedChangePending sole_constructor {
  key: StepInstanceKey
  forced: PublishedCredentialChangeForced
}

fn access_forced_change_pending(key: StepInstanceKey, forced: PublishedCredentialChangeForced) -> AccessForcedChangePending
  admit_callers: [
    // ONE admitted call site in the witness: the helper below the claims builds the pending for the run and
    // subject a claim is folding under, so the claims themselves never mint it.
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "forced_pending_for"),
  ]
{
  AccessForcedChangePending { key: key, forced: forced }
}

// THE EXECUTING ROUTE FOR THE FORCED ARRIVAL, declared (§3c): the CONSUMERS of the pending and the row are
// converge_arrival_forced_through_bmc_secure and admit_forced_first_rotation_precedes_prior_life above, and
// the fold that consults them. What is missing is the PRODUCTION MINT of the pending on the AccessDiscover
// route: minting it needs the unauthenticated service-root read plus the build's measured 403 from the SAME
// run. The authenticated read that follows the write is now available on the faithful surface -- main's
// PR #15370 made gunbc.machine_intake.bmc_secure dry_read_bmc_account_state derive the AccountService census
// from the world's served redfish_accounts, which is what the witness's post-write reading uses -- so what
// remains is the unauthenticated service-root read plus the route that calls this driver, and the producer
// that realizes the admitted forced write (gunbc.machine_intake.bmc_rotation_route
// forced_first_rotation_apply_frontier). The read surface for ASRock ALTRAD8UD 03.22.00 is the one PR #15370
// landed; when the unauthenticated service-root read and the executing route land, the AccessDiscover route
// mints the pending from that run's own 403
// and calls the forced driver, and the witnesses below become the regression pair rather than the only route.
// Until then the forced path is realized only under test.claim.machine_intake.machine_intake_arrival_converge_witness,
// which declares every minter it uses.
data forced_change_arrival_route_frontier: DissolutionCondition = unbound_dissolution(
  description: "dissolves when a production route in gunbc.machine_intake mints AccessForcedChangePending from the run's own unauthenticated service-root read and measured 403 on the AccessDiscover step and calls converge_arrival_forced_through_bmc_secure, with the forced write realized by a producer consuming AdmittedForcedFirstRotation (gunbc.machine_intake.bmc_rotation_route forced_first_rotation_apply_frontier) and the post-write read taken by gunbc.machine_intake.bmc_secure dry_read_bmc_account_state over the world's served redfish_accounts (PR #15370, merged); NOT satisfied by a witness minting the pending itself, nor by a witness calling the write transport directly" as NonEmptyStr,
)

// THE ROW ADMISSION -- THE SINGLE AUTHORITY FOR TAKING THE DIVERGENCE.
//
// Ground (a) -- the controller's credential-policy row for this build says FactoryLoginForcesPasswordChange
// -- is CARRIED BY THE SEALED PublishedCredentialChangeForced and is NOT re-tested here. That state is minted
// only by gunbc.machine_intake.bmc_credential_policy admit_published_credential_change_forced, which mints
// nothing on a build whose row Accepts the factory login, is NotMeasured, or has no row: a non-forcing build
// yields no forced state, so this admission is never reached for it. Re-testing the policy row here would be
// a validation where construction already holds (DESIGN §5), so it is stated, not checked.
//
// Ground (b) -- the forced state was admitted from THIS run's own 403 -- is what this admission checks, and
// it is checked as a JOIN TO THE ACTIVE INSTANCE, not as agreement between supporting records. Two records
// can match each other perfectly and belong to another run or another controller; that is not this run's
// forced state, and it is the class this admission exists to make unwritable. So the admission joins, all
// at once: the pending's step key to THIS run's AccessDiscover instance for THIS subject; the write's
// attempt to the run itself (the fold mints one intake attempt per run, via intake_attempt_of_run); the
// controller the 403 was read from to the controller the route standing was admitted against, the
// controller the BMC account observation was taken from, and the subject this run is converging (access
// read, BMC observation subject and attempt); and the write transition the prior life is read across to
// THIS admission, field by field (bmc_rotation_route admitted_forced_first_rotation_eq). The write travels
// as an AdmittedForcedFirstRotation, which gunbc.machine_intake.bmc_rotation_route admit_forced_first_rotation
// mints only for one controller, one build, one attempt -- but that alone only says the pair is coherent,
// never that it is THIS run's; the joins above supply that.
//
// The reason travels as the typed inference (item 4), not a design_ruling first, and it reaches the
// established prior-life receipt through the context (prior_life_boundary
// PriorLifeBoundaryEstablished.forced_write_inference), so the standing names the premise it rests on.
//
// (rung: pure admission classifier over the run's own records. RED (i) is
// w_a_non_forcing_build_cannot_take_the_forced_first_rotation_row (mtjade1 yields no forced state, so the
// row is not admitted, paired with srv13 taking it); RED (ii) is
// w_a_forced_state_from_another_run_or_controller_cannot_take_the_row; the matching-pair REDs are
// w_a_matching_forced_pair_from_another_run_cannot_take_the_row and
// w_a_matching_forced_pair_for_another_controller_cannot_take_the_row -- in both, the forced state and the
// admitted write agree with each other in every field, and the row is still refused because the pair belongs
// to another run's attempt / another controller. All paired with the positive control
// w_forced_change_unit_sequence_converges_under_the_row, where the forced state, the approval, the arrival
// identity and the readback all describe ONE unit under ONE run.)
fn admit_forced_first_rotation_precedes_prior_life(
  run: ConvergenceRunId,
  subject: StepSubjectKey,
  pending: AccessForcedChangePending,
  read: CurrentManagerRead,
  write: AdmittedForcedFirstRotation,
  transition: ForcedFirstRotationWriteTransition,
  bmc: BmcSecureInputs,
) -> ForcedFirstRotationPrecedesPriorLife? {
  // (1) THE PENDING IS THIS RUN'S. Its key must be this run's AccessDiscover instance for this subject --
  // a pending carrying the right forced state under another run's or another subject's step key is not
  // this run's verdict.
  let pending_is_this_runs = step_instance_key_eq(
    a: pending.key,
    b: step_instance_key(run: run, step: access_discover_step_ref, subject: subject),
  )
  // (2) THE ATTEMPT IS THIS RUN'S. The fold makes one intake attempt per run (intake_attempt_of_run), so the
  // attempt the forced state was read under and the approval granted under must BE the run -- not merely
  // agree with another record about some other run's attempt. That is the matching foreign-run shape.
  let attempt_is_this_runs =
    (write.attempt as String) == (intake_attempt_of_run(run: run) as String)
      && (write.forced.attempt as String) == (write.attempt as String)
  // (3) THE CONTROLLER IS THIS RUN'S, AND IT IS ONE CONTROLLER ACROSS EVERY READING. The chain is: the
  // endpoint the 403 was read from == the endpoint the route standing was admitted against == the endpoint
  // the BMC account observation was taken from == the address the authenticated Manager read this run made
  // was taken at (rendered the way the AccessDiscover step itself renders it, so the join is to the same
  // controller the access standing will name). The identity step then binds that accessed endpoint to the
  // FRU/SMBIOS session it is given (classify_board_serial_agreement refuses a session at another
  // controller), so the identity reading is joined through the access reading rather than beside it. The
  // write's attempt is the account observation's attempt AND the observation's own attempt identity, so a
  // matching pair for another unit cannot borrow this unit's read. (The archive and the account observation
  // are not joined to the identity receipt here: the fold ties them to it by construction, and re-checking
  // them here would be a validation where construction holds, DESIGN §5.) The build confirmation in the
  // ladder below is then confirmation of the SAME controller's inference: a matching pair from another
  // controller (the foreign-controller RED) cannot reach it.
  let access_read_endpoint = match mtjade1_observed_endpoint(network: read.identity.endpoint) {
    Present { value: e } => (e.host as String)
    Absent => ""
  }
  let controller_is_this_runs =
    (write.forced.endpoint.host as String) == (write.standing.endpoint.host as String)
      && (write.standing.endpoint.host as String) == (bmc.reading.endpoint.host as String)
      && (bmc.reading.endpoint.host as String) == access_read_endpoint
      && (write.attempt as String) == (bmc.reading.attempt as String)
      && (write.attempt as String) == (bmc.reading.subject.attempt_id as String)
      && (read.identity.subject as String) == (subject as String)
  // (4) THE WRITE TRANSITION THE PRIOR LIFE IS READ ACROSS IS THIS ADMISSION'S WRITE: the context's leg and
  // its inference name the same admission field by field, so a transition built over a different -- merely
  // agreeing -- admission does not take this row.
  let transition_is_this_write = admitted_forced_first_rotation_eq(a: transition.leg.write, b: write)
  // (5) THE FORCED STATE THE PENDING CARRIES IS THE ONE THE WRITE WAS ADMITTED FROM (as before: one
  // controller, one build, one 403, one evidence digest).
  let forced_state_is_the_writes =
    bmc_credential_policy_key_eq(a: write.forced.key, b: pending.forced.key)
      && (write.forced.endpoint.host as NonEmptyStr) == (pending.forced.endpoint.host as NonEmptyStr)
      && (write.forced.attempt as NonEmptyStr) == (pending.forced.attempt as NonEmptyStr)
      && (write.forced.login as NonEmptyStr) == (pending.forced.login as NonEmptyStr)
      && (write.forced.message_id as NonEmptyStr) == (pending.forced.message_id as NonEmptyStr)
      && content_hash_equal(left: write.forced.response_evidence.digest, right: pending.forced.response_evidence.digest)
  if !(pending_is_this_runs && attempt_is_this_runs && controller_is_this_runs && transition_is_this_write && forced_state_is_the_writes) {
    none
  } else {
    Present {
      value: ForcedFirstRotationPrecedesPriorLife {
        row: pending.forced.key,
        forced: pending.forced,
        write: write,
        reason: forced_write_preserves_archive_inference(
          write: write,
          vendor_row: pending.forced.key,
          vendor_behaviour: FactoryLoginForcesPasswordChange {
            requirement: write.forced.requirement,
            evidence: write.forced.policy_evidence,
          },
        ),
      },
    }
  }
}


// THE FORCED-CHANGE RUN. Entered ONLY with the run's own unauthenticated pending and the admitted forced
// write; the row admission gates it. If the row is not admitted -- a non-forcing build, or a write
// admitted for another controller, build, or run -- the run does NOT take the divergence: it reports the
// row as not admitted and establishes nothing, so fleet admission reports the prefix missing. It is not
// silently routed to the ordinary driver, because the ordinary driver would then read the prior life
// BEFORE the write that was actually made, which is exactly the confusion the row exists to prevent.
//
// (rung: the real fold. Positive control w_forced_change_unit_sequence_converges_under_the_row; RED (iii)
// w_zero_pre_write_entries_take_the_indeterminate_third_outcome_on_the_real_path; RED (iv)
// w_a_post_write_build_that_disagrees_with_the_forced_response_makes_bmc_secure_refuse.)
fn converge_arrival_forced_through_bmc_secure(
  run: ConvergenceRunId,
  subject: StepSubjectKey,
  pending: AccessForcedChangePending,
  read: CurrentManagerRead,
  inputs: IdentityBindInputs,
  prior_life: PriorLifeInputs,
  transition: ForcedFirstRotationWriteTransition,
  bmc: BmcSecureInputs,
  write: AdmittedForcedFirstRotation,
  locked: InBandRecoveryStanding?,
) -> ArrivalPrefixVerdict {
  match admit_forced_first_rotation_precedes_prior_life(run: run, subject: subject, pending: pending, read: read, write: write, transition: transition, bmc: bmc) {
    Absent => ArrivalForcedRowNotAdmitted { key: pending.forced.key }
    Present { value: row } =>
      match arrival_prefix_steps(phases: arrival_prefix_through(last: BmcSecure)) {
        ArrivalPrefixPhaseUnstepped { phase: p } => ArrivalPrefixUnstepped { phase: p }
        ArrivalPrefixStepped { steps: steps } => {
          let key = step_instance_key(run: run, step: bmc_secure_step_ref, subject: subject)
          let discharges = match bmc.apply {
            Present { value: ap } =>
              match discharge_bmc_secure_apply(
                key: key,
                identity_subject: bmc.reading.subject,
                inputs: bmc,
                standing: ap.application.plan.managed_write.route,
                request: ap.application.plan.managed_write.request,
              ) {
                Present { value: d } => [d]
                Absent => []
              }
            Absent => []
          }
          fold_arrival_prefix(
            steps: steps,
            run: run,
            subject: subject,
            outcomes: arrival_prefix_outcomes_through_bmc_secure(run: run, subject: subject, read: read, inputs: inputs, prior_life: prior_life, bmc: bmc, across: Present { value: prior_life_forced_write_context(inference: row.reason, transition: transition) }, forced: Present { value: row }, locked: locked),
            discharges: discharges,
          )
        }
      }
  }
}
