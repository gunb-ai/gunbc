// mtjade1's arrival prefix, from its row. PRIOR LIFE IS DRY FOR EVERY ROWED UNIT until a carrier capture is
// committed: the caller supplies the world and the receipt names the dry realization, under the platform row
// the unit's row selects (gunbc.machine_intake.prior_life_boundary prior_life_policy_rows) -- for srv15 the
// ALTRAD8UD row, which requires all eight carriers and does NOT admit an uncleared boundary. srv15's fold does
// not reach that step: it stops at IdentityBindProvisional, where one in-band reading cannot mint the
// agreement.
fn converge_mtjade1_arrival_prefix(run: ConvergenceRunId, prior_life: DryPriorLifeWorld) -> ArrivalPrefixVerdict uses fs: std.resources.Filesystem {
  converge_arrival_unit_prefix(run: run, row: mtjade1_arrival_capture_row, prior_life: prior_life)
}

// mtjade1's through-BmcSecure variant, same row.
fn converge_mtjade1_arrival_through_bmc_secure(run: ConvergenceRunId, prior_life: DryPriorLifeWorld, bmc: BmcSecureInputs) -> ArrivalPrefixVerdict uses fs: std.resources.Filesystem {
  converge_arrival_unit_through_bmc_secure(run: run, row: mtjade1_arrival_capture_row, prior_life: prior_life, bmc: bmc)
}

fn converge_arrival_unit_through_bmc_secure(run: ConvergenceRunId, row: ArrivalUnitCaptureRow, prior_life: DryPriorLifeWorld, bmc: BmcSecureInputs) -> ArrivalPrefixVerdict uses fs: std.resources.Filesystem {
  converge_arrival_through_bmc_secure(
    run: run,
    subject: row.subject_key,
    read: read_unit_manager_capture(row: row),
    inputs: unit_identity_bind_inputs(row: row),
    prior_life: PriorLifeInputs::DryWorld { platform: row.platform, world: prior_life },
    bmc: bmc,
    locked: none,
  )
}

// THE DOOR'S SEAM INTO THIS AUTHORITY is `altrad8ud_identity_bind_inputs_with_fru` above and
// `identity_fru_slot_of`: a run that observed a unit's FRU in-run mints its slot with the reader in
// gunbc.machine_intake.mtjade1_access_observation (mint_committed_bmc_fru_capture, whose digest gate is keyed by
// the capture row's content digest) and passes the slot to the same inputs mint. No entry here takes a live read
// on the row's behalf: the row's committed Manager capture is not what a live run observed for its AccessDiscover
// reading, so a fold entry that paired a live FRU with a row-literal Manager read would ground the fold in the
// wrong observation. Both functions are consumed in this module, by `altrad8ud_identity_bind_inputs`.

// ── THE ONE DECLARED FORCED-CHANGE DIVERGENCE ROW ────────────────────────────────────────────────
//
// (gunbc.machine_intake.phase arrival_phases_all is UNTOUCHED: it stays the order of the ESTABLISHED
// standings for every unit, forced or not. What follows adds NO phase and reorders NO standing. It
// declares the one place an EFFECT may precede a standing, as a gunbc.design_argument::conformance divergence ROW, and the admission
// that alone permits it. merry-fox-82 approved this design 2026-10-29; the arrival phase order is
// theirs, so this is not a new order -- it is the single effect placed before PriorLifeBoundary's
// standing, and nothing else may do so.)
//
// THE PREMISE THE ROW RESTS ON is typed as an inference in its own right -- it is about the PRIOR LIFE
// surviving the write, so its home is gunbc.machine_intake.prior_life_boundary
// (ForcedWritePreservesArchiveInference, forced_write_preserves_archive_inference), where the established
// receipt can carry it (gunbc.design_argument::epistemic_humility: the inference stays typed, and it stays on the fact it qualifies). It is
// imported here for the row's `reason` field below.

// THE DECLARED ROW: the one effect (this run's admitted forced root password write) placed before the
// PriorLifeBoundary standing, together with both admission grounds and its reason. It is a ROW, not a
// branch: the fold's plan and order are the untouched arrival_phases_all; this row is the sole authority
// for the effect's placement, and it is consulted by a named admission, not by an inline test on a build.
type ForcedFirstRotationPrecedesPriorLife sole_constructor {
  row: BmcCredentialPolicyKey
  forced: PublishedCredentialChangeForced
  write: AdmittedForcedFirstRotation
  reason: ForcedWritePreservesArchiveInference
}

// THE UNAUTHENTICATED AccessDiscover VERDICT ON A FORCING BUILD. The service root answered and the one
// authenticated read answered the build's measured 403; that is the run's own forced state. It is NOT
// established -- there is no secured reading to stand on until the admitted forced write is made -- so it
// is a typed pending, and the row admission consumes it. The established AccessDiscover standing for a
// forced unit comes from the authenticated read the forced driver runs AFTER the write. Its executing route
// is the declared frontier forced_change_arrival_route_frontier below (gunbc.design_argument::consumption).
type AccessForcedChangePending sole_constructor {
  key: StepInstanceKey
  forced: PublishedCredentialChangeForced
}

fn access_forced_change_pending(key: StepInstanceKey, forced: PublishedCredentialChangeForced) -> AccessForcedChangePending
  admit_callers: [
    // ONE admitted call site in the witness: the helper below the claims builds the pending for the run and
    // subject a claim is folding under, so the claims themselves never mint it.
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "forced_pending_for"),
  ]
{
  AccessForcedChangePending { key: key, forced: forced }
}

// THE EXECUTING ROUTE FOR THE FORCED ARRIVAL, declared (gunbc.design_argument::consumption): the CONSUMERS of the pending and the row are
// converge_arrival_forced_through_bmc_secure and admit_forced_first_rotation_precedes_prior_life above, and
// the fold that consults them. What is missing is the PRODUCTION MINT of the pending on the AccessDiscover
// route: minting it needs the unauthenticated service-root read plus the build's measured 403 from the SAME
// run. The authenticated read that follows the write is now available on the faithful surface -- main's
// PR #15370 made gunbc.machine_intake.bmc_secure dry_read_bmc_account_state derive the AccountService census
// from the world's served redfish_accounts, which is what the witness's post-write reading uses -- so what
// remains is the unauthenticated service-root read plus the route that calls this driver, and the producer
// that realizes the admitted forced write (gunbc.machine_intake.bmc_rotation_route
// forced_first_rotation_apply_frontier). The read surface for ASRock ALTRAD8UD 03.22.00 is the one PR #15370
// landed; when the unauthenticated service-root read and the executing route land, the AccessDiscover route
// mints the pending from that run's own 403
// and calls the forced driver, and the witnesses below become the regression pair rather than the only route.
// Until then the forced path is realized only under test.claim.machine_intake.machine_intake_arrival_converge_witness,
// which declares every minter it uses.
data forced_change_arrival_route_frontier: DissolutionCondition = unbound_dissolution(
  description: "dissolves when a production route in gunbc.machine_intake mints AccessForcedChangePending from the run's own unauthenticated service-root read and measured 403 on the AccessDiscover step and calls converge_arrival_forced_through_bmc_secure, with the forced write realized by a producer consuming AdmittedForcedFirstRotation (gunbc.machine_intake.bmc_rotation_route forced_first_rotation_apply_frontier) and the post-write read taken by gunbc.machine_intake.bmc_secure dry_read_bmc_account_state over the world's served redfish_accounts (PR #15370, merged); NOT satisfied by a witness minting the pending itself, nor by a witness calling the write transport directly" as NonEmptyStr,
)

// THE ROW ADMISSION -- THE SINGLE AUTHORITY FOR TAKING THE DIVERGENCE.
//
// Ground (a) -- the controller's credential-policy row for this build says FactoryLoginForcesPasswordChange
// -- is CARRIED BY THE SEALED PublishedCredentialChangeForced and is NOT re-tested here. That state is minted
// only by gunbc.machine_intake.bmc_credential_policy admit_published_credential_change_forced, which mints
// nothing on a build whose row Accepts the factory login, is NotMeasured, or has no row: a non-forcing build
// yields no forced state, so this admission is never reached for it. Re-testing the policy row here would be
// a validation where construction already holds (gunbc.design_argument::fail_closed), so it is stated, not checked.
//
// Ground (b) -- the forced state was admitted from THIS run's own 403 -- is what this admission checks, and
// it is checked as a JOIN TO THE ACTIVE INSTANCE, not as agreement between supporting records. Two records
// can match each other perfectly and belong to another run or another controller; that is not this run's
// forced state, and it is the class this admission exists to make unwritable. So the admission joins, all
// at once: the pending's step key to THIS run's AccessDiscover instance for THIS subject; the write's
// attempt to the run itself (the fold mints one intake attempt per run, via intake_attempt_of_run); the
// controller the 403 was read from to the controller the route standing was admitted against, the
// controller the BMC account observation was taken from, and the subject this run is converging (access
// read, BMC observation subject and attempt); and the write transition the prior life is read across to
// THIS admission, field by field (bmc_rotation_route admitted_forced_first_rotation_eq). The write travels
// as an AdmittedForcedFirstRotation, which gunbc.machine_intake.bmc_rotation_route admit_forced_first_rotation
// mints only for one controller, one build, one attempt -- but that alone only says the pair is coherent,
// never that it is THIS run's; the joins above supply that.
//
// The reason travels as the typed inference (item 4), not a design_ruling first, and it reaches the
// established prior-life receipt through the context (prior_life_boundary
// PriorLifeBoundaryEstablished.forced_write_inference), so the standing names the premise it rests on.
//
// (rung: pure admission classifier over the run's own records. RED (i) is
// w_a_non_forcing_build_cannot_take_the_forced_first_rotation_row (mtjade1 yields no forced state, so the
// row is not admitted, paired with srv13 taking it); RED (ii) is
// w_a_forced_state_from_another_run_or_controller_cannot_take_the_row; the matching-pair REDs are
// w_a_matching_forced_pair_from_another_run_cannot_take_the_row and
// w_a_matching_forced_pair_for_another_controller_cannot_take_the_row -- in both, the forced state and the
// admitted write agree with each other in every field, and the row is still refused because the pair belongs
// to another run's attempt / another controller. All paired with the positive control
// w_forced_change_unit_sequence_converges_under_the_row, where the forced state, the approval, the arrival
// identity and the readback all describe ONE unit under ONE run.)
fn admit_forced_first_rotation_precedes_prior_life(
  run: ConvergenceRunId,
  subject: StepSubjectKey,
  pending: AccessForcedChangePending,
  read: CurrentManagerRead,
  write: AdmittedForcedFirstRotation,
  transition: ForcedFirstRotationWriteTransition,
  bmc: BmcSecureInputs,
) -> ForcedFirstRotationPrecedesPriorLife? {
  // (1) THE PENDING IS THIS RUN'S. Its key must be this run's AccessDiscover instance for this subject --
  // a pending carrying the right forced state under another run's or another subject's step key is not
  // this run's verdict.
  let pending_is_this_runs = step_instance_key_eq(
    a: pending.key,
    b: step_instance_key(run: run, step: access_discover_step_ref, subject: subject),
  )
  // (2) THE ATTEMPT IS THIS RUN'S. The fold makes one intake attempt per run (intake_attempt_of_run), so the
  // attempt the forced state was read under and the approval granted under must BE the run -- not merely
  // agree with another record about some other run's attempt. That is the matching foreign-run shape.
  let attempt_is_this_runs =
    (write.attempt as String) == (intake_attempt_of_run(run: run) as String)
      && (write.forced.attempt as String) == (write.attempt as String)
  // (3) THE CONTROLLER IS THIS RUN'S, AND IT IS ONE CONTROLLER ACROSS EVERY READING. The chain is: the
  // endpoint the 403 was read from == the endpoint the route standing was admitted against == the endpoint
  // the BMC account observation was taken from == the address the authenticated Manager read this run made
  // was taken at (rendered the way the AccessDiscover step itself renders it, so the join is to the same
  // controller the access standing will name). The identity step then binds that accessed endpoint to the
  // FRU/SMBIOS session it is given (classify_board_serial_agreement refuses a session at another
  // controller), so the identity reading is joined through the access reading rather than beside it. The
  // write's attempt is the account observation's attempt AND the observation's own attempt identity, so a
  // matching pair for another unit cannot borrow this unit's read. (The archive and the account observation
  // are not joined to the identity receipt here: the fold ties them to it by construction, and re-checking
  // them here would be a validation where construction holds, gunbc.design_argument::fail_closed.) The build confirmation in the
  // ladder below is then confirmation of the SAME controller's inference: a matching pair from another
  // controller (the foreign-controller RED) cannot reach it.
  let access_read_endpoint = match observed_bmc_network_endpoint(network: read.identity.endpoint) {
    Present { value: e } => (e.host as String)
    Absent => ""
  }
  let controller_is_this_runs =
    (write.forced.endpoint.host as String) == (write.standing.endpoint.host as String)
      && (write.standing.endpoint.host as String) == (bmc.reading.endpoint.host as String)
      && (bmc.reading.endpoint.host as String) == access_read_endpoint
      && (write.attempt as String) == (bmc.reading.attempt as String)
      && (write.attempt as String) == (bmc.reading.subject.attempt_id as String)
      && (read.identity.subject as String) == (subject as String)
  // (4) THE WRITE TRANSITION THE PRIOR LIFE IS READ ACROSS IS THIS ADMISSION'S WRITE: the context's leg and
  // its inference name the same admission field by field, so a transition built over a different -- merely
  // agreeing -- admission does not take this row.
  let transition_is_this_write = admitted_forced_first_rotation_eq(a: transition.leg.write, b: write)
  // (5) THE FORCED STATE THE PENDING CARRIES IS THE ONE THE WRITE WAS ADMITTED FROM (as before: one
  // controller, one build, one 403, one evidence digest).
  let forced_state_is_the_writes =
    bmc_credential_policy_key_eq(a: write.forced.key, b: pending.forced.key)
      && (write.forced.endpoint.host as NonEmptyStr) == (pending.forced.endpoint.host as NonEmptyStr)
      && (write.forced.attempt as NonEmptyStr) == (pending.forced.attempt as NonEmptyStr)
      && (write.forced.login as NonEmptyStr) == (pending.forced.login as NonEmptyStr)
      && (write.forced.message_id as NonEmptyStr) == (pending.forced.message_id as NonEmptyStr)
      && content_hash_equal(left: write.forced.response_evidence.digest, right: pending.forced.response_evidence.digest)
  if !(pending_is_this_runs && attempt_is_this_runs && controller_is_this_runs && transition_is_this_write && forced_state_is_the_writes) {
    none
  } else {
    Present {
      value: ForcedFirstRotationPrecedesPriorLife {
        row: pending.forced.key,
        forced: pending.forced,
        write: write,
        reason: forced_write_preserves_archive_inference(
          write: write,
          vendor_row: pending.forced.key,
          vendor_behaviour: FactoryLoginForcesPasswordChange {
            requirement: write.forced.requirement,
            evidence: write.forced.policy_evidence,
          },
        ),
      },
    }
  }
}


// THE FORCED-CHANGE RUN. Entered ONLY with the run's own unauthenticated pending and the admitted forced
// write; the row admission gates it. If the row is not admitted -- a non-forcing build, or a write
// admitted for another controller, build, or run -- the run does NOT take the divergence: it reports the
// row as not admitted and establishes nothing, so fleet admission reports the prefix missing. It is not
// silently routed to the ordinary driver, because the ordinary driver would then read the prior life
// BEFORE the write that was actually made, which is exactly the confusion the row exists to prevent.
//
// (rung: the real fold. Positive control w_forced_change_unit_sequence_converges_under_the_row; RED (iii)
// w_zero_pre_write_entries_take_the_indeterminate_third_outcome_on_the_real_path; RED (iv)
// w_a_post_write_build_that_disagrees_with_the_forced_response_makes_bmc_secure_refuse.)
fn converge_arrival_forced_through_bmc_secure(
  run: ConvergenceRunId,
  subject: StepSubjectKey,
  pending: AccessForcedChangePending,
  read: CurrentManagerRead,
  inputs: IdentityBindInputs,
  prior_life: PriorLifeInputs,
  transition: ForcedFirstRotationWriteTransition,
  bmc: BmcSecureInputs,
  write: AdmittedForcedFirstRotation,
  locked: InBandRecoveryStanding?,
) -> ArrivalPrefixVerdict {
  match admit_forced_first_rotation_precedes_prior_life(run: run, subject: subject, pending: pending, read: read, write: write, transition: transition, bmc: bmc) {
    Absent => ArrivalForcedRowNotAdmitted { key: pending.forced.key }
    Present { value: row } =>
      match arrival_prefix_steps(phases: arrival_prefix_through(last: BmcSecure)) {
        ArrivalPrefixPhaseUnstepped { phase: p } => ArrivalPrefixUnstepped { phase: p }
        ArrivalPrefixStepped { steps: steps } => {
          let key = step_instance_key(run: run, step: bmc_secure_step_ref, subject: subject)
          let discharges = match bmc.apply {
            Present { value: ap } =>
              match discharge_bmc_secure_apply(
                key: key,
                identity_subject: bmc.reading.subject,
                inputs: bmc,
                standing: ap.application.plan.managed_write.route,
                request: ap.application.plan.managed_write.request,
              ) {
                Present { value: d } => [d]
                Absent => []
              }
            Absent => []
          }
          fold_arrival_prefix(
            steps: steps,
            run: run,
            subject: subject,
            outcomes: arrival_prefix_outcomes_through_bmc_secure(run: run, subject: subject, read: read, inputs: inputs, prior_life: prior_life, bmc: bmc, across: Present { value: prior_life_forced_write_context(inference: row.reason, transition: transition) }, forced: Present { value: row }, locked: locked),
            discharges: discharges,
          )
        }
      }
  }
}
