module gunbc.machine_intake.mtcollins1_census_medium_readback

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.algebra { trim }
import std.dissolution { DissolutionCondition, BoundDissolution, DeclarationRetires }
import std.decl_ref { DeclarationRef, decl_ref }
import std.content_hash { sha256_hex_digest }
import extdeps.tools.gnu_coreutils { cat_command }
import extdeps.exec.command { argv_words }
import gunbc.fleet.fleet_bootstrap_principal { executor_bootstrap_principal }
import gunbc.fleet.fleet_known_hosts_anchor { SshTarget, FleetSshExecutionContext }
import extdeps.ssh.known_hosts { known_hosts_host_field }
import gunbc.fleet.fleet_ssh_locus { prepare_fleet_ssh_agent_context, FleetSshContextReady, FleetSshContextRefused }
import gunbc.typed_argv_exec { TypedArgvExecOutcome, typed_argv_exec_over_fleet_ssh, TypedArgvExecConverged, TypedArgvExecRefused }
import gunbc.host.boot_medium_served_readback { RemoteAnswer, remote_answer_of, boot_medium_served_path, boot_medium_served_argv, boot_medium_served_join, BootMediumServedHeld, BootMediumServedUnreadable, BootMediumServedMeasureMalformed, BootMediumServedDiverged }
import gunbc.host.boot_medium { BootImageExport, BootMedium, bmc_boot_image_export }
import gunbc.machine_intake.mtcollins1_census_image { CensusMediumQualification, CensusMediumQualified, CensusMediumNotCensus, CensusMediumExporterUnsupported, census_medium_qualification, boot_image_export_text, mtcollins1_census_image, CensusImage, CensusImageDerived, CensusImageRefused }
import extdeps.provisioning.ubuntu_seeded_install_media { UbuntuSeededInstallMediaBuildInput, ubuntu_seeded_install_media_record_path, seeded_install_media_build_key }

// THE PUBLICATION RECEIPT IS NOT BOOT-TIME EVIDENCE. The medium row carries the digest the publish
// measured; between that run and this boot the file the BMC will mount over NFS could have been
// replaced, truncated or removed, and the derivation record beside it could name other bytes. So the
// boot re-derives the same chain mtcollins1_census_image_resolve does, on the host that serves the
// export: current census build input -> build key -> derivation record -> recorded digest ->
// digest-derived image name -> re-measured file bytes, and it mints the signed subject only when
// every link agrees with the medium row. The joins are pure folds over what the two remote commands
// answered, so the witness supplies the answers; the fleet-SSH legs below are the one producer.
type CensusMediumReadback
  = CensusMediumReadbackAgreed {
      host: NonEmptyStr,
      build_key: NonEmptyStr,
      recorded_digest: NonEmptyStr,
      image_name: NonEmptyStr,
      served_path: NonEmptyStr,
      measured_digest: NonEmptyStr,
    }
  | CensusMediumReadbackRecordUnreadable { host: NonEmptyStr, record_path: NonEmptyStr, reason: String }
  | CensusMediumReadbackRecordMalformed { record_path: NonEmptyStr, content: String }
  | CensusMediumReadbackRecordDisagrees { record_path: NonEmptyStr, recorded: NonEmptyStr, selected: NonEmptyStr }
  | CensusMediumReadbackImageUnreadable { host: NonEmptyStr, served_path: NonEmptyStr, reason: String }
  | CensusMediumReadbackMeasureMalformed { served_path: NonEmptyStr, content: String }
  | CensusMediumReadbackDiverged { served_path: NonEmptyStr, recorded: NonEmptyStr, measured: NonEmptyStr }
  | CensusMediumReadbackNotCensus
  | CensusMediumReadbackExporterUnsupported { supported: BootImageExport, named: BootImageExport }
  | CensusMediumReadbackInputUnderived { reason: String }

fn census_record_path(input: UbuntuSeededInstallMediaBuildInput) -> NonEmptyStr {
  ubuntu_seeded_install_media_record_path(dir: bmc_boot_image_export.dir, input: input)
}

fn census_build_key(input: UbuntuSeededInstallMediaBuildInput) -> NonEmptyStr {
  seeded_install_media_build_key(input: input)
}

fn census_record_argv(record_path: NonEmptyStr) -> List<String> {
  argv_words(command: cat_command(path: record_path as String))
}

// The derivation record IS one digest: resolve_seeded_image trims the whole file and consumes it,
// so this reader does the same -- a trailing token is a malformed record, never an admitted one.
// std.content_hash.sha256_hex_digest is the one admission (exact length AND lowercase hex syntax).
fn record_digest(text: String) -> String? {
  match sha256_hex_digest(hex: trim(s: text)) {
    Absent => none
    Present { value: d } => Present { value: d.hex as String }
  }
}

// STAGE ONE: the record alone. Its signature carries no measurement, which is what makes "an
// unreadable record refuses before the file is consulted" a fact about the producer's route and not
// only about a fold: the producer runs sha256sum only inside the admitted arm.
type CensusRecordStanding
  = CensusRecordAdmitted { recorded: NonEmptyStr }
  | CensusRecordRefused { readback: CensusMediumReadback }

fn census_record_standing(medium: BootMedium, host: NonEmptyStr, input: UbuntuSeededInstallMediaBuildInput, record: RemoteAnswer) -> CensusRecordStanding {
  match census_medium_qualification(image_stem: input.image_stem, volume_id: input.volume_id, medium: medium) {
    CensusMediumNotCensus => CensusRecordRefused { readback: CensusMediumReadbackNotCensus }
    CensusMediumExporterUnsupported { supported: sup, named: n } => CensusRecordRefused { readback: CensusMediumReadbackExporterUnsupported { supported: sup, named: n } }
    CensusMediumQualified { digest: selected, export: _ } => {
      let record_path = census_record_path(input: input)
      if record.exit_code != 0 {
        CensusRecordRefused { readback: CensusMediumReadbackRecordUnreadable { host: host, record_path: record_path, reason: concat("exit=", to_string(record.exit_code), " ", trim(s: record.stderr)) } }
      } else {
        match record_digest(text: record.stdout) {
          Absent => CensusRecordRefused { readback: CensusMediumReadbackRecordMalformed { record_path: record_path, content: trim(s: record.stdout) } }
          Present { value: recorded } =>
            if recorded != (selected as String) {
              CensusRecordRefused { readback: CensusMediumReadbackRecordDisagrees { record_path: record_path, recorded: recorded as NonEmptyStr, selected: selected } }
            } else {
              CensusRecordAdmitted { recorded: recorded as NonEmptyStr }
            }
        }
      }
    }
  }
}

// STAGE TWO: the measurement, joined with an already-admitted record. The record was admitted only
// when it equals the medium's digest, so the served bytes are judged by the one readback rule every
// boot medium is judged by (gunbc.host.boot_medium boot_medium_readback).
fn census_measure_join(
  medium: BootMedium,
  input: UbuntuSeededInstallMediaBuildInput,
  host: NonEmptyStr,
  recorded: NonEmptyStr,
  measure: RemoteAnswer,
) -> CensusMediumReadback {
  match boot_medium_served_join(medium: medium, host: host, measure: measure) {
    BootMediumServedHeld { host: h, image_name: n, served_path: sp, measured_digest: m } => CensusMediumReadbackAgreed {
      host: h,
      build_key: census_build_key(input: input),
      recorded_digest: recorded,
      image_name: n,
      served_path: sp,
      measured_digest: m,
    }
    BootMediumServedUnreadable { host: h, served_path: sp, reason: why } => CensusMediumReadbackImageUnreadable { host: h, served_path: sp, reason: why }
    BootMediumServedMeasureMalformed { served_path: sp, content: c } => CensusMediumReadbackMeasureMalformed { served_path: sp, content: c }
    BootMediumServedDiverged { served_path: sp, expected: _, measured: m } => CensusMediumReadbackDiverged { served_path: sp, recorded: recorded, measured: m }
  }
}

// The two stages composed over supplied answers -- the witness's subject. The chain starts from the
// current census build input; a derivation the YAML writer refused has no build key and so no record
// to read, and that is refused before either leg.
fn census_medium_readback_from_answers(
  medium: BootMedium,
  host: NonEmptyStr,
  image: CensusImage,
  record: RemoteAnswer,
  measure: RemoteAnswer,
) -> CensusMediumReadback {
  match image {
    CensusImageRefused { reason: r } => CensusMediumReadbackInputUnderived { reason: r }
    CensusImageDerived { input: input } =>
      match census_record_standing(medium: medium, host: host, input: input, record: record) {
        CensusRecordRefused { readback: r } => r
        CensusRecordAdmitted { recorded: recorded } => census_measure_join(medium: medium, input: input, host: host, recorded: recorded, measure: measure)
      }
  }
}

// STAGE-NEUTRAL CAUSE. The SUBJECT'S label is a parameter, never a spelling baked into the text:
// a refusal produced for another subject must blame that subject, not one specific machine. The
// EXECUTOR host is NOT a parameter here -- it is stored in the readback receipt by the producer
// (the host it ran on), so the text names the host that actually took the leg, one fact, not two
// inputs a caller can cross (DESIGN 3 -- a materially different contract needs a materially
// different name; DESIGN 5 -- no fabricated output, so the receipt names the host that read it).
// What the boot has and has not touched differs between the two call sites, so the sentence about
// that is the caller's wrapper below, never this renderer's.
fn census_readback_refusal(subject: NonEmptyStr, readback: CensusMediumReadback) -> String? {
  match readback {
    CensusMediumReadbackAgreed { host: _, build_key: _, recorded_digest: _, image_name: _, served_path: _, measured_digest: _ } => none
    CensusMediumReadbackNotCensus => Present { value: concat(subject as String, " boot: the medium is not the census image, so there is no served digest to read back") }
    CensusMediumReadbackExporterUnsupported { supported: sup, named: n } =>
      Present { value: concat(subject as String, " boot: the census medium names the exporter ", boot_image_export_text(export: n), " but the census is published to and read back from ", boot_image_export_text(export: sup), "; refusing rather than reading back bytes the medium does not name") }
    CensusMediumReadbackRecordUnreadable { host: h, record_path: p, reason: why } =>
      Present { value: concat(subject as String, " boot: the census derivation record ", p as String, " could not be read on ", h as String, " (", why, "); refusing rather than trusting the publication receipt") }
    CensusMediumReadbackRecordMalformed { record_path: p, content: c } =>
      Present { value: concat(subject as String, " boot: the census derivation record ", p as String, " is not exactly one sha256 digest (", c, "); refusing") }
    CensusMediumReadbackRecordDisagrees { record_path: p, recorded: r, selected: sel } =>
      Present { value: concat(subject as String, " boot: the census derivation record ", p as String, " names ", r as String, " but the medium row selects ", sel as String, "; the row does not describe the current derivation") }
    CensusMediumReadbackImageUnreadable { host: h, served_path: p, reason: why } =>
      Present { value: concat(subject as String, " boot: the served census image ", p as String, " could not be re-measured on ", h as String, " (", why, "); refusing rather than trusting the publication receipt") }
    CensusMediumReadbackMeasureMalformed { served_path: p, content: c } =>
      Present { value: concat(subject as String, " boot: sha256sum over ", p as String, " answered no sha256 digest (", c, "); refusing") }
    CensusMediumReadbackDiverged { served_path: p, recorded: r, measured: m } =>
      Present { value: concat(subject as String, " boot: the served census image ", p as String, " reads ", m as String, " but its derivation record and the medium row say ", r as String, "; refusing to mint a subject over bytes the row does not describe") }
    CensusMediumReadbackInputUnderived { reason: why } =>
      Present { value: concat(subject as String, " boot: the census build input has no derivation (", why, "), so there is no build key to find a record by; refusing") }
  }
}

// Before the approval request is filed nothing has been claimed: the controller is untouched.
fn census_readback_refusal_before_filing(subject: NonEmptyStr, readback: CensusMediumReadback) -> String? {
  match census_readback_refusal(subject: subject, readback: readback) {
    Absent => none
    Present { value: why } => Present { value: concat(why, " -- controller untouched") }
  }
}

// After the grant the boot has claimed the capability and acquired the SOL session; only the
// media attach, boot selection and power are still untouched, and the SOL session follows the
// existing settle/release path.
fn census_readback_refusal_before_attach(subject: NonEmptyStr, readback: CensusMediumReadback) -> String? {
  match census_readback_refusal(subject: subject, readback: readback) {
    Absent => none
    Present { value: why } => Present { value: concat("after grant, before attach: ", why, " -- media attach, boot selection and power untouched; the SOL session had been acquired and follows the settle/release path") }
  }
}

data mtcollins1_census_readback_attempt_raw: String = "mtcollins1-census-readback"

// THE ONE PRODUCER: two read-only legs on the qualified medium's own exporter (its SSH target,
// never a substituted one), IN ORDER -- cat the derivation record, and only once it is admitted
// sha256sum the multi-gigabyte served image. A refused leg is unreadable, never diverged: the bytes
// were never read. The argv of each leg is the coreutils / crypto authority's own command projected
// through argv_words, not a local spelling.
//
// THE MEDIUM AND THE IMAGE ARE EXPLICIT PARAMETERS. The medium's own exporter target is the executor
// host the readback reads from, and the image supplies the build input the record path and build key
// are derived from. The host the receipt names is DERIVED from that target's address
// (known_hosts_host_field), not a free parameter the caller can cross -- the receipt cannot name a
// host the leg did not run on. The qualification checks that the medium and the image agree on
// artifact identity (the stem and the volume label); a mismatched binding -- a medium that names a
// stem or volume different from the image it is read back for -- is refused as not the census before
// either leg runs, which is control (b).
fn census_medium_readback(
  medium: BootMedium,
  image: CensusImage,
  attempt: NonEmptyStr,
) -> CensusMediumReadback
{
  match image {
    CensusImageRefused { reason: r } => CensusMediumReadbackInputUnderived { reason: r }
    CensusImageDerived { input: input } =>
      match census_medium_qualification(image_stem: input.image_stem, volume_id: input.volume_id, medium: medium) {
        CensusMediumNotCensus => CensusMediumReadbackNotCensus
        CensusMediumExporterUnsupported { supported: sup, named: n } => CensusMediumReadbackExporterUnsupported { supported: sup, named: n }
        CensusMediumQualified { digest: _, export: export } =>
          match prepare_fleet_ssh_agent_context(attempt_raw: attempt) {
            FleetSshContextRefused { cause: c } =>
              CensusMediumReadbackRecordUnreadable { host: known_hosts_host_field(address: export.target.address) as NonEmptyStr, record_path: census_record_path(input: input), reason: c }
            FleetSshContextReady { context: context, receipt: _ } => {
              let target = export.target
              let host = known_hosts_host_field(address: target.address) as NonEmptyStr
              let record = remote_answer_of(outcome: typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: census_record_argv(record_path: census_record_path(input: input))))
              match census_record_standing(medium: medium, host: host, input: input, record: record) {
                CensusRecordRefused { readback: r } => r
                CensusRecordAdmitted { recorded: recorded } => {
                  let measure = remote_answer_of(outcome: typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: boot_medium_served_argv(path: boot_medium_served_path(medium: medium))))
                  census_measure_join(medium: medium, input: input, host: host, recorded: recorded, measure: measure)
                }
              }
            }
          }
      }
  }
}

// THIS READBACK HAS NO PRODUCTION CONSUMER (gunb-ai/gunbc#14912). The mtcollins1 boot run re-measures
// its medium through gunbc.host.boot_medium_served_readback, and no boot path selects the census
// medium today; only this module's witness and the acceptance matrix's census_record_path reach it.
// census_readback_refusal_before_filing / _before_attach duplicate the generic wrappers. The residue is
// bounded to this module and dissolves when census_medium_readback retires: its census-specific checks
// (census_record_standing, the census qualification refusal) fold onto the generic readback for a
// census-member boot, and the duplicated wrappers are deleted.
data census_medium_readback_unconsumed_frontier: DissolutionCondition = BoundDissolution {
  trigger: DeclarationRetires { ref: census_medium_readback_ref() },
}
fn census_medium_readback_ref() -> DeclarationRef {
  decl_ref(module_path: "gunbc.machine_intake.mtcollins1_census_medium_readback", decl_name: "census_medium_readback")
}
