// THE CURSOR A COLLECTOR WOULD HAVE RECORDED BEFORE THE FIRST POST-CHANGE BOOT: 0x3ee, the
// "Power off/down" that ended the last 16-DIMM boot. Everything after it is the 32-DIMM
// population.
data mtcollins1_sel_cursor_before_32dimm: Int = 1006

// THE CURSOR BEFORE THE LAST 16-DIMM BOOT, for the positive control: record 0x3e9.
data mtcollins1_sel_cursor_before_last_16dimm_boot: Int = 1001

// ── the OEM record, three facts kept apart ─────────────────────────────────────────────────────

data mtcollins1_oem_payload_since_change: OemSelPayload = OemSelPayload {
  manufacturer_id_rendering: "00cd3a",
  oem_bytes_rendering: "0fde70330102",
}

// THE PAIR THAT SITS BESIDE EVERY BOOT THAT COMPLETED in the full SEL -- twenty-two boots between
// 09/07 and 09/10 carry it, always immediately after a firmware-progress record -- and that has
// not appeared once since the DIMM change. Also OEM, also undecoded; recorded as the co-occurrence
// candidates the association fold checks, not as a decode of either.
data mtcollins1_oem_pair_beside_completed_boots: List<OemSelPayload> = [
  OemSelPayload { manufacturer_id_rendering: "00cd3a", oem_bytes_rendering: "12c805000000" },
  OemSelPayload { manufacturer_id_rendering: "00cd3a", oem_bytes_rendering: "12c805004000" },
]

// WHAT THE CONTROLLER'S WEB EVENT LOG SAID, read from 40-weblog.json. Every one of the 500 records
// it serves renders advanced_event_description as "unknown" -- the standard ones too -- and every
// OEM record's sel_data is EMPTY, so the web surface neither decodes the payload nor even carries
// its bytes. That is a weaker fact than "the controller looked at 0fde70330102 and declined": the
// surface offers no OEM decode at all. It is recorded at that weaker strength, and the capability
// profile's OemDecodeControllerDeclaredUnknown is the arm it supports.
type WebEventLogDecodeObservation {
  artifact_path: NonEmptyStr
  digest: ContentHash
  records_served: Int
  oem_records_served: Int
  advanced_event_description_uniformly: NonEmptyStr
  oem_sel_data_empty: Bool
}

data mtcollins1_web_event_log_decode: WebEventLogDecodeObservation = WebEventLogDecodeObservation {
  artifact_path: "artifacts/bmc/mtcollins1-32dimm/40-weblog.json",
  digest: Sha256Hash(Sha256Digest { hex: "f0b466275a9edd5d6736e940ed776a446a415893ce2278c26a045cdc584516a8" }),
  records_served: 500,
  oem_records_served: 67,
  advanced_event_description_uniformly: "unknown",
  oem_sel_data_empty: true,
}

// ── the capability profile, as measured today ──────────────────────────────────────────────────

// SOL present but silent (four identical captures plus the keystroke probe); raw SEL and standard
// decode yes (50-sel-final.txt renders every standard sensor event); OEM decode no
// (mtcollins1_web_event_log_decode); web event log yes (it answered 500 records); per-DIMM
// localization no (the SEL carries no slot-addressed record and the census module already
// established that EDAC under firmware-first exposes no channel topology); aggregate memory power
// yes (CPU0/CPU1 DIMM VRD temperatures and VDDQ rails in 06-sdr.txt); managed AC no (the AC cycle
// was performed by hand, 10-ac-meta.txt); host callback intended, not demonstrated.
data mtcollins1_pre_os_capabilities: PreOsObservationCapabilities = PreOsObservationCapabilities {
  baseboard: AmpereMtCollins,
  controller_firmware: mtcollins1_firmware,
  console: SolPresentSilent,
  sel: SelStandardDecoded,
  oem_sel_decode: OemDecodeControllerDeclaredUnknown,
  web_event_log: WebEventLogAvailable,
  dimm_localization: LocalizationUnavailableFromExposedTelemetry,
  memory_power: AggregateMemoryPowerExposed,
  managed_ac: NoManagedAcActuator,
  host_callback: HostCallbackIntendedNotDemonstrated,
}

// ── the controller clock ───────────────────────────────────────────────────────────────────────

// JOINED, NOT ASSUMED. SEL record 0x424 "Power Unit ChassisPwrStatus | AC lost" is stamped
// 09/11/2026 06:13:51 PM by the controller; the observer's watcher (10-ac-meta.txt) logged the
// controller unreachable at 2026-09-11T22:13:43.167Z. The two describe one AC removal, so the
// controller's clock reads about 3h59m52s behind UTC. Any join of SEL time to observer time goes
// through this row.
type BmcClockSkewObservation {
  sel_record_id: Int
  sel_clock_rendering: NonEmptyStr
  observer_instant: EpochMs
  observer_artifact_path: NonEmptyStr
  controller_behind_observer_by: Second
}

data mtcollins1_bmc_clock_skew: BmcClockSkewObservation = BmcClockSkewObservation {
  sel_record_id: 1060,
  sel_clock_rendering: "09/11/2026 06:13:51 PM UTC",
  observer_instant: 1789164823167,
  observer_artifact_path: "artifacts/bmc/mtcollins1-32dimm/10-ac-meta.txt",
  controller_behind_observer_by: second(count: 14392),
}

// ── the collectors-before-actuation receipt, as a readiness fixture ────────────────────────────

// WHAT THE OBSERVER'S OWN INSTRUMENTS LOOKED LIKE WHEN THE AC CYCLE WAS PERFORMED, reconstructed
// from 10-ac-meta.txt and operator-scripts.txt. The liveness watcher was armed at 22:13:23.054Z
// and its FIRST probe found the controller unreachable ("BMC down (ipmi no answer) after 1s",
// logged twenty seconds later because that first `mc info` hung until timeout): it never observed
// the controller reachable, so the down it reported was a state it was born into, not a
// transition it witnessed. The console session had two stale capture processes competing for it,
// which is why every later script begins by killing every `sol activate` before attaching.
//
// Fed to collectors_ready, this fixture must REFUSE; the readiness a correct run would have
// presented is beside it and must be admitted. Both are exercised by the probe below.
data mtcollins1_ac_cycle_attempt: AttemptIdentity = "mtcollins1-32dimm-ac-cycle-2026-09-11T22:13Z" as AttemptIdentity

data mtcollins1_console_lease_epoch: LeaseEpoch = LeaseEpoch {
  lease_key: "ipmi-sol:192.168.1.228",
  resource_fingerprint: Sha256Hash(Sha256Digest { hex: "3aea4368b8745ae7bdca3c7ec052a324032974f7b849bca460e7d0e14f5e0871" }),
  owner_fingerprint: Sha256Hash(Sha256Digest { hex: "e3c4d19c11446f35179b90e61f9396652caf155216ef87915bfcf22452e2efe0" }),
  generation: 1,
}

data mtcollins1_ac_cycle_collectors_as_run: List<CollectorStanding> = [
  CollectorProvenRunning { kind: ConsoleCapture, proof: ConsoleSessionBannerSeen { capture_path: "11-ac-sol.log", banner_bytes: byte_size(count: 86) } },
  CollectorProvenRunning { kind: SelCursorTail, proof: SelCursorRecorded { last_record_id: 1059, recorded_at: 1789164803054 } },
  CollectorArmedUnproven { kind: ControllerLivenessWatch },
]

data mtcollins1_ac_cycle_collectors_as_required: List<CollectorStanding> = [
  CollectorProvenRunning { kind: ConsoleCapture, proof: ConsoleSessionBannerSeen { capture_path: "11-ac-sol.log", banner_bytes: byte_size(count: 86) } },
  CollectorProvenRunning { kind: SelCursorTail, proof: SelCursorRecorded { last_record_id: 1059, recorded_at: 1789164803054 } },
  CollectorProvenRunning { kind: ControllerLivenessWatch, proof: ControllerObservedReachable { at: 1789164310688 } },
]

fn mtcollins1_ac_cycle_readiness_as_run() -> CollectorsReadiness {
  collectors_ready(
    attempt: mtcollins1_ac_cycle_attempt,
    sink: EvidenceSinkPresent { directory: mtcollins1_32dimm_artifact_dir },
    console_lease: held_lease(epoch: mtcollins1_console_lease_epoch, observed: LeaseRunningStale),
    collectors: mtcollins1_ac_cycle_collectors_as_run,
  )
}

fn mtcollins1_ac_cycle_readiness_as_required() -> CollectorsReadiness {
  collectors_ready(
    attempt: mtcollins1_ac_cycle_attempt,
    sink: EvidenceSinkPresent { directory: mtcollins1_32dimm_artifact_dir },
    console_lease: held_lease(epoch: mtcollins1_console_lease_epoch, observed: LeaseRunningExpected),
    collectors: mtcollins1_ac_cycle_collectors_as_required,
  )
}

// ── the folds over the corpus ──────────────────────────────────────────────────────────────────

fn mtcollins1_32dimm_verdict() -> PreOsBringupVerdict {
  pre_os_bringup_verdict(
    window: sel_window_after_cursor(window: mtcollins1_sel_window, cursor_record_id: mtcollins1_sel_cursor_before_32dimm),
    console: mtcollins1_sol_reading(capture: mtcollins1_sol_idle_capture),
    profile: mtcollins1_pre_os_capabilities,
  )
}

fn mtcollins1_last_16dimm_verdict() -> PreOsBringupVerdict {
  pre_os_bringup_verdict(
    window: filter(
      xs: sel_window_after_cursor(window: mtcollins1_sel_window, cursor_record_id: mtcollins1_sel_cursor_before_last_16dimm_boot),
      f: e => e.record_id <= mtcollins1_sel_cursor_before_32dimm,
    ),
    console: mtcollins1_sol_reading(capture: mtcollins1_sol_idle_capture),
    profile: mtcollins1_pre_os_capabilities,
  )
}

fn mtcollins1_oem_association() -> OemSelEmpiricalAssociation {
  oem_sel_empirical_association(
    window: mtcollins1_sel_window,
    payload: mtcollins1_oem_payload_since_change,
    never_beside_candidates: mtcollins1_oem_pair_beside_completed_boots,
    profile: mtcollins1_pre_os_capabilities,
  )
}

// ── the probe: the three laws, executed over these bytes ───────────────────────────────────────

// EACH LAW IS ONE PURE CHECK RETURNING ITS OWN LOCATED FAILURE, and the probe is the fold that
// reports the first. The checks are separate declarations so a witness can run one law without
// the others and a red names the law rather than the probe.

fn sol_readings_all_banner_only(captures: List<SolCaptureUnderCondition>) -> Bool {
  all(captures, c => match mtcollins1_sol_reading(capture: c) {
    SolBannerOnly { capture_path: _, bytes: _ } => true
    SolHostBytesObserved { capture_path: _, bytes: _ } => false
    SolCaptureUnreadable { capture_path: _ } => false
  })
}

// LAW 1: the readiness as run refuses on the stale console lease; the readiness a correct run
// would present admits, and an AC cycle minted from it is a human-attended barrier that keeps the
// attempt identity.
fn check_collectors_before_actuation() -> ProcessExit {
  let as_run = match mtcollins1_ac_cycle_readiness_as_run() {
    Ready { ready: _ } =>
      exit_failure(reason: "collectors-before-actuation: the readiness reconstructed from 10-ac-meta.txt was ADMITTED, but its console lease was stale and its liveness watcher never saw the controller up")
    NotReady { gap: g } =>
      match g {
        ConsoleLeaseNotHeld { observed: _ } => ExitSuccess
        _ => exit_failure(reason: "collectors-before-actuation: refused, but not on the stale console lease, which is the first gap the fixture presents")
      }
  }
  let as_required = match mtcollins1_ac_cycle_readiness_as_required() {
    NotReady { gap: _ } =>
      exit_failure(reason: "collectors-before-actuation: the readiness a correct run would present was REFUSED, so the fold cannot distinguish the failed run from a correct one")
    Ready { ready: r } =>
      match power_actuation_request(ready: r, kind: AcPowerCycle) {
        ActuatorRequest { ready: _, kind: _, realization: _ } =>
          exit_failure(reason: "collectors-before-actuation: an AC cycle was rendered as an actuator request, but this fleet has no managed AC actuator")
        HumanAttendedRequest { ready: rr, kind: _, barrier: _ } =>
          if power_actuation_request_readiness(request: power_actuation_request(ready: rr, kind: HostWarmReset)).attempt == mtcollins1_ac_cycle_attempt {
            ExitSuccess
          } else {
            exit_failure(reason: "collectors-before-actuation: the request lost the attempt identity of the readiness it was minted from")
          }
      }
  }
  first_failure(checks: [as_run, as_required])
}

// LAW 2: four byte-identical captures across four conditions all read as banner-only, and the
// verdict over an empty post-cursor window beside them is UNDETERMINED, never a failure.
fn check_console_silence_is_not_a_terminal() -> ProcessExit {
  let readings = if sol_readings_all_banner_only(captures: mtcollins1_sol_captures) {
    ExitSuccess
  } else {
    exit_failure(reason: "console-silence: a capture whose digest equals the session banner was read as host bytes")
  }
  let verdict = match pre_os_bringup_verdict(
    window: sel_window_after_cursor(window: mtcollins1_sel_window, cursor_record_id: 1103),
    console: mtcollins1_sol_reading(capture: mtcollins1_sol_idle_capture),
    profile: mtcollins1_pre_os_capabilities,
  ) {
    BringupUndetermined { cause: c } =>
      match c {
        ConsoleSilentAndWindowEmpty => ExitSuccess
        _ => exit_failure(reason: "console-silence: a silent console beside an empty window was not named as such")
      }
    _ => exit_failure(reason: "console-silence: a banner-only capture beside an empty SEL window produced a verdict about the host")
  }
  first_failure(checks: [readings, verdict])
}

// THE BOUNDED TERMINAL: the 32-DIMM window is a stable restart-before-progress terminal, refused
// with no localization and permitting no further actuation; the last 16-DIMM boot is the positive
// control that shows the terminal arm discriminates.
fn check_bounded_terminal() -> ProcessExit {
  let terminal = match mtcollins1_32dimm_verdict() {
    PhysicalRemediationRequired { restarts_without_progress: n, localization: l } =>
      match l {
        UnavailableFromExposedTelemetry =>
          if n < 3 {
            exit_failure(reason: "bounded-terminal: fewer restarts than the threshold were reported for a window of twenty")
          } else {
            ExitSuccess
          }
        _ => exit_failure(reason: "bounded-terminal: a localization was minted on a platform that exposes no per-slot telemetry")
      }
    _ => exit_failure(reason: "bounded-terminal: the 32-DIMM window -- twenty restarts, zero firmware-progress records -- did not resolve to PhysicalRemediationRequired")
  }
  let bounded = if verdict_permits_further_actuation(verdict: mtcollins1_32dimm_verdict()) {
    exit_failure(reason: "bounded-terminal: a stable terminal still permitted further actuation")
  } else {
    ExitSuccess
  }
  let control = match mtcollins1_last_16dimm_verdict() {
    FirmwareProgressObserved { cycles_with_progress: _, cycles_without_progress: _ } => ExitSuccess
    _ => exit_failure(reason: "positive control: the last completing 16-DIMM boot (0x3ea..0x3ee) was not read as firmware progress, so the terminal arm is not discriminating")
  }
  first_failure(checks: [terminal, bounded, control])
}

// LAW 3: the OEM association counts, dates and co-occurs -- and does not decode.
fn check_opaque_oem_stays_opaque() -> ProcessExit {
  let assoc = mtcollins1_oem_association()
  let count = if assoc.observed.occurrences == 16 {
    ExitSuccess
  } else {
    exit_failure(reason: concat("opaque-oem: expected 16 occurrences of 0fde70330102 in records 0x3ea..0x44f, counted ", to_string(assoc.observed.occurrences)))
  }
  let first_seen = if assoc.appears_only_at_or_after_record == 1023 {
    ExitSuccess
  } else {
    exit_failure(reason: "opaque-oem: first occurrence was not record 0x3ff, the first post-change restart")
  }
  let never_beside = if list_length(items: assoc.never_within_same_cycle_as) == 2 {
    ExitSuccess
  } else {
    exit_failure(reason: "opaque-oem: the completed-boot OEM pair was found in a cycle beside 0fde70330102, or the fold dropped a candidate it should have kept")
  }
  let undecoded = if association_is_decoded(association: assoc) {
    exit_failure(reason: "opaque-oem: an association over a payload the controller does not decode was read as decoded")
  } else {
    match assoc.decode_standing {
      ControllerDeclaredUnknown => ExitSuccess
      _ => exit_failure(reason: "opaque-oem: decode standing was not derived from the measured profile")
    }
  }
  first_failure(checks: [count, first_seen, never_beside, undecoded])
}

fn first_failure(checks: List<ProcessExit>) -> ProcessExit {
  fold(
    checks,
    init: ExitSuccess,
    f: (acc, c) => match acc {
      ExitFailure { code: _, reason: _ } => acc
      ExitSuccess => c
    },
  )
}

func mtcollins1_32dimm_bringup_probe() -> ProcessExit {
  return first_failure(checks: [
    check_collectors_before_actuation(),
    check_console_silence_is_not_a_terminal(),
    check_bounded_terminal(),
    check_opaque_oem_stays_opaque(),
  ])
}
