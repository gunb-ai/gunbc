// MT. COLLINS UNIT 1 AFTER THE 16-TO-32 DIMM CHANGE, 2026-09-11: THE REGRESSION CORPUS FOR THE
// PRE-OS BRING-UP MODEL. The unit went from 16 to 32 DIMMs and entered a ~5-minute restart loop
// that never reached boot-device selection. Everything below was captured by hand from srv1
// (`~/mtc1-32dimm`), committed under artifacts/bmc/mtcollins1-32dimm/, and is bound to those bytes
// by digest. The machine was not touched by this change; it is under operator hands.
//
// EVIDENCE BINDS PER SECTION, NOT PER MODULE, the rule gunbc.machine_intake_mtcollins1_memory_census_observation
// already states: each observation names the artifact it came from.
//
// THIS MODULE IS THE FIRST CONSUMER OF THE THREE MODEL MODULES, and its probe at the bottom runs
// the folds over these bytes so the three laws have executed receipts rather than sentences.

data mtcollins1_32dimm_artifact_dir: NonEmptyStr = "artifacts/bmc/mtcollins1-32dimm"

// ── the four byte-identical console captures ───────────────────────────────────────────────────

// THE CONTROLLER'S SESSION BANNER AS ipmitool CAPTURES IT WITH NO TTY AND STDERR MERGED: one
// tcgetattr complaint and the "[SOL Session operational.  Use ~? for help]" line, 86 bytes. This is
// what a capture contains when the session is live and the host has sent nothing.
data mtcollins1_sol_session_banner_bytes: ByteSize = byte_size(count: 86)

data mtcollins1_sol_session_banner_digest: ContentHash = Sha256Hash(Sha256Digest {
  hex: "3aea4368b8745ae7bdca3c7ec052a324032974f7b849bca460e7d0e14f5e0871",
})

// ONE CAPTURE UNDER ONE POWER CONDITION. `condition` is Absent for the idle capture and names the
// actuation the capture was armed against otherwise.
type SolCaptureUnderCondition {
  label: NonEmptyStr
  condition: PowerActuationKind?
  artifact_path: NonEmptyStr
  bytes: ByteSize
  digest: ContentHash
}

// FOUR CAPTURES, FOUR CONDITIONS, ONE DIGEST. Only the idle capture is committed as bytes; the
// other three digests are transcribed from the operator's manifest 99-digests.txt, which IS
// committed, so the equality is checkable against a committed artifact rather than this row.
data mtcollins1_sol_idle_capture: SolCaptureUnderCondition = SolCaptureUnderCondition {
  label: "idle",
  condition: none,
  artifact_path: "artifacts/bmc/mtcollins1-32dimm/03-sol-idle.log",
  bytes: byte_size(count: 86),
  digest: mtcollins1_sol_session_banner_digest,
}

data mtcollins1_sol_captures: List<SolCaptureUnderCondition> = [
  mtcollins1_sol_idle_capture,
  SolCaptureUnderCondition { label: "after chassis power cycle (04-sol-post.log, 99-digests.txt)", condition: Present { value: ChassisPowerCycle }, artifact_path: "04-sol-post.log", bytes: byte_size(count: 86), digest: mtcollins1_sol_session_banner_digest },
  SolCaptureUnderCondition { label: "after AC cycle (11-ac-sol.log, 99-digests.txt)", condition: Present { value: AcPowerCycle }, artifact_path: "11-ac-sol.log", bytes: byte_size(count: 86), digest: mtcollins1_sol_session_banner_digest },
  SolCaptureUnderCondition { label: "after chassis reset (31-boot-sol.log, 99-digests.txt)", condition: Present { value: HostWarmReset }, artifact_path: "31-boot-sol.log", bytes: byte_size(count: 86), digest: mtcollins1_sol_session_banner_digest },
]

// THE KEYSTROKE PROBE: two carriage returns fed into the session, 96 bytes back -- the banner plus
// the probe's own "done rc=0". The session accepted input and returned no host bytes, which is
// what separates SolPresentSilent from SolAbsent in the capability profile.
data mtcollins1_sol_probe_digest: ContentHash = Sha256Hash(Sha256Digest {
  hex: "e24f9ed8d9cedff87e6d11327c602c31fd7c3d9e2ba16e7e1ab0f8a91cdfe41e",
})

data mtcollins1_sol_probe_bytes: ByteSize = byte_size(count: 96)

fn mtcollins1_sol_reading(capture: SolCaptureUnderCondition) -> SolCaptureReading {
  sol_capture_reading(
    capture_path: capture.artifact_path,
    bytes: capture.bytes,
    digest: capture.digest,
    banner_digest: mtcollins1_sol_session_banner_digest,
  )
}

// ── the SEL window ─────────────────────────────────────────────────────────────────────────────

data mtcollins1_sel_final_artifact_path: NonEmptyStr = "artifacts/bmc/mtcollins1-32dimm/50-sel-final.txt"

data mtcollins1_sel_final_byte_count: ByteSize = byte_size(count: 99651)

data mtcollins1_sel_final_digest: ContentHash = Sha256Hash(Sha256Digest {
  hex: "14e84cd9cbd2d89d6be46caff42c3d5ab0a19079fa4546d6e6ec449f759c7ba5",
})

// RECORDS 0x3ea THROUGH 0x44f OF 50-sel-final.txt, transcribed one row each, record ids in decimal.
// The window opens at the LAST BOOT THAT COMPLETED before the DIMM change (0x3ea restart, 0x3eb
// firmware progress, 0x3ec/0x3ed the OEM pair) so the corpus contains a positive control, and runs
// to the last record in the capture. The BMC clock rendering is the controller's and is about four
// hours behind the observer's UTC (mtcollins1_bmc_clock_skew).
