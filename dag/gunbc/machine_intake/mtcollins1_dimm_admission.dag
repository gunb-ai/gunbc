module gunbc.machine_intake.mtcollins1_dimm_admission

import std.types { Bool, Int, List, NonEmptyStr, list_length }
import extdeps.memory.types { DimmBuffering, Registered, DramDieStacking, DramModuleClass, dram_module_class_eq }
import extdeps.memory.micron { mta36asf2g72pz_2g1a2_catalog }
import extdeps.memory.sk_hynix { hma82gr7afr4n_vk_catalog }
import std.measure { MegatransfersPerSecond, megatransfers_per_second }

// THE PER-PLATFORM DIMM POPULATION ADMISSION ROW OF MT. COLLINS UNIT 1 (ruling
// gunbc.design_ruling dimm_population_is_admitted_permissively, 2026-10-17). It lives in the observing
// layer, not in extdeps.ampere.mt_collins_product_brief.memory_population: DESIGN section 3 keeps
// observations this repository makes out of the observed upstream's module, and the Ampere brief models
// the brief.
//
// STANDINGS, KEPT APART (DESIGN 4d):
//  - POLICY (PolicyVerdict): the ruling's DEFAULT is a typed operator assumption, not a vendor fact: a
//    nonempty population of one module type (DramModuleClass plus non-volatile backing, stacking known) and one rank is permitted
//    to be attempted, whatever the speeds. Anything else is not covered unless an observed accepted
//    population widens it, and an empty population is refused;
//  - PLATFORM (PlatformPrediction): committed observations of this unit, each naming its run and capture,
//    predicting only for the exact population observed; everything else is unestablished;
//  - the AUTHORITY on what a unit accepted is the DRAM firmware's own training verdict on the booted
//    population. This function predicts that verdict from the observations; a booted population's verdict
//    outranks it.
//
// Evidence: artifacts/bmc/mtcollins1-boot-run-39005709187/mtcollins1-boot-sol.capture (sha256
// 8de445625f62298a5d18d29531fb80ce50c32ac0a6d6f9775a2208fc8ba131e4): four NV-RDIMM 1R 2666 (MC0, MC4,
// MC5, MC6) with four RDIMM 2R 2133, refused: "Non-identical DIMM mixture NOT supported!".
// artifacts/bmc/mtcollins1-boot-run-39010930690/mtcollins1-boot-sol.capture (sha256
// 10ec5eb02ed88559d448b3273efa1557b57e0de1ef3eb51866636d35b63bddc1): the same four RDIMM 2R 2133
// with four RDIMM 1R 2666 in place of the NV-RDIMMs, accepted and trained at 2133. The two populations
// differ in manufacturer, part, SPD and RCD as well as module type, so neither run isolates one cause.
// Each run is therefore a verdict on its EXACT population only; every other population is unestablished.

// CONSUMER (DESIGN 3c): consumed here by the witnesses only. A named later change consumes it: the
// boot-attempt admission join (gunbc.recurring_failure_mode attested_population_never_joined_to_the_firmware_reading),
// which compares a receipt's declared population with the firmware DRAM-table reading and asks this fold
// whether that population was expected to train. Trigger: that join landing.
// Buffering is extdeps.memory.types DimmBuffering (the firmware's RDIMM and NV-RDIMM are both Registered);
// non-volatile backing is the one fact the memory model does not yet carry, so it is declared here as the
// observed unit's own field rather than minted as a second module-kind vocabulary.

// One firmware DRAM-table line: socket, memory controller and slot as the reader (ampere_dram_console_observation
// AmpereDramTrainedDimm) keys them, SPD manufacturer id, part, RCD controller id, module class and the
// trained-for rank and rate. Capacity is carried by the part. The firmware line does not state die
// stacking, so it is the catalog row's fact where the part has one (extdeps.memory micron, sk_hynix) and
// Absent where it has none (the NV-RDIMM part has no catalog row); an unknown stacking can never make two
// modules the same class.
type ObservedDimm {
  socket: Int
  memory_controller: Int
  slot: Int
  spd_manufacturer: NonEmptyStr
  part_number: NonEmptyStr
  controller: NonEmptyStr
  buffering: DimmBuffering
  non_volatile_backing: Bool
  stacking: DramDieStacking?
  rank_count: Int
  megatransfers: MegatransfersPerSecond
}

// Two separate facts. POLICY: may this population be attempted (the ruling's operator default, widened
// by an observed accepted population). PLATFORM: does committed evidence predict how it trains.
type PolicyBasis
  = OperatorDefaultSameRankSameType
  | WidenedByObservedPopulation { run: NonEmptyStr }

type PolicyVerdict
  = PolicyPermitsAttempt { basis: PolicyBasis }
  | PolicyEmptyPopulationRefused
  | PolicyDefaultDoesNotCover

type PlatformPrediction
  = PlatformTrainsObserved { run: NonEmptyStr }
  | PlatformRefusesObserved { run: NonEmptyStr }
  | PlatformUnestablished

type DimmAdmissionReading {
  policy: PolicyVerdict
  platform: PlatformPrediction
}

data mtcollins1_refused_run: NonEmptyStr = "39005709187"

data mtcollins1_accepted_run: NonEmptyStr = "39010930690"

fn micron_nv_rdimm_1r_2666(memory_controller: Int) -> ObservedDimm {
  ObservedDimm { socket: 0, memory_controller: memory_controller, slot: 0, spd_manufacturer: "2c:80", part_number: "18ASF2G72XF12G6V21AB", controller: "b3:80", buffering: Registered, non_volatile_backing: true, stacking: Absent, rank_count: 1, megatransfers: megatransfers_per_second(count: 2666) }
}

fn micron_rdimm_2r_2133(memory_controller: Int) -> ObservedDimm {
  ObservedDimm { socket: 0, memory_controller: memory_controller, slot: 0, spd_manufacturer: "2c:80", part_number: "36ASF2G72PZ-2G1A2", controller: "b3:80", buffering: Registered, non_volatile_backing: false, stacking: Present { value: mta36asf2g72pz_2g1a2_catalog.die_stacking }, rank_count: 2, megatransfers: megatransfers_per_second(count: 2133) }
}

fn hynix_rdimm_1r_2666(memory_controller: Int, controller: NonEmptyStr) -> ObservedDimm {
  ObservedDimm { socket: 0, memory_controller: memory_controller, slot: 0, spd_manufacturer: "ad:80", part_number: "HMA82GR7AFR4N-VK", controller: controller, buffering: Registered, non_volatile_backing: false, stacking: Present { value: hma82gr7afr4n_vk_catalog.die_stacking }, rank_count: 1, megatransfers: megatransfers_per_second(count: 2666) }
}

// Run 39005709187 DRAM table, MC0..MC7 in order.
data mtcollins1_run_39005709187_population: List<ObservedDimm> = [micron_nv_rdimm_1r_2666(memory_controller: 0), micron_rdimm_2r_2133(memory_controller: 1), micron_rdimm_2r_2133(memory_controller: 2), micron_rdimm_2r_2133(memory_controller: 3), micron_nv_rdimm_1r_2666(memory_controller: 4), micron_nv_rdimm_1r_2666(memory_controller: 5), micron_nv_rdimm_1r_2666(memory_controller: 6), micron_rdimm_2r_2133(memory_controller: 7)]

// Run 39010930690 DRAM table; MC0 and MC4 report RCD 32:86, MC5 and MC6 report b3:80.
data mtcollins1_run_39010930690_population: List<ObservedDimm> = [hynix_rdimm_1r_2666(memory_controller: 0, controller: "32:86"), micron_rdimm_2r_2133(memory_controller: 1), micron_rdimm_2r_2133(memory_controller: 2), micron_rdimm_2r_2133(memory_controller: 3), hynix_rdimm_1r_2666(memory_controller: 4, controller: "32:86"), hynix_rdimm_1r_2666(memory_controller: 5, controller: "b3:80"), hynix_rdimm_1r_2666(memory_controller: 6, controller: "b3:80"), micron_rdimm_2r_2133(memory_controller: 7)]

fn dimm_identical(a: ObservedDimm, b: ObservedDimm) -> Bool {
  a.socket == b.socket && a.memory_controller == b.memory_controller && a.slot == b.slot && a.spd_manufacturer == b.spd_manufacturer && a.part_number == b.part_number
    && a.controller == b.controller && a.buffering == b.buffering && a.non_volatile_backing == b.non_volatile_backing && a.stacking == b.stacking
    && a.rank_count == b.rank_count && a.megatransfers == b.megatransfers
}

fn dimm_population_covers(whole: List<ObservedDimm>, part: List<ObservedDimm>) -> Bool {
  !any(part, p => !any(whole, w => dimm_identical(a: w, b: p)))
}

// Positions are distinct within a firmware table, so mutual cover at equal length is multiset equality.
fn dimm_population_identical(a: List<ObservedDimm>, b: List<ObservedDimm>) -> Bool {
  list_length(a) == list_length(b) && dimm_population_covers(whole: a, part: b) && dimm_population_covers(whole: b, part: a)
}

// Same type means the same DramModuleClass (dram_module_class_eq) and the same non-volatile backing, with
// stacking KNOWN for both; an unknown stacking cannot be shown the same.
fn dimm_same_type(a: ObservedDimm, b: ObservedDimm) -> Bool {
  a.non_volatile_backing == b.non_volatile_backing && match a.stacking {
    Absent => false
    Present { value: sa } => match b.stacking {
      Absent => false
      Present { value: sb } => dram_module_class_eq(a: DramModuleClass { buffering: a.buffering, stacking: sa }, b: DramModuleClass { buffering: b.buffering, stacking: sb })
    }
  }
}

fn dimm_population_is_uniform(modules: List<ObservedDimm>) -> Bool {
  !any(modules, a => any(modules, b => !dimm_same_type(a: a, b: b) || a.rank_count != b.rank_count))
}

fn mtcollins1_platform_prediction(modules: List<ObservedDimm>) -> PlatformPrediction {
  if dimm_population_identical(a: modules, b: mtcollins1_run_39010930690_population) {
    PlatformTrainsObserved { run: mtcollins1_accepted_run }
  } else if dimm_population_identical(a: modules, b: mtcollins1_run_39005709187_population) {
    PlatformRefusesObserved { run: mtcollins1_refused_run }
  } else {
    PlatformUnestablished
  }
}

fn mtcollins1_dimm_population_admission(modules: List<ObservedDimm>) -> DimmAdmissionReading {
  let platform = mtcollins1_platform_prediction(modules: modules)
  DimmAdmissionReading {
    platform: platform
    policy: if list_length(modules) == 0 {
      PolicyEmptyPopulationRefused
    } else if dimm_population_is_uniform(modules: modules) {
      PolicyPermitsAttempt { basis: OperatorDefaultSameRankSameType }
    } else {
      match platform {
        PlatformTrainsObserved { run: r } => PolicyPermitsAttempt { basis: WidenedByObservedPopulation { run: r } }
        PlatformRefusesObserved { run: _ } => PolicyDefaultDoesNotCover
        PlatformUnestablished => PolicyDefaultDoesNotCover
      }
    }
  }
}
