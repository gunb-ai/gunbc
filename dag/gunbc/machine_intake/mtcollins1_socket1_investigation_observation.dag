// The next diagnoses are hypotheses, typed as such (§4d): nothing above establishes any of
// them, and each names the observation that would confirm or refute it.
type MtCollins1DiagnosisHypothesis {
  hypothesis: NonEmptyStr
  discriminator: NonEmptyStr
}

data mtcollins1_socket1_basis: NonEmptyStr = "Every boot since the 2026-09-13 restore reports one socket and 80 CPUs, and no population trains a DIMM on SK1: not the symmetric MC4 placement on J25, and not the canonical Table 11 row J1+J17 that trained both sockets on 2026-09-13."

data mtcollins1_socket1_open_hypotheses: List<MtCollins1DiagnosisHypothesis> = [
  MtCollins1DiagnosisHypothesis { hypothesis: "The J17 stick or the J17 slot is bad.", discriminator: "Swap the J1 and J17 sticks: SK0 MC0 still trained and SK1 silent clears the stick; SK0 MC0 lost implicates the stick." },
  MtCollins1DiagnosisHypothesis { hypothesis: "CPU1 retention or heatsink torque is wrong, so the package does not seat.", discriminator: "Re-torque CPU1 to specification and boot J1+J17: SK1 MC0 trained and 2 sockets / 160 CPUs confirms it." },
  MtCollins1DiagnosisHypothesis { hypothesis: "Socket 1 pins or the CPU1 package are damaged.", discriminator: "Remove CPU1 and inspect the socket for bent or missing pins and the package for damage." },
  MtCollins1DiagnosisHypothesis { hypothesis: "CPU1 VRM or power delivery is not up.", discriminator: "Read the BMC's CPU1 presence, temperature and VR sensors and the SEL across a power-on: absent or faulted CPU1 rails confirm it." },
]
