// The next diagnosis is a hypothesis, typed as one (§4d): nothing above establishes it, and
// it names the observation that would confirm or refute it.
type MtCollins1DiagnosisHypothesis {
  hypothesis: NonEmptyStr
  basis: NonEmptyStr
  discriminator: NonEmptyStr
}

data mtcollins1_socket1_next_hypothesis: MtCollins1DiagnosisHypothesis = MtCollins1DiagnosisHypothesis {
  hypothesis: "CPU1 is not seated or not powered, so socket 1's memory controllers never come up.",
  basis: "Every boot since the 2026-09-13 restore reports one socket and 80 CPUs, and no population trains a DIMM on SK1, including the symmetric MC4 placement on J25.",
  discriminator: "Reseat CPU1 (or read the BMC's CPU1 presence and VR sensors) and boot a population with a DIMM on each socket: two sockets and 160 CPUs with SK1 trained confirms it; an unchanged one-socket roster with CPU1 present and powered refutes it.",
}
