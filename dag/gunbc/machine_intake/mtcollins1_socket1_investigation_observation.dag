module gunbc.machine_intake_mtcollins1_socket1_investigation_observation

import std.types { NonEmptyStr, List }
import std.nat { Nat }
import std.measure { Gibibyte, gibibyte }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.publication { SpecificationDocumentDate }
import extdeps.external_authority { CitedFigureStanding }
import extdeps.ampere.mt_collins_getting_started_guide.dimm_layout { MtCollinsDimmFigure }

// MT. COLLINS UNIT 1, 2026-09-23: THE SOCKET-1 INVESTIGATION, ONE RECEIPT PER BOOT.
// This continues the unit's bring-up history rather than starting a second log: the previous
// chapter is gunbc.machine_intake_mtcollins1_sixteen_module_restore_observation (2026-09-12/13),
// named below as this history's predecessor. Every row was read from its run's own
// mtcollins1-boot-receipts artifact (mtcollins1-boot-sol.capture) and carries that capture's
// sha256, so re-reading the artifact re-derives the row. Nothing here interprets placement:
// which physical connectors a boot populated is derived by
// gunbc.machine_intake_mtcollins1_physical_orientation from the drawing labels recorded here,
// under the orientation the firmware anchors resolve.
data mtcollins1_socket1_investigation_predecessor: DeclarationRef = DeclarationRef {
  module_path: "gunbc.machine_intake_mtcollins1_sixteen_module_restore_observation",
  decl_name: "mtcollins1_sixteen_module_restore_capture",
  field: WholeDeclaration,
}

// Three standings kept apart by type (§4d): a vendor figure, an operator's by-eye report, and
// what firmware trained. On 2026-09-23 they were conflated: the operator placed DIMMs by a
// drawing derived from Figure 9, and the firmware trained connectors the drawing did not name.
type MtCollins1PhysicalFactStanding
  = VendorFigureFact { figure: MtCollinsDimmFigure, standing: CitedFigureStanding }
  | OperatorByEyeReport { observed_on: SpecificationDocumentDate, relay: NonEmptyStr, method: NonEmptyStr }
  | FirmwareTrainedFact { run_id: Nat, artifact: NonEmptyStr, roster_lines: List<NonEmptyStr> }

// WHICH END THE OPERATOR FACED. "Left" and "right" name nothing without it, so every count or
// placement carries its own frame; none borrows another report's.
type MtCollins1ChassisEnd = FrontEnd | RearEnd

type MtCollins1Viewpoint
  = ViewpointReported { end: MtCollins1ChassisEnd, report: MtCollins1PhysicalFactStanding }
  | ViewpointNotYetReported { asked: NonEmptyStr }

// The operator's frame for today's counts and drawing-label placements. "usually" is theirs: a
// later report from another end must carry its own frame and does not inherit this one.
data mtcollins1_operator_front_report: MtCollins1Viewpoint = ViewpointReported {
  end: FrontEnd,
  report: OperatorByEyeReport {
    observed_on: SpecificationDocumentDate { year: 2026, month: 9, day: 23 },
    relay: "eager-owl-205 messages msg_3007d41b-4817-487f-8b2c-806c5bd77437 and msg_7a56693a-abd1-40c8-84de-4242a728a8d2",
    method: "Asked which end they faced for today's placements and counts, the operator said, verbatim: 'i am usually facing the front or J1 side'. A landmark report, independent of the firmware anchors.",
  },
}

data mtcollins1_frame_not_asked: MtCollins1Viewpoint = ViewpointNotYetReported {
  asked: "Not asked for this boot: its placement was described or given by J number, not counted from an edge.",
}

// A firmware roster line reduced to its identity: socket, memory controller, slot.
type MtCollins1TrainedSlot {
  socket: Nat
  controller: Nat
  slot: Nat
}

// What the operator meant to install, in the words they used. Only drawing labels are an
// input to the orientation join; a described intent is kept as said and joins nothing.
type MtCollins1IntendedPlacement
  = IntendedAsDescribed { description: NonEmptyStr }
  | IntendedAtDrawingLabels { labels: List<Nat> }
  | IntendedAtPhysicalConnectors { connectors: List<Nat> }

type MtCollins1HostCpuReading {
  sockets: Nat
  cpus: Nat
  numa_nodes: Nat
}

type MtCollins1BootFinding
  = InitrdLoadFailedKernelPanic { lines: List<NonEmptyStr> }
  | NprocSectionNulCorrupted { fail_open_repair: NonEmptyStr }
  | WorkloadShmNoSpace { lines: List<NonEmptyStr> }
  | QualificationRefused { verdict: NonEmptyStr, receipt_line: NonEmptyStr }
  | SelReadTimedOut { log_line: NonEmptyStr }
  | RedfishRouteNotFound { log_line: NonEmptyStr }
  | DiagnosticPublicationAborted { log_lines: List<NonEmptyStr>, log_source: NonEmptyStr }

// mcu_enable_mask is kept as the printed value (Absent when the boot printed none). Its
// relation to the trained controllers is computed, as an observed correlation, downstream.
type MtCollins1Socket1InvestigationBoot {
  run_id: Nat
  capture_sha256: NonEmptyStr
  intended: MtCollins1IntendedPlacement
  operator_frame: MtCollins1Viewpoint
  roster_lines: List<NonEmptyStr>
  trained: List<MtCollins1TrainedSlot>
  dram_total: Gibibyte
  mcu_enable_mask: Nat?
  mcu_enable_mask_line: NonEmptyStr?
  host: MtCollins1HostCpuReading?
  live_sockets: List<Nat>
  findings: List<MtCollins1BootFinding>
}

data mtcollins1_boot_receipts_artifact: NonEmptyStr = "GitHub Actions artifact mtcollins1-boot-receipts, file mtcollins1-boot-sol.capture"

