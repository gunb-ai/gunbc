module gunbc.machine_intake_mtcollins1_socket1_investigation_observation

import std.types { NonEmptyStr, List }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// MT. COLLINS UNIT 1, 2026-09-23: THE SOCKET-1 INVESTIGATION, ONE RECEIPT PER BOOT.
// This continues the unit's bring-up history rather than starting a second log: the previous
// chapter is gunbc.machine_intake_mtcollins1_sixteen_module_restore_observation (2026-09-12/13),
// named below as this history's predecessor. Every row was read from its run's own
// mtcollins1-boot-receipts artifact (mtcollins1-boot-sol.capture) and carries that capture's
// sha256, so re-reading the artifact re-derives the row. Nothing here interprets placement:
// which physical connectors a boot populated is derived by
// gunbc.machine_intake_mtcollins1_physical_orientation from the drawing labels recorded here,
// under the orientation the firmware anchors resolve.
data mtcollins1_socket1_investigation_predecessor: DeclarationRef = DeclarationRef {
  module_path: "gunbc.machine_intake_mtcollins1_sixteen_module_restore_observation",
  decl_name: "mtcollins1_sixteen_module_restore_capture",
  field: WholeDeclaration,
}

// A firmware roster line reduced to its identity: socket, memory controller, slot.
type MtCollins1TrainedSlot {
  socket: Nat
  controller: Nat
  slot: Nat
}

// What the operator meant to install, in the words they used. Only drawing labels are an
// input to the orientation join; a described intent is kept as said and joins nothing.
type MtCollins1IntendedPlacement
  = IntendedAsDescribed { description: NonEmptyStr }
  | IntendedAtDrawingLabels { labels: List<Nat> }
  | IntendedAtPhysicalConnectors { connectors: List<Nat> }

type MtCollins1HostCpuReading {
  sockets: Nat
  cpus: Nat
  numa_nodes: Nat
}

type MtCollins1BootFinding
  = InitrdLoadFailedKernelPanic { lines: List<NonEmptyStr> }
  | NprocSectionNulCorrupted { fail_open_repair: NonEmptyStr }
  | WorkloadShmNoSpace { lines: List<NonEmptyStr> }
  | QualificationRefused { verdict: NonEmptyStr, receipt_line: NonEmptyStr }

// mcu_enable_mask is kept as the printed value (Absent when the boot printed none). Its
// relation to the trained controllers is computed, as an observed correlation, downstream.
type MtCollins1Socket1InvestigationBoot {
  run_id: Nat
  capture_sha256: NonEmptyStr
  intended: MtCollins1IntendedPlacement
  roster_lines: List<NonEmptyStr>
  trained: List<MtCollins1TrainedSlot>
  dram_total_gib: Nat
  mcu_enable_mask: Nat?
  mcu_enable_mask_line: NonEmptyStr?
  host: MtCollins1HostCpuReading?
  live_sockets: List<Nat>
  findings: List<MtCollins1BootFinding>
}

data mtcollins1_boot_receipts_artifact: NonEmptyStr = "GitHub Actions artifact mtcollins1-boot-receipts, file mtcollins1-boot-sol.capture"

