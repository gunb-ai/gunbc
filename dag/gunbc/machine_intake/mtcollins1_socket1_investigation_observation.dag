// WHICH PROCESSOR SITS IN EACH SOCKET (operator, chat, 2026-09-23). Release is the part's
// production standing, not a stepping: no stepping or microcode reading has been taken.
type MtCollins1CpuRelease = EngineeringSample | ProductionPart

type MtCollins1SocketCpu {
  socket: Nat
  issue: MtCollins1CpuRelease
  provenance: NonEmptyStr
  report: MtCollins1PhysicalFactStanding
}

data mtcollins1_cpu_report_2026_09_23: MtCollins1PhysicalFactStanding = OperatorByEyeReport {
  observed_on: SpecificationDocumentDate { year: 2026, month: 9, day: 23 },
  relay: "eager-owl-205 brief for work item adhoc-712174ff-d1e",
  method: "Operator's statement of what they installed; not read from firmware.",
}

data mtcollins1_socket_cpus: List<MtCollins1SocketCpu> = [
  MtCollins1SocketCpu { socket: 0, issue: EngineeringSample, provenance: "Ampere Altra engineering sample the operator installed as a replacement.", report: mtcollins1_cpu_report_2026_09_23 },
  MtCollins1SocketCpu { socket: 1, issue: ProductionPart, provenance: "The machine's original production CPU.", report: mtcollins1_cpu_report_2026_09_23 },
]

// Has this CPU pairing booted since the swap? The operator's words say the machine booted; a
// degraded one-socket boot satisfies them too, so this carries no socket count and weakens no
// hypothesis. A report naming both sockets or 160 CPUs would be a different, stronger arm.
type MtCollins1PairingBootHistory
  = MachineBootReportedSinceSwap { quote: NonEmptyStr, report: MtCollins1PhysicalFactStanding }
  | PairingBootNotYetReported { question: NonEmptyStr }

data mtcollins1_pairing_boot_history: MtCollins1PairingBootHistory = MachineBootReportedSinceSwap {
  quote: "the machine has booted since i swapped the CPU - so it's probably not that",
  report: OperatorByEyeReport {
    observed_on: SpecificationDocumentDate { year: 2026, month: 9, day: 23 },
    relay: "eager-owl-205 message msg_bb424be5-be47-4841-8221-c88587f6e5da",
    method: "Operator's recollection in chat, verbatim; no date and no socket or CPU count was given.",
  },
}

// Spares on hand of this processor family: approximate, as the operator said it.
type MtCollins1SpareProcessors {
  approximate_count: Nat
  family: NonEmptyStr
  report: MtCollins1PhysicalFactStanding
}

data mtcollins1_spare_processors: MtCollins1SpareProcessors = MtCollins1SpareProcessors {
  approximate_count: 45,
  family: "Ampere Altra",
  report: mtcollins1_cpu_report_2026_09_23,
}

// WHAT IS ESTABLISHED IS NARROW: firmware reports one active socket. That is not "socket 1
// is bad"; which layer stops it is open. Only the printed count is carried: no complete parse
// of the summary's socket blocks is, so nothing here asserts what the summary omitted.
type MtCollins1FirmwareSocketSummary {
  run_id: Nat
  capture_sha256: NonEmptyStr
  line: NonEmptyStr
  active_sockets: Nat
}

data mtcollins1_firmware_socket_summary: MtCollins1FirmwareSocketSummary = MtCollins1FirmwareSocketSummary {
  run_id: 35871654468,
  capture_sha256: "6bfd827b10ef0731cba430f8fc22a1fa8ecafdfbe14f00510e15fc38cf8b8006",
  line: "Number of active sockets    : 1",
  active_sockets: 1,
}

// THE STICK EXCHANGE, AS THE OPERATOR REPORTED IT. The captures print the same part number for
// both modules, so which stick sat where is not in them: this report is the only source, and
// the stick refutation is derived from it joined to the two boot receipts.
type MtCollins1StickPlacement {
  run_id: Nat
  stick: NonEmptyStr
  connector: Nat
}

type MtCollins1StickSwapReport {
  placements: List<MtCollins1StickPlacement>
  report: MtCollins1PhysicalFactStanding
}

data mtcollins1_j1_j17_stick_swap: MtCollins1StickSwapReport = MtCollins1StickSwapReport {
  placements: [
    MtCollins1StickPlacement { run_id: 35810323032, stick: "stick A", connector: 1 },
    MtCollins1StickPlacement { run_id: 35810323032, stick: "stick B", connector: 17 },
    MtCollins1StickPlacement { run_id: 35871654468, stick: "stick B", connector: 1 },
    MtCollins1StickPlacement { run_id: 35871654468, stick: "stick A", connector: 17 },
  ],
  report: OperatorByEyeReport {
    observed_on: SpecificationDocumentDate { year: 2026, month: 9, day: 23 },
    relay: "eager-owl-205 brief for work item adhoc-712174ff-d1e",
    method: "Operator's report that the J1 and J17 sticks were exchanged between the two runs; A and B are labels for that exchange, not serial numbers.",
  },
}

// The diagnoses are hypotheses, typed as such (§4d): bets, not facts. Each names the
// observation that would discriminate it. No standing ranks one bet above another. A
// refutation is not authored: it names the report it is derived from, and the renderer derives it.
type MtCollins1HypothesisStanding
  = HypothesisOpen
  | HypothesisRefutedByStickSwap { swap: MtCollins1StickSwapReport }

type MtCollins1DiagnosisHypothesis {
  hypothesis: NonEmptyStr
  discriminator: NonEmptyStr
  standing: MtCollins1HypothesisStanding
}

// One open hypothesis per layer at which socket 1 could stop short of UEFI enumeration, in
// bring-up order, each discriminated by per-socket SMpro/BMC evidence the socket-1
// diagnostics work item is wiring into the boot bundle; then the CPU pairing and the stick.
data mtcollins1_socket1_hypotheses: List<MtCollins1DiagnosisHypothesis> = [
  MtCollins1DiagnosisHypothesis { hypothesis: "Physical presence: CPU1 is not detected as present (seating, retention torque, bent or fouled socket pins, package damage).", discriminator: "BMC CPU1 presence sensor across a power-on; if absent, re-torque and inspect the socket and package.", standing: HypothesisOpen },
  MtCollins1DiagnosisHypothesis { hypothesis: "Power and rails: CPU1's VRM or rails do not come up.", discriminator: "BMC CPU1 VR sensors and the SEL across a power-on: absent or faulted CPU1 rails.", standing: HypothesisOpen },
  MtCollins1DiagnosisHypothesis { hypothesis: "Reset and firmware-ready: socket 1 is not released from reset or never signals firmware-ready.", discriminator: "Per-socket SMpro/BMC reset and ready status for socket 1 in the boot bundle.", standing: HypothesisOpen },
  MtCollins1DiagnosisHypothesis { hypothesis: "SCP/SMpro boot stage: socket 1's SCP or SMpro stops before joining the two-socket boot.", discriminator: "Socket 1's SCP/SMpro boot-stage and error registers via the BMC in the boot bundle.", standing: HypothesisOpen },
  MtCollins1DiagnosisHypothesis { hypothesis: "DDR init and training: socket 1 comes up but its memory initialisation fails, so the socket is dropped.", discriminator: "Socket 1 DDR init/training status from SMpro/BMC; a J17 module listed as SK1 MC0 in the roster.", standing: HypothesisOpen },
  MtCollins1DiagnosisHypothesis { hypothesis: "UEFI enumeration: socket 1 completes SCP bring-up but UEFI does not enumerate it.", discriminator: "SCP reporting two active sockets while UEFI and lscpu still report one.", standing: HypothesisOpen },
  MtCollins1DiagnosisHypothesis { hypothesis: "The engineering-sample CPU0 with the production CPU1 is an unsupported two-socket pairing (stepping or microcode).", discriminator: "An operator report that this pairing showed both sockets / 160 CPUs after the swap would weaken it; booting J1+J17 with a production CPU0 matching CPU1 and seeing SK1 MC0 train would support it.", standing: HypothesisOpen },
  MtCollins1DiagnosisHypothesis { hypothesis: "The DIMM is at fault: a stick placed in J17 is bad.", discriminator: "Exchange the J1 and J17 sticks: the stick that was silent in J17 training in J1 clears it. This clears the stick, not the J17 slot.", standing: HypothesisRefutedByStickSwap { swap: mtcollins1_j1_j17_stick_swap } },
]
