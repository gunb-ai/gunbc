module gunbc.machine_intake_ampere_checkpoint_console_observation

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.algebra { trim }
import v2.std.optional { Present }
import gunbc.machine_intake_pre_os_bringup_verdict { firmware_checkpoint_line_prefix }
import gunbc.machine_intake_ampere_dram_console_observation { ampere_dram_fw_version_marker, ampere_dram_console_line }

// THE "CP: xxxxxxxx" CHECKPOINT WORDS THE AMPERE FIRMWARE PRINTED ON THE SERIAL CONSOLE, as an
// observation receipt of this repository.
//
// A WORD IS OPAQUE HERE, AND THAT IS DELIBERATE. The layout of the word's fields is not taken from
// any public source, so this module never decodes one: a word is its eight printed hex digits, and
// the only operations are ORDER (which word came last) and EQUALITY against another capture of our
// own. Any field decode belongs to gunbc-private, which may consume this observation; this module
// never imports it (docs/plans/power-on-sequence-model.md, section 2 note).
//
// CYCLES. A reset loop prints the DRAM firmware's "DRAM FW version" banner once per boot, and on
// mtcollins1 nothing is printed before it, so the banner opens a cycle. Words before the first
// banner form a cycle of their own (a capture that began mid-boot). The cycle read is the LAST one,
// because it led to whatever followed -- the same rule the DRAM block reader applies
// (gunbc.machine_intake_ampere_dram_console_observation).
//
// A "CP:" LINE WHOSE WORD IS NOT EIGHT HEX DIGITS IS KEPT AS MALFORMED, never dropped (DESIGN
// section 5): a firmware that changes the word's width shows up in the receipt, not as a shorter
// sequence.

// Eight hex digits, as every capture this corpus holds prints them; checkpoint_word_of indexes them.
data ampere_checkpoint_word_digits: Int = 8

type AmpereCheckpointWord {
  digits: NonEmptyStr
}

type AmpereCheckpointCycle {
  words: List<AmpereCheckpointWord>
  malformed: List<String>
}

type AmpereCheckpointConsoleObservation
  = AmpereCheckpointsNotPrinted
  | AmpereCheckpointsObserved { last_cycle: AmpereCheckpointCycle, cycles_printed: Int }

data ampere_checkpoint_hex_digits: String = "0123456789abcdefABCDEF"

fn is_hex_digit(c: String) -> Bool {
  c.length() == 1 && string_contains(s: ampere_checkpoint_hex_digits, pattern: c)
}

fn checkpoint_word_of(token: String) -> AmpereCheckpointWord? {
  let t = trim(token)
  if t.length() != ampere_checkpoint_word_digits { none }
  else if any(map([0, 1, 2, 3, 4, 5, 6, 7], i => char_at(s: t, pos: i)), c => !is_hex_digit(c: c)) { none }
  else { Present { value: AmpereCheckpointWord { digits: t as NonEmptyStr } } }
}

type AmpereCheckpointLine
  = CheckpointCycleOpens
  | CheckpointWordLine { word: AmpereCheckpointWord }
  | CheckpointMalformedLine { line: String }
  | CheckpointUnrelatedLine

fn ampere_checkpoint_line_of(raw: String) -> AmpereCheckpointLine {
  let line = trim(ampere_dram_console_line(raw: raw))
  if string_contains(s: line, pattern: ampere_dram_fw_version_marker) { CheckpointCycleOpens }
  else if !starts_with(s: line, prefix: firmware_checkpoint_line_prefix as String) { CheckpointUnrelatedLine }
  else {
    match checkpoint_word_of(token: substring(s: line, start: (firmware_checkpoint_line_prefix as String).length(), end: line.length())) {
      Present { value: w } => CheckpointWordLine { word: w }
      Absent => CheckpointMalformedLine { line: line }
    }
  }
}

type AmpereCheckpointFold {
  closed: Int
  current: AmpereCheckpointCycle
  any_word: Bool
}

fn empty_checkpoint_cycle() -> AmpereCheckpointCycle {
  let ws: List<AmpereCheckpointWord> = []
  let ms: List<String> = []
  AmpereCheckpointCycle { words: ws, malformed: ms }
}

fn checkpoint_cycle_is_empty(c: AmpereCheckpointCycle) -> Bool {
  count(c.words) == 0 && count(c.malformed) == 0
}

// A banner closes the current cycle only when that cycle printed something, so a banner at the head
// of the capture does not count an empty cycle. A capture that ends on a banner after a closed cycle
// reports a last cycle with no word: that cycle printed nothing yet, and the previous cycle's words
// are not substituted for it.
fn checkpoint_fold_step(acc: AmpereCheckpointFold, raw: String) -> AmpereCheckpointFold {
  match ampere_checkpoint_line_of(raw: raw) {
    CheckpointCycleOpens =>
      if checkpoint_cycle_is_empty(c: acc.current) { acc }
      else { AmpereCheckpointFold { closed: acc.closed + 1, current: empty_checkpoint_cycle(), any_word: acc.any_word } }
    CheckpointWordLine { word: w } =>
      AmpereCheckpointFold { closed: acc.closed, current: AmpereCheckpointCycle { words: concat(acc.current.words, [w]), malformed: acc.current.malformed }, any_word: true }
    CheckpointMalformedLine { line: l } =>
      AmpereCheckpointFold { closed: acc.closed, current: AmpereCheckpointCycle { words: acc.current.words, malformed: concat(acc.current.malformed, [l]) }, any_word: true }
    CheckpointUnrelatedLine => acc
  }
}

fn ampere_checkpoint_console_observation(lines: List<String>) -> AmpereCheckpointConsoleObservation {
  let done = fold(lines, init: AmpereCheckpointFold { closed: 0, current: empty_checkpoint_cycle(), any_word: false }, f: (acc, l) => checkpoint_fold_step(acc: acc, raw: l))
  if !done.any_word { AmpereCheckpointsNotPrinted }
  else { AmpereCheckpointsObserved { last_cycle: done.current, cycles_printed: done.closed + 1 } }
}

fn ampere_checkpoint_last_word(c: AmpereCheckpointCycle) -> AmpereCheckpointWord? {
  c.words.last()
}

// ── AGAINST A REFERENCE CAPTURE ─────────────────────────────────────────────────────────────────
// The comparison is by equality of printed words only. The subject's last word is looked up in the
// reference's last cycle; where it occurs, the reference's next word and the count of words it
// printed after it are what a reader may cite ("the reference continued for N more checkpoints").
// The FIRST occurrence is used: a word the reference printed more than once is reported with its
// occurrences, so the choice is visible rather than silent. A reference that could not be read is
// its own arm, never a reference that printed nothing; the caller that read it constructs it.
type AmpereCheckpointReferenceComparison
  = CheckpointReferenceContinues { last: AmpereCheckpointWord, next: AmpereCheckpointWord, remaining: Int, occurrences: Int }
  | CheckpointReferenceEndsThere { last: AmpereCheckpointWord }
  | CheckpointLastWordNotInReference { last: AmpereCheckpointWord }
  | CheckpointSubjectHasNoWord
  | CheckpointReferenceHasNoWord
  | CheckpointReferenceUnread { detail: String }

type WordSearch {
  at: Int
  found: Int?
}

fn index_of_word(words: List<AmpereCheckpointWord>, w: AmpereCheckpointWord) -> Int? {
  fold(words, init: WordSearch { at: 0, found: none }, f: (acc, x) => WordSearch {
    at: acc.at + 1,
    found: match acc.found { Present { value: i } => Present { value: i } Absent => if (x.digits as String) == (w.digits as String) { Present { value: acc.at } } else { none } },
  }).found
}

fn ampere_checkpoint_reference_comparison(subject: AmpereCheckpointConsoleObservation, reference: AmpereCheckpointConsoleObservation) -> AmpereCheckpointReferenceComparison {
  match subject {
    AmpereCheckpointsNotPrinted => CheckpointSubjectHasNoWord
    AmpereCheckpointsObserved { last_cycle: sc, cycles_printed: _ } => match ampere_checkpoint_last_word(c: sc) {
      Absent => CheckpointSubjectHasNoWord
      Present { value: last } => match reference {
        AmpereCheckpointsNotPrinted => CheckpointReferenceHasNoWord
        AmpereCheckpointsObserved { last_cycle: rc, cycles_printed: _ } => match index_of_word(words: rc.words, w: last) {
          Absent => CheckpointLastWordNotInReference { last: last }
          Present { value: i } => {
            let after = rc.words.skip(n: i + 1)
            let occurrences = count(filter(rc.words, x => (x.digits as String) == (last.digits as String)))
            match after.first() {
              Absent => CheckpointReferenceEndsThere { last: last }
              Present { value: next } => CheckpointReferenceContinues { last: last, next: next, remaining: count(after), occurrences: occurrences }
            }
          }
        }
      }
    }
  }
}

fn ampere_checkpoint_console_text(o: AmpereCheckpointConsoleObservation) -> String {
  match o {
    AmpereCheckpointsNotPrinted => "no CP: checkpoint printed"
    AmpereCheckpointsObserved { last_cycle: c, cycles_printed: n } => join([
      concat("cycles printed: ", to_string(n)),
      concat("last cycle: ", to_string(count(c.words)), " word(s), last ", match ampere_checkpoint_last_word(c: c) { Absent => "none" Present { value: w } => w.digits as String }),
      concat("last cycle words: ", join(map(c.words, w => w.digits as String), " ")),
      if count(c.malformed) == 0 { "malformed: none" } else { concat("MALFORMED: ", join(c.malformed, " | ")) },
    ], "\n")
  }
}

fn ampere_checkpoint_reference_comparison_text(c: AmpereCheckpointReferenceComparison) -> String {
  match c {
    CheckpointReferenceContinues { last: l, next: n, remaining: r, occurrences: k } =>
      concat("the reference printed ", l.digits as String, " (", to_string(k), " time(s)) and continued with ", n.digits as String, " and ", to_string(r - 1), " further word(s)")
    CheckpointReferenceEndsThere { last: l } => concat("the reference's last cycle also ended at ", l.digits as String)
    CheckpointLastWordNotInReference { last: l } => concat("the reference never printed ", l.digits as String)
    CheckpointSubjectHasNoWord => "no subject word to compare"
    CheckpointReferenceHasNoWord => "the reference printed no checkpoint"
    CheckpointReferenceUnread { detail: d } => concat("the reference capture is UNREAD: ", d)
  }
}
