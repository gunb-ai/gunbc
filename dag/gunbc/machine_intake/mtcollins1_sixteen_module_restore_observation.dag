// MT. COLLINS UNIT 1 AFTER THE OPERATOR RESTORED THE SIXTEEN PROVEN MODULES, 2026-09-12/13: THE
// SECOND HALF OF THE PRE-OS BRING-UP REGRESSION CORPUS. gunbc.machine_intake_mtcollins1_32dimm_bringup_observation
// holds the failure side -- the 32-DIMM restart loop, the 3DS mixture the firmware refused with a
// stated locus. This module holds what the same instruments recorded once the population was put
// back: the controller's event log across the swap, and three held-session console captures of
// boots that trained.
//
// WHAT THIS CORPUS CAN AND CANNOT ESTABLISH, STATED FIRST BECAUSE THE PR THAT LANDED IT FIRST
// CLAIMED MORE. The PR headline read "the restoration held: 1h52m, zero restarts", computed from the
// SEL window below. Run through the verdict fold that already owns this question, that window
// yields BringupUndetermined -- and that is the fold being RIGHT, not the corpus being weak: the
// model's only positive arm is a standard firmware-progress SEL record, and this controller wrote
// none after the power-up even though the host reached the UEFI shell; and the console grammar
// recognises refusals, not successes, so a capture whose firmware printed its trained capacity and
// entered boot-device selection reads as "host bytes, no terminal stated". The absence of restart
// records is carried and checked, but absence is not a boot (the same law this PR's own history
// withdrew once already, at bf4cac94400). The capability that would turn these captures into a
// positive terminal is declared at the bottom as the frontier it is.
//
// EVIDENCE BINDS PER SECTION, NOT PER MODULE: each row names the artifact it came from, by path
// and digest, and the witness that reads the committed bytes checks each row's byte count against
// them (gunbc.test.claim.machine_intake.mtcollins1_sixteen_module_restore_witness_test).

// ── the event log across the swap ─────────────────────────────────────────────────────────────

// RECORDS 0x637 THROUGH 0x64f OF THE `sel list` IN THE CAPTURE, one row each, record ids in
// decimal, the controller's clock rendering carried verbatim. The window opens on the last four
// restarts of the dual-die loop (0x637, 0x639, 0x63b, 0x63d -- the ~5m10s cadence) so the corpus
// carries the failure it claims to have left, runs through the AC loss and power-up of the module
// swap (0x63f, 0x640), and ends at the last record the controller held when the capture was
// taken. The capture's own first and third lines record the host clock and the controller clock
// in the same second: host 16:52:56Z, controller 12:52:56 PM UTC -- the four-hour offset
// gunbc.machine_intake_mtcollins1_diskless_boot_receipt already measured. No fold here joins the
// two clocks; the rendering is data.
//
// THE OEM PAYLOAD IN THIS LOOP IS 0fde70331102, NOT THE 0fde70330102 OF THE 32-DIMM LOOP. One byte
// differs. It is carried verbatim and decoded by nothing, exactly as the 32-DIMM payload is.
data mtcollins1_stable_boot_window_capture: SelWindowCapture = SelWindowCapture {
  artifact_path: "artifacts/bmc/mtcollins1-stable-boot-window-2026-09-12T1652Z.txt",
  byte_count: byte_size(count: 2387),
  digest: Sha256Hash(Sha256Digest { hex: "441c968d80ecb23c49a39d87de6f9d23a21a6fb9bd5dd5ee0193ffec28837c36" }),
  events: [
    SelWindowEvent { record_id: 1591, bmc_clock_rendering: "09/12/2026 10:37:03 AM UTC", kind: BootRestart { offset: SystemRestart } },
    SelWindowEvent { record_id: 1592, bmc_clock_rendering: "09/12/2026 10:37:06 AM UTC", kind: OemTimestamped { payload: OemSelPayload { manufacturer_id_rendering: "00cd3a", oem_bytes_rendering: "0fde70331102" } } },
    SelWindowEvent { record_id: 1593, bmc_clock_rendering: "09/12/2026 10:42:13 AM UTC", kind: BootRestart { offset: SystemRestart } },
    SelWindowEvent { record_id: 1594, bmc_clock_rendering: "09/12/2026 10:42:17 AM UTC", kind: OemTimestamped { payload: OemSelPayload { manufacturer_id_rendering: "00cd3a", oem_bytes_rendering: "0fde70331102" } } },
    SelWindowEvent { record_id: 1595, bmc_clock_rendering: "09/12/2026 10:47:24 AM UTC", kind: BootRestart { offset: SystemRestart } },
    SelWindowEvent { record_id: 1596, bmc_clock_rendering: "09/12/2026 10:47:28 AM UTC", kind: OemTimestamped { payload: OemSelPayload { manufacturer_id_rendering: "00cd3a", oem_bytes_rendering: "0fde70331102" } } },
    SelWindowEvent { record_id: 1597, bmc_clock_rendering: "09/12/2026 10:52:35 AM UTC", kind: BootRestart { offset: SystemRestart } },
    SelWindowEvent { record_id: 1598, bmc_clock_rendering: "09/12/2026 10:52:39 AM UTC", kind: OemTimestamped { payload: OemSelPayload { manufacturer_id_rendering: "00cd3a", oem_bytes_rendering: "0fde70331102" } } },
    SelWindowEvent { record_id: 1599, bmc_clock_rendering: "09/12/2026 10:59:49 AM UTC", kind: OtherStandardEvent { rendering: "Power Unit #0xe0 | AC lost | Asserted" } },
    SelWindowEvent { record_id: 1600, bmc_clock_rendering: "09/12/2026 10:59:51 AM UTC", kind: BootRestart { offset: InitiatedByPowerUp } },
    SelWindowEvent { record_id: 1601, bmc_clock_rendering: "09/12/2026 11:00:01 AM UTC", kind: OtherStandardEvent { rendering: "Fan #0x0f | Device Present | Asserted" } },
    SelWindowEvent { record_id: 1602, bmc_clock_rendering: "09/12/2026 11:00:01 AM UTC", kind: OtherStandardEvent { rendering: "Fan #0x10 | Device Present | Asserted" } },
    SelWindowEvent { record_id: 1603, bmc_clock_rendering: "09/12/2026 11:00:01 AM UTC", kind: OtherStandardEvent { rendering: "Fan #0x11 | Device Present | Asserted" } },
    SelWindowEvent { record_id: 1604, bmc_clock_rendering: "09/12/2026 11:00:01 AM UTC", kind: OtherStandardEvent { rendering: "Fan #0x12 | Device Present | Asserted" } },
    SelWindowEvent { record_id: 1605, bmc_clock_rendering: "09/12/2026 11:00:01 AM UTC", kind: OtherStandardEvent { rendering: "Fan #0x13 | Device Present | Asserted" } },
    SelWindowEvent { record_id: 1606, bmc_clock_rendering: "09/12/2026 11:00:01 AM UTC", kind: OtherStandardEvent { rendering: "Fan #0x14 | Device Present | Asserted" } },
    SelWindowEvent { record_id: 1607, bmc_clock_rendering: "09/12/2026 11:00:01 AM UTC", kind: OtherStandardEvent { rendering: "Fan #0x15 | Device Present | Asserted" } },
    SelWindowEvent { record_id: 1608, bmc_clock_rendering: "09/12/2026 11:00:01 AM UTC", kind: OtherStandardEvent { rendering: "Fan #0x16 | Device Present | Asserted" } },
    SelWindowEvent { record_id: 1609, bmc_clock_rendering: "09/12/2026 11:00:19 AM UTC", kind: OtherStandardEvent { rendering: "System ACPI Power State #0x4d | S0/G0: working | Asserted" } },
    SelWindowEvent { record_id: 1610, bmc_clock_rendering: "09/12/2026 11:00:24 AM UTC", kind: OtherStandardEvent { rendering: "System ACPI Power State #0x5e | S0/G0: working | Asserted" } },
    SelWindowEvent { record_id: 1611, bmc_clock_rendering: "09/12/2026 11:00:29 AM UTC", kind: OtherStandardEvent { rendering: "Power Supply #0xea | Presence detected | Asserted" } },
    SelWindowEvent { record_id: 1612, bmc_clock_rendering: "09/12/2026 11:00:29 AM UTC", kind: OtherStandardEvent { rendering: "Power Supply #0xeb | Presence detected | Asserted" } },
