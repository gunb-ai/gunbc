    SelWindowEvent { record_id: 1615, bmc_clock_rendering: "09/12/2026 12:04:21 PM UTC", kind: OemTimestamped { payload: OemSelPayload { manufacturer_id_rendering: "00cd3a", oem_bytes_rendering: "caeff107ffff" } } },
