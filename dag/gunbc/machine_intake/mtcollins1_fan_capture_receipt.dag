module gunbc.machine_intake.mtcollins1_fan_capture_receipt

// THE TYPING OF srv1's BLANK-READING STATUS ROWS, READ ONCE FROM THE BMC AND COMMITTED AS BYTES.
//
// The gate in gunbc.machine_intake.chassis_fan_establishment refuses a row whose reading cell is empty.
// Four rows on srv1 are printed that way while healthy, and ipmitool's own SDR repository says why:
// they are not threshold sensors, so a reading is not expected. That fact is not modelled here and not
// hand-written - it is the raw verbose output of ONE read of the repository, committed beside the
// digest recorded for it, and parsed by the same extdeps.bmc.ipmi_sdr parser the live read uses.
//
// THE SEAM, NAMED (extdeps/external_authority.dag:32-36). The bytes below are a BOUNDARY TRANSCRIPTION:
// they were committed beside the run's recorded digest, and nothing in the substrate re-checks them
// against the run that produced them. The digest here is therefore a claim about the artifact, not a
// verified property of it; the artifact path and run id are what an operator re-fetches to check.
// TRIGGER: re-capture by re-running fleet-converge.yml mode=mtcollins1_fan_observe host=srv1 and
// replacing these lines with the new run's output; a row whose record is absent stays refused, so a
// stale capture can only ever refuse, never admit.
//
// WHY THESE FIVE AND NOT THE WHOLE REPOSITORY: the file at the path below holds 197 records; the
// records quoted here are the four the boot-5 gate refused plus one threshold control, kept verbatim. Nothing in the rule reads a
// record that is not in a capture, and nothing reads a sensor NUMBER: the committed capture types
// EndOfPost as 'Sensor Type (Discrete): Unknown (0xd0)', an OEM code, which a name- or number-keyed
// rule would have refused.

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.decl_ref { decl_ref }
import extdeps.external_authority { CitedFigureStanding, ObservedByReceipt, TranscribedUncited, observed_receipt }
import extdeps.bmc.ipmi_sdr { SdrVerboseReadout, SdrVerboseRead, SdrVerboseEmptyRepository, SdrVerboseRecord, SdrVerboseUnreadable, sdr_verbose_readout, sdr_repository_carries_both_kinds }

data mtcollins1_fan_capture_run_id: String = "41406891344"
data mtcollins1_fan_capture_dispatch: String = "fleet-converge.yml --ref main -f mode=mtcollins1_fan_observe -f host=srv1"
data mtcollins1_fan_capture_artifact_name: String = "mtcollins1-fan-observation"
data mtcollins1_fan_capture_artifact_path: String = "artifacts/bmc/mtcollins1-fan-observe-run-41406891344-host-off/mtcollins1-fan-observation.txt"
data mtcollins1_fan_capture_artifact_sha256: String = "4f418a57e1a249a5f0178e36b862106ba83039881cde7be7fa25f26bb2855337"
data mtcollins1_fan_capture_artifact_bytes: Int = 144775
// The receipt's own run-scope marker line was `run=0 verbose_exit=0`; the parse below is allowed only
// because the read itself succeeded, so the exit status is carried rather than assumed.
data mtcollins1_fan_capture_exit_code: Int = 0
// The four records the boot-5 gate refused, as the tool printed them, in repository order, PLUS one
// threshold record taken from the same read. The
// threshold record is here so the REFUSAL direction of the classifier is grounded in real bytes too:
// a rule that refused only invented rows and admitted invented ones would pass either way.
data mtcollins1_fan_capture_repository_lines: List<String> = [
  // PSU2_Status -- verbatim from the committed artifact
  "Sensor ID              : PSU2_Status (0xeb)",
  " Entity ID             : 0.0 (Unspecified)",
  " Sensor Type (Discrete): Power Supply (0x08)",
  " Sensor Reading        : 0h",
  " Event Message Control : Entire Sensor Only",
  " Assertions Enabled    : Power Supply",
  "                         [Presence detected]",
  "                         [Failure detected]",
  "                         [Predictive failure]",
  "                         [Power Supply AC lost]",
  "                         [AC lost or out-of-range]",
  "                         [AC out-of-range, but present]",
  "                         [Config Error]",
  "                         [Power Supply Inactive]",
  " Deassertions Enabled  : Power Supply",
  "                         [Presence detected]",
  "                         [Failure detected]",
