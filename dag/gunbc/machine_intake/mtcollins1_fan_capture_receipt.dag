module gunbc.machine_intake.mtcollins1_fan_capture_receipt

// THE TYPING OF srv1's BLANK-READING STATUS ROWS, READ ONCE FROM THE BMC AND COMMITTED AS BYTES.
//
// WHAT THIS MODULE IS, AND WHAT IT IS NOT. It is the raw stdout of one read, kept as BYTES so the
// admission rule can be grounded on what a BMC actually printed rather than on a shape we invented, and
// so the witnesses can inhabit those bytes. It is NOT a rung: it mints no ObservedByReceipt, holds no
// sealed entry, and no production path reads it - boot admission comes from the live per-round verbose
// read alone (gunbc.machine_intake.mtcollins1_boot_fan_gate), which is what keeps a stale or wrong
// capture unable to admit anything. "Receipt" in the name means the run's record of what it read.
//
// The gate in gunbc.machine_intake.chassis_fan_establishment refuses a row whose reading cell is empty.
// Four rows on srv1 are printed that way while healthy, and ipmitool's own SDR repository says why:
// they are not threshold sensors, so a reading is not expected. That fact is not modelled here and not
// hand-written - it is the raw verbose output of ONE read of the repository, committed beside the
// digest recorded for it, and parsed by the same extdeps.bmc.ipmi_sdr parser the live read uses.
//
// THE SEAM, NAMED (extdeps/external_authority.dag:32-36). The bytes below are a BOUNDARY TRANSCRIPTION:
// they were committed beside the run's recorded digest, and nothing in the substrate re-checks them
// against the run that produced them. The digest here is therefore a claim about the artifact, not a
// verified property of it; the artifact path and run id are what an operator re-fetches to check.
// TRIGGER: re-capture by re-running fleet-converge.yml mode=mtcollins1_fan_observe host=srv1 and
// replacing these lines with the new run's output; a row whose record is absent stays refused, so a
// stale capture can only ever refuse, never admit.
//
// WHY THESE FIVE AND NOT THE WHOLE REPOSITORY: the file at the path below holds 197 records; the
// records quoted here are the four the boot-5 gate refused plus one threshold control, kept verbatim. Nothing in the rule reads a
// record that is not in a capture, and nothing reads a sensor NUMBER: the committed capture types
// EndOfPost as 'Sensor Type (Discrete): Unknown (0xd0)', an OEM code, which a name- or number-keyed
// rule would have refused.

import std.types { Bool, Int, List, NonEmptyStr, String }
import extdeps.bmc.ipmi_sdr { SdrVerboseReadout, SdrVerboseRead, SdrVerboseEmptyRepository, SdrVerboseRecord, SdrVerboseUnreadable, sdr_verbose_readout, sdr_repository_carries_both_kinds }

data mtcollins1_fan_capture_run_id: String = "41406891344"
data mtcollins1_fan_capture_dispatch: String = "fleet-converge.yml --ref main -f mode=mtcollins1_fan_observe -f host=srv1"
data mtcollins1_fan_capture_artifact_name: String = "mtcollins1-fan-observation"
data mtcollins1_fan_capture_artifact_path: String = "artifacts/bmc/mtcollins1-fan-observe-run-41406891344-host-off/mtcollins1-fan-observation.txt"
data mtcollins1_fan_capture_artifact_sha256: String = "4f418a57e1a249a5f0178e36b862106ba83039881cde7be7fa25f26bb2855337"
data mtcollins1_fan_capture_artifact_bytes: Int = 144775
// The receipt's own run-scope marker line was `run=0 verbose_exit=0`; the parse below is allowed only
// because the read itself succeeded, so the exit status is carried rather than assumed.
data mtcollins1_fan_capture_exit_code: Int = 0
// The four records the boot-5 gate refused, as the tool printed them, in repository order, PLUS one
// threshold record taken from the same read. The
// threshold record is here so the REFUSAL direction of the classifier is grounded in real bytes too:
// a rule that refused only invented rows and admitted invented ones would pass either way.
data mtcollins1_fan_capture_repository_lines: List<String> = [
  // PSU2_Status -- verbatim from the committed artifact
  "Sensor ID              : PSU2_Status (0xeb)",
  " Entity ID             : 0.0 (Unspecified)",
  " Sensor Type (Discrete): Power Supply (0x08)",
  " Sensor Reading        : 0h",
  " Event Message Control : Entire Sensor Only",
  " Assertions Enabled    : Power Supply",
  "                         [Presence detected]",
  "                         [Failure detected]",
  "                         [Predictive failure]",
  "                         [Power Supply AC lost]",
  "                         [AC lost or out-of-range]",
  "                         [AC out-of-range, but present]",
  "                         [Config Error]",
  "                         [Power Supply Inactive]",
  " Deassertions Enabled  : Power Supply",
  "                         [Presence detected]",
  "                         [Failure detected]",
  "                         [Predictive failure]",
  "                         [Power Supply AC lost]",
  "                         [AC lost or out-of-range]",
  "                         [AC out-of-range, but present]",
  "                         [Config Error]",
  "                         [Power Supply Inactive]",
  " OEM                   : 0",
  // Watchdog2 -- verbatim from the committed artifact
  "Sensor ID              : Watchdog2 (0xd7)",
  " Entity ID             : 33.0 (System Management Software)",
  " Sensor Type (Discrete): Watchdog2 (0x23)",
  " Sensor Reading        : 0h",
  " Event Message Control : Per-threshold",
  " Assertions Enabled    : Watchdog2",
  "                         [Timer expired]",
  "                         [Hard reset]",
  "                         [Power down]",
  "                         [Power cycle]",
  "                         [reserved]",
  "                         [reserved]",
  "                         [reserved]",
  "                         [reserved]",
  "                         [Timer interrupt]",
  " OEM                   : 0",
  // EndOfPost -- verbatim from the committed artifact
  "Sensor ID              : EndOfPost (0xe2)",
  " Entity ID             : 6.2 (System Management Module)",
  " Sensor Type (Discrete): Unknown (0xd0)",
  " Sensor Reading        : 0h",
  " Event Message Control : Per-threshold",
  " OEM                   : 0",
  // Event_log -- verbatim from the committed artifact
  "Sensor ID              : Event_log (0xd6)",
  " Entity ID             : 6.2 (System Management Module)",
  " Sensor Type (Discrete): Event Logging Disabled (0x10)",
  " Sensor Reading        : 0h",
  " Event Message Control : Per-threshold",
  " Assertions Enabled    : Event Logging Disabled",
  "                         [Log area reset/cleared]",
  "                         [Log full]",
  "                         [Log almost full]",
  " OEM                   : 0",
  // CPU0_SOC_Temp -- the THRESHOLD control, verbatim: the same parser must call this one threshold
  "Sensor ID              : CPU0_SOC_Temp (0x3d)",
  " Entity ID             : 30.15 (Cooling Unit)",
  " Sensor Type (Threshold)  : Temperature (0x01)",
  " Sensor Reading        : No Reading",
  " Status                : Not Available",
  " Nominal Reading       : 30.000",
  " Normal Minimum        : 25.000",
  " Normal Maximum        : 35.000",
  " Upper critical        : 105.000",
  " Upper non-critical    : 100.000",
  " Positive Hysteresis   : Unspecified",
  " Negative Hysteresis   : Unspecified",
  " Minimum sensor range  : Unspecified",
  " Maximum sensor range  : 127.000",
  " Event Message Control : Per-threshold",
  " Readable Thresholds   : unc ucr ",
  " Settable Thresholds   : unc ucr ",
  " Threshold Read Mask   : lnr lcr lnc unc ucr unr ",
  " Event Status          : Unavailable",
  " Assertions Enabled    : lnc- lcr- lnr+ unc+ ucr- unr+ ",
  " Deassertions Enabled  : lnc- lcr- lnr+ unc+ ucr- unr+ ",
]

data mtcollins1_fan_capture_read_obligation: NonEmptyStr = "re-run fleet-converge.yml mode=mtcollins1_fan_observe host=srv1 and commit the verbose SDR repository read; until then nothing is typed and the four rows stay refused"

// The readout the live path would produce from these bytes: the SAME parser, so a capture that does not
// parse is refused here exactly as it would be refused on the machine.
fn mtcollins1_fan_capture_readout() -> SdrVerboseReadout {
  sdr_verbose_readout(success: (mtcollins1_fan_capture_exit_code == 0), stdout: join(mtcollins1_fan_capture_repository_lines, "\n"))
}

fn mtcollins1_fan_capture_records() -> List<SdrVerboseRecord> {
  match mtcollins1_fan_capture_readout() {
    SdrVerboseRead { records: recs } => recs
    SdrVerboseEmptyRepository => []
    SdrVerboseUnreadable => []
  }
}

// THE FOLD, AND WHAT IT CANNOT CLAIM FROM IN HERE.
//
// WHETHER A READOUT TYPES THESE ROWS AT ALL.
//
// The verdict comes from the SHARED PARSER AND CLASSIFIER EXECUTING ON THE BYTES - the same
// sdr_verbose_readout the live boot path runs on the tool's stdout, and the same classifier that decides
// the rows - so it is a computation over data, not a number compared against a copy of itself
// (DESIGN.md §5's oracle rule: a check between two literals in one file can only fail by someone editing
// a declaration). It requires the repository to have met BOTH sides of ipmi_sdr.h:427 at be11d948, one
// threshold record and one not: bytes that never met that distinction cannot type the rows.
//
// It returns a Bool and constructs no authority of any kind, which is what lets the witnesses hand it
// readouts they build themselves - a failed read, an empty repository, the threshold-only subset - and
// watch each one refuse.
fn mtcollins1_fan_capture_types_the_rows(readout: SdrVerboseReadout) -> Bool {
  match readout {
    SdrVerboseRead { records: recs } => sdr_repository_carries_both_kinds(records: recs)
    // An empty repository types nothing, and a FAILED read is not an empty repository. Both say no.
    SdrVerboseEmptyRepository => false
    SdrVerboseUnreadable => false
  }
}
