//module: gunbc.machine_intake.bmc_secure_redfish_frontier
//purpose: the §3c consumer frontiers for the Redfish account-service surface of gunbc.bmc_model's BmcWorld. The
//  shapes and the world exist (items 1+2 of the BMC credential-rotation lane); the DRY REALIZATIONS that read and
//  write them (item 3: the dry Redfish account read reaching the census, and the dry apply realizing
//  RedfishAccountPasswordWrite) land in gunbc.machine_intake.bmc_secure after PR 1b-i (the board-join / single-approval
//  refactor) merges. Each row binds its dissolution to a declaration that DOES NOT EXIST YET: the std.dissolution
//  DeclarationAppears trigger reads Pending while absent and FIRES (refusing gunbc.dissolution_census) the day the
//  consumer lands -- until the row is deleted, in that change. This is what the bmc_recovery_route_frontier precedent
//  calls "the contract for what has to be added": a consumer cannot arrive and leave the surface unclaimed.
//why-not-upstream: an obligation to wire OUR dry realization, in OUR namespace, against OUR Redfish world surface.
//  extdeps.bmc.redfish carries the vendor's served shapes and has no obligation to be read by anything.
//consumes: gunbc.bmc_model (the Redfish surface entries that have no production consumer yet), std.roster_frontier,
//  std.decl_ref, std.dissolution.
//referenced-by: nothing; the roster fold that read it (gunbc.census_closure_frontier) was retired.
//invariants: every subject resolves to a declaration gunbc.bmc_model or extdeps.bmc.redfish declares (the world
//  surface entries and the extdeps wire readers respectively); every trigger resolves to a declaration
//  gunbc.machine_intake.bmc_secure does NOT declare yet; every trigger module is bmc_secure; deleting or renaming a
//  Redfish surface entry or wire reader reddens the witness that reads these rows, not a comment.

module gunbc.machine_intake.bmc_secure_redfish_frontier

import std.dissolution { bound_dissolution }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.decl_ref { decl_ref }

// The module whose dry realizations are this surface's declared consumer. The item-3 change extends
// gunbc.machine_intake.bmc_secure's dry read/apply (dry_read_bmc_account_state / dry_apply_bmc_account_plan) with the
// Redfish realizations named below; the trigger names are the contract item 3 must mint, so the witness pins them
// rather than letting a differently-named consumer strand a pending row.
data bmc_secure_redfish_trigger_module: String = "gunbc.machine_intake.bmc_secure"

// The read-side realization: the dry Redfish account read that reaches the world's census and authenticates through
// it (the 403-forced / 401 / 200 outcome, and the failed-login count a wrong password drives). Consumes the typed
// surface read, the auth outcome, and the failed-login counter.
data bmc_secure_redfish_read_realization: String = "dry_read_bmc_redfish_account_census"

// The write-side realization: the dry apply that realizes RedfishAccountPasswordWrite, clearing the forced-change
// flag on the written account (and, where the account shares one controller credential with IPMI, moving the one
// store). Consumes bmc_redfish_change_password.
data bmc_secure_redfish_write_realization: String = "dry_apply_bmc_redfish_password_write"

// THE READ-SIDE SURFACE. bmc_redfish_surface is the typed read that keeps "the controller serves no Redfish account
// service" (the world field is none) separate from "it serves one and it lists no accounts" (Present { [] }): a read
// that collapsed the two would report an unmodeled controller as a managed-but-empty one, the false-green this whole
// lane exists to refuse. bmc_redfish_authorize turns (account, password, request kind) into the 200 / 401 / 403-forced
// outcome the dry read returns. bmc_redfish_note_failed_login counts a failed login and applies the caller-supplied
// typed threshold (the world counts failures and locks; it does NOT own the served threshold -- the lockout lane
// declares the served AccountService shape, and the 0-means-never conversion belongs at that extdeps wire boundary,
// not here). All three have NO production consumer until the item-3 read realizes them over Redfish.
fn bmc_secure_redfish_read_consumer_frontier_rows() -> List<FrontierRow> {
  let reason = "the Redfish account-service surface of the dry BmcWorld is modeled (shapes in extdeps.bmc.redfish, the world and its auth/counter in gunbc.bmc_model); its DRY consumer is item 3's Redfish account read realization in gunbc.machine_intake.bmc_secure, which lands after PR 1b-i (the board-join / single-approval refactor) merges and does not exist yet."
  [
    frontier_row_decl(
      ref: decl_ref(module_path: "gunbc.bmc_model", decl_name: "bmc_redfish_surface"),
      reason: reason,
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_read_realization)),
    ),
    frontier_row_decl(
      ref: decl_ref(module_path: "gunbc.bmc_model", decl_name: "bmc_redfish_authorize"),
      reason: reason,
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_read_realization)),
    ),
    frontier_row_decl(
      ref: decl_ref(module_path: "gunbc.bmc_model", decl_name: "bmc_redfish_note_failed_login"),
      reason: reason,
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_read_realization)),
    ),
  ]
}

// THE WRITE-SIDE SURFACE. bmc_redfish_change_password applies the PATCH that clears an account's forced-change flag
// (and, for a SharesIpmi account, is the single write that moves the one controller credential both surfaces read).
// It has no production consumer until item 3's dry apply realizes RedfishAccountPasswordWrite over it -- today that
// action shape returns an incomplete dry step (the IPMI-only fold), which is the frontier this row records.
fn bmc_secure_redfish_write_consumer_frontier_rows() -> List<FrontierRow> {
  [
    frontier_row_decl(
      ref: decl_ref(module_path: "gunbc.bmc_model", decl_name: "bmc_redfish_change_password"),
      reason: "the Redfish password PATCH that clears the forced-change flag is modeled in gunbc.bmc_model; its DRY consumer is item 3's RedfishAccountPasswordWrite realization in gunbc.machine_intake.bmc_secure (dry_apply_bmc_account_plan's Redfish arm, incomplete today), landing after PR 1b-i.",
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_write_realization)),
    ),
  ]
}

// THE EXTDEPS WIRE READERS. These parse the served Redfish wire shapes (the ManagerAccountCollection envelope,
// each ManagerAccount member, the member @odata.id tail, the RoleId reading, the Password PATCH body). Their only
// call sites today are the item-1 shapes witness -- a check of the shapes, not the RUN consumer DESIGN 3c asks
// for -- so these rows name item 3's dry realizations as the consumer that retires them rather than leaving the
// readers dangling. They are upstream decomposition (DESIGN 3): our code reads the vendor's served shape, and the
// obligation to read it is ours, in bmc_secure.
fn bmc_secure_redfish_extdeps_consumer_frontier_rows() -> List<FrontierRow> {
  let read_reason = "the served Redfish wire shape is read (extdeps.bmc.redfish); its DRY consumer is item 3's Redfish account census read (dry_read_bmc_redfish_account_census) in gunbc.machine_intake.bmc_secure, which parses the collection and its members through this reader, landing after PR 1b-i merges and not existing yet."
  [
    frontier_row_decl(
      ref: decl_ref(module_path: "extdeps.bmc.redfish", decl_name: "redfish_manager_account_collection_from_json"),
      reason: read_reason,
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_read_realization)),
    ),
    frontier_row_decl(
      ref: decl_ref(module_path: "extdeps.bmc.redfish", decl_name: "redfish_manager_account_from_json"),
      reason: read_reason,
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_read_realization)),
    ),
    frontier_row_decl(
      ref: decl_ref(module_path: "extdeps.bmc.redfish", decl_name: "redfish_manager_account_name_from_odata_id"),
      reason: read_reason,
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_read_realization)),
    ),
    frontier_row_decl(
      ref: decl_ref(module_path: "extdeps.bmc.redfish", decl_name: "RedfishAccountCollectionRead"),
      reason: read_reason,
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_read_realization)),
    ),
    frontier_row_decl(
      ref: decl_ref(module_path: "extdeps.bmc.redfish", decl_name: "RedfishRoleIdRead"),
      reason: read_reason,
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_read_realization)),
    ),
    frontier_row_decl(
      ref: decl_ref(module_path: "extdeps.bmc.redfish", decl_name: "redfish_account_password_patch_body"),
      reason: "the Password PATCH body is built in extdeps.bmc.redfish; its DRY consumer is item 3's RedfishAccountPasswordWrite realization (dry_apply_bmc_redfish_password_write) in gunbc.machine_intake.bmc_secure, landing after PR 1b-i merges and not existing yet.",
      dissolution: bound_dissolution(ref: decl_ref(module_path: bmc_secure_redfish_trigger_module, decl_name: bmc_secure_redfish_write_realization)),
    ),
  ]
}

fn bmc_secure_redfish_consumer_frontier_rows() -> List<FrontierRow> {
  concat(
    bmc_secure_redfish_read_consumer_frontier_rows(),
    concat(
      bmc_secure_redfish_write_consumer_frontier_rows(),
      bmc_secure_redfish_extdeps_consumer_frontier_rows(),
    ),
  )
}
