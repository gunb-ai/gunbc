module gunbc.machine_intake_mtcollins1_boot_authorization

import std.types { Bool, List, NonEmptyStr, String }
import std.content_hash { ContentHash, content_hash_of_value }
import std.effect_grant { NamespacePosition, ServiceOpTree, Write }
import std.scoped_authorization {
  AuthorizedAction,
  AttemptIdentity,
  AuthorizationScope,
  AuthorizationRequest,
}
import gunbc.machine_intake_mtcollins1_boot_artifact { mtcollins1_diskless_image_name, mtcollins1_boot_export_dir }
import gunbc.machine_intake_mtcollins1_boot_image_fetch { mtcollins1_boot_image_sha256 }
import gunbc.machine_intake_mtcollins1_census_image { mtcollins1_census_image_input }
import extdeps.provisioning.ubuntu_seeded_install_media { ubuntu_seeded_install_media_built }
import gunbc.machine_intake_mtcollins1_actuate { mtcollins1_power_action, mtcollins1_cdrom_selection }
import gunbc.machine_intake_mtcollins1_access_observation { mtcollins1_endpoint }
import gunbc.fleet_intent_network { operator_host_srv2 }
import extdeps.bmc.ipmi_boot_selection {
  IpmiBootSelection,
  ipmi_boot_selection_label,
}
import extdeps.toolchain.types { architecture_diagnostic_name }

type MtCollins1BootSubject {
  machine: NonEmptyStr
  bmc_host: NonEmptyStr
  image_name: NonEmptyStr
  image_sha256: NonEmptyStr
  export_host: NonEmptyStr
  export_dir: NonEmptyStr
  selection: IpmiBootSelection
  power_action: NonEmptyStr
  execution_revision: NonEmptyStr
}

data mtcollins1_boot_machine: NonEmptyStr = "mtcollins1"

// WHICH MEDIUM THIS BOOT ATTACHES IS ONE ROW, and the signed subject, the attach and the terminal
// verdict all derive from it. It was three facts before: the subject and the attach read the stock
// pins from their owners while the verdict named the census medium's label, so a run could hold the
// grant, take the SOL lease and power the unit only to time out on a terminal the attached medium
// could never print (review 69352). The stock arm carries no fields because its identity is owned
// upstream (gunbc.machine_intake_mtcollins1_boot_artifact, gunbc.machine_intake_mtcollins1_boot_image_fetch);
// the census arm carries the built image's name and digest, which exist only once census stage 0B/0C
// has published it -- so switching this row IS census stage 0D, and until then the census verdict
// refuses at the gate rather than after a hardware run.
type MtCollins1BootMedium
  = MtCollins1StockInstallerMedium
  | MtCollins1CensusMedium { output_digest: NonEmptyStr }

data mtcollins1_boot_medium: MtCollins1BootMedium = MtCollins1StockInstallerMedium

// THE CENSUS ARM AUTHORS ONE FACT, THE MEASURED OUTPUT DIGEST from the publish receipt. The image name
// derives from that digest through the same build input that owns the census volume id
// (gunbc.machine_intake_mtcollins1_census_image mtcollins1_census_image_input), so a census arm naming
// a stock installer, or any artifact but the census image, has no spelling: the row cannot disagree
// with the label the verdict binds to (review 5261662425). The published file's name is its digest,
// so the digest is also the sha256 the signed subject and the attach carry.
fn mtcollins1_boot_medium_image_name(medium: MtCollins1BootMedium) -> NonEmptyStr {
  match medium {
    MtCollins1StockInstallerMedium => mtcollins1_diskless_image_name
    MtCollins1CensusMedium { output_digest: d } =>
      ubuntu_seeded_install_media_built(input: mtcollins1_census_image_input, output_digest: d).image_name
  }
}

fn mtcollins1_boot_medium_image_sha256(medium: MtCollins1BootMedium) -> NonEmptyStr {
  match medium {
    MtCollins1StockInstallerMedium => mtcollins1_boot_image_sha256
    MtCollins1CensusMedium { output_digest: d } => d
  }
}

fn mtcollins1_boot_medium_label(medium: MtCollins1BootMedium) -> NonEmptyStr? {
  match medium {
    MtCollins1StockInstallerMedium => none
    MtCollins1CensusMedium { output_digest: _ } => Present { value: mtcollins1_census_image_input.volume_id }
  }
}

fn mtcollins1_boot_subject_for(medium: MtCollins1BootMedium, execution_revision: NonEmptyStr) -> MtCollins1BootSubject {
  MtCollins1BootSubject {
    machine: mtcollins1_boot_machine,
    bmc_host: mtcollins1_endpoint.host,
    image_name: mtcollins1_boot_medium_image_name(medium: medium),
    image_sha256: mtcollins1_boot_medium_image_sha256(medium: medium),
    export_host: operator_host_srv2 as NonEmptyStr,
    export_dir: mtcollins1_boot_export_dir,
    selection: mtcollins1_cdrom_selection,
    power_action: mtcollins1_power_action,
    execution_revision: execution_revision,
  }
}

fn mtcollins1_boot_subject(execution_revision: NonEmptyStr) -> MtCollins1BootSubject {
  mtcollins1_boot_subject_for(medium: mtcollins1_boot_medium, execution_revision: execution_revision)
}

data mtcollins1_virtual_media_resource: NamespacePosition = NamespacePosition {
  tree: ServiceOpTree { service: "megarac" },
  path: ["media", "remote-image"],
}

data mtcollins1_virtual_media_scope: AuthorizationScope = AuthorizationScope {
  verb: Write,
  resource: mtcollins1_virtual_media_resource,
  action: "megarac.virtual-media.attach" as AuthorizedAction,
}

data mtcollins1_ipmi_boot_resource: NamespacePosition = NamespacePosition {
  tree: ServiceOpTree { service: "ipmi" },
  path: ["chassis", "bootdev"],
}

data mtcollins1_ipmi_boot_scope: AuthorizationScope = AuthorizationScope {
  verb: Write,
  resource: mtcollins1_ipmi_boot_resource,
  action: "ipmi.chassis.bootdev.set" as AuthorizedAction,
}

data mtcollins1_ipmi_power_resource: NamespacePosition = NamespacePosition {
  tree: ServiceOpTree { service: "ipmi" },
  path: ["chassis", "power"],
}

data mtcollins1_ipmi_power_scope: AuthorizationScope = AuthorizationScope {
  verb: Write,
  resource: mtcollins1_ipmi_power_resource,
  action: "ipmi.chassis.power.cycle" as AuthorizedAction,
}

data mtcollins1_boot_required_scopes: List<AuthorizationScope> = [
  mtcollins1_virtual_media_scope,
  mtcollins1_ipmi_boot_scope,
  mtcollins1_ipmi_power_scope,
]

fn mtcollins1_boot_intent_hash(subject: MtCollins1BootSubject) -> ContentHash {
  content_hash_of_value(
    value: join([
      subject.machine as String,
      subject.bmc_host as String,
      subject.image_name as String,
      subject.image_sha256 as String,
      subject.export_host as String,
      subject.export_dir as String,
      architecture_diagnostic_name(arch: subject.selection.architecture) as String,
      ipmi_boot_selection_label(selection: subject.selection) as String,
      subject.power_action as String,
      subject.execution_revision as String,
    ], "|") as NonEmptyStr,
  )
}

data mtcollins1_boot_purpose: NonEmptyStr = "Attach the diskless Ubuntu live image already exported on srv2 to Mt. Collins unit 1 over BMC virtual media, set one-shot CD boot, and power-cycle the host. This interrupts anything the unit is currently running." as NonEmptyStr

fn mtcollins1_boot_authorization_request(
  escalation_id: NonEmptyStr,
  attempt: AttemptIdentity,
  execution_revision: NonEmptyStr,
) -> AuthorizationRequest<MtCollins1BootSubject> {
  let subject = mtcollins1_boot_subject(execution_revision: execution_revision)
  AuthorizationRequest {
    escalation_id: escalation_id,
    scopes: mtcollins1_boot_required_scopes,
    subject: subject,
    purpose: mtcollins1_boot_purpose,
    attempt: attempt,
    intent_hash: mtcollins1_boot_intent_hash(subject: subject),
    destructive: true,
  }
}

// THE GATE IS THE SHARED ONE. The operator's decision over this subject is read through
// gunbc.auth.approval_gate, generic over the subject: ApprovalGate<MtCollins1BootSubject> and
// approval_gate_from_poll, admitted live at the observed instant. Nothing about the gate is a fact
// about Mt. Collins, so nothing about it is declared here.


