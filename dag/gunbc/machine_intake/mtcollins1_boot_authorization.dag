module gunbc.machine_intake_mtcollins1_boot_authorization

import std.types { NonEmptyStr, String }
import gunbc.machine_intake_mtcollins1_boot_artifact { mtcollins1_diskless_image_name, mtcollins1_boot_export_dir }
import gunbc.machine_intake_mtcollins1_boot_image_fetch { mtcollins1_boot_image_sha256 }
import gunbc.machine_intake_mtcollins1_census_image { mtcollins1_census_image_stem, mtcollins1_census_volume_id }
import extdeps.provisioning.ubuntu_seeded_install_media { ubuntu_seeded_install_media_image_name }
import gunbc.machine_intake_mtcollins1_actuate { mtcollins1_cdrom_selection }
import gunbc.machine_intake_mtcollins1_access_observation { mtcollins1_endpoint }
import gunbc.fleet_intent_network { operator_host_srv2 }
import extdeps.bmc.ipmi_boot_selection { IpmiBootSelection }

// THE BOOT SUBJECT: what one Mt. Collins boot attaches, selects and power-cycles. It was the signed
// subject of a per-run operator approval until the operator ruling of 2026-09-23 made the boot a
// recurring automated effect under workload identity (gunbc.auth.privileged_effect_census); it
// remains the one record the attach, the handoff and the terminal verdict all read, and the
// physical-safety interlock the approval implicitly provided is
// gunbc.managed_host_unit_hold.
type MtCollins1BootSubject {
  machine: NonEmptyStr
  bmc_host: NonEmptyStr
  image_name: NonEmptyStr
  image_sha256: NonEmptyStr
  export_host: NonEmptyStr
  export_dir: NonEmptyStr
  selection: IpmiBootSelection
  execution_revision: NonEmptyStr
}

data mtcollins1_boot_machine: NonEmptyStr = "mtcollins1"

// WHICH MEDIUM THIS BOOT ATTACHES IS ONE ROW, and the signed subject, the attach and the terminal
// verdict all derive from it. It was three facts before: the subject and the attach read the stock
// pins from their owners while the verdict named the census medium's label, so a run could hold the
// grant, take the SOL lease and power the unit only to time out on a terminal the attached medium
// could never print (review 69352). The stock arm carries no fields because its identity is owned
// upstream (gunbc.machine_intake_mtcollins1_boot_artifact, gunbc.machine_intake_mtcollins1_boot_image_fetch);
// the census arm carries the built image's name and digest, which exist only once census stage 0B/0C
// has published it -- so switching this row IS census stage 0D, and until then the census verdict
// refuses at the gate rather than after a hardware run.
type MtCollins1BootMedium
  = MtCollins1StockInstallerMedium
  | MtCollins1CensusMedium { output_digest: NonEmptyStr }

// CENSUS STAGE 0D. The digest is the publish receipt of the gated create-only publication run
// 36651495873 (main, fleet SSH to srv2 as gunbc-fleet; receipt artifact sha256
// ca40bf02982bb1dd71d9adf4663aa74e97b99b03109d9c8626dc9ff53f9ddbcf): gate (a) the srv2 rebuild of the
// pinned-input derivation equalled the hermetic receipt eb23f174..., gate (b) the rebuilt vmlinuz and
// initrd equalled stock; image_name gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-161b98b9bb389a80.iso,
// build_key c001ac127d718e72, published_path
// /srv/bmc/gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-161b98b9bb389a80.iso. Repinned because #12594
// bumped builder_revision, so the previous image (30ca88d4..., build_key 8d357a525f078cb4) no longer
// describes the current derivation and the boot refuses it (run 36660907341). This row is
// publication-time evidence only: mtcollins1_census_medium_readback re-measures the served path on
// srv2 before the signed subject is minted, every run.
data mtcollins1_boot_medium: MtCollins1BootMedium = MtCollins1CensusMedium {
  output_digest: "161b98b9bb389a803805b582203fe73fa9a3ec421e3783b6463528124c2bd513",
}

// THE CENSUS ARM AUTHORS ONE FACT, THE MEASURED OUTPUT DIGEST from the publish receipt. The image name
// derives from that digest through the same stem row the census build input is built from, and the
// label is the same volume-id row (gunbc.machine_intake_mtcollins1_census_image
// mtcollins1_census_image_stem, mtcollins1_census_volume_id), so a census arm naming a stock
// installer, or any artifact but the census image, has no spelling: the row cannot disagree with the
// label the verdict binds to (review 5261662425). Neither fact is seeded content, so neither waits on
// the derivation that renders the seed. The published file's name is its digest, so the digest is
// also the sha256 the signed subject and the attach carry.
fn mtcollins1_boot_medium_image_name(medium: MtCollins1BootMedium) -> NonEmptyStr {
  match medium {
    MtCollins1StockInstallerMedium => mtcollins1_diskless_image_name
    MtCollins1CensusMedium { output_digest: d } =>
      ubuntu_seeded_install_media_image_name(image_stem: mtcollins1_census_image_stem, output_digest: d)
  }
}

fn mtcollins1_boot_medium_image_sha256(medium: MtCollins1BootMedium) -> NonEmptyStr {
  match medium {
    MtCollins1StockInstallerMedium => mtcollins1_boot_image_sha256
    MtCollins1CensusMedium { output_digest: d } => d
  }
}

fn mtcollins1_boot_medium_label(medium: MtCollins1BootMedium) -> NonEmptyStr? {
  match medium {
    MtCollins1StockInstallerMedium => none
    MtCollins1CensusMedium { output_digest: _ } => Present { value: mtcollins1_census_volume_id }
  }
}

fn mtcollins1_boot_subject_for(medium: MtCollins1BootMedium, execution_revision: NonEmptyStr) -> MtCollins1BootSubject {
  MtCollins1BootSubject {
    machine: mtcollins1_boot_machine,
    bmc_host: mtcollins1_endpoint.host,
    image_name: mtcollins1_boot_medium_image_name(medium: medium),
    image_sha256: mtcollins1_boot_medium_image_sha256(medium: medium),
    export_host: operator_host_srv2 as NonEmptyStr,
    export_dir: mtcollins1_boot_export_dir,
    selection: mtcollins1_cdrom_selection,
    execution_revision: execution_revision,
  }
}

fn mtcollins1_boot_subject(execution_revision: NonEmptyStr) -> MtCollins1BootSubject {
  mtcollins1_boot_subject_for(medium: mtcollins1_boot_medium, execution_revision: execution_revision)
}
