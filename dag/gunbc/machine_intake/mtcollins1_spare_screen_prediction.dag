module gunbc.machine_intake_mtcollins1_spare_screen_prediction

import std.types { Bool, CommitSha, FilePath, List, Milliseconds, NonEmptyStr }
import std.claim_evidence { Claim, ClaimId, RecordedFact, RecordedFactId }
import std.decl_ref { decl_ref }
import gunbc.cli_wire { CliWireResponse }
import gunbc.machine_intake_predictive_review_render { predictive_review_cli }
import std.measure { Milliwatt, milliwatt, milliwatt_count }
import extdeps.ampere.mt_collins_product_brief.memory_population {
  MtCollinsDimmPopulationRow, mt_collins_population_16_dimms,
}
import std.predictive_claim {
  Prediction, PredictionRestriction, AdversarialTestingObligation, PostOutcomePredictionArchive,
  ApproximatePredictionWindow, ConfoundedMechanisms,
  PredictiveModel, PredictiveModelResult, PredictiveModelAccepted, PredictiveModelRefused,
  PredictiveClaimRefusal, PredictiveStanding, PredictiveNextObligation,
  begin_predictive_model, record_archived_prediction_test, narrow_predictive_model,
  predictive_standing, predictive_next_obligation,
}

// The exact choice of sixteen out of seventeen spares was not recorded. The population SHAPE
// is enumerated, but calling this a serial-number-bound module manifest would invent evidence.
type ScreenModuleSelection
  = OriginalSixteenReported
  | SixteenOfSeventeenSparesSelectionUnrecorded

type SpareScreenConfiguration {
  population: MtCollinsDimmPopulationRow
  modules: ScreenModuleSelection
}

type SpareScreenOutcome
  = TrainingAndPostObserved
  | RestartInsideDeclaredWindow
  | SpareScreenOutcomeUnknown

type SpareScreenOutcomeReport {
  message_id: NonEmptyStr
  restart_after_power_on: Milliseconds
  oem_payload_quotation: NonEmptyStr
  socket0_memory_power: Milliwatt
  socket1_memory_power: Milliwatt
  original_each_socket_memory_power: Milliwatt
  original_reported_clean_duration: Milliseconds
}

data spare_screen_outcome_report: SpareScreenOutcomeReport = SpareScreenOutcomeReport {
  message_id: "msg_94eec616-48b9-4776-ab41-346cc60de19d",
  restart_after_power_on: 290000,
  oem_payload_quotation: "0fde70331102",
  socket0_memory_power: milliwatt(count: 0),
  socket1_memory_power: milliwatt(count: 800),
  original_each_socket_memory_power: milliwatt(count: 8000),
  original_reported_clean_duration: 750000,
}

data spare_screen_prediction_commit: CommitSha = "a47ce298890ac8dca72cda501b8a1225fcb740ec" as CommitSha
data spare_screen_prediction_artifact: FilePath = "docs/probes/mtcollins1_spare_module_screen_prediction_2026-09-11.md" as FilePath

// The original object became detached from the author's branch. This evidence tag archives the
// unchanged object AFTER the outcome; it does not establish pre-outcome publication ordering.
// Read the file AT spare_screen_prediction_commit, not as a path in the current source tree.
data spare_screen_prediction_archive: NonEmptyStr = "Original commit archived after the outcome at gunb-ai/gunbc refs/tags/evidence/mtcollins1-spare-screen-a47ce298890. Fetch that ref, then read docs/probes/mtcollins1_spare_module_screen_prediction_2026-09-11.md at a47ce298890ac8dca72cda501b8a1225fcb740ec. Archival publication is not a witnessed preregistration. Artifact: https://github.com/gunb-ai/gunbc/blob/a47ce298890ac8dca72cda501b8a1225fcb740ec/docs/probes/mtcollins1_spare_module_screen_prediction_2026-09-11.md"


// Source: parent correction msg_ad6e1573-f92d-474b-84af-28bc36c41dfe. The original
// and amended Git trees agree, but identity and committer time changed. Neither author time nor
// testimony is an independently witnessed publication/start ordering.
type SpareScreenIdentityCorrection {
  message_id: NonEmptyStr
  originally_reported_commit: CommitSha
  amended_published_commit: CommitSha
  author_time_quotation: NonEmptyStr
  committer_time_quotation: NonEmptyStr
  ordering_testimony: NonEmptyStr
  mixed_commit_content: NonEmptyStr
}

data spare_screen_identity_correction: SpareScreenIdentityCorrection = SpareScreenIdentityCorrection {
  message_id: "msg_ad6e1573-f92d-474b-84af-28bc36c41dfe",
  originally_reported_commit: spare_screen_prediction_commit,
  amended_published_commit: "e72f8930cf647ef15abed0da676853e2c3ce51c2" as CommitSha,
  author_time_quotation: "2026-09-11T23:41:21Z",
  committer_time_quotation: "2026-09-11T23:45:19Z",
  ordering_testimony: "The parent asserts the content was committed before installation, which began after 23:45Z, with outcome at 23:52:13Z. This is testimony plus an amended object, not independently witnessed ordering.",
  mixed_commit_content: "The commit carries the prediction document together with the review-64125 Mt. Jade refusal fix; it does not isolate prediction publication from unrelated work.",
}

fn spare_screen_archive_receipt() -> PostOutcomePredictionArchive {
  PostOutcomePredictionArchive {
    commit: spare_screen_identity_correction.originally_reported_commit,
    artifact: spare_screen_prediction_artifact,
    archive_ref: "refs/tags/evidence/mtcollins1-spare-screen-a47ce298890",
    identity_history: concat("Originally cited identity was detached and unpublished; amended published identity is ", spare_screen_identity_correction.amended_published_commit),
    report: decl_ref(module_path: "gunbc.machine_intake_mtcollins1_spare_screen_prediction", decl_name: "spare_screen_identity_correction"),
  }
}

data spare_screen_configuration: SpareScreenConfiguration = SpareScreenConfiguration {
  population: mt_collins_population_16_dimms,
  modules: SixteenOfSeventeenSparesSelectionUnrecorded,
}

data original_screen_configuration: SpareScreenConfiguration = SpareScreenConfiguration {
  population: mt_collins_population_16_dimms,
  modules: OriginalSixteenReported,
}

data spare_screen_testing_obligation: AdversarialTestingObligation = AdversarialTestingObligation {
  owner: decl_ref(module_path: "gunbc.machine_intake_mtcollins1_spare_screen_prediction", decl_name: "spare_screen_prediction_review"),
  next_discriminator: "Commit the next exact module selection and its falsifier before changing hardware; vary one module against the reported original-set baseline. Retain independently witnessed recording/start/outcome order. A faulty spare and an intolerant cross-channel combination remain alternatives; sixteen simultaneous substitutions identify neither. Re-test the narrowed original-set prediction rather than treating its prior clean run as a prospective test of the new revision.",
}

// Named parameter typing is forced by generic_lambda_parameter_receiver_evidence_stall.
fn spare_screen_shape_in_prediction(configuration: SpareScreenConfiguration) -> Bool {
  configuration.population.dimm_count == mt_collins_population_16_dimms.dimm_count
    && configuration.population.connectors == mt_collins_population_16_dimms.connectors
}

fn original_screen_cohort_in_prediction(configuration: SpareScreenConfiguration) -> Bool {
  match configuration.modules {
    OriginalSixteenReported => true
    SixteenOfSeventeenSparesSelectionUnrecorded => false
  }
}

fn spare_screen_prediction() -> Prediction<SpareScreenConfiguration, SpareScreenOutcome> {
  Prediction {
    claim: Claim {
      id: "mtcollins1-supported-shape-suffices-v1" as ClaimId,
      subject: decl_ref(module_path: "gunbc.machine_intake_mtcollins1_access_observation", decl_name: "mtcollins1_identity"),
      target: decl_ref(module_path: "gunbc.machine_intake_mtcollins1_spare_screen_prediction", decl_name: "SpareScreenOutcome"),
      proposition: TrainingAndPostObserved,
      scope: [PredictionRestriction {
        reason: "The same Table 11 16-DIMM shape: odd connectors, one module per channel, eight channels per socket.",
        admits: spare_screen_shape_in_prediction,
      }],
      bound: ApproximatePredictionWindow { duration: 311000 },
    },
    statement: "The committed spare-module screen predicts training and POST from the supported 16-DIMM shape. It treats that shape as sufficient despite the unqualified different-channel rank combination.",
    factual_basis: decl_ref(module_path: "extdeps.ampere.mt_collins_product_brief.memory_population", decl_name: "mt_collins_population_16_dimms"),
    further_factual_basis: [
      decl_ref(module_path: "extdeps.ocp.mt_jade.memory_mixing", decl_name: "mt_jade_same_channel_mixing_row"),
      decl_ref(module_path: "extdeps.ocp.mt_jade.memory_mixing", decl_name: "mt_jade_different_channel_mixing_row"),
    ],
    falsifier: RestartInsideDeclaredWindow,
    obligation: spare_screen_testing_obligation,
  }
}

fn falsified_spare_screen_model() -> PredictiveModelResult<SpareScreenConfiguration, SpareScreenOutcome> {
  match begin_predictive_model(prediction: spare_screen_prediction()) {
    PredictiveModelRefused { cause: cause } => PredictiveModelRefused { cause: cause }
    PredictiveModelAccepted { model: model } => record_archived_prediction_test(
      model: model, configuration: spare_screen_configuration,
      observation: RecordedFact { id: "msg_94eec616-spare-screen-restart" as RecordedFactId, value: RestartInsideDeclaredWindow },
      archive: spare_screen_archive_receipt(),
      source: decl_ref(module_path: "gunbc.machine_intake_mtcollins1_spare_screen_prediction", decl_name: "spare_screen_outcome_report"),
      discrimination: ConfoundedMechanisms {
        first_confound: "Sixteen modules change at once; the committed prediction explicitly says failure does not identify which module.",
        further_confounds: [
          "The committed prediction retains faulty spare OR cross-channel combination not tolerated; neither alternative is eliminated by the restart.",
          "The exact sixteen-of-seventeen spare selection and independent publication/start/outcome ordering are not recorded.",
          "Lower memory power is consistent with an earlier failure; it does not identify a cause or decode the OEM payload.",
        ],
      },
    )
  }
}

// One counterexample disproves sufficiency. It DOES NOT prove necessity: concluding that an
// unsupported shape cannot train would repeat the original non-endorsement-as-prohibition error.
// The retained original cohort makes the restricted domain nonempty, not retrospectively tested.
fn narrowed_spare_screen_model() -> PredictiveModelResult<SpareScreenConfiguration, SpareScreenOutcome> {
  match falsified_spare_screen_model() {
    PredictiveModelRefused { cause: cause } => PredictiveModelRefused { cause: cause }
    PredictiveModelAccepted { model: model } => narrow_predictive_model(
      model: model, revision: "mtcollins1-original-set-training-v2" as ClaimId,
      statement: "Predict training only for the reported original sixteen in the same supported shape. Shape alone is not sufficient; whether any supported shape is physically necessary remains unestablished.",
      restriction: PredictionRestriction {
        reason: "Exclude the spare cohort that falsified the shape-only sufficiency claim; retain the reported original cohort as the next testable domain.",
        admits: original_screen_cohort_in_prediction,
      },
      retained_configuration: original_screen_configuration,
      obligation: spare_screen_testing_obligation,
    )
  }
}

type SpareScreenPredictionReview
  = SpareScreenPredictionReported {
      model: PredictiveModel<SpareScreenConfiguration, SpareScreenOutcome>,
      standing: PredictiveStanding,
      next_obligation: PredictiveNextObligation,
      outcome_report: SpareScreenOutcomeReport,
    }
  | SpareScreenPredictionRefused { cause: PredictiveClaimRefusal }

fn spare_screen_prediction_review() -> SpareScreenPredictionReview {
  match narrowed_spare_screen_model() {
    PredictiveModelRefused { cause: cause } => SpareScreenPredictionRefused { cause: cause }
    PredictiveModelAccepted { model: model } => SpareScreenPredictionReported {
      model: model, standing: predictive_standing(model: model),
      next_obligation: predictive_next_obligation(model: model),
      outcome_report: spare_screen_outcome_report,
    }
  }
}

fn spare_screen_prediction_cli() -> CliWireResponse {
  let report = spare_screen_outcome_report
  predictive_review_cli(result: narrowed_spare_screen_model(), context: [
    spare_screen_prediction_archive,
    concat("Identity correction report: ", spare_screen_identity_correction.message_id),
    concat("Original author time (not publication proof): ", spare_screen_identity_correction.author_time_quotation),
    concat("Amended committer time (not publication proof): ", spare_screen_identity_correction.committer_time_quotation),
    spare_screen_identity_correction.ordering_testimony,
    spare_screen_identity_correction.mixed_commit_content,
    concat("Reported experiment: ", report.message_id),
    concat("Restart after power-on (ms): ", to_string(report.restart_after_power_on)),
    concat("OEM payload quotation: ", report.oem_payload_quotation),
    join(["Reported memory power (mW), socket 0 / socket 1: ", to_string(milliwatt_count(w: report.socket0_memory_power)),
      " / ", to_string(milliwatt_count(w: report.socket1_memory_power))], ""),
    concat("Reported original-set power per socket (mW): ", to_string(milliwatt_count(w: report.original_each_socket_memory_power))),
    concat("Reported original-set clean duration (ms): ", to_string(report.original_reported_clean_duration)),
  ])
}
