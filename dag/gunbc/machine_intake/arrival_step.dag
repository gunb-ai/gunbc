module gunbc.machine_intake.arrival_step

import v2.workflow.gunbc_invoke_step_emit {
  gunbc_run_step_script_for_target,
}
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.ci.ci_run_step_target {
  gunbc_run_step_target,
  GunbcRunStepTarget,
}

data gunbc_ci_arrival_admit_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.machine_intake.arrival_admission",
  function: "arrival_admit_executor",
)

data gunbc_ci_arrival_converge_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.machine_intake.arrival_run",
  function: "arrival_converge_wet",
)

fn gunbc_ci_arrival_admit_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_arrival_admit_target,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_arrival_converge_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_arrival_converge_target,
    claim_run: false,
    receipt_rel: none
  )
}
