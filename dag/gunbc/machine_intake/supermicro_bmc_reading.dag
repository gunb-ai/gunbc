// ── READING THE MANIFEST. A capture whose file is unreadable or whose digest differs refuses the whole
// reading: a reading assembled from the captures that happened to verify would be a different reading.
type CaptureBody { capture: SupermicroCapture, text: String }

type CaptureFold = CapturesRead { bodies: List<CaptureBody> } | CaptureRefused { path: NonEmptyStr, cause: String }

fn read_capture(capture: SupermicroCapture) -> CaptureFold uses fs: std.resources.Filesystem {
  let read = Filesystem.Read(path: capture.path as String)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } => CaptureRefused { path: capture.path, cause: e }
    FilesystemReadSucceeded { content: text } =>
      if sha256_hex_of_text(text: text) != (capture.sha256 as String) {
        CaptureRefused { path: capture.path, cause: concat("sha256 differs from the manifest: ", sha256_hex_of_text(text: text)) }
      } else { CapturesRead { bodies: [CaptureBody { capture: capture, text: text }] } }
  }
}

fn read_captures(captures: List<SupermicroCapture>) -> CaptureFold uses fs: std.resources.Filesystem {
  let none_yet: List<CaptureBody> = []
  let init: CaptureFold = CapturesRead { bodies: none_yet }
  fold(captures, init: init, f: (acc, c) => match acc {
    CaptureRefused { path: p, cause: x } => CaptureRefused { path: p, cause: x }
    CapturesRead { bodies: bs } => match read_capture(capture: c) {
      CaptureRefused { path: p, cause: x } => CaptureRefused { path: p, cause: x }
      CapturesRead { bodies: one } => CapturesRead { bodies: concat(bs, one) }
    }
  })
}

fn body_of(bodies: List<CaptureBody>, suffix: String) -> String? {
  match first(filter(bodies, b => ends_with(s: b.capture.path as String, suffix: suffix))) {
    Absent => none
    Present { value: b } => Present { value: b.text }
  }
}

fn bodies_matching(bodies: List<CaptureBody>, infix: String) -> List<CaptureBody> {
  filter(bodies, b => string_contains(s: b.capture.path as String, pattern: infix))
}

// ── THE READING OF ONE UNIT. ───────────────────────────────────────────────────────────────────────────
type SupermicroResourceRead { request: NonEmptyStr, standing: SupermicroResourceStanding }

type SupermicroH11sslBmcReading {
  bmc_mac: Eui48Address
  identity: SupermicroIdentityReading
  identity_agrees_with_catalog: Bool
  resources: List<SupermicroResourceRead>
  boot_ipmi: IpmiBootFlagsReading?
  boot_redfish: ObservationAttempt<RedfishBootOverrideReading, NonEmptyStr>?
  sdr: List<SdrLineResult>
  sel: List<IpmitoolSelRow>?
  cipher_suites: List<IpmiCipherSuitePrivilege>?
  sol: IpmiSolConfiguration?
  redfish_memory_collection: ObservationAttempt<RedfishCollectionPage, NonEmptyStr>?
  redfish_dimms: List<ObservationAttempt<RedfishMemoryMember, NonEmptyStr>>
  smbios_dimms: SupermicroCgiRead<List<SupermicroSmbiosDimm>>?
  dimm_disagreements: List<DimmReadingDisagreement>
  virtual_media: ObservationAttempt<SupermicroVirtualMediaOffer, NonEmptyStr>?
}

type SupermicroH11sslReadingOutcome
  = SupermicroH11sslRead { reading: SupermicroH11sslBmcReading }
  | SupermicroH11sslReadRefused { path: NonEmptyStr, cause: String }

fn established_members(attempts: List<ObservationAttempt<RedfishMemoryMember, NonEmptyStr>>) -> List<RedfishMemoryMember> {
  flat_map(attempts, a => match a {
    ObservationEstablished { observed: m } => [m]
    ObservationRefused { cause: _ } => []
  })
}

fn optional_map_sdr(stdout: String?) -> List<SdrLineResult> {
  match stdout {
    Absent => []
    Present { value: s } => sdr_decode_lines(stdout: s)
  }
}

fn reading_of_bodies(bmc_mac: Eui48Address, bodies: List<CaptureBody>) -> SupermicroH11sslBmcReading {
  let identity = supermicro_bmc_identity(
    manager_body: body_of(bodies: bodies, suffix: "redfish_v1_Managers_1.json"),
    cgi_generic_body: body_of(bodies: bodies, suffix: "generic-info.xml"),
    device_id_stdout: body_of(bodies: bodies, suffix: "raw-0x06-0x01.txt"),
  )
  let redfish_dimms = map(bodies_matching(bodies: bodies, infix: "redfish_v1_Systems_1_Memory_"), b => redfish_memory_member_of(body: b.text))
  let sel = match body_of(bodies: bodies, suffix: "sel-elist.txt") {
    Absent => none
    Present { value: s } => ipmitool_sel_elist_rows(stdout: s)
  }
  SupermicroH11sslBmcReading {
    bmc_mac: bmc_mac,
    identity: identity,
    identity_agrees_with_catalog: supermicro_identity_agrees_with_catalog(reading: identity, catalog: supermicro_h11ssl_catalog),
    resources: flat_map(bodies, b => match b.capture.http_status {
      Present { value: _ } => [SupermicroResourceRead { request: b.capture.request, standing: supermicro_resource_standing(http_status: b.capture.http_status, body: b.text) }]
      Absent => if starts_with(s: b.capture.request as String, prefix: "GET ") {
        [SupermicroResourceRead { request: b.capture.request, standing: supermicro_resource_standing(http_status: none, body: b.text) }]
      } else { [] }
    }),
    boot_ipmi: match body_of(bodies: bodies, suffix: "chassis-bootparam-get-5.txt") { Absent => none  Present { value: s } => ipmi_boot_flags_reading_of_bootparam_get(stdout: s) },
    boot_redfish: match body_of(bodies: bodies, suffix: "redfish_v1_Systems_1.json") { Absent => none  Present { value: s } => Present { value: redfish_boot_override_of_system(body: s) } },
    sdr: optional_map_sdr(stdout: body_of(bodies: bodies, suffix: "sdr-elist.txt")),
    sel: sel,
    cipher_suites: match body_of(bodies: bodies, suffix: "lan-print-1.txt") { Absent => none  Present { value: s } => ipmi_cipher_suite_privileges_of_lan_print(stdout: s) },
    sol: match body_of(bodies: bodies, suffix: "sol-info-1.txt") { Absent => none  Present { value: s } => ipmi_sol_configuration_of_sol_info(stdout: s) },
    redfish_memory_collection: match body_of(bodies: bodies, suffix: "redfish_v1_Systems_1_Memory.json") { Absent => none  Present { value: s } => Present { value: redfish_collection_page_of(body: s) } },
    redfish_dimms: redfish_dimms,
    smbios_dimms: match body_of(bodies: bodies, suffix: "smbios-info.xml") { Absent => none  Present { value: s } => Present { value: supermicro_cgi_smbios_dimms_of(body: s) } },
    dimm_disagreements: match sel {
      Absent => []
      Present { value: rows } => supermicro_dimm_reading_disagreements(members: established_members(attempts: redfish_dimms), sel: rows)
    },
    virtual_media: match body_of(bodies: bodies, suffix: "redfish_v1_Managers_1_VirtualMedia_CD1.json") { Absent => none  Present { value: s } => Present { value: supermicro_virtual_media_offer(body: s) } },
  }
}

fn supermicro_h11ssl_reading(bmc_mac: Eui48Address, captures: List<SupermicroCapture>) -> SupermicroH11sslReadingOutcome uses fs: std.resources.Filesystem {
  match read_captures(captures: captures) {
    CaptureRefused { path: p, cause: c } => SupermicroH11sslReadRefused { path: p, cause: c }
    CapturesRead { bodies: bs } => SupermicroH11sslRead { reading: reading_of_bodies(bmc_mac: bmc_mac, bodies: bs) }
  }
}

fn supermicro_h11ssl_unit1_reading_2026_10_27() -> SupermicroH11sslReadingOutcome uses fs: std.resources.Filesystem {
  supermicro_h11ssl_reading(bmc_mac: supermicro_h11ssl_unit1_bmc_mac, captures: supermicro_h11ssl_unit1_captures_2026_10_27)
}

fn supermicro_h11ssl_unit2_reading() -> SupermicroH11sslReadingOutcome uses fs: std.resources.Filesystem {
  supermicro_h11ssl_reading(bmc_mac: supermicro_h11ssl_unit2_bmc_mac, captures: supermicro_h11ssl_unit2_captures)
}
