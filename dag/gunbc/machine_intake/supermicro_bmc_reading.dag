type SupermicroResourceRead { request: NonEmptyStr, standing: SupermicroResourceStanding }

type SupermicroH11sslBmcReading {
  bmc_mac: Eui48Address
  identity: SupermicroIdentityReading
  identity_agrees_with_catalog: Bool
  resources: List<SupermicroResourceRead>
  boot_ipmi: IpmiBootFlagsReading?
  boot_redfish: ObservationAttempt<RedfishBootOverrideReading, NonEmptyStr>?
  sdr: List<SdrLineResult>
  sel: List<IpmitoolSelRow>?
  cipher_suites: List<IpmiCipherSuitePrivilege>?
  sol: IpmiSolConfiguration?
  redfish_memory_collection: ObservationAttempt<RedfishCollectionPage, NonEmptyStr>?
  redfish_dimms: List<ObservationAttempt<RedfishMemoryMember, NonEmptyStr>>
  smbios_dimms: SupermicroCgiRead<List<SupermicroSmbiosDimm>>?
  dimm_disagreements: List<DimmReadingDisagreement>
  virtual_media: ObservationAttempt<SupermicroVirtualMediaOffer, NonEmptyStr>?
}

type SupermicroH11sslReadingOutcome
  = SupermicroH11sslRead { reading: SupermicroH11sslBmcReading }
  | SupermicroH11sslReadRefused { path: NonEmptyStr, cause: String }

fn established_members(attempts: List<ObservationAttempt<RedfishMemoryMember, NonEmptyStr>>) -> List<RedfishMemoryMember> {
  flat_map(attempts, a => match a {
    ObservationEstablished { observed: m } => [m]
    ObservationRefused { cause: _ } => []
  })
}

fn optional_map_sdr(stdout: String?) -> List<SdrLineResult> {
  match stdout {
    Absent => []
    Present { value: s } => sdr_decode_lines(stdout: s)
  }
}

fn reading_of_records(bmc_mac: Eui48Address, records: List<BmcReadRecord>) -> SupermicroH11sslBmcReading {
  let identity = supermicro_bmc_identity(
    manager_body: bmc_body_by_suffix(records: records, suffix: "redfish_v1_Managers_1.json"),
    cgi_generic_body: bmc_body_by_suffix(records: records, suffix: "generic-info.xml"),
    device_id_stdout: bmc_body_by_suffix(records: records, suffix: "raw-0x06-0x01.txt"),
  )
  let redfish_dimms = map(bmc_records_matching(records: records, infix: "redfish_v1_Systems_1_Memory_"), record => redfish_memory_member_of(body: record.body))
  let sel = match bmc_body_by_suffix(records: records, suffix: "sel-elist.txt") {
    Absent => none
    Present { value: s } => ipmitool_sel_elist_rows(stdout: s)
  }
  SupermicroH11sslBmcReading {
    bmc_mac: bmc_mac,
    identity: identity,
    identity_agrees_with_catalog: supermicro_identity_agrees_with_catalog(reading: identity, catalog: supermicro_h11ssl_catalog),
    resources: flat_map(records, record => match bmc_record_http_status(record: record) {
      Present { value: code } => [SupermicroResourceRead { request: bmc_record_request(record: record), standing: supermicro_resource_standing(http_status: Present { value: code }, body: record.body) }]
      // A row with no recorded status still counts as a served resource when the request was a Redfish GET --
      // the same rule this module always had, now read off the operation instead of re-spelling the request.
      Absent => match record.operation {
        RedfishGet { uri: _ } => [SupermicroResourceRead { request: bmc_record_request(record: record), standing: supermicro_resource_standing(http_status: none, body: record.body) }]
        _ => []
      }
    }),
    boot_ipmi: match bmc_body_by_suffix(records: records, suffix: "chassis-bootparam-get-5.txt") { Absent => none  Present { value: s } => ipmi_boot_flags_reading_of_bootparam_get(stdout: s) },
    boot_redfish: match bmc_body_by_suffix(records: records, suffix: "redfish_v1_Systems_1.json") { Absent => none  Present { value: s } => Present { value: redfish_boot_override_of_system(body: s) } },
    sdr: optional_map_sdr(stdout: bmc_body_by_suffix(records: records, suffix: "sdr-elist.txt")),
    sel: sel,
    cipher_suites: match bmc_body_by_suffix(records: records, suffix: "lan-print-1.txt") { Absent => none  Present { value: s } => ipmi_cipher_suite_privileges_of_lan_print(stdout: s) },
    sol: match bmc_body_by_suffix(records: records, suffix: "sol-info-1.txt") { Absent => none  Present { value: s } => ipmi_sol_configuration_of_sol_info(stdout: s) },
    redfish_memory_collection: match bmc_body_by_suffix(records: records, suffix: "redfish_v1_Systems_1_Memory.json") { Absent => none  Present { value: s } => Present { value: redfish_collection_page_of(body: s) } },
    redfish_dimms: redfish_dimms,
    smbios_dimms: match bmc_body_by_suffix(records: records, suffix: "smbios-info.xml") { Absent => none  Present { value: s } => Present { value: supermicro_cgi_smbios_dimms_of(body: s) } },
    dimm_disagreements: match sel {
      Absent => []
      Present { value: rows } => supermicro_dimm_reading_disagreements(members: established_members(attempts: redfish_dimms), sel: rows)
    },
    virtual_media: match bmc_body_by_suffix(records: records, suffix: "redfish_v1_Managers_1_VirtualMedia_CD1.json") { Absent => none  Present { value: s } => Present { value: supermicro_virtual_media_offer(body: s) } },
  }
}

// ONE FOLD FOR EVERY CAPTURE SET. The shared root reads the files, checks every digest and refuses the whole set
// on the first bad row; what comes back is the unit's reading or the refusal naming the row that failed. The
// refusal arms keep the path and the cause they always carried, so a consumer that distinguishes "the capture is
// gone" from "the capture lies" still can.
fn supermicro_h11ssl_reading(bmc_mac: Eui48Address, captures: List<BmcCaptureManifestRow>) -> SupermicroH11sslReadingOutcome uses fs: std.resources.Filesystem {
  match bmc_read_manifest(manifest: captures) {
    BmcAcquisitionRefused { path: path, cause: cause } => SupermicroH11sslReadRefused { path: path, cause: cause }
    BmcRecordsRead { records: records } => SupermicroH11sslRead { reading: reading_of_records(bmc_mac: bmc_mac, records: records) }
  }
}

fn supermicro_h11ssl_unit1_reading_2026_10_27() -> SupermicroH11sslReadingOutcome uses fs: std.resources.Filesystem {
  supermicro_h11ssl_reading(bmc_mac: supermicro_h11ssl_unit1_bmc_mac, captures: supermicro_h11ssl_unit1_captures_2026_10_27)
}

fn supermicro_h11ssl_unit2_reading() -> SupermicroH11sslReadingOutcome uses fs: std.resources.Filesystem {
  supermicro_h11ssl_reading(bmc_mac: supermicro_h11ssl_unit2_bmc_mac, captures: supermicro_h11ssl_unit2_captures)
}
