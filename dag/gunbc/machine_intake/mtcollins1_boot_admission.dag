module gunbc.machine_intake_mtcollins1_boot_admission

import std.types { Bool, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.actions_run_binding { actions_variable_read, ActionsVariablePresent, ActionsVariableAbsent, fleet_converge_expected_host_env_name }
import gunbc.fleet_intent_network { operator_host_srv1 }

// THE CREDENTIAL-FREE BOOT ADMISSION, IN ITS OWN MODULE BECAUSE ITS CLOSURE IS ITS COST. The
// fleet-converge step "Mt. Collins boot admission (credential-free)" runs `gunbc run` on this entry,
// and `gunbc run` typechecks the entry's whole import closure before it evaluates anything. While
// this fold lived in gunbc.machine_intake_mtcollins1_boot_run, checking one host input paid for the
// entire boot closure (unit hold, SOL, virtual media, handoff, diagnostics), and run 36170715248 was
// still typechecking when the step's 5-minute budget killed it. The fold needs two facts -- the
// dispatch's host input and the store host -- so its module imports exactly those, and the boot run
// imports this module rather than the reverse.
//
// DECLARED FRONTIER: the guarantee that this closure excludes the boot run has NO floor-enrolled
// control. A whole-tree live closure scan (v2.lens.module_graph import_closure_live) could not
// reach a verdict on the armed line (floor run 36185768935), so it was withdrawn rather than left
// red. TRIGGER: a control that fits the armed line -- e.g. over this module's SUPPLIED import graph
// (its declared imports and their transitive declared imports, read as data), with one real-path
// check kept on the long home.
//
// THE HOST ADMISSION, ONE FOLD FOR BOTH SEAMS: the dispatch's host input must name the store host.
// The boot job always starts on srv1's runner (its labels never read the input), so a dispatch naming
// another host is REFUSED there with a typed reason -- never skipped, since a skipped job reports
// success (review 70894) -- by mtcollins1_boot_admit_executor, a credential-free step before the WIF
// token and the fleet key. The wet entry (gunbc.machine_intake_mtcollins1_boot_run
// mtcollins1_boot_wet) re-runs the same fold, so neither seam can drift.
fn mtcollins1_boot_host_must_be_srv1(host: String) -> Bool {
  host == operator_host_srv1 as String
}

fn mtcollins1_boot_refuses_off_srv1(host: String) -> ProcessExit {
  if mtcollins1_boot_host_must_be_srv1(host: host) {
    ExitSuccess
  } else {
    exit_failure(reason: concat("mtcollins1 boot refuses host '", concat(host, concat("': the unit hold store (gunbc.machine_intake_mtcollins1_maintenance_hold unit_hold_store_root) is on the runner host where the operator takes maintenance holds, which is ", operator_host_srv1 as String))))
  }
}

fn mtcollins1_boot_host_admission() -> ProcessExit {
  match actions_variable_read(name: fleet_converge_expected_host_env_name) {
    ActionsVariableAbsent { variable: v, detail: d } =>
      exit_failure(reason: concat("mtcollins1 boot: ", concat(v, concat(" ", concat(d, "; the unit hold store is srv1 only")))))
    ActionsVariablePresent { value: host } => mtcollins1_boot_refuses_off_srv1(host: host)
  }
}

fn mtcollins1_boot_admit_executor() -> ProcessExit {
  mtcollins1_boot_host_admission()
}
