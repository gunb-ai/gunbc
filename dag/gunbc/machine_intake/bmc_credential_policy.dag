module gunbc.machine_intake.bmc_credential_policy

import std.types { Bool, HttpStatus, List, NonEmptyStr, String }
import extdeps.ietf.http_semantics { http_forbidden }
import std.optional { Absent, Present }
import std.content_hash { Sha256Digest, Sha256Hash }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.board_authority { BoardAuthorityRef, board_authority_ref_eq }
import extdeps.bmc.endpoint { OpenBmc }
import extdeps.bmc.capability { BmcFirmwareReleaseIdentity, bmc_firmware_release_identity_eq, bmc_firmware_release_identity_of_wire }
import extdeps.bmc.redfish { RedfishFirstLoginPasswordChange, RedfishPasswordChangeVerdict, RedfishPasswordChangeRequired, RedfishPasswordChangeNotIndicated, RedfishResponseBodyUnreadable }
import extdeps.boards.asrock_rack { asrock_altrad8ud_board_authority, asrock_altrad8ud_bmc_3_22_00_first_login_password_change }
import gunbc.machine_intake.receipt { EvidenceRef }

// ── HOW ONE FIRMWARE BUILD TREATS ITS ACCOUNT CREDENTIALS, AS THIS REPOSITORY OBSERVED IT ──────────
//
// Two facts decide how the first rotation of a controller is made and how its result is read back,
// and both are facts about a BUILD, not about a unit or a family:
//
// - what the published (factory) login does on first contact. OpenBMC 3.22.00 on the ALTRAD8UD answers
//   every authenticated request under root/0penBmc with HTTP 403 Base.1.16.0.PasswordChangeRequired
//   (a wrong password is 401). The only request that state admits is the password write itself, so on
//   that build the forced change IS the first rotation, and nothing authenticated can be read before it.
//   OpenBMC 2.07.00 on the same board accepted the published login outright.
// - whether an account has ONE password across every surface it authenticates on. Where it does, the
//   published credential's retirement on an account whose password the rotation changed is DERIVED from
//   the managed generation being accepted, and needs no failed login -- which matters because a failed
//   login against that same account spends its lockout budget, and on OpenBMC the published account IS
//   the managed account (root).
//
// THE VENDOR'S CODES ARE THE VENDOR'S (DESIGN §3, external upstream decomposition; operator directive
// relayed by merry-fox-82, 2026-10-28). What a build answers -- the MessageId 03.22.00 returns on first
// login -- is catalogued in the vendor's extdeps module beside the release row, keyed by the version it was
// read on (extdeps.boards.asrock_rack asrock_altrad8ud_bmc_3_22_00_first_login_password_change), so the next
// unit on that build inherits it. What stays here is OURS: which of our controllers answered it, and which
// surfaces then took the new password, each with the capture it cites, and the per-build join the converge
// reads. A build nobody read has no row: the lookup answers Absent, and every consumer refuses on Absent
// rather than assuming the commonest behaviour (DESIGN §5).
//
// The lockout policy is NOT a row here. It is served by the controller itself (Redfish AccountService
// AccountLockoutThreshold / AccountLockoutDuration, IPMI LAN "Bad Password Threshold") and so is read
// per controller, beside the other account readings.

type BmcCredentialPolicyKey {
  board: BoardAuthorityRef
  firmware: BmcFirmwareReleaseIdentity
}

fn bmc_credential_policy_key_eq(a: BmcCredentialPolicyKey, b: BmcCredentialPolicyKey) -> Bool {
  board_authority_ref_eq(a: a.board, b: b.board) && bmc_firmware_release_identity_eq(a: a.firmware, b: b.firmware)
}

// WHAT THE PUBLISHED LOGIN ANSWERS ON FIRST CONTACT. ForcesPasswordChange carries the vendor's catalogued
// requirement (its exact MessageId) and our receipt of a controller answering it, so a live read is matched
// against the exact verdict the build was measured to give.
type FactoryLoginBehaviour
  = FactoryLoginAccepted { evidence: EvidenceRef }
  | FactoryLoginForcesPasswordChange { requirement: RedfishFirstLoginPasswordChange, evidence: EvidenceRef }
  | FactoryLoginNotMeasured

// WHICH SURFACES SHARE ONE PASSWORD PER ACCOUNT. A surface is listed only with the receipt that a
// password written through another surface changed what it accepts. The surfaces not listed are not
// claimed either way.
type CredentialSurface
  = RedfishBasicOrSession
  | IpmiLanplus

type SharedCredentialSurface {
  surface: CredentialSurface
  evidence: EvidenceRef
}

type AccountCredentialStore
  = OnePasswordPerAccount { surfaces: List<SharedCredentialSurface> }
  | CredentialStoreNotMeasured

type BmcCredentialPolicyRow {
  key: BmcCredentialPolicyKey
  factory_login: FactoryLoginBehaviour
  store: AccountCredentialStore
}

// ── ROWS ──────────────────────────────────────────────────────────────────────────────────────────

fn asrock_altrad8ud_openbmc_3_22_00_key() -> BmcCredentialPolicyKey {
  BmcCredentialPolicyKey {
    board: asrock_altrad8ud_board_authority,
    firmware: bmc_firmware_release_identity_of_wire(family: OpenBmc, wire: "3.22.00" as NonEmptyStr),
  }
}

// srv13 after its BMC was flashed to 3.22.00 (2026-10-08): the first authenticated request under the
// published credential answered 403 Base.1.16.0.PasswordChangeRequired. The digest is that capture's
// SHA256SUMS entry.
data srv13_openbmc_3_22_00_factory_login_403: EvidenceRef = EvidenceRef {
  label: "artifacts/bmc/srv13-first-contact-2026-10-07/bmc-3.22.00-factory-login-403.json",
  digest: Sha256Hash(Sha256Digest { hex: "4e85a95511849bb353b9fb64411a08b818c86ed7500f9db8ce7722788d64a41c" }),
}

// The in-band recovery of bmc-altrad8ud-1l2t-6 on 3.22 (2026-10-16): a password set for user 1 (root)
// over the in-band IPMI system interface then authenticated an out-of-band Redfish GET (HTTP 200). The
// response bodies of that sequence were not saved as bytes; the summary is the route narrative and its
// SHA256SUMS entry is the digest. It grounds IPMI -> Redfish for one account; it does not ground the
// IPMI LAN (lanplus) surface.
data altrad8ud_6_inband_password_authenticates_redfish: EvidenceRef = EvidenceRef {
  label: "artifacts/bmc/altrad8ud-1l2t-6-inband-recovery-2026-10-16/01_summary.txt",
  digest: Sha256Hash(Sha256Digest { hex: "c9b8083222e6f7840677bbcd32f5cf894cd84a71e9fe7110634e10b280c3cc12" }),
}

data asrock_altrad8ud_openbmc_3_22_00_credential_policy: BmcCredentialPolicyRow = BmcCredentialPolicyRow {
  key: asrock_altrad8ud_openbmc_3_22_00_key(),
  factory_login: FactoryLoginForcesPasswordChange {
    requirement: asrock_altrad8ud_bmc_3_22_00_first_login_password_change,
    evidence: srv13_openbmc_3_22_00_factory_login_403,
  },
  store: OnePasswordPerAccount {
    surfaces: [
      SharedCredentialSurface { surface: RedfishBasicOrSession, evidence: altrad8ud_6_inband_password_authenticates_redfish },
    ],
  },
}

data bmc_credential_policy_catalog: List<BmcCredentialPolicyRow> = [
  asrock_altrad8ud_openbmc_3_22_00_credential_policy,
]

// THE LOOKUP. Absent means nobody read this build on this board.
fn bmc_credential_policy_for(key: BmcCredentialPolicyKey) -> BmcCredentialPolicyRow? {
  let none_yet: BmcCredentialPolicyRow? = none
  fold(bmc_credential_policy_catalog, init: none_yet, f: (acc, row) =>
    match acc {
      Present { value: _ } => acc
      Absent => if bmc_credential_policy_key_eq(a: row.key, b: key) { Present { value: row } } else { acc }
    })
}

// ── THE FORCED-CHANGE STATE ────────────────────────────────────────────────────────────────────────
//
// REACHED ONLY FROM A 403 WHOSE BODY SAYS PasswordChangeRequired, ON A BUILD WHOSE ROW SAYS IT FORCES
// THAT CHANGE WITH THAT MESSAGE. Any other 403 (a licence gate, a privilege refusal), the same verdict on
// a build whose row says the published login is accepted, a different message id, or a build with no
// row, refuses with its own cause: the forced-change state admits a password write made under the
// published credential, so entering it on anything but that exact reading would be a write nobody
// approved the premise of. The sealed carrier is minted only here.
//
// NOT YET CONSUMED (DESIGN §3c, declared frontier): published_credential_change_forced_consumer_frontier.
type PublishedCredentialChangeForced sole_constructor {
  key: BmcCredentialPolicyKey
  message_id: NonEmptyStr
  response_evidence: EvidenceRef
  policy_evidence: EvidenceRef
}

type ForcedChangeRefusal
  = ForcedChangeNotA403 { status: HttpStatus }
  | ForcedChangeVerdictNotIndicated
  | ForcedChangeBodyUnreadable { cause: NonEmptyStr }
  | ForcedChangeBuildHasNoPolicy { key: BmcCredentialPolicyKey }
  | ForcedChangeBuildAcceptsFactoryLogin { key: BmcCredentialPolicyKey }
  | ForcedChangeBuildNotMeasured { key: BmcCredentialPolicyKey }
  | ForcedChangeMessageDiffers { observed: String, measured: NonEmptyStr }

type ForcedChangeAdmission
  = ForcedChangeAdmitted { state: PublishedCredentialChangeForced }
  | ForcedChangeRefused { cause: ForcedChangeRefusal }

// `status` is the response's status code; `verdict` is extdeps.bmc.redfish
// redfish_password_change_verdict over the same response's body.
fn admit_published_credential_change_forced(
  key: BmcCredentialPolicyKey,
  status: HttpStatus,
  verdict: RedfishPasswordChangeVerdict,
  response_evidence: EvidenceRef,
) -> ForcedChangeAdmission {
  if status != http_forbidden() {
    ForcedChangeRefused { cause: ForcedChangeNotA403 { status: status } }
  } else {
    match verdict {
      RedfishPasswordChangeNotIndicated => ForcedChangeRefused { cause: ForcedChangeVerdictNotIndicated }
      RedfishResponseBodyUnreadable { cause: c } => ForcedChangeRefused { cause: ForcedChangeBodyUnreadable { cause: c } }
      RedfishPasswordChangeRequired { message_id: observed } =>
        match bmc_credential_policy_for(key: key) {
          Absent => ForcedChangeRefused { cause: ForcedChangeBuildHasNoPolicy { key: key } }
          Present { value: row } =>
            match row.factory_login {
              FactoryLoginAccepted { evidence: _ } => ForcedChangeRefused { cause: ForcedChangeBuildAcceptsFactoryLogin { key: key } }
              FactoryLoginNotMeasured => ForcedChangeRefused { cause: ForcedChangeBuildNotMeasured { key: key } }
              FactoryLoginForcesPasswordChange { requirement: req, evidence: pe } => {
                let measured = req.message_id
                if (observed as String) != (measured as String) {
                  ForcedChangeRefused { cause: ForcedChangeMessageDiffers { observed: observed, measured: measured } }
                } else {
                  ForcedChangeAdmitted {
                    state: PublishedCredentialChangeForced { key: key, message_id: measured, response_evidence: response_evidence, policy_evidence: pe },
                  }
                }
              }
            }
        }
    }
  }
}

// THE FORCED STATE'S CONSUMER IS THE NEXT CHANGE ON THIS LANE. Nothing in the converge enters this state
// yet: the arrival prefix still reads the Manager first, which a forcing build refuses with this very 403.
data published_credential_change_forced_consumer_frontier: DissolutionCondition = unbound_dissolution(
  description: "dissolves when an admission of the forced first rotation reads PublishedCredentialChangeForced -- the factory account's password write at the controller and build that answered the 403, under one gunbc.auth.approval_gate go whose purpose is QualifyByRotation (gunbc.machine_intake.bmc_rotation_route) -- so that on a forcing build the converge's first write is that rotation and no redundant second rotation follows; NOT satisfied by this module's witness, which exercises the admission of the state and not a route that consumes it" as NonEmptyStr,
)

// ── THE SHARED-STORE PREMISE OF A DERIVED RETIREMENT ──────────────────────────────────────────────
//
// The surfaces on which this build's row grounds one password per account, or none when the row does
// not say so. A consumer deriving the published credential's retirement on a surface not listed here
// must probe it, inside the controller's read lockout budget, or refuse.
fn shared_store_surfaces(key: BmcCredentialPolicyKey) -> List<SharedCredentialSurface> {
  match bmc_credential_policy_for(key: key) {
    Absent => []
    Present { value: row } =>
      match row.store {
        CredentialStoreNotMeasured => []
        OnePasswordPerAccount { surfaces: s } => s
      }
  }
}
