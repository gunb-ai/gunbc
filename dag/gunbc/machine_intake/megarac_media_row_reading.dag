module gunbc.machine_intake.megarac_media_row_reading

// WHAT ONE READ OF A MEGARAC CD/DVD MEDIA ROW SAID, KEPT AS A RECEIPT OF THAT READ. The boot lanes print
// the rows they read; this module keeps the row a read carried, with the artifact the line lives in and
// the digest that file is committed under, so a claim about what a status MEANS can point at the read
// instead of at a sentence in a comment. These are receipts of reads THIS repository made (gunbc.design_argument::single_authority):
// the codes are recorded exactly as the controller answered them, and what they mean is established once,
// in extdeps.bmc.megarac, keyed to these run ids.
//
// WHY THESE RECEIPTS AND NOT MORE. Code 16 is the state the mtcollins1 controller reports for the CD/DVD row
// between attempts, and it is the reason boot run 40264233543 stopped at attach. It was read as a ROW -- this
// status beside the no-session marker -- and never as a bare code, so the row is what is retained, and the
// meaning follows only as far as the row was read. The fourth and fifth receipts,
// boot_run_41573858366_end_media_row and boot_run_42663208460_end_media_row, are a DIFFERENT code (0) on the
// same row position, beside the same no-session marker, naming no medium, read by the seventh and ninth
// attempts. What 0 beside that marker means on this release is the vendor's, read two ways and kept here as
// the two observations they are: the vendor's served UI renderer (mtcollins1_ui_media_row_rendering), and an
// operator's dated reading of the page that renderer draws (mtcollins1_cd_row_status_zero_ui_attestation).
// Together they ground extdeps.bmc.megarac megarac_redirection_status_of_row's RedirectionNotActive -- no
// session is live on the row -- and nothing stronger: the vendor's word for stopped is a different label.
// One thing the two readings do NOT agree on is kept, not explained: the page showed an image name in the
// row the machine read as naming none (ui_attestation_and_read_join).

import std.algebra { string_contains }
import std.types { Bool, Int, NonEmptyStr }

type MegaRacMediaRowReceipt {
  run_id: NonEmptyStr
  observed_at: Int
  artifact_path: NonEmptyStr
  artifact_sha256: NonEmptyStr
  artifact_lines: NonEmptyStr
  media_type: Int
  media_index: Int
  session_index: Int
  // THE MEDIUM THE ROW NAMES, OR NOTHING. The controller answers the empty string for a leftover row that
  // names no image, and this layer keeps that as `none` rather than a name that happens to be empty: a row
  // naming no medium is a different case from a row whose name is "", and `none` is what boot run
  // 41573858366 actually read. The reading of that answer is what the inference below -- and the refusal it
  // produces -- is keyed to; nothing promotes a code from a value a row carried.
  image_name: NonEmptyStr?
  redirection_status: Int
}

// THE ROW BOOT RUN 40258937016 LEFT AT THE END OF ITS ATTEMPT, read back at 1792983408184 and quoted
// verbatim on the line named below: media_type 1, media_index 0, session_index 255, the runner medium,
// redirection_status 16. That run's own hpm check committed the release it ran on (APP Active 0.45), so
// this is a read ON that build -- not a reading of the page label "0.45.3", which no wire has ever
// carried. The same line records cd_error_code 16; WHAT AN ERROR CODE 16 MEANS WAS NEVER ESTABLISHED, and
// nothing here is read through it.
data boot_run_40258937016_end_media_row: MegaRacMediaRowReceipt = MegaRacMediaRowReceipt {
  run_id: "40258937016" as NonEmptyStr,
  observed_at: 1792983408184,
  artifact_path: "artifacts/bmc/mtcollins1-boot-run-40258937016/mtcollins1-boot-diagnostics.txt" as NonEmptyStr,
  artifact_sha256: "16a18fed0a9630d33194fef1a0a5efb80807f64b2363ad7e63f94cc44dec498f" as NonEmptyStr,
  artifact_lines: "2055" as NonEmptyStr,
  media_type: 1,
  media_index: 0,
  session_index: 255,
  image_name: Present { value: "gunbc-runner-host-ubuntu-24.04.3-arm64-31aef9394d9e58c3.iso" as NonEmptyStr },
  redirection_status: 16,
}

// THE ROW BOOT RUN 41573858366 (the seventh boot attempt) MET AT THE END OF ITS ATTEMPT, read back at
// 1793678673678 and quoted verbatim on the line named below: media_type 1, media_index 0, session_index 255,
// NO medium named, redirection_status 0. It was the first reading of wire 0 on this release this repository
// held. At the time no vendor reading covered 0 on this release, so the lane refused the row (what this
// repository then made of it was carried as a typed bet no lane acted on), nothing was written, no session
// was started and the host was never powered on; the `harness=` line of
// artifacts/bmc/mtcollins1-boot-run-41573858366/mtcollins1-boot-receipt.txt quotes this same row. The vendor
// reading that settled it is mtcollins1_ui_media_row_rendering with mtcollins1_cd_row_status_zero_ui_attestation
// (below), and it settled it as NOT ACTIVE, not as the stopped the bet resembled.
data boot_run_41573858366_end_media_row: MegaRacMediaRowReceipt = {
  run_id: "41573858366" as NonEmptyStr,
  observed_at: 1793678673678,
  artifact_path: "artifacts/bmc/mtcollins1-boot-run-41573858366/mtcollins1-boot-diagnostics.txt" as NonEmptyStr,
  artifact_sha256: "838a763be6c8abee7cf592ffa1f348310cb4041fd4abe8eb03d9154cc29c833e" as NonEmptyStr,
  artifact_lines: "2062" as NonEmptyStr,
  media_type: 1,
  media_index: 0,
  session_index: 255,
  image_name: Absent,
  redirection_status: 0,
}

