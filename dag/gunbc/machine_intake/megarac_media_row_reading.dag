  redirection_status: 0,
}

// THE SESSION MARKER OF A SESSION THAT WAS LIVE, from boot run 40258937016's handoff read at 1792983328762:
// "row started, session_index 0". THE COUNTER-EVIDENCE, kept so the shape of the 16 claim cannot drift: a
// session this build reports as STARTED carries index 0, not 255. So "16 beside an active index" is a
// different observation from the one that was made, it has never been made here, and it stays unread.
type MegaRacSessionMarkerReceipt {
  run_id: NonEmptyStr
  observed_at: Int
  artifact_path: NonEmptyStr
  artifact_sha256: NonEmptyStr
  artifact_lines: NonEmptyStr
  session_index: Int
  row_state_as_read: NonEmptyStr
}

data boot_run_40258937016_started_session_marker: MegaRacSessionMarkerReceipt = MegaRacSessionMarkerReceipt {
  run_id: "40258937016" as NonEmptyStr,
  observed_at: 1792983328762,
  artifact_path: "artifacts/bmc/mtcollins1-boot-run-40258937016/mtcollins1-boot-diagnostics.txt" as NonEmptyStr,
  artifact_sha256: "16a18fed0a9630d33194fef1a0a5efb80807f64b2363ad7e63f94cc44dec498f" as NonEmptyStr,
  artifact_lines: "2054" as NonEmptyStr,
  session_index: 0,
  row_state_as_read: "row started" as NonEmptyStr,
}

// THE VENDOR'S OWN WORDS FOR THAT ROW, FROM A HUMAN READING THE CONTROLLER'S PAGE -- NOT A MACHINE READ.
// On 2026-10-26 the operator opened mtcollins1's web UI and recorded how the vendor LABELS the row this
// repository keeps meeting: the CD/DVD 0 entry naming the runner medium, shown as "Stopped - Device
// Ejected", with no value in its detail column ("N/A"). It is typed as an attestation because no artifact
// bytes stand behind it and no reader in this corpus produced it; it is dated because an undated UI
// reading is unfalsifiable; and it is kept HERE, in the observing layer, because a person reading a vendor
// page is an observation this repository makes, not a fact of the upstream product (gunbc.design_argument::single_authority). What it
// can do is corroborate: it says the vendor's own name for this row's state is stopped and ejected, i.e.
// NOT PRESENTING. It cannot supply the code, the index, or the release -- those come only from the reads
// above.
type BmcMediaRowUiAttestation {
  row_label: NonEmptyStr
  // THE ROW'S POSITION AS THE PAGE NUMBERS IT ("Media Instance"), the coordinate a machine read is joined on.
  // The page renders it from the row's media_index member verbatim (mtcollins1_ui_media_row_rendering).
  media_instance: Int
  image_name: NonEmptyStr
  state_label: NonEmptyStr
  detail_label: NonEmptyStr
  read_on_day: NonEmptyStr
  read_by: NonEmptyStr
}

data mtcollins1_cd_row_ui_attestation: BmcMediaRowUiAttestation = BmcMediaRowUiAttestation {
  row_label: "CD/DVD 0" as NonEmptyStr,
  media_instance: 0,
  image_name: "gunbc-runner-host-ubuntu-24.04.3-arm64-31aef9394d9e58c3.iso" as NonEmptyStr,
  state_label: "Stopped - Device Ejected" as NonEmptyStr,
  detail_label: "N/A" as NonEmptyStr,
  read_on_day: "2026-10-26" as NonEmptyStr,
  read_by: "operator" as NonEmptyStr,
}

// DOES THE VENDOR'S LABEL DESCRIBE A ROW THAT IS NOT PRESENTING? Only two of the page's own words are
// accepted, and BOTH are required: a row the page calls Stopped AND Ejected. Any other label -- "Connected",
// "In Use", an empty cell, or a label that says stopped without saying ejected -- fails this, so an
// attestation of some other state cannot be pushed through it to license a boot.
fn attestation_labels_a_stopped_and_ejected_row(attestation: BmcMediaRowUiAttestation) -> Bool {
  string_contains(s: attestation.state_label as String, pattern: "Stopped")
    && string_contains(s: attestation.state_label as String, pattern: "Ejected")
}

// DO THE ATTESTATION AND A MACHINE READ DESCRIBE THE SAME ROW? The medium name and the CD/DVD row, and
// nothing more. This deliberately does NOT say "the label means code 16": it only records that the two
// readings are about one row, which is what lets the vendor's words corroborate the read without becoming
// the evidence for it. An operator can only corroborate a row they could NAME, so a row that names no medium
// fails here -- which is also why the 0 claim cannot borrow 16's attestation.
fn attestation_and_read_name_the_same_row(attestation: BmcMediaRowUiAttestation, read: MegaRacMediaRowReceipt) -> Bool {
  match read.image_name {
    Absent => false
    Present { value: named } => (attestation.image_name as String) == (named as String)
      && string_contains(s: attestation.row_label as String, pattern: "CD/DVD")
  }
}

// THE TWO READS AGREE ON THE TRIPLE THAT CARRIES THE MEANING: same code, same no-session marker, same
// medium -- named in both reads or named in neither -- across two attempts. A claim about what a code means
// stands on this conjunction, not on either read alone.
fn reads_agree_on_the_ejected_row(a: MegaRacMediaRowReceipt, b: MegaRacMediaRowReceipt) -> Bool {
  a.redirection_status == b.redirection_status
    && a.session_index == b.session_index
    && optional_image_names_agree(a: a, b: b)
    && a.run_id != b.run_id
}

// FIELD BY FIELD, AS THIS REPOSITORY COMPARES STRUCTURES: two receipts name the same medium when both name
// one and the strings match, or when neither names one at all. One side naming and the other not is a
// disagreement, not a match -- the case the 0 arm must never be reached by.
fn optional_image_names_agree(a: MegaRacMediaRowReceipt, b: MegaRacMediaRowReceipt) -> Bool {
  match a.image_name {
    Absent => match b.image_name {
      Absent => true
      Present { value: _ } => false
    }
    Present { value: left } => match b.image_name {
      Absent => false
      Present { value: right } => (left as String) == (right as String)
    }
  }
}

test fn w_the_build_reports_a_different_wire_for_a_non_presenting_cd_than_the_probe_did() -> Bool {
  boot_run_40264233543_end_media_row.redirection_status == 16
    && boot_run_40258937016_end_media_row.redirection_status == boot_run_40264233543_end_media_row.redirection_status
    && boot_run_40258937016_end_media_row.session_index == boot_run_40264233543_end_media_row.session_index
    && boot_run_40258937016_end_media_row.media_index == boot_run_40264233543_end_media_row.media_index
    && boot_run_40258937016_end_media_row.observed_at != boot_run_40264233543_end_media_row.observed_at
}

// HOW THE VENDOR'S OWN PAGE DRAWS A MEDIA ROW, READ FROM THE BYTES IT SERVES. SP-X renders the Image
// Redirection table client-side, so what a person sees in a row is whatever the served renderer writes for
// the row's members. fleet-converge run 42592868662 (srv1) fetched the page, the asset the page names
// (/source.min.js, 6609861 octets) and recorded hex windows of it by octet offset
// (gunbc.machine_intake.mtcollins1_ui_status_asset_observation); the committed artifact named below is that
// run's output, and each rule here is the decoded text of a window at the offset given. These are rules of
// the RENDERER, the same for every row: they say how a member is drawn, not what any one row held.
// THE CATALOGUE STRINGS ARE OCCURRENCES, NOT A BINDING. The asset carries three member-shaped lmedia blocks;
// the observation reads the first (English) one's members -- status_0 is the single octet 0x7e, "~", halted is
// "Stopped", status_16 is " - Device Ejected" -- and marks them raw occurrences, not the binding the page
// used. What binds them to the page is the operator's reading of it (mtcollins1_cd_row_status_zero_ui_attestation,
// "~"; mtcollins1_cd_row_ui_attestation, "Stopped - Device Ejected"), each of which matches the renderer's rule
// for its code drawn through these strings.
type MegaRacUiMediaRowRendering {
  run_id: NonEmptyStr
  artifact_path: NonEmptyStr
  artifact_sha256: NonEmptyStr
  asset_path: NonEmptyStr
  asset_octets: Int
  // `255==s?"N/A":s` -- the session cell. "N/A" on the page IS the no-session marker on the wire.
  session_rule: NonEmptyStr
  session_rule_octet: Int
  session_rendered_absent: NonEmptyStr
  session_wire_rendered_absent: Int
  // The status-0 branch: drawn with the catalogue string keyed lmedia:status_0, and NOT with lmedia:halted.
  status_zero_rule: NonEmptyStr
  status_zero_rule_octet: Int
  status_zero_label: NonEmptyStr
  status_zero_label_octet: Int
  // The branch every code other than 0, 1 and 100 takes: lmedia:halted ("Stopped") first, then the code's own
  // string for codes up to 17 -- which is how 16 reads "Stopped - Device Ejected".
  halted_rule: NonEmptyStr
  halted_rule_octet: Int
  halted_label: NonEmptyStr
  // The image-name cell is written ONLY when the row's image_name is non-empty; for an empty one the renderer
  // leaves the cell to whatever else writes it, which the captured windows do not show.
  image_name_rule: NonEmptyStr
  image_name_rule_octet: Int
  artifact_lines: NonEmptyStr
}

data mtcollins1_ui_media_row_rendering: MegaRacUiMediaRowRendering = MegaRacUiMediaRowRendering {
  run_id: "42592868662" as NonEmptyStr,
  artifact_path: "artifacts/bmc/mtcollins1-ui-status-asset-observation-run-42592868662/mtcollins1-ui-status-asset-observation.txt" as NonEmptyStr,
  artifact_sha256: "b4b2aa31cc3b06277eafd68a5249e95c0814077e48b70f5e56437c20f867393c" as NonEmptyStr,
  asset_path: "/source.min.js" as NonEmptyStr,
  asset_octets: 6609861,
  session_rule: "255==s?\"N/A\":s" as NonEmptyStr,
  session_rule_octet: 3180840,
  session_rendered_absent: "N/A" as NonEmptyStr,
  session_wire_rendered_absent: 255,
  status_zero_rule: "\"0\"==r&&(l=!0,this.$(\".redirection_status\").html(a.t(\"lmedia:status_\"+r)))" as NonEmptyStr,
  status_zero_rule_octet: 3180560,
  status_zero_label: "~" as NonEmptyStr,
  status_zero_label_octet: 5487910,
  halted_rule: "a.t(\"lmedia:halted\")" as NonEmptyStr,
  halted_rule_octet: 3180393,
  halted_label: "Stopped" as NonEmptyStr,
  image_name_rule: "\"\"!=i&&this.$(\".image_name\").html(i)" as NonEmptyStr,
  image_name_rule_octet: 3180247,
  artifact_lines: "25-34 (renderer windows), 176-179 (lmedia block 0)" as NonEmptyStr,
}

// THE OPERATOR'S READING OF THE STATUS-0 ROW. On 2026-11-09 the operator opened mtcollins1's Image
// Redirection page and recorded, verbatim: "Media Type: CD/DVD | Media Instance: 0 | Image Name:
// gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-6455b3b9ae11214d.iso | Redirection Status: ~ | Session Index:
// N/A" (relayed by merry-fox-82, dashboard msg_d80de354). It is the same kind of record as the 2026-10-26
// reading above and is kept for the same reason: a person reading a vendor page is an observation this
// repository makes. What it establishes, joined to the renderer: the row machine-read as status 0 is drawn
// "~" with no session -- not "Stopped", the word the same page uses for 16.
data mtcollins1_cd_row_status_zero_ui_attestation: BmcMediaRowUiAttestation = BmcMediaRowUiAttestation {
  row_label: "CD/DVD" as NonEmptyStr,
  media_instance: 0,
  image_name: "gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-6455b3b9ae11214d.iso" as NonEmptyStr,
  state_label: "~" as NonEmptyStr,
  detail_label: "N/A" as NonEmptyStr,
  read_on_day: "2026-11-09" as NonEmptyStr,
  read_by: "operator" as NonEmptyStr,
}

// DOES THE PAGE DRAW THIS ATTESTED ROW AS THE RENDERER DRAWS STATUS 0 WITH NO SESSION? Both cells must be the
// renderer's own strings for that pair: the status cell the status-0 label, the session cell the no-session
// rendering. A row the page calls "Stopped..." fails here, so the 16 reading cannot pass as a 0 reading, and
// an attestation of a live session (any other session cell) cannot either.
fn attestation_draws_status_zero_without_a_session(attestation: BmcMediaRowUiAttestation, rendering: MegaRacUiMediaRowRendering) -> Bool {
  (attestation.state_label as String) == (rendering.status_zero_label as String)
    && (attestation.detail_label as String) == (rendering.session_rendered_absent as String)
    && !string_contains(s: attestation.state_label as String, pattern: rendering.halted_label as String)
}

// WHERE THE PAGE AND THE WIRE DISAGREE ON THE IMAGE NAME, KEPT. The operator's page shows an image name in
// the row boot run 42663208460 machine-read as naming none. One reading of why is that the renderer writes
// the name cell only for a non-empty image_name (mtcollins1_ui_media_row_rendering image_name_rule) and the
// page fills an empty one from somewhere else, such as the configured image list -- but what fills it was
// not in the captured windows, so that is a BET, and it is typed as one here (gunbc.design_argument::epistemic_humility).
// Nothing reads this to decide anything: whether a session is live does not depend on the name.
type MediaRowUiImageNameSourceBet
  = UiNameMayComeFromOutsideTheRow { renderer_fragment: NonEmptyStr, fragment_octet: Int, unread: NonEmptyStr }

type MediaRowImageNameJoin
  = ImageNamesAgree
  | ImageNamesDisagreeUnexplained { ui_name: NonEmptyStr, read_name: NonEmptyStr?, bet: MediaRowUiImageNameSourceBet }

type MediaRowUiReadJoin
  = UiAndReadSameRowByPosition { image_names: MediaRowImageNameJoin }
  | UiAndReadNotTheSameRow

// JOIN A PAGE READING TO A MACHINE READ BY POSITION, NEVER BY NAME: the CD/DVD row type (the renderer draws
// media_type 1 as its CD/DVD string) and the instance the page numbers it with, which it renders from the
// row's media_index. The image name is then compared and its answer carried, agreeing or not, because a
// disagreement dropped here would be the one observation nobody can explain disappearing.
fn ui_attestation_and_read_join(attestation: BmcMediaRowUiAttestation, read: MegaRacMediaRowReceipt, rendering: MegaRacUiMediaRowRendering) -> MediaRowUiReadJoin {
  if string_contains(s: attestation.row_label as String, pattern: "CD/DVD") && read.media_type == 1 && attestation.media_instance == read.media_index {
    let bet = UiNameMayComeFromOutsideTheRow {
      renderer_fragment: rendering.image_name_rule,
      fragment_octet: rendering.image_name_rule_octet,
      unread: "what writes the image-name cell when the row's image_name is empty was not in the captured windows" as NonEmptyStr,
    }
    match read.image_name {
      Present { value: named } =>
        if (named as String) == (attestation.image_name as String) {
          UiAndReadSameRowByPosition { image_names: ImageNamesAgree }
        } else {
          UiAndReadSameRowByPosition { image_names: ImageNamesDisagreeUnexplained { ui_name: attestation.image_name, read_name: read.image_name, bet: bet } }
        }
      Absent => UiAndReadSameRowByPosition { image_names: ImageNamesDisagreeUnexplained { ui_name: attestation.image_name, read_name: read.image_name, bet: bet } }
    }
  } else {
    UiAndReadNotTheSameRow
  }
}
