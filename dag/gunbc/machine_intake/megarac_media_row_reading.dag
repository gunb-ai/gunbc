// 0 -- the same triple boot run 41573858366 read. The attempt refused on it, as the code then stood; it is
// the reading the operator's 2026-11-09 page reading (mtcollins1_cd_row_status_zero_ui_attestation) was taken
// against.
data boot_run_42663208460_end_media_row: MegaRacMediaRowReceipt = {
  run_id: "42663208460" as NonEmptyStr,
  observed_at: 1794246503832,
  artifact_path: "artifacts/bmc/mtcollins1-boot-run-42663208460/mtcollins1-boot-diagnostics.txt" as NonEmptyStr,
  artifact_sha256: "87c611fe398680552d367e06bbb37bba9ca635e1a8b0e469ee86407a97210546" as NonEmptyStr,
  artifact_lines: "3, 117, 2066" as NonEmptyStr,
  media_type: 1,
  media_index: 0,
  session_index: 255,
