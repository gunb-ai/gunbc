module gunbc.machine_intake.megarac_media_row_reading

// WHAT ONE READ OF A MEGARAC CD/DVD MEDIA ROW SAID, KEPT AS A RECEIPT OF THAT READ. The boot lanes print
// the rows they read; this module keeps the row a read carried, with the artifact the line lives in and
// the digest that file is committed under, so a claim about what a status MEANS can point at the read
// instead of at a sentence in a comment. These are receipts of reads THIS repository made (DESIGN.md §3):
// the codes are recorded exactly as the controller answered them, and what they mean is established once,
// in extdeps.bmc.megarac, keyed to these run ids.
//
// WHY THESE RECEIPTS AND NOT MORE. Code 16 is the state the mtcollins1 controller reports for the CD/DVD row
// between attempts, and it is the reason boot run 40264233543 stopped at attach. It was read as a ROW -- this
// status beside the no-session marker -- and never as a bare code, so the row is what is retained, and the
// meaning follows only as far as the row was read. The fourth receipt, boot_run_41573858366_end_media_row,
// is a DIFFERENT code (0) on the same row position, read by the attempt after that one, and it is retained
// for the same reason: it is the only reading of wire 0 this release holds. The code is NOT admitted anywhere
// -- extdeps.bmc.megarac answers it as the uncatalogued wire the vendor leaves it, and
// gunbc.machine_intake.megarac_media_attach megarac_status_zero_row_inference carries what this repository
// makes of that one reading as a bet no lane acts on, its guard written no wider than the row that was read.
// Retaining the reading is what lets a refusal name its evidence; it is not a step toward admitting the code.

import std.algebra { string_contains }
import std.types { Bool, Int, NonEmptyStr }

type MegaRacMediaRowReceipt {
  run_id: NonEmptyStr
  observed_at: Int
  artifact_path: NonEmptyStr
  artifact_sha256: NonEmptyStr
  artifact_lines: NonEmptyStr
  media_type: Int
  media_index: Int
  session_index: Int
  // THE MEDIUM THE ROW NAMES, OR NOTHING. The controller answers the empty string for a leftover row that
  // names no image, and this layer keeps that as `none` rather than a name that happens to be empty: a row
  // naming no medium is a different case from a row whose name is "", and `none` is what boot run
  // 41573858366 actually read. The reading of that answer is what the inference below -- and the refusal it
  // produces -- is keyed to; nothing promotes a code from a value a row carried.
  image_name: NonEmptyStr?
  redirection_status: Int
}

// THE ROW BOOT RUN 40258937016 LEFT AT THE END OF ITS ATTEMPT, read back at 1792983408184 and quoted
// verbatim on the line named below: media_type 1, media_index 0, session_index 255, the runner medium,
// redirection_status 16. That run's own hpm check committed the release it ran on (APP Active 0.45), so
// this is a read ON that build -- not a reading of the page label "0.45.3", which no wire has ever
// carried. The same line records cd_error_code 16; WHAT AN ERROR CODE 16 MEANS WAS NEVER ESTABLISHED, and
// nothing here is read through it.
data boot_run_40258937016_end_media_row: MegaRacMediaRowReceipt = MegaRacMediaRowReceipt {
  run_id: "40258937016" as NonEmptyStr,
  observed_at: 1792983408184,
  artifact_path: "artifacts/bmc/mtcollins1-boot-run-40258937016/mtcollins1-boot-diagnostics.txt" as NonEmptyStr,
  artifact_sha256: "16a18fed0a9630d33194fef1a0a5efb80807f64b2363ad7e63f94cc44dec498f" as NonEmptyStr,
  artifact_lines: "2055" as NonEmptyStr,
  media_type: 1,
  media_index: 0,
  session_index: 255,
  image_name: Present { value: "gunbc-runner-host-ubuntu-24.04.3-arm64-31aef9394d9e58c3.iso" as NonEmptyStr },
  redirection_status: 16,
}

// THE ROW BOOT RUN 41573858366 (the seventh boot attempt) MET AT THE END OF ITS ATTEMPT, read back at
// 1793678673678 and quoted verbatim on the line named below: media_type 1, media_index 0, session_index 255,
// NO medium named, redirection_status 0. This is the FIRST reading of wire 0 on the release the controller
// reports that this repository holds, and it is the whole of what this repository's own inference rests on.
// The upstream's fold answers 0 as an uncatalogued wire and goes no further -- the vendor's catalogue does not
// name it (extdeps.bmc.megarac megarac_redirection_status_of_row). What this repository makes of the reading
// lives with the reading, at gunbc.machine_intake.megarac_media_attach
// megarac_status_zero_row_inference. The resemblance it carries there is an INFERENCE rather than a state,
// because what was read is that the row PRESENTS 0 while naming nothing, not that the controller calls 0
// stopped on the release it runs; the one arm of that fold that IS a state is the attested one, and it is
// unreachable while mtcollins1_cd_row_ui_attestation_status_zero below is `none`. No lane acts on the
// inference; an operator read of the vendor's own UI for this row is what would settle it. THE ATTEMPT WAS HALTED AT MEDIA ATTACH
// BY THIS ROW: the lane would not stop it (it names no image, so nothing identifies it as this lane's) and 0
// was not a code this release's catalogue named, so nothing was written, no session was started and the host
// was never powered on. Committing this reading does not lift that refusal: the row is still unread to the
// lane, now with a cause that names the inference and the one reading that would settle it. The refusal that
// says so is the `harness=` line of
// artifacts/bmc/mtcollins1-boot-run-41573858366/mtcollins1-boot-receipt.txt, which quotes this same row.
data boot_run_41573858366_end_media_row: MegaRacMediaRowReceipt = {
  run_id: "41573858366" as NonEmptyStr,
  observed_at: 1793678673678,
  artifact_path: "artifacts/bmc/mtcollins1-boot-run-41573858366/mtcollins1-boot-diagnostics.txt" as NonEmptyStr,
  artifact_sha256: "838a763be6c8abee7cf592ffa1f348310cb4041fd4abe8eb03d9154cc29c833e" as NonEmptyStr,
  artifact_lines: "2062" as NonEmptyStr,
  media_type: 1,
  media_index: 0,
  session_index: 255,
  image_name: Absent,
  redirection_status: 0,
}

// THE SAME ROW AS THE NEXT ATTEMPT MET IT: boot run 40264233543 read the identical triple and REFUSED at
// media attach on it -- the refusal sentence and the end-of-attempt row are both in the file below (its
// hpm check committed the same APP Active 0.45 build). One attempt's row could be an accident of that
// attempt; the same triple across two attempts, one of which stopped on it, is what makes the state worth
// naming.
data boot_run_40264233543_end_media_row: MegaRacMediaRowReceipt = MegaRacMediaRowReceipt {
  run_id: "40264233543" as NonEmptyStr,
  observed_at: 1792996207072,
  artifact_path: "artifacts/bmc/mtcollins1-boot-run-40264233543/mtcollins1-boot-diagnostics.txt" as NonEmptyStr,
  artifact_sha256: "e419f3fcc65dea77b6774ae037067c82a03acf3e3784ea4ef5f63be8d41b2822" as NonEmptyStr,
  artifact_lines: "117, 2055" as NonEmptyStr,
  media_type: 1,
  media_index: 0,
  session_index: 255,
  image_name: Present { value: "gunbc-runner-host-ubuntu-24.04.3-arm64-31aef9394d9e58c3.iso" as NonEmptyStr },
  redirection_status: 16,
}

// THE SESSION MARKER OF A SESSION THAT WAS LIVE, from boot run 40258937016's handoff read at 1792983328762:
// "row started, session_index 0". THE COUNTER-EVIDENCE, kept so the shape of the 16 claim cannot drift: a
// session this build reports as STARTED carries index 0, not 255. So "16 beside an active index" is a
// different observation from the one that was made, it has never been made here, and it stays unread.
type MegaRacSessionMarkerReceipt {
  run_id: NonEmptyStr
  observed_at: Int
  artifact_path: NonEmptyStr
  artifact_sha256: NonEmptyStr
  artifact_lines: NonEmptyStr
  session_index: Int
  row_state_as_read: NonEmptyStr
}

data boot_run_40258937016_started_session_marker: MegaRacSessionMarkerReceipt = MegaRacSessionMarkerReceipt {
  run_id: "40258937016" as NonEmptyStr,
  observed_at: 1792983328762,
  artifact_path: "artifacts/bmc/mtcollins1-boot-run-40258937016/mtcollins1-boot-diagnostics.txt" as NonEmptyStr,
  artifact_sha256: "16a18fed0a9630d33194fef1a0a5efb80807f64b2363ad7e63f94cc44dec498f" as NonEmptyStr,
  artifact_lines: "2054" as NonEmptyStr,
  session_index: 0,
  row_state_as_read: "row started" as NonEmptyStr,
}

// THE VENDOR'S OWN WORDS FOR THAT ROW, FROM A HUMAN READING THE CONTROLLER'S PAGE -- NOT A MACHINE READ.
// On 2026-10-26 the operator opened mtcollins1's web UI and recorded how the vendor LABELS the row this
// repository keeps meeting: the CD/DVD 0 entry naming the runner medium, shown as "Stopped - Device
// Ejected", with no value in its detail column ("N/A"). It is typed as an attestation because no artifact
// bytes stand behind it and no reader in this corpus produced it; it is dated because an undated UI
// reading is unfalsifiable; and it is kept HERE, in the observing layer, because a person reading a vendor
// page is an observation this repository makes, not a fact of the upstream product (DESIGN.md §3). What it
// can do is corroborate: it says the vendor's own name for this row's state is stopped and ejected, i.e.
// NOT PRESENTING. It cannot supply the code, the index, or the release -- those come only from the reads
// above.
type BmcMediaRowUiAttestation {
  row_label: NonEmptyStr
  // THE MEDIUM THE PAGE NAMES, OR NOTHING. A row whose image cell is blank is recorded as `none`, the way
  // the machine read records it, and NOT as a transcription of the blank (an empty string, a dash, "N/A"):
  // the pairing fold below compares the two readings' medium, and a placeholder matched against an empty
  // read would be exactly the false agreement that licenses a boot on nothing. Whatever the page actually
  // PRINTS in that cell is still worth keeping, and it goes in `detail_label`, which is never compared.
  image_name: NonEmptyStr?
  state_label: NonEmptyStr
  detail_label: NonEmptyStr
  read_on_day: NonEmptyStr
  read_by: NonEmptyStr
}

data mtcollins1_cd_row_ui_attestation: BmcMediaRowUiAttestation = BmcMediaRowUiAttestation {
  row_label: "CD/DVD 0" as NonEmptyStr,
  image_name: Present { value: "gunbc-runner-host-ubuntu-24.04.3-arm64-31aef9394d9e58c3.iso" as NonEmptyStr },
  state_label: "Stopped - Device Ejected" as NonEmptyStr,
  detail_label: "N/A" as NonEmptyStr,
  read_on_day: "2026-10-26" as NonEmptyStr,
  read_by: "operator" as NonEmptyStr,
}

// THE SAME KIND OF READING, FOR THE ROW THAT IS STILL A BET. The status-0 CD row boot run 41573858366 read
// (boot_run_41573858366_end_media_row: code 0, the no-session marker, no medium named) has NO attestation
// yet -- nobody has read the controller's page for a row that names no medium -- so
// gunbc.machine_intake.megarac_media_attach megarac_status_zero_row_inference keeps answering with the bet,
// which no lane acts on. THIS is the one missing piece of that promotion, and it is left as a typed absence
// rather than filled in: it becomes Present { value: BmcMediaRowUiAttestation { ... } } when, and only when,
// an operator records for THAT row whether the image cell is empty or what it prints (verbatim), the state
// cell's words (attestation_labels_a_stopped_and_ejected_row requires both "Stopped" and "Ejected" -- if the
// page's words are not those, the finding is reported, not the fold bent), the date, and the row label as the
// page shows it. The fold it feeds decides whether a boot may start, so nothing here may be inferred
// (DESIGN.md §4d).
data mtcollins1_cd_row_ui_attestation_status_zero: BmcMediaRowUiAttestation? = none

// THE VENDOR'S TWO WORDS FOR A ROW THAT IS PRESENTING NOTHING, spelled once. These are the controller
// page's words, not the repository's; the refusal text in gunbc.machine_intake.megarac_media_attach quotes
// the same two, so a rename that missed one of them would have the lane refuse a row for a reason the
// diagnostic then misquotes.
data megarac_stopped_ui_word: NonEmptyStr = "Stopped"

data megarac_ejected_ui_word: NonEmptyStr = "Ejected"

// DOES THE VENDOR'S LABEL DESCRIBE A ROW THAT IS NOT PRESENTING? Only two of the page's own words are
// accepted, and BOTH are required: a row the page calls Stopped AND Ejected. Any other label -- "Connected",
// "In Use", an empty cell, or a label that says stopped without saying ejected -- fails this, so an
// attestation of some other state cannot be pushed through it to license a boot.
fn attestation_labels_a_stopped_and_ejected_row(attestation: BmcMediaRowUiAttestation) -> Bool {
  string_contains(s: attestation.state_label as String, pattern: megarac_stopped_ui_word as String)
    && string_contains(s: attestation.state_label as String, pattern: megarac_ejected_ui_word as String)
}

// DO THE ATTESTATION AND A MACHINE READ DESCRIBE THE SAME ROW? The medium and the CD/DVD row, and nothing
// more. This deliberately does NOT say "the label means code 16" or "code 0": it only records that the two
// readings are about one row, which is what lets the vendor's words corroborate a read without becoming the
// evidence for it. Absence is a case on BOTH sides: a row whose cell is blank on the controller and blank on
// the page is the same row, and a reading that named a medium is a DIFFERENT row from one that named none --
// which is why code 0 cannot borrow code 16's attestation, whose medium is named.
fn attestation_and_read_name_the_same_row(attestation: BmcMediaRowUiAttestation, read: MegaRacMediaRowReceipt) -> Bool {
  match read.image_name {
    Absent => match attestation.image_name {
      Absent => string_contains(s: attestation.row_label as String, pattern: "CD/DVD")
      Present { value: _ } => false
    }
    Present { value: named } => match attestation.image_name {
      Absent => false
      Present { value: attested } => (attested as String) == (named as String)
        && string_contains(s: attestation.row_label as String, pattern: "CD/DVD")
    }
  }
}

// THE VENDOR UI'S OWN MAPPING, READ FROM THE SERVED ASSET, FOR THE STATUS-0 MEDIA ROW. A distinct type from
// BmcMediaRowUiAttestation on purpose: that one is an operator's reading of a row's cells and is what the
// operator-path consumers (attestation_labels_a_stopped_and_ejected_row,
// attestation_and_read_name_the_same_row) take; this one is an excerpt of the page's code and licenses ONLY
// "the vendor UI maps status code 0 to `label` on the media-row branch". It carries no image cell and no
// row label, so it cannot be passed where an attestation is required (ruling: PR-E row identity (B)).
// The offsets are the byte positions the observation published (feeding_site_offset, marker_offset,
// zero_key_offset on ExcerptFound), as plain Ints so this layer imports nothing from the observer.
type MegaRacUiExcerptStatusLabel {
  label: NonEmptyStr
  published_key: Int
  feeding_site_offset: Int
  marker_offset: Int
  zero_key_offset: Int
}

// DOES THE EXCERPT NAME THE MEDIA-ROW BRANCH'S LABEL FOR THE CODE A MACHINE READ OF A NO-MEDIUM CD/DVD ROW
// CARRIED? Four conjuncts, none of which is the operator-path test loosened: the media-row marker lies
// strictly between the feeding site and the zero key (so the key belongs to the branch the marker opens, not
// to a neighbouring one), the read is a CD/DVD row naming no medium, the read's code is 0, and the key the
// excerpt published IS that code. It never says the row "names the same medium" -- there is none to name --
// so a consumer needing a medium match gets no licence from it.
fn excerpt_arm_names_the_status_zero_media_row(excerpt: MegaRacUiExcerptStatusLabel, read: MegaRacMediaRowReceipt) -> Bool {
  excerpt.feeding_site_offset < excerpt.marker_offset
    && excerpt.marker_offset < excerpt.zero_key_offset
    && read.media_type == boot_run_41573858366_end_media_row.media_type
    && read.redirection_status == 0
    && excerpt.published_key == read.redirection_status
    && match read.image_name {
      Absent => true
      Present { value: _ } => false
    }
}

// THE TWO READS AGREE ON THE TRIPLE THAT CARRIES THE MEANING: same code, same no-session marker, same
// medium -- named in both reads or named in neither -- across two attempts. A claim about what a code means
// stands on this conjunction, not on either read alone.
fn reads_agree_on_the_ejected_row(a: MegaRacMediaRowReceipt, b: MegaRacMediaRowReceipt) -> Bool {
  a.redirection_status == b.redirection_status
    && a.session_index == b.session_index
    && optional_image_names_agree(a: a, b: b)
    && a.run_id != b.run_id
}

// FIELD BY FIELD, AS THIS REPOSITORY COMPARES STRUCTURES: two receipts name the same medium when both name
// one and the strings match, or when neither names one at all. One side naming and the other not is a
// disagreement, not a match -- the case the 0 arm must never be reached by.
fn optional_image_names_agree(a: MegaRacMediaRowReceipt, b: MegaRacMediaRowReceipt) -> Bool {
  match a.image_name {
    Absent => match b.image_name {
      Absent => true
      Present { value: _ } => false
    }
    Present { value: left } => match b.image_name {
      Absent => false
      Present { value: right } => (left as String) == (right as String)
    }
  }
}

test fn w_the_build_reports_a_different_wire_for_a_non_presenting_cd_than_the_probe_did() -> Bool {
  boot_run_40264233543_end_media_row.redirection_status == 16
    && boot_run_40258937016_end_media_row.redirection_status == boot_run_40264233543_end_media_row.redirection_status
    && boot_run_40258937016_end_media_row.session_index == boot_run_40264233543_end_media_row.session_index
    && boot_run_40258937016_end_media_row.media_index == boot_run_40264233543_end_media_row.media_index
    && boot_run_40258937016_end_media_row.observed_at != boot_run_40264233543_end_media_row.observed_at
}


// THE EXCERPT ARM'S ROW-IDENTITY TEST, PINNED. The positive control is an excerpt whose offsets order
// feeding_site < marker < zero_key and whose published key is the code boot run 41573858366 read (0). The
// offsets here are ORDER FIXTURES, not the published receipt's numbers; the receipt of fleet-converge run
// 42042565485 is cited where it is consumed, not copied into a fixture that would then stand for it.
data excerpt_arm_order_fixture: MegaRacUiExcerptStatusLabel = MegaRacUiExcerptStatusLabel {
  label: "Stopped" as NonEmptyStr,
  published_key: 0,
  feeding_site_offset: 10,
  marker_offset: 20,
  zero_key_offset: 30,
}

test fn w_the_excerpt_arm_names_the_status_zero_row_when_ordered_and_keyed_to_the_read_code() -> Bool {
  excerpt_arm_names_the_status_zero_media_row(excerpt: excerpt_arm_order_fixture, read: boot_run_41573858366_end_media_row)
}

test fn w_the_excerpt_arm_refuses_a_marker_outside_the_feeding_site_to_zero_key_span() -> Bool {
  !excerpt_arm_names_the_status_zero_media_row(
    excerpt: MegaRacUiExcerptStatusLabel { label: excerpt_arm_order_fixture.label, published_key: 0, feeding_site_offset: 10, marker_offset: 5, zero_key_offset: 30 },
    read: boot_run_41573858366_end_media_row,
  )
    && !excerpt_arm_names_the_status_zero_media_row(
      excerpt: MegaRacUiExcerptStatusLabel { label: excerpt_arm_order_fixture.label, published_key: 0, feeding_site_offset: 10, marker_offset: 40, zero_key_offset: 30 },
      read: boot_run_41573858366_end_media_row,
    )
}

test fn w_the_excerpt_arm_refuses_a_key_that_is_not_the_read_code_and_a_read_that_names_a_medium() -> Bool {
  !excerpt_arm_names_the_status_zero_media_row(
    excerpt: MegaRacUiExcerptStatusLabel { label: excerpt_arm_order_fixture.label, published_key: 16, feeding_site_offset: 10, marker_offset: 20, zero_key_offset: 30 },
    read: boot_run_41573858366_end_media_row,
  )
    && !excerpt_arm_names_the_status_zero_media_row(excerpt: excerpt_arm_order_fixture, read: boot_run_40264233543_end_media_row)
}
