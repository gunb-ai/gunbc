// THE DIAGNOSTIC BUNDLE OF ONE mtcollins1 BOOT ATTEMPT: what the BMC and the pre-OS console
// said about the machine around the attempt, recorded on every terminal arm so that a remote
// operator can diagnose a failed or degraded boot from the run's artifact alone (operator,
// 2026-09-23: run 35793279839 came up with socket 1 absent and nothing in its receipts said why).
//
// DESIGN section 3b, observability row, and the four responsibilities it names. The owning
// domains establish the facts: the SEL record formats are extdeps.bmc.ipmi_sel and their
// before/after reading is gunbc.machine_intake.sel_stimulus_listener; the per-slot and
// per-socket inventory is extdeps.bmc.redfish_memory_inventory; the firmware's pre-OS statement
// is gunbc.machine_intake.pre_os_bringup_verdict firmware_console_report. This module is the
// observation model of ONE attempt (BootDiagnosticBundle), and megarac_boot_bundle_text
// renders it. It does not decode anything those authorities do not.
//
// THE BUNDLE NEVER DECIDES THE VERDICT (brief, and DESIGN section 5's separation of observation
// from judgment). megarac_boot_outcome_with_findings only appends what was found to a refusal
// reason. WHAT WAS FOUND IS TYPED, TWO WAYS: what the MACHINE did is the power-on fold's
// PowerOnAccount (gunbc.machine_intake.mtcollins1_power_on_account; docs/plans/power-on-sequence-model.md),
// and what OUR HARNESS did -- media, handoff, override, power after, the BMC's reachability, the
// credential -- is a HarnessFinding. Neither is a list of strings. It never turns a success into a failure or a failure into a success, and the witness
// asserts both directions.
//
// A READ THAT FAILS IS A TYPED, LOCATED READING IN THE BUNDLE, NEVER A MISSING SECTION (DESIGN
// section 5). Every section has an arm for "read", one for "the read failed, and why, at which
// endpoint, at what instant", and one for "the attempt ended before this could be read, and
// why". A BMC that does not answer (operator, 2026-09-23: 192.168.1.228 unreachable after a DIMM
// reseat) is itself a diagnosis, so it has its own arm.
// WHY A BMC READ FAILED. Every arm carries the endpoint it addressed and the instant of the
// attempt. The transport's own exit code and stderr are the evidence: curl 6/7 (name not
// resolved, connection refused or host unreachable), curl 28 (timeout), curl 22 with an HTTP
// 401/403 on stderr (authentication refused). ipmitool's lanplus session setup CANNOT tell an
// unreachable controller from one that refused the credential: both render "Unable to establish
// IPMI v2 / RMCP+ session". So that reading is BmcSessionUnestablished and is not split into
// either, which would be a guess (DESIGN section 4d).
type BmcReadCause
  = BmcUnreachable { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcTimeout { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcAuthRefused { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcSessionUnestablished { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcHttpRefused { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcReadFailed { endpoint: NonEmptyStr, at: NonEmptyStr, exit_code: Int, detail: String }
  | BmcResponseMalformed { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcCredentialUnavailable { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcCollectionIncomplete { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcDeadlineReached { endpoint: NonEmptyStr, at: NonEmptyStr, not_reached: String }
  | BmcLinkUnpublished { endpoint: NonEmptyStr, at: NonEmptyStr, property: NonEmptyStr }

fn bmc_read_cause_text(cause: BmcReadCause) -> String {
  match cause {
    BmcUnreachable { endpoint: e, at: a, detail: d } => concat("BMC unreachable at ", e as String, " (", a as String, "): ", d)
    BmcTimeout { endpoint: e, at: a, detail: d } => concat("BMC timed out at ", e as String, " (", a as String, "): ", d)
    BmcAuthRefused { endpoint: e, at: a, detail: d } => concat("BMC refused the credential at ", e as String, " (", a as String, "): ", d)
    BmcSessionUnestablished { endpoint: e, at: a, detail: d } => concat("no IPMI session at ", e as String, " (", a as String, "; unreachable and credential-refused are indistinguishable on this transport): ", d)
    BmcHttpRefused { endpoint: e, at: a, detail: d } => concat("BMC answered with an HTTP error at ", e as String, " (", a as String, "): ", d)
    BmcReadFailed { endpoint: e, at: a, exit_code: c, detail: d } => concat("BMC read failed at ", e as String, " (", a as String, ", exit ", to_string(c), "): ", d)
    BmcResponseMalformed { endpoint: e, at: a, detail: d } => concat("BMC response unreadable at ", e as String, " (", a as String, "): ", d)
    BmcCredentialUnavailable { endpoint: e, at: a, detail: d } => concat("no credential could be presented to ", e as String, " (", a as String, "): ", d)
    BmcCollectionIncomplete { endpoint: e, at: a, detail: d } => concat("collection incomplete at ", e as String, " (", a as String, "): ", d)
    BmcDeadlineReached { endpoint: e, at: a, not_reached: n } => concat("diagnostics read budget spent before ", e as String, " (", a as String, "); not reached: ", n)
    BmcLinkUnpublished { endpoint: e, at: a, property: p } => concat("the resource at ", e as String, " (", a as String, ") publishes no ", p as String, " link, so nothing beyond it was requested")
  }
}

// A CAUSE THAT DEFINITIVELY SAYS THE BMC DID NOT ANSWER: the transport established that nothing
// answered at all or in time. BmcSessionUnestablished is NOT one: ipmitool renders an unreachable
// controller and a refused credential identically. Nor is any cause that carries an answer (an
// HTTP status, a malformed body, an incomplete collection) or that no read was made for.
fn bmc_read_cause_is_definitive_no_answer(cause: BmcReadCause) -> Bool {
  match cause {
    BmcUnreachable { endpoint: _, at: _, detail: _ } => true
    BmcTimeout { endpoint: _, at: _, detail: _ } => true
    BmcAuthRefused { endpoint: _, at: _, detail: _ } => false
    BmcSessionUnestablished { endpoint: _, at: _, detail: _ } => false
    BmcHttpRefused { endpoint: _, at: _, detail: _ } => false
    BmcReadFailed { endpoint: _, at: _, exit_code: _, detail: _ } => false
    BmcResponseMalformed { endpoint: _, at: _, detail: _ } => false
    BmcCredentialUnavailable { endpoint: _, at: _, detail: _ } => false
    BmcCollectionIncomplete { endpoint: _, at: _, detail: _ } => false
    BmcDeadlineReached { endpoint: _, at: _, not_reached: _ } => false
    BmcLinkUnpublished { endpoint: _, at: _, property: _ } => false
  }
}

fn bmc_read_cause_kind(cause: BmcReadCause) -> String {
  match cause {
    BmcUnreachable { endpoint: _, at: _, detail: _ } => "unreachable"
    BmcTimeout { endpoint: _, at: _, detail: _ } => "timed out"
    BmcAuthRefused { endpoint: _, at: _, detail: _ } => "credential refused"
    BmcSessionUnestablished { endpoint: _, at: _, detail: _ } => "no IPMI session (unreachable and credential-refused are indistinguishable)"
    BmcHttpRefused { endpoint: _, at: _, detail: _ } => "answered with an HTTP error"
    BmcReadFailed { endpoint: _, at: _, exit_code: _, detail: _ } => "read failed"
    BmcResponseMalformed { endpoint: _, at: _, detail: _ } => "answered unreadably"
    BmcCredentialUnavailable { endpoint: _, at: _, detail: _ } => "no credential presented"
    BmcCollectionIncomplete { endpoint: _, at: _, detail: _ } => "collection incomplete"
    BmcDeadlineReached { endpoint: _, at: _, not_reached: _ } => "read budget spent"
    BmcLinkUnpublished { endpoint: _, at: _, property: _ } => "link unpublished"
  }
}

// THE AGGREGATE OVER BMC READS THAT ALL FAILED. "The BMC did not answer" is said only when EVERY
// cause is a definitive no-answer; otherwise each distinct kind is named, so an ambiguous IPMI
// session failure beside a Redfish timeout reads as exactly that and not as a verdict on the BMC.
fn bmc_all_failed_text(failed: FreeSemigroup<BmcChannelRead>) -> String {
  let failed_list = non_empty_to_list(xs: failed)
  let causes = flat_map(failed_list, r => match channel_cause(r: r) { Present { value: c } => [c] Absent => [] })
  let channels = concat("; failed channels: ", join(map(failed_list, r => r.channel as String), ", "))
  let empty: List<String> = []
  let kinds = fold(map(causes, c => bmc_read_cause_kind(cause: c)), init: empty, f: (acc, k) => if any(acc, j => j == k) { acc } else { concat(acc, [k]) })
  let first = match causes.first() { Absent => "" Present { value: c } => bmc_read_cause_text(cause: c) }
  if all(causes, c => bmc_read_cause_is_definitive_no_answer(cause: c)) {
    concat("every BMC read failed and the BMC did not answer; first: ", first, channels)
  } else {
    concat("every BMC read failed (", join(kinds, "; "), "); first: ", first, channels)
  }
}

fn first_line(s: String) -> String {
  match filter(map(split(s: s, delimiter: "\n"), l => trim(l)), l => l != "").first() {
    Absent => ""
    Present { value: l } => l
  }
}

fn bmc_curl_read_cause(endpoint: NonEmptyStr, at: NonEmptyStr, exit_code: Int, stderr: String) -> BmcReadCause {
  let detail = first_line(s: stderr)
  if exit_code == 6 || exit_code == 7 {
    BmcUnreachable { endpoint: endpoint, at: at, detail: detail }
  } else if exit_code == 28 {
    BmcTimeout { endpoint: endpoint, at: at, detail: detail }
  } else if exit_code == 22 && (string_contains(s: stderr, pattern: "error: 401") || string_contains(s: stderr, pattern: "error: 403")) {
    BmcAuthRefused { endpoint: endpoint, at: at, detail: detail }
  } else if exit_code == 22 {
    BmcHttpRefused { endpoint: endpoint, at: at, detail: detail }
  } else {
    BmcReadFailed { endpoint: endpoint, at: at, exit_code: exit_code, detail: detail }
  }
}

// ipmitool's lanplus renderings, as its source prints them: "RAKP 2 HMAC is invalid" and
// "Unauthorized name" come from the RAKP exchange rejecting the credential, and "Insufficient
// privilege level" is completion code D4h. Anything that failed to set up a session without one
// of those is BmcSessionUnestablished.
fn bmc_ipmitool_read_cause(endpoint: NonEmptyStr, at: NonEmptyStr, exit_code: Int, stderr: String) -> BmcReadCause {
  let detail = first_line(s: stderr)
  if exit_code == coreutils_timeout_expired_exit_code {
    BmcTimeout { endpoint: endpoint, at: at, detail: concat("no answer within the diagnostics deadline (coreutils timeout exit 124)", if detail == "" { "" } else { concat("; ", detail) }) }
  } else {
    match bmc_ipmitool_session_cause(endpoint: endpoint, at: at, stderr: stderr) {
      Present { value: c } => c
      Absent => BmcReadFailed { endpoint: endpoint, at: at, exit_code: exit_code, detail: detail }
    }
  }
}

// The session-setup half of that reading, which needs no exit code: a backgrounded collector
// (gunbc.machine_intake.sol_hold) has no exit status the workflow can read, only the lines it wrote.
fn bmc_ipmitool_session_cause(endpoint: NonEmptyStr, at: NonEmptyStr, stderr: String) -> BmcReadCause? {
  let detail = first_line(s: stderr)
  if string_contains(s: stderr, pattern: "RAKP 2 HMAC is invalid") || string_contains(s: stderr, pattern: "Unauthorized name") || string_contains(s: stderr, pattern: "Insufficient privilege level") {
    Present { value: BmcAuthRefused { endpoint: endpoint, at: at, detail: detail } }
  } else if string_contains(s: stderr, pattern: "Unable to establish IPMI v2") {
    Present { value: BmcSessionUnestablished { endpoint: endpoint, at: at, detail: detail } }
  } else {
    none
  }
}

// ONE SEL SNAPSHOT: the raw `sel elist` rows as the controller rendered them, or why there are none.
type SelSnapshotReading
  = SelSnapshotRead { raw: String, at: NonEmptyStr }
  | SelSnapshotUnread { cause: BmcReadCause }
  | SelSnapshotNotTaken { reason: NonEmptyStr }

// THE LOCAL SDR CACHE BOTH SEL SNAPSHOTS READ THROUGH (extdeps.bmc.ipmi SdrDumpAuthenticated): it
// is dumped once, before the boot, so the post-boot `sel elist` does not re-read the whole SDR
// repository from a controller that has just been power-cycled. A dump that failed is recorded with
// its cause and both snapshots then read uncached; it is a slower read, never a missing section.
type SdrCacheReading
  = SdrCacheDumped { path: NonEmptyStr, at: NonEmptyStr }
  | SdrCacheUnread { cause: BmcReadCause }
  | SdrCacheNotTaken { reason: NonEmptyStr }

// ── THE CONTROLLER READ POLICY, AND THE ROW THAT SUPPLIES IT ────────────────────────
//
// The bounds below are MEGA-RAC READ POLICY -- how long one transport call may run, how many pages a
// collection may walk, how many reads the attempt's budget may pay for. They arrive as parameters so a
// second MegaRAC board can answer with its own numbers. What the numbers ARE on one machine is that
// machine's RECEIPT: they live on its row (gunbc.machine_intake.mtcollins1_boot_row), never as a
// constant in this module. A row that passes a bound nobody measured on it is claiming a number it
// does not have.
//
// THE ROW IS THE HOST SEAM. `controller` is the observed BMC endpoint every transport call is addressed
// to; it comes through the managed host binding, so a row whose secured endpoint and observed endpoint
// disagree is refused before a single read is made. The read functions below have no other way to name
// a host -- there is no host constant left in this module to reach for.
type MegaRacIpmiReadPolicy {
  deadline: Second,
  kill_after: Second,
  // How many IPMI reads the attempt will make. The row knows because it knows its own SMpro site's
  // probe bound; this module does not ask which registers a board has.
  planned_reads: Int,
}

type MegaRacRedfishReadPolicy {
  read_deadline: Second,
  read_budget: Int,
  collection_page_bound: Int,
  collection_member_bound: Int,
  service_root_path: NonEmptyStr,
}

// WHAT A ROW OWNS: the endpoint, the host the operator tools run on, the read bounds, the population
// its own census recorded, and where it keeps retained evidence.
type MegaRacBootRow {
  controller: BmcControllerEndpoint,
  operator_host: NonEmptyStr,
  // What this machine calls itself in the text of a bundle it produced. The adapter prints whatever the
  // row says; it has no name of its own to print, which is the whole point -- a bundle that names a
  // machine the row did not name is naming a machine it did not read.
  label: NonEmptyStr,
  ipmi: MegaRacIpmiReadPolicy,
  // The lanplus cipher suite this controller's IPMI reads use (extdeps.bmc.ipmi ipmi_cipher_suite_argv): the
  // unit's observed IPMI route's own, never a default here.
  ipmi_cipher_suite: IpmiCipherSuite?,
  redfish: MegaRacRedfishReadPolicy,
  // How long the bundle write may take before the attempt stops waiting on it.
  publish_allowance: Second,
  // The sockets this row's own census recorded. A sensor table missing a socket's rails is a finding
  // only against a row that claims that socket; a row that records no population gets no population
  // finding.
  sensor_sockets: List<Int>,
  retained_artifact_prefix: String,
  diagnostics_path: String,
  console_reference: MegaRacConsoleReference,
}

// THE CONSOLE REFERENCE THIS ROW'S CAPTURES ARE COMPARED AGAINST. What a capture matches or fails to
// match is evidence only under the firmware and population the reference run was taken WITH, so both
// scopes and the reference artifact are the row's claim about its own reference; the neutral module
// compares captures against whatever the row names and never against a stored run.
type MegaRacConsoleReference {
  census_sol_artifact_path: NonEmptyStr,
  reference_firmware_scope: NonEmptyStr,
  reference_configuration_scope: NonEmptyStr,
}

// WHAT THE ROW SAYS ABOUT ITS OWN POWER-ON ACCOUNT. Which account a machine boots under, and what its
// receipt says about it, is the row's classification; this module carries the rendered answer into the
// bundle text and the harness notes and does not decide it. A row that cannot classify its evidence
// says so with an unread account -- it does not inherit another machine's answer.
type MegaRacAccountReceipt {
  // The row's classification of its own evidence, or nothing when the row cannot classify it. Nothing
  // is a real answer here: it means the row read no account, and it is not the same as another row's
  // answer.
  account: PowerOnAccount?,
  text: String,
  notes: List<String>,
}

// ── THE RAW RECORDS, CLASSIFIED NEUTRALLY ───────────────────────────────────────────
//
// The bundle stores the RAW MegaRAC records once (run: MegaRacRunRecord). It does NOT also store a
// neutral BootRunRecord: a neutral record beside its raw source would be two representations of one
// boot that can disagree. The neutral record is a CLASSIFICATION of the raw records, produced here
// whenever a neutral consumer needs one -- a consumer of gunbc.host.boot_attempt that must not name
// a BMC protocol gets its BootRunRecord from these functions and never touches the raw arms.
//
// Each mapping drops what the neutral vocabulary cannot carry: the transport's own detail strings
// become the neutral reason, and a raw arm with no neutral arm (a session held on a refused release,
// an override still pending after the census boot) becomes the neutral arm for what the boot OBSERVED,
// not a re-wording of the protocol's response. The witness
// test.claim.host.megarac_boot_record_mapping_witness pins that every raw arm classifies into the
// matching neutral arm -- a new raw arm must arrive with its neutral case, or that witness fails.

// THE POWER STATE, read off the transport's chassis reading. `PowerUnread` carries the transport's own
// words, so a read that failed says why in the protocol's voice rather than being reported as off.
fn megarac_host_power(o: ChassisPowerObservation) -> HostPowerState {
  match o {
    ChassisPowerRead { power_on: true } => PowerOn
    ChassisPowerRead { power_on: false } => PowerOff
    ChassisStatusUndecodable { cause: c } => PowerUnread { reason: c }
    ChassisUnreadable => PowerUnread { reason: "the chassis status read returned nothing decodable" }
  }
}

// THE ONE CLASSIFIER THAT MAY READ AN ATTACH RESULT. An attach is an action, so its outcome says
// whether the action reached a bound presentation, and separately whether the session it opened was
// released. A session the BMC refused to release is NOT "presented": the medium is being served only
// while our session holds it, which is the neutral PresentationSessionHeld -- another session's view is
// unknown, and the boot will not have our session.
//
// DO NOT USE THIS ON A READ-ONLY LOOK (use megarac_look_presentation). A look is by construction not
// an attach: its outcome arm is MegaRacPresentationObserved, which this function must answer as "the
// observation reached an attach decision" -- so classifying a look here reports every healthy look as
// not-served (media_attach_outcome_reason answers that arm with a Present reason, so the classifier
// never even looks at the share, the readiness row or the cd_error the read did return). main never hit
// this: it stored the look RAW and classified it with presentation_still_served at render time. This
// cut introduced it by routing every presentation site through one classifier when it created the
// neutral BootPresentation, and review 81154's demand that the findings be DERIVED from these values is
// what surfaced it -- a derived finding inherits whatever the field says, so a field mistranslated on
// every handoff would silently invent or drop a finding on every attempt that handed off.
fn megarac_presentation(r: MegaRacAttachResult) -> BootPresentation {
  match media_attach_outcome_reason(outcome: r.outcome) {
    Absent => match r.session_release {
      SessionReleased => Presented
      SessionReleaseRefused { detail: d } => PresentationSessionHeld { detail: d as NonEmptyStr }
      SessionReleaseNotAttempted => PresentationSessionHeld { detail: "the attach session was never released" }
    }
    Present { value: why } => PresentationNotServed { reason: why as NonEmptyStr }
  }
}

// THE ONE CLASSIFIER THAT MAY READ A READ-ONLY LOOK (the handoff's after-look, the end-of-attempt look).
// A look has no attach outcome to consult and no session of its own to release, so it is classified by
// presentation_still_served -- the same function the harness conditions on, which is what lets
// run_record_findings derive the presentation findings from this value and agree with the harness
// arm-for-arm rather than by luck.
fn megarac_look_presentation(r: MegaRacAttachResult) -> BootPresentation {
  match presentation_still_served(result: r) {
    PresentationStillReady => Presented
    PresentationReadyButSessionHeld { held: h } =>
      PresentationSessionHeld { detail: session_release_text(standing: h) as NonEmptyStr }
    PresentationNoLongerReady { reason: why } => PresentationNotServed { reason: why as NonEmptyStr }
    PresentationUnobserved { reason: why } => PresentationUnread { reason: why as NonEmptyStr }
  }
}

fn megarac_stale_power_off_record(r: MegaRacStalePowerOff) -> StaleMediumPowerOff {
  match r {
    MegaRacStalePowerOffNotNeeded { reason: reason } => StalePowerOffNotNeeded { reason: reason }
    MegaRacStalePowerOffObserved { stale_image: i, before: b } =>
      StalePowerOffObserved { stale_image: i, before: megarac_host_power(o: b) }
    MegaRacStalePowerOffCommandRefused { stale_image: i, before: b } =>
      StalePowerOffCommandRefused { stale_image: i, before: megarac_host_power(o: b) }
    MegaRacStalePowerOffNotObserved { stale_image: i, before: b, last: l } =>
      StalePowerOffNotObserved {
        stale_image: i,
        before: megarac_host_power(o: b),
        last: megarac_host_power(o: l),
      }
  }
}

fn megarac_media_attach_record(r: MegaRacMediaAttach) -> MediaAttachRecord {
  match r {
    MegaRacMediaAttachNotAttempted { reason: reason } => MediaAttachNotAttempted { reason: reason }
    MegaRacMediaAttachAttempted {
      attempt: _, medium_image_name: n, medium_image_sha256: s, power: p, stale_power_off: sp, result: res,
    } =>
      MediaAttachAttempted {
        medium_image_name: n,
        medium_image_sha256: s,
        power: megarac_host_power(o: p),
        stale_power_off: megarac_stale_power_off_record(r: sp),
        presentation: megarac_presentation(r: res),
      }
  }
}

// THE HANDOFF, raw call result to neutral: two arms both ways, and they are not synonyms. "Attempted
// but not confirmed" is what a failed handoff COMMAND says -- the transport gave no answer to confirm
// either way -- and must not be softened into a refusal or hardened into a confirmation. The third arm
// an earlier revision had here ("the controller refused the handoff") was deleted: the raw arm is
// chosen by the command's exit code, which cannot express a refusal, so it was an arm no observation
// could ever fill.
fn megarac_handoff_call_result(h: MegaRacHandoffCallResult) -> HandoffCallResult {
  match h {
    MegaRacHandoffConfirmed => HandoffConfirmed
    MegaRacHandoffAttemptedUnconfirmed { reason: reason } => HandoffAttemptedUnconfirmed { reason: reason }
  }
}

fn megarac_handoff_media_record(h: MegaRacHandoff) -> HandoffMedia {
  match h {
    MegaRacHandoffNotReached { reason: reason } => HandoffMediaNotReached { reason: reason }
    MegaRacHandoffWithheldAtRecheck { before: _ } =>
      HandoffMediaWithheldAtRecheck { reason: "the pre-handoff re-check withheld the handoff" }
    MegaRacHandoffAttempted { before: _, handoff: call, after: a } =>
      HandoffMediaAttempted { handoff: megarac_handoff_call_result(h: call), after: megarac_look_presentation(r: a) }
  }
}

fn megarac_end_media_record(e: MegaRacEndMedia) -> EndMedia {
  match e {
    MegaRacEndMediaNotTaken { reason: reason } => EndMediaNotTaken { reason: reason }
    MegaRacEndMediaObserved { look: l, end_release: _ } => EndMediaObserved { look: megarac_look_presentation(r: l) }
  }
}


//
// The harness raises nine kinds of finding. SEVEN of them are classifications of a raw record that the
// neutral record already carries classified (an attach that was not ready, a withheld handoff, an
// unconsumed override, a powered-off run with no terminal marker, a still-served after-look, a session
// held by our closing attach, an unconfirmed handoff): the neutral record's own fields say those, and
// `run_record_findings` derives them there. They map to NOTHING here. Storing them would be a second
// home for one fact, which is what review 81154 was about, and it would let the two disagree.
//
// TWO of them are facts observed BESIDE the attempt, which no field of the record can state: which BMC
// channels all failed, and whether the per-attempt credential was removed. Those are the only arms with
// a `StandingFinding` to become, and they are the only ones a caller can supply to
// megarac_boot_run_record. A derived arm cannot be written into the record at all -- its type has no arm
// for it -- so the agreement between the harness and the derivation is checked by the witness against
// `run_record_findings` itself, not by a second translation of the same list.
// The channel names are mapped across the nonempty carrier as a nonempty carrier: the head is already
// there, so this cannot produce the empty value the List version allowed.
fn non_empty_failed_names(failed: FreeSemigroup<BmcChannelRead>) -> FreeSemigroup<NonEmptyStr> {
  FreeSemigroup { head: failed.head.channel, tail: map(failed.tail, c => c.channel) }
}

fn megarac_standing_findings(raw: List<HarnessFinding>) -> List<StandingFinding> {
  flat_map(raw, f => match f {
    MegaRacEveryReadFailed { failed: ch } => [EveryReadFailed {
      channels: non_empty_failed_names(failed: ch) }]
    MegaRacCredentialMayRemain => [CredentialMayRemain]
    MegaRacMediaAttachNotReady { record: _ } => []
    MegaRacMediaAttachSessionHeld { record: _ } => []
    MegaRacHandoffWithheld { handoff: _ } => []
    MegaRacHandoffUnconfirmed { handoff: _ } => []
    MegaRacPresentationAfterHandoff { look: _ } => []
  })
}

// The console as the neutral diagnostic reference: retained evidence is named by its path and digest,
// never by the raw capture, so a neutral consumer can carry "the console is at this path with these
// findings" without a capture in hand.
fn megarac_console_diagnostic_ref(c: ConsoleReading) -> DiagnosticRef {
  match c {
    ConsoleRetained { path: p, capture_digest: dg, lines: _, firmware: _, firmware_error_lines: _,
      size: _, dram: _, checkpoints: _, checkpoint_relations: _, milestones: _, sockets: _,
      against_reference: _, loader: _, linux: _, modules: _, nvparam: _, span_readings: _ } =>
      DiagnosticRetained { path: p, digest: dg }
    ConsoleExceedsBound { path: p, size: s, bound: b } =>
      DiagnosticNotRetained { reason: concat("the capture at ", p, " is ", to_string(byte_size_count(b: s)), " bytes, over the bound of ", to_string(byte_size_count(b: b))) }
    NotRetained { path: p } => DiagnosticNotRetained { reason: concat("the capture at ", p, " is not retained with this attempt") }
    ConsoleUnread { path: p, detail: d } => DiagnosticUnavailable { reason: concat("the capture at ", p, " could not be read: ", d) }
    ConsoleNotConfigured => DiagnosticNotRetained { reason: "no console capture was configured for this attempt" }
  }
}

// THE CLASSIFICATION OF ONE RAW RUN RECORD. This is the function a neutral consumer calls. It reads
// nothing, waits for nothing and holds no identity of its own: it says, from the raw records the
// attempt already recorded, what the boot did.
// THE ONE PLACE this row's raw terminal fact becomes a neutral TerminalObserved. census_ended is the
// raw fact that this row's watch saw its END marker; the record's terminal field, the power
// classification and the harness all read THIS function's answer, so they cannot disagree. The boot
// does not decide what counts as terminal -- it reports the marker its own watch saw -- and no power
// arm encodes it a second time.
fn megarac_run_terminal(raw: MegaRacRunRecord) -> TerminalObserved {
  if raw.census_ended { TerminalMarker { marker: "the diagnostic census ended" } } else { TerminalNotObserved }
}

fn megarac_boot_run_record(raw: MegaRacRunRecord, console: ConsoleReading, identity: AttemptIdentityReading,
                           harness: List<HarnessFinding>) -> BootRunRecord {
  let diagnostic = megarac_console_diagnostic_ref(c: console)
  let terminal = megarac_run_terminal(raw)
  BootRunRecord {
    terminal: terminal,
    end_media: megarac_end_media_record(e: raw.end_media),
    handoff_media: megarac_handoff_media_record(h: raw.handoff_media),
    media: megarac_media_attach_record(r: raw.media),
    // BOTH DECISIONS ARE THE CORE'S, so both are taken from what the raw record already holds: the
    // consumption was decided by boot_override_consumption when this row built its record, and the
    // after-the-attempt power is the core pairing this row's READING with this row's terminal. There is
    // no megarac_override_consumption / megarac_power_after_attempt 1:1 mapping to call any more.
    override: raw.override,
    power_after: power_after_attempt(power: raw.power_after, terminal: terminal),
    timing: raw.timing,
    identity: identity,
    diagnostic: diagnostic,
    standing: megarac_standing_findings(raw: harness),
  }
}


// THE BMC'S SENSOR TABLE, read once after the boot through the same SDR cache the SEL snapshots
// use (extdeps.bmc.ipmi SdrElistAuthenticatedCached). THIS IS THE IPMI-ONLY PER-SOCKET CHANNEL:
// gunbc.machine_intake.mtcollins1_access_observation records that this MegaRAC answers 404 at the
// Redfish service root itself, so the inventory section may legitimately come back refused on
// every attempt, and a socket's rails and temperatures must still be readable. Each line is kept
// decoded or unstructured (extdeps.bmc.ipmi_sdr), never dropped. Without a dumped cache the read
// is not made, and the reading says why: an uncached `sdr elist` re-reads the whole repository
// from a controller that has just been power-cycled, the cost the cache exists to avoid.
type SensorReading
  = SensorsRead { lines: List<SdrLineResult>, at: NonEmptyStr, naming: MegaRacSdrSocketNamingRule }
  | SensorsUnread { cause: BmcReadCause }
  | SensorsNotTaken { reason: NonEmptyStr }

// THE SMpro BOOT-STAGE PASS (gunbc.machine_intake.ampere_smpro_observation, read through the managed
// host's subject). The bundle's own pass is taken after the attempt; the run record below carries the
// two passes taken while power was established on. Its probes are kept whole, every one with its raw
// observation, including when none of them was answered: the dossier is rendered for any outcome list.
// The SmproReading type itself is an AMPERE PLATFORM CAPABILITY, owned by
// gunbc.host.smpro_platform_capability (SMpro is an Ampere SoC register interface, present on the
// Ampere platform and ABSENT on a non-Ampere one, not a MegaRAC reading): this bundle consumes it,
// and mtcollins1's boot row imports it from the same owner.



// ── THE ATTEMPT'S OWN RUN RECORD ─────────────────────────────────────────────────────────────
//
// WHAT THIS ATTEMPT DID TO THE UNIT'S POWER AND ITS ONE-SHOT OVERRIDE, AND WHAT THE SOCKETS SAID
// WHILE THEY WERE POWERED. Three facts that the post-attempt reads above cannot establish:
//
// SOCKET-LOCAL READS NEED POWER. The census image ends with `poweroff -f`
// (gunbc.machine_intake.mtcollins1_census_image mtcollins1_census_halt_command), so by the time the
// bundle's own reads run the SMpro may be unpowered and every probe answers nothing. The run takes a
// pass right after the handoff observed power on (gunbc.machine_intake.oob_boot_handoff
// BootControlIssued now carries an observed transition, not an exit code) and a second the first
// time a poll saw the census envelope open. Both are read-only and fold-sequenced exactly as the
// post-attempt pass (gunbc.machine_intake.ampere_smpro_observation smpro_pass_sequenced).
//
// WHETHER THE OVERRIDE WAS CONSUMED BY THIS ATTEMPT. The IPMI boot override is one-shot: the
// controller clears boot parameter 5's valid flag when a boot consumes it, and on its own timeout.
// The handoff verifies the override was set; parameter 5 is read again before the set and after the
// attempt, so an override still pending (the host never booted through it) and one ALREADY pending
// before this attempt set it are told apart from one no longer pending -- and "consumed" is claimed
// only beside the census END marker (megarac_boot_override_consumption).
//
// A POWER-OFF AFTER THE CENSUS END MARKER IS THE IMAGE WORKING. Chassis power is read after the
// attempt; off after the END marker is recorded as expected, and the post-attempt SMpro pass is not
// sent at a socket the census deliberately powered down.
type BootParam5Reading
  = BootParam5Read { readback: String, at: NonEmptyStr }
  | BootParam5Unread { cause: BmcReadCause }
  | BootParam5NotTaken { reason: NonEmptyStr }

// THE ARMS ANSWER ONLY THE CHASSIS QUESTION: on, off, or no answer. They used to key on the census
// END marker while MegaRacRunRecord separately
// carried `census_ended` -- two representations of one fact that could disagree, because the finding
// was read off the power arm's NAME, so flipping census_ended changed nothing. Now the neutral
// classifier pairs this carrier with the record's own terminal field, which is the single home of the
// terminal fact: "powered off" and "no terminal" can combine, and "off after a terminal" together with
// "no terminal" cannot be written (DESIGN §3 one fact one home; §5 construction over validation).
// ─── THE MEDIA ATTACH, AS THIS ATTEMPT'S RECORD ─────────────────────────────────────────────────
//
// THE HANDOFF IS GATED ON THIS RECORD, AND THE BUNDLE CARRIES THE SAME RECORD (side chat on
// gunbc#12425). What the boot was gated on — which firmware, which intended medium and its verified
// digest, which route, the three indices kept apart, the redirection wire, when, and after how many
// looks — reaches the actuation, the attempt and this bundle as a value, including the refusal and
// timeout arms, never as a bare exit. The power reading the detach admission was taken from is kept
// beside it.
type MegaRacMediaAttach
  = MegaRacMediaAttachNotAttempted { reason: NonEmptyStr }
  | MegaRacMediaAttachAttempted {
      attempt: String,
      medium_image_name: NonEmptyStr,
      medium_image_sha256: NonEmptyStr,
      power: ChassisPowerObservation,
      stale_power_off: MegaRacStalePowerOff,
      result: MegaRacAttachResult
    }

// THE POWER-OFF TAKEN SO A STALE CENSUS MEDIUM CAN BE REPLACED, as its own record (run 36683309058:
// a re-run after a repin found the previous boot's image presented and the host on, and the detach
// admission correctly refused). `power` above is then the FRESH reading taken after this power-off,
// the one the admission was given; the reading before it is `before` here. Not needed carries why,
// so an attempt that did not power off says which fact made it unnecessary.
type MegaRacStalePowerOff
  = MegaRacStalePowerOffNotNeeded { reason: NonEmptyStr }
  | MegaRacStalePowerOffObserved { stale_image: String, before: ChassisPowerObservation }
  | MegaRacStalePowerOffCommandRefused { stale_image: String, before: ChassisPowerObservation }
  | MegaRacStalePowerOffNotObserved { stale_image: String, before: ChassisPowerObservation, last: ChassisPowerObservation }

fn megarac_stale_power_off_text(record: MegaRacStalePowerOff) -> String {
  match record {
    MegaRacStalePowerOffNotNeeded { reason: r } => concat("no power-off: ", r as String)
    MegaRacStalePowerOffObserved { stale_image: i, before: b } => join(["powered off (was ", chassis_observation_text(observation: b) as String, ") to replace stale '", i, "', observed off"], "")
    MegaRacStalePowerOffCommandRefused { stale_image: i, before: _ } => join(["chassis power off for stale '", i, "' was refused by ipmitool"], "")
    MegaRacStalePowerOffNotObserved { stale_image: i, before: _, last: l } => join(["chassis power off for stale '", i, "' was sent but never observed off; last read ", chassis_observation_text(observation: l) as String], "")
  }
}

fn cd_reading_text(r: CdErrorReading) -> String {
  match r {
    CdErrorRead { code: CdErrorNone } => "0"
    CdErrorRead { code: CdErrorNonzero { wire: w, firmware: _ } } => concat(to_string(w), " (observed; no meaning established)")
    CdErrorUnread { detail: d } => concat("UNREAD: ", d)
  }
}

fn raw_read_text(r: MegaRacRawRead) -> String {
  join([
    if r.answered { "answered" } else { "UNANSWERED" },
    " at ", match r.observed_at { Present { value: t } => to_string(t)  Absent => "clock-unreadable" },
    ": ", r.body,
  ], "")
}

fn optional_text(v: String?) -> String {
  match v {
    Present { value: x } => x
    Absent => "absent"
  }
}

fn write_answer_text(a: MegaRacWriteAnswer) -> String {
  match a {
    WriteAccepted { body: b } => concat("accepted: ", b)
    WriteNotIssued { reason: r } => concat("NOT ISSUED: ", r as String)
    WriteAnsweredHttpError { body: b, stderr: e } => concat("answered an HTTP error (complete response): ", concat(b, concat(" / ", e)))
    WriteEffectUncertain { exit_code: x, partial_body: b, stderr: e } => join(["EFFECT UNCERTAIN (curl exit ", to_string(x), ", no complete answer; bytes received: '", b, "'): ", e], "")
  }
}

// THE ROUTE IS RENDERED ON EVERY ARM THAT CARRIES ONE, so an executed stop (with its 1411) and the
// StartMedia answer reach the published artifact whatever refused afterwards (side-chat review
// 5331991982).
fn attach_route_text(route: MegaRacAttachRoute) -> String {
  match route {
    RouteAlreadyPresented => "already presented (no listing consulted, no write)"
    RouteAttached { image_list_index: i, start: st } => join(["attached at image-list index ", i, "; start-media ", write_answer_text(a: st)], "")
    RouteReplaced { image_list_index: i, detach: d, start: st } => join(["replaced (", detach_evidence_text(detach: d), ") then attached at image-list index ", i, "; start-media ", write_answer_text(a: st)], "")
  }
}

fn detach_evidence_text(detach: MegaRacDetachEvidence) -> String {
  join([
    "stopped '", detach.stale_image, "' on media index ", detach.media_index,
    "; stop-media ", write_answer_text(a: detach.command),
    "; configurations read-back ", if detach.readback_read { "read" } else { "UNREAD" }, ": ", detach.readback,
    "; cd_error_code after the stop: ", cd_reading_text(r: detach.cd_after_stop),
    "; general settings after the stop ", raw_read_text(r: detach.general_after_stop),
  ], "")
}

fn presentation_evidence_text(e: MegaRacPresentationEvidence) -> String {
  join([
    "'", e.image_name as String, "' media_index=", optional_text(v: e.media_index),
    " session_index=", optional_text(v: e.session_index),
    " redirection_status=", to_string(e.redirection_wire),
    " established_at=", to_string(e.established_at), " looks=", to_string(e.looks),
    " cd_error_code before any write=", cd_reading_text(r: e.cd_before_any_write),
    " at ready=", cd_reading_text(r: e.cd_at_ready),
    " general settings at ready ", raw_read_text(r: e.general_at_ready),
  ], "")
}

fn readiness_reading_text(r: AttachReadiness) -> String {
  match r {
    ReadinessStarted { row: w } => concat("started, session_index ", optional_text(v: w.session_index))
    ReadinessConnecting { row: w } => concat("connecting (status ", concat(to_string(w.redirection_wire), concat("), session_index ", optional_text(v: w.session_index))))
    ReadinessStartedUnbound { row: w } => concat("started with no bound session, session_index ", optional_text(v: w.session_index))
    ReadinessNotPresented { configurations: c } => concat("not presented: ", c)
    ReadinessUnanswered { detail: d } => concat("configurations GET unanswered: ", d)
    ReadinessUncatalogued { image_name: n, unread: u, configurations: c } => join(["UNCATALOGUED ", redirection_unread_text(unread: u), " on '", n, "': ", c], "")
    ReadinessMalformed { detail: d } => concat("MALFORMED configurations: ", d)
    ReadinessDuplicate { configurations: c } => concat("DUPLICATE rows present the image: ", c)
    ReadinessWrongPresentation { image_name: n, configurations: c } => concat("WRONG presentation '", concat(n, concat("': ", c)))
  }
}

fn readiness_look_text(l: ReadinessLook) -> String {
  concat("at ", concat(to_string(l.observed_at), concat(": ", readiness_reading_text(r: l.reading))))
}

// THE ONE AUTHORITY FOR WHAT EACH ATTACH OUTCOME MEANS TO AN OPERATOR; absent only for the ready
// presentation. The gate and this bundle both read it, so the reason a handoff was withheld and
// the reason the bundle records are the same sentence.
fn media_attach_outcome_reason(outcome: MegaRacAttachOutcome) -> String? {
  match outcome {
    MegaRacPresentationReady { route: _, evidence: _ } => none
    MegaRacReadinessTimedOut { image_name: n, route: r, last: l, deadline: d, looks: k, cd_before_any_write: cb, cd_at_refusal: ca } =>
      Present { value: join(["the presentation of '", n as String, "' did not reach Started with a bound session before ", to_string(d), " (", to_string(k), " looks, route: ", attach_route_text(route: r), "); last look ", readiness_look_text(l: l), "; cd_error_code before any write ", cd_reading_text(r: cb), ", at refusal ", cd_reading_text(r: ca), ". No boot-device or power handoff was made"], "") }
    MegaRacReadinessRefused { image_name: n, route: r, look: l, looks: k, cd_before_any_write: cb, cd_at_refusal: ca } =>
      Present { value: join(["the presentation of '", n as String, "' was refused by the readiness policy after ", to_string(k), " looks (route: ", attach_route_text(route: r), "): ", readiness_look_text(l: l), "; cd_error_code before any write ", cd_reading_text(r: cb), ", at refusal ", cd_reading_text(r: ca), ". No boot-device or power handoff was made"], "") }
    MegaRacReadinessClockUnreadable { image_name: n, route: r, detail: d } =>
      Present { value: join(["the clock could not be read, so the readiness window for '", n as String, "' could not be declared or judged: ", d, " (route: ", attach_route_text(route: r), ")"], "") }
    MegaRacConfigurationsUnreadable { detail: d } =>
      Present { value: concat("the presented-media listing could not be read, so whether anything is attached is UNKNOWN; refusing rather than attaching over an unknown state: ", d) }
    MegaRacShareMismatch { expected: e, observed: o } =>
      Present { value: join([
        "the controller's remote-media share is not this unit's boot share, so no image name read from it can be trusted and nothing was written: expected ",
        e.server_address as String, ":", e.source_path as String, " over ", megarac_share_type_wire(t: e.share_type), " with mount_cd 1, observed ",
        o.server_address, ":", o.source_path, " over ", o.share_type, " with mount_cd ", o.mount_cd,
      ], "") }
    MegaRacPresentationObserved { share: _, readiness: _, cd_error: _, general: _, configurations: _ } =>
      Present { value: "a read-only presentation observation reached an attach decision; observations never attach and never open the handoff" }
    MegaRacShareUnreadable { detail: d } =>
      Present { value: concat("the controller's remote-media share settings could not be read, so which share image names resolve in is UNKNOWN; nothing was written: ", d) }
    MegaRacSessionRefused { detail: d } => Present { value: concat("session refused: ", d) }
    MegaRacSessionTokenUnreadable { detail: d } => Present { value: concat("session succeeded but no CSRFToken could be read from its document: ", d) }
    MegaRacImagesUnreadable { detail: d } => Present { value: concat("images listing unreadable: ", d) }
    MegaRacImageListingEmpty =>
      Present { value: "the image is not presented AND the controller offers no image available to attach, and nothing is presented to stop (stopping is what re-enumerates the share); check that the export is reachable from the controller and holds the file" }
    MegaRacImageListingUnparseable { detail: d } => Present { value: concat("the images listing was not valid JSON: ", d) }
    MegaRacImageOfferedAmbiguously { image_name: n, image_indices: ids } =>
      Present { value: join(["the controller offers '", n as String, "' more than once (image_index ", join(ids, ", "), "), so which file would be attached is the controller's enumeration order; nothing was written"], "") }
    MegaRacImageNotEnumerated { image_name: n } =>
      Present { value: concat("the image is not presented, and the controller offers other images but not '", concat(n as String, "'; nothing is presented to stop, and stopping is what re-enumerates the share, so check that the export holds exactly that file")) }
    MegaRacForeignImagePresented { image_name: n, configurations: c } =>
      Present { value: concat("the controller is presenting '", concat(n, concat("', which is not a census image of this lane; it is not this workflow's to stop, so nothing was written: ", c))) }
    MegaRacSeveralImagesPresented { configurations: c } =>
      Present { value: concat("more than one census image is presented at once, a state never observed on this single-CD unit; nothing was written: ", c) }
    MegaRacStaleDetachNotAdmitted { stale_image: n, reason: why } =>
      Present { value: concat("the stale census image '", concat(n, concat("' is presented and was NOT stopped: ", why as String))) }
    MegaRacStaleDetachUnconfirmed { detach: d, reason: why } =>
      Present { value: concat("the stale census image was not established as detached: ", concat(why as String, concat(" (", concat(detach_evidence_text(detach: d), ")")))) }
    MegaRacRedirectionUncatalogued { image_name: n, unread: u, refusal: why, configurations: c } =>
      Present { value: join(["the row naming '", n, "' reports ", redirection_unread_text(unread: u), ", and it was not stopped: ", unread_row_stop_refusal_text(refusal: why), "; refusing before any write or power action: ", c], "") }
    MegaRacRefreshClockUnreadable { detail: d, detach: x } => Present { value: join(["the clock could not be read, so the re-enumeration window could not be declared or judged: ", d, " (the detach had been executed: ", detach_evidence_text(detach: x), ")"], "") }
    MegaRacListingUnparseableAfterDetach { detail: d, detach: x } => Present { value: join(["after the stale image was stopped (", detach_evidence_text(detach: x), "), the images listing was not valid JSON: ", d], "") }
    MegaRacOfferedAmbiguouslyAfterDetach { image_name: n, image_indices: ids, detach: x } =>
      Present { value: join(["after the stale image was stopped (", detach_evidence_text(detach: x), "), the controller offers '", n as String, "' more than once (image_index ", join(ids, ", "), "), so which file would be attached is the controller's enumeration order; nothing further was written"], "") }
    MegaRacMediaStateUnestablished { image_name: n, route: r, look: l, looks: k, cd_before_any_write: cb, cd_at_ready: ca, general_at_ready: g } =>
      Present { value: join(["this attempt cannot establish the media state of '", n as String, "': the presentation read Started (", readiness_look_text(l: l), ", ", to_string(k), " looks, route: ", attach_route_text(route: r), ") but cd_error_code before any write was ", cd_reading_text(r: cb), " and at readiness ", cd_reading_text(r: ca), " (general settings ", raw_read_text(r: g), "). A code other than 0, or 16 on the build an executed receipt grounded it for, or an unread one, has no established meaning, so this is a knowledge refusal, not a controller verdict. No boot-device or power handoff was made"], "") }
    MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: cb, reason: why } =>
      Present { value: join(["this attempt cannot establish the media state, and nothing was written: cd_error_code before any write was ", cd_reading_text(r: cb), "; ", why as String], "") }
    MegaRacReadinessClockIncoherent { image_name: n, route: rt, opened_at: o, previous: p, look: l, looks: k } =>
      Present { value: join(["the clock cannot bound the readiness wait for '", n as String, "': window opened at ", to_string(o), ", previous look at ", match p { Present { value: v } => to_string(v)  Absent => "none" }, ", this look ", readiness_look_text(l: l), " after ", to_string(k), " looks (route: ", attach_route_text(route: rt), "). No boot-device or power handoff was made"], "") }
    MegaRacNotEnumeratedAfterRefresh { image_name: n, detach: d, standing: _ } =>
      Present { value: join(["NotEnumeratedAfterRefresh: after the stale image was stopped (", detach_evidence_text(detach: d), "), '", n as String, "' was still not offered within the declared window; check that the export on srv2 holds exactly that file"], "") }
    MegaRacOwnSessionEnded { end: e } =>
      Present { value: concat("an end-of-attempt release reached an attach decision; a release never attaches: ", own_session_end_text(end: e)) }
  }
}

fn own_session_end_text(end: OwnSessionEnd) -> String {
  match end {
    OwnSessionNothingPresented { configurations: c } => concat("nothing presented, so nothing of this attempt was left: ", c)
    OwnSessionStopped { detach: d } => concat("this attempt's own session stopped and read back as gone: ", detach_evidence_text(detach: d))
    OwnSessionStopUnconfirmed { detach: d, reason: why } => join(["this attempt's own session was NOT established as stopped: ", why as String, " (", detach_evidence_text(detach: d), ")"], "")
    OwnSessionNotStopped { reason: why, configurations: c } => join(["NOT stopped: ", why as String, ": ", c], "")
  }
}

fn session_release_text(standing: SessionRelease) -> String {
  match standing {
    SessionReleased => "released"
    SessionReleaseNotAttempted => "never opened"
    SessionReleaseRefused { detail: d } => concat("NOT released, still allocated on the controller: ", d)
  }
}

fn megarac_media_attach_text(record: MegaRacMediaAttach) -> String {
  match record {
    MegaRacMediaAttachNotAttempted { reason: r } => concat("not attempted: ", r as String)
    MegaRacMediaAttachAttempted { attempt: a, medium_image_name: n, medium_image_sha256: h, power: p, stale_power_off: off, result: res } =>
      join([
        "attempt ", a, " medium '", n as String, "' sha256 ", h as String,
        "; ", megarac_stale_power_off_text(record: off),
        "; power before the session: ", chassis_observation_text(observation: p) as String,
        "; session ", session_release_text(standing: res.session_release), "; ",
        match res.outcome {
          MegaRacPresentationReady { route: r, evidence: e } => concat("READY via ", concat(attach_route_text(route: r), concat(": ", presentation_evidence_text(e: e))))
          other => match media_attach_outcome_reason(outcome: other) {
            Present { value: why } => concat("WITHHELD: ", why)
            Absent => "WITHHELD"
          }
        },
      ], "")
  }
}

// WHAT OUR HARNESS DID THAT A READER OF THIS ATTEMPT MUST KNOW, as typed values carrying the record
// they were decided from. These are facts about the observation, not about the machine: the
// machine's side is the power-on account (gunbc.machine_intake.mtcollins1_power_on_account). Each is decided by
// the *_harness function beside its record and rendered once, by harness_finding_text.
// The failed reads are a FreeSemigroup, not a List: an "every read failed" finding that names no read is
// not a fact, and the producer below decides nonemptiness by CONSTRUCTION (it builds the arm only when a
// head exists) instead of guarding on count(failed) == 0. The standing arm in gunbc.host.boot_attempt
// carries the channel names for the same reason; this is the raw record the mapping reads from.
type HarnessFinding
  = MegaRacEveryReadFailed { failed: FreeSemigroup<BmcChannelRead> }
  | MegaRacMediaAttachNotReady { record: MegaRacMediaAttach }
  | MegaRacMediaAttachSessionHeld { record: MegaRacMediaAttach }
  | MegaRacHandoffWithheld { handoff: MegaRacHandoff }
  | MegaRacHandoffUnconfirmed { handoff: MegaRacHandoff }
  | MegaRacPresentationAfterHandoff { look: MegaRacAttachResult }
  | MegaRacCredentialMayRemain

fn media_attach_harness(record: MegaRacMediaAttach) -> List<HarnessFinding> {
  match record {
    MegaRacMediaAttachNotAttempted { reason: _ } => []
    MegaRacMediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: res } =>
      match media_attach_outcome_reason(outcome: res.outcome) {
        Present { value: _ } => [MegaRacMediaAttachNotReady { record: record }]
        Absent =>
          match res.session_release {
            SessionReleased => []
            SessionReleaseRefused { detail: _ } => [MegaRacMediaAttachSessionHeld { record: record }]
            SessionReleaseNotAttempted => [MegaRacMediaAttachSessionHeld { record: record }]
          }
      }
  }
}

// THE HANDOFF'S OWN VIEW OF THE MEDIUM: the look just before the boot-device and power writes, and
// the look just after. A re-read narrows the window between readiness and handoff; it cannot close
// it, so the loss AT or AFTER the handoff is an observed, recorded outcome rather than an assumption
// that a ready medium stays ready.
// THE HANDOFF CALL IS RECORDED AS WHAT IT ESTABLISHED, NOT AS "HANDED OFF" (side-chat review
// 5332343434). gunbc.machine_intake.oob_boot_handoff returns success only after a chassis read-back
// observed the power transition, so success is a confirmed handoff; any other return is a handoff
// that was attempted and did not confirm, kept with its reason.
type MegaRacHandoffCallResult
  = MegaRacHandoffConfirmed
  | MegaRacHandoffAttemptedUnconfirmed { reason: String }

type MegaRacHandoff
  = MegaRacHandoffNotReached { reason: NonEmptyStr }
  | MegaRacHandoffWithheldAtRecheck { before: MegaRacAttachResult }
  | MegaRacHandoffAttempted { before: MegaRacAttachResult, handoff: MegaRacHandoffCallResult, after: MegaRacAttachResult }

fn observation_text(r: MegaRacAttachResult) -> String {
  match r.outcome {
    MegaRacPresentationObserved { share: sh, readiness: rd, cd_error: cd, general: g, configurations: c } =>
      join([
        "share ", match sh { ShareBound => "bound"  ShareMismatch { observed: o } => concat("MISMATCH ", concat(o.server_address, concat(":", o.source_path)))  ShareUnreadable { detail: d } => concat("UNREADABLE ", d) },
        "; row ", readiness_reading_text(r: rd),
        "; cd_error_code ", cd_reading_text(r: cd),
        "; general settings ", raw_read_text(r: g),
        "; configurations ", raw_read_text(r: c),
        "; session ", session_release_text(standing: r.session_release),
      ], "")
    other => match media_attach_outcome_reason(outcome: other) { Present { value: w } => concat("UNOBSERVED: ", w)  Absent => "UNOBSERVED" }
  }
}

fn megarac_handoff_media_text(h: MegaRacHandoff) -> String {
  match h {
    MegaRacHandoffNotReached { reason: r } => concat("not reached: ", r as String)
    MegaRacHandoffWithheldAtRecheck { before: b } => concat("WITHHELD at the pre-handoff recheck: ", observation_text(r: b))
    MegaRacHandoffAttempted { before: b, handoff: hc, after: a } => join(["before handoff: ", observation_text(r: b), " | handoff: ", match hc { MegaRacHandoffConfirmed => "confirmed by chassis read-back"  MegaRacHandoffAttemptedUnconfirmed { reason: r } => concat("ATTEMPTED, NOT CONFIRMED: ", r) }, " | after handoff: ", observation_text(r: a)], "")
  }
}

fn recheck_text(v: PresentationStillServed) -> String {
  match v {
    PresentationStillReady => "served"
    PresentationReadyButSessionHeld { held: r } => concat("served, but the look's own session was ", session_release_text(standing: r))
    PresentationNoLongerReady { reason: why } => concat("AFFIRMED not served: ", why as String)
    PresentationUnobserved { reason: why } => concat("UNOBSERVED (indeterminate, not a withdrawal): ", why as String)
  }
}

// AFFIRMED LOSS AND AN UNOBSERVED LOOK ARE DIFFERENT EVIDENCE (side-chat review 5331738657). Both
// withhold before the handoff, but the bundle says which it was: "LOST" only when a look was taken
// and showed the medium not served; a failed look is indeterminate and is reported as such.
fn handoff_media_harness(h: MegaRacHandoff) -> List<HarnessFinding> {
  match h {
    MegaRacHandoffNotReached { reason: _ } => []
    MegaRacHandoffWithheldAtRecheck { before: _ } => [MegaRacHandoffWithheld { handoff: h }]
    MegaRacHandoffAttempted { before: _, handoff: hc, after: a } =>
      concat(match hc { MegaRacHandoffConfirmed => []  MegaRacHandoffAttemptedUnconfirmed { reason: _ } => [MegaRacHandoffUnconfirmed { handoff: h }] },
      match presentation_still_served(result: a) {
        PresentationStillReady => []
        PresentationReadyButSessionHeld { held: _ } => [MegaRacPresentationAfterHandoff { look: a }]
        PresentationNoLongerReady { reason: _ } => [MegaRacPresentationAfterHandoff { look: a }]
        PresentationUnobserved { reason: _ } => [MegaRacPresentationAfterHandoff { look: a }]
      })
  }
}

// THE MEDIUM AT THE END OF THE ATTEMPT: one read-only look, still under the hold, taken whenever the
// media attach was attempted -- whether or not the handoff was made -- so an experiment that stopped
// and restarted media and was then withheld still records its final state (side-chat review
// 5332343434). No power action is taken to obtain it. The census markers are the watch's own
// evidence of what the host did; neither they nor this look independently verify that the full
// image was delivered, and a persisting nonzero code does not by itself prove an active fault or a
// historical-only one.
type MegaRacEndMedia
  = MegaRacEndMediaNotTaken { reason: NonEmptyStr }
  | MegaRacEndMediaObserved { look: MegaRacAttachResult, end_release: EndMediaRelease }

// WHAT THE ATTEMPT DID WITH ITS OWN SESSION AFTER THE END LOOK, decided by the power after the attempt
// (end_release_gate). A host observed ON keeps its medium: a diskless host that stays up runs from it.
// A host observed OFF has its session stopped (gunbc.machine_intake.megarac_boot_media_attach
// megarac_release_boot_session), established only by the read-back. A power that was not observed
// admits no stop. Boot run 39868779331 is the defect this closes: it ended OFF with its census row still
// Started, and the next two attempts met that row at redirection_status 19.
type EndMediaRelease
  = EndReleaseKeptHostOn
  | EndReleaseWithheld { reason: NonEmptyStr }
  | EndReleaseRan { result: MegaRacAttachResult }

type EndReleaseGate
  = EndReleaseGateKeep
  | EndReleaseGateWithhold { reason: NonEmptyStr }
  | EndReleaseGateAdmit { power: ChassisPowerObservation }

// PURE. The two OFF arms are minted by power_after_attempt only from a ChassisPowerRead that read off,
// so the reading handed on is the one the poll took, not a reconstruction of it.
fn end_release_gate(power_after: PowerAfterAttempt) -> EndReleaseGate {
  match power_after {
    PoweredOffAfterTerminal => EndReleaseGateAdmit { power: ChassisPowerRead { power_on: false } }
    PoweredOffWithoutTerminal => EndReleaseGateAdmit { power: ChassisPowerRead { power_on: false } }
    PoweredOnAfterAttempt => EndReleaseGateKeep
    PowerAfterUnobserved { reason: r } => EndReleaseGateWithhold { reason: concat("the power after the attempt was not observed, so no stop is admitted: ", r as String) as NonEmptyStr }
    PowerAfterNotTaken { reason: r } => EndReleaseGateWithhold { reason: concat("the power after the attempt was not taken, so no stop is admitted: ", r as String) as NonEmptyStr }
  }
}

// WHAT THE ATTEMPT LEFT ON THE CONTROLLER THAT IT DID NOT MEAN TO, absent only when nothing was left or
// the host was kept on deliberately. Every other arm is residue the next attempt meets, so it is loud:
// a stop the read-back did not establish, a row the release could not read or would not stop, a release
// whose own login session was not released, and a power that could not say whether a stop was owed.
fn end_release_residue(end_release: EndMediaRelease) -> NonEmptyStr? {
  match end_release {
    EndReleaseKeptHostOn => none
    EndReleaseWithheld { reason: r } => Present { value: concat("this attempt's session may remain on the controller: ", r as String) as NonEmptyStr }
    EndReleaseRan { result: res } =>
      match res.outcome {
        MegaRacOwnSessionEnded { end: e } =>
          match e {
            OwnSessionStopUnconfirmed { detach: _, reason: _ } => Present { value: own_session_end_text(end: e) as NonEmptyStr }
            OwnSessionNotStopped { reason: _, configurations: _ } => Present { value: own_session_end_text(end: e) as NonEmptyStr }
            OwnSessionStopped { detach: _ } => end_release_session_residue(standing: res.session_release)
            OwnSessionNothingPresented { configurations: _ } => end_release_session_residue(standing: res.session_release)
          }
        other => Present { value: concat("the end-of-attempt release did not run: ", match media_attach_outcome_reason(outcome: other) { Present { value: w } => w  Absent => "no reason was rendered" }) as NonEmptyStr }
      }
  }
}

fn end_release_session_residue(standing: SessionRelease) -> NonEmptyStr? {
  match standing {
    SessionReleased => none
    other => Present { value: concat("the end-of-attempt release's own login session was ", session_release_text(standing: other)) as NonEmptyStr }
  }
}

fn end_release_text(end_release: EndMediaRelease) -> String {
  match end_release {
    EndReleaseKeptHostOn => "kept: the host is on after the attempt, and a host that stays up runs from its medium"
    EndReleaseWithheld { reason: r } => concat("WITHHELD: ", r as String)
    EndReleaseRan { result: res } =>
      match res.outcome {
        MegaRacOwnSessionEnded { end: e } => join([own_session_end_text(end: e), "; session ", session_release_text(standing: res.session_release)], "")
        other => concat("NOT RUN: ", match media_attach_outcome_reason(outcome: other) { Present { value: w } => w  Absent => "no reason was rendered" })
      }
  }
}

// THE RESIDUE IS PART OF THE VERDICT. A success that left its session behind is a failure naming it; a
// failure keeps its own cause first and carries the residue beside it.
fn outcome_with_end_release(outcome: ProcessExit, end: MegaRacEndMedia) -> ProcessExit {
  match end {
    MegaRacEndMediaNotTaken { reason: _ } => outcome
    MegaRacEndMediaObserved { look: _, end_release: rel } =>
      match end_release_residue(end_release: rel) {
        Absent => outcome
        Present { value: why } =>
          match outcome {
            ExitSuccess => exit_failure(reason: concat("mtcollins1 boot: end-of-attempt release: ", why as String))
            ExitFailure { code: c, reason: r } => ExitFailure { code: c, reason: join([r, "; and at the end of the attempt: ", why as String], "") }
          }
      }
  }
}

// PURE: the end look is owed exactly when the media attach was attempted -- a session was opened
// against the controller, so any stop, start or presentation it reached is this attempt's to observe.
fn end_media_is_owed(media: MegaRacMediaAttach) -> Bool {
  match media {
    MegaRacMediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: _ } => true
    MegaRacMediaAttachNotAttempted { reason: _ } => false
  }
}

fn megarac_end_media_text(e: MegaRacEndMedia) -> String {
  match e {
    MegaRacEndMediaNotTaken { reason: r } => concat("not taken: ", r as String)
    MegaRacEndMediaObserved { look: l, end_release: rel } => join([observation_text(r: l), " | release: ", end_release_text(end_release: rel)], "")
  }
}

// A PRESENTATION AFFIRMED LOST AFTER THE HANDOFF IS A CAUSE, NOT ONLY A FINDING (gunbc#12533
// finding 4). The after-handoff and end-of-attempt looks are taken for this attempt's own subject,
// under the hold, after the boot override and the power action were made. When either AFFIRMS the
// medium is no longer served, the host was booting from a medium the controller had stopped
// serving, and a failure the attempt reports afterwards -- a watch that reaches its deadline -- is
// that loss seen from downstream. So the attempt's verdict consumes the looks it took rather than
// leaving them to the bundle. Only an affirmed loss attributes: an unobserved or unestablished look
// says nothing about the medium and is never promoted to a cause. The earliest affirming look is
// named, because the phase is what the operator acts on.
type MegaRacMediaLossPhase
  = MediaLostAtAfterHandoff
  | MediaLostAtEndOfAttempt

fn media_loss_phase_text(p: MegaRacMediaLossPhase) -> String {
  match p {
    MediaLostAtAfterHandoff => "after-handoff"
    MediaLostAtEndOfAttempt => "end-of-attempt"
  }
}

type MegaRacMediaLossAfterHandoff
  = MediaLossAffirmed { phase: MegaRacMediaLossPhase, reason: NonEmptyStr }
  | MediaLossNotAffirmed

fn media_loss_of_look(look: MegaRacAttachResult, phase: MegaRacMediaLossPhase) -> MegaRacMediaLossAfterHandoff {
  match presentation_still_served(result: look) {
    PresentationNoLongerReady { reason: why } => MediaLossAffirmed { phase: phase, reason: why }
    _ => MediaLossNotAffirmed
  }
}

// PURE, over the two looks only a CONFIRMED handoff makes causal: a handoff that was withheld or
// never reached made no boot write, and one attempted but unconfirmed already carries its own cause
// (the handoff's), so neither is re-attributed to the medium.
fn media_loss_after_handoff(handoff: MegaRacHandoff, end: MegaRacEndMedia) -> MegaRacMediaLossAfterHandoff {
  match handoff {
    MegaRacHandoffAttempted { before: _, handoff: MegaRacHandoffConfirmed, after: a } =>
      match media_loss_of_look(look: a, phase: MediaLostAtAfterHandoff) {
        MediaLossAffirmed { phase: p, reason: r } => MediaLossAffirmed { phase: p, reason: r }
        MediaLossNotAffirmed =>
          match end {
            MegaRacEndMediaObserved { look: l, end_release: _ } => media_loss_of_look(look: l, phase: MediaLostAtEndOfAttempt)
            MegaRacEndMediaNotTaken { reason: _ } => MediaLossNotAffirmed
          }
      }
    MegaRacHandoffAttempted { before: _, handoff: MegaRacHandoffAttemptedUnconfirmed { reason: _ }, after: _ } => MediaLossNotAffirmed
    MegaRacHandoffNotReached { reason: _ } => MediaLossNotAffirmed
        MegaRacHandoffWithheldAtRecheck { before: _ } => MediaLossNotAffirmed
  }
}

// THE ATTEMPT'S TERMINAL CAUSE. A success stands -- the host reported its census, so whatever the
// controller did afterwards did not stop it (the finding still records the loss) -- and a failure is
// re-attributed to the loss, keeping the downstream symptom beside it rather than discarding it.
fn outcome_attributing_media_loss(row: MegaRacBootRow, outcome: ProcessExit, loss: MegaRacMediaLossAfterHandoff) -> ProcessExit {
  match outcome {
    ExitSuccess => ExitSuccess
    ExitFailure { code: c, reason: r } =>
      match loss {
        MediaLossNotAffirmed => ExitFailure { code: c, reason: r }
        MediaLossAffirmed { phase: p, reason: why } =>
          ExitFailure { code: c, reason: join([concat(row.label, " boot: media presentation lost at "), media_loss_phase_text(p: p), " (", why as String, "); the attempt then reported: ", r], "") }
      }
  }
}

type MegaRacRunRecord {
  census_ended: Bool
  end_media: MegaRacEndMedia
  handoff_media: MegaRacHandoff
  media: MegaRacMediaAttach
  smpro_power_on: SmproReading
  smpro_census: SmproReading
  override_before: BootParam5Reading
  override_after: BootParam5Reading
  // THE CONSUMPTION AND THE POST-ATTEMPT POWER, stored as the core's OWN types. This module used to
  // keep a MegaRacOverride sum and a MegaRacPowerAfter sum beside these fields and map them 1:1 into
  // the neutral ones -- two decisions, two renderers, and production called this module's copy (review
  // 81601). What is raw here is the READINGS above (override_before / override_after / the chassis
  // observation folded into power_after); what is decided is the core's, and only the core's.
  override: BootOverrideConsumption
  power_after: HostPowerReading
  timing: BootPhaseTiming
  fan_gate: PostPowerFanGateReading
}

fn megarac_run_record_not_taken(reason: NonEmptyStr) -> MegaRacRunRecord {
  MegaRacRunRecord {
    census_ended: false,
    end_media: MegaRacEndMediaNotTaken { reason: reason },
    handoff_media: MegaRacHandoffNotReached { reason: reason },
    media: MegaRacMediaAttachNotAttempted { reason: reason },
    smpro_power_on: SmproNotTaken { reason: reason },
    smpro_census: SmproNotTaken { reason: reason },
    override_before: BootParam5NotTaken { reason: reason },
    override_after: BootParam5NotTaken { reason: reason },
    override: OverrideNotHandedOff { reason: reason },
    power_after: HostPowerNotTaken { reason: reason },
    timing: boot_phase_timing_not_taken(reason: reason),
    fan_gate: PostPowerFanGateNotReached { reason: reason },
  }
}

// PENDING MEANS THIS ATTEMPT'S OVERRIDE, READ THROUGH THE HANDOFF'S OWN VERDICT. The same
// boot_readback_verdict that confirmed the set decides "still pending" here, so the two can never
// disagree about what the controller's rendering means.
fn boot_override_pending(readback: String, selection: IpmiBootSelection) -> Bool {
  match boot_readback_verdict(readback: readback, selection: selection) {
    BootReadbackConfirmed => true
    BootReadbackFlagInvalid => false
    BootReadbackNotOneShot => false
    BootReadbackFirmwareMismatch => false
    BootReadbackSelectorAbsent => false
  }
}

fn boot_param5_unread_reason(r: BootParam5Reading, which: String) -> NonEmptyStr? {
  match r {
    BootParam5Read { readback: _, at: _ } => none
    BootParam5Unread { cause: c } => Present { value: concat("boot parameter 5 ", which, " was not read (", bmc_read_cause_kind(cause: c), ")") as NonEmptyStr }
    BootParam5NotTaken { reason: why } => Present { value: concat("boot parameter 5 ", which, " was not taken: ", why as String) as NonEmptyStr }
  }
}

// ORDER IS THE ARGUMENT, AND "CONSUMED" NEEDS A DISCRIMINATOR (DESIGN §4d; review 71115). An
// override already pending before this attempt set it cannot be attributed; one still pending after
// was not consumed. One NO LONGER pending is only that: the BMC also clears the valid bit on its own
// (the IPMI boot-flag valid-bit timeout), a power-off or another writer can clear it, and a changed
// rendering can stop matching. So consumption by this attempt is minted only beside an observation
// that only a boot through the override's device produces: the census END marker, which only the
// census image on the attached virtual CD prints, for this machine and this run. Without it the
// verdict records what was observed and says consumption is not established.
// WHAT THIS ROW'S PARAMETER-5 READS SAY, expressed in the core's own input vocabulary. Two facts are
// this row's and no one else's, and both live here: WHICH rendering counts as "this attempt's override
// is pending" (boot_override_pending, the same boot_readback_verdict that confirmed the set -- so the
// set and the readback can never disagree about what the controller's text means), and what the row
// accepts as the discriminator that consumption by THIS attempt is established (the caller passes
// booted_through_override_device, which for this row means the census END marker: the IPMI boot-flag
// valid bit times out on its own, a power-off or another writer clears it, and a changed rendering can
// stop matching, so ORDER IS THE ARGUMENT -- DESIGN §4d, review 71115).
//
// Everything after that -- already-pending before, still pending after, consumed, no longer pending,
// unread -- is the core's decision: boot_override_consumption. This module no longer makes it, holds a
// sum for it, or words it (review 81601; the six-arm MegaRacOverride sum and its 1:1 map to the core's
// six arms are deleted, and the core function that used to be dead outside witnesses is now what
// production calls).
fn megarac_override_standing(read: BootParam5Reading, which: String, selection: IpmiBootSelection) -> BootOverrideStanding {
  match read {
    BootParam5Read { readback: b, at: _ } =>
      if boot_override_pending(readback: b, selection: selection) {
        OverrideFlagPending
      } else {
        OverrideFlagNotPending
      }
    BootParam5Unread { cause: c } => OverrideReadUnanswered { reason: concat("boot parameter 5 ", which, " was not read (", bmc_read_cause_kind(cause: c), ")") as NonEmptyStr }
    BootParam5NotTaken { reason: why } => OverrideReadUnanswered { reason: concat("boot parameter 5 ", which, " was not taken: ", why as String) as NonEmptyStr }
  }
}

fn megarac_boot_override_consumption(before: BootParam5Reading, after: BootParam5Reading, selection: IpmiBootSelection,
                                     booted_through_override_device: Bool) -> BootOverrideConsumption {
  boot_override_consumption(
    before: megarac_override_standing(read: before, which: "before the attempt", selection: selection),
    after: megarac_override_standing(read: after, which: "after the attempt", selection: selection),
    booted_through_override_device: booted_through_override_device)
}

// THE POST-ATTEMPT POWER, REDUCED TO A READING. This module answers only "what did the chassis read
// say" -- the pairing with the terminal that produces an after-the-attempt state is the core's
// power_after_attempt, and this module keeps no sum for it (review 81601). A read that did not answer
// keeps the decoder's cause; the row never fabricates a power it did not read.
fn megarac_power_after_from_observation(observation: ChassisPowerObservation) -> HostPowerReading {
  HostPowerRead { state: megarac_host_power(o: observation) }
}

// THE READ THAT WAS NEVER MADE (no account was modeled to read with, or the budget closed first). A
// caller that did not attempt the read must not be able to hand back a power, and must not have to
// invent a chassis cause for a read that never happened.
fn megarac_power_reading_not_taken(reason: NonEmptyStr) -> HostPowerReading {
  HostPowerNotTaken { reason: reason }
}

// WHAT THE HARNESS CAN ADD THAT THE RECORD'S FIELDS CANNOT. Only the five arms below, and all five
// are read from a RAW section of this row's own bundle: which BMC channel failed, what the attach's own
// result line said, what the recheck saw, what the handoff attempt's confirmation looked like, what the
// post-handoff look looked like. The two arms that used to sit here for the override and the post-attempt
// power are DELETED (review 81601): the record's own override and power_after fields already state those
// facts, gunbc.host.boot_attempt derives them in run_record_derived_findings, and the core renders them
// -- a third copy of the decision in a harness list was how the two versions drifted. What the record's
// fields cannot express stays here; what they already say is the core's finding, in the core's words.

// THE RAW RUN RECORD, RENDERED. The override line and the power line are the CORE'S words: the stored
// override is already the core's BootOverrideConsumption (override_consumption_text) and the power line
// pairs the core's reading with the record's terminal through the core's power_after_attempt
// (power_after_text). This module has no vocabulary for either decision (review 81601) -- what it keeps
// below are the sections whose detail exists only in this row's raw record.
// WHAT A PARAMETER-5 READ LOOKS LIKE IN THE RAW RECORD: the readback itself, or why it did not answer.
fn boot_param5_text(label: String, r: BootParam5Reading) -> String {
  match r {
    BootParam5Read { readback: rb, at: at } => concat("boot parameter 5 ", label, " (", at as String, "):\n", rb)
    BootParam5Unread { cause: c } => concat("boot parameter 5 ", label, ": UNREAD: ", bmc_read_cause_text(cause: c))
    BootParam5NotTaken { reason: why } => concat("boot parameter 5 ", label, ": NOT TAKEN: ", why as String)
  }
}

fn megarac_run_record_text(row: MegaRacBootRow, r: MegaRacRunRecord) -> String {
  join([
    concat("media=", megarac_media_attach_text(record: r.media)),
    concat("handoff_media=", megarac_handoff_media_text(h: r.handoff_media)),
    concat("end_media=", megarac_end_media_text(e: r.end_media)),
    concat("override=", override_consumption_text(c: r.override)),
    concat("power_after=", power_after_text(p: power_after_attempt(power: r.power_after,
      terminal: megarac_run_terminal(r)))),
    "-- phase timing (gunbc.host.managed_host_boot_phase_timing) --",
    boot_phase_timing_text(t: r.timing),
    boot_param5_text(label: "before", r: r.override_before),
    boot_param5_text(label: "after", r: r.override_after),
    "-- smpro pass at power on --",
    smpro_text(s: r.smpro_power_on),
    "-- smpro pass while the census ran --",
    smpro_text(s: r.smpro_census),
  ], "\n")
}

// `screen` is the attempt's KVM screen: the held observer's establishment, its journal of boundary
// and lifecycle events, every still with its instant and sha256 (or why it is not hash-bound), the
// gaps between stills, and the separately timestamped teardown. Evidence only: no finding and no
// verdict reads it (gunbc.machine_intake.megarac_kvm_still).
type MembersReading<T>
  = MembersRead { members: List<T> }
  | MembersUnread { cause: BmcReadCause }
  | MembersNotTaken { reason: NonEmptyStr }

// THE BMC'S OWN INVENTORY. `credential_removed` is carried because the per-attempt netrc that
// authenticated the reads must be shredded, and a shred that failed is a standing exposure this
// attempt created, which the bundle states rather than hides.
type InventoryReading {
  system_id: String
  memory: MembersReading<RedfishMemoryMember>
  processors: MembersReading<RedfishProcessorMember>
  credential_removed: Bool
}

type BootDiagnosticBundle {
  attempt: AttemptIdentityReading
  outcome: String
  sel_before: SelSnapshotReading
  sel_after: SelSnapshotReading
  sdr_cache: SdrCacheReading
  sensors: SensorReading
  smpro: SmproReading
  inventory: InventoryReading
  console: ConsoleReading
  run: MegaRacRunRecord
  screen: KvmObserverRecord
  configuration: AttemptConfigurationReceipt
}

fn inventory_not_taken(reason: NonEmptyStr) -> InventoryReading {
  InventoryReading { system_id: "", memory: MembersNotTaken { reason: reason }, processors: MembersNotTaken { reason: reason }, credential_removed: true }
}

// ── THE SEL DELTA ────────────────────────────────────────────────────────────────────────────
type SelDeltaReading
  = SelDeltaDecoded { delta: SelDelta }
  | SelDeltaRefused { cause: NonEmptyStr }
  | SelDeltaUnavailable { reason: String }

fn sel_delta_reading(before: SelSnapshotReading, after: SelSnapshotReading) -> SelDeltaReading {
  match before {
    SelSnapshotRead { raw: b, at: _ } =>
      match after {
        SelSnapshotRead { raw: a, at: _ } =>
          match sel_read(text: b) {
            ObservationRefused { cause: c } => SelDeltaRefused { cause: concat("before snapshot: ", c as String) as NonEmptyStr }
            ObservationEstablished { observed: watermark } =>
              match sel_after(watermark: watermark, text: a) {
                ObservationRefused { cause: c } => SelDeltaRefused { cause: c }
                ObservationEstablished { observed: delta } => SelDeltaDecoded { delta: delta }
              }
          }
        SelSnapshotUnread { cause: _ } => SelDeltaUnavailable { reason: "no after snapshot" }
        SelSnapshotNotTaken { reason: _ } => SelDeltaUnavailable { reason: "no after snapshot" }
      }
    SelSnapshotUnread { cause: _ } => SelDeltaUnavailable { reason: "no before snapshot" }
    SelSnapshotNotTaken { reason: _ } => SelDeltaUnavailable { reason: "no before snapshot" }
  }
}

fn sel_event_kind_text(event: SelWindowEvent) -> String {
  match event.kind {
    BootRestart { offset: _ } => "system boot initiated (section 42.2 sensor type 1Dh)"
    FirmwareProgressRecord { offset: o } => match o {
      FirmwareError => "system firmware error (section 42.2 sensor type 0Fh offset 00h, POST error)"
      FirmwareHang => "system firmware hang (section 42.2 sensor type 0Fh offset 01h)"
      FirmwareProgress { progress_rendering: r } => concat("system firmware progress: ", r as String)
    }
    OemTimestamped { payload: p } => concat("OEM record, manufacturer ", p.manufacturer_id_rendering as String, ", bytes ", p.oem_bytes_rendering as String, " (OEM-defined; not decoded)")
    OtherStandardEvent { rendering: r } => r as String
  }
}

fn sel_event_is_oem(event: SelWindowEvent) -> Bool {
  match event.kind { OemTimestamped { payload: _ } => true BootRestart { offset: _ } => false FirmwareProgressRecord { offset: _ } => false OtherStandardEvent { rendering: _ } => false }
}

fn sel_event_text(event: SelWindowEvent) -> String {
  concat("record ", to_string(event.record_id), " at ", event.bmc_clock_rendering as String, ": ", sel_event_kind_text(event: event))
}

// A STANDARD EVENT WHOSE SENSOR TYPE IS Memory (0Ch) OR Processor (07h). ipmitool renders the
// section 42.2 sensor-type name as the leading word of the sensor column, so the type is read
// from that column. A sensor NAME that merely mentions a CPU ("Voltage CPU0_0V75_PCP") is a
// voltage sensor and is not selected.
fn sel_event_is_memory_or_processor(event: SelWindowEvent) -> Bool {
  match event.kind {
    OtherStandardEvent { rendering: r } => {
      let sensor = sel_field(fields: map(split(s: r as String, delimiter: "|"), f => trim(f)), index: 3)
      starts_with(s: sensor, prefix: "Memory") || starts_with(s: sensor, prefix: "Processor")
    }
    FirmwareProgressRecord { offset: o } => match o { FirmwareProgress { progress_rendering: _ } => false FirmwareError => true FirmwareHang => true }
    BootRestart { offset: _ } => false
    OemTimestamped { payload: _ } => false
  }
}

// ── DECISIVE FINDINGS ────────────────────────────────────────────────────────────────────────
// THE SOCKETS THE CENSUS OBSERVED, derived from its slot rows rather than restated.
fn distinct_ints(xs: List<Int>) -> List<Int> {
  let empty: List<Int> = []
  fold(xs, init: empty, f: (acc, k) => if any(acc, j => j == k) { acc } else { concat(acc, [k]) })
}



fn smpro_text(s: SmproReading) -> String {
  match s {
    SmproProbed { observation: o } => smpro_pass_dossier_text(obs: o)
    SmproNotTaken { reason: why } => concat("NOT TAKEN: ", why as String)
  }
}

fn sensor_anomalies(row: MegaRacBootRow, s: SensorReading, receipt: AttemptConfigurationReceipt) -> List<BmcAnomaly> {
  match s {
    SensorsRead { lines: ls, at: _, naming: n } => megarac_sensor_anomalies(naming: n, lines: ls, sockets: row.sensor_sockets, expected: expected_socket_list(receipt: receipt))
    SensorsUnread { cause: _ } => []
    SensorsNotTaken { reason: _ } => []
  }
}

fn state_is_down(state: RedfishResourceState) -> Bool {
  match state {
    StateAbsent => true
    StateDisabled => true
    StateUnavailableOffline => true
    StateStandbyOffline => true
    StateEnabled => false
    StateStandbySpare => false
    StateInTest => false
    StateStarting => false
    StateDeferring => false
    StateQuiesced => false
    StateUpdating => false
    StateQualified => false
    StateDegraded => false
    StateUnrecognized { rendering: _ } => false
    StateNotReported => false
  }
}

fn health_is_bad(health: RedfishHealth) -> Bool {
  match health {
    HealthWarning => true
    HealthCritical => true
    HealthOk => false
    HealthUnrecognized { rendering: _ } => false
    HealthNotReported => false
  }
}

fn status_text(status: RedfishResourceStatus) -> String {
  concat("State=", redfish_resource_state_wire(state: status.state), " Health=", redfish_health_wire(health: status.health))
}

fn memory_socket(m: RedfishMemoryMember) -> Int? {
  match m.memory_location {
    Absent => none
    Present { value: loc } => loc.socket
  }
}

// -1 is never a socket index, so it stands for "the member reports no socket" in the grouping.
fn memory_socket_key(m: RedfishMemoryMember) -> Int {
  match memory_socket(m: m) { Absent => -1 Present { value: s } => s }
}

fn state_is_absent(state: RedfishResourceState) -> Bool {
  match state {
    StateAbsent => true
    StateEnabled => false
    StateDisabled => false
    StateStandbyOffline => false
    StateStandbySpare => false
    StateInTest => false
    StateStarting => false
    StateUnavailableOffline => false
    StateDeferring => false
    StateQuiesced => false
    StateUpdating => false
    StateQualified => false
    StateDegraded => false
    StateUnrecognized { rendering: _ } => false
    StateNotReported => false
  }
}

fn recorded_slot_rows(receipt: AttemptConfigurationReceipt) -> List<SlotRow>? {
  match receipt.dimms {
    PopulationLiveObserved { rows: rs, source: _ } => Present { value: rs }
    PopulationOperatorAttested { rows: rs, receipt: _ } => Present { value: rs }
    PopulationConflicted { readings: _ } => none
    PopulationNotRecorded { reason: _ } => none
  }
}

fn expected_socket_list(receipt: AttemptConfigurationReceipt) -> List<Int>? {
  match receipt.expected { ExpectedSockets { sockets: ks, source: _ } => Present { value: ks } ExpectedTopologyNotRecorded { reason: _ } => none }
}

// "CPU 1", "Socket 1": the trailing number of the BMC's own socket rendering, or none.
fn processor_socket_number(p: RedfishProcessorMember) -> Int? {
  match p.socket {
    Absent => none
    Present { value: t } => match filter(split(s: trim(t), delimiter: " "), x => x != "").last() { Absent => none Present { value: tok } => parse_int(s: tok) }
  }
}

fn memory_label(m: RedfishMemoryMember) -> String {
  match m.device_locator {
    Present { value: l } => concat(m.id as String, " (", l, ")")
    Absent => m.id as String
  }
}

fn processor_socket_suffix(p: RedfishProcessorMember) -> String {
  match p.socket { Present { value: s } => concat(" (Socket ", s, ")") Absent => "" }
}

// COMPLETENESS IS JUDGED PER EXPECTED SOCKET, never by a count: for each socket the receipt expects,
// exactly one Processor member names it (none is Missing, two or more is Duplicated); a member whose
// socket the BMC renders unreadably is its own anomaly. With no recorded topology none of these is
// judged (law 6). What the BMC states about a member's health stays unconditional.
fn processor_anomalies(processors: MembersReading<RedfishProcessorMember>, receipt: AttemptConfigurationReceipt) -> List<BmcAnomaly> {
  match processors {
    MembersRead { members: ps } => {
      let unhealthy = map(filter(ps, p => health_is_bad(health: p.status.health) || (state_is_down(state: p.status.state) && !state_is_absent(state: p.status.state))), p => ProcessorNotNominal { member: p })
      let per_socket = match expected_socket_list(receipt: receipt) {
        Absent => []
        Present { value: ks } => concat(
          flat_map(ks, k => {
            let on = filter(ps, p => match processor_socket_number(p: p) { Present { value: n } => n == k Absent => false })
            if count(on) == 0 { [ProcessorMissingOnExpectedSocket { socket: k }] }
            else if count(on) > 1 { [ProcessorSocketDuplicated { socket: k, members: on }] }
            else { flat_map(on, p => if state_is_absent(state: p.status.state) && !health_is_bad(health: p.status.health) { [ProcessorAbsentOnExpectedSocket { member: p, socket: k }] } else { [] }) }
          }),
          map(filter(ps, p => match processor_socket_number(p: p) { Present { value: _ } => false Absent => true }), p => ProcessorSocketUnreadable { member: p }))
      }
      concat(unhealthy, per_socket)
    }
    MembersUnread { cause: _ } => []
    MembersNotTaken { reason: _ } => []
  }
}

// PER SOCKET, OVER THE UNION OF THE SOCKETS THE RECEIPT RECORDS POPULATED AND THE SOCKETS THE BMC
// LISTS: a socket whose present members are fewer than the receipt's populated slots on it is an
// anomaly, including a socket the collection never mentions. With no recorded population nothing is
// judged (law 6). What the BMC states about a member's health stays unconditional.
fn memory_anomalies(memory: MembersReading<RedfishMemoryMember>, receipt: AttemptConfigurationReceipt) -> List<BmcAnomaly> {
  match memory {
    MembersRead { members: ms } => {
      let bad = map(filter(ms, m => (state_is_down(state: m.status.state) && !state_is_absent(state: m.status.state)) || health_is_bad(health: m.status.health)), m => MemoryNotNominal { member: m })
      let below = match recorded_slot_rows(receipt: receipt) {
        Absent => []
        Present { value: rows } => {
          let sockets = distinct_ints(xs: concat(map(filter(rows, r => r.populated), r => r.socket), filter(map(ms, m => memory_socket_key(m: m)), k => k >= 0)))
          flat_map(sockets, k => {
            let present = count(filter(ms, m => memory_socket_key(m: m) == k && !state_is_absent(state: m.status.state)))
            let populated = count(filter(rows, r => r.socket == k && r.populated))
            if present < populated { [MemoryBelowRecordedPopulation { socket: k, present: present, populated: populated }] } else { [] }
          })
        }
      }
      concat(below, bad)
    }
    MembersUnread { cause: _ } => []
    MembersNotTaken { reason: _ } => []
  }
}

fn sel_hardware_anomalies(delta: SelDeltaReading) -> List<BmcAnomaly> {
  match delta {
    SelDeltaDecoded { delta: d } => map(filter(d.events, e => sel_event_is_memory_or_processor(event: e)), e => SelHardwareEvent { event: e })
    SelDeltaRefused { cause: _ } => []
    SelDeltaUnavailable { reason: _ } => []
  }
}

// WHAT EACH BMC CHANNEL DID ON THIS ATTEMPT, one standing per read, derived from the sections
// themselves so no channel can be left out of the aggregate by omission. A read that answered on
// ANY channel means the BMC answered; a read not attempted (the attempt ended first, or the sensor
// read had no SDR cache to read through) is neither.
type BmcChannelStanding
  = BmcChannelAnswered
  | BmcChannelFailed { cause: BmcReadCause }
  | BmcChannelNotAttempted

type BmcChannelRead {
  channel: NonEmptyStr
  standing: BmcChannelStanding
}

fn sel_channel(channel: NonEmptyStr, s: SelSnapshotReading) -> BmcChannelRead {
  BmcChannelRead { channel: channel, standing: match s {
    SelSnapshotRead { raw: _, at: _ } => BmcChannelAnswered
    SelSnapshotUnread { cause: c } => BmcChannelFailed { cause: c }
    SelSnapshotNotTaken { reason: _ } => BmcChannelNotAttempted
  } }
}

fn members_channel<T>(channel: NonEmptyStr, m: MembersReading<T>) -> BmcChannelRead {
  BmcChannelRead { channel: channel, standing: match m {
    MembersRead { members: _ } => BmcChannelAnswered
    MembersUnread { cause: c } => BmcChannelFailed { cause: c }
    MembersNotTaken { reason: _ } => BmcChannelNotAttempted
  } }
}

// A PROBE THE BMC ANSWERED IS AN ANSWER, whatever it said: a word, a completion code (a NAK on the
// SMpro's address says the BMC is up and the device did not acknowledge), or an exit-zero response
// whose bytes did not parse, which is still the BMC replying; its malformed standing stays on the
// probe in the dossier. Only a probe with no completion code (the session or
// the deadline) is this channel failing, and it carries the first such probe's transport cause.
fn smpro_channel(row: MegaRacBootRow, s: SmproReading) -> BmcChannelRead {
  BmcChannelRead { channel: "ipmi master write-read (smpro)", standing: match s {
    SmproNotTaken { reason: _ } => BmcChannelNotAttempted
    SmproProbed { observation: obs } => {
      let os = obs.outcomes
      if any(os, o => match o { SmproWordRead { raw: _, word: _ } => true SmproControllerRefused { raw: _, completion: _ } => true SmproResponseMalformed { raw: _, detail: _ } => true SmproTransportFailed { raw: _, timed_out: _ } => false SmproNotSent { socket: _, register: _, reason: _ } => false SmproRequestUnencodable { socket: _, register: _, detail: _ } => false }) { BmcChannelAnswered }
      else {
        match flat_map(os, o => match o { SmproTransportFailed { raw: r, timed_out: _ } => [r] SmproWordRead { raw: _, word: _ } => [] SmproControllerRefused { raw: _, completion: _ } => [] SmproResponseMalformed { raw: _, detail: _ } => [] SmproNotSent { socket: _, register: _, reason: _ } => [] SmproRequestUnencodable { socket: _, register: _, detail: _ } => [] }).first() {
          Absent => BmcChannelNotAttempted
          Present { value: r } => BmcChannelFailed { cause: bmc_ipmitool_read_cause(endpoint: megarac_ipmi_endpoint(row: row), at: r.at, exit_code: r.exit_code, stderr: r.stderr) }
        }
      }
    }
  } }
}

fn bmc_channel_reads(row: MegaRacBootRow, bundle: BootDiagnosticBundle) -> List<BmcChannelRead> {
  [
    sel_channel(channel: "ipmi sel before", s: bundle.sel_before),
    sel_channel(channel: "ipmi sel after", s: bundle.sel_after),
    BmcChannelRead { channel: "ipmi sdr dump", standing: match bundle.sdr_cache {
      SdrCacheDumped { path: _, at: _ } => BmcChannelAnswered
      SdrCacheUnread { cause: c } => BmcChannelFailed { cause: c }
      SdrCacheNotTaken { reason: _ } => BmcChannelNotAttempted
    } },
    BmcChannelRead { channel: "ipmi sdr elist", standing: match bundle.sensors {
      SensorsRead { lines: _, at: _, naming: _ } => BmcChannelAnswered
      SensorsUnread { cause: c } => BmcChannelFailed { cause: c }
      SensorsNotTaken { reason: _ } => BmcChannelNotAttempted
    } },
    smpro_channel(row: row, s: bundle.smpro),
    smpro_channel(row: row, s: bundle.run.smpro_power_on),
    smpro_channel(row: row, s: bundle.run.smpro_census),
    members_channel(channel: "redfish memory", m: bundle.inventory.memory),
    members_channel(channel: "redfish processors", m: bundle.inventory.processors),
  ]
}

fn channel_answered(r: BmcChannelRead) -> Bool {
  match r.standing { BmcChannelAnswered => true BmcChannelFailed { cause: _ } => false BmcChannelNotAttempted => false }
}

fn channel_cause(r: BmcChannelRead) -> BmcReadCause? {
  match r.standing { BmcChannelFailed { cause: c } => Present { value: c } BmcChannelAnswered => none BmcChannelNotAttempted => none }
}

// EVERY BMC READ THAT WAS ATTEMPTED FAILED, AND NONE ANSWERED: the failed channels, in read order.
// Empty when any channel answered, and empty when nothing was attempted (an attempt that refused
// before reading the credential says so in every section separately).
// THE CARRIER IS THE DECISION: none of the channel reads answered -> the failed reads, as a
// FreeSemigroup, which cannot be empty. When some channel did answer, or when nothing answered but no
// read carries a cause either, this is `none` and no finding is raised -- the absence of a head is what
// "there is nothing to report" means, so no separate count check can disagree with it.
fn bmc_all_reads_failed(row: MegaRacBootRow, bundle: BootDiagnosticBundle) -> FreeSemigroup<BmcChannelRead>? {
  let reads = bmc_channel_reads(row: row, bundle: bundle)
  if any(reads, r => channel_answered(r: r)) {
    none
  } else {
    non_empty_failed_reads(failed: filter(reads, r => match channel_cause(r: r) { Present { value: _ } => true Absent => false }))
  }
}

// A List to a FreeSemigroup, total only where a head exists. Cited shape:
// gunbc.source_admission_selection.nonempty_source_keys_from_list, which does the same by first/skip.
// Kept local rather than minted in std.algebra because std.algebra already has the constructors
// (non_empty_singleton, non_empty_to_list) and this is the only place in the tree needing this direction.
fn non_empty_failed_reads(failed: List<BmcChannelRead>) -> FreeSemigroup<BmcChannelRead>? {
  match first(failed) {
    Absent => none
    Present { value: h } => Present { value: FreeSemigroup { head: h, tail: skip(failed, 1) } }
  }
}

// ── WHAT THE BUNDLE ESTABLISHES ────────────────────────────────────────────────────────────────
// THE EVIDENCE THE POWER-ON ACCOUNT READS, assembled from this bundle's own sections. Nothing is
// re-read: each field is a section already taken, or a standing derived from one.
fn smpro_pass(row: MegaRacBootRow, label: NonEmptyStr, s: SmproReading) -> List<SmproPassEvidence> {
  match s {
    SmproProbed { observation: o } => [SmproPassEvidence { label: label, observation: o }]
    SmproNotTaken { reason: _ } => []
  }
}

fn handoff_standing(h: MegaRacHandoff) -> PowerOnHandoff {
  match h {
    MegaRacHandoffAttempted { before: _, handoff: hc, after: _ } => match hc {
      MegaRacHandoffConfirmed => HandoffPoweredOn
      MegaRacHandoffAttemptedUnconfirmed { reason: r } => HandoffNotConfirmed { reason: concat("the boot-device and power handoff was attempted and not confirmed: ", r) as NonEmptyStr }
    }
    MegaRacHandoffWithheldAtRecheck { before: _ } => HandoffNotConfirmed { reason: "the pre-handoff recheck withheld the power write" }
    MegaRacHandoffNotReached { reason: r } => HandoffNotConfirmed { reason: r }
  }
}

fn console_evidence(c: ConsoleReading) -> ConsoleEvidence {
  match c {
    ConsoleRetained { path: _, size: _, lines: _, firmware: f, firmware_error_lines: e, capture_digest: dg, dram: d, checkpoints: cp, checkpoint_relations: rs, milestones: ms, sockets: o, against_reference: _, loader: g, linux: l, modules: m, nvparam: _, span_readings: sr } =>
      ConsoleRead { capture: dg, firmware: f, firmware_error_lines: e, dram: d, checkpoints: cp, relations: rs, milestones: ms, sockets: o, loader: g, linux: l, modules: m, span_readings: sr }
    ConsoleExceedsBound { path: _, size: _, bound: _ } => ConsoleNotRead
    NotRetained { path: _ } => ConsoleNotRead
    ConsoleUnread { path: _, detail: _ } => ConsoleNotRead
    ConsoleNotConfigured => ConsoleNotRead
  }
}

fn sel_evidence(delta: SelDeltaReading) -> SelEvidence {
  match delta {
    SelDeltaDecoded { delta: d } => SelEventsRead { events: d.events }
    SelDeltaRefused { cause: _ } => SelEventsNotRead
    SelDeltaUnavailable { reason: _ } => SelEventsNotRead
  }
}

// ── COVERAGE: one standing per carrier, never a host statement ─────────────────────────────────
fn console_coverage(c: ConsoleReading) -> CarrierStanding {
  match c {
    ConsoleRetained { path: _, size: _, lines: n, firmware: _, firmware_error_lines: _, capture_digest: _, dram: _, checkpoints: _, checkpoint_relations: _, milestones: _, sockets: _, against_reference: _, loader: _, linux: _, modules: _, nvparam: _, span_readings: _ } =>
      if n == 0 { CarrierReadEmpty } else { CarrierRead }
    ConsoleExceedsBound { path: p, size: _, bound: _ } => CarrierPartial { detail: concat("capture ", p as String, " is over the byte bound and was not read") as NonEmptyStr }
    NotRetained { path: p } => CarrierNotTaken { reason: concat("capture ", p as String, " is not retained with this artifact") as NonEmptyStr }
    ConsoleUnread { path: p, detail: d } => CarrierRefused { cause: concat("capture ", p as String, " unread: ", d) as NonEmptyStr }
    ConsoleNotConfigured => CarrierNotTaken { reason: "the SOL capture path was unset for this attempt" }
  }
}

fn kvm_coverage(rec: KvmObserverRecord) -> CarrierStanding {
  match rec.start {
    KvmObserverNotStarted { reason: r } => CarrierNotTaken { reason: r }
    KvmObserverStarted { dir: _, subject: _, standing: _, checked_at: _ } => if count(rec.stills) == 0 { CarrierReadEmpty } else { CarrierRead }
  }
}

fn smpro_answered(s: SmproReading) -> Bool {
  match s { SmproProbed { observation: o } => any(o.outcomes, o => match smpro_outcome_word(o: o) { Present { value: _ } => true Absent => false }) SmproNotTaken { reason: _ } => false }
}

fn smpro_coverage(row: MegaRacBootRow, readings: List<SmproReading>) -> CarrierStanding {
  if any(readings, r => smpro_answered(s: r)) { CarrierRead }
  else if any(readings, r => match r { SmproProbed { observation: _ } => true SmproNotTaken { reason: _ } => false }) { CarrierRefused { cause: "no SMpro register word was read in any pass" } }
  else { CarrierNotTaken { reason: "no SMpro pass was taken" } }
}

// THE ERROR-RECORD REGISTERS, covered apart from the boot-stage pair (#13058): a pass whose CUR and
// BOOTSTAGE read while GPI_RAS_ERR or a record word refused is a gap in THIS carrier, not in progress.
fn record_gaps(os: List<SmproProbeOutcome>, socket: Int) -> List<String> {
  let r = smpro_socket_records(outcomes: os, socket: socket)
  let gpi = match smpro_socket_word(outcomes: os, socket: socket, register: smpro_gpi_ras_err_reg.name) {
    Absent => [concat("socket ", to_string(socket), " GPI_RAS_ERR was not probed")]
    Present { value: o } => match smpro_outcome_word(o: o) { Present { value: _ } => [] Absent => [concat("socket ", to_string(socket), " GPI_RAS_ERR ", smpro_outcome_text(o: o))] }
  }
  concat(gpi, concat(match r.smpro.missing { Present { value: m } => [concat("socket ", to_string(socket), " SMpro records: ", m)] Absent => [] },
    match r.pmpro.missing { Present { value: m } => [concat("socket ", to_string(socket), " PMpro records: ", m)] Absent => [] }))
}

fn smpro_error_coverage(row: MegaRacBootRow, readings: List<SmproReading>) -> CarrierStanding {
  let passes = flat_map(readings, r => match r { SmproProbed { observation: o } => [o] SmproNotTaken { reason: _ } => [] })
  let gaps = flat_map(passes, o => flat_map(smpro_site_targets(site: o.subject.site), t => record_gaps(os: o.outcomes, socket: t.socket)))
  let wanted = fold(passes, init: 0, f: (acc, o) => acc + count(smpro_site_targets(site: o.subject.site)) * 3)
  if count(passes) == 0 { CarrierNotTaken { reason: "no SMpro pass was taken" } }
  else if count(gaps) == 0 { CarrierRead }
  else if count(gaps) >= wanted { CarrierRefused { cause: (match gaps.first() { Present { value: g } => g Absent => "every error-record read failed" }) as NonEmptyStr } }
  else { CarrierPartial { detail: join(gaps, "; ") as NonEmptyStr } }
}

fn sel_coverage(delta: SelDeltaReading) -> CarrierStanding {
  match delta {
    SelDeltaDecoded { delta: _ } => CarrierRead
    SelDeltaRefused { cause: c } => CarrierRefused { cause: c }
    SelDeltaUnavailable { reason: r } => CarrierNotTaken { reason: (if r == "" { "the SEL delta is unavailable" } else { r }) as NonEmptyStr }
  }
}

fn sensor_coverage(s: SensorReading) -> CarrierStanding {
  match s {
    SensorsRead { lines: ls, at: _, naming: _ } => if count(ls) == 0 { CarrierReadEmpty } else { CarrierRead }
    SensorsUnread { cause: c } => CarrierRefused { cause: bmc_read_cause_text(cause: c) as NonEmptyStr }
    SensorsNotTaken { reason: r } => CarrierNotTaken { reason: r }
  }
}

fn chassis_coverage(p: HostPowerReading) -> CarrierStanding {
  match p {
    HostPowerNotTaken { reason: r } => CarrierNotTaken { reason: r }
    HostPowerRead { state: state } => match state {
      PowerUnread { reason: _ } => CarrierRefused { cause: "the post-attempt chassis read did not answer" }
      _ => CarrierRead
    }
  }
}

fn members_coverage<T>(m: MembersReading<T>) -> CarrierStanding {
  match m {
    MembersRead { members: _ } => CarrierRead
    MembersUnread { cause: c } => CarrierRefused { cause: bmc_read_cause_text(cause: c) as NonEmptyStr }
    MembersNotTaken { reason: r } => CarrierNotTaken { reason: r }
  }
}

fn inventory_coverage(i: InventoryReading) -> CarrierStanding {
  match members_coverage(m: i.memory) {
    CarrierRead => members_coverage(m: i.processors)
    other => other
  }
}

fn media_coverage(m: MegaRacMediaAttach) -> CarrierStanding {
  match m {
    MegaRacMediaAttachNotAttempted { reason: r } => CarrierNotTaken { reason: r }
    MegaRacMediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: _ } => CarrierRead
  }
}

fn census_coverage(run: MegaRacRunRecord) -> CarrierStanding {
  if run.census_ended { CarrierRead } else { CarrierPartial { detail: "no census END marker was observed; the watch's own termination is the run's exit" } }
}

fn megarac_boot_coverage(row: MegaRacBootRow, bundle: BootDiagnosticBundle) -> List<CarrierCoverage> {
  let delta = sel_delta_reading(before: bundle.sel_before, after: bundle.sel_after)
  [
    CarrierCoverage { carrier: SolConsole, standing: console_coverage(c: bundle.console) },
    CarrierCoverage { carrier: KvmScreen, standing: kvm_coverage(rec: bundle.screen) },
    CarrierCoverage { carrier: SmproRegisters, standing: smpro_coverage(row: row, readings: [bundle.run.smpro_power_on, bundle.run.smpro_census, bundle.smpro]) },
    CarrierCoverage { carrier: SmproErrorRegisters, standing: smpro_error_coverage(row: row, readings: [bundle.run.smpro_power_on, bundle.run.smpro_census, bundle.smpro]) },
    CarrierCoverage { carrier: SystemEventLog, standing: sel_coverage(delta: delta) },
    CarrierCoverage { carrier: SensorTable, standing: sensor_coverage(s: bundle.sensors) },
    CarrierCoverage { carrier: ChassisPower, standing: chassis_coverage(p: bundle.run.power_after) },
    CarrierCoverage { carrier: RedfishInventory, standing: inventory_coverage(i: bundle.inventory) },
    CarrierCoverage { carrier: VirtualMedia, standing: media_coverage(m: bundle.run.media) },
    CarrierCoverage { carrier: HostCaptureMarkers, standing: census_coverage(run: bundle.run) },
  ]
}

fn megarac_boot_evidence(row: MegaRacBootRow, bundle: BootDiagnosticBundle) -> PowerOnEvidence {
  let delta = sel_delta_reading(before: bundle.sel_before, after: bundle.sel_after)
  let receipt = bundle.configuration
  PowerOnEvidence {
    configuration: receipt,
    handoff: handoff_standing(h: bundle.run.handoff_media),
    smpro: concat(smpro_pass(row: row, label: "power-on", s: bundle.run.smpro_power_on), concat(smpro_pass(row: row, label: "census", s: bundle.run.smpro_census), smpro_pass(row: row, label: "after the attempt", s: bundle.smpro))),
    console: console_evidence(c: bundle.console),
    sel: sel_evidence(delta: delta),
    watchdog: WatchdogUnobserved { reason: "the boot run does not read the BMC's IPMI watchdog" },
    bmc_anomalies: concat(processor_anomalies(processors: bundle.inventory.processors, receipt: receipt), concat(memory_anomalies(memory: bundle.inventory.memory, receipt: receipt), concat(sensor_anomalies(row: row, s: bundle.sensors, receipt: receipt), sel_hardware_anomalies(delta: delta)))),
    census_ended: bundle.run.census_ended,
    coverage: megarac_boot_coverage(row: row, bundle: bundle),
  }
}

// WHAT THE BUNDLE FOUND: the power-on account (the host and our coverage of it) and, beside it, what
// our harness did. The two are composed here because the harness records are this module's.
type MegaRacBootFindings {
  account: MegaRacAccountReceipt
  // WHAT THIS ROW'S HARNESS ADDED, from the raw sections the record's fields cannot express.
  harness: List<HarnessFinding>
  // WHAT THE ATTEMPT'S OWN RECORD STATES, derived by gunbc.host.boot_attempt from its fields. Kept
  // beside the harness list rather than merged into it: the two answer different questions and one
  // must not be able to carry the other's facts (the same reason the core keeps standing and derived
  // apart). Rendered as its own section, in the core's words -- this module has none for them.
  derived: List<DerivedFinding>
}

fn megarac_boot_harness(row: MegaRacBootRow, bundle: BootDiagnosticBundle) -> List<HarnessFinding> {
  let failed = bmc_all_reads_failed(row: row, bundle: bundle)
  concat(match failed { Absent => []  Present { value: xs } => [MegaRacEveryReadFailed { failed: xs }] },
    concat(media_attach_harness(record: bundle.run.media),
    concat(handoff_media_harness(h: bundle.run.handoff_media),
      if bundle.inventory.credential_removed { [] } else { [MegaRacCredentialMayRemain] })))
}

fn megarac_boot_findings(row: MegaRacBootRow, bundle: BootDiagnosticBundle, account: MegaRacAccountReceipt) -> MegaRacBootFindings {
  // ONE HARNESS PASS, feeding both lists: the harness findings are this row's raw-section report, and
  // they are also the standing list of the neutral record the core derives FROM. Deriving over the raw
  // record instead would ask the core's questions of this row's fields, which is how the two versions
  // of the override and power decisions drifted apart in the first place (review 81601).
  let harness = megarac_boot_harness(row: row, bundle: bundle)
  MegaRacBootFindings {
    account: account,
    harness: harness,
    derived: run_record_derived_findings(record: megarac_boot_run_record(raw: bundle.run, console: bundle.console,
      identity: bundle.attempt, harness: harness)),
  }
}

fn harness_finding_text(f: HarnessFinding) -> String {
  match f {
    MegaRacEveryReadFailed { failed: xs } => bmc_all_failed_text(failed: xs)
    MegaRacMediaAttachNotReady { record: r } => match r {
      MegaRacMediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: res } =>
        concat("media attach: ", match media_attach_outcome_reason(outcome: res.outcome) { Present { value: why } => why Absent => "not ready" })
      MegaRacMediaAttachNotAttempted { reason: why } => concat("media attach: not attempted: ", why as String)
    }
    MegaRacMediaAttachSessionHeld { record: r } => match r {
      MegaRacMediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: res } =>
        concat("media attach: the presentation is ready but the session was ", session_release_text(standing: res.session_release))
      MegaRacMediaAttachNotAttempted { reason: why } => concat("media attach: not attempted: ", why as String)
    }
    MegaRacHandoffWithheld { handoff: h } => match h {
      MegaRacHandoffWithheldAtRecheck { before: b } => concat("media was ready at the gate but the pre-handoff recheck did not admit it, so no boot-device or power write was made: ", recheck_text(v: presentation_still_served(result: b)))
      MegaRacHandoffNotReached { reason: _ } => "the pre-handoff recheck withheld the handoff"
      MegaRacHandoffAttempted { before: _, handoff: _, after: _ } => "the pre-handoff recheck withheld the handoff"
    }
    MegaRacHandoffUnconfirmed { handoff: h } => match h {
      MegaRacHandoffAttempted { before: _, handoff: hc, after: _ } => match hc {
        MegaRacHandoffAttemptedUnconfirmed { reason: r } => concat("the boot-device and power handoff was attempted and not confirmed: ", r)
        MegaRacHandoffConfirmed => "the boot-device and power handoff was confirmed"
      }
      MegaRacHandoffNotReached { reason: _ } => "the boot-device and power handoff was not attempted"
      MegaRacHandoffWithheldAtRecheck { before: _ } => "the boot-device and power handoff was not attempted"
    }
    MegaRacPresentationAfterHandoff { look: a } => match presentation_still_served(result: a) {
      PresentationStillReady => "after the handoff the presentation was still served"
      PresentationNoLongerReady { reason: why } => concat("the presentation was LOST at or after the boot-device and power handoff (", why as String, "): ", observation_text(r: a))
      PresentationUnobserved { reason: why } => concat("the post-handoff look was UNOBSERVED, so whether the presentation survived the handoff is INDETERMINATE (", why as String, "): ", observation_text(r: a))
      PresentationReadyButSessionHeld { held: r } => concat("after the handoff the presentation was served, but the look's own session was ", session_release_text(standing: r))
    }
    MegaRacCredentialMayRemain => "the per-attempt Redfish netrc could not be removed; credential material may remain on the runner"
  }
}

// THE ONE-LINE CONSEQUENCE ON THE RUN'S OUTCOME: the account's notes (its ending, every stated error,
// degradation and anomaly) and every harness finding are appended to a refusal reason, and a success
// stays a success. This is the whole of the bundle's reach into the verdict.
fn megarac_boot_outcome_with_findings(row: MegaRacBootRow, outcome: ProcessExit, findings: MegaRacBootFindings) -> ProcessExit {
  match outcome {
    ExitSuccess => ExitSuccess
    ExitFailure { code: c, reason: r } =>
      ExitFailure { code: c, reason: concat(r, " | power-on account: ", join(findings.account.notes, "; "),
        if count(findings.harness) == 0 { "" } else { concat(" | harness: ", join(map(findings.harness, f => harness_finding_text(f: f)), "; ")) }) }
  }
}

// ── RENDER ───────────────────────────────────────────────────────────────────────────────────
fn sel_snapshot_text(label: String, s: SelSnapshotReading) -> String {
  match s {
    SelSnapshotRead { raw: r, at: a } => concat(label, ": read at ", a as String, ", ", to_string(count(filter(split(s: r, delimiter: "\n"), l => trim(l) != ""))), " record(s)")
    SelSnapshotUnread { cause: c } => concat(label, ": UNREAD: ", bmc_read_cause_text(cause: c))
    SelSnapshotNotTaken { reason: why } => concat(label, ": NOT TAKEN: ", why as String)
  }
}

fn sdr_cache_text(s: SdrCacheReading) -> String {
  match s {
    SdrCacheDumped { path: p, at: a } => concat("sdr cache: dumped at ", a as String, " to ", p as String, "; both snapshots read through it")
    SdrCacheUnread { cause: c } => concat("sdr cache: UNREAD: ", bmc_read_cause_text(cause: c), "; both snapshots read the controller's SDR uncached")
    SdrCacheNotTaken { reason: why } => concat("sdr cache: NOT TAKEN: ", why as String)
  }
}

fn sel_raw_text(label: String, s: SelSnapshotReading) -> String {
  match s {
    SelSnapshotRead { raw: r, at: _ } => concat("-- raw ", label, " (ipmitool sel elist, verbatim) --\n", r)
    SelSnapshotUnread { cause: _ } => concat("-- raw ", label, ": none --")
    SelSnapshotNotTaken { reason: _ } => concat("-- raw ", label, ": none --")
  }
}

fn sel_delta_text(delta: SelDeltaReading) -> String {
  match delta {
    SelDeltaDecoded { delta: d } =>
      concat("delta: ", to_string(count(d.events)), " new record(s) (", to_string(count(filter(d.events, e => sel_event_is_oem(event: e)))), " OEM, kept opaque)\n",
        join(map(d.events, e => concat("  ", sel_event_text(event: e))), "\n"))
    SelDeltaRefused { cause: c } => concat("delta: REFUSED: ", c as String, " (both raw snapshots below)")
    SelDeltaUnavailable { reason: r } => concat("delta: UNAVAILABLE: ", r)
  }
}

fn optional_int_text(n: Int?) -> String {
  match n { Present { value: v } => to_string(v) Absent => "not-reported" }
}

fn memory_location_text(location: RedfishMemoryLocation?) -> String {
  match location {
    Absent => " location=not-reported"
    Present { value: l } => concat(" socket=", optional_int_text(n: l.socket), " controller=", optional_int_text(n: l.memory_controller), " channel=", optional_int_text(n: l.channel), " slot=", optional_int_text(n: l.slot))
  }
}

fn memory_member_text(m: RedfishMemoryMember) -> String {
  concat("  ", memory_label(m: m), memory_location_text(location: m.memory_location),
    " capacity_mib=", optional_int_text(n: m.capacity_mib), " ", status_text(status: m.status))
}

fn optional_text_or_not_reported(s: String?) -> String {
  match s { Present { value: v } => v Absent => "not-reported" }
}

fn processor_member_text(p: RedfishProcessorMember) -> String {
  concat("  ", p.id as String, " socket=", optional_text_or_not_reported(s: p.socket),
    " total_cores=", optional_int_text(n: p.total_cores), " ", status_text(status: p.status))
}

fn memory_members_text(row: MegaRacBootRow, m: MembersReading<RedfishMemoryMember>) -> String {
  match m {
    MembersRead { members: ms } => concat("memory: ", to_string(count(ms)), " member(s)\n", join(map(ms, x => memory_member_text(m: x)), "\n"))
    MembersUnread { cause: c } => concat("memory: UNREAD: ", bmc_read_cause_text(cause: c))
    MembersNotTaken { reason: why } => concat("memory: NOT TAKEN: ", why as String)
  }
}

fn processor_members_text(row: MegaRacBootRow, m: MembersReading<RedfishProcessorMember>) -> String {
  match m {
    MembersRead { members: ps } => concat("processors: ", to_string(count(ps)), " member(s)\n", join(map(ps, x => processor_member_text(p: x)), "\n"))
    MembersUnread { cause: c } => concat("processors: UNREAD: ", bmc_read_cause_text(cause: c))
    MembersNotTaken { reason: why } => concat("processors: NOT TAKEN: ", why as String)
  }
}

fn sensors_text(row: MegaRacBootRow, s: SensorReading) -> String {
  match s {
    SensorsRead { lines: ls, at: a, naming: n } => concat("read at ", a as String, ": ", megarac_sensor_table_text(naming: n, lines: ls, sockets: row.sensor_sockets))
    SensorsUnread { cause: c } => concat("UNREAD: ", bmc_read_cause_text(cause: c))
    SensorsNotTaken { reason: why } => concat("NOT TAKEN: ", why as String)
  }
}

fn megarac_boot_bundle_text(row: MegaRacBootRow, bundle: BootDiagnosticBundle, account: MegaRacAccountReceipt) -> String {
  let findings = megarac_boot_findings(row: row, bundle: bundle, account: account)
  join([
    concat(row.label, " boot diagnostics"),
    concat("attempt=", attempt_identity_text(a: bundle.attempt)),
    concat("outcome=", bundle.outcome),
    "== our best understanding of what happened (the power-on account) ==",
    findings.account.text,
    "== what our harness did ==",
    if count(findings.harness) == 0 { "nothing to report" } else { join(map(findings.harness, f => harness_finding_text(f: f)), "\n") },
    "== what the attempt's own record states went wrong (derived by the neutral core) ==",
    // The two findings this row used to word itself -- the un-consumed override and the powered-off
    // without a terminal -- are in this list, in the core's words. Deleting this section would hide a
    // fact the record states; re-wording it here would put a second vocabulary on one sum.
    if count(findings.derived) == 0 { "nothing to report" } else { join(map(findings.derived, d => derived_finding_text(f: d)), "\n") },
    "== bmc system event log ==",
    sel_snapshot_text(label: "before", s: bundle.sel_before),
    sel_snapshot_text(label: "after", s: bundle.sel_after),
    sdr_cache_text(s: bundle.sdr_cache),
    sel_delta_text(delta: sel_delta_reading(before: bundle.sel_before, after: bundle.sel_after)),
    sel_raw_text(label: "before", s: bundle.sel_before),
    sel_raw_text(label: "after", s: bundle.sel_after),
    "== bmc sensors (ipmi sdr elist) ==",
    sensors_text(row: row, s: bundle.sensors),
    "== this attempt: power, one-shot override, in-run smpro passes ==",
    megarac_run_record_text(row: row, r: bundle.run),
    "== post-power-on chassis-fan gate (the observation that decided the stop) ==",
    post_power_fan_gate_text(reading: bundle.run.fan_gate),
    "== smpro boot stage (ipmi master write-read) ==",
    "-- pass after the attempt --",
    smpro_text(s: bundle.smpro),
    "== bmc inventory (redfish) ==",
    concat("system=", if bundle.inventory.system_id == "" { "not-read" } else { bundle.inventory.system_id }),
    processor_members_text(row: row, m: bundle.inventory.processors),
    memory_members_text(row: row, m: bundle.inventory.memory),
    "== pre-os console ==",
    console_text(
      c: bundle.console,
      retained_prefix: row.retained_artifact_prefix as NonEmptyStr,
      census_sol_reference_path: row.console_reference.census_sol_artifact_path,
      reference_firmware_scope: row.console_reference.reference_firmware_scope,
      reference_configuration_scope: row.console_reference.reference_configuration_scope,
      expected_sockets: row.sensor_sockets,
    ),
    "== bmc kvm screen (held observer; stills retained, not interpreted) ==",
    kvm_observer_record_text(rec: bundle.screen),
    "",
  ], "\n")
}







fn megarac_diagnostics_allowance(row: MegaRacBootRow) -> Second {
  let sel = row.ipmi.planned_reads * ((second_count(s: row.ipmi.deadline) as Int) + (second_count(s: row.ipmi.kill_after) as Int))
  let redfish = row.redfish.read_budget * (second_count(s: row.redfish.read_deadline) as Int)
  second(count: sel + redfish + (second_count(s: row.publish_allowance) as Int))
}

// ── READS (effects) ──────────────────────────────────────────────────────────────────────────
fn megarac_ipmi_endpoint(row: MegaRacBootRow) -> NonEmptyStr {
  concat("ipmi lanplus ", row.controller.host as String) as NonEmptyStr
}

fn megarac_redfish_url(row: MegaRacBootRow, path: String) -> NonEmptyStr {
  concat("https://", row.controller.host as String, path) as NonEmptyStr
}

fn megarac_boot_sdr_cache(row: MegaRacBootRow, username: NonEmptyStr, password_file: NonEmptyStr, path: NonEmptyStr) -> SdrCacheReading
{
  let at = clock_now_probed_at_or_unknown()
  let r = diagnostic.ipmi.Tool.SdrDumpAuthenticated(
    bmc_host: row.controller.host,
    username: username,
    password_file: password_file,
    sdr_cache_file: path,
    deadline: coreutils_duration_operand(d: row.ipmi.deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: row.ipmi.kill_after) as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite),
  )
  if r.success {
    SdrCacheDumped { path: path, at: at }
  } else {
    SdrCacheUnread { cause: bmc_ipmitool_read_cause(endpoint: megarac_ipmi_endpoint(row: row), at: at, exit_code: r.exit_code, stderr: r.transport_stderr) }
  }
}

// THE SDR READ IS A MEGARAC SOCKET-NAMING OPERATION ON THE MANAGED HOST: the controller's endpoint and
// account come off its binding, and the read is made only for a host admitted for SDR socket naming
// (gunbc.host.megarac_managed_host), so a reading always carries the naming its build was read to use and a
// controller whose naming is unread is not read at all. The endpoint and the account are read through
// the bound control route (gunbc.host.bmc_control_binding), never stored beside the admission.
fn megarac_boot_sensors(row: MegaRacBootRow, password_file: NonEmptyStr, sdr: SdrCacheReading) -> SensorReading
{
  match sdr {
    SdrCacheDumped { path: p, at: _ } =>
      match megarac_host_admission_for(host: row.operator_host as NonEmptyStr, operation: MegaRacSdrSocketNaming) {
        MegaRacHostRefused { cause: c } => SensorsNotTaken { reason: megarac_host_refusal_text(cause: c) }
        MegaRacHostAdmitted { host: h } =>
          match megarac_sdr_socket_naming(host: h) {
            SdrSocketNamingRefused { reason: why } => SensorsNotTaken { reason: why }
            SdrSocketNamingBound { naming: naming } => match bmc_control_route_account(route: h.route) {
              Absent => SensorsNotTaken { reason: "the bound control route names no account, so the SDR read has no credential" }
              Present { value: account } => {
              let at = clock_now_probed_at_or_unknown()
              let r = diagnostic.ipmi.Tool.SdrElistAuthenticatedCached(
                bmc_host: bmc_control_route_endpoint(route: h.route).host,
                username: account,
                password_file: password_file,
                sdr_cache_file: p,
                deadline: coreutils_duration_operand(d: row.ipmi.deadline) as NonEmptyStr,
                kill_after: coreutils_duration_operand(d: row.ipmi.kill_after) as NonEmptyStr,
                cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite),
              )
              if r.success {
                SensorsRead { lines: sdr_decode_lines(stdout: r.stdout), at: at, naming: naming }
              } else {
                SensorsUnread { cause: bmc_ipmitool_read_cause(endpoint: megarac_ipmi_endpoint(row: row), at: at, exit_code: r.exit_code, stderr: r.transport_stderr) }
              }
            }
            }
          }
      }
    SdrCacheUnread { cause: c } => SensorsNotTaken { reason: concat("no SDR cache was dumped (", bmc_read_cause_kind(cause: c), "), and an uncached sdr elist is not made") as NonEmptyStr }
    SdrCacheNotTaken { reason: why } => SensorsNotTaken { reason: why }
  }
}

fn megarac_boot_param5(row: MegaRacBootRow, username: NonEmptyStr, password_file: NonEmptyStr) -> BootParam5Reading
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_param5_under_hold"),
  ]
{
  let at = clock_now_probed_at_or_unknown()
  let r = diagnostic.ipmi.Tool.ChassisBootParamGet(
    bmc_host: row.controller.host,
    username: username,
    password_file: password_file,
    parameter: "5",
    deadline: coreutils_duration_operand(d: row.ipmi.deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: row.ipmi.kill_after) as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite),
  )
  if r.success {
    BootParam5Read { readback: r.stdout, at: at }
  } else {
    BootParam5Unread { cause: bmc_ipmitool_read_cause(endpoint: megarac_ipmi_endpoint(row: row), at: at, exit_code: r.exit_code, stderr: r.transport_stderr) }
  }
}

fn megarac_boot_chassis_power(row: MegaRacBootRow, username: NonEmptyStr, password_file: NonEmptyStr) -> ChassisPowerObservation
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_power_after_poll"),
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_channel_lost"),
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "boot_fan_gate_power_off_poll"),
  ]
{
  let r = diagnostic.ipmi.Tool.ChassisStatus(
    bmc_host: row.controller.host,
    username: username,
    password_file: password_file,
    deadline: coreutils_duration_operand(d: row.ipmi.deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: row.ipmi.kill_after) as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite),
  )
  chassis_observation(success: r.success, stdout: r.stdout)
}

// WHETHER AN `mc info` READ SUCCEEDED, AS ITS OWN FRESH OBSERVATION. A lost SOL channel says nothing
// about the BMC or the chassis by itself. A read that did not succeed is NOT a statement that the
// controller gave no answer: a local tool failure, an authentication refusal or a session that could
// not be set up all fail the read while the controller may be answering. So the failed arm carries
// the typed BmcReadCause and nothing stronger; only its BmcTimeout arm says no answer arrived within
// the deadline.
type BmcReachability
  = BmcAnswered { at: NonEmptyStr }
  | BmcReadNotSucceeded { cause: BmcReadCause }

fn bmc_reachability_text(reading: BmcReachability) -> String {
  match reading {
    BmcAnswered { at: at } => concat("BMC answered mc info at ", at as String)
    BmcReadNotSucceeded { cause: c } => concat("mc info did not succeed: ", bmc_read_cause_text(cause: c))
  }
}

fn bmc_reachability_of_read(row: MegaRacBootRow, at: NonEmptyStr, success: Bool, exit_code: Int, stderr: String) -> BmcReachability {
  if success {
    BmcAnswered { at: at }
  } else {
    BmcReadNotSucceeded { cause: bmc_ipmitool_read_cause(endpoint: megarac_ipmi_endpoint(row: row), at: at, exit_code: exit_code, stderr: stderr) }
  }
}

fn megarac_boot_bmc_reachability(row: MegaRacBootRow, username: NonEmptyStr, password_file: NonEmptyStr) -> BmcReachability
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_channel_lost"),
  ]
{
  let at = clock_now_probed_at_or_unknown()
  let r = diagnostic.ipmi.Tool.McInfo(
    bmc_host: row.controller.host,
    username: username,
    password_file: password_file,
    deadline: coreutils_duration_operand(d: row.ipmi.deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: row.ipmi.kill_after) as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite),
  )
  bmc_reachability_of_read(row: row, at: at, success: r.success, exit_code: r.exit_code, stderr: r.transport_stderr)
}

fn sel_snapshot_of_read(row: MegaRacBootRow, at: NonEmptyStr, success: Bool, stdout: String, exit_code: Int, stderr: String) -> SelSnapshotReading {
  if success {
    SelSnapshotRead { raw: stdout, at: at }
  } else {
    SelSnapshotUnread { cause: bmc_ipmitool_read_cause(endpoint: megarac_ipmi_endpoint(row: row), at: at, exit_code: exit_code, stderr: stderr) }
  }
}

fn megarac_boot_sel_snapshot_uncached(row: MegaRacBootRow, at: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, deadline: NonEmptyStr, kill_after: NonEmptyStr) -> SelSnapshotReading {
  let r = diagnostic.ipmi.Tool.SelListAuthenticated(bmc_host: row.controller.host, username: username, password_file: password_file, deadline: deadline, kill_after: kill_after, cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite))
  sel_snapshot_of_read(row: row, at: at, success: r.success, stdout: r.stdout, exit_code: r.exit_code, stderr: r.transport_stderr)
}

fn megarac_boot_sel_snapshot(row: MegaRacBootRow, username: NonEmptyStr, password_file: NonEmptyStr, sdr: SdrCacheReading) -> SelSnapshotReading
{
  let at = clock_now_probed_at_or_unknown()
  let deadline = coreutils_duration_operand(d: row.ipmi.deadline) as NonEmptyStr
  let kill_after = coreutils_duration_operand(d: row.ipmi.kill_after) as NonEmptyStr
  match sdr {
    SdrCacheDumped { path: p, at: _ } => {
      let r = diagnostic.ipmi.Tool.SelListAuthenticatedCached(bmc_host: row.controller.host, username: username, password_file: password_file, sdr_cache_file: p, deadline: deadline, kill_after: kill_after, cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite))
      sel_snapshot_of_read(row: row, at: at, success: r.success, stdout: r.stdout, exit_code: r.exit_code, stderr: r.transport_stderr)
    }
    SdrCacheUnread { cause: _ } => megarac_boot_sel_snapshot_uncached(row: row, at: at, username: username, password_file: password_file, deadline: deadline, kill_after: kill_after)
    SdrCacheNotTaken { reason: _ } => megarac_boot_sel_snapshot_uncached(row: row, at: at, username: username, password_file: password_file, deadline: deadline, kill_after: kill_after)
  }
}

// ── COLLECTION COMPLETENESS (pure) ───────────────────────────────────────────────────────────
//
// A COLLECTION IS COMPLETE ONLY WHEN ITS PAGES ACCOUNT FOR ITS COUNT. The pages are the ones the
// reader followed through Members@odata.nextLink; the first page's Members@odata.count is the
// total DSP0266 says every page reports. No count, a last page that still names a next page, a
// member total different from the count, a count over the member bound, or a member link that is
// not a same-origin path: each refuses as incomplete, and no member is read. A short inventory is
// therefore never inferred from a first page alone.
type CollectionAssembly
  = CollectionComplete { links: List<NonEmptyStr> }
  | CollectionRefused { detail: NonEmptyStr }

fn redfish_collection_assembly(pages: List<RedfishCollectionPage>, member_bound: Int) -> CollectionAssembly {
  match pages.first() {
    Absent => CollectionRefused { detail: "no collection page was read" }
    Present { value: first } =>
      match first.member_count {
        Absent => CollectionRefused { detail: "the first page carries no Members@odata.count, so completeness cannot be established" }
        Present { value: total } => {
          let links = fold(pages, init: [], f: (acc, p) => concat(acc, p.member_links))
          let last_has_next = match reverse(pages).first() { Absent => false Present { value: p } => p.next_link != none }
          let refused_links = filter(links, l => match redfish_same_origin_link(link: l) { RedfishLinkRefused { cause: _ } => true RedfishLinkSameOrigin { path: _ } => false })
          let disagreeing = filter(pages, p => p.member_count != Present { value: total })
          let duplicated = first_duplicate(xs: links)
          if count(disagreeing) > 0 {
            CollectionRefused { detail: concat("a page reports Members@odata.count ", match disagreeing.first() { Absent => "" Present { value: p } => match p.member_count { Present { value: n } => to_string(n) Absent => "none" } }, " where the first page reported ", to_string(total)) as NonEmptyStr }
          } else if duplicated != none {
            CollectionRefused { detail: concat("member link ", match duplicated { Present { value: d } => d Absent => "" }, " is listed more than once") as NonEmptyStr }
          } else if last_has_next {
            CollectionRefused { detail: concat("the last page read still carries Members@odata.nextLink; ", to_string(count(links)), " of ", to_string(total), " member(s) read") as NonEmptyStr }
          } else if total > member_bound {
            CollectionRefused { detail: concat("Members@odata.count ", to_string(total), " exceeds the member bound ", to_string(member_bound)) as NonEmptyStr }
          } else if count(links) != total {
            CollectionRefused { detail: concat("Members@odata.count ", to_string(total), " but ", to_string(count(links)), " member link(s) across ", to_string(count(pages)), " page(s)") as NonEmptyStr }
          } else if count(refused_links) > 0 {
            CollectionRefused { detail: concat("member link is not a same-origin path: ", match refused_links.first() { Absent => "" Present { value: l } => l }) as NonEmptyStr }
          } else {
            CollectionComplete { links: map(links, l => l as NonEmptyStr) }
          }
        }
      }
  }
}

fn first_duplicate(xs: List<String>) -> String? {
  let empty: List<String> = []
  let found: String? = none
  let done = fold(xs, init: MembersSeen { seen: empty, duplicate: found }, f: (acc, x) => match acc.duplicate {
    Present { value: _ } => acc
    Absent => if any(acc.seen, y => y == x) { MembersSeen { seen: acc.seen, duplicate: Present { value: x } } } else { MembersSeen { seen: concat(acc.seen, [x]), duplicate: none } }
  })
  done.duplicate
}

type MembersSeen { seen: List<String>, duplicate: String? }

// ── MEMBER IDENTITY (pure) ───────────────────────────────────────────────────────────────────
//
// A COLLECTION IS IDENTITY-COMPLETE, NOT ONLY COUNT-COMPLETE: every member answered at the link that
// named it (its returned `@odata.id` is that link) and no two members returned one `Id`. A member
// that answers as another resource, or two links that resolve to one DIMM, would otherwise make a
// full count out of fewer slots. Any mismatch leaves the section unread, so no inventory-count
// finding can be minted from it.
type MemberBody { link: NonEmptyStr, body: String }

fn member_link_mismatch(m: MemberBody) -> String? {
  match redfish_resource_odata_id(body: m.body) {
    ObservationRefused { cause: c } => Present { value: concat("member at ", m.link as String, ": ", c as String) }
    ObservationEstablished { observed: returned } =>
      if (returned as String) == (m.link as String) { none } else { Present { value: concat("link ", m.link as String, " returned the resource ", returned as String) } }
  }
}

fn first_member_mismatch(bodies: List<MemberBody>) -> String? {
  match filter(map(bodies, b => member_link_mismatch(m: b)), r => r != none).first() {
    Absent => none
    Present { value: r } => r
  }
}

fn memory_member_ids(ms: List<RedfishMemoryMember>) -> List<String> {
  map(ms, m => m.id as String)
}

fn processor_member_ids(ps: List<RedfishProcessorMember>) -> List<String> {
  map(ps, p => p.id as String)
}

fn assemble_memory_members(row: MegaRacBootRow, collection: NonEmptyStr, at: NonEmptyStr, bodies: List<MemberBody>) -> MembersReading<RedfishMemoryMember> {
  match first_member_mismatch(bodies: bodies) {
    Present { value: why } => MembersUnread { cause: BmcResponseMalformed { endpoint: megarac_redfish_url(row: row, path: collection as String), at: at, detail: why } }
    Absent => {
      let empty: List<RedfishMemoryMember> = []
      let parsed = fold(bodies, init: MembersRead { members: empty }, f: (acc, b) => match acc {
        MembersRead { members: ms } => match redfish_memory_member_of(body: b.body) {
          ObservationRefused { cause: c } => MembersUnread { cause: BmcResponseMalformed { endpoint: megarac_redfish_url(row: row, path: b.link as String), at: at, detail: c as String } }
          ObservationEstablished { observed: m } => MembersRead { members: concat(ms, [m]) }
        }
        other => other
      })
      match parsed {
        MembersRead { members: ms } => match first_duplicate(xs: memory_member_ids(ms: ms)) {
          Present { value: d } => MembersUnread { cause: BmcCollectionIncomplete { endpoint: megarac_redfish_url(row: row, path: collection as String), at: at, detail: concat("two member links returned the same Id ", d) } }
          Absent => parsed
        }
        other => other
      }
    }
  }
}

fn assemble_processor_members(row: MegaRacBootRow, collection: NonEmptyStr, at: NonEmptyStr, bodies: List<MemberBody>) -> MembersReading<RedfishProcessorMember> {
  match first_member_mismatch(bodies: bodies) {
    Present { value: why } => MembersUnread { cause: BmcResponseMalformed { endpoint: megarac_redfish_url(row: row, path: collection as String), at: at, detail: why } }
    Absent => {
      let empty: List<RedfishProcessorMember> = []
      let parsed = fold(bodies, init: MembersRead { members: empty }, f: (acc, b) => match acc {
        MembersRead { members: ps } => match redfish_processor_member_of(body: b.body) {
          ObservationRefused { cause: c } => MembersUnread { cause: BmcResponseMalformed { endpoint: megarac_redfish_url(row: row, path: b.link as String), at: at, detail: c as String } }
          ObservationEstablished { observed: p } => MembersRead { members: concat(ps, [p]) }
        }
        other => other
      })
      match parsed {
        MembersRead { members: ps } => match first_duplicate(xs: processor_member_ids(ps: ps)) {
          Present { value: d } => MembersUnread { cause: BmcCollectionIncomplete { endpoint: megarac_redfish_url(row: row, path: collection as String), at: at, detail: concat("two member links returned the same Id ", d) } }
          Absent => parsed
        }
        other => other
      }
    }
  }
}

// ── REDFISH READS UNDER THE BUDGET ───────────────────────────────────────────────────────────
// THE BUDGET DECISION IS PURE: a read the budget cannot pay for is refused before any request is
// made, and the refusal names what the transaction did not reach.
fn redfish_budget_refusal(url: NonEmptyStr, at: NonEmptyStr, left: Int, not_reached: String) -> BmcReadCause? {
  if left <= 0 { Present { value: BmcDeadlineReached { endpoint: url, at: at, not_reached: not_reached } } } else { none }
}

type RedfishGet
  = RedfishGot { body: String, left: Int }
  | RedfishGetFailed { cause: BmcReadCause, left: Int }

fn redfish_get(row: MegaRacBootRow, netrc: NonEmptyStr, path: NonEmptyStr, left: Int, not_reached: String) -> RedfishGet
{
  let at = clock_now_probed_at_or_unknown()
  match redfish_budget_refusal(url: megarac_redfish_url(row: row, path: path as String), at: at, left: left, not_reached: not_reached) {
    Present { value: c } => return RedfishGetFailed { cause: c, left: left }
    Absent => {}
  }
  let r = redfish.Http.GetResourceByPath(
    bmc_host: row.controller.host,
    netrc_file: netrc,
    odata_path: path,
    max_seconds: to_string(second_count(s: row.redfish.read_deadline)) as NonEmptyStr,
  )
  if r.success {
    RedfishGot { body: r.body, left: left - 1 }
  } else {
    RedfishGetFailed { cause: bmc_curl_read_cause(endpoint: megarac_redfish_url(row: row, path: path as String), at: at, exit_code: r.exit_code, stderr: r.transport_stderr), left: left - 1 }
  }
}

type CollectionFetch
  = CollectionFetched { links: List<NonEmptyStr>, left: Int }
  | CollectionFetchFailed { cause: BmcReadCause, left: Int }

fn fetch_collection_pages(row: MegaRacBootRow, 
  netrc: NonEmptyStr,
  collection: NonEmptyStr,
  page: NonEmptyStr,
  pages_left: Int,
  left: Int,
  read: List<RedfishCollectionPage>,
) -> CollectionFetch
{
  let at = clock_now_probed_at_or_unknown()
  if pages_left <= 0 {
    return CollectionFetchFailed { cause: BmcCollectionIncomplete { endpoint: megarac_redfish_url(row: row, path: collection as String), at: at, detail: concat("page bound ", to_string(row.redfish.collection_page_bound), " reached with Members@odata.nextLink still pending") }, left: left }
  }
  match redfish_get(row: row, netrc: netrc, path: page, left: left, not_reached: concat("the rest of ", collection as String, " and every member of it")) {
    RedfishGetFailed { cause: c, left: l } => CollectionFetchFailed { cause: c, left: l }
    RedfishGot { body: body, left: l } =>
      match redfish_collection_page_of(body: body) {
        ObservationRefused { cause: c } => CollectionFetchFailed { cause: BmcResponseMalformed { endpoint: megarac_redfish_url(row: row, path: page as String), at: at, detail: c as String }, left: l }
        ObservationEstablished { observed: p } => {
          let pages = concat(read, [p])
          match p.next_link {
            Present { value: next } =>
              match redfish_same_origin_link(link: next) {
                RedfishLinkRefused { cause: why } => CollectionFetchFailed { cause: BmcCollectionIncomplete { endpoint: megarac_redfish_url(row: row, path: page as String), at: at, detail: concat("Members@odata.nextLink not followed: ", why as String) }, left: l }
                RedfishLinkSameOrigin { path: next_path } => fetch_collection_pages(row: row, netrc: netrc, collection: collection, page: next_path, pages_left: pages_left - 1, left: l, read: pages)
              }
            Absent =>
              match redfish_collection_assembly(pages: pages, member_bound: row.redfish.collection_member_bound) {
                CollectionRefused { detail: d } => CollectionFetchFailed { cause: BmcCollectionIncomplete { endpoint: megarac_redfish_url(row: row, path: collection as String), at: at, detail: d as String }, left: l }
                CollectionComplete { links: links } => CollectionFetched { links: links, left: l }
              }
          }
        }
      }
  }
}

fn fetch_collection(row: MegaRacBootRow, netrc: NonEmptyStr, collection: NonEmptyStr, left: Int) -> CollectionFetch
{
  fetch_collection_pages(row: row, netrc: netrc, collection: collection, page: collection, pages_left: row.redfish.collection_page_bound, left: left, read: [])
}

type MemoryFold { reading: MembersReading<RedfishMemoryMember>, left: Int }

type ProcessorFold { reading: MembersReading<RedfishProcessorMember>, left: Int }

fn member_not_reached(total: Int, read: Int) -> String {
  concat(to_string(total - read), " of ", to_string(total), " member read(s)")
}

type MemberBodiesFetch
  = MemberBodiesFetched { bodies: List<MemberBody>, left: Int }
  | MemberBodiesFailed { cause: BmcReadCause, left: Int }

fn fetch_member_bodies(row: MegaRacBootRow, netrc: NonEmptyStr, links: List<NonEmptyStr>, left: Int) -> MemberBodiesFetch
{
  let empty: List<MemberBody> = []
  fold(links, init: MemberBodiesFetched { bodies: empty, left: left }, f: (acc, link) => match acc {
    MemberBodiesFetched { bodies: bs, left: l } =>
      match redfish_get(row: row, netrc: netrc, path: link, left: l, not_reached: member_not_reached(total: count(links), read: count(bs))) {
        RedfishGetFailed { cause: c, left: l2 } => MemberBodiesFailed { cause: c, left: l2 }
        RedfishGot { body: body, left: l2 } => MemberBodiesFetched { bodies: concat(bs, [MemberBody { link: link, body: body }]), left: l2 }
      }
    other => other
  })
}

fn read_memory_members(row: MegaRacBootRow, netrc: NonEmptyStr, collection: NonEmptyStr, links: List<NonEmptyStr>, left: Int) -> MemoryFold
{
  match fetch_member_bodies(row: row, netrc: netrc, links: links, left: left) {
    MemberBodiesFailed { cause: c, left: l } => MemoryFold { reading: MembersUnread { cause: c }, left: l }
    MemberBodiesFetched { bodies: bs, left: l } => MemoryFold { reading: assemble_memory_members(row: row, collection: collection, at: clock_now_probed_at_or_unknown(), bodies: bs), left: l }
  }
}

fn read_processor_members(row: MegaRacBootRow, netrc: NonEmptyStr, collection: NonEmptyStr, links: List<NonEmptyStr>, left: Int) -> ProcessorFold
{
  match fetch_member_bodies(row: row, netrc: netrc, links: links, left: left) {
    MemberBodiesFailed { cause: c, left: l } => ProcessorFold { reading: MembersUnread { cause: c }, left: l }
    MemberBodiesFetched { bodies: bs, left: l } => ProcessorFold { reading: assemble_processor_members(row: row, collection: collection, at: clock_now_probed_at_or_unknown(), bodies: bs), left: l }
  }
}

fn link_absent_cause(row: MegaRacBootRow, system: NonEmptyStr, property: String) -> BmcReadCause {
  BmcResponseMalformed { endpoint: megarac_redfish_url(row: row, path: system as String), at: clock_now_probed_at_or_unknown(), detail: concat("the ComputerSystem publishes no ", property, " link, or a link that is not a same-origin path") }
}

fn same_origin_or_none(link: String?) -> NonEmptyStr? {
  match link {
    Absent => none
    Present { value: l } => match redfish_same_origin_link(link: l) {
      RedfishLinkSameOrigin { path: p } => Present { value: p }
      RedfishLinkRefused { cause: _ } => none
    }
  }
}

fn read_processors(row: MegaRacBootRow, netrc: NonEmptyStr, system: NonEmptyStr, link: String?, left: Int) -> ProcessorFold
{
  match same_origin_or_none(link: link) {
    Absent => ProcessorFold { reading: MembersUnread { cause: link_absent_cause(row: row, system: system, property: "Processors") }, left: left }
    Present { value: path } =>
      match fetch_collection(row: row, netrc: netrc, collection: path, left: left) {
        CollectionFetchFailed { cause: c, left: l } => ProcessorFold { reading: MembersUnread { cause: c }, left: l }
        CollectionFetched { links: links, left: l } => read_processor_members(row: row, netrc: netrc, collection: path, links: links, left: l)
      }
  }
}

fn read_memory(row: MegaRacBootRow, netrc: NonEmptyStr, system: NonEmptyStr, link: String?, left: Int) -> MemoryFold
{
  match same_origin_or_none(link: link) {
    Absent => MemoryFold { reading: MembersUnread { cause: link_absent_cause(row: row, system: system, property: "Memory") }, left: left }
    Present { value: path } =>
      match fetch_collection(row: row, netrc: netrc, collection: path, left: left) {
        CollectionFetchFailed { cause: c, left: l } => MemoryFold { reading: MembersUnread { cause: c }, left: l }
        CollectionFetched { links: links, left: l } => read_memory_members(row: row, netrc: netrc, collection: path, links: links, left: l)
      }
  }
}

// THE SELECTED SYSTEM IS IDENTITY-JOINED BEFORE ITS LINKS ARE FOLLOWED: the ComputerSystem that
// answered must return, as its own @odata.id, the link the Systems collection named. A system that
// answers as another resource would otherwise hand this attempt some other system's Memory and
// Processors, and every count finding after it would be about the wrong machine.
fn megarac_system_inventory_links(requested: NonEmptyStr, body: String) -> ObservationAttempt<RedfishSystemInventoryLinks, NonEmptyStr> {
  match redfish_resource_odata_id(body: body) {
    ObservationRefused { cause: c } => ObservationRefused { cause: c }
    ObservationEstablished { observed: returned } =>
      if (returned as String) != (requested as String) {
        ObservationRefused { cause: concat("system link ", requested as String, " returned the resource ", returned as String) as NonEmptyStr }
      } else {
        redfish_system_inventory_links_of(body: body)
      }
  }
}

fn inventory_unread(cause: BmcReadCause) -> InventoryReading {
  InventoryReading { system_id: "", memory: MembersUnread { cause: cause }, processors: MembersUnread { cause: cause }, credential_removed: true }
}


// The service root's Systems link: a typed absence when unpublished, a refusal when not same-origin.
fn megarac_systems_link(row: MegaRacBootRow, root_body: String, at: NonEmptyStr) -> ObservationAttempt<NonEmptyStr, BmcReadCause> {
  let root = megarac_redfish_url(row: row, path: row.redfish.service_root_path as String)
  match redfish_service_root_systems_link_of(body: root_body) {
    ObservationRefused { cause: c } => ObservationRefused { cause: BmcResponseMalformed { endpoint: root, at: at, detail: c as String } }
    ObservationEstablished { observed: Absent } => ObservationRefused { cause: BmcLinkUnpublished { endpoint: root, at: at, property: "Systems" } }
    ObservationEstablished { observed: Present { value: link } } =>
      match redfish_same_origin_link(link: link) {
        RedfishLinkSameOrigin { path: p } => ObservationEstablished { observed: p }
        RedfishLinkRefused { cause: d } => ObservationRefused { cause: BmcResponseMalformed { endpoint: root, at: at, detail: concat("service root Systems link refused: ", d as String) } }
      }
  }
}

// THE SYSTEM IS READ, NOT ASSUMED: the Systems collection must name exactly one member, whose own
// Memory and Processors links name the collections read next. Zero or several systems is a typed
// reading, since picking one would be a guess about which system the attempt booted.
fn read_inventory_with_netrc(row: MegaRacBootRow, netrc: NonEmptyStr) -> InventoryReading
{
  let at = clock_now_probed_at_or_unknown()
  match redfish_get(row: row, netrc: netrc, path: row.redfish.service_root_path, left: row.redfish.read_budget, not_reached: "the service root and every inventory read after it") {
    RedfishGetFailed { cause: c, left: _ } => inventory_unread(cause: c)
    RedfishGot { body: root_body, left: after_root } =>
      match megarac_systems_link(row: row, root_body: root_body, at: at) {
        ObservationRefused { cause: c } => inventory_unread(cause: c)
        ObservationEstablished { observed: systems_path } => read_inventory_from_systems(row: row, netrc: netrc, systems_path: systems_path, left: after_root, at: at)
      }
  }
}

fn read_inventory_from_systems(row: MegaRacBootRow, netrc: NonEmptyStr, systems_path: NonEmptyStr, left: Int, at: NonEmptyStr) -> InventoryReading
{
  match fetch_collection(row: row, netrc: netrc, collection: systems_path, left: left) {
    CollectionFetchFailed { cause: c, left: _ } => inventory_unread(cause: c)
    CollectionFetched { links: systems, left: left } =>
      if count(systems) != 1 {
        inventory_unread(cause: BmcResponseMalformed { endpoint: megarac_redfish_url(row: row, path: systems_path as String), at: at, detail: concat("Systems collection has ", to_string(count(systems)), " members; exactly one names the booted system") })
      } else {
        match systems.first() {
          Absent => inventory_not_taken(reason: "Systems collection member vanished between count and read")
          Present { value: system } =>
            match redfish_get(row: row, netrc: netrc, path: system, left: left, not_reached: "the system resource and every inventory read after it") {
              RedfishGetFailed { cause: c, left: _ } => inventory_unread(cause: c)
              RedfishGot { body: body, left: l } =>
                match megarac_system_inventory_links(requested: system, body: body) {
                  ObservationRefused { cause: c } => inventory_unread(cause: BmcResponseMalformed { endpoint: megarac_redfish_url(row: row, path: system as String), at: at, detail: c as String })
                  ObservationEstablished { observed: links } => {
                    let processors = read_processors(row: row, netrc: netrc, system: system, link: links.processors, left: l)
                    let memory = read_memory(row: row, netrc: netrc, system: system, link: links.memory, left: processors.left)
                    InventoryReading { system_id: system as String, memory: memory.reading, processors: processors.reading, credential_removed: true }
                  }
                }
            }
        }
      }
  }
}

fn megarac_boot_inventory(row: MegaRacBootRow, username: NonEmptyStr, password: String) -> InventoryReading
{
  let at = clock_now_probed_at_or_unknown()
  let endpoint = megarac_redfish_url(row: row, path: row.redfish.service_root_path as String)
  match with_private_netrc_binding(
    machine: row.controller.host,
    login: username,
    password: trim(s: password) as Secret,
    use: fn(binding) { read_inventory_with_netrc(row: row, netrc: netrc_binding_path(binding: binding) as NonEmptyStr) },
  ) {
    PrivateSecretFileNotEntered { cause: c } => inventory_unread(cause: BmcCredentialUnavailable { endpoint: endpoint, at: at, detail: c as String })
    PrivateSecretFileNotEnteredResidueRemains { cause: c } => {
      let cause = BmcCredentialUnavailable { endpoint: endpoint, at: at, detail: c as String }
      InventoryReading { system_id: "", memory: MembersUnread { cause: cause }, processors: MembersUnread { cause: cause }, credential_removed: false }
    }
    PrivateSecretFileCompleted { value: read } =>
      InventoryReading { system_id: read.system_id, memory: read.memory, processors: read.processors, credential_removed: true }
    PrivateSecretFileCompletedResidueRemains { value: read } =>
      InventoryReading { system_id: read.system_id, memory: read.memory, processors: read.processors, credential_removed: false }
  }
}




// THE BUNDLE IS WRITTEN, AND WHETHER IT WAS IS ITSELF A LINE IN THE RECEIPT. A failed write on a
// refused attempt is also appended to the refusal reason. On an accepted attempt the receipt line
// is the only place it can go, because the bundle may not flip the verdict.
type BundleWrite = BundleWritten | BundleWriteFailed { error: String }

fn bundle_write_receipt_line(row: MegaRacBootRow, w: BundleWrite) -> String {
  match w {
    BundleWritten => concat("diagnostics=", row.diagnostics_path)
    BundleWriteFailed { error: e } => concat("diagnostics=write-failed: ", e)
  }
}

fn megarac_boot_write_bundle(row: MegaRacBootRow, bundle: BootDiagnosticBundle, account: MegaRacAccountReceipt) -> BundleWrite {
  let written = Filesystem.Write(path: row.diagnostics_path, content: megarac_boot_bundle_text(row: row, bundle: bundle, account: account))
  if written.success { BundleWritten } else { BundleWriteFailed { error: written.error } }
}

fn megarac_boot_outcome_after_bundle(row: MegaRacBootRow, outcome: ProcessExit, bundle: BootDiagnosticBundle, write: BundleWrite, account: MegaRacAccountReceipt) -> ProcessExit {
  let with_findings = megarac_boot_outcome_with_findings(row: row, outcome: outcome, findings: megarac_boot_findings(row: row, bundle: bundle, account: account))
  match write {
    BundleWritten => with_findings
    BundleWriteFailed { error: e } =>
      match with_findings {
        ExitSuccess => ExitSuccess
        ExitFailure { code: c, reason: r } => ExitFailure { code: c, reason: concat(r, " | diagnostics bundle could not be written: ", e) }
      }
  }
}

// ── THE PRE-POWER READS (gunbc.host.host_boot_attempt_admission attempt_configuration_with_pre_power) ──
// Taken by the boot run after admission and before actuation. hpm check's table is parsed by
// extdeps.bmc.ipmitool_hpm_check; a failed read carries the controller's own cause.
fn megarac_boot_hpm_check(row: MegaRacBootRow, username: NonEmptyStr, password_file: NonEmptyStr, clearance: BootAttemptClearance, run_attempt: NonEmptyStr) -> PrePowerFirmware {
  let at = clock_now_probed_at_or_unknown()
  let retained_path = megarac_boot_hpm_check_path(row: row, run_attempt: run_attempt)
  let r = diagnostic.ipmi.Tool.HpmCheck(
    bmc_host: row.controller.host,
    username: username,
    password_file: password_file,
    deadline: coreutils_duration_operand(d: row.ipmi.deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: row.ipmi.kill_after) as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite),
  )
  if r.success {
    let retained = Filesystem.Write(path: retained_path, content: r.stdout)
    pre_power_firmware_observed(clearance: clearance, run_attempt: run_attempt, table: hpm_check_table_of(stdout: r.stdout), source: join(["ipmitool hpm check on ", row.controller.host as String, " at ", at as String], "") as NonEmptyStr)
  } else {
    PrePowerFirmwareUnread { reason: concat("hpm check was not read: ", bmc_read_cause_text(cause: bmc_ipmitool_read_cause(endpoint: megarac_ipmi_endpoint(row: row), at: at, exit_code: r.exit_code, stderr: r.transport_stderr))) as NonEmptyStr }
  }
}

// THE BUILD READING, FROM THE RETAINED BYTES. The pre-power read above keeps the controller's own hpm check
// output as a boot artifact, verbatim, so the file the run uploads is the file a later change commits to
// artifacts/bmc/ and names in a MegaRacVersionFromFirmwareRead standing. This reads that file BACK and runs
// the catalogue's one derivation over it (gunbc.host.bmc_release_capability_catalog
// megarac_version_establishment, component APP), so what the receipt reports is what those bytes establish,
// not a second reading of the tool. It is evidence for the restoration trigger of
// gunbc.rung_drop.megarac_operations_admitted_through_a_superseded_build_observation and changes no
// admission: production still admits operations through the observed build until that cutover lands.
// THE FILE IS NAMED BY THE RUN THAT READ IT. The runner's work tree outlives a run, so a fixed name could
// hand this run's readback a previous run's bytes after a failed read; keyed by GITHUB_RUN_ID (the
// run_attempt the boot passes, and the attempt identity the conclusion reads), a run reads back only what
// it wrote. The name is built from the ROW's retained-artifact prefix, so it lands inside the artifact
// glob that uploads the row's other retained evidence.
fn megarac_boot_hpm_check_path(row: MegaRacBootRow, run_attempt: NonEmptyStr) -> NonEmptyStr {
  join([row.retained_artifact_prefix, "hpm-check-", run_attempt as String, ".txt"], "") as NonEmptyStr
}

type MegaRacRetainedBuildReading
  = MegaRacBuildReadRetained { path: NonEmptyStr, established: MegaRacVersionEstablishment }
  | MegaRacBuildReadNotRetained { reason: NonEmptyStr }

fn megarac_build_reading_of(path: NonEmptyStr, read_ok: Bool, content: String, error: String) -> MegaRacRetainedBuildReading {
  if !read_ok {
    MegaRacBuildReadNotRetained { reason: concat("the retained hpm check could not be read back: ", error) as NonEmptyStr }
  } else if content == "" {
    MegaRacBuildReadNotRetained { reason: "no hpm check output was retained for this attempt" }
  } else {
    MegaRacBuildReadRetained { path: path, established: megarac_version_establishment(standing: MegaRacVersionFromFirmwareRead { artifact_path: path, component: "APP", stdout: content }) }
  }
}

fn megarac_boot_build_reading(row: MegaRacBootRow, attempt: AttemptIdentityReading) -> MegaRacRetainedBuildReading {
  match attempt {
    AttemptIdentityUnavailable { variable: v, detail: _ } => MegaRacBuildReadNotRetained { reason: concat("the run identity is unavailable, so no retained file is this run's: ", v as String) as NonEmptyStr }
    AttemptRunId { run_id: id } => {
      let path = megarac_boot_hpm_check_path(row: row, run_attempt: id)
      let r = Filesystem.Read(path: path as String)
      megarac_build_reading_of(path: path, read_ok: r.success, content: r.content, error: r.error)
    }
  }
}

fn megarac_build_reading_receipt_line(r: MegaRacRetainedBuildReading) -> String {
  concat("build=", match r {
    MegaRacBuildReadNotRetained { reason: why } => concat("not read: ", why as String)
    MegaRacBuildReadRetained { path: p, established: e } => match e {
      MegaRacReleaseEstablishedByRead { firmware: f } => join(["machine-read APP ", f.raw_version as String, " from ", p as String, " (uncommitted; commit it to ground the current build)"], "")
      MegaRacReleaseEstablishedByAttestation { firmware: f } => join(["attested ", f.raw_version as String, " from ", p as String], "")
      MegaRacReleaseEstablishmentRefused { standing: _, cause: c } => join(["retained at ", p as String, " but establishes no release: ", megarac_version_refusal_text(cause: c)], "")
    }
  })
}

// ── THE PRE-POWER READ-ONLY RETENTIONS: mc info AND fru print 0 ──────────────────────────────────
// The same retention the hpm check got (#14982's shape), extended to the two other READ-ONLY controller
// questions the boot asks before it touches power: `ipmitool mc info` (what BMC the endpoint says it is,
// the channel's own account) and `ipmitool fru print 0` (the board/chassis inventory the identity claims
// are made from). Both are declared `readonly` on extdeps.bmc.ipmi, both run in the pre-power phase
// beside the hpm check BEFORE any write, and both are kept VERBATIM per run id -- the same
// GITHUB_RUN_ID keying that makes a retained hpm check unforgeable across runs applies here: a run can
// only ever overwrite its own files, and the run uploads them (they sit inside the mtcollins1-boot-* glob).
// The reads answer no question the boot decides on -- the boot still resolves its build, admits, and
// actuates exactly as before; these two artifacts exist so the run's OWN words about who it talked to
// survive it, byte-for-byte, in the receipt and the uploaded bundle.
// THE NAME IS THE ROW'S, NOT THE MACHINE'S: like megarac_boot_hpm_check_path above, each retained path
// is built from the ROW's retained_artifact_prefix (one read, gunbc.machine_intake.mtcollins1_boot_row),
// so any row derives its own files inside its own upload glob -- the mtcollins1 row's prefix keeps the
// paths byte-identical to the ones this cut retained before.
fn mtcollins1_boot_mc_info_path(row: MegaRacBootRow, run_attempt: NonEmptyStr) -> NonEmptyStr {
  join([row.retained_artifact_prefix, "mc-info-", run_attempt as String, ".txt"], "") as NonEmptyStr
}

fn mtcollins1_boot_fru_print_path(row: MegaRacBootRow, run_attempt: NonEmptyStr) -> NonEmptyStr {
  join([row.retained_artifact_prefix, "fru-print-0-", run_attempt as String, ".txt"], "") as NonEmptyStr
}

type MtCollins1PrePowerRetention
  = PrePowerRetained { path: NonEmptyStr, bytes: ByteSize }
  | PrePowerNotRetained { reason: NonEmptyStr }

// THE FOLD BOTH WAYS OF ASKING PASS THROUGH. The pre-power phase writes the bytes the tool answered; the
// conclusion reads the file back by the run's own identity. Either way the SAME fold decides what counts
// as retained: the answer must have come, the bytes must be more than nothing, and what is kept carries
// the size of the VERBATIM content -- a ByteSize derived from the bytes themselves through this file's
// ONE size authority (std.measure, the same ByteSize the console bounds use; review 86396), so a
// retention whose number does not match its content cannot be written here. The failure arms carry the
// cause WITH THE STAGE VERB THE CALLER NAMES (review 86381 finding 1: "could not be written: <write
// error>" and "could not be read back: <file error>" are DIFFERENT failures and must not share a
// message); an empty answer is not a retention (a zero-byte file would be kept and say nothing).
fn mtcollins1_pre_power_retention_of(path: NonEmptyStr, read_ok: Bool, content: String, stage: NonEmptyStr, error: String) -> MtCollins1PrePowerRetention {
  if !read_ok {
    PrePowerNotRetained { reason: concat("could not be ", stage as String, ": ", error) as NonEmptyStr }
  } else if content == "" {
    PrePowerNotRetained { reason: concat(stage as String, " answered with no bytes at all, and an empty file is not a retention") as NonEmptyStr }
  } else {
    PrePowerRetained { path: path, bytes: byte_size(count: count(bytes_octets(b: utf8_encode_bytes(s: content)))) }
  }
}

// WHY A PRE-POWER READ DID NOT ANSWER, in the transport's OWN words. exit_code and stderr are
// exactly what the tool reported, run through the SAME typed-cause builder the firmware check and
// every other BMC read use — so a failed read names its failure (the exit status, and the tool's
// first stderr line) instead of a fixed shrug that could only ever mean "not read" (manager HOLD
// on review 86433 round). Pure: it composes the cause from what the caller observed and WHEN it
// was observed; the caller is the only thing that talks to the BMC or the clock.
fn pre_power_read_failure_reason(row: MegaRacBootRow, capture: NonEmptyStr, at: NonEmptyStr, exit_code: Int, stderr: String) -> NonEmptyStr {
  let cause = bmc_ipmitool_read_cause(
    endpoint: megarac_ipmi_endpoint(row: row),
    at: at,
    exit_code: exit_code,
    stderr: stderr,
  )
  concat(capture as String, " failed: ", bmc_read_cause_text(cause: cause)) as NonEmptyStr
}

// THE PRE-POWER WRITE OF `mc info`. Read-only by its operation declaration. A failed read keeps
// the tool's OWN cause (exit status + stderr through the shared BMC typed-cause builder), never a
// stand-in; the receipt line then reports that executed cause first and re-reads the file from
// disk as a second, independent witness.
fn mtcollins1_boot_mc_info_retain(row: MegaRacBootRow, username: NonEmptyStr, password_file: NonEmptyStr, run_attempt: NonEmptyStr) -> MtCollins1PrePowerRetention {
  let r = diagnostic.ipmi.Tool.McInfo(
    bmc_host: row.controller.host,
    username: username,
    password_file: password_file,
    deadline: coreutils_duration_operand(d: row.ipmi.deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: row.ipmi.kill_after) as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite),
  )
  if r.success {
    let path = mtcollins1_boot_mc_info_path(row: row, run_attempt: run_attempt)
    let retained = Filesystem.Write(path: path, content: r.stdout)
    mtcollins1_pre_power_retention_of(path: path, read_ok: retained.success, content: r.stdout, stage: "written", error: retained.error)
  } else {
    PrePowerNotRetained { reason: pre_power_read_failure_reason(row: row, capture: "mc info", at: clock_now_probed_at_or_unknown(), exit_code: r.exit_code, stderr: r.transport_stderr) }
  }
}

// THE PRE-POWER WRITE OF `fru print 0`. The id is fixed to 0 -- the board FRU the identity rows are read
// from, the same board whose fields the current-build identity takes (gunbc.machine_intake
// .mtcollins1_access_observation mtcollins1_current_build_identity): the boot keeps the controller's own
// inventory answer for every run, so a later identity claim can be checked against the run's capture
// rather than against a re-ask the controller may answer differently after a reflash.
fn mtcollins1_boot_fru_print_retain(row: MegaRacBootRow, username: NonEmptyStr, password_file: NonEmptyStr, run_attempt: NonEmptyStr) -> MtCollins1PrePowerRetention {
  let r = diagnostic.ipmi.Tool.FruPrint(
    bmc_host: row.controller.host,
    username: username,
    password_file: password_file,
    fru_id: "0",
    deadline: coreutils_duration_operand(d: row.ipmi.deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: row.ipmi.kill_after) as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: row.ipmi_cipher_suite),
  )
  if r.success {
    let path = mtcollins1_boot_fru_print_path(row: row, run_attempt: run_attempt)
    let retained = Filesystem.Write(path: path, content: r.stdout)
    mtcollins1_pre_power_retention_of(path: path, read_ok: retained.success, content: r.stdout, stage: "written", error: retained.error)
  } else {
    PrePowerNotRetained { reason: pre_power_read_failure_reason(row: row, capture: "fru print 0", at: clock_now_probed_at_or_unknown(), exit_code: r.exit_code, stderr: r.transport_stderr) }
  }
}

// THE READ-BACK, BY THE RUN'S OWN IDENTITY -- the file this run wrote or nothing. Same keying as the
// retained hpm check: without a run identity no file belongs to this attempt, so no file is read at all.
// ONE fn for both artifacts (review 86381 finding 2): the artifact is a parameter -- its path is built
// from the run id by the caller's own path function -- and the identity gate runs BEFORE any path is
// chosen, so neither artifact can grow a fixed-path fallback that the other would have to forget.
fn mtcollins1_boot_pre_power_retained(attempt: AttemptIdentityReading, path_of: fn(NonEmptyStr) -> NonEmptyStr) -> MtCollins1PrePowerRetention {
  match attempt {
    AttemptIdentityUnavailable { variable: v, detail: _ } => PrePowerNotRetained { reason: concat("the run identity is unavailable, so no retained file is this run's: ", v as String) as NonEmptyStr }
    AttemptRunId { run_id: id } => {
      let path = path_of(id)
      let r = Filesystem.Read(path: path as String)
      mtcollins1_pre_power_retention_of(path: path, read_ok: r.success, content: r.content, stage: "read back", error: r.error)
    }
  }
}

// THE RECEIPT LINE FOR ONE PRE-POWER CAPTURE -- the ORIGINAL cause, then the disk's own verdict
// (review 86381 finding 1). The line leads with what the WRITE side reported, carried in the attempt
// record from the pre-power phase that executed it: an ipmitool that refused says "not read: <cause>",
// a write that failed says "could not be written: <write error>", and neither is laundered into the
// read-back's file-not-found message. Only when the write side retained does the conclusion read the
// file back -- a retained-then-lost file (emptied, shrunk, removed between write and conclusion) is
// named as that, not reported as if nothing had been written. The Absent arm is the attempt that ENDED
// BEFORE the pre-power phase ran: honest silence about a phase that never happened, never a read of
// someone else's file. One fn for both artifacts; `prefix` (mc-info= / fru=) is the only difference,
// so the pairs of this PR's first cut collapse to this (review 86381 finding 2).
fn pre_power_retention_receipt_line(prefix: NonEmptyStr, executed: MtCollins1PrePowerRetention?, run: AttemptIdentityReading, path_of: fn(NonEmptyStr) -> NonEmptyStr) -> String {
  concat(prefix, "=", match executed {
    Absent => "not retained: the attempt ended before the pre-power phase ran"
    Present { value: r } => match r {
      PrePowerNotRetained { reason: why } => concat("not retained: ", why as String)
      PrePowerRetained { path: p, bytes: n } => match mtcollins1_boot_pre_power_retained(attempt: run, path_of: path_of) {
        PrePowerRetained { path: _, bytes: m } => join(["retained verbatim ", to_string(byte_size_count(b: n)), " bytes at ", p as String, ", read back at conclusion with ", to_string(byte_size_count(b: m)), " bytes"], "")
        PrePowerNotRetained { reason: why } => join(["written at ", p as String, " but not on disk at conclusion: ", why as String], "")
      }
    }
  })
}

data non_fold_residue_frontier: List<FrontierRow> = [
  FrontierRow { subject: PathSubject { path: "media_loss_of_look" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
]
