// ── THE INTERLOCK THE PER-RUN APPROVAL WAS PROVIDING WITHOUT SAYING SO ────────────────────────
//
// Until 2026-09-23 every Mt. Collins boot waited for one operator tap, and the operator tapped only
// when nobody had hands in the chassis. That consent carried two facts: "this effect may run" and
// "the unit is not under maintenance right now". The operator ruling of 2026-09-23 retired the
// first (the boot is a recurring automated effect; gunbc.auth.privileged_effect_census derives the
// federated pattern for it). The second is a physical-safety fact about the unit, not about who may
// authorize, so it does not dissolve with the approval stage: a boot that power-cycles a unit whose
// DIMMs are being reseated is the harm. It is carried here as ONE std.durable_exclusive_hold slot
// per unit, keyed by the machine name the signed subject already uses.
//
// ONE SLOT, TWO KINDS OF HOLDER, AND THAT IS THE POINT. The operator takes the slot for
// maintenance; the boot run takes the SAME slot before any BMC actuation and frees it after. So
// the boot refuses while the operator holds it (FileHoldOccupied, typed, naming the holder), the
// operator cannot start maintenance mid-boot without seeing the run as holder, and two boot runs
// exclude each other -- the exclusion the grant-keyed authorization claim slot supplied, now keyed
// by the unit rather than by an approval that no longer exists.
//
// THE STORE IS THE FILE-BACKED CAS ON THE RUNNER HOST (gunbc.durable_exclusive_hold_file_store),
// where the boot job runs and where the operator's own session takes the hold. An undecodable slot
// or an unavailable store REFUSES the boot: an interlock that cannot be read is not released.

data unit_hold_store_root: NonEmptyStr = "/var/lib/gunbc/unit-holds" as NonEmptyStr

data mtcollins1_unit_hold_key: NonEmptyStr = operator_host_mtcollins1 as NonEmptyStr

// The host the store lives on: the srv1 runner, where the boot job is pinned and where the operator
// takes maintenance holds. Every hold-owning root of this unit runs there.
data mtcollins1_unit_hold_store_host: NonEmptyStr = operator_host_srv1 as NonEmptyStr

// WHO HOLDS THE UNIT IS A DECLARED SUM (review 70459), each kind carrying its detail. The durable
// owner string is RENDERED from it and DECODED back to it here, in one place: nothing else builds an
// owner string or reads a kind out of one.
//
// A BOOT RUN IS A PROCESS, SO ITS OWNER NAMES THE PROCESS (gunbc#12533 finding 2). A run id alone
// says which attempt took the slot and nothing about whether that attempt is still running, so a
// worker killed while holding the unit left a hold nobody could ever show to be dead, and every later
// attempt refused on it. The boot's owner therefore carries the holding process's identity -- boot id,
// pid and start time, gunbc.build_cache_instance ProcessIdentity, the triple that survives pid reuse
// and reboots -- and the PID NAMESPACE it was read in (review 72326): a pid means something only in
// its namespace, and boot_id is shared by every namespace on a host, so a successor in another
// namespace would find NotFound for a holder that is alive. A successor recovers the slot only after
// OBSERVING that process gone FROM THE HOLDER'S OWN NAMESPACE; from any other it cannot look. An operator
// maintenance hold is deliberately not a process (it outlives the session that took it), so it is
// never recovered; a host reset-return hold names no process yet, so it is never recovered either.
type UnitHoldOwner
  = OperatorMaintenance { reason: NonEmptyStr }
  | BootRun { run_id: NonEmptyStr, process: ProcessIdentity, pid_namespace: NonEmptyStr }
  | HostResetReturn { attempt: NonEmptyStr }
  | KvmObserverProbe { run_id: NonEmptyStr, process: ProcessIdentity, pid_namespace: NonEmptyStr }

fn unit_hold_owner_tag(o: UnitHoldOwner) -> String {
  match o {
    OperatorMaintenance { reason: _ } => "operator-maintenance:"
    BootRun { run_id: _, process: _, pid_namespace: _ } => "mtcollins1-boot:"
    HostResetReturn { attempt: _ } => "host-reset-return:"
    KvmObserverProbe { run_id: _, process: _, pid_namespace: _ } => "mtcollins1-kvm-observer:"
  }
}


fn unit_hold_owner_detail(o: UnitHoldOwner) -> String {
  match o {
    OperatorMaintenance { reason: r } => r as String
    BootRun { run_id: r, process: p, pid_namespace: n } => concat(r as String, process_hold_text(p: p, pid_namespace: n))
    HostResetReturn { attempt: a } => a as String
    KvmObserverProbe { run_id: r, process: p, pid_namespace: n } => concat(r as String, process_hold_text(p: p, pid_namespace: n))
  }
}

fn unit_hold_owner_ref(o: UnitHoldOwner) -> DurableHoldOwnerRef {
  concat(unit_hold_owner_tag(o: o), unit_hold_owner_detail(o: o)) as DurableHoldOwnerRef
}

fn unit_hold_owner_label(o: UnitHoldOwner) -> String {
  match o {
    OperatorMaintenance { reason: r } => concat("operator maintenance: ", r as String)
    BootRun { run_id: r, process: p, pid_namespace: _ } => join(["the mtcollins1 boot run ", r as String, " (process ", to_string(p.pid), " on boot ", p.boot_id as String, ")"], "")
    HostResetReturn { attempt: a } => concat("host reset-return attempt ", a as String)
    KvmObserverProbe { run_id: r, process: p, pid_namespace: _ } => join(["the mtcollins1 KVM observer probe run ", r as String, " (process ", to_string(p.pid), " on boot ", p.boot_id as String, ")"], "")
  }
}

// THE DECODE IS TOTAL OVER THE FOUR TAGS AND REFUSES ANYTHING ELSE: an owner string written by
// something other than this module is not guessed into a kind.
type UnitHoldOwnerDecode
  = UnitHoldOwnerDecoded { owner: UnitHoldOwner }
  | UnitHoldOwnerUnrecognized { raw: String }

fn unit_hold_owner_detail_after(raw: String, tag: String) -> NonEmptyStr? {
  let rest = substring(s: raw, start: string_length(tag), end: string_length(raw))
  if rest == "" { none } else { Present { value: rest as NonEmptyStr } }
}

fn decode_unit_hold_owner(owner: DurableHoldOwnerRef) -> UnitHoldOwnerDecode {
  let raw = owner as String
  let op = unit_hold_owner_tag(o: OperatorMaintenance { reason: "x" as NonEmptyStr })
  let boot = unit_hold_owner_tag(o: BootRun { run_id: "x" as NonEmptyStr, process: ProcessIdentity { boot_id: "x" as NonEmptyStr, pid: 1, start_time: "x" as NonEmptyStr }, pid_namespace: "x" as NonEmptyStr })
  let reset = unit_hold_owner_tag(o: HostResetReturn { attempt: "x" as NonEmptyStr })
  let probe = unit_hold_owner_tag(o: KvmObserverProbe { run_id: "x" as NonEmptyStr, process: ProcessIdentity { boot_id: "x" as NonEmptyStr, pid: 1, start_time: "x" as NonEmptyStr }, pid_namespace: "x" as NonEmptyStr })
  if starts_with(s: raw, prefix: op) {
    match unit_hold_owner_detail_after(raw: raw, tag: op) { Present { value: d } => UnitHoldOwnerDecoded { owner: OperatorMaintenance { reason: d } }  Absent => UnitHoldOwnerUnrecognized { raw: raw } }
  } else if starts_with(s: raw, prefix: boot) {
    match unit_hold_owner_detail_after(raw: raw, tag: boot) {
      Absent => UnitHoldOwnerUnrecognized { raw: raw }
      Present { value: d } => {
        let halves = split(s: d as String, delimiter: process_hold_marker)
        if count(halves) != 2 || text_at(xs: halves, i: 0) == "" {
          UnitHoldOwnerUnrecognized { raw: raw }
        } else {
          match process_hold_decode(text: concat("boot=", text_at(xs: halves, i: 1))) {
            Present { value: h } => UnitHoldOwnerDecoded { owner: BootRun { run_id: text_at(xs: halves, i: 0) as NonEmptyStr, process: h.process, pid_namespace: h.pid_namespace } }
            Absent => UnitHoldOwnerUnrecognized { raw: raw }
          }
        }
      }
    }
  } else if starts_with(s: raw, prefix: probe) {
    match unit_hold_owner_detail_after(raw: raw, tag: probe) {
      Absent => UnitHoldOwnerUnrecognized { raw: raw }
      Present { value: d } => {
        let halves = split(s: d as String, delimiter: process_hold_marker)
        if count(halves) != 2 || text_at(xs: halves, i: 0) == "" {
          UnitHoldOwnerUnrecognized { raw: raw }
        } else {
          match process_hold_decode(text: concat("boot=", text_at(xs: halves, i: 1))) {
            Present { value: h } => UnitHoldOwnerDecoded { owner: KvmObserverProbe { run_id: text_at(xs: halves, i: 0) as NonEmptyStr, process: h.process, pid_namespace: h.pid_namespace } }
            Absent => UnitHoldOwnerUnrecognized { raw: raw }
          }
        }
      }
    }
  } else if starts_with(s: raw, prefix: reset) {
    match unit_hold_owner_detail_after(raw: raw, tag: reset) { Present { value: d } => UnitHoldOwnerDecoded { owner: HostResetReturn { attempt: d } }  Absent => UnitHoldOwnerUnrecognized { raw: raw } }
  } else {
    UnitHoldOwnerUnrecognized { raw: raw }
  }
}

fn host_reset_owner(attempt: NonEmptyStr) -> DurableHoldOwnerRef {
  unit_hold_owner_ref(o: HostResetReturn { attempt: attempt })
}

// The operator names why they hold the unit; the reason is the owner, so a refused boot prints it.
data mtcollins1_maintenance_reason_env: NonEmptyStr = "GUNBC_MTCOLLINS1_MAINTENANCE_REASON"

fn operator_maintenance_owner(reason: NonEmptyStr) -> DurableHoldOwnerRef {
  unit_hold_owner_ref(o: OperatorMaintenance { reason: reason })
}

fn boot_run_owner(run_id: NonEmptyStr, process: ProcessIdentity, pid_namespace: NonEmptyStr) -> DurableHoldOwnerRef {
  unit_hold_owner_ref(o: BootRun { run_id: run_id, process: process, pid_namespace: pid_namespace })
}

// ── THE PROOF: MINTED ONLY INSIDE THE LIVE ACQUIRE'S FileHoldAcquired ARM ──────────────────────
// Every function that performs a BMC write on a hold-gated unit takes a UnitHoldProof, and the
// proof is sole_constructor: the compiler refuses a UnitHoldProof literal anywhere but this module
// (SoleConstructorViolation), and this module mints one in exactly one place -- the FileHoldAcquired
// arm of unit_hold_minted, admitted only to unit_hold_acquire and fed only that call's own live
// compare-and-set outcomes. A supplied or authored
// acquire outcome therefore cannot become a proof: the pure refusal fold below reads outcomes, and
// it returns text, never a proof. test.claim.machine_intake.mtcollins1_maintenance_hold_witness_test
// enrolls test.probe.unit_hold_proof_forged_probe, where a forged proof is refused at the literal.
type UnitHoldProof sole_constructor {
  root: NonEmptyStr
  key: NonEmptyStr
  owner: DurableHoldOwnerRef
  generation: CasGeneration
}

type UnitHoldAcquisition
  = UnitHeld { proof: UnitHoldProof }
  | UnitHoldRefused { reason: NonEmptyStr }

// THE DECISION TEXT IS A PURE FOLD OVER THE STORE'S TYPED OUTCOME, and it is the only thing a
// supplied outcome may feed. Absent means the outcome was an acquisition; it never mints anything.
fn unit_hold_refusal(outcome: FileHoldAcquireOutcome) -> NonEmptyStr? {
  match outcome {
    FileHoldAcquired { slot_key: _, owner: _, generation: _ } => none
    FileHoldOccupied { slot_key: k, holder: h, generation: _ } =>
      Present { value: join(["unit ", k as String, " is held by '", h as String, "'; no BMC actuation until it is released; controller untouched"], "") as NonEmptyStr }
    FileHoldAcquireLost { slot_key: k } =>
      Present { value: join(["lost the race for unit hold ", k as String, "; controller untouched"], "") as NonEmptyStr }
    FileHoldAcquireStoreUnavailable { slot_key: k, cause: _ } =>
      Present { value: join(["unit hold store unavailable for ", k as String, "; an unreadable interlock is not a released one; controller untouched"], "") as NonEmptyStr }
    FileHoldSlotUndecodable { slot_key: k, generation: _, detail: d } =>
      Present { value: join(["unit hold ", k as String, " undecodable (", d as String, "); controller untouched"], "") as NonEmptyStr }
    FileHoldKeyNotSlotAddressable { slot_key: k } =>
      Present { value: join(["unit hold key ", k as String, " is not slot-addressable; controller untouched"], "") as NonEmptyStr }
  }
}

// ── RECOVERING A HOLD WHOSE HOLDER WAS OBSERVED DEAD ───────────────────────────────────────────
// Only a holder whose owner names a process can be observed, so only a decoded BootRun or
// KvmObserverProbe is looked at;
// every other owner is reported as not recoverable. The liveness verdict is bound to the holder and
// generation the refused acquire saw, and the recovery re-reads the slot, so a hold that changed hands
// in between is not the one freed. Age is never an input.
// WHICH HOLDERS ARE OBSERVED, AS A PURE ROUTE: a holder whose decoded owner names a process -- a boot run
// or a KVM observer probe -- is observed by that process; every other owner is unobservable, with why.
type HolderLivenessRoute
  = HolderObserveProcess { process: ProcessIdentity, pid_namespace: NonEmptyStr }
  | HolderNotObservable { cause: NonEmptyStr }

fn holder_liveness_route(holder: DurableHoldOwnerRef) -> HolderLivenessRoute {
  match decode_unit_hold_owner(owner: holder) {
    UnitHoldOwnerDecoded { owner: BootRun { run_id: _, process: p, pid_namespace: n } } => HolderObserveProcess { process: p, pid_namespace: n }
    UnitHoldOwnerDecoded { owner: KvmObserverProbe { run_id: _, process: p, pid_namespace: n } } => HolderObserveProcess { process: p, pid_namespace: n }
    UnitHoldOwnerDecoded { owner: OperatorMaintenance { reason: _ } } =>
      HolderNotObservable { cause: "an operator maintenance hold is not bound to a process; only the operator releases it" as NonEmptyStr }
    UnitHoldOwnerDecoded { owner: HostResetReturn { attempt: _ } } =>
      HolderNotObservable { cause: "a host reset-return hold names no process, so its holder cannot be observed" as NonEmptyStr }
    UnitHoldOwnerUnrecognized { raw: _ } =>
      HolderNotObservable { cause: "the holder's owner names no process this module can observe (it was written without one, or not by this module)" as NonEmptyStr }
  }
}

fn holder_report(holder: DurableHoldOwnerRef, generation: CasGeneration) -> DurableHoldHolderReport {
  let liveness = match holder_liveness_route(holder: holder) {
    HolderObserveProcess { process: p, pid_namespace: n } => holder_process_liveness(p: p, pid_namespace: n)
    HolderNotObservable { cause: c } => HolderLivenessUnobservable { cause: c }
  }
  DurableHoldHolderReport { holder: holder, generation: generation, liveness: liveness }
}

type DeadHolderRecovery
  = DeadHolderRecovered { dead_holder: DurableHoldOwnerRef, evidence: NonEmptyStr }
  | DeadHolderNotRecovered { reason: NonEmptyStr }

fn recovery_refusal_text(key: NonEmptyStr, r: DurableHoldRecoveryRefusal) -> NonEmptyStr {
  let why = match r {
    HoldRecoveryNothingHeld => "the slot was released before recovery"
    HoldRecoveryHolderLive { generation: _, holder: h, evidence: e } => join(["is held by '", h as String, "', which is alive (", e as String, "); no BMC actuation until it is released"], "")
    HoldRecoveryHolderUnobservable { generation: _, holder: h, cause: c } => join(["is held by '", h as String, "', whose liveness could not be observed (", c as String, "); an unobserved holder is not a dead one, so the hold stands"], "")
    HoldRecoverySlotMoved { reported: _, observed: _ } => "moved while its holder was being observed; re-run"
    HoldRecoveryReportForAnotherHolder { holder: h, reported: _ } => join(["changed hands to '", h as String, "' while its holder was being observed; re-run"], "")
    HoldRecoverySlotUndecodable { generation: _, detail: d } => concat("became undecodable: ", d as String)
    HoldRecoveryObservationUnavailable { cause: _ } => "could not be re-read for recovery; an unreadable interlock is not a released one"
  }
  join(["unit ", key as String, " ", why, "; controller untouched"], "") as NonEmptyStr
}

fn unit_hold_recover_dead_holder(root: NonEmptyStr, key: NonEmptyStr, holder: DurableHoldOwnerRef, generation: CasGeneration) -> DeadHolderRecovery
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_maintenance_hold", decl_name: "unit_hold_acquire"),
  ]
{
  let report = holder_report(holder: holder, generation: generation)
  let released_by = join(["recovered-dead-holder:", holder as String], "") as DurableHoldReleaseRef
  match file_hold_recovery_assess(root: root, slot_key: key, report: report, released_by: released_by, retention: KeepAllGenerations) {
    FileHoldRecoveryNotEligible { slot_key: _, refusal: r } => DeadHolderNotRecovered { reason: recovery_refusal_text(key: key, r: r) }
    FileHoldRecoveryPlanned { plan: p, dead_holder: h, evidence: e } =>
      match file_hold_release_commit(plan: p) {
        FileHoldReleased { slot_key: _, generation: _ } => DeadHolderRecovered { dead_holder: h, evidence: e }
        FileHoldReleaseLost { slot_key: _ } => DeadHolderNotRecovered { reason: join(["unit ", key as String, " moved before the dead holder's hold was freed; re-run; controller untouched"], "") as NonEmptyStr }
        FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } => DeadHolderNotRecovered { reason: join(["unit hold store refused freeing the dead holder's hold on ", key as String, "; controller untouched"], "") as NonEmptyStr }
        FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } => DeadHolderNotRecovered { reason: join(["unit hold key ", key as String, " is not slot-addressable; controller untouched"], "") as NonEmptyStr }
      }
  }
}

// The proof is built here, from an outcome only unit_hold_acquire's own live acquires produce: the
// admission is what keeps a supplied FileHoldAcquired from becoming a proof.
fn unit_hold_minted(root: NonEmptyStr, key: NonEmptyStr, outcome: FileHoldAcquireOutcome) -> UnitHoldAcquisition
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_maintenance_hold", decl_name: "unit_hold_acquire"),
  ]
{
  match outcome {
    FileHoldAcquired { slot_key: _, owner: o, generation: g } =>
      UnitHeld { proof: UnitHoldProof { root: root, key: key, owner: o, generation: g } }
    FileHoldOccupied { slot_key: _, holder: _, generation: _ } => unit_hold_not_acquired(outcome: outcome)
    FileHoldAcquireLost { slot_key: _ } => unit_hold_not_acquired(outcome: outcome)
    FileHoldAcquireStoreUnavailable { slot_key: _, cause: _ } => unit_hold_not_acquired(outcome: outcome)
    FileHoldSlotUndecodable { slot_key: _, generation: _, detail: _ } => unit_hold_not_acquired(outcome: outcome)
    FileHoldKeyNotSlotAddressable { slot_key: _ } => unit_hold_not_acquired(outcome: outcome)
  }
}

fn unit_hold_not_acquired(outcome: FileHoldAcquireOutcome) -> UnitHoldAcquisition {
  match unit_hold_refusal(outcome: outcome) {
    Present { value: r } => UnitHoldRefused { reason: r }
    Absent => UnitHoldRefused { reason: "unit hold outcome unclassified; controller untouched" as NonEmptyStr }
  }
}

// THE ONE MINT. The live acquire and the proof are one boundary: the proof exists only when the
// compare-and-set this call performed committed a hold for this owner. An OCCUPIED slot is asked one
// further question -- is its holder observed dead? -- and only an observed-dead holder's hold is freed,
// after which this caller acquires once more like any acquirer. There is no loop: a slot taken by
// someone else in between refuses as occupied, naming them.
fn unit_hold_acquire(root: NonEmptyStr, key: NonEmptyStr, owner: DurableHoldOwnerRef) -> UnitHoldAcquisition
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_maintenance_hold", decl_name: "mtcollins1_boot_acquire_unit_hold"),
    decl_ref(module_path: "gunbc.host_reset_return_run", decl_name: "host_reset_return_wet"),
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_maintenance_hold", decl_name: "mtcollins1_kvm_observer_acquire_unit_hold"),
  ]
{
  let outcome = file_hold_acquire(root: root, slot_key: key, requested_owner: owner, retention: KeepAllGenerations)
  match outcome {
    FileHoldOccupied { slot_key: _, holder: h, generation: g } =>
      match unit_hold_recover_dead_holder(root: root, key: key, holder: h, generation: g) {
        DeadHolderNotRecovered { reason: r } => UnitHoldRefused { reason: r }
        DeadHolderRecovered { dead_holder: _, evidence: _ } =>
          unit_hold_minted(root: root, key: key, outcome: file_hold_acquire(root: root, slot_key: key, requested_owner: owner, retention: KeepAllGenerations))
      }
    _ => unit_hold_minted(root: root, key: key, outcome: outcome)
  }
}

fn unit_hold_proof_key(proof: UnitHoldProof) -> NonEmptyStr {
  proof.key
}

fn mtcollins1_boot_acquire_unit_hold(run_id: NonEmptyStr) -> UnitHoldAcquisition
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_under_live_unit_hold"),
  ]
{
  match self_process_identity() {
    SelfUnidentified { cause: c } =>
      UnitHoldRefused { reason: join(["this boot cannot name its own process (", c as String, "), and a hold it could never be shown dead in would lock the unit out if it died; controller untouched"], "") as NonEmptyStr }
    SelfIdentified { process: p, pid_namespace: n } =>
      unit_hold_acquire(root: unit_hold_store_root, key: mtcollins1_unit_hold_key, owner: boot_run_owner(run_id: run_id, process: p, pid_namespace: n))
  }
}

// THE KVM OBSERVER PROBE TAKES THE SAME SLOT (gunbc.machine_intake_mtcollins1_kvm_observer_observe).
// It writes nothing to the controller, but it takes the BMC's one KVM viewer seat, and the boot takes
// that seat under this hold and REFUSES its handoff when the seat is busy -- so a probe that did not
// hold the unit could make a concurrent boot refuse, and an operator's maintenance would see a viewer
// nobody accounted for. Holding the unit makes the probe, the boot and maintenance exclude each other.
fn mtcollins1_kvm_observer_acquire_unit_hold(run_id: NonEmptyStr) -> UnitHoldAcquisition
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_kvm_observer_observe", decl_name: "mtcollins1_kvm_observer_observe_wet"),
  ]
{
  match self_process_identity() {
    SelfUnidentified { cause: c } =>
      UnitHoldRefused { reason: join(["this probe cannot name its own process (", c as String, "), and a hold it could never be shown dead in would lock the unit out if it died; controller untouched"], "") as NonEmptyStr }
    SelfIdentified { process: p, pid_namespace: n } =>
      unit_hold_acquire(root: unit_hold_store_root, key: mtcollins1_unit_hold_key, owner: unit_hold_owner_ref(o: KvmObserverProbe { run_id: run_id, process: p, pid_namespace: n }))
  }
}

// THE PROBE'S always() RELEASE, SCOPED TO ITS OWN RUN (eager-owl-205, 2026-09-30). A cancel or a step
// timeout after the probe acquired leaves the hold with no proof in hand, so a separate step that runs
// under always() observes the slot and frees it ONLY when the holder decodes to
// KvmObserverProbe { run_id } for THIS run, releasing at the generation it observed (the store's
// compare-and-set). A free slot, another owner -- an operator, a boot, another probe run -- or an
// unreadable slot is a reported no-op, never a release; a slot that moved between the observation and
// the commit is stale, and is left as it is.
//
// A runner that dies, or a job cancelled at its backstop, runs no always() step. Its probe hold names
// the holding process (KvmObserverProbe's ProcessIdentity and pid namespace), so the next acquirer of
// the unit recovers it once that process is OBSERVED dead (unit_hold_acquire's observed-dead recovery,
// gunbc#12555), exactly as it recovers a dead boot run's.
type ProbeHoldReleaseDecision
  = ProbeHoldReleaseAt { owner: DurableHoldOwnerRef, generation: CasGeneration }
  | ProbeHoldFreeNoop
  | ProbeHoldForeignNoop { holder: String }
  | ProbeHoldUnobservable { cause: String }

fn probe_hold_release_decision(observed: DurableHoldObservation, run_id: NonEmptyStr) -> ProbeHoldReleaseDecision {
  match observed {
    HoldSlotAbsent => ProbeHoldFreeNoop
    HoldSlotFree { generation: _, released_by: _ } => ProbeHoldFreeNoop
    HoldSlotUndecodable { generation: _, detail: d } => ProbeHoldUnobservable { cause: concat("slot undecodable: ", d as String) }
    HoldObservationUnavailable { cause: _ } => ProbeHoldUnobservable { cause: "the store could not be read" }
    HoldSlotHeld { generation: g, owner: o } =>
      match decode_unit_hold_owner(owner: o) {
        UnitHoldOwnerDecoded { owner: KvmObserverProbe { run_id: r, process: p, pid_namespace: n } } =>
          if (r as String) == (run_id as String) { ProbeHoldReleaseAt { owner: o, generation: g } }
          else { ProbeHoldForeignNoop { holder: unit_hold_owner_label(o: KvmObserverProbe { run_id: r, process: p, pid_namespace: n }) } }
        UnitHoldOwnerDecoded { owner: other } => ProbeHoldForeignNoop { holder: unit_hold_owner_label(o: other) }
        UnitHoldOwnerUnrecognized { raw: raw } => ProbeHoldForeignNoop { holder: raw }
      }
  }
}

type ProbeHoldReleaseOutcome
  = ProbeHoldReleased
  | ProbeHoldAlreadyFree
  | ProbeHoldNotOurs { holder: String }
  | ProbeHoldStale { detail: String }
  | ProbeHoldUnreleased { cause: String }

// A RELEASE ASSESSED AGAINST THE OBSERVATION AND REFUSED: every refusal but the slot having been freed
// meanwhile means the slot moved since this run looked, so it is stale and left alone.
fn probe_hold_release_refused(refusal: DurableHoldReleaseRefusal) -> ProbeHoldReleaseOutcome {
  match refusal {
    HoldReleaseSlotAbsent => ProbeHoldAlreadyFree
    HoldReleaseAlreadyFree { generation: _, released_by: _ } => ProbeHoldAlreadyFree
    HoldReleaseHeldByAnotherOwner { generation: _, holder: h } => ProbeHoldNotOurs { holder: h as String }
    HoldReleaseAgainstAnotherGeneration { acquired: _, observed: _ } => ProbeHoldStale { detail: "the slot moved to another generation after it was observed" }
    HoldReleaseSlotUndecodable { generation: _, detail: d } => ProbeHoldUnreleased { cause: concat("slot undecodable: ", d as String) }
    HoldReleaseObservationUnavailable { cause: _ } => ProbeHoldUnreleased { cause: "the store could not be read" }
  }
}

fn probe_hold_release_committed(outcome: FileHoldReleaseOutcome) -> ProbeHoldReleaseOutcome {
  match outcome {
    FileHoldReleased { slot_key: _, generation: _ } => ProbeHoldReleased
    FileHoldReleaseLost { slot_key: _ } => ProbeHoldStale { detail: "the slot moved before the release committed" }
    FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } => ProbeHoldUnreleased { cause: "the store refused the release; the unit is STILL held" }
    FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } => ProbeHoldUnreleased { cause: "the key is not slot-addressable" }
  }
}

fn probe_hold_release_outcome_text(o: ProbeHoldReleaseOutcome) -> String {
  match o {
    ProbeHoldReleased => "released this run's probe hold"
    ProbeHoldAlreadyFree => "no hold to release (the slot was free)"
    ProbeHoldNotOurs { holder: h } => concat("left alone: the unit is held by ", h)
    ProbeHoldStale { detail: d } => concat("left alone, stale: ", d)
    ProbeHoldUnreleased { cause: c } => concat("NOT released: ", c)
  }
}

fn mtcollins1_kvm_observer_release_unit_hold(run_id: NonEmptyStr) -> ProbeHoldReleaseOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_kvm_observer_observe", decl_name: "mtcollins1_kvm_observer_release_wet"),
  ]
{
  match probe_hold_release_decision(observed: observe_file_hold(root: unit_hold_store_root, key: mtcollins1_unit_hold_key, retention: KeepAllGenerations), run_id: run_id) {
    ProbeHoldFreeNoop => ProbeHoldAlreadyFree
    ProbeHoldForeignNoop { holder: h } => ProbeHoldNotOurs { holder: h }
    ProbeHoldUnobservable { cause: c } => ProbeHoldUnreleased { cause: c }
    ProbeHoldReleaseAt { owner: o, generation: g } =>
      match file_hold_release_assess(root: unit_hold_store_root, slot_key: mtcollins1_unit_hold_key, owner: o, acquired_generation: g, released_by: concat("mtcollins1-kvm-observer-always-release:", run_id as String) as DurableHoldReleaseRef, retention: KeepAllGenerations) {
        FileHoldReleaseNotEligible { slot_key: _, refusal: r } => probe_hold_release_refused(refusal: r)
        FileHoldReleasePlanned { plan: p } => probe_hold_release_committed(outcome: file_hold_release_commit(plan: p))
      }
  }
}

// THE RELEASE CONSUMES THE PROOF AND KEEPS THE STEP'S OWN OUTCOME, saying when the hold was left: a
// run that actuated and then failed to free the unit has still actuated, and an operator reading a
// bare success would not know the next run will refuse on a stale holder.
type UnitHoldReleaseOutcome
  = UnitHoldReleasedCleanly
  | UnitHoldLeftHeld { cause: NonEmptyStr }

fn unit_hold_release_outcome(proof: UnitHoldProof) -> UnitHoldReleaseOutcome {
  match file_hold_release_assess(root: proof.root, slot_key: proof.key, owner: proof.owner, acquired_generation: proof.generation, released_by: proof.owner as String as DurableHoldReleaseRef, retention: KeepAllGenerations) {
    FileHoldReleaseNotEligible { slot_key: _, refusal: _ } => UnitHoldLeftHeld { cause: "the slot no longer showed this run's hold" as NonEmptyStr }
    FileHoldReleasePlanned { plan: p } =>
      match file_hold_release_commit(plan: p) {
        FileHoldReleased { slot_key: _, generation: _ } => UnitHoldReleasedCleanly
        FileHoldReleaseLost { slot_key: _ } => UnitHoldLeftHeld { cause: "the slot moved before the release committed" as NonEmptyStr }
        FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } => UnitHoldLeftHeld { cause: "the store refused the release" as NonEmptyStr }
        FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } => UnitHoldLeftHeld { cause: "the key is not slot-addressable" as NonEmptyStr }
      }
  }
}

fn unit_hold_release(proof: UnitHoldProof, outcome: ProcessExit) -> ProcessExit {
  match unit_hold_release_outcome(proof: proof) {
    UnitHoldReleasedCleanly => outcome
    UnitHoldLeftHeld { cause: c } =>
      exit_failure(reason: join(["unit hold ", proof.key as String, " left held (", c as String, "); step outcome was: ", match outcome {
        ExitSuccess => "success"
        ExitFailure { code: _, reason: r } => concat("failure: ", r)
      }], ""))
  }
}

// A BMC WRITE PATH ASKS THIS BEFORE ITS FIRST REQUEST: the proof must be for this unit's slot. A
// proof for another unit is still a proof, so the key is compared rather than assumed.
fn unit_hold_proof_refusal(proof: UnitHoldProof, key: NonEmptyStr, label: String) -> String? {
  if (proof.key as String) == (key as String) {
    none
  } else {
    Present { value: join([label, ": unit hold proof is for '", proof.key as String, "', not '", key as String, "'; controller untouched"], "") }
  }
}

// ── The operator's side: two entries run in the operator's own session on the runner host ──────
fn mtcollins1_maintenance_hold_take() -> ProcessExit {
  let reason = actions_variable_trimmed(name: mtcollins1_maintenance_reason_env)
  if reason == "" {
    return exit_failure(reason: concat(mtcollins1_maintenance_reason_env as String, " is unset; a maintenance hold names why the unit is held"))
  }
  match file_hold_acquire(root: unit_hold_store_root, slot_key: mtcollins1_unit_hold_key, requested_owner: operator_maintenance_owner(reason: reason as NonEmptyStr), retention: KeepAllGenerations) {
    FileHoldAcquired { slot_key: _, owner: _, generation: _ } => ExitSuccess
    FileHoldOccupied { slot_key: _, holder: h, generation: _ } =>
      exit_failure(reason: concat("mtcollins1 maintenance hold: unit already held by ", h as String))
    FileHoldAcquireLost { slot_key: _ } => exit_failure(reason: "mtcollins1 maintenance hold: lost the race; re-run")
    FileHoldAcquireStoreUnavailable { slot_key: _, cause: _ } => exit_failure(reason: "mtcollins1 maintenance hold: store unavailable; the unit is NOT held")
    FileHoldSlotUndecodable { slot_key: _, generation: _, detail: d } => exit_failure(reason: concat("mtcollins1 maintenance hold: slot undecodable: ", d as String))
    FileHoldKeyNotSlotAddressable { slot_key: _ } => exit_failure(reason: "mtcollins1 maintenance hold: key not slot-addressable")
  }
}

// THE OPERATOR RELEASES ONLY AN OPERATOR HOLD: a boot's own hold is the boot's to free, and freeing
// it from outside would let a second boot start while the first still drives the BMC.
fn mtcollins1_maintenance_hold_release() -> ProcessExit {
  match observe_file_hold(root: unit_hold_store_root, key: mtcollins1_unit_hold_key, retention: KeepAllGenerations) {
    HoldSlotAbsent => exit_failure(reason: "mtcollins1 maintenance hold: no hold was ever taken")
    HoldSlotFree { generation: _, released_by: b } => exit_failure(reason: concat("mtcollins1 maintenance hold: already free (released by ", concat(b as String, ")")))
    HoldSlotUndecodable { generation: _, detail: d } => exit_failure(reason: concat("mtcollins1 maintenance hold: slot undecodable: ", d as String))
    HoldObservationUnavailable { cause: _ } => exit_failure(reason: "mtcollins1 maintenance hold: store unavailable")
    HoldSlotHeld { generation: g, owner: o } =>
      match decode_unit_hold_owner(owner: o) {
        UnitHoldOwnerUnrecognized { raw: r } =>
          exit_failure(reason: concat("mtcollins1 maintenance hold: held by an owner this module did not write, so it is not released from here: ", r))
        UnitHoldOwnerDecoded { owner: BootRun { run_id: r, process: p, pid_namespace: n } } =>
          exit_failure(reason: concat("mtcollins1 maintenance hold: held by ", concat(unit_hold_owner_label(o: BootRun { run_id: r, process: p, pid_namespace: n }), ", not by maintenance; that run frees its own hold, and the next boot recovers it if that run is observed dead")))
        UnitHoldOwnerDecoded { owner: HostResetReturn { attempt: a } } =>
          exit_failure(reason: concat("mtcollins1 maintenance hold: held by ", concat(unit_hold_owner_label(o: HostResetReturn { attempt: a }), ", not by maintenance; that run frees its own hold")))
        UnitHoldOwnerDecoded { owner: KvmObserverProbe { run_id: r, process: p, pid_namespace: n } } =>
          exit_failure(reason: concat("mtcollins1 maintenance hold: held by ", concat(unit_hold_owner_label(o: KvmObserverProbe { run_id: r, process: p, pid_namespace: n }), ", not by maintenance; that run frees its own hold, and the next acquirer recovers it if that run is observed dead")))
        UnitHoldOwnerDecoded { owner: OperatorMaintenance { reason: _ } } =>
        match file_hold_release_assess(root: unit_hold_store_root, slot_key: mtcollins1_unit_hold_key, owner: o, acquired_generation: g, released_by: "operator-maintenance-release" as DurableHoldReleaseRef, retention: KeepAllGenerations) {
          FileHoldReleaseNotEligible { slot_key: _, refusal: _ } => exit_failure(reason: "mtcollins1 maintenance hold: slot moved before release; re-run")
          FileHoldReleasePlanned { plan: p } =>
            match file_hold_release_commit(plan: p) {
              FileHoldReleased { slot_key: _, generation: _ } => ExitSuccess
              FileHoldReleaseLost { slot_key: _ } => exit_failure(reason: "mtcollins1 maintenance hold: lost the release race; re-run")
              FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } => exit_failure(reason: "mtcollins1 maintenance hold: store refused the release; the unit is STILL held")
              FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } => exit_failure(reason: "mtcollins1 maintenance hold: key not slot-addressable")
            }
        }
      }
  }
}
