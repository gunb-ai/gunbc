module gunbc.machine_intake_mtcollins1_secret_access_ensure

// WHY THIS EXISTS (first mtcollins1_boot dispatch, fleet-converge run 35245186544, 2026-09-17):
// the run's WIF principal fetched approval-submission-mac-key but got 403 on
// bmc-mtcollins1-gunbc/versions/2 -- the BMC credential was minted and pinned (#11477) and its
// accessor binding for the convergence principal was never modeled, so nothing could notice it was
// absent. Same shape and same reason as gunbc.spark.secret_access_ensure: WHICH secret and WHICH
// role this lane wants, converged through gunbc.auth.gcp_secret_access, under the operator's token
// -- the control plane that may call setIamPolicy is deliberately not the workload.
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.secret_provision { mtcollins1_bmc_gunbc_secret_ref }
import gunbc.auth.gcp_secret_access {
  SecretAccessGrant, secret_accessor_grant, secret_access_ensure_for,
}
import gunbc.auth.access_token_source {
  AccessTokenSource, GcloudPrintToken, OperatorSuppliedToken,
  read_supplied_access_token, SuppliedTokenReady, SuppliedTokenUnavailable,
}
import std.resources { Network }
import std.process { ProcessExit, exit_failure }
import std.types { String }

fn mtcollins1_bmc_secret_target() -> SecretRef {
  mtcollins1_bmc_gunbc_secret_ref
}

fn mtcollins1_bmc_secret_access_grant() -> SecretAccessGrant {
  secret_accessor_grant(target: mtcollins1_bmc_secret_target())
}

fn mtcollins1_bmc_secret_access_ensure(token_source: AccessTokenSource) -> ProcessExit
  uses net: Network
{
  secret_access_ensure_for(grant: mtcollins1_bmc_secret_access_grant(), token_source: token_source)
}

fn mtcollins1_bmc_secret_access_converge() -> ProcessExit
  uses net: Network
{
  mtcollins1_bmc_secret_access_ensure(token_source: GcloudPrintToken)
}

fn mtcollins1_bmc_secret_access_converge_with_supplied_token() -> ProcessExit
  uses net: Network
{
  match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause: c } => exit_failure(reason: c as String)
    SuppliedTokenReady { token: t } =>
      mtcollins1_bmc_secret_access_ensure(token_source: OperatorSuppliedToken { token: t })
  }
}
