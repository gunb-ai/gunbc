data mtcollins1_boot_label: String = "mtcollins1 boot"

data mtcollins1_boot_sol_capture_path_env: NonEmptyStr = "GUNBC_MTCOLLINS1_SOL_CAPTURE"

data mtcollins1_boot_sol_pid_path_env: NonEmptyStr = "GUNBC_MTCOLLINS1_SOL_PID_FILE"

data mtcollins1_boot_artifact_glob: String = "artifacts/mtcollins1-boot-*"

data mtcollins1_boot_receipt_path: String = "artifacts/mtcollins1-boot-receipt.txt"

data mtcollins1_boot_poll_cadence: Second = second(count: 15)

data mtcollins1_boot_poll_tick_budget: Int = 90

data mtcollins1_boot_sol_settle: Second = second(count: 2)

data mtcollins1_boot_prelude_allowance: Second = second(count: 120)

data mtcollins1_boot_issue_allowance: Second = second(count: 120)

data mtcollins1_boot_actuation_allowance: Second = second(count: 480)

data mtcollins1_boot_cleanup_allowance: Second = second(count: 180)

data mtcollins1_boot_submit_timeout: Second = second(count: 30)

data mtcollins1_boot_submit_body_file_name: String = "mtcollins1-approval-submit.json"

fn mtcollins1_boot_approval_window() -> Second {
  second(count: mtcollins1_boot_poll_tick_budget * (second_count(s: mtcollins1_boot_poll_cadence) as Int))
}

fn mtcollins1_boot_step_timeout_minutes() -> Minute {
  let secs = second_count(s: mtcollins1_boot_prelude_allowance)
    + second_count(s: mtcollins1_boot_approval_window())
    + second_count(s: mtcollins1_boot_issue_allowance)
    + second_count(s: mtcollins1_boot_actuation_allowance)
    + second_count(s: mtcollins1_boot_cleanup_allowance)
  minute(count: (secs + 59) / 60)
}

fn mtcollins1_boot_refusal(gate: ApprovalGate<MtCollins1BootSubject>) -> ProcessExit {
  match gate {
    GateAdmitted { authorization: _ } => ExitSuccess
    GateRefused { cause: c } =>
      match c {
        ApprovalPending { escalation_id: e } =>
          exit_failure(reason: concat("mtcollins1 boot: still pending operator decision for ", e as String))
        ApprovalDenied { reason: r } =>
          exit_failure(reason: concat("mtcollins1 boot: operator denied; controller untouched: ", r as String))
        ApprovalExpired =>
          exit_failure(reason: "mtcollins1 boot: approval window expired; controller untouched")
        ApprovalNotFiled { escalation_id: e } =>
          exit_failure(reason: concat("mtcollins1 boot: no request filed for ", e as String))
        ApprovalIntentMismatch { requested_revision: a, decided_revision: b } =>
          exit_failure(reason: concat("mtcollins1 boot: stored decision is for another intent (", concat(a as String, concat(" vs ", b as String)), ")"))
        ApprovalStoreUnreadable { detail: d } =>
          exit_failure(reason: concat("mtcollins1 boot: approval store unreadable: ", d as String))
        ApprovalAuthorizeRefused { detail: d } =>
          exit_failure(reason: concat("mtcollins1 boot: grant present but authorize refused: ", d as String))
      }
  }
}

fn mtcollins1_boot_sol_held_from_observations(
  pid_path: String,
  pid_file_ok: Bool,
  pid_file_content: String,
  cmdline_ok: Bool,
  cmdline_content: String,
) -> Bool {
  if pid_path == "" {
    false
  } else if !pid_file_ok {
    false
  } else {
    let pid = trim(s: pid_file_content)
    if pid == "" {
      false
    } else {
      cmdline_ok && string_contains(s: cmdline_content, pattern: "ipmitool")
    }
  }
}

fn mtcollins1_sol_observed_from_collector(
  pid_path_set: Bool,
  pid_file_ok: Bool,
  pid_file_content: String,
  collector_held: Bool,
) -> HeldLeaseObservedState {
  if !pid_path_set {
    LeaseInaccessible
  } else if collector_held {
    LeaseRunningExpected
  } else if pid_file_ok && trim(s: pid_file_content) != "" {
    LeaseRunningStale
  } else {
    LeaseAbsent
  }
}

// ONE pid-file read, then the cmdline read that depends on it, then both the
// held-Bool and the lease state from that same observation. Two independent
// Filesystem.Read of the pid file can disagree on a mutable path and feed
// held_lease_observed_verdict a collector_held that does not match pid_file_ok.
fn mtcollins1_sol_observed_from_pid_path(pid_path: String) -> HeldLeaseObservedState {
  if pid_path == "" {
    mtcollins1_sol_observed_from_collector(
      pid_path_set: false,
      pid_file_ok: false,
      pid_file_content: "",
      collector_held: false,
    )
  } else {
    let pid_read = Filesystem.Read(path: pid_path)
    if !pid_read.success {
      mtcollins1_sol_observed_from_collector(
        pid_path_set: true,
        pid_file_ok: false,
        pid_file_content: pid_read.content,
        collector_held: mtcollins1_boot_sol_held_from_observations(
          pid_path: pid_path,
          pid_file_ok: false,
          pid_file_content: pid_read.content,
          cmdline_ok: false,
          cmdline_content: "",
        ),
      )
    } else {
      let pid = trim(s: pid_read.content)
      if pid == "" {
        mtcollins1_sol_observed_from_collector(
          pid_path_set: true,
          pid_file_ok: true,
          pid_file_content: pid_read.content,
          collector_held: mtcollins1_boot_sol_held_from_observations(
            pid_path: pid_path,
            pid_file_ok: true,
            pid_file_content: pid_read.content,
            cmdline_ok: false,
            cmdline_content: "",
          ),
        )
      } else {
        let cmdline = Filesystem.Read(path: concat("/proc/", concat(pid, "/cmdline")))
        mtcollins1_sol_observed_from_collector(
          pid_path_set: true,
          pid_file_ok: true,
          pid_file_content: pid_read.content,
          collector_held: mtcollins1_boot_sol_held_from_observations(
            pid_path: pid_path,
            pid_file_ok: true,
            pid_file_content: pid_read.content,
            cmdline_ok: cmdline.success,
            cmdline_content: cmdline.content,
          ),
        )
      }
    }
  }
}

fn mtcollins1_boot_sol_is_held(pid_path: String) -> Bool {
  mtcollins1_sol_observed_from_pid_path(pid_path: pid_path) == LeaseRunningExpected
}

fn mtcollins1_sol_release(
  username: NonEmptyStr,
  password_file: NonEmptyStr,
) -> Bool
  uses net: std.resources.Network
{
  dropped = diagnostic.ipmi.Tool.SolDeactivate(
    bmc_host: mtcollins1_endpoint.host,
    username: username,
    password_file: password_file,
  )
  dropped.success
}

fn mtcollins1_sol_acquire_after_grant(
  password_file: NonEmptyStr,
  pid_path: String,
  capture_path: String,
) -> ProcessExit
  uses net: std.resources.Network
{
  match mtcollins1_bmc_username {
    Absent =>
      exit_failure(reason: "mtcollins1 boot: BMC is not BmcSecured; refusing SOL acquire")
    Present { value: username } =>
      if pid_path == "" {
        exit_failure(reason: "mtcollins1 boot: SOL pid path unset; cannot observe a collector we hold")
      } else {
        match held_lease_observed_verdict(
          observed: mtcollins1_sol_observed_from_pid_path(pid_path: pid_path),
        ) {
          Conflict =>
            exit_failure(reason: "mtcollins1 boot: refusing live foreign SOL; not deactivating a session we do not hold")
          Inaccessible =>
            exit_failure(reason: "mtcollins1 boot: SOL collector observation is inaccessible")
          Converged => ExitSuccess
          Drifted => {
            let _cleared = mtcollins1_sol_release(username: username, password_file: password_file)
            mtcollins1_sol_activate_held(username: username, password_file: password_file, pid_path: pid_path, capture_path: capture_path)
          }
          Absent =>
            mtcollins1_sol_activate_held(username: username, password_file: password_file, pid_path: pid_path, capture_path: capture_path)
          UnknownRefused =>
            exit_failure(reason: "mtcollins1 boot: SOL lease observation classification unknown")
        }
      }
  }
}

fn mtcollins1_sol_activate_held(
  username: NonEmptyStr,
  password_file: NonEmptyStr,
  pid_path: String,
  capture_path: String,
) -> ProcessExit
  uses net: std.resources.Network
{
  if pid_path == "" {
    return exit_failure(reason: "mtcollins1 boot: SOL pid path unset; refusing acquire")
  }
  if capture_path == "" {
    return exit_failure(reason: "mtcollins1 boot: SOL capture path unset; refusing acquire")
  }
  spawned = gunbc.machine_intake.sol_hold.ActivateHeld(
    bmc_host: mtcollins1_endpoint.host,
    username: username,
    password_file: password_file,
    capture_path: capture_path as NonEmptyStr,
    pid_path: pid_path as NonEmptyStr,
  )
  if !spawned.success {
    return exit_failure(reason: concat(dissolution_description(condition: mtcollins1_sol_hold_shell_emit_dissolution_trigger), concat(" mtcollins1 boot: SOL activate held refused: ", spawned.stdout)))
  }
  let _paced = sleep_delay_seconds_second_carrier_projection(duration: mtcollins1_boot_sol_settle)
  if mtcollins1_boot_sol_is_held(pid_path: pid_path) {
    ExitSuccess
  } else {
    exit_failure(reason: concat("mtcollins1 boot: SOL collector is not held after acquire; treating the session as foreign and not deactivating: ", capture_path))
  }
}

fn mtcollins1_boot_terminal_tick_budget() -> Int {
  (second_count(s: mtcollins1_boot_actuation_allowance) as Int)
    / (second_count(s: mtcollins1_boot_poll_cadence) as Int)
}

// THE CAPTURE IS READ THROUGH THE ONE GRAMMAR THE CENSUS PROGRAM RENDERS. The eight parsers that
// lived here re-derived the envelope by substring: they accepted a section from any run in the
// capture, and their workload check matched tokens the ARGV line echoes, so a failed workload read
// as stable. gunbc.machine_intake_host_capture_envelope binds ONE begin/end pair for one machine
// and one run, and its readers match whole output lines; a capture that does not bind is not a
// terminal, whatever it contains.
//
// BOOT MEDIA IS THE CENSUS MEDIUM, NOT THE POINT RELEASE. The stock live-server ISO and the derived
// census image share a point release, so matching "24.04.3" could not tell a boot that ran the
// census program from one that ran the installer. The derived medium carries its own volume id
// (gunbc.machine_intake_mtcollins1_census_image mtcollins1_census_volume_id), which blkid prints
// in the boot-media section; the digest-grade binding of the attached image to that medium is
// census stage 0D and lands with the built image, whose name is its digest.
// THE MEDIUM DECIDES BEFORE THE CONTROLLER IS TOUCHED. The census terminal is printed by the census
// program on the census medium and by nothing else, so a boot that attaches the stock installer can
// never observe it: that is decidable from the medium row alone, and a run that discovered it by
// holding the grant, taking the SOL lease, powering the unit and timing out would report a
// hardware-shaped refusal for a modeling-shaped cause (DESIGN §5, the line stops at the deficit).
fn mtcollins1_boot_medium_refusal(medium: MtCollins1BootMedium) -> String? {
  match medium {
    MtCollins1StockInstallerMedium =>
      Present { value: "mtcollins1 boot: the boot medium is the stock installer, which carries no census program, so no census terminal can be observed; switch mtcollins1_boot_medium to the published census image (census stage 0D) -- controller untouched" }
    MtCollins1CensusMedium { output_digest: _ } => none
  }
}

// THE SUBJECT AND THE MEDIUM ARE JOINED BEFORE THE CAPTURE IS READ: the signed subject names the
// image the grant was issued for, the medium names the image this verdict expects to have booted,
// and a terminal is a fact about ONE image. A census terminal against a stock-authorized subject is
// refused here rather than accepted (review 5261662425).
// THE TERMINAL IS A THREE-VALUED VERDICT, NOT A BOOL. A Bool collapsed "no complete observation
// yet" with "a complete observation that does not qualify", so the await loop kept polling a
// capture that had already answered: boot 23 attempt 3 (run 35612872611) printed nproc 80 and
// workload-write-rc=1 and the run reported a TIMEOUT for a disagreement it had observed eight
// minutes earlier (DESIGN §5: no-observation and observation-that-did-not-hold are different
// facts). Now: PENDING while the envelope or the section a qualification needs is still being
// written; REFUSED, with EVERY cause the complete sections establish, as soon as one does -- an
// open envelope may refuse but never accept; ACCEPTED only over a CLOSED envelope in which every
// qualification holds. Causes are collected, not short-circuited, so the topology disagreement
// stays visible beside the workload failure it also caused.
type MtCollins1BootTerminalCause
  = TerminalSubjectMediumDisjoint { subject_image: NonEmptyStr, medium_image: NonEmptyStr }
  | TerminalCaptureUnbound { reason: String }
  | TerminalSectionAbsent { name: String }
  | TerminalSectionFailed { name: String, exit_code: String }
  | HardwareThreadCountMismatch { expected: String, observed: String }
  | BootMediaLabelAbsent { label: NonEmptyStr }
  | EdacCountersNotClean { name: String }
  | WorkloadWriteFailed { rc: String }
  | WorkloadDigestUnstable

type MtCollins1BootTerminalVerdict
  = TerminalPending { reason: String }
  | TerminalRefused { causes: List<MtCollins1BootTerminalCause> }
  | TerminalAccepted { run: HostCaptureRunIdentity, threads: String }

// ONE QUALIFICATION READ AS ONE OF THREE: still being written, refused with a cause, or held.
type TerminalQualification
  = QualificationPending
  | QualificationRefused { cause: MtCollins1BootTerminalCause }
  | QualificationHeld

// A complete section with a nonzero exit refuses on the exit alone; a zero exit is then judged
// by the section's own reader, which answers a cause or none.
fn qualification_judged(name: String, exit_code: String, cause: MtCollins1BootTerminalCause?) -> TerminalQualification {
  if exit_code != "0" {
    QualificationRefused { cause: TerminalSectionFailed { name: name, exit_code: exit_code } }
  } else {
    match cause {
      Absent => QualificationHeld
      Present { value: c } => QualificationRefused { cause: c }
    }
  }
}

fn nproc_qualification(envelope: BoundHostCaptureEnvelope, expected: String) -> TerminalQualification {
  match host_capture_section_reading(envelope: envelope, name: "nproc") {
    SectionAbsent => QualificationPending
    SectionPending { output: _ } => QualificationPending
    SectionComplete { exit_code: code, output: out } => qualification_judged(name: "nproc", exit_code: code, cause: nproc_judge(expected: expected, out: out))
  }
}

fn boot_media_qualification(envelope: BoundHostCaptureEnvelope, label: NonEmptyStr) -> TerminalQualification {
  match host_capture_section_reading(envelope: envelope, name: "boot-media") {
    SectionAbsent => QualificationPending
    SectionPending { output: _ } => QualificationPending
    SectionComplete { exit_code: code, output: out } => qualification_judged(name: "boot-media", exit_code: code, cause: boot_media_judge(label: label, out: out))
  }
}

fn edac_qualification(envelope: BoundHostCaptureEnvelope, name: String) -> TerminalQualification {
  match host_capture_section_reading(envelope: envelope, name: name) {
    SectionAbsent => QualificationPending
    SectionPending { output: _ } => QualificationPending
    SectionComplete { exit_code: code, output: out } => qualification_judged(name: name, exit_code: code, cause: edac_judge(name: name, out: out))
  }
}

// nproc's reading is the WHOLE last output line; anything else beside it is not a count.
fn nproc_judge(expected: String, out: List<String>) -> MtCollins1BootTerminalCause? {
  let observed = fold(out, init: "", f: (acc, l) => if l == "" { acc } else { l })
  if observed == expected { none } else { Present { value: HardwareThreadCountMismatch { expected: expected, observed: observed } } }
}

fn boot_media_judge(label: NonEmptyStr, out: List<String>) -> MtCollins1BootTerminalCause? {
  if any(out, l => string_contains(s: l, pattern: label as String)) { none } else { Present { value: BootMediaLabelAbsent { label: label } } }
}

fn edac_judge(name: String, out: List<String>) -> MtCollins1BootTerminalCause? {
  let body = join(out, "\n")
  let padded = concat("\n", body, "\n")
  if host_capture_mc0_counter(section: padded, counter: "ce_count", value: "0") && host_capture_mc0_counter(section: padded, counter: "ue_count", value: "0") {
    none
  } else {
    Present { value: EdacCountersNotClean { name: name } }
  }
}

fn workload_judge(out: List<String>) -> MtCollins1BootTerminalCause? {
  match host_capture_output_value_after(output: out, token: host_capture_workload_write_rc_token) {
    Absent => Present { value: WorkloadWriteFailed { rc: "unreported" } }
    Present { value: rc } =>
      if rc != "0" {
        Present { value: WorkloadWriteFailed { rc: rc } }
      } else if host_capture_output_has_line(output: out, line: host_capture_workload_stable_token) {
        none
      } else {
        Present { value: WorkloadDigestUnstable }
      }
  }
}

// The workload section exits nonzero on every failure path, and its cause is finer than the exit
// code: read the write rc and the stable token first, and fall back to the exit code only when the
// section carries neither. A PENDING workload section that has already printed a nonzero write rc
// has refused: the writes are over and failed, whatever the hashing after them is still doing --
// boot 23 attempt 3 sat in exactly that state for eight minutes.
fn workload_qualification(envelope: BoundHostCaptureEnvelope) -> TerminalQualification {
  match host_capture_section_reading(envelope: envelope, name: "workload") {
    SectionAbsent => QualificationPending
    SectionPending { output: out } =>
      match host_capture_output_value_after(output: out, token: host_capture_workload_write_rc_token) {
        Absent => QualificationPending
        Present { value: rc } => if rc == "0" { QualificationPending } else { QualificationRefused { cause: WorkloadWriteFailed { rc: rc } } }
      }
    SectionComplete { exit_code: code, output: out } =>
      match workload_judge(out: out) {
        Present { value: c } => QualificationRefused { cause: c }
        Absent => if code == "0" { QualificationHeld } else { QualificationRefused { cause: TerminalSectionFailed { name: "workload", exit_code: code } } }
      }
  }
}

type TerminalFold {
  causes: List<MtCollins1BootTerminalCause>
  pending: Bool
}

fn terminal_fold_step(acc: TerminalFold, q: TerminalQualification) -> TerminalFold {
  match q {
    QualificationHeld => acc
    QualificationPending => TerminalFold { causes: acc.causes, pending: true }
    QualificationRefused { cause: c } => TerminalFold { causes: append(acc.causes, items: [c]), pending: acc.pending }
  }
}

fn mtcollins1_boot_qualifications(envelope: BoundHostCaptureEnvelope, threads: String, label: NonEmptyStr) -> TerminalFold {
  fold(
    [
      nproc_qualification(envelope: envelope, expected: threads),
      boot_media_qualification(envelope: envelope, label: label),
      edac_qualification(envelope: envelope, name: "edac-before"),
      workload_qualification(envelope: envelope),
      edac_qualification(envelope: envelope, name: "edac-after"),
    ],
    init: TerminalFold { causes: [], pending: false },
    f: (acc, q) => terminal_fold_step(acc: acc, q: q),
  )
}

// A closed envelope owes every section: a missing one is a refusal, not a pending. An open
// envelope's missing or unfinished section is pending, because the program may still write it.
fn terminal_over_closed(envelope: BoundHostCaptureEnvelope, threads: String, label: NonEmptyStr) -> MtCollins1BootTerminalVerdict {
  let f = mtcollins1_boot_qualifications(envelope: envelope, threads: threads, label: label)
  let absent = filter(["nproc", "boot-media", "edac-before", "workload", "edac-after"], n =>
    match host_capture_section_reading(envelope: envelope, name: n) { SectionComplete { exit_code: _, output: _ } => false  SectionAbsent => true  SectionPending { output: _ } => true })
  let causes = concat(f.causes, map(absent, n => TerminalSectionAbsent { name: n }))
  if count(causes) == 0 { TerminalAccepted { run: envelope.run, threads: threads } } else { TerminalRefused { causes: causes } }
}

fn terminal_over_open(envelope: BoundHostCaptureEnvelope, threads: String, label: NonEmptyStr) -> MtCollins1BootTerminalVerdict {
  let f = mtcollins1_boot_qualifications(envelope: envelope, threads: threads, label: label)
  if count(f.causes) == 0 { TerminalPending { reason: "envelope open; no complete section refuses" } } else { TerminalRefused { causes: f.causes } }
}

fn mtcollins1_boot_terminal_verdict(capture: String, subject: MtCollins1BootSubject, medium: MtCollins1BootMedium) -> MtCollins1BootTerminalVerdict {
  let threads = hardware_thread_count_value(t: mtcollins1_nproc) as String
  let medium_image = mtcollins1_boot_medium_image_name(medium: medium)
  let joined = (subject.image_name as String) == (medium_image as String)
    && (subject.image_sha256 as String) == (mtcollins1_boot_medium_image_sha256(medium: medium) as String)
  match if joined { mtcollins1_boot_medium_label(medium: medium) } else { none } {
    Absent => TerminalRefused { causes: [TerminalSubjectMediumDisjoint { subject_image: subject.image_name, medium_image: medium_image }] }
    Present { value: label } =>
      match host_capture_bind(capture: capture, machine: subject.machine) {
        HostCaptureUnbound { reason: r } =>
          if starts_with(s: r, prefix: "no begin marker") { TerminalPending { reason: r } } else { TerminalRefused { causes: [TerminalCaptureUnbound { reason: r }] } }
        HostCaptureOpen { envelope: envelope } => terminal_over_open(envelope: envelope, threads: threads, label: label)
        HostCaptureBound { envelope: envelope } => terminal_over_closed(envelope: envelope, threads: threads, label: label)
      }
  }
}

fn mtcollins1_boot_terminal_cause_text(cause: MtCollins1BootTerminalCause) -> String {
  match cause {
    TerminalSubjectMediumDisjoint { subject_image: s, medium_image: m } => concat("signed subject names ", s as String, " but the medium row names ", m as String)
    TerminalCaptureUnbound { reason: r } => concat("capture does not bind: ", r)
    TerminalSectionAbsent { name: n } => concat("closed envelope carries no ", n, " section")
    TerminalSectionFailed { name: n, exit_code: c } => concat(n, " exited ", c)
    HardwareThreadCountMismatch { expected: e, observed: o } => concat("nproc observed ", o, ", qualification expects ", e)
    BootMediaLabelAbsent { label: l } => concat("boot-media does not name the census volume ", l as String)
    EdacCountersNotClean { name: n } => concat(n, ": mc0 ce_count/ue_count not both 0")
    WorkloadWriteFailed { rc: rc } => concat("workload write rc=", rc)
    WorkloadDigestUnstable => "workload digest not stable across passes"
  }
}

fn mtcollins1_boot_terminal_refusal_text(causes: List<MtCollins1BootTerminalCause>) -> String {
  concat("mtcollins1 boot: host qualification REFUSED (", join(map(causes, c => mtcollins1_boot_terminal_cause_text(cause: c)), "; "), "); capture preserved; claim will abort, not complete")
}

fn mtcollins1_boot_await_capture_terminal(
  remaining: Int,
  capture_path: String,
  subject: MtCollins1BootSubject,
) -> ProcessExit {
  if remaining <= 0 {
    exit_failure(reason: "mtcollins1 boot: timed out waiting for the host-capture terminal in SOL; capture preserved; claim will abort, not complete")
  } else {
    let capture = Filesystem.Read(path: capture_path)
    let verdict = if capture.success { mtcollins1_boot_terminal_verdict(capture: capture.content, subject: subject, medium: mtcollins1_boot_medium) } else { TerminalPending { reason: "capture unreadable" } }
    match verdict {
      TerminalAccepted { run: _, threads: _ } => ExitSuccess
      TerminalRefused { causes: causes } => exit_failure(reason: mtcollins1_boot_terminal_refusal_text(causes: causes))
      TerminalPending { reason: _ } => {
        let _paced = sleep_delay_seconds_second_carrier_projection(duration: mtcollins1_boot_poll_cadence)
        mtcollins1_boot_await_capture_terminal(
          remaining: remaining - 1,
          capture_path: capture_path,
          subject: subject,
        )
      }
    }
  }
}

fn mtcollins1_boot_release_sol(password_file: String, pid_path: String) -> HeldLeaseObservedState
  uses net: std.resources.Network
{
  match mtcollins1_bmc_username {
    Absent => LeaseInaccessible
    Present { value: user } => {
      let _attempted = mtcollins1_sol_release(username: user, password_file: password_file as NonEmptyStr)
      mtcollins1_sol_observed_from_pid_path(pid_path: pid_path)
    }
  }
}

fn mtcollins1_boot_settle_from_fresh_clock(
  outcome: ProcessExit,
  escalation_id: NonEmptyStr,
  attempt: AttemptIdentity,
  held_at: CasGeneration,
) -> ProcessExit
  uses fs: std.resources.Filesystem
{
  match approval_instant_now() {
    Absent =>
      unterminated_claim_exit(
        label: mtcollins1_boot_label,
        outcome: exit_failure(reason: "mtcollins1 boot: clock unreadable at the terminal; refusing to stamp completion or abort with the pre-actuation instant"),
        detail: "clock unreadable at claim terminal",
      )
    Present { value: at } =>
      settle_authorization_claim(
        label: mtcollins1_boot_label,
        outcome: outcome,
        escalation_id: escalation_id,
        attempt: attempt,
        held_at: held_at,
        at: at,
      )
  }
}

fn mtcollins1_boot_after_gate(
  gate: ApprovalGate<MtCollins1BootSubject>,
  request: AuthorizationRequest<MtCollins1BootSubject>,
  password_file: String,
  attempt: String,
  sol_pid_path: String,
  sol_capture_path: String,
) -> ProcessExit
  uses net: std.resources.Network
{
  match gate {
    GateAdmitted { authorization: auth } =>
      match approval_instant_now() {
        Absent =>
          exit_failure(reason: "mtcollins1 boot: clock unreadable; cannot decide whether the operator grant has expired before a controller write")
        Present { value: at } =>
          match authorize(authorization: auth, request: request, observed_at: at) {
            AuthorizationRefused { cause: c } =>
              exit_failure(reason: concat("mtcollins1 boot: ", authorization_refusal_reason(cause: c)))
            AuthorizationPermitted { grant: g } =>
              match claim_authorization_slot(escalation_id: g.escalation_id, attempt: g.attempt, at: at) {
                ClaimLost { holder: who } =>
                  exit_failure(reason: concat("mtcollins1 boot: operator grant already claimed: ", who as String))
                ClaimUndecided { reason: why } =>
                  exit_failure(reason: concat("mtcollins1 boot: ", why as String))
                ClaimHeld { state: _, generation: held_at } =>
                  match mtcollins1_sol_acquire_after_grant(password_file: password_file as NonEmptyStr, pid_path: sol_pid_path, capture_path: sol_capture_path) {
                    ExitFailure { code: _, reason: r } =>
                      mtcollins1_boot_settle_from_fresh_clock(
                        outcome: exit_failure(reason: r),
                        escalation_id: g.escalation_id,
                        attempt: g.attempt,
                        held_at: held_at,
                      )
                    ExitSuccess => {
                      let issued = match mtcollins1_census_readback_refusal_before_attach(readback: mtcollins1_census_medium_readback(medium: mtcollins1_boot_medium)) {
                        Present { value: why } => exit_failure(reason: why)
                        Absent =>
                          match mtcollins1_attach_diskless_image(authorization: auth, password_file: password_file, attempt: attempt) {
                            ExitSuccess =>
                              mtcollins1_drive_handoff(
                                label: "mtcollins1 cdrom handoff",
                                password_file_raw: password_file,
                                capability_row: mtcollins1_capability_row,
                                selection: request.subject.selection,
                              )
                            other => other
                          }
                      }
                      let observed = match issued {
                        ExitSuccess =>
                          mtcollins1_boot_await_capture_terminal(
                            remaining: mtcollins1_boot_terminal_tick_budget(),
                            capture_path: sol_capture_path,
                            subject: request.subject,
                          )
                        other => other
                      }
                      let teardown = mtcollins1_boot_release_sol(password_file: password_file, pid_path: sol_pid_path)
                      let terminal = match observed {
                        ExitSuccess =>
                          match teardown {
                            LeaseRunningExpected =>
                              exit_failure(reason: "mtcollins1 boot: SOL collector still held after deactivate")
                            LeaseRunningStale =>
                              exit_failure(reason: "mtcollins1 boot: SOL pid file stale after deactivate")
                            _ => ExitSuccess
                          }
                        other => other
                      }
                      mtcollins1_boot_settle_from_fresh_clock(
                        outcome: terminal,
                        escalation_id: g.escalation_id,
                        attempt: g.attempt,
                        held_at: held_at,
                      )
                    }
                  }
              }
          }
      }
    _ => mtcollins1_boot_refusal(gate: gate)
  }
}

fn mtcollins1_boot_host_must_be_srv1(host: String) -> Bool {
  host == operator_host_srv1 as String
}

fn mtcollins1_boot_refuses_off_srv1(host: String) -> ProcessExit {
  if mtcollins1_boot_host_must_be_srv1(host: host) {
    ExitSuccess
  } else {
    exit_failure(reason: concat("mtcollins1 boot refuses host '", concat(host, concat("': POST/GET /approvals is loopback on the machine that serves the dashboard, which is ", operator_host_srv1 as String))))
  }
}

fn mtcollins1_boot_wet() -> ProcessExit
  uses net: std.resources.Network
{
  match actions_variable_read(name: fleet_converge_expected_host_env_name) {
    ActionsVariableAbsent { variable: v, detail: d } =>
      exit_failure(reason: concat("mtcollins1 boot: ", concat(v, concat(" ", concat(d, "; loopback filing is srv1 only")))))
    ActionsVariablePresent { value: host } =>
      match mtcollins1_boot_refuses_off_srv1(host: host) {
        ExitSuccess => mtcollins1_boot_wet_on_srv1()
        other => other
      }
  }
}

fn mtcollins1_boot_wet_on_srv1() -> ProcessExit
  uses net: std.resources.Network
{
  let cred = actions_variable_trimmed(name: host_reset_bmc_credential_path_env)
  if cred == "" {
    return exit_failure(reason: concat("mtcollins1 boot: ", concat(host_reset_bmc_credential_path_env as String, " is unset; controller untouched")))
  }
  let sub_path = actions_variable_trimmed(name: approval_submission_mac_key_path_env)
  if sub_path == "" {
    return exit_failure(reason: concat("mtcollins1 boot: ", concat(approval_submission_mac_key_path_env as String, " is unset; controller untouched")))
  }
  let sol_pid_path = actions_variable_trimmed(name: mtcollins1_boot_sol_pid_path_env)
  let sol_capture_path = actions_variable_trimmed(name: mtcollins1_boot_sol_capture_path_env)
  let run_id = match actions_variable_read(name: github_run_id_variable_name) {
    ActionsVariablePresent { value: v } => v
    ActionsVariableAbsent { variable: _, detail: _ } => ""
  }
  if run_id == "" {
    return exit_failure(reason: "mtcollins1 boot: GITHUB_RUN_ID is unset; refusing rather than reusing a standing escalation id")
  }
  let sha = match actions_variable_read(name: github_sha_variable_name) {
    ActionsVariablePresent { value: v } => v
    ActionsVariableAbsent { variable: _, detail: _ } => ""
  }
  if sha == "" {
    return exit_failure(reason: "mtcollins1 boot: GITHUB_SHA is unset; the signed subject binds the execution revision")
  }
  match mtcollins1_boot_medium_refusal(medium: mtcollins1_boot_medium) {
    Present { value: why } => return exit_failure(reason: why)
    Absent => {}
  }
  match mtcollins1_census_readback_refusal_before_filing(readback: mtcollins1_census_medium_readback(medium: mtcollins1_boot_medium)) {
    Present { value: why } => return exit_failure(reason: why)
    Absent => {}
  }
  let escalation = concat("mtcollins1-boot-", run_id) as NonEmptyStr
  let request = mtcollins1_boot_authorization_request(
    escalation_id: escalation,
    attempt: concat("mtcollins1-boot-", run_id) as AttemptIdentity,
    execution_revision: sha as NonEmptyStr,
  )
  match approval_instant_now() {
    Absent =>
      exit_failure(reason: "mtcollins1 boot: clock unreadable; cannot mint issued_at or an approval window; controller untouched")
    Present { value: issued } => {
      let expires = approval_expires_at(issued: issued, window: mtcollins1_boot_approval_window())
      match approval_file_stored_request(stored: stored_request_from_authorization(request: request, issued_at: issued, expires_at: expires), body_file_name: mtcollins1_boot_submit_body_file_name, submit_timeout: mtcollins1_boot_submit_timeout) {
        ApprovalFilingRefused { reason: r } =>
          exit_failure(reason: concat("mtcollins1 boot: ", concat(r, "; controller untouched")))
        ApprovalFiled => {
          let gate = approval_gate_from_outcome(
            outcome: approval_poll_ticks(
              remaining: mtcollins1_boot_poll_tick_budget,
              cadence: mtcollins1_boot_poll_cadence,
              escalation_id: escalation,
              expires_at: expires,
            ),
            request: request,
          )
          let pw_read = Filesystem.Read(path: cred)
          if !pw_read.success {
            return exit_failure(reason: concat("mtcollins1 boot: BMC credential unreadable after approval: ", pw_read.error))
          }
          let actuated = mtcollins1_boot_after_gate(
            gate: gate,
            request: request,
            password_file: cred,
            attempt: run_id,
            sol_pid_path: sol_pid_path,
            sol_capture_path: sol_capture_path,
          )
          let exit_word = match actuated { ExitSuccess => "ok"  _ => "refused" }
          let receipt_body = concat("escalation_id=", concat(escalation as String, concat("\nexit=", exit_word)))
          let kept = Filesystem.Write(path: mtcollins1_boot_receipt_path, content: receipt_body)
          if !kept.success {
            return exit_failure(reason: concat("mtcollins1 boot: could not write receipt: ", kept.error))
          }
          actuated
        }
      }
    }
  }
}
