module gunbc.machine_intake_mtcollins1_sol_notice
import std.types { Bool, Int, NonEmptyStr, String }
import std.algebra { trim }
import std.measure { second, second_count }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }
import extdeps.github.log_annotations { LogAnnotation, AnnotationError, AnnotationWarning, log_annotation_message_line }
import gunbc.clock_read { clock_now_probed_at_or_unknown }
import gunbc.actions_run_binding { actions_variable_trimmed }
import gunbc.machine_intake_sol_hold { sol_hold_exit_record_prefix, sol_hold_exit_record_instant_marker }
import gunbc.machine_intake_mtcollins1_boot_run {
  mtcollins1_boot_sol_capture_path_env, mtcollins1_sol_incident_path, mtcollins1_sol_client_diagnostic_path,
  mtcollins1_sol_workflow_events_path, mtcollins1_sol_workflow_event_prefix, mtcollins1_sol_delivery_suffix,
  mtcollins1_boot_sol_pid_path_env, mtcollins1_sol_notice_file_infix, mtcollins1_sol_notice_final_allowance,
  mtcollins1_sol_notice_ready_suffix, mtcollins1_sol_notice_token_env,
}

// THE SOL NOTICES, AS THEIR OWN PROCESS (operator ruling 2026-09-27: the admitted route is this run's
// log and step summary -- not ntfy, no new credential). The boot's .dag watch cannot report while it
// is blocked in an SMpro pass, the attach, the handoff or a BMC read, so the step starts THIS fold as a
// second `gunbc run`, beside the boot, before the collector is launched. It polls once a second and
// publishes two facts other authorities establish:
//   (1) THE COLLECTOR'S EXIT, as the hold's supervisor recorded it (gunbc.machine_intake_sol_hold
//       sol_hold_exit_record_prefix: status and instant), with the last act this run had RECORDED
//       requesting (gunbc.machine_intake_mtcollins1_boot_run mtcollins1_sol_workflow_event_prefix) at
//       requested strength -- a preceding request is not proven to be the cause;
//   (2) THE CLASSIFIED INCIDENT the boot's watch freezes (mtcollins1_sol_loss_freeze, renamed into
//       place whole, so it is never read half-written).
// The observation is the other modules'; this fold only presents and delivers it: the annotation is
// encoded by extdeps.github.log_annotations log_annotation_message_line, and each notice is delivered
// on two channels, the live log (an annotation line on this process's stdout) and the step summary.
//
// DELIVERY IS A PER-(NOTICE, CHANNEL) FACT, RECORDED ONLY AFTER THE WRITE SUCCEEDED. The marker is
// written after the channel write returned success, so a failed write leaves no marker and is retried
// on the next pass, and an interruption between the write and the marker produces a duplicate on the
// next pass, never a drop. Every outcome -- delivered or FAILED, with its error -- is appended to the
// delivery ledger (capture + mtcollins1_sol_delivery_suffix), which is uploaded with the capture.
// This process is the only writer of the step summary, the markers and the ledger during the step.
//
// SOURCES ARE OBSERVED, NOT DEFAULTED. Each source file is read as one of three things: its bytes,
// established absent (not_found -- the event has not happened yet), or UNREADABLE with its path and
// cause. An unreadable source is itself published as an error notice and keeps the final result from
// being success: failure to read the incident is not "no incident", and failure to read the request
// history is not "no request was made".
//
// EVERY EXIT RECORD IS A NOTICE. The hold's supervisor appends one complete line per collector exit to
// the client file, which the step empties before the run; the n-th complete record has identity
// collector-exited-<n>, so two exits in the same second, or with no orderable instant, stay distinct,
// and an earlier exit whose delivery failed stays demanded after a later one appears.
//
// COMPLETION IS JUDGED ON THE PASS THAT DELIVERED. A pass returns the notices it observed, what it
// delivered and which sources it could not read; the final result is computed from that one snapshot.
// A collector exit is OWED while the hold's pid file records a collector: after the stop request the
// fold keeps draining until an exit record has been observed and delivered in the same pass, or the
// final allowance ends -- and an owed exit never observed is a failed result, not a quiet success.
//
// STOPPING IS A REQUEST, NOT A KILL. The step's EXIT trap releases the collector and then creates the
// stop file; this fold then drains as above and returns its result as its exit status, which the trap
// collects. A kill between a write and its marker is the one interruption left, and it yields a
// duplicate.

type SolNoticeKind
  = SolNoticeCollectorExited
  | SolNoticeObservationLost
  | SolNoticeSourceUnreadable

type SolNotice {
  kind: SolNoticeKind
  identity: String
  title: String
  body: String
}

type SolNoticeChannel
  = SolNoticeLiveLog
  | SolNoticeStepSummary

type SolNoticeDelivery
  = SolNoticeDelivered { kind: SolNoticeKind, identity: String, channel: SolNoticeChannel }
  | SolNoticeDeliveryFailed { kind: SolNoticeKind, identity: String, channel: SolNoticeChannel, error: String }
  | SolNoticeAlreadyDelivered { kind: SolNoticeKind, identity: String, channel: SolNoticeChannel }

type SolNoticePaths {
  capture: String
  pid_path: String
  summary: String
  live_log: String
}

// One source file as observed: its bytes, established absent, or unreadable with path and cause.
type SolNoticeSource
  = SolSourceRead { content: String }
  | SolSourceAbsent
  | SolSourceUnreadable { path: String, cause: String }

fn sol_notice_source(path: String) -> SolNoticeSource {
  let r = Filesystem.Read(path: path)
  if r.success {
    SolSourceRead { content: r.content }
  } else if r.error_kind == "not_found" {
    SolSourceAbsent
  } else {
    SolSourceUnreadable { path: path, cause: concat(if r.error_kind == "" { "unclassified" } else { r.error_kind }, concat(": ", r.error)) }
  }
}

fn sol_source_text(source: SolNoticeSource) -> String {
  match source {
    SolSourceRead { content: c } => c
    SolSourceAbsent => ""
    SolSourceUnreadable { path: _, cause: _ } => ""
  }
}

// What one pass observed, delivered and could not read -- the single snapshot its result is judged on.
type SolNoticePassResult {
  notices: List<SolNotice>
  deliveries: List<SolNoticeDelivery>
  unreadable: List<String>
  exit_owed: Bool
}

fn sol_notice_channel_key(channel: SolNoticeChannel) -> String {
  match channel {
    SolNoticeLiveLog => "annotation"
    SolNoticeStepSummary => "summary"
  }
}

data mtcollins1_sol_notice_stop_suffix: String = concat(mtcollins1_sol_notice_file_infix, "stop")


fn sol_notice_marker_path(paths: SolNoticePaths, identity: String, channel: SolNoticeChannel) -> String {
  concat(paths.capture, concat(mtcollins1_sol_notice_file_infix, concat(identity, concat(".", sol_notice_channel_key(channel: channel)))))
}

fn sol_notice_stop_path(capture: String) -> String {
  concat(capture, mtcollins1_sol_notice_stop_suffix)
}

fn sol_notice_ledger_path(paths: SolNoticePaths) -> String {
  concat(paths.capture, mtcollins1_sol_delivery_suffix)
}

// A LINE IS READ ONLY ONCE IT IS COMPLETE. The supervisor appends its exit record with one echo; a
// line not yet followed by its newline is not a record yet, so the last split element is never read.
fn complete_lines(text: String) -> List<String> {
  let parts = split(s: text, delimiter: "\n")
  take(parts, n: parts.length() - 1)
}

// THE INSTANT A LINE CARRIES, read from its " at=" field (the ISO-8601 UTC second both writers use).
// Two such instants order lexically; one that is absent or "unknown" does not order at all.
fn line_instant(line: String) -> String {
  let parts = split(s: line, delimiter: sol_hold_exit_record_instant_marker)
  match parts.last() {
    Present { value: v } => if parts.length() > 1 { trim(s: v) } else { "" }
    Absent => ""
  }
}

fn instant_comparable(t: String) -> Bool {
  t.length() == 20 && substring(t, 19, 20) == "Z" && substring(t, 10, 11) == "T"
}

// THE EXIT IS ORDERED AGAINST THIS RUN'S RECORDED REQUESTS BY THEIR INSTANTS, never by which one was
// read last. Only a request strictly before the exit is reported as preceding it (and still only at
// requested strength); the same second, or an instant that does not order, is unresolved; a request
// after the exit is reported as later, so it cannot be read as the cause.
fn sol_exit_request_context(exit_at: String, requests: List<String>) -> String {
  if requests.length() == 0 {
    return "no teardown or release had been requested by this run; the boot watch classifies it against the capture at its next observation"
  }
  if !instant_comparable(t: exit_at) {
    return concat("its instant does not order against this run's requests, so their order is unresolved; last recorded request: ", match requests.last() { Present { value: r } => r  Absent => "" })
  }
  let before = filter(requests, r => instant_comparable(t: line_instant(line: r)) && line_instant(line: r) < exit_at)
  let same = filter(requests, r => line_instant(line: r) == exit_at)
  let unordered = filter(requests, r => !instant_comparable(t: line_instant(line: r)))
  let later = filter(requests, r => instant_comparable(t: line_instant(line: r)) && line_instant(line: r) > exit_at)
  join(flat_map([
    match before.last() { Present { value: r } => [concat("after this run's request ", concat(r, " (requested, not proven to be the cause)"))]  Absent => ["no request of this run preceded it"] },
    match same.last() { Present { value: r } => [concat("in the same second as ", concat(r, ", so their order is unresolved"))]  Absent => [] },
    match unordered.last() { Present { value: r } => [concat("a request with no orderable instant, order unresolved: ", r)]  Absent => [] },
    match later.first() { Present { value: r } => [concat("before this run's later request ", concat(r, ", which therefore did not cause it"))]  Absent => [] },
  ], l => l), "; ")
}

fn sol_exit_context_of(exit_at: String, workflow_events: SolNoticeSource) -> String {
  match workflow_events {
    SolSourceUnreadable { path: p, cause: c } => concat("this run's request history could not be read (", concat(p, concat(": ", concat(c, "), so whether a request preceded it is unresolved"))))
    other => sol_exit_request_context(exit_at: exit_at, requests: filter(complete_lines(text: sol_source_text(source: other)), l => starts_with(s: l, prefix: mtcollins1_sol_workflow_event_prefix)))
  }
}

fn sol_exit_notice(ordinal: Int, record: String, workflow_events: SolNoticeSource) -> SolNotice {
  let exit_at = line_instant(line: record)
  SolNotice {
    kind: SolNoticeCollectorExited,
    identity: concat("collector-exited-", to_string(ordinal)),
    title: "mtcollins1 SOL collector exited",
    body: concat("mtcollins1 SOL collector exited -- ", concat(record, concat(" -- ", sol_exit_context_of(exit_at: exit_at, workflow_events: workflow_events)))),
  }
}

// Every complete exit record, in order, each with its ordinal identity.
fn sol_exit_notices_of(client_diagnostics: String, workflow_events: SolNoticeSource) -> List<SolNotice> {
  let records = filter(complete_lines(text: client_diagnostics), l => starts_with(s: l, prefix: sol_hold_exit_record_prefix))
  map(enumerate(records), p => sol_exit_notice(ordinal: p.first + 1, record: p.second, workflow_events: workflow_events))
}

fn sol_loss_notice_of(incident: String) -> SolNotice? {
  let body = trim(incident)
  if body == "" {
    return Absent
  }
  Present { value: SolNotice { kind: SolNoticeObservationLost, identity: "observation-lost", title: "mtcollins1 SOL observation lost", body: body } }
}

fn sol_unreadable_notice(role: String, path: String, cause: String) -> SolNotice {
  SolNotice {
    kind: SolNoticeSourceUnreadable,
    identity: concat("source-unreadable-", role),
    title: "mtcollins1 SOL notice source unreadable",
    body: concat("the ", concat(role, concat(" source ", concat(path, concat(" could not be read (", concat(cause, "); what it would have reported is unknown, and this watcher will not report success")))))),
  }
}

fn sol_notice_annotation(notice: SolNotice) -> LogAnnotation {
  let message = concat(notice.title, concat(": ", notice.body))
  match notice.kind {
    SolNoticeCollectorExited => AnnotationWarning { message: message, file: Absent, line: Absent, col: Absent }
    _ => AnnotationError { message: message, file: Absent, line: Absent, col: Absent }
  }
}

fn sol_notice_summary_block(notice: SolNotice) -> String {
  concat("### ", concat(notice.title, concat("\n\n", concat(notice.body, "\n\n"))))
}

fn sol_notice_ledger_line(delivery: SolNoticeDelivery) -> String {
  let at = clock_now_probed_at_or_unknown() as String
  match delivery {
    SolNoticeDelivered { kind: _, identity: i, channel: c } => join([i, " ", sol_notice_channel_key(channel: c), " delivered at=", at, "\n"], "")
    SolNoticeDeliveryFailed { kind: _, identity: i, channel: c, error: e } => join([i, " ", sol_notice_channel_key(channel: c), " FAILED at=", at, ": ", replace(e, "\n", " "), "\n"], "")
    SolNoticeAlreadyDelivered { kind: _, identity: _, channel: _ } => ""
  }
}

// The ledger is best-effort evidence of this fold's own writes: a ledger that cannot be read or
// appended is not a delivery failure and never blocks the channel writes it describes (an absent
// ledger starts empty; an unreadable one is not overwritten).
fn sol_notice_record(paths: SolNoticePaths, delivery: SolNoticeDelivery) -> SolNoticeDelivery {
  let line = sol_notice_ledger_line(delivery: delivery)
  if line != "" {
    let ledger = sol_notice_ledger_path(paths: paths)
    match sol_notice_source(path: ledger) {
      SolSourceUnreadable { path: _, cause: _ } => {}
      prior => {
        let _kept = Filesystem.Write(path: ledger, content: concat(sol_source_text(source: prior), line)).success
      }
    }
  }
  delivery
}

// The step summary is read-modified-written; a read that failed for any reason but absence refuses,
// so an unreadable summary is never overwritten with this block alone.
fn sol_notice_channel_write(paths: SolNoticePaths, notice: SolNotice, channel: SolNoticeChannel) -> SolNoticeDelivery {
  match channel {
    SolNoticeLiveLog => match log_annotation_message_line(annotation: sol_notice_annotation(notice: notice)) {
      Absent => SolNoticeDeliveryFailed { kind: notice.kind, identity: notice.identity, channel: channel, error: "annotation arm has no message encoding" }
      Present { value: line } => {
        let w = Filesystem.Write(path: paths.live_log, content: concat(line, "\n"))
        if w.success { SolNoticeDelivered { kind: notice.kind, identity: notice.identity, channel: channel } } else { SolNoticeDeliveryFailed { kind: notice.kind, identity: notice.identity, channel: channel, error: w.error } }
      }
    }
    SolNoticeStepSummary => {
      if paths.summary == "" {
        return SolNoticeDeliveryFailed { kind: notice.kind, identity: notice.identity, channel: channel, error: "GITHUB_STEP_SUMMARY is unset" }
      }
      match sol_notice_source(path: paths.summary) {
        SolSourceUnreadable { path: _, cause: c } => SolNoticeDeliveryFailed { kind: notice.kind, identity: notice.identity, channel: channel, error: concat("the step summary could not be read: ", c) }
        prior => {
          let w = Filesystem.Write(path: paths.summary, content: concat(sol_source_text(source: prior), sol_notice_summary_block(notice: notice)))
          if w.success { SolNoticeDelivered { kind: notice.kind, identity: notice.identity, channel: channel } } else { SolNoticeDeliveryFailed { kind: notice.kind, identity: notice.identity, channel: channel, error: w.error } }
        }
      }
    }
  }
}

fn sol_notice_deliver(paths: SolNoticePaths, notice: SolNotice, channel: SolNoticeChannel) -> SolNoticeDelivery {
  let marker = sol_notice_marker_path(paths: paths, identity: notice.identity, channel: channel)
  if Filesystem.Read(path: marker).success {
    return SolNoticeAlreadyDelivered { kind: notice.kind, identity: notice.identity, channel: channel }
  }
  let written = sol_notice_channel_write(paths: paths, notice: notice, channel: channel)
  match written {
    SolNoticeDelivered { kind: _, identity: _, channel: _ } => {
      if !Filesystem.Write(path: marker, content: "").success {
        return sol_notice_record(paths: paths, delivery: SolNoticeDeliveryFailed { kind: notice.kind, identity: notice.identity, channel: channel, error: concat("delivered, but its marker could not be written (a duplicate may follow): ", marker) })
      }
      sol_notice_record(paths: paths, delivery: written)
    }
    _ => sol_notice_record(paths: paths, delivery: written)
  }
}

// THE NOTICES ONE PASS OBSERVES, read once. An unreadable client or incident source contributes an
// unreadable-source notice instead of silence; an unreadable request history is carried into each exit
// notice's context. An exit is owed while the hold's pid file records a collector.
fn sol_notice_observe(paths: SolNoticePaths) -> SolNoticePassResult {
  let client_path = mtcollins1_sol_client_diagnostic_path(capture_path: paths.capture)
  let incident_path = mtcollins1_sol_incident_path(capture_path: paths.capture)
  let events_path = mtcollins1_sol_workflow_events_path(capture_path: paths.capture)
  let client = sol_notice_source(path: client_path)
  let incident = sol_notice_source(path: incident_path)
  let events = sol_notice_source(path: events_path)
  let pid = if paths.pid_path == "" { SolSourceAbsent } else { sol_notice_source(path: paths.pid_path) }
  let exits = match client {
    SolSourceUnreadable { path: p, cause: c } => [sol_unreadable_notice(role: "client-diagnostics", path: p, cause: c)]
    other => sol_exit_notices_of(client_diagnostics: sol_source_text(source: other), workflow_events: events)
  }
  let lost = match incident {
    SolSourceUnreadable { path: p, cause: c } => [sol_unreadable_notice(role: "incident", path: p, cause: c)]
    other => match sol_loss_notice_of(incident: sol_source_text(source: other)) { Present { value: n } => [n]  Absent => [] }
  }
  let history = match events {
    SolSourceUnreadable { path: p, cause: c } => [sol_unreadable_notice(role: "request-history", path: p, cause: c)]
    _ => []
  }
  let pid_notice = match pid {
    SolSourceUnreadable { path: p, cause: c } => [sol_unreadable_notice(role: "collector-pid", path: p, cause: c)]
    _ => []
  }
  let unreadable = flat_map([client, incident, events, pid], src => match src { SolSourceUnreadable { path: p, cause: _ } => [p]  _ => [] })
  SolNoticePassResult {
    notices: exits.concat(lost).concat(history).concat(pid_notice),
    deliveries: [],
    unreadable: unreadable,
    exit_owed: match pid { SolSourceRead { content: c } => trim(s: c) != ""  _ => false },
  }
}

fn sol_notice_delivery_settled(d: SolNoticeDelivery) -> Bool {
  match d {
    SolNoticeDeliveryFailed { kind: _, identity: _, channel: _, error: _ } => false
    SolNoticeDelivered { kind: _, identity: _, channel: _ } => true
    SolNoticeAlreadyDelivered { kind: _, identity: _, channel: _ } => true
  }
}

// One pass: observe once, then every observed notice on both channels. The live log goes first, so the
// prompt channel is never waiting on the summary's read-modify-write.
fn sol_notice_pass(paths: SolNoticePaths) -> SolNoticePassResult {
  let observed = sol_notice_observe(paths: paths)
  SolNoticePassResult {
    notices: observed.notices,
    deliveries: flat_map(observed.notices, n => [
      sol_notice_deliver(paths: paths, notice: n, channel: SolNoticeLiveLog),
      sol_notice_deliver(paths: paths, notice: n, channel: SolNoticeStepSummary),
    ]),
    unreadable: observed.unreadable,
    exit_owed: observed.exit_owed,
  }
}

// Every notice this pass observed was delivered on both channels, and every source was readable.
fn sol_notice_pass_complete(pass: SolNoticePassResult) -> Bool {
  pass.deliveries.all(d => sol_notice_delivery_settled(d: d)) && pass.unreadable.length() == 0
}

fn sol_notice_pass_saw_exit(pass: SolNoticePassResult) -> Bool {
  pass.notices.any(n => match n.kind { SolNoticeCollectorExited => true  _ => false })
}

// THE FINAL DRAIN, judged on each pass's own snapshot: done when a pass is complete and, if an exit is
// owed, that same pass observed and delivered it. At the end of the allowance the last pass decides,
// and an owed exit it did not observe is a failure.
fn sol_notice_finish(paths: SolNoticePaths, remaining: Int) -> Bool {
  let pass = sol_notice_pass(paths: paths)
  let done = sol_notice_pass_complete(pass: pass) && (!pass.exit_owed || sol_notice_pass_saw_exit(pass: pass))
  if done || remaining <= 0 {
    return done
  }
  let _paced = sleep_delay_seconds_second_carrier_projection(duration: second(count: 1))
  sol_notice_finish(paths: paths, remaining: remaining - 1)
}

fn mtcollins1_sol_notice_watch(paths: SolNoticePaths, remaining: Int) -> Bool {
  if Filesystem.Read(path: sol_notice_stop_path(capture: paths.capture)).success || remaining <= 0 {
    return sol_notice_finish(paths: paths, remaining: mtcollins1_sol_notice_final_passes)
  }
  let _pass = sol_notice_pass(paths: paths)
  let _paced = sleep_delay_seconds_second_carrier_projection(duration: second(count: 1))
  mtcollins1_sol_notice_watch(paths: paths, remaining: remaining - 1)
}

// Twelve hours of one-second passes bounds the loop well past the job's own timeout; the stop request
// is the ordinary end.
data mtcollins1_sol_notice_watch_passes: Int = 43200

// The drain's passes fit inside the trap's wait (mtcollins1_sol_notice_final_allowance), with the
// margin for the last pass's writes.
data mtcollins1_sol_notice_final_passes: Int = (second_count(s: mtcollins1_sol_notice_final_allowance) as Int) / 2

data github_step_summary_variable_name: NonEmptyStr = "GITHUB_STEP_SUMMARY"

data mtcollins1_sol_notice_live_log: String = "/dev/stdout"

fn mtcollins1_sol_notice_wet() -> ProcessExit
{
  let capture = actions_variable_trimmed(name: mtcollins1_boot_sol_capture_path_env)
  if capture == "" {
    return exit_failure(reason: concat("mtcollins1 SOL notice: ", concat(mtcollins1_boot_sol_capture_path_env as String, " is unset; nothing to watch")))
  }
  let token = actions_variable_trimmed(name: mtcollins1_sol_notice_token_env)
  if token == "" {
    return exit_failure(reason: concat("mtcollins1 SOL notice: ", concat(mtcollins1_sol_notice_token_env as String, " is unset; readiness cannot be bound to this step")))
  }
  let paths = SolNoticePaths {
    capture: capture,
    pid_path: actions_variable_trimmed(name: mtcollins1_boot_sol_pid_path_env),
    summary: actions_variable_trimmed(name: github_step_summary_variable_name),
    live_log: mtcollins1_sol_notice_live_log,
  }
  let ready = Filesystem.Write(path: concat(capture, mtcollins1_sol_notice_ready_suffix), content: concat(token, "\n"))
  if !ready.success {
    return exit_failure(reason: concat("mtcollins1 SOL notice: could not publish readiness: ", ready.error))
  }
  if mtcollins1_sol_notice_watch(paths: paths, remaining: mtcollins1_sol_notice_watch_passes) {
    ExitSuccess
  } else {
    exit_failure(reason: concat("mtcollins1 SOL notice: not every observed notice was delivered on both channels, a source was unreadable, or an owed collector exit was never observed; see ", sol_notice_ledger_path(paths: paths)))
  }
}
