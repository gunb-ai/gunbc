module gunbc.machine_intake.mtcollins1_pxe_mac_discovery

import std.types { String, NonEmptyStr }
import std.decl_ref { decl_ref }
import std.optional { Present, Absent }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.bmc.ipmi_boot_selection { IpmiBootSelection, ipmi_boot_expected_device_rendering, ipmi_boot_expected_mode_rendering, ipmi_boot_expected_persistence_rendering }
import extdeps.bmc.ipmi_chassis_control { chassis_observation_text }
import gunbc.actions_run_binding { ActionsVariablePresent, ActionsVariableAbsent, actions_variable_read, actions_variable_trimmed }
import extdeps.github.actions_environment { github_run_id_variable_name, github_sha_variable_name }
import gunbc.fleet.fleet_host_identity { operator_host_mtcollins1 }
import gunbc.host.host_reset_return_run { host_reset_bmc_credential_path_env }
import gunbc.host.managed_host { managed_membership_for, membership_host, ManagedHost }
import gunbc.host.bmc_control_binding { bmc_control_binding, BmcControlBound, BmcControlAccessUnobserved, BmcControlNotSecured, BmcControlEndpointMismatch, bmc_control_route_account, bmc_control_route_observation }
import gunbc.host.pxe_boot_selection { decide_pxe_boot_selection, PxeBootSelectionAdmitted, PxeBootSelectionRefused }
import gunbc.host.megarac_managed_host { megarac_operation_evidence }
import gunbc.host.managed_host_unit_hold { UnitHeld, UnitHoldRefused, boot_run_acquire_unit_hold, unit_hold_release, unit_hold_proof_refusal }
import gunbc.host.host_boot_attempt_admission { BootAttemptCleared, BootAttemptRefused, attempt_receipt_refusal_text, admit_boot_attempt }
import gunbc.host_state_root { host_state_tree }
import gunbc.host.managed_host_boot_handoff { boot_handoff_render_outcome }
import gunbc.machine_intake.oob_boot_handoff { oob_boot_handoff, OobBootHandoffOutcome, BootControlIssued, BootSelectionRefused, BootSelectionNotApplied, BootSelectionUnverifiable, BootSelectionFlagInvalid, BootSelectionNotOneShot, BootSelectionFirmwareMismatch, PowerStateReadFailed, PowerCommandRefused, PowerCommandAcceptedNoTransition, BootHandoffNotAdmitted, PoweredOn, PowerCycled, oob_power_action_verb, power_transition_progress_text }

data mtcollins1_pxe_mac_discovery_label: NonEmptyStr = "mtcollins1 pxe mac-discovery cycle (next-boot PXE override, power cycle, no media, no boot verdict)" as NonEmptyStr

fn mtcollins1_pxe_mac_discovery_host() -> ManagedHost? {
  match managed_membership_for(host: operator_host_mtcollins1 as NonEmptyStr) {
    Absent => none
    Present { value: m } => Present { value: membership_host(membership: m) }
  }
}

// WHERE THE STEP WRITES ITS TYPED RECEIPT, and the step's shell cats it (gunbc.machine_intake.mtcollins1_boot_step gunbc_ci_mtcollins1_pxe_mac_discovery_invoke),
// so the run log carries each typed verdict and not only the effect trace of the calls that produced it.
data mtcollins1_pxe_mac_discovery_receipt_path: String = "target/mtcollins1-pxe-mac-discovery-receipt.txt"

fn mtcollins1_pxe_mac_discovery_selection_text(selection: IpmiBootSelection) -> String {
  join([ipmi_boot_expected_device_rendering(selection: selection) as String, " / ", ipmi_boot_expected_mode_rendering(selection: selection) as String, " / ", ipmi_boot_expected_persistence_rendering(selection: selection) as String], "")
}

// THE HANDOFF OUTCOME AS TYPED LINES. An issued control means the boot-flags readback matched the requested selection (the handoff does not return the
// raw readback on that arm) and the chassis power readback confirmed the cycle; every other arm names what it observed.
fn mtcollins1_pxe_mac_discovery_outcome_lines(outcome: OobBootHandoffOutcome) -> String {
  match outcome {
    BootControlIssued { selected: d, power: t, admitted: _ } =>
      join(["selection_readback=verified requested=", d as String, "\n", "power_cycle=", match t { PoweredOn => "powered-on-from-off" PowerCycled => "off-then-on-observed" }, "\n", "power_after=on (chassis readback)\n"], "")
    BootSelectionRefused => "selection=controller-refused\n"
    BootSelectionNotApplied { requested: d, readback: r } => join(["selection_readback=NOT-APPLIED requested=", d as String, " readback=", r, "\n"], "")
    BootSelectionUnverifiable { requested: d, readback: r } => join(["selection_readback=UNVERIFIABLE requested=", d as String, " output=", r, "\n"], "")
    BootSelectionFlagInvalid { requested: d, readback: r } => join(["selection_readback=FLAG-INVALID requested=", d as String, " readback=", r, "\n"], "")
    BootSelectionNotOneShot { requested: d, readback: r } => join(["selection_readback=NOT-ONE-SHOT requested=", d as String, " readback=", r, "\n"], "")
    BootSelectionFirmwareMismatch { requested: d, readback: r } => join(["selection_readback=FIRMWARE-MISMATCH requested=", d as String, " readback=", r, "\n"], "")
    PowerStateReadFailed { selected: d, observed_state: o } => join(["selection_readback=verified requested=", d as String, "\n", "power_after=", chassis_observation_text(observation: o) as String, " (no power action written)\n"], "")
    PowerCommandRefused { selected: d, action: a } => join(["selection_readback=verified requested=", d as String, "\n", "power_command=", oob_power_action_verb(action: a) as String, " REFUSED\n"], "")
    PowerCommandAcceptedNoTransition { selected: d, action: a, progress: pr, last_observed: o } =>
      join(["selection_readback=verified requested=", d as String, "\n", "power_command=", oob_power_action_verb(action: a) as String, " accepted, transition NOT observed: ", power_transition_progress_text(progress: pr) as String, "\n", "power_after=", chassis_observation_text(observation: o) as String, " (last read)\n"], "")
    BootHandoffNotAdmitted { admission: _ } => "handoff=not-admitted (no write attempted)\n"
  }
}

fn mtcollins1_pxe_mac_discovery_release_text(released: ProcessExit) -> String {
  match released {
    ExitSuccess => "release=ok exit=success\n"
    ExitFailure { code: c, reason: r } => join(["release=exit exit=failure code=", to_string(c), " reason=", r, "\n"], "")
  }
}

fn mtcollins1_pxe_mac_discovery_receipt_text(run_id: String, sha: String, selection: IpmiBootSelection, outcome: OobBootHandoffOutcome, released: ProcessExit) -> String {
  join([
    "mtcollins1-pxe-mac-discovery-receipt run_id=", run_id, " revision=", sha, "\n",
    "hold=acquired owner_run=", run_id, "\n",
    "admit=cleared revision=", sha, "\n",
    "selection=", mtcollins1_pxe_mac_discovery_selection_text(selection: selection), "\n",
    mtcollins1_pxe_mac_discovery_outcome_lines(outcome: outcome),
    mtcollins1_pxe_mac_discovery_release_text(released: released),
  ], "")
}

fn mtcollins1_pxe_mac_discovery_wet() -> ProcessExit {
  let label = mtcollins1_pxe_mac_discovery_label as String
  let cred = actions_variable_trimmed(name: host_reset_bmc_credential_path_env)
  if cred == "" {
    return exit_failure(reason: concat(label, ": ", host_reset_bmc_credential_path_env as String, " is unset; controller untouched"))
  }
  let run_id = match actions_variable_read(name: github_run_id_variable_name) {
    ActionsVariablePresent { value: v } => v
    ActionsVariableAbsent { variable: _, detail: _ } => ""
  }
  let sha = match actions_variable_read(name: github_sha_variable_name) {
    ActionsVariablePresent { value: v } => v
    ActionsVariableAbsent { variable: _, detail: _ } => ""
  }
  if run_id == "" || sha == "" {
    return exit_failure(reason: concat(label, ": GITHUB_RUN_ID or GITHUB_SHA is unset; the hold owner and the attempt revision are run-owned; controller untouched"))
  }
  match mtcollins1_pxe_mac_discovery_host() {
    Absent => exit_failure(reason: concat(label, ": mtcollins1 is not a managed host; controller untouched"))
    Present { value: host } =>
      match bmc_control_binding(observed: host.access, secured: host.secure) {
        BmcControlAccessUnobserved { endpoint: _ } => exit_failure(reason: concat(label, ": the controller's access is unobserved; controller untouched"))
        BmcControlNotSecured { cause: _ } => exit_failure(reason: concat(label, ": the controller is not secured; controller untouched"))
        BmcControlEndpointMismatch { observed: _, secured: _ } => exit_failure(reason: concat(label, ": the observed and secured endpoints disagree; controller untouched"))
        BmcControlBound { route: route } =>
          match decide_pxe_boot_selection(evidence: megarac_operation_evidence(), access: host.access) {
            PxeBootSelectionRefused { cause: _ } => exit_failure(reason: concat(label, ": the PXE one-shot selection was not admitted for this controller; controller untouched"))
            PxeBootSelectionAdmitted { selection: selection, capability_row: row } =>
              match bmc_control_route_account(route: route) {
                Absent => exit_failure(reason: concat(label, ": the bound route names no managed account; controller untouched"))
                Present { value: account } =>
                  match boot_run_acquire_unit_hold(host: operator_host_mtcollins1, run_id: run_id as NonEmptyStr, tree: host_state_tree()) {
                    UnitHoldRefused { reason: r } => exit_failure(reason: concat(label, ": unit hold refused: ", r as String))
                    UnitHeld { proof: p } =>
                      match unit_hold_proof_refusal(proof: p, host: host.host, label: label) {
                        Present { value: why } => unit_hold_release(proof: p, outcome: exit_failure(reason: why))
                        Absent =>
                      match admit_boot_attempt(proof: p, revision: sha as NonEmptyStr, tree: host_state_tree()) {
                        BootAttemptRefused { cause: c } =>
                          unit_hold_release(proof: p, outcome: exit_failure(reason: concat(label, ": attempt receipt refused: ", attempt_receipt_refusal_text(cause: c))))
                        BootAttemptCleared { clearance: _ } => {
                          let handed = oob_boot_handoff(
                            observation: bmc_control_route_observation(route: route),
                            username: account,
                            password_file: cred as NonEmptyStr,
                            selection: selection,
                            capability_row: row,
                          )
                          let released = unit_hold_release(proof: p, outcome: boot_handoff_render_outcome(label: mtcollins1_pxe_mac_discovery_label, outcome: handed))
                          let written = Filesystem.Write(path: mtcollins1_pxe_mac_discovery_receipt_path, content: mtcollins1_pxe_mac_discovery_receipt_text(run_id: run_id, sha: sha, selection: selection, outcome: handed, released: released))
                          if written.success { released } else { exit_failure(reason: concat(label, ": the typed receipt could not be written: ", written.error)) }
                        }
                      }
                      }
                  }
              }
          }
      }
  }
}
