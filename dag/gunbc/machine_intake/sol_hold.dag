module gunbc.machine_intake_sol_hold

import std.types { Bool, NonEmptyStr, Unit }
import std.string_type { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// HOLDING A STREAMING SOL SESSION IS REALIZATION, NOT THE IPMI INTERFACE. extdeps.bmc.ipmi
// SolDeactivate is a flat ipmitool argv; `sol activate` is the matching interface and it does not
// return until the session ends. Backgrounding, redirecting the collector, and writing a pid are
// how THIS workflow holds that session after the operator grant — one of N realizations, never a
// fact about IPMI (DESIGN §3). The hold is still bash: process-hold is not a Node in the grammar
// yet, so the transport is a marked scaffold rather than an unmarked script fused into the BMC
// interface (review 67590).
//
// THE COLLECTOR'S STDIN IS OPEN AND SILENT, AND ITS LIFETIME IS THE COLLECTOR'S. `sol activate` is
// interactive: upstream ipmitool (lanplus ipmi_sol_red_pill) selects on stdin beside the session
// socket, services stdin FIRST, and forwards every byte it reads to the host as SOL input
// (processSolUserInput); a read of 0 bytes is EOF and ends the session. So stdin has three honest
// values and only one is observation: /dev/zero is endless NULs, which TYPED NULs at the host for
// every boot this collector watched; /dev/null is EOF, which exits the client within seconds of
// activation (the 2026-09-12 silent captures); an open pipe with no writer data is neither. The
// pipe is a fifo created 0600 beside the pid file, opened read-write on fd 3 (a read-write open of
// a fifo does not block and makes the holder its own writer, so no read ever returns EOF), unlinked
// at once, and handed to ipmitool as fd 0 with fd 3 closed in the child. No second process holds a
// writer, nothing ever writes, and the last descriptor is ipmitool's own: when the collector exits,
// the pipe is gone with it, so the hold owns and cleans up its input without a supervisor. Protocol
// keepalives are unaffected -- ipmitool times them from its own select loop, not from stdin.
//
// THE BEHAVIOUR ABOVE IS READ FROM THE BUILD THAT RUNS IT. srv1, 2026-09-27: `ipmitool -V` reports
// 1.8.19; dpkg ipmitool 1.8.19-7ubuntu0.24.04.3 arm64; /usr/bin/ipmitool sha256 prefix
// 84b8c7b03972e809. That package's debian/patches series (11 patches) touches lib/ipmi_tsol.c,
// sensor, SEL/SDR, lan print, time and manpage paths and nothing in lib/ipmi_sol.c or the lanplus
// SOL path, so ipmi_sol_red_pill is upstream IPMITOOL_1_8_19: stdin is tested FIRST in an if/else
// over the select set (so a stdin that is always readable, as /dev/zero is, starves the receive
// branch); a read of <= 0 bytes sets bShouldExit; keepalives run at the top of every loop pass on
// SOL_KEEPALIVE_TIMEOUT (15 s) whatever stdin holds; enter_raw_mode's tcgetattr on a non-tty stdin
// prints `tcgetattr` and continues, as it did for /dev/zero.

data mtcollins1_sol_hold_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.machine_intake_sol_hold",
    decl_name: "mtcollins1_sol_hold_shell_emit_dissolution_trigger",
    field: WholeDeclaration
  }
}

data mtcollins1_sol_hold_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: gunbc.machine_intake.sol_hold ActivateHeld — holding `ipmitool sol activate` as a background collector (redirect, stdin from an unlinked read-write fifo, pid file) is still a bash -c process-hold; paths are positional data (`$1`…`$5`), not interpolated shell syntax. DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0 / shell-to-intent Phase 2) or a typed process-hold realization starts a streaming session, redirects its bytes, and records the holder pid without a medium-as-string script")

service gunbc.machine_intake.sol_hold {
  operation ActivateHeld {
    input {
      bmc_host: NonEmptyStr
      username: NonEmptyStr
      password_file: NonEmptyStr
      capture_path: NonEmptyStr
      pid_path: NonEmptyStr
    }
    output { stdout: String from "stdout", success: Bool from "exit_success" }
    transport shell {
      argv: [
        "bash",
        "-c",
        "in=$(mktemp -u \"$5.stdin.XXXXXX\") && mkfifo -m 600 \"$in\" && exec 3<>\"$in\" && rm -f \"$in\" && { ipmitool -H \"$1\" -I lanplus -U \"$2\" -f \"$3\" sol activate >> \"$4\" 2>&1 <&3 3<&- & echo $! > \"$5\"; }",
        "sol-hold",
        "{bmc_host}",
        "{username}",
        "{password_file}",
        "{capture_path}",
        "{pid_path}"
      ]
    }
    exit {
      0 => Unit
      nonzero => String "sol activate held failed"
    }
  }
}
