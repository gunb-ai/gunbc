module gunbc.machine_intake_ampere_dram_console_observation

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.algebra { trim }
import v2.std.optional { Present }

// WHAT THE AMPERE DRAM FIRMWARE PRINTED ON THE SERIAL CONSOLE DURING ONE BOOT, as an observation
// receipt of this repository. It is not an upstream fact: Ampere publishes no specification of these
// lines that this corpus has read. The grammar is TRANSCRIBED FROM TWO CAPTURES, the mtcollins1 SOL
// captures of fleet-converge runs 35801475989 and 35793279839 (artifact mtcollins1-boot-receipts),
// whose bytes the witness carries verbatim. The block has this shape:
//
//   NOTICE:  DRAM FW version 210525          starts a block
//   CP: 0ff00900                             unindented lines between subsections belong to no subsection
//   MEMC param:                              a param subsection, scope MEMC
//     mcu_enable_mask = 00000011 [default: 000000ff]
//   MCU param:                               a param subsection, scope MCU
//     ecc_en = 00000002 [default: 00000001]
//   DRAM populated DIMMs:                    the trained-DIMM roster
//     SK0 MC0 S0: RDIMM[ad:80] 16GB 2666 ECC 1R x4 RCD[b3:80] HMA82GR7AFR4N-VK
//   CP: 3ff00100                             an unindented line closes the subsection
//
// Lines end in CR (the SOL transport is a serial line) and one capture carries a NUL before the
// first NOTICE; both are removed before a line is read. Indentation (a leading two spaces) is
// what places a line inside a subsection, so it is read before trimming.
//
// WHAT IS NOT CLAIMED (DESIGN section 4d). No param value has a meaning here, mcu_enable_mask
// included: a param is its name, value and printed default, recorded as an observation. That a
// value differs from its default is not an adverse fact (earlier successful sparse boots printed
// mcu_enable_mask 00000001 against default ff), so it is never a finding. "SK", "MC" and "S" are
// read as the socket, memory controller and slot indices their spelling names, which is
// transcribed from the captures, not cited. The text after the slot address is kept verbatim.
//
// AN INDENTED LINE INSIDE A RECOGNISED SUBSECTION THAT DOES NOT PARSE IS KEPT AS MALFORMED, never
// dropped, so a firmware release that changes the row format shows up in the receipt rather than
// as a shorter roster (DESIGN section 5).

data ampere_dram_fw_version_marker: String = "DRAM FW version "

data ampere_dram_populated_header: String = "DRAM populated DIMMs:"

data ampere_dram_param_header_suffix: String = " param:"

data ampere_dram_indent: String = "  "

type AmpereDramParam {
  scope: NonEmptyStr
  name: NonEmptyStr
  value: NonEmptyStr
  default_value: NonEmptyStr
}

type AmpereDramTrainedDimm {
  socket: Int
  memory_controller: Int
  slot: Int
  rendering: String
}

type AmpereDramMalformedLine {
  subsection: NonEmptyStr
  line: String
}

// WHETHER THE ROSTER WAS SEEN WHOLE. In both captures the roster's rows are followed by an
// unindented `CP:` checkpoint line, and a new `DRAM FW version` header also ends it; either closes
// the roster. The end of the capture does NOT: a SOL session lost or cut at a deadline stops
// mid-roster, and reading the rows seen so far as the whole roster would name every socket not yet
// printed as untrained. So only RosterClosed may establish that a socket trained nothing; the rows
// of an open roster are still rendered, as a partial observation.
type AmpereDramRosterStanding
  = RosterNotObserved
  | RosterOpen
  | RosterClosed

type AmpereDramBlock {
  firmware_version: NonEmptyStr
  params: List<AmpereDramParam>
  dimms: List<AmpereDramTrainedDimm>
  roster: AmpereDramRosterStanding
  malformed: List<AmpereDramMalformedLine>
}

// BlockNotPrinted is its own arm because an absent roster is not an empty one: a capture that never
// reached the DRAM firmware says nothing about which sockets trained. blocks_printed counts the
// blocks, and the block read is the LAST one, because a reset loop prints the block once per boot
// and the last is the one that led to whatever followed.
type AmpereDramConsoleObservation
  = AmpereDramBlockNotPrinted
  | AmpereDramBlockObserved { block: AmpereDramBlock, blocks_printed: Int }

type AmpereDramSubsection
  = OutsideSubsection
  | InParams { scope: NonEmptyStr }
  | InRoster

type AmpereDramReadState {
  blocks: List<AmpereDramBlock>
  current: AmpereDramBlock?
  subsection: AmpereDramSubsection
}

// A SOL LINE AS THE FIRMWARE WROTE IT: CR and NUL removed, leading spaces kept.
fn ampere_dram_console_line(raw: String) -> String {
  join(split(s: join(split(s: raw, delimiter: "\r"), ""), delimiter: "\0"), "")
}

fn text_after(line: String, marker: String) -> String? {
  let parts = split(s: line, delimiter: marker)
  if count(parts) < 2 { none } else {
    Present { value: join(parts.skip(n: 1), marker) }
  }
}

fn prefixed_int(token: String, prefix: String) -> Int? {
  if !starts_with(s: token, prefix: prefix) { none } else {
    parse_int(s: join(split(s: join(split(s: token, delimiter: ":"), ""), delimiter: prefix), ""))
  }
}

fn nth_token(tokens: List<String>, n: Int) -> String {
  match tokens.skip(n: n).first() { Absent => "" Present { value: t } => t }
}

// "SK<n> MC<n> S<n>: <rendering>"
fn ampere_dram_dimm_of(row: String) -> AmpereDramTrainedDimm? {
  let tokens = filter(split(s: trim(row), delimiter: " "), t => t != "")
  let sl = nth_token(tokens: tokens, n: 2)
  if !ends_with(s: sl, suffix: ":") { none } else {
    match prefixed_int(token: nth_token(tokens: tokens, n: 0), prefix: "SK") {
      Absent => none
      Present { value: socket } => match prefixed_int(token: nth_token(tokens: tokens, n: 1), prefix: "MC") {
        Absent => none
        Present { value: controller } => match prefixed_int(token: sl, prefix: "S") {
          Absent => none
          Present { value: slot } => Present { value: AmpereDramTrainedDimm {
            socket: socket, memory_controller: controller, slot: slot,
            rendering: join(tokens.skip(n: 3), " "),
          } }
        }
      }
    }
  }
}

// "<name> = <value> [default: <default>]" under a "<SCOPE> param:" header.
fn ampere_dram_param_of(scope: NonEmptyStr, row: String) -> AmpereDramParam? {
  let eq = split(s: trim(row), delimiter: " = ")
  let name = trim(match eq.first() { Absent => "" Present { value: n } => n })
  let vd = split(s: join(eq.skip(n: 1), " = "), delimiter: " [default: ")
  let value = trim(match vd.first() { Absent => "" Present { value: v } => v })
  let def_raw = trim(join(vd.skip(n: 1), " [default: "))
  if count(eq) != 2 || name == "" || value == "" || count(vd) != 2 || !ends_with(s: def_raw, suffix: "]") { none } else {
    let default_value = trim(join(split(s: def_raw, delimiter: "]"), ""))
    if default_value == "" { none } else {
      Present { value: AmpereDramParam { scope: scope, name: name as NonEmptyStr, value: value as NonEmptyStr, default_value: default_value as NonEmptyStr } }
    }
  }
}

fn block_with_param(b: AmpereDramBlock, p: AmpereDramParam) -> AmpereDramBlock {
  AmpereDramBlock { firmware_version: b.firmware_version, params: concat(b.params, [p]), dimms: b.dimms, roster: b.roster, malformed: b.malformed }
}

fn block_with_dimm(b: AmpereDramBlock, d: AmpereDramTrainedDimm) -> AmpereDramBlock {
  AmpereDramBlock { firmware_version: b.firmware_version, params: b.params, dimms: concat(b.dimms, [d]), roster: b.roster, malformed: b.malformed }
}

fn block_with_malformed(b: AmpereDramBlock, m: AmpereDramMalformedLine) -> AmpereDramBlock {
  AmpereDramBlock { firmware_version: b.firmware_version, params: b.params, dimms: b.dimms, roster: b.roster, malformed: concat(b.malformed, [m]) }
}

fn block_with_roster(b: AmpereDramBlock, r: AmpereDramRosterStanding) -> AmpereDramBlock {
  AmpereDramBlock { firmware_version: b.firmware_version, params: b.params, dimms: b.dimms, roster: r, malformed: b.malformed }
}

// A LINE THAT ENDS A SUBSECTION closes an open roster; anything else leaves the standing alone.
fn close_roster_if_open(state: AmpereDramReadState, block: AmpereDramBlock) -> AmpereDramBlock {
  match state.subsection {
    InRoster => block_with_roster(b: block, r: RosterClosed)
    _ => block
  }
}

fn subsection_label(s: AmpereDramSubsection) -> NonEmptyStr {
  match s {
    OutsideSubsection => "outside"
    InParams { scope: sc } => concat(sc as String, ampere_dram_param_header_suffix) as NonEmptyStr
    InRoster => ampere_dram_populated_header as NonEmptyStr
  }
}

// THE BLOCKS SEEN, with the current one as the capture left it: a roster still open at the end of
// the capture stays RosterOpen. A new block header, by contrast, does close it.
fn blocks_seen(state: AmpereDramReadState) -> List<AmpereDramBlock> {
  match state.current { Absent => state.blocks Present { value: b } => concat(state.blocks, [b]) }
}

fn blocks_before_new_header(state: AmpereDramReadState) -> List<AmpereDramBlock> {
  match state.current { Absent => state.blocks Present { value: b } => concat(state.blocks, [close_roster_if_open(state: state, block: b)]) }
}

fn ampere_dram_read_row(state: AmpereDramReadState, block: AmpereDramBlock, line: String) -> AmpereDramBlock {
  match state.subsection {
    OutsideSubsection => block
    InParams { scope: sc } => match ampere_dram_param_of(scope: sc, row: line) {
      Present { value: p } => block_with_param(b: block, p: p)
      Absent => block_with_malformed(b: block, m: AmpereDramMalformedLine { subsection: subsection_label(s: state.subsection), line: trim(line) })
    }
    InRoster => match ampere_dram_dimm_of(row: line) {
      Present { value: d } => block_with_dimm(b: block, d: d)
      Absent => block_with_malformed(b: block, m: AmpereDramMalformedLine { subsection: subsection_label(s: state.subsection), line: trim(line) })
    }
  }
}

fn ampere_dram_read_step(state: AmpereDramReadState, raw: String) -> AmpereDramReadState {
  let line = ampere_dram_console_line(raw: raw)
  let stripped = trim(line)
  match text_after(line: line, marker: ampere_dram_fw_version_marker) {
    Present { value: v } => {
      let version = trim(v)
      AmpereDramReadState {
        blocks: blocks_before_new_header(state: state),
        current: Present { value: AmpereDramBlock { firmware_version: (if version == "" { "unrendered" } else { version }) as NonEmptyStr, params: [], dimms: [], roster: RosterNotObserved, malformed: [] } },
        subsection: OutsideSubsection,
      }
    }
    Absent => match state.current {
      Absent => state
      Present { value: block } =>
        if starts_with(s: line, prefix: ampere_dram_indent) && stripped != "" {
          AmpereDramReadState { blocks: state.blocks, current: Present { value: ampere_dram_read_row(state: state, block: block, line: line) }, subsection: state.subsection }
        } else if stripped == ampere_dram_populated_header {
          AmpereDramReadState { blocks: state.blocks, current: Present { value: block_with_roster(b: close_roster_if_open(state: state, block: block), r: RosterOpen) }, subsection: InRoster }
        } else if ends_with(s: stripped, suffix: ampere_dram_param_header_suffix) && !string_contains(s: stripped, pattern: " = ") {
          let scope = trim(join(split(s: stripped, delimiter: ampere_dram_param_header_suffix), ""))
          let closed = close_roster_if_open(state: state, block: block)
          if scope == "" {
            AmpereDramReadState { blocks: state.blocks, current: Present { value: block_with_malformed(b: closed, m: AmpereDramMalformedLine { subsection: "header", line: stripped }) }, subsection: OutsideSubsection }
          } else {
            AmpereDramReadState { blocks: state.blocks, current: Present { value: closed }, subsection: InParams { scope: scope as NonEmptyStr } }
          }
        } else if stripped == "" {
          state
        } else {
          AmpereDramReadState { blocks: state.blocks, current: Present { value: close_roster_if_open(state: state, block: block) }, subsection: OutsideSubsection }
        }
    }
  }
}

fn ampere_dram_console_observation(lines: List<String>) -> AmpereDramConsoleObservation {
  let empty: List<AmpereDramBlock> = []
  let done = fold(lines, init: AmpereDramReadState { blocks: empty, current: none, subsection: OutsideSubsection }, f: (st, raw) => ampere_dram_read_step(state: st, raw: raw))
  let blocks = blocks_seen(state: done)
  match reverse(blocks).first() {
    Absent => AmpereDramBlockNotPrinted
    Present { value: last } => AmpereDramBlockObserved { block: last, blocks_printed: count(blocks) }
  }
}

fn ampere_dram_param_is_non_default(p: AmpereDramParam) -> Bool {
  (p.value as String) != (p.default_value as String)
}

fn ampere_dram_dimms_on_socket(block: AmpereDramBlock, socket: Int) -> Int {
  count(filter(block.dimms, d => d.socket == socket))
}

fn ampere_dram_socket_untrained(block: AmpereDramBlock, socket: Int) -> Bool {
  ampere_dram_dimms_on_socket(block: block, socket: socket) == 0
}

// THE DECISIVE FINDINGS THIS RECEIPT ESTABLISHES, given the sockets the caller expects: an expected
// socket with no trained DIMM row in a CLOSED roster, and a row inside a recognised subsection
// that does not parse. Params are never findings (see the note at the top).
fn ampere_dram_findings(observation: AmpereDramConsoleObservation, expected_sockets: List<Int>) -> List<String> {
  match observation {
    AmpereDramBlockNotPrinted => []
    AmpereDramBlockObserved { block: b, blocks_printed: _ } => {
      let closed = match b.roster { RosterClosed => true _ => false }
      let empty_sockets = map(filter(expected_sockets, k => closed && ampere_dram_socket_untrained(block: b, socket: k)),
        k => concat("DRAM firmware ", b.firmware_version as String, " printed no trained DIMM for socket ", to_string(k), " (no SK", to_string(k), " row under 'DRAM populated DIMMs:')"))
      let bad = map(b.malformed, m => concat("DRAM firmware row under '", m.subsection as String, "' not in the transcribed grammar: ", m.line))
      concat(empty_sockets, bad)
    }
  }
}

fn ampere_dram_console_text(observation: AmpereDramConsoleObservation, expected_sockets: List<Int>) -> String {
  match observation {
    AmpereDramBlockNotPrinted => "ampere dram firmware: NOT PRINTED in this capture (no 'DRAM FW version' line); no roster is observed"
    AmpereDramBlockObserved { block: b, blocks_printed: n } =>
      join([
        concat("ampere dram firmware: version ", b.firmware_version as String, "; block printed ", to_string(n), " time(s), the last read"),
        concat("params (observations; a value differing from its printed default is not a finding): ", to_string(count(b.params))),
        join(map(b.params, p => concat("  ", p.scope as String, " ", p.name as String, " = ", p.value as String, " [default ", p.default_value as String, "]", if ampere_dram_param_is_non_default(p: p) { " (differs from printed default)" } else { "" })), "\n"),
        concat("roster: ", ampere_dram_roster_text(r: b.roster)),
        concat("trained dimms by socket: ", join(map(expected_sockets, k => concat("SK", to_string(k), "=", to_string(ampere_dram_dimms_on_socket(block: b, socket: k)))), " ")),
        join(map(b.dimms, d => concat("  SK", to_string(d.socket), " MC", to_string(d.memory_controller), " S", to_string(d.slot), ": ", d.rendering)), "\n"),
        concat("malformed rows: ", to_string(count(b.malformed))),
      ], "\n")
  }
}

fn ampere_dram_roster_text(r: AmpereDramRosterStanding) -> String {
  match r {
    RosterNotObserved => "NOT OBSERVED (no 'DRAM populated DIMMs:' header in this block); no socket is established untrained"
    RosterOpen => "OPEN at the end of the capture (no line closed it); the rows below are partial and no socket is established untrained"
    RosterClosed => "closed"
  }
}
