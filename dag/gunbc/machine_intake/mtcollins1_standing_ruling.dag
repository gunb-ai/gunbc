module gunbc.machine_intake_mtcollins1_standing_ruling

import std.types { Int, List, NonEmptyStr, String }
import std.measure { Second, second }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.content_hash { Sha256Digest, sha256_hex_digest, as_content_hash_cryptographic }
import std.bytes { bytes_octets, utf8_encode_bytes }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_display_key }
import extdeps.crypto.sha2 { sha256_hex }
import std.effect_grant { Verb, Read, Write, Execute, NamespaceTree, NamespacePosition, ServiceOpTree, FilesystemPathTree, UriTree, ProcTree, CodeNameTree }
import std.scoped_authorization { AttemptIdentity, AuthorizationScope, AuthorizedAction, AuthorizationRequest }
import v2.std.optional { Present, Absent }
import gunbc.auth.approval_gate {
  approval_refusal_text,
  ApprovalRecorded, ApprovalNotRecorded, approval_recorded_from_poll,
  StandingReadAt, StandingClockUnreadable, approval_standing_read,
  approval_instant_now, approval_expires_at, approval_poll_ticks, PollObservedAt, PollBudgetExhausted, PollClockUnreadable,
  approval_file_stored_request, ApprovalFiled, ApprovalFilingRefused,
}
import gunbc.auth.approval_request_client { ApprovalPollStanding, stored_request_from_authorization }
import gunbc.auth.approval_decision_store { request_revision_of }
import gunbc.auth.consent_preimage { consent_field, consent_list_field }

// ── THE OPERATOR'S STANDING CONSENT, ATTESTED OUTSIDE THE DIFF (review 70369; decision A) ──────
//
// The Mt. Collins boot is an irreversible effect (a power cycle destroys RAM and session state) that
// recurs with nobody attending, so the selection admits it only under a standing authorization
// (gunbc.auth.authorization_pattern_selection StandingRulingUnderInterlock). A row in this corpus
// cannot BE that authorization -- DESIGN §5: approval is external to the diff, because an author
// who can write a scaffold can equally write a row claiming it was approved. So the ruling is filed
// ONCE through the existing approval loop: its words are the request's purpose, shown to the
// operator on the ntfy request, and their content hash is the request's intent hash, so the stored
// decision is bound to exactly these words. Every boot reads that stored decision before the unit
// hold and refuses, typed, unless it is an approval over this hash: absent, pending, denied, or
// decided for different words all refuse. Editing one character of the text below changes the hash
// and voids the consent until the operator taps again. There is no fallback to a per-run approval.
//
// PROVENANCE THE TAP CONFIRMS: the operator's chat ruling of 2026-09-23, "we technically don't even
// need my approval - would you mind getting rid of that step or making WIF just trust this
// workflow", relayed by eager-owl-205.

data mtcollins1_boot_standing_ruling_text: NonEmptyStr = "STANDING AUTHORIZATION (recurring destructive effect). I authorize the fleet-converge mtcollins1_boot mode, dispatched from gunb-ai/gunbc main and running as its dedicated workload identity, to attach the census image to Mt. Collins unit 1 over BMC virtual media, set a one-shot CD boot, power-cycle the unit and capture its SOL console, on every dispatch, and the fleet-converge host_reset_return mode to power-cycle the same unit, without a per-run approval. A power cycle destroys the unit's RAM and running session and cannot be undone. This consent holds only while each run first takes the unit's maintenance hold (gunbc.machine_intake_mtcollins1_maintenance_hold) and refuses when it is held. Provenance: operator chat ruling 2026-09-23." as NonEmptyStr

// ONE TYPED VALUE: THE MT. COLLINS DESTRUCTIVE CONTROLLER EFFECT (side-chat review 5288466573). The
// operator's consent covers the unit's destructive BMC effects by BOTH production roots that perform
// them -- the boot and host reset-return -- so it is one ruling, not one per root: the consent does
// not differ between them, and two rulings would be two authorities for one decision (DESIGN §3).
// Everything else is DERIVED from this value: the approval request, the SHA-256 digest, the
// escalation id, the census's StandingDestructiveAuthorization and both census rows
// (gunbc.auth.privileged_effect_census). Changing the words, the effect, the root population, any
// part of the scope, or the interlock is a different ruling -- a different digest and id.
type StandingRuling {
  text: NonEmptyStr
  effect_subject: NonEmptyStr
  roots: List<DeclarationRef>
  scope: AuthorizationScope
  interlock: DeclarationRef
}

data mtcollins1_destructive_controller_scope: AuthorizationScope = AuthorizationScope {
  verb: Write,
  resource: NamespacePosition { tree: ServiceOpTree { service: "gunbc-standing-ruling" }, path: ["mtcollins1", "bmc", "destructive-controller-effect"] },
  action: "gunbc.standing-ruling.mtcollins1-destructive-controller-effect" as AuthorizedAction,
}

data mtcollins1_boot_standing_ruling: StandingRuling = StandingRuling {
  text: mtcollins1_boot_standing_ruling_text,
  effect_subject: "mtcollins1 destructive controller effect: BMC virtual-media attach, one-shot boot-device set, power cycle and SOL capture" as NonEmptyStr,
  roots: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_wet"),
    decl_ref(module_path: "gunbc.host_reset_return_run", decl_name: "host_reset_return_wet"),
  ],
  scope: mtcollins1_destructive_controller_scope,
  interlock: decl_ref(module_path: "gunbc.machine_intake_mtcollins1_maintenance_hold", decl_name: "mtcollins1_unit_hold_key"),
}

// ── ONE INJECTIVE ENCODING OF THE COMPLETE RULING ─────────────────────────────────────────────
// The field encoding is gunbc.auth.consent_preimage's. Every component is encoded: text, effect
// subject, every root, the scope's verb, resource tree (and its service), every path segment,
// action, interlock.
fn verb_wire(v: Verb) -> String {
  match v {
    Read => "Read"
    Write => "Write"
    Execute => "Execute"
  }
}

fn tree_wire(t: NamespaceTree) -> String {
  match t {
    FilesystemPathTree => consent_field(tag: "tree", value: "FilesystemPathTree")
    UriTree => consent_field(tag: "tree", value: "UriTree")
    ProcTree => consent_field(tag: "tree", value: "ProcTree")
    CodeNameTree => consent_field(tag: "tree", value: "CodeNameTree")
    ServiceOpTree { service: sv } => concat(consent_field(tag: "tree", value: "ServiceOpTree"), consent_field(tag: "service", value: sv))
  }
}

fn standing_ruling_preimage(r: StandingRuling) -> String {
  join([
    consent_field(tag: "encoding", value: "gunbc-standing-ruling/2"),
    consent_field(tag: "text", value: r.text as String),
    consent_field(tag: "effect", value: r.effect_subject as String),
    consent_list_field(tag: "root", values: map(r.roots, d => declaration_ref_display_key(ref: d))),
    consent_field(tag: "verb", value: verb_wire(v: r.scope.verb)),
    tree_wire(t: r.scope.resource.tree),
    consent_list_field(tag: "path", values: r.scope.resource.path),
    consent_field(tag: "action", value: r.scope.action as String),
    consent_field(tag: "interlock", value: declaration_ref_display_key(ref: r.interlock)),
  ], "")
}

// SHA-256 (FIPS 180-4, extdeps.crypto.sha2), not the structural FNV family: this digest is a
// security binding between a stored consent and the ruling a run enforces.
fn standing_ruling_digest_hex(r: StandingRuling) -> String {
  sha256_hex(message: bytes_octets(b: utf8_encode_bytes(s: standing_ruling_preimage(r: r))))
}

type StandingRulingDigest
  = StandingRulingDigested { digest: Sha256Digest }
  | StandingRulingDigestRefused { reason: NonEmptyStr }

fn standing_ruling_digest(r: StandingRuling) -> StandingRulingDigest {
  match sha256_hex_digest(hex: standing_ruling_digest_hex(r: r)) {
    Present { value: d } => StandingRulingDigested { digest: d }
    Absent => StandingRulingDigestRefused { reason: "the standing ruling's SHA-256 did not admit as a lowercase 64-hex digest" as NonEmptyStr }
  }
}

// THE ESCALATION ID IS VERSIONED BY THE DIGEST. The approval store admits one request per id (the
// slot is created once), so a fixed id would make a revised or once-denied ruling unfileable and
// every boot refuse forever. Each ruling revision has its own id; the old request and its decision
// stay immutable under theirs.
fn standing_ruling_escalation_id(d: Sha256Digest) -> NonEmptyStr {
  concat("mtcollins1-standing-ruling-", d.hex as String) as NonEmptyStr
}

type StandingRulingSubject {
  ruling_text: NonEmptyStr
  effect_subject: NonEmptyStr
  interlock: DeclarationRef
}

// THE REQUEST IS A FUNCTION OF THE RULING AND ITS DIGEST: the digest is the intent hash and the id
// suffix, and the ruling's words are the purpose the operator reads.
fn standing_ruling_request_for(r: StandingRuling, d: Sha256Digest) -> AuthorizationRequest<StandingRulingSubject> {
  AuthorizationRequest {
    escalation_id: standing_ruling_escalation_id(d: d),
    scopes: [r.scope],
    subject: StandingRulingSubject { ruling_text: r.text, effect_subject: r.effect_subject, interlock: r.interlock },
    purpose: r.text,
    attempt: "mtcollins1-standing-ruling" as AttemptIdentity,
    intent_hash: as_content_hash_cryptographic(digest: d),
    destructive: true,
  }
}

type StandingRulingRequest
  = StandingRulingRequested { request: AuthorizationRequest<StandingRulingSubject> }
  | StandingRulingUnrequestable { reason: NonEmptyStr }

fn standing_ruling_request(r: StandingRuling) -> StandingRulingRequest {
  match standing_ruling_digest(r: r) {
    StandingRulingDigestRefused { reason: why } => StandingRulingUnrequestable { reason: why }
    StandingRulingDigested { digest: d } => StandingRulingRequested { request: standing_ruling_request_for(r: r, d: d) }
  }
}

// ── THE CONFIRMATION: MINTED ONLY BY THE LIVE READ ─────────────────────────────────────────────
// sole_constructor: no literal of it outside this module compiles (test.probe.unit_hold_proof_forged_probe),
// and this module mints it in one place, the ApprovalRecorded arm of the live read below. The boot's
// hold-owning path takes it as a parameter, so a boot that skips the read has nothing to pass.
type StandingRulingConfirmation sole_constructor {
  revision: NonEmptyStr
}

type StandingRulingStanding
  = StandingRulingConfirmed { confirmation: StandingRulingConfirmation }
  | StandingRulingRefused { reason: NonEmptyStr }

// THE PURE DECISION over a supplied poll standing returns a REFUSAL OR NOTHING -- never a
// confirmation -- so a witness can drive every arm without being able to mint one.
fn standing_ruling_refusal(poll: ApprovalPollStanding, request: AuthorizationRequest<StandingRulingSubject>) -> NonEmptyStr? {
  match approval_recorded_from_poll(poll: poll, request: request) {
    ApprovalRecorded { authorization: _ } => none
    ApprovalNotRecorded { cause: c } =>
      Present { value: join(["mtcollins1 boot: the operator's standing ruling is not confirmed for these words (", approval_refusal_text(cause: c), "); every boot refuses until it is; controller untouched"], "") as NonEmptyStr }
  }
}

// THE LIVE READ, on srv1 (the approvals store is loopback there). One GET of the stored decision.
fn mtcollins1_boot_standing_ruling_read() -> StandingRulingStanding
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_wet_on_srv1"),
    decl_ref(module_path: "gunbc.host_reset_return_run", decl_name: "host_reset_return_wet"),
  ]
{
  let request = match standing_ruling_request(r: mtcollins1_boot_standing_ruling) {
    StandingRulingUnrequestable { reason: why } => return StandingRulingRefused { reason: why }
    StandingRulingRequested { request: q } => q
  }
  match approval_instant_now() {
    Absent => StandingRulingRefused { reason: "mtcollins1 boot: clock unreadable; cannot read the standing ruling's decision; controller untouched" as NonEmptyStr }
    Present { value: now } =>
      match approval_standing_read(escalation_id: request.escalation_id, expires_at: approval_expires_at(issued: now, window: second(count: 1))) {
        StandingClockUnreadable => StandingRulingRefused { reason: "mtcollins1 boot: clock unreadable at the standing-ruling read; controller untouched" as NonEmptyStr }
        StandingReadAt { standing: s, observed_at: _ } =>
          match standing_ruling_refusal(poll: s, request: request) {
            Present { value: why } => StandingRulingRefused { reason: why }
            Absent => StandingRulingConfirmed { confirmation: StandingRulingConfirmation { revision: request_revision_of(request: request) } }
          }
      }
  }
}

// ── THE ONE-TIME FILING, run by the operator in a session on srv1 ──────────────────────────────
// Files the ruling's words for approval and waits for the tap. The submission MAC key is read from
// its path variable (gunbc.auth.approval_keyring_pins approval_submission_mac_key_path_env), which on
// srv1 names the key the approval keyring converge placed there.
data standing_ruling_file_window: Second = second(count: 1800)

data standing_ruling_poll_cadence: Second = second(count: 15)

data standing_ruling_poll_ticks: Int = 120

fn mtcollins1_boot_standing_ruling_file() -> ProcessExit {
  let request = match standing_ruling_request(r: mtcollins1_boot_standing_ruling) {
    StandingRulingUnrequestable { reason: why } => return exit_failure(reason: why as String)
    StandingRulingRequested { request: q } => q
  }
  match approval_instant_now() {
    Absent => exit_failure(reason: "standing ruling filing: clock unreadable")
    Present { value: issued } => {
      let expires = approval_expires_at(issued: issued, window: standing_ruling_file_window)
      match approval_file_stored_request(stored: stored_request_from_authorization(request: request, issued_at: issued, expires_at: expires), body_file_name: "mtcollins1-standing-ruling-submit.json", submit_timeout: second(count: 30)) {
        ApprovalFilingRefused { reason: r } => exit_failure(reason: concat("standing ruling filing refused: ", r))
        ApprovalFiled =>
          match approval_poll_ticks(remaining: standing_ruling_poll_ticks, cadence: standing_ruling_poll_cadence, escalation_id: request.escalation_id, expires_at: expires) {
            PollClockUnreadable => exit_failure(reason: "standing ruling filing: clock unreadable while waiting")
            PollBudgetExhausted { escalation_id: _, observed_at: _ } => exit_failure(reason: "standing ruling filed; no decision within the window -- re-run to wait again")
            PollObservedAt { standing: s, observed_at: _ } =>
              match standing_ruling_refusal(poll: s, request: request) {
                Present { value: why } => exit_failure(reason: why as String)
                Absent => ExitSuccess
              }
          }
      }
    }
  }
}
