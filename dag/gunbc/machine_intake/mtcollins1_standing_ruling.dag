module gunbc.machine_intake_mtcollins1_standing_ruling

import std.types { Int, NonEmptyStr, String }
import std.measure { Second, second }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.content_hash { content_hash_of_value }
import std.effect_grant { NamespacePosition, ServiceOpTree, Write }
import std.scoped_authorization { AttemptIdentity, AuthorizationScope, AuthorizedAction, AuthorizationRequest }
import v2.std.optional { Present, Absent }
import gunbc.auth.approval_gate {
  approval_refusal_text,
  ApprovalRecorded, ApprovalNotRecorded, approval_recorded_from_poll,
  StandingReadAt, StandingClockUnreadable, approval_standing_read,
  approval_instant_now, approval_expires_at, approval_poll_ticks, PollObservedAt, PollBudgetExhausted, PollClockUnreadable,
  approval_file_stored_request, ApprovalFiled, ApprovalFilingRefused,
}
import gunbc.auth.approval_request_client { ApprovalPollStanding, stored_request_from_authorization }
import gunbc.auth.approval_decision_store { request_revision_of }

// ── THE OPERATOR'S STANDING CONSENT, ATTESTED OUTSIDE THE DIFF (review 70369; decision A) ──────
//
// The Mt. Collins boot is an irreversible effect (a power cycle destroys RAM and session state) that
// recurs with nobody attending, so the selection admits it only under a standing authorization
// (gunbc.auth.authorization_pattern_selection StandingRulingUnderInterlock). A row in this corpus
// cannot BE that authorization -- DESIGN §5: approval is external to the diff, because an author
// who can write a scaffold can equally write a row claiming it was approved. So the ruling is filed
// ONCE through the existing approval loop: its words are the request's purpose, shown to the
// operator on the ntfy request, and their content hash is the request's intent hash, so the stored
// decision is bound to exactly these words. Every boot reads that stored decision before the unit
// hold and refuses, typed, unless it is an approval over this hash: absent, pending, denied, or
// decided for different words all refuse. Editing one character of the text below changes the hash
// and voids the consent until the operator taps again. There is no fallback to a per-run approval.
//
// PROVENANCE THE TAP CONFIRMS: the operator's chat ruling of 2026-09-23, "we technically don't even
// need my approval - would you mind getting rid of that step or making WIF just trust this
// workflow", relayed by eager-owl-205.

data mtcollins1_boot_standing_ruling_text: NonEmptyStr = "STANDING AUTHORIZATION (recurring destructive effect). I authorize the fleet-converge mtcollins1_boot mode, dispatched from gunb-ai/gunbc main and running as its dedicated workload identity, to attach the census image to Mt. Collins unit 1 over BMC virtual media, set a one-shot CD boot, power-cycle the unit and capture its SOL console, on every dispatch, without a per-run approval. A power cycle destroys the unit's RAM and running session and cannot be undone. This consent holds only while each run first takes the unit's maintenance hold (gunbc.machine_intake_mtcollins1_maintenance_hold) and refuses when it is held. Provenance: operator chat ruling 2026-09-23." as NonEmptyStr

data mtcollins1_boot_standing_ruling_escalation_id: NonEmptyStr = "mtcollins1-boot-standing-ruling" as NonEmptyStr

type StandingRulingSubject {
  ruling_text: NonEmptyStr
}

data mtcollins1_boot_standing_ruling_scope: AuthorizationScope = AuthorizationScope {
  verb: Write,
  resource: NamespacePosition { tree: ServiceOpTree { service: "gunbc-standing-ruling" }, path: ["mtcollins1", "boot"] },
  action: "gunbc.standing-ruling.mtcollins1-boot" as AuthorizedAction,
}

// THE REQUEST IS A FUNCTION OF THE TEXT, so a witness can hash a one-character edit and show the
// stored decision refused for it.
fn standing_ruling_request(text: NonEmptyStr) -> AuthorizationRequest<StandingRulingSubject> {
  AuthorizationRequest {
    escalation_id: mtcollins1_boot_standing_ruling_escalation_id,
    scopes: [mtcollins1_boot_standing_ruling_scope],
    subject: StandingRulingSubject { ruling_text: text },
    purpose: text,
    attempt: "mtcollins1-boot-standing-ruling" as AttemptIdentity,
    intent_hash: content_hash_of_value(value: text),
    destructive: true,
  }
}

fn mtcollins1_boot_standing_ruling_request() -> AuthorizationRequest<StandingRulingSubject> {
  standing_ruling_request(text: mtcollins1_boot_standing_ruling_text)
}

// ── THE CONFIRMATION: MINTED ONLY BY THE LIVE READ ─────────────────────────────────────────────
// sole_constructor: no literal of it outside this module compiles (test.probe.unit_hold_proof_forged_probe),
// and this module mints it in one place, the ApprovalRecorded arm of the live read below. The boot's
// hold-owning path takes it as a parameter, so a boot that skips the read has nothing to pass.
type StandingRulingConfirmation sole_constructor {
  revision: NonEmptyStr
}

type StandingRulingStanding
  = StandingRulingConfirmed { confirmation: StandingRulingConfirmation }
  | StandingRulingRefused { reason: NonEmptyStr }

// THE PURE DECISION over a supplied poll standing returns a REFUSAL OR NOTHING -- never a
// confirmation -- so a witness can drive every arm without being able to mint one.
fn standing_ruling_refusal(poll: ApprovalPollStanding, request: AuthorizationRequest<StandingRulingSubject>) -> NonEmptyStr? {
  match approval_recorded_from_poll(poll: poll, request: request) {
    ApprovalRecorded { authorization: _ } => none
    ApprovalNotRecorded { cause: c } =>
      Present { value: join(["mtcollins1 boot: the operator's standing ruling is not confirmed for these words (", approval_refusal_text(cause: c), "); every boot refuses until it is; controller untouched"], "") as NonEmptyStr }
  }
}

// THE LIVE READ, on srv1 (the approvals store is loopback there). One GET of the stored decision.
fn mtcollins1_boot_standing_ruling_read() -> StandingRulingStanding {
  let request = mtcollins1_boot_standing_ruling_request()
  match approval_instant_now() {
    Absent => StandingRulingRefused { reason: "mtcollins1 boot: clock unreadable; cannot read the standing ruling's decision; controller untouched" as NonEmptyStr }
    Present { value: now } =>
      match approval_standing_read(escalation_id: request.escalation_id, expires_at: approval_expires_at(issued: now, window: second(count: 1))) {
        StandingClockUnreadable => StandingRulingRefused { reason: "mtcollins1 boot: clock unreadable at the standing-ruling read; controller untouched" as NonEmptyStr }
        StandingReadAt { standing: s, observed_at: _ } =>
          match standing_ruling_refusal(poll: s, request: request) {
            Present { value: why } => StandingRulingRefused { reason: why }
            Absent => StandingRulingConfirmed { confirmation: StandingRulingConfirmation { revision: request_revision_of(request: request) } }
          }
      }
  }
}

// ── THE ONE-TIME FILING, run by the operator in a session on srv1 ──────────────────────────────
// Files the ruling's words for approval and waits for the tap. The submission MAC key is read from
// its path variable (gunbc.auth.approval_keyring_pins approval_submission_mac_key_path_env), which on
// srv1 names the key the approval keyring converge placed there.
data standing_ruling_file_window: Second = second(count: 1800)

data standing_ruling_poll_cadence: Second = second(count: 15)

data standing_ruling_poll_ticks: Int = 120

fn mtcollins1_boot_standing_ruling_file() -> ProcessExit {
  let request = mtcollins1_boot_standing_ruling_request()
  match approval_instant_now() {
    Absent => exit_failure(reason: "standing ruling filing: clock unreadable")
    Present { value: issued } => {
      let expires = approval_expires_at(issued: issued, window: standing_ruling_file_window)
      match approval_file_stored_request(stored: stored_request_from_authorization(request: request, issued_at: issued, expires_at: expires), body_file_name: "mtcollins1-standing-ruling-submit.json", submit_timeout: second(count: 30)) {
        ApprovalFilingRefused { reason: r } => exit_failure(reason: concat("standing ruling filing refused: ", r))
        ApprovalFiled =>
          match approval_poll_ticks(remaining: standing_ruling_poll_ticks, cadence: standing_ruling_poll_cadence, escalation_id: request.escalation_id, expires_at: expires) {
            PollClockUnreadable => exit_failure(reason: "standing ruling filing: clock unreadable while waiting")
            PollBudgetExhausted { escalation_id: _, observed_at: _ } => exit_failure(reason: "standing ruling filed; no decision within the window -- re-run to wait again")
            PollObservedAt { standing: s, observed_at: _ } =>
              match standing_ruling_refusal(poll: s, request: request) {
                Present { value: why } => exit_failure(reason: why as String)
                Absent => ExitSuccess
              }
          }
      }
    }
  }
}
