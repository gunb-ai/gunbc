module gunbc.machine_intake.megarac_operation_evidence

import std.types { EpochMs, List }
import std.content_hash { Sha256Digest, Sha256Hash }
import std.decl_ref { decl_ref }
import extdeps.bmc.endpoint { AmiMegaRac }
import extdeps.bmc.capability { bmc_firmware_release_identity_of_wire }
import gunbc.machine_intake.receipt { EvidenceRef }
import gunbc.host.megarac_operation_standing {
  MegaRacOperationEvidence, megarac_operation_evidence_of, MegaRacVirtualMediaAttach, MegaRacKvmCanvasStill, MegaRacSdrSocketNaming,
  megarac_build_reading, megarac_operation_receipt, megarac_firmware_transition,
}
import gunbc.machine_intake.mtcollins1_access_observation {
  mtcollins1_endpoint, mtcollins1_firmware, mtcollins1_identity, mtcollins1_evidence_manifest_digest, mtcollins1_observed_at,
}
import gunbc.machine_intake.mtcollins1_diskless_boot_receipt {
  mtcollins1_diskless_boot_artifact_path, mtcollins1_diskless_boot_capture_digest, mtcollins1_diskless_boot_observed_at,
}
import gunbc.machine_intake.mtcollins1_32dimm_bringup_observation { mtcollins1_sdr_capture }

// THE COMMITTED EVIDENCE OF WHICH MEGARAC OPERATIONS RAN ON WHICH CONTROLLER BUILD, one row per capture
// (gunbc.host.megarac_operation_standing joins them). Every row cites a committed artifact by path and
// digest, except the reflash, whose record is the session that performed it. Adding a controller, or a
// later build of this one, is a row here beside the capture that grounds it -- never an edit of the
// join or of the admission.
//
// MT. COLLINS UNIT 1, AS OF THIS WRITING:
//   - BMC 0.32 (Foxconn Mt. Collins), read by the 2026-09-05 intake observation. Virtual media ran on it
//     (the 2026-09-06 diskless boot) and an SDR read with its CPU<n>_ names ran on it (2026-09-11).
//     The KVM canvas still has no standing at 0.32: no committed still exists from that build.
//   - Reflashed to BMC 0.45.3 on 2026-10-02 (the firmware converge's recorded credential effect).
//   - Fleet-converge run 37102391062, 2026-10-03, about 21 h after the reflash, committed its media
//     attach (diagnostics), its KVM journal with five sha256-bound stills, and a BMC sensor read. Those
//     are receipts of a run, and NO READING OF THE 0.45.3 BUILD IS COMMITTED: the read-only probe
//     (mc info / hpm check) is owed. Until it lands as a reading row these receipts join no build, so
//     no operation is grounded at 0.45.3.
//   - That run's sensor read was taken with the host off: every CPU0_ and CPU1_ record answered "No
//     Reading", but the SDR RECORD NAMES are present in the capture, which is what socket naming reads.
//     So the receipt evidences the naming, not only that a read executed; it still grounds nothing at
//     0.45.3 until the build is read.

// THE FIXTURE EVIDENCE MINT, public on purpose and living HERE rather than in a witness. The carriers
// (reading/receipt/transition) and their one mint (megarac_operation_evidence_of) are sole_constructor and
// sealed to the committed evidence rows plus the megarac standing witnesses; a boot witness must not reach
// for that mint to invent a controller build. This function is the sanctioned door: it builds the ONE shape
// a boot fixture needs -- "at this endpoint, one reading recorded this build" -- from arguments the caller
// supplies, and it names no unit, so it is not a host branch. The reading's evidence ref and instant are the
// CALLER's to name, so a fixture cannot quietly borrow a committed artifact as backing for a build that
// artifact never recorded: pass the real ref when the reading is real, and a ref that says "hypothetical
// fixture" when it is not.
//
// This is what lets the boot path's capability lookup be keyed by megarac_current_build(evidence:,
// endpoint:) (manager HOLD defect 1): a witness asserting "this controller now runs build X" says it by
// producing a reading or a transition for X, exactly as production does, instead of rewriting the firmware
// field of an immutable access-probe receipt -- which, once the release stops being read off the receipt,
// would be a claim asserting nothing.
// THE MINT IS SEALED TO ITS CLAIMS AND ITS TWO SANCTIONED HELPERS (side-chat blocker 2). Public and
// unsealed, this fn let ANY caller build the genuine-shaped 0.32 reading with transitions: [] and get
// 0.32 back -- the roster in megarac_operation_evidence_of judges only the immediate caller, so an
// unsealed public mint re-opened the population from outside it. Now the roster names every terminal
// claim that needs a fixture build, plus the two evidence-returning helpers the witnesses use
// (test.claim.host.managed_host_boot_witness fixture_evidence_at and
// test.claim.host.managed_host_witness witness_evidence_reporting); those helpers are themselves
// sealed to their own claim rosters below, so sealing the helpers seals the claims that reach them
// THROUGH them -- and an unrostered caller is refused at either step, which is what the direct AND
// indirect forged probes measure, each beside the admitted control.
fn megarac_operation_evidence_fixture_for(
  endpoint: BmcControllerEndpoint,
  identity: BmcObservedIdentity,
  evidence: EvidenceRef,
  observed_at: EpochMs,
) -> MegaRacOperationEvidence
  admit_callers: [
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "fixture_evidence_at"),
    decl_ref(module_path: "test.claim.host.managed_host_witness", decl_name: "witness_evidence_reporting"),
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_a_build_reading_for_another_controller_grounds_no_capability_row"),
  ]
{
  megarac_operation_evidence_of(
    readings: [megarac_build_reading(endpoint: endpoint, identity: identity, evidence: evidence, observed_at: observed_at)],
    receipts: [],
    transitions: [],
  )
}

// THE EMPTY FIXTURE EVIDENCE: "no reading and no reflash has ever been recorded at this controller". The
// lookup answers that with HostCapabilityRowNoCurrentRelease, so it must be writable without fabricating a
// reading. Named and public for the same reason as above -- the population is sole_constructor.
fn megarac_operation_evidence_fixture_none() -> MegaRacOperationEvidence
  admit_callers: [
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "fixture_evidence_at"),
    decl_ref(module_path: "test.claim.host.managed_host_witness", decl_name: "witness_evidence_reporting"),
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_the_admitted_machine_boots_off_the_current_release_and_not_the_probed_one"),
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_a_build_reading_for_another_controller_grounds_no_capability_row"),
  ]
{
  megarac_operation_evidence_of(readings: [], receipts: [], transitions: [])
}

data mtcollins1_intake_reading_evidence: EvidenceRef = EvidenceRef {
  label: "mtcollins1 intake capture and write exercise (gunbc.machine_intake.mtcollins1_access_observation mtcollins1_evidence_manifest_digest)",
  digest: mtcollins1_evidence_manifest_digest,
}

data mtcollins1_diskless_boot_evidence: EvidenceRef = EvidenceRef {
  label: mtcollins1_diskless_boot_artifact_path,
  digest: mtcollins1_diskless_boot_capture_digest,
}

data mtcollins1_sdr_32dimm_evidence: EvidenceRef = EvidenceRef {
  label: mtcollins1_sdr_capture.artifact_path,
  digest: mtcollins1_sdr_capture.digest,
}

// 2026-09-11T00:00:00Z: the 32-DIMM capture names its day, not its instant.
data mtcollins1_sdr_32dimm_read_on: EpochMs = 1789084800000


data mtcollins1_run_37102391062_diagnostics: EvidenceRef = EvidenceRef {
  label: "artifacts/bmc/mtcollins1-boot-run-37102391062/mtcollins1-boot-diagnostics.txt",
  digest: Sha256Hash(Sha256Digest { hex: "d76d874395e4b809a6d70ccbccb4d941012391feeb14e7a8a2241befbf56b2d2" }),
}

data mtcollins1_run_37102391062_kvm_journal: EvidenceRef = EvidenceRef {
  label: "artifacts/bmc/mtcollins1-boot-run-37102391062/kvm/journal",
  digest: Sha256Hash(Sha256Digest { hex: "357c2410a75c2f46e5679bc17f2c5fa46d2444e3379756037adfa57aaf75557c" }),
}

// The diagnostics' handoff look answered at 1791016730385 with the medium presented, the journal's
// established line is at 2026-10-03T08:38:30.837Z, and the diagnostics' end-of-attempt look at
// 1791016934906 bounds the sensor read, which the capture does not timestamp.
data mtcollins1_run_37102391062_media_at: EpochMs = 1791016730385
data mtcollins1_run_37102391062_kvm_at: EpochMs = 1791016710837
data mtcollins1_run_37102391062_sensors_by: EpochMs = 1791016934906

// THE 2026-10-02 REFLASH. The vendor names the release 0.45.3 (extdeps.ampere.mt_collins_firmware_release
// mt_collins_bmc_0_45_3_hpm); what the controller reports for it is the probe's to read, and a reading
// row supersedes this name as the current build the moment it lands.
data mtcollins1_reflash_not_before: EpochMs = 1790899200000
data mtcollins1_reflash_not_after: EpochMs = 1790985600000

fn mtcollins1_megarac_operation_evidence() -> MegaRacOperationEvidence {
  megarac_operation_evidence_of(
    readings: [
      megarac_build_reading(endpoint: mtcollins1_endpoint, identity: mtcollins1_identity, evidence: mtcollins1_intake_reading_evidence, observed_at: mtcollins1_observed_at),
    ],
    receipts: [
      megarac_operation_receipt(operation: MegaRacVirtualMediaAttach, endpoint: mtcollins1_endpoint, receipt: mtcollins1_diskless_boot_evidence, executed_at: mtcollins1_diskless_boot_observed_at),
      megarac_operation_receipt(operation: MegaRacSdrSocketNaming, endpoint: mtcollins1_endpoint, receipt: mtcollins1_sdr_32dimm_evidence, executed_at: mtcollins1_sdr_32dimm_read_on),
      megarac_operation_receipt(operation: MegaRacVirtualMediaAttach, endpoint: mtcollins1_endpoint, receipt: mtcollins1_run_37102391062_diagnostics, executed_at: mtcollins1_run_37102391062_media_at),
      megarac_operation_receipt(operation: MegaRacKvmCanvasStill, endpoint: mtcollins1_endpoint, receipt: mtcollins1_run_37102391062_kvm_journal, executed_at: mtcollins1_run_37102391062_kvm_at),
      megarac_operation_receipt(operation: MegaRacSdrSocketNaming, endpoint: mtcollins1_endpoint, receipt: mtcollins1_run_37102391062_diagnostics, executed_at: mtcollins1_run_37102391062_sensors_by),
    ],
    transitions: [
      megarac_firmware_transition(
        endpoint: mtcollins1_endpoint,
        from: mtcollins1_firmware,
        to: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.45.3"),
        not_before: mtcollins1_reflash_not_before,
        not_after: mtcollins1_reflash_not_after,
        record: decl_ref(module_path: "gunbc.fleet.mtcollins_firmware_converge", decl_name: "credential_effect_of"),
      ),
    ],
  )
}
