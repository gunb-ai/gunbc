// THE HOST-SIDE MEMORY CENSUS OF MT. COLLINS UNIT 1, read from Linux running ON THE MACHINE across
// two captures, 2026-09-10T20:02:36Z and 2026-09-11T01:26:50Z.
//
// EVIDENCE BINDS PER SECTION, NOT PER MODULE, AND THAT IS A CORRECTION. This header used to say
// every field came from the first capture and its SOL transcript. That stopped being true the
// moment the module gained a second host capture, the attempt-3 artifacts and later live
// observations, and a global claim that has quietly become false is worse than no claim: a reader
// resolving the two declared digests would find them correct and still be reading fields those
// files never contained. So each observation below names the artifact it came from, and NO section
// inherits evidence by sitting in the same module as another.
//
// WHY THIS IS A SEPARATE MODULE FROM mtcollins1_access_observation. That module answers what the
// CONTROLLER is and what it admits out of band. This one answers what the HOST reports about its
// own installed memory, which is a different subject read over a different path — the controller
// only delivered the boot image. Merging them would let a BMC observation and a host observation
// share one raw_response, and a reader resolving that digest would fetch bytes that do not mention
// half the fields.
//
// THE TWO CAPTURES ARE ONE BOOT, AND THAT IS ESTABLISHED RATHER THAN ASSERTED. The SOL transcript
// carries the census file's own sha256, printed to the console by the script that produced it
// ("census complete: 247849 bytes sha256=9ec33e27…"), and that digest equals the digest of the
// committed census file. So the firmware-side channel map in the transcript and the Linux-side
// per-slot table in the census file are bound to the same power-on by evidence internal to the
// artifacts, not by the author's say-so about when each was taken.

data mtcollins1_census_artifact_path: NonEmptyStr = "artifacts/bmc/mtcollins1-hw-census.txt"

data mtcollins1_census_byte_count: ByteSize = byte_size(count: 247849)

// THE HOST COMPUTED THIS DIGEST ITSELF, BEFORE THE BYTES CROSSED THE NETWORK, and reported it to
// the serial console; the receiving side recomputed it after writing the file. The two agree, so
// the committed bytes are the bytes the machine produced and the transfer is not a trusted step.
// A digest taken only after arrival would have proved the file intact against nothing.
data mtcollins1_census_digest: ContentHash = Sha256Hash(Sha256Digest {
  hex: "9ec33e27b225848e2edc7454e0ff21b9081a19396f1a7205fe99529cf842bc8f",
})

data mtcollins1_census_sol_artifact_path: NonEmptyStr = "artifacts/bmc/mtcollins1-hw-census-sol.log"

data mtcollins1_census_sol_byte_count: ByteSize = byte_size(count: 240475)

data mtcollins1_census_sol_digest: ContentHash = Sha256Hash(Sha256Digest {
  hex: "1e0c4bc3ab7f635f5522c23832e6d5db33d7c3b07e9467cea1f9814167bd0de8",
})

// THE MANIFEST DIGEST IS OVER THE ORDERED BYTE CONCATENATION of the census file followed by the
// SOL transcript, which is stated because a digest whose derivation is not stated cannot be
// re-derived by a reader. `cat mtcollins1-hw-census.txt mtcollins1-hw-census-sol.log | sha256sum`.
data mtcollins1_census_evidence_manifest_digest: ContentHash = Sha256Hash(Sha256Digest {
  hex: "7b2970e319f0679297577c5de2289fa4edfda8975cd7af336d9c1c983e81f755",
})

data mtcollins1_census_observed_at: EpochMs = 1789070556000

// THE OPERATING SYSTEM THAT PRODUCED THE READINGS, named because dmidecode and EDAC are its
// interpretations of firmware tables rather than direct hardware reads, so which kernel asked
// matters to what a re-run would reproduce.
data mtcollins1_census_kernel: NonEmptyStr = "Linux 6.8.0-71-generic #71-Ubuntu SMP PREEMPT_DYNAMIC aarch64 (stock Ubuntu 24.04.3 live-server)"

// ── the two scalar readings the year-end plan's exit clause names ──────────────────────────────

// nproc, read on the machine. 160 is the expected figure for a dual-socket Altra Max at 80 cores
// per socket, and numactl reports 2 nodes of 80 CPUs each in the same capture, so the count is
// corroborated by a second reading rather than resting on one number.
data mtcollins1_nproc: HardwareThreadCount = hardware_thread_count(count: 160)

// MemTotal in kB as the kernel reports it. This is the OS-USABLE figure and is NOT the nominal
// population: 16 x 16 GiB is 256 GiB nominal, and the kernel reports about 249.9 GiB after
// firmware and kernel reservations. gunbc.fleet.fleet_intent already rules that conflating these
// two is a live error class, so the nominal figure is carried by the slot rows below and this row
// answers only for what the kernel could use.
data mtcollins1_memtotal_kb: Kibibyte = kibibyte(count: 262088084)

// ── what EDAC actually exposes, which is the load-bearing negative result ──────────────────────

// THE BRIEF THAT COMMISSIONED THIS CENSUS EXPECTED EDAC TO CARRY THE CHANNEL MAP, and it does not.
// That expectation is reasonable and is how EDAC behaves on platforms with a native
// memory-controller driver (skx_edac, amd64_edac), which enumerate csrow/channel nodes because the
// OS owns the controller's topology. This platform does not use such a driver.
//
// WHY, MECHANICALLY, AND THIS IS THE PART THAT MAKES IT STRUCTURAL RATHER THAN A GAP TO CHASE. The
// capture carries "GHES: APEI firmware first mode is enabled by APEI bit". Under ACPI APEI
// firmware-first, the firmware handles memory errors and hands the OS finished error records; the
// OS never enumerates the memory controller itself. ghes_edac therefore registers ONE synthetic
// controller and mirrors the SMBIOS Type 17 device list into it purely so a GHES error record has
// a DIMM to be attributed to. It is an error-reporting shim, not a topology driver.
//
// SO THE READINGS BELOW ARE A MEASURED PROPERTY OF THIS PLATFORM AND NOT A FAILED PROBE. An
// unprobed controller and a controller probed and found to expose no channel topology are
// different states, and only the second is authorable here. csrow_node_count is 0 because
// `find /sys/devices/system/edac` returned no path containing "csrow" — the absence is a counted
// reading over an enumerated tree, not an inference from a driver name.
// THE DRIVER IS A TYPED BINDING NOW, NOT A NAME. gunbc#11071 landed extdeps.linux.edac, which owns
// the question this observation used to answer in prose: what a driver binding can and cannot tell
// you about memory topology. So the receipt declares WHICH BINDING IT OBSERVED and lets that
// authority say what follows -- that under firmware-first the channel topology is absent on EVERY
// boot, which is the actionable half and was previously a sentence in a String row here.
//
// The string spelling is kept beside it because it is what /sys and dmesg actually rendered, and a
// reader resolving this receipt against the committed capture needs the bytes they will find there.
type MtCollins1EdacTopologyObservation {
  driver_binding: EdacDriverBinding
  driver_name: NonEmptyStr
  apei_firmware_first: Bool
  memory_controller_count: Nat
  csrow_node_count: Nat
  dimm_node_count: Nat
  corrected_error_count: Int
  uncorrected_error_count: Int
}

data mtcollins1_edac_topology: MtCollins1EdacTopologyObservation = MtCollins1EdacTopologyObservation {
  driver_binding: GhesEdac,
  driver_name: "ghes_edac",
  apei_firmware_first: true,
  memory_controller_count: 1,
  csrow_node_count: 0,
  dimm_node_count: 16,
  corrected_error_count: 0,
  uncorrected_error_count: 0,
}

// THE EDAC-CLEAN VERDICT, AND IT IS NOW LOAD-BACKED RATHER THAN A SNAPSHOT. The first capture read
// zero counters on a host up about 20 seconds, which bounds nothing: an idle machine that has
// touched almost no memory cannot demonstrate that its memory is sound. That reading was recorded
// here as EdacSnapshotClean precisely so it could not be quoted as a qualification.
//
// THE SECOND CAPTURE RUNS A NAMED WORKLOAD AND READS THE COUNTERS ON BOTH SIDES OF IT. Four 16 GiB
// tmpfs chunks (64 GiB total) are written from /dev/urandom, then hashed twice and the two passes
// compared. All 34 EDAC counters read 0 BEFORE and 0 AFTER; mc0's ce_count, ue_count,
// ce_noinfo_count and ue_noinfo_count are 0 on both sides.
//
// THE DIGEST COMPARISON IS AN INDEPENDENT CHECK AND THAT IS WHY IT IS THERE. EDAC counters are the
// memory controller's own account of itself; if the controller fails to notice a fault, its
// counters stay zero and a receipt reading only those counters would report clean. Hashing 64 GiB
// twice and requiring the digests to match tests the DATA rather than the controller's opinion of
// the data, so a silent corruption the ECC path missed would still surface as a mismatch. Both
// passes agreed.
//
// WHAT THIS STILL IS NOT. 64 GiB is a quarter of the installed 256 GiB, the passes take minutes
// rather than hours, and nothing here exercises thermal or long-duration failure modes. This
// discharges "Linux EDAC pass clean" for the hw-first-host clause; it does NOT discharge a soak,
// and the memtest86 pass recorded earlier in the intake remains the endurance evidence.
data mtcollins1_edac_clean_at_capture: Bool = true

data mtcollins1_edac_uptime_at_capture_seconds: Second = second(count: 20)

type MtCollins1MemoryWorkload {
  description: NonEmptyStr
  bytes_exercised: ByteSize
  write_exit_status: Int
  digest_stable_across_passes: Bool
  edac_corrected_before: Int
  edac_corrected_after: Int
  edac_uncorrected_before: Int
  edac_uncorrected_after: Int
}

data mtcollins1_memory_workload: MtCollins1MemoryWorkload = MtCollins1MemoryWorkload {
  description: "4 x 16 GiB tmpfs chunks seeded from /dev/urandom, sha256 hashed twice and the passes compared; EDAC tree read immediately before and immediately after.",
  bytes_exercised: byte_size(count: 68719476736),
  write_exit_status: 0,
  digest_stable_across_passes: true,
  edac_corrected_before: 0,
  edac_corrected_after: 0,
  edac_uncorrected_before: 0,
  edac_uncorrected_after: 0,
}

// ── the per-connector population, joined to the memory channel ─────────────────────────────────

// SMBIOS DOES NOT PRINT THE J-NUMBERS. Its DeviceLocator strings are "DIMM 1".."DIMM 16" for
// socket 0 and "Socket 1 DIMM 1".."Socket 1 DIMM 16" for socket 1 — recorded verbatim in
// smbios_locator — while the board silkscreen and Ampere's Getting Started Guide name the
// connectors J1..J32. The connector field carries the J-number under the identification stated at
// mtcollins1_connector_identification_basis, and the raw locator is carried beside it so a reader
// can see exactly what was read and what was inferred.
type MtCollins1SlotOccupancy
  = SlotPopulated {
      part_number: NonEmptyStr
      rank_count: Nat
      serial_number: NonEmptyStr
      configured_mts: MegatransfersPerSecond
    }
  | SlotEmpty

// OCCUPANCY IS A COPRODUCT BECAUSE AN EMPTY SLOT HAS NO PART, NO RANK AND NO SERIAL. A record with
// nullable module fields would make "populated with an unknown part" and "empty" the same shape,
// and every consumer would have to re-derive which it was holding. Here the distinction has no
// constructor to get wrong.
type MtCollins1SlotObservation {
  connector: Nat
  smbios_locator: NonEmptyStr
  processor_socket: Nat
  occupancy: MtCollins1SlotOccupancy
}

