// ── the firmware's own channel map, which is where the channel fact actually lives ─────────────

// THE ALTRA BOOT FIRMWARE PRINTS ITS DRAM TRAINING RESULT to the serial console before any OS
// exists, one line per populated module, naming socket, memory controller and slot-within-channel
// directly: "SK0 MC5 S0: RDIMM[ad:80] 16GB 2666 ECC 2R x8 RCD[32:86] HMA82GR7CJR8N-VK". This is
// the only channel-resolved reading available on this platform, and it is strictly better than
// what EDAC would have given: it names the controller AND the slot position within the channel,
// which a csrow tree does not.
//
// EVERY POPULATED MODULE SITS AT S0 — slot 0 of its channel — on all sixteen channels, so the unit
// is uniformly 1DPC and the sixteen empty connectors are the S1 position of each channel.
type MtCollins1FirmwareChannelBinding {
  processor_socket: Nat
  memory_controller: Nat
  slot_in_channel: Nat
  connector: Nat
  rank_count: Nat
  chip_width: BitWidth
  part_number: NonEmptyStr
}

