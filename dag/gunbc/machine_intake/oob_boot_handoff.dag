module gunbc.machine_intake_oob_boot_handoff

import std.types { Bool, NonEmptyStr, String }
import extdeps.bmc.ipmi
import extdeps.bmc.ipmi_boot_selection {
  IpmiBootSelection,
  ipmi_boot_selection_label,
}
import extdeps.bmc.access_profile {
  BmcAccessObservation,
  BmcAccessRoute,
}
import extdeps.bmc.capability {
  BmcFirmwareReleaseCapabilityRow,
  BmcFirmwareReleaseIdentity,
  CapabilityBootSourceOverride,
  CapabilityPowerControl,
  bmc_firmware_release_identity_eq,
  release_row_has_capability,
}

// THE OUT-OF-BAND BOOT-CONTROL ISSUER. This module performs exactly one control-plane transition:
// apply a typed IPMI boot selection, read back every load-bearing flag, and request the power
// action. It does NOT claim that the selected device executed. That terminal fact belongs to the
// delivered image's own receipt, whose producer runs on the host and cannot be substituted by a
// controller acknowledgement.
//
// The prior type called its positive arm BootHandoffCompleted as soon as the selector text matched
// and `chassis power cycle` exited zero. Execution on mtcollins1 showed that arm firing on every
// failed boot: the controller genuinely held `Force Boot from CD/DVD` and accepted the power action
// while parameter 5 simultaneously requested PC-compatible legacy boot on an aarch64 machine. The
// host then fell through to unanswered PXE and the UEFI shell. The precondition was real; the
// reported effect was not. This module now names only what it can observe: BootControlIssued.

type OobBootHandoffAdmission
  = OobHandoffAdmitted { route: BmcAccessRoute }
  | OobHandoffRouteUnobserved
  | OobHandoffBootSourceOverrideUnavailable
  | OobHandoffPowerControlUnavailable
  | OobHandoffFirmwareMismatch { observed: BmcFirmwareReleaseIdentity, capability: BmcFirmwareReleaseIdentity }

fn first_observed_boot_control_route(observation: BmcAccessObservation) -> BmcAccessRoute? {
  fold(
    observation.boot_control_routes,
    init: none,
    f: (acc, r) => match acc {
      Present { value: _ } => acc
      Absent => Present { value: r.route }
    },
  )
}

fn oob_boot_handoff_admission(
  observation: BmcAccessObservation,
  capability_row: BmcFirmwareReleaseCapabilityRow,
) -> OobBootHandoffAdmission {
  if bmc_firmware_release_identity_eq(a: observation.identity.firmware, b: capability_row.firmware) == false {
    OobHandoffFirmwareMismatch { observed: observation.identity.firmware, capability: capability_row.firmware }
  } else if release_row_has_capability(row: capability_row, cap: CapabilityBootSourceOverride) == false {
    OobHandoffBootSourceOverrideUnavailable
  } else {
    if release_row_has_capability(row: capability_row, cap: CapabilityPowerControl) == false {
      OobHandoffPowerControlUnavailable
    } else {
      match first_observed_boot_control_route(observation: observation) {
        Absent => OobHandoffRouteUnobserved
        Present { value: route } => OobHandoffAdmitted { route: route }
      }
    }
  }
}

fn oob_handoff_is_admitted(admission: OobBootHandoffAdmission) -> Bool {
  match admission {
    OobHandoffAdmitted { route: _ } => true
    OobHandoffRouteUnobserved => false
    OobHandoffBootSourceOverrideUnavailable => false
    OobHandoffPowerControlUnavailable => false
    OobHandoffFirmwareMismatch { observed: _, capability: _ } => false
  }
}

// WHAT THE CONTROLLER ATTEMPT ESTABLISHED. No arm here says a boot completed. BootControlIssued
// establishes only that the complete typed selection read back and the power command was accepted.
// A caller that needs a boot postcondition must join this to host-produced execution evidence.
type OobBootControlOutcome
  = BootControlIssued { selection: IpmiBootSelection }
  | BootSelectionRefused { selection: IpmiBootSelection }
  | BootSelectionNotApplied { selection: IpmiBootSelection, readback: String }
  | BootSelectionUnverifiable { selection: IpmiBootSelection, readback: String }
  | BootSelectionFlagInvalid { selection: IpmiBootSelection, readback: String }
  | BootSelectionFirmwareModeMismatch { selection: IpmiBootSelection, readback: String }
  | BootSelectionPersistenceMismatch { selection: IpmiBootSelection, readback: String }
  | PowerCycleRefused { selection: IpmiBootSelection }
  | BootControlNotAdmitted { admission: OobBootHandoffAdmission }

// PARAMETER 5 IS A PRODUCT TYPE, NOT A SELECTOR STRING. The read-back has four independent axes:
// validity, device, firmware mode, and persistence. All four must agree before the power action is
// reachable. The order is deliberate: invalid flags dominate every apparent value; then the
// selector, mode and persistence each name the first disagreement a retry must repair.
type BootReadbackVerdict
  = BootReadbackConfirmed
  | BootReadbackFlagInvalid
  | BootReadbackSelectorMismatch
  | BootReadbackFirmwareModeMismatch
  | BootReadbackPersistenceMismatch

fn boot_readback_verdict(readback: String, selection: IpmiBootSelection) -> BootReadbackVerdict {
  if readback |> contains(selection.expected_flag_rendering as String) == false {
    BootReadbackFlagInvalid
  } else if readback |> contains(selection.expected_device_rendering as String) == false {
    BootReadbackSelectorMismatch
  } else if readback |> contains(selection.expected_mode_rendering as String) == false {
    BootReadbackFirmwareModeMismatch
  } else if readback |> contains(selection.expected_persistence_rendering as String) == false {
    BootReadbackPersistenceMismatch
  } else {
    BootReadbackConfirmed
  }
}

// THE POWER ACTION IS REACHABLE ONLY THROUGH THE FOUR-AXIS CONFIRMED ARM. Its positive result is
// deliberately named ISSUED rather than completed: a controller response cannot testify that the
// host loaded an image, and SOL is not promoted into that role either. The delivered artifact's
// own receipt is the postcondition producer.
func oob_power_cycle_after_confirmed_selection(
  bmc_host: NonEmptyStr,
  username: NonEmptyStr,
  password_file: NonEmptyStr,
  selection: IpmiBootSelection,
  power_action: NonEmptyStr,
) -> OobBootControlOutcome
  uses net: std.resources.Network
{
  cycle = diagnostic.ipmi.Tool.ChassisPowerControl(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
    action: power_action,
  )
  return if cycle.success {
    BootControlIssued { selection: selection }
  } else {
    PowerCycleRefused { selection: selection }
  }
}

// SELECT, VERIFY THE WHOLE PARAMETER, THEN RESTART. The selection is sole-constructor upstream:
// current aarch64 callers can obtain only UEFI + one-shot values, so the executed failure state
// `(Aarch64, Legacy, Cdrom)` cannot be authored and no raw `options=` string crosses this boundary.
func oob_boot_control_issue(
  observation: BmcAccessObservation,
  capability_row: BmcFirmwareReleaseCapabilityRow,
  username: NonEmptyStr,
  password_file: NonEmptyStr,
  selection: IpmiBootSelection,
  power_action: NonEmptyStr,
) -> OobBootControlOutcome
  uses net: std.resources.Network
{
  let admission = oob_boot_handoff_admission(observation: observation, capability_row: capability_row)
  if oob_handoff_is_admitted(admission: admission) == false {
    return BootControlNotAdmitted { admission: admission }
  }
  let bmc_host = observation.endpoint.host

  set = diagnostic.ipmi.BootSelection.Set(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
    selection: selection,
  )
  if set.success == false {
    return BootSelectionRefused { selection: selection }
  }

  readback = diagnostic.ipmi.Tool.ChassisBootParamGet(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
    parameter: "5",
  )
  if readback.success == false {
    return BootSelectionUnverifiable { selection: selection, readback: readback.stdout }
  }

  return match boot_readback_verdict(readback: readback.stdout, selection: selection) {
    BootReadbackFlagInvalid =>
      BootSelectionFlagInvalid { selection: selection, readback: readback.stdout }
    BootReadbackSelectorMismatch =>
      BootSelectionNotApplied { selection: selection, readback: readback.stdout }
    BootReadbackFirmwareModeMismatch =>
      BootSelectionFirmwareModeMismatch { selection: selection, readback: readback.stdout }
    BootReadbackPersistenceMismatch =>
      BootSelectionPersistenceMismatch { selection: selection, readback: readback.stdout }
    BootReadbackConfirmed =>
      oob_power_cycle_after_confirmed_selection(
        bmc_host: bmc_host,
        username: username,
        password_file: password_file,
        selection: selection,
        power_action: power_action,
      )
  }
}

fn oob_boot_control_outcome_label(outcome: OobBootControlOutcome) -> NonEmptyStr {
  match outcome {
    BootControlIssued { selection: s } =>
      join(["issued:", ipmi_boot_selection_label(selection: s) as String], "") as NonEmptyStr
    BootSelectionRefused { selection: s } =>
      join(["selection-refused:", ipmi_boot_selection_label(selection: s) as String], "") as NonEmptyStr
    BootSelectionNotApplied { selection: s, readback: _ } =>
      join(["selector-mismatch:", ipmi_boot_selection_label(selection: s) as String], "") as NonEmptyStr
    BootSelectionUnverifiable { selection: s, readback: _ } =>
      join(["readback-unverifiable:", ipmi_boot_selection_label(selection: s) as String], "") as NonEmptyStr
    BootSelectionFlagInvalid { selection: s, readback: _ } =>
      join(["flag-invalid:", ipmi_boot_selection_label(selection: s) as String], "") as NonEmptyStr
    BootSelectionFirmwareModeMismatch { selection: s, readback: _ } =>
      join(["firmware-mode-mismatch:", ipmi_boot_selection_label(selection: s) as String], "") as NonEmptyStr
    BootSelectionPersistenceMismatch { selection: s, readback: _ } =>
      join(["persistence-mismatch:", ipmi_boot_selection_label(selection: s) as String], "") as NonEmptyStr
    PowerCycleRefused { selection: s } =>
      join(["power-refused:", ipmi_boot_selection_label(selection: s) as String], "") as NonEmptyStr
    BootControlNotAdmitted { admission: _ } => "not-admitted"
  }
}
