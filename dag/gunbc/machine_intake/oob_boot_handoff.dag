module gunbc.machine_intake_oob_boot_handoff

import std.decl_ref { decl_ref }
import std.types { Bool, Int, List, NonEmptyStr, String }
import std.measure { Second, second, second_count }
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }
import extdeps.bmc.ipmi_chassis_control {
  ChassisPowerObservation,
  ChassisPowerRead,
  ChassisStatusUndecodable,
  ChassisUnreadable,
  IpmiChassisControlAction,
  IpmiChassisHardReset,
  IpmiChassisPowerCycle,
  IpmiChassisPowerDown,
  IpmiChassisPowerUp,
  chassis_observation,
  ipmi_chassis_control_verb,
}
import extdeps.bmc.ipmi
import extdeps.bmc.ipmi_boot_selection {
  IpmiBootSelection,
  ipmi_boot_device_label,
  ipmi_boot_selection_options_token,
  ipmi_boot_expected_flag_rendering,
  ipmi_boot_expected_device_rendering,
  ipmi_boot_expected_mode_rendering,
  ipmi_boot_expected_persistence_rendering,
}
import extdeps.bmc.access_profile {
  BmcAccessObservation,
  BmcAccessRoute,
}
import extdeps.bmc.capability {
  BmcFirmwareReleaseCapabilityRow,
  BmcFirmwareReleaseIdentity,
  CapabilityBootSourceOverride,
  CapabilityPowerControl,
  bmc_firmware_release_identity_eq,
  release_row_has_capability,
}

// THE OUT-OF-BAND BOOT HANDOFF: the operation a converge program performs against a host it cannot
// reach THROUGH. Every existing transport in this repository — gunbc.host_effect LocalShell and
// FleetSsh — talks to a machine via the operating system being installed, so neither can act on a
// host that has none. This module models the arm that acts on the CONTROLLER instead, which is the
// only arm that can move a bare host toward serving.
//
// WHY THIS IS A SEPARATE REALIZATION AND NOT A FORK OF THE IN-HOST PATH (DESIGN §3). Reaching a host
// over its BMC and reaching it over ssh are two realizations of ONE interface — drive this host
// toward its desired state — so the choice between them is dispatch, and dispatch sits peripheral.
// What makes them genuinely different is not the wire protocol but WHAT IS CONVERGED: an in-host arm
// mutates a persistent root, while this arm sets a boot chain and restarts. For a diskless host the
// second is the whole of convergence, because there is no persistent root to mutate and therefore
// nowhere for drift to live.
//
// WHAT THIS MODULE DOES NOT DO, stated because the omission is the design and not an unfinished
// edge. It does not serve the boot artifacts, it does not decide which image a host should run, and
// it does not observe what booted. It performs one transition — select boot source, verify the
// selection took, restart — and every other phase is a separate authority. A module that also served
// the image would fuse artifact delivery into boot control, and the first host wanting a different
// delivery would have to fork it.
//
// WHETHER A CONTROLLER MAY BE DRIVEN AT ALL is decided from its capability row rather than from its
// route list. A route says the controller ANSWERED over that transport; a capability says a WRITE
// through it was observed to take effect. Only the second licenses driving a host, and the
// distinction is load-bearing here: the Mt. Collins unit answers Redfish paths with 404 while
// serving IPMI, so a route-shaped admission would have to enumerate absent Redfish locators, and a
// capability-shaped one simply reads what was measured.
type OobBootHandoffAdmission
  = OobHandoffAdmitted { route: BmcAccessRoute }
  | OobHandoffRouteUnobserved
  | OobHandoffBootSourceOverrideUnavailable
  | OobHandoffPowerControlUnavailable
  | OobHandoffFirmwareMismatch { observed: BmcFirmwareReleaseIdentity, capability: BmcFirmwareReleaseIdentity }

// The first boot-control route the observation carries, as an Option. The list is folded rather than
// pattern-matched because the surface grammar admits no list patterns — measured, not assumed: a
// match with [] and [first, ..] arms fails to parse with "expected FatArrow, found LBracket". This
// is the same fold shape gunbc.machine_intake_access control_route_evidence_unnamed uses over the
// same field, so the idiom is the corpus's rather than this module's.
fn first_observed_boot_control_route(observation: BmcAccessObservation) -> BmcAccessRoute? {
  fold(
    observation.boot_control_routes,
    init: none,
    f: (acc, r) => match acc {
      Present { value: _ } => acc
      Absent => Present { value: r.route }
    },
  )
}

// The refusals are SEPARATE ARMS rather than one not-capable reason, because they have different
// owners and different repairs. A missing boot-source override is a firmware capability question
// answered by the catalog; a missing power control is the same; an unobserved route means nobody has
// probed this controller yet and the repair is an intake attempt, not a catalog edit. Collapsing
// them would be the state-space conflation DESIGN's failure-mode list names — one symbol standing
// for conditions whose remedies point at different people.
fn oob_boot_handoff_admission(
  observation: BmcAccessObservation,
  capability_row: BmcFirmwareReleaseCapabilityRow,
) -> OobBootHandoffAdmission {
  if bmc_firmware_release_identity_eq(a: observation.identity.firmware, b: capability_row.firmware) == false {
    OobHandoffFirmwareMismatch { observed: observation.identity.firmware, capability: capability_row.firmware }
  } else if release_row_has_capability(row: capability_row, cap: CapabilityBootSourceOverride) == false {
    OobHandoffBootSourceOverrideUnavailable
  } else {
    if release_row_has_capability(row: capability_row, cap: CapabilityPowerControl) == false {
      OobHandoffPowerControlUnavailable
    } else {
      match first_observed_boot_control_route(observation: observation) {
        Absent => OobHandoffRouteUnobserved
        Present { value: route } => OobHandoffAdmitted { route: route }
      }
    }
  }
}

// WHETHER AN ADMISSION ADMITS, as its own fn so the handoff's guard is one named question rather
// than a match inlined into an effect sequence.
fn oob_handoff_is_admitted(admission: OobBootHandoffAdmission) -> Bool {
  match admission {
    OobHandoffAdmitted { route: _ } => true
    OobHandoffRouteUnobserved => false
    OobHandoffBootSourceOverrideUnavailable => false
    OobHandoffPowerControlUnavailable => false
    OobHandoffFirmwareMismatch { observed: _, capability: _ } => false
  }
}

// WHAT A HANDOFF ATTEMPT CONCLUDED. BootSelectionNotApplied is the arm this type exists for: the
// controller accepted chassis bootdev and boot parameter 5 did NOT read back the requested device.
// Without it, a handoff whose override silently failed would restart the host into whatever it was
// going to boot anyway and report success — the fabricated-plausible-output failure DESIGN §5
// forbids, in the one place where it costs a whole install cycle to discover.
//
// The three power arms are distinct from BootSelectionNotApplied even though all leave the host in
// the wrong state, because the boot selection has by then been APPLIED: the controller is holding a
// next-boot override that nothing has consumed. A caller that retries must know which it is looking
// at, since one needs the selection re-applied and the others do not. Among themselves they differ
// in what was written: PowerStateReadFailed wrote no power action (the pre-read established no
// state to select from), PowerCommandRefused had its request rejected, and PowerCommandAcceptedNoTransition
// had its request ACCEPTED while the chassis never showed the transition within the bound.
type OobBootHandoffOutcome
  = BootControlIssued { selected: NonEmptyStr, power: ObservedPowerTransition }
  | BootSelectionRefused
  | BootSelectionNotApplied { requested: NonEmptyStr, readback: String }
  | BootSelectionUnverifiable { requested: NonEmptyStr, readback: String }
  | BootSelectionFlagInvalid { requested: NonEmptyStr, readback: String }
  | BootSelectionNotOneShot { requested: NonEmptyStr, readback: String }
  | BootSelectionFirmwareMismatch { requested: NonEmptyStr, readback: String }
  | PowerStateReadFailed { selected: NonEmptyStr, observed_state: ChassisPowerObservation }
  | PowerCommandRefused { selected: NonEmptyStr, action: IpmiChassisControlAction }
  | PowerCommandAcceptedNoTransition { selected: NonEmptyStr, action: IpmiChassisControlAction, observed_state: ChassisPowerObservation }
  | BootHandoffNotAdmitted { admission: OobBootHandoffAdmission }

type BootReadbackVerdict
  = BootReadbackConfirmed
  | BootReadbackFlagInvalid
  | BootReadbackNotOneShot
  | BootReadbackFirmwareMismatch
  | BootReadbackSelectorAbsent

data ipmi_boot_flag_invalid_rendering: NonEmptyStr = "Boot Flag Invalid"

fn boot_readback_verdict(readback: String, selection: IpmiBootSelection) -> BootReadbackVerdict {
  if readback |> contains(ipmi_boot_flag_invalid_rendering as String) {
    BootReadbackFlagInvalid
  } else if !(readback |> contains(ipmi_boot_expected_flag_rendering(selection: selection) as String)) {
    BootReadbackFlagInvalid
  } else if !(readback |> contains(ipmi_boot_expected_persistence_rendering(selection: selection) as String)) {
    BootReadbackNotOneShot
  } else if !(readback |> contains(ipmi_boot_expected_mode_rendering(selection: selection) as String)) {
    BootReadbackFirmwareMismatch
  } else if readback |> contains(ipmi_boot_expected_device_rendering(selection: selection) as String) {
    BootReadbackConfirmed
  } else {
    BootReadbackSelectorAbsent
  }
}

// WHAT THE CHASSIS WAS SEEN TO DO, carried on BootControlIssued so the success arm states an
// observed transition rather than an accepted command. It is still a control-plane fact about the
// chassis, not evidence of what booted (gunbc.recurring_failure_mode
// control_plane_acknowledgement_minted_as_effect).
type ObservedPowerTransition
  = PoweredOn
  | PowerCycled
  | PoweredOff
  | HostReset

fn observed_power_transition(action: IpmiChassisControlAction) -> ObservedPowerTransition {
  match action {
    IpmiChassisPowerUp => PoweredOn
    IpmiChassisPowerCycle => PowerCycled
    IpmiChassisPowerDown => PoweredOff
    IpmiChassisHardReset => HostReset
  }
}

// THE POWER ACTION IS SELECTED FROM OBSERVED STATE, NOT CARRIED AS A CONSTANT. IPMI v2.0 §28.3
// makes power cycle a no-op on a host in S4/S5, and run 36023602469 is the receipt: Mt. Collins
// was off, `chassis power cycle` exited 0, nothing happened, and BootControlIssued was minted on
// that exit alone. So the handoff reads §28.2 chassis status first: off selects power up; on
// selects the caller's running_restart verb (which verb restarts a RUNNING host is per-host policy,
// evidenced on that host's SEL). A read that established no power state refuses before any power
// write, because choosing a verb over an unknown state is the same bet that failed.
type PowerActionSelection
  = PowerActionSelected { action: IpmiChassisControlAction }
  | PowerActionUnselectable { observed_state: ChassisPowerObservation }

fn oob_power_action_selection(
  observed: ChassisPowerObservation,
  running_restart: IpmiChassisControlAction,
) -> PowerActionSelection
{
  match observed {
    ChassisPowerRead { power_on: on } => if on {
      PowerActionSelected { action: running_restart }
    } else {
      PowerActionSelected { action: IpmiChassisPowerUp }
    }
    ChassisStatusUndecodable { cause: _ } => PowerActionUnselectable { observed_state: observed }
    ChassisUnreadable => PowerActionUnselectable { observed_state: observed }
  }
}

// WHAT A READ-BACK OF §28.2 POWER STATE CAN WITNESS FOR EACH ACTION. Exit 0 from Chassis Control is
// the controller accepting a request, never evidence the chassis moved (DESIGN §5). Up must be
// observed on; down observed off; a cycle observed off and THEN on, because an on reading after a
// cycle is equally what a controller that ignored it would show. A hard reset leaves power on
// throughout, so power state cannot discriminate it at all, and that is a typed refusal rather
// than an acceptance nobody could have falsified.
type PowerReadbackExpectation
  = ExpectPowerOn
  | ExpectPowerOff
  | ExpectPowerOffThenOn { off_seen: Bool }
  | PowerStateCannotWitness

fn power_readback_expectation(action: IpmiChassisControlAction) -> PowerReadbackExpectation {
  match action {
    IpmiChassisPowerUp => ExpectPowerOn
    IpmiChassisPowerDown => ExpectPowerOff
    IpmiChassisPowerCycle => ExpectPowerOffThenOn { off_seen: false }
    IpmiChassisHardReset => PowerStateCannotWitness
  }
}

type PowerReadbackStep
  = PowerTransitionObserved
  | PowerTransitionPending { expectation: PowerReadbackExpectation }

// ONE SAMPLE AGAINST THE EXPECTATION. Pure, so the bounded poll below and the witnesses decide
// through the same fold; an unreadable or undecodable sample advances nothing.
fn power_readback_step(expectation: PowerReadbackExpectation, sample: ChassisPowerObservation) -> PowerReadbackStep {
  match sample {
    ChassisPowerRead { power_on: on } => match expectation {
      ExpectPowerOn => if on { PowerTransitionObserved } else { PowerTransitionPending { expectation: expectation } }
      ExpectPowerOff => if on { PowerTransitionPending { expectation: expectation } } else { PowerTransitionObserved }
      ExpectPowerOffThenOn { off_seen: seen } => if !on {
        PowerTransitionPending { expectation: ExpectPowerOffThenOn { off_seen: true } }
      } else if seen {
        PowerTransitionObserved
      } else {
        PowerTransitionPending { expectation: expectation }
      }
      PowerStateCannotWitness => PowerTransitionPending { expectation: expectation }
    }
    ChassisStatusUndecodable { cause: _ } => PowerTransitionPending { expectation: expectation }
    ChassisUnreadable => PowerTransitionPending { expectation: expectation }
  }
}

type PowerReadback
  = PowerReadbackObserved
  | PowerReadbackExhausted { observed_state: ChassisPowerObservation }

// THE BOUND. A §28.3 cycle holds power off for at least one second (the Set Power Cycle Interval
// default), and a ChassisStatus round trip over lanplus is itself about a second, so one-second
// spacing samples every off window the spec admits. Sixty samples bounds the read-back; the
// allowance a boot step's timeout must carry for it is derived below, not re-spelled by callers.
data oob_power_readback_samples: Int = 60

data oob_power_readback_interval: Second = second(count: 1)

data oob_power_readback_read_ceiling: Second = second(count: 2)

fn oob_power_readback_allowance() -> Second {
  second(count: oob_power_readback_samples
    * ((second_count(s: oob_power_readback_interval) + second_count(s: oob_power_readback_read_ceiling)) as Int)
    + (second_count(s: oob_power_readback_read_ceiling) as Int))
}

fn read_chassis_power(bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr) -> ChassisPowerObservation {
  status = diagnostic.ipmi.Tool.ChassisStatus(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
  )
  return chassis_observation(success: status.success, stdout: status.stdout)
}

fn oob_power_readback_poll(
  bmc_host: NonEmptyStr,
  username: NonEmptyStr,
  password_file: NonEmptyStr,
  action: IpmiChassisControlAction,
  expectation: PowerReadbackExpectation,
  samples_remaining: Int,
) -> PowerReadback
{
  let sample = read_chassis_power(bmc_host: bmc_host, username: username, password_file: password_file)
  return match power_readback_step(expectation: expectation, sample: sample) {
    PowerTransitionObserved => PowerReadbackObserved
    PowerTransitionPending { expectation: next } =>
      if samples_remaining <= 1 {
        PowerReadbackExhausted { observed_state: sample }
      } else {
        oob_power_readback_continue(
          bmc_host: bmc_host,
          username: username,
          password_file: password_file,
          action: action,
          expectation: next,
          samples_remaining: samples_remaining - 1,
        )
      }
  }
}

fn oob_power_readback_continue(
  bmc_host: NonEmptyStr,
  username: NonEmptyStr,
  password_file: NonEmptyStr,
  action: IpmiChassisControlAction,
  expectation: PowerReadbackExpectation,
  samples_remaining: Int,
) -> PowerReadback
{
  let waited = sleep_delay_seconds_second_carrier_projection(duration: oob_power_readback_interval)
  return oob_power_readback_poll(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
    action: action,
    expectation: expectation,
    samples_remaining: samples_remaining,
  )
}

fn oob_power_action_after_confirmed_selection(
  bmc_host: NonEmptyStr,
  username: NonEmptyStr,
  password_file: NonEmptyStr,
  device: NonEmptyStr,
  running_restart: IpmiChassisControlAction,
) -> OobBootHandoffOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_oob_boot_handoff", decl_name: "oob_boot_handoff"),
  ]
{
  let before = read_chassis_power(bmc_host: bmc_host, username: username, password_file: password_file)
  return match oob_power_action_selection(observed: before, running_restart: running_restart) {
    PowerActionUnselectable { observed_state: o } => PowerStateReadFailed { selected: device, observed_state: o }
    PowerActionSelected { action: action } =>
      oob_power_actuate_and_read_back(
        bmc_host: bmc_host,
        username: username,
        password_file: password_file,
        device: device,
        action: action,
      )
  }
}

fn oob_power_actuate_and_read_back(
  bmc_host: NonEmptyStr,
  username: NonEmptyStr,
  password_file: NonEmptyStr,
  device: NonEmptyStr,
  action: IpmiChassisControlAction,
) -> OobBootHandoffOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_oob_boot_handoff", decl_name: "oob_power_action_after_confirmed_selection"),
  ]
{
  control = diagnostic.ipmi.Tool.ChassisPowerControl(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
    action: ipmi_chassis_control_verb(action: action),
  )
  if control.success == false {
    return PowerCommandRefused { selected: device, action: action }
  }
  return match oob_power_readback_poll(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
    action: action,
    expectation: power_readback_expectation(action: action),
    samples_remaining: oob_power_readback_samples,
  ) {
    PowerReadbackObserved => BootControlIssued { selected: device, power: observed_power_transition(action: action) }
    PowerReadbackExhausted { observed_state: o } =>
      PowerCommandAcceptedNoTransition { selected: device, action: action, observed_state: o }
  }
}

// THE HANDOFF ITSELF, and the ordering is the point: SELECT, VERIFY, THEN RESTART. A restart issued
// before the selection is verified converts a silently-refused override into a wasted boot cycle
// that reports success, which is the one failure this whole module exists to make unrepresentable.
// So the power cycle is reachable only through the arm where the read-back already matched.
//
// THE CREDENTIAL IS TAKEN AS A FILE PATH, NOT AS A SECRET VALUE. This func does not read, decrypt or
// materialize anything: it receives the path to a file some caller wrote and hands that path to
// ipmitool. Materialization is a separate concern with its own authority (gunbc.auth.materialized_secret),
// and a func that both resolved a secret and drove a controller would fuse two facts that rotate on
// different clocks — which matters here because the operator's ruling is that the factory credential
// is rotated DURING converge, so the value behind this path changes mid-program while the path does not.
fn oob_boot_handoff(
  observation: BmcAccessObservation,
  capability_row: BmcFirmwareReleaseCapabilityRow,
  username: NonEmptyStr,
  password_file: NonEmptyStr,
  selection: IpmiBootSelection,
  running_restart: IpmiChassisControlAction,
) -> OobBootHandoffOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_actuate", decl_name: "mtcollins1_drive_handoff"),
    decl_ref(module_path: "gunbc.host_reset_return_run", decl_name: "host_reset_return_issue_and_watch"),
  ]
{
  let admission = oob_boot_handoff_admission(observation: observation, capability_row: capability_row)
  if oob_handoff_is_admitted(admission: admission) == false {
    return BootHandoffNotAdmitted { admission: admission }
  }
  let bmc_host = observation.endpoint.host
  let device = ipmi_boot_device_label(device: selection.device)

  set = diagnostic.ipmi.Tool.ChassisBootDevWithOptions(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
    device: device,
    options: ipmi_boot_selection_options_token(selection: selection),
  )
  if set.success == false {
    return BootSelectionRefused
  }

  readback = diagnostic.ipmi.Tool.ChassisBootParamGet(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
    parameter: "5",
  )
  if readback.success == false {
    return BootSelectionUnverifiable { requested: device, readback: readback.stdout }
  }

  return match boot_readback_verdict(readback: readback.stdout, selection: selection) {
    BootReadbackFlagInvalid => BootSelectionFlagInvalid { requested: device, readback: readback.stdout }
    BootReadbackNotOneShot => BootSelectionNotOneShot { requested: device, readback: readback.stdout }
    BootReadbackFirmwareMismatch => BootSelectionFirmwareMismatch { requested: device, readback: readback.stdout }
    BootReadbackSelectorAbsent => BootSelectionNotApplied { requested: device, readback: readback.stdout }
    BootReadbackConfirmed =>
      oob_power_action_after_confirmed_selection(
        bmc_host: bmc_host,
        username: username,
        password_file: password_file,
        device: device,
        running_restart: running_restart,
      )
  }
}
