module gunbc.machine_intake_megarac_sensor_observation

import std.types { Bool, Int, List, NonEmptyStr, String }
import gunbc.machine_intake_mtcollins1_power_on_account { BmcAnomaly, SensorNotNominal, SensorLineWithoutReadingNotNominal, SocketSensorsAbsent }
import std.algebra { trim }
import v2.std.optional { Present }
import v2.std.algebra { filter }
import extdeps.bmc.ipmi_sdr { SdrLineResult, SdrLineDecoded, SdrLineUnstructured, SdrTypeLine }
import extdeps.bmc.capability { BmcFirmwareReleaseIdentity, bmc_firmware_release_identity_eq }
import extdeps.bmc.megarac { megarac_firmware_0_32 }
import product.placement_supply { HostIdentity }
import gunbc.megarac_managed_host { AdmittedMegaRacHost }
import gunbc.megarac_operation_standing { MegaRacSdrSocketNaming, MegaRacVirtualMediaAttach, MegaRacKvmCanvasStill }

// WHAT A MEGARAC CONTROLLER'S SENSOR TABLE SAYS ABOUT EACH SOCKET, from one `sdr elist` read
// (extdeps.bmc.ipmi SdrElistAuthenticatedCached, decoded by extdeps.bmc.ipmi_sdr). This is the
// per-socket channel that needs IPMI alone: gunbc.machine_intake_mtcollins1_access_observation
// records that the Mt. Collins MegaRAC answers 404 at the Redfish service root itself.
//
// WHICH SOCKET A SENSOR BELONGS TO ON THIS BUILD IS ITS NAME, NOT ITS ENTITY. The IPMI entity
// field would be the specification's answer, and the Foxconn Mt. Collins build 0.32 does not give it:
// in its own `sdr elist` (gunbc.machine_intake_mtcollins1_32dimm_bringup_observation
// mtcollins1_sdr_capture) CPU0_0V75_PCP and CPU1_0V75_PCP are both entity 19.0 and CPU0_Hightemp and
// CPU1_Hightemp both 3.1, while each of its 38 CPU0_ and 38 CPU1_ sensors carries its socket in a
// "CPU<n>_" name prefix. That prefix is that build's naming, observed in that capture and in no
// specification, so it is keyed to the build here and read only through a naming minted for an
// admitted host (gunbc.megarac_managed_host, operation MegaRacSdrSocketNaming), and a sensor without it
// belongs to no socket. Another build's naming is unread, and unread is a refusal, not "CPU".

data megarac_sdr_socket_prefix_0_32: String = "CPU"

// THE SOCKET NAMING OF ONE ADMITTED CONTROLLER. sole_constructor, minted only below, so a decode cannot
// be handed a prefix the controller's build was never read to use.
type MegaRacSdrSocketNamingRule sole_constructor {
  host: HostIdentity
  firmware: BmcFirmwareReleaseIdentity
  prefix: String
}

type MegaRacSdrSocketNamingStanding
  = SdrSocketNamingBound { naming: MegaRacSdrSocketNamingRule }
  | SdrSocketNamingRefused { reason: NonEmptyStr }

fn megarac_sdr_socket_naming(host: AdmittedMegaRacHost) -> MegaRacSdrSocketNamingStanding {
  match host.operation {
    MegaRacSdrSocketNaming =>
      if bmc_firmware_release_identity_eq(a: host.firmware, b: megarac_firmware_0_32) {
        SdrSocketNamingBound { naming: MegaRacSdrSocketNamingRule { host: host.binding.host.host, firmware: host.firmware, prefix: megarac_sdr_socket_prefix_0_32 } }
      } else {
        SdrSocketNamingRefused { reason: concat("no SDR socket naming is read for MegaRAC firmware ", host.firmware.raw_version as String) as NonEmptyStr }
      }
    MegaRacVirtualMediaAttach => SdrSocketNamingBound { naming: MegaRacSdrSocketNamingRule { host: host.binding.host.host, firmware: host.firmware, prefix: megarac_sdr_socket_prefix_0_32 } }
    MegaRacKvmCanvasStill => SdrSocketNamingRefused { reason: "the MegaRAC host was admitted for another operation, not SDR socket naming" }
  }
}

fn megarac_sensor_socket(naming: MegaRacSdrSocketNamingRule, name: String) -> Int? {
  let prefix = naming.prefix
  if !starts_with(s: name, prefix: prefix) { none } else {
    let rest = join(split(s: name, delimiter: prefix).skip(n: 1), prefix)
    let parts = split(s: rest, delimiter: "_")
    let head = match parts.first() { Absent => "" Present { value: h } => h }
    if count(parts) < 2 || head == "" { none } else { parse_int(s: head) }
  }
}

fn decoded_sensor_lines(lines: List<SdrLineResult>) -> List<SdrTypeLine> {
  flat_map(lines, r => match r { SdrLineDecoded { line: l } => [l] SdrLineUnstructured { text: _ } => [] })
}

fn megarac_socket_sensor_lines(naming: MegaRacSdrSocketNamingRule, lines: List<SdrLineResult>, socket: Int) -> List<SdrTypeLine> {
  filter(decoded_sensor_lines(lines: lines), l => match megarac_sensor_socket(naming: naming, name: l.name as String) { Present { value: k } => k == socket Absent => false })
}

fn pipe_field(text: String, index: Int) -> String {
  trim(match split(s: text, delimiter: "|").skip(n: index).first() { Absent => "" Present { value: f } => f })
}

// A DISCRETE SENSOR PRINTS AN EMPTY READING FIELD ("CPU1_CPU_Status | DAh | ok | 3.2 |"), which
// extdeps.bmc.ipmi_sdr refuses to decode rather than fill. Its line still names its socket, so the
// per-socket view carries it verbatim beside the decoded ones instead of losing it.
fn megarac_socket_unstructured_lines(naming: MegaRacSdrSocketNamingRule, lines: List<SdrLineResult>, socket: Int) -> List<String> {
  flat_map(lines, r => match r {
    SdrLineDecoded { line: _ } => []
    SdrLineUnstructured { text: t } => match megarac_sensor_socket(naming: naming, name: pipe_field(text: t, index: 0)) {
      Present { value: k } => if k == socket { [trim(t)] } else { [] }
      Absent => []
    }
  })
}


// PER SOCKET, TWO KINDS OF ANOMALY. A socket sensor whose status is not "ok" is carried as the tool
// printed it ("ns" is no reading), decoded or not, for every socket the board's sensor names cover;
// and a socket with NO sensor in the table at all is an anomaly ONLY when the attempt's receipt
// EXPECTS that socket -- with its CPU removed, an empty socket's missing sensors are the expected
// state, and with no recorded expectation absence judges nothing (law 6). Either on socket 1 beside a clean socket 0 is what the socket-1 investigation
// asked the BMC for (gunbc.machine_intake_mtcollins1_socket1_investigation_observation
// mtcollins1_socket1_open_hypotheses, the VRM row). No status or reading is interpreted further; the
// power-on fold (gunbc.machine_intake_mtcollins1_power_on_account) places them on the chassis power-on stage.
fn megarac_sensor_anomalies(naming: MegaRacSdrSocketNamingRule, lines: List<SdrLineResult>, sockets: List<Int>, expected: List<Int>?) -> List<BmcAnomaly> {
  flat_map(sockets, k => {
    let decoded = megarac_socket_sensor_lines(naming: naming, lines: lines, socket: k)
    let discrete = megarac_socket_unstructured_lines(naming: naming, lines: lines, socket: k)
    if count(decoded) == 0 && count(discrete) == 0 {
      match expected { Present { value: ks } => if any(ks, j => j == k) { [SocketSensorsAbsent { socket: k }] } else { [] } Absent => [] }
    } else {
      concat(map(filter(decoded, l => (l.status as String) != "ok"), l => SensorNotNominal { line: l }),
        map(filter(discrete, t => pipe_field(text: t, index: 2) != "ok" && t != ""), t => SensorLineWithoutReadingNotNominal { text: t as NonEmptyStr }))
    }
  })
}

fn sensor_line_text(l: SdrTypeLine) -> String {
  concat("  ", l.name as String, " | ", l.sensor_number as String, " | ", l.status as String, " | ", l.entity_id as String, " | ", l.reading_text as String)
}

// PER SOCKET FIRST, in the order the controller lists them, then every line as read.
fn megarac_sensor_table_text(naming: MegaRacSdrSocketNamingRule, lines: List<SdrLineResult>, sockets: List<Int>) -> String {
  let unstructured = filter(lines, r => match r { SdrLineUnstructured { text: _ } => true SdrLineDecoded { line: _ } => false })
  join([
    concat(to_string(count(lines)), " line(s), ", to_string(count(unstructured)), " without a reading field"),
    join(map(sockets, k => {
      let decoded = megarac_socket_sensor_lines(naming: naming, lines: lines, socket: k)
      let discrete = megarac_socket_unstructured_lines(naming: naming, lines: lines, socket: k)
      concat("socket ", to_string(k), " (", naming.prefix, to_string(k), "_ sensors: ", to_string(count(decoded)), " with a reading, ", to_string(count(discrete)), " without):\n",
        join(concat(map(decoded, l => sensor_line_text(l: l)), map(discrete, t => concat("  ", t))), "\n"))
    }), "\n"),
    "all sensors:",
    join(map(lines, r => match r { SdrLineDecoded { line: l } => sensor_line_text(l: l) SdrLineUnstructured { text: t } => concat("  ", trim(t)) }), "\n"),
  ], "\n")
}
