module gunbc.machine_intake_megarac_pre_os_channel

import gunbc.machine_intake_pre_os_observation_capabilities {
  PreOsObservationCapabilities,
  SolCollectorDidNotEstablishCoverage,
  SolHostFactFromCollector,
  sol_host_fact_from_collector,
}

// JOIN: MegaRAC names the SOL session as a channel on the served UI; whether captured bytes
// are a HOST fact is the collector observation, never a platform "present-but-silent" row.

fn megarac_sol_host_fact(profile: PreOsObservationCapabilities) -> SolHostFactFromCollector {
  sol_host_fact_from_collector(obs: profile.console)
}

fn megarac_incomplete_sol_coverage_is_not_a_host_fact(profile: PreOsObservationCapabilities) -> Bool {
  match megarac_sol_host_fact(profile: profile) {
    SolCollectorDidNotEstablishCoverage { coverage: _ } => true
    _ => false
  }
}
