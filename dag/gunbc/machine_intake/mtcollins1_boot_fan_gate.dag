module gunbc.machine_intake.mtcollins1_boot_fan_gate

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.decl_ref { decl_ref }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }
import extdeps.bmc.ipmi
import extdeps.bmc.ipmi_chassis_control { ChassisPowerObservation, ChassisPowerRead, ChassisStatusUndecodable, ChassisUnreadable, IpmiChassisPowerDown, ipmi_chassis_control_verb, chassis_observation_text, chassis_observation_is_off }
import gunbc.machine_intake.chassis_fan_establishment { FittedFanSet, FittedFanSetEstablished, ChassisFanVerdict, ChassisFansEstablished, ChassisFansRefused, chassis_fan_verdict }
import gunbc.machine_intake.bmc_fan_observation { FanObservationRound, observe_fan_round, round_fan_lines }
import gunbc.machine_intake.mtcollins1_fan_observe { mtcollins1_fan_transition_window }
import gunbc.machine_intake.megarac_boot_media_attach { megarac_stale_power_off_samples, megarac_stale_power_off_interval }
import gunbc.machine_intake.mtcollins1_access_observation { mtcollins1_endpoint, mtcollins1_boot_ipmi_read_deadline, mtcollins1_boot_ipmi_kill_after }
import gunbc.machine_intake.mtcollins1_boot_diagnostic_bundle { mtcollins1_boot_chassis_power }

// THE FITTED CHASSIS FANS OF mtcollins1: ESTABLISHED ONCE, BY OBSERVATION, THEN FIXED. The basis is the committed
// fan observation of boot run 39005709187 (artifacts/bmc/mtcollins1-boot-run-39005709187/mtcollins1-fan-observation.txt,
// round 0 at 2026-10-17T05:25:07Z, chassis on): FAN4_0, FAN4_1, FAN5_0 and FAN5_1 Speed at status ok, 5600-5800 RPM, with
// FAN4_Presence and FAN5_Presence reading Device Present; every FAN0..FAN3 Speed and Presence read No Reading. The
// operator's account (2026-10-17, uncertainty stated by them) is 8 fans, 4 installed on the socket-0 side, 4 empty on the
// socket-1 side, silkscreen J#. OPEN, recorded not resolved: four physical fans, or two dual-rotor fan positions (the
// observation is consistent with both, proof of neither); and the SEL Device Present reading for FAN1..FAN6 conflicts with
// the observed FAN1..FAN3 No Reading. The set is fixed here so the gate is not circular: it checks the live read against
// this row, and the row is not re-derived from the live read. A nonzero RPM proves a tach signal, not airflow (these tach
// readings were earlier judged unfaithful at the operator's PWM setting).
data mtcollins1_fitted_fan_set: FittedFanSet = FittedFanSetEstablished {
  headers: ["FAN4_0_Speed" as NonEmptyStr, "FAN4_1_Speed" as NonEmptyStr, "FAN5_0_Speed" as NonEmptyStr, "FAN5_1_Speed" as NonEmptyStr],
}

// WHERE THE COOLING MANAGER STANDS WHEN THE GATE STOPS THE BOOT. The fan-mode GET is cited, not executed by
// this repository (extdeps.bmc.megarac, operator-session curl only), so the standing is UNREAD and says so.
// It is never assumed automatic: the mtcollins1 fans are hand-set to manual PWM, and no exit path in this
// repository restores the manager. The write-back is a separate, operator-approved binding.
data mtcollins1_fan_gate_manager_standing_text: String = "cooling manager standing unread (the fan-mode GET is not executed here; mtcollins1 fans are hand-set to manual PWM and nothing restores the manager on this path; treat as NOT automatic until read)"

// PURE: the round read after the settle window, judged. A chassis not read ON refuses (a fan cannot spin on a
// host that is off), then the fitted-set verdict decides.
fn boot_fan_gate_verdict(fitted: FittedFanSet, round: FanObservationRound) -> ChassisFanVerdict {
  match round.chassis {
    ChassisPowerRead { power_on: on } =>
      if on { chassis_fan_verdict(fitted: fitted, lines: round_fan_lines(round: round)) } else { ChassisFansRefused { cause: "the chassis did not read on after the settle window" as NonEmptyStr } }
    ChassisStatusUndecodable { cause: _ } => ChassisFansRefused { cause: "the chassis status was undecodable after the settle window" as NonEmptyStr }
    ChassisUnreadable => ChassisFansRefused { cause: "the chassis status was unreadable after the settle window" as NonEmptyStr }
  }
}

// PURE: the stop's text, which becomes the step's failure reason and so the job summary.
fn boot_fan_gate_stop_text(cause: NonEmptyStr, first_off: Bool, repeated: Bool, second_off: Bool, last_readback: String) -> String {
  let power = if first_off {
    "power-off read back as off"
  } else if repeated && second_off {
    "power-off read back as off only after one repeated PowerDown"
  } else {
    concat("power-off unconfirmed after one repeated PowerDown (last readback: ", concat(last_readback, ")"))
  }
  join(["mtcollins1 boot stopped: chassis fan function not established after power-on: ", cause as String, "; ", power, "; ", mtcollins1_fan_gate_manager_standing_text], "")
}

fn boot_fan_gate_power_off_poll(username: NonEmptyStr, password_file: NonEmptyStr, remaining: Int) -> ChassisPowerObservation
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "boot_fan_gate_power_down"),
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "boot_fan_gate_power_off_poll"),
  ]
{
  let _paced = sleep_delay_seconds_second_carrier_projection(duration: megarac_stale_power_off_interval)
  let sample = mtcollins1_boot_chassis_power(username: username, password_file: password_file)
  if chassis_observation_is_off(observation: sample) || remaining <= 1 { sample } else { boot_fan_gate_power_off_poll(username: username, password_file: password_file, remaining: remaining - 1) }
}

// ONE MODELED PowerDown, THEN A BOUNDED READBACK; returns the last sample.
fn boot_fan_gate_power_down(username: NonEmptyStr, password_file: NonEmptyStr) -> ChassisPowerObservation
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "mtcollins1_boot_fan_gate"),
  ]
{
  let _down = diagnostic.ipmi.Tool.ChassisPowerControl(
    bmc_host: mtcollins1_endpoint.host,
    username: username,
    password_file: password_file,
    action: ipmi_chassis_control_verb(action: IpmiChassisPowerDown),
  )
  boot_fan_gate_power_off_poll(username: username, password_file: password_file, remaining: megarac_stale_power_off_samples)
}

// THE GATING POST-POWER-ON READ AND, ON REFUSAL, THE SAFE STOP. The settle window is the fan observation's own
// transition window (no second constant). A fan that never spins up inside it is Refused, never Taken. On a
// refusal: PowerDown + bounded readback; if not read off, ONE repeated PowerDown + readback, then
// 'power-off unconfirmed'; never a loop. The caller releases the unit hold through the existing teardown and
// the failure reason (this text) reaches the job summary.
fn mtcollins1_boot_fan_gate(username: NonEmptyStr, password_file: NonEmptyStr) -> ProcessExit
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_actuate"),
  ]
{
  let _settled = sleep_delay_seconds_second_carrier_projection(duration: mtcollins1_fan_transition_window)
  let round = observe_fan_round(bmc_host: mtcollins1_endpoint.host, username: username, password_file: password_file, round_index: 0)
  match boot_fan_gate_verdict(fitted: mtcollins1_fitted_fan_set, round: round) {
    ChassisFansEstablished => ExitSuccess
    ChassisFansRefused { cause: cause } => {
      let first = boot_fan_gate_power_down(username: username, password_file: password_file)
      let first_off = chassis_observation_is_off(observation: first)
      let second = if first_off { first } else { boot_fan_gate_power_down(username: username, password_file: password_file) }
      exit_failure(reason: boot_fan_gate_stop_text(cause: cause, first_off: first_off, repeated: first_off == false, second_off: chassis_observation_is_off(observation: second), last_readback: chassis_observation_text(observation: second) as String))
    }
  }
}
