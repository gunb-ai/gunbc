// THE FITTED CHASSIS FANS OF mtcollins1: AN OPERATOR-ASSUMED SET, informed by one committed observation and an explicitly
// uncertain operator account; it is not established by observation. The observation is the committed
// fan observation of boot run 39005709187 (artifacts/bmc/mtcollins1-boot-run-39005709187/mtcollins1-fan-observation.txt,
// round 0 at 2026-10-17T05:25:07Z, chassis on): FAN4_0, FAN4_1, FAN5_0 and FAN5_1 Speed at status ok, 5600-5800 RPM, with
// FAN4_Presence and FAN5_Presence reading Device Present; every FAN0..FAN3 Speed and Presence read No Reading. The
// operator's account (2026-10-17, uncertainty stated by them) is 8 fans, 4 installed on the socket-0 side, 4 empty on the
// socket-1 side, silkscreen J#. OPEN, recorded not resolved: four physical fans, or two dual-rotor fan positions (the
// observation is consistent with both, proof of neither); and the SEL Device Present reading for FAN1..FAN6 conflicts with
// the observed FAN1..FAN3 No Reading. The set is declared here so the gate is not circular: it checks the live read against
// this row, and the row is not re-derived from the live read. A nonzero RPM proves a tach signal, not airflow (these tach
// readings were earlier judged unfaithful at the operator's PWM setting). The set carries an explicit OperatorAssumed
// arm: its admission is stated, and the stop text reads the assumption back.
data mtcollins1_fitted_fan_set: FittedFanSet = FittedFanSetOperatorAssumed {
  first: "FAN4_0_Speed" as NonEmptyStr,
  rest: ["FAN4_1_Speed" as NonEmptyStr, "FAN5_0_Speed" as NonEmptyStr, "FAN5_1_Speed" as NonEmptyStr],
  assumption: "ADMITTED ON THE OPERATOR'S ASSUMPTION, not an established fact: taken once from the committed observation of boot run 39005709187 (round 0, 2026-10-17T05:25:07Z) and the operator's stated-uncertain account; OPEN: four physical fans or two dual-rotor positions, and the SEL Device Present reading for FAN1..FAN6 versus the observed FAN1..FAN3 No Reading; a tach signal is not airflow" as NonEmptyStr,
}

data fan_gate_observation_path: NonEmptyStr = "artifacts/mtcollins1-boot-fan-gate-observation.txt"
data github_step_summary_variable: NonEmptyStr = "GITHUB_STEP_SUMMARY"

// EVERY READBACK of one PowerDown, bounded; the last is the settled state, none is dropped.
fn boot_fan_gate_power_off_poll(username: NonEmptyStr, password_file: NonEmptyStr, remaining: Int) -> List<ChassisPowerObservation>
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "boot_fan_gate_power_down"),
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "boot_fan_gate_power_off_poll"),
  ]
{
  let _paced = sleep_delay_seconds_second_carrier_projection(duration: megarac_stale_power_off_interval)
  let sample = megarac_boot_chassis_power(row: mtcollins1_boot_row_value, username: username, password_file: password_file)
  if chassis_power_off_poll_settled(sample: sample, remaining: remaining) { [sample] } else { append([sample], boot_fan_gate_power_off_poll(username: username, password_file: password_file, remaining: remaining - 1)) }
}

fn boot_fan_gate_power_down(username: NonEmptyStr, password_file: NonEmptyStr) -> FanGatePowerDownAttempt
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "boot_fan_gate_safe_stop"),
  ]
{
  let down = diagnostic.ipmi.Tool.ChassisPowerControl(
    bmc_host: mtcollins1_endpoint.host,
    username: username,
    password_file: password_file,
    action: ipmi_chassis_control_verb(action: IpmiChassisPowerDown),
    deadline: coreutils_duration_operand(d: mtcollins1_boot_ipmi_read_deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: mtcollins1_boot_ipmi_kill_after) as NonEmptyStr,
    cipher_suite_argv: ipmi_cipher_suite_argv(suite: mtcollins1_boot_row_value.ipmi_cipher_suite),
  )
  FanGatePowerDownAttempt {
    command_success: down.success,
    command_stdout: down.stdout,
    command_exit_code: down.exit_code,
    command_stderr: down.transport_stderr,
    readbacks: boot_fan_gate_power_off_poll(username: username, password_file: password_file, remaining: megarac_stale_power_off_samples),
  }
}

// WHAT THE GATE MAY SPEND, DERIVED, not asserted: the round's three IPMI reads (chassis status, temperature,
// fan) at the round's read ceiling; and a refusal's safe stop, at most two PowerDown attempts, each the bounded PowerDown command
// (ChassisPowerControl runs under coreutils timeout at the boot read ceiling) and every read-back sample with its pacing interval.
// An abandonment's safe stop is the same stop and excludes the read and the refusal, so this bounds it too.
// The step budget (mtcollins1_boot_run mtcollins1_boot_step_timeout_minutes) adds this and, separately, the settle window
// its caller spends watched; the two file writes are local.
fn mtcollins1_boot_fan_gate_allowance() -> Second {
  let boot_read = (second_count(s: mtcollins1_boot_ipmi_read_deadline) + second_count(s: mtcollins1_boot_ipmi_kill_after)) as Int
  let round_read = (second_count(s: fan_round_ipmi_read_deadline) + second_count(s: fan_round_ipmi_kill_after)) as Int
  let attempt = boot_read + megarac_stale_power_off_samples * (boot_read + (second_count(s: megarac_stale_power_off_interval) as Int))
  second(count: 3 * round_read + 2 * attempt)
}

// ONE PowerDown + readback; if never read off, ONE repeated PowerDown + readback; never a loop. Both attempts' readbacks are kept.
fn boot_fan_gate_safe_stop(username: NonEmptyStr, password_file: NonEmptyStr) -> FanGateSafeStopReceipt
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "finish_refusal"),
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "mtcollins1_boot_fan_gate_abandon"),
  ]
{
  let first = boot_fan_gate_power_down(username: username, password_file: password_file)
  if any_readback_off(readbacks: first.readbacks) {
    FanGateSafeStopReceipt { first: first, repeat: FanGateRepeatNotNeeded }
  } else {
    FanGateSafeStopReceipt { first: first, repeat: FanGateRepeated { attempt: boot_fan_gate_power_down(username: username, password_file: password_file) } }
  }
}

fn fan_gate_write(path: NonEmptyStr, content: String) -> FanGateWrite {
  let w = Filesystem.Write(path: path as String, content: content)
  if w.success { FanGateWritten { path: path } } else { FanGateWriteFailed { path: path, error: w.error } }
}

// APPEND to the step summary (read-modify-write); an unset or unreadable summary is a typed failed write, never silence.
fn fan_gate_summary_append(block: String) -> FanGateWrite {
  let path = actions_variable_trimmed(name: github_step_summary_variable)
  if path == "" {
    FanGateWriteFailed { path: github_step_summary_variable, error: "GITHUB_STEP_SUMMARY is unset" }
  } else {
    let prior = Filesystem.Read(path: path)
    if prior.success || prior.error_kind == "not_found" {
      let w = Filesystem.Write(path: path, content: concat(if prior.success { prior.content } else { "" }, block))
      if w.success { FanGateWritten { path: github_step_summary_variable } } else { FanGateWriteFailed { path: github_step_summary_variable, error: w.error } }
    } else {
      FanGateWriteFailed { path: github_step_summary_variable, error: concat("the step summary could not be read: ", prior.error) }
    }
  }
}

// A REFUSAL: the stopping observation is WRITTEN BEFORE ANY PowerDown: the write is attempted and its result discriminated first; a failed write is kept
// as FanGateWriteFailed and the safe stop still proceeds. If execution completes, the observation is also in the typed outcome and the
// bundle. Then the safe stop, then the full text overwrites the file and a digest block is appended to the step summary.
fn fan_gate_refuse(fitted: FittedFanSet, cause: PostPowerFanRefusal, observation: FanObservationRound, username: NonEmptyStr, password_file: NonEmptyStr) -> PostPowerFanGateOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "mtcollins1_boot_fan_gate"),
  ]
{
  let manager = FanManagerUnread { read_obligation: "the cooling-manager standing is read only by the operator-session fan-mode GET (extdeps.bmc.megarac); this path executes no REST read and no fan-control write (ruling gunbc#14243); treat as NOT automatic until read" as NonEmptyStr }
  let pre = post_power_fan_gate_pre_stop_text(fitted: fitted, cause: cause, observation: observation, manager: manager)
  let pre_write = fan_gate_write(path: fan_gate_observation_path, content: pre)
  match pre_write {
    FanGateWritten { path: _ } => finish_refusal(fitted: fitted, cause: cause, observation: observation, manager: manager, pre: pre, pre_write: pre_write, username: username, password_file: password_file)
    FanGateWriteFailed { path: _, error: _ } => finish_refusal(fitted: fitted, cause: cause, observation: observation, manager: manager, pre: pre, pre_write: pre_write, username: username, password_file: password_file)
  }
}

fn finish_refusal(fitted: FittedFanSet, cause: PostPowerFanRefusal, observation: FanObservationRound, manager: FanManagerReadStanding, pre: String, pre_write: FanGateWrite, username: NonEmptyStr, password_file: NonEmptyStr) -> PostPowerFanGateOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_fan_gate", decl_name: "fan_gate_refuse"),
  ]
{
  let stop = boot_fan_gate_safe_stop(username: username, password_file: password_file)
  let full = concat(pre, post_power_fan_gate_stop_section(stop: stop))
  let file_write = match pre_write {
    FanGateWritten { path: _ } => fan_gate_write(path: fan_gate_observation_path, content: full)
    FanGateWriteFailed { path: p, error: e } => FanGateWriteFailed { path: p, error: e }
  }
  let summary = fan_gate_summary_append(block: concat("\n### mtcollins1 boot: post-power-on chassis-fan gate REFUSED\n\n```\n", concat(full, "```\n")))
  PostPowerFanRefused { cause: cause, observation: observation, stop: stop, manager: manager, evidence: FanGateEvidence { observation_file: file_write, step_summary: summary } }
}

// THE GATING POST-POWER-ON READ, over a SETTLED chassis, with the account that powered the host on (BootHandoffPoweredOn
// exists only for an issued power control), so there is no powered host this gate cannot read or safe-stop. The settle is the fan observation's own transition window,
// and it is spent by the one admitted caller BEFORE this read, under the SOL watch (mtcollins1_boot_run
// mtcollins1_boot_watched_fan_settle), not slept here, where nothing would observe a channel loss for a minute. A refusal is
// decided by the typed post_power_fan_verdict over the round that is KEPT in the outcome.
fn mtcollins1_boot_fan_gate(powered: BootHandoffPoweredOn, password_file: NonEmptyStr) -> PoweredFanGate
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_actuate"),
  ]
{
  let username = powered.account
  let round = observe_fan_round(bmc_host: mtcollins1_endpoint.host, username: username, password_file: password_file, round_index: 0, cipher_suite: mtcollins1_boot_row_value.ipmi_cipher_suite)
  let fitted = mtcollins1_fitted_fan_set
  match post_power_fan_verdict(fitted: fitted, chassis: round.chassis, thermal: round.thermal, fans: round.fans) {
    PostPowerFanVerdictEstablished => PostPowerFanGateReached { fitted: fitted, outcome: PostPowerFanEstablished { observation: round } }
    PostPowerFanVerdictRefused { cause: cause } => PostPowerFanGateReached { fitted: fitted, outcome: fan_gate_refuse(fitted: fitted, cause: cause, observation: round, username: username, password_file: password_file) }
  }
}

// THE GATE ABANDONED BEFORE IT PASSED (merry-fox-82's safety ruling, 2026-10-24). The boot run's watched settle stopped
// the boot while the host was powered on and its chassis fans unread; socket 1 is broken, only the socket-0 fans are fitted,
// and nothing watches the host after the stop. So the host is safe-stopped by the gate's own bounded stop, at once and WITHOUT
// a fan read: waiting out the settle to read would hold the host on unwatched for the rest of the window. The caller has
// already frozen the incident, so the evidence precedes the PowerDown here as it does on a refusal.
fn mtcollins1_boot_fan_gate_abandon(powered: BootHandoffPoweredOn, password_file: NonEmptyStr, reason: NonEmptyStr) -> PoweredFanGate
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_actuate"),
  ]
{
  PostPowerFanGateAbandoned { reason: reason, stop: boot_fan_gate_safe_stop(username: powered.account, password_file: password_file) }
}
