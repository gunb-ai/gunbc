module gunbc.machine_intake_pre_os_bringup_verdict

import std.types { Bool, Int, List, NonEmptyStr }
import std.measure { ByteSize }
import std.content_hash { ContentHash, ContentHashEqual, ContentHashDifferent, ContentHashCrossFamilyIncomparable, compare_content_hash }
import std.decl_ref { DeclarationRef }
import extdeps.bmc.ipmi_sel {
  OemSelPayload,
  SystemBootInitiatedOffset,
  SystemFirmwareProgressOffset,
  firmware_offset_is_progress,
  oem_sel_payload_eq,
}
import gunbc.machine_intake_pre_os_observation_capabilities {
  DimmLocalizationCapability,
  LocalizationUnavailableFromExposedTelemetry,
  OemDecodeAvailable,
  OemDecodeControllerDeclaredUnknown,
  OemDecodeNotProbed,
  OemDecodeRenderedUncited,
  PerSlotLocalizationExposed,
  PreOsObservationCapabilities,
  console_silence_is_informative,
}

// WHAT A PRE-OS BRING-UP ATTEMPT ESTABLISHED ABOUT THE HOST, from independent observations only.
// Two laws are structural here rather than checked:
//
//   CONSOLE SILENCE IS NOT A TERMINAL. The verdict's failure arm is constructed from the SEL
//   window alone. The console reading is consulted only to decide whether an inconclusive window
//   is UNDETERMINED or merely WAITING, and a banner-only capture on a silent-console platform
//   contributes nothing in either direction -- the same 86 bytes arrived at idle, after a power
//   cycle, after an AC cycle and after a reset on 2026-09-11, so those bytes discriminate nothing
//   (gunbc.recurring_failure_mode.absent_reads_identically_to_never_looked).
//
//   AN OPAQUE OEM CODE STAYS OPAQUE. OemSelPayloadObserved, OemSelDecodeStanding and
//   OemSelEmpiricalAssociation are three carriers with no fold between them and the verdict. The
//   verdict fold's signature does not take an OEM payload; a memory-training terminal has no
//   constructor in this module; the association is a reportable fact that names what would decode
//   it and nothing more (DESIGN section 4d: typed as a bet, never promoted).

// ── the console reading ────────────────────────────────────────────────────────────────────────

// BANNER-ONLY IS DECIDED BY DIGEST, NOT BY SIZE. The controller's session banner has a fixed
// digest on a given firmware; a capture whose digest equals it contains the banner and nothing
// else. Comparing sizes would call any 86-byte host emission a banner.
type SolCaptureReading
  = SolBannerOnly { capture_path: NonEmptyStr, bytes: ByteSize }
  | SolHostBytesObserved { capture_path: NonEmptyStr, bytes: ByteSize }
  | SolCaptureUnreadable { capture_path: NonEmptyStr }

fn sol_capture_reading(capture_path: NonEmptyStr, bytes: ByteSize, digest: ContentHash, banner_digest: ContentHash) -> SolCaptureReading {
  match compare_content_hash(left: digest, right: banner_digest) {
    ContentHashEqual => SolBannerOnly { capture_path: capture_path, bytes: bytes }
    ContentHashDifferent => SolHostBytesObserved { capture_path: capture_path, bytes: bytes }
    ContentHashCrossFamilyIncomparable => SolCaptureUnreadable { capture_path: capture_path }
  }
}

// ── the SEL window ─────────────────────────────────────────────────────────────────────────────

// ONE RECORD AS THE BRING-UP READER SEES IT. Record ids are the controller's, as integers, so a
// window can be cut at a cursor. The BMC clock rendering is carried verbatim; joining it to an
// observer's clock is not modeled here, so no fold reads it as a time.
type SelWindowEventKind
  = BootRestart { offset: SystemBootInitiatedOffset }
  | FirmwareProgressRecord { offset: SystemFirmwareProgressOffset }
  | OemTimestamped { payload: OemSelPayload }
  | OtherStandardEvent { rendering: NonEmptyStr }

type SelWindowEvent {
  record_id: Int
  bmc_clock_rendering: NonEmptyStr
  kind: SelWindowEventKind
}

// THE WINDOW AN ATTEMPT READS BEGINS AT THE CURSOR ITS SEL COLLECTOR RECORDED, which is why the
// cursor is a collector proof and not a convenience: a verdict over records that predate the
// attempt would count another configuration's boots. The cut is strict -- the cursor record itself
// was already present before the action.
fn sel_window_after_cursor(window: List<SelWindowEvent>, cursor_record_id: Int) -> List<SelWindowEvent> {
  filter(xs: window, f: e => e.record_id > cursor_record_id)
}

// A BOOT CYCLE IS THE SPAN FROM ONE RESTART RECORD TO THE NEXT. `progress_seen` is true when a
// FirmwareProgress record fell inside it -- the standard, decoded, specification-assigned event --
// and is the ONLY thing that can make a cycle read as having got past reset.
type BootCycleReading {
  restart_record_id: Int
  restart_offset: SystemBootInitiatedOffset
  progress_seen: Bool
}

// THE WINDOW'S CYCLES: the CLOSED ones, each ended by the next restart, and the one still OPEN
// when the window ended. The open cycle is kept apart because the window's end is not evidence
// about it (review 64203): a restart with no progress record yet may report progress a moment
// after the capture stopped. Progress already seen in the open cycle IS evidence and counts;
// absence of progress in it counts for nothing.
type BootCycleWindow {
  closed: List<BootCycleReading>
  open: BootCycleReading?
}

fn boot_cycle_step(acc: BootCycleWindow, event: SelWindowEvent) -> BootCycleWindow {
  match event.kind {
    BootRestart { offset: o } =>
      BootCycleWindow {
        closed: match acc.open {
          Absent => acc.closed
          Present { value: c } => append(acc.closed, [c])
        },
        open: Present { value: BootCycleReading { restart_record_id: event.record_id, restart_offset: o, progress_seen: false } },
      }
    FirmwareProgressRecord { offset: fo } =>
      match acc.open {
        Absent => acc
        Present { value: c } =>
          if firmware_offset_is_progress(offset: fo) {
            BootCycleWindow {
              closed: acc.closed,
              open: Present { value: BootCycleReading { restart_record_id: c.restart_record_id, restart_offset: c.restart_offset, progress_seen: true } },
            }
          } else {
            acc
          }
      }
    OemTimestamped { payload: _ } => acc
    OtherStandardEvent { rendering: _ } => acc
  }
}

// THE OEM ARM ABOVE IS `acc`, UNCONDITIONALLY, and that line is the wall: an OEM record can neither
// open a cycle nor mark progress. Whatever 0fde70330102 means, it means it OUTSIDE this fold.
fn boot_cycles(window: List<SelWindowEvent>) -> BootCycleWindow {
  fold(window, init: BootCycleWindow { closed: [], open: none }, f: (acc, e) => boot_cycle_step(acc: acc, event: e))
}

fn open_cycle_saw_progress(cycles: BootCycleWindow) -> Bool {
  match cycles.open {
    Absent => false
    Present { value: c } => c.progress_seen
  }
}

// PROGRESS IS COUNTED WHEREVER IT WAS SEEN, closed or open; absence of progress is counted over
// CLOSED cycles only.
fn cycles_with_progress(cycles: BootCycleWindow) -> Int {
  list_length(items: filter(xs: cycles.closed, f: c => c.progress_seen)) + (if open_cycle_saw_progress(cycles: cycles) { 1 } else { 0 })
}

fn closed_cycles_without_progress(cycles: BootCycleWindow) -> Int {
  list_length(items: filter(xs: cycles.closed, f: c => c.progress_seen == false))
}

// ── the verdict ────────────────────────────────────────────────────────────────────────────────

// HOW MANY RESTARTS WITHOUT PROGRESS MAKE A STABLE TERMINAL. A policy row, named, so the number a
// verdict turned on is citable and so the fold is not "retry until green": the bound is the point
// at which the model REFUSES to issue another action and hands the subject to a human.
data restart_without_progress_terminal_threshold: Int = 3

// WHERE A REMEDIATION MAY POINT. UnavailableFromExposedTelemetry is the honest arm when the
// platform exposes no per-slot evidence; the other arm carries the declaration that WOULD expose
// it, never a slot, because naming a slot is a fold over that source that this module does not
// perform. There is no arm carrying a slot number at all, so no timing heuristic or opaque payload
// can be turned into one here.
type RemediationLocalization
  = UnavailableFromExposedTelemetry
  | LocalizableFrom { source: DeclarationRef }

fn remediation_localization(profile: PreOsObservationCapabilities) -> RemediationLocalization {
  match profile.dimm_localization {
    LocalizationUnavailableFromExposedTelemetry => UnavailableFromExposedTelemetry
    PerSlotLocalizationExposed { source: s } => LocalizableFrom { source: s }
  }
}

type BringupUndeterminedCause
  = NoRestartInWindow
  | RestartsBelowTerminalThreshold { restarts_without_progress: Int }
  | ConsoleSilentAndWindowEmpty

type PreOsBringupVerdict
  = FirmwareProgressObserved { cycles_with_progress: Int, cycles_without_progress: Int }
  | BringupUndetermined { cause: BringupUndeterminedCause }
  | PhysicalRemediationRequired { restarts_without_progress: Int, localization: RemediationLocalization }

// THE RUN OF CLOSED RESTARTS SINCE THE LAST PROGRESS. A cycle that saw progress resets the count, so the
// figure is the length of the TRAILING failure sequence -- the only one that says anything about
// the host as it is now. Counting every progress-less cycle in the window would let one early good
// boot outvote any number of later failures (review 64164 on gunbc#11110), which is a bound that
// never engages.
fn trailing_restarts_without_progress(cycles: BootCycleWindow) -> Int {
  let closed_run = fold(cycles.closed, init: 0, f: (acc, c) => if c.progress_seen { 0 } else { acc + 1 })
  if open_cycle_saw_progress(cycles: cycles) { 0 } else { closed_run }
}

// THE FOLD. Its inputs are the window, the profile and the console reading; NOT an OEM payload,
// NOT an actuation receipt. The stable terminal is decided FIRST, from the trailing run: at least
// the threshold of restarts since the last progress is a refusal to keep actuating,
// PhysicalRemediationRequired, localized only as far as the platform can see, whatever happened
// earlier in the window. Only a window whose trailing run is below the bound may report progress
// seen anywhere in it; a shorter run with no progress at all is undetermined -- the window may
// simply be short.
//
// THE CONSOLE ENTERS EXACTLY ONCE, on the empty-window arm, and only to name the cause more
// precisely: a silent console beside an empty window is "nothing observed", while an emitting
// console beside an empty window would be a reading the SEL did not corroborate. On a silent
// platform the reading is discarded before it can be read as evidence, which is the
// console_silence_is_informative gate.
fn pre_os_bringup_verdict(
  window: List<SelWindowEvent>,
  console: SolCaptureReading,
  profile: PreOsObservationCapabilities,
) -> PreOsBringupVerdict {
  let cycles = boot_cycles(window: window)
  let with_progress = cycles_with_progress(cycles: cycles)
  let without_progress = closed_cycles_without_progress(cycles: cycles)
  let trailing = trailing_restarts_without_progress(cycles: cycles)
  if trailing >= restart_without_progress_terminal_threshold {
    PhysicalRemediationRequired { restarts_without_progress: trailing, localization: remediation_localization(profile: profile) }
  } else if with_progress > 0 {
    FirmwareProgressObserved { cycles_with_progress: with_progress, cycles_without_progress: without_progress }
  } else if without_progress > 0 {
    BringupUndetermined { cause: RestartsBelowTerminalThreshold { restarts_without_progress: without_progress } }
  } else {
    match console {
      SolBannerOnly { capture_path: _, bytes: _ } =>
        if console_silence_is_informative(profile: profile) {
          BringupUndetermined { cause: NoRestartInWindow }
        } else {
          BringupUndetermined { cause: ConsoleSilentAndWindowEmpty }
        }
      SolHostBytesObserved { capture_path: _, bytes: _ } => BringupUndetermined { cause: NoRestartInWindow }
      SolCaptureUnreadable { capture_path: _ } => BringupUndetermined { cause: NoRestartInWindow }
    }
  }
}

// WHETHER A VERDICT PERMITS ANOTHER POWER ACTION. Bounded, not retry-until-green: the remediation
// arm answers false, and a caller that wants to actuate again must obtain a NEW readiness for a
// NEW attempt after a human has changed the physical population.
fn verdict_permits_further_actuation(verdict: PreOsBringupVerdict) -> Bool {
  match verdict {
    FirmwareProgressObserved { cycles_with_progress: _, cycles_without_progress: _ } => true
    BringupUndetermined { cause: _ } => true
    PhysicalRemediationRequired { restarts_without_progress: _, localization: _ } => false
  }
}

// ── the OEM record, as three facts ─────────────────────────────────────────────────────────────

// FACT ONE: WHETHER AND WHERE THE PAYLOAD WAS OBSERVED. A payload absent from the window has no
// first or last record, so it has no arm that carries one (review 64221): a sentinel 0 would read
// as "present from the start of the log", the strongest claim any observation could make.
type OemSelPayloadObserved
  = OemPayloadAbsentFromWindow { payload: OemSelPayload }
  | OemPayloadSeen { payload: OemSelPayload, occurrences: Int, first_record_id: Int, last_record_id: Int }

fn oem_observed_payload(observed: OemSelPayloadObserved) -> OemSelPayload {
  match observed {
    OemPayloadAbsentFromWindow { payload: p } => p
    OemPayloadSeen { payload: p, occurrences: _, first_record_id: _, last_record_id: _ } => p
  }
}

fn oem_payload_seen_in_window(observed: OemSelPayloadObserved) -> Bool {
  match observed {
    OemPayloadAbsentFromWindow { payload: _ } => false
    OemPayloadSeen { payload: _, occurrences: _, first_record_id: _, last_record_id: _ } => true
  }
}

// FACT TWO: WHAT THE MANUFACTURER'S REALIZATION SAID WHEN ASKED TO DECODE IT. Derived from the
// capability profile so it cannot be authored more generously than the profile measured.
type OemSelDecodeStanding
  = ControllerDecodes { decode_authority: DeclarationRef }
  | ControllerDeclaredUnknown
  | ControllerRenderedUncited { rendering: NonEmptyStr }
  | DecodeNotProbed

fn oem_sel_decode_standing(profile: PreOsObservationCapabilities) -> OemSelDecodeStanding {
  match profile.oem_sel_decode {
    OemDecodeAvailable { decode_authority: a } => ControllerDecodes { decode_authority: a }
    OemDecodeControllerDeclaredUnknown => ControllerDeclaredUnknown
    OemDecodeRenderedUncited { rendering: r } => ControllerRenderedUncited { rendering: r }
    OemDecodeNotProbed => DecodeNotProbed
  }
}

// FACT THREE: WHAT THE PAYLOAD CO-OCCURS WITH. Computed over the window. `never_within_same_cycle_as`
// holds only candidates that DO appear in the window and never share a cycle with the payload;
// a candidate absent from the window is listed apart, because "never beside something that never
// happened" is vacuous and must not read as a co-occurrence finding. This is an association and
// its type says so; it names no cause, decodes no bytes, and no fold in this module consumes it.
type OemSelEmpiricalAssociation {
  observed: OemSelPayloadObserved
  never_within_same_cycle_as: List<OemSelPayload>
  candidates_absent_from_window: List<OemSelPayload>
  decode_standing: OemSelDecodeStanding
}

type OemPayloadCountFold {
  occurrences: Int
  first_record_id: Int
  last_record_id: Int
}

fn oem_payload_observed(window: List<SelWindowEvent>, payload: OemSelPayload) -> OemSelPayloadObserved {
  let counted = fold(
    window,
    init: OemPayloadCountFold { occurrences: 0, first_record_id: 0, last_record_id: 0 },
    f: (acc, e) => match e.kind {
      OemTimestamped { payload: p } =>
        if oem_sel_payload_eq(a: p, b: payload) {
          OemPayloadCountFold {
            occurrences: acc.occurrences + 1,
            first_record_id: if acc.occurrences == 0 { e.record_id } else { acc.first_record_id },
            last_record_id: e.record_id,
          }
        } else {
          acc
        }
      BootRestart { offset: _ } => acc
      FirmwareProgressRecord { offset: _ } => acc
      OtherStandardEvent { rendering: _ } => acc
    },
  )
  if counted.occurrences == 0 {
    OemPayloadAbsentFromWindow { payload: payload }
  } else {
    OemPayloadSeen {
      payload: payload,
      occurrences: counted.occurrences,
      first_record_id: counted.first_record_id,
      last_record_id: counted.last_record_id,
    }
  }
}

// WHETHER TWO PAYLOADS EVER FALL IN ONE BOOT CYCLE. The cycle is the same span boot_cycles uses,
// so "never beside" means never between the same pair of restart records.
type CoOccurrenceFold {
  saw_a_this_cycle: Bool
  saw_b_this_cycle: Bool
  co_occurred: Bool
}

fn co_occurrence_step(acc: CoOccurrenceFold, event: SelWindowEvent, a: OemSelPayload, b: OemSelPayload) -> CoOccurrenceFold {
  match event.kind {
    BootRestart { offset: _ } =>
      CoOccurrenceFold { saw_a_this_cycle: false, saw_b_this_cycle: false, co_occurred: acc.co_occurred || (acc.saw_a_this_cycle && acc.saw_b_this_cycle) }
    OemTimestamped { payload: p } =>
      CoOccurrenceFold {
        saw_a_this_cycle: acc.saw_a_this_cycle || oem_sel_payload_eq(a: p, b: a),
        saw_b_this_cycle: acc.saw_b_this_cycle || oem_sel_payload_eq(a: p, b: b),
        co_occurred: acc.co_occurred,
      }
    FirmwareProgressRecord { offset: _ } => acc
    OtherStandardEvent { rendering: _ } => acc
  }
}

fn payloads_co_occur_in_a_cycle(window: List<SelWindowEvent>, a: OemSelPayload, b: OemSelPayload) -> Bool {
  let done = fold(
    window,
    init: CoOccurrenceFold { saw_a_this_cycle: false, saw_b_this_cycle: false, co_occurred: false },
    f: (acc, e) => co_occurrence_step(acc: acc, event: e, a: a, b: b),
  )
  done.co_occurred || (done.saw_a_this_cycle && done.saw_b_this_cycle)
}

// THE ASSOCIATION IS COMPUTED, NOT AUTHORED, so a "never beside" claim the window contradicts
// cannot be written, and a candidate the window never shows cannot masquerade as one it shows
// often and never beside the payload.
fn oem_sel_empirical_association(
  window: List<SelWindowEvent>,
  payload: OemSelPayload,
  never_beside_candidates: List<OemSelPayload>,
  profile: PreOsObservationCapabilities,
) -> OemSelEmpiricalAssociation {
  let candidate_readings = map(never_beside_candidates, c => oem_payload_observed(window: window, payload: c))
  let present = map(filter(xs: candidate_readings, f: r => oem_payload_seen_in_window(observed: r)), r => oem_observed_payload(observed: r))
  let absent = map(filter(xs: candidate_readings, f: r => oem_payload_seen_in_window(observed: r) == false), r => oem_observed_payload(observed: r))
  OemSelEmpiricalAssociation {
    observed: oem_payload_observed(window: window, payload: payload),
    never_within_same_cycle_as: filter(xs: present, f: c => payloads_co_occur_in_a_cycle(window: window, a: payload, b: c) == false),
    candidates_absent_from_window: absent,
    decode_standing: oem_sel_decode_standing(profile: profile),
  }
}

// WHETHER AN ASSOCIATION MAY BE READ AS A DECODE: only when the manufacturer's realization decodes
// it, and then the decode is THEIRS, cited by the authority the standing carries -- never this
// module's. On every other standing the answer is false, however many occurrences the association
// counts, which is the arity repair
// gunbc.recurring_failure_mode.upstream_non_affirmation_consumed_as_permission prescribes.
fn association_is_decoded(association: OemSelEmpiricalAssociation) -> Bool {
  match association.decode_standing {
    ControllerDecodes { decode_authority: _ } => true
    ControllerDeclaredUnknown => false
    ControllerRenderedUncited { rendering: _ } => false
    DecodeNotProbed => false
  }
}
