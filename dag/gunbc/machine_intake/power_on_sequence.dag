module gunbc.machine_intake_power_on_sequence

import std.types { Bool, Int, List, NonEmptyStr, String }
import v2.std.optional { Present }
import extdeps.ampere.scp_diagnostic {
  AmpereBootStage, Smpro, Pmpro, AtfBl1, DdrInitialization, DdrTraining, AtfBl2, AtfBl31, AtfBl32, Uefi, OperatingSystem,
  AmpereBootStatus, NotStarted, Started, Completed, Failed,
}
import extdeps.ampere.smpro_register { SmproBootStage, SmproStageReading, SmproStageDefined, SmproStageUndefined, SmproStatusDefined, SmproStatusUndefined, smpro_stage_text }
import extdeps.bmc.ipmi_sel { SystemBootInitiatedOffset, FirmwareError, FirmwareHang, FirmwareProgress }
import extdeps.bmc.ipmi_sdr { SdrTypeLine }
import extdeps.bmc.redfish_memory_inventory { RedfishMemoryMember, RedfishProcessorMember }
import extdeps.bootloader.grub { GrubConsoleReport, GrubNothingStated, GrubBannerOnly, GrubStillTrying, GrubBootFailed, GrubError, grub_error_text }
import gunbc.machine_intake_pre_os_bringup_verdict {
  SelWindowEvent, BootRestart, FirmwareProgressRecord, OemTimestamped, OtherStandardEvent,
  FirmwareConsoleReport, NoTerminalStated, UndecodedErrorCodesOnly, FirmwareErrorStatementUnrecognized, TrainingRefusedByFirmware,
}
import gunbc.machine_intake_mtcollins1_smpro_observation {
  SmproSocketStage, SmproCurrentStage, CurrentStageEstablished, CurrentStageUnavailable,
  SmproReportedStage, ReportedStageEstablished, ReportedStageUnavailable,
}
import gunbc.machine_intake_ampere_dram_console_observation {
  AmpereDramConsoleObservation, AmpereDramBlockNotPrinted, AmpereDramBlockObserved, RosterClosed, RosterOpen, RosterNotObserved,
  ampere_dram_untrained_sockets,
}
import gunbc.machine_intake_ampere_checkpoint_console_observation {
  AmpereCheckpointWord, AmpereCheckpointConsoleObservation, AmpereCheckpointsNotPrinted, AmpereCheckpointsObserved,
  AmpereCheckpointReferenceComparison, CheckpointReferenceContinues, CheckpointReferenceEndsThere, CheckpointLastWordNotInReference,
  CheckpointSubjectHasNoWord, CheckpointReferenceHasNoWord,
  ampere_checkpoint_last_word, ampere_checkpoint_reference_comparison_text,
}
import gunbc.machine_intake_ampere_socket_console_observation { AmpereSocketConsoleObservation, AmpereSummaryNotPrinted, AmpereSummaryObserved }
import gunbc.machine_intake_linux_boot_console_observation {
  LinuxBootConsoleObservation, InitrdFailureNotPrinted, InitrdLoadFailed, EfiStubStatus, KernelPanicNotPrinted, KernelPanicked,
  efi_stub_status_text,
}
import gunbc.machine_intake_kernel_module_decompression_observation {
  KernelModuleDecompressionObservation, NoRefusalRecorded, RefusalRecorded, kernel_module_decompression_text,
}

// WHAT HAPPENS WHEN A MT. COLLINS IS TURNED ON, AND OUR BEST UNDERSTANDING OF WHAT HAPPENED ON ONE
// BOOT. The plan is docs/plans/power-on-sequence-model.md; this module is its stage chain and its
// one fold.
//
// THE CHAIN REUSES THE FIRMWARE'S OWN STAGE NUMBERING. Stages 0-9 are extdeps.ampere.scp_diagnostic
// AmpereBootStage, wrapped rather than copied; the only new vocabulary is what that numbering does
// not name -- the BMC and chassis before stage 0, the second socket's join, and the OS-side steps
// inside OperatingSystem.
//
// THE FOLD NEVER ASSERTS A STAGE THE EVIDENCE DOES NOT ESTABLISH (DESIGN sections 4d and 5). A stage
// is reached only when a reading names it; a missing reading is an open question, never a default.
// The result is never a pass/fail bit: the run's exit status stays the terminal verdict's, and this
// is what the receipt and the bundle say about the machine.
//
// WHY IS PRIVATE. The checkpoint word's fields and the restart mechanism come from sources this
// repository does not publish. So the fold reports the last word opaquely and the restart as what
// the SEL and the console show, and it carries the reset cause as a typed slot whose public value is
// unobserved. A private fold may consume BootUnderstanding and close those questions; nothing here
// imports one.
//
// MONOLITHIC FOR MT. COLLINS. The seams for Mt. Jade and x86 are in the plan's section 6 and are not
// abstracted here: the chain rows are this platform's, and abstraction follows the second platform.

// ── THE STAGES ───────────────────────────────────────────────────────────────────────────────────
type PowerOnStage
  = BmcStandby
  | ChassisPowerOn
  | Firmware { stage: AmpereBootStage }
  | InterSocketLink
  | BootLoader
  | KernelStub
  | KernelBoot
  | CensusCapture

// WHAT OBSERVES A STAGE. One row per carrier the bundle reads; a carrier this platform lacks is not
// a row (x86 has no SMpro).
type EvidenceCarrier
  = BmcReads
  | ChassisPowerRead
  | BmcSensorTable
  | BmcInventory
  | SmproBootStageRegisters
  | SystemEventLog
  | SerialConsole
  | HostCaptureMarkers

type PowerOnStageRow {
  stage: PowerOnStage
  runs_on: NonEmptyStr
  evidence: List<EvidenceCarrier>
}

// THE MT. COLLINS CHAIN, in power-on order. InterSocketLink sits after Pmpro because the PMpro
// brings the inter-socket link up; it is not on the path socket 0's progress takes, so its standing
// is reported beside the ending, never folded into it (the 2026-10-03 private trace: the CCIX
// record and socket 1's register pair are a finding independent of the DDR stall).
data mt_collins_power_on_chain: List<PowerOnStageRow> = [
  PowerOnStageRow { stage: BmcStandby, runs_on: "BMC (AMI MegaRAC) on standby power", evidence: [BmcReads, BmcInventory] },
  PowerOnStageRow { stage: ChassisPowerOn, runs_on: "BMC through the board power sequencer", evidence: [ChassisPowerRead, BmcSensorTable] },
  PowerOnStageRow { stage: Firmware { stage: Smpro }, runs_on: "SMpro, each socket", evidence: [SmproBootStageRegisters] },
  PowerOnStageRow { stage: Firmware { stage: Pmpro }, runs_on: "PMpro, each socket", evidence: [SmproBootStageRegisters] },
  PowerOnStageRow { stage: InterSocketLink, runs_on: "PMpro, both sockets", evidence: [SmproBootStageRegisters, SerialConsole] },
  PowerOnStageRow { stage: Firmware { stage: AtfBl1 }, runs_on: "ATF BL1, socket 0", evidence: [SmproBootStageRegisters] },
  PowerOnStageRow { stage: Firmware { stage: DdrInitialization }, runs_on: "DRAM firmware", evidence: [SerialConsole, SmproBootStageRegisters] },
  PowerOnStageRow { stage: Firmware { stage: DdrTraining }, runs_on: "DRAM firmware", evidence: [SmproBootStageRegisters] },
  PowerOnStageRow { stage: Firmware { stage: AtfBl2 }, runs_on: "ATF BL2", evidence: [SmproBootStageRegisters] },
  PowerOnStageRow { stage: Firmware { stage: AtfBl31 }, runs_on: "ATF BL31", evidence: [SmproBootStageRegisters] },
  PowerOnStageRow { stage: Firmware { stage: AtfBl32 }, runs_on: "ATF BL32", evidence: [SmproBootStageRegisters] },
  PowerOnStageRow { stage: Firmware { stage: Uefi }, runs_on: "UEFI (AMI Aptio)", evidence: [SerialConsole, SmproBootStageRegisters, SystemEventLog] },
  PowerOnStageRow { stage: BootLoader, runs_on: "GRUB from the BMC's virtual medium", evidence: [SerialConsole] },
  PowerOnStageRow { stage: KernelStub, runs_on: "Linux EFI stub", evidence: [SerialConsole] },
  PowerOnStageRow { stage: KernelBoot, runs_on: "Linux", evidence: [SerialConsole] },
  PowerOnStageRow { stage: CensusCapture, runs_on: "the census workload", evidence: [HostCaptureMarkers] },
]

fn firmware_stage_rank(s: AmpereBootStage) -> Int {
  match s {
    Smpro => 0 Pmpro => 1 AtfBl1 => 2 DdrInitialization => 3 DdrTraining => 4
    AtfBl2 => 5 AtfBl31 => 6 AtfBl32 => 7 Uefi => 8 OperatingSystem => 9
  }
}

// THE PROGRESS ORDER of socket 0's path. InterSocketLink has no rank on it: it is not a step that
// path waits on, so it can never be the furthest stage.
fn progress_rank(s: PowerOnStage) -> Int? {
  match s {
    BmcStandby => Present { value: 0 }
    ChassisPowerOn => Present { value: 1 }
    Firmware { stage: f } => Present { value: 2 + firmware_stage_rank(s: f) }
    InterSocketLink => none
    BootLoader => Present { value: 12 }
    KernelStub => Present { value: 13 }
    KernelBoot => Present { value: 14 }
    CensusCapture => Present { value: 15 }
  }
}

fn power_on_stage_text(s: PowerOnStage) -> String {
  match s {
    BmcStandby => "BMC on standby"
    ChassisPowerOn => "chassis power-on"
    Firmware { stage: f } => concat("firmware stage ", to_string(firmware_stage_rank(s: f)), " (", smpro_stage_text(r: SmproStageDefined { stage: f }), ")")
    InterSocketLink => "second socket join (inter-socket link)"
    BootLoader => "boot loader (GRUB)"
    KernelStub => "Linux EFI stub"
    KernelBoot => "Linux kernel"
    CensusCapture => "census capture"
  }
}

fn same_stage(a: PowerOnStage, b: PowerOnStage) -> Bool {
  match progress_rank(s: a) {
    Present { value: x } => match progress_rank(s: b) { Present { value: y } => x == y Absent => false }
    Absent => match progress_rank(s: b) { Present { value: _ } => false Absent => true }
  }
}

// ── THE EVIDENCE ─────────────────────────────────────────────────────────────────────────────────
// Every field is an existing typed reading, or a standing the bundle derives from one, so the fold
// re-reads nothing. A carrier that was not read says why, as text, because its cause is already a
// typed value in the bundle and is rendered there.
type CarrierStanding
  = CarrierRead
  | CarrierNotRead { reason: NonEmptyStr }

type PowerOnHandoff
  = HandoffPoweredOn
  | HandoffNotConfirmed { reason: NonEmptyStr }

// One SMpro pass: when it was taken, and each socket's two registers.
type SmproPassEvidence {
  label: NonEmptyStr
  sockets: List<SmproSocketStage>
}

type ConsoleEvidence
  = ConsoleRead {
      firmware: FirmwareConsoleReport,
      firmware_error_lines: Int,
      dram: AmpereDramConsoleObservation,
      checkpoints: AmpereCheckpointConsoleObservation,
      against_reference: AmpereCheckpointReferenceComparison,
      sockets: AmpereSocketConsoleObservation,
      loader: GrubConsoleReport,
      linux: LinuxBootConsoleObservation,
      modules: KernelModuleDecompressionObservation,
    }
  | ConsoleNotRead { reason: NonEmptyStr }

type SelEvidence
  = SelEventsRead { events: List<SelWindowEvent> }
  | SelEventsNotRead { reason: NonEmptyStr }

// THE ANOMALIES THE BMC'S OWN VIEW REPORTS, placed on the stage they speak about. The bundle decides
// each one with its existing predicates (gunbc.machine_intake_mtcollins1_boot_diagnostic_bundle);
// this module only places it.
type BmcAnomaly
  = ProcessorsListedBelowSockets { listed: Int, expected: Int }
  | ProcessorNotNominal { member: RedfishProcessorMember }
  | MemoryListedBelowSlots { listed: Int, slots: Int }
  | MemoryAbsentOnSocket { socket: Int, absent: Int, members: Int }
  | MemoryNotNominal { member: RedfishMemoryMember }
  | SensorNotNominal { line: SdrTypeLine }
  | SensorLineWithoutReadingNotNominal { text: NonEmptyStr }
  | SocketSensorsAbsent { socket: Int }
  | SelHardwareEvent { event: SelWindowEvent }

type BootEvidence {
  expected_sockets: List<Int>
  bmc: CarrierStanding
  bmc_anomalies: List<BmcAnomaly>
  handoff: PowerOnHandoff
  smpro: List<SmproPassEvidence>
  console: ConsoleEvidence
  sel: SelEvidence
  census_ended: Bool
}

// ── THE UNDERSTANDING ────────────────────────────────────────────────────────────────────────────
type DecodedBootError
  = FirmwareStatement { report: FirmwareConsoleReport }
  | SmproReportedFailure { socket: Int, bootstage: SmproBootStage }
  | ActiveSocketsBelowExpected { active: Int, expected: Int }
  | SelFirmwareFault { event: SelWindowEvent }
  | BootLoaderFailed { errors: List<GrubError> }
  | InitrdLoadFailedByStub { status: EfiStubStatus }
  | KernelPanic { reason: NonEmptyStr }
  | KernelModuleRefused { observation: KernelModuleDecompressionObservation }

type StageAnomaly
  = SocketStagePairInconsistent { socket: Int, current: SmproStageReading, reported: SmproBootStage }
  | SocketBehindSocketZero { socket: Int, current: SmproStageReading }
  | DramSocketUntrained { socket: Int }
  | DramRowMalformed { subsection: NonEmptyStr, line: String }
  | CheckpointLinesMalformed { lines: List<String> }
  | SocketStageUnreadBesideSocketZero { socket: Int, reason: String }
  | InterSocketLinesAbsent { active_sockets: Int }
  | BmcReported { anomaly: BmcAnomaly }

// AN ANOMALY IS NOT A REACH. StageAnomalous carries what established the stage, if anything:
// reached_by empty means the anomalies were seen and nothing established that the stage ran (a SEL
// memory event with no console and no SMpro reading), and the fold does not count it as reached.
type StageReading
  = StageReached { by: List<EvidenceCarrier> }
  | StageFailed { error: DecodedBootError }
  | StageAnomalous { anomalies: List<StageAnomaly>, reached_by: List<EvidenceCarrier> }
  | StageUnobserved

type StageStanding {
  stage: PowerOnStage
  reading: StageReading
}

// WHERE PROGRESS IS LOCATED. The sub-step is the last checkpoint word when the stage is the DRAM
// firmware's and the console printed words: compared opaquely, never decoded.
type StageEstablished {
  stage: PowerOnStage
  by: List<EvidenceCarrier>
  last_checkpoint: AmpereCheckpointWord?
}

// THE RESET CAUSE. The SCP keeps a reset-cause record, and no public register window reaches it:
// the 2026-10-03 0x00-0xFF SMpro sweep (branch mtcollins1-captures-2026-10-03, sweep-20261003T014255Z)
// found none. So its public value is Unobserved, naming what was searched. A cause read some day is
// carried as its raw word: the decoded enum is private (gunbc-private, after its #202).
type ResetCauseWord = ResetCauseUndefined { raw: Int }

type ResetCauseObservation
  = ResetCauseUnobserved { searched: NonEmptyStr }
  | ResetCauseObserved { cause: ResetCauseWord }

data mt_collins_reset_cause_search: NonEmptyStr = "SMpro registers 0x00-0xFF on both sockets (sweep-20261003T014255Z): no reset-cause window"

// THE RESTART'S CADENCE. The production console is not timestamped and the BMC clock rendering is
// not a time this module reads, so a bundle can count restarts but not time them; the 2026-10-03
// captures measured ~25.8 s with an observer clock. Timed is carried when a timed observer supplies
// it; until then the count is what is known.
type RestartCadence
  = CadenceTimed { period_seconds: Int, cycles: Int }
  | CadenceCounted { cycles: Int }

type BootEnding
  = ReachedCensus
  | StoppedWithStatedFailure { stage: PowerOnStage, error: DecodedBootError }
  | ResetWithObservedCadence {
      at: StageEstablished,
      against_reference: AmpereCheckpointReferenceComparison,
      restart_cadence: RestartCadence,
      console_errors: Int,
      sel_restarts: Int,
      reset_cause: ResetCauseObservation,
    }
  | StoppedSilently { at: StageEstablished, console_errors: Int }
  | EndingUnobservable { missing: List<EvidenceCarrier> }

type OpenQuestionKind
  = ResetCauseNotPubliclyReadable
  | RetryStatePersistence
  | CheckpointMeaningNotPubliclyModeled
  | SocketStagePairUnexplained { socket: Int }
  | RestartCadenceNotTimed
  | CarrierMissing { carrier: EvidenceCarrier, reason: NonEmptyStr }

type OpenQuestion {
  subject: PowerOnStage
  question: OpenQuestionKind
}

type BootUnderstanding {
  furthest: StageEstablished?
  ending: BootEnding
  stages: List<StageStanding>
  errors: List<DecodedBootError>
  open: List<OpenQuestion>
}

// ── THE FOLD: one reading per stage ──────────────────────────────────────────────────────────────
fn status_completed(s: SmproBootStage) -> Bool {
  match s.status { SmproStatusDefined { status: st } => match st { Completed => true NotStarted => false Started => false Failed => false } SmproStatusUndefined { code: _ } => false }
}

fn status_failed(s: SmproBootStage) -> Bool {
  match s.status { SmproStatusDefined { status: st } => match st { Failed => true NotStarted => false Started => false Completed => false } SmproStatusUndefined { code: _ } => false }
}

fn reported_rank(s: SmproBootStage) -> Int? {
  match s.stage { SmproStageDefined { stage: f } => Present { value: firmware_stage_rank(s: f) } SmproStageUndefined { code: _ } => none }
}

fn current_rank(c: SmproStageReading) -> Int? {
  match c { SmproStageDefined { stage: f } => Present { value: firmware_stage_rank(s: f) } SmproStageUndefined { code: _ } => none }
}

fn socket_stages(passes: List<SmproPassEvidence>, socket: Int) -> List<SmproSocketStage> {
  flat_map(passes, p => filter(p.sockets, s => s.socket == socket))
}

fn reported_of(s: SmproSocketStage) -> SmproBootStage? {
  match s.reported { ReportedStageEstablished { bootstage: b } => Present { value: b } ReportedStageUnavailable { reason: _ } => none }
}

fn current_of(s: SmproSocketStage) -> SmproStageReading? {
  match s.current { CurrentStageEstablished { stage: c } => Present { value: c } CurrentStageUnavailable { reason: _ } => none }
}

// HOW FAR ONE READING PUTS A SOCKET: the further of its two registers' stages. CUR_BOOTSTAGE is
// the SMpro's current stage and BOOTSTAGE what it reported; either one naming a stage is evidence
// the socket reached it. An undefined code establishes nothing.
fn socket_progress_rank(s: SmproSocketStage) -> Int? {
  let cur = match current_of(s: s) { Absent => none Present { value: c } => current_rank(c: c) }
  let rep = match reported_of(s: s) { Absent => none Present { value: b } => reported_rank(s: b) }
  match cur {
    Absent => rep
    Present { value: x } => match rep { Absent => Present { value: x } Present { value: y } => Present { value: if x > y { x } else { y } } }
  }
}

fn max_rank(ranks: List<Int>) -> Int? {
  let start: Int? = none
  fold(ranks, init: start, f: (acc, r) => match acc { Absent => Present { value: r } Present { value: m } => if r > m { Present { value: r } } else { Present { value: m } } })
}

// THE FURTHEST FIRMWARE STAGE SOCKET 0'S SMpro SHOWED across the passes.
fn socket_zero_smpro_rank(passes: List<SmproPassEvidence>) -> Int? {
  max_rank(ranks: flat_map(socket_stages(passes: passes, socket: 0), s => match socket_progress_rank(s: s) { Absent => [] Present { value: r } => [r] }))
}

fn smpro_failures(passes: List<SmproPassEvidence>) -> List<DecodedBootError> {
  flat_map(flat_map(passes, p => p.sockets), s => match reported_of(s: s) {
    Absent => []
    Present { value: b } => if status_failed(s: b) { [SmproReportedFailure { socket: s.socket, bootstage: b }] } else { [] }
  })
}

// THE TWO REGISTERS DISAGREE when BOOTSTAGE reports a stage CUR_BOOTSTAGE has not reached, or
// either carries a code the ABI does not define. BOOTSTAGE is advanced only by the driver's write
// (extdeps.ampere.smpro_register, BOOTSTAGE read safety), so it may LAG the current stage by design;
// it may not LEAD it. The 2026-10-03 socket 1 pair, CUR_BOOTSTAGE 0x0001 with BOOTSTAGE 0x03ff, does
// both: stage 3 reported against PMpro current, and status 0xff, which no ABI row defines.
fn status_undefined(b: SmproBootStage) -> Bool {
  match b.status { SmproStatusDefined { status: _ } => false SmproStatusUndefined { code: _ } => true }
}

fn pair_inconsistent(s: SmproSocketStage) -> Bool {
  match current_of(s: s) {
    Absent => false
    Present { value: c } => match reported_of(s: s) {
      Absent => false
      Present { value: b } => status_undefined(b: b) || (match current_rank(c: c) {
        Absent => true
        Present { value: cr } => match reported_rank(s: b) { Absent => true Present { value: rr } => rr > cr }
      })
    }
  }
}

fn untrained_sockets(e: BootEvidence, sockets: List<Int>) -> List<Int> {
  match e.console {
    ConsoleNotRead { reason: _ } => []
    ConsoleRead { firmware: _, firmware_error_lines: _, dram: d, checkpoints: _, against_reference: _, sockets: _, loader: _, linux: _, modules: _ } => ampere_dram_untrained_sockets(observation: d, expected_sockets: sockets)
  }
}

fn inter_socket_anomalies(e: BootEvidence) -> List<StageAnomaly> {
  let others = filter(e.expected_sockets, k => k != 0)
  let zero = socket_zero_smpro_rank(passes: e.smpro)
  let pairs = flat_map(others, k => flat_map(socket_stages(passes: e.smpro, socket: k), s =>
    if pair_inconsistent(s: s) { match current_of(s: s) { Present { value: c } => match reported_of(s: s) { Present { value: b } => [SocketStagePairInconsistent { socket: k, current: c, reported: b }] Absent => [] } Absent => [] } } else { [] }))
  let behind = flat_map(others, k => {
    let seen = flat_map(socket_stages(passes: e.smpro, socket: k), s => match socket_progress_rank(s: s) { Absent => [] Present { value: r } => [r] })
    match max_rank(ranks: seen) {
      Absent => []
      Present { value: kr } => match zero {
        Present { value: z } => if kr < z { match flat_map(socket_stages(passes: e.smpro, socket: k), s => match current_of(s: s) { Absent => [] Present { value: c } => [c] }).last() {
          Present { value: c } => [SocketBehindSocketZero { socket: k, current: c }]
          Absent => []
        } } else { [] }
        Absent => []
      }
    }
  })
  let untrained = map(untrained_sockets(e: e, sockets: others), k => DramSocketUntrained { socket: k })
  let zero_read = any(socket_stages(passes: e.smpro, socket: 0), s => match current_of(s: s) { Present { value: _ } => true Absent => false })
  let unread = if !zero_read { [] } else { flat_map(others, k => match socket_stages(passes: e.smpro, socket: k).last() {
    Absent => []
    Present { value: s } => match s.current {
      CurrentStageEstablished { stage: _ } => []
      CurrentStageUnavailable { reason: r } => [SocketStageUnreadBesideSocketZero { socket: k, reason: r }]
    }
  }) }
  concat(pairs, concat(behind, concat(unread, untrained)))
}

fn summary_active_sockets(e: BootEvidence) -> Int? {
  match e.console {
    ConsoleNotRead { reason: _ } => none
    ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: _, against_reference: _, sockets: o, loader: _, linux: _, modules: _ } => match o.summary {
      AmpereSummaryNotPrinted => none
      AmpereSummaryObserved { summary: s, summaries_printed: _ } => s.active_sockets
    }
  }
}

fn summary_inter_socket_lines(e: BootEvidence) -> Int {
  match e.console {
    ConsoleNotRead { reason: _ } => 0
    ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: _, against_reference: _, sockets: o, loader: _, linux: _, modules: _ } => match o.summary {
      AmpereSummaryNotPrinted => 0
      AmpereSummaryObserved { summary: s, summaries_printed: _ } => count(s.inter_socket_links)
    }
  }
}

fn inter_socket_reading(e: BootEvidence) -> StageReading {
  let expected = count(e.expected_sockets)
  let anomalies = inter_socket_anomalies(e: e)
  match summary_active_sockets(e: e) {
    Present { value: n } =>
      if n < expected { StageFailed { error: ActiveSocketsBelowExpected { active: n, expected: expected } } }
      else if expected > 1 && summary_inter_socket_lines(e: e) == 0 { StageAnomalous { anomalies: concat(anomalies, [InterSocketLinesAbsent { active_sockets: n }]), reached_by: [SerialConsole] } }
      else { reached_or_anomalous(anomalies: anomalies, by: [SerialConsole]) }
    Absent => unreached_anomalies(anomalies: anomalies)
  }
}

fn bmc_anomalies_on(e: BootEvidence, stage: PowerOnStage) -> List<StageAnomaly> {
  map(filter(e.bmc_anomalies, a => same_stage(a: bmc_anomaly_stage(a: a), b: stage)), a => BmcReported { anomaly: a })
}

// THE STAGE A BMC ANOMALY SPEAKS ABOUT. Inventory is the BMC's own view of what is fitted; rails
// and sensors are the chassis power-on's; a memory or processor SEL event is placed on the firmware
// stage that owns memory, because the SEL carries no stage.
fn bmc_anomaly_stage(a: BmcAnomaly) -> PowerOnStage {
  match a {
    ProcessorsListedBelowSockets { listed: _, expected: _ } => BmcStandby
    ProcessorNotNominal { member: _ } => BmcStandby
    MemoryListedBelowSlots { listed: _, slots: _ } => BmcStandby
    MemoryAbsentOnSocket { socket: _, absent: _, members: _ } => BmcStandby
    MemoryNotNominal { member: _ } => BmcStandby
    SensorNotNominal { line: _ } => ChassisPowerOn
    SensorLineWithoutReadingNotNominal { text: _ } => ChassisPowerOn
    SocketSensorsAbsent { socket: _ } => ChassisPowerOn
    SelHardwareEvent { event: _ } => Firmware { stage: DdrInitialization }
  }
}

fn reached_or_anomalous(anomalies: List<StageAnomaly>, by: List<EvidenceCarrier>) -> StageReading {
  if count(anomalies) > 0 { StageAnomalous { anomalies: anomalies, reached_by: by } } else { StageReached { by: by } }
}

fn unreached_anomalies(anomalies: List<StageAnomaly>) -> StageReading {
  if count(anomalies) > 0 { StageAnomalous { anomalies: anomalies, reached_by: [] } } else { StageUnobserved }
}

fn sel_firmware_faults(e: BootEvidence) -> List<DecodedBootError> {
  match e.sel {
    SelEventsNotRead { reason: _ } => []
    SelEventsRead { events: es } => flat_map(es, ev => match ev.kind {
      FirmwareProgressRecord { offset: o } => match o { FirmwareError => [SelFirmwareFault { event: ev }] FirmwareHang => [SelFirmwareFault { event: ev }] FirmwareProgress { progress_rendering: _ } => [] }
      BootRestart { offset: _ } => []
      OemTimestamped { payload: _ } => []
      OtherStandardEvent { rendering: _ } => []
    })
  }
}

fn sel_restart_count(e: BootEvidence) -> Int {
  match e.sel {
    SelEventsNotRead { reason: _ } => 0
    SelEventsRead { events: es } => count(filter(es, ev => match ev.kind { BootRestart { offset: _ } => true FirmwareProgressRecord { offset: _ } => false OemTimestamped { payload: _ } => false OtherStandardEvent { rendering: _ } => false }))
  }
}

fn firmware_statement_error(r: FirmwareConsoleReport) -> DecodedBootError? {
  match r {
    NoTerminalStated => none
    UndecodedErrorCodesOnly { err_lines: _ } => Present { value: FirmwareStatement { report: r } }
    FirmwareErrorStatementUnrecognized { statement: _ } => Present { value: FirmwareStatement { report: r } }
    TrainingRefusedByFirmware { statement: _, locus: _ } => Present { value: FirmwareStatement { report: r } }
  }
}

// THE FIRMWARE STAGE A CONSOLE READING ESTABLISHES. The DRAM firmware's block establishes stage 3
// (the DRAM firmware is running); the boot summary is printed by UEFI and establishes stage 8. A
// checkpoint word is not decoded, so it establishes nothing beyond the block it was printed in.
fn console_firmware_reading(e: BootEvidence, stage: AmpereBootStage) -> StageReading? {
  match e.console {
    ConsoleNotRead { reason: _ } => none
    ConsoleRead { firmware: f, firmware_error_lines: _, dram: d, checkpoints: _, against_reference: _, sockets: o, loader: _, linux: _, modules: _ } =>
      match stage {
        DdrInitialization => match firmware_statement_error(r: f) {
          Present { value: err } => Present { value: StageFailed { error: err } }
          Absent => match d { AmpereDramBlockNotPrinted => none AmpereDramBlockObserved { block: _, blocks_printed: _ } => Present { value: StageReached { by: [SerialConsole] } } }
        }
        Uefi => match o.summary { AmpereSummaryNotPrinted => none AmpereSummaryObserved { summary: _, summaries_printed: _ } => Present { value: StageReached { by: [SerialConsole] } } }
        Smpro => none Pmpro => none AtfBl1 => none DdrTraining => none AtfBl2 => none AtfBl31 => none AtfBl32 => none OperatingSystem => none
      }
  }
}

// WHAT THE DRAM FIRMWARE'S OWN OUTPUT SHOWS ABOUT SOCKET 0: a closed roster with no socket-0 row,
// and what its grammar does not admit -- a roster or param row that does not parse, and a CP: line
// whose word is not eight hex digits. Kept, never dropped, so a firmware that changes its format
// shows up here. Another socket's empty roster belongs to InterSocketLink.
fn console_anomalies(e: BootEvidence, stage: AmpereBootStage) -> List<StageAnomaly> {
  match stage {
    DdrInitialization => match e.console {
      ConsoleNotRead { reason: _ } => []
      ConsoleRead { firmware: _, firmware_error_lines: _, dram: d, checkpoints: c, against_reference: _, sockets: _, loader: _, linux: _, modules: _ } =>
        concat(map(untrained_sockets(e: e, sockets: filter(e.expected_sockets, k => k == 0)), k => DramSocketUntrained { socket: k }),
        concat(match d {
          AmpereDramBlockNotPrinted => []
          AmpereDramBlockObserved { block: b, blocks_printed: _ } => map(b.malformed, m => DramRowMalformed { subsection: m.subsection, line: m.line })
        }, match c {
          AmpereCheckpointsNotPrinted => []
          AmpereCheckpointsObserved { last_cycle: cy, cycles_printed: _ } => if count(cy.malformed) == 0 { [] } else { [CheckpointLinesMalformed { lines: cy.malformed }] }
        }))
    }
    _ => []
  }
}

fn firmware_reading(e: BootEvidence, stage: AmpereBootStage) -> StageReading {
  let rank = firmware_stage_rank(s: stage)
  let failure = filter(smpro_failures(passes: e.smpro), err => match err {
    SmproReportedFailure { socket: k, bootstage: b } => k == 0 && (match reported_rank(s: b) { Present { value: r } => r == rank Absent => false })
    _ => false
  }).first()
  let smpro_reached = match socket_zero_smpro_rank(passes: e.smpro) { Present { value: z } => z >= rank Absent => false }
  let anomalies = concat(bmc_anomalies_on(e: e, stage: Firmware { stage: stage }), console_anomalies(e: e, stage: stage))
  match failure {
    Present { value: err } => StageFailed { error: err }
    Absent => match console_firmware_reading(e: e, stage: stage) {
      Present { value: r } => match r {
        StageFailed { error: err } => StageFailed { error: err }
        _ => reached_or_anomalous(anomalies: anomalies, by: if smpro_reached { [SerialConsole, SmproBootStageRegisters] } else { [SerialConsole] })
      }
      Absent => if smpro_reached { reached_or_anomalous(anomalies: anomalies, by: [SmproBootStageRegisters]) }
        else { unreached_anomalies(anomalies: anomalies) }
    }
  }
}

fn loader_reading(c: ConsoleEvidence) -> StageReading {
  match c {
    ConsoleNotRead { reason: _ } => StageUnobserved
    ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: _, against_reference: _, sockets: _, loader: g, linux: _, modules: _ } => match g {
      GrubNothingStated => StageUnobserved
      GrubBannerOnly => StageReached { by: [SerialConsole] }
      GrubStillTrying { errors: _ } => StageReached { by: [SerialConsole] }
      GrubBootFailed { errors: es } => StageFailed { error: BootLoaderFailed { errors: es } }
    }
  }
}

fn stub_reading(c: ConsoleEvidence) -> StageReading {
  match c {
    ConsoleNotRead { reason: _ } => StageUnobserved
    ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: _, against_reference: _, sockets: _, loader: _, linux: l, modules: _ } => match l.initrd {
      InitrdLoadFailed { status: s, line: _ } => StageFailed { error: InitrdLoadFailedByStub { status: s } }
      InitrdFailureNotPrinted => if l.stub_lines > 0 { StageReached { by: [SerialConsole] } } else { StageUnobserved }
    }
  }
}

fn kernel_reading(c: ConsoleEvidence) -> StageReading {
  match c {
    ConsoleNotRead { reason: _ } => StageUnobserved
    ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: _, against_reference: _, sockets: _, loader: _, linux: l, modules: m } => match l.panic {
      KernelPanicked { reason: r } => StageFailed { error: KernelPanic { reason: r } }
      KernelPanicNotPrinted => match m {
        RefusalRecorded { refusals: _, unparsed_refusal_records: _, insert_failures: _, unparsed_insert_records: _, identity: _ } => StageFailed { error: KernelModuleRefused { observation: m } }
        NoRefusalRecorded { insert_failures: _, unparsed_insert_records: _ } => if l.kernel_banner_printed { StageReached { by: [SerialConsole] } } else { StageUnobserved }
      }
    }
  }
}

fn stage_reading(e: BootEvidence, stage: PowerOnStage) -> StageReading {
  match stage {
    BmcStandby => match e.bmc {
      CarrierRead => reached_or_anomalous(anomalies: bmc_anomalies_on(e: e, stage: BmcStandby), by: [BmcReads])
      CarrierNotRead { reason: _ } => unreached_anomalies(anomalies: bmc_anomalies_on(e: e, stage: BmcStandby))
    }
    ChassisPowerOn => match e.handoff {
      HandoffPoweredOn => reached_or_anomalous(anomalies: bmc_anomalies_on(e: e, stage: ChassisPowerOn), by: [ChassisPowerRead])
      HandoffNotConfirmed { reason: _ } => unreached_anomalies(anomalies: bmc_anomalies_on(e: e, stage: ChassisPowerOn))
    }
    Firmware { stage: f } => firmware_reading(e: e, stage: f)
    InterSocketLink => inter_socket_reading(e: e)
    BootLoader => loader_reading(c: e.console)
    KernelStub => stub_reading(c: e.console)
    KernelBoot => kernel_reading(c: e.console)
    CensusCapture => if e.census_ended { StageReached { by: [HostCaptureMarkers] } } else { StageUnobserved }
  }
}

fn power_on_stage_standings(e: BootEvidence) -> List<StageStanding> {
  map(mt_collins_power_on_chain, row => StageStanding { stage: row.stage, reading: stage_reading(e: e, stage: row.stage) })
}

// ── THE FOLD: the ending ─────────────────────────────────────────────────────────────────────────
fn reading_reached(r: StageReading) -> Bool {
  match r { StageReached { by: _ } => true StageAnomalous { anomalies: _, reached_by: b } => count(b) > 0 StageFailed { error: _ } => true StageUnobserved => false }
}

fn reading_by(r: StageReading) -> List<EvidenceCarrier> {
  match r { StageReached { by: b } => b StageAnomalous { anomalies: _, reached_by: b } => b StageFailed { error: _ } => [] StageUnobserved => [] }
}

fn last_checkpoint_of(e: BootEvidence) -> AmpereCheckpointWord? {
  match e.console {
    ConsoleNotRead { reason: _ } => none
    ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: c, against_reference: _, sockets: _, loader: _, linux: _, modules: _ } => match c {
      AmpereCheckpointsNotPrinted => none
      AmpereCheckpointsObserved { last_cycle: cy, cycles_printed: _ } => ampere_checkpoint_last_word(c: cy)
    }
  }
}

fn console_cycles(e: BootEvidence) -> Int {
  match e.console {
    ConsoleNotRead { reason: _ } => 0
    ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: c, against_reference: _, sockets: _, loader: _, linux: _, modules: _ } => match c {
      AmpereCheckpointsNotPrinted => 0
      AmpereCheckpointsObserved { last_cycle: _, cycles_printed: n } => n
    }
  }
}

fn console_error_lines(e: BootEvidence) -> Int {
  match e.console {
    ConsoleNotRead { reason: _ } => 0
    ConsoleRead { firmware: _, firmware_error_lines: n, dram: _, checkpoints: _, against_reference: _, sockets: _, loader: _, linux: _, modules: _ } => n
  }
}

fn reference_comparison_of(e: BootEvidence) -> AmpereCheckpointReferenceComparison {
  match e.console {
    ConsoleNotRead { reason: _ } => CheckpointSubjectHasNoWord
    ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: _, against_reference: r, sockets: _, loader: _, linux: _, modules: _ } => r
  }
}

// THE FURTHEST STAGE on socket 0's progress path that a reading establishes. The checkpoint word is
// attached only when that stage is the DRAM firmware's: a word printed there says nothing about a
// later stage.
fn furthest_established(e: BootEvidence, stages: List<StageStanding>) -> StageEstablished? {
  let on_path = filter(stages, s => match progress_rank(s: s.stage) { Present { value: _ } => reading_reached(r: s.reading) Absent => false })
  match on_path.last() {
    Absent => none
    Present { value: s } => Present { value: StageEstablished {
      stage: s.stage,
      by: reading_by(r: s.reading),
      last_checkpoint: match s.stage { Firmware { stage: f } => match f { DdrInitialization => last_checkpoint_of(e: e) DdrTraining => last_checkpoint_of(e: e) _ => none } _ => none },
    } }
  }
}

fn first_path_failure(stages: List<StageStanding>) -> StageStanding? {
  filter(stages, s => match progress_rank(s: s.stage) {
    Absent => false
    Present { value: _ } => match s.reading { StageFailed { error: _ } => true _ => false }
  }).first()
}

fn missing_carriers(e: BootEvidence) -> List<EvidenceCarrier> {
  concat(match e.handoff { HandoffPoweredOn => [] HandoffNotConfirmed { reason: _ } => [ChassisPowerRead] },
    concat(match e.console { ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: _, against_reference: _, sockets: _, loader: _, linux: _, modules: _ } => [] ConsoleNotRead { reason: _ } => [SerialConsole] },
    concat(if count(e.smpro) == 0 { [SmproBootStageRegisters] } else { [] },
      match e.sel { SelEventsRead { events: _ } => [] SelEventsNotRead { reason: _ } => [SystemEventLog] })))
}

fn boot_ending(e: BootEvidence, stages: List<StageStanding>, furthest: StageEstablished?) -> BootEnding {
  if e.census_ended { ReachedCensus }
  else {
    match first_path_failure(stages: stages) {
      Present { value: s } => match s.reading { StageFailed { error: err } => StoppedWithStatedFailure { stage: s.stage, error: err } _ => EndingUnobservable { missing: missing_carriers(e: e) } }
      Absent => match furthest {
        Absent => EndingUnobservable { missing: missing_carriers(e: e) }
        Present { value: at } =>
          if console_cycles(e: e) > 1 || sel_restart_count(e: e) > 0 {
            ResetWithObservedCadence {
              at: at,
              against_reference: reference_comparison_of(e: e),
              restart_cadence: CadenceCounted { cycles: console_cycles(e: e) },
              console_errors: console_error_lines(e: e),
              sel_restarts: sel_restart_count(e: e),
              reset_cause: ResetCauseUnobserved { searched: mt_collins_reset_cause_search },
            }
          } else {
            StoppedSilently { at: at, console_errors: console_error_lines(e: e) }
          }
      }
    }
  }
}

// ── THE FOLD: what is still unknown ──────────────────────────────────────────────────────────────
fn carrier_questions(e: BootEvidence) -> List<OpenQuestion> {
  concat(match e.bmc { CarrierRead => [] CarrierNotRead { reason: r } => [OpenQuestion { subject: BmcStandby, question: CarrierMissing { carrier: BmcReads, reason: r } }] },
    concat(match e.handoff { HandoffPoweredOn => [] HandoffNotConfirmed { reason: r } => [OpenQuestion { subject: ChassisPowerOn, question: CarrierMissing { carrier: ChassisPowerRead, reason: r } }] },
    concat(match e.console { ConsoleRead { firmware: _, firmware_error_lines: _, dram: _, checkpoints: _, against_reference: _, sockets: _, loader: _, linux: _, modules: _ } => [] ConsoleNotRead { reason: r } => [OpenQuestion { subject: Firmware { stage: DdrInitialization }, question: CarrierMissing { carrier: SerialConsole, reason: r } }] },
      match e.sel { SelEventsRead { events: _ } => [] SelEventsNotRead { reason: r } => [OpenQuestion { subject: Firmware { stage: Uefi }, question: CarrierMissing { carrier: SystemEventLog, reason: r } }] })))
}

fn ending_questions(ending: BootEnding) -> List<OpenQuestion> {
  match ending {
    ResetWithObservedCadence { at: a, against_reference: _, restart_cadence: c, console_errors: _, sel_restarts: _, reset_cause: rc } =>
      concat(
        concat([OpenQuestion { subject: a.stage, question: RetryStatePersistence }],
          match rc { ResetCauseUnobserved { searched: _ } => [OpenQuestion { subject: a.stage, question: ResetCauseNotPubliclyReadable }] ResetCauseObserved { cause: _ } => [] }),
        concat(match c { CadenceCounted { cycles: _ } => [OpenQuestion { subject: a.stage, question: RestartCadenceNotTimed }] CadenceTimed { period_seconds: _, cycles: _ } => [] },
          match a.last_checkpoint { Present { value: _ } => [OpenQuestion { subject: a.stage, question: CheckpointMeaningNotPubliclyModeled }] Absent => [] }))
    StoppedSilently { at: a, console_errors: _ } =>
      match a.last_checkpoint { Present { value: _ } => [OpenQuestion { subject: a.stage, question: CheckpointMeaningNotPubliclyModeled }] Absent => [] }
    ReachedCensus => []
    StoppedWithStatedFailure { stage: _, error: _ } => []
    EndingUnobservable { missing: _ } => []
  }
}

fn anomaly_questions(stages: List<StageStanding>) -> List<OpenQuestion> {
  flat_map(stages, s => match s.reading {
    StageAnomalous { anomalies: xs, reached_by: _ } => flat_map(xs, a => match a {
      SocketStagePairInconsistent { socket: k, current: _, reported: _ } => [OpenQuestion { subject: s.stage, question: SocketStagePairUnexplained { socket: k } }]
      _ => []
    })
    _ => []
  })
}

fn stage_errors(stages: List<StageStanding>) -> List<DecodedBootError> {
  flat_map(stages, s => match s.reading { StageFailed { error: err } => [err] _ => [] })
}

// THE ONE FOLD. Errors are every stated failure the evidence carries, in chain order, then the SEL's
// firmware faults (which name no stage) and any SMpro failure on a socket other than 0.
fn boot_understanding(e: BootEvidence) -> BootUnderstanding {
  let stages = power_on_stage_standings(e: e)
  let furthest = furthest_established(e: e, stages: stages)
  let ending = boot_ending(e: e, stages: stages, furthest: furthest)
  let other_socket_failures = filter(smpro_failures(passes: e.smpro), err => match err { SmproReportedFailure { socket: k, bootstage: _ } => k != 0 _ => false })
  BootUnderstanding {
    furthest: furthest,
    ending: ending,
    stages: stages,
    errors: concat(stage_errors(stages: stages), concat(sel_firmware_faults(e: e), other_socket_failures)),
    open: concat(carrier_questions(e: e), concat(anomaly_questions(stages: stages), ending_questions(ending: ending))),
  }
}

// ── RENDER ───────────────────────────────────────────────────────────────────────────────────────
fn carrier_text(c: EvidenceCarrier) -> String {
  match c {
    BmcReads => "BMC reads" ChassisPowerRead => "chassis power read" BmcSensorTable => "BMC sensor table"
    BmcInventory => "BMC inventory" SmproBootStageRegisters => "SMpro boot-stage registers" SystemEventLog => "SEL"
    SerialConsole => "serial console" HostCaptureMarkers => "host-capture markers"
  }
}

fn smpro_bootstage_text(b: SmproBootStage) -> String {
  concat(smpro_stage_text(r: b.stage), ", ", match b.status {
    SmproStatusDefined { status: s } => match s { NotStarted => "not started" Started => "started" Completed => "completed" Failed => "FAILED" }
    SmproStatusUndefined { code: c } => concat("status code ", to_string(c))
  })
}

fn decoded_error_text(err: DecodedBootError) -> String {
  match err {
    FirmwareStatement { report: r } => match r {
      NoTerminalStated => "firmware stated nothing"
      UndecodedErrorCodesOnly { err_lines: n } => concat("firmware printed ", to_string(n), " ERR: code line(s) this repository does not decode")
      FirmwareErrorStatementUnrecognized { statement: s } => concat("firmware error statement: ", s as String)
      TrainingRefusedByFirmware { statement: s, locus: _ } => concat("firmware refused training: ", s as String)
    }
    SmproReportedFailure { socket: k, bootstage: b } => concat("socket ", to_string(k), " SMpro reports ", smpro_bootstage_text(b: b))
    ActiveSocketsBelowExpected { active: a, expected: x } => concat("firmware boot summary: ", to_string(a), " active socket(s), ", to_string(x), " expected")
    SelFirmwareFault { event: ev } => concat("SEL record ", to_string(ev.record_id), ": system firmware ", match ev.kind { FirmwareProgressRecord { offset: o } => match o { FirmwareError => "error" FirmwareHang => "hang" FirmwareProgress { progress_rendering: _ } => "progress" } _ => "event" })
    BootLoaderFailed { errors: es } => concat("GRUB failed: ", join(map(es, x => grub_error_text(error: x)), "; "))
    InitrdLoadFailedByStub { status: s } => concat("EFI stub could not load the initrd: ", efi_stub_status_text(s: s))
    KernelPanic { reason: r } => concat("kernel panic: ", r as String)
    KernelModuleRefused { observation: o } => concat("kernel module refused: ", kernel_module_decompression_text(o: o))
  }
}

fn bmc_anomaly_text(a: BmcAnomaly) -> String {
  match a {
    ProcessorsListedBelowSockets { listed: l, expected: x } => concat("BMC lists ", to_string(l), " Processor member(s); ", to_string(x), " socket(s) expected")
    ProcessorNotNominal { member: p } => concat("BMC Processor ", p.id as String, " not nominal")
    MemoryListedBelowSlots { listed: l, slots: s } => concat("BMC lists ", to_string(l), " Memory member(s); the board has ", to_string(s), " slots")
    MemoryAbsentOnSocket { socket: k, absent: n, members: m } => concat("BMC reports ", to_string(n), " of ", to_string(m), " socket-", to_string(k), " Memory member(s) State=Absent")
    MemoryNotNominal { member: m } => concat("BMC Memory ", m.id as String, " not nominal")
    SensorNotNominal { line: l } => concat("sensor ", l.name as String, " status ", l.status as String, ": ", l.reading_text as String)
    SensorLineWithoutReadingNotNominal { text: t } => concat("sensor line (no reading field): ", t as String)
    SocketSensorsAbsent { socket: k } => concat("no socket-", to_string(k), " sensor in the table")
    SelHardwareEvent { event: ev } => concat("SEL record ", to_string(ev.record_id), ": ", match ev.kind {
      OtherStandardEvent { rendering: r } => r as String
      FirmwareProgressRecord { offset: _ } => "system firmware event"
      BootRestart { offset: _ } => "system boot initiated"
      OemTimestamped { payload: _ } => "OEM record"
    })
  }
}

fn stage_anomaly_text(a: StageAnomaly) -> String {
  match a {
    SocketStagePairInconsistent { socket: k, current: c, reported: b } => concat("socket ", to_string(k), " SMpro CUR_BOOTSTAGE says ", smpro_stage_text(r: c), " but BOOTSTAGE says ", smpro_bootstage_text(b: b))
    SocketBehindSocketZero { socket: k, current: c } => concat("socket ", to_string(k), " SMpro is at ", smpro_stage_text(r: c), ", behind socket 0")
    DramSocketUntrained { socket: k } => concat("the closed DRAM roster lists no DIMM on socket ", to_string(k))
    DramRowMalformed { subsection: sub, line: l } => concat("DRAM firmware row under '", sub as String, "' not in the transcribed grammar: ", l)
    CheckpointLinesMalformed { lines: ls } => concat("CP: line(s) whose word is not eight hex digits: ", join(ls, " | "))
    SocketStageUnreadBesideSocketZero { socket: k, reason: r } => concat("socket ", to_string(k), " SMpro stage unread while socket 0's was read: ", r)
    InterSocketLinesAbsent { active_sockets: n } => concat("the boot summary shows ", to_string(n), " active socket(s) but no Inter Socket Connection line")
    BmcReported { anomaly: x } => bmc_anomaly_text(a: x)
  }
}

fn stage_reading_text(r: StageReading) -> String {
  match r {
    StageReached { by: b } => concat("reached (", join(map(b, c => carrier_text(c: c)), ", "), ")")
    StageFailed { error: err } => concat("FAILED: ", decoded_error_text(err: err))
    StageAnomalous { anomalies: xs, reached_by: b } => concat(if count(b) > 0 { concat("reached (", join(map(b, c => carrier_text(c: c)), ", "), "), ") } else { "not established, " }, "ANOMALOUS: ", join(map(xs, a => stage_anomaly_text(a: a)), "; "))
    StageUnobserved => "not observed"
  }
}

fn established_text(a: StageEstablished) -> String {
  concat(power_on_stage_text(s: a.stage), match a.last_checkpoint { Absent => "" Present { value: w } => concat(", last checkpoint ", w.digits as String) })
}

fn reset_cause_text(r: ResetCauseObservation) -> String {
  match r {
    ResetCauseUnobserved { searched: s } => concat("unobserved (searched: ", s as String, ")")
    ResetCauseObserved { cause: c } => match c { ResetCauseUndefined { raw: w } => concat("raw word ", to_string(w), " (decode is private)") }
  }
}

fn boot_ending_text(e: BootEnding) -> String {
  match e {
    ReachedCensus => "reached the census capture; no stage stated a failure on the way"
    StoppedWithStatedFailure { stage: s, error: err } => concat("stopped at ", power_on_stage_text(s: s), " with a stated failure: ", decoded_error_text(err: err))
    ResetWithObservedCadence { at: a, against_reference: r, restart_cadence: c, console_errors: n, sel_restarts: k, reset_cause: rc } => join([
      concat("progress stopped after ", established_text(a: a), " with no stated failure (", to_string(n), " console error line(s)), and the machine restarted"),
      concat("restarts: ", match c { CadenceTimed { period_seconds: p, cycles: y } => concat(to_string(y), " cycle(s), period ~", to_string(p), " s") CadenceCounted { cycles: y } => concat(to_string(y), " console cycle(s), not timed") }, "; SEL System Restart records: ", to_string(k)),
      concat("against the reference boot: ", ampere_checkpoint_reference_comparison_text(c: r)),
      concat("reset cause: ", reset_cause_text(r: rc)),
    ], "\n")
    StoppedSilently { at: a, console_errors: n } => concat("progress stopped after ", established_text(a: a), " with no stated failure (", to_string(n), " console error line(s)) and no restart observed")
    EndingUnobservable { missing: m } => concat("where the boot ended is not observable; missing: ", join(map(m, c => carrier_text(c: c)), ", "))
  }
}

fn open_question_text(q: OpenQuestion) -> String {
  concat(power_on_stage_text(s: q.subject), ": ", match q.question {
    ResetCauseNotPubliclyReadable => "what caused the reset? no public register reaches the SCP's reset-cause record"
    RetryStatePersistence => "does any failsafe or retry state survive the reset? it decides bounded retries from an endless loop"
    CheckpointMeaningNotPubliclyModeled => "what does the last checkpoint word mean? its fields are not publicly modeled"
    SocketStagePairUnexplained { socket: k } => concat("why do socket ", to_string(k), "'s two SMpro stage registers disagree?")
    RestartCadenceNotTimed => "how long is each cycle? this console is not timestamped"
    CarrierMissing { carrier: c, reason: r } => concat(carrier_text(c: c), " not read: ", r as String)
  })
}

fn boot_understanding_text(u: BootUnderstanding) -> String {
  join([
    concat("furthest stage established: ", match u.furthest { Absent => "none" Present { value: a } => established_text(a: a) }),
    concat("ending: ", boot_ending_text(e: u.ending)),
    "-- stages --",
    join(map(u.stages, s => concat(power_on_stage_text(s: s.stage), ": ", stage_reading_text(r: s.reading))), "\n"),
    "-- decoded errors --",
    if count(u.errors) == 0 { "none" } else { join(map(u.errors, x => decoded_error_text(err: x)), "\n") },
    "-- open questions --",
    if count(u.open) == 0 { "none" } else { join(map(u.open, q => open_question_text(q: q)), "\n") },
  ], "\n")
}

// EVERY DECODED ERROR AND EVERY STAGE ANOMALY, one line each, named by its stage: what a one-line
// refusal reason carries beside the summary, so an operator reading only the run's failure sees what
// was found and not only where progress ended.
fn boot_understanding_notes(u: BootUnderstanding) -> List<String> {
  concat(map(u.errors, x => decoded_error_text(err: x)),
    flat_map(u.stages, s => match s.reading {
      StageAnomalous { anomalies: xs, reached_by: _ } => map(xs, a => concat(power_on_stage_text(s: s.stage), ": ", stage_anomaly_text(a: a)))
      _ => []
    }))
}

// ONE LINE for the receipt and the refusal reason: the furthest stage and the ending's first line.
fn boot_understanding_summary(u: BootUnderstanding) -> String {
  concat("furthest=", match u.furthest { Absent => "none" Present { value: a } => established_text(a: a) },
    "; ending=", match split(s: boot_ending_text(e: u.ending), delimiter: "\n").first() { Absent => "" Present { value: l } => l },
    "; errors=", to_string(count(u.errors)), "; open=", to_string(count(u.open)))
}
