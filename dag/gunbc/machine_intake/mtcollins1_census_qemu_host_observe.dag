module gunbc.machine_intake_mtcollins1_census_qemu_host_observe

import std.types { NonEmptyStr, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.optional { Present, Absent }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.mkdir { mkdir_parents_command }
import gunbc.command_runner { run_shell_commands, LocalExec }
import gunbc.hostname_read { hostname_short_read }
import gunbc.host_effect { LocalShell }
import gunbc.runner_microvm_host_ready { executor_home_wet }
import gunbc.runner_qemu_toolchain { qemu_toolchain_location }
import gunbc.runner_qemu_host_standing { QemuHostStanding, observe_qemu_host_standing_wet, qemu_host_standing_text, qemu_host_ready }

// THE mtcollins1 CENSUS BINDING OF THE EXECUTOR-HOST QEMU READING (the MtCollins1CensusQemuHostObserve
// mode of gunbc.fleet_converge_workflow). The census boot on mtcollins1 refused in-kernel module
// decompression on one attempt and not on another with identical media
// (gunbc.machine_intake_mtcollins1_census_refusal_hypotheses); a QEMU boot of the same ISO under KVM
// on a fleet executor asks whether a HOST factor is needed for the refusal. What the executor carries
// for that boot is gunbc.runner_qemu_host_standing's reading, keyed by the executor; this module
// carries only what is the census's: the entry roots ci_spec names, the install directory the census
// tree was first placed under, and the receipt path the workflow uploads (managed-host cut 4b: the
// entry roots and the constants ci_spec imports stay here as thin bindings; renaming them is cut 7's).

// THE CENSUS TREE'S INSTALL DIRECTORY ON THE EXECUTOR, kept at the name it was first placed under so
// an existing tree stays where its consumers hold paths into it.
data census_qemu_install_dir: NonEmptyStr = "gunbc-census-qemu"

data census_qemu_host_observe_receipt_dir: String = "target"

data census_qemu_host_observe_receipt_path: String = "target/mtcollins1-census-qemu-host.txt"

// THE OBSERVE READS THE ROOT THE CONVERGE WOULD PLACE for this job user, and places nothing. It
// carries no dispatch host binding (its workflow step supplies none), so the executor is keyed by its
// own `hostname -s` capture, and a capture that refuses is reported in the receipt, not guessed.
fn mtcollins1_census_qemu_host_observe_wet() -> ProcessExit {
  match executor_home_wet() {
    Absent => exit_failure(reason: "mtcollins1_census_qemu_host_observe: HOME is unset, so the job user's install root cannot be named")
    Present { value: home } => census_qemu_host_verdict_wet(
      entry: "mtcollins1_census_qemu_host_observe",
      preamble: "",
      standing: observe_qemu_host_standing_wet(host: hostname_short_read(transport: LocalShell), root: qemu_toolchain_location(home: home, install_dir: census_qemu_install_dir).root as String),
    )
  }
}

// THE RECEIPT IS WRITTEN BEFORE THE VERDICT, in every arm, and a host that is not ready exits nonzero.
fn census_qemu_host_verdict_wet(entry: String, preamble: String, standing: QemuHostStanding) -> ProcessExit {
  let text = concat(preamble, qemu_host_standing_text(s: standing))
  let _ = run_shell_commands(commands: [mkdir_parents_command(path: census_qemu_host_observe_receipt_dir)], transport: LocalExec)
  let w = Filesystem.Write(path: census_qemu_host_observe_receipt_path, content: concat(text, "\n"))
  if !w.success {
    exit_failure(reason: join([entry, ": receipt write refused: ", w.error, "\n", text], ""))
  } else if qemu_host_ready(s: standing) {
    ExitSuccess
  } else {
    exit_failure(reason: join([entry, ": this host cannot yet boot the census image under QEMU --\n", text], ""))
  }
}
