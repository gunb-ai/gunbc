module gunbc.machine_intake_pre_os_timeline

import gunbc.mtcollins_memory_change { mtcollins_dram_cycle_start }

import gunbc.machine_intake_pre_os_refusal { PreOsSourceChanged, PreOsOccurrenceNotAdjacent, PreOsMachineDisagrees, PreOsOccurrenceConflict, PreOsRefusal, PreOsContinuityRefusal, PreOsPositionRefusal, pre_os_text_refusal, pre_os_refusal_at, pre_os_assessment_refusal }
import std.types { Bool, List, NonEmptyStr, String }
import gunbc.guarantee_rung { GuaranteeRung }
import gunbc.memory_configuration { MemoryConfiguration }
import std.bytes { utf8_encode_bytes, bytes_octets }
import std.measure { ByteSize, byte_size }
import std.content_hash { Sha256Hash }
import std.goal_assessment { ObservationAttempt, ObservationEstablished, ObservationRefused, GoalAssessment, GoalAssessmentRefused, GoalIndeterminate }
import std.algebra { FreeSemigroup, Empty }
import gunbc.memory_observation { read_verified_memory_capture }
import gunbc.machine_intake_pre_os_inventory_assessment { PreOsInventoryQuestion, pre_os_inventory_observation, pre_os_diagnostic_absence }
import gunbc.fleet_observation_observation_envelope { ObservationEnvelope, RetentionExposure, retention_exposure, source_byte_fact }
import gunbc.fleet_observation_capture_chunk { ChunkOccurrence, ContinuityNotEstablished, ContinuityShortOfRange, ContinuityPositionsIncomparable, ContinuityCoversRange, range_end, StreamPosition, compare_positions, PositionBefore, PositionSame, PositionAfter, PositionIncomparable, position_advanced_by }
import gunbc.machine_intake_pre_os_replay { pre_os_committed_envelope, pre_os_same_source_generation, pre_os_bound_envelope, pre_os_chunk_continuity, pre_os_occurrence_conflicts, pre_os_same_envelope, pre_os_unique_occurrences, pre_os_same_source, PreOsSelCursor, PreOsSelIngestion, pre_os_ingest_sel }
import gunbc.machine_intake_pre_os_observer { PreOsMilestones, pre_os_milestones, pre_os_host_userspace_boot, pre_os_firmware_boot_selection, pre_os_boot_assessment, pre_os_training_assessment }

// Parser selection is an observation request, not a success goal. A platform
// without SEL can supply only console observations. No reported-source list is
// interpreted as a complete required-evidence roster.
type PreOsSourceFormat = PreOsSelSnapshot | PreOsConsoleText

type PreOsReplayObservation {
  envelope: ObservationEnvelope
  format: PreOsSourceFormat
  payload: ObservationAttempt<String, NonEmptyStr>
}

fn pre_os_utf8_size(text: String) -> ByteSize { byte_size(count: count(bytes_octets(b: utf8_encode_bytes(s: text)))) }

// Only immutable artifact bytes verified against the envelope's digest and byte
// count enter replay through this effectful reader. Unsupported hash families
// refuse explicitly; a structural fingerprint is not an artifact checksum.
fn pre_os_read_observation(envelope: ObservationEnvelope, format: PreOsSourceFormat) -> PreOsReplayObservation {
  let payload = match envelope.chunk.payload_digest {
    Sha256Hash(digest) => match read_verified_memory_capture(path: envelope.chunk.artifact_ref, expected_sha256: digest.hex as NonEmptyStr) {
      ObservationRefused { cause } => ObservationRefused { cause: cause }
      ObservationEstablished { observed: text } =>
        if pre_os_utf8_size(text: text) == envelope.chunk.range.length {
          ObservationEstablished { observed: text }
        } else { ObservationRefused { cause: "artifact byte count differs from recorded stream range" } }
    }
    _ => ObservationRefused { cause: "replay artifact reader requires a cryptographic SHA-256 artifact reference" }
  }
  PreOsReplayObservation { envelope: envelope, format: format, payload: payload }
}

// A DRAM cycle marker is not a firmware boot id. These anchors name captured
// cycles only; neither one-to-one boot mapping nor a kernel UUID is presumed.
type PreOsCapturedCycleAnchor { occurrence: ChunkOccurrence, stream_offset: StreamPosition }
type PreOsCapturedCycleReading {
  anchor: ObservationAttempt<PreOsCapturedCycleAnchor, PreOsRefusal>
  firmware_attempt: ObservationAttempt<NonEmptyStr, NonEmptyStr>
  kernel_boot: ObservationAttempt<NonEmptyStr, NonEmptyStr>
  milestones: PreOsMilestones
  firmware_selection: ObservationAttempt<NonEmptyStr, NonEmptyStr>
}
type PreOsCycleScan { next_offset: StreamPosition, cycles: List<PreOsCapturedCycleReading> }

type PreOsConsoleSpan { chunks: List<PreOsReplayObservation>, payload: String, composition: ObservationAttempt<String, PreOsRefusal> }

// Check each supplied range through its carrier and keep the refusal at the
// preceding/current chunk location. No isolation silently discards its cause.
fn pre_os_composable_payload(observation: PreOsReplayObservation) -> ObservationAttempt<String, PreOsRefusal> {
  match pre_os_committed_envelope(envelope: observation.envelope) {
    ObservationRefused { cause } => ObservationRefused { cause: cause }
    ObservationEstablished { observed: _ } => match pre_os_chunk_continuity(envelope: observation.envelope) {
      ContinuityCoversRange { reach: _ } => match observation.payload {
        ObservationEstablished { observed } => ObservationEstablished { observed: observed }
        ObservationRefused { cause } => ObservationRefused { cause: pre_os_text_refusal(text: cause) }
      }
      ContinuityNotEstablished { continuity } => ObservationRefused { cause: PreOsRefusal { location: ["console continuity"], detail: PreOsContinuityRefusal { coverage: ContinuityNotEstablished { continuity: continuity } } } }
      ContinuityShortOfRange { verified_through, requested_end } => ObservationRefused { cause: PreOsRefusal { location: ["console continuity"], detail: PreOsContinuityRefusal { coverage: ContinuityShortOfRange { verified_through: verified_through, requested_end: requested_end } } } }
      ContinuityPositionsIncomparable { left, right } => ObservationRefused { cause: PreOsRefusal { location: ["console continuity"], detail: PreOsContinuityRefusal { coverage: ContinuityPositionsIncomparable { left: left, right: right } } } }
    }
  }
}

fn pre_os_console_span(previous: PreOsConsoleSpan?, current: PreOsReplayObservation) -> PreOsConsoleSpan {
  let text = match current.payload { ObservationEstablished { observed: payload } => payload ObservationRefused { cause: _ } => "" }
  let composition: ObservationAttempt<String, PreOsRefusal> = match pre_os_composable_payload(observation: current) {
    ObservationRefused { cause } => ObservationRefused { cause: pre_os_refusal_at(cause: cause, location: "current chunk") }
    ObservationEstablished { observed: current_text } => match previous {
      Absent => ObservationRefused { cause: pre_os_text_refusal(text: "no preceding console span") }
      Present { value: before } => match before.chunks.skip(n: if count(before.chunks) == 0 { 0 } else { count(before.chunks) - 1 }).first() {
        Absent => ObservationRefused { cause: pre_os_text_refusal(text: "preceding console span has no chunks") }
        Present { value: last } => match pre_os_composable_payload(observation: last) {
          ObservationRefused { cause } => ObservationRefused { cause: pre_os_refusal_at(cause: cause, location: "preceding chunk") }
          ObservationEstablished { observed: _ } =>
            if !pre_os_same_source_generation(a: last.envelope, b: current.envelope) {
              ObservationRefused { cause: PreOsRefusal { location: ["console source"], detail: PreOsSourceChanged { before: last.envelope, after: current.envelope } } }
            } else if last.envelope.chunk.occurrence.session != current.envelope.chunk.occurrence.session
              || last.envelope.chunk.occurrence.ownership_generation != current.envelope.chunk.occurrence.ownership_generation
              || current.envelope.chunk.occurrence.receive_sequence != last.envelope.chunk.occurrence.receive_sequence + 1 {
              ObservationRefused { cause: PreOsRefusal { location: ["console occurrence"], detail: PreOsOccurrenceNotAdjacent { before: last.envelope, after: current.envelope } } }
            } else { match compare_positions(a: range_end(range: last.envelope.chunk.range), b: current.envelope.chunk.range.first) {
              PositionSame => ObservationEstablished { observed: concat(before.payload, current_text) }
              order => ObservationRefused { cause: PreOsRefusal { location: ["console adjacency"], detail: PreOsPositionRefusal { order: order } } }
            } }
        }
      }
    }
  }
  match composition {
    ObservationRefused { cause: _ } => PreOsConsoleSpan { chunks: [current], payload: text, composition: composition }
    ObservationEstablished { observed: combined } => match previous {
      Present { value: before } => PreOsConsoleSpan { chunks: concat(before.chunks, [current]), payload: combined, composition: composition }
      Absent => PreOsConsoleSpan { chunks: [current], payload: text, composition: composition }
    }
  }
}

// A byte position cannot be compared with an anchor in another source stream.
// Preserve that refusal, rather than treating it as a nonmatching chunk.
fn pre_os_cycle_anchor(chunks: List<PreOsReplayObservation>, at: StreamPosition) -> ObservationAttempt<PreOsCapturedCycleAnchor, PreOsRefusal> {
  match chunks.first() {
    Absent => ObservationRefused { cause: pre_os_text_refusal(text: "cycle marker is outside the supplied source ranges") }
    Present { value: chunk } => match compare_positions(a: chunk.envelope.chunk.range.first, b: at) {
      PositionIncomparable { left, right } => ObservationRefused { cause: PreOsRefusal { location: ["cycle anchor"], detail: PreOsPositionRefusal { order: PositionIncomparable { left: left, right: right } } } }
      PositionAfter => pre_os_cycle_anchor(chunks: chunks.skip(n: 1), at: at)
      PositionBefore => match compare_positions(a: at, b: range_end(range: chunk.envelope.chunk.range)) {
        PositionBefore => ObservationEstablished { observed: PreOsCapturedCycleAnchor { occurrence: chunk.envelope.chunk.occurrence, stream_offset: at } }
        PositionIncomparable { left, right } => ObservationRefused { cause: PreOsRefusal { location: ["cycle anchor"], detail: PreOsPositionRefusal { order: PositionIncomparable { left: left, right: right } } } }
        PositionSame => pre_os_cycle_anchor(chunks: chunks.skip(n: 1), at: at)
        PositionAfter => pre_os_cycle_anchor(chunks: chunks.skip(n: 1), at: at)
      }
      PositionSame => match compare_positions(a: at, b: range_end(range: chunk.envelope.chunk.range)) {
        PositionBefore => ObservationEstablished { observed: PreOsCapturedCycleAnchor { occurrence: chunk.envelope.chunk.occurrence, stream_offset: at } }
        PositionIncomparable { left, right } => ObservationRefused { cause: PreOsRefusal { location: ["cycle anchor"], detail: PreOsPositionRefusal { order: PositionIncomparable { left: left, right: right } } } }
        PositionSame => pre_os_cycle_anchor(chunks: chunks.skip(n: 1), at: at)
        PositionAfter => pre_os_cycle_anchor(chunks: chunks.skip(n: 1), at: at)
      }
    }
  }
}

fn pre_os_captured_cycles(span: PreOsConsoleSpan, host_mac: NonEmptyStr) -> List<PreOsCapturedCycleReading> {
  match span.chunks.first() {
    Absent => []
    Present { value: first } => {
      let marker = mtcollins_dram_cycle_start as String
      let parts = split(s: span.payload, delimiter: marker)
      let prefix_bytes = match parts.first() { Absent => byte_size(count: 0) Present { value: prefix } => pre_os_utf8_size(text: prefix) }
      let scanned = fold(parts.skip(n: 1), init: PreOsCycleScan { next_offset: position_advanced_by(p: first.envelope.chunk.range.first, extent: prefix_bytes), cycles: [] }, f: (acc, part) => {
        let anchor = pre_os_cycle_anchor(chunks: span.chunks, at: acc.next_offset)
        let cycle = PreOsCapturedCycleReading {
          firmware_attempt: ObservationRefused { cause: "no evidence joins this captured cycle to a firmware boot identity" },
          kernel_boot: ObservationRefused { cause: "host milestone does not supply a kernel boot UUID" },
          anchor: anchor,
          milestones: pre_os_milestones(console: ObservationEstablished { observed: part }, os_boot: pre_os_host_userspace_boot(text: part, host_mac: host_mac)),
          firmware_selection: pre_os_firmware_boot_selection(text: part, host_mac: host_mac),
        }
        PreOsCycleScan { next_offset: position_advanced_by(p: position_advanced_by(p: acc.next_offset, extent: pre_os_utf8_size(text: marker)), extent: pre_os_utf8_size(text: part)), cycles: concat(acc.cycles, [cycle]) }
      })
      scanned.cycles
    }
  }
}

type PreOsTimelineRow {
  observation: PreOsReplayObservation
  retention: RetentionExposure
  association: ObservationAttempt<ObservationEnvelope, PreOsRefusal>
  console_composition: ObservationAttempt<String, PreOsRefusal>
  cycles: List<PreOsCapturedCycleReading>
  sel: ObservationAttempt<PreOsSelIngestion, PreOsRefusal>
  configuration: ObservationAttempt<MemoryConfiguration, PreOsRefusal>
  boot: GoalAssessment<NonEmptyStr, NonEmptyStr, NonEmptyStr, PreOsRefusal>
  training: GoalAssessment<NonEmptyStr, NonEmptyStr, NonEmptyStr, PreOsRefusal>
  present_admission: GoalAssessment<NonEmptyStr, NonEmptyStr, NonEmptyStr, PreOsRefusal>
}

type PreOsTimelineFold { rows: List<PreOsTimelineRow>, cursors: List<PreOsSelCursor>, console_spans: List<PreOsConsoleSpan> }

// No clock is read. A SEL observation remains unassociated with console cycles,
// even if its receive timestamp is very close. Input order is replay order, not
// a claimed total chronology across source clock domains.
fn pre_os_machine_timeline(machine: NonEmptyStr, observations: List<PreOsReplayObservation>, host_mac: NonEmptyStr, inventory_question: ObservationAttempt<PreOsInventoryQuestion, NonEmptyStr>) -> List<PreOsTimelineRow> {
  let envelopes = map(observations, o => o.envelope)
  let result = fold(pre_os_unique_occurrences(envelopes: envelopes), init: PreOsTimelineFold { rows: [], cursors: [], console_spans: [] }, f: (acc, envelope) => {
    match filter(observations, candidate => pre_os_same_envelope(a: candidate.envelope, b: envelope)).first() {
    Absent => acc
    Present { value: o } => {
    let association: ObservationAttempt<ObservationEnvelope, PreOsRefusal> = if o.envelope.binding.enrolled_machine != machine {
      ObservationRefused { cause: PreOsRefusal { location: ["timeline machine"], detail: PreOsMachineDisagrees { expected: machine, observed: o.envelope.binding.enrolled_machine } } }
    } else if pre_os_occurrence_conflicts(envelopes: envelopes, subject: o.envelope) {
      ObservationRefused { cause: PreOsRefusal { location: ["timeline occurrence"], detail: PreOsOccurrenceConflict { subject: o.envelope } } }
    } else { match o.payload {
      ObservationRefused { cause } => ObservationRefused { cause: pre_os_text_refusal(text: cause) }
      ObservationEstablished { observed: _ } => pre_os_bound_envelope(envelope: o.envelope)
    } }
    let previous: ObservationAttempt<PreOsSelCursor, PreOsRefusal> = match filter(acc.cursors, c => pre_os_same_source(a: c.envelope, b: o.envelope)).first() {
      Absent => ObservationRefused { cause: pre_os_text_refusal(text: "no source cursor") }
      Present { value: c } => ObservationEstablished { observed: c }
    }
    let sel: ObservationAttempt<PreOsSelIngestion, PreOsRefusal> = match o.format {
      PreOsConsoleText => ObservationRefused { cause: pre_os_text_refusal(text: "console source is not a SEL snapshot") }
      PreOsSelSnapshot => match association {
        ObservationRefused { cause } => ObservationRefused { cause: cause }
        ObservationEstablished { observed: _ } => match o.payload {
          ObservationRefused { cause } => ObservationRefused { cause: pre_os_text_refusal(text: cause) }
          ObservationEstablished { observed: text } => ObservationEstablished { observed: pre_os_ingest_sel(previous: previous, envelope: o.envelope, payload: text) }
        }
      }
    }
    let remaining = filter(acc.cursors, c => !pre_os_same_source(a: c.envelope, b: o.envelope))
    let cursors = match o.format {
      PreOsConsoleText => acc.cursors
      PreOsSelSnapshot => match sel {
        ObservationEstablished { observed: reading } => match reading.cursor {
          ObservationEstablished { observed: cursor } => concat([cursor], remaining)
          ObservationRefused { cause: _ } => remaining
        }
        ObservationRefused { cause: _ } => remaining
      }
    }
    let previous_span = filter(acc.console_spans, span => match span.chunks.first() {
      Absent => false
      Present { value: first } => pre_os_same_source(a: first.envelope, b: o.envelope)
    }).first()
    let span = pre_os_console_span(previous: previous_span, current: o)
    let console_spans = match o.format {
      PreOsSelSnapshot => acc.console_spans
      PreOsConsoleText => concat(match association { ObservationEstablished { observed: _ } => [span] _ => [] }, filter(acc.console_spans, old => match old.chunks.first() {
        Absent => false
        Present { value: first } => !pre_os_same_source(a: first.envelope, b: o.envelope)
      }))
    }
    let console: ObservationAttempt<String, PreOsRefusal> = match association {
      ObservationRefused { cause } => ObservationRefused { cause: cause }
      ObservationEstablished { observed: _ } => match o.format {
        PreOsConsoleText => match pre_os_composable_payload(observation: o) {
          ObservationRefused { cause } => ObservationRefused { cause: pre_os_refusal_at(cause: cause, location: "current chunk") }
          ObservationEstablished { observed: _ } => ObservationEstablished { observed: span.payload }
        }
        PreOsSelSnapshot => ObservationRefused { cause: pre_os_text_refusal(text: "SEL observations do not establish console milestones") }
      }
    }
    let configuration: ObservationAttempt<MemoryConfiguration, PreOsRefusal> = match inventory_question {
      ObservationRefused { cause } => ObservationRefused { cause: pre_os_text_refusal(text: cause) }
      ObservationEstablished { observed: question } => match console {
        ObservationRefused { cause } => ObservationRefused { cause: cause }
        ObservationEstablished { observed: text } => match pre_os_inventory_observation(question: question, payload: text) {
          ObservationEstablished { observed } => ObservationEstablished { observed: observed }
          ObservationRefused { cause } => ObservationRefused { cause: pre_os_text_refusal(text: cause) }
        }
      }
    }
    let milestones: ObservationAttempt<PreOsMilestones, PreOsRefusal> = match console {
      ObservationRefused { cause } => ObservationRefused { cause: cause }
      ObservationEstablished { observed: text } => ObservationEstablished { observed: pre_os_milestones(console: ObservationEstablished { observed: text }, os_boot: pre_os_host_userspace_boot(text: text, host_mac: host_mac)) }
    }
    let row = PreOsTimelineRow {
      retention: retention_exposure(envelope: o.envelope),
      configuration: configuration, sel: sel, observation: o, association: association,
      console_composition: match o.format { PreOsConsoleText => span.composition PreOsSelSnapshot => ObservationRefused { cause: pre_os_text_refusal(text: "SEL snapshot is not a console span") } },
      cycles: match console { ObservationEstablished { observed: _ } => pre_os_captured_cycles(span: span, host_mac: host_mac) ObservationRefused { cause: _ } => [] },
      boot: match milestones {
        ObservationRefused { cause } => GoalAssessmentRefused { cause: cause }
        ObservationEstablished { observed: value } => pre_os_assessment_refusal(assessment: pre_os_boot_assessment(milestones: value))
      }, training: match configuration {
        ObservationRefused { cause } => GoalAssessmentRefused { cause: cause }
        ObservationEstablished { observed: _ } => match milestones {
          ObservationRefused { cause } => GoalAssessmentRefused { cause: cause }
          ObservationEstablished { observed: value } => pre_os_assessment_refusal(assessment: pre_os_training_assessment(milestones: value))
        }
      },
      present_admission: GoalIndeterminate { known_deviations: [], unknowns: FreeSemigroup { head: "historical milestones are not present fleet admission evidence", tail: Empty } },
    }
    PreOsTimelineFold { rows: concat(acc.rows, [row]), cursors: cursors, console_spans: console_spans }
    }
    }
  })
  result.rows
}

// The published view is derived, never a second handwritten ledger authority.
// Supplied commit and continuity carriers do not measure durable storage.
// This replay boundary receives no executed guarantee measurement at a declared
// persistence subject grain, so it cannot report a rung, including mitigatable.
// A future consumer must supply that measurement before establishing a rung.
data pre_os_replay_persistence_rung: ObservationAttempt<GuaranteeRung, NonEmptyStr> = ObservationRefused {
  cause: "replay supplies no executed persistence guarantee measurement",
}

// Render the typed assessment beside retention; do not infer a rung from a
// supplied commit standing or publish structural proof of durable storage.
fn pre_os_timeline_view(rows: List<PreOsTimelineRow>) -> String {
  join(map(rows, row => concat(to_string(row.observation.envelope), "\nassociation=", to_string(row.association),
    "\nconsole_composition=", to_string(row.console_composition),
    "\nretention=", to_string(row.retention),
    "\npersistence_evidence=", to_string(pre_os_replay_persistence_rung),
    "\nsel=", to_string(row.sel), "\ncycles=", to_string(row.cycles), "\nboot=", to_string(row.boot), "\ntraining=", to_string(row.training),
    "\nconfiguration=", to_string(row.configuration), "\npresent_admission=", to_string(row.present_admission))), "\n\n")
}

// The acquisition boundary supplies envelopes; this observer reads their
// artifacts, assesses them, and returns the derived view without actuation.
type PreOsReplayRequest { envelope: ObservationEnvelope, format: PreOsSourceFormat }

fn replay_pre_os_machine(machine: NonEmptyStr, requests: List<PreOsReplayRequest>, host_mac: NonEmptyStr, inventory_question: ObservationAttempt<PreOsInventoryQuestion, NonEmptyStr>) -> List<PreOsTimelineRow> {
  let observations = map(requests, request => pre_os_read_observation(envelope: request.envelope, format: request.format))
  pre_os_machine_timeline(machine: machine, observations: observations, host_mac: host_mac, inventory_question: inventory_question)
}

// The production absence route obtains the byte standing from acquisition and
// reads the exact artifact named by that envelope before asking the inventory
// question. Callers cannot provide an unrelated payload or a silence flag here.
fn replay_pre_os_diagnostic_absence(envelope: ObservationEnvelope, question: PreOsInventoryQuestion, diagnostic: NonEmptyStr) -> GoalAssessment<NonEmptyStr, NonEmptyStr, NonEmptyStr, PreOsRefusal> {
  let observation = pre_os_read_observation(envelope: envelope, format: PreOsConsoleText)
  match observation.payload {
    ObservationRefused { cause } => GoalAssessmentRefused { cause: pre_os_text_refusal(text: cause) }
    ObservationEstablished { observed: payload } => pre_os_diagnostic_absence(question: question, payload: payload,
      source: source_byte_fact(envelope: envelope, requested: envelope.chunk.range), diagnostic: diagnostic),
  }
}
