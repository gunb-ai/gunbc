// ONE MANAGED HOST'S FAN OBSERVATION, OVER ITS BINDING (managed-host cut 5; first written for Mt.
// Collins). The producer (gunbc.machine_intake.bmc_fan_observation) reads the sensor series over IPMI,
// which no BMC family owns; what is family-specific is only the POLICY the series is read against, and
// that is SELECTED from the family the host's controller was observed to be
// (gunbc.fleet.fleet_fan_converge_routes fan_observation_authority_for_family), never assumed. A host whose
// controller was never observed has no family to select from and REFUSES with a cause naming the
// missing observation: it is never read against either policy by default. That is Mt. Jade's case
// (gunbc.machine_intake.mtjade1_access_observation: its family is unobserved).
//
// The controller, its account and the host the samples are attributed to all come off the binding.
// How many samples, how far apart, the transition window and where the receipt lands are the caller's
// policy, so a second host needs a second binding and no edit here.

// THE BOUND HOST WITH ITS SELECTED AUTHORITY. Sealed: minted only by fan_observe_from_standing, which
// reads it off a BmcControlBoundRoute (sole-constructed by gunbc.host.bmc_control_binding), so no controller,
// account or authority reaches the read except through a binding.
type FanObserveHost sole_constructor {
  host: HostIdentity
  observation: BmcAccessObservation
  account: NonEmptyStr
  authority: FanPolicyAuthority
}

type FanObserveRefusal
  = FanHostNotManaged { host: NonEmptyStr }
  | FanHostFamilyUnobserved { endpoint: BmcControllerEndpoint }
  | FanHostNotSecured { cause: BmcSecureRefusalCause }
  | FanHostEndpointMismatch { observed: BmcControllerEndpoint, secured: BmcControllerEndpoint }

type FanObserveAdmission
  = FanObserveAdmitted { host: FanObserveHost }
  | FanObserveRefused { cause: FanObserveRefusal }

// THE FAN READING FOR ONE MANAGED ROW. The host identity comes from the row; the observation and the
// account are read through the bound CONTROL ROUTE (gunbc.host.bmc_control_binding), so the sensors are
// read against the controller the join checked and with the account that answered there -- never a
// pairing the join never made. A bound route that names no account is refused: there is nothing to read
// sensors with.
fn fan_observe_from_standing(host: ManagedHost, standing: BmcControlStanding) -> FanObserveAdmission {
  match standing {
    BmcControlBound { route: r } =>
      match bmc_control_route_account(route: r) {
        Absent => FanObserveRefused { cause: FanHostNotSecured { cause: ManagedCredentialUnestablished { detail: "the bound control route names no managed account" } } }
        Present { value: account } =>
          FanObserveAdmitted {
            host: FanObserveHost {
              host: host.host,
              observation: r.observation,
              account: account,
              authority: fan_observation_authority_for_family(family: r.observation.identity.firmware.family),
            },
          }
      }
    BmcControlAccessUnobserved { endpoint: e } => FanObserveRefused { cause: FanHostFamilyUnobserved { endpoint: e } }
    BmcControlNotSecured { cause: c } => FanObserveRefused { cause: FanHostNotSecured { cause: c } }
    BmcControlEndpointMismatch { observed: o, secured: sec } => FanObserveRefused { cause: FanHostEndpointMismatch { observed: o, secured: sec } }
  }
}

fn fan_observe_admission(lookup: ManagedHostLookup) -> FanObserveAdmission {
  match lookup {
    ManagedHostNotManaged { host: h } => FanObserveRefused { cause: FanHostNotManaged { host: h } }
    ManagedHostFound { host: row, control: c } => fan_observe_from_standing(host: row, standing: c)
    ManagedHostFoundUnderDeclaredDrop { host: row, control: c, drop: _, standing_subject: _, current_subject: _ } =>
      fan_observe_from_standing(host: row, standing: c)
  }
}

fn fan_observe_refusal_text(cause: FanObserveRefusal) -> NonEmptyStr {
  let why = match cause {
    FanHostNotManaged { host: h } => join(["'", h as String, "' is not a managed host (gunbc.host.managed_host managed_hosts has no row for it)"], "")
    FanHostFamilyUnobserved { endpoint: e } => join(["the controller at ", e.host as String, " was never observed, so its BMC family -- and so the fan policy its series is read against -- is unread"], "")
    FanHostNotSecured { cause: _ } => "the controller is not BmcSecured, so this run holds no account to read sensors with"
    FanHostEndpointMismatch { observed: o, secured: sec } => join(["the observed controller ", o.host as String, " is not the secured one ", sec.host as String], "")
  }
  concat(why, "; contacting NO host") as NonEmptyStr
}

// THE AUTHORITY AN ADMITTED HOST'S SERIES IS READ AGAINST, so a caller can name it without the carrier.
fn fan_observe_authority(host: FanObserveHost) -> FanPolicyAuthority {
  host.authority
}

// THE CALLER'S POLICY FOR ONE SERIES: its length, its spacing, the post-transition window its standings
// are judged in, and where its receipt lands.
type FanObservePolicy {
  rounds: ObservationRoundCount
  interval: Second
  transition_window: Second
  receipt_path: String
}

// THE COMPARISON DUTY IS ONE HUNDRED PERCENT, AND THAT IS THIS RUN'S QUESTION RATHER THAN A FACT
// ABOUT ANY FAMILY. Neither family authority publishes a failsafe duty and this module may not invent
// one. What passing 100 asks is narrower and defensible - "is the drive at maximum" - which is exactly
// the state the operator described on Mt. Jade. It is spelled as a literal because percent() admits a
// literal only (std.measure percent_from_computed_int_frontier).
//
// NINETY-FIVE PERCENT IS THIS LANE'S STATED TOLERANCE, NOT A FACT ABOUT ANY FAN. It selects between
// NearCatalogMaximum and BelowCatalogMaximum on a SPEED observation; it cannot reach a failsafe verdict,
// because no tolerance converts RPM into a commanded duty (operator ruling 2026-09-18). No fan part is
// modeled for any managed host, so catalog_maximum is Absent and the tolerance is not consulted today.
//
// ONE STANDING PER SAMPLE, EACH WITH THE SITE DUTY VERDICT BESIDE IT, so the verdict can be re-derived
// from the artifact rather than from a summary.
fn render_sample_standing(host: FanObserveHost, window: Second, sample: FanPolicySample, elapsed: Second?) -> String {
  let standing = fan_policy_standing_of_sample(
    host: host.host,
    authority: host.authority,
    sample: sample,
    failsafe_duty: percent(100),
    catalog_maximum: Absent,
    at_maximum_tolerance: percent(95),
    elapsed_since_post: elapsed,
    transition_window: window,
  )
  join([
    "  standing fan=", sample.endpoint.name as String,
    " at=", sample.observed_at as String,
    " verdict=", fan_policy_standing_label(standing: standing) as String,
    " residence_duty=", render_duty_verdict(verdict: residence_duty_verdict(standing: standing)),
  ], "")
}

// THE TWO OVER-ARMS RENDER DISTINCTLY, because their remedies differ: a curve over the ceiling is
// something to converge, and an excursion over it is something to bound in time or to end by
// powering the machine off.
fn render_duty_verdict(verdict: FanDutyCeilingVerdict) -> String {
  match verdict {
    FanDutyWithinCeiling { duty: _, ceiling: _ } => "WithinCeiling"
    FanDutySteadyCurveOverCeiling { duty: _, ceiling: _ } => "SteadyCurveOverCeiling"
    FanDutyExcursionOverCeiling { duty: _, ceiling: _, bound: b } => join(["ExcursionOverCeiling(", render_excursion_bound(bound: b), ")"], "")
    FanDutyNotReported { cause: _ } => "NotReported"
  }
}

// THE BOUND RENDERS AS WHAT IT IS, and the pre-POST case says so in words rather than as a zero: nothing
// bounds such an excursion but powering the machine off.
fn render_excursion_bound(bound: ExcursionBound) -> String {
  match bound {
    NoPostTransitionWindow => "no post-transition window; bounded only by power-off"
    WithinPostTransitionWindow { elapsed: e, window: w } =>
      join(["within window, elapsed=", to_string(second_count(s: e)), "s of ", to_string(second_count(s: w)), "s"], "")
    OutlivedPostTransitionWindow { elapsed: e, window: w } =>
      join(["OUTLIVED window, elapsed=", to_string(second_count(s: e)), "s past ", to_string(second_count(s: w)), "s"], "")
  }
}

// EACH ROUND'S SAMPLES ARE STAMPED WITH THAT ROUND'S OWN ELAPSED, never with the series'. The first
// posted index is a property of the series and is computed once; the elapsed is the round's.
//
// run_verbose IS NOT OPTIONAL AND IT IS NOT INFERRED: the standalone observe mode passes the capture it
// took, and the boot lane takes NO such parameter -- boot_observation_content below fixes its state.
// A reader of the receipt can therefore tell the three states apart -- not_taken, unread, captured --
// and no lane can silently claim a repository read it never issued (manager msg_cdf72bcc acceptance 2,
// the discriminating host-off control).
fn render_observation(host: FanObserveHost, window: Second, rounds: List<FanObservationRound>, interval: Second, run_verbose: RunVerboseCapture) -> String {
  let first_posted = first_posted_round_index(rounds: rounds)
  join([
    render_series(rounds: rounds),
    render_run_verbose_block(capture: run_verbose),
    join(
      map(rounds, r => render_round_standings(host: host, window: window, round: r, first_posted: first_posted, interval: interval)),
      "\n",
    ),
  ], "\n")
}

// THE BOOT LANE'S OBSERVATION TEXT, and the only place that lane's verbose state is chosen. The literal
// below is NOT an argument a caller hands in: this function takes no RunVerboseCapture at all, so there
// is no signature through which the boot lane could claim a repository read it never issued. The state
// is a property of the lane, enforced by construction rather than by review, and
// test.claim.machine_intake.fan_observe_witness the_boot_lane_cannot_claim_a_repository_read_it_never_issued
// executes THIS function and goes red on written bytes if the literal is ever swapped for a capture or
// the lane grows an inferred read.
fn boot_observation_content(host: FanObserveHost, window: Second, rounds: List<FanObservationRound>, interval: Second) -> String {
  render_observation(host: host, window: window, rounds: rounds, interval: interval, run_verbose: RunVerboseNotTaken)
}

fn render_round_standings(host: FanObserveHost, window: Second, round: FanObservationRound, first_posted: Int?, interval: Second) -> String {
  let elapsed = elapsed_at_round(round: round, first_posted_index: first_posted, interval: interval)
  join(
    map(
      samples_of_round(host: host.host, round: round),
      s => render_sample_standing(host: host, window: window, sample: s, elapsed: elapsed),
    ),
    "\n",
  )
}

// THE ADMITTED READ. Sealed to the one entry that binds a managed host's row to it; it returns a
// ProcessExit, never a carrier. The credential file is the caller's
// (gunbc.machine_intake.mtcollins1_bmc_secure_observation mtcollins1_managed_secret_fetch_frontier).
fn fan_observe_with(host: FanObserveHost, password_file: NonEmptyStr, policy: FanObservePolicy) -> ProcessExit
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_fan_observe", decl_name: "mtcollins1_fan_observe_wet"),
  ]
{
  // THE RUN-SCOPE VERBOSE CAPTURE (M2a): issued ONCE, before the round loop, UNCONDITIONALLY -- the SDR
  // repository is BMC-side and readable with the host OFF, which is exactly the state every fan_observe
  // run has come back in (run 41389794851: chassis=off in all 6 rounds, thermal undecoded=0 every round,
  // so the round-scope conditional correctly never fired and the capture carried no records). Taking it
  // BEFORE the loop means the records exist even if a later round times out. The boot phase does not do
  // this and must not: fan_observe_boot_phase_with renders through boot_observation_content, which takes
  // no capture parameter and fixes the state to RunVerboseNotTaken.
  let run_verbose = observe_verbose_repository(
    bmc_host: host.observation.endpoint.host,
    username: host.account,
    password_file: password_file,
    cipher_suite: bmc_observation_ipmi_cipher_suite(observation: host.observation),
  )
  fan_write_observation(
    host: host,
    policy: policy,
    run_verbose: run_verbose,
    series: observe_fan_policy(
      bmc_host: host.observation.endpoint.host,
      username: host.account,
      password_file: password_file,
      rounds: policy.rounds,
      interval: policy.interval,
      cipher_suite: bmc_observation_ipmi_cipher_suite(observation: host.observation),
    ),
  )
}

// THE RECEIPT IS WRITTEN ONLY FOR A SERIES THAT WAS TAKEN. A refused observation's text would leave an
// artifact that LOOKS like a measurement attached to a run that failed.
fn fan_write_observation(host: FanObserveHost, policy: FanObservePolicy, series: FanObservationSeries, run_verbose: RunVerboseCapture) -> ProcessExit {
  match series {
    FanObservationRefused { cause: cause } =>
      exit_failure(reason: concat("fan observation: ", cause as String))
    FanObservationTaken { rounds: rounds, interval: interval } => {
      let written = Filesystem.Write(
        path: policy.receipt_path,
        content: render_observation(host: host, window: policy.transition_window, rounds: rounds, interval: interval, run_verbose: run_verbose),
      )
      if written.success {
        ExitSuccess
      } else {
        exit_failure(reason: concat("fan observation: the series was taken and its receipt could not be written: ", written.error))
      }
    }
  }
}

// THE TWO RECEIPT PREFIXES ARE THE BOOT PHASE'S TYPED OUTCOME, AND THIS IS THE ONE PLACE THEY ARE SPELLED.
// Every writer builds its line from them and the step's outcome tail reads them; the tail treats the
// outcome as observed ONLY when the receipt opens with the taken prefix, so a drifted or unknown line
// reads as refused (fail-closed), never as an observed reading.
data fan_boot_phase_refused_prefix: String = "FanObserveBootPhaseRefused"
data fan_boot_phase_taken_prefix: String = "FanObserveBootPhaseTaken"

// THE THIRD OUTCOME: THE POLICY PHASE COULD NOT JUDGE THE FANS BECAUSE THE HOST WAS OFF IN EVERY ROUND.
// A powered-off chassis publishes no tach, so a series of off rounds is not evidence that fans work and
// is no longer written as Taken. It is not a refusal either: the boot has not powered the host yet, so
// the judgement belongs to the post-power-on read inside the boot step, which gates the boot there. The
// reason is a closed word and the tag is spelled here once, beside its siblings.
data fan_boot_phase_unestablished_host_off_line: String = "FanObserveBootPhaseFanFunctionNotEstablished reason=HostOff"

// EVERY ROUND READ THE CHASSIS AS OFF. An unreadable or undecodable chassis read is NOT off: it is no
// reading, and a series containing one is judged as it always was (it carries no host-off claim).
fn series_host_off_in_every_round(rounds: List<FanObservationRound>) -> Bool {
  rounds.length() > 0 && fold(rounds, init: true, f: (acc, r) => acc && chassis_observation_is_off(observation: r.chassis))
}

// BOOT-JOB WRAPPER: write the typed receipt and return success on observation refusal (non-gating,
// and non-gating because the entry decides it in a receipt - no job-level continue-on-error absorbs
// anything: an unwritable receipt fails the step, review 81077).
fn fan_observe_boot_phase_with(host: FanObserveHost, password_file: NonEmptyStr, policy: FanObservePolicy) -> ProcessExit
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtcollins1_fan_observe", decl_name: "mtcollins1_fan_observe_boot_phase_wet"),
  ]
{
  fan_write_boot_phase_observation(
    host: host,
    policy: policy,
    series: observe_fan_policy(
      bmc_host: host.observation.endpoint.host,
      username: host.account,
      password_file: password_file,
      rounds: policy.rounds,
      interval: policy.interval,
      cipher_suite: bmc_observation_ipmi_cipher_suite(observation: host.observation),
    ),
  )
}

fn fan_write_boot_phase_observation(host: FanObserveHost, policy: FanObservePolicy, series: FanObservationSeries) -> ProcessExit {
  match series {
    FanObservationRefused { cause: cause } =>
      match fan_write_boot_phase_receipt(
        path: policy.receipt_path,
        content: concat(concat(fan_boot_phase_refused_prefix, " cause="), cause as String),
      ) {
        ExitSuccess => ExitSuccess
        ExitFailure { code: code, reason: written_reason } =>
          ExitFailure { code: code, reason: written_reason }
      }
    FanObservationTaken { rounds: rounds, interval: interval } =>
      fan_write_boot_phase_receipt(
        path: policy.receipt_path,
        content: concat(
          concat(if series_host_off_in_every_round(rounds: rounds) {
            fan_boot_phase_unestablished_host_off_line
          } else {
            fan_boot_phase_taken_prefix
          }, "\n"),
          boot_observation_content(host: host, window: policy.transition_window, rounds: rounds, interval: interval),
        ),
      )
  }
}

fn fan_write_boot_phase_receipt(path: String, content: String) -> ProcessExit {
  let written = Filesystem.Write(path: path, content: content)
  if written.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("fan observation boot phase: receipt could not be written: ", written.error))
  }
}
