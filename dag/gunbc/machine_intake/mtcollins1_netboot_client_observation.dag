module gunbc.machine_intake.mtcollins1_netboot_client_observation

import std.types { EpochMs, Int, NonEmptyStr }
import extdeps.numeric.base16 { base16_digit_rows }
import extdeps.network.mac { Eui48Address, mac_address, render_mac_address }
import std.content_hash { ContentHash, Sha256Digest, Sha256Hash }
import extdeps.provisioning.network_boot { ClientNetworkBootMode, UefiPxe }

// THE HOST NETBOOTS, MEASURED RATHER THAN ASSUMED. Everything else in this lane concerns the
// CONTROLLER; this module is about the HOST, and it answers the question that decides whether any
// netboot delivery is possible at all: does this machine's firmware actually speak PXE. It does.
//
// HOW IT WAS TRIGGERED, which is what makes this an observation of the automation and not of a
// human at a console: the unit's netboot handoff entry of that day (mtcollins1_netboot_handoff, deleted
// with gunbc#12101; the unit actuation module itself was dissolved into gunbc.host.managed_host_boot_handoff
// by managed-host cut 4a) set the boot device, verified boot parameter 5 read back Force PXE, and
// power-cycled the unit. The DHCP
// exchange below is what the host did in response, captured from srv2 on the same /24.
//
// THE THIRD MAC IS THE POINT. An earlier capture in this lane saw DHCP from 28:c1:3c:8a:d6:4d and
// was read as the host PXE-booting; it was not. That address is the CONTROLLER'S SECOND NIC, and
// its vendor class is "udhcp 1.21.1" — BusyBox userspace, i.e. the BMC's own Linux asking for an
// address, which is a different machine-state entirely from firmware netbooting. The unit presents
// three addresses and confusing any two of them produces a false reading:
//
//   28:c1:3c:8a:d6:4c  controller, dedicated, 192.168.1.228
//   28:c1:3c:8a:d6:4d  controller, second NIC, 192.168.1.231 (same mc info, same firmware 0.32)
//   28:c1:3c:8a:d6:4a  HOST NIC — this row
//
// The discriminator is not the address but the VENDOR CLASS: a PXE client identifies itself as
// PXEClient:Arch:NNNNN and requests a boot file; a Linux DHCP client does neither.

// THE READING IS SIX OCTETS, NOT A STRING. This row was a NonEmptyStr holding the colon text and
// every consumer had to decode it again if it wanted to know anything about it — which octet was
// the OUI, whether two rows were the same machine — and the row that carried it could itself be a
// typo that no type would catch. Plan gunbc.plans.site_segment_anchor_bmc_reach phase S1 moved it
// onto extdeps.network.mac Eui48Address, the carrier whose whole point is that an address IS its
// six octets (it refuses construction by text and takes the octets as typed numbers instead). The
// octets below are the ones in the capture cited above, read off the packet's Client-Ethernet-Address
// and chaddr fields; the digest and byte count pinned beside them are what make a wrong digit here
// detectable rather than plausible. The colon form is now something the address RENDERS TO
// (extdeps.network.mac render_mac_address), not something it is.
data mtcollins1_host_nic_mac: Eui48Address = mac_address(octet1: 40, octet2: 193, octet3: 60, octet4: 138, octet5: 214, octet6: 74)

// Firmware's PXE line renders the same host address with dashes and UPPERCASE hexadecimal digits —
// the one rendering in this lane that is neither the canonical colon form nor a parse input. It
// takes the address rather than text now, and renders FROM the octets: lowercase colon form from the
// carrier's own authority, then ':' to '-' and each lowercase digit to its uppercase pair through the
// existing base16 encoding authority. Taking a string here would have meant re-decoding an address we
// already have, and a rendering that decodes can get the address wrong at render time.
fn firmware_pxe_mac_rendering(host_mac: Eui48Address) -> NonEmptyStr {
  fold(base16_digit_rows, init: replace(s: render_mac_address(addr: host_mac), from: ":", to: "-"),
    f: (rendered, digit) => replace(s: rendered, from: digit.lower, to: digit.upper)) as NonEmptyStr
}


data mtcollins1_netboot_capture_digest: ContentHash = Sha256Hash(Sha256Digest {
  hex: "a29f460b5323f1564a75b2102198e56448b6147440629bdc1154d9822b61d69a",
})

data mtcollins1_netboot_capture_artifact_path: NonEmptyStr = "artifacts/bmc/mtcollins1-host-pxe-client.json"

data mtcollins1_netboot_capture_byte_count: Int = 5075

data mtcollins1_netboot_observed_at: EpochMs = 1788620040000

// THE CLIENT'S OWN SELF-DESCRIPTION, carried verbatim. DHCP option 60 read
// "PXEClient:Arch:00011:UNDI:003016" and option 93 read 11 — two independent statements of the same
// architecture in one exchange. Arch 0x000B is EFI ARM64, which is what an Ampere Altra platform
// should present and is NOT interchangeable with the x86 PXE that most netboot tooling assumes: the
// bootloader served to this client must be an aarch64 EFI binary.
data mtcollins1_pxe_vendor_class: NonEmptyStr = "PXEClient:Arch:00011:UNDI:003016"

// NO ClientNetworkBootMode ROW IS AUTHORED HERE, AND THE ABSENCE IS THE FINDING. The obvious row
// would be UefiPxe, since the client's own vendor class says PXE — but that variant carries a
// `tftp_root: Uri`, and there is no TFTP root: nothing on this segment serves one. The only way to
// author the row is to invent a URI, which is the fabricated value DESIGN §5 forbids, sitting in
// exactly the field a delivery would later be built against. So the observation stops at what was
// measured — the client's self-description above — and the mode stays unauthored until a server
// exists to name.
//
// THAT IS ALSO WHY ClientNetworkBootMode IS IMPORTED AND UNUSED: the import records which vocabulary this
// observation would inhabit once its missing half exists, and removing it would erase the pointer.
//
// WHAT THE CLIENT ASKED FOR AND DID NOT GET is the whole remaining gap, and it is a property of the
// SEGMENT rather than of this machine: 192.168.1.1 answered with an address, gateway, DNS and lease,
// and with NO next-server and NO option 67 in any Offer. So the host is ready to netboot and there
// is nothing on the network to netboot from. Every other piece of this lane — the controller
// observation, the capability row, the out-of-band arm, the executed handoff — is upstream of that
// one absence, and none of them can close it.
data mtcollins1_pxe_arch_code: Int = 11
