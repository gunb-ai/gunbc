module gunbc.machine_intake_mtcollins1_expansion_candidates

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope }
import extdeps.standards.nic_attachment { NicAttachmentClass, attachment_class_authority }
import extdeps.network.mcx4411a_acan { mcx4411a_acan_attachment }
import extdeps.network.mcx4421a_acan { mcx4421a_acan_attachment }
import extdeps.network.mcx4621a_acab { mcx4621a_acab_attachment }
import extdeps.network.dell_0r887v { dell_0r887v_attachment }
import extdeps.network.ibm_01ft753 { Ibm01ft753, ibm_01ft753 }
import extdeps.network.mcx4121a_acat { Mcx4121aAcat, mcx4121a_acat }
import gunbc.machine_intake_mtcollins1_expansion_attachment { AttachmentVerdict, attachment_against_evidence }
import gunbc.machine_intake_mtcollins1_expansion_observation { expansion_evidence_for_unit }
import gunbc.machine_intake_mtcollins1_dimm_connector_observation { observed_unit }
import gunbc.machine_intake_mtcollins1_connectx4lx_observation { connectx4lx_host_observation, Connectx4LxHostObservation }
import extdeps.ampere.mt_collins_1u_product_brief.specifications { mt_collins_1u_ocp_slot }

// Procurement and relayed listing aliases are this workflow's facts, not an
// assertion that IBM or Dell publishes those aliases. Full-height is what the
// operator ordered; IBM's FRU alone allows either tailstock. Arrival and installed
// fit must be observed separately. Consumer: candidate_verdicts -> witness, and
// operator invocation of candidate_verdicts when evaluating these parts.
type CandidateContext
  = CatalogEvaluation
  | RelayedListingAlias { alias: NonEmptyStr, relay_message: NonEmptyStr }
  | OrderedAwaitingArrival {
      reported_alias: NonEmptyStr,
      bracket: OrderedBracket,
      catalog: Ibm01ft753,
      relay_message: NonEmptyStr,
    }
  | InstalledUnobserved {
      ordered: Ibm01ft753,
      arrived: Mcx4121aAcat,
      host: Connectx4LxHostObservation,
      relay_message: NonEmptyStr,
    }

type OrderedBracket = FullHeightBracket {}

type ExpansionCandidate {
  catalog_scope: ExternalModelScope
  attachment: NicAttachmentClass
  context: CandidateContext
}

data expansion_candidates: List<ExpansionCandidate> = [
  ExpansionCandidate { catalog_scope: extdeps.network.mcx4411a_acan.extdeps_model_scope, attachment: mcx4411a_acan_attachment, context: CatalogEvaluation },
  ExpansionCandidate { catalog_scope: extdeps.network.mcx4421a_acan.extdeps_model_scope, attachment: mcx4421a_acan_attachment, context: CatalogEvaluation },
  ExpansionCandidate { catalog_scope: extdeps.network.dell_0r887v.extdeps_model_scope, attachment: dell_0r887v_attachment, context: RelayedListingAlias { alias: "CX422A", relay_message: "node://adhoc-a4cde62f-b45: operator's Dell 0R887V / CX422A candidate" } },
  ExpansionCandidate { catalog_scope: extdeps.network.mcx4621a_acab.extdeps_model_scope, attachment: mcx4621a_acab_attachment, context: CatalogEvaluation },
  ExpansionCandidate {
    catalog_scope: extdeps.network.mcx4121a_acat.extdeps_model_scope,
    attachment: mcx4121a_acat.attachment,
    context: InstalledUnobserved {
      ordered: ibm_01ft753,
      arrived: mcx4121a_acat,
      host: connectx4lx_host_observation,
      relay_message: "node://adhoc-60bfb4b5-7bd: operator 2026-09-17 reports OEM Mellanox ConnectX-4 LX MCX4121A-ACAT seated; IBM FRU 01FT753 / CX4121A was the ordered catalog row. Same silicon class, independently governed products. Host mid first-boot: PCIe and mlx5_core remain unobserved until mtcollins1_boot / gunbc#11484.",
    },
  },
]

type CandidateAttachmentVerdict {
  unit: DeclarationRef
  candidate: ExpansionCandidate
  attachment_authority: ExternalAuthority
  verdict: AttachmentVerdict
}

// This is the executing candidate-to-unit join, not a part-number switch. A new
// card imports its own authority and supplies its attachment class to the same fold.
fn candidate_verdicts(unit: DeclarationRef) -> List<CandidateAttachmentVerdict> {
  let evidence = expansion_evidence_for_unit(unit: unit)
  map(expansion_candidates, f: fn(candidate) { CandidateAttachmentVerdict {
    unit: unit,
    candidate: candidate,
    attachment_authority: attachment_class_authority(attachment: candidate.attachment),
    verdict: attachment_against_evidence(candidate: candidate.attachment, evidence: evidence, bay: mt_collins_1u_ocp_slot),
  } })
}

// Operator entry: gunbc run --entry this module --function mtcollins1_candidate_verdicts.
// It returns the typed receipts, including card citation and unresolved evidence.
fn mtcollins1_candidate_verdicts() -> List<CandidateAttachmentVerdict> {
  candidate_verdicts(unit: observed_unit)
}
