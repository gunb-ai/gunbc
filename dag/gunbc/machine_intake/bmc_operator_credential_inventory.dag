module gunbc.machine_intake.bmc_operator_credential_inventory

import std.types { Bool, List, NonEmptyStr }

// The operator's human record of BMC secrets (default passwords, licence keys) for ALL BMCs. It
// is access-controlled and is never fetched or transcribed here: this module says only that a row
// for a BMC exists in it. Not a route machines read; the Altra BMCs' machine route stays Secret
// Manager (gunbc.secret_provision SecretRef).
type OperatorHeldCredentialInventory {
  document_url: NonEmptyStr
}

type OperatorHeldSecretKind = FactoryLoginCredential | OobLicenceKey

// Keyed by BMC MAC; the row exists and is held by the operator. No value is carried.
type OperatorHeldInventoryRow {
  bmc_mac: NonEmptyStr
  secret: OperatorHeldSecretKind
}

type OperatorHeldInventoryEntries {
  inventory: OperatorHeldCredentialInventory
  rows: List<OperatorHeldInventoryRow>
}

data operator_held_bmc_credential_inventory: OperatorHeldCredentialInventory = OperatorHeldCredentialInventory {
  document_url: "https://docs.google.com/spreadsheets/d/1pElYiQMuGyQb-Ke0dMVlledljyRW4pLV8ak5sn3buDY",
}

// Consumer: BMC first-contact receipts, which reference a secret by this row instead of carrying it.
fn operator_inventory_holds(entries: OperatorHeldInventoryEntries, bmc_mac: NonEmptyStr, secret: OperatorHeldSecretKind) -> Bool {
  any(entries.rows, r => r.bmc_mac == bmc_mac && r.secret == secret)
}
