module gunbc.machine_intake.bmc_operator_credential_inventory

import std.types { Bool, List, NonEmptyStr }
import extdeps.network.mac { Eui48Address, mac_address }
import extdeps.time.rfc3339 { Rfc3339Timestamp }

// The operator's human record of BMC secrets (default passwords, licence keys) for ALL BMCs. It
// is access-controlled and is never fetched or transcribed here: this module carries only the
// operator's ATTESTATION that a row for a BMC exists in it. It is self-attested, so it proves
// nothing about the sheet itself; it names who attested and when. Not a route machines read; the
// Altra BMCs' machine route stays Secret Manager (gunbc.secret_provision SecretRef).
type OperatorHeldCredentialInventory {
  document_url: NonEmptyStr
}

type OperatorHeldSecretKind = FactoryLoginCredential | OobLicenceKey

// A reference from a receipt to a secret: BMC and kind, no value.
type OperatorHeldSecretRef {
  bmc_mac: Eui48Address
  secret: OperatorHeldSecretKind
}

// One attested row, bound to the inventory it is in.
type OperatorAttestedInventoryRow {
  inventory: OperatorHeldCredentialInventory
  row: OperatorHeldSecretRef
  attested_by: NonEmptyStr
  attested_at: Rfc3339Timestamp
}

data operator_held_bmc_credential_inventory: OperatorHeldCredentialInventory = OperatorHeldCredentialInventory {
  document_url: "https://docs.google.com/spreadsheets/d/1pElYiQMuGyQb-Ke0dMVlledljyRW4pLV8ak5sn3buDY",
}

// The declared roster of attested rows; a BMC's row is added here when the operator attests it.
// Consumed in this change by the H11SSL receipt witness (secret references checked against this
// roster); the arrival-intake reader of the roster is the declared frontier named in
// gunbc.machine_intake.supermicro_h11ssl_first_contact.
data operator_attested_bmc_inventory_roster: List<OperatorAttestedInventoryRow> = [
  OperatorAttestedInventoryRow {
    inventory: operator_held_bmc_credential_inventory,
    row: OperatorHeldSecretRef { bmc_mac: mac_address(octet1: 172, octet2: 31, octet3: 107, octet4: 227, octet5: 245, octet6: 123), secret: FactoryLoginCredential },
    attested_by: "operator, relayed by merry-fox-82 (dashboard message msg_0fdd741c)",
    attested_at: "2026-10-17T03:03:31Z",
  },
  OperatorAttestedInventoryRow {
    inventory: operator_held_bmc_credential_inventory,
    row: OperatorHeldSecretRef { bmc_mac: mac_address(octet1: 172, octet2: 31, octet3: 107, octet4: 227, octet5: 245, octet6: 123), secret: OobLicenceKey },
    attested_by: "operator, relayed by merry-fox-82 (dashboard message msg_0fdd741c)",
    attested_at: "2026-10-17T03:03:31Z",
  },
]

fn operator_inventory_attests(roster: List<OperatorAttestedInventoryRow>, inventory: OperatorHeldCredentialInventory, ref: OperatorHeldSecretRef) -> Bool {
  any(roster, r => r.inventory == inventory && r.row == ref)
}
