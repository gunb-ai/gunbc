module gunbc.machine_intake_terminal_transcript

import std.types { List, String }
import extdeps.posix.termios { termios_onlcr_output_lines }
import extdeps.render.ansi { ansi_without_null_fill }

// THE LINES OF A TERMINAL TRANSCRIPT, ONCE, for every reader of one (the host capture envelope, the
// pre-OS observer and its archive replay all read the same SOL channel). A transcript is two facts
// from two authorities, composed here and nowhere else: ECMA-48's NUL fill, which may be removed
// without changing content (extdeps.render.ansi ansi_without_null_fill), and the tty's ONLCR
// terminator (extdeps.posix.termios termios_onlcr_output_lines). NUL goes FIRST, so a line whose
// bytes read CR NUL NL still ends in the mapped CR when ONLCR framing looks for it. mtcollins1_boot
// run 35808203121 carried 550,330 NULs at line starts, ahead of "80" and "----EXIT nproc: 0", and
// no line-start reader recognised either; which hop inserts them is not observed.
fn terminal_transcript_lines(text: String) -> List<String> {
  termios_onlcr_output_lines(text: ansi_without_null_fill(text: text))
}
