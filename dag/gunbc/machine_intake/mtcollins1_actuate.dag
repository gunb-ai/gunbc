module gunbc.machine_intake_mtcollins1_actuate

import std.types { NonEmptyStr, String }
import std.process { ExitSuccess, ProcessExit, exit_failure }
import gunbc.machine_intake_mtcollins1_access_observation { mtcollins1_endpoint }
import gunbc.machine_intake_oob_boot_handoff {
  BootHandoffCompleted,
  BootHandoffNotAdmitted,
  BootSelectionNotApplied,
  BootSelectionRefused,
  PowerCycleRefused,
  oob_boot_handoff,
}

// THE POLICY LAYER FOR ONE HOST, and it is a separate module from the arm on purpose. The arm takes
// device, power action and expected rendering as PARAMETERS because which of those a workflow picks
// is business policy (DESIGN §3); this module is where that policy is decided for Mt. Collins, so
// the arm stays reusable by the next host and by the Sparks without carrying anyone's choices.
//
// THE CLI REACHES ZERO-ARG AND SINGLE-String FUNCS ONLY, which is the mechanical reason this
// wrapper exists at all — the same reason gunbc.tools.bmc_onboard carries srv3_/srv4_ wrappers
// around a parameterized probe. It is NOT a per-host fork of the arm: everything host-specific here
// is a value, and a second host is a second wrapper over the identical operation, never a second
// operation. The one argument is the credential path, for the reason given on mtcollins1_password_file.
data mtcollins1_boot_device: NonEmptyStr = "pxe"

// WHAT ipmitool RENDERS WHEN THE OVERRIDE TOOK. `chassis bootparam get 5` prints a "Boot Device
// Selector : Force PXE" line, and the wire word sent to `chassis bootdev` is "pxe" — two different
// vocabularies for one fact, so the expected text is supplied here rather than guessed inside the
// arm. A mapping guessed there would be a second, undeclared authority on IPMI's boot device names.
// Measured on this unit 2026-09-05.
data mtcollins1_boot_readback_rendering: NonEmptyStr = "Force PXE"

// A CYCLE AND NOT A RESET, because the unit's own SEL is the evidence that a cycle takes effect
// here: driving `chassis power cycle` produced "Power Unit — Power cycle | Asserted" and "System
// Boot Initiated — Initiated by power up". Nothing has established the same for `reset` on this
// controller, and picking the unmeasured verb would assert a capability this repository does not
// hold evidence for.
data mtcollins1_power_action: NonEmptyStr = "cycle"

// THE ADMINISTRATOR ACCOUNT AS MEASURED, not as assumed: `ipmitool user list 1` reports user ID 2
// named "admin" with ADMINISTRATOR privilege as the ONLY enabled account on the channel. This is
// the account the converge rotation phase will re-key, which is why it is a named row rather than
// a literal buried in a call.
data mtcollins1_bmc_username: NonEmptyStr = "admin"

// THE CREDENTIAL ARRIVES AS AN EXPLICIT PATH ARGUMENT, not from the environment. The first draft
// read it from BMC_PASSWORD_FILE through shell.Env.Get and refused at run time with
// `Unimplemented { what: "unknown service operation: shell.Env.Get" }`. THAT DIAGNOSTIC IS
// MISLEADING AND THE OBVIOUS READING OF IT IS WRONG: the operation is implemented and widely used —
// gunbc.actions_run_binding calls it on the live converge path — and it refused here only because
// this module did not carry `import extdeps.shell`. Service operations register from the IMPORT
// CLOSURE, so an unimported service compiles clean and refuses at run time with a message that
// names the operation as unknown rather than the import as missing.
//
// The argument is kept anyway, because it is the better shape independent of that defect: the
// credential's location becomes a declared input the caller must state rather than ambient state
// the func silently depends on, which matters most for the value that rotates mid-program.
//
// AN EMPTY PATH IS REFUSED RATHER THAN DIALLED. Passing "" would otherwise reach ipmitool as a -f
// with no file and fail as an authentication error, which reads as a controller rejecting a
// credential rather than as a caller who supplied none.
fn mtcollins1_password_file(raw: String) -> NonEmptyStr {
  if raw == "" {
    "bmc-password-file-argument-empty" as NonEmptyStr
  } else {
    raw as NonEmptyStr
  }
}

// DRIVES THE REAL CONTROLLER. Every outcome arm is rendered as its own failure reason, because the
// four refusals leave the host in materially different states and a caller retrying needs to know
// which: BootSelectionNotApplied means the override never took and must be re-applied, while
// PowerCycleRefused means it DID take and the controller is holding a next-boot override nothing
// has consumed. Collapsing them into one "handoff failed" would be the state-space conflation
// DESIGN's failure-mode list names.
func mtcollins1_netboot_handoff(password_file_raw: String) -> ProcessExit
  uses net: std.resources.Network
{
  let outcome = oob_boot_handoff(
    bmc_host: mtcollins1_endpoint.host,
    username: mtcollins1_bmc_username,
    password_file: mtcollins1_password_file(raw: password_file_raw),
    device: mtcollins1_boot_device,
    expected_rendering: mtcollins1_boot_readback_rendering,
    power_action: mtcollins1_power_action,
  )

  return match outcome {
    BootHandoffCompleted { selected: _ } => ExitSuccess
    BootSelectionRefused =>
      exit_failure(reason: "mtcollins1 handoff: controller refused the boot source override")
    BootSelectionNotApplied { requested: d, readback: r } =>
      exit_failure(reason: concat("mtcollins1 handoff: override for '", d, "' did not take; boot parameter 5 read back: ", r))
    PowerCycleRefused { selected: d } =>
      exit_failure(reason: concat("mtcollins1 handoff: override for '", d, "' APPLIED but the power cycle was refused; the controller holds an unconsumed next-boot override"))
    BootHandoffNotAdmitted { admission: _ } =>
      exit_failure(reason: "mtcollins1 handoff: controller not admitted for out-of-band drive")
  }
}
