module gunbc.machine_intake_mtcollins1_actuate

import std.types { NonEmptyStr, String }
import std.decl_ref { decl_ref }
import v2.std.optional { Present, Absent }
import gunbc.machine_intake_mtcollins1_maintenance_hold { UnitHoldProof, unit_hold_proof_refusal, mtcollins1_unit_hold_key }
import std.process { ExitSuccess, ProcessExit, exit_failure }
import extdeps.bmc.capability { BmcFirmwareReleaseCapabilityRow }
import gunbc.machine_intake_mtcollins1_access_observation {
  mtcollins1_access_observation,
  mtcollins1_capability_row,
}
import gunbc.machine_intake_mtcollins1_bmc_secure_observation { mtcollins1_secured_account }
import gunbc.machine_intake_oob_boot_handoff {
  BootControlIssued,
  BootHandoffNotAdmitted,
  BootSelectionFlagInvalid,
  BootSelectionNotApplied,
  BootSelectionFirmwareMismatch,
  BootSelectionNotOneShot,
  BootSelectionRefused,
  BootSelectionUnverifiable,
  OobBootHandoffOutcome,
  PowerCommandAcceptedNoTransition,
  oob_power_action_verb,
  power_transition_progress_text,
  PowerCommandRefused,
  PowerStateReadFailed,
  oob_boot_handoff,
}
import extdeps.bmc.ipmi_chassis_control { chassis_observation_text }
import extdeps.bmc.ipmi_boot_selection {
  IpmiBootCdrom,
  IpmiBootSelection,
  aarch64_uefi_once_boot_selection,
}

// THE POLICY LAYER FOR ONE HOST, and it is a separate module from the arm on purpose. The arm takes
// device, power action and expected rendering as PARAMETERS because which of those a workflow picks
// is business policy (DESIGN §3); this module is where that policy is decided for Mt. Collins, so
// the arm stays reusable by the next host and by the Sparks without carrying anyone's choices.
//
// THE CLI REACHES ZERO-ARG AND SINGLE-String FUNCS ONLY, which is the mechanical reason this
// wrapper exists at all — the same reason gunbc.tools.bmc_onboard carries srv3_/srv4_ wrappers
// around a parameterized probe. It is NOT a per-host fork of the arm: everything host-specific here
// is a value, and a second host is a second wrapper over the identical operation, never a second
// operation. The one argument is the credential path, for the reason given on mtcollins1_password_file.
data mtcollins1_cdrom_selection: IpmiBootSelection = aarch64_uefi_once_boot_selection(device: IpmiBootCdrom)

// THE USERNAME IS THE MANAGED ACCOUNT ON BmcSecured, never the published factory literal
// "admin" and never a second spelling of "gunbc". Password remains a caller file-path argument
// on mtcollins1_netboot_handoff / mtcollins1_cdrom_handoff (CLI names unchanged). Absent means
// derive_bmc_secure did not mint BmcSecured; the wrappers refuse before any controller write.
data mtcollins1_bmc_username: NonEmptyStr? = mtcollins1_secured_account()

// THE CREDENTIAL ARRIVES AS AN EXPLICIT PATH ARGUMENT, not from the environment. The first draft
// read it from BMC_PASSWORD_FILE through shell.Env.Get and refused at run time with
// `Unimplemented { what: "unknown service operation: shell.Env.Get" }`. THAT DIAGNOSTIC IS
// MISLEADING: the operation is implemented and widely used — gunbc.actions_run_binding calls it on
// the live converge path — and it refused only because this module did not carry
// `import extdeps.shell`. Service operations register from the IMPORT CLOSURE, so an unimported
// service compiles clean and refuses at run time naming the operation rather than the import.
//
// The argument is kept anyway, because it is the better shape independent of that defect: the
// credential's location becomes a declared input the caller must state rather than ambient state
// the func silently depends on, which matters most for the value that rotates mid-program.
//
// AN EMPTY PATH REFUSES BEFORE ANY EFFECT, and the previous form did not. It substituted the string
// "bmc-password-file-argument-empty" and handed that to ipmitool as a filename — so a caller that
// supplied nothing produced either an authentication failure that reads as the CONTROLLER rejecting
// a credential, or, if a file of that name happened to exist, an unintended credential source. The
// comment called it a refusal; it was a rename. A missing input is now a typed outcome returned
// before the first write, so the zero-effects case is reachable and testable.
type CredentialPathStanding
  = CredentialPathGiven { path: NonEmptyStr }
  | CredentialPathMissing

fn mtcollins1_password_file(raw: String) -> CredentialPathStanding {
  if raw == "" {
    CredentialPathMissing
  } else {
    CredentialPathGiven { path: raw as NonEmptyStr }
  }
}

// DRIVES THE REAL CONTROLLER. Every outcome arm is rendered as its own failure reason, because the
// four refusals leave the host in materially different states and a caller retrying needs to know
// which: BootSelectionNotApplied means the override never took and must be re-applied, while
// a power arm means it DID take and the controller is holding a next-boot override nothing
// has consumed. Collapsing them into one "handoff failed" would be the state-space conflation
// DESIGN's failure-mode list names.
// ONE RENDERER FOR BOTH ROUTES. Each outcome arm gets its own reason because the refusals leave the
// host in materially different states: BootSelectionNotApplied means the override never took and
// must be re-applied; BootSelectionFlagInvalid means the controller reported the selector WHILE
// declaring its boot flags invalid, so the override is present and will not be honoured;
// BootSelectionUnverifiable means the read itself failed and establishes nothing about the
// controller either way; the power arms mean the override APPLIED and the controller now holds
// an unconsumed next-boot override. Collapsing these into one failure would be the state-space
// conflation DESIGN's failure-mode list names.
fn mtcollins1_render_outcome(label: NonEmptyStr, outcome: OobBootHandoffOutcome) -> ProcessExit {
  match outcome {
    BootControlIssued { selected: _, power: _ } => ExitSuccess
    BootSelectionRefused =>
      exit_failure(reason: concat(label as String, ": controller refused the boot source override"))
    BootSelectionNotApplied { requested: d, readback: r } =>
      exit_failure(reason: concat(label as String, ": override for '", d as String, "' did not take; boot parameter 5 read back: ", r))
    BootSelectionFlagInvalid { requested: d, readback: r } =>
      exit_failure(reason: concat(label as String, ": override for '", d as String, "' reported alongside an INVALID boot flag, so it will not be honoured; boot parameter 5 read back: ", r))
    BootSelectionNotOneShot { requested: d, readback: r } =>
      exit_failure(reason: concat(label as String, ": override for '", d as String, "' is not one-shot next-boot; boot parameter 5 read back: ", r))
    BootSelectionFirmwareMismatch { requested: d, readback: r } =>
      exit_failure(reason: concat(label as String, ": override for '", d as String, "' does not match the required firmware mode; boot parameter 5 read back: ", r))
    BootSelectionUnverifiable { requested: d, readback: r } =>
      exit_failure(reason: concat(label as String, ": boot parameter 5 read did not succeed, so the override for '", d as String, "' is unverified; output: ", r))
    PowerStateReadFailed { selected: d, observed_state: o } =>
      exit_failure(reason: concat(label as String, ": override for '", d as String, "' APPLIED but chassis power state read ", chassis_observation_text(observation: o) as String, ", so no power action was selected or written; the controller holds an unconsumed next-boot override"))
    PowerCommandRefused { selected: d, action: a } =>
      exit_failure(reason: concat(label as String, ": override for '", d as String, "' APPLIED but chassis power ", oob_power_action_verb(action: a) as String, " was refused; the controller holds an unconsumed next-boot override"))
    PowerCommandAcceptedNoTransition { selected: d, action: a, progress: pr, last_observed: o } =>
      exit_failure(reason: concat(label as String, ": override for '", d as String, "' APPLIED and chassis power ", oob_power_action_verb(action: a) as String, " exited 0, but the transition did not complete within the read-back bound: ", power_transition_progress_text(progress: pr) as String, "; last chassis power state ", chassis_observation_text(observation: o) as String))
    BootHandoffNotAdmitted { admission: _ } =>
      exit_failure(reason: concat(label as String, ": controller not admitted for out-of-band drive; no write was attempted"))
  }
}

// THE OPERATOR ENTRIES ARE GONE (gunbc#12101, side-chat review 5286225278): mtcollins1_netboot_handoff,
// mtcollins1_cdrom_handoff and mtcollins1_denied_admission_control each reached a power cycle of this
// unit from an operator session with no interlock, and nothing consumed them -- the boot mode
// (gunbc.machine_intake_mtcollins1_boot_run) is the CD route's production root and nothing serves
// PXE on this segment. drive_handoff is now sealed to the boot's actuation and takes the unit-hold
// proof, so the only roots that reach this unit's boot device or power are the ones rostered in
// gunbc.machine_intake_mtcollins1_maintenance_hold mtcollins1_bmc_write_roots.
//
fn mtcollins1_drive_handoff(
  proof: UnitHoldProof,
  label: NonEmptyStr,
  password_file_raw: String,
  capability_row: BmcFirmwareReleaseCapabilityRow,
  selection: IpmiBootSelection,
) -> ProcessExit
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_actuate"),
  ]
{
  match unit_hold_proof_refusal(proof: proof, key: mtcollins1_unit_hold_key, label: label as String) {
    Present { value: why } => return exit_failure(reason: why)
    Absent => {}
  }
  match mtcollins1_bmc_username {
    Absent =>
      exit_failure(reason: concat(label as String, ": BMC is not BmcSecured; refusing before any controller write"))
    Present { value: username } =>
      match mtcollins1_password_file(raw: password_file_raw) {
        CredentialPathMissing =>
          exit_failure(reason: concat(label as String, ": no credential path supplied; refusing before any controller write"))
        CredentialPathGiven { path: pw } =>
          mtcollins1_render_outcome(
            label: label,
            outcome: oob_boot_handoff(
              observation: mtcollins1_access_observation,
              capability_row: capability_row,
              username: username,
              password_file: pw,
              selection: selection,
            ),
          )
      }
  }
}
