module gunbc.machine_intake_mtcollins1_actuate

import std.types { NonEmptyStr, String }
import std.process { ExitSuccess, ProcessExit, exit_failure }
import extdeps.bmc.endpoint { AmiMegaRac }
import extdeps.bmc.capability {
  BmcFirmwareReleaseCapabilityRow,
  BmcFirmwareReleaseIdentity,
  CapabilityBootSourceOverride,
  CapabilityPowerControl,
}
import extdeps.bmc.ipmi_boot_selection {
  IpmiBootCdrom,
  IpmiBootPxe,
  IpmiBootSelection,
  aarch64_uefi_once_boot_selection,
  ipmi_boot_selection_label,
}
import gunbc.machine_intake_mtcollins1_access_observation {
  mtcollins1_access_observation,
  mtcollins1_capability_row,
}
import gunbc.machine_intake_oob_boot_handoff {
  BootControlIssued,
  BootControlNotAdmitted,
  BootSelectionFirmwareModeMismatch,
  BootSelectionFlagInvalid,
  BootSelectionNotApplied,
  BootSelectionPersistenceMismatch,
  BootSelectionRefused,
  BootSelectionUnverifiable,
  OobBootControlOutcome,
  PowerCycleRefused,
  oob_boot_control_issue,
}

// THE POLICY LAYER FOR THIS UNIT. A boot request is no longer a device string beside an assumed
// default. Each row below is an IpmiBootSelection that can be constructed only by the aarch64
// UEFI-one-shot constructor. There is no argument, field or sibling constructor with which this
// module can request legacy firmware mode or a persistent override.
//
// Execution on 2026-09-10 grounded the distinction: `cdrom` alone read back PC-compatible legacy
// mode and failed on aarch64; adding `options=efiboot,persistent` selected EFI and booted. The model
// deliberately keeps the useful EFI bit and drops the experimental persistence bit: intake wants
// one boot, and ipmitool's absence of `persistent` reads back as "only next boot".
data mtcollins1_netboot_selection: IpmiBootSelection =
  aarch64_uefi_once_boot_selection(device: IpmiBootPxe)

data mtcollins1_cdrom_selection: IpmiBootSelection =
  aarch64_uefi_once_boot_selection(device: IpmiBootCdrom)

// A CYCLE AND NOT A RESET, because the unit's own SEL is the evidence that a cycle takes effect:
// driving `chassis power cycle` produced both the power-cycle event and a boot-initiated event.
data mtcollins1_power_action: NonEmptyStr = "cycle"

// The only enabled administrator account observed on channel 1. Rotation is a separate arrival
// phase and this module receives only a credential FILE path; no secret is placed in argv.
data mtcollins1_bmc_username: NonEmptyStr = "admin"

type CredentialPathStanding
  = CredentialPathGiven { path: NonEmptyStr }
  | CredentialPathMissing

fn mtcollins1_password_file(raw: String) -> CredentialPathStanding {
  if raw == "" {
    CredentialPathMissing
  } else {
    CredentialPathGiven { path: raw as NonEmptyStr }
  }
}

// ONE RENDERER FOR BOTH CONTROL TARGETS. ExitSuccess means exactly "the typed control request was
// issued" because the entrypoint names that proposition. It does not mean a boot completed. A
// completed delivery is earned by the image's own host-side receipt, not by this renderer.
fn mtcollins1_render_control_outcome(label: NonEmptyStr, outcome: OobBootControlOutcome) -> ProcessExit {
  match outcome {
    BootControlIssued { selection: _ } => ExitSuccess
    BootSelectionRefused { selection: s } =>
      exit_failure(reason: join([label as String, ": controller refused typed boot selection ", ipmi_boot_selection_label(selection: s) as String], ""))
    BootSelectionNotApplied { selection: s, readback: r } =>
      exit_failure(reason: join([label as String, ": device selector did not match ", ipmi_boot_selection_label(selection: s) as String, "; parameter 5: ", r], ""))
    BootSelectionFirmwareModeMismatch { selection: s, readback: r } =>
      exit_failure(reason: join([label as String, ": firmware boot mode did not match ", ipmi_boot_selection_label(selection: s) as String, "; parameter 5: ", r], ""))
    BootSelectionPersistenceMismatch { selection: s, readback: r } =>
      exit_failure(reason: join([label as String, ": override persistence did not match ", ipmi_boot_selection_label(selection: s) as String, "; parameter 5: ", r], ""))
    BootSelectionFlagInvalid { selection: s, readback: r } =>
      exit_failure(reason: join([label as String, ": boot flag invalid for ", ipmi_boot_selection_label(selection: s) as String, "; parameter 5: ", r], ""))
    BootSelectionUnverifiable { selection: s, readback: r } =>
      exit_failure(reason: join([label as String, ": parameter 5 unreadable for ", ipmi_boot_selection_label(selection: s) as String, "; output: ", r], ""))
    PowerCycleRefused { selection: s } =>
      exit_failure(reason: join([label as String, ": selection applied but power cycle refused for ", ipmi_boot_selection_label(selection: s) as String], ""))
    BootControlNotAdmitted { admission: _ } =>
      exit_failure(reason: join([label as String, ": controller not admitted for out-of-band boot control; no write attempted"], ""))
  }
}

fn mtcollins1_issue_selection(
  label: NonEmptyStr,
  password_file: NonEmptyStr,
  selection: IpmiBootSelection,
) -> ProcessExit
  uses net: std.resources.Network
{
  mtcollins1_render_control_outcome(
    label: label,
    outcome: oob_boot_control_issue(
      observation: mtcollins1_access_observation,
      capability_row: mtcollins1_capability_row,
      username: mtcollins1_bmc_username,
      password_file: password_file,
      selection: selection,
      power_action: mtcollins1_power_action,
    ),
  )
}

func mtcollins1_netboot_control_issue(password_file_raw: String) -> ProcessExit
  uses net: std.resources.Network
{
  match mtcollins1_password_file(raw: password_file_raw) {
    CredentialPathMissing =>
      exit_failure(reason: "mtcollins1 PXE control issue: no credential path supplied; refusing before any controller write")
    CredentialPathGiven { path: pw } =>
      mtcollins1_issue_selection(
        label: "mtcollins1 PXE control issue",
        password_file: pw,
        selection: mtcollins1_netboot_selection,
      )
  }
}

func mtcollins1_cdrom_control_issue(password_file_raw: String) -> ProcessExit
  uses net: std.resources.Network
{
  match mtcollins1_password_file(raw: password_file_raw) {
    CredentialPathMissing =>
      exit_failure(reason: "mtcollins1 CD control issue: no credential path supplied; refusing before any controller write")
    CredentialPathGiven { path: pw } =>
      mtcollins1_issue_selection(
        label: "mtcollins1 CD control issue",
        password_file: pw,
        selection: mtcollins1_cdrom_selection,
      )
  }
}

// THE ENFORCEMENT CONTROL. Same real operation and target, but a capability row for a different
// firmware release. Admission must refuse before the typed boot-selection write. The independent
// wet check remains parameter 5 unchanged after this entry returns non-zero.
data mtcollins1_mismatched_firmware: BmcFirmwareReleaseIdentity = BmcFirmwareReleaseIdentity {
  family: AmiMegaRac,
  raw_version: "0.31-not-this-unit",
  semantic_version: none,
}

data mtcollins1_mismatched_capability_row: BmcFirmwareReleaseCapabilityRow = BmcFirmwareReleaseCapabilityRow {
  firmware: mtcollins1_mismatched_firmware,
  capabilities: [
    CapabilityBootSourceOverride,
    CapabilityPowerControl,
  ],
}

func mtcollins1_denied_admission_control(password_file_raw: String) -> ProcessExit
  uses net: std.resources.Network
{
  match mtcollins1_password_file(raw: password_file_raw) {
    CredentialPathMissing =>
      exit_failure(reason: "mtcollins1 denied-admission control: no credential path supplied")
    CredentialPathGiven { path: pw } =>
      mtcollins1_render_control_outcome(
        label: "mtcollins1 denied-admission control",
        outcome: oob_boot_control_issue(
          observation: mtcollins1_access_observation,
          capability_row: mtcollins1_mismatched_capability_row,
          username: mtcollins1_bmc_username,
          password_file: pw,
          selection: mtcollins1_netboot_selection,
          power_action: mtcollins1_power_action,
        ),
      )
  }
}
