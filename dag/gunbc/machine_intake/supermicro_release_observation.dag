module gunbc.machine_intake.supermicro_release_observation

import std.types { List, NonEmptyStr }
import std.nat { Nat }
import std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, decl_ref }
import extdeps.network.mac { Eui48Address }
import extdeps.time.rfc3339 { Rfc3339Timestamp }
import gunbc.machine_intake.supermicro_h11ssl_unit_identity { supermicro_h11ssl_unit1_bmc_mac }
import extdeps.external_authority { ExternalAuthority }
import extdeps.firmware.types { FirmwareSemanticVersion, firmware_semantic_version }
import extdeps.bmc.types {
  RedfishServiceRootMember, ServiceRootSystems, ServiceRootChassis, ServiceRootManagers, ServiceRootTasks,
  ServiceRootSessionService, ServiceRootAccountService, ServiceRootEventService, ServiceRootUpdateService,
  ServiceRootRegistries, ServiceRootCertificateService, ServiceRootJsonSchemas,
}

// RECEIPTS, NOT UPSTREAM FACT (DESIGN section 3, external upstream decomposition). What Supermicro BMC
// firmware releases did, as THIS repository saw them on its own H11SSL unit, keyed by the release the
// unit reported. They are not in extdeps.bmc.supermicro because no Supermicro document states them: every
// row is SupermicroSeenOnOneUnit. The vocabulary they use (the DMTF ServiceRoot members, the licence op)
// is extdeps'. When a Supermicro document is cited for a row, the row becomes SupermicroStatedForRelease
// and moves to extdeps.bmc.supermicro. This module imports only extdeps, std and the unit identity rows, so the first-contact
// receipt and the BMC reading may both read it without a cycle.

// ── THE SERVICE ROOT, PER RELEASE. Which DMTF ServiceRoot members, Redfish version and ServiceRoot
// schema each release served on our H11SSL unit 1 after licence activation. The two releases differ: a
// consumer that expects a member reads the row for the release it observed, never a family-wide set.
// No row is yet release-wide. Each was seen on ONE unit at ONE time and names the downstream receipt
// that holds the reading (by reference; this module never imports it, DESIGN 3). The basis is on the
// row, and the readers return a reading whose arm names it, so a consumer cannot take a one-unit
// observation as a firmware rule: the figures are reachable only through a match that names the scope.
//
// CONSUMPTION, declared frontier (DESIGN section 3c). In this change these rows and the CHECK rows below
// are read only by test.claim.supermicro_h11ssl_witness, and the CHECK rows also by
// gunbc.machine_intake.supermicro_h11ssl_first_contact supermicro_h11ssl_redfish_root_answered_after_activation.
// The named later change is the H11SSL arrival-intake binding (a gunbc.board_authority_binding row for
// the board), the same frontier the first-contact receipt declares: its Redfish first contact reads the
// row for the release it observed, and its licence step issues supermicro_cgi_licence_activate_op and
// reads its CHECK through these rows. Trigger: that binding's FRU Board Area read
// (extdeps.board_authority BoardFruIdentity).
type SupermicroObservationScope {
  unit_bmc_mac: Eui48Address
  observed: SupermicroObservedWhen
  receipt: DeclarationRef
}

// When the row's reading was made, at the precision the receipt actually holds: an RFC 3339 instant
// when the observer's transcript timed the request, or only the receipt itself when the capture
// recorded no instant (its directory names a day; no time of day is fabricated for it).
type SupermicroObservedWhen
  = ObservedAtInstant { at: Rfc3339Timestamp }
  | ObservedUntimedInReceipt

type SupermicroRowBasis
  = SupermicroStatedForRelease { authority: ExternalAuthority }
  | SupermicroSeenOnOneUnit { scope: SupermicroObservationScope, read_obligation: NonEmptyStr }

type SupermicroServiceRootFigures {
  redfish_version: NonEmptyStr
  root_schema: NonEmptyStr
  members: List<RedfishServiceRootMember>
}

type SupermicroServiceRootRow {
  firmware: FirmwareSemanticVersion
  figures: SupermicroServiceRootFigures
  basis: SupermicroRowBasis
}

data supermicro_service_root_rows: List<SupermicroServiceRootRow> = [
  SupermicroServiceRootRow {
    firmware: firmware_semantic_version(major: 1, minor: 52, patch: 0),
    figures: SupermicroServiceRootFigures {
      redfish_version: "1.0.1",
      root_schema: "ServiceRoot.v1_1_0",
      members: [ServiceRootSystems, ServiceRootChassis, ServiceRootManagers, ServiceRootTasks, ServiceRootSessionService, ServiceRootAccountService, ServiceRootEventService, ServiceRootUpdateService, ServiceRootRegistries],
    },
    basis: SupermicroSeenOnOneUnit {
      scope: SupermicroObservationScope {
        unit_bmc_mac: supermicro_h11ssl_unit1_bmc_mac,
        observed: ObservedAtInstant { at: "2026-10-17T02:58:07Z" },
        receipt: decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_first_contact", decl_name: "supermicro_h11ssl_first_contact_receipt"),
      },
      read_obligation: "The Supermicro Redfish Reference Guide's ServiceRoot for 01.52.00, which would make this row release-wide.",
    },
  },
  SupermicroServiceRootRow {
    firmware: firmware_semantic_version(major: 1, minor: 52, patch: 25),
    figures: SupermicroServiceRootFigures {
      redfish_version: "1.8.0",
      root_schema: "ServiceRoot.v1_5_2",
      members: [ServiceRootAccountService, ServiceRootCertificateService, ServiceRootChassis, ServiceRootEventService, ServiceRootJsonSchemas, ServiceRootManagers, ServiceRootRegistries, ServiceRootSessionService, ServiceRootSystems, ServiceRootTasks, ServiceRootUpdateService],
    },
    basis: SupermicroSeenOnOneUnit {
      scope: SupermicroObservationScope {
        unit_bmc_mac: supermicro_h11ssl_unit1_bmc_mac,
        observed: ObservedUntimedInReceipt,
        receipt: decl_ref(module_path: "gunbc.machine_intake.supermicro_bmc_reading", decl_name: "supermicro_h11ssl_unit1_captures_2026_10_27"),
      },
      read_obligation: "The Supermicro Redfish Reference Guide's ServiceRoot for 01.52.25, which would make this row release-wide.",
    },
  },
]

type SupermicroServiceRootReading
  = ServiceRootStatedForRelease { figures: SupermicroServiceRootFigures, authority: ExternalAuthority }
  | ServiceRootSeenOnOneUnit { figures: SupermicroServiceRootFigures, scope: SupermicroObservationScope, read_obligation: NonEmptyStr }

fn supermicro_service_root_of_release(firmware: FirmwareSemanticVersion) -> SupermicroServiceRootReading? {
  match first(filter(supermicro_service_root_rows, r => r.firmware == firmware)) {
    Absent => none
    Present { value: r } => match r.basis {
      SupermicroStatedForRelease { authority: a } => Present { value: ServiceRootStatedForRelease { figures: r.figures, authority: a } }
      SupermicroSeenOnOneUnit { scope: sc, read_obligation: o } => Present { value: ServiceRootSeenOnOneUnit { figures: r.figures, scope: sc, read_obligation: o } }
    }
  }
}

// A CHECK value this release answered to an activation that then admitted the gated resources. Only
// a value observed so is a row. The reader returns the row's basis rather than a Bool, so a consumer
// reads a one-unit CHECK meaning with its scope; any other CHECK, or any CHECK on a release with no
// row, has no reading at all.
type SupermicroLicenceActivationAcceptedRow {
  firmware: FirmwareSemanticVersion
  check: Nat
  basis: SupermicroRowBasis
}

data supermicro_licence_activation_accepted_rows: List<SupermicroLicenceActivationAcceptedRow> = [
  SupermicroLicenceActivationAcceptedRow {
    firmware: firmware_semantic_version(major: 1, minor: 52, patch: 0),
    check: 1,
    basis: SupermicroSeenOnOneUnit {
      scope: SupermicroObservationScope {
        unit_bmc_mac: supermicro_h11ssl_unit1_bmc_mac,
        observed: ObservedAtInstant { at: "2026-10-17T02:58:01Z" },
        receipt: decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_first_contact", decl_name: "supermicro_h11ssl_first_contact_receipt"),
      },
      read_obligation: "Supermicro's statement of the BIOS_LINCENSE_ACTIVATE.XML response and its CHECK values, which would make CHECK=1 release-wide.",
    },
  },
]

fn supermicro_licence_activation_accepted_basis(firmware: FirmwareSemanticVersion, check: Nat) -> SupermicroRowBasis? {
  match first(filter(supermicro_licence_activation_accepted_rows, r => r.firmware == firmware && r.check == check)) {
    Absent => none
    Present { value: r } => Present { value: r.basis }
  }
}

