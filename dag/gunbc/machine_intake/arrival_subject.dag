module gunbc.machine_intake.arrival_subject

import std.types { List, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, decl_ref }
import product.host_identity { HostIdentity }
import gunbc.auth.standing_operator_grant {
  mtjade1_live_standing_grant, standing_grant_covers, StandingGrantHost, StandingOperatorGrant, StandingGrantEffect,
  StandingArrivalArchive, StandingArrivalFirmwareQualification,
}
import gunbc.fleet.fleet_host_identity { operator_host_mtjade1 }
import gunbc.host.managed_host { managed_hosts }

// ── ARRIVAL-CONVERGE SUBJECT POPULATION ───────────────────────────────────────────────────────
// J2/J4 cannot read gunbc.host.managed_host managed_hosts() for their subject: a unit is not a member
// until its ManagedHostAdmission. The dispatch input for those effects is this population, distinct from
// the executor `host` input and from `managed_host`. Options are derived from the rows, never a second
// hand list in fleet-converge.yml.
//
// A row is a unit that has an arrival-prefix producer. It is not a HostIdentity enrollment and not a
// managed-host row. Every per-unit fact is a FIELD of the row -- its host, its producer and the standing
// grant it runs under -- so a second unit is a second row and the admit fold below names no unit.
type ArrivalConvergePopulationRow {
  host: HostIdentity
  producer: DeclarationRef
  grant: StandingOperatorGrant
}

data arrival_converge_population: List<ArrivalConvergePopulationRow> = [
  ArrivalConvergePopulationRow {
    host: operator_host_mtjade1,
    producer: decl_ref(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "converge_mtjade1_arrival_prefix"),
    grant: mtjade1_live_standing_grant,
  },
]

// THE EFFECTS THE ARRIVAL DOOR PERFORMS, the same for every unit: the prior-life archive and the firmware
// qualification. A row's grant must cover each of them on the row's own host.
data arrival_door_effects: List<StandingGrantEffect> = [StandingArrivalArchive, StandingArrivalFirmwareQualification]

fn arrival_converge_subject_options() -> List<String> {
  map(arrival_converge_population, r => r.host as String)
}

type ArrivalSubjectAdmitted sole_constructor {
  wire: NonEmptyStr
  host: HostIdentity
  producer: DeclarationRef
}

type ArrivalSubjectAdmission
  = ArrivalSubjectInPopulation { subject: ArrivalSubjectAdmitted }
  | ArrivalSubjectUnknown { wire: String }
  | ArrivalSubjectIsManagedHostExecutorConfusion { wire: String }
  | ArrivalSubjectOutsideGrant { wire: String }

fn arrival_population_row_in(population: List<ArrivalConvergePopulationRow>, wire: String) -> ArrivalConvergePopulationRow? {
  filter(population, r => (r.host as String) == wire).first()
}

fn arrival_row_grant_covers_the_door(row: ArrivalConvergePopulationRow) -> Bool {
  all(arrival_door_effects, e => standing_grant_covers(g: row.grant, scope: StandingGrantHost { host: row.host }, effect: e))
}

// THE ADMIT FOLD, over a population and the managed-host members it must not confuse with an arrival.
// A spelling no row carries is unknown. A managed host is already past arrival: driving it through this
// door is the executor/subject confusion, read from MEMBERSHIP, never from a unit's name. Otherwise the
// row's own grant must cover every door effect on the row's own host.
fn admit_arrival_subject_in(
  population: List<ArrivalConvergePopulationRow>,
  managed: List<HostIdentity>,
  wire: String,
) -> ArrivalSubjectAdmission {
  if any(managed, h => (h as String) == wire) {
    ArrivalSubjectIsManagedHostExecutorConfusion { wire: wire }
  } else {
    match arrival_population_row_in(population: population, wire: wire) {
      Absent => ArrivalSubjectUnknown { wire: wire }
      Present { value: row } =>
        if arrival_row_grant_covers_the_door(row: row) {
          ArrivalSubjectInPopulation {
            subject: ArrivalSubjectAdmitted { wire: row.host as NonEmptyStr, host: row.host, producer: row.producer },
          }
        } else {
          ArrivalSubjectOutsideGrant { wire: wire }
        }
    }
  }
}

// THE ADMIT FOLD THE ARRIVAL JOB RUNS BEFORE WIF, over the committed population and today's members.
fn admit_arrival_subject(wire: String) -> ArrivalSubjectAdmission {
  admit_arrival_subject_in(
    population: arrival_converge_population,
    managed: map(managed_hosts(), m => m.host),
    wire: wire,
  )
}
