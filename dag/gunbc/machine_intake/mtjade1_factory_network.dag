module gunbc.machine_intake.mtjade1_factory_network

import std.types { Bool, NonEmptyStr }
import extdeps.network.ipv4 { Ipv4Address, PrefixLength, ipv4_address, ipv4_address_eq }
import extdeps.network.mac { Eui48Address }

// THE UNIT'S BMC IS ON A FACTORY STATIC ADDRESS, AND THE GSG SAYS IT SHOULD NOT BE.
//
// Page 14 step 3 of the Mt. Jade GSG (Issue 1.00, digest f6528f70) instructs the operator to
// cable the BMC management port to "the network switch which provides DHCP IP", and the document
// states no static default anywhere. This unit answered on a static address before any DHCP lease
// existed. That divergence is the fact worth carrying, and it is why this standing is a COMPARISON
// rather than an observation filed under the document's expectation: recording the address as
// though it were the documented behaviour would erase the one thing the observation establishes.
//
// WHAT IT ESTABLISHES, CONCRETELY: "brand new" does not prove factory-default BMC NVRAM. The unit
// arrived sealed and its network configuration is not what the shipping document describes, so the
// safe reading is that this controller was configured before it reached us. That is a reason to
// preserve the configuration as evidence rather than reset it, and the no-reset standing elsewhere
// in intake rests on this row rather than on a caution.

type BmcNetworkModeExpectation
  = DocumentExpectsDhcp { citation: NonEmptyStr }
  | DocumentStatesStatic { citation: NonEmptyStr }
  | DocumentStatesNoNetworkDefault { citation: NonEmptyStr }

data mt_jade_gsg_bmc_network_expectation: BmcNetworkModeExpectation = DocumentExpectsDhcp {
  citation: "Mt. Jade GSG Issue 1.00 page 14, Step 3 (3): connect the BMC Ethernet Management port to the network switch which provides DHCP IP. The document states no static default.",
}

type ObservedBmcNetwork
  = BmcNetworkUnobserved { discriminator: NonEmptyStr }
  | BmcNetworkObservedStatic {
      address: Ipv4Address
      prefix: PrefixLength
      gateway: Ipv4Address
      link: Eui48Address
      basis: NonEmptyStr
    }
  | BmcNetworkObservedDhcpLease {
      address: Ipv4Address
      prefix: PrefixLength
      basis: NonEmptyStr
    }

// THE COMPARISON IS THE POINT, so it is a coproduct rather than a Bool: a reader needs to know
// WHICH way the unit diverged, and an unobserved network is not agreement.
type FactoryBmcNetworkStanding
  = FactoryNetworkUnobserved { discriminator: NonEmptyStr }
  | FactoryNetworkMatchesDocument { expectation: BmcNetworkModeExpectation }
  | FactoryNetworkDivergesFromDocument {
      expectation: BmcNetworkModeExpectation
      observed: ObservedBmcNetwork
      divergence: NonEmptyStr
    }

fn factory_bmc_network_standing(
  expectation: BmcNetworkModeExpectation,
  observed: ObservedBmcNetwork,
) -> FactoryBmcNetworkStanding {
  match observed {
    BmcNetworkUnobserved { discriminator: d } => FactoryNetworkUnobserved { discriminator: d }
    BmcNetworkObservedStatic { address: _, prefix: _, gateway: _, link: _, basis: _ } =>
      match expectation {
        DocumentExpectsDhcp { citation: _ } =>
          FactoryNetworkDivergesFromDocument {
            expectation: expectation,
            observed: observed,
            divergence: "the document instructs a DHCP-served management port and states no static default; the controller answered on a static address with no lease in the router table",
          }
        DocumentStatesStatic { citation: _ } => FactoryNetworkMatchesDocument { expectation: expectation }
        DocumentStatesNoNetworkDefault { citation: _ } =>
          FactoryNetworkDivergesFromDocument {
            expectation: expectation,
            observed: observed,
            divergence: "the document states no network default at all, so a configured static is unattributable to it",
          }
      }
    BmcNetworkObservedDhcpLease { address: _, prefix: _, basis: _ } =>
      match expectation {
        DocumentExpectsDhcp { citation: _ } => FactoryNetworkMatchesDocument { expectation: expectation }
        DocumentStatesStatic { citation: _ } =>
          FactoryNetworkDivergesFromDocument {
            expectation: expectation,
            observed: observed,
            divergence: "the document states a static default and the controller took a DHCP lease",
          }
        DocumentStatesNoNetworkDefault { citation: _ } =>
          FactoryNetworkDivergesFromDocument {
            expectation: expectation,
            observed: observed,
            divergence: "the document states no network default at all, so a DHCP lease is unattributable to it",
          }
      }
  }
}

// THE OBSERVED ROW FOR UNIT 1, from the operator's read of the controller and srv1's ARP capture.
// The MAC is the one srv1 saw as the source of the BMC's own ARP broadcasts, which is also what
// establishes the shared segment: ARP does not cross a router.
data mtjade1_bmc_observed_network: ObservedBmcNetwork = BmcNetworkObservedStatic {
  address: ipv4_address(octet1: 10, octet2: 0, octet3: 7, octet4: 2),
  prefix: 24,
  gateway: ipv4_address(octet1: 10, octet2: 0, octet3: 7, octet4: 1),
  link: Eui48Address {
    octet1: 112,
    octet2: 226,
    octet3: 132,
    octet4: 149,
    octet5: 51,
    octet6: 107,
  },
  basis: "operator read of the controller, corroborated by a 90s tcpdump on srv1's enP3p3s0f1 which received this MAC's own ARP broadcasts (who-has 10.0.7.1 tell 10.0.7.2). PREFIX CORRECTED 2026-10-03 from 29 to 24: the controller's own ipmitool lan print 1, captured before it was reconfigured (srv1 ~/mtjade1/lan1-before-dhcp.txt), reports Subnet Mask 255.255.255.0; the earlier /29 was srv1's chosen access prefix, not the controller's.",
}

// THE CONTROLLER'S LINK ADDRESS, PROJECTED OUT OF THE OBSERVATION ABOVE. The octets are written ONCE,
// in mtjade1_bmc_observed_network, and everything downstream reaches them through this accessor -- the
// rule the interface inventory depends on: a reading is typed once and every other mention is a lookup.
fn mtjade1_bmc_link_mac() -> Eui48Address {
  match mtjade1_bmc_observed_network {
    BmcNetworkObservedStatic { address: _, prefix: _, gateway: _, link: l, basis: _ } => l
    // THE TWO ARMS BELOW ARE UNREACHABLE WHILE mtjade1_bmc_observed_network IS THE ROW WRITTEN ABOVE,
    // and they are written to be noticed rather than to pass: an all-zero address is not a reading, it is
    // the shape a missing reading leaves behind. mtjade1_bmc_link_is_read below is what a witness asserts
    // so this can never quietly become true, and host_interface_addresses_are_disjoint would catch two
    // such zeros meeting in the inventory.
    BmcNetworkObservedDhcpLease { address: _, prefix: _, basis: _ } => Eui48Address { octet1: 0, octet2: 0, octet3: 0, octet4: 0, octet5: 0, octet6: 0 }
    BmcNetworkUnobserved { discriminator: _ } => Eui48Address { octet1: 0, octet2: 0, octet3: 0, octet4: 0, octet5: 0, octet6: 0 }
  }
}

// THE ADDRESS THE CONTROLLER ANSWERED ON WHEN THIS READING WAS TAKEN, projected out of the same
// observation as its link address. Absent for the arms that carry no static reading: the DHCP arm
// describes a later lease, not the interface this link address was read on.
fn mtjade1_bmc_observed_address() -> Ipv4Address? {
  match mtjade1_bmc_observed_network {
    BmcNetworkObservedStatic { address: a, prefix: _, gateway: _, link: _, basis: _ } => Present { value: a }
    BmcNetworkObservedDhcpLease { address: _, prefix: _, basis: _ } => none
    BmcNetworkUnobserved { discriminator: _ } => none
  }
}

// THE CLAIM THAT MAKES THE UNREACHABLE ARMS ABOVE HONEST: the controller's link address is a READING
// only when the observation that supplies it is the static one. A witness asserts this, so an edit that
// drops the link layer from the observation turns the inventory red instead of filling it with zeros.
fn mtjade1_bmc_link_is_read() -> Bool {
  match mtjade1_bmc_observed_network {
    BmcNetworkObservedStatic { address: _, prefix: _, gateway: _, link: _, basis: _ } => true
    BmcNetworkObservedDhcpLease { address: _, prefix: _, basis: _ } => false
    BmcNetworkUnobserved { discriminator: _ } => false
  }
}

// RECONFIGURED BY THE OPERATOR, 2026-10-03: the factory static above was preserved as evidence
// until the operator chose to move the unit onto the site LAN. ipmitool lan set 1 ipsrc dhcp on the
// factory address; the controller then took a lease from the site router (DHCP request from this
// MAC, then ipmitool lan print 1 at the new address reads IP Address Source: DHCP Address,
// 192.168.1.246, mask 255.255.255.0, gateway 192.168.1.1; srv1 ~/mtjade1/lan1-after-dhcp.txt sha256
// bd7c6cc97e6d42d19cd6daa0efa2603b96097ec088ec38c12cc44d2fa803c236). The operator holds the
// reservation for this MAC. The factory row stays as the historical reading; this is the current one.
data mtjade1_bmc_reconfigured_network: ObservedBmcNetwork = BmcNetworkObservedDhcpLease {
  address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 246),
  prefix: 24,
  basis: "operator-directed ipmitool lan set 1 ipsrc dhcp on 2026-10-03; lease observed by tcpdump and read back by lan print 1 at 192.168.1.246",
}

// srv13's controller network, as first contact recorded it (artifacts/bmc/srv13-first-contact-2026-10-07
// FINDINGS.txt line 4: "BMC 192.168.1.247, MAC 9c:6b:00:e7:c9:83 (router reservation
// bmc-altrad8ud-1l2t-5)"), and as gunbc.fleet.fleet_intent srv13_baseboard carries the address. The
// PREFIX and GATEWAY are the segment's, not this controller's own report: the same LAN's mtjade1 lease
// above is 192.168.1.246/24, and 192.168.1.1 answers as the segment gateway (gunbc.host.host_primary_network_observed;
// mtcollins1_netboot_client_observation records the same DHCP server). srv13 has never been read over IPMI,
// so no lan print of its own grounds these two fields -- stated rather than assumed.
data srv13_bmc_observed_network: ObservedBmcNetwork = BmcNetworkObservedStatic {
  address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 247),
  prefix: 24,
  gateway: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 1),
  link: Eui48Address {
    octet1: 156,
    octet2: 107,
    octet3: 0,
    octet4: 231,
    octet5: 201,
    octet6: 131,
  },
  basis: "router reservation bmc-altrad8ud-1l2t-5, MAC 9c:6b:00:e7:c9:83, address 192.168.1.247 (srv13 first-contact FINDINGS.txt, 2026-10-07); prefix /24 and gateway 192.168.1.1 are the segment's, from the mtjade1 lease on this LAN and the segment gateway, not from srv13 itself",
}

data mtjade1_current_bmc_network_standing: FactoryBmcNetworkStanding = factory_bmc_network_standing(
  expectation: mt_jade_gsg_bmc_network_expectation,
  observed: mtjade1_bmc_reconfigured_network,
)

data mtjade1_factory_bmc_network_standing: FactoryBmcNetworkStanding = factory_bmc_network_standing(
  expectation: mt_jade_gsg_bmc_network_expectation,
  observed: mtjade1_bmc_observed_network,
)

// THE ADDRESS srv1 MUST REACH, and the one it takes to do so. .1 is the controller's configured
// GATEWAY and taking it would impersonate that; .3 is a free host address in the same /29 that
// reaches .2 on-link without claiming the gateway identity.
data mtjade1_bmc_address: Ipv4Address = ipv4_address(octet1: 10, octet2: 0, octet3: 7, octet4: 2)

data srv1_factory_segment_address: Ipv4Address = ipv4_address(octet1: 10, octet2: 0, octet3: 7, octet4: 3)

data mtjade1_factory_segment_prefix: PrefixLength = 29

fn srv1_segment_address_is_not_the_bmc(a: Ipv4Address, b: Ipv4Address) -> Bool {
  ipv4_address_eq(a: a, b: b) == false
}
