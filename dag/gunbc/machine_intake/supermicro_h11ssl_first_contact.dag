}

// The variant (-i/-C/-NC) is NOT established by any observation here; the FRU is unread.

// The firmware family is not this receipt's: these probes identify none, and the unit's family and
// release are read from its 2026-10-27 Manager resource and Get Device ID in
// gunbc.machine_intake.supermicro_bmc_reading (SupermicroIdentityRead). bmc_firmware above is the
// release these observations were made on, as the BMC reported it on 2026-10-17
// (supermicro_h11ssl_bmc_reported_identity); what each code means on that release is
// extdeps.bmc.supermicro's.

fn rejects_factory_default(o: H11sslObservation) -> Bool {
  match o {
    WebLoginObservation { credential: SupermicroDefaultAdminCredential, instant: _, observed_by: _, outcome: LoginRejected, unit_state_changed: _ } => true
    _ => false
  }
}

// The factory-default producer is admitted only if no observation rejected that credential.
fn supermicro_h11ssl_factory_login_producer_admitted(r: H11sslFirstContactReceipt) -> Bool {
  !any(r.observations, o => rejects_factory_default(o: o))
}

fn instant_precedes(a: Rfc3339Timestamp, b: Rfc3339Timestamp) -> Bool {
  match rfc3339_compare(left: a, right: b) {
    Rfc3339Precedes => true
    Rfc3339Follows => false
    Rfc3339Simultaneous => false
    Rfc3339OrderUndecidable { cause: _ } => false
  }
}

fn observed_instant(o: H11sslObservation) -> H11sslObservedInstant {
  match o {
    WebLoginObservation { credential: _, instant: i, observed_by: _, outcome: _, unit_state_changed: _ } => i
    RedfishRootObservation { instant: i, observed_by: _, outcome: _, unit_state_changed: _ } => i
    LicenceActivationObservation { credential: _, instant: i, observed_by: _, check_attribute: _, unit_state_changed: _ } => i
  }
}

// The one comparable basis: every step of the transition is timed by the observer's transcript.
fn on_transcript_basis(o: H11sslObservation) -> Bool {
  match observed_instant(o: o).basis {
    RequestIssuedAtFromObserverTranscript => true
    BmcClockReading => false
  }
}

// Redfish root, refused, no state change.
fn is_root_refused(o: H11sslObservation) -> Bool {
  match o {
    RedfishRootObservation { instant: _, observed_by: _, outcome: ServiceRootRefused { message_id: _ }, unit_state_changed: ch } => !ch && on_transcript_basis(o: o)
    _ => false
  }
}

// Licence activation CGI that changed the unit, timed on the transcript; the CHECK it answered is read
// through the release's row in extdeps.bmc.supermicro, whose basis (scope and receipt) comes back with it. A CHECK with
// no row on this release has no reading, so the step is not an activation.
fn activation_check_basis(o: H11sslObservation, firmware: FirmwareSemanticVersion) -> SupermicroRowBasis? {
  match o {
    LicenceActivationObservation { credential: _, instant: _, observed_by: _, check_attribute: c, unit_state_changed: ch } =>
      if ch && on_transcript_basis(o: o) { supermicro_licence_activation_accepted_basis(firmware: firmware, check: c) } else { none }
    _ => none
  }
}

fn is_activation(o: H11sslObservation, firmware: FirmwareSemanticVersion) -> Bool {
  match activation_check_basis(o: o, firmware: firmware) {
    Absent => false
    Present { value: _ } => true
  }
}

// The transition is observed only together with the basis of the CHECK reading it rests on: the
// refusal, the state change and the answer are this receipt's observations, but that the CHECK meant
// acceptance is extdeps.bmc.supermicro's row, and while that row is SupermicroSeenOnOneUnit the
// transition is a one-unit bet, never a firmware rule.
type H11sslActivationTransition
  = ActivationTransitionObserved { check_basis: SupermicroRowBasis }
  | ActivationTransitionNotObserved

// Redfish root, answered, no state change.
fn is_root_answered(o: H11sslObservation) -> Bool {
  match o {
    RedfishRootObservation { instant: _, observed_by: _, outcome: ServiceRootAnswered { redfish_version: _, root_schema: _, uuid: _, members: _ }, unit_state_changed: ch } => !ch && on_transcript_basis(o: o)
    _ => false
  }
}

// Observed only for the ordered transition on this BMC: a refused Redfish root, then a licence
// activation (a CHECK the release reads as accepted, state changed), then an answered Redfish root, all three timed on the
// observer's transcript and each strictly later (RFC 3339) than the one before. A reordered,
// deleted or differently-timed step is not observed. Consumed by the witness now; the arrival-intake
// Redfish path is the same declared frontier as the module header.
fn supermicro_h11ssl_redfish_root_answered_after_activation(r: H11sslFirstContactReceipt) -> H11sslActivationTransition {
  let ordered = filter(r.observations, act => is_activation(o: act, firmware: r.bmc_firmware) && any(r.observations, refused => is_root_refused(o: refused) && instant_precedes(a: observed_instant(o: refused).at, b: observed_instant(o: act).at)) && any(r.observations, ans => is_root_answered(o: ans) && instant_precedes(a: observed_instant(o: act).at, b: observed_instant(o: ans).at)))
  match first(flat_map(ordered, act => match activation_check_basis(o: act, firmware: r.bmc_firmware) { Absent => []  Present { value: st } => [st] })) {
    Absent => ActivationTransitionNotObserved
    Present { value: st } => ActivationTransitionObserved { check_basis: st }
  }
}

// ---- Authenticated read-only Redfish GETs, by merry-fox-82, 2026-10-17, host Off, nothing
// written. Raw JSON is held in the observer's scratchpad. The instants are the times the requests
// were issued, per the observer's session transcript (completion within seconds).
type H11sslRedfishReadBatch {
  at: H11sslObservedInstant
  observed_by: NonEmptyStr
  resources: List<NonEmptyStr>
}

data supermicro_h11ssl_redfish_read_batches: List<H11sslRedfishReadBatch> = [
  H11sslRedfishReadBatch { at: H11sslObservedInstant { at: "2026-10-17T05:33:29Z", basis: RequestIssuedAtFromObserverTranscript }, observed_by: "merry-fox-82", resources: ["service root", "Managers", "Systems", "Chassis", "VM collection"] },
  H11sslRedfishReadBatch { at: H11sslObservedInstant { at: "2026-10-17T05:33:50Z", basis: RequestIssuedAtFromObserverTranscript }, observed_by: "merry-fox-82", resources: ["VM1", "Processors", "Memory", "EthernetInterfaces"] },
  H11sslRedfishReadBatch { at: H11sslObservedInstant { at: "2026-10-17T05:33:57Z", basis: RequestIssuedAtFromObserverTranscript }, observed_by: "merry-fox-82", resources: ["Processors/1", "Memory/1"] },
]

// The BMC clock read 2019-11-18T05:37:00+00:00, which is wrong; a BMC clock is never a time basis.
type H11sslBmcClockStanding = BmcClockUnsynchronized { read_value: NonEmptyStr }

data supermicro_h11ssl_bmc_clock_standing: H11sslBmcClockStanding = BmcClockUnsynchronized {
  read_value: "2019-11-18T05:37:00+00:00",
}

// Virtual CD: the standard Redfish VirtualMedia collection (Managers/1/VM1) has 0 members and a
// Supermicro OEM VirtualMediaConfig sits at Managers/1/VM1/CfgCD. Offered, not exercised.
type H11sslVirtualMediaSurface
  = StandardVirtualMediaCollection { members: Nat }
  | OemVirtualMediaConfigOffered { path: NonEmptyStr, exercised: Bool }

data supermicro_h11ssl_virtual_media_surfaces: List<H11sslVirtualMediaSurface> = [
  StandardVirtualMediaCollection { members: 0 },
  OemVirtualMediaConfigOffered { path: "Managers/1/VM1/CfgCD", exercised: false },
]

type H11sslReportedDimm { slot: NonEmptyStr, size: Mebibyte, part_number: NonEmptyStr }

type H11sslReportedInventoryStanding
  = StaleFromPriorLife { contradicted_by: NonEmptyStr, refreshed_by: NonEmptyStr }
  | ConfirmedPresent { confirmed_by: NonEmptyStr }

// What the BMC REPORTS, not what is installed. The operator attests (2026-10-17) an EPYC 7702P
// physically installed (package marking) and no DIMMs; the BMC lists an EPYC 7532 (VendorId
// decoding as GenuineIntel) and eight DIMMs. The BMC refreshes host inventory only at host POST,
// so this is the previous owner's inventory cached from the last POST (a prior-life reading in
// the sense of gunbc.machine_intake.prior_life_boundary, which governs archiving such carriers;
// this standing only types the reading). The unit's CPU and memory come from the attestation
// until a POST under our ownership re-reads them.
type H11sslBmcReportedInventory {
  processor_model: NonEmptyStr
  processor_vendor_id: NonEmptyStr
  total_cores: Nat
  dimms_listed: Nat
  example_dimm: H11sslReportedDimm
  standing: H11sslReportedInventoryStanding
}

data supermicro_h11ssl_bmc_reported_inventory: H11sslBmcReportedInventory = H11sslBmcReportedInventory {
  processor_model: "AMD EPYC 7532 32-Core Processor",
  processor_vendor_id: "GenuineIntel",
  total_cores: 32,
  dimms_listed: 8,
  example_dimm: H11sslReportedDimm { slot: "DIMMA1", size: mebibyte(count: 8192), part_number: "18ASF1G72PDZ-2G3B1" },
  standing: StaleFromPriorLife {
    contradicted_by: "operator attestation 2026-10-17: AMD EPYC 7702P installed, no DIMMs installed",
    refreshed_by: "the next host POST under our ownership",
  },
}

// Operator-attested hardware state of the unit (not read from the BMC).
type H11sslAttestedHardware { cpu_installed: NonEmptyStr, dimm_count: Nat, heatsink_installed: Bool }

data supermicro_h11ssl_attested_hardware: H11sslAttestedHardware = H11sslAttestedHardware {
  cpu_installed: "AMD EPYC 7702P",
  dimm_count: 0,
  heatsink_installed: false,
}

// CONSUMPTION, declared frontier (DESIGN section 3c). The unit-hold path every boot takes
// (gunbc.host.host_boot_attempt_admission, gunbc.host.managed_host_unit_hold, reason variable named
// by gunbc.host.host_maintenance_hold_reason maintenance_hold_reason_env) is keyed by a
// HostIdentity enrolled in gunbc.host.managed_host. This unit has neither a HostIdentity nor a
// managed-host row, and naming is not enrollment (gunbc.fleet.fleet_host_identity), so expressing
// the hazard there needs an operator decision on enrolling the unit. Until then this refusal
// reason is the typed statement of the hazard; its trigger is that enrollment, at which the
// hold's reason is derived from this fn. Consumed by the witness now.
type H11sslPowerOnRefusal = PowerOnRefusedCpuWithoutHeatsink { cpu: NonEmptyStr } | PowerOnNotRefused

fn supermicro_h11ssl_power_on_refusal(h: H11sslAttestedHardware) -> H11sslPowerOnRefusal {
  if !h.heatsink_installed { PowerOnRefusedCpuWithoutHeatsink { cpu: h.cpu_installed } } else { PowerOnNotRefused }
}

// Identity the BMC reported; BoardID and the variant are not resolved by this read (FRU owed).
type H11sslBmcReportedIdentity {
  manager_model: NonEmptyStr
  manager_firmware_version: FirmwareSemanticVersion
  bios_version: NonEmptyStr
  board_id: NonEmptyStr
  graphical_console: NonEmptyStr
}

data supermicro_h11ssl_bmc_reported_identity: H11sslBmcReportedIdentity = H11sslBmcReportedIdentity {
  manager_model: "ASPEED",
  manager_firmware_version: firmware_semantic_version(major: 1, minor: 52, patch: 0),
  bios_version: "2.6a",
  board_id: "0x1a03",
  graphical_console: "KVMIP",
}

// Only a confirmed standing may be read as the unit's hardware.
fn supermicro_h11ssl_reported_inventory_is_hardware(i: H11sslBmcReportedInventory) -> Bool {
  match i.standing {
    ConfirmedPresent { confirmed_by: _ } => true
    StaleFromPriorLife { contradicted_by: _, refreshed_by: _ } => false
  }
}

fn batch_on_transcript_basis(b: H11sslRedfishReadBatch) -> Bool {
  match b.at.basis {
    RequestIssuedAtFromObserverTranscript => true
    BmcClockReading => false
  }
}

// Every read batch is timed on the one comparable basis, the observer's transcript.
fn supermicro_h11ssl_read_batches_on_transcript_basis(bs: List<H11sslRedfishReadBatch>) -> Bool {
  all(bs, b => batch_on_transcript_basis(b: b))
}

fn licence_inventory_mac(l: H11sslLicenceActivation) -> Eui48Address {
  match l.source {
    OperatorHeldCertificate { certificate_number: _, inventory_row: ref } => ref.bmc_mac
  }
}

// The receipt's bmc_mac is the one BMC identity: a licence activation's subject is that BMC (it
// carries no MAC of its own), and every operator-held secret reference, the label login and each
// licence's inventory row, must be keyed by that same MAC. A reference to another BMC's row is
// incoherent, not merely different.
fn supermicro_h11ssl_receipt_bmc_identity_coherent(r: H11sslFirstContactReceipt) -> Bool {
  r.label.bmc_factory_credential.bmc_mac == r.bmc_mac
    && all(r.licences, l => licence_inventory_mac(l: l) == r.bmc_mac)
}
