    WebLoginObservation { credential: SupermicroUniqueStickerCredential, instant: H11sslObservedInstant { at: "2026-10-17T00:15:34Z", basis: RequestIssuedAtFromObserverTranscript }, observed_by: "merry-fox-82", outcome: SessionIssued, unit_state_changed: false },
    RedfishRootObservation { instant: H11sslObservedInstant { at: "2026-10-17T00:07:16Z", basis: RequestIssuedAtFromObserverTranscript }, observed_by: "merry-fox-82", outcome: ServiceRootRefused { message_id: "Base.v1_4_0.OemLicenseNotPassed" }, unit_state_changed: false },
    LicenceActivationObservation { credential: SupermicroUniqueStickerCredential, instant: H11sslObservedInstant { at: "2026-10-17T02:58:01Z", basis: RequestIssuedAtFromObserverTranscript }, observed_by: "merry-fox-82", check_attribute: 1, unit_state_changed: true },
    RedfishRootObservation { instant: H11sslObservedInstant { at: "2026-10-17T02:58:07Z", basis: RequestIssuedAtFromObserverTranscript }, observed_by: "merry-fox-82", outcome: ServiceRootAnswered { redfish_version: "1.0.1", root_schema: "ServiceRoot.v1_1_0", uuid: "00000000-0000-0000-0000-AC1F6BE3F57B", members: [ServiceRootSystems, ServiceRootChassis, ServiceRootManagers, ServiceRootTasks, ServiceRootSessionService, ServiceRootAccountService, ServiceRootEventService, ServiceRootUpdateService, ServiceRootRegistries] }, unit_state_changed: false },
