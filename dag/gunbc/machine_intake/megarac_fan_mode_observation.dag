// DESIRED PHASES OF THE ONE PHYSICAL-MACHINE CONVERGE (no new workflow mode).
// Boot (power-on through boot terminal): Cooling Manager disabled, PWM in [20,30].
// Bringup and after: Cooling Manager automatic while a run is alive. Any exit, trip, or
// unreadable temperature leaves the manager enabled (manager_disabled 0 read back). PWM write
// is fan_pwm_all as a string.
type FanPolicyPhase
  = BootThroughTerminal
  | HostBringupAndAfter

type MegaRacFanPhaseDesire {
  phase: FanPolicyPhase
  manager: MegaRacFanManagerStanding
  manual_pwm_min: Percent
  manual_pwm_max: Percent
}

data megarac_fan_boot_phase_desire: MegaRacFanPhaseDesire = MegaRacFanPhaseDesire {
  phase: BootThroughTerminal,
  manager: CoolingManagerDisabledManual,
  manual_pwm_min: percent(20),
  manual_pwm_max: percent(30),
}

data megarac_fan_bringup_phase_desire: MegaRacFanPhaseDesire = MegaRacFanPhaseDesire {
  phase: HostBringupAndAfter,
  manager: CoolingManagerAutomatic,
  manual_pwm_min: percent(20),
  manual_pwm_max: percent(30),
}
