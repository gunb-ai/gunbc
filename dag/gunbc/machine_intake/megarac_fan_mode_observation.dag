// GROUNDED READ OF THE MEGARAC FAN-MODE SURFACE (Foxconn Mt. Collins, 2026-10-14 ~21:50Z).
// Executor: operator credential, POST /api/session, GET these two paths, DELETE /api/session.
// Source of the path names: served UI bundle source.min.js (gzip sha256 prefix ee9b14cbf7141b78),
// AMI copyright, kept off-tree. This module is an observing-layer receipt, not an upstream fact.
//
// manager_disabled 0 at this instant is AUTOMATIC Cooling Manager. The 21:50Z row is not
// overwritten. Post-hand-set GET 2026-10-14T22:09:18Z recorded manager_disabled 1 with the
// same get_fan_info pwm echo (1-4 at 0, 5-6 at 20) and FAN4/FAN5 still near 5700 rpm.
// Operator hearing ~22:20Z: PWM 40 audible, PWM 20 inaudible. 22:23:52Z SDR still ~5700.
// gunbc.fleet.fleet_fan_acoustic_evidence is catalog published-level fittability, not this
// hearing. Tach fidelity on this unit is Unestablished and can clear. Missing socket-1 fans
// remain a chassis fact.

type MegaRacFanInfoRow {
  fan_number: Int
  fan_pwm: Percent
}

type MegaRacSdrFanRow {
  header: NonEmptyStr
  presence: MegaRacSdrFanPresence
}

// HOW AN OBSERVATION WAS TAKEN. Every row here came from an operator session's curl/ipmitool, not
// from a repository-executed read; the repository's own reads are the IPMI SDR series.
type MegaRacObservationProvenance
  = OperatorSessionProbe { executor: NonEmptyStr }

data megarac_operator_session_probe_2026_10_14: MegaRacObservationProvenance = OperatorSessionProbe {
  executor: "operator session curl against the BMC REST API, 2026-10-14; not executed by repository code",
}

type MegaRacFanModeObservation {
  provenance: MegaRacObservationProvenance
  host: HostIdentity
  observed_at: NonEmptyStr
  manager: MegaRacFanManagerStanding
  fans: List<MegaRacFanInfoRow>
  sdr_fans: List<MegaRacSdrFanRow>
}

