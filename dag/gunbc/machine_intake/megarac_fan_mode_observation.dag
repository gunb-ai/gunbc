module gunbc.machine_intake.megarac_fan_mode_observation

import std.types { Bool, Int, List, NonEmptyStr }
import std.measure { Celsius, Percent, RevolutionsPerMinute, celsius, percent, rpm }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_mtcollins1 }
import extdeps.bmc.megarac_fan_policy {
  CoolingManagerAutomatic,
  CoolingManagerDisabledManual,
  MegaRacFanManagerStanding,
  MegaRacSdrFanPresence,
  MegaRacSdrFanPresenceAbsent,
  MegaRacSdrFanRotatingInBand,
}

// GROUNDED READ OF THE MEGARAC FAN-MODE SURFACE (Foxconn Mt. Collins, 2026-10-14 ~21:50Z).
// Executor: operator credential, POST /api/session, GET these two paths, DELETE /api/session.
// Source of the path names: served UI bundle source.min.js (gzip sha256 prefix ee9b14cbf7141b78),
// AMI copyright, kept off-tree. This module is an observing-layer receipt, not an upstream fact.
//
// manager_disabled 0 at this instant is AUTOMATIC Cooling Manager. The operator later disabled
// the manager by hand ~22:00Z; that is out-of-band drift. This 21:50Z row is not overwritten.
// The post-hand-set GET was not executed (live route skipped), so the manual PWM value is
// declared unobserved rather than invented. Missing socket-1 fans (SDR FAN0-3 presence-absent,
// UI fans 1-4 pwm 0) is a chassis fact joined through megarac_fan_slot_standing.

type MegaRacFanInfoRow {
  fan_number: Int
  fan_pwm: Percent
}

type MegaRacSdrFanRow {
  header: NonEmptyStr
  presence: MegaRacSdrFanPresence
}

type MegaRacFanModeObservation {
  host: HostIdentity
  observed_at: NonEmptyStr
  manager: MegaRacFanManagerStanding
  fans: List<MegaRacFanInfoRow>
  sdr_fans: List<MegaRacSdrFanRow>
}

data mtcollins1_megarac_fan_mode_observation_2026_10_14: MegaRacFanModeObservation = MegaRacFanModeObservation {
  host: operator_host_mtcollins1,
  observed_at: "2026-10-14T21:50:00Z" as NonEmptyStr,
  manager: CoolingManagerAutomatic,
  fans: [
    MegaRacFanInfoRow { fan_number: 1, fan_pwm: percent(0) },
    MegaRacFanInfoRow { fan_number: 2, fan_pwm: percent(0) },
    MegaRacFanInfoRow { fan_number: 3, fan_pwm: percent(0) },
    MegaRacFanInfoRow { fan_number: 4, fan_pwm: percent(0) },
    MegaRacFanInfoRow { fan_number: 5, fan_pwm: percent(20) },
    MegaRacFanInfoRow { fan_number: 6, fan_pwm: percent(20) },
  ],
  sdr_fans: [
    MegaRacSdrFanRow { header: "FAN0_0", presence: MegaRacSdrFanPresenceAbsent },
    MegaRacSdrFanRow { header: "FAN0_1", presence: MegaRacSdrFanPresenceAbsent },
    MegaRacSdrFanRow { header: "FAN1_0", presence: MegaRacSdrFanPresenceAbsent },
    MegaRacSdrFanRow { header: "FAN1_1", presence: MegaRacSdrFanPresenceAbsent },
    MegaRacSdrFanRow { header: "FAN2_0", presence: MegaRacSdrFanPresenceAbsent },
    MegaRacSdrFanRow { header: "FAN2_1", presence: MegaRacSdrFanPresenceAbsent },
    MegaRacSdrFanRow { header: "FAN3_0", presence: MegaRacSdrFanPresenceAbsent },
    MegaRacSdrFanRow { header: "FAN3_1", presence: MegaRacSdrFanPresenceAbsent },
    MegaRacSdrFanRow {
      header: "FAN4_0",
      presence: MegaRacSdrFanRotatingInBand { min_rpm: rpm(5700), max_rpm: rpm(5800) },
    },
    MegaRacSdrFanRow {
      header: "FAN4_1",
      presence: MegaRacSdrFanRotatingInBand { min_rpm: rpm(5700), max_rpm: rpm(5800) },
    },
    MegaRacSdrFanRow {
      header: "FAN5_0",
      presence: MegaRacSdrFanRotatingInBand { min_rpm: rpm(5700), max_rpm: rpm(5800) },
    },
    MegaRacSdrFanRow {
      header: "FAN5_1",
      presence: MegaRacSdrFanRotatingInBand { min_rpm: rpm(5700), max_rpm: rpm(5800) },
    },
  ],
}

// THERMALS FROM THE SAME READ, KEPT HERE BECAUSE THEY ARE NOT MEGARAC FAN-POLICY DOCUMENTATION.
// System_Inlet at 2C is marked suspect; it is not a failsafe input.
type MegaRacThermalSnapshot {
  cpu0_soc: Celsius
  outlet_min: Celsius
  outlet_max: Celsius
  system_inlet: Celsius
  system_inlet_suspect: Bool
}

type MegaRacOperatorHandSetStanding
  = HandSetObserved { observation: MegaRacFanModeObservation }
  | HandSetDeclaredUnobserved { declared_at: NonEmptyStr, read_obligation: NonEmptyStr }

data mtcollins1_megarac_operator_hand_set_2026_10_14_2200: MegaRacOperatorHandSetStanding = HandSetDeclaredUnobserved {
  declared_at: "2026-10-14T22:00:00Z" as NonEmptyStr,
  read_obligation: "GET /api/fan_control/get_manager_status and get_fan_info after the operator disabled the Cooling Manager ~22:00Z. The 21:50Z row is the pre-hand-set automatic read; live follow-up was skipped.",
}

data mtcollins1_megarac_thermal_snapshot_2026_10_14: MegaRacThermalSnapshot = MegaRacThermalSnapshot {
  cpu0_soc: celsius(36),
  outlet_min: celsius(33),
  outlet_max: celsius(35),
  system_inlet: celsius(2),
  system_inlet_suspect: true,
}

// DESIRED PHASES OF THE ONE PHYSICAL-MACHINE CONVERGE (no new workflow mode).
// Boot (power-on through boot terminal): Cooling Manager disabled, PWM in [20,30].
// Bringup and after: Cooling Manager automatic while a run is alive. Any exit, trip, or
// unreadable temperature leaves the manager enabled (manager_disabled 0 read back). PWM write
// is fan_pwm_all as a string.
type FanPolicyPhase
  = BootThroughTerminal
  | HostBringupAndAfter

type MegaRacFanPhaseDesire {
  phase: FanPolicyPhase
  manager: MegaRacFanManagerStanding
  manual_pwm_min: Percent
  manual_pwm_max: Percent
}

data megarac_fan_boot_phase_desire: MegaRacFanPhaseDesire = MegaRacFanPhaseDesire {
  phase: BootThroughTerminal,
  manager: CoolingManagerDisabledManual,
  manual_pwm_min: percent(20),
  manual_pwm_max: percent(30),
}

data megarac_fan_bringup_phase_desire: MegaRacFanPhaseDesire = MegaRacFanPhaseDesire {
  phase: HostBringupAndAfter,
  manager: CoolingManagerAutomatic,
  manual_pwm_min: percent(20),
  manual_pwm_max: percent(30),
}
