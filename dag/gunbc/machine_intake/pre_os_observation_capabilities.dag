module gunbc.machine_intake_pre_os_observation_capabilities

import std.types { Bool, Int, Duration }
import std.decl_ref { DeclarationRef }
import extdeps.bmc.capability { BmcFirmwareReleaseIdentity }
import extdeps.boards.types { BaseboardModel }

// WHAT A PLATFORM LETS AN OBSERVER SEE BEFORE AN OPERATING SYSTEM EXISTS, one profile per
// (baseboard, controller firmware release). Collector coverage is not a property of the host
// console: a collector that never established coverage produced no host payload, and that is
// not an observation that SOL is silent. Host payload received is independent of coverage
// complete: bytes captured while the client is still attached are a host fact.

// THE CONSOLE AXIS IS A COLLECTOR OBSERVATION, NOT A HOST VERDICT. Session activation acknowledged,
// coverage, host payload received vs not, termination reason, and terminate_deadline_seconds
// are independent. A window that elapses while the client stays attached is not coverage
// complete. The deadline must terminate the client. Local client banner bytes (ipmitool
// tcgetattr / SOL Session operational) are not host payload.

type SolSessionActivationStanding
  = SolSessionActivationAcknowledged
  | SolSessionActivationNotAcknowledged

type SolCollectorCoverageStanding
  = SolCoverageNeverEstablished
  | SolCoverageInterrupted
  | SolCoverageComplete
  | SolCoverageStillRunningPastDeadline

type SolCollectorTermination
  = CollectorStillRunning
  | CollectorTerminatedExitZeroStdinEof
  | CollectorTerminatedByDeadline
  | CollectorTerminatedOtherwise { exit_status: Int }

type SolHostPayloadStanding
  = SolHostPayloadReceived
  | SolHostPayloadNotReceived

type SolCollectorObservation {
  activation: SolSessionActivationStanding
  coverage: SolCollectorCoverageStanding
  termination: SolCollectorTermination
  host_payload: SolHostPayloadStanding
  terminate_deadline_seconds: Duration
}

type SolHostFactFromCollector
  = SolHostPayloadAdmitted
  | SolHostProducedNoConsoleBytes
  | SolCollectorDidNotEstablishCoverage { coverage: SolCollectorCoverageStanding }

fn sol_host_fact_from_collector(obs: SolCollectorObservation) -> SolHostFactFromCollector {
  match obs.host_payload {
    SolHostPayloadReceived => SolHostPayloadAdmitted
    SolHostPayloadNotReceived =>
      match obs.coverage {
        SolCoverageComplete => SolHostProducedNoConsoleBytes
        SolCoverageNeverEstablished => SolCollectorDidNotEstablishCoverage { coverage: obs.coverage }
        SolCoverageInterrupted => SolCollectorDidNotEstablishCoverage { coverage: obs.coverage }
        SolCoverageStillRunningPastDeadline => SolCollectorDidNotEstablishCoverage { coverage: obs.coverage }
      }
  }
}

fn sol_activation_acknowledged_without_coverage(obs: SolCollectorObservation) -> Bool {
  match obs.activation {
    SolSessionActivationNotAcknowledged => false
    SolSessionActivationAcknowledged =>
      match obs.coverage {
        SolCoverageComplete => false
        SolCoverageNeverEstablished => true
        SolCoverageInterrupted => true
        SolCoverageStillRunningPastDeadline => true
      }
  }
}

type SelReadCapability
  = SelUnreadable
  | SelRawOnly
  | SelStandardDecoded

type OemSelDecodeCapability
  = OemDecodeAvailable { decode_authority: DeclarationRef }
  | OemDecodeControllerDeclaredUnknown
  | OemDecodeNotProbed

type WebEventLogCapability
  = WebEventLogAvailable
  | WebEventLogAbsent

type DimmLocalizationCapability
  = LocalizationUnavailableFromExposedTelemetry
  | PerSlotLocalizationExposed { source: DeclarationRef }

type MemoryPowerTelemetryCapability
  = AggregateMemoryPowerExposed
  | MemoryPowerNotExposed

type ManagedAcActuationCapability
  = NoManagedAcActuator
  | ManagedAcActuatorDeclared { realization: DeclarationRef }

type HostCallbackCapability
  = HostCallbackDemonstrated
  | HostCallbackIntendedNotDemonstrated
  | HostCallbackAbsent

type PreOsObservationCapabilities {
  baseboard: BaseboardModel
  controller_firmware: BmcFirmwareReleaseIdentity
  console: SolCollectorObservation
  sel: SelReadCapability
  oem_sel_decode: OemSelDecodeCapability
  web_event_log: WebEventLogCapability
  dimm_localization: DimmLocalizationCapability
  memory_power: MemoryPowerTelemetryCapability
  managed_ac: ManagedAcActuationCapability
  host_callback: HostCallbackCapability
}

// Remaining profile axes other than console are a declared frontier: consumed by
// gunbc.machine_intake_pre_os_bringup_verdict when that module lands (gunbc#11110). Trigger: that
// verdict module resolving and matching oem_sel_decode / dimm_localization directly. The console
// axis is consumed here by sol_host_fact_from_collector.
