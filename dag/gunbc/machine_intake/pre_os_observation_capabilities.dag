module gunbc.machine_intake_pre_os_observation_capabilities

import std.types { Bool, Int, NonEmptyStr }
import std.content_hash { ContentHash }
import std.decl_ref { DeclarationRef }
import extdeps.bmc.capability { BmcFirmwareReleaseIdentity }
import extdeps.boards.types { BaseboardModel }

// WHAT A PLATFORM LETS AN OBSERVER SEE BEFORE AN OPERATING SYSTEM EXISTS, one profile per
// (baseboard, controller firmware release). Every field is a MEASURED capability standing, not a
// hope: a reader deciding what a bring-up verdict may claim consults this profile first, and a
// claim the profile says cannot be seen has no constructor downstream.
//
// WHY THIS IS A PROFILE AND NOT A LIST OF BOOLEANS. Each axis answers in its own vocabulary, and
// most have a middle state a Bool would absorb toward the permissive side
// (gunbc.recurring_failure_mode.upstream_non_affirmation_consumed_as_permission): a console that
// is PRESENT AND SILENT is neither "SOL: yes" nor "SOL: no", and reading it as yes is exactly how
// silence got promoted to a firmware verdict on 2026-09-11.

// THE CONSOLE. SolPresentSilent is the arm the Mt. Collins unit inhabits: the controller accepts
// the session, prints its own banner, accepts keystrokes, and returns no host bytes under any
// power condition measured. It is separate from SolAbsent because the remedies differ -- a silent
// console may be a firmware console-redirection setting; an absent one is a controller capability.
type ConsoleObservationCapability
  = SolAbsent
  | SolPresentSilent
  | SolPresentEmitting

// THE EVENT LOG, three rungs. Raw records readable; standard (section 42.2) sensor events decoded
// by the controller's renderer; and OEM records, which section 32.2 hands to the manufacturer.
type SelReadCapability
  = SelUnreadable
  | SelRawOnly
  | SelStandardDecoded

// WHETHER THE MANUFACTURER'S OWN REALIZATION DECODES ITS OEM RECORDS. ControllerDeclaredUnknown is
// a MEASURED answer -- the controller was asked and answered "unknown" -- and it is distinct from
// OemDecodeNotProbed, where nobody asked. Only OemDecodeAvailable licenses a downstream decode, and
// it must name the declaration that carries the decode table so the citation is checkable.
type OemSelDecodeCapability
  = OemDecodeAvailable { decode_authority: DeclarationRef }
  | OemDecodeControllerDeclaredUnknown
  | OemDecodeNotProbed

type WebEventLogCapability
  = WebEventLogAvailable
  | WebEventLogAbsent

// WHAT A CONTROLLER'S WEB EVENT LOG WAS OBSERVED TO DECODE, as the receipt the OEM-decode axis is
// DERIVED from rather than authored beside. A surface that renders one uniform description for
// every record and carries no OEM data bytes has offered no decode; only a surface that carries a
// decode table an authority can be cited for licenses OemDecodeAvailable, and that arm is not
// derivable from this receipt at all -- it must come from the cited table.
type WebEventLogDecodeObservation {
  artifact_path: NonEmptyStr
  digest: ContentHash
  records_served: Int
  oem_records_served: Int
  advanced_event_description_uniformly: NonEmptyStr
  oem_sel_data_empty: Bool
}

fn oem_sel_decode_capability_of_web_log(observation: WebEventLogDecodeObservation) -> OemSelDecodeCapability {
  if observation.oem_records_served == 0 {
    OemDecodeNotProbed
  } else {
    OemDecodeControllerDeclaredUnknown
  }
}

// WHETHER THE PLATFORM CAN NAME A DIMM SLOT AS THE SUBJECT OF A PRE-OS FAULT. When it cannot, a
// remediation verdict may say "physical remediation required" and may NOT say which slot; deriving
// a slot from timing or from an opaque payload is forbidden, and the downstream carrier has no
// constructor for a slot when this arm is LocalizationUnavailableFromExposedTelemetry. The Exposed
// arm carries the declaration that exposes the per-slot evidence -- a pointer to what would be
// read, never a slot -- because localizing is a later consumer's fold over that source.
type DimmLocalizationCapability
  = LocalizationUnavailableFromExposedTelemetry
  | PerSlotLocalizationExposed { source: DeclarationRef }

type MemoryPowerTelemetryCapability
  = AggregateMemoryPowerExposed
  | MemoryPowerNotExposed

// MANAGED AC CARRIES NO OUTLET. This fleet has no managed PDU, and authoring an arm that names an
// outlet would be DESIGN section 3c's dangling declaration -- a constructor no realization
// reaches. The other arm, like PerSlotLocalizationExposed, carries only the DECLARATION of the
// realization that would perform the cycle, never the hardware; it exists so a platform that
// gains an actuator can say so without this type growing a PDU model, and the attempt module
// keeps AcPowerCycle a typed human-attended barrier until such a realization lands with its own
// executed receipt.
type ManagedAcActuationCapability
  = NoManagedAcActuator
  | ManagedAcActuatorDeclared { realization: DeclarationRef }

// A HOST CALLBACK -- the delivered image phoning home -- is the subject-originating attestation
// gunbc.recurring_failure_mode.control_plane_acknowledgement_minted_as_effect names as the only
// thing that can construct a subject-level terminal. IntendedNotDemonstrated is the state of this
// fleet today: the mechanism is designed and has not executed end to end, so no verdict may lean
// on it yet.
type HostCallbackCapability
  = HostCallbackDemonstrated
  | HostCallbackIntendedNotDemonstrated
  | HostCallbackAbsent

type PreOsObservationCapabilities {
  baseboard: BaseboardModel
  controller_firmware: BmcFirmwareReleaseIdentity
  console: ConsoleObservationCapability
  sel: SelReadCapability
  oem_sel_decode: OemSelDecodeCapability
  web_event_log: WebEventLogCapability
  dimm_localization: DimmLocalizationCapability
  memory_power: MemoryPowerTelemetryCapability
  managed_ac: ManagedAcActuationCapability
  host_callback: HostCallbackCapability
}

// THE ONE QUESTION A DOWNSTREAM FOLD ASKS OF THE CONSOLE AXIS. The OEM-decode and localization
// axes are consumed by gunbc.machine_intake_pre_os_bringup_verdict matching the profile's fields
// directly (oem_sel_decode_standing, remediation_localization); a predicate here for each would
// be a second reading of one field with no consumer (DESIGN section 3c).

// May a console capture that contains nothing beyond the session banner be read as evidence about
// the HOST? Only when the console is known to emit: on a silent-console platform the same bytes
// arrive whatever the host does, so they carry no host information
// (gunbc.recurring_failure_mode.absent_reads_identically_to_never_looked).
fn console_silence_is_informative(profile: PreOsObservationCapabilities) -> Bool {
  match profile.console {
    SolAbsent => false
    SolPresentSilent => false
    SolPresentEmitting => true
  }
}
