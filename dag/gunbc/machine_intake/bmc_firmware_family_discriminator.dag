module gunbc.machine_intake.bmc_firmware_family_discriminator

import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.goal_assessment { ObservationAttempt, ObservationEstablished, ObservationRefused }
import extdeps.languages.json.emit { JsonValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject }
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text,
  FieldAbsent, FieldRead, FieldMalformed, json_field, json_field_string,
}
import extdeps.bmc.endpoint { AmiMegaRac, BmcFirmwareFamily, OpenBmc, SupermicroAten }
import extdeps.bmc.supermicro { supermicro_redfish_oem_key, supermicro_redfish_oem_key_standing }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }
import gunbc.machine_intake.bmc_first_contact_standing {
  BmcFirmwareFamilyStanding,
  FamilyObserved,
  FamilyUnobserved,
}

// THE ONE FUNCTION THAT MAY CONSTRUCT FamilyObserved, AND WHY IT COULD NOT LIVE BESIDE THE PROBE.
//
// bmc_first_contact_standing refuses any route from transport presence to a family, and
// IntakeRedfishSurface carries no BmcFirmwareFamily in any arm, so the promotion is unconstructible
// from a service-root read (DESIGN §4b rung 4). What discriminates is the Manager resource, where
// the implementation names itself, and reading it requires credentials - which is the whole reason
// the discriminator is a separate authenticated step rather than a flag on the intake probe.
//
// THE OBSERVATION IS A TYPED RECORD, NOT A BLOB THE FOLD SNIFFS. The caller decodes the Manager
// response into these fields once; the discrimination below reads fields, so a change to the wire
// shape breaks decoding rather than silently changing a family verdict.
type ManagerIdentityObservation {
  manager_id: NonEmptyStr
  firmware_version: String
  model: String
  oem_keys: List<String>
}

// EACH DISCRIMINATOR IS A CLAIM ABOUT AN UPSTREAM AND CARRIES ITS EVIDENTIARY STANDING. Neither is
// cited yet: both are transcribed from how these stacks are known to present, and until someone
// reads the specifications the honest arm is TranscribedUncited with the read that would close it
// (DESIGN §4d - do not assert as deduced what is only inferred).
data openbmc_oem_key_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "OpenBMC's Redfish Manager Oem key. Read the phosphor-bmc-code-mgmt / bmcweb Redfish schema for the Oem member OpenBMC publishes on /redfish/v1/Managers/<id>, and cite the version that names it.",
}

data megarac_oem_key_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "AMI MegaRAC's Redfish Manager Oem key. Read the AMI MegaRAC SP-X Redfish reference for the Oem member it publishes on the Manager resource, and cite the release that names it.",
}

data openbmc_oem_key: NonEmptyStr = "OpenBmc"

data megarac_oem_key: NonEmptyStr = "Ami"

// THE DISCRIMINATOR IS A ROW PER FAMILY, NOT A BRANCH PER FAMILY (DESIGN section 6b). The fold used to
// test the OpenBMC and AMI keys pairwise; a third family would have meant a third branch and a new
// pairwise ambiguity case. Each row binds one Oem key, with its standing, to one family, and the fold
// counts the rows a Manager matches.
type FamilyOemKeyRow { key: NonEmptyStr, family: BmcFirmwareFamily, standing: CitedFigureStanding }

data family_oem_key_rows: List<FamilyOemKeyRow> = [
  FamilyOemKeyRow { key: openbmc_oem_key, family: OpenBmc, standing: openbmc_oem_key_standing },
  FamilyOemKeyRow { key: megarac_oem_key, family: AmiMegaRac, standing: megarac_oem_key_standing },
  FamilyOemKeyRow { key: supermicro_redfish_oem_key, family: SupermicroAten, standing: supermicro_redfish_oem_key_standing },
]

type FamilyDiscrimination
  = FamilyDiscriminated { family: BmcFirmwareFamily, basis: NonEmptyStr }
  | FamilyIndeterminate { basis: NonEmptyStr }
  | FamilyAmbiguous { basis: NonEmptyStr }

fn observation_names_oem(observation: ManagerIdentityObservation, key: NonEmptyStr) -> Bool {
  any(observation.oem_keys, k => k == (key as String))
}

// AMBIGUITY IS ITS OWN ARM AND DOES NOT COLLAPSE TO ANY FAMILY. A Manager advertising the Oem keys of two
// families is a state this fold cannot resolve, and picking one would be the widening section 5 refuses;
// an operator reading FamilyAmbiguous knows to go look, whereas a wrong FamilyDiscriminated would select
// a rotation route against the wrong stack.
fn discriminate_family(observation: ManagerIdentityObservation) -> FamilyDiscrimination {
  let matched = filter(family_oem_key_rows, row => observation_names_oem(observation: observation, key: row.key))
  if matched.length() > 1 {
    FamilyAmbiguous {
      basis: concat("the Manager advertises the Oem keys of more than one modeled family: ", join(map(matched, row => row.key as String), ", ")) as NonEmptyStr,
    }
  } else {
    match first(matched) {
      Present { value: row } => FamilyDiscriminated {
        family: row.family,
        basis: concat("the Manager resource advertises the Oem key ", row.key as String) as NonEmptyStr,
      }
      Absent => FamilyIndeterminate {
        basis: "the Manager resource advertises no modeled family's Oem key; firmware_version and model were read but no modeled discriminator matched",
      }
    }
  }
}

// ONLY A DISCRIMINATED FAMILY BECOMES FamilyObserved. Indeterminate and ambiguous both stay
// unobserved and carry what would close them, so a downstream realizer selection sees the same
// refusal it saw before any probe ran.
fn family_standing_from_discrimination(discrimination: FamilyDiscrimination) -> BmcFirmwareFamilyStanding {
  match discrimination {
    FamilyDiscriminated { family: f, basis: _ } => FamilyObserved { family: f }
    FamilyIndeterminate { basis: b } => FamilyUnobserved { discriminator: b }
    FamilyAmbiguous { basis: b } => FamilyUnobserved { discriminator: b }
  }
}

// THE MANAGER RESOURCE, DECODED ONCE (DMTF Manager schema: Id, FirmwareVersion, Model, and the member
// names of its Oem object). A body that is not a Manager document refuses rather than becoming an
// observation with empty fields that would discriminate as Indeterminate.
fn manager_identity_observation_of(body: String) -> ObservationAttempt<ManagerIdentityObservation, NonEmptyStr> {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: g } => ObservationRefused { cause: concat("the Manager body is not a JSON document: ", json_document_gap_text(gap: g)) as NonEmptyStr }
    JsonDocumentParsed { value: doc } => match json_field_string(obj: doc, key: "Id") {
      FieldAbsent => ObservationRefused { cause: "the Manager body carries no Id" }
      FieldMalformed { cause: c } => ObservationRefused { cause: c as NonEmptyStr }
      FieldRead { value: id } => if id == "" { ObservationRefused { cause: "the Manager body's Id is empty" } } else {
        match json_field(obj: doc, key: "Oem") {
          FieldMalformed { cause: c } => ObservationRefused { cause: c as NonEmptyStr }
          FieldAbsent => ObservationEstablished { observed: ManagerIdentityObservation { manager_id: id as NonEmptyStr, firmware_version: string_or_empty(doc: doc, key: "FirmwareVersion"), model: string_or_empty(doc: doc, key: "Model"), oem_keys: [] } }
          FieldRead { value: oem } => match oem {
            JsonObject { members: ms } => ObservationEstablished { observed: ManagerIdentityObservation { manager_id: id as NonEmptyStr, firmware_version: string_or_empty(doc: doc, key: "FirmwareVersion"), model: string_or_empty(doc: doc, key: "Model"), oem_keys: map(ms, m => m.key) } }
            JsonNull => ObservationRefused { cause: "the Manager's Oem member is not an object" }
            JsonBool { value: _ } => ObservationRefused { cause: "the Manager's Oem member is not an object" }
            JsonNumber { lexeme: _ } => ObservationRefused { cause: "the Manager's Oem member is not an object" }
            JsonString { value: _ } => ObservationRefused { cause: "the Manager's Oem member is not an object" }
            JsonArray { elements: _ } => ObservationRefused { cause: "the Manager's Oem member is not an object" }
          }
        }
      }
    }
  }
}

fn string_or_empty(doc: JsonValue, key: String) -> String {
  match json_field_string(obj: doc, key: key) {
    FieldRead { value: v } => v
    FieldAbsent => ""
    FieldMalformed { cause: _ } => ""
  }
}
