      family: bmc_family_gate_of(records: records),
      standings: BmcReadingStandings {
        committed: ObservedByReceipt { observed: observed_receipt(receipt: decl_ref(module_path: "gunbc.machine_intake.bmc_first_contact_reading", decl_name: "srv13_first_contact_reading_2026_10_07")) },
        modeled: bmc_modeled_standing(),
        runtime: bmc_runtime_standing(),
      },
      binding: BindingAbsent { obligation: bmc_capability_binding_absent_obligation },
      interface_reads: [],
      console_session: Present { value: ConsoleSessionEvidence {
        transport: IpmiSol,
        evidence: "the captured SOL session log in this set: the session was operational and typed checkpoints reached the host console",
        kind: CapturedSessionLog,
        from_read: bmc_sol_session_log_read,
        standing: ObservedByReceipt { observed: observed_receipt(receipt: decl_ref(module_path: "gunbc.machine_intake.bmc_first_contact_reading", decl_name: "srv13_first_contact_reading_2026_10_07")) },
      } },
      observed_boot_use: none,
