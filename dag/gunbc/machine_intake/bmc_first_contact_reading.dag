    BmcRecordsRead { records: records } => bmc_first_contact_reading_of(request: BmcBatteryRequest {
      source: CommittedCaptureSet { controller: "srv13-bmc" as NonEmptyStr, manifest: srv13_first_contact_manifest },
      controller: "srv13-bmc" as NonEmptyStr,
