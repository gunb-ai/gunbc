// ═══════════════════════════════════════════════════════════════════════════
// THE MODELED REALIZATION. A BmcWorld is a SIMULATED controller: nothing it says may stand as an observation
// of hardware, so `bmc_modeled_standings` stamps every reading it produces as a transcription with its
// obligation. The responses are rendered FROM the world through the upstream's own spelling — `mc info`
// stdout is printed by the ipmitool renderer and read back by the ipmitool parser, `sol info` likewise — so a
// dry controller answers as the tool would, and no real board's stored transcript is ever replayed here.
//
// What the world models and this renders: the `mc info` and `sol info` answers, and the network-boot state --
// the EthernetInterface collection and its member, and the BootOptions collection including the arm where the
// service says it is not served. Those go through extdeps.bmc.redfish_network_boot's renderers and come back
// through its readers, so R5's dry arm runs the same render-then-parse route a committed capture runs.
//
// What the world models but this does not yet render is coverage, not silence: a surface with no upstream-shaped
// renderer in extdeps (Managers, Thermal, Sensors, the SDR repository, SerialInterfaces, VirtualMedia, Systems'
// boot override, the Supermicro CGI) stays a read the modeled source does not answer, and the battery reports it
// as an obligation naming the read.
// ═══════════════════════════════════════════════════════════════════════════
fn bmc_modeled_responses_of_world(world: BmcWorld) -> List<BmcModeledResponse> {
  let surfaces = world.record_surfaces
  let answered = []
  let with_mc_info = match surfaces.mc_info {
    Absent => answered
    Present { value: fields } => list_snoc_item(xs: answered, item: BmcModeledResponse {
      read: bmc_mc_info_read,
      operation: IpmiToolCommand { command: "ipmitool mc info" as NonEmptyStr },
      outcome: CommandExitRecorded { code: 0 },
      body: render_ipmitool_mc_info_fields(fields: fields),
    })
  }
  let with_sol = match surfaces.sol_configuration {
    Absent => with_mc_info
    Present { value: configuration } => list_snoc_item(xs: with_mc_info, item: BmcModeledResponse {
      read: bmc_ipmi_sol_info_read,
      operation: IpmiToolCommand { command: "ipmitool sol info 1" as NonEmptyStr },
      outcome: CommandExitRecorded { code: 0 },
      body: render_ipmi_sol_info(configuration: configuration),
    })
  }
  let with_port = match surfaces.ethernet_interface {
    Absent => with_sol
    Present { value: port } => concat(with_sol, bmc_modeled_port_responses(port: port))
  }
  match surfaces.boot_options {
    Absent => with_port
    Present { value: options } => list_snoc_item(xs: with_port, item: BmcModeledResponse {
      read: bmc_redfish_boot_options_read,
      operation: RedfishGet { uri: "/redfish/v1/Systems/1/BootOptions" as NonEmptyStr },
      outcome: HttpStatusRecorded { code: 200 },
      body: bmc_modeled_boot_options_body(options: options),
    })
  }
}

// THE MODELED CONTROLLER'S TWO EthernetInterface ANSWERS, printed by the upstream's renderers: the collection
// it serves, naming the port it models, and that port's member resource. The collection's announced count is
// the number of ports modeled, so a modeled controller cannot announce a port it does not serve; a run that
// asks for the member read gets the body, and a run that does not gets the plan's obligation. The URIs are
// concrete because a modeled controller serves a system the way a real one does; the read NAMES are the plan's,
// which spell the same resources with `<id>` and `<member>` standing for whichever resource a run names.
fn bmc_modeled_port_responses(port: RedfishEthernetInterfaceRead) -> List<BmcModeledResponse> {
  let collection = RedfishEthernetInterfaceCollectionRead {
    member_ids: [port.id],
    announced_count: Present { value: 1 },
  }
  [
    BmcModeledResponse {
      read: bmc_redfish_ethernet_interfaces_collection_read,
      operation: RedfishGet { uri: "/redfish/v1/Systems/1/EthernetInterfaces" as NonEmptyStr },
      outcome: HttpStatusRecorded { code: 200 },
      body: render_redfish_ethernet_interface_collection(read: collection),
    },
    BmcModeledResponse {
      read: bmc_redfish_ethernet_interface_read,
      operation: RedfishGet {
        uri: concat("/redfish/v1/Systems/1/EthernetInterfaces/" as NonEmptyStr, port.id as String) as NonEmptyStr,
      },
      outcome: HttpStatusRecorded { code: 200 },
      body: render_redfish_ethernet_interface(read: port),
    },
  ]
}

// The BootOptions body the modeled controller answers with: the options it lists, or its own refusal envelope.
// A modeled controller is allowed to not serve a resource, and the refusal is part of what the reader reads --
// srv13's committed capture is the same arm, so the dry route exercises the shape the capture route found.
fn bmc_modeled_boot_options_body(options: RedfishBootOptionsRead) -> String {
  match options {
    BootOptionsListed { options: entries } => render_redfish_boot_options(options: entries)
    BootOptionsNotServed { message: message } => render_redfish_boot_options_not_served(code: message as String)
  }
}

// THE SIMULATED CONTROLLER AS A SOURCE. Same interface as a committed capture set, one field more: it must
// say WHEN, because a reading that cannot name its moment cannot be attributed to a board at a moment. Its
// consumers today are the battery witness's dry claims (dry_controller_is_read_end_to_end_with_no_hardware_standing,
// the_dry_battery_reads_the_world_model_and_a_model_never_observes,
// a_world_that_models_no_mc_info_mints_no_firmware_identity); the live reader frontier is the named consumer
// that will build a simulated controller the way it builds a live one, and nothing else is claimed for it.
fn bmc_modeled_controller_of_world(controller: NonEmptyStr, observed_at: NonEmptyStr, realization: NonEmptyStr, world: BmcWorld) -> BmcReadSource {
  ModeledController {
    controller: controller,
    observed_at: observed_at,
    realization: realization,
    responses: bmc_modeled_responses_of_world(world: world),
  }
}

// AN ACQUISITION REFUSAL, AS A WHOLE READING. When the capture set cannot be trusted there is no battery to
// run: every reading refuses with the same named failure, and the family gate names the path so the operator
// can see which capture moved.
fn bmc_reading_acquisition_refused(controller: NonEmptyStr, observed_at: NonEmptyStr, path: NonEmptyStr, cause: String) -> BmcFirstContactReading {
  let named = concat("acquisition of the capture set for ", concat(controller as String, concat(" (", concat(path as String, concat("): ", cause))))) as NonEmptyStr
  BmcFirstContactReading {
    controller: controller,
    observed_at: observed_at,
    source: CommittedCaptureSet { controller: controller, manifest: [] },
    family: FamilyUnobserved { discriminator: concat("the capture set could not be acquired, so the Managers resource that gates the family was never read (", concat(path as String, ")")) as NonEmptyStr },
    firmware: reading_refused(named),
    capabilities: reading_refused(named),
    sensor_typing: reading_refused(named),
    console: reading_refused(named),
    boot_nic: reading_refused(named),
  }
}
