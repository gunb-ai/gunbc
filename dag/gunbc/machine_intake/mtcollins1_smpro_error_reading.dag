// ── the derivation ──────────────────────────────────────────────────────────────────────────────

// A window is a maximal run of reads of one slave whose registers do not restart: a read of a
// different slave, or of a register at or below the previous one, opens the next window. No time
// threshold is involved.
fn opens_window(prev: SmproRawRegisterRead?, r: SmproRawRegisterRead) -> Bool {
  match prev {
    Absent => true
    Present { value: p } => p.slave_byte != r.slave_byte || r.register <= p.register
  }
}

fn smpro_read_windows(reads: List<SmproRawRegisterRead>) -> List<List<SmproRawRegisterRead>> {
  let empty: List<List<SmproRawRegisterRead>> = []
  let none_read: List<SmproRawRegisterRead> = []
  let closed = fold(reads, init: SmproWindowFold { done: empty, open: none_read }, f: (acc, r) =>
    if opens_window(prev: last_of(rs: acc.open), r: r) && count(acc.open) > 0 {
      SmproWindowFold { done: concat(acc.done, [acc.open]), open: [r] }
    } else {
      SmproWindowFold { done: acc.done, open: concat(acc.open, [r]) }
    })
  if count(closed.open) == 0 { closed.done } else { concat(closed.done, [closed.open]) }
}

type SmproWindowFold {
  done: List<List<SmproRawRegisterRead>>
  open: List<SmproRawRegisterRead>
}

fn last_of(rs: List<SmproRawRegisterRead>) -> SmproRawRegisterRead? {
  rs.skip(n: count(rs) - 1).first()
}

// The socket a slave byte addresses, from the collector's own admitted site; a refused site
// addresses no socket, so every read in the capture is then unattributed rather than guessed.
fn socket_of_slave(slave_byte: Int) -> Int? {
  let targets = match mtcollins1_smpro_site() { SmproSiteAdmitted { site: s } => smpro_site_targets(site: s) SmproSiteRefused { cause: _ } => [] }
  match filter(targets, t => match master_write_read_slave_byte(seven_bit_address: t.seven_bit_address) { Present { value: b } => b == slave_byte Absent => false }).first() {
    Present { value: t } => Present { value: t.socket }
    Absent => none
  }
}

fn word_of(window: List<SmproRawRegisterRead>, reg: SmproRegister) -> Int? {
  match filter(window, r => r.register == reg.offset).first() {
    Present { value: r } => Present { value: smpro_word(first_byte: r.first_byte, second_byte: r.second_byte) }
    Absent => none
  }
}

// The PMpro error record of one window, through the driver's pending gate with THIS window's
// GPI_RAS_ERR read (the socket-1 windows read none, so their records stand UNGATED). The capture did
// not read the WARN words, so no warning is decoded; `missing` names any error-record word not read.
type SmproErrorWindow {
  first_stamp: NonEmptyStr
  socket: Int?
  gpi_ras_err: Int?
  pmpro: SmproRecordGate
  missing: List<NonEmptyStr>
}

data pmpro_error_record_regs: List<SmproRegister> = [
  smpro_err_pmpro_type_reg, smpro_err_pmpro_info_hi_reg, smpro_err_pmpro_info_lo_reg, smpro_err_pmpro_data_hi_reg, smpro_err_pmpro_data_lo_reg,
]

fn word_or_zero(window: List<SmproRawRegisterRead>, reg: SmproRegister) -> Int {
  match word_of(window: window, reg: reg) { Present { value: w } => w Absent => 0 }
}

fn smpro_error_window_of(window: List<SmproRawRegisterRead>) -> SmproErrorWindow {
  let missing = flat_map(pmpro_error_record_regs, reg => match word_of(window: window, reg: reg) { Present { value: _ } => [] Absent => [reg.name] })
  let gpi = word_of(window: window, reg: smpro_gpi_ras_err_reg)
  let all_read = count(missing) == 0
  SmproErrorWindow {
    first_stamp: match window.first() { Present { value: r } => r.stamp Absent => "(empty window)" },
    socket: match window.first() { Present { value: r } => socket_of_slave(slave_byte: r.slave_byte) Absent => none },
    gpi_ras_err: gpi,
    pmpro: smpro_record_gate(gpi: gpi, processor: SmproProcessorPmpro, type_read: all_read, warning: none,
      error: if all_read { smpro_internal_error_of(
        type_word: word_or_zero(window: window, reg: smpro_err_pmpro_type_reg),
        info_hi: word_or_zero(window: window, reg: smpro_err_pmpro_info_hi_reg),
        info_lo: word_or_zero(window: window, reg: smpro_err_pmpro_info_lo_reg),
        data_hi: word_or_zero(window: window, reg: smpro_err_pmpro_data_hi_reg),
        data_lo: word_or_zero(window: window, reg: smpro_err_pmpro_data_lo_reg),
      ) } else { none }),
    missing: missing,
  }
}

fn mtcollins1_smpro_error_windows(reads: List<SmproRawRegisterRead>) -> List<SmproErrorWindow> {
  map(smpro_read_windows(reads: reads), w => smpro_error_window_of(window: w))
}
