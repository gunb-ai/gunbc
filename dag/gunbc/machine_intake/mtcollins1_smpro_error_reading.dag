// ONE RAW SMpro ERROR-REGISTER READING FROM mtcollins1, 2026-10-03, AS RECEIVED: the operator's
// hand-run read-only pass during the boot loop (eager-gull-22 msg_12ab1f39), before the collector in
// gunbc.machine_intake_mtcollins1_smpro_observation read these registers itself. Method, as relayed:
// `ipmitool -I lanplus raw 0x06 0x52 0x05 <0x9e|0x9c> 0x02 <reg>` -- I2C master write-read, no
// register writes. Stamps are srv1 CLOCK_REALTIME seconds, kept as the text the capture printed.
//
// THE ROWS ARE THE OBSERVATION; EVERY DECODE IS DERIVED. Nothing below states what a window MEANS:
// mtcollins1_smpro_error_windows groups the rows and decodes each window with
// extdeps.ampere.smpro_internal_error, so a corrected decoder re-reads these same bytes.
//
// A WINDOW IS ITS OWN OBSERVATION. Socket 0's record reads nonzero in the first window and zero in
// the second, so the record is not sticky across the loop; no window is merged into another.

type SmproErrorCapture {
  directory: NonEmptyStr
  power_on_marker: NonEmptyStr
  marker_digest: Digest
  reads_digest: Digest
}

data mtcollins1_smpro_error_capture_20261003: SmproErrorCapture = SmproErrorCapture {
  directory: "srv1 ~/mtc-fw/smpro-err-20261003T005609Z",
  power_on_marker: "1790988969.678166992 (2026-10-03T00:56:09.678Z)",
  marker_digest: sha256_digest(hex: "d418a1027fd7ad9cd69a933489d436048bde231b290574241800578268374d99"),
  reads_digest: sha256_digest(hex: "4e03673f8fc09f93117e6a0ab0a5a5a5be1d42dcd0ddf93d486fe533e1ce943d"),
}

// One line of regs.stamped: stamp, 8-bit slave byte, register, and the two bytes in wire order (the
// SMpro bus is big-endian, so the first byte is the word's high byte).
type SmproRawRegisterRead {
  stamp: NonEmptyStr
  slave_byte: Int
  register: Int
  first_byte: Int
  second_byte: Int
}

