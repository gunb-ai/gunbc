  DimmDiagramIdentityResolved, DimmDiagramIdentityRefused,
  PopulationDiagramResolved, PopulationDiagramRefused, PopulationCountDisagrees, PopulationConnectorRepeated,
  resolve_dimm_diagram_identity,
}
import gunbc.managed_host { ManagedHostBinding }
