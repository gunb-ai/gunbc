module gunbc.machine_intake_mtcollins1_expansion_observation

import std.types { Bool, NonEmptyStr }
import std.nat { Nat, nat_compare }
import std.algebra { Ordering, Less, Equal, Greater }
import std.decl_ref { DeclarationRef, WholeDeclaration, declaration_ref_eq }
import std.measure { RackUnit, rack_unit }
import extdeps.publication { SpecificationDocumentDate }
import gunbc.machine_intake_mtcollins1_dimm_connector_observation { observed_unit }
import extdeps.ampere.mt_collins_1u_product_brief.specifications {
  MtCollins1UExpansion, mt_collins_1u_expansion,
  OcpSlotStanding, OcpMezzanineSlotPresent, NoOcpSlot, mt_collins_1u_ocp_slot,
}

// A report relayed by eager-owl-205, not an inspection performed by this session, on the shape of
// gunbc.machine_intake_mtcollins1_dimm_connector_observation. The unit is named through its
// existing intake receipt rather than a newly invented fleet identity.
//
// WHY THIS MODULE IS PUBLIC, stated because the nearer authority points the other way.
// extdeps.ampere.mt_collins_1u_product_brief.specifications says slot OCCUPANCY belongs in the
// private held-unit receipts. The nearer precedent disagrees in practice: the DIMM connector
// observation is a per-unit operator report and it is public. This module follows the precedent it
// is copied from and states the divergence so a reviewer can move it rather than discover it. What
// is here is chassis STRUCTURE an operator saw from outside the machine, not an inventory of what
// is installed in it.
// THE UNIT IS NOT RE-DECLARED. gunbc.machine_intake_mtcollins1_dimm_connector_observation already
// names this machine through its intake receipt; a second DeclarationRef literal pointing at the
// same access observation would be one fact with two authors (DESIGN section 3). Imported instead,
// so a change of unit identity moves in one place.

// THE DISTINCTION THIS MODULE EXISTS TO HOLD. An APERTURE is a hole in the rear panel. A RISER
// ASSEMBLY is the bracket, connector and retention hardware behind it. A chassis ships with
// apertures whether or not risers are fitted -- that is what a blanking plate is for. The operator
// saw the rear panel; nobody has yet reported the inside. Collapsing the two would convert a
// platform capacity into a unit fact, which is the same error as reading "this DIMM type is
// supported" into "this population will train".
type RearApertureReport {
  aperture_count: Nat
  aperture_note: NonEmptyStr
}

type RiserOccupancy
  = RiserPositionsFitted { positions: Nat, evidence: NonEmptyStr }
  | RiserPositionsUnobserved { settled_by: NonEmptyStr }

// GENERATION AND PHYSICAL VARIANT ARE TWO FACTS. The 1U brief states "OCP 3.0 mezzanine card with
// multi-host support" and does not state SFF or thumbscrew retention, and OCP NIC 3.0 defines SFF
// alongside other physical variants -- so the generation does not imply the variant. Carried here
// rather than in a consumer so a part-admission fold can cite this evidence without minting a
// second per-unit observation. Found by quiet-swift-866 reading the brief rather than the summary.
type OcpPhysicalVariantStanding
  = OcpPhysicalVariantCited { variant: NonEmptyStr, authority: NonEmptyStr }
  | OcpPhysicalVariantUnresolved { settled_by: NonEmptyStr }

type OcpBayOccupancy
  = OcpBayEmpty { evidence: NonEmptyStr }
  | OcpBayPopulated { evidence: NonEmptyStr }
  | OcpBayOccupancyUnobserved { settled_by: NonEmptyStr }

type MtCollinsExpansionOperatorObservation {
  unit: DeclarationRef
  chassis_height: RackUnit
  observed_on: SpecificationDocumentDate
  observer: NonEmptyStr
  relay_message: NonEmptyStr
  method: NonEmptyStr
  rear_apertures: RearApertureReport
  riser_occupancy: RiserOccupancy
  ocp_bay_occupancy: OcpBayOccupancy
  ocp_physical_variant: OcpPhysicalVariantStanding
}

data mtcollins1_expansion_observation: MtCollinsExpansionOperatorObservation = MtCollinsExpansionOperatorObservation {
  unit: observed_unit,
  chassis_height: rack_unit(count: 1),
  observed_on: SpecificationDocumentDate { year: 2026, month: 9, day: 13 },
  observer: "operator",
  relay_message: "Operator report relayed in the session dashboard to eager-owl-205 on 2026-09-13; no message id was retained at the time of writing, which is itself worth recording rather than inventing one.",
  method: "Operator report of the rear panel of Foxconn Mt. Collins unit 1, relayed in the session dashboard. No interior inspection was reported and none was performed by this session.",
  rear_apertures: RearApertureReport {
    aperture_count: 2,
    aperture_note: "Two large horizontal rear apertures, consistent in position and orientation with the platform's two full-height half-length expansion positions. An aperture is what the rear panel exposes; it is not a report that a riser occupies it.",
  },
  riser_occupancy: RiserPositionsUnobserved {
    settled_by: "An interior report of whether a riser cage with a PCIe edge connector is fitted behind each aperture, or whether the positions are empty behind a blanking plate.",
  },
  ocp_physical_variant: OcpPhysicalVariantUnresolved {
    settled_by: "A close photograph of the empty OCP bay and its connector on this unit, or the 1U service-guide mechanical drawing. The 1U product brief establishes the generation and is silent on the physical variant.",
  },
  ocp_bay_occupancy: OcpBayOccupancyUnobserved {
    settled_by: "An interior or rear-bay report of whether the OCP 3.0 bay holds a card. BMC sensors naming an OCP zone were read on 2026-09-06 and name a slot rather than its occupancy.",
  },
}

// WHAT THE UNIT OFFERS, which is a different question from what the platform permits. The platform
// half is already modelled and is imported rather than restated: mt_collins_1u_expansion carries
// the "up to 2x FHHL PCIe Gen4 x16" upper bound and mt_collins_1u_ocp_slot carries the OCP 3.0
// mezzanine standing. This fold joins those with the observation above and refuses to answer
// further than the evidence reaches.
type AttachmentPointStanding
  = AttachmentPointOffered { positions: Nat, basis: NonEmptyStr }
  | AttachmentPointOccupied { basis: NonEmptyStr }
  | AttachmentPointUnobserved { platform_upper_bound: Nat, settled_by: NonEmptyStr }
  | AttachmentPointAbsent { basis: NonEmptyStr }
  | AttachmentPointReportExceedsPlatform { reported: Nat, platform_upper_bound: Nat }

fn pcie_attachment_standing(observation: MtCollinsExpansionOperatorObservation) -> AttachmentPointStanding {
  let platform: MtCollins1UExpansion = mt_collins_1u_expansion
  match observation.riser_occupancy {
    RiserPositionsFitted { positions: positions, evidence: evidence } =>
      match nat_compare(a: positions, b: platform.full_height_half_length_gen4_x16_slots) {
        Greater => AttachmentPointReportExceedsPlatform {
          reported: positions,
          platform_upper_bound: platform.full_height_half_length_gen4_x16_slots,
        }
        Equal => AttachmentPointOffered { positions: positions, basis: evidence }
        Less =>
          match nat_compare(a: positions, b: 0) {
            Equal => AttachmentPointAbsent {
              basis: "The report states zero fitted riser positions on this unit. The platform permits two; none are present, so nothing is offered here.",
            }
            Greater => AttachmentPointOffered { positions: positions, basis: evidence }
            Less => AttachmentPointReportExceedsPlatform {
              reported: positions,
              platform_upper_bound: platform.full_height_half_length_gen4_x16_slots,
            }
          }
      }
    RiserPositionsUnobserved { settled_by: settled_by } =>
      AttachmentPointUnobserved {
        platform_upper_bound: platform.full_height_half_length_gen4_x16_slots,
        settled_by: settled_by,
      }
  }
}

fn ocp_attachment_standing(observation: MtCollinsExpansionOperatorObservation) -> AttachmentPointStanding {
  match mt_collins_1u_ocp_slot {
    NoOcpSlot => AttachmentPointAbsent { basis: "The platform brief states no OCP mezzanine slot for this chassis." }
    OcpMezzanineSlotPresent { generation: generation, multi_host: multi_host, occupancy_note: occupancy_note } =>
      match observation.ocp_bay_occupancy {
        OcpBayEmpty { evidence: evidence } => AttachmentPointOffered { positions: 1, basis: evidence }
        OcpBayPopulated { evidence: evidence } => AttachmentPointOccupied { basis: evidence }
        OcpBayOccupancyUnobserved { settled_by: settled_by } =>
          AttachmentPointUnobserved { platform_upper_bound: 1, settled_by: settled_by }
      }
  }
}

type MtCollinsUnitExpansionEvidence
  = UnitExpansionEvidence {
      observation: MtCollinsExpansionOperatorObservation,
      pcie: AttachmentPointStanding,
      ocp: AttachmentPointStanding,
    }
  | NoExpansionObservationForUnit { requested_unit: DeclarationRef }

fn expansion_evidence_for_unit(unit: DeclarationRef) -> MtCollinsUnitExpansionEvidence {
  if declaration_ref_eq(a: unit, b: observed_unit) {
    UnitExpansionEvidence {
      observation: mtcollins1_expansion_observation,
      pcie: pcie_attachment_standing(observation: mtcollins1_expansion_observation),
      ocp: ocp_attachment_standing(observation: mtcollins1_expansion_observation),
    }
  } else {
    NoExpansionObservationForUnit { requested_unit: unit }
  }
}
