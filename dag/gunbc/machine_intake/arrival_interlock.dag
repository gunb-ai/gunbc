module gunbc.machine_intake_arrival_interlock

import std.types { NonEmptyStr, String }
import std.decl_ref { DeclarationRef, decl_ref }
import std.durable_exclusive_hold { DurableHoldOwnerRef, DurableHoldReleaseRef }
import gunbc.durable_exclusive_hold_file_store {
  file_hold_acquire, file_hold_release_assess, file_hold_release_commit,
  FileHoldAcquireOutcome,
  FileHoldAcquired, FileHoldOccupied, FileHoldAcquireLost, FileHoldAcquireStoreUnavailable,
  FileHoldSlotUndecodable, FileHoldKeyNotSlotAddressable,
  FileHoldReleasePlanned, FileHoldReleaseNotEligible,
  FileHoldReleased, FileHoldReleaseLost, FileHoldReleaseStoreUnavailable, FileHoldReleaseKeyNotSlotAddressable,
}
import gunbc.managed_host_unit_hold { unit_hold_store_root }
import gunbc.machine_intake_bmc_rotation_route {
  BmcRotationRouteStanding, rotation_route_is_grounded,
}
import gunbc.machine_intake_arrival_subject { ArrivalSubjectAdmitted }

// ── THE INTERLOCK AN MTJADE1 ARRIVAL WRITE TAKES ──────────────────────────────────────────────
// The standing grant's words cover the class; this is the physical-safety / route-ground fact the
// run must observe. It is not UnitHoldProof: mtjade1 has no ManagedHost unit-hold row until J4
// admission. The store host is srv1 (the same runner the arrival job pins). A wet acquire of the
// slot is file_hold_acquire on arrival_slot_key; this module admits the conjunction the write may
// proceed under, and is the DeclarationRef rostered against the census sites.
//
// Archive (J2) needs the exclusive slot only (reads, evidence write, no account rotation).
// BmcSecure (J4) and firmware qualification need the slot AND a grounded rotation route
// (admit_rotation_apply's premise).

data arrival_interlock_store_host: NonEmptyStr = "srv1" as NonEmptyStr

fn arrival_slot_key(subject_wire: NonEmptyStr) -> NonEmptyStr {
  join(["arrival:", subject_wire as String], "") as NonEmptyStr
}

type ArrivalSlotStanding
  = ArrivalSlotHeld { subject: ArrivalSubjectAdmitted }
  | ArrivalSlotNotHeld { cause: NonEmptyStr }

type ArrivalArchiveInterlockStanding
  = ArrivalArchiveInterlockAdmitted { subject: ArrivalSubjectAdmitted }
  | ArrivalArchiveInterlockRefused { cause: NonEmptyStr }

type ArrivalBmcSecureInterlockStanding
  = ArrivalBmcSecureInterlockAdmitted { subject: ArrivalSubjectAdmitted }
  | ArrivalBmcSecureInterlockRefused { cause: NonEmptyStr }

fn admit_arrival_archive_interlock(subject: ArrivalSubjectAdmitted, slot: ArrivalSlotStanding) -> ArrivalArchiveInterlockStanding {
  match slot {
    ArrivalSlotHeld { subject: held } =>
      if (held.wire as String) == (subject.wire as String) {
        ArrivalArchiveInterlockAdmitted { subject: subject }
      } else {
        ArrivalArchiveInterlockRefused { cause: "arrival slot was held for a different subject" as NonEmptyStr }
      }
    ArrivalSlotNotHeld { cause: c } => ArrivalArchiveInterlockRefused { cause: c }
  }
}

fn admit_arrival_bmc_secure_interlock(
  subject: ArrivalSubjectAdmitted,
  slot: ArrivalSlotStanding,
  route: BmcRotationRouteStanding,
) -> ArrivalBmcSecureInterlockStanding {
  match admit_arrival_archive_interlock(subject: subject, slot: slot) {
    ArrivalArchiveInterlockRefused { cause: c } => ArrivalBmcSecureInterlockRefused { cause: c }
    ArrivalArchiveInterlockAdmitted { subject: s } =>
      if rotation_route_is_grounded(standing: route) {
        ArrivalBmcSecureInterlockAdmitted { subject: s }
      } else {
        ArrivalBmcSecureInterlockRefused { cause: "rotation route is not grounded; admit_rotation_apply refuses" as NonEmptyStr }
      }
  }
}

fn arrival_slot_acquire_refusal(outcome: FileHoldAcquireOutcome) -> NonEmptyStr {
  match outcome {
    FileHoldAcquired { slot_key: _, owner: _, generation: _ } => "arrival slot acquire succeeded" as NonEmptyStr
    FileHoldOccupied { slot_key: k, holder: h, generation: _ } =>
      join(["arrival slot ", k as String, " is held by '", h as String, "'"], "") as NonEmptyStr
    FileHoldAcquireLost { slot_key: k } => join(["lost the race for arrival slot ", k as String], "") as NonEmptyStr
    FileHoldAcquireStoreUnavailable { slot_key: k, cause: _ } =>
      join(["arrival slot store unavailable for ", k as String], "") as NonEmptyStr
    FileHoldSlotUndecodable { slot_key: k, generation: _, detail: _ } =>
      join(["arrival slot ", k as String, " is undecodable"], "") as NonEmptyStr
    FileHoldKeyNotSlotAddressable { slot_key: k } =>
      join(["arrival slot key ", k as String, " is not slot-addressable"], "") as NonEmptyStr
  }
}

fn arrival_archive_interlock_from_live_slot(subject: ArrivalSubjectAdmitted, owner: DurableHoldOwnerRef) -> ArrivalArchiveInterlockStanding {
  let key = arrival_slot_key(subject_wire: subject.wire)
  match file_hold_acquire(root: unit_hold_store_root, slot_key: key, requested_owner: owner) {
    FileHoldOccupied { slot_key: k, holder: h, generation: g } =>
      ArrivalArchiveInterlockRefused { cause: arrival_slot_acquire_refusal(outcome: FileHoldOccupied { slot_key: k, holder: h, generation: g }) }
    FileHoldAcquireLost { slot_key: k } =>
      ArrivalArchiveInterlockRefused { cause: arrival_slot_acquire_refusal(outcome: FileHoldAcquireLost { slot_key: k }) }
    FileHoldAcquireStoreUnavailable { slot_key: k, cause: c } =>
      ArrivalArchiveInterlockRefused { cause: arrival_slot_acquire_refusal(outcome: FileHoldAcquireStoreUnavailable { slot_key: k, cause: c }) }
    FileHoldSlotUndecodable { slot_key: k, generation: g, detail: d } =>
      ArrivalArchiveInterlockRefused { cause: arrival_slot_acquire_refusal(outcome: FileHoldSlotUndecodable { slot_key: k, generation: g, detail: d }) }
    FileHoldKeyNotSlotAddressable { slot_key: k } =>
      ArrivalArchiveInterlockRefused { cause: arrival_slot_acquire_refusal(outcome: FileHoldKeyNotSlotAddressable { slot_key: k }) }
    FileHoldAcquired { slot_key: k, owner: o, generation: g } =>
      match admit_arrival_archive_interlock(subject: subject, slot: ArrivalSlotHeld { subject: subject }) {
        ArrivalArchiveInterlockRefused { cause: c } => ArrivalArchiveInterlockRefused { cause: c }
        ArrivalArchiveInterlockAdmitted { subject: s } =>
          match file_hold_release_assess(
            root: unit_hold_store_root,
            slot_key: k,
            owner: o,
            acquired_generation: g,
            released_by: "arrival-converge-archive-interlock" as DurableHoldReleaseRef,
          ) {
            FileHoldReleaseNotEligible { slot_key: _, refusal: _ } =>
              ArrivalArchiveInterlockRefused { cause: "arrival slot was acquired but release was not eligible" as NonEmptyStr }
            FileHoldReleasePlanned { plan: p } =>
              match file_hold_release_commit(plan: p) {
                FileHoldReleased { slot_key: _, generation: _ } => ArrivalArchiveInterlockAdmitted { subject: s }
                FileHoldReleaseLost { slot_key: _ } =>
                  ArrivalArchiveInterlockRefused { cause: "arrival slot release lost the race" as NonEmptyStr }
                FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } =>
                  ArrivalArchiveInterlockRefused { cause: "arrival slot store unavailable on release" as NonEmptyStr }
                FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } =>
                  ArrivalArchiveInterlockRefused { cause: "arrival slot key not addressable on release" as NonEmptyStr }
              }
          }
      }
  }
}

data arrival_archive_interlock_ref: DeclarationRef = decl_ref(
  module_path: "gunbc.machine_intake_arrival_interlock",
  decl_name: "admit_arrival_archive_interlock",
)

data arrival_bmc_secure_interlock_ref: DeclarationRef = decl_ref(
  module_path: "gunbc.machine_intake_arrival_interlock",
  decl_name: "admit_arrival_bmc_secure_interlock",
)
