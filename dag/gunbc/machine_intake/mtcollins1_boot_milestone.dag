module gunbc.machine_intake_mtcollins1_boot_milestone

import std.types { List }
import std.nat { Nat }
import std.measure { HardwareThreadCount, gibibyte, hardware_thread_count, hardware_thread_count_value }
import gunbc.machine_intake_mtcollins1_memory_census_observation { mtcollins1_nproc }
import gunbc.managed_host_boot_milestone { BootTopologyExpectation }
import gunbc.machine_intake_host_capture_envelope { HostCaptureStage, HostCaptureWorkloadShape, host_capture_census_stages }

// THE MACHINE'S FIGURE AND THE BOOT'S MILESTONE ARE TWO FACTS, NOT ONE ROW. mtcollins1_nproc stays
// 160: that is what the machine IS, read on it with both sockets populated (the census capture
// shows numactl 2 nodes of 80). The boot qualification today is held against a MILESTONE -- socket
// 0 alone, socket 1 being a separate bring-up (operator ruling, option A, 2026-09-25) -- and the gap
// between the two is declared as gunbc.rung_drop mtcollins1_boot_accepts_socket1_absent, which is
// retired only when both sockets enumerate at boot. Editing 160 to 80 would have made the machine
// lie about itself to make a gate green, and nothing would ever have asked for socket 1 back.
data mtcollins1_socket_count: Nat = 2

// One socket's share of the machine's figure, DERIVED rather than written as a second literal 80:
// the Altra Max's cores are uniform across its sockets, so a per-socket count that disagreed with
// nproc / sockets would be a second authority for the same reading.
fn mtcollins1_threads_per_socket() -> HardwareThreadCount {
  hardware_thread_count(count: hardware_thread_count_value(t: mtcollins1_nproc) / mtcollins1_socket_count)
}

// THE WHOLE-MACHINE SHAPE, KEPT UNCHANGED: four 16 GiB chunks, the census's original footprint. It is
// what the expectation rebinds to when gunbc.rung_drop mtcollins1_boot_accepts_socket1_absent
// retires -- not before, since no both-sockets expectation is admissible until socket 1 enumerates.
data mtcollins1_dual_socket_workload: HostCaptureWorkloadShape = HostCaptureWorkloadShape {
  chunk_stems: ["chunk0", "chunk1", "chunk2", "chunk3"],
  chunk_size: gibibyte(16),
}

// THE ONE-SOCKET SHAPE: a BOUNDED EDAC CHECK, NOT FULL-MEMORY OR SOAK QUALIFICATION. Two 2 GiB chunks
// (4 GiB exactly) against 16 GiB installed: enough traffic through socket 0's controllers for the
// edac-before/edac-after CE/UE comparison and the two-pass hash to mean something, small enough to
// sit well under the live environment's /dev/shm (tmpfs, half of RAM by default) and MemAvailable.
// It is declared, not derived from what the host reports free: the census PREFLIGHTS both
// capacities and REFUSES if this does not fit, so a boot never silently exercises less than this.
data mtcollins1_one_socket_workload: HostCaptureWorkloadShape = HostCaptureWorkloadShape {
  chunk_stems: ["chunk0", "chunk1"],
  chunk_size: gibibyte(2),
}

// The placement premise this row states for gunbc.managed_host_boot_milestone boot_placement_reading:
// mtcollins1's census capture observed 2 nodes of 80 for 2 sockets, i.e. monolithic, so node N is
// socket N on this machine.
data mtcollins1_one_socket_milestone: BootTopologyExpectation = BootTopologyExpectation {
  socket: 0,
  threads: mtcollins1_threads_per_socket(),
  workload: mtcollins1_one_socket_workload,
}

// THE EXPECTATION THE BOOT QUALIFICATION CHECKS TODAY. One binding, so the day socket 1 enumerates
// the retirement is this row (and the drop), not a hunt through the verdict.
data mtcollins1_boot_topology_expectation: BootTopologyExpectation = mtcollins1_one_socket_milestone

// THE CENSUS ROSTER THE MILESTONE BOOTS: the envelope's roster applied to the expectation's workload,
// so the image the boot runs and the verdict that judges it read one shape.
data mtcollins1_census_stages: List<HostCaptureStage> = host_capture_census_stages(workload: mtcollins1_boot_topology_expectation.workload)
