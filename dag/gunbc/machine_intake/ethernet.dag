module gunbc.machine_intake.ethernet

import std.measure { Minute }
import std.types { Bool, FilePath, List, NonEmptyStr, String }
import extdeps.standards.nic_attachment { NicAttachmentClass }
import extdeps.network.ipv4 { Ipv4Address, ipv4_address_eq }
import extdeps.network.mac { Eui48Address }
import extdeps.time.rfc3339 { Rfc3339Timestamp }
import extdeps.units.iso8601_calendar { Iso8601CivilDate }
import extdeps.bmc.ipmi_channel { IpmiChannelNumber }
import std.decl_ref { DeclarationRef }
import std.optional { Absent, Present }
import gunbc.machine_intake.subject { UnitKey }

// ONE PHYSICAL CONNECTOR IS NOT ONE FUNCTION. Mt. Collins initially misread a second BMC
// address as the host PXE interface. Mt. Jade's rear panel can carry a dedicated BMC RJ45
// plus a dual-port host module, and one of those host ports may also bind BMC NCSI. A Bool
// "is dedicated management" cannot represent that. Connector identity and function bindings
// are therefore separate types. Expansion-card attachment is the standard
// NicAttachmentClass, not a second PcieCem/OcpNic3 spelling.
// Panel text is an observation. Identity is an observed unit key + locator + attachment.
// An unobserved unit cannot mint SameUnit or DistinctUnits; matching discriminator prose
// is not a unit key. An unobserved function cannot mint SameFunction or DistinctFunctions;
// matching discriminator prose is not a function key.

type EthernetAttachment
  = BaseboardOnboard
  | NicClass { class: NicAttachmentClass }
  | AttachmentUnobserved { discriminator: NonEmptyStr }

type EthernetPortUnit
  = PortOnUnit { key: UnitKey }
  | PortUnitUnobserved { discriminator: NonEmptyStr }

type PhysicalEthernetPort {
  unit: EthernetPortUnit
  panel_label: NonEmptyStr
  connector_label: NonEmptyStr
  attachment: EthernetAttachment
}

type EthernetFunction
  = BmcDedicated
  | BmcNcsi
  | BmcHostBus
  | HostData
  | PrebootNetwork
  | FunctionUnobserved { discriminator: NonEmptyStr }

type EthernetFunctionBinding {
  port: PhysicalEthernetPort
  function: EthernetFunction
}

type EthernetLinkAddress
  = ConfiguredLink { configured: Eui48Address }
  | PermanentAndConfigured { permanent: Eui48Address, configured: Eui48Address }

// HOW A LINK ADDRESS WAS READ, declared beside the record that carries one. The same six octets
// could be a redfish reply, an `ipmitool lan print`, a DHCP packet, or somebody's recollection, and
// which of those it was decides how much weight a reach attempt puts on the address. A bare
// `ConfiguredLink { configured: mac_address(...) }` cannot say, so the record that carries one says
// it: what was asked of the unit, over which channel, where the raw capture is kept, when it was
// true, and which reading produced the address.
//
// IT LIVES HERE, ON THE RECORD, NOT IN WHATEVER INVENTORY CITES IT LATER. Provenance is part of
// taking a reading; a consumer that adds it afterwards can add the wrong one, and an inventory that
// owned the provenance would be a second place an address's story is kept -- the §3 fork this
// carrier exists to close.
// THE MOMENT A READING WAS TRUE, as materially different facts rather than one string. The field once
// held three kinds of thing at once: a dated reading, a bounded reading ("undated in the source;
// earlier than the 2026-10-03 reconfiguration") and no reading at all. A timestamp alone fits only
// the first, and forcing the others into it would be the fabricated default DESIGN.md section 5 calls
// a hard reject, so the sum says which kind of fact it is and each arm carries only what that kind can
// have. "No reading at all" is not a moment: it is a gap, and lives in host_interface_inventory.
//
// `ReadAtMinute` EXISTS BECAUSE THE SOURCE READINGS ARE MINUTE-GRAINED. "2026-09-06T02:30Z" has no
// seconds, which RFC 3339 requires, so it cannot inhabit `Rfc3339Timestamp` without inventing a
// second; the arm keeps the precision the source had. THE CLOCK TIME IS ONE `std.measure` `Minute`
// COUNT SINCE MIDNIGHT, not an hour field beside a minute field: two bare Ints made 25:99 writable and
// restated a unit the measure layer already owns. The count is not bounded to a day by construction (a
// checked constructor returning Optional is the rung above, unbuilt); that residual is stated here
// rather than hidden behind a field name.
type ReadingMoment
  = ReadAt { instant: Rfc3339Timestamp }
  | ReadAtMinute { date: Iso8601CivilDate, since_midnight: Minute }
  | ReadBefore { bound: Iso8601CivilDate, bound_stated_by: DeclarationRef }

// HOW AN ADDRESS IS READ ON THIS FLEET, as a closed vocabulary. The first cut packed "ipmitool -I
// lanplus lan print 1, MAC Address field" into one string: a program, its channel, its arguments and
// the output field it was read from, four named parts behind one leaf (section 2). The vocabularies
// are closed because the corpus contains exactly these readings.
type IpmiLanPrintField
  = IpmiMacAddressField

// THE FIELDS OF A BOOTP/DHCP EXCHANGE A LINK ADDRESS CAN BE READ OUT OF. `chaddr` and
// Client-Ethernet-Address are distinct fields of the same packet and the capture carries both.
type BootpCapturedField
  = BootpClientEthernetAddress
  | BootpChaddr

// THE READ-ONLY HOST COMMANDS THAT ESTABLISH AN INTERFACE'S ADDRESS ON A RUNNING HOST. The three
// answer different questions: `ip addr` the link address, `ethtool -i` the driver and bus info that
// say what the device is, `networkctl` the administrative state.
type HostInterfaceListingCommand
  = IpAddrShow
  | EthtoolDriverInfo
  | NetworkctlStatus

type ReadingInstrument
  = IpmiLanPrint { channel: IpmiChannelNumber, output_field: IpmiLanPrintField }
  | BootpPacketCapture { fields: List<BootpCapturedField> }
  | HostInterfaceListing { commands: List<HostInterfaceListingCommand> }

// THE STANDING OF THE CREDENTIAL A READING WAS TAKEN WITH. Whether the factory credential still
// works on a unit is a fact a later operator needs in order to repeat the reading.
type ReadingCredentialStanding
  = BootstrapFactoryCredentialUnrotated
  | CredentialStandingUnobserved { discriminator: NonEmptyStr }

// OVER WHAT PATH THE UNIT WAS ASKED. An out-of-band controller conversation says what the CONTROLLER
// believes regardless of what the host is doing; an in-band observation (a packet on the shared
// segment, or a command run in the host's own shell) can be answered by either the host or the
// controller -- the ambiguity this plan exists to close. A row that cannot say which path it came
// from cannot be trusted to say whose address it holds.
type ReadingChannel
  = OutOfBandController { controller_address: Ipv4Address, credential: ReadingCredentialStanding }
  | InBandSegmentSniff { sniffer_address: Ipv4Address? }
  | InBandHostShell { host_address: Ipv4Address, account: NonEmptyStr }
  | OperatorAtController

// WHERE THE RAW CAPTURE LIVES: a workspace file and the key read out of it, or a row of this
// repository's own model that holds the reading (the inventory borrows rather than restates).
type ReadingArtifact
  = WorkspaceCaptureFile { path: FilePath, field: NonEmptyStr }
  | ModelRow { row: DeclarationRef }

type InterfaceReadingProvenance {
  instrument: ReadingInstrument
  channel: ReadingChannel
  artifact: ReadingArtifact
  moment: ReadingMoment
  // THE READING ITSELF, in the words the capture uses: a quotation of what the instrument said, not a
  // packing of parts that have names above.
  reading: NonEmptyStr
}

// `provenance` is required rather than optional on purpose: a link address with no stated origin is
// an assertion, and the only way to keep the record honest is to make it impossible to build without
// saying where the address came from.
type ObservedEthernetLan {
  binding: EthernetFunctionBinding
  // ABSENT WHEN THE INTERFACE HAD NO ADDRESS WHEN READ (srv1's controller NIC is admin-down and
  // unconfigured in its receipt); a placeholder address would be a fabricated reading.
  network_address: Ipv4Address?
  link: EthernetLinkAddress
  provenance: InterfaceReadingProvenance
}

type PortUnitIdentityStanding
  = ObservedSameUnit
  | ObservedDistinctUnits
  | PortUnitIdentityUnobserved { discriminator: NonEmptyStr }

type ConnectorIdentityStanding
  = SameConnector
  | DistinctConnectors
  | ConnectorIdentityUnobserved { discriminator: NonEmptyStr }

type FunctionIdentityStanding
  = ObservedSameFunction
  | ObservedDistinctFunctions
  | FunctionIdentityUnobserved { discriminator: NonEmptyStr }

type ConnectorFunctionStanding
  = ObservedMultipleFunctions
  | ObservedSingleFunction
  | FunctionsOnDistinctConnectors
  | ConnectorFunctionUnobserved { discriminator: NonEmptyStr }

fn ethernet_port_unit_identity(a: EthernetPortUnit, b: EthernetPortUnit) -> PortUnitIdentityStanding {
  match a {
    PortOnUnit { key: ka } =>
      match b {
        PortOnUnit { key: kb } =>
          if (ka as String) == (kb as String) {
            ObservedSameUnit
          } else {
            ObservedDistinctUnits
          }
        PortUnitUnobserved { discriminator: _ } =>
          PortUnitIdentityUnobserved {
            discriminator: "one port binds a unit key and the other does not",
          }
      }
    PortUnitUnobserved { discriminator: _ } =>
      PortUnitIdentityUnobserved {
        discriminator: "at least one port has no unit key; matching unobserved prose is not unit identity",
      }
  }
}

fn ethernet_locator_and_attachment_match(a: PhysicalEthernetPort, b: PhysicalEthernetPort) -> Bool {
  (a.panel_label as String) == (b.panel_label as String)
    && (a.connector_label as String) == (b.connector_label as String)
    && a.attachment == b.attachment
}

fn ethernet_connector_identity(a: PhysicalEthernetPort, b: PhysicalEthernetPort) -> ConnectorIdentityStanding {
  match ethernet_port_unit_identity(a: a.unit, b: b.unit) {
    ObservedDistinctUnits => DistinctConnectors
    ObservedSameUnit =>
      if ethernet_locator_and_attachment_match(a: a, b: b) {
        SameConnector
      } else {
        DistinctConnectors
      }
    PortUnitIdentityUnobserved { discriminator: d } =>
      ConnectorIdentityUnobserved { discriminator: d }
  }
}

fn ethernet_ports_are_distinct(a: PhysicalEthernetPort, b: PhysicalEthernetPort) -> Bool {
  match ethernet_connector_identity(a: a, b: b) {
    DistinctConnectors => true
    SameConnector => false
    ConnectorIdentityUnobserved { discriminator: _ } => false
  }
}

fn ethernet_function_is_unobserved(f: EthernetFunction) -> Bool {
  match f {
    BmcDedicated => false
    BmcNcsi => false
    BmcHostBus => false
    HostData => false
    PrebootNetwork => false
    FunctionUnobserved { discriminator: _ } => true
  }
}

// `BmcHostBus` IS A CONTROLLER'S ETHERNET CONTROLLER SEEN AS A DEVICE ON THE HOST'S OWN BUS (USB
// CDC-Ether, a host-to-controller virtual NIC). It has no wire and so no segment to be reached on, which
// `BmcNcsi` -- the controller sharing a host data port's wire through the sideband -- does. They answer
// different reach questions, so they are different names (DESIGN.md section 3, meaning fork).
// `ethernet_function_is_controller` USED TO SIT HERE. It was `(f == BmcDedicated || f == BmcNcsi)` ANDed
// with `!is_unobserved(f)` -- a Bool over a coproduct whose first clause already made the second
// unfalsifiable (review 38602 finding 3; ctrl review policy: such a predicate dissolves into the
// match). Dissolving it left no predicate at all, because the single consumer, host_interface_inventory's
// `host_controller_interfaces`, wants the arms themselves: it now matches `BmcDedicated | BmcNcsi` and
// states there why `FunctionUnobserved` -- a function of its own, not a BMC function that happens to be
// unread -- is refused rather than counted.

fn ethernet_function_identity(a: EthernetFunction, b: EthernetFunction) -> FunctionIdentityStanding {
  if ethernet_function_is_unobserved(f: a) || ethernet_function_is_unobserved(f: b) {
    FunctionIdentityUnobserved {
      discriminator: "at least one function is unobserved; matching discriminator prose is not function identity",
    }
  } else if a == b {
    ObservedSameFunction
  } else {
    ObservedDistinctFunctions
  }
}

fn ethernet_port_may_carry_multiple_functions(
  a: EthernetFunctionBinding,
  b: EthernetFunctionBinding,
) -> ConnectorFunctionStanding {
  match ethernet_connector_identity(a: a.port, b: b.port) {
    SameConnector =>
      match ethernet_function_identity(a: a.function, b: b.function) {
        ObservedDistinctFunctions => ObservedMultipleFunctions
        ObservedSameFunction => ObservedSingleFunction
        FunctionIdentityUnobserved { discriminator: d } =>
          ConnectorFunctionUnobserved { discriminator: d }
      }
    DistinctConnectors => FunctionsOnDistinctConnectors
    ConnectorIdentityUnobserved { discriminator: d } =>
      ConnectorFunctionUnobserved { discriminator: d }
  }
}

fn observed_lans_have_distinct_addresses(a: ObservedEthernetLan, b: ObservedEthernetLan) -> Bool {
  match a.network_address {
    Present { value: left } => match b.network_address {
      Present { value: right } => ipv4_address_eq(a: left, b: right) == false
      Absent => false
    }
    Absent => false
  }
}

// THE ADDRESS A LAN RECORD CARRIES, however it came. `permanent` when the reading reported one (that
// is the burnable MAC burned into the interface, which is what a per-host inventory is for), and
// `configured` otherwise (the address seen answering on the wire, which is evidence of an interface
// and not a promise about its burned-in address -- the distinction EthernetLinkAddress was created to
// keep, so it is kept here too rather than flattened by the accessor).
fn lan_link_address(lan: ObservedEthernetLan) -> Eui48Address {
  match lan.link {
    ConfiguredLink { configured: c } => c
    PermanentAndConfigured { permanent: p, configured: _ } => p
  }
}
