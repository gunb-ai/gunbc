import std.algebra { trim }
import std.measure { Second }
import v2.std.optional { Present }
import extdeps.bmc.ipmi
import extdeps.tools.gnu_coreutils { coreutils_duration_operand, coreutils_timeout_expired_exit_code }
import extdeps.bmc.ipmi_master_write_read {
  MasterWriteReadBus, PrivateBus, MasterWriteReadCompletion,
  master_write_read_bus_byte, master_write_read_slave_byte, hex_byte_text,
  master_write_read_completion_of, master_write_read_completion_text, master_write_read_bytes_of, master_write_read_stderr_completion,
}
import extdeps.ampere.smpro_register {
  SmproRegister, SmproBootStage, SmproStageReading,
  smpro_manufacturer_id_reg, smpro_cur_bootstage_reg, smpro_bootstage_lo_reg, smpro_bootstage_hi_reg, smpro_bootstage_reg,
  smpro_value_size_bytes, smpro_manufacturer_id_expected, smpro_word, smpro_bootstage_of, smpro_cur_bootstage_of,
  smpro_stage_text, smpro_status_text,
  smpro_gpi_ras_err_reg, smpro_err_smpro_type_reg, smpro_err_smpro_info_lo_reg, smpro_err_smpro_info_hi_reg,
  smpro_err_smpro_data_lo_reg, smpro_err_smpro_data_hi_reg, smpro_warn_smpro_info_lo_reg, smpro_warn_smpro_info_hi_reg,
  smpro_err_pmpro_type_reg, smpro_err_pmpro_info_lo_reg, smpro_err_pmpro_info_hi_reg, smpro_err_pmpro_data_lo_reg,
  smpro_err_pmpro_data_hi_reg, smpro_warn_pmpro_info_lo_reg, smpro_warn_pmpro_info_hi_reg, smpro_vrd_warn_fault_event_data_reg,
  smpro_vrd_hot_event_data_reg, smpro_dimm_hot_event_data_reg, smpro_dimm_2x_refresh_event_data_reg,
}
import extdeps.ampere.smpro_internal_error {
  SmproInternalRecord, smpro_internal_error_of, smpro_internal_warning_of, smpro_internal_record_text,
  SmproProcessor, SmproProcessorSmpro, SmproProcessorPmpro, SmproRecordGate, smpro_record_gate, smpro_record_gate_lines,
}
import gunbc.clock_read { clock_now_probed_at_or_unknown }
import gunbc.machine_intake_mtcollins1_access_observation { mtcollins1_endpoint }

// THE READ-ONLY SMpro PASS OF ONE mtcollins1 BOOT ATTEMPT: which boot stage each socket's SMpro
// reports, read over IPMI Master Write-Read (extdeps.bmc.ipmi MasterWriteReadAuthenticated) after the
// attempt, as a section of the attempt's diagnostic bundle. Its question is the one the socket-1
// investigation could not answer from the console: at which stage socket 1 stopped.
//
// THE ORDER IS CONSERVATIVE (eager-owl-205, msg_8a25c38e): per socket, MANUFACTURER_ID first, then
// CUR_BOOTSTAGE, BOOTSTAGE_LO and BOOTSTAGE_HI, then the smpro-errmon internal error, warning and
// event registers, then BOOTSTAGE last; socket 0 before socket 1. The
// manufacturer ID is a known-answer read (extdeps.ampere.smpro_register
// smpro_manufacturer_id_expected), so a socket whose ID read did not return it has no established
// transport, and every read after it is NOT SENT with that as its typed reason: socket 0's control
// gates everything, socket 1's gates socket 1. NOTHING IS EVER WRITTEN to a register; the only I2C
// write is the [register, size] pair the SMpro's read protocol requires. That matters most for the
// error registers: the driver clears them only by WRITING (extdeps.ampere.smpro_register,
// smpro_errmon_read_safety_confirmation), so this pass reads each record without consuming it.
//
// EVERY PROBE IS KEPT AS ITS RAW OBSERVATION -- request bytes, exit code, stdout and stderr as the
// transport returned them -- beside the typed outcome read from it, so the dossier can be re-read by
// someone who disagrees with the decode.

// WHERE THE SMpros SIT: bus 2, socket 0 at 0x4F and socket 1 at 0x4E. These come from the operator's
// brief (eager-owl-205, msg_adb16d8a), not from a board document this corpus holds, and the bus TYPE
// is not stated there at all: private is this row's bet, because the SMpros are not IPMB devices.
// The manufacturer-ID control is what tests the bet: a NAK or bus error on socket 0's control says
// the bus or address is wrong, and the dossier says so rather than trying others.
type SmproLocationStanding = LocationFromOperatorBrief { relay: NonEmptyStr, private_bus_is_a_bet: Bool }

data mtcollins1_smpro_location_standing: SmproLocationStanding = LocationFromOperatorBrief {
  relay: "eager-owl-205 msg_adb16d8a-90bd-443f-9440-cad493921cfd: 'IPMI Master Write-Read (netfn 0x06 cmd 0x52, bus 2), socket 0 at 0x4F first as the transport control, then socket 1 at 0x4E'",
  private_bus_is_a_bet: true,
}

data mtcollins1_smpro_bus: MasterWriteReadBus = MasterWriteReadBus { channel: 0, bus_id: 2, bus_type: PrivateBus }

type SmproTarget {
  socket: Int
  seven_bit_address: Int
}

data mtcollins1_smpro_targets: List<SmproTarget> = [
  SmproTarget { socket: 0, seven_bit_address: 79 },
  SmproTarget { socket: 1, seven_bit_address: 78 },
]

// Per socket, in read order. The first row is the control; BOOTSTAGE is last. Each record's TYPE is
// read before its INFO and DATA, so a record is never assembled from words read before the TYPE
// that says whether it exists.
data mtcollins1_smpro_read_order: List<SmproRegister> = [
  smpro_manufacturer_id_reg, smpro_cur_bootstage_reg, smpro_bootstage_lo_reg, smpro_bootstage_hi_reg,
  smpro_gpi_ras_err_reg, smpro_err_smpro_type_reg, smpro_err_smpro_info_lo_reg, smpro_err_smpro_info_hi_reg,
  smpro_err_smpro_data_lo_reg, smpro_err_smpro_data_hi_reg, smpro_warn_smpro_info_lo_reg, smpro_warn_smpro_info_hi_reg,
  smpro_err_pmpro_type_reg, smpro_err_pmpro_info_lo_reg, smpro_err_pmpro_info_hi_reg, smpro_err_pmpro_data_lo_reg,
  smpro_err_pmpro_data_hi_reg, smpro_warn_pmpro_info_lo_reg, smpro_warn_pmpro_info_hi_reg, smpro_vrd_warn_fault_event_data_reg,
  smpro_vrd_hot_event_data_reg, smpro_dimm_hot_event_data_reg, smpro_dimm_2x_refresh_event_data_reg,
  smpro_bootstage_reg,
]

fn mtcollins1_smpro_probe_count() -> Int {
  count(mtcollins1_smpro_targets) * count(mtcollins1_smpro_read_order)
}

// ── the raw observation and its typed outcome ───────────────────────────────────────────────────

// sequence IS THE PROBE'S POSITION IN THE PASS, and it is the read's own input: each read is handed
// the number of outcomes already folded, so it cannot be issued before every earlier probe has an
// outcome (see mtcollins1_smpro_sequenced).
type SmproProbeRaw {
  sequence: Int
  socket: Int
  register: NonEmptyStr
  request: NonEmptyStr
  at: NonEmptyStr
  exit_code: Int
  stdout: String
  stderr: String
}

type SmproProbeOutcome
  = SmproWordRead { raw: SmproProbeRaw, word: Int }
  | SmproControllerRefused { raw: SmproProbeRaw, completion: MasterWriteReadCompletion }
  | SmproTransportFailed { raw: SmproProbeRaw, timed_out: Bool }
  | SmproResponseMalformed { raw: SmproProbeRaw, detail: NonEmptyStr }
  | SmproNotSent { socket: Int, register: NonEmptyStr, reason: NonEmptyStr }
  | SmproRequestUnencodable { socket: Int, register: NonEmptyStr, detail: NonEmptyStr }

// THE PURE DECISION over one transport result. A zero exit with bytes that are not exactly two hex
// bytes is malformed, never a zero word; a nonzero exit that names a completion code is the
// controller's refusal; one that names none is the transport's failure.
fn smpro_probe_outcome(raw: SmproProbeRaw) -> SmproProbeOutcome {
  if raw.exit_code == 0 {
    match master_write_read_bytes_of(stdout: raw.stdout, expected: smpro_value_size_bytes) {
      Absent => SmproResponseMalformed { raw: raw, detail: concat("expected ", to_string(smpro_value_size_bytes), " hex bytes on stdout") as NonEmptyStr }
      Present { value: bs } => {
        let first = match bs.first() { Absent => 0 Present { value: b } => b }
        let second = match bs.skip(n: 1).first() { Absent => 0 Present { value: b } => b }
        SmproWordRead { raw: raw, word: smpro_word(first_byte: first, second_byte: second) }
      }
    }
  } else {
    match master_write_read_stderr_completion(stderr: raw.stderr) {
      Present { value: c } => SmproControllerRefused { raw: raw, completion: master_write_read_completion_of(code: c) }
      Absent => SmproTransportFailed { raw: raw, timed_out: raw.exit_code == coreutils_timeout_expired_exit_code }
    }
  }
}

fn smpro_outcome_word(o: SmproProbeOutcome) -> Int? {
  match o {
    SmproWordRead { raw: _, word: w } => Present { value: w }
    SmproControllerRefused { raw: _, completion: _ } => none
    SmproTransportFailed { raw: _, timed_out: _ } => none
    SmproResponseMalformed { raw: _, detail: _ } => none
    SmproNotSent { socket: _, register: _, reason: _ } => none
    SmproRequestUnencodable { socket: _, register: _, detail: _ } => none
  }
}

fn smpro_outcome_text(o: SmproProbeOutcome) -> String {
  match o {
    SmproWordRead { raw: _, word: w } => concat("read 0x", substring(s: hex_byte_text(n: w / 256), start: 2, end: 4), substring(s: hex_byte_text(n: w % 256), start: 2, end: 4))
    SmproControllerRefused { raw: _, completion: c } => concat("REFUSED by the BMC: ", master_write_read_completion_text(c: c))
    SmproTransportFailed { raw: r, timed_out: t } => concat("TRANSPORT FAILED (exit ", to_string(r.exit_code), if t { ", deadline" } else { "" }, "): ", trim(r.stderr))
    SmproResponseMalformed { raw: _, detail: d } => concat("MALFORMED: ", d as String)
    SmproNotSent { socket: _, register: _, reason: why } => concat("NOT SENT: ", why as String)
    SmproRequestUnencodable { socket: _, register: _, detail: d } => concat("NOT SENT, request unencodable: ", d as String)
  }
}

// Why the control did not establish a transport, or Absent when it did.
fn smpro_control_refusal(o: SmproProbeOutcome) -> String? {
  match o {
    SmproWordRead { raw: _, word: w } => if w == smpro_manufacturer_id_expected { none } else {
      Present { value: concat("MANUFACTURER_ID read ", smpro_outcome_text(o: o), ", not the 0xcd3a an SMpro answers") }
    }
    SmproControllerRefused { raw: _, completion: _ } => Present { value: concat("MANUFACTURER_ID ", smpro_outcome_text(o: o)) }
    SmproTransportFailed { raw: _, timed_out: _ } => Present { value: concat("MANUFACTURER_ID ", smpro_outcome_text(o: o)) }
    SmproResponseMalformed { raw: _, detail: _ } => Present { value: concat("MANUFACTURER_ID ", smpro_outcome_text(o: o)) }
    SmproNotSent { socket: _, register: _, reason: _ } => Present { value: concat("MANUFACTURER_ID ", smpro_outcome_text(o: o)) }
    SmproRequestUnencodable { socket: _, register: _, detail: _ } => Present { value: concat("MANUFACTURER_ID ", smpro_outcome_text(o: o)) }
  }
}

// ── the reads (effects) ─────────────────────────────────────────────────────────────────────────

fn smpro_request_text(bus: Int, slave: Int, reg: Int) -> NonEmptyStr {
  concat("raw 0x06 0x52 ", hex_byte_text(n: bus), " ", hex_byte_text(n: slave), " ", hex_byte_text(n: smpro_value_size_bytes), " ", hex_byte_text(n: reg), " ", hex_byte_text(n: smpro_value_size_bytes)) as NonEmptyStr
}

fn mtcollins1_smpro_read(username: NonEmptyStr, password_file: NonEmptyStr, target: SmproTarget, reg: SmproRegister, sequence: Int, deadline: Second, kill_after: Second) -> SmproProbeOutcome
{
  match master_write_read_bus_byte(bus: mtcollins1_smpro_bus) {
    Absent => SmproRequestUnencodable { socket: target.socket, register: reg.name, detail: "the bus fields do not fit the request's byte 1" }
    Present { value: bus } => match master_write_read_slave_byte(seven_bit_address: target.seven_bit_address) {
      Absent => SmproRequestUnencodable { socket: target.socket, register: reg.name, detail: "the address is not a 7-bit address" }
      Present { value: slave } => {
        let at = clock_now_probed_at_or_unknown()
        let r = diagnostic.ipmi.Tool.MasterWriteReadAuthenticated(
          bmc_host: mtcollins1_endpoint.host,
          username: username,
          password_file: password_file,
          bus: hex_byte_text(n: bus) as NonEmptyStr,
          slave_address: hex_byte_text(n: slave) as NonEmptyStr,
          read_count: hex_byte_text(n: smpro_value_size_bytes) as NonEmptyStr,
          write_first: hex_byte_text(n: reg.offset) as NonEmptyStr,
          write_second: hex_byte_text(n: smpro_value_size_bytes) as NonEmptyStr,
          deadline: coreutils_duration_operand(d: deadline) as NonEmptyStr,
          kill_after: coreutils_duration_operand(d: kill_after) as NonEmptyStr,
        )
        smpro_probe_outcome(raw: SmproProbeRaw {
          sequence: sequence, socket: target.socket, register: reg.name, request: smpro_request_text(bus: bus, slave: slave, reg: reg.offset),
          at: at, exit_code: r.exit_code, stdout: r.stdout, stderr: r.transport_stderr,
        })
      }
    }
  }
}

// THE ORDER IS A DATA DEPENDENCE, NOT A SOURCE POSITION. The plan is one ordered list of (socket,
// register), and one fold walks it: each step decides from the outcomes ALREADY FOLDED whether to
// read at all (the controls gate what follows) and hands the read its sequence, count(acc). A read
// therefore consumes every earlier probe's outcome, so no evaluation strategy can issue BOOTSTAGE
// before the reads the plan puts ahead of it. Independent `let` bindings carried no such
// dependence, which is the defect this replaces. The read itself is a parameter, so a witness can
// run this exact fold with a supplied read and observe the order.
type SmproPlannedProbe {
  target: SmproTarget
  register: SmproRegister
}

fn mtcollins1_smpro_plan() -> List<SmproPlannedProbe> {
  flat_map(mtcollins1_smpro_targets, t => map(mtcollins1_smpro_read_order, reg => SmproPlannedProbe { target: t, register: reg }))
}

fn is_control(reg: SmproRegister) -> Bool {
  reg.offset == smpro_manufacturer_id_reg.offset
}

// The control outcome already folded for a socket, if its control has been probed.
fn folded_control(acc: List<SmproProbeOutcome>, socket: Int) -> SmproProbeOutcome? {
  filter(acc, o => outcome_socket(o: o) == socket && outcome_register(o: o) == (smpro_manufacturer_id_reg.name as String)).first()
}

// Why this step must not be sent, from what is already folded: socket 0's control gates every
// later socket, and a socket's own control gates its boot-progress reads.
fn smpro_step_block(acc: List<SmproProbeOutcome>, probe: SmproPlannedProbe) -> String? {
  let first_socket = match mtcollins1_smpro_targets.first() { Absent => 0 Present { value: t } => t.socket }
  let gate0 = if probe.target.socket == first_socket { none } else {
    match folded_control(acc: acc, socket: first_socket) {
      Absent => Present { value: "socket 0 control was not probed before this socket" }
      Present { value: c } => match smpro_control_refusal(o: c) { Absent => none Present { value: why } => Present { value: concat("socket 0 control did not establish the transport: ", why) } }
    }
  }
  match gate0 {
    Present { value: why } => Present { value: why }
    Absent => if is_control(reg: probe.register) { none } else {
      match folded_control(acc: acc, socket: probe.target.socket) {
        Absent => Present { value: concat("socket ", to_string(probe.target.socket), " control was not probed before this register") }
        Present { value: c } => match smpro_control_refusal(o: c) { Absent => none Present { value: why } => Present { value: concat("socket ", to_string(probe.target.socket), " control: ", why) } }
      }
    }
  }
}

fn mtcollins1_smpro_sequenced(plan: List<SmproPlannedProbe>, read: fn(SmproTarget, SmproRegister, Int) -> SmproProbeOutcome) -> List<SmproProbeOutcome> {
  let empty: List<SmproProbeOutcome> = []
  fold(plan, init: empty, f: (acc, probe) => concat(acc, [
    match smpro_step_block(acc: acc, probe: probe) {
      Present { value: why } => SmproNotSent { socket: probe.target.socket, register: probe.register.name, reason: why as NonEmptyStr }
      Absent => read(probe.target, probe.register, count(acc))
    }
  ]))
}

fn mtcollins1_smpro_probes(username: NonEmptyStr, password_file: NonEmptyStr, deadline: Second, kill_after: Second) -> List<SmproProbeOutcome>
{
  mtcollins1_smpro_sequenced(plan: mtcollins1_smpro_plan(), read: (t, reg, n) => mtcollins1_smpro_read(username: username, password_file: password_file, target: t, reg: reg, sequence: n, deadline: deadline, kill_after: kill_after))
}

// ── what each socket's reads establish ──────────────────────────────────────────────────────────

fn outcome_socket(o: SmproProbeOutcome) -> Int {
  match o {
    SmproWordRead { raw: r, word: _ } => r.socket
    SmproControllerRefused { raw: r, completion: _ } => r.socket
    SmproTransportFailed { raw: r, timed_out: _ } => r.socket
    SmproResponseMalformed { raw: r, detail: _ } => r.socket
    SmproNotSent { socket: s, register: _, reason: _ } => s
    SmproRequestUnencodable { socket: s, register: _, detail: _ } => s
  }
}

fn outcome_register(o: SmproProbeOutcome) -> String {
  match o {
    SmproWordRead { raw: r, word: _ } => r.register as String
    SmproControllerRefused { raw: r, completion: _ } => r.register as String
    SmproTransportFailed { raw: r, timed_out: _ } => r.register as String
    SmproResponseMalformed { raw: r, detail: _ } => r.register as String
    SmproNotSent { socket: _, register: g, reason: _ } => g as String
    SmproRequestUnencodable { socket: _, register: g, detail: _ } => g as String
  }
}

// TWO INDEPENDENT READINGS PER SOCKET. CUR_BOOTSTAGE is where the SMpro says the socket IS;
// BOOTSTAGE is the stage and status it REPORTS, which the driver advances only by the write this
// pass never makes, so the two may differ by design. Neither is derived from the other, and a
// failure reading one leaves the other standing.
type SmproCurrentStage
  = CurrentStageEstablished { stage: SmproStageReading }
  | CurrentStageUnavailable { reason: String }

type SmproReportedStage
  = ReportedStageEstablished { bootstage: SmproBootStage }
  | ReportedStageUnavailable { reason: String }

type SmproSocketStage {
  socket: Int
  current: SmproCurrentStage
  reported: SmproReportedStage
}

fn smpro_socket_word(outcomes: List<SmproProbeOutcome>, socket: Int, register: NonEmptyStr) -> SmproProbeOutcome? {
  filter(outcomes, o => outcome_socket(o: o) == socket && outcome_register(o: o) == (register as String)).first()
}

fn register_unavailable_reason(o: SmproProbeOutcome?, name: NonEmptyStr) -> String {
  match o {
    Absent => concat(name as String, " was not probed")
    Present { value: x } => concat(name as String, " ", smpro_outcome_text(o: x))
  }
}

fn mtcollins1_smpro_socket_stage(outcomes: List<SmproProbeOutcome>, socket: Int) -> SmproSocketStage {
  let cur = smpro_socket_word(outcomes: outcomes, socket: socket, register: smpro_cur_bootstage_reg.name)
  let rep = smpro_socket_word(outcomes: outcomes, socket: socket, register: smpro_bootstage_reg.name)
  SmproSocketStage {
    socket: socket,
    current: match match cur { Absent => none Present { value: o } => smpro_outcome_word(o: o) } {
      Present { value: w } => CurrentStageEstablished { stage: smpro_cur_bootstage_of(word: w) }
      Absent => CurrentStageUnavailable { reason: register_unavailable_reason(o: cur, name: smpro_cur_bootstage_reg.name) }
    },
    reported: match match rep { Absent => none Present { value: o } => smpro_outcome_word(o: o) } {
      Present { value: w } => ReportedStageEstablished { bootstage: smpro_bootstage_of(word: w) }
      Absent => ReportedStageUnavailable { reason: register_unavailable_reason(o: rep, name: smpro_bootstage_reg.name) }
    },
  }
}

fn current_text(c: SmproCurrentStage) -> String {
  match c {
    CurrentStageEstablished { stage: st } => smpro_stage_text(r: st)
    CurrentStageUnavailable { reason: why } => concat("UNAVAILABLE (", why, ")")
  }
}

fn reported_text(r: SmproReportedStage) -> String {
  match r {
    ReportedStageEstablished { bootstage: b } => concat(smpro_stage_text(r: b.stage), ", ", smpro_status_text(r: b.status))
    ReportedStageUnavailable { reason: why } => concat("UNAVAILABLE (", why, ")")
  }
}

fn mtcollins1_smpro_stage_text(s: SmproSocketStage) -> String {
  concat("SMpro socket ", to_string(s.socket), ": CUR_BOOTSTAGE ", current_text(c: s.current), "; BOOTSTAGE ", reported_text(r: s.reported))
}

fn raw_text(r: SmproProbeRaw) -> String {
  concat("    #", to_string(r.sequence), " ", r.request as String, " at ", r.at as String, " exit=", to_string(r.exit_code), " stdout=[", trim(r.stdout), "] stderr=[", trim(r.stderr), "]")
}

fn outcome_raw_text(o: SmproProbeOutcome) -> String {
  match o {
    SmproWordRead { raw: r, word: _ } => raw_text(r: r)
    SmproControllerRefused { raw: r, completion: _ } => raw_text(r: r)
    SmproTransportFailed { raw: r, timed_out: _ } => raw_text(r: r)
    SmproResponseMalformed { raw: r, detail: _ } => raw_text(r: r)
    SmproNotSent { socket: _, register: _, reason: _ } => "    (no request sent)"
    SmproRequestUnencodable { socket: _, register: _, detail: _ } => "    (no request sent)"
  }
}

// ── the internal error records each socket reports (extdeps.ampere.smpro_internal_error) ─────────

// One processor's record set on one socket, GATED as the driver gates it
// (extdeps.ampere.smpro_internal_error smpro_record_gate): the socket's GPI_RAS_ERR from this same
// pass decides whether a decoded TYPE/INFO/DATA record is the driver's record, ungated, or a
// contradiction. A record is decoded only from words this pass actually read; when one was not, the
// record is Absent and `missing` says which word, never a zero standing in for it.
type SmproRecordSet {
  gate: SmproRecordGate
  missing: String?
}

type SmproSocketRecords {
  socket: Int
  smpro: SmproRecordSet
  pmpro: SmproRecordSet
  nonzero_events: List<String>
  events_unread: List<String>
}

type SmproWordsRead
  = AllWordsRead { words: List<Int> }
  | WordMissing { reason: String }

fn smpro_words_read(outcomes: List<SmproProbeOutcome>, socket: Int, regs: List<SmproRegister>) -> SmproWordsRead {
  let empty: List<Int> = []
  fold(regs, init: AllWordsRead { words: empty }, f: (acc, reg) => match acc {
    WordMissing { reason: r } => WordMissing { reason: r }
    AllWordsRead { words: ws } => {
      let o = smpro_socket_word(outcomes: outcomes, socket: socket, register: reg.name)
      match match o { Absent => none Present { value: x } => smpro_outcome_word(o: x) } {
        Present { value: w } => AllWordsRead { words: concat(ws, [w]) }
        Absent => WordMissing { reason: register_unavailable_reason(o: o, name: reg.name) }
      }
    }
  })
}

fn nth_word(ws: List<Int>, n: Int) -> Int {
  match ws.skip(n: n).first() { Absent => 0 Present { value: w } => w }
}

fn smpro_socket_gpi(outcomes: List<SmproProbeOutcome>, socket: Int) -> Int? {
  match smpro_socket_word(outcomes: outcomes, socket: socket, register: smpro_gpi_ras_err_reg.name) {
    Absent => none
    Present { value: o } => smpro_outcome_word(o: o)
  }
}

// Registers in TYPE, INFO_HI, INFO_LO, DATA_HI, DATA_LO, WARN_HI, WARN_LO order.
fn smpro_record_set(outcomes: List<SmproProbeOutcome>, socket: Int, processor: SmproProcessor, regs: List<SmproRegister>) -> SmproRecordSet {
  let gpi = smpro_socket_gpi(outcomes: outcomes, socket: socket)
  match smpro_words_read(outcomes: outcomes, socket: socket, regs: regs) {
    WordMissing { reason: r } => SmproRecordSet { gate: smpro_record_gate(gpi: gpi, processor: processor, type_read: false, error: none, warning: none), missing: Present { value: r } }
    AllWordsRead { words: w } => SmproRecordSet {
      gate: smpro_record_gate(gpi: gpi, processor: processor, type_read: true,
        error: smpro_internal_error_of(type_word: nth_word(ws: w, n: 0), info_hi: nth_word(ws: w, n: 1), info_lo: nth_word(ws: w, n: 2), data_hi: nth_word(ws: w, n: 3), data_lo: nth_word(ws: w, n: 4)),
        warning: smpro_internal_warning_of(type_word: nth_word(ws: w, n: 0), warn_hi: nth_word(ws: w, n: 5), warn_lo: nth_word(ws: w, n: 6))),
      missing: none,
    }
  }
}

data mtcollins1_smpro_event_regs: List<SmproRegister> = [
  smpro_vrd_warn_fault_event_data_reg, smpro_vrd_hot_event_data_reg, smpro_dimm_hot_event_data_reg, smpro_dimm_2x_refresh_event_data_reg,
]

fn mtcollins1_smpro_socket_records(outcomes: List<SmproProbeOutcome>, socket: Int) -> SmproSocketRecords {
  SmproSocketRecords {
    socket: socket,
    smpro: smpro_record_set(outcomes: outcomes, socket: socket, processor: SmproProcessorSmpro, regs: [smpro_err_smpro_type_reg, smpro_err_smpro_info_hi_reg, smpro_err_smpro_info_lo_reg, smpro_err_smpro_data_hi_reg, smpro_err_smpro_data_lo_reg, smpro_warn_smpro_info_hi_reg, smpro_warn_smpro_info_lo_reg]),
    pmpro: smpro_record_set(outcomes: outcomes, socket: socket, processor: SmproProcessorPmpro, regs: [smpro_err_pmpro_type_reg, smpro_err_pmpro_info_hi_reg, smpro_err_pmpro_info_lo_reg, smpro_err_pmpro_data_hi_reg, smpro_err_pmpro_data_lo_reg, smpro_warn_pmpro_info_hi_reg, smpro_warn_pmpro_info_lo_reg]),
    nonzero_events: flat_map(mtcollins1_smpro_event_regs, reg => match match smpro_socket_word(outcomes: outcomes, socket: socket, register: reg.name) { Absent => none Present { value: x } => smpro_outcome_word(o: x) } {
      Present { value: w } => if w == 0 { [] } else { [concat(reg.name as String, " = ", to_string(w))] }
      Absent => []
    }),
    events_unread: flat_map(mtcollins1_smpro_event_regs, reg => match match smpro_socket_word(outcomes: outcomes, socket: socket, register: reg.name) { Absent => none Present { value: x } => smpro_outcome_word(o: x) } {
      Present { value: _ } => []
      Absent => [reg.name as String]
    }),
  }
}

fn record_set_lines(processor: String, rs: SmproRecordSet) -> List<String> {
  map(smpro_record_gate_lines(g: rs.gate), l => concat(processor, " ", l))
}

fn record_set_unavailable(processor: String, rs: SmproRecordSet) -> List<String> {
  match rs.missing {
    Present { value: why } => [concat(processor, " records UNAVAILABLE (", why, ")")]
    Absent => []
  }
}

// Every gated record, ungated record, gate contradiction or nonzero event a socket reports, one line
// each; empty when nothing was reported. A missing word is the dossier's to say, not a finding.
fn mtcollins1_smpro_record_lines(r: SmproSocketRecords) -> List<String> {
  map(concat(concat(record_set_lines(processor: "SMpro", rs: r.smpro), record_set_lines(processor: "PMpro", rs: r.pmpro)), map(r.nonzero_events, e => concat("event ", e))),
    l => concat("SMpro socket ", to_string(r.socket), ": ", l))
}

fn mtcollins1_smpro_records_text(r: SmproSocketRecords) -> String {
  let lines = mtcollins1_smpro_record_lines(r: r)
  let gaps = concat(concat(record_set_unavailable(processor: "SMpro", rs: r.smpro), record_set_unavailable(processor: "PMpro", rs: r.pmpro)),
    if count(r.events_unread) == 0 { [] } else { [concat("events not read: ", join(r.events_unread, ", "))] })
  let head = if count(lines) == 0 { [concat("SMpro socket ", to_string(r.socket), ": no internal error, warning or event decoded")] } else { lines }
  join(concat(head, map(gaps, g => concat("SMpro socket ", to_string(r.socket), ": ", g))), "\n")
}

// THE DOSSIER: every socket's stage (established or why not), then every probe with its raw
// observation. It is rendered for any list of outcomes, including one where nothing was sent.
fn mtcollins1_smpro_dossier_text(outcomes: List<SmproProbeOutcome>) -> String {
  join([
    concat("location: bus ", to_string(mtcollins1_smpro_bus.bus_id), " (private: a bet), from the operator brief; ", join(map(mtcollins1_smpro_targets, t => concat("socket ", to_string(t.socket), " at 7-bit ", hex_byte_text(n: t.seven_bit_address))), ", ")),
    join(map(mtcollins1_smpro_targets, t => mtcollins1_smpro_stage_text(s: mtcollins1_smpro_socket_stage(outcomes: outcomes, socket: t.socket))), "\n"),
    join(map(mtcollins1_smpro_targets, t => mtcollins1_smpro_records_text(r: mtcollins1_smpro_socket_records(outcomes: outcomes, socket: t.socket))), "\n"),
    "probes, in the order sent:",
    join(map(outcomes, o => concat("  socket ", to_string(outcome_socket(o: o)), " ", outcome_register(o: o), ": ", smpro_outcome_text(o: o), "\n", outcome_raw_text(o: o))), "\n"),
  ], "\n")
}

