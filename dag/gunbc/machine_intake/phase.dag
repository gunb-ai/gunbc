module gunbc.machine_intake_phase

import std.types { Bool, Int, List, NonEmptyStr, String }

// THREE TRANSACTIONS, ONE LIFECYCLE (machine-intake ruling 2026-08-29 §4). Hardware
// qualification, OS provisioning and placement commissioning are separate transactions: they
// may share boot delivery and receipts, but success in one must not fabricate success in
// another. A machine can be physically good while installation is unestablished, and
// installation can succeed on defective hardware. Arrival qualification runs immediately on
// delivery or repair, before shelving, while the return clock is valuable; placement
// commissioning runs in the actual serving location and is invalidated by a move, a PSU feed
// change, a cooling change or a fan-policy change WITHOUT invalidating the earlier memory
// qualification. The state between them is not Admitted. The phase vocabulary here is the
// ruling's, one arm per required result; the required result itself is stated on the phase's
// row in docs/plans/machine-intake-design.md and is what a receipt for that phase must carry.
// gunbc.bmc_onboarding's single-lifecycle vocabulary (CredentialsRotated, OsInstalled,
// FabricJoined) is what this splits apart; extracting its BMC-security, provisioning and
// fabric-join standings into these three transactions is the follow-up the ruling's §14 names,
// not a second lifecycle grown beside it.
type IntakeTransaction
  = ArrivalHardwareQualification
  | OsProvisioning
  | PlacementCommissioning

type ArrivalPhase
  = AccessDiscover
  | IdentityBindProvisional
  | PriorLifeBoundary
  | BmcSecure
  | BootDeliveryEstablish
  | DiagnosticBootAttest
  | InventoryConform
  | MemoryFastQualify
  | MemoryAuthoritativeQualify
  | SubsystemQualify
  | AcceptanceSoak
  | ArrivalCleanup

type ProvisioningPhase
  = OsArtifactDelivered
  | OsInstalled
  | InstalledSystemBootedFromLocalTarget
  | RuntimeIdentityMatchesIntakeSubject

type PlacementPhase
  = PlacementIdentityBound
  | ActualCoolingAndFanPolicyObserved
  | ActualNetworkPathsQualified
  | PlacementLoadSoakQualified
  | WallPowerMeasured
  | ServiceRuntimeAdmitted

type IntakePhase
  = Arrival { phase: ArrivalPhase }
  | Provisioning { phase: ProvisioningPhase }
  | Placement { phase: PlacementPhase }

fn intake_phase_transaction(phase: IntakePhase) -> IntakeTransaction {
  match phase {
    Arrival { phase: _ } => ArrivalHardwareQualification
    Provisioning { phase: _ } => OsProvisioning
    Placement { phase: _ } => PlacementCommissioning
  }
}

fn arrival_phase_label(phase: ArrivalPhase) -> NonEmptyStr {
  match phase {
    AccessDiscover => "access-discover"
    IdentityBindProvisional => "identity-bind-provisional"
    PriorLifeBoundary => "prior-life-boundary"
    BmcSecure => "bmc-secure"
    BootDeliveryEstablish => "boot-delivery-establish"
    DiagnosticBootAttest => "diagnostic-boot-attest"
    InventoryConform => "inventory-conform"
    MemoryFastQualify => "memory-fast"
    MemoryAuthoritativeQualify => "memory-authoritative"
    SubsystemQualify => "subsystems"
    AcceptanceSoak => "arrival-soak"
    ArrivalCleanup => "arrival-cleanup"
  }
}

fn provisioning_phase_label(phase: ProvisioningPhase) -> NonEmptyStr {
  match phase {
    OsArtifactDelivered => "os-artifact-delivered"
    OsInstalled => "os-installed"
    InstalledSystemBootedFromLocalTarget => "installed-system-booted-locally"
    RuntimeIdentityMatchesIntakeSubject => "runtime-identity-matches-subject"
  }
}

fn placement_phase_label(phase: PlacementPhase) -> NonEmptyStr {
  match phase {
    PlacementIdentityBound => "placement-identity-bound"
    ActualCoolingAndFanPolicyObserved => "placement-cooling-observed"
    ActualNetworkPathsQualified => "placement-network-qualified"
    PlacementLoadSoakQualified => "placement-soak"
    WallPowerMeasured => "placement-wall-power"
    ServiceRuntimeAdmitted => "service-runtime-admitted"
  }
}

fn intake_phase_label(phase: IntakePhase) -> NonEmptyStr {
  match phase {
    Arrival { phase: p } => arrival_phase_label(phase: p)
    Provisioning { phase: p } => provisioning_phase_label(phase: p)
    Placement { phase: p } => placement_phase_label(phase: p)
  }
}

data arrival_phases_all: List<IntakePhase> = [
  Arrival { phase: AccessDiscover },
  Arrival { phase: IdentityBindProvisional },
  Arrival { phase: PriorLifeBoundary },
  Arrival { phase: BmcSecure },
  Arrival { phase: BootDeliveryEstablish },
  Arrival { phase: DiagnosticBootAttest },
  Arrival { phase: InventoryConform },
  Arrival { phase: MemoryFastQualify },
  Arrival { phase: MemoryAuthoritativeQualify },
  Arrival { phase: SubsystemQualify },
  Arrival { phase: AcceptanceSoak },
  Arrival { phase: ArrivalCleanup },
]

data provisioning_phases_all: List<IntakePhase> = [
  Provisioning { phase: OsArtifactDelivered },
  Provisioning { phase: OsInstalled },
  Provisioning { phase: InstalledSystemBootedFromLocalTarget },
  Provisioning { phase: RuntimeIdentityMatchesIntakeSubject },
]

data placement_phases_all: List<IntakePhase> = [
  Placement { phase: PlacementIdentityBound },
  Placement { phase: ActualCoolingAndFanPolicyObserved },
  Placement { phase: ActualNetworkPathsQualified },
  Placement { phase: PlacementLoadSoakQualified },
  Placement { phase: WallPowerMeasured },
  Placement { phase: ServiceRuntimeAdmitted },
]

// Every phase fleet admission requires. Nothing serves until all three
// transactions have succeeded; FleetAdmitted is the derived consequence of
// this roster being satisfied, never a phase of its own.
data fleet_admission_required_phases: List<IntakePhase> = concat(arrival_phases_all, concat(provisioning_phases_all, placement_phases_all))

type PhaseRankFold {
  index: Int
  rank: Int?
}

// A phase's rank is its POSITION in fleet_admission_required_phases — the one
// declared ordering; no second roster exists to disagree with it. The ledger
// validator reads this rank to refuse a phase recorded after a later-ranked
// phase. Absent is the roster not naming the phase; every IntakePhase arm is
// enumerated in the three per-transaction rosters above, so the validator's
// arm for Absent is fail-closed coverage rather than a reachable state.
fn intake_phase_rank(phase: IntakePhase) -> Int? {
  let folded = fold(
    fleet_admission_required_phases,
    init: PhaseRankFold { index: 0, rank: none },
    f: fn(acc, p) {
      match acc.rank {
        Present { value: _ } => acc
        Absent => {
          let here = p == phase
          if here { PhaseRankFold { index: acc.index + 1, rank: Present { value: acc.index } } } else { PhaseRankFold { index: acc.index + 1, rank: none } }
        }
      }
    },
  )
  folded.rank
}

// Who owns a phase's refusal. A staging-host outage, a missing platform
// profile, an expired credential, an unavailable EDAC driver or an unreachable
// artifact server is a loud non-admission WITH THE RIGHT OWNER — it must never
// become a hardware defect, because a hardware defect starts a return clock
// and this does not.
type QualificationRefusalOwner
  = UnitHardware
  | BmcAccess
  | StagingInfrastructure
  | PlatformModel
  | QualificationPolicy
  | OperatorAction

fn refusal_owner_label(owner: QualificationRefusalOwner) -> NonEmptyStr {
  match owner {
    UnitHardware => "unit-hardware"
    BmcAccess => "bmc-access"
    StagingInfrastructure => "staging-infrastructure"
    PlatformModel => "platform-model"
    QualificationPolicy => "qualification-policy"
    OperatorAction => "operator-action"
  }
}
