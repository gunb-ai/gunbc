module gunbc.machine_intake_mtcollins1_ui_bundle_observe

import std.types { NonEmptyStr, String }
import std.measure { Second }
import std.process { ProcessExit, exit_failure }
import gunbc.machine_intake_mtcollins1_access_observation { mtcollins1_boot_ipmi_read_deadline, mtcollins1_boot_ipmi_kill_after }
import gunbc.fleet_host_identity { operator_host_mtcollins1 }
import gunbc.megarac_managed_host { MegaRacHostAdmitted, MegaRacHostRefused, megarac_host_admission_for, megarac_host_refusal_text }
import gunbc.megarac_operation_standing { MegaRacServedUiRead }
import gunbc.machine_intake_megarac_boot_media_attach { MegaRacIpmiReadBound }
import gunbc.machine_intake_mtcollins1_fan_observe { FanCredentialPathReady, FanCredentialPathUnset, FanCredentialPathEmpty, mtcollins1_fan_credential_path, mtcollins1_fan_credential_path_env }
import gunbc.machine_intake_megarac_ui_bundle_observe { MegaRacUiBundlePaths, megarac_ui_bundle_observe_with, megarac_ui_bundle_read_bound }

// MT. COLLINS UNIT 1'S BINDING OF THE MEGARAC SERVED-UI READ (managed-host cut 5). The read itself is
// gunbc.machine_intake_megarac_ui_bundle_observe over an admitted managed host; what stays here is only
// what the fleet-converge workflow names (ruling (a): the workflow surface moves in cut 7) -- the entry
// function, the artifact prefix and glob the upload step reads, the step's read bound -- and the
// mtcollins1 row it binds: the host label, this unit's IPMI read bound, and the credential file the
// workflow prelude materializes.

data mtcollins1_ui_bundle_paths: MegaRacUiBundlePaths = MegaRacUiBundlePaths { prefix: "target/mtcollins1-ui-bundle-" }

data mtcollins1_ui_bundle_artifact_glob: String = concat(mtcollins1_ui_bundle_paths.prefix, "*")

data mtcollins1_ui_bundle_ipmi_read_bound: MegaRacIpmiReadBound = MegaRacIpmiReadBound {
  deadline: mtcollins1_boot_ipmi_read_deadline,
  kill_after: mtcollins1_boot_ipmi_kill_after,
}

fn mtcollins1_ui_bundle_read_bound() -> Second {
  megarac_ui_bundle_read_bound(bound: mtcollins1_ui_bundle_ipmi_read_bound)
}

// REFUSALS BEFORE THE FIRST REQUEST, EACH NAMING WHAT IS MISSING: the host does not admit the served UI
// read (not managed, not bound, not MegaRAC, or the read not grounded at its build), or no credential.
fn mtcollins1_ui_bundle_observe_wet() -> ProcessExit
{
  match megarac_host_admission_for(host: operator_host_mtcollins1 as NonEmptyStr, operation: MegaRacServedUiRead) {
    MegaRacHostRefused { cause: c } => exit_failure(reason: concat("mtcollins1 ui bundle: ", megarac_host_refusal_text(cause: c) as String))
    MegaRacHostAdmitted { host: admitted } =>
      match mtcollins1_fan_credential_path() {
        FanCredentialPathUnset => exit_failure(reason: join(["mtcollins1 ui bundle: no ", mtcollins1_fan_credential_path_env as String, " in the environment; contacting NO host"], ""))
        FanCredentialPathEmpty => exit_failure(reason: join(["mtcollins1 ui bundle: ", mtcollins1_fan_credential_path_env as String, " is set but empty; contacting NO host"], ""))
        FanCredentialPathReady { path: p } =>
          megarac_ui_bundle_observe_with(host: admitted, password_file: p, paths: mtcollins1_ui_bundle_paths, bound: mtcollins1_ui_bundle_ipmi_read_bound)
      }
  }
}
