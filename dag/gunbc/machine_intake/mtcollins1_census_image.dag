module gunbc.machine_intake.mtcollins1_census_image

import std.types { Bool, List, NonEmptyStr, String }
import std.measure { Bandwidth, bandwidth, bandwidth_count }
import extdeps.kmod.libkmod { libkmod_log_priority_env_name, libkmod_log_priority_info }
import extdeps.systemd.udevd { udevd_log_level_cmdline_key, systemd_log_level_debug, systemd_log_target_env_name, systemd_log_target_kmsg }
import extdeps.linux.kernel { linux_printk_devkmsg_on_cmdline_arg }
import extdeps.provisioning.ubuntu_install_media { noble_numbat_2404_3_live_server_arm64 }
import extdeps.provisioning.ubuntu_seeded_install_media {
  NoCloudSeedFile,
  UbuntuSeededInstallMediaBuildInput,
  ubuntu_seeded_install_media_grub_kernel_cmdline,
  ubuntu_seeded_install_media_image_name,
  ubuntu_seeded_install_media_record_path,
}
import extdeps.os.ubuntu_autoinstall { UbuntuAutoinstallLiveCommands }
import gunbc.os_install_emit { autoinstall_live_commands_user_data, AutoinstallUserData, AutoinstallUserDataRendered, AutoinstallUserDataRefused }
import gunbc.provisioning.seeded_install_media_policy { seeded_install_media_pinned_dates, seeded_install_media_builder_revision }
import std.optional { Present }
import gunbc.host.boot_medium { BootImageExport, BootMedium, BootMediumNoTerminal, BootMediumVolumeLabel, BootMediumRunnerHostUp, bmc_boot_image_export, boot_image_export_eq, stock_installer_boot_medium }
import gunbc.machine_intake.boot_image_fetch { boot_image_published_path }
import gunbc.machine_intake.host_capture_envelope {
  HostCaptureStage,
  host_capture_program,
}
import gunbc.machine_intake.mtcollins1_boot_milestone { mtcollins1_census_stages }
import extdeps.ssh.known_hosts { known_hosts_host_field }
import gunbc.host.boot_medium_served_readback { BootMediumServedCheck, BootMediumServedMeasureOnly, BootMediumServedRecordFirst, BootMediumServedCheckRefused }

// THE CENSUS IMAGE FOR MT. COLLINS UNIT 1: the 24.04.3 arm64 live-server medium with a NoCloud seed
// that runs the host-capture census in the LIVE environment and powers off. It is a derived artifact
// with its own identity -- the bytes differ from stock, so it never takes the stock name and the
// stock file in the export is never touched.
//
// THE RUNTIME SHAPE, in order: UEFI boots the medium; grub passes autoinstall and the NoCloud
// seedfrom; subiquity reads the seed from the medium and runs its early-commands before any other
// step; the one early command runs the capture program off the medium, which writes the envelope to
// the serial console, syncs, and powers off. Nothing is fetched at runtime: the program rides in the
// seed directory. If the power-off does not happen, every later installer section is interactive,
// so the machine waits at the installer rather than touching storage.
//
// The unit's name in the capture envelope. The boot run's verdict matches envelope markers against
// its subject's machine, so this and that must be one value.
data mtcollins1_census_machine: NonEmptyStr = "mtcollins1"

// The Altra host's serial console is the PL011 at ttyAMA0 -- the console the BMC's SOL carries and
// the one attempt=3's envelope arrived on. THE TTY IS ONE ROW because the program writes to the
// device and the kernel is told to console on the same tty: authored twice, an edit to one spelling
// sends the census to a device nothing is reading, and the envelope's absence would be reported as a
// boot failure -- the misattribution this lane exists to end. Both spellings derive from here.
data mtcollins1_census_console_tty: NonEmptyStr = "ttyAMA0"

// THE RATE IS A MEASURE, not text: the corpus already models a serial console's rate as
// std.measure Bandwidth (extdeps.network.mikrotik_crs812 rj45 console data_rate), so the kernel
// argument RENDERS this row rather than restating the number.
data mtcollins1_census_console_baud: Bandwidth = bandwidth(count: 115200)

data mtcollins1_census_console_device: NonEmptyStr = concat("/dev/", mtcollins1_census_console_tty as String) as NonEmptyStr

data mtcollins1_census_console_arg: NonEmptyStr = concat(
  "console=", mtcollins1_census_console_tty as String, ",",
  bandwidth_count(b: mtcollins1_census_console_baud) as String,
) as NonEmptyStr

// THE MODULE-IDENTITY INSTRUMENT (gunbc.machine_intake.kernel_module_decompression_observation).
// The kernel's "ZSTD-decompression failed" line names no module; the loader's record does, and in
// this initrd (systemd-udevd 255.4, libkmod 31) it reaches the serial capture only when all four hold:
//   KMOD_LOG=info            libkmod's path-bearing "Failed to insert module" line is INFO, and its
//                            default priority is ERR (extdeps.kmod.libkmod). The kernel hands an
//                            unrecognised KEY=value to /init's environment and initramfs-tools'
//                            init does not scrub it, so udevd inherits it.
//   udev.log_level=debug     overrides the SYSTEMD_LOG_LEVEL=info that init-top/udev sets.
//   SYSTEMD_LOG_TARGET=kmsg  without it udevd writes to /dev/console, which is the LAST console= --
//                            tty0 here, the KVM, not the SOL line (extdeps.systemd.udevd).
//   printk.devkmsg=on        the default rate limit drops a burst of userspace kmsg records.
// The INFO record reaches SOL at the default console loglevel; udev's per-device DEBUG records stay
// in the kmsg ring, so the requesting device is unread on SOL by design (eager-owl-205, option A:
// ignore_loglevel would flood the 115200 line and perturb the timing of a possible race).
// It is a build input like any other: changing it changes the build key and the digest, so the
// image is republished, read back and repinned; nothing edits GRUB by hand.
data mtcollins1_census_module_identity_args: NonEmptyStr = join([
  concat(libkmod_log_priority_env_name as String, "=", libkmod_log_priority_info as String),
  concat(udevd_log_level_cmdline_key as String, "=", systemd_log_level_debug as String),
  concat(systemd_log_target_env_name as String, "=", systemd_log_target_kmsg as String),
  linux_printk_devkmsg_on_cmdline_arg as String,
], " ") as NonEmptyStr

// The seed directory the earlier census booted with (its /proc/cmdline in attempt=3 reads
// ds=nocloud;s=/cdrom/gunbc-census/), kept so the two captures are comparable.
data mtcollins1_census_nocloud_dir: NonEmptyStr = "gunbc-census"

data mtcollins1_census_program_file: NonEmptyStr = "capture.sh"

// poweroff -f does not return on success. If it fails, the installer continues into a session whose
// every section is interactive (see the seed), so no storage action is reachable without a human.
data mtcollins1_census_halt_command: NonEmptyStr = "poweroff -f"

// ISO 9660 limits a volume id to 32 d-characters. This is the label the booted host reports for the
// medium, so the boot-media check expects it rather than the stock "Ubuntu-Server 24.04.3 LTS arm64".
data mtcollins1_census_volume_id: NonEmptyStr = "GUNBC_MTC1_CENSUS_2404_3"

data mtcollins1_census_image_stem: NonEmptyStr = "gunbc-mtcollins1-census-ubuntu-24.04.3-arm64"

// THE CENSUS CAPTURE PROGRAM FOR A SUBJECT: the census stages run before any installer section and
// the envelope ends by the subject's halt command on the subject's console. The machine, the console
// device and the halt command are the subject's facts, passed by the caller; for mt. collins unit 1
// they are the receipt rows below, so the mt. collins program is exactly this applied to that row.
fn census_capture_program(machine: NonEmptyStr, console_device: NonEmptyStr, halt_command: NonEmptyStr, stages: List<HostCaptureStage>) -> NonEmptyStr {
  host_capture_program(
    machine: machine,
    console_device: console_device,
    stages: stages,
    halt_command: halt_command,
  )
}

// THE PATH THE CAPTURE PROGRAM RIDES ON, INSIDE THE MEDIUM'S SEED DIRECTORY. The seed directory and
// the program's filename are the subject's facts, passed by the caller.
fn census_program_on_medium(nocloud_dir: NonEmptyStr, program_file: NonEmptyStr) -> NonEmptyStr {
  concat("/cdrom/", nocloud_dir as String, "/", program_file as String) as NonEmptyStr
}

// THE STAGE ROSTER IS THE PARAMETER. The census image is this function applied to the census roster;
// a roster that appends stages after the census ones yields a different image with a different
// digest and name, built by the same derivation. Nothing here may run before the census stages or
// between them and the envelope's END.
// THE SEED'S EARLY COMMANDS: the single helper that builds the user-data payload from the seed's
// location -- one fact in one place (DESIGN 3 minimization). Both the derivation (census_image_derivation) and the
// mt. collins receipt row below consume it, so the early command and the seed file cannot drift:
// the command the installer runs and the file the seed carry are built from the same
// (nocloud_dir, program_file) by this one author.
fn census_live_commands(nocloud_dir: NonEmptyStr, program_file: NonEmptyStr) -> UbuntuAutoinstallLiveCommands {
  UbuntuAutoinstallLiveCommands {
    autoinstall_version: 1,
    early_commands: [concat("sh ", census_program_on_medium(nocloud_dir: nocloud_dir, program_file: program_file) as String) as NonEmptyStr],
  }
}

// THE SEED'S USER-DATA: run the census program before any installer section, leave every section
// to a human. The derivation builds the payload from the seed's location via census_live_commands,
// so this row is the MEASURED RECEIPT for mt. collins unit 1 -- the payload the derivation builds
// for its seed directory and program file, and what the seeded user-data of the pinned image
// records. Built by the same helper the derivation uses, so the two cannot drift.
data mtcollins1_census_live_commands: UbuntuAutoinstallLiveCommands = census_live_commands(
  nocloud_dir: mtcollins1_census_nocloud_dir,
  program_file: mtcollins1_census_program_file,
)

// THE KERNEL CMDLINE, IN TWO ROWS. The PINNED row is the cmdline of the image the boot medium row pins
// (output 30ca88d4..., built under builder revision 1 as key 8d357a525f078cb4): the census seed and the
// serial console. The CURRENT row adds the module-identity instrument. The pinned row is kept because
// the fleet-SSH publish first rebuilds the pinned-input derivation on srv2 and requires its hermetic
// digest and the stock boot chain before it publishes anything
// (gunbc.machine_intake.mtcollins1_census_image_publish census_srv2_regression).
data mtcollins1_census_pinned_grub_cmdline: NonEmptyStr = concat(
  ubuntu_seeded_install_media_grub_kernel_cmdline(nocloud_dir: mtcollins1_census_nocloud_dir) as String,
  " ",
  mtcollins1_census_console_arg as String,
) as NonEmptyStr

data mtcollins1_census_grub_cmdline: NonEmptyStr = concat(
  mtcollins1_census_pinned_grub_cmdline as String,
  " ",
  mtcollins1_census_module_identity_args as String,
) as NonEmptyStr

// THE CENSUS IMAGE INPUT: the stock 24.04.3 arm64 live-server medium with a NoCloud seed that carries
// the census capture program. Every subject fact is a PARAMETER -- the image stem, the volume id, the
// rendered user-data body, the kernel cmdline, the seed directory, the program's filename, and the
// program's rendered body. The stock artifact, the pinned dates and the builder revision are the shared
// seeded-media policy (gunbc.provisioning.seeded_install_media_policy); the subject facts name the
// artifact. The mt. collins rows feed the mt. collins readings.
fn census_seeded_image_input(
  image_stem: NonEmptyStr,
  volume_id: NonEmptyStr,
  user_data_body: NonEmptyStr,
  grub_kernel_cmdline: NonEmptyStr,
  nocloud_dir: NonEmptyStr,
  program_file: NonEmptyStr,
  program_content: NonEmptyStr,
) -> UbuntuSeededInstallMediaBuildInput {
  UbuntuSeededInstallMediaBuildInput {
    stock_artifact: noble_numbat_2404_3_live_server_arm64,
    nocloud_dir_on_iso: nocloud_dir,
    user_data_body: user_data_body,
    seed_files: [
      NoCloudSeedFile {
        name: program_file,
        content: program_content,
      },
    ],
    seed_artifacts: [],
    grub_kernel_cmdline: grub_kernel_cmdline,
    volume_id: volume_id,
    pinned_dates: seeded_install_media_pinned_dates,
    image_stem: image_stem,
    builder_revision: seeded_install_media_builder_revision,
  }
}

// THE CENSUS IMAGE: a derived artifact with its own identity -- the bytes differ from stock, so it
// never takes the stock name and the stock file in the export is never touched.
//
// THE DERIVATION CARRIES THE RENDERER'S REFUSAL, because the census image IS its rendered
// user-data: the body is written into the medium's seed and is in the build key, so a document the
// YAML writer will not write leaves no image to build, publish, or resolve. Publication and
// resolution below carry it through the refusal arms gunbc.provisioning.seeded_install_media_publish already has.
type CensusImage
  = CensusImageDerived { input: UbuntuSeededInstallMediaBuildInput }
  | CensusImageRefused { reason: String }

// THE SUBJECT'S FACTS ARE THE PARAMETERS. The census stages run before any installer section and the
// envelope ends by the subject's halt command on the subject's console; the seed carries the program
// off the medium's seed directory; the volume id, the image stem, the kernel cmdline and the seed's
// user-data name the artifact. A DIFFERENT SUBJECT'S FACTS GIVE A DIFFERENT IMAGE AND A DIFFERENT NAME
// through this same derivation -- that is the discriminating control of the cut. The mt. collins rows
// below are the caller that feeds the mt. collins readings, and they stay this row's receipt.
// THE EARLY COMMAND AND THE SEED FILE CANNOT DISAGREE: the user-data's early command is BUILT from
// the seed's location inside this derivation (census_program_on_medium), so the command the installer
// runs and the file the seed carries are one fact, not two parameters a caller can cross -- a path
// mismatch is unwritable, not a validation.
fn census_image_derivation(
  stages: List<HostCaptureStage>,
  machine: NonEmptyStr,
  console_device: NonEmptyStr,
  halt_command: NonEmptyStr,
  image_stem: NonEmptyStr,
  volume_id: NonEmptyStr,
  grub_kernel_cmdline: NonEmptyStr,
  nocloud_dir: NonEmptyStr,
  program_file: NonEmptyStr,
) -> CensusImage {
  let program = census_capture_program(machine: machine, console_device: console_device, halt_command: halt_command, stages: stages)
  let live_commands = census_live_commands(nocloud_dir: nocloud_dir, program_file: program_file)
  match autoinstall_live_commands_user_data(payload: live_commands) {
    AutoinstallUserDataRefused { reason: r } => CensusImageRefused { reason: r }
    AutoinstallUserDataRendered { content: body } =>
      CensusImageDerived {
        input: census_seeded_image_input(
          image_stem: image_stem,
          volume_id: volume_id,
          user_data_body: body as NonEmptyStr,
          grub_kernel_cmdline: grub_kernel_cmdline,
          nocloud_dir: nocloud_dir,
          program_file: program_file,
          program_content: program,
        ),
      }
  }
}

data mtcollins1_census_image: CensusImage = census_image_derivation(
  stages: mtcollins1_census_stages,
  machine: mtcollins1_census_machine,
  console_device: mtcollins1_census_console_device,
  halt_command: mtcollins1_census_halt_command,
  image_stem: mtcollins1_census_image_stem,
  volume_id: mtcollins1_census_volume_id,
  grub_kernel_cmdline: mtcollins1_census_grub_cmdline,
  nocloud_dir: mtcollins1_census_nocloud_dir,
  program_file: mtcollins1_census_program_file,
)

// THE PRE-INSTRUMENT DERIVATION: the inputs of the image the boot medium row pins (30ca88d4..., built under
// builder revision 1). Under the attribute-pinning builder its key is bf916c060d072e72 and its hermetic
// output eb23f174... (gunbc.machine_intake.mtcollins1_census_image_publish).
data mtcollins1_census_pinned_image: CensusImage = census_image_derivation(
  stages: mtcollins1_census_stages,
  machine: mtcollins1_census_machine,
  console_device: mtcollins1_census_console_device,
  halt_command: mtcollins1_census_halt_command,
  image_stem: mtcollins1_census_image_stem,
  volume_id: mtcollins1_census_volume_id,
  grub_kernel_cmdline: mtcollins1_census_pinned_grub_cmdline,
  nocloud_dir: mtcollins1_census_nocloud_dir,
  program_file: mtcollins1_census_program_file,
)

// THE STOCK MEDIUM THE CENSUS IMAGE IS BUILT FROM, as it is served in its export. The effectful
// half -- the srv2-side regression, the build, the create-only publication and its receipt -- lives in
// gunbc.machine_intake.mtcollins1_census_image_publish.
fn census_image_stock_path() -> NonEmptyStr {
  boot_image_published_path(export_dir: stock_installer_boot_medium.export.dir, image_name: stock_installer_boot_medium.image_name)
}

// THE CENSUS MEDIUM AUTHORS ONE FACT, THE MEASURED OUTPUT DIGEST from the publish receipt. The image
// name derives from that digest through the subject's stem row, and the volume-label terminal is the
// subject's volume-id row, so a census medium naming a stock installer, or any artifact but the census
// image, has no spelling: the medium cannot disagree with the label the verdict binds to (review
// 5261662425). The published file's name is its digest, so the digest is also the sha256 the admitted
// boot subject and the attach carry. It is a gunbc.host.boot_medium BootMedium like any other: the
// boot subject takes it as a value and does not import this module.
//
// IT COMPUTES ONLY THE ARTIFACT IDENTITY (the stem, the volume id, the digest). The image name and
// the digest are the artifact; the volume-label terminal is the one terminal a seeded medium carries.
// The export is the one the census is published to and read back from (bmc_boot_image_export) -- a
// constant of this lane, not a subject fact. No delivery (served path) and no other terminal fact is
// a parameter of this function, so the later split of a medium into artifact, delivery, target and
// terminal demand does not have to unpick it.
fn census_boot_medium(image_stem: NonEmptyStr, volume_id: NonEmptyStr, output_digest: NonEmptyStr) -> BootMedium {
  BootMedium {
    image_name: ubuntu_seeded_install_media_image_name(image_stem: image_stem, output_digest: output_digest),
    digest: output_digest,
    export: bmc_boot_image_export,
    terminal: BootMediumVolumeLabel { label: volume_id },
  }
}

// WHETHER A MEDIUM IS THE CENSUS MEDIUM THESE READERS CAN READ: exactly when it is the census medium
// for its own digest AND names the one export the census is published to and read back from
// (gunbc.host.boot_medium bmc_boot_image_export), SSH target included. The census readbacks read only a
// qualified medium, from the export the qualification returns; a stock installer (or any other row) is
// refused as not the census, and a census medium naming another exporter -- another endpoint, or
// another principal at the same endpoint -- is refused as an unsupported exporter rather than read
// back from the supported one, whose bytes it never named. DECLARED FRONTIER: honoring an arbitrary
// exporter throughout the readers (and binding the controller share to it) is the generalization; until
// then the limitation is held here, at admission, and never by substituting the supported export.
//
// A MEDIUM IS QUALIFIED ONLY AGAINST ITS OWN SUBJECT'S ARTIFACT IDENTITY (the stem and the volume
// label it was built from), passed by the caller. A medium whose image name or volume label does not
// match the subject's stem and volume id is refused as not the census -- so a MISMATCHED BINDING (a
// medium row that names a stem or volume id different from the subject it is read for) refuses here,
// before any effect, which is the discriminating control of the cut.
type CensusMediumQualification
  = CensusMediumQualified { digest: NonEmptyStr, export: BootImageExport }
  | CensusMediumNotCensus
  | CensusMediumExporterUnsupported { supported: BootImageExport, named: BootImageExport }

fn census_medium_qualification(image_stem: NonEmptyStr, volume_id: NonEmptyStr, medium: BootMedium) -> CensusMediumQualification {
  let census = census_boot_medium(image_stem: image_stem, volume_id: volume_id, output_digest: medium.digest)
  let labelled = match medium.terminal {
    BootMediumVolumeLabel { label: l } => (l as String) == (volume_id as String)
    BootMediumNoTerminal { reason: _ } => false
    BootMediumRunnerHostUp { label: _ } => false
  }
  if !(labelled && (medium.image_name as String) == (census.image_name as String)) {
    CensusMediumNotCensus
  } else if boot_image_export_eq(a: medium.export, b: census.export) {
    CensusMediumQualified { digest: medium.digest, export: medium.export }
  } else {
    CensusMediumExporterUnsupported { supported: census.export, named: medium.export }
  }
}

fn boot_image_export_text(export: BootImageExport) -> String {
  concat(export.target.principal as String, "@", known_hosts_host_field(address: export.target.address) as String, ":", export.dir as String)
}

// THE CENSUS DERIVATION RECORD: the publish writes the output digest of the current build input beside
// the served image, keyed by the build key, in the one export the census is published to.
fn census_record_path(input: UbuntuSeededInstallMediaBuildInput) -> NonEmptyStr {
  ubuntu_seeded_install_media_record_path(dir: bmc_boot_image_export.dir, input: input)
}

// WHAT A BOOT OF THIS MEDIUM OWES BEFORE ITS SERVED BYTES ARE MEASURED (gunbc.host.boot_medium_served_readback).
// A medium whose terminal is the census volume label is a census medium: that terminal is printed by the
// census program and nothing else (gunbc.host.boot_medium BootMediumTerminal). Its row describes the
// current derivation only if the derivation record of the current build input repeats its digest, so it
// is read back record first. It is qualified against the image first, so a mismatched binding (a medium
// naming another stem or volume label) and a census medium naming an exporter the census is not
// published to refuse before either leg, never read back from the supported export; and a census build
// input with no derivation has no build key to find a record by. Any other medium owes the measurement
// alone.
fn census_served_check(medium: BootMedium, image: CensusImage) -> BootMediumServedCheck {
  match medium.terminal {
    BootMediumVolumeLabel { label: _ } =>
      match image {
        CensusImageRefused { reason: why } => BootMediumServedCheckRefused { cause: concat("the census build input has no derivation (", why, "), so there is no build key to find a record by; refusing") }
        CensusImageDerived { input: input } =>
          match census_medium_qualification(image_stem: input.image_stem, volume_id: input.volume_id, medium: medium) {
            CensusMediumQualified { digest: _, export: _ } => BootMediumServedRecordFirst { record_path: census_record_path(input: input) }
            CensusMediumNotCensus => BootMediumServedCheckRefused { cause: concat("the medium ", medium.image_name as String, " carries a census volume label but is not the census image of the current derivation, so there is no derivation record to read back") }
            CensusMediumExporterUnsupported { supported: sup, named: n } =>
              BootMediumServedCheckRefused { cause: concat("the census medium names the exporter ", boot_image_export_text(export: n), " but the census is published to and read back from ", boot_image_export_text(export: sup), "; refusing rather than reading back bytes the medium does not name") }
          }
      }
    BootMediumNoTerminal { reason: _ } => BootMediumServedMeasureOnly
    BootMediumRunnerHostUp { label: _ } => BootMediumServedMeasureOnly
  }
}

// CENSUS STAGE 0D: THE MEDIUM MT. COLLINS UNIT 1 BOOTS. The digest is the publish receipt of the gated
// create-only publication run 36651495873 (main, fleet SSH to srv2 as gunbc-fleet; receipt artifact
// sha256 ca40bf02982bb1dd71d9adf4663aa74e97b99b03109d9c8626dc9ff53f9ddbcf): gate (a) the srv2 rebuild
// of the pinned-input derivation equalled the hermetic receipt eb23f174..., gate (b) the rebuilt
// vmlinuz and initrd equalled stock; image_name
// gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-161b98b9bb389a80.iso, build_key c001ac127d718e72,
// published_path /srv/bmc/gunbc-mtcollins1-census-ubuntu-24.04.3-arm64-161b98b9bb389a80.iso. Repinned
// because #12594 bumped builder_revision, so the previous image (30ca88d4..., build_key
// 8d357a525f078cb4) no longer describes the current derivation and the boot refuses it (run
// 36660907341). This row is publication-time evidence only:
// the mtcollins1 boot run selects the runner medium, re-measured by
// gunbc.host.boot_medium_served_readback; a boot that selects this one is read back record first
// (census_served_check) before the boot subject is admitted. Switching it to stock_installer_boot_medium makes every
// census verdict refuse at the gate, before any controller write.
data mtcollins1_census_boot_medium: BootMedium = census_boot_medium(
  image_stem: mtcollins1_census_image_stem,
  volume_id: mtcollins1_census_volume_id,
  output_digest: "161b98b9bb389a803805b582203fe73fa9a3ec421e3783b6463528124c2bd513",
)
