module gunbc.machine_intake_mtcollins1_boot_phase_timing

import std.types { List, NonEmptyStr, String }
import std.measure { Millisecond, millisecond_count, measure_sub, MeasureDifference, MeasureSubtrahendExceedsMinuend }
import extdeps.linux.proc_uptime { ProcUptimeRead, UptimeObserved, UptimeRefused }
import gunbc.machine_intake_oob_boot_handoff { ObservedPowerTransition, PoweredOn, PowerCycled }
import gunbc.machine_intake_mtcollins1_smpro_observation {
  SmproProbeOutcome, SmproWordRead, SmproControllerRefused, SmproTransportFailed, SmproResponseMalformed, SmproNotSent, SmproRequestUnencodable,
}
import v2.std.algebra { any }

// THE INSTRUMENT FOR THE BOOT STEP'S OWN TIME (operator ruling 2026-09-27: mtcollins1_boot time
// toward 0, including avoidable delay inside the step). Each wait in the boot path is removed or
// kept by a before/after reading from THIS record, never from a transcribed figure (DESIGN §6: name
// the instrument). A real boot produces it: mtcollins1_boot_actuate reads the clock at each phase
// boundary under the unit hold and the diagnostic bundle's run section renders it, so the
// instrument's name is this module and its invocation is a dispatched boot.
//
// THE FAILURE CLASS THIS RECORD REFUSES (#12423 comment 5858637192): a plausible number mistaken for
// an established duration or a verified postcondition. Each way that can happen is a state here:
// - the clock is /proc/uptime, the kernel's boot-based clock, so a wall-clock step (NTP) cannot
//   move a reading; a later reading below an earlier one still refuses as a step, never as time;
// - an unreadable reading prints its cause, never 0 (std.observation observation_measured_note);
// - a phase that ran and REFUSED prints as refused with its cause, never as "verified";
// - a phase that never ran prints as not reached, with no number at all;
// - the phases that ran PARTITION the actuation: each begins at the reading that ended the one
//   before, so no interval is counted in two phases.
type MtCollins1BootPhase
  = PhaseSolAcquire
  | PhaseParam5Before
  | PhaseMediaAttach
  | PhaseHandoff
  | PhaseSmproPowerOn
  | PhaseTerminalWatch
  | PhaseParam5After
  | PhasePowerAfter
  | PhaseSolRelease

fn mtcollins1_boot_phase_word(phase: MtCollins1BootPhase) -> String {
  match phase {
    PhaseSolAcquire => "sol_acquire"
    PhaseParam5Before => "param5_before"
    PhaseMediaAttach => "media_attach"
    PhaseHandoff => "handoff"
    PhaseSmproPowerOn => "smpro_power_on"
    PhaseTerminalWatch => "terminal_watch"
    PhaseParam5After => "param5_after"
    PhasePowerAfter => "power_after"
    PhaseSolRelease => "sol_release"
  }
}

// WHAT A PHASE THAT RAN ESTABLISHED, decided by the phase's own verdict (its readback, its typed
// observation), never by its command returning.
type MtCollins1PhaseRunResult
  = PhaseVerified
  | PhaseRefused { cause: String }

// AN SMpro PASS IS VERIFIED ONLY WHEN AT LEAST ONE REGISTER RETURNED A WORD (SmproWordRead): that is
// the one outcome that observes the socket's state. A controller NAK, a transport failure, a
// malformed response, a probe not sent and an unencodable request each establish no register
// value, so a pass made only of them -- or of nothing -- is refused. Taking the reads is not the
// same as reading them. Each read's own outcome stays in the bundle's smpro section.
fn mtcollins1_smpro_pass_result(outcomes: List<SmproProbeOutcome>) -> MtCollins1PhaseRunResult {
  let answered = any(outcomes, o => match o {
    SmproWordRead { raw: _, word: _ } => true
    SmproControllerRefused { raw: _, completion: _ } => false
    SmproTransportFailed { raw: _, timed_out: _ } => false
    SmproResponseMalformed { raw: _, detail: _ } => false
    SmproNotSent { socket: _, register: _, reason: _ } => false
    SmproRequestUnencodable { socket: _, register: _, detail: _ } => false
  })
  if answered {
    PhaseVerified
  } else {
    PhaseRefused { cause: concat("no SMpro register returned a word (", to_string(count(outcomes)), " reads; each outcome is in the smpro section)") }
  }
}

type MtCollins1BootPhaseSpan
  = PhaseRan { phase: MtCollins1BootPhase, result: MtCollins1PhaseRunResult, begin: ProcUptimeRead, end: ProcUptimeRead }
  | PhaseNotRan { phase: MtCollins1BootPhase, reason: NonEmptyStr }

// COLD OR WARM IS WHAT THE HANDOFF OBSERVED, not a guess: the handoff reads chassis power, selects
// power-up for an OFF unit or a cycle for an ON one, and returns the transition its read-back saw.
// A handoff that did not issue has no start to classify.
type MtCollins1BootStart
  = BootStartCold
  | BootStartWarm
  | BootStartUnobserved { reason: NonEmptyStr }

fn mtcollins1_boot_start_of(transition: ObservedPowerTransition) -> MtCollins1BootStart {
  match transition {
    PoweredOn => BootStartCold
    PowerCycled => BootStartWarm
  }
}

type MtCollins1BootPhaseTiming {
  hold_acquired: ProcUptimeRead
  start: MtCollins1BootStart
  spans: List<MtCollins1BootPhaseSpan>
}

fn mtcollins1_boot_phase_timing_not_taken(reason: NonEmptyStr) -> MtCollins1BootPhaseTiming {
  MtCollins1BootPhaseTiming {
    hold_acquired: UptimeRefused { detail: reason as String },
    start: BootStartUnobserved { reason: reason },
    spans: [],
  }
}

// THE BOUNDARY READINGS AND THE PHASE VERDICTS OF ONE ACTUATION, as mtcollins1_boot_actuate takes
// them. The builder below is pure, so a refused route can be exercised with supplied readings; the
// actuation is its one production caller.
type MtCollins1BootPhaseReadings {
  hold_acquired: ProcUptimeRead
  sol_held: ProcUptimeRead
  param5_before_read: ProcUptimeRead
  attach_verified: ProcUptimeRead
  power_verified: ProcUptimeRead
  smpro_power_on_read: ProcUptimeRead
  terminal_observed: ProcUptimeRead
  param5_after_read: ProcUptimeRead
  power_after_read: ProcUptimeRead
  released: ProcUptimeRead
}

type MtCollins1BootPhaseResults {
  param5_before: MtCollins1PhaseRunResult
  media_attach: MtCollins1PhaseRunResult
  handoff: MtCollins1PhaseRunResult
  smpro_power_on: MtCollins1PhaseRunResult
  terminal_watch: MtCollins1PhaseRunResult
  param5_after: MtCollins1PhaseRunResult
  power_after: MtCollins1PhaseRunResult
  sol_release: MtCollins1PhaseRunResult
}

// REACHABILITY FOLLOWS THE ACTUATION'S ORDER: the handoff runs only after a verified attach, the
// power-on SMpro pass and the terminal watch only after a verified handoff. The after-reads, the
// final power and the SOL release run on every arm that held the SOL, so they are always PhaseRan.
fn mtcollins1_boot_phase_spans(r: MtCollins1BootPhaseReadings, v: MtCollins1BootPhaseResults) -> List<MtCollins1BootPhaseSpan> {
  concat(
    [
      PhaseRan { phase: PhaseSolAcquire, result: PhaseVerified, begin: r.hold_acquired, end: r.sol_held },
      PhaseRan { phase: PhaseParam5Before, result: v.param5_before, begin: r.sol_held, end: r.param5_before_read },
      PhaseRan { phase: PhaseMediaAttach, result: v.media_attach, begin: r.param5_before_read, end: r.attach_verified },
    ],
    concat(
      match v.media_attach {
        PhaseVerified => mtcollins1_boot_spans_after_attach(r: r, v: v)
        PhaseRefused { cause: _ } =>
          [
            PhaseNotRan { phase: PhaseHandoff, reason: "the media attach did not verify" },
            PhaseNotRan { phase: PhaseSmproPowerOn, reason: "power on was never verified" },
            PhaseNotRan { phase: PhaseTerminalWatch, reason: "power on was never verified" },
          ]
      },
      [
        PhaseRan { phase: PhaseParam5After, result: v.param5_after, begin: r.terminal_observed, end: r.param5_after_read },
        PhaseRan { phase: PhasePowerAfter, result: v.power_after, begin: r.param5_after_read, end: r.power_after_read },
        PhaseRan { phase: PhaseSolRelease, result: v.sol_release, begin: r.power_after_read, end: r.released },
      ],
    ),
  )
}

fn mtcollins1_boot_spans_after_attach(r: MtCollins1BootPhaseReadings, v: MtCollins1BootPhaseResults) -> List<MtCollins1BootPhaseSpan> {
  concat(
    [PhaseRan { phase: PhaseHandoff, result: v.handoff, begin: r.attach_verified, end: r.power_verified }],
    match v.handoff {
      PhaseVerified =>
        [
          PhaseRan { phase: PhaseSmproPowerOn, result: v.smpro_power_on, begin: r.power_verified, end: r.smpro_power_on_read },
          PhaseRan { phase: PhaseTerminalWatch, result: v.terminal_watch, begin: r.smpro_power_on_read, end: r.terminal_observed },
        ]
      PhaseRefused { cause: _ } =>
        [
          PhaseNotRan { phase: PhaseSmproPowerOn, reason: "power on was never verified" },
          PhaseNotRan { phase: PhaseTerminalWatch, reason: "power on was never verified" },
        ]
    },
  )
}

// A SOL ACQUIRE THAT REFUSED is the one arm that holds nothing: the acquire ran and refused, and no
// later phase ran, because the actuation writes nothing without the SOL lease.
fn mtcollins1_boot_phase_timing_sol_refused(hold_acquired: ProcUptimeRead, refused_at: ProcUptimeRead, cause: String) -> MtCollins1BootPhaseTiming {
  let not_ran = "the SOL lease was not acquired, so nothing was written" as NonEmptyStr
  MtCollins1BootPhaseTiming {
    hold_acquired: hold_acquired,
    start: BootStartUnobserved { reason: not_ran },
    spans: concat(
      [PhaseRan { phase: PhaseSolAcquire, result: PhaseRefused { cause: cause }, begin: hold_acquired, end: refused_at }],
      map([PhaseParam5Before, PhaseMediaAttach, PhaseHandoff, PhaseSmproPowerOn, PhaseTerminalWatch, PhaseParam5After, PhasePowerAfter, PhaseSolRelease],
        p => PhaseNotRan { phase: p, reason: not_ran }),
    ),
  }
}

// A DURATION BETWEEN TWO READINGS IS ONE OF THREE THINGS, never a bare number. The subtraction is
// std.measure measure_sub, whose refusal arm is the clock-went-back case: the end reading below
// the begin one is carried as both readings, never as a difference.
type MtCollins1PhaseDuration
  = PhaseElapsed { elapsed: Millisecond }
  | PhaseClockUnread { detail: String }
  | PhaseClockSteppedBack { begin: Millisecond, end: Millisecond }

fn mtcollins1_boot_phase_duration(from: ProcUptimeRead, to: ProcUptimeRead) -> MtCollins1PhaseDuration {
  match from {
    UptimeRefused { detail: d } => PhaseClockUnread { detail: d }
    UptimeObserved { uptime: a } =>
      match to {
        UptimeRefused { detail: d } => PhaseClockUnread { detail: d }
        UptimeObserved { uptime: b } =>
          match measure_sub(a: b, b: a) {
            MeasureDifference { value: e } => PhaseElapsed { elapsed: e }
            MeasureSubtrahendExceedsMinuend => PhaseClockSteppedBack { begin: a, end: b }
          }
      }
  }
}

fn mtcollins1_boot_phase_duration_text(d: MtCollins1PhaseDuration) -> String {
  match d {
    PhaseElapsed { elapsed: e } => concat(to_string(millisecond_count(m: e)), "ms")
    PhaseClockUnread { detail: x } => concat("unread (", x, ")")
    PhaseClockSteppedBack { begin: a, end: b } => concat("REFUSED: clock went back from ", to_string(millisecond_count(m: a)), " to ", to_string(millisecond_count(m: b)), " ms; not a duration")
  }
}

fn mtcollins1_boot_between(from: ProcUptimeRead, to: ProcUptimeRead) -> String {
  mtcollins1_boot_phase_duration_text(d: mtcollins1_boot_phase_duration(from: from, to: to))
}

fn mtcollins1_boot_phase_span_text(hold: ProcUptimeRead, span: MtCollins1BootPhaseSpan) -> String {
  match span {
    PhaseNotRan { phase: p, reason: why } => concat("phase ", mtcollins1_boot_phase_word(phase: p), ": not reached (", why as String, ")")
    PhaseRan { phase: p, result: res, begin: b, end: e } =>
      concat("phase ", mtcollins1_boot_phase_word(phase: p), ": first_action=+", mtcollins1_boot_between(from: hold, to: b),
        match res {
          PhaseVerified => concat(" verified_after=", mtcollins1_boot_between(from: b, to: e))
          PhaseRefused { cause: c } => concat(" REFUSED_after=", mtcollins1_boot_between(from: b, to: e), " (", c, ")")
        })
  }
}

fn mtcollins1_boot_start_word(start: MtCollins1BootStart) -> String {
  match start {
    BootStartCold => "cold"
    BootStartWarm => "warm"
    BootStartUnobserved { reason: r } => concat("unobserved (", r as String, ")")
  }
}

fn mtcollins1_boot_phase_timing_text(t: MtCollins1BootPhaseTiming) -> String {
  join(concat(
    [concat("boot_start=", mtcollins1_boot_start_word(start: t.start)), "clock=/proc/uptime (boot-based; not stepped by NTP)"],
    if count(t.spans) == 0 { ["phases: none reached"] } else { map(t.spans, s => mtcollins1_boot_phase_span_text(hold: t.hold_acquired, span: s)) },
  ), "\n")
}
