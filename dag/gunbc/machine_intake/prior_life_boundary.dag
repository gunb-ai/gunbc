  ObservationAttempt,
  ObservationEstablished,
  ObservationRefused,
  GoalAssessment,
  GoalSatisfied,
  GoalDiverged,
  GoalIndeterminate,
  GoalAssessmentRefused,
  GoalInspected,
  GoalObservationRefused,
}
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }
import extdeps.uri { uri_wire }
import extdeps.bmc.redfish_telemetry {
  RedfishLogEntry,
  RedfishLogService,
  RedfishTelemetryPoint,
  RedfishHealth,
  RedfishHealthOk,
  RedfishHealthWarning,
  RedfishHealthCritical,
  RedfishHealthOther,
  RedfishHealthUnreported,
  RedfishResourceState,
  RedfishStateEnabled,
  RedfishStateDisabled,
  RedfishStateAbsent,
  RedfishStateOther,
  RedfishStateUnreported,
  RedfishReading,
  RedfishReadingValue,
  RedfishReadingNull,
  RedfishReadingMissing,
  RedfishPointKind,
  RedfishTemperatureCelsius,
  RedfishRotationalRpm,
  RedfishOtherReading,
}
