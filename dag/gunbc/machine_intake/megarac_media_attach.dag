import extdeps.clock { ClockUnixMillisObserved, ClockUnixMillisRefused, clock_unix_millis_read }
import extdeps.provisioning.ubuntu_seeded_install_media { ubuntu_seeded_install_media_name_digest_prefix }
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }
import gunbc.machine_intake_mount_establishment {
  MediaImageAbsentFromListing,
  MediaImageListed,
  MountEstablished,
  MountEvaluationBoundary,
  MountObservationContradictory,
  MountPending,
  MountRequested,
  MountTimedOut,
  RemoteMediaListing,
  RemoteMediaListingObservation,
  RemoteMediaMountStanding,
  RemoteMediaMountWindow,
