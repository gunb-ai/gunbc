module gunbc.machine_intake_megarac_media_attach

import std.types { Bool, Int, NonEmptyStr, String }
import std.nat { Nat, nat_range_inclusive }
import std.measure { Second, second }
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }
import extdeps.bmc.megarac
import extdeps.languages.json.parse {
  JsonArray,
  JsonDocumentParsed,
  JsonDocumentUnreadable,
  JsonMemberFound,
  JsonNumber,
  JsonString,
  JsonValue,
  json_object_unique_member,
  parse_json_document,
  some_json_value,
}

// ATTACHING A REMOTE IMAGE, AS A MODELED OPERATION. The effect is adjudicated only by the
// configurations read-back. HTTP status is not an effect oracle on this firmware: PUT and POST
// requests have returned HTTP 500 both when their writes applied and when they did not.
//
// THE STATUS ENUM IS THE CONTROLLER'S OWN, recovered from source.min.js served by the live BMC and
// then exercised on mtcollins1. 0 is idle; 100 is connecting; 1 is the healthy steady state
// (frontend: Started / Connection Accepted); 2,3,4,5 are Connection Denied, Login Failed,
// MAX Session Reached and Permission Denied. The old predicate `status != 0` therefore accepted
// every known refusal as success and also treated connecting as ready. Only status 1 with a real
// session index is ready.

type SessionRelease
  = SessionReleased
  | SessionReleaseRefused { detail: String }
  | SessionReleaseNotAttempted

type MegaRacAttachResult {
  outcome: MegaRacAttachOutcome
  session_release: SessionRelease
}

type MegaRacAttachOutcome
  = MegaRacAttached { image_name: NonEmptyStr, image_index: String }
  | MegaRacAlreadyAttached { image_name: NonEmptyStr }
  | MegaRacConfigurationsUnreadable { detail: String }
  | MegaRacConfigurationAmbiguous { image_name: NonEmptyStr, matches: Int }
  | MegaRacWrongMediaType { image_name: NonEmptyStr, observed: String }
  | MegaRacSessionIndexUnavailable { image_name: NonEmptyStr, configurations: String }
  | MegaRacConnectionDenied { image_name: NonEmptyStr, configurations: String }
  | MegaRacLoginFailed { image_name: NonEmptyStr, configurations: String }
  | MegaRacMaxSessionReached { image_name: NonEmptyStr, configurations: String }
  | MegaRacPermissionDenied { image_name: NonEmptyStr, configurations: String }
  | MegaRacStopped { image_name: NonEmptyStr, status: String, configurations: String }
  | MegaRacAttachTimedOut { image_name: NonEmptyStr, samples: Nat, configurations: String }
  | MegaRacSessionRefused { detail: String }
  | MegaRacSessionTokenUnreadable { detail: String }
  | MegaRacImagesUnreadable { detail: String }
  | MegaRacImageListingEmpty
  | MegaRacImageListingUnparseable { detail: String }
  | MegaRacImageNotEnumerated { image_name: NonEmptyStr }

fn json_string_member(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonString { value: s } => Present { value: s }
        _ => none
      }
    _ => none
  }
}

fn json_number_member(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonNumber { lexeme: n } => Present { value: n }
        _ => none
      }
    _ => none
  }
}

fn image_index_named(elements: List<JsonValue>, image_name: String) -> String? {
  fold(elements, init: none, f: (acc, element) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        match json_string_member(doc: element, key: "image_name") {
          Absent => none
          Present { value: found } =>
            if found == image_name {
              json_number_member(doc: element, key: "image_index")
            } else {
              none
            }
        }
    }
  )
}

fn images_array_elements(doc: JsonValue) -> List<JsonValue>? {
  match doc {
    JsonArray { elements: es } => Present { value: es }
    _ => none
  }
}

// THE REQUIRED FIELD IS ENCODED HERE AND HAS NO CALLER-SUPPLIED ABSENT FORM. Omitting
// image_redirection:1 was measured to produce opaque 13410/13460 refusals.
fn start_media_body(image_name: NonEmptyStr, image_index: String) -> NonEmptyStr {
  join([
    "{\"image_name\":\"", image_name as String,
    "\",\"image_type\":1,\"image_index\":", image_index,
    ",\"image_redirection\":1}"
  ], "") as NonEmptyStr
}

func megarac_attach_remote_image(
  bmc_host: NonEmptyStr,
  username: NonEmptyStr,
  password: NonEmptyStr,
  cookie_jar: NonEmptyStr,
  image_name: NonEmptyStr,
) -> MegaRacAttachResult
  uses net: std.resources.Network
{
  session = megarac.Media.OpenSession(
    bmc_host: bmc_host,
    username: username,
    password: password,
    cookie_jar: cookie_jar,
  )
  if session.success == false {
    return MegaRacAttachResult {
      outcome: MegaRacSessionRefused { detail: session.body },
      session_release: SessionReleaseNotAttempted,
    }
  }

  let session_doc = match parse_json_document(s: session.body) {
    JsonDocumentParsed { value: v } => some_json_value(v)
    JsonDocumentUnreadable { gap: _ } => none
  }
  let csrf = match session_doc {
    Absent => none
    Present { value: doc } => json_string_member(doc: doc, key: "CSRFToken")
  }

  return match csrf {
    Absent =>
      megarac_release_unreadable_session(
        bmc_host: bmc_host,
        cookie_jar: cookie_jar,
        session_body: session.body,
      )
    Present { value: token } =>
      megarac_attach_then_release(
        bmc_host: bmc_host,
        cookie_jar: cookie_jar,
        csrf_token: token as NonEmptyStr,
        image_name: image_name,
      )
  }
}

func megarac_release_unreadable_session(
  bmc_host: NonEmptyStr,
  cookie_jar: NonEmptyStr,
  session_body: String,
) -> MegaRacAttachResult
  uses net: std.resources.Network
{
  closed = megarac.Media.CloseSession(
    bmc_host: bmc_host,
    cookie_jar: cookie_jar,
    csrf_token: "unreadable" as NonEmptyStr,
  )
  return MegaRacAttachResult {
    outcome: MegaRacSessionTokenUnreadable { detail: session_body },
    session_release: if closed.success { SessionReleased } else { SessionReleaseRefused { detail: closed.body } },
  }
}

func megarac_attach_then_release(
  bmc_host: NonEmptyStr,
  cookie_jar: NonEmptyStr,
  csrf_token: NonEmptyStr,
  image_name: NonEmptyStr,
) -> MegaRacAttachResult
  uses net: std.resources.Network
{
  let outcome = megarac_attach_with_token(
    bmc_host: bmc_host,
    cookie_jar: cookie_jar,
    csrf_token: csrf_token,
    image_name: image_name,
  )

  closed = megarac.Media.CloseSession(
    bmc_host: bmc_host,
    cookie_jar: cookie_jar,
    csrf_token: csrf_token,
  )

  return MegaRacAttachResult {
    outcome: outcome,
    session_release: if closed.success { SessionReleased } else { SessionReleaseRefused { detail: closed.body } },
  }
}

fn configuration_row_names(row: JsonValue, image_name: NonEmptyStr) -> Bool {
  match json_string_member(doc: row, key: "image_name") {
    Absent => false
    Present { value: n } => n == (image_name as String)
  }
}

// ONE NAMED ROW'S EXACT STATE. Session index 255 is the controller's N/A sentinel and cannot be
// promoted into a serving session even beside status 1.
type PresentedMediaStanding
  = PresentedMediaUnreadable { detail: String }
  | PresentedMediaNotAttached
  | PresentedMediaIdle
  | PresentedMediaConnecting { session_index: String }
  | PresentedMediaReady { session_index: String }
  | PresentedMediaConnectionDenied
  | PresentedMediaLoginFailed
  | PresentedMediaMaxSessionReached
  | PresentedMediaPermissionDenied
  | PresentedMediaStopped { status: String }
  | PresentedMediaSessionIndexUnavailable
  | PresentedMediaWrongType { observed: String }
  | PresentedMediaAmbiguous { matches: Int }

fn configuration_row_standing(row: JsonValue) -> PresentedMediaStanding {
  let media_type = match json_number_member(doc: row, key: "media_type") {
    Absent => "unreadable"
    Present { value: mt } => mt
  }
  if media_type != "1" {
    return PresentedMediaWrongType { observed: media_type }
  }

  let session_index = match json_number_member(doc: row, key: "session_index") {
    Absent => "unreadable"
    Present { value: idx } => idx
  }
  return match json_number_member(doc: row, key: "redirection_status") {
    Absent => PresentedMediaUnreadable { detail: "named configuration has no numeric redirection_status" }
    Present { value: status } =>
      if status == "0" {
        PresentedMediaIdle
      } else if status == "100" {
        PresentedMediaConnecting { session_index: session_index }
      } else if status == "1" {
        if session_index == "255" || session_index == "unreadable" {
          PresentedMediaSessionIndexUnavailable
        } else {
          PresentedMediaReady { session_index: session_index }
        }
      } else if status == "2" {
        PresentedMediaConnectionDenied
      } else if status == "3" {
        PresentedMediaLoginFailed
      } else if status == "4" {
        PresentedMediaMaxSessionReached
      } else if status == "5" {
        PresentedMediaPermissionDenied
      } else {
        PresentedMediaStopped { status: status }
      }
  }
}

fn presented_media_standing(body: String, image_name: NonEmptyStr) -> PresentedMediaStanding {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: _ } => PresentedMediaUnreadable { detail: body }
    JsonDocumentParsed { value: v } =>
      match images_array_elements(doc: v) {
        Absent => PresentedMediaUnreadable { detail: body }
        Present { value: rows } => {
          let named = rows |> filter(r => configuration_row_names(row: r, image_name: image_name))
          let matches = count(named)
          if matches == 0 {
            PresentedMediaNotAttached
          } else if matches > 1 {
            PresentedMediaAmbiguous { matches: matches }
          } else {
            match named.first() {
              Absent => PresentedMediaNotAttached
              Present { value: row } => configuration_row_standing(row: row)
            }
          }
        }
      }
  }
}

fn presented_terminal_outcome(
  standing: PresentedMediaStanding,
  image_name: NonEmptyStr,
  configurations: String,
) -> MegaRacAttachOutcome? {
  match standing {
    PresentedMediaConnectionDenied => Present { value: MegaRacConnectionDenied { image_name: image_name, configurations: configurations } }
    PresentedMediaLoginFailed => Present { value: MegaRacLoginFailed { image_name: image_name, configurations: configurations } }
    PresentedMediaMaxSessionReached => Present { value: MegaRacMaxSessionReached { image_name: image_name, configurations: configurations } }
    PresentedMediaPermissionDenied => Present { value: MegaRacPermissionDenied { image_name: image_name, configurations: configurations } }
    PresentedMediaStopped { status: s } => Present { value: MegaRacStopped { image_name: image_name, status: s, configurations: configurations } }
    PresentedMediaSessionIndexUnavailable => Present { value: MegaRacSessionIndexUnavailable { image_name: image_name, configurations: configurations } }
    PresentedMediaWrongType { observed: mt } => Present { value: MegaRacWrongMediaType { image_name: image_name, observed: mt } }
    PresentedMediaAmbiguous { matches: n } => Present { value: MegaRacConfigurationAmbiguous { image_name: image_name, matches: n } }
    PresentedMediaUnreadable { detail: d } => Present { value: MegaRacConfigurationsUnreadable { detail: d } }
    PresentedMediaNotAttached => none
    PresentedMediaIdle => none
    PresentedMediaConnecting { session_index: _ } => none
    PresentedMediaReady { session_index: _ } => none
  }
}

// 100->1 was measured at twelve seconds. Thirty one-second samples bound the asynchronous window
// without turning "keep polling" into an unbounded success search.
data megarac_media_ready_sample_cadence: Second = second(count: 1)
data megarac_media_ready_max_samples: Nat = 30

type MediaReadyPollFold {
  outcome: MegaRacAttachOutcome?
  samples: Nat
  last_configurations: String
}

func media_ready_poll_step(
  acc: MediaReadyPollFold,
  bmc_host: NonEmptyStr,
  cookie_jar: NonEmptyStr,
  csrf_token: NonEmptyStr,
  image_name: NonEmptyStr,
  started_image_index: String?,
) -> MediaReadyPollFold
  uses net: std.resources.Network
{
  match acc.outcome {
    Present { value: _ } => return acc
    Absent => none
  }

  configurations = megarac.Media.GetRemoteConfigurations(
    bmc_host: bmc_host,
    cookie_jar: cookie_jar,
    csrf_token: csrf_token,
  )
  if configurations.success == false {
    return MediaReadyPollFold {
      outcome: Present { value: MegaRacConfigurationsUnreadable { detail: configurations.body } },
      samples: acc.samples + 1,
      last_configurations: configurations.body,
    }
  }

  let standing = presented_media_standing(body: configurations.body, image_name: image_name)
  return match standing {
    PresentedMediaReady { session_index: _ } =>
      MediaReadyPollFold {
        outcome: Present {
          value: match started_image_index {
            Absent => MegaRacAlreadyAttached { image_name: image_name }
            Present { value: idx } => MegaRacAttached { image_name: image_name, image_index: idx }
          }
        },
        samples: acc.samples + 1,
        last_configurations: configurations.body,
      }
    _ =>
      match presented_terminal_outcome(standing: standing, image_name: image_name, configurations: configurations.body) {
        Present { value: terminal } =>
          MediaReadyPollFold {
            outcome: Present { value: terminal },
            samples: acc.samples + 1,
            last_configurations: configurations.body,
          }
        Absent => {
          let _delay = sleep_delay_seconds_second_carrier_projection(duration: megarac_media_ready_sample_cadence)
          MediaReadyPollFold {
            outcome: none,
            samples: acc.samples + 1,
            last_configurations: configurations.body,
          }
        }
      }
  }
}

func await_media_ready(
  bmc_host: NonEmptyStr,
  cookie_jar: NonEmptyStr,
  csrf_token: NonEmptyStr,
  image_name: NonEmptyStr,
  started_image_index: String?,
) -> MegaRacAttachOutcome
  uses net: std.resources.Network
{
  let folded = fold(
    nat_range_inclusive(lo: 1, hi: megarac_media_ready_max_samples),
    init: MediaReadyPollFold { outcome: none, samples: 0, last_configurations: "no read-back yet" },
    f: (acc, _sample) => media_ready_poll_step(
      acc: acc,
      bmc_host: bmc_host,
      cookie_jar: cookie_jar,
      csrf_token: csrf_token,
      image_name: image_name,
      started_image_index: started_image_index,
    ),
  )
  return match folded.outcome {
    Present { value: outcome } => outcome
    Absent => MegaRacAttachTimedOut {
      image_name: image_name,
      samples: folded.samples,
      configurations: folded.last_configurations,
    }
  }
}

func megarac_attach_with_token(
  bmc_host: NonEmptyStr,
  cookie_jar: NonEmptyStr,
  csrf_token: NonEmptyStr,
  image_name: NonEmptyStr,
) -> MegaRacAttachOutcome
  uses net: std.resources.Network
{
  presented = megarac.Media.GetRemoteConfigurations(
    bmc_host: bmc_host,
    cookie_jar: cookie_jar,
    csrf_token: csrf_token,
  )
  if presented.success == false {
    return MegaRacConfigurationsUnreadable { detail: presented.body }
  }

  let initial = presented_media_standing(body: presented.body, image_name: image_name)
  match initial {
    PresentedMediaReady { session_index: _ } =>
      return MegaRacAlreadyAttached { image_name: image_name }
    PresentedMediaConnecting { session_index: _ } =>
      return await_media_ready(
        bmc_host: bmc_host,
        cookie_jar: cookie_jar,
        csrf_token: csrf_token,
        image_name: image_name,
        started_image_index: none,
      )
    _ =>
      match presented_terminal_outcome(standing: initial, image_name: image_name, configurations: presented.body) {
        Present { value: terminal } => return terminal
        Absent => none
      }
  }

  images = megarac.Media.GetRemoteImages(
    bmc_host: bmc_host,
    cookie_jar: cookie_jar,
    csrf_token: csrf_token,
  )
  if images.success == false {
    return MegaRacImagesUnreadable { detail: images.body }
  }

  let elements = match parse_json_document(s: images.body) {
    JsonDocumentUnreadable { gap: _ } =>
      return MegaRacImageListingUnparseable { detail: images.body }
    JsonDocumentParsed { value: v } =>
      match images_array_elements(doc: v) {
        Absent => return MegaRacImageListingUnparseable { detail: images.body }
        Present { value: es } => es
      }
  }
  if count(elements) == 0 {
    return MegaRacImageListingEmpty
  }

  return match image_index_named(elements: elements, image_name: image_name as String) {
    Absent => MegaRacImageNotEnumerated { image_name: image_name }
    Present { value: idx } =>
      megarac_start_and_confirm(
        bmc_host: bmc_host,
        cookie_jar: cookie_jar,
        csrf_token: csrf_token,
        image_name: image_name,
        image_index: idx,
      )
  }
}

// START-MEDIA'S EXIT STATUS IS RECORDED BY THE TRANSPORT BUT DOES NOT SELECT AN OUTCOME HERE.
// Whether the HTTP response was 2xx or 500, the bounded configurations read-back above is the sole
// effect authority.
func megarac_start_and_confirm(
  bmc_host: NonEmptyStr,
  cookie_jar: NonEmptyStr,
  csrf_token: NonEmptyStr,
  image_name: NonEmptyStr,
  image_index: String,
) -> MegaRacAttachOutcome
  uses net: std.resources.Network
{
  let _start = megarac.Media.StartMedia(
    bmc_host: bmc_host,
    cookie_jar: cookie_jar,
    csrf_token: csrf_token,
    json_body: start_media_body(image_name: image_name, image_index: image_index),
  )
  return await_media_ready(
    bmc_host: bmc_host,
    cookie_jar: cookie_jar,
    csrf_token: csrf_token,
    image_name: image_name,
    started_image_index: Present { value: image_index },
  )
}
