module gunbc.machine_intake_power_supply

import std.types { Bool, NonEmptyStr, String }
import std.measure { RevolutionsPerMinute, Watt }

// EXTRACTED FROM gunbc.machine_intake_mtcollins1_platform_observation WHEN A SECOND DUAL-PSU
// PLATFORM ARRIVED. Presence and AC input are independent: a supply can be installed with no
// cord. This fold answers whether two DISTINCT sensor rows both report AC, not feed redundancy.
// Independent A/B feeds are a different fact; two cords on one breaker are not this predicate.

type PowerSupplyStanding {
  sensor_name: NonEmptyStr
  present: Bool
  ac_input_present: Bool
  output: Watt
  fan_speed: RevolutionsPerMinute
}

fn both_supplies_have_ac(a: PowerSupplyStanding, b: PowerSupplyStanding) -> Bool {
  (a.sensor_name as String) != (b.sensor_name as String)
    && a.present
    && a.ac_input_present
    && b.present
    && b.ac_input_present
}
