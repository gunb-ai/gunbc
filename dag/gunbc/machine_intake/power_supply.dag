module gunbc.machine_intake_power_supply

import std.types { Bool, NonEmptyStr }
import std.measure { RevolutionsPerMinute, Watt }

// EXTRACTED FROM gunbc.machine_intake_mtcollins1_platform_observation WHEN A SECOND DUAL-PSU
// PLATFORM ARRIVED. Presence and AC input are independent: a supply can be installed with no
// cord. Redundancy is a property of powered supplies, never of installed count. Output and fan
// speed are the corroborating sensors, not a second health flag.

type PowerSupplyStanding {
  sensor_name: NonEmptyStr
  present: Bool
  ac_input_present: Bool
  output: Watt
  fan_speed: RevolutionsPerMinute
}

fn power_supplies_redundant(a: PowerSupplyStanding, b: PowerSupplyStanding) -> Bool {
  a.present && a.ac_input_present && b.present && b.ac_input_present
}
