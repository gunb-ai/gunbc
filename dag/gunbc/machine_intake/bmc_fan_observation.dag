  SdrTemperaturePublication,
  TemperaturePublished,
  TemperatureSensorsSilent,
  TemperatureUndecodable,
  sdr_decode_lines,
  sdr_decoded_lines,
  sdr_fan_reading,
  sdr_temperature_publication,
  sdr_unstructured_count,
}
