module gunbc.machine_intake_pre_os_replay

import gunbc.machine_intake_pre_os_refusal { PreOsSourceChanged, PreOsRefusal, PreOsOwnershipRefusal, PreOsSubjectRefusal, PreOsCommitRefusal, PreOsContinuityRefusal, PreOsSourceRefusal, PreOsPositionRefusal, pre_os_text_refusal, pre_os_refusal_at }
import std.types { Bool, List, Map, NonEmptyStr, String }
import v2.std.collection { empty_map, map_insert, map_lookup }
import std.goal_assessment { ObservationAttempt, ObservationEstablished, ObservationRefused }
import std.content_hash { ContentHash }
import std.decl_ref { declaration_ref_eq }
import gunbc.fleet_observation_observation_envelope {
  SourceMachineBinding, SourceGenerationStanding, NativeRecordCursor, ProducerTimestamp, ReceiveObservation,
  SubjectAgreement, subject_agreement, EvidenceNamesOneSubject, CollectorSessionDisagrees, EnrolledMachineDisagrees, OwnershipGenerationDisagrees, BindingMachineDisagrees, ChunkStreamDisagrees, ObservationEnvelope, SourceGenerationObserved, SourceGenerationUnavailable, NativeCursor, NoNativeCursor,
}
import gunbc.fleet_observation_capture_chunk {
  ChunkOccurrence, SourceStreamRange, LocalCommitStanding, DownstreamAcceptanceStanding, StreamContinuity,
  range_end, ContinuityCoverage, ContinuityCoversRange, continuity_covers, commit_attests_chunk, CommitAttestsThisChunk, CommitAttestsOtherPayload, CommitBindingIncomparable, CommitNoReceipt, ContinuityNotEstablished, ContinuityShortOfRange, ContinuityPositionsIncomparable,
}
import gunbc.machine_intake_sel_stimulus_listener {
  SelWatermark, SelDelta, sel_read, sel_after, sel_record_id, sel_field, sel_rendered_record,
}
import gunbc.machine_intake_pre_os_bringup_verdict { SelWindowEvent }
import gunbc.fleet_observation_collector_ownership { EndpointOwnership, recording_owner, RecordingOwner, NotTheRecordingOwner }

// A cursor binds the rendered prefix to the actual source generation. It never
// binds a SEL event to a console attempt, an actuation, or a kernel boot.
type PreOsSelCursor { envelope: ObservationEnvelope, watermark: SelWatermark }
type PreOsSelIngestion {
  envelope: ObservationEnvelope
  payload: String
  cursor: ObservationAttempt<PreOsSelCursor, PreOsRefusal>
  new_records: List<SelWindowEvent>
  continuity: ObservationAttempt<SelDelta, PreOsRefusal>
}

// Retain the carrier's disagreement, including both identities. Receiver identity
// is checked through the same subject fold as ownership, with its location named.
fn pre_os_subject_envelope(envelope: ObservationEnvelope, agreement: SubjectAgreement, location: NonEmptyStr) -> ObservationAttempt<ObservationEnvelope, PreOsRefusal> {
  match agreement {
    EvidenceNamesOneSubject => ObservationEstablished { observed: envelope }
    CollectorSessionDisagrees { owner: _, chunk: _ } => ObservationRefused { cause: PreOsRefusal { location: [location], detail: PreOsSubjectRefusal { disagreement: agreement } } }
    EnrolledMachineDisagrees { owner: _, chunk: _ } => ObservationRefused { cause: PreOsRefusal { location: [location], detail: PreOsSubjectRefusal { disagreement: agreement } } }
    OwnershipGenerationDisagrees { owner: _, chunk: _ } => ObservationRefused { cause: PreOsRefusal { location: [location], detail: PreOsSubjectRefusal { disagreement: agreement } } }
    BindingMachineDisagrees { binding: _, owner: _ } => ObservationRefused { cause: PreOsRefusal { location: [location], detail: PreOsSubjectRefusal { disagreement: agreement } } }
    ChunkStreamDisagrees { binding_machine: _, binding_source: _, chunk_machine: _, chunk_source: _ } => ObservationRefused { cause: PreOsRefusal { location: [location], detail: PreOsSubjectRefusal { disagreement: agreement } } }
  }
}

fn pre_os_bound_envelope(envelope: ObservationEnvelope) -> ObservationAttempt<ObservationEnvelope, PreOsRefusal> {
  match recording_owner(ownership: envelope.ownership) {
    NotTheRecordingOwner => ObservationRefused { cause: PreOsRefusal { location: ["owner"], detail: PreOsOwnershipRefusal { ownership: envelope.ownership } } }
    RecordingOwner { session, generation } => match pre_os_subject_envelope(envelope: envelope, location: "owner",
      agreement: subject_agreement(owner_session: session, owner_generation: generation, chunk: envelope.chunk, binding: envelope.binding)) {
      ObservationRefused { cause } => ObservationRefused { cause: cause }
      ObservationEstablished { observed: bound } => pre_os_subject_envelope(envelope: bound, location: "receiver",
        agreement: subject_agreement(owner_session: bound.received.observed_by, owner_generation: generation, chunk: bound.chunk, binding: bound.binding))
    }
  }
}

fn pre_os_same_source(a: ObservationEnvelope, b: ObservationEnvelope) -> Bool {
  a.binding.enrolled_machine == b.binding.enrolled_machine
    && a.binding.source_identity == b.binding.source_identity
    && a.binding.source_implementation == b.binding.source_implementation
    && a.binding.source_version == b.binding.source_version
    && declaration_ref_eq(a: a.binding.authenticated_by, b: b.binding.authenticated_by)
}

fn pre_os_same_source_generation(a: ObservationEnvelope, b: ObservationEnvelope) -> Bool {
  pre_os_same_source(a: a, b: b) && match a.source_generation {
    SourceGenerationUnavailable { reason: _ } => false
    SourceGenerationObserved { generation: ga } => match b.source_generation {
      SourceGenerationObserved { generation: gb } => ga == gb
      SourceGenerationUnavailable { reason: _ } => false
    }
  }
}

// This is a range question, not merely a match on the continuity variant.
fn pre_os_chunk_continuity(envelope: ObservationEnvelope) -> ContinuityCoverage {
  continuity_covers(continuity: envelope.continuity, through: range_end(range: envelope.chunk.range))
}

// Persistence evidence is MITIGATABLE at this consumer boundary. This fold
// checks supplied receipt binding; it does not prove that a store was contacted.
// The carrier counterexample and next-rung trigger belong to
// gunbc.fleet_observation_capture_chunk committed_chunk: the commit-producing
// realization must perform CAS without accepting a caller-authored outcome.
// Production replay consumes supplied continuity and never manufactures it.
fn pre_os_committed_envelope(envelope: ObservationEnvelope) -> ObservationAttempt<ObservationEnvelope, PreOsRefusal> {
  match pre_os_bound_envelope(envelope: envelope) {
    ObservationRefused { cause } => ObservationRefused { cause: cause }
    ObservationEstablished { observed: bound } => match commit_attests_chunk(standing: bound.local_commit, chunk: bound.chunk) {
      CommitAttestsThisChunk => ObservationEstablished { observed: bound }
      CommitNoReceipt { standing } => ObservationRefused { cause: PreOsRefusal { location: ["commit"], detail: PreOsCommitRefusal { binding: CommitNoReceipt { standing: standing } } } }
      CommitAttestsOtherPayload { attested, chunk_payload } => ObservationRefused { cause: PreOsRefusal { location: ["commit"], detail: PreOsCommitRefusal { binding: CommitAttestsOtherPayload { attested: attested, chunk_payload: chunk_payload } } } }
      CommitBindingIncomparable { attested, chunk_payload } => ObservationRefused { cause: PreOsRefusal { location: ["commit"], detail: PreOsCommitRefusal { binding: CommitBindingIncomparable { attested: attested, chunk_payload: chunk_payload } } } }
    }
  }
}

fn pre_os_sel_native_id(envelope: ObservationEnvelope) -> String {
  match envelope.native_cursor {
    NoNativeCursor => ""
    NativeCursor { record_identity } => {
      let text = record_identity as String
      if starts_with(s: text, prefix: "0x") { substring(s: text, start: 2, end: text.length()) } else { text }
    }
  }
}

// The native cursor must describe the final row in this snapshot. Caller wall
// and monotonic receive instants remain on the retained envelope, unread here.
fn pre_os_sel_cursor(envelope: ObservationEnvelope, payload: String) -> ObservationAttempt<PreOsSelCursor, PreOsRefusal> {
  match pre_os_committed_envelope(envelope: envelope) {
    ObservationRefused { cause } => ObservationRefused { cause: cause }
    ObservationEstablished { observed: _ } => match envelope.source_generation {
    SourceGenerationUnavailable { reason } => ObservationRefused { cause: pre_os_text_refusal(text: reason) }
    SourceGenerationObserved { generation: _ } => match sel_read(text: payload) {
      ObservationRefused { cause } => ObservationRefused { cause: pre_os_text_refusal(text: cause) }
      ObservationEstablished { observed: watermark } => match watermark.records.skip(n: if count(watermark.records) == 0 { 0 } else { count(watermark.records) - 1 }).first() {
        Absent => ObservationRefused { cause: pre_os_text_refusal(text: "empty SEL snapshot has no native cursor anchor") }
        Present { value: last } => match sel_rendered_record(line: last) {
          ObservationRefused { cause } => ObservationRefused { cause: pre_os_text_refusal(text: cause) }
          ObservationEstablished { observed: event } => match sel_record_id(text: pre_os_sel_native_id(envelope: envelope)) {
            Present { value: id } => if id == event.record_id { ObservationEstablished { observed: PreOsSelCursor { envelope: envelope, watermark: watermark } } }
              else { ObservationRefused { cause: pre_os_text_refusal(text: "native SEL cursor does not name the snapshot final record") } }
            Absent => ObservationRefused { cause: pre_os_text_refusal(text: "native SEL cursor absent or malformed") }
          }
        }
      }
    }
  }
  }
}

// Every input survives, including source resets and malformed/uncertain reads.
// After a gap a valid new-generation snapshot is a baseline, NOT new stimulus.
// Only a subsequent same-generation append can produce new_records. No empty
// list returned here is a host-success assessment.
fn pre_os_ingest_sel(previous: ObservationAttempt<PreOsSelCursor, PreOsRefusal>, envelope: ObservationEnvelope, payload: String) -> PreOsSelIngestion {
  let cursor = pre_os_sel_cursor(envelope: envelope, payload: payload)
  let delta: ObservationAttempt<SelDelta, PreOsRefusal> = match cursor {
    ObservationRefused { cause } => ObservationRefused { cause: cause }
    ObservationEstablished { observed: next } => match previous {
      ObservationRefused { cause } => ObservationRefused { cause: pre_os_refusal_at(cause: cause, location: "initial or recovered SEL baseline; historical rows are not a newly observed stimulus") }
      ObservationEstablished { observed: before } =>
        if !pre_os_same_source_generation(a: before.envelope, b: envelope) {
          ObservationRefused { cause: PreOsRefusal { location: ["SEL source"], detail: PreOsSourceChanged { before: before.envelope, after: envelope } } }
        } else { match pre_os_chunk_continuity(envelope: envelope) {
          ContinuityCoversRange { reach: _ } => match sel_after(watermark: before.watermark, text: payload) {
            ObservationEstablished { observed } => ObservationEstablished { observed: observed }
            ObservationRefused { cause } => ObservationRefused { cause: pre_os_text_refusal(text: cause) }
          }
          ContinuityNotEstablished { continuity } => ObservationRefused { cause: PreOsRefusal { location: ["SEL continuity"], detail: PreOsContinuityRefusal { coverage: ContinuityNotEstablished { continuity: continuity } } } }
          ContinuityShortOfRange { verified_through, requested_end } => ObservationRefused { cause: PreOsRefusal { location: ["SEL continuity"], detail: PreOsContinuityRefusal { coverage: ContinuityShortOfRange { verified_through: verified_through, requested_end: requested_end } } } }
          ContinuityPositionsIncomparable { left, right } => ObservationRefused { cause: PreOsRefusal { location: ["SEL continuity"], detail: PreOsContinuityRefusal { coverage: ContinuityPositionsIncomparable { left: left, right: right } } } }
        } }
    }
  }
  PreOsSelIngestion {
    envelope: envelope, payload: payload, cursor: cursor,
    new_records: match delta { ObservationEstablished { observed: d } => d.events ObservationRefused { cause: _ } => [] },
    continuity: delta,
  }
}

// Index keys carry precisely the fields compared by the replay identity relation.
// They are structural values, not display strings or payload hashes. Chunk source
// agreement is checked independently by pre_os_bound_envelope, as before.
type PreOsOccurrenceContentKey {
  occurrence: ChunkOccurrence
  binding: SourceMachineBinding
  generation: SourceGenerationStanding
  cursor: NativeRecordCursor
  range: SourceStreamRange
  artifact: NonEmptyStr
  digest: ContentHash
}

type PreOsEnvelopeKey {
  content: PreOsOccurrenceContentKey
  ownership: EndpointOwnership
  producer_timestamp: ProducerTimestamp
  received: ReceiveObservation
  local_commit: LocalCommitStanding
  downstream: DownstreamAcceptanceStanding
  continuity: StreamContinuity
}

fn pre_os_occurrence_content_key(envelope: ObservationEnvelope) -> PreOsOccurrenceContentKey {
  PreOsOccurrenceContentKey { occurrence: envelope.chunk.occurrence, binding: envelope.binding,
    generation: envelope.source_generation, cursor: envelope.native_cursor, range: envelope.chunk.range,
    artifact: envelope.chunk.artifact_ref, digest: envelope.chunk.payload_digest }
}

fn pre_os_envelope_key(envelope: ObservationEnvelope) -> PreOsEnvelopeKey {
  PreOsEnvelopeKey { content: pre_os_occurrence_content_key(envelope: envelope), ownership: envelope.ownership,
    producer_timestamp: envelope.producer_timestamp, received: envelope.received, local_commit: envelope.local_commit,
    downstream: envelope.downstream, continuity: envelope.continuity }
}

// Conflict is an identity disagreement, not an assessment/refusal projection.
// Remember the first content and an absorbing conflict bit per occurrence; every
// later row can inspect the complete input's standing with one indexed lookup.
type PreOsOccurrenceContents { first: PreOsOccurrenceContentKey, conflicting: Bool }

fn pre_os_occurrence_index(envelopes: List<ObservationEnvelope>) -> Map<ChunkOccurrence, PreOsOccurrenceContents> {
  let initial: Map<ChunkOccurrence, PreOsOccurrenceContents> = empty_map()
  fold(envelopes, init: initial, f: (acc, envelope) => {
    let content = pre_os_occurrence_content_key(envelope: envelope)
    let standing = match map_lookup(m: acc, key: envelope.chunk.occurrence) {
      Absent => PreOsOccurrenceContents { first: content, conflicting: false }
      Present { value: previous } => PreOsOccurrenceContents { first: previous.first,
        conflicting: previous.conflicting || previous.first != content }
    }
    map_insert(m: acc, key: envelope.chunk.occurrence, value: standing)
  })
}

fn pre_os_occurrence_conflicts(envelopes: List<ObservationEnvelope>, subject: ObservationEnvelope) -> Bool {
  match map_lookup(m: pre_os_occurrence_index(envelopes: envelopes), key: subject.chunk.occurrence) {
    Absent => false
    Present { value: contents } => contents.conflicting || contents.first != pre_os_occurrence_content_key(envelope: subject)
  }
}

type PreOsUniqueEnvelopes { seen: Map<PreOsEnvelopeKey, Bool>, reversed: List<ObservationEnvelope> }

fn pre_os_unique_occurrences(envelopes: List<ObservationEnvelope>) -> List<ObservationEnvelope> {
  let retained = fold(envelopes, init: PreOsUniqueEnvelopes { seen: empty_map(), reversed: [] }, f: (acc, envelope) => {
    let key = pre_os_envelope_key(envelope: envelope)
    match map_lookup(m: acc.seen, key: key) {
      Present { value: _ } => acc
      Absent => PreOsUniqueEnvelopes { seen: map_insert(m: acc.seen, key: key, value: true), reversed: concat([envelope], acc.reversed) }
    }
  })
  reverse(retained.reversed)
}
