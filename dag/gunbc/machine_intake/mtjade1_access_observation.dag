// MT. JADE UNIT 1 BMC ACCESS. The BMC firmware family below is read from a committed capture (2026-10-03); this
// module still does not invent a host, serial, or BaseboardModel arm.
// Identity stays on extdeps.ocp.mt_jade until a FRU/SMBIOS join is captured. There is no
// UnitIdentityInputs row, because that type requires a host and we do not have one. The standing
// is the same UnitKeyStanding bind_unit_key returns for an empty observation list
// (BoardSerialAbsent) — not a Jade-only one-arm type (review 67792).

// THE FAMILY IS DISCRIMINATED, 2026-10-03, FROM THE COMMITTED CAPTURE AND NOTHING ELSE. The operator
// cabled the unit's single rear port (the GSG's BMC Ethernet Management port; the host has no NIC);
// the controller answered on its factory static 10.0.7.2 and accepted the factory admin account
// read-only, and the body of GET /redfish/v1/Managers/Self was committed verbatim at the path below.
// That FILE is the reading: read_mtjade1_recorded_manager_identity reads it, checks its sha256
// against the digest recorded at capture time, decodes the root Manager fields and Oem keys, and
// BINDS the response to this unit through Oem.Amp.FruInformation.BoardExtra, which must equal the
// link address of mtjade1_bmc_observed_network (the MAC srv1 saw ARPing from 10.0.7.2). Only a
// capture that passes all three reaches discriminate_family; any other is FamilyUnobserved naming
// the gap, so a drifted file, a re-typed field or another host's AMI Manager cannot stand as this
// unit's family. Operator notes from the same session, NOT consumed and NOT discriminators: IPMI
// mc info manufacturer 52538 (Ampere Computing), product 0x0082, firmware 2.11; FwInfo FW_DESC
// "JADE LTS_SPX12.3", FW_VERSION 2.11.104000 (Aug 20 2021); kernel 5.2.8-ami; hostname
// AMI70E28495336B; sshd "OpenSSH_7.9p1 Debian-10+deb10u2". The ASF presence pong's IANA 36465 is the
// DCMI Forum and discriminates nothing.
data mtjade1_redfish_manager_capture_path: NonEmptyStr = "artifacts/bmc/mtjade1-redfish-manager-self-2026-10-03.json"

data mtjade1_redfish_manager_capture_sha256: NonEmptyStr = "9888b0d065547861cdb5560fbb6fe62a5728acd9834685f3f4cd406f9123d4df"

// EVERY WAY A RECORDED CAPTURE FAILS TO BECOME THIS UNIT'S OBSERVATION, each its own arm so the
// FamilyUnobserved it turns into says which gap to close.
type RecordedManagerCaptureGap
  = CaptureUnreadable { error: String }
  | CaptureDigestMismatch { expected: NonEmptyStr, observed: String }
  | CaptureJsonUnreadable { gap: String }
  | CaptureFieldUnread { field: NonEmptyStr, cause: String }
  | CaptureSubjectLinkUnobserved
  | CaptureBoundToAnotherLink { board_extra: String }

type RecordedManagerDecode
  = RecordedManagerDecoded { observation: ManagerIdentityObservation }
  | RecordedManagerRefused { gap: RecordedManagerCaptureGap }

// THE HISTORICAL READ RECEIPT: which unit, through which observed network (address and link), which
// resource, which committed bytes under which digest, and what those bytes decoded to.
type RecordedManagerIdentityObservation {
  subject: NonEmptyStr
  endpoint: ObservedBmcNetwork
  resource: NonEmptyStr
  capture_path: NonEmptyStr
  capture_sha256: NonEmptyStr
  decoded: RecordedManagerDecode
}

fn capture_gap_text(gap: RecordedManagerCaptureGap) -> NonEmptyStr {
  match gap {
    CaptureUnreadable { error: e } => join(["the recorded Manager capture could not be read: ", e], "") as NonEmptyStr
    CaptureDigestMismatch { expected: x, observed: o } => join(["the recorded Manager capture hashes to ", o, ", not the recorded ", x as String], "") as NonEmptyStr
    CaptureJsonUnreadable { gap: g } => join(["the recorded Manager capture is not one JSON document: ", g], "") as NonEmptyStr
    CaptureFieldUnread { field: f, cause: c } => join(["the recorded Manager capture does not carry ", f as String, ": ", c], "") as NonEmptyStr
    CaptureSubjectLinkUnobserved => "the subject unit has no observed BMC link address to bind the capture to"
    CaptureBoundToAnotherLink { board_extra: b } => join(["the recorded Manager capture names BoardExtra ", b, ", which is not this unit's observed BMC link"], "") as NonEmptyStr
  }
}

fn field_unread(field: NonEmptyStr, cause: String) -> RecordedManagerDecode {
  RecordedManagerRefused { gap: CaptureFieldUnread { field: field, cause: cause } }
}

fn read_cause(r: JsonFieldRead<T>) -> String {
  match r {
    FieldAbsent => "absent"
    FieldMalformed { cause: c } => c
    FieldRead { value: _ } => "read"
  }
}

fn observed_bmc_link(network: ObservedBmcNetwork) -> Eui48Address? {
  match network {
    BmcNetworkObservedStatic { address: _, prefix: _, gateway: _, link: l, basis: _ } => Present { value: l }
    BmcNetworkObservedDhcpLease { address: _, prefix: _, basis: _ } => none
    BmcNetworkUnobserved { discriminator: _ } => none
  }
}

fn oem_member_keys(oem: JsonValue) -> List<String> {
  match oem {
    JsonObject { members: ms } => map(ms, m => m.key)
    JsonNull => []
    JsonBool { value: _ } => []
    JsonNumber { lexeme: _ } => []
    JsonString { value: _ } => []
    JsonArray { elements: _ } => []
  }
}

// THE BINDING: Oem.Amp.FruInformation.BoardExtra is the MAC the Ampere FRU carries for this board,
// and it must name the same link srv1 observed. It is compared EXACTLY against the observed link
// rendered in the spelling this field carries on the wire -- six uppercase hex pairs joined by
// colons -- rather than parsed, because extdeps.network.mac parse_mac_address admits only the
// lowercase canonical spelling and refuses this one by design. Any other spelling, or another
// address, refuses as CaptureBoundToAnotherLink: nothing here normalizes what the capture said.
fn board_extra_octet(v: UInt8) -> String {
  concat(hex_digit_char_upper(d: v / 16), hex_digit_char_upper(d: v % 16))
}

fn board_extra_spelling(link: Eui48Address) -> String {
  join([
    board_extra_octet(v: link.octet1),
    board_extra_octet(v: link.octet2),
    board_extra_octet(v: link.octet3),
    board_extra_octet(v: link.octet4),
    board_extra_octet(v: link.octet5),
    board_extra_octet(v: link.octet6),
  ], ":")
}

fn bind_board_extra(root: JsonValue, oem: JsonValue, link: Eui48Address?) -> RecordedManagerDecode {
  let amp = json_field(obj: oem, key: "Amp")
  match json_field_value(r: amp) {
    Absent => field_unread(field: "Oem.Amp", cause: read_cause(r: amp))
    Present { value: amp_v } => {
      let fru = json_field(obj: amp_v, key: "FruInformation")
      match json_field_value(r: fru) {
        Absent => field_unread(field: "Oem.Amp.FruInformation", cause: read_cause(r: fru))
        Present { value: fru_v } => {
          let extra = json_field_string(obj: fru_v, key: "BoardExtra")
          match json_field_value(r: extra) {
            Absent => field_unread(field: "Oem.Amp.FruInformation.BoardExtra", cause: read_cause(r: extra))
            Present { value: text } =>
              match link {
                Absent => RecordedManagerRefused { gap: CaptureSubjectLinkUnobserved }
                Present { value: l } =>
                  if text == board_extra_spelling(link: l) {
                    decode_manager_fields(root: root, oem: oem)
                  } else {
                    RecordedManagerRefused { gap: CaptureBoundToAnotherLink { board_extra: text } }
                  }
              }
          }
        }
      }
    }
  }
}

fn decode_manager_fields(root: JsonValue, oem: JsonValue) -> RecordedManagerDecode {
  let id = json_field_string(obj: root, key: "Id")
  let fw = json_field_string(obj: root, key: "FirmwareVersion")
  let model = json_field_string(obj: root, key: "Model")
  match json_field_value(r: id) {
    Absent => field_unread(field: "Id", cause: read_cause(r: id))
    Present { value: id_s } =>
      if id_s == "" {
        field_unread(field: "Id", cause: "empty")
      } else {
        match json_field_value(r: fw) {
          Absent => field_unread(field: "FirmwareVersion", cause: read_cause(r: fw))
          Present { value: fw_s } =>
            match json_field_value(r: model) {
              Absent => field_unread(field: "Model", cause: read_cause(r: model))
              Present { value: model_s } =>
                RecordedManagerDecoded {
                  observation: ManagerIdentityObservation {
                    manager_id: id_s as NonEmptyStr,
                    firmware_version: fw_s,
                    model: model_s,
                    oem_keys: oem_member_keys(oem: oem),
                  },
                }
            }
        }
      }
  }
}

// THE PURE HALF OF THE READ: digest first (bytes are what was recorded), then one JSON document,
// then the root Oem object, then the subject binding, then the identity fields.
fn decode_recorded_manager_capture(
  content: String,
  expected_sha256: NonEmptyStr,
  network: ObservedBmcNetwork,
) -> RecordedManagerDecode {
  decode_recorded_manager_capture_for_link(content: content, expected_sha256: expected_sha256, link: observed_bmc_link(network: network))
}

// THE SAME DECODE, BOUND TO A LINK RATHER THAN TO THE NETWORK OBSERVATION THAT CARRIED IT. A DHCP
// lease observation names an address and no link, so a read at a leased address is bound to the unit
// through the link observed for that controller on its own wire (the factory-static observation's
// tcpdump), never through the address it was read at.
fn decode_recorded_manager_capture_for_link(
  content: String,
  expected_sha256: NonEmptyStr,
  link: Eui48Address?,
) -> RecordedManagerDecode {
  let observed = sha256_hex_of_text(text: content)
  let expected: String = expected_sha256
  if observed != expected {
    RecordedManagerRefused { gap: CaptureDigestMismatch { expected: expected_sha256, observed: observed } }
  } else {
    match parse_json_document(s: content) {
      JsonDocumentUnreadable { gap: g } => RecordedManagerRefused { gap: CaptureJsonUnreadable { gap: json_document_gap_text(gap: g) } }
      JsonDocumentParsed { value: root } => {
        let oem = json_field(obj: root, key: "Oem")
        match json_field_value(r: oem) {
          Absent => field_unread(field: "Oem", cause: read_cause(r: oem))
          Present { value: oem_v } => bind_board_extra(root: root, oem: oem_v, link: link)
        }
      }
    }
  }
}

fn read_mtjade1_recorded_manager_identity() -> RecordedManagerIdentityObservation uses fs: std.resources.Filesystem {
  let read = Filesystem.Read(path: mtjade1_redfish_manager_capture_path as String)
  let decoded = match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } => RecordedManagerRefused { gap: CaptureUnreadable { error: e } }
    FilesystemReadSucceeded { content: text } =>
      decode_recorded_manager_capture(
        content: text,
        expected_sha256: mtjade1_redfish_manager_capture_sha256,
        network: mtjade1_bmc_observed_network,
      )
  }
  RecordedManagerIdentityObservation {
    subject: "mtjade1",
    endpoint: mtjade1_bmc_observed_network,
    resource: "/redfish/v1/Managers/Self",
    capture_path: mtjade1_redfish_manager_capture_path,
    capture_sha256: mtjade1_redfish_manager_capture_sha256,
    decoded: decoded,
  }
}

fn recorded_manager_family_standing(decoded: RecordedManagerDecode) -> BmcFirmwareFamilyStanding {
  match decoded {
    RecordedManagerDecoded { observation: o } => family_standing_from_discrimination(discrimination: discriminate_family(observation: o))
    RecordedManagerRefused { gap: g } => FamilyUnobserved { discriminator: capture_gap_text(gap: g) }
  }
}

fn mtjade1_firmware_family_standing() -> BmcFirmwareFamilyStanding uses fs: std.resources.Filesystem {
  recorded_manager_family_standing(decoded: read_mtjade1_recorded_manager_identity().decoded)
}

// THE CURRENT READ (cut O1c-1). GET /redfish/v1/Managers/Self at the controller's DHCP lease
// 192.168.1.246, read-only with the factory account, committed verbatim on 2026-10-04 (PR #13220).
// It is the read AccessDiscover consumes for mtjade1: the endpoint is the lease, the binding to this
// unit is Oem.Amp.FruInformation.BoardExtra against the link observed on the controller's own wire,
// and the controller's own DateTime is kept as an OBSERVATION. The capture proves a Redfish Manager
// surface at that address and build; it proves no account write.
data mtjade1_current_manager_capture_path: NonEmptyStr = "artifacts/bmc/mtjade1-redfish-manager-self-192.168.1.246-2026-10-04T043605Z.json"

data mtjade1_current_manager_capture_sha256: NonEmptyStr = "807189948689d6cf046fc53736108cd27dce60ab3f15ddc06f77de79681a1ef3"

// THE CONTROLLER'S OWN CLOCK, AS IT ANSWERED. A reading, never an instant anything is ordered by:
// mtjade1's controller reports a date in the year 2000, and no field typed this way is an ordering
// clock (cut O1b's observer clock is that authority).
type ControllerClockReading
  = ControllerClockRendered { rendering: NonEmptyStr }
  | ControllerClockUnread { cause: String }

// SEALED: minted only in this module, downstream of the fail-closed file read and its digest check,
// so a caller cannot author a decoded Manager response and hand it to AccessDiscover.
type CurrentManagerRead sole_constructor {
  identity: RecordedManagerIdentityObservation
  controller_clock: ControllerClockReading
}

fn controller_clock_of_capture(content: String) -> ControllerClockReading {
  match parse_json_document(s: content) {
    JsonDocumentUnreadable { gap: g } => ControllerClockUnread { cause: json_document_gap_text(gap: g) }
    JsonDocumentParsed { value: root } => {
      let at = json_field_string(obj: root, key: "DateTime")
      match json_field_value(r: at) {
        Absent => ControllerClockUnread { cause: read_cause(r: at) }
        Present { value: t } =>
          if t == "" {
            ControllerClockUnread { cause: "empty" }
          } else {
            ControllerClockRendered { rendering: t as NonEmptyStr }
          }
      }
    }
  }
}

// The clock is read only from bytes whose digest and unit binding already held: a reading from a
// capture that did not decode as this unit is not this controller's clock.
fn current_manager_read_of(content: String, expected_sha256: NonEmptyStr, endpoint: ObservedBmcNetwork, link: Eui48Address?, capture_path: NonEmptyStr) -> CurrentManagerRead
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtjade1_access_observation", decl_name: "read_mtjade1_current_manager_read"),
  ]
{
  let decoded = decode_recorded_manager_capture_for_link(content: content, expected_sha256: expected_sha256, link: link)
  let clock = match decoded {
    RecordedManagerDecoded { observation: _ } => controller_clock_of_capture(content: content)
    RecordedManagerRefused { gap: g } => ControllerClockUnread { cause: capture_gap_text(gap: g) as String }
  }
  CurrentManagerRead {
    identity: RecordedManagerIdentityObservation {
      subject: "mtjade1",
      endpoint: endpoint,
      resource: "/redfish/v1/Managers/Self",
      capture_path: capture_path,
      capture_sha256: expected_sha256,
      decoded: decoded,
    },
    controller_clock: clock,
  }
}

fn read_mtjade1_current_manager_read() -> CurrentManagerRead uses fs: std.resources.Filesystem {
  let read = Filesystem.Read(path: mtjade1_current_manager_capture_path as String)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } =>
      CurrentManagerRead {
        identity: RecordedManagerIdentityObservation {
          subject: "mtjade1",
          endpoint: mtjade1_bmc_reconfigured_network,
          resource: "/redfish/v1/Managers/Self",
          capture_path: mtjade1_current_manager_capture_path,
          capture_sha256: mtjade1_current_manager_capture_sha256,
          decoded: RecordedManagerRefused { gap: CaptureUnreadable { error: e } },
        },
        controller_clock: ControllerClockUnread { cause: e },
      }
    FilesystemReadSucceeded { content: text } =>
      current_manager_read_of(
        content: text,
        expected_sha256: mtjade1_current_manager_capture_sha256,
        endpoint: mtjade1_bmc_reconfigured_network,
        link: observed_bmc_link(network: mtjade1_bmc_observed_network),
        capture_path: mtjade1_current_manager_capture_path,
      )
  }
}

// THE COMMITTED BOARD-SERIAL OBSERVATIONS FOR mtjade1: none. No FRU board-serial read and no host
// SMBIOS read of this unit is committed, so IdentityBindProvisional binds no unit key and refuses
// with BoardSerialAbsent. A serial is added here only beside the committed capture it was read from.
data mtjade1_board_serial_observations: List<BoardSerialObservation> = []

data mtjade1_unit_key_standing: UnitKeyStanding = UnitKeyRefused {
  cause: BoardSerialAbsent,
}

// THE GSG'S ROWS ARE NOT RE-BOUND UNDER mtjade1_ NAMES HERE. An alias adds a second name for one
// concept (DESIGN §3) and buys nothing: the rear management port and the rail-kit part number are
// facts about the PLATFORM that this document states, and nothing observed on unit 1 distinguishes
// them. The aliases that used to sit here had exactly one reader, a witness asserting x == x, and
// their existence made two chassis rows LOOK consumed and kept them off the coverage frontier
// (review 67996). Both are rostered in gunbc.machine_intake_mtjade1_coverage_frontier now.

// Locus is reserved and off the accessor roster until the secret exists. THE ORDER IS THREE
// STAGES AND THE FIRST DOES NOT IMPLY THE SECOND: (1) a wet ProbeServiceRoot read establishes
// reachability and a Redfish surface; (2) a SEPARATE per-unit discriminator -- an observed BMC
// firmware identity or OEM fingerprint, an authenticated Manager/firmware response, or another
// explicitly modeled probe -- constructs FamilyObserved; (3) only then the family-specific
// rotation route, the mint and read-back, and roster admission. An earlier revision wrote stage 1
// as if it produced stage 2. It cannot: ProbeServiceRoot yields only RedfishHttpSurface, a 200
// service root is served by several families, and a 404 establishes the absence of that surface
// rather than MegaRAC.
type JadeManagedBmcSecretStanding
  = SecretLocusReservedNotOnAccessorRoster { ref: SecretRef }

data mtjade1_managed_bmc_secret_standing: JadeManagedBmcSecretStanding = SecretLocusReservedNotOnAccessorRoster {
  ref: mtjade1_bmc_gunbc_secret_ref,
}
