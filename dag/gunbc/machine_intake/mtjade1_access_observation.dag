// MT. JADE UNIT 1 BMC ACCESS. Every fact below is read from a committed capture; this module invents
// no host, serial, or board enum arm. The unit key is not a row here: it is derived by
// gunbc.machine_intake.arrival_converge identity_bind_provisional, through bind_unit_key, from the
// board-serial observations this module reads from the FRU and SMBIOS captures.

// THE FAMILY IS DISCRIMINATED, 2026-10-03, FROM THE COMMITTED CAPTURE AND NOTHING ELSE. The operator
// cabled the unit's single rear port (the GSG's BMC Ethernet Management port; the host has no NIC);
// the controller answered on its factory static 10.0.7.2 and accepted the factory admin account
// read-only, and the body of GET /redfish/v1/Managers/Self was committed verbatim at the path below.
// That FILE is the reading: read_mtjade1_recorded_manager_identity reads it, checks its sha256
// against the digest recorded at capture time, decodes the root Manager fields and Oem keys, and
// BINDS the response to this unit through Oem.Amp.FruInformation.BoardExtra, which must equal the
// link address of mtjade1_bmc_observed_network (the MAC srv1 saw ARPing from 10.0.7.2). Only a
// capture that passes all three reaches discriminate_family; any other is FamilyUnobserved naming
// the gap, so a drifted file, a re-typed field or another host's AMI Manager cannot stand as this
// unit's family. Operator notes from the same session, NOT consumed and NOT discriminators: IPMI
// mc info manufacturer 52538 (Ampere Computing), product 0x0082, firmware 2.11; FwInfo FW_DESC
// "JADE LTS_SPX12.3", FW_VERSION 2.11.104000 (Aug 20 2021); kernel 5.2.8-ami; hostname
// AMI70E28495336B; sshd "OpenSSH_7.9p1 Debian-10+deb10u2". The ASF presence pong's IANA 36465 is the
// DCMI Forum and discriminates nothing.
data mtjade1_redfish_manager_capture_path: NonEmptyStr = "artifacts/bmc/mtjade1-redfish-manager-self-2026-10-03.json"

data mtjade1_redfish_manager_capture_sha256: NonEmptyStr = "9888b0d065547861cdb5560fbb6fe62a5728acd9834685f3f4cd406f9123d4df"

// EVERY WAY A RECORDED CAPTURE FAILS TO BECOME THIS UNIT'S OBSERVATION, each its own arm so the
// FamilyUnobserved it turns into says which gap to close.
type RecordedManagerCaptureGap
  = CaptureUnreadable { error: String }
  | CaptureDigestMismatch { expected: NonEmptyStr, observed: String }
  | CaptureJsonUnreadable { gap: String }
  | CaptureFieldUnread { field: NonEmptyStr, cause: String }
  | CaptureSubjectLinkUnobserved
  | CaptureBoundToAnotherLink { board_extra: String }
  | CaptureChassisLinkUnread { field: NonEmptyStr, cause: String }
  | CaptureBoundToAnotherChassis { chassis: String }

type RecordedManagerDecode
  = RecordedManagerDecoded { observation: ManagerIdentityObservation }
  | RecordedManagerRefused { gap: RecordedManagerCaptureGap }

// THE HISTORICAL READ RECEIPT: which unit, through which observed network (address and link), which
// resource, which committed bytes under which digest, and what those bytes decoded to.
type RecordedManagerIdentityObservation {
  subject: NonEmptyStr
  endpoint: ObservedBmcNetwork
  resource: NonEmptyStr
  capture_path: NonEmptyStr
  capture_sha256: NonEmptyStr
  decoded: RecordedManagerDecode
}

fn capture_gap_text(gap: RecordedManagerCaptureGap) -> NonEmptyStr {
  match gap {
    CaptureUnreadable { error: e } => join(["the recorded Manager capture could not be read: ", e], "") as NonEmptyStr
    CaptureDigestMismatch { expected: x, observed: o } => join(["the recorded Manager capture hashes to ", o, ", not the recorded ", x as String], "") as NonEmptyStr
    CaptureJsonUnreadable { gap: g } => join(["the recorded Manager capture is not one JSON document: ", g], "") as NonEmptyStr
    CaptureFieldUnread { field: f, cause: c } => join(["the recorded Manager capture does not carry ", f as String, ": ", c], "") as NonEmptyStr
    CaptureSubjectLinkUnobserved => "the subject unit has no observed BMC link address to bind the capture to"
    CaptureBoundToAnotherLink { board_extra: b } => join(["the recorded Manager capture names BoardExtra ", b, ", which is not this unit's observed BMC link"], "") as NonEmptyStr
    CaptureChassisLinkUnread { field: f, cause: c } => join(["the recorded Manager capture does not carry ", f as String, ": ", c], "") as NonEmptyStr
    CaptureBoundToAnotherChassis { chassis: c } => join(["the recorded Manager capture is the Manager of chassis ", c, ", not the board this reader declared"], "") as NonEmptyStr
  }
}

fn field_unread(field: NonEmptyStr, cause: String) -> RecordedManagerDecode {
  RecordedManagerRefused { gap: CaptureFieldUnread { field: field, cause: cause } }
}

fn read_cause<T>(r: JsonFieldRead<T>) -> String {
  match r {
    FieldAbsent => "absent"
    FieldMalformed { cause: c } => c
    FieldRead { value: _ } => "read"
  }
}

fn observed_bmc_link(network: ObservedBmcNetwork) -> Eui48Address? {
  match network {
    BmcNetworkObservedStatic { address: _, prefix: _, gateway: _, link: l, basis: _ } => Present { value: l }
    BmcNetworkObservedDhcpLease { address: _, prefix: _, basis: _ } => none
    BmcNetworkUnobserved { discriminator: _ } => none
  }
}

fn oem_member_keys(oem: JsonValue) -> List<String> {
  match oem {
    JsonObject { members: ms } => map(ms, m => m.key)
    JsonNull => []
    JsonBool { value: _ } => []
    JsonNumber { lexeme: _ } => []
    JsonString { value: _ } => []
    JsonArray { elements: _ } => []
  }
}

// THE BINDING: Oem.Amp.FruInformation.BoardExtra is the MAC the Ampere FRU carries for this board,
// and it must name the same link srv1 observed. It is compared EXACTLY against the observed link
// rendered in the spelling this field carries on the wire -- six uppercase hex pairs joined by
// colons -- rather than parsed, because extdeps.network.mac parse_mac_address admits only the
// lowercase canonical spelling and refuses this one by design. Any other spelling, or another
// address, refuses as CaptureBoundToAnotherLink: nothing here normalizes what the capture said.
fn board_extra_octet(v: UInt8) -> String {
  concat(hex_digit_char_upper(d: v / 16), hex_digit_char_upper(d: v % 16))
}

fn board_extra_spelling(link: Eui48Address) -> String {
  join([
    board_extra_octet(v: link.octet1),
    board_extra_octet(v: link.octet2),
    board_extra_octet(v: link.octet3),
    board_extra_octet(v: link.octet4),
    board_extra_octet(v: link.octet5),
    board_extra_octet(v: link.octet6),
  ], ":")
}

// HOW A RECORDED MANAGER CAPTURE IS BOUND TO THE UNIT IT BELONGS TO. The binding is what makes the read
// THIS UNIT'S and not merely a Manager document, and every vendor family records it differently: MegaRAC
// echoes the link the controller was reached through into Oem.Amp.FruInformation.BoardExtra; OpenBMC
// publishes no such field, and its Manager names the chassis its board manages, keyed by the board's cited
// Redfish chassis id (extdeps.boards.asrock_rack asrock_altrad8ud_redfish_chassis_id). The READER supplies
// the binding for the unit whose bytes it read -- nothing here guesses a family from a file name.
type ManagerCaptureBinding
  = BoundToObservedWireLink { link: Eui48Address? }
  | BoundToManagedChassis { chassis_odata_id: NonEmptyStr }

fn bind_manager_capture(root: JsonValue, oem: JsonValue, binding: ManagerCaptureBinding) -> RecordedManagerDecode {
  match binding {
    BoundToObservedWireLink { link: l } => bind_board_extra(root: root, oem: oem, link: l)
    BoundToManagedChassis { chassis_odata_id: c } => bind_chassis_board(root: root, oem: oem, chassis_odata_id: c)
  }
}

// THE OPENBMC BINDING: the Manager says which chassis it manages, and that member's @odata.id is the board
// model's Redfish chassis id the reader declared for the unit. A Manager of another board is refused by
// name, so a capture of a different unit cannot be read as this one's.
fn bind_chassis_board(root: JsonValue, oem: JsonValue, chassis_odata_id: NonEmptyStr) -> RecordedManagerDecode {
  let links = json_field(obj: root, key: "Links")
  match json_field_value(r: links) {
    Absent => field_unread(field: "Links", cause: read_cause(r: links))
    Present { value: links_v } => {
      let chassis = json_field(obj: links_v, key: "ManagerInChassis")
      match json_field_value(r: chassis) {
        Absent => RecordedManagerRefused { gap: CaptureChassisLinkUnread { field: "Links.ManagerInChassis", cause: read_cause(r: chassis) } }
        Present { value: chassis_v } => {
          let id = json_field_string(obj: chassis_v, key: "@odata.id")
          match json_field_value(r: id) {
            Absent => RecordedManagerRefused { gap: CaptureChassisLinkUnread { field: "Links.ManagerInChassis.@odata.id", cause: read_cause(r: id) } }
            Present { value: observed } =>
              if observed == (chassis_odata_id as String) {
                decode_manager_fields(root: root, oem: oem)
              } else {
                RecordedManagerRefused { gap: CaptureBoundToAnotherChassis { chassis: observed } }
              }
          }
        }
      }
    }
  }
}

fn bind_board_extra(root: JsonValue, oem: JsonValue, link: Eui48Address?) -> RecordedManagerDecode {
  let amp = json_field(obj: oem, key: "Amp")
  match json_field_value(r: amp) {
    Absent => field_unread(field: "Oem.Amp", cause: read_cause(r: amp))
    Present { value: amp_v } => {
      let fru = json_field(obj: amp_v, key: "FruInformation")
      match json_field_value(r: fru) {
        Absent => field_unread(field: "Oem.Amp.FruInformation", cause: read_cause(r: fru))
        Present { value: fru_v } => {
          let extra = json_field_string(obj: fru_v, key: "BoardExtra")
          match json_field_value(r: extra) {
            Absent => field_unread(field: "Oem.Amp.FruInformation.BoardExtra", cause: read_cause(r: extra))
            Present { value: text } =>
              match link {
                Absent => RecordedManagerRefused { gap: CaptureSubjectLinkUnobserved }
                Present { value: l } =>
                  if text == board_extra_spelling(link: l) {
                    decode_manager_fields(root: root, oem: oem)
                  } else {
                    RecordedManagerRefused { gap: CaptureBoundToAnotherLink { board_extra: text } }
                  }
              }
          }
        }
      }
    }
  }
}

fn decode_manager_fields(root: JsonValue, oem: JsonValue) -> RecordedManagerDecode {
  let id = json_field_string(obj: root, key: "Id")
  let fw = json_field_string(obj: root, key: "FirmwareVersion")
  let model = json_field_string(obj: root, key: "Model")
  match json_field_value(r: id) {
    Absent => field_unread(field: "Id", cause: read_cause(r: id))
    Present { value: id_s } =>
      if id_s == "" {
        field_unread(field: "Id", cause: "empty")
      } else {
        match json_field_value(r: fw) {
          Absent => field_unread(field: "FirmwareVersion", cause: read_cause(r: fw))
          Present { value: fw_s } =>
            match json_field_value(r: model) {
              Absent => field_unread(field: "Model", cause: read_cause(r: model))
              Present { value: model_s } =>
                RecordedManagerDecoded {
                  observation: ManagerIdentityObservation {
                    manager_id: id_s as NonEmptyStr,
                    firmware_version: fw_s,
                    model: model_s,
                    oem_keys: oem_member_keys(oem: oem),
                  },
                }
            }
        }
      }
  }
}

// THE PURE HALF OF THE READ: digest first (bytes are what was recorded), then one JSON document,
// then the root Oem object, then the subject binding, then the identity fields.
fn decode_recorded_manager_capture(
  content: String,
  expected_sha256: NonEmptyStr,
  network: ObservedBmcNetwork,
) -> RecordedManagerDecode {
  decode_recorded_manager_capture_for_link(content: content, expected_sha256: expected_sha256, link: observed_bmc_link(network: network))
}

// THE SAME DECODE, BOUND TO A LINK RATHER THAN TO THE NETWORK OBSERVATION THAT CARRIED IT. A DHCP
// lease observation names an address and no link, so a read at a leased address is bound to the unit
// through the link observed for that controller on its own wire (the factory-static observation's
// tcpdump), never through the address it was read at.
fn decode_recorded_manager_capture_for_link(
  content: String,
  expected_sha256: NonEmptyStr,
  link: Eui48Address?,
) -> RecordedManagerDecode {
  decode_recorded_manager_capture_bound(content: content, expected_sha256: expected_sha256, binding: BoundToObservedWireLink { link: link })
}

// THE SAME DECODE, BOUND BY WHATEVER THE VENDOR FAMILY ACTUALLY RECORDS. This is the general form; the
// two entry points above are the two bindings this fleet has observed so far.
fn decode_recorded_manager_capture_bound(
  content: String,
  expected_sha256: NonEmptyStr,
  binding: ManagerCaptureBinding,
) -> RecordedManagerDecode {
  let observed = sha256_hex_of_text(text: content)
  let expected: String = expected_sha256
  if observed != expected {
    RecordedManagerRefused { gap: CaptureDigestMismatch { expected: expected_sha256, observed: observed } }
  } else {
    match parse_json_document(s: content) {
      JsonDocumentUnreadable { gap: g } => RecordedManagerRefused { gap: CaptureJsonUnreadable { gap: json_document_gap_text(gap: g) } }
      JsonDocumentParsed { value: root } => {
        let oem = json_field(obj: root, key: "Oem")
        match json_field_value(r: oem) {
          Absent => field_unread(field: "Oem", cause: read_cause(r: oem))
          Present { value: oem_v } => bind_manager_capture(root: root, oem: oem_v, binding: binding)
        }
      }
    }
  }
}

fn read_mtjade1_recorded_manager_identity() -> RecordedManagerIdentityObservation uses fs: std.resources.Filesystem {
  let read = Filesystem.Read(path: mtjade1_redfish_manager_capture_path as String)
  let decoded = match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } => RecordedManagerRefused { gap: CaptureUnreadable { error: e } }
    FilesystemReadSucceeded { content: text } =>
      decode_recorded_manager_capture(
        content: text,
        expected_sha256: mtjade1_redfish_manager_capture_sha256,
        network: mtjade1_bmc_observed_network,
      )
  }
  RecordedManagerIdentityObservation {
    subject: "mtjade1",
    endpoint: mtjade1_bmc_observed_network,
    resource: "/redfish/v1/Managers/Self",
    capture_path: mtjade1_redfish_manager_capture_path,
    capture_sha256: mtjade1_redfish_manager_capture_sha256,
    decoded: decoded,
  }
}

fn recorded_manager_family_standing(decoded: RecordedManagerDecode) -> BmcFirmwareFamilyStanding {
  match decoded {
    RecordedManagerDecoded { observation: o } => family_standing_from_discrimination(discrimination: discriminate_family(observation: o))
    RecordedManagerRefused { gap: g } => FamilyUnobserved { discriminator: capture_gap_text(gap: g) }
  }
}

fn mtjade1_firmware_family_standing() -> BmcFirmwareFamilyStanding uses fs: std.resources.Filesystem {
  recorded_manager_family_standing(decoded: read_mtjade1_recorded_manager_identity().decoded)
}

// THE CURRENT READ (cut O1c-1). GET /redfish/v1/Managers/Self at the controller's DHCP lease
// 192.168.1.246, read-only with the factory account. The 2026-10-04 capture (PR #13220) was the
// previous current read; J1 on 2026-10-06 replaced it with a new GET at the same endpoint and
// build (2.11.104000). AccessDiscover consumes THIS file: the endpoint is the lease, the binding
// to this unit is Oem.Amp.FruInformation.BoardExtra against the link observed on the controller's
// own wire, and the controller's own DateTime is kept as an OBSERVATION (year 2000, not corrected).
// The capture proves a Redfish Manager surface at that address and build; it proves no account write.
data mtjade1_current_manager_capture_path: NonEmptyStr = "artifacts/bmc/mtjade1-redfish-manager-self-192.168.1.246-2026-10-06T184626Z.json"

data mtjade1_current_manager_capture_sha256: NonEmptyStr = "f25e666a91342c7682f124b9e09836f580d3ee1aebdabb9936f9347cce966006"

data mtjade1_redfish_manager_resource: NonEmptyStr = "/redfish/v1/Managers/Self"

// THE CONTROLLER'S OWN CLOCK, AS IT ANSWERED. A reading, never an instant anything is ordered by:
// mtjade1's controller reports a date in the year 2000, and no field typed this way is an ordering
// clock (cut O1b's observer clock is that authority).
type ControllerClockReading
  = ControllerClockRendered { rendering: NonEmptyStr }
  | ControllerClockUnread { cause: String }

// SEALED: minted only in this module, downstream of the fail-closed file read and its digest check,
// so a caller cannot author a decoded Manager response and hand it to AccessDiscover.
type CurrentManagerRead sole_constructor {
  identity: RecordedManagerIdentityObservation
  controller_clock: ControllerClockReading
}

fn controller_clock_of_capture(content: String) -> ControllerClockReading {
  match parse_json_document(s: content) {
    JsonDocumentUnreadable { gap: g } => ControllerClockUnread { cause: json_document_gap_text(gap: g) }
    JsonDocumentParsed { value: root } => {
      let at = json_field_string(obj: root, key: "DateTime")
      match json_field_value(r: at) {
        Absent => ControllerClockUnread { cause: read_cause(r: at) }
        Present { value: t } =>
          if t == "" {
            ControllerClockUnread { cause: "empty" }
          } else {
            ControllerClockRendered { rendering: t as NonEmptyStr }
          }
      }
    }
  }
}

// The clock is read only from bytes whose digest and unit binding already held: a reading from a
// capture that did not decode as this unit is not this controller's clock.
// THE ONE MINT OF A CurrentManagerRead FROM BYTES. Which unit, which resource, which network it was read
// through, and how the capture binds to that unit all come from the READER that supplied the bytes: the
// subject and resource used to be hard-wired here to mtjade1's, which made this module a second producer
// of mtjade1's identity rather than a reader of whatever controller was captured (plan item 6, controller
// rows replace the mtjade1 hard-wire). mtjade1's reader passes exactly the values it always did.
fn current_manager_read_of(content: String, expected_sha256: NonEmptyStr, subject: NonEmptyStr, resource: NonEmptyStr, endpoint: ObservedBmcNetwork, binding: ManagerCaptureBinding, capture_path: NonEmptyStr) -> CurrentManagerRead
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake.mtjade1_access_observation", decl_name: "read_mtjade1_current_manager_read"),
    decl_ref(module_path: "gunbc.machine_intake.mtjade1_access_observation", decl_name: "read_srv13_current_manager_read"),
    decl_ref(module_path: "gunbc.machine_intake.arrival_unit_captures", decl_name: "read_unit_manager_capture"),
  ]
{
  let decoded = decode_recorded_manager_capture_bound(content: content, expected_sha256: expected_sha256, binding: binding)
  let clock = match decoded {
    RecordedManagerDecoded { observation: _ } => controller_clock_of_capture(content: content)
    RecordedManagerRefused { gap: g } => ControllerClockUnread { cause: capture_gap_text(gap: g) as String }
  }
  CurrentManagerRead {
    identity: RecordedManagerIdentityObservation {
      subject: subject,
      endpoint: endpoint,
      resource: resource,
      capture_path: capture_path,
      capture_sha256: expected_sha256,
      decoded: decoded,
    },
    controller_clock: clock,
  }
}

// WHAT A CAPTURE THAT CANNOT BE READ AT ALL STILL SAYS. The read is still a read OF this subject at this
// resource at this path with this digest -- the attempt is the record -- and everything derived from the body
// is unread. Three readers need exactly this shape (mtjade1's, srv13's, and the row-driven reader in
// gunbc.machine_intake.arrival_unit_captures), so it is written once here.
fn manager_capture_read_unread(subject: NonEmptyStr, endpoint: ObservedBmcNetwork, resource: NonEmptyStr, capture_path: NonEmptyStr, capture_sha256: NonEmptyStr, error: String) -> CurrentManagerRead {
  CurrentManagerRead {
    identity: RecordedManagerIdentityObservation {
      subject: subject,
      endpoint: endpoint,
      resource: resource,
      capture_path: capture_path,
      capture_sha256: capture_sha256,
      decoded: RecordedManagerRefused { gap: CaptureUnreadable { error: error } },
    },
    controller_clock: ControllerClockUnread { cause: error },
  }
}

fn read_mtjade1_current_manager_read() -> CurrentManagerRead uses fs: std.resources.Filesystem {
  let read = Filesystem.Read(path: mtjade1_current_manager_capture_path as String)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } =>
      manager_capture_read_unread(
        subject: "mtjade1",
        endpoint: mtjade1_bmc_reconfigured_network,
        resource: mtjade1_redfish_manager_resource,
        capture_path: mtjade1_current_manager_capture_path,
        capture_sha256: mtjade1_current_manager_capture_sha256,
        error: e,
      )
    FilesystemReadSucceeded { content: text } =>
      current_manager_read_of(
        content: text,
        expected_sha256: mtjade1_current_manager_capture_sha256,
        subject: "mtjade1",
        resource: mtjade1_redfish_manager_resource,
        endpoint: mtjade1_bmc_reconfigured_network,
        binding: BoundToObservedWireLink { link: observed_bmc_link(network: mtjade1_bmc_observed_network) },
        capture_path: mtjade1_current_manager_capture_path,
      )
  }
}

// srv13's authenticated Manager read, committed at
// artifacts/bmc/srv13-first-contact-2026-10-07/bmc-3.22.00/root_Managers_bmc.json and digested in that
// directory's SHA256SUMS line "./bmc-3.22.00/root_Managers_bmc.json". FINDINGS.txt records what it is: the
// first AUTHENTICATED request on the 03.22.00 push answered 403 Base.1.16.0.PasswordChangeRequired with the
// published credential, the credential was rotated into secret bmc-srv13-admin, and this is the Manager
// read that followed. So the 403 and this read are the SAME controller on both sides of the forced first
// write -- which is the join the forced-change arrival row needs, and it is capture-grounded rather than
// asserted. The binding is the chassis this Manager manages (OpenBMC publishes no BoardExtra), keyed by
// extdeps.boards.asrock_rack asrock_altrad8ud_redfish_chassis_id.
//
// CONSUMER: test.claim.machine_intake.machine_intake_arrival_converge_witness, the one-unit forced-change
// positive control. The production arrival route for an OpenBMC unit (the change declared by
// gunbc.machine_intake.arrival_converge forced_change_arrival_route_frontier) is the change that reads this
// controller live and calls this reader.
data srv13_current_manager_capture_path: NonEmptyStr = "artifacts/bmc/srv13-first-contact-2026-10-07/bmc-3.22.00/root_Managers_bmc.json"

data srv13_current_manager_capture_sha256: NonEmptyStr = "a2a538b9ac8be12980983f7ad968b10a0d95aac7e62de0acdb9d123b2123ae26"

data srv13_redfish_manager_resource: NonEmptyStr = "/redfish/v1/Managers/bmc"

// THE BINDING AN OPENBMC MANAGER CAPTURE OF AN ALTRAD8UD BOARD CARRIES: the chassis that Manager manages,
// keyed by the board's Redfish chassis id. It is a fact about the board, not about whichever unit the capture
// was taken from, so the unit rows name this one.
data altrad8ud_manager_capture_binding: ManagerCaptureBinding = BoundToManagedChassis {
  chassis_odata_id: join(["/redfish/v1/Chassis/", asrock_altrad8ud_redfish_chassis_id], "") as NonEmptyStr,
}

data srv13_manager_capture_binding: ManagerCaptureBinding = altrad8ud_manager_capture_binding

fn read_srv13_current_manager_read() -> CurrentManagerRead uses fs: std.resources.Filesystem {
  let read = Filesystem.Read(path: srv13_current_manager_capture_path as String)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } =>
      manager_capture_read_unread(
        subject: "srv13",
        endpoint: srv13_bmc_observed_network,
        resource: srv13_redfish_manager_resource,
        capture_path: srv13_current_manager_capture_path,
        capture_sha256: srv13_current_manager_capture_sha256,
        error: e,
      )
    FilesystemReadSucceeded { content: text } =>
      current_manager_read_of(
        content: text,
        expected_sha256: srv13_current_manager_capture_sha256,
        subject: "srv13",
        resource: srv13_redfish_manager_resource,
        endpoint: srv13_bmc_observed_network,
        binding: srv13_manager_capture_binding,
        capture_path: srv13_current_manager_capture_path,
      )
  }
}

// THE FRU READ (PR #13259). `ipmitool fru print` against the controller at 192.168.1.246, read-only,
// committed verbatim on 2026-10-04. Like the Manager read, the FILE is the reading: its sha256 is
// checked against the digest recorded at capture time, each field is read from exactly one line, and
// the capture is bound to this unit through Board Extra, which must equal the link observed on the
// controller's own wire (the same binding the Redfish capture's Oem.Amp.FruInformation.BoardExtra
// takes). A capture that fails any of these yields its typed gap, never an empty observation list.
// One home for the capture's path and digest: the board binding's receipt (gunbc.board_authority_binding).
data mtjade1_fru_capture_path: NonEmptyStr = mtjade1_fru_receipt.artifact_path

data mtjade1_fru_capture_sha256: NonEmptyStr = receipt_sha256_hex(receipt: mtjade1_fru_receipt) as NonEmptyStr

// The fields the provisional identity reads, as the capture spells them. Nothing else in the capture
// is consumed.
type FruIdentityFields {
  board_serial: NonEmptyStr
  board_part_number: NonEmptyStr
  board_product: NonEmptyStr
  chassis_part_number: NonEmptyStr
  chassis_serial: NonEmptyStr
}

// THE PURE DECODE'S ANSWER: open, for parser controls over supplied bytes. It is never the
// production observation: only read_mtjade1_fru seals a decode into RecordedFruObservation.
type FruDecode
  = FruDecoded { fields: FruIdentityFields }
  | FruRefused { gap: FruCaptureGap }

// SEALED: minted only by read_mtjade1_fru -- or, for a unit whose identity has no committed capture yet,
// by witness_recorded_fru_identity below -- downstream of the file read, the digest check and the Board
// Extra binding. It keeps its subject and WHERE IT CAME FROM, so a consumer can tell a capture from a
// witness fixture without parsing a path.
type RecordedFruObservation sole_constructor {
  subject: NonEmptyStr
  source: FruEvidenceSource
  fields: FruIdentityFields
}

type FruRead
  = FruObserved { observation: RecordedFruObservation }
  | FruReadRefused { gap: FruCaptureGap }

fn fru_gap_text(gap: FruCaptureGap) -> NonEmptyStr {
  match gap {
    FruCaptureUnreadable { error: e } => join(["the recorded FRU capture could not be read: ", e], "") as NonEmptyStr
    FruCaptureNotCommitted { unit: u, read_that_would_ground_it: r } => join(["no FRU capture of ", u as String, " is committed, so there is nothing to read. ", r], "") as NonEmptyStr
    FruCaptureDigestMismatch { expected: x, observed: o } => join(["the recorded FRU capture hashes to ", o, ", not the recorded ", x as String], "") as NonEmptyStr
    FruFieldGapped { gap: FruFieldAbsent { field: f } } => join(["the recorded FRU capture carries no ", f as String, " line"], "") as NonEmptyStr
    FruFieldGapped { gap: FruFieldRepeated { field: f } } => join(["the recorded FRU capture carries more than one ", f as String, " line"], "") as NonEmptyStr
    FruFieldGapped { gap: FruFieldEmpty { field: f } } => join(["the recorded FRU capture's ", f as String, " is empty"], "") as NonEmptyStr
    FruSubjectLinkUnobserved => "the subject unit has no observed BMC link address to bind the FRU capture to"
    FruBoundToAnotherLink { board_extra: b } => join(["the recorded FRU capture names Board Extra ", b, ", which is not this unit's observed BMC link"], "") as NonEmptyStr
  }
}

fn decode_fru_fields(content: String) -> FruDecode {
  match fru_field(content: content, field: "Board Serial") {
    FruFieldGap { gap: g } => FruRefused { gap: FruFieldGapped { gap: g } }
    FruFieldValue { value: serial } =>
      match fru_field(content: content, field: "Board Part Number") {
        FruFieldGap { gap: g } => FruRefused { gap: FruFieldGapped { gap: g } }
        FruFieldValue { value: board_pn } =>
          match fru_field(content: content, field: "Board Product") {
            FruFieldGap { gap: g } => FruRefused { gap: FruFieldGapped { gap: g } }
            FruFieldValue { value: product } =>
              match fru_field(content: content, field: "Chassis Part Number") {
                FruFieldGap { gap: g } => FruRefused { gap: FruFieldGapped { gap: g } }
                FruFieldValue { value: chassis_pn } =>
                  match fru_field(content: content, field: "Chassis Serial") {
                    FruFieldGap { gap: g } => FruRefused { gap: FruFieldGapped { gap: g } }
                    FruFieldValue { value: chassis_serial } =>
                      FruDecoded {
                        fields: FruIdentityFields {
                          board_serial: serial,
                          board_part_number: board_pn,
                          board_product: product,
                          chassis_part_number: chassis_pn,
                          chassis_serial: chassis_serial,
                        },
                      }
                  }
              }
          }
      }
  }
}

// THE PURE HALF: digest first, then the subject binding through Board Extra, then the fields.
fn decode_fru_capture(content: String, expected_sha256: NonEmptyStr, link: Eui48Address?) -> FruDecode {
  match fru_capture_digest_check(content: content, expected_sha256: expected_sha256) {
  FruCaptureDigestDiffers { gap: g } => FruRefused { gap: g }
  FruCaptureDigestAgrees =>
    match link {
      Absent => FruRefused { gap: FruSubjectLinkUnobserved }
      Present { value: l } =>
        match fru_field(content: content, field: "Board Extra") {
          FruFieldGap { gap: g } => FruRefused { gap: FruFieldGapped { gap: g } }
          FruFieldValue { value: extra } =>
            if (extra as String) == board_extra_spelling(link: l) {
              decode_fru_fields(content: content)
            } else {
              FruRefused { gap: FruBoundToAnotherLink { board_extra: extra as String } }
            }
        }
    }
  }
}

fn read_mtjade1_fru() -> FruRead uses fs: std.resources.Filesystem {
  let read = Filesystem.Read(path: mtjade1_fru_capture_path as String)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } => FruReadRefused { gap: FruCaptureUnreadable { error: e } }
    FilesystemReadSucceeded { content: text } =>
      match decode_fru_capture(content: text, expected_sha256: mtjade1_fru_capture_sha256, link: observed_bmc_link(network: mtjade1_bmc_observed_network)) {
        FruRefused { gap: g } => FruReadRefused { gap: g }
        FruDecoded { fields: f } =>
          FruObserved {
            observation: RecordedFruObservation {
              subject: "mtjade1",
              source: FruFromCommittedCapture {
                capture_path: mtjade1_fru_capture_path,
                capture_sha256: mtjade1_fru_capture_sha256,
              },
              fields: f,
            },
          }
      }
  }
}

// A COMMITTED FRU CAPTURE OF A UNIT THAT IS NOT mtjade1, keyed by the unit.
//
// WHY THE SUBJECT BINDING NEEDS AN ARM. mtjade1's FRU capture proves which unit it came off from inside
// itself: its Board Extra field carries the MAC of the controller that answers for that unit, and
// read_mtjade1_fru refuses the capture unless it names the link the fleet binds to it. That is one board's
// choice about what to put in a spare FRU field, not a property of ipmitool's output, so a capture of another
// unit cannot be attributed that way -- and no ALTRAD8UD FRU capture is committed, so whether theirs carries
// the field at all is not known here and is not assumed either way. What CAN attribute such a capture is the
// session the read was issued over: an IPMI LAN read against the endpoint the fleet names for this unit, or an
// in-band read on the unit's own /dev/ipmi0 channel, attributes the bytes without any self-report. So the row
// states which attribution it claims, the reader honours that arm only, and each arm mints its own evidence
// kind so a session-bound capture can never be read as a self-reported one.
//
// WHY THIS IS THE SHAPE THE IN-RUN CAPTURE LANDS INTO. The live arrival door runs extdeps.bmc.ipmi's FruPrint
// -- which passes the managed credential through a file, never in argv -- and commits the response under its
// SHA256 digest the way the account-state captures are committed. Such a response is one of these rows: same
// reader, keyed by the capture's own digest. Nothing about the reader changes when the capture lands.
type BmcFruCaptureAttribution
  = FruReadIssuedToBoundController { fleet_bound_bmc_address: NonEmptyStr }
  | FruReadTakenOnTheUnitItself

type BmcFruCaptureRow {
  unit: HostIdentity
  capture_path: NonEmptyStr
  capture_sha256: NonEmptyStr
  // Absent when the whole file is an FRU print; present when the print is one section of a multi-command
  // capture, in which case only that section is decoded -- reading Board Serial out of the wrong section of a
  // capture that also carries dmidecode would mint a serial from the wrong table.
  capture_section: NonEmptyStr?
  attribution: BmcFruCaptureAttribution
  attribution_basis: NonEmptyStr
}

// srv14/butch's in-band SSIF recovery carries its FRU board area, taken on the unit through /dev/ipmi0 with no
// credential, in the same file as its dmidecode tables -- so its attribution is the in-band one, settled by the
// in-band capture row of the same run (gunbc.machine_intake.inband_host_identity) and not by anything asserted
// here. srv15 has no FRU print: its recovery README lists what was read, and a fru print is not among it.
data bmc_fru_capture_rows: List<BmcFruCaptureRow> = [
  BmcFruCaptureRow {
    unit: operator_host_srv14,
    capture_path: "artifacts/bmc/altrad8ud-1l2t-6-inband-recovery-2026-10-16/03_host_identity.txt",
    capture_sha256: "1d24eff4979ecafd8540c0758bd5e0996c045a3765ccc14f40037f5286a2f99b",
    capture_section: Present { value: "ipmitool fru 0 (board/product area)" },
    attribution: FruReadTakenOnTheUnitItself,
    attribution_basis: "00_README.txt of the same capture directory: every ipmitool call of that run used /dev/ipmi0, with no -I lanplus and no credential on the command line -- the passwordless in-band system interface of this unit's own BMC",
  },
]

// THE READ THAT WOULD GROUND SRV15'S SECOND SOURCE, concrete enough to take: what to run, where to commit it,
// and which arm each form mints. It is the text the arrival fold refuses with, so a refusal names the evidence
// that would discharge it rather than merely saying something is missing.
data altrad8ud_bmc_fru_identity_read_obligation: NonEmptyStr = "a second reading of this unit's board serial: an `ipmitool fru print` of the unit's own BMC, committed with its SHA256SUMS entry under artifacts/bmc/<unit>-arrival-<date>/ and named by that path and digest in a gunbc.machine_intake.mtjade1_access_observation bmc_fru_capture_rows row. Either form grounds it, and the row says which: issued over IPMI LAN from the dispatch host to the endpoint the fleet names for this unit, under the managed credential passed through -f and never in argv, which mints FruReadIssuedToBoundController; or taken in-band on the unit through /dev/ipmi0 in the same rescue session that produced the unit's in-band host identity capture, which mints FruReadTakenOnTheUnitItself."

fn bmc_fru_capture_row(unit: HostIdentity) -> BmcFruCaptureRow? {
  first_where(bmc_fru_capture_rows, e => host_identity_eq(a: e.unit, b: unit))
}

// THE PURE HALF, arm-dispatched. The FRU text has already been proven by its file's digest and cut to its
// section; what is left is the attribution the row claims. Both arms read the same board-area and chassis-area
// fields, because those are IPMI FRU fields and not one board's invention.
fn decode_committed_bmc_fru_capture(fru_text: String, row: BmcFruCaptureRow) -> FruDecode {
  match row.attribution {
    FruReadIssuedToBoundController { fleet_bound_bmc_address: _ } => decode_fru_fields(content: fru_text)
    FruReadTakenOnTheUnitItself => decode_fru_fields(content: fru_text)
  }
}

// READ A UNIT'S COMMITTED FRU CAPTURE FROM ITS ROW, fail closed: no row, no read -- and the refusal carries the
// read that would produce one, in the form the live arrival run would take it. The digest is checked against
// the FILE, which is what SHA256SUMS lists, before any section is cut out of it. An in-band row is attributed
// only through the in-band capture of the same run, so a fru print sitting in a capture directory that cannot
// say which unit it was taken on refuses here too.
fn read_committed_bmc_fru_capture(unit: HostIdentity) -> FruRead uses fs: std.resources.Filesystem {
  match bmc_fru_capture_row(unit: unit) {
    none => FruReadRefused { gap: FruCaptureNotCommitted { unit: unit as NonEmptyStr, read_that_would_ground_it: altrad8ud_bmc_fru_identity_read_obligation } }
    Present { value: row } =>
      match row.attribution {
        FruReadTakenOnTheUnitItself =>
          match read_attributed_inband_capture(unit: unit) {
            InbandCaptureRefused { gap: g } => FruReadRefused { gap: FruCaptureUnreadable { error: inband_identity_gap_text(gap: g) } }
            InbandCaptureAttributed { content: text, row: _, channel_content: _ } => mint_committed_bmc_fru_capture(text: text, row: row)
          }
        FruReadIssuedToBoundController { fleet_bound_bmc_address: _ } => {
          let read = Filesystem.Read(path: row.capture_path as String)
          match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
            FilesystemReadRefused { error: e } => FruReadRefused { gap: FruCaptureUnreadable { error: e } }
            FilesystemReadSucceeded { content: text } =>
              match fru_capture_digest_check(content: text, expected_sha256: row.capture_sha256) {
                FruCaptureDigestDiffers { gap: g } => FruReadRefused { gap: g }
                FruCaptureDigestAgrees => mint_committed_bmc_fru_capture(text: text, row: row)
              }
          }
        }
      }
  }
}

// Cut the FRU text out of the capture -- the whole file, or the one section its row names -- decode the board
// area, and mint the observation under the session-bound evidence kind.
fn mint_committed_bmc_fru_capture(text: String, row: BmcFruCaptureRow) -> FruRead {
  let fru_text = match row.capture_section {
    Absent => text
    Present { value: section } => join(inband_section_rows(content: text, marker: section), "\n")
  }
  match decode_committed_bmc_fru_capture(fru_text: fru_text, row: row) {
    FruRefused { gap: g } => FruReadRefused { gap: g }
    FruDecoded { fields: f } =>
      FruObserved {
        observation: RecordedFruObservation {
          subject: row.unit as NonEmptyStr,
          source: FruFromSessionBoundCapture {
            capture_path: row.capture_path,
            capture_sha256: row.capture_sha256,
            attribution: row.attribution,
            attribution_basis: row.attribution_basis,
          },
          fields: f,
        },
      }
  }
}

// THE HOST SMBIOS READ (PR #13259). The raw SOL transcript of `smbiosview -t 2` at the UEFI shell,
// committed verbatim. Its sha256 is checked and carriage returns are dropped; the transcript's
// structures are the blocks between its separator lines, exactly one block must be the Base Board
// Information structure, and its SerialNumber is read INSIDE that block, exactly once.
// THE OTHER SECOND-SOURCE CANDIDATE, named so a refusal can name it: a UEFI `smbiosview -t 2` transcript read
// over an SOL session to the unit's own controller, committed with the session attribution and a SHA256SUMS
// entry. For an ALTRAD8UD unit this pairs with the in-band host identity read only if the transcript is taken
// through that unit's controller, which is what the SOL attribution carries.
data altrad8ud_host_smbios_read_obligation: NonEmptyStr = "a UEFI `smbiosview -t 2` transcript of the unit's baseboard, taken at the unit's own UEFI shell through a session to this unit's BMC host console (the SOL attribution the capture arm requires), committed with its SHA256SUMS entry and named by that path and digest in a gunbc.machine_intake.mtjade1_access_observation SMBIOS capture row"

data mtjade1_smbios_type2_capture_path: NonEmptyStr = "artifacts/bmc/mtjade1-uefi-smbiosview-type2-sol-2026-10-04.txt"

data mtjade1_smbios_type2_capture_sha256: NonEmptyStr = "b40dde96a64c4d04c5440235a05a9571467472ba0b1ed0f35c907f675e817442"

data smbiosview_structure_separator: String = "========================================================="

type SmbiosCaptureGap
  = SmbiosCaptureUnreadable { error: String }
  | SmbiosCaptureNotCommitted { unit: NonEmptyStr, read_that_would_ground_it: NonEmptyStr }
  | SmbiosCaptureDigestMismatch { expected: NonEmptyStr, observed: String }
  | SmbiosBaseBoardStructureCount { count: Int }
  | SmbiosSerialLineCount { count: Int }
  | SmbiosSerialEmpty

// The pure decode's answer: open, for parser controls over supplied bytes, and never the production
// observation.
type SmbiosBaseBoardDecode
  = SmbiosBaseBoardSerial { serial: NonEmptyStr }
  | SmbiosBaseBoardRefused { gap: SmbiosCaptureGap }

fn smbios_gap_text(gap: SmbiosCaptureGap) -> NonEmptyStr {
  match gap {
    SmbiosCaptureUnreadable { error: e } => join(["the recorded SMBIOS capture could not be read: ", e], "") as NonEmptyStr
    SmbiosCaptureNotCommitted { unit: u, read_that_would_ground_it: r } => join(["no host SMBIOS type-2 transcript of ", u as String, " is committed, so there is nothing to read. ", r], "") as NonEmptyStr
    SmbiosCaptureDigestMismatch { expected: x, observed: o } => join(["the recorded SMBIOS capture hashes to ", o, ", not the recorded ", x as String], "") as NonEmptyStr
    SmbiosBaseBoardStructureCount { count: n } => join(["the recorded SMBIOS capture carries ", to_string(n), " Base Board Information structures, not one"], "") as NonEmptyStr
    SmbiosSerialLineCount { count: n } => join(["the Base Board Information structure carries ", to_string(n), " SerialNumber lines, not one"], "") as NonEmptyStr
    SmbiosSerialEmpty => "the Base Board Information structure's SerialNumber is empty"
  }
}

fn smbios_block_rows(block: String) -> List<String> {
  map(split(s: block, delimiter: "\n"), l => trim(l))
}

fn decode_smbios_base_board_block(rows: List<String>) -> SmbiosBaseBoardDecode {
  let serials = rows |> filter(l => starts_with(l, "SerialNumber:"))
  if length(serials) != 1 {
    SmbiosBaseBoardRefused { gap: SmbiosSerialLineCount { count: length(serials) } }
  } else {
    match serials.first() {
      Absent => SmbiosBaseBoardRefused { gap: SmbiosSerialLineCount { count: 0 } }
      Present { value: line } => {
        let serial = trim(join(split(s: line, delimiter: "SerialNumber:").skip(n: 1), "SerialNumber:"))
        if serial == "" {
          SmbiosBaseBoardRefused { gap: SmbiosSerialEmpty }
        } else {
          SmbiosBaseBoardSerial { serial: serial as NonEmptyStr }
        }
      }
    }
  }
}

fn decode_smbios_type2_capture(content: String, expected_sha256: NonEmptyStr) -> SmbiosBaseBoardDecode {
  let observed = sha256_hex_of_text(text: content)
  if observed != (expected_sha256 as String) {
    SmbiosBaseBoardRefused { gap: SmbiosCaptureDigestMismatch { expected: expected_sha256, observed: observed } }
  } else {
    let blocks = map(split(s: join(split(s: content, delimiter: "\r"), ""), delimiter: smbiosview_structure_separator), b => smbios_block_rows(block: b))
    let boards = blocks |> filter(rows => rows |> any(l => l == "Structure Type: Base Board Information"))
    if length(boards) != 1 {
      SmbiosBaseBoardRefused { gap: SmbiosBaseBoardStructureCount { count: length(boards) } }
    } else {
      match boards.first() {
        Absent => SmbiosBaseBoardRefused { gap: SmbiosBaseBoardStructureCount { count: 0 } }
        Present { value: rows } => decode_smbios_base_board_block(rows: rows)
      }
    }
  }
}

// WHO SAYS THE SOL SESSION WAS THIS CONTROLLER'S: the operator. The transcript's bytes say only that
// some SOL session was operational; they name no controller and no unit. So the binding is carried as
// what it is, an OPERATOR-ATTESTED standing naming the controller, the observer host and the record
// (the shape of gunbc.machine_intake.mtcollins1_power_on_account PopulationOperatorAttested), and is
// never presented as a machine-derived binding. A machine-derived arm joins this type when a capture
// carries a discriminator of its own (for example the SOL session's own controller address).
type SolSessionAttribution
  = SolSessionOperatorAttested { controller: BmcControllerEndpoint, observer_host: NonEmptyStr, attested_by: NonEmptyStr, record: NonEmptyStr }

data mtjade1_smbios_sol_attribution: SolSessionAttribution = SolSessionOperatorAttested {
  controller: BmcControllerEndpoint { host: "192.168.1.246" },
  observer_host: "srv1",
  attested_by: "the operator, through the eager-gull-22 session",
  record: "PR #13259: smbiosview -t 2 typed at the UEFI shell over an ipmitool sol session from srv1 to the controller at 192.168.1.246, 2026-10-04",
}

fn sol_session_controller(a: SolSessionAttribution) -> BmcControllerEndpoint {
  match a {
    SolSessionOperatorAttested { controller: c, observer_host: _, attested_by: _, record: _ } => c
  }
}

// WHERE AN IDENTITY OBSERVATION CAME FROM. Modelled, not a provenance string parked in a field named
// capture_path: a field a later reader would trust must mean exactly one thing (gunbc.design_argument::single_authority, "Minimization
// holds only if each fact lives in exactly one place"), and a string saying "witness-supplied" in a path
// slot is one name with two meanings. The precedent is gunbc.clock_read's ObserverInstantSource, which
// "travels with every instant so a modeled instant is never read as a measured one": the two identity
// records below carry this source in place of loose capture_path / capture_sha256 / sol_session fields, so
// a witness-supplied identity can never be read as a measured one.
//
// THE TWO RECORDS DO NOT SHARE ONE SOURCE TYPE, AND THE SPLIT IS THE POINT. A capture-backed baseboard
// (SMBIOS type-2) transcript MUST name the SOL session it was read through: that attribution was a required
// field of RecordedSmbiosObservation before this change, and carrying it as an optional field of a shared
// source would let an omission switch arrival_converge.smbios_session_disagrees off -- a writable false
// fact (gunbc.design_argument::fail_closed, "Stronger than catching a wrong state is making it unwritable"). An ipmitool FRU print
// records no SOL transcript at all, so the FRU capture arm offers no such field to leave empty: the vendor's
// absence is modelled as absence of the field, not as an absent value.
type SmbiosEvidenceSource
  = SmbiosFromCommittedCapture { capture_path: NonEmptyStr, capture_sha256: NonEmptyStr, sol_session: SolSessionAttribution }
  | SmbiosIdentityWitnessSupplied { realization: NonEmptyStr }

type FruEvidenceSource
  = FruFromCommittedCapture { capture_path: NonEmptyStr, capture_sha256: NonEmptyStr }
  | FruFromSessionBoundCapture { capture_path: NonEmptyStr, capture_sha256: NonEmptyStr, attribution: BmcFruCaptureAttribution, attribution_basis: NonEmptyStr }
  | FruIdentityWitnessSupplied { realization: NonEmptyStr }

// THE CONTROLLER THE SMBIOS TRANSCRIPT WAS READ THROUGH. The capture arm cannot be written without the
// attribution, so the only route to none is a witness-supplied serial, which says so by its own name. none
// is not a claim that the transcript went through some unnamed controller, so the agreement classifier does
// not invent one.
fn smbios_session_controller(source: SmbiosEvidenceSource) -> BmcControllerEndpoint? {
  match source {
    SmbiosFromCommittedCapture { capture_path: _, capture_sha256: _, sol_session: a } => Present { value: sol_session_controller(a: a) }
    SmbiosIdentityWitnessSupplied { realization: _ } => none
  }
}

// WITNESS-ONLY IDENTITY MINTS. A unit whose identity has no committed capture yet -- srv13 and srv14, the
// ALTRAD8UD units this lane drives, have a Redfish capture set but no ipmitool FRU print and no UEFI
// smbiosview type-2 transcript -- can still carry an identity through an arrival fold UNDER TEST, because
// these mint FruIdentityWitnessSupplied / SmbiosIdentityWitnessSupplied: the values say they are the witness's, and no field pretends to be a
// digest or a path. Production cannot reach either mint (admit_callers names only the arrival witness), so
// no production admission changes and no production identity can be minted from a thought.
fn witness_recorded_fru_identity(subject: NonEmptyStr, fields: FruIdentityFields, realization: NonEmptyStr) -> RecordedFruObservation
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "srv13_identity_bind_inputs"),
  ]
{
  RecordedFruObservation {
    subject: subject,
    source: FruIdentityWitnessSupplied { realization: realization },
    fields: fields,
  }
}

fn witness_recorded_smbios_serial(subject: NonEmptyStr, serial: NonEmptyStr, realization: NonEmptyStr) -> RecordedSmbiosObservation
  admit_callers: [
    decl_ref(module_path: "test.claim.machine_intake.machine_intake_arrival_converge_witness", decl_name: "srv13_identity_bind_inputs"),
  ]
{
  RecordedSmbiosObservation {
    subject: subject,
    source: SmbiosIdentityWitnessSupplied { realization: realization },
    serial: serial,
  }
}

// THE ALTRAD8UD IDENTITY READERS FRONTIER HAS DISSOLVED, and the record of it is that the readers are here:
// the in-band host identity reader (gunbc.machine_intake.inband_host_identity, capture rows keyed by unit,
// attributed through the unit's bound host NIC or its in-band BMC channel) and the committed FRU capture reader
// above (read_committed_bmc_fru_capture, attributed by the session the read was issued over). srv14's
// committed 2026-10-16 SSIF recovery carries BOTH sides of the pair in one file -- dmidecode's baseboard table
// and the ipmitool fru 0 board area, BR80S6102300077 -- and both rows are committed, so the pair is read from
// digest-checked bytes and the two serials are compared by the arrival fold's own classifier
// (gunbc.machine_intake.arrival_converge observe_identity, the InbandHostBoardReading arm). What the frontier
// asked for and did NOT get, and is not faked here: srv15 has no FRU print, so its arrival refuses at
// IdentityBindProvisional naming the read that would ground it, and no ALTRAD8UD unit has a host SMBIOS type-2
// transcript, which the in-band pair makes unnecessary. The witness mints below keep their only caller -- the
// srv13 forced-change positive control -- and srv13 is retired: its captures replay as a control, never as an
// admission.

// SEALED: minted only by read_mtjade1_smbios_type2 -- or by witness_recorded_smbios_serial below --
// downstream of the file read and the scoped decode, keeping its subject and source beside the serial.
type RecordedSmbiosObservation sole_constructor {
  subject: NonEmptyStr
  source: SmbiosEvidenceSource
  serial: NonEmptyStr
}

type SmbiosRead
  = SmbiosObserved { observation: RecordedSmbiosObservation }
  | SmbiosReadRefused { gap: SmbiosCaptureGap }

fn read_mtjade1_smbios_type2() -> SmbiosRead uses fs: std.resources.Filesystem {
  let read = Filesystem.Read(path: mtjade1_smbios_type2_capture_path as String)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } => SmbiosReadRefused { gap: SmbiosCaptureUnreadable { error: e } }
    FilesystemReadSucceeded { content: text } =>
      match decode_smbios_type2_capture(content: text, expected_sha256: mtjade1_smbios_type2_capture_sha256) {
        SmbiosBaseBoardRefused { gap: g } => SmbiosReadRefused { gap: g }
        SmbiosBaseBoardSerial { serial: sn } =>
          SmbiosObserved {
            observation: RecordedSmbiosObservation {
              subject: "mtjade1",
              source: SmbiosFromCommittedCapture {
                capture_path: mtjade1_smbios_type2_capture_path,
                capture_sha256: mtjade1_smbios_type2_capture_sha256,
                sol_session: mtjade1_smbios_sol_attribution,
              },
              serial: sn,
            },
          }
      }
  }
}

// mtjade1's PROVISIONAL ASSEMBLY, from the sealed FRU observation: the chassis part number, and the
// chassis as its one component identified by the chassis serial. The board's identity is the unit key
// (the board serial) and the BMC's is the firmware manifest's bmc entry; gunbc.machine_intake.subject
// ComponentKind has no board or BMC arm and none is added here. InventoryConform re-derives the
// assembly from the booted host.
fn provisional_assembly_of_fru(fru: RecordedFruObservation) -> AssemblyManifest {
  AssemblyManifest {
    chassis_part_number: fru.fields.chassis_part_number,
    components: [ComponentIdentity { kind: ChassisComponent, slot: "chassis", identity: fru.fields.chassis_serial }],
  }
}


// THE GSG'S ROWS ARE NOT RE-BOUND UNDER mtjade1_ NAMES HERE. An alias adds a second name for one
// concept (gunbc.design_argument::single_authority) and buys nothing: the rear management port and the rail-kit part number are
// facts about the PLATFORM that this document states, and nothing observed on unit 1 distinguishes
// them. The aliases that used to sit here had exactly one reader, a witness asserting x == x, and
// their existence made two chassis rows LOOK consumed and kept them off the coverage frontier
// (review 67996). Both are rostered in gunbc.machine_intake.mtjade1_coverage_frontier now.

// Locus is reserved and off the accessor roster until the secret exists. THE ORDER IS THREE
// STAGES AND THE FIRST DOES NOT IMPLY THE SECOND: (1) a wet ProbeServiceRoot read establishes
// reachability and a Redfish surface; (2) a SEPARATE per-unit discriminator -- an observed BMC
// firmware identity or OEM fingerprint, an authenticated Manager/firmware response, or another
// explicitly modeled probe -- constructs FamilyObserved; (3) only then the family-specific
// rotation route, the mint and read-back, and roster admission. An earlier revision wrote stage 1
// as if it produced stage 2. It cannot: ProbeServiceRoot yields only RedfishHttpSurface, a 200
// service root is served by several families, and a 404 establishes the absence of that surface
// rather than MegaRAC.
type JadeManagedBmcSecretStanding
  = SecretLocusReservedNotOnAccessorRoster { ref: SecretRef }

data mtjade1_managed_bmc_secret_standing: JadeManagedBmcSecretStanding = SecretLocusReservedNotOnAccessorRoster {
  ref: mtjade1_bmc_gunbc_secret_ref,
}

// J3 VIRTUAL-MEDIA RESIDUE ON THIS UNIT'S BASELINE. Origin is a JOIN of three committed files, not a
// lane name: before_general.json (empty share), SEQUENCE.txt (the incident receipt), and the restore
// GET (the sticky path). Eager-gull-22: leave the stale path; no more writes. J2 archive and later
// converge read this standing so they never treat a nonempty GET as factory empty.
data mtjade1_j3_media_incident_receipt_path: NonEmptyStr = "artifacts/bmc/mtjade1-j3-media-attempt-192.168.1.246-20261006T185027Z/SEQUENCE.txt"

data mtjade1_j3_media_incident_receipt_sha256: NonEmptyStr = "4c4ee841706d0f2f0e5e938974725917c3286301d61f676b619b0aa9d41b8735"

data mtjade1_j3_before_general_path: NonEmptyStr = "artifacts/bmc/mtjade1-j3-media-attempt-192.168.1.246-20261006T185027Z/before_general.json"

data mtjade1_j3_before_general_sha256: NonEmptyStr = "3ecfab34e466d2703363cd1b3627ff67f56761b3ccc593e9ae600e878e3eab43"

data mtjade1_j3_restore_get_path: NonEmptyStr = "artifacts/bmc/mtjade1-j3-media-attempt-192.168.1.246-20261006T185027Z/restore_get.response.json"

data mtjade1_j3_restore_get_sha256: NonEmptyStr = "6224acb47db9ce08dcc027b51e45ae2bb8334888f5adcab27aebe87f821753a5"

data mtjade1_j3_restore_put_request_path: NonEmptyStr = "artifacts/bmc/mtjade1-j3-media-attempt-192.168.1.246-20261006T185027Z/restore_put.request.json"

data mtjade1_j3_restore_put_request_sha256: NonEmptyStr = "479250885100b7267326306280c7015631a3899e0b4a7817d4873934957c5b3a"

data mtjade1_j3_restore_put_response_path: NonEmptyStr = "artifacts/bmc/mtjade1-j3-media-attempt-192.168.1.246-20261006T185027Z/restore_put.response.json"

data mtjade1_j3_restore_put_response_sha256: NonEmptyStr = "3ecfab34e466d2703363cd1b3627ff67f56761b3ccc593e9ae600e878e3eab43"

type RmediaPathOrigin
  = StickyAfterEmptyBefore {
      before_path: NonEmptyStr
      before_sha256: NonEmptyStr
      incident_receipt_path: NonEmptyStr
      incident_receipt_sha256: NonEmptyStr
    }
  | FactoryEmpty {
      before_path: NonEmptyStr
      before_sha256: NonEmptyStr
    }

type RmediaGeneralResidue {
  subject: NonEmptyStr
  origin: RmediaPathOrigin
  share: MegaRacObservedShare
  get_capture_path: NonEmptyStr
  get_capture_sha256: NonEmptyStr
}

type RmediaGeneralResidueGap
  = ResidueCaptureUnreadable { error: String }
  | ResidueDigestMismatch { expected: NonEmptyStr, observed: String }
  | ResidueJsonUnreadable { gap: String }
  | ResidueShareIncomplete { role: NonEmptyStr, share: MegaRacObservedShare }
  | ResidueCaptureHttpNotSuccess { trailer: String }
  | ResidueManagerUnread { cause: String }
  | ResiduePutEchoOrPersistMismatch { cause: String }

type RmediaGeneralResidueStanding
  = RmediaGeneralResidueObserved { residue: RmediaGeneralResidue }
  | RmediaGeneralResidueRefused { gap: RmediaGeneralResidueGap }

type ObservedShareRead
  = ObservedShareHeld { share: MegaRacObservedShare }
  | ObservedShareRefused { gap: RmediaGeneralResidueGap }

type MediaGeneralCaptureBody
  = MediaGeneralJsonBody { json: String }
  | MediaGeneralCaptureTrailerUnread { trailer: String }
  | MediaGeneralCaptureHttpFailed { trailer: String }

fn media_general_nonempty_lines(content: String) -> List<String> {
  split(s: content, delimiter: "\n") |> filter(l => trim(l) != "")
}

fn http_trailer_is_success(trailer: String) -> Bool {
  let t = trim(trailer)
  t == "HTTP_CODE:200" || t == "HTTP:200"
}

fn media_general_capture_body(content: String) -> MediaGeneralCaptureBody {
  let lines = media_general_nonempty_lines(content: content)
  if length(lines) == 1 {
    match lines.first() {
      Absent => MediaGeneralCaptureTrailerUnread { trailer: "" }
      Present { value: json } => MediaGeneralJsonBody { json: json }
    }
  } else {
    if length(lines) == 2 {
      match lines.first() {
        Absent => MediaGeneralCaptureTrailerUnread { trailer: "" }
        Present { value: json } => {
          let trailer = match lines.skip(n: 1).first() {
            Absent => ""
            Present { value: t } => t
          }
          if http_trailer_is_success(trailer: trailer) {
            MediaGeneralJsonBody { json: json }
          } else {
            if starts_with(trim(trailer), "HTTP") {
              MediaGeneralCaptureHttpFailed { trailer: trailer }
            } else {
              MediaGeneralCaptureTrailerUnread { trailer: trailer }
            }
          }
        }
      }
    } else {
      MediaGeneralCaptureTrailerUnread { trailer: join(lines, "\n") }
    }
  }
}

fn digest_held(content: String, expected: NonEmptyStr) -> RmediaGeneralResidueGap? {
  let observed = sha256_hex_of_text(text: content)
  if observed == (expected as String) {
    none
  } else {
    Present { value: ResidueDigestMismatch { expected: expected, observed: observed } }
  }
}

fn share_is_completely_empty(s: MegaRacObservedShare) -> Bool {
  s.server_address == ""
    && s.source_path == ""
    && s.share_type == ""
    && s.mount_cd == "0"
    && s.remote_media_support == "0"
}

fn share_is_complete_occupied(s: MegaRacObservedShare) -> Bool {
  s.server_address != "" && s.source_path != "" && s.share_type != ""
}

fn observed_share_of_capture(content: String, expected_sha256: NonEmptyStr) -> ObservedShareRead {
  match digest_held(content: content, expected: expected_sha256) {
    Present { value: g } => ObservedShareRefused { gap: g }
    Absent =>
      match media_general_capture_body(content: content) {
        MediaGeneralCaptureTrailerUnread { trailer: t } => ObservedShareRefused { gap: ResidueJsonUnreadable { gap: concat("unread media/general trailer: ", t) } }
        MediaGeneralCaptureHttpFailed { trailer: t } => ObservedShareRefused { gap: ResidueCaptureHttpNotSuccess { trailer: t } }
        MediaGeneralJsonBody { json: json } =>
          match observe_media_general_share(body: json) {
            MediaGeneralShareUnreadable { detail: d } => ObservedShareRefused { gap: ResidueJsonUnreadable { gap: d } }
            MediaGeneralShareObserved { observed: s } => ObservedShareHeld { share: s }
          }
      }
  }
}

fn decode_rmedia_general_residue(
  before_content: String,
  before_sha256: NonEmptyStr,
  get_content: String,
  get_sha256: NonEmptyStr,
  sequence_content: String,
  sequence_sha256: NonEmptyStr,
  before_path: NonEmptyStr,
  get_path: NonEmptyStr,
  incident_path: NonEmptyStr,
) -> RmediaGeneralResidueStanding {
  match digest_held(content: sequence_content, expected: sequence_sha256) {
    Present { value: g } => RmediaGeneralResidueRefused { gap: g }
    Absent =>
      match observed_share_of_capture(content: before_content, expected_sha256: before_sha256) {
        ObservedShareRefused { gap: g } => RmediaGeneralResidueRefused { gap: g }
        ObservedShareHeld { share: before } =>
          match observed_share_of_capture(content: get_content, expected_sha256: get_sha256) {
            ObservedShareRefused { gap: g } => RmediaGeneralResidueRefused { gap: g }
            ObservedShareHeld { share: get } =>
              if !share_is_completely_empty(s: before) {
                RmediaGeneralResidueRefused { gap: ResidueShareIncomplete { role: "before" as NonEmptyStr, share: before } }
              } else {
                if share_is_completely_empty(s: get) {
                  RmediaGeneralResidueObserved {
                    residue: RmediaGeneralResidue {
                      subject: "mtjade1",
                      origin: FactoryEmpty { before_path: before_path, before_sha256: before_sha256 },
                      share: get,
                      get_capture_path: get_path,
                      get_capture_sha256: get_sha256,
                    },
                  }
                } else {
                  if share_is_complete_occupied(s: get) {
                    RmediaGeneralResidueObserved {
                      residue: RmediaGeneralResidue {
                        subject: "mtjade1",
                        origin: StickyAfterEmptyBefore {
                          before_path: before_path,
                          before_sha256: before_sha256,
                          incident_receipt_path: incident_path,
                          incident_receipt_sha256: sequence_sha256,
                        },
                        share: get,
                        get_capture_path: get_path,
                        get_capture_sha256: get_sha256,
                      },
                    }
                  } else {
                    RmediaGeneralResidueRefused { gap: ResidueShareIncomplete { role: "after" as NonEmptyStr, share: get } }
                  }
                }
              }
          }
      }
  }
}

fn read_mtjade1_rmedia_general_residue() -> RmediaGeneralResidueStanding uses fs: std.resources.Filesystem {
  let before_read = Filesystem.Read(path: mtjade1_j3_before_general_path as String)
  match filesystem_read_outcome(content: before_read.content, success: before_read.success, error: before_read.error) {
    FilesystemReadRefused { error: e } => RmediaGeneralResidueRefused { gap: ResidueCaptureUnreadable { error: e } }
    FilesystemReadSucceeded { content: before_text } => {
      let get_read = Filesystem.Read(path: mtjade1_j3_restore_get_path as String)
      match filesystem_read_outcome(content: get_read.content, success: get_read.success, error: get_read.error) {
        FilesystemReadRefused { error: e } => RmediaGeneralResidueRefused { gap: ResidueCaptureUnreadable { error: e } }
        FilesystemReadSucceeded { content: get_text } => {
          let seq_read = Filesystem.Read(path: mtjade1_j3_media_incident_receipt_path as String)
          match filesystem_read_outcome(content: seq_read.content, success: seq_read.success, error: seq_read.error) {
            FilesystemReadRefused { error: e } => RmediaGeneralResidueRefused { gap: ResidueCaptureUnreadable { error: e } }
            FilesystemReadSucceeded { content: seq_text } =>
              decode_rmedia_general_residue(
                before_content: before_text,
                before_sha256: mtjade1_j3_before_general_sha256,
                get_content: get_text,
                get_sha256: mtjade1_j3_restore_get_sha256,
                sequence_content: seq_text,
                sequence_sha256: mtjade1_j3_media_incident_receipt_sha256,
                before_path: mtjade1_j3_before_general_path,
                get_path: mtjade1_j3_restore_get_path,
                incident_path: mtjade1_j3_media_incident_receipt_path,
              )
          }
        }
      }
    }
  }
}

// PUT /api/settings/media/general: the standing is echo-versus-persist, not a named share. Firmware
// is the Manager capture's FirmwareVersion. Evidence is the restore PUT request, its echoed
// response, and the GET; not a MegaRacVirtualMediaAttach receipt.
type MediaGeneralPutApplyStanding
  = PutAcknowledgedNotApplied {
      firmware_wire: NonEmptyStr
      requested: MegaRacObservedShare
      persisted: MegaRacObservedShare
      request_path: NonEmptyStr
      request_sha256: NonEmptyStr
      response_path: NonEmptyStr
      response_sha256: NonEmptyStr
      get_path: NonEmptyStr
      get_sha256: NonEmptyStr
    }
  | PutApplyUnread { gap: RmediaGeneralResidueGap }

fn put_apply_standing_of(
  firmware_wire: NonEmptyStr,
  requested: MegaRacObservedShare,
  echoed: MegaRacObservedShare,
  persisted: MegaRacObservedShare,
  request_path: NonEmptyStr,
  request_sha256: NonEmptyStr,
  response_path: NonEmptyStr,
  response_sha256: NonEmptyStr,
  get_path: NonEmptyStr,
  get_sha256: NonEmptyStr,
) -> MediaGeneralPutApplyStanding {
  if echoed.server_address != requested.server_address || echoed.source_path != requested.source_path {
    PutApplyUnread { gap: ResiduePutEchoOrPersistMismatch { cause: "PUT response did not echo the request share" } }
  } else {
    if persisted.server_address == requested.server_address && persisted.source_path == requested.source_path {
      PutApplyUnread { gap: ResiduePutEchoOrPersistMismatch { cause: "GET matched the request share, so persist was not refused" } }
    } else {
      PutAcknowledgedNotApplied {
        firmware_wire: firmware_wire,
        requested: requested,
        persisted: persisted,
        request_path: request_path,
        request_sha256: request_sha256,
        response_path: response_path,
        response_sha256: response_sha256,
        get_path: get_path,
        get_sha256: get_sha256,
      }
    }
  }
}

fn firmware_wire_of_current_manager(read: CurrentManagerRead) -> NonEmptyStr? {
  match read.identity.decoded {
    RecordedManagerRefused { gap: g } => none
    RecordedManagerDecoded { observation: o } =>
      if o.firmware_version == "" {
        none
      } else {
        Present { value: o.firmware_version as NonEmptyStr }
      }
  }
}

fn read_mtjade1_media_general_put_standing() -> MediaGeneralPutApplyStanding uses fs: std.resources.Filesystem {
  match firmware_wire_of_current_manager(read: read_mtjade1_current_manager_read()) {
    Absent => PutApplyUnread { gap: ResidueManagerUnread { cause: "current Manager capture did not yield FirmwareVersion" } }
    Present { value: fw } => {
      let req = Filesystem.Read(path: mtjade1_j3_restore_put_request_path as String)
      match filesystem_read_outcome(content: req.content, success: req.success, error: req.error) {
        FilesystemReadRefused { error: e } => PutApplyUnread { gap: ResidueCaptureUnreadable { error: e } }
        FilesystemReadSucceeded { content: req_text } =>
          match observed_share_of_capture(content: req_text, expected_sha256: mtjade1_j3_restore_put_request_sha256) {
            ObservedShareRefused { gap: g } => PutApplyUnread { gap: g }
            ObservedShareHeld { share: requested } => {
              let resp = Filesystem.Read(path: mtjade1_j3_restore_put_response_path as String)
              match filesystem_read_outcome(content: resp.content, success: resp.success, error: resp.error) {
                FilesystemReadRefused { error: e } => PutApplyUnread { gap: ResidueCaptureUnreadable { error: e } }
                FilesystemReadSucceeded { content: resp_text } =>
                  match observed_share_of_capture(content: resp_text, expected_sha256: mtjade1_j3_restore_put_response_sha256) {
                    ObservedShareRefused { gap: g } => PutApplyUnread { gap: g }
                    ObservedShareHeld { share: echoed } => {
                      let get = Filesystem.Read(path: mtjade1_j3_restore_get_path as String)
                      match filesystem_read_outcome(content: get.content, success: get.success, error: get.error) {
                        FilesystemReadRefused { error: e } => PutApplyUnread { gap: ResidueCaptureUnreadable { error: e } }
                        FilesystemReadSucceeded { content: get_text } =>
                          match observed_share_of_capture(content: get_text, expected_sha256: mtjade1_j3_restore_get_sha256) {
                            ObservedShareRefused { gap: g } => PutApplyUnread { gap: g }
                            ObservedShareHeld { share: persisted } =>
                              put_apply_standing_of(
                                firmware_wire: fw,
                                requested: requested,
                                echoed: echoed,
                                persisted: persisted,
                                request_path: mtjade1_j3_restore_put_request_path,
                                request_sha256: mtjade1_j3_restore_put_request_sha256,
                                response_path: mtjade1_j3_restore_put_response_path,
                                response_sha256: mtjade1_j3_restore_put_response_sha256,
                                get_path: mtjade1_j3_restore_get_path,
                                get_sha256: mtjade1_j3_restore_get_sha256,
                              )
                          }
                      }
                    }
                  }
              }
            }
          }
      }
    }
  }
}
