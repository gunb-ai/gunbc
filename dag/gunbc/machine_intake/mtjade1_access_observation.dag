module gunbc.machine_intake_mtjade1_access_observation

import gunbc.machine_intake_bmc_first_contact_standing {
  BmcFirmwareFamilyStanding,
  FamilyUnobserved,
}
import gunbc.machine_intake_subject {
  BoardSerialAbsent,
  UnitKeyRefused,
  UnitKeyStanding,
}
import gunbc.secret_provision { mtjade1_bmc_gunbc_secret_ref }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import extdeps.ampere.mt_jade_getting_started_guide.chassis {
  GsgRearManagementEthernet,
  GsgUnstated,
  mt_jade_gsg_bmc_ethernet_port,
  mt_jade_gsg_rail_kit_part_number,
}

// MT. JADE UNIT 1 BMC ACCESS, AND NOTHING HERE IS A LIVE READING. The operator has AC and a BMC
// in standby; this module does not invent a host, serial, firmware family, or BaseboardModel arm.
// Identity stays on extdeps.ocp.mt_jade until a FRU/SMBIOS join is captured. There is no
// UnitIdentityInputs row, because that type requires a host and we do not have one. The standing
// is the same UnitKeyStanding bind_unit_key returns for an empty observation list
// (BoardSerialAbsent) — not a Jade-only one-arm type (review 67792).

data mtjade1_firmware_family_standing: BmcFirmwareFamilyStanding = FamilyUnobserved {
  discriminator: "Wiwynn SV328R / OCP Mt. Jade cites MegaRAC or OpenBMC. This unit has no bound mc-info, Redfish Manager, or OEM fingerprint capture.",
}

data mtjade1_unit_key_standing: UnitKeyStanding = UnitKeyRefused {
  cause: BoardSerialAbsent,
}

data mtjade1_bmc_ethernet: GsgRearManagementEthernet = mt_jade_gsg_bmc_ethernet_port

data mtjade1_rail_kit_part_number: GsgUnstated = mt_jade_gsg_rail_kit_part_number

// Locus is reserved and off the accessor roster until the secret exists. Mint after a wet
// ProbeServiceRoot blob binds FamilyObserved, then the first rotation — not before.
type JadeManagedBmcSecretStanding
  = SecretLocusReservedNotOnAccessorRoster { ref: SecretRef }

data mtjade1_managed_bmc_secret_standing: JadeManagedBmcSecretStanding = SecretLocusReservedNotOnAccessorRoster {
  ref: mtjade1_bmc_gunbc_secret_ref,
}
