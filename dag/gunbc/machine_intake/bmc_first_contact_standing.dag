module gunbc.machine_intake_bmc_first_contact_standing

import std.types { Bool, NonEmptyStr }
import extdeps.bmc.endpoint { BmcFirmwareFamily, OpenBmc, AmiMegaRac }

// INTAKE FIRST CONTACT IS FAMILY-NEUTRAL. gunbc.tools.bmc_first_contact writes the OpenBMC factory
// login and calls authenticated GetSystem. That is the srv1/srv2 OpenBMC path. It is not the
// producer for an unknown used machine: Mt. Collins had no Redfish, and Mt. Jade cites MegaRAC or
// OpenBMC until the controller answers. Transport presence (HTTPS, Redfish JSON, IPMI) is not a
// family. Matching discriminator prose is not a family either.

type BmcFirmwareFamilyStanding
  = FamilyObserved { family: BmcFirmwareFamily }
  | FamilyUnobserved { discriminator: NonEmptyStr }

fn bmc_firmware_family_from_redfish_presence(redfish_service_root_admitted: Bool) -> BmcFirmwareFamilyStanding {
  FamilyUnobserved {
    discriminator: "Redfish service-root presence or absence does not identify OpenBMC versus MegaRAC",
  }
}

fn bmc_intake_may_use_openbmc_factory_login(family: BmcFirmwareFamilyStanding) -> Bool {
  match family {
    FamilyObserved { family: OpenBmc } => true
    FamilyObserved { family: AmiMegaRac } => false
    FamilyUnobserved { discriminator: _ } => false
  }
}

fn bmc_intake_may_use_megarac_media_attach(family: BmcFirmwareFamilyStanding) -> Bool {
  match family {
    FamilyObserved { family: AmiMegaRac } => true
    FamilyObserved { family: OpenBmc } => false
    FamilyUnobserved { discriminator: _ } => false
  }
}
