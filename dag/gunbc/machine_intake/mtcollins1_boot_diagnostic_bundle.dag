// THE DIAGNOSTIC BUNDLE OF ONE mtcollins1 BOOT ATTEMPT: what the BMC and the pre-OS console
// said about the machine around the attempt, recorded on every terminal arm so that a remote
// operator can diagnose a failed or degraded boot from the run's artifact alone (operator,
// 2026-09-23: run 35793279839 came up with socket 1 absent and nothing in its receipts said why).
//
// DESIGN section 3b, observability row, and the four responsibilities it names. The owning
// domains establish the facts: the SEL record formats are extdeps.bmc.ipmi_sel and their
// before/after reading is gunbc.machine_intake_sel_stimulus_listener; the per-slot and
// per-socket inventory is extdeps.bmc.redfish_memory_inventory; the firmware's pre-OS statement
// is gunbc.machine_intake_pre_os_bringup_verdict firmware_console_report. This module is the
// observation model of ONE attempt (MtCollins1BootDiagnosticBundle), and mtcollins1_boot_bundle_text
// renders it. It does not decode anything those authorities do not.
//
// THE BUNDLE NEVER DECIDES THE VERDICT (brief, and DESIGN section 5's separation of observation
// from judgment). mtcollins1_boot_outcome_with_findings only appends what was found to a refusal
// reason. WHAT WAS FOUND IS TYPED, TWO WAYS: what the MACHINE did is the power-on fold's
// PowerOnAccount (gunbc.machine_intake_mtcollins1_power_on_account; docs/plans/power-on-sequence-model.md),
// and what OUR HARNESS did -- media, handoff, override, power after, the BMC's reachability, the
// credential -- is a HarnessFinding. Neither is a list of strings. It never turns a success into a failure or a failure into a success, and the witness
// asserts both directions.
//
// A READ THAT FAILS IS A TYPED, LOCATED READING IN THE BUNDLE, NEVER A MISSING SECTION (DESIGN
// section 5). Every section has an arm for "read", one for "the read failed, and why, at which
// endpoint, at what instant", and one for "the attempt ended before this could be read, and
// why". A BMC that does not answer (operator, 2026-09-23: 192.168.1.228 unreachable after a DIMM
// reseat) is itself a diagnosis, so it has its own arm.
// WHY A BMC READ FAILED. Every arm carries the endpoint it addressed and the instant of the
// attempt. The transport's own exit code and stderr are the evidence: curl 6/7 (name not
// resolved, connection refused or host unreachable), curl 28 (timeout), curl 22 with an HTTP
// 401/403 on stderr (authentication refused). ipmitool's lanplus session setup CANNOT tell an
// unreachable controller from one that refused the credential: both render "Unable to establish
// IPMI v2 / RMCP+ session". So that reading is BmcSessionUnestablished and is not split into
// either, which would be a guess (DESIGN section 4d).
type BmcReadCause
  = BmcUnreachable { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcTimeout { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcAuthRefused { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcSessionUnestablished { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcHttpRefused { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcReadFailed { endpoint: NonEmptyStr, at: NonEmptyStr, exit_code: Int, detail: String }
  | BmcResponseMalformed { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcCredentialUnavailable { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcCollectionIncomplete { endpoint: NonEmptyStr, at: NonEmptyStr, detail: String }
  | BmcDeadlineReached { endpoint: NonEmptyStr, at: NonEmptyStr, not_reached: String }
  | BmcLinkUnpublished { endpoint: NonEmptyStr, at: NonEmptyStr, property: NonEmptyStr }

fn bmc_read_cause_text(cause: BmcReadCause) -> String {
  match cause {
    BmcUnreachable { endpoint: e, at: a, detail: d } => concat("BMC unreachable at ", e as String, " (", a as String, "): ", d)
    BmcTimeout { endpoint: e, at: a, detail: d } => concat("BMC timed out at ", e as String, " (", a as String, "): ", d)
    BmcAuthRefused { endpoint: e, at: a, detail: d } => concat("BMC refused the credential at ", e as String, " (", a as String, "): ", d)
    BmcSessionUnestablished { endpoint: e, at: a, detail: d } => concat("no IPMI session at ", e as String, " (", a as String, "; unreachable and credential-refused are indistinguishable on this transport): ", d)
    BmcHttpRefused { endpoint: e, at: a, detail: d } => concat("BMC answered with an HTTP error at ", e as String, " (", a as String, "): ", d)
    BmcReadFailed { endpoint: e, at: a, exit_code: c, detail: d } => concat("BMC read failed at ", e as String, " (", a as String, ", exit ", to_string(c), "): ", d)
    BmcResponseMalformed { endpoint: e, at: a, detail: d } => concat("BMC response unreadable at ", e as String, " (", a as String, "): ", d)
    BmcCredentialUnavailable { endpoint: e, at: a, detail: d } => concat("no credential could be presented to ", e as String, " (", a as String, "): ", d)
    BmcCollectionIncomplete { endpoint: e, at: a, detail: d } => concat("collection incomplete at ", e as String, " (", a as String, "): ", d)
    BmcDeadlineReached { endpoint: e, at: a, not_reached: n } => concat("diagnostics read budget spent before ", e as String, " (", a as String, "); not reached: ", n)
    BmcLinkUnpublished { endpoint: e, at: a, property: p } => concat("the resource at ", e as String, " (", a as String, ") publishes no ", p as String, " link, so nothing beyond it was requested")
  }
}

// A CAUSE THAT DEFINITIVELY SAYS THE BMC DID NOT ANSWER: the transport established that nothing
// answered at all or in time. BmcSessionUnestablished is NOT one: ipmitool renders an unreachable
// controller and a refused credential identically. Nor is any cause that carries an answer (an
// HTTP status, a malformed body, an incomplete collection) or that no read was made for.
fn bmc_read_cause_is_definitive_no_answer(cause: BmcReadCause) -> Bool {
  match cause {
    BmcUnreachable { endpoint: _, at: _, detail: _ } => true
    BmcTimeout { endpoint: _, at: _, detail: _ } => true
    BmcAuthRefused { endpoint: _, at: _, detail: _ } => false
    BmcSessionUnestablished { endpoint: _, at: _, detail: _ } => false
    BmcHttpRefused { endpoint: _, at: _, detail: _ } => false
    BmcReadFailed { endpoint: _, at: _, exit_code: _, detail: _ } => false
    BmcResponseMalformed { endpoint: _, at: _, detail: _ } => false
    BmcCredentialUnavailable { endpoint: _, at: _, detail: _ } => false
    BmcCollectionIncomplete { endpoint: _, at: _, detail: _ } => false
    BmcDeadlineReached { endpoint: _, at: _, not_reached: _ } => false
    BmcLinkUnpublished { endpoint: _, at: _, property: _ } => false
  }
}

fn bmc_read_cause_kind(cause: BmcReadCause) -> String {
  match cause {
    BmcUnreachable { endpoint: _, at: _, detail: _ } => "unreachable"
    BmcTimeout { endpoint: _, at: _, detail: _ } => "timed out"
    BmcAuthRefused { endpoint: _, at: _, detail: _ } => "credential refused"
    BmcSessionUnestablished { endpoint: _, at: _, detail: _ } => "no IPMI session (unreachable and credential-refused are indistinguishable)"
    BmcHttpRefused { endpoint: _, at: _, detail: _ } => "answered with an HTTP error"
    BmcReadFailed { endpoint: _, at: _, exit_code: _, detail: _ } => "read failed"
    BmcResponseMalformed { endpoint: _, at: _, detail: _ } => "answered unreadably"
    BmcCredentialUnavailable { endpoint: _, at: _, detail: _ } => "no credential presented"
    BmcCollectionIncomplete { endpoint: _, at: _, detail: _ } => "collection incomplete"
    BmcDeadlineReached { endpoint: _, at: _, not_reached: _ } => "read budget spent"
    BmcLinkUnpublished { endpoint: _, at: _, property: _ } => "link unpublished"
  }
}

// THE AGGREGATE OVER BMC READS THAT ALL FAILED. "The BMC did not answer" is said only when EVERY
// cause is a definitive no-answer; otherwise each distinct kind is named, so an ambiguous IPMI
// session failure beside a Redfish timeout reads as exactly that and not as a verdict on the BMC.
fn bmc_all_failed_text(failed: List<BmcChannelRead>) -> String {
  let causes = flat_map(failed, r => match channel_cause(r: r) { Present { value: c } => [c] Absent => [] })
  let channels = concat("; failed channels: ", join(map(failed, r => r.channel as String), ", "))
  let empty: List<String> = []
  let kinds = fold(map(causes, c => bmc_read_cause_kind(cause: c)), init: empty, f: (acc, k) => if any(acc, j => j == k) { acc } else { concat(acc, [k]) })
  let first = match causes.first() { Absent => "" Present { value: c } => bmc_read_cause_text(cause: c) }
  if all(causes, c => bmc_read_cause_is_definitive_no_answer(cause: c)) {
    concat("every BMC read failed and the BMC did not answer; first: ", first, channels)
  } else {
    concat("every BMC read failed (", join(kinds, "; "), "); first: ", first, channels)
  }
}

fn first_line(s: String) -> String {
  match filter(map(split(s: s, delimiter: "\n"), l => trim(l)), l => l != "").first() {
    Absent => ""
    Present { value: l } => l
  }
}

fn bmc_curl_read_cause(endpoint: NonEmptyStr, at: NonEmptyStr, exit_code: Int, stderr: String) -> BmcReadCause {
  let detail = first_line(s: stderr)
  if exit_code == 6 || exit_code == 7 {
    BmcUnreachable { endpoint: endpoint, at: at, detail: detail }
  } else if exit_code == 28 {
    BmcTimeout { endpoint: endpoint, at: at, detail: detail }
  } else if exit_code == 22 && (string_contains(s: stderr, pattern: "error: 401") || string_contains(s: stderr, pattern: "error: 403")) {
    BmcAuthRefused { endpoint: endpoint, at: at, detail: detail }
  } else if exit_code == 22 {
    BmcHttpRefused { endpoint: endpoint, at: at, detail: detail }
  } else {
    BmcReadFailed { endpoint: endpoint, at: at, exit_code: exit_code, detail: detail }
  }
}

// ipmitool's lanplus renderings, as its source prints them: "RAKP 2 HMAC is invalid" and
// "Unauthorized name" come from the RAKP exchange rejecting the credential, and "Insufficient
// privilege level" is completion code D4h. Anything that failed to set up a session without one
// of those is BmcSessionUnestablished.
fn bmc_ipmitool_read_cause(endpoint: NonEmptyStr, at: NonEmptyStr, exit_code: Int, stderr: String) -> BmcReadCause {
  let detail = first_line(s: stderr)
  if exit_code == coreutils_timeout_expired_exit_code {
    BmcTimeout { endpoint: endpoint, at: at, detail: concat("no answer within the diagnostics deadline (coreutils timeout exit 124)", if detail == "" { "" } else { concat("; ", detail) }) }
  } else {
    match bmc_ipmitool_session_cause(endpoint: endpoint, at: at, stderr: stderr) {
      Present { value: c } => c
      Absent => BmcReadFailed { endpoint: endpoint, at: at, exit_code: exit_code, detail: detail }
    }
  }
}

// The session-setup half of that reading, which needs no exit code: a backgrounded collector
// (gunbc.machine_intake_sol_hold) has no exit status the workflow can read, only the lines it wrote.
fn bmc_ipmitool_session_cause(endpoint: NonEmptyStr, at: NonEmptyStr, stderr: String) -> BmcReadCause? {
  let detail = first_line(s: stderr)
  if string_contains(s: stderr, pattern: "RAKP 2 HMAC is invalid") || string_contains(s: stderr, pattern: "Unauthorized name") || string_contains(s: stderr, pattern: "Insufficient privilege level") {
    Present { value: BmcAuthRefused { endpoint: endpoint, at: at, detail: detail } }
  } else if string_contains(s: stderr, pattern: "Unable to establish IPMI v2") {
    Present { value: BmcSessionUnestablished { endpoint: endpoint, at: at, detail: detail } }
  } else {
    none
  }
}

// ONE SEL SNAPSHOT: the raw `sel elist` rows as the controller rendered them, or why there are none.
type SelSnapshotReading
  = SelSnapshotRead { raw: String, at: NonEmptyStr }
  | SelSnapshotUnread { cause: BmcReadCause }
  | SelSnapshotNotTaken { reason: NonEmptyStr }

// THE LOCAL SDR CACHE BOTH SEL SNAPSHOTS READ THROUGH (extdeps.bmc.ipmi SdrDumpAuthenticated): it
// is dumped once, before the boot, so the post-boot `sel elist` does not re-read the whole SDR
// repository from a controller that has just been power-cycled. A dump that failed is recorded with
// its cause and both snapshots then read uncached; it is a slower read, never a missing section.
type SdrCacheReading
  = SdrCacheDumped { path: NonEmptyStr, at: NonEmptyStr }
  | SdrCacheUnread { cause: BmcReadCause }
  | SdrCacheNotTaken { reason: NonEmptyStr }

// THE BMC'S SENSOR TABLE, read once after the boot through the same SDR cache the SEL snapshots
// use (extdeps.bmc.ipmi SdrElistAuthenticatedCached). THIS IS THE IPMI-ONLY PER-SOCKET CHANNEL:
// gunbc.machine_intake_mtcollins1_access_observation records that this MegaRAC answers 404 at the
// Redfish service root itself, so the inventory section may legitimately come back refused on
// every attempt, and a socket's rails and temperatures must still be readable. Each line is kept
// decoded or unstructured (extdeps.bmc.ipmi_sdr), never dropped. Without a dumped cache the read
// is not made, and the reading says why: an uncached `sdr elist` re-reads the whole repository
// from a controller that has just been power-cycled, the cost the cache exists to avoid.
type SensorReading
  = SensorsRead { lines: List<SdrLineResult>, at: NonEmptyStr }
  | SensorsUnread { cause: BmcReadCause }
  | SensorsNotTaken { reason: NonEmptyStr }

// THE SMpro BOOT-STAGE PASS (gunbc.machine_intake_ampere_smpro_observation, read through the managed host's subject). The bundle's own
// pass is taken after the attempt; the run record below carries the two passes taken while power
// was established on. Its probes are kept whole, every one with its raw observation, including when none of
// them was answered: the dossier is rendered for any outcome list.
type SmproReading
  = SmproProbed { observation: SmproPassObservation }
  | SmproNotTaken { reason: NonEmptyStr }

type MembersReading<T>
  = MembersRead { members: List<T> }
  | MembersUnread { cause: BmcReadCause }
  | MembersNotTaken { reason: NonEmptyStr }

// THE BMC'S OWN INVENTORY. `credential_removed` is carried because the per-attempt netrc that
// authenticated the reads must be shredded, and a shred that failed is a standing exposure this
// attempt created, which the bundle states rather than hides.
type InventoryReading {
  system_id: String
  memory: MembersReading<RedfishMemoryMember>
  processors: MembersReading<RedfishProcessorMember>
  credential_removed: Bool
}

// THE PRE-OS CONSOLE. The SOL capture is the firmware's training and POST output before any
// kernel, and it is retained by the workflow's upload of mtcollins1_boot_artifact_glob, which
// covers it only if it lives there. The bound is a policy row on artifact size, OBSERVED here:
// the collector itself does not truncate, so a capture over the bound is reported, not clipped.
// THE SIZE IS THE FILE'S BYTE COUNT FROM stat(1) (extdeps.tools.coreutils_stat PathSize), never the
// length of the String read from it: a String's length counts Unicode scalar values, and calling
// those bytes would under-count multi-byte console output. The size is taken before the content is
// read, so a capture over the bound is reported without being loaded.
type ConsoleReading
  = ConsoleRetained { path: NonEmptyStr, size: ByteSize, lines: Int, firmware: FirmwareConsoleReport, firmware_error_lines: Int, capture_digest: Sha256FileDigest, dram: AmpereDramConsoleObservation, checkpoints: AmpereCheckpointConsoleObservation, checkpoint_relations: List<AmpereCheckpointRelation>, milestones: ConsoleMilestoneObservation, sockets: AmpereSocketConsoleObservation, against_reference: AmpereSocketReferenceComparison, loader: GrubConsoleReport, linux: LinuxBootConsoleObservation, modules: KernelModuleDecompressionObservation, nvparam: NvParamConsoleObservation, span_readings: List<SpanConsoleReading> }
  | ConsoleExceedsBound { path: NonEmptyStr, size: ByteSize, bound: ByteSize }
  | ConsoleNotRetained { path: NonEmptyStr }
  | ConsoleUnread { path: NonEmptyStr, detail: String }
  | ConsoleNotConfigured

data mtcollins1_boot_console_bound: ByteSize = byte_size(count: 16777216)

// WHICH ATTEMPT THIS BUNDLE BELONGS TO. The attempt is named by the Actions run id; a run whose id
// could not be read carries that as a typed reading with the variable's own detail, never a blank.
type AttemptIdentityReading
  = AttemptRunId { run_id: NonEmptyStr }
  | AttemptIdentityUnavailable { variable: NonEmptyStr, detail: String }

fn attempt_identity_text(a: AttemptIdentityReading) -> String {
  match a {
    AttemptRunId { run_id: r } => r as String
    AttemptIdentityUnavailable { variable: v, detail: d } => concat("UNAVAILABLE: ", v as String, " could not be read: ", d)
  }
}

data mtcollins1_boot_diagnostics_path: String = "artifacts/mtcollins1-boot-diagnostics.txt"

data mtcollins1_boot_retained_artifact_prefix: String = "artifacts/mtcollins1-boot-"

// ── THE ATTEMPT'S OWN RUN RECORD ─────────────────────────────────────────────────────────────
//
// WHAT THIS ATTEMPT DID TO THE UNIT'S POWER AND ITS ONE-SHOT OVERRIDE, AND WHAT THE SOCKETS SAID
// WHILE THEY WERE POWERED. Three facts that the post-attempt reads above cannot establish:
//
// SOCKET-LOCAL READS NEED POWER. The census image ends with `poweroff -f`
// (gunbc.machine_intake_mtcollins1_census_image mtcollins1_census_halt_command), so by the time the
// bundle's own reads run the SMpro may be unpowered and every probe answers nothing. The run takes a
// pass right after the handoff observed power on (gunbc.machine_intake_oob_boot_handoff
// BootControlIssued now carries an observed transition, not an exit code) and a second the first
// time a poll saw the census envelope open. Both are read-only and fold-sequenced exactly as the
// post-attempt pass (gunbc.machine_intake_ampere_smpro_observation smpro_pass_sequenced).
//
// WHETHER THE OVERRIDE WAS CONSUMED BY THIS ATTEMPT. The IPMI boot override is one-shot: the
// controller clears boot parameter 5's valid flag when a boot consumes it, and on its own timeout.
// The handoff verifies the override was set; parameter 5 is read again before the set and after the
// attempt, so an override still pending (the host never booted through it) and one ALREADY pending
// before this attempt set it are told apart from one no longer pending -- and "consumed" is claimed
// only beside the census END marker (boot_override_consumption).
//
// A POWER-OFF AFTER THE CENSUS END MARKER IS THE IMAGE WORKING. Chassis power is read after the
// attempt; off after the END marker is recorded as expected, and the post-attempt SMpro pass is not
// sent at a socket the census deliberately powered down.
type BootParam5Reading
  = BootParam5Read { readback: String, at: NonEmptyStr }
  | BootParam5Unread { cause: BmcReadCause }
  | BootParam5NotTaken { reason: NonEmptyStr }

type BootOverrideConsumption
  = OverrideConsumedByCensusBoot
  | OverrideNoLongerPendingAfterAttempt
  | OverridePendingBeforeAttempt
  | OverrideStillPendingAfterAttempt
  | OverrideNotHandedOff { reason: NonEmptyStr }
  | OverrideConsumptionUnread { reason: NonEmptyStr }

type PowerAfterAttempt
  = PoweredOffAfterCensusEnd
  | PoweredOffWithoutCensusEnd
  | PoweredOnAfterAttempt
  | PowerAfterUnobserved { observation: ChassisPowerObservation }
  | PowerAfterNotTaken { reason: NonEmptyStr }

// ─── THE MEDIA ATTACH, AS THIS ATTEMPT'S RECORD ─────────────────────────────────────────────────
//
// THE HANDOFF IS GATED ON THIS RECORD, AND THE BUNDLE CARRIES THE SAME RECORD (side chat on
// gunbc#12425). What the boot was gated on — which firmware, which intended medium and its verified
// digest, which route, the three indices kept apart, the redirection wire, when, and after how many
// looks — reaches the actuation, the attempt and this bundle as a value, including the refusal and
// timeout arms, never as a bare exit. The power reading the detach admission was taken from is kept
// beside it.
type MtCollins1MediaAttachRecord
  = MediaAttachNotAttempted { reason: NonEmptyStr }
  | MediaAttachAttempted {
      attempt: String,
      medium_image_name: NonEmptyStr,
      medium_image_sha256: NonEmptyStr,
      power: ChassisPowerObservation,
      stale_power_off: StaleMediumPowerOff,
      result: MegaRacAttachResult
    }

// THE POWER-OFF TAKEN SO A STALE CENSUS MEDIUM CAN BE REPLACED, as its own record (run 36683309058:
// a re-run after a repin found the previous boot's image presented and the host on, and the detach
// admission correctly refused). `power` above is then the FRESH reading taken after this power-off,
// the one the admission was given; the reading before it is `before` here. Not needed carries why,
// so an attempt that did not power off says which fact made it unnecessary.
type StaleMediumPowerOff
  = StalePowerOffNotNeeded { reason: NonEmptyStr }
  | StalePowerOffObserved { stale_image: String, before: ChassisPowerObservation }
  | StalePowerOffCommandRefused { stale_image: String, before: ChassisPowerObservation }
  | StalePowerOffNotObserved { stale_image: String, before: ChassisPowerObservation, last: ChassisPowerObservation }

fn stale_power_off_text(record: StaleMediumPowerOff) -> String {
  match record {
    StalePowerOffNotNeeded { reason: r } => concat("no power-off: ", r as String)
    StalePowerOffObserved { stale_image: i, before: b } => join(["powered off (was ", chassis_observation_text(observation: b) as String, ") to replace stale '", i, "', observed off"], "")
    StalePowerOffCommandRefused { stale_image: i, before: _ } => join(["chassis power off for stale '", i, "' was refused by ipmitool"], "")
    StalePowerOffNotObserved { stale_image: i, before: _, last: l } => join(["chassis power off for stale '", i, "' was sent but never observed off; last read ", chassis_observation_text(observation: l) as String], "")
  }
}

fn cd_reading_text(r: CdErrorReading) -> String {
  match r {
    CdErrorRead { code: CdErrorNone } => "0"
    CdErrorRead { code: CdErrorStopReason { status: st, class: k } } => concat(to_string(st.code), concat(" ", stop_reason_text(status: st, class: k)))
    CdErrorRead { code: CdErrorUncatalogued { wire: w } } => concat(to_string(w), " (uncatalogued)")
    CdErrorUnread { detail: d } => concat("UNREAD: ", d)
  }
}

fn raw_read_text(r: MegaRacRawRead) -> String {
  join([
    if r.answered { "answered" } else { "UNANSWERED" },
    " at ", match r.observed_at { Present { value: t } => to_string(t)  Absent => "clock-unreadable" },
    ": ", r.body,
  ], "")
}

fn optional_text(v: String?) -> String {
  match v {
    Present { value: x } => x
    Absent => "absent"
  }
}

fn write_answer_text(a: MegaRacWriteAnswer) -> String {
  match a {
    WriteAccepted { body: b } => concat("accepted: ", b)
    WriteNotIssued { reason: r } => concat("NOT ISSUED: ", r as String)
    WriteAnsweredHttpError { body: b, stderr: e } => concat("answered an HTTP error (complete response): ", concat(b, concat(" / ", e)))
    WriteEffectUncertain { exit_code: x, partial_body: b, stderr: e } => join(["EFFECT UNCERTAIN (curl exit ", to_string(x), ", no complete answer; bytes received: '", b, "'): ", e], "")
  }
}

// THE ROUTE IS RENDERED ON EVERY ARM THAT CARRIES ONE, so an executed stop (with its 1411) and the
// StartMedia answer reach the published artifact whatever refused afterwards (side-chat review
// 5331991982).
fn attach_route_text(route: MegaRacAttachRoute) -> String {
  match route {
    RouteAlreadyPresented => "already presented (no listing consulted, no write)"
    RouteAttached { image_list_index: i, start: st } => join(["attached at image-list index ", i, "; start-media ", write_answer_text(a: st)], "")
    RouteReplaced { image_list_index: i, detach: d, start: st } => join(["replaced (", detach_evidence_text(detach: d), ") then attached at image-list index ", i, "; start-media ", write_answer_text(a: st)], "")
  }
}

fn detach_evidence_text(detach: MegaRacDetachEvidence) -> String {
  join([
    "stopped '", detach.stale_image, "' on media index ", detach.media_index,
    "; stop-media ", write_answer_text(a: detach.command),
    "; configurations read-back ", if detach.readback_read { "read" } else { "UNREAD" }, ": ", detach.readback,
    "; cd_error_code after the stop: ", cd_reading_text(r: detach.cd_after_stop),
    "; general settings after the stop ", raw_read_text(r: detach.general_after_stop),
  ], "")
}

fn presentation_evidence_text(e: MegaRacPresentationEvidence) -> String {
  join([
    "'", e.image_name as String, "' media_index=", optional_text(v: e.media_index),
    " session_index=", optional_text(v: e.session_index),
    " redirection_status=", to_string(e.redirection_wire),
    " established_at=", to_string(e.established_at), " looks=", to_string(e.looks),
    " cd_error_code before any write=", cd_reading_text(r: e.cd_before_any_write),
    " at ready=", cd_reading_text(r: e.cd_at_ready),
    " general settings at ready ", raw_read_text(r: e.general_at_ready),
  ], "")
}

fn readiness_reading_text(r: AttachReadiness) -> String {
  match r {
    ReadinessStarted { row: w } => concat("started, session_index ", optional_text(v: w.session_index))
    ReadinessConnecting { row: w } => concat("connecting (status ", concat(to_string(w.redirection_wire), concat("), session_index ", optional_text(v: w.session_index))))
    ReadinessStartedUnbound { row: w } => concat("started with no bound session, session_index ", optional_text(v: w.session_index))
    ReadinessNotPresented { configurations: c } => concat("not presented: ", c)
    ReadinessUnanswered { detail: d } => concat("configurations GET unanswered: ", d)
    ReadinessUncatalogued { image_name: n, wire: w, configurations: c } => concat("UNCATALOGUED redirection_status ", concat(to_string(w), concat(" on '", concat(n, concat("': ", c)))))
    ReadinessMalformed { detail: d } => concat("MALFORMED configurations: ", d)
    ReadinessDuplicate { configurations: c } => concat("DUPLICATE rows present the image: ", c)
    ReadinessWrongPresentation { image_name: n, configurations: c } => concat("WRONG presentation '", concat(n, concat("': ", c)))
  }
}

fn readiness_look_text(l: ReadinessLook) -> String {
  concat("at ", concat(to_string(l.observed_at), concat(": ", readiness_reading_text(r: l.reading))))
}

// THE ONE AUTHORITY FOR WHAT EACH ATTACH OUTCOME MEANS TO AN OPERATOR; absent only for the ready
// presentation. The gate and this bundle both read it, so the reason a handoff was withheld and
// the reason the bundle records are the same sentence.
fn media_attach_outcome_reason(outcome: MegaRacAttachOutcome) -> String? {
  match outcome {
    MegaRacPresentationReady { route: _, evidence: _ } => none
    MegaRacReadinessTimedOut { image_name: n, route: r, last: l, deadline: d, looks: k, cd_before_any_write: cb, cd_at_refusal: ca } =>
      Present { value: join(["the presentation of '", n as String, "' did not reach Started with a bound session before ", to_string(d), " (", to_string(k), " looks, route: ", attach_route_text(route: r), "); last look ", readiness_look_text(l: l), "; cd_error_code before any write ", cd_reading_text(r: cb), ", at refusal ", cd_reading_text(r: ca), ". No boot-device or power handoff was made"], "") }
    MegaRacReadinessRefused { image_name: n, route: r, look: l, looks: k, cd_before_any_write: cb, cd_at_refusal: ca } =>
      Present { value: join(["the presentation of '", n as String, "' was refused by the readiness policy after ", to_string(k), " looks (route: ", attach_route_text(route: r), "): ", readiness_look_text(l: l), "; cd_error_code before any write ", cd_reading_text(r: cb), ", at refusal ", cd_reading_text(r: ca), ". No boot-device or power handoff was made"], "") }
    MegaRacPresentationStopped { image_name: n, route: r, look: l, looks: k, cd_before_any_write: cb, stop: st, class: c, general_at_refusal: g } =>
      Present { value: join(["the presentation of '", n as String, "' is ", stop_reason_text(status: st, class: c), " after ", to_string(k), " looks (route: ", attach_route_text(route: r), "): ", readiness_look_text(l: l), "; cd_error_code before any write ", cd_reading_text(r: cb), " (general settings ", raw_read_text(r: g), "). No boot-device or power handoff was made"], "") }
    MegaRacReadinessClockUnreadable { image_name: n, route: r, detail: d } =>
      Present { value: join(["the clock could not be read, so the readiness window for '", n as String, "' could not be declared or judged: ", d, " (route: ", attach_route_text(route: r), ")"], "") }
    MegaRacConfigurationsUnreadable { detail: d } =>
      Present { value: concat("the presented-media listing could not be read, so whether anything is attached is UNKNOWN; refusing rather than attaching over an unknown state: ", d) }
    MegaRacShareMismatch { expected: e, observed: o } =>
      Present { value: join([
        "the controller's remote-media share is not this unit's boot share, so no image name read from it can be trusted and nothing was written: expected ",
        e.server_address as String, ":", e.source_path as String, " over ", megarac_share_type_wire(t: e.share_type), " with mount_cd 1, observed ",
        o.server_address, ":", o.source_path, " over ", o.share_type, " with mount_cd ", o.mount_cd,
      ], "") }
    MegaRacPresentationObserved { share: _, readiness: _, cd_error: _, general: _, configurations: _ } =>
      Present { value: "a read-only presentation observation reached an attach decision; observations never attach and never open the handoff" }
    MegaRacShareUnreadable { detail: d } =>
      Present { value: concat("the controller's remote-media share settings could not be read, so which share image names resolve in is UNKNOWN; nothing was written: ", d) }
    MegaRacSessionRefused { detail: d } => Present { value: concat("session refused: ", d) }
    MegaRacSessionTokenUnreadable { detail: d } => Present { value: concat("session succeeded but no CSRFToken could be read from its document: ", d) }
    MegaRacImagesUnreadable { detail: d } => Present { value: concat("images listing unreadable: ", d) }
    MegaRacImageListingEmpty =>
      Present { value: "the image is not presented AND the controller offers no image available to attach, and nothing is presented to stop (stopping is what re-enumerates the share); check that the export is reachable from the controller and holds the file" }
    MegaRacImageListingUnparseable { detail: d } => Present { value: concat("the images listing was not valid JSON: ", d) }
    MegaRacImageOfferedAmbiguously { image_name: n, image_indices: ids } =>
      Present { value: join(["the controller offers '", n as String, "' more than once (image_index ", join(ids, ", "), "), so which file would be attached is the controller's enumeration order; nothing was written"], "") }
    MegaRacImageNotEnumerated { image_name: n } =>
      Present { value: concat("the image is not presented, and the controller offers other images but not '", concat(n as String, "'; nothing is presented to stop, and stopping is what re-enumerates the share, so check that the export holds exactly that file")) }
    MegaRacForeignImagePresented { image_name: n, configurations: c } =>
      Present { value: concat("the controller is presenting '", concat(n, concat("', which is not a census image of this lane; it is not this workflow's to stop, so nothing was written: ", c))) }
    MegaRacSeveralImagesPresented { configurations: c } =>
      Present { value: concat("more than one census image is presented at once, a state never observed on this single-CD unit; nothing was written: ", c) }
    MegaRacStaleDetachNotAdmitted { stale_image: n, reason: why } =>
      Present { value: concat("the stale census image '", concat(n, concat("' is presented and was NOT stopped: ", why as String))) }
    MegaRacStaleDetachUnconfirmed { detach: d, reason: why } =>
      Present { value: concat("the stale census image was not established as detached: ", concat(why as String, concat(" (", concat(detach_evidence_text(detach: d), ")")))) }
    MegaRacRedirectionUncatalogued { image_name: n, wire: w, configurations: c } =>
      Present { value: join(["the row presenting '", n, "' reports redirection_status ", to_string(w), ", which is uncatalogued for this firmware; refusing before any write or power action: ", c], "") }
    MegaRacRefreshClockUnreadable { detail: d, detach: x } => Present { value: join(["the clock could not be read, so the re-enumeration window could not be declared or judged: ", d, " (the detach had been executed: ", detach_evidence_text(detach: x), ")"], "") }
    MegaRacListingUnparseableAfterDetach { detail: d, detach: x } => Present { value: join(["after the stale image was stopped (", detach_evidence_text(detach: x), "), the images listing was not valid JSON: ", d], "") }
    MegaRacOfferedAmbiguouslyAfterDetach { image_name: n, image_indices: ids, detach: x } =>
      Present { value: join(["after the stale image was stopped (", detach_evidence_text(detach: x), "), the controller offers '", n as String, "' more than once (image_index ", join(ids, ", "), "), so which file would be attached is the controller's enumeration order; nothing further was written"], "") }
    MegaRacMediaStateUnestablished { image_name: n, route: r, look: l, looks: k, cd_before_any_write: cb, cd_at_ready: ca, general_at_ready: g } =>
      Present { value: join(["this attempt cannot establish the media state of '", n as String, "': the presentation read Started (", readiness_look_text(l: l), ", ", to_string(k), " looks, route: ", attach_route_text(route: r), ") but cd_error_code before any write was ", cd_reading_text(r: cb), " and at readiness ", cd_reading_text(r: ca), " (general settings ", raw_read_text(r: g), "). A code outside the firmware UI's stop-reason table (extdeps.bmc.megarac megarac_rmedia_status_0_32), or an unread one, has no vendor meaning, so this is a knowledge refusal, not a controller verdict. No boot-device or power handoff was made"], "") }
    MegaRacMediaStateUnestablishedBeforeWrite { cd_before_any_write: cb, reason: why } =>
      Present { value: join(["this attempt cannot establish the media state, and nothing was written: cd_error_code before any write was ", cd_reading_text(r: cb), "; ", why as String], "") }
    MegaRacReadinessClockIncoherent { image_name: n, route: rt, opened_at: o, previous: p, look: l, looks: k } =>
      Present { value: join(["the clock cannot bound the readiness wait for '", n as String, "': window opened at ", to_string(o), ", previous look at ", match p { Present { value: v } => to_string(v)  Absent => "none" }, ", this look ", readiness_look_text(l: l), " after ", to_string(k), " looks (route: ", attach_route_text(route: rt), "). No boot-device or power handoff was made"], "") }
    MegaRacNotEnumeratedAfterRefresh { image_name: n, detach: d, standing: _ } =>
      Present { value: join(["NotEnumeratedAfterRefresh: after the stale image was stopped (", detach_evidence_text(detach: d), "), '", n as String, "' was still not offered within the declared window; check that the export on srv2 holds exactly that file"], "") }
  }
}

fn session_release_text(standing: SessionRelease) -> String {
  match standing {
    SessionReleased => "released"
    SessionReleaseNotAttempted => "never opened"
    SessionReleaseRefused { detail: d } => concat("NOT released, still allocated on the controller: ", d)
  }
}

fn media_attach_text(record: MtCollins1MediaAttachRecord) -> String {
  match record {
    MediaAttachNotAttempted { reason: r } => concat("not attempted: ", r as String)
    MediaAttachAttempted { attempt: a, medium_image_name: n, medium_image_sha256: h, power: p, stale_power_off: off, result: res } =>
      join([
        "attempt ", a, " medium '", n as String, "' sha256 ", h as String,
        "; ", stale_power_off_text(record: off),
        "; power before the session: ", chassis_observation_text(observation: p) as String,
        "; session ", session_release_text(standing: res.session_release), "; ",
        match res.outcome {
          MegaRacPresentationReady { route: r, evidence: e } => concat("READY via ", concat(attach_route_text(route: r), concat(": ", presentation_evidence_text(e: e))))
          other => match media_attach_outcome_reason(outcome: other) {
            Present { value: why } => concat("WITHHELD: ", why)
            Absent => "WITHHELD"
          }
        },
      ], "")
  }
}

// WHAT OUR HARNESS DID THAT A READER OF THIS ATTEMPT MUST KNOW, as typed values carrying the record
// they were decided from. These are facts about the observation, not about the machine: the
// machine's side is the power-on account (gunbc.machine_intake_mtcollins1_power_on_account). Each is decided by
// the *_harness function beside its record and rendered once, by harness_finding_text.
type HarnessFinding
  = EveryBmcReadFailed { failed: List<BmcChannelRead> }
  | MediaAttachNotReady { record: MtCollins1MediaAttachRecord }
  | MediaAttachSessionHeld { record: MtCollins1MediaAttachRecord }
  | HandoffWithheldAtRecheck { handoff: MtCollins1HandoffMedia }
  | HandoffUnconfirmed { handoff: MtCollins1HandoffMedia }
  | PresentationAfterHandoff { look: MegaRacAttachResult }
  | OverrideNotConsumed { consumption: BootOverrideConsumption }
  | HostPoweredOffWithoutCensusEnd
  | CredentialMayRemain

fn media_attach_harness(record: MtCollins1MediaAttachRecord) -> List<HarnessFinding> {
  match record {
    MediaAttachNotAttempted { reason: _ } => []
    MediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: res } =>
      match media_attach_outcome_reason(outcome: res.outcome) {
        Present { value: _ } => [MediaAttachNotReady { record: record }]
        Absent =>
          match res.session_release {
            SessionReleased => []
            SessionReleaseRefused { detail: _ } => [MediaAttachSessionHeld { record: record }]
            SessionReleaseNotAttempted => [MediaAttachSessionHeld { record: record }]
          }
      }
  }
}

// THE HANDOFF'S OWN VIEW OF THE MEDIUM: the look just before the boot-device and power writes, and
// the look just after. A re-read narrows the window between readiness and handoff; it cannot close
// it, so the loss AT or AFTER the handoff is an observed, recorded outcome rather than an assumption
// that a ready medium stays ready.
// THE HANDOFF CALL IS RECORDED AS WHAT IT ESTABLISHED, NOT AS "HANDED OFF" (side-chat review
// 5332343434). gunbc.machine_intake_oob_boot_handoff returns success only after a chassis read-back
// observed the power transition, so success is a confirmed handoff; any other return is a handoff
// that was attempted and did not confirm, kept with its reason.
type HandoffCallResult
  = HandoffConfirmed
  | HandoffAttemptedUnconfirmed { reason: String }

type MtCollins1HandoffMedia
  = HandoffMediaNotReached { reason: NonEmptyStr }
  | HandoffMediaWithheldAtRecheck { before: MegaRacAttachResult }
  | HandoffMediaAttempted { before: MegaRacAttachResult, handoff: HandoffCallResult, after: MegaRacAttachResult }

fn observation_text(r: MegaRacAttachResult) -> String {
  match r.outcome {
    MegaRacPresentationObserved { share: sh, readiness: rd, cd_error: cd, general: g, configurations: c } =>
      join([
        "share ", match sh { ShareBound => "bound"  ShareMismatch { observed: o } => concat("MISMATCH ", concat(o.server_address, concat(":", o.source_path)))  ShareUnreadable { detail: d } => concat("UNREADABLE ", d) },
        "; row ", readiness_reading_text(r: rd),
        "; cd_error_code ", cd_reading_text(r: cd),
        "; general settings ", raw_read_text(r: g),
        "; configurations ", raw_read_text(r: c),
        "; session ", session_release_text(standing: r.session_release),
      ], "")
    other => match media_attach_outcome_reason(outcome: other) { Present { value: w } => concat("UNOBSERVED: ", w)  Absent => "UNOBSERVED" }
  }
}

fn handoff_media_text(h: MtCollins1HandoffMedia) -> String {
  match h {
    HandoffMediaNotReached { reason: r } => concat("not reached: ", r as String)
    HandoffMediaWithheldAtRecheck { before: b } => concat("WITHHELD at the pre-handoff recheck: ", observation_text(r: b))
    HandoffMediaAttempted { before: b, handoff: hc, after: a } => join(["before handoff: ", observation_text(r: b), " | handoff: ", match hc { HandoffConfirmed => "confirmed by chassis read-back"  HandoffAttemptedUnconfirmed { reason: r } => concat("ATTEMPTED, NOT CONFIRMED: ", r) }, " | after handoff: ", observation_text(r: a)], "")
  }
}

fn recheck_text(v: PresentationStillServed) -> String {
  match v {
    PresentationStillReady => "served"
    PresentationReadyButSessionHeld { held: r } => concat("served, but the look's own session was ", session_release_text(standing: r))
    PresentationNoLongerReady { reason: why } => concat("AFFIRMED not served: ", why as String)
    PresentationUnobserved { reason: why } => concat("UNOBSERVED (indeterminate, not a withdrawal): ", why as String)
  }
}

// AFFIRMED LOSS AND AN UNOBSERVED LOOK ARE DIFFERENT EVIDENCE (side-chat review 5331738657). Both
// withhold before the handoff, but the bundle says which it was: "LOST" only when a look was taken
// and showed the medium not served; a failed look is indeterminate and is reported as such.
fn handoff_media_harness(h: MtCollins1HandoffMedia) -> List<HarnessFinding> {
  match h {
    HandoffMediaNotReached { reason: _ } => []
    HandoffMediaWithheldAtRecheck { before: _ } => [HandoffWithheldAtRecheck { handoff: h }]
    HandoffMediaAttempted { before: _, handoff: hc, after: a } =>
      concat(match hc { HandoffConfirmed => []  HandoffAttemptedUnconfirmed { reason: _ } => [HandoffUnconfirmed { handoff: h }] },
      match presentation_still_served(result: a) {
        PresentationStillReady => []
        PresentationReadyButSessionHeld { held: _ } => [PresentationAfterHandoff { look: a }]
        PresentationNoLongerReady { reason: _ } => [PresentationAfterHandoff { look: a }]
        PresentationUnobserved { reason: _ } => [PresentationAfterHandoff { look: a }]
      })
  }
}

// THE MEDIUM AT THE END OF THE ATTEMPT: one read-only look, still under the hold, taken whenever the
// media attach was attempted -- whether or not the handoff was made -- so an experiment that stopped
// and restarted media and was then withheld still records its final state (side-chat review
// 5332343434). No power action is taken to obtain it. The census markers are the watch's own
// evidence of what the host did; neither they nor this look independently verify that the full
// image was delivered, and a persisting nonzero code does not by itself prove an active fault or a
// historical-only one.
type MtCollins1EndMedia
  = EndMediaNotTaken { reason: NonEmptyStr }
  | EndMediaObserved { look: MegaRacAttachResult }

// PURE: the end look is owed exactly when the media attach was attempted -- a session was opened
// against the controller, so any stop, start or presentation it reached is this attempt's to observe.
fn end_media_is_owed(media: MtCollins1MediaAttachRecord) -> Bool {
  match media {
    MediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: _ } => true
    MediaAttachNotAttempted { reason: _ } => false
  }
}

fn end_media_text(e: MtCollins1EndMedia) -> String {
  match e {
    EndMediaNotTaken { reason: r } => concat("not taken: ", r as String)
    EndMediaObserved { look: l } => observation_text(r: l)
  }
}

// A PRESENTATION AFFIRMED LOST AFTER THE HANDOFF IS A CAUSE, NOT ONLY A FINDING (gunbc#12533
// finding 4). The after-handoff and end-of-attempt looks are taken for this attempt's own subject,
// under the hold, after the boot override and the power action were made. When either AFFIRMS the
// medium is no longer served, the host was booting from a medium the controller had stopped
// serving, and a failure the attempt reports afterwards -- a watch that reaches its deadline -- is
// that loss seen from downstream. So the attempt's verdict consumes the looks it took rather than
// leaving them to the bundle. Only an affirmed loss attributes: an unobserved or unestablished look
// says nothing about the medium and is never promoted to a cause. The earliest affirming look is
// named, because the phase is what the operator acts on.
type MediaLossPhase
  = MediaLostAtAfterHandoff
  | MediaLostAtEndOfAttempt

fn media_loss_phase_text(p: MediaLossPhase) -> String {
  match p {
    MediaLostAtAfterHandoff => "after-handoff"
    MediaLostAtEndOfAttempt => "end-of-attempt"
  }
}

type MediaLossAfterHandoff
  = MediaLossAffirmed { phase: MediaLossPhase, reason: NonEmptyStr }
  | MediaLossNotAffirmed

fn media_loss_of_look(look: MegaRacAttachResult, phase: MediaLossPhase) -> MediaLossAfterHandoff {
  match presentation_still_served(result: look) {
    PresentationNoLongerReady { reason: why } => MediaLossAffirmed { phase: phase, reason: why }
    _ => MediaLossNotAffirmed
  }
}

// PURE, over the two looks only a CONFIRMED handoff makes causal: a handoff that was withheld or
// never reached made no boot write, and one attempted but unconfirmed already carries its own cause
// (the handoff's), so neither is re-attributed to the medium.
fn media_loss_after_handoff(handoff: MtCollins1HandoffMedia, end: MtCollins1EndMedia) -> MediaLossAfterHandoff {
  match handoff {
    HandoffMediaAttempted { before: _, handoff: HandoffConfirmed, after: a } =>
      match media_loss_of_look(look: a, phase: MediaLostAtAfterHandoff) {
        MediaLossAffirmed { phase: p, reason: r } => MediaLossAffirmed { phase: p, reason: r }
        MediaLossNotAffirmed =>
          match end {
            EndMediaObserved { look: l } => media_loss_of_look(look: l, phase: MediaLostAtEndOfAttempt)
            EndMediaNotTaken { reason: _ } => MediaLossNotAffirmed
          }
      }
    HandoffMediaAttempted { before: _, handoff: HandoffAttemptedUnconfirmed { reason: _ }, after: _ } => MediaLossNotAffirmed
    HandoffMediaNotReached { reason: _ } => MediaLossNotAffirmed
        HandoffMediaWithheldAtRecheck { before: _ } => MediaLossNotAffirmed
  }
}

// THE ATTEMPT'S TERMINAL CAUSE. A success stands -- the host reported its census, so whatever the
// controller did afterwards did not stop it (the finding still records the loss) -- and a failure is
// re-attributed to the loss, keeping the downstream symptom beside it rather than discarding it.
fn outcome_attributing_media_loss(outcome: ProcessExit, loss: MediaLossAfterHandoff) -> ProcessExit {
  match outcome {
    ExitSuccess => ExitSuccess
    ExitFailure { code: c, reason: r } =>
      match loss {
        MediaLossNotAffirmed => ExitFailure { code: c, reason: r }
        MediaLossAffirmed { phase: p, reason: why } =>
          ExitFailure { code: c, reason: join(["mtcollins1 boot: media presentation lost at ", media_loss_phase_text(p: p), " (", why as String, "); the attempt then reported: ", r], "") }
      }
  }
}

type MtCollins1BootRunRecord {
  census_ended: Bool
  end_media: MtCollins1EndMedia
  handoff_media: MtCollins1HandoffMedia
  media: MtCollins1MediaAttachRecord
  smpro_power_on: SmproReading
  smpro_census: SmproReading
  override_before: BootParam5Reading
  override_after: BootParam5Reading
  override: BootOverrideConsumption
  power_after: PowerAfterAttempt
  timing: BootPhaseTiming
}

fn run_record_not_taken(reason: NonEmptyStr) -> MtCollins1BootRunRecord {
  MtCollins1BootRunRecord {
    census_ended: false,
    end_media: EndMediaNotTaken { reason: reason },
    handoff_media: HandoffMediaNotReached { reason: reason },
    media: MediaAttachNotAttempted { reason: reason },
    smpro_power_on: SmproNotTaken { reason: reason },
    smpro_census: SmproNotTaken { reason: reason },
    override_before: BootParam5NotTaken { reason: reason },
    override_after: BootParam5NotTaken { reason: reason },
    override: OverrideNotHandedOff { reason: reason },
    power_after: PowerAfterNotTaken { reason: reason },
    timing: boot_phase_timing_not_taken(reason: reason),
  }
}

// PENDING MEANS THIS ATTEMPT'S OVERRIDE, READ THROUGH THE HANDOFF'S OWN VERDICT. The same
// boot_readback_verdict that confirmed the set decides "still pending" here, so the two can never
// disagree about what the controller's rendering means.
fn boot_override_pending(readback: String, selection: IpmiBootSelection) -> Bool {
  match boot_readback_verdict(readback: readback, selection: selection) {
    BootReadbackConfirmed => true
    BootReadbackFlagInvalid => false
    BootReadbackNotOneShot => false
    BootReadbackFirmwareMismatch => false
    BootReadbackSelectorAbsent => false
  }
}

fn boot_param5_unread_reason(r: BootParam5Reading, which: String) -> NonEmptyStr? {
  match r {
    BootParam5Read { readback: _, at: _ } => none
    BootParam5Unread { cause: c } => Present { value: concat("boot parameter 5 ", which, " was not read (", bmc_read_cause_kind(cause: c), ")") as NonEmptyStr }
    BootParam5NotTaken { reason: why } => Present { value: concat("boot parameter 5 ", which, " was not taken: ", why as String) as NonEmptyStr }
  }
}

// ORDER IS THE ARGUMENT, AND "CONSUMED" NEEDS A DISCRIMINATOR (DESIGN §4d; review 71115). An
// override already pending before this attempt set it cannot be attributed; one still pending after
// was not consumed. One NO LONGER pending is only that: the BMC also clears the valid bit on its own
// (the IPMI boot-flag valid-bit timeout), a power-off or another writer can clear it, and a changed
// rendering can stop matching. So consumption by this attempt is minted only beside an observation
// that only a boot through the override's device produces: the census END marker, which only the
// census image on the attached virtual CD prints, for this machine and this run. Without it the
// verdict records what was observed and says consumption is not established.
fn boot_override_consumption(before: BootParam5Reading, after: BootParam5Reading, selection: IpmiBootSelection, booted_through_override_device: Bool) -> BootOverrideConsumption {
  match before {
    BootParam5Read { readback: b, at: _ } =>
      if boot_override_pending(readback: b, selection: selection) {
        OverridePendingBeforeAttempt
      } else {
        match after {
          BootParam5Read { readback: a, at: _ } =>
            if boot_override_pending(readback: a, selection: selection) {
              OverrideStillPendingAfterAttempt
            } else if booted_through_override_device {
              OverrideConsumedByCensusBoot
            } else {
              OverrideNoLongerPendingAfterAttempt
            }
          other => match boot_param5_unread_reason(r: other, which: "after the attempt") {
            Present { value: why } => OverrideConsumptionUnread { reason: why }
            Absent => OverrideConsumptionUnread { reason: "boot parameter 5 after the attempt was not read" }
          }
        }
      }
    other => match boot_param5_unread_reason(r: other, which: "before the attempt") {
      Present { value: why } => OverrideConsumptionUnread { reason: why }
      Absent => OverrideConsumptionUnread { reason: "boot parameter 5 before the attempt was not read" }
    }
  }
}

fn power_after_attempt(observation: ChassisPowerObservation, census_ended: Bool) -> PowerAfterAttempt {
  match observation {
    ChassisPowerRead { power_on: on } =>
      if on { PoweredOnAfterAttempt } else if census_ended { PoweredOffAfterCensusEnd } else { PoweredOffWithoutCensusEnd }
    ChassisStatusUndecodable { cause: _ } => PowerAfterUnobserved { observation: observation }
    ChassisUnreadable => PowerAfterUnobserved { observation: observation }
  }
}

fn override_harness(c: BootOverrideConsumption) -> List<HarnessFinding> {
  match c {
    OverrideStillPendingAfterAttempt => [OverrideNotConsumed { consumption: c }]
    OverridePendingBeforeAttempt => [OverrideNotConsumed { consumption: c }]
    OverrideConsumedByCensusBoot => []
    OverrideNoLongerPendingAfterAttempt => []
    OverrideNotHandedOff { reason: _ } => []
    OverrideConsumptionUnread { reason: _ } => []
  }
}

fn power_after_harness(p: PowerAfterAttempt) -> List<HarnessFinding> {
  match p {
    PoweredOffWithoutCensusEnd => [HostPoweredOffWithoutCensusEnd]
    PoweredOffAfterCensusEnd => []
    PoweredOnAfterAttempt => []
    PowerAfterUnobserved { observation: _ } => []
    PowerAfterNotTaken { reason: _ } => []
  }
}

fn override_consumption_text(c: BootOverrideConsumption) -> String {
  match c {
    OverrideConsumedByCensusBoot => "consumed by this attempt: cleared after a census END marker, which only a boot of the override's device prints"
    OverrideNoLongerPendingAfterAttempt => "no longer pending after the attempt, but no boot through the override's device was observed, so consumption by this attempt is not established"
    OverridePendingBeforeAttempt => "ALREADY PENDING before this attempt set it; consumption not attributable"
    OverrideStillPendingAfterAttempt => "STILL PENDING after the attempt; not consumed"
    OverrideNotHandedOff { reason: r } => concat("not handed off: ", r as String)
    OverrideConsumptionUnread { reason: r } => concat("undetermined: ", r as String)
  }
}

fn power_after_text(p: PowerAfterAttempt) -> String {
  match p {
    PoweredOffAfterCensusEnd => "off after the census END marker (expected: the census image ends with poweroff -f)"
    PoweredOffWithoutCensusEnd => "OFF without the census END marker"
    PoweredOnAfterAttempt => "on"
    PowerAfterUnobserved { observation: o } => concat("unobserved: ", chassis_observation_text(observation: o) as String)
    PowerAfterNotTaken { reason: r } => concat("not taken: ", r as String)
  }
}

fn boot_param5_text(label: String, r: BootParam5Reading) -> String {
  match r {
    BootParam5Read { readback: rb, at: at } => concat("boot parameter 5 ", label, " (", at as String, "):\n", rb)
    BootParam5Unread { cause: c } => concat("boot parameter 5 ", label, ": UNREAD: ", bmc_read_cause_text(cause: c))
    BootParam5NotTaken { reason: why } => concat("boot parameter 5 ", label, ": NOT TAKEN: ", why as String)
  }
}

fn run_record_text(r: MtCollins1BootRunRecord) -> String {
  join([
    concat("media=", media_attach_text(record: r.media)),
    concat("handoff_media=", handoff_media_text(h: r.handoff_media)),
    concat("end_media=", end_media_text(e: r.end_media)),
    concat("override=", override_consumption_text(c: r.override)),
    concat("power_after=", power_after_text(p: r.power_after)),
    "-- phase timing (gunbc.managed_host_boot_phase_timing) --",
    boot_phase_timing_text(t: r.timing),
    boot_param5_text(label: "before", r: r.override_before),
    boot_param5_text(label: "after", r: r.override_after),
    "-- smpro pass at power on --",
    smpro_text(s: r.smpro_power_on),
    "-- smpro pass while the census ran --",
    smpro_text(s: r.smpro_census),
  ], "\n")
}

// `screen` is the attempt's KVM screen: the held observer's establishment, its journal of boundary
// and lifecycle events, every still with its instant and sha256 (or why it is not hash-bound), the
// gaps between stills, and the separately timestamped teardown. Evidence only: no finding and no
// verdict reads it (gunbc.machine_intake_mtcollins1_kvm_still).
type MtCollins1BootDiagnosticBundle {
  attempt: AttemptIdentityReading
  outcome: String
  sel_before: SelSnapshotReading
  sel_after: SelSnapshotReading
  sdr_cache: SdrCacheReading
  sensors: SensorReading
  smpro: SmproReading
  inventory: InventoryReading
  console: ConsoleReading
  run: MtCollins1BootRunRecord
  screen: KvmObserverRecord
}

fn inventory_not_taken(reason: NonEmptyStr) -> InventoryReading {
  InventoryReading { system_id: "", memory: MembersNotTaken { reason: reason }, processors: MembersNotTaken { reason: reason }, credential_removed: true }
}

// ── THE SEL DELTA ────────────────────────────────────────────────────────────────────────────
type SelDeltaReading
  = SelDeltaDecoded { delta: SelDelta }
  | SelDeltaRefused { cause: NonEmptyStr }
  | SelDeltaUnavailable { reason: String }

fn sel_delta_reading(before: SelSnapshotReading, after: SelSnapshotReading) -> SelDeltaReading {
  match before {
    SelSnapshotRead { raw: b, at: _ } =>
      match after {
        SelSnapshotRead { raw: a, at: _ } =>
          match sel_read(text: b) {
            ObservationRefused { cause: c } => SelDeltaRefused { cause: concat("before snapshot: ", c as String) as NonEmptyStr }
            ObservationEstablished { observed: watermark } =>
              match sel_after(watermark: watermark, text: a) {
                ObservationRefused { cause: c } => SelDeltaRefused { cause: c }
                ObservationEstablished { observed: delta } => SelDeltaDecoded { delta: delta }
              }
          }
        SelSnapshotUnread { cause: _ } => SelDeltaUnavailable { reason: "no after snapshot" }
        SelSnapshotNotTaken { reason: _ } => SelDeltaUnavailable { reason: "no after snapshot" }
      }
    SelSnapshotUnread { cause: _ } => SelDeltaUnavailable { reason: "no before snapshot" }
    SelSnapshotNotTaken { reason: _ } => SelDeltaUnavailable { reason: "no before snapshot" }
  }
}

fn sel_event_kind_text(event: SelWindowEvent) -> String {
  match event.kind {
    BootRestart { offset: _ } => "system boot initiated (section 42.2 sensor type 1Dh)"
    FirmwareProgressRecord { offset: o } => match o {
      FirmwareError => "system firmware error (section 42.2 sensor type 0Fh offset 00h, POST error)"
      FirmwareHang => "system firmware hang (section 42.2 sensor type 0Fh offset 01h)"
      FirmwareProgress { progress_rendering: r } => concat("system firmware progress: ", r as String)
    }
    OemTimestamped { payload: p } => concat("OEM record, manufacturer ", p.manufacturer_id_rendering as String, ", bytes ", p.oem_bytes_rendering as String, " (OEM-defined; not decoded)")
    OtherStandardEvent { rendering: r } => r as String
  }
}

fn sel_event_is_oem(event: SelWindowEvent) -> Bool {
  match event.kind { OemTimestamped { payload: _ } => true BootRestart { offset: _ } => false FirmwareProgressRecord { offset: _ } => false OtherStandardEvent { rendering: _ } => false }
}

fn sel_event_text(event: SelWindowEvent) -> String {
  concat("record ", to_string(event.record_id), " at ", event.bmc_clock_rendering as String, ": ", sel_event_kind_text(event: event))
}

// A STANDARD EVENT WHOSE SENSOR TYPE IS Memory (0Ch) OR Processor (07h). ipmitool renders the
// section 42.2 sensor-type name as the leading word of the sensor column, so the type is read
// from that column. A sensor NAME that merely mentions a CPU ("Voltage CPU0_0V75_PCP") is a
// voltage sensor and is not selected.
fn sel_event_is_memory_or_processor(event: SelWindowEvent) -> Bool {
  match event.kind {
    OtherStandardEvent { rendering: r } => {
      let sensor = sel_field(fields: map(split(s: r as String, delimiter: "|"), f => trim(f)), index: 3)
      starts_with(s: sensor, prefix: "Memory") || starts_with(s: sensor, prefix: "Processor")
    }
    FirmwareProgressRecord { offset: o } => match o { FirmwareProgress { progress_rendering: _ } => false FirmwareError => true FirmwareHang => true }
    BootRestart { offset: _ } => false
    OemTimestamped { payload: _ } => false
  }
}

// ── DECISIVE FINDINGS ────────────────────────────────────────────────────────────────────────
// THE SOCKETS THE CENSUS OBSERVED, derived from its slot rows rather than restated.
fn distinct_ints(xs: List<Int>) -> List<Int> {
  let empty: List<Int> = []
  fold(xs, init: empty, f: (acc, k) => if any(acc, j => j == k) { acc } else { concat(acc, [k]) })
}

fn mtcollins1_census_sockets() -> List<Int> {
  distinct_ints(xs: map(mtcollins1_slots, s => s.processor_socket as Int))
}

fn mtcollins1_census_socket_count() -> Int {
  count(mtcollins1_census_sockets())
}

fn smpro_text(s: SmproReading) -> String {
  match s {
    SmproProbed { observation: o } => smpro_pass_dossier_text(obs: o)
    SmproNotTaken { reason: why } => concat("NOT TAKEN: ", why as String)
  }
}

fn sensor_anomalies(s: SensorReading, receipt: AttemptConfigurationReceipt) -> List<BmcAnomaly> {
  match s {
    SensorsRead { lines: ls, at: _ } => mtcollins1_sensor_anomalies(lines: ls, sockets: mtcollins1_census_sockets(), expected: expected_socket_list(receipt: receipt))
    SensorsUnread { cause: _ } => []
    SensorsNotTaken { reason: _ } => []
  }
}

fn state_is_down(state: RedfishResourceState) -> Bool {
  match state {
    StateAbsent => true
    StateDisabled => true
    StateUnavailableOffline => true
    StateStandbyOffline => true
    StateEnabled => false
    StateStandbySpare => false
    StateInTest => false
    StateStarting => false
    StateDeferring => false
    StateQuiesced => false
    StateUpdating => false
    StateQualified => false
    StateDegraded => false
    StateUnrecognized { rendering: _ } => false
    StateNotReported => false
  }
}

fn health_is_bad(health: RedfishHealth) -> Bool {
  match health {
    HealthWarning => true
    HealthCritical => true
    HealthOk => false
    HealthUnrecognized { rendering: _ } => false
    HealthNotReported => false
  }
}

fn status_text(status: RedfishResourceStatus) -> String {
  concat("State=", redfish_resource_state_wire(state: status.state), " Health=", redfish_health_wire(health: status.health))
}

fn memory_socket(m: RedfishMemoryMember) -> Int? {
  match m.memory_location {
    Absent => none
    Present { value: loc } => loc.socket
  }
}

// -1 is never a socket index, so it stands for "the member reports no socket" in the grouping.
fn memory_socket_key(m: RedfishMemoryMember) -> Int {
  match memory_socket(m: m) { Absent => -1 Present { value: s } => s }
}

fn state_is_absent(state: RedfishResourceState) -> Bool {
  match state {
    StateAbsent => true
    StateEnabled => false
    StateDisabled => false
    StateStandbyOffline => false
    StateStandbySpare => false
    StateInTest => false
    StateStarting => false
    StateUnavailableOffline => false
    StateDeferring => false
    StateQuiesced => false
    StateUpdating => false
    StateQualified => false
    StateDegraded => false
    StateUnrecognized { rendering: _ } => false
    StateNotReported => false
  }
}

fn recorded_slot_rows(receipt: AttemptConfigurationReceipt) -> List<SlotRow>? {
  match receipt.dimms {
    PopulationLiveObserved { rows: rs, source: _ } => Present { value: rs }
    PopulationOperatorAttested { rows: rs, receipt: _ } => Present { value: rs }
    PopulationConflicted { readings: _ } => none
    PopulationNotRecorded { reason: _ } => none
  }
}

fn expected_socket_list(receipt: AttemptConfigurationReceipt) -> List<Int>? {
  match receipt.expected { ExpectedSockets { sockets: ks, source: _ } => Present { value: ks } ExpectedTopologyNotRecorded { reason: _ } => none }
}

// "CPU 1", "Socket 1": the trailing number of the BMC's own socket rendering, or none.
fn processor_socket_number(p: RedfishProcessorMember) -> Int? {
  match p.socket {
    Absent => none
    Present { value: t } => match filter(split(s: trim(t), delimiter: " "), x => x != "").last() { Absent => none Present { value: tok } => parse_int(s: tok) }
  }
}

fn memory_label(m: RedfishMemoryMember) -> String {
  match m.device_locator {
    Present { value: l } => concat(m.id as String, " (", l, ")")
    Absent => m.id as String
  }
}

fn processor_socket_suffix(p: RedfishProcessorMember) -> String {
  match p.socket { Present { value: s } => concat(" (Socket ", s, ")") Absent => "" }
}

// COMPLETENESS IS JUDGED PER EXPECTED SOCKET, never by a count: for each socket the receipt expects,
// exactly one Processor member names it (none is Missing, two or more is Duplicated); a member whose
// socket the BMC renders unreadably is its own anomaly. With no recorded topology none of these is
// judged (law 6). What the BMC states about a member's health stays unconditional.
fn processor_anomalies(processors: MembersReading<RedfishProcessorMember>, receipt: AttemptConfigurationReceipt) -> List<BmcAnomaly> {
  match processors {
    MembersRead { members: ps } => {
      let unhealthy = map(filter(ps, p => health_is_bad(health: p.status.health) || (state_is_down(state: p.status.state) && !state_is_absent(state: p.status.state))), p => ProcessorNotNominal { member: p })
      let per_socket = match expected_socket_list(receipt: receipt) {
        Absent => []
        Present { value: ks } => concat(
          flat_map(ks, k => {
            let on = filter(ps, p => match processor_socket_number(p: p) { Present { value: n } => n == k Absent => false })
            if count(on) == 0 { [ProcessorMissingOnExpectedSocket { socket: k }] }
            else if count(on) > 1 { [ProcessorSocketDuplicated { socket: k, members: on }] }
            else { flat_map(on, p => if state_is_absent(state: p.status.state) && !health_is_bad(health: p.status.health) { [ProcessorAbsentOnExpectedSocket { member: p, socket: k }] } else { [] }) }
          }),
          map(filter(ps, p => match processor_socket_number(p: p) { Present { value: _ } => false Absent => true }), p => ProcessorSocketUnreadable { member: p }))
      }
      concat(unhealthy, per_socket)
    }
    MembersUnread { cause: _ } => []
    MembersNotTaken { reason: _ } => []
  }
}

// PER SOCKET, OVER THE UNION OF THE SOCKETS THE RECEIPT RECORDS POPULATED AND THE SOCKETS THE BMC
// LISTS: a socket whose present members are fewer than the receipt's populated slots on it is an
// anomaly, including a socket the collection never mentions. With no recorded population nothing is
// judged (law 6). What the BMC states about a member's health stays unconditional.
fn memory_anomalies(memory: MembersReading<RedfishMemoryMember>, receipt: AttemptConfigurationReceipt) -> List<BmcAnomaly> {
  match memory {
    MembersRead { members: ms } => {
      let bad = map(filter(ms, m => (state_is_down(state: m.status.state) && !state_is_absent(state: m.status.state)) || health_is_bad(health: m.status.health)), m => MemoryNotNominal { member: m })
      let below = match recorded_slot_rows(receipt: receipt) {
        Absent => []
        Present { value: rows } => {
          let sockets = distinct_ints(xs: concat(map(filter(rows, r => r.populated), r => r.socket), filter(map(ms, m => memory_socket_key(m: m)), k => k >= 0)))
          flat_map(sockets, k => {
            let present = count(filter(ms, m => memory_socket_key(m: m) == k && !state_is_absent(state: m.status.state)))
            let populated = count(filter(rows, r => r.socket == k && r.populated))
            if present < populated { [MemoryBelowRecordedPopulation { socket: k, present: present, populated: populated }] } else { [] }
          })
        }
      }
      concat(below, bad)
    }
    MembersUnread { cause: _ } => []
    MembersNotTaken { reason: _ } => []
  }
}

fn sel_hardware_anomalies(delta: SelDeltaReading) -> List<BmcAnomaly> {
  match delta {
    SelDeltaDecoded { delta: d } => map(filter(d.events, e => sel_event_is_memory_or_processor(event: e)), e => SelHardwareEvent { event: e })
    SelDeltaRefused { cause: _ } => []
    SelDeltaUnavailable { reason: _ } => []
  }
}

// WHAT EACH BMC CHANNEL DID ON THIS ATTEMPT, one standing per read, derived from the sections
// themselves so no channel can be left out of the aggregate by omission. A read that answered on
// ANY channel means the BMC answered; a read not attempted (the attempt ended first, or the sensor
// read had no SDR cache to read through) is neither.
type BmcChannelStanding
  = BmcChannelAnswered
  | BmcChannelFailed { cause: BmcReadCause }
  | BmcChannelNotAttempted

type BmcChannelRead {
  channel: NonEmptyStr
  standing: BmcChannelStanding
}

fn sel_channel(channel: NonEmptyStr, s: SelSnapshotReading) -> BmcChannelRead {
  BmcChannelRead { channel: channel, standing: match s {
    SelSnapshotRead { raw: _, at: _ } => BmcChannelAnswered
    SelSnapshotUnread { cause: c } => BmcChannelFailed { cause: c }
    SelSnapshotNotTaken { reason: _ } => BmcChannelNotAttempted
  } }
}

fn members_channel<T>(channel: NonEmptyStr, m: MembersReading<T>) -> BmcChannelRead {
  BmcChannelRead { channel: channel, standing: match m {
    MembersRead { members: _ } => BmcChannelAnswered
    MembersUnread { cause: c } => BmcChannelFailed { cause: c }
    MembersNotTaken { reason: _ } => BmcChannelNotAttempted
  } }
}

// A PROBE THE BMC ANSWERED IS AN ANSWER, whatever it said: a word, a completion code (a NAK on the
// SMpro's address says the BMC is up and the device did not acknowledge), or an exit-zero response
// whose bytes did not parse, which is still the BMC replying; its malformed standing stays on the
// probe in the dossier. Only a probe with no completion code (the session or
// the deadline) is this channel failing, and it carries the first such probe's transport cause.
fn smpro_channel(s: SmproReading) -> BmcChannelRead {
  BmcChannelRead { channel: "ipmi master write-read (smpro)", standing: match s {
    SmproNotTaken { reason: _ } => BmcChannelNotAttempted
    SmproProbed { observation: obs } => {
      let os = obs.outcomes
      if any(os, o => match o { SmproWordRead { raw: _, word: _ } => true SmproControllerRefused { raw: _, completion: _ } => true SmproResponseMalformed { raw: _, detail: _ } => true SmproTransportFailed { raw: _, timed_out: _ } => false SmproNotSent { socket: _, register: _, reason: _ } => false SmproRequestUnencodable { socket: _, register: _, detail: _ } => false }) { BmcChannelAnswered }
      else {
        match flat_map(os, o => match o { SmproTransportFailed { raw: r, timed_out: _ } => [r] SmproWordRead { raw: _, word: _ } => [] SmproControllerRefused { raw: _, completion: _ } => [] SmproResponseMalformed { raw: _, detail: _ } => [] SmproNotSent { socket: _, register: _, reason: _ } => [] SmproRequestUnencodable { socket: _, register: _, detail: _ } => [] }).first() {
          Absent => BmcChannelNotAttempted
          Present { value: r } => BmcChannelFailed { cause: bmc_ipmitool_read_cause(endpoint: mtcollins1_ipmi_endpoint(), at: r.at, exit_code: r.exit_code, stderr: r.stderr) }
        }
      }
    }
  } }
}

fn bmc_channel_reads(bundle: MtCollins1BootDiagnosticBundle) -> List<BmcChannelRead> {
  [
    sel_channel(channel: "ipmi sel before", s: bundle.sel_before),
    sel_channel(channel: "ipmi sel after", s: bundle.sel_after),
    BmcChannelRead { channel: "ipmi sdr dump", standing: match bundle.sdr_cache {
      SdrCacheDumped { path: _, at: _ } => BmcChannelAnswered
      SdrCacheUnread { cause: c } => BmcChannelFailed { cause: c }
      SdrCacheNotTaken { reason: _ } => BmcChannelNotAttempted
    } },
    BmcChannelRead { channel: "ipmi sdr elist", standing: match bundle.sensors {
      SensorsRead { lines: _, at: _ } => BmcChannelAnswered
      SensorsUnread { cause: c } => BmcChannelFailed { cause: c }
      SensorsNotTaken { reason: _ } => BmcChannelNotAttempted
    } },
    smpro_channel(s: bundle.smpro),
    smpro_channel(s: bundle.run.smpro_power_on),
    smpro_channel(s: bundle.run.smpro_census),
    members_channel(channel: "redfish memory", m: bundle.inventory.memory),
    members_channel(channel: "redfish processors", m: bundle.inventory.processors),
  ]
}

fn channel_answered(r: BmcChannelRead) -> Bool {
  match r.standing { BmcChannelAnswered => true BmcChannelFailed { cause: _ } => false BmcChannelNotAttempted => false }
}

fn channel_cause(r: BmcChannelRead) -> BmcReadCause? {
  match r.standing { BmcChannelFailed { cause: c } => Present { value: c } BmcChannelAnswered => none BmcChannelNotAttempted => none }
}

// EVERY BMC READ THAT WAS ATTEMPTED FAILED, AND NONE ANSWERED: the failed channels, in read order.
// Empty when any channel answered, and empty when nothing was attempted (an attempt that refused
// before reading the credential says so in every section separately).
fn bmc_all_reads_failed(bundle: MtCollins1BootDiagnosticBundle) -> List<BmcChannelRead> {
  let reads = bmc_channel_reads(bundle: bundle)
  let empty: List<BmcChannelRead> = []
  if any(reads, r => channel_answered(r: r)) { empty } else {
    filter(reads, r => match channel_cause(r: r) { Present { value: _ } => true Absent => false })
  }
}

// ── WHAT THE BUNDLE ESTABLISHES ────────────────────────────────────────────────────────────────
// THE EVIDENCE THE POWER-ON ACCOUNT READS, assembled from this bundle's own sections. Nothing is
// re-read: each field is a section already taken, or a standing derived from one.
fn smpro_pass(label: NonEmptyStr, s: SmproReading) -> List<SmproPassEvidence> {
  match s {
    SmproProbed { observation: o } => [SmproPassEvidence { label: label, observation: o }]
    SmproNotTaken { reason: _ } => []
  }
}

fn handoff_standing(h: MtCollins1HandoffMedia) -> PowerOnHandoff {
  match h {
    HandoffMediaAttempted { before: _, handoff: hc, after: _ } => match hc {
      HandoffConfirmed => HandoffPoweredOn
      HandoffAttemptedUnconfirmed { reason: r } => HandoffNotConfirmed { reason: concat("the boot-device and power handoff was attempted and not confirmed: ", r) as NonEmptyStr }
    }
    HandoffMediaWithheldAtRecheck { before: _ } => HandoffNotConfirmed { reason: "the pre-handoff recheck withheld the power write" }
    HandoffMediaNotReached { reason: r } => HandoffNotConfirmed { reason: r }
  }
}

fn console_evidence(c: ConsoleReading) -> ConsoleEvidence {
  match c {
    ConsoleRetained { path: _, size: _, lines: _, firmware: f, firmware_error_lines: e, capture_digest: dg, dram: d, checkpoints: cp, checkpoint_relations: rs, milestones: ms, sockets: o, against_reference: _, loader: g, linux: l, modules: m, nvparam: _, span_readings: sr } =>
      ConsoleRead { capture: dg, firmware: f, firmware_error_lines: e, dram: d, checkpoints: cp, relations: rs, milestones: ms, sockets: o, loader: g, linux: l, modules: m, span_readings: sr }
    ConsoleExceedsBound { path: _, size: _, bound: _ } => ConsoleNotRead
    ConsoleNotRetained { path: _ } => ConsoleNotRead
    ConsoleUnread { path: _, detail: _ } => ConsoleNotRead
    ConsoleNotConfigured => ConsoleNotRead
  }
}

fn sel_evidence(delta: SelDeltaReading) -> SelEvidence {
  match delta {
    SelDeltaDecoded { delta: d } => SelEventsRead { events: d.events }
    SelDeltaRefused { cause: _ } => SelEventsNotRead
    SelDeltaUnavailable { reason: _ } => SelEventsNotRead
  }
}

// ── COVERAGE: one standing per carrier, never a host statement ─────────────────────────────────
fn console_coverage(c: ConsoleReading) -> CarrierStanding {
  match c {
    ConsoleRetained { path: _, size: _, lines: n, firmware: _, firmware_error_lines: _, capture_digest: _, dram: _, checkpoints: _, checkpoint_relations: _, milestones: _, sockets: _, against_reference: _, loader: _, linux: _, modules: _, nvparam: _, span_readings: _ } =>
      if n == 0 { CarrierReadEmpty } else { CarrierRead }
    ConsoleExceedsBound { path: p, size: _, bound: _ } => CarrierPartial { detail: concat("capture ", p as String, " is over the byte bound and was not read") as NonEmptyStr }
    ConsoleNotRetained { path: p } => CarrierNotTaken { reason: concat("capture ", p as String, " is not retained with this artifact") as NonEmptyStr }
    ConsoleUnread { path: p, detail: d } => CarrierRefused { cause: concat("capture ", p as String, " unread: ", d) as NonEmptyStr }
    ConsoleNotConfigured => CarrierNotTaken { reason: "the SOL capture path was unset for this attempt" }
  }
}

fn kvm_coverage(rec: KvmObserverRecord) -> CarrierStanding {
  match rec.start {
    KvmObserverNotStarted { reason: r } => CarrierNotTaken { reason: r }
    KvmObserverStarted { dir: _, subject: _, standing: _, checked_at: _ } => if count(rec.stills) == 0 { CarrierReadEmpty } else { CarrierRead }
  }
}

fn smpro_answered(s: SmproReading) -> Bool {
  match s { SmproProbed { observation: o } => any(o.outcomes, o => match smpro_outcome_word(o: o) { Present { value: _ } => true Absent => false }) SmproNotTaken { reason: _ } => false }
}

fn smpro_coverage(readings: List<SmproReading>) -> CarrierStanding {
  if any(readings, r => smpro_answered(s: r)) { CarrierRead }
  else if any(readings, r => match r { SmproProbed { observation: _ } => true SmproNotTaken { reason: _ } => false }) { CarrierRefused { cause: "no SMpro register word was read in any pass" } }
  else { CarrierNotTaken { reason: "no SMpro pass was taken" } }
}

// THE ERROR-RECORD REGISTERS, covered apart from the boot-stage pair (#13058): a pass whose CUR and
// BOOTSTAGE read while GPI_RAS_ERR or a record word refused is a gap in THIS carrier, not in progress.
fn record_gaps(os: List<SmproProbeOutcome>, socket: Int) -> List<String> {
  let r = smpro_socket_records(outcomes: os, socket: socket)
  let gpi = match smpro_socket_word(outcomes: os, socket: socket, register: smpro_gpi_ras_err_reg.name) {
    Absent => [concat("socket ", to_string(socket), " GPI_RAS_ERR was not probed")]
    Present { value: o } => match smpro_outcome_word(o: o) { Present { value: _ } => [] Absent => [concat("socket ", to_string(socket), " GPI_RAS_ERR ", smpro_outcome_text(o: o))] }
  }
  concat(gpi, concat(match r.smpro.missing { Present { value: m } => [concat("socket ", to_string(socket), " SMpro records: ", m)] Absent => [] },
    match r.pmpro.missing { Present { value: m } => [concat("socket ", to_string(socket), " PMpro records: ", m)] Absent => [] }))
}

fn smpro_error_coverage(readings: List<SmproReading>) -> CarrierStanding {
  let passes = flat_map(readings, r => match r { SmproProbed { observation: o } => [o] SmproNotTaken { reason: _ } => [] })
  let gaps = flat_map(passes, o => flat_map(smpro_site_targets(site: o.subject.site), t => record_gaps(os: o.outcomes, socket: t.socket)))
  let wanted = fold(passes, init: 0, f: (acc, o) => acc + count(smpro_site_targets(site: o.subject.site)) * 3)
  if count(passes) == 0 { CarrierNotTaken { reason: "no SMpro pass was taken" } }
  else if count(gaps) == 0 { CarrierRead }
  else if count(gaps) >= wanted { CarrierRefused { cause: (match gaps.first() { Present { value: g } => g Absent => "every error-record read failed" }) as NonEmptyStr } }
  else { CarrierPartial { detail: join(gaps, "; ") as NonEmptyStr } }
}

fn sel_coverage(delta: SelDeltaReading) -> CarrierStanding {
  match delta {
    SelDeltaDecoded { delta: _ } => CarrierRead
    SelDeltaRefused { cause: c } => CarrierRefused { cause: c }
    SelDeltaUnavailable { reason: r } => CarrierNotTaken { reason: (if r == "" { "the SEL delta is unavailable" } else { r }) as NonEmptyStr }
  }
}

fn sensor_coverage(s: SensorReading) -> CarrierStanding {
  match s {
    SensorsRead { lines: ls, at: _ } => if count(ls) == 0 { CarrierReadEmpty } else { CarrierRead }
    SensorsUnread { cause: c } => CarrierRefused { cause: bmc_read_cause_text(cause: c) as NonEmptyStr }
    SensorsNotTaken { reason: r } => CarrierNotTaken { reason: r }
  }
}

fn chassis_coverage(p: PowerAfterAttempt) -> CarrierStanding {
  match p {
    PowerAfterUnobserved { observation: _ } => CarrierRefused { cause: "the post-attempt chassis read did not answer" }
    PowerAfterNotTaken { reason: r } => CarrierNotTaken { reason: r }
    PoweredOffAfterCensusEnd => CarrierRead
    PoweredOffWithoutCensusEnd => CarrierRead
    PoweredOnAfterAttempt => CarrierRead
  }
}

fn members_coverage<T>(m: MembersReading<T>) -> CarrierStanding {
  match m {
    MembersRead { members: _ } => CarrierRead
    MembersUnread { cause: c } => CarrierRefused { cause: bmc_read_cause_text(cause: c) as NonEmptyStr }
    MembersNotTaken { reason: r } => CarrierNotTaken { reason: r }
  }
}

fn inventory_coverage(i: InventoryReading) -> CarrierStanding {
  match members_coverage(m: i.memory) {
    CarrierRead => members_coverage(m: i.processors)
    other => other
  }
}

fn media_coverage(m: MtCollins1MediaAttachRecord) -> CarrierStanding {
  match m {
    MediaAttachNotAttempted { reason: r } => CarrierNotTaken { reason: r }
    MediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: _ } => CarrierRead
  }
}

fn census_coverage(run: MtCollins1BootRunRecord) -> CarrierStanding {
  if run.census_ended { CarrierRead } else { CarrierPartial { detail: "no census END marker was observed; the watch's own termination is the run's exit" } }
}

fn mtcollins1_boot_coverage(bundle: MtCollins1BootDiagnosticBundle) -> List<CarrierCoverage> {
  let delta = sel_delta_reading(before: bundle.sel_before, after: bundle.sel_after)
  [
    CarrierCoverage { carrier: SolConsole, standing: console_coverage(c: bundle.console) },
    CarrierCoverage { carrier: KvmScreen, standing: kvm_coverage(rec: bundle.screen) },
    CarrierCoverage { carrier: SmproRegisters, standing: smpro_coverage(readings: [bundle.run.smpro_power_on, bundle.run.smpro_census, bundle.smpro]) },
    CarrierCoverage { carrier: SmproErrorRegisters, standing: smpro_error_coverage(readings: [bundle.run.smpro_power_on, bundle.run.smpro_census, bundle.smpro]) },
    CarrierCoverage { carrier: SystemEventLog, standing: sel_coverage(delta: delta) },
    CarrierCoverage { carrier: SensorTable, standing: sensor_coverage(s: bundle.sensors) },
    CarrierCoverage { carrier: ChassisPower, standing: chassis_coverage(p: bundle.run.power_after) },
    CarrierCoverage { carrier: RedfishInventory, standing: inventory_coverage(i: bundle.inventory) },
    CarrierCoverage { carrier: VirtualMedia, standing: media_coverage(m: bundle.run.media) },
    CarrierCoverage { carrier: HostCaptureMarkers, standing: census_coverage(run: bundle.run) },
  ]
}

// THE ATTEMPT CONFIGURATION RECEIPT THIS RUN CAN FREEZE TODAY. The fleet-converge boot takes no
// stimulus, population, expected-topology or pre-actuation firmware receipt yet, so those fields are
// NotRecorded with that reason and every question needing them is open; the historical census and
// orientation rows are deliberately NOT used (they map topology, never current occupancy, and are no
// expectation of THIS attempt), so no topology degradation is minted from them. DECLARED FRONTIER: the receipt's live inputs land
// with the boot workflow's stimulus-receipt input (docs/plans/power-on-sequence-model.md section 10);
// until then the account says what it cannot judge rather than judging it.
data mtcollins1_receipt_input_frontier: NonEmptyStr = "the fleet-converge boot takes no stimulus, population or pre-actuation firmware receipt yet"

fn mtcollins1_attempt_configuration_receipt(attempt: AttemptIdentityReading) -> AttemptConfigurationReceipt {
  AttemptConfigurationReceipt {
    subject: "mtcollins1",
    attempt: attempt_identity_text(a: attempt) as NonEmptyStr,
    expected: ExpectedTopologyNotRecorded { reason: mtcollins1_receipt_input_frontier },
    requested: StimulusRequestNotRecorded { reason: mtcollins1_receipt_input_frontier },
    applied: StimulusApplicationNotRecorded { reason: mtcollins1_receipt_input_frontier },
    cpus: PopulationNotRecorded { reason: mtcollins1_receipt_input_frontier },
    dimms: PopulationNotRecorded { reason: mtcollins1_receipt_input_frontier },
    firmware: FirmwareReadbacksNotRecorded { reason: mtcollins1_receipt_input_frontier },
  }
}

fn mtcollins1_boot_evidence(bundle: MtCollins1BootDiagnosticBundle) -> PowerOnEvidence {
  let delta = sel_delta_reading(before: bundle.sel_before, after: bundle.sel_after)
  let receipt = mtcollins1_attempt_configuration_receipt(attempt: bundle.attempt)
  PowerOnEvidence {
    configuration: receipt,
    handoff: handoff_standing(h: bundle.run.handoff_media),
    smpro: concat(smpro_pass(label: "power-on", s: bundle.run.smpro_power_on), concat(smpro_pass(label: "census", s: bundle.run.smpro_census), smpro_pass(label: "after the attempt", s: bundle.smpro))),
    console: console_evidence(c: bundle.console),
    sel: sel_evidence(delta: delta),
    watchdog: WatchdogUnobserved { reason: "the boot run does not read the BMC's IPMI watchdog" },
    bmc_anomalies: concat(processor_anomalies(processors: bundle.inventory.processors, receipt: receipt), concat(memory_anomalies(memory: bundle.inventory.memory, receipt: receipt), concat(sensor_anomalies(s: bundle.sensors, receipt: receipt), sel_hardware_anomalies(delta: delta)))),
    census_ended: bundle.run.census_ended,
    coverage: mtcollins1_boot_coverage(bundle: bundle),
  }
}

// WHAT THE BUNDLE FOUND: the power-on account (the host and our coverage of it) and, beside it, what
// our harness did. The two are composed here because the harness records are this module's.
type MtCollins1BootFindings {
  account: PowerOnAccount
  harness: List<HarnessFinding>
}

fn mtcollins1_boot_harness(bundle: MtCollins1BootDiagnosticBundle) -> List<HarnessFinding> {
  let failed = bmc_all_reads_failed(bundle: bundle)
  concat(if count(failed) == 0 { [] } else { [EveryBmcReadFailed { failed: failed }] },
    concat(media_attach_harness(record: bundle.run.media),
    concat(handoff_media_harness(h: bundle.run.handoff_media),
    concat(override_harness(c: bundle.run.override),
    concat(power_after_harness(p: bundle.run.power_after),
      if bundle.inventory.credential_removed { [] } else { [CredentialMayRemain] })))))
}

fn mtcollins1_boot_findings(bundle: MtCollins1BootDiagnosticBundle) -> MtCollins1BootFindings {
  MtCollins1BootFindings { account: mtcollins1_power_on_account(e: mtcollins1_boot_evidence(bundle: bundle)), harness: mtcollins1_boot_harness(bundle: bundle) }
}

fn harness_finding_text(f: HarnessFinding) -> String {
  match f {
    EveryBmcReadFailed { failed: xs } => bmc_all_failed_text(failed: xs)
    MediaAttachNotReady { record: r } => match r {
      MediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: res } =>
        concat("media attach: ", match media_attach_outcome_reason(outcome: res.outcome) { Present { value: why } => why Absent => "not ready" })
      MediaAttachNotAttempted { reason: why } => concat("media attach: not attempted: ", why as String)
    }
    MediaAttachSessionHeld { record: r } => match r {
      MediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: res } =>
        concat("media attach: the presentation is ready but the session was ", session_release_text(standing: res.session_release))
      MediaAttachNotAttempted { reason: why } => concat("media attach: not attempted: ", why as String)
    }
    HandoffWithheldAtRecheck { handoff: h } => match h {
      HandoffMediaWithheldAtRecheck { before: b } => concat("media was ready at the gate but the pre-handoff recheck did not admit it, so no boot-device or power write was made: ", recheck_text(v: presentation_still_served(result: b)))
      HandoffMediaNotReached { reason: _ } => "the pre-handoff recheck withheld the handoff"
      HandoffMediaAttempted { before: _, handoff: _, after: _ } => "the pre-handoff recheck withheld the handoff"
    }
    HandoffUnconfirmed { handoff: h } => match h {
      HandoffMediaAttempted { before: _, handoff: hc, after: _ } => match hc {
        HandoffAttemptedUnconfirmed { reason: r } => concat("the boot-device and power handoff was attempted and not confirmed: ", r)
        HandoffConfirmed => "the boot-device and power handoff was confirmed"
      }
      HandoffMediaNotReached { reason: _ } => "the boot-device and power handoff was not attempted"
      HandoffMediaWithheldAtRecheck { before: _ } => "the boot-device and power handoff was not attempted"
    }
    PresentationAfterHandoff { look: a } => match presentation_still_served(result: a) {
      PresentationStillReady => "after the handoff the presentation was still served"
      PresentationNoLongerReady { reason: why } => concat("the presentation was LOST at or after the boot-device and power handoff (", why as String, "): ", observation_text(r: a))
      PresentationUnobserved { reason: why } => concat("the post-handoff look was UNOBSERVED, so whether the presentation survived the handoff is INDETERMINATE (", why as String, "): ", observation_text(r: a))
      PresentationReadyButSessionHeld { held: r } => concat("after the handoff the presentation was served, but the look's own session was ", session_release_text(standing: r))
    }
    OverrideNotConsumed { consumption: c } => match c {
      OverrideStillPendingAfterAttempt => "the one-shot boot override was still pending after the attempt: the host did not boot through it"
      OverridePendingBeforeAttempt => "a boot override matching this attempt's was already pending before it was set, so its consumption cannot be attributed to this attempt"
      OverrideConsumedByCensusBoot => override_consumption_text(c: c)
      OverrideNoLongerPendingAfterAttempt => override_consumption_text(c: c)
      OverrideNotHandedOff { reason: _ } => override_consumption_text(c: c)
      OverrideConsumptionUnread { reason: _ } => override_consumption_text(c: c)
    }
    HostPoweredOffWithoutCensusEnd => "the host was powered off after the attempt without the census END marker"
    CredentialMayRemain => "the per-attempt Redfish netrc could not be removed; credential material may remain on the runner"
  }
}

// THE ONE-LINE CONSEQUENCE ON THE RUN'S OUTCOME: the account's notes (its ending, every stated error,
// degradation and anomaly) and every harness finding are appended to a refusal reason, and a success
// stays a success. This is the whole of the bundle's reach into the verdict.
fn mtcollins1_boot_outcome_with_findings(outcome: ProcessExit, findings: MtCollins1BootFindings) -> ProcessExit {
  match outcome {
    ExitSuccess => ExitSuccess
    ExitFailure { code: c, reason: r } =>
      ExitFailure { code: c, reason: concat(r, " | power-on account: ", join(mtcollins1_power_on_account_notes(a: findings.account), "; "),
        if count(findings.harness) == 0 { "" } else { concat(" | harness: ", join(map(findings.harness, f => harness_finding_text(f: f)), "; ")) }) }
  }
}

// ── RENDER ───────────────────────────────────────────────────────────────────────────────────
fn sel_snapshot_text(label: String, s: SelSnapshotReading) -> String {
  match s {
    SelSnapshotRead { raw: r, at: a } => concat(label, ": read at ", a as String, ", ", to_string(count(filter(split(s: r, delimiter: "\n"), l => trim(l) != ""))), " record(s)")
    SelSnapshotUnread { cause: c } => concat(label, ": UNREAD: ", bmc_read_cause_text(cause: c))
    SelSnapshotNotTaken { reason: why } => concat(label, ": NOT TAKEN: ", why as String)
  }
}

fn sdr_cache_text(s: SdrCacheReading) -> String {
  match s {
    SdrCacheDumped { path: p, at: a } => concat("sdr cache: dumped at ", a as String, " to ", p as String, "; both snapshots read through it")
    SdrCacheUnread { cause: c } => concat("sdr cache: UNREAD: ", bmc_read_cause_text(cause: c), "; both snapshots read the controller's SDR uncached")
    SdrCacheNotTaken { reason: why } => concat("sdr cache: NOT TAKEN: ", why as String)
  }
}

fn sel_raw_text(label: String, s: SelSnapshotReading) -> String {
  match s {
    SelSnapshotRead { raw: r, at: _ } => concat("-- raw ", label, " (ipmitool sel elist, verbatim) --\n", r)
    SelSnapshotUnread { cause: _ } => concat("-- raw ", label, ": none --")
    SelSnapshotNotTaken { reason: _ } => concat("-- raw ", label, ": none --")
  }
}

fn sel_delta_text(delta: SelDeltaReading) -> String {
  match delta {
    SelDeltaDecoded { delta: d } =>
      concat("delta: ", to_string(count(d.events)), " new record(s) (", to_string(count(filter(d.events, e => sel_event_is_oem(event: e)))), " OEM, kept opaque)\n",
        join(map(d.events, e => concat("  ", sel_event_text(event: e))), "\n"))
    SelDeltaRefused { cause: c } => concat("delta: REFUSED: ", c as String, " (both raw snapshots below)")
    SelDeltaUnavailable { reason: r } => concat("delta: UNAVAILABLE: ", r)
  }
}

fn optional_int_text(n: Int?) -> String {
  match n { Present { value: v } => to_string(v) Absent => "not-reported" }
}

fn memory_location_text(location: RedfishMemoryLocation?) -> String {
  match location {
    Absent => " location=not-reported"
    Present { value: l } => concat(" socket=", optional_int_text(n: l.socket), " controller=", optional_int_text(n: l.memory_controller), " channel=", optional_int_text(n: l.channel), " slot=", optional_int_text(n: l.slot))
  }
}

fn memory_member_text(m: RedfishMemoryMember) -> String {
  concat("  ", memory_label(m: m), memory_location_text(location: m.memory_location),
    " capacity_mib=", optional_int_text(n: m.capacity_mib), " ", status_text(status: m.status))
}

fn optional_text_or_not_reported(s: String?) -> String {
  match s { Present { value: v } => v Absent => "not-reported" }
}

fn processor_member_text(p: RedfishProcessorMember) -> String {
  concat("  ", p.id as String, " socket=", optional_text_or_not_reported(s: p.socket),
    " total_cores=", optional_int_text(n: p.total_cores), " ", status_text(status: p.status))
}

fn memory_members_text(m: MembersReading<RedfishMemoryMember>) -> String {
  match m {
    MembersRead { members: ms } => concat("memory: ", to_string(count(ms)), " member(s)\n", join(map(ms, x => memory_member_text(m: x)), "\n"))
    MembersUnread { cause: c } => concat("memory: UNREAD: ", bmc_read_cause_text(cause: c))
    MembersNotTaken { reason: why } => concat("memory: NOT TAKEN: ", why as String)
  }
}

fn processor_members_text(m: MembersReading<RedfishProcessorMember>) -> String {
  match m {
    MembersRead { members: ps } => concat("processors: ", to_string(count(ps)), " member(s)\n", join(map(ps, x => processor_member_text(p: x)), "\n"))
    MembersUnread { cause: c } => concat("processors: UNREAD: ", bmc_read_cause_text(cause: c))
    MembersNotTaken { reason: why } => concat("processors: NOT TAKEN: ", why as String)
  }
}

fn bracketed_int(label: String, n: Int?) -> String {
  match n { Present { value: k } => concat(" [", label, " ", to_string(k), "]") Absent => "" }
}

fn firmware_report_text(report: FirmwareConsoleReport) -> String {
  match report {
    NoTerminalStated => "firmware stated no terminal"
    UndecodedErrorCodesOnly { err_lines: n } => concat("firmware printed ", to_string(n), " undecoded ERR code line(s)")
    FirmwareErrorStatementUnrecognized { statement: s } => concat("firmware printed an unrecognised statement: ", s as String)
    TrainingRefusedByFirmware { statement: s, locus: l } =>
      concat("firmware refused memory training: ", s as String, bracketed_int(label: "socket", n: l.socket), bracketed_int(label: "memory controller", n: l.memory_controller))
  }
}

fn grub_report_text(report: GrubConsoleReport) -> String {
  match report {
    GrubNothingStated => "GRUB: nothing printed"
    GrubBannerOnly => "GRUB: banner printed, no error"
    GrubStillTrying { errors: es } => concat("GRUB: still trying after ", join(map(es, e => grub_error_text(error: e)), "; "))
    GrubBootFailed { errors: es } => concat("GRUB: boot FAILED: ", join(map(es, e => grub_error_text(error: e)), "; "))
  }
}

fn console_text(c: ConsoleReading) -> String {
  match c {
    ConsoleRetained { path: p, size: b, lines: n, firmware: f, firmware_error_lines: e, capture_digest: _, dram: d, checkpoints: cp, checkpoint_relations: rs, milestones: ms, sockets: o, against_reference: cmp, loader: g, linux: l, modules: m, nvparam: nv, span_readings: _ } =>
      concat("capture ", p as String, " retained in this artifact: ", to_string(byte_size_count(b: b)), " bytes (stat), ", to_string(n), " line(s), within the ", to_string(byte_size_count(b: mtcollins1_boot_console_bound)), "-byte bound; ", firmware_report_text(report: f), "; ", to_string(e), " firmware error line(s)\n", ampere_dram_console_text(observation: d, expected_sockets: mtcollins1_census_sockets()), "\n-- checkpoints --\n", ampere_checkpoint_console_text(o: cp), "\n", if count(rs) == 0 { "no checkpoint relation" } else { join(map(rs, r => ampere_checkpoint_relation_text(r: r)), "\n") }, "\n-- milestones --\n", if count(ms.sightings) == 0 { "none" } else { join(map(ms.sightings, x => console_milestone_sighting_text(s: x)), "\n") }, "\n", ampere_socket_console_text(o: o), ampere_socket_reference_comparison_text(c: cmp), "\n-- loader and linux --\n", grub_report_text(report: g), "\n", linux_boot_console_text(o: l), "\n", kernel_module_decompression_text(o: m), "\n", ampere_nvparam_console_text(o: nv))
    ConsoleExceedsBound { path: p, size: b, bound: bound } =>
      concat("capture ", p as String, " is ", to_string(byte_size_count(b: b)), " bytes (stat), OVER the ", to_string(byte_size_count(b: bound)), "-byte bound; the collector does not truncate, so the artifact carries it whole")
    ConsoleNotRetained { path: p } =>
      concat("capture ", p as String, " is NOT under ", mtcollins1_boot_retained_artifact_prefix, " and is not uploaded with this artifact")
    ConsoleUnread { path: p, detail: d } => concat("capture ", p as String, " UNREAD: ", d)
    ConsoleNotConfigured => "NOT CONFIGURED: the SOL capture path was unset for this attempt"
  }
}

fn sensors_text(s: SensorReading) -> String {
  match s {
    SensorsRead { lines: ls, at: a } => concat("read at ", a as String, ": ", mtcollins1_sensor_table_text(lines: ls, sockets: mtcollins1_census_sockets()))
    SensorsUnread { cause: c } => concat("UNREAD: ", bmc_read_cause_text(cause: c))
    SensorsNotTaken { reason: why } => concat("NOT TAKEN: ", why as String)
  }
}

fn mtcollins1_boot_bundle_text(bundle: MtCollins1BootDiagnosticBundle) -> String {
  let findings = mtcollins1_boot_findings(bundle: bundle)
  join([
    "mtcollins1 boot diagnostics",
    concat("attempt=", attempt_identity_text(a: bundle.attempt)),
    concat("outcome=", bundle.outcome),
    "== our best understanding of what happened (the power-on account) ==",
    mtcollins1_power_on_account_text(a: findings.account),
    "== what our harness did ==",
    if count(findings.harness) == 0 { "nothing to report" } else { join(map(findings.harness, f => harness_finding_text(f: f)), "\n") },
    "== bmc system event log ==",
    sel_snapshot_text(label: "before", s: bundle.sel_before),
    sel_snapshot_text(label: "after", s: bundle.sel_after),
    sdr_cache_text(s: bundle.sdr_cache),
    sel_delta_text(delta: sel_delta_reading(before: bundle.sel_before, after: bundle.sel_after)),
    sel_raw_text(label: "before", s: bundle.sel_before),
    sel_raw_text(label: "after", s: bundle.sel_after),
    "== bmc sensors (ipmi sdr elist) ==",
    sensors_text(s: bundle.sensors),
    "== this attempt: power, one-shot override, in-run smpro passes ==",
    run_record_text(r: bundle.run),
    "== smpro boot stage (ipmi master write-read) ==",
    "-- pass after the attempt --",
    smpro_text(s: bundle.smpro),
    "== bmc inventory (redfish) ==",
    concat("system=", if bundle.inventory.system_id == "" { "not-read" } else { bundle.inventory.system_id }),
    processor_members_text(m: bundle.inventory.processors),
    memory_members_text(m: bundle.inventory.memory),
    "== pre-os console ==",
    console_text(c: bundle.console),
    "== bmc kvm screen (held observer; stills retained, not interpreted) ==",
    kvm_observer_record_text(rec: bundle.screen),
    "",
  ], "\n")
}

// ── THE DIAGNOSTICS DEADLINE ─────────────────────────────────────────────────────────────────
//
// THE DIAGNOSTIC TRANSACTION HAS A TYPED OUTER BOUND, and the step's time allowance is DERIVED
// from it rather than guessed. Every read is individually bounded by its transport: each SEL
// snapshot runs under coreutils `timeout` (deadline plus --kill-after), and each Redfish GET under
// curl --max-time. The Redfish reads are counted against a READ BUDGET, and a read the budget
// cannot pay for is not made: its section records BmcDeadlineReached naming what was not reached,
// and the attempt still shreds its netrc and writes the bundle. So the worst case is a sum of
// bounds -- mtcollins1_boot_diagnostics_allowance below -- and an unbounded collection cannot push
// the step past its timeout before cleanup and publish run.
//
// The budget is sized for this board's inventory as the census observed it (the service root, 1 Systems page, the
// system, 1 Processors page and 2 processors, 1 Memory page and 32 slots: 39 reads) with room for
// extra pages; a firmware that pages more finely spends the rest and says so.
data mtcollins1_boot_redfish_read_deadline: Second = second(count: 15)

// The two SEL snapshots, the one SDR dump, the one sensor read and every SMpro probe the post-attempt
// pass can send
// (gunbc.machine_intake_ampere_smpro_observation smpro_site_probe_bound) each run under
// the same coreutils bound. The reads taken under the unit hold -- the two in-run SMpro passes, the
// two boot parameter 5 reads and the final-power poll -- are paid inside the actuation, and their
// allowance is gunbc.machine_intake_mtcollins1_boot_run mtcollins1_boot_in_run_smpro_allowance.
fn mtcollins1_boot_ipmi_read_count() -> Int {
  4 + smpro_site_probe_bound(standing: mtcollins1_smpro_site())
}

data mtcollins1_boot_redfish_read_budget: Int = 48

data mtcollins1_boot_collection_page_bound: Int = 8

data mtcollins1_boot_collection_member_bound: Int = 40

// The netrc shred and the bundle and receipt writes: local file operations.
data mtcollins1_boot_publish_allowance: Second = second(count: 60)

fn mtcollins1_boot_diagnostics_allowance() -> Second {
  let sel = mtcollins1_boot_ipmi_read_count() * ((second_count(s: mtcollins1_boot_ipmi_read_deadline) as Int) + (second_count(s: mtcollins1_boot_ipmi_kill_after) as Int))
  let redfish = mtcollins1_boot_redfish_read_budget * (second_count(s: mtcollins1_boot_redfish_read_deadline) as Int)
  second(count: sel + redfish + (second_count(s: mtcollins1_boot_publish_allowance) as Int))
}

// ── READS (effects) ──────────────────────────────────────────────────────────────────────────
fn mtcollins1_ipmi_endpoint() -> NonEmptyStr {
  concat("ipmi lanplus ", mtcollins1_endpoint.host as String) as NonEmptyStr
}

fn mtcollins1_redfish_url(path: String) -> NonEmptyStr {
  concat("https://", mtcollins1_endpoint.host as String, path) as NonEmptyStr
}

fn mtcollins1_boot_sdr_cache(username: NonEmptyStr, password_file: NonEmptyStr, path: NonEmptyStr) -> SdrCacheReading
{
  let at = clock_now_probed_at_or_unknown()
  let r = diagnostic.ipmi.Tool.SdrDumpAuthenticated(
    bmc_host: mtcollins1_endpoint.host,
    username: username,
    password_file: password_file,
    sdr_cache_file: path,
    deadline: coreutils_duration_operand(d: mtcollins1_boot_ipmi_read_deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: mtcollins1_boot_ipmi_kill_after) as NonEmptyStr,
  )
  if r.success {
    SdrCacheDumped { path: path, at: at }
  } else {
    SdrCacheUnread { cause: bmc_ipmitool_read_cause(endpoint: mtcollins1_ipmi_endpoint(), at: at, exit_code: r.exit_code, stderr: r.transport_stderr) }
  }
}

fn mtcollins1_boot_sensors(username: NonEmptyStr, password_file: NonEmptyStr, sdr: SdrCacheReading) -> SensorReading
{
  match sdr {
    SdrCacheDumped { path: p, at: _ } => {
      let at = clock_now_probed_at_or_unknown()
      let r = diagnostic.ipmi.Tool.SdrElistAuthenticatedCached(
        bmc_host: mtcollins1_endpoint.host,
        username: username,
        password_file: password_file,
        sdr_cache_file: p,
        deadline: coreutils_duration_operand(d: mtcollins1_boot_ipmi_read_deadline) as NonEmptyStr,
        kill_after: coreutils_duration_operand(d: mtcollins1_boot_ipmi_kill_after) as NonEmptyStr,
      )
      if r.success {
        SensorsRead { lines: sdr_decode_lines(stdout: r.stdout), at: at }
      } else {
        SensorsUnread { cause: bmc_ipmitool_read_cause(endpoint: mtcollins1_ipmi_endpoint(), at: at, exit_code: r.exit_code, stderr: r.transport_stderr) }
      }
    }
    SdrCacheUnread { cause: c } => SensorsNotTaken { reason: concat("no SDR cache was dumped (", bmc_read_cause_kind(cause: c), "), and an uncached sdr elist is not made") as NonEmptyStr }
    SdrCacheNotTaken { reason: why } => SensorsNotTaken { reason: why }
  }
}

fn mtcollins1_boot_param5(username: NonEmptyStr, password_file: NonEmptyStr) -> BootParam5Reading
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_param5_under_hold"),
  ]
{
  let at = clock_now_probed_at_or_unknown()
  let r = diagnostic.ipmi.Tool.ChassisBootParamGet(
    bmc_host: mtcollins1_endpoint.host,
    username: username,
    password_file: password_file,
    parameter: "5",
    deadline: coreutils_duration_operand(d: mtcollins1_boot_ipmi_read_deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: mtcollins1_boot_ipmi_kill_after) as NonEmptyStr,
  )
  if r.success {
    BootParam5Read { readback: r.stdout, at: at }
  } else {
    BootParam5Unread { cause: bmc_ipmitool_read_cause(endpoint: mtcollins1_ipmi_endpoint(), at: at, exit_code: r.exit_code, stderr: r.transport_stderr) }
  }
}

fn mtcollins1_boot_chassis_power(username: NonEmptyStr, password_file: NonEmptyStr) -> ChassisPowerObservation
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_power_after_poll"),
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_channel_lost"),
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_media_attach", decl_name: "mtcollins1_attach_diskless_image"),
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_media_attach", decl_name: "mtcollins1_stale_power_off_poll"),
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_media_attach", decl_name: "mtcollins1_power_after_stale_power_off"),
  ]
{
  let r = diagnostic.ipmi.Tool.ChassisStatus(
    bmc_host: mtcollins1_endpoint.host,
    username: username,
    password_file: password_file,
    deadline: coreutils_duration_operand(d: mtcollins1_boot_ipmi_read_deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: mtcollins1_boot_ipmi_kill_after) as NonEmptyStr,
  )
  chassis_observation(success: r.success, stdout: r.stdout)
}

// WHETHER AN `mc info` READ SUCCEEDED, AS ITS OWN FRESH OBSERVATION. A lost SOL channel says nothing
// about the BMC or the chassis by itself. A read that did not succeed is NOT a statement that the
// controller gave no answer: a local tool failure, an authentication refusal or a session that could
// not be set up all fail the read while the controller may be answering. So the failed arm carries
// the typed BmcReadCause and nothing stronger; only its BmcTimeout arm says no answer arrived within
// the deadline.
type BmcReachability
  = BmcAnswered { at: NonEmptyStr }
  | BmcReadNotSucceeded { cause: BmcReadCause }

fn bmc_reachability_text(reading: BmcReachability) -> String {
  match reading {
    BmcAnswered { at: at } => concat("BMC answered mc info at ", at as String)
    BmcReadNotSucceeded { cause: c } => concat("mc info did not succeed: ", bmc_read_cause_text(cause: c))
  }
}

fn bmc_reachability_of_read(at: NonEmptyStr, success: Bool, exit_code: Int, stderr: String) -> BmcReachability {
  if success {
    BmcAnswered { at: at }
  } else {
    BmcReadNotSucceeded { cause: bmc_ipmitool_read_cause(endpoint: mtcollins1_ipmi_endpoint(), at: at, exit_code: exit_code, stderr: stderr) }
  }
}

fn mtcollins1_boot_bmc_reachability(username: NonEmptyStr, password_file: NonEmptyStr) -> BmcReachability
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_channel_lost"),
  ]
{
  let at = clock_now_probed_at_or_unknown()
  let r = diagnostic.ipmi.Tool.McInfo(
    bmc_host: mtcollins1_endpoint.host,
    username: username,
    password_file: password_file,
    deadline: coreutils_duration_operand(d: mtcollins1_boot_ipmi_read_deadline) as NonEmptyStr,
    kill_after: coreutils_duration_operand(d: mtcollins1_boot_ipmi_kill_after) as NonEmptyStr,
  )
  bmc_reachability_of_read(at: at, success: r.success, exit_code: r.exit_code, stderr: r.transport_stderr)
}

fn sel_snapshot_of_read(at: NonEmptyStr, success: Bool, stdout: String, exit_code: Int, stderr: String) -> SelSnapshotReading {
  if success {
    SelSnapshotRead { raw: stdout, at: at }
  } else {
    SelSnapshotUnread { cause: bmc_ipmitool_read_cause(endpoint: mtcollins1_ipmi_endpoint(), at: at, exit_code: exit_code, stderr: stderr) }
  }
}

fn mtcollins1_boot_sel_snapshot_uncached(at: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, deadline: NonEmptyStr, kill_after: NonEmptyStr) -> SelSnapshotReading {
  let r = diagnostic.ipmi.Tool.SelListAuthenticated(bmc_host: mtcollins1_endpoint.host, username: username, password_file: password_file, deadline: deadline, kill_after: kill_after)
  sel_snapshot_of_read(at: at, success: r.success, stdout: r.stdout, exit_code: r.exit_code, stderr: r.transport_stderr)
}

fn mtcollins1_boot_sel_snapshot(username: NonEmptyStr, password_file: NonEmptyStr, sdr: SdrCacheReading) -> SelSnapshotReading
{
  let at = clock_now_probed_at_or_unknown()
  let deadline = coreutils_duration_operand(d: mtcollins1_boot_ipmi_read_deadline) as NonEmptyStr
  let kill_after = coreutils_duration_operand(d: mtcollins1_boot_ipmi_kill_after) as NonEmptyStr
  match sdr {
    SdrCacheDumped { path: p, at: _ } => {
      let r = diagnostic.ipmi.Tool.SelListAuthenticatedCached(bmc_host: mtcollins1_endpoint.host, username: username, password_file: password_file, sdr_cache_file: p, deadline: deadline, kill_after: kill_after)
      sel_snapshot_of_read(at: at, success: r.success, stdout: r.stdout, exit_code: r.exit_code, stderr: r.transport_stderr)
    }
    SdrCacheUnread { cause: _ } => mtcollins1_boot_sel_snapshot_uncached(at: at, username: username, password_file: password_file, deadline: deadline, kill_after: kill_after)
    SdrCacheNotTaken { reason: _ } => mtcollins1_boot_sel_snapshot_uncached(at: at, username: username, password_file: password_file, deadline: deadline, kill_after: kill_after)
  }
}

// ── COLLECTION COMPLETENESS (pure) ───────────────────────────────────────────────────────────
//
// A COLLECTION IS COMPLETE ONLY WHEN ITS PAGES ACCOUNT FOR ITS COUNT. The pages are the ones the
// reader followed through Members@odata.nextLink; the first page's Members@odata.count is the
// total DSP0266 says every page reports. No count, a last page that still names a next page, a
// member total different from the count, a count over the member bound, or a member link that is
// not a same-origin path: each refuses as incomplete, and no member is read. A short inventory is
// therefore never inferred from a first page alone.
type CollectionAssembly
  = CollectionComplete { links: List<NonEmptyStr> }
  | CollectionRefused { detail: NonEmptyStr }

fn redfish_collection_assembly(pages: List<RedfishCollectionPage>, member_bound: Int) -> CollectionAssembly {
  match pages.first() {
    Absent => CollectionRefused { detail: "no collection page was read" }
    Present { value: first } =>
      match first.member_count {
        Absent => CollectionRefused { detail: "the first page carries no Members@odata.count, so completeness cannot be established" }
        Present { value: total } => {
          let links = fold(pages, init: [], f: (acc, p) => concat(acc, p.member_links))
          let last_has_next = match reverse(pages).first() { Absent => false Present { value: p } => p.next_link != none }
          let refused_links = filter(links, l => match redfish_same_origin_link(link: l) { RedfishLinkRefused { cause: _ } => true RedfishLinkSameOrigin { path: _ } => false })
          let disagreeing = filter(pages, p => p.member_count != Present { value: total })
          let duplicated = first_duplicate(xs: links)
          if count(disagreeing) > 0 {
            CollectionRefused { detail: concat("a page reports Members@odata.count ", match disagreeing.first() { Absent => "" Present { value: p } => match p.member_count { Present { value: n } => to_string(n) Absent => "none" } }, " where the first page reported ", to_string(total)) as NonEmptyStr }
          } else if duplicated != none {
            CollectionRefused { detail: concat("member link ", match duplicated { Present { value: d } => d Absent => "" }, " is listed more than once") as NonEmptyStr }
          } else if last_has_next {
            CollectionRefused { detail: concat("the last page read still carries Members@odata.nextLink; ", to_string(count(links)), " of ", to_string(total), " member(s) read") as NonEmptyStr }
          } else if total > member_bound {
            CollectionRefused { detail: concat("Members@odata.count ", to_string(total), " exceeds the member bound ", to_string(member_bound)) as NonEmptyStr }
          } else if count(links) != total {
            CollectionRefused { detail: concat("Members@odata.count ", to_string(total), " but ", to_string(count(links)), " member link(s) across ", to_string(count(pages)), " page(s)") as NonEmptyStr }
          } else if count(refused_links) > 0 {
            CollectionRefused { detail: concat("member link is not a same-origin path: ", match refused_links.first() { Absent => "" Present { value: l } => l }) as NonEmptyStr }
          } else {
            CollectionComplete { links: map(links, l => l as NonEmptyStr) }
          }
        }
      }
  }
}

fn first_duplicate(xs: List<String>) -> String? {
  let empty: List<String> = []
  let found: String? = none
  let done = fold(xs, init: MembersSeen { seen: empty, duplicate: found }, f: (acc, x) => match acc.duplicate {
    Present { value: _ } => acc
    Absent => if any(acc.seen, y => y == x) { MembersSeen { seen: acc.seen, duplicate: Present { value: x } } } else { MembersSeen { seen: concat(acc.seen, [x]), duplicate: none } }
  })
  done.duplicate
}

type MembersSeen { seen: List<String>, duplicate: String? }

// ── MEMBER IDENTITY (pure) ───────────────────────────────────────────────────────────────────
//
// A COLLECTION IS IDENTITY-COMPLETE, NOT ONLY COUNT-COMPLETE: every member answered at the link that
// named it (its returned `@odata.id` is that link) and no two members returned one `Id`. A member
// that answers as another resource, or two links that resolve to one DIMM, would otherwise make a
// full count out of fewer slots. Any mismatch leaves the section unread, so no inventory-count
// finding can be minted from it.
type MemberBody { link: NonEmptyStr, body: String }

fn member_link_mismatch(m: MemberBody) -> String? {
  match redfish_resource_odata_id(body: m.body) {
    ObservationRefused { cause: c } => Present { value: concat("member at ", m.link as String, ": ", c as String) }
    ObservationEstablished { observed: returned } =>
      if (returned as String) == (m.link as String) { none } else { Present { value: concat("link ", m.link as String, " returned the resource ", returned as String) } }
  }
}

fn first_member_mismatch(bodies: List<MemberBody>) -> String? {
  match filter(map(bodies, b => member_link_mismatch(m: b)), r => r != none).first() {
    Absent => none
    Present { value: r } => r
  }
}

fn memory_member_ids(ms: List<RedfishMemoryMember>) -> List<String> {
  map(ms, m => m.id as String)
}

fn processor_member_ids(ps: List<RedfishProcessorMember>) -> List<String> {
  map(ps, p => p.id as String)
}

fn assemble_memory_members(collection: NonEmptyStr, at: NonEmptyStr, bodies: List<MemberBody>) -> MembersReading<RedfishMemoryMember> {
  match first_member_mismatch(bodies: bodies) {
    Present { value: why } => MembersUnread { cause: BmcResponseMalformed { endpoint: mtcollins1_redfish_url(path: collection as String), at: at, detail: why } }
    Absent => {
      let empty: List<RedfishMemoryMember> = []
      let parsed = fold(bodies, init: MembersRead { members: empty }, f: (acc, b) => match acc {
        MembersRead { members: ms } => match redfish_memory_member_of(body: b.body) {
          ObservationRefused { cause: c } => MembersUnread { cause: BmcResponseMalformed { endpoint: mtcollins1_redfish_url(path: b.link as String), at: at, detail: c as String } }
          ObservationEstablished { observed: m } => MembersRead { members: concat(ms, [m]) }
        }
        other => other
      })
      match parsed {
        MembersRead { members: ms } => match first_duplicate(xs: memory_member_ids(ms: ms)) {
          Present { value: d } => MembersUnread { cause: BmcCollectionIncomplete { endpoint: mtcollins1_redfish_url(path: collection as String), at: at, detail: concat("two member links returned the same Id ", d) } }
          Absent => parsed
        }
        other => other
      }
    }
  }
}

fn assemble_processor_members(collection: NonEmptyStr, at: NonEmptyStr, bodies: List<MemberBody>) -> MembersReading<RedfishProcessorMember> {
  match first_member_mismatch(bodies: bodies) {
    Present { value: why } => MembersUnread { cause: BmcResponseMalformed { endpoint: mtcollins1_redfish_url(path: collection as String), at: at, detail: why } }
    Absent => {
      let empty: List<RedfishProcessorMember> = []
      let parsed = fold(bodies, init: MembersRead { members: empty }, f: (acc, b) => match acc {
        MembersRead { members: ps } => match redfish_processor_member_of(body: b.body) {
          ObservationRefused { cause: c } => MembersUnread { cause: BmcResponseMalformed { endpoint: mtcollins1_redfish_url(path: b.link as String), at: at, detail: c as String } }
          ObservationEstablished { observed: p } => MembersRead { members: concat(ps, [p]) }
        }
        other => other
      })
      match parsed {
        MembersRead { members: ps } => match first_duplicate(xs: processor_member_ids(ps: ps)) {
          Present { value: d } => MembersUnread { cause: BmcCollectionIncomplete { endpoint: mtcollins1_redfish_url(path: collection as String), at: at, detail: concat("two member links returned the same Id ", d) } }
          Absent => parsed
        }
        other => other
      }
    }
  }
}

// ── REDFISH READS UNDER THE BUDGET ───────────────────────────────────────────────────────────
// THE BUDGET DECISION IS PURE: a read the budget cannot pay for is refused before any request is
// made, and the refusal names what the transaction did not reach.
fn redfish_budget_refusal(url: NonEmptyStr, at: NonEmptyStr, left: Int, not_reached: String) -> BmcReadCause? {
  if left <= 0 { Present { value: BmcDeadlineReached { endpoint: url, at: at, not_reached: not_reached } } } else { none }
}

type RedfishGet
  = RedfishGot { body: String, left: Int }
  | RedfishGetFailed { cause: BmcReadCause, left: Int }

fn redfish_get(netrc: NonEmptyStr, path: NonEmptyStr, left: Int, not_reached: String) -> RedfishGet
{
  let at = clock_now_probed_at_or_unknown()
  match redfish_budget_refusal(url: mtcollins1_redfish_url(path: path as String), at: at, left: left, not_reached: not_reached) {
    Present { value: c } => return RedfishGetFailed { cause: c, left: left }
    Absent => {}
  }
  let r = redfish.Http.GetResourceByPath(
    bmc_host: mtcollins1_endpoint.host,
    netrc_file: netrc,
    odata_path: path,
    max_seconds: to_string(second_count(s: mtcollins1_boot_redfish_read_deadline)) as NonEmptyStr,
  )
  if r.success {
    RedfishGot { body: r.body, left: left - 1 }
  } else {
    RedfishGetFailed { cause: bmc_curl_read_cause(endpoint: mtcollins1_redfish_url(path: path as String), at: at, exit_code: r.exit_code, stderr: r.transport_stderr), left: left - 1 }
  }
}

type CollectionFetch
  = CollectionFetched { links: List<NonEmptyStr>, left: Int }
  | CollectionFetchFailed { cause: BmcReadCause, left: Int }

fn fetch_collection_pages(
  netrc: NonEmptyStr,
  collection: NonEmptyStr,
  page: NonEmptyStr,
  pages_left: Int,
  left: Int,
  read: List<RedfishCollectionPage>,
) -> CollectionFetch
{
  let at = clock_now_probed_at_or_unknown()
  if pages_left <= 0 {
    return CollectionFetchFailed { cause: BmcCollectionIncomplete { endpoint: mtcollins1_redfish_url(path: collection as String), at: at, detail: concat("page bound ", to_string(mtcollins1_boot_collection_page_bound), " reached with Members@odata.nextLink still pending") }, left: left }
  }
  match redfish_get(netrc: netrc, path: page, left: left, not_reached: concat("the rest of ", collection as String, " and every member of it")) {
    RedfishGetFailed { cause: c, left: l } => CollectionFetchFailed { cause: c, left: l }
    RedfishGot { body: body, left: l } =>
      match redfish_collection_page_of(body: body) {
        ObservationRefused { cause: c } => CollectionFetchFailed { cause: BmcResponseMalformed { endpoint: mtcollins1_redfish_url(path: page as String), at: at, detail: c as String }, left: l }
        ObservationEstablished { observed: p } => {
          let pages = concat(read, [p])
          match p.next_link {
            Present { value: next } =>
              match redfish_same_origin_link(link: next) {
                RedfishLinkRefused { cause: why } => CollectionFetchFailed { cause: BmcCollectionIncomplete { endpoint: mtcollins1_redfish_url(path: page as String), at: at, detail: concat("Members@odata.nextLink not followed: ", why as String) }, left: l }
                RedfishLinkSameOrigin { path: next_path } => fetch_collection_pages(netrc: netrc, collection: collection, page: next_path, pages_left: pages_left - 1, left: l, read: pages)
              }
            Absent =>
              match redfish_collection_assembly(pages: pages, member_bound: mtcollins1_boot_collection_member_bound) {
                CollectionRefused { detail: d } => CollectionFetchFailed { cause: BmcCollectionIncomplete { endpoint: mtcollins1_redfish_url(path: collection as String), at: at, detail: d as String }, left: l }
                CollectionComplete { links: links } => CollectionFetched { links: links, left: l }
              }
          }
        }
      }
  }
}

fn fetch_collection(netrc: NonEmptyStr, collection: NonEmptyStr, left: Int) -> CollectionFetch
{
  fetch_collection_pages(netrc: netrc, collection: collection, page: collection, pages_left: mtcollins1_boot_collection_page_bound, left: left, read: [])
}

type MemoryFold { reading: MembersReading<RedfishMemoryMember>, left: Int }

type ProcessorFold { reading: MembersReading<RedfishProcessorMember>, left: Int }

fn member_not_reached(total: Int, read: Int) -> String {
  concat(to_string(total - read), " of ", to_string(total), " member read(s)")
}

type MemberBodiesFetch
  = MemberBodiesFetched { bodies: List<MemberBody>, left: Int }
  | MemberBodiesFailed { cause: BmcReadCause, left: Int }

fn fetch_member_bodies(netrc: NonEmptyStr, links: List<NonEmptyStr>, left: Int) -> MemberBodiesFetch
{
  let empty: List<MemberBody> = []
  fold(links, init: MemberBodiesFetched { bodies: empty, left: left }, f: (acc, link) => match acc {
    MemberBodiesFetched { bodies: bs, left: l } =>
      match redfish_get(netrc: netrc, path: link, left: l, not_reached: member_not_reached(total: count(links), read: count(bs))) {
        RedfishGetFailed { cause: c, left: l2 } => MemberBodiesFailed { cause: c, left: l2 }
        RedfishGot { body: body, left: l2 } => MemberBodiesFetched { bodies: concat(bs, [MemberBody { link: link, body: body }]), left: l2 }
      }
    other => other
  })
}

fn read_memory_members(netrc: NonEmptyStr, collection: NonEmptyStr, links: List<NonEmptyStr>, left: Int) -> MemoryFold
{
  match fetch_member_bodies(netrc: netrc, links: links, left: left) {
    MemberBodiesFailed { cause: c, left: l } => MemoryFold { reading: MembersUnread { cause: c }, left: l }
    MemberBodiesFetched { bodies: bs, left: l } => MemoryFold { reading: assemble_memory_members(collection: collection, at: clock_now_probed_at_or_unknown(), bodies: bs), left: l }
  }
}

fn read_processor_members(netrc: NonEmptyStr, collection: NonEmptyStr, links: List<NonEmptyStr>, left: Int) -> ProcessorFold
{
  match fetch_member_bodies(netrc: netrc, links: links, left: left) {
    MemberBodiesFailed { cause: c, left: l } => ProcessorFold { reading: MembersUnread { cause: c }, left: l }
    MemberBodiesFetched { bodies: bs, left: l } => ProcessorFold { reading: assemble_processor_members(collection: collection, at: clock_now_probed_at_or_unknown(), bodies: bs), left: l }
  }
}

fn link_absent_cause(system: NonEmptyStr, property: String) -> BmcReadCause {
  BmcResponseMalformed { endpoint: mtcollins1_redfish_url(path: system as String), at: clock_now_probed_at_or_unknown(), detail: concat("the ComputerSystem publishes no ", property, " link, or a link that is not a same-origin path") }
}

fn same_origin_or_none(link: String?) -> NonEmptyStr? {
  match link {
    Absent => none
    Present { value: l } => match redfish_same_origin_link(link: l) {
      RedfishLinkSameOrigin { path: p } => Present { value: p }
      RedfishLinkRefused { cause: _ } => none
    }
  }
}

fn read_processors(netrc: NonEmptyStr, system: NonEmptyStr, link: String?, left: Int) -> ProcessorFold
{
  match same_origin_or_none(link: link) {
    Absent => ProcessorFold { reading: MembersUnread { cause: link_absent_cause(system: system, property: "Processors") }, left: left }
    Present { value: path } =>
      match fetch_collection(netrc: netrc, collection: path, left: left) {
        CollectionFetchFailed { cause: c, left: l } => ProcessorFold { reading: MembersUnread { cause: c }, left: l }
        CollectionFetched { links: links, left: l } => read_processor_members(netrc: netrc, collection: path, links: links, left: l)
      }
  }
}

fn read_memory(netrc: NonEmptyStr, system: NonEmptyStr, link: String?, left: Int) -> MemoryFold
{
  match same_origin_or_none(link: link) {
    Absent => MemoryFold { reading: MembersUnread { cause: link_absent_cause(system: system, property: "Memory") }, left: left }
    Present { value: path } =>
      match fetch_collection(netrc: netrc, collection: path, left: left) {
        CollectionFetchFailed { cause: c, left: l } => MemoryFold { reading: MembersUnread { cause: c }, left: l }
        CollectionFetched { links: links, left: l } => read_memory_members(netrc: netrc, collection: path, links: links, left: l)
      }
  }
}

// THE SELECTED SYSTEM IS IDENTITY-JOINED BEFORE ITS LINKS ARE FOLLOWED: the ComputerSystem that
// answered must return, as its own @odata.id, the link the Systems collection named. A system that
// answers as another resource would otherwise hand this attempt some other system's Memory and
// Processors, and every count finding after it would be about the wrong machine.
fn mtcollins1_system_inventory_links(requested: NonEmptyStr, body: String) -> ObservationAttempt<RedfishSystemInventoryLinks, NonEmptyStr> {
  match redfish_resource_odata_id(body: body) {
    ObservationRefused { cause: c } => ObservationRefused { cause: c }
    ObservationEstablished { observed: returned } =>
      if (returned as String) != (requested as String) {
        ObservationRefused { cause: concat("system link ", requested as String, " returned the resource ", returned as String) as NonEmptyStr }
      } else {
        redfish_system_inventory_links_of(body: body)
      }
  }
}

fn inventory_unread(cause: BmcReadCause) -> InventoryReading {
  InventoryReading { system_id: "", memory: MembersUnread { cause: cause }, processors: MembersUnread { cause: cause }, credential_removed: true }
}

// THE ONE AUTHORED REDFISH PATH: DSP0266 fixes the service root at `/redfish/v1/`, and every other
// resource this reader requests is a link the service published (hypermedia). Run 35871654468 asked
// for an authored `/redfish/v1/Systems` and got 404, which said nothing about whether this service
// publishes a Systems collection elsewhere; the root now says where, or that it publishes none.
data mtcollins1_redfish_service_root_path: NonEmptyStr = "/redfish/v1/"

// The service root's Systems link: a typed absence when unpublished, a refusal when not same-origin.
fn mtcollins1_systems_link(root_body: String, at: NonEmptyStr) -> ObservationAttempt<NonEmptyStr, BmcReadCause> {
  let root = mtcollins1_redfish_url(path: mtcollins1_redfish_service_root_path as String)
  match redfish_service_root_systems_link_of(body: root_body) {
    ObservationRefused { cause: c } => ObservationRefused { cause: BmcResponseMalformed { endpoint: root, at: at, detail: c as String } }
    ObservationEstablished { observed: Absent } => ObservationRefused { cause: BmcLinkUnpublished { endpoint: root, at: at, property: "Systems" } }
    ObservationEstablished { observed: Present { value: link } } =>
      match redfish_same_origin_link(link: link) {
        RedfishLinkSameOrigin { path: p } => ObservationEstablished { observed: p }
        RedfishLinkRefused { cause: d } => ObservationRefused { cause: BmcResponseMalformed { endpoint: root, at: at, detail: concat("service root Systems link refused: ", d as String) } }
      }
  }
}

// THE SYSTEM IS READ, NOT ASSUMED: the Systems collection must name exactly one member, whose own
// Memory and Processors links name the collections read next. Zero or several systems is a typed
// reading, since picking one would be a guess about which system the attempt booted.
fn read_inventory_with_netrc(netrc: NonEmptyStr) -> InventoryReading
{
  let at = clock_now_probed_at_or_unknown()
  match redfish_get(netrc: netrc, path: mtcollins1_redfish_service_root_path, left: mtcollins1_boot_redfish_read_budget, not_reached: "the service root and every inventory read after it") {
    RedfishGetFailed { cause: c, left: _ } => inventory_unread(cause: c)
    RedfishGot { body: root_body, left: after_root } =>
      match mtcollins1_systems_link(root_body: root_body, at: at) {
        ObservationRefused { cause: c } => inventory_unread(cause: c)
        ObservationEstablished { observed: systems_path } => read_inventory_from_systems(netrc: netrc, systems_path: systems_path, left: after_root, at: at)
      }
  }
}

fn read_inventory_from_systems(netrc: NonEmptyStr, systems_path: NonEmptyStr, left: Int, at: NonEmptyStr) -> InventoryReading
{
  match fetch_collection(netrc: netrc, collection: systems_path, left: left) {
    CollectionFetchFailed { cause: c, left: _ } => inventory_unread(cause: c)
    CollectionFetched { links: systems, left: left } =>
      if count(systems) != 1 {
        inventory_unread(cause: BmcResponseMalformed { endpoint: mtcollins1_redfish_url(path: systems_path as String), at: at, detail: concat("Systems collection has ", to_string(count(systems)), " members; exactly one names the booted system") })
      } else {
        match systems.first() {
          Absent => inventory_not_taken(reason: "Systems collection member vanished between count and read")
          Present { value: system } =>
            match redfish_get(netrc: netrc, path: system, left: left, not_reached: "the system resource and every inventory read after it") {
              RedfishGetFailed { cause: c, left: _ } => inventory_unread(cause: c)
              RedfishGot { body: body, left: l } =>
                match mtcollins1_system_inventory_links(requested: system, body: body) {
                  ObservationRefused { cause: c } => inventory_unread(cause: BmcResponseMalformed { endpoint: mtcollins1_redfish_url(path: system as String), at: at, detail: c as String })
                  ObservationEstablished { observed: links } => {
                    let processors = read_processors(netrc: netrc, system: system, link: links.processors, left: l)
                    let memory = read_memory(netrc: netrc, system: system, link: links.memory, left: processors.left)
                    InventoryReading { system_id: system as String, memory: memory.reading, processors: processors.reading, credential_removed: true }
                  }
                }
            }
        }
      }
  }
}

fn mtcollins1_boot_inventory(username: NonEmptyStr, password: String) -> InventoryReading
{
  let at = clock_now_probed_at_or_unknown()
  let endpoint = mtcollins1_redfish_url(path: mtcollins1_redfish_service_root_path as String)
  match place_netrc_binding_privately(machine: mtcollins1_endpoint.host, login: username, password: trim(s: password) as Secret) {
    NetrcBindingRefused { cause: c } => inventory_unread(cause: BmcCredentialUnavailable { endpoint: endpoint, at: at, detail: c as String })
    NetrcBindingRefusedResidueRemains { cause: c } => {
      let cause = BmcCredentialUnavailable { endpoint: endpoint, at: at, detail: c as String }
      InventoryReading { system_id: "", memory: MembersUnread { cause: cause }, processors: MembersUnread { cause: cause }, credential_removed: false }
    }
    NetrcBindingPlaced { binding: binding } => {
      let read = read_inventory_with_netrc(netrc: binding.path as NonEmptyStr)
      let removed = shred_netrc_binding(binding: binding)
      InventoryReading { system_id: read.system_id, memory: read.memory, processors: read.processors, credential_removed: removed }
    }
  }
}

fn console_path_retained(path: String) -> Bool {
  starts_with(s: path, prefix: mtcollins1_boot_retained_artifact_prefix) || string_contains(s: path, pattern: concat("/", mtcollins1_boot_retained_artifact_prefix))
}

// THE STAT SIZE CROSSES Int TO Nat THROUGH std.checked_arithmetic, NOT THROUGH A CAST. `n as Nat`
// typechecked here and refused only when it EVALUATED ("cannot cast Int to Nat"), so on run
// 35871654468 the first attempt that reached this read aborted the whole evaluation after the SEL
// and Redfish reads had already been typed, and neither the bundle nor the receipt was written
// (gunbc.recurring_failure_mode a_type_name_asserts_an_algebra_the_arithmetic_does_not_carry; the
// sibling repair is gunbc.runner_microvm_cell_readiness_store decode_attempt). The crossing is
// std.checked_arithmetic checked_int_to_nat, the one Int->Nat authority since #12166: a negative
// size is absent, never clamped and never its absolute value.
fn console_size_of_stat(size_text: String) -> ByteSize? {
  match parse_int(s: trim(size_text)) {
    Absent => none
    Present { value: n } =>
      match checked_int_to_nat(n: n) {
        Absent => none
        Present { value: count } => Present { value: byte_size(count: count) }
      }
  }
}

// THE TWO-SOCKET REFERENCE BOOT every capture is compared against: the census run of 2026-09-10,
// which reported 2 sockets and 160 CPUs and printed both the firmware summary and the Ampere CPER
// records for both sockets (gunbc.machine_intake_mtcollins1_memory_census_observation
// mtcollins1_census_sol_artifact_path; the comparison is
// gunbc.machine_intake_ampere_socket_console_observation ampere_socket_console_differences). It is
// read from the checkout the run executes in, so a reference that cannot be read is an UNREAD line
// in the bundle, never an empty comparison.
type ReferenceCaptureRead {
  text: String
  ok: Bool
  error: String
  digest: Sha256FileDigest
}

// THE REFERENCE'S SCOPE, for the opaque checkpoint relation (ruling R2): a continuation the reference
// shows is evidence only under the firmware and population it was taken with. Both are this
// capture's own record (gunbc.machine_intake_mtcollins1_memory_census_observation, 2026-09-10/11):
// two sockets, sixteen DIMMs, the firmware set installed before the 2026-10-02 update.
data mtcollins1_census_reference_firmware_scope: NonEmptyStr = "the vendor firmware set installed before the 2026-10-02 update"

data mtcollins1_census_reference_configuration_scope: NonEmptyStr = "two sockets, sixteen DIMMs (the 2026-09-10/11 census population)"

fn checkpoint_relations(checkpoints: AmpereCheckpointConsoleObservation, capture: Sha256FileDigest, reference: ReferenceCaptureRead) -> List<AmpereCheckpointRelation> {
  flat_map(checkpoints.spans, span => match if reference.ok {
      ampere_checkpoint_relation(span: span, capture: capture, reference: AmpereCheckpointReference {
        path: mtcollins1_census_sol_artifact_path, digest: reference.digest,
        firmware_scope: mtcollins1_census_reference_firmware_scope, configuration_scope: mtcollins1_census_reference_configuration_scope,
        observation: ampere_checkpoint_console_observation(lines: host_capture_lines(capture: HostCaptureLiveStream { text: reference.text })),
      })
    } else {
      ampere_checkpoint_relation_unread(span: span, capture: capture, path: mtcollins1_census_sol_artifact_path, digest: reference.digest,
        firmware_scope: mtcollins1_census_reference_firmware_scope, configuration_scope: mtcollins1_census_reference_configuration_scope, detail: reference.error)
    } { Absent => [] Present { value: r } => [r] })
}

// THE PURE DECISION over the capture's stat size and, when within the bound, its content.
fn mtcollins1_boot_console_reading(path: String, size: ByteSize, capture: String, read_ok: Bool, read_error: String, capture_digest: Sha256FileDigest, reference: ReferenceCaptureRead) -> ConsoleReading {
  if path == "" {
    ConsoleNotConfigured
  } else if !console_path_retained(path: path) {
    ConsoleNotRetained { path: path as NonEmptyStr }
  } else if (byte_size_count(b: size) as Int) > (byte_size_count(b: mtcollins1_boot_console_bound) as Int) {
    ConsoleExceedsBound { path: path as NonEmptyStr, size: size, bound: mtcollins1_boot_console_bound }
  } else if !read_ok {
    ConsoleUnread { path: path as NonEmptyStr, detail: read_error }
  } else {
    let lines = host_capture_lines(capture: HostCaptureLiveStream { text: capture })
    let sockets = ampere_socket_console_observation(lines: lines)
    let checkpoints = ampere_checkpoint_console_observation(lines: lines)
    ConsoleRetained {
      path: path as NonEmptyStr, size: size, lines: count(lines), firmware: firmware_console_report(lines: lines),
      firmware_error_lines: count(filter(lines, l => is_firmware_error_line(line: l) || is_firmware_err_code_line(line: l))),
      capture_digest: capture_digest,
      dram: ampere_dram_console_observation(lines: lines),
      checkpoints: checkpoints,
      checkpoint_relations: checkpoint_relations(checkpoints: checkpoints, capture: capture_digest, reference: reference),
      milestones: mtcollins1_console_milestones(lines: lines),
      sockets: sockets,
      against_reference: ampere_socket_reference_comparison(reference_path: mtcollins1_census_sol_artifact_path, reference_text: reference.text, read_ok: reference.ok, read_error: reference.error, subject: sockets),
      loader: grub_console_report(lines: lines),
      linux: linux_boot_console_observation(lines: lines),
      modules: kernel_module_decompression_observation(lines: lines),
      nvparam: ampere_nvparam_console_observation(lines: lines),
      span_readings: span_console_readings(lines: lines),
    }
  }
}

fn mtcollins1_boot_console(path: String) -> ConsoleReading {
  if path == "" {
    ConsoleNotConfigured
  } else if !console_path_retained(path: path) {
    ConsoleNotRetained { path: path as NonEmptyStr }
  } else {
    let st = coreutils.Stat.PathSize(path: path as NonEmptyStr)
    match if st.success { console_size_of_stat(size_text: st.size_text) } else { none } {
      Absent => ConsoleUnread { path: path as NonEmptyStr, detail: concat("stat -c %s could not size the capture: ", trim(st.size_text)) }
      Present { value: size } =>
        if (byte_size_count(b: size) as Int) > (byte_size_count(b: mtcollins1_boot_console_bound) as Int) {
          ConsoleExceedsBound { path: path as NonEmptyStr, size: size, bound: mtcollins1_boot_console_bound }
        } else {
          let r = Filesystem.Read(path: path)
          let reference = Filesystem.Read(path: mtcollins1_census_sol_artifact_path as String)
          mtcollins1_boot_console_reading(path: path, size: size, capture: r.content, read_ok: r.success, read_error: r.error,
            capture_digest: sha256sum_file_digest_via_shell(path: path as NonEmptyStr),
            reference: ReferenceCaptureRead { text: reference.content, ok: reference.success, error: reference.error,
              digest: sha256sum_file_digest_via_shell(path: mtcollins1_census_sol_artifact_path) })
        }
    }
  }
}

// THE BUNDLE IS WRITTEN, AND WHETHER IT WAS IS ITSELF A LINE IN THE RECEIPT. A failed write on a
// refused attempt is also appended to the refusal reason. On an accepted attempt the receipt line
// is the only place it can go, because the bundle may not flip the verdict.
type BundleWrite = BundleWritten | BundleWriteFailed { error: String }

fn bundle_write_receipt_line(w: BundleWrite) -> String {
  match w {
    BundleWritten => concat("diagnostics=", mtcollins1_boot_diagnostics_path)
    BundleWriteFailed { error: e } => concat("diagnostics=write-failed: ", e)
  }
}

fn mtcollins1_boot_write_bundle(bundle: MtCollins1BootDiagnosticBundle) -> BundleWrite {
  let written = Filesystem.Write(path: mtcollins1_boot_diagnostics_path, content: mtcollins1_boot_bundle_text(bundle: bundle))
  if written.success { BundleWritten } else { BundleWriteFailed { error: written.error } }
}

fn mtcollins1_boot_outcome_after_bundle(outcome: ProcessExit, bundle: MtCollins1BootDiagnosticBundle, write: BundleWrite) -> ProcessExit {
  let with_findings = mtcollins1_boot_outcome_with_findings(outcome: outcome, findings: mtcollins1_boot_findings(bundle: bundle))
  match write {
    BundleWritten => with_findings
    BundleWriteFailed { error: e } =>
      match with_findings {
        ExitSuccess => ExitSuccess
        ExitFailure { code: c, reason: r } => ExitFailure { code: c, reason: concat(r, " | diagnostics bundle could not be written: ", e) }
      }
  }
}
