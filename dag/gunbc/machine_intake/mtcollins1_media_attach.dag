// THE POLICY LAYER FOR ONE HOST'S MEDIA ATTACH, separate from the operation for the same reason the
// boot-handoff wrappers are: which image this unit should carry is a workflow decision, and the
// operation stays reusable by the next controller without carrying anyone's choices.
//
// THE IMAGE NAME IS IMPORTED RATHER THAN AUTHORED, and it used to be authored here. That made this
// module and the fetch module two authorities for one fact — the artifact this host boots — which
// admitted verifying one image and attaching another, with every individual step reporting success.
// See gunbc.machine_intake_mtcollins1_boot_artifact.
// THE JAR IS ATTEMPT-OWNED, AND A FIXED LITERAL HERE WAS THE DEFECT. extdeps.bmc.megarac's note
// once claimed that making the jar a parameter meant an attempt owned its own — it does not: a
// parameter PERMITS a per-attempt path and this wrapper passed a constant, so two concurrent
// attempts shared one bearer file. The attempt identifier is now part of the path, so the caller
// establishes the ownership the operation cannot.
fn mtcollins1_media_cookie_jar(attempt: NonEmptyStr) -> NonEmptyStr {
  join(["/tmp/gunbc-mtcollins1-megarac-jar-", attempt as String], "") as NonEmptyStr
}

// THE USERNAME IS THE MANAGED ACCOUNT ON BmcSecured (gunbc, user id 3), not the published
// factory literal "admin". Password remains a caller argument. Absent refuses before any request.
data mtcollins1_media_username: NonEmptyStr? = mtcollins1_secured_account()

// THE ABSENT-IMAGE CONTROL IS GONE (gunbc#12101, side-chat review 5286225278): it opened a media
// session on this unit from an operator session with no interlock, and nothing consumed it. The
// attach below is the one route to this unit's virtual media: it takes the unit-hold proof, whose
// only mint is the live acquire in gunbc.managed_host_unit_hold, and it is sealed
// to the boot's actuation. The proof is the authorization the scoped approval grant used to be: it
// names the unit's hold, and a caller that does not hold the unit cannot construct one.
fn mtcollins1_attach_diskless_image(
  proof: UnitHoldProof,
  subject: MtCollins1BootSubject,
  password_file: String,
  attempt: String,
) -> MtCollins1MediaAttachRecord
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_actuate"),
  ]
{
  match unit_hold_proof_refusal(proof: proof, host: operator_host_mtcollins1, label: "mtcollins1 media attach") {
    Present { value: why } => return MediaAttachNotAttempted { reason: why as NonEmptyStr }
    Absent => {}
  }
  if subject.image_name != mtcollins1_boot_medium_image_name(medium: mtcollins1_boot_medium) {
    MediaAttachNotAttempted { reason: "the boot subject names a different image than the medium row; controller untouched" }
  } else if subject.image_sha256 != mtcollins1_boot_medium_image_sha256(medium: mtcollins1_boot_medium) {
    MediaAttachNotAttempted { reason: "the boot subject names a different image digest than the medium row; controller untouched" }
  } else {
    match mtcollins1_media_username {
      Absent =>
        MediaAttachNotAttempted { reason: "BMC is not BmcSecured; refusing before any request" }
      Present { value: username } =>
        if password_file == "" {
          MediaAttachNotAttempted { reason: "no controller password file supplied; refusing before any request" }
        } else if attempt == "" {
          MediaAttachNotAttempted { reason: "no attempt identifier supplied; the cookie jar is attempt-owned and a shared jar is what lets two runs consume one session" }
        } else {
          let before = mtcollins1_boot_chassis_power(username: username, password_file: password_file as NonEmptyStr)
          let off = mtcollins1_stale_power_off(
            before: before,
            username: username,
            password_file: password_file as NonEmptyStr,
            attempt: attempt as NonEmptyStr,
            image_name: subject.image_name,
          )
          let power = mtcollins1_power_after_stale_power_off(before: before, off: off, username: username, password_file: password_file as NonEmptyStr)
          MediaAttachAttempted {
            attempt: attempt,
            medium_image_name: subject.image_name,
            medium_image_sha256: subject.image_sha256,
            power: power,
            stale_power_off: off,
            result: megarac_attach_remote_image(
              bmc_host: mtcollins1_endpoint.host,
              username: username,
              password_file: password_file as NonEmptyStr,
              cookie_jar: mtcollins1_media_cookie_jar(attempt: attempt as NonEmptyStr),
              image_name: subject.image_name,
              firmware: mtcollins1_firmware,
              task: MegaRacConverge {
                policy: MegaRacReplacementPolicy {
                  replaceable_seeded_stem: mtcollins1_census_image_stem,
                  detach: mtcollins1_detach_admission_after_power_off(power: power, off: off),
                  share: mtcollins1_media_share,
                },
              },
            ),
          }
        }
    }
  }
}

// THE SHARE THIS UNIT BOOTS FROM, derived from its authorities rather than typed: srv2's LAN
// address (gunbc.fleet_reach) and the export this lane publishes into
// (gunbc.machine_intake_mtcollins1_boot_artifact), over NFS. The controller answered exactly this on
// 2026-09-27 (15:40Z and 18:37Z reads, test.claim.machine_intake.megarac_media_convergence_witness_test
// mtcollins1_media_general_2026_09_27).
data mtcollins1_media_share: MegaRacShareBinding = MegaRacShareBinding {
  server_address: render_ipv4_address(addr: srv2_lan_ipv4),
  source_path: mtcollins1_boot_export_dir,
  share_type: MegaRacShareNfs,
}

// THE DETACH ADMISSION IS ESTABLISHED HERE, from the two facts only this layer holds. The hold:
// this function refuses above unless its UnitHoldProof names the unit's live hold, and the generic
// operation is admit_callers-sealed to this function, so no admission reaches the controller from
// a caller that does not hold the unit. The power: read over IPMI before the session, and only an
// observed OFF admits. On, undecodable and unreadable all refuse, because stop-media
// withdraws the medium a running host reads its root from. Under the hold nothing else
// may power the unit, which is what lets one reading taken before the session stand for the
// session. The reading is consumed only if a destructive step is needed: the desired image already
// presented is a no-op whatever the power.
fn mtcollins1_detach_admission(power: ChassisPowerObservation) -> MegaRacDetachAdmission {
  match power {
    ChassisPowerRead { power_on: on } =>
      if on {
        MegaRacDetachNotAdmitted { reason: "the host is powered on; stopping the medium would withdraw what it may be running from" }
      } else {
        MegaRacDetachAdmitted
      }
    other =>
      MegaRacDetachNotAdmitted { reason: concat("chassis power was not observed off: ", chassis_observation_text(observation: other)) as NonEmptyStr }
  }
}

// A HELD HOST THAT IS ON WITH A STALE CENSUS MEDIUM IS POWERED OFF BEFORE THE MEDIUM IS REPLACED
// (run 36683309058). The admission above is right to refuse a detach on a running host, and the
// previous boot leaves the host on (the census image powers off only after its END marker, and a
// failed or interrupted run does not reach it), so without this arm every re-run after a repin
// refused until someone powered the unit off out of band. The power-off is the route's own, taken
// only where the refusal would otherwise be the answer:
//   - the hold is live: this runs inside mtcollins1_attach_diskless_image after its proof check, and
//     is admit_callers-sealed to it, so nothing without the unit's hold reaches the chassis write;
//   - the host was READ on: unreadable or undecodable is never a licence to act, and the admission
//     refuses it unchanged; a host read off needs nothing;
//   - a read-only look (the same session route as mtcollins1_observe_presentation) finds the share
//     bound, the session released, and a presentation the converge would classify as exactly one
//     stale census image of this unit's stem AND would detach once admitted -- decided by the
//     converge's own pure fold (presented_convergence, megarac_convergence_step), not a second
//     classifier. The desired image presented, nothing presented, a foreign or several images, or an
//     unreadable document or code never power the host off.
// The write is IPMI §28.3 power down, read back over §28.2 until observed OFF, and then a FRESH
// reading is taken and is what the admission receives. A command refused or a read-back that never
// saw OFF does not admit the detach, whatever the fresh reading would say.
//
// POWER DOWN IS NOT ON THE BOOT HANDOFF'S VOCABULARY, ON PURPOSE (gunbc.machine_intake_oob_boot_handoff
// OobPowerAction, review 5310234917 on gunbc#12247: power down cannot mean a boot handoff). This is a
// different action for a different purpose -- making a stale medium safe to withdraw -- so it is its
// own sealed route here, not a widening of that type.
type StalePowerOffNeed
  = PowerOffNotNeeded { reason: NonEmptyStr }
  | PowerOffForStale { stale_image: String }

fn stale_power_off_look_owed(before: ChassisPowerObservation) -> Bool {
  match before {
    ChassisPowerRead { power_on: on } => on
    ChassisStatusUndecodable { cause: _ } => false
        ChassisUnreadable => false
  }
}

// PURE, over one read-only look, so every control is a supplied look rather than a controller.
fn mtcollins1_stale_power_off_need(look: MegaRacAttachResult, image_name: NonEmptyStr) -> StalePowerOffNeed {
  match look.session_release {
    SessionReleased => none
    other => return PowerOffNotNeeded { reason: concat("the read-only look's session was ", session_release_text(standing: other)) as NonEmptyStr }
  }
  return match look.outcome {
    MegaRacPresentationObserved { share: ShareBound, readiness: _, cd_error: cd, general: _, configurations: c } =>
      if c.answered == false {
        PowerOffNotNeeded { reason: "the configurations read did not answer; an unknown medium is never powered off for" }
      } else {
        let convergence = presented_convergence(
          presented: presented_media(body: c.body, image_name: image_name, firmware: mtcollins1_firmware),
          image_name: image_name,
          replaceable_seeded_stem: mtcollins1_census_image_stem,
        )
        match convergence {
          ConvergeStalePresented { row: _ } =>
            match megarac_convergence_step(convergence: convergence, detach: MegaRacDetachAdmitted, configurations: c.body, cd_before: cd) {
              ConvergeStepDetachStale { row: r } => PowerOffForStale { stale_image: r.image_name }
              _ => PowerOffNotNeeded { reason: "a stale census image is presented but the converge would not detach it even if admitted" }
            }
          _ => PowerOffNotNeeded { reason: "the presentation is not exactly one stale census image of this unit's stem" }
        }
      }
    MegaRacPresentationObserved { share: _, readiness: _, cd_error: _, general: _, configurations: _ } =>
      PowerOffNotNeeded { reason: "the share binding is not established; the converge refuses before any write" }
    _ => PowerOffNotNeeded { reason: "the read-only look observed no presentation" }
  }
}

// ONE READ-BACK SAMPLE, PURE: only an observed OFF ends the poll.
fn stale_power_off_observed(sample: ChassisPowerObservation) -> Bool {
  match sample {
    ChassisPowerRead { power_on: on } => !on
    ChassisStatusUndecodable { cause: _ } => false
        ChassisUnreadable => false
  }
}

data mtcollins1_stale_power_off_samples: Int = 12

data mtcollins1_stale_power_off_interval: Second = second(count: 5)

// WHAT THE POWER-OFF ARM MAY SPEND, DERIVED: one look, the power-down command and the fresh reading
// (each at the IPMI read ceiling), and every read-back sample with its pacing interval.
fn mtcollins1_stale_power_off_allowance() -> Second {
  let read = (second_count(s: mtcollins1_boot_ipmi_read_deadline) + second_count(s: mtcollins1_boot_ipmi_kill_after)) as Int
  second(count: (second_count(s: megarac_presentation_look_allowance()) as Int)
    + 2 * read
    + mtcollins1_stale_power_off_samples * (read + (second_count(s: mtcollins1_stale_power_off_interval) as Int)))
}

fn mtcollins1_stale_power_off(
  before: ChassisPowerObservation,
  username: NonEmptyStr,
  password_file: NonEmptyStr,
  attempt: NonEmptyStr,
  image_name: NonEmptyStr,
) -> StaleMediumPowerOff
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_media_attach", decl_name: "mtcollins1_attach_diskless_image"),
  ]
{
  if stale_power_off_look_owed(before: before) == false {
    return StalePowerOffNotNeeded { reason: concat("chassis power before the session: ", chassis_observation_text(observation: before) as String) as NonEmptyStr }
  }
  let look = megarac_attach_remote_image(
    bmc_host: mtcollins1_endpoint.host,
    username: username,
    password_file: password_file,
    cookie_jar: mtcollins1_media_cookie_jar(attempt: join([attempt as String, "-before-power-off"], "") as NonEmptyStr),
    image_name: image_name,
    firmware: mtcollins1_firmware,
    task: MegaRacObserve { share: mtcollins1_media_share },
  )
  return match mtcollins1_stale_power_off_need(look: look, image_name: image_name) {
    PowerOffNotNeeded { reason: r } => StalePowerOffNotNeeded { reason: r }
    PowerOffForStale { stale_image: stale } => {
      let control = diagnostic.ipmi.Tool.ChassisPowerControl(
        bmc_host: mtcollins1_endpoint.host,
        username: username,
        password_file: password_file,
        action: ipmi_chassis_control_verb(action: IpmiChassisPowerDown),
      )
      if control.success == false {
        StalePowerOffCommandRefused { stale_image: stale, before: before }
      } else {
        let last = mtcollins1_stale_power_off_poll(username: username, password_file: password_file, remaining: mtcollins1_stale_power_off_samples)
        if stale_power_off_observed(sample: last) {
          StalePowerOffObserved { stale_image: stale, before: before }
        } else {
          StalePowerOffNotObserved { stale_image: stale, before: before, last: last }
        }
      }
    }
  }
}

// THE READ-BACK, BOUNDED; returns the last sample, which is OFF exactly when the poll observed it.
fn mtcollins1_stale_power_off_poll(username: NonEmptyStr, password_file: NonEmptyStr, remaining: Int) -> ChassisPowerObservation
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_media_attach", decl_name: "mtcollins1_stale_power_off"),
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_media_attach", decl_name: "mtcollins1_stale_power_off_poll"),
  ]
{
  let _paced = sleep_delay_seconds_second_carrier_projection(duration: mtcollins1_stale_power_off_interval)
  let sample = mtcollins1_boot_chassis_power(username: username, password_file: password_file)
  if stale_power_off_observed(sample: sample) || remaining <= 1 {
    sample
  } else {
    mtcollins1_stale_power_off_poll(username: username, password_file: password_file, remaining: remaining - 1)
  }
}

// THE READING THE ADMISSION RECEIVES: after an observed power-off, a fresh one; otherwise the one
// taken before the session.
fn mtcollins1_power_after_stale_power_off(
  before: ChassisPowerObservation,
  off: StaleMediumPowerOff,
  username: NonEmptyStr,
  password_file: NonEmptyStr,
) -> ChassisPowerObservation
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_media_attach", decl_name: "mtcollins1_attach_diskless_image"),
  ]
{
  match off {
    StalePowerOffObserved { stale_image: _, before: _ } => mtcollins1_boot_chassis_power(username: username, password_file: password_file)
    StalePowerOffNotNeeded { reason: _ } => before
        StalePowerOffCommandRefused { stale_image: _, before: _ } => before
        StalePowerOffNotObserved { stale_image: _, before: _, last: _ } => before
  }
}

// PURE. A power-off that was attempted and not observed never admits the detach, whatever `power`
// says; every other arm is the ordinary admission over the reading the attempt took last.
fn mtcollins1_detach_admission_after_power_off(power: ChassisPowerObservation, off: StaleMediumPowerOff) -> MegaRacDetachAdmission {
  match off {
    StalePowerOffCommandRefused { stale_image: i, before: _ } =>
      MegaRacDetachNotAdmitted { reason: concat("chassis power off to replace the stale image was refused: ", i) as NonEmptyStr }
    StalePowerOffNotObserved { stale_image: i, before: _, last: l } =>
      MegaRacDetachNotAdmitted { reason: join(["chassis power off to replace the stale image ", i, " was never observed off; last read ", chassis_observation_text(observation: l) as String], "") as NonEmptyStr }
    StalePowerOffNotNeeded { reason: _ } => mtcollins1_detach_admission(power: power)
        StalePowerOffObserved { stale_image: _, before: _ } => mtcollins1_detach_admission(power: power)
  }
}

// THE GATE THE HANDOFF IS BEHIND. Only a ready presentation with its session released opens it,
// and the evidence it opens with is the Started row the readiness fold accepted. Every other arm
// withholds, with the one reason the bundle also records (media_attach_outcome_reason), so a
// pending, timed-out or refused presentation can never become a boot-device write or a power action.
// A LEAKED SESSION WITHHOLDS TOO: the controller's session table is finite and this lane once
// exhausted it, so an attach that could not release is not a state to boot from.
type MtCollins1MediaGate
  = MediaGateReady { evidence: MegaRacPresentationEvidence }
  | MediaGateWithheld { reason: NonEmptyStr }

fn mtcollins1_media_gate(record: MtCollins1MediaAttachRecord) -> MtCollins1MediaGate {
  match record {
    MediaAttachNotAttempted { reason: r } => MediaGateWithheld { reason: concat("mtcollins1 media attach: ", r as String) as NonEmptyStr }
    MediaAttachAttempted { attempt: _, medium_image_name: _, medium_image_sha256: _, power: _, stale_power_off: _, result: res } =>
      match res.outcome {
        MegaRacPresentationReady { route: _, evidence: e } =>
          match res.session_release {
            SessionReleased => MediaGateReady { evidence: e }
            other => MediaGateWithheld { reason: concat("mtcollins1 media attach: the presentation is ready but the session was ", session_release_text(standing: other)) as NonEmptyStr }
          }
        other =>
          match media_attach_outcome_reason(outcome: other) {
            Present { value: why } => MediaGateWithheld { reason: concat("mtcollins1 media attach: ", why) as NonEmptyStr }
            Absent => MediaGateWithheld { reason: "mtcollins1 media attach: the outcome carries no ready presentation" }
          }
      }
  }
}

// ONE READ-ONLY LOOK AT THE PRESENTATION, under the same hold, for the handoff to consult just before
// it writes and to record just after. The jar is suffixed per look so two looks in one attempt
// never share a bearer file.
fn mtcollins1_observe_presentation(
  proof: UnitHoldProof,
  image_name: NonEmptyStr,
  password_file: String,
  attempt: String,
  look: NonEmptyStr,
) -> MegaRacAttachResult
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_handoff_when_media_ready"),
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_actuate"),
  ]
{
  match unit_hold_proof_refusal(proof: proof, host: operator_host_mtcollins1, label: "mtcollins1 media observe") {
    Present { value: why } => return MegaRacAttachResult { outcome: MegaRacSessionRefused { detail: why }, session_release: SessionReleaseNotAttempted, baseline: none }
    Absent => {}
  }
  match mtcollins1_media_username {
    Absent => MegaRacAttachResult { outcome: MegaRacSessionRefused { detail: "BMC is not BmcSecured; no account to observe with" }, session_release: SessionReleaseNotAttempted, baseline: none }
    Present { value: username } =>
      if password_file == "" || attempt == "" {
        MegaRacAttachResult { outcome: MegaRacSessionRefused { detail: "no password file or attempt identifier; no request made" }, session_release: SessionReleaseNotAttempted, baseline: none }
      } else {
        megarac_attach_remote_image(
          bmc_host: mtcollins1_endpoint.host,
          username: username,
          password_file: password_file as NonEmptyStr,
          cookie_jar: mtcollins1_media_cookie_jar(attempt: join([attempt, "-", look as String], "") as NonEmptyStr),
          image_name: image_name,
          firmware: mtcollins1_firmware,
          task: MegaRacObserve { share: mtcollins1_media_share },
        )
      }
  }
}
