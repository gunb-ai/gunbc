module gunbc.machine_intake_mtcollins1_media_attach

import std.types { NonEmptyStr, String }
import std.process { ExitSuccess, ProcessExit, exit_failure }
import gunbc.machine_intake_mtcollins1_access_observation { mtcollins1_endpoint }
import gunbc.machine_intake_mtcollins1_boot_artifact { mtcollins1_diskless_image_name }
import gunbc.machine_intake_megarac_media_attach {
  MegaRacAttachOutcome,
  MegaRacAttachResult,
  SessionRelease,
  SessionReleaseNotAttempted,
  SessionReleaseRefused,
  SessionReleased,
  MegaRacAttached,
  MegaRacAlreadyAttached,
  MegaRacAttachTimedOut,
  MegaRacConfigurationAmbiguous,
  MegaRacConfigurationsUnreadable,
  MegaRacConnectionDenied,
  MegaRacImageListingEmpty,
  MegaRacImageListingUnparseable,
  MegaRacImageNotEnumerated,
  MegaRacImagesUnreadable,
  MegaRacLoginFailed,
  MegaRacMaxSessionReached,
  MegaRacPermissionDenied,
  MegaRacSessionIndexUnavailable,
  MegaRacSessionRefused,
  MegaRacSessionTokenUnreadable,
  MegaRacStopped,
  MegaRacWrongMediaType,
  megarac_attach_remote_image,
}

fn mtcollins1_media_cookie_jar(attempt: NonEmptyStr) -> NonEmptyStr {
  join(["/tmp/gunbc-mtcollins1-megarac-jar-", attempt as String], "") as NonEmptyStr
}

data mtcollins1_media_username: NonEmptyStr = "admin"

// Only status 1 with a non-255 session index reaches a success arm. Connecting (100) is consumed
// by the bounded poll inside the operation; 2-5 remain separate terminal outcomes so a login
// failure can never render as an attached image.
fn mtcollins1_render_attach(outcome: MegaRacAttachOutcome) -> ProcessExit {
  match outcome {
    MegaRacAttached { image_name: _, image_index: _ } => ExitSuccess
    MegaRacAlreadyAttached { image_name: _ } => ExitSuccess
    MegaRacConfigurationsUnreadable { detail: d } =>
      exit_failure(reason: concat("mtcollins1 media attach: configurations unreadable; attachment state unknown: ", d))
    MegaRacConfigurationAmbiguous { image_name: n, matches: m } =>
      exit_failure(reason: join(["mtcollins1 media attach: ", to_string(m), " configuration rows name '", n as String, "'; refusing an ambiguous device state"], ""))
    MegaRacWrongMediaType { image_name: n, observed: mt } =>
      exit_failure(reason: join(["mtcollins1 media attach: '", n as String, "' is present under media_type ", mt, " rather than CD media_type 1"], ""))
    MegaRacSessionIndexUnavailable { image_name: n, configurations: c } =>
      exit_failure(reason: join(["mtcollins1 media attach: '", n as String, "' reported Started but session_index is absent or 255/N/A: ", c], ""))
    MegaRacConnectionDenied { image_name: n, configurations: c } =>
      exit_failure(reason: join(["mtcollins1 media attach: connection denied for '", n as String, "': ", c], ""))
    MegaRacLoginFailed { image_name: n, configurations: c } =>
      exit_failure(reason: join(["mtcollins1 media attach: remote-share login failed for '", n as String, "': ", c], ""))
    MegaRacMaxSessionReached { image_name: n, configurations: c } =>
      exit_failure(reason: join(["mtcollins1 media attach: controller reached its maximum redirection sessions for '", n as String, "': ", c], ""))
    MegaRacPermissionDenied { image_name: n, configurations: c } =>
      exit_failure(reason: join(["mtcollins1 media attach: permission denied for '", n as String, "': ", c], ""))
    MegaRacStopped { image_name: n, status: st, configurations: c } =>
      exit_failure(reason: join(["mtcollins1 media attach: '", n as String, "' reached stopped redirection status ", st, ": ", c], ""))
    MegaRacAttachTimedOut { image_name: n, samples: samples, configurations: c } =>
      exit_failure(reason: join(["mtcollins1 media attach: '", n as String, "' did not reach status 1 within ", to_string(samples), " bounded samples; last configurations: ", c], ""))
    MegaRacSessionRefused { detail: d } =>
      exit_failure(reason: concat("mtcollins1 media attach: BMC session refused: ", d))
    MegaRacSessionTokenUnreadable { detail: d } =>
      exit_failure(reason: concat("mtcollins1 media attach: BMC session opened but CSRF token was unreadable: ", d))
    MegaRacImagesUnreadable { detail: d } =>
      exit_failure(reason: concat("mtcollins1 media attach: available-image listing unreadable: ", d))
    MegaRacImageListingEmpty =>
      exit_failure(reason: "mtcollins1 media attach: desired image is not presented and the controller offers no image to attach; do not toggle mount_cd as a refresh because that detaches presented media")
    MegaRacImageListingUnparseable { detail: d } =>
      exit_failure(reason: concat("mtcollins1 media attach: available-image listing is not valid JSON: ", d))
    MegaRacImageNotEnumerated { image_name: n } =>
      exit_failure(reason: join(["mtcollins1 media attach: desired image '", n as String, "' is neither ready nor offered by the controller"], ""))
  }
}

fn mtcollins1_render_release(standing: SessionRelease) -> String {
  match standing {
    SessionReleased => ""
    SessionReleaseNotAttempted => " (session was never opened)"
    SessionReleaseRefused { detail: d } => concat(" WARNING: controller session was not released: ", d)
  }
}

func mtcollins1_attach_absent_image_control(password_raw: String, attempt: String) -> ProcessExit
  uses net: std.resources.Network
{
  if password_raw == "" {
    return exit_failure(reason: "mtcollins1 media attach control: no controller password supplied; refusing before any request")
  }
  if attempt == "" {
    return exit_failure(reason: "mtcollins1 media attach control: no attempt identifier supplied")
  }
  return mtcollins1_render_attach_result(
    result: megarac_attach_remote_image(
      bmc_host: mtcollins1_endpoint.host,
      username: mtcollins1_media_username,
      password: password_raw as NonEmptyStr,
      cookie_jar: mtcollins1_media_cookie_jar(attempt: attempt as NonEmptyStr),
      image_name: "gunbc-absent-control-image.iso",
    )
  )
}

func mtcollins1_attach_diskless_image(password_raw: String, attempt: String) -> ProcessExit
  uses net: std.resources.Network
{
  if password_raw == "" {
    return exit_failure(reason: "mtcollins1 media attach: no controller password supplied; refusing before any request")
  }
  if attempt == "" {
    return exit_failure(reason: "mtcollins1 media attach: no attempt identifier supplied; cookie jars are attempt-owned")
  }
  return mtcollins1_render_attach_result(
    result: megarac_attach_remote_image(
      bmc_host: mtcollins1_endpoint.host,
      username: mtcollins1_media_username,
      password: password_raw as NonEmptyStr,
      cookie_jar: mtcollins1_media_cookie_jar(attempt: attempt as NonEmptyStr),
      image_name: mtcollins1_diskless_image_name,
    )
  )
}

fn mtcollins1_render_attach_result(result: MegaRacAttachResult) -> ProcessExit {
  match mtcollins1_render_attach(outcome: result.outcome) {
    ExitSuccess =>
      match result.session_release {
        SessionReleased => ExitSuccess
        _ => exit_failure(reason: concat("mtcollins1 media attach: image became ready, but the BMC session was not released.", mtcollins1_render_release(standing: result.session_release)))
      }
    other => other
  }
}
