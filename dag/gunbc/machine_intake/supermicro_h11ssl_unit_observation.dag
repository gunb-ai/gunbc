}

// RECEIPTS, NOT UPSTREAM FACT (DESIGN section 3, external upstream decomposition). Readings of
// H11SSL units taken after first contact, ONE ROW PER UNIT READING, keyed by the unit's BMC MAC,
// the same key the first-contact receipt (gunbc.machine_intake.supermicro_h11ssl_first_contact)
// and the operator credential inventory use. A third unit or a later reading is a row here, not a
// module. Raw bytes are under artifacts/bmc/h11ssl-unit2-* and artifacts/bmc/h11ssl-unit1-cpu2-*,
// cited by sha256. No BMC password or licence key is carried, by value or by reference.
//
// The first-contact receipt and the 0x22 POST receipt
// (gunbc.machine_intake.supermicro_h11ssl_post_code_receipt) stay as they were: unit 1 with its
// replacement CPU is a NEW reading, never an edit of those.

fn sha256_artifact(path: NonEmptyStr, hex: NonEmptyStr) -> EvidenceRef {
  EvidenceRef { label: path, digest: Sha256Hash(Sha256Digest { hex: hex }) }
}

// A figure this receipt carries that no committed artifact contains: the observer's report, typed
// as transcribed with what would ground it (DESIGN 4d).
type H11sslReportedFigure { value: NonEmptyStr, standing: CitedFigureStanding }

type H11sslReadInstant
  = ReadAtUtcMinute { minute: NonEmptyStr, standing: CitedFigureStanding }
  | ReadInstantUnrecorded { read_obligation: NonEmptyStr }

// The CPU the unit reported at its last POST. SMBIOS gives the model and cores but reads its
// serial as "Unknown", so WHICH physical part is fitted is not part of the reading: it is the
// operator's attestation, recorded in supermicro_h11ssl_attested_cpu_parts.
type H11sslCpuReading {
  manufacturer: Vendor<Hardware>
  manufacturer_as_read: NonEmptyStr
  model_as_read: NonEmptyStr
  cores: Nat
  cores_enabled: Nat
  serial_as_read: NonEmptyStr
}

type H11sslDimmReading {
  dimm: H11sslReportedDimm
  serial_as_read: NonEmptyStr
  manufacturer: Vendor<Hardware>
  manufacturer_as_read: NonEmptyStr
  configured_speed: MegatransfersPerSecond
}

// A link rate exists only for an enabled port; the BMC's SPEED="0" on a disabled port is not a rate
// and is not carried.
type H11sslHostLanState = HostLanDisabled | HostLanEnabled { link_speed: Bandwidth }

type H11sslHostLanReading { mac: Eui48Address, state: H11sslHostLanState }

// Redfish as this reading found it. Licence-locked is the refused root's own message; a unit whose
// Redfish answered in this reading carries the operation it served.
type H11sslRedfishStanding
  = RedfishRootReading { outcome: H11sslRedfishRootOutcome, licences_named: List<NonEmptyStr>, service_version: H11sslReportedFigure }
  | RedfishServedOperation { operation: NonEmptyStr, standing: CitedFigureStanding }

type H11sslSelReading {
  total_records: Nat
  battery_low_record_ids: List<NonEmptyStr>
  clock: H11sslBmcClockStanding
}

type H11sslSelStanding = SelRead { sel: H11sslSelReading } | SelNotRead

type H11sslUnitReading {
  bmc_mac: Eui48Address
  bmc_address: NonEmptyStr
  bmc_address_reservation: H11sslReportedFigure?
  read_at: H11sslReadInstant
  observed_by: NonEmptyStr
  ipmi_firmware_tag: NonEmptyStr
  ipmi_firmware_version: NonEmptyStr
  ipmi_firmware_build_date: NonEmptyStr
  cpld_version: H11sslReportedFigure?
  bios_vendor: Vendor<Hardware>
  bios_vendor_as_read: NonEmptyStr
  bios_version: NonEmptyStr
  bios_release_date: NonEmptyStr
  cpu: H11sslCpuReading
  dimms: List<H11sslDimmReading>
  host_lans: List<H11sslHostLanReading>
  variant: H11sslUnitVariantStanding
  redfish: H11sslRedfishStanding
  sel: H11sslSelStanding
  sources: List<EvidenceRef>
}

