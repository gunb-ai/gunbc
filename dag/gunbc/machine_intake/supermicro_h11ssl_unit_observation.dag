// The emitter of each byte is NOT established. On an EPYC board the bytes before the first AMI PEI
// code (here b4/b8 d2/cd cc c0/b0 c2 b3) arrive before x86 PEI and fall in AMI's BDS and DXE-error
// rows, which cannot be their meaning at that point; the AMD AGESA/ABL postcode table is the
// unmodeled upstream (frontier named in supermicro_h11ssl_post_code_receipt). So a decode is what
// AMI's table says the byte means IF AMI's firmware wrote it, and every decoded trace carries that.
data supermicro_h11ssl_post_byte_emitter_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "Which firmware wrote each byte (AMD PSP/ABL or AMI Aptio) is not established. Read AMD's AGESA/ABL postcode table for EPYC 7002 and land it as its own extdeps module before reading an early byte's AMI meaning as the board's state.",
}

type H11sslDecodedTrace {
  bmc_mac: Eui48Address
  decodes: List<PostCodeDecode>
  emitter: CitedFigureStanding
}

// CONSUMER (DESIGN section 3c): the executing route for the AMI decode over a BMC-read sequence,
// the reader the 0x22 receipt named as its later change. Exercised by
// test.claim.supermicro_h11ssl_unit_observation_witness.
fn supermicro_h11ssl_decoded_trace(t: H11sslPostTrace) -> H11sslDecodedTrace {
  H11sslDecodedTrace {
    bmc_mac: t.bmc_mac,
    decodes: t.samples |> map(x => ami_aptio_decode(table: supermicro_ami_aptio_v_post_codes_guide_table, code: x.code)),
    emitter: supermicro_h11ssl_post_byte_emitter_standing,
  }
}

// What a poller can say about one code. There is no "absent" arm: a sampler that can miss a code
// cannot establish that it was never written, so not seeing it is CodeNotSampled with the polling
// it was not seen under.
type H11sslSampledCodeStanding
  = CodeSampled { at: Rfc3339Timestamp }
  | CodeNotSampled { polling: H11sslSnoopPolling }

fn supermicro_h11ssl_code_standing(t: H11sslPostTrace, code: Int) -> H11sslSampledCodeStanding {
  match first_where(t.samples, x => x.code == code) {
    Present { value: x } => CodeSampled { at: x.at }
    Absent => CodeNotSampled { polling: t.polling }
  }
}

// AMI's "Legacy Boot event" (0xAE, p.11 of the Supermicro reprint), the handoff byte.
data supermicro_h11ssl_legacy_boot_handoff_code: Int = 174

fn nonzero_codes(t: H11sslPostTrace) -> List<Int> {
  t.samples |> filter(x => x.code != 0) |> map(x => x.code)
}

// The last nonzero byte sampled: where a held trace stopped, or the last progress a completed one showed.
fn supermicro_h11ssl_last_progress_code(t: H11sslPostTrace) -> Int? {
  nonzero_codes(t: t) |> reverse |> first
}

type SuffixMatch { remaining_sup: List<Int>, matched: Int, broken: Bool }

// Greedy right-to-left: the longest suffix of `sub` whose codes occur in `sup` in the same order.
// Order is the only thing two sampled traces can agree on, since either poller may drop codes.
fn longest_ordered_suffix_length(sub: List<Int>, sup: List<Int>) -> Int {
  fold(sub |> reverse, init: SuffixMatch { remaining_sup: sup |> reverse, matched: 0, broken: false }, f: (acc, code) =>
    if acc.broken { acc } else {
      let rest = drop_until(xs: acc.remaining_sup, code: code)
      match rest |> first {
        Present { value: _ } => SuffixMatch { remaining_sup: rest |> skip(1), matched: acc.matched + 1, broken: false }
        Absent => SuffixMatch { remaining_sup: [], matched: acc.matched, broken: true }
      }
    }
  ).matched
}

type DropState { kept: List<Int>, found: Bool }

fn drop_until(xs: List<Int>, code: Int) -> List<Int> {
  fold(xs, init: DropState { kept: [], found: false }, f: (acc, x) =>
    if acc.found { DropState { kept: acc.kept |> append(x), found: true } }
    else { if x == code { DropState { kept: [x], found: true } } else { acc } }
  ).kept
}

// The shared tail of two traces' nonzero codes: the longest final run of `a` that occurs in order
// in `b`. Measured, never chosen: no anchor code is supplied.
fn supermicro_h11ssl_shared_ordered_tail(a: H11sslPostTrace, b: H11sslPostTrace) -> List<Int> {
  let xs = nonzero_codes(t: a)
  xs |> skip((xs |> count) - longest_ordered_suffix_length(sub: xs, sup: nonzero_codes(t: b)))
}

// ---- The operator's CPU history (DESIGN 4d). An ATTESTATION, not a machine read: the operator
// handled the parts and is the authority on which part went into which board, but nothing here
// was read from the parts. SMBIOS reads every serial as Unknown and no PSB fuse state was read,
// so per-part identity and lock state stay attested; `unread` names what a machine read would add.
//
// `attested_on` is a Gregorian day, held as text, because the answer was relayed with its day and
// no time. An Rfc3339Timestamp would make up a time of day, and v2.std.datetime CalendarDate has no
// constructor in the corpus yet; extdeps.pin pin_currency_gap records the same gap. Trigger: a
// CalendarDate constructor. This field then becomes a CalendarDate.
type H11sslOperatorAttestation {
  attested_by: NonEmptyStr
  attested_on: NonEmptyStr
  statement: NonEmptyStr
  unread: NonEmptyStr
}

data supermicro_h11ssl_cpu_history_attestation: H11sslOperatorAttestation = H11sslOperatorAttestation {
  attested_by: "the operator, answering the open question on gunbc#14975, relayed by merry-fox-82",
  attested_on: "2026-10-24",
  statement: "Both H11SSL units now carry two NEW EPYC 7702P parts. The earlier CPUs were locked ('locked / don't work'): vendor-locked parts that would not run in these boards. The 0x22 hold on unit 1 was with its original, locked CPU.",
  unread: "Per-part identity, and the earlier parts' lock, are the operator's account, not a read: SMBIOS reads each serial as Unknown and no PSB fuse state was read. The package marking or the PSP serial would ground identity; a PSP or BIOS PSB status read would ground a lock state.",
}

// What the operator said about a part's vendor lock. No arm is a fuse read. The attestation called
// the replacements NEW, not unlocked, so their lock is PartLockNotAttested. A successful POST shows
// the board accepts the part, not its fuse state, and that is the PSB inference's bet, not an
// attestation. PartAttestedUnlocked is for an explicit "unlocked" from the operator. Two folds
// consume the lock. supermicro_h11ssl_psb_inference_under refuses a PSB link whose fitted part is
// attested locked while its trace POSTed, since the account and the trace then disagree.
// supermicro_h11ssl_prior_stall_lock_losses carries the "locked is a diagnosis" loss only when
// the removed part is attested locked.
type H11sslCpuPartLock = PartAttestedVendorLocked | PartAttestedUnlocked | PartLockNotAttested { read_obligation: NonEmptyStr }

data supermicro_h11ssl_replacement_lock_not_attested: H11sslCpuPartLock = PartLockNotAttested {
  read_obligation: "The operator called these parts new, not unlocked; a successful POST shows board compatibility, not fuse state. An explicit statement from the operator, or a PSP or BIOS PSB status read, grounds it.",
}

type H11sslCpuPartTenure = PartFittedNow | PartRemoved

type H11sslAttestedCpuPart {
  bmc_mac: Eui48Address
  model: CpuModelCatalogRow
  lock: H11sslCpuPartLock
  tenure: H11sslCpuPartTenure
  attestation: H11sslOperatorAttestation
}

// One row per part whose board the attestation places. Unit 1's original is the part the 0x22 hold
// was with. The model of every row is the upstream catalog row (extdeps.cpu.amd epyc_7702p_catalog),
// not a copied string. For the original part, that the part was a 7702P is the 2026-10-17 first-contact
// attestation (gunbc.machine_intake.supermicro_h11ssl_first_contact supermicro_h11ssl_attested_hardware),
// and the witness checks that row's model number against it. The
// statement's plural "earlier CPUs" may cover a part beyond unit 1's original, but no board is
// stated for one, so none is rowed: a row is added when its placement is attested.
data supermicro_h11ssl_attested_cpu_parts: List<H11sslAttestedCpuPart> = [
  H11sslAttestedCpuPart { bmc_mac: supermicro_h11ssl_unit1_bmc_mac, model: epyc_7702p_catalog, lock: PartAttestedVendorLocked, tenure: PartRemoved, attestation: supermicro_h11ssl_cpu_history_attestation },
  H11sslAttestedCpuPart { bmc_mac: supermicro_h11ssl_unit1_bmc_mac, model: epyc_7702p_catalog, lock: supermicro_h11ssl_replacement_lock_not_attested, tenure: PartFittedNow, attestation: supermicro_h11ssl_cpu_history_attestation },
  H11sslAttestedCpuPart { bmc_mac: supermicro_h11ssl_unit2_bmc_mac, model: epyc_7702p_catalog, lock: supermicro_h11ssl_replacement_lock_not_attested, tenure: PartFittedNow, attestation: supermicro_h11ssl_cpu_history_attestation },
]

fn supermicro_h11ssl_attested_part(parts: List<H11sslAttestedCpuPart>, bmc_mac: Eui48Address, tenure: H11sslCpuPartTenure) -> H11sslAttestedCpuPart? {
  first_where(parts, p => p.bmc_mac == bmc_mac && p.tenure == tenure)
}

// A premise of an inference is either a figure with its cited standing or an operator
// attestation. Both an attested and a cited premise admit the link; only an uncited figure, or no
// premise row at all, leaves it insufficient. An attested premise is never silent: its `unread`
// becomes a loss on the admitted link (cpu_inference), so a reader sees which conclusion rests on
// the operator's account.
//
// DIVERGES WITH A STATED REASON (DESIGN 3b, 6b). This arm is module-local. Operator attestation is
// already forked per domain (gunbc.machine_intake.mtcollins1_power_on_account
// PopulationOperatorAttested, gunbc.machine_intake.mtjade1_access_observation
// SolSessionOperatorAttested, gunbc.machine_intake.bmc_operator_credential_inventory
// OperatorAttestedInventoryRow, gunbc.os_install_deduction KvmOperatorAttestation, and the
// MegaRacVersionFromOperatorAttestation arm). The generalization's home is a warrant arm beside
// extdeps.external_authority CitedFigureStanding. That arm is not added here: it changes every
// exhaustive match on that standing, and it needs a ruling on whether an attestation is a cited
// figure at all. Trigger: that ruling. Follow-up: one arm, these leaves deleted.
type H11sslPremiseStanding
  = PremiseFigure { standing: CitedFigureStanding }
  | PremiseOperatorAttested { attestation: H11sslOperatorAttestation }

fn premise_read_obligation(premise: H11sslPremiseStanding) -> NonEmptyStr? {
  match premise {
    PremiseFigure { standing: s } => cited_figure_read_obligation(standing: s)
    PremiseOperatorAttested { attestation: _ } => Absent
  }
}

fn premise_attestation_loss(premise: H11sslPremiseStanding) -> NonEmptyStr? {
  match premise {
    PremiseFigure { standing: _ } => Absent
    PremiseOperatorAttested { attestation: a } => Present { value: a.unread }
  }
}

// An attested part premise, or, where the roster has no row, an uncited premise naming the attestation owed.
fn part_premise(part: H11sslAttestedCpuPart?, owed: NonEmptyStr) -> H11sslPremiseStanding {
  match part {
    Present { value: p } => PremiseOperatorAttested { attestation: p.attestation }
    Absent => PremiseFigure { standing: TranscribedUncited { read_obligation: owed } }
  }
}

// ---- The inferences (DESIGN 4d): typed as bets through std.claim_evidence, never as findings.
// The PSB fuse state of no part was read.

// PartNotPsbLockedToANonSupermicroVendor: AMD Platform Secure Boot fuses a part to one OEM's key,
// after which it refuses firmware not signed by that key. PriorStallFollowedTheFirstCpu: the 0x22
// hold on unit 1 followed its first CPU, not the board.
type H11sslCpuProposition
  = PartNotPsbLockedToANonSupermicroVendor
  | PriorStallFollowedTheFirstCpu

// The 0x22 receipt does not name its unit; that it is `unit`, with that unit's original part, is
// the attestation carried by the unit's PartRemoved row.
type H11sslPriorStall { receipt: DeclarationRef, held_code: Int, unit: Eui48Address }

data supermicro_h11ssl_unit1_prior_stall: H11sslPriorStall = H11sslPriorStall {
  receipt: decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_post_code_receipt", decl_name: "supermicro_h11ssl_post_code_observations"),
  held_code: 34,
  unit: supermicro_h11ssl_unit1_bmc_mac,
}

type H11sslCpuClaim = Claim<Eui48Address, H11sslCpuReading, H11sslCpuProposition, H11sslResetStimulus, Rfc3339Timestamp>

type H11sslCpuInference = EvidenceInference<H11sslPostTrace, H11sslCpuClaim, NonEmptyStr, H11sslSnoopPolling, ReadBackProbe>

data supermicro_h11ssl_snoop_trace_probe: ReadBackProbe = ReadBackProbe {
  label: "BMC Snooping PostCode poll across a host reset",
  subject: "the fitted CPU's PSB fuse state",
  effect_on_subject: ProbeInert,
}

fn unit_reading(bmc_mac: Eui48Address) -> H11sslUnitReading? {
  first_where(supermicro_h11ssl_unit_readings, r => r.bmc_mac == bmc_mac)
}

// DXE IPL (0x4F, AMI's table p.8) ends PEI; a trace that sampled it and progressed to another
// nonzero byte left the phase 0x22 sits in. Reading 0x4F as AMI's is itself part of the bet.
data supermicro_h11ssl_dxe_ipl_code: Int = 79

fn passed_dxe_ipl(t: H11sslPostTrace) -> Bool {
  any(t.samples, x => x.code == supermicro_h11ssl_dxe_ipl_code) && match supermicro_h11ssl_last_progress_code(t: t) { Present { value: c } => c != supermicro_h11ssl_dxe_ipl_code && c != supermicro_h11ssl_unit1_prior_stall.held_code  Absent => false }
}

// The first premise that is not established (cited, observed or attested), as its read obligation.
fn first_unestablished_premise(premises: List<H11sslPremiseStanding>) -> NonEmptyStr? {
  fold(premises, init: Absent, f: (acc, p) => match acc { Present { value: o } => Present { value: o }  Absent => premise_read_obligation(premise: p) })
}

// Each distinct attestation a link's premises rest on, as one loss.
fn premise_losses(premises: List<H11sslPremiseStanding>) -> List<NonEmptyStr> {
  fold(premises, init: [], f: (acc, p) => match premise_attestation_loss(premise: p) {
    Present { value: l } => if any(acc, x => x == l) { acc } else { acc |> append(l) }
    Absent => acc
  })
}

// A link is CONDITIONAL on its premises: while any premise is unestablished, the inference is
// EvidenceInsufficient naming that premise's read obligation, never a Supports link carrying the
// premise as a loss. Losses are what an admitted link still cannot see; an unestablished premise
// is a reason the link is not admitted at all. An attested premise admits the link and puts what
// the attestation leaves unread first among its losses.
fn cpu_inference(t: H11sslPostTrace, proposition: H11sslCpuProposition, rule: NonEmptyStr, premises: List<H11sslPremiseStanding>, losses: List<NonEmptyStr>) -> H11sslCpuInference? {
  match unit_reading(bmc_mac: t.bmc_mac) {
    Absent => Absent
    Present { value: r } => {
      let claim = Claim { id: rule, subject: t.bmc_mac, target: r.cpu, proposition: proposition, scope: t.stimulus, bound: t.reset_issued_at }
      let fact = RecordedFact { id: t.source.label, value: t }
      match first_unestablished_premise(premises: premises) {
        Present { value: obligation } => Present { value: insufficient_evidence_inference(insufficiency: EvidenceInsufficiency {
          fact: fact, claim: claim, inference_rule: rule, probe_independence: supermicro_h11ssl_snoop_trace_probe,
          reason: obligation,
        }) }
        Absent =>
      if !passed_dxe_ipl(t: t) {
        Present { value: insufficient_evidence_inference(insufficiency: EvidenceInsufficiency {
          fact: fact, claim: claim, inference_rule: rule, probe_independence: supermicro_h11ssl_snoop_trace_probe,
          reason: "the trace did not sample DXE IPL (0x4F) and progress past it",
        }) }
      } else {
        Present { value: infer_probe_evidence(
          fact: fact,
          direction: EvidenceSupports,
          inference_rule: rule,
          authority: r.observed_by,
          provenance: EvidenceProvenance { entity: t.source.label, activity: "BMC Snooping poll across a host reset", agent: r.observed_by as ProvAgentId },
          freshness: EvidenceFreshness { maximum_conclusion: claim, basis: "one reset of one unit with the part the operator attests fitted" },
          fidelity: EvidenceFidelity { boundary: t.polling, losses: concat(premise_losses(premises: premises), losses) },
          probe: supermicro_h11ssl_snoop_trace_probe,
        ) }
      }
      }
    }
  }
}

data supermicro_h11ssl_psb_losses: List<NonEmptyStr> = [
  "The PSB fuse state was not read (no PSP or BIOS PSB status read).",
  "A part fused to Supermicro's own key would POST on a Supermicro board too, so POSTing here does not separate unlocked from Supermicro-locked.",
  "Reading 0x4F as AMI's DXE IPL assumes AMI wrote it (supermicro_h11ssl_post_byte_emitter_standing).",
]

data supermicro_h11ssl_prior_stall_losses: List<NonEmptyStr> = [
  "The CPU was not the only change: unit 1 now reads BIOS 3.7 (2026-04-29) and IPMI 01.52.25 where its first contact read BIOS 2.6a and 1.52.00, and the BIOS at the 0x22 hold is not recorded.",
  "The memory changed: the 0x22 receipt's populations were ordinary ECC RDIMMs and an NVDIMM in C1; this trace had one SK Hynix HMA82GR7AFR4N-VK in DIMMC1.",
  "One trace per configuration; a hold that recurs intermittently would not be excluded by one pass.",
  "The attestation (2026-10-24) names the parts fitted then; that the 2026-10-23 trace ran with that same part assumes no swap in between, which nothing records.",
]

data supermicro_h11ssl_attested_lock_is_a_diagnosis_loss: NonEmptyStr = "That the original part was vendor-locked is the operator's diagnosis, not a fuse read; the hold following the part does not say whether the lock or another fault of that part caused it."

// The lock attestation of the removed part shapes the prior-stall link's losses. If it is attested
// locked, a reader could take the hold as the lock's signature, so the link says that the lock is
// a diagnosis. If it is attested unlocked, or its lock is not attested, no lock was claimed, and the loss is not carried.
fn supermicro_h11ssl_prior_stall_lock_losses(removed: H11sslAttestedCpuPart?) -> List<NonEmptyStr> {
  match removed {
    Present { value: p } => match p.lock { PartAttestedVendorLocked => [supermicro_h11ssl_attested_lock_is_a_diagnosis_loss]  PartAttestedUnlocked => []  PartLockNotAttested { read_obligation: _ } => [] }
    Absent => []
  }
}

// The PSB link for one trace takes the fitted part's attestation as its premise, since the
// operator's lock account bears on the proposition. If no part is attested fitted, the premise is
// owed. A part attested UNLOCKED, or one whose lock is NOT ATTESTED, admits the link: the premise is
// which part is fitted, and its lock is what the link infers. The attestation's unread is carried. A part
// attested VENDOR-LOCKED that nevertheless POSTed is a disagreement between the account and the
// trace, and the link is insufficient until the two are reconciled. It is never a Supports link
// over a contradicted premise.
fn supermicro_h11ssl_psb_inference_under(t: H11sslPostTrace, parts: List<H11sslAttestedCpuPart>) -> H11sslCpuInference? {
  let fitted = supermicro_h11ssl_attested_part(parts: parts, bmc_mac: t.bmc_mac, tenure: PartFittedNow)
  let premise = match fitted {
    Present { value: p } => match p.lock {
      PartAttestedUnlocked => PremiseOperatorAttested { attestation: p.attestation }
      PartLockNotAttested { read_obligation: _ } => PremiseOperatorAttested { attestation: p.attestation }
      PartAttestedVendorLocked => PremiseFigure { standing: TranscribedUncited { read_obligation: "The fitted part is attested vendor-locked, yet this trace POSTed on Supermicro firmware: the account and the trace disagree. Reconcile them (re-ask the operator, or read the PSB status) before inferring." } }
    }
    Absent => part_premise(part: fitted, owed: "No attested part is recorded as fitted in this unit; the operator's account of the fitted part grounds it.")
  }
  cpu_inference(t: t, proposition: PartNotPsbLockedToANonSupermicroVendor, rule: "posted-on-supermicro-firmware-is-consistent-with-not-locked-to-another-vendor", premises: [premise], losses: supermicro_h11ssl_psb_losses)
}

// One PSB inference per trace: each CPU that POSTed on a Supermicro board.
fn supermicro_h11ssl_psb_inferences() -> List<H11sslCpuInference?> {
  supermicro_h11ssl_post_traces |> map(t => supermicro_h11ssl_psb_inference_under(t: t, parts: supermicro_h11ssl_attested_cpu_parts))
}

// The prior-stall inference reads the stalled unit's trace with its new part. Its premises are
// the unit's two attested parts: the removed original the 0x22 hold was with, and the part fitted
// now. Both are the operator's attestation, so the link reads SUPPORTS, carrying what the
// attestation leaves unread and the confounders (BIOS, IPMI, memory) as losses; without either
// row it is insufficient. The removed part's lock attestation decides whether the "locked is a
// diagnosis" loss is carried (supermicro_h11ssl_prior_stall_lock_losses).
fn supermicro_h11ssl_prior_stall_premises(stall: H11sslPriorStall, parts: List<H11sslAttestedCpuPart>) -> List<H11sslPremiseStanding> {
  [
    part_premise(part: supermicro_h11ssl_attested_part(parts: parts, bmc_mac: stall.unit, tenure: PartRemoved), owed: "No attested part is recorded as the one this unit held at 0x22 with; the 0x22 receipt does not name its unit or part. The operator's account of the original part grounds it."),
    part_premise(part: supermicro_h11ssl_attested_part(parts: parts, bmc_mac: stall.unit, tenure: PartFittedNow), owed: "No attested part is recorded as fitted in this unit now; SMBIOS reads the serial as Unknown. The operator's account of the fitted part, or the package marking or PSP serial, grounds it."),
  ]
}

fn supermicro_h11ssl_prior_stall_inference_under(stall: H11sslPriorStall, parts: List<H11sslAttestedCpuPart>) -> H11sslCpuInference? {
  match first_where(supermicro_h11ssl_post_traces, t => t.bmc_mac == stall.unit) {
    Absent => Absent
    Present { value: t } => cpu_inference(t: t, proposition: PriorStallFollowedTheFirstCpu, rule: "same-board-passes-the-held-phase-with-another-part", premises: supermicro_h11ssl_prior_stall_premises(stall: stall, parts: parts), losses: concat(supermicro_h11ssl_prior_stall_losses, supermicro_h11ssl_prior_stall_lock_losses(removed: supermicro_h11ssl_attested_part(parts: parts, bmc_mac: stall.unit, tenure: PartRemoved))))
  }
}

fn supermicro_h11ssl_prior_stall_inference() -> H11sslCpuInference? {
  supermicro_h11ssl_prior_stall_inference_under(stall: supermicro_h11ssl_unit1_prior_stall, parts: supermicro_h11ssl_attested_cpu_parts)
}
