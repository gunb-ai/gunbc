// CONSUMPTION, declared frontier (DESIGN section 3c). These rows and folds are consumed by the
// witness now. The named later change is the same arrival-intake binding the first-contact receipt
// names (its trigger, the FRU Board Area read, came back blank on unit 2), and the BMC Snooping
// reader, whose rows would be appended to supermicro_h11ssl_post_traces.
//
// ---- POST traces. One row per reset, keyed by BMC MAC. A sample is a byte the poller read from
// the BMC Snooping PostCode with the observer's clock (second resolution) beside it.

type H11sslResetStimulus
  = WebInterfaceReset
  | RedfishForceRestart { standing: CitedFigureStanding }

type H11sslSnoopPolling
  = SnoopPolledEvery { interval: Millisecond, standing: CitedFigureStanding }
  | SnoopPollIntervalUnrecorded

type H11sslPostSample { at: Rfc3339Timestamp, code: Int }

type H11sslPostTrace {
  bmc_mac: Eui48Address
  stimulus: H11sslResetStimulus
  reset_issued_at: Rfc3339Timestamp
  polling: H11sslSnoopPolling
  samples: List<H11sslPostSample>
  source: EvidenceRef
}

fn s(at: Rfc3339Timestamp, code: Int) -> H11sslPostSample {
  H11sslPostSample { at: at, code: code }
}

