data witness_row_cost_site: CensusedEmitSite = CensusedEmitSite {
  marker: "[witness-row-cost]" as NonEmptyStr,
  producer: seed_producer(decl_name: "witness_cost_nanosecond_value"),
  consumption: unresolved_after_in_repo_search(),
  disposition: CountedFrontierSite {
    reason: "the surviving [witness-row-cost] emits, and the SYMBOL naming them is corrected here (2026-08-26). The batch-fed cost TSV probe this row originally described is deleted at the root, together with the drift and migration-disclosure siblings. What still carries the tag is the refusal vocabulary of the witness-cost projection helpers -- witness_cost_nanosecond_value, witness_cost_eval_durations, witness_cost_string_field and witness_cost_clock_nanos in cli_run.rs -- each returning a `[witness-row-cost] REFUSED: ...` string when a measured value will not inhabit its declared carrier. The tag family therefore exists in the seed and the bidirectional rule requires a roster row for it, while the population it names is refusals rather than a per-witness join projection. The prior text grounded this on `claim_executor discovery_claim_result`, which resolves to no declaration anywhere in the seed" as NonEmptyStr,
    dissolution: unbound_dissolution(description: "the refusal speaks the observation vocabulary as a typed ObservationEvent rather than a bracket-tagged eprintln, at which point the tag retires with it")
  }
}

data observation_emit_roster: List<CensusedEmitSite> = [
  floor_heartbeat_site,
  floor_claim_memory_site,
  typecheck_attribution_site,
  gantt_site,
  governor_site,
  measurement_site,
  shell_site,
  witness_claim_result_site,
  floor_drain_site,
  receipt_site,
  file_trace_site,
  resolve_split_site,
  assembly_split_site,
  witness_row_cost_site
]

// THE ROSTER UNDERSTATES, MEASURED, AND THE BIDIRECTIONAL CLAIM ABOVE IS THEREFORE FALSE AS STATED
// (2026-08-26). Counting distinct bracket-tag string literals across the six sources in
// seed_emit_sources gives 57 tag spellings; this roster carries 14 rows, 13 of them bracket tags
// (the fourteenth is a mirror function name). Subtracting leaves 44 spellings live in the seed and
// absent from this roster -- among them [ancestry], [interp-stats], [floor-phase], [floor-cgroup],
// [floor-terminal], [affected-set], [realize-advisory] and [expected-red-roster-join]. THAT 45 IS
// AN UPPER BOUND AND IS NOT THE FRONTIER DEBT, and saying so precisely is the point: a bracket
// literal is not the same thing as a tagged progress emit, several of these are certainly not emit
// tags at all, and nothing here distinguishes a live emit from a literal in a comparison, a parser,
// or a doc example. The instrument that produced the figure is a spelling grep over six files,
// which is exactly the instrument this module's witness note already rules insufficient -- so the
// number is quoted as the shape of the gap, never as its size. WHY IT IS RECORDED RATHER THAN
// REPAIRED BY ADDING 45 ROWS: every one of those rows would be hand-authored from a spelling, with
// a disposition and a dissolution trigger invented by whoever wrote it, which is the failure this
// file has now recorded four times and the thing its own witness note calls `a hand-maintained
// approximation of a discovery it cannot perform`. Enlarging the approximation does not close the
// gap; it multiplies the surface that rots. NEXT-RUNG TRIGGER, AND IT IS A SUBSTRATE CAPABILITY
// RATHER THAN EFFORT: the discovery this needs -- occurrence-grain extraction of tagged emits from
// seed source -- is not expressible in .dag today. The interpreter registers exactly two string
// builtins, string_contains and string_length (measured over the seed's builtin registrations), so
// a fold can ask `does this text contain that` and can ask nothing about WHERE, HOW MANY, or WHAT
// ELSE OF THIS SHAPE. Membership is decidable; enumeration is not reachable. This class therefore
// sits at MITIGATABLE with a named trigger rather than at an untracked stall: the trigger is a
// modeled scan surface over source text -- occurrence positions, or a split, or an ingestion of the
// seed as a Node tree the way v1_compiler.declaration_index now ingests .dag modules -- after which
// the roster is JOINED against discovered occurrences and this note is deleted rather than amended.

data observation_emit_roster_completeness_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.observation_emit_census",
    decl_name: "observation_emit_roster",
    field: WholeDeclaration
  }
}

// Roster is bidirectional: every rostered marker must still exist in the seed, AND every known live
// tag family born after the initial snapshot must appear on the roster (operator finding 3, run
// 30142403230). The frontier families are floor-drain, receipt, file, resolve-split, assembly-split
// and witness-row-cost. THE COUNT IS DELIBERATELY NOT WRITTEN HERE: observation_emit_frontier_count
// folds the roster, so it is the only authority for how many there are, and a number recited beside
// an enumeration is a second account of a population this module already computes. TWO CORRECTIONS
// LANDED HERE ON 2026-08-22, in opposite directions, and both are recorded because each was nearly
// made worse by the other. The recital that stood here said 8 and named
// witness-row-cost-migration-disclosure among the live families; that one is genuinely gone, its
// emit deleted at the root with the batch-fed materialization. But this note ALSO named
// selection-degradation, which has no emit in the seed and has never been on this roster -- so the
// enumeration overstated by a family that never existed while the count beside it was computed from
// rows that did, and the two errors partially cancelled. AND witness-row-cost was removed from this
// roster in that same change on the premise that its marker was gone; it is not. A live eprintln
// survives on a path with production callers, so removing the row broke the bidirectional rule this
// very sentence states -- a live tag family absent from the roster. (THE SYMBOL THAT SENTENCE
// ORIGINALLY NAMED, `claim_executor discovery_claim_result`, RESOLVES TO NOTHING and was fabricated
// when written; the emits are the witness_cost_* helpers in cli_run.rs, corrected 2026-08-26 on the
// row itself. The row's premise was right and its citation was invented, which is why the
// correction is a citation repair and not a reclassification.) The row is restored above with a
// rewritten reason. What makes this worth recording rather than quietly fixing: the removal was
// reviewed, the review agreed the marker was gone, and NOTHING WOULD HAVE CAUGHT IT, because the
// hand-maintained bidirectional conjunction that covers this tag was deleted in the same diff.
// Correcting the prose to match the roster would have cemented the defect instead of exposing it --
// the census's own hygiene depends on a check that a prose-consistency pass can silently remove.
// THE MIGRATED FAMILIES ARE NOT ENUMERATED HERE ANY LONGER, and the deletion of that enumeration is
// this note's own rule finally applied to itself: the sentence that stood here named floor-memory
// first, and on 2026-08-26 floor-memory's emit left the seed with #9228, so the recital went false
// in exactly the way the paragraphs above and below predict a hand-maintained enumeration will.
// observation_emit_roster names the migrated rows; restating them here was the second naming
// scheme, and it is the one that rotted. NEITHER A COUNT NOR THIS ENUMERATION SHOULD BE MAINTAINED
// HERE AT ALL, and the enumeration above survives only as the corrected record of what went wrong:
// observation_emit_roster names the migrated rows, so restating them in prose is a second naming
// scheme for something the roster already names, and it is the naming scheme that rots. No derived
// migrated_count is minted beside observation_emit_frontier_count either, deliberately -- the
// frontier count has a real target (the zero-target acceptance drives it to nothing) while a
// migrated count has nothing driving it, so it would be an artifact with no consumer, and the only
// assertions available over it are `measure() == measure()` or a literal copied from the current
// tree. THIS RECITAL SAID `Eight` AND NAMED witness-budget-warn, which has no row in this roster
// and never had one, while omitting nothing -- so the stated count exceeded the population by
// exactly the fabricated member. That is the SAME two-directional failure this note already records
// on the frontier side, arriving on the migrated side and surviving the pass that fixed the other:
// a count and an enumeration maintained by hand beside each other, where a wrong member and a wrong
// total can agree. RETIRED BY DELETION 2026-08-11, and the distinction matters: gate-warm-cost,
// witness-row-cost-drift and compile-clean-cost-drift left this roster because their raw emits were
// DELETED from the seed, not because they migrated to the observation vocabulary. There is no
// roster arm for that, and there should not be one — the census rosters emit sites that exist, so a
// site with no emit is simply absent. What replaced them is the floor-receipts artifact plus each
// receipt's [receipt] summary line, and [receipt] is itself still a counted frontier family on this
// roster, so the debt those three represented did not vanish, it CONSOLIDATED into a row that is
// still counted. Reading 10 -> 8 as two families' worth of progress would overstate it; the honest
// reading is that three raw TSV mirrors stopped existing and one already-counted summary family
// absorbed their role. The unmarked eprintln sites remain the per-print completeness scaffold.

fn emit_site_is_frontier(site: CensusedEmitSite) -> Bool {
  match site.disposition {
    MigratedToObservation { via: _ } => false
    CountedFrontierSite { reason: _, dissolution: _ } => true
  }
}

fn emit_site_dissolve_on(site: CensusedEmitSite) -> String {
  match site.disposition {
    MigratedToObservation { via: v } => v
    CountedFrontierSite { reason: _, dissolution: d } => dissolution_description(condition: d)
  }
}

fn emit_site_consumer_unresolved(site: CensusedEmitSite) -> Bool {
  match site.consumption {
    MachineConsumed { reader: _, fields_read: _ } => false
    HumanPresentationOnly { evidence: _ } => false
    ConsumerUnresolved { searched: _ } => true
  }
}

// The producer's SYMBOL, for the seed-presence check: a named producer that has left the seed is a
// row citing a deleted declaration, which is the fabricated-citation class this file has recorded
// once already ([witness-row-cost] on `claim_executor discovery_claim_result`).
fn emit_site_producer_symbol(site: CensusedEmitSite) -> String? {
  match site.producer {
    ProducerDeclared { declaration: d } => Present { value: d.decl_name }
    ProducerUnlocated { reason: _ } => Absent
  }
}

fn observation_emit_unresolved_consumer_count() -> Nat {
  fold(observation_emit_roster, init: 0, f: (acc, site) =>
    if emit_site_consumer_unresolved(site: site) { acc + 1 } else { acc })
}

fn observation_emit_located_producer_count() -> Nat {
  fold(observation_emit_roster, init: 0, f: (acc, site) =>
    match emit_site_producer_symbol(site: site) { Present { value: _ } => acc + 1  Absent => acc })
}

fn observation_emit_frontier_count() -> Nat {
  fold(observation_emit_roster, init: 0, f: (acc, site) =>
    if emit_site_is_frontier(site: site) { acc + 1 } else { acc })
}

data observation_emit_census_disposition: Disposition = Terminal {
  reason: "The census MODEL is Terminal — a closed classification of emit sites is the wall's authority, not an interim stand-in. What is a scaffold is the ROSTER's completeness (declared above), because the site list grows when post-rewrite sites are enumerated. The model that classifies them does not change; only the rows do."
}
