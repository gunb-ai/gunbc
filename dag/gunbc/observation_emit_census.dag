  disposition: CountedFrontierSite {
    reason: "schedule-retention / typed-cache drain diagnostics born after the initial census snapshot — retention kit instrumentation, not yet an observation projection" as NonEmptyStr,
    dissolution: unbound_dissolution(description: "re-census into MigratedToObservation once drain events speak the observation vocabulary (or retire the tag into a named group summary)")
  }
}

