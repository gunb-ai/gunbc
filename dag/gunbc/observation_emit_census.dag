data witness_row_cost_migration_disclosure_site: CensusedEmitSite = CensusedEmitSite {
  marker: "[witness-row-cost-migration-disclosure]" as NonEmptyStr,
  source_file: "src/v1/stage0/src/bin/claim_executor.rs" as NonEmptyStr,
  disposition: CountedFrontierSite {
    reason: "falsifier-cadence mandatory-migration disclosure lines (gunbc.witness_row_cost's migration threshold gate) — the per-row verdict body is cadence-scoped exactly as witness_row_cost_site/witness_row_cost_drift_site are, and the per-PR floor keeps only the worst-5 rows plus the [receipt] summary naming the TSV; still a raw tag family. DESCRIPTION CORRECTED: this row previously read 'per-floor-pass ... per-row verdict plus a worst-5 summary', which described the pre-#8126 behavior where all 8,614 rows printed on every floor run; the row was not updated when the emit was gated, so the census described a cadence the seed no longer had" as NonEmptyStr,
    dissolution: unbound_dissolution(description: "fold into ObservationEvent-native emission once the disclosure speaks the observation vocabulary, same trigger as witness_row_cost_site/witness_row_cost_drift_site")
  }
}



data observation_emit_roster: List<CensusedEmitSite> = [
  floor_memory_site,
  typecheck_attribution_site,
  gantt_site,
  governor_site,
  measurement_site,
  shell_site,
  witness_claim_result_site,
  floor_drain_site,
  receipt_site,
  file_trace_site,
  resolve_split_site,
  assembly_split_site,
  witness_row_cost_site,
  witness_row_cost_migration_disclosure_site
]

data observation_emit_roster_completeness_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.observation_emit_census",
    decl_name: "observation_emit_roster",
    field: WholeDeclaration
  }
}

data observation_emit_roster_completeness_note: String = "Roster is bidirectional: every rostered marker must still exist in the seed, AND every known live tag family born after the initial snapshot must appear on the roster (operator finding 3, run 30142403230). Frontier count = 8 (floor-drain, receipt, file, resolve-split, assembly-split, witness-row-cost, witness-row-cost-migration-disclosure, selection-degradation). Eight families MigratedToObservation (floor-memory, gantt, governor, typecheck-attribution, measurement, shell, witness-claim-result, witness-budget-warn). RETIRED BY DELETION 2026-08-11, and the distinction matters: gate-warm-cost, witness-row-cost-drift and compile-clean-cost-drift left this roster because their raw emits were DELETED from the seed, not because they migrated to the observation vocabulary. There is no roster arm for that, and there should not be one — the census rosters emit sites that exist, so a site with no emit is simply absent. What replaced them is the floor-receipts artifact plus each receipt's [receipt] summary line, and [receipt] is itself still a counted frontier family on this roster, so the debt those three represented did not vanish, it CONSOLIDATED into a row that is still counted. Reading 10 -> 8 as two families' worth of progress would overstate it; the honest reading is that three raw TSV mirrors stopped existing and one already-counted summary family absorbed their role. The unmarked eprintln sites remain the per-print completeness scaffold."

fn emit_site_is_frontier(site: CensusedEmitSite) -> Bool {
  match site.disposition {
    MigratedToObservation { via: _ } => false
    CountedFrontierSite { reason: _, dissolution: _ } => true
  }
}

fn emit_site_dissolve_on(site: CensusedEmitSite) -> String {
  match site.disposition {
    MigratedToObservation { via: v } => v
    CountedFrontierSite { reason: _, dissolution: d } => dissolution_description(condition: d)
  }
}

fn observation_emit_frontier_count() -> Nat {
  fold(observation_emit_roster, init: 0, f: (acc, site) =>
    if emit_site_is_frontier(site: site) { acc + 1 } else { acc })
}

data observation_emit_census_disposition: Disposition = Terminal {
  reason: "The census MODEL is Terminal — a closed classification of emit sites is the wall's authority, not an interim stand-in. What is a scaffold is the ROSTER's completeness (declared above), because the site list grows when post-rewrite sites are enumerated. The model that classifies them does not change; only the rows do."
}
