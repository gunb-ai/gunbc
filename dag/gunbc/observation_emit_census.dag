data witness_row_cost_site: CensusedEmitSite = CensusedEmitSite {
  marker: "[witness-row-cost]" as NonEmptyStr,
  source_file: "src/v1/stage0/src/bin/claim_executor.rs" as NonEmptyStr,
  disposition: CountedFrontierSite {
    reason: "the surviving [witness-row-cost] emit, and its reason is REWRITTEN rather than carried over because what emits under this tag changed underneath it on 2026-08-22. The batch-fed cost TSV probe this row used to describe is deleted at the root, together with the drift and migration-disclosure siblings. What still emits is the refusal line in claim_executor discovery_claim_result, on the live path with production callers -- so the tag family exists in the seed and the bidirectional rule requires a roster row for it, while the population it names is now one refusal rather than a per-witness join projection" as NonEmptyStr,
    dissolution: unbound_dissolution(description: "the refusal speaks the observation vocabulary as a typed ObservationEvent rather than a bracket-tagged eprintln, at which point the tag retires with it")
  }
}

data observation_emit_roster: List<CensusedEmitSite> = [
  floor_memory_site,
  typecheck_attribution_site,
  gantt_site,
  governor_site,
  measurement_site,
  shell_site,
  witness_claim_result_site,
  floor_drain_site,
  receipt_site,
  file_trace_site,
  resolve_split_site,
  assembly_split_site,
  witness_row_cost_site
]

data observation_emit_roster_completeness_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.observation_emit_census",
    decl_name: "observation_emit_roster",
    field: WholeDeclaration
  }
}

data observation_emit_roster_completeness_note: String = "Roster is bidirectional: every rostered marker must still exist in the seed, AND every known live tag family born after the initial snapshot must appear on the roster (operator finding 3, run 30142403230). The frontier families are floor-drain, receipt, file, resolve-split, assembly-split and witness-row-cost. THE COUNT IS DELIBERATELY NOT WRITTEN HERE: observation_emit_frontier_count folds the roster, so it is the only authority for how many there are, and a number recited beside an enumeration is a second account of a population this module already computes. TWO CORRECTIONS LANDED HERE ON 2026-08-22, in opposite directions, and both are recorded because each was nearly made worse by the other. The recital that stood here said 8 and named witness-row-cost-migration-disclosure among the live families; that one is genuinely gone, its emit deleted at the root with the batch-fed materialization. But this note ALSO named selection-degradation, which has no emit in the seed and has never been on this roster -- so the enumeration overstated by a family that never existed while the count beside it was computed from rows that did, and the two errors partially cancelled. AND witness-row-cost was removed from this roster in that same change on the premise that its marker was gone; it is not. A live eprintln survives in claim_executor discovery_claim_result on a path with production callers, so removing the row broke the bidirectional rule this very sentence states -- a live tag family absent from the roster. The row is restored above with a rewritten reason. What makes this worth recording rather than quietly fixing: the removal was reviewed, the review agreed the marker was gone, and NOTHING WOULD HAVE CAUGHT IT, because the hand-maintained bidirectional conjunction that covers this tag was deleted in the same diff. Correcting the prose to match the roster would have cemented the defect instead of exposing it -- the census's own hygiene depends on a check that a prose-consistency pass can silently remove. The migrated families are floor-memory, typecheck-attribution, gantt, governor, measurement, shell and witness-claim-result. NEITHER A COUNT NOR THIS ENUMERATION SHOULD BE MAINTAINED HERE AT ALL, and the enumeration above survives only as the corrected record of what went wrong: observation_emit_roster names the migrated rows, so restating them in prose is a second naming scheme for something the roster already names, and it is the naming scheme that rots. No derived migrated_count is minted beside observation_emit_frontier_count either, deliberately -- the frontier count has a real target (the zero-target acceptance drives it to nothing) while a migrated count has nothing driving it, so it would be an artifact with no consumer, and the only assertions available over it are `measure() == measure()` or a literal copied from the current tree. THIS RECITAL SAID `Eight` AND NAMED witness-budget-warn, which has no row in this roster and never had one, while omitting nothing -- so the stated count exceeded the population by exactly the fabricated member. That is the SAME two-directional failure this note already records on the frontier side, arriving on the migrated side and surviving the pass that fixed the other: a count and an enumeration maintained by hand beside each other, where a wrong member and a wrong total can agree. RETIRED BY DELETION 2026-08-11, and the distinction matters: gate-warm-cost, witness-row-cost-drift and compile-clean-cost-drift left this roster because their raw emits were DELETED from the seed, not because they migrated to the observation vocabulary. There is no roster arm for that, and there should not be one — the census rosters emit sites that exist, so a site with no emit is simply absent. What replaced them is the floor-receipts artifact plus each receipt's [receipt] summary line, and [receipt] is itself still a counted frontier family on this roster, so the debt those three represented did not vanish, it CONSOLIDATED into a row that is still counted. Reading 10 -> 8 as two families' worth of progress would overstate it; the honest reading is that three raw TSV mirrors stopped existing and one already-counted summary family absorbed their role. The unmarked eprintln sites remain the per-print completeness scaffold."

fn emit_site_is_frontier(site: CensusedEmitSite) -> Bool {
  match site.disposition {
    MigratedToObservation { via: _ } => false
    CountedFrontierSite { reason: _, dissolution: _ } => true
  }
}

fn emit_site_dissolve_on(site: CensusedEmitSite) -> String {
  match site.disposition {
    MigratedToObservation { via: v } => v
    CountedFrontierSite { reason: _, dissolution: d } => dissolution_description(condition: d)
  }
}

fn observation_emit_frontier_count() -> Nat {
  fold(observation_emit_roster, init: 0, f: (acc, site) =>
    if emit_site_is_frontier(site: site) { acc + 1 } else { acc })
}

data observation_emit_census_disposition: Disposition = Terminal {
  reason: "The census MODEL is Terminal — a closed classification of emit sites is the wall's authority, not an interim stand-in. What is a scaffold is the ROSTER's completeness (declared above), because the site list grows when post-rewrite sites are enumerated. The model that classifies them does not change; only the rows do."
}
