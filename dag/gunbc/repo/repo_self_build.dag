module gunbc.repo.repo_self_build

import std.types { String, List, NonEmptyStr }
import gunbc.stage0.stage0_crate_partition_generated { generated_partition_crate_rows }
import gunbc.repo.repo_self_warning_policy { repo_self_warning_denial, repo_self_warning_denial_rustflags }
import extdeps.rust.cargo_build { cargo_clippy_command }
import extdeps.exec.command { argv_words }

// THE SINGLE POINT THROUGH WHICH THIS REPOSITORY BUILDS ITS OWN BINARIES.
// Before this module the same operation was spelled independently in three
// workflow authorities and hand-authored in a fourth, with the bin sets
// differing and nothing relating them, so "how this repo builds its compiler"
// had four owners and could be changed inconsistently -- which it already had
// been. Operator ruling 2026-08-24: everything compiles through the same
// point, no forks allowed.
//
// The split follows DESIGN section 3. The cargo BUILD SHAPE is upstream's and
// belongs to extdeps.rust.cargo. WHICH package and WHICH bins is business
// policy and lives here. How a consumer transports it -- a workflow RunStep, a
// host effect, an interpreter service call -- is realization and lives with
// the consumer. A caller that writes the argv itself has taken all three back.
//
// The construction is not novel: witness_floor_workflow already folded a bin
// roster onto one base command, correctly, in private. What was missing was
// not the idea but its REACH -- three other consumers could not call it. This
// module is that function promoted to where every consumer can reach it.

data repo_self_build_authority_note: String = "Single authority for the argv this repository uses to build its own binaries. The package is a fact about THIS repository's layout, not about cargo, so it is data here rather than a parameter every caller re-supplies: a caller free to name the package could build a different crate and still look like a conforming call. The BIN SET is a parameter because it genuinely differs by consumer -- the required floor needs claim_executor and gunbc, fleet-converge needs gunbc alone -- and that difference is the only axis on which honest callers disagree. THE CARGO ARGV WORDS HERE ARE A REAL FORK AGAINST extdeps.rust.cargo_build AND CONSUMING IT IS NOT AVAILABLE, which review 55636 raised and which is recorded with its measurement so the next author does not attempt the drop-in and discover this alone. Every cargo argv word in that module -- \"cargo\", \"build\", \"-p\", \"--bin\" -- appears ONLY inside a transport shell block: measured on the live file, its entire declaration surface is one ExternalAuthority anchor, one env map, one note and two jobs-flag fns, and no data or fn exposes the vocabulary at all. So there is no expression a fn in this module could read it from, and the argv is fused to the shell transport that spells it. That is exactly the DESIGN section 3 interface-versus-realization seam: this consumer needs a workflow YAML STRING, which is a second realization of the same operation, so the correct repair is to DE-FUSE the operation shape from transport shell and bind both realizations to it -- not to have this module reach into a transport block, which is not a thing the language admits. The follow-up is therefore de-fusion in extdeps, strictly larger than this PR and correctly outside it; until it lands the fork stands, named rather than silent. SO THIS STRING RENDERER IS A BOUNDED WORKFLOW ADAPTER AND IS DECLARED AS ONE, not a second cargo authority claiming equal standing with the modeled surface. The split it adapts across is: cargo syntax and invocation shape belong to the extdeps cargo authority; repository package and bin policy belong here; workflow shell rendering belongs to the workflow realization. This module currently spans the second and third of those and borrows the first, which is precisely the boundary the de-fusion above closes. DISSOLUTION TRIGGER: this renderer dissolves when the cargo operation shape is de-fused from transport shell and can be bound to a workflow-text realization, at which point repo_self_build produces a TYPED cargo invocation carrying package and bins and a shared renderer lowers it -- and the argv words disappear from this module entirely rather than being spelled correctly here. Until then the correct reading of these fns is an adapter with a named terminus, and a reviewer should refuse any NEW argv word added here that the modeled surface already owns."

// TWO AXES WERE BUILT HERE AND BACKED OUT BEFORE MERGE, recorded so the next author does not
// re-derive them from scratch. A CargoBuildSubject coproduct (RepositoryCrate |
// EmittedCandidateTree { manifest_path }) and a CargoVerb (CargoBuild | CargoCheck) were added for
// the self-host regen gate, which must cargo-check an EMITTED CANDIDATE TREE -- a different crate,
// which the package-as-data decision above structurally excludes -- and for which check suffices
// because it establishes the required compile diagnostics without paying for final binary
// production. THE COMPARISON THAT ESTABLISHED THAT IS NAMED RATHER THAN TRANSCRIBED, and an earlier
// revision of this note carried its wall times and peak memory directly. That was the
// measurement-bankruptcy violation the authority on main forbids in as many words -- name the
// instrument, never transcribe its output -- committed in a .dag authority by the same branch that
// ported the corrected rule into the design document, which is the sharpest available demonstration
// that a transcribed number is authored faster than the rule against it is remembered. The
// re-deriving producer is a cargo check against a cargo build of the same subject at the same head;
// the qualitative claim above is the enduring one and the magnitudes are a property of the run that
// measured them. Review 55633 called them speculative widening and was right: nothing in that diff
// consumed either axis, the sole caller pinned both to their defaults, and DESIGN section 6 names a
// new artifact with no final consumer as experimental residue. The same standard had just been
// applied one PR over, where an unwired affected-set lens was split out of this branch for exactly
// this reason; leaving these in would have been that principle applied to one artifact and not its
// neighbour. THE DESIGN STANDS AND IS NOT RE-OPENED BY THE BACK-OUT: a free package parameter is
// the wrong remedy because it discards the property the note above relies on, and a sibling
// authority sharing this argv vocabulary is the section 3 fork this module exists to prevent -- so
// the subject belongs here as a CLOSED vocabulary, and it lands in the diff that carries its
// consumer rather than ahead of it.

data repo_self_build_package: NonEmptyStr = "v1-compiler"

data repo_self_build_profile_flag: String = "--release"

data repo_self_build_empty_bins_note: String = "An empty bin set renders the package build with no --bin selector, which is cargo's own meaning for it (build every target in the package) and is a DIFFERENT request from building a named subset -- not a degenerate case of one. It is rendered rather than refused because a fold over an empty roster produces exactly this string in the construction this module promotes, so the state is reachable by an honest caller; a refusal here would break a caller that is asking cargo a legitimate question."

fn repo_self_build_bin_flag(bin: String) -> String {
  join(["--bin ", bin], "")
}

fn repo_self_build_bin_selector(bins: List<String>) -> String {
  join(bins |> map(b => repo_self_build_bin_flag(bin: b)), " ")
}

fn repo_self_build_package_command() -> String {
  join(
    ["cargo build", repo_self_build_profile_flag, "-p", repo_self_build_package as String],
    " "
  )
}

data repo_self_build_all_bins_flag: String = "--bins"

// ALL DECLARED BIN TARGETS, WHICH IS A DIFFERENT REQUEST FROM EITHER OF THE TWO ABOVE.
// The empty-bin-set note above describes cargo's bare package build, which builds the lib and
// every target; this asks for exactly the BIN targets and nothing else. The distinction is the
// reason a caller wants it: the question is whether every binary this package DECLARES still
// compiles, and a bin that no consumer selects is precisely the one that rots unobserved --
// gunbc#9205 repaired one such bin after it had drifted with nothing building it. So the roster
// is read from the manifest by cargo rather than restated as a list here, which is the same
// single-authority move this module makes for the package name: a caller free to enumerate the
// bins could omit the drifting one and still look like a conforming call.
//
// The argv word is a real addition to the fork this module's authority note declares, and it is
// added under that note's own terms rather than against them: the note refuses a NEW argv word
// the modeled surface already owns, and the measurement it records is that extdeps.rust.cargo
// exposes no vocabulary at all outside a transport shell block -- so there is nothing to consume
// for `--bin` today and nothing for `--bins` either. It dissolves with the rest of this adapter
// on the same trigger.
fn repo_self_build_all_bins_command() -> String {
  join([repo_self_build_package_command(), repo_self_build_all_bins_flag], " ")
}

// THE PACKAGE'S OWN UNIT TESTS, as one cargo invocation. The 774 `#[test]`s under src/v1/stage0
// ran on no CI path at all before the 2026-08-29 gate (no workflow invoked `cargo test`); they
// are the v1 compiler's cheapest regression net and now run in their own job. `--lib` is
// deliberate: the bin targets' tests would each link a binary, and the required build lane
// already establishes that every bin compiles.
fn repo_self_test_command() -> String {
  join(
    ["cargo test", repo_self_build_profile_flag, "-p", repo_self_build_package as String, "--lib"],
    " "
  )
}

// A NAMED SUBSET OF ONE PACKAGE'S UNIT TESTS, for a control in a package the whole-package run above
// does not cover: the blocking rust-unit-tests lane runs repo_self_test_command, which is
// v1-compiler only.
// The filters are libtest's substring filters after `--`; an empty list would run the whole
// package, which is repo_self_test_command's request and not this one.
fn repo_self_targeted_test_command(package: String, filters: List<String>) -> String {
  join(concat(["cargo test", repo_self_build_profile_flag, "-p", package, "--lib", "--"], filters), " ")
}

// The crate the emitted runtime v1_rt.rs is compiled in (the stage0 partition's foundation crate).
data repo_self_runtime_package: String = "v1-stage0-runtime"

// THE EMITTED RUNTIME'S SLICE COST CONTROLS, ENROLLED. v1_rt list_slice_tests carries a RED that runs
// the copying skip / take templates the emit table used to render and a GREEN that runs
// list_skip / list_take, on non-ASCII code points, so the pair discriminates the quadratic rather
// than merely exercising the slice. Only this crate is named: the interpreter's slice and drop
// controls (v1_interpreter slice_cost_tests, value_depth_walker_tests) are in v1-compiler's own
// unit tests, which the blocking rust-unit-tests lane already runs whole (repo_self_test_command),
// and running them again here would be the same work twice. v1-stage0-runtime is outside that
// lane's package, so without this step its controls would only compile.
fn repo_self_slice_cost_control_command() -> String {
  repo_self_targeted_test_command(package: repo_self_runtime_package, filters: ["list_slice_tests"])
}

// THE LINT PASS OVER EVERY TARGET, as the one invocation DESIGN's "Building & checks" names.
// `--all-targets` is the whole point: the test and example targets outside `--lib` and `--bins`
// are compiled by no build command above and executed by no test command, so before this row
// they were compiled by nobody -- and on 2026-08-30 twelve of them were red on main (E0603s from
// the cli_run decomposition, an E0063 from a Node field, an include_str! of a deleted fixture,
// a retired dispatch family, two lints) while every required phase stayed green. This is the
// workspace-wide form, not `-p v1-compiler`: the partition crates and the receipt fixture are
// targets too, and a lint gate scoped to one package would re-open exactly the blind spot the
// partition-crates command below closes for the build.
// NO CARGO ARGV WORD IS SPELLED HERE, which repo_self_build_authority_note requires of any NEW
// command this module renders: the verb, the program and the `--` lint separator come from
// extdeps.rust.cargo_build cargo_clippy_command, and this module contributes only the two facts that are
// genuinely its own -- that the lint pass covers every target, and that a warning is an error. The
// String is the workflow-text realization of that node, derived by the shared argv_words fold, not
// a second spelling of it.
fn repo_self_clippy_command() -> String {
  join(
    argv_words(
      command: cargo_clippy_command(extra_args: ["--all-targets"], lint_args: repo_self_warning_denial)
    ),
    " "
  )
}

// The warning-denial policy row moved to gunbc.repo.repo_self_warning_policy so a consumer wanting
// only the policy does not link this module's transport (extdeps.rust.cargo_build,
// extdeps.exec.command). It is imported above and still spelled once.

// THE DERIVED STAGE0 PARTITION CRATES, WHICH THE PACKAGE-AS-DATA DECISION ABOVE DOES NOT REACH.
// repo_self_build_package is one package because that was the whole repository's compiler for as
// long as this module existed. The stage0 partition splits that compiler across seven SIBLING
// packages, and none of them is v1-compiler, so every command above builds none of them --
// which is exactly how #9689 put main's whole-workspace build in a state no required run could
// see. Three modules landed in stage0 lib.rs and in the partition authority's blind spot at once,
// and v1-stage0-v1-infer failed with E0432 on all three for a day while the required gate,
// building the two v1-compiler bins, stayed green.
//
// THE PACKAGE LIST IS READ FROM THE PARTITION ROSTER AND IS NOT RESTATED HERE, for the same
// reason repo_self_build_all_bins_command asks cargo for the bin roster rather than enumerating
// it: a caller free to enumerate the packages could omit the one that is drifting and still look
// like a conforming call. Adding a crate to the partition adds it to this command with no edit
// here, so the gate cannot fall behind the authority it is guarding.
//
// WHAT THIS BUYS, STATED AS THE REFUSAL IT PRODUCES RATHER THAN AS COVERAGE. rustc is the oracle
// for "every crate:: reference in a rostered module resolves inside its crate's reexport
// closure". A module dropped from a roster reds with E0432 naming the module and the referrer; a
// roster entry naming no file reds with E0583 naming the entry. That class has no hermetic
// witness available: gunbc.stage0.stage0_rust_product_reachability declares the Rust module dependency
// graph unmodeled in rust_module_dependency_graph_unresolved_edge, and a joining witness that
// read the tree instead would declare ReadsLiveTree and be declined by the required floor. So
// this build IS the wall, and the modeled dependency graph is the trigger for climbing off it.
//
// NOT A WHOLE-WORKSPACE WIDENING, and deliberately not: this names the partition packages, so a
// declared bin or crate outside both this list and the v1-compiler package remains unbuilt by any
// required phase. That gap is the 2026-08-25 declared row and this command does not close it.
fn repo_self_build_partition_crate_packages() -> List<String> {
  generated_partition_crate_rows |> map(row => row.package_name)
}

// THE BUILD ENVIRONMENT EVERY SEED BINARY IS BUILT IN. One commit must give one sha256, and before
// this preamble was consumed by the seed-build steps it did not: the same commit built DIFFERENT
// bytes on runners whose absolute checkout path, CARGO_TARGET_DIR, CARGO_HOME or rustc sysroot
// differed, because each of those absolute paths is baked into the binary's .rodata (panic Location
// strings and file literals) with nothing normalizing them, and because a runner-local untracked
// file flipped build.rs's `-dirty` identity suffix. The measured experiment, the classification,
// and the interim citation rule live in gunbc.recurring_failure_mode.seed_sha256_is_runner_relative;
// the discriminating control that keeps this honest is the ignored seed_build_reproducibility_falsifier
// (its green arm builds one commit twice from two clones with the preamble and requires cmp-equal
// sha256; its red arm disables the remap and requires the hashes to differ). This is NOT a second
// cargo authority: it is the environment half of the same build operation repo_self_build_command
// owns the argv for, and a seed-build step that spells its own RUSTFLAGS has taken both halves back.
//
// THE FOUR PREFIXES ARE NOT INDIVIDUALLY NEGOTIABLE. Each names an input rustc fuses into string
// literals reachable from the produced binary -- checkout, target directory, registry home, sysroot
// -- and the control's red arm goes red if any one is absent, so a future author dropping one meets
// a red test rather than silent receipt drift. The target prefix is not paranoia: two runners with
// the same checkout at different depths proved the build directory reaches the binary too.
//
// THE WARNING DENIAL IS CARRIED AS A SETTING OF THE SAME TABLE KEY, NOT AS A RIVAL TO IT, AND THE
// DISTINCTION IS LOAD-BEARING: .cargo/config.toml carries `[build] rustflags = ["-D", "warnings"]`,
// and an ambient RUSTFLAGS OVERRIDES that table key entirely rather than extending it. So the denial
// is asserted here as the same fact that file states (its comment names
// gunbc.repo.repo_self_warning_policy as its source), and a seed build must reach the same floor with
// or without this preamble. That is what makes the falsifier's red arm -- remap disabled, denial still
// applied, still -D warnings -- the meaningful comparison: if dropping the denial were the difference,
// the reproducibility claim would be resting on a silent floor inversion.
//
// THE IDENTITY PIN IS THE CONTENT IDENTITY. GUNBC_MATERIALIZED_TREE_IDENTITY is pinned to
// tree:<object-format>:<HEAD^{tree}> -- the value shape the fleet release-bins key already computes
// as its SOURCE_CLOSURE axis, so both name the same commit content -- but only when the TRACKED tree
// is clean, checked with --untracked-files=no. Untracked files are excluded from that test because
// they reach neither rustc nor the identity: a tracked module graph reaching an untracked file would
// mean HEAD itself does not build, so an untracked runner scratch file changing the seed's bytes was
// the bug being repaired, not a fact to preserve (that is the same rule src/v1/stage0/build.rs
// applies to its `-dirty` suffix, and the two must agree or the suffix reappears as variance).
// A TRACKED-DIRTY TREE IS NOT REFUSED, IT IS LEFT UNPINNED: build.rs then bakes `<head>-dirty`,
// which names the build honestly as "this commit plus an edit that is in no commit". Refusing
// instead would be a new CI behavior for a case the suffix already describes, and a seed-build step
// is not where an uncommitted edit gets adjudicated. Producers that consume this preamble get the
// content identity automatically; a producer that does not falls back to git HEAD plus the
// tracked-dirty suffix, which is why every seed-build site consumes this and none re-spells it.
//
// WHY THE REMAP IS NOT A KEY INPUT the fleet release-bins key must name. Each prefix names a
// LOCATION -- checkout, target directory, registry home, sysroot -- and the key already excludes the
// location-naming environment variables (CARGO_HOME, RUSTUP_HOME, CARGO_BIN in
// gunbc.fleet.fleet_release_bins_key release_bins_unkeyed_environment_pattern) for exactly this
// reason. The prefixes differ per runner, so keying them would re-fragment the cache per checkout
// depth and defeat the repair's purpose; what makes that sound is not an assertion but the falsifier
// below, which goes red if any one prefix is dropped. The key step also runs in its own process
// before the build step, so the RUSTFLAGS exported here never reaches its `env -0` probe: the
// ambient value it keys is the toolchain step's, unchanged.
//
// AN EMPTY READ FAILS THE STEP, AND WHY THAT MATTERS MORE THAN IT LOOKS: `git rev-parse
// --show-toplevel` fails -- printing nothing -- when run OUTSIDE a work tree, which is the ordinary
// state of a checkout handed to a tool, a `git worktree add` mid-flight, or a runner that cloned into a
// path since unmounted. `--show-toplevel` fails where `--git-dir` would not, and it is the right probe
// because the remap must name the WORK tree: the work tree, not a bare git directory, is the prefix rustc
// bakes into those panic Location and file literals (measured 2026-10-25: a build whose checkout prefix
// was left unremapped carried `/tmp/rr2/g1/src/v1/stage0/src/cli_run/pre_entry_phase.rs` into .rodata). An
// unanchored remap would be worse than no remap at all: `--remap-path-prefix==/build/checkout` matches
// nothing, the absolute path stays fused into the binary, and the step still reports success -- a silently
// falsified receipt, which is the failure mode this whole preamble exists to close. Same reason the
// sysroot read is guarded: `rustc --print sysroot` on a shim that answers nothing would leave the
// toolchain half of the variance unaddressed while looking applied.
fn repo_self_build_env_preamble() -> String {
  let denial = repo_self_warning_denial_rustflags()
  join(
    [
      "GUNBC_SEED_CHECKOUT=$('git' 'rev-parse' '--show-toplevel')",
      "'[' -n \"$GUNBC_SEED_CHECKOUT\" ']' || ('echo' '::error title=seedBuildRemap CheckoutRootUnread::the checkout root read back empty, so a remap prefix would name nothing and the seed binary would keep absolute paths baked in; refusing to build'; exit 1)",
      "GUNBC_SEED_TARGET=${CARGO_TARGET_DIR:-$GUNBC_SEED_CHECKOUT'/target'}",
      "GUNBC_SEED_CARGO_HOME=${CARGO_HOME:-$HOME'/.cargo'}",
      "GUNBC_SEED_SYSROOT=$('rustc' '--print' 'sysroot')",
      "'[' -n \"$GUNBC_SEED_SYSROOT\" ']' || ('echo' '::error title=seedBuildRemap SysrootUnread::the rustc sysroot read back empty, so the sysroot remap would name nothing; refusing to build'; exit 1)",
      "RUSTFLAGS=\"" + denial + " --remap-path-prefix=$GUNBC_SEED_CHECKOUT=/build/checkout --remap-path-prefix=$GUNBC_SEED_TARGET=/build/target --remap-path-prefix=$GUNBC_SEED_CARGO_HOME=/build/cargo-home --remap-path-prefix=$GUNBC_SEED_SYSROOT=/build/rust\"",
      "export RUSTFLAGS",
      "if '[' -z \"${GUNBC_MATERIALIZED_TREE_IDENTITY:-}\" ']' && '[' -z \"$('git' 'status' '--porcelain=1' '--untracked-files=no')\" ']'; then",
      "GUNBC_SEED_OBJECT_FORMAT=$('git' 'rev-parse' '--show-object-format')",
      "'[' -n \"$GUNBC_SEED_OBJECT_FORMAT\" ']' || ('echo' '::error title=seedBuildIdentity ObjectFormatUnread::the git object format read back empty, so the pinned identity would be malformed; refusing to build'; exit 1)",
      "GUNBC_MATERIALIZED_TREE_IDENTITY='tree:'\"$GUNBC_SEED_OBJECT_FORMAT\"':'\"$('git' 'rev-parse' 'HEAD^{tree}')\"",
      "export GUNBC_MATERIALIZED_TREE_IDENTITY",
      "fi",
    ],
    "\n"
  )
}

// THE ONE WRAPPER FOR A SEED-BINARY BUILD COMMAND. A step's `run:` text is this preamble followed
// by the cargo line the repo_self_build_* authority owns; a step that spells a bare cargo line gets
// a runner-relative sha256 that looks like a commit hash, which is how the variance survived. The
// preamble goes FIRST so its refusal guards abort the step before cargo starts, and it is emitted
// per step rather than at job level only because the anchors are knowable inside a working
// directory, which is a step property. repo_self_build_env_preamble states what each prefix and
// guard is for; the census of seed-binary build steps and their producers is in
// gunbc.recurring_failure_mode.seed_sha256_is_runner_relative. Floor-wrapped build steps get the
// same treatment from gunbc.witness.witness_floor_workflow witness_floor_build_step, which puts the
// preamble OUTSIDE the receipt wrapper.
fn repo_self_seed_build_step_run(command: String) -> String {
  join([repo_self_build_env_preamble(), command, ""], "\n")
}

fn repo_self_build_packages_command(packages: List<String>) -> String {
  join(
    ["cargo build", repo_self_build_profile_flag]
      |> concat(packages |> map(p => join(["-p", p], " "))),
    " "
  )
}

fn repo_self_build_partition_crates_command() -> String {
  repo_self_build_packages_command(packages: repo_self_build_partition_crate_packages())
}

fn repo_self_build_command(bins: List<String>) -> String {
  if bins |> count == 0 {
    repo_self_build_package_command()
  } else {
    join([repo_self_build_package_command(), repo_self_build_bin_selector(bins: bins)], " ")
  }
}
