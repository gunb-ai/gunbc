module gunbc.node_http_server_emit

import std.types { HttpMethod, GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS }
import std.http_path { PathTemplate, LiteralToken, ParamToken }
import std.markup { MarkupNode }
import extdeps.uri_path {
  ParsedPathTemplate,
  MalformedPathTemplate,
  parse_path_template,
}
import extdeps.languages.html { EmitOk, EmitRejected, try_serialize_html_source }
import extdeps.http.server {
  HttpServerListenConfig,
  HttpServerRoute,
  HttpServerParameter,
  HttpStatusResponse,
  HttpRequestBodyKind,
  NoRequestBody,
  JsonRequestBody,
  PathInput,
  NodeHttpServerRouteBinding,
  NodeHttpRequestListener,
  ServedStaticRoute,
  ServedStaticRouteTable,
  ServedDynamicRoute,
  ServedDynamicRouteExec,
  LiteralArgvSegment,
  PathParamArgvSegment,
  HttpContentType,
  TextHtmlUtf8,
  ApplicationJsonUtf8,
  http_content_type_wire_label,
}
import gunbc.gunbhub_serve { gunbhub_served_static_route_table }
import gunbc.roadmap_page { roadmap_page_for_authority, roadmap_daily_workspace_page_for_authority }
import gunbc.roadmap_static_site { roadmap_site_text_static_routes }
import extdeps.languages.typescript.program {
  TsProgram,
  TsExpr,
  TsStmt,
  serialize_typescript_program,
  ts_ident,
  ts_lit_str,
  ts_lit_backtick,
  ts_lit_num,
  ts_lit_regex,
  ts_member,
  ts_call,
  ts_binop,
  ts_field,
  ts_quoted_field,
  ts_object,
  ts_array,
  ts_arrow,
  ts_block,
  ts_const,
  ts_expr_stmt,
  ts_return,
  ts_if,
  ts_for_of,
  ts_index,
  ts_cond,
  ts_prefix,
  ts_spread,
}

type NodeHttpServerSpec {
  service_name: String
  static_routes: ServedStaticRouteTable
  dynamic_routes: List<ServedDynamicRoute>
  listen: HttpServerListenConfig
}

fn emit_http_method_label(method: HttpMethod) -> String {
  match method {
    GET => "GET"
    POST => "POST"
    PUT => "PUT"
    PATCH => "PATCH"
    DELETE => "DELETE"
    HEAD => "HEAD"
    OPTIONS => "OPTIONS"
  }
}

fn js_regex_escape_literal(s: String) -> String {
  let s1 = join(split(s: s, delimiter: "\\"), "\\\\")
  let s2 = join(split(s: s1, delimiter: "."), "\\.")
  let s3 = join(split(s: s2, delimiter: "+"), "\\+")
  let s4 = join(split(s: s3, delimiter: "?"), "\\?")
  let s5 = join(split(s: s4, delimiter: "*"), "\\*")
  let s6 = join(split(s: s5, delimiter: "("), "\\(")
  let s7 = join(split(s: s6, delimiter: ")"), "\\)")
  let s8 = join(split(s: s7, delimiter: "^"), "\\^")
  let s9 = join(split(s: s8, delimiter: "$"), "\\$")
  let s10 = join(split(s: s9, delimiter: "["), "\\[")
  let s11 = join(split(s: s10, delimiter: "]"), "\\]")
  let s12 = join(split(s: s11, delimiter: "\{"), "\\\{")
  let s13 = join(split(s: s12, delimiter: "\}"), "\\\}")
  let s14 = join(split(s: s13, delimiter: "|"), "\\|")
  s14
}

fn emit_path_template_regex_source(template: PathTemplate) -> String {
  let segs = map(xs: template.tokens, f: tok =>
    match tok {
      LiteralToken { text: t } => js_regex_escape_literal(s: t)
      ParamToken { name: _ } => "[^\\/]+"
    }
  )
  if count(xs: segs) == 0 {
    "^\\/$"
  } else {
    concat("^\\/", concat(join(segs, "\\/"), "$"))
  }
}

fn emit_static_route_expr(route: ServedStaticRoute) -> TsExpr {
  let method = emit_http_method_label(method: route.method)
  let re = emit_path_template_regex_source(template: route.path_pattern)
  let ct = http_content_type_wire_label(content_type: route.content_type)
  ts_object([
    ts_field(key: "method", value: ts_lit_str(value: method)),
    ts_field(key: "pathRe", value: ts_lit_regex(source: re)),
    ts_field(key: "body", value: ts_lit_backtick(value: route.body)),
    ts_field(key: "contentType", value: ts_lit_str(value: ct)),
    ts_field(key: "status", value: ts_lit_num(text: to_string(route.status_on_hit))),
  ])
}

fn emit_static_route_exprs(routes: List<ServedStaticRoute>) -> List<TsExpr> {
  map(xs: routes, f: r => emit_static_route_expr(route: r))
}

fn path_template_param_names(template: PathTemplate) -> List<String> {
  fold(
    xs: template.tokens,
    init: [],
    f: (acc, tok) =>
      match tok {
        ParamToken { name: n } => concat(acc, [n])
        LiteralToken { text: _ } => acc
      }
  )
}

fn emit_path_template_regex_capture_source(template: PathTemplate) -> String {
  let segs = map(xs: template.tokens, f: tok =>
    match tok {
      LiteralToken { text: t } => js_regex_escape_literal(s: t)
      ParamToken { name: _ } => "([^\\/]+)"
    }
  )
  if count(xs: segs) == 0 {
    "^\\/$"
  } else {
    concat("^\\/", concat(join(segs, "\\/"), "$"))
  }
}

fn emit_argv_segment_expr(seg: ServedDynamicRouteArgvSegment) -> TsExpr {
  match seg {
    LiteralArgvSegment { text: t } =>
      ts_object([
        ts_field(key: "kind", value: ts_lit_str(value: "literal")),
        ts_field(key: "text", value: ts_lit_str(value: t)),
      ])
    PathParamArgvSegment { param_name: n } =>
      ts_object([
        ts_field(key: "kind", value: ts_lit_str(value: "param")),
        ts_field(key: "name", value: ts_lit_str(value: n)),
      ])
  }
}

fn emit_argv_segment_exprs(segments: List<ServedDynamicRouteArgvSegment>) -> List<TsExpr> {
  map(xs: segments, f: s => emit_argv_segment_expr(seg: s))
}

fn emit_dynamic_route_expr(route: ServedDynamicRoute) -> TsExpr {
  let binding = route.binding
  let method = emit_http_method_label(method: binding.route.method)
  let re = emit_path_template_regex_capture_source(template: binding.route.path_template)
  let param_names = path_template_param_names(template: binding.route.path_template)
  ts_object([
    ts_field(key: "method", value: ts_lit_str(value: method)),
    ts_field(key: "pathRe", value: ts_lit_regex(source: re)),
    ts_field(key: "paramNames", value: ts_array(elements: map(xs: param_names, f: n => ts_lit_str(value: n)))),
    ts_field(key: "command", value: ts_lit_str(value: route.exec.command)),
    ts_field(key: "argvSegments", value: ts_array(elements: emit_argv_segment_exprs(segments: route.exec.argv))),
    ts_field(key: "status", value: ts_lit_num(text: to_string(route.success_status))),
    ts_field(key: "handlerName", value: ts_lit_str(value: binding.listener.handler_name)),
  ])
}

fn emit_dynamic_route_exprs(routes: List<ServedDynamicRoute>) -> List<TsExpr> {
  map(xs: routes, f: r => emit_dynamic_route_expr(route: r))
}

fn req_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "req"), property: name)
}

fn res_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "res"), property: name)
}

fn route_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "route"), property: name)
}

fn process_env(key: String) -> TsExpr {
  ts_index(
    object: ts_member(object: ts_ident(name: "process"), property: "env"),
    index: ts_lit_str(value: key)
  )
}

fn node_http_match_handler_body() -> TsStmt {
  ts_block(stmts: [
    ts_expr_stmt(expr: ts_call(
      callee: res_member(name: "writeHead"),
      args: [
        route_member(name: "status"),
        ts_object(fields: [
          ts_quoted_field(key: "Content-Type", value: route_member(name: "contentType")),
        ]),
      ]
    )),
    ts_expr_stmt(expr: ts_call(callee: res_member(name: "end"), args: [route_member(name: "body")])),
    ts_return(expr: none),
  ])
}

fn node_http_handle_dynamic_route_const() -> TsStmt {
  ts_const(
    name: "handleDynamicRoute",
    value: ts_arrow(
      params: ["req", "res", "route", "path", "method"],
      body: ts_block(stmts: [
        ts_if(
          cond: ts_binop(
            left: ts_member(object: ts_ident(name: "route"), property: "method"),
            op: "!==",
            right: ts_ident(name: "method")
          ),
          then: ts_block(stmts: [ts_return(expr: ts_ident(name: "false"))]),
          else_stmt: none
        ),
        ts_const(
          name: "m",
          value: ts_call(
            callee: ts_member(
              object: ts_member(object: ts_ident(name: "route"), property: "pathRe"),
              property: "exec"
            ),
            args: [ts_ident(name: "path")]
          )
        ),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_ident(name: "m")),
          then: ts_block(stmts: [ts_return(expr: ts_ident(name: "false"))]),
          else_stmt: none
        ),
        ts_const(name: "params", value: ts_object(fields: [])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(
            object: ts_member(object: ts_ident(name: "route"), property: "paramNames"),
            property: "forEach"
          ),
          args: [
            ts_arrow(
              params: ["name", "i"],
              body: ts_block(stmts: [
                ts_expr_stmt(expr: ts_binop(
                  left: ts_index(object: ts_ident(name: "params"), index: ts_ident(name: "name")),
                  op: "=",
                  right: ts_index(
                    object: ts_ident(name: "m"),
                    index: ts_binop(
                      left: ts_ident(name: "i"),
                      op: "+",
                      right: ts_lit_num(text: "1")
                    )
                  )
                )),
              ])
            ),
          ]
        )),
        ts_const(
          name: "argv",
          value: ts_call(
            callee: ts_member(
              object: ts_member(object: ts_ident(name: "route"), property: "argvSegments"),
              property: "map"
            ),
            args: [
              ts_arrow(
                params: ["seg"],
                body: ts_expr_stmt(expr: ts_cond(
                  test: ts_binop(
                    left: ts_member(object: ts_ident(name: "seg"), property: "kind"),
                    op: "===",
                    right: ts_lit_str(value: "literal")
                  ),
                  consequent: ts_member(object: ts_ident(name: "seg"), property: "text"),
                  alternate: ts_index(
                    object: ts_ident(name: "params"),
                    index: ts_member(object: ts_ident(name: "seg"), property: "name")
                  )
                ))
              ),
            ]
          )
        ),
        ts_expr_stmt(expr: ts_call(
          callee: ts_ident(name: "execFile"),
          args: [
            ts_member(object: ts_ident(name: "route"), property: "command"),
            ts_ident(name: "argv"),
            ts_arrow(
              params: ["err", "stdout", "stderr"],
              body: ts_block(stmts: [
                ts_const(
                  name: "payload",
                  value: ts_object(fields: [
                    ts_field(
                      key: "ok",
                      value: ts_prefix(op: "!", expr: ts_ident(name: "err"))
                    ),
                    ts_field(key: "stdout", value: ts_ident(name: "stdout")),
                    ts_field(key: "stderr", value: ts_ident(name: "stderr")),
                    ts_field(
                      key: "code",
                      value: ts_cond(
                        test: ts_binop(
                          left: ts_ident(name: "err"),
                          op: "&&",
                          right: ts_binop(
                            left: ts_member(object: ts_ident(name: "err"), property: "code"),
                            op: "!=",
                            right: ts_ident(name: "null")
                          )
                        ),
                        consequent: ts_member(object: ts_ident(name: "err"), property: "code"),
                        alternate: ts_lit_num(text: "0")
                      )
                    ),
                  ])
                ),
                ts_expr_stmt(expr: ts_call(
                  callee: res_member(name: "writeHead"),
                  args: [
                    ts_member(object: ts_ident(name: "route"), property: "status"),
                    ts_object(fields: [
                      ts_quoted_field(
                        key: "Content-Type",
                        value: ts_lit_str(value: "application/json; charset=utf-8")
                      ),
                    ]),
                  ]
                )),
                ts_expr_stmt(expr: ts_call(
                  callee: res_member(name: "end"),
                  args: [
                    ts_call(
                      callee: ts_member(object: ts_ident(name: "JSON"), property: "stringify"),
                      args: [ts_ident(name: "payload")]
                    ),
                  ]
                )),
              ])
            ),
          ]
        )),
        ts_return(expr: ts_ident(name: "true")),
      ])
    )
  )
}

fn node_http_request_handler_block() -> TsStmt {
  ts_block(stmts: [
    ts_const(
      name: "method",
      value: ts_binop(left: req_member(name: "method"), op: "||", right: ts_lit_str(value: "GET"))
    ),
    ts_const(
      name: "rawUrl",
      value: ts_binop(left: req_member(name: "url"), op: "||", right: ts_lit_str(value: "/"))
    ),
    ts_const(
      name: "path",
      value: ts_binop(
        left: ts_index(
          object: ts_call(
            callee: ts_member(object: ts_ident(name: "rawUrl"), property: "split"),
            args: [ts_lit_str(value: "?")]
          ),
          index: ts_lit_num(text: "0")
        ),
        op: "||",
        right: ts_lit_str(value: "/")
      )
    ),
    ts_for_of(
      var_name: "route",
      iterable: ts_ident(name: "dynamicRoutes"),
      body: ts_if(
        cond: ts_call(
          callee: ts_ident(name: "handleDynamicRoute"),
          args: [
            ts_ident(name: "req"),
            ts_ident(name: "res"),
            ts_ident(name: "route"),
            ts_ident(name: "path"),
            ts_ident(name: "method"),
          ]
        ),
        then: ts_block(stmts: [ts_return(expr: none)]),
        else_stmt: none
      )
    ),
    ts_for_of(
      var_name: "route",
      iterable: ts_ident(name: "routes"),
      body: ts_if(
        cond: ts_binop(
          left: ts_binop(
            left: route_member(name: "method"),
            op: "===",
            right: ts_ident(name: "method")
          ),
          op: "&&",
          right: ts_call(
            callee: ts_member(object: route_member(name: "pathRe"), property: "test"),
            args: [ts_ident(name: "path")]
          )
        ),
        then: node_http_match_handler_body(),
        else_stmt: none
      )
    ),
    ts_const(
      name: "pathRoutes",
      value: ts_call(
        callee: ts_member(
          object: ts_array(elements: [
            ts_spread(expr: ts_ident(name: "dynamicRoutes")),
            ts_spread(expr: ts_ident(name: "routes")),
          ]),
          property: "filter"
        ),
        args: [
          ts_arrow(
            params: ["r"],
            body: ts_expr_stmt(expr: ts_call(
              callee: ts_member(
                object: ts_member(object: ts_ident(name: "r"), property: "pathRe"),
                property: "test"
              ),
              args: [ts_ident(name: "path")]
            ))
          ),
        ]
      )
    ),
    ts_if(
      cond: ts_binop(
        left: ts_member(object: ts_ident(name: "pathRoutes"), property: "length"),
        op: ">",
        right: ts_lit_num(text: "0")
      ),
      then: ts_block(stmts: [
        ts_const(
          name: "allow",
          value: ts_call(
            callee: ts_member(
              object: ts_array(elements: [
                ts_spread(expr: ts_prefix(
                  op: "new ",
                  expr: ts_call(
                    callee: ts_ident(name: "Set"),
                    args: [
                      ts_call(
                        callee: ts_member(object: ts_ident(name: "pathRoutes"), property: "map"),
                        args: [
                          ts_arrow(
                            params: ["r"],
                            body: ts_expr_stmt(expr: ts_member(object: ts_ident(name: "r"), property: "method"))
                          ),
                        ]
                      ),
                    ]
                  )
                )),
              ]),
              property: "join"
            ),
            args: [ts_lit_str(value: ", ")]
          )
        ),
        ts_expr_stmt(expr: ts_call(
          callee: res_member(name: "writeHead"),
          args: [
            ts_lit_num(text: "405"),
            ts_object(fields: [ts_field(key: "Allow", value: ts_ident(name: "allow"))]),
          ]
        )),
        ts_expr_stmt(expr: ts_call(
          callee: res_member(name: "end"),
          args: [ts_lit_str(value: "Method Not Allowed")]
        )),
        ts_return(expr: none),
      ]),
      else_stmt: none
    ),
    ts_expr_stmt(expr: ts_call(callee: res_member(name: "writeHead"), args: [ts_lit_num(text: "404")])),
    ts_expr_stmt(expr: ts_call(callee: res_member(name: "end"), args: [ts_lit_str(value: "Not Found")])),
  ])
}

fn node_http_create_server_stmt() -> TsStmt {
  ts_const(
    name: "server",
    value: ts_call(
      callee: ts_member(
        object: ts_call(callee: ts_ident(name: "require"), args: [ts_lit_str(value: "http")]),
        property: "createServer"
      ),
      args: [ts_arrow(params: ["req", "res"], body: node_http_request_handler_block())]
    )
  )
}

fn node_http_port_const(port: String) -> TsStmt {
  ts_const(
    name: "PORT",
    value: ts_cond(
      test: process_env(key: "PORT"),
      consequent: ts_call(
        callee: ts_ident(name: "parseInt"),
        args: [process_env(key: "PORT"), ts_lit_num(text: "10")]
      ),
      alternate: ts_lit_num(text: port)
    )
  )
}

fn node_http_host_const(host: String) -> TsStmt {
  ts_const(
    name: "HOST",
    value: ts_binop(left: process_env(key: "HOST"), op: "||", right: ts_lit_str(value: host))
  )
}

fn node_http_listen_stmt() -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: ts_ident(name: "server"), property: "listen"),
    args: [
      ts_ident(name: "PORT"),
      ts_ident(name: "HOST"),
      ts_arrow(
        params: [],
        body: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(
              object: ts_member(object: ts_ident(name: "process"), property: "stdout"),
              property: "write"
            ),
            args: [ts_lit_str(value: "listening\\n")]
          )),
        ])
      ),
    ]
  ))
}

fn node_http_exec_file_require_stmt() -> TsStmt {
  ts_const(
    name: "execFile",
    value: ts_member(
      object: ts_call(callee: ts_ident(name: "require"), args: [ts_lit_str(value: "child_process")]),
      property: "execFile"
    )
  )
}

fn emit_node_http_server_program(spec: NodeHttpServerSpec) -> TsProgram {
  let port = to_string(spec.listen.port)
  TsProgram {
    ts_nocheck: true,
    header_lines: [
      "GENERATED by gunbc from dag/gunbc/node_http_server_emit.dag",
    ],
    statements: [
      node_http_exec_file_require_stmt(),
      ts_const(
        name: "dynamicRoutes",
        value: ts_array(elements: emit_dynamic_route_exprs(routes: spec.dynamic_routes))
      ),
      ts_const(
        name: "routes",
        value: ts_array(elements: emit_static_route_exprs(routes: spec.static_routes.routes))
      ),
      node_http_handle_dynamic_route_const(),
      node_http_create_server_stmt(),
      node_http_port_const(port: port),
      node_http_host_const(host: spec.listen.host),
      node_http_listen_stmt(),
    ],
  }
}

fn gunbhub_node_http_server_spec() -> NodeHttpServerSpec {
  NodeHttpServerSpec {
    service_name: "gunbhub",
    static_routes: gunbhub_served_static_route_table(),
    dynamic_routes: [],
    listen: HttpServerListenConfig {
      host: "0.0.0.0",
      port: 8080,
    },
  }
}

fn gunbhub_node_http_server_source() -> String {
  serialize_typescript_program(p: emit_node_http_server_program(spec: gunbhub_node_http_server_spec()))
}

fn roadmap_dashboard_root_path_template() -> PathTemplate {
  match parse_path_template(raw: "/") {
    ParsedPathTemplate { template: t } => t
    MalformedPathTemplate { raw: _, segment: _, reason: _ } =>
      PathTemplate { tokens: [] }
  }
}

fn roadmap_dashboard_roadmap_path_template() -> PathTemplate {
  match parse_path_template(raw: "/roadmap") {
    ParsedPathTemplate { template: t } => t
    MalformedPathTemplate { raw: _, segment: _, reason: _ } =>
      PathTemplate { tokens: [LiteralToken { text: "roadmap" }] }
  }
}

fn roadmap_served_static_route(path: PathTemplate, page: MarkupNode) -> List<ServedStaticRoute> {
  match try_serialize_html_source(node: page) {
    EmitOk { html: h } =>
      [
        ServedStaticRoute {
          method: GET,
          path_pattern: path,
          body: h,
          content_type: TextHtmlUtf8,
          status_on_hit: 200,
        },
      ]
    EmitRejected { reason: _ } => []
  }
}

fn roadmap_dashboard_served_static_route_table() -> ServedStaticRouteTable {
  let daily = roadmap_served_static_route(
    path: roadmap_dashboard_root_path_template(),
    page: roadmap_daily_workspace_page_for_authority(),
  )
  let full = roadmap_served_static_route(
    path: roadmap_dashboard_roadmap_path_template(),
    page: roadmap_page_for_authority(),
  )
  ServedStaticRouteTable {
    routes: concat(
      concat(roadmap_site_text_static_routes(), daily),
      full
    )
  }
}

fn roadmap_dashboard_node_http_server_spec() -> NodeHttpServerSpec {
  NodeHttpServerSpec {
    service_name: "gunbc-roadmap",
    static_routes: roadmap_dashboard_served_static_route_table(),
    dynamic_routes: [],
    listen: HttpServerListenConfig {
      host: "0.0.0.0",
      port: 8080,
    },
  }
}

fn roadmap_dashboard_node_http_server_source() -> String {
  serialize_typescript_program(p: emit_node_http_server_program(spec: roadmap_dashboard_node_http_server_spec()))
}

fn toy_dynamic_route_path_template() -> PathTemplate {
  match parse_path_template(raw: "/toy/:msg") {
    ParsedPathTemplate { template: t } => t
    MalformedPathTemplate { raw: _, segment: _, reason: _ } =>
      PathTemplate { tokens: [LiteralToken { text: "toy" }, ParamToken { name: "msg" }] }
  }
}

fn toy_dynamic_echo_route() -> ServedDynamicRoute {
  ServedDynamicRoute {
    binding: NodeHttpServerRouteBinding {
      route: HttpServerRoute {
        operation_name: "toyEcho",
        method: POST,
        path_template: toy_dynamic_route_path_template(),
        request_body: NoRequestBody,
        parameters: [
          HttpServerParameter { name: "msg", location: PathInput, required: true },
        ],
        responses: [
          HttpStatusResponse { status: 200, body_kind: JsonRequestBody },
        ],
      },
      listener: NodeHttpRequestListener { handler_name: "toy_echo" },
    },
    exec: ServedDynamicRouteExec {
      command: "/bin/echo",
      argv: [PathParamArgvSegment { param_name: "msg" }],
    },
    success_status: 200,
  }
}

fn toy_dynamic_route_node_http_server_spec() -> NodeHttpServerSpec {
  NodeHttpServerSpec {
    service_name: "toy-dynamic-route",
    static_routes: ServedStaticRouteTable { routes: [] },
    dynamic_routes: [toy_dynamic_echo_route()],
    listen: HttpServerListenConfig {
      host: "127.0.0.1",
      port: 18472,
    },
  }
}

fn toy_dynamic_route_node_http_server_source() -> String {
  serialize_typescript_program(p: emit_node_http_server_program(spec: toy_dynamic_route_node_http_server_spec()))
}

