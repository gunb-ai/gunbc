module gunbc.node_http_server_emit


data node_http_server_emit_disposition_note: String = "DISPOSITION (P5, UI-model migration): the belt-A ROADMAP dashboard emit is DELETED. Belt B (gunbc serve / gunbc.roadmap_serve) retired it from deploy membership (live_deploy_spec_belt_b_note: the service is `gunbc serve`, not an emitted server.js) and this PR proved the belt-B path end-to-end by execution (GET / , /roadmap, /sandbox render; POST /dispatch and /sandbox/echo answer in-process). Gone with it: the belt-A smuggled-exec dispatch route (BeltDispatchRouteConfig + the execFile-gunbc handler — the very env-var-channel shell-out belt B dissolves to an in-process call), the roadmap static route table, and every roadmap_dashboard_* emitter. This module SURVIVES only for the gunbhub static-server emit (gunbhub_node_http_server_source, the sole live consumer via dag/tools/emit_host_transport.dag) — a static server with no dispatch. Its own dissolution trigger is gunbhub's migration to belt B (gunbc serve), the named follow-on (OUT OF SCOPE here: gunbhub_serve). Not a silent zombie: the roadmap emit is removed, not merely marked, and the remaining consumer is named."

type NodeHttpStaticServerSpec {
  service_name: String
  routes: extdeps.http.server.ServedStaticRouteTable
  listen: extdeps.http.server.HttpServerListenConfig
}

fn emit_http_method_label(method: std.types.HttpMethod) -> String {
  match method {
    std.types.GET => "GET"
    std.types.POST => "POST"
    std.types.PUT => "PUT"
    std.types.PATCH => "PATCH"
    std.types.DELETE => "DELETE"
    std.types.HEAD => "HEAD"
    std.types.OPTIONS => "OPTIONS"
  }
}

fn js_regex_escape_literal(s: String) -> String {
  let s1 = join(split(s: s, delimiter: "\\"), "\\\\")
  let s2 = join(split(s: s1, delimiter: "."), "\\.")
  let s3 = join(split(s: s2, delimiter: "+"), "\\+")
  let s4 = join(split(s: s3, delimiter: "?"), "\\?")
  let s5 = join(split(s: s4, delimiter: "*"), "\\*")
  let s6 = join(split(s: s5, delimiter: "("), "\\(")
  let s7 = join(split(s: s6, delimiter: ")"), "\\)")
  let s8 = join(split(s: s7, delimiter: "^"), "\\^")
  let s9 = join(split(s: s8, delimiter: "$"), "\\$")
  let s10 = join(split(s: s9, delimiter: "["), "\\[")
  let s11 = join(split(s: s10, delimiter: "]"), "\\]")
  let s12 = join(split(s: s11, delimiter: "\{"), "\\\{")
  let s13 = join(split(s: s12, delimiter: "\}"), "\\\}")
  let s14 = join(split(s: s13, delimiter: "|"), "\\|")
  s14
}

fn emit_path_template_regex_source(template: std.http_path.PathTemplate) -> String {
  let segs = map(xs: template.tokens, f: tok =>
    match tok {
      std.http_path.LiteralToken { text: t } => js_regex_escape_literal(s: t)
      std.http_path.ParamToken { name: _ } => "[^\\/]+"
    }
  )
  if count(xs: segs) == 0 {
    "^\\/$"
  } else {
    concat("^\\/", concat(join(segs, "\\/"), "$"))
  }
}

fn emit_static_route_expr(route: extdeps.http.server.ServedStaticRoute) -> extdeps.languages.typescript.program.TsExpr {
  let method = emit_http_method_label(method: route.method)
  let re = emit_path_template_regex_source(template: route.path_pattern)
  let ct = extdeps.http.server.media_type_wire_label(m: route.content_type)
  extdeps.languages.typescript.program.ts_object([
    extdeps.languages.typescript.program.ts_field(key: "method", value: extdeps.languages.typescript.program.ts_lit_str(value: method)),
    extdeps.languages.typescript.program.ts_field(key: "pathRe", value: extdeps.languages.typescript.program.ts_lit_regex(source: re)),
    extdeps.languages.typescript.program.ts_field(key: "body", value: extdeps.languages.typescript.program.ts_lit_backtick(value: route.body)),
    extdeps.languages.typescript.program.ts_field(key: "contentType", value: extdeps.languages.typescript.program.ts_lit_str(value: ct)),
    extdeps.languages.typescript.program.ts_field(key: "status", value: extdeps.languages.typescript.program.ts_lit_num(text: to_string(route.status_on_hit))),
  ])
}

fn emit_static_route_exprs(routes: List<extdeps.http.server.ServedStaticRoute>) -> List<extdeps.languages.typescript.program.TsExpr> {
  map(xs: routes, f: r => emit_static_route_expr(route: r))
}

fn req_member(name: String) -> extdeps.languages.typescript.program.TsExpr {
  extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "req"), property: name)
}

fn res_member(name: String) -> extdeps.languages.typescript.program.TsExpr {
  extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "res"), property: name)
}

fn route_member(name: String) -> extdeps.languages.typescript.program.TsExpr {
  extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "route"), property: name)
}

fn process_env(key: String) -> extdeps.languages.typescript.program.TsExpr {
  extdeps.languages.typescript.program.ts_index(
    object: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "process"), property: "env"),
    index: extdeps.languages.typescript.program.ts_lit_str(value: key)
  )
}

fn node_http_match_handler_body() -> extdeps.languages.typescript.program.TsStmt {
  extdeps.languages.typescript.program.ts_block(stmts: [
    extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
      callee: res_member(name: "writeHead"),
      args: [
        route_member(name: "status"),
        extdeps.languages.typescript.program.ts_object(fields: [
          extdeps.languages.typescript.program.ts_quoted_field(key: "Content-Type", value: route_member(name: "contentType")),
        ]),
      ]
    )),
    extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(callee: res_member(name: "end"), args: [route_member(name: "body")])),
    extdeps.languages.typescript.program.ts_return(expr: none),
  ])
}

fn node_http_request_handler_block() -> extdeps.languages.typescript.program.TsStmt {
  extdeps.languages.typescript.program.ts_block(stmts: concat([
    extdeps.languages.typescript.program.ts_const(
      name: "method",
      value: extdeps.languages.typescript.program.ts_binop(left: req_member(name: "method"), op: "||", right: extdeps.languages.typescript.program.ts_lit_str(value: "GET"))
    ),
    extdeps.languages.typescript.program.ts_const(
      name: "rawUrl",
      value: extdeps.languages.typescript.program.ts_binop(left: req_member(name: "url"), op: "||", right: extdeps.languages.typescript.program.ts_lit_str(value: "/"))
    ),
    extdeps.languages.typescript.program.ts_const(
      name: "path",
      value: extdeps.languages.typescript.program.ts_binop(
        left: extdeps.languages.typescript.program.ts_index(
          object: extdeps.languages.typescript.program.ts_call(
            callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "rawUrl"), property: "split"),
            args: [extdeps.languages.typescript.program.ts_lit_str(value: "?")]
          ),
          index: extdeps.languages.typescript.program.ts_lit_num(text: "0")
        ),
        op: "||",
        right: extdeps.languages.typescript.program.ts_lit_str(value: "/")
      )
    ),
  ], [
    extdeps.languages.typescript.program.ts_for_of(
      var_name: "route",
      iterable: extdeps.languages.typescript.program.ts_ident(name: "routes"),
      body: extdeps.languages.typescript.program.ts_if(
        cond: extdeps.languages.typescript.program.ts_binop(
          left: extdeps.languages.typescript.program.ts_binop(
            left: route_member(name: "method"),
            op: "===",
            right: extdeps.languages.typescript.program.ts_ident(name: "method")
          ),
          op: "&&",
          right: extdeps.languages.typescript.program.ts_call(
            callee: extdeps.languages.typescript.program.ts_member(object: route_member(name: "pathRe"), property: "test"),
            args: [extdeps.languages.typescript.program.ts_ident(name: "path")]
          )
        ),
        then: node_http_match_handler_body(),
        else_stmt: none
      )
    ),
    extdeps.languages.typescript.program.ts_const(
      name: "pathRoutes",
      value: extdeps.languages.typescript.program.ts_call(
        callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "routes"), property: "filter"),
        args: [
          extdeps.languages.typescript.program.ts_arrow(
            params: ["r"],
            body: extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
              callee: extdeps.languages.typescript.program.ts_member(
                object: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "r"), property: "pathRe"),
                property: "test"
              ),
              args: [extdeps.languages.typescript.program.ts_ident(name: "path")]
            ))
          ),
        ]
      )
    ),
    extdeps.languages.typescript.program.ts_if(
      cond: extdeps.languages.typescript.program.ts_binop(
        left: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "pathRoutes"), property: "length"),
        op: ">",
        right: extdeps.languages.typescript.program.ts_lit_num(text: "0")
      ),
      then: extdeps.languages.typescript.program.ts_block(stmts: [
        extdeps.languages.typescript.program.ts_const(
          name: "allow",
          value: extdeps.languages.typescript.program.ts_call(
            callee: extdeps.languages.typescript.program.ts_member(
              object: extdeps.languages.typescript.program.ts_array(elements: [
                extdeps.languages.typescript.program.ts_spread(expr: extdeps.languages.typescript.program.ts_prefix(
                  op: "new ",
                  expr: extdeps.languages.typescript.program.ts_call(
                    callee: extdeps.languages.typescript.program.ts_ident(name: "Set"),
                    args: [
                      extdeps.languages.typescript.program.ts_call(
                        callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "pathRoutes"), property: "map"),
                        args: [
                          extdeps.languages.typescript.program.ts_arrow(
                            params: ["r"],
                            body: extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "r"), property: "method"))
                          ),
                        ]
                      ),
                    ]
                  )
                )),
              ]),
              property: "join"
            ),
            args: [extdeps.languages.typescript.program.ts_lit_str(value: ", ")]
          )
        ),
        extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
          callee: res_member(name: "writeHead"),
          args: [
            extdeps.languages.typescript.program.ts_lit_num(text: "405"),
            extdeps.languages.typescript.program.ts_object(fields: [extdeps.languages.typescript.program.ts_field(key: "Allow", value: extdeps.languages.typescript.program.ts_ident(name: "allow"))]),
          ]
        )),
        extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
          callee: res_member(name: "end"),
          args: [extdeps.languages.typescript.program.ts_lit_str(value: "Method Not Allowed")]
        )),
        extdeps.languages.typescript.program.ts_return(expr: none),
      ]),
      else_stmt: none
    ),
    extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(callee: res_member(name: "writeHead"), args: [extdeps.languages.typescript.program.ts_lit_num(text: "404")])),
    extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(callee: res_member(name: "end"), args: [extdeps.languages.typescript.program.ts_lit_str(value: "Not Found")])),
  ]))
}

fn node_http_create_server_stmt() -> extdeps.languages.typescript.program.TsStmt {
  extdeps.languages.typescript.program.ts_const(
    name: "server",
    value: extdeps.languages.typescript.program.ts_call(
      callee: extdeps.languages.typescript.program.ts_member(
        object: extdeps.languages.typescript.program.ts_call(callee: extdeps.languages.typescript.program.ts_ident(name: "require"), args: [extdeps.languages.typescript.program.ts_lit_str(value: "http")]),
        property: "createServer"
      ),
      args: [extdeps.languages.typescript.program.ts_arrow(params: ["req", "res"], body: node_http_request_handler_block())]
    )
  )
}

fn node_http_port_const(port: String) -> extdeps.languages.typescript.program.TsStmt {
  extdeps.languages.typescript.program.ts_const(
    name: "PORT",
    value: extdeps.languages.typescript.program.ts_cond(
      test: process_env(key: "PORT"),
      consequent: extdeps.languages.typescript.program.ts_call(
        callee: extdeps.languages.typescript.program.ts_ident(name: "parseInt"),
        args: [process_env(key: "PORT"), extdeps.languages.typescript.program.ts_lit_num(text: "10")]
      ),
      alternate: extdeps.languages.typescript.program.ts_lit_num(text: port)
    )
  )
}

fn node_http_host_const(host: String) -> extdeps.languages.typescript.program.TsStmt {
  extdeps.languages.typescript.program.ts_const(
    name: "HOST",
    value: extdeps.languages.typescript.program.ts_binop(left: process_env(key: "HOST"), op: "||", right: extdeps.languages.typescript.program.ts_lit_str(value: host))
  )
}

fn node_http_listen_stmt() -> extdeps.languages.typescript.program.TsStmt {
  extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
    callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "server"), property: "listen"),
    args: [
      extdeps.languages.typescript.program.ts_ident(name: "PORT"),
      extdeps.languages.typescript.program.ts_ident(name: "HOST"),
      extdeps.languages.typescript.program.ts_arrow(
        params: [],
        body: extdeps.languages.typescript.program.ts_block(stmts: [
          extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
            callee: extdeps.languages.typescript.program.ts_member(
              object: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "process"), property: "stdout"),
              property: "write"
            ),
            args: [extdeps.languages.typescript.program.ts_lit_str(value: "listening\\n")]
          )),
        ])
      ),
    ]
  ))
}

fn emit_node_http_static_server_program(spec: NodeHttpStaticServerSpec) -> extdeps.languages.typescript.program.TsProgram {
  let port = to_string(spec.listen.port)
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: true,
    header_lines: [
      "GENERATED by gunbc from dag/gunbc/node_http_server_emit.dag",
    ],
    statements: [
      extdeps.languages.typescript.program.ts_const(
        name: "routes",
        value: extdeps.languages.typescript.program.ts_array(elements: emit_static_route_exprs(routes: spec.routes.routes))
      ),
      node_http_create_server_stmt(),
      node_http_port_const(port: port),
      node_http_host_const(host: spec.listen.host),
      node_http_listen_stmt(),
    ],
  }
}

fn gunbhub_node_http_static_server_spec() -> NodeHttpStaticServerSpec {
  NodeHttpStaticServerSpec {
    service_name: "gunbhub",
    routes: gunbc.gunbhub_serve.gunbhub_served_static_route_table(),
    listen: extdeps.http.server.HttpServerListenConfig {
      host: "0.0.0.0",
      port: 8080,
    },
  }
}

fn gunbhub_node_http_server_source() -> String {
  extdeps.languages.typescript.program.serialize_typescript_program(p: emit_node_http_static_server_program(spec: gunbhub_node_http_static_server_spec()))
}
