fn roadmap_active_identities() -> List<RoadmapIdentityRecord> {
  declared_roadmap_nodes() |> map(n => ActiveIdentity {
    identity: n.identity,
    slug: n.node,
  })
}

fn roadmap_identity_registry() -> List<RoadmapIdentityRecord> {
  concat(roadmap_active_identities(), roadmap_tombstoned_identities())
}

fn record_identity(r: RoadmapIdentityRecord) -> String {
  match r {
    ActiveIdentity { identity, slug: _ } => identity as String
    TombstonedIdentity { identity, former_slug: _, superseded_by: _ } => identity as String
  }
}

fn record_slug(r: RoadmapIdentityRecord) -> String {
  match r {
    ActiveIdentity { identity: _, slug } => slug as String
    TombstonedIdentity { identity: _, former_slug, superseded_by: _ } => former_slug as String
  }
}

fn record_is_active(r: RoadmapIdentityRecord) -> Bool {
  match r {
    ActiveIdentity { identity: _, slug: _ } => true
    TombstonedIdentity { identity: _, former_slug: _, superseded_by: _ } => false
  }
}

// Resolution is EXACTLY-ONE, not first-pick. A filter-map-first lookup answers a duplicate registry with a plausible first row, which is the fabricated-plausible-output arm DESIGN 5 forbids — and it fails at exactly the moment the registry is corrupt, when a confident wrong answer is worst. The three outcomes are distinct because their remedies are: a MISSING identity is an unknown reference; a DUPLICATE is a corrupt registry; found is found. Callers match the sum rather than unwrapping an Optional that cannot tell those apart.
type RoadmapIdentityResolution
  = IdentityResolved { identity: gunbc.roadmap_model.RoadmapNodeIdentity }
  | IdentityUnknown { slug: String }
  | IdentityAmbiguous { slug: String, matches: Int }

fn resolve_slug(slug: String) -> RoadmapIdentityResolution {
  let hits = roadmap_identity_registry() |> filter(r => record_slug(r: r) == slug)
  if count(hits) == 0 {
    IdentityUnknown { slug: slug }
  } else if count(hits) > 1 {
    IdentityAmbiguous { slug: slug, matches: count(hits) }
  } else {
    match hits |> map(r => record_identity(r: r)) |> first {
      Present { value: i } => IdentityResolved { identity: i as gunbc.roadmap_model.RoadmapNodeIdentity }
      Absent => IdentityUnknown { slug: slug }
    }
  }
}

fn identity_count() -> Int { count(roadmap_identity_registry()) }

fn distinct_count(values: List<String>) -> Int {
  count(fold(values, init: [], f: fn(acc, v) {
    if any(acc, e => e == v) { acc } else { append(acc, [v]) }
  }))
}

fn distinct_identity_count() -> Int {
  distinct_count(values: roadmap_identity_registry() |> map(r => record_identity(r: r)))
}

fn distinct_active_slug_count() -> Int {
  distinct_count(values: roadmap_active_identities() |> map(r => record_slug(r: r)))
}

fn active_identity_count() -> Int { count(roadmap_active_identities()) }

data roadmap_identity_permanence_gate_note: String = "WHAT A SNAPSHOT CAN AND CANNOT PROVE, stated so the gap is not mistaken for coverage. The claims below are statements about the CURRENT tree: identities unique across active and tombstoned rows, active slugs unique, every declared node carrying one, resolution exactly-one. None can see history, and permanence is historical — an identity silently REPLACED between base and head produces a tree satisfying every one of them.\\n\\nThe missing mechanism is a base-versus-head comparison of this registry, which the CI floor already has the shape for in its merge-base diff observation. ADMITTED: an active identity retained across a slug change; a new identity added; an active identity becoming Tombstoned. REFUSED: an active identity replaced by a different value for the same work; a tombstoned identity returning to active; an identity disappearing from the registry entirely rather than being tombstoned; two records sharing one identity; one active slug resolving to two identities.\\n\\nThe tombstone carrier above is what makes that gate implementable at all — reuse is only detectable because retirement persists. Until the gate runs, permanence rests on review, and this row keeps that fact countable rather than forgotten."
