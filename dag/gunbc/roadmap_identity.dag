fn identity_for_slug(slug: String) -> RoadmapNodeIdentity? {
  roadmap_identity_bindings()
    |> filter(b => (b.slug.value as String) == slug)
    |> map(b => b.identity)
    |> first
}

fn slug_for_identity(identity: String) -> RoadmapNodeSlug? {
  roadmap_identity_bindings()
    |> filter(b => (b.identity.value as String) == identity)
    |> map(b => b.slug)
    |> first
}

fn identity_count() -> Int { count(roadmap_identity_bindings()) }

fn distinct_identity_count() -> Int {
  count(fold(roadmap_identity_bindings(), init: [], f: fn(acc, b) {
    let v = b.identity.value as String
    if any(acc, e => e == v) { acc } else { append(acc, [v]) }
  }))
}

fn distinct_slug_count() -> Int {
  count(fold(roadmap_identity_bindings(), init: [], f: fn(acc, b) {
    let v = b.slug.value as String
    if any(acc, e => e == v) { acc } else { append(acc, [v]) }
  }))
}

data roadmap_identity_permanence_gate_owed: String = "OWED, NOT DONE — the mechanical check this stage cannot supply. Every claim in roadmap_identity_witness_test is a statement about the CURRENT tree: identities unique, slugs unique, binding total, resolution invertible. None of them can see history, and permanence is a historical property — an identity silently replaced between the base revision and a PR head produces a tree that satisfies every one of those claims. The snapshot corpus is structurally incapable of catching the exact edit this module exists to forbid, and saying so here is the difference between a declared gap and coverage by illusion.\n\nThe missing mechanism is a base-versus-head comparison of the identity registry, which the CI floor already has the shape for (the merge-base diff observation the affected-set selection reads). ADMITTED transitions: an identity retained; a new identity added; an identity explicitly tombstoned; a slug changed while its identity is unchanged; containment or dependency changed while identity is unchanged. REFUSED: an existing identity replaced; a retired identity reused; two nodes sharing one identity; one active slug resolving to two identities; a parent identity dropped rather than retained when it is decomposed.\n\nUntil that gate exists, permanence rests on review rather than construction, and this row is what keeps that fact countable instead of forgotten."

data roadmap_identity_decomposition_policy_owed: String = "OWED — decomposition needs an explicit completion policy, and containment alone does not supply one. Keeping a parent's identity when it is split is what stops receipts and dependency edges dangling, but it leaves a question containment cannot answer: is the parent complete when it is directly accepted, when all its contained children are accepted, or both. Inferring that from the containment relation would be a guess dressed as a derivation, and the wrong guess silently closes a parent whose children are unfinished — the exact goal-shrink failure the workflow model already refuses elsewhere.\n\nSo the safe decomposition sequence is: retain the parent identity; leave external dependencies and receipts pointed at it; mint identities for the children; add containment edges; state the parent's aggregate completion policy EXPLICITLY; and add child dependencies only where execution order genuinely requires them. The policy is a declared field, never an inference. This lands with explicit containment, which is a later stage than I0."
