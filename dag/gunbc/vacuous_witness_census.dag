data vacuous_census_queries: List<CensusQuery> = [
  CensusQuery {
    query_name: "corpus-wide shape scan -- every Bool declaration under dag and src/v2, regardless of module disposition or discovery",
    discovered_population: "all modules; no disposition filter",
    rows_reached: "every row in vacuous_witness_rows, including the two dormant ones and the unverified candidate"
  },
  CensusQuery {
    query_name: "recoverable-assertion screen -- modules under a discovery scan dir whose disposition is not SubstrateInputsOnly and none of whose test functions reaches a host effect",
    discovered_population: "399 modules, 3703 recoverable assertions",
    rows_reached: "ONE dormant row only: test.claim.occurrence_identity_witness. The tools.dag_compile_clean_shard_roster row is NOT reached, because its module sits outside the discovery scan dirs while its consumer declares ReadsLiveTree"
  }
]

data vacuous_detector_reach_limits: List<DetectorReachLimit> = [
  DetectorReachLimit { limit_name: "a conjunction of calls -- reached only as a fixpoint over already-confirmed conjuncts, so a conjunction of individually unscreened rows is invisible", direction: UnderDetects },
  DetectorReachLimit { limit_name: "a parameterised helper -- any tautology routed through a callee taking arguments is outside the detector entirely", direction: UnderDetects },
  DetectorReachLimit { limit_name: "a branching constructor -- treated as unscreened, because a field can differ per path and the comparison is then refutable", direction: UnderDetects },
  DetectorReachLimit { limit_name: "a call or field access on the compared side -- an earlier revision required a bare identifier and missed a whole conjunct of an executing test function", direction: UnderDetects },
  DetectorReachLimit { limit_name: "a call argument spelled like a record field initialiser -- the detector cannot distinguish the two syntaxes and admits the first as though it were the second", direction: OverDetects },
  DetectorReachLimit { limit_name: "a uniform true across match arms -- returns true wherever it returns, which is not cannot return false; withdrawn before publication", direction: OverDetects }
]
