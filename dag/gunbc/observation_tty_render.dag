module gunbc.observation_tty_render


data observation_tty_render_note: String = "P2 of the progress-and-observation lane: the interactive TTY renderer, a SIBLING projection of the same std.observation carriers the CI renderer projects — not a second model and not the CI renderer's successor. The two differ only where the medium differs. A terminal can be repainted, so routine progress overwrites one line in place and stays quiet; a CI log cannot, so it appends. Everything the two share — the event vocabulary, the density authority, the glyph table, the duration and byte and percent projections, the hold-cause text — is imported from the CI renderer or the model, never re-derived. That sharing is the proof that one event stream drives N renderers (DESIGN section 2); a TTY renderer that re-spelled ci_human_duration would be the fork this lane exists to avoid."

// The three upgrades over the reference implementation studied for this lane, all inherited from the model rather than re-earned here: outcome lines carry durations (ci_event_line already appends them), Refused is distinct from Failed (the outcome sum and the glyph authority keep them apart), and dwell escalation is recursive rather than one-level (observation_escalation_subject walks the whole tree). The reference has none of these; the TTY renderer gets them for free by projecting the same carriers.
type PreambleFields {
  run_id: std.types.NonEmptyStr
  trigger: std.types.NonEmptyStr
  diff_summary: std.types.NonEmptyStr
  entry_total: std.nat.Nat
}

data observation_tty_preamble_note: String = "The preamble is REQUIRED — no anonymous process. The reference implementation makes this a construction rule (a titled, described process or nothing), and it is kept: a TTY run opens with what is running, why it was triggered, and how much work it faces, so the first thing on screen answers the question the crawl window could not. The diff-to-runs selection summary is the centre of it (section 6b), but its declaration-grain form rides the namespace lane; this carrier holds the fields that exist today and grows without a format change when decl-grain selection lands."

fn tty_preamble_line(fields: PreambleFields) -> gunbc.observation_ci_render.RenderedLine {
  gunbc.observation_ci_render.RenderedLine {
    glyph: std.symbols.NodeRunning,
    text: concat(
      "run ", concat(fields.run_id,
      concat(" — ", concat(fields.trigger,
      concat(" — ", concat(fields.diff_summary,
      concat(" — ", concat(to_string(fields.entry_total), " entries to run")))))))
    ),
    attention: std.observation.Notable
  }
}

// Whether a line repaints in place or scrolls is DERIVED from its attention, one decision function, never chosen at the call site. Routine progress overwrites — the spinner and the current-entry counter update on one line so the terminal does not fill with green. An anomaly appends, because it must survive on screen and be scrollable back to; overwriting a refusal would erase it the instant the next line arrived, which is the terminal form of burying it in a collapsed group. The summary appends too — it is the last thing the reader wants to keep. This is the same law-4 asymmetry the CI renderer expresses through group placement, expressed here through cursor action, because that is what the medium offers.
fn tty_cursor_action(density: std.observation.ObservationDensity, attention: std.observation.AttentionLevel, cap: std.render.RenderCapability) -> std.render.CursorAction {
  match density {
    std.observation.SummaryAlwaysShown => std.render.Append
    std.observation.AnomalyExpanded => std.render.Append
    std.observation.RoutineCollapsible =>
      if cap.cursor_addressable {
        match attention {
          std.observation.Ambient => std.render.Overwrite
          std.observation.Notable => std.render.Append
          std.observation.Anomaly => std.render.Append
        }
      } else {
        std.render.Append
      }
  }
}

data observation_tty_group_note: String = "The live group line is a repainting projection of the currently-running subject: a spinner, the phase, and the k-of-n counter, overwritten each tick. It names the current entry the way the reference's group line does, and it carries the same identity-first discipline as the heartbeat — the spinner says alive, the text says what is alive."

fn tty_group_line(active: std.observation.ObservationSubject, k: std.nat.Nat, n: std.nat.Nat, spinner: std.symbols.SymbolId) -> gunbc.observation_ci_render.RenderedLine {
  let detail = gunbc.observation_ci_render.ci_subject_detail_text(subject: active)
  gunbc.observation_ci_render.RenderedLine {
    glyph: spinner,
    text: concat(
      gunbc.observation_ci_render.ci_subject_activity_text(subject: active),
      concat(" ", concat(to_string(k), concat(" of ", concat(to_string(n),
      if detail == "" { "" } else { concat(" — ", detail) }))))
    ),
    attention: std.observation.Ambient
  }
}

// BlockedOn renders INLINE on the TTY, with its holder and its remaining bound when the governor has one — the reference's contention feature, kept and upgraded to derived facts. A bounded remaining prints the time; an unknown remaining prints why it is unknown rather than a fabricated estimate, because a made-up ETA is the same fabrication the model forbids for any other measurement.
fn tty_remaining_text(remaining: std.observation.ContentionRemaining) -> String {
  match remaining {
    std.observation.RemainingBounded { by: b } => concat("about ", concat(gunbc.observation_ci_render.ci_human_duration(d: b), " remaining"))
    std.observation.RemainingUnknown { cause: c } => concat("no estimate (", concat(c, ")"))
  }
}

fn tty_blocked_line(blocked: std.observation.BlockedOn) -> gunbc.observation_ci_render.RenderedLine {
  let holders = concat(to_string(count(blocked.holders)), " holder(s)")
  gunbc.observation_ci_render.RenderedLine {
    glyph: std.symbols.StatusBlocked,
    text: concat(
      "blocked — ",
      concat(holders, concat(", ", tty_remaining_text(remaining: blocked.remaining)))
    ),
    attention: std.observation.Anomaly
  }
}

// The reward animal renders on Final — the reference's flourish, kept, and kept CORRECTLY: it is drawn from the reward-animal rows in the one glyph authority, selected deterministically by the run's identity, never a random draw. A random animal would make the event stream unreplayable, which would defeat the same replay the flagship depends on. On a non-emoji terminal the row's ascii form renders, so the flourish degrades to a word rather than a mojibake box.
fn tty_final_line(shown_failures: std.nat.Nat, run_index: Int, tier: std.symbols.Tier) -> gunbc.observation_ci_render.RenderedLine {
  let animal = match extdeps.render.glyphs.reward_animal_at(index: run_index, tier: tier) {
    Present { value: a } => a
    Absent => ""
  }
  gunbc.observation_ci_render.RenderedLine {
    glyph: std.symbols.StatusFinal,
    text: if shown_failures == 0 {
      concat("all clean ", animal)
    } else {
      concat(to_string(shown_failures), " problems shown above")
    },
    attention: if shown_failures == 0 { std.observation.Ambient } else { std.observation.Anomaly }
  }
}

// An event line on the TTY is the SAME projection the CI renderer produces — ci_event_line, imported, not re-implemented — paired with the cursor action its attention derives. The renderer differs from its CI sibling in HOW a line reaches the screen (overwrite vs append), never in WHAT the line says. That is the single-stream property made concrete: change the event and both surfaces move together, because both call the same projection.
type TtyEmission {
  line: gunbc.observation_ci_render.RenderedLine
  cursor: std.render.CursorAction
}

type TtyEmissionProjection
  = TtyEmissionProjected { emission: TtyEmission }
  | TtyEmissionRefused { cause: std.types.NonEmptyStr }

fn tty_emission_at_attention(
  event: std.observation.ObservationEvent,
  attention: std.observation.AttentionLevel,
  cap: std.render.RenderCapability
) -> TtyEmission {
  let density = std.observation.observation_class_density(c: std.observation.observation_event_class(event: event))
  let line = gunbc.observation_ci_render.ci_event_line_at_attention(event: event, attention: attention)
  TtyEmission {
    line: line,
    cursor: tty_cursor_action(density: density, attention: attention, cap: cap)
  }
}

fn tty_event_emission_under(event: std.observation.ObservationEvent, basis: std.observation.Measured<std.observation.AttentionBasis>, cap: std.render.RenderCapability) -> TtyEmissionProjection {
  match std.observation.observation_attention_under(event: event, basis: basis) {
    std.observation.AttentionRefused { cause: c } => TtyEmissionRefused { cause: c }
    std.observation.AttentionAssigned { level: attention } =>
      TtyEmissionProjected {
        emission: tty_emission_at_attention(event: event, attention: attention, cap: cap)
      }
  }
}

fn tty_event_emission(event: std.observation.ObservationEvent, basis: std.observation.AttentionBasis, cap: std.render.RenderCapability) -> TtyEmission {
  tty_emission_at_attention(
    event: event,
    attention: std.observation.observation_attention(event: event, basis: basis),
    cap: cap
  )
}

fn tty_render_emission(emission: TtyEmission, tier: std.symbols.Tier) -> String {
  gunbc.observation_ci_render.ci_render_line(line: emission.line, tier: tier)
}

data observation_tty_render_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "The TTY renderer is Terminal — an in-place-repaint projection is what an interactive terminal IS. It is a peer of the CI-log renderer and the later dashboard, all projecting one event stream; none is a scaffold for another. What dissolves is the hand-rolled TTY progress code the P3 census will enumerate, not this projection."
}
