// THE CODEX AND CURSOR OFFERS ARE JUDGED ON THE CREDENTIAL THE SPAWN BINDS, the way the Claude draw
// is (gunbc.roadmap.roadmap_dispatch_actuator claude_observed_standing_from_snapshot). Before this, both offers
// carried the declared inventory's unobserved standing, so creating the secrets and converging their
// custody could not change selection: a declared row admits no draw. Each observation here runs on
// the custody host against the custody credential and nothing ambient, so a login someone made by hand
// on the host cannot change the verdict. They run only on an operator's explicit executor request.

data codex_harness_standing_trip_fact_id: RecordedFactId = "codex-harness-standing-trip" as RecordedFactId

// THE CODEX STANDING TRIP is the existing app-server account trip (initialize, account/read,
// account/rateLimits/read; gunbc.codex_app_server_press codex_press_account_trip_invocation) with
// CODEX_HOME set to the custody directory and run under the same flock as a turn, because account/read may refresh the token and a refresh
// rotates it: a trip racing a turn would present one refresh token twice. A trip that finds the lock
// held reports the credential busy rather than a codex failure. Exhausted rate-limit buckets and a
// dead login reach selection through provider_standing_bundle_from_codex_account_evidence, the same
// projection the press receipt uses, and refuse there before any spawn.
fn codex_harness_trip_lock() -> CodexTripLock {
  CodexTripLock { lock_path: codex_harness_turn_lock_path, conflict_exit_code: codex_harness_turn_busy_exit }
}

fn codex_observed_standing_for_instance(instance: HostDashboardInstance, provider: ProviderInstance) -> ProviderStanding {
  if (instance.host_identity as String) != (codex_worker_turn_custody_host as String) {
    ProviderStandingUnobserved {
      reason: join(["the codex worker-turn credential is held only on ", codex_worker_turn_custody_host as String, "; this instance runs on ", instance.host_identity as String], "") as NonEmptyStr,
    }
  } else {
    match dashboard_instance_provider_executable(instance: instance) {
      Absent => ProviderStandingUnobserved { reason: "no codex executable is placed for this instance" as NonEmptyStr }
      Present { value: executable } => {
        let run = shell.Exec.RunArgvStdin(
          program: codex_press_account_trip_program(lock: Present { value: codex_harness_trip_lock() }),
          arguments: codex_press_account_trip_invocation(
            executable: executable,
            codex_home: codex_worker_turn_codex_home as FilePath,
            lock: Present { value: codex_harness_trip_lock() },
          ),
          stdin_payload: codex_press_account_trip_request_lines(),
        )
        if run.exit_code == codex_harness_turn_busy_exit {
          ProviderStandingUnobserved { reason: "the codex worker-turn credential is in use by another turn" as NonEmptyStr }
        } else {
          provider_standing_from_observed_bundle(
            fact_id: codex_harness_standing_trip_fact_id,
            provider: provider,
            bundle: provider_standing_bundle_from_codex_account_evidence(
              evidence: parse_account_trip_session(
                stdout: run.stdout,
                stderr: run.stderr,
                evidence_root: instance.instance_root,
                mode: AccountTripDigestStructural,
              ),
              credential: codex_harness_credential_context(),
              installation: codex_trip_installation(exit_code: run.exit_code, stderr: run.stderr),
              tool_environment: ToolEnvironmentReady,
            ),
          )
        }
      }
    }
  }
}

fn codex_trip_installation(exit_code: Int, stderr: String) -> ProviderInstallationStanding {
  if exit_code == 0 {
    InstallationReady
  } else {
    InstallationStandingUnobserved {
      reason: join(["the codex app-server trip exited ", to_string(value: exit_code), ": ", stderr], "") as NonEmptyStr,
    }
  }
}

// THE CURSOR STANDING JOINS THREE FACTS, and the offer is selectable only when all three hold: Cursor
// accepts the custody key, this host can build the sandbox the worker turn declares, and the account's
// entitlement and quota are observed. The key is judged by CursorKeyProbeReading, a --list-models
// invocation, because it validates the invocation's own CURSOR_API_KEY while `status` reports only the
// auth stored under the config root (extdeps.llm.cursor_cli, observed 2026-10-17). That probe persists the
// key under whatever config root it sees, so every invocation here runs under the attempt's own runtime
// root (gunbc.cursor_harness_credential cursor_runtime_bound_command) and the probe runs only after the
// sandbox preflight read Ready: a host that cannot sandbox never receives the credential at all. The sandbox
// preflight answers the second without a provider call (gunbc.cursor_harness_credential
// CursorSandboxPreflightReading): cursor_worker_turn_run declares CursorSandboxEnabled so that --force is
// not unconfined, and a host that cannot build that sandbox fails the turn before the provider -- observed
// on srv2, 2026-10-16 -- so the draw refuses here with the host's cause, before launch or provider contact.
// Both run after the attempt's runtime root was created and its receipt-qualified snapshot taken
// (gunbc.roadmap.roadmap_dispatch_actuator cursor_selection_observed takes it first), and the refused
// selection discards the snapshot and the root. The third is observed by a one-word turn (operator ruling
// D2, 2026-10-05), whose result shape is modeled from its first live call, so until then the standing is
// unobserved and the draw refuses -- never a fabricated "available".
data cursor_entitlement_trip_pending_reason: NonEmptyStr = "the Cursor key is accepted (--list-models) and the sandbox is ready, but entitlement and quota are read by a one-word turn whose result shape is modeled from its first live call, which has not run, so the standing stays unobserved rather than fabricated available" as NonEmptyStr

data cursor_sandbox_unavailable_reason_prefix: String = "this host cannot build the sandbox the worker turn declares, so a turn would fail before the provider and the key was not presented: "

// THE PINNED EXECUTABLE IS THE ONLY PROGRAM THE DRAW RUNS, SO ITS ABSENCE IS ITS OWN REFUSAL, and it is
// observed before any invocation (cursor_agent_pinned_executable_presence lists the version directory)
// rather than inferred from a shell's 127. A host without the installed realization reads as this reason,
// never as a PATH fallback and never as a rejected or unreadable key.
fn cursor_pinned_realization_absent_reason(detail: String) -> NonEmptyStr {
  join([
    "the pinned cursor-agent realization is not installed on this host (",
    cursor_agent_executable_path(version: cursor_agent_pinned_version),
    " is not present: ", detail, "); a cursor draw never falls back to a PATH cursor-agent",
  ], "") as NonEmptyStr
}

fn cursor_standing_from_key(key: CursorKeyProbeReading) -> ProviderStanding {
  match key {
    CursorKeyAccepted => ProviderStandingUnobserved { reason: cursor_entitlement_trip_pending_reason }
    CursorKeyRejected { detail } =>
      ProviderStandingUnobserved { reason: join(["the Cursor CLI rejected the custody key: ", detail], "") as NonEmptyStr }
    CursorKeyProbeUnreadable { exit_code, detail } =>
      ProviderStandingUnobserved {
        reason: join(["the Cursor key probe exited ", to_string(value: exit_code), " without a recognized acceptance or rejection: ", detail], "") as NonEmptyStr,
      }
  }
}

// The sandbox arms that stop the line: the key probe is not reached for any of them. It takes the reading's
// own refusal (gunbc.cursor_harness_credential CursorSandboxRefusal), so Ready has no constructor here
// (DESIGN §4b: structurally impossible beats a fail-closed placeholder for an arm no caller can reach).
fn cursor_standing_from_sandbox_refusal(refusal: CursorSandboxRefusal) -> ProviderStanding {
  match refusal {
    CursorSandboxUnavailable { detail } =>
      ProviderStandingUnobserved { reason: concat(cursor_sandbox_unavailable_reason_prefix, detail) as NonEmptyStr }
    CursorSandboxNotEntered { detail } =>
      ProviderStandingUnobserved {
        reason: join(["the cursor sandbox preflight exited 0 but its command did not read CURSOR_SANDBOX=native from inside, so the CLI may have run it unsandboxed: ", detail], "") as NonEmptyStr,
      }
    CursorSandboxPreflightUnreadable { exit_code, detail } =>
      ProviderStandingUnobserved {
        reason: join(["the cursor sandbox preflight exited ", to_string(value: exit_code), " without naming its unsupported-sandbox error (on 124 the bound may have fired or the CLI returned 124 itself): ", detail], "") as NonEmptyStr,
      }
  }
}

// THE PREFLIGHT, bounded. It reads no key and makes no provider call; it runs under the attempt's runtime
// root like every other invocation.
data cursor_sandbox_preflight_bound: Second = second(count: 30)
data cursor_sandbox_preflight_kill_grace: Second = second(count: 5)

fn cursor_sandbox_preflight_observe(program: ProgramIdentity, root: CursorAttemptRuntimeRoot) -> CursorSandboxPreflightReading {
  let run = run_shell_command_observe(
    command: timeout_command(
      duration: cursor_sandbox_preflight_bound,
      kill_after: cursor_sandbox_preflight_kill_grace,
      command: cursor_sandbox_discriminating_preflight_command(program: program, root: root),
    ),
    transport: LocalExec,
  )
  cursor_sandbox_preflight_reading(exit_code: run.exit_code, stdout: run.stdout, stderr: run.stderr)
}

// THE KEY PROBE IS BOUNDED: --list-models is network-backed and measured at about 1.3 s wall on srv2, so a
// stalled network or CLI would otherwise hold selection until the belt limit kills the producer (A3 recovery is
// crash recovery, not an operating bound). The timeout wraps the WHOLE export-from-file command, so the shell and
// the exec'd CLI are one process tree under it. A returned 124 stays CursorKeyProbeUnreadable: it is not an
// observed timeout (gunbc.recurring_failure_mode bare_exit_124_read_as_an_observed_timeout_event).
data cursor_key_probe_bound: Second = second(count: 30)
data cursor_key_probe_kill_grace: Second = second(count: 5)

// THE ONE KEYED, BOUNDED PROBE COMMAND: admit name -> export-from-file -> timeout. cursor_key_probe_observe and the
// wet witness's probe both build it here, so (a), (b), (c) run the production bound and not a parallel copy.
type CursorBoundedProbeCommand
  = CursorBoundedProbeReady { command: ArgvCommand }
  | CursorBoundedProbeNameRefused { spelling: String }
  | CursorBoundedProbeEmitRefused { name: NonEmptyStr }

fn cursor_bounded_keyed_probe_command(program: ProgramIdentity, root: CursorAttemptRuntimeRoot, key_path: NonEmptyStr) -> CursorBoundedProbeCommand {
  match admit_posix_shell_name(spelling: cursor_api_key_env_var as String) {
    PosixShellNameRefused { spelling } => CursorBoundedProbeNameRefused { spelling: spelling }
    PosixShellNameAdmitted { name } =>
      match posix_sh_export_from_file_then_exec_command(
        name: name,
        path: key_path,
        command: argv_words(command: cursor_bound_key_probe_command(program: program, root: root)),
        disposition: PosixShKeepFile,
      ) {
        PosixShExportExecEmitRefused { name: n } => CursorBoundedProbeEmitRefused { name: n }
        PosixShExportExecReady { command } =>
          CursorBoundedProbeReady {
            command: timeout_command(duration: cursor_key_probe_bound, kill_after: cursor_key_probe_kill_grace, command: command),
          }
      }
  }
}

// The key probe BORROWS the attempt's credential snapshot: it reads the sealed value the take returned and
// keeps the file for the spawn (PosixShKeepFile). It is reached only when the sandbox read Ready.
fn cursor_key_probe_observe(program: ProgramIdentity, root: CursorAttemptRuntimeRoot, snapshot: TakenCredentialSnapshot) -> ProviderStanding {
  let path = taken_credential_snapshot_path(snapshot: snapshot)
  match cursor_bounded_keyed_probe_command(program: program, root: root, key_path: path) {
    CursorBoundedProbeNameRefused { spelling } =>
      ProviderStandingUnobserved { reason: join(["the cursor credential variable name ", spelling, " is not a POSIX shell name"], "") as NonEmptyStr }
    CursorBoundedProbeEmitRefused { name: n } =>
      ProviderStandingUnobserved { reason: join(["the sh emitter refused the export-and-exec program for ", n as String], "") as NonEmptyStr }
    CursorBoundedProbeReady { command } => {
      let run = run_shell_command_observe(command: command, transport: LocalExec)
      if run.exit_code == posix_sh_export_from_file_unreadable_exit {
        ProviderStandingUnobserved {
          reason: join(["the cursor credential snapshot ", path as String, " is unreadable: ", run.stderr], "") as NonEmptyStr,
        }
      } else {
        cursor_standing_from_key(key: cursor_key_probe_reading(exit_code: run.exit_code, stdout: run.stdout, stderr: run.stderr))
      }
    }
  }
}

// THE ORDER IS STRUCTURAL: the pinned path is observed present, then the sandbox preflight runs, then the
// key probe only on a Ready sandbox, all under the attempt's runtime root (the caller created it and took
// the snapshot first). Evaluation of arguments is eager, so each step sits inside the previous step's
// match arm and cannot run when an earlier one stopped the line.
fn cursor_observed_standing_from_snapshot(snapshot: TakenCredentialSnapshot) -> ProviderStanding {
  cursor_observed_standing_for_program(program: cursor_agent_pinned_program(), presence: cursor_agent_pinned_executable_presence(), snapshot: snapshot)
}

// The fold over a SUPPLIED program and its presence observation. The one production call site above supplies
// the pinned pair; the srv2 stand-in controls (test.claim.cursor_runtime_root_wet_witness) supply a test-only
// identity, so the real ordering is what they run and no second production identity or fallback exists.
fn cursor_observed_standing_for_program(program: ProgramIdentity, presence: FilesystemEntryPresence, snapshot: TakenCredentialSnapshot) -> ProviderStanding {
  let root = credential_taken_cursor_runtime_root(snapshot: snapshot)
  match presence {
    FilesystemEntryAbsent(absence) =>
      ProviderStandingUnobserved { reason: cursor_pinned_realization_absent_reason(detail: filesystem_established_absence_detail(absence: absence)) }
    FilesystemEntryPresenceIndeterminate { cause } =>
      ProviderStandingUnobserved { reason: cursor_pinned_realization_absent_reason(detail: cause) }
    FilesystemEntrySubjectRefused { directory: _, name: _, cause } =>
      ProviderStandingUnobserved { reason: cursor_pinned_realization_absent_reason(detail: cause) }
    FilesystemEntryListed { directory: _, name: _ } =>
      match cursor_sandbox_preflight_observe(program: program, root: root) {
        CursorSandboxReady => cursor_key_probe_observe(program: program, root: root, snapshot: snapshot)
        CursorSandboxRefused { refusal } => cursor_standing_from_sandbox_refusal(refusal: refusal)
      }
  }
}
