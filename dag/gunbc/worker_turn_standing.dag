// THE CODEX AND CURSOR OFFERS ARE JUDGED ON THE CREDENTIAL THE SPAWN BINDS, the way the Claude draw
// is (gunbc.roadmap.roadmap_dispatch_actuator claude_observed_standing_from_snapshot). Before this, both offers
// carried the declared inventory's unobserved standing, so creating the secrets and converging their
// custody could not change selection: a declared row admits no draw. Each observation here runs on
// the custody host against the custody credential and nothing ambient, so a login someone made by hand
// on the host cannot change the verdict. They run only on an operator's explicit executor request.

data codex_harness_standing_trip_fact_id: RecordedFactId = "codex-harness-standing-trip" as RecordedFactId

// THE CODEX STANDING TRIP is the existing app-server account trip (initialize, account/read,
// account/rateLimits/read; gunbc.codex_app_server_press codex_press_account_trip_invocation) with
// CODEX_HOME set to the custody directory and run under the same flock as a turn, because account/read may refresh the token and a refresh
// rotates it: a trip racing a turn would present one refresh token twice. A trip that finds the lock
// held reports the credential busy rather than a codex failure. Exhausted rate-limit buckets and a
// dead login reach selection through provider_standing_bundle_from_codex_account_evidence, the same
// projection the press receipt uses, and refuse there before any spawn.
fn codex_harness_trip_lock() -> CodexTripLock {
  CodexTripLock { lock_path: codex_harness_turn_lock_path, conflict_exit_code: codex_harness_turn_busy_exit }
}

fn codex_observed_standing_for_instance(instance: HostDashboardInstance, provider: ProviderInstance) -> ProviderStanding {
  if (instance.host_identity as String) != (codex_worker_turn_custody_host as String) {
    ProviderStandingUnobserved {
      reason: join(["the codex worker-turn credential is held only on ", codex_worker_turn_custody_host as String, "; this instance runs on ", instance.host_identity as String], "") as NonEmptyStr,
    }
  } else {
    match dashboard_instance_provider_executable(instance: instance) {
      Absent => ProviderStandingUnobserved { reason: "no codex executable is placed for this instance" as NonEmptyStr }
      Present { value: executable } => {
        let run = shell.Exec.RunArgvStdin(
          program: codex_press_account_trip_program(lock: Present { value: codex_harness_trip_lock() }),
          arguments: codex_press_account_trip_invocation(
            executable: executable,
            codex_home: codex_worker_turn_codex_home as FilePath,
            lock: Present { value: codex_harness_trip_lock() },
          ),
          stdin_payload: codex_press_account_trip_request_lines(),
        )
        if run.exit_code == codex_harness_turn_busy_exit {
          ProviderStandingUnobserved { reason: "the codex worker-turn credential is in use by another turn" as NonEmptyStr }
        } else {
          provider_standing_from_observed_bundle(
            fact_id: codex_harness_standing_trip_fact_id,
            provider: provider,
            bundle: provider_standing_bundle_from_codex_account_evidence(
              evidence: parse_account_trip_session(
                stdout: run.stdout,
                stderr: run.stderr,
                evidence_root: instance.instance_root,
                mode: AccountTripDigestStructural,
              ),
              credential: codex_harness_credential_context(),
              installation: codex_trip_installation(exit_code: run.exit_code, stderr: run.stderr),
              tool_environment: ToolEnvironmentReady,
            ),
          )
        }
      }
    }
  }
}

fn codex_trip_installation(exit_code: Int, stderr: String) -> ProviderInstallationStanding {
  if exit_code == 0 {
    InstallationReady
  } else {
    InstallationStandingUnobserved {
      reason: join(["the codex app-server trip exited ", to_string(value: exit_code), ": ", stderr], "") as NonEmptyStr,
    }
  }
}

// THE CURSOR STANDING JOINS THREE FACTS, and the offer is selectable only when all three hold: Cursor
// accepts the custody key, this host can build the sandbox the worker turn declares, and the
// account's entitlement and quota are observed. TODAY the first is NOT yet observed: cursor-agent status
// reads the STORED auth under the config root it runs with, not CURSOR_API_KEY (extdeps.llm.cursor_cli,
// observed 2026-10-17), so its answer is about the config root and the reasons below say so. The key
// is judged by CursorKeyProbeReading, which the standing consumes in the runtime-root wiring change. The sandbox preflight answers the second without a provider call
// (gunbc.cursor_harness_credential CursorSandboxPreflightReading): gunbc.cursor_harness_credential
// cursor_worker_turn_run declares CursorSandboxEnabled so that --force is not unconfined, and a host
// that cannot build that sandbox fails the turn before the provider -- observed on srv2, 2026-10-16
// -- so the draw refuses here with the host's cause, before launch or provider contact. It runs after
// the attempt's receipt-qualified snapshot has been taken (gunbc.roadmap.roadmap_dispatch_actuator
// cursor_selection_observed takes it first), and the refused selection discards that snapshot. The
// third is observed by a one-word turn (operator ruling D2, 2026-10-05), whose result shape is
// modeled from its first live call, so until then the standing is unobserved and the draw refuses --
// never a fabricated "available".
data cursor_entitlement_trip_pending_reason: NonEmptyStr = "the Cursor config root's stored auth reads authenticated (status does not judge the custody key), but entitlement and quota are read by a one-word turn whose result shape is modeled from its first live call (operator ruling D2, 2026-10-05); until then the cursor draw refuses" as NonEmptyStr

data cursor_sandbox_unavailable_reason_prefix: String = "the Cursor config root's stored auth reads authenticated (status does not judge the custody key), but this host cannot build the sandbox the worker turn declares, so a turn would fail before the provider: "

// THE PINNED EXECUTABLE IS THE ONLY PROGRAM THE DRAW RUNS, SO ITS ABSENCE IS ITS OWN REFUSAL. The
// status probe execs the exact root-owned path inside sh; the shell reports a missing path as 127 (not
// found), which no cursor-agent status answer uses, and a host without the installed realization reads
// as this reason, never as a PATH fallback and never as an unauthenticated or unreadable key. The
// preflight is not run in that case.
data cursor_pinned_executable_unrunnable_exit: Int = 127

fn cursor_pinned_executable_absent(exit_code: Int) -> Bool {
  exit_code == cursor_pinned_executable_unrunnable_exit
}

fn cursor_pinned_realization_absent_reason() -> NonEmptyStr {
  join([
    "the pinned cursor-agent realization is not installed on this host (",
    cursor_agent_executable_path(version: cursor_agent_pinned_version),
    " could not be run); a cursor draw never falls back to a PATH cursor-agent",
  ], "") as NonEmptyStr
}

fn cursor_standing_from_readings(status: CursorStatusReading, sandbox: CursorSandboxPreflightReading) -> ProviderStanding {
  match status {
    CursorStatusAuthenticated => cursor_standing_with_accepted_key(sandbox: sandbox)
    CursorStatusUnauthenticated { status } =>
      ProviderStandingUnobserved { reason: join(["the Cursor config root holds no stored auth (status ", status, ")"], "") as NonEmptyStr }
    CursorStatusUnreadable { detail } =>
      ProviderStandingUnobserved { reason: join(["cursor-agent status output unreadable: ", detail], "") as NonEmptyStr }
  }
}

fn cursor_standing_with_accepted_key(sandbox: CursorSandboxPreflightReading) -> ProviderStanding {
  match sandbox {
    CursorSandboxReady => ProviderStandingUnobserved { reason: cursor_entitlement_trip_pending_reason }
    CursorSandboxUnavailable { detail } =>
      ProviderStandingUnobserved { reason: concat(cursor_sandbox_unavailable_reason_prefix, detail) as NonEmptyStr }
    CursorSandboxNotEntered { detail } =>
      ProviderStandingUnobserved {
        reason: join(["the cursor sandbox preflight exited 0 but its command did not read CURSOR_SANDBOX=native from inside, so the CLI may have run it unsandboxed: ", detail], "") as NonEmptyStr,
      }
    CursorSandboxPreflightUnreadable { exit_code, detail } =>
      ProviderStandingUnobserved {
        reason: join(["the cursor sandbox preflight exited ", to_string(value: exit_code), " without naming its unsupported-sandbox error (on 124 the bound may have fired or the CLI returned 124 itself): ", detail], "") as NonEmptyStr,
      }
  }
}

// THE PREFLIGHT, bounded. It reads no key and makes no provider call; it runs in the caller's working
// directory, which the sandbox's default policy makes writable to a command that writes nothing. It
// is evaluated as an argument of the join, so it runs whenever status ran, including when the key was
// rejected: the join orders the REASONS, not the observations.
data cursor_sandbox_preflight_bound: Second = second(count: 30)
data cursor_sandbox_preflight_kill_grace: Second = second(count: 5)

fn cursor_sandbox_preflight_observe(program: ProgramIdentity) -> CursorSandboxPreflightReading {
  let run = run_shell_command_observe(
    command: timeout_command(
      duration: cursor_sandbox_preflight_bound,
      kill_after: cursor_sandbox_preflight_kill_grace,
      command: cursor_sandbox_discriminating_preflight_command(program: program),
    ),
    transport: LocalExec,
  )
  cursor_sandbox_preflight_reading(exit_code: run.exit_code, stdout: run.stdout, stderr: run.stderr)
}

// The status probe BORROWS the attempt's credential snapshot: it reads the sealed value the take
// returned and keeps the file for the spawn (PosixShKeepFile); the snapshot is taken by the caller
// (gunbc.roadmap.roadmap_dispatch_actuator cursor_selection_observed).
fn cursor_observed_standing_from_snapshot(snapshot: TakenCredentialSnapshot) -> ProviderStanding {
  let program = cursor_agent_pinned_program()
  let path = taken_credential_snapshot_path(snapshot: snapshot)
  match admit_posix_shell_name(spelling: cursor_api_key_env_var as String) {
    PosixShellNameRefused { spelling } =>
      ProviderStandingUnobserved { reason: join(["the cursor credential variable name ", spelling, " is not a POSIX shell name"], "") as NonEmptyStr }
    PosixShellNameAdmitted { name } =>
      match posix_sh_export_from_file_then_exec_command(
        name: name,
        path: path,
        command: argv_words(command: cursor_status_command(program: program)),
        disposition: PosixShKeepFile,
      ) {
        PosixShExportExecEmitRefused { name: n } =>
          ProviderStandingUnobserved { reason: join(["the sh emitter refused the export-and-exec program for ", n as String], "") as NonEmptyStr }
        PosixShExportExecReady { command } => {
          let run = run_shell_command_observe(command: command, transport: LocalExec)
          if run.exit_code == posix_sh_export_from_file_unreadable_exit {
            ProviderStandingUnobserved {
              reason: join(["the cursor credential snapshot ", path as String, " is unreadable: ", run.stderr], "") as NonEmptyStr,
            }
          } else if cursor_pinned_executable_absent(exit_code: run.exit_code) {
            ProviderStandingUnobserved { reason: cursor_pinned_realization_absent_reason() }
          } else {
            cursor_standing_from_readings(status: cursor_status_reading(stdout: run.stdout), sandbox: cursor_sandbox_preflight_observe(program: program))
          }
        }
      }
  }
}
