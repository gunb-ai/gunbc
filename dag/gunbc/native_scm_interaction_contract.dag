module gunbc.native_scm_interaction_contract


data native_scm_interaction_contract_note: String = "Model-first contract carrier for the native SCM interaction slice. The model stays on the presentation side of the split: a proposal has a stable identity, every displayed label is backed by a stored resumable option, and selection uses the option's structural position rather than caller-authored display text. Equal labels therefore cannot collapse two resume tokens into an ambiguous identity, and selection returns the stored option for resumption rather than fabricating Landed before semantic admission, transition, and independent read-back. The user-facing terminal outcome is Landed | ChoiceRequired | CouldNotLand, review/access/check/operational remain orthogonal fields, operational pending causes distinguish projection repair from unrelated internal work, workspace/target context stays optional, and compatibility projections are indexed by realization and target rather than a Git-only slot. No engine, semantic admission, transport, or CLI lives here; the witnesses exercise the contract as a black-box surface."

type NativeScmProposalIdentity {
  name: String
  attempt_key: String
}

type NativeScmCommitTransition
  = NativeScmCommitTransitionUncommitted
  | NativeScmCommitTransitionCommitted

type NativeScmLifecycle
  = NativeScmLifecyclePending
  | NativeScmLifecycleReady
  | NativeScmLifecycleRefused { reason: String }

type NativeScmOperationalState
  = NativeScmOperationalReady
  | NativeScmProjectionRepairPending
  | NativeScmInternalWorkPending
  | NativeScmOperationalRefused { reason: String }

type NativeScmProjection {
  workspace: v2.std.optional.Optional<String>
  target: v2.std.optional.Optional<String>
  realizations: List<gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt>
}

type NativeScmContinuationOption {
  label: std.types.NonEmptyStr
  result_preview: std.types.NonEmptyStr
  resume_token: std.types.NonEmptyStr
}

type NativeScmContinuationOptions {
  first_option: NativeScmContinuationOption
  second_option: NativeScmContinuationOption
  additional_options: List<NativeScmContinuationOption>
}

type NativeScmContinuation {
  proposal: NativeScmProposalIdentity
  options: NativeScmContinuationOptions
}

type NativeScmContinuationChoice
  = NativeScmFirstContinuationOption
  | NativeScmSecondContinuationOption
  | NativeScmAdditionalContinuationOption {
      index: std.integer.NonNegativeInt,
    }

type NativeScmContinuationChoiceFold<R> {
  first: fn() -> R
  second: fn() -> R
  additional: fn(std.integer.NonNegativeInt) -> R
}

fn native_scm_continuation_choice_fold<R>(
  choice: NativeScmContinuationChoice,
  fold: NativeScmContinuationChoiceFold<R>,
) -> R {
  match choice {
    NativeScmFirstContinuationOption =>
      fold.first()
    NativeScmSecondContinuationOption =>
      fold.second()
    NativeScmAdditionalContinuationOption { index } =>
      fold.additional(index)
  }
}

type NativeScmContinuationChoiceLookup
  = NativeScmContinuationChoiceMatched {
      selected: NativeScmSelectedContinuationOption,
    }
  | NativeScmContinuationChoiceNotOffered {
      choice: NativeScmContinuationChoice,
    }

type NativeScmContinuationOptionIdentity {
  proposal: NativeScmProposalIdentity
  choice: NativeScmContinuationChoice
}

type NativeScmSelectedContinuationOption {
  identity: NativeScmContinuationOptionIdentity
  option: NativeScmContinuationOption
}

type NativeScmContinuationChoiceLookupFold<R> {
  matched: fn(NativeScmSelectedContinuationOption) -> R
  not_offered: fn(NativeScmContinuationChoice) -> R
}

fn native_scm_continuation_choice_lookup_fold<R>(
  lookup: NativeScmContinuationChoiceLookup,
  fold: NativeScmContinuationChoiceLookupFold<R>,
) -> R {
  match lookup {
    NativeScmContinuationChoiceMatched { selected } =>
      fold.matched(selected)
    NativeScmContinuationChoiceNotOffered { choice } =>
      fold.not_offered(choice)
  }
}

type NativeScmRefusal {
  plain_reason: String
  responsible_party: String
  next_action: String
  refusal_receipt: String
}

type NativeScmPrimaryOutcome
  = Landed {
      result_preview: String
    }
  | ChoiceRequired {
      question: String
      continuation: NativeScmContinuation
    }
  | InProgress {
      progress_preview: String
    }
  | CouldNotLand {
      refusal: NativeScmRefusal
    }

type NativeScmTerminalOutcome
  = NativeScmTerminalLanded {
      result_preview: String
    }
  | NativeScmTerminalChoiceRequired {
      question: String
      continuation: NativeScmContinuation
    }
  | NativeScmTerminalCouldNotLand {
      refusal: NativeScmRefusal
    }

type NativeScmReceipt {
  identity: NativeScmProposalIdentity
  transition: NativeScmCommitTransition
  review: NativeScmLifecycle
  access: NativeScmLifecycle
  check: NativeScmLifecycle
  operational: NativeScmOperationalState
  projections: NativeScmProjection
  primary: NativeScmPrimaryOutcome
  receipt_details: v2.std.optional.Optional<String>
}

type NativeScmProjectionRepairOutcome
  = NativeScmProjectionRepaired {
      receipt: NativeScmReceipt
    }
  | NativeScmProjectionRepairNotPending {
      receipt: NativeScmReceipt
    }
  | NativeScmProjectionRepairBlockedByInternalWork {
      receipt: NativeScmReceipt
    }
  | NativeScmProjectionRepairAlreadyRefused {
      receipt: NativeScmReceipt
      reason: String
    }

fn native_scm_primary_label(primary: NativeScmPrimaryOutcome) -> String {
  match primary {
    Landed { result_preview: _ } => "Landed"
    ChoiceRequired { question: _, continuation: _ } => "ChoiceRequired"
    InProgress { progress_preview: _ } => "InProgress"
    CouldNotLand { refusal: _ } => "CouldNotLand"
  }
}

fn native_scm_continuation_options(
  continuation: NativeScmContinuation,
) -> List<NativeScmContinuationOption> {
  append(
    [
      continuation.options.first_option,
      continuation.options.second_option,
    ],
    items: continuation.options.additional_options,
  )
}

fn native_scm_choice_previews(
  continuation: NativeScmContinuation,
) -> List<String> {
  native_scm_continuation_options(continuation: continuation)
    |> map(option => option.result_preview)
}

fn native_scm_resolve_choice(
  continuation: NativeScmContinuation,
  choice: NativeScmContinuationChoice,
) -> NativeScmContinuationChoiceLookup {
  native_scm_continuation_choice_fold(
    choice: choice,
    fold: NativeScmContinuationChoiceFold {
      first: fn() {
        NativeScmContinuationChoiceMatched {
          selected: NativeScmSelectedContinuationOption {
            identity: NativeScmContinuationOptionIdentity {
              proposal: continuation.proposal,
              choice: choice,
            },
            option: continuation.options.first_option,
          },
        }
      },
      second: fn() {
        NativeScmContinuationChoiceMatched {
          selected: NativeScmSelectedContinuationOption {
            identity: NativeScmContinuationOptionIdentity {
              proposal: continuation.proposal,
              choice: choice,
            },
            option: continuation.options.second_option,
          },
        }
      },
      additional: fn(index) {
        match v2.std.collection.list_at_optional(
          xs: continuation.options.additional_options,
          index: index,
        ) {
          Present { value } =>
            NativeScmContinuationChoiceMatched {
              selected: NativeScmSelectedContinuationOption {
                identity: NativeScmContinuationOptionIdentity {
                  proposal: continuation.proposal,
                  choice: choice,
                },
                option: value,
              },
            }
          Absent =>
            NativeScmContinuationChoiceNotOffered {
              choice: choice,
            }
        }
      },
    },
  )
}

fn native_scm_attach_projection(
  receipt: NativeScmReceipt,
  projection: gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt,
) -> NativeScmReceipt {
  NativeScmReceipt {
    identity: receipt.identity,
    transition: receipt.transition,
    review: receipt.review,
    access: receipt.access,
    check: receipt.check,
    operational: receipt.operational,
    projections: NativeScmProjection {
      workspace: receipt.projections.workspace,
      target: receipt.projections.target,
      realizations: compatibility_projection_upsert(
        existing: receipt.projections.realizations,
        projection: projection,
      ),
    },
    primary: receipt.primary,
    receipt_details: receipt.receipt_details,
  }
}

fn native_scm_record_repaired_projection(
  receipt: NativeScmReceipt,
  projection: gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt,
) -> NativeScmProjectionRepairOutcome {
  match receipt.operational {
    NativeScmProjectionRepairPending => {
      let attached = native_scm_attach_projection(
        receipt: receipt,
        projection: projection,
      )
      NativeScmProjectionRepaired {
        receipt: NativeScmReceipt {
          identity: attached.identity,
          transition: attached.transition,
          review: attached.review,
          access: attached.access,
          check: attached.check,
          operational: NativeScmOperationalReady,
          projections: attached.projections,
          primary: attached.primary,
          receipt_details: attached.receipt_details,
        },
      }
    }
    NativeScmInternalWorkPending =>
      NativeScmProjectionRepairBlockedByInternalWork {
        receipt: receipt,
      }
    NativeScmOperationalReady =>
      NativeScmProjectionRepairNotPending {
        receipt: receipt,
      }
    NativeScmOperationalRefused { reason } =>
      NativeScmProjectionRepairAlreadyRefused {
        receipt: receipt,
        reason: reason,
      }
  }
}

fn native_scm_inspect_receipt(receipt: NativeScmReceipt, authorized: Bool) -> v2.std.optional.Optional<String> {
  if authorized {
    match receipt.receipt_details {
      Present { value: details } =>
        v2.std.optional.optional_present(
          value: concat(
            "proposal=",
            concat(
              receipt.identity.name,
              concat(
                "; attempt=",
                concat(receipt.identity.attempt_key, concat("; ", details)),
              ),
            ),
          ),
        )
      Absent => v2.std.optional.optional_absent()
    }
  } else {
    v2.std.optional.optional_absent()
  }
}
data native_scm_contract_test_fixture_boundary_note: String = "Named scenario construction and the submission-ledger oracle live only in test.claim.native_scm_interaction_scenario_fixture. This production carrier owns presentation, structural continuation identity, terminal-outcome shape, projection attachment, and inspection only; it cannot manufacture Landed from a scenario name."
