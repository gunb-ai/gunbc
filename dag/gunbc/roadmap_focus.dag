module gunbc.roadmap_focus


data roadmap_focus_note: String = "A VIEW policy over the roadmap, never an edit to it. When one lane is being worked, the other lanes are noise on the page — but deleting or parking them to get quiet would destroy work, and a roadmap that forgets a deliverable because someone wanted a shorter page is the worst possible failure for a queue. So focus filters the PROJECTION and leaves the authority whole: every node stays declared, every edge stays declared, and clearing the focus restores the full page with no recovery step. The mechanism is one row (roadmap_focus_selection) and reverting it is one edit.\n\nSelection is by OWNER rather than by a list of node ids. An id list would silently stop covering the lane the moment a new node joined it — the focus would look right and quietly understate, which is the same class of failure as a hand-maintained count. Owner is the lane's own identity and a new node in the lane inherits the focus by construction."

// HIDING MUST BE VISIBLE. A filtered page that simply renders fewer rows is indistinguishable from a roadmap that has fewer deliverables, and the reader most likely to be misled is the one who set the focus and then forgot — the page would read as 'this is all the work' when it means 'this is the work you asked to see'. So the projection states the focus and the DERIVED count of what it is hiding. The count is computed from the same node list the filter runs over, so it cannot drift from what was actually withheld; there is no hand-written number to go stale, and a focus that hides nothing says so rather than printing a reassuring zero it did not compute.
type RoadmapFocus
  = NoFocus
  | FocusOnOwners {
      label: String,
      owners: List<String>,
    }

fn focus_admits_owner(focus: RoadmapFocus, owner: String) -> Bool {
  match focus {
    NoFocus => true
    FocusOnOwners { label: _, owners } => any(owners, o => o == owner)
  }
}

fn focus_admits_node(focus: RoadmapFocus, n: gunbc.roadmap_model.RoadmapNode) -> Bool {
  focus_admits_owner(focus: focus, owner: n.owner)
}

data focus_prerequisite_closure_note: String = "A FOCUS MUST BE CLOSED UNDER PREREQUISITES, or it shows work that cannot start and does not say why. Owner membership alone is the wrong visibility rule: the v1 deletion lane's critical path runs pderive-source-slot-binding, whose prerequisite namespace-canonical-binding belongs to the namespace lane — so an owner-only filter rendered the fourth link of the spine as though it were ready, with its blocker invisible. An operator working that page would pick it up and discover the block by hitting it. Worse for an agent: a dispatched worker reads a ready-looking node, starts, and stalls on work the page never mentioned.\n\nVisibility is therefore lane membership UNIONED with the transitive prerequisite closure of the lane. The closure reuses std.graph.graph_reverse_reachable_members over the roadmap's own edge relation rather than minting a second walk — the roadmap edge (child, parent) is already a dependency edge, reverse reachability from a lane node is exactly its ancestors, and the graph is acyclic by witness so the walk terminates by construction. A blocker is pulled onto the page WITH its own prerequisites, recursively, so the visible subgraph is genuinely startable end to end.\n\nPulled-in nodes stay distinguishable from lane work in the notice. They are not deliverables of this lane; they are the reason part of it cannot move, and conflating the two would misreport the lane's size."

fn focus_lane_nodes(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
) -> List<gunbc.roadmap_model.RoadmapNode> {
  nodes |> filter(n => focus_admits_node(focus: focus, n: n))
}

fn roadmap_dependency_graph(edges: List<gunbc.roadmap_model.RoadmapEdge>) -> std.graph.CallGraph {
  std.graph.CallGraph {
    edges: edges |> map(e => std.graph.GraphEdge {
      caller: e.parent as String,
      callee: e.child as String,
    }),
  }
}

fn focus_prerequisite_ids(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
  edges: List<gunbc.roadmap_model.RoadmapEdge>,
) -> List<String> {
  let names = nodes |> map(n => n.node as String)
  let graph = roadmap_dependency_graph(edges: edges)
  let lane_ids = focus_lane_nodes(focus: focus, nodes: nodes) |> map(n => n.node as String)
  fold(lane_ids, init: [], f: fn(acc, id) {
    fold(
      std.graph.graph_reverse_reachable_members(names: names, graph: graph, start: id),
      init: acc,
      f: fn(inner, anc) {
        if any(lane_ids, l => l == anc) {
          inner
        } else {
          append_distinct(acc: inner, p: anc)
        }
      },
    )
  })
}

fn focus_visible_nodes(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
  edges: List<gunbc.roadmap_model.RoadmapEdge>,
) -> List<gunbc.roadmap_model.RoadmapNode> {
  match focus {
    NoFocus => nodes
    FocusOnOwners { label: _, owners: _ } =>
      let pulled = focus_prerequisite_ids(focus: focus, nodes: nodes, edges: edges)
      nodes |> filter(n =>
        focus_admits_node(focus: focus, n: n)
          || any(pulled, p => p == (n.node as String)))
  }
}

// An edge survives only when BOTH endpoints do. A dependency edge pointing at a hidden node would render as a prerequisite the reader cannot see and cannot act on — worse than omitting it, because it implies the page is complete while pointing off the edge of it. Dropping the edge keeps the visible subgraph internally consistent: everything named on the page is on the page. The cross-lane prerequisite is not lost, it is declared in the authority and returns the moment the focus clears, which is precisely the property that makes filtering safe here and unsafe as an edit.
fn focus_visible_edges(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
  edges: List<gunbc.roadmap_model.RoadmapEdge>,
) -> List<gunbc.roadmap_model.RoadmapEdge> {
  let visible = focus_visible_nodes(focus: focus, nodes: nodes, edges: edges)
  edges |> filter(e =>
    any(visible, n => (n.node as String) == (e.child as String))
      && any(visible, n => (n.node as String) == (e.parent as String)))
}

fn focus_hidden_node_count(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
  edges: List<gunbc.roadmap_model.RoadmapEdge>,
) -> Int {
  count(nodes) - count(focus_visible_nodes(focus: focus, nodes: nodes, edges: edges))
}

fn focus_label(focus: RoadmapFocus) -> String {
  match focus {
    NoFocus => ""
    FocusOnOwners { label, owners: _ } => label
  }
}

fn focus_is_active(focus: RoadmapFocus) -> Bool {
  match focus {
    NoFocus => false
    FocusOnOwners { label: _, owners: _ } => true
  }
}

data focus_carrier_retention_note: String = "HIDING A NODE MUST NOT ORPHAN ITS DOCUMENT. Discovered by execution, not foreseen: focusing the page dropped 10 carrier links, and doc_graph_orphan_count went non-zero because ROADMAP.md is itself a node in the doc graph — for several plans it is the ONLY thing linking them. So the projection is not a pure view after all; it is load-bearing for another invariant, and a filter that ignores that quietly disconnects work from its documentation while looking like a display preference.\n\nThe notice therefore carries the hidden lanes' carrier documents as links. That is not a workaround for the lens: it is what the notice should have said in the first place. A reader told '32 deliverables are hidden' can do nothing with that; a reader given the hidden lanes' plans can go read them. Hiding becomes navigable rather than merely disclosed, and the doc graph stays connected because the links are genuinely still on the page."

fn focus_hidden_nodes(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
  edges: List<gunbc.roadmap_model.RoadmapEdge>,
) -> List<gunbc.roadmap_model.RoadmapNode> {
  let visible = focus_visible_nodes(focus: focus, nodes: nodes, edges: edges)
  nodes |> filter(n => !any(visible, v => (v.node as String) == (n.node as String)))
}

fn append_distinct(acc: List<String>, p: String) -> List<String> {
  if any(acc, existing => existing == p) { acc } else { append(acc, [p]) }
}

fn focus_hidden_carrier_paths(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
  edges: List<gunbc.roadmap_model.RoadmapEdge>,
) -> List<String> {
  fold(
    focus_hidden_nodes(focus: focus, nodes: nodes, edges: edges),
    init: [],
    f: fn(acc, n) {
      fold(n.carriers, init: acc, f: fn(inner, p) {
        append_distinct(acc: inner, p: p.path)
      })
    },
  )
}

fn focus_hidden_carrier_links(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
  edges: List<gunbc.roadmap_model.RoadmapEdge>,
) -> String {
  join(
    map(
      focus_hidden_carrier_paths(focus: focus, nodes: nodes, edges: edges),
      p => join(["[", p, "](", p, ")"], ""),
    ),
    " · ",
  )
}

fn focus_pulled_in_summary(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
  edges: List<gunbc.roadmap_model.RoadmapEdge>,
) -> String {
  let pulled = focus_prerequisite_ids(focus: focus, nodes: nodes, edges: edges)
  if count(pulled) == 0 {
    ""
  } else {
    join([
      " ",
      to_string(count(pulled)),
      " of the rows below are NOT lane deliverables — they are prerequisites pulled in from other lanes because lane work is blocked on them: ",
      join(pulled, ", "),
      ".",
    ], "")
  }
}

fn focus_notice(
  focus: RoadmapFocus,
  nodes: List<gunbc.roadmap_model.RoadmapNode>,
  edges: List<gunbc.roadmap_model.RoadmapEdge>,
) -> String {
  match focus {
    NoFocus => ""
    FocusOnOwners { label, owners: _ } =>
      join([
        "**Focused view — ",
        label,
        ".** ",
        to_string(focus_hidden_node_count(focus: focus, nodes: nodes, edges: edges)),
        " active deliverable(s) in other lanes are declared in the authority and hidden here; nothing is deleted or parked by focusing. Clear `roadmap_focus_selection` in `dag/gunbc/roadmap_authority.dag` to restore the full page.",
        focus_pulled_in_summary(focus: focus, nodes: nodes, edges: edges),
        " Hidden lanes remain readable through their carriers: ",
        focus_hidden_carrier_links(focus: focus, nodes: nodes, edges: edges),
        ".",
      ], "")
  }
}
