module gunbc.network_boot_delivery

import std.types { Bool, EpochMs, List, NonEmptyStr, String }
import std.decl_ref { DeclarationRef }
import std.content_hash { ContentHash }
import extdeps.uri { Uri }
import extdeps.toolchain.types { Architecture, Aarch64 }
import extdeps.provisioning.dhcp_client_arch {
  DhcpProcessorArchitecture,
    UefiArm64,
  UefiX86_64,
  BiosX86,
  HttpBootX86_64,
  HttpBootArm64,
  dhcp_client_processor_architecture,
}
import extdeps.provisioning.network_boot { ClientNetworkBootMode, DhcpBootDirection }
import product.placement_supply { SiteIdentity, site_identity_eq }
import gunbc.machine_intake_access { BootDeliveryTarget, same_boot_delivery_target }
import gunbc.machine_intake_subject { UnitKey, IntakeAttemptId, content_hash_equal }

// THE NETWORK-BOOT ESTABLISHMENT VOCABULARY, in its own authority (machine-intake ruling 3,
// namespace ruling). Its four evidence axes have independent producers — client firmware mode,
// serving infrastructure, boot artifacts, boot control — and the standing they compose is
// consumed by gunbc.boot_artifact_delivery, which imports it and selects the PxeChainBoot
// constructor from it. Keeping it beside its sole constructor would not have violated ruling
// 2; it lives here so the solver is not the home of every candidate's evidence lifecycle.
// PXE was previously reached by ABSENCE: the pre-repair install solver's else-arm answered
// PxeHttpInstall whenever no virtual-media capability was found, so "this BMC exposes no virtual
// media" silently became "therefore it network-boots". Those are different states, and a BMC
// capability roster cannot establish the second — it is a claim about the host's UEFI network
// stack, the serving infrastructure, and the boot artifacts, none of which the BMC reports.
//
// So a network-boot delivery is established only by naming every requirement it rests on. An
// authored chain or serve plan is NOT such an establishment: gunbc.os_install
// srv3_pxe_network_boot_chain and gunbc.bmc_netboot_serve srv4_bmc_netboot_serve_plan describe
// what a network boot WOULD look like, and neither is an observation that the host performed
// one. Citing them as evidence would be the same substitution one layer up.
type NetworkBootRequirement
  = NetworkBootBootSourceOverride
  | NetworkBootClientBootMode
  | NetworkBootServingInfrastructure
  | NetworkBootBootArtifacts

// One observation per requirement axis. A single DeclarationRef standing for all four was the
// same substitution this carrier exists to forbid, one level in: it let an authored plan satisfy
// axes nobody observed. Establishing the delivery now requires naming an observation for each
// axis, so a false claim has to be told four times rather than once.
type NetworkBootRequirementEvidence {
  requirement: NetworkBootRequirement
  observation: DeclarationRef
  observed_at: EpochMs
}

// The establishment names the TARGET it was established for (ruling 4 §1): four
// observations and a digest bind an artifact, not a host, so without the
// target a network boot established on one unit could authorize another's
// request.
type NetworkBootDeliveryEstablishment {
  target: BootDeliveryTarget
  fleet: FleetBootServiceReceipt
  site: SitePxeEdgeReceipt
  client: ObservedClientBootModeReceipt
  boot_control: NetworkBootBootControlReceipt
  manifest: SignedBootManifestIdentity
  trust: BootstrapTrustStanding
  boot_artifacts: NetworkBootRequirementEvidence
  artifact_digest: ContentHash
}

type NetworkBootDeliveryStanding
  = NetworkBootDeliveryEstablished { evidence: NetworkBootDeliveryEstablishment }
  | NetworkBootDeliveryUnestablished { missing: List<NetworkBootRequirement> }
  | NetworkBootDeliveryEvidenceRefused { axis: NetworkBootRequirement, observation: DeclarationRef }
  | NetworkBootDeliveryArchitectureRefused { cause: NetworkBootArchitectureRefusal }
  | NetworkBootDeliveryClientModeRefused { arch: DhcpProcessorArchitecture }
  | NetworkBootDeliveryTargetMismatch { axis: NetworkBootRequirement }
  | NetworkBootDeliveryManifestRefused { cause: NetworkBootManifestRefusal }
  | NetworkBootDeliverySiteUnestablished
  | NetworkBootDeliverySiteMismatch { expected: SiteIdentity, observed: SiteIdentity }
  | NetworkBootDeliveryTrustUnestablished

// A computed rejection of an observed ticket. Missing means no ticket was presented.
type NetworkBootManifestVerificationClass
  = ManifestVerificationMac
  | ManifestVerificationWrongMessage
  | ManifestVerificationWrongArchitecture
  | ManifestVerificationNotYetValid
  | ManifestVerificationExpired
  | ManifestVerificationReplay
  | ManifestVerificationSigningKey
  | ManifestVerificationVerifiedKey
  | ManifestVerificationSuite
  | ManifestVerificationTrust

type NetworkBootManifestRefusal
  = ManifestUnsignedIdentity
  | ManifestVerificationRefused {
      class: NetworkBootManifestVerificationClass
      observation: DeclarationRef
    }
  | ManifestJoinDigestDisagrees
  | ManifestJoinWrongTarget
  | ManifestJoinWrongAttempt
  | ManifestJoinWrongSigningKey
  | ManifestJoinChainloaderDigestDisagrees
  | ManifestJoinWrongFirmwareClass

type NetworkBootArchitectureRefusal
  = ClientArchitectureNotAdmitted { architecture: Architecture }
  | ChainloaderMismatch { client: Architecture, chainloader: Architecture }
  | LoaderNotAdmittedOnSlice { architecture: Architecture }
  | TicketNotAdmittedOnEdge { architecture: Architecture }
  | TicketNotAdmittedOnSlice { architecture: Architecture }

data network_boot_requirements_all: List<NetworkBootRequirement> = [
  NetworkBootBootSourceOverride,
  NetworkBootClientBootMode,
  NetworkBootServingInfrastructure,
  NetworkBootBootArtifacts,
]

// THE GLOBALLY SHARED SERVICE is the HTTPS boot authority plus a disjoint boot-origin
// bucket. It is not a fleet-wide DHCP or TFTP daemon. A receipt here is evidence for the
// serving-infrastructure axis; it does not by itself establish NetworkBootDelivery.
type FleetBootServiceReceipt {
  https_boot_endpoint: Uri
  origin_custom_domain: Uri
  signing_key_identity: NonEmptyStr
  observation: DeclarationRef
  observed_at: EpochMs
}

type FleetBootServiceStanding
  = FleetBootServiceEstablished { receipt: FleetBootServiceReceipt }
  | FleetBootServicePredecessor { observation: DeclarationRef }
  | FleetBootServiceUnestablished

// DHCP filenames and URLs are routing hints. They never become identity or integrity evidence.
type BootDiscoveryHint
  = DhcpFilenameHint { filename: NonEmptyStr }

// Who answers DHCP is extdeps.provisioning.network_boot DhcpBootDirection
// (NativeDhcpBootOptions | ProxyDhcp). Relay and unobserved are not that
// coproduct: a relay is not an answering server, and unobserved is not a
// direction.
type SiteBootstrapDiscovery
  = SiteAnsweredDhcp { direction: DhcpBootDirection }
  | SiteDhcpRelay
  | SiteDiscoveryUnobserved

type SiteBootstrapTransport
  = ArchitectureChainloader {
      architecture: Architecture
      filename_hint: BootDiscoveryHint
      chainloader_digest: ContentHash
    }

type GlobalHttpsReachability
  = GlobalHttpsEndpointReachable { observation: DeclarationRef, observed_at: EpochMs }
  | GlobalHttpsEndpointUnreachable

type SitePxeEdge {
  site: SiteIdentity
  admitted_architectures: List<Architecture>
  discovery: SiteBootstrapDiscovery
  bootstrap_transport: SiteBootstrapTransport
  global_endpoint_reachability: GlobalHttpsReachability
}

type SitePxeEdgeReceipt {
  edge: SitePxeEdge
  observation: DeclarationRef
  observed_at: EpochMs
}

type SitePxeEdgeStanding
  = SitePxeEdgeEstablished { receipt: SitePxeEdgeReceipt }
  | SitePxeEdgeUnestablished
  | SitePxeEdgeClientArchitectureNotAdmitted { architecture: Architecture }
  | SitePxeEdgeChainloaderMismatch { client: Architecture, chainloader: Architecture }

data first_slice_admitted_architectures: List<Architecture> = [Aarch64]

fn architecture_admitted_on_edge(arch: Architecture, admitted: List<Architecture>) -> Bool {
  admitted |> any(a => a == arch)
}

fn site_pxe_edge_standing(edge: SitePxeEdge, client_architecture: Architecture, observation: DeclarationRef, observed_at: EpochMs) -> SitePxeEdgeStanding {
  match edge.discovery {
    SiteDiscoveryUnobserved => SitePxeEdgeUnestablished
    SiteAnsweredDhcp { direction: _ } => site_pxe_edge_after_discovery(edge: edge, client_architecture: client_architecture, observation: observation, observed_at: observed_at)
    SiteDhcpRelay => site_pxe_edge_after_discovery(edge: edge, client_architecture: client_architecture, observation: observation, observed_at: observed_at)
  }
}

fn site_pxe_edge_after_discovery(edge: SitePxeEdge, client_architecture: Architecture, observation: DeclarationRef, observed_at: EpochMs) -> SitePxeEdgeStanding {
  match edge.global_endpoint_reachability {
    GlobalHttpsEndpointUnreachable => SitePxeEdgeUnestablished
    GlobalHttpsEndpointReachable { observation: _, observed_at: _ } =>
      match edge.bootstrap_transport {
        ArchitectureChainloader { architecture: loader_arch, filename_hint: _, chainloader_digest: _ } =>
          if architecture_admitted_on_edge(arch: client_architecture, admitted: edge.admitted_architectures) == false {
            SitePxeEdgeClientArchitectureNotAdmitted { architecture: client_architecture }
          } else {
            if loader_arch == client_architecture {
              SitePxeEdgeEstablished {
                receipt: SitePxeEdgeReceipt { edge: edge, observation: observation, observed_at: observed_at },
              }
            } else {
              SitePxeEdgeChainloaderMismatch { client: client_architecture, chainloader: loader_arch }
            }
          }
      }
  }
}

// Client firmware class as measured. UefiPxe is not authored here: that upstream variant
// requires a TFTP root this service does not serve.
type ObservedDhcpPxeClient {
  vendor_class: NonEmptyStr
  arch: DhcpProcessorArchitecture
}

type ObservedClientBootModeReceipt {
  target: BootDeliveryTarget
  site: SiteIdentity
  client: ObservedDhcpPxeClient
  observation: DeclarationRef
  observed_at: EpochMs
}

type ObservedClientBootModeStanding
  = ClientBootModeObserved { receipt: ObservedClientBootModeReceipt }
  | ClientBootModePredecessor { observation: DeclarationRef }
  | ClientBootModeUnobserved

type NetworkBootBootControlReceipt {
  target: BootDeliveryTarget
  observation: DeclarationRef
  observed_at: EpochMs
}

type BootControlReceiptStanding
  = BootControlObserved { receipt: NetworkBootBootControlReceipt }
  | BootControlPredecessor { observation: DeclarationRef }
  | BootControlUnobserved

// One canonical signed ticket. Verification of signature and digests is 0D; this slice
// names the identity the later issuer must inhabit.
type SignedBootManifestIdentity {
  target_unit: UnitKey
  attempt_id: IntakeAttemptId
  nonce: NonEmptyStr
  architecture: Architecture
  boot_mode: ClientNetworkBootMode
  chainloader_digest: ContentHash
  kernel_digest: ContentHash
  initrd_digest: ContentHash
  root_digest: ContentHash
  kernel_cmdline: NonEmptyStr
  not_before: EpochMs
  expiry: EpochMs
  signing_key_identity: NonEmptyStr
  callback_identity: NonEmptyStr
}

// Identified is an unsigned identity blob. Only Verified (minted from 0D
// BootManifestAuthentic) can establish the artifacts axis — otherwise an expired
// or MAC-less ticket would join as Established.
type SignedBootManifestStanding
  = SignedBootManifestVerified {
      identity: SignedBootManifestIdentity
      observation: DeclarationRef
      observed_at: EpochMs
    }
  | SignedBootManifestIdentified {
      identity: SignedBootManifestIdentity
      observation: DeclarationRef
      observed_at: EpochMs
    }
  | SignedBootManifestVerificationRefused {
      observation: DeclarationRef
      observed_at: EpochMs
      class: NetworkBootManifestVerificationClass
    }
  | SignedBootManifestAbsent

// The validity window of a signed boot manifest is adjudicated here and only
// here: the broker's redemption and the delivery join both consume it.
fn signed_boot_manifest_window_refusal(identity: SignedBootManifestIdentity, at: EpochMs) -> NetworkBootManifestVerificationClass? {
  if at < identity.not_before {
    Present { value: ManifestVerificationNotYetValid }
  } else if at >= identity.expiry {
    Present { value: ManifestVerificationExpired }
  } else {
    none
  }
}

fn manifest_verification_refused_at(class: NetworkBootManifestVerificationClass, observation: DeclarationRef) -> NetworkBootDeliveryStanding {
  NetworkBootDeliveryManifestRefused { cause: ManifestVerificationRefused { class: class, observation: observation } }
}

type BootstrapTrustObservation {
  observation: DeclarationRef
  observed_at: EpochMs
}

type BootstrapTrustStanding
  = ProductionTrustedBootstrap {
      firmware_https: BootstrapTrustObservation?
      secure_boot_chainloader: BootstrapTrustObservation?
    }
  | ControlledNetworkBootstrap { evidence: BootstrapTrustObservation }
  | BootstrapTrustUnestablished

// HTTPS firmware trust and Secure-Boot-verified chainloader are independently
// observed. Production is minted when at least one ground is present; the
// established receipt keeps both observations so a later reader can tell which
// held. Isolated onboarding is Controlled only when neither firmware ground is
// present — the two production arms are never the same standing as Controlled.
fn bootstrap_trust_standing(
  firmware_https: BootstrapTrustObservation?,
  secure_boot_chainloader: BootstrapTrustObservation?,
  isolated_onboarding_network: BootstrapTrustObservation?,
) -> BootstrapTrustStanding {
  let production = ProductionTrustedBootstrap {
    firmware_https: firmware_https,
    secure_boot_chainloader: secure_boot_chainloader,
  }
  match firmware_https {
    Present { value: _ } => production
    Absent =>
      match secure_boot_chainloader {
        Present { value: _ } => production
        Absent =>
          match isolated_onboarding_network {
            Present { value: e } => ControlledNetworkBootstrap { evidence: e }
            Absent => BootstrapTrustUnestablished
          }
      }
  }
}

type NetworkBootJoinInputs {
  target: BootDeliveryTarget
  expected_site: SiteIdentity
  artifact_digest: ContentHash
  trust: BootstrapTrustStanding
  fleet: FleetBootServiceStanding
  site: SitePxeEdgeStanding
  client: ObservedClientBootModeStanding
  boot_control: BootControlReceiptStanding
  manifest: SignedBootManifestStanding
}

fn join_evidence(requirement: NetworkBootRequirement, observation: DeclarationRef, observed_at: EpochMs) -> NetworkBootRequirementEvidence {
  NetworkBootRequirementEvidence {
    requirement: requirement,
    observation: observation,
    observed_at: observed_at,
  }
}

// 0WET stays unbound this slice: operator 2026-09-18 named Mt. Jade (arriving,
// barebones) as first candidate and Mt. Collins after CD as fallback. No UnitKey
// is minted here.
// Production consumer of this join: BoundBootDeliveryEvidence.network_boot, read
// by gunbc.boot_artifact_delivery pxe_chain_candidate. 0C does not call this
// function: it owns only the site edge and binds NetworkBootJoinInputs.site
// when the first boot offer is observed from the srv4 edge. 0B/0D likewise own
// one receipt family. The mint is the intake assembler that holds fleet + site
// + client + control + SignedBootManifestVerified together.
fn join_network_boot_delivery(inputs: NetworkBootJoinInputs) -> NetworkBootDeliveryStanding {
  match inputs.fleet {
    FleetBootServiceUnestablished => NetworkBootDeliveryUnestablished { missing: [NetworkBootServingInfrastructure] }
    FleetBootServicePredecessor { observation: o } =>
      NetworkBootDeliveryEvidenceRefused { axis: NetworkBootServingInfrastructure, observation: o }
    FleetBootServiceEstablished { receipt: fleet } =>
      match inputs.site {
        SitePxeEdgeUnestablished => NetworkBootDeliverySiteUnestablished
        SitePxeEdgeClientArchitectureNotAdmitted { architecture: a } =>
          NetworkBootDeliveryArchitectureRefused { cause: ClientArchitectureNotAdmitted { architecture: a } }
        SitePxeEdgeChainloaderMismatch { client: c, chainloader: l } =>
          NetworkBootDeliveryArchitectureRefused { cause: ChainloaderMismatch { client: c, chainloader: l } }
        SitePxeEdgeEstablished { receipt: site } =>
          if site_identity_eq(a: site.edge.site, b: inputs.expected_site) == false {
            NetworkBootDeliverySiteMismatch { expected: inputs.expected_site, observed: site.edge.site }
          } else {
          match inputs.client {
            ClientBootModeUnobserved => NetworkBootDeliveryUnestablished { missing: [NetworkBootClientBootMode] }
            ClientBootModePredecessor { observation: o } =>
              NetworkBootDeliveryEvidenceRefused { axis: NetworkBootClientBootMode, observation: o }
            ClientBootModeObserved { receipt: client } =>
              match client.client.arch {
                UefiX86_64 => NetworkBootDeliveryClientModeRefused { arch: UefiX86_64 }
                BiosX86 => NetworkBootDeliveryClientModeRefused { arch: BiosX86 }
                HttpBootX86_64 => NetworkBootDeliveryClientModeRefused { arch: HttpBootX86_64 }
                HttpBootArm64 => NetworkBootDeliveryClientModeRefused { arch: HttpBootArm64 }
                UefiArm64 =>
                  if same_boot_delivery_target(left: client.target, right: inputs.target) == false {
                    NetworkBootDeliveryTargetMismatch { axis: NetworkBootClientBootMode }
                  } else {
                  if site_identity_eq(a: client.site, b: inputs.expected_site) == false {
                    NetworkBootDeliverySiteMismatch { expected: inputs.expected_site, observed: client.site }
                  } else {
                    match inputs.boot_control {
                      BootControlUnobserved => NetworkBootDeliveryUnestablished { missing: [NetworkBootBootSourceOverride] }
                      BootControlPredecessor { observation: o } =>
                        NetworkBootDeliveryEvidenceRefused { axis: NetworkBootBootSourceOverride, observation: o }
                      BootControlObserved { receipt: control } =>
                        if same_boot_delivery_target(left: control.target, right: inputs.target) == false {
                          NetworkBootDeliveryTargetMismatch { axis: NetworkBootBootSourceOverride }
                        } else {
                          match inputs.manifest {
                            SignedBootManifestAbsent => NetworkBootDeliveryUnestablished { missing: [NetworkBootBootArtifacts] }
                            SignedBootManifestIdentified { identity: _, observation: _, observed_at: _ } =>
                              NetworkBootDeliveryManifestRefused { cause: ManifestUnsignedIdentity }
                            SignedBootManifestVerificationRefused { observation: refused_obs, observed_at: _, class: vclass } =>
                              NetworkBootDeliveryManifestRefused {
                                cause: ManifestVerificationRefused { class: vclass, observation: refused_obs },
                              }
                            SignedBootManifestVerified { identity: id, observation: manifest_obs, observed_at: manifest_at } =>
                              join_verified_ticket(
                                inputs: inputs,
                                fleet: fleet,
                                site: site,
                                client: client,
                                control: control,
                                id: id,
                                manifest_obs: manifest_obs,
                                manifest_at: manifest_at,
                              )
                          }
                        }
                    }
                  }
                  }
              }
          }
          }
      }
  }
}

// THE EDGE AND KEY ARE PART OF THE MINT. An Established site receipt can still
// name a chainloader the first slice does not admit, and a verified ticket can
// still name a different digest or signing key than the fleet and edge. Those
// disagreements are refusals here, not a second look at site_pxe_edge_standing.
fn join_verified_ticket(
  inputs: NetworkBootJoinInputs,
  fleet: FleetBootServiceReceipt,
  site: SitePxeEdgeReceipt,
  client: ObservedClientBootModeReceipt,
  control: NetworkBootBootControlReceipt,
  id: SignedBootManifestIdentity,
  manifest_obs: DeclarationRef,
  manifest_at: EpochMs,
) -> NetworkBootDeliveryStanding {
  match inputs.trust {
    BootstrapTrustUnestablished => NetworkBootDeliveryTrustUnestablished
    ProductionTrustedBootstrap { firmware_https: _, secure_boot_chainloader: _ } => join_verified_ticket_after_trust(
      inputs: inputs, fleet: fleet, site: site, client: client, control: control, id: id, manifest_obs: manifest_obs, manifest_at: manifest_at,
    )
    ControlledNetworkBootstrap { evidence: _ } => join_verified_ticket_after_trust(
      inputs: inputs, fleet: fleet, site: site, client: client, control: control, id: id, manifest_obs: manifest_obs, manifest_at: manifest_at,
    )
  }
}

fn join_verified_ticket_after_trust(
  inputs: NetworkBootJoinInputs,
  fleet: FleetBootServiceReceipt,
  site: SitePxeEdgeReceipt,
  client: ObservedClientBootModeReceipt,
  control: NetworkBootBootControlReceipt,
  id: SignedBootManifestIdentity,
  manifest_obs: DeclarationRef,
  manifest_at: EpochMs,
) -> NetworkBootDeliveryStanding {
  match site.edge.bootstrap_transport {
    ArchitectureChainloader { architecture: loader_arch, filename_hint: _, chainloader_digest: loader_digest } =>
      if architecture_admitted_on_edge(arch: loader_arch, admitted: first_slice_admitted_architectures) == false {
        NetworkBootDeliveryArchitectureRefused { cause: LoaderNotAdmittedOnSlice { architecture: loader_arch } }
      } else {
        if architecture_admitted_on_edge(arch: id.architecture, admitted: site.edge.admitted_architectures) == false {
          NetworkBootDeliveryArchitectureRefused { cause: TicketNotAdmittedOnEdge { architecture: id.architecture } }
        } else {
          if architecture_admitted_on_edge(arch: id.architecture, admitted: first_slice_admitted_architectures) == false {
            NetworkBootDeliveryArchitectureRefused { cause: TicketNotAdmittedOnSlice { architecture: id.architecture } }
          } else {
            if content_hash_equal(left: loader_digest, right: id.chainloader_digest) == false {
              NetworkBootDeliveryManifestRefused { cause: ManifestJoinChainloaderDigestDisagrees }
            } else {
              if (fleet.signing_key_identity as String) != (id.signing_key_identity as String) {
                NetworkBootDeliveryManifestRefused { cause: ManifestJoinWrongSigningKey }
              } else {
                if content_hash_equal(left: id.root_digest, right: inputs.artifact_digest) == false {
                  NetworkBootDeliveryManifestRefused { cause: ManifestJoinDigestDisagrees }
                } else {
                  match signed_boot_manifest_window_refusal(identity: id, at: manifest_at) {
                    Present { value: window_class } =>
                      manifest_verification_refused_at(class: window_class, observation: manifest_obs)
                    Absent => {
                      if (id.target_unit as NonEmptyStr) != (inputs.target.subject.subject.unit_key as NonEmptyStr) {
                        NetworkBootDeliveryManifestRefused { cause: ManifestJoinWrongTarget }
                      } else {
                        if (id.attempt_id as NonEmptyStr) != (inputs.target.subject.attempt_id as NonEmptyStr) {
                          NetworkBootDeliveryManifestRefused { cause: ManifestJoinWrongAttempt }
                        } else {
                          match dhcp_client_processor_architecture(arch: id.architecture, mode: id.boot_mode) {
                            Absent => NetworkBootDeliveryManifestRefused { cause: ManifestJoinWrongFirmwareClass }
                            Present { value: ticket_dhcp } =>
                              if ticket_dhcp != client.client.arch {
                                NetworkBootDeliveryManifestRefused { cause: ManifestJoinWrongFirmwareClass }
                              } else {
                          NetworkBootDeliveryEstablished {
                            evidence: NetworkBootDeliveryEstablishment {
                              target: inputs.target,
                              fleet: fleet,
                              site: site,
                              client: client,
                              boot_control: control,
                              manifest: id,
                              trust: inputs.trust,
                              boot_artifacts: join_evidence(requirement: NetworkBootBootArtifacts, observation: manifest_obs, observed_at: manifest_at),
                              artifact_digest: inputs.artifact_digest,
                            },
                          }
                              }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
  }
}
