module gunbc.srv3_host_effect_script

import gunbc.host_effect {
  HostEffect,
  Srv3InstallDiagnosticObserve,
  OsInstallActuatorToolchainEnsure,
  ProvisionBuildCache,
  Srv3InstallReconcileObserve,
  DurableApprovalGrantRecord,
  DurableApprovalGrantRead,
  Srv3InstallMediaFetch,
  Srv3SeededInstallMediaRemaster,
  Srv3SeededInstallMediaToolchainEnsure,
  Srv3SolConsoleCapture,
  Srv3BmcwebSessionLogin,
  Srv3BmcwebTokenExtract,
  Srv3NbdProxyServe,
  Srv3BootOnceReadBackSleep,
  Srv3ReceiptEmit,
  ShellCommand,
  RedfishAction,
  ConvergePlan,
}
import gunbc.shell_bash_runner { shell_exec_via_bash, shell_printf_line }
import gunbc.srv3_os_install_diagnostic {
  srv3_os_install_attempt_intent,
  srv3_install_diagnostic_observe_script_for_intent,
}
import gunbc.srv3_os_install_reconcile_receipt { srv3_install_record_boot_once_approval_script }
import extdeps.bmc.serial_console {
  sol_console_capture_script,
}
import gunbc.srv3_sol_console_intent { srv3_sol_console_capture_intent }
import extdeps.git { git_observe_meta_shell_fragment }
import std.types { String, NonEmptyStr, List, Bool }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data srv3_host_effect_script_dissolution_trigger: String = "🟡 dissolve-on: srv3_host_effect_script — concat-built bash bodies for srv3 observe/effect intents (centralized handler staging post-P5a call-site migration); DISSOLVES WHEN bash-emit (#5828 / shell-emission slice0) realizes srv3 observe/effect intents as typed argv invocations / grammar-emitted nodes and srv3_host_effect_script_for retires without concat-built transport strings. Wave 4 residue (shell→dag census §1C category C). NOT gated on shell_exec_via_bash executor deletion (P5b)."

data srv3_host_effect_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.srv3_host_effect_script",
    decl_name: "srv3_host_effect_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}

fn srv3_install_reconcile_observe_meta_script() -> String {
  concat(
    "printf '%s\\n' \"Srv3InstallObserveReceipt: surface=observed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\nprintf '%s\\n' \"Srv3InstallObserveReceipt: surface=", concat(git_observe_meta_shell_fragment(), "\"\n"),
  )
}

fn srv3_install_reconcile_observe_script(include_git_meta: Bool) -> String {
  let diagnostic = srv3_install_diagnostic_observe_script_for_intent(intent: srv3_os_install_attempt_intent)
  if include_git_meta {
    concat(diagnostic, srv3_install_reconcile_observe_meta_script())
  } else {
    diagnostic
  }
}

fn srv3_join_adjacent_pairs(parts: List<String>) -> List<String> {
  let paired = fold(
    parts,
    init: JoinPairAcc { pending: Absent, joined: [] },
    f: (acc, part) => match acc.pending {
      Absent => JoinPairAcc { pending: Present { value: part }, joined: acc.joined },
      Present { value: left } =>
        JoinPairAcc { pending: Absent, joined: list_push(acc.joined, concat(left, part)) },
    },
  )
  match paired.pending {
    Absent => paired.joined
    Present { value: last } => list_push(paired.joined, last)
  }
}

type JoinPairAcc {
  pending: String?
  joined: List<String>
}

fn srv3_concat_balanced(parts: List<String>) -> String {
  if list_length(items: parts) == 0 {
    ""
  } else if list_length(items: parts) == 1 {
    fold(parts, init: "" as String, f: (acc, part) => concat(acc, part))
  } else {
    srv3_concat_balanced(parts: srv3_join_adjacent_pairs(parts: parts))
  }
}

fn srv3_receipt_emit_script(lines: List<String>) -> String {
  srv3_concat_balanced(
    parts: map(lines, line => shell_printf_line(line: line)),
  )
}

fn srv3_host_effect_script_for(effect: HostEffect) -> String? {
  match effect {
    Srv3InstallReconcileObserve { include_git_meta: meta } =>
      Present {
        value: shell_exec_via_bash(
          body: srv3_install_reconcile_observe_script(include_git_meta: meta),
        ),
      }
    DurableApprovalGrantRecord =>
      Present {
        value: shell_exec_via_bash(body: srv3_install_record_boot_once_approval_script()),
      }
    DurableApprovalGrantRead => Absent
    Srv3InstallMediaFetch => Absent
    Srv3SeededInstallMediaRemaster => Absent
    Srv3SeededInstallMediaToolchainEnsure => Absent
    Srv3SolConsoleCapture =>
      Present {
        value: shell_exec_via_bash(
          body: sol_console_capture_script(intent: srv3_sol_console_capture_intent),
        ),
      }
    Srv3BmcwebSessionLogin => Absent
    Srv3BmcwebTokenExtract => Absent
    Srv3NbdProxyServe { intent: _, lease_key: _ } => Absent
    Srv3BootOnceReadBackSleep => Absent
    Srv3ReceiptEmit { lines: _ } => Absent
    Srv3InstallDiagnosticObserve { bmc: _, port: _, iso_path: _, iso_content_hash: _ } => Absent
    OsInstallActuatorToolchainEnsure {} => Absent
    ProvisionBuildCache { catalog_id: _ } => Absent
    ShellCommand { script: _ } => Absent
    RedfishAction { action: _ } => Absent
    ConvergePlan { policy: _ } => Absent
    SetHostnameCas { hostnamectl_path: _, base: _, desired: _ } => Absent
    ReadEffectivePosixPrincipal {} => Absent
    SudoNopasswdExecuteProbe { command_path: _, check_argv: _ } => Absent
  }
}
