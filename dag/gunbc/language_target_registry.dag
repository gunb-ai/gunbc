data runtime_checker_rows_note: String = "PHANTOM PATHS, CORRECTED (fierce-heron-301, 2026-08-04). These two rows previously read extdeps.rust.cargo and extdeps.python.interpreter with invented decl_names 'cargo' and 'python_interpreter'. Both were FILE PATHS transcribed as module paths: the files are dag/extdeps/rust/cargo.dag and dag/extdeps/python/python.dag, and the modules they declare are extdeps.cargo and extdeps.python. The decl_names named nothing either, so the rows are now at MODULE grain rather than carrying a fabricated declaration. This is the same class as the deleted revision stamp and the DESIGN ts_* count that opened this session — a hand-carried string that looks derived from something real, sitting in an authority, wrong and unfalsifiable by reading it. THE ROWS STAY UNIDENTIFIED, AND THAT IS PENDING RATHER THAN PRINCIPLED: the review's ruling is correct that a checker row's target answers which target the surface REALIZES, not whether the tool IS the language — so cargo belongs to Rust and the interpreter to Python, exactly as run_rust_smoke does. Neither Rust nor Python has a registered subject yet, so binding them here would name an unregistered target and the integrity wall would refuse it, correctly. DISSOLVE-ON: the D0 external subject population lands and these two rows bind."

data runtime_checker_rows: List<LanguageTargetSurfaceRow> = [
  unidentified_module_row(authority: RuntimeChecker, module_path: "extdeps.cargo"),
  unidentified_module_row(authority: RuntimeChecker, module_path: "extdeps.python"),
]

data legacy_frontier_rows: List<LanguageTargetSurfaceRow> = [
  unidentified_module_row(authority: LegacyFrontier, module_path: "gunbc.plans.language_target_self_host_frontier"),
]

fn identified_module_row(
  authority: LanguageTargetSurfaceAuthority,
  module_path: String,
  subject: DeclarationRef
) -> LanguageTargetSurfaceRow {
  LanguageTargetSurfaceRow {
    authority: authority,
    surface: SurfaceModule { module_path: module_path },
    target: Present { value: subject }
  }
}

data bash_join_demonstration_note: String = "The two Bash vocabulary rows below are IDENTIFIED, and they are the registry's only live join today. They matter more than the count: they show the wall distinguishing an accounted-for surface from an unidentified one on REAL rows rather than on fixtures, so a green here is not the vacuous green of a census in which nothing is registered at all. Everything else is unidentified because Bash is the only registered subject any census SURFACE currently names — three subjects are registered, and the other two are targets whose surfaces this census does not yet enumerate at joinable grain, which is a gap in the population rather than in the mechanism."

data target_vocabulary_rows: List<LanguageTargetSurfaceRow> = [
  unidentified_module_row(authority: TargetVocabulary, module_path: "extdeps.languages.typescript.program"),
  identified_module_row(authority: TargetVocabulary, module_path: "v2.extdeps.languages.bash", subject: bash_subject_ref),
  identified_module_row(authority: TargetVocabulary, module_path: "v2.workflow.bash", subject: bash_subject_ref),
]

data language_target_surface_census: List<LanguageTargetSurfaceRow> = concat(
  concat(
    concat(std_language_catalogue_rows, emit_host_execution_rows),
    concat(target_model_declaration_rows, runtime_checker_rows)
  ),
  concat(legacy_frontier_rows, target_vocabulary_rows)
)

data language_target_projection_note: String = "Requirement D, and the rows it makes concrete. Projections are authored only where a compatibility surface actually needs one, so projection count trailing registration count is expected rather than a gap. Bash carries: GNU Bash, .sh/.bash, and legacy_language_id ABSENT — because std.languages has rust, go, python and typescript rows and NO bash row. That absence is the finding, not an omission in this file: the target this repository emits most has never had an entry in the catalogue that was the closest thing to a language key in the tree, which is precisely why a LanguageId could never have served as the identity. legacy_frontier_label carries the name the prose self-host frontier used, so the superseded table's rows can be joined to canonical subjects as they migrate rather than being matched by eye. THE .dag PROJECTION IS THE DISCRIMINATING ONE: a project-grounded target could not be projected at all while the join key was an external subject reference, so its presence here is the executable evidence that the neutral key actually spans both grounding arms rather than the change merely typechecking."

data language_target_projections: List<LanguageTargetProjection> = [
  LanguageTargetProjection {
    subject: bash_subject_ref,
    display_name: "GNU Bash",
    file_extensions: [".sh", ".bash"],
    legacy_language_id: none,
    legacy_frontier_label: Present { value: "bash" }
  },
  LanguageTargetProjection {
    subject: dag_subject_ref,
    display_name: "dag",
    file_extensions: [".dag"],
    legacy_language_id: none,
    legacy_frontier_label: Present { value: "dag" }
  }
]

fn bash_display_name() -> String? {
  display_name_for_subject(subject: bash_subject_ref, projections: language_target_projections)
}

fn dag_display_name() -> String? {
  display_name_for_subject(subject: dag_subject_ref, projections: language_target_projections)
}

fn english_display_name() -> String? {
  display_name_for_subject(subject: english_subject_ref, projections: language_target_projections)
}

fn lookup_language_id(language_id: String) -> LanguageIdLookup {
  language_id_to_subject(language_id: language_id, projections: language_target_projections)
}

fn every_projection_subject_is_registered() -> Bool {
  fold(language_target_projections, init: true, f: fn(acc, p) {
    acc && projection_subject_is_registered(projection: p, registry: registered_language_targets)
  })
}

fn language_target_registry_violations() -> List<LanguageTargetJoinViolation> {
  language_target_join_violations(
    rows: language_target_surface_census,
    registry: registered_language_targets
  )
}

fn surface_census_row_count() -> Int {
  count_rows(rows: language_target_surface_census)
}

fn identified_surface_count() -> Int {
  identified_row_count(
    rows: language_target_surface_census,
    registry: registered_language_targets
  )
}

fn unidentified_surface_count() -> Int {
  missing_identity_violation_count(vs: language_target_registry_violations())
}

fn registry_integrity_violation_count() -> Int {
  integrity_violation_count(vs: language_target_registry_violations())
}

data accounting_wall_note: String = "THE RATCHET: every census row is accounted for — joined to a registered subject, or reported by name in the missing-identity class — as an EXACT equality with no third state. A row naming an unregistered subject falls in neither class and breaks the sum; a violation detector that regressed to reporting nothing drops the remainder to zero while the census stays put and breaks it too. This is the ratchet direction the operator separated from completion: it makes the remainder VISIBLE and COUNTED, and is explicitly NOT evidence that any target is complete. It is also NOT the integrity wall — that is a separate predicate, because summing the two classes is exactly what made the previous single check undiscriminating."

fn registry_accounting_total() -> Bool {
  declared_population_accounting_exact(
    rows: language_target_surface_census,
    registry: registered_language_targets
  )
}

data integrity_wall_note: String = "THE ADMISSION WALL, separate from the ratchet above and required to be exactly zero: no census row may name a subject no registration carries, no surface may be joined to two disagreeing targets, no subject may be registered twice, no locus may appear twice in the census, and no subject may carry two projections. Unlike the accounting ratchet — whose nonzero remainder is the honest starting state — every one of these is malformed input rather than unfinished work, so the correct population for all five is zero now and forever."

fn registry_integrity_holds() -> Bool {
  registry_integrity_clean(
    rows: language_target_surface_census,
    registry: registered_language_targets,
    projections: language_target_projections
  )
}

fn target_vocabulary_row_count() -> Int {
  count_rows(rows: target_vocabulary_rows)
}
