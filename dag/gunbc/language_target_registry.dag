fn identified_module_row(
  authority: LanguageTargetSurfaceAuthority,
  module_path: String,
  subject: ExternalSubjectRef
) -> LanguageTargetSurfaceRow {
  LanguageTargetSurfaceRow {
    authority: authority,
    surface: SurfaceModule { module_path: module_path },
    target: Present { value: subject }
  }
}

data bash_join_demonstration_note: String = "The two Bash vocabulary rows below are IDENTIFIED, and they are the registry's only live join today. They matter more than the count: they show the wall distinguishing an accounted-for surface from an unidentified one on REAL rows rather than on fixtures, so a green here is not the vacuous green of a census in which nothing is registered at all. Everything else is unidentified because Bash is the only subject that exists yet — which is the measurement, not a gap in the mechanism."

data target_vocabulary_rows: List<LanguageTargetSurfaceRow> = [
  unidentified_module_row(authority: TargetVocabulary, module_path: "extdeps.languages.typescript.program"),
  identified_module_row(authority: TargetVocabulary, module_path: "v2.extdeps.languages.bash", subject: bash_subject_ref),
  identified_module_row(authority: TargetVocabulary, module_path: "v2.workflow.bash", subject: bash_subject_ref),
]

data language_target_surface_census: List<LanguageTargetSurfaceRow> = concat(
  concat(
    concat(std_language_catalogue_rows, emit_host_execution_rows),
    concat(target_model_declaration_rows, runtime_checker_rows)
  ),
  concat(legacy_frontier_rows, target_vocabulary_rows)
)

data language_target_projection_note: String = "Requirement D, and the one row it makes concrete. Bash is the only registered subject, so it is the only projection: GNU Bash, .sh/.bash, and legacy_language_id ABSENT — because std.languages has rust, go, python and typescript rows and NO bash row. That absence is the finding, not an omission in this file: the target this repository emits most has never had an entry in the catalogue that was the closest thing to a language key in the tree, which is precisely why a LanguageId could never have served as the identity. legacy_frontier_label carries the name the prose self-host frontier used, so the superseded table's rows can be joined to canonical subjects as they migrate rather than being matched by eye."

data language_target_projections: List<LanguageTargetProjection> = [
  LanguageTargetProjection {
    subject: bash_subject_ref,
    display_name: "GNU Bash",
    file_extensions: [".sh", ".bash"],
    legacy_language_id: none,
    legacy_frontier_label: Present { value: "bash" }
  }
]

fn bash_display_name() -> String? {
  display_name_for_subject(subject: bash_subject_ref, projections: language_target_projections)
}

fn lookup_language_id(language_id: String) -> LanguageIdLookup {
  language_id_to_subject(language_id: language_id, projections: language_target_projections)
}

fn every_projection_subject_is_registered() -> Bool {
  fold(language_target_projections, init: true, f: fn(acc, p) {
    acc && projection_subject_is_registered(projection: p, registry: registered_language_targets)
  })
}

fn language_target_registry_violations() -> List<LanguageTargetJoinViolation> {
  language_target_join_violations(
    rows: language_target_surface_census,
    registry: registered_language_targets
  )
}

fn count_rows(rows: List<LanguageTargetSurfaceRow>) -> Int {
  fold(rows, init: 0, f: fn(acc, r) { acc + 1 })
}

fn count_violations(vs: List<LanguageTargetJoinViolation>) -> Int {
  fold(vs, init: 0, f: fn(acc, v) { acc + 1 })
}

fn surface_census_row_count() -> Int {
  count_rows(rows: language_target_surface_census)
}

fn unidentified_surface_count() -> Int {
  count_violations(vs: language_target_registry_violations())
}

data totality_holds_note: String = "THE WALL: every census row is accounted for — joined to a registered subject, or reported as an exact unidentified row. Because language_target_join_violations emits exactly one violation per row lacking identity and one per row naming an unregistered subject, accounting is total when violations plus identified rows equals the census. This is the ratchet direction the operator separated from completion: it makes the remainder VISIBLE and COUNTED, and is explicitly NOT evidence that any target is complete."

fn registry_accounting_total() -> Bool {
  unidentified_surface_count() <= surface_census_row_count()
    && surface_census_row_count() > 0
}

fn target_vocabulary_row_count() -> Int {
  count_rows(rows: target_vocabulary_rows)
}
