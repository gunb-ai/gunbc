  identified_module_row(authority: TargetModelDeclaration, module_path: "extdeps.languages.lean", subject: lean_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "extdeps.languages.react_jsx", subject: jsx_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.cpp", subject: cpp_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.verilog", subject: verilog_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.wasm", subject: webassembly_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.llvm_ir", subject: llvm_ir_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.ptx", subject: ptx_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.java", subject: java_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.kotlin", subject: kotlin_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.swift", subject: swift_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.ecmascript", subject: ecmascript_language_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.english", subject: english_subject_ref),
  identified_module_row(authority: TargetModelDeclaration, module_path: "extdeps.formats.spice", subject: ngspice_simulator_subject_ref),
  unidentified_module_row(authority: TargetModelDeclaration, module_path: "v2.extdeps.languages.machine_code"),
]

data runtime_checker_subject_note: String = "THE RUNTIME-CHECKER ROWS STAY UNIDENTIFIED ON PURPOSE, and they are the clearest demonstration that this registry keeps language identity separate from toolchain identity. extdeps.rust.cargo names Cargo and extdeps.python.interpreter names a Python interpreter. Neither is a LANGUAGE: Cargo is a build tool governed by the Rust project but versioned and specified separately from the language the Rust Reference defines, and a Python interpreter is an IMPLEMENTATION distinct from the language the PSF reference specifies. Joining either to the Rust or Python language subject would fuse a checker into a language identity — the same class of error machine_code_fusion_note refuses one row up. If this repository ever needs to name a toolchain as a subject, each takes its own cited declaration, and only then can these rows join. Until then the wall correctly reports them as surfaces with no target identity, which is the honest state, not a defect."

data runtime_checker_rows: List<LanguageTargetSurfaceRow> = [
  unidentified_decl_row(authority: RuntimeChecker, module_path: "extdeps.rust.cargo", decl_name: "cargo"),
  unidentified_decl_row(authority: RuntimeChecker, module_path: "extdeps.python.interpreter", decl_name: "python_interpreter"),
]

data legacy_frontier_row_note: String = "The legacy frontier surface stays unidentified because it is a MULTI-TARGET prose table, not a surface belonging to one subject: gunbc.plans.language_target_self_host_frontier carries a row per target for a dozen targets at once. It cannot join a single subject, and the join kernel is right to report it. Its dissolution is the migration of those prose rows onto per-subject carriers — now possible for the first time, because until this change there were no subjects to migrate them ONTO. That migration is not done here; what this change removes is the reason it was blocked. The projections below carry legacy_frontier_label so each prose row can be matched to its canonical subject by name rather than by eye when that work happens."

data legacy_frontier_rows: List<LanguageTargetSurfaceRow> = [
  unidentified_module_row(authority: LegacyFrontier, module_path: "gunbc.plans.language_target_self_host_frontier"),
]

fn identified_decl_row(
  authority: LanguageTargetSurfaceAuthority,
  module_path: String,
  decl_name: String,
  subject: ExternalSubjectRef
) -> LanguageTargetSurfaceRow {
  LanguageTargetSurfaceRow {
    authority: authority,
    surface: SurfaceDeclaration {
      ref: DeclarationRef {
        module_path: module_path,
        decl_name: decl_name,
        field: WholeDeclaration
      }
    },
    target: Present { value: subject }
  }
}

fn identified_module_row(
  authority: LanguageTargetSurfaceAuthority,
  module_path: String,
  subject: ExternalSubjectRef
) -> LanguageTargetSurfaceRow {
  LanguageTargetSurfaceRow {
    authority: authority,
    surface: SurfaceModule { module_path: module_path },
    target: Present { value: subject }
  }
}

data bash_vocabulary_join_note: String = "The two Bash vocabulary rows below are identified, and their significance CHANGED when the other subjects landed (this note previously said Bash was 'the registry's only live join today' and that 'everything else is unidentified because Bash is the only subject that exists yet' — both true when written, both false the moment D0 registered 26 subjects, and left standing they made this module assert its own emptiness while listing a full registry; corrected after review 48113). What these rows demonstrate now is narrower and still worth stating: they are the join for a target whose surfaces are confined by MODULE PREFIX rather than by a target-model declaration, so they exercise the SurfaceModule locus grain against a real registered subject rather than a fixture. The interesting Bash fact today is not that it is the only join — it is the projection two rows down, where GNU Bash is a fully registered, cited subject with NO legacy language id at all, because std.languages carries rust, go, python and typescript rows and no bash row."

data target_vocabulary_rows: List<LanguageTargetSurfaceRow> = [
  identified_module_row(authority: TargetVocabulary, module_path: "extdeps.languages.typescript.program", subject: typescript_language_subject_ref),
  identified_module_row(authority: TargetVocabulary, module_path: "v2.extdeps.languages.bash", subject: gnu_bash_subject_ref),
  identified_module_row(authority: TargetVocabulary, module_path: "v2.workflow.bash", subject: gnu_bash_subject_ref),
]

data language_target_surface_census: List<LanguageTargetSurfaceRow> = concat(
  concat(
    concat(std_language_catalogue_rows, emit_host_execution_rows),
    concat(target_model_declaration_rows, runtime_checker_rows)
  ),
  concat(legacy_frontier_rows, target_vocabulary_rows)
)

data language_target_projection_note: String = "Requirement D. Twenty-four projections, one per external subject, each a set of ATTRIBUTES hanging off the canonical subject rather than a second identity — the direction rule in language_target_projection_law is what makes them safe: projecting a subject to its LanguageId is total, while looking a LanguageId up REFUSES when no registered subject claims it. THE ABSENCES ARE THE FINDINGS AND THEY ARE LOAD-BEARING. legacy_language_id is Present on exactly four rows — rust, go, python, typescript — because std.languages contains exactly those four Language rows; every other registered subject, INCLUDING BASH, has no legacy id at all, which is why a LanguageId could never have served as the identity key for this registry. legacy_frontier_label is absent for html, css, json, yaml, commonmark and jsx because the prose self-host frontier table never carried rows for them: it is a table about compilation targets, and the structured media were outside its scope. Where a label IS carried it is the frontier's exact spelling, including the two rows whose spelling is itself a finding — C and C++ appear there as 'cpp — Phase-0-C' and 'cpp — full C target', two rows of one prose table for what are two DIFFERENT languages under one fused label, and PTX and RISC-V both map to the single label 'machine_code / ptx'. Those fused labels are precisely what per-subject carriers replace."

data language_target_projections: List<LanguageTargetProjection> = [
  LanguageTargetProjection {
    subject: gnu_bash_subject_ref,
    display_name: "GNU Bash",
    file_extensions: [".sh", ".bash"],
    legacy_language_id: none,
    legacy_frontier_label: Present { value: "bash" }
  },
  LanguageTargetProjection {
    subject: rust_language_subject_ref,
