data ngspice_simulator_subject_ref: std.decl_ref.DeclarationRef = ngspice_simulator_model_scope.subject.declaration

data icarus_verilog_simulator_subject_ref: std.decl_ref.DeclarationRef = icarus_verilog_simulator_model_scope.subject.declaration

data target_runtime_binding_note: String = "WHICH RUNTIME EXECUTES A TARGET IS A SEPARATE FACT FROM WHAT THE TARGET IS (cursor review 48122, P0). Fusing them is what made ngspice look like a language: the registry registered the simulator, gave it the netlist's file extensions, and joined it to a surface that models a generic SpiceNetlist. Split here into two subjects plus this binding, so the medium can gain a second runtime without either subject changing — which is the whole test of whether the split was real. A binding is NOT a support claim: it says which tool WOULD execute this target, not that any execution receipt exists. SPICE's frontier row is bar-b, meaning the witness compares emitted text to a golden file and never runs ngspice at all, so this binding is precisely the thing an execution receipt would later discharge. THIS BINDING ALSO CARRIES THE DIALECT FACT, which belongs here and not on either subject's scope (cursor review 48361). SPICE has no normative netlist specification, so the readable authority for the concrete syntax this repository would emit is the ngspice manual — but that manual is ngspice's own governing document, and citing it on the SPICE medium's scope would claim one upstream grounds another. An earlier revision did exactly that and re-forked the fact this split had just separated. The binding is the honest home: it names both subjects by reference, each keeping its own authority, and says which runtime's dialect an emission would target. That is why a support claim for SPICE must resolve THROUGH this binding to state a dialect, rather than reading one off the medium's citation list."

type TargetRuntimeBinding {
  target: std.decl_ref.DeclarationRef
  runtime: std.decl_ref.DeclarationRef
}

data target_runtime_bindings: List<TargetRuntimeBinding> = [
  TargetRuntimeBinding {
    target: spice_netlist_language_subject_ref,
    runtime: ngspice_simulator_subject_ref
  },
  TargetRuntimeBinding {
    target: verilog_language_subject_ref,
    runtime: icarus_verilog_simulator_subject_ref
  }
]

fn target_runtime_binding_count() -> Int {
  fold(target_runtime_bindings, init: 0, f: fn(acc, b) { acc + 1 })
}
data swift_language_subject_ref: std.decl_ref.DeclarationRef = swift_language_model_scope.subject.declaration
data typescript_language_subject_ref: std.decl_ref.DeclarationRef = typescript_language_model_scope.subject.declaration
data verilog_language_subject_ref: std.decl_ref.DeclarationRef = verilog_language_model_scope.subject.declaration
data webassembly_language_subject_ref: std.decl_ref.DeclarationRef = webassembly_language_model_scope.subject.declaration
data yaml_format_subject_ref: std.decl_ref.DeclarationRef = yaml_format_model_scope.subject.declaration

data english_subject_ref: std.decl_ref.DeclarationRef = english_formal_sentence_authority

fn registered_target_count() -> Int {
  fold(registered_language_targets, init: 0, f: fn(a, _r) { a + 1 })
}

fn unidentified_decl_row(
  authority: std.language_target_identity.LanguageTargetSurfaceAuthority,
  module_path: String,
  decl_name: String
) -> std.language_target_identity.LanguageTargetSurfaceRow {
  std.language_target_identity.LanguageTargetSurfaceRow {
    authority: authority,
    surface: std.language_target_identity.SurfaceDeclaration {
      ref: std.decl_ref.DeclarationRef {
        module_path: module_path,
        decl_name: decl_name,
        field: WholeDeclaration
      }
    },
    target: none
  }
}

fn unidentified_module_row(
  authority: std.language_target_identity.LanguageTargetSurfaceAuthority,
  module_path: String
) -> std.language_target_identity.LanguageTargetSurfaceRow {
  std.language_target_identity.LanguageTargetSurfaceRow {
    authority: authority,
    surface: std.language_target_identity.SurfaceModule { module_path: module_path },
    target: none
  }
}

data std_language_catalogue_rows: List<std.language_target_identity.LanguageTargetSurfaceRow> = [
  identified_decl_row(authority: StdLanguageCatalogue, module_path: "std.languages", decl_name: "rust_language", subject: rust_language_subject_ref),
  identified_decl_row(authority: StdLanguageCatalogue, module_path: "std.languages", decl_name: "go_language", subject: go_language_subject_ref),
  identified_decl_row(authority: StdLanguageCatalogue, module_path: "std.languages", decl_name: "python_language", subject: python_language_subject_ref),
  identified_decl_row(authority: StdLanguageCatalogue, module_path: "std.languages", decl_name: "typescript_language", subject: typescript_language_subject_ref),
]

data emit_host_node_smoke_subject_note: String = "run_node_http_serve_smoke joins the ECMASCRIPT subject, not TypeScript, and the distinction is the point. The smoke writes a server.js heredoc and executes it with node; DESIGN describes the same artifact as 'an emitted-JS static server'. So the LANGUAGE OF THE ARTIFACT is JavaScript. Two things this row deliberately does NOT claim: Node.js is the RUNTIME, an independently governed upstream product that would take its own subject if it were ever registered as a target, so it is not fused into this language identity; and this is not evidence that the v2.extdeps.languages.ecmascript MODULE has consumers — measured 2026-08-04, that module still has zero importers anywhere in the tree, exactly as the legacy frontier table says. A surface emitting a language is a different fact from a module being imported, and only the first is what this census row records."

