  }
]

fn bash_display_name() -> String? {
  display_name_for_subject(subject: gnu_bash_subject_ref, projections: language_target_projections)
}

fn dag_display_name() -> String? {
  display_name_for_subject(subject: dag_subject_ref, projections: language_target_projections)
}

fn english_display_name() -> String? {
  display_name_for_subject(subject: english_subject_ref, projections: language_target_projections)
}

fn lookup_language_id(language_id: String) -> std.language_target_identity.LanguageIdLookup {
  language_id_to_subject(language_id: language_id, projections: language_target_projections)
}

fn every_projection_subject_is_registered() -> Bool {
  fold(language_target_projections, init: true, f: fn(acc, p) {
    acc && projection_subject_is_registered(projection: p, registry: registered_language_targets)
  })
}

fn language_target_registry_violations() -> List<std.language_target_identity.LanguageTargetJoinViolation> {
  language_target_join_violations(
    rows: language_target_surface_census,
    registry: registered_language_targets
  )
}

fn surface_census_row_count() -> Int {
  count_rows(rows: language_target_surface_census)
}

fn identified_surface_count() -> Int {
  identified_row_count(
    rows: language_target_surface_census,
    registry: registered_language_targets
  )
}

fn unidentified_surface_count() -> Int {
  missing_identity_violation_count(vs: language_target_registry_violations())
}

fn registry_integrity_violation_count() -> Int {
  integrity_violation_count(vs: language_target_registry_violations())
}

data accounting_wall_note: String = "THE RATCHET: every census row is accounted for — joined to a registered subject, or reported by name in the missing-identity class — as an EXACT equality with no third state. A row naming an unregistered subject falls in neither class and breaks the sum; a violation detector that regressed to reporting nothing drops the remainder to zero while the census stays put and breaks it too. This is the ratchet direction the operator separated from completion: it makes the remainder VISIBLE and COUNTED, and is explicitly NOT evidence that any target is complete. It is also NOT the integrity wall — that is a separate predicate, because summing the two classes is exactly what made the previous single check undiscriminating."

fn registry_accounting_total() -> Bool {
  declared_population_accounting_exact(
    rows: language_target_surface_census,
    registry: registered_language_targets
  )
}

data integrity_wall_note: String = "THE ADMISSION WALL, separate from the ratchet above and required to be exactly zero: no census row may name a subject no registration carries, no surface may be joined to two disagreeing targets, no subject may be registered twice, no locus may appear twice in the census, and no subject may carry two projections. Unlike the accounting ratchet — whose nonzero remainder is the honest starting state — every one of these is malformed input rather than unfinished work, so the correct population for all five is zero now and forever."

fn registry_integrity_holds() -> Bool {
  registry_integrity_clean(
    rows: language_target_surface_census,
    registry: registered_language_targets,
    projections: language_target_projections
  )
}

fn target_vocabulary_row_count() -> Int {
  count_rows(rows: target_vocabulary_rows)
}
