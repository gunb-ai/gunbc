fn bash_display_name() -> String? {
  display_name_for_subject(subject: gnu_bash_subject_ref, projections: language_target_projections)
}

fn lookup_language_id(language_id: String) -> LanguageIdLookup {
  language_id_to_subject(language_id: language_id, projections: language_target_projections)
}

fn every_projection_subject_is_registered() -> Bool {
  fold(language_target_projections, init: true, f: fn(acc, p) {
    acc && projection_subject_is_registered(projection: p, registry: registered_language_targets)
  })
}

fn language_target_registry_violations() -> List<LanguageTargetJoinViolation> {
  language_target_join_violations(
    rows: language_target_surface_census,
    registry: registered_language_targets
  )
}

fn count_rows(rows: List<LanguageTargetSurfaceRow>) -> Int {
  fold(rows, init: 0, f: fn(acc, r) { acc + 1 })
}

fn count_violations(vs: List<LanguageTargetJoinViolation>) -> Int {
  fold(vs, init: 0, f: fn(acc, v) { acc + 1 })
}

fn surface_census_row_count() -> Int {
  count_rows(rows: language_target_surface_census)
}

fn unidentified_surface_count() -> Int {
  count_violations(vs: language_target_registry_violations())
}

data totality_holds_note: String = "THE WALL: every census row is accounted for — joined to a registered subject, or reported as an exact unidentified row. Because language_target_join_violations emits exactly one violation per row lacking identity and one per row naming an unregistered subject, accounting is total when violations plus identified rows equals the census. This is the ratchet direction the operator separated from completion: it makes the remainder VISIBLE and COUNTED, and is explicitly NOT evidence that any target is complete."

fn registry_accounting_total() -> Bool {
  unidentified_surface_count() <= surface_census_row_count()
    && surface_census_row_count() > 0
}

fn target_vocabulary_row_count() -> Int {
  count_rows(rows: target_vocabulary_rows)
}
