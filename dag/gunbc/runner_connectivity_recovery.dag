module gunbc.runner_connectivity_recovery

import std.types { String, NonEmptyStr, Int, Bool, List, Timestamp, Duration, list_length }
import std.disposition { Disposition, SingleAuthority, Scaffold }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import product.placement_supply { HostIdentity }
import gunbc.runner_unit { runner_slot_unit_name }
import gunbc.build_cache_instance {
  RunnerSlotIdentity,
  ProcessIdentity,
}
import gunbc.fleet_intent_network {
  operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4,
}
import gunbc.runner_broker_progress_watchdog {
  RunnerRemoteRegistration,
  RunnerRemoteOnline,
  RunnerRemoteOffline,
  RunnerRemoteAbsent,
  RunnerRemoteBusy,
  HostReachAdmission,
  HostReachAdmitted,
  HostReachRefused,
  RunnerWatchdogInputs,
  RunnerWatchdogVerdict,
  WatchdogHealthy,
  WatchdogRetrying,
  WatchdogWedged,
  WatchdogBusy,
  WatchdogRefused,
  RemoteRegistrationEvidence,
  RemoteRegistrationObserved,
  RemoteRegistrationRefused,
  RemoteRegistrationUnobserved,
  RemoteRegistrationOperatorDeclared,
  BrokerProgressObservation,
  BrokerProgressSilent,
  RunnerWorkerObservation,
  RunnerWorkerAbsent,
  RunnerWorkerAlive,
  ObservedEvidence,
  classify_runner_watchdog_verdict,
  watchdog_replace_predicate_holds,
  reobservation_refuses_mutation,
  RunnerRepairDecisionReceipt,
  remote_evidence_registration,
  remote_registration_is_connected,
  remote_registration_needs_repair,
  remote_registration_is_busy,
  runner_broker_progress_silence_bound_seconds,
}

data runner_connectivity_recovery_scope_disposition: Disposition = SingleAuthority

data runner_connectivity_watchdog_note: String = "PORTS the incident ctrl watchdog into gunbc (operator ruling 2026-08-06). Replace eligibility is the CONJUNCTION: remote registration offline/absent AND broker progress silent beyond the derived ten-minute bound AND no Runner.Worker alive AND registration grace elapsed. Offline-alone and quiet-locally-alone are both unsafe single-signal policies; only the conjunction is safe. Re-read immediately before mutation; fanout is canary-first with per-host cooldown. systemctl restart exit 0 is NOT success."

type RunnerLocalIncarnation {
  slot: RunnerSlotIdentity
  process: ProcessIdentity
  unit: NonEmptyStr
}

type RunnerRemoteObservation {
  evidence: RemoteRegistrationEvidence
  observed_at: Timestamp
  control_plane_error_burst: Bool
}

type RunnerLocalObservation {
  incarnation: RunnerLocalIncarnation
  systemd_active: Bool
  observed_at: Timestamp
}

type RunnerSlotConnectivitySnapshot {
  slot: RunnerSlotIdentity
  local: RunnerLocalObservation
  remote: RunnerRemoteObservation
  broker: BrokerProgressObservation
  worker: RunnerWorkerObservation
  registration_grace_elapsed: Bool
  confirmed_at: Timestamp
  last_restart_at: Timestamp?
}

type HostReachAdmissionRefusedCause { reason: NonEmptyStr }

type RecoveryRunnerReplacementCause
  = RemoteRegistrationOfflineWhileLocalAlive
  | RemoteRegistrationAbsentWhileLocalAlive
  | AcquireJobWedgeSessionDead
  | BrokerProgressWedged { silence_seconds: Duration }

type RunnerRepairRefusalCause
  = RunnerStillConnected
  | RunnerRemotelyBusy
  | RepairBlockedByRunnerWorker
  | BrokerProgressStillRecent { silence_seconds: Duration }
  | RegistrationGraceNotElapsed
  | RemoteEvidenceRefused { reason: NonEmptyStr }
  | RemoteEvidenceUnobserved { reason: NonEmptyStr }
  | ReobservationRefused { reason: NonEmptyStr }
  | LocalProcessNotActive
  | ObservationStale { observed_at: Timestamp, act_at: Timestamp }
  | IncarnationChangedSinceObservation {
      expected: ProcessIdentity,
      found: ProcessIdentity,
    }
  | HostReachAdmissionRefused { reason: NonEmptyStr }
  | RestartCooldownActive { seconds_remaining: Int }
  | ConditionNotPersistentAcrossReobservation
  | ControlPlaneDegraded { reason: NonEmptyStr }
  | CanaryAwaitingVerification
  | HostReplacementCapExceeded { host: HostIdentity, cap: Int }

type RunnerConnectivityAction
  = RunnerConnectedNoop {
      local: RunnerLocalIncarnation,
      remote: RunnerRemoteRegistration,
    }
  | RunnerIncarnationReplace {
      slot: RunnerSlotIdentity,
      from: RunnerLocalIncarnation,
      cause: RecoveryRunnerReplacementCause,
    }
  | RunnerRepairRefused {
      slot: RunnerSlotIdentity,
      cause: RunnerRepairRefusalCause,
    }

type RunnerControlPlaneStanding
  = RunnerControlPlaneHealthy
  | RunnerControlPlaneDegraded {
      offline_slots: Int,
      total_slots: Int,
      reason: NonEmptyStr,
    }

type IncarnationReplacePostcondition
  = ReplaceVerified {
      slot: RunnerSlotIdentity,
      prior: RunnerLocalIncarnation,
      successor: RunnerLocalIncarnation,
      remote: RunnerRemoteRegistration,
    }
  | ReplacePostconditionFailed {
      slot: RunnerSlotIdentity,
      reason: NonEmptyStr,
    }

type FleetConnectivityRepairPlan {
  standing: RunnerControlPlaneStanding
  actions: List<RunnerConnectivityAction>
}

data runner_connectivity_observation_freshness_seconds: Duration = 120

data runner_connectivity_restart_cooldown_seconds: Duration = 300

data runner_connectivity_control_plane_degraded_fraction_threshold: Int = 75

data runner_connectivity_max_replacements_per_host_per_tick: Int = 2

data runner_connectivity_replacement_jitter_basis_note: String = "LIMIT FANOUT (operator ruling 2026-08-06): every host independently restarting several slots on the same two-minute timer boundary would amplify the next incident. Per-host replacement cap is enforced in plan_fleet_connectivity_repair; schedule jitter is a realization concern on the watchdog timer — offsets derive from slot_key hash modulo the tick interval, not a modeled random draw."

data runner_connectivity_rebind_healthy_note: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_standup",
    decl_name: "RunnerSlotHealthy",
    field: WholeDeclaration,
  }
}

data timestamp_comparison_scaffold_note: String = "HONEST SCAFFOLD: Timestamp is String today and this module compares equality only until PR A lands a parsed observation clock. Freshness and cooldown therefore use same-moment equality as the zero-age case in witnesses and refuse when act_at differs from confirmed_at without a parseable ordering — the wall is real, the parser is deferred to the observation carrier."

// THIS WAS THE FORK THAT PROVED THE FORK WAS LIVE. It re-derived the two-digit slot suffix by hand
// -- a rule gunbc.build_cache_instance had ALREADY consolidated after three implementations
// disagreed above index 8 -- and then re-spelled the unit prefix and suffix around it. So the
// watchdog that restarts a wedged runner computed the unit to restart through a different
// derivation than the one that named it, and nothing related the two.
fn recovery_runner_slot_unit_name(slot: RunnerSlotIdentity) -> NonEmptyStr {
  runner_slot_unit_name(slot: slot)
}

fn process_identity_eq(a: ProcessIdentity, b: ProcessIdentity) -> Bool {
  (a.boot_id as String) == (b.boot_id as String)
    && a.pid == b.pid
    && (a.start_time as String) == (b.start_time as String)
}

fn remote_observation_registration(obs: RunnerRemoteObservation) -> RunnerRemoteRegistration? {
  remote_evidence_registration(ev: obs.evidence)
}

fn remote_registration_id_from_evidence(ev: RemoteRegistrationEvidence) -> String {
  match ev {
    RemoteRegistrationObserved { registration_id: id, registration: _, grade: _ } => id
    RemoteRegistrationOperatorDeclared { registration: _, reason: _ } => ""
    RemoteRegistrationUnobserved { reason: _ } => ""
    RemoteRegistrationRefused { reason: _ } => ""
  }
}

fn watchdog_inputs_from_snapshot(
  snap: RunnerSlotConnectivitySnapshot,
  reach: HostReachAdmission,
) -> RunnerWatchdogInputs {
  RunnerWatchdogInputs {
    remote: snap.remote.evidence,
    broker: snap.broker,
    worker: snap.worker,
    registration_grace_elapsed: snap.registration_grace_elapsed,
    reach: reach,
  }
}

fn repair_decision_receipt_from_prior(
  prior: RunnerSlotConnectivitySnapshot,
  act_at: Timestamp,
) -> RunnerRepairDecisionReceipt {
  RunnerRepairDecisionReceipt {
    slot: prior.slot,
    local_process: prior.local.incarnation.process,
    remote_registration_id: remote_registration_id_from_evidence(ev: prior.remote.evidence),
    act_at: prior.confirmed_at,
  }
}

fn replacement_cause_for_watchdog(
  reg: RunnerRemoteRegistration,
  silence_seconds: Duration,
) -> RecoveryRunnerReplacementCause {
  if match reg {
    RunnerRemoteOffline => true
    RunnerRemoteAbsent => true
    RunnerRemoteOnline { runner_name: _, labels: _ } => false
    RunnerRemoteBusy { detail: _ } => false
  } {
    replacement_cause_for_remote(reg: reg)
  } else {
    BrokerProgressWedged { silence_seconds: silence_seconds }
  }
}

fn replacement_cause_for_remote(reg: RunnerRemoteRegistration) -> RecoveryRunnerReplacementCause {
  match reg {
    RunnerRemoteOffline => RemoteRegistrationOfflineWhileLocalAlive
    RunnerRemoteAbsent => RemoteRegistrationAbsentWhileLocalAlive
    RunnerRemoteOnline { runner_name: _, labels: _ } => AcquireJobWedgeSessionDead
    RunnerRemoteBusy { detail: _ } => AcquireJobWedgeSessionDead
  }
}

fn observation_is_fresh(
  observed_at: Timestamp,
  act_at: Timestamp,
  max_staleness_seconds: Duration,
) -> Bool {
  if observed_at != act_at {
    false
  } else {
    max_staleness_seconds >= 0
  }
}

fn restart_cooldown_elapsed(last_restart_at: Timestamp?, act_at: Timestamp) -> Bool {
  match last_restart_at {
    Absent => true
    Present { value: restarted_at } => restarted_at != act_at
  }
}

fn snapshots_have_control_plane_burst(
  snapshots: List<RunnerSlotConnectivitySnapshot>,
) -> Bool {
  fold(
    snapshots,
    init: false,
    f: (acc, s) => acc || s.remote.control_plane_error_burst,
  )
}

fn classify_control_plane_standing(
  snapshots: List<RunnerSlotConnectivitySnapshot>,
  degraded_threshold_percent: Int,
) -> RunnerControlPlaneStanding {
  let total = list_length(items: snapshots)
  let offline = fold(
    snapshots,
    init: 0,
    f: (acc, s) =>
      if match remote_observation_registration(obs: s.remote) {
           Present { value: reg } => remote_registration_needs_repair(reg: reg)
           Absent => false
         } {
        acc + 1
      } else {
        acc
      },
  )
  let burst = snapshots_have_control_plane_burst(snapshots: snapshots)
  if total == 0 {
    RunnerControlPlaneHealthy
  } else {
    let threshold = (total * degraded_threshold_percent) / 100
    if offline > threshold || burst {
      RunnerControlPlaneDegraded {
        offline_slots: offline,
        total_slots: total,
        reason: "common offline or control-plane error burst across the fleet; inhibit fanout and recover canary-first" as NonEmptyStr,
      }
    } else {
      RunnerControlPlaneHealthy
    }
  }
}

fn decide_runner_connectivity_action(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  watchdog: RunnerWatchdogInputs,
  act_at: Timestamp,
  allow_replace: Bool,
) -> RunnerConnectivityAction {
  let slot = snap.slot
  let verdict = classify_runner_watchdog_verdict(
    remote: watchdog.remote,
    broker: watchdog.broker,
    worker: watchdog.worker,
  )
  match watchdog.remote {
    RemoteRegistrationRefused { reason: r } =>
      RunnerRepairRefused { slot: slot, cause: RemoteEvidenceRefused { reason: r } }
    RemoteRegistrationUnobserved { reason: r } =>
      RunnerRepairRefused { slot: slot, cause: RemoteEvidenceUnobserved { reason: r } }
    RemoteRegistrationObserved { registration: _, registration_id: _, grade: _ } =>
      decide_runner_connectivity_for_verdict(
        snap: snap,
        prior: prior,
        watchdog: watchdog,
        act_at: act_at,
        allow_replace: allow_replace,
        verdict: verdict,
      )
    RemoteRegistrationOperatorDeclared { registration: _, reason: _ } =>
      decide_runner_connectivity_for_verdict(
        snap: snap,
        prior: prior,
        watchdog: watchdog,
        act_at: act_at,
        allow_replace: allow_replace,
        verdict: verdict,
      )
  }
}

fn decide_runner_connectivity_for_verdict(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  watchdog: RunnerWatchdogInputs,
  act_at: Timestamp,
  allow_replace: Bool,
  verdict: RunnerWatchdogVerdict,
) -> RunnerConnectivityAction {
  let slot = snap.slot
  match verdict {
    WatchdogHealthy =>
      match remote_evidence_registration(ev: watchdog.remote) {
        Present { value: reg } =>
          RunnerConnectedNoop { local: snap.local.incarnation, remote: reg }
        Absent =>
          RunnerRepairRefused {
            slot: slot,
            cause: RemoteEvidenceUnobserved {
              reason: "healthy verdict without registration payload" as NonEmptyStr,
            },
          }
      }
    WatchdogBusy =>
      RunnerRepairRefused { slot: slot, cause: RepairBlockedByRunnerWorker }
    WatchdogRetrying { silence_seconds: s } =>
      RunnerRepairRefused {
        slot: slot,
        cause: BrokerProgressStillRecent { silence_seconds: s },
      }
    WatchdogRefused { reason: r } =>
      RunnerRepairRefused { slot: slot, cause: RemoteEvidenceRefused { reason: r } }
    WatchdogWedged { silence_seconds: s } =>
      decide_wedged_runner_connectivity_action(
        snap: snap,
        prior: prior,
        watchdog: watchdog,
        act_at: act_at,
        allow_replace: allow_replace,
        silence_seconds: s,
      )
  }
}

fn decide_wedged_runner_connectivity_action(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  watchdog: RunnerWatchdogInputs,
  act_at: Timestamp,
  allow_replace: Bool,
  silence_seconds: Duration,
) -> RunnerConnectivityAction {
  let slot = snap.slot
  if !watchdog.registration_grace_elapsed {
    RunnerRepairRefused { slot: slot, cause: RegistrationGraceNotElapsed }
  } else if !process_identity_eq(
    a: snap.local.incarnation.process,
    b: prior.local.incarnation.process,
  ) {
    RunnerRepairRefused {
      slot: slot,
      cause: IncarnationChangedSinceObservation {
        expected: prior.local.incarnation.process,
        found: snap.local.incarnation.process,
      },
    }
  } else if !observation_is_fresh(
    observed_at: snap.confirmed_at,
    act_at: act_at,
    max_staleness_seconds: runner_connectivity_observation_freshness_seconds,
  ) {
    RunnerRepairRefused {
      slot: slot,
      cause: ObservationStale { observed_at: snap.confirmed_at, act_at: act_at },
    }
  } else if match remote_observation_registration(obs: snap.remote) {
         Present { value: reg } => remote_registration_is_busy(reg: reg)
         Absent => false
       } {
    RunnerRepairRefused { slot: slot, cause: RunnerRemotelyBusy }
  } else if !snap.local.systemd_active {
    RunnerRepairRefused { slot: slot, cause: LocalProcessNotActive }
  } else if match watchdog.reach {
         HostReachRefused { host: _, reason: r } => true
         HostReachAdmitted => false
       } {
    match watchdog.reach {
      HostReachRefused { host: _, reason: r } =>
        RunnerRepairRefused { slot: slot, cause: HostReachAdmissionRefused { reason: r } }
      HostReachAdmitted =>
        RunnerRepairRefused {
          slot: slot,
          cause: RemoteEvidenceRefused {
            reason: "reach refused without reason payload" as NonEmptyStr,
          },
        }
    }
  } else if !restart_cooldown_elapsed(last_restart_at: snap.last_restart_at, act_at: act_at) {
    RunnerRepairRefused {
      slot: slot,
      cause: RestartCooldownActive { seconds_remaining: runner_connectivity_restart_cooldown_seconds },
    }
  } else if !watchdog_replace_predicate_holds(
    remote: watchdog.remote,
    broker: watchdog.broker,
    worker: watchdog.worker,
    registration_grace_elapsed: watchdog.registration_grace_elapsed,
  ) {
    RunnerRepairRefused {
      slot: slot,
      cause: BrokerProgressStillRecent { silence_seconds: silence_seconds },
    }
  } else if !match remote_observation_registration(obs: prior.remote) {
         Present { value: reg } => remote_registration_needs_repair(reg: reg)
         Absent => false
       } {
    RunnerRepairRefused { slot: slot, cause: ConditionNotPersistentAcrossReobservation }
  } else if reobservation_refuses_mutation(
    receipt: repair_decision_receipt_from_prior(prior: prior, act_at: act_at),
    fresh_local_process: snap.local.incarnation.process,
    fresh_remote: watchdog.remote,
    fresh_worker: watchdog.worker,
    fresh_broker: watchdog.broker,
    act_at: act_at,
  ) {
    RunnerRepairRefused {
      slot: slot,
      cause: ReobservationRefused {
        reason: "repair decision stale after re-read; process, registration, worker, or broker progress changed" as NonEmptyStr,
      },
    }
  } else if !allow_replace {
    RunnerRepairRefused { slot: slot, cause: CanaryAwaitingVerification }
  } else {
    match remote_evidence_registration(ev: snap.remote.evidence) {
      Present { value: reg } =>
        RunnerIncarnationReplace {
          slot: slot,
          from: snap.local.incarnation,
          cause: replacement_cause_for_watchdog(reg: reg, silence_seconds: silence_seconds),
        }
      Absent =>
        RunnerRepairRefused {
          slot: slot,
          cause: RemoteEvidenceUnobserved {
            reason: "wedged replace without registration payload" as NonEmptyStr,
          },
        }
    }
  }
}

fn decide_runner_connectivity_action_for_snapshot(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  act_at: Timestamp,
  reach: HostReachAdmission,
  allow_replace: Bool,
) -> RunnerConnectivityAction {
  decide_runner_connectivity_action(
    snap: snap,
    prior: prior,
    watchdog: watchdog_inputs_from_snapshot(snap: snap, reach: reach),
    act_at: act_at,
    allow_replace: allow_replace,
  )
}

fn action_is_replace(action: RunnerConnectivityAction) -> Bool {
  match action {
    RunnerIncarnationReplace { slot: _, from: _, cause: _ } => true
    RunnerConnectedNoop { local: _, remote: _ } => false
    RunnerRepairRefused { slot: _, cause: _ } => false
  }
}

fn action_is_noop(action: RunnerConnectivityAction) -> Bool {
  match action {
    RunnerConnectedNoop { local: _, remote: _ } => true
    RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    RunnerRepairRefused { slot: _, cause: _ } => false
  }
}

fn slot_key(slot: RunnerSlotIdentity) -> String {
  concat(concat(slot.host as String, "-"), slot.slot_index as String)
}

fn plan_allows_replace_for_slot(
  slot: RunnerSlotIdentity,
  standing: RunnerControlPlaneStanding,
  canary_slot: RunnerSlotIdentity,
  canary_verified: Bool,
) -> Bool {
  match standing {
    RunnerControlPlaneHealthy => true
    RunnerControlPlaneDegraded { offline_slots: _, total_slots: _, reason: _ } =>
      if canary_verified {
        true
      } else {
        slot_key(slot: slot) == slot_key(slot: canary_slot)
      }
  }
}

fn plan_slot_connectivity_action(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  act_at: Timestamp,
  reach: HostReachAdmission,
  standing: RunnerControlPlaneStanding,
  canary_slot: RunnerSlotIdentity,
  canary_verified: Bool,
) -> RunnerConnectivityAction {
  decide_runner_connectivity_action_for_snapshot(
    snap: snap,
    prior: prior,
    act_at: act_at,
    reach: reach,
    allow_replace: plan_allows_replace_for_slot(
      slot: snap.slot,
      standing: standing,
      canary_slot: canary_slot,
      canary_verified: canary_verified,
    ),
  )
}

fn verify_incarnation_replace_postcondition(
  slot: RunnerSlotIdentity,
  prior: RunnerLocalIncarnation,
  after_local: RunnerLocalObservation,
  after_remote: RunnerRemoteObservation,
  expected_labels: List<String>,
) -> IncarnationReplacePostcondition {
  if process_identity_eq(a: prior.process, b: after_local.incarnation.process) {
    ReplacePostconditionFailed {
      slot: slot,
      reason: "prior local process identity still present after restart" as NonEmptyStr,
    }
  } else if !after_local.systemd_active {
    ReplacePostconditionFailed {
      slot: slot,
      reason: "successor local process not active after restart" as NonEmptyStr,
    }
  } else {
    match remote_evidence_registration(ev: after_remote.evidence) {
      Present { value: reg } =>
        match reg {
          RunnerRemoteOnline { runner_name: name, labels: labels } =>
            if labels == expected_labels {
              ReplaceVerified {
                slot: slot,
                prior: prior,
                successor: after_local.incarnation,
                remote: RunnerRemoteOnline { runner_name: name, labels: labels },
              }
            } else {
              ReplacePostconditionFailed {
                slot: slot,
                reason: "remote registration online but labels do not match intent" as NonEmptyStr,
              }
            }
          RunnerRemoteOffline =>
            ReplacePostconditionFailed {
              slot: slot,
              reason: "remote registration still offline after restart" as NonEmptyStr,
            }
          RunnerRemoteAbsent =>
            ReplacePostconditionFailed {
              slot: slot,
              reason: "remote registration still absent after restart" as NonEmptyStr,
            }
          RunnerRemoteBusy { detail: _ } =>
            ReplacePostconditionFailed {
              slot: slot,
              reason: "remote registration busy after restart" as NonEmptyStr,
            }
        }
      Absent =>
        ReplacePostconditionFailed {
          slot: slot,
          reason: "remote registration unobserved after restart" as NonEmptyStr,
        }
    }
  }
}

fn host_reach_admission_for_fleet_host(host: HostIdentity) -> HostReachAdmission {
  if (host as String) == (operator_host_srv3 as String)
    || (host as String) == (operator_host_srv4 as String) {
    HostReachRefused {
      host: host,
      reason: "host key login unavailable; located reach refusal while siblings continue" as NonEmptyStr,
    }
  } else {
    HostReachAdmitted
  }
}

type PerHostReplaceBudgetState {
  srv1: Int
  srv2: Int
  srv3: Int
  srv4: Int
}

type ReplaceCapFoldState {
  budgets: PerHostReplaceBudgetState
  out: List<RunnerConnectivityAction>
}

fn initial_per_host_replace_budget(cap: Int) -> PerHostReplaceBudgetState {
  PerHostReplaceBudgetState {
    srv1: cap,
    srv2: cap,
    srv3: cap,
    srv4: cap,
  }
}

fn host_budget_remaining(state: PerHostReplaceBudgetState, host: HostIdentity) -> Int {
  if (host as String) == (operator_host_srv1 as String) {
    state.srv1
  } else if (host as String) == (operator_host_srv2 as String) {
    state.srv2
  } else if (host as String) == (operator_host_srv3 as String) {
    state.srv3
  } else if (host as String) == (operator_host_srv4 as String) {
    state.srv4
  } else {
    0
  }
}

fn decrement_host_budget(
  state: PerHostReplaceBudgetState,
  host: HostIdentity,
) -> PerHostReplaceBudgetState {
  if (host as String) == (operator_host_srv1 as String) {
    PerHostReplaceBudgetState {
      srv1: state.srv1 - 1,
      srv2: state.srv2,
      srv3: state.srv3,
      srv4: state.srv4,
    }
  } else if (host as String) == (operator_host_srv2 as String) {
    PerHostReplaceBudgetState {
      srv1: state.srv1,
      srv2: state.srv2 - 1,
      srv3: state.srv3,
      srv4: state.srv4,
    }
  } else if (host as String) == (operator_host_srv3 as String) {
    PerHostReplaceBudgetState {
      srv1: state.srv1,
      srv2: state.srv2,
      srv3: state.srv3 - 1,
      srv4: state.srv4,
    }
  } else if (host as String) == (operator_host_srv4 as String) {
    PerHostReplaceBudgetState {
      srv1: state.srv1,
      srv2: state.srv2,
      srv3: state.srv3,
      srv4: state.srv4 - 1,
    }
  } else {
    state
  }
}

fn replace_action_slot(action: RunnerConnectivityAction) -> RunnerSlotIdentity? {
  match action {
    RunnerIncarnationReplace { slot: slot, from: _, cause: _ } =>
      Present { value: slot }
    RunnerConnectedNoop { local: _, remote: _ } => Absent
    RunnerRepairRefused { slot: _, cause: _ } => Absent
  }
}

fn cap_exceeded_refusal(slot: RunnerSlotIdentity) -> RunnerConnectivityAction {
  RunnerRepairRefused {
    slot: slot,
    cause: HostReplacementCapExceeded {
      host: slot.host,
      cap: runner_connectivity_max_replacements_per_host_per_tick,
    },
  }
}

fn enforce_per_host_replace_cap(
  actions: List<RunnerConnectivityAction>,
  cap: Int,
) -> List<RunnerConnectivityAction> {
  let folded = fold(
    actions,
    init: ReplaceCapFoldState {
      budgets: initial_per_host_replace_budget(cap: cap),
      out: [],
    },
    f: fn(acc, action) {
      if action_is_replace(action: action) {
        match replace_action_slot(action: action) {
          Present { value: slot } =>
            if host_budget_remaining(state: acc.budgets, host: slot.host) > 0 {
              ReplaceCapFoldState {
                budgets: decrement_host_budget(state: acc.budgets, host: slot.host),
                out: concat(acc.out, [action]),
              }
            } else {
              ReplaceCapFoldState {
                budgets: acc.budgets,
                out: concat(acc.out, [cap_exceeded_refusal(slot: slot)]),
              }
            }
          Absent =>
            ReplaceCapFoldState {
              budgets: acc.budgets,
              out: concat(acc.out, [action]),
            }
        }
      } else {
        ReplaceCapFoldState {
          budgets: acc.budgets,
          out: concat(acc.out, [action]),
        }
      }
    },
  )
  folded.out
}

fn first_snapshot_canary_slot(
  snapshots: List<RunnerSlotConnectivitySnapshot>,
) -> RunnerSlotIdentity? {
  match snapshots.first() {
    Present { value: snap } => Present { value: snap.slot }
    Absent => Absent
  }
}

fn plan_fleet_connectivity_repair(
  snapshots: List<RunnerSlotConnectivitySnapshot>,
  act_at: Timestamp,
  canary_verified: Bool,
) -> FleetConnectivityRepairPlan {
  let standing = classify_control_plane_standing(
    snapshots: snapshots,
    degraded_threshold_percent: runner_connectivity_control_plane_degraded_fraction_threshold,
  )
  let canary = match first_snapshot_canary_slot(snapshots: snapshots) {
    Present { value: slot } => slot
    Absent =>
      RunnerSlotIdentity { host: operator_host_srv1, slot_index: 1 }
  }
  let raw_actions = fold(
    snapshots,
    init: [],
    f: (acc, snap) =>
      concat(acc, [
        plan_slot_connectivity_action(
          snap: snap,
          prior: snap,
          act_at: act_at,
          reach: host_reach_admission_for_fleet_host(host: snap.slot.host),
          standing: standing,
          canary_slot: canary,
          canary_verified: canary_verified,
        ),
      ]),
  )
  FleetConnectivityRepairPlan {
    standing: standing,
    actions: enforce_per_host_replace_cap(
      actions: raw_actions,
      cap: runner_connectivity_max_replacements_per_host_per_tick,
    ),
  }
}

fn count_replace_actions_for_host(
  actions: List<RunnerConnectivityAction>,
  host: HostIdentity,
) -> Int {
  fold(
    actions,
    init: 0,
    f: (acc, action) =>
      if action_is_replace(action: action) {
        match replace_action_slot(action: action) {
          Present { value: slot } =>
            if (slot.host as String) == (host as String) {
              acc + 1
            } else {
              acc
            }
          Absent => acc
        }
      } else {
        acc
      },
  )
}
