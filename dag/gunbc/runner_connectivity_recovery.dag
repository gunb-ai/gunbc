module gunbc.runner_connectivity_recovery


data runner_connectivity_recovery_scope_disposition: std.disposition.Disposition = std.disposition.SingleAuthority

data runner_connectivity_watchdog_note: String = "PORTS the incident ctrl watchdog into gunbc (operator ruling 2026-08-06). Replace eligibility is the CONJUNCTION: remote registration offline/absent AND broker progress silent beyond the derived ten-minute bound AND no Runner.Worker alive AND registration grace elapsed. Offline-alone and quiet-locally-alone are both unsafe single-signal policies; only the conjunction is safe. Re-read immediately before mutation; fanout is canary-first with per-host cooldown. systemctl restart exit 0 is NOT success."

type RunnerLocalIncarnation {
  slot: gunbc.build_cache_instance.RunnerSlotIdentity
  process: gunbc.build_cache_instance.ProcessIdentity
  unit: std.types.NonEmptyStr
}

type RunnerRemoteObservation {
  evidence: gunbc.runner_broker_progress_watchdog.RemoteRegistrationEvidence
  observed_at: std.types.Timestamp
  control_plane_error_burst: Bool
}

type RunnerLocalObservation {
  incarnation: RunnerLocalIncarnation
  systemd_active: Bool
  observed_at: std.types.Timestamp
}

type RunnerSlotConnectivitySnapshot {
  slot: gunbc.build_cache_instance.RunnerSlotIdentity
  local: RunnerLocalObservation
  remote: RunnerRemoteObservation
  broker: gunbc.runner_broker_progress_watchdog.BrokerProgressObservation
  worker: gunbc.runner_broker_progress_watchdog.RunnerWorkerObservation
  registration_grace_elapsed: Bool
  confirmed_at: std.types.Timestamp
  last_restart_at: std.types.Timestamp?
}

type HostReachAdmissionRefusedCause { reason: std.types.NonEmptyStr }

type RecoveryRunnerReplacementCause
  = RemoteRegistrationOfflineWhileLocalAlive
  | RemoteRegistrationAbsentWhileLocalAlive
  | AcquireJobWedgeSessionDead
  | BrokerProgressWedged { silence_seconds: std.types.Duration }

type RunnerRepairRefusalCause
  = RunnerStillConnected
  | RunnerRemotelyBusy
  | RepairBlockedByRunnerWorker
  | BrokerProgressStillRecent { silence_seconds: std.types.Duration }
  | RegistrationGraceNotElapsed
  | RemoteEvidenceRefused { reason: std.types.NonEmptyStr }
  | RemoteEvidenceUnobserved { reason: std.types.NonEmptyStr }
  | ReobservationRefused { reason: std.types.NonEmptyStr }
  | LocalProcessNotActive
  | ObservationStale { observed_at: std.types.Timestamp, act_at: std.types.Timestamp }
  | IncarnationChangedSinceObservation {
      expected: gunbc.build_cache_instance.ProcessIdentity,
      found: gunbc.build_cache_instance.ProcessIdentity,
    }
  | HostReachAdmissionRefused { reason: std.types.NonEmptyStr }
  | RestartCooldownActive { seconds_remaining: Int }
  | ConditionNotPersistentAcrossReobservation
  | ControlPlaneDegraded { reason: std.types.NonEmptyStr }
  | CanaryAwaitingVerification
  | HostReplacementCapExceeded { host: product.placement_supply.HostIdentity, cap: Int }

type RunnerConnectivityAction
  = RunnerConnectedNoop {
      local: RunnerLocalIncarnation,
      remote: gunbc.runner_broker_progress_watchdog.RunnerRemoteRegistration,
    }
  | RunnerIncarnationReplace {
      slot: gunbc.build_cache_instance.RunnerSlotIdentity,
      from: RunnerLocalIncarnation,
      cause: RecoveryRunnerReplacementCause,
    }
  | RunnerRepairRefused {
      slot: gunbc.build_cache_instance.RunnerSlotIdentity,
      cause: RunnerRepairRefusalCause,
    }

type RunnerControlPlaneStanding
  = RunnerControlPlaneHealthy
  | RunnerControlPlaneDegraded {
      offline_slots: Int,
      total_slots: Int,
      reason: std.types.NonEmptyStr,
    }

type IncarnationReplacePostcondition
  = ReplaceVerified {
      slot: gunbc.build_cache_instance.RunnerSlotIdentity,
      prior: RunnerLocalIncarnation,
      successor: RunnerLocalIncarnation,
      remote: gunbc.runner_broker_progress_watchdog.RunnerRemoteRegistration,
    }
  | ReplacePostconditionFailed {
      slot: gunbc.build_cache_instance.RunnerSlotIdentity,
      reason: std.types.NonEmptyStr,
    }

type FleetConnectivityRepairPlan {
  standing: RunnerControlPlaneStanding
  actions: List<RunnerConnectivityAction>
}

data runner_connectivity_observation_freshness_seconds: std.types.Duration = 120

data runner_connectivity_restart_cooldown_seconds: std.types.Duration = 300

data runner_connectivity_control_plane_degraded_fraction_threshold: Int = 75

data runner_connectivity_max_replacements_per_host_per_tick: Int = 2

data runner_connectivity_replacement_jitter_basis_note: String = "LIMIT FANOUT (operator ruling 2026-08-06): every host independently restarting several slots on the same two-minute timer boundary would amplify the next incident. Per-host replacement cap is enforced in plan_fleet_connectivity_repair; schedule jitter is a realization concern on the watchdog timer — offsets derive from slot_key hash modulo the tick interval, not a modeled random draw."

data runner_connectivity_rebind_healthy_note: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_standup",
    decl_name: "RunnerSlotHealthy",
    field: std.decl_ref.WholeDeclaration,
  }
}

data timestamp_comparison_scaffold_note: String = "HONEST SCAFFOLD: Timestamp is String today and this module compares equality only until PR A lands a parsed observation clock. Freshness and cooldown therefore use same-moment equality as the zero-age case in witnesses and refuse when act_at differs from confirmed_at without a parseable ordering — the wall is real, the parser is deferred to the observation carrier."

fn recovery_runner_slot_unit_name(slot: gunbc.build_cache_instance.RunnerSlotIdentity) -> std.types.NonEmptyStr {
  let idx = if slot.slot_index < 10 {
    concat("0", slot.slot_index as String)
  } else {
    slot.slot_index as String
  }
  concat(
    concat(
      concat("actions-runner@", slot.host as String),
      concat("-", idx),
    ),
    ".service",
  ) as std.types.NonEmptyStr
}

fn process_identity_eq(a: gunbc.build_cache_instance.ProcessIdentity, b: gunbc.build_cache_instance.ProcessIdentity) -> Bool {
  (a.boot_id as String) == (b.boot_id as String)
    && a.pid == b.pid
    && (a.start_time as String) == (b.start_time as String)
}

fn remote_observation_registration(obs: RunnerRemoteObservation) -> gunbc.runner_broker_progress_watchdog.RunnerRemoteRegistration? {
  gunbc.runner_broker_progress_watchdog.remote_evidence_registration(ev: obs.evidence)
}

fn remote_registration_id_from_evidence(ev: gunbc.runner_broker_progress_watchdog.RemoteRegistrationEvidence) -> String {
  match ev {
    gunbc.runner_broker_progress_watchdog.RemoteRegistrationObserved { registration_id: id, registration: _, grade: _ } => id
    gunbc.runner_broker_progress_watchdog.RemoteRegistrationOperatorDeclared { registration: _, reason: _ } => ""
    gunbc.runner_broker_progress_watchdog.RemoteRegistrationUnobserved { reason: _ } => ""
    gunbc.runner_broker_progress_watchdog.RemoteRegistrationRefused { reason: _ } => ""
  }
}

fn watchdog_inputs_from_snapshot(
  snap: RunnerSlotConnectivitySnapshot,
  reach: gunbc.runner_broker_progress_watchdog.HostReachAdmission,
) -> gunbc.runner_broker_progress_watchdog.RunnerWatchdogInputs {
  gunbc.runner_broker_progress_watchdog.RunnerWatchdogInputs {
    remote: snap.remote.evidence,
    broker: snap.broker,
    worker: snap.worker,
    registration_grace_elapsed: snap.registration_grace_elapsed,
    reach: reach,
  }
}

fn repair_decision_receipt_from_prior(
  prior: RunnerSlotConnectivitySnapshot,
  act_at: std.types.Timestamp,
) -> gunbc.runner_broker_progress_watchdog.RunnerRepairDecisionReceipt {
  gunbc.runner_broker_progress_watchdog.RunnerRepairDecisionReceipt {
    slot: prior.slot,
    local_process: prior.local.incarnation.process,
    remote_registration_id: remote_registration_id_from_evidence(ev: prior.remote.evidence),
    act_at: prior.confirmed_at,
  }
}

fn replacement_cause_for_watchdog(
  reg: gunbc.runner_broker_progress_watchdog.RunnerRemoteRegistration,
  silence_seconds: std.types.Duration,
) -> RecoveryRunnerReplacementCause {
  if match reg {
    gunbc.runner_broker_progress_watchdog.RunnerRemoteOffline => true
    gunbc.runner_broker_progress_watchdog.RunnerRemoteAbsent => true
    gunbc.runner_broker_progress_watchdog.RunnerRemoteOnline { runner_name: _, labels: _ } => false
    gunbc.runner_broker_progress_watchdog.RunnerRemoteBusy { detail: _ } => false
  } {
    replacement_cause_for_remote(reg: reg)
  } else {
    BrokerProgressWedged { silence_seconds: silence_seconds }
  }
}

fn replacement_cause_for_remote(reg: gunbc.runner_broker_progress_watchdog.RunnerRemoteRegistration) -> RecoveryRunnerReplacementCause {
  match reg {
    gunbc.runner_broker_progress_watchdog.RunnerRemoteOffline => RemoteRegistrationOfflineWhileLocalAlive
    gunbc.runner_broker_progress_watchdog.RunnerRemoteAbsent => RemoteRegistrationAbsentWhileLocalAlive
    gunbc.runner_broker_progress_watchdog.RunnerRemoteOnline { runner_name: _, labels: _ } => AcquireJobWedgeSessionDead
    gunbc.runner_broker_progress_watchdog.RunnerRemoteBusy { detail: _ } => AcquireJobWedgeSessionDead
  }
}

fn observation_is_fresh(
  observed_at: std.types.Timestamp,
  act_at: std.types.Timestamp,
  max_staleness_seconds: std.types.Duration,
) -> Bool {
  if observed_at != act_at {
    false
  } else {
    max_staleness_seconds >= 0
  }
}

fn restart_cooldown_elapsed(last_restart_at: std.types.Timestamp?, act_at: std.types.Timestamp) -> Bool {
  match last_restart_at {
    Absent => true
    Present { value: restarted_at } => restarted_at != act_at
  }
}

fn snapshots_have_control_plane_burst(
  snapshots: List<RunnerSlotConnectivitySnapshot>,
) -> Bool {
  fold(
    snapshots,
    init: false,
    f: (acc, s) => acc || s.remote.control_plane_error_burst,
  )
}

fn classify_control_plane_standing(
  snapshots: List<RunnerSlotConnectivitySnapshot>,
  degraded_threshold_percent: Int,
) -> RunnerControlPlaneStanding {
  let total = std.types.list_length(items: snapshots)
  let offline = fold(
    snapshots,
    init: 0,
    f: (acc, s) =>
      if match remote_observation_registration(obs: s.remote) {
           Present { value: reg } => gunbc.runner_broker_progress_watchdog.remote_registration_needs_repair(reg: reg)
           Absent => false
         } {
        acc + 1
      } else {
        acc
      },
  )
  let burst = snapshots_have_control_plane_burst(snapshots: snapshots)
  if total == 0 {
    RunnerControlPlaneHealthy
  } else {
    let threshold = (total * degraded_threshold_percent) / 100
    if offline > threshold || burst {
      RunnerControlPlaneDegraded {
        offline_slots: offline,
        total_slots: total,
        reason: "common offline or control-plane error burst across the fleet; inhibit fanout and recover canary-first" as std.types.NonEmptyStr,
      }
    } else {
      RunnerControlPlaneHealthy
    }
  }
}

fn decide_runner_connectivity_action(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  watchdog: gunbc.runner_broker_progress_watchdog.RunnerWatchdogInputs,
  act_at: std.types.Timestamp,
  allow_replace: Bool,
) -> RunnerConnectivityAction {
  let slot = snap.slot
  let verdict = gunbc.runner_broker_progress_watchdog.classify_runner_watchdog_verdict(
    remote: watchdog.remote,
    broker: watchdog.broker,
    worker: watchdog.worker,
  )
  match watchdog.remote {
    gunbc.runner_broker_progress_watchdog.RemoteRegistrationRefused { reason: r } =>
      RunnerRepairRefused { slot: slot, cause: RemoteEvidenceRefused { reason: r } }
    gunbc.runner_broker_progress_watchdog.RemoteRegistrationUnobserved { reason: r } =>
      RunnerRepairRefused { slot: slot, cause: RemoteEvidenceUnobserved { reason: r } }
    gunbc.runner_broker_progress_watchdog.RemoteRegistrationObserved { registration: _, registration_id: _, grade: _ } =>
      decide_runner_connectivity_for_verdict(
        snap: snap,
        prior: prior,
        watchdog: watchdog,
        act_at: act_at,
        allow_replace: allow_replace,
        verdict: verdict,
      )
    gunbc.runner_broker_progress_watchdog.RemoteRegistrationOperatorDeclared { registration: _, reason: _ } =>
      decide_runner_connectivity_for_verdict(
        snap: snap,
        prior: prior,
        watchdog: watchdog,
        act_at: act_at,
        allow_replace: allow_replace,
        verdict: verdict,
      )
  }
}

fn decide_runner_connectivity_for_verdict(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  watchdog: gunbc.runner_broker_progress_watchdog.RunnerWatchdogInputs,
  act_at: std.types.Timestamp,
  allow_replace: Bool,
  verdict: gunbc.runner_broker_progress_watchdog.RunnerWatchdogVerdict,
) -> RunnerConnectivityAction {
  let slot = snap.slot
  match verdict {
    gunbc.runner_broker_progress_watchdog.WatchdogHealthy =>
      match gunbc.runner_broker_progress_watchdog.remote_evidence_registration(ev: watchdog.remote) {
        Present { value: reg } =>
          RunnerConnectedNoop { local: snap.local.incarnation, remote: reg }
        Absent =>
          RunnerRepairRefused {
            slot: slot,
            cause: RemoteEvidenceUnobserved {
              reason: "healthy verdict without registration payload" as std.types.NonEmptyStr,
            },
          }
      }
    gunbc.runner_broker_progress_watchdog.WatchdogBusy =>
      RunnerRepairRefused { slot: slot, cause: RepairBlockedByRunnerWorker }
    gunbc.runner_broker_progress_watchdog.WatchdogRetrying { silence_seconds: s } =>
      RunnerRepairRefused {
        slot: slot,
        cause: BrokerProgressStillRecent { silence_seconds: s },
      }
    gunbc.runner_broker_progress_watchdog.WatchdogRefused { reason: r } =>
      RunnerRepairRefused { slot: slot, cause: RemoteEvidenceRefused { reason: r } }
    gunbc.runner_broker_progress_watchdog.WatchdogWedged { silence_seconds: s } =>
      decide_wedged_runner_connectivity_action(
        snap: snap,
        prior: prior,
        watchdog: watchdog,
        act_at: act_at,
        allow_replace: allow_replace,
        silence_seconds: s,
      )
  }
}

fn decide_wedged_runner_connectivity_action(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  watchdog: gunbc.runner_broker_progress_watchdog.RunnerWatchdogInputs,
  act_at: std.types.Timestamp,
  allow_replace: Bool,
  silence_seconds: std.types.Duration,
) -> RunnerConnectivityAction {
  let slot = snap.slot
  if !watchdog.registration_grace_elapsed {
    RunnerRepairRefused { slot: slot, cause: RegistrationGraceNotElapsed }
  } else if !process_identity_eq(
    a: snap.local.incarnation.process,
    b: prior.local.incarnation.process,
  ) {
    RunnerRepairRefused {
      slot: slot,
      cause: IncarnationChangedSinceObservation {
        expected: prior.local.incarnation.process,
        found: snap.local.incarnation.process,
      },
    }
  } else if !observation_is_fresh(
    observed_at: snap.confirmed_at,
    act_at: act_at,
    max_staleness_seconds: runner_connectivity_observation_freshness_seconds,
  ) {
    RunnerRepairRefused {
      slot: slot,
      cause: ObservationStale { observed_at: snap.confirmed_at, act_at: act_at },
    }
  } else if match remote_observation_registration(obs: snap.remote) {
         Present { value: reg } => gunbc.runner_broker_progress_watchdog.remote_registration_is_busy(reg: reg)
         Absent => false
       } {
    RunnerRepairRefused { slot: slot, cause: RunnerRemotelyBusy }
  } else if !snap.local.systemd_active {
    RunnerRepairRefused { slot: slot, cause: LocalProcessNotActive }
  } else if match watchdog.reach {
         gunbc.runner_broker_progress_watchdog.HostReachRefused { host: _, reason: r } => true
         gunbc.runner_broker_progress_watchdog.HostReachAdmitted => false
       } {
    match watchdog.reach {
      gunbc.runner_broker_progress_watchdog.HostReachRefused { host: _, reason: r } =>
        RunnerRepairRefused { slot: slot, cause: HostReachAdmissionRefused { reason: r } }
      gunbc.runner_broker_progress_watchdog.HostReachAdmitted =>
        RunnerRepairRefused {
          slot: slot,
          cause: RemoteEvidenceRefused {
            reason: "reach refused without reason payload" as std.types.NonEmptyStr,
          },
        }
    }
  } else if !restart_cooldown_elapsed(last_restart_at: snap.last_restart_at, act_at: act_at) {
    RunnerRepairRefused {
      slot: slot,
      cause: RestartCooldownActive { seconds_remaining: runner_connectivity_restart_cooldown_seconds },
    }
  } else if !gunbc.runner_broker_progress_watchdog.watchdog_replace_predicate_holds(
    remote: watchdog.remote,
    broker: watchdog.broker,
    worker: watchdog.worker,
    registration_grace_elapsed: watchdog.registration_grace_elapsed,
  ) {
    RunnerRepairRefused {
      slot: slot,
      cause: BrokerProgressStillRecent { silence_seconds: silence_seconds },
    }
  } else if !match remote_observation_registration(obs: prior.remote) {
         Present { value: reg } => gunbc.runner_broker_progress_watchdog.remote_registration_needs_repair(reg: reg)
         Absent => false
       } {
    RunnerRepairRefused { slot: slot, cause: ConditionNotPersistentAcrossReobservation }
  } else if gunbc.runner_broker_progress_watchdog.reobservation_refuses_mutation(
    receipt: repair_decision_receipt_from_prior(prior: prior, act_at: act_at),
    fresh_local_process: snap.local.incarnation.process,
    fresh_remote: watchdog.remote,
    fresh_worker: watchdog.worker,
    fresh_broker: watchdog.broker,
    act_at: act_at,
  ) {
    RunnerRepairRefused {
      slot: slot,
      cause: ReobservationRefused {
        reason: "repair decision stale after re-read; process, registration, worker, or broker progress changed" as std.types.NonEmptyStr,
      },
    }
  } else if !allow_replace {
    RunnerRepairRefused { slot: slot, cause: CanaryAwaitingVerification }
  } else {
    match gunbc.runner_broker_progress_watchdog.remote_evidence_registration(ev: snap.remote.evidence) {
      Present { value: reg } =>
        RunnerIncarnationReplace {
          slot: slot,
          from: snap.local.incarnation,
          cause: replacement_cause_for_watchdog(reg: reg, silence_seconds: silence_seconds),
        }
      Absent =>
        RunnerRepairRefused {
          slot: slot,
          cause: RemoteEvidenceUnobserved {
            reason: "wedged replace without registration payload" as std.types.NonEmptyStr,
          },
        }
    }
  }
}

fn decide_runner_connectivity_action_for_snapshot(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  act_at: std.types.Timestamp,
  reach: gunbc.runner_broker_progress_watchdog.HostReachAdmission,
  allow_replace: Bool,
) -> RunnerConnectivityAction {
  decide_runner_connectivity_action(
    snap: snap,
    prior: prior,
    watchdog: watchdog_inputs_from_snapshot(snap: snap, reach: reach),
    act_at: act_at,
    allow_replace: allow_replace,
  )
}

fn action_is_replace(action: RunnerConnectivityAction) -> Bool {
  match action {
    RunnerIncarnationReplace { slot: _, from: _, cause: _ } => true
    RunnerConnectedNoop { local: _, remote: _ } => false
    RunnerRepairRefused { slot: _, cause: _ } => false
  }
}

fn action_is_noop(action: RunnerConnectivityAction) -> Bool {
  match action {
    RunnerConnectedNoop { local: _, remote: _ } => true
    RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    RunnerRepairRefused { slot: _, cause: _ } => false
  }
}

fn slot_key(slot: gunbc.build_cache_instance.RunnerSlotIdentity) -> String {
  concat(concat(slot.host as String, "-"), slot.slot_index as String)
}

fn plan_allows_replace_for_slot(
  slot: gunbc.build_cache_instance.RunnerSlotIdentity,
  standing: RunnerControlPlaneStanding,
  canary_slot: gunbc.build_cache_instance.RunnerSlotIdentity,
  canary_verified: Bool,
) -> Bool {
  match standing {
    RunnerControlPlaneHealthy => true
    RunnerControlPlaneDegraded { offline_slots: _, total_slots: _, reason: _ } =>
      if canary_verified {
        true
      } else {
        slot_key(slot: slot) == slot_key(slot: canary_slot)
      }
  }
}

fn plan_slot_connectivity_action(
  snap: RunnerSlotConnectivitySnapshot,
  prior: RunnerSlotConnectivitySnapshot,
  act_at: std.types.Timestamp,
  reach: gunbc.runner_broker_progress_watchdog.HostReachAdmission,
  standing: RunnerControlPlaneStanding,
  canary_slot: gunbc.build_cache_instance.RunnerSlotIdentity,
  canary_verified: Bool,
) -> RunnerConnectivityAction {
  decide_runner_connectivity_action_for_snapshot(
    snap: snap,
    prior: prior,
    act_at: act_at,
    reach: reach,
    allow_replace: plan_allows_replace_for_slot(
      slot: snap.slot,
      standing: standing,
      canary_slot: canary_slot,
      canary_verified: canary_verified,
    ),
  )
}

fn verify_incarnation_replace_postcondition(
  slot: gunbc.build_cache_instance.RunnerSlotIdentity,
  prior: RunnerLocalIncarnation,
  after_local: RunnerLocalObservation,
  after_remote: RunnerRemoteObservation,
  expected_labels: List<String>,
) -> IncarnationReplacePostcondition {
  if process_identity_eq(a: prior.process, b: after_local.incarnation.process) {
    ReplacePostconditionFailed {
      slot: slot,
      reason: "prior local process identity still present after restart" as std.types.NonEmptyStr,
    }
  } else if !after_local.systemd_active {
    ReplacePostconditionFailed {
      slot: slot,
      reason: "successor local process not active after restart" as std.types.NonEmptyStr,
    }
  } else {
    match gunbc.runner_broker_progress_watchdog.remote_evidence_registration(ev: after_remote.evidence) {
      Present { value: reg } =>
        match reg {
          gunbc.runner_broker_progress_watchdog.RunnerRemoteOnline { runner_name: name, labels: labels } =>
            if labels == expected_labels {
              ReplaceVerified {
                slot: slot,
                prior: prior,
                successor: after_local.incarnation,
                remote: gunbc.runner_broker_progress_watchdog.RunnerRemoteOnline { runner_name: name, labels: labels },
              }
            } else {
              ReplacePostconditionFailed {
                slot: slot,
                reason: "remote registration online but labels do not match intent" as std.types.NonEmptyStr,
              }
            }
          gunbc.runner_broker_progress_watchdog.RunnerRemoteOffline =>
            ReplacePostconditionFailed {
              slot: slot,
              reason: "remote registration still offline after restart" as std.types.NonEmptyStr,
            }
          gunbc.runner_broker_progress_watchdog.RunnerRemoteAbsent =>
            ReplacePostconditionFailed {
              slot: slot,
              reason: "remote registration still absent after restart" as std.types.NonEmptyStr,
            }
          gunbc.runner_broker_progress_watchdog.RunnerRemoteBusy { detail: _ } =>
            ReplacePostconditionFailed {
              slot: slot,
              reason: "remote registration busy after restart" as std.types.NonEmptyStr,
            }
        }
      Absent =>
        ReplacePostconditionFailed {
          slot: slot,
          reason: "remote registration unobserved after restart" as std.types.NonEmptyStr,
        }
    }
  }
}

fn host_reach_admission_for_fleet_host(host: product.placement_supply.HostIdentity) -> gunbc.runner_broker_progress_watchdog.HostReachAdmission {
  if (host as String) == (gunbc.fleet_intent_network.operator_host_srv3 as String)
    || (host as String) == (gunbc.fleet_intent_network.operator_host_srv4 as String) {
    gunbc.runner_broker_progress_watchdog.HostReachRefused {
      host: host,
      reason: "host key login unavailable; located reach refusal while siblings continue" as std.types.NonEmptyStr,
    }
  } else {
    gunbc.runner_broker_progress_watchdog.HostReachAdmitted
  }
}

type PerHostReplaceBudgetState {
  srv1: Int
  srv2: Int
  srv3: Int
  srv4: Int
}

type ReplaceCapFoldState {
  budgets: PerHostReplaceBudgetState
  out: List<RunnerConnectivityAction>
}

fn initial_per_host_replace_budget(cap: Int) -> PerHostReplaceBudgetState {
  PerHostReplaceBudgetState {
    srv1: cap,
    srv2: cap,
    srv3: cap,
    srv4: cap,
  }
}

fn host_budget_remaining(state: PerHostReplaceBudgetState, host: product.placement_supply.HostIdentity) -> Int {
  if (host as String) == (gunbc.fleet_intent_network.operator_host_srv1 as String) {
    state.srv1
  } else if (host as String) == (gunbc.fleet_intent_network.operator_host_srv2 as String) {
    state.srv2
  } else if (host as String) == (gunbc.fleet_intent_network.operator_host_srv3 as String) {
    state.srv3
  } else if (host as String) == (gunbc.fleet_intent_network.operator_host_srv4 as String) {
    state.srv4
  } else {
    0
  }
}

fn decrement_host_budget(
  state: PerHostReplaceBudgetState,
  host: product.placement_supply.HostIdentity,
) -> PerHostReplaceBudgetState {
  if (host as String) == (gunbc.fleet_intent_network.operator_host_srv1 as String) {
    PerHostReplaceBudgetState {
      srv1: state.srv1 - 1,
      srv2: state.srv2,
      srv3: state.srv3,
      srv4: state.srv4,
    }
  } else if (host as String) == (gunbc.fleet_intent_network.operator_host_srv2 as String) {
    PerHostReplaceBudgetState {
      srv1: state.srv1,
      srv2: state.srv2 - 1,
      srv3: state.srv3,
      srv4: state.srv4,
    }
  } else if (host as String) == (gunbc.fleet_intent_network.operator_host_srv3 as String) {
    PerHostReplaceBudgetState {
      srv1: state.srv1,
      srv2: state.srv2,
      srv3: state.srv3 - 1,
      srv4: state.srv4,
    }
  } else if (host as String) == (gunbc.fleet_intent_network.operator_host_srv4 as String) {
    PerHostReplaceBudgetState {
      srv1: state.srv1,
      srv2: state.srv2,
      srv3: state.srv3,
      srv4: state.srv4 - 1,
    }
  } else {
    state
  }
}

fn replace_action_slot(action: RunnerConnectivityAction) -> gunbc.build_cache_instance.RunnerSlotIdentity? {
  match action {
    RunnerIncarnationReplace { slot: slot, from: _, cause: _ } =>
      Present { value: slot }
    RunnerConnectedNoop { local: _, remote: _ } => Absent
    RunnerRepairRefused { slot: _, cause: _ } => Absent
  }
}

fn cap_exceeded_refusal(slot: gunbc.build_cache_instance.RunnerSlotIdentity) -> RunnerConnectivityAction {
  RunnerRepairRefused {
    slot: slot,
    cause: HostReplacementCapExceeded {
      host: slot.host,
      cap: runner_connectivity_max_replacements_per_host_per_tick,
    },
  }
}

fn enforce_per_host_replace_cap(
  actions: List<RunnerConnectivityAction>,
  cap: Int,
) -> List<RunnerConnectivityAction> {
  let folded = fold(
    actions,
    init: ReplaceCapFoldState {
      budgets: initial_per_host_replace_budget(cap: cap),
      out: [],
    },
    f: fn(acc, action) {
      if action_is_replace(action: action) {
        match replace_action_slot(action: action) {
          Present { value: slot } =>
            if host_budget_remaining(state: acc.budgets, host: slot.host) > 0 {
              ReplaceCapFoldState {
                budgets: decrement_host_budget(state: acc.budgets, host: slot.host),
                out: concat(acc.out, [action]),
              }
            } else {
              ReplaceCapFoldState {
                budgets: acc.budgets,
                out: concat(acc.out, [cap_exceeded_refusal(slot: slot)]),
              }
            }
          Absent =>
            ReplaceCapFoldState {
              budgets: acc.budgets,
              out: concat(acc.out, [action]),
            }
        }
      } else {
        ReplaceCapFoldState {
          budgets: acc.budgets,
          out: concat(acc.out, [action]),
        }
      }
    },
  )
  folded.out
}

fn first_snapshot_canary_slot(
  snapshots: List<RunnerSlotConnectivitySnapshot>,
) -> gunbc.build_cache_instance.RunnerSlotIdentity? {
  match snapshots.first() {
    Present { value: snap } => Present { value: snap.slot }
    Absent => Absent
  }
}

fn plan_fleet_connectivity_repair(
  snapshots: List<RunnerSlotConnectivitySnapshot>,
  act_at: std.types.Timestamp,
  canary_verified: Bool,
) -> FleetConnectivityRepairPlan {
  let standing = classify_control_plane_standing(
    snapshots: snapshots,
    degraded_threshold_percent: runner_connectivity_control_plane_degraded_fraction_threshold,
  )
  let canary = match first_snapshot_canary_slot(snapshots: snapshots) {
    Present { value: slot } => slot
    Absent =>
      gunbc.build_cache_instance.RunnerSlotIdentity { host: gunbc.fleet_intent_network.operator_host_srv1, slot_index: 1 }
  }
  let raw_actions = fold(
    snapshots,
    init: [],
    f: (acc, snap) =>
      concat(acc, [
        plan_slot_connectivity_action(
          snap: snap,
          prior: snap,
          act_at: act_at,
          reach: host_reach_admission_for_fleet_host(host: snap.slot.host),
          standing: standing,
          canary_slot: canary,
          canary_verified: canary_verified,
        ),
      ]),
  )
  FleetConnectivityRepairPlan {
    standing: standing,
    actions: enforce_per_host_replace_cap(
      actions: raw_actions,
      cap: runner_connectivity_max_replacements_per_host_per_tick,
    ),
  }
}

fn count_replace_actions_for_host(
  actions: List<RunnerConnectivityAction>,
  host: product.placement_supply.HostIdentity,
) -> Int {
  fold(
    actions,
    init: 0,
    f: (acc, action) =>
      if action_is_replace(action: action) {
        match replace_action_slot(action: action) {
          Present { value: slot } =>
            if (slot.host as String) == (host as String) {
              acc + 1
            } else {
              acc
            }
          Absent => acc
        }
      } else {
        acc
      },
  )
}
