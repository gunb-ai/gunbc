module gunbc.ci_deploy_access_observe


fn deploy_access_privileged_probe_step(cmd: gunbc.ci_deploy_access.PrivilegedCommand) -> EffectPlanStep<gunbc.host_effect.HostEffect> {
  v2.std.effect_plan.Do { effect: deploy_access_sudo_probe_effect(cmd: cmd) }
}

fn deploy_access_principal_probe_step() -> EffectPlanStep<gunbc.host_effect.HostEffect> {
  v2.std.effect_plan.Do { effect: deploy_access_read_principal_effect() }
}

fn deploy_access_preflight_probe_steps(access: gunbc.ci_deploy_access.DeployAccess) -> List<EffectPlanStep<gunbc.host_effect.HostEffect>> {
  let with_whoami = v2.std.algebra.list_snoc_item(xs: [], item: deploy_access_principal_probe_step())
  v2.std.algebra.fold_list(
    xs: access.privileged_commands,
    empty: with_whoami,
    cons: (acc, cmd) => v2.std.algebra.list_snoc_item(xs: acc, item: deploy_access_privileged_probe_step(cmd: cmd))
  )
}

fn deploy_access_preflight_plan(access: gunbc.ci_deploy_access.DeployAccess) -> EffectPlan<gunbc.host_effect.HostEffect> {
  v2.std.effect_plan.EffectPlan {
    steps: deploy_access_preflight_probe_steps(access: access),
    on_failure: FailFast,
  }
}

fn deploy_mutation_gate_observed(access: gunbc.ci_deploy_access.DeployAccess) -> std.access.AccessDecision {
  let proof = deploy_target_proof_from_access(access: access)
  let host_decision = deploy_target_host_check_observed(proof: proof)
  let access_decision = deploy_access_check_observed(access: access)
  decision_meet(a: host_decision, b: access_decision)
}

fn deploy_mutation_gate(
  access: gunbc.ci_deploy_access.DeployAccess,
  fixture_actor: gunbc.ci_deploy_access.DeployAccessActor?,
  fixture_host: gunbc.ci_deploy_target_host.DeployTargetHostObservation?
) -> std.access.AccessDecision {
  let proof = deploy_target_proof_from_access(access: access)
  let host_decision = match fixture_host {
    Present { value: obs } => deploy_target_host_check(proof: proof, observed: obs)
    Absent => deploy_target_host_check_observed(proof: proof)
  }
  let access_decision = match fixture_actor {
    Present { value: actor } => deploy_access_check(access: access, actor: actor)
    Absent => deploy_access_check_observed(access: access)
  }
  decision_meet(a: host_decision, b: access_decision)
}
