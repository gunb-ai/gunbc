  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "ken_dan_both_participation_carries_ci_and_serving_tags_2026_11_18"),
  decided: "2026-11-18",
  governs: decl_ref(module_path: "gunbc.tailscale_fleet_auth_key", decl_name: "tailscale_desired_tags_for_participation"),
