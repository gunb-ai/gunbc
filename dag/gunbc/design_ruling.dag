data required_gate_rows_grow_by_operator_ruling: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "required_gate_rows_grow_by_operator_ruling"),
  decided: "2026-11-15",
  governs: decl_ref(module_path: "gunbc.design_document", decl_name: "ci_contract_blocks"),
  provenance: "Operator, on escalation msg_8c7e37f2 (2026-11-15), verbatim: \"Approve enrolment\", relayed to cool-dove-518 by neat-badger-614 in msg_db6d4dc0-b5c2-450d-a9a9-0528961f1ad8. It authorizes exactly one row of `v2.workflow.required_floor` `required_gate_authored_modules` — the module `test.claim.seed_growth_roster_hygiene_witness`, admitted at its own name because its discriminating red was otherwise executed by no lane. A family prefix would have admitted siblings nobody measured, so the growth is one name and not a pattern. Gate rows stay closed to growth without such a ruling.",
}

// The second decision taken under the same operator authority, kept as its own row so neither decision
// restates the other: the admission rule itself is stated at `v2.workflow.required_floor`
// `required_gate_authored_modules`, and this row carries only who authorized which names at which grain.
// The evidence the enrolment owed -- each module green BY EXECUTION on `claim_batch`, at the head these
// rows land behind -- is pinned on that change, not transcribed here.
data absence_class_witnesses_enrolled_by_operator_ruling: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "absence_class_witnesses_enrolled_by_operator_ruling"),
