data tailscale_fleet_key_untagged_join_causality_2026_11_18: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "tailscale_fleet_key_untagged_join_causality_2026_11_18"),
  decided: "2026-11-18",
  governs: decl_ref(module_path: "gunbc.tailscale_fleet_auth_key", decl_name: "tailscale_fleet_key_metadata_standing"),
  provenance: "Operator, in chat to smart-crane-730, 2026-11-18. OBSERVATION: ken (100.96.80.109) and dan/h11-a16 (100.109.228.127) joined BY HAND with the fleet key at Secret Manager version 'latest', not the pinned '1', and joined UNTAGGED, though gunbc.tailscale_fleet_auth_key records the key as tag:ci. RULING (causality, operator): a tagged auth key stamps its tags at JOIN whoever runs 'tailscale up'; going around gunbc.tailscale_join_converge does NOT drop the tags, and tailscale_auth_key_policy_admit only gates whether the CONVERGE will USE a key -- so an untagged hand join is NOT explained by bypassing the converge; it means the key used is NOT the tagged key this module describes. The two competing explanations are the typed closed set gunbc.tailscale_fleet_auth_key::tailscale_fleet_auth_key_untagged_join_hypotheses. Confirming which is a READ, not an inference: gunbc.tailscale_fleet_auth_key::tailscale_fleet_key_metadata_standing carries the open read obligation. Nothing here rotated; no live value was read or asserted.",
}

data native_scm_fabric_first_gate_lifted_2026_11_19: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "native_scm_fabric_first_gate_lifted_2026_11_19"),
  decided: "2026-11-19",
  governs: decl_ref(module_path: "gunbc.design_argument", decl_name: "plans_are_intentions"),
  provenance: "Operator decision 2026-11-19, escalation msg_dd4f5177 decided in msg_5d6b035d, option chosen verbatim: \"Lift it (I record a design_ruling row quoting you; rows 894/911 drop the gate)\". Supersedes the default-approved msg_91e05714, which was approved by default, not by the operator. WHAT THIS LIFTS: the 2026-10-03 fabric-bring-up-first gate on native SCM. Four deliverable rows (2-scm-git-upstream-model, 2-scm-mercurial-upstream-model, 2-scm-pijul-upstream-model, 2-claim-indexed-evidence) were held behind the fabric bring-up by a prerequisite edge onto the fabric-bringup project node; two sibling rows (2-scm-compatibility-shape, 2-scm-p0-landing-spine) carried the same 'revisited after the fabric bring-up (operator ruling 2026-10-03)' only in their contribution text. HISTORY: no 2026-10-03 design_ruling row ever existed -- that gate was asserted only in roadmap row text, never recorded in this ledger; this row is both its first record and its lifting record. The prerequisite edges onto the fabric-bringup project are deleted, the rows stay factory members, and the fabric-bringup red_control dispatch-gate sentence is removed.",
}



data hosted_ci_credentials_federate_over_wif_dispatch_only: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "hosted_ci_credentials_federate_over_wif_dispatch_only"),
  decided: "2026-11-20",
  governs: decl_ref(module_path: "gunbc.auth.hosted_ci_secrets_federation", decl_name: "hosted_ci_secrets_attribute_condition"),
  provenance: "Decides WHERE the hosted shadow gate's credentials live and WHICH runs may hold them. The operator's wish, relayed by gentle-crab-832 (from clever-raven-401, 2026-11-20): \"keys live in GCP Secret Manager (project gunbai-secrets), not GitHub secrets ... Follow the fleet-converge fleet-automation-ssh-key route ... Do not make a second path.\" The shape, confirmed by clever-raven-401 (2026-11-20): \"dedicated SA and a provider pinned to the workflow path, refs/heads/main and workflow_dispatch; remote legs only on dispatch at main; PR and merge_group jobs skip with the typed notice\" -- INTERPRETATION (mine, 2026-11-20, not their words): a DEDICATED pool/provider (gunbc.auth.hosted_ci_secrets_federation), not the fleet-converge provider shared, because the claim pins differ and one provider pinned to two workflows is one pin for neither; the remote legs exist ONLY on the dispatch-at-main arm; pull_request and merge_group runs carry a typed notice naming WHY (the pin refuses them) instead of a silent green. The same message ordered the consequence recorded: \"Record the gap that opens in gunbc.integration_concern, since the operator goal is hosted PR jobs driving remote builds: a PR job must reach the remote build without PR-authored code ever holding the key, e.g. the build host verifying a GitHub OIDC token scoped to the PR and building that commit isolated. Capability gap, no fix in this PR.\" That row is gunbc.integration_concern::shadow_gate_pr_time_remote_build_capability_gap. The pinned secret versions ride the operator's 2026-11-20 relay (both v1) through the single constants in the federation module.",
}

data reference_markers_are_hashtag_form: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "reference_markers_are_hashtag_form"),
  decided: "2026-11-19",
  governs: decl_ref(module_path: "gunbc.design_argument", decl_name: "source_annotations"),
  provenance: "Operator, 2026-11-19, asked by session bold-stag-227 whether comment references should use the hashtag form #gunbc.design_argument::single_authority instead of the @ref(...) form, verbatim: \"yeah i'd like to use the hashtag thanks\". The marker is '#' immediately followed by a coordinate (module.path::decl, ::field or ::<T>); '#' preceded by an identifier character or '/' never opens a marker, a span is a marker only if it reaches '::', sentence punctuation is trimmed from the coordinate, and the escape is a backslash before '#'. ACCEPTED COST, stated and not argued away: under the old form every unescaped marker opening was accounted for, so a coordinate-shaped typo that never reaches '::' (a bare '#a.b:c') is now silent prose and is no longer a finding; this is a deliberate narrowing of the fail-closed accounting (gunbc.design_argument::fail_closed) taken for ergonomics, and the grammar module (std.annotation_reference) pins it as a witness rather than claiming parity with the old coverage.",
}

// ── TAILNET HAND-CONFIGURATION OF 2026-11-20, RECORDED AS OPERATOR DECISIONS ────────────────────────
// The operator's wish, relayed by gentle-crab-832 on 2026-11-20 (msg_6ba80db3): "The operator wants
// everything from today recorded in gunbc so it isn't lost." These rows are the typed carriers for the
// three dated facts of that day's tailnet work; the prose around them cites these rows and carries none
// of the record itself #gunbc.design_argument::source_annotations.

data tailscale_ssh_off_on_fleet_build_hosts_2026_11_20: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "tailscale_ssh_off_on_fleet_build_hosts_2026_11_20"),
  decided: "2026-11-20",
  governs: decl_ref(module_path: "extdeps.tailscale.join", decl_name: "tailscale_up_join_argv"),
  provenance: "Decides the HOST-SIDE half of Tailscale SSH on the fleet build hosts. The operator's words, relayed by gentle-crab-832 (msg_764c3d20, 2026-11-20): \"With the operator's approval, Tailscale SSH is now also OFF on srv2 (RunSSH=false), not just srv1.\" srv1's off state was relayed by clever-raven-401 the same day (msg_069afa76): \"Tailscale SSH off on srv1 (srv3 and srv4 already run plain OpenSSH)\". INTERPRETATION (mine, 2026-11-20, not the operator's words): all four build hosts then terminate SSH through plain OpenSSH -- sshd with the forced-command client keys (gunbc.compute.remote_build) -- so the ci-dispatch -> tag:ci tcp:22 network grant (extdeps.tailscale.acl) reaches sshd, never a tailscale-ssh server; and the join cannot flip the host-side half back, because tailscale_up_join_argv carries no --ssh flag. The discriminating consumer is the claim w_the_fleet_join_argv_never_enables_tailscale_ssh in test.claim.tailscale_join_fleet_membership_witness, red for any argv word carrying --ssh in any spelling. The relay also notes Tailscale SSH had been masking LAN-only from= restrictions on srv1/srv2; repairing those authorized_keys options is gentle-crab-832's own row in gunbc.fleet.fleet_ssh_access, not this ruling's.",
}

data tailscale_ci_oauth_client_replaced_githubcirunners_2026_11_20: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "tailscale_ci_oauth_client_replaced_githubcirunners_2026_11_20"),
  decided: "2026-11-20",
  governs: decl_ref(module_path: "gunbc.tailscale_ci_oauth_client", decl_name: "ci_oauth_client_name"),
  provenance: "Decides the OAuth client identity for CI tailnet joins: the operator created gunbc-ci-github (auth_keys:write, tag:ci-dispatch, ephemeral) and the model names it (ci_oauth_client_name); the predecessor client for GitHub runners, named githubcirunners, is REPLACED, its revocation PENDING -- it stays alive until CI works on gunbc-ci-github, then the operator revokes it. The relay of 2026-11-20 (clever-raven-401, msg_069afa76) said \"recorded as revoked\"; the operator corrected that on 2026-11-21 via gentle-crab-832 (msg_525f0786): NOT revoked yet, revoked after CI works on the new client. INTERPRETATION (mine, 2026-11-20, not the operator's words): replaced, not grown beside. The revocation has no executing consumer today -- the tailnet reconcile route (tailscale_acl_reported) reads ACL policy, not OAuth clients -- so the lifecycle fact lives HERE, in this ledger row, and not as string data beside the client rows; if a client read-back route is modeled, this row's fact moves into a closed lifecycle type that route consumes.",
}

data tailscale_acl_ssh_section_residue_2026_11_20: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "tailscale_acl_ssh_section_residue_2026_11_20"),
  decided: "2026-11-20",
  governs: decl_ref(module_path: "extdeps.tailscale.acl", decl_name: "operator_tailscale_acl_ssh"),
  provenance: "Classifies the emitted ssh section of the tailnet policy as RESIDUE. Finding relayed by gentle-crab-832 (msg_c1605991, 2026-11-20): \"The tailnet policy's ssh section now has no consumer. Under the Consumption rule it should be dropped from what tailscale_acl_emit emits, or recorded as residue.\" The recorded disposition, agreed with gentle-crab-832 (msg_85c8392d: \"Recording the ssh section as residue with a consumer note is fine\"): KEEP emitting the rules unchanged, because the emitted document must equal the live tailnet policy -- the reconcile fixture test/fixture/tailscale_acl_reference.json carries them -- and dropping them from the emit before the tailnet drops them would invert the drift rather than remove it. DISSOLUTION CONDITION, typed by this row: when the tailnet read-back (tailscale_acl_reported reconcile) first reports the section ABSENT, the residue is gone and the emit drops with it; the reconcile route is the consumer that makes that moment visible instead of a comment.",
}

// Admits ONE seed change by PURPOSE under the v1 freeze, on the terms of DESIGN's
// v1_seed_standing: the change removes a second, unmodeled authority rather than adding a capability.
// It is not a general permission -- the declarations it covers are enumerated by the seed-growth rows
// that cite it, and those rows say what else must be true for the admission to hold.
data v1_seed_growth_for_declared_transport_ceiling_admitted: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "v1_seed_growth_for_declared_transport_ceiling_admitted"),
  decided: "2026-11-21",
  governs: decl_ref(module_path: "gunbc.v1.v1_maintenance_standing", decl_name: "v1_seed_standing"),
  provenance: "Answers the PURPOSE objection raised by review 97148 (REQUEST_CHANGES) on gunb-ai/gunbc#16737, which asked whether a seed change passes the v1 semantics freeze. The operator's words, verbatim, given directly to the lane manager neat-badger-614 in chat on 2026-11-21: \"ah sorry - yes you can admit the seed change.\" principal:google-oidc/accounts/116084671989231734979. It covers both halves of that lane's seed growth: the transport-shell grammar field `wall_deadline:` on gunb-ai/gunbc#16842 (row gunbc.transport_shell_wall_deadline_field_seed_growth) and the interpreter's per-leg kill plus overrun decode on gunb-ai/gunbc#16737 (row carried there). The purposive case, in the lane's words: before the field, the seed armed a per-leg wall-clock kill by looking up a PARAMETER NAME at dispatch time, so the bound existed only where a caller happened to use one spelling and no bound at all otherwise; declaring the field on the transport retires that spelling as an authority. A transport that does not declare the field keeps main's behaviour byte for byte."
}

fn design_rulings() -> List<DesignRuling> {
  [
    one_source_tree_and_the_v2_namespace_dissolves,
    known_red_decoder_dissolution_approved_by_default_2026_11_22,
    claim_execution_has_one_v1_entrypoint,
    heal_convergence_job_budget_increase_2026_11_20,
    text_of_chars_is_a_whole_list_host_realization,
    reference_markers_are_hashtag_form,
    ken_strata_memory_trim_buys_two_build_seats_2026_11_19,
    estimates_are_one_representation_derived_upward,
    roadmap_scheduling_units_belong_to_factory,
    schedule_answers_are_computed_cached_and_re_read,
    claims_name_their_leaf_from_the_first_landing,
    a_split_handback_is_accepted_by_the_manager,
    the_ctrl_dashboard_renders_the_planning_page,
    v2_landing_waits_on_the_namespace_program,
    effort_estimates_are_public_and_live_in_gunbc,
    source_is_ingested_into_one_universe_and_files_are_discarded,
    phase_admission_is_a_conformance_pattern,
    operations_are_declarations_with_realizations,
    declaration_references_are_fully_qualified,
    no_ratchets_names_bind_now_and_meaning_migrates_later,
    production_namespace_admission_precedes_seed_mirror_removal,
    imports_are_deleted_before_v2_is_accepted,
    native_frontier_step_budget_may_rise_once_its_checks_are_stated,
    seed_deletion_observation_is_the_v1_programs_acceptance_gate,
    no_ci_claim_execution_until_native_frontier_clears,
    planning_is_one_source_for_every_repo,
    plans_are_intentions_and_realization_is_downstream,
    formal_work_opts_into_the_planning_process,
    work_item_acceptance_is_the_managers_or_an_escalation,
    planning_scheduling_is_cut,
    planning_execution_is_anchored_on_fabric,
    planning_debt_ledgers_are_consolidated,
