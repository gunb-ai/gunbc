data cardinality_one_concept: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "cardinality_one_concept"),
  decided: "2026-10-13",
  section: "3b",
  provenance: "Operator rulings, 2026-10-13, recorded by the cardinality-absence program (roadmap node cardinality-absence): One cardinality concept, existing structural authorities. `std.optional.Optional`, `std.algebra.FreeMonoid` and `std.algebra.FreeSemigroup` remain the authorities for optional values, possibly-empty sequences and nonempty sequences. Cardinality facts compose at named structural positions and measures; they do not replace the value's structure or collapse nesting. Redundant flags and competing carriers are consolidated through complete consumer cuts. Applies to every layer and the whole repository. Subject of the permanent Cardinality / absence conformance domain.",
}

data dag_absence_is_one_meaning: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "dag_absence_is_one_meaning"),
  decided: "2026-10-13",
  section: "3b",
  provenance: "Operator rulings, 2026-10-13, recorded by the cardinality-absence program (roadmap node cardinality-absence): One DAG absence meaning; foreign and domain meanings preserved. DAG absence uses the declared `Absent` constructor. The independent `none`/`null` typing and sentinel semantics are retired by complete cohorts. This does not delete faithful foreign null models, reason-bearing refusals, progress states or policy meanings; their conversion to Optional, when appropriate, is explicit and declared.",
}

data explicit_present_is_the_authoring_policy: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "explicit_present_is_the_authoring_policy"),
  decided: "2026-10-13",
  section: "3b",
  provenance: "Operator rulings, 2026-10-13, recorded by the cardinality-absence program (roadmap node cardinality-absence): Explicit `Present` is the current authoring policy. Optional values are not implicitly wrapped or extracted through checker exceptions, branch-join tricks or target emission. A future implicit injection is permissible only through section 4's law (ruling `gunbc.design_ruling coercion_is_the_implicit_safe_subset`): a declared route that is total, exact, semantics-preserving, unique, pure and consent-free, represented in the typed program. Until such a route is admitted, author `Present` explicitly.",
}

data optional_sugar_is_declaration_bound: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "optional_sugar_is_declaration_bound"),
  decided: "2026-10-13",
  section: "3b",
  provenance: "Operator rulings, 2026-10-13, recorded by the cardinality-absence program (roadmap node cardinality-absence): `T?` is declaration-bound sugar. `T?` denotes the canonical Optional declaration application and introduces its precise acquisition dependency. Local homonyms cannot redirect it. A missing or incompatible authority refuses; it never recreates a kernel mint. This grants no broad ambient prelude and does not make constructor names available unqualified.",
}

data where_refinements_retire_for_checked_constructors: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "where_refinements_retire_for_checked_constructors"),
  decided: "2026-10-02",
  section: "4",
  provenance: "Operator ruling, previously recorded only in the v2.compiler.infer comment above infer_where_predicate_set_edge: where-refinements are being deleted from the language, replaced by checked constructors returning Optional, so no infer judgment for a where-refinement's predicate calls is coming. Retirement trigger: where-refinement clauses are removed in favour of checked constructors returning Optional, sufficient for no where-predicate call to reach infer; the infer arm and its reason are then deleted with the clause.",
}

data literal_only_refinement_judgment_is_interim: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "literal_only_refinement_judgment_is_interim"),
  decided: "2026-10-23",
  section: "4",
  provenance: "Operator decision, 2026-10-23, relayed by keen-heron-809 (Manager 3, N7 infer wall) to Seat 17: a one-obligation-per-literal judgment is admitted as an INTERIM exception to where_refinements_retire_for_checked_constructors. A literal at a call argument or record field whose declared type is a where-refinement of the literal's own type is admitted by v2.compiler.infer and owed to v2.compiler.refinement_discharge, the one judge; non-literals still refuse. It is a declared scaffold, gunbc.rung_drop literal_only_where_refinement_judgment, and the PR states the divergence. Retirement trigger: the NonEmptyStr structural cut lands, sufficient for no where-refinement clause to reach infer; the demand producer and post-pass are then deleted with the clause.",
}

data nonemptiness_is_constructed_or_proved: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "nonemptiness_is_constructed_or_proved"),
  decided: "2026-10-13",
  section: "3b",
  provenance: "Operator rulings, 2026-10-13, recorded by the cardinality-absence program (roadmap node cardinality-absence): Nonemptiness is constructed or proved, then consumed. `FreeSemigroup` is used where a nonempty sequence is the value contract. A possibly-empty producer enters a nonempty consumer only through established evidence or explicit checked admission. A type name, arbitrary predicate callback or sealed wrapper alone does not establish the claimed guarantee. General bound propagation is delivered by roadmap node `cardinality-vertical-slice`; its Required activation is `extended-admission-cardinality`.",
}

data production_is_main_only_lab_admits_integration: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "production_is_main_only_lab_admits_integration"),
  decided: "2026-10-13",
  section: "3",
  provenance: "Operator plan 2026-10-13. Narrows the 2026-10-09 fleet-converge ruling that an empty --candidate-branch admits any nonempty checkout (gunbc.fleet.fleet_converge_plan_cli fleet_converge_deploy_branch_admits). Each DesiredDeployment row carries the one branch it admits (production and srv2: main; lab: its integration branch, gunbc.roadmap.roadmap_dashboard_instance srv1_lab_publication_base_branch). bright-moth-475 is the session that produced the plan, not a second admitted branch. One decision, gunbc.live_deploy.pre_swap_admission target_branch_admission, is consulted by the CI and operator-local apply; the CLI does not re-answer it with a production literal.",
}

data native_first_complete_cuts: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "native_first_complete_cuts"),
  decided: "2026-10-13",
  section: "3b",
  provenance: "Operator rulings, 2026-10-13, recorded by the cardinality-absence program (roadmap node cardinality-absence): Native-first complete cuts, with eventual repository-wide retirement. Complete native consumer cohorts are prioritized; each migrated cohort uses one semantic authority across its participating layers and has no legacy fallback. The remainder is explicit, identity-based and shrink-only; counts are observations, not acceptance oracles. Whole-corpus naming cleanup and unrelated target completion do not gate the typed native closure. The parent roadmap node `cardinality-absence` cannot close until the retained paths are covered and the obsolete production authorities and migration allowances are gone.",
}

data machine_mode_names_drop_the_unit: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "machine_mode_names_drop_the_unit"),
  decided: "2026-10-14",
  section: "3",
  provenance: "Operator, to session merry-fox-82, approving the managed-host untangle cut-7 names: 'yeah those names sound fine to me, just record it. Please retire that yml if it's hand written'. Approved: the eight mtcollins1_* fleet-converge modes drop the unit from their names and take the subject as a workflow input, with no board-family prefix, in one atomic transition with no aliases (the 2026-10-03 rulings stand, live GCP IAM names byte-identical). The proposed managed_host_* spellings are HELD by the operator's later adoption of one_physical_machine_boot_transaction: the boot modes are named after that transaction once the old roots are deleted, and the executor-side census QEMU modes as executor_host_census_qemu_host_observe and executor_host_census_qemu_toolchain_converge. The hand-authored mtcollins-canary.yml is retired.",
}

data one_physical_machine_boot_transaction: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "one_physical_machine_boot_transaction"),
  decided: "2026-10-14",
  section: "3",
  provenance: "Operator, to session merry-fox-82: 'i needed all the srvN boot/convergence aligned with mtcollins ... i just want a unified boot workflow in the end' and 'no matter the machine', then adopting the side-chat design review of 2026-10-14 ('could we make sure to clean up all the machine stuff'). Every physical machine is booted through one transaction surface. A modeled request identifies the exact physical subject, desired target, revision and terminal requirement; observed control and delivery capabilities select the strategy; no workflow branches on the machine's label, board name or fleet participation. Boot is reusable by arrival qualification, OS provisioning, reset and recovery and does not own those lifecycles. Executor, serving and management are roles a machine holds, not machine kinds. gunbc.managed_host is not the universal machine population: BMC, provider, PXE, local-target and future control mechanisms are adapters behind physical-machine control standings. The mtcollins1 boot run, gunbc.srv3 boot-once and gunbc.host_reset_return controller actuation are replacement-migration roots that migrate to this transaction and are deleted.",
}

data physical_and_guest_control_remain_distinct: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "physical_and_guest_control_remain_distinct"),
  decided: "2026-10-14",
  section: "3",
  provenance: "Operator, adopting the side-chat design review of 2026-10-14 given to session merry-fox-82. Physical machines and microVM guests do not share inventory, controller, media or power interfaces. They may share runtime identity, OS and configuration convergence, workload assignment, attempt and incarnation vocabulary, and independent-readback transaction semantics after the physical boot or guest start boundary.",
}

data fan_policy_is_one_fleet_management_workflow: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "fan_policy_is_one_fleet_management_workflow"),
  decided: "2026-10-17",
  section: "3",
  provenance: "Operator, to session merry-fox-82, answering whether the boot may set BMC fan control back to automatic: 'yes it can set the fan control back to whatever the fan policy demands, which is probably managed at a different layer - basically make sure all the machines share a fan policy somewhere' and 'personally i wouldn't tie fan policy to boot - its a separate management workflow entirely, you can have it gate boot if you want, but it needs to be modeled separately regardless'. Fan policy is one fleet-wide authority that every fan-controlled physical host shares (microVM guests have no fan controller and do not inhabit it), converged by its own management workflow, which may write BMC fan control to whatever the policy demands. The boot transaction does not own, author or independently decide fan policy, and may consume the fan-policy convergence standing as an admission gate. Any fan-control restoration a boot initiates must consume or invoke that one convergence authority; boot may not carry a boot-owned or per-family fan policy path of its own. A per-BMC-family fan route (MegaRAC, OpenBMC, Supermicro) is an adapter behind that one policy, never a policy of its own. The operator also reports that the mtcollins1 fans were under automatic management with a 20 percent setting in force, recorded as an operator account, not a machine reading.",
}

data dimm_population_is_admitted_permissively: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "dimm_population_is_admitted_permissively"),
  decided: "2026-10-17",
  section: "4d",
  provenance: "Operator, to session merry-fox-82, after mtcollins1 booted a mixed RDIMM population: 'we have to be as permissive as possible with ram combinations - it eases burden on humans/tech while installing - managing infinite combinations of ddr4 ram is not worth the time' and 'we have to model those interactions per platform if needed - in general, we assume same rank same type (RDIMM, etc) different speed is valid'. Standing direction: a DIMM population is not refused for mixing speeds when rank and module type agree; that default is a typed operator assumption, not a vendor fact. A platform may narrow or widen it only through a per-platform row citing its upstream or a committed observation of that platform, and the DRAM firmware's own training verdict on the booted population is the authority on what a unit actually accepted. This row cites no run: the populations and verdicts behind it are recorded with their own evidence.",
}

data mtcollins1_ci_runner_enrolment_approved: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "mtcollins1_ci_runner_enrolment_approved"),
  decided: "2026-10-17",
  section: "6",
  provenance: "Operator, to session merry-fox-82, asked whether to approve enrolling mtcollins1 as a CI runner host: 'regarding mtcollins, yes, we need stateless runner registration'. The operator approves enrolling mtcollins1 for CI runner participation through gunbc.ci.ci_fleet and gunbc.fleet.fleet_enrollment, served by the diskless runner host route (gunbc.runner.runner_host_medium; the 2026-10-03 ephemeral diskless ruling in gunbc.session_residency). Runner registration must be stateless: slots are re-registered by each boot from modeled state, with no registration state surviving on the host between boots. The slot count is derived from the measured capture, never authored.",
}

data mtcollins1_in_memory_app_credential_per_boot: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "mtcollins1_in_memory_app_credential_per_boot"),
  decided: "2026-10-17",
  section: "3",
  provenance: "Operator, relayed by session merry-fox-82 to session snappy-koi-83, answering question Q1 of the mtcollins1 stateless runner registration design (whether the diskless runner host may hold a GitHub App installation credential so its slots mint their own JIT registrations, the srv1 microVM slot controller precedent): 'Q1. yes'. Approved: a GitHub App credential pushed to mtcollins1 after each boot over the controlled-host route, held in memory only, so the on-host slot loop can mint, deliver and deregister one ephemeral JIT runner per job through gunbc.runner.runner_jit_perform and gunbc.runner.runner_jit_deregistration. The credential is never written to the host's disk and never committed; a powered-off host holds none. Whether a new fleet-converge mode counts toward job_roster_closed_to_growth (Q3) is a separate ruling, fleet_converge_modes_are_outside_the_job_roster.",
}

data fleet_converge_modes_are_outside_the_job_roster: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "fleet_converge_modes_are_outside_the_job_roster"),
  decided: "2026-10-17",
  section: "Building & checks",
  provenance: "Operator, relayed by session merry-fox-82 to session snappy-koi-83, answering question Q3 of the mtcollins1 stateless runner registration design. merry-fox-82 asked: '(b) No, modes are operations inside the existing workflow, and your rule is only about the list of jobs CI runs on pull requests'. The operator answered: 'b is preferred', and clarified: 'for this stuff i really don't care about github workflows - its just a convenience for us for WIF i believe'. For fleet operations the GitHub workflow is only the realization that obtains workload-identity-federation credentials (transport), never the authority: what a mode does is decided by the .dag model and the ruling it cites, so adding or changing a mode needs no roster sign-off. SCOPE: a new mode of gunbc.fleet.fleet_converge_workflow is an operation inside the existing dispatch-only fleet-converge workflow and does not count toward job_roster_closed_to_growth. That ruling still governs the jobs CI runs on pull requests and merge groups, and adding one of those still needs operator sign-off. This ruling does not exempt a mode from authorization: a mode that writes to a machine or to GitHub still cites the ruling or authorization pattern that admits its effect.",
}

data operator_delegates_fan_control_to_the_fleet_policy: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "operator_delegates_fan_control_to_the_fleet_policy"),
  decided: "2026-10-17",
  section: "3",
  provenance: "Operator, to session merry-fox-82, on fan control: 'Regarding fan control, you can do whatever you want.' The operator delegates fan-control writes to the fleet fan policy and its convergence workflow (fan_policy_is_one_fleet_management_workflow); binding a BMC fan-control write route needs no further per-route operator approval. Every write still passes the authorization-pattern selection, independent readback and the standing safety rule (the thermal guard trips toward automatic, and every exit leaves automatic control enabled).",
}

data v1_seed_emitted_byte_write_exception: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "v1_seed_emitted_byte_write_exception"),
  decided: "2026-10-16",
  section: "3",
  provenance: "Operator, to session swift-badger-498, on where the brand logo PNG writer's byte write lives: 'could we somehow put it in rust emission? like i'd rather hardcode a rust script in emit_Rust or something than put it in the interpreter - and then can you try to constrain that to be as small as possible?' and 'yeah please try this out, and make sure the hacky bits are minimal as possible'. An exact exception to the v1 purpose test (gunbc.v1.v1_maintenance_standing v1_seed_standing), not an admission: it serves the logo work, not self-hosting, and PublicSurfaceGrowth and NewLanguageBehavior fire. Scope: the Filesystem.WriteBytes file transport verb write_bytes on the Rust target only (v1.compiler.emit FileWriteBytes, v1.compiler.emit_rust file_write_bytes_expr); the interpreter refuses it. Consumer gunbc.design.brand_mark_assets_cli; control gunbc test //gunbc/instruments:brand-mark-assets. The std.bytes octets_bytes host seam in the same change is a defect repair, not covered here: emitted programs calling it panicked on an unsupported cast. Settles no boundary of either refused class. DISSOLVES when v2 native emission realizes Filesystem.WriteBytes on the Rust target: the write_bytes rows and file_write_bytes_expr are then deleted from the seed, and gunbc test //gunbc/instruments:brand-mark-assets stays as the control.",
}

data flex_market_policy_is_operator_decided: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_market_policy_is_operator_decided"),
  decided: "2026-10-15",
  section: "3d",
  provenance: "Operator, via deep-otter-797 on gunbc#14014. The interruptible flex market's policy grounds are operator decisions: bid levels 3/5, 4/5 and 1 of the class median, the 5/4 held switch premium, the fleet cap (initially $1.34/h, raised by flex_fleet_cap_raised_to_three_dollars), and the objective that lower cost per GiB-hour is better (cost and fungibility only). They are cited to this row, never to a pull request. Empirical couplings, that more samples make a productive-hour reading reliable or that price predicts preemption, stay TranscribedUncited bets, so a choice resting on one is FlexLevelNeedsEvidence until a cited authority is supplied.",
}

data flex_fleet_cap_raised_to_three_dollars: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_fleet_cap_raised_to_three_dollars"),
  decided: "2026-10-16",
  section: "3d",
  provenance: "Operator, via deep-otter-797 on gunbc#14150: the interruptible flex fleet rate cap is raised from $1.34/h to $3.00/h (it covers two Flash-Next cards at about $1.40/h each); raising the cap is fine, the limit is not a big deal long-term. This supersedes only the cap figure in flex_market_policy_is_operator_decided; the $50 trial total is unchanged.",
}

// THE INSTRUMENT FLEET RUNS IN PARALLEL; THE EDGE THE OLD GROUP IMPOSED IS NOT RESTORED AND IS NOT
// MISSED. Recorded here because the change that took the global instrument queue apart is authorized
// by nothing else. The operator rejected (2026-10-21, on #14613) the premise that removing the global
// group loses a guarantee: isolation between jobs is the SLOT's job (gunbc.runner.runner_slot_desired
// + gunbc.host.memory_envelope), and a concurrency group never isolated anything -- it only serialized
// dispatches. So no rung drop stands here for a "lost upper edge", because there was no edge worth
// having. Where isolation genuinely fails today -- the live unit shape drifting from the declared slot
// shape, above all MemorySwapMax -- is a fleet-convergence class of its own and is filed as
// gunbc.recurring_failure_mode the_live_runner_unit_memory_shape_drifts_from_the_declared_slot, not as
// a queue compensation.
data instrument_measurement_queues_run_in_parallel: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "instrument_measurement_queues_run_in_parallel"),
  decided: "2026-10-20",
  section: "Building & checks",
  provenance: "Operator, to bright-swift-151 via warm-wolf-570: approved PARALLEL measurement queues. The single 'instrument-dispatch-queued' concurrency group put every instrument dispatch behind one run; key the group per dispatch so unrelated measurements run in parallel while one label on one ref still cannot run twice. Carried with the approval, stated at what the head holds (reworded 2026-10-21 on the #14613 review, which found this clause claiming more than the head does): no new job; each run refuses before the prelude when its granted cgroup bound is under its demand row -- the guard step reads the least numeric memory.high/memory.max on its own cgroup path plus MemTotal (gunbc.instruments.instrument_dispatch_workflow instrument_dispatch_memory_guard_statements), so the refusal is on memory.high/memory.max, not on an OOM kill after the fact; the swap bound is OBSERVED ONLY -- the same step reads and prints memory.swap.max, and a refusal on swap is an outstanding rung, not a held guarantee. OPERATOR ISOLATION RULING, 2026-10-21 on #14613, recorded in this provenance because DesignRuling carries no other field (schema: reference, decided, section, provenance): the premise that removing the global group LOSES a guarantee is REJECTED. Work isolation is the authority -- 'a job shouldn't have to worry about what is running on the machine' -- and a concurrency group never provided isolation, it only serialized dispatches. What keeps one instrument run from harming another job on the shared self-hosted pool is the SLOT, not the queue: gunbc.runner.runner_slot_desired declares the per-slot shape (memory_max 23622320128, memory_high 22548578304, MemorySwapMax 0, TasksMax 16384) and gunbc.host.memory_envelope gives it teeth -- memory.high throttles early, memory.max refuses late, MemorySwapMax 0 means an overrun is refused rather than silently swapped. So this ruling restores NO upper edge on concurrent instrument occupancy and no such edge is missed. WHAT DOES NOT HOLD TODAY is a different class and is filed as its own ledger row rather than as a queue compensation: the live fleet does not match the declared slot shape (an operator reading of srv3-20 and srv3-01 gave memory.high 26843545600, memory.max 27917287424 and MemorySwapMax 34359738368 -- the first two match the competing floor-pinned values in gunbc.floor.floor_demand rather than the slot row, and the swap is 32 GiB where the slot declares zero), so the swap half of the isolation story is not enforced on those hosts. See gunbc.recurring_failure_mode the_live_runner_unit_memory_shape_drifts_from_the_declared_slot.",
}

data approval_enrolment_is_google_sign_in: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "approval_enrolment_is_google_sign_in"),
  decided: "2026-10-23",
  section: "3",
  provenance: "Operator, via wise-bat-528 to clever-eagle-893: 'i think this all just sucks - can i just log in to google oidc on my phone? and thats all?' ... 'thats fine - please do it now, can you basically remove everything except google enrollment'. Google sign-in on the phone IS enrolment of the approval app: one native iOS OIDC sign-in, in the same step the app creates its Secure-Enclave decision key (Face ID gated) and App Attest key and registers them bound to the verified Google identity. Each approval stays Face ID plus a signature by that key. Removed, delete-first: enrolment codes, QR, SSH issuance, ntfy code delivery, the fleet-converge issue mode, and the SubmissionUnknown/re-read app machinery. App states are signed-out, enrolled, revoked; a failed sign-in is only 'sign in again'. The server notifies on each new device and lists devices with revoke. The broker process is unchanged; only enrolment is replaced.",
}

// THE DRAIN BOUND IS DERIVED, NOT RATIFIED AS A NUMBER (2026-10-23). The row at
// gunbc.runner.runner_host_cap_bracket runner_host_cap_drain_policy carried a ratified literal
// (wait_bound 2700s) on the premise that 'no source declares the longest job'. The premise is false:
// the fleet-targeted generated workflows declare job timeouts (gunbc.witness.compiler_gate_workflow
// compiler_gate_emit_build_timeout_minutes = 90, and a v2-bootstrap job runs ~55 minutes), and the
// literal bit srv3 cap converge run 39961292233 — every cap withheld on 'the drain bound of 2700s
// was exceeded' while honest work ran.
data drain_wait_bound_is_derived_from_declared_job_timeouts: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "drain_wait_bound_is_derived_from_declared_job_timeouts"),
  decided: "2026-10-23",
  section: "Self-hosting and the fleet",
  provenance: "Operator ruling 2026-10-23, relayed by sleek-owl-397: wait_bound in gunbc.runner.runner_host_cap_bracket runner_host_cap_drain_policy is DERIVED from the declared job timeouts of the fleet-targeted generated workflows (90 min today, plus the poll interval); it replaces the 2700s literal. The population rule was ruled by clever-crane-830 the same day: a job is in the fold iff its runner selects the fleet pool AND its workflow's modeled trigger set holds an autonomous trigger (push, pull_request, schedule, merge_group, workflow_call, workflow_run) — the work GitHub can park on a slot with no operator at the keyboard. Dispatch-only fleet jobs (instrument-dispatch, fleet-converge's build) are excluded by the same predicate, with the residual declared: if one is running when a drain starts it can exceed the bound and the bracket refuses typed (caps withheld), fail-closed, the dispatching operator owning the sequencing. The fold lives at gunbc.runner.runner_fleet_job_timeout_census; the control test.claim.runner.runner_fleet_job_timeout_bound_witness goes red if a population member's declared timeout exceeds the bound.",
}

data flex_operator_template_v2: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_operator_template_v2"),
  decided: "2026-10-16",
  section: "4d",
  provenance: "Operator, via deep-otter-797 on gunbc#14150: both flex serving templates are operator policy, not empirical readings. The Qwen3.8-27B NVFP4 ninfer template ('qwen oct 11'): the vastai/vllm:v0.30.0-cuda-13.0 host image, 32 GiB disk, no cache tier, published port 8000. The Qwen3.8-Flash-Next template: 400 GiB disk, host RAM and disk session-cache tiers at one half of the host each, published port 8000, and an object-store (R2) start with no Hugging Face fallback. They are choices, so they carry this ruling as their standing. This does NOT cover empirical figures: the 580 driver floor, the 1 GiB name/VRAM tolerance and throughput stay TranscribedUncited, and anything computed from them is Estimated, never established.",
}

data flex_first_recipe_is_flash_next: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_first_recipe_is_flash_next"),
  decided: "2026-10-18",
  section: "3d",
  provenance: "Operator, via deep-otter-797 (Flex L1): the first flex recipe is Flash-Next on the RTX PRO 6000 Blackwell class (Workstation, Max-Q and Server editions); 27B-on-ninfer stays modelled and is not selected. The Vast template filters read from the operator's Vast account on 2026-10-18 (cuda_max_good >= 13, cpu_ram >= 128000 MB, gpu_ram >= 90000 MB, inet_down >= 1000, verified) are operator policy under flex_market_policy_is_operator_decided; the gpu_ram floor replaces the 1 GiB name/VRAM tolerance as the VRAM screen. The driver floor is not policy: it derives from the CUDA 13 the filter requires and is cited to NVIDIA's CUDA toolkit release notes. Throughput and price stay operator readings.",
}

data runner_host_sudoers_is_installed: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "runner_host_sudoers_is_installed"),
  decided: "2026-10-18",
  section: "3b",
  provenance: "Operator decision, default (dashboard msg_b6241e41, relayed by sleek-owl-397), reversing the 2026-09-22 decision that the rendered gunbc-ghrunner.sudoers stays modeled and uninstalled: the RENDERED rule alone is installed on the runner hosts at /etc/sudoers.d/gunbc-ghrunner through gunbc.runner.runner_host_file_converge, validated by visudo on the staging path before the rename, 0440 root-owned, read back and compared, refusing typed on any mismatch, with no catch-all and no widening beyond the rendered lines. Cause: srv3 apply 39127216304 and srv4 apply 39128728092 failed at the first host-wide grant (sudo: a password is required) because nothing installed the file.",
}

data runner_listener_admission_is_mask_roster_and_no_worker: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "runner_listener_admission_is_mask_roster_and_no_worker"),
  decided: "2026-10-21",
  section: "4b",
  provenance: "Operator ruling B at the root of the runner host cap bracket (sleek-owl-397, relayed by clever-crane-830): a running idle listener is admitted to the write and its stop only when its unit is masked, the organization roster says its registration is busy=false and its cgroup holds no Runner.Worker, all re-read immediately before the stop; there is no deregister because nothing re-registers a long-lived slot; the read-to-stop window is a typed residual (gunbc.runner.runner_host_cap_bracket listener_restart_residual) and re-registration a declared frontier (listener_reregistration_frontier). Supersedes the mask-only closure for running idle listeners.",
}

data emit_build_subjects_are_the_two_compiler_products: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "emit_build_subjects_are_the_two_compiler_products"),
  decided: "2026-10-09",
  section: "Building & checks",
  provenance: "Operator ruling with the v1 withdrawal (gunbc#13658, second round: the required job \"requires fresh emission/build of both retained products\"): the subjects of gunbc.emitted_subject_build_gate emitted_subject_build_rows are the two retained compiler products, //gunbc/instruments:self-host and //gunbc/instruments:v2-native-cli, and a third subject row is a growth the operator vetoed. Until 2026-10-24 the veto lived only as a comment on test.claim.compiler_gate_emit_build_lane_witness the_job_runs_both_retained_emit_build_subjects, which quotes the roster as remaining the two compiler products; that comment landed in gunbc#13641 and its quotation has no other source in the repository. Re-raised and confirmed on 2026-10-24 by merry-fox-82 when gunbc#14984 built a native control over gunbc.fleet.fleet_convergence_verdict: it stays run by name, and enrolling it would reverse this ruling and goes to the operator.",
}

data pattern_atom_naming_a_visible_value_is_never_a_binder: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "pattern_atom_naming_a_visible_value_is_never_a_binder"),
  decided: "2026-10-25",
  section: "5",
  provenance: "Ruling by tidy-ant-251 (Manager 1), 2026-10-25, on the bare-atom match-arm binding work (gunbc#15125): a bare atom in pattern position is a binder unless it names something the arm can already see, and then it never silently shadows it. A pattern atom naming a frame value refuses with one cause covering both readings (rename to bind, or compare with an equality guard), replacing binder_hides_visible_value for pattern atoms at either pattern position; a pattern atom naming a module-level value refuses only for a `data` constant, since a module function stays admitted exactly as root shadowing always allowed. It is decided at v2.compiler.resolve resolve_pattern_atom_naming_a_frame_value, with the module-level half in resolve_pattern_atom_names_module_value.",
}

data unread_catch_all_binder_refuses: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "unread_catch_all_binder_refuses"),
  decided: "2026-10-25",
  section: "5",
  provenance: "Ruling by tidy-ant-251 (Manager 1), 2026-10-25, on the bare-atom match-arm binding work (gunbc#15125): with a bare arm atom now binding its arm, an arm that never reads its own catch-all binder is a mistake the author should hear about, not a binding that silently exists — it refuses at resolve, and the remedy the refusal names is to write `_`. Decided at v2.compiler.resolve resolve_catch_all_binder_read_gate; the widening-over-a-nullary companion refusal lives at v2.compiler.infer infer_coproduct_catch_all_binder_widening_over_a_nullary.",
}

data cross_tree_admission_is_namespace_membership: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "cross_tree_admission_is_namespace_membership"),
  decided: "2026-10-25",
  section: "3",
  provenance: "Operator ratified 2026-10-25 (escalation msg_6f0857a6) a decision by root coordinator sleek-owl-397, relayed by tidy-ant-251, on the per-root fundamentality defect, where native resolve denied every dag->v2 import that the seed admits: fix the model and do not move the importers. Narrowed the same day from 'rank per namespace' to membership, with no direction rule, once the namespace-grain import census showed one 23-namespace cycle spanning both trees, so any strict order would deny live edges that no ruling forbids. A crossing is admitted when both namespaces have a row in gunbc.source_layout_namespaces and refused when either has none; the storage lookup is the one enforcement site, and the population route asks the same membership read; name resolution keeps only the active-root denials. Applied in gunbc#15080 (v2.std.cross_tree.import_model cross_tree_import_admitted).",
}

// WHY A HUMAN ONCE PASTED ssh-keygen FOR THIS KEY AND NO LONGER DOES. The boot medium reader key already had
// an approval-free mint (gunbc.host.boot_medium_reader_key_mint); mtcollins1's SSH host key had Step 1 of a
// runbook and a laptop terminal (gunbc.host.anchored_host_transport anchored_host_key_mint_intervention,
// docs/runbooks/mtcollins1-ssh-host-key-mint.md). The asymmetry had no reason behind it, and the ruling
// removed the human step rather than the workflow: minting a fleet keypair is ordinary account creation, so
// it belongs to the converged path like any other account, and a step that only a named person can perform is
// an availability defect as well as an authority one -- the key cannot be minted while that person is
// unavailable, and the fleet cannot boot.
//
// WHAT THE RULING DOES NOT LICENSE, and this is half of it. Removing the human does not remove the human's
// JUDGMENT: Q1 still holds (the private half exists only in a tmpfs directory the run created and then
// removes, and then in Secret Manager via stdin -- never argv, log or disk), the mint dispatch itself stays an
// OPERATOR GO, and the mint is delivered as ONE policy with two rows rather than as a second implementation,
// per 6b's root generalization -- the reason a copy was refused is that the copy is where "the private half
// never leaves tmpfs" would quietly lose its findmnt read.
data the_mint_of_a_fleet_ssh_keypair_is_account_creation: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "the_mint_of_a_fleet_ssh_keypair_is_account_creation"),
  decided: "2026-10-28",
  section: "Self-hosting and the fleet",
  provenance: "Operator ruling 2026-10-28, relayed by merry-fox-82, on why mtcollins1's SSH host key was minted by a human shell while the boot medium reader key had an approval-free workflow mint: \"i don't see why a human needs to do this - this seems just like normal account creation\". Applied in gunbc.host.fleet_keypair_mint (one keypair-mint policy, parameterized by the secret row) with both consumers as rows of it: gunbc.host.boot_medium_reader_key_mint and gunbc.host.mtcollins1_ssh_host_key_mint. The runbook's human Step 1 and the modeled scaffold anchored_host_key_mint_shell_bash / anchored_host_key_mint_intervention are retired by it -- the scaffold's own anchored_host_key_mint_shell_bash_emit_dissolution_trigger named exactly this dispatch. The minting identity's secretVersionAdder arrives as a row of gunbc.auth.fleet_secret_accessor_roster converged by gunbc.auth.gcp_iam_converge, never as a hand-edited policy. Conditions the ruling does not relax: Q1 (the private half exists only in a create-only 0700 tmpfs directory the run created, then in Secret Manager via request stdin -- never argv, log or durable path), the fleet-converge mint dispatch remains an operator go, and the mint is delivered as one policy with two rows rather than a second implementation (6b root generalization).",
}

data native_claim_route_admits_the_docker_cli: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "native_claim_route_admits_the_docker_cli"),
  decided: "2026-10-25",
  section: "Building & checks",
  provenance: "Operator ruling relayed by calm-crab-645 (msg_396b4514), answering proud-bear-756's escalation msg_127d75bc: the router proxy falsifier (plan gunbc.plans.fabric_serving_router, S1b) takes route (a), native-process-effect, over a seed producer or a live receipt. Process spawn is a declared .dag effect, and one native route's denominator is extended on the D11 row (gunbc.plans.demand_engine_program); the seed does not grow. As built, and with calm-crab-645's conditions of msg_49fe21ca: std.compiler_entry native_claim_route_denominator admits exactly extdeps.docker.cli_service DockerCli, a fixed-argv shell-transport service whose image, name, network and paths arrive as parameters; generic exec (extdeps.shell.exec, held at an empty roster by the meta_exec_confinement lens) stays out; a runner with no reachable docker daemon answers no observation (exit 2), never a skip or a green.",
}

data macos_operator_terminal_runs_without_a_memory_bound: DesignRuling = DesignRuling {
  reference: decl_ref(module_path: "gunbc.design_ruling", decl_name: "macos_operator_terminal_runs_without_a_memory_bound"),
  decided: "2026-10-28",
  section: "Building & checks",
  provenance: "Operator ruling to wise-bat-528, 2026-10-28, answering the option 'A: admit an operator-attended macOS run without a cgroup wrap, with a notice; CI and servers unchanged' with 'A is fine'. Context: the IAM root ceremony (gunbc.auth.gcp_iam_bootstrap iam_bootstrap_apply) is run from the operator's Mac, which has no cgroup facility, so every gunbc run there refused CgroupUnreadable. As built (gunbc#15316): macOS, GITHUB_ACTIONS unset, and stdin a terminal classify as OperatorHostWithoutCgroups and skip the wrap with a notice; every other macOS run still refuses. The loss is declared as gunbc.rung_drop.macos_operator_terminal_run_unbounded.",
}

fn design_rulings() -> List<DesignRuling> {
  [
    the_mint_of_a_fleet_ssh_keypair_is_account_creation,
    macos_operator_terminal_runs_without_a_memory_bound,
    cross_tree_admission_is_namespace_membership,
    native_claim_route_admits_the_docker_cli,
    emit_build_subjects_are_the_two_compiler_products,
    job_roster_closed_to_growth,
    runner_listener_admission_is_mask_roster_and_no_worker,
    runner_host_sudoers_is_installed,
    flex_first_recipe_is_flash_next,
    conformance_needs_attention,
    consumption_interrogated_separately,
    epistemic_humility_is_symmetric,
    chain_re_derivation,
    root_generalization_closes_breadth,
    instrument_is_a_row_not_a_flag,
    authorization_pattern_is_a_selection,
    one_approval_route_for_every_privileged_action,
    the_initial_convergence_is_the_only_approval,
    srv1_root_mutation_approval_is_filed_by_the_job,
    coercion_is_the_implicit_safe_subset,
    text_crossings_go_through_the_unfold,
    v2_better_than_the_seed,
    v1_withdrawn_one_required_job,
    memory_envelope_is_part_of_the_verdict,
    regeneration_jobs_added_to_roster,
    harness_default_requirement_places_on_operator_endpoint,
    project_documentation_projections_are_not_checkout_artifacts,
    cardinality_one_concept,
    dag_absence_is_one_meaning,
    explicit_present_is_the_authoring_policy,
    optional_sugar_is_declaration_bound,
    nonemptiness_is_constructed_or_proved,
    where_refinements_retire_for_checked_constructors,
    literal_only_refinement_judgment_is_interim,
    native_first_complete_cuts,
    machine_mode_names_drop_the_unit,
    one_physical_machine_boot_transaction,
    physical_and_guest_control_remain_distinct,
    fan_policy_is_one_fleet_management_workflow,
    dimm_population_is_admitted_permissively,
    mtcollins1_ci_runner_enrolment_approved,
    mtcollins1_in_memory_app_credential_per_boot,
    fleet_converge_modes_are_outside_the_job_roster,
    operator_delegates_fan_control_to_the_fleet_policy,
    v1_seed_emitted_byte_write_exception,
    production_is_main_only_lab_admits_integration,
    flex_market_policy_is_operator_decided,
    flex_fleet_cap_raised_to_three_dollars,
    flex_operator_template_v2,
    instrument_measurement_queues_run_in_parallel,
    approval_enrolment_is_google_sign_in,
    drain_wait_bound_is_derived_from_declared_job_timeouts,
    pattern_atom_naming_a_visible_value_is_never_a_binder,
    unread_catch_all_binder_refuses,
    bmc_secure_goes_live_per_controller_family,
  ]
}

fn ruling_blocks(r: DesignRuling) -> List<MarkdownBlock> {
  [
    h2(text: concat(r.reference.decl_name as String, " — ", r.decided, " — §", r.section)),
    p(text: r.provenance),
  ]
}

fn expected_design_rulings_md() -> String {
  serialize_markdown_source(doc: MarkdownDocument {
    blocks: concat(
      [
        HeadingBlock { level: H1, inlines: [TextInline { text: "gunbc — design rulings" }] },
        p(text: "Generated on demand from `gunbc.design_ruling`. `DESIGN.md` states each rule and cites its row; a row carries only the date, the section and the provenance, never a second copy of the rule."),
        hr(),
      ],
      flat_map(design_rulings(), r => ruling_blocks(r: r)),
    ),
  })
}
