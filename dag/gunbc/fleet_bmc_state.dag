fn bmc_fan_reboot_host_power_stayed_on(
  receipt: BmcFanRebootPersistenceReceipt,
) -> Bool {
  match receipt.host_power_before {
    On =>
      match receipt.host_power_after {
        On => true
        _ => false
      }
    _ => false
  }
}

fn bmc_fan_reboot_activation_evidence(
  receipt: BmcFanRebootPersistenceReceipt,
) -> StateActivationEvidence {
  if receipt.reset.reset_type == ResetGracefulRestart
    && receipt.reset.http_status == 200
    && receipt.reset.accepted
    && receipt.bmc_down_observed
    && receipt.bmc_returned
    && receipt.observed_outage_seconds > 0
    && bmc_fan_reboot_host_power_stayed_on(receipt: receipt)
    && receipt.host_os_ssh_reachable_throughout
    && receipt.post_reboot_controller_active
    && !receipt.post_reboot_zone_failsafe_active
    && receipt.post_reboot_observer_exit_success
    && receipt.post_reboot_converge_noop_exit_success {
    ActivationVerified
  } else {
    ActivationUnverified {
      reason: "graceful BMC restart did not carry complete preservation and post-restart activation readback",
    }
  }
}

fn bmc_fan_reboot_preservation_outcome(
  receipt: BmcFanRebootPersistenceReceipt,
) -> StatePreservationOutcome {
  if receipt.bmc_returned {
    StatePreserved {
      before_digest: receipt.before.active_config_digest,
      after_digest: receipt.post_reboot_active_config_digest,
      activation: bmc_fan_reboot_activation_evidence(receipt: receipt),
    }
  } else {
    StatePreservationObservationRefused {
      reason: "BMC did not return for post-boundary content and activation readback",
    }
  }
}

fn bmc_fan_reboot_durability_evidence(
  receipt: BmcFanRebootPersistenceReceipt,
  realization_id: NonEmptyStr,
  boundary: StateDurabilityBoundary,
) -> StateDurabilityEvidence {
  StateDurabilityEvidence {
    realization_id: realization_id,
    boundary: boundary,
    outcome: bmc_fan_reboot_preservation_outcome(receipt: receipt),
    observed_at: receipt.observed_at,
  }
}

data srv4_bmc_fan_durability_evidence: List<StateDurabilityEvidence> = [
  bmc_fan_reboot_durability_evidence(
    receipt: srv4_bmc_fan_reboot_persistence_receipt,
    realization_id: srv4_bmc_fan_projection_capability.projection_id,
    boundary: fleet_bmc_fan_graceful_restart_boundary,
  ),
]

data srv4_bmc_fan_projection_probe_note: String = "Authenticated read-only BMC SSH probe, 2026-07-27: the active 3.22 config was projected in memory through the intended TEMP_SOC semantic patch. The projection was idempotent, and a curve perturbation was discriminating. The later typed live receipt is srv4_bmc_fan_convergence_receipt; this note remains the earlier projection-only provenance rather than being rewritten as execution."

data srv4_bmc_fan_reboot_persistence_note: String = "Live perturbation receipt, 2026-07-27: Redfish Manager.Reset advertised and accepted GracefulRestart with HTTP 200. The BMC was observed down for a 157-second reachability interval while srv4's host OS SSH remained reachable and ComputerSystem PowerState remained On. After return, OpenBMC still reported 3.22.00; the active config path and SHA-256 digest were unchanged; phosphor-pid-control was active; zone0 FailSafe=false; the semantic observer returned ExitSuccess; and an independent converge re-drive returned ExitSuccess through its Noop arm. This proves the JFFS2 upper override across one graceful BMC restart. It does not prove persistence across a firmware replacement."

data fleet_bmc_surface_observation_note: String = "Authenticated read-only Redfish observations, 2026-07-27. srv3 OpenBMC 2.07.00 advertises ThermalSubsystem and its 51-member Chassis/Sensors collection includes temperature and fan readings; the legacy Chassis/Thermal URI is absent. srv4 OpenBMC 3.22.00 advertises legacy Chassis/Thermal; its Chassis/Sensors request still returns HTTP success but has only 9 power/utilization members and omits temperature/fan readings. A collection-only observer therefore fails open on srv4: transport success is not telemetry completeness. Direct known sensor URIs still resolve, but they do not make an inventory query complete."

data fleet_bmc_update_service_observation_note: String = "Authenticated read-only Redfish observations, 2026-07-27. Both srv3 2.07.00 and srv4 3.22.00 advertise /redfish/v1/UpdateService/update through HttpPushUri and MultipartHttpPushUri, and each active BMC image is Updateable=true. Each FirmwareInventory exposed exactly one BMC image plus non-BMC members; neither exposed a backup BMC image. This is update-surface capability evidence, not an approved image, apply receipt, or recovery proof."
