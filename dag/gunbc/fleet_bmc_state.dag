module gunbc.fleet_bmc_state


data srv4_bmc_fan_publication_protocol: extdeps.filesystem.linux.LinuxFilePublicationProtocol = linux_synchronized_rename_replace_publication

data srv4_bmc_fan_projection_capability: gunbc.bmc_fan_projection.BmcFanPolicyProjectionCapability = bmc_fan_policy_projection_capability(
  board: srv4_baseboard.catalog.model,
  firmware: srv4_bmc_firmware_observation.firmware,
  projected_curve: fleet_bmc_valid_state.fan_policy.curve,
  projected_config_digest: altrad8ud_openbmc_322_fleet_quiet_temp_soc_projected_config_digest,
  config_path: srv4_bmc_fan_observed_config_path,
  controller_service: srv4_bmc_fan_observed_controller_service,
  controller_zone_path: srv4_bmc_fan_observed_controller_zone_path,
  aggregate_fan_pid_entry: srv4_bmc_fan_observed_aggregate_entry,
  realization: srv4_bmc_fan_realization,
  durability_capability_version: srv4_bmc_fan_durability_capability_version,
  publication_protocol: srv4_bmc_fan_publication_protocol,
  durability_boundaries: [fleet_bmc_fan_graceful_restart_boundary],
  required_tach_inputs: srv4_bmc_fan_observed_tach_inputs,
)

data srv4_bmc_fan_reboot_persistence_receipt: gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt = gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt {
  evidence_scope: HistoricalEvidenceSnapshot,
  host: srv4_host.identity,
  perturbation_receipt_id: "srv4-bmc-graceful-restart-2026-07-30T22:53:06Z",
  perturbation_generation: srv4_bmc_fan_perturbation_generation,
  perturbation_capability: srv4_bmc_fan_projection_capability,
  before: srv4_bmc_fan_convergence_receipt,
  post_reboot_policy: srv4_bmc_fan_post_reboot_policy_observation,
  reset: extdeps.bmc.types.RedfishManagerResetObservation {
    action_target: "/redfish/v1/Managers/bmc/Actions/Manager.Reset",
    reset_type: ResetGracefulRestart,
    http_status: 200,
    accepted: true,
    evidence_scope: HistoricalEvidenceSnapshot,
    observed_at: 1785432780000,
  },
  bmc_down_observed: true,
  bmc_returned: true,
  bmc_down_observed_at: 1785432786000,
  bmc_returned_at: 1785432956000,
  host_power_before: On,
  host_power_after: On,
  host_os_ssh_reachable_throughout: true,
  pre_reboot_temp_soc: celsius(60),
  post_reboot_temp_soc: celsius(61),
  pre_reboot_tachs: [
    gunbc.fleet_bmc_observation.BmcFanTachReceipt { sensor: "FAN1", reading: rpm(4600) },
    gunbc.fleet_bmc_observation.BmcFanTachReceipt { sensor: "FAN2", reading: rpm(1200) },
    gunbc.fleet_bmc_observation.BmcFanTachReceipt { sensor: "FAN3", reading: rpm(1200) },
    gunbc.fleet_bmc_observation.BmcFanTachReceipt { sensor: "FAN4", reading: rpm(1200) },
  ],
  post_reboot_tachs: [
    gunbc.fleet_bmc_observation.BmcFanTachReceipt { sensor: "FAN1", reading: rpm(4600) },
    gunbc.fleet_bmc_observation.BmcFanTachReceipt { sensor: "FAN2", reading: rpm(1200) },
    gunbc.fleet_bmc_observation.BmcFanTachReceipt { sensor: "FAN3", reading: rpm(1200) },
    gunbc.fleet_bmc_observation.BmcFanTachReceipt { sensor: "FAN4", reading: rpm(1200) },
  ],
  post_reboot_active_config_digest: srv4_bmc_fan_active_config_digest,
  post_reboot_controller_active: true,
  post_reboot_zone_failsafe_active: false,
  post_reboot_observer_exit_success: true,
  post_reboot_converge_noop_exit_success: true,
  observed_at: 1785433000000,
}

data srv4_bmc_fan_durability_admission: gunbc.bmc_fan_projection.BmcFanDurabilityAdmission = bmc_fan_policy_projection_durability_admission(
  host: srv4_host.identity,
  capability: srv4_bmc_fan_projection_capability,
  perturbation_generation: srv4_bmc_fan_perturbation_generation,
)

type BmcFanDurabilityEvidenceConstructionRefusal
  = DurabilityReceiptDigestMismatch
  | DurabilityReceiptBoundaryMismatch {
      reset_type: extdeps.bmc.types.RedfishResetType,
    }
  | DurabilityReceiptNonPositiveInterval {
      cause: std.measure.PositiveMeasureCountNonPositive,
    }

type BmcFanDurabilityEvidenceConstruction
  = BmcFanDurabilityEvidenceBuilt { evidence: gunbc.bmc_fan_projection.BmcFanDurabilityEvidence }
  | BmcFanDurabilityEvidenceConstructionRefused {
      cause: BmcFanDurabilityEvidenceConstructionRefusal,
    }

type BmcFanRebootTimingBuilt {
  started_after_before_readback: std.measure.PositiveMillisecond
  duration: std.measure.PositiveMillisecond
  observed_after_perturbation_completion: std.measure.PositiveMillisecond
}

type BmcFanRebootTimingReceipt
  = BmcFanRebootTimingReceiptBuilt { timing: BmcFanRebootTimingBuilt }
  | BmcFanRebootTimingReceiptRefused {
      cause: BmcFanDurabilityEvidenceConstructionRefusal,
    }

fn bmc_fan_reboot_timing_receipt(
  receipt: gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt,
) -> BmcFanRebootTimingReceipt {
  match positive_measure_count_from_int(
    count: receipt.reset.observed_at - receipt.before.observed_at,
  ) {
    PositiveMeasureCountRefused { cause: cause } =>
      BmcFanRebootTimingReceiptRefused {
        cause: DurabilityReceiptNonPositiveInterval { cause: cause },
      }
    PositiveMeasureCountBuilt { count: started } =>
      match positive_measure_count_from_int(
        count: receipt.bmc_returned_at - receipt.reset.observed_at,
      ) {
        PositiveMeasureCountRefused { cause: cause } =>
          BmcFanRebootTimingReceiptRefused {
            cause: DurabilityReceiptNonPositiveInterval { cause: cause },
          }
        PositiveMeasureCountBuilt { count: duration } =>
          match positive_measure_count_from_int(
            count: receipt.observed_at - receipt.bmc_returned_at,
          ) {
            PositiveMeasureCountRefused { cause: cause } =>
              BmcFanRebootTimingReceiptRefused {
                cause: DurabilityReceiptNonPositiveInterval { cause: cause },
              }
            PositiveMeasureCountBuilt { count: after_completion } =>
              BmcFanRebootTimingReceiptBuilt {
                timing: BmcFanRebootTimingBuilt {
                  started_after_before_readback: positive_millisecond(count: started),
                  duration: positive_millisecond(count: duration),
                  observed_after_perturbation_completion: positive_millisecond(
                    count: after_completion,
                  ),
                },
              }
          }
      }
  }
}

fn bmc_fan_reboot_activation_evidence(
  receipt: gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt,
  admission: std.state_durability.StateDurabilityAdmission<HostIdentity, BmcFanConfigReadbackSubject>,
) -> StateActivationEvidence<HostIdentity, BmcFanConfigReadbackSubject> {
  match redfish_host_power_state_continuity_verdict(
    power_before: receipt.host_power_before,
    power_after: receipt.host_power_after,
  ) {
    RedfishHostPowerStateChanged { power_before: _, power_after: _ } =>
      std.state_durability.ActivationUnverified {
        reason: "host ComputerSystem PowerState did not remain On across BMC restart",
      }
    RedfishHostPowerStateRemainedOn =>
      if receipt.reset.reset_type == ResetGracefulRestart
        && receipt.reset.http_status == 200
        && receipt.reset.accepted
        && receipt.bmc_down_observed
        && receipt.bmc_returned
        && receipt.bmc_returned_at > receipt.bmc_down_observed_at
        && receipt.host_os_ssh_reachable_throughout
        && receipt.post_reboot_controller_active
        && !receipt.post_reboot_zone_failsafe_active
        && receipt.post_reboot_observer_exit_success {
        std.state_durability.ActivationVerified {
          receipt: std.state_durability.StateActivationReceipt {
            perturbation_receipt_id: receipt.perturbation_receipt_id,
            target: admission.target,
            subject: admission.readback_subject,
            desired_state_digest: admission.desired_state_digest,
            realization: admission.realization,
            capability_version: admission.capability_version,
            perturbation_generation: admission.perturbation_generation,
          },
        }
      } else {
        std.state_durability.ActivationUnverified {
          reason: "graceful BMC restart did not carry independent controller, content, and safety readbacks",
        }
      }
  }
}

fn bmc_fan_reboot_preservation_outcome(
  receipt: gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt,
  admission: std.state_durability.StateDurabilityAdmission<HostIdentity, BmcFanConfigReadbackSubject>,
  timing: BmcFanRebootTimingBuilt,
) -> StatePreservationOutcome<HostIdentity, BmcFanConfigReadbackSubject> {
  if receipt.bmc_returned {
    std.state_durability.StatePreserved {
      before: std.state_durability.StateBeforeReadbackReceipt {
        perturbation_receipt_id: receipt.perturbation_receipt_id,
        target: receipt.before.host,
        subject: gunbc.bmc_fan_projection.BmcFanConfigReadbackSubject {
          config_path: receipt.before.policy.board_config_path,
        },
        state_digest: receipt.before.active_config_digest,
        observed_at: receipt.before.observed_at,
      },
      after: std.state_durability.StateAfterReadbackReceipt {
        perturbation_receipt_id: receipt.perturbation_receipt_id,
        target: receipt.host,
        subject: gunbc.bmc_fan_projection.BmcFanConfigReadbackSubject {
          config_path: receipt.post_reboot_policy.board_config_path,
        },
        state_digest: receipt.post_reboot_active_config_digest,
        observed_after_perturbation_completion: timing.observed_after_perturbation_completion,
      },
      activation: bmc_fan_reboot_activation_evidence(
        receipt: receipt,
        admission: admission,
      ),
    }
  } else {
    std.state_durability.StatePreservationObservationRefused {
      reason: "BMC did not return for post-boundary content and activation readback",
    }
  }
}

fn bmc_fan_reboot_durability_evidence_refusal(
  receipt: gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt,
) -> BmcFanDurabilityEvidenceConstructionRefusal? {
  if receipt.before.active_config_digest != receipt.perturbation_capability.projected_config_digest
    || receipt.post_reboot_active_config_digest != receipt.perturbation_capability.projected_config_digest {
    Present { value: DurabilityReceiptDigestMismatch }
  } else {
    match receipt.reset.reset_type {
      ResetGracefulRestart => none
      ResetForceOff =>
        Present {
          value: DurabilityReceiptBoundaryMismatch { reset_type: ResetForceOff },
        }
      ResetForceOn =>
        Present {
          value: DurabilityReceiptBoundaryMismatch { reset_type: ResetForceOn },
        }
      ResetForceRestart =>
        Present {
          value: DurabilityReceiptBoundaryMismatch { reset_type: ResetForceRestart },
        }
      ResetGracefulShutdown =>
        Present {
          value: DurabilityReceiptBoundaryMismatch { reset_type: ResetGracefulShutdown },
        }
      ResetPowerCycle =>
        Present {
          value: DurabilityReceiptBoundaryMismatch { reset_type: ResetPowerCycle },
        }
    }
  }
}

fn bmc_fan_reboot_durability_evidence_built(
  receipt: gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt,
  timing: BmcFanRebootTimingBuilt,
) -> BmcFanDurabilityEvidenceConstruction {
  let admission = bmc_fan_policy_projection_durability_admission(
    host: receipt.host,
    capability: receipt.perturbation_capability,
    perturbation_generation: receipt.perturbation_generation,
  )
  BmcFanDurabilityEvidenceBuilt {
    evidence: std.state_durability.StateDurabilityEvidence {
      admission: admission,
      perturbation: std.state_durability.StatePerturbationReceipt {
        receipt_id: receipt.perturbation_receipt_id,
        target: receipt.host,
        boundary: fleet_bmc_fan_graceful_restart_boundary,
        generation: receipt.perturbation_generation,
        started_after_before_readback: timing.started_after_before_readback,
        duration: timing.duration,
      },
      outcome: bmc_fan_reboot_preservation_outcome(
        receipt: receipt,
        admission: admission,
        timing: timing,
      ),
    },
  }
}

fn bmc_fan_reboot_durability_evidence(
  receipt: gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt,
) -> BmcFanDurabilityEvidenceConstruction {
  match bmc_fan_reboot_durability_evidence_refusal(receipt: receipt) {
    Present { value: cause } =>
      BmcFanDurabilityEvidenceConstructionRefused { cause: cause }
    Absent =>
      match bmc_fan_reboot_timing_receipt(receipt: receipt) {
        BmcFanRebootTimingReceiptRefused { cause: cause } =>
          BmcFanDurabilityEvidenceConstructionRefused { cause: cause }
        BmcFanRebootTimingReceiptBuilt { timing: timing } =>
          bmc_fan_reboot_durability_evidence_built(
            receipt: receipt,
            timing: timing,
          )
      }
  }
}

fn bmc_fan_durability_evidence_construction_refusal_reason(
  cause: BmcFanDurabilityEvidenceConstructionRefusal,
) -> String {
  match cause {
    DurabilityReceiptDigestMismatch =>
      "reboot persistence receipt active config digest does not match the perturbation capability projected config digest"
    DurabilityReceiptBoundaryMismatch { reset_type: reset_type } =>
      concat(
        "reboot persistence receipt reset boundary is not ResetGracefulRestart: ",
        redfish_reset_type_wire(r: reset_type) as String,
      )
    DurabilityReceiptNonPositiveInterval { cause: cause } =>
      concat(
        "reboot persistence receipt has a non-positive timing interval: ",
        cause.observed as String,
      )
  }
}

fn bmc_fan_durability_evidence_built_items(
  construction: BmcFanDurabilityEvidenceConstruction,
) -> List<gunbc.bmc_fan_projection.BmcFanDurabilityEvidence> {
  match construction {
    BmcFanDurabilityEvidenceBuilt { evidence: evidence } => [evidence]
    BmcFanDurabilityEvidenceConstructionRefused { cause: _ } => []
  }
}

data srv4_bmc_fan_durability_evidence_construction: BmcFanDurabilityEvidenceConstruction = bmc_fan_reboot_durability_evidence(
  receipt: srv4_bmc_fan_reboot_persistence_receipt,
)

data srv4_bmc_fan_policy_qualification_note: String = "Durability evidence is derived solely from the typed perturbation receipt, including the exact projection capability recorded at perturbation time. Admission and the graceful-restart boundary are not separately writable caller labels. Activation is established from independent controller, content, and safety readbacks; a later converge no-op is a consequence, never a premise. Ordinary convergence additionally requires the live canonical config digest to equal the admitted digest derived from the projected curve."
