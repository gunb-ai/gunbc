module gunbc.fleet_bmc_state

import extdeps.bmc.capability {
  BmcFirmwareObservation,
  BmcFirmwareVersion,
}
import extdeps.bmc.types {
  BmcConfigPersistenceObservation,
  BmcFanPolicyObservation,
  BmcFlashBackedOverlayObserved,
  BmcRedfishSurfaceObservation,
  BmcUpdateServiceObservation,
  FanPidAggregatedEntry,
  On,
  RedfishFanControlResourceAbsent,
  RedfishInitialDutyControlResource,
  RedfishLegacyChassisThermal,
  RedfishPowerState,
  RedfishThermalSubsystemSensorCollection,
}
import extdeps.crypto.hash { Digest, sha256_digest }
import gunbc.fleet_intent { srv3_baseboard, srv4_baseboard }
import gunbc.bmc_intent { fleet_bmc_valid_state }
import gunbc.bmc_fan_projection { BmcFanPolicyProjectionCapability }
import std.bmc { OpenBmc }
import std.measure {
  Celsius,
  RevolutionsPerMinute,
  byte_size,
  celsius,
  rpm,
}
import std.nat { Nat }

type BmcFanTachReceipt {
  sensor: NonEmptyStr
  reading: RevolutionsPerMinute
}

type BmcFanConvergenceReceipt {
  policy: BmcFanPolicyObservation
  persistence: BmcConfigPersistenceObservation
  projection_id: NonEmptyStr
  active_config_digest: Digest
  previous_config_digest: Digest
  zone_control_path: NonEmptyStr
  zone_failsafe_active: Bool
  monitoring_sample_count: Nat
  monitoring_duration_seconds: Nat
  temp_soc_minimum: Celsius
  temp_soc_maximum: Celsius
  temp_soc_final: Celsius
  guarded_component_maximum: Celsius
  final_tachs: List<BmcFanTachReceipt>
  observed_at: NonEmptyStr
}

type BmcFanRebootPersistenceReceipt {
  before: BmcFanConvergenceReceipt
  post_reboot_policy: BmcFanPolicyObservation
  reset_action_target: NonEmptyStr
  reset_type: NonEmptyStr
  reset_http_status: Nat
  bmc_down_observed: Bool
  bmc_returned: Bool
  bmc_down_observed_at: NonEmptyStr
  bmc_returned_at: NonEmptyStr
  observed_outage_seconds: Nat
  host_power_before: RedfishPowerState
  host_power_after: RedfishPowerState
  host_os_ssh_reachable_throughout: Bool
  pre_reboot_temp_soc: Celsius
  post_reboot_temp_soc: Celsius
  pre_reboot_tachs: List<BmcFanTachReceipt>
  post_reboot_tachs: List<BmcFanTachReceipt>
  post_reboot_active_config_digest: Digest
  post_reboot_controller_active: Bool
  post_reboot_zone_failsafe_active: Bool
  post_reboot_observer_exit_success: Bool
  post_reboot_converge_noop_exit_success: Bool
  observed_at: NonEmptyStr
}

