// Byte total of a roster, summed from each member's ByteSize as a plain count.
fn parse_population_byte_total(rows: List<KeyedRow<String, ParsePopulationRow>>) -> Int {
  fold_list(xs: rows, empty: 0, cons: fn(acc, row) { acc + byte_size_count(b: row.value.bytes) })
}

// Disjointness/uniqueness CHECK: the keyed build over all 170 refuses a repeated path. A roster
// that silently gained a duplicate turns this to KeyedRosterBuildDuplicateKey, and the witness
// asserts the Built arm.
fn parse_population_build() -> KeyedRosterBuild<String, ParsePopulationRow> {
  keyed_roster_build(incomings: parse_population_baseline_rows(), key_eq: fn(a, b) { a == b })
}

// The three cardinalities the witness reports: whole roster, and each fixed population.
fn parse_population_total_count() -> Int {
  count_where(xs: parse_population_baseline_rows(), predicate: fn(_row) { true })
}

fn parse_population_five_largest_count_check() -> Int {
  count_where(xs: parse_population_baseline_rows(), predicate: fn(row) { row.value.membership == FiveLargest })
}

fn parse_population_one_hundred_sixty_five_count_check() -> Int {
  count_where(xs: parse_population_baseline_rows(), predicate: fn(row) { row.value.membership == OneHundredSixtyFive })
}

// Select n when the membership matches, else 0. Branches are call-free so the block parses.
fn parse_population_select(m: ParsePopulationMembership, want: ParsePopulationMembership, n: Int) -> Int {
  if m == want { n } else { 0 }
}

fn parse_population_row_bytes(row: KeyedRow<String, ParsePopulationRow>) -> Int {
  byte_size_count(b: row.value.bytes)
}

// Per-population byte totals: each folds the whole roster, counting bytes only for its own members.
fn parse_population_five_largest_byte_total() -> Int {
  fold_list(xs: parse_population_baseline_rows(), empty: 0, cons: fn(acc, row) {
    acc + parse_population_select(row.value.membership, FiveLargest, parse_population_row_bytes(row))
  })
}

fn parse_population_one_hundred_sixty_five_byte_total() -> Int {
  fold_list(xs: parse_population_baseline_rows(), empty: 0, cons: fn(acc, row) {
    acc + parse_population_select(row.value.membership, OneHundredSixtyFive, parse_population_row_bytes(row))
  })
}

fn parse_population_total_byte_total() -> Int {
  fold_list(xs: parse_population_baseline_rows(), empty: 0, cons: fn(acc, row) {
    acc + parse_population_row_bytes(row)
  })
}

// The whole 170-key roster builds with a genuine key equality: no path repeats, so both fixed
// populations are disjoint by construction. Returns true only for the Built arm.
fn parse_population_is_unique() -> Bool {
  match parse_population_build() {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

// The negative control: the SAME fold over the SAME 170 rows, but with key_eq that always returns
// true, must land on the DuplicateKey arm (the second row collides with the first). If this ever
// returned Built, the uniqueness verdict above would be vacuous.
fn parse_population_duplicate_refuses_with_trivial_eq() -> Bool {
  match keyed_roster_build(incomings: parse_population_baseline_rows(), key_eq: fn(a, b) { true }) {
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
    KeyedRosterBuilt { rows: _ } => false
  }
}
