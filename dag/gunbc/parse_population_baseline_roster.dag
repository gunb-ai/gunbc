module gunbc.parse_population_baseline_roster

import std.types { Bool, Int, List, String }
import std.measure { ByteSize, byte_size, byte_size_count }
import std.keyed_row { KeyedRow }
import std.keyed_roster { KeyedRosterBuild, KeyedRosterBuilt, keyed_roster_build }
import std.algebra { count_where, fold_list }

// THE PARSE-POPULATION BASELINE ROSTER (roadmap row gunbc.roadmap.roadmap_authority row id
// `emission-real-consumer-profiles`). This carrier is the SINGLE AUTHORITY for the two fixed parse
// populations the row's first_slice names ("the 5 largest dag modules and a 165-module sample"):
// the selection rule, the membership, each member's byte size and population rank, and the pinned
// tree sha they were measured over. The markdown under docs/plans/ is an evidence RECORD of the
// measured cells only; it points here and holds no copy of the selection rule or roster
// (gunbc.design_argument::planning_has_one_home).
//
// SELECTION RULE (regenerable, deterministic): every `.dag` file under `dag/` and `src/v2/` at the
// pinned sha below, taken by BLOB SIZE from the tree objects (`git ls-tree -r -l <sha> -- dag src/v2`),
// sorted DESCENDING by size then ASCENDING by path for a stable tiebreak. Positions 1..5 are
// Population FiveLargest; positions 6..170 are Population OneHundredSixtyFive. The two populations
// are DISJOINT BY CONSTRUCTION (contiguous ranks over one ordering), and the keyed_roster_build
// over the whole 170 REFUSES a repeated path, so disjointness and uniqueness are CHECKED, not
// asserted.
//
// PRODUCER / REPRODUCTION: regenerate the exact row list at the pinned sha with
//   git ls-tree -r -l <pinned_sha> -- dag src/v2 \
//     | awk '$5 ~ /\.dag$/ {print $4"\t"$5}' | sort -t$'\t' -k1,1nr -k2,2 | head -170
// and diff against parse_population_baseline_rows() below; the rostered claim
// test.claim.parse_population_baseline_roster_witness re-checks cardinality and byte totals, so a
// roster that silently lost or gained a row turns red rather than under-reporting
// (gunbc.design_argument::checks_must_prove_they_measured).

// The tree sha the populations were selected and measured over (origin/main at baseline time).
data parse_population_baseline_pinned_sha: String =
  "65230868362de3efc0ddfeeaeef5d83eeb2fa385"

// Population cardinalities the row names as the fixed benchmark.
data parse_population_five_largest_count: Int = 5
data parse_population_one_hundred_sixty_five_count: Int = 165

// Which fixed population a member belongs to.
type ParsePopulationMembership
  = FiveLargest
  | OneHundredSixtyFive

// One roster member: its repo-relative path, its blob byte size, and its population rank (1..170).
type ParsePopulationRow {
  path: String
  bytes: ByteSize
  rank: Int
  membership: ParsePopulationMembership
}

// The full 170-member roster, keyed by path (duplicate path refuses at build).
fn parse_population_baseline_rows() -> List<KeyedRow<String, ParsePopulationRow>> {
  [
    KeyedRow { row_key: "dag/gunbc/roadmap/roadmap_authority.dag", value: ParsePopulationRow { path: "dag/gunbc/roadmap/roadmap_authority.dag", bytes: byte_size(count: 1421761), rank: 1, membership: FiveLargest } },
    KeyedRow { row_key: "dag/gunbc/roadmap/roadmap_belt_actuate.dag", value: ParsePopulationRow { path: "dag/gunbc/roadmap/roadmap_belt_actuate.dag", bytes: byte_size(count: 947773), rank: 2, membership: FiveLargest } },
    KeyedRow { row_key: "dag/product/p4261/e1_receipt_markings.dag", value: ParsePopulationRow { path: "dag/product/p4261/e1_receipt_markings.dag", bytes: byte_size(count: 750634), rank: 3, membership: FiveLargest } },
