  ParsePopulationRow { path: "dag/gunbc/roadmap/roadmap_event_carrier.dag", bytes: byte_size(count: 95582) },
  ParsePopulationRow { path: "dag/test/claim/network_boot_delivery_join_witness.dag", bytes: byte_size(count: 95568) },
  ParsePopulationRow { path: "dag/std/algebra.dag", bytes: byte_size(count: 95247) },
  ParsePopulationRow { path: "dag/gunbc/roadmap/roadmap_style.dag", bytes: byte_size(count: 95210) },
  ParsePopulationRow { path: "src/v2/test/claim/native_route_progress_guard_witness.dag", bytes: byte_size(count: 94832) },
  ParsePopulationRow { path: "src/v2/workflow/native_route_progress_guard.dag", bytes: byte_size(count: 94159) },
  ParsePopulationRow { path: "dag/gunbc/compute/host_capacity.dag", bytes: byte_size(count: 94155) },
  ParsePopulationRow { path: "dag/std/measure.dag", bytes: byte_size(count: 94133) },
  ParsePopulationRow { path: "dag/test/claim/machine_intake/bmc_first_contact_reading_witness.dag", bytes: byte_size(count: 94001) },
  ParsePopulationRow { path: "dag/test/claim/spark/pair_serving_authority_log_witness.dag", bytes: byte_size(count: 93103) },
  ParsePopulationRow { path: "dag/gunbc/v1/v1_interpreter_primitive_surface.dag", bytes: byte_size(count: 92781) },
  ParsePopulationRow { path: "dag/gunbc/site/gunb_ai_css.dag", bytes: byte_size(count: 92614) },
  ParsePopulationRow { path: "src/v2/extdeps/languages/swift.dag", bytes: byte_size(count: 92576) },
]

// ---- derived queries (rank from position, membership from rank) ----

// Whole-roster byte total, summed IN the ByteSize measure the rows already carry. The count is
// unwrapped only at the rendering boundary in parse_population_baseline_report, so no bare Int
// re-represents a byte quantity the model already types (gunbc.design_argument::minimize_redundancy,
// gunbc.design_argument::single_authority).
fn parse_population_total_byte_total() -> ByteSize {
  fold_list(xs: parse_population_baseline_rows, empty: byte_size(count: 0), cons: fn(acc, row) {
    measure_add(acc, row.bytes)
  })
}

// Whole-roster cardinality.
fn parse_population_total_count_of(rows: List<ParsePopulationRow>) -> Int {
  count_where(xs: rows, predicate: fn(_row) { true })
}

// Whole-roster cardinality of the fixed benchmark roster.
fn parse_population_total_count() -> Int {
  parse_population_total_count_of(parse_population_baseline_rows)
}

// Cardinality predicate over an ARBITRARY roster (arg-taking so BOTH arms are exercised, mirroring
// the ordering probes): true iff the roster has exactly the expected benchmark size. Feeds the
// discriminating cardinality leg (warm-fox rule: a check must prove it measured by a named negative
// failing in the same run; review 98328 -- a claim that asserts only total==170 is one number and
// cannot fail on its own; the planted-row refusal below is what makes it discriminate).
fn parse_population_cardinality_predicate(rows: List<ParsePopulationRow>) -> Bool {
  parse_population_total_count_of(rows) == parse_population_expected_total_count
}

// ACCEPT arm: the real benchmark roster must satisfy the predicate (its count is exactly 170).
fn parse_population_cardinality_accepts_real() -> Bool {
  parse_population_cardinality_predicate(parse_population_baseline_rows) == true
}

// A roster with one row PLANTED (duplicated-path member pushed onto the real roster). Same fold +
// same predicate, one extra member -- so its count is 171 and the predicate must REFUSE it.
fn parse_population_planted_extra_row() -> List<ParsePopulationRow> {
  list_push(xs: parse_population_baseline_rows,
    item: ParsePopulationRow { path: "probe/planted_extra.dag", bytes: byte_size(count: 1) })
}

// REFUSE arm: the predicate must say FALSE on the planted-extra roster. If count_where were broken
// to always return 170, accepts_real would still pass but refuses_planted would FAIL; if it always
// returned the true count, both arms hold only when the roster is genuinely 170. Together the two
// arms make the cardinality leg discriminating (gunbc.design_ruling::executed_red_control_names_its_failing_commit).
fn parse_population_cardinality_refuses_planted_extra_row() -> Bool {
  parse_population_cardinality_predicate(parse_population_planted_extra_row()) == false
}

// b when the 1-based position is a FiveLargest slot, else the zero measure. Call-free branches so
// the block parses.
fn parse_population_select_five(position: Int, b: ByteSize) -> ByteSize {
  if position <= parse_population_five_largest_count { b } else { byte_size(count: 0) }
}

fn parse_population_select_rest(position: Int, b: ByteSize) -> ByteSize {
  if position <= parse_population_five_largest_count { byte_size(count: 0) } else { b }
}

// Scan accumulator carrying the 1-based position while summing the two population byte totals, both
// held in the ByteSize measure. The FiveLargest "is the largest five" property is NOT re-checked here:
// parse_population_check_rows_ordered_descending already enforces row.bytes <= prev on every adjacent
// pair, so the first five positions are the largest five by construction. Re-checking a boundary size
// would be a second representation of that constraint (gunbc.design_argument::fail_closed: "a check
// restating a constraint the model already carries").
type ParsePopulationScan {
  position: Int
  five_bytes: ByteSize
  rest_bytes: ByteSize
}

fn parse_population_scan(rows: List<ParsePopulationRow>) -> ParsePopulationScan {
  fold_list(xs: rows,
    empty: ParsePopulationScan {
      position: 0, five_bytes: byte_size(count: 0), rest_bytes: byte_size(count: 0),
    },
    cons: fn(acc, row) {
      let next: Int = acc.position + 1
      ParsePopulationScan {
        position: next,
        five_bytes: measure_add(acc.five_bytes, parse_population_select_five(next, row.bytes)),
        rest_bytes: measure_add(acc.rest_bytes, parse_population_select_rest(next, row.bytes)),
      }
    })
}

// No row may have a zero byte count: a roster that silently collapsed to empty or zeroed rows fails,
// so a 0 population is reported as a refusal rather than a pass.
fn parse_population_zero_byte_row_count() -> Int {
  count_where(xs: parse_population_baseline_rows, predicate: fn(row) { row.bytes == byte_size(count: 0) })
}

// The two populations are a disjoint cover of the roster: the FiveLargest total plus the remaining
// total equals the whole-roster total. Derived from the roster, not copied from a tree read, so it is
// a real check rather than the fail_closed "count copied from the current tree" change detector. It
// catches an off-by-one in the position-based split (select_five/select_rest disagreeing on a row).
fn parse_population_partition_is_consistent() -> Bool {
  measure_add(parse_population_five_largest_byte_total(), parse_population_one_hundred_sixty_five_byte_total())
    == parse_population_total_byte_total()
}

fn parse_population_five_largest_byte_total() -> ByteSize {
  parse_population_scan(parse_population_baseline_rows).five_bytes
}

fn parse_population_one_hundred_sixty_five_byte_total() -> ByteSize {
  parse_population_scan(parse_population_baseline_rows).rest_bytes
}

// The selection rule, EXECUTED not only commented (gunbc.design_argument::source_annotations: a
// fact that must survive belongs in a typed carrier; nothing may depend on a comment for
// correctness). The load-bearing invariant of "the 5 largest ... and a 165-module sample, taken by
// blob size descending" is that the roster is NON-INCREASING in byte size along list order: every
// member's size is <= its predecessor's. A byte count edited out of order, or a member swapped so a
// smaller file precedes a larger one, fails this. The comparison uses std.measure::measure_le over
// the ByteSize the rows carry (no Int unwrap). The byte-exact extraction of the 170 largest `.dag`
// blobs at the pinned sha is the external producer (the reproduce command), which can be diffed
// against these rows at that sha; the ordering invariant below is what the interpreter can judge.
type ParseOrderScan {
  started: Bool
  prev: ByteSize
  ok: Bool
}

// General ordering check (arg-taking, so BOTH arms can be exercised, not just the fixed roster):
// the list must be non-increasing in byte size along position. Returns false the first time a
// member is larger than its predecessor.
fn parse_population_check_rows_ordered_descending(rows: List<ParsePopulationRow>) -> Bool {
  let step = fold_list(xs: rows,
    empty: ParseOrderScan { started: false, prev: byte_size(count: 0), ok: true },
    cons: fn(acc, row) {
      let le: Bool = measure_le(a: row.bytes, b: acc.prev)
      let step_ok: Bool = if acc.started == false { true } else { le }
      ParseOrderScan { started: true, prev: row.bytes, ok: acc.ok && step_ok }
    })
  step.ok
}

// The fixed roster, ordered descending (the ACCEPT arm on the real population).
fn parse_population_rows_ordered_descending() -> Bool {
  parse_population_check_rows_ordered_descending(parse_population_baseline_rows)
}

// DISCRIMINATION PROBES. A check that only ever sees already-sorted rows passes whatever the
// emitter does (the leg-lifecycle failure mode: green on a wrong compiler). These feed the SAME fold
// synthetic rows so it must actually refuse a bad order and accept a good one.
//   accepts_descending: 30,20,10 (non-increasing) -> the check must say true.
//   refuses_ascending:  10,20,30 (an ascending step) -> the check must say false.
// If the fold were broken to always return true, refuses_ascending would FAIL; if always false,
// accepts_descending would FAIL. Together they prove the invariant is discriminating, not vacuous
// (gunbc.design_ruling::executed_red_control_names_its_failing_commit).
fn parse_population_rows_descending() -> List<ParsePopulationRow> {
  [
    ParsePopulationRow { path: "probe/large.dag", bytes: byte_size(count: 30) },
    ParsePopulationRow { path: "probe/middle.dag", bytes: byte_size(count: 20) },
    ParsePopulationRow { path: "probe/small.dag", bytes: byte_size(count: 10) },
  ]
}

fn parse_population_rows_ascending() -> List<ParsePopulationRow> {
  [
    ParsePopulationRow { path: "probe/small.dag", bytes: byte_size(count: 10) },
    ParsePopulationRow { path: "probe/middle.dag", bytes: byte_size(count: 20) },
    ParsePopulationRow { path: "probe/large.dag", bytes: byte_size(count: 30) },
  ]
}

fn parse_population_ordering_accepts_descending() -> Bool {
  parse_population_check_rows_ordered_descending(parse_population_rows_descending()) == true
}

fn parse_population_ordering_refuses_ascending() -> Bool {
  parse_population_check_rows_ordered_descending(parse_population_rows_ascending()) == false
}

// Cardinalities derived from the scan's position (== whole roster) and the fixed split.
fn parse_population_five_largest_count_check() -> Int {
  if parse_population_total_count() >= parse_population_five_largest_count {
    parse_population_five_largest_count
  } else {
    parse_population_total_count()
  }
}

fn parse_population_one_hundred_sixty_five_count_check() -> Int {
  let total: Int = parse_population_total_count()
  if total >= parse_population_five_largest_count {
    total - parse_population_five_largest_count
  } else {
    0
  }
}

// Path uniqueness CHECK: map each member to a KeyedRow keyed by its own path (the single stored
// path) and build through std.keyed_roster, which refuses a repeated key. True only for the Built
// arm, so a roster that silently gained a duplicate path turns red rather than under-reporting.
fn parse_population_to_keyed(rows: List<ParsePopulationRow>) -> List<KeyedRow<String, ParsePopulationRow>> {
  fold_list(xs: rows, empty: [], cons: fn(acc, row) {
    list_push(xs: acc, item: KeyedRow { row_key: row.path, value: row })
  })
}

fn parse_population_is_unique() -> Bool {
  match keyed_roster_build(incomings: parse_population_to_keyed(parse_population_baseline_rows), key_eq: fn(a, b) { a == b }) {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

// The negative control: the SAME build over the SAME rows with a trivial always-equal key_eq must
// land on DuplicateKey (the second row collides with the first). If this ever returned Built the
// uniqueness verdict would be vacuous. Proven by the executed red control
// (gunbc.design_ruling::executed_red_control_names_its_failing_commit).
fn parse_population_duplicate_refuses_with_trivial_eq() -> Bool {
  match keyed_roster_build(incomings: parse_population_to_keyed(parse_population_baseline_rows), key_eq: fn(a, b) { true }) {
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
    KeyedRosterBuilt { rows: _ } => false
  }
}

// A String report the interpreter prints so a raw run line carries each field name next to its
// value (the checks-prove-they-measured posture, ruled by
// gunbc.design_ruling::executed_red_control_names_its_failing_commit: a passing verdict must name
// what it actually measured).
fn parse_population_baseline_report() -> String {
  join([
    "parse_population_total_count=", to_string(parse_population_total_count()),
    " parse_population_five_largest_count=", to_string(parse_population_five_largest_count_check()),
    " parse_population_one_hundred_sixty_five_count=", to_string(parse_population_one_hundred_sixty_five_count_check()),
    " parse_population_five_largest_bytes=", to_string(byte_size_count(b: parse_population_five_largest_byte_total())),
    " parse_population_one_hundred_sixty_five_bytes=", to_string(byte_size_count(b: parse_population_one_hundred_sixty_five_byte_total())),
    " parse_population_total_bytes=", to_string(byte_size_count(b: parse_population_total_byte_total())),
    " parse_population_unique=", to_string(if parse_population_is_unique() { 1 } else { 0 }),
    " parse_population_duplicate_refuses_with_trivial_eq=", to_string(if parse_population_duplicate_refuses_with_trivial_eq() { 1 } else { 0 }),
    "",
  ], "")
}

