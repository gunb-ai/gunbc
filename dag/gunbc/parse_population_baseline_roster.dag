module gunbc.parse_population_baseline_roster

import std.types { Bool, Int, List, String }
import std.measure { ByteSize, byte_size, measure_add, measure_le }
import std.keyed_row { KeyedRow }
import std.keyed_roster { KeyedRosterBuild, KeyedRosterBuilt, keyed_roster_build }
import std.algebra { count_where, fold_list, list_push }

// THE PARSE-POPULATION BASELINE ROSTER: the single typed authority for the two fixed parse
// populations named by roadmap row emission-real-consumer-profiles first_slice ("the 5 largest dag
// modules and a 165-module sample"). The markdown under docs/plans/ records the measured cells only and
// points here; it holds no copy of the rule (gunbc.design_argument::planning_has_one_home).
//
// MODELLED ONCE (gunbc.design_argument::minimize_redundancy): each member stores ONLY its path and byte
// size, in list order; its population rank is its 1-based position and its membership is DERIVED from
// rank (first parse_population_five_largest_count rows = FiveLargest, the rest = OneHundredSixtyFive).
//
// SELECTION RULE (regenerable, deterministic): every .dag under dag/ and src/v2/ at the pinned sha, taken
// by BLOB SIZE from the tree objects (git ls-tree -r -l <sha> -- dag src/v2), sorted DESCENDING by size
// then ASCENDING by path for a stable tiebreak. Positions 1..5 = FiveLargest; 6..170 = OneHundredSixtyFive.
//
// LOAD-BEARING, RECONCILED AGAINST THE TREE (gunbc.design_argument::consumption): the 170 rows are tied to
// the tree by an EXECUTED reconciliation leg in the measurement report — the carrier rows are diffed
// against git ls-tree -r -l <pinned_sha> -- dag src/v2 (top 170 by that sort): GREEN diff rc 0 means every
// path AND byte size equals the tree; a single mistyped row drives it RED (rc nonzero). That mistyped real
// row is the red control (a real wrong row, not a planted constant), and the parse_population_reconcile_*
// predicates below are its discriminating carrier. Authorization, review history and the acquisition record
// live in the PR body and its comments, not in this header (gunbc.design_argument::source_annotations).
// The tree sha the populations were selected and measured over (origin/main at baseline time).
data parse_population_baseline_pinned_sha: String =
  "65230868362de3efc0ddfeeaeef5d83eeb2fa385"

// How many of the leading rows form the Five Largest population. Membership is DERIVED from this
// and the row's position; it is not stored per row.
data parse_population_five_largest_count: Int = 5

// The fixed benchmark size the two populations must have, asserted by the cardinality predicate
// (consumed by parse_population_cardinality_accepts_real / _refuses_planted_extra_row, so not dead
// data). It is the row's two fixed populations: 5 largest + a 165-module sample = 170. Paired with a
// planted-row refusal so the count is discriminating, not a constant readback (warm-fox rule: a check
// must prove it measured; review 98328).
data parse_population_expected_total_count: Int = 170

// DECLARED DEPARTURE (gunbc.design_argument::epistemic_humility): the row calls the second population
// "a 165-module sample"; as SELECTED it is NOT a uniform/stratified sample — it is the NEXT 165 files by
// DESCENDING blob size (ranks 6..170 of the size sort), a SIZE-TAIL sample. Both populations therefore sit
// in the heavy tail; the per-byte figures are a tail-vs-tail comparison and assert nothing about the corpus
// size mix. The size-descending selection is enforced executably by parse_population_check_rows_ordered_descending
// and the 170-size by the cardinality probes; a representative sample would need a seeded sampling rule
// over the full population (a re-measurement, not this slice). The substantive checks are executable, not
// asserted as deduced.
// One roster member: its repo-relative path and its blob byte size. Rank and population follow from
// position in parse_population_baseline_rows().
type ParsePopulationRow {
  path: String
  bytes: ByteSize
}

