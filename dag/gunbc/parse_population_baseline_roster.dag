module gunbc.parse_population_baseline_roster

import std.types { Bool, Int, List, String }
import std.measure { ByteSize, byte_size, byte_size_count, measure_add, measure_le }
import std.keyed_row { KeyedRow }
import std.keyed_roster { KeyedRosterBuild, KeyedRosterBuilt, keyed_roster_build }
import std.algebra { count_where, fold_list, list_push }

// THE PARSE-POPULATION BASELINE ROSTER (roadmap row gunbc.roadmap.roadmap_authority row id
// `emission-real-consumer-profiles`). This carrier is the SINGLE AUTHORITY for the two fixed parse
// populations the row's first_slice names ("the 5 largest dag modules and a 165-module sample").
// The markdown under docs/plans/ is an evidence RECORD of the measured cells only; it points here
// and holds no copy of the selection rule or roster (gunbc.design_argument::planning_has_one_home).
//
// MODELLED ONCE (gunbc.design_argument::minimize_redundancy, gunbc.design_argument::fail_closed):
// each member stores ONLY its path and its byte size, in list order. Its population RANK is its
// 1-based position in the list and its population MEMBERSHIP is derived from rank (the first
// parse_population_five_largest_count rows are FiveLargest, the rest OneHundredSixtyFive). Nothing
// is written twice, so a row cannot disagree with itself about path, rank or membership.
//
// SELECTION RULE (regenerable, deterministic): every `.dag` file under `dag/` and `src/v2/` at the
// pinned sha below, taken by BLOB SIZE from the tree objects (`git ls-tree -r -l <sha> -- dag src/v2`),
// sorted DESCENDING by size then ASCENDING by path for a stable tiebreak. Positions 1..5 are
// Population FiveLargest; positions 6..170 are Population OneHundredSixtyFive, disjoint by position.
//
// PRODUCER / REPRODUCTION: regenerate the exact ordered row list at the pinned sha with
//   git ls-tree -r -l <pinned_sha> -- dag src/v2 \
//     | awk '$5 ~ /\.dag$/ {print $4"\t"$5}' | sort -t$'\t' -k1,1nr -k2,2 | head -170
// and diff against parse_population_baseline_rows() below. The rostered claim
// test.claim.parse_population_baseline_roster_witness re-checks cardinality, per-population byte
// totals and path-uniqueness, and an executed red control (a planted false claim) proves the run
// discriminates rather than passing on nothing (gunbc.design_ruling::executed_red_control_names_its_failing_commit).
//
// CONSUMER AND EXECUTING ROUTE (gunbc.design_argument::consumption): the named consumer is the
// rostered claim module test.claim.parse_population_baseline_roster_witness, which imports these
// functions and asserts their cardinality and byte totals; its executing route is a claim_batch run
// of that module on srv1, posted as the PR run link. gunbc CI executes NO claims (repo policy until
// the native frontier clears; claim_executor --required-ci is an ingestion-only stub and the manual
// required-floor runner was deleted 2026-10-14), so a required_floor entry would be a name with no
// route. Wiring this witness into an executed CI lane is a DECLARED LATER FRONTIER with its trigger:
// the prerequisite row (per-phase counters in the parse-population verb). That row is ABSENT at main
// today (own grep, origin/main roadmap_authority.dag: id values containing "counter" = 0 hits / exit 1;
// containing "phase" = 3, none a per-phase-counters verb row), so the trigger does not yet exist and
// consumption of these rows beyond this witness is explicitly OPEN, not claimed. A new node enters the
// plan only via a planning PR (lane-manager queue), not authored by this row (fenced from the plan). When
// that prerequisite lands and CI begins executing claims, this witness joins the executed CI lane.

// The tree sha the populations were selected and measured over (origin/main at baseline time).
data parse_population_baseline_pinned_sha: String =
  "65230868362de3efc0ddfeeaeef5d83eeb2fa385"

// How many of the leading rows form the Five Largest population. Membership is DERIVED from this
// and the row's position; it is not stored per row.
data parse_population_five_largest_count: Int = 5

// The fixed benchmark size the two populations must have, asserted by the cardinality predicate
// (consumed by parse_population_cardinality_accepts_real / _refuses_planted_extra_row, so not dead
// data). It is the row's two fixed populations: 5 largest + a 165-module sample = 170. Paired with a
// planted-row refusal so the count is discriminating, not a constant readback (warm-fox rule: a check
// must prove it measured; review 98328).
data parse_population_expected_total_count: Int = 170

// DECLARED DEPARTURE (gunbc.design_argument::epistemic_humility: "assert as deduced only what is
// deduced; review 98282/98328: kept as a // annotation only, NOT a typed value, so no dead data is
// introduced; the substantive size-descending selection is enforced EXECUTABLY by
// parse_population_check_rows_ordered_descending, and the 170-size by the cardinality probes below).
// The row's first_slice calls the second population "a 165-module sample". As SELECTED it
// is NOT a uniform or stratified sample of the corpus: it is the NEXT 165 files by DESCENDING blob
// size (ranks 6..170 of the size sort), i.e. a SIZE-TAIL sample. Both populations therefore sit in the
// heavy tail of the file-size distribution; neither represents the whole-corpus size mix.
// Why the tail is chosen deliberately: it is deterministic and reproducible at the pinned sha with no
// RNG seed to pin and no sampling-rule drift, and it loads the verb with its heaviest inputs — the
// costliest, most adversarial workload for the parse-population control the row's displaced_cost names.
// CONSEQUENCE (what is and is not deduced): the per-byte wall figures are a tail-vs-tail comparison,
// NOT a statement about the corpus distribution. No claim is asserted that this population represents
// the corpus, and the report's §6 per-byte number stays a scaling warning pending a controlled
// one-shape size series. To make it a representative sample would require a seeded, declared sampling
// rule over the full population — that is a re-measurement, not in this slice.

// One roster member: its repo-relative path and its blob byte size. Rank and population follow from
// position in parse_population_baseline_rows().
type ParsePopulationRow {
  path: String
  bytes: ByteSize
}

