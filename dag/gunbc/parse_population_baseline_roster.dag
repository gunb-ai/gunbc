  ParsePopulationRow { path: "src/v2/extdeps/languages/swift.dag", bytes: byte_size(count: 92576) },
]

// ---- measurement receipts (typed home; review 98937 F4; retyped per review 98981) ----

// One srv1 cell of the fixed-workload baseline sweep. Units live in TYPES, not field names
// (gunbc.design_argument::minimize_redundancy): peak RSS is a ByteSize, every duration a std.measure
// Microsecond (printed seconds x 1_000_000, exact at the printed 2 decimals), and the two kinds of
// measurement — repeated wall-clock runs vs one getrusage capture — are separate variants with named
// parts, not prose in a String (review 98981: "A String leaf hiding named parts is anemic
// modeling"; cell E no longer repeats the RSS fact that peak_rss already carries).
type ParsePopulationMeasurementReceipt {
  cell: NonEmptyStr
  population: NonEmptyStr
  runs: Int
  measurement: ParsePopulationCellMeasurement
  peak_rss: ByteSize
  modules: Int
  declared_refusals: Int
  rc: Int
  binary_sha256: Sha256Digest
  tree_sha: CommitSha
  host: NonEmptyStr
  boot_id: NonEmptyStr
}

// The cell's timing kind: A/B/C/REF are repeated wall-clock runs of the verb; E is a single
// getrusage capture (/usr/bin/time -v) proving the non-perf counters are present (perf sampling is
// refused on the host, report §2). Each fact is named once.
type ParsePopulationCellMeasurement
  = WallStat { min_wall: Microsecond, median_wall: Microsecond, max_wall: Microsecond }
  | ProcessTimes { utime: Microsecond, stime: Microsecond, minor_faults: Int, major_faults: Int,
                   voluntary_ctx_switches: Int, involuntary_ctx_switches: Int }

// The printed counters as published by the run, in their units; rc is the command's own exit status
// (RC=$? immediately after the run, never a pipe); provenance is the binary sha read from disk, the
// tree sha built, host and boot id. The markdown report renders these rows for humans; THIS binding
// is their one typed home (gunbc.design_argument::source_annotations). Consumer:
// test.claim.parse_population_baseline_roster_witness (publishability + refusal legs, and the
// duration-ordering discriminator), green by execution pending (A/B/C).
data parse_population_measurement_receipts: List<ParsePopulationMeasurementReceipt> = [
  ParsePopulationMeasurementReceipt { cell: "REF", population: "full dag+src/v2 roots", runs: 1,
    measurement: WallStat { min_wall: microsecond(count: 563940000),
      median_wall: microsecond(count: 563940000), max_wall: microsecond(count: 563940000) },
    peak_rss: byte_size(count: 673443840), modules: 10567, declared_refusals: 0, rc: 0,
    binary_sha256: Sha256Digest { hex: "530e9847e475df1b5f304ee2d943c61e4fb9e615383a5dbbb4794162c487a150" },
    tree_sha: "65230868362de3efc0ddfeeaeef5d83eeb2fa385" as CommitSha,
    host: "srv1.tailecbe08.ts.net",
    boot_id: "c095c0cd-1eaa-4bc7-861d-2bd9756c2bc4" },
  ParsePopulationMeasurementReceipt { cell: "A", population: "Five Largest (5)", runs: 3,
    measurement: WallStat { min_wall: microsecond(count: 20160000),
      median_wall: microsecond(count: 22790000), max_wall: microsecond(count: 23300000) },
    peak_rss: byte_size(count: 669093888), modules: 5, declared_refusals: 0, rc: 0,
    binary_sha256: Sha256Digest { hex: "530e9847e475df1b5f304ee2d943c61e4fb9e615383a5dbbb4794162c487a150" },
    tree_sha: "65230868362de3efc0ddfeeaeef5d83eeb2fa385" as CommitSha,
    host: "srv1.tailecbe08.ts.net",
    boot_id: "c095c0cd-1eaa-4bc7-861d-2bd9756c2bc4" },
  ParsePopulationMeasurementReceipt { cell: "B", population: "165-Sample (size tail)", runs: 3,
    measurement: WallStat { min_wall: microsecond(count: 132190000),
      median_wall: microsecond(count: 132510000), max_wall: microsecond(count: 143840000) },
    peak_rss: byte_size(count: 503054336), modules: 166, declared_refusals: 0, rc: 0,
    binary_sha256: Sha256Digest { hex: "530e9847e475df1b5f304ee2d943c61e4fb9e615383a5dbbb4794162c487a150" },
    tree_sha: "65230868362de3efc0ddfeeaeef5d83eeb2fa385" as CommitSha,
    host: "srv1.tailecbe08.ts.net",
    boot_id: "c095c0cd-1eaa-4bc7-861d-2bd9756c2bc4" },
  ParsePopulationMeasurementReceipt { cell: "C", population: "165-Sample verdict-only (--reuse-from)", runs: 1,
    measurement: WallStat { min_wall: microsecond(count: 136660000),
      median_wall: microsecond(count: 136660000), max_wall: microsecond(count: 136660000) },
    peak_rss: byte_size(count: 500129792), modules: 166, declared_refusals: 0, rc: 0,
    binary_sha256: Sha256Digest { hex: "530e9847e475df1b5f304ee2d943c61e4fb9e615383a5dbbb4794162c487a150" },
    tree_sha: "65230868362de3efc0ddfeeaeef5d83eeb2fa385" as CommitSha,
    host: "srv1.tailecbe08.ts.net",
    boot_id: "c095c0cd-1eaa-4bc7-861d-2bd9756c2bc4" },
  ParsePopulationMeasurementReceipt { cell: "E", population: "instrument-check, roots_pop5 (getrusage, not perf)", runs: 1,
    measurement: ProcessTimes { utime: microsecond(count: 28920000), stime: microsecond(count: 610000),
      minor_faults: 160128, major_faults: 0, voluntary_ctx_switches: 2, involuntary_ctx_switches: 212 },
    peak_rss: byte_size(count: 668962816), modules: 5, declared_refusals: 0, rc: 0,
    binary_sha256: Sha256Digest { hex: "530e9847e475df1b5f304ee2d943c61e4fb9e615383a5dbbb4794162c487a150" },
    tree_sha: "65230868362de3efc0ddfeeaeef5d83eeb2fa385" as CommitSha,
    host: "srv1.tailecbe08.ts.net",
    boot_id: "c095c0cd-1eaa-4bc7-861d-2bd9756c2bc4" },
]

// Publishability, the sweep's own rule in types: every cell real rc 0 (from the command, not a pipe),
// zero declared refusals (comparability with the reference run), positive runs / modules / peak RSS
// (compared IN the ByteSize measure, no bare-scalar read of a quantity), srv1 host tag. Built for the
// list parameter, not the binding, so the witness can plant a bad receipt and watch this refuse
// (gunbc.design_argument::fail_closed).
fn parse_population_receipts_are_publishable(receipts: List<ParsePopulationMeasurementReceipt>) -> Bool {
  fold_list(xs: receipts, empty: true, cons: fn(acc, r) {
    acc && r.rc == 0 && r.declared_refusals == 0 && r.runs > 0 && r.modules > 0
      && measure_le(a: byte_size(count: 0), b: r.peak_rss)
      && !measure_le(a: r.peak_rss, b: byte_size(count: 0))
      && string_contains(s: r.host, pattern: "srv1")
  })
}

// The duration invariant the statistics must obey — min <= median <= max, compared IN the Microsecond
// measure. WallStat cells only; a ProcessTimes cell has no such triple and passes vacuously. The
// witness plants a reversed triple (a representable forbidden state: min recorded from the wrong end
// of the run list) and watches this refuse it.
fn parse_population_receipt_durations_are_ordered(receipts: List<ParsePopulationMeasurementReceipt>) -> Bool {
  fold_list(xs: receipts, empty: true, cons: fn(acc, r) {
    acc && match r.measurement {
      WallStat { min_wall: lo, median_wall: med, max_wall: hi } =>
        measure_le(a: lo, b: med) && measure_le(a: med, b: hi),
      ProcessTimes { utime: _, stime: _, minor_faults: _, major_faults: _,
                     voluntary_ctx_switches: _, involuntary_ctx_switches: _ } => true
    }
  })
}

// ---- derived queries (rank from position, membership from rank) ----

// Whole-roster byte total, summed IN the ByteSize measure the rows already carry. The count is
// unwrapped only where a ByteSize is rendered for display in the measurement record, so no bare Int
// re-represents a byte quantity the model already types (gunbc.design_argument::minimize_redundancy,
// gunbc.design_argument::single_authority).
fn parse_population_total_byte_total() -> ByteSize {
  fold_list(xs: parse_population_baseline_rows, empty: byte_size(count: 0), cons: fn(acc, row) {
    measure_add(acc, row.bytes)
  })
}

// Whole-roster cardinality.
fn parse_population_total_count_of(rows: List<ParsePopulationRow>) -> Int {
  count_where(xs: rows, predicate: fn(_row) { true })
}


// Cardinality predicate over an ARBITRARY roster (arg-taking so BOTH arms are exercised, mirroring
// the ordering probes): true iff the roster has exactly the expected benchmark size. Feeds the
// discriminating cardinality leg (warm-fox rule: a check must prove it measured by a named negative
// failing in the same run; review 98328 -- a claim that asserts only total==170 is one number and
// cannot fail on its own; the planted-row refusal below is what makes it discriminate).
fn parse_population_cardinality_predicate(rows: List<ParsePopulationRow>) -> Bool {
  parse_population_total_count_of(rows) == parse_population_expected_total_count
}

// ACCEPT arm: the real benchmark roster must satisfy the predicate (its count is exactly 170).
fn parse_population_cardinality_accepts_real() -> Bool {
  parse_population_cardinality_predicate(parse_population_baseline_rows) == true
}

// A roster with one row PLANTED: a NEW-path member (probe/planted_extra.dag, count 1) pushed onto the
// real roster. Not a duplicated path -- the leg discriminates on the COUNT, which the new member
// pushes from 170 to 171, so a fresh path is what the roster below actually builds. Same fold +
// same predicate, one extra member -- so its count is 171 and the predicate must REFUSE it.
fn parse_population_planted_extra_row() -> List<ParsePopulationRow> {
  list_push(xs: parse_population_baseline_rows,
    item: ParsePopulationRow { path: "probe/planted_extra.dag", bytes: byte_size(count: 1) })
}

// REFUSE arm: the predicate must say FALSE on the planted-extra roster. If count_where were broken
// to always return 170, accepts_real would still pass but refuses_planted would FAIL; if it always
// returned the true count, both arms hold only when the roster is genuinely 170. Together the two
// arms make the cardinality leg discriminating (gunbc.design_ruling::executed_red_control_names_its_failing_commit).
fn parse_population_cardinality_refuses_planted_extra_row() -> Bool {
  parse_population_cardinality_predicate(parse_population_planted_extra_row()) == false
}

// b when the 1-based position is a FiveLargest slot, else the zero measure. Call-free branches so
// the block parses.
fn parse_population_select_five(position: Int, b: ByteSize) -> ByteSize {
  if position <= parse_population_five_largest_count { b } else { byte_size(count: 0) }
}

fn parse_population_select_rest(position: Int, b: ByteSize) -> ByteSize {
  if position <= parse_population_five_largest_count { byte_size(count: 0) } else { b }
}

// Scan accumulator carrying the 1-based position while summing the two population byte totals, both
// held in the ByteSize measure. The FiveLargest "is the largest five" property is NOT re-checked here:
// parse_population_check_rows_ordered_descending already enforces row.bytes <= prev on every adjacent
// pair, so the first five positions are the largest five by construction. Re-checking a boundary size
// would be a second representation of that constraint (gunbc.design_argument::fail_closed: "a check
// restating a constraint the model already carries").
type ParsePopulationScan {
  position: Int
  five_bytes: ByteSize
  rest_bytes: ByteSize
}

fn parse_population_scan(rows: List<ParsePopulationRow>) -> ParsePopulationScan {
  fold_list(xs: rows,
    empty: ParsePopulationScan {
      position: 0, five_bytes: byte_size(count: 0), rest_bytes: byte_size(count: 0),
    },
    cons: fn(acc, row) {
      let next: Int = acc.position + 1
      ParsePopulationScan {
        position: next,
        five_bytes: measure_add(acc.five_bytes, parse_population_select_five(next, row.bytes)),
        rest_bytes: measure_add(acc.rest_bytes, parse_population_select_rest(next, row.bytes)),
      }
    })
}

// No row may have a zero byte count: a roster that silently collapsed to empty or zeroed rows fails,
// so a 0 population is reported as a refusal rather than a pass.
fn parse_population_zero_byte_row_count() -> Int {
  count_where(xs: parse_population_baseline_rows, predicate: fn(row) { row.bytes == byte_size(count: 0) })
}

// The two populations are a disjoint cover of the roster: the FiveLargest total plus the remaining
// total equals the whole-roster total. Derived from the roster, not copied from a tree read, so it is
// a real check rather than the fail_closed "count copied from the current tree" change detector. It
// catches an off-by-one in the position-based split (select_five/select_rest disagreeing on a row).
fn parse_population_partition_is_consistent() -> Bool {
  measure_add(parse_population_five_largest_byte_total(), parse_population_one_hundred_sixty_five_byte_total())
    == parse_population_total_byte_total()
}

fn parse_population_five_largest_byte_total() -> ByteSize {
  parse_population_scan(parse_population_baseline_rows).five_bytes
}

fn parse_population_one_hundred_sixty_five_byte_total() -> ByteSize {
  parse_population_scan(parse_population_baseline_rows).rest_bytes
}

// The selection rule, EXECUTED not only commented (gunbc.design_argument::source_annotations: a
// fact that must survive belongs in a typed carrier; nothing may depend on a comment for
// correctness). The load-bearing invariant of "the 5 largest ... and a 165-module sample, taken by
// blob size descending" is that the roster is NON-INCREASING in byte size along list order: every
// member's size is <= its predecessor's. A byte count edited out of order, or a member swapped so a
// smaller file precedes a larger one, fails this. The comparison uses std.measure::measure_le over
// the ByteSize the rows carry (no Int unwrap). The byte-exact extraction of the 170 largest `.dag`
// blobs at the pinned sha is the external producer (the reproduce command), which can be diffed
// against these rows at that sha; the ordering invariant below is what the interpreter can judge.
type ParseOrderScan {
  started: Bool
  prev: ByteSize
  ok: Bool
}

// General ordering check (arg-taking, so BOTH arms can be exercised, not just the fixed roster):
// the list must be non-increasing in byte size along position. Returns false the first time a
// member is larger than its predecessor.
fn parse_population_check_rows_ordered_descending(rows: List<ParsePopulationRow>) -> Bool {
  let step = fold_list(xs: rows,
    empty: ParseOrderScan { started: false, prev: byte_size(count: 0), ok: true },
    cons: fn(acc, row) {
      let le: Bool = measure_le(a: row.bytes, b: acc.prev)
      let step_ok: Bool = if acc.started == false { true } else { le }
      ParseOrderScan { started: true, prev: row.bytes, ok: acc.ok && step_ok }
    })
  step.ok
}

// The fixed roster, ordered descending (the ACCEPT arm on the real population).
fn parse_population_rows_ordered_descending() -> Bool {
  parse_population_check_rows_ordered_descending(parse_population_baseline_rows)
}

// DISCRIMINATION PROBES. A check that only ever sees already-sorted rows passes whatever the
// emitter does (the leg-lifecycle failure mode: green on a wrong compiler). These feed the SAME fold
// synthetic rows so it must actually refuse a bad order and accept a good one.
//   accepts_descending: 30,20,10 (non-increasing) -> the check must say true.
//   refuses_ascending:  10,20,30 (an ascending step) -> the check must say false.
// If the fold were broken to always return true, refuses_ascending would FAIL; if always false,
// accepts_descending would FAIL. Together they prove the invariant is discriminating, not vacuous
// (gunbc.design_ruling::executed_red_control_names_its_failing_commit).
fn parse_population_rows_descending() -> List<ParsePopulationRow> {
  [
    ParsePopulationRow { path: "probe/large.dag", bytes: byte_size(count: 30) },
    ParsePopulationRow { path: "probe/middle.dag", bytes: byte_size(count: 20) },
    ParsePopulationRow { path: "probe/small.dag", bytes: byte_size(count: 10) },
  ]
}

fn parse_population_rows_ascending() -> List<ParsePopulationRow> {
  [
    ParsePopulationRow { path: "probe/small.dag", bytes: byte_size(count: 10) },
    ParsePopulationRow { path: "probe/middle.dag", bytes: byte_size(count: 20) },
    ParsePopulationRow { path: "probe/large.dag", bytes: byte_size(count: 30) },
  ]
}

fn parse_population_ordering_accepts_descending() -> Bool {
  parse_population_check_rows_ordered_descending(parse_population_rows_descending()) == true
}

fn parse_population_ordering_refuses_ascending() -> Bool {
  parse_population_check_rows_ordered_descending(parse_population_rows_ascending()) == false
}

// ---- THE SELECTION RULE AS A TYPED ALGORITHM (review 98809 F1) ----
// The rule "top N .dag blobs by BLOB SIZE descending, then PATH ascending for a stable tiebreak"
// was an unchecked comment plus a shell `sort -k1,1nr -k2,2 | head`. That made the shell the
// authority for the rule (how_to_work: "raw shell implementing semantics expressible in .dag").
// The rule's ALGORITHM now lives here and is checked with a discriminating pair; the shell runner is
// reduced to transport that hands over tree-derived (path, bytes) and applies this modelled order.
// The comparator: a precedes b in the selection order iff a is strictly larger, or they tie and
// a.path sorts first. measure_le gives ByteSize <=; String < gives the canonical path order (the same
// order std.algebra string_compare_canonical declares). Int < bounds the top-N window.

fn parse_population_selection_precedes(a: ParsePopulationRow, b: ParsePopulationRow) -> Bool {
  let strictly_larger: Bool = measure_le(a: b.bytes, b: a.bytes) && (a.bytes == b.bytes) == false
  let tie_earlier_path: Bool = (a.bytes == b.bytes) && (a.path < b.path)
  strictly_larger || tie_earlier_path
}

// RANK BY POSITION, not by counting preceders (review 98986 F2, how_to_work: "a proven cost-shape
// defect — a copied accumulator, a quadratic fold — is always fixed, regardless of realized n"). The
// previous formulation ran a count_where over the whole list per row — O(n^2) — and its stated
// subject was the 170-row reconciliation. The roster's home invariant is that it is STORED in
// selection order (parse_population_rows_sorted_by_selection_rule, adjacent-pair, linear); under that
// precondition rank IS position, exactly the semantics of `sort ... | head n`, and both queries below
// are one linear scan (or a length subtraction after the linear sorted check).

type ParsePopulationRankScan { found: Bool, rank: Int, pos: Int }

fn parse_population_row_rank(row: ParsePopulationRow, all: List<ParsePopulationRow>) -> Int {
  let scan = fold_list(xs: all,
    empty: ParsePopulationRankScan { found: false, rank: 0, pos: 0 }, cons: fn(acc, r) {
    if acc.found == true { acc }
    else if r == row {
      ParsePopulationRankScan { found: true, rank: acc.pos + 1, pos: acc.pos + 1 }
    }
    else { ParsePopulationRankScan { found: false, rank: 0, pos: acc.pos + 1 } }
  })
  if scan.found == true { scan.rank } else { parse_population_list_length(xs: all) + 1 }
}

// Membership is checked first (a row absent from the list has rank length+1 and is never inside),
// then the window test is the position rule rank <= n.
fn parse_population_row_in_top_n(
    row: ParsePopulationRow, all: List<ParsePopulationRow>, n: Int) -> Bool {
  if parse_population_row_rank(row: row, all: all) > parse_population_list_length(xs: all) { false }
  else { parse_population_row_rank(row: row, all: all) <= n }
}

// Outside-top-N of a list stored IN selection order is exactly its suffix past n: linear sorted
// check plus one subtraction. A list that is not in selection order REFUSES with -1: no outside-count
// is claimed from unordered input (fail_closed), and -1 is distinguishable from the lawful 0 of a
// window that covers the whole list, so a mis-sorted roster can never be silently certified.
fn parse_population_rows_outside_top_n(
    all: List<ParsePopulationRow>, n: Int) -> Int {
  if parse_population_rows_sorted_by_selection_rule(rows: all) == false { -1 }
  else if parse_population_list_length(xs: all) <= n { 0 }
  else { parse_population_list_length(xs: all) - n }
}

fn parse_population_list_length(xs: List<ParsePopulationRow>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, r) { acc + 1 })
}

// The roster-side full-rule ordering: adjacent pairs must satisfy the comparator, so a stored order
// that breaks the PATH tiebreak (two equal sizes stored path-descending) turns red -- something the
// size-only check_rows_ordered_descending cannot catch, because it ignores path.
type ParseSelectedScan {
  started: Bool
  prev: ParsePopulationRow
  ok: Bool
}

fn parse_population_rows_sorted_by_selection_rule(rows: List<ParsePopulationRow>) -> Bool {
  let step = fold_list(xs: rows,
    empty: ParseSelectedScan {
      started: false, prev: ParsePopulationRow { path: "", bytes: byte_size(count: 0) }, ok: true,
    },
    cons: fn(acc, row) {
      let in_order: Bool = if acc.started == false { true } else {
        parse_population_selection_precedes(a: acc.prev, b: row)
      }
      ParseSelectedScan { started: true, prev: row, ok: acc.ok && in_order }
    })
  step.ok
}

fn parse_population_roster_is_selected_sorted() -> Bool {
  parse_population_rows_sorted_by_selection_rule(parse_population_baseline_rows) == true
}

// DISCRIMINATORS. A top-N that always says "inside" or always "outside" is vacuous; these pins make
// the algorithm itself fail if it degenerates (executed_red_control_names_its_failing_commit).
//   top_n_excludes_overflow: [30,20,10] top-2 must leave exactly the smallest row outside -> 1.
//   top_n_accepts_full_window: the same list top-3 leaves nothing outside -> 0.
// A broken "everything is in" returns 0 for both (first pin fails); "everything is out" returns 3
// for the second (second pin fails). Together they are discriminating, not a constant readback.
fn parse_population_top_n_excludes_overflow() -> Bool {
  parse_population_rows_outside_top_n(all: parse_population_rows_descending(), n: 2) == 1
}

fn parse_population_top_n_accepts_full_window() -> Bool {
  parse_population_rows_outside_top_n(all: parse_population_rows_descending(), n: 3) == 0
}

// TIEBREAK DISCRIMINATOR. Two equal-size rows; the selection order keeps the smaller path. top-1
// must keep "tie_a.dag" and drop "tie_b.dag"; a comparator that ignored path (the size-only check)
// could not distinguish them.
fn parse_population_tie_rows() -> List<ParsePopulationRow> {
  [
    ParsePopulationRow { path: "probe/tie_a.dag", bytes: byte_size(count: 30) },
    ParsePopulationRow { path: "probe/tie_b.dag", bytes: byte_size(count: 30) },
  ]
}

fn parse_population_top_n_breaks_tie_by_path() -> Bool {
  parse_population_row_in_top_n(
    row: ParsePopulationRow { path: "probe/tie_a.dag", bytes: byte_size(count: 30) },
    all: parse_population_tie_rows(), n: 1) == true
    && parse_population_row_in_top_n(
      row: ParsePopulationRow { path: "probe/tie_b.dag", bytes: byte_size(count: 30) },
      all: parse_population_tie_rows(), n: 1) == false
}

// The full-rule sorted check must REFUSE a stored order that breaks the path tiebreak (b before a at
// equal size), which the size-only ordering check would wrongly accept.
fn parse_population_tie_rows_misordered() -> List<ParsePopulationRow> {
  [
    ParsePopulationRow { path: "probe/tie_b.dag", bytes: byte_size(count: 30) },
    ParsePopulationRow { path: "probe/tie_a.dag", bytes: byte_size(count: 30) },
  ]
}

fn parse_population_selection_refuses_misordered_tie() -> Bool {
  parse_population_rows_sorted_by_selection_rule(parse_population_tie_rows_misordered()) == false
}




// Path uniqueness CHECK: map each member to a KeyedRow keyed by its own path (the single stored
// path) and build through std.keyed_roster, which refuses a repeated key. True only for the Built
// arm, so a roster that silently gained a duplicate path turns red rather than under-reporting.
fn parse_population_to_keyed(rows: List<ParsePopulationRow>) -> List<KeyedRow<String, ParsePopulationRow>> {
  fold_list(xs: rows, empty: [], cons: fn(acc, row) {
    list_push(xs: acc, item: KeyedRow { row_key: row.path, value: row })
  })
}

fn parse_population_is_unique() -> Bool {
  match keyed_roster_build(incomings: parse_population_to_keyed(parse_population_baseline_rows), key_eq: fn(a, b) { a == b }) {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

// The negative control: the SAME build over the SAME rows with a trivial always-equal key_eq must
// land on DuplicateKey (the second row collides with the first). If this ever returned Built the
// uniqueness verdict would be vacuous. Proven by the executed red control
// (gunbc.design_ruling::executed_red_control_names_its_failing_commit).
fn parse_population_duplicate_refuses_with_trivial_eq() -> Bool {
  match keyed_roster_build(incomings: parse_population_to_keyed(parse_population_baseline_rows), key_eq: fn(a, b) { true }) {
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
    KeyedRosterBuilt { rows: _ } => false
  }
}

// ---- carrier <-> tree reconciliation: the load-bearing instrument (the report's reconciliation leg
// applies parse_population_reconcile_* to all 170 rows against git ls-tree at the pinned sha; review 98443) ----

// True iff a declared row appears in the given tree row-set with the SAME path AND the SAME byte size.
fn parse_population_row_in_tree(row: ParsePopulationRow, tree: List<ParsePopulationRow>) -> Bool {
  count_where(xs: tree, predicate: fn(t) { t.path == row.path && t.bytes == row.bytes }) >= 1
}

// How many declared rows are NOT reconciled by a matching (path, byte size) in the tree row-set. Zero
// means every declared row is backed by the tree; a mistyped path or byte size leaves one unreconciled.
fn parse_population_unreconciled_row_count(
  declared: List<ParsePopulationRow>, tree: List<ParsePopulationRow>) -> Int {
  count_where(xs: declared, predicate: fn(r) { parse_population_row_in_tree(row: r, tree: tree) == false })
}

// A 3-row slice of the REAL roster with ONE row's byte size mistyped by one digit (roadmap_belt_actuate
// 947773 -> 947772): a real row transcribed wrong, the discriminating red control, not a planted constant.
fn parse_population_mistyped_real_row_slice() -> List<ParsePopulationRow> {
  [
    ParsePopulationRow { path: "dag/gunbc/roadmap/roadmap_authority.dag", bytes: byte_size(count: 1421761) },
    ParsePopulationRow { path: "dag/gunbc/roadmap/roadmap_belt_actuate.dag", bytes: byte_size(count: 947772) },
    ParsePopulationRow { path: "dag/product/p4261/e1_receipt_markings.dag", bytes: byte_size(count: 750634) },
  ]
}

// The same real 3-row slice with the byte size correct (roadmap_belt_actuate 947773).
fn parse_population_correct_real_row_slice() -> List<ParsePopulationRow> {
  [
    ParsePopulationRow { path: "dag/gunbc/roadmap/roadmap_authority.dag", bytes: byte_size(count: 1421761) },
    ParsePopulationRow { path: "dag/gunbc/roadmap/roadmap_belt_actuate.dag", bytes: byte_size(count: 947773) },
    ParsePopulationRow { path: "dag/product/p4261/e1_receipt_markings.dag", bytes: byte_size(count: 750634) },
  ]
}

// These two arms exercise ONLY the comparison predicate over a HAND-BUILT reference row-set. They do not
// read the tree (no filesystem in the language) and do not read the 170-row roster: they prove the predicate
// DISCRIMINATES (accepts when declared == reference, refuses when one byte size is off). The real comparison
// of all 170 rows against `git ls-tree` at the pinned sha is NOT executed in this merge: the shell runner
// that did it was withdrawn (warm-fox-517 split ruling; review 98809), a `.dag` function cannot read the tree
// and CI runs no claims. That 170-to-tree reconciliation is declared withdrawn pending route A in
// gunbc.guarantee_stall.parse_population_carrier_reader_beside_grammar_stall; these arms only prove the
// comparison PREDICATE discriminates.
// ACCEPT arm: the predicate reports zero unreconciled rows when declared equals the reference row-set.
fn parse_population_reconcile_accepts_correct_slice() -> Bool {
  parse_population_unreconciled_row_count(
    declared: parse_population_correct_real_row_slice(),
    tree: parse_population_correct_real_row_slice()) == 0
}

// REFUSE arm: the predicate leaves exactly the mistyped byte-size row unreconciled when one declared byte
// size differs from the reference. A real wrong row drives the refusal (review 98443), not a planted constant.
fn parse_population_reconcile_refuses_mistyped_slice() -> Bool {
  parse_population_unreconciled_row_count(
    declared: parse_population_mistyped_real_row_slice(),
    tree: parse_population_correct_real_row_slice()) >= 1
}

// THE EXTRACTION THE LEDGER LINE AND THE WITNESS SHARE: the next-rung trigger's capability is readable ONLY
// through the declared NextRungTrigger constructor. Any other shape yields "" -- and the witness red control
// asserts exactly that -- so the capability text cannot be quietly deleted or bypassed while the 170-to-tree
// reconciliation is still unexecuted (review 98901 F1: presence-of-a-prefix is a decoration; the
// discriminating pair is the guard).
fn parse_population_carrier_reader_beside_grammar_stall_capability() -> String {
  match parse_population_carrier_reader_beside_grammar_stall.next_rung_trigger {
    NextRungTrigger { capability: c, awaiting: _ } => c
  }
}

// DECLARED STALL -- ROSTERED, NOT A LOCAL STRING (review 98937 F2: this class was first written as a rung
// DROP with previous: StructurallyGuaranteed, and that rung was NEVER HELD -- recording a wanted rung as a
// previous one is rung inflation in reverse. The honest record per gunbc.design_argument::guarantee_ladder
// (no untracked stall) is a class below its ceiling with a named next-rung trigger). The row is the FILE
// dag/gunbc/guarantee_stall/parse_population_carrier_reader_beside_grammar_stall.dag (single authority):
// current rung 1 mitigatable -- typed predicates discriminate the selection order over hand-built slices,
// no executable reader of the real 170 rows; ceiling 4 structurally guaranteed -- the one grammar route reads
// a data binding; blocker ClimbableButUnbuilt. The route-A tracking row is labelled honestly: a PLANNED row
// in DRAFT plan PR #17116, not on main at this head. Background (warm-fox-517 split ruling, review 98836):
// the shell scaffolds, their awk/grep/sed reader and the hand reconciliation are OUT of this merge -- a
// second parser beside the grammar could mis-parse a field without changing its line count. The consumer
// below renders the rostered row's capability into a ledger line; the witness guards it with a discriminating
// pair (red when the extraction stops honoring the declared trigger shape). Bounded: climbs when the STAFFED
// capability lands, not on an open-ended future capability and not on the plan row reaching done.
fn parse_population_carrier_reader_rung_drop_ledger_line() -> String {
  concat(
    concat("rung-stall: ", "gunbc.guarantee_stall.parse_population_carrier_reader_beside_grammar_stall"),
    concat(" | ", parse_population_carrier_reader_beside_grammar_stall_capability()))
}
