module gunbc.fleet_fan_acoustic_evidence

import std.types { Bool }
import std.measure { rpm }
import std.acoustic { dba_tenths }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.fans.types {
  FanAcousticLawFittable,
  FanAcousticTwoPointLawAssumed,
  FanAcousticUnderdetermined,
  FanSoundPressureNotPublishedAtSpeed,
  FanSoundPressurePublished,
  FanSoundPressureUnderdetermined,
  fan_acoustic_evidence,
  fan_sound_pressure_at,
}
import extdeps.fans.dynatron { dynatron_df126025bu_pwmh_catalog }
import extdeps.fans.noctua { noctua_nf_a9_hs_pwm_catalog }

// THE ASYMMETRY WITNESS. Two fans cool this fleet and exactly one of them can be reasoned about
// acoustically. Dynatron prints three levels, Noctua prints one, and one point fixes no slope -
// so any level claim about the Noctua is a refusal rather than a number.
//
// This exists because the tempting error is specific and was nearly made: the Dynatron's three
// points fit a fifth-power law to about 0.1 dB, which invites reusing that exponent for the
// Noctua. The exponent is a property of one fan under one vendor's test conditions. Reusing it
// would produce a confident number with no evidence behind it, in the direction that matters -
// telling an operator a machine is quiet enough.
//
// The third conjunct is the one that would rot silently: 6033 rpm is a speed srv3 actually runs
// at, and it is NOT a published Dynatron point. Asking for a level there must refuse even though
// this fan is otherwise well anchored. If someone later adds interpolation without adding a
// published-versus-derived distinction, this conjunct goes red.
//
// The anchor conjunct asserts the LEVEL, not merely that some level came back: 44.4 dBA is
// carried as 444 tenths, so a carrier change that silently rescaled the published figures fails
// here rather than passing on the shape alone.
fn fan_acoustic_evidence_witness() -> ProcessExit {
  let dynatron_anchored = match fan_acoustic_evidence(row: dynatron_df126025bu_pwmh_catalog) {
    FanAcousticLawFittable { published_level_count } => published_level_count == 3
    FanAcousticTwoPointLawAssumed { published_level_count } => false
    FanAcousticUnderdetermined { published_level_count } => false
  }
  let noctua_refuses = match fan_acoustic_evidence(row: noctua_nf_a9_hs_pwm_catalog) {
    FanAcousticLawFittable { published_level_count } => false
    FanAcousticTwoPointLawAssumed { published_level_count } => false
    FanAcousticUnderdetermined { published_level_count } => published_level_count == 1
  }
  let dynatron_at_anchor = match fan_sound_pressure_at(
    row: dynatron_df126025bu_pwmh_catalog,
    speed: rpm(5400),
  ) {
    FanSoundPressurePublished { level } => dba_tenths(level: level) == 444
    other => false
  }
  let dynatron_off_anchor_refuses = match fan_sound_pressure_at(
    row: dynatron_df126025bu_pwmh_catalog,
    speed: rpm(6033),
  ) {
    FanSoundPressureNotPublishedAtSpeed { speed } => true
    other => false
  }
  let noctua_level_refuses = match fan_sound_pressure_at(
    row: noctua_nf_a9_hs_pwm_catalog,
    speed: rpm(2500),
  ) {
    FanSoundPressureUnderdetermined { published_level_count } => true
    other => false
  }
  if dynatron_anchored
    && noctua_refuses
    && dynatron_at_anchor
    && dynatron_off_anchor_refuses
    && noctua_level_refuses {
    ExitSuccess
  } else {
    exit_failure(reason: "fan acoustic evidence witness: anchored/underdetermined discrimination or the off-anchor refusal changed")
  }
}
