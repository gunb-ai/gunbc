module gunbc.test_module_hygiene


data test_module_hygiene_authority_note: String = "U3 file-grain expand authority, plus the failure-receipt companion naming convention claim_executor invokes. Host realizes the interpreter transport (cli_run/test_module_hygiene_bridge.rs).\n\nWHAT THIS MODULE NO LONGER DOES (gunbc#8155): the U2 orphan enroll-or-refuse census is DELETED. It walked every *_test.dag in the corpus, parsed each one, projected DeclSurface/ModuleSurface values, resolved a second interpreter context, and ran a fuelled reachability fixpoint with a hand-authored cross-module export exception roster — all to decide whether a plain helper in a test file was referenced. An unreferenced helper is dead-code hygiene; it is not evidence that the compiler or the tests are correct, and it did not justify a recurring whole-corpus traversal on every discovery-bearing run. Nothing replaces it: an unreferenced test helper is writable again and nothing detects it. If that inspection is wanted back it belongs as a demand-pulled query, not a required floor phase."
fn is_file_grain_function(function: String) -> Bool {
  function == ""
}

data failure_receipt_companion_note: String = "claim_executor invokes <witness>_failure_receipt on Bool(false) via the _holds/_passes → _failure_receipt naming convention (v2.std.native_agreement / gunbc#7644). Single authority for the suffix derivation: Rust cli_run::failure_receipt_companion delegates here. The clause that used to sit here — that orphan reachability treats the companion as reachable from its witness even though no .dag decl references it — described the census deleted in gunbc#8155 and is removed with it rather than left describing machinery that is gone."

fn without_suffix(s: String, suffix: String) -> String {
  if ends_with(s: s, suffix: suffix) {
    substring(
      s: s,
      start: 0,
      end: string_length(s: s) - string_length(s: suffix)
    )
  } else {
    s
  }
}

fn failure_receipt_companion(function: String) -> Optional<String> {
  if ends_with(s: function, suffix: "_holds") {
    v2.std.optional.optional_present(
      value: concat(gunbc.test_module_hygiene.without_suffix(s: function, suffix: "_holds"), "_failure_receipt")
    )
  } else if ends_with(s: function, suffix: "_passes") {
    v2.std.optional.optional_present(
      value: concat(gunbc.test_module_hygiene.without_suffix(s: function, suffix: "_passes"), "_failure_receipt")
    )
  } else {
    v2.std.optional.optional_absent()
  }
}

fn witness_verdict_diagnostic_companion(function: String) -> Optional<String> {
  if ends_with(s: function, suffix: "_holds") {
    v2.std.optional.optional_present(
      value: concat(gunbc.test_module_hygiene.without_suffix(s: function, suffix: "_holds"), "_verdict_diagnostic")
    )
  } else if ends_with(s: function, suffix: "_passes") {
    v2.std.optional.optional_present(
      value: concat(gunbc.test_module_hygiene.without_suffix(s: function, suffix: "_passes"), "_verdict_diagnostic")
    )
  } else {
    v2.std.optional.optional_absent()
  }
}

type ExplicitExpandInput {
  entry: String
  function: String
  content: String
}

type ExplicitEntryPair {
  entry: String
  function: String
}

fn pair_key(entry: String, function: String) -> String {
  concat(entry, "\0", function)
}

type ExpandExplicitPairsOutcome = Expanded { pairs: List<ExplicitEntryPair> } | Refused { reason: String }

fn file_grain_empty_refusal(entry: String) -> String {
  concat("file-grain enumerate: entry ", concat(entry, " has no test fn / test data declarations"))
}

fn expand_pair_into(acc_pairs: List<ExplicitEntryPair>, entry: String, name: String) -> List<ExplicitEntryPair> {
  let key = pair_key(entry: entry, function: name)
  if any(xs: acc_pairs, predicate: fn(p) { pair_key(entry: p.entry, function: p.function) == key }) {
    acc_pairs
  } else {
    concat(acc_pairs, [ExplicitEntryPair { entry: entry, function: name }])
  }
}

fn expand_explicit_pairs_or_refuse(inputs: List<ExplicitExpandInput>) -> ExpandExplicitPairsOutcome {
  fold(
    inputs,
    init: Expanded { pairs: [] },
    f: fn(acc, inp) {
      match acc {
        Refused { reason: reason } => Refused { reason: reason }
        Expanded { pairs: acc_pairs } => {
          if is_file_grain_function(function: inp.function) {
            let names = v2.workflow.floor_naming_hygiene.floor_discovery_scan_test_decl_names(content: inp.content)
            if length(xs: names) == 0 {
              Refused { reason: file_grain_empty_refusal(entry: inp.entry) }
            } else {
              Expanded {
                pairs: fold(
                  names,
                  init: acc_pairs,
                  f: fn(inner, name) {
                    expand_pair_into(acc_pairs: inner, entry: inp.entry, name: name)
                  }
                )
              }
            }
          } else {
            Expanded {
              pairs: expand_pair_into(acc_pairs: acc_pairs, entry: inp.entry, name: inp.function)
            }
          }
        }
      }
    }
  )
}

fn enumerate_entry_test_names(content: String) -> List<String> {
  v2.workflow.floor_naming_hygiene.floor_discovery_scan_test_decl_names(content: content)
}
