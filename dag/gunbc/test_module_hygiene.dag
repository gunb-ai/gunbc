module gunbc.test_module_hygiene

import std.types { String, Bool, List }
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.workflow.floor_naming_hygiene { floor_discovery_scan_test_decl_names }

data test_module_hygiene_authority_note: String = "U2 orphan enroll-or-refuse + U3 file-grain expand authority (proud-wren-892). Pure fold over ModuleSurface — refs are already-extracted local names (call + bare-var). Host realizes parse Node→surface, FS walk, and interpreter transport (cli_run/test_module_hygiene_bridge.rs). Equivalence: dag/test/claim/test_module_hygiene_hand_rust_equivalence_witness_test.dag + cli_run.rs test_module_hygiene_bridge_equivalence_tests. ROADMAP node v1-test-hygiene-producer-retirement: seed producer deleted; bind is gunbc.test_module_hygiene.orphan_plain_names_or_refuse."

type DeclSurface {
  name: String
  refs: List<String>
}

type ModuleSurface {
  entry: String
  test_fns: List<DeclSurface>
  plain_fns: List<DeclSurface>
  test_data: List<DeclSurface>
  plain_data: List<DeclSurface>
}

type CrossModuleExportRow {
  entry_path: String
  exports: List<String>
}

data cross_module_exported_plains_note: String = "Declaration-grain seeds (review 43604) — single authority for the interim roster. Dissolve-on: rename each file off *_test.dag, or import-graph reachability supersedes."

data cross_module_exported_plains: List<CrossModuleExportRow> = [
  CrossModuleExportRow {
    entry_path: "src/v2/lens/no_dual_representation_test.dag",
    exports: [
      "no_dual_representation_test_clean_holds",
      "no_dual_representation_test_coverage_honesty_holds",
    ]
  },
  CrossModuleExportRow {
    entry_path: "src/v2/lens/affected_set/edit_locus_resolver_test.dag",
    exports: [
      "edit_locus_source_provenance_affected_set_wire_holds",
      "edit_locus_source_provenance_producer_rejects_malformed_source_holds",
      "edit_locus_source_provenance_producer_holds",
      "edit_locus_source_provenance_parse_root_span_holds",
    ]
  },
]

fn is_file_grain_function(function: String) -> Bool {
  function == ""
}

fn name_in(xs: List<String>, needle: String) -> Bool {
  any(xs: xs, predicate: fn(x) { x == needle })
}

fn names_set_eq(left: List<String>, right: List<String>) -> Bool {
  (length(xs: left) == length(xs: right))
    && (left |> all(x => name_in(xs: right, needle: x)))
    && (right |> all(x => name_in(xs: left, needle: x)))
}

fn unique_snoc(xs: List<String>, item: String) -> List<String> {
  if name_in(xs: xs, needle: item) {
    xs
  } else {
    concat(xs, [item])
  }
}

fn entry_path_matches(entry: String, auth: String) -> Bool {
  (entry == auth) || ends_with(s: entry, suffix: concat("/", auth))
}

fn cross_module_exports_for(entry: String) -> List<String> {
  fold(
    cross_module_exported_plains,
    init: [],
    f: fn(acc, row) {
      if length(xs: acc) > 0 {
        acc
      } else if entry_path_matches(entry: entry, auth: row.entry_path) {
        row.exports
      } else {
        acc
      }
    }
  )
}

fn has_enrollment_surface(module: ModuleSurface) -> Bool {
  (length(xs: module.test_fns) > 0) || (length(xs: module.test_data) > 0)
}

fn plain_names(module: ModuleSurface) -> List<String> {
  fold(
    module.plain_fns,
    init: [],
    f: fn(acc, d) {
      concat(acc, [d.name])
    }
  )
}

fn all_decl_bodies(module: ModuleSurface) -> List<DeclSurface> {
  concat(
    concat(concat(module.test_fns, module.plain_fns), module.test_data),
    module.plain_data
  )
}

fn refs_of(bodies: List<DeclSurface>, name: String) -> List<String> {
  fold(
    bodies,
    init: [],
    f: fn(acc, d) {
      if length(xs: acc) > 0 {
        acc
      } else if d.name == name {
        d.refs
      } else {
        acc
      }
    }
  )
}

type ReachState {
  reachable_plains: List<String>
  seen_data: List<String>
  frontier: List<String>
}

fn plain_already_queued_or_reached(name: String, state: ReachState) -> Bool {
  name_in(xs: state.reachable_plains, needle: name) || name_in(xs: state.frontier, needle: name)
}

fn data_already_queued_or_seen(name: String, state: ReachState) -> Bool {
  name_in(xs: state.seen_data, needle: name) || name_in(xs: state.frontier, needle: name)
}

fn expand_refs_into(
  refs: List<String>,
  plains: List<String>,
  data_keys: List<String>,
  state: ReachState
) -> ReachState {
  fold(
    refs,
    init: state,
    f: fn(st, r) {
      if name_in(xs: plains, needle: r) {
        if plain_already_queued_or_reached(name: r, state: st) {
          st
        } else {
          ReachState {
            reachable_plains: st.reachable_plains,
            seen_data: st.seen_data,
            frontier: unique_snoc(xs: st.frontier, item: r)
          }
        }
      } else if name_in(xs: data_keys, needle: r) && (data_already_queued_or_seen(name: r, state: st) == false) {
        ReachState {
          reachable_plains: st.reachable_plains,
          seen_data: unique_snoc(xs: st.seen_data, item: r),
          frontier: unique_snoc(xs: st.frontier, item: r)
        }
      } else {
        st
      }
    }
  )
}

fn reach_step(
  module: ModuleSurface,
  plains: List<String>,
  data_keys: List<String>,
  bodies: List<DeclSurface>,
  state: ReachState
) -> ReachState {
  if length(xs: state.frontier) == 0 {
    state
  } else {
    let name = state.frontier.first()
    let rest = state.frontier.skip(n: 1)
    let is_plain = name_in(xs: plains, needle: name)
    let already = name_in(xs: state.reachable_plains, needle: name)
    if is_plain && already {
      ReachState {
        reachable_plains: state.reachable_plains,
        seen_data: state.seen_data,
        frontier: rest
      }
    } else {
      let next_reachable = if is_plain {
        unique_snoc(xs: state.reachable_plains, item: name)
      } else {
        state.reachable_plains
      }
      let seeded = ReachState {
        reachable_plains: next_reachable,
        seen_data: state.seen_data,
        frontier: rest
      }
      expand_refs_into(
        refs: refs_of(bodies: bodies, name: name),
        plains: plains,
        data_keys: data_keys,
        state: seeded
      )
    }
  }
}

fn reach_fixpoint_pass(
  module: ModuleSurface,
  plains: List<String>,
  data_keys: List<String>,
  bodies: List<DeclSurface>,
  state: ReachState
) -> ReachState {
  reach_step(
    module: module,
    plains: plains,
    data_keys: data_keys,
    bodies: bodies,
    state: state
  )
}

fn reach_convergence_fuel(module: ModuleSurface) -> List<String> {
  let names = fold(
    all_decl_bodies(module: module),
    init: [],
    f: fn(acc, d) {
      concat(acc, [d.name])
    }
  )
  concat(names, names)
}

fn seed_reach_state(module: ModuleSurface, plains: List<String>, exports: List<String>) -> ReachState {
  let data_keys = fold(
    concat(module.test_data, module.plain_data),
    init: [],
    f: fn(acc, d) {
      concat(acc, [d.name])
    }
  )
  let from_tests = fold(
    module.test_fns,
    init: ReachState {
      reachable_plains: [],
      seen_data: [],
      frontier: []
    },
    f: fn(st, d) {
      expand_refs_into(
        refs: d.refs,
        plains: plains,
        data_keys: data_keys,
        state: st
      )
    }
  )
  let from_test_data = fold(
    module.test_data,
    init: from_tests,
    f: fn(st, d) {
      let marked = ReachState {
        reachable_plains: st.reachable_plains,
        seen_data: unique_snoc(xs: st.seen_data, item: d.name),
        frontier: st.frontier
      }
      expand_refs_into(
        refs: d.refs,
        plains: plains,
        data_keys: data_keys,
        state: marked
      )
    }
  )
  fold(
    exports,
    init: from_test_data,
    f: fn(st, name) {
      if name_in(xs: plains, needle: name) {
        ReachState {
          reachable_plains: st.reachable_plains,
          seen_data: st.seen_data,
          frontier: unique_snoc(xs: st.frontier, item: name)
        }
      } else {
        st
      }
    }
  )
}

type OrphanPlainNamesOutcome = Orphans { names: List<String> } | ReachBudgetRefused { reason: String }

fn format_reach_budget_refusal(entry: String, frontier: List<String>) -> String {
  concat(
    "test-module orphan reachability (DESIGN §5): convergence budget exhausted for ",
    concat(entry, concat(" with ", concat(to_string(value: length(xs: frontier)), " frontier item(s) remaining — refuse rather than fabricate orphan results")))
  )
}

fn orphan_names_from_reachable(plains: List<String>, reachable_plains: List<String>) -> List<String> {
  fold(
    plains,
    init: [],
    f: fn(acc, name) {
      if name_in(xs: reachable_plains, needle: name) {
        acc
      } else {
        concat(acc, [name])
      }
    }
  )
}

data failure_receipt_companion_note: String = "claim_executor invokes <witness>_failure_receipt on Bool(false) via the _holds/_passes → _failure_receipt naming convention (v2.std.native_agreement / gunbc#7644). Orphan reachability treats the companion as reachable from its witness even though no .dag decl references it — the executor is the caller. Single authority for the suffix derivation: Rust cli_run::failure_receipt_companion delegates here."

fn without_suffix(s: String, suffix: String) -> String {
  if ends_with(s: s, suffix: suffix) {
    substring(
      s: s,
      start: 0,
      end: string_length(s: s) - string_length(s: suffix)
    )
  } else {
    s
  }
}

fn failure_receipt_companion(function: String) -> Optional<String> {
  if ends_with(s: function, suffix: "_holds") {
    optional_present(
      value: concat(without_suffix(s: function, suffix: "_holds"), "_failure_receipt")
    )
  } else if ends_with(s: function, suffix: "_passes") {
    optional_present(
      value: concat(without_suffix(s: function, suffix: "_passes"), "_failure_receipt")
    )
  } else {
    optional_absent()
  }
}

fn failure_receipt_companion_plain_names(module: ModuleSurface, plains: List<String>) -> List<String> {
  fold(
    module.test_fns,
    init: [],
    f: fn(acc, test_fn) {
      match failure_receipt_companion(function: test_fn.name) {
        Present { value: companion } =>
          if name_in(xs: plains, needle: companion) {
            unique_snoc(xs: acc, item: companion)
          } else {
            acc
          }
        Absent => acc
      }
    }
  )
}

fn reachable_plains_with_failure_receipt_companions(
  module: ModuleSurface,
  plains: List<String>,
  reachable_plains: List<String>
) -> List<String> {
  fold(
    failure_receipt_companion_plain_names(module: module, plains: plains),
    init: reachable_plains,
    f: fn(acc, companion) {
      unique_snoc(xs: acc, item: companion)
    }
  )
}

fn orphan_plain_names_or_refuse(module: ModuleSurface) -> OrphanPlainNamesOutcome {
  let plains = plain_names(module: module)
  if length(xs: plains) == 0 {
    Orphans { names: [] }
  } else {
    let exports = cross_module_exports_for(entry: module.entry)
    if (has_enrollment_surface(module: module) == false) && (length(xs: exports) == 0) {
      Orphans { names: plains }
    } else {
      let data_keys = fold(
        concat(module.test_data, module.plain_data),
        init: [],
        f: fn(acc, d) {
          concat(acc, [d.name])
        }
      )
      let bodies = all_decl_bodies(module: module)
      let seeded = seed_reach_state(module: module, plains: plains, exports: exports)
      let closed = fold(
        reach_convergence_fuel(module: module),
        init: seeded,
        f: fn(st, _) {
          if length(xs: st.frontier) == 0 {
            st
          } else {
            reach_fixpoint_pass(
              module: module,
              plains: plains,
              data_keys: data_keys,
              bodies: bodies,
              state: st
            )
          }
        }
      )
      if length(xs: closed.frontier) > 0 {
        ReachBudgetRefused {
          reason: format_reach_budget_refusal(entry: module.entry, frontier: closed.frontier)
        }
      } else {
        Orphans {
          names: orphan_names_from_reachable(
            plains: plains,
            reachable_plains: reachable_plains_with_failure_receipt_companions(
              module: module,
              plains: plains,
              reachable_plains: closed.reachable_plains
            )
          )
        }
      }
    }
  }
}

