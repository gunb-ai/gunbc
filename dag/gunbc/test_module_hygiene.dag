type OrphanRecord {
  entry: String
  name: String
}

type ExplicitExpandInput {
  entry: String
  function: String
  content: String
}

type ExplicitEntryPair {
  entry: String
  function: String
}

type CollectOrphanOutcome = CollectRefused { reason: String } | CollectOrphans { records: List<OrphanRecord> }

fn collect_orphan_outcome(modules: List<ModuleSurface>) -> CollectOrphanOutcome {
  fold(
    modules,
    init: CollectOrphans { records: [] },
    f: fn(acc, surf) {
      match acc {
        CollectRefused { reason: reason } => CollectRefused { reason: reason }
        CollectOrphans { records: recs } =>
          match orphan_plain_names_or_refuse(module: surf) {
            ReachBudgetRefused { reason: reason } => CollectRefused { reason: reason }
            Orphans { names: names } => CollectOrphans {
              records: fold(
                names,
                init: recs,
                f: fn(inner, name) {
                  concat(inner, [OrphanRecord { entry: surf.entry, name: name }])
                }
              )
            }
          }
      }
    }
  )
}

fn format_orphan_refusal(orphans: List<OrphanRecord>) -> String {
  let header = concat(
    "test-module orphan-helper hygiene (DESIGN §5/§6 enroll-or-refuse): ",
    to_string(value: length(xs: orphans)),
    " plain fn(s) in `*_test.dag` are unreachable from every `test fn` / `test data` (fixture data only when those exist) — silent de-enrollment. Promote to `test fn`/`test data` or delete:"
  )
  fold(
    orphans,
    init: header,
    f: fn(acc, o) {
      concat(acc, "\n  ", o.entry, "::", o.name)
    }
  )
}

fn check_orphan_surfaces_or_refuse(modules: List<ModuleSurface>) -> Optional<String> {
  match collect_orphan_outcome(modules: modules) {
    CollectRefused { reason: reason } => optional_present(value: reason)
    CollectOrphans { records: orphans } =>
      if length(xs: orphans) == 0 {
        optional_absent()
      } else {
        optional_present(value: format_orphan_refusal(orphans: orphans))
      }
  }
}

fn pair_key(entry: String, function: String) -> String {
  concat(entry, "\0", function)
}

type ExpandExplicitPairsOutcome = Expanded { pairs: List<ExplicitEntryPair> } | Refused { reason: String }

fn file_grain_empty_refusal(entry: String) -> String {
  concat("file-grain enumerate: entry ", concat(entry, " has no test fn / test data declarations"))
}

fn expand_pair_into(acc_pairs: List<ExplicitEntryPair>, entry: String, name: String) -> List<ExplicitEntryPair> {
  let key = pair_key(entry: entry, function: name)
  if any(xs: acc_pairs, predicate: fn(p) { pair_key(entry: p.entry, function: p.function) == key }) {
    acc_pairs
  } else {
    concat(acc_pairs, [ExplicitEntryPair { entry: entry, function: name }])
  }
}

fn expand_explicit_pairs_or_refuse(inputs: List<ExplicitExpandInput>) -> ExpandExplicitPairsOutcome {
  fold(
    inputs,
    init: Expanded { pairs: [] },
    f: fn(acc, inp) {
      match acc {
        Refused { reason: reason } => Refused { reason: reason }
        Expanded { pairs: acc_pairs } => {
          if is_file_grain_function(function: inp.function) {
            let names = floor_discovery_scan_test_decl_names(content: inp.content)
            if length(xs: names) == 0 {
              Refused { reason: file_grain_empty_refusal(entry: inp.entry) }
            } else {
              Expanded {
                pairs: fold(
                  names,
                  init: acc_pairs,
                  f: fn(inner, name) {
                    expand_pair_into(acc_pairs: inner, entry: inp.entry, name: name)
                  }
                )
              }
            }
          } else {
            Expanded {
              pairs: expand_pair_into(acc_pairs: acc_pairs, entry: inp.entry, name: inp.function)
            }
          }
        }
      }
    }
  )
}

fn enumerate_entry_test_names(content: String) -> List<String> {
  floor_discovery_scan_test_decl_names(content: content)
}
