module gunbc.test_module_hygiene

import std.types { String, Bool, List }
import v2.workflow.floor_naming_hygiene { floor_discovery_scan_test_decl_names }

data test_module_hygiene_authority_note: String = "U3 file-grain expand authority, plus the failure-receipt companion naming convention claim_executor invokes. Host realizes the interpreter transport (cli_run/test_module_hygiene_bridge.rs).\n\nWHAT THIS MODULE NO LONGER DOES (gunbc#8155): the U2 orphan enroll-or-refuse census is DELETED. It walked every *_test.dag in the corpus, parsed each one, projected DeclSurface/ModuleSurface values, resolved a second interpreter context, and ran a fuelled reachability fixpoint with a hand-authored cross-module export exception roster — all to decide whether a plain helper in a test file was referenced. An unreferenced helper is dead-code hygiene; it is not evidence that the compiler or the tests are correct, and it did not justify a recurring whole-corpus traversal on every discovery-bearing run. Nothing replaces it: an unreferenced test helper is writable again and nothing detects it. If that inspection is wanted back it belongs as a demand-pulled query, not a required floor phase."
fn is_file_grain_function(function: String) -> Bool {
  function == ""
}

data failure_receipt_companion_note: String = "claim_executor invokes <witness>_failure_receipt on Bool(false). Single authority for the derivation: Rust cli_run::failure_receipt_companion delegates here.\n\nTHE PROJECTION IS TOTAL, AND THAT IS THE POINT (operator ruling, 2026-08-24). It used to return Optional<String>, Absent whenever the witness name ended in neither _holds nor _passes. That made a NAMING CONVENTION into a second answer to a question one authority already owns -- is this an executing witness -- which floor discovery answers structurally by selecting test-marked declarations. Measured, the two authorities disagreed on 84.8% of the discovered roster, and the tempting repair was to read that as debt and rename the witnesses. It was not debt; it was predicate nicknaming (DESIGN section 3), and an enrolment wall keyed on the suffix would have promoted an accidental spelling into the language's definition of a witness. So the suffix is deleted as an ELIGIBILITY test and survives only here, inside the projection, as backward-compatible normalization of the stem: x_holds -> x_failure_receipt, x_passes -> x_failure_receipt, x -> x_failure_receipt. It gets no vote on membership.\n\nTotality is structural rather than conventional: the return type is String, so Absent has no spelling and the host has no arm to decode. What remains AFTER this change, stated so the channel is not read as complete: a false witness whose companion does not exist still yields an opaque Bool(false), because the host maps NoSuchFunction to the empty string and appends nothing. That is deliberate -- it keeps the total derivation operationally non-breaking -- and it means this change closes the eligibility fork ONLY. The narrow claim it licenses: every structurally discovered witness maps to its conventional companion spelling, and suffixes no longer determine eligibility. It does NOT license the claim that every witness can explain its failure; the producer population is small (16 companions, 4 working pairs at the time of this change) and is a separate, unclosed obligation.\n\nThe sibling _verdict_diagnostic channel is derived the same way and has a consumer, but ZERO producers. It is uninhabited and must not be cited as a capability this repository possesses; its disposition is binary -- one real end-to-end producer, or delete the channel with its consumer.\n\nThe clause that used to sit here about orphan reachability described the census deleted in gunbc#8155 and went with it."


fn without_suffix(s: String, suffix: String) -> String {
  if ends_with(s: s, suffix: suffix) {
    substring(
      s: s,
      start: 0,
      end: string_length(s: s) - string_length(s: suffix)
    )
  } else {
    s
  }
}

// Exactly ONE suffix is stripped, mirroring the if/else-if this replaced: chaining two
// without_suffix calls would take `foo_passes_holds` to `foo`, where the derivation it
// replaces yielded `foo_passes`. No such name is authored today, and the point is that the
// normalization must not quietly change any stem it already produced -- totality is the
// change, the stem is not.
fn witness_stem(function: String) -> String {
  if ends_with(s: function, suffix: "_holds") {
    without_suffix(s: function, suffix: "_holds")
  } else {
    without_suffix(s: function, suffix: "_passes")
  }
}

fn failure_receipt_companion(function: String) -> String {
  concat(witness_stem(function: function), "_failure_receipt")
}

fn witness_verdict_diagnostic_companion(function: String) -> String {
  concat(witness_stem(function: function), "_verdict_diagnostic")
}

type ExplicitExpandInput {
  entry: String
  function: String
  content: String
}

type ExplicitEntryPair {
  entry: String
  function: String
}

fn pair_key(entry: String, function: String) -> String {
  concat(entry, "\0", function)
}

type ExpandExplicitPairsOutcome = Expanded { pairs: List<ExplicitEntryPair> } | Refused { reason: String }

fn file_grain_empty_refusal(entry: String) -> String {
  concat("file-grain enumerate: entry ", concat(entry, " has no test fn / test data declarations"))
}

fn expand_pair_into(acc_pairs: List<ExplicitEntryPair>, entry: String, name: String) -> List<ExplicitEntryPair> {
  let key = pair_key(entry: entry, function: name)
  if any(xs: acc_pairs, predicate: fn(p) { pair_key(entry: p.entry, function: p.function) == key }) {
    acc_pairs
  } else {
    concat(acc_pairs, [ExplicitEntryPair { entry: entry, function: name }])
  }
}

fn expand_explicit_pairs_or_refuse(inputs: List<ExplicitExpandInput>) -> ExpandExplicitPairsOutcome {
  fold(
    inputs,
    init: Expanded { pairs: [] },
    f: fn(acc, inp) {
      match acc {
        Refused { reason: reason } => Refused { reason: reason }
        Expanded { pairs: acc_pairs } => {
          if is_file_grain_function(function: inp.function) {
            let names = floor_discovery_scan_test_decl_names(content: inp.content)
            if length(xs: names) == 0 {
              Refused { reason: file_grain_empty_refusal(entry: inp.entry) }
            } else {
              Expanded {
                pairs: fold(
                  names,
                  init: acc_pairs,
                  f: fn(inner, name) {
                    expand_pair_into(acc_pairs: inner, entry: inp.entry, name: name)
                  }
                )
              }
            }
          } else {
            Expanded {
              pairs: expand_pair_into(acc_pairs: acc_pairs, entry: inp.entry, name: inp.function)
            }
          }
        }
      }
    }
  )
}

fn enumerate_entry_test_names(content: String) -> List<String> {
  floor_discovery_scan_test_decl_names(content: content)
}
