module gunbc.fleet_probe_identity_observe


// Observe-first for the probe-identity decision (parent msg_156e62bd): READ-ONLY
// observation of (a) whether the fleet automation PUBLIC key is present in the
// runner-reachable authorized_keys on the host this job runs on (srv1 — the only host
// locally observable before first auth; srv2-4 are recorded pending-first-auth, never
// assumed either way), and (b) what GCP credential path the runner actually holds today
// (the A2 seam precondition for in-run private-key materialization). SECRET HYGIENE:
// only PUBLIC key material and presence verdicts are read or written — no private key
// bytes, no payload digests, no secret payloads of any kind touch this module.
data fleet_probe_identity_receipt_path: String = "target/fleet-probe-identity-observe-receipt.txt"

// IT TAKES THE COMMAND, NOT ITS WORDS. As a List<String> parameter this was a laundering seam --
// a caller handed it a hand-spelled vector and it constructed the record on their behalf, so the
// words never passed a builder. The label stays a separate parameter: what a receipt line is CALLED
// is a fact about the receipt, not about the process.
fn observe_capture_line(label: String, command: extdeps.exec.command.ArgvCommand) -> String {
  match gunbc.command_runner.run_shell_command_capture(command: command, transport: extdeps.exec.command.LocalExec) {
    extdeps.shell.exec.ProcessOutputPresent { text: t } =>
      join([label, " outcome=observed value=", std.algebra.trim(s: t), "\n"], "")
    extdeps.shell.exec.ProcessOutputAbsent =>
      join([label, " outcome=observed-empty value=\n"], "")
    extdeps.shell.exec.ProcessRefused { exit_code: _, stderr: e } =>
      join([label, " outcome=refused cause=", std.algebra.trim(s: e), "\n"], "")
  }
}

fn observe_authorized_keys_line(home: String) -> String {
  let path = concat(home, "/.ssh/authorized_keys")
  match gunbc.command_runner.run_shell_command_capture(command: extdeps.tools.gnu_coreutils.cat_command(path: path), transport: extdeps.exec.command.LocalExec) {
    extdeps.shell.exec.ProcessOutputPresent { text: read_text } =>
    if string_contains(s: read_text, pattern: fleet_automation_ssh_key.material) {
      join(["authorized-keys home=", home, " outcome=fleet-key-present\n"], "")
    } else {
      join(["authorized-keys home=", home, " outcome=fleet-key-absent (file readable, key material not found)\n"], "")
    }
    extdeps.shell.exec.ProcessOutputAbsent =>
      join(["authorized-keys home=", home, " outcome=fleet-key-absent (file readable and empty)\n"], "")
    extdeps.shell.exec.ProcessRefused { exit_code: _, stderr: e } =>
      join(["authorized-keys home=", home, " outcome=unreadable cause=", std.algebra.trim(s: e), "\n"], "")
  }
}

// ph and jh are USED AS PATHS below, not merely printed, so they match the arms rather than
// routing through the receipt-text projection: "(refused: ...)" is fine to print and wrong to
// open. An unreadable home yields "" here and the guarded call below skips the probe entirely
// rather than reading /.ssh/authorized_keys off a fabricated root.

func fleet_probe_identity_observe_wet() -> std.process.ProcessExit
  uses net: std.resources.Network
{
  let user = gunbc.command_runner.run_shell_command_capture(command: extdeps.tools.gnu_coreutils.whoami_command(), transport: extdeps.exec.command.LocalExec)
  let passwd_home = gunbc.command_runner.run_shell_command_capture(
    command: extdeps.posix.sh_invocation.posix_sh_program_command(script: "getent passwd \"$(whoami)\" | cut -d: -f6"),
    transport: extdeps.exec.command.LocalExec,
  )
  let job_home = gunbc.command_runner.run_shell_command_capture(
    command: extdeps.posix.sh_invocation.posix_sh_program_command(script: "echo \"$HOME\""),
    transport: extdeps.exec.command.LocalExec,
  )
  let ph = match passwd_home { extdeps.shell.exec.ProcessOutputPresent { text: t } => std.algebra.trim(s: t)  extdeps.shell.exec.ProcessOutputAbsent => ""  extdeps.shell.exec.ProcessRefused { exit_code: _, stderr: _ } => "" }
  let jh = match job_home { extdeps.shell.exec.ProcessOutputPresent { text: t } => std.algebra.trim(s: t)  extdeps.shell.exec.ProcessOutputAbsent => ""  extdeps.shell.exec.ProcessRefused { exit_code: _, stderr: _ } => "" }
  let body = join([
    join(["observer user=", gunbc.command_runner.process_outcome_receipt_text(outcome: user), " passwd-home=", gunbc.command_runner.process_outcome_receipt_text(outcome: passwd_home), " job-home=", gunbc.command_runner.process_outcome_receipt_text(outcome: job_home), "\n"], ""),
    "local-host-note only the host this runner occupies is locally observable pre-auth; srv2-srv4 authorized_keys standing is PENDING-FIRST-AUTH (recorded, not assumed)\n",
    if ph != "" { observe_authorized_keys_line(home: ph) } else { "authorized-keys home=(passwd home unreadable) outcome=not-probed\n" },
    if jh != ph && jh != "" { observe_authorized_keys_line(home: jh) } else { "" },
    observe_capture_line(label: "gcloud-binary", command: extdeps.posix.sh_invocation.posix_sh_program_command(script: "command -v gcloud || echo absent")),
    observe_capture_line(label: "gcloud-auth-list", command: extdeps.posix.sh_invocation.posix_sh_program_command(script: "command -v gcloud >/dev/null && gcloud auth list --format=value(account) 2>&1 || echo gcloud-absent")),
    observe_capture_line(label: "adc-env", command: extdeps.posix.sh_invocation.posix_sh_program_command(script: "echo \"$\{GOOGLE_APPLICATION_CREDENTIALS:-absent}\"")),
    observe_capture_line(label: "adc-file-passwd-home", command: extdeps.posix.sh_invocation.posix_sh_program_command(script: "test -f \"$(getent passwd \"$(whoami)\" | cut -d: -f6)/.config/gcloud/application_default_credentials.json\" && echo present || echo absent")),
  ], "")
  let w = extdeps.filesystem.filesystem_io.Filesystem.Write(path: fleet_probe_identity_receipt_path, content: body)
  if w.success {
    std.process.ExitSuccess
  } else {
    std.process.exit_failure(reason: concat("fleet_probe_identity_observe: receipt publication failed — ", w.error))
  }
}
