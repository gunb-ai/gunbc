module gunbc.fleet_desired_observe

// Operator verdict join 1 (2026-08-09): the LIVE half of gunbc.fleet_main_revision.
// That module models what the desired ref MEANS; until this module landed, nothing on
// any host actually READ refs/fleet/desired — converge_target_revision had no live
// caller, so the anti-entropy property the ref buys (a returning host converges from the
// admitted ref without a new commit) existed only as vocabulary. This module is the
// observation edge: ls-remote the exact ref through the typed git.Core service op
// (runtime-present site — typed service op, never emitted shell, per the shell→intent
// routing), decode the advertised object id through the ONE untagged-hex decoder the
// object-store authority provides, and answer with the variant the observation actually
// supports: absent, undecodable, or unobserved.
//
// THESE THREE WERE ONE VARIANT AND ARE NOT ANY MORE. A ref origin does not advertise, an
// advertisement that will not decode, and an ls-remote that refused all returned
// FleetDesiredUnobserved with a cause string. The string told a human which had happened and
// told a CONSUMER nothing, so the only safe reading was "no target", and the first creation of
// refs/fleet/desired was inexpressible: nothing could say "the remote does not have this ref"
// as a claim rather than as a failure to look. Exit 0 with an empty advertisement IS that
// claim, and it is now the only thing that produces it.
fn observe_fleet_desired_revision(repo: std.types.FilePath) -> gunbc.fleet_main_revision.FleetDesiredRevision {
  let read = git.Core.LsRemoteRefInRepo(repo: repo, remote: "origin", ref_name: gunbc.fleet_main_revision.fleet_desired_ref_name)
  if read.exit_code == 0 {
    let line = std.algebra.trim(s: read.advertised)
    if line == "" {
      gunbc.fleet_main_revision.FleetDesiredAbsent
    } else {
      match extdeps.git.object_store.git_object_id_from_untagged_hex(hex: split(s: line, delimiter: "\t").first()) {
        Present { value: oid } => gunbc.fleet_main_revision.FleetDesiredAdmitted { revision: oid }
        Absent => gunbc.fleet_main_revision.FleetDesiredUndecodable { advertised: line }
      }
    }
  } else {
    gunbc.fleet_main_revision.FleetDesiredUnobserved {
      cause: concat("fleet_desired_observe: ls-remote refused: ", read.stderr),
    }
  }
}

// The local half of the comparison: what revision THIS host's deployed tree is at.
// Absent (typed, located in the cause the caller renders) when the repo path is not a
// git repository or HEAD does not decode — never a fabricated revision.
fn observe_local_tree_revision(repo: std.types.FilePath) -> extdeps.git.object_store.GitObjectId? {
  let read = git.Core.RevParseInRepo(repo: repo, target: "HEAD" as std.types.GitRef)
  if read.exit_code == 0 {
    extdeps.git.object_store.git_object_id_from_untagged_hex(hex: std.algebra.trim(s: read.revision))
  } else {
    none
  }
}

// The revision cell of a host's convergence: three states, none collapsible. Converged
// says the deployed tree IS the admitted revision; Drifted carries BOTH sides (the
// membership-diff `from` ruling — a catch-up realization needs the prior, and the
// receipt must name what it observed, not just that it disagreed); Unobserved says the
// comparison could not be made and why — it is unobserved-GRADE for the fold, never
// satisfied (leg-f ruling shape).
type FleetRevisionStanding
  = RevisionConverged { revision: extdeps.git.object_store.GitObjectId }
  | RevisionDrifted { desired: extdeps.git.object_store.GitObjectId, local: extdeps.git.object_store.GitObjectId }
  | RevisionUnobserved { cause: String }

fn fleet_revision_standing(repo: std.types.FilePath) -> FleetRevisionStanding {
  let observed = observe_fleet_desired_revision(repo: repo)
  match gunbc.fleet_main_revision.converge_target_revision(observed: observed) {
    Present { value: desired } =>
      match observe_local_tree_revision(repo: repo) {
        Present { value: local } =>
          if extdeps.git.object_store.git_object_id_eq(left: desired, right: local) {
            RevisionConverged { revision: desired }
          } else {
            RevisionDrifted { desired: desired, local: local }
          }
        Absent =>
          RevisionUnobserved {
            cause: "fleet_desired_observe: local tree revision unreadable (not a git repository, or HEAD undecodable)",
          }
      }
    Absent =>
      match observed {
        FleetDesiredUnobserved { cause: c } => RevisionUnobserved { cause: c }
        FleetDesiredAbsent =>
          RevisionUnobserved {
            cause: concat("fleet_desired_observe: origin advertises no ", gunbc.fleet_main_revision.fleet_desired_ref_name),
          }
        FleetDesiredUndecodable { advertised: line } =>
          RevisionUnobserved {
            cause: concat("fleet_desired_observe: advertisement is not a decodable object id: ", line),
          }
        FleetDesiredAdmitted { revision: _ } =>
          RevisionUnobserved {
            cause: "fleet_desired_observe: admitted revision projected no target (unreachable by construction)",
          }
      }
  }
}
