module gunbc.witness_execution_class


data witness_execution_class_note: std.types.NonEmptyStr = "CI-0 commit 3 (operator recut 2026-08-08): the complete enrolled witness roster is classified EXACTLY ONCE, BEFORE execution — an execution plan, never try-native-then-silently-reinterpret (the fallback shape this PR deletes). Classification is derived from standing facts the corpus already declares, never from a failed native attempt: the file-grain live_tree_disposition row (the same row floor discovery reads, undeclared = ReadsLiveTree per the producer's fail-closed default), the effect requirement, the interpreter-subject axis, and membership in the population the current emitter faithfully carries. There is NO runtime reclassification arm: a NativeRequired witness whose native execution fails REFUSES — no function here can return a different class for the same facts after a failure, because failure is not an input. Honest standing (review 50546/50550 class): the executing consumers today are the witness controls and the commit-3 census receipt (docs/plans/ci0-witness-execution-census.md) — no floor-plan caller classifies the roster in production yet, because the census itself falsified the whole-corpus emission this classifier was to schedule (3 of 8,828 identities emitter-carriable; Outcome C). Dissolve-on / enroll-on: the general witness→TargetModel producer lands (body-lowering keystone), at which point the floor plan derives its execution schedule through classify_witness and this note's standing sentence deletes."

data native_blocked_cause_note: std.types.NonEmptyStr = "Exact typed causes for a pure witness that should eventually be native but crosses a concrete emitter limitation today. GeneralWitnessTargetModelUnavailable is the load-bearing one at census time: the v2 Rust emission path is fixture-bound — every TargetModel carries per-fixture binding_spellings and lex rows, and the general body producer is the named keystone gap (DESIGN body-lowering thread; witness-realization plan P6 names the logic family as the first executable subset). The discriminating executed evidence for this cause class is the existing emit-refusal witnesses (e.g. v2.test.execution.emit_host_classical_not's canonical-emit-refuses-underived control): the emitter genuinely refuses rather than fabricating, so the blocked class is measured, not assumed. One structural wall, counted once per identity — not 8k copies of one diagnostic."

type NativeBlockedCause
  = GeneralWitnessTargetModelUnavailable
  | UnsupportedEmitterConstruction { missing: std.types.NonEmptyStr }
  | BundleClosureEscapes { detail: std.types.NonEmptyStr }
  | OwnershipLoweringUnavailable
  | HostCapabilityUnavailable { capability: std.types.NonEmptyStr }

type WitnessExecutionClass
  = NativeRequired
  | NativeLiveObservation
  | EffectObligation
  | InterpreterSubjectTest
  | NativeBlocked { cause: NativeBlockedCause }

type ClassificationAxis
  = EffectAxis
  | InterpreterSubjectAxis
  | LiveObservationAxis
  | CarriageAxis

data declared_class_precedence: List<ClassificationAxis> = [EffectAxis, InterpreterSubjectAxis, LiveObservationAxis, CarriageAxis]

data declared_class_precedence_note: std.types.NonEmptyStr = "Exclusivity by DECLARED precedence (operator ask, msg_f9334d68): where one witness fits two descriptions — it reads the live tree AND crosses a lowering gap, or performs an effect AND is an interpreter subject — the winning class comes from this declared order, never from code order. Justification, first to last: an effect obligation is an obligation about the WORLD (plan -> execute -> independent readback), so no other description can demote it; an interpreter-subject test executed natively would test the wrong implementation, so it outranks both native axes; a live-tree reader's receipt must bind the observed subject even when the body is otherwise carriable, so observation outranks carriage; carriage (NativeRequired vs NativeBlocked) is last because it is a fact about the EMITTER, not the witness. classify_witness DERIVES its result from this list (a first-applicable fold over declared_class_precedence — reordering the data row alone changes classification; review 50672 caught the earlier hardcoded chain as a second authority), and axis_rank composed with axis_of_class plus the dual-description witnesses assert the realization against this declaration — an undeclared tie-break is the same silent authority this classification exists to kill."

fn axis_rank(axis: ClassificationAxis) -> Int {
  let scanned = v2.std.algebra.fold_list(xs: declared_class_precedence, empty: AxisRankScan { index: 0, found: 0 - 1 }, cons: fn(acc, candidate) {
    AxisRankScan {
      index: acc.index + 1,
      found: if (acc.found < 0) && (candidate == axis) { acc.index } else { acc.found }
    }
  })
  scanned.found
}

type AxisRankScan {
  index: Int
  found: Int
}

fn axis_of_class(class: WitnessExecutionClass) -> ClassificationAxis {
  match class {
    EffectObligation => EffectAxis
    InterpreterSubjectTest => InterpreterSubjectAxis
    NativeLiveObservation => LiveObservationAxis
    NativeRequired => CarriageAxis
    NativeBlocked { cause: _ } => CarriageAxis
  }
}


type WitnessClassRow {
  entry: String
  function: String
  class: WitnessExecutionClass
}

data classify_witness_note: std.types.NonEmptyStr = "Precedence, and why it is this order: an effect obligation stays an effect (plan -> execution -> independent readback) no matter what else is true of it, so it is checked first; a test whose SUBJECT is the interpreter must stay interpreted by definition (native execution would test the wrong implementation), so it outranks the native axes; a live-tree reader may still be emitted native but its receipt must bind the observed subject, so it is its own class rather than NativeRequired; and only a hermetic, non-interpreter-subject, effect-free witness the emitter faithfully carries is NativeRequired. Everything else pure is NativeBlocked with its typed cause. The inputs are standing facts; a native execution FAILURE is deliberately not representable here."

type EmitterCarriage
  = CarriedInEnrolledBundle { bundle_identity: std.types.NonEmptyStr, member: std.types.NonEmptyStr }
  | NoEmitterCarriage { cause: NativeBlockedCause }

data emitter_carriage_note: std.types.NonEmptyStr = "Carriage is EVIDENCE, not an assertion (review 50550 finding 3): NativeRequired is reachable only through CarriedInEnrolledBundle, which must name the enrolled bundle identity and the member spelling — facts a consumer joins against the enrolled SelectedWitnessPlan roster, so a mis-supplied bare true cannot mint NativeRequired. The refusal arm carries its typed NativeBlockedCause on the same coproduct, so carried-with-a-cause and blocked-without-one are unrepresentable."

fn axis_applies(
  axis: ClassificationAxis,
  disposition: Optional<v2.std.live_tree.LiveTreeDisposition>,
  effect_obligation: Bool,
  interpreter_subject: Bool
) -> Bool {
  match axis {
    EffectAxis => effect_obligation
    InterpreterSubjectAxis => interpreter_subject
    LiveObservationAxis => match disposition {
      Present { value: d } => match d {
        ReadsLiveTree => true
        SubstrateInputsOnly => false
      }
      Absent => true
    }
    CarriageAxis => true
  }
}

fn class_for_axis(axis: ClassificationAxis, carriage: EmitterCarriage) -> WitnessExecutionClass {
  match axis {
    EffectAxis => EffectObligation
    InterpreterSubjectAxis => InterpreterSubjectTest
    LiveObservationAxis => NativeLiveObservation
    CarriageAxis => match carriage {
      CarriedInEnrolledBundle { bundle_identity: _, member: _ } => NativeRequired
      NoEmitterCarriage { cause: c } => NativeBlocked { cause: c }
    }
  }
}

fn classify_witness(
  disposition: Optional<v2.std.live_tree.LiveTreeDisposition>,
  effect_obligation: Bool,
  interpreter_subject: Bool,
  carriage: EmitterCarriage
) -> WitnessExecutionClass {
  let winner = v2.std.algebra.fold_list(xs: declared_class_precedence, empty: Absent, cons: fn(acc, axis) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match axis_applies(axis: axis, disposition: disposition, effect_obligation: effect_obligation, interpreter_subject: interpreter_subject) {
          true => Present { value: axis }
          false => Absent
        }
    }
  })
  match winner {
    Present { value: axis } => class_for_axis(axis: axis, carriage: carriage)
    Absent => class_for_axis(axis: CarriageAxis, carriage: carriage)
  }
}

type WitnessClassCensus {
  total: Int
  native_required: Int
  native_live_observation: Int
  effect_obligation: Int
  interpreter_subject: Int
  native_blocked: Int
}

fn census_zero() -> WitnessClassCensus {
  WitnessClassCensus {
    total: 0,
    native_required: 0,
    native_live_observation: 0,
    effect_obligation: 0,
    interpreter_subject: 0,
    native_blocked: 0
  }
}

fn census_add(c: WitnessClassCensus, class: WitnessExecutionClass) -> WitnessClassCensus {
  match class {
    NativeRequired => WitnessClassCensus { total: c.total + 1, native_required: c.native_required + 1, native_live_observation: c.native_live_observation, effect_obligation: c.effect_obligation, interpreter_subject: c.interpreter_subject, native_blocked: c.native_blocked }
    NativeLiveObservation => WitnessClassCensus { total: c.total + 1, native_required: c.native_required, native_live_observation: c.native_live_observation + 1, effect_obligation: c.effect_obligation, interpreter_subject: c.interpreter_subject, native_blocked: c.native_blocked }
    EffectObligation => WitnessClassCensus { total: c.total + 1, native_required: c.native_required, native_live_observation: c.native_live_observation, effect_obligation: c.effect_obligation + 1, interpreter_subject: c.interpreter_subject, native_blocked: c.native_blocked }
    InterpreterSubjectTest => WitnessClassCensus { total: c.total + 1, native_required: c.native_required, native_live_observation: c.native_live_observation, effect_obligation: c.effect_obligation, interpreter_subject: c.interpreter_subject + 1, native_blocked: c.native_blocked }
    NativeBlocked { cause: _ } => WitnessClassCensus { total: c.total + 1, native_required: c.native_required, native_live_observation: c.native_live_observation, effect_obligation: c.effect_obligation, interpreter_subject: c.interpreter_subject, native_blocked: c.native_blocked + 1 }
  }
}

fn census_of(rows: List<WitnessClassRow>) -> WitnessClassCensus {
  v2.std.algebra.fold_list(xs: rows, empty: census_zero(), cons: fn(acc, row) { census_add(c: acc, class: row.class) })
}

fn census_accounts_for_every_row(rows: List<WitnessClassRow>) -> Bool {
  let c = census_of(rows: rows)
  c.total == length_of(rows)
    && c.native_required + c.native_live_observation + c.effect_obligation + c.interpreter_subject + c.native_blocked == c.total
}

fn length_of(rows: List<WitnessClassRow>) -> Int {
  v2.std.algebra.fold_list(xs: rows, empty: 0, cons: fn(acc, _row) { acc + 1 })
}

fn row_identity(row: WitnessClassRow) -> String {
  concat(row.entry, concat("::", row.function))
}

type IdentityScanState {
  prev: String
  has_prev: Bool
  duplicates: Int
}

fn duplicate_identity_count(rows: List<WitnessClassRow>) -> Int {
  let sorted = map(rows, row => row_identity(row: row)) |> sort_by(identity => identity)
  let scanned = v2.std.algebra.fold_list(xs: sorted, empty: IdentityScanState { prev: "", has_prev: false, duplicates: 0 }, cons: fn(acc, identity) {
    if acc.has_prev && acc.prev == identity {
      IdentityScanState { prev: identity, has_prev: true, duplicates: acc.duplicates + 1 }
    } else {
      IdentityScanState { prev: identity, has_prev: true, duplicates: acc.duplicates }
    }
  })
  scanned.duplicates
}

fn every_identity_classified_exactly_once(rows: List<WitnessClassRow>) -> Bool {
  duplicate_identity_count(rows: rows) == 0
}
