module gunbc.emit_copy_qualification_fixture_gen

import std.types { Bool, Int, List, String }
import gunbc.emit_copy_qualification {
  CarrierRealization, CopyScalarControl, OwnedStringCarrier, DeepCloningSequenceCarrier,
  SharedRecordCarrier, PersistentSequenceCarrier, PersistentMapCarrier, NestedCheapDeepRecordCarrier,
  OwnershipPattern, ConsumedOnce, BorrowedReadOnly, ByValueThenReused, BranchExclusive,
  ReuseAcrossJoin, AliasThenMutate, MoveIntoClosure, BorrowIntoClosure, LoopCarriedAccumulator,
  FieldExtractThenReuseEnclosing,
  ControlShape, StraightLine, IfSplit, MatchBinding, LoopRecursion,
  ConsumerContract, ConsumesByValue, BorrowsByRef,
  InputSizeBasis, ScalarUnitBasis, SizedCardinalityBasis,
  EmitCopyQualificationCaseId, EmitCopyQualificationCaseRow, CaseApplicable, CaseNotApplicable,
  full_case_roster, row_is_applicable, case_slug, carrier_realization_slug,
  declared_cardinalities, scalar_cardinality
}

// EMIT-COST-QUAL-0 fixture generator. The grid module is the single authority for WHICH cases
// exist; this module renders each applicable case as ordinary-looking .dag source (a producer
// input fn + a subject fn per case, plus shared per-carrier helpers), assembles one fixture
// module per carrier SHARD, and renders the test-workspace-only observation transport (runner
// main.rs with a counting allocator, and the shard crate manifest). Nothing here touches the
// production emitter: the fixture text travels the ordinary `gunbc compile` door and the runner
// is workspace text the emitted crate never sees.
//
// CONSUMER-CONTRACT REALIZATION, stated once: .dag has no reference syntax, so the contract is
// realized through the production emitter's own read-only-parameter derivation
// (v1.compiler.ownership build_read_only_params): a ConsumesByValue callee uses its parameter
// exactly once (fan_out 1 — never derived read-only), a BorrowsByRef callee reads its parameter
// more than once (all uses Read/Projected — derived read-only). The contract axis therefore
// measures the emitter's own by-value/by-ref decision, which is the subject under test.
//
// MUTANTS are named modeled transformations applied AT GENERATION (a MutantPlan parameter to the
// same generator), never hand-edited Rust specimens. Runner-grain mutants plant work inside the
// observation window or disconnect the counter — they falsify the INSTRUMENT ARMS; the
// copied-accumulator mutant transforms the .dag fixture itself and travels the full emission
// path — it falsifies the end-to-end battery on an emitter-side cost-shape regression while
// preserving behavior.
type MutantPlan
  = CleanSubject
  | PlantRedundantShareClone
  | PlantHiddenDeepCopy
  | PlantRedundantDeepClone
  | DisconnectCounter
  | PlantCopiedAccumulator

fn mutant_plan_slug(m: MutantPlan) -> String {
  match m {
    CleanSubject => "clean_subject"
    PlantRedundantShareClone => "plant_redundant_share_clone"
    PlantHiddenDeepCopy => "plant_hidden_deep_copy"
    PlantRedundantDeepClone => "plant_redundant_deep_clone"
    DisconnectCounter => "disconnect_counter"
    PlantCopiedAccumulator => "plant_copied_accumulator"
  }
}

// ── Shard roster: applicable cases of one carrier ────────────────────────────────────────────
fn shard_case_rows(carrier: CarrierRealization) -> List<EmitCopyQualificationCaseRow> {
  full_case_roster()
    |> filter(r => row_is_applicable(r: r))
    |> filter(r => r.id.carrier_realization == carrier)
}

fn shard_cardinalities(id: EmitCopyQualificationCaseId) -> List<Int> {
  match id.input_size_basis {
    ScalarUnitBasis => [scalar_cardinality]
    SizedCardinalityBasis => declared_cardinalities
  }
}

// ── Per-carrier .dag snippets ────────────────────────────────────────────────────────────────
fn carrier_type_text(c: CarrierRealization) -> String {
  match c {
    CopyScalarControl => "Int"
    OwnedStringCarrier => "String"
    DeepCloningSequenceCarrier => "Int"
    SharedRecordCarrier => "EcqSharedRec"
    PersistentSequenceCarrier => "List<Int>"
    PersistentMapCarrier => "Map<String, Int>"
    NestedCheapDeepRecordCarrier => "EcqNestedRec"
  }
}

// Record declarations are emitted only into the shards that use them. The nested record keeps
// its deep String field at a FIXED size ("np"): the sized dimension lives in `items` only, so a
// constant-expectation case cannot be silently linear through the name field.
fn carrier_decl_text(c: CarrierRealization) -> String {
  match c {
    SharedRecordCarrier => "type EcqSharedRec {\n  tag: Int\n  items: List<Int>\n}\n\n"
    NestedCheapDeepRecordCarrier => "type EcqNestedRec {\n  tag: Int\n  name: String\n  items: List<Int>\n}\n\n"
    _ => ""
  }
}

fn carrier_input_expr(c: CarrierRealization) -> String {
  match c {
    CopyScalarControl => "n"
    OwnedStringCarrier => "ecq_build_text(n: n)"
    DeepCloningSequenceCarrier => "n"
    SharedRecordCarrier => "EcqSharedRec { tag: n, items: ecq_build_list(n: n) }"
    PersistentSequenceCarrier => "ecq_build_list(n: n)"
    PersistentMapCarrier => "ecq_build_map(n: n)"
    NestedCheapDeepRecordCarrier => "EcqNestedRec { tag: n, name: \"np\", items: ecq_build_list(n: n) }"
  }
}

// Single-use whole-value read of the carrier (the ConsumesByValue callee body: fan_out 1).
fn carrier_consume_body(c: CarrierRealization) -> String {
  match c {
    CopyScalarControl => "v"
    OwnedStringCarrier => "string_length(v)"
    DeepCloningSequenceCarrier => "v"
    SharedRecordCarrier => "count(v.items)"
    PersistentSequenceCarrier => "count(v)"
    PersistentMapCarrier => "count(map_keys(v))"
    NestedCheapDeepRecordCarrier => "count(v.items)"
  }
}

// Two reads of the carrier (the BorrowsByRef callee body: fan_out 2, all Read/Projected).
fn carrier_read_body(c: CarrierRealization) -> String {
  match c {
    CopyScalarControl => "v + v"
    OwnedStringCarrier => "string_length(v) + string_length(v)"
    DeepCloningSequenceCarrier => "v + v"
    SharedRecordCarrier => "count(v.items) + v.tag"
    PersistentSequenceCarrier => "count(v) + count(v)"
    PersistentMapCarrier => "count(map_keys(v)) + count(map_keys(v))"
    NestedCheapDeepRecordCarrier => "count(v.items) + v.tag"
  }
}

fn carrier_size_body(c: CarrierRealization) -> String {
  match c {
    CopyScalarControl => "v"
    OwnedStringCarrier => "string_length(v)"
    DeepCloningSequenceCarrier => "v"
    SharedRecordCarrier => "count(v.items)"
    PersistentSequenceCarrier => "count(v)"
    PersistentMapCarrier => "count(map_keys(v))"
    NestedCheapDeepRecordCarrier => "count(v.items)"
  }
}

// One derived version diverging from the input (the alias-then-mutate update). Constant-size
// divergence by construction: the updated element is fixed, never n-scaled.
fn carrier_update_expr(c: CarrierRealization) -> String {
  match c {
    CopyScalarControl => "v + 1"
    OwnedStringCarrier => "concat(v, \"z\")"
    DeepCloningSequenceCarrier => "v + 1"
    SharedRecordCarrier => "EcqSharedRec { tag: v.tag + 1, items: v.items }"
    PersistentSequenceCarrier => "list_push(v, 999)"
    PersistentMapCarrier => "map_insert(v, \"zz\", 999)"
    NestedCheapDeepRecordCarrier => "EcqNestedRec { tag: v.tag + 1, name: v.name, items: v.items }"
  }
}

// Loop-carried accumulator body per carrier: fold over the seed list building a size-n result
// of the carrier's own kind. The clean shape mentions the accumulator exactly once per step.
// PlantCopiedAccumulator is the named modeled transformation: it defeats single-use accumulator
// threading by re-mentioning the accumulator on a value-preserving guard (always-false branch),
// so the emitter's fold-accumulator disposition sees a multi-use accumulator. Behavior is
// unchanged; only the cost shape may change — exactly what the battery must detect end-to-end.
fn carrier_accumulator_expr(c: CarrierRealization, mutant: MutantPlan) -> String {
  let step = match c {
    CopyScalarControl => "acc + e"
    OwnedStringCarrier => "concat(acc, \"ab\")"
    DeepCloningSequenceCarrier => "acc + e"
    SharedRecordCarrier => "EcqSharedRec { tag: acc.tag + e, items: list_push(acc.items, e) }"
    PersistentSequenceCarrier => "list_push(acc, e)"
    PersistentMapCarrier => "map_insert(acc, to_string(e), e)"
    NestedCheapDeepRecordCarrier => "EcqNestedRec { tag: acc.tag + e, name: acc.name, items: list_push(acc.items, e) }"
  }
  let guarded_step = match mutant {
    PlantCopiedAccumulator =>
      match c {
        OwnedStringCarrier => "if string_length(acc) < 0 - 1 { acc } else { concat(acc, \"ab\") }"
        _ => step
      }
    _ => step
  }
  let init = match c {
    CopyScalarControl => "0"
    OwnedStringCarrier => "\"\""
    DeepCloningSequenceCarrier => "0"
    SharedRecordCarrier => "EcqSharedRec { tag: 0, items: [] }"
    PersistentSequenceCarrier => "[]"
    PersistentMapCarrier => "empty_map()"
    NestedCheapDeepRecordCarrier => "EcqNestedRec { tag: 0, name: \"np\", items: [] }"
  }
  let result_read = match c {
    CopyScalarControl => "r"
    OwnedStringCarrier => "string_length(r)"
    DeepCloningSequenceCarrier => "r"
    SharedRecordCarrier => "r.tag + count(r.items)"
    PersistentSequenceCarrier => "count(r)"
    PersistentMapCarrier => "count(map_keys(r))"
    NestedCheapDeepRecordCarrier => "r.tag + count(r.items)"
  }
  concat("let r = xs |> fold(init: ", concat(init, concat(", f: (acc, e) => ", concat(guarded_step, concat(")\n  ", result_read)))))
}

// ── Case body templates ──────────────────────────────────────────────────────────────────────
fn contract_callee_name(carrier: CarrierRealization, k: ConsumerContract) -> String {
  match k {
    ConsumesByValue => concat("ecq_consume_", carrier_realization_slug(c: carrier))
    BorrowsByRef => concat("ecq_read_", carrier_realization_slug(c: carrier))
  }
}

fn call_u(carrier: CarrierRealization, k: ConsumerContract, arg: String) -> String {
  concat(contract_callee_name(carrier: carrier, k: k), concat("(v: ", concat(arg, ")")))
}

fn size_call(carrier: CarrierRealization, arg: String) -> String {
  concat("ecq_size_", concat(carrier_realization_slug(c: carrier), concat("(v: ", concat(arg, ")"))))
}

fn classify_call(carrier: CarrierRealization, arg: String) -> String {
  concat("ecq_classify_", concat(carrier_realization_slug(c: carrier), concat("(v: ", concat(arg, ")"))))
}

fn update_call(carrier: CarrierRealization, arg: String) -> String {
  concat("ecq_update_", concat(carrier_realization_slug(c: carrier), concat("(v: ", concat(arg, ")"))))
}

fn subject_body(id: EmitCopyQualificationCaseId, mutant: MutantPlan) -> String {
  let c = id.carrier_realization
  let k = id.consumer_contract
  match id.ownership_pattern {
    ConsumedOnce => call_u(carrier: c, k: k, arg: "x")
    BorrowedReadOnly =>
      concat("let a = ", concat(call_u(carrier: c, k: k, arg: "x"),
      concat("\n  let b = ", concat(call_u(carrier: c, k: k, arg: "x"), "\n  a + b"))))
    ByValueThenReused =>
      concat("let a = ", concat(call_u(carrier: c, k: k, arg: "x"),
      concat("\n  let b = ", concat(call_u(carrier: c, k: k, arg: "x"), "\n  a + b"))))
    BranchExclusive =>
      match id.control_shape {
        MatchBinding =>
          concat("match ", concat(classify_call(carrier: c, arg: "x"),
          concat(" {\n    EcqSmallSize => 7\n    EcqLargeSize => ", concat(call_u(carrier: c, k: k, arg: "x"), "\n  }"))))
        _ =>
          concat("if ", concat(size_call(carrier: c, arg: "x"),
          concat(" > 2 { ", concat(call_u(carrier: c, k: k, arg: "x"), " } else { 7 }"))))
      }
    ReuseAcrossJoin =>
      match id.control_shape {
        MatchBinding =>
          concat("let a = match ", concat(classify_call(carrier: c, arg: "x"),
          concat(" {\n    EcqSmallSize => ", concat(call_u(carrier: c, k: k, arg: "x"),
          concat(" + 1\n    EcqLargeSize => ", concat(call_u(carrier: c, k: k, arg: "x"),
          concat("\n  }\n  a + ", concat(call_u(carrier: c, k: k, arg: "x"), ""))))))))
        _ =>
          concat("let a = if ", concat(size_call(carrier: c, arg: "x"),
          concat(" > 2 { ", concat(call_u(carrier: c, k: k, arg: "x"),
          concat(" } else { ", concat(call_u(carrier: c, k: k, arg: "x"),
          concat(" + 1 }\n  a + ", concat(call_u(carrier: c, k: k, arg: "x"), ""))))))))
      }
    AliasThenMutate =>
      concat("let y = x\n  let z = ", concat(update_call(carrier: c, arg: "y"),
      concat("\n  ", concat(call_u(carrier: c, k: k, arg: "z"),
      concat(" + ", call_u(carrier: c, k: k, arg: "x"))))))
    MoveIntoClosure =>
      concat("[1] |> map(t => ", concat(call_u(carrier: c, k: k, arg: "x"),
      " + t) |> fold(init: 0, f: (p, q) => p + q)"))
    BorrowIntoClosure =>
      concat("let a = [1] |> map(t => ", concat(call_u(carrier: c, k: k, arg: "x"),
      concat(" + t) |> fold(init: 0, f: (p, q) => p + q)\n  a + ", call_u(carrier: c, k: k, arg: "x"))))
    LoopCarriedAccumulator => carrier_accumulator_expr(c: c, mutant: mutant)
    FieldExtractThenReuseEnclosing =>
      let field_callee = match k {
        ConsumesByValue => "ecq_consume_items"
        BorrowsByRef => "ecq_read_items"
      }
      concat("let f = x.items\n  ", concat(field_callee, "(v: f) + x.tag"))
  }
}

fn subject_param_type(id: EmitCopyQualificationCaseId) -> String {
  match id.ownership_pattern {
    LoopCarriedAccumulator => "List<Int>"
    _ => carrier_type_text(c: id.carrier_realization)
  }
}

fn subject_param_name(id: EmitCopyQualificationCaseId) -> String {
  match id.ownership_pattern {
    LoopCarriedAccumulator => "xs"
    _ => "x"
  }
}

fn input_expr(id: EmitCopyQualificationCaseId) -> String {
  match id.ownership_pattern {
    LoopCarriedAccumulator => "ecq_build_list(n: n)"
    _ => carrier_input_expr(c: id.carrier_realization)
  }
}

fn case_fn_text(id: EmitCopyQualificationCaseId, mutant: MutantPlan) -> String {
  let slug = case_slug(id: id)
  let input_fn = concat("fn ecq_input_", concat(slug,
    concat("(n: Int) -> ", concat(subject_param_type(id: id),
    concat(" {\n  ", concat(input_expr(id: id), "\n}\n\n"))))))
  let subject_fn = concat("fn ecq_subject_", concat(slug,
    concat("(", concat(subject_param_name(id: id),
    concat(": ", concat(subject_param_type(id: id),
    concat(") -> Int {\n  ", concat(subject_body(id: id, mutant: mutant), "\n}\n\n"))))))))
  concat(input_fn, subject_fn)
}

// ── Shared helper text per shard ─────────────────────────────────────────────────────────────
fn shard_prelude_text(c: CarrierRealization) -> String {
  let slug = carrier_realization_slug(c: c)
  let builders = concat(
    "fn ecq_build_text(n: Int) -> String {\n  if n == 0 { \"\" } else { concat(ecq_build_text(n: n - 1), \"ab\") }\n}\n\n",
    concat("fn ecq_build_list(n: Int) -> List<Int> {\n  if n == 0 { [] } else { list_push(ecq_build_list(n: n - 1), n) }\n}\n\n",
    "fn ecq_build_map(n: Int) -> Map<String, Int> {\n  if n == 0 { empty_map() } else { map_insert(ecq_build_map(n: n - 1), to_string(n), n) }\n}\n\n"))
  let size_class = "type EcqSizeClass = EcqSmallSize | EcqLargeSize\n\n"
  let t = carrier_type_text(c: c)
  let helpers = concat(
    concat("fn ecq_consume_", concat(slug, concat("(v: ", concat(t, concat(") -> Int {\n  ", concat(carrier_consume_body(c: c), "\n}\n\n")))))),
    concat(
      concat("fn ecq_read_", concat(slug, concat("(v: ", concat(t, concat(") -> Int {\n  ", concat(carrier_read_body(c: c), "\n}\n\n")))))),
      concat(
        concat("fn ecq_size_", concat(slug, concat("(v: ", concat(t, concat(") -> Int {\n  ", concat(carrier_size_body(c: c), "\n}\n\n")))))),
        concat(
          concat("fn ecq_classify_", concat(slug, concat("(v: ", concat(t, concat(") -> EcqSizeClass {\n  if ", concat(size_call(carrier: c, arg: "v"), " > 2 { EcqLargeSize } else { EcqSmallSize }\n}\n\n")))))),
          concat("fn ecq_update_", concat(slug, concat("(v: ", concat(t, concat(") -> ", concat(t, concat(" {\n  ", concat(carrier_update_expr(c: c), "\n}\n\n"))))))))))))
  let field_helpers = if carrier_is_record_gen(c: c) {
    concat(
      "fn ecq_consume_items(v: List<Int>) -> Int {\n  count(v)\n}\n\n",
      "fn ecq_read_items(v: List<Int>) -> Int {\n  count(v) + count(v)\n}\n\n")
  } else { "" }
  concat(carrier_decl_text(c: c), concat(size_class, concat(builders, concat(helpers, field_helpers))))
}

fn carrier_is_record_gen(c: CarrierRealization) -> Bool {
  match c {
    SharedRecordCarrier => true
    NestedCheapDeepRecordCarrier => true
    _ => false
  }
}

// ── Interpreted shard driver: one line per case x cardinality, same grammar as the runner ────
fn driver_line_expr(id: EmitCopyQualificationCaseId, n: Int) -> String {
  let slug = case_slug(id: id)
  concat("concat(\"case=", concat(slug, concat(" n=", concat(to_string(n),
  concat(" result=\", to_string(ecq_subject_", concat(slug,
  concat("(", concat(subject_param_name(id: id), concat(": ecq_input_", concat(slug,
  concat("(n: ", concat(to_string(n), "))))"))))))))))))
}

// The interpreted driver is its OWN module, deliberately outside the emission entry closure:
// `gunbc compile --entry <fixture>` never sees it, so the emitted crate stays the pure fixture,
// while `gunbc run` interprets the driver (fixture imported by name) and delivers its lines
// through a typed Filesystem.Write to the path the transport passes as --arg. gunbc run admits
// only ProcessExit-returning entries, so the report travels as written bytes, never as a value
// smuggled through an error rendering.
fn driver_imported_fn_names(c: CarrierRealization) -> List<String> {
  shard_case_rows(carrier: c) |> flat_map(r =>
    let slug = case_slug(id: r.id)
    [concat("ecq_input_", slug), concat("ecq_subject_", slug)]
  )
}

fn driver_module_name(c: CarrierRealization) -> String {
  concat(fixture_module_name(c: c), "_driver")
}

fn driver_module_text(c: CarrierRealization) -> String {
  let rows = shard_case_rows(carrier: c)
  let names = driver_imported_fn_names(c: c) |> fold(init: "", f: (acc, n) =>
    if acc == "" { n } else { concat(acc, concat(", ", n)) })
  let header = concat("module ", concat(driver_module_name(c: c),
    concat("\n\nimport std.process { ProcessExit, ExitSuccess, exit_failure }\nimport extdeps.filesystem.filesystem_io\nimport ", concat(fixture_module_name(c: c),
    concat(" { ", concat(names, " }\n\n"))))))
  let line_exprs = rows |> flat_map(r =>
    shard_cardinalities(id: r.id) |> map(n => driver_line_expr(id: r.id, n: n))
  )
  let joined = line_exprs |> fold(init: "", f: (acc, e) =>
    if acc == "" { e } else { concat(acc, concat(",\n    ", e)) }
  )
  concat(header,
  concat("fn ecq_driver_main(out: String) -> ProcessExit {\n  let lines = [\n    ", concat(joined,
  "\n  ]\n  let report = lines |> fold(init: \"\", f: (acc, l) => if acc == \"\" { l } else { concat(acc, concat(\"\\n\", l)) })\n  let wrote = Filesystem.Write(path: out, content: report)\n  if wrote.success { ExitSuccess } else { exit_failure(reason: \"ecq driver report write refused\") }\n}\n")))
}

// ── The fixture module per (carrier, mutant) ─────────────────────────────────────────────────
fn fixture_module_name(c: CarrierRealization) -> String {
  concat("test.fixture.emit_copy_", carrier_realization_slug(c: c))
}

fn fixture_module_text(c: CarrierRealization, mutant: MutantPlan) -> String {
  let header = concat("module ", concat(fixture_module_name(c: c), "\n\n"))
  let cases = shard_case_rows(carrier: c) |> fold(init: "", f: (acc, r) =>
    concat(acc, case_fn_text(id: r.id, mutant: mutant))
  )
  concat(header, concat(shard_prelude_text(c: c), cases))
}

// ── Runner (test-workspace observation transport, generated Rust text) ───────────────────────
// The runner is the ONLY holder of counters: a counting global allocator wrapping System.
// Window discipline per the ruling: input is built before the window opens; exactly one case
// activates per window; execution is serial; the counter is read before result formatting.
// Repeats run inside the runner (declared count below); unequal repeat observations print an
// `observation=nondeterministic` row instead of numbers — a typed refusal upstream, never an
// averaged number. The connectivity control makes a disconnected counter DETECTED, not zero:
// a deliberate allocation must be counted before any case runs, else the runner exits with the
// `counter=disconnected` marker (the dead-counter precedent, applied as a control).
data runner_repeat_count: Int = 3

data runner_prelude_text: String = "use std::alloc::\{GlobalAlloc, Layout, System};\nuse std::sync::atomic::\{AtomicU64, Ordering};\n\nstruct EcqCounting;\nstatic ECQ_ALLOC_OPS: AtomicU64 = AtomicU64::new(0);\nstatic ECQ_ALLOC_BYTES: AtomicU64 = AtomicU64::new(0);\nunsafe impl GlobalAlloc for EcqCounting {\n    unsafe fn alloc(&self, l: Layout) -> *mut u8 {\n        ECQ_ALLOC_OPS.fetch_add(1, Ordering::Relaxed);\n        ECQ_ALLOC_BYTES.fetch_add(l.size() as u64, Ordering::Relaxed);\n        System.alloc(l)\n    }\n    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {\n        System.dealloc(p, l)\n    }\n}\n#[global_allocator]\nstatic ECQ_A: EcqCounting = EcqCounting;\n\nfn ecq_window<R, F: FnOnce() -> R>(f: F) -> (R, u64, u64) {\n    let o0 = ECQ_ALLOC_OPS.load(Ordering::Relaxed);\n    let b0 = ECQ_ALLOC_BYTES.load(Ordering::Relaxed);\n    let r = f();\n    let o1 = ECQ_ALLOC_OPS.load(Ordering::Relaxed);\n    let b1 = ECQ_ALLOC_BYTES.load(Ordering::Relaxed);\n    (r, o1 - o0, b1 - b0)\n}\n"

// The DisconnectCounter mutant omits the #[global_allocator] registration line — the named
// transformation is this substitution, applied at generation.
data runner_prelude_disconnected_text: String = "use std::alloc::\{GlobalAlloc, Layout, System};\nuse std::sync::atomic::\{AtomicU64, Ordering};\n\nstruct EcqCounting;\nstatic ECQ_ALLOC_OPS: AtomicU64 = AtomicU64::new(0);\nstatic ECQ_ALLOC_BYTES: AtomicU64 = AtomicU64::new(0);\nunsafe impl GlobalAlloc for EcqCounting {\n    unsafe fn alloc(&self, l: Layout) -> *mut u8 {\n        ECQ_ALLOC_OPS.fetch_add(1, Ordering::Relaxed);\n        ECQ_ALLOC_BYTES.fetch_add(l.size() as u64, Ordering::Relaxed);\n        System.alloc(l)\n    }\n    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {\n        System.dealloc(p, l)\n    }\n}\n\nfn ecq_window<R, F: FnOnce() -> R>(f: F) -> (R, u64, u64) {\n    let o0 = ECQ_ALLOC_OPS.load(Ordering::Relaxed);\n    let b0 = ECQ_ALLOC_BYTES.load(Ordering::Relaxed);\n    let r = f();\n    let o1 = ECQ_ALLOC_OPS.load(Ordering::Relaxed);\n    let b1 = ECQ_ALLOC_BYTES.load(Ordering::Relaxed);\n    (r, o1 - o0, b1 - b0)\n}\n"

data runner_connectivity_control_text: String = "    let (_probe, co, cb) = ecq_window(|| {\n        let v = std::hint::black_box(vec![1u8; 4096]);\n        v.len() as i64\n    });\n    if co == 0 || cb < 4096 {\n        println!(\"counter=disconnected\");\n        std::process::exit(3);\n    }\n    println!(\"counter=connected\");\n"

// Runner-grain instrument mutants wrap the subject argument INSIDE the window: the planted
// redundant clones and the hidden deep copy are exactly the shapes the two arms must catch
// independently. Clean subjects pass the input unmodified.
fn runner_arg_expr(mutant: MutantPlan) -> String {
  match mutant {
    PlantRedundantShareClone => "{ let input = input.clone(); input }"
    PlantRedundantDeepClone => "{ let input = input.clone(); input }"
    PlantHiddenDeepCopy => "{ let rebuilt: String = input.chars().collect(); rebuilt }"
    _ => "input"
  }
}

fn runner_case_block(module_path: String, id: EmitCopyQualificationCaseId, mutant: MutantPlan) -> String {
  let slug = case_slug(id: id)
  let ns = shard_cardinalities(id: id)
  let ns_text = ns |> fold(init: "", f: (acc, n) =>
    if acc == "" { concat(to_string(n), "i64") } else { concat(acc, concat(", ", concat(to_string(n), "i64"))) }
  )
  concat("    for n in [", concat(ns_text, concat("] {\n        let mut seen: Vec<(i64, u64, u64)> = std::vec::Vec::new();\n        for _rep in 0..", concat(to_string(runner_repeat_count), concat(" {\n            let input = ", concat(module_path, concat("::ecq_input_", concat(slug, concat("(n);\n            let (r, o, b) = ecq_window(|| ", concat(module_path, concat("::ecq_subject_", concat(slug, concat("(", concat(runner_arg_expr(mutant: mutant), concat("));\n            seen.push((ecq_result_scalar(&r), o, b));\n        }\n        if seen.iter().all(|s| *s == seen[0]) {\n            println!(\"case=", concat(slug, concat(" n={} result={} alloc_ops={} alloc_bytes={}\", n, seen[0].0, seen[0].1, seen[0].2);\n        } else {\n            println!(\"case=", concat(slug, " n={} observation=nondeterministic\", n);\n        }\n    }\n")))))))))))))))))))
}

// The subject's return is Int-realized; the scalar reader tolerates either the bare or the
// shared spelling without naming the emitted type (Deref makes both print, but tuples need Eq,
// so the runner normalizes through a i64-returning helper generated once).
data runner_result_scalar_text: String = "fn ecq_result_scalar<T: std::ops::Deref<Target = i64>>(r: &T) -> i64 { **r }\n"

data runner_result_scalar_bare_text: String = "fn ecq_result_scalar(r: &i64) -> i64 { *r }\n"

fn runner_main_text(module_path: String, c: CarrierRealization, mutant: MutantPlan, result_is_shared: Bool) -> String {
  let prelude = match mutant {
    DisconnectCounter => runner_prelude_disconnected_text
    _ => runner_prelude_text
  }
  let scalar_reader = if result_is_shared { runner_result_scalar_text } else { runner_result_scalar_bare_text }
  let blocks = shard_case_rows(carrier: c) |> fold(init: "", f: (acc, r) =>
    concat(acc, runner_case_block(module_path: module_path, id: r.id, mutant: mutant))
  )
  concat(prelude, concat(scalar_reader, concat("\nfn main() {\n", concat(runner_connectivity_control_text, concat(blocks, "    println!(\"ecq_runner_done\");\n}\n")))))
}

// ── Shard crate manifest (path dependency on the seed crate for v1_rt, per the
//    emitted-closure probe precedent; features forwarded so -D warnings stays green) ──────────
fn shard_runner_bin_name(c: CarrierRealization, mutant: MutantPlan) -> String {
  concat("ecq_runner_", concat(carrier_realization_slug(c: c), concat("_", mutant_plan_slug(m: mutant))))
}

fn shard_crate_name(c: CarrierRealization, mutant: MutantPlan) -> String {
  concat("emit_copy_qual_", concat(carrier_realization_slug(c: c), concat("_", mutant_plan_slug(m: mutant))))
}

// The emitted fixture module's Rust module path inside the shard crate: the emitter renders
// module dots as underscores. Confirmed against the production emission probe before enrollment;
// the wet transport refuses (CaseNotExecutable at cargo_build) if the spelling drifts, so this
// is a checked derivation, not a hope.
fn shard_fixture_rust_module_path(c: CarrierRealization, mutant: MutantPlan) -> String {
  concat(shard_crate_name(c: c, mutant: mutant), concat("::test_fixture_emit_copy_", carrier_realization_slug(c: c)))
}

fn shard_manifest_text(workspace_root: String, c: CarrierRealization, mutant: MutantPlan) -> String {
  concat("[package]\nname = \"", concat(shard_crate_name(c: c, mutant: mutant),
  concat("\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\npath = \"src/lib.rs\"\n\n[[bin]]\nname = \"", concat(shard_runner_bin_name(c: c, mutant: mutant),
  concat("\"\npath = \"src/bin/ecq_runner.rs\"\n\n[dependencies]\nv1-compiler = { path = \"", concat(workspace_root,
  "/src/v1/stage0\" }\n\n[features]\ntext_lookup_work_counter = []\ninterp_test_witness = []\ntest_hooks = []\n"))))))
}
