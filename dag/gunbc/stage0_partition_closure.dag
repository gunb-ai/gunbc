module gunbc.stage0_partition_closure


// WHY THIS EXISTS: a gate reported ZERO DRIFT on a tree whose partition crates would not
// compile. It was not missing drift - within its registered roster it regenerates every
// artifact and compares bytes, and it is complete. Its roster simply does not cover the
// emitted stage0 seed or the partition crate lib.rs files, which belong to regen_stage0.
// So "clean" meant "the artifacts I am registered for match", and it was read as "the tree
// is consistent". A SCOPE STATEMENT READ AS A TREE STATEMENT.
//
// That is why every verdict here CARRIES ITS OWN EXTENT. A clean answer that does not state
// the population it covered invites exactly that misreading, and the misreading is not a
// reader error when the verdict omitted the denominator.
//
// THE INVARIANT, arrived at after three wrong candidates - each recorded because each would
// have shipped a gate that refuses correct rows:
//   (1) "every emitted module is in some crate roster" - WRONG. 75 of 138 emit-plan modules
//       are legitimately unassigned and live in the monolith crate.
//   (2) "a crate's modules only reference their roster-mates" - WRONG. `use crate::NonEmptyVec`
//       names a TYPE, not a module.
//   (3) "...only reference its own pub mod set" - WRONG. Crates reach each other through glob
//       re-exports (`pub use v1_stage0_std_core::*`).
// The invariant is REFERENCE CLOSURE OVER THE REEXPORT-TRANSITIVE SET: a module owned by
// crate C may only reference modules reachable from C, where reachable means C's own modules
// plus, transitively, the modules of the packages C re-exports.

data partition_closure_authority_note: String = "EDGE AUTHORITY IS dependency_resolution_facts_live, deliberately, and NOT the .dag import lists. Measured 2026-08-10: dag/std/syntax.dag, dag/std/coercion.dag and dag/std/http_path.dag each declare ZERO imports while referencing std_types, so their import list is the EMPTY SET while their real reference set is not - an empty import list is the MAXIMAL under-approximation. A closure check reading import lists computes a smaller reference set than the real one, finds nothing unreachable, and passes while the crate cannot resolve: the same fail-open this gate exists to close, one authority over. v2.lens.module_graph states the swap contract directly - do not add a second edge producer beside dependency_resolution_facts_live, the swap replaces its body - so consuming it is both correct today (import facts unioned with reference-derived facts) and correct after the accepted-binding cutover, with no edit here."

data partition_closure_basename_authority_note: String = "MODULE IDENTITY IS THE SUBJECT; EMITTED SPELLING IS PROJECTED, NEVER RECOMPUTED. The mapping from a module path to its emitted basename is gunbc.stage0_emit_plan stage0_module_emit_basename, over rust_qualified_module_mod_basename. Spelling the dots-to-underscores transformation here would be a second naming scheme for something an authority already names - the section 3 nickname class - and it would additionally have been a per-character walk over a quadratic primitive. The gate consumes the projection."

// One partition crate's reachable module set, as EMITTED BASENAMES.
// Reachability is transitive through re-exported packages: a module in v1-stage0-std-surface
// can name a module in v1-stage0-std-core because that crate is glob re-exported, and the
// same holds one hop further. Membership alone is not reachability, which is candidate (3).
fn reachable_basenames_for_package(package: String, fuel: Int) -> List<String> {
  reachable_basenames_in(rows: generated_partition_crate_rows, package: package, fuel: fuel)
}

fn reachable_basenames_in(rows: List<gunbc.stage0_crate_partition_generated.GeneratedPartitionCrateRow>, package: String, fuel: Int) -> List<String> {
  if fuel <= 0 {
    []
  } else {
    rows
      |> fold(init: [], f: fn(acc, row) {
        if row.package_name == package {
          concat(concat(acc, row.modules), reachable_basenames_via_reexports(rows: rows, row: row, fuel: fuel))
        } else {
          acc
        }
      })
  }
}

fn reachable_basenames_via_reexports(
  rows: List<gunbc.stage0_crate_partition_generated.GeneratedPartitionCrateRow>,
  row: gunbc.stage0_crate_partition_generated.GeneratedPartitionCrateRow,
  fuel: Int
) -> List<String> {
  row.reexport_packages
    |> fold(init: [], f: fn(acc, p) {
      concat(acc, reachable_basenames_in(rows: rows, package: p, fuel: fuel - 1))
    })
}

// The emitted-module universe. A reference whose target is NOT an emitted stage0 module is
// out of scope here: it is either a type name or a module outside the partitioned set, and
// refusing on it would be the roster-completeness error (candidate 1) in another costume.
fn emitted_basenames() -> List<String> {
  emitted_basenames_in(rows: generated_partition_crate_rows)
}

fn emitted_basenames_in(rows: List<gunbc.stage0_crate_partition_generated.GeneratedPartitionCrateRow>) -> List<String> {
  rows
    |> fold(init: [], f: fn(acc, row) { concat(acc, row.modules) })
}

fn list_contains_string(xs: List<String>, needle: String) -> Bool {
  xs |> fold(init: false, f: fn(found, x) { if found { true } else { x == needle } })
}

// WHICH AUTHORITY IS INCOMPLETE. A module addition touches TWO hand-authored lists in
// v2.workflow.rust_crate_partition - the per-crate roster AND the stage0_module_dag_edge rows -
// and a refusal naming only the first sends the author back around the loop for the second.
// Every defect therefore carries the authority that must be edited, and the verdict reports
// ALL of them in one run rather than stopping at the first.
type PartitionAuthorityId
  = PartitionCrateRoster
  | PartitionModuleEdgeList

type PartitionClosureDefect {
  importer_module: String
  importer_basename: String
  owning_package: String
  target_module: String
  target_basename: String
  incomplete_authority: PartitionAuthorityId
  remedy: std.types.NonEmptyStr
}

// THE DENOMINATOR, carried on BOTH arms. A verdict that says "holds" without stating what it
// covered is the defect this module was built to close.
type PartitionClosureExtent {
  crates_considered: Int
  modules_considered: Int
  edges_considered: Int
}

type PartitionClosureVerdict
  = PartitionClosureHolds { extent: PartitionClosureExtent }
  | PartitionClosureRefused {
      extent: PartitionClosureExtent
      defects: List<PartitionClosureDefect>
    }

data partition_closure_fragility_note: String = "Files that declare ZERO imports (measured: dag/std/syntax.dag, dag/std/coercion.dag, dag/std/http_path.dag) have their cross-module references discovered ONLY by the bare-reference scan, and v1_compiler.cli_run build_both_closure_edge_index skips that scan for any file declaring any import. So adding ONE ordinary import to such a file silently removes its bare-reference dependencies from the closure - measured 5 sources to 3, dropping std.types, std.algebra and std.error_primitives - and programs reaching those modules by bare reference then fail to resolve. The failure is loud and located, but it is action at a distance: you edit file A and file B refuses. Recorded here because the next author to add an import to one of those three files will not know. Dissolve-on: dependencies derive from accepted bindings rather than import declarations, at which point the predicate cannot gate anything."

// ---------------------------------------------------------------------------
// The live reading.
// ---------------------------------------------------------------------------

data partition_closure_pool_roots: List<String> = ["dag", "src/v2"]
data partition_closure_exclude_substrings: List<String> = []

fn dedup_strings(xs: List<String>) -> List<String> {
  let acc = xs
    |> fold(init: DedupAcc { seen: empty_map(), ordered: [] }, f: fn(a, x) {
      match v2.std.collection.map_get(a.seen, x) {
        Accepted { value: Present { value: _ }, diagnostics: _ } => a
        Accepted { value: Absent, diagnostics: _ } =>
          DedupAcc { seen: map_insert(a.seen, x, true), ordered: Cons { head: x, tail: a.ordered } }
        Rejected { diagnostics: _ } => a
      }
    })
  reverse(acc.ordered)
}

// Cons-and-reverse rather than snoc: snoc is list_append(xs, [item]) and therefore O(n) per
// call, which makes any accumulating fold quadratic. This module's own edge producer was
// OOM-killed for exactly that idiom (see dedup_import_resolution_facts_cost_note); the fix is
// not conditional on n being small here, per the bare-minimum-cost rule.
type DedupAcc {
  seen: Map<String, Bool>
  ordered: List<String>
}

// file path -> declaring module identity, from the same declaration authority the edge
// producer uses, so the join cannot disagree with the edges it is joining.
fn path_to_module_index_from(decls: List<v2.lens.module_graph.ModuleDeclarationFact>) -> Map<String, String> {
  decls |> fold(init: empty_map(), f: fn(m, fact) { map_insert(m, fact.path, fact.module) })
}

// emitted basename -> declaring module identity. The basename is PROJECTED through the
// emit-plan authority, never respelled here.
fn basename_to_module_index_from(decls: List<v2.lens.module_graph.ModuleDeclarationFact>) -> Map<String, String> {
  decls |> fold(init: empty_map(), f: fn(m, fact) {
      map_insert(m, stage0_module_emit_basename(module_path: fact.module), fact.module)
    })
}

fn lookup_string(m: Map<String, String>, key: String) -> Optional<String> {
  match v2.std.collection.map_get(m, key) {
    Accepted { value: v, diagnostics: _ } => v
    Rejected { diagnostics: _ } => Absent
  }
}

type ModuleTargetsAcc {
  index: Map<String, List<String>>
}

// declaring module -> the modules it references, keyed by module identity rather than by file
// path, because module identity is this gate's subject.
fn module_target_index_from(
  edges: List<v2.lens.module_graph.ModuleDependencyEdge>,
  paths: Map<String, String>
) -> Map<String, List<String>> {
  edges
    |> fold(init: empty_map(), f: fn(idx, edge) {
      match lookup_string(m: paths, key: edge.path) {
        Present { value: importer } =>
          match v2.std.collection.map_get(idx, importer) {
            Accepted { value: Present { value: existing }, diagnostics: _ } =>
              map_insert(idx, importer, Cons { head: edge.target_module, tail: existing })
            Accepted { value: Absent, diagnostics: _ } =>
              map_insert(idx, importer, Cons { head: edge.target_module, tail: [] })
            Rejected { diagnostics: _ } => idx
          }
        Absent => idx
      }
    })
}

fn targets_of_module(idx: Map<String, List<String>>, module: String) -> List<String> {
  match v2.std.collection.map_get(idx, module) {
    Accepted { value: Present { value: ts }, diagnostics: _ } => ts
    Accepted { value: Absent, diagnostics: _ } => []
    Rejected { diagnostics: _ } => []
  }
}

// WHICH HAND AUTHORITY IS INCOMPLETE. A target that no crate roster claims at all means the
// ROSTER is short a row - the iso_80000_3 incident exactly. A target that some crate does own,
// but which this crate cannot reach, means the reexport/edge authority is short a relation.
// The two are different edits in different lists, and telling the author only the first sends
// them back around the loop for the second.
fn authority_for_unreachable_target(rows: List<gunbc.stage0_crate_partition_generated.GeneratedPartitionCrateRow>, target_basename: String) -> PartitionAuthorityId {
  if list_contains_string(xs: emitted_basenames_in(rows: rows), needle: target_basename) {
    PartitionModuleEdgeList
  } else {
    PartitionCrateRoster
  }
}

fn remedy_for(authority: PartitionAuthorityId, target_basename: String) -> std.types.NonEmptyStr {
  match authority {
    PartitionCrateRoster =>
      "no partition crate owns this module: add it to a crate roster in v2.workflow.rust_crate_partition, then regenerate" as std.types.NonEmptyStr
    PartitionModuleEdgeList =>
      "a crate owns this module but the consuming crate cannot reach it: add the stage0_module_dag_edge row (or the reexport) in v2.workflow.rust_crate_partition, then regenerate" as std.types.NonEmptyStr
  }
}

data partition_closure_confirmation_note: String = "TWO IMPRECISE SOURCES, COMPOSED INTO AN EXACT ONE - and both directions of error were MEASURED, not assumed. The .dag import lists UNDER-approximate: dag/std/syntax.dag declares zero imports while referencing std_types, so a check reading them finds nothing unreachable and passes while the crate cannot resolve. The .dag binding graph OVER-approximates the EMITTED crate's needs: on clean main it proposed four unreachable targets, and all four are false - std_coercion -> std_string_type, std_http_path -> v2_std_algebra and std_http_path -> std_upsert_decision name modules the emitter produces no file for at all, and std_pareto -> std_logic is a .dag reference the emitter did not turn into a `use crate::` line. Neither source alone is the emitted crate's actual requirement. So the binding graph is used as a CANDIDATE GENERATOR, where over-approximation is harmless because every candidate is then CONFIRMED against the emitted artifact, which is exact for the question actually asked - will this partition crate compile. This is not an absorbing fallback: the candidate set is narrowed by an exact check rather than widened by a failure arm, and a confirmed defect is still a typed, located, counted refusal. Reading emitted Rust text is a realization-side observation, admitted because the structure is genuinely absent upstream - which .dag references become emitted use lines is the emitter's decision and is not recoverable from the .dag graph. DISSOLVE-ON: the emitter exposes its per-module emitted reference set as a fact, at which point the confirmation reads that fact and the text scan deletes."

// EXACT CONFIRMATION. A candidate is a defect only if the importer's own emitted file really
// names the target module, and the target really has an emitted file. A missing importer file
// cannot confirm anything, so it REFUSES to confirm rather than assuming the defect is real.
fn emitted_module_path(basename: String) -> String {
  concat("src/v1/stage0/src/", concat(basename, ".rs"))
}

// Existence comes from the emit-plan roster, never from attempting a read: filesystem_read
// RAISES on a missing path, so probing existence by reading would turn "the target is not an
// emitted module" - an ordinary and expected answer - into a crash.
fn module_is_emitted(basename: String) -> Bool {
  list_contains_string(xs: generated_stage0_files, needle: concat(basename, ".rs"))
}

// THE IMPORTER'S SOURCE IS READ ONCE PER IMPORTER, NOT ONCE PER TARGET, and that is a
// correctness-of-cost fix rather than a tuning knob (DESIGN section 6, bare minimum cost).
// The read depends only on the importer, while the confirmation question is asked for every
// target that importer references -- so the pairwise form re-read one emitted seed file, some
// of them megabytes, once per edge out of it. Measured before the hoist: the two live-corpus
// witnesses cost 173.6s and 180.5s of thread CPU. CI never reported those numbers, because the
// 5s fast-lane budget INTERRUPTS at 5040ms and an interrupt is a lower bound on cost, never the
// cost -- which is precisely why the defect could sit here looking like a witness slightly over
// budget instead of a fold re-reading the corpus thousands of times.
//
// THE HOIST DID NOT DELIVER THAT COST BACK, and this sentence exists because the first review of
// it read the paragraph above as a measured win. Measured AFTER: 177.6s, against the 173.6s
// baseline -- no improvement, inside run-to-run noise. It is kept because re-reading one file once
// per outbound edge is redundant work regardless of the realized n (DESIGN section 6 again: n is
// not a time-stable fact), NOT because it made the witness affordable. What made the mechanism
// witnesses affordable was moving them off the live verdict entirely.
//
// WHY THE HOIST MOVED NOTHING -- CORRECTED 2026-08-12, and the correction matters more than the
// hoist. This paragraph used to explain the null result by saying "the live fact producers
// dominate and are already memoized host-side". That was never measured and it is false. Measured
// per term, one process, live corpus: import_resolution_facts_live 146ms,
// reference_derived_import_resolution_facts_live 5ms, the interpreted union and dedup of the two
// 104,943ms, all of dependency_resolution_facts_live 112,261ms. The host leaves are 151ms of
// 112,261ms. What dominated was the INTERPRETED COMPOSITION over those leaves, so the hoist moved
// a real redundancy that was never the term, and the stated explanation pointed the next reader at
// the one part of the pipeline that was already cheap.
//
// That composition is now native (v2.lens.module_graph dependency_resolution_facts_live over the
// builtin, single dedup authority v1_compiler.cli_run union_dedup_import_facts_reference_first),
// and this census measures 68,224ms against its unchanged 180,000ms long-lane ceiling, from
// 180,600ms failing. The identity and order law is unchanged and proven by live-corpus row-for-row
// parity against the interpreted spelling before it was deleted.
//
// Reading absent content as the empty string is not a fallback: a module with no emitted file
// cannot confirm a reference, and the empty string confirms nothing, so the arm returns exactly
// what the pairwise guard returned. The guard on the TARGET stays at the call site below.
fn emitted_importer_source(importer_basename: String) -> String {
  if module_is_emitted(basename: importer_basename) {
    filesystem_read(path: emitted_module_path(basename: importer_basename)).content
  } else {
    ""
  }
}

fn emitted_reference_confirms_in(importer_source: String, target_basename: String) -> Bool {
  if !module_is_emitted(basename: target_basename) {
    false
  } else {
    string_contains(s: importer_source, pattern: concat("use crate::", target_basename))
  }
}

fn defects_for_crate(
  rows: List<gunbc.stage0_crate_partition_generated.GeneratedPartitionCrateRow>,
  row: gunbc.stage0_crate_partition_generated.GeneratedPartitionCrateRow,
  targets: Map<String, List<String>>,
  basenames: Map<String, String>
) -> List<PartitionClosureDefect> {
  let reachable = reachable_basenames_in(rows: rows, package: row.package_name, fuel: 8)
  row.modules
    |> fold(init: [], f: fn(acc, own_basename) {
      match lookup_string(m: basenames, key: own_basename) {
        Absent => acc
        Present { value: importer_module } => {
          let importer_source = emitted_importer_source(importer_basename: own_basename)
          concat(acc, targets_of_module(idx: targets, module: importer_module)
            |> fold(init: [], f: fn(inner, target_module) {
              let tb = stage0_module_emit_basename(module_path: target_module)
              if list_contains_string(xs: reachable, needle: tb)
                || !emitted_reference_confirms_in(importer_source: importer_source, target_basename: tb) {
                inner
              } else {
                let authority = authority_for_unreachable_target(rows: rows, target_basename: tb)
                concat(inner, [PartitionClosureDefect {
                  importer_module: importer_module,
                  importer_basename: own_basename,
                  owning_package: row.package_name,
                  target_module: target_module,
                  target_basename: tb,
                  incomplete_authority: authority,
                  remedy: remedy_for(authority: authority, target_basename: tb),
                }])
              }
            }))
        }
      }
    })
}

fn partition_closure_verdict() -> PartitionClosureVerdict {
  partition_closure_verdict_for_rows(rows: generated_partition_crate_rows)
}

// The LIVE entry point: derives each fact population once and hands them to the pure core.
//
// CORRECTED 2026-08-11. This comment previously said the parameterised form existed so a
// witness could reproduce the incident shape against LIVE tree facts rather than over invented
// edges. That was the intent and it is no longer what happens: the live derivation costs about
// 175 seconds of thread CPU, so the three REDs that called it could never execute inside the 5s
// fast-lane budget, and they never once did - #8111 merged on a cancelled check. They now run
// on a fixture over partition_closure_verdict_over, keeping REAL emitted modules as importer
// and targets so the confirmation step still reads a real file. The live tie is
// w_live_corpus_partition_closure_holds alone. Leaving the old sentence would be a note
// describing a property the tree stopped having.
fn partition_closure_verdict_for_rows(rows: List<gunbc.stage0_crate_partition_generated.GeneratedPartitionCrateRow>) -> PartitionClosureVerdict {
  let decls = v2.lens.module_graph.module_declaration_facts_live(pool_roots: partition_closure_pool_roots)
  let edges = v2.lens.module_graph.dependency_resolution_facts_live(
    pool_roots: partition_closure_pool_roots,
    importer_roots: partition_closure_pool_roots,
    exclude_substrings: partition_closure_exclude_substrings
  )
  partition_closure_verdict_over(
    rows: rows,
    targets: module_target_index_from(edges: edges, paths: path_to_module_index_from(decls: decls)),
    basenames: basename_to_module_index_from(decls: decls),
    edges_considered: edges |> fold(init: 0, f: fn(a, e) { a + 1 })
  )
}

// THE PURE CORE. Every live read is the caller's, so the mechanism -- which crate may reference
// which module, which hand authority is short a row, and what the verdict's extent says -- is
// decidable over supplied facts. That is what lets the mechanism witnesses run as fixtures
// costing nothing instead of re-deriving the corpus once per assertion, per the 2026-08-04
// witness-cost ruling: small discriminating mechanism fixtures, plus the irreducible live
// census kept as its own row.
fn partition_closure_verdict_over(
  rows: List<gunbc.stage0_crate_partition_generated.GeneratedPartitionCrateRow>,
  targets: Map<String, List<String>>,
  basenames: Map<String, String>,
  edges_considered: Int
) -> PartitionClosureVerdict {
  let defects = rows
    |> fold(init: [], f: fn(acc, row) {
      concat(acc, defects_for_crate(rows: rows, row: row, targets: targets, basenames: basenames))
    })
  let extent = PartitionClosureExtent {
    crates_considered: rows |> fold(init: 0, f: fn(a, r) { a + 1 }),
    modules_considered: dedup_strings(xs: emitted_basenames_in(rows: rows)) |> fold(init: 0, f: fn(a, m) { a + 1 }),
    edges_considered: edges_considered,
  }
  if (defects |> fold(init: 0, f: fn(a, d) { a + 1 })) == 0 {
    PartitionClosureHolds { extent: extent }
  } else {
    PartitionClosureRefused { extent: extent, defects: defects }
  }
}
