module gunbc.commit_workflow

import gunbc.ci_gate {
  Gate,
  RustMonolithGate, EmitHostGate, LayeringImportsGate,
  ExtdepsExternalAuthorityGate, DagCompileCleanGate, GeneratedArtifactDriftGate,
  SourceRootIngestGate, RegenVerifyGate,
  SelfHostReadsRealBytesGate, SelfHostStalenessGate, EmitDeterminismGate
}
import gunbc.generated_artifact {
  GeneratedArtifact, CiYamlArtifact, GithooksPrePushArtifact, artifact_path
}
import std.realization_schedule {
  string_list_eq, ScheduleWitnessEntry,
  WitnessKind, CorpusWitnessKind, ExecutionWitnessKind, witness_kind_eq,
  WitnessSeam, WitnessSpan, SpanUndeclared, SpanSeams
}

data doc_reachability_witness_entry: String = "dag/test/claim/doc_reachability_witness_test.dag"

type LocalTidyCheck
  = LocalTidyWitnessCheck { entry: String, check_fns: List<String> }
  | LocalTidyGateCheck { gate: GeneratedArtifactDriftGate }
  | LocalTidyCargoFmtCheck

type CommitWorkflowSurface
  = GithubActionsCiJob
  | GithubActionsCiRegenJob
  | GithubActionsRustTestsJob
  | GitPrePushHook

type CommitCheckKind
  = CommitSpecGate { gate: Gate }
  | CommitWitnessClaim { entry: String, check_fns: List<String>, kind: WitnessKind, span: WitnessSpan }
  | CommitCargoFmtCheck

type CommitCheckEnrollment {
  check: CommitCheckKind
  surfaces: List<CommitWorkflowSurface>
}

type CommitWorkflowRealizationKind
  = CiYamlHandler
  | GitPrePushScriptHandler

type CommitWorkflowRealizationBinding {
  surface: CommitWorkflowSurface
  handler: CommitWorkflowRealizationKind
  artifact: GeneratedArtifact
}

data lever_a_emit_witness_enrollment_dissolution_note: String = "Lever A (#6361): removed CommitWitnessClaim row for dag_compile_clean_clean_tree_emit_execution_holds — that witness called witness_layer_roots_compile_clean_emit_check(), a second whole-tree --target dag compile over the same witness_layer_roots pool. Batch-1 dag_compile_clean_gate now consumes the executor's ONE install_floor_compile_clean_receipt (identical roots, identical emit leg); re-enrolling the witness would only re-pay the same compile in batch-2. Serialize-shape + perturb receipts stay enrolled separately."

