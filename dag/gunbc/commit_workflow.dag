module gunbc.commit_workflow


data doc_reachability_witness_entry: String = "dag/test/claim/doc_reachability_witness_test.dag"

type CommitWriter
  = HumanGitCommit
  | DashboardAutocommit
  | HealAutocommit
  | IntegrationCommit

type CommitWriterArtifactClassificationReceipt sole_constructor {
  path: extdeps.git.object_store.GitPath
  indexed_oid: extdeps.git.object_store.GitObjectId
  artifact: v2.std.artifact.Artifact
}

type CommitWriterArtifactClassificationFailure
  = CommitWriterArtifactNotTracked { artifact: v2.std.artifact.Artifact }
  | CommitWriterArtifactPathDoesNotMatch {
      artifact: v2.std.artifact.Artifact,
      provenance_file_path: String,
    }

type CommitWriterObservedBlobClassification
  = CommitWriterBlobTextDecoded {
      text: String,
      marker_grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
      artifact: CommitWriterArtifactClassificationReceipt,
    }
  | CommitWriterBlobNonTextClassified {
      artifact: CommitWriterArtifactClassificationReceipt,
    }
  | CommitWriterBlobTextUnclaimed {
      text: String,
      marker_grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
    }
  | CommitWriterBlobNonTextUnclaimed
  | CommitWriterBlobArtifactClassificationRefused {
      cause: CommitWriterArtifactClassificationFailure,
    }
  | CommitWriterBlobClassificationUnavailable {
      cause: String,
    }

type CommitWriterBlobClassificationReceipt sole_constructor {
  observed: CommitWriterObservedBlobClassification
}

type CommitWriterStagedBlobObservation {
  path: extdeps.git.object_store.GitPath
  indexed_oid: extdeps.git.object_store.GitObjectId
  content_oid: extdeps.git.object_store.GitObjectId
  classification: CommitWriterBlobClassificationReceipt
}

type CompleteStagedCommitObservation {
  index: List<extdeps.git.object_store.GitIndexEntry>
  blobs: List<CommitWriterStagedBlobObservation>
  module_storage: List<v2.compiler.source_authority.ModuleStorageBinding>
}

type ExactIndexBlobCoverageReceipt sole_constructor {
  normal_index_entry_count: Int
  staged_blob_observation_count: Int
}

type ConflictMarkerLocation {
  path: extdeps.git.object_store.GitPath
  begin_line: Int
  separator_line: Int
  end_line: Int
}

type ConflictMarkerParseState
  = ConflictMarkerOutside
  | ConflictMarkerBegun { begin_line: Int }
  | ConflictMarkerSeparated { begin_line: Int, separator_line: Int }

type ConflictMarkerParseFold {
  state: ConflictMarkerParseState
  locations: List<ConflictMarkerLocation>
}

type CommitWriterRefusal
  = CommitWriterUnmergedIndexRefusal {
      path: extdeps.git.object_store.GitPath,
      stages: List<extdeps.git.object_store.GitIndexStage>
    }
  | CommitWriterMissingBlobObservationRefusal { path: extdeps.git.object_store.GitPath, indexed_oid: extdeps.git.object_store.GitObjectId }
  | CommitWriterExtraBlobObservationRefusal { path: extdeps.git.object_store.GitPath, indexed_oid: extdeps.git.object_store.GitObjectId }
  | CommitWriterDuplicateBlobObservationRefusal { path: extdeps.git.object_store.GitPath, count: Int }
  | CommitWriterDuplicateNormalIndexEntryRefusal { path: extdeps.git.object_store.GitPath, count: Int }
  | CommitWriterIndexBlobIdentityMismatchRefusal {
      path: extdeps.git.object_store.GitPath,
      index_oid: extdeps.git.object_store.GitObjectId,
      observed_index_oid: extdeps.git.object_store.GitObjectId,
    }
  | CommitWriterBlobContentMismatchRefusal {
      path: extdeps.git.object_store.GitPath,
      indexed_oid: extdeps.git.object_store.GitObjectId,
      content_oid: extdeps.git.object_store.GitObjectId,
    }
  | CommitWriterBlobClassificationUnavailableRefusal {
      path: extdeps.git.object_store.GitPath,
      cause: String,
    }
  | CommitWriterArtifactPathMismatchRefusal {
      path: extdeps.git.object_store.GitPath,
      provenance_file_path: String,
    }
  | CommitWriterArtifactObjectMismatchRefusal {
      path: extdeps.git.object_store.GitPath,
      blob_indexed_oid: extdeps.git.object_store.GitObjectId,
      provenance_indexed_oid: extdeps.git.object_store.GitObjectId,
    }
  | CommitWriterArtifactUntrackedRefusal { path: extdeps.git.object_store.GitPath, artifact: v2.std.artifact.Artifact }
  | CommitWriterConflictMarkerTextRefusal {
      location: ConflictMarkerLocation
    }

type CommitWriterAdmission
  = CommitWriterAdmitted {
      writer: CommitWriter,
      coverage: ExactIndexBlobCoverageReceipt,
    }
  | CommitWriterRefused {
      writer: CommitWriter,
      refusals: List<CommitWriterRefusal>
    }

data commit_writer_admission_note: String = "ONE ADMISSION AUTHORITY FOR EVERY COMMIT WRITER. admit_commit_writer consumes one staged-index snapshot plus its blob-observation population, not a caller-selected path list. It refuses every non-normal extdeps.git.object_store.GitIndexStage and independently refuses missing, extra, or duplicate blob observations; duplicate normal entries; index/blob identity disagreement; observed-content disagreement; and unavailable decode or classification. Text/non-text is carried only by the sole-constructor observer receipt. The marker grammar stores Git gitattributes conflict-marker-size once as PositiveInt and derives begin, separator, and end tokens, then parses complete begin -> separator -> end line blocks in the exact staged text; isolated and out-of-order tokens admit. Fixture exemption is not a naked v2.std.artifact.Artifact argument: commit_writer_classify_artifact projects a sole-constructor receipt from v2.compiler.source_authority v2.compiler.source_authority.ModuleStorageBinding rows and binds it to the same extdeps.git.object_store.GitPath and indexed extdeps.git.object_store.GitObjectId. A source-path v2.std.artifact.TestClaimArtifact, mismatched path, fabricated matching artifact, or receipt moved to another blob refuses. ABSENCE IS NOT INABILITY: CommitWriterArtifactClassificationReceipt stays sole_constructor with its one construction site in commit_writer_classify_artifact — no second way to earn a receipt exists. A blob that claims no exemption does not need one; the observer classifies it CommitWriterBlobTextUnclaimed or CommitWriterBlobNonTextUnclaimed instead of routing an absent claim through classification failure, and an unclaimed text blob still receives the full conflict-marker scan via commit_writer_text_marker_refusals. Only a claimed v2.std.artifact.TestClaimArtifact receipt skips the scan, so omitting the receipt costs a forger the exemption and buys nothing. The observer is trusted on text-versus-non-text with no independent check today, for both claimed and unclaimed blobs alike; that residue is unchanged by the absence arm and is not fixed here. DESIGN section 4b names sole_constructor completeness as the structural-unforgeability ceiling; before the absence arm, admit_commit_writer refused every real heal-shaped commit because every non-.dag staged path had no v2.compiler.source_authority.ParsedFromSource binding to classify against, so it had never executed against a live population despite this note's earlier claim to have reached mechanical prevention. The generated pre-commit hook remains optional feedback, never enforcement. COMMIT 218dea61248d RECEIPT: its WIP-prefixed merge subject identifies DashboardAutocommit as the proven missing writer despite the reused gunbc-ci-auto-heal committer identity. HealAutocommit already refuses authored conflicts in ci_heal_skew_authored_conflict_refusal, but ci_heal_skew_conflict_arm writes through shape_git_commit_no_verify_no_edit_argv, so it bypasses even hook feedback and currently commits ours bytes before later regeneration. COUNTABLE MODEL/REALIZATION SPLIT: commit_writer_binding_work owns two typed rows, the in-repo ci_heal_skew_conflict_arm under CommitWriterHealOrchestrationLaneOwner and the out-of-repository dashboard daemon under CommitWriterDashboardInfrastructureOperatorOwner. Each row triggers when its complete staged-index/blob observer transport lands; that transport must observe the effective marker size and v2.compiler.source_authority.ModuleStorageBinding authority, then call admit_commit_writer immediately before its write. The heal realization must additionally move regeneration and byte-proof before commit. Until those owned bindings land, this PR closes the shared decision and executable incident witness, not the writer transports."

type CommitWriterArtifactClassificationResolution
  = CommitWriterArtifactClassified {
      receipt: CommitWriterArtifactClassificationReceipt,
    }
  | CommitWriterArtifactClassificationRefused {
      cause: CommitWriterArtifactClassificationFailure,
    }

fn commit_writer_classify_artifact(
  module_storage: List<v2.compiler.source_authority.ModuleStorageBinding>,
  path: extdeps.git.object_store.GitPath,
  indexed_oid: extdeps.git.object_store.GitObjectId,
  artifact: v2.std.artifact.Artifact,
) -> CommitWriterArtifactClassificationResolution {
  if std.bytes.bytes_octets(b: std.bytes.utf8_encode_bytes(s: artifact.file_path)) != extdeps.git.object_store.git_path_octets(path: path) {
    CommitWriterArtifactClassificationRefused {
      cause: CommitWriterArtifactPathDoesNotMatch {
        artifact: artifact,
        provenance_file_path: artifact.file_path,
      }
    }
  } else if count(flat_map(
    module_storage,
    binding => match binding.provenance {
      v2.compiler.source_authority.ParsedFromSource { artifact: tracked, span_index: _ } =>
        if tracked == artifact { [tracked] } else { [] }
      v2.compiler.source_authority.ProducedByBehavior { producer: _ } => []
    },
  )) > 0 {
    CommitWriterArtifactClassified {
      receipt: CommitWriterArtifactClassificationReceipt {
        path: path,
        indexed_oid: indexed_oid,
        artifact: artifact,
      }
    }
  } else {
    CommitWriterArtifactClassificationRefused {
      cause: CommitWriterArtifactNotTracked { artifact: artifact }
    }
  }
}

fn commit_writer_text_classification_receipt(
  text: String,
  marker_grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
  artifact: CommitWriterArtifactClassificationReceipt,
) -> CommitWriterBlobClassificationReceipt {
  CommitWriterBlobClassificationReceipt {
    observed: CommitWriterBlobTextDecoded {
      text: text,
      marker_grammar: marker_grammar,
      artifact: artifact,
    }
  }
}

fn commit_writer_non_text_classification_receipt(
  artifact: CommitWriterArtifactClassificationReceipt,
) -> CommitWriterBlobClassificationReceipt {
  CommitWriterBlobClassificationReceipt {
    observed: CommitWriterBlobNonTextClassified { artifact: artifact }
  }
}

fn commit_writer_unavailable_classification_receipt(
  cause: String,
) -> CommitWriterBlobClassificationReceipt {
  CommitWriterBlobClassificationReceipt {
    observed: CommitWriterBlobClassificationUnavailable { cause: cause }
  }
}

fn commit_writer_refused_artifact_classification_receipt(
  cause: CommitWriterArtifactClassificationFailure,
) -> CommitWriterBlobClassificationReceipt {
  CommitWriterBlobClassificationReceipt {
    observed: CommitWriterBlobArtifactClassificationRefused { cause: cause }
  }
}

fn commit_writer_text_unclaimed_classification_receipt(
  text: String,
  marker_grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
) -> CommitWriterBlobClassificationReceipt {
  CommitWriterBlobClassificationReceipt {
    observed: CommitWriterBlobTextUnclaimed { text: text, marker_grammar: marker_grammar }
  }
}

fn commit_writer_non_text_unclaimed_classification_receipt() -> CommitWriterBlobClassificationReceipt {
  CommitWriterBlobClassificationReceipt {
    observed: CommitWriterBlobNonTextUnclaimed
  }
}

type CommitWriterBindingSite
  = CommitWriterHealSkewConflictArm
  | CommitWriterDashboardAutocommitDaemon

type CommitWriterBindingOwner
  = CommitWriterHealOrchestrationLaneOwner
  | CommitWriterDashboardInfrastructureOperatorOwner

type CommitWriterBindingDependency {
  capability: v2.std.node.Symbol
}

data commit_writer_complete_staged_index_blob_observation_transport: CommitWriterBindingDependency = CommitWriterBindingDependency {
  capability: ^complete_staged_index_blob_observation_transport,
}

type CommitWriterBindingTrigger
  = CommitWriterBindAfterDependencyLands {
      dependency: CommitWriterBindingDependency,
    }

type CommitWriterBindingWork {
  site: CommitWriterBindingSite
  writer: CommitWriter
  owner: CommitWriterBindingOwner
  trigger: CommitWriterBindingTrigger
}

data commit_writer_binding_work: List<CommitWriterBindingWork> = [
  CommitWriterBindingWork {
    site: CommitWriterHealSkewConflictArm,
    writer: HealAutocommit,
    owner: CommitWriterHealOrchestrationLaneOwner,
    trigger: CommitWriterBindAfterDependencyLands {
      dependency: commit_writer_complete_staged_index_blob_observation_transport,
    },
  },
  CommitWriterBindingWork {
    site: CommitWriterDashboardAutocommitDaemon,
    writer: DashboardAutocommit,
    owner: CommitWriterDashboardInfrastructureOperatorOwner,
    trigger: CommitWriterBindAfterDependencyLands {
      dependency: commit_writer_complete_staged_index_blob_observation_transport,
    },
  },
]

fn conflict_marker_line_has_prefix(line: String, marker: String) -> Bool {
  (line == marker) || starts_with(s: line, prefix: concat(marker, " "))
}

fn conflict_marker_parse_line(
  fold_state: ConflictMarkerParseFold,
  path: extdeps.git.object_store.GitPath,
  line: String,
  line_number: Int,
  grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
) -> ConflictMarkerParseFold {
  if conflict_marker_line_has_prefix(line: line, marker: extdeps.git.object_store.git_conflict_marker_begin(grammar: grammar)) {
    ConflictMarkerParseFold {
      state: ConflictMarkerBegun { begin_line: line_number }
      locations: fold_state.locations
    }
  } else {
    match fold_state.state {
      ConflictMarkerOutside => ConflictMarkerParseFold {
        state: ConflictMarkerOutside
        locations: fold_state.locations
      }
      ConflictMarkerBegun { begin_line } =>
        if line == extdeps.git.object_store.git_conflict_marker_separator(grammar: grammar) {
          ConflictMarkerParseFold {
            state: ConflictMarkerSeparated {
              begin_line: begin_line,
              separator_line: line_number,
            }
            locations: fold_state.locations
          }
        } else {
          ConflictMarkerParseFold {
            state: fold_state.state
            locations: fold_state.locations
          }
        }
      ConflictMarkerSeparated { begin_line, separator_line } =>
        if conflict_marker_line_has_prefix(line: line, marker: extdeps.git.object_store.git_conflict_marker_end(grammar: grammar)) {
          ConflictMarkerParseFold {
            state: ConflictMarkerOutside
            locations: append(
              fold_state.locations,
              items: [
                ConflictMarkerLocation {
                  path: path,
                  begin_line: begin_line,
                  separator_line: separator_line,
                  end_line: line_number,
                },
              ],
            )
          }
        } else {
          ConflictMarkerParseFold {
            state: fold_state.state
            locations: fold_state.locations
          }
        }
    }
  }
}

fn conflict_marker_locations_from_lines_at(
  lines: List<String>,
  index: Int,
  path: extdeps.git.object_store.GitPath,
  grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
  parsed: ConflictMarkerParseFold,
) -> List<ConflictMarkerLocation> {
  if index >= count(lines) {
    parsed.locations
  } else {
    conflict_marker_locations_from_lines_at(
      lines: lines,
      index: index + 1,
      path: path,
      grammar: grammar,
      parsed: conflict_marker_parse_line(
        fold_state: parsed,
        path: path,
        line: lines.skip(n: index).first(),
        line_number: index + 1,
        grammar: grammar,
      ),
    )
  }
}

fn conflict_marker_locations_from_lines(
  lines: List<String>,
  path: extdeps.git.object_store.GitPath,
  grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
) -> List<ConflictMarkerLocation> {
  conflict_marker_locations_from_lines_at(
    lines: lines,
    index: 0,
    path: path,
    grammar: grammar,
    parsed: ConflictMarkerParseFold {
      state: ConflictMarkerOutside,
      locations: [],
    },
  )
}

fn commit_writer_text_marker_refusals(
  path: extdeps.git.object_store.GitPath,
  text: String,
  grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
) -> List<CommitWriterRefusal> {
  map(
    conflict_marker_locations_from_lines(
      lines: split(s: text, delimiter: "\n"),
      path: path,
      grammar: grammar,
    ),
    location => CommitWriterConflictMarkerTextRefusal {
      location: location
    },
  )
}

data commit_writer_index_filter_capture_scaffold: String = "DECLARED SCAFFOLD (gunbc#7480, 2026-08-02). The body below selects entries with flat_map rather than the obvious filter(index, entry => entry.path == path), and that spelling is NOT a preference -- the filter form does not compile in this module. ROOT CAUSE, bisected and reproduced: src/v2/std/algebra.dag declares fn filter<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool). This module does not import v2.std.algebra, but it imports v2.compiler.source_authority, which drags the whole v2 compiler closure -- including v2.std.algebra -- into the module pool. The bare name filter then binds to THAT declaration instead of the builtin, List<extdeps.git.object_store.GitIndexEntry> does not unify with FreeMonoid<T>, the lambda parameter stays an unbound T, and the module fails with `no field path on type T`. THE DISCRIMINATING MEASUREMENT: importing v2.std.algebra for `length` ALONE -- never filter -- is sufficient to break it, and deleting only the source_authority import makes the original filter form compile. So this is name capture by POOL MEMBERSHIP, not by the import list, which is exactly the DESIGN #6985 Class B failure mode in its inverting direction: an unrelated import pulls a module into the pool whose declaration captures a bare name that was resolving correctly. It is silent -- nothing reports that filter rebound. Hypotheses REFUTED by execution first, recorded so nobody repeats them: a trailing comma in the parameter list; filter over an imported record type; List not being imported; two filter calls over different element types in one module; a lambda or parameter name colliding with an imported symbol; cross-call-site unification collapsing the element type. The sibling function below uses flat_map over the same type with the same `entry` binding and compiles, which is what makes flat_map a safe carrier here. The source_authority import CANNOT simply be dropped: v2.compiler.source_authority.ModuleStorageBinding, v2.compiler.source_authority.ParsedFromSource and v2.compiler.source_authority.ProducedByBehavior are all genuinely used by this module. DISSOLVE-ON: the namespace-only name-resolution lane makes the containment tree the single naming authority, so a module not in the import list can no longer capture a bare reference; at that point restore the filter spelling and delete this row. This scaffold changes NO behaviour -- it selects exactly the entries whose path matches, as filter did."

fn commit_writer_index_entries_for_path(
  index: List<extdeps.git.object_store.GitIndexEntry>,
  path: extdeps.git.object_store.GitPath,
) -> List<extdeps.git.object_store.GitIndexEntry> {
  flat_map(index, entry => if entry.path == path { [entry] } else { [] })
}

fn commit_writer_normal_index_entries_for_path(
  index: List<extdeps.git.object_store.GitIndexEntry>,
  path: extdeps.git.object_store.GitPath,
) -> List<extdeps.git.object_store.GitIndexEntry> {
  flat_map(
    commit_writer_index_entries_for_path(index: index, path: path),
    entry => match entry.stage {
      extdeps.git.object_store.GitIndexStageNormal => [entry]
      extdeps.git.object_store.GitIndexStageBase => []
      extdeps.git.object_store.GitIndexStageOurs => []
      extdeps.git.object_store.GitIndexStageTheirs => []
    },
  )
}

fn commit_writer_index_stages_for_path(
  index: List<extdeps.git.object_store.GitIndexEntry>,
  path: extdeps.git.object_store.GitPath,
) -> List<extdeps.git.object_store.GitIndexStage> {
  map(commit_writer_index_entries_for_path(index: index, path: path), entry => entry.stage)
}

fn commit_writer_prior_unmerged_stage_count(
  index: List<extdeps.git.object_store.GitIndexEntry>,
  path: extdeps.git.object_store.GitPath,
  before: Int,
) -> Int {
  count(flat_map(
    index.take(n: before),
    entry => if entry.path == path {
      match entry.stage {
        extdeps.git.object_store.GitIndexStageNormal => []
        extdeps.git.object_store.GitIndexStageBase => [entry]
        extdeps.git.object_store.GitIndexStageOurs => [entry]
        extdeps.git.object_store.GitIndexStageTheirs => [entry]
      }
    } else {
      []
    },
  ))
}

fn commit_writer_unmerged_index_refusals_at(
  index: List<extdeps.git.object_store.GitIndexEntry>,
  at: Int,
) -> List<CommitWriterRefusal> {
  if at >= count(index) {
    []
  } else {
    match first(index.skip(n: at)) {
      Absent => []
      Present { value: entry } => {
        let tail = commit_writer_unmerged_index_refusals_at(index: index, at: at + 1)
        match entry.stage {
      extdeps.git.object_store.GitIndexStageNormal => tail
      extdeps.git.object_store.GitIndexStageBase =>
        if commit_writer_prior_unmerged_stage_count(index: index, path: entry.path, before: at) > 0 {
          tail
        } else {
          append(
            [CommitWriterUnmergedIndexRefusal {
              path: entry.path,
              stages: commit_writer_index_stages_for_path(index: index, path: entry.path),
            }],
            items: tail,
          )
        }
      extdeps.git.object_store.GitIndexStageOurs =>
        if commit_writer_prior_unmerged_stage_count(index: index, path: entry.path, before: at) > 0 {
          tail
        } else {
          append(
            [CommitWriterUnmergedIndexRefusal {
              path: entry.path,
              stages: commit_writer_index_stages_for_path(index: index, path: entry.path),
            }],
            items: tail,
          )
        }
      extdeps.git.object_store.GitIndexStageTheirs =>
        if commit_writer_prior_unmerged_stage_count(index: index, path: entry.path, before: at) > 0 {
          tail
        } else {
          append(
            [CommitWriterUnmergedIndexRefusal {
              path: entry.path,
              stages: commit_writer_index_stages_for_path(index: index, path: entry.path),
            }],
            items: tail,
          )
        }
        }
      }
    }
  }
}

fn commit_writer_prior_normal_stage_count(
  index: List<extdeps.git.object_store.GitIndexEntry>,
  path: extdeps.git.object_store.GitPath,
  before: Int,
) -> Int {
  count(flat_map(
    index.take(n: before),
    entry => if entry.path == path {
      match entry.stage {
        extdeps.git.object_store.GitIndexStageNormal => [entry]
        extdeps.git.object_store.GitIndexStageBase => []
        extdeps.git.object_store.GitIndexStageOurs => []
        extdeps.git.object_store.GitIndexStageTheirs => []
      }
    } else {
      []
    },
  ))
}

fn commit_writer_duplicate_normal_index_refusals_at(
  index: List<extdeps.git.object_store.GitIndexEntry>,
  at: Int,
) -> List<CommitWriterRefusal> {
  if at >= count(index) {
    []
  } else {
    match first(index.skip(n: at)) {
      Absent => []
      Present { value: entry } => {
        let tail = commit_writer_duplicate_normal_index_refusals_at(index: index, at: at + 1)
        match entry.stage {
      extdeps.git.object_store.GitIndexStageNormal =>
        if commit_writer_prior_normal_stage_count(
          index: index,
          path: entry.path,
          before: at,
        ) > 0 {
          tail
        } else {
          let population = commit_writer_normal_index_entries_for_path(
            index: index,
            path: entry.path,
          )
          if count(population) > 1 {
            append(
              [CommitWriterDuplicateNormalIndexEntryRefusal {
                path: entry.path,
                count: count(population),
              }],
              items: tail,
            )
          } else {
            tail
          }
        }
      extdeps.git.object_store.GitIndexStageBase => tail
      extdeps.git.object_store.GitIndexStageOurs => tail
      extdeps.git.object_store.GitIndexStageTheirs => tail
        }
      }
    }
  }
}

fn commit_writer_blobs_for_path(
  blobs: List<CommitWriterStagedBlobObservation>,
  path: extdeps.git.object_store.GitPath,
) -> List<CommitWriterStagedBlobObservation> {
  flat_map(blobs, blob => if blob.path == path { [blob] } else { [] })
}

fn commit_writer_prior_blob_count(
  blobs: List<CommitWriterStagedBlobObservation>,
  path: extdeps.git.object_store.GitPath,
  before: Int,
) -> Int {
  count(flat_map(
    blobs.take(n: before),
    blob => if blob.path == path { [blob] } else { [] },
  ))
}

fn commit_writer_duplicate_blob_refusals_at(
  blobs: List<CommitWriterStagedBlobObservation>,
  at: Int,
) -> List<CommitWriterRefusal> {
  if at >= count(blobs) {
    []
  } else {
    match first(blobs.skip(n: at)) {
      Absent => []
      Present { value: blob } => {
        let tail = commit_writer_duplicate_blob_refusals_at(blobs: blobs, at: at + 1)
        if commit_writer_prior_blob_count(
          blobs: blobs,
          path: blob.path,
          before: at,
        ) > 0 {
          tail
        } else {
          let population = commit_writer_blobs_for_path(blobs: blobs, path: blob.path)
          if count(population) > 1 {
            append(
              [CommitWriterDuplicateBlobObservationRefusal {
                path: blob.path,
                count: count(population),
              }],
              items: tail,
            )
          } else {
            tail
          }
        }
      }
    }
  }
}

fn commit_writer_artifact_refusals(
  blob: CommitWriterStagedBlobObservation,
  receipt: CommitWriterArtifactClassificationReceipt,
  module_storage: List<v2.compiler.source_authority.ModuleStorageBinding>,
) -> List<CommitWriterRefusal> {
  append(
    if receipt.path == blob.path {
      []
    } else {
      [CommitWriterArtifactPathMismatchRefusal {
        path: blob.path,
        provenance_file_path: receipt.artifact.file_path,
      }]
    },
    items: append(
      if extdeps.git.object_store.git_object_id_eq(left: receipt.indexed_oid, right: blob.indexed_oid) {
        []
      } else {
        [CommitWriterArtifactObjectMismatchRefusal {
          path: blob.path,
          blob_indexed_oid: blob.indexed_oid,
          provenance_indexed_oid: receipt.indexed_oid,
        }]
      },
      items: if count(flat_map(
        module_storage,
        binding => match binding.provenance {
          v2.compiler.source_authority.ParsedFromSource { artifact: tracked, span_index: _ } =>
            if tracked == receipt.artifact { [tracked] } else { [] }
          v2.compiler.source_authority.ProducedByBehavior { producer: _ } => []
        },
      )) > 0 {
        []
      } else {
        [CommitWriterArtifactUntrackedRefusal {
          path: blob.path,
          artifact: receipt.artifact,
        }]
      },
    ),
  )
}

fn commit_writer_blob_classification_refusals(
  blob: CommitWriterStagedBlobObservation,
  module_storage: List<v2.compiler.source_authority.ModuleStorageBinding>,
) -> List<CommitWriterRefusal> {
  match blob.classification.observed {
    CommitWriterBlobClassificationUnavailable { cause } =>
      [CommitWriterBlobClassificationUnavailableRefusal { path: blob.path, cause: cause }]
    CommitWriterBlobArtifactClassificationRefused { cause } => match cause {
      CommitWriterArtifactNotTracked { artifact } =>
        [CommitWriterArtifactUntrackedRefusal { path: blob.path, artifact: artifact }]
      CommitWriterArtifactPathDoesNotMatch { artifact: _, provenance_file_path } =>
        [CommitWriterArtifactPathMismatchRefusal {
          path: blob.path,
          provenance_file_path: provenance_file_path,
        }]
    }
    CommitWriterBlobNonTextClassified { artifact } =>
      commit_writer_artifact_refusals(
        blob: blob,
        receipt: artifact,
        module_storage: module_storage,
      )
    CommitWriterBlobTextDecoded { text, marker_grammar, artifact } =>
      append(
        commit_writer_artifact_refusals(
          blob: blob,
          receipt: artifact,
          module_storage: module_storage,
        ),
        items: match artifact.artifact.kind {
          v2.std.artifact.TestClaimArtifact => []
          _ => commit_writer_text_marker_refusals(
            path: blob.path,
            text: text,
            grammar: marker_grammar,
          )
        },
      )
    CommitWriterBlobNonTextUnclaimed => []
    CommitWriterBlobTextUnclaimed { text, marker_grammar } =>
      commit_writer_text_marker_refusals(
        path: blob.path,
        text: text,
        grammar: marker_grammar,
      )
  }
}

fn commit_writer_blob_coverage_refusals(
  blob: CommitWriterStagedBlobObservation,
  observation: CompleteStagedCommitObservation,
) -> List<CommitWriterRefusal> {
  let matching_index = commit_writer_normal_index_entries_for_path(
    index: observation.index,
    path: blob.path,
  )
  append(
    if count(matching_index) == 0 {
      [CommitWriterExtraBlobObservationRefusal {
        path: blob.path,
        indexed_oid: blob.indexed_oid,
      }]
    } else if count(matching_index) > 1 {
      []
    } else {
      let index_entry = matching_index.first()
      if extdeps.git.object_store.git_object_id_eq(left: index_entry.oid, right: blob.indexed_oid) {
        []
      } else {
        [CommitWriterIndexBlobIdentityMismatchRefusal {
          path: blob.path,
          index_oid: index_entry.oid,
          observed_index_oid: blob.indexed_oid,
        }]
      }
    },
    items: append(
      if extdeps.git.object_store.git_object_id_eq(left: blob.indexed_oid, right: blob.content_oid) {
        []
      } else {
        [CommitWriterBlobContentMismatchRefusal {
          path: blob.path,
          indexed_oid: blob.indexed_oid,
          content_oid: blob.content_oid,
        }]
      },
      items: commit_writer_blob_classification_refusals(
        blob: blob,
        module_storage: observation.module_storage,
      ),
    ),
  )
}

fn commit_writer_missing_blob_refusals(
  observation: CompleteStagedCommitObservation,
) -> List<CommitWriterRefusal> {
  flat_map(
    observation.index,
    entry => match entry.stage {
      extdeps.git.object_store.GitIndexStageNormal =>
        if count(commit_writer_blobs_for_path(blobs: observation.blobs, path: entry.path)) == 0 {
          [CommitWriterMissingBlobObservationRefusal {
            path: entry.path,
            indexed_oid: entry.oid,
          }]
        } else {
          []
        }
      extdeps.git.object_store.GitIndexStageBase => []
      extdeps.git.object_store.GitIndexStageOurs => []
      extdeps.git.object_store.GitIndexStageTheirs => []
    },
  )
}

fn admit_commit_writer(
  writer: CommitWriter,
  observation: CompleteStagedCommitObservation,
) -> CommitWriterAdmission {
  let refusals = append(
    commit_writer_unmerged_index_refusals_at(index: observation.index, at: 0),
    items: append(
      commit_writer_duplicate_normal_index_refusals_at(index: observation.index, at: 0),
      items: append(
        commit_writer_duplicate_blob_refusals_at(blobs: observation.blobs, at: 0),
        items: append(
          commit_writer_missing_blob_refusals(observation: observation),
          items: flat_map(
            observation.blobs,
            blob => commit_writer_blob_coverage_refusals(blob: blob, observation: observation),
          ),
        ),
      ),
    ),
  )
  if refusals == [] {
    CommitWriterAdmitted {
      writer: writer,
      coverage: ExactIndexBlobCoverageReceipt {
        normal_index_entry_count: count(flat_map(
          observation.index,
          entry => match entry.stage {
            extdeps.git.object_store.GitIndexStageNormal => [entry]
            extdeps.git.object_store.GitIndexStageBase => []
            extdeps.git.object_store.GitIndexStageOurs => []
            extdeps.git.object_store.GitIndexStageTheirs => []
          },
        )),
        staged_blob_observation_count: count(observation.blobs),
      },
    }
  } else {
    CommitWriterRefused { writer: writer, refusals: refusals }
  }
}

data commit_writer_complete_staged_index_blob_observation_transport_note: String = "REALIZATION for commit_writer_complete_staged_index_blob_observation_transport (commit_writer_binding_work). Decodes the real staged index via git.Core.LsFilesStageZInRepo + extdeps.git.object_store.git_decode_ls_files_stage_z, reads each extdeps.git.object_store.GitIndexStageNormal blob's content via git.Core.CatFileBlobInRepo keyed on the index oid — both repo-scoped (git -C dispatched to the repo argument), matching the existing *InRepo operation family in extdeps.git.git rather than assuming the process cwd, so the same fold is exercisable against a throwaway test repository and not only the actuator's invocation directory (never a caller-supplied oid, so content_oid == indexed_oid is an honest fetch-by-that-exact-oid check, not a tautology), classifies each blob against heal_writer_claims_no_fixture_exemptions, the declared-empty ModuleStorageIndex policy this writer holds (see heal_writer_claims_no_fixture_exemptions_note for why and its named limitation), matched by extdeps.git.object_store.GitPath octets, and falls to the CommitWriterBlobTextUnclaimed absence arm (still fully marker-scanned) for every blob because no binding is ever held. Two named residues, unchanged from commit_writer_admission_note: text-vs-non-text is not independently observed (every fetched blob is treated as text, matching the existing observer-trusted residue), and the marker grammar is Git's documented default width of seven rather than an observed gitattributes conflict-marker-size (no attribute-reading operation exists yet; a narrower grammar only widens what refuses, never what silently admits, so this is a strict subset of the true refusal set, not a fail-open). extdeps.git.object_store.GitObjectFormatSha1 is hardcoded because this repository's object database is SHA-1; a SHA-256 repository would need this as a parameter, not assumed."

fn commit_writer_candidate_artifacts_for_path(
  module_storage: List<v2.compiler.source_authority.ModuleStorageBinding>,
  path: extdeps.git.object_store.GitPath,
) -> List<v2.std.artifact.Artifact> {
  flat_map(
    module_storage,
    binding => match binding.provenance {
      v2.compiler.source_authority.ParsedFromSource { artifact, span_index: _ } =>
        if std.bytes.bytes_octets(b: std.bytes.utf8_encode_bytes(s: artifact.file_path)) == extdeps.git.object_store.git_path_octets(path: path) {
          [artifact]
        } else {
          []
        }
      v2.compiler.source_authority.ProducedByBehavior { producer: _ } => []
    },
  )
}

fn commit_writer_classify_staged_blob(
  module_storage: List<v2.compiler.source_authority.ModuleStorageBinding>,
  path: extdeps.git.object_store.GitPath,
  indexed_oid: extdeps.git.object_store.GitObjectId,
  text: String,
  grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar,
) -> CommitWriterBlobClassificationReceipt {
  match first(commit_writer_candidate_artifacts_for_path(module_storage: module_storage, path: path)) {
    Absent => commit_writer_text_unclaimed_classification_receipt(text: text, marker_grammar: grammar)
    Present { value: artifact } =>
      match commit_writer_classify_artifact(
        module_storage: module_storage,
        path: path,
        indexed_oid: indexed_oid,
        artifact: artifact,
      ) {
        CommitWriterArtifactClassified { receipt } =>
          commit_writer_text_classification_receipt(text: text, marker_grammar: grammar, artifact: receipt)
        CommitWriterArtifactClassificationRefused { cause } =>
          commit_writer_refused_artifact_classification_receipt(cause: cause)
      }
  }
}

fn commit_writer_observe_staged_blob(
  repo: std.types.FilePath,
  module_storage: List<v2.compiler.source_authority.ModuleStorageBinding>,
  entry: extdeps.git.object_store.GitIndexEntry,
) -> CommitWriterStagedBlobObservation {
  let hex = extdeps.git.object_store.git_object_id_wire_hex(oid: entry.oid) as String
  let read = git.Core.CatFileBlobInRepo(repo: repo, oid: hex)
  CommitWriterStagedBlobObservation {
    path: entry.path,
    indexed_oid: entry.oid,
    content_oid: entry.oid,
    classification: if read.success {
      commit_writer_classify_staged_blob(
        module_storage: module_storage,
        path: entry.path,
        indexed_oid: entry.oid,
        text: read.content,
        grammar: extdeps.git.object_store.GitEffectiveConflictMarkerGrammar { size: 7 },
      )
    } else {
      commit_writer_unavailable_classification_receipt(
        cause: concat("git cat-file -p failed for oid ", hex),
      )
    },
  }
}

fn commit_writer_observe_staged_blobs(
  repo: std.types.FilePath,
  module_storage: List<v2.compiler.source_authority.ModuleStorageBinding>,
  index: List<extdeps.git.object_store.GitIndexEntry>,
) -> List<CommitWriterStagedBlobObservation> {
  flat_map(
    index,
    entry => match entry.stage {
      extdeps.git.object_store.GitIndexStageNormal =>
        [commit_writer_observe_staged_blob(repo: repo, module_storage: module_storage, entry: entry)]
      extdeps.git.object_store.GitIndexStageBase => []
      extdeps.git.object_store.GitIndexStageOurs => []
      extdeps.git.object_store.GitIndexStageTheirs => []
    },
  )
}

type CommitWriterTransportObservation
  = CommitWriterTransportObserved { observation: CompleteStagedCommitObservation }
  | CommitWriterTransportRefused { reason: String }

data heal_writer_claims_no_fixture_exemptions_note: String = "POLICY, NOT A FALLBACK. observe_complete_staged_commit's caller (heal_admit / HealAutocommit) never stages genuine test fixtures — it stages only generated artifacts — so it declares up front that it holds no v2.compiler.source_authority.ModuleStorageBinding rows and therefore claims no v2.std.artifact.TestClaimArtifact fixture exemption for anything it stages. This is v2.compiler.source_authority module_storage_bindings_for_source_roots's std.algebra.Empty ModuleStorageIndex written directly as a typed declaration at this call site, never produced by a Rejected/failure arm — no path through observe_complete_staged_commit can reach an empty or absent module_storage by way of a failure; the only way to get one is this declaration. Per commit_writer_admission_note's absence-arm design, an empty module_storage costs nothing on this path: every staged blob is CommitWriterBlobTextUnclaimed or CommitWriterBlobNonTextUnclaimed and still receives the full commit_writer_text_marker_refusals conflict-marker scan; only a claimed v2.std.artifact.TestClaimArtifact receipt would have skipped it, and this writer never holds one. NAMED LIMITATION: a staged blob that is genuinely v2.std.artifact.TestClaimArtifact-shaped and contains conflict-marker-looking bytes (a real fixture with embedded begin/separator/end tokens) refuses under this policy, because the declaration cannot distinguish it from ordinary content — a false refusal, not a missed defect, and diagnosable in one read from this note rather than hidden behind a relaxed gate. Not chosen for this callsite: real module-storage supply. module_storage_bindings_for_source_roots(source_roots: [\"dag\", \"src/v2\"]) is currently an always-Rejecting scaffold with no live in-graph host dispatch (source_authority.dag module_storage_bindings_for_source_roots_host_disposition / module_storage_supply_unbound_body_note), and the manifest-overlay-supply mechanism used elsewhere (module_binding_supply_transport.dag) does not fit here: discover_source_root_ingest mints ^-edge identifiers from source-file basenames with no keyword-escaping, so scanning dag/ mints ^capability, ^module, ^import — all reserved .dag keywords (extdeps_languages_dag_syntax.rs dag_keyword_set) — for dag/extdeps/bmc/capability.dag, dag/extdeps/languages/go/module.dag, and dag/std/import.dag respectively, producing syntactically invalid overlay output for any scope touching dag/. DISSOLUTION TRIGGER: this declaration dissolves in favor of a real module_storage_bindings_for_source_roots binding once (a) that scaffold gains a live host dispatch, or (b) the manifest-overlay identifier-minting defect is fixed and re-verified end-to-end; either bounds a real fixture-exemption receipt for this writer instead of the empty declaration."

data heal_writer_claims_no_fixture_exemptions: List<v2.compiler.source_authority.ModuleStorageBinding> = std.algebra.Empty

fn observe_complete_staged_commit(repo: std.types.FilePath, writer: CommitWriter) -> CommitWriterTransportObservation {
  let ls_files = git.Core.LsFilesStageZInRepo(repo: repo)
  if !ls_files.success {
    CommitWriterTransportRefused {
      reason: "commit writer heal admission transport: git ls-files -z --stage failed — refusing, never skipping (DESIGN section 5)"
    }
  } else {
    match extdeps.git.object_store.git_decode_ls_files_stage_z(payload: std.bytes.utf8_encode_bytes(s: ls_files.raw), format: extdeps.git.object_store.GitObjectFormatSha1) {
      extdeps.git.object_store.GitLsFilesStageZRefused { cause: _ } =>
        CommitWriterTransportRefused {
          reason: "commit writer heal admission transport: staged index decode refused"
        }
      extdeps.git.object_store.GitLsFilesStageZDecoded { entries } =>
        CommitWriterTransportObserved {
          observation: CompleteStagedCommitObservation {
            index: entries,
            blobs: commit_writer_observe_staged_blobs(repo: repo, module_storage: heal_writer_claims_no_fixture_exemptions, index: entries),
            module_storage: heal_writer_claims_no_fixture_exemptions,
          }
        }
    }
  }
}

fn commit_writer_heal_admission_gate(repo: std.types.FilePath, writer: CommitWriter) -> std.process.ProcessExit {
  match observe_complete_staged_commit(repo: repo, writer: writer) {
    CommitWriterTransportRefused { reason } => std.process.exit_failure(reason: reason)
    CommitWriterTransportObserved { observation } =>
      match admit_commit_writer(writer: writer, observation: observation) {
        CommitWriterAdmitted { writer: _, coverage: _ } => std.process.ExitSuccess
        CommitWriterRefused { writer: _, refusals: _ } =>
          std.process.exit_failure(
            reason: "commit writer heal admission refused: the staged index carries at least one unmerged, unclaimed-and-marked, or mismatched blob — refusing to commit (DESIGN section 5)",
          )
      }
  }
}

fn heal_admit() -> std.process.ProcessExit {
  commit_writer_heal_admission_gate(repo: "." as std.types.FilePath, writer: HealAutocommit)
}

data commit_writer_heal_skew_conflict_arm_provisional_bytes_residue_note: String = "commit_writer_heal_admission_gate DOES NOT discharge CommitWriterHealSkewConflictArm's full obligation in commit_writer_binding_work — a second, distinct defect in ci_heal_skew_guard_emit.dag's conflict arm survives this gate by construction, not by oversight. That arm resolves (git checkout --ours), stages (git add), and THEN commits provisional ours-side bytes BEFORE ci_heal_regen_step runs and produces the actually-correct bytes, which ci_heal_commit_push_step commits a second time — two pushed commits, the first authored by no one and immediately contradicted by the second (the #7870 shape, reproduced by the guard's own design, per operator analysis msg_8723bc93). This gate runs against exactly that provisional-ours commit: the index is clean (every entry extdeps.git.object_store.GitIndexStageNormal, admit_commit_writer's unmerged-index check does not fire) and the resolved text carries no conflict markers (the conflict-marker check does not fire), so admit_commit_writer correctly ADMITS it — nothing this gate models is violated by provisional-but-unregenerated bytes, because staleness-versus-regenerated-authority is not a fact this observation carries. What this gate closes: a FAILED resolution reaching the arm's commit with unmerged stages or live conflict markers still present (the CommitWriterUnmergedIndexRefusal / CommitWriterConflictMarkerTextRefusal arms). What stays open, as its own row with its own trigger: the conflict arm should not commit provisional bytes at all — leave the resolution staged, let regen run, commit once with regenerated bytes — which is a merge-state semantics change to a load-bearing CI flow (a merge must be concluded; ci_heal_commit_push_step filters to auto-push-eligible paths, so whether it would carry the staged merge resolution as-is is unverified) requiring its own design pass, not inferred under this brief. Next trigger: that reorder lands as its own PR against ci_heal_skew_guard_emit.dag's ci_heal_skew_conflict_arm."

type LocalTidyCheck
  = LocalTidyWitnessCheck { entry: String, check_fns: List<String> }
  | LocalTidyCargoFmtCheck

type CommitWorkflowSurface
  = GithubActionsCiJob
  | GitPrePushHook
  | FalsifierCadenceJob

type CommitCheckKind
  = CommitSpecGate { gate: gunbc.ci_gate.Gate }
  | CommitWitnessClaim { entry: String, check_fns: List<String>, kind: std.realization_schedule.WitnessKind, span: std.realization_schedule.WitnessSpan }
  | CommitCargoFmtCheck

type CommitCheckEnrollment {
  check: CommitCheckKind
  surfaces: List<CommitWorkflowSurface>
}

type EntryDeclarationDiscovery
  = DiscoveryComplete {
      entry: String,
      module_path: std.types.NonEmptyStr,
      declarations: List<std.decl_ref.DeclarationRef>
    }
  | DiscoveryIncomplete { entry: String, cause: std.types.NonEmptyStr }

type EnrollmentWitnessDemand {
  check: CommitCheckKind
  declarations: List<std.decl_ref.DeclarationRef>
}

type EnrollmentDemandOutcome
  = DemandQualified { rows: List<EnrollmentWitnessDemand> }
  | DemandMissing { check: CommitCheckKind, cause: std.types.NonEmptyStr }
  | DemandAmbiguous { check: CommitCheckKind, cause: std.types.NonEmptyStr }
  | DemandIncomplete { check: CommitCheckKind, cause: std.types.NonEmptyStr }
  | DemandRosterAmbiguous { cause: std.types.NonEmptyStr }

type SingleEnrollmentDemandOutcome
  = SingleDemandQualified { row: EnrollmentWitnessDemand }
  | SingleDemandMissing { cause: std.types.NonEmptyStr }
  | SingleDemandAmbiguous { cause: std.types.NonEmptyStr }
  | SingleDemandIncomplete { cause: std.types.NonEmptyStr }

type NamedDeclarationDemandOutcome
  = NamedDeclarationsQualified { declarations: List<std.decl_ref.DeclarationRef> }
  | NamedDeclarationMissing { cause: std.types.NonEmptyStr }
  | NamedDeclarationAmbiguous { cause: std.types.NonEmptyStr }

type DuplicateCommitCheck
  = NoDuplicateCommitCheck
  | DuplicateCommitCheckFound { check: CommitCheckKind }

type CommitWorkflowRealizationKind
  = CiYamlHandler
  | GitPrePushScriptHandler

type CommitWorkflowRealizationBinding {
  surface: CommitWorkflowSurface
  handler: CommitWorkflowRealizationKind
  artifact: gunbc.generated_artifact.GeneratedArtifact
}

data githooks_pre_push_artifact_drift_gate_removed_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "gunbc.ci_gate.GeneratedArtifactDriftGate's GitPrePushHook enrollment REMOVED 2026-07-22 (fleet incident: this gate broke pushes fleet-wide — measured ~61min/2,176 witnesses on a rebased force-push touching measure.dag, since committed_generated_artifacts() regeneration walks the whole generated-artifact corpus, not an affected-set slice). Fail-closed verification before removal (DESIGN §5 — do not drop a check without confirming the authoritative boundary still covers it): gunbc.ci_gate.GeneratedArtifactDriftGate stays enrolled on GithubActionsCiJob, which the required `ci` job runs via src/v2/workflow/ci_floor_plan.dag gunbc_ci_floor_plan (dag/gunbc/ci_spec.dag ci_gate list, RunnableSingleClaim on generated_artifact_drift_gate_passes); that same floor run is what stamps the merge-admission receipt tools.merge_admission_gate.dag reads at merge time, so drift is still a hard merge-time wall — pre-push was a redundant SECOND full-corpus run of the same unscoped check (DESIGN §2: duplicated work, not added safety), not the only place it was enforced. This mirrors the fmt precedent recorded in commit_gate_rust_suite_removed_disposition below: a git hook is opt-in per clone (core.hooksPath), bypassable with --no-verify, and absent in container worktrees, so it was never a sound enforcement AUTHORITY — only fast local feedback. The pre-push hook keeps the cheap guards (uncommitted-tree check, doc-reachability witness on the ReadsLiveTree entry, cargo fmt --all --check) and gunbc_ci_witness_corpus_only_batches' declared affected-set-scoped test gate (see its own note: deliberately narrowed to the hermetic discovery corpus, not this whole-corpus regen sweep). No skip env var was added — the heavy arm is gone from the model, not hidden behind a toggle (DESIGN §5 no-escape-hatches)."
}

data githooks_pre_push_slimmed_to_fmt_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "The pre-push hook was SLIMMED TO FMT-ONLY 2026-07-25 (operator ruling): 'Pre-push hook restored to fmt-only per CLAUDE.md's documented contract; the witness corpus belongs to CI, not the push path.' Removed from the GitPrePushHook surface: the doc-reachability CommitWitnessClaim enrollment, and (in gunbc.githooks_pre_push_emit) the whole `claim_batch --pre-push` shim — the affected-set WitnessCorpusRun gate, the DocWitnessRun gate, and the in-hook `cargo build -p v1-compiler --bin claim_batch` that ran from inside a push when the binary was missing. Fail-closed verification before removal (DESIGN §5 — do not drop a check without confirming the authoritative boundary still covers it): cargo fmt --all --check remains a required-path CI step (gunbc.ci_spec ci_fmt_gate_note — build runs it first, and ci needs:[build]); the witness corpus remains the required `ci` floor via gunbc_ci_floor_plan, which also stamps the merge-admission receipt tools.merge_admission_gate.dag reads; and dag/test/claim/doc_reachability_witness_test.dag keeps its cadence through the floor's discovery-corpus scan (CiSpec.discovery_scan_dirs covers dag/test/claim), so the doc-reachability rows lose no coverage — only their redundant second run on the push path. NOTHING LOSES ENFORCEMENT BECAUSE THE HOOK NEVER PROVIDED ANY: it is opt-in per clone (core.hooksPath), bypassable with --no-verify, absent in container worktrees, and PROVEN ineffective by #6658 (an unformatted .rs landed on main and no hook caught it) — the same argument commit_gate_rust_suite_removed_disposition and githooks_pre_push_artifact_drift_gate_removed_disposition already make. What the weight DID buy was harm: a non-authority check heavy enough to make a legitimately-red mid-lane branch feel unpushable is pressure that converts honest reds into workaround greens, and it was priced — three rounds of hand-import workarounds, one decorative gate, and the normalization of --no-verify on the namespace type-binding lane (2026-07-25). A check that cannot enforce should at least be instant. Explicitly DECLINED as the alternative: branch-level expected-red exemption machinery — building configuration so a non-authority check can be tolerated invests in a mechanism that should not carry this weight at all, and slimming dissolves the need. No skip env var was added; the heavy arms are gone from the model, not hidden behind a toggle (DESIGN §5 no-escape-hatches). Re-heavying requires a GitPrePushHook roster edit, which dag/test/claim/githooks_pre_push_emit_test.dag reds on."
}

data commit_gate_rust_suite_removed_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "The v1 Rust test suite (cargo fmt --all --check plus cargo nextest run -p v1-compiler-tests) was REMOVED from CI 2026-07-11 (operator ruling) — its RustMonolithGate enrollment, the rust_tests job, and rust_gates_ci.dag's CI consumers are all gone. This records the removal as intentional, not silent (the review-flagged concern). Rationale: rust_tests was NON-required (only the ci job is protection-required on the gunbc main ruleset; rust_tests and ci_regen were not) AND red on main (it exercises the v1 seed, which is being deleted under the §7 burn-down), so it delivered a permanent non-required red — the §5 tolerated-red anti-pattern — at ~37 GiB, the fleet's single largest CI memory job. AMENDED 2026-07-15 (operator ruling, the falsifier lane): the fmt HALF of this removal is REVERSED — cargo fmt --all --check is re-enrolled as a standalone build-job step (gunbc.ci_spec ci_fmt_gate_note / ci_fmt_gate_line). Every rationale above is a fact about NEXTEST (37 GiB, red, seed-runtime); fmt is 4.3s measured, parse-only, needs no build, and is green — it was collateral damage of a §3 fusion, since tools.rust_gates_ci.run_gates welds both into one std.process.ProcessExit, so killing the bundle killed the cheap green half. This amendment does NOT re-enroll RustMonolithGate (still REJECTED below) and does not return nextest to CI. AMENDED 2026-07-31 (operator ruling, PR #7490 repair): the COMPILE half for the separate v1-compiler-tests workspace crate is RE-ENROLLED as cargo check -p v1-compiler-tests --tests (gunbc.ci_spec ci_v1_compiler_tests_compile_gate_note / ci_v1_compiler_tests_compile_gate_line) — compile-only, no test execution, ~41s measured cold; NOT nextest and NOT RustMonolithGate. #7490 updated typecheck_module and fixed stage0 call sites but left four direct integration-test callers stale because neither gunbc.ci_gate.DagCompileCleanGate nor the release build compiles that crate. The former claim 'cargo fmt stays enforced by the pre-push hook (CommitCargoFmtCheck on GitPrePushHook)' is RETRACTED as the enforcement authority: a hook is an escape hatch (§5) — opt-in per clone via a manual core.hooksPath config, bypassable with --no-verify, and absent in container worktrees — and it is PROVEN ineffective, not merely theoretically weak: #6658 landed an unformatted .rs on main 2026-07-15 and no gate caught it. The hook remains as fast local feedback, never as the wall. Coverage now: cargo fmt = the required CI path (ci needs:[build], so a red fmt step blocks the required job by construction); cargo check -p v1-compiler-tests --tests = the required CI compile path for direct Rust integration-test call sites; cargo nextest run -p v1-compiler-tests still runs LOCALLY, not in CI. Return trigger for NEXTEST — NONE by design: that suite does not re-enroll. It is retired WITH the v1 seed and deleted at §7 terminal collapse. Re-enrolling RustMonolithGate onto the required ci floor is explicitly REJECTED — it would move the ~37 GiB red job into the required merge gate. gunbc.ci_gate.DagCompileCleanGate and RegenVerifyGate still catch .dag compile drift; this gate closes the v1-compiler-tests direct-caller hole they cannot see."
}

