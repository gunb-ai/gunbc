data commit_workflow_realization_bindings: List<CommitWorkflowRealizationBinding> = [
  CommitWorkflowRealizationBinding {
    surface: GitPrePushHook,
    handler: GitPrePushScriptHandler,
    artifact: gunbc.generated_artifact.GithooksPrePushArtifact
  }
]

fn commit_workflow_surface_eq(a: CommitWorkflowSurface, b: CommitWorkflowSurface) -> Bool {
  match a {
    GithubActionsCiJob =>
      match b { GithubActionsCiJob => true  _ => false }
    GitPrePushHook =>
      match b { GitPrePushHook => true  _ => false }
    FalsifierCadenceJob =>
      match b { FalsifierCadenceJob => true  _ => false }
  }
}

fn surface_enrolled(surface: CommitWorkflowSurface, surfaces: List<CommitWorkflowSurface>) -> Bool {
  any(surfaces, s => commit_workflow_surface_eq(a: s, b: surface))
}

fn enrollment_has_surface(e: CommitCheckEnrollment, surface: CommitWorkflowSurface) -> Bool {
  surface_enrolled(surface: surface, surfaces: e.surfaces)
}

fn gate_eq(a: gunbc.ci_gate.Gate, b: gunbc.ci_gate.Gate) -> Bool {
  match a {
    gunbc.ci_gate.EmitHostGate => match b { gunbc.ci_gate.EmitHostGate => true  _ => false }
    gunbc.ci_gate.CheapClaimPoolGate => match b { gunbc.ci_gate.CheapClaimPoolGate => true  _ => false }
    gunbc.ci_gate.ExtdepsExternalAuthorityGate => match b { gunbc.ci_gate.ExtdepsExternalAuthorityGate => true  _ => false }
    gunbc.ci_gate.DagCompileCleanGate => match b { gunbc.ci_gate.DagCompileCleanGate => true  _ => false }
    gunbc.ci_gate.GeneratedArtifactDriftGate => match b { gunbc.ci_gate.GeneratedArtifactDriftGate => true  _ => false }
    gunbc.ci_gate.ExtdepsScopePlacementGate => match b { gunbc.ci_gate.ExtdepsScopePlacementGate => true  _ => false }
    gunbc.ci_gate.ProseRowIntroductionGate => match b { gunbc.ci_gate.ProseRowIntroductionGate => true  _ => false }
    gunbc.ci_gate.SourceRootIngestGate => match b { gunbc.ci_gate.SourceRootIngestGate => true  _ => false }
  }
}

fn gates_from_enrollments(rows: List<CommitCheckEnrollment>) -> List<gunbc.ci_gate.Gate> {
  fold(rows, init: [], f: fn(acc, row) {
    match row.check {
      CommitSpecGate { gate: g } => concat(acc, [g])
      CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => acc
      CommitCargoFmtCheck => acc
    }
  })
}

fn project_ci_floor_gates(roster: List<CommitCheckEnrollment>) -> List<gunbc.ci_gate.Gate> {
  gates_from_enrollments(
    rows: filter(roster, e => enrollment_has_surface(e: e, surface: GithubActionsCiJob))
  )
}

data gate_gauntlet_flip_basis_note: String = "THE MEASURED FLIPS (D3b, first application of the gate lane above). Basis is the per-run gate warm-cost receipt the floor already writes (floor-gate-warm-cost-receipt.tsv, published in the floor-receipts artifact; its [gate-warm-cost] stderr mirror was retired when the receipts gained a transport, and the TSV it names is unchanged) — a real measurement at the grain the placement law requires for a GATE, which is why these three could be priced when the 36 CommitWitnessClaim rows still cannot: the TSV measures gates, and falsifier_cadence_surface_note's blocker is per-ROW receipts. Conflating the two grains would have been the fabrication that note forbids. Warm costs from the green composition run (30181042050, srv fleet arm64): source_root_ingest 427s as ONE opaque entry (its heartbeat reads 'entry 0 of 1' for ~8 minutes), self_host_realized_comparison 223s. Both are ORDERS above the 5s fast-lane budget (gunbc_ci_fast_lane_eval_budget_ms), so PrTier is inadmissible under ci_placement_law_note and Gauntlet is not a preference but the only admissible placement — no signature can make a 427s check fast-lane-eligible. THE COST, stated rather than elided: a regression in either now has up to a 4-hour detection window instead of one PR, and this is the same trade provenance_wall_cadence_rehome_risk accepted three days earlier, priced the same way. WHAT KEEPS IT FROM BEING A BARE NARROW is structural, not a promise: the gate lane's projector and batch land in the same change (falsifier_gate_projection_note), and gauntlet_lane_gate_rehome_is_never_bare_deenrollment_holds proves by execution that these rows reach an executing surface rather than vanishing. FOLLOW-ON TRIGGER, deliberately NOT taken here: a diff-proportional PR-tier proxy for source_root_ingest (ingest only the affected roots per-PR, full ingest on cadence) would return per-PR coverage at a cost that scales with the diff instead of the corpus — that is the real fix, and this flip is the interim that stops paying 427s per PR while it is built. THE THIRD GATE IS NOT FLIPPED, and the reason is a finding rather than caution: CheapClaimPoolGate (75s) is a declared member of v2.workflow.ci_floor_plan gunbc_ci_cheap_floor_gate_membership, which makes it BOTH a DataDependsOn predecessor of the compile root (floor_cheap_gates_precede_compile_edges) AND a floor_resource_anchor whose exclusion from corpus→gate serialization is what that list's own note says 'avoids a scheduler deadlock' (cheap→compile data order, corpus→cheap resource order, compile→corpus data order closing the cycle). Moving it is therefore a scheduler rewire, not a surface edit, for the smallest of the three prizes — 75s of the 725s measured. It stays per-PR pending an operator call on whether that rewire is worth 10 percent of the recovery. DECLINED 2026-07-26 (operator ruling): CheapClaimPoolGate gauntlet flip stays per-PR. REASON 1 — §6 displaced-cost bar: 75s is ~9% of the measured 725s warm cost, insufficient payoff for a scheduler rewire. REASON 2 — load-bearing signal + deadlock: as a DataDependsOn predecessor of the compile root it is the floor's earliest fail signal (moving it costs signal latency), and its exclusion from corpus→gate serialization avoids the three-way deadlock (cheap→compile data order, corpus→cheap resource order, compile→corpus data order). RE-OPEN TRIGGER: only when a lane restructures the floor scheduler for its own reasons (diff-proportional ingest proxy, or floor-memo M2) — never its own lane."

data falsifier_gate_projection_note: String = "The GATE half of the FalsifierCadenceJob lane, and it did not exist until 2026-07-26. FOUND BY AUDIT, not by a red: the lane shipped with a witness projector (project_falsifier_witness_entries) and no gate projector, while witness_entries_from_enrollments drops CommitSpecGate rows by construction (`CommitSpecGate { gate: _ } => acc`). So a gate row moved to surfaces: [FalsifierCadenceJob] projected into NOTHING — it left the per-PR floor and arrived on no lane — and bare_deenrollment_wall_note's wall could not catch it because that wall filters on enrollment_is_witness_claim, which answers false for exactly this row kind. A gate was therefore the one enrollment shape that could be silently de-enrolled by a one-line surface edit that reads, in the diff, identically to a legitimate re-home. This projector plus the scheduled-surface predicate close that (the predicate was gate_enrollment_is_scheduled; it collapsed into the shared enrollment_is_scheduled on 2026-08-19 when the regen root cut deleted the one surface that separated it from the witness form — enrollment_surface_asymmetry_retired_note): the lane can now receive gates, and the wall now counts them. THE ORDER MATTERS AND IS NOT COSMETIC: this projector and its executing batch (v2.workflow.ci_floor_plan gunbc_falsifier_gate_batch) land in the SAME change as the wall extension, because a wall that credits FalsifierCadenceJob for gates before any batch reads them would bless precisely the enrollment-by-illusion it exists to forbid — the same 'a surface tag with no batch reading it' trap falsifier_cadence_witness_batch_note names for witnesses."

fn project_falsifier_gates(roster: List<CommitCheckEnrollment>) -> List<gunbc.ci_gate.Gate> {
  gates_from_enrollments(
    rows: filter(roster, e => enrollment_has_surface(e: e, surface: FalsifierCadenceJob))
  )
}

data ci_witness_optin_inversion: std.disposition.Disposition = std.disposition.Terminal {
  reason: "Opt-in inversion (operator, 2026-07-04) DISSOLVE FIRED at the discovery flip (operator acceptance 2026-07-09 on #6403; re-landed 2026-07-10, see gunbc.ci_spec ci_spec_discovery_flip_note): the corpus re-enrolled through CiSpec.discovery_scan_dirs with SelectionApplied, so per-PR CI runs tree-wide discovery shrunk to the diff's affected set. The scaffold's dissolve-on (affected-set selection + floor memoization make per-PR selection-by-affectedness affordable) is satisfied at discovery width=1 under union-resolve S1. project_ci_floor_witness_entries is std.disposition.Terminal, not interim: CommitWitnessClaim rows remain live as the explicit-entry roster (execution-kind rows with their own resource profile, and any row that must run as declared) - only the roster's EXCLUSIVITY as witness source dissolved."
}

data witness_projection_explicit_arms_note: String = "The enrollment projections match EXPLICITLY on every CommitCheckKind variant (no wildcard arm): a future variant added to the coproduct then reds every projection at compile time instead of being silently dropped by a `_ => acc` absorption - fail-open enrollment (a declared row contributing zero entries with no diagnostic) is unwritable, not detected."

fn witness_entries_from_enrollments(rows: List<CommitCheckEnrollment>) -> List<std.realization_schedule.ScheduleWitnessEntry> {
  fold(rows, init: [], f: fn(acc, row) {
    match row.check {
      CommitWitnessClaim { entry, check_fns, kind, span: _ } =>
        if check_fns.count() == 0 {
          concat(acc, [std.realization_schedule.ScheduleWitnessEntry { entry: entry, function: "", kind: kind }])
        } else {
          concat(acc, fold(check_fns, init: [], f: fn(fns, check_fn) {
            concat(fns, [std.realization_schedule.ScheduleWitnessEntry { entry: entry, function: check_fn, kind: kind }])
          }))
        }
      CommitSpecGate { gate: _ } => acc
      CommitCargoFmtCheck => acc
    }
  })
}

fn project_ci_floor_witness_entries(roster: List<CommitCheckEnrollment>) -> List<std.realization_schedule.ScheduleWitnessEntry> {
  witness_entries_from_enrollments(
    rows: filter(roster, e => enrollment_has_surface(e: e, surface: GithubActionsCiJob))
  )
}

data falsifier_cadence_surface_note: String = "FalsifierCadenceJob is the SCHEDULED home for declared witness rows whose measured wall prices them out of the per-PR floor (batch-4 clamp FLOOR-BATCH-OVER-BUDGET, run 30148859947: wall_ms=613864 vs clamp_ms=420000 at units=74; authority gunbc.ci_spec gunbc_ci_floor_batch_clamp_params[3]). It extends the axis that ALREADY answers 'where does this check run' — the enrollment surface — rather than minting a second re-home authority beside gunbc.ci_layer_roots falsifier_rehomed_bin_wet_rows, which is specifically the bin_witness_wet_entries per-row-budget overflow (its constructor is bin_wet, its budget datum is bin_witness_wet_per_row_wall_budget_seconds) and does not model CommitWitnessClaim rows. Re-homing here is NEVER a bare de-enrollment: a row moved off GithubActionsCiJob must land on this surface, so it stays enrolled somewhere and its execution is receipted on the 4-hour cadence. The failure mode this guards is measured, not hypothetical — 63 *_test.dag files live under the two test/claim/long/ dirs, 9 are enrolled here, and the rest are enrolled NOWHERE (long/ is excluded from discovery at dir grain and the falsifier does not walk it), so 'deferred' has historically meant 'unscheduled'; this surface is the lane those rows enroll into. GRAIN: enrollment splits at the check_fn, not the file — an entry whose expensive fns re-home keeps its cheap fns on GithubActionsCiJob as the per-PR smoke grain (the mocks-layer-never-replace rule), so a re-home costs the corpus its wet grain per-PR, never the concern's per-PR coverage entirely. 🟡 dissolve-on: v2.workflow.ci_placement Placement (PrTier | Gauntlet) supersedes this surface tag as the witness-scheduling authority. It cannot today: PrTier is unwritable without a WarmCostReceipt { measured_ms, run_ref } AND measured_ms <= gunbc_ci_fast_lane_eval_budget_ms (5s), so wiring placement onto the 36 CommitWitnessClaim rows requires a per-row measured receipt for each — the D2 warm-cost probe on fleet srv hardware is the named filler (ci_placement_law_note), and it has not run. Fabricating those receipts would be the fail-open the placement law exists to forbid; defaulting the unmeasured rows to Gauntlet would de-enroll all 36 at once. Encouraging convergence receipt: the 5s law selects EXACTLY the twelve rows the run-30148859947 slow-witness tables measured over 5s (group A 141s/57s/15s/7s, group B 141s/29s/27s/14s/13s/13s/13s/13s) and admits every other batch-4 row at <=1s, so placement and this surface agree on today's roster — the wiring is blocked on receipts, not on a disputed boundary."

data provenance_wall_cadence_rehome_risk: String = "RETIRED 2026-08-20 — the subject of this row no longer exists, so 'rehome' no longer describes anything. ORIGINAL CLAIM (operator ruling 2026-07-25): three affected-set provenance walls — lens_affected_set_provenance_producer_rejects_malformed_ingest_holds, _rejects_beyond_surface_ingest_holds, _coverage_receipt_holds (14s + 13s + 13s measured, run 30148859947 group-B slow-witness table) — moved from per-PR to the 4-hour falsifier cadence, accepting up to a 24-hour detection window. WHY IT IS RETIRED RATHER THAN CORRECTED: commit 60fa7b248f (2026-08-17, 'Delete the affected-set selection machinery and the evidence that only tested it') deleted src/v2/lens/affected_set/provenance_producer.dag and src/v2/test/claim/long/affected_set_provenance_producer_witness_test.dag whole, dispositioned RETIRED WITH THE MACHINERY — 'a witness whose subject no longer exists cannot be re-enrolled against anything.' These three check_fns were never re-enrolled anywhere after that deletion, on FalsifierCadenceJob or otherwise, because there is nothing left to enroll. THE BUG THIS ROW WAS CAUSING: gauntlet_lane_enrollment_witness_test.dag's witness_rehomed_rows_are_cadence_enrolled kept asserting these three names appear in live_roster_falsifier_witness_entries(), which is unwitnessable now that no roster row and no source file can name them — the assertion was reading as a live rehome risk when it was actually three dangling citations to code deleted three days after this note was written, an orphaned reference this note itself failed to catch (§3 positional/nominal citation rot, applied to a function name rather than a file:line). That test is corrected in the same change that retires this note. dissolve-on: none — there is no compensating control left to build, because there is no wall left to compensate for."

fn project_falsifier_witness_entries(roster: List<CommitCheckEnrollment>) -> List<std.realization_schedule.ScheduleWitnessEntry> {
  witness_entries_from_enrollments(
    rows: filter(roster, e => enrollment_has_surface(e: e, surface: FalsifierCadenceJob))
  )
}

fn enrollment_is_witness_claim(e: CommitCheckEnrollment) -> Bool {
  match e.check {
    CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => true
    CommitSpecGate { gate: _ } => false
    CommitCargoFmtCheck => false
  }
}

// ONE PREDICATE, both row kinds. It was two — witness_enrollment_is_scheduled and
// gate_enrollment_is_scheduled — differing by exactly one arm, GithubActionsCiRegenJob,
// which counted for a gate and never for a witness. The regen root cut deletes that
// surface, so the two bodies became identical and keeping both names would be two names
// for one predicate. See enrollment_surface_asymmetry_retired_note.
fn enrollment_is_scheduled(e: CommitCheckEnrollment) -> Bool {
  enrollment_has_surface(e: e, surface: GithubActionsCiJob)
    || enrollment_has_surface(e: e, surface: FalsifierCadenceJob)
}

fn enrollment_is_spec_gate(e: CommitCheckEnrollment) -> Bool {
  match e.check {
    CommitSpecGate { gate: _ } => true
    CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => false
    CommitCargoFmtCheck => false
  }
}

data enrollment_surface_asymmetry_retired_note: String = "RETIRED 2026-08-19 BY THE REGEN ROOT CUT, and retired rather than re-specimened because the claim stopped being true of anything. WHAT IT SAID: gates and witnesses needed SEPARATE scheduled-surface predicates because the two row kinds disagreed about one surface — GithubActionsCiRegenJob EXECUTED gates (project_ci_regen_job_gates read it, and RegenVerifyGate/SelfHostStalenessGate rode it as their only surface) but executed no witnesses, so a witness parked there ran nowhere while still looking enrolled. The shared law was: a declared row must ride a surface that executes ITS kind, read against two projector sets. WHY IT IS GONE: that one surface WAS the entire disagreement. Deleting it with the regen job left the two predicate bodies byte-identical, and one side of the asymmetry with no inhabitants at all — a claim about a distinction that no longer has two sides. Keeping the surface alive so the pair could keep demonstrating itself would have been a modeled surface whose only consumer is its own evidence, which DESIGN section 6 names as an artifact with no final consumer and a guard passing at 0 == 0. WHAT SURVIVES, and is still enforced by the two walls below: a declared row must ride an executing surface, GithubActionsCiJob or FalsifierCadenceJob. GitPrePushHook still counts for NEITHER kind, by the standing ruling (opt-in per clone, bypassable with --no-verify, absent in container worktrees, and proven ineffective by #6658) — so the walls keep a real negative control and the gate half keeps its synthetic RED. WHAT IS LOST, stated plainly: nothing now distinguishes the gate predicate from the witness predicate, so if a future surface executes one kind and not the other, the split has to be REINTRODUCED rather than merely re-pointed. That is the honest cost of retiring the claim instead of preserving a dead specimen to carry it."

fn bare_deenrolled_gate_rows(roster: List<CommitCheckEnrollment>) -> List<CommitCheckEnrollment> {
  filter(roster, e => enrollment_is_spec_gate(e: e) && !enrollment_is_scheduled(e: e))
}

fn roster_has_no_bare_deenrolled_gate(roster: List<CommitCheckEnrollment>) -> Bool {
  bare_deenrolled_gate_rows(roster: roster).count() == 0
}

fn live_roster_has_no_bare_deenrolled_gate() -> Bool {
  roster_has_no_bare_deenrolled_gate(roster: commit_gate_roster)
}

fn live_roster_falsifier_gates() -> List<gunbc.ci_gate.Gate> {
  project_falsifier_gates(roster: commit_gate_roster)
}

data doc_reachability_cadence_enrollment_note: String = "FOUND BY THE WALL, on its first execution (2026-07-25). gauntlet_lane_rehome_is_never_bare_deenrollment_holds redded against the LIVE roster, not a synthetic fixture: the doc-reachability witness (doc_graph_has_no_orphan_docs, doc_graph_has_no_dangling_links) rode surfaces: [GitPrePushHook] alone — enforced only by a mechanism this repo has already ruled is NOT an enforcement authority (commit_gate_rust_suite_removed_disposition: opt-in per clone via core.hooksPath, bypassable with --no-verify, absent in container worktrees, and PROVEN ineffective — #6658 landed an unformatted .rs on main 2026-07-15 and nothing caught it). So orphaned docs and dangling doc links have had no wall on any CI path; they were one --no-verify from landing. FIXED by adding FalsifierCadenceJob rather than by widening enrollment_is_scheduled to accept GitPrePushHook — widening the predicate until the failure disappears is the absorbing fallback §5 forbids, and it would have re-buried the finding in the same motion that surfaced it. The hook enrollment STAYS for fast local feedback; the cadence row is the authority. Kind is CorpusWitnessKind, not ExecutionWitnessKind: it reads the live doc graph, so per-PR admission would need a warm-cost receipt this change does not have — the same D2-probe gap falsifier_cadence_surface_note records. Promoting it to per-PR when that receipt exists is a strict improvement, not a requirement of this change."

data bare_deenrollment_wall_note: String = "The construction wall behind falsifier_cadence_surface_note's 'a re-home is NEVER a bare de-enrollment'. A CommitWitnessClaim row must ride at least one EXECUTING witness surface — GithubActionsCiJob (per-PR floor) or FalsifierCadenceJob (4-hour cadence). GitPrePushHook does not count: it is an escape hatch by the standing ruling (opt-in per clone, bypassable with --no-verify, absent in container worktrees — commit_gate_rust_suite_removed_disposition), so neither is an enforcement authority for a witness. A row satisfying neither is enrolled NOWHERE while still LOOKING enrolled, which is precisely the ~54-dark-file state test/claim/long/ is in and the shape a lazy re-home would add to. This is detection, not construction (the surface list is still writable as []) — the honest classification per DESIGN §5: it reds in the per-PR floor via gauntlet_lane_enrollment_witness_test with a synthetic RED control, and the construction form waits on the same D2-probe-gated placement wiring as falsifier_cadence_surface_note's dissolve-on, where Gauntlet-vs-PrTier is total over the coproduct and 'neither' becomes unwritable rather than merely counted. AMENDED 2026-07-26: this note described the witness half only, and that scoping was itself the gap — CommitSpecGate rows had NO such wall, so the one row kind whose de-enrollment nothing could catch was the one the Gauntlet lane was about to be used on. The gate half is now roster_has_no_bare_deenrolled_gate over the shared enrollment_is_scheduled. AMENDED 2026-08-19: the surface asymmetry this sentence used to cite (regen counts for gates, never for witnesses) is RETIRED with the regen root cut — GithubActionsCiRegenJob was the whole of it and the surface is deleted; see enrollment_surface_asymmetry_retired_note. Both halves now read one predicate, and both still red on a row riding only GitPrePushHook. Both halves are still DETECTION, not construction, and both dissolve on the same placement wiring."

fn bare_deenrolled_witness_rows(roster: List<CommitCheckEnrollment>) -> List<CommitCheckEnrollment> {
  filter(roster, e => enrollment_is_witness_claim(e: e) && !enrollment_is_scheduled(e: e))
}

fn roster_has_no_bare_deenrolled_witness(roster: List<CommitCheckEnrollment>) -> Bool {
  bare_deenrolled_witness_rows(roster: roster).count() == 0
}

fn live_roster_has_no_bare_deenrolled_witness() -> Bool {
  roster_has_no_bare_deenrolled_witness(roster: commit_gate_roster)
}

fn live_roster_falsifier_witness_entries() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  project_falsifier_witness_entries(roster: commit_gate_roster)
}

fn witness_seam_eq(a: std.realization_schedule.WitnessSeam, b: std.realization_schedule.WitnessSeam) -> Bool {
  (a.producer == b.producer) && (a.consumer == b.consumer)
}

fn witness_seam_lists_eq(left: List<std.realization_schedule.WitnessSeam>, right: List<std.realization_schedule.WitnessSeam>) -> Bool {
  if left.count() != right.count() {
    false
  } else if left.count() == 0 {
    true
  } else {
    witness_seam_eq(a: left.first(), b: right.first())
      && witness_seam_lists_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn witness_cost_basis_eq(a: std.realization_schedule.WitnessCostBasis, b: std.realization_schedule.WitnessCostBasis) -> Bool {
  match a {
    std.realization_schedule.MeasuredAtExactSubject { clock, duration, receipt } => match b {
      std.realization_schedule.MeasuredAtExactSubject {
        clock: clock2,
        duration: duration2,
        receipt: receipt2
      } =>
        std.measure.clock_basis_eq(a: clock, b: clock2)
          && (std.measure.millisecond_count(m: duration) == std.measure.millisecond_count(m: duration2))
          && (receipt == receipt2)
      std.realization_schedule.EstimatedFromSiblingClass { clock: _, source_witness: _, basis: _ } => false
    }
    std.realization_schedule.EstimatedFromSiblingClass { clock, source_witness, basis } => match b {
      std.realization_schedule.MeasuredAtExactSubject { clock: _, duration: _, receipt: _ } => false
      std.realization_schedule.EstimatedFromSiblingClass {
        clock: clock2,
        source_witness: source_witness2,
        basis: basis2
      } =>
        std.measure.clock_basis_eq(a: clock, b: clock2)
          && (source_witness == source_witness2)
          && (basis == basis2)
    }
  }
}

data scheduled_witness_envelope_path_classification_scope_note: String = "path_classification is std.witness_admission.WitnessConsumerCadence, the path-policy classification authority (std.witness_admission) — it does NOT answer whether anything executes a row; that question is answered by the separate fold in src/v2/workflow/witness_admission.dag, per commit_roster_enrollment_is_a_consumer_note there. This function and scheduled_witness_envelope_wellformed below compare/validate only what the field carries."

fn scheduled_witness_envelope_eq(a: std.realization_schedule.ScheduledWitnessEnvelope, b: std.realization_schedule.ScheduledWitnessEnvelope) -> Bool {
  std.witness_admission.witness_consumer_cadence_eq(a: a.path_classification, b: b.path_classification)
    && (std.measure.millisecond_count(m: a.wall_budget) == std.measure.millisecond_count(m: b.wall_budget))
    && (std.measure.millisecond_count(m: a.max_staleness) == std.measure.millisecond_count(m: b.max_staleness))
}

fn witness_cost_basis_wellformed(basis: std.realization_schedule.WitnessCostBasis) -> Bool {
  match basis {
    std.realization_schedule.MeasuredAtExactSubject { clock: _, duration, receipt } =>
      std.measure.millisecond_count(m: duration) > 0 && receipt != ""
    std.realization_schedule.EstimatedFromSiblingClass { clock: _, source_witness, basis } =>
      source_witness != "" && basis != ""
  }
}

fn scheduled_witness_envelope_wellformed(envelope: std.realization_schedule.ScheduledWitnessEnvelope) -> Bool {
  std.measure.millisecond_count(m: envelope.wall_budget) > 0
}

fn witness_span_eq(a: std.realization_schedule.WitnessSpan, b: std.realization_schedule.WitnessSpan) -> Bool {
  match a {
    std.realization_schedule.SpanUndeclared => match b {
      std.realization_schedule.SpanUndeclared => true
      std.realization_schedule.SpanSeams { seams: _ } => false
      std.realization_schedule.SpanEnrolled { seams: _, cost_basis: _, envelope: _ } => false
    }
    std.realization_schedule.SpanSeams { seams } => match b {
      std.realization_schedule.SpanUndeclared => false
      std.realization_schedule.SpanSeams { seams: other } => witness_seam_lists_eq(left: seams, right: other)
      std.realization_schedule.SpanEnrolled { seams: _, cost_basis: _, envelope: _ } => false
    }
    std.realization_schedule.SpanEnrolled { seams, cost_basis, envelope } => match b {
      std.realization_schedule.SpanUndeclared => false
      std.realization_schedule.SpanSeams { seams: _ } => false
      std.realization_schedule.SpanEnrolled {
        seams: other_seams,
        cost_basis: other_basis,
        envelope: other_envelope
      } =>
        witness_seam_lists_eq(left: seams, right: other_seams)
          && witness_cost_basis_eq(a: cost_basis, b: other_basis)
          && scheduled_witness_envelope_eq(a: envelope, b: other_envelope)
    }
  }
}

fn commit_check_kind_eq(a: CommitCheckKind, b: CommitCheckKind) -> Bool {
  match a {
    CommitSpecGate { gate } => match b {
      CommitSpecGate { gate: other } => gate_eq(a: gate, b: other)
      CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => false
      CommitCargoFmtCheck => false
    }
    CommitWitnessClaim { entry, check_fns, kind, span } => match b {
      CommitSpecGate { gate: _ } => false
      CommitWitnessClaim {
        entry: other_entry,
        check_fns: other_fns,
        kind: other_kind,
        span: other_span
      } =>
        entry == other_entry
          && std.realization_schedule.string_list_eq(left: check_fns, right: other_fns)
          && std.realization_schedule.witness_kind_eq(a: kind, b: other_kind)
          && witness_span_eq(a: span, b: other_span)
      CommitCargoFmtCheck => false
    }
    CommitCargoFmtCheck => match b {
      CommitSpecGate { gate: _ } => false
      CommitWitnessClaim { entry: _, check_fns: _, kind: _, span: _ } => false
      CommitCargoFmtCheck => true
    }
  }
}

fn declaration_field_is_whole(field: std.decl_ref.DeclField) -> Bool {
  match field {
    std.decl_ref.WholeDeclaration => true
    std.decl_ref.NamedField { field_name: _ } => false
  }
}

fn declaration_refs_unique(declarations: List<std.decl_ref.DeclarationRef>) -> Bool {
  if declarations.count() == 0 {
    true
  } else {
    !std.decl_ref.declaration_ref_in_list(
      target: declarations.first(),
      refs: declarations.skip(n: 1)
    ) && declaration_refs_unique(declarations: declarations.skip(n: 1))
  }
}

fn declaration_ref_lists_eq(left: List<std.decl_ref.DeclarationRef>, right: List<std.decl_ref.DeclarationRef>) -> Bool {
  declaration_refs_unique(declarations: left)
    && declaration_refs_unique(declarations: right)
    && left.count() == right.count()
    && fold(left, init: true, f: fn(acc, declaration) {
      acc && std.decl_ref.declaration_ref_in_list(target: declaration, refs: right)
    })
    && fold(right, init: true, f: fn(acc, declaration) {
      acc && std.decl_ref.declaration_ref_in_list(target: declaration, refs: left)
    })
}

fn commit_check_count(check: CommitCheckKind, roster: List<CommitCheckEnrollment>) -> Int {
  filter(roster, row => commit_check_kind_eq(a: check, b: row.check)).count()
}

fn demand_check_count(check: CommitCheckKind, rows: List<EnrollmentWitnessDemand>) -> Int {
  filter(rows, row => commit_check_kind_eq(a: check, b: row.check)).count()
}

fn first_duplicate_commit_check(roster: List<CommitCheckEnrollment>) -> DuplicateCommitCheck {
  if roster.count() == 0 {
    NoDuplicateCommitCheck
  } else if commit_check_count(check: roster.first().check, roster: roster) > 1 {
    DuplicateCommitCheckFound { check: roster.first().check }
  } else {
    first_duplicate_commit_check(roster: roster.skip(n: 1))
  }
}

fn demand_rows_match_roster(
  roster: List<CommitCheckEnrollment>,
  rows: List<EnrollmentWitnessDemand>,
) -> Bool {
  roster.count() == rows.count()
    && fold(roster, init: true, f: fn(acc, enrollment) {
      acc && demand_check_count(check: enrollment.check, rows: rows) == 1
    })
    && fold(rows, init: true, f: fn(acc, row) {
      acc && commit_check_count(check: row.check, roster: roster) == 1
    })
}

fn discovery_entry(discovery: EntryDeclarationDiscovery) -> String {
  match discovery {
    DiscoveryComplete { entry, module_path: _, declarations: _ } => entry
    DiscoveryIncomplete { entry, cause: _ } => entry
  }
}

fn discoveries_for_entry(
  entry: String,
  discoveries: List<EntryDeclarationDiscovery>,
) -> List<EntryDeclarationDiscovery> {
  filter(discoveries, discovery => discovery_entry(discovery: discovery) == entry)
}

fn roster_references_discovery_entry(
  entry: String,
  roster: List<CommitCheckEnrollment>,
) -> Bool {
  fold(roster, init: false, f: fn(found, enrollment) {
    found || match enrollment.check {
      CommitWitnessClaim { entry: candidate, check_fns: _, kind: _, span: _ } =>
        candidate == entry
      CommitSpecGate { gate: _ } => false
      CommitCargoFmtCheck => false
    }
  })
}

fn discoveries_are_roster_scoped(
  roster: List<CommitCheckEnrollment>,
  discoveries: List<EntryDeclarationDiscovery>,
) -> Bool {
  fold(discoveries, init: true, f: fn(scoped, discovery) {
    scoped && roster_references_discovery_entry(
      entry: discovery_entry(discovery: discovery),
      roster: roster
    )
  })
}

fn complete_discovery_module_count(
  module_path: std.types.NonEmptyStr,
  discoveries: List<EntryDeclarationDiscovery>,
) -> Int {
  filter(discoveries, discovery => match discovery {
    DiscoveryComplete { entry: _, module_path: candidate, declarations: _ } =>
      candidate == module_path
    DiscoveryIncomplete { entry: _, cause: _ } => false
  }).count()
}

fn discovery_declarations_well_formed(
  module_path: std.types.NonEmptyStr,
  declarations: List<std.decl_ref.DeclarationRef>,
) -> Bool {
  declaration_refs_unique(declarations: declarations)
    && fold(declarations, init: true, f: fn(acc, declaration) {
      acc
        && declaration.module_path == module_path
        && declaration_field_is_whole(field: declaration.field)
    })
}

fn declaration_matches_name(declaration: std.decl_ref.DeclarationRef, name: String) -> Bool {
  (declaration.decl_name as String) == name
}

fn project_named_declaration_demands(
  names: List<String>,
  declarations: List<std.decl_ref.DeclarationRef>,
) -> NamedDeclarationDemandOutcome {
  if names.count() == 0 {
    NamedDeclarationsQualified { declarations: [] }
  } else {
    let matching = filter(
      declarations,
      declaration => declaration_matches_name(declaration: declaration, name: names.first())
    )
    if matching.count() == 0 {
      NamedDeclarationMissing {
        cause: "named witness declaration is absent from complete discovery" as std.types.NonEmptyStr
      }
    } else if matching.count() > 1 {
      NamedDeclarationAmbiguous {
        cause: "named witness declaration has duplicate discovery identities" as std.types.NonEmptyStr
      }
    } else {
      match project_named_declaration_demands(
        names: names.skip(n: 1),
        declarations: declarations
      ) {
        NamedDeclarationMissing { cause } => NamedDeclarationMissing { cause: cause }
        NamedDeclarationAmbiguous { cause } => NamedDeclarationAmbiguous { cause: cause }
        NamedDeclarationsQualified { declarations: rest } =>
          let selected = concat([matching.first()], rest)
          if declaration_refs_unique(declarations: selected) {
            NamedDeclarationsQualified { declarations: selected }
          } else {
            NamedDeclarationAmbiguous {
              cause: "named witness demand repeats one declaration identity" as std.types.NonEmptyStr
            }
          }
      }
    }
  }
}

fn project_one_enrollment_witness_demand(
  check: CommitCheckKind,
  discoveries: List<EntryDeclarationDiscovery>,
) -> SingleEnrollmentDemandOutcome {
  match check {
    CommitSpecGate { gate: _ } =>
      SingleDemandQualified {
        row: EnrollmentWitnessDemand { check: check, declarations: [] }
      }
    CommitCargoFmtCheck =>
      SingleDemandQualified {
        row: EnrollmentWitnessDemand { check: check, declarations: [] }
      }
    CommitWitnessClaim { entry, check_fns, kind: _, span: _ } =>
      let matching = discoveries_for_entry(entry: entry, discoveries: discoveries)
      if matching.count() == 0 {
        SingleDemandMissing {
          cause: "witness enrollment has no supplied declaration discovery" as std.types.NonEmptyStr
        }
      } else if matching.count() > 1 {
        SingleDemandAmbiguous {
          cause: "witness enrollment has duplicate discovery entries" as std.types.NonEmptyStr
        }
      } else {
        fold(
          matching,
          init: SingleDemandMissing {
            cause: "singleton discovery fold produced no row" as std.types.NonEmptyStr
          },
          f: fn(_prior, discovery) {
            match discovery {
              DiscoveryIncomplete { entry: _, cause } =>
                SingleDemandIncomplete { cause: cause }
              DiscoveryComplete { entry: _, module_path, declarations } =>
                if complete_discovery_module_count(
                  module_path: module_path,
                  discoveries: discoveries
                ) > 1 {
                  SingleDemandAmbiguous {
                    cause: "complete discoveries repeat one module identity" as std.types.NonEmptyStr
                  }
                } else if declarations.count() == 0 {
                  SingleDemandMissing {
                    cause: "complete witness discovery contains no declarations" as std.types.NonEmptyStr
                  }
                } else if !discovery_declarations_well_formed(
                  module_path: module_path,
                  declarations: declarations
                ) {
                  SingleDemandAmbiguous {
                    cause: "complete discovery contains invalid or duplicate declaration identities" as std.types.NonEmptyStr
                  }
                } else if check_fns.count() == 0 {
                  SingleDemandQualified {
                    row: EnrollmentWitnessDemand {
                      check: check,
                      declarations: declarations
                    }
                  }
                } else {
                  match project_named_declaration_demands(
                    names: check_fns,
                    declarations: declarations
                  ) {
                    NamedDeclarationMissing { cause } => SingleDemandMissing { cause: cause }
                    NamedDeclarationAmbiguous { cause } => SingleDemandAmbiguous { cause: cause }
                    NamedDeclarationsQualified { declarations: selected } =>
                      SingleDemandQualified {
                        row: EnrollmentWitnessDemand {
                          check: check,
                          declarations: selected
                        }
                      }
                  }
                }
            }
          }
        )
      }
  }
}

fn demand_row_overlaps(
  row: EnrollmentWitnessDemand,
  rows: List<EnrollmentWitnessDemand>,
) -> Bool {
  fold(row.declarations, init: false, f: fn(overlaps, declaration) {
    overlaps || fold(rows, init: false, f: fn(found, other) {
      found || std.decl_ref.declaration_ref_in_list(
        target: declaration,
        refs: other.declarations
      )
    })
  })
}

fn project_enrollment_witness_demands_unchecked(
  roster: List<CommitCheckEnrollment>,
  discoveries: List<EntryDeclarationDiscovery>,
) -> EnrollmentDemandOutcome {
  if roster.count() == 0 {
    DemandQualified { rows: [] }
  } else {
    let check = roster.first().check
    match project_one_enrollment_witness_demand(
      check: check,
      discoveries: discoveries
    ) {
      SingleDemandMissing { cause } => DemandMissing { check: check, cause: cause }
      SingleDemandAmbiguous { cause } => DemandAmbiguous { check: check, cause: cause }
      SingleDemandIncomplete { cause } => DemandIncomplete { check: check, cause: cause }
      SingleDemandQualified { row } =>
        match project_enrollment_witness_demands_unchecked(
          roster: roster.skip(n: 1),
          discoveries: discoveries
        ) {
          DemandMissing { check: failed, cause } =>
            DemandMissing { check: failed, cause: cause }
          DemandAmbiguous { check: failed, cause } =>
            DemandAmbiguous { check: failed, cause: cause }
          DemandIncomplete { check: failed, cause } =>
            DemandIncomplete { check: failed, cause: cause }
          DemandRosterAmbiguous { cause } =>
            DemandRosterAmbiguous { cause: cause }
          DemandQualified { rows } =>
            if demand_row_overlaps(row: row, rows: rows) {
              DemandAmbiguous {
                check: check,
                cause: "declaration identity belongs to multiple enrollment demands" as std.types.NonEmptyStr
              }
            } else {
              DemandQualified { rows: concat([row], rows) }
            }
        }
    }
  }
}

fn project_enrollment_witness_demands(
  discoveries: List<EntryDeclarationDiscovery>,
) -> EnrollmentDemandOutcome {
  let roster = commit_gate_roster
  if !discoveries_are_roster_scoped(roster: roster, discoveries: discoveries) {
    DemandRosterAmbiguous {
      cause: "declaration discovery has no owning witness enrollment" as std.types.NonEmptyStr
    }
  } else {
    match first_duplicate_commit_check(roster: roster) {
    DuplicateCommitCheckFound { check } =>
      DemandAmbiguous {
        check: check,
        cause: "commit check roster contains a duplicate typed identity" as std.types.NonEmptyStr
      }
    NoDuplicateCommitCheck =>
      match project_enrollment_witness_demands_unchecked(
        roster: roster,
        discoveries: discoveries
      ) {
        DemandMissing { check, cause } => DemandMissing { check: check, cause: cause }
        DemandAmbiguous { check, cause } =>
          DemandAmbiguous { check: check, cause: cause }
        DemandIncomplete { check, cause } =>
          DemandIncomplete { check: check, cause: cause }
        DemandRosterAmbiguous { cause } =>
          DemandRosterAmbiguous { cause: cause }
        DemandQualified { rows } =>
          if demand_rows_match_roster(roster: roster, rows: rows) {
            DemandQualified { rows: rows }
          } else {
            DemandIncomplete {
              check: roster.first().check,
              cause: "projected demand check set does not equal input roster" as std.types.NonEmptyStr
            }
          }
    }
  }
}
}

fn witness_seam_wellformed(seam: std.realization_schedule.WitnessSeam) -> Bool {
  !(seam.producer == seam.consumer)
}

fn seam_list_contains(seams: List<std.realization_schedule.WitnessSeam>, seam: std.realization_schedule.WitnessSeam) -> Bool {
  fold(seams, init: false, f: fn(acc, s) { acc || witness_seam_eq(a: s, b: seam) })
}

fn seams_wellformed_and_distinct(seams: List<std.realization_schedule.WitnessSeam>) -> Bool {
  if seams.count() == 0 {
    true
  } else {
    witness_seam_wellformed(seam: seams.first())
      && !seam_list_contains(seams: seams.skip(n: 1), seam: seams.first())
      && seams_wellformed_and_distinct(seams: seams.skip(n: 1))
  }
}

fn witness_span_wellformed(span: std.realization_schedule.WitnessSpan) -> Bool {
  match span {
    std.realization_schedule.SpanUndeclared => true
    std.realization_schedule.SpanSeams { seams } => seams.count() > 0 && seams_wellformed_and_distinct(seams: seams)
    std.realization_schedule.SpanEnrolled { seams, cost_basis, envelope } =>
      seams.count() > 0
        && seams_wellformed_and_distinct(seams: seams)
        && witness_cost_basis_wellformed(basis: cost_basis)
        && scheduled_witness_envelope_wellformed(envelope: envelope)
  }
}

fn roster_witness_spans_wellformed(roster: List<CommitCheckEnrollment>) -> Bool {
  fold(roster, init: true, f: fn(acc, row) {
    match row.check {
      CommitWitnessClaim { entry: _, check_fns: _, kind: _, span } =>
        acc && witness_span_wellformed(span: span)
      CommitSpecGate { gate: _ } => acc
      CommitCargoFmtCheck => acc
    }
  })
}

fn local_tidy_check_eq(a: LocalTidyCheck, b: LocalTidyCheck) -> Bool {
  match a {
    LocalTidyWitnessCheck { entry, check_fns } =>
      match b {
        LocalTidyWitnessCheck { entry: entry2, check_fns: check_fns2 } =>
          entry == entry2 && std.realization_schedule.string_list_eq(left: check_fns, right: check_fns2)
        _ => false
      }
    LocalTidyCargoFmtCheck =>
      match b { LocalTidyCargoFmtCheck => true  _ => false }
  }
}

fn project_local_tidy_checks(roster: List<CommitCheckEnrollment>) -> List<LocalTidyCheck> {
  let pre_push = filter(roster, e => enrollment_has_surface(e: e, surface: GitPrePushHook))
  concat(
    project_local_tidy_witness_rows(roster: pre_push),
    project_local_tidy_fmt_rows(roster: pre_push)
  )
}

fn project_local_tidy_witness_rows(roster: List<CommitCheckEnrollment>) -> List<LocalTidyCheck> {
  fold(roster, init: [], f: fn(acc, row) {
    match row.check {
      CommitWitnessClaim { entry, check_fns, kind: _, span: _ } =>
        concat(acc, [LocalTidyWitnessCheck { entry: entry, check_fns: check_fns }])
      CommitSpecGate { gate: _ } => acc
      CommitCargoFmtCheck => acc
    }
  })
}

fn project_local_tidy_fmt_rows(roster: List<CommitCheckEnrollment>) -> List<LocalTidyCheck> {
  fold(roster, init: [], f: fn(acc, row) {
    match row.check {
      CommitCargoFmtCheck => concat(acc, [LocalTidyCargoFmtCheck])
      _ => acc
    }
  })
}

fn gate_lists_eq(left: List<gunbc.ci_gate.Gate>, right: List<gunbc.ci_gate.Gate>) -> Bool {
  if length(left) != length(right) {
    false
  } else if length(left) == 0 {
    true
  } else if !gate_eq(a: left.first(), b: right.first()) {
    false
  } else {
    gate_lists_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn local_tidy_lists_eq(left: List<LocalTidyCheck>, right: List<LocalTidyCheck>) -> Bool {
  if length(left) != length(right) {
    false
  } else if length(left) == 0 {
    true
  } else if !local_tidy_check_eq(a: left.first(), b: right.first()) {
    false
  } else {
    local_tidy_lists_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

data commit_workflow_ci_floor_gates: List<gunbc.ci_gate.Gate> = project_ci_floor_gates(roster: commit_gate_roster)

data commit_workflow_local_tidy_checks: List<LocalTidyCheck> = project_local_tidy_checks(roster: commit_gate_roster)

fn ci_floor_commit_witness_claim_schedule() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  project_ci_floor_witness_entries(roster: commit_gate_roster)
}

fn realization_artifact_path(surface: CommitWorkflowSurface) -> String {
  match surface {
    GithubActionsCiJob => ci_surface_artifact_wiped
    GitPrePushHook => artifact_path(a: GithooksPrePushArtifact)
    FalsifierCadenceJob => ci_surface_artifact_wiped
  }
}

fn realization_handler_for_surface(surface: CommitWorkflowSurface) -> CommitWorkflowRealizationKind {
  match surface {
    GithubActionsCiJob => CiYamlHandler
    GitPrePushHook => GitPrePushScriptHandler
    FalsifierCadenceJob => CiYamlHandler
  }
}

// The CI surfaces have NO generated artifact as of the 2026-08-15 wipe: ci.yml, falsifier.yml and
// falsifier-alert.yml are deleted and their registry rows are gone, so there is nothing for these
// three surfaces to name. The enrollment rows below are retained deliberately -- they ARE the
// obligations ledger the re-add queue is drawn from -- but a surface with no artifact answers the
// sentinel rather than a fabricated one, and the total function is gone rather than returning a
// plausible wrong artifact.
data ci_surface_artifact_wiped: String = "<wiped 2026-08-15: no generated artifact for this surface>"

fn realization_artifact_for_surface(surface: CommitWorkflowSurface) -> gunbc.generated_artifact.GeneratedArtifact? {
  match surface {
    GithubActionsCiJob => none
    GitPrePushHook => Present { value: GithooksPrePushArtifact }
    FalsifierCadenceJob => none
  }
}

data commit_workflow_long_lane_note: String = "Two complexity-lens enrollments (fold_lowering_test, accumulator_copy_fold_analysis_test) DELETED from the GithubActionsCiJob surface 2026-07-12: their check_fns measured over the fast-lane 5-second witness eval budget (operator rule; authority gunbc_ci_fast_lane_rule_note in v2.workflow.ci_floor_plan), and an explicit enrollment row bypasses discovery exclusion, so re-pathing the row to test/claim/long/ would keep the over-budget rows on every PR. Offlining an explicit row means deleting its declaration, never teaching exclusions to veto the roster (the enforcement-coverage precedent in gunbc.ci_layer_roots). The files live under src/v2/test/claim/long/ with the local recipe; dissolve-on: the long-lane scheduled trigger (falsifier follow-on) enrolls them and this note retires. Contrast: the parse_table_memo_governed enrollment above was REPOINTED to its long/ home, not deleted — its four enrolled check_fns each measured 0ms (audit 2026-07-12); only unenrolled siblings in that file (warm_equals_cold) are over budget, and an explicit row runs exactly its named check_fns. Delete when the enrolled fns themselves are slow; repoint when only the file moved. Wave 1 gunbc.ci_gate.Gate 1 body-producer keystones (wave1_gate1_b1_bare_call_body_producer_witness_test.dag, wave1_gate1_a1_symbol_index_body_producer_witness_test.dag — five enrolled check_fns, ~5s+ each under floor load) were DELETED 2026-07-14 for the same reason: explicit rows bypass test/claim/long/ discovery exclusion, so affected-set selection on PRs touching target_model.dag (live case #6589) enrolled them into the 5s fast lane and REDed at EvalBudgetExceeded (~5013ms). Fast receipts stay in self_host/ (discovered); execution proofs stay in long/ (local recipe: claim_batch --source-root dag --source-root src/v2 --entry <file> --functions <csv>). Separately, two rows (parse_test floor/perf, dag_compile_clean_perturb_receipts) were DELETED 2026-07-12 as §3 de-duplication, not offlining: the same check_fns are declared in gunbc.ci_layer_roots bin_witness_wet_entries (the Wet bin-execution lane), and the double enrollment ran them a second time inside the HERMETIC corpus batch, where their run_witness_bin host effects refuse (CI receipt: run 29208529942, IsExecutable refusals). One fact, one roster: the bin lane keeps the per-PR coverage."

data wave1_gate1_d_census_class_c_split_note: String = "wave1_gate1_d_census (test-decomposition-wcf-cut.md Class C row, ~141s measured) split 2026-07-25: attribution-by-execution (claim_batch, cold) showed the census's ENROLLED per-PR check_fn ran a witness wall of 134526ms against a one-time 32034ms entry-closure resolve — the cost lives in the witness body itself, which builds 10 ingested_fixture_arrows fixtures (each a real tokenize->parse_module->normalize->resolve pass) across two aggregator fns; this is genuine corpus breadth (Class C), not a fixture-shaped cost-shape defect (Class F ruled out by measurement, not by assumption). The mechanism-only sibling (self_host/wave1_gate1_d_mvp_subsumption_witness_test.dag's five table_fixture check_fns, measured eval_self=0.000ms each on a cold run — proves Arrow+body well-formedness/behavior-kind mechanism via table_fixture producers, no census ingest) carries no explicit CommitCheckEnrollment here: it is already picked up per-PR by the source-root *_test.dag discovery walk (ci_spec_discovery_flip_note), so an explicit roster row would be a second, redundant admission path for the same std.witness_admission.DiscoverySelection-covered file — a §3 duplication, not an accept requirement (a check_fn that is unconditionally discovered needs no roster entry to run). The real census-ingest execution (wave1_gate1_d_census_subsumption_witness_holds, long/wave1_gate1_d_mvp_subsumption_witness_test.dag) is re-homed off per-PR discovery onto the falsifier's 4-hourly cadence as one more row on falsifier_substrate_long_lane_entries (v2.workflow.ci_floor_plan gunbc_falsifier_substrate_long_lane_batch; frontier row in gunbc.ci_layer_roots falsifier_substrate_long_lane_rows, joining the sibling provenance-producer rows from PR #7230/test-decomposition-wcf-cut.md) — the single hermetic long-lane falsifier consumer for this witness class, not a parallel batch: this witness is std.realization_schedule.ExecutionWitnessKind/SubstrateInputsOnly interpreted computation with no host effects, so folding it into the subprocess-execution Wet lane (falsifier_rehomed_bin_wet_batch) would be a §3 nickname. A WitnessExclusionRow (pattern \"long/wave1_gate1_d_mvp_subsumption_witness_test.dag\", classification std.witness_admission.FalsifierSubstrateLongLane) carves the file out of per-PR discovery so the classification is honest, not a lie against an unhandled default. Enrolled, but NOT unconditionally executed — the original claim here ('the row always executes on the 4-hourly cadence') was falsified by the lane's first scheduled run (30176416535, 2026-07-25) and is corrected 2026-07-26: batch 6 declares node_frontier_selection: SelectionApplied and the falsifier diffs GUNBC_CI_DIFF_BASE=HEAD~20, so affected-set selection — a per-PR mechanism, like the fast-lane eval budget that mis-scoped onto the same lane — also applies here. That run reported '10 witness(es) across 3 entr(y/ies) · 1 unaffected (import-closure, skipped without resolve) · 9 in the affected closure' and emitted result lines for only 7: this census row and the two edit_locus rows produced NO receipt and were counted as not-failed. So the honest statement is that enrollment is non-empty and the row executes on the cadences where the last 20 commits touch its closure; a silent skip is indistinguishable from a pass in the batch tally today. Whether this lane should run SelectionOff (unconditional coverage, ~127-135s per cadence for this row alone) is an open cost/cadence decision, not settled here. Dissolve-on: the census ingest's per-fixture pipeline cost drops under the per-PR fast-lane budget on a measured cold run (e.g. shared parse-table/resolve memoization landing for this closure) — then re-enroll wave1_gate1_d_census_subsumption_witness_holds per-PR discovery and delete the falsifier_substrate_long_lane_rows entry, the exclusion row, and this note."
