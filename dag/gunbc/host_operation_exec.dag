module gunbc.host_operation_exec

import std.types { String, NonEmptyStr, List, Bool }
import extdeps.systemd.systemctl
import extdeps.systemd { SystemdUnitProperty, systemd_unit_property_wire }
import extdeps.tools.hostname
import gunbc.host_effect {
  HostEffectTransport,
  LocalShell,
  SshShell,
  FleetSsh,
  EmitArtifactThenThinRun,
}
import gunbc.fleet_known_hosts_anchor { FleetSshExecutionContext, SshTarget }
import gunbc.typed_argv_exec {
  typed_argv_exec_over_fleet_ssh,
  typed_argv_exec_over_ssh,
  TypedArgvExecOutcome,
  TypedArgvExecConverged,
  TypedArgvExecRefused,
}
import v2.std.operation_argv {
  ArgvMaterialization,
  ArgvMaterialized,
  ArgvMaterializationRefused,
  BoundOperationInvocation,
  OperationRef,
  bind_operation_invocation,
  operation_argv_bind_text,
  operation_argv_cause_label,
  operation_ref_label,
}

// THE DEFECT THIS MODULE EXISTS TO REMOVE, stated once here rather than repeated at each caller.
//
// gunbc.typed_argv_exec exposes typed_argv_exec_over_ssh and typed_argv_exec_over_fleet_ssh and NO
// TOTAL ENTRY POINT, so every caller that wanted to run one operation somewhere was forced to write
// the transport match itself. Six one-tool domain reads did exactly that -- four arms each, the same
// four arms, differing only in an argv row and a decoder. That is the N x M adapter structure DESIGN
// section 3 forbids at an interface/realization seam, and it was MANUFACTURED BY AN INTERFACE THAT
// DECLINED TO BE TOTAL: an interface offering only per-realization doors pushes its own dispatch
// into every caller. Six copies is what that cost.
//
// So the direction is the one section 3 fixes: THE DISPATCH THAT SELECTS A REALIZATION IS ITSELF
// REALIZATION. It sits here, once, peripheral to every domain caller. A caller now says WHERE (a
// transport it genuinely knows -- which host) and WHAT (a HostOperation). It never says HOW.

// THE NATIVE LEG, AND WHY IT IS A COPRODUCT RATHER THAN A CLOSURE.
//
// Three of the four legs consume argv materialized from an operation's declaration. The LocalShell
// leg does not: it invokes the modeled operation itself, and the interpreter runs that operation's
// own declared shell transport. The obvious way to carry that difference is a closure the caller
// hands over -- and it is the wrong way on the one axis this program is about. An opaque closure
// cannot be inspected, refused, cost-attributed or emitted, so the local leg would become the single
// realization the substrate cannot see, inside the function built to make realization visible.
//
// 🟡 DECLARED DEBT, NOT A MODELING IMPROVEMENT: `SystemctlIsActive { unit }` is a SECOND NAMING of
// `systemd.Systemctl.IsActive(unit:)`, which extdeps already declares with its own cited transport.
// That is the nicknaming violation of section 3, inside a diff whose subject is a section 3
// violation, and it is admitted here only because the thing that dissolves it is named exactly.
// The interpreter already dispatches local execution BY REIFIED IDENTITY: eval_service_call resolves
// (service, operation) as a string key against its service_ops index, and
// shell_materialize_operation_argv takes that same (path, service, operation, bindings) triple. The
// two legs want ONE description. What is missing is only a .dag-level way to INVOKE by that triple --
// there is no free-function sibling of shell_materialize_operation_argv, and no generic local
// process-exec service exists in this corpus either (no `service Process`, no local `Exec`; the only
// Exec/ExecArgv operations declared anywhere are ssh.Session's).
//
// 🟡 dissolve-on: WHEN an invoke-by-triple sibling of shell_materialize_operation_argv exists,
// LocalInvocation dissolves into the identity triple already carried by HostOperation, this
// coproduct is DELETED, and host_operation_exec_local stops matching at all. The condition is the
// builtin's existence, NOT a permission to build it: if the v2 self-host program needs
// invoke-by-triple for its own reasons, the v1 freeze admits it on the purpose test and this
// dissolution fires without anyone re-litigating transport ownership.
//
// CLOSED OVER MODELED OPERATIONS, DELIBERATELY. Every variant names an operation declared in
// extdeps. There is no variant carrying a free-form command, argv or script, so this coproduct
// CANNOT express a local invocation that is not a modeled operation -- the property the corpus
// currently has (local execution happens only through a declared operation's transport) survives
// this cut rather than being quietly opened by it.
type LocalInvocation =
    SystemctlIsActive { unit: NonEmptyStr }
  | SystemctlStatus { unit: NonEmptyStr }
  | SystemctlStop { unit: NonEmptyStr }
  | SystemctlShowProperty { unit: NonEmptyStr, property: SystemdUnitProperty }
  | HostnameReadShort

// ONE SEMANTIC OPERATION, DESCRIBED. `native` is a required field, so an operation that forgets its
// local leg is UNREPRESENTABLE rather than merely detected -- there is no HostOperation to construct
// without one. What this shape does NOT prevent is a WRONG native leg: nothing here relates
// the invocation's OperationRef to the variant, so SystemctlIsActive paired with the Status
// bindings constructs cleanly. That gap is stated rather than papered over -- see
// host_operation_native_leg_agreement below for the rung and the executing guard.
//
// The identity half is NOT minted here. v2.std.operation_argv already declares
// BoundOperationInvocation as exactly an OperationRef paired with declaration-owned bindings, and
// shell_materialize_operation_argv already consumes it; re-spelling path/service/operation/bindings
// as fields of this record would have been a second naming of that carrier -- the section 3
// violation this diff is removing, re-committed in the diff removing it.
type HostOperation sole_constructor {
  invocation: BoundOperationInvocation
  native: LocalInvocation
}

// THE ONE MINT, AND WHY THE CARRIER IS SEALED. Without the seal, `host_operation_native_leg_agrees`
// below is a LENS OVER FIVE HAND-LISTED OPERATIONS rather than a wall: nothing in production consults
// it, so a sixth operation added next month pairs an identity with a variant, `host_operation_exec`
// runs the mispairing without complaint, and the five green rows stay green. That is the
// coverage-by-illusion tier DESIGN section 6 names -- machinery that exists while nothing gates on it.
//
// Sealing does not make a mispairing impossible; it makes it AUTHORABLE ONLY INSIDE A REVIEWED
// FUNCTION. A record literal cannot be written wherever a record literal can be written, so adding a
// sixth operation is an edit to the admit list in this file -- a conspicuous, counted review event --
// rather than an import a caller writes in their own. This is the mechanism extdeps.exec.command
// `argv_command` already established in this repository, used here for the same reason.
//
// ONE DEPARTURE FROM THAT PRECEDENT, STATED RATHER THAN SLIPPED IN. `argv_command`'s annotation says
// no test declaration is admitted, because a witness there would obtain a VALID value by a route
// production lacks. The admission below is the opposite case: the witness's whole purpose is to author
// an INVALID PAIRING, which is exactly the regression probe DESIGN section 4b says must stay
// authorable -- "a compiler is precisely a thing whose regression probes are invalid programs", and
// reachability is judged against what a FIXTURE MAY AUTHOR. Refusing the admission would delete the
// only discriminating RED this guard has, and the alternative home for such a probe
// (compile_dag_diagnostic_census, the sole-constructor-cross-module class) sits in the required
// floor's DeclinedLiveTree arm and DOES NOT EXECUTE -- so moving the red there would trade an
// executing probe for a specification, which is the trap section 5 names.
//
// WHAT THE ADMISSION COSTS, stated so it is not read as free: the seal holds against every module in
// the corpus except this one witness. That is one named, reviewed exception carrying an executing
// red, not a general opening.
fn host_operation(invocation: BoundOperationInvocation, native: LocalInvocation) -> HostOperation
  admit_callers: [
    decl_ref(module_path: "gunbc.host_operation_exec", decl_name: "systemctl_is_active_host_operation"),
    decl_ref(module_path: "gunbc.host_operation_exec", decl_name: "systemctl_status_host_operation"),
    decl_ref(module_path: "gunbc.host_operation_exec", decl_name: "systemctl_stop_host_operation"),
    decl_ref(module_path: "gunbc.host_operation_exec", decl_name: "systemctl_show_property_host_operation"),
    decl_ref(module_path: "gunbc.host_operation_exec", decl_name: "hostname_read_short_host_operation"),
    decl_ref(module_path: "test.claim.host_operation_native_leg_witness", decl_name: "mispaired_host_operation"),
  ]
  = HostOperation { invocation: invocation, native: native }

// THE OUTCOME IS DELIBERATELY NOT SshSessionExecResult. Three of the four legs produce one, but
// naming a local process observation after ssh would be a nickname in the return position, and the
// raw-process-observation confinement cut that follows this one needs a seam it can seal without
// re-pointing any caller. This type is that seam.
//
// stderr is OPTIONAL because it is not universally modeled: systemd.Systemctl.Stop declares a stderr
// output, while the readonly reads (IsActive, Status, ShowProperty, ReadShort) declare none. `none`
// means THIS OPERATION DOES NOT MODEL STDERR; it is not the empty string, and filling it with "" to
// make the record uniform would fabricate an observation nothing produced.
type HostOperationOutcome =
    HostOperationObserved { stdout: String, success: Bool, stderr: String? }
  | HostOperationRefused { operation: String, reason: String }

fn host_operation_label(operation: HostOperation) -> String {
  operation_ref_label(at: operation.invocation.at)
}

fn host_operation_materialize_argv(operation: HostOperation) -> ArgvMaterialization {
  shell_materialize_operation_argv(
    operation.invocation.at.path,
    operation.invocation.at.service,
    operation.invocation.at.operation,
    operation.invocation.bindings,
  )
}

fn host_operation_outcome_from_exec(
  operation: HostOperation,
  outcome: TypedArgvExecOutcome,
) -> HostOperationOutcome {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      HostOperationObserved { stdout: r.stdout, success: r.success, stderr: r.stderr }
    TypedArgvExecRefused { reason: why } =>
      HostOperationRefused { operation: host_operation_label(operation: operation), reason: why }
  }
}

fn host_operation_argv_refusal(operation: HostOperation, m: ArgvMaterialization) -> HostOperationOutcome {
  match m {
    ArgvMaterialized { argv: _ } =>
      HostOperationRefused {
        operation: host_operation_label(operation: operation),
        reason: "host_operation_argv_refusal called on a materialized argv",
      }
    ArgvMaterializationRefused { at: _, cause: c } =>
      HostOperationRefused {
        operation: host_operation_label(operation: operation),
        reason: operation_argv_cause_label(cause: c),
      }
  }
}

// THE LOCAL LEG. Every arm invokes the modeled operation and projects its declared outputs onto the
// common observation. The projections differ per operation because the DECLARATIONS differ -- IsActive
// names its stdout `state`, ShowProperty names it `value` -- and reading each from its own authority
// is what keeps this a projection rather than a second output schema.
fn host_operation_exec_local(native: LocalInvocation) -> HostOperationOutcome {
  match native {
    SystemctlIsActive { unit: u } => {
      let result = systemd.Systemctl.IsActive(unit: u)
      HostOperationObserved { stdout: result.state, success: result.active, stderr: none }
    }
    SystemctlStatus { unit: u } => {
      let result = systemd.Systemctl.Status(unit: u)
      HostOperationObserved { stdout: result.stdout, success: result.success, stderr: none }
    }
    SystemctlStop { unit: u } => {
      let result = systemd.Systemctl.Stop(unit: u)
      HostOperationObserved { stdout: result.stdout, success: result.success, stderr: result.stderr }
    }
    SystemctlShowProperty { unit: u, property: p } => {
      let result = systemd.Systemctl.ShowProperty(unit: u, property: p)
      HostOperationObserved { stdout: result.value, success: result.success, stderr: none }
    }
    HostnameReadShort => {
      let result = os.Hostname.ReadShort()
      HostOperationObserved { stdout: result.value, success: result.success, stderr: none }
    }
  }
}

// THE SSH LEG. typed_argv_exec_over_ssh applies the shell-safety allowlist; the fleet leg below does
// NOT, and that asymmetry is preserved rather than tidied. The two legs rest on DIFFERENT walls --
// this one on typed_argv_shell_safe_refusal_argv at the edge, the fleet one on portable_remote_words,
// which refuses INTO A TYPE -- so collapsing them into one pre-check would silently change behaviour
// on both.
fn host_operation_exec_ssh(operation: HostOperation, host: NonEmptyStr) -> HostOperationOutcome {
  let m = host_operation_materialize_argv(operation: operation)
  match m {
    ArgvMaterialized { argv: argv } =>
      host_operation_outcome_from_exec(
        operation: operation,
        outcome: typed_argv_exec_over_ssh(host: host, argv: argv),
      )
    ArgvMaterializationRefused { at: _, cause: _ } =>
      host_operation_argv_refusal(operation: operation, m: m)
  }
}

fn host_operation_exec_fleet_ssh(
  operation: HostOperation,
  target: SshTarget,
  context: FleetSshExecutionContext,
) -> HostOperationOutcome {
  let m = host_operation_materialize_argv(operation: operation)
  match m {
    ArgvMaterialized { argv: argv } =>
      host_operation_outcome_from_exec(
        operation: operation,
        outcome: typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: argv),
      )
    ArgvMaterializationRefused { at: _, cause: _ } =>
      host_operation_argv_refusal(operation: operation, m: m)
  }
}

// THE TOTAL ENTRY POINT. This is the whole point of the module: the four arms exist ONCE.
//
// The EmitArtifactThenThinRun refusal NAMES THE OPERATION, which is why HostOperation carries an
// identity and not merely bindings. A generic "refused" here would have erased which operation was
// refused -- a correctness distinction the six per-op copies each carried, and losing it would have
// made this a smaller replacement rather than a complete one.
fn host_operation_exec(transport: HostEffectTransport, operation: HostOperation) -> HostOperationOutcome {
  match transport {
    LocalShell => host_operation_exec_local(native: operation.native)
    SshShell { ssh_host: h } => host_operation_exec_ssh(operation: operation, host: h)
    FleetSsh { target: t, context: c } =>
      host_operation_exec_fleet_ssh(operation: operation, target: t, context: c)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      HostOperationRefused {
        operation: host_operation_label(operation: operation),
        reason: concat(
          host_operation_label(operation: operation),
          " refused EmitArtifactThenThinRun transport",
        ),
      }
  }
}

// THE WRONG-LEG GUARD, AND AN HONEST STATEMENT OF WHAT IT IS.
//
// HostOperation.native is required, so an operation with NO local leg is unrepresentable -- that half
// is structural and needs no check. The half that is NOT structural is a WRONG leg: nothing in the
// record relates the OperationRef to the variant, so SystemctlIsActive paired with the Status
// bindings constructs cleanly and would then read one operation over ssh and a different one locally.
// That is the failure that would actually happen, and it is silent in exactly the way section 5
// forbids -- both legs succeed, and they answer different questions.
//
// This is the guard, and it is a MAPPING, which is to say it is the same declared debt as the
// coproduct: it names each variant's operation a second time. It earns its place anyway, because the
// alternative is no wall at all, and because the two spellings now have to agree -- a pairing mistake
// reddens rather than executing. RUNG: mechanically preventable. The discriminating RED lives in
// dag/test/claim/host_operation_native_leg_witness_test.dag and asserts a DELIBERATELY MISPAIRED row
// is refused; per section 4b it stays enrolled after the wall lands rather than retiring.
//
// 🟡 dissolve-on: deleted with LocalInvocation, on the same condition. Once the local leg IS the
// identity triple there are no two names left to disagree.
fn local_invocation_operation_name(native: LocalInvocation) -> String {
  match native {
    SystemctlIsActive { unit: _ } => "IsActive"
    SystemctlStatus { unit: _ } => "Status"
    SystemctlStop { unit: _ } => "Stop"
    SystemctlShowProperty { unit: _, property: _ } => "ShowProperty"
    HostnameReadShort => "ReadShort"
  }
}

fn host_operation_native_leg_agrees(operation: HostOperation) -> Bool {
  local_invocation_operation_name(native: operation.native) == operation.invocation.at.operation
}

// THE OPERATION ROWS. One per converted seam, homed beside the executor that consumes them so that
// adding a seventh operation is ONE ROW HERE plus one variant above -- not four arms in a new file.
data systemctl_operation_path: String = "dag/extdeps/systemd/systemctl.dag"
data systemctl_operation_service: String = "systemd.Systemctl"
data hostname_operation_path: String = "dag/extdeps/tools/hostname.dag"
data hostname_operation_service: String = "os.Hostname"

fn systemctl_operation_ref(operation: String) -> OperationRef {
  OperationRef {
    path: systemctl_operation_path,
    service: systemctl_operation_service,
    operation: operation,
  }
}

fn systemctl_is_active_host_operation(unit: NonEmptyStr) -> HostOperation {
  host_operation(
    invocation: bind_operation_invocation(
      at: systemctl_operation_ref(operation: "IsActive"),
      bindings: [operation_argv_bind_text(name: "unit", text: unit as String)],
    ),
    native: SystemctlIsActive { unit: unit },
  )
}

fn systemctl_status_host_operation(unit: NonEmptyStr) -> HostOperation {
  host_operation(
    invocation: bind_operation_invocation(
      at: systemctl_operation_ref(operation: "Status"),
      bindings: [operation_argv_bind_text(name: "unit", text: unit as String)],
    ),
    native: SystemctlStatus { unit: unit },
  )
}

fn systemctl_stop_host_operation(unit: NonEmptyStr) -> HostOperation {
  host_operation(
    invocation: bind_operation_invocation(
      at: systemctl_operation_ref(operation: "Stop"),
      bindings: [operation_argv_bind_text(name: "unit", text: unit as String)],
    ),
    native: SystemctlStop { unit: unit },
  )
}

fn systemctl_show_property_host_operation(unit: NonEmptyStr, property: SystemdUnitProperty) -> HostOperation {
  host_operation(
    invocation: bind_operation_invocation(
      at: systemctl_operation_ref(operation: "ShowProperty"),
      bindings: [
        operation_argv_bind_text(name: "unit", text: unit as String),
        operation_argv_bind_text(
          name: "property",
          text: systemd_unit_property_wire(property: property) as String,
        ),
      ],
    ),
    native: SystemctlShowProperty { unit: unit, property: property },
  )
}

fn hostname_read_short_host_operation() -> HostOperation {
  host_operation(
    invocation: bind_operation_invocation(
      at: OperationRef {
        path: hostname_operation_path,
        service: hostname_operation_service,
        operation: "ReadShort",
      },
      bindings: [],
    ),
    native: HostnameReadShort,
  )
}
