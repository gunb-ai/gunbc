module gunbc.bmc_fan_alignment_standing_witness

import std.types { Bool, List }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.bmc_fan_alignment_standing {
  AlignmentAdmitsApplyEvaluation,
  AlignmentRefused,
  AlignmentStandingDuplicate,
  AlignmentStandingAbsent,
  BmcFanIntentAlignment,
  host_alignment_admission,
  HostBmcFanAlignmentStanding,
  IntentMatchesObservedProgram,
  ObservedProgramNotAdopted,
  ObservedProgramNotRepresentableByIntent,
  alignment_admits_apply_evaluation,
  fleet_bmc_fan_alignment_standings,
  host_alignment_admits_apply_evaluation,
}
import gunbc.bmc_fan_projection {
  BmcFanProjectionApplyRefused,
  BmcFanProjectionApplySuitable,
  BmcFanProjectionObservedProgramNotRepresentable,
  bmc_fan_policy_projection_apply_suitability,
}
import gunbc.fleet_bmc_state { srv4_bmc_fan_projection_capability }
import gunbc.fleet_bmc_observation { srv4_bmc_fan_converged_policy_observation }
import gunbc.fleet_intent_network {
  operator_host_srv1,
  operator_host_srv3,
  operator_host_srv4,
}

// THE HOSTS I RECONFIGURED BY HAND MUST REFUSE ACTUATION. This is the conjunct that makes the
// interlock real rather than declared: it fails the moment someone marks srv3 or srv4 adopted
// without the carrier having gained a shape for what they run.
fn hand_configured_hosts_refuse() -> Bool {
  !host_alignment_admits_apply_evaluation(standings: fleet_bmc_fan_alignment_standings, host: operator_host_srv3)
    && !host_alignment_admits_apply_evaluation(
      standings: fleet_bmc_fan_alignment_standings,
      host: operator_host_srv4,
    )
}

// AN UNEXAMINED HOST REFUSES TOO. srv1 was never touched, and that is precisely why it is not
// admitted: nobody has established that the intent describes it either.
fn unexamined_host_refuses() -> Bool {
  !host_alignment_admits_apply_evaluation(standings: fleet_bmc_fan_alignment_standings, host: operator_host_srv1)
}

// A HOST WITH NO ROW AT ALL REFUSES, rather than falling through to permitted. An empty roster
// is the state where writing is least safe, so the lookup's failure arm must not read as consent.
fn absent_standing_refuses() -> Bool {
  !host_alignment_admits_apply_evaluation(standings: [], host: operator_host_srv3)
}

// THE POSITIVE CONTROL, without which every conjunct above passes on a function that always
// returns false. A represented program IS admitted.
fn represented_program_is_admitted() -> Bool {
  alignment_admits_apply_evaluation(
    standing: HostBmcFanAlignmentStanding {
      host: operator_host_srv3,
      alignment: IntentMatchesObservedProgram,
    },
  )
}

// THE TWO REFUSING ARMS STAY DISTINGUISHABLE. They produce the same verdict today, so nothing
// about the OUTCOME would notice them collapsing - only their remedies differ, and that is
// exactly the kind of distinction that erodes silently.
fn refusal_arms_stay_separate() -> Bool {
  let unadopted: BmcFanIntentAlignment = ObservedProgramNotAdopted
  let unrepresentable: BmcFanIntentAlignment =
    ObservedProgramNotRepresentableByIntent { missing: "x" }
  let a = match unadopted {
    ObservedProgramNotAdopted => true
    other => false
  }
  let b = match unrepresentable {
    ObservedProgramNotRepresentableByIntent { missing } => missing == "x"
    other => false
  }
  a && b
}

// A DUPLICATE ROW REFUSES RATHER THAN LETTING AUTHORING ORDER DECIDE. Two rows for one host
// that disagree is a broken roster, and a first-match fold answers with whichever was typed
// first. The adversarial case is the one that matters: the duplicate says ADMITTED and is placed
// FIRST, so a first-match lookup returns admitted and the interlock opens.
data srv3_duplicated_as_admitted: List<HostBmcFanAlignmentStanding> = flat_map(
  [
    [
      HostBmcFanAlignmentStanding {
        host: operator_host_srv3,
        alignment: IntentMatchesObservedProgram,
      },
    ],
    fleet_bmc_fan_alignment_standings,
  ],
  g => g,
)

fn duplicate_standing_refuses() -> Bool {
  let admission = match host_alignment_admission(
    standings: srv3_duplicated_as_admitted,
    host: operator_host_srv3,
  ) {
    AlignmentStandingDuplicate => true
    other => false
  }
  admission
    && !host_alignment_admits_apply_evaluation(standings: srv3_duplicated_as_admitted, host: operator_host_srv3)
}

// THE REFUSAL REASONS STAY DISTINGUISHABLE. All four collapse to false at the Bool surface, so
// nothing about the OUTCOME would notice them merging -- and their remedies are entirely
// different: extend a type, go read a host, or fix a roster someone broke.
fn admission_reasons_stay_separate() -> Bool {
  let no_standing = match host_alignment_admission(standings: [], host: operator_host_srv3) {
    AlignmentStandingAbsent => true
    other => false
  }
  let by_alignment = match host_alignment_admission(
    standings: fleet_bmc_fan_alignment_standings,
    host: operator_host_srv3,
  ) {
    AlignmentRefused { alignment } => true
    other => false
  }
  let admitted = match host_alignment_admission(
    standings: [
      HostBmcFanAlignmentStanding {
        host: operator_host_srv3,
        alignment: IntentMatchesObservedProgram,
      },
    ],
    host: operator_host_srv3,
  ) {
    AlignmentAdmitsApplyEvaluation => true
    other => false
  }
  no_standing && by_alignment && admitted
}

// THE GATE IS ON THE PATH THAT ACTUALLY WRITES FANS, AND IT DECIDES BEFORE THE COMPARISONS.
// Both halves are asserted on ONE call with matching inputs: the capability and the observation
// agree on board, firmware, curve, config path and controller service, so every downstream
// comparison in bmc_fan_policy_projection_apply_suitability would return Suitable. The refusal
// therefore cannot be a mismatch wearing the standing's name. The control flips only the
// standings list, so the two arms differ in exactly one fact.
fn projection_gate_refuses_before_comparisons() -> Bool {
  let refused_under_fleet_standing = match bmc_fan_policy_projection_apply_suitability(
    capability: srv4_bmc_fan_projection_capability,
    board: srv4_bmc_fan_projection_capability.board,
    desired_curve: srv4_bmc_fan_projection_capability.projected_curve,
    observation: srv4_bmc_fan_converged_policy_observation,
    host: operator_host_srv4,
    standings: fleet_bmc_fan_alignment_standings,
  ) {
    BmcFanProjectionApplyRefused { cause } =>
      cause == BmcFanProjectionObservedProgramNotRepresentable
    BmcFanProjectionApplySuitable => false
  }
  let suitable_under_adopted_standing = match bmc_fan_policy_projection_apply_suitability(
    capability: srv4_bmc_fan_projection_capability,
    board: srv4_bmc_fan_projection_capability.board,
    desired_curve: srv4_bmc_fan_projection_capability.projected_curve,
    observation: srv4_bmc_fan_converged_policy_observation,
    host: operator_host_srv4,
    standings: [
      HostBmcFanAlignmentStanding {
        host: operator_host_srv4,
        alignment: IntentMatchesObservedProgram,
      },
    ],
  ) {
    BmcFanProjectionApplySuitable => true
    BmcFanProjectionApplyRefused { cause } => false
  }
  refused_under_fleet_standing && suitable_under_adopted_standing
}

fn bmc_fan_alignment_standing_witness() -> ProcessExit {
  if hand_configured_hosts_refuse()
    && projection_gate_refuses_before_comparisons()
    && duplicate_standing_refuses()
    && admission_reasons_stay_separate()
    && unexamined_host_refuses()
    && absent_standing_refuses()
    && represented_program_is_admitted()
    && refusal_arms_stay_separate() {
    ExitSuccess
  } else {
    exit_failure(reason: "bmc fan alignment standing witness: the srv3/srv4 interlock, the fail-closed default, or the admitted control changed")
  }
}
