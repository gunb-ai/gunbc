module gunbc.bmc_fan_alignment_standing_witness

import std.types { Bool, List }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.bmc_fan_alignment_standing {
  AlignmentAdmitsApplyEvaluation,
  AlignmentRefused,
  AlignmentStandingDuplicate,
  AlignmentStandingAbsent,
  BmcFanIntentAlignment,
  host_alignment_admission,
  HostBmcFanAlignmentStanding,
  IntentMatchesObservedProgram,
  ObservedProgramNotAdopted,
  ObservedProgramNotRepresentableByIntent,
  ObservedProgramRepresentableNotAdopted,
  RefusedObservedProgramRepresentableNotAdopted,
  fan_program_representability_authority,
  AlignmentRefusalCause,
  RefusedObservedProgramNotAdopted,
  RefusedObservedProgramNotRepresentableByIntent,
  fleet_host_alignment_admission,
  srv3_srv4_expected_missing,
  fleet_bmc_fan_alignment_standings,
  host_alignment_admits_apply_evaluation,
}
import gunbc.bmc_fan_projection {
  BmcFanProjectionApplyRefused,
  BmcFanProjectionApplySuitable,
  BmcFanProjectionObservedProgramNotAdopted,
  BmcFanProjectionObservedProgramRepresentableNotAdopted,
  bmc_fan_policy_projection_apply_suitability,
}
import gunbc.fleet_bmc_state { srv4_bmc_fan_projection_capability }
import gunbc.fleet_bmc_observation { srv4_bmc_fan_converged_policy_observation }
import gunbc.fleet_intent_network {
  operator_host_srv1,
  operator_host_srv3,
  operator_host_srv4,
}

// THE HOSTS I RECONFIGURED BY HAND MUST REFUSE ACTUATION. This is the conjunct that makes the
// interlock real rather than declared: it fails the moment someone marks srv3 or srv4 adopted.
// THE REASON THEY REFUSE CHANGED ON 2026-08-28 AND THE REQUIREMENT DID NOT, which is exactly why
// this conjunct is stated over the Bool and not over a cause: the carrier GAINED the shape they
// run (extdeps.bmc.pid_control_program models one thermal demand feeding several actuators), so
// they are no longer unrepresentable -- they are representable, read, and not adopted. Apply is
// still refused, because the projection is still the old single-actuator curve and writing it
// would replace the quieter program with the worse one.
fn hand_configured_hosts_refuse() -> Bool {
  !host_alignment_admits_apply_evaluation(standings: fleet_bmc_fan_alignment_standings, host: operator_host_srv3)
    && !host_alignment_admits_apply_evaluation(
      standings: fleet_bmc_fan_alignment_standings,
      host: operator_host_srv4,
    )
}

// AN UNEXAMINED HOST REFUSES TOO. srv1 was never touched, and that is precisely why it is not
// admitted: nobody has established that the intent describes it either.
fn unexamined_host_refuses() -> Bool {
  !host_alignment_admits_apply_evaluation(standings: fleet_bmc_fan_alignment_standings, host: operator_host_srv1)
}

// A HOST WITH NO ROW AT ALL REFUSES, rather than falling through to permitted. An empty roster
// is the state where writing is least safe, so the lookup's failure arm must not read as consent.
fn absent_standing_refuses() -> Bool {
  !host_alignment_admits_apply_evaluation(standings: [], host: operator_host_srv3)
}

// THE POSITIVE CONTROL, without which every conjunct above passes on a function that always
// returns false. A represented program IS admitted.
fn represented_program_is_admitted() -> Bool {
  host_alignment_admits_apply_evaluation(
    standings: [
      HostBmcFanAlignmentStanding {
        host: operator_host_srv3,
        alignment: IntentMatchesObservedProgram,
      },
    ],
    host: operator_host_srv3,
  )
}

// THE TWO REFUSING ARMS STAY DISTINGUISHABLE. They produce the same verdict today, so nothing
// about the OUTCOME would notice them collapsing - only their remedies differ, and that is
// exactly the kind of distinction that erodes silently.
fn refusal_arms_stay_separate() -> Bool {
  let unadopted: BmcFanIntentAlignment = ObservedProgramNotAdopted
  let unrepresentable: BmcFanIntentAlignment =
    ObservedProgramNotRepresentableByIntent { missing: "x" }
  let representable_unadopted: BmcFanIntentAlignment =
    ObservedProgramRepresentableNotAdopted {
      representability_authority: fan_program_representability_authority,
    }
  let a = match unadopted {
    ObservedProgramNotAdopted => true
    other => false
  }
  let b = match unrepresentable {
    ObservedProgramNotRepresentableByIntent { missing } => missing == "x"
    other => false
  }
  let c = match representable_unadopted {
    ObservedProgramRepresentableNotAdopted { representability_authority } =>
      representability_authority.decl_name == "program_representability"
    other => false
  }
  a && b && c
}

// THE VACATED ARM STAYS EXERCISED. srv3 and srv4 moved OFF
// ObservedProgramNotRepresentableByIntent when the actuator-program split landed; the arm itself
// did not go away, and a future host may occupy it. Deleting its evidence along with the rows
// that happened to use it would leave a live refusal path with nothing asserting it still
// refuses -- so the standing is CONSTRUCTED here rather than borrowed from the fleet roster, and
// srv3_srv4_expected_missing survives as that construction's payload rather than as dead data.
fn vacated_unrepresentable_arm_still_refuses() -> Bool {
  let constructed = [
    HostBmcFanAlignmentStanding {
      host: operator_host_srv3,
      alignment: ObservedProgramNotRepresentableByIntent {
        missing: srv3_srv4_expected_missing,
      },
    },
  ]
  let refuses = !host_alignment_admits_apply_evaluation(standings: constructed, host: operator_host_srv3)
  let carries = match host_alignment_admission(standings: constructed, host: operator_host_srv3) {
    AlignmentRefused { cause } =>
      match cause {
        RefusedObservedProgramNotRepresentableByIntent { missing } =>
          missing == srv3_srv4_expected_missing
        other => false
      }
    other => false
  }
  refuses && carries
}

// A DUPLICATE ROW REFUSES RATHER THAN LETTING AUTHORING ORDER DECIDE. Two rows for one host
// that disagree is a broken roster, and a first-match fold answers with whichever was typed
// first. The adversarial case is the one that matters: the duplicate says ADMITTED and is placed
// FIRST, so a first-match lookup returns admitted and the interlock opens.
data srv3_duplicated_as_admitted: List<HostBmcFanAlignmentStanding> = flat_map(
  [
    [
      HostBmcFanAlignmentStanding {
        host: operator_host_srv3,
        alignment: IntentMatchesObservedProgram,
      },
    ],
    fleet_bmc_fan_alignment_standings,
  ],
  g => g,
)

fn duplicate_standing_refuses() -> Bool {
  let admission = match host_alignment_admission(
    standings: srv3_duplicated_as_admitted,
    host: operator_host_srv3,
  ) {
    AlignmentStandingDuplicate => true
    other => false
  }
  admission
    && !host_alignment_admits_apply_evaluation(standings: srv3_duplicated_as_admitted, host: operator_host_srv3)
}

// THE REFUSAL REASONS STAY DISTINGUISHABLE. All four collapse to false at the Bool surface, so
// nothing about the OUTCOME would notice them merging -- and their remedies are entirely
// different: extend a type, go read a host, or fix a roster someone broke.
fn admission_reasons_stay_separate() -> Bool {
  let no_standing = match host_alignment_admission(standings: [], host: operator_host_srv3) {
    AlignmentStandingAbsent => true
    other => false
  }
  let by_alignment = match host_alignment_admission(
    standings: fleet_bmc_fan_alignment_standings,
    host: operator_host_srv3,
  ) {
    AlignmentRefused { cause } => true
    other => false
  }
  let admitted = match host_alignment_admission(
    standings: [
      HostBmcFanAlignmentStanding {
        host: operator_host_srv3,
        alignment: IntentMatchesObservedProgram,
      },
    ],
    host: operator_host_srv3,
  ) {
    AlignmentAdmitsApplyEvaluation => true
    other => false
  }
  no_standing && by_alignment && admitted
}

// THE GATE IS ON THE PATH THAT ACTUALLY WRITES FANS, AND IT DECIDES BEFORE THE COMPARISONS.
// Both halves are asserted on ONE call with matching inputs: the capability and the observation
// agree on board, firmware, curve, config path and controller service, so every downstream
// comparison in bmc_fan_policy_projection_apply_suitability would return Suitable. The refusal
// therefore cannot be a mismatch wearing the standing's name. The control flips only the
// standings list, so the two arms differ in exactly one fact.
fn projection_gate_refuses_before_comparisons() -> Bool {
  let refused_under_fleet_standing = match bmc_fan_policy_projection_apply_suitability(
    capability: srv4_bmc_fan_projection_capability,
    board: srv4_bmc_fan_projection_capability.board,
    desired_curve: srv4_bmc_fan_projection_capability.projected_curve,
    observation: srv4_bmc_fan_converged_policy_observation,
    host: operator_host_srv4,
    standings: fleet_bmc_fan_alignment_standings,
  ) {
    BmcFanProjectionApplyRefused { cause } =>
      cause == BmcFanProjectionObservedProgramRepresentableNotAdopted
    BmcFanProjectionApplySuitable => false
  }
  let suitable_under_adopted_standing = match bmc_fan_policy_projection_apply_suitability(
    capability: srv4_bmc_fan_projection_capability,
    board: srv4_bmc_fan_projection_capability.board,
    desired_curve: srv4_bmc_fan_projection_capability.projected_curve,
    observation: srv4_bmc_fan_converged_policy_observation,
    host: operator_host_srv4,
    standings: [
      HostBmcFanAlignmentStanding {
        host: operator_host_srv4,
        alignment: IntentMatchesObservedProgram,
      },
    ],
  ) {
    BmcFanProjectionApplySuitable => true
    BmcFanProjectionApplyRefused { cause } => false
  }
  refused_under_fleet_standing && suitable_under_adopted_standing
}

// WHICH CAUSE THE PRODUCER EMITTED, not merely that it refused. Every conjunct above reads the
// admission at a grain coarser than the distinction it claims to protect: `refusal_arms_stay_
// separate` tests hand-constructed vocabulary and never runs the producer, and the arm-shaped
// tests accept ANY AlignmentRefused. So this mutation stayed green through all of them --
//
//   every non-admitted standing -> AlignmentRefused { cause: RefusedObservedProgramNotAdopted }
//
// -- which erases the srv3/srv4 modelling subject while every Bool in the file still reads
// false. Raised in review, and correctly: a distinction is only defended at the grain something
// asserts it.
//
// WHAT THE `missing` COMPARISON DOES AND DOES NOT PIN, said plainly because both sides read the
// same declaration: it does NOT pin the sentence -- editing srv3_srv4_expected_missing keeps this
// green, and pinning prose here would be a literal copied from the tree serving as its own
// oracle. What it pins is that the PRODUCER carries the row's payload through instead of
// synthesising or dropping one, which is the mutation this conjunct exists to catch.
fn producer_emits_the_exact_cause() -> Bool {
  let srv1_unadopted = match fleet_host_alignment_admission(host: operator_host_srv1) {
    AlignmentRefused { cause } =>
      match cause {
        RefusedObservedProgramNotAdopted => true
        other => false
      }
    other => false
  }
  let srv3_representable_unadopted = match fleet_host_alignment_admission(host: operator_host_srv3) {
    AlignmentRefused { cause } =>
      match cause {
        RefusedObservedProgramRepresentableNotAdopted { representability_authority } =>
          representability_authority.module_path == "extdeps.bmc.pid_control_representability"
        other => false
      }
    other => false
  }
  let srv4_representable_unadopted = match fleet_host_alignment_admission(host: operator_host_srv4) {
    AlignmentRefused { cause } =>
      match cause {
        RefusedObservedProgramRepresentableNotAdopted { representability_authority } =>
          representability_authority.module_path == "extdeps.bmc.pid_control_representability"
        other => false
      }
    other => false
  }
  srv1_unadopted && srv3_representable_unadopted && srv4_representable_unadopted
}

// THE PROJECTION BOUNDARY PRESERVES THE CAUSE IT WAS HANDED. The producer emitting two causes
// buys nothing if the consumer folds them back into one on the way through, which is the shape
// the Boolean parameter had and which a mapping table can silently reintroduce.
fn projection_preserves_the_cause() -> Bool {
  let srv1_maps_to_unadopted = match bmc_fan_policy_projection_apply_suitability(
    capability: srv4_bmc_fan_projection_capability,
    board: srv4_bmc_fan_projection_capability.board,
    desired_curve: srv4_bmc_fan_projection_capability.projected_curve,
    observation: srv4_bmc_fan_converged_policy_observation,
    host: operator_host_srv1,
    standings: fleet_bmc_fan_alignment_standings,
  ) {
    BmcFanProjectionApplyRefused { cause } =>
      cause == BmcFanProjectionObservedProgramNotAdopted
    BmcFanProjectionApplySuitable => false
  }
  let srv4_maps_to_unrepresentable = match bmc_fan_policy_projection_apply_suitability(
    capability: srv4_bmc_fan_projection_capability,
    board: srv4_bmc_fan_projection_capability.board,
    desired_curve: srv4_bmc_fan_projection_capability.projected_curve,
    observation: srv4_bmc_fan_converged_policy_observation,
    host: operator_host_srv4,
    standings: fleet_bmc_fan_alignment_standings,
  ) {
    BmcFanProjectionApplyRefused { cause } =>
      cause == BmcFanProjectionObservedProgramRepresentableNotAdopted
    BmcFanProjectionApplySuitable => false
  }
  srv1_maps_to_unadopted && srv4_maps_to_unrepresentable
}

// THE DUPLICATE REFUSAL SURVIVES BOTH ORDERINGS. The case above places the admitting row FIRST,
// which a first-match fold answers wrongly; this one places it LAST, which a LAST-match fold
// answers wrongly. Only one ordering was tested, so a mutation from duplicate-refusal to
// last-match-wins stayed green -- the same defect the first-match repair fixed, mirrored.
data srv3_duplicated_as_admitted_last: List<HostBmcFanAlignmentStanding> = flat_map(
  [
    fleet_bmc_fan_alignment_standings,
    [
      HostBmcFanAlignmentStanding {
        host: operator_host_srv3,
        alignment: IntentMatchesObservedProgram,
      },
    ],
  ],
  g => g,
)

fn duplicate_standing_refuses_in_either_order() -> Bool {
  let last = match host_alignment_admission(
    standings: srv3_duplicated_as_admitted_last,
    host: operator_host_srv3,
  ) {
    AlignmentStandingDuplicate => true
    other => false
  }
  last
    && !host_alignment_admits_apply_evaluation(
      standings: srv3_duplicated_as_admitted_last,
      host: operator_host_srv3,
    )
}

fn bmc_fan_alignment_standing_witness() -> ProcessExit {
  if hand_configured_hosts_refuse()
    && projection_gate_refuses_before_comparisons()
    && producer_emits_the_exact_cause()
    && projection_preserves_the_cause()
    && duplicate_standing_refuses_in_either_order()
    && duplicate_standing_refuses()
    && admission_reasons_stay_separate()
    && unexamined_host_refuses()
    && absent_standing_refuses()
    && represented_program_is_admitted()
    && refusal_arms_stay_separate()
    && vacated_unrepresentable_arm_still_refuses() {
    ExitSuccess
  } else {
    exit_failure(reason: "bmc fan alignment standing witness: the srv3/srv4 interlock, the fail-closed default, or the admitted control changed")
  }
}

