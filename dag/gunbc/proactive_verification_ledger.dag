fn proactive_verification_ledger_rows() -> List<VerificationLedgerRow> {
  concat(proactive_verification_spine_rows, proactive_verification_family_rows)
}

fn ledger_row_disposition_is(row: VerificationLedgerRow, d: VerificationDisposition) -> Bool {
  match row.disposition {
    ExecutableNow =>
      match d { ExecutableNow => true, KnownRedPendingUnquarantine => false, BlockedOnCiFloorCutover => false }
    KnownRedPendingUnquarantine =>
      match d { ExecutableNow => false, KnownRedPendingUnquarantine => true, BlockedOnCiFloorCutover => false }
    BlockedOnCiFloorCutover =>
      match d { ExecutableNow => false, KnownRedPendingUnquarantine => false, BlockedOnCiFloorCutover => true }
  }
}

fn ledger_rows_with_disposition(d: VerificationDisposition) -> List<VerificationLedgerRow> {
  filter(xs: proactive_verification_ledger_rows(), predicate: fn(row) {
    ledger_row_disposition_is(row: row, d: d)
  })
}

fn ledger_spine_row_count() -> Int {
  length(xs: proactive_verification_spine_rows)
}

fn ledger_family_row_count() -> Int {
  length(xs: proactive_verification_family_rows)
}

fn ledger_total_row_count() -> Int {
  length(xs: proactive_verification_ledger_rows())
}

fn ledger_executable_now_count() -> Int {
  length(xs: ledger_rows_with_disposition(d: ExecutableNow))
}

fn ledger_known_red_count() -> Int {
  length(xs: ledger_rows_with_disposition(d: KnownRedPendingUnquarantine))
}

fn ledger_blocked_count() -> Int {
  length(xs: ledger_rows_with_disposition(d: BlockedOnCiFloorCutover))
}

fn ledger_v1_delete_required_green_count() -> Int {
  ledger_total_row_count()
}

fn ledger_has_spine_kind(kind: VerificationReceiptKind) -> Bool {
  fold_list(
    xs: proactive_verification_spine_rows,
    empty: false,
    cons: fn(acc, row) { acc || (row.kind == kind) }
  )
}

fn ledger_all_spine_kinds_present() -> Bool {
  ledger_has_spine_kind(kind: WholeCorpusWitnessParityCold)
    && ledger_has_spine_kind(kind: CompileCleanParity)
    && ledger_has_spine_kind(kind: RegenBehavioralFixedPoint)
}

fn disposition_to_pending_outcome(row: VerificationLedgerRow) -> VerificationExecutionOutcome {
  match row.disposition {
    ExecutableNow => OutcomePending { reason: "not yet executed this session" }
    KnownRedPendingUnquarantine => OutcomePending { reason: row.dissolve_trigger }
    BlockedOnCiFloorCutover => OutcomePending { reason: row.dissolve_trigger }
  }
}
