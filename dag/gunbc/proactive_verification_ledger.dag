module gunbc.proactive_verification_ledger

import gunbc.ci_layer_roots { known_red_probe_entries }
import std.realization_schedule { ScheduleWitnessEntry }
import std.types { String, Int, List }
import v2.std.algebra { any, filter, fold_list, length }
import v2.std.node { Symbol }

data proactive_verification_ledger_law: String = "The PROACTIVE VERIFICATION LEDGER (operator no-soak ruling 2026-07-20; v1_deletion_plan ^v1_delete): enumerated executed receipts that gate v1_delete — never calendar soak, never elapsed-time claims. Each row is ONE deliberate run with a typed execution shape, a disposition (ExecutableNow | KnownRedPendingUnquarantine | BlockedOnCiFloorCutover), and an execution outcome (OutcomeGreen | OutcomePending | OutcomeRed) recorded only after a real run — never fabricated. Spine rows carry hand-declared disposition (BlockedOnCiFloorCutover until cutover). Family disposition is DERIVED by projecting gunbc.ci_layer_roots known_red_probe_entries — never hand-declared (§3 single authority). Spine: (1) whole-corpus cold v1-vs-v2 witness parity — falsifier predict-only cadence, zero unexplained divergence; (2) compile-clean parity; (3) regen behavioral fixed point. Families: nine #6879 partition families as equals_eval receipts (meet_join contributes meet + join peer primaries — review 43336). Dissolve-on: ci_floor_cutover + ledger all OutcomeGreen."

type VerificationReceiptKind
  = WholeCorpusWitnessParityCold
  | CompileCleanParity
  | RegenBehavioralFixedPoint

type VerificationExecutionShape
  = ClaimWitness { entry: String, function: String }
  | FalsifierPredictOnlyBatch
  | CompileCleanGate
  | RegenVerifyGate

type VerificationDisposition
  = ExecutableNow
  | KnownRedPendingUnquarantine
  | BlockedOnCiFloorCutover

type VerificationExecutionOutcome
  = OutcomeGreen
  | OutcomePending { reason: String }
  | OutcomeRed { reason: String }

type SpineVerificationLedgerRow {
  id: Symbol,
  kind: VerificationReceiptKind,
  title: String,
  execution: VerificationExecutionShape,
  disposition: VerificationDisposition,
  dissolve_trigger: String
}

type FamilyVerificationLedgerRow {
  id: Symbol,
  title: String,
  execution: VerificationExecutionShape,
  dissolve_trigger: String
}

data spine_witness_parity_recipe: String = "claim_executor --source-root dag --source-root src/v2 --plan-entry src/v2/workflow/ci_floor_plan.dag --plan-function gunbc_falsifier_batches (batch 0 = SelectionPredictOnly whole-corpus cold affected-set falsifier; zero unexplained divergence vs predict-only expectations — a rerun-everything arm is the absorbing-fallback hard reject)"

data spine_compile_clean_recipe: String = "claim_executor batch-1 dag_compile_clean_gate (--target dag whole-tree; same authority as gunbc_ci_floor_batches)"

data spine_regen_recipe: String = "regen_stage0 --emit-fresh target/v2-emit-fresh-realize --write-manifest target/v2-emit-fresh-realize/roster_manifest.txt --verify (RegenVerifyGate transport)"

data family_partition_note: String = "Nine witness-realization families (#6879 kernel partition): add (serial kernel), match+loop+fold_closure (lane 3), field_access+complement (lane 2), meet_join+variant_construct+classical_not_ingested (lane 4). Emitter clean across all nine — eval/harness gaps closed by #6912 and #6917. Family KnownRed disposition = exact (entry, function) projection of known_red_probe_entries; un-quarantine deletes the probe row."

