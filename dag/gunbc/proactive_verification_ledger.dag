fn schedule_row_matches(
  w: ScheduleWitnessEntry,
  entry: String,
  function: String
) -> Bool {
  (w.entry == entry) && (w.function == function)
}

fn schedule_contains_entry(
  xs: List<ScheduleWitnessEntry>,
  entry: String,
  function: String
) -> Bool {
  any(
    xs: xs,
    predicate: fn(w) { schedule_row_matches(w: w, entry: entry, function: function) }
  )
}

fn family_row_has_live_probe_red(row: FamilyVerificationLedgerRow) -> Bool {
  match row.execution {
    ClaimWitness { entry: e, function: f } =>
      schedule_contains_entry(xs: known_red_probe_entries, entry: e, function: f)
    FalsifierPredictOnlyBatch => false
    CompileCleanGate => false
    RegenVerifyGate => false
  }
}

fn family_row_disposition(row: FamilyVerificationLedgerRow) -> VerificationDisposition {
  if family_row_has_live_probe_red(row: row) {
    KnownRedPendingUnquarantine
  } else {
    ExecutableNow
  }
}

fn spine_row_disposition_is(row: SpineVerificationLedgerRow, d: VerificationDisposition) -> Bool {
  row.disposition == d
}

fn family_row_disposition_is(row: FamilyVerificationLedgerRow, d: VerificationDisposition) -> Bool {
  family_row_disposition(row: row) == d
}

fn ledger_spine_row_count() -> Int {
  length(xs: proactive_verification_spine_rows)
}

fn ledger_family_row_count() -> Int {
  length(xs: proactive_verification_family_rows)
}

fn ledger_total_row_count() -> Int {
  ledger_spine_row_count() + ledger_family_row_count()
}

fn ledger_executable_now_count() -> Int {
  length(xs: filter(
    xs: proactive_verification_family_rows,
    predicate: fn(row) { family_row_disposition_is(row: row, d: ExecutableNow) }
  ))
}

fn ledger_known_red_count() -> Int {
  length(xs: filter(
    xs: proactive_verification_family_rows,
    predicate: fn(row) { family_row_disposition_is(row: row, d: KnownRedPendingUnquarantine) }
  ))
}

fn ledger_blocked_count() -> Int {
  length(xs: filter(
    xs: proactive_verification_spine_rows,
    predicate: fn(row) { spine_row_disposition_is(row: row, d: BlockedOnCiFloorCutover) }
  ))
}

fn ledger_v1_delete_required_green_count() -> Int {
  ledger_total_row_count()
}

fn ledger_has_spine_kind(kind: VerificationReceiptKind) -> Bool {
  fold_list(
    xs: proactive_verification_spine_rows,
    empty: false,
    cons: fn(acc, row) { acc || (row.kind == kind) }
  )
}

fn ledger_all_spine_kinds_present() -> Bool {
  ledger_has_spine_kind(kind: WholeCorpusWitnessParityCold)
    && ledger_has_spine_kind(kind: CompileCleanParity)
    && ledger_has_spine_kind(kind: RegenBehavioralFixedPoint)
}

fn ledger_executable_family_rows() -> List<FamilyVerificationLedgerRow> {
  filter(
    xs: proactive_verification_family_rows,
    predicate: fn(row) { family_row_disposition_is(row: row, d: ExecutableNow) }
  )
}

fn disposition_to_pending_outcome_for_family(row: FamilyVerificationLedgerRow) -> VerificationExecutionOutcome {
  match family_row_disposition(row: row) {
    ExecutableNow => OutcomePending { reason: "not yet executed this session" }
    KnownRedPendingUnquarantine => OutcomePending { reason: row.dissolve_trigger }
    BlockedOnCiFloorCutover => OutcomePending { reason: row.dissolve_trigger }
  }
}

fn disposition_to_pending_outcome_for_spine(row: SpineVerificationLedgerRow) -> VerificationExecutionOutcome {
  match row.disposition {
    ExecutableNow => OutcomePending { reason: "not yet executed this session" }
    KnownRedPendingUnquarantine => OutcomePending { reason: row.dissolve_trigger }
    BlockedOnCiFloorCutover => OutcomePending { reason: row.dissolve_trigger }
  }
}
