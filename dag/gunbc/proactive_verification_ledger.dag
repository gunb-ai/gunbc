  SpineVerificationLedgerRow {
    id: ^whole_corpus_witness_parity_cold,
    kind: WholeCorpusWitnessParityCold,
    title: "Whole-corpus cold v1-vs-v2 witness parity (falsifier predict-only batch)",
    execution: FalsifierPredictOnlyBatch,
    disposition: BlockedOnCiFloorCutover,
    dissolve_trigger: "ci_floor_cutover; falsifier cold sweep records zero unexplained divergence rows"
  },
  SpineVerificationLedgerRow {
    id: ^compile_clean_parity,
    kind: CompileCleanParity,
    title: "Compile-clean parity (whole-tree --target dag gate)",
    execution: CompileCleanGate,
    disposition: BlockedOnCiFloorCutover,
    dissolve_trigger: "ci_floor_cutover; whole-tree compile-clean gate green on v2-emitted execution path"
  },
  SpineVerificationLedgerRow {
    id: ^regen_behavioral_fixed_point,
    kind: RegenBehavioralFixedPoint,
    title: "Regen behavioral fixed point (regen_stage0 --verify two-generation equivalence)",
    execution: RegenVerifyGate,
    disposition: BlockedOnCiFloorCutover,
    dissolve_trigger: "emitter_fixed_point + ci_floor_cutover; regen_verify gate green by execution"
  }
]

