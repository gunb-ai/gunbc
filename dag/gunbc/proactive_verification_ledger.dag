module gunbc.proactive_verification_ledger

import std.types { String, Int, List }
import v2.std.node { Symbol }
import v2.std.algebra { filter, fold_list, length }

data proactive_verification_ledger_law: String = "The PROACTIVE VERIFICATION LEDGER (operator no-soak ruling 2026-07-20; v1_deletion_plan ^v1_delete): enumerated executed receipts that gate v1_delete — never calendar soak, never elapsed-time claims. Each row is ONE deliberate run with a typed execution shape and an honest overlap disposition (ExecutableNow | KnownRedPendingUnquarantine | BlockedOnCiFloorCutover). Green-by-execution means every row ran and passed; a pending row is counted, not absorbed. Spine receipts (whole-corpus cold v1-vs-v2 witness parity, compile-clean parity, regen behavioral fixed point) plus one row per emit_host family equals_eval agreement witness. Dissolve-on: ci_floor_cutover routes native + the ledger is all ExecutableNow green — then v1_quarantine may proceed."

type VerificationReceiptKind
  = WholeCorpusWitnessParityCold
  | CompileCleanParity
  | RegenBehavioralFixedPoint
  | FamilyEqualsEval

type VerificationExecutionShape
  = ClaimWitness { entry: String, function: String }
  | FalsifierPredictOnlyBatch
  | CompileCleanGate
  | RegenVerifyGate

type VerificationDisposition
  = ExecutableNow
  | KnownRedPendingUnquarantine
  | BlockedOnCiFloorCutover

type VerificationLedgerRow {
  id: Symbol,
  kind: VerificationReceiptKind,
  title: String,
  execution: VerificationExecutionShape,
  disposition: VerificationDisposition,
  dissolve_trigger: String
}

data spine_witness_parity_recipe: String = "claim_executor --source-root dag --source-root src/v2 --plan-entry src/v2/workflow/ci_floor_plan.dag --plan-function gunbc_falsifier_batches --batch-index 0 (SelectionPredictOnly whole-corpus cold affected-set falsifier; zero unexplained divergence vs predict-only expectations)"

data spine_compile_clean_recipe: String = "claim_executor batch-1 dag_compile_clean_gate (--target dag whole-tree; same authority as gunbc_ci_floor_batches)"

data spine_regen_recipe: String = "regen_stage0 --emit-fresh target/v2-emit-fresh-realize --write-manifest target/v2-emit-fresh-realize/roster_manifest.txt --verify (RegenVerifyGate transport)"

data proactive_verification_spine_rows: List<VerificationLedgerRow> = [
  VerificationLedgerRow {
    id: ^whole_corpus_witness_parity_cold,
    kind: WholeCorpusWitnessParityCold,
    title: "Whole-corpus cold v1-vs-v2 witness parity (falsifier predict-only batch; zero unexplained divergence)",
    execution: FalsifierPredictOnlyBatch,
    disposition: BlockedOnCiFloorCutover,
    dissolve_trigger: "ci_floor_cutover lands native routing; falsifier cold sweep records zero divergence rows"
  },
  VerificationLedgerRow {
    id: ^compile_clean_parity,
    kind: CompileCleanParity,
    title: "Compile-clean parity (whole-tree --target dag gate)",
    execution: CompileCleanGate,
    disposition: BlockedOnCiFloorCutover,
    dissolve_trigger: "ci_floor_cutover; whole-tree compile-clean gate green on v2-emitted execution path"
  },
  VerificationLedgerRow {
    id: ^regen_behavioral_fixed_point,
    kind: RegenBehavioralFixedPoint,
    title: "Regen behavioral fixed point (regen_stage0 --verify two-generation equivalence)",
    execution: RegenVerifyGate,
    disposition: BlockedOnCiFloorCutover,
    dissolve_trigger: "emitter_fixed_point + ci_floor_cutover; regen_verify gate green by execution"
  }
]

