module gunbc.cli_intent

import std.types { Bool, Int, NonEmptyStr, Port, String }
import extdeps.git.object_store { GitObjectId, git_sha1_object_id }
import gunbc.output_policy { ChannelPolicy, resolve_channel_policy }
import gunbc.ci_layer_roots { witness_layer_roots }

// WHY THIS MODULE EXISTS, and what it deliberately is not.
//
// `cli_run.rs` was deleted whole (integration/cli-run-cut, 2026-08-15). Its four CLI verb
// handlers are NOT ported: the operator ruled them garbage, and the measurement behind that
// ruling is worth keeping because it is the shape this module inverts. A seven-line diagnostic
// counter in that file transitively reached ~17k lines, because
// compile_clean_im_vector_hard_error_count called compile_clean_diagnostic_is_hard, which read
// the unlisted-import-use policy through a PRIVATE resolve: default_source_roots, then
// resolve_entry_graph_shared, then make_eval_context, then an interpreter run. A projection over
// a diagnostic list owned a compiler invocation.
//
// The inversion, which is DESIGN section 2's Realization shape (one evaluation, N consumers):
// the ordinary resolve/eval path runs ONCE and PRODUCES the policy and output-decision facts;
// projections CONSUME already-evaluated facts and hold no resolve of their own. That is why this
// module models an intent and nothing else — it never reads a policy, never resolves, and has no
// path to an interpreter.
data cli_intent_inversion_note: String = "The escape hatch's mechanism, one level down: a projection that owns a compiler invocation. cli_run's compile-clean predicates were not pure functions of a diagnostic list — each re-derived the blocking policy through its own resolve, memoised in a thread_local. That is why hollowing the file in pieces kept failing: lifting the four predicates alone drags the resolve stack behind them. This module carries the opposite arrangement, and carries no compile-clean predicate at all: hard-versus-advisory derives from a diagnostic's OWN typed class, never from a policy interpreter call."

// ---------------------------------------------------------------------------
// 1. The forward reading of an argv relation that already exists
// ---------------------------------------------------------------------------

// `gunbc.cli_invoke` `gunbc_run_transport_argv` already reads this relation BACKWARD: it folds a
// run intent into argv tokens for a transport to invoke. Parsing is the same relation read
// FORWARD (DESIGN section 4, one grammar in both directions), so the intent shape below is the
// thing that builder projects from, not a second private model of the same command line. A
// separate parse-side vocabulary would be exactly the N x M adapter pair section 4 rules out.
data argv_relation_direction_note: String = "One relation, two readings. gunbc.cli_invoke builds argv from an intent; this module decodes argv into one. Neither is the authority for the other's vocabulary — the intent IS the shared middle. When a verb gains a flag it is added here once and both directions follow, rather than a builder and a parser drifting into two spellings of one command line."

type RunArg {
  name: NonEmptyStr
  value: String
}

type SourceSelection {
  source_roots: List<String>
  entry: String?
}

// ---------------------------------------------------------------------------
// 2. The verbs
// ---------------------------------------------------------------------------

// `Ci` carries no payload because it is not a verb — in the deleted seed it was
// `handle_ci() { handle_run_with_options(witness_layer_roots(), "main", "dag/tools/gunbc_ci.dag", ...) }`,
// eleven lines whose entire content was a preset. It is a ROW below (`ci_preset`), so the preset
// is data one can read, diff and re-point rather than a function one must open to discover.
type CliVerb
  = Compile { selection: SourceSelection, output_dir: NonEmptyStr, target: NonEmptyStr }
  | Run { selection: SourceSelection, function: NonEmptyStr, claim_run: Bool, args: List<RunArg> }
  | Converge { host: NonEmptyStr }
  | Serve { selection: SourceSelection, function: NonEmptyStr, bind: ServeBinding }

// DISPOSITION — the Converge/Serve split is INHERITED, not decided (2026-08-15).
//
// Recorded plainly because "decided deliberately" and "inherited" look identical in source, and
// only one of them survives review. These two arms mirror the deleted CLI's subcommand list: I
// modelled CliVerb from main.rs's `enum Commands`, and the grounding I claimed for this module —
// that it is the forward reading of the argv relation gunbc.cli_invoke reads backward — justifies
// the argv SHAPE and says nothing about the verb DECOMPOSITION. So this is a candidate for the
// failure DESIGN names for replacement migrations: X's decomposition rebuilding itself inside Y
// one convenience at a time.
//
// THE OPEN QUESTION, stated so a later reader can settle it rather than re-derive it: if terminal
// gunbc converges a desired SERVING OCCURRENCE (host, release identity, route table, bind
// endpoint, health contract, budget), then everything in ServeBinding is desired-state that merely
// arrived through a command, and this record is the shape of the old command rather than the shape
// of the new state — at which point Serve folds into convergence and these arms delete. If instead
// a long-running listener is genuinely its own lifecycle authority beside convergence, the split is
// right as it stands.
//
// I have not decided it, and the operator has ruled converge/serve minor, so it is not being
// decided under a cut that has no consumer for either arm yet. What is NOT deferred is the fact of
// the inheritance, which is what this note exists to prevent going silent.
type ServeEvaluationBudget {
  cpu_limit_ms: Int?
  wall_limit_ms: Int?
}

// `revision` is a GitObjectId, NOT a String and NOT std.types CommitSha. Two reasons, one of them
// a finding rather than a preference.
//
// The design reason: the seed validated `--release-revision` as exactly 40 lowercase hex BEFORE
// compiling its graph and BEFORE binding the listener, so a process that cannot say which release
// it is could never be routed to. That ordering was correct and load-bearing, and an ordering held
// by convention is one refactor away from being lost. Here it is held by CONSTRUCTION: the only
// mint for a GitObjectId at 40 hex digits is extdeps.git.object_store `git_sha1_object_id`, which
// refuses to `Absent` rather than fabricating, so a ServeBinding carrying an unvalidated revision
// has no constructor and an unidentifiable process cannot reach a bind. The ordering climbs from
// "checked first" to "the invalid state has no representation" (DESIGN section 4b).
//
// The finding: std.types `CommitSha = String` is a bare alias with no refinement, so every string
// inhabits it and grounding on it would have left the wall at validation. Reported rather than
// edited — refining a load-bearing std alias is not this lane's call.
type ServeBinding {
  host: NonEmptyStr
  port: Port
  revision: GitObjectId
  budget: ServeEvaluationBudget
}

type RunIntent {
  verb: CliVerb
  dry_run: Bool
}

// ---------------------------------------------------------------------------
// 3. The intent-validation phase
// ---------------------------------------------------------------------------

// Every refusal is typed and located at the argv token that caused it. None of them is a default,
// a widen, or a fallback: an argument this module cannot decode has no admitted reading (DESIGN
// section 5 — a failure arm must refuse, never widen).
type IntentRefusal
  = NoSourceRoot
  | RunArgMissingEquals { token: String }
  | RunArgEmptyName { token: String }
  | ClaimRunWithoutEntry
  | ReleaseRevisionMalformed { text: String }
  | ServePortOutOfRange { text: String }
  | UnknownVerb { token: String }

type IntentAdmission
  = IntentAdmitted { intent: RunIntent }
  | IntentRefused { refusal: IntentRefusal }

// THE PHASE IS THE POINT, not the function. `RunIntent` is reachable only through an
// `IntentAdmitted` arm, and the resolve/eval entry takes a `RunIntent` — so unvalidated argv has
// no path to a compile. In the seed this was an ordering inside one 371-line handler ("refuse a
// malformed --arg before the compile, so the diagnostic is the first thing printed rather than the
// last"); a comment describing where a check sits in a control flow. Here the control flow cannot
// be arranged the other way round.
data intent_validation_phase_note: String = "Two orderings the deleted handlers encoded as comments are carried here as typed facts. FIRST: a malformed --arg refuses before any compile, so the diagnostic a user reads is the one about their command line rather than a compiler's complaint that arrives after a minute of work. SECOND: an unparseable release revision refuses before the graph compiles and before the listener binds. Both are now structural rather than ordered — RunArg and GitObjectId have no forgeable constructor, so an intent carrying either malformed value cannot be built, and a phase that cannot produce one cannot hand it onward. What was a comment about ordering is a statement about inhabitance."

// A missing `=` and an empty name are separate arms rather than one MalformedRunArg, because they
// are different author mistakes with different corrections: `--arg foo` forgot the value, `--arg
// =bar` forgot the name. Collapsing them would be the state-space conflation DESIGN lists as a
// recurring failure mode, in miniature.
fn admit_run_arg(token: String) -> IntentRefusal? {
  let parts = token |> split(delimiter: "=")
  let missing_equals: IntentRefusal = RunArgMissingEquals { token: token }
  let empty_name: IntentRefusal = RunArgEmptyName { token: token }
  if (parts |> count) < 2 {
    Present { value: missing_equals }
  } else if starts_with(s: token, prefix: "=") {
    Present { value: empty_name }
  } else {
    none
  }
}

fn admit_release_revision(text: String) -> GitObjectId? {
  git_sha1_object_id(hex: text)
}

// ---------------------------------------------------------------------------
// 4. handle_ci, as a row
// ---------------------------------------------------------------------------

data ci_preset_entry: NonEmptyStr = "dag/tools/gunbc_ci.dag"
data ci_preset_function: NonEmptyStr = "main"

// ---------------------------------------------------------------------------
// 5. argv decode — one fold
// ---------------------------------------------------------------------------

// A finished stage is one fold (DESIGN section 6), and argv is no exception: the whole command
// line becomes a flag/value roster in a single pass with no per-verb parser. Boolean flags need no
// special case in the scanner — a flag arriving while another is pending simply closes the pending
// one with an empty value, and so does the end of the token list. That is why `--dry-run --entry x`
// and `--entry x --dry-run` decode identically without either spelling being enumerated.
type FlagValue {
  flag: String
  value: String
}

type ArgvScan {
  pending: String?
  values: List<FlagValue>
  bare: List<String>
}

data argv_scan_empty: ArgvScan = ArgvScan { pending: none, values: [], bare: [] }

fn argv_scan_close_pending(scan: ArgvScan) -> List<FlagValue> {
  match scan.pending {
    Present { value: flag } => scan.values |> list_push(FlagValue { flag: flag, value: "" })
    Absent => scan.values
  }
}

fn argv_scan_step(scan: ArgvScan, token: String) -> ArgvScan {
  if starts_with(s: token, prefix: "--") {
    ArgvScan {
      pending: Present { value: token },
      values: argv_scan_close_pending(scan: scan),
      bare: scan.bare,
    }
  } else {
    match scan.pending {
      Present { value: flag } =>
        ArgvScan {
          pending: none,
          values: scan.values |> list_push(FlagValue { flag: flag, value: token }),
          bare: scan.bare,
        }
      Absent =>
        ArgvScan { pending: none, values: scan.values, bare: scan.bare |> list_push(token) }
    }
  }
}

fn scan_argv(tokens: List<String>) -> ArgvScan {
  let scanned = tokens |> fold(init: argv_scan_empty, f: (acc, t) => argv_scan_step(scan: acc, token: t))
  ArgvScan { pending: none, values: argv_scan_close_pending(scan: scanned), bare: scanned.bare }
}

fn flag_values(scan: ArgvScan, flag: String) -> List<String> {
  scan.values |> filter(v => v.flag == flag) |> map(v => v.value)
}

fn flag_present(scan: ArgvScan, flag: String) -> Bool {
  scan.values |> any(v => v.flag == flag)
}

fn flag_value(scan: ArgvScan, flag: String) -> String? {
  flag_values(scan: scan, flag: flag) |> first
}

// ---------------------------------------------------------------------------
// 6. Admission — the only route to a RunIntent
// ---------------------------------------------------------------------------

data source_root_flag: String = "--source-root"
data entry_flag: String = "--entry"
data function_flag: String = "--function"
data arg_flag: String = "--arg"
data claim_run_flag: String = "--claim-run"
data dry_run_flag: String = "--dry-run"
data host_flag: String = "--host"
data port_flag: String = "--port"
data release_revision_flag: String = "--release-revision"
data output_dir_flag: String = "--output-dir"
data target_flag: String = "--target"

fn first_run_arg_refusal(tokens: List<String>) -> IntentRefusal? {
  tokens |> fold(
    init: none,
    f: (acc, t) => match acc {
      Present { value: r } => Present { value: r }
      Absent => admit_run_arg(token: t)
    }
  )
}

// Optional has no unwrap-with-default in this corpus — every consumer matches — so these two
// helpers exist rather than the same match being written out at each of the four use sites.
fn optional_string_or(v: String?, fallback: String) -> String {
  match v {
    Present { value: s } => s
    Absent => fallback
  }
}

fn optional_string_missing(v: String?) -> Bool {
  match v {
    Present { value: _ } => false
    Absent => true
  }
}

fn run_arg_of(token: String) -> RunArg {
  let parts = token |> split(delimiter: "=")
  RunArg {
    name: optional_string_or(v: parts |> first, fallback: "") as NonEmptyStr,
    value: parts |> skip(1) |> join(separator: "="),
  }
}

fn selection_of(scan: ArgvScan) -> SourceSelection {
  SourceSelection {
    source_roots: flag_values(scan: scan, flag: source_root_flag),
    entry: flag_value(scan: scan, flag: entry_flag),
  }
}

// The ordering the seed held as a comment ("refuse a malformed --arg before the compile") is here a
// consequence of where the refusals sit: every one of them is decided on the SCAN, which is pure
// text, and a RunIntent is the only thing this module hands onward. Nothing downstream can run
// before the refusals have been passed, because there is nothing to hand it.
fn admit_run(scan: ArgvScan) -> IntentAdmission {
  let roots = flag_values(scan: scan, flag: source_root_flag)
  let entry = flag_value(scan: scan, flag: entry_flag)
  let claim_run = flag_present(scan: scan, flag: claim_run_flag)
  let arg_tokens = flag_values(scan: scan, flag: arg_flag)
  if (roots |> count) == 0 {
    IntentRefused { refusal: NoSourceRoot }
  } else if claim_run && optional_string_missing(v: entry) {
    IntentRefused { refusal: ClaimRunWithoutEntry }
  } else {
    match first_run_arg_refusal(tokens: arg_tokens) {
      Present { value: r } => IntentRefused { refusal: r }
      Absent =>
        IntentAdmitted {
          intent: RunIntent {
            verb: Run {
              selection: selection_of(scan: scan),
              function: optional_string_or(v: flag_value(scan: scan, flag: function_flag), fallback: "main") as NonEmptyStr,
              claim_run: claim_run,
              args: arg_tokens |> map(t => run_arg_of(token: t)),
            },
            dry_run: flag_present(scan: scan, flag: dry_run_flag),
          },
        }
    }
  }
}

// `Port` is `Int where range(min: 1, max: 65535)`, but a value arriving from argv is a non-literal
// at a refined position, which this compiler counts as an advisory rather than enforcing (DESIGN's
// wall-after-grounding residue). So the range is ALSO refused explicitly here. That is not a second
// representation of the bound — it is the honest admission that the carrier's wall does not yet
// fire at this position, and the refusal deletes when refinement evidence at non-literal positions
// lands. A type name without an enforced construction is not safety, and pretending otherwise is
// the exact failure DESIGN warns about.
fn admit_port(text: String) -> Int? {
  match parse_int(s: text) {
    Present { value: n } => if n >= 1 && n <= 65535 { Present { value: n } } else { none }
    Absent => none
  }
}

fn admit_serve(scan: ArgvScan) -> IntentAdmission {
  let roots = flag_values(scan: scan, flag: source_root_flag)
  let revision_text = optional_string_or(v: flag_value(scan: scan, flag: release_revision_flag), fallback: "")
  let port_text = optional_string_or(v: flag_value(scan: scan, flag: port_flag), fallback: "8080")
  if (roots |> count) == 0 {
    IntentRefused { refusal: NoSourceRoot }
  } else {
    match admit_release_revision(text: revision_text) {
      Absent => IntentRefused { refusal: ReleaseRevisionMalformed { text: revision_text } }
      Present { value: oid } =>
        match admit_port(text: port_text) {
          Absent => IntentRefused { refusal: ServePortOutOfRange { text: port_text } }
          Present { value: p } =>
            IntentAdmitted {
              intent: RunIntent {
                verb: Serve {
                  selection: selection_of(scan: scan),
                  function: optional_string_or(v: flag_value(scan: scan, flag: function_flag), fallback: "main") as NonEmptyStr,
                  bind: ServeBinding {
                    host: optional_string_or(v: flag_value(scan: scan, flag: host_flag), fallback: "127.0.0.1") as NonEmptyStr,
                    port: p as Port,
                    revision: oid,
                    budget: ServeEvaluationBudget { cpu_limit_ms: none, wall_limit_ms: none },
                  },
                },
                dry_run: flag_present(scan: scan, flag: dry_run_flag),
              },
            }
        }
    }
  }
}

fn admit_compile(scan: ArgvScan) -> IntentAdmission {
  let roots = flag_values(scan: scan, flag: source_root_flag)
  if (roots |> count) == 0 {
    IntentRefused { refusal: NoSourceRoot }
  } else {
    IntentAdmitted {
      intent: RunIntent {
        verb: Compile {
          selection: selection_of(scan: scan),
          output_dir: optional_string_or(v: flag_value(scan: scan, flag: output_dir_flag), fallback: "out") as NonEmptyStr,
          target: optional_string_or(v: flag_value(scan: scan, flag: target_flag), fallback: "rust") as NonEmptyStr,
        },
        dry_run: flag_present(scan: scan, flag: dry_run_flag),
      },
    }
  }
}

fn admit_converge(scan: ArgvScan) -> IntentAdmission {
  IntentAdmitted {
    intent: RunIntent {
      verb: Converge {
        host: optional_string_or(v: flag_value(scan: scan, flag: host_flag), fallback: "self") as NonEmptyStr,
      },
      dry_run: flag_present(scan: scan, flag: dry_run_flag),
    },
  }
}

// `ci` is a PRESET, not a verb: it admits the same Run intent every time, from rows. In the deleted
// seed this was an eleven-line function whose whole body was one call with three literals baked in;
// as data the preset can be read, diffed and re-pointed without opening a handler.
//
// THE SOURCE ROOTS ARE IMPORTED, NOT RESTATED, and an earlier revision of this module got that
// wrong. It declared `ci_preset_source_roots = ["dag", "src/v2"]` -- byte-identical to
// `gunbc.ci_layer_roots` `witness_layer_roots`, which is the single authority for that list and is
// consumed by the witness roster, the compile-clean closure and the divergence census. The deleted
// Rust read that authority LIVE off disk, so the hand-copied row was a REGRESSION dressed as a
// migration: it would have gone stale silently the first time the roots moved, and the CI preset
// would have quietly compiled a different corpus than every other consumer of the same list.
//
// Worth stating because the mistake was mine, made while auditing this exact class elsewhere in the
// cut: replacing a live read with a literal is the §3 fork in its cheapest form, and a migration is
// the moment it is easiest to commit -- the value is right in front of you and copying it typechecks.
fn ci_preset_intent() -> RunIntent {
  RunIntent {
    verb: Run {
      selection: SourceSelection {
        source_roots: witness_layer_roots,
        entry: Present { value: ci_preset_entry as String },
      },
      function: ci_preset_function,
      claim_run: false,
      args: [],
    },
    dry_run: false,
  }
}

// One dispatch over the bare verb token. An unrecognised verb is NOT admitted with a guessed
// reading and NOT widened to a default verb — it refuses, which is why UnknownVerb carries the
// token that produced it.
fn admit_argv(tokens: List<String>) -> IntentAdmission {
  let scan = scan_argv(tokens: tokens)
  let verb = optional_string_or(v: scan.bare |> first, fallback: "")
  if verb == "run" {
    admit_run(scan: scan)
  } else if verb == "serve" {
    admit_serve(scan: scan)
  } else if verb == "compile" {
    admit_compile(scan: scan)
  } else if verb == "converge" {
    admit_converge(scan: scan)
  } else if verb == "ci" {
    IntentAdmitted { intent: ci_preset_intent() }
  } else {
    IntentRefused { refusal: UnknownVerb { token: verb } }
  }
}

// ---------------------------------------------------------------------------
// 7. Projection — the one entry the seed seam calls
// ---------------------------------------------------------------------------

// THE INVERSION, concretely. `gunbc_cli_outcome` is handed the verbosity facts and resolves the
// channel policy ONCE, here, through gunbc.output_policy's existing authority. Nothing downstream
// re-derives it, and no projection in this module owns a resolve. That is the arrangement the
// deleted seed had backwards: there, four diagnostic counters each re-read the blocking policy
// through a private compile.
type RunPlan {
  intent: RunIntent
  output: ChannelPolicy
}

type CliOutcome
  = CliRefused { exit_code: Int, message: String }
  | CliPlanned { plan: RunPlan }

// The seed's observable exit contract is preserved deliberately: 2 for a malformed --arg, 1 for
// every other refusal. That is a user-facing fact rather than one of the functions the ruling threw
// out — scripts and CI steps read these codes, and silently renumbering them would break callers
// this cut has no quarrel with. New refusal classes join the 1 arm rather than inventing codes.
fn refusal_exit_code(r: IntentRefusal) -> Int {
  match r {
    RunArgMissingEquals { token: _ } => 2
    RunArgEmptyName { token: _ } => 2
    NoSourceRoot => 1
    ClaimRunWithoutEntry => 1
    ReleaseRevisionMalformed { text: _ } => 1
    ServePortOutOfRange { text: _ } => 1
    UnknownVerb { token: _ } => 1
  }
}

// Every message names the offending token, because a refusal a user cannot locate costs them the
// same search the diagnostic was supposed to save.
fn refusal_message(r: IntentRefusal) -> String {
  match r {
    NoSourceRoot => "error: provide at least one --source-root"
    ClaimRunWithoutEntry =>
      "error: --claim-run requires --entry <file.dag> (a claim run is scoped to one import closure)"
    RunArgMissingEquals { token: t } =>
      concat(concat("error: --arg ", t), " has no `=`; expected --arg name=value")
    RunArgEmptyName { token: t } =>
      concat(concat("error: --arg ", t), " has an empty name; expected --arg name=value")
    ReleaseRevisionMalformed { text: t } =>
      concat(concat("error: --release-revision ", t), " is not 40 lowercase hex digits (a git commit object name)")
    ServePortOutOfRange { text: t } =>
      concat(concat("error: --port ", t), " is not in 1..65535")
    UnknownVerb { token: t } =>
      concat(concat("error: unknown command ", t), "; expected one of compile, ci, run, converge, serve")
  }
}

fn gunbc_cli_outcome(tokens: List<String>, verbose: Bool, quiet: Bool) -> CliOutcome {
  match admit_argv(tokens: tokens) {
    IntentRefused { refusal: r } =>
      CliRefused { exit_code: refusal_exit_code(r: r), message: refusal_message(r: r) }
    IntentAdmitted { intent: i } =>
      CliPlanned {
        plan: RunPlan { intent: i, output: resolve_channel_policy(verbose: verbose, quiet: quiet) },
      }
  }
}
