module gunbc.megarac_media_model

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.measure { Second, second, second_count }
import std.algebra { list_snoc_item }
import extdeps.bmc.megarac { megarac_no_redirection_session_index }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }
import gunbc.machine_intake.megarac_media_row_reading { boot_run_40264233543_end_media_row }

// THE BMC's VIRTUAL-MEDIA SUBSYSTEM (AMI MegaRAC SP-X): the same controller as gunbc.bmc_model, held as its
// own record because its state -- web sessions, the NFS share binding, the image listing and the presented CD
// -- moves independently of power and IPMI. Pure transitions with time as an input; the wire shapes are
// extdeps.bmc.megarac and extdeps.bmc.megarac_observed_output.
//
// WHICH BUILD THIS WORLD RENDERS, because it is not release-agnostic. A CD that is not presenting reaches the
// wire as a DIFFERENT status per release (the 2026-09-05 probe saw 0 at 0.32; boot runs 40258937016 and
// 40264233543 saw 16 beside session_index 255 at the build the committed ipmitool hpm check reads), and this
// module holds a reading for ONE of them: the build this repository currently reads. Its cleared-row wire
// comes from that read (megarac_cleared_cd_at_the_current_build, sourced from
// gunbc.machine_intake.megarac_media_row_reading), never from a typed literal. A world at another release
// would need that release's cleared-row reading, and nothing here supplies one --
// w_the_media_model_world_renders_the_build_its_cleared_row_was_read_on keeps that asymmetry visible by
// showing this row refused by the 0.32 table.
//
// SESSIONS. POST /api/session opens a session the client holds through its cookie jar and a CSRF
// token; every other route needs both. DELETE /api/session closes it, after which the same cookie and
// token are refused with 401 -- the property the production release check re-observes.
type MegaRacSession {
  cookie_jar: String
  csrf_token: String
  open: Bool
}

type MegaRacShare {
  server: String
  source_path: String
  share_type: String
}

// THE PRESENTED CD, as one configurations row. The statuses the controller has been seen to report: 100
// connecting and 1 started (read at 0.32 in 2026-09-27 and again at this build by the boot runs), and for a
// row that is NOT presenting 0 at 0.32 versus 16 beside session_index 255 at this build -- the divergence
// this module's cleared row now carries. extdeps.bmc.megarac is the table of what each release answers. A
// start leaves the row at a HYPOTHESIZED pair -- this build has never been read in that interval, and
// megarac_start_media_interval carries it as TranscribedUncited with a read_obligation rather than as a
// reading -- and, after the readiness delay, at the started pair this build WAS read as, with a bound
// session index; session index 255 means no session.
// ready_at is when the row between the start and readiness becomes started.
type MegaRacCdRow {
  image_name: String
  redirection_status: Int
  media_index: Int
  session_index: Int
  ready_at: Second?
}

type MegaRacImage {
  image_name: String
  image_index: Int
}

// ready_after is the controller's connecting interval. Observed 2026-09-27 (gunbc.machine_intake.megarac_media_attach
// readiness notes): status 100 at +6s, then 1 with session index 0 from +12s.
type MegaRacMediaWorld {
  sessions: List<MegaRacSession>
  next_session: Int
  share: MegaRacShare
  mount_cd: Int
  cd_error_code: Int
  images: List<MegaRacImage>
  cd: MegaRacCdRow
  ready_after: Second
  withdraw_at: Second?
  withdraw_after_ready: Second?
  error_after_ready: Int?
  error_clears_on_stop: Bool
  stop_at_ready: Int?
}

// THE CLEARED CD ROW AS THE BUILD THE ADMIT GATE SUPPLIES REPORTS IT. This is the release the boot asks the
// media policy with -- gunbc.host.megarac_managed_host builds AdmittedMegaRacHost { firmware: identity.firmware }
// from the reading of the current build -- so the world this module renders has to put that release's wire in the
// CD row, or the policy refuses on a code the build never reported and the attempt never reaches the attach the
// claim is about. The same physical state reaches the wire differently per release: the 2026-09-05 probe saw
// redirection_status 0 at 0.32, and boot runs 40258937016 and 40264233543 saw 16 beside session_index 255 at the
// build the committed hpm check reads. Status and marker come from those reads
// (gunbc.machine_intake.megarac_media_row_reading), not from typed numbers, and
// w_the_boot_fixture_renders_the_cleared_cd_on_the_wire_the_current_build_reports keeps the pairing pinned in
// both directions: Stopped at the release the gate supplies, and an unread code at 0.32.
fn megarac_cleared_cd_at_the_current_build() -> MegaRacCdRow {
  MegaRacCdRow {
    image_name: "",
    redirection_status: boot_run_40264233543_end_media_row.redirection_status,
    media_index: 0,
    session_index: megarac_no_redirection_session_index,
    ready_at: none,
  }
}


fn megarac_session_valid(world: MegaRacMediaWorld, cookie_jar: String, csrf_token: String) -> Bool {
  !all(world.sessions, s => !(s.open && s.cookie_jar == cookie_jar && s.csrf_token == csrf_token))
}

fn megarac_session_by_jar(world: MegaRacMediaWorld, cookie_jar: String) -> Bool {
  !all(world.sessions, s => !(s.open && s.cookie_jar == cookie_jar))
}

fn megarac_with_sessions(world: MegaRacMediaWorld, sessions: List<MegaRacSession>, next_session: Int) -> MegaRacMediaWorld {
  MegaRacMediaWorld { sessions: sessions, next_session: next_session, share: world.share, mount_cd: world.mount_cd, cd_error_code: world.cd_error_code, images: world.images, cd: world.cd, ready_after: world.ready_after, withdraw_at: world.withdraw_at, withdraw_after_ready: world.withdraw_after_ready, error_after_ready: world.error_after_ready, error_clears_on_stop: world.error_clears_on_stop, stop_at_ready: world.stop_at_ready }
}

fn megarac_with_cd(world: MegaRacMediaWorld, cd: MegaRacCdRow) -> MegaRacMediaWorld {
  MegaRacMediaWorld { sessions: world.sessions, next_session: world.next_session, share: world.share, mount_cd: world.mount_cd, cd_error_code: world.cd_error_code, images: world.images, cd: cd, ready_after: world.ready_after, withdraw_at: world.withdraw_at, withdraw_after_ready: world.withdraw_after_ready, error_after_ready: world.error_after_ready, error_clears_on_stop: world.error_clears_on_stop, stop_at_ready: world.stop_at_ready }
}

type MegaRacOpened {
  world: MegaRacMediaWorld
  csrf_token: String
}

fn megarac_open_session(world: MegaRacMediaWorld, cookie_jar: String) -> MegaRacOpened {
  let id = world.next_session
  let token = concat("modeled-csrf-", to_string(id))
  MegaRacOpened {
    world: megarac_with_sessions(world: world, sessions: list_snoc_item(xs: world.sessions, item: MegaRacSession { cookie_jar: cookie_jar, csrf_token: token, open: true }), next_session: id + 1),
    csrf_token: token,
  }
}

fn megarac_close_session(world: MegaRacMediaWorld, cookie_jar: String, csrf_token: String) -> MegaRacMediaWorld {
  megarac_with_sessions(
    world: world,
    sessions: map(world.sessions, s => if s.cookie_jar == cookie_jar && s.csrf_token == csrf_token { MegaRacSession { cookie_jar: s.cookie_jar, csrf_token: s.csrf_token, open: false } } else { s }),
    next_session: world.next_session,
  )
}

fn megarac_image_index(world: MegaRacMediaWorld, image_name: String) -> Int? {
  fold(world.images, init: none, f: fn(acc, i) {
    match acc {
      Present { value: v } => Present { value: v }
      Absent => if i.image_name == image_name { Present { value: i.image_index } } else { none }
    }
  })
}

// WHICH ROW THE START LEAVES BEHIND IS NOT READ ON THE BUILD THIS WORLD RENDERS, so it is carried as a
// MODELED HYPOTHESIS WITH A TYPED STANDING rather than as a reading. What this build has been read
// answering: the started pair (redirection_status 1 beside a bound session index, boot run 40258937016)
// and a row naming an image at 16 beside session_index 255 (boot run 40264233543 -- a LEFTOVER,
// stopped/ejected row read long after any start). NO 0.45 capture covers the interval between a start and
// the started reading; the capture that shows a connecting row there belongs to 0.32 (the 2026-09-27
// re-attach read 100 at +6s, then 1 beside session_index 0 from +12s). So the pair placed in the interval
// is THIS REPOSITORY'S INFERENCE -- the closest pair this unit has been read answering while it is NOT
// presenting -- and the datum below says so with extdeps.external_authority's CitedFigureStanding:
// TranscribedUncited, with a read_obligation naming the read that would ground it.
//
// WHY A STANDING AND NOT A COMMENT. The pair is idle, so it never SATISFIES readiness -- only the started
// pair does, and that pair is read -- but it does decide whether the attempt WAITS or REFUSES, and no
// reader can tell an inferred Int from a read Int at the use site. The standing makes the difference
// machine-visible: w_the_post_start_interval_is_a_hypothesis_with_a_read_obligation goes red the moment the
// datum is re-keyed as observed without the interval read being committed, and
// w_the_boot_reaches_power_under_the_start_interval_hypothesis_and_says_so keeps the executed boot frames
// and the hypothesis named in the same claim. Production attach_readiness is untouched and stays
// fail-closed: on a live boot it reads the real row and refuses on anything uncatalogued, which is exactly
// how boot 7 will ground or falsify this.
type MegaRacModeledCdInterval {
  row: MegaRacCdRow,
  standing: CitedFigureStanding,
}

data megarac_start_media_interval_read_obligation: NonEmptyStr = "Read configurations 0 INSIDE the interval between a successful StartMedia and the started reading, on a live boot at the build this controller reports (boot 7's pre-ready look). Until that read is committed in gunbc.machine_intake.megarac_media_row_reading, the pair below is a model choice about what the row reads while a presentation comes up -- not a 0.45 firmware observation. The 0.45 readings that exist are of a session already started (boot run 40258937016: 1 beside session_index 0) and of a leftover row long after any start (boot run 40264233543: 16 beside session_index 255); neither is a reading of this interval."

data megarac_start_media_interval: MegaRacModeledCdInterval = MegaRacModeledCdInterval {
  row: MegaRacCdRow {
    image_name: "",
    redirection_status: boot_run_40264233543_end_media_row.redirection_status,
    media_index: 0,
    session_index: boot_run_40264233543_end_media_row.session_index,
    ready_at: none,
  },
  standing: TranscribedUncited { read_obligation: megarac_start_media_interval_read_obligation },
}

// A start names an image and its listing index. A start naming an image the listing does not hold changes
// nothing; whether the firmware answers such a start with an error body is not observed, so the adapter
// reports the write as accepted and readiness -- which the production code waits on -- never arrives.
// The interval row comes from megarac_start_media_interval above, and the interval is still TIMED: the wait
// is the scenario's, not an assumption about the controller's answer.
fn megarac_start_media(world: MegaRacMediaWorld, image_name: String, image_index: Int, now: Second) -> MegaRacMediaWorld {
  match megarac_image_index(world: world, image_name: image_name) {
    Present { value: idx } =>
      if idx == image_index {
        let hypothesized = megarac_start_media_interval.row
        megarac_with_cd(world: world, cd: MegaRacCdRow {
          image_name: image_name,
          redirection_status: hypothesized.redirection_status,
          media_index: hypothesized.media_index,
          session_index: hypothesized.session_index,
          ready_at: Present { value: second(count: second_count(s: now) + second_count(s: world.ready_after)) },
        })
      } else { world }
    Absent => world
  }
}

// WHETHER A STOP CLEARS THE CD ERROR CODE IS NOT OBSERVED ON THIS FIRMWARE: the 2026-09-27 receipts show
// cd_error_code 16 standing with nothing presented, and no read after a stop was retained. The model
// takes it as a scenario parameter rather than electing an answer, so the matrix runs both.
fn megarac_stop_media(world: MegaRacMediaWorld) -> MegaRacMediaWorld {
  let stopped = megarac_with_cd(world: world, cd: megarac_cleared_cd_at_the_current_build())
  if world.error_clears_on_stop { megarac_with_error(world: stopped, code: 0) } else { stopped }
}

fn megarac_with_error(world: MegaRacMediaWorld, code: Int) -> MegaRacMediaWorld {
  MegaRacMediaWorld { sessions: world.sessions, next_session: world.next_session, share: world.share, mount_cd: world.mount_cd, cd_error_code: code, images: world.images, cd: world.cd, ready_after: world.ready_after, withdraw_at: world.withdraw_at, withdraw_after_ready: world.withdraw_after_ready, error_after_ready: world.error_after_ready, error_clears_on_stop: world.error_clears_on_stop, stop_at_ready: world.stop_at_ready }
}

// A PRESENTATION CAN BE LOST AFTER IT WAS READY: withdraw_at, when set, is the instant the controller
// drops the presented CD on its own (the NFS export going away, the firmware's retry giving up), after
// which the row reads cleared. The production code re-observes the presentation before the handoff for
// exactly this.
fn megarac_media_advance(world: MegaRacMediaWorld, now: Second) -> MegaRacMediaWorld {
  let readied = megarac_media_ready(world: world, now: now)
  match readied.withdraw_at {
    Absent => readied
    Present { value: at } =>
      if second_count(s: at) <= second_count(s: now) {
        MegaRacMediaWorld { sessions: readied.sessions, next_session: readied.next_session, share: readied.share, mount_cd: readied.mount_cd, cd_error_code: readied.cd_error_code, images: readied.images, cd: megarac_cleared_cd_at_the_current_build(), ready_after: readied.ready_after, withdraw_at: none, withdraw_after_ready: readied.withdraw_after_ready, error_after_ready: readied.error_after_ready, error_clears_on_stop: readied.error_clears_on_stop, stop_at_ready: readied.stop_at_ready }
      } else { readied }
  }
}

// A START THE CONTROLLER ACCEPTS AND THEN DROPS: stop_at_ready, when set, is the code the row falls back
// to Stopped with at the instant it would have become Started -- e.g. a mount
// error for an image the share serves but the controller cannot mount. The row reads cleared and cd_error_code carries the code.
fn megarac_media_ready(world: MegaRacMediaWorld, now: Second) -> MegaRacMediaWorld {
  match world.cd.ready_at {
    Absent => world
    Present { value: at } =>
      if second_count(s: at) <= second_count(s: now) {
        match world.stop_at_ready {
          Present { value: code } => megarac_with_error(world: megarac_with_cd(world: world, cd: megarac_cleared_cd_at_the_current_build()), code: code)
          Absent => megarac_withdrawal_armed(world: megarac_with_cd(world: world, cd: MegaRacCdRow { image_name: world.cd.image_name, redirection_status: 1, media_index: world.cd.media_index, session_index: 0, ready_at: none }), ready: at)
        }
      } else { world }
  }
}

// A scenario may ask for the presentation to be lost a fixed interval after it became ready; the
// instant is armed when readiness arrives, so the loss follows the route rather than a guessed clock.
fn megarac_withdrawal_armed(world: MegaRacMediaWorld, ready: Second) -> MegaRacMediaWorld {
  let errored = match world.error_after_ready { Absent => world Present { value: code } => megarac_with_error(world: world, code: code) }
  megarac_withdrawal_armed_after_error(world: errored, ready: ready)
}

// A CD error code a scenario sets to appear with readiness: the presentation reports Started while the
// general route carries a nonzero cd_error_code, the combination the production pre-handoff recheck
// refuses.
fn megarac_withdrawal_armed_after_error(world: MegaRacMediaWorld, ready: Second) -> MegaRacMediaWorld {
  match world.withdraw_after_ready {
    Absent => world
    Present { value: after } =>
      MegaRacMediaWorld { sessions: world.sessions, next_session: world.next_session, share: world.share, mount_cd: world.mount_cd, cd_error_code: world.cd_error_code, images: world.images, cd: world.cd, ready_after: world.ready_after, withdraw_at: Present { value: second(count: second_count(s: ready) + second_count(s: after)) }, withdraw_after_ready: none, error_after_ready: world.error_after_ready, error_clears_on_stop: world.error_clears_on_stop, stop_at_ready: world.stop_at_ready }
  }
}
