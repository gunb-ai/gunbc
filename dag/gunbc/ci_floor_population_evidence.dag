module gunbc.ci_floor_population_evidence

import std.types { Bool, NonEmptyStr, String, FilePath }
import std.nat { Nat }
import std.content_hash { Sha256Digest }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import extdeps.git.object_store { GitObjectId, git_object_id_from_untagged_hex }
import gunbc.merge_admission_subject { WalkAttemptId, walk_attempt_id }
import gunbc.ci_floor_population_receipt_registry {
  FloorPopulationReceiptKind,
  FloorPopulationReceiptProducerPhase,
  FloorReceiptLocator,
  ci_floor_population_receipt_registry_fingerprint,
}

data ci_floor_population_evidence_note: String = "Attempt-scoped floor-evidence sink (operator ruling on #7785): evidence lives under target/floor-evidence/<WalkAttemptId>/. LocalCiEvidenceSubject has no uploaded-artifact digest. Settlement-required writers go through write_floor_receipt (native seed) and emit ReceiptWriteObservation fragments; finalize joins only that root. Seed finalizer is Scaffold with fingerprint pairing against ci_floor_population_receipt_registry_fingerprint."

data floor_evidence_root_prefix: String = "target/floor-evidence"

fn floor_evidence_root(attempt: WalkAttemptId) -> String {
  concat(concat(floor_evidence_root_prefix, "/"), attempt as String)
}

type LocalCiEvidenceSubjectWire {
  github_run_id: String?,
  github_run_attempt: String?,
  github_job_key: String?,
  head_commit: String?,
  tested_tree: String?,
  walk_attempt_id: String?,
}

type LocalCiEvidenceSubject {
  github_run_id: NonEmptyStr,
  github_run_attempt: NonEmptyStr,
  github_job_key: NonEmptyStr,
  head_commit: GitObjectId,
  tested_tree: GitObjectId,
  walk_attempt_id: WalkAttemptId,
}

type LocalSubjectObservation
  = LocalSubjectObserved { subject: LocalCiEvidenceSubject }
  | LocalSubjectRefused { wire: LocalCiEvidenceSubjectWire, cause: NonEmptyStr }

type UploadedEvidenceBinding {
  local_manifest_digest: Sha256Digest,
  uploaded_artifact_name: NonEmptyStr,
  uploaded_artifact_digest: Sha256Digest,
}

type FloorPhaseStandingExact
  = PhaseNotReached {}
  | PhaseEntered {}
  | PhaseCompleted {}
  | PhaseRefused {}
  | PhaseInterrupted {}
  | PhaseStandingUnknown {}

type ManifestObservationStanding
  = ObservedPresent { size_bytes: Nat, content_digest: Sha256Digest }
  | MissingBeforeProducerReached {}
  | MissingAfterProducerReached {}
  | ProducerInterrupted { detail: NonEmptyStr }
  | NotApplicable { reason: NonEmptyStr }
  | LegacyRediscovered { detail: NonEmptyStr }

type ReceiptWriteObservation {
  kind: FloorPopulationReceiptKind,
  locator: FloorReceiptLocator,
  observed_path: FilePath,
  size_bytes: Nat,
  content_digest: Sha256Digest,
  producer_phase: FloorPopulationReceiptProducerPhase,
  attempt_id: WalkAttemptId,
}

type FloorEvidenceManifestRow {
  kind: FloorPopulationReceiptKind,
  expected_pattern: NonEmptyStr,
  observed_path: FilePath?,
  standing: ManifestObservationStanding,
  producer_phase: FloorPopulationReceiptProducerPhase,
}

type FloorEvidenceManifest {
  schema: NonEmptyStr,
  subject: LocalSubjectObservation,
  rows: List<FloorEvidenceManifestRow>,
  local_manifest_path: FilePath,
  registry_fingerprint: NonEmptyStr,
}

data floor_evidence_manifest_schema: String = "gunbc.ci_floor_population_receipt_manifest.v4"

fn floor_evidence_manifest_relpath(attempt: WalkAttemptId) -> String {
  concat(floor_evidence_root(attempt: attempt), "/manifest.tsv")
}

fn local_subject_wire_incomplete() -> LocalCiEvidenceSubjectWire {
  LocalCiEvidenceSubjectWire {
    github_run_id: none,
    github_run_attempt: none,
    github_job_key: none,
    head_commit: none,
    tested_tree: none,
    walk_attempt_id: none,
  }
}

fn nonempty_opt(raw: String?) -> NonEmptyStr? {
  match raw {
    Absent => none
    Present { value: s } => if s == "" { none } else { Present { value: s as NonEmptyStr } }
  }
}

fn local_subject_from_wire(w: LocalCiEvidenceSubjectWire) -> LocalSubjectObservation {
  match nonempty_opt(raw: w.github_run_id) {
    Absent => LocalSubjectRefused { wire: w, cause: "missing-github_run_id" as NonEmptyStr }
    Present { value: run_id } => match nonempty_opt(raw: w.github_run_attempt) {
      Absent => LocalSubjectRefused { wire: w, cause: "missing-github_run_attempt" as NonEmptyStr }
      Present { value: run_attempt } => match nonempty_opt(raw: w.github_job_key) {
        Absent => LocalSubjectRefused { wire: w, cause: "missing-github_job_key" as NonEmptyStr }
        Present { value: job } => match nonempty_opt(raw: w.head_commit) {
          Absent => LocalSubjectRefused { wire: w, cause: "missing-head_commit" as NonEmptyStr }
          Present { value: head_raw } => match nonempty_opt(raw: w.tested_tree) {
            Absent => LocalSubjectRefused { wire: w, cause: "missing-tested_tree" as NonEmptyStr }
            Present { value: tree_raw } => match nonempty_opt(raw: w.walk_attempt_id) {
              Absent => LocalSubjectRefused { wire: w, cause: "missing-walk_attempt_id" as NonEmptyStr }
              Present { value: walk_raw } => match git_object_id_from_untagged_hex(hex: head_raw as String) {
                Absent => LocalSubjectRefused { wire: w, cause: "invalid-head_commit" as NonEmptyStr }
                Present { value: head } => match git_object_id_from_untagged_hex(hex: tree_raw as String) {
                  Absent => LocalSubjectRefused { wire: w, cause: "invalid-tested_tree" as NonEmptyStr }
                  Present { value: tree } => match walk_attempt_id(raw: walk_raw as String) {
                    Absent => LocalSubjectRefused { wire: w, cause: "invalid-walk_attempt_id" as NonEmptyStr }
                    Present { value: walk } => LocalSubjectObserved {
                      subject: LocalCiEvidenceSubject {
                        github_run_id: run_id,
                        github_run_attempt: run_attempt,
                        github_job_key: job,
                        head_commit: head,
                        tested_tree: tree,
                        walk_attempt_id: walk,
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn standing_join_missing(
  optional_worker: Bool,
  phase_standing: FloorPhaseStandingExact
) -> ManifestObservationStanding {
  match phase_standing {
    PhaseNotReached {} => {
      if optional_worker {
        NotApplicable { reason: "optional-worker-phase-not-reached" as NonEmptyStr }
      } else {
        MissingBeforeProducerReached {}
      }
    }
    PhaseEntered {} => MissingAfterProducerReached {}
    PhaseCompleted {} => MissingAfterProducerReached {}
    PhaseRefused {} => MissingAfterProducerReached {}
    PhaseInterrupted {} => ProducerInterrupted { detail: "phase-journal-interrupted" as NonEmptyStr }
    PhaseStandingUnknown {} => {
      if optional_worker {
        NotApplicable { reason: "optional-worker-phase-unknown" as NonEmptyStr }
      } else {
        MissingBeforeProducerReached {}
      }
    }
  }
}

fn red_stage_never_reached_is_before_not_after() -> Bool {
  match standing_join_missing(optional_worker: false, phase_standing: PhaseNotReached {}) {
    MissingBeforeProducerReached {} => true
    _ => false
  }
}

fn red_stage_completed_missing_receipt_is_after() -> Bool {
  match standing_join_missing(optional_worker: false, phase_standing: PhaseCompleted {}) {
    MissingAfterProducerReached {} => true
    _ => false
  }
}

fn red_interrupted_is_producer_interrupted() -> Bool {
  match standing_join_missing(optional_worker: false, phase_standing: PhaseInterrupted {}) {
    ProducerInterrupted { detail: _ } => true
    _ => false
  }
}

data finalize_floor_evidence_seed_deferral: String = "TRIGGER: claim_executor --finalize-floor-evidence consumes a generated projection of gunbc.ci_floor_population_receipt_registry (emitted Rust rows or registry wire) and write_floor_receipt observation fragments; the hand ROWS mirror and rediscovery path delete. Latest bound: ROADMAP v1-zero-hand-maintained-rust. Fingerprint pairing ci_floor_population_receipt_registry_fingerprint ↔ FLOOR_EVIDENCE_REGISTRY_FINGERPRINT is the interim drift wall."

data finalize_floor_evidence_seed_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_floor_population_evidence",
    decl_name: "finalize_floor_evidence_seed_deferral",
    field: WholeDeclaration
  }
}

fn registry_fingerprint_authority() -> NonEmptyStr {
  ci_floor_population_receipt_registry_fingerprint() as NonEmptyStr
}
