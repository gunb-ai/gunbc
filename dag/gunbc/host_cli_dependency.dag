module gunbc.host_cli_dependency


data host_cli_dependency_authority_note: String = "Host CLI placement for wet witnesses: observe whether an executable is on PATH before attempting shell transport. A missing npm on the falsifier runner surfaced as runtime error: failed to execute npm (os error 2) and classified as WitnessRed — indistinguishable from a subject failure. This module refuses BEFORE execution with a typed wire HostDependencyAbsent with tool and hint fields that claim_executor reads structurally (falsifier recovery PR D, run 31685755058 component 6). ENROLLMENT ANSWER: codex_wet_materialization_host_cli_requirements on this module; absent npm stops as HostDependencyAbsent, never auto-install inside the witness."

data which_path_realization_limit_note: String = "observe_host_cli_dependency keys on shell.PosixCommandV.Check.exists (Bool from exit_success), NOT .path: under WET execution .path is a bare stdout string, not Optional, and matching it raises non-exhaustive pattern match on the healthy path — the Value::Null / Optional realization fork (DESIGN open thread). Same limit as gunbc.roadmap_belt_actuate belt_program_available_note and falsifier-recovery PR A. Resolved path is blocked until the split lands; locality is unestablished. (This module migrated off shell.Which.Check to shell.PosixCommandV.Check -- crisp-wren-896, PR #8590 -- because gunbc.ci_fleet's own CI/falsifier runner carries the identical distro_or_product: none as srv1-4, so the operational apt-install evidence that once justified `which` here does not establish it as a fact the typed model carries; command -v's weaker, dominant assumption holds everywhere `which` did and does not depend on that evidence.)"

data falsifier_run_31685755058_wall_receipt_note: String = "Part-two wall arithmetic CONFIRMED from floor-component-receipt run 31685755058 (not inherited): component 1 cold control wall_ms=3480830 (~58.0 min, 9016 witnesses); component 6 wall_ms=2946579 (~49.1 min, 16 witnesses, npm absent WitnessRed before this PR); components 7-9 outcome=skipped failure_mode=run_incomplete wall_ms=0 witnesses=0 — never executed before the 170-minute step cap. Batch-1 cold-control cost is a separate lane; this PR does not raise deadline/swap/max-parallel."

type HostCliEnrollmentRequirement {
  tool: std.types.NonEmptyStr
  provision: std.types.NonEmptyStr
}

data codex_wet_materialization_host_cli_requirements: std.types.List<HostCliEnrollmentRequirement> = [
  HostCliEnrollmentRequirement {
    tool: "npm" as std.types.NonEmptyStr,
    provision: "apt install npm on falsifier cadence runner image" as std.types.NonEmptyStr,
  },
]

type HostCliDependencyObservation
  = HostCliDependencyPresent
  | HostCliDependencyAbsent { tool: std.types.NonEmptyStr, hint: String }

fn observe_host_cli_dependency(tool: extdeps.tools.CliTool) -> HostCliDependencyObservation {
  let check = shell.PosixCommandV.Check(command: tool.name)  if check.exists {
    HostCliDependencyPresent
  } else {
    HostCliDependencyAbsent {
      tool: tool.name,
      hint: extdeps.tools.install_hint(sources: tool.installable_via),
    }
  }
}

fn cli_tool_for_enrollment_requirement(requirement: HostCliEnrollmentRequirement) -> extdeps.tools.CliTool? {
  if requirement.tool == npm_cli_tool.name {
    v2.std.optional.Present { value: extdeps.tools.npm.npm_cli_tool }
  } else {
    none
  }
}

fn first_absent_codex_wet_materialization_host_cli_dependency() -> HostCliDependencyAbsent? {
  v2.std.algebra.fold_list(
    xs: codex_wet_materialization_host_cli_requirements,
    empty: none,
    cons: fn(acc, requirement) {
      match acc {
        Present { value: found } => v2.std.optional.Present { value: found }
        Absent =>
          match cli_tool_for_enrollment_requirement(requirement: requirement) {
            Present { value: tool } =>
              match observe_host_cli_dependency(tool: tool) {
                HostCliDependencyAbsent { tool: t, hint: h } =>
                  v2.std.optional.Present { value: HostCliDependencyAbsent { tool: t, hint: h } }
                HostCliDependencyPresent => none
              }
            Absent =>
              v2.std.optional.Present {
                value: HostCliDependencyAbsent {
                  tool: requirement.tool,
                  hint: requirement.provision as String,
                },
              }
          }
      }
    },
  )
}

fn host_dependency_absent_wire(tool: std.types.NonEmptyStr, hint: String) -> String {
  concat(
    "HostDependencyAbsent\{tool=",
    concat(tool as String, concat(",hint=", concat(hint, "\}"))),
  )
}

fn host_cli_dependency_failure_receipt(
  observation: HostCliDependencyObservation,
) -> v2.std.optional.Optional<String> {
  match observation {
    HostCliDependencyPresent => v2.std.optional.optional_absent()
    HostCliDependencyAbsent { tool, hint } =>
      v2.std.optional.optional_present(value: host_dependency_absent_wire(tool: tool, hint: hint))
  }
}
