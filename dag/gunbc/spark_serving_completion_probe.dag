module gunbc.spark_serving_completion_probe

import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.types { String, NonEmptyStr, Bool }
import std.algebra { trim }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.ssh.session { ssh_session_exec_portable_words_with_stdin }
import extdeps.exec.command { shell_quote }
import extdeps.ollama.api { ollama_default_port }
import gunbc.clock_read { clock_now_probed_at }
import gunbc.fleet_reach_endpoint { fleet_probe_endpoint_for }
import gunbc.fleet_known_hosts_anchor {
  FleetSshExecutionContext,
  fleet_ssh_attempt_identity,
  fleet_ssh_execution_context_of,
  materialize_fleet_known_hosts_anchor,
  known_hosts_materialization_receipt,
  SshTarget,
  portable_remote_words,
  shape_fleet_ssh_exec,
}
import gunbc.fleet_multi_principal_probe { fleet_ssh_attempt_raw_from_env }
import gunbc.spark_credential_workflow { run_with_materialized_fleet_ssh_binding }
import gunbc.auth.access_token_source { GcloudPrintToken }
import gunbc.spark_serving_install_paths {
  spark_serving_automation_login,
  spark_serving_desired_model_wire,
}
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }

data spark_serving_completion_probe_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: spark_serving_completion_probe — concat-built /api/generate acceptance shell over FleetSsh sh -s; DISSOLVES WHEN typed observe/ensure/read-back host effects replace the probe script (same class as host_spark_serving_provision_script).")

data spark_serving_completion_probe_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.spark_serving_completion_probe",
    decl_name: "spark_serving_completion_probe_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data spark_serving_completion_probe_note: String = "Acceptance probe for SPARK-SERVE-INSTALL-0: POST /api/generate over FleetSsh sh -s. Interim concat shell (scaffold registered above); not routed through host_effect_apply because FleetSsh refuses script bodies at run_shell_transport — same interim transport class as spark_serving_observe_wet, not the deleted gunbc#8073 GHA workflow sidecars. Does not install; path inoperative on srv5/srv6 until gunbc lands on target."

data spark_serving_completion_probe_receipt_path: String = "target/spark-serving-completion-probe-receipt.txt"

fn spark_serving_generate_probe_script() -> String {
  let model_wire = spark_serving_desired_model_wire()
  let api_port = to_string(ollama_default_port)
  let generate_body = join(
    ["{\"model\":\"", model_wire, "\",\"prompt\":\"Reply with exactly: pong\",\"stream\":false}"],
    "",
  )
  let generate_body_q = shell_quote(arg: generate_body)
  join([
    "set -eu\n",
    join(["resp=$(curl -sf http://127.0.0.1:", api_port, "/api/generate -d ", generate_body_q, ")"], ""),
    "\n",
    "printf '%s\\n' \"$resp\" | grep -F '\"response\"' >/dev/null\n",
    "printf '%s\\n' \"SparkServingCompletionReceipt: generate=ok\"\n",
    "printf '%s\\n' \"$resp\"\n",
  ], "")
}

fn spark_serving_completion_probe_succeeded(stdout: String) -> Bool {
  string_contains(s: stdout, pattern: "SparkServingCompletionReceipt: generate=ok")
}

fn spark_serving_completion_probe_leg(
  context: FleetSshExecutionContext,
  host: String,
) -> String {
  match portable_remote_words(raws: ["sh", "-s"]) {
    Absent => "non-portable remote word"
    Present { value: words } => {
      let r = ssh_session_exec_portable_words_with_stdin(
        client_args: shape_fleet_ssh_exec(
          context: context,
          target: SshTarget {
            endpoint: fleet_probe_endpoint_for(host: host) as NonEmptyStr,
            principal: spark_serving_automation_login() as NonEmptyStr,
          },
          words: words,
        ),
        stdin_payload: spark_serving_generate_probe_script(),
      )
      if r.success && spark_serving_completion_probe_succeeded(stdout: r.stdout) {
        trim(s: r.stdout)
      } else {
        join(["exit=", to_string(r.exit_code), " stdout=", trim(s: r.stdout), " stderr=", trim(s: r.stderr)], "")
      }
    }
  }
}

func spark_serving_completion_probe_for_host(attempt_raw: String, host: String) -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  run_with_materialized_fleet_ssh_binding(
    attempt_raw: attempt_raw,
    token_source: GcloudPrintToken,
    body: fn(binding) {
      match fleet_ssh_attempt_identity(raw: attempt_raw) {
        Absent => exit_failure(reason: "attempt identity is not a safe path segment")
        Present { value: attempt } => {
          let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
          match fleet_ssh_execution_context_of(outcome: materialization, credential: binding) {
            Absent =>
              exit_failure(
                reason: known_hosts_materialization_receipt(outcome: materialization),
              )
            Present { value: context } => {
              let detail = spark_serving_completion_probe_leg(context: context, host: host)
              let body = join([
                "spark serving completion host=", host,
                " at=", now as String, "\n",
                detail, "\n",
              ], "")
              let w = Filesystem.Write(path: spark_serving_completion_probe_receipt_path, content: body)
              if w.success && spark_serving_completion_probe_succeeded(stdout: detail) {
                ExitSuccess
              } else {
                exit_failure(reason: body)
              }
            }
          }
        }
      }
    },
  )
}

func spark_serving_completion_probe_wet(host: String) -> ProcessExit
  uses net: Network
{
  match fleet_ssh_attempt_raw_from_env() {
    Absent =>
      exit_failure(
        reason: "spark_serving_completion_probe_wet requires GUNBC_FLEET_SSH_ATTEMPT_RAW or GitHub GITHUB_RUN_ID+GITHUB_RUN_ATTEMPT env",
      )
    Present { value: attempt_raw } =>
      spark_serving_completion_probe_for_host(attempt_raw: attempt_raw, host: host)
  }
}

func spark_serving_completion_probe_both() -> ProcessExit
  uses net: Network
{
  match fleet_ssh_attempt_raw_from_env() {
    Absent =>
      exit_failure(
        reason: "spark_serving_completion_probe_both requires GUNBC_FLEET_SSH_ATTEMPT_RAW or GitHub GITHUB_RUN_ID+GITHUB_RUN_ATTEMPT env",
      )
    Present { value: attempt_raw } =>
      match spark_serving_completion_probe_for_host(attempt_raw: attempt_raw, host: operator_host_srv5 as String) {
        ExitSuccess =>
          spark_serving_completion_probe_for_host(attempt_raw: attempt_raw, host: operator_host_srv6 as String)
        ExitFailure { code: _, reason: why } =>
          exit_failure(reason: why)
      }
  }
}
