module gunbc.review_verdict


type LlmReviewProvider
  = OpenaiPro
  | Codex
  | Claude
  | Cursor

type ReviewProvider
  = Llm { provider: LlmReviewProvider }
  | HumanReviewer
  | ProviderOther { name: std.types.NonEmptyStr }

type ReviewSource
  = LlmSource
  | Human
  | Policy
  | Unattributed

type PolicyRef {
  id: std.types.NonEmptyStr
  version: std.types.NonEmptyStr
}

type Reviewer
  = AgentReviewer { provider: LlmReviewProvider }
  | HumanSeatReviewer
  | PolicyReviewer { policy: PolicyRef }
  | UnattributedReviewer { provider_name: std.types.NonEmptyStr }

fn reviewer_source(reviewer: Reviewer) -> ReviewSource {
  match reviewer {
    AgentReviewer { provider: _ } => LlmSource
    HumanSeatReviewer => Human
    PolicyReviewer { policy: _ } => Policy
    UnattributedReviewer { provider_name: _ } => Unattributed
  }
}

type ReviewArtifactKind
  = GitHubReview { state: extdeps.github.pulls.ReviewState }
  | GitHubReviewComment
  | GitHubIssueComment
  | DashboardReviewArtifact

type ReviewVerdict
  = Approve
  | ApproveWithComments
  | RequestChanges
  | NeedsHumanTriage
  | NoVerdict

type FindingSeverity
  = Blocking
  | NonBlocking
  | Info

type FindingPriority
  = P0
  | P1
  | P2
  | P3
  | Unprioritized

type VerdictEvidence
  = ExplicitVerdictLine { verdict: ReviewVerdict }
  | GitHubReviewStateEvidence { state: extdeps.github.pulls.ReviewState }
  | BlockingFindingPresent
  | NoBlockingConcernsText
  | HumanOverride { reason: String }
  | TextualVerdictMarker { marker: std.types.NonEmptyStr }

type ReportExtractionState
  = ParsedDiscreteFindings
  | FallbackWholeCommentStored

type ParseDeferredState
  = DeferredCommentNotFound
  | DeferredAmbiguousShaMarker
  | DeferredEmptyComment

type ReviewArtifact {
  artifact_id: std.types.ArtifactId
  reviewer: Reviewer
  kind: ReviewArtifactKind
  repo: std.types.NonEmptyStr
  pr_number: Int

  source_commit_sha: std.types.CommitSha?
  source_url: std.types.NonEmptyStr?
  body_hash: std.content_hash.ContentHash?
  body_text: String
  observed_at: std.types.Timestamp?
}

type ReviewFinding {
  index_in_run: Int
  severity: FindingSeverity
  priority: FindingPriority
  heading: String?
  path: String?
  line: Int?
  body: String
  source_artifact_id: std.types.ArtifactId
}

type ReviewVerdictReport {
  reviewer: Reviewer
  repo: std.types.NonEmptyStr
  pr_number: Int
  head_sha: std.types.CommitSha
  artifact_id: std.types.ArtifactId
  verdict: ReviewVerdict
  extraction_state: ReportExtractionState
  findings: List<ReviewFinding>
  evidence: List<VerdictEvidence>
  parsed_at: std.types.Timestamp?
}

type MergeReadinessTally {
  repo: std.types.NonEmptyStr
  pr_number: Int
  head_sha: std.types.CommitSha

  source_artifact_ids: List<std.types.ArtifactId>
  approval_count: Int
  request_changes_count: Int
  blocking_finding_count: Int
  mergeable_clean: Bool
}

type ReviewVerdictParseRequest {
  artifact: ReviewArtifact
  expected_head_sha: std.types.CommitSha
}

type ReviewVerdictParseResult
  = ParsedReport { report: ReviewVerdictReport }
  | ParseDeferred { state: ParseDeferredState, artifact: ReviewArtifact }

fn is_approving_verdict(verdict: ReviewVerdict) -> Bool {
  match verdict {
    Approve => true
    ApproveWithComments => true
    RequestChanges => false
    NeedsHumanTriage => false
    NoVerdict => false
  }
}

fn is_actionable_finding(finding: ReviewFinding) -> Bool {
  match finding.priority {
    P0 => true
    P1 => true
    P2 => match finding.severity {
      Blocking => true
      NonBlocking => false
      Info => false
    }
    P3 => match finding.severity {
      Blocking => true
      NonBlocking => false
      Info => false
    }
    Unprioritized => match finding.severity {
      Blocking => true
      NonBlocking => false
      Info => false
    }
  }
}

service gunbc.ReviewVerdicts {
  operation Parse {
    input {
      request: ReviewVerdictParseRequest
    }
    output {
      result: ReviewVerdictParseResult
    }
    readonly
  }

  operation Tally {
    input {
      repo: std.types.NonEmptyStr
      pr_number: Int
      head_sha: std.types.CommitSha
      reports: List<ReviewVerdictReport>
      mergeable_clean: Bool
    }
    output {
      tally: MergeReadinessTally
    }
    readonly
  }
}
