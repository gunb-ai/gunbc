module gunbc.stage0_emitted_export_surface_observation

import gunbc.stage0_emitted_population_manifest {
  emitted_export_surface_module_tag,
  emitted_export_surface_declaration_tag,
  emitted_export_surface_manifest_field_separator,
  emitted_export_surface_reexport_tag,
  emitted_population_manifest_line_prefix,
  emitted_population_manifest_line_separator
}
import std.types { String }
import v2.std.algebra { fold_list, length, list_head, HeadAbsent, HeadFound, list_map, list_snoc_item, skip }
import v2.std.collection { List }

// THE READ IS THE STRUCTURAL INVERSE OF THE WRITE, NOT A SECOND PARSER.
//
// `v1.compiler.emit_rust` `emit_emitted_export_surface_manifest` renders one envelope row and two
// projection rows per module as `line_prefix ++ source_module ++ FS ++ target_filename ++ FS ++ tag ++ (FS ++ member)*`, joined by the line
// separator. This recovers them by splitting on that separator, stripping that prefix, and
// splitting the payload on that field separator -- reading every literal from the same authority
// the writer reads (`gunbc.stage0_emitted_population_manifest`). No Rust grammar is involved
// anywhere: the artifact is a `.rs` only so that the regen comparison covers it, which is the
// same trade the population manifest beside it already made and documents.
//
// EVERYTHING HERE IS AN OBSERVATION AND NOTHING HERE IS AN AUTHORITY. The rows recovered below
// say what ONE EMISSION produced; they do not say what a module is supposed to expose. The two
// are different facts with different owners, and a reader that treated this as the contract would
// make the emitter the judge of its own output -- self-consistent, and unable to be wrong.
//
// This module answers WHAT A MODULE OFFERS. The population manifest's reader answers WHICH FILES
// EXIST. They are deliberately separate readers over separate artifacts because they are separate
// facts with separate consumers, not two questions about one table.

// The row kind, as a closed coproduct rather than the tag string it was written as.
//
// The tag is the WIRE spelling and belongs to the grammar; the kind is what a consumer reasons
// about. Keeping the string would push the grammar's vocabulary into every downstream match and
// make an unrecognized tag indistinguishable from a recognized one until someone compared it by
// hand.
type ExportSurfaceRowKind
  = ModuleRow
  | ReexportRow
  | DeclarationRow

// One module's declaration of one axis of its export surface.
//
// `members` may be empty, and an empty list here means DECLARED EMPTY -- the emitter rendered
// this row and the set is genuinely empty. It never means "not observed": a module the artifact
// does not mention has no row at all, which is a different and separately representable state.
// That distinction is the whole reason the writer emits both rows for every module unconditionally.
// `source_module` is the AUTHORED dotted name and is the identity; `target_filename` is the Rust
// module file and is the locator. Both are carried because `module_to_filename` is many-to-one
// (`a.b_c` and `a_b.c` both render `a_b_c`), so joining on the filename would merge two distinct
// modules into one row -- and a consumer refusing on that merge would be reporting a false
// positive it could not distinguish from a real one.
type EmittedExportSurfaceRow {
  source_module: String
  target_filename: String
  kind: ExportSurfaceRowKind
  members: List<String>
}

// The producer's per-module envelope, preserved across the manifest boundary. Consumers reason
// about this value; rows are only the wire representation used by the structural inverse below.
// In particular, an empty `reexports` list is attached to a PRESENT module and cannot be confused
// with a module absent from `modules`.
type EmittedModuleExportSurface {
  source_module: String
  target_filename: String
  reexports: List<String>
  declarations: List<String>
}

// WHETHER THE ARTIFACT WAS READ AT ALL IS A DIFFERENT QUESTION FROM WHAT IT SAID.
//
// A bare `List<EmittedExportSurfaceRow>` cannot distinguish "the emit declared no surfaces" from
// "this was not pointed at the surface manifest" from "a row was malformed and dropped", and all
// three would render as the empty list -- the empty-observation narrow, where an observation that
// could not express its subject is read as the verdict that the subject is absent. Each refusal
// carries its own detail so the remedy is decidable from the value.
type ExportSurfaceObservation
  = ExportSurfaceObserved { modules: List<EmittedModuleExportSurface> }
  | ExportSurfaceUnobserved { detail: String }

type ExportSurfaceRowParse
  = ExportSurfaceRowParsed { row: EmittedExportSurfaceRow }
  | ExportSurfaceRowRefused { detail: String }

fn export_surface_row_kind_for_tag(tag: String) -> ExportSurfaceRowKindLookup {
  if tag == emitted_export_surface_module_tag {
    ExportSurfaceRowKindFound { kind: ModuleRow }
  } else if tag == emitted_export_surface_reexport_tag {
    ExportSurfaceRowKindFound { kind: ReexportRow }
  } else if tag == emitted_export_surface_declaration_tag {
    ExportSurfaceRowKindFound { kind: DeclarationRow }
  } else {
    ExportSurfaceRowKindUnknown
  }
}

type ExportSurfaceRowKindLookup
  = ExportSurfaceRowKindFound { kind: ExportSurfaceRowKind }
  | ExportSurfaceRowKindUnknown

// AN UNRECOGNIZED TAG REFUSES; IT IS NOT SKIPPED.
//
// Every row in this artifact is emitter-produced and carries one of the two declared tags by
// construction, so a third tag is evidence that the reader and the writer disagree about the
// grammar -- exactly the drift this channel exists to make impossible. Dropping it would widen
// the reader to accept a stranger's file quietly and report a partial surface as a complete one,
// which is a narrow rather than a widen and therefore silently uncovered rather than merely
// expensive.
fn export_surface_row_from_payload(payload: String) -> ExportSurfaceRowParse {
  let fields = split(s: payload, delimiter: emitted_export_surface_manifest_field_separator)
  if length(xs: fields) < 3 {
    ExportSurfaceRowRefused {
      detail: concat("export-surface row carries fewer than three fields: ", payload)
    }
  } else {
    let source_module = field_at(fields: fields, index: 0)
    let target_filename = field_at(fields: fields, index: 1)
    let tag = field_at(fields: fields, index: 2)
    match export_surface_row_kind_for_tag(tag: tag) {
      ExportSurfaceRowKindUnknown =>
        ExportSurfaceRowRefused {
          detail: concat(concat("export-surface row carries an unrecognized kind tag ", tag), concat(": ", payload))
        }
      ExportSurfaceRowKindFound { kind: kind } =>
        ExportSurfaceRowParsed {
          row: EmittedExportSurfaceRow {
            source_module: source_module,
            target_filename: target_filename,
            kind: kind,
            members: skip(xs: fields, n: 3)
          }
        }
    }
  }
}

// Positional field access, total by returning the empty string past the end.
//
// It is only ever called after the arity check above, so the past-the-end arm is unreachable from
// this module's own call sites; it exists because the function must be total, not as a fallback
// anyone relies on.
fn field_at(fields: List<String>, index: Int) -> String {
  match list_head(xs: skip(xs: fields, n: index)) {
    HeadFound { value: field } => field
    HeadAbsent => ""
  }
}

fn export_surface_payloads(content: String) -> List<String> {
  let prefix_length = string_length(s: emitted_population_manifest_line_prefix)
  let lines = split(s: content, delimiter: emitted_population_manifest_line_separator)
  list_map(
    xs: filter(
      xs: lines,
      predicate: fn(line) {
        starts_with(s: line, prefix: emitted_population_manifest_line_prefix)
      }
    ),
    f: fn(line) { substring(s: line, start: prefix_length, end: string_length(s: line)) }
  )
}

// A NONEMPTY LINE THAT IS NOT A ROW IS CORRUPTION, AND SKIPPING IT DEFEATS THE WALL BELOW.
//
// `export_surface_payloads` selects the lines carrying the row prefix. Selection is the right
// operation for finding rows and the WRONG one for deciding whether the artifact is intact: a line
// that fails the prefix test was silently dropped, so the row wall below -- which refuses the whole
// observation on a single malformed ROW -- never saw it. The guarantee covered malformed payloads
// and not malformed lines, and the gap sat one gate upstream of the sentence promising it.
//
// The consequence is the exact failure the row wall was written against, reached by another route: a
// manifest whose row was truncated or corrupted still answers ExportSurfaceObserved as long as one
// valid row survives, the affected module is then absent from the join's population, and the census
// reads the absence as agreement. A partial read of this artifact is not a degraded answer, it is a
// wrong one, and it is wrong in the direction that looks clean.
//
// NONEMPTY IS LOAD-BEARING AND IS NOT DEFENSIVENESS. The writer ends the file with a trailing
// separator, so splitting always yields a final empty string. That empty line is an artifact of the
// grammar rather than content, and refusing it would refuse every well-formed manifest -- a wall
// whose only reachable state is red is not strict, it is broken.
fn unexpected_manifest_lines(content: String) -> List<String> {
  filter(
    xs: split(s: content, delimiter: emitted_population_manifest_line_separator),
    predicate: fn(line) {
      line != "" && starts_with(s: line, prefix: emitted_population_manifest_line_prefix) == false
    }
  )
}

type ExportSurfaceRowAccumulator
  = ExportSurfaceRowsSoFar { rows: List<EmittedExportSurfaceRow> }
  | ExportSurfaceRowsRefused { detail: String }

// A SINGLE MALFORMED ROW REFUSES THE WHOLE OBSERVATION, and the first refusal is the one reported.
//
// The alternative -- keep the good rows and note the bad ones -- would hand a consumer a surface
// set that is complete-looking and short, and the consuming census's own coverage check would
// then read the missing module as agreement. A partial read of this artifact is not a degraded
// answer, it is a wrong one.
fn export_surface_rows(content: String) -> ExportSurfaceRowAccumulator {
  match list_head(xs: unexpected_manifest_lines(content: content)) {
    HeadFound { value: unexpected } =>
      ExportSurfaceRowsRefused {
        detail: concat("manifest carries a nonempty line that is not a row, so the artifact is not intact and a missing row would render as agreement: ", unexpected)
      }
    HeadAbsent =>
      export_surface_rows_from_payloads(content: content)
  }
}

fn export_surface_rows_from_payloads(content: String) -> ExportSurfaceRowAccumulator {
  fold_list(
    xs: export_surface_payloads(content: content),
    empty: ExportSurfaceRowsSoFar { rows: [] },
    cons: fn(acc, payload) {
      match acc {
        ExportSurfaceRowsRefused { detail: detail } => ExportSurfaceRowsRefused { detail: detail }
        ExportSurfaceRowsSoFar { rows: rows } =>
          match export_surface_row_from_payload(payload: payload) {
            ExportSurfaceRowRefused { detail: detail } => ExportSurfaceRowsRefused { detail: detail }
            ExportSurfaceRowParsed { row: row } =>
              ExportSurfaceRowsSoFar { rows: list_snoc_item(xs: rows, item: row) }
          }
      }
    }
  )
}

fn rows_of_kind_for_module(rows: List<EmittedExportSurfaceRow>, source_module: String, kind: ExportSurfaceRowKind) -> List<EmittedExportSurfaceRow> {
  filter(xs: rows, predicate: row =>
    row.source_module == source_module
      && match kind {
        ModuleRow => match row.kind { ModuleRow => true  _ => false }
        ReexportRow => match row.kind { ReexportRow => true  _ => false }
        DeclarationRow => match row.kind { DeclarationRow => true  _ => false }
      })
}

fn no_surface_members() -> List<String> {
  []
}

fn members_of_rows(rows: List<EmittedExportSurfaceRow>) -> List<String> {
  fold_list(xs: rows, empty: no_surface_members(), cons: fn(acc, row) {
    fold_list(xs: row.members, empty: acc, cons: fn(inner, member) { list_snoc_item(xs: inner, item: member) })
  })
}

type ExportSurfaceModuleAccumulator
  = ExportSurfaceModulesSoFar { modules: List<EmittedModuleExportSurface> }
  | ExportSurfaceModulesRefused { detail: String }

// Rebuild the typed envelope at the reader boundary exactly once. Every module must carry one
// envelope row and one row for each projection. The total-row equality rejects orphan projection
// rows as well as duplicates; per-module cardinalities keep one module's surplus from masking
// another's deficit.
fn export_surface_modules(rows: List<EmittedExportSurfaceRow>) -> ExportSurfaceModuleAccumulator {
  let module_rows = filter(xs: rows, predicate: row => match row.kind { ModuleRow => true  _ => false })
  let expected_row_count = length(xs: module_rows) + length(xs: module_rows) + length(xs: module_rows)
  if length(xs: rows) != expected_row_count {
    ExportSurfaceModulesRefused { detail: "export-surface manifest must carry exactly one module, reexport, and declaration row per module" }
  } else {
    fold_list(
      xs: module_rows,
      empty: ExportSurfaceModulesSoFar { modules: [] },
      cons: fn(acc, module_row) {
        match acc {
          ExportSurfaceModulesRefused { detail: detail } => ExportSurfaceModulesRefused { detail: detail }
          ExportSurfaceModulesSoFar { modules: modules } => {
            let envelopes = rows_of_kind_for_module(rows: rows, source_module: module_row.source_module, kind: ModuleRow)
            let reexports = rows_of_kind_for_module(rows: rows, source_module: module_row.source_module, kind: ReexportRow)
            let declarations = rows_of_kind_for_module(rows: rows, source_module: module_row.source_module, kind: DeclarationRow)
            let module_rows_all = filter(xs: rows, predicate: row => row.source_module == module_row.source_module)
            let wrong_locator = filter(xs: module_rows_all, predicate: row => row.target_filename != module_row.target_filename)
            if length(xs: envelopes) != 1 || length(xs: reexports) != 1 || length(xs: declarations) != 1 || length(xs: wrong_locator) != 0 || length(xs: module_row.members) != 0 {
              ExportSurfaceModulesRefused { detail: concat("export-surface module envelope is incomplete, duplicated, or inconsistent: ", module_row.source_module) }
            } else {
              ExportSurfaceModulesSoFar {
                modules: list_snoc_item(xs: modules, item: EmittedModuleExportSurface {
                  source_module: module_row.source_module,
                  target_filename: module_row.target_filename,
                  reexports: members_of_rows(rows: reexports),
                  declarations: members_of_rows(rows: declarations)
                })
              }
            }
          }
        }
      }
    )
  }
}

// THE OBSERVATION, WITH ITS TWO IGNORANCE STATES REFUSED BEFORE ANY SURFACE IS REPORTED.
//
// An artifact carrying no prefixed rows is not an emit that exported nothing -- it is not this
// artifact, and reporting an empty surface set for it would be the fabricated plausible output
// the manifest channel exists to end.
fn observe_emitted_export_surface(content: String) -> ExportSurfaceObservation {
  match export_surface_rows(content: content) {
    ExportSurfaceRowsRefused { detail: detail } =>
      ExportSurfaceUnobserved { detail: detail }
    ExportSurfaceRowsSoFar { rows: rows } =>
      if length(xs: rows) == 0 {
        ExportSurfaceUnobserved {
          detail: "the content carried no declared export-surface rows -- it is not the emitted export-surface manifest"
        }
      } else {
        match export_surface_modules(rows: rows) {
          ExportSurfaceModulesRefused { detail: detail } => ExportSurfaceUnobserved { detail: detail }
          ExportSurfaceModulesSoFar { modules: modules } => ExportSurfaceObserved { modules: modules }
        }
      }
  }
}
