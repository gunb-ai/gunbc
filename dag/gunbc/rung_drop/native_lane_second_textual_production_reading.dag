module gunbc.rung_drop.native_lane_second_textual_production_reading

import std.types { List, NonEmptyStr, String }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }

// DECLARED 2026-09-12 (review 64571), NARROWED BY THE SOURCE LAYOUT CUTOVER. The v2-native route used to
// derive its universe inside the emitted compiler by reading the `module` and `import` productions
// TEXTUALLY -- a prefix test and a first-token split -- before any module was prepared.
//
// WHAT WAS DROPPED WAS SINGLE AUTHORITY OVER TWO PRODUCTIONS, and the import half is now restored. The
// lane no longer reads headers or import lines at all: it requests modules by NAME and
// v2.compiler.module_acquisition reads each file once, through the front end, taking the import edges
// from the parse and confirming the `module` line against the name the file was requested by. The
// disagreement the import scan permitted -- `import` followed only by spaces trims to `import`, so a
// prefix test keyed on "import " classified it as no import line and the module it meant to name was
// never walked, NARROWING the closure to a green run over a smaller population -- is closed at the
// reader rather than guarded: the acquirer's witness carries the malformed-import controls, and the
// front end REFUSES the member.
//
// WHAT STANDS IS THE MODULE HEADER READ for the two consumers that hold a source with no acquired name,
// because their subject is exactly the files whose front end refused and which therefore carry no
// parse-derived name: v2.compiler.source_root_eval native_refused_file_module (the module a refused file
// declares) and native_census_modules (the roster a census reports on). A header scan kept for those
// files alone is still a second reader of the `module` production.
//
// THE TRIGGER NAMES WHAT THE CAPABILITY MUST BE SUFFICIENT FOR, per DESIGN section 4b(3): the census
// route must name each source by the name the population read BOUND IT TO (a file's name is its path's,
// source layout R5), so native_lane_declared_module_name is DELETED. A route that kept the scan for
// refused files only would satisfy a weaker sentence and leave the second reading standing for the
// files whose refusals a census exists to report.

data native_lane_second_textual_production_reading_population: FreeSemigroup<String> = FreeSemigroup { head: "v2.compiler.source_root_eval native_lane_declared_module_name — the textual reading of the `module` production", tail: ["v2.compiler.source_root_eval native_refused_file_module — its consumer that names the module a refused file declares", "v2.compiler.source_root_eval native_census_modules — its consumer that names the roster a census reports on"] }

data native_lane_second_textual_production_reading: RungDrop = RungDrop {
  identity: "native_lane_second_textual_production_reading" as NonEmptyStr,
  subject: "single authority over the `module` production, for the census route's file names",
  declared: "2026-09-12",
  standing: Standing { declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "the census route names each source by the name its population read bound it to, so no header text is read" },
    population: Enumerated { members: native_lane_second_textual_production_reading_population },
    restoration_trigger: "The census and refused-file routes carry the module name the population read BOUND each source to (a file's name is its path's, source layout R5) instead of reading the `module` line again, so native_lane_declared_module_name is DELETED. That must be sufficient for BOTH consumers -- native_refused_file_module and native_census_modules -- including for a file whose front end refused: a header scan retained for refused files alone would leave the second reading alive for exactly the files whose refusals a census exists to report."
  } }
}
