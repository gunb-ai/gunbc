import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// The executable-position wall of shell_materialize_operation_argv judged a string-literal argv[0].
// gunbc#14174 moved executables to the ProgramIdentity catalog (a call such as sshpass_program()),
// which the seed materializer cannot evaluate: its InterpContext holds only the entry's import
// closure. The population is census-classified at row identity in
// test.claim.operation_argv_corpus_witness (operation_argv_closed_unevaluated_executable_operations).
