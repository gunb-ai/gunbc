module gunbc.rung_drop.namespace_wave_admission_deleted

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, DeletedWithoutReplacement }
import gunbc.guarantee_rung { MechanicallyPreventable, Mitigatable }

// THE DROP IS DECLARED WITH TYPED FIELDS RATHER THAN PROSE, because the prose arm exists for rows
// that predate the type and nothing here needs it: previous rung, temporary rung, reason,
// population and restoration trigger are all exactly known at the moment of deletion.
//
// WHY THE WALL WAS DELETED RATHER THAN REPAIRED (operator ruling, 2026-09-08). It predicated
// evaluation on reading the BASE revision's declarations with the HEAD compiler, so any change to
// the grammar itself made every file in its own diff unreadable at base and the phase refused in
// proportion to how thoroughly the change succeeded. That is filed as its own class,
// gunbc.recurring_failure_mode.base_readability_gate_refuses_a_grammar_change. The alternative
// repairs were both worse: softening the refusal to an empty base side is the empty-observation
// narrow review 56449 already rejected on this exact function, and keeping the removed keyword as
// a transitional alias to satisfy the gate is the staged migration DESIGN section 3 delete-first
// forbids -- a gate should not settle a language-design question by attrition.
//
// THE TRIGGER NAMES A CAPABILITY, NOT AN ARTIFACT, per section 4b(3): rebuilding this same wall
// would re-earn the same refusal, so what retires this drop is the ability to read a revision's
// declarations under THAT revision's own grammar. Until that exists, any base/head declaration
// comparison is undecidable across a grammar change and a wall built on one is not restorable.

data namespace_wave_admission_deleted: RungDrop = RungDrop {
  identity: "namespace_wave_admission_deleted" as NonEmptyStr,

  subject: "Namespace subject-membership and occurrence-binding delta adjudication",

  declared: "2026-09-08",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: [
      "which modules entered or left each module's subject, per change, at merge-base grain",
      "what each module's transitive import closure gained or lost, carried as blast radius",
      "whether a spelling authored on BOTH sides changed WHICH DECLARATION it admits -- the class with no remaining mechanism at all, because both sides resolve and no other check compares them; the floor observes behavioural change only where a witness exercises the rebound spelling",
      "the stale-transition-admission refusal: a roster row matching no delta is now unpruned rather than refused",
    ],
    restoration_trigger: "The capability of reading a revision's declarations under THAT revision's own grammar -- base-side declaration extraction bound to the compiler of the revision being read, rather than the head compiler applied to base blobs. A base/head comparison is undecidable across a grammar change without it, so a rebuilt wall would re-earn the identical refusal on the next grammar edit.",
  },
}
