module gunbc.rung_drop.v2_native_frontier_off_the_merge_path

import std.types { List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-09-23 (operator ruling via neat-boar-16) as `v2_native_frontier_nightly_cadence`.
// That row was the differently-named drop that gunbc.rung_drop v2_native_route_off_the_merge_path
// pre-authorised as its third option: "a job that runs on a different cadence with its own row".
// The job was the nightly `native-frontier` workflow. It ran `//gunbc/instruments:v2-native-frontier`,
// and gunbc.native_frontier_ratchet judged that run against the committed roster.
//
// RESTATED 2026-09-27: THE NIGHTLY IS DELETED, AND THIS ROW NO LONGER NAMES IT. The operator ruled
// that a nightly nobody checks is deleted rather than repaired. This one never produced a
// measurement. Both of its scheduled runs (2026-09-26 on srv4, 2026-09-27 on srv3) stopped in about
// eleven seconds at the preflight, UserManagerUnreachable. The log reads "Failed to connect to bus:
// No medium found": the job environment carried no user-bus address. Whether the host had a
// lingering manager was never observed. So the mitigation this row originally described never executed. Deleting the job
// lowers nothing that was established (DESIGN section 4b(1)). What the row now describes is the
// state since 2026-09-23 in fact: the ratchet runs when a person invokes the instrument. That is the
// same operator-invoked standing gunbc.rung_drop v2_native_route_off_the_merge_path records for the
// route, so the temporary rung is the same, mitigatable. The identity changes because a row named
// for a job that does not exist would carry one name for two contracts (DESIGN section 3).
//
// WHAT THIS ROW STILL COVERS THAT ITS SIBLING DOES NOT: the ratchet's per-identity verdict against
// gunbc.native_frontier_roster, and the lower bound on what the route can see even when it runs.
// The sibling row covers native_route_admission's clauses. Neither retires the other.

data v2_native_frontier_off_the_merge_path_population: List<String> = [
  "gunbc.native_frontier_ratchet native_frontier_verdict over the whole v2.test.* universe, on every merge candidate (no scheduled run stands in for it: it runs when a person invokes //gunbc/instruments:v2-native-frontier)",
  "the derived v2.test.* universe executed by the emitted-native compiler, on every merge candidate",
  "what the route cannot see even when it runs, so a shrinking roster bounds the frontier from below and never measures it exactly: (i) every refusal inside a module whose FILE the front end refused; (ii) sites under a refused binder, which resolve marks ObservationIncomplete and never visits; (iii) call arguments, which do not reach resolve (gunbc.recurring_failure_mode call_expression_erased_at_v2_body_lowering); and, per identity, every refusal after the FIRST terminal one",
]

data v2_native_frontier_off_the_merge_path: RungDrop = RungDrop {
  identity: "v2_native_frontier_off_the_merge_path" as NonEmptyStr,

  subject: "The v2 native frontier (the ratchet over the emitted-native route's refusals) is not on the merge path; it runs only when a person invokes its instrument",

  declared: "2026-09-23",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: v2_native_frontier_off_the_merge_path_population,
    restoration_trigger: "A REQUIRED merge_group (or per-pull-request) lane that runs //gunbc/instruments:v2-native-frontier and whose red blocks the landing, admitted by a further operator decision (the job roster is closed to growth). That decision must be made from a wall measured on the real runner class, not from a cited one, and the lane must supersede an older run of the same subject. A scheduled run does NOT retire this row: the nightly that stood here from 2026-09-23 to 2026-09-27 never ran past its preflight and was deleted. Neither does a non-required lane: the merge path is the capability this row lost. The lower-bound population (front-end file refusals, ObservationIncomplete under refused binders, call arguments, per-identity refusals after the first) is NOT restored by that lane either. Each of those retires only when the route observes it, and a row naming one of them must be split out rather than retired with this one",
  }
}
