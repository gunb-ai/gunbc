module gunbc.rung_drop.match_arm_guard_seed_interpreter_witnesses_deleted

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, DeletedWithoutReplacement }
import gunbc.guarantee_rung { OutsideTheLadder, MechanicallyPreventable }

// The two witnesses held the seed interpreter's authored match-arm guard behavior at rung 2. v2's
// grammar admits no arm-guard surface the fixtures could be rewritten onto, and the seed
// interpreter is semantics-frozen, so the operator ruled them deleted (relayed by cool-lark-903,
// 2026-10-11). The class is `gunbc.recurring_failure_mode` `interpreter_ignores_match_arm_guards`.
data match_arm_guard_seed_interpreter_witnesses_deleted: RungDrop = RungDrop {
  identity: "match_arm_guard_seed_interpreter_witnesses_deleted" as NonEmptyStr,

  subject: "the seed interpreter's authored match-arm guard evaluation (interpreter_ignores_match_arm_guards): a guarded arm selected whenever its pattern matched",

  declared: "2026-10-11",

  standing: Standing { declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: OutsideTheLadder,
    reason: DeletedWithoutReplacement,
    population: Enumerated { members: FreeSemigroup { head: "test.claim.interpreter_match_guard_witness (deleted: every rejecting-guard RED and admitting control)", tail: ["test.claim.emit.nested_constant_pattern_emission_witness the_interpreter_honors_an_authored_guard_on_a_nested_arm (deleted with its ncp_guarded fixture)"] } },
    restoration_trigger: "the seed interpreter retires: a claim-evaluation route that is not the seed interpreter judges authored arm guards, sufficient that a guard evaluating false never selects its arm and a non-Bool guard refuses, shown by a discriminating RED and an admitting control on that route; until then no executed evidence holds the class",
  } }
}
