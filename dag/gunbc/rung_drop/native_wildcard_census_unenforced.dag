module gunbc.rung_drop.native_wildcard_census_unenforced

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, DerivedBy, ReplacementStaged }
import gunbc.guarantee_rung { OutsideTheLadder, MechanicallyPreventable }
// THE LABEL IS THE ROSTER'S OWN, IMPORTED NOT RESTATED (the witness_deferral_freeze precedent):
// rung_drop_population_is_readable refuses this row unless the label is rostered in
// gunbc.instrument_targets instrument_targets exactly once, so the drop and the census it points at
// cannot drift apart silently.
import gunbc.instrument_targets { nfr_wildcard_census_label }

// ONE RUNG DROP FOR THE WHOLE PRODUCTION WILDCARD POPULATION THE CENSUS MEASURES BUT DOES NOT GATE.
// The population AUTHORITY is the census itself: `gunbc test //gunbc/instruments:nfr-wildcard-census`
// (gunbc.native_census_verb verb `nfr-wildcard-census`, gunbc.instruments.nfr_wildcard_census) walks
// the corpus and derives, per production-scope file, the top-level wildcard arms over closed
// coproducts — the population is DERIVED from that instrument, never restated as a count here (§5).
// The census today is a MEASUREMENT: its verdict travels in the roster's reason strings ("measured
// once, not gated") and in the PR-body MEASURE lines, and a fresh unrostered production wildcard on
// main is caught only when someone re-runs it and reads `unrostered=N`. The exit code exists
// (unrostered+stale+duplicates > 0 exits 1) but no required lane runs the instrument, so a HEAD CAN
// CARRY AN UNROSTERED PRODUCTION WILDCARD AND STILL PASS EVERY REQUIRED CHECK. That gap is a
// guarantee off the ladder, and §5 refuses silence about it: this row declares it.
//
// WHY previous IS NOT THE LADDER. The census has never been a required gate: no rung was held, so
// the climb this row tracks starts OutsideTheLadder. temporary is MechanicallyPreventable because the
// enforcement mechanism is already built — the instrument exits 1 on an unrostered production site —
// and what is missing is only that a required lane RUNS it and a judgment is admitted as a row.
//
// THE TRIGGER NAMES THE CAPABILITY, NOT AN ARTIFACT. Restoring the rung means THE JUDGMENT RUNS
// NATIVELY ON THE REQUIRED PATH: the wildcard-arm census is folded from native `decl_facts` over each
// production subject (the same facts the interpreter dispatches today, not the v1 seed's parse) and is
// judged as an emitted-subject-build row of `gunbc.emitted_subject_build_gate` `emitted_subject_build_rows`,
// so `gunbc test` of that row at a head with an unrostered production wildcard exits nonzero inside the
// required gate bank. Adding the instrument to a workflow by hand does not restore it; the row must
// exist, and a fresh unrostered production wildcard must turn the required lane red (the positive
// control being the same lane green at a rostered head).
data native_wildcard_census_unenforced: RungDrop = RungDrop {
  identity: "native_wildcard_census_unenforced" as NonEmptyStr,

  subject: "The nfr-wildcard-census's unrostered/stale verdict over production top-level wildcard arms over closed coproducts, enforced on no required lane",

  declared: "2026-10-25",

  standing: Standing { declaration: TypedDeclaration {
    previous: OutsideTheLadder,
    temporary: MechanicallyPreventable,
    reason: ReplacementStaged { replacement: "the census's exit-1-on-unrostered judgment exists but executes on no required lane; the staged replacement runs it as a required emitted-subject-build row" },
    population: DerivedBy { label: nfr_wildcard_census_label() },
    restoration_trigger: "THE CAPABILITY: a native decl_facts wildcard-arm census fold — the production-scope wildcard sites of a head, each subject's match arms read from native decl_facts over the closed coproduct's declared constructors — judged as an emitted_subject_build_rows row of gunbc.emitted_subject_build_gate, so an unrostered production wildcard exits the required lane nonzero beside the positive control of a rostered head exiting zero"
  } }
}
