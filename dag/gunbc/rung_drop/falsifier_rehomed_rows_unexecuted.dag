module gunbc.rung_drop.falsifier_rehomed_rows_unexecuted

import std.types { NonEmptyStr, List, String }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, LostAsPassenger, population_from_list }
import gunbc.guarantee_rung { Mitigatable, OutsideTheLadder }
import gunbc.ci.ci_layer_roots {
  RehomedBinWetRow, falsifier_rehomed_bin_wet_rows, falsifier_rehomed_roster_rows
}

// THE DECLARED RUNG DROP for every row re-homed onto the falsifier cadence. Their executor,
// .github/workflows/falsifier.yml, was deleted at 611fd02770 (#8283) and nothing dispatches them;
// FalsifierCadenceJob no longer counts as an executing surface
// (gunbc.commit_workflow enrollment_is_scheduled), so the credit these rows once drew from it is
// withdrawn and this drop states the loss instead. DRAFT: awaiting operator approval outside the
// diff (DESIGN 5).
//
// THE POPULATION IS DERIVED, not copied: the two typed frontiers a re-homed row is declared on,
// falsifier_rehomed_bin_wet_rows (BinWitnessWet rows) and falsifier_rehomed_roster_rows (the commit
// roster rows formerly enrolled on FalsifierCadenceJob). Growing it is a reviewed edit of one of
// those lists. The capability differs from deleted_cadence_reference's (a predict-only comparison),
// so this is deliberately not a waiter of SharedCapability.missing_cadence_category.

fn falsifier_rehomed_identity(r: RehomedBinWetRow) -> String {
  concat(r.entry, concat("::", r.function))
}

fn falsifier_rehomed_rows_unexecuted_population() -> List<String> {
  fold(
    concat(falsifier_rehomed_bin_wet_rows, falsifier_rehomed_roster_rows),
    init: [],
    f: fn(acc, r) { concat(acc, [falsifier_rehomed_identity(r: r)]) }
  )
}

data falsifier_rehomed_rows_unexecuted: RungDrop = RungDrop {
  identity: "falsifier_rehomed_rows_unexecuted" as NonEmptyStr,

  subject: "every row re-homed onto the falsifier cadence: falsifier_rehomed_bin_wet_rows and falsifier_rehomed_roster_rows, whose executor falsifier.yml no longer exists",

  declared: "2026-10-21",

  standing: Standing { declaration: TypedDeclaration {
    previous: Mitigatable,
    temporary: OutsideTheLadder,
    reason: LostAsPassenger { carrier: ".github/workflows/falsifier.yml, deleted at 611fd02770 (#8283)" },
    population: population_from_list(xs: falsifier_rehomed_rows_unexecuted_population()),
    restoration_trigger: "an executor runs these rows to a terminal verdict on a host admitting their effects (candidate: the known-red instrument once parallel queues land), at which point each row is re-enrolled on it or dispositioned"
  } }
}
