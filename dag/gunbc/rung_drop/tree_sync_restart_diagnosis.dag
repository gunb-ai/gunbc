module gunbc.rung_drop.tree_sync_restart_diagnosis

import std.types { NonEmptyStr }
import gunbc.rung_drop {
  RungDrop,
  Standing,
  TypedDeclaration,
  GuaranteeRung,
  Mitigatable,
  RungDropReason,
  DeletedWithoutReplacement,
}

data tree_sync_restart_diagnosis: RungDrop = RungDrop {
  identity: "tree_sync_restart_diagnosis" as NonEmptyStr,

  subject: "tree_sync_restart_step_with_diagnosis synchronous restart failure diagnosis (unit-status tail)",

  declared: "2026-10-09",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: Mitigatable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: [
      "the synchronous restart step on srv1 (tree_sync_unit_name = gunbc-tree-sync.service)",
      "the synchronous restart step on srv2 (tree_sync_unit_name = gunbc-tree-sync.service)",
    ],
    restoration_trigger: "NOT shipped in this PR. A proper restoration requires either (a) realization-layer failure handling in host_effect_realize that invokes gunbc.systemctl_status_read on restart failure, or (b) a typed composite operation in extdeps.systemd that materializes via run_typed_argv_transport (not shell). The drop remains until that work lands and the step rebinds; this PR only removes the shell fallback and declares the loss honestly per DESIGN §4b(3)",
  },
}