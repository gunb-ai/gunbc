module gunbc.rung_drop.identity_cast_closure_inhabitance_off_the_required_gate

import std.types { String, List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import v2.workflow.floor_eval_step_cost_drop { floor_eval_step_cost_drop_identity_cast_closure_inhabitance_rows }

// DECLARED 4b(3) DROP (adhoc-0dc33013-502, gunbc#13489, 2026-10-06). The required-floor identity
// `an_admitted_identity_cast_emits_through_the_closure_route_holds` drove
// emit_closure_from_ingest_located on every required run. On gunbc#13480 run 37486290875 it billed
// 657428 eval steps against the 72300 new-witness budget and blocked every PR whose impact
// selection reached it. The gated rows now discriminate at coercion_cast_crossing over supplied
// Int/Bool atoms. The real door cannot run inside those claims without removing the last execution
// of the path OR overflowing the budget (DESIGN section 3 pairing; DESIGN section 5, no absorbing
// fallback). It lives in v2.test.execution.emit_host_identity_cast_native, outside the required
// gate because the same producer is several times the new-witness envelope (cpu_ms=1835 on that
// receipt) and the native partner also spawns the host build tool.
//
// WHAT IS LOST IS MERGE-TIME EXECUTION OF THE CLOSURE DOOR. A regression that admits Int-as-Bool
// on emit_closure_from_ingest_located, or stops emitting `fn f(x: i32) -> i32`, while the gated
// coercion claims still hold, is caught when this module or its closure is a changed witness, not
// at every merge. When those native claims are planned, they execute, a semantic red or a
// wall-clock crossing still blocks, and only an eval-step overrun is reported as
// EvalStepsOverBudgetUnderDeclaredDrop.
data identity_cast_closure_inhabitance_off_the_required_gate_population: List<String> = floor_eval_step_cost_drop_identity_cast_closure_inhabitance_rows |> map(m => concat(concat(m.identity, ": over the new-witness eval-step budget, rostered in v2.workflow.floor_eval_step_cost_drop floor_eval_step_cost_drop_identity_cast_closure_inhabitance_rows; measured by "), m.measured_by))

data identity_cast_closure_inhabitance_off_the_required_gate: RungDrop = RungDrop {
  identity: "identity_cast_closure_inhabitance_off_the_required_gate" as NonEmptyStr,

  subject: "the admitted Int identity-cast closure-emission inhabitance (source text through v2.compiler.self_host.closure_emission emit_closure_from_ingest_located under the production Rust model, and the witness-less Int-to-Bool refusal at that door) runs only as a changed witness in v2.test.execution.emit_host_identity_cast_native, not in the required gate",

  declared: "2026-10-06",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "emit_closure_from_ingest_located of the identity-cast fixture costing no more than the new-witness eval-step budget on the required path",
    },
    population: identity_cast_closure_inhabitance_off_the_required_gate_population,
    restoration_trigger: "THE CAPABILITY. One claim that runs emit_closure_from_ingest_located on the identity-cast source (admitted Int-as-Int reaching `fn f(x: i32) -> i32` as the only member, and Int-as-Bool refused at find_witness_reason_no_candidate) costs no more than the new-witness eval-step budget on the required path, OR the required gate's budget admits a claim of this cost, so that this inhabitance, unchanged in what it asserts, executes on every required run. WHAT THAT MUST BE SUFFICIENT FOR: a regression that admits a witness-less cast, or stops emitting the admitted one, is visible at merge. Moving the claim into the gate under a raised per-claim exemption, or splitting it so no single claim runs the door, does not retire this row."
  }
}
