data builtin_signature_arity_pairing_fabricates: RungDrop = RungDrop {
  identity: "builtin_signature_arity_pairing_fabricates" as NonEmptyStr,

  subject: "Arity agreement between a declared builtin parameter name and its derived algebra template",

