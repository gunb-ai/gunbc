module gunbc.rung_drop.native_lane_closure_walk_unkeyed_membership

import std.types { List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Retired, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-09-12 (review 64571). The route grows its import closure by folding the fact list
// to test membership, because v2 has no keyed set it can use: v2.compiler.compile
// native_lane_module_reachable answers "is this module named by the frontier" by scanning facts.
//
// WHAT IS DROPPED IS A CONSTRUCTED MEMBERSHIP TEST. A keyed set answers membership by construction;
// a fold answers it by looking, and the looking is priced per round. The fold was moved to once per
// ROUND rather than once per frontier member, which bounds the work at O(rounds x facts x frontier)
// -- A REDUCTION AND NOT A FIX, stated that way because the shape is unchanged and only its
// constant moved. DESIGN section 6's bare-minimum-cost rule says a proven cost-shape defect is
// always fixed regardless of the realized n, and this one is NOT fixed; it is declared.
//
// THE CAPABILITY IS NAMED AND IT IS SOMEONE ELSE'S: a primitive-backed map_insert / map_lookup.
// v2.std.collection map_insert_host_binding binds std.primitives map_insert_contract today with
// nothing delegating to it, so the keyed set cannot be written in v2 yet -- the contract exists and
// its realization does not. gunbc#11121 is that capability by name. WHEN #11121 LANDS, ITS TOUCHER
// RETIRES THIS ROW: the row comes due on the change that supplies the primitive, not on a later
// lane noticing, and not on this PR.
//
// WHY THE TRIGGER IS NOT "map_insert_host_binding EXISTS". It already exists. A trigger satisfied
// by the binding's presence would fire while the walk stayed quadratic, which is the grain mismatch
// DESIGN section 4b(3) names as its own review tell -- a trigger naming less than the capability it
// restores will be satisfied while the capability stays dead.

// THE POPULATION NAMES WHAT THE REPAIR TOUCHED, and every symbol here was checked against the tree
// before this row was pushed. A first version of this list named `native_lane_closure_grow`, which
// exists nowhere -- a section 3 citation defect, and worse in THIS field than elsewhere: 4b(3)
// requires a BOUNDED population, so an unreadable member means whoever discharges the row cannot
// enumerate what to delete. Review 64576 caught it.
data native_lane_closure_walk_unkeyed_membership_population: List<String> = [
  "v2.compiler.compile native_lane_module_reachable — the walk; membership was a per-round fold and is now a keyed lookup",
  "v2.compiler.compile native_lane_closure_modules — its one caller, which now builds the index before the recursion",
  "v2.compiler.compile native_lane_facts_index — the index the repair adds, module to imports, built once",
  "v2.compiler.compile native_lane_module_named — the list scan the walk stopped reaching, DELETED outright by review 64753's repair once the closure-member join moved to native_lane_module_set / native_lane_module_in_set and no caller was left",
]

data native_lane_closure_walk_unkeyed_membership: RungDrop = RungDrop {
  identity: "native_lane_closure_walk_unkeyed_membership" as NonEmptyStr,
  subject: "constructed membership for the route's import-closure walk",
  declared: "2026-09-12",
  standing: Retired {
    trigger_fired: "gunbc#11121 landed as dfac90c3b0 (v2.std.collection primitive-backed map_insert/map_lookup delegates), and THE REPAIR IS IN THE SAME COMMIT AS THIS RETIREMENT: native_lane_module_reachable now looks up imports through an index built once by native_lane_facts_index and answers membership against a carried seen_set, so the walk no longer folds the fact list per round. RETIRING ON THE CAPABILITY ALONE WOULD HAVE BEEN THE 4b(3) INFLATION -- a row marked discharged with the quadratic walk still standing -- which is why the discharge is the repair and not the landing." as NonEmptyStr
  },
  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "a keyed membership set backed by a primitive map_insert / map_lookup realization" },
    population: native_lane_closure_walk_unkeyed_membership_population,
    restoration_trigger: "A realization DELEGATES to std.primitives map_insert_contract so a keyed membership set is writable in v2, and the frontier walk answers membership by key lookup rather than by folding the fact list. That capability is gunbc#11121; the change that lands it is this row's toucher and retires it. The existence of v2.std.collection map_insert_host_binding does NOT satisfy this trigger -- the binding is already present and nothing delegates to it, so a trigger keyed on the binding would fire while the walk stayed quadratic."
  }
}
