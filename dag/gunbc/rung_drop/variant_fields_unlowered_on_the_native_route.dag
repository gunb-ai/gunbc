module gunbc.rung_drop.variant_fields_unlowered_on_the_native_route

import std.types { List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-09-21, AMENDED 2026-09-22 (gunbc#11998; rulings via neat-boar-16 after reviews
// 69768 and 69815). ONE frontier for record and positional variant fields together, because they
// are one fact spelled two ways: the seed lowers `A { v: T }` to a Required field `v` and `A(T)` to
// a Required field "0" (v1.compiler.parse parse_positional_variant_type_fields), and binds pattern
// binders from those fields. On the native route no v2 stage lowers variant fields into declared
// field identities for either spelling: namespace_graft_type_decl_is_fielded sends every fielded
// declaration to the residual forest and body_lower_is_structure_preserved_emitted keeps
// field_decl_block and positional_variant_payload as preserved structure. gunbc#11998 added the
// positional parse row, so `A(T)` now reaches that same preserved state records already had --
// parity, not a new gap.
//
// THE BINDER LOSS, AND WHERE IT IS SILENT. The match-arm lowering keeps a pattern's constructor atom
// and nothing else (body_lower_pattern_atom_optional), so every binder a pattern introduces is
// dropped: `A(x) => x` and `A { v: x } => x` both lower to an arm on `A` whose body names an `x`
// the arm never bound. In the normal case that is LOUD -- resolve refuses the unbound `x`. It is
// SILENT in exactly one case: A MATCH BINDER DROPPED ON THE NATIVE ROUTE THAT SHADOWS AN OUTER NAME
// SILENTLY USES THE OUTER VALUE, because the body's reference then resolves to the enclosing
// binding. Refusing that case needs the dropped binders carried to resolve, a tree shape the real
// binder lowering replaces, so it is declared here rather than built (ruling: declare and defer).
// UNTIL THE TRIGGER FIRES, NOTHING REPORTS A NATIVE TEST PASS THROUGH A DROPPED-BINDER ARM AS
// EVIDENCE: a native verdict whose evaluation crossed such an arm may have read the outer value.

data variant_fields_unlowered_on_the_native_route_population: List<String> = [
  "the native lane (std.compiler_entry SourceRootEvalDriver, gunbc.witness_v2_native_route) -- the only route that lowers bodies through v2.compiler.body_lowering_fold; it is off the merge path as its own declared drop",
  "v2.compiler.body_lowering_fold body_lower_pattern_atom_optional -- every match binder, braced or positional, dropped; silent where the binder name shadows an enclosing or module-level name",
  "v2.compiler.namespace_graft namespace_graft_type_decl_is_fielded -- record and positional variants go to residual_units, no field identities",
  "v2.compiler.body_lowering_fold body_lower_is_structure_preserved_emitted -- dag_surface_field_decl_block and dag_surface_positional_variant_payload preserved unlowered",
]

data variant_fields_unlowered_on_the_native_route: RungDrop = RungDrop {
  identity: "variant_fields_unlowered_on_the_native_route" as NonEmptyStr,
  subject: "native route lowers variant fields, named and positional, into declared field identities and binds match binders from them, the way the seed does",
  declared: "2026-09-21",
  standing: Standing,
  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "Pkg11c lowers match binders: a v2 stage lowers variant fields into declared field identities (named and positional \"0\") and binds match binders from them"
    },
    population: variant_fields_unlowered_on_the_native_route_population,
    restoration_trigger: "Pkg11c lowers match binders: a v2 stage lowers variant fields into declared field identities (named and positional \"0\"), sufficient for the match-arm path to bind every pattern binder, braced or positional, from the field it names, so that no binder is dropped and a shadowing binder shadows. Parsing either spelling without that lowering does not retire this row, and neither does lowering one spelling alone. Until it fires, no native test PASS through a dropped-binder arm is evidence."
  }
}
