module gunbc.rung_drop.main_per_commit_floor_verdict

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { MechanicallyPreventable, Mitigatable }

// DECLARED 2026-09-11 with P0a.1 occupancy grouping (gunbc#10981, review 63340).
// The 2026-08-17 unique-run_id grouping stated that every push to main must finish, because sharing
// one main group drops queued observations. The 2026-09-10 occupancy ruling replaces that key with
// github.ref for push events, so GitHub may replace pending members of the main group. Running
// cancel stays NeverSupersedeRunning. DESIGN 4b(3) requires the drop row beside the change that
// lowers the rung.

data main_per_commit_floor_verdict: RungDrop = RungDrop {
  identity: "main_per_commit_floor_verdict" as NonEmptyStr,

  subject: "every main SHA obtains its own floor/build/native verdict via a unique github.run_id concurrency group",

  declared: "2026-09-11",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "witness_floor_concurrency_group keys push events by github.ref under the 2026-09-10 occupancy ruling; cancel-in-progress stays false"
    },
    population: [
      "push events on refs/heads/main"
    ],
    restoration_trigger: "EITHER (a) fleet cancellation safety is observed -- running_supersession_for_fleet_standing yields SupersedeMutableHeadRuns, so each main SHA's run starts promptly and supersedes only running work -- OR (b) typed affected-set admission is live (P0a.2) so a per-SHA verdict is cheap enough to restore unique-run_id grouping for main. SUFFICIENT FOR: unique-run_id grouping restored on refs/heads/main so every main SHA obtains its own started floor/build/native verdict (per-commit attribution and bisection grain). Neither arm is retired by an artifact: re-adding run_id to the group string without (a) or (b) re-imports occupancy cost; observing fleet-safe running cancel without restoring unique grouping does not restore per-commit attribution. A superseded pending run is not a green verdict and does not discharge this row"
  }
}
