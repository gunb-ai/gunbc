module gunbc.rung_drop.main_per_commit_floor_verdict

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Retired, Enumerated, ReplacementStaged, RetiredTypedDeclaration }
import gunbc.guarantee_rung { MechanicallyPreventable, Mitigatable }

// DECLARED 2026-09-11 with P0a.1 occupancy grouping (gunbc#10981, review 63340).
// RETIRED 2026-09-15 BY ITS OWN TRIGGER, NOT BY ITS ARTIFACT. The trigger asked for a terminal
// adjudication BOUND TO EACH LANDED SHA of every required acceptance obligation, and the merge
// queue supplies exactly that: the required workflow runs on the queue's COMPOSED revision, and
// that revision is the one that lands -- measured, not assumed, on gunb-ai/gunbc runs 34920079447
// and the merge_group runs whose head_sha (4f304608f2c4a0961f4e1dd92a5f98db393f1b4a,
// fe85902a07b...) is the sha main carries afterwards. The group those runs occupy is mg-<sha>
// (gunbc#10981 / gunbc#11052), one member per landing, so no landing's verdict can be replaced by
// another's. The population itself is then removed rather than merely emptied: the push-on-main
// trigger is cut from gunbc.witness.witness_floor_workflow witness_floor_triggers, so a push event on
// refs/heads/main starts no run of this workflow and there is nothing left to supersede.
// THE 2026-09-15 BASIS DIED AND THE CAPABILITY WAS RE-ESTABLISHED ON ANOTHER ROUTE 2026-10-12. The
// merge queue stopped being used (no merge-queue rule in the ruleset; last merge_group run
// 2026-10-09), so from then until gunbc#13791 a landed sha obtained NO terminal verdict at all --
// the trigger had un-fired, and this row read Retired over a false basis. gunbc#13791 restores the
// push-on-main trigger, and a push run takes the run-<id> fallback of witness_floor_group_branches,
// not github.ref: every landed sha is the only member of its own group, so GitHub has no pending
// member to replace and each sha's run reaches its own terminal verdict. That is the capability the
// restoration trigger names (no superseded pending sha), not the run_id string it calls an artifact:
// the discriminating controls are w_concurrency_group_no_longer_groups_push_by_ref and
// w_emitted_workflow_runs_on_push_to_main in the consolidation witness.
// The 2026-08-17 unique-run_id grouping stated that every push to main must finish, because sharing
// one main group drops queued observations. The 2026-09-10 occupancy ruling replaces that key with
// github.ref for push events, so GitHub may replace pending members of the main group. Running
// cancel stays NeverSupersedeRunning. DESIGN 4b(3) requires the drop row beside the change that
// lowers the rung.

data main_per_commit_floor_verdict: RungDrop = RungDrop {
  identity: "main_per_commit_floor_verdict" as NonEmptyStr,

  subject: "every landed main SHA obtains its own terminal verdict for every required acceptance obligation on the workflow",

  declared: "2026-09-11",

  standing: Retired {
    trigger_fired: "2026-10-12 (gunbc#13791) -- every landed main sha obtains its terminal verdict from its own push-on-main run of the required workflow, in a run-<id> concurrency group with no other member, so no pending main sha can be superseded. The 2026-09-15 basis (the merge_group run on the composed revision) lapsed when the merge queue stopped being used, 2026-10-09" as NonEmptyStr,
    declaration: RetiredTypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "witness_floor_concurrency_group keys push events by github.ref under the 2026-09-10 occupancy ruling; cancel-in-progress stays false"
    },
    population_at_retirement: Enumerated { members: FreeSemigroup { head: "push events on refs/heads/main", tail: [] } },
    restoration_trigger: "every superseded pending refs/heads/main SHA receives a terminal adjudication, bound to that SHA, of every required acceptance obligation -- executed and passed, or coverage by a superseding execution proved. SUFFICIENT FOR: per-commit attribution and bisection grain on main, so a SHA GitHub removed while pending is not silent. Fleet cancellation safety (running_supersession_for_fleet_standing restoring pull_request-only running cancel) lives on the running-cancellation axis and does not retire this evidence-grain drop. Re-adding unique run_id to the group string is an artifact and does not discharge the row"
  }
  }
}
