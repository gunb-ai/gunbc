module gunbc.rung_drop.required_live_root_parse_population_withdrawn

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, DeletedWithoutReplacement }
import gunbc.guarantee_rung { MechanicallyPreventable, Mitigatable }

// DECLARED 2026-10-14 ON AN OPERATOR RULING ("ci needs to cut whatever was added recently - its
// broken"): `witnesses` overran its 90-minute timeout, which the operator will not raise. The
// v2-native-cli step had walked `parse-population` over the live `dag` and `src/v2` roots since #13783,
// about 18 minutes per run, and that walk is withdrawn. The verb is still walked over its fixture
// roots, and `check-layout` is still walked over the live roots.

data required_live_root_parse_population_withdrawn: RungDrop = RungDrop {
  identity: "required_live_root_parse_population_withdrawn" as NonEmptyStr,

  subject: "the required-path native parse of every governed module under dag/ and src/v2/",

  declared: "2026-10-14",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: [
    "the parse verdict of every module under dag/ or src/v2/ outside the import closures of the subjects of `gunbc.emitted_subject_build_gate` `emitted_subject_build_rows` (modules inside them are still parsed by the emission they feed): a change can make such a module unparseable with the required context green",
    ],
    restoration_trigger: "THE CAPABILITY: on every pull request, a binary built from an emission of v2 judges on the required path, under the declared-refusal contract of `v2.cli.population_verbs` `parse_population`, the parse verdict of every governed module the change touched, and of the whole governed population when the change touched the parser closure (tokenize, parse, module acquisition and their emitted runtime), with coverage joined by module identity, not by count, inside the job's time budget.",
  }
}
