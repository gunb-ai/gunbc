module gunbc.rung_drop.collection_count_result_stated_int_until_declared_results_are_judged

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { StructurallyImpossible, Mitigatable }

// DECLARED 4b(3) DROP (gunbc#13307, XL-2; reviews 76222 and 76223 asked that it be a row and not prose). The free-monoid
// size row v2 binds a bare `count` to, std.algebra collection_count_shape, states its result as the kernel Int where
// every other size row states std.nat Nat. A Nat size has no negative constructor; an Int-typed size admits one that
// the realizing primitive never produces. The stated Int is the honest result type ONLY because the Nat one cannot yet
// be both honest and judged in v2 infer: (1) an integer literal compared with or passed against a Nat must elaborate
// at the expected type (literal elaboration, gunbc#13320), and (2) a call returning a declared (non-kernel) type must
// have its result judged at the consuming position (gunbc.recurring_failure_mode
// call_result_of_a_declared_return_type_unjudged_in_v2_infer, gunbc#13314). Without (2) a Nat result would leave every
// count result UNJUDGED, which is the larger drop.
data collection_count_result_stated_int_until_declared_results_are_judged: RungDrop = RungDrop {
  identity: "collection_count_result_stated_int_until_declared_results_are_judged" as NonEmptyStr,

  subject: "std.algebra collection_count_shape: the result type of a bare count over a free monoid in v2",

  declared: "2026-10-05",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: StructurallyImpossible,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "collection_count_shape returns std.nat Nat (the template every other size row carries), with integer literals at the consuming positions elaborating at Nat" },
    population: [
      "v2.std.node: the 13 bare count( sites (sizes of edge and child lists), bound to collection_count_shape",
      "v2.std.node_query: the 3 bare count( sites, bound to collection_count_shape",
      "every other bare count( call in src/v2 that binds to collection_count_shape (a bare head no in-scope declaration claims), each typed Int rather than Nat",
      "the SEED's method typing: v1.compiler 04_method reads algebra_templates_for_profile, which includes free_monoid_collection_templates, so a seed method-form count (`xs |> count`, `xs.count()`) over a FreeMonoid is typed by this row's Int (review 76274). The seed grounds std.nat Nat to the kernel integer (gunbc.structural_realization_bindings kernel_grounding_rows), so the REALIZED type of that result is unchanged; the declared type is what is narrowed",
    ],
    restoration_trigger: "BOTH capabilities: v2 infer elaborates an integer literal at an expected type through gunbc.structural_realization_bindings literal_homomorphism_rows (gunbc#13320), AND v2 infer derives and judges a call's result type when the callee returns a declared (non-kernel) type (gunbc.recurring_failure_mode call_result_of_a_declared_return_type_unjudged_in_v2_infer) -- SUFFICIENT FOR collection_count_shape to return std.nat Nat with every count result judged at its consuming position and every literal at those positions written as it is today. Restoration: the row returns Nat and this drop retires.",
  },
}
