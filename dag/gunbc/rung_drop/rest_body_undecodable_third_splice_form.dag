module gunbc.rung_drop.rest_body_undecodable_third_splice_form

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// The Rust test rest_body_undecodable_emitted_cause_test.rs refused any splice of the runtime error
// into a RestBodyUndecodable cause that it did not anticipate (an allow-list over the emitted
// causes). Its replacement, test.claim.rest_body_undecodable_emitted_cause, names two forbidden
// spellings and nothing else, so a third splice form passes undetected. Raised by review 97514.
data rest_body_undecodable_third_splice_form: RungDrop = RungDrop {
  identity: "rest_body_undecodable_third_splice_form" as NonEmptyStr,

  subject: "the emitted RestBodyUndecodable cause: a splice of the runtime error into the cause is detected only in the two spellings the replacement witness excludes",

  declared: "2026-11-23",

  standing: Standing { declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "test.claim.rest_body_undecodable_emitted_cause (two excluded splice spellings, no allow-list)" },
    population: Enumerated { members: FreeSemigroup { head: "an emitted RestBodyUndecodable cause built by a third splice form: a helper call, string concatenation, or a differently named binding of the runtime error", tail: [] } },
    restoration_trigger: "an allow-list claim over the emitted RestBodyUndecodable causes, sufficient that any cause which is not a declared-side constant refuses, as the Rust allow-list did",
  } }
}
