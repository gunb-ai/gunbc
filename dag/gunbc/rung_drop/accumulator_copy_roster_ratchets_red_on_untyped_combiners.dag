module gunbc.rung_drop.accumulator_copy_roster_ratchets_red_on_untyped_combiners

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// THREE OFFLINE ACCUMULATOR-COPY ROSTER RATCHETS ARE RED AND STAY RED, DECLARED (DESIGN 4b(3)).
// v2.test.claim.complexity.accumulator_copy_roster_gate_std roster_std_change_dag_zero_suspects_within_ratchet,
// accumulator_copy_roster_gate_lean_bash roster_lean_zero_suspects_within_ratchet and
// accumulator_copy_roster_gate roster_lens_traversal_zero_suspects_within_ratchet each bound a file's
// ^combiner_unregistered_carrier_reaches refusals by a count ceiling.
//
// THE PREVIOUS RUNG WAS VACUOUS, AND THAT IS STATED RATHER THAN CLAIMED AS A WALL THAT HELD. On main
// before gunbc#13337 the lens bound a generated fold-carrier slot and read no named actual, so it
// reported ZERO findings in all three files: the ratchets were green because the lens saw nothing,
// not because the files were within budget. Restoring the lens (gunbc#13337) made the files visible
// again, and three copied accumulators it then exposed in std.change were fixed in that change. What
// remains -- the population below -- is 25 refusals and no Poly2Suspect.
//
// WHY THE RESIDUE CANNOT BE CLOSED AT COMBINER REGISTRATION, AND WHY THE CEILINGS ARE NOT RE-GROUNDED.
// The lens's subject is the normalized tree, before inference. Its operators canonicalize to
// algebra-generic operations (v2.extdeps.languages.dag dag_surface_operator_canonicalization_member:
// || to lattice_field_join, && to its meet, + to ring_field_add), and whether one copies its carrier
// is a fact about the OPERAND TYPE -- join on a set lattice copies, + on String is the String-carrier
// quadratic -- which that tree does not carry. The named callees (keyed_row_find, op, the threaded
// helpers) likewise need callee facts. Registering them non-copying by symbol would transcribe per
// identity what the substrate should derive, and setting the ceilings to today's counts would make a
// measurement of the current tree its own oracle (DESIGN section 5). Operator ruling via
// clever-crane-847, 2026-10-05: declare the drop.
data accumulator_copy_roster_ratchets_red_on_untyped_combiners: RungDrop = RungDrop {
  identity: "accumulator_copy_roster_ratchets_red_on_untyped_combiners" as NonEmptyStr,

  subject: "the offline accumulator-copy roster ratchets over dag/std/change.dag, src/v2/extdeps/languages/lean.dag and src/v2/lens/complexity_accumulator_copy/analyze.dag (v2.lens.complexity_accumulator_copy.roster_gate file_gate): red on refusals the pre-inference lens cannot decide",

  declared: "2026-10-05",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "the accumulator-copy lens over the inferred tree (operand types and resolved callees), proposed as its own change after gunbc#13337" },
    population: [
      "v2.lens.complexity_accumulator_copy.analyze collect_direct_captures collect_direct_captures combiner_unregistered_carrier_reaches",
      "v2.lens.complexity_accumulator_copy.analyze collect_direct_captures collect_direct_captures combiner_unregistered_carrier_reaches (occurrence 2)",
      "v2.lens.complexity_accumulator_copy.analyze symbol_list_length dag_token_plus combiner_unregistered_carrier_reaches",
      "v2.lens.complexity_accumulator_copy.analyze collect_value_identifiers_into collect_value_identifiers_into combiner_unregistered_carrier_reaches",
      "v2.lens.complexity_accumulator_copy.analyze analyze_children append_findings combiner_unregistered_carrier_reaches",
      "v2.lens.complexity_accumulator_copy.analyze analyze_loop_children append_findings combiner_unregistered_carrier_reaches",
      "v2.lens.complexity_accumulator_copy.analyze count_fold_sites dag_token_plus combiner_unregistered_carrier_reaches",
      "std.change keyed_patch_fold op combiner_unregistered_carrier_reaches",
      "std.change keyed_three_way_patch_append keyed_three_way_patch_insert_entry combiner_unregistered_carrier_reaches",
      "std.change keyed_merge_row_lists keyed_row_find combiner_unregistered_carrier_reaches",
      "std.change keyed_collect_keys dag_token_or_or combiner_unregistered_carrier_reaches",
      "std.change keyed_collect_keys concat combiner_unregistered_carrier_reaches",
      "std.change keyed_two_way_diff op combiner_unregistered_carrier_reaches",
      "std.change keyed_three_way_fold op combiner_unregistered_carrier_reaches",
      "std.change keyed_apply_patch concat combiner_unregistered_carrier_reaches",
      "std.change keyed_apply_patch filter combiner_unregistered_carrier_reaches",
      "std.change keyed_apply_patch filter combiner_unregistered_carrier_reaches (occurrence 2)",
      "std.change keyed_apply_patch keyed_row_find combiner_unregistered_carrier_reaches",
      "std.change keyed_apply_patch concat combiner_unregistered_carrier_reaches (occurrence 2)",
      "std.change keyed_apply_patch filter combiner_unregistered_carrier_reaches (occurrence 3)",
      "std.change keyed_patch_contains_hunk dag_token_or_or combiner_unregistered_carrier_reaches",
      "std.change keyed_patches_equal dag_token_and_and combiner_unregistered_carrier_reaches",
      "std.change keyed_rows_snapshot_equal dag_token_and_and combiner_unregistered_carrier_reaches",
      "v2.extdeps.languages.lean lean_catalog_surface_symbol lean_catalog_surface_symbol_step combiner_unregistered_carrier_reaches",
      "v2.extdeps.languages.lean lean_model_core_inhabitance_decls lean_inhabitance_decl_step combiner_unregistered_carrier_reaches",
    ],
    restoration_trigger: "v2.lens.complexity_accumulator_copy.analyze decides, from the inferred tree, whether a combiner reached by the carrier copies it -- an operator by the algebra its operand type inhabits, a named callee by its resolved declaration -- SUFFICIENT FOR every identity in this population across all three files: each is either classified clean or Poly2Suspect, or still refuses for a reason the inferred tree also cannot decide, and the three ratchets go green on that decision with no ceiling raised. A per-symbol registration, a ceiling re-grounded to a count, or a roster that admits refusals by identity retires nothing"
  }
}
