module gunbc.rung_drop.kit_call_shape_restates_the_home_signature

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, ReplacementStaged }
import gunbc.guarantee_rung { StructurallyGuaranteed, MechanicallyPreventable }

// THE DECLARED RUNG DROP for the migration kit's fixture call shape (DESIGN 4b(3)). The acceptance kit
// (gunbc.namespace_cut.migration_kit) renders a fixture pair that calls the migrated name; the call's parameters and
// result are a fact of the home declaration's signature. A signature reader callable BEFORE the census run does not
// exist (the binding_declaration signature rows exist only after the census, and the fixture is written before it;
// arrow_domain_param_nodes reads a Node the pre-census generator cannot obtain), so the wave supplies the shape as
// typed data on its row (gunbc.namespace_cut.ambient_name_home AmbientNameKitCall), a SECOND AUTHORITY for a fact the
// home declaration already states. It is typed (names, type references naming their declaration), never strings.
//
// WHAT FAILS TOWARD: a shape that disagrees with the signature makes the imported fixture refuse, which the kit reads as
// KitNotRunnable / EmitNotRunnable (a located no-observation), so the drift is mechanically visible and never green.
data kit_call_shape_restates_the_home_signature: RungDrop = RungDrop {
  identity: "kit_call_shape_restates_the_home_signature" as NonEmptyStr,

  subject: "the acceptance kit's fixture call shape (AmbientNameKitCall on each AmbientNameHome row), which restates the migrated declaration's signature",

  declared: "2026-10-23",

  standing: Standing { declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: MechanicallyPreventable,
    reason: ReplacementStaged { replacement: "a signature reader callable by the pre-census fixture generator, deriving params and result from the home declaration" },
    population: Enumerated { members: FreeSemigroup { head: "gunbc.namespace_cut.ambient_name_home ambient_name_homes list_push", tail: [] } },
    restoration_trigger: "a pre-run signature reader exists: a typed reader from a home module's declaration to its arrow domain and codomain callable before the census run. Retire when it exists: AmbientNameKitCall, the KitTypeUseProbe arguments and the row field kit_probe are deleted and the fixture is derived from the declaration. Observed at retirement, not asserted: no AmbientNameHome row carries a kit_probe."
  } }
}
