module gunbc.rung_drop.nat_cast_onto_the_kernel_integer_is_unjudged

import std.types { NonEmptyStr, String }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, ReplacementStaged }
import gunbc.guarantee_rung { StructurallyGuaranteed, Mitigatable }

// THE DECLARED RESIDUAL of the #14769 rework (stern-bat-401's ruling A, 2026-10-24, relayed by tidy-raven-397).
// The rework deletes the spelling-keyed widening table std.coercion carried, whose one row admitted `Nat as Int` by the target's
// SPELLING, and derives crossings between grounded carriers from their extents
// (std.literal_elaboration kernel_grounding_crossing). Under that rule a std.nat Nat cast onto std.integer Int
// is a total widening, but a cast onto the KERNEL Int (std.types Int, the 64-bit integer, no declaration) is
// no inclusion: the naturals are not inside the 64-bit integers. Most corpus `as Int` casts are of that kind,
// #14545's specimen among them. Rather than migrate them in this change, legality for them stays with the
// name-keyed chain in v1.compiler.infer validate_cast (which abstains: Nat is outside dag_cast_rules), and emit
// realizes the cast as the identity, keyed on the source's grounding row and the kernel-minted target by
// identity (v1.compiler.emit cast_source_grounded_onto_target_carrier).
//
// WHY MITIGATABLE AND NOT SILENT, verified by execution on main 06acbbcc48 as the ruling required: a Nat beyond
// the 64-bit range cannot be produced on any route, so the identity never sees one. The v1 interpreter refuses
// Nat `+` and `*` past i64::MAX with IntegerOverflow; the emitted Rust's v1_rt int_add / int_mul panic on the
// same; a Nat literal past i64::MAX refuses at parse. The cast's correctness therefore rests on every Nat
// producer staying checked, which is containment, not a judgment of the cast: rung 1.
//
// THE POPULATION IS A GREP AT A PINNED REVISION (operator ruling of 2026-10-25, via stern-bat-401: no census
// instrument and no seed growth for one; the count is a re-runnable grep with its command written here). A grep
// cannot see a cast's source type, so the figure is an UPPER BOUND: every authored ` as Int` outside a comment,
// of which the casts from a std.nat Nat onto the kernel Int are a subset (it also counts kernel-Int sources,
// refinements, casts onto std.integer Int and fixture text inside string literals).
data nat_cast_onto_the_kernel_integer_is_unjudged_population: FreeSemigroup<String> = FreeSemigroup {
  head: "at most 438 casts, the line count of: git grep -nE ' as Int\\b' dee46864bf8b -- 'dag/*.dag' 'src/v2/*.dag' | grep -vE ':[0-9]+:\\s*//' | wc -l (an upper bound; see the note above)",
  tail: []
}

data nat_cast_onto_the_kernel_integer_is_unjudged: RungDrop = RungDrop {
  identity: "nat_cast_onto_the_kernel_integer_is_unjudged" as NonEmptyStr,

  subject: "an explicit cast whose source settles to the std.nat Nat declaration and whose target is the kernel-minted Int (std.types Int), admitted by the name-keyed chain in v1.compiler.infer validate_cast and realized as the identity by v1.compiler.emit",

  declared: "2026-10-25",

  standing: Standing { declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "a declared, named, checked Nat -> kernel Int conversion (a std.nat or std.integer fn refusing outside the 64-bit range) that every listed site migrates to, after which the cast onto the kernel Int refuses at type check like any other cast from a grounded natural" },
    population: Enumerated { members: nat_cast_onto_the_kernel_integer_is_unjudged_population },
    restoration_trigger: "a declared checked Nat -> kernel Int conversion exists AND a migration census of the casts this row's subject names (by identity: source settling to std.nat Nat, target the kernel-minted Int; this row's grep bounds them from above) finds no remaining site, SUFFICIENT FOR v1.compiler.infer grounded_cast_verdict to refuse a grounded natural onto the kernel Int instead of handing it to the name-keyed chain, and for the kernel-Int arm of v1.compiler.emit cast_source_grounded_onto_target_carrier to be deleted."
  } }
}
