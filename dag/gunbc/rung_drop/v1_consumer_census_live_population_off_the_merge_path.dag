module gunbc.rung_drop.v1_consumer_census_live_population_off_the_merge_path

import std.types { List, NonEmptyStr, String }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// THE DROP. gunbc#11018 made the v1 consumer census's Rust reference population a PRODUCED
// observation (gunbc.rust_item_host_observation head_rust_sources reads git.Inspect.HeadCommit,
// git.Inspect.ListTreePathsAtRevision, git.Inspect.ShowTree and git.Core.Show), replacing four
// hand-named crate roots -- a measurement copied from the tree, the oracle DESIGN section 5
// refuses. The consequence this row declares: v1_consumer_population() now reaches git, and the
// hermetic per-PR floor has no route for it -- no mock case is published for those operations,
// and v2.workflow.floor_changed_witness refuses a CHANGED witness that ends in a route gap unless a
// wet terminal is joined to it, which no lane produces. So the two assertions that read the live
// population on the per-PR floor are DELETED from the hermetic witness file rather than moved to a
// live file: a live file would itself be a changed witness the floor cannot admit (measured on
// gunbc#11018 runs 34589756974 and 34589514940, cause changed_witness_planned_without_terminal_verdict).
//
// PREVIOUS RUNG, stated at its real strength: mechanically preventable, over a population whose
// Rust half was a hand list. The floor executed `!complete && blocking > 0 && blocking < members`
// and the two admission refusals on every push; a push that edited a disposition to make the gate
// admit was blocked. WHAT THAT FLOOR DID NOT CHECK is that the four Rust rows described the tree --
// it checked that the list still said what it said -- which is why the modeling change is right
// and why this row is small rather than absent.
//
// TEMPORARY RUNG: mitigatable. The population is derived from the tree and every arm refuses
// loudly (a host refusal is PopulationUnmeasured, an unattributed line is an uncitable row, an
// unscannable file refuses the population), and the discrimination witnesses stay hermetic on
// planted sources through the same fold -- but NO MERGE-BLOCKING STEP EXECUTES
// v1_consumer_population() OR v1_blocking_consumer_count(). They run when a human runs the
// instrument (gunbc run --entry dag/gunbc/v1/v1_consumer_census.dag --function
// v1_blocking_consumer_count_report), and not otherwise.
data v1_consumer_census_live_population_identities: List<String> = [
  "dag/test/claim/self_host_v1_consumer_census_witness_test.dag::consumer_census_live_transaction_refuses_for_recorded_reasons",
  "dag/test/claim/self_host_v1_consumer_census_witness_test.dag::consumer_census_live_gate_refuses_even_with_every_successor_realized",
]

fn v1_consumer_census_live_population_off_the_merge_path() -> RungDrop {
  RungDrop {
    identity: "v1_consumer_census_live_population_off_the_merge_path" as NonEmptyStr,
    subject: "the v1 consumer census's live population -- v1_consumer_population(), v1_blocking_consumer_count() and the bankruptcy admission gate over them -- executed on the merge path",
    declared: "2026-09-11",
    standing: Standing,
    declaration: TypedDeclaration {
      previous: MechanicallyPreventable,
      temporary: Mitigatable,
      reason: ReplacementStaged { replacement: "gunbc.rust_item_host_observation observe_current_rust_references: the Rust medium of the census is a produced observation of HEAD rather than a hand list, and a produced observation reaches git, which the hermetic per-PR envelope refuses" },
      population: v1_consumer_census_live_population_identities,
      restoration_trigger: "a merge-blocking step that executes a witness reading v1_consumer_population() against the live tree -- either mock_response coverage for git.Inspect.HeadCommit, git.Inspect.ListTreePathsAtRevision and git.Core.Show sufficient for observe_current_rust_references to answer under the hermetic envelope with the assertions re-checked under that mock, or a wet lane on the required path that executes a witness reading v1_consumer_population(). NOT retired by the hermetic planted-source witnesses in self_host_v1_consumer_census_witness_test.dag, which exercise the fold and not the tree; not retired by the operator instrument, which executes when a human chooses to; not retired by re-authoring the named assertions in any witness file, which the floor refuses as a changed witness without a terminal verdict.",
    }
  }
}
