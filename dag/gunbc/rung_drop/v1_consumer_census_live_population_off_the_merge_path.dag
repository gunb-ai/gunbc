module gunbc.rung_drop.v1_consumer_census_live_population_off_the_merge_path

import std.types { List, NonEmptyStr, String }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// THE DROP. gunbc#11018 made the v1 consumer census's Rust reference population a PRODUCED
// observation (gunbc.rust_item_host_observation observe_current_rust_references reads
// git.Inspect.HeadCommit, git.Inspect.ListTreePathsAtRevision and git.Core.Show), replacing four
// hand-named crate roots -- a measurement copied from the tree, the oracle DESIGN section 5
// refuses. The consequence this row declares: v1_consumer_population() now reaches git, the
// hermetic discovery envelope REFUSES a witness that reaches git rather than skipping it, and a
// refusing discovery member fails its whole batch. So the three witnesses that read the live
// population on the per-PR floor moved to a file gunbc.ci_layer_roots excludes from hermetic
// discovery and enrolls in bin_witness_wet_entries -- a roster whose own reason row
// (excl_bin_wet_reason) records that nothing has executed it since 2026-08-15.
//
// PREVIOUS RUNG, stated at its real strength: mechanically preventable, over a population whose
// Rust half was a hand list. The floor executed `!complete && blocking > 0 && blocking < members`
// and the two admission refusals on every push; a push that edited a disposition to make the gate
// admit was blocked. WHAT THAT FLOOR DID NOT CHECK is that the four Rust rows described the tree --
// it checked that the list still said what it said -- which is why the modeling change is right
// and why this row is small rather than absent.
//
// TEMPORARY RUNG: mitigatable. The population is derived from the tree and every arm refuses
// loudly (a host refusal is PopulationUnmeasured, an unattributed line is an uncitable row, an
// unscannable file refuses the population), and the discrimination witnesses stay hermetic on
// planted sources through the same fold -- but NO MERGE-BLOCKING STEP EXECUTES
// v1_consumer_population() OR v1_blocking_consumer_count(). They run when a human runs the
// instrument (gunbc run --entry dag/gunbc/v1/v1_consumer_census.dag --function
// v1_blocking_consumer_count) or the local wet recipe, and not otherwise.
data v1_consumer_census_live_population_identities: List<String> = [
  "dag/test/claim/self_host_v1_consumer_census_live_witness_test.dag::consumer_census_live_transaction_refuses_for_recorded_reasons",
  "dag/test/claim/self_host_v1_consumer_census_live_witness_test.dag::consumer_census_live_gate_refuses_even_with_every_successor_realized",
  "dag/test/claim/self_host_v1_consumer_census_live_witness_test.dag::consumer_census_live_population_carries_the_whole_roster",
  "dag/test/claim/self_host_v1_consumer_census_live_witness_test.dag::consumer_census_live_reference_population_is_produced",
]

fn v1_consumer_census_live_population_off_the_merge_path() -> RungDrop {
  RungDrop {
    identity: "v1_consumer_census_live_population_off_the_merge_path" as NonEmptyStr,
    subject: "the v1 consumer census's live population -- v1_consumer_population(), v1_blocking_consumer_count() and the bankruptcy admission gate over them -- executed on the merge path",
    declared: "2026-09-11",
    standing: Standing,
    declaration: TypedDeclaration {
      previous: MechanicallyPreventable,
      temporary: Mitigatable,
      reason: ReplacementStaged { replacement: "gunbc.rust_item_host_observation observe_current_rust_references: the Rust medium of the census is a produced observation of HEAD rather than a hand list, and a produced observation reaches git, which the hermetic per-PR envelope refuses" },
      population: v1_consumer_census_live_population_identities,
      restoration_trigger: "a merge-blocking step that executes a witness reading v1_consumer_population() against the live tree -- either mock_response coverage for git.Inspect.HeadCommit, git.Inspect.ListTreePathsAtRevision and git.Core.Show sufficient for observe_current_rust_references to answer under the hermetic envelope with the assertions re-checked under that mock, or a wet lane on the required path that executes bin_witness_wet_entries. NOT retired by the hermetic planted-source witnesses in self_host_v1_consumer_census_witness_test.dag, which exercise the fold and not the tree; not retired by the operator instrument, which executes when a human chooses to; not retired by moving the four fns back into the hermetic file, which would fail the batch they sit in.",
    }
  }
}
