module gunbc.rung_drop.identity_cast_route_new_witness_eval_step_cost

import std.types { String, List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import v2.workflow.floor_eval_step_cost_drop { floor_eval_step_cost_drop_identity_cast_route_rows }

// DECLARED 4b(3) DROP (gunbc#13487, 2026-10-06; directed by sharp-raven-357 to restore main). The
// DECLARATION lives here; the POPULATION's authority is `v2.workflow.floor_eval_step_cost_drop`
// `floor_eval_step_cost_drop_identity_cast_route_rows`. It is its own list because growing another
// drop's list is a new drop.
//
// WHAT IS LOST IS ONE WALL, AND THE CLAIM IS UNTOUCHED. The identity stays on the gate: planned,
// executed and measured on every run, its eval_steps recorded; a semantic red and a wall-clock
// crossing still block. Only an eval-step overrun is reported under the declared drop rather than
// refusing. The budget is not raised.
//
// HOW THE STANDING WAS LOST. The claim was carried as single-claim fill debt; gunbc#13388 retired that
// row as BecameSharedByDemand, correctly, because its fixture producer is now demanded by several
// claims. Nothing replaced the standing, and while main could not resolve (the v2.std.optional
// conflict this PR repairs) the floor never reached the claim, so the loss was invisible until the
// repair made the corpus resolve again.
data identity_cast_route_new_witness_eval_step_cost_population: List<String> = floor_eval_step_cost_drop_identity_cast_route_rows |> map(m => concat(concat(m.identity, ": over the new-witness eval-step budget, rostered in v2.workflow.floor_eval_step_cost_drop floor_eval_step_cost_drop_identity_cast_route_rows; measured by "), m.measured_by))

data identity_cast_route_new_witness_eval_step_cost: RungDrop = RungDrop {
  identity: "identity_cast_route_new_witness_eval_step_cost" as NonEmptyStr,

  subject: "new-witness eval-step cost gate over the one real-route claim of the admitted identity cast: it still executes, eval_steps stay recorded, a semantic red and a wall-clock crossing still block; only the eval-step cost-gate rung is lowered",

  declared: "2026-10-06",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "the identity-cast route claims restructured to supplied inputs (DESIGN section 3, a witness discriminates at one interface), keeping exactly one inhabitance claim of the real route",
    },
    population: identity_cast_route_new_witness_eval_step_cost_population,
    restoration_trigger: "THE CAPABILITY: the identity-cast route claims restructured to supplied inputs (DESIGN section 3 witness rule), so that every claim over the route's verdict reads a supplied emission and exactly ONE inhabitance claim executes the real route. WHAT THAT MUST BE SUFFICIENT FOR: that one real-route identity, still emitting the admitted cast through the closure route and still asserting the route, measures under the NewWitnessTier budget that v2.workflow.required_floor claim_ceiling_eval_step_budget derives. Deleting the identity, supplying the emission to the last real-route claim (which removes the last execution of the real path), or relocating it off the required gate satisfies none of it.",
  }
}
