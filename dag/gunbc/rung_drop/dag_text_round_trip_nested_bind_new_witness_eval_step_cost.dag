module gunbc.rung_drop.dag_text_round_trip_nested_bind_new_witness_eval_step_cost

import std.types { String, List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import v2.workflow.floor_eval_step_cost_drop { floor_eval_step_cost_drop_dag_text_round_trip_rows }

// DECLARED 4b(3) DROP (gunbc#13233, 2026-10-04; ruling sharp-raven-357 via the grammar program
// manager). The DECLARATION lives here; the POPULATION's authority is
// `v2.workflow.floor_eval_step_cost_drop` `floor_eval_step_cost_drop_dag_text_round_trip_rows`.
//
// WHAT IS LOST IS ONE WALL, AND THE CLAIMS ARE UNTOUCHED. Both identities stay on the gate: planned,
// executed and measured; a semantic red and a wall-clock crossing still block. Only an eval-step
// overrun is reported under this drop rather than refusing. The budget is not raised.
//
// WHY A DROP AND NOT A SMALLER CLAIM OR A SHARED VERDICT. The two claims were un-bundled from a warm
// producer that ran their round trips at preparation, outside their budget; re-bundling is refused.
// Each already parses the smallest text that exercises its route (two lets: a Bind in the body block,
// a Bind in the value group) once, entering the grammar at `fn_body`. The bill is the parser's honest
// per-token cost: 7 inlined precedence levels each stamp an empty continuation.
data dag_text_round_trip_nested_bind_new_witness_eval_step_cost_population: List<String> = floor_eval_step_cost_drop_dag_text_round_trip_rows |> map(m => concat(concat(m.identity, ": over the new-witness eval-step budget, rostered in v2.workflow.floor_eval_step_cost_drop floor_eval_step_cost_drop_dag_text_round_trip_rows; measured by "), m.measured_by))

data dag_text_round_trip_nested_bind_new_witness_eval_step_cost: RungDrop = RungDrop {
  identity: "dag_text_round_trip_nested_bind_new_witness_eval_step_cost" as NonEmptyStr,

  subject: "new-witness eval-step cost gate over the two nested-Bind text round-trip claims of the dag target (Bind body, Bind value): they still execute, eval_steps stay recorded, a semantic red and a wall-clock crossing still block; only the eval-step cost-gate rung is lowered",

  declared: "2026-10-04",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "honest per-token parse cost: 7 inlined precedence levels each stamp an empty continuation; owner: grammar program (stern-bear-500)",
    },
    population: dag_text_round_trip_nested_bind_new_witness_eval_step_cost_population,
    restoration_trigger: "THE CAPABILITY: a precedence-climbing tree contract (one node per operator application, not one per level), or parse claims evaluated on the native route. WHAT IT MUST BE SUFFICIENT FOR: both identities, still rendering, lexing and parsing their two-Bind text once on the real route, measuring under the NewWitnessTier budget that v2.workflow.required_floor claim_ceiling_eval_step_budget derives. Deleting an identity, shrinking its text below two lets, supplying its parse, or re-bundling it into a shared producer does not satisfy this trigger.",
  }
}
