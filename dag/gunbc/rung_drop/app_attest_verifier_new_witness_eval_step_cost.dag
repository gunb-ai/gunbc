module gunbc.rung_drop.app_attest_verifier_new_witness_eval_step_cost

import std.types { String, List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import v2.workflow.floor_eval_step_cost_drop { floor_eval_step_cost_drop_app_attest_verifier_rows }

// DECLARED 4b(3) DROP (gunbc#11989, 2026-09-22). The DECLARATION lives here; the POPULATION's
// authority is `v2.workflow.floor_eval_step_cost_drop` `floor_eval_step_cost_drop_app_attest_verifier_rows`.
// It is its own list because growing another drop's list is a new drop -- the sibling
// app_attest_interpreted_crypto drop covers the curve and hash PRIMITIVES; this one covers the
// verifier FOLDS over Apple's real objects.
//
// WHAT IS LOST IS ONE WALL, AND THE CLAIMS ARE UNTOUCHED. The six identities are planned, executed
// and measured on every pull request that edits them; a semantic red and a wall-clock crossing
// still block. Only the eval-step overrun is reported as `EvalStepsOverBudgetUnderDeclaredDrop`
// rather than refusing. The budget is not raised.
//
// WHY THE OVERRUN IS NOT THE CLAIM'S SHAPE. Each claim decodes the sample attestation once
// (AttestationDecoded carries the parts, three certificates and authenticator data to every step)
// and asserts one step's verdict; the demand graph has no repeated production to remove. What the
// budget prices is the seed interpreter walking a real 5 KB attestation object and three DER
// certificates one octet at a time. Supplying a decoded certificate or a precomputed nonce as a
// fixture would remove the only execution of the readers over Apple's real bytes on the acceptance
// path (DESIGN section 3, the pairing obligation), so the claims stay and the wall is declared down.
//
// THE P-256 VERIFICATIONS OF THESE WITNESSES ARE NOT MEMBERS: they cross the wall deadline, which
// this drop does not and may not cover; they left the required floor and run on the native row
// `gunbc.auth.approval_device_redemption` `ecdsa_verification_realization_frontier` names.
data app_attest_verifier_new_witness_eval_step_cost_population: List<String> = floor_eval_step_cost_drop_app_attest_verifier_rows |> map(m => concat(concat(m.identity, ": over the new-witness eval-step budget, rostered in v2.workflow.floor_eval_step_cost_drop floor_eval_step_cost_drop_app_attest_verifier_rows; measured by "), m.measured_by))

data app_attest_verifier_new_witness_eval_step_cost: RungDrop = RungDrop {
  identity: "app_attest_verifier_new_witness_eval_step_cost" as NonEmptyStr,

  subject: "new-witness eval-step cost gate over the six App Attest verifier claims that decode Apple's real attestation and assertion objects through the production folds: they still execute, eval_steps stay recorded, a semantic red and a wall-clock crossing still block; only the eval-step cost-gate rung is lowered",

  declared: "2026-09-22",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "the CBOR, DER and SHA-256 readers executing as natively emitted code over the sample objects rather than as interpreted octet-list folds",
    },
    population: app_attest_verifier_new_witness_eval_step_cost_population,
    restoration_trigger: "THE CAPABILITY. MachineWidth<N> reification (gunbc#11819) lets the extdeps.apple.app_attest closure emit, and these six identities execute on the natively emitted route -- the gunbc test instrument row the ecdsa_verification_realization_frontier names -- while each still decodes Apple's real object through the production readers; WHAT THAT MUST BE SUFFICIENT FOR: the verifier folds are exercised over the real sample on the acceptance path with no interpreted octet walk inside a claim frame, and the identities then measure under the NewWitnessTier budget that v2.workflow.required_floor claim_ceiling_eval_step_budget derives, or leave the floor for that native row. Supplying decoded certificates or a precomputed nonce as fixtures, or deleting the identities, satisfies neither.",
  }
}
