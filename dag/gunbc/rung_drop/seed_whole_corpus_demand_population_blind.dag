module gunbc.rung_drop.seed_whole_corpus_demand_population_blind

import std.types { List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Retired, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-09-13 (session nimble-badger-98, direction vivid-bee-814 / fierce-lark-661). The
// .dag authority gunbc.whole_corpus_compile_admission now keys demand on the root compiled --
// WholeCorpusCompileDemand = MeasuredForRoot | UnmeasuredRoot, joined on repository, primary root and
// ordered dependency pools -- and an unmeasured root refuses with its measurement recipe. The v1
// seed, which is the only route that executes the admission before a compile, still realizes the
// deleted population-blind constant: v1_compiler.memory_governor
// DECLARED_WHOLE_CORPUS_COMPILE_MEASURED_DEMAND_BYTES and whole_corpus_compile_admission compare
// every whole-root compile's budget to the public root's peak.
//
// WHAT IS LOST ON THE SEED-MIRROR PATH. test.claim.seed_mirror_constant_lens_witness_test still
// joins that constant's VALUE to the public root's row, and that equality still holds; what it no
// longer establishes is that the seed realizes the authority, because the authority is now a join
// the seed does not perform. So the seed ADMITS a root with no row (another repository, another
// pool set) whose budget clears the public peak, and REFUSES a smaller root on the public root's
// number -- both directions of the defect the model closed, still live at execution. The seed's
// refusal stays typed and located, so the path sits at mitigation, not below the ladder.
//
// WHY A DROP AND NOT A SAME-PR FIX: the model and the seed mirror land separately because any
// src/v1 landing stales every closure receipt taken before it, and the seed's landing is slotted by
// v1 seed maintenance between receipt re-takes.

data seed_whole_corpus_demand_population_blind_population: List<String> = [
  "v1_compiler.memory_governor whole_corpus_compile_admission — every whole-root (PrimaryRoot) compile admitted or refused by v1_compiler.cli_run compile_emission",
  "test.claim.seed_mirror_constant_lens_witness_test seed_mirror_constant_rows — the DECLARED_WHOLE_CORPUS_COMPILE_MEASURED_DEMAND_BYTES row, whose authority_symbol still spells the deleted whole_corpus_compile_measured_peak_demand",
]

data seed_whole_corpus_demand_population_blind: RungDrop = RungDrop {
  identity: "seed_whole_corpus_demand_population_blind" as NonEmptyStr,

  subject: "The v1 seed's whole-corpus compile admission as a realization of gunbc.whole_corpus_compile_admission's per-root demand join",

  declared: "2026-09-13",

  standing: Retired {
    trigger_fired: "The seed admits on the root's own row: v1_compiler.cli_run compile_emission builds the root identity from the declared --repository, the primary root and the ordered pools, reads the repository's generated projection (gunbc.whole_corpus_compile_demand_projection) from --measured-root-demands, refuses an unmeasured root or another repository's projection before indexing, and compares the budget only to that root's peak; v1_compiler.memory_governor tests execute the unmeasured-root red beside the at-peak and one-byte-below controls against the committed projection. The bare seed constant and its lens row are deleted, not re-pinned: the pinning check is the seed tests reading the committed projection, and the projection is held to the rows by the generated-artifact drift gate. THE TRIGGER TEXT WAS REWORDED IN THE SAME CHANGE THAT RETIRES IT, AND SAYS SO: as declared with the model it named the pinning check as the seed-mirror lens joining the seed row to whole_corpus_compile_public_root_demand, which assumed the seed would keep a compiled-in row. The direction ruling on gunbc#11265 (the seed reads the repository projection; the constant and lens row are deleted) removed that artifact; the capability the clause stood for -- an executing check pinning the seed to the row -- is kept and is what fired" as NonEmptyStr,
  },

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "the seed performs the per-root join itself, reading the repository's generated demand projection; the seed constant and its lens row are deleted, and the seed is held to the row by its unit tests over the committed projection and the projection by the generated-artifact drift gate",
    },
    population: seed_whole_corpus_demand_population_blind_population,
    restoration_trigger: "THE SEED ADMITS ON THE ROOT'S OWN ROW: for every whole-root compile v1_compiler.cli_run compile_emission resolves the invocation's root identity (declared repository, primary root, ordered dependency pools) against that repository's measured rows, refuses a root with no MeasuredForRoot row with the recipe-naming UnmeasuredRoot refusal before indexing, and compares the budget only to that root's own peak -- executed by a discriminating red (an unmeasured root refused at a budget above the public peak) beside the positive control (the public root admitted at its peak and refused one byte below); and an EXECUTING CHECK pins what the seed admits on to the authority row, so the seed cannot drift from the row silently. A seed change that renames the constant, or mirrors a row without performing the join, does not satisfy it",
  }
}
