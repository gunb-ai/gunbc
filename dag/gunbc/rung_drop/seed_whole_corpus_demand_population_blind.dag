module gunbc.rung_drop.seed_whole_corpus_demand_population_blind

import std.types { List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-09-13 with the model (gunbc#11227, session nimble-badger-98, direction vivid-bee-814
// / fierce-lark-661). WHAT WAS LOST WHEN IT WAS DECLARED, and is no longer the state: the model keyed
// demand on the root compiled while the v1 seed still compared every whole-root compile's budget to
// one population-blind constant, so the seed admitted a root with no row and refused a smaller root
// on the public root's number. gunbc#11265 removed that loss -- the constant is deleted and the seed
// performs the per-root join -- and THE POPULATION BELOW IS WHAT STILL STANDS, not what was declared.
//
// WHY THE MODEL AND THE SEED LANDED SEPARATELY: any src/v1 landing stales every closure receipt taken
// before it, and the seed's landing is slotted by v1 seed maintenance between receipt re-takes.

// STILL STANDING AFTER THE SEED LANDED THE JOIN, AND WHY (review 65569 on gunbc#11265). The seed now
// admits on the root's own row: it performs the join, refuses an unmeasured root with the recipe, and
// reads the rows as data from the repository's generated projection, which the generated-artifact drift
// gate holds to the .dag rows -- that pin EXECUTES, on every merge candidate, structurally. What does
// NOT yet execute on the acceptance path is the trigger's other half: the seed's discriminating red and
// positive control are v1_compiler.memory_governor unit tests, and cargo unit tests run on no CI step
// (gunbc.rung_drop rust_unit_tests_off_the_merge_path). Retiring this drop on evidence that lives inside
// another standing drop's population would report a rung the executed evidence does not establish, so it
// stays Standing until that half executes on the acceptance path.
data seed_whole_corpus_demand_population_blind_population: List<String> = [
  "v1_compiler.memory_governor tests whole_corpus_compile_unmeasured_root_refuses_naming_the_recipe and whole_corpus_compile_admission_is_tight_at_the_measured_demand -- the seed's discriminating red and positive control for the per-root join, which execute on no acceptance-path step (their home, cargo unit tests, is gunbc.rung_drop rust_unit_tests_off_the_merge_path)",
]

data seed_whole_corpus_demand_population_blind: RungDrop = RungDrop {
  identity: "seed_whole_corpus_demand_population_blind" as NonEmptyStr,

  subject: "The v1 seed's whole-corpus compile admission as a realization of gunbc.whole_corpus_compile_admission's per-root demand join",

  declared: "2026-09-13",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "the seed performs the per-root join itself, reading the repository's generated demand projection; the seed constant and its lens row are deleted, and the seed is held to the row by its unit tests over the committed projection and the projection by the generated-artifact drift gate",
    },
    population: seed_whole_corpus_demand_population_blind_population,
    restoration_trigger: "THE SEED ADMITS ON THE ROOT'S OWN ROW: for every whole-root compile v1_compiler.cli_run compile_emission resolves the invocation's root identity (declared repository, primary root, ordered dependency pools) against that repository's measured rows, refuses a root with no MeasuredForRoot row with the recipe-naming UnmeasuredRoot refusal before indexing, and compares the budget only to that root's own peak -- executed by a discriminating red (an unmeasured root refused at a budget above the public peak) beside the positive control (the public root admitted at its peak and refused one byte below); and an EXECUTING CHECK pins what the seed admits on to the authority row, so the seed cannot drift from the row silently. A seed change that renames the constant, or mirrors a row without performing the join, does not satisfy it",
  }
}
