data node_equality_walk_boundary: RungDrop = RungDrop {
  identity: "node_equality_walk_boundary" as NonEmptyStr,
  subject: "The Edge == guard's walk through v2.std.node Node operands",
  declared: "2026-10-23",
  standing: Standing { declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: OutsideTheLadder,
    reason: ReplacementStaged { replacement: "equality_walk_boundary_declaration_identities stops the guard at Node until its == sites move to the erasure route" },
    population: Enumerated { members: node_equality_walk_boundary_population },
    restoration_trigger: "every listed Node == site compares through the erasure route (node_for_structural_equality or content_hash), after which Node joins the inadmissible-declaration rows and equality_walk_boundary_declaration_identities is deleted",
  } }
}
