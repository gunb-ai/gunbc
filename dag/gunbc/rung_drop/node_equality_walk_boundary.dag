import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, ReplacementStaged }
import gunbc.guarantee_rung { OutsideTheLadder, StructurallyGuaranteed }

// DECLARED 2026-10-23 with the Edge == guard (gunbc#14662). Node is a walk boundary: the guard does
// not descend through Node, so an Edge reachable only through a Node child is compared by == with
// no verdict at the sites below (identified by module and enclosing function).
data node_equality_walk_boundary_population: FreeSemigroup<String> = FreeSemigroup { head: "v2.compiler.body_lowering_fold body_lower_binder_name_behind_shell_optional", tail: [
  "v2.compiler.body_lowering_fold body_lower_exit_walk",
