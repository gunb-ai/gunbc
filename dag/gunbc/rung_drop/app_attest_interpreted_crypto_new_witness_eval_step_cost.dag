module gunbc.rung_drop.app_attest_interpreted_crypto_new_witness_eval_step_cost

import std.types { String, List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import v2.workflow.floor_eval_step_cost_drop { floor_eval_step_cost_drop_interpreted_crypto_rows }

// DECLARED 4b(3) DROP (gunbc#11981, 2026-09-22). The DECLARATION lives here; the POPULATION's
// authority is `v2.workflow.floor_eval_step_cost_drop` `floor_eval_step_cost_drop_interpreted_crypto_rows`.
// It is its own list because growing another drop's list is a new drop.
//
// WHAT IS LOST IS ONE WALL, AND THE CLAIMS ARE UNTOUCHED. The ten identities are planned,
// executed and measured on every pull request that edits them; a semantic red and a wall-clock
// crossing still block. Only the eval-step overrun is reported as
// `EvalStepsOverBudgetUnderDeclaredDrop` rather than refusing. The budget is not raised.
//
// WHY THE OVERRUN IS THE PRIMITIVE'S AND NOT THE CLAIM'S. Each claim evaluates one P-384 curve
// equation over a real Apple key, one doubling-and-addition closure check, or one SHA-384 over a
// FIPS vector: there is no repeated demand and no nested scan to remove -- and that is now a MEASURED claim rather than an asserted one (review 70100). One nested scan DID exist when this sentence was first written: octet_split recomputed count(acc.front) per octet, and curve_admit_point_octets calls it twice per point, so the sentence was false for the two point-octets rows it covered. The scan is removed (the fold carries its index). Removing it moved eval_steps by roughly six hundred out of eight hundred thousand -- upward, in fact, by the index arithmetic -- which is the receipt that the overrun really is the primitive's realization and not the fold's shape. The shape was fixed anyway on DESIGN section 6's ground, that a proven cost-shape defect is always fixed regardless of the realized n, never because the measurement demanded it. What the budget prices is the seed
// interpreter realizing 384-bit field arithmetic as 16-limb bignat folds and SHA-384 as Word64
// pairs, because the interpreter reifies no machine width (decision msg_54c92f2f, 2026-09-21: the
// terminal shape is the natively emitted crypto closure). Supplying the curve check's answer, or
// the digest, as a fixture would remove the only execution of the P-384 parameters and of SHA-384
// on the acceptance path (DESIGN section 3, the pairing obligation), so the claims stay and the
// wall is declared down.
//
// THE THREE P-384 SIGNATURE VERIFICATIONS OF THE SAME WITNESS ARE NOT MEMBERS. They cross the wall
// deadline, which this drop does not and may not cover; they left the required floor and run on the
// native row `gunbc.auth.approval_device_redemption` `ecdsa_verification_realization_frontier` names.
// THE THREE PUBLISHED SHA-384 VECTORS ARE MEMBERS, one per vector, each paired with the mutation
// that discriminates it. An earlier cut of this PR excluded the two single-block vectors because,
// measured ALONE, each sat in the enrolment-margin gate's coin-flip band -- over the 302ms margin
// and at or beside the 500ms per-subject line, where a typed cost-debt admission goes stale and
// blocks. A later cut folded all three into one claim so the summed bill cleared the line; that was
// the gate dodged by aggregation, since the cost then moved with the neighbouring vectors rather
// than with the subject. Paired instead, each vector's claim carries its OWN discriminating red --
// which DESIGN section 4b requires of the rung regardless -- and each measured decisively above the
// line on its own subject. All ten members are admitted at `v2.workflow.floor_cost_debt_admission`
// `floor_cost_debt_typed_admissions`, which keeps them EXECUTING while reporting their CPU.
data app_attest_interpreted_crypto_new_witness_eval_step_cost_population: List<String> = floor_eval_step_cost_drop_interpreted_crypto_rows |> map(m => concat(concat(m.identity, ": over the new-witness eval-step budget, rostered in v2.workflow.floor_eval_step_cost_drop floor_eval_step_cost_drop_interpreted_crypto_rows; measured by "), m.measured_by))

data app_attest_interpreted_crypto_new_witness_eval_step_cost: RungDrop = RungDrop {
  identity: "app_attest_interpreted_crypto_new_witness_eval_step_cost" as NonEmptyStr,

  subject: "new-witness eval-step cost gate over the ten interpreted P-256 and P-384 point and group-law checks and SHA-384 FIPS vectors of the App Attest path: they still execute, eval_steps stay recorded, a semantic red and a wall-clock crossing still block; only the eval-step cost-gate rung is lowered",

  declared: "2026-09-22",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "the P-384 and SHA-384 primitives executing as natively emitted code rather than as interpreted bignat and Word64 folds",
    },
    population: app_attest_interpreted_crypto_new_witness_eval_step_cost_population,
    restoration_trigger: "THE CAPABILITY: gunbc test //gunbc/instruments:native-crypto-vectors EXECUTING ON THE MERGE PATH, i.e. as a phase of a required lane whose red blocks a merge, running these ten identities natively (its cases p256_the_base_point_is_on_the_curve, p384_the_base_point_is_on_the_curve, p384_red_a_point_beside_the_base_point_is_off_the_curve, p384_red_a_point_with_a_coordinate_at_p_is_not_admitted, p384_doubling_and_adding_the_base_point_stay_on_the_curve, p384_red_doubling_an_off_curve_point_stays_off_the_curve, p384_apples_ca_and_root_keys_are_on_the_curve and the sha384_* FIPS cases with their reds) while each still evaluates the real curve equation or the real hash; WHAT THAT MUST BE SUFFICIENT FOR: the P-384 parameters and SHA-384 are exercised on the acceptance path with no interpreted 16-limb fold inside a claim frame, so the interpreted identities can leave the floor for that row, or they measure under the NewWitnessTier budget that v2.workflow.required_floor claim_ceiling_eval_step_budget derives. The same row run BY NAME (as it exists since gunbc#12306) executes the facts natively but is NOT the acceptance path and retires nothing. Supplying the curve check's answer or the digest as a fixture, or deleting the identities, satisfies neither.",
  }
}
