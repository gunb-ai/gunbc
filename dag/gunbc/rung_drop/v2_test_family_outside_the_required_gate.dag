data v2_test_family_outside_the_required_gate: RungDrop = RungDrop {
  identity: "v2_test_family_outside_the_required_gate" as NonEmptyStr,
  subject: "the v2 suite (every v2.test.* claim) executes on the required floor, so a red there blocks a merge",
  declared: "2026-10-01",
  standing: Standing,
  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "required-floor preparation reused across runs or scoped to the change, the restoration trigger of gunbc.rung_drop required_gate_bankruptcy"
    },
    population: v2_test_family_outside_the_required_gate_population,
    restoration_trigger: "the required floor's preparation no longer scales with the static gate: it is reused across runs or scoped to the change, so admitting the v2.test. family adds per-PR cost in proportion to what the change touches rather than the family's whole closure, and v2.test. returns to v2.workflow.required_floor required_gate_prefixes. A faster static preparation, a narrower static family, or enrolling the red rows does not retire this row; each named red identity leaves the population when its fix lands, and the row retires only with the family's return."
  }
}
