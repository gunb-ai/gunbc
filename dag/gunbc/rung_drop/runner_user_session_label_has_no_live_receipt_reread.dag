module gunbc.rung_drop.runner_user_session_label_has_no_live_receipt_reread

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// Grain: freshness of the evidence behind the gunbc-user-session runner label.
//
// WHAT THE LADDER HAD BEFORE: the label a JOB runner advertises says "this host's job account has a
// user manager you can run work under", and a claim like that should sit at MechanicallyPreventable --
// the population that can take a gunbc-user-session job is re-derived from what an instrument OBSERVES,
// so a host that lost the capability loses the label mechanically, on the next observation.
//
// WHERE IT SITS NOW: Mitigatable. The grant (gunbc.runner.runner_registration_labels
// runner_user_session_grant_of_roster) reads the recorded receipt rows (gunbc.runner.runner_user_session_receipt
// runner_user_session_converge_receipt_rows): one row per host, typed in the converge's own reading
// vocabulary, each naming the fleet-converge RUN whose readback it records (srv4's cites run
// 40270496735, mode=runner_user_session_converge, which wrote
// /srv/gunbc/converge/runner-user-session-srv4.json). The row is the right carrier -- typed fields, a
// cited producing run, no prose -- but nothing RE-OBSERVES those readings after the fact. If srv4 is
// re-imaged, someone runs loginctl disable-linger, or its job_user changes, the recorded row keeps
// holding and the label keeps being advertised: a job selecting gunbc-user-session lands on a host
// with no user manager, and the failure surfaces there rather than in the fleet (DESIGN 5's silent
// wrong answer). The mitigation in place is that the roster itself is the fleet-converge program's
// input (gunbc.runner.runner_host_deploy runner_job_user_session_hosts / runner_job_user_session_on):
// an operator who learns a host lost its manager removes it from the list and the label is gone, and
// test.claim.runner.runner_user_session_label_witness pins the recorded state so an edit is visible.
// What is MISSING to climb back is a live re-read: the same converge leg, run again per rostered host,
// feeding the rows -- DESIGN 6's producer re-deriving the measurement instead of the fleet holding its
// transcription. The row cites its producer (the fleet-converge runner_user_session_converge leg, by
// run id and receipt path); the drop declares that no one runs it again.
//
// BOUNDED POPULATION: exactly the rostered hosts -- srv4 today (2026-10-28). The witness control
// test.claim.runner.runner_user_session_label_witness
// the_recorded_receipt_gap_is_declared_for_every_rostered_host asserts the membership, so a SECOND host
// joining the roster without being declared here goes red: the staleness window grows only on purpose.

data runner_user_session_label_has_no_live_receipt_reread: RungDrop = RungDrop {
  identity: "runner_user_session_label_has_no_live_receipt_reread" as NonEmptyStr,

  subject: "Whether the gunbc-user-session runner label a host advertises is re-derived from a live observation of that host's job-account user manager -- assessed at the grant path gunbc.runner.runner_registration_labels runner_user_session_grant_of_roster, which reads the recorded receipt rows and nothing else",

  declared: "2026-10-28",

  standing: Standing { declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "the same producer, run again: the fleet-converge runner_user_session_converge leg (gunbc.runner.runner_user_session runner_user_session_converge_cli -- enable-linger, the Linger readback, the bus answer) executed per rostered host on a schedule or on demand, with its readback REPLACING the host's row in gunbc.runner.runner_user_session_receipt runner_user_session_converge_receipt_rows. A recorded row is then the latest produced observation, not a one-time transcription, and losing linger loses the label at the next convergence instead of never. The leg exists and is exercised (srv4's row came from run 40270496735); what does not exist is anyone re-running it for the label's freshness.",
    },
    population: Enumerated { members: FreeSemigroup {
      head: "srv4 -- the only rostered host (gunbc.runner.runner_host_deploy runner_job_user_session_hosts = [operator_host_srv4]) whose label grant runs on the recorded row; its row records what fleet-converge run 40270496735 read back and wrote to /srv/gunbc/converge/runner-user-session-srv4.json",
      tail: ["NOT in the population: hosts off the roster (the grant already refuses them, by name: RosteredUnconverged / Unadmitted); the live fact itself -- test.claim.runner.runner_user_session_witness covers the converge's own holds, and a fleet-converge run of mode=runner_user_session_converge IS the live re-read when someone runs it"],
    } },
    restoration_trigger: "THE CAPABILITY: the label derived from a converge readback that an instrument re-derives -- the fleet-converge runner_user_session_converge leg (gunbc.runner.runner_user_session runner_user_session_converge_cli) run per rostered host, its three readings replacing the host's receipt row, plus a standing cadence or dispatch that runs it (the fleet-converge program's own schedule is the natural home). Evidence: a rostered host whose linger was disabled between two convergences LOSES the label at the second -- the grant answers RosteredUnconverged once the row records the failed reading. WHAT DOES NOT RETIRE THIS ROW: editing the row by hand (that is the transcription); the witness pinning the recorded readings (that pins the record, not the host); citing a fresher run id without re-running the leg.",
  } }
}
