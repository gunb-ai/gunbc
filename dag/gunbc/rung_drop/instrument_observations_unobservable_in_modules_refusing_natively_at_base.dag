module gunbc.rung_drop.instrument_observations_unobservable_in_modules_refusing_natively_at_base

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, LostAsPassenger }
import gunbc.guarantee_rung { MechanicallyPreventable, Mitigatable }

// THE DECLARED RUNG DROP for an instrument whose observation needs a module to resolve natively, over the modules that
// refuse natively at base (DESIGN 4b(3); tidy-ant-251's ruling A on #15009, 2026-10-25, generalized to one row with a
// population per label rather than one row per instrument). A further label hitting the same gap adds members here,
// each prefixed with its label. First label: the namespace-wave binding diff over its OWN instrument modules. The label (gunbc test //gunbc/instruments:namespace-wave-binding-diff) observes a wave's
// per-occurrence binding change only in a module that resolves natively at base and head. The five modules below refuse
// natively at base, on main, for causes no change to them introduced, so a PR that edits them gets rc=2 (the kit fixtures
// are not observed): a typed, located no-observation, never a green. The drop is that the binding diff cannot judge
// those modules' edits until each resolves natively. Reporting them as unchanged instead is rejected (it would conceal
// the very observation the label exists for, DESIGN 5).
//
// Each member's measured root is from the native ambient-name census, run 40134096037 (binding_unbound and
// binding_refusal_cause rows); a cascade member names the module it inherits the refusal from.
data instrument_observations_unobservable_in_modules_refusing_natively_at_base: RungDrop = RungDrop {
  identity: "instrument_observations_unobservable_in_modules_refusing_natively_at_base" as NonEmptyStr,

  subject: "an instrument label's observation of a module that refuses native resolution at base (per label: the namespace-wave binding diff's per-occurrence observation of edits to those modules)",

  declared: "2026-10-25",

  standing: Standing { declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: LostAsPassenger { carrier: "native resolve refuses these modules at base (unbound ambient names, an undeclared derived-roster module, a denied dag-to-v2 import), so the census has no binding rows for them" },
    population: Enumerated { members: FreeSemigroup {
      head: "//gunbc/instruments:namespace-wave-binding-diff gunbc.instruments.ambient_name_census_reading: resolve_reason_unbound_symbol at 130:3; unbound join, split, first, map, map_get, map_keys, flat_map, starts_with, to_string, other",
      tail: [
        "//gunbc/instruments:namespace-wave-binding-diff gunbc.instruments.namespace_wave_binding_diff: cascade from gunbc.instruments.ambient_name_census_reading and gunbc.instruments.namespace_wave_binding_shard (own refusal at 58:9: unbound parse_int, join, split, count, map_get, map_keys, replace, starts_with, to_string, sha256_hex_of_text)",
        "//gunbc/instruments:namespace-wave-binding-diff gunbc.instruments.namespace_wave_occurrence_join: resolve_cross_tree_import_denied (its v2.compiler.parse, v2.compiler.tokenize, v2.std.qualified_name and v2.workflow.roster_import_sweep imports; DagTree to V2Tree is LessFundamental in v2.std.cross_tree.resolution tree_fundamentality_order); no unbound names; owner sleek-owl-397 (escalated by tidy-ant-251: rank the model per top-level namespace rather than move the 417 dag importers of v2)",
        "//gunbc/instruments:namespace-wave-binding-diff gunbc.namespace_cut.migration_kit: cascade from gunbc.instruments.ambient_name_census_reading",
        "//gunbc/instruments:namespace-wave-binding-diff gunbc.rung_drop.kit_call_shape_restates_the_home_signature: cascade from gunbc.rung_drop (unbound length, concat, Empty, ends_with, join; gunbc.rung_drop.standing resolve_module_not_found at 15:1 on the seed-derived gunbc.rung_drop.roster; owner tidy-ant-251, native acquisition supplying the derived-roster module)"
      ]
    } },
    restoration_trigger: "each member resolves natively at base: the import waves for its unbound names land (join, split, first, map, map_get, map_keys, flat_map, starts_with, to_string, other, parse_int, count, replace, sha256_hex_of_text, length, concat, Empty, ends_with), native module acquisition supplies the derived roster module gunbc.rung_drop.roster, and the dag-to-v2 cross-tree direction is ruled (model or importers). Retire a member when its native census row is resolve-clean; retire the drop when none remains, observed by the binding diff judging an edit to each member with rc 0 or 1."
  } }
}
