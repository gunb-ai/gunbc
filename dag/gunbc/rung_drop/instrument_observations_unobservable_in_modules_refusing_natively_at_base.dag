module gunbc.rung_drop.instrument_observations_unobservable_in_modules_refusing_natively_at_base

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, LostAsPassenger }
import gunbc.guarantee_rung { MechanicallyPreventable, Mitigatable }

// THE DECLARED RUNG DROP for an instrument whose observation needs a module to resolve natively, over the modules that
// refuse natively at base (DESIGN 4b(3); tidy-ant-251's ruling A on #15009, 2026-10-25, generalized to one row with a
// population per label rather than one row per instrument). A further label hitting the same gap adds members here,
// each prefixed with its label. First label: the namespace-wave binding diff over its OWN instrument modules. The label (gunbc test //gunbc/instruments:namespace-wave-binding-diff) observes a wave's
// per-occurrence binding change only in a module that resolves natively at base and head. The five modules below refuse
// natively at base, on main, for causes no change to them introduced, so a PR that edits them gets rc=2 (the kit fixtures
// are not observed): a typed, located no-observation, never a green. The drop is that the binding diff cannot judge
// those modules' edits until each resolves natively. Reporting them as unchanged instead is rejected (it would conceal
// the very observation the label exists for, DESIGN 5).
//
// Each member's FIRST located root is from the full v2-native-census at 8b6bbaa5d171 (sleek-owl-397, srv1, 2026-10-25,
// rc 0, 11199s), which supersedes the first roots this row first cited from run 40134096037 (that run's unbound-name
// lists stand as each member's tail). Each cited position names its line at 8b6bbaa5d171, and every such line is
// byte-identical at the same line at base 4ecf29dee; the one exception, namespace_wave_occurrence_join, whose own refusal row
// carries no locus, is cited by its import edges, which are identical at base. So no root is introduced by the change that declared this drop; a
// base-revision census re-reads them. The NonEmptyStr reference-category rows at 7:61 and 7:87 this row once cited for
// namespace_wave_binding_diff belong to gunbc.namespace_wave_binding_diff_seed_growth (a module-name prefix match; their
// chain is gunbc.seed_growth's declarer refusal), so they are not this instrument's root (sleek-owl-397's read of the
// census rows).
data instrument_observations_unobservable_in_modules_refusing_natively_at_base: RungDrop = RungDrop {
  identity: "instrument_observations_unobservable_in_modules_refusing_natively_at_base" as NonEmptyStr,

  subject: "an instrument label's observation of a module that refuses native resolution at base (per label: the namespace-wave binding diff's per-occurrence observation of edits to those modules)",

  declared: "2026-10-25",

  standing: Standing { declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: LostAsPassenger { carrier: "native resolve refuses these modules at base (unbound ambient names, an undeclared derived-roster module, a denied dag-to-v2 import), so the census has no binding rows for them" },
    population: Enumerated { members: FreeSemigroup {
      head: "//gunbc/instruments:namespace-wave-binding-diff gunbc.instruments.ambient_name_census_reading: resolve_reason_unbound_symbol on Map at 201:36, 203:5 and 209:32 (tail empty_map, map_insert); also unbound join, split, first, map, map_get, map_keys, flat_map, starts_with, to_string, other",
      tail: [
        "//gunbc/instruments:ambient-name-census v2.compiler.occurrence_resolution_census: resolve_reason_unbound_symbol on to_string (11 sites, first at 166:30); measured at gunbc#15058 head 5dd8c6edd770 (ambient-name-census run 40198240352), base-ref measurement owed by v2-native-census at main",
        "//gunbc/instruments:ambient-name-census v2.compiler.source_root_eval: resolve_reason_unbound_symbol on concat (67 sites, first at 1601:3), to_string (14, first at 2953:68), observed_thread_cpu_nanos (10, first at 5733:24), PureComputation (4), ModuleOutcome (3), starts_with (2); measured at gunbc#15058 head 5dd8c6edd770 (run 40198240352), base-ref measurement owed by v2-native-census at main",
        "//gunbc/instruments:ambient-name-census v2.workflow.roster_import_sweep: resolve_observation_namespace_refused, its root an imported namespace that refuses (gunbc.instruments.ambient_name_census_reading); measured at gunbc#15058 head 5dd8c6edd770 (run 40198240352)",
        "//gunbc/instruments:ambient-name-census gunbc.instruments.ambient_name_census_reading: the same own refusal as its namespace-wave-binding-diff member above (unbound Map, empty_map, map_insert and the rest)",
        "//gunbc/instruments:namespace-wave-binding-diff gunbc.instruments.namespace_wave_binding_diff: the cascade from gunbc.instruments.ambient_name_census_reading and gunbc.instruments.namespace_wave_binding_shard (own refusal at 58:9: unbound parse_int, join, split, count, map_get, map_keys, replace, starts_with, to_string, sha256_hex_of_text)",
        "//gunbc/instruments:namespace-wave-binding-diff gunbc.instruments.namespace_wave_occurrence_join: resolve_cross_tree_import_denied, its root the module's import EDGES into v2 (its own census row is FileRefusalAtInvariant with no locus, so the root is cited by edge, not by position; the loci 170:14, 189:8 and 190:83 printed beside it are census_residual rows of gunbc.instruments.namespace_wave_binding_shard, its join_field( calls; the four imported v2 modules are identical at base 4ecf29dee, while the names imported from v2.workflow.roster_import_sweep grew in #15009; the edges: v2.compiler.parse, v2.compiler.tokenize, v2.std.qualified_name and v2.workflow.roster_import_sweep imports; DagTree to V2Tree is LessFundamental in v2.std.cross_tree.resolution tree_fundamentality_order); owner sleek-owl-397 (the cross-tree membership ruling, #15080)",
        "//gunbc/instruments:namespace-wave-binding-diff gunbc.namespace_cut.migration_kit: its own resolve_reason_unbound_symbol on compile_dag_diagnostic_census at 46:9 (tail census_rows_for), plus resolve_reason_declarer_refused from gunbc.instruments.ambient_name_census_reading",
        "//gunbc/instruments:namespace-wave-binding-diff gunbc.rung_drop.kit_call_shape_restates_the_home_signature: its own resolve_reason_unbound_symbol on List at 18:50 and 18:61 (tail RungDrop); and the cascade from gunbc.rung_drop, which refuses on resolve_cross_tree_import_denied at 238:26 (RemovalTombstone), unbound List at 345:24 and concat at 504:72 (also length, Empty, ends_with, join), and gunbc.rung_drop.standing resolve_module_not_found at 15:1 on the seed-derived gunbc.rung_drop.roster (owner tidy-ant-251, native acquisition supplying the derived-roster module)"
      ]
    } },
    restoration_trigger: "each member resolves natively at base: the import waves for its unbound names land (Map, List, empty_map, map_insert, compile_dag_diagnostic_census, join, split, first, map, map_get, map_keys, flat_map, starts_with, to_string, other, parse_int, count, replace, sha256_hex_of_text, length, concat, Empty, ends_with), native module acquisition supplies the derived roster module gunbc.rung_drop.roster, the dag-to-v2 cross-tree direction is ruled (model or importers). Retire a member when its native census row is resolve-clean; retire the drop when none remains, observed by the binding diff judging an edit to each member with rc 0 or 1."
  } }
}
