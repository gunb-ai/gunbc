module gunbc.rung_drop.null_coalesce_interpreter_demand_unmeasured

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// The pair measured the interpreter's `??` operand demand at rung 2. v2's grammar has no `??`
// token (operator ruling relayed by cool-lark-903, 2026-10-11: rewrite the source), so the
// fixtures became a match and the `??` measurement is gone. Class: `gunbc.recurring_failure_mode`
// `realization_arms_diverge_on_whether_the_program_refuses`.
data null_coalesce_interpreter_demand_unmeasured: RungDrop = RungDrop {
  identity: "null_coalesce_interpreter_demand_unmeasured" as NonEmptyStr,

  subject: "the interpreter's null-coalesce operand demand (std.operator_realization operand_demand, DemandsRightOnlyWhenLeftIsAbsent): no executed claim runs `??`",

  declared: "2026-10-11",

  standing: Standing { declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: Enumerated { members: FreeSemigroup { head: "test.claim.eval_model_probe null_coalesce_skips_a_refusing_right_when_left_is_present (replaced by a match-arm claim that does not exercise ??)", tail: ["test.claim.eval_model_probe null_coalesce_demands_its_right_when_left_is_absent (replaced by a match-arm claim that does not exercise ??)"] } },
    restoration_trigger: "a claim-evaluation route parses and evaluates a `??` expression, sufficient that a present left skips a refusing right operand and an absent left demands it, shown as a discriminating pair on that route",
  } }
}
