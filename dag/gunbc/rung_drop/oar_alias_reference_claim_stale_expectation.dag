module gunbc.rung_drop.oar_alias_reference_claim_stale_expectation

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

data oar_alias_reference_claim_stale_expectation: RungDrop = RungDrop {
  identity: "oar_alias_reference_claim_stale_expectation" as NonEmptyStr,

  subject: "the relation-level claim that an Optional produced at a declaration reference is counted-undecidable and not refused: its premise, an unresolvable alias reference (v2.test.oar_alias.Maybe names no declaration) read as undecidable, is no longer an admitted expectation, because a reference naming an Optional is decided once its alias settles. Its assertion is unchanged and it stays red",

  declared: "2026-10-20",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "a route claim on an alias fixture: with type Maybe = Optional<Int>, the alias value is accepted and Present { value: String } is refused at the payload"
    },
    population: [
      "v2.test.claim.compiler.infer_optional_at_required_witness oar_an_optional_at_a_declaration_reference_or_type_variable_is_not_refused_holds",
    ],
    restoration_trigger: "the Occupancy cut (gunbc#14531) lands and T? reaches std.optional by identity, so that the alias route claim above can be authored and enrolled: the stale claim and this row then delete in that change",
  }
}
