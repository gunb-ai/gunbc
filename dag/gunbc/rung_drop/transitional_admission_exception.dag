module gunbc.rung_drop.transitional_admission_exception

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, LostAsPassenger }
import gunbc.guarantee_rung { OutsideTheLadder, Mitigatable }
import gunbc.transitional_admission_exception_identities { transitional_admission_exception_identities }

// DECLARED 2026-09-08 (dashboard node adhoc-cf84ab88-8dc). The five falsifier-family cadences whose
// workflow (falsifier.yml) was deleted at #8283 have no scheduled route. std.witness_admission
// witness_cadence_has_scheduled_route returns false for all five. Admission rows on those cadences
// must be refused by explicit_witness_admission_cadence_executes (gunbc.design_argument::single_authority single authority, gunbc.design_argument::fail_closed
// coverage-by-illusion). Admission rows on three cadences carry live admission data that
// must transition to a scheduled-route cadence first. Two of them (self_host_body_producer,
// self_host_use_site_verdict) are ALSO rostered in gunbc.rung_drop.deleted_cadence_reference_drop.
// transitional_admission_exception_identities is the single authority for both the gate exception
// and the RungDrop population — it lives in the code module
// gunbc.transitional_admission_exception_identities, because the admission gate reads it to decide
// and a ledger row is a design record that code does not import; this row imports the list, never the
// reverse (gunbc.design_argument::single_authority single authority, gunbc.design_argument::guarantee_ladder (no silent regression) bounded population).

// CONSTRUCTOR — derives the RungDrop from the single identity list authority.
// gunbc.design_argument::single_authority single authority: the population field reads from that list,
// not from a separately-maintained one.
data transitional_admission_exception: RungDrop = RungDrop {
  identity: "transitional_admission_exception" as NonEmptyStr,
  subject: "admission rows on falsifier-family cadences with no scheduled route, awaiting transition to a cadence that executes",
  declared: "2026-09-08",
  standing: Standing { declaration: TypedDeclaration {
    previous: Mitigatable,
    temporary: OutsideTheLadder,
    reason: LostAsPassenger { carrier: ".github/workflows/falsifier.yml, deleted at 611fd02770 (#8283)" },
    population: Enumerated { members: transitional_admission_exception_identities },
    restoration_trigger: "each named identity carries a cadence with a live scheduled route, at which point each such identity is removed from gunbc.transitional_admission_exception_identities and the identity's exception in explicit_witness_admission.dag is deleted (the gate consumes the list, so removing from the list retires the exception). The cadence category those routes need is gunbc.rung_drop.shared_capability missing_cadence_category; the remainder is the per-identity migration onto a live route. Waiters whose remaining unsatisfied condition is only that capability retire together. When the category fires and any named identity still lacks a live scheduled route, this identity is removed from missing_cadence_category.waiter_identities in the SAME change as those retirements (delist, not SplitRetirement) and this row stays Standing until every named identity has that route. If every named identity already has a live scheduled route when the category fires, retire with the enrolled set.",
  } }
}
