module gunbc.rung_drop.transitional_admission_exception

import std.types { NonEmptyStr, List, String }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, LostAsPassenger }
import gunbc.guarantee_rung { OutsideTheLadder, Mitigatable }

// DECLARED 2026-09-08 (dashboard node adhoc-cf84ab88-8dc). The five falsifier-family cadences whose
// workflow (falsifier.yml) was deleted at #8283 have no scheduled route. std.witness_admission
// witness_cadence_has_scheduled_route returns false for all five. Admission rows on those cadences
// must be refused by explicit_witness_admission_cadence_executes (DESIGN §3 single authority, §5
// coverage-by-illusion). Admission rows on three cadences carry live admission data that
// must transition to a scheduled-route cadence first. Two of them (self_host_body_producer,
// self_host_use_site_verdict) are ALSO rostered in gunbc.rung_drop.deleted_cadence_reference_drop.
// transitional_admission_exception_identities is the single authority for both the gate exception
// and the RungDrop population — the data below is the ONLY list; the RungDrop consumes it
// through a function (DESIGN §3 single authority, §4b(3) bounded population).

data transitional_admission_exception_identities: FreeSemigroup<String> = FreeSemigroup { head: "dag/test/claim/method_arg_declared_contract_witness.dag::w_method_arg_infers_against_declared_contract_not_element_type_test", tail: ["dag/test/claim/legacy_test_behavior_disposition_acceptance.dag::legacy_test_behavior_unclassified_frontier_is_zero", "dag/test/claim/observation_raw_print_retirement_acceptance.dag::observation_emit_frontier_is_zero", "dag/test/claim/long/g2_data_reference_under_selection_witness.dag::specimen_classifies_as_runtime_read", "dag/test/claim/long/g2_data_reference_under_selection_witness.dag::specimen_does_not_classify_as_local_read", "dag/test/claim/source_integration_proof_kernel_acceptance.dag::witness_p1_proof_kernel_acceptance_contract_holds", "dag/test/claim/namespace_reference_derived_closure_acceptance.dag::witness_namespace_reference_derived_closure_closing_contract_holds", "src/v2/test/claim/long/direct_rust_door_production_group.dag::direct_rust_door_production_group_closing_expectation_holds", "dag/test/claim/self_host_use_site_verdict_behavioral_witness.dag::self_host_use_site_verdict_behavioral_receipt_holds", "dag/test/claim/self_host_body_producer_behavioral_witness.dag::self_host_body_producer_behavioral_receipt_holds", "dag/test/claim/self_host_discovery_enumeration_behavioral_witness.dag::self_host_discovery_enumeration_behavioral_receipt_holds", "dag/test/claim/self_host_target_carriers_behavioral_witness.dag::self_host_target_carriers_behavioral_receipt_holds", "dag/test/claim/self_host_03_normalize_behavioral_witness.dag::self_host_03_normalize_behavioral_receipt_holds", "src/v2/test/claim/long/production_qualification_origin_probe_witness.dag::witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds", "src/v2/test/claim/long/production_qualification_origin_probe_witness.dag::witness_live_structural_fixture_mint_site_discovered_reds", "src/v2/test/claim/long/production_qualification_origin_probe_witness.dag::witness_ingest_mint_surface_requires_call_occurrence_frontier_reds", "src/v2/test/claim/long/production_qualification_origin_probe_witness.dag::witness_direct_door_smoke_requires_closure_or_call_occurrence_frontier_reds", "src/v2/test/claim/long/infer_transform_binary_infix_witness.dag::infer_transform_add_vertical_witness_holds", // ENROLLED 2026-10-16 (owner: stern-bat-401, session gentle-owl-393). Eighteen QuarantineProbeExpectRed
  // admission rows added to the ledger AFTER this list was authored (after 34444d05b9), so the wall at
  // explicit_witness_admission_well_formed refused them: cadence_executes delegates to
  // witness_cadence_has_scheduled_route, which returns false for QuarantineProbeExpectRed, and none of
  // these identities was exempted. Their cadence is UNCHANGED — they are not re-routed onto a cadence
  // that would pretend to run them, because nothing does: the falsifier.yml executor was deleted at
  // 611fd02770 (#8283) and dag/gunbc/ci/ci_layer_roots.dag records that no live executor runs this
  // probe batch. Until the exit condition below fires, these rows produce ZERO OBSERVATIONS:
  // they are admitted as data, never executed. EXIT CONDITION (§4b obligation 3, stated as a
  // CAPABILITY): a scheduled executor runs the QuarantineProbeExpectRed batch. That capability is
  // already registered and already owns this wait — gunbc.rung_drop.shared_capability
  // missing_cadence_category lists transitional_admission_exception among its waiter_identities, so
  // this enrolment adds NO parallel authority; the category is the trigger and the per-identity
  // migration onto a live scheduled route is the remainder. At that point each of these identities is
  // removed from this list in the same change that retires its exception.
  // The first two rows below are retired by PR #14152 / commit 5d750054b34, which deletes both
  // constructor_tag_route_probe_red.dag probe files AND their ledger rows (their RED is re-enrolled
  // there as a permanent Rust control, src/v1/tests/src/cross_coproduct_probe_discharge_test.rs). They
  // are kept here until that change lands, because this list gates rows that still exist on main: an
  // enrolment missing a live row turns the wall red, while a leftover identity for a row that has been
  // deleted can never match anything and is inert. Drop those two in the same merge that takes #14152.
  "dag/test/claim/constructor_tag_route_probe_red.dag::same_arm_one_t_two_coproducts_must_refuse",
  "src/v2/test/claim/manual/constructor_tag_route_probe_red.dag::same_arm_one_t_two_coproducts_must_refuse",
  "dag/test/claim/declared_type_inhabitance_direct_call_witness.dag::w_a_branded_product_refinement_at_an_unrelated_product_formal_still_refuses",
  "dag/test/claim/algebra_receiver_callable_witness.dag::shorthand_match_binder_is_callable",
  "dag/test/claim/algebra_receiver_callable_witness.dag::explicit_match_binder_pool_free_name_is_callable",
  "dag/test/claim/algebra_receiver_callable_witness.dag::shorthand_match_binder_pool_free_name_is_callable",
  "dag/test/claim/algebra_receiver_callable_witness.dag::explicit_match_binder_colliding_name_is_callable",
  "dag/test/claim/algebra_receiver_callable_witness.dag::nested_let_in_match_arm_is_callable",
  "dag/test/claim/algebra_receiver_callable_witness.dag::function_parameter_is_callable",
  "dag/test/claim/algebra_receiver_alias_witness.dag::alias_return_is_a_refusal_fixture",
  "dag/test/claim/algebra_receiver_alias_witness.dag::alias_field_is_a_refusal_fixture",
  "dag/test/claim/algebra_receiver_alias_witness.dag::explicit_initializer_is_an_acceptance_fixture",
  "src/v2/test/claim/long/accumulator_copy_fold_analysis.dag::let_alias_is_proven_suspect",
  "src/v2/test/claim/long/accumulator_copy_fold_analysis.dag::named_step_fold_refuses_accumulator_unread",
  "src/v2/test/claim/long/accumulator_copy_fold_analysis.dag::report_counters_state_the_domain",
  "src/v2/test/claim/long/accumulator_copy_fold_analysis.dag::declared_named_step_fold_copy_is_caught",
] }

// CONSTRUCTOR — derives the RungDrop from the single identity list authority.
// DESIGN §3 single authority: the population field reads from the data above,
// not from a separately-maintained list.
data transitional_admission_exception: RungDrop = RungDrop {
  identity: "transitional_admission_exception" as NonEmptyStr,
  subject: "admission rows on falsifier-family cadences with no scheduled route, awaiting transition to a cadence that executes",
  declared: "2026-09-08",
  standing: Standing { declaration: TypedDeclaration {
    previous: Mitigatable,
    temporary: OutsideTheLadder,
    reason: LostAsPassenger { carrier: ".github/workflows/falsifier.yml, deleted at 611fd02770 (#8283)" },
    population: Enumerated { members: transitional_admission_exception_identities },
    restoration_trigger: "each named identity carries a cadence with a live scheduled route, at which point each row above is removed from transitional_admission_exception_identities and the identity's exception in explicit_witness_admission.dag is deleted (the gate consumes the list, so removing from the list retires the exception). The cadence category those routes need is gunbc.rung_drop.shared_capability missing_cadence_category; the remainder is the per-identity migration onto a live route. Waiters whose remaining unsatisfied condition is only that capability retire together. When the category fires and any named identity still lacks a live scheduled route, this identity is removed from missing_cadence_category.waiter_identities in the SAME change as those retirements (delist, not SplitRetirement) and this row stays Standing until every named identity has that route. If every named identity already has a live scheduled route when the category fires, retire with the enrolled set.",
  } }
}
