module gunbc.rung_drop.derived_equality_residual_field_equality

import std.types { List, NonEmptyStr, String }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, ReplacementStaged }
import gunbc.guarantee_rung { OutsideTheLadder, StructurallyGuaranteed }

// DECLARED 2026-10-25 with derived equality (std.operator_realization EqualityPlan). Every `==` the seed
// checker admits on a type reaching v2.std.node Node, Edge or NodeOccurrence compares through the plan
// (a bare Node/Edge member as a value, a NodeOccurrence member as the same occurrence), and a bare
// Node or Edge `==` refuses at acceptance. Two routes to equality on such types do not pass through a
// checked `==` site, so they still use the emitted derived PartialEq: field equality INCLUDING
// provenance (occurrence ids, Edge.declaration), which is a different meaning from the plan's. The
// emitted Node keeps that derived PartialEq, so its Eq/Hash contract is consistent; what is lost is
// that these uses mean what the plan means.
//
// STARTING CENSUS, the leading edge only: with PartialEq/Eq/PartialOrd/Ord stripped from the three
// emitted structs, //gunbc/instruments:self-host refused in its first failing crate
// (v2-emitted-policy-unit-2) with 16 E0369 derived-PartialEq sites in v2.std.node, v2.std.dependency and
// v2.std.diagnostic. rustc stops at the first failing crate, so the downstream population is
// uncounted, and v2-native-cli was not measured.
data derived_equality_residual_field_equality_population: FreeSemigroup<String> = FreeSemigroup {
  head: "generic == over a type parameter instantiated at a Node/Edge/NodeOccurrence-reaching type: the seed admits it instantiation-blind (v1.compiler.infer equality_exposure_refusal, OpaqueTypeHead / StuckTypeHead), so it carries no plan and the emitted derived PartialEq compares fields with provenance",
  tail: ["collection membership on a Node/Edge/NodeOccurrence-reaching type -- HashMap/HashSet keys, BTreeMap/BTreeSet keys and Ord users -- through the emitted derived PartialEq/Eq/Hash/Ord, which compare fields with provenance"]
}

data derived_equality_residual_field_equality: RungDrop = RungDrop {
  identity: "derived_equality_residual_field_equality" as NonEmptyStr,
  subject: "Equality on a type reaching v2.std.node Node, Edge or NodeOccurrence answering the derived plan's meaning on every emitted use, not only at checked == sites",
  declared: "2026-10-25",
  standing: Standing { declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: OutsideTheLadder,
    reason: ReplacementStaged { replacement: "checked == sites compare through the std.operator_realization EqualityPlan; the emitted types keep their derived PartialEq for the uses no == site reaches" },
    population: Enumerated { members: derived_equality_residual_field_equality_population },
    restoration_trigger: "a derive-eligibility fixpoint over the type graph -- 'reaches a routed declaration', modelled on v1.compiler.emit_info has_fn_fields / close_fn_fields -- that drops PartialEq, and Eq/PartialOrd/Ord/Hash wherever they depend on it, from every emitted type reaching a routed declaration, sufficient for no emitted use of those traits on such a type to go unrouted: each is routed through the plan or refused by rustc, censused on both required products (self-host, v2-native-cli)",
  } }
}
