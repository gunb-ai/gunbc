module gunbc.rung_drop.base_revision_judged_by_the_head_seed

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// THE DECLARED RUNG DROP for a floor that judges a BASE revision's facts with the HEAD seed
// (DESIGN 4b(3); sharp-raven-357 ruling, 2026-10-05).
//
// WHAT IS LOST. The required floor reconstructs two base-revision facts by resolving and evaluating
// base source with THIS binary: the base parse environment (v1_compiler.cli_run.namespace_baseline
// environment_agreement) and the base cost-debt roster (required_floor_runner cost_debt_roster_in_tree).
// The resolver works at module grain, so a base whose closure merely CONTAINS a call to a builtin the
// head deleted cannot be judged at all, even where the judged fact never reaches that call. gunbc#13378
// deletes the from_code_point builtin; the base std.algebra trim seam still calls it, so both base
// evaluations refuse. Three instances of the one class were met on #13378 (base-closure archive,
// cost-debt roster, parse environment); the first is fixed by gunbc#13408, the other two are this drop.
//
// THE FLOOR STILL REFUSES; IT DOES NOT ADMIT. Both sites refuse typed as BaseUnevaluableUnderHeadSeed
// { name, at } (v1_compiler.cli_run.namespace_baseline name_this_seed_lacks reads the resolver's one
// diagnostic shape; an unrecognised resolve failure stays ClosureNotEvaluable). What drops is the
// rung of the landing: the operator admits the one landing below with the floor red on this cause.
//
// THE TEXT READ IS PART OF THIS STOPGAP AND RETIRES WITH IT. resolve_entry_with_index answers only
// text, so name_this_seed_lacks reads that one diagnostic's fixed shape (`function 'N' not found in
// scope`) to name the cause. That read exists ONLY inside this declared drop: an unrecognised shape
// stays ClosureNotEvaluable -- still a refusal, never admitted -- and when the restoration trigger
// fires, name_this_seed_lacks and the BaseUnevaluableUnderHeadSeed arms are DELETED with the drop,
// not kept as a second reading of resolve's meaning.
data base_revision_judged_by_the_head_seed: RungDrop = RungDrop {
  identity: "base_revision_judged_by_the_head_seed" as NonEmptyStr,

  subject: "the required floor's base-revision reconstruction (parse environment, cost-debt roster) when the base calls a builtin the head seed removed",

  declared: "2026-10-05",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "the floor judges base-revision facts with the base revision's own compiler (base-compiler lane under lively-crane-656; controls: gunbc#13378's three cases)" },
    population: [
      "the gunbc#13378 landing only (deletion of the v1 seed builtin from_code_point): its floor refuses BaseUnevaluableUnderHeadSeed { name: from_code_point } and the operator admits that one landing; after it lands, no base carries the builtin call",
    ],
    restoration_trigger: "the floor judges base-revision facts with the base revision's own compiler (at which point the interim text read name_this_seed_lacks and the BaseUnevaluableUnderHeadSeed refusal arms are deleted) -- SUFFICIENT FOR the base parse environment and the base cost-debt roster of a pull request that deletes a builtin to be evaluated and compared, with no BaseUnevaluableUnderHeadSeed refusal, on gunbc#13378's three fixtures as controls",
  }
}
