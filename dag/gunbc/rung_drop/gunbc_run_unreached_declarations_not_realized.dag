module gunbc.rung_drop.gunbc_run_unreached_declarations_not_realized

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }

data gunbc_run_unreached_declarations_not_realized: RungDrop = RungDrop {
  identity: "gunbc_run_unreached_declarations_not_realized" as NonEmptyStr,

  subject: "a type obligation carried by a NON-function declaration -- a type declaration's field rows, a data value, a service or resource row, and the signature and module context built from them -- that no demanded declaration of a `gunbc run` names, transitively: the run no longer realizes the declaration at all, so nothing builds or checks what it would have built. Distinct from gunbc_run_unreached_function_bodies_not_typechecked, which lowers only function BODIES and leaves every declaration's signature, type rows and module context realized; this one lowers the declarations themselves, which is a different population, a different previous rung and a different restoration trigger",

  declared: "2026-11-08",

  standing: Standing { declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: Enumerated { members: FreeSemigroup {
        head: "non-function declarations of modules in the import closure of the requested entry, EXCLUDING every declaration a realized declaration names -- in its authored extent (the names spelled through children, params, properties, uses, body, annotations, transport and the dotted lexeme of a reference chain), or through a DECLARED implicit-read edge: the alias or where-refinement right-hand side a type is declared to be (harvested through the checker's own authorities -- v1.compiler.infer_env transparent_alias_rhs, parameterized_alias_rhs, is_where_refinement_node), and the provider/service row a dotted call resolves through (harvested through v1.std.core field_access_spine, keyed by the dotted prefix the service census keys services by)",
        tail: FreeSemigroup {
          head: "the excluded set is computed once, by v1.compiler.infer.realization_names, as the naming closure over the requested entry, growing along the SAME inventory the audit holds a module to (v1.compiler.infer.realization_row_names: spelled extent, alias and refinement right-hand side, provider row prefix); a declaration is excluded exactly when no demanded declaration spells it and no declared edge reaches it",
          tail: FreeSemigroup {
            head: "THE MEASURED POPULATION: the acceptance entry `gunbc run --entry dag/gunbc/fleet/fleet_converge_plan_cli.dag --function fleet_converge_plan_wet` realizes a strict subset of the 3318-module closure's declarations; the count pair (realized/total, per run) is printed by the advisory DeclarationRealizationProfile row, which is the row that makes this population auditable rather than asserted",
            tail: FreeSemigroup {
              head: "THE POPULATION THIS ROW COVERS, and the reason it is Mitigatable rather than Unguaranteeable: the same edges that decide the population are RE-DERIVED at the boundary of each realized module by v1.compiler.infer.realization_audit, over both the declaration's source extent and its typed (post-desugar, post-synthesis) form; an edge naming a declaration the run can RESOLVE but did not realize -- the census being the checker's own resolve tables (every item's authored name plus v1.compiler.infer's symbol-index entries and global bare-name winners, not a list this file maintains) -- is the blocking, located Diagnostic.DeclarationRealizationGap naming the reading check that asked, so a read outside the realized set refuses instead of answering 'no such declaration' or 'unresolved type'. A missing declared edge is therefore a red run, not a silent one -- that is what keeps this below Unguaranteeable, where an exempt list or an assumed-complete read inventory would not be. The population is EXACTLY the declarations excluded by the inventories and re-derived by the audit: the spelled extent plus the reader families in v1.compiler.infer (realization_row_edges: alias right-hand side, where-refinement; realization_provider_row_edges: the service row a dotted prefix selects; plus the typed-side readers the bounded fixpoint closes -- desugar_or_synth, inhabitance/algebra rows, effect dispatch). No member of THIS population fails silently: every read of it is an edge, and every edge outside the realized set refuses",
              tail: FreeSemigroup {
                head: "THE RESIDUAL, BELOW THE LADDER AND NOT AUTHORIZED BY THIS ROW: a read the checker performs whose key is in NO inventory -- neither spelled, nor a reader family's declared edge, nor re-derivable from the typed form -- is invisible to the audit and would present as a clean run that skipped a check. Per gunbc.design_argument::guarantee_ladder that is not a rung at all, so this row claims nothing over it and its Mitigatable rung is stated over the inventoried population only. Today no such read is known: every reading check found so far entered as a reader family (the corpus and the acceptance entry run with zero gaps), and a new reading check enters the checker only with its edge added to the one inventory, v1.compiler.infer.realization_row_names -- the witness pair in src/v1/stage0/src/cli_run/demanded_typecheck_equivalence.rs pins both directions of the failure this guards (an unreached broken declaration stays invisible while the same declaration, reached, refuses as the whole-closure typecheck refuses it). RECEIPT, 2026-11-10 -- THAT SENTENCE WAS FALSIFIED, AND HERE IS THE READ. The interpreter's response decode consults a declaration by a key that is in no inventory: build_coproduct_wire_contract_index (src/v1/stage0/src/v1_interpreter.rs) selects a coproduct's CoproductWireContract ROW by matching that row's own `coproduct` DeclarationRef (module_path, decl_name) against the coproduct being decoded, and resolve_module_encoding finds a module's default by the data item named wire_contract; the row lives in a sibling _contracts module that the type's module only IMPORTS, and an import is no lexeme any demanded row spells -- neither spelled, nor a reader family's declared edge, nor re-derivable from the typed form, and the audit held no edge for it. RUNS: heal-publish 42795658738 (PR #16238) and 42798626487 (PR #16122) at head 9443e64f5d refused every pull-request read with 'status 200 undecodable'; the last two runs that reached the read at all, 42782194156 (PR #16220, head 4a4f790d8d) and 42783288619 (PR #16233, head 6ab6e6a7cb), had decoded it. 5e315131 (#16156) had excluded extdeps.github.pulls_contracts.pull_request_state_wire_contract from the realized set, the index came up empty, decode_nullary_coproduct answered NoWireContract -- and no gap refused, which is precisely the 'clean run that skipped a check' this row said could not happen, except that the skipped check then refused at the first body that reached it. THE ENTRY IT MADE: realization_wire_contract_read_row and realization_wire_contract_read_names seed the reader's own category (every data row typed CoproductWireContract, every data row named wire_contract) because no declaration can name it, and realization_wire_contract_row_edges declares the key read the row performs, so growth follows the coproduct its DeclarationRef designates and realization_audit holds it under reader name wire_contract_index. WHAT THAT DOES NOT COVER, as the rung and not as a gap: a coproduct for which NO row was ever written still refuses at run time with NoWireContract, because this row's rule stands -- absence and unreality are different facts -- and refusing absence at check time needs the wire-decoded-type derivation (which operations declare which response types, and which types their fields reach), which is the next rung's work. NEXT-RUNG TRIGGER for the residue: instrument the checker's census consults (its symbol-index and global-bare lookups) to refuse whenever a name the census can resolve is not realized, whichever path asked; when that guard exists the inventory-completeness question is moot and this row's population widens to every non-function declaration the realization excludes. WITNESS ROUTE RECEIPT, 2026-11-10, same change -- THERE IS NO HERMETIC SCOPED-RUN WITNESS FOR THIS BUG ON TODAY'S ROUTES, AND THE ATTEMPT IS RECORDED RATHER THAN LEFT IMPLIED. dag/test/claim/github_pull_request_decode_witness.dag replays the recorded 200 body of GET /repos/gunb-ai/gunbc/pulls/16238 through the probe carrier test.RestReplay.PullRequestPage and is 8/8 under claim_batch --hermetic at head and 7/8 at origin/main (the missing row is the cause-text assertion, red because main lacks rest_response_declared_cause), so it pins WHAT the decode must produce but cannot be red-at-main for the realization itself: claim_batch realizes the whole closure. The scoped route that WOULD discriminate refuses for two reasons of its own, measured with that file overlaid: evaluate_in_witness_frame carries no REST-replay realization under gunbc run at ANY commit (BuildBuddy 0e65ba61-7bae-4b50-8601-139ead309ee1 at e1dd6b50 refuses the subject), and a service operation spelled through its namespace has no method surface there from 5e315131 on (BuildBuddy caebcfaa-a82c-4e44-af06-f455d4d27635: \"method 'PullRequestPage' cannot be resolved: receiver type 'Primitive(test.RestReplay)' establishes no method surface\", the same call resolving at e1dd6b50) -- a SECOND, compile-time instance of this row's class, over the service namespace rather than the wire contract, and outside what this change's entry covers. Nor can a scoped entry name the row to become red at main: a spelled name is a seed, so the row would be realized at main too and the witness would be green at both heads. The discriminator's home is therefore the demanded-versus-closure equivalence pair named above, extended with a wire-contract row case, which is the next rung's work and is not claimed here. SECOND REALIZATION RECEIPT, 2026-11-10, same change: THE DECLARED-SIDE CAUSE ABOVE HOLDS ON THE INTERPRETED ROUTE ONLY. gunbc.heal_publication rest_refusal_text publishes the cause for the whole RestBodyUndecodable arm, and the interpreted route heal-publish actually executes (.github/workflows/heal-publish.yml:112 and :126, both gunbc run) mints that cause from declared facts at all four of its sites. The emitted realization of the same exchange is a second place that creates the refusal and does NOT render declared-side: src/v1/05_emit_rust.dag:19168 emits cause: error.to_string() for a body it could not read, and :19178 emits the error text into a body did not inhabit the declared output message, inside emit_rust_rest_result_lowering reached from :18667 -- and a serde message can carry a spelling the body presented. Nothing is compiled through the emitter on this path today, so no credential-path text leaks yet, and the widen is recorded here instead of left silent. CLOSED IN SOURCE FOR THE EMITTED ROUTE, 2026-11-10: the two emitter arms now route through the declared-side authority v1.compiler.rest_cause_text (src/v1/05_rest_cause_text.dag) -- the body-read arm emits the fixed read-refused phrase and the decode arm the declared 'body did not inhabit the declared output: <declared> at <located> (<coproduct>)' template over the declared output type, and neither splices the io error or the serde_json message into the cause. THE DISCRIMINATING WITNESS IS THE EMITTED BYTES, NOT claim_batch (which realizes the whole closure and is green either way). EVIDENCE STATUS per gunbc.design_argument::guarantee_ladder meta-obligation 1 (the reported rung equals the rung established by executed evidence): the source fix is landed; the discriminating RED was EXECUTED out-of-band by quick-newt-573 at main (invocation 0139ebbb) and refuses on the allow-list naming both leaky arms, but ONLY under a labelled run-tree application of the separate #16069 v1-compiler-tests compile fix (that crate does not compile on main without it), and the GREEN run at head is PENDING -- it needs heal-publish to regenerate the emitted mirror v1.compiler.emit_rust from this .dag before the test crate can compile the new emitter code, then a quick-newt run. The witness is NOT enrolled on a CI-enforced route: no workflow builds v1-compiler-tests and that crate additionally needs the open #16069 helpers.rs fix to compile. TRIGGER to enroll it as a standing executed guard: #16069 fixed so the crate compiles, AND the v1-compiler-tests crate added to an executed route. THE FORK STAYS OPEN AS A DECLARED RESIDUE: the four interpreted renderers in src/v1/stage0/src/v1_interpreter.rs still carry their own copies of these phrase strings -- a second authority for one text, forkable either way. NEXT RUNG for that residue, dispatched by silent-bee-845 as the follow-up (PR-2): point the four interpreter renderers at this module's generated constants. TRIGGER: PR-1 on main with the generated constants committed by heal-publish, so hand-Rust may reference a symbol that exists -- it cannot co-land, or hand-Rust references a not-yet-committed generated symbol, the E0599 heal deadlock #16224 needed a grant for.",
                tail: FreeSemigroup {
                  head: "the whole-closure typecheck is untouched: compile, emit, the self-verification path and every witness that asks for EveryDeclaration realize every declaration, so no program that BUILDS has ever been checked less than it was; this is a `gunbc run` lowering alone, and a run's verdict is not the gate anything must pass to be built",
                  tail: FreeSemigroup { head: "no second population: what is realized follows from one closure, in one function, for every declaration kind at once", tail: [] }
                }
              }
            }
          }
        }
      } },
    restoration_trigger: "a gunbc run can discharge the type obligation of a declaration no demanded declaration names without realizing it -- by demand-driven realization, where the obligation is discharged against the reading checks that actually consult the declaration rather than against the declaration's whole extent -- or the run's wall-clock and peak-RSS budget no longer needs the cut (measured in this change's PR: reconcile 11 min, peak RSS 16.47 GiB), at which point the population is empty and the drop is deleted rather than argued down"
  } }
}
