import gunbc.guarantee_rung { StructurallyGuaranteed, Mitigatable }

data declared_type_wall_uninstantiated_type_parameter: RungDrop = RungDrop {
  identity: "declared_type_wall_uninstantiated_type_parameter" as NonEmptyStr,

  subject: "the declared-type wall at a kernel formal for an actual whose type is a generic builtin's UNINSTANTIATED type parameter (the match binding of list_head(xs: List<String>) -> Present { value: c }); v1.compiler.infer_env type_reference_declaration_reading reads it as TypeReferenceUninstantiatedTypeParameter and actual_is_unjudged_by_formal leaves it unjudged. Only that reading is unjudged; every other unidentified head refuses",

  declared: "2026-10-19",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "the match binding takes its node from the instantiated scrutinee (v1.compiler.patterns pattern_binding_type, work item C1.2b), after which the binding carries the instantiated type and is judged like any actual" },
    population: [
      "the eleven v2 compiler sites the fresh seed newly refused as expected String got T: src/v2/compiler/module_acquisition.dag x5, source_authority.dag x2, source_root_eval.dag x2, target_serialize.dag x1, body_lowering_fold.dag x1 (each a Present { value: x } binding over a generic builtin result passed at a kernel formal). COST: a user Opt<T> or any wrong-typed value reaching a kernel formal through such a binding is not judged here; the probe ut_list_head_opt_binding_at_string_formal_must_refuse measures it",
    ],
    restoration_trigger: "the match binding takes its node from the instantiated scrutinee (pattern_binding_type, C1.2b), so a binding over list_head, map_get or any generic builtin result carries the instantiated type; the expect-red probe ut_list_head_opt_binding_at_string_formal_must_refuse then greens, TypeReferenceUninstantiatedTypeParameter and is_type_variable_name leave the reading, and this row retires",
  }
}
