module gunbc.rung_drop.shared_index_residency_asserted_after_the_run

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Retired, TypedDeclaration, Enumerated, ReplacementStaged, EndedTypedDeclaration }
import gunbc.guarantee_rung { MechanicallyPreventable, Mitigatable }

// THE DECLARED RUNG DROP for where one-pool-per-slot is enforced in the thread's shared index memo
// (entry_resolve PROCESS_RESOLVE_INDEX), landed with gunbc#12821 on review 73367 and ruled by the
// floor manager (option A): the correctness fix lands now because main's regen round panicked, and
// the enforcement point is declared lowered rather than left implied.
//
// WHAT FELL. gunbc#12765 refused at the build site (SharedIndexRebuiltAfterEviction): an index was
// never rebuilt for roots the slot had already held. That was over-strict for a legitimate shape --
// the regen round demanded two pools on one thread and panicked. gunbc#12821 keys each slot by
// roots so distinct pools coexist, moves the one-shot regen reader to its own index, and asserts at
// most one resident pool per slot (shared_index_residency_control) at the END of the floor and of a
// regen round. So a second pool is caught after it was built and paid for, not before.
//
// WHY IT CANNOT BE REFUSED AT BUILD YET. Refusing a second pool where it is built is correct only if
// no caller legitimately demands one; the population below is every production caller of the shared
// memo, and they pass root sets the change did not audit. Refusing at build without that audit is
// the exact mistake gunbc#12765 made.
//
// THE TRIGGER NAMES THE CAPABILITY: every caller below has its root set audited -- it passes the
// run's own roots, or owns an index for a pool no one else reads -- and the one-pool-per-slot refusal
// is enforced at the build site in try_process_shared_index_for_pool. This row retires in that change.
data shared_index_residency_asserted_after_the_run: RungDrop = RungDrop {
  identity: "shared_index_residency_asserted_after_the_run" as NonEmptyStr,

  subject: "one resident pool per precedence slot in the thread's shared index memo (entry_resolve::PROCESS_RESOLVE_INDEX)",

  declared: "2026-09-30",

  standing: Retired { trigger_fired: "2026-09-30 -- every population caller's root set was audited (the table on the retiring PR): each passes the run's own roots except three one-shot readers of a fixture pool (the regen round's dag-artifact identity compile, the XL-1 primary-root tap, the required-lane resolution census builtin), which now own their index; try_process_shared_index_for_pool refuses a second resident pool in a slot at the build site (SharedIndexSecondResidentPool, naming both root sets and the demanding site), and shared_index_residency_control stays as its positive control" as NonEmptyStr,
    declaration: EndedTypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "the caller audit plus a build-site refusal in try_process_shared_index_for_pool (the follow-up to gunbc#12821)" },
    restoration_trigger: "every population caller's root set is audited (it passes the run's own roots, or owns an index for a pool no other caller reads) and try_process_shared_index_for_pool refuses a second resident pool in a slot at the build site, before it is built; shared_index_residency_control then becomes the positive control of that refusal. Observed at retirement: the build-site refusal fires on a two-pool fixture and the floor and a regen round pass with it; this row retires in the same change."
  }
  }
}
