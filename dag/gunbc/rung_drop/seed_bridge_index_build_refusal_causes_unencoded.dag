module gunbc.rung_drop.seed_bridge_index_build_refusal_causes_unencoded

import std.types { String, List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { OutsideTheLadder, Mitigatable }

// ============================================================================================
// THE DECLARED RUNG DROP for the seed interpreter's encoding of the binding refusal cause
// (DESIGN 4b(3)), landed with the dissolution of binding_outcome_from_resolution.
// ============================================================================================
//
// WHAT IS LOST. `v1_interpreter` `reference_derived_closure_admission_value` converts the
// `.dag` admission list into interpreter values for `namespace_structural_observation_admissions`.
// It encodes a binding refusal whose cause is `StructuralBindingProductionRefused { gap }` in full.
// For the five index-build cause families -- StructuralBindingIndexTransportRefused,
// StructuralBindingIndexModulePathRefused, StructuralBindingIndexExposureRefused,
// StructuralBindingIndexAuthoredOrderRefused, StructuralBindingIndexDeclarationBucketRefused --
// it has no encoder and returns `InterpError::TypeError`, and `namespace_structural_observation_admissions_value`
// propagates it with `?`, so the WHOLE list conversion aborts and the call fails: no member of the
// list is delivered. The base returned a matchable per-capability refusal for these inputs, with
// the cause collapsed (it never carried the full cause either, so this row claims no fidelity the
// base lacked). What is lost is a value-level result, traded for a loud error: a located failure
// instead of a silent narrowing, but a failure of the whole call.
//
// THE TRIGGER NAMES A CAPABILITY: the bridge returns the typed `ReferenceDerivedClosureBindingRefused`
// capability with the COMPLETE cause for these five families, or a replacement route (the
// admission consumed natively rather than through the seed bridge) makes the bridge unnecessary.
// Retirement is observed: the encoder-boundary control
// `binding_refusal_encoder_tests::each_unsupported_cause_yields_the_named_encoding_error` is
// inverted into one asserting the full encoding, and this row retires in that change. A green
// build does not retire it.
data seed_bridge_index_build_refusal_causes_unencoded: RungDrop = RungDrop {
  identity: "seed_bridge_index_build_refusal_causes_unencoded" as NonEmptyStr,

  subject: "the seed interpreter's encoder of ReferenceDerivedClosureBindingRefused causes (v1_interpreter reference_derived_closure_admission_value) and its list wrapper namespace_structural_observation_admissions_value: five index-build cause families abort the whole conversion with an InterpError",

  declared: "2026-10-19",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: Mitigatable,
    temporary: OutsideTheLadder,
    reason: ReplacementStaged {
      replacement: "the admission consumed natively (not through the seed interpreter bridge), or a bridge encoder carrying the complete StructuralBindingRefusal payload",
    },
    population: [
      "StructuralBindingIndexTransportRefused",
      "StructuralBindingIndexModulePathRefused",
      "StructuralBindingIndexExposureRefused",
      "StructuralBindingIndexAuthoredOrderRefused",
      "StructuralBindingIndexDeclarationBucketRefused",
    ],
    restoration_trigger: "THE CAPABILITY: the seed bridge returns the typed ReferenceDerivedClosureBindingRefused admission with the complete cause for each of the five population identities, or a replacement route consumes the admission without the seed bridge. WHAT THAT MUST BE SUFFICIENT FOR: binding_refusal_encoder_tests asserting the full encoding of each family, replacing the encoding-error control. Observed at retirement, not asserted; a green build does not retire it."
  }
}
