module gunbc.rung_drop.native_concat_count_import_scope_until_corpus_imports

import std.types { List, NonEmptyStr, String }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-10-14 with the native cut that unbound-refuses a roster concat/count head unless
// collection_concat_shape / collection_count_shape is import-visible (v2.compiler.resolve
// resolve_atom_unscoped / collection_roster_template_visible). The seed builtin registry still
// admits the heads (v1 semantics-frozen). Required v2-bootstrap therefore stays green: it is
// seed-emitted, not a native ingest of the live corpus. Native ingest of a module that still
// writes bare concat/count is resolve_reason_unbound_symbol. That is loud, not silent; it is
// still a lowered rung for native acceptance of that population until the imports are in those
// modules.
//
// Population is re-derived, not transcribed: (1) the compile_cli native emit (gen-one
// `emit --entry v2.cli.compile_cli --source-root dag --source-root src/v2`) by first-fatal
// reason; (2) authored .dag files under those roots whose comment-stripped body contains concat(
// or count( and whose text does not mention the matching collection_*_shape, excluding
// std.algebra. A markdown sentence naming a PR is not this row.

data native_concat_count_import_scope_until_corpus_imports_population: List<String> = [
  "native emit --entry v2.cli.compile_cli over dag + src/v2: modules whose first fatal is resolve_reason_unbound_symbol at a concat or count atom (AFTER e9bef8d42d: unbound 160; concat/count-attributed rise +10)",
  "authored dag/ and src/v2/*.dag whose comment-stripped body contains concat( without collection_concat_shape or count( without collection_count_shape, excluding std.algebra (re-derived at 54c87601d1: 2056 concat sites, 967 count sites, 2523 files)",
]

data native_concat_count_import_scope_until_corpus_imports: RungDrop = RungDrop {
  identity: "native_concat_count_import_scope_until_corpus_imports" as NonEmptyStr,

  subject: "native resolve of bare concat/count in corpus modules that do not import std.algebra collection_concat_shape / collection_count_shape",

  declared: "2026-10-14",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "import-visible std.algebra.collection_concat_shape / collection_count_shape (ruling B) at every native-ingested concat/count site"
    },
    population: native_concat_count_import_scope_until_corpus_imports_population,
    restoration_trigger: "NATIVE RESOLVE BINDS concat AND count AT A SITE EXACTLY WHEN THE MATCHING TEMPLATE IDENTITY IS IMPORT-VISIBLE OR THE MODULE DECLARES ITS OWN fn, AND A GEN-ONE emit --entry v2.cli.compile_cli OVER dag + src/v2 REPORTS NO resolve_reason_unbound_symbol WHOSE FAILING ATOM IS concat OR count. Sufficient for: the compile_cli closure no longer first-fatals those heads for missing import-scope. NOT sufficient: seed-green v2-bootstrap; a plan-doc sentence; a PR number; a grep that the import token exists in some other file. The generated corpus import rewrite is the change that restores the authored population; this trigger names the capability that rewrite must be sufficient for.",
  }
}
