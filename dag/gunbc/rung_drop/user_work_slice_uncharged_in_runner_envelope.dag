module gunbc.rung_drop.user_work_slice_uncharged_in_runner_envelope

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { MechanicallyPreventable, Mitigatable }

// THE USER-WORK SLICE MEMORYMAX IS DERIVED AND EMITTED, but charging that appropriation into
// served_deployment_slice_allowance would drop srv1 host_memory_admitted_width 12 -> 7, and
// runner_host_deploy_of would set runner_count from that width on the next apply. The operator
// conservation ruling (sessions 52 vs live 128, srv1 runner count) is still open, so
// user_work_charged_in_served_allowance stays 0. That is a conservation class sitting below its
// ceiling: the host budget does not see ~110 GiB the slice may hold. Silence in the allowance
// would be an undeclared drop (review 79922). The trigger is the ruling that sets the charge
// to the appropriation and admits the resulting committed width.
data user_work_slice_uncharged_in_runner_envelope: RungDrop = RungDrop {
  identity: "user_work_slice_uncharged_in_runner_envelope" as NonEmptyStr,

  subject: "the user-work slice MemoryMax (user_work_slice_budget_appropriation) is charged in gunbc.live_deploy.served_slice_charge served_deployment_slice_allowance, so gunbc.runner.runner_slot_allocation host_memory_admitted_width conserves against systemd's bound",

  declared: "2026-10-14",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "user_work_charged_in_served_allowance equal to user_work_slice_budget_appropriation after the operator conservation ruling on 502 GiB usable",
    },
    population: [
      "gunbc.live_deploy.served_slice_charge user_work_charged_in_served_allowance (byte_size(0))",
      "srv1 host_memory_admitted_width pin 12 (would derive 7 if the appropriation were charged)",
    ],
    restoration_trigger: "an operator conservation ruling that sets user_work_charged_in_served_allowance to the derived user_work_slice_budget_appropriation (or an admitted equivalent) and that names the resulting gunbc_runner_committed_width / runner_count for srv1; charging without that ruling would shrink runners on the next host_converge apply",
  },
}
