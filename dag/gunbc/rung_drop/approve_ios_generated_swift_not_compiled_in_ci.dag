module gunbc.rung_drop.approve_ios_generated_swift_not_compiled_in_ci

import std.types { String, List, NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, population_from_list, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 4b(3) DROP (gunbc#14721, 2026-10-22). The generated Swift of apps/approve-ios is held to
// its .dag authority by the regeneration fixed point and the generated-artifact drift gate, which
// prove the bytes are what the authority prints. They do not prove the bytes COMPILE or that the
// protocol vectors hold, because no session host and no fleet runner carries an Apple Swift
// toolchain (measured 2026-10-22: `which swiftc swift` empty on the session host and on the amd64
// ctrl-build runner). swiftc is driven by xcodebuild on the operator's Mac
// (gunbc.generated_artifact RepoConsumer SwiftCompiler), where ProtocolVectorTests last ran by hand.
// Nothing is claimed beyond that: the compile and the XCTest execution are unobserved in CI, not
// observed green.
data approve_ios_generated_swift_not_compiled_in_ci_population: List<String> = [
  "apps/approve-ios/Approve/Protocol.swift: gunbc.generated_artifact ApproveIosProtocolSwiftArtifact",
  "apps/approve-ios/Approve/Wire.swift: gunbc.generated_artifact ApproveIosWireSwiftArtifact",
  "apps/approve-ios/ApproveTests/ProtocolVectorTests.swift: gunbc.generated_artifact ApproveIosProtocolVectorTestsSwiftArtifact",
  "apps/approve-ios/Approve/EnrolmentMachine.swift: gunbc.generated_artifact ApproveIosEnrolmentMachineSwiftArtifact",
  "apps/approve-ios/ApproveTests/EnrolmentMachineTests.swift: gunbc.generated_artifact ApproveIosEnrolmentMachineTestsSwiftArtifact"
]

data approve_ios_generated_swift_not_compiled_in_ci: RungDrop = RungDrop {
  identity: "approve_ios_generated_swift_not_compiled_in_ci" as NonEmptyStr,

  subject: "the generated Swift files of apps/approve-ios: compiled by swiftc and, for ProtocolVectorTests, executed against the server vectors.json (dag/test/fixture/approval_device_redemption/vectors.json); only the regeneration fixed point and the generated-artifact drift gate still hold",

  declared: "2026-10-22",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "the regeneration fixed point plus the generated-artifact drift gate, which prove the committed bytes equal what the .dag authority prints but not that they compile or satisfy the vectors; no Apple toolchain exists on any session host or fleet runner",
    },
    population: population_from_list(xs: approve_ios_generated_swift_not_compiled_in_ci_population),
    restoration_trigger: "THE CAPABILITY: a CI-reachable runner with an Apple Swift toolchain that EXECUTES swiftc over the five generated files above and runs ProtocolVectorTests against the server vectors.json, as a phase of a lane whose red blocks a merge. NOT satisfied by the regeneration fixed point, by the drift gate, or by an operator running xcodebuild on a Mac: each leaves the compile and the vector execution unobserved by the merge path. The row retires when that lane executes and is green over every member."
  }
}
