module gunbc.rung_drop.persisted_resolved_graph_disk_probe_unqualified_format

import std.types { List, NonEmptyStr }
import std.dissolution { dissolution_description }
import std.materialization_provider { resolved_graph_disk_format_unqualified_frontier }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-09-16 (review 66936; fierce-seal ruling: take the §4b(3) drop; do not migrate
// the resolved-graph format inside T2a; do not restore FNV hits). THREE AXES, never "correctness
// dropped": identity/correctness IMPROVED (an FNV-only persisted object cannot be served as
// exact equality); availability/materialization DROPPED (this legacy cache format cannot produce
// a hit; the consumer recomputes the graph and carried outputs); diagnostic-discrimination
// DROPPED (qualification stops before Hit / WrongArtifact / WrongContent). The old outcomes were
// observable distinctions under an underqualified identity, not exact-identity guarantees.
// Restoration reuses std.materialization_provider resolved_graph_disk_format_unqualified_frontier
// (both ObservedEvaluationPreimage AND ResultContentIdentity); it does not mint a second trigger.

data persisted_resolved_graph_disk_probe_unqualified_format_population: List<String> = [
  "std.materialization_provider serve_resolved_graph_stored_disk_probe",
  "std.materialization_provider serve_resolved_graph_incomplete_stored_disk_probe — shares the UnqualifiedPersistedFormat wall",
  "v1_compiler.cli_run resolved_graph_from_sources_with_index — production consumer: a present object of this legacy format cannot serve; the graph and its carried outputs are recomputed (install_cross_process_materialization_hit has no call site; JsonRepresentationCannotServe is the armed cold-recompute diagnostic when the optional disk root is set)",
  "v1_compiler.resolved_graph_cache FORMAT_VERSION 4 objects with v3-layout FNV stored_request_key / stored_semantic_digest / part digests — the legacy disk format lacking ObservedEvaluationPreimage and ResultContentIdentity",
]

fn persisted_resolved_graph_disk_probe_restoration() -> String {
  concat(
    dissolution_description(condition: resolved_graph_disk_format_unqualified_frontier),
    " ATOMIC RESTORATION, ONE CHANGE: format generation bumped; canonical evaluation preimage and exact result-content identity persisted; decoded from disk not derived from the request; PersistedProbe built from the decoded object; prior-format objects get a typed cold-rebuild/migration disposition; controls restored valid->Hit, foreign request->WrongArtifact, foreign content->WrongContent, incomplete->Incomplete; always-miss arm, this drop row, and resolved_graph_disk_format_unqualified_frontier deleted together."
  )
}

data persisted_resolved_graph_disk_probe_unqualified_format: RungDrop = RungDrop {
  identity: "persisted_resolved_graph_disk_probe_unqualified_format" as NonEmptyStr,

  subject: "Availability of a resolved-graph disk hit, and Hit/WrongArtifact/WrongContent discrimination, on the unqualified legacy cache format (identity/correctness of that door improved: FNV-only objects cannot be served as exact equality)",

  declared: "2026-09-16",

  standing: Standing,

  amendments: [],

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "std.materialization_provider resolved_graph_disk_format_unqualified_frontier — both ObservedEvaluationPreimage and ResultContentIdentity persisted before serve_resolved_graph_stored_disk_probe uses PersistedProbe. Availability and diagnostic-discrimination drop on this one legacy cache format; the new materialization-object route stays qualified. Cost: a present object of this format cannot serve; the consumer recomputes the graph and carried outputs. Counts and elapsed time stay in the producing receipt, not this row.",
    },
    population: persisted_resolved_graph_disk_probe_unqualified_format_population,
    restoration_trigger: persisted_resolved_graph_disk_probe_restoration(),
  }
}
