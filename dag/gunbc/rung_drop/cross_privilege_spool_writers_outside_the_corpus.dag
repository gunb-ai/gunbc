module gunbc.rung_drop.cross_privilege_spool_writers_outside_the_corpus

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, ReplacementStaged }
import gunbc.guarantee_rung { StructurallyGuaranteed, MechanicallyPreventable }

// DECLARED beside the model that introduces the seal (gunbc.spool_queue), not at the implementation that first
// depends on it. The sealed spool face makes a forged ENTRY KEY unwritable in the corpus. It cannot make a
// directory entry unwritable in the directory: the attempt-exit inbox is written by a systemd ExecStopPost
// `mkdir` the manager runs, and every spool directory is writable by its declared principals at the POSIX
// level, not by the compiler. So a name no corpus code minted can appear in a spool. The seal stops being the
// guarantee for that population; it becomes decode-time refusal.
//
// WHAT HOLDS NOW (mechanically preventable): the one decode (spool_entry_key / the declaration's key shape)
// refuses a name that does not parse, and a refused name moves to the spool's Refused role and is counted. It
// is neither dropped nor handed to a consumer, and no allowlist of names or paths is consulted. That is
// validation on the real read path, not construction: a writer that never runs the decode is not bound by it.
//
// THE HOOK ITSELF IS NOT THE GAP. Its argv is derived from the same key codec the reader decodes with
// (gunbc.roadmap.roadmap_attempt_exit_spool attempt_exit_hook), so a hook-written name is a corpus-minted key by
// construction. The gap is any OTHER process able to create an entry.

data cross_privilege_spool_writers_outside_the_corpus: RungDrop = RungDrop {
  identity: "cross_privilege_spool_writers_outside_the_corpus" as NonEmptyStr,

  subject: "an entry in a cross-privilege spool directory can be created by a process that never ran the corpus key mint, because the directories' writers are bounded by POSIX ownership and not by the sealed entry key",

  declared: "2026-10-31",

  standing: Standing { declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: MechanicallyPreventable,
    reason: ReplacementStaged {
      replacement: "gunbc.spool_queue spool_declaration writers column plus decode-time refusal into the Refused role; the terminal replacement is directory ownership derived from that same column, so a non-declared principal is refused by the kernel",
    },
    population: Enumerated { members: FreeSemigroup { head: "the attempt-exit inbox, written by the unit's ExecStopPost hook run by the systemd manager", tail: ["the attempt-unit request directory, writable by the requester principal", "the publication request directory, writable by the requester principal"] } },
    restoration_trigger: "THE CAPABILITY: each spool directory is creatable only by the principals gunbc.spool_queue spool_declaration names for it, with directory ownership and modes DERIVED from that declaration, so an entry from any other principal is refused by the kernel rather than by a decode the writer may skip. SUFFICIENT FOR: attempting a create in each spool directory as a principal the declaration does not name, and observing the OS refusal. A permission-bits readback does not retire this row: it states who holds permission, not who can create. Nor does the decode refusal, which is the temporary rung itself.",
  } }
}
