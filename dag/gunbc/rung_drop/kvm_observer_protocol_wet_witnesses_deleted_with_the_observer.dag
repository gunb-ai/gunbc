module gunbc.rung_drop.kvm_observer_protocol_wet_witnesses_deleted_with_the_observer

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, DeletedWithoutReplacement }
import gunbc.guarantee_rung { MechanicallyPreventable, Mitigatable }

// DECLARED 2026-10-09 beside gunbc#13503, operator decision msg_bb46c20f. The KVM observer was deleted
// because it drove the vendor web client, and the 14-claim test.claim.machine_intake.
// mtcollins1_kvm_observer_protocol_wet_witness population executed that observer for real on
// v2.workflow.local_repo_wet_terminal local_repo_wet_schedule. This row is NOT a substitution and has
// no replacement: it is separate from handoff_observer_is_sol_not_kvm_viewer, which declares only that
// SOL stands in for the viewer at the handoff.

data kvm_observer_protocol_wet_witnesses_deleted_with_the_observer: RungDrop = RungDrop {
  identity: "kvm_observer_protocol_wet_witnesses_deleted_with_the_observer" as NonEmptyStr,

  subject: "the real-execution witnesses of the deleted mtcollins1 KVM observer's protocol and process supervision no longer execute on any lane",

  declared: "2026-10-09",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: [
      "THE 14 CLAIMS, by id, all of test.claim.machine_intake.mtcollins1_kvm_observer_protocol_wet_witness, deleted with the observer and never replaced one-for-one",
      "WITH A SURVIVING WET COUNTERPART in test.claim.machine_intake.sol_hold_stdin_wet_witness (4 of 14, each a process-supervision claim): a_launch_that_cannot_publish_its_pid_stops_its_child -> a_launch_that_cannot_publish_its_pid_stops_the_child_it_created; a_term_ignoring_child_with_an_unpublished_record_is_observed_stopped -> a_publication_failure_stops_even_a_term_ignoring_child; a_record_naming_another_process_is_foreign_and_not_released -> a_record_this_attempt_did_not_establish_is_not_released; an_owned_process_is_released_and_observed_gone -> our_collector_is_released_observed_gone_and_its_record_retired",
      "WITH NO COUNTERPART, process supervision (2 of 14): an_unreadable_process_state_never_skips_the_kill_of_an_unpublished_child (unreadable process state); a_relative_observer_directory_is_resolved_once (observer directory)",
      "WITH NO COUNTERPART, viewer and protocol specific (8 of 14): a_held_observer_is_admitted_and_its_triggered_still_is_hash_bound; a_root_page_that_navigates_cannot_destroy_the_login; a_viewer_without_its_feature_list_never_opens_kvm; a_busy_viewer_slot_refuses_the_observer_and_the_handoff; a_connection_lost_mid_boot_is_reported_and_no_still_is_claimed_after_it; an_unreadable_canvas_is_acquisition_failed_with_the_browsers_words; a_stale_listening_line_from_another_pid_is_not_readiness; a_transport_that_exits_at_once_is_not_serving"
    ],
    restoration_trigger: "THE CAPABILITY: a public, non-vendor KVM client that ESTABLISHES the observer (the same capability named by gunbc.rung_drop handoff_observer_is_sol_not_kvm_viewer), AND a real-execution protocol witness for it enrolled on v2.workflow.local_repo_wet_terminal local_repo_wet_schedule that covers the 10 claims above with no counterpart (the 8 viewer and protocol claims and the 2 process-supervision claims with none). WHAT IT MUST BE SUFFICIENT FOR: each of those 10 behaviours executed against a real process and real transport, so that deleting the client or its supervision makes a control fail. A client without such a wet witness, a hermetic-only witness, or a witness not on local_repo_wet_schedule does not satisfy this. The 4 claims with a counterpart are covered meanwhile by sol_hold_stdin_wet_witness for the supervision they share, not for the viewer.",
  }
}
