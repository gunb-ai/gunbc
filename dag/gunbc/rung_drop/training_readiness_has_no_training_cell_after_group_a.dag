module gunbc.rung_drop.training_readiness_has_no_training_cell_after_group_a

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 4b(3) DROP, ruled by valiant-crab-775 on 2026-10-07 under the operator's delegation of the Group A
// config removal: do not invent a training-cell row; declare the coverage loss.
//
// WHAT FELL. gunbc.spark.training_ready spark_training_readiness reads the production cell-role roster
// (gunbc.spark.cell_role spark_cell_role_assignments). Its only rows were srv5 and srv6, deleted with Group A
// (sold, 2026-10-07), so every host now refuses on "no Spark cell role" before readiness reaches the axis a
// claim names. The positive control cannot be satisfied, and three refusal claims refuse for the missing role
// rather than for their own property -- green whatever the property does, which is a mechanically
// preventable wall reduced to mitigation.
//
// WHAT DID NOT FALL. The pool-producer and endpoint-absence claims in the same witness take their inputs
// supplied and do not read the role roster, so they still discriminate.
data training_readiness_has_no_training_cell_after_group_a: RungDrop = RungDrop {
  identity: "training_readiness_has_no_training_cell_after_group_a" as NonEmptyStr,

  subject: "Spark training readiness over the production cell-role roster, which holds no training cell after Group A's decommissioning",

  declared: "2026-10-07",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: [
      "test.claim.spark.spark_training_ready_witness_test w_a_fully_retired_training_cell_is_ready (cannot be satisfied: no host carries a training role)",
      "test.claim.spark.spark_training_ready_witness_test w_an_unobserved_subject_refuses_on_every_axis (refuses on the missing role first)",
      "test.claim.spark.spark_training_ready_witness_test w_a_still_serving_endpoint_refuses (refuses on the missing role first)",
      "test.claim.spark.spark_training_ready_witness_test w_a_non_positive_pool_refuses_rather_than_offering_nothing (refuses on the missing role first)",
    ],
    restoration_trigger: "a fleet host is assigned a training cell role in gunbc.spark.cell_role spark_cell_role_assignments, SUFFICIENT FOR spark_training_readiness to reach every axis these four claims name: the positive control admits that host when fully retired, and each refusal claim refuses on its own named property rather than on the missing role",
  }
}
