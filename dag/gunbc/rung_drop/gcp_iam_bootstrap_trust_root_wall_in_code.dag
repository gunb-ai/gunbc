module gunbc.rung_drop.gcp_iam_bootstrap_trust_root_wall_in_code

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { StructurallyGuaranteed, MechanicallyPreventable }

// THE TRUST ROOTS ARE WALLED ONLY IN CODE (DESIGN 4b(3)). iam-bootstrap's role holds setIamPolicy on
// every account and pool in the project, and neither deny nor allow conditions can name these
// resources, so the five trust roots -- iam-converge, iam-observe and iam-bootstrap, and the two pools
// whose principal sets reach them -- are kept out of every delta only by the route's refusal
// (gunbc.auth.gcp_iam_bootstrap_delta_route trust_root_subject). Denial conditions recognize resource
// tags (https://cloud.google.com/iam/docs/deny-overview, read 2026-10-18) and service accounts take
// tags while workload identity pools are not listed
// (https://cloud.google.com/resource-manager/docs/tags/tags-supported-services, read 2026-10-18), so the
// three accounts can climb; the two pools are a separate residual (gunbc.rung_drop gcp_iam_bootstrap_trust_pool_untaggable).
data gcp_iam_bootstrap_trust_root_wall_in_code: RungDrop = RungDrop {
  identity: "gcp_iam_bootstrap_trust_root_wall_in_code" as NonEmptyStr,
  subject: "iam-bootstrap writing the policy of a trust-root account",
  declared: "2026-10-18",
  standing: Standing,
  declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: MechanicallyPreventable,
    reason: ReplacementStaged { replacement: "a ceremony stage that binds a gunbc-trust-root tag on the three accounts, and a tag-conditioned deny of iam.googleapis.com/serviceAccounts.setIamPolicy for iam-bootstrap" },
    population: [
      "account iam-converge@gunbai-secrets.iam.gserviceaccount.com", "account iam-observe@gunbai-secrets.iam.gserviceaccount.com",
      "account iam-bootstrap@gunbai-secrets.iam.gserviceaccount.com",
    ],
    restoration_trigger: "the gunbc-trust-root tag is bound on the three accounts and a tag-conditioned deny refuses iam-bootstrap serviceAccounts.setIamPolicy/actAs/getAccessToken on them, observed by readback"
  }
}
