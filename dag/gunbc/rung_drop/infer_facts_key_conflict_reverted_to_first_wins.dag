module gunbc.rung_drop.infer_facts_key_conflict_reverted_to_first_wins

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { StructurallyGuaranteed, OutsideTheLadder }

// THE DECLARED RUNG DROP for v2 infer's facts table (DESIGN 4b(3)), landed with the revert of
// gunbc#12582 because review 73473 on the revert found the drop undeclared.
//
// WHAT IS DROPPED. With #12582, v2.compiler.infer inferred_facts_map_enter refused a facts key that
// arrived with two DIFFERENT facts (infer_facts_key_conflict, located at the key), on the real
// acceptance path. The revert restores first-wins: the second, differing fact is dropped with no
// diagnostic and every consumer reads whichever gather produced first. That is silent wrongness, so
// the temporary rung is outside the ladder, not a weaker rung.
//
// WHY IT WAS DROPPED. The refusal was right about the conflict and wrong to land alone: the childless
// synthetic Conj that terminates both a qualified-name spine and an int literal's digit list is ONE
// Node value, infer records a facts entry for each, and so `fn kc_g() -> Int { 1 }` beside
// `fn kc_f() -> Int { kc_g() }` was refused (measured on main c95f906; 5 claims of #12763 red). The
// earliest unjustified link is infer deriving a fact for a structural list terminator at all.
//
// THE ROUTE BACK IS STAGED, in order: a declared list-spine end label (CoreEdgeLabel ListSpineEndEdge,
// minted only by fold_list_node, stacked on the typed EdgeLabel of #12799), infer's gather recording no
// facts entry for the target of that edge, then the refusal re-landed.
data infer_facts_key_conflict_reverted_to_first_wins: RungDrop = RungDrop {
  identity: "infer_facts_key_conflict_reverted_to_first_wins" as NonEmptyStr,

  subject: "v2.compiler.infer inferred_facts_map_enter: a facts key carrying two different facts is admitted first-wins instead of refused infer_facts_key_conflict",

  declared: "2026-10-01",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: OutsideTheLadder,
    reason: ReplacementStaged { replacement: "a declared list-spine end edge (CoreEdgeLabel ListSpineEndEdge, minted only by v2.std.algebra fold_list_node, on #12799's typed EdgeLabel), infer's gather recording no facts entry for that edge's target, then the infer_facts_key_conflict refusal re-landed" },
    population: [
      "every v2 infer run whose gather produces two entries under one structural Node key with different facts; the measured specimen is the childless synthetic Conj shared by a qualified-name spine terminator and an int-literal digit-list terminator",
    ],
    restoration_trigger: "infer's facts key has no shared-identity collision between structurally distinct subjects: no structural list terminator receives a facts entry (read from a declared edge label, never from the empty-Conj shape), so the infer_facts_key_conflict refusal is restored on the real path with v2.test.infer_facts.key_collision_ref_and_int green FOR THAT REASON, an authored empty Conj still refusing on a real conflict, zero infer_facts_key_conflict refusals across the corpus, and #12763's 13 claims green. This row retires in that change."
  }
}
