module gunbc.rung_drop.worker_root_equivalent_socket_denylist

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }

// Grain: the credential a unit running worker- or candidate-controlled code holds. Ceiling is that the
// worker never holds a root-equivalent group; this row is the interim deny-list under it.

data worker_root_equivalent_socket_denylist: RungDrop = RungDrop {
  identity: "worker_root_equivalent_socket_denylist" as NonEmptyStr,

  subject: "Whether worker-controlled code holds a credential that reaches root: the instance account (briansrls on srv1) is in groups docker and lxd, so a unit running as it can ask a root daemon for a privileged container with / mounted",

  declared: "2026-10-17",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "run attempt workers as a dedicated unprivileged account holding no sudo and no root-equivalent group, as a system-manager transient started through gunbc.roadmap.attempt_system_unit_launch (User= derived from a gunbc.fleet.fleet_posix_accounts row, converged by the deploy that installs the launcher grant). The interim is InaccessiblePaths= over the known docker, containerd, podman and lxd sockets (gunbc.compute.unit_bounds worker_root_equivalent_socket_paths).",
    },
    population: [
      "every unit rendered through compute_grant_unit_properties (dispatch workers, verification compute units) and dispatch_review_unit_properties (reviewer, auditor, supervisor) on a host whose instance account is in a root-equivalent group",
      "FAILS OPEN for the next root-equivalent socket or group not in the list",
      "NOT ENFORCED in the srv1 user manager: InaccessiblePaths= is a mount-namespace property and is dropped there like ProtectSystem (gunbc.rung_drop.user_manager_worker_write_boundary_unenforced); it binds only on the system-manager launcher path",
      "NOT in the population: belt obligation units, which run controller code and not worker output",
    ],
    restoration_trigger: "THE CAPABILITY: the worker unit's User= is a dedicated account with no root-equivalent group and no sudo, so the credential is never held. Evidence is bright-moth-475 reading, from inside a live worker unit on srv1 lab, that id shows no docker or lxd group, sudo -n true fails, and a docker.sock connect is refused. WHAT DOES NOT RETIRE THIS ROW: lengthening the socket list, or rendering the property in more units.",
  },
}
