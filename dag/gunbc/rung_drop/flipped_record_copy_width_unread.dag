// Population entries read "<emitted stage0 module stem> <record>": the records the seed emits
// by value where the base emitted Rc, from the declaration-identity predicate
// `is_clone_allocation_free` in v1.compiler.emit_rust.
data flipped_record_copy_width_unread: RungDrop = RungDrop {
  identity: "flipped_record_copy_width_unread" as NonEmptyStr,

  subject: "runtime copy width of records that F (is_clone_allocation_free) moves from Rc<T> to by-value: each clone now copies every field instead of one pointer; the allocation meter counts operations and bytes, not copy width, and no elapsed-time observation exists in the emitted native entry",

  declared: "2026-10-18",

  standing: Standing,

