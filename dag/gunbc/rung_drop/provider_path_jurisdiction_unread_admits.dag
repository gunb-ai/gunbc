module gunbc.rung_drop.provider_path_jurisdiction_unread_admits

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }

// ============================================================================================
// THE DECLARED RUNG DROP for a located data path whose jurisdiction upstream does not document
// (DESIGN 4b(3)).
// ============================================================================================
//
// WHY THIS ROW EXISTS AT ALL. The departure stood as an ANNOTATION for exactly one revision, and an
// annotation cannot discharge it -- DESIGN 4c is explicit that no Accepted program reads one, so a
// machine claim living only in prose is a claim nothing checks. Review 63995 named it: a next-rung
// trigger written in a comment is invisible to 4b(2)'s no-untracked-stall and to the drop roster
// that exists to count exactly this.
//
// WHAT THE DROP IS. product.fabric.provider_route ProviderPathLocated carries operator, jurisdiction
// and evidence, and a consumer matching it reads all three as established. The Spark serving route's
// telemetry path cannot honour the middle one: vLLM reports usage statistics to a service upstream
// publishes the address of and nothing else about, so who operates it and under which legal system
// are UNREAD. The path is nevertheless recorded as Located, with its jurisdiction slot citing the
// field holding ServiceJurisdictionUndocumentedUpstream -- so the fact is reachable from the value,
// and is not reachable from the ARM, which is the part that is dropped.
//
// WHY THE FAIL-CLOSED ARM WAS NOT TAKEN. ProviderPathUnread exists, is reachable, and refuses the
// whole route as ProviderRouteFactsIncomplete. It is the right answer to "is this path resolved" and
// the wrong answer to the question actually being asked, because it refuses over a path that carries
// NO ROUTE MATERIAL: extdeps.vllm.usage_stats records the documented payload as host, build and
// engine configuration, with request content, prompts and completions excluded upstream. Refusing
// would stop serving on a metadata egress while saying nothing about where route material goes.
// Ruled by the operator on 2026-09-11, on the condition -- executed, not promised -- that the
// payload stay metadata-only: gunbc.spark.first_party_serving matches the content class and takes
// the refusing arm if upstream ever reports CarriesRequestMaterial.
//
// WHAT IS AND IS NOT LOST. Not lost: whether the path exists, who receives it, and what it carries --
// all three typed, folded and refusable. Lost: the guarantee that a Located path's jurisdiction was
// established.
//
// THE POPULATION IS CURRENTLY EMPTY, AND THAT IS NOT THE SAME AS THE SUBJECT BEING GONE. The
// distinction is the whole point of this paragraph, because the two are recorded differently and
// only one of them is true. What this row waives is the JURISDICTION guarantee for a located path
// whose reporter is established and applicable, and that waiver is untouched: Located remains the
// right answer for such a reporter, and the operator's 2026-09-11 ruling still governs it. What has
// changed is that gunbc.spark.first_party_serving no longer ATTRIBUTES a reporter and its path to
// the launch that answered without evidence bound to that launch, so nothing currently reaches the
// located arm and the row admits nothing today. The arm is retained and reachable; it is GATED on
// the attribution evidence named at spark_serving_usage_stats_declared_environment_obligation.
//
// SO THIS ROW IS NOT RETIRED AND IS NOT DISSOLVED. Not retired, because DESIGN 4b(3) retires a drop
// by its restoration trigger and by nothing else, and that trigger -- a jurisdiction standing on
// ProviderPathStanding -- does not exist. Not dissolved by subject deletion either, which an earlier
// draft of this paragraph claimed: the admitting path was not deleted, and recording it as deleted
// would make the ruling silently unreachable while this record went on claiming otherwise. It stands
// with an empty population, pending attribution, and it starts counting again the moment an
// evidence-bearing admission path is built.
//
// A FOURTH ITEM WAS CLAIMED HERE AND IS NOW GONE, and the correction belongs in this row rather than
// only in the module, because this row is what a reader consults to learn what survived the drop. It
// read "whether the launch could have disabled it -- typed, folded and refusable", which was true
// while gunbc.spark.first_party_serving concluded from the DECLARED container environment that
// reporting was off for the deployment that answered, and turned the path Absent on that basis. That
// conclusion was a claim about a process nobody read, so it was withdrawn -- and then the fold behind
// it was deleted outright rather than kept behind a population that happens to be empty today, because
// a deciding standing that still consults the declared environment is only postponing the same
// attribution. gunbc.spark.first_party_serving no longer imports spark_pair_container_env at all.
// So this row no longer claims anything about disabling: what the launch is declared to do is not
// consulted, and what the process does needs the capability named at
// gunbc.spark.first_party_serving spark_serving_usage_stats_declared_environment_obligation.
//
// THE HARM THE DROP ADMITS, unchanged by that correction: a consumer asking "which legal systems does
// this route touch" gets a confident answer from two paths and a citation standing where a
// jurisdiction belongs from the third, and nothing in the arm tells it apart.
//
// THE TRIGGER NAMES THE CAPABILITY, NOT AN ARTIFACT. Reading stats.vllm.ai's operator off a
// third-party page would not retire this row: it would fill one slot for one route and leave the
// next located path with an undocumented counterparty in the same position. The capability is a
// jurisdiction standing ON ProviderPathStanding -- sufficient for a located path to declare its
// jurisdiction unread WITHOUT the whole path becoming unread -- at which point this route states the
// fact in its arm and the drop has nothing left to admit.
//
// EXTENDED 2026-09-12 TO THE JURISDICTION-PERMISSION ARM, AND THE EXTENSION IS THE SAME DROP
// REACHING A SECOND CONSUMER RATHER THAN A NEW ONE. product.fabric.provider_admission restored
// TransferOrLocationUnresolved, which compares a located path's jurisdiction against the population
// a posture permits. That arm asks a question the 2026-09-11 ruling never answered: the ruling said
// this path resolves and carries no route material, not that an undocumented counterparty is a
// PERMITTED place. Since the sentinel is the absence of a jurisdiction, it can never be answered by
// a permitted-jurisdiction comparison at all, so the route would refuse -- a standing operator
// ruling broken by a wall landing beside it.
//
// WHAT IS ADMITTED IS THE SAME SINGLE PATH, ON THE SAME REASONING, AND IT IS NOW EXECUTED RATHER
// THAN ASSERTED. gunbc.spark.first_party_serving spark_first_party_posture carries a
// product.fabric.provider_route JurisdictionDropEnrollment naming this row, the path's own evidence
// declaration (spark_serving_usage_stats_standing) and the exact citation excused, so the fold
// reads the exception instead of the exception living in this prose. The population below is
// unchanged in extent: it is one path, keyed to its declaration.
//
// THE KEY IS THE PATH, NOT THE SENTINEL, AND THAT IS WHAT KEEPS THE POPULATION BOUNDED. Keying the
// exception on the undocumented-jurisdiction citation would exempt every route that cites it,
// present and future -- an unbounded standing permission wearing a drop row's clothes, and a strictly
// worse version of the third-party-page move this row's own trigger already rejects for filling one
// slot and leaving the next path in the same position. test.claim.fabric.provider_admission_witness
// carries the discriminating red: a second fixture route citing the SAME sentinel from a DIFFERENT
// path declaration is not enrolled and refuses as TransferOrLocationUnresolved.
//
// THE RESTORATION TRIGGER IS UNCHANGED AND IS NOT DISCHARGED BY ANY OF THIS. It names a jurisdiction
// standing on ProviderPathStanding sufficient for a located path to declare its jurisdiction unread
// without the whole path becoming unread. Neither the permitted-jurisdiction population nor the
// enrollment builds that capability; they make the existing exception countable and bounded, which
// is a different thing from retiring it.
//
// DECLARED 2026-09-11 with the Spark first-party serving route, under review 63995.

// THE POPULATION IS EMPTY AND THAT IS A COUNTED ZERO, NOT AN UNCOUNTED ONE. Nothing reaches
// gunbc.spark.first_party_serving spark_usage_stats_telemetry_path's located arm, because
// spark_serving_usage_stats_standing returns UsageStatsLaunchUnread on every arm, so this row
// admits nothing today. A previous spelling put that sentence INSIDE the list as its sole
// member, which made gunbc.rung_drop rung_drop_declaration_message publish a one-member
// population whose one member denied being a member -- and any consumer counting members got 1.
// A fabricated plausible value is worse than an uninformative one, which is why this is [].
//
// WHAT THE EMPTY LIST COSTS, DECLARED RATHER THAN DISCOVERED: the projection renders
// "Population: " and stops, and DESIGN 4c means this annotation is unreadable to any consumer,
// so the REASON the population is zero does not reach docs/design-rung-drops.md. That is
// uninformative rather than wrong -- nothing plausible is asserted. It is not the
// bottom-as-answer conflation gunbc.guarantee_stall warns about either: that warning is about
// rows whose exposure is UNBOUNDED, where [] would falsely read as "nothing is affected". Here
// nothing IS affected, so in that carrier's vocabulary this row is BoundedPopulation with no
// members and the empty list is the correct value rather than a compromise.
// WHAT THE MERGE WITH #11194 DECIDED HERE, AND WHY THE POPULATION IS STILL EMPTY. That change
// enrolled this drop as an EXECUTED exception: gunbc.spark.first_party_serving
// spark_first_party_posture now carries a JurisdictionDropEnrollment naming this row, with
// path_evidence spark_serving_usage_stats_standing and the undocumented-jurisdiction field. Its
// population member says that path "returns ProviderPathLocated". After this branch's repair it
// does not: spark_serving_usage_stats_standing answers UsageStatsLaunchUnread on every arm, so
// spark_usage_stats_telemetry_path returns ProviderPathUnread for every input and no located path
// with an undocumented jurisdiction is produced. Keeping that member would have reinstated, in the
// projected ledger, the exact claim this branch removed from the code.
//
// SO THE ENROLLMENT IS CURRENTLY UNREACHABLE, WHICH IS #11194'S SUBJECT AND NOT THIS ROW'S TO
// SETTLE. The enrollment is well-formed and its matching rule is keyed to this path rather than to
// a sentinel, which is the stronger design; what it now lacks is an occurrence, because the arm it
// excepts cannot be reached while the telemetry path refuses. It becomes live again by the same
// trigger that repopulates this row -- evidence identifying the deployment that answered -- so the
// two are discharged together rather than separately.
data provider_path_jurisdiction_unread_admits: RungDrop = RungDrop {
  identity: "provider_path_jurisdiction_unread_admits" as NonEmptyStr,

  subject: "one ProviderPathLocated whose jurisdiction upstream does not document, admitted rather than refused because the path carries no route material, with the unread fact reachable from the cited field and not from the arm -- both by product.fabric.provider_route's resolution fold, which reads it as Located, and by product.fabric.provider_admission TransferOrLocationUnresolved, which cannot compare a non-jurisdiction against a permitted-jurisdiction population",

  declared: "2026-09-11",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
  population: [
    "gunbc.spark.first_party_serving spark_usage_stats_telemetry_path returns ProviderPathLocated when the answering container's effective usage-stats configuration is enabled (metadata-only reporter, undocumented jurisdiction enrolled on this path)",
  ],
    restoration_trigger: "product.fabric.provider_route ProviderPathStanding carries a jurisdiction standing SUFFICIENT FOR a located path to declare its jurisdiction unread without the whole path becoming unread -- so that a consumer matching the located arm can see which of its three components were established -- and gunbc.spark.first_party_serving's telemetry path states the fact in its arm. Reading who operates the usage-stats service does NOT discharge this row: it fills one slot on one route and leaves every other located path with an undocumented counterparty in the same unexpressible position",
  }
}
