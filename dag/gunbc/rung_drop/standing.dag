module gunbc.rung_drop.standing

// THE DERIVATION THE PROJECTION USES, so "standing today" has one authority and not two. It lives
// beside the DERIVED roster rather than in it because `gunbc.rung_drop.roster` is written by the
// compiler's directory fold (v1_compiler.cli_run.derived_row_roster) and carries membership only;
// a hand-authored function inside a generated file would be overwritten on the next collect.
//
// The standing arm is read AT THE ONE SITE THAT CONSUMES IT rather than through a reusable
// RungDropStanding -> Bool accessor: a named predicate beside a coproduct is a second, weaker
// spelling of the variant the row already carries, and every later caller reaches for the Bool
// instead of the arm it came from.

import std.types { List, Bool }
import gunbc.rung_drop { RungDrop, Standing, Retired, Superseded, Dissolved, TypedDeclaration, AuthoredProse }
import gunbc.rung_drop.roster { rung_drop_roster }

fn standing_rung_drops() -> List<RungDrop> {
  filter(rung_drop_roster, d => match d.standing {
    Standing => true
    Retired { trigger_fired: _ } => false
    Superseded { ruling: _, decision_record: _, loss_holder: _ } => false
    Dissolved { ruling: _, decision_record: _, population_gone: _ } => false
  })
}

// EVERY SUPERSEDED ROW'S LOSS HOLDER IS A ROSTERED DROP THAT STILL STANDS. Superseded.loss_holder
// names the drop that now carries the superseded row's loss; it is a string, so a typo or a rename
// would silently drop that loss. This join is the wall: each holder must match EXACTLY ONE row of
// the supplied roster by identity, and that row must be Standing -- a holder that is itself retired
// or superseded carries nothing. Parameterized on both populations so the witness can hand it a
// missing holder and a non-standing holder, as gunbc.rung_drop_amendment
// every_amendment_names_a_rostered_drop does for amendments. A typed reference to the holder's
// declaration would be construction rather than this validation; it would make RungDropStanding
// recursive through RungDrop, which this carrier does not take on here.
fn superseded_loss_holders_stand(drops: List<RungDrop>, roster: List<RungDrop>) -> Bool {
  all(drops, d => match d.standing {
    Standing => true
    Retired { trigger_fired: _ } => true
    Superseded { ruling: _, decision_record: _, loss_holder: h } => loss_holder_stands(holder: h as String, roster: roster)
    Dissolved { ruling: _, decision_record: _, population_gone: _ } => true
  })
}

fn loss_holder_stands(holder: String, roster: List<RungDrop>) -> Bool {
  let holders = filter(roster, r => (r.identity as String) == holder)
  length(xs: holders) == 1 && length(xs: filter(holders, r => match r.standing {
    Standing => true
    Retired { trigger_fired: _ } => false
    Superseded { ruling: _, decision_record: _, loss_holder: _ } => false
    Dissolved { ruling: _, decision_record: _, population_gone: _ } => false
  })) == 1
}

// A DISSOLVED ROW IS ADMITTED ONLY OVER AN EMPTY TYPED POPULATION. Dissolved removes a drop from
// every live account, so its three prose fields cannot be the evidence that the population is gone:
// the row's own typed population must already be empty (the population list it derives from is
// empty). A non-empty typed population refuses, and so does a prose declaration, whose population
// is not readable as a list; a prose row stays Standing or Superseded until it carries a typed
// declaration.
fn dissolved_populations_empty(drops: List<RungDrop>) -> Bool {
  all(drops, d => match d.standing {
    Standing => true
    Retired { trigger_fired: _ } => true
    Superseded { ruling: _, decision_record: _, loss_holder: _ } => true
    Dissolved { ruling: _, decision_record: _, population_gone: _ } => match d.declaration {
      TypedDeclaration { previous: _, temporary: _, reason: _, population: p, restoration_trigger: _ } => length(xs: p) == 0
      AuthoredProse { legacy: _, authored: _ } => false
    }
  })
}
