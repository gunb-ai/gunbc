module gunbc.rung_drop.gcp_secret_version_state_wire_string

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, StructurallyImpossible }

// DECLARED HERE, NOT IN A COMMENT. The drop was first carried only in a `//` block at the field,
// which gunbc.design_argument::source_annotations rules out as evidence for a machine claim; the
// roster (review 95859 on the read-step PR) is where it lives.
//
// WHICH ERROR CLASS FELL. Before, GcpSecretVersion.state was the closed coproduct SmVersionState, so
// an unrecognized version state had no constructor and could not cross the decode boundary. It is now
// String and any wire spelling is writable, in FIVE positions: the inventory record and the four
// version-operation outputs. The cause is named at the field: the decoder cannot yet bind Google's
// upper-case wire spellings ("ENABLED", "DISABLED", "DESTROYED") onto the typed variants, and there is
// no variant wire-spelling declaration site in dag/extdeps to bind them with (git grep -nE
// '[A-Z][A-Za-z]+ from "[A-Z_]+"' dag/extdeps finds none) -- the missing piece is in the language
// layer, which is why this is declared as a drop rather than quietly kept.

data gcp_secret_version_state_wire_string: RungDrop = RungDrop {
  identity: "gcp_secret_version_state_wire_string" as NonEmptyStr,

  subject: "the version state of extdeps.cloud.gcp.secret_manager: an unrecognized or misspelled version state string crossing the decode boundary into consumers, in the inventory record and the four version-operation outputs",

  declared: "2026-11-16",

  standing: Standing { declaration: TypedDeclaration {
    previous: StructurallyImpossible,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: Enumerated { members: FreeSemigroup { head: "extdeps.cloud.gcp.secret_manager GcpSecretVersion state", tail: ["extdeps.cloud.gcp.secret_manager GetVersion output state", "extdeps.cloud.gcp.secret_manager DisableVersion output state", "extdeps.cloud.gcp.secret_manager EnableVersion output state", "extdeps.cloud.gcp.secret_manager DestroyVersion output state"] } },
    restoration_trigger: "a variant wire-spelling declaration site at the decode boundary, sufficient for the wire strings ENABLED, DISABLED and DESTROYED to be bound onto the SmVersionState variants during decoding so an unrecognized state is refused AT the boundary and every position listed in the population returns to the closed carrier SmVersionState. NOT satisfied by every consumer continuing to project through sm_version_state_of, by a review habit, or by an annotation saying the projection is required -- none of those makes the unrecognized state unconstructible, which is what the previous rung was.",
  } }
}
