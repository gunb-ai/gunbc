module gunbc.rung_drop.resolve_subject_witnesses_cannot_enrol_in_the_floor

import std.types { List, NonEmptyStr }
import gunbc.rung_drop { Standing, RungDrop, TypedDeclaration, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-09-22 (gunbc#12033). LEAD WITH THE MEASUREMENT, BECAUSE IT IS ONE NUMBER AND IT
// SETTLES THE WHOLE ROW: dag_language_model() COSTS 90028 EVAL STEPS ON ITS OWN, against a floor
// per-claim ceiling of 72300. A claim whose entire body is `match dag_language_model() { lm =>
// true }` measures 90028 and is refused on cost before it asserts anything. Measured on this
// branch with claim_batch; eval steps are host-independent (the same probe measures 3814 for
// dag_prepared_grammar on both the amd64 runner and an arm64 container), so a local figure is
// directly comparable to the CI ceiling.
//
// THIS IS A SCOPE MISMATCH, NOT A DEBT. The ceiling was derived from work that is not this
// subject. Every resolve-subject witness must pass a LanguageModel -- assemble_program_from_ingest
// takes one, and so does assemble_program_from_module_roots, because resolve_with_admission needs
// it, and v2.compiler.program_assembly carries no prepared or partial variant that avoids it. So
// the cost is not a property of how these claims are written: no resolve-subject claim can fit,
// at any specimen size, with any supply strategy, however well authored. A debt row says we were
// profligate and will repay; this says the ceiling and the subject are denominated differently.
// The supplied-token shape this PR introduces (v2.test.parse.supplied_token_stream_support) does
// NOT rescue them: it removes tokenize, and tokenize is not their floor.
//
// THE HARM IS NOT THE SEVEN ROWS BELOW. The ceiling applies to witnesses arriving after the cut,
// so what this establishes is that NO NEW RESOLVE-SUBJECT WITNESS CAN EVER BE ENROLLED. Existing
// coverage is grandfathered and persists; nothing may join it. Resolve-subject coverage is
// therefore FROZEN, and the blind spot GROWS, because the corpus keeps changing under a fixed set
// of witnesses -- every future change to resolve, Pkg12 among them, lands with whatever enrolled
// evidence happens to already exist and cannot add to it. The seven identities are the visible
// cost; the invisible one is every resolve witness that will not be written because it cannot be
// enrolled.
//
// WHY THIS IS A SEPARATE ROW FROM THE NORMALIZE-SUBJECT ONE, and the reason is the trigger rather
// than the cost. gunbc.rung_drop normalize_fn_body_witnesses_over_the_floor_ceiling retires when
// the per-fn-body lowering charge drops; THIS row does not, because the language model is not on
// that path. One row covering both populations would be retired by a trigger that fixes half of
// it -- DESIGN section 4b(3)'s trigger naming less than the capability it restores, arriving
// through the POPULATION rather than through the trigger text. Same defect, different door.
//
// BOUNDED, AND HERE IS WHAT WOULD MAKE IT GROW. The population is the seven identities named
// below and nothing else. A row joins only by being a resolve-subject witness that a floor run
// reports over the ceiling, and adding one is a decision to be taken here, in this row, with its
// measurement -- not by a lane discovering its claim is over budget and reading itself into a
// category. A ceiling that silently accepts new members is the escape hatch DESIGN section 5
// forbids.
data resolve_subject_witnesses_cannot_enrol_in_the_floor_population: List<String> = [
  "v2.test.claim.match_arm_binder_frame.mab_shadowing_binder_binds_the_arm",
  "v2.test.claim.match_arm_binder_frame.mab_outer_test_code_name_still_refuses_without_a_binder",
  "v2.test.claim.match_arm_binder_frame.mab_fresh_binder_binds",
  "v2.test.claim.match_arm_binder_frame.mab_unbound_name_in_arm_body_refuses",
  "v2.test.claim.match_arm_binder_frame.mab_misspelled_tag_refuses",
  "v2.test.claim.match_arm_binder_frame.mab_binder_does_not_leak_to_a_sibling_arm",
  "v2.test.claim.match_arm_binder_frame.mab_nested_braced_and_shorthand_binders_bind",
]

data resolve_subject_witnesses_cannot_enrol_in_the_floor: RungDrop = RungDrop {
  identity: "resolve_subject_witnesses_cannot_enrol_in_the_floor" as NonEmptyStr,
  subject: "a witness whose subject is v2.compiler.resolve is enrolled in the required floor, so resolve behaviour is gated rather than merely asserted",
  declared: "2026-09-22",
  standing: Standing,
  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: resolve_subject_witnesses_cannot_enrol_in_the_floor_population,
    restoration_trigger: "dag_language_model() costs less than the floor's per-claim eval-step ceiling, OR that ceiling is re-derived for the resolve subject class against a calibration that includes a language-model construction. Measured by the same probe that established this row: a claim whose whole body is `match dag_language_model() { lm => true }`, which measured 90028 against 72300 on 2026-09-22. Neither a reduction that leaves it above the ceiling nor an investigation into the cost satisfies this: the capability restored is that a NEW resolve-subject witness can be enrolled, and the check is that one is."
  }
}
