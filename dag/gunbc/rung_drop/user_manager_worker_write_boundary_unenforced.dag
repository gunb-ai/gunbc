module gunbc.rung_drop.user_manager_worker_write_boundary_unenforced

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// Grain: write confinement of dashboard attempt workers started as systemd --user transients.
// The corpus reported mechanical preventability from rendered ProtectSystem/ReadWritePaths;
// on srv1 those options are dropped without error (apparmor_restrict_unprivileged_userns=1).
// DESIGN 4b(1): the rung is the minimum across in-scope paths. This row is that minimum.

data user_manager_worker_write_boundary_unenforced: RungDrop = RungDrop {
  identity: "user_manager_worker_write_boundary_unenforced" as NonEmptyStr,

  subject: "Whether a dispatched attempt worker started as a systemd user-manager transient cannot write outside its declared ReadWritePaths — assessed at the KERNEL/MANAGER PATH that runs on srv1, not at the rendered property list",

  declared: "2026-10-14",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "system-manager transients with User= started by gunbc.roadmap.attempt_system_unit_launch attempt_system_unit_launch_cli from the root-owned sha-addressed launcher release (sudoers grant emitted by gunbc.live_deploy.emit attempt_system_unit_grant_steps). The launcher is modeled; it is not live on srv1 until that grant is installed on a runner host and the wet launcher claims execute. A property-membership witness is not the replacement.",
    },
    population: [
      "every dashboard attempt worker started through systemd-run --user on srv1, including gunbc-attempt-* transients under the live and lab instances",
      "VERIFIED 2026-10-14 by bright-moth-475 on srv1 (issuecomment-6175000334): systemd-run --user -p ProtectHome=read-only -p ProtectSystem=strict sh -c \"touch $HOME/x\" succeeds, including with PrivateUsers=yes; a live unit wrote <IR>/bin which is not in its ReadWritePaths",
      "NOT in the population: system-manager units (PID 1) where those properties do apply; hosts where unprivileged userns is not restricted; the dry membership claims in test.claim.roadmap.dispatch_worker_confinement_witness, which remain true of the rendered plan and do not establish this rung",
    ],
    restoration_trigger: "THE CAPABILITY: the attempt-system-unit launcher grant installed on a runner host (root-owned release + sudoers pin), sufficient for test.claim.roadmap.dispatch_worker_writable_sandbox_wet_witness to run as a gated consumer. Evidence is a dispatched gunbc-attempt-* worker on srv1 lab, started through that grant as a system-manager transient with User= and the production property set, refused when it writes outside ReadWritePaths — writes_through_the_launcher_to_bin_and_source_hooks_are_refused going green on that host (bright-moth-475 runs those wet cells on srv1 lab after deploying the grant). WHAT DOES NOT RETIRE THIS ROW: rendering Protect* correctly; narrowing ReadWritePaths; adding another hermetic membership claim; modeling the launcher without the grant installed on a runner host and that wet executing.",
  },
}
