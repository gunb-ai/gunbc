module gunbc.rung_drop.fabric_storage_append_principal_unrefused

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED WITH THE CUTOVER THAT CAUSED IT (gunbc#11723, review 68598). Under git, an append to the
// fabric event log was a push to ssh://<operator>@srv1/..., so a writer had to hold an ssh credential
// accepted on srv1: a principal refusal the transport performed. The fabric DB endpoint that replaced
// it binds loopback behind tailscale serve and consults the caller's identity for nothing, so the
// refusal is erased -- any tailnet member that reaches srv1:10000 may put objects and advance any
// partition head, which grants and releases capacity seats and quota.
//
// It is not restored in the same change because the principal a fleet writer PRESENTS through
// tailscale serve is not yet observed: the Tailscale-User-Login header is set for user-owned devices
// and absent for tagged ones, and which the fleet hosts are has not been read. A roster written
// before that reading would either refuse every real writer or admit every one -- a guess standing
// where an observation belongs. The reading is taken by gunbc.fabric_writer_identity_observe (the
// served door's `identity` operation, one dispatch per fleet host).
//
// TWO WRITER REALIZATIONS, ONE OF WHICH THE SERVED DOOR NEVER SEES. A writer on any host but the
// placed one reaches the store through fabric_storage_serve_handle (FabricStorageServed); a writer
// ON the placed host (srv1: the dashboard's roadmap serve, the D0 door when it runs on the broker
// host) is FabricStorageLocalFiles and runs the file store in process -- no request, no proxy, no
// header. A roster at the served door restores outsider exclusion over the SERVED population only.
// The placed host's local writers are the same drop's second population and need their own wall
// (principal admission at the local-file binding, or every executor's writes routed through the
// served door); the trigger below names both, and neither half retires the row alone.
//
// THE PRINCIPAL THE SERVED DOOR CAN ROSTER IS A TAILNET USER, NOT A NODE. Tailscale-User-Login is
// the authenticated user behind the request (extdeps.tailscale.identity); two devices owned by one
// user present one login, and a tagged device presents none. So the served roster admits "a
// rostered user identity may write" -- the trust boundary this row's restoration adopts, stated so
// it is chosen -- and an absent login is a deficit the reading establishes (that host needs another
// principal), never an admitted principal. An exact node or tag boundary would need a node-aware
// identity producer, which this row does not name.
//
// WIDENED BY THE CUT D D0 TRANSACTION (gunbc#11555): the pair-serving authority partitions, the
// host-placement partition and the D0 operator-consent claim slot are written through the same
// unrefused door, so a tailnet member could move a group's authority or take the consent slot
// without passing gunbc.spark.pair_serving_d0's authorization. STATED PLAINLY, THE LOSS IS WIDER
// THAN THIS ROW'S SUBJECT: the trigger below restores OUTSIDER exclusion only -- the served door
// exports generic put/advance and carries no partition, action, D0 subject, grant or attempt to
// the store, so once the roster lands every rostered fleet writer is trusted to mutate every head,
// including the D0 facts, and per-operation D0 authorization at the store is a wall this row does
// not declare restored. Until the operator rules on that trust boundary (gunbc#11555 escalation)
// the wet D0 door consumes THIS ROW'S STANDING and refuses while it stands
// (gunbc.spark.pair_serving_d0 d0_store_write_wall_standing), and refuses again while the
// per-operation wall this row does not cover is missing (gunbc.spark.pair_serving_d0
// d0_store_operation_wall, a missing construction rather than a drop: it never existed under git
// either) -- so retiring this row alone does not open D0, and Cut 0 with the escalation ->
// authorization producer cannot make D0 executable before both walls stand, by construction.
data fabric_storage_append_principal_unrefused: RungDrop = RungDrop {
  identity: "fabric_storage_append_principal_unrefused" as NonEmptyStr,

  subject: "an append to the fabric event log by a principal that is not a fleet writer",

  declared: "2026-09-19",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "gunbc.fabric_storage_serve fabric_storage_serve_handle, reached only through tailscale serve on srv1 (tailnet membership is the only boundary)" },
    population: [
      "SERVED WRITERS (FabricStorageServed, every executor but the placed host): gunbc.fabric_storage_serve fabric_storage_serve_handle",
      "LOCAL WRITERS (FabricStorageLocalFiles, the placed host srv1): gunbc.fabric_storage_file_store fabric_storage_file_put / fabric_storage_file_advance, reached in process by gunbc.fabric_storage_client fabric_storage_binding_for",
      "gunbc.fabric_event_log event_log_append",
      "gunbc.fabric_event_log event_log_append_with",
      "gunbc.fabric_event_log fabric_seat_acquire",
      "gunbc.spark.pair_serving_authority_log (every writer to a pair-serving-authority partition and to host-placement: establishment, transition, entry state, cancellation, host-effect claim and release, placement prepare / claim / finalize / abort)",
      "gunbc.durable_cas_fabric_storage fabric_storage_compare_and_set (the D0 operator-consent claim slot)",
    ],
    restoration_trigger: "BOTH of: (served writers) a modeled roster of fabric writer USER principals, grounded in the observed reading gunbc.fabric_writer_identity_observe takes of the Tailscale-User-Login each fleet writer presents through tailscale serve on srv1 -- SUFFICIENT FOR fabric_storage_serve_handle to refuse a put or advance from any login outside the roster, including an absent login, with a discriminating RED over the real handler; AND (local writers) principal admission on the placed host's own write path -- at the FabricStorageLocalFiles binding or by routing the placed host's writes through the served door -- SUFFICIENT FOR a put or advance by an unrostered local principal to refuse, with a discriminating RED over the real file store. A roster at the served door alone retires nothing: the placed host's writes never reach it.",
  }
}
