module gunbc.rung_drop.keyed_apply_patch_rebuilds_rows_per_hunk

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// A KNOWN COPIED ACCUMULATOR LEFT IN PLACE, DECLARED RATHER THAN SILENT (DESIGN section 6, bare minimum
// cost: a proven cost-shape defect is always fixed; this row is the bounded runway until it is).
// std.change keyed_apply_patch folds the patch's hunks over the row list and, per hunk, rebuilds the
// whole accumulator with filter(acc, ..) and appends with concat -- O(rows) work per hunk, O(rows x
// hunks) per apply. It was exposed by the restored accumulator-copy lens in gunbc#13337, where the two
// clean copies in the same module were fixed. This one is not fixed there because its result order is
// a contract: an Added or Modified hunk moves its row to the END, and a later hunk for the same key
// supersedes an earlier one, so a one-pass rewrite (index the hunks by key, filter once, append in hunk
// order) is a semantic redesign that needs its own witnesses rather than a mechanical rewrite.
data keyed_apply_patch_rebuilds_rows_per_hunk: RungDrop = RungDrop {
  identity: "keyed_apply_patch_rebuilds_rows_per_hunk" as NonEmptyStr,

  subject: "std.change keyed_apply_patch: a fold over patch hunks that copies its row accumulator (filter + concat) on every hunk",

  declared: "2026-10-05",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: DeletedWithoutReplacement,
    population: [
      "std.change keyed_apply_patch filter (KeyedDiffAddedHunk arm)",
      "std.change keyed_apply_patch filter (KeyedDiffRemovedHunk arm)",
      "std.change keyed_apply_patch filter (KeyedDiffModifiedHunk arm)",
    ],
    restoration_trigger: "std.change keyed_apply_patch applies a patch with work linear in rows plus hunks -- no fold step rebuilds or re-appends the accumulated row list -- while preserving its contract that an applied Added or Modified row lands after the untouched rows in hunk order and a later hunk for a key supersedes an earlier one, established by a witness over a multi-hunk patch with a repeated key and by dag/test/claim/keyed_delta_fold_witness_test passing unchanged"
  }
}
