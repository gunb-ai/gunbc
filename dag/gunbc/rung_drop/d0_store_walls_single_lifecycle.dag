module gunbc.rung_drop.d0_store_walls_single_lifecycle

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-09-30 (operator-ruled, option A) to admit one D0 lifecycle past the unfinished store
// walls. D0 and Group A were deleted (operator, 2026-10-07), so that lifecycle is gone; what remains
// below the rung is the store-operation subject the population names: a protected advance whose
// operation has no modeled approval flow is refused by operation_requirement, but the wall chain that
// gives Recover, Finalize, Abort and EstablishAuthority their flows is unfinished. Stood, not
// retired: the trigger has not fired.
data d0_store_walls_single_lifecycle: RungDrop = RungDrop {
  identity: "d0_store_walls_single_lifecycle" as NonEmptyStr,

  subject: "a protected fabric store advance whose operation has no modeled approval flow, admitted while the store does not refuse a writer lacking authorization for that operation",

  declared: "2026-09-30",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged { replacement: "the fabric store door verifies each protected advance's credential per operation (gunbc.fabric.fabric_store_operation_admission), and the served/local writer roster is live on srv1" },
    population: [
      "the live store-operation subject: the protected-head advances gunbc.fabric.fabric_store_operation_admission operation_requirement judges (gunbc.spark.pair_serving_authority_log partition, host-placement partition, consent slots) for the StoreOperation arms EstablishAuthority, Recover, Finalize and Abort, which today admit no scope and so refuse as NoApprovalFlowForOperation",
      "not the D0 lifecycle this row was first declared over: Group A was decommissioned (operator, 2026-10-07, dashboard messages msg_5d88338f and msg_9e5a2fee), gunbc.spark.pair_serving_d0 and its door were deleted, and no D0 lifecycle can be admitted",
    ],
    restoration_trigger: "THE CAPABILITY: the store-operation wall refuses every lifecycle operation that has no modeled approval flow, on the live path, and admits each operation that has one only under its verified approval, SUFFICIENT FOR a rostered fleet writer without authorization for the operation to be refused at the store on srv1. The served/local writer roster half is gunbc.rung_drop.fabric_storage_append_principal_unrefused, retired and effective on srv1.",
  },
}
