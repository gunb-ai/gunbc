module gunbc.rung_drop.gcp_iam_bootstrap_trust_pool_untaggable

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, DeletedWithoutReplacement, Enumerated }
import gunbc.guarantee_rung { StructurallyGuaranteed, MechanicallyPreventable }

// THE TWO TRUST POOLS ARE A STANDING RESIDUAL (DESIGN 4b(3)). Their principal sets reach the trust-root
// accounts, and iam-bootstrap's role holds workloadIdentityPools.setIamPolicy project-wide. Denial
// conditions recognize only resource tags (https://cloud.google.com/iam/docs/deny-overview, read
// 2026-10-18) and workload identity pools are not on the tag-supported list
// (https://cloud.google.com/resource-manager/docs/tags/tags-supported-services, read 2026-10-18), so no
// credential-layer wall can name them; the route's refusal (gunbc.auth.gcp_iam_bootstrap_delta_route
// iam_bootstrap_cell_owner) is the whole guard. Its trigger is a platform capability this repository cannot
// supply, which is why it is not folded into the account drop.
data gcp_iam_bootstrap_trust_pool_untaggable: RungDrop = RungDrop {
  identity: "gcp_iam_bootstrap_trust_pool_untaggable" as NonEmptyStr,
  subject: "iam-bootstrap writing the policy of a trust pool (the converge job's or its own)",
  declared: "2026-10-18",
  standing: Standing { declaration: TypedDeclaration {
    previous: StructurallyGuaranteed,
    temporary: MechanicallyPreventable,
    reason: DeletedWithoutReplacement,
    population: Enumerated { members: FreeSemigroup { head: "pool github-gcp-iam-converge", tail: ["pool github-gcp-iam-bootstrap"] } },
    restoration_trigger: "workload identity pools accept resource tags (a cited GCP tag-support row) so the trust-root deny can name them, or iam-bootstrap's role no longer holds workloadIdentityPools.setIamPolicy; observed by a denied probe on each pool"
  } }
}
