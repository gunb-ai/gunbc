  identity: "witness_deferral_freeze_forward_rule" as NonEmptyStr,

  subject: "gunbc.witness_deferral_freeze forward admission rule",

  declared: "2026-08-28",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: OutsideTheLadder,
    reason: LostAsPassenger { carrier: "the per-PR discovery-corpus batch and the wet/falsifier cadences, deleted by the floor cut of 2026-08-15 (611fd02770, #8283)" },
    population: [
    "gunbc.witness_deferral_freeze witness_deferral_freeze_authority_note",
    "gunbc.explicit_witness_admission explicit_witness_admission_cadence_executes",
    "v2.workflow.witness_admission witness_path_policy_execution_standing_in",
    "v1_compiler.cli_run refuse_unexecuted_deferred_witnesses",
