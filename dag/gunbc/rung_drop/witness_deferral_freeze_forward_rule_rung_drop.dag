module gunbc.rung_drop.witness_deferral_freeze_forward_rule_rung_drop

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, LostAsPassenger }
import gunbc.guarantee_rung { OutsideTheLadder, MechanicallyPreventable }

// DECLARED 2026-08-28 IN gunbc.witness.witness_deferral_freeze AND ROSTERED NOWHERE UNTIL NOW.

data witness_deferral_freeze_forward_rule_rung_drop: RungDrop = RungDrop {
  identity: "witness_deferral_freeze_forward_rule" as NonEmptyStr,

  subject: "gunbc.witness_deferral_freeze forward admission rule",

  declared: "2026-08-28",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: OutsideTheLadder,
    reason: LostAsPassenger { carrier: "the per-PR discovery-corpus batch and the wet/falsifier cadences, deleted by the floor cut of 2026-08-15 (611fd02770, #8283)" },
    population: [
    "gunbc.witness_deferral_freeze witness_deferral_freeze_authority_note",
    "gunbc.explicit_witness_admission explicit_witness_admission_cadence_executes",
    "v2.workflow.witness_admission witness_path_policy_execution_standing_in"
    ],
    restoration_trigger: "BOTH halves, and the row retires only when both are satisfied: (a) a cadence that actually executes offline-homed witnesses exists, so a green witness under such a path has a truthful admission row to write; AND (b) the required floor REFUSES, located (naming the witness identity and its path), any witness that its own long_home site projection does not execute, on the real required route (claim_executor --required-ci), with a discriminating red control that a relocated, unexecuted witness reds and a positive control that an executed one does not. That is SUFFICIENT FOR the rule this row drops: a witness moved to a path no cadence executes can no longer stay green by never running. (b) was previously written as an artifact, a required run entering the discovery-corpus path so that refuse_unexecuted_deferred_witnesses could fire, but no required run ever entered that path, and both it and the refusal were deleted (calm-boar-904 ruling, 2026-10-04); the rewrite names the capability that artifact stood for, and is no easier to satisfy. Half (a) is gunbc.rung_drop.shared_capability missing_cadence_category. Waiters whose remaining unsatisfied condition is only that capability retire together. Half (b) is not that capability. When (a) fires and (b) is still unsatisfied, this identity is removed from missing_cadence_category.waiter_identities in the SAME change as those retirements (delist, not SplitRetirement) and this row stays Standing until (b) fires. If (b) is already satisfied when (a) fires, retire with the enrolled set. (b) firing first does not delist: the row stays enrolled until (a)."
  }
}
