module gunbc.rung_drop.ambient_name_census_carried_refusals

import std.types { NonEmptyStr, List }
import gunbc.rung_drop { population_from_list, RungDrop, Standing, TypedDeclaration, DerivedBy, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import gunbc.instrument_targets { ambient_name_census_label }

// Declared 2026-10-23 on the manager ruling for PR 14868 (review 85142): the ambient-name census refuses a rewritten
// module only when it is NEWLY refused against the merge base. A module refused at the base too exits 0, so a held
// run does not say the wave's edits to that module were judged; it says no module was newly refused. Conditions of
// the ruling: the carried set is re-derived at each run by an identity join (never a copied count), shrinks only,
// is printed on every run (carried_refused rows, carried_refused_count, and the summary line), and the label states
// it is a ratchet, so one name does not silently mean two contracts.
data ambient_name_census_carried_refusals: RungDrop = RungDrop {
  identity: "ambient_name_census_carried_refusals" as NonEmptyStr,
  subject: "Ambient-name census judgement of rewritten modules that the merge base also refused at resolve",
  declared: "2026-10-23",
  standing: Standing { declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "the census exiting 2 for every unjudged rewritten module, which stays red until every base refusal clears and so blocks every wave on debt it did not create; the carried set is printed instead"
    },
    population: DerivedBy { label: ambient_name_census_label() },
    restoration_trigger: "THE CAPABILITY: the native compiler resolves every rewritten module the census reaches, so the census judges the occurrences of each rewritten module at occurrence grain and a carried (refused at base and head) module can no longer exist. Member by member: each carried_refused row the census prints is resolved by the native compiler or its module is deleted; the drop retires when the carried_refused_count is zero on the default branch."
  } }
}

// THE CLOSED IDENTITY LIST of modules this change adds that import gunbc.rung_drop, a declarer the base already refuses at
// resolve. A module absent at the base has no base import edge to compare, so the census would call it newly refused; these
// are admitted as cascades by identity and by nothing wider: any other new module on a carried declarer is newly refused,
// and an existing module that GAINS an edge still fails (none of these names was observed at the merge base). The row that
// carries this list is gunbc.rung_drop.ambient_name_census_new_modules_on_carried_declarer, its own file under main's
// derived-roster rule (c2e0eca8694d).
//
// THE APPROVALS, outside the diff as DESIGN.md §5 requires, both of them:
//   (1) operator approval 2026-10-26, dashboard escalation msg_3bd137d1-94e0-4153-9254-1c1ce6465b24, recorded at
//       https://github.com/gunb-ai/gunbc/pull/14868#issuecomment-6410170804 -- scope: exactly this PR's 2 new modules
//       (the two the census compares), with trigger gunbc.rung_drop resolving natively; and
//   (2) operator approval 2026-10-26, dashboard escalation msg_976728c8 (widen to 3, default-approved on the
//       recommendation) -- scope: the third name only, the row's own file, which became a module importing the carried
//       declarer solely because main's derived-roster rule (c2e0eca8694d) mandates one row per file.
// The population list below and that row's restoration_trigger carry exactly that scope and nothing beyond it.
data ambient_census_listed_new_modules: List<String> = [
  "gunbc.rung_drop.ambient_name_census_carried_refusals",
  "v2.test.claim.ambient_name_census_standing_witness",
  "gunbc.rung_drop.ambient_name_census_new_modules_on_carried_declarer"
]
