module gunbc.rung_drop.census_image_rendered_program_wet_row_withdrawn

import std.types { NonEmptyStr }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, LostAsPassenger }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// THE DECLARED RUNG DROP for the census-image rendered program's only executing check
// (DESIGN 4b(3) no silent regression; review 69872 on gunbc#11993).
//
// WHAT THE CHECK IS. test.claim.mtcollins1_census_image_local_wet.the_rendered_program_runs_and_its_
// output_parses_by_real_execution renders the census workload and runs it under a real shell on the
// runner, then parses its output back -- the one claim that establishes the rendered program is a
// program and not a string. It is enrolled as a triple: the floor_route_gap chunk_20 expectation,
// the WetScheduledClaim row in local_repo_wet_terminal local_repo_wet_schedule, and the
// ci_layer_roots witness_exclusion_frontier row.
//
// WHAT HAPPENED TO IT. On the runners it observes FAILED on every main merge-queue run since #11731
// landed it: the rendered program's `test -f .../gunbc-mtcollins1-census-...iso` finds no ISO in
// the ephemeral temp root. The fail-open floor reported green over that. The local-repo wet lane
// realizes only ExpectedToHold, so under the sealed floor the schedule row is withdrawn rather than
// scheduled to disagree with its terminal -- and withdrawing it is withdrawing the last execution of
// the route, which is this row's subject. The chunk_20 expectation and the exclusion-frontier row
// stay, so the identity remains a held route gap rather than an unenrolled one.

data census_image_rendered_program_wet_row_withdrawn: RungDrop = RungDrop {
  identity: "census_image_rendered_program_wet_row_withdrawn" as NonEmptyStr,

  subject: "the census-image rendered workload program running under a real shell and its output parsing back (test.claim.mtcollins1_census_image_local_wet.the_rendered_program_runs_and_its_output_parses_by_real_execution), the only executing check that the rendered program is a program",

  declared: "2026-09-22",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: LostAsPassenger { carrier: "the local-repo wet schedule row for the claim, withdrawn because the lane realizes only ExpectedToHold and the claim observes failed on every main merge-queue run since #11731 (no ISO fixture in the runner's temp root)" },
    population: [
      "the rendered census workload program: nothing executes it between its renderer and the census host until this row is retired",
    ],
    restoration_trigger: "the census-image lane supplies the rendered program its ISO fixture on the runner (or the claim supplies one and keeps a single inhabitance claim on the real image), the schedule row returns as ExpectedToHold, and the lane observes it passed at an exact head",
  }
}
