module gunbc.rung_drop.rust_unit_tests_over_their_cap

import std.types { List, NonEmptyStr, String }
import gunbc.rung_drop { RungDrop, Superseded, TypedDeclaration, ReplacementStaged }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }

// DECLARED 2026-10-05, operator-approved (escalation msg_e83c070f, option A: the owner raises the
// cap or splits the run; the lane is non-blocking until it fits). gunbc#12951 made the fleet
// `rust-unit-tests` job a required need of the witnesses aggregate with a 40-minute step cap
// (gunbc.compiler_gate_workflow compiler_gate_unit_test_timeout). The step overran that cap on every
// head, #12951's own included, cut off inside required_floor_runner changed_witness_projection_tests
// with no test failed -- so the lane's red carried no information about the diff and refused every
// merge. While this row stood (2026-10-05 to 2026-10-06) the lane row was LaneAnnouncedNotBlocking:
// the job ran on every pull request and merge_group and reported, and the aggregate did not need it.
//
// THE TRIGGER IS THE CAPABILITY, NOT THE CAP. Raising the literal does not retire this row; a cap
// raised past a wall nobody measured is the same red waiting for a slower head. What retires it is
// the suite completing under its cap on the fleet, every head, read from the lane's own runs.

// SUPERSEDED, NOT RETIRED BY ITS TRIGGER (2026-10-06), and carried in the Superseded arm of
// RungDropStanding so no consumer reads it as a fired trigger. The trigger refuses
// shrinking the suite by deleting tests, and gunbc#13452 did exactly that, so the trigger has NOT
// fired and this row does not claim it did. What ended it is the owner ruling #13452 carries
// (2026-10-06: every v1 unit test is under 100ms, the v1 Rust tests are being wound down, and
// integration tests in the lane are deleted rather than rewritten), taken as superseding this row
// by escalation msg_a8b84443 -- approved BY DEFAULT (2026-10-06T13:50Z, no operator answer), not by
// an explicit operator answer. That ruling took the deleted population out of this row's
// subject; its loss is held by gunbc.rung_drop v1_integration_tests_deleted_from_the_unit_lane and
// nowhere else. Over the population that remains, the lane blocks again with a cap re-derived from
// the post-#13452 walls (gunbc.compiler_gate_workflow compiler_gate_unit_test_timeout).
data rust_unit_tests_over_their_cap_population: List<String> = [
  "the fleet rust-unit-tests job of gunbc.compiler_gate_workflow: cargo test --release -p v1-compiler --lib (gunbc.repo_self_test_command), every #[test] it reaches -- its verdict no longer reaches the witnesses aggregate",
]

data rust_unit_tests_over_their_cap: RungDrop = RungDrop {
  identity: "rust_unit_tests_over_their_cap" as NonEmptyStr,
  subject: "the v1 --lib unit-test lane blocks a merge: a failing v1-compiler unit test turns the required witnesses context red",
  declared: "2026-10-05",
  standing: Superseded {
    ruling: "the owner ruling of 2026-10-06 carried by gunbc#13452: v1 tests over 100ms are deleted, not rewritten. It removed the deleted population from this subject; the trigger did NOT fire (it refuses deletion as a route). Over the remaining population the lane blocks again (LaneBlocks, gunbc#13474) with a 15-minute step cap derived from the post-#13452 maximum wall, witnesses run 37459768899 at 457s; re-derive by instrument (gh run list --workflow witnesses.yml for runs after 2026-10-06T01:02Z, then each run rust-unit-tests step times)." as NonEmptyStr,
    decision_record: "escalation msg_a8b84443 (2026-10-06), APPROVED BY DEFAULT at 13:50Z after no operator answer -- a default approval, not an explicit operator answer" as NonEmptyStr,
    loss_holder: "v1_integration_tests_deleted_from_the_unit_lane" as NonEmptyStr
  },
  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: ReplacementStaged {
      replacement: "a measured, budgeted step cap for the v1 --lib suite, or a split of the run into parts that each fit their cap, on the fleet runner"
    },
    population: rust_unit_tests_over_their_cap_population,
    restoration_trigger: "THE CAPABILITY: the full v1-compiler --lib unit suite completes under its cap on the fleet runner on every head -- read from the rust_unit_tests step walls of the lane's own required runs, across heads, not one green run. WHAT THAT MUST BE SUFFICIENT FOR: the lane's red means a test failed, never that a clock ran out, so flipping the gunbc.compiler_gate_workflow lane row back to LaneBlocks refuses only diffs that broke a test. Raising the cap literal without that measurement does not retire this row, and neither does shrinking the suite by deleting or skipping tests."
  }
}
