module gunbc.rung_drop.emission_real_consumer_profiles_function_level_self_time_attribution

import std.types { NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.rung_drop { RungDrop, Standing, TypedDeclaration, Enumerated, ReplacementStaged }
import gunbc.guarantee_rung { OutsideTheLadder }

// ROSTERED, not local prose: function-level self-time attribution is dropped from the requirement set of
// roadmap row emission-real-consumer-profiles because the measurement host refuses the capability it needs.
// The standing host constraint is a typed row, not header prose: gunbc.design_ruling::srv1_perf_event_paranoid_stays_at_four_2026_11_26
// (decided 2026-11-26) records that perf_event_paranoid stays at 4 on srv1, so this trigger is not fireable by
// anyone on this lane and nothing on this host is changed to fire it. Ordered by warm-fox-517 under
// neat-badger-614's option (a) ruling; the form copies the newest typed drop at main,
// dag/gunbc/rung_drop/rest_body_undecodable_third_splice_form.dag.
data emission_real_consumer_profiles_function_level_self_time_attribution: RungDrop = RungDrop {
  identity: "emission_real_consumer_profiles_function_level_self_time_attribution" as NonEmptyStr,

  subject: "function-level self-time attribution of the emitted hot paths named by roadmap row emission-real-consumer-profiles -- self time in a named function, unresolved samples kept unresolved, and hot-spot attribution to the callee collection and allocation work of a contract -- is dropped from that row's requirement set, because the measurement host does not permit sampling: kernel.perf_event_paranoid reads 4, perf_event_open access is limited to holders of CAP_PERFMON, CAP_SYS_PTRACE or CAP_SYS_ADMIN, and perf yields no events at all there (measured 2026-11-26T14:54:05Z on srv1, ~/scratch/bold-cat-668/logs/perf_paranoid_capability_measurement.20261126T145405Z.log). A requirement that can only be met by a capability the host refuses enrols a missing permission as an asset and goes red the day the refusal is honestly reported, so it is dropped and rostered rather than left as prose (leg-lifecycle rule, warm-fox-517 order 2026-11-26 under neat-badger-614's option (a) ruling; the standing constraint is recorded as a typed row at gunbc.design_ruling::srv1_perf_event_paranoid_stays_at_four_2026_11_26, so no sysctl or package change is attempted by anyone on this lane)",

  declared: "2026-11-26",

  standing: Standing { declaration: TypedDeclaration {
    previous: OutsideTheLadder,
    temporary: OutsideTheLadder,
    reason: ReplacementStaged { replacement: "two whole-process routes that the host does permit, both executed on srv1 at 2026-11-26T14:54:05Z and both returning: /usr/bin/time -v prints Elapsed (wall clock) time and Maximum resident set size (rc 0), and strace -c prints the syscall accounting table (rc 0). What is absent is not substituted -- valgrind, ltrace and gdb are absent on the measurement host (command -v rc 1 for each), so no instruction-count or call-graph replacement is claimed, and perf, though installed at /usr/bin/perf, produces no counts (perf stat -e cycles true rc 1, the refusal naming perf_event_paranoid setting is 4 and the >= 2 Disallow kernel profiling rule). The attribution duty is not lost silently: the per-claim evaluator-step reading a claim can take in-language survives in gunbc.floor_cost_distribution_instrument::specimen_row_grounding, which reads observed_eval_steps on the matched claim row's cost and takes its Present value arm, over the artifact named by data floor_cost_artifact_file in that same module; the off-disk download recipe for that artifact is carried in the comments introducing data floor_cost_ceiling and data floor_cost_envelope_sampled_runs of the same module, and the file positions of those two comments are carried here only because a comment has no symbol to name -- everything else is cited by symbol, per gunbc.design_argument::single_authority -- per-claim evaluator steps, which is not per-function self time and is not offered as its equivalent" },
    population: Enumerated { members: FreeSemigroup { head: "measured instance 1: the verdict-only parse-population consumer of roadmap row emission-real-consumer-profiles (the parse-population verb over the live roots, the 5 largest dag modules) cannot be attributed per function on the measurement host -- measured 2026-11-26T14:54:05Z on srv1, perf_event_paranoid prints 4 with rc 0 and perf stat -e cycles true exits 1 with the access-limited refusal, while the substitute that does execute is /usr/bin/time -v reporting Elapsed (wall clock) time and Maximum resident set size with rc 0; log ~/scratch/bold-cat-668/logs/perf_paranoid_capability_measurement.20261126T145405Z.log. previous rung: none to lower, the self-time leg has never executed green on this host", tail: ["measured instance 2: the full-artifact parsing benchmark consumer (the 165-module sample, parsed as a separate benchmark so a verdict-only speedup cannot hide unchanged map construction) is under the same refusal -- same host, same boot, same measurement -- and its permitted route is strace -c, which executed rc 0 and printed the syscall table (27 calls, 1 error, 0.000080 s total, top line mprotect 53.75 percent) in the same log ~/scratch/bold-cat-668/logs/perf_paranoid_capability_measurement.20261126T145405Z.log. No unresolved-sample figure is recorded for either consumer, and no per-byte scaling warning is drawn from either, because a sample count cannot be taken where sampling is refused"] } },
    restoration_trigger: "SAMPLING PERMITTED ON THE MEASUREMENT HOST: /proc/sys/kernel/perf_event_paranoid reads below 2 on srv1 and a perf stat -e cycles run over one of the named emitted artifacts returns counts instead of the access-limited refusal, both executed and logged. When that leg executes green, the self-time requirements (self time in a named function, unresolved-sample accounting, and hot-spot attribution to callee collection and allocation work) are re-enrolled on roadmap row emission-real-consumer-profiles and this drop retires by its own trigger. SUFFICIENT FOR re-enrolment without a further planning change. Closes by re-measurement, not by opinion. Until it fires, the absence of self-time data is this drop's record and not the row's failure, and the row is judged on the whole-process pair plus the in-language cost reading named in the replacement"
  } }
}
