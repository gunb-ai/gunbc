data accumulator_copy_priced_out_file_gate_ratchets: RungDrop = RungDrop {
  identity: "accumulator_copy_priced_out_file_gate_ratchets" as NonEmptyStr,

  subject: "interpreted file_gate ratchets over lean.dag, bash.dag, swift.dag, 00_compile.dag, analyze.dag, and glob_discovery_law.dag from v2.test.claim.complexity.accumulator_copy_roster_gate_*",

  declared: "2026-10-06",

  standing: Standing,

  declaration: TypedDeclaration {
    previous: MechanicallyPreventable,
    temporary: Mitigatable,
    reason: LostAsPassenger { carrier: "interpreted file_gate as 300s census test fns over those live files; family remains operator-ruled offline (gunbc.offline_local_recipe policy accumulator_copy_roster_gate_exclusion_note)" },
    population: [
      "v2.test.claim.complexity.accumulator_copy_roster_gate_lean_bash roster_lean_file_gate_walk",
      "v2.test.claim.complexity.accumulator_copy_roster_gate_lean_bash roster_bash_file_gate_walk",
      "v2.test.claim.complexity.accumulator_copy_roster_gate_swift roster_swift_file_gate_walk",
      "v2.test.claim.complexity.accumulator_copy_roster_gate roster_compile_stage_zero_suspects_within_ratchet",
