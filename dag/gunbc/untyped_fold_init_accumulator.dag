module gunbc.untyped_fold_init_accumulator


// A FOLD'S INITIAL ACCUMULATOR IS EMITTED WITH ITS TYPE PARAMETERS OPEN, AND NOTHING DOWNSTREAM
// CLOSES THEM.
//
// `empty_map()` as a fold's `empty:` argument emits as `v1_rt::rc_empty_map::<_, _>()`. The key and
// value types are left to inference, and the only thing that could constrain them is the fold's own
// closure -- which receives the accumulator as a parameter, so the target compiler is asked to infer
// the parameter's type from a body that uses it. It refuses:
//
//     error[E0282]: type annotations needed
//      --> src/v2_std_compilers_target_model.rs:2730:94
//          ..._map::<_, _>(), |acc, row| v1_rt::rc_map_insert(acc.clone(), row.effect_kind.clone(), ...
//                              ^^^                            --- type must be known at this point
//     help: consider giving this closure parameter an explicit type
//          |acc: /* Type */, row|
//
// WHAT RULES OUT THE NEIGHBOURING EXPLANATIONS, because this site was first filed under one of them.
// The collection is `shape.callees: List<TargetEffectCalleeRow>`, a genuine list of records -- so
// this is NOT the String declaration-site alias that explains its two former partition-mates, where
// the collection realizes as the host String and the ELEMENT is what cannot be typed. rustc never
// asks about `row` here. It asks about `acc`, and `acc` traces to the fold's init, not to the
// collection and not to the callee's spelling.
//
// THE DISCRIMINATOR IS FREE AND IT IS THE SAME ONE THE SIBLING ROW USES: rustc's help names WHICH
// PARAMETER it wants annotated. `|acc: /* Type */, row|` is this class. `|acc, ch: /* Type */|` is
// the collection-realization class. Same error code, same closure shape, two mechanisms, told apart
// by which half of the closure the compiler points at.

type UntypedFoldInitSite {
  caller: DeclarationRef
  init_expression: String
  emitted_init: String
  emitted_file: String
  emitted_line: Int
  rustc_help_annotates: String
}

data untyped_fold_init_sites: List<UntypedFoldInitSite> = [
  {
    caller: decl_ref(module_path: "v2.std.compilers.target_model", decl_name: "target_value_expr_effect_apply_callee"),
    init_expression: "empty_map()",
    emitted_init: "v1_rt::rc_empty_map::<_, _>()",
    emitted_file: "v2_std_compilers_target_model.rs",
    emitted_line: 2730,
    rustc_help_annotates: "acc (the accumulator)",
  },
]

// THE POPULATION IS NOW SWEPT, AND THE SWEEP CONFIRMED THE ONE SITE RATHER THAN ADDING TO IT.
//
// The prior revision of this block said the count was what had been OBSERVED and named the sweep as
// the obvious next step. The sweep has been run. It did not change the member list, and that is a
// measured result rather than a restatement of the old one: the same list now rests on a frame that
// could have contained more members and did not, instead of on one probe that could not have found
// any.
//
// WHAT MAKES A SITE A MEMBER, mechanically, so this is re-runnable rather than a judgement. rustc's
// own help names WHICH closure parameter it wants annotated, and the enclosing call names who owns
// that closure. The pair is the partition key. `fold_list` + FIRST parameter is this class, because
// only a fold's first closure parameter is an accumulator. `fold_list` + SECOND parameter is the
// collection-realization element class -- a different mechanism with a typed initializer. `contains`
// and `is_prefix_of` take the element FIRST, so their first-parameter caret is an element caret and
// not this class; reading position without reading the callee would have mis-assigned all eleven of
// them. The classifier that applies this key to raw cargo JSON is the sweep's producer, named below.
//
// WHY THE FRAME IS WIDER THAN THE DEFECT'S OWN SPELLING. The mechanism needs an initializer whose
// type parameters are open, so the frame is every fold in `dag/` and `src/v2` whose `empty:` argument
// is a parameterically-typed constructor -- `empty_map()`, `empty_set()`, `optional_absent()`,
// `freemonoid_empty()`, the `Empty` variant of `FreeMonoid`/`Stack`, or a bare list literal. That is
// 186 fold sites in 60 files, of which 12 are the `empty_map()` spelling this row was filed under.
// Sweeping only `empty_map()` would have measured the spelling instead of the mechanism.
//
// WHAT IS NOT A DEFECT, stated because the frame is deliberately over-wide: 185 of the 186 in-frame
// sites are legitimate polymorphism. The overwhelming majority sit in the tail position of a function
// with a declared concrete return type, so the expected type is known before the closure is checked
// and inference never runs out of facts. The one member is inline in a generic call's argument, where
// nothing supplies it.

type EmitterProvenance
  = EmitterOnSubjectAncestry { note: String }
  | EmitterOffMainAndNewerThanSubject {
      only_branch_containing_it: String
      subject_committed_utc: String
      emitter_committed_utc: String
      risk: String
    }

type ControlReach {
  positive_control: String
  negative_control: String
  what_the_controls_establish: String
}

type SweepInstrument {
  subject_ref: String
  emitter_build_ref: String
  emitter_provenance: EmitterProvenance
  controls: ControlReach
  oracle: String
  emit_command: String
  check_command: String
  classifier: String
}

type SweepFrame {
  frame_rule: String
  fold_sites_in_frame: Int
  files_in_frame: Int
  empty_map_sites_in_frame: Int
  entry_crates_checked: Int
  emitted_modules_type_checked: Int
  frame_files_reached: Int
  frame_files_unreached: Int
  fold_sites_in_unreached_files: Int
}

type SweepDiscriminator {
  rustc_code: String
  partition_key: String
  member_signature: String
}

type SweepExclusion {
  excluded_class: String
  sites: Int
  why_not_this_class: String
}

type SweepGapCause
  = EmitProcessKilled { note: String }
  | EmitRefusedByCompiler { diagnostic: String }

type SweepCoverageGap {
  entry: String
  cause: SweepGapCause
  fold_sites_unmeasured: Int
}

type CorpusSweep {
  instrument: SweepInstrument
  frame: SweepFrame
  discriminator: SweepDiscriminator
  e0282_sites_classified: Int
  members_found: Int
  exclusions: List<SweepExclusion>
  coverage_gaps: List<SweepCoverageGap>
}

type PopulationBasis
  = ObservedSitesOnly { found_via: String }
  | SweptCorpus { sweep: CorpusSweep }

data untyped_fold_init_population_basis: PopulationBasis = SweptCorpus {
  sweep: {
    instrument: {
      subject_ref: "de2ad927170c2cff04069bf9e3536f719913e446",
      emitter_build_ref: "009d4dab8e91713faba88cd0d5cf058304537122",
      emitter_provenance: EmitterOffMainAndNewerThanSubject {
        only_branch_containing_it: "origin/session/calm-lark-229",
        subject_committed_utc: "2026-08-21T18:39:19Z",
        emitter_committed_utc: "2026-08-21T18:54:27Z",
        risk: "the emitter commit is NEWER than the measured tree and is on no main ancestry, so the risk is NOT that a stale emitter missed sites a current one would produce -- it is that an off-main emitter may carry emission behaviour main does not. The population is the population THAT emitter produces.",
      },
      controls: {
        positive_control: "the instrument reproduced the already-known site exactly -- same file, same closure, same accumulator caret, one line off the position the surfacing row recorded",
        negative_control: "16 further E0282 sites in the same output that the partition key assigns to other classes, so the key is able to answer no",
        what_the_controls_establish: "MECHANISM-CONFIRMED, POPULATION CONDITIONAL ON THIS EMITTER. A control establishes that the instrument can detect the class; it cannot establish that the population is complete. Read the positive control as detection, never as completeness.",
      },
      oracle: "rustc, via cargo check over the crate the v2 emitter produced -- not a grep and not a reading of the .dag source",
      emit_command: "gunbc compile --source-root dag --source-root src/v2 --entry ENTRY --output-dir DIR --target rust",
      check_command: "cargo check --message-format=json --lib, run inside DIR",
      classifier: "sweep444/classify.py -- partitions every E0282 by (enclosing call, which closure parameter the help annotates)",
    },
    frame: {
      frame_rule: "every fold in dag/ and src/v2 whose empty: argument is a parameterically-typed constructor: empty_map, empty_set, optional_absent, freemonoid_empty, the Empty variant of FreeMonoid or Stack, or a bare list literal",
      fold_sites_in_frame: 186,
      files_in_frame: 60,
      empty_map_sites_in_frame: 12,
      entry_crates_checked: 34,
      emitted_modules_type_checked: 397,
      frame_files_reached: 56,
      frame_files_unreached: 4,
      fold_sites_in_unreached_files: 7,
    },
    discriminator: {
      rustc_code: "E0282",
      partition_key: "the pair (enclosing call that owns the closure, which closure parameter rustc's help annotates)",
      member_signature: "fold_list, first parameter -- the accumulator",
    },
    e0282_sites_classified: 17,
    members_found: 1,
    exclusions: [
      {
        excluded_class: "contains, element caret",
        sites: 10,
        why_not_this_class: "contains takes the element as its FIRST closure parameter, so a first-position caret there is an element caret; its initializer is not a fold init at all. This is the HELD contains class the surfacing row already names, and the sweep found five sites beyond the five that row lists.",
      },
      {
        excluded_class: "is_prefix_of, element caret",
        sites: 1,
        why_not_this_class: "v2.compiler.tokenize lex_match_prefix -- the String declaration-site alias, the sibling cause the surfacing row separates this one from.",
      },
      {
        excluded_class: "fold_list, element caret",
        sites: 2,
        why_not_this_class: "same callee, other parameter: the fold's initializer is already typed at both sites and the caret is on the element. This is the collection-realization class, and it is the exclusion that would have been missed by keying on the callee alone.",
      },
      {
        excluded_class: "not a closure",
        sites: 3,
        why_not_this_class: "E0282 raised on a derive over a generic enum in v2.lens.application -- same diagnostic code, no closure and no inference-through-a-lambda. Counting E0282 without the partition key would have counted these.",
      },
    ],
    coverage_gaps: [
      {
        entry: "src/v2/workflow/compile_door_ledger.dag",
        cause: EmitProcessKilled {
          note: "the emit was SIGKILLed at the compile.emit stage on this host, twice, once under parallel load and once alone -- a host memory limit, not a corpus fact. The entry is unmeasured, not clean.",
        },
        fold_sites_unmeasured: 3,
      },
      {
        entry: "src/v2/lens/enforcement/cost_coverage.dag",
        cause: EmitRefusedByCompiler { diagnostic: "unresolved type 'AsymptoticClass'" },
        fold_sites_unmeasured: 1,
      },
      {
        entry: "src/v2/test/claim/synthesis_gate/optimality_gap_completeness.dag",
