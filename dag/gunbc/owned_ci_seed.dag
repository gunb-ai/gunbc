}

fn owned_ci_seed_poll_missing_github_token_refusal() -> String {
  owned_ci_pr_poll_missing_github_token_cause() as String
}

fn owned_ci_seed_poll_empty_github_token_refusal() -> String {
  owned_ci_pr_poll_empty_github_token_cause() as String
}

fn owned_ci_seed_merge_target_branch() -> String {
  gunbc_default_branch_name
}
