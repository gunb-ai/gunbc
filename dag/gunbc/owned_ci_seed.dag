module gunbc.owned_ci_seed

import std.types { String, List, Int }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.repository { gunbc_repository }
import gunbc.owned_ci {
  owned_ci_check_name,
  owned_ci_state_root_rel,
  owned_ci_default_lease_seconds_count,
  owned_ci_pr_poll_missing_github_token_cause,
  owned_ci_pr_poll_empty_github_token_cause,
}
import gunbc.ci_execution_plan {
  ci_execution_default_stages,
  ci_execution_stage_wire,
  owned_ci_executor_stage_labels,
}
import gunbc.ci_spec { floor_plan_entry, floor_plan_function }

data owned_ci_control_plane_seed_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.owned_ci_seed",
    decl_name: "owned_ci_seed_repo_owner",
    field: WholeDeclaration
  }
}

data owned_ci_control_plane_seed_note: String = "§7 seed-retained projection for ci_control_plane (docs/plans/owned-ci-control-plane-design.md). The Rust bin MUST read repository identity, stage order, floor plan entry/function, state root, and lease duration ONLY through these rows — never parallel literals. dissolve-on: hand-Rust ureq for extdeps.github.checks CreateRun/UpdateRun and extdeps.github.pulls List folds into the interpreter REST bridge (effects_rest_transport_witness tracked-op class; add github.Checks to that roster when wiring lands). Until then this module is the single authority the seed consults."

fn owned_ci_seed_repo_owner() -> String {
  gunbc_repository.owner
}

fn owned_ci_seed_repo_name() -> String {
  gunbc_repository.name
}

fn owned_ci_seed_repo_full_name() -> String {
  gunbc_repository.full_name
}

fn owned_ci_seed_check_name() -> String {
  owned_ci_check_name as String
}

fn owned_ci_seed_state_root_rel() -> String {
  owned_ci_state_root_rel
}

fn owned_ci_seed_default_lease_seconds() -> Int {
  owned_ci_default_lease_seconds_count()
}

fn owned_ci_seed_floor_plan_entry() -> String {
  floor_plan_entry
}

fn owned_ci_seed_floor_plan_function() -> String {
  floor_plan_function
}

fn owned_ci_seed_stage_labels() -> List<String> {
  owned_ci_executor_stage_labels()
}

fn owned_ci_seed_poll_missing_github_token_refusal() -> String {
  owned_ci_pr_poll_missing_github_token_cause() as String
}

fn owned_ci_seed_poll_empty_github_token_refusal() -> String {
  owned_ci_pr_poll_empty_github_token_cause() as String
}
