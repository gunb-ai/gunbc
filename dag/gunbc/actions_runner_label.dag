module gunbc.actions_runner_label

import std.types { NonEmptyStr, String, Bool, List }
import extdeps.pricing.github_actions {
  GithubActionsBillingSku,
  ActionsLinux,
  ActionsLinuxArm,
  Linux4Core,
  Linux8Core,
  Linux16Core,
  ActionsRepositoryVisibility,
  PublicRepository,
  PrivateRepository,
  actions_billability,
  ActionsBillability,
  FreeInPublicRepository,
  ChargedAgainstPlanQuota,
  AlwaysChargedPerMinute,
  BillabilityUnread,
}

// WHAT A runs-on LABEL ESTABLISHES, AND WHAT IT DOES NOT. A workflow's runs-on is the only
// externally readable statement of where a job executes, so any census of CI spend starts here --
// but the label is authored by the repository, not issued by a provider, and that gap is the whole
// reason this module answers with a standing rather than a fact.
//
// THE DECISIVE LIMIT: A SELF-HOSTED RUNNER MAY CARRY ANY LABEL ITS OPERATOR CHOOSES, including one
// spelled exactly like a GitHub larger runner. So a label resembling ubuntu-latest-16-cores is a
// LEAD and never a witness that a billable hosted runner ran. Promotion from lead to observation
// needs a completed job's runner metadata, which the Actions jobs API reports and this module does
// not read. LabelSuggestsLargerHosted carries that distinction in its name so a consumer cannot
// quietly treat it as established.
//
// The classification rules below are rules about SPELLING. They were checked against a live
// population of 10,119 repositories and two billing probes on 2026-09-17, and the probes are what
// settled the ARM case: ubuntu-24.04-arm billed zero on a public repository beside a zero control,
// and a larger runner is charged even on public repositories, so ARM is standard.

type RunnerLabelClass
  = StandardHosted { sku: GithubActionsBillingSku }
  | LabelSuggestsLargerHosted { sku: GithubActionsBillingSku }
  | ThirdPartyProvider { provider: NonEmptyStr }
  | SelfHostedDeclared
  | LabelFromExpression
  | LabelUnrecognized { raw: String }

// The provider roster is the population this census was discovered from, and it is a ROSTER rather
// than a pattern because each name is a company: adding one is a row, and a label that matches none
// of them is Unrecognized rather than guessed at.
data third_party_runner_prefixes: List<NonEmptyStr> = [
  "blacksmith", "buildjet", "warp-ubuntu", "namespace-profile", "depot-ubuntu", "ubicloud", "cirrus", "actuated"
]

// A VENDOR'S LABELS AND ITS MACHINE NAMES ARE DIFFERENT VOCABULARIES, and one roster cannot serve
// both. The label a workflow author writes is "depot-ubuntu-24.04"; the runner name that vendor's
// machine reports is "depot-1mw2k81zm2". Matching a machine name against the label roster answers
// no for a machine that is plainly Depot's, which is how a paying provider customer gets filed as
// somebody's own hardware.
//
// The prefixes here are therefore SHORTER and their own fact. They are shorter for a reason worth
// stating rather than hiding: a bare vendor prefix is a weaker discriminator than a label, so a
// self-hosted fleet that happens to name its machines "blacksmith-01" would be read as the vendor.
// That is admitted as the cost of reading a convention nothing obliges a vendor to keep, and it is
// why the provenance fold treats an unmatched name as FleetRunnerObserved rather than asserting
// ownership it cannot establish.
data third_party_runner_machine_prefixes: List<NonEmptyStr> = [
  "blacksmith", "buildjet", "warp", "namespace", "depot", "ubicloud", "cirrus", "actuated"
]

fn label_is_expression(label: String) -> Bool {
  string_contains(s: label, pattern: "${{")
}

fn label_matches_provider(label: String, prefix: NonEmptyStr) -> Bool {
  starts_with(s: label, prefix: prefix as String)
}

fn third_party_match(label: String) -> NonEmptyStr? {
  match filter(third_party_runner_prefixes, p => label_matches_provider(label: label, prefix: p)) |> first {
    Absent => none
    Present { value: p } => Present { value: p }
  }
}

// GitHub spells larger runners with a core-count suffix. The suffix is the only signal available in
// a label, which is precisely why the resulting arm is SUGGESTS rather than IS.
fn larger_core_suffix(label: String) -> GithubActionsBillingSku? {
  if ends_with(s: label, suffix: "-4-cores") {
    Present { value: Linux4Core }
  } else {
    if ends_with(s: label, suffix: "-8-cores") {
      Present { value: Linux8Core }
    } else {
      if ends_with(s: label, suffix: "-16-cores") {
        Present { value: Linux16Core }
      } else {
        none
      }
    }
  }
}

fn label_is_hosted_arm(label: String) -> Bool {
  string_contains(s: label, pattern: "-arm")
}

fn label_is_hosted_linux(label: String) -> Bool {
  starts_with(s: label, prefix: "ubuntu-")
}

fn classify_runner_label(label: String) -> RunnerLabelClass {
  if label_is_expression(label: label) {
    LabelFromExpression
  } else {
    if label == "self-hosted" {
      SelfHostedDeclared
    } else {
      classify_non_self_hosted(label: label)
    }
  }
}

fn classify_non_self_hosted(label: String) -> RunnerLabelClass {
  match third_party_match(label: label) {
    Present { value: p } => ThirdPartyProvider { provider: p }
    Absent => classify_hosted_shaped(label: label)
  }
}

// ARM IS CHECKED BEFORE THE CORE SUFFIX and that order is load-bearing: ubuntu-24.04-arm has no
// core suffix, but a future ARM larger runner would have both, and reading the suffix first would
// classify it as x86 larger. The probe settled that hosted ARM is standard today; it did not
// promise GitHub will never ship a larger ARM SKU.
fn classify_hosted_shaped(label: String) -> RunnerLabelClass {
  if label_is_hosted_linux(label: label) {
    if label_is_hosted_arm(label: label) {
      StandardHosted { sku: ActionsLinuxArm }
    } else {
      match larger_core_suffix(label: label) {
        Present { value: sku } => LabelSuggestsLargerHosted { sku: sku }
        Absent => StandardHosted { sku: ActionsLinux }
      }
    }
  } else {
    LabelUnrecognized { raw: label }
  }
}

// THE BILLABILITY QUESTION, WHICH IS WHAT A PROSPECT CENSUS ACTUALLY WANTS. Every arm that is not
// an established hosted SKU answers NOT billable, and that direction is deliberate: for a model
// whose output is "who is paying", an unread label must not invent a payer. A third-party provider
// is certainly charged by SOMEONE, but not by GitHub and not at a rate this repository can read,
// so it is excluded here and carried as its own standing elsewhere.
type LabelBillability
  = LabelBillableByGithub { sku: GithubActionsBillingSku }
  | LabelFreeOnGithub
  | LabelBilledElsewhere { provider: NonEmptyStr }
  | LabelBillabilityUnestablished { reason: NonEmptyStr }

fn label_billability(
  label: String,
  visibility: ActionsRepositoryVisibility,
) -> LabelBillability {
  match classify_runner_label(label: label) {
    LabelFromExpression =>
      LabelBillabilityUnestablished {
        reason: "runs-on is an expression; the label is decided at run time and this census reads source" as NonEmptyStr
      }
    LabelUnrecognized { raw: r } =>
      LabelBillabilityUnestablished {
        reason: join(["unrecognized runner label: ", r], "") as NonEmptyStr
      }
    SelfHostedDeclared =>
      LabelBillabilityUnestablished {
        reason: "self-hosted: no GitHub runner-minute charge, and the operator's own cost is not readable here" as NonEmptyStr
      }
    ThirdPartyProvider { provider: p } => LabelBilledElsewhere { provider: p }
    LabelSuggestsLargerHosted { sku: sku } =>
      billability_of_sku(sku: sku, visibility: visibility)
    StandardHosted { sku: sku } =>
      billability_of_sku(sku: sku, visibility: visibility)
  }
}

fn billability_of_sku(
  sku: GithubActionsBillingSku,
  visibility: ActionsRepositoryVisibility,
) -> LabelBillability {
  match actions_billability(sku: sku, visibility: visibility) {
    AlwaysChargedPerMinute => LabelBillableByGithub { sku: sku }
    ChargedAgainstPlanQuota => LabelBillableByGithub { sku: sku }
    FreeInPublicRepository => LabelFreeOnGithub
    BillabilityUnread { obligation: o } => LabelBillabilityUnestablished { reason: o }
  }
}
