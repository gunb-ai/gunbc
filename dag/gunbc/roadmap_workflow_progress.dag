module gunbc.roadmap_workflow_progress


type WorkflowAttemptEvidence {
  node_id: String
  attempt_key: String
  branch: String
  modeled_state_present: Bool
  admission_receipt_readable: Bool
  admission_receipt: String
  spawn_failure_present: Bool
  spawn_failure: String
  provider_events_readable: Bool
  provider_events: String
  provider_events_error: String
  process: gunbc.worker_lifecycle.WorkerProcessEvidence
  validation_summary: String
  verification_subject: gunbc.roadmap_verification_receipt.VerificationSubjectObservation
  verification_selection: gunbc.roadmap_verification_receipt.CurrentVerificationSelectionObservation
  verification_source: gunbc.roadmap_verification_receipt.VerificationReceiptFileSource
  publication_subject: gunbc.roadmap_publish.PublicationSubjectObservation
  publication_source: gunbc.roadmap_publish.PublicationReceiptSource
}

type WorkflowAttemptProgress {
  node_id: String
  attempt_key: String
  branch: String
  admission_receipt: String
  provider: gunbc.roadmap_provider_events.ProviderExecutionState
  process: gunbc.worker_lifecycle.WorkerProcessEvidence
  validation_summary: String
  segments: List<gunbc.roadmap_workflow_stage.WorkflowSegment>
  reconciliation: gunbc.workflow_reconcile.WorkflowReconcileReport
}

data workflow_progress_projection_note: String = "The row progress bar is a pure projection over independent evidence, never a stored workflow status. An attempt state pointer is published only after environment admission, worktree creation, an immutable admission receipt, and an empty provider-events file all exist. Readability alone is not admission: the projection requires the receipt to START with the emitter's own admitted identity prefix (schema then status), so a corrupted or refused receipt cannot paint Environment complete. Positional identity replaces a text scan that any value position could satisfy. Complete Codex JSONL remains attempt evidence; the observer's modeled jq capability validates it and emits bounded structural envelopes before this module derives agent activity and provider terminal events. Large command output is therefore opaque to the synchronous UI rather than a workflow refusal. The shared gunbc.worker_lifecycle.WorkerProcessEvidence supplies process presence and exit to both the Sessions surface and Agent reconciliation. Reconciliation is fail-closed, and Agent completes ONLY on the design contract's compatible process exit: a failed event projection refuses, nonzero exit before a terminal event is failure, zero exit without a terminal event is refused/incomplete, malformed events remain refused, contradictory turn.completed plus nonzero process exit is refused, turn.completed with the pane still running stays ACTIVE awaiting that exit, and turn.completed with an absent or unobserved process REFUSES because no exit was established. A terminal provider event alone never paints Agent complete — that would fabricate a completed obligation from incomplete evidence. The ordered desired facts derive from roadmap_attempt_workflow_segment_kinds; only non-pending evidence projections enter the observed fact forest, so Pending in the row means an absent observation rather than a fabricated pending receipt. The two forests reconcile through gunbc.workflow_reconcile, making observed count, remaining work, and overall convergence fold results rather than another hand-authored status. Verification, publication, review, and goal audit remain pending until their own authoritative receipts exist; provider completion cannot fabricate them."



data admission_receipt_decode_note: String = "review 44094. This consumer used to ask a Bool of the receipt text and give ONE message to two different states: a receipt that records a refusal, and a document this reader cannot decode at all. They have different remedies — read the refusal's own reason versus find out who wrote a foreign document at the attempt path — so each gets its own located arm, decoded through the emitter's own rows rather than re-spelled here."

fn receipt_records_admission(receipt: String) -> Bool {
  match gunbc.roadmap_dispatch_environment.dispatch_environment_receipt_decode(receipt: receipt) {
    gunbc.roadmap_dispatch_environment.ReceiptDecoded { status } =>
      match status {
        gunbc.roadmap_dispatch_environment.ReceiptAdmitted => true
        gunbc.roadmap_dispatch_environment.ReceiptRefused => false
      }
    gunbc.roadmap_dispatch_environment.ReceiptUndecodable { reason: _ } => false
  }
}

fn admission_receipt_refusal(receipt: String) -> gunbc.roadmap_provider_events.ProviderExecutionState {
  match gunbc.roadmap_dispatch_environment.dispatch_environment_receipt_decode(receipt: receipt) {
    gunbc.roadmap_dispatch_environment.ReceiptDecoded { status: _ } =>
      gunbc.roadmap_provider_events.ProviderEventsRefused {
        activity: "environment admission refused",
        detail: "admission receipt records a refused environment admission; its own reason field carries the cause",
      }
    gunbc.roadmap_dispatch_environment.ReceiptUndecodable { reason } =>
      gunbc.roadmap_provider_events.ProviderEventsRefused {
        activity: "admission receipt undecodable",
        detail: reason,
      }
  }
}

fn provider_execution_reconcile_process(
  provider: gunbc.roadmap_provider_events.ProviderExecutionState,
  process: gunbc.worker_lifecycle.WorkerProcessEvidence,
) -> gunbc.roadmap_provider_events.ProviderExecutionState {
  match provider {
    gunbc.roadmap_provider_events.ProviderFailed { activity: _, detail: _ } => provider
    gunbc.roadmap_provider_events.ProviderEventsRefused { activity: _, detail: _ } => provider
    gunbc.roadmap_provider_events.ProviderCompleted { activity } =>
      match process {
        gunbc.worker_lifecycle.WorkerProcessExited { exit_code, last_command: _ } =>
          if exit_code == 0 {
            provider
          } else {
            gunbc.roadmap_provider_events.ProviderEventsRefused {
              activity: activity,
              detail: join([
                "Codex emitted turn.completed but the retained pane exited ",
                to_string(exit_code),
                "; terminal evidence conflicts",
              ], ""),
            }
          }
        gunbc.worker_lifecycle.WorkerProcessRunning { command: _ } =>
          gunbc.roadmap_provider_events.ProviderRunning {
            activity: join([
              activity,
              "; awaiting process exit",
            ], ""),
          }
        gunbc.worker_lifecycle.WorkerProcessAbsent =>
          gunbc.roadmap_provider_events.ProviderEventsRefused {
            activity: activity,
            detail: "Codex emitted turn.completed but no process exit was observed; the pane is absent, so the compatible exit the Agent obligation requires cannot be established",
          }
        gunbc.worker_lifecycle.WorkerProcessUnobserved { reason } =>
          gunbc.roadmap_provider_events.ProviderEventsRefused {
            activity: activity,
            detail: join([
              "Codex emitted turn.completed but process evidence is unobserved (",
              reason,
              "); the compatible exit the Agent obligation requires cannot be established",
            ], ""),
          }
      }
    _ =>
      match process {
        gunbc.worker_lifecycle.WorkerProcessRunning { command: _ } =>
          match provider {
            gunbc.roadmap_provider_events.ProviderNotStarted =>
              gunbc.roadmap_provider_events.ProviderStarting { activity: "waiting for first provider event" }
            _ => provider
          }
        gunbc.worker_lifecycle.WorkerProcessExited { exit_code, last_command: _ } =>
          if exit_code == 0 {
            gunbc.roadmap_provider_events.ProviderEventsRefused {
              activity: "provider process exited",
              detail: "provider process exited 0 without turn.completed, turn.failed, or error",
            }
          } else {
            gunbc.roadmap_provider_events.ProviderFailed {
              activity: "provider process exited",
              detail: join([
                "provider process exited ",
                to_string(exit_code),
                " before a terminal provider event",
              ], ""),
            }
          }
        gunbc.worker_lifecycle.WorkerProcessAbsent =>
          gunbc.roadmap_provider_events.ProviderEventsRefused {
            activity: "provider process absent",
            detail: "no retained provider pane and no terminal provider event",
          }
        gunbc.worker_lifecycle.WorkerProcessUnobserved { reason } =>
          gunbc.roadmap_provider_events.ProviderEventsRefused {
            activity: "process observation refused",
            detail: reason as String,
          }
      }
  }
}

fn workflow_provider_from_evidence(
  evidence: WorkflowAttemptEvidence,
) -> gunbc.roadmap_provider_events.ProviderExecutionState {
  if !evidence.modeled_state_present {
    gunbc.roadmap_provider_events.ProviderEventsRefused {
      activity: gunbc.roadmap_workflow_command.legacy_attempt_supersedable_label,
      detail: gunbc.roadmap_workflow_command.legacy_attempt_supersedable_detail,
    }
  } else if !evidence.admission_receipt_readable {
    gunbc.roadmap_provider_events.ProviderEventsRefused {
      activity: "attempt state refused",
      detail: "current attempt pointer exists but its admission receipt is unreadable",
    }
  } else if !receipt_records_admission(receipt: evidence.admission_receipt) {
    admission_receipt_refusal(receipt: evidence.admission_receipt)
  } else if evidence.spawn_failure_present {
    gunbc.roadmap_provider_events.ProviderFailed {
      activity: "dispatch staging failed",
      detail: evidence.spawn_failure,
    }
  } else if !evidence.provider_events_readable {
    gunbc.roadmap_provider_events.ProviderEventsRefused {
      activity: "event capture refused",
      detail: join([
        "initialized provider event stream is unreadable: ",
        evidence.provider_events_error,
      ], ""),
    }
  } else {
    provider_execution_reconcile_process(
      provider: gunbc.roadmap_provider_events.provider_execution_state(
        parsed: gunbc.roadmap_provider_events.parse_codex_jsonl(text: evidence.provider_events),
      ),
      process: evidence.process,
    )
  }
}

fn provider_workflow_segment(
  provider: gunbc.roadmap_provider_events.ProviderExecutionState,
) -> gunbc.roadmap_workflow_stage.WorkflowSegment {
  match provider {
    gunbc.roadmap_provider_events.ProviderNotStarted =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending,
        detail: "provider has not emitted an event",
      }
    gunbc.roadmap_provider_events.ProviderStarting { activity } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentActive,
        detail: activity,
      }
    gunbc.roadmap_provider_events.ProviderRunning { activity } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentActive,
        detail: activity,
      }
    gunbc.roadmap_provider_events.ProviderCompleted { activity } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete,
        detail: activity,
      }
    gunbc.roadmap_provider_events.ProviderFailed { activity, detail } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentFailed,
        detail: join([activity, ": ", detail], ""),
      }
    gunbc.roadmap_provider_events.ProviderEventsRefused { activity, detail } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
        detail: join([activity, ": ", detail], ""),
      }
  }
}

data verification_segment_receipt_note: String = "Verify moves on ITS OWN receipt and on nothing else. The lamp used to be hardcoded pending, which was honest while no producer existed but stopped being honest the moment one did. What it must never become is a projection of the Agent obligation: a provider that completed has produced a diff, not a verified one, and painting Verify from provider completion would fabricate the very fact the receipt exists to establish. So the receipt's ABSENCE is still pending — the same answer as before — and only a decodable receipt moves the lamp. The three verdicts land on three different segment states because they mean three different things to whoever reads the row: a pass satisfies the obligation, a failure is the subject's problem, and a refusal is the mechanism declining to answer, which is not a red and must not be shown as one. An undecodable document is refused rather than ignored, because a receipt this reader cannot decode at the attempt's own path is a fact about that attempt, not an absence."

data publication_segment_reads_a_receipt_note: String = "THIS ARM WAS A CONSTANT, AND THAT IS THE DEFECT IT REPLACES. It returned WorkflowSegmentPending with a fixed sentence no matter what had happened, so a row whose branch was published at exactly the head under judgment looked identical to one nobody had pushed. A constant cannot be wrong about a particular attempt because it is not about any attempt - which also means it can never become right.\\n\\nAND THE FIRST REPLACEMENT WAS STILL WRONG, IN A WAY WORTH RECORDING BECAUSE IT IS THE HARDER DEFECT. It decoded the receipt found at the attempt's path and mapped a bound outcome straight to Complete, comparing nothing. A receipt is a document about a subject; finding one at a path establishes that somebody wrote it there, not that it answers THIS row's question. So the projection had reintroduced the branch lookup this whole lane exists to remove, with a file location standing in for the branch name.\\n\\nSO THE PROJECTION NOW HOLDS AN EXPECTED SUBJECT AND publication_evidence_for DECIDES. Four cases, and only one of them is evidence: absent, unreadable, about another subject, or about this one. A readable receipt about another subject is the case that matters, because it is the one that looks entirely healthy.\\n\\nAND THE SUBJECT ITSELF CAN BE MISSING, which is a fifth state and not a sixth phrasing of pending. The head is read from the attempt's worktree and that read can fail; with no head there is no subject, nothing to compare against, and the honest answer is a refusal that names what could not be read - never a pending that a reader would take for `not published yet`.\\n\\nTHE EIGHT OUTCOMES LAND ON FOUR STATES AND THE MAPPING IS EXHAUSTIVE OVER THE COPRODUCT, not over strings. An earlier cut matched outcome keys with a trailing else, so a ninth outcome would have silently become Refused and nothing would have failed to compile. Matching the variants means adding one forces this function to decide what it means."

fn publication_outcome_segment_state(
  outcome: gunbc.roadmap_publish.PublicationReceiptOutcome,
) -> gunbc.roadmap_workflow_stage.WorkflowSegmentState {
  match outcome {
    gunbc.roadmap_publish.ReceiptBound { pr_number: _, url: _, draft: _ } => gunbc.roadmap_workflow_stage.WorkflowSegmentComplete
    gunbc.roadmap_publish.ReceiptHeadDiverged { pr_number: _, pr_head: _, url: _ } => gunbc.roadmap_workflow_stage.WorkflowSegmentFailed
    gunbc.roadmap_publish.ReceiptRemoteBranchHeadDiverged { remote_head: _ } => gunbc.roadmap_workflow_stage.WorkflowSegmentFailed
    gunbc.roadmap_publish.ReceiptBranchNotPublished { remote_branches_seen: _ } => gunbc.roadmap_workflow_stage.WorkflowSegmentPending
    gunbc.roadmap_publish.ReceiptRemoteBranchAtHeadWithoutPullRequest { head_sha: _ } => gunbc.roadmap_workflow_stage.WorkflowSegmentPending
    gunbc.roadmap_publish.ReceiptBindingAmbiguous { pr_numbers: _ } => gunbc.roadmap_workflow_stage.WorkflowSegmentRefused
    gunbc.roadmap_publish.ReceiptRemoteBranchBindingAmbiguous { refs_matched: _ } => gunbc.roadmap_workflow_stage.WorkflowSegmentRefused
    gunbc.roadmap_publish.ReceiptObservationRefused { detail: _ } => gunbc.roadmap_workflow_stage.WorkflowSegmentRefused
  }
}

// THE HEAD IN THE BOUND SENTENCE COMES FROM THE SUBJECT, NOT FROM THE OUTCOME. ReceiptBound carries no head of its own - see roadmap_publish's receipt_bound_carries_no_head_note - because the head it offers is the subject's expected_head by the meaning of the variant. So this projection takes that head as a parameter and renders the one copy that exists, which is why the sentence cannot disagree with the judgment it describes.
fn publication_outcome_segment_detail(
  outcome: gunbc.roadmap_publish.PublicationReceiptOutcome,
  expected_head: CommitSha,
) -> String {
  match outcome {
    gunbc.roadmap_publish.ReceiptBound { pr_number, url, draft } =>
      join([
        "published as pull request #", to_string(pr_number),
        " at the expected head ", expected_head as String,
        if draft { " (draft)" } else { "" },
        ": ", url as String,
      ], "")
    gunbc.roadmap_publish.ReceiptHeadDiverged { pr_number, pr_head, url } =>
      join([
        "pull request #", to_string(pr_number),
        " exists for this branch but offers ", pr_head as String,
        ", which is not the commit under judgment: ", url as String,
      ], "")
    gunbc.roadmap_publish.ReceiptBindingAmbiguous { pr_numbers } =>
      join([
        "two or more pull requests match this branch and base (",
        to_string(pr_numbers.count()),
        " of them), so no single one is the publication",
      ], "")
    gunbc.roadmap_publish.ReceiptRemoteBranchAtHeadWithoutPullRequest { head_sha } =>
      join([
        "the branch is pushed at the expected head ", head_sha as String,
        " and no pull request offers it, so there is nothing to review yet",
      ], "")
    gunbc.roadmap_publish.ReceiptRemoteBranchHeadDiverged { remote_head } =>
      join([
        "the branch is pushed at ", remote_head as String,
        ", which is not the commit under judgment, and no pull request offers either",
      ], "")
    gunbc.roadmap_publish.ReceiptRemoteBranchBindingAmbiguous { refs_matched } =>
      join([
        "the remote advertised ", to_string(refs_matched),
        " refs for this branch name, so its head was not established",
      ], "")
    gunbc.roadmap_publish.ReceiptBranchNotPublished { remote_branches_seen } =>
      join([
        "the branch is not on the remote (",
        to_string(remote_branches_seen),
        " branches advertised), so nothing has been published for this attempt",
      ], "")
    gunbc.roadmap_publish.ReceiptObservationRefused { detail } =>
      join(["publication could not be observed: ", detail], "")
  }
}

fn publication_evidence_segment(
  evidence: gunbc.roadmap_publish.PublicationEvidence,
) -> gunbc.roadmap_workflow_stage.WorkflowSegment {
  match evidence {
    gunbc.roadmap_publish.EvidenceAbsent =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.PublicationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending,
        detail: "publication has not been adjudicated for this attempt's head: no receipt exists yet. This is an absent observation, not a judgment that the branch is unpublished",
      }
    gunbc.roadmap_publish.EvidenceUnreadable { reason } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.PublicationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
        detail: join([
          "a publication receipt exists for this attempt's head and this reader cannot decode it: ",
          reason,
        ], ""),
      }
    gunbc.roadmap_publish.EvidenceForAnotherSubject { field, expected, found } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.PublicationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
        detail: join([
          "a publication receipt was read for this attempt and it answers a different question: ",
          field as String, " should be ", expected, " and the receipt records ", found,
        ], ""),
      }
    gunbc.roadmap_publish.EvidenceForSubject { receipt } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.PublicationWorkflowSegment,
        state: publication_outcome_segment_state(outcome: receipt.outcome),
        detail: join([
          publication_outcome_segment_detail(
            outcome: receipt.outcome,
            expected_head: receipt.subject.expected_head,
          ),
          " (", receipt.subject.branch as String,
          " at ", receipt.subject.expected_head as String,
          " in ", receipt.subject.repository.full_name, ")",
        ], ""),
      }
  }
}

fn publication_segment(
  publication_subject: gunbc.roadmap_publish.PublicationSubjectObservation,
  publication_source: gunbc.roadmap_publish.PublicationReceiptSource,
) -> gunbc.roadmap_workflow_stage.WorkflowSegment {
  match publication_subject {
    gunbc.roadmap_publish.PublicationSubjectUnobserved { reason } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.PublicationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
        detail: join([
          "this attempt has no exact head to adjudicate publication against, so no receipt can be checked for it: ",
          reason,
        ], ""),
      }
    gunbc.roadmap_publish.PublicationSubjectObserved { subject } =>
      publication_evidence_segment(
        evidence: gunbc.roadmap_publish.publication_evidence_for(
          expected: subject,
          source: publication_source,
        ),
      )
  }
}

fn verification_evidence_segment(
  evidence: gunbc.roadmap_verification_receipt.VerificationFileEvidence,
) -> gunbc.roadmap_workflow_stage.WorkflowSegment {
  match evidence {
    gunbc.roadmap_verification_receipt.VerificationFileAbsent =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending,
        detail: "the declared validation has not run yet for this attempt's head: no exact-head verification receipt exists yet. This is an absent observation, not a judgment that validation passed",
      }
    gunbc.roadmap_verification_receipt.VerificationFileUnreadable { reason } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
        detail: join([
          "a verification receipt exists for this attempt's head and this reader cannot decode it: ",
          reason,
        ], ""),
      }
    gunbc.roadmap_verification_receipt.VerificationFileDecoded { evidence: decoded } =>
      match decoded {
        gunbc.roadmap_verification_receipt.VerificationEvidenceForSubject { receipt } =>
          gunbc.roadmap_workflow_stage.WorkflowSegment {
            kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
            state: if gunbc.roadmap_verification_receipt.verification_evidence_moves_lamp(evidence: decoded) {
              gunbc.roadmap_workflow_stage.WorkflowSegmentComplete
            } else if gunbc.roadmap_validation_oracle.validation_verdict_key(verdict: receipt.verdict) == "failed" {
              gunbc.roadmap_workflow_stage.WorkflowSegmentFailed
            } else if gunbc.roadmap_validation_oracle.validation_verdict_key(verdict: receipt.verdict) == "not_run" {
              gunbc.roadmap_workflow_stage.WorkflowSegmentPending
            } else {
              gunbc.roadmap_workflow_stage.WorkflowSegmentRefused
            },
            detail: join([
              gunbc.roadmap_validation_oracle.validation_verdict_detail(verdict: receipt.verdict),
              " (",
              receipt.subject.branch as String,
              " at ",
              receipt.subject.head_sha as String,
              ")",
            ], ""),
          }
        gunbc.roadmap_verification_receipt.VerificationEvidenceForAnotherSubject { field, expected, found } =>
          gunbc.roadmap_workflow_stage.WorkflowSegment {
            kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
            state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
            detail: join([
              "a verification receipt was read for this attempt and it answers a different question: ",
              field as String, " should be ", expected, " and the receipt records ", found,
            ], ""),
          }
        gunbc.roadmap_verification_receipt.VerificationEvidenceLegacyAttemptLevel { verdict_key } =>
          gunbc.roadmap_workflow_stage.WorkflowSegment {
            kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
            state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending,
            detail: join([
              gunbc.roadmap_verification_receipt.legacy_validation_receipt_detail,
              " (verdict key: ",
              verdict_key,
              ")",
            ], ""),
          }
        gunbc.roadmap_verification_receipt.VerificationEvidenceUnreadable { reason } =>
          gunbc.roadmap_workflow_stage.WorkflowSegment {
            kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
            state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
            detail: join([
              "a verification receipt exists for this attempt's head and this reader cannot decode it: ",
              reason,
            ], ""),
          }
        gunbc.roadmap_verification_receipt.VerificationEvidenceV1LegacyExactHead { legacy: _ } =>
          gunbc.roadmap_workflow_stage.WorkflowSegment {
            kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
            state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
            detail: "a v1 exact-head receipt at the exact path lacks change_window_identity and cannot satisfy the selected v2 subject",
          }
      }
  }
}

fn verification_segment(
  provider: gunbc.roadmap_provider_events.ProviderExecutionState,
  validation_summary: String,
  verification_subject: gunbc.roadmap_verification_receipt.VerificationSubjectObservation,
  verification_selection: gunbc.roadmap_verification_receipt.CurrentVerificationSelectionObservation,
  verification_source: gunbc.roadmap_verification_receipt.VerificationReceiptFileSource,
) -> gunbc.roadmap_workflow_stage.WorkflowSegment {
  match verification_selection {
    gunbc.roadmap_verification_receipt.SelectionUnaddressable { cause } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
        detail: join([
          "the worktree head could not be observed, so the verification question cannot be addressed: ",
          cause,
        ], ""),
      }
    gunbc.roadmap_verification_receipt.SelectionAbsent =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending,
        detail: "the belt has not selected a verification window for this head yet",
      }
    gunbc.roadmap_verification_receipt.SelectionUnreadable { cause } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
        detail: join([
          "the current verification selection could not be read: ",
          cause,
        ], ""),
      }
    gunbc.roadmap_verification_receipt.SelectionMalformed { cause } =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
        detail: join([
          "the current verification selection is malformed: ",
          cause,
        ], ""),
      }
    gunbc.roadmap_verification_receipt.SelectionObserved { head: _, window_identity: _ } =>
      match verification_subject {
        gunbc.roadmap_verification_receipt.VerificationSubjectUnobserved { reason } =>
          gunbc.roadmap_workflow_stage.WorkflowSegment {
            kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
            state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused,
            detail: join([
              "this attempt has no exact head to adjudicate verification against, so no receipt can be checked for it: ",
              reason,
            ], ""),
          }
        gunbc.roadmap_verification_receipt.VerificationSubjectObserved { subject } =>
          if match verification_source {
            VerificationReceiptAbsent => true
            VerificationReceiptUnreadable { detail: _ } => false
            VerificationReceiptPresent { text: _ } => false
          } && match provider {
            gunbc.roadmap_provider_events.ProviderCompleted { activity: _ } => true
            _ => false
          } {
            gunbc.roadmap_workflow_stage.WorkflowSegment {
              kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment,
              state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending,
              detail: join([
                "awaiting independent exact-head validation receipt",
                if validation_summary == "" {
                  ""
                } else {
                  join([": ", validation_summary], "")
                },
              ], ""),
            }
          } else {
            verification_evidence_segment(
              evidence: gunbc.roadmap_verification_receipt.verification_file_evidence_for(
                expected: subject,
                source: verification_source,
              ),
            )
          }
      }
  }
}

fn workflow_segment_from_evidence(
  kind: gunbc.roadmap_workflow_stage.WorkflowSegmentKind,
  evidence: WorkflowAttemptEvidence,
  provider: gunbc.roadmap_provider_events.ProviderExecutionState,
  admitted: Bool,
) -> gunbc.roadmap_workflow_stage.WorkflowSegment {
  match kind {
    gunbc.roadmap_workflow_stage.EnvironmentWorkflowSegment =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: kind,
        state: if admitted {
          gunbc.roadmap_workflow_stage.WorkflowSegmentComplete
        } else {
          gunbc.roadmap_workflow_stage.WorkflowSegmentRefused
        },
        detail: if admitted {
          "dispatch environment admitted with grounded Ensure receipts"
        } else if evidence.admission_receipt_readable {
          "environment admission receipt is corrupt or does not say admitted"
        } else {
          "environment admission receipt unavailable"
        },
      }
    gunbc.roadmap_workflow_stage.WorkspaceWorkflowSegment =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: kind,
        state: if evidence.modeled_state_present {
          gunbc.roadmap_workflow_stage.WorkflowSegmentComplete
        } else {
          gunbc.roadmap_workflow_stage.WorkflowSegmentRefused
        },
        detail: if evidence.modeled_state_present {
          "attempt branch and worktree preceded state publication"
        } else {
          "legacy branch has no modeled workspace publication receipt"
        },
      }
    gunbc.roadmap_workflow_stage.AgentWorkflowSegment =>
      provider_workflow_segment(provider: provider)
    gunbc.roadmap_workflow_stage.VerificationWorkflowSegment =>
      verification_segment(
        provider: provider,
        validation_summary: evidence.validation_summary,
        verification_subject: evidence.verification_subject,
        verification_selection: evidence.verification_selection,
        verification_source: evidence.verification_source,
      )
    gunbc.roadmap_workflow_stage.PublicationWorkflowSegment =>
      publication_segment(
        publication_subject: evidence.publication_subject,
        publication_source: evidence.publication_source,
      )
    gunbc.roadmap_workflow_stage.ReviewWorkflowSegment =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: kind,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending,
        detail: "awaiting an exact-head pull-request binding and review verdict",
      }
    gunbc.roadmap_workflow_stage.GoalAuditWorkflowSegment =>
      gunbc.roadmap_workflow_stage.WorkflowSegment {
        kind: kind,
        state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending,
        detail: "awaiting an independent audit of the exact candidate against the current approved goal",
      }
  }
}

fn workflow_fact_state_from_segment_state(
  state: gunbc.roadmap_workflow_stage.WorkflowSegmentState,
) -> gunbc.workflow_reconcile.WorkflowFactState {
  match state {
    gunbc.roadmap_workflow_stage.WorkflowSegmentPending => gunbc.workflow_reconcile.WorkflowFactPending
    gunbc.roadmap_workflow_stage.WorkflowSegmentActive => gunbc.workflow_reconcile.WorkflowFactActive
    gunbc.roadmap_workflow_stage.WorkflowSegmentComplete => gunbc.workflow_reconcile.WorkflowFactSatisfied
    gunbc.roadmap_workflow_stage.WorkflowSegmentFailed => gunbc.workflow_reconcile.WorkflowFactFailed
    gunbc.roadmap_workflow_stage.WorkflowSegmentRefused => gunbc.workflow_reconcile.WorkflowFactRefused
  }
}

fn workflow_attempt_id(
  node_id: String,
  attempt_key: String,
) -> String {
  join([node_id, ":", attempt_key], "")
}

fn workflow_desired_fact(
  workflow_id: String,
  kind: gunbc.roadmap_workflow_stage.WorkflowSegmentKind,
) -> gunbc.workflow_reconcile.WorkflowFact {
  gunbc.workflow_reconcile.WorkflowFact {
    key: gunbc.workflow_reconcile.WorkflowFactKey {
      workflow_id: workflow_id,
      obligation_id: gunbc.roadmap_workflow_stage.workflow_segment_kind_key(kind: kind),
    },
    intent_revision: gunbc.roadmap_workflow_stage.workflow_segment_intent_revision(kind: kind),
    state: gunbc.workflow_reconcile.WorkflowFactSatisfied,
    detail: gunbc.roadmap_workflow_stage.workflow_segment_kind_label(kind: kind),
  }
}

fn workflow_observed_fact(
  workflow_id: String,
  segment: gunbc.roadmap_workflow_stage.WorkflowSegment,
) -> gunbc.workflow_reconcile.WorkflowFact {
  gunbc.workflow_reconcile.WorkflowFact {
    key: gunbc.workflow_reconcile.WorkflowFactKey {
      workflow_id: workflow_id,
      obligation_id: gunbc.roadmap_workflow_stage.workflow_segment_kind_key(kind: segment.kind),
    },
    intent_revision: gunbc.roadmap_workflow_stage.workflow_segment_intent_revision(kind: segment.kind),
    state: workflow_fact_state_from_segment_state(state: segment.state),
    detail: segment.detail,
  }
}

fn workflow_desired_fact_forest(
  workflow_id: String,
) -> List<gunbc.workflow_reconcile.WorkflowFactTree> {
  map(
    gunbc.roadmap_workflow_stage.roadmap_attempt_workflow_segment_kinds,
    kind => gunbc.workflow_reconcile.WorkflowFactLeaf {
      fact: workflow_desired_fact(
        workflow_id: workflow_id,
        kind: kind,
      ),
    },
  )
}

fn workflow_observed_fact_forest(
  workflow_id: String,
  segments: List<gunbc.roadmap_workflow_stage.WorkflowSegment>,
) -> List<gunbc.workflow_reconcile.WorkflowFactTree> {
  flat_map(
    segments,
    segment => match segment.state {
      gunbc.roadmap_workflow_stage.WorkflowSegmentPending => []
      _ => [
        gunbc.workflow_reconcile.WorkflowFactLeaf {
          fact: workflow_observed_fact(
            workflow_id: workflow_id,
            segment: segment,
          ),
        },
      ]
    },
  )
}

fn workflow_attempt_reconciliation(
  evidence: WorkflowAttemptEvidence,
  segments: List<gunbc.roadmap_workflow_stage.WorkflowSegment>,
) -> gunbc.workflow_reconcile.WorkflowReconcileReport {
  let workflow_id = workflow_attempt_id(
    node_id: evidence.node_id,
    attempt_key: evidence.attempt_key,
  )
  gunbc.workflow_reconcile.workflow_reconcile_report(
    desired: workflow_desired_fact_forest(workflow_id: workflow_id),
    observed: workflow_observed_fact_forest(
      workflow_id: workflow_id,
      segments: segments,
    ),
  )
}

fn workflow_attempt_progress(
  evidence: WorkflowAttemptEvidence,
) -> WorkflowAttemptProgress {
  let provider = workflow_provider_from_evidence(evidence: evidence)
  let admitted = evidence.modeled_state_present
    && evidence.admission_receipt_readable
    && receipt_records_admission(receipt: evidence.admission_receipt)
  let segments = map(
    gunbc.roadmap_workflow_stage.roadmap_attempt_workflow_segment_kinds,
    kind => workflow_segment_from_evidence(
      kind: kind,
      evidence: evidence,
      provider: provider,
      admitted: admitted,
    ),
  )
  WorkflowAttemptProgress {
    node_id: evidence.node_id,
    attempt_key: evidence.attempt_key,
    branch: evidence.branch,
    admission_receipt: evidence.admission_receipt,
    provider: provider,
    process: evidence.process,
    validation_summary: evidence.validation_summary,
    segments: segments,
    reconciliation: workflow_attempt_reconciliation(
      evidence: evidence,
      segments: segments,
    ),
  }
}

fn workflow_segment_json_value(segment: gunbc.roadmap_workflow_stage.WorkflowSegment) -> extdeps.languages.json.emit.JsonValue {
  extdeps.languages.json.emit.json_object(members: [
    extdeps.languages.json.emit.json_kv(
      key: "kind",
      value: extdeps.languages.json.emit.json_string(s: gunbc.roadmap_workflow_stage.workflow_segment_kind_key(kind: segment.kind)),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "label",
      value: extdeps.languages.json.emit.json_string(s: gunbc.roadmap_workflow_stage.workflow_segment_kind_label(kind: segment.kind)),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "short_label",
      value: extdeps.languages.json.emit.json_string(s: gunbc.roadmap_workflow_stage.workflow_segment_kind_short_label(kind: segment.kind)),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "state",
      value: extdeps.languages.json.emit.json_string(s: gunbc.roadmap_workflow_stage.workflow_segment_state_key(state: segment.state)),
    ),
    extdeps.languages.json.emit.json_kv(key: "detail", value: extdeps.languages.json.emit.json_string(s: segment.detail)),
  ])
}

// Split so a composing consumer can EXTEND the attempt object without re-stating these members or pattern-matching the built JsonValue back open: the belt appends the decided presentation ('activity', from gunbc.roadmap_presentation) to this same object, and progress cannot import presentation without a cycle — the member list is the composition seam.
fn workflow_attempt_progress_json_members(
  progress: WorkflowAttemptProgress,
) -> List<extdeps.languages.json.emit.JsonKeyValue> {
  [
    extdeps.languages.json.emit.json_kv(key: "node_id", value: extdeps.languages.json.emit.json_string(s: progress.node_id)),
    extdeps.languages.json.emit.json_kv(key: "attempt_key", value: extdeps.languages.json.emit.json_string(s: progress.attempt_key)),
    extdeps.languages.json.emit.json_kv(key: "branch", value: extdeps.languages.json.emit.json_string(s: progress.branch)),
    extdeps.languages.json.emit.json_kv(
      key: "provider_status",
      value: extdeps.languages.json.emit.json_string(s: gunbc.roadmap_provider_events.provider_execution_state_label(state: progress.provider)),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "provider_activity",
      value: extdeps.languages.json.emit.json_string(s: gunbc.roadmap_provider_events.provider_execution_activity(state: progress.provider)),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "provider_detail",
      value: extdeps.languages.json.emit.json_string(s: gunbc.roadmap_provider_events.provider_execution_detail(state: progress.provider)),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "validation_summary",
      value: extdeps.languages.json.emit.json_string(s: progress.validation_summary),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "admission_receipt",
      value: extdeps.languages.json.emit.json_string(s: progress.admission_receipt),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "workflow_status",
      value: extdeps.languages.json.emit.json_string(s: gunbc.workflow_reconcile.workflow_reconcile_status_key(
        report: progress.reconciliation,
      )),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "desired_obligations",
      value: extdeps.languages.json.emit.json_int(n: progress.reconciliation.desired_count),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "observed_obligations",
      value: extdeps.languages.json.emit.json_int(n: progress.reconciliation.observed_count),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "remaining_obligations",
      value: extdeps.languages.json.emit.json_int(n: progress.reconciliation.remaining_count),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "failed_obligations",
      value: extdeps.languages.json.emit.json_int(n: progress.reconciliation.observed_failure_count),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "refused_obligations",
      value: extdeps.languages.json.emit.json_int(n: progress.reconciliation.observed_refusal_count),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "reconciliation_refusals",
      value: extdeps.languages.json.emit.json_int(n: progress.reconciliation.plan_refusal_count),
    ),
    extdeps.languages.json.emit.json_kv(
      key: "segments",
      value: extdeps.languages.json.emit.json_array(elements: map(
        progress.segments,
        segment => workflow_segment_json_value(segment: segment),
      )),
    ),
  ]
}

fn workflow_attempt_progress_json_value(
  progress: WorkflowAttemptProgress,
) -> extdeps.languages.json.emit.JsonValue {
  extdeps.languages.json.emit.json_object(members: workflow_attempt_progress_json_members(
    progress: progress,
  ))
}
