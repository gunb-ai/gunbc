module gunbc.scaffold_retirement

import std.types { String, Bool, Int, List }
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField, DeclField }
import gunbc.roadmap_model { RoadmapNode, RoadmapNodeIdentity }
import gunbc.roadmap_authority { declared_roadmap_nodes }
import gunbc.roadmap_identity {
  RoadmapIdentityRecord,
  ActiveIdentity,
  TombstonedIdentity,
  roadmap_identity_registry,
  record_identity,
}
import gunbc.ci_layer_roots { witness_layer_roots }
import v2.std.decl_index {
  DeclFact,
  DataItem,
  FnItem,
  FuncItem,
  TypeItem,
  ServiceItem,
  OtherItem,
  decl_facts,
}
import v2.std.algebra { length, count_where }
import v2.std.collection { Absent, Present, list_at_optional }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.node {
  Atom,
  Node,
  NodeFold,
  Symbol,
  TypeNode,
  fold_node,
}
import v2.std.node_query { node_positional_child_targets }
import v2.lens.disposition_redundancy {
  decl_ref_eq,
  disposition_redundancy_violation_count,
}
import std.disposition { Disposition, Scaffold, SingleAuthority }

data scaffold_retirement_pilot_derivation_note: String = "POPULATION IS DERIVED, NEVER AUTHORED. derived_scaffold_disposition_sites() folds decl_facts(pool_roots) body nodes over witness_layer_roots (dag + src/v2): every DataItem whose initializer variant is Scaffold (Disposition-typed by construction — Scaffold is only a Disposition constructor). Structural Node-tree selection only — not regex, not a hand roster. The pilot takes the first fifteen rows, lexicographically stable in the decl_facts corpus walk (rel_path, name), whose rel_path is under dag/gunbc/ — a reproducible convenience sample, not a representative census of the full derived population; exclusion rates measured on the pilot must not be read as corpus-wide rates. Obligation bindings use the interim carrier-path substring heuristic documented in scaffold_retirement_obligation_join_scaffold_note until roadmap rows carry an explicit DeclarationRef obligation anchor; zero or plural matches become typed exclusions, never fabricated owners."

data scaffold_retirement_obligation_join_scaffold_note: String = "INTERIM HEURISTIC — NOT an identity join on site.bind. obligation_candidates_for_site selects declared_roadmap_nodes() rows whose carrier paths string_contains site.rel_path, site.bind.module_path, site.bind.decl_name, or site.carrier_module. Unique hit → binding; zero or plural → typed exclusion. Dissolve-on: roadmap obligation rows carry an explicit DeclarationRef anchor and derived_binding_for_site joins site.bind against that anchor via decl_ref_eq, retiring substring carrier-path matching."

type ScaffoldDispositionSite {
  qualified_name: String
  carrier_module: String
  carrier_decl: String
  rel_path: String
  bind: DeclarationRef
  dissolves_to: String
}

type ScaffoldRetirementBinding {
  scaffold: DeclarationRef
  obligation: RoadmapNodeIdentity
}

type ScaffoldRetirementExclusionReason
  = NoHonestObligationOwner {
      bind: DeclarationRef,
      candidate_count: Int,
    }
  | AmbiguousObligationOwners {
      bind: DeclarationRef,
      candidate_count: Int,
    }
  | OutsidePilotDomain { rel_path: String }

type ScaffoldRetirementExclusion {
  scaffold: DeclarationRef
  reason: ScaffoldRetirementExclusionReason
}

type ObligationIdentityAdmission
  = ObligationActive { identity: RoadmapNodeIdentity }
  | ObligationSuperseded { identity: RoadmapNodeIdentity, superseded_by: RoadmapNodeIdentity }
  | ObligationTombstonedWithoutSuccessor { identity: RoadmapNodeIdentity }
  | ObligationIdentityUnknown { identity: RoadmapNodeIdentity }
  | ObligationIdentityAmbiguous { identity: RoadmapNodeIdentity, matches: Int }

fn scaffold_subtree_atoms(n: Node) -> List<Symbol> {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        match n0.kind {
          TypeNode { connective: Atom { identity: s } } => [s]
          _ => []
        }
      },
      step: fn(acc, _edge, child) { concat(acc, child) }
    }
  )
}

fn node_atom_lexeme_optional(node: Node) -> String? {
  match node_atom_identity_optional(node: node) {
    Present { value: sym } => Present { value: symbol_lexeme(sym: sym) }
    Absent => Absent
  }
}

fn atom_lexeme_list_contains(atoms: List<Symbol>, lexeme: String) -> Bool {
  any(
    xs: atoms,
    predicate: fn(sym) { symbol_lexeme(sym: sym) == lexeme }
  )
}

fn node_is_scaffold_initializer(body: Node) -> Bool {
  match list_at_optional(xs: node_positional_child_targets(node: body), index: 0) {
    Present { value: head } =>
      match node_atom_lexeme_optional(node: head) {
        Present { value: lex } => lex == "Scaffold"
        Absent => false
      }
    Absent =>
      match node_atom_lexeme_optional(node: body) {
        Present { value: lex } => lex == "Scaffold"
        Absent => false
      }
  }
}

fn construction_mechanism_lexeme(sym: Symbol) -> Bool {
  let lex = symbol_lexeme(sym: sym)
  lex == "SingleAuthority"
    || lex == "RealizationDispatch"
    || lex == "SubstrateMandatoryTag"
}

fn first_construction_mechanism_lexeme(node: Node) -> String? {
  fold(
    scaffold_subtree_atoms(n: node),
    init: Absent,
    f: fn(acc, sym) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match construction_mechanism_lexeme(sym: sym) {
            true => Present { value: symbol_lexeme(sym: sym) }
            false => Absent
          }
      }
    }
  )
}

fn dissolves_to_from_scaffold_body(body: Node) -> String? {
  match list_at_optional(xs: node_positional_child_targets(node: body), index: 1) {
    Present { value: dissolves_to_init } => first_construction_mechanism_lexeme(node: dissolves_to_init)
    Absent => first_construction_mechanism_lexeme(node: body)
  }
}

fn named_field_from_declaration_ref_conj(node: Node, field_node: Node) -> DeclField? {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: 4) {
    Present { value: name_node } =>
      match node_atom_lexeme_optional(node: name_node) {
        Present { value: field_name } =>
          Present { value: NamedField { field_name: field_name } }
        Absent => Absent
      }
    Absent =>
      match list_at_optional(xs: node_positional_child_targets(node: field_node), index: 0) {
        Present { value: name_node } =>
          match node_atom_lexeme_optional(node: name_node) {
            Present { value: field_name } =>
              Present { value: NamedField { field_name: field_name } }
            Absent => Absent
          }
        Absent => Absent
      }
  }
}

fn decl_field_lexeme_from_field_node(node: Node, field_node: Node, lex: String) -> DeclField? {
  match lex {
    "WholeDeclaration" => Present { value: WholeDeclaration }
    "NamedField" => named_field_from_declaration_ref_conj(node: node, field_node: field_node)
    _ => Absent
  }
}

fn decl_field_from_declaration_ref_conj(node: Node) -> DeclField? {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: 3) {
    Present { value: field_node } =>
      match node_atom_lexeme_optional(node: field_node) {
        Present { value: lex } => decl_field_lexeme_from_field_node(node: node, field_node: field_node, lex: lex)
        Absent => Absent
      }
    Absent => Absent
  }
}

fn declaration_ref_when_declaration_ref_conj(node: Node) -> DeclarationRef? {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: 1) {
    Present { value: module_node } =>
      match list_at_optional(xs: node_positional_child_targets(node: node), index: 2) {
        Present { value: decl_node } =>
          match node_atom_lexeme_optional(node: module_node) {
            Present { value: module_path } =>
              match node_atom_lexeme_optional(node: decl_node) {
                Present { value: decl_name } =>
                  match decl_field_from_declaration_ref_conj(node: node) {
                    Present { value: field } =>
                      Present {
                        value: DeclarationRef {
                          module_path: module_path,
                          decl_name: decl_name,
                          field: field,
                        }
                      }
                    Absent => Absent
                  }
                Absent => Absent
              }
            Absent => Absent
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn declaration_ref_for_root_lexeme(node: Node, lex: String) -> DeclarationRef? {
  match lex {
    "DeclarationRef" => declaration_ref_when_declaration_ref_conj(node: node)
    _ => Absent
  }
}

fn declaration_ref_from_declaration_ref_conj(node: Node) -> DeclarationRef? {
  match node_atom_lexeme_optional(node: node) {
    Present { value: lex } => declaration_ref_for_root_lexeme(node: node, lex: lex)
    Absent =>
      match list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
        Present { value: child } => declaration_ref_from_declaration_ref_conj(node: child)
        Absent => Absent
      }
  }
}

fn declaration_ref_from_bind_init(bind_init: Node) -> DeclarationRef? {
  match declaration_ref_from_declaration_ref_conj(node: bind_init) {
    Present { value: bind } => Present { value: bind }
    Absent =>
      match list_at_optional(xs: node_positional_child_targets(node: bind_init), index: 0) {
        Present { value: child } => declaration_ref_from_bind_init(bind_init: child)
        Absent => Absent
      }
  }
}

fn bind_from_scaffold_body(body: Node) -> DeclarationRef? {
  match list_at_optional(xs: node_positional_child_targets(node: body), index: 2) {
    Present { value: bind_init } => declaration_ref_from_bind_init(bind_init: bind_init)
    Absent => Absent
  }
}

fn scaffold_site_when_disposition_scaffold(
  body_fact: DeclFact
) -> ScaffoldDispositionSite? {
  match node_is_scaffold_initializer(body: body_fact.node) {
    false => Absent
    true =>
      match dissolves_to_from_scaffold_body(body: body_fact.node) {
        Present { value: dissolves_to } =>
          match bind_from_scaffold_body(body: body_fact.node) {
            Present { value: bind } =>
              Present {
                value: ScaffoldDispositionSite {
                  qualified_name: body_fact.qualified_name,
                  carrier_module: decl_fact_carrier_module(fact: body_fact),
                  carrier_decl: body_fact.name,
                  rel_path: body_fact.rel_path,
                  bind: bind,
                  dissolves_to: dissolves_to,
                }
              }
            Absent => Absent
          }
        Absent => Absent
      }
  }
}

fn scaffold_site_from_body_fact(
  body_fact: DeclFact
) -> ScaffoldDispositionSite? {
  match body_fact.kind {
    DataItem => scaffold_site_when_disposition_scaffold(body_fact: body_fact)
    FnItem => Absent
    FuncItem => Absent
    TypeItem => Absent
    ServiceItem => Absent
    OtherItem => Absent
  }
}

fn derived_scaffold_disposition_sites() -> List<ScaffoldDispositionSite> {
  let roots = witness_layer_roots
  fold(
    decl_facts(pool_roots: roots),
    init: [],
    f: fn(acc, fact) {
      match scaffold_site_from_body_fact(body_fact: fact) {
        Present { value: site } => append(acc, [site])
        Absent => acc
      }
    }
  )
}

fn scaffold_disposition_site_count_live() -> Int {
  length(xs: derived_scaffold_disposition_sites())
}

fn scaffold_site_by_qualified_name(
  qn: String,
  sites: List<ScaffoldDispositionSite>
) -> ScaffoldDispositionSite? {
  fold(
    sites,
    init: Absent,
    f: fn(acc, site) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match site.qualified_name == qn {
            true => Present { value: site }
            false => Absent
          }
      }
    }
  )
}

fn pilot_domain_limit() -> Int { 15 }

fn site_scaffold_ref(site: ScaffoldDispositionSite) -> DeclarationRef {
  DeclarationRef {
    module_path: site.carrier_module,
    decl_name: site.carrier_decl,
    field: WholeDeclaration,
  }
}

fn is_pilot_domain_site(site: ScaffoldDispositionSite) -> Bool {
  site.rel_path.starts_with(prefix: "dag/gunbc/")
}

fn list_prefix_sites(
  sites: List<ScaffoldDispositionSite>,
  limit: Int
) -> List<ScaffoldDispositionSite> {
  fold(sites, init: [], f: fn(acc, site) {
    if length(xs: acc) < limit {
      append(acc, [site])
    } else {
      acc
    }
  })
}

fn pilot_scaffold_sites() -> List<ScaffoldDispositionSite> {
  list_prefix_sites(
    sites: derived_scaffold_disposition_sites() |> filter(s => is_pilot_domain_site(site: s)),
    limit: pilot_domain_limit()
  )
}

fn carrier_path_matches_obligation_hints(
  carrier_path: String,
  site: ScaffoldDispositionSite
) -> Bool {
  (carrier_path == site.rel_path)
    || string_contains(s: carrier_path, pattern: site.bind.module_path)
    || string_contains(s: carrier_path, pattern: site.bind.decl_name)
    || string_contains(s: carrier_path, pattern: site.carrier_module)
}

fn obligation_candidates_for_site(site: ScaffoldDispositionSite) -> List<RoadmapNode> {
  declared_roadmap_nodes()
    |> filter(n => any(
      xs: n.carriers,
      predicate: fn(p) { carrier_path_matches_obligation_hints(carrier_path: p.path, site: site) }
    ))
}

fn admit_obligation_identity(identity: RoadmapNodeIdentity) -> ObligationIdentityAdmission {
  let id = identity as String
  let hits = roadmap_identity_registry() |> filter(r => record_identity(r: r) == id)
  if count(hits) == 0 {
    ObligationIdentityUnknown { identity: identity }
  } else {
    if count(hits) > 1 {
      ObligationIdentityAmbiguous { identity: identity, matches: count(hits) }
    } else {
      match hits |> first {
        Present { value: ActiveIdentity { identity: active_id, slug: _ } } =>
          ObligationActive { identity: active_id },
        Present { value: TombstonedIdentity { identity: tomb_id, former_slug: _, superseded_by } } =>
          match superseded_by {
            Present { value: succ } => ObligationSuperseded { identity: tomb_id, superseded_by: succ },
            Absent => ObligationTombstonedWithoutSuccessor { identity: tomb_id },
          },
        Absent => ObligationIdentityUnknown { identity: identity },
      }
    }
  }
}

fn derived_binding_for_site(site: ScaffoldDispositionSite) -> List<ScaffoldRetirementBinding> {
  let candidates = obligation_candidates_for_site(site: site)
  if count(candidates) == 1 {
    match candidates |> first {
      Present { value: node } =>
        [ScaffoldRetirementBinding {
          scaffold: site_scaffold_ref(site: site),
          obligation: node.identity,
        }]
      Absent => []
    }
  } else {
    []
  }
}

fn derived_exclusion_for_site(site: ScaffoldDispositionSite) -> List<ScaffoldRetirementExclusion> {
  if !is_pilot_domain_site(site: site) {
    [ScaffoldRetirementExclusion {
      scaffold: site_scaffold_ref(site: site),
      reason: OutsidePilotDomain { rel_path: site.rel_path },
    }]
  } else {
    let candidates = obligation_candidates_for_site(site: site)
    if count(candidates) == 0 {
      [ScaffoldRetirementExclusion {
        scaffold: site_scaffold_ref(site: site),
        reason: NoHonestObligationOwner {
          bind: site.bind,
          candidate_count: 0,
        },
      }]
    } else {
      if count(candidates) > 1 {
        [ScaffoldRetirementExclusion {
          scaffold: site_scaffold_ref(site: site),
          reason: AmbiguousObligationOwners {
            bind: site.bind,
            candidate_count: count(candidates),
          },
        }]
      } else {
        []
      }
    }
  }
}

fn pilot_scaffold_retirement_bindings() -> List<ScaffoldRetirementBinding> {
  fold(
    xs: pilot_scaffold_sites(),
    init: [],
    f: fn(acc, site) { concat(acc, derived_binding_for_site(site: site)) }
  )
}

fn pilot_scaffold_retirement_exclusions() -> List<ScaffoldRetirementExclusion> {
  fold(
    xs: pilot_scaffold_sites(),
    init: [],
    f: fn(acc, site) { concat(acc, derived_exclusion_for_site(site: site)) }
  )
}

fn pilot_exclusion_count_no_honest_obligation_owner() -> Int {
  count_where(
    xs: pilot_scaffold_retirement_exclusions(),
    predicate: fn(e) {
      match e.reason {
        NoHonestObligationOwner { bind: _, candidate_count: _ } => true
        _ => false
      }
    }
  )
}

fn pilot_exclusion_count_ambiguous_obligation_owners() -> Int {
  count_where(
    xs: pilot_scaffold_retirement_exclusions(),
    predicate: fn(e) {
      match e.reason {
        AmbiguousObligationOwners { bind: _, candidate_count: _ } => true
        _ => false
      }
    }
  )
}

fn decl_fact_carrier_module(fact: DeclFact) -> String {
  let suffix = concat(".", fact.name)
  if fact.qualified_name.ends_with(suffix: suffix) {
    fact.qualified_name.substring(
      start: 0,
      end: fact.qualified_name.length() - suffix.length()
    )
  } else {
    fact.qualified_name
  }
}

fn decl_fact_whole_declaration_ref(fact: DeclFact) -> DeclarationRef {
  DeclarationRef {
    module_path: decl_fact_carrier_module(fact: fact),
    decl_name: fact.name,
    field: WholeDeclaration,
  }
}

fn corpus_present_declaration_refs() -> List<DeclarationRef> {
  decl_facts(pool_roots: witness_layer_roots)
    |> map(f => decl_fact_whole_declaration_ref(fact: f))
}

fn site_disposition_for_redundancy(site: ScaffoldDispositionSite) -> Disposition {
  Scaffold {
    dissolves_to: SingleAuthority,
    bind: site.bind,
  }
}

fn pilot_fired_dissolution_violation_count() -> Int {
  let dispositions = pilot_scaffold_sites() |> map(s => site_disposition_for_redundancy(site: s))
  disposition_redundancy_violation_count(
    dispositions: dispositions,
    present: corpus_present_declaration_refs()
  )
}

fn roadmap_nodes_for_identity(identity: RoadmapNodeIdentity) -> List<RoadmapNode> {
  declared_roadmap_nodes() |> filter(n => (n.identity as String) == (identity as String))
}

fn binding_obligation_join_is_unique(binding: ScaffoldRetirementBinding) -> Bool {
  count(roadmap_nodes_for_identity(identity: binding.obligation)) == 1
}

fn pilot_bindings_have_unique_obligation_join() -> Bool {
  all(
    pilot_scaffold_retirement_bindings(),
    b => binding_obligation_join_is_unique(binding: b)
  )
}

fn pilot_site_has_binding_or_exclusion(site: ScaffoldDispositionSite) -> Bool {
  let scaffold = site_scaffold_ref(site: site)
  let bound = any(
    pilot_scaffold_retirement_bindings(),
    b => decl_ref_eq(a: b.scaffold, b: scaffold)
  )
  let excluded = any(
    pilot_scaffold_retirement_exclusions(),
    e => decl_ref_eq(a: e.scaffold, b: scaffold)
  )
  (bound && !excluded) || (!bound && excluded)
}

fn pilot_population_fully_accounted() -> Bool {
  all(pilot_scaffold_sites(), s => pilot_site_has_binding_or_exclusion(site: s))
}

fn tombstoned_binding_refuses_without_successor(binding: ScaffoldRetirementBinding) -> Bool {
  match admit_obligation_identity(identity: binding.obligation) {
    ObligationTombstonedWithoutSuccessor { identity: _ } => false
    ObligationSuperseded { identity: _, superseded_by: _ } => true
    ObligationActive { identity: _ } => true
    ObligationIdentityUnknown { identity: _ } => false
    ObligationIdentityAmbiguous { identity: _, matches: _ } => false
  }
}

fn pilot_tombstoned_obligations_admit_or_refuse() -> Bool {
  all(
    pilot_scaffold_retirement_bindings(),
    b => tombstoned_binding_refuses_without_successor(binding: b)
  )
}
