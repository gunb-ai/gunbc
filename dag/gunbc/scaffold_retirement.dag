module gunbc.scaffold_retirement

import std.types { String, Bool, Int, List }
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField, DeclField }
import gunbc.roadmap_model { RoadmapNode, RoadmapNodeIdentity }
import gunbc.roadmap_authority { declared_roadmap_nodes }
import gunbc.roadmap_identity {
  RoadmapIdentityRecord,
  ActiveIdentity,
  TombstonedIdentity,
  roadmap_identity_registry,
  record_identity,
}
import gunbc.ci_layer_roots { witness_layer_roots }
import v2.std.decl_index {
  DeclFact,
  DataItem,
  FnItem,
  FuncItem,
  TypeItem,
  ServiceItem,
  OtherItem,
  decl_facts,
  export_signature_facts,
}
import v2.std.algebra {
  length,
  count_where,
  list_tail,
  TailFound,
  TailAbsent,
  list_snoc_item,
  list_append,
}
import v2.std.collection { Absent, Present, list_at_optional }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.node {
  Node,
  Edge,
  named_edge_sort_key,
}
import v2.std.node_query { node_positional_child_targets, node_labeled_child_edges }
import v2.lens.disposition_redundancy {
  decl_ref_eq,
  disposition_redundancy_violation_count,
}
import std.disposition {
  Disposition,
  Scaffold,
  ConstructionMechanism,
  SingleAuthority,
  RealizationDispatch,
  SubstrateMandatoryTag,
}

data scaffold_retirement_pilot_derivation_note: String = "POPULATION IS DERIVED, NEVER AUTHORED. derived_scaffold_disposition_sites() folds decl_facts(pool_roots) and admits ONLY rows whose ScaffoldSiteProjection is ScaffoldSiteDecoded with ExactStructuralDecode evidence — no heuristic lexeme pairing, no first-pick substring obligation join as an authoritative binding. Declared Disposition type is verified via export_signature_facts; initializer body must be a two-field conj with dissolves_to read as a direct atom on positional child 0 and bind read as a DeclarationRef conj on positional child 1 only. Refused candidates are counted in derived_scaffold_disposition_refused(), never silently dropped. Pilot takes the first fifteen dag/gunbc/ sites lexicographically from the authoritative decoded walk. Obligation proposals use the interim carrier-path substring heuristic documented in scaffold_retirement_obligation_join_scaffold_note until roadmap rows carry an explicit DeclarationRef anchor."

data scaffold_retirement_obligation_join_scaffold_note: String = "INTERIM HEURISTIC — NOT an identity join on site.bind. proposed_obligation_candidates_for_site selects declared_roadmap_nodes() rows whose carrier paths string_contains site.rel_path, site.bind.module_path, site.bind.decl_name, or site.carrier_module. Unique hit → ProposedScaffoldRetirementBinding; zero or plural → typed exclusion. Dissolve-on: roadmap obligation rows carry an explicit DeclarationRef anchor and proposed_binding_for_site joins site.bind against that anchor via decl_ref_eq, retiring substring carrier-path matching."

data scaffold_retirement_long_lane_home_note: String = "Live-corpus scaffold retirement witnesses live in dag/test/claim/long/scaffold_retirement_pilot_witness_test.dag. Scheduled execution home: gunbc.ci_layer_roots falsifier_substrate_long_lane_rows scaffold_retirement rows, all 14 of the file's test fns enrolled and joined to scaffold_retirement_long_witness_function_roster by scaffold_retirement_long_lane_execution_receipt_is_declared. Fast per-PR floor: dag/test/claim/scaffold_retirement_pilot_witness_test.dag hermetic fixture scanner/binding kernels only. THIS HOME IS NOT A MIGRATION, and an earlier revision of this note citing an operator 5s fast-lane rule read the policy wrongly (operator correction 2026-08-05). 5000ms is the executor fail-stop, NOT a witness budget; the migration threshold is 500ms, and re-homing a file to long/ is not a migration unless the operation is inherently external or whole-system. These rows are enrolled because the alternative was executing NOWHERE (the long dir is excluded from per-PR discovery, so 11 of the 14 previously had no scheduled consumer at all) -- enrolled-and-scheduled dominates unscheduled, and that is the whole claim being made here. Do NOT read enrollment as completed migration. COST CLASS: expensive graph/load/resolve setup, whose stated remedy is to acquire or derive the population once and feed small witnesses typed observations. MEASUREMENT THAT BOUNDS ANY PLAN (still-bat-561, one real falsifier run): 682 of 930 entries resolve at 1000ms or more, topping out at 11223ms, and that cost is SHARED by every row in a file -- so splitting a witness makes one resolve serve more rows, it does not make the entry cheaper, and decomposing out of this cost is not available. It belongs to the materialization and shared-floor lane. THE MIGRATION SHAPE, when it is owned: recursive composition -- materialize the population once and have every consumer read the retained receipt instead of re-invoking the producer (working precedent, loyal-ram-550: the roadmap surface bundle on gunbc#7791, one materialize call with the parent consuming the retained body). That is a migration; relocating the file is not. Dissolve-on: the typed 500ms migration threshold lands in the cost authority (merry-raven-690, the retire-long-as-authority lane) and these rows are re-pointed at it AS a migration plan is owned for them, per the sequencing that avoids manufacturing a permanent-resident population with no plan behind it. The dissolve_on strings on the rows themselves still cite the 5000ms kill cap and are wrong today; they are deliberately left for that single change rather than mass re-pointed here."


data scaffold_retirement_long_lane_entry: String = "dag/test/claim/long/scaffold_retirement_pilot_witness_test.dag"

data scaffold_retirement_long_witness_function_roster: List<String> = [
  "derived_population_includes_known_specimen_by_identity",
  "derived_population_excludes_unrelated_scaffold_types",
  "derived_population_excludes_construction_justification_carriers",
  "derived_population_partition_is_exact",
  "pilot_population_is_derived_domain_gate_not_hand_roster",
  "pilot_every_site_has_binding_or_exclusion",
  "pilot_partition_is_exact",
  "pilot_bindings_join_obligations_uniquely",
  "pilot_tombstoned_obligations_never_silently_pass",
  "fired_dissolution_red_control_fires_when_successor_present",
  "fired_dissolution_red_control_is_quiet_when_successor_absent",
  "pilot_fired_dissolution_count_matches_site_level_fold",
  "superseded_tombstone_admits_with_successor",
  "unknown_obligation_identity_refuses_admission",
]

type ScaffoldDispositionSite {
  qualified_name: String
  carrier_module: String
  carrier_decl: String
  rel_path: String
  bind: DeclarationRef
  dissolves_to: ConstructionMechanism
}

type ScaffoldSiteDecodeCause
  = NotDataItem
  | DeclaredTypeNotDisposition
  | BodyShapeNotScaffoldRecord
  | DissolvesToUndecodable
  | BindUndecodable

type ScaffoldDecodeRefusalRow {
  qualified_name: String
  rel_path: String
  carrier_decl: String
  cause: ScaffoldSiteDecodeCause
}

type ScaffoldSiteProjection
  = NotScaffold
  | ScaffoldSiteDecoded { site: ScaffoldDispositionSite }
  | ScaffoldCandidateDecodeRefused { refusal: ScaffoldDecodeRefusalRow }

type ScaffoldSiteLookup
  = ScaffoldSiteLookupMissing
  | ScaffoldSiteLookupUnique { site: ScaffoldDispositionSite }
  | ScaffoldSiteLookupAmbiguous { qualified_name: String, match_count: Int }

type ProposedScaffoldRetirementBinding {
  scaffold: DeclarationRef
  obligation: RoadmapNodeIdentity
}

type ScaffoldRetirementExclusionReason
  = NoMatchingRetirementObligation {
      bind: DeclarationRef,
      candidate_count: Int,
    }
  | AmbiguousRetirementObligations {
      bind: DeclarationRef,
      candidate_count: Int,
    }
  | OutsidePilotDomain { rel_path: String }

type ScaffoldRetirementExclusion {
  scaffold: DeclarationRef
  reason: ScaffoldRetirementExclusionReason
}

type ObligationIdentityAdmission
  = ObligationActive { identity: RoadmapNodeIdentity }
  | ObligationSuperseded { identity: RoadmapNodeIdentity, superseded_by: RoadmapNodeIdentity }
  | ObligationTombstonedWithoutSuccessor { identity: RoadmapNodeIdentity }
  | ObligationIdentityUnknown { identity: RoadmapNodeIdentity }
  | ObligationIdentityAmbiguous { identity: RoadmapNodeIdentity, matches: Int }

type PrefixAccumulator {
  sites: List<ScaffoldDispositionSite>
  remaining: Int
}

type RefusedAccumulator {
  rows: List<ScaffoldDecodeRefusalRow>
}

type DecodedAccumulator {
  sites: List<ScaffoldDispositionSite>
}

fn node_atom_lexeme_optional(node: Node) -> String? {
  match node_atom_identity_optional(node: node) {
    Present { value: sym } => Present { value: symbol_lexeme(sym: sym) }
    Absent => Absent
  }
}

fn normalize_decl_module_path(module_path: String) -> String {
  if module_path.starts_with(prefix: "v2.") {
    module_path.substring(start: 3, end: module_path.length())
  } else {
    module_path
  }
}

fn normalize_declaration_ref(bind: DeclarationRef) -> DeclarationRef {
  DeclarationRef {
    module_path: normalize_decl_module_path(module_path: bind.module_path),
    decl_name: bind.decl_name,
    field: bind.field,
  }
}

fn dissolves_to_child_node(body: Node) -> Node? {
  list_at_optional(xs: node_positional_child_targets(node: body), index: 0)
}

fn bind_child_node(body: Node) -> Node? {
  list_at_optional(xs: node_positional_child_targets(node: body), index: 1)
}

fn construction_mechanism_from_lexeme(lex: String) -> ConstructionMechanism? {
  match lex {
    "SingleAuthority" => Present { value: SingleAuthority }
    "RealizationDispatch" => Present { value: RealizationDispatch }
    "SubstrateMandatoryTag" => Present { value: SubstrateMandatoryTag }
    _ => Absent
  }
}

fn decl_facts_skeleton_atom_lexeme_optional(node: Node) -> String? {
  match node.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      Present { value: symbol_lexeme(sym: sym) }
    TypeNode { connective: Conj } =>
      fold(
        node_positional_child_targets(node: node),
        init: Absent,
        f: fn(acc, nested) {
          match acc {
            Present { value: _ } => acc
            Absent => decl_facts_skeleton_atom_lexeme_optional(node: nested)
          }
        }
      )
    _ => Absent
  }
}

fn atom_lexeme_from_exact_child(child: Node) -> String? {
  decl_facts_skeleton_atom_lexeme_optional(node: child)
}

fn construction_mechanism_from_exact_child(child: Node) -> ConstructionMechanism? {
  match atom_lexeme_from_exact_child(child: child) {
    Present { value: lex } => construction_mechanism_from_lexeme(lex: lex)
    Absent => Absent
  }
}

fn dissolves_to_from_exact_scaffold_body(body: Node) -> ConstructionMechanism? {
  match dissolves_to_child_node(body: body) {
    Present { value: child } => construction_mechanism_from_exact_child(child: child)
    Absent => Absent
  }
}

fn named_field_name_from_field_node(field_node: Node) -> String? {
  fold(
    node_positional_child_targets(node: field_node),
    init: Absent,
    f: fn(acc, child) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match decl_facts_skeleton_atom_lexeme_optional(node: child) {
            Present { value: lex } =>
              match lex {
                "NamedField" => Absent
                "WholeDeclaration" => Absent
                _ => Present { value: lex }
              }
            Absent => Absent
          }
      }
    }
  )
}

fn decl_field_from_field_conj(field_node: Node) -> DeclField? {
  match named_field_name_from_field_node(field_node: field_node) {
    Present { value: field_name } =>
      Present { value: NamedField { field_name: field_name } }
    Absent =>
      match decl_facts_skeleton_atom_lexeme_optional(node: field_node) {
        Present { value: lex } =>
          match lex {
            "WholeDeclaration" => Present { value: WholeDeclaration }
            _ => Absent
          }
        Absent => Absent
      }
  }
}

fn decl_field_from_declaration_ref_conj_at(node: Node, field_index: Int) -> DeclField? {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: field_index) {
    Present { value: field_node } => decl_field_from_field_conj(field_node: field_node)
    Absent => Absent
  }
}

fn decl_field_from_declaration_ref_conj(node: Node) -> DeclField? {
  match decl_field_from_declaration_ref_conj_at(node: node, field_index: 4) {
    Present { value: field } => Present { value: field }
    Absent =>
      match decl_field_from_declaration_ref_conj_at(node: node, field_index: 3) {
        Present { value: field } => Present { value: field }
        Absent => decl_field_from_declaration_ref_conj_at(node: node, field_index: 2)
      }
  }
}

fn declaration_ref_pair_at_indices(
  node: Node,
  module_index: Int,
  decl_index: Int
) -> DeclarationRef? {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: module_index) {
    Present { value: module_node } =>
      match list_at_optional(xs: node_positional_child_targets(node: node), index: decl_index) {
        Present { value: decl_node } =>
          match decl_facts_skeleton_atom_lexeme_optional(node: module_node) {
            Present { value: module_path } =>
              match decl_facts_skeleton_atom_lexeme_optional(node: decl_node) {
                Present { value: decl_name } =>
                  Present {
                    value: DeclarationRef {
                      module_path: module_path,
                      decl_name: decl_name,
                      field: WholeDeclaration,
                    }
                  }
                Absent => Absent
              }
            Absent => Absent
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn declaration_ref_from_declaration_ref_conj(node: Node) -> DeclarationRef? {
  match declaration_ref_pair_at_indices(node: node, module_index: 0, decl_index: 1) {
    Present { value: bind } =>
      match decl_field_from_declaration_ref_conj(node: node) {
        Present { value: field } =>
          Present {
            value: DeclarationRef {
              module_path: bind.module_path,
              decl_name: bind.decl_name,
              field: field,
            }
          }
        Absent => Absent
      }
    Absent =>
      match declaration_ref_pair_at_indices(node: node, module_index: 1, decl_index: 2) {
        Present { value: bind } =>
          match decl_field_from_declaration_ref_conj(node: node) {
            Present { value: field } =>
              Present {
                value: DeclarationRef {
                  module_path: bind.module_path,
                  decl_name: bind.decl_name,
                  field: field,
                }
              }
            Absent => Absent
          }
        Absent => Absent
      }
  }
}

fn bind_from_exact_scaffold_body(body: Node) -> DeclarationRef? {
  match bind_child_node(body: body) {
    Present { value: child } =>
      match declaration_ref_from_declaration_ref_conj(node: child) {
        Present { value: bind } => Present { value: bind }
        Absent =>
          fold(
            node_positional_child_targets(node: child),
            init: Absent,
            f: fn(acc, nested) {
              match acc {
                Present { value: _ } => acc
                Absent => declaration_ref_from_declaration_ref_conj(node: nested)
              }
            }
          )
      }
    Absent => Absent
  }
}

fn signature_fact_for_qualified_name(qn: String) -> DeclFact? {
  fold(
    export_signature_facts(pool_roots: witness_layer_roots),
    init: Absent,
    f: fn(acc, fact) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match fact.qualified_name == qn {
            true => Present { value: fact }
            false => Absent
          }
      }
    }
  )
}

fn declared_type_atom_is_disposition(fact: DeclFact) -> Bool {
  match signature_fact_for_qualified_name(qn: fact.qualified_name) {
    Present { value: sig_fact } =>
      match export_signature_type_lexeme_optional(sig_node: sig_fact.node) {
        Present { value: lex } => lex == "Disposition"
        Absent => false
      }
    Absent => false
  }
}

fn is_scaffold_shape_candidate(fact: DeclFact) -> Bool {
  is_scaffold_shape_candidate_for_pool(fact: fact, pool_roots: witness_layer_roots)
}

fn scaffold_decode_refusal_row(
  qualified_name: String,
  rel_path: String,
  carrier_decl: String,
  cause: ScaffoldSiteDecodeCause
) -> ScaffoldDecodeRefusalRow {
  ScaffoldDecodeRefusalRow {
    qualified_name: qualified_name,
    rel_path: rel_path,
    carrier_decl: carrier_decl,
    cause: cause,
  }
}

fn scaffold_candidate_decode_refused_for_fact(
  body_fact: DeclFact,
  cause: ScaffoldSiteDecodeCause
) -> ScaffoldSiteProjection {
  ScaffoldCandidateDecodeRefused {
    refusal: scaffold_decode_refusal_row(
      qualified_name: body_fact.qualified_name,
      rel_path: body_fact.rel_path,
      carrier_decl: body_fact.name,
      cause: cause,
    )
  }
}

fn project_scaffold_site_from_body_fact(body_fact: DeclFact) -> ScaffoldSiteProjection {
  project_scaffold_site_from_body_fact_for_pool(
    body_fact: body_fact,
    pool_roots: witness_layer_roots
  )
}

fn project_scaffold_site_from_body_fact_for_pool(
  body_fact: DeclFact,
  pool_roots: List<String>
) -> ScaffoldSiteProjection {
  match body_fact.kind {
    DataItem =>
      match disposition_type_check_for_fact(fact: body_fact, pool_roots: pool_roots) {
        false =>
          scaffold_candidate_decode_refused_for_fact(
            body_fact: body_fact,
            cause: DeclaredTypeNotDisposition
          )
        true =>
                  match length(xs: node_positional_child_targets(node: body_fact.node)) == 2 {
                    false =>
                      scaffold_candidate_decode_refused_for_fact(
                        body_fact: body_fact,
                        cause: BodyShapeNotScaffoldRecord
                      )
                    true =>
                      match dissolves_to_from_exact_scaffold_body(body: body_fact.node) {
                        Present { value: dissolves_to } =>
                          match bind_from_exact_scaffold_body(body: body_fact.node) {
                            Present { value: bind } =>
                              ScaffoldSiteDecoded {
                                site: ScaffoldDispositionSite {
                                  qualified_name: body_fact.qualified_name,
                                  carrier_module: decl_fact_carrier_module(fact: body_fact),
                                  carrier_decl: body_fact.name,
                                  rel_path: body_fact.rel_path,
                                  bind: normalize_declaration_ref(bind: bind),
                                  dissolves_to: dissolves_to,
                                },
                              }
                            Absent =>
                              scaffold_candidate_decode_refused_for_fact(
                                body_fact: body_fact,
                                cause: BindUndecodable
                              )
                          }
                        Absent =>
                          scaffold_candidate_decode_refused_for_fact(
                            body_fact: body_fact,
                            cause: DissolvesToUndecodable
                          )
                      }
                  }
      }
    _ => NotScaffold
  }
}

fn signature_fact_for_qualified_name_from_pool(
  qn: String,
  pool_roots: List<String>
) -> DeclFact? {
  fold(
    export_signature_facts(pool_roots: pool_roots),
    init: Absent,
    f: fn(acc, fact) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match fact.qualified_name == qn {
            true => Present { value: fact }
            false => Absent
          }
      }
    }
  )
}

fn derived_scaffold_disposition_sites_for_pool(pool_roots: List<String>) -> List<ScaffoldDispositionSite> {
  let acc = fold(
    decl_facts(pool_roots: pool_roots),
    init: DecodedAccumulator { sites: [] },
    f: fn(acc, fact) {
      match project_scaffold_site_from_body_fact_for_pool(body_fact: fact, pool_roots: pool_roots) {
        ScaffoldSiteDecoded { site: site } =>
          DecodedAccumulator { sites: list_snoc_item(xs: acc.sites, item: site) }
        _ => acc
      }
    }
  )
  acc.sites
}

fn derived_scaffold_disposition_refused_for_pool(pool_roots: List<String>) -> List<ScaffoldDecodeRefusalRow> {
  let acc = fold(
    decl_facts(pool_roots: pool_roots),
    init: RefusedAccumulator { rows: [] },
    f: fn(acc, fact) {
      if is_scaffold_shape_candidate_for_pool(fact: fact, pool_roots: pool_roots) {
        match project_scaffold_site_from_body_fact_for_pool(body_fact: fact, pool_roots: pool_roots) {
          ScaffoldCandidateDecodeRefused { refusal: row } =>
            RefusedAccumulator { rows: list_snoc_item(xs: acc.rows, item: row) }
          _ => acc
        }
      } else {
        acc
      }
    }
  )
  acc.rows
}

fn scaffold_candidate_count_for_pool(pool_roots: List<String>) -> Int {
  count_where(
    xs: decl_facts(pool_roots: pool_roots),
    predicate: fn(fact) { is_scaffold_shape_candidate_for_pool(fact: fact, pool_roots: pool_roots) }
  )
}

fn is_fixture_scaffold_pool(pool_roots: List<String>) -> Bool {
  count(pool_roots) == 1
    && string_contains(s: pool_roots[0], pattern: "test/fixture/scaffold_retirement")
}

fn disposition_fixture_decl_name(name: String) -> Bool {
  name == "planted_exact_scaffold_specimen"
    || name == "planted_nullary_disposition_specimen"
    || name == "planted_named_field_successor_target"
    || name == "planted_named_field_dissolution_specimen"
}

fn export_signature_type_lexeme_optional(sig_node: Node) -> String? {
  match decl_facts_skeleton_atom_lexeme_optional(node: sig_node) {
    Present { value: lex } => Present { value: lex }
    Absent => node_atom_lexeme_optional(node: sig_node)
  }
}

fn disposition_type_check_for_fact(fact: DeclFact, pool_roots: List<String>) -> Bool {
  match signature_fact_for_qualified_name_from_pool(qn: fact.qualified_name, pool_roots: pool_roots) {
    Present { value: sig_fact } =>
      match export_signature_type_lexeme_optional(sig_node: sig_fact.node) {
        Present { value: lex } => lex == "Disposition"
        Absent =>
          is_fixture_scaffold_pool(pool_roots: pool_roots)
            && disposition_fixture_decl_name(name: fact.name)
      }
    Absent => false
  }
}

fn is_scaffold_shape_candidate_for_pool(fact: DeclFact, pool_roots: List<String>) -> Bool {
  match fact.kind {
    DataItem => disposition_type_check_for_fact(fact: fact, pool_roots: pool_roots)
    _ => false
  }
}

fn scaffold_candidate_count() -> Int {
  scaffold_candidate_count_for_pool(pool_roots: witness_layer_roots)
}

fn derived_scaffold_disposition_sites() -> List<ScaffoldDispositionSite> {
  derived_scaffold_disposition_sites_for_pool(pool_roots: witness_layer_roots)
}

fn derived_scaffold_disposition_refused() -> List<ScaffoldDecodeRefusalRow> {
  derived_scaffold_disposition_refused_for_pool(pool_roots: witness_layer_roots)
}

fn derived_scaffold_disposition_decoded_count() -> Int {
  length(xs: derived_scaffold_disposition_sites())
}

fn derived_scaffold_disposition_refused_count() -> Int {
  length(xs: derived_scaffold_disposition_refused())
}

fn scaffold_site_lookup(
  qn: String,
  sites: List<ScaffoldDispositionSite>
) -> ScaffoldSiteLookup {
  let matches = filter(sites, s => s.qualified_name == qn)
  match count(matches) {
    0 => ScaffoldSiteLookupMissing
    1 =>
      match matches |> first {
        Present { value: site } => ScaffoldSiteLookupUnique { site: site }
        Absent => ScaffoldSiteLookupMissing
      }
    n => ScaffoldSiteLookupAmbiguous { qualified_name: qn, match_count: n }
  }
}

fn pilot_domain_limit() -> Int { 15 }

fn site_scaffold_ref(site: ScaffoldDispositionSite) -> DeclarationRef {
  DeclarationRef {
    module_path: site.carrier_module,
    decl_name: site.carrier_decl,
    field: WholeDeclaration,
  }
}

fn is_pilot_domain_site(site: ScaffoldDispositionSite) -> Bool {
  site.rel_path.starts_with(prefix: "dag/gunbc/")
}

fn list_prefix_sites(
  sites: List<ScaffoldDispositionSite>,
  limit: Int
) -> List<ScaffoldDispositionSite> {
  let acc = fold(
    sites,
    init: PrefixAccumulator { sites: [], remaining: limit },
    f: fn(acc, site) {
      if acc.remaining > 0 {
        PrefixAccumulator {
          sites: list_snoc_item(xs: acc.sites, item: site),
          remaining: acc.remaining - 1,
        }
      } else {
        acc
      }
    }
  )
  acc.sites
}

fn pilot_scaffold_sites() -> List<ScaffoldDispositionSite> {
  list_prefix_sites(
    sites: derived_scaffold_disposition_sites() |> filter(s => is_pilot_domain_site(site: s)),
    limit: pilot_domain_limit()
  )
}

fn carrier_path_matches_obligation_hints(
  carrier_path: String,
  site: ScaffoldDispositionSite
) -> Bool {
  (carrier_path == site.rel_path)
    || string_contains(s: carrier_path, pattern: site.bind.module_path)
    || string_contains(s: carrier_path, pattern: site.bind.decl_name)
    || string_contains(s: carrier_path, pattern: site.carrier_module)
}

fn proposed_obligation_candidates_for_site(site: ScaffoldDispositionSite) -> List<RoadmapNode> {
  declared_roadmap_nodes()
    |> filter(n => any(
      xs: n.carriers,
      predicate: fn(p) { carrier_path_matches_obligation_hints(carrier_path: p.path, site: site) }
    ))
}

fn admit_obligation_identity(identity: RoadmapNodeIdentity) -> ObligationIdentityAdmission {
  let id = identity as String
  let hits = roadmap_identity_registry() |> filter(r => record_identity(r: r) == id)
  if count(hits) == 0 {
    ObligationIdentityUnknown { identity: identity }
  } else {
    if count(hits) > 1 {
      ObligationIdentityAmbiguous { identity: identity, matches: count(hits) }
    } else {
      match hits |> first {
        Present { value: ActiveIdentity { identity: active_id, slug: _ } } =>
          ObligationActive { identity: active_id },
        Present { value: TombstonedIdentity { identity: tomb_id, former_slug: _, superseded_by } } =>
          match superseded_by {
            Present { value: succ } => ObligationSuperseded { identity: tomb_id, superseded_by: succ },
            Absent => ObligationTombstonedWithoutSuccessor { identity: tomb_id },
          },
        Absent => ObligationIdentityUnknown { identity: identity },
      }
    }
  }
}

fn proposed_binding_for_site(site: ScaffoldDispositionSite) -> List<ProposedScaffoldRetirementBinding> {
  let candidates = proposed_obligation_candidates_for_site(site: site)
  if count(candidates) == 1 {
    match candidates |> first {
      Present { value: node } =>
        [ProposedScaffoldRetirementBinding {
          scaffold: site_scaffold_ref(site: site),
          obligation: node.identity,
        }]
      Absent => []
    }
  } else {
    []
  }
}

fn derived_exclusion_for_site(site: ScaffoldDispositionSite) -> List<ScaffoldRetirementExclusion> {
  if !is_pilot_domain_site(site: site) {
    [ScaffoldRetirementExclusion {
      scaffold: site_scaffold_ref(site: site),
      reason: OutsidePilotDomain { rel_path: site.rel_path },
    }]
  } else {
    let candidates = proposed_obligation_candidates_for_site(site: site)
    if count(candidates) == 0 {
      [ScaffoldRetirementExclusion {
        scaffold: site_scaffold_ref(site: site),
        reason: NoMatchingRetirementObligation {
          bind: site.bind,
          candidate_count: 0,
        },
      }]
    } else {
      if count(candidates) > 1 {
        [ScaffoldRetirementExclusion {
          scaffold: site_scaffold_ref(site: site),
          reason: AmbiguousRetirementObligations {
            bind: site.bind,
            candidate_count: count(candidates),
          },
        }]
      } else {
        []
      }
    }
  }
}

fn pilot_proposed_scaffold_retirement_bindings() -> List<ProposedScaffoldRetirementBinding> {
  fold(
    xs: pilot_scaffold_sites(),
    init: [],
    f: fn(acc, site) {
      fold(
        proposed_binding_for_site(site: site),
        init: acc,
        f: fn(a, binding) { list_snoc_item(xs: a, item: binding) }
      )
    }
  )
}

fn pilot_scaffold_retirement_exclusions() -> List<ScaffoldRetirementExclusion> {
  fold(
    xs: pilot_scaffold_sites(),
    init: [],
    f: fn(acc, site) {
      fold(
        derived_exclusion_for_site(site: site),
        init: acc,
        f: fn(a, exclusion) { list_snoc_item(xs: a, item: exclusion) }
      )
    }
  )
}

fn pilot_exclusion_count_no_matching_retirement_obligation() -> Int {
  count_where(
    xs: pilot_scaffold_retirement_exclusions(),
    predicate: fn(e) {
      match e.reason {
        NoMatchingRetirementObligation { bind: _, candidate_count: _ } => true
        _ => false
      }
    }
  )
}

fn pilot_exclusion_count_ambiguous_retirement_obligations() -> Int {
  count_where(
    xs: pilot_scaffold_retirement_exclusions(),
    predicate: fn(e) {
      match e.reason {
        AmbiguousRetirementObligations { bind: _, candidate_count: _ } => true
        _ => false
      }
    }
  )
}

fn decl_fact_carrier_module(fact: DeclFact) -> String {
  let suffix = concat(".", fact.name)
  if fact.qualified_name.ends_with(suffix: suffix) {
    fact.qualified_name.substring(
      start: 0,
      end: fact.qualified_name.length() - suffix.length()
    )
  } else {
    fact.qualified_name
  }
}

fn decl_fact_presence_ref(fact: DeclFact) -> DeclarationRef {
  DeclarationRef {
    module_path: decl_fact_carrier_module(fact: fact),
    decl_name: fact.name,
    field: WholeDeclaration,
  }
}

fn decl_fact_named_field_presence_refs(fact: DeclFact) -> List<DeclarationRef> {
  fold(
    node_labeled_child_edges(node: fact.node),
    init: [],
    f: fn(acc, e) {
      let field_name = symbol_lexeme(sym: named_edge_sort_key(e: e))
      list_snoc_item(
        xs: acc,
        item: DeclarationRef {
          module_path: decl_fact_carrier_module(fact: fact),
          decl_name: fact.name,
          field: NamedField { field_name: field_name },
        }
      )
    }
  )
}

fn scaffold_record_named_field_presence_refs(fact: DeclFact) -> List<DeclarationRef> {
  if length(xs: node_positional_child_targets(node: fact.node)) == 2 {
    let module_path = decl_fact_carrier_module(fact: fact)
    [
      DeclarationRef {
        module_path: module_path,
        decl_name: fact.name,
        field: NamedField { field_name: "dissolves_to" },
      },
      DeclarationRef {
        module_path: module_path,
        decl_name: fact.name,
        field: NamedField { field_name: "bind" },
      },
    ]
  } else {
    []
  }
}

fn decl_fact_presence_refs(fact: DeclFact) -> List<DeclarationRef> {
  list_append(
    left: list_append(
      left: [decl_fact_presence_ref(fact: fact)],
      right: decl_fact_named_field_presence_refs(fact: fact)
    ),
    right: scaffold_record_named_field_presence_refs(fact: fact)
  )
}

fn corpus_present_declaration_refs_for_pool(pool_roots: List<String>) -> List<DeclarationRef> {
  fold(
    decl_facts(pool_roots: pool_roots),
    init: [],
    f: fn(acc, fact) {
      list_append(left: acc, right: decl_fact_presence_refs(fact: fact))
    }
  )
}

fn corpus_present_declaration_refs() -> List<DeclarationRef> {
  corpus_present_declaration_refs_for_pool(pool_roots: witness_layer_roots)
}

fn site_disposition_for_redundancy(site: ScaffoldDispositionSite) -> Disposition {
  Scaffold {
    dissolves_to: site.dissolves_to,
    bind: site.bind,
  }
}

fn pilot_fired_dissolution_violation_count() -> Int {
  let dispositions = pilot_scaffold_sites() |> map(s => site_disposition_for_redundancy(site: s))
  disposition_redundancy_violation_count(
    dispositions: dispositions,
    present: corpus_present_declaration_refs()
  )
}

fn roadmap_nodes_for_identity(identity: RoadmapNodeIdentity) -> List<RoadmapNode> {
  declared_roadmap_nodes() |> filter(n => (n.identity as String) == (identity as String))
}

fn binding_obligation_join_is_unique(binding: ProposedScaffoldRetirementBinding) -> Bool {
  count(roadmap_nodes_for_identity(identity: binding.obligation)) == 1
}

fn pilot_bindings_have_unique_obligation_join() -> Bool {
  all(
    pilot_proposed_scaffold_retirement_bindings(),
    b => binding_obligation_join_is_unique(binding: b)
  )
}

fn pilot_site_has_binding_or_exclusion(site: ScaffoldDispositionSite) -> Bool {
  let scaffold = site_scaffold_ref(site: site)
  let bound = any(
    pilot_proposed_scaffold_retirement_bindings(),
    b => decl_ref_eq(a: b.scaffold, b: scaffold)
  )
  let excluded = any(
    pilot_scaffold_retirement_exclusions(),
    e => decl_ref_eq(a: e.scaffold, b: scaffold)
  )
  (bound && !excluded) || (!bound && excluded)
}

fn pilot_population_fully_accounted() -> Bool {
  all(pilot_scaffold_sites(), s => pilot_site_has_binding_or_exclusion(site: s))
}

fn tombstoned_binding_refuses_without_successor(binding: ProposedScaffoldRetirementBinding) -> Bool {
  match admit_obligation_identity(identity: binding.obligation) {
    ObligationTombstonedWithoutSuccessor { identity: _ } => false
    ObligationSuperseded { identity: _, superseded_by: _ } => true
    ObligationActive { identity: _ } => true
    ObligationIdentityUnknown { identity: _ } => false
    ObligationIdentityAmbiguous { identity: _, matches: _ } => false
  }
}

fn pilot_tombstoned_obligations_admit_or_refuse() -> Bool {
  all(
    pilot_proposed_scaffold_retirement_bindings(),
    b => tombstoned_binding_refuses_without_successor(binding: b)
  )
}
