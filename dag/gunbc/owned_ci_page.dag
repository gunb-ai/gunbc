module gunbc.owned_ci_page

import std.types { String }
import std.markup { Fragment, RawNode }
import gunbc.site.markup { txt, el, el_class }
import gunbc.roadmap_page { roadmap_header }
import gunbc.roadmap_style { roadmap_css }

data owned_ci_page_note: String = "Minimal /ci run browser for owned CI v0. Bodies are read from .gunbc/owned-ci/index.json and per-run records written by ci_control_plane; this module renders HTML only."

fn owned_ci_runs_page(body_json: String) -> Fragment {
  el("html", [
    el("head", [
      el("title", [txt("gunbc CI runs")]),
      el("style", [RawNode { content: roadmap_css() }]),
    ]),
    el("body", [
      roadmap_header(page: "Owned CI"),
      el("main", [
        el_class("section", "ci-runs", [
          el("h2", [txt("CI runs")]),
          el("p", [txt("Poll-first owned control plane. Receipts live under .gunbc/owned-ci/.")]),
          el("pre", [txt(body_json)]),
        ]),
      ]),
    ]),
  ])
}

fn owned_ci_run_detail_page(run_id: String, body_json: String) -> Fragment {
  el("html", [
    el("head", [
      el("title", [txt(concat("CI run ", run_id))]),
      el("style", [RawNode { content: roadmap_css() }]),
    ]),
    el("body", [
      roadmap_header(page: "Owned CI"),
      el("main", [
        el_class("section", "ci-run-detail", [
          el("h2", [txt(concat("Run ", run_id))]),
          el("p", [txt("<a href=\"/ci\">all runs</a>")]),
          el("pre", [txt(body_json)]),
        ]),
      ]),
    ]),
  ])
}
