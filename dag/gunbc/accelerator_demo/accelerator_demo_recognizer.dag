module gunbc.accelerator_demo_recognizer


fn recognize_accelerator_program(program: AcceleratorDemoProgram) -> AcceleratorRecognitionOutcome {
  recognize_accelerator_program_with_contract(
    program: program,
    contract: std.numerical_contract.integer_exact_contract(),
    insist_on_fma_fused_kernel: false
  )
}

fn recognize_accelerator_program_with_contract(
  program: AcceleratorDemoProgram,
  contract: NumericalContract,
  insist_on_fma_fused_kernel: Bool
) -> AcceleratorRecognitionOutcome {
  match program {
    PureElementwiseMap { ops: ops } =>
      if gunbc.accelerator_demo_program.pure_elementwise_ops_shape_recognizable(ops: ops) {
        gunbc.accelerator_demo_plan.recognize_with_contract(
          contract: contract,
          insist_on_fma_fused_kernel: insist_on_fma_fused_kernel
        )
      } else {
        gunbc.accelerator_demo_plan.Refused { reason: NotElementwisePure }
      }
    EffectfulElementwiseMap { ops: _ } =>
      gunbc.accelerator_demo_plan.Refused { reason: CarriesEffects }
    DataDependentGatherMap { ops: _ } =>
      gunbc.accelerator_demo_plan.Refused { reason: NotElementwisePure }
  }
}

fn witness_pure_program_structurally_recognized() -> Bool {
  match recognize_accelerator_program(program: relu_mul_add_pure_program) {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => true
    Refused { reason: _ } => false
  }
}

fn witness_effectful_program_structurally_refused() -> Bool {
  match recognize_accelerator_program(program: relu_mul_add_effectful_program) {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      CarriesEffects => true
      NotElementwisePure => false
      FmaContractionViolatesContract => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn witness_gather_program_structurally_refused() -> Bool {
  match recognize_accelerator_program(program: relu_mul_add_gather_program) {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      NotElementwisePure => true
      CarriesEffects => false
      FmaContractionViolatesContract => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}
