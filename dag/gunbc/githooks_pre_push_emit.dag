module gunbc.githooks_pre_push_emit


data pre_push_fmt_only_note: String = "The pre-push hook is fmt-only, restored to CLAUDE.md's documented contract ('pre-push runs cargo fmt') by operator ruling 2026-07-25. It was previously a shim that exec'd `claim_batch --pre-push`, which ran the affected-set witness corpus and would cargo-build claim_batch from inside the push when the binary was missing. That weight bought ZERO enforcement: a git hook is opt-in per clone (core.hooksPath), bypassable with --no-verify, and absent in container worktrees, and gunbc.commit_workflow's own commit_gate_rust_suite_removed_disposition already records it PROVEN ineffective (#6658 landed an unformatted .rs on main and no hook caught it). That is the worst of both worlds by construction — no enforcement, but enough weight to make a legitimately-red mid-lane branch feel unpushable, which is the pressure that converts honest reds into workaround greens (priced receipt: three rounds of hand-import workarounds and one decorative gate on the namespace type-binding lane, 2026-07-25). A check that cannot enforce should at least be instant. CI loses nothing: cargo fmt is a required-path build step (gunbc.ci_spec ci_fmt_gate_note) and the witness corpus is the required `ci` floor, which also stamps the merge-admission receipt. The hook body is DERIVED from commit_gate_roster's GitPrePushHook enrollments via project_local_tidy_checks, so the roster stays the single authority (DESIGN section 3) — re-heavying the hook requires a roster edit that githooks_pre_push_emit_test catches, never a silent drift."

data githooks_pre_push_emit_medium_disposition_note: String = "🟡 dissolve-on: shell emission via the grammar path — the bash medium modeled as GrammarRelationRow rows read forward, superseding these concat-built shell string literals (DESIGN section 4, one grammar read in both directions). Stated on THIS carrier rather than only on the githooks_pre_commit_emit sibling that names the hook-emit family (review 45175): the family trigger was tracked once and the pre-push half inherited it implicitly, which is exactly the implicit-marker shape the medium gate asks not to rely on. The registered Disposition for this surface is gunbc.local_tidy_spec githooks_pre_push_emit_scaffold, a Scaffold binding expected_githooks_pre_push_sh with dissolves_to RealizationDispatch; this row is its in-module statement, not a second authority. A git hook is one of the foreign executors DESIGN's shell-to-intent routing names as rendering through the bounded bash grammar (GHA run:, cron, git hooks) — no gunbc runtime is present at push time — so the concat-built spelling is the declared interim medium for this site, not an unmarked hand-shell expansion. This change edits the failure arm inside that existing surface and adds no new emission site."

// The failure arm is split three ways at the exit status (gunbc.local_tidy_spec local_tidy_fmt_exit_partition_note): 1 is the only status that reports drift, and every other non-zero status names cargo as unrunnable and proposes no remedy that depends on cargo. The unavailable branch passes the drift recipe into local_tidy_fmt_outcome_recipe and provably cannot emit it — the FmtToolUnavailable arm never reads that parameter, so the wall is construction, not a convention about which string to echo here.
fn emit_pre_push_fmt_recipe_echo(outcome_recipe: String) -> String {
  concat("  echo \"[pre-push] ", concat(outcome_recipe, "\" >&2\n  exit 1\nfi\n"))
}

fn emit_local_tidy_line(check: gunbc.commit_workflow.LocalTidyCheck) -> String {
  match check {
    gunbc.commit_workflow.LocalTidyCargoFmtCheck =>
      concat(
        concat(
          "echo \"[pre-push] cargo fmt --all --check\"\nfmt_rc=0\ncargo fmt --all --check || fmt_rc=$?\n",
          concat(
            "if [[ \"$fmt_rc\" == \"1\" ]]; then\n",
            emit_pre_push_fmt_recipe_echo(
              outcome_recipe: gunbc.local_tidy_spec.local_tidy_fmt_outcome_recipe(
                outcome: gunbc.local_tidy_spec.FmtDrift,
                drift_recipe: gunbc.local_tidy_spec.local_tidy_fmt_pre_push_drift_recipe
              )
            )
          )
        ),
        concat(
          "if [[ \"$fmt_rc\" != \"0\" ]]; then\n",
          emit_pre_push_fmt_recipe_echo(
            outcome_recipe: gunbc.local_tidy_spec.local_tidy_fmt_outcome_recipe(
              outcome: gunbc.local_tidy_spec.FmtToolUnavailable {
                program: "cargo",
                cause: "exit status $fmt_rc"
              },
              drift_recipe: gunbc.local_tidy_spec.local_tidy_fmt_pre_push_drift_recipe
            )
          )
        )
      )
    gunbc.commit_workflow.LocalTidyWitnessCheck { entry: _, check_fns: _ } => ""
  }
}

// Namespace-scoped guard skip (measured, run 31334668866 advance_fleet_desired): the
// source-format guards below protect SOURCE pushes. A push whose refspecs are ALL under
// refs/fleet/* is a machine ref-advance carrying no source — the cargo fmt guard has
// nothing to check on it, yet it aborted the desired-ref push on a runner with no cargo
// (line 'cargo: command not found', exit 127, push refused). This preamble reads the
// pushed refspecs from stdin (git's pre-push contract: one "<lref> <lsha> <rref> <rsha>"
// line per ref) and skips the source guards ONLY when at least one ref was seen AND every
// pushed remote ref is under refs/fleet/*. It is NOT a blanket --no-verify (operator/parent
// ruling msg_0e7d195a: the toggle whose only effect is 'proceed as if the refusal had not
// fired' is forbidden): a push touching ANY non-fleet ref runs every guard, and an empty
// or unreadable stdin (ref_count 0) FAILS CLOSED — the guards run, exactly as today.
fn emit_pre_push_fleet_ref_skip_preamble() -> String {
  concat(
    "_gunbc_only_fleet_refs=1\n_gunbc_ref_count=0\n",
    concat(
      "while read -r _lref _lsha _rref _rsha; do\n  _gunbc_ref_count=$((_gunbc_ref_count+1))\n  case \"$_rref\" in\n    refs/fleet/*) : ;;\n    *) _gunbc_only_fleet_refs=0 ;;\n  esac\ndone\n",
      "if [[ \"$_gunbc_ref_count\" -gt 0 && \"$_gunbc_only_fleet_refs\" == \"1\" ]]; then\n  echo \"[pre-push] refs/fleet/* only — skipping source guards (namespace-scoped)\" >&2\n  exit 0\nfi\n"
    )
  )
}

fn emit_pre_push_body() -> String {
  concat(
    emit_pre_push_fleet_ref_skip_preamble(),
    fold(
      gunbc.commit_workflow.project_local_tidy_checks(roster: gunbc.commit_workflow.commit_gate_roster),
      init: "",
      f: fn(acc, check) { concat(acc, emit_local_tidy_line(check: check)) }
    )
  )
}

fn expected_githooks_pre_push_sh() -> String {
  concat(
    "#!/usr/bin/env bash\n# GENERATED by dag/gunbc/githooks_pre_push_emit.dag — DO NOT HAND-EDIT.\n",
    "set -euo pipefail\nROOT=\"", concat(extdeps.git.git_toplevel_shell_subexpr(), "\"\ncd \"$ROOT\"\n"),
    concat(gunbc.githooks_repo_local_git_config_emit.emit_repo_local_git_config_converge_shell(), emit_pre_push_body())
  )
}
