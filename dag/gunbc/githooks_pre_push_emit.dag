module gunbc.githooks_pre_push_emit


fn emit_glob_case_arms(globs: List<String>) -> String {
  fold(globs, init: "", f: fn(acc, g) {
    concat(acc, concat("\n    ", concat(g, "*) return 0 ;;")))
  })
}

fn emit_freshness_path_fn(label: String, globs: List<String>) -> String {
  concat(
    concat(label, "_path() {\n  case \"$1\" in"),
    concat(emit_glob_case_arms(globs: globs), "\n  esac\n  return 1\n}\n")
  )
}

fn emit_ensure_bins() -> String {
  concat(
    "ensure_bins() {\n  if [[ -x \"$ROOT/target/release/claim_batch\" ]]; then\n    CLAIM_BATCH=\"$ROOT/target/release/claim_batch\"\n  elif [[ -x \"$ROOT/target/debug/claim_batch\" ]]; then\n    CLAIM_BATCH=\"$ROOT/target/debug/claim_batch\"\n  else\n    echo \"[pre-push] claim_batch not built; compiling debug (one-time)...\"\n    (cd \"$ROOT\" && CTRL_BUILD_WRAP_CARGO=0 cargo build -p v1-compiler --bin claim_batch)\n    CLAIM_BATCH=\"$ROOT/target/debug/claim_batch\"\n  fi\n}\n",
    "ensure_bins\nexec \"$CLAIM_BATCH\" --pre-push\n"
  )
}

fn expected_githooks_pre_push_sh() -> String {
  concat(
    "#!/usr/bin/env bash\n# GENERATED by dag/gunbc/githooks_pre_push_emit.dag — DO NOT HAND-EDIT.\n",
    "set -euo pipefail\nROOT=\"", concat(git_toplevel_shell_subexpr(), "\"\ncd \"$ROOT\"\n"),
    emit_ensure_bins()
  )
}
