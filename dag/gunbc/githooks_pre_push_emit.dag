module gunbc.githooks_pre_push_emit

import extdeps.git { git_toplevel_shell_subexpr }
import gunbc.commit_workflow {
  commit_gate_roster,
  project_local_tidy_checks,
  LocalTidyCheck,
  LocalTidyWitnessCheck,
  LocalTidyCargoFmtCheck,
}
import gunbc.local_tidy_spec {
  FmtDrift,
  FmtToolUnavailable,
  local_tidy_fmt_outcome_recipe,
  local_tidy_fmt_pre_push_drift_recipe,
}

data pre_push_fmt_only_note: String = "The pre-push hook is fmt-only, restored to CLAUDE.md's documented contract ('pre-push runs cargo fmt') by operator ruling 2026-07-25. It was previously a shim that exec'd `claim_batch --pre-push`, which ran the affected-set witness corpus and would cargo-build claim_batch from inside the push when the binary was missing. That weight bought ZERO enforcement: a git hook is opt-in per clone (core.hooksPath), bypassable with --no-verify, and absent in container worktrees, and gunbc.commit_workflow's own commit_gate_rust_suite_removed_disposition already records it PROVEN ineffective (#6658 landed an unformatted .rs on main and no hook caught it). That is the worst of both worlds by construction — no enforcement, but enough weight to make a legitimately-red mid-lane branch feel unpushable, which is the pressure that converts honest reds into workaround greens (priced receipt: three rounds of hand-import workarounds and one decorative gate on the namespace type-binding lane, 2026-07-25). A check that cannot enforce should at least be instant. CI loses nothing: cargo fmt is a required-path build step (gunbc.ci_spec ci_fmt_gate_note) and the witness corpus is the required `ci` floor, which also stamps the merge-admission receipt. The hook body is DERIVED from commit_gate_roster's GitPrePushHook enrollments via project_local_tidy_checks, so the roster stays the single authority (DESIGN section 3) — re-heavying the hook requires a roster edit that githooks_pre_push_emit_test catches, never a silent drift."

data pre_push_fmt_outcome_split_note: String = "The failure arm is split three ways at the exit status (gunbc.local_tidy_spec local_tidy_fmt_exit_partition_note): 1 is the only status that reports drift, and every other non-zero status names cargo as unrunnable and proposes no remedy that depends on cargo. The unavailable branch passes the drift recipe into local_tidy_fmt_outcome_recipe and provably cannot emit it — the FmtToolUnavailable arm never reads that parameter, so the wall is construction, not a convention about which string to echo here."

fn emit_pre_push_fmt_recipe_echo(outcome_recipe: String) -> String {
  concat("  echo \"[pre-push] ", concat(outcome_recipe, "\" >&2\n  exit 1\nfi\n"))
}

fn emit_local_tidy_line(check: LocalTidyCheck) -> String {
  match check {
    LocalTidyCargoFmtCheck =>
      concat(
        concat(
          "echo \"[pre-push] cargo fmt --all --check\"\nfmt_rc=0\ncargo fmt --all --check || fmt_rc=$?\n",
          concat(
            "if [[ \"$fmt_rc\" == \"1\" ]]; then\n",
            emit_pre_push_fmt_recipe_echo(
              outcome_recipe: local_tidy_fmt_outcome_recipe(
                outcome: FmtDrift,
                drift_recipe: local_tidy_fmt_pre_push_drift_recipe
              )
            )
          )
        ),
        concat(
          "if [[ \"$fmt_rc\" != \"0\" ]]; then\n",
          emit_pre_push_fmt_recipe_echo(
            outcome_recipe: local_tidy_fmt_outcome_recipe(
              outcome: FmtToolUnavailable {
                program: "cargo",
                cause: "exit status $fmt_rc"
              },
              drift_recipe: local_tidy_fmt_pre_push_drift_recipe
            )
          )
        )
      )
    LocalTidyWitnessCheck { entry: _, check_fns: _ } => ""
  }
}

fn emit_pre_push_body() -> String {
  fold(
    project_local_tidy_checks(roster: commit_gate_roster),
    init: "",
    f: fn(acc, check) { concat(acc, emit_local_tidy_line(check: check)) }
  )
}

fn expected_githooks_pre_push_sh() -> String {
  concat(
    "#!/usr/bin/env bash\n# GENERATED by dag/gunbc/githooks_pre_push_emit.dag — DO NOT HAND-EDIT.\n",
    "set -euo pipefail\nROOT=\"", concat(git_toplevel_shell_subexpr(), "\"\ncd \"$ROOT\"\n"),
    emit_pre_push_body()
  )
}
