module gunbc.host_compile_pool

import std.types { String, NonEmptyStr, Bool }
import std.measure { ByteSize, byte_size_count }
import std.disposition { Disposition, SingleAuthority }
import gunbc.build_cache_instance { CgroupMemoryLimits, EndpointObservationUnavailableReason, unavailable_reason_detail }
import gunbc.fleet_host_budget {
  CompilePoolPlacement, CompilePoolSliceDeclared, CompilePoolInRunnerSlots,
  CompilePoolResolution, CompilePoolDerived, CompilePoolUnresolved,
}
import gunbc.runner_activation { HostCompilePoolReady }
import product.placement_supply { HostIdentity }

data host_compile_pool_scope_disposition: Disposition = SingleAuthority

data host_compile_pool_producer_note: String = "THE PRODUCER FOR HostCompilePoolReady, AND DELIBERATELY NOT A SECOND COMPILE-POOL MODEL. Everything about how large the pool is and where compile RSS is charged already has an authority: gunbc.fleet_host_budget owns CompilePoolPlacement and derives the size through compile_pool_bytes_for from extdeps.jobserver's jobserver_build_pool_bytes, which is the same cited knob that bounds build concurrency. Minting a HostCompilePool record with its own memory_high, memory_max and token_count fields beside that would fork the sizing authority and give a host two answers for how big its pool is — the DESIGN section 3 nickname defect, at the carrier that decides whether a runner may take work.\n\nSo this module adds no sizing and no topology. It adds exactly the missing half: gunbc.runner_activation's HostCompilePoolReady had no producer, so every construction of it in the tree was hand-authored, which is precisely the forgeable-receipt residual that carrier's own note names. derive_host_compile_pool_ready is the one derivation, taking the declared topology and a host observation and returning the receipt.\n\nWHAT IT ANSWERS TODAY, stated so this is not read as a description of a working fleet: gunbc_compile_pool_placement is CompilePoolInRunnerSlots, so the derivation returns not-ready for EVERY host, and activation therefore refuses fleet-wide. That is the correct answer, not a gap in this module — no observed host has the managed slice, and the 2026-08-01 placement receipt found every CI cache endpoint owned by a runner-slot process. The receipt going green is gated on the same flip fleet_host_budget's dissolution trigger already names."

type CompilePoolObservation
  = CompilePoolSliceObserved { slice_unit: NonEmptyStr, limits: CgroupMemoryLimits }
  | CompilePoolSliceAbsent { slice_unit: NonEmptyStr }
  | CompilePoolObservationUnavailable { reason: EndpointObservationUnavailableReason }

type CompilePoolNotReadyReason
  = PoolNotDeclaredInTopology { detail: NonEmptyStr }
  | PoolSizingUnresolved { detail: NonEmptyStr }
  | PoolSliceAbsentOnHost { slice_unit: NonEmptyStr }
  | PoolObservationUnavailable { detail: NonEmptyStr }
  | PoolSliceNamedDoesNotMatchIntent { declared: NonEmptyStr, observed: NonEmptyStr }
  | PoolSliceCannotHoldDerivedSize { required: ByteSize, observed_ceiling: ByteSize }

data pool_slice_undersized_note: String = "AN OBSERVED SLICE THAT CANNOT HOLD THE DERIVED POOL IS NOT READY, AND THE FIRST VERSION OF THIS DERIVATION SAID IT WAS (review 46655). It matched CompilePoolSliceObserved and bound `limits: _`, discarding the observed cgroup ceilings, then reported CompilePoolReady carrying the size derived from the JOBSERVER — so the receipt asserted a sized pool on the strength of a number nobody had compared to the host. A slice observed with a zero memory.max was declared ready against a nonzero requirement.\n\nThat is fabricated readiness rather than a missing check, and the distinction matters for where the fix goes: the observation was already in hand and was thrown away, so this is not a gap awaiting a producer. It is the fail-closed rule inverted at the one carrier whose entire job is to decide whether compiles have a bounded parent, and the consequence on a real host is the exact defect the lane exists to close -- an unbounded or wrongly-bounded ceiling parenting every cache-miss compiler, which is what srv1 has been doing under retired slot srv1-10.\n\nThe comparison is against memory_max rather than memory_high because max is the ceiling that actually bounds the cgroup; high is a throttling watermark the kernel allows to be exceeded, so a pool sized against high would admit a slice whose hard limit is below the compiles it is meant to hold.\n\nThe defect was DEMONSTRATED BY THIS MODULE'S OWN FIXTURE and that is worth recording rather than quietly deleting: witness_a_declared_and_observed_slice_is_ready built its observation with all-zero limits and passed, so the acceptance set was certifying the hole. The fixture now carries a ceiling that can hold the derived size, and a sibling witness pins the undersized case."


data pool_not_declared_is_not_pool_absent_note: String = "THE TWO NOT-READY REASONS THAT LOOK ALIKE AND ARE NOT. PoolNotDeclaredInTopology means gunbc.fleet_host_budget's placement row still says CompilePoolInRunnerSlots — nobody has decided this fleet HAS a managed pool, so there is nothing to look for on the host and an observation would be meaningless. PoolSliceAbsentOnHost means the topology declares one and this particular host does not have it — a convergence gap on a decided intent. Their remedies are different and so are their owners: the first is a fleet-wide topology change that must shrink runner_pool in the same motion to keep the host allocation conserving, the second is provisioning one host. Collapsing them into a single not-ready would make the fleet-wide decision look like a per-host chore, which is the reading that gets it done four times by hand instead of once in the model."

type CompilePoolReadiness
  = CompilePoolReady { slice_unit: NonEmptyStr, sized_bytes: ByteSize }
  | CompilePoolNotReady { reason: CompilePoolNotReadyReason }

fn derive_compile_pool_readiness(
  placement: CompilePoolPlacement,
  sizing: CompilePoolResolution,
  observed: CompilePoolObservation,
) -> CompilePoolReadiness {
  match placement {
    CompilePoolInRunnerSlots =>
      CompilePoolNotReady {
        reason: PoolNotDeclaredInTopology {
          detail: "gunbc_compile_pool_placement is CompilePoolInRunnerSlots: no managed compile-pool slice is declared for this fleet, so compile RSS is charged to whichever cgroup the cache server sits in and there is no pool to observe" as NonEmptyStr,
        },
      }
    CompilePoolSliceDeclared { slice_unit: declared } =>
      match observed {
        CompilePoolObservationUnavailable { reason: r } =>
          CompilePoolNotReady {
            reason: PoolObservationUnavailable { detail: unavailable_reason_detail(reason: r) },
          }
        CompilePoolSliceAbsent { slice_unit: s } =>
          CompilePoolNotReady { reason: PoolSliceAbsentOnHost { slice_unit: s } }
        CompilePoolSliceObserved { slice_unit: obs, limits: lim } =>
          match obs == (declared as NonEmptyStr) {
            false =>
              CompilePoolNotReady {
                reason: PoolSliceNamedDoesNotMatchIntent {
                  declared: declared as NonEmptyStr,
                  observed: obs,
                },
              }
            true =>
              match sizing {
                CompilePoolUnresolved { reason: sr } =>
                  CompilePoolNotReady {
                    reason: PoolSizingUnresolved { detail: sr as NonEmptyStr },
                  }
                CompilePoolDerived { bytes: b } =>
                  match byte_size_count(b: lim.memory_max) >= byte_size_count(b: b) {
                    false =>
                      CompilePoolNotReady {
                        reason: PoolSliceCannotHoldDerivedSize {
                          required: b,
                          observed_ceiling: lim.memory_max,
                        },
                      }
                    true => CompilePoolReady { slice_unit: obs, sized_bytes: b }
                  }
              }
          }
      }
  }
}

// SIZING IS CHECKED LAST, AFTER THE SLICE IS CONFIRMED PRESENT AND CORRECTLY NAMED, and the order is load-bearing rather than stylistic. An unresolved size means the cited jobserver knobs could not be read; a missing slice means the host has no pool at all. Reporting the sizing failure first would send an operator to look at installer configuration on a host that has no slice to size, which is a located diagnostic pointing at the wrong location — the same defect toolchain_ensure_reconcile_located_note records from the build-cache verdict fold. The most structural fact refuses first.
fn compile_pool_ready_receipt(readiness: CompilePoolReadiness, intended_slice: NonEmptyStr, host: HostIdentity) -> HostCompilePoolReady {
  match readiness {
    CompilePoolReady { slice_unit: s, sized_bytes: _ } =>
      HostCompilePoolReady { host: host, slice_unit: s, pool_declared: true, pool_observed: true }
    CompilePoolNotReady { reason: r } =>
      HostCompilePoolReady {
        host: host,
        slice_unit: intended_slice,
        pool_declared: pool_is_declared(reason: r),
        pool_observed: false,
      }
  }
}

fn pool_is_declared(reason: CompilePoolNotReadyReason) -> Bool {
  match reason {
    PoolNotDeclaredInTopology { detail: _ } => false
    PoolSizingUnresolved { detail: _ } => true
    PoolSliceAbsentOnHost { slice_unit: _ } => true
    PoolObservationUnavailable { detail: _ } => true
    PoolSliceNamedDoesNotMatchIntent { declared: _, observed: _ } => true
    PoolSliceCannotHoldDerivedSize { required: _, observed_ceiling: _ } => true
  }
}

data receipt_projection_is_lossy_note: String = "THE RECEIPT IS A LOSSY PROJECTION OF THE READINESS, AND THAT IS THE HONEST DIRECTION FOR THE LOSS. HostCompilePoolReady carries two Bools because that is the shape gunbc.runner_activation reviewed and consumes; CompilePoolReadiness carries the located reason. Projecting readiness DOWN to the receipt discards the reason, which is acceptable because the receipt's only job is to gate, and every not-ready projection sets pool_observed false so no not-ready state can produce an activating receipt. Projecting the other way would not be acceptable and is not offered: there is no fn from a receipt back to a readiness, because the Bools cannot reconstruct which of the five reasons applied, and a function that guessed would fabricate a located diagnostic.\n\nThis is the interim shape, not the resting one. The dissolve-on is the one runner_activation's own note already declares: when each *_verified flag becomes a typed observed-vs-intended pair, this projection stops discarding the reason and CompilePoolReadiness travels into the receipt directly. Until then the derivation existing at all is the improvement — before it, every HostCompilePoolReady in the tree was hand-written."

fn receipt_admits_pool(receipt: HostCompilePoolReady) -> Bool {
  receipt.pool_declared && receipt.pool_observed
}

fn derive_host_compile_pool_ready(
  placement: CompilePoolPlacement,
  sizing: CompilePoolResolution,
  observed: CompilePoolObservation,
  intended_slice: NonEmptyStr,
  host: HostIdentity,
) -> HostCompilePoolReady {
  compile_pool_ready_receipt(
    readiness: derive_compile_pool_readiness(
      placement: placement,
      sizing: sizing,
      observed: observed,
    ),
    intended_slice: intended_slice,
    host: host,
  )
}
