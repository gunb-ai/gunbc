module gunbc.specification_citation_read_provenance

import std.integer { Int }
import std.types { NonEmptyStr, String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.publication { SpecificationDocumentDate }

data specification_citation_read_provenance_law: String = "OBSERVATIONS PRODUCED BY THIS REPOSITORY, NOT FACTS OWNED BY THE OBSERVED UPSTREAM (DESIGN section 3). Each arm records what gunbc did on a particular day against a cited locator — a refused fetch, a mirror ingested at a capture date, text supplied by a peer session or the operator. Whether the publisher published the document publicly lives on the upstream document module as extdeps.publication.DocumentPublicationStatus; the two axes are independent (Mt. Mitchell is publicly published under OWFa 1.0 while our publisher fetch was refused)."

type SpecificationCitationReadProvenance
  = DocumentLocatorFetchRefused { http_status: Int, detail: NonEmptyStr }
  | DocumentLocatorFetchedButTextUnread { http_status: Int, detail: NonEmptyStr }
  | DatedPublisherLocatorMirrorTextIngested {
      mirror: ExternalAuthority,
      capture_date: SpecificationDocumentDate,
      peer_session: NonEmptyStr,
      detail: NonEmptyStr,
    }
  | PeerSessionPdfTextIngested { peer_session: NonEmptyStr, detail: NonEmptyStr }
  | OperatorSuppliedDocumentText {}
