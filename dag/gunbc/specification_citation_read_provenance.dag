module gunbc.specification_citation_read_provenance

import std.integer { Int }
import std.measure { ByteSize, byte_size }
import std.types { NonEmptyStr, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority }
import extdeps.publication { SpecificationDocumentDate }
import extdeps.ocp.mt_mitchell.subject { internet_archive_mt_mitchell_capture_authority }
import extdeps.ocp.mt_jade.subject { internet_archive_mt_jade_capture_authority }

// OBSERVATIONS PRODUCED BY THIS REPOSITORY, NOT FACTS OWNED BY THE OBSERVED UPSTREAM (DESIGN
// section 3). Each receipt names the upstream declaration it is about and records what gunbc did on
// a particular day against a cited locator. WHETHER THE PUBLISHER PUBLISHED THE DOCUMENT PUBLICLY
// IS A SEPARATE UPSTREAM AXIS: DocumentPublicationStatus is an extdeps.publication fact re-landed
// by #8260; status values live on document modules; the rule mapping status to whether gunbc may
// carry facts lives in gunbc.upstream_document_carriage. OCP subject anchors in this lane carry
// licence terms on OcpSpecificationLicense instead. The two axes stay independent — a document may
// be publicly published under OWFa 1.0 while our publisher fetch was refused.

// THE ARMS DIFFER BY WHO OBTAINED THE TEXT, which is the fact that decays differently: a peer
// session's decode, a dated mirror's capture and an operator hand-off each carry a different reason
// the bytes might not be what the publisher serves today. DocumentLocatorFetchedAndTextIngested is
// this repository fetching the live publisher locator itself and decoding it, so it carries the
// response status, the byte count and the content digest - the three facts that let a later reader
// re-run the fetch and tell whether they got the same artifact. It was added because the Mt. Collins
// receipts had no honest arm: the brief's receipt claimed the text was UNREAD while
// extdeps.ampere.mt_collins_product_brief.platform models rows read from it (review 5084368000).
type SpecificationCitationReadProvenance
  = DocumentLocatorFetchRefused { http_status: Int, detail: NonEmptyStr }
  | DocumentLocatorFetchedButTextUnread { http_status: Int, detail: NonEmptyStr }
  | DatedPublisherLocatorMirrorTextIngested {
      mirror: ExternalAuthority,
      capture_date: SpecificationDocumentDate,
      peer_session: NonEmptyStr,
      detail: NonEmptyStr,
    }
  | PeerSessionPdfTextIngested { peer_session: NonEmptyStr, detail: NonEmptyStr }
  | DocumentLocatorFetchedAndTextIngested {
      http_status: Int,
      byte_count: ByteSize,
      content_digest: NonEmptyStr,
      detail: NonEmptyStr,
    }
  | OperatorSuppliedDocumentText {}

type SpecificationCitationReadReceipt {
  subject: DeclarationRef
  provenance: SpecificationCitationReadProvenance
}

data mt_jade_reference_platform_subject_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.ocp.mt_jade.subject",
  decl_name: "mt_jade_reference_platform",
  field: WholeDeclaration,
}

data mt_mitchell_reference_platform_subject_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.ocp.mt_mitchell.subject",
  decl_name: "mt_mitchell_reference_platform",
  field: WholeDeclaration,
}

data altra_platform_hw_design_specification_subject_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.cpu.ampere_altra_platform_hw_design.subject",
  decl_name: "altra_platform_hw_design_specification",
  field: WholeDeclaration,
}

data mt_collins_public_product_brief_subject_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.ampere.mt_collins_product_brief.subject",
  decl_name: "mt_collins_public_product_brief",
  field: WholeDeclaration,
}

data mt_collins_getting_started_guide_subject_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.ampere.mt_collins_getting_started_guide.subject",
  decl_name: "mt_collins_getting_started_guide",
  field: WholeDeclaration,
}

data mt_jade_publisher_citation_read_receipt: SpecificationCitationReadReceipt = SpecificationCitationReadReceipt {
  subject: mt_jade_reference_platform_subject_ref,
  provenance: DocumentLocatorFetchRefused {
    http_status: 403,
    detail: "unauthenticated fetch of the OCP publisher document locator returned 403; the publisher copy remains unread in this repository",
  },
}

data mt_jade_ingested_citation_read_receipt: SpecificationCitationReadReceipt = SpecificationCitationReadReceipt {
  subject: mt_jade_reference_platform_subject_ref,
  provenance: OperatorSuppliedDocumentText {},
}

// A SECOND, INDEPENDENT READ OF THE SAME DOCUMENT, ADDED RATHER THAN REPLACING THE OPERATOR
// HAND-OFF ABOVE. The receipts answer different questions - one says how the platform rows got
// their text, the other says how the Table 3 rows got theirs - and collapsing them would erase the
// only cross-check either one has. THE CROSS-CHECK IS WHAT MAKES THIS WORTH RECORDING: the capture
// reproduces the facts the operator-supplied read already grounded (the 428 by 479.36 mm outline,
// the ILM4926 designation, the 9FGV1006B and AST2500 part numbers), so the two artifacts are the
// same document and not two revisions wearing one locator.
data mt_jade_mirror_capture_date: SpecificationDocumentDate = SpecificationDocumentDate {
  year: 2022,
  month: 6,
  day: 3,
}

data mt_jade_mirror_citation_read_receipt: SpecificationCitationReadReceipt = SpecificationCitationReadReceipt {
  subject: mt_jade_reference_platform_subject_ref,
  provenance: DatedPublisherLocatorMirrorTextIngested {
    mirror: internet_archive_mt_jade_capture_authority,
    capture_date: mt_jade_mirror_capture_date,
    peer_session: "silent-koi-898",
    detail: "the publisher locator still answers 403 unauthenticated, so session silent-koi-898 fetched the dated Internet Archive capture of it - 3493299 bytes, sha256 1ca9adc18543ef4686537aaafa386fa09075f75612dd3ea57c03b7d8d438f6ae, 58 pages - and decoded its full text by zlib content-stream decompression, reading section 7.4 Table 3 from the rendered text positions rather than the flattened stream order. This is a second artifact from the publisher copy and may not match what the publisher serves today.",
  },
}

data mt_mitchell_publisher_citation_read_receipt: SpecificationCitationReadReceipt = SpecificationCitationReadReceipt {
  subject: mt_mitchell_reference_platform_subject_ref,
  provenance: DocumentLocatorFetchRefused {
    http_status: 403,
    detail: "unauthenticated fetch of the OCP publisher document locator returned 403; the publisher copy remains unread in this repository",
  },
}

data internet_archive_mt_mitchell_capture_date: SpecificationDocumentDate = SpecificationDocumentDate {
  year: 2022,
  month: 10,
  day: 26,
}

data mt_mitchell_mirror_citation_read_receipt: SpecificationCitationReadReceipt = SpecificationCitationReadReceipt {
  subject: mt_mitchell_reference_platform_subject_ref,
  provenance: DatedPublisherLocatorMirrorTextIngested {
    mirror: internet_archive_mt_mitchell_capture_authority,
    capture_date: internet_archive_mt_mitchell_capture_date,
    peer_session: "neat-hawk-428",
    detail: "full PDF text of the dated Internet Archive capture of the publisher locator was decoded by peer session neat-hawk-428; this is a second artifact from the publisher copy and may not match what the publisher serves today",
  },
}

data altra_platform_hw_design_citation_read_receipt: SpecificationCitationReadReceipt = SpecificationCitationReadReceipt {
  subject: altra_platform_hw_design_specification_subject_ref,
  provenance: PeerSessionPdfTextIngested {
    peer_session: "neat-hawk-428",
    detail: "full PDF text of the public CDN v1.00 locator was decoded by peer session neat-hawk-428 (zlib content-stream decompression with per-font ToUnicode CMap decoding); this subject module did not perform the fetch",
  },
}

// CORRECTED 2026-09-02. This receipt said the text was UNREAD and that no interior fact was
// modelled. Both halves were false by the time they were read: extdeps.ampere.mt_collins_product_brief.platform
// carries mechanical rows it states were read from this brief, and the brief's full text has now
// been decoded here. The superseded claim is named rather than overwritten in silence, because a
// receipt that was wrong about its own subject is exactly the kind of thing a later reader trusts.
data mt_collins_product_brief_citation_read_receipt: SpecificationCitationReadReceipt = SpecificationCitationReadReceipt {
  subject: mt_collins_public_product_brief_subject_ref,
  provenance: DocumentLocatorFetchedAndTextIngested {
    http_status: 200,
    byte_count: byte_size(count: 701666),
    content_digest: "sha256 961b98a41971bc5e8d189f795dec3b2a5249268d1845decfb71a7fad802f1c14",
    detail: "the anchor was fetched by this session and its full text decoded (zlib content-stream decompression with per-font ToUnicode CMap decoding): 1304 characters, a one-page specifications sheet from the Model row to the Dimensions row, carrying no proprietary, confidential, copyright, trademark, reserved or licence token and no document or issue number. Embedded metadata records Title 'Microsoft Word - Mt._Collins_2U_2022_V2', Producer 'Microsoft: Print To PDF', created 2022-10-17. That reading is what grounds mt_collins_product_brief_publication_status on the no-stated-terms arm.",
  },
}

data mt_collins_getting_started_guide_citation_read_receipt: SpecificationCitationReadReceipt = SpecificationCitationReadReceipt {
  subject: mt_collins_getting_started_guide_subject_ref,
  provenance: DocumentLocatorFetchedAndTextIngested {
    http_status: 200,
    byte_count: byte_size(count: 9409569),
    content_digest: "sha256 1c41b4f088fa9c8b760d21d57ae93b0d1a68ee67a740d4eb7ac893753fc580b3",
    detail: "the guide's locator was fetched by this session with NO credentials - no Customer Connect session and no cookie - returning application/pdf whose digest equals the identity recorded on the document module. That is the observation the public-availability axis turns on; the resulting status is an upstream fact and lives on the document module, not here.",
  },
}
