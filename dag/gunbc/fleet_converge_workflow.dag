module gunbc.fleet_converge_workflow


data fleet_converge_workflow_note: String = "Emitted on-demand fleet converge workflow (operator directive 2026-08-13, sleek-heron-218). workflow_dispatch with host=srv1|srv2|srv3|srv4 (executor runner pin) and mode=plan|apply|spark_linger: plan observes the RUNNER host; apply downloads a prior plan artifact; spark_linger runs executor-on-runner → target-on-spark (srv5|srv6) typed argv over FleetSsh via run_typed_argv_transport. Replaces the retired 15-minute ctrl-fleet-converge.timer cadence on every enrolled CI host (timer install route is TimerRetired fleet-wide). Standalone dispatch carries its own build job (release-bins pack/upload) so the converge job never downloads an artifact the current run did not produce."

data fleet_converge_enrolled_host_options: std.types.List<String> = ["srv1", "srv2", "srv3", "srv4"]

data fleet_converge_spark_target_options: std.types.List<String> = ["srv5", "srv6"]

data fleet_converge_mode_options: std.types.List<String> = ["plan", "apply", "spark_linger", "spark_observe", "spark_reboot", "spark_grants", "spark_durability"]

data fleet_converge_host_runner_expression: String = "${{ fromJSON(format('[\"self-hosted\",\"linux\",\"arm64\",\"{0}\"]', github.event.inputs.host)) }}"

fn gunbc_fleet_converge_build_job_backstop_timeout_minutes() -> Int {
  gunbc.fleet_workflow_steps.gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc.fleet_workflow_steps.gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc.fleet_workflow_steps.gunbc_ci_prelude_allowance_minutes
}

fn fleet_converge_build_job() -> extdeps.github.actions.Job {
  extdeps.github.actions.Job {
    id: "build",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(
      ci_prelude_steps(),
      [ci_release_build_step(), gunbc.fleet_workflow_steps.ci_release_bins_pack_step(), ci_release_bins_upload_step()],
    ),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: gunbc_fleet_converge_build_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none,
    permissions: none,
  }
}

fn fleet_converge_host_pinned_runner_spec() -> extdeps.github.actions.RunnerSpec {
  extdeps.github.actions.RunsOnExpression { expression: fleet_converge_host_runner_expression }
}

data fleet_converge_plan_step_if: String = "github.event.inputs.mode == 'plan'"
data fleet_converge_apply_step_if: String = "github.event.inputs.mode == 'apply'"
data fleet_converge_spark_linger_step_if: String = "github.event.inputs.mode == 'spark_linger'"

data fleet_converge_spark_observe_step_if: String = "github.event.inputs.mode == 'spark_observe'"

data fleet_converge_spark_reboot_step_if: String = "github.event.inputs.mode == 'spark_reboot'"

data fleet_converge_spark_durability_step_if: String = "github.event.inputs.mode == 'spark_durability'"

data fleet_converge_spark_grants_step_if: String = "github.event.inputs.mode == 'spark_grants'"

fn fleet_converge_plan_upload_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.UsesStep {
    name: Present { value: "Upload fleet converge plan artifact" },
    id: Present { value: "plan_upload" },
    uses: upload_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: gunbc_fleet_converge_plan_artifact_name)),
        kv(key: "path", value: yaml_string(s: fleet_converge_plan_artifact_dir)),
        kv(key: "if-no-files-found", value: yaml_string(s: "error")),
        kv(key: "retention-days", value: yaml_int(n: 30)),
        kv(key: "compression-level", value: yaml_int(n: 0)),
      ]
    },
    env: none,
    if_condition: Present { value: fleet_converge_plan_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc.fleet_workflow_steps.gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn fleet_converge_plan_download_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.UsesStep {
    name: Present { value: "Download fleet converge plan artifact" },
    id: Present { value: "plan_download" },
    uses: download_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: gunbc_fleet_converge_plan_artifact_name)),
        kv(key: "path", value: yaml_string(s: fleet_converge_plan_artifact_dir)),
        kv(key: "github-token", value: yaml_string(s: "${{ secrets.GITHUB_TOKEN }}")),
        kv(key: "run-id", value: yaml_string(s: "${{ github.event.inputs.plan_workflow_run_id }}")),
      ]
    },
    env: none,
    if_condition: Present { value: fleet_converge_apply_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc.fleet_workflow_steps.gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn fleet_converge_plan_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.RunStep {
    name: Present { value: "Fleet converge plan (membership_reconcile → artifact)" },
    id: Present { value: "plan" },
    run: gunbc_ci_fleet_converge_plan_invoke(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: fleet_converge_plan_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn fleet_converge_apply_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.RunStep {
    name: Present { value: "Fleet converge apply (CAS + generated apply.sh)" },
    id: Present { value: "apply" },
    run: gunbc_ci_fleet_converge_apply_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(
          key: gunbc_ci_fleet_converge_plan_artifact_hash_env_name,
          value: yaml_string(s: "${{ github.event.inputs.plan_artifact_hash }}"),
        ),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_apply_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn fleet_converge_spark_linger_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.RunStep {
    name: Present { value: "Spark serving linger converge (executor→target FleetSsh typed argv)" },
    id: Present { value: "spark_linger" },
    run: gunbc_ci_spark_serving_converge_slice_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
        kv(key: "SPARK_CONVERGE_EXECUTE", value: yaml_string(s: "1")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_linger_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

// THE DURABILITY PROBE, and it takes a target for the same reason the mutating converge does: a
// reboot with no named host must never fan out across the fleet from an unset variable. The entry
// refuses that arm itself; passing the input here is what gives it something to refuse.
fn fleet_converge_spark_reboot_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.RunStep {
    name: Present { value: "Spark serving reboot (durability probe: the receipt is the converge that follows)" },
    id: Present { value: "spark_reboot" },
    run: gunbc_ci_spark_serving_reboot_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_reboot_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

// THE DURABILITY TRANSACTION, which is a different event from the reboot probe beside it and not a
// longer version of it. The probe issues a reboot and reports what the far side said; this runs the
// whole comparison in ONE process -- boot identity before, reboot, poll until that identity changes,
// then the same replan and generation probe the converge path uses -- because a before-reading kept
// between two dispatches is a fact whose staleness nothing checks.
fn fleet_converge_spark_durability_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.RunStep {
    name: Present { value: "Spark serving durability transaction (boot identity before and after, in one run)" },
    id: Present { value: "spark_durability" },
    run: gunbc_ci_spark_serving_durability_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_durability_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

fn fleet_converge_spark_grants_step() -> extdeps.github.actions.Step {
  RunStep {
    name: Present { value: "Spark managed grant reconcile (materializes its own administrator credential in-run, installs only the grants measured missing at the named target, removes the credential within this same step)" },
    id: Present { value: "spark_grants" },
    run: gunbc_ci_spark_grant_install_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
        kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_grants_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

fn fleet_converge_spark_observe_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.RunStep {
    name: Present { value: "Spark serving observation (read-only: unit state, runtime version, model tags, driver)" },
    id: Present { value: "spark_observe" },
    run: gunbc_ci_spark_serving_observe_invoke(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_observe_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

data fleet_converge_consumer_prelude_note: String = "Plain fetch-depth-0 checkout only — this workflow has no workflow_dispatch expected_healed_sha input (unlike ci.yml heal revalidation). ci_artifact_consumer_prelude_steps paste-through would reference an undeclared input and emit a dormant preflight guard."

fn fleet_converge_consumer_prelude_steps() -> std.types.List<extdeps.github.actions.Step> {
  [ci_checkout_step()]
}

fn fleet_converge_job() -> extdeps.github.actions.Job {
  extdeps.github.actions.Job {
    id: "fleet-converge",
    name: none,
    runner: fleet_converge_host_pinned_runner_spec(),
    steps: concat(
      concat(
        fleet_converge_consumer_prelude_steps(),
        [
          ci_release_bins_download_step(),
          ci_release_bins_unpack_verify_step(),
          ci_fleet_wif_auth_step(),
          ci_fleet_key_agent_step(),
        ]
      ),
      [
        fleet_converge_plan_step(),
        fleet_converge_plan_upload_step(),
        fleet_converge_plan_download_step(),
        fleet_converge_apply_step(),
        fleet_converge_spark_linger_step(),
        fleet_converge_spark_grants_step(),
        fleet_converge_spark_observe_step(),
        fleet_converge_spark_reboot_step(),
        fleet_converge_spark_durability_step(),
        ci_fleet_key_agent_cleanup_step(),
      ]
    ),
    needs: ["build"],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: gunbc_ci_fleet_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none,
    permissions: Present {
      value: extdeps.github.actions.WorkflowPermissions {
        contents: Present { value: extdeps.github.actions.PermRead },
        pull_requests: none,
        issues: none,
        actions: Present { value: extdeps.github.actions.PermRead },
        id_token: Present { value: extdeps.github.actions.PermWrite },
      }
    }
  }
}

data fleet_converge_workflow: extdeps.github.actions.Workflow = extdeps.github.actions.Workflow {
  name: "fleet-converge",
  on: [
    extdeps.github.actions.WorkflowDispatch {
      inputs: [
        extdeps.github.actions.DispatchInput {
          name: "host",
          description: Present { value: "Executor fleet host (runner pinned here; plan mode observes this host)" },
          required: true,
          default: none,
          type: extdeps.github.actions.InputChoice { options: fleet_converge_enrolled_host_options },
        },
        extdeps.github.actions.DispatchInput {
          name: "mode",
          description: Present { value: "plan shows membership hunks; apply executes a prior plan artifact; spark_linger enables linger on target spark via FleetSsh typed argv from executor; spark_observe is a read-only observation of both Sparks" },
          required: true,
          default: none,
          type: extdeps.github.actions.InputChoice { options: fleet_converge_mode_options },
        },
        extdeps.github.actions.DispatchInput {
          name: "target",
          description: Present { value: "Spark target host for spark_linger mode (srv5 or srv6)" },
          required: false,
          default: none,
          type: extdeps.github.actions.InputChoice { options: fleet_converge_spark_target_options },
        },
        extdeps.github.actions.DispatchInput {
          name: "plan_artifact_hash",
          description: Present { value: "Fnv1a64Structural bundle digest of plan.txt + apply.sh + spark_serving_typed_actions.wire — required for apply (printed by plan step). A plan artifact minted before the typed-actions wire joined the bundle will not match." },
          required: false,
          default: none,
          type: extdeps.github.actions.InputString,
        },
        extdeps.github.actions.DispatchInput {
          name: "plan_workflow_run_id",
          description: Present { value: "Workflow run id that produced the plan artifact — required for apply" },
          required: false,
          default: none,
          type: extdeps.github.actions.InputString,
        },
      ]
    }
  ],
  concurrency: none,
  env: none,
  permissions: none,
  jobs: [fleet_converge_build_job(), fleet_converge_job()],
}

type FleetConvergeYamlGenerationOutcome
  = FleetConvergeYamlGenerated { content: String }
  | FleetConvergeYamlGenerationRefused { reason: String }

fn expected_fleet_converge_yml() -> FleetConvergeYamlGenerationOutcome {
  match checked_job_timeout_minutes(computed: gunbc_ci_fleet_job_backstop_timeout_minutes()) {
    JobTimeoutExceedsCeiling { minutes: _, ceiling: _ } =>
      FleetConvergeYamlGenerationRefused { reason: "fleet-converge job backstop timeout exceeds extdeps.github.actions max_job_timeout_minutes — split the job or reduce a tier's per-step budget, do not raise past the platform ceiling (see gunbc_ci_fleet_job_backstop_timeout_note in gunbc.fleet_workflow_steps)" }
    JobTimeoutWithinCeiling { minutes: _ } =>
      FleetConvergeYamlGenerated { content: serialize_yaml(v: project_workflow_to_yaml(workflow: fleet_converge_workflow)) }
  }
}
