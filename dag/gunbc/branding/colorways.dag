module gunbc.branding.colorways

import std.types { Bool, List, NonEmptyStr }
import extdeps.color.srgb { Srgb8 }

// THE gunb.ai BRAND COLOURWAYS. This module is their authority (operator ruling 2026-10-10): each is
// the Stoic Giant seal drawn in one ink on one field, with its eyes and mouth cut through to the
// field, and nothing else -- the geometry is extdeps.gunb_ai.frontend's, unchanged. The file stem is
// the name each colourway's SVG is committed under (dag/gunbc/branding/colorways/<stem>.svg).
//
// This module is deliberately light -- extdeps only -- because the generated-artifact registry
// imports it to enumerate the files, and that registry's closure is paid by every consumer that
// needs one artifact's path.
type BrandColorway sole_constructor {
  name: NonEmptyStr
  file_stem: NonEmptyStr
  field: Srgb8
  ink: Srgb8
}

data brand_colorway_salmon_and_void: BrandColorway = BrandColorway {
  name: "Salmon & Void", file_stem: "salmon-and-void",
  field: Srgb8 { r: 255, g: 181, b: 176 }, ink: Srgb8 { r: 10, g: 10, b: 10 },
}

data brand_colorway_raw_clay: BrandColorway = BrandColorway {
  name: "Raw Clay", file_stem: "raw-clay",
  field: Srgb8 { r: 249, g: 246, b: 240 }, ink: Srgb8 { r: 211, g: 74, b: 46 },
}

data brand_colorway_heavy_moss: BrandColorway = BrandColorway {
  name: "Heavy Moss", file_stem: "heavy-moss",
  field: Srgb8 { r: 235, g: 233, b: 224 }, ink: Srgb8 { r: 25, g: 64, b: 37 },
}

data brand_colorway_stark: BrandColorway = BrandColorway {
  name: "Stark", file_stem: "stark",
  field: Srgb8 { r: 10, g: 10, b: 10 }, ink: Srgb8 { r: 249, g: 246, b: 240 },
}

data brand_colorways: List<BrandColorway> = [
  brand_colorway_salmon_and_void,
  brand_colorway_raw_clay,
  brand_colorway_heavy_moss,
  brand_colorway_stark,
]

data brand_colorway_directory: NonEmptyStr = "dag/gunbc/branding/colorways"

fn brand_colorway_name(c: BrandColorway) -> NonEmptyStr { c.name }

fn brand_colorway_stem(c: BrandColorway) -> NonEmptyStr { c.file_stem }

fn brand_colorway_field(c: BrandColorway) -> Srgb8 { c.field }

fn brand_colorway_ink(c: BrandColorway) -> Srgb8 { c.ink }

// Two colourways may not share a name or a file stem: a shared stem would have two artifacts write
// one path, and a shared name would give one brand word two paints.
fn brand_colorways_distinct(rows: List<BrandColorway>) -> Bool {
  all(rows, c => count(filter(rows, d => d.file_stem == c.file_stem)) == 1 && count(filter(rows, d => d.name == c.name)) == 1)
}
