module gunbc.branding.colorway_svg

import std.types { List, NonEmptyStr, String }
import std.nat { Nat }
import std.markup { Fragment, Element, attr }
import extdeps.color.srgb { srgb8_hex }
import extdeps.languages.html { serialize_html_source }
import extdeps.gunb_ai.frontend { gunb_stoic_giant_mark, mark_frame_span }
import gunbc.branding.seal { SealPlacement, seal_fragments, seal_inexact_coordinates }
import gunbc.branding.colorways { BrandColorway, brand_colorway_name, brand_colorway_field, brand_colorway_ink }

// ONE COLOURWAY AS AN SVG: the seal in the colourway's ink on its field, features cut through to the
// field, on a square canvas of the seal's frame (1200 tenths).
//
// THE FRAMING IS mark.svg's AUTHORED GEOMETRY, NOT ITS ZOOM. mark.svg draws the seal at x 10..110,
// y 20..100 of a 120-unit box and then applies translate(-12 -12) scale(1.2) so the favicon fills
// its tile edge to edge. A colourway is an avatar and an export, so it keeps the authored placement
// and the air around it: the zoomed frame shrinks back by 10/12 into a 1000-tenth box inset 100 on
// every side, which puts the body at x 100..1100, y 200..1000 -- the authored coordinates in tenths.
data colorway_seal_box: Nat = 1000

data colorway_seal_inset: Nat = 100

// Exported at 1080 px square, the brand's avatar export size.
data colorway_export_px: Nat = 1080

type MarkColorwayArtwork
  = MarkColorwayEmitted { svg: String }
  | MarkColorwayRefused { reason: String }

fn colorway_n(v: Nat) -> String { to_string(v) }

fn brand_colorway_artwork(c: BrandColorway) -> MarkColorwayArtwork {
  if count(seal_inexact_coordinates(box: colorway_seal_box, mark: gunb_stoic_giant_mark)) > 0 {
    MarkColorwayRefused { reason: "a seal coordinate does not place exactly in the colourway box" }
  } else if colorway_seal_box + 2 * colorway_seal_inset != mark_frame_span {
    MarkColorwayRefused { reason: "the seal box and its inset do not fill the canvas symmetrically" }
  } else {
    let field = srgb8_hex(c: brand_colorway_field(c: c))
    let side = colorway_n(v: mark_frame_span)
    let svg = Element { tag: "svg", attributes: [
      attr(name: "xmlns", value: "http://www.w3.org/2000/svg"),
      attr(name: "width", value: colorway_n(v: colorway_export_px)),
      attr(name: "height", value: colorway_n(v: colorway_export_px)),
      attr(name: "viewBox", value: join(["0 0 ", side, " ", side], "")),
      attr(name: "role", value: "img"),
      attr(name: "aria-label", value: join(["gunb.ai, ", brand_colorway_name(c: c) as String], "")),
    ], children: concat([
      Element { tag: "rect", attributes: [attr(name: "width", value: side), attr(name: "height", value: side), attr(name: "fill", value: field)], children: [] },
    ], seal_fragments(p: SealPlacement { box: colorway_seal_box, x: colorway_seal_inset, y: colorway_seal_inset }, mark: gunb_stoic_giant_mark, body_paint: srgb8_hex(c: brand_colorway_ink(c: c)), feature_paint: field)) }
    MarkColorwayEmitted { svg: serialize_html_source(node: svg) }
  }
}
