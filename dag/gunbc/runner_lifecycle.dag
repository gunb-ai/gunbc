data runner_lifecycle_ci_org: NonEmptyStr = gunbai_ci_declared.owner_login

data runner_lifecycle_ci_installation_id: GitHubAppInstallationId = gunbai_ci_declared_installation_id

type RunnerPerSlotMemoryCaps {
  memory_max: ByteSize
  memory_high: ByteSize
  memory_swap_max: ByteSize
}

fn runner_lifecycle_per_slot_caps() -> RunnerPerSlotMemoryCaps {
  let desired = gunbc_runner_slot_desired()
  RunnerPerSlotMemoryCaps {
    memory_max: desired.memory_max,
    memory_high: desired.memory_high,
    memory_swap_max: desired.memory_swap_max,
  }
}

data runner_lifecycle_jit_wrapper_path: String = join([actions_runner_base_dir, "/jit-runner.sh"], "")

data runner_lifecycle_systemd_template_unit: String = gunbc_runner_unit_template

data runner_lifecycle_memory_cap_apply_note: String = "Per-slot caps are applied IMPERATIVELY on hosts (operator probe 2026-08-07): systemctl set-property writes /etc/systemd/system.control/<unit>.d/50-*.conf; read back with systemctl show -p MemoryMax/MemoryHigh/MemorySwapMax — not a hand-authored unit drop-in file. host_converge_slice1 is the precedent for EnsureRunnerMemoryCaps realization. srv1's five slots were hand-converged 2026-08-07 to the 14GiB memory model (MemoryMax=15032385536 MemoryHigh=13958643712 MemorySwapMax=34359738368 CPUWeight=100) AND (per that note's own text) to TasksMax=512 — which the 2026-08-08 operator ruling on PR 8045 identified as the diagnosed EAGAIN outage value, not the repair; desired is 16384 (gunbc.runner_slot_allocation). The 512 claim was DECIDED FALSE BY OBSERVATION (executed pre-apply receipt, workflow_dispatch run 31288091024, 2026-08-09, operator-accepted): all five srv1 slots read effective TasksMax=16384 with matching cgroup pids.max=16384, so the tasks axis is Converged and srv1 serves as the acceptance row 6 no-op control on ALL converged axes. srv2/srv3/srv4 remain at 16GiB until the workflow applies; their tasks state is unobserved."

data runner_lifecycle_memory_cap_dropin: String = gunbc_runner_per_slot_dropin_path

data runner_lifecycle_memory_swap_dropin: String = gunbc_runner_per_slot_swap_dropin_path

data runner_lifecycle_memory_high_dropin: String = gunbc_runner_per_slot_high_dropin_path
