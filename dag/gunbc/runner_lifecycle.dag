data runner_lifecycle_ctrl_void_note: String = "gunbc citations must not treat ctrl as a live upstream repo (operator ruling 2026-08-06). On hosts ctrl IS still deployed: install-actions-runner.sh lives at /home/briansrls/ctrl/scripts/session-dashboard/host/install-actions-runner.sh; ctrl-runner-reclaim.timer is active. gunbc.runner_lifecycle ADD path must READ that installer as ground truth for what creates a runner, then subsume it through HostEffect arms — never invoke ctrl from gunbc run, never fork runner-liveness-reconcile (timer active on srv1 every 2 min; /opt/actions-runner/runner-liveness-reconcile.sh documents the Aug-6 outage — #7940 subsumes it). runner_host_deploy ctrl path literals remain void legacy pointers only."

type RunnerSlotAddStep
  = AddStepReachIdentityPrivilege
  | AddStepDiskHeadroom
  | AddStepFetchRelease
  | AddStepVerifyArchDigest
  | AddStepSlotDirectory
  | AddStepJitWrapper
  | AddStepSystemdTemplate
  | AddStepMemoryCaps
  | AddStepDaemonReload
  | AddStepStartUnit
  | AddStepGitHubRegistrationQuery
  | AddStepConvergeOnlineEphemeral

fn runner_slot_add_steps_ordered() -> List<RunnerSlotAddStep> {
  [
    AddStepReachIdentityPrivilege,
    AddStepDiskHeadroom,
    AddStepFetchRelease,
    AddStepVerifyArchDigest,
    AddStepSlotDirectory,
    AddStepJitWrapper,
    AddStepSystemdTemplate,
    AddStepMemoryCaps,
    AddStepDaemonReload,
    AddStepStartUnit,
    AddStepGitHubRegistrationQuery,
    AddStepConvergeOnlineEphemeral,
  ]
}

type RunnerSlotAddSequence
  = GitHubRunnerAddSequence { steps: List<RunnerSlotAddStep> }
  | FabricSlotProvisioningNotModeled { reason: String }
  | SlotIsNotACommittedMember { reason: String }

// REGISTRATION IS DERIVED FROM PURPOSE, WHICH IS THE HALF THAT MAKES THE PURPOSE FIELD REAL. A
// purpose that does not gate the step is a label: it would record which slots we INTENDED not to
// register while leaving the add sequence able to register every one of them. So the sequence is
// selected by purpose and a compute-fabric slot has no arm that reaches
// AddStepGitHubRegistrationQuery -- not an arm that skips it, no arm at all.
//
// THE FABRIC ARM REFUSES RATHER THAN FILTERING, AND THAT IS THE LOAD-BEARING CHOICE. The tempting
// shape is to return the GitHub steps minus the three GitHub-specific ones, which reads as
// economical and is wrong: this sequence fetches an actions-runner release, verifies its arch
// digest and starts an actions-runner unit, so the filtered remainder would provision a slot that
// downloads GitHub's runner in order never to run GitHub's runner. A compute-fabric slot is a
// different payload, not a GitHub runner with pieces removed, and its provisioning sequence is not
// modeled yet. Answering with a plausible subsequence would be the fabricated-plausible-output
// failure DESIGN section 5 forbids; refusing names the gap and stops the line.
//
// NEXT-RUNG TRIGGER: the fabric slot's own provisioning sequence -- whatever installs and starts
// the fabric executor -- landing as its own arm here. Until then this refusal is the honest
// terminal state for the one fabric slot that exists (srv3-06), and it is why that slot is
// declared but not yet convergeable.
// THIS GATE HAS NO PRODUCTION CALLER TODAY, AND SAYING SO IS THE DIFFERENCE BETWEEN A WALL AND A
// CLAIM ABOUT A WALL. Only its witness calls it. The apply path never reaches a step sequence at
// all: gunbc.runner_capacity_realize matches RunnerSlotAdd and discards the identity, counting adds
// and returning a scaffold refusal.
//
// THE SAFETY PROPERTY IS NOT VACUOUS -- IT IS HELD ONE LAYER EARLIER, ON A PATH THAT IS LIVE. The
// chain gunbc.apply -> runner_capacity_plan -> plan_runner_capacity_host -> addition_actions ->
// desired_github_identities is reachable from the CLI, and that last function filters by purpose,
// so a fabric execution slot is never placed in a RunnerSlotAdd to begin with. Nothing downstream
// can register it whether or not it consults this gate.
//
// SO THERE ARE TWO WALLS WITH DIFFERENT STATUSES AND THEY MUST NOT BE QUOTED AS ONE. The planner
// filter is what makes "the plan can never add a fabric slot" true today. This gate is a second,
// independent wall at the step-selection seam, and it is defence in depth for a path that cannot
// currently produce a fabric add anyway. Describing registration as "derived from purpose" without
// that split implies this function holds the line; it does not, yet.
//
// TRIGGER: it becomes load-bearing the moment anything in production selects a step sequence --
// which is the same event that makes the fabric provisioning arm below necessary. Until then its
// witness is the only thing executing it, and a witness is not a consumer.
fn runner_slot_add_sequence_for(host: HostIdentity, slot_index: Nat) -> RunnerSlotAddSequence {
  match runner_slot_membership(host: host, slot_index: slot_index) {
    SlotOutsideCommittedPopulation { identity: _, committed_width: _ } =>
      SlotIsNotACommittedMember {
        reason: "slot index is outside the host committed population: asking what a slot is FOR only means something once it IS a slot, so this refuses rather than classifying an identity the host was never admitted to carry"
      }
    CommittedSlotMember { identity: _, purpose: p } =>
      match p {
        SlotServesGitHubActions =>
          GitHubRunnerAddSequence { steps: runner_slot_add_steps_ordered() }
        SlotServesFabricExecution =>
          FabricSlotProvisioningNotModeled {
            reason: "fabric execution slot: the GitHub runner add sequence does not apply and no fabric provisioning sequence is modeled yet; refusing rather than returning a filtered subsequence that would install an actions-runner for a slot that never serves Actions"
          }
      }
  }
}

fn runner_slot_add_step_index(step: RunnerSlotAddStep) -> Int {
  match step {
    AddStepReachIdentityPrivilege => 1
    AddStepDiskHeadroom => 2
    AddStepFetchRelease => 3
    AddStepVerifyArchDigest => 4
    AddStepSlotDirectory => 5
    AddStepJitWrapper => 6
    AddStepSystemdTemplate => 7
    AddStepMemoryCaps => 8
    AddStepDaemonReload => 9
    AddStepStartUnit => 10
    AddStepGitHubRegistrationQuery => 11
    AddStepConvergeOnlineEphemeral => 12
  }
}

fn runner_slot_caps_precede_start() -> Bool {
  runner_slot_add_step_index(step: AddStepMemoryCaps) < runner_slot_add_step_index(step: AddStepStartUnit)
}

fn runner_slot_unit_name(slot: RunnerSlotIdentity) -> NonEmptyStr {
  join(["actions-runner@", runner_slot_instance_name(slot: slot), ".service"], "") as NonEmptyStr
}

fn runner_slot_dir_path(slot: RunnerSlotIdentity) -> NonEmptyStr {
  join([actions_runner_base_dir, "/", runner_slot_instance_name(slot: slot)], "") as NonEmptyStr
}

data runner_slot_disk_budget_per_slot_note: String = "Conservative per-slot disk charge for width preflight on srv4 (operator 2026-08-06): seven slots on 500GB NVMe cannot silently fall back to the historical five-slot pin. Derived from srv4_runner_count_disk_cap_note arithmetic (~38GB per slot at width 7 on 500GB class disk). Unobservable disk REFUSES; insufficient headroom REFUSES — never absorbs to width 5."

data runner_slot_disk_budget_per_slot: ByteSize = byte_size(40960000000)

fn runner_width_disk_required(requested_width: Int) -> ByteSize {
  byte_size(count: requested_width * byte_size_count(b: runner_slot_disk_budget_per_slot))
}

type RunnerWidthDiskPreflight
  = DiskHeadroomSufficient { requested_width: Int, required: ByteSize, observed_free: ByteSize }
  | DiskHeadroomInsufficient { requested_width: Int, required: ByteSize, observed_free: ByteSize }
  | DiskHeadroomUnobserved { requested_width: Int, reason: String }

fn runner_width_disk_preflight(
  requested_width: Int,
  disk: HostDiskObservation,
) -> RunnerWidthDiskPreflight {
  let required = runner_width_disk_required(requested_width: requested_width)
  match disk {
    DiskObserved { free_bytes: free } =>
      if byte_size_count(b: free) >= byte_size_count(b: required) {
        DiskHeadroomSufficient { requested_width: requested_width, required: required, observed_free: free }
      } else {
        DiskHeadroomInsufficient {
          requested_width: requested_width,
          required: required,
          observed_free: free,
        }
      }
    DiskUnobserved { reason: r } =>
      DiskHeadroomUnobserved { requested_width: requested_width, reason: r }
    DiskObservationRefused { detail: d } =>
      DiskHeadroomUnobserved { requested_width: requested_width, reason: d as String }
  }
}

type RunnerSlotLifecycleReceipt {
  slot: RunnerSlotIdentity
  requested: Bool
  materialized: Bool
  active_unit: Bool
  registered: Bool
  online: Bool
  busy: Bool
  schedulable: Bool
}

type HostRunnerCapacityReceipt {
  host: HostIdentity
  requested_width: Int
  materialized_count: Int
  active_unit_count: Int
  registered_count: Int
  online_count: Int
  slots: List<RunnerSlotLifecycleReceipt>
}

fn host_runner_capacity_converged(receipt: HostRunnerCapacityReceipt) -> Bool {
  receipt.materialized_count == receipt.requested_width
    && receipt.active_unit_count == receipt.requested_width
    && receipt.registered_count == receipt.requested_width
    && receipt.online_count == receipt.requested_width
}

type RunnerLocalStateObservation
  = RunnerLocalStateObserved {
      slot: RunnerSlotIdentity
      unit_active: Bool
      unit_busy: Bool
      runner_version: NonEmptyStr
    }
  | RunnerLocalStateUnobserved { slot: RunnerSlotIdentity, reason: NonEmptyStr }

type GitHubRunnerRegistrationObservation
  = GitHubRunnerRegisteredOnline {
      slot: RunnerSlotIdentity
      organization: NonEmptyStr
      ephemeral: Bool
      online: Bool
      busy: Bool
      runner_version: NonEmptyStr
      labels_match: Bool
    }
  | GitHubRunnerRegistrationPending { slot: RunnerSlotIdentity, reason: NonEmptyStr }
  | GitHubRunnerRegistrationRefused { slot: RunnerSlotIdentity, reason: NonEmptyStr }

// Aspiration bind: runner_lifecycle_realize is not yet a single top-level decl; names the realize
