// PR B seam (operator 2026-08-06): vivid-eagle-131 owns gunbc.apply plan + typed actions;
// still-ram-738 owns these HostEffect arms + ADD sequence + shared RunnerSlotIdentity;
// vivid-otter-718 stacks ReplaceRunnerIncarnation / repair arms on the SAME identity — no fork.

data runner_lifecycle_authority_disposition: Disposition = SingleAuthority

data runner_lifecycle_ctrl_void_note: String = "ctrl is a DEAD REPO (operator ruling 2026-08-06). Runner installation is gunbc-owned end-to-end via these HostEffect arms and gunbc.runner_lifecycle_realize — never invoke, vendor, or wrap ctrl scripts. runner_host_deploy's ctrl path literals are void legacy pointers only."

type RunnerSlotAddStep
  = AddStepReachIdentityPrivilege
  | AddStepDiskHeadroom
  | AddStepFetchRelease
  | AddStepVerifyArchDigest
  | AddStepSlotDirectory
  | AddStepJitWrapper
  | AddStepSystemdTemplate
  | AddStepMemoryCaps
  | AddStepDaemonReload
  | AddStepStartUnit
  | AddStepGitHubRegistrationQuery
  | AddStepConvergeOnlineEphemeral

fn runner_slot_add_steps_ordered() -> List<RunnerSlotAddStep> {
  [
    AddStepReachIdentityPrivilege,
    AddStepDiskHeadroom,
    AddStepFetchRelease,
    AddStepVerifyArchDigest,
    AddStepSlotDirectory,
    AddStepJitWrapper,
    AddStepSystemdTemplate,
    AddStepMemoryCaps,
    AddStepDaemonReload,
    AddStepStartUnit,
    AddStepGitHubRegistrationQuery,
    AddStepConvergeOnlineEphemeral,
  ]
}

fn runner_slot_add_step_index(step: RunnerSlotAddStep) -> Int {
  match step {
    AddStepReachIdentityPrivilege => 1
    AddStepDiskHeadroom => 2
    AddStepFetchRelease => 3
    AddStepVerifyArchDigest => 4
    AddStepSlotDirectory => 5
    AddStepJitWrapper => 6
    AddStepSystemdTemplate => 7
    AddStepMemoryCaps => 8
    AddStepDaemonReload => 9
    AddStepStartUnit => 10
    AddStepGitHubRegistrationQuery => 11
    AddStepConvergeOnlineEphemeral => 12
  }
}

fn runner_slot_caps_precede_start() -> Bool {
  runner_slot_add_step_index(step: AddStepMemoryCaps) < runner_slot_add_step_index(step: AddStepStartUnit)
}

fn runner_slot_instance_name(slot: RunnerSlotIdentity) -> String {
  let idx = slot.slot_index
  let two = if idx < 10 { join(["0", to_string(idx)], "") } else { to_string(idx) }
  join([slot.host as String, "-", two], "")
}

fn runner_slot_unit_name(slot: RunnerSlotIdentity) -> NonEmptyStr {
  join(["actions-runner@", runner_slot_instance_name(slot: slot), ".service"], "") as NonEmptyStr
}

fn runner_slot_dir_path(slot: RunnerSlotIdentity) -> NonEmptyStr {
  join([actions_runner_base_dir, "/", runner_slot_instance_name(slot: slot)], "") as NonEmptyStr
}

data runner_slot_disk_budget_per_slot_note: String = "Conservative per-slot disk charge for width preflight on srv4 (operator 2026-08-06): seven slots on 500GB NVMe cannot silently fall back to the historical five-slot pin. Derived from srv4_runner_count_disk_cap_note arithmetic (~38GB per slot at width 7 on 500GB class disk). Unobservable disk REFUSES; insufficient headroom REFUSES — never absorbs to width 5."

data runner_slot_disk_budget_per_slot: ByteSize = byte_size(40960000000)

fn runner_width_disk_required(requested_width: Int) -> ByteSize {
  byte_size(count: requested_width * byte_size_count(b: runner_slot_disk_budget_per_slot))
}

type RunnerWidthDiskPreflight
  = DiskHeadroomSufficient { requested_width: Int, required: ByteSize, observed_free: ByteSize }
  | DiskHeadroomInsufficient { requested_width: Int, required: ByteSize, observed_free: ByteSize }
  | DiskHeadroomUnobserved { requested_width: Int, reason: String }

fn runner_width_disk_preflight(
  requested_width: Int,
  disk: HostDiskObservation,
) -> RunnerWidthDiskPreflight {
  let required = runner_width_disk_required(requested_width: requested_width)
  match disk {
    DiskObserved { free_bytes: free } =>
      if byte_size_count(b: free) >= byte_size_count(b: required) {
        DiskHeadroomSufficient { requested_width: requested_width, required: required, observed_free: free }
      } else {
        DiskHeadroomInsufficient {
          requested_width: requested_width,
          required: required,
          observed_free: free,
        }
      }
    DiskUnobserved { reason: r } =>
      DiskHeadroomUnobserved { requested_width: requested_width, reason: r }
    DiskObservationRefused { detail: d } =>
      DiskHeadroomUnobserved { requested_width: requested_width, reason: d as String }
  }
}

type RunnerSlotLifecycleReceipt {
  slot: RunnerSlotIdentity
  requested: Bool
  materialized: Bool
  active_unit: Bool
  registered: Bool
  online: Bool
  busy: Bool
  schedulable: Bool
}

type HostRunnerCapacityReceipt {
  host: HostIdentity
  requested_width: Int
  materialized_count: Int
  active_unit_count: Int
  registered_count: Int
  online_count: Int
  slots: List<RunnerSlotLifecycleReceipt>
}

fn host_runner_capacity_converged(receipt: HostRunnerCapacityReceipt) -> Bool {
  receipt.materialized_count == receipt.requested_width
    && receipt.active_unit_count == receipt.requested_width
    && receipt.registered_count == receipt.requested_width
    && receipt.online_count == receipt.requested_width
}

type RunnerLocalStateObservation
  = RunnerLocalStateObserved {
      slot: RunnerSlotIdentity
      unit_active: Bool
      unit_busy: Bool
      runner_version: NonEmptyStr
    }
  | RunnerLocalStateUnobserved { slot: RunnerSlotIdentity, reason: NonEmptyStr }

type GitHubRunnerRegistrationObservation
  = GitHubRunnerRegisteredOnline {
      slot: RunnerSlotIdentity
      organization: NonEmptyStr
      ephemeral: Bool
      online: Bool
      busy: Bool
      runner_version: NonEmptyStr
      labels_match: Bool
    }
  | GitHubRunnerRegistrationPending { slot: RunnerSlotIdentity, reason: NonEmptyStr }
  | GitHubRunnerRegistrationRefused { slot: RunnerSlotIdentity, reason: NonEmptyStr }

data runner_lifecycle_effects_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.runner_lifecycle_realize",
    decl_name: "runner_lifecycle_realize",
    field: WholeDeclaration,
  }
}

data runner_lifecycle_cited_release: ActionsRunnerRelease = actions_runner_release_2_334_0

data runner_lifecycle_ci_org: NonEmptyStr = gunbai_ci_declared.owner_login

data runner_lifecycle_ci_installation_id: GitHubAppInstallationId = gunbai_ci_declared_installation_id

type RunnerPerSlotMemoryCaps {
  memory_max: ByteSize
  memory_high: ByteSize
  memory_swap_max: ByteSize
}

fn runner_lifecycle_per_slot_caps() -> RunnerPerSlotMemoryCaps {
  let desired = gunbc_runner_slot_desired()
  RunnerPerSlotMemoryCaps {
    memory_max: desired.memory_max,
    memory_high: desired.memory_high,
    memory_swap_max: desired.memory_swap_max,
  }
}

data runner_lifecycle_jit_wrapper_path: String = join([actions_runner_base_dir, "/jit-runner.sh"], "")

data runner_lifecycle_systemd_template_unit: String = gunbc_runner_unit_template

data runner_lifecycle_memory_cap_dropin: String = gunbc_runner_per_slot_dropin_path

data runner_lifecycle_memory_swap_dropin: String = gunbc_runner_per_slot_swap_dropin_path

data runner_lifecycle_memory_high_dropin: String = gunbc_runner_per_slot_high_dropin_path
