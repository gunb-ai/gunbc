data runner_local_incarnation_authority_note: String = "LocalRunnerSlotIncarnation lives in gunbc.runner_incarnation (neutral lifecycle home — not gunbc.fleet_runner_connectivity). Fields: slot, unit, unit_active, registration_name. No process/PID field until ObserveRunnerLocalState grounds it (runner_incarnation_process_identity_note). ReplaceRunnerIncarnation carries from: that record so apply can refuse a stale plan when the incarnation identity changed since planning."

type RunnerReplacementCause
  = ReplacementCauseConnectivityDetached { registration_id: std.nat.Nat }
  | ReplacementCauseOrphanedRegistration {}
  | ReplacementCauseWedgedBroker {}
  | ReplacementCauseOperatorForced { detail: String }

data runner_lifecycle_authority_disposition: std.disposition.Disposition = SingleAuthority

data runner_lifecycle_ctrl_void_note: String = "gunbc citations must not treat ctrl as a live upstream repo (operator ruling 2026-08-06). On hosts ctrl IS still deployed: install-actions-runner.sh lives at /home/briansrls/ctrl/scripts/session-dashboard/host/install-actions-runner.sh; ctrl-runner-reclaim.timer is active. gunbc.runner_lifecycle ADD path must READ that installer as ground truth for what creates a runner, then subsume it through HostEffect arms — never invoke ctrl from gunbc run, never fork runner-liveness-reconcile (timer active on srv1 every 2 min; /opt/actions-runner/runner-liveness-reconcile.sh documents the Aug-6 outage — #7940 subsumes it). runner_host_deploy ctrl path literals remain void legacy pointers only."

type RunnerSlotAddStep
  = AddStepReachIdentityPrivilege
  | AddStepDiskHeadroom
  | AddStepFetchRelease
  | AddStepVerifyArchDigest
  | AddStepSlotDirectory
  | AddStepJitWrapper
  | AddStepSystemdTemplate
  | AddStepMemoryCaps
  | AddStepDaemonReload
  | AddStepStartUnit
  | AddStepGitHubRegistrationQuery
  | AddStepConvergeOnlineEphemeral

fn runner_slot_add_steps_ordered() -> List<RunnerSlotAddStep> {
  [
    AddStepReachIdentityPrivilege,
    AddStepDiskHeadroom,
    AddStepFetchRelease,
    AddStepVerifyArchDigest,
    AddStepSlotDirectory,
    AddStepJitWrapper,
    AddStepSystemdTemplate,
    AddStepMemoryCaps,
    AddStepDaemonReload,
    AddStepStartUnit,
    AddStepGitHubRegistrationQuery,
    AddStepConvergeOnlineEphemeral,
  ]
}

fn runner_slot_add_step_index(step: RunnerSlotAddStep) -> Int {
  match step {
    AddStepReachIdentityPrivilege => 1
    AddStepDiskHeadroom => 2
    AddStepFetchRelease => 3
    AddStepVerifyArchDigest => 4
    AddStepSlotDirectory => 5
    AddStepJitWrapper => 6
    AddStepSystemdTemplate => 7
    AddStepMemoryCaps => 8
    AddStepDaemonReload => 9
    AddStepStartUnit => 10
    AddStepGitHubRegistrationQuery => 11
    AddStepConvergeOnlineEphemeral => 12
  }
}

fn runner_slot_caps_precede_start() -> Bool {
  runner_slot_add_step_index(step: AddStepMemoryCaps) < runner_slot_add_step_index(step: AddStepStartUnit)
}

fn runner_slot_instance_name(slot: gunbc.build_cache_instance.RunnerSlotIdentity) -> String {
  let idx = slot.slot_index
  let two = if idx < 10 { join(["0", to_string(idx)], "") } else { to_string(idx) }
  join([slot.host as String, "-", two], "")
}

fn runner_slot_unit_name(slot: gunbc.build_cache_instance.RunnerSlotIdentity) -> std.types.NonEmptyStr {
  join(["actions-runner@", runner_slot_instance_name(slot: slot), ".service"], "") as std.types.NonEmptyStr
}

fn runner_slot_dir_path(slot: gunbc.build_cache_instance.RunnerSlotIdentity) -> std.types.NonEmptyStr {
  join([actions_runner_base_dir, "/", runner_slot_instance_name(slot: slot)], "") as std.types.NonEmptyStr
}

data runner_slot_disk_budget_per_slot_note: String = "Conservative per-slot disk charge for width preflight on srv4 (operator 2026-08-06): seven slots on 500GB NVMe cannot silently fall back to the historical five-slot pin. Derived from srv4_runner_count_disk_cap_note arithmetic (~38GB per slot at width 7 on 500GB class disk). Unobservable disk REFUSES; insufficient headroom REFUSES — never absorbs to width 5."

data runner_slot_disk_budget_per_slot: std.measure.ByteSize = byte_size(40960000000)

fn runner_width_disk_required(requested_width: Int) -> std.measure.ByteSize {
  byte_size(count: requested_width * byte_size_count(b: runner_slot_disk_budget_per_slot))
}

type RunnerWidthDiskPreflight
  = DiskHeadroomSufficient { requested_width: Int, required: std.measure.ByteSize, observed_free: std.measure.ByteSize }
  | DiskHeadroomInsufficient { requested_width: Int, required: std.measure.ByteSize, observed_free: std.measure.ByteSize }
  | DiskHeadroomUnobserved { requested_width: Int, reason: String }

fn runner_width_disk_preflight(
  requested_width: Int,
  disk: gunbc.host_disk_observation.HostDiskObservation,
) -> RunnerWidthDiskPreflight {
  let required = runner_width_disk_required(requested_width: requested_width)
  match disk {
    DiskObserved { free_bytes: free } =>
      if byte_size_count(b: free) >= byte_size_count(b: required) {
        DiskHeadroomSufficient { requested_width: requested_width, required: required, observed_free: free }
      } else {
        DiskHeadroomInsufficient {
          requested_width: requested_width,
          required: required,
          observed_free: free,
        }
      }
    DiskUnobserved { reason: r } =>
      DiskHeadroomUnobserved { requested_width: requested_width, reason: r }
    DiskObservationRefused { detail: d } =>
      DiskHeadroomUnobserved { requested_width: requested_width, reason: d as String }
  }
}

type RunnerSlotLifecycleReceipt {
  slot: gunbc.build_cache_instance.RunnerSlotIdentity
  requested: Bool
  materialized: Bool
  active_unit: Bool
  registered: Bool
  online: Bool
  busy: Bool
  schedulable: Bool
}

type HostRunnerCapacityReceipt {
  host: product.placement_supply.HostIdentity
  requested_width: Int
  materialized_count: Int
  active_unit_count: Int
  registered_count: Int
  online_count: Int
  slots: List<RunnerSlotLifecycleReceipt>
}

fn host_runner_capacity_converged(receipt: HostRunnerCapacityReceipt) -> Bool {
  receipt.materialized_count == receipt.requested_width
    && receipt.active_unit_count == receipt.requested_width
    && receipt.registered_count == receipt.requested_width
    && receipt.online_count == receipt.requested_width
}

type RunnerLocalStateObservation
  = RunnerLocalStateObserved {
      slot: gunbc.build_cache_instance.RunnerSlotIdentity
      unit_active: Bool
      unit_busy: Bool
      runner_version: std.types.NonEmptyStr
    }
  | RunnerLocalStateUnobserved { slot: gunbc.build_cache_instance.RunnerSlotIdentity, reason: std.types.NonEmptyStr }

type GitHubRunnerRegistrationObservation
  = GitHubRunnerRegisteredOnline {
      slot: gunbc.build_cache_instance.RunnerSlotIdentity
      organization: std.types.NonEmptyStr
      ephemeral: Bool
      online: Bool
      busy: Bool
      runner_version: std.types.NonEmptyStr
      labels_match: Bool
    }
  | GitHubRunnerRegistrationPending { slot: gunbc.build_cache_instance.RunnerSlotIdentity, reason: std.types.NonEmptyStr }
  | GitHubRunnerRegistrationRefused { slot: gunbc.build_cache_instance.RunnerSlotIdentity, reason: std.types.NonEmptyStr }

