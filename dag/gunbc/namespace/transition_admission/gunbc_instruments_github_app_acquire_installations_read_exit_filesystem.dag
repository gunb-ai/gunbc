data gunbc_instruments_github_app_acquire_installations_read_exit_filesystem: TransitionAdmission = TransitionAdmission {
  label: "the deleted uses fs binder was the std.resources candidate for `Filesystem` in this function; the service it always meant is the only one left" as NonEmptyStr,
  subject: Binding {
    enclosing: decl_ref("gunbc.instruments.github_app_acquire", "installations_read_exit"),
    spelling: "Filesystem" as NonEmptyStr,
    expected_candidates: [
      decl_ref("extdeps.filesystem.filesystem_io", "Filesystem"),
    ],
  },
  disposition: TargetChanged,
  deletion_follow_up: NotAuthored,
  owner_pull_request: 11744 as UInt32,
}
