module gunbc.namespace.transition_admission.gunbc_instruments_github_app_acquire_persist_issued_credentials_filesystem

import std.types { NonEmptyStr, List }
import std.integer { UInt32 }
import std.decl_ref { decl_ref }
import gunbc.compiler_frontend_program_interlock { TargetChanged }
import gunbc.namespace.transition_admission { TransitionAdmission, Binding, NotAuthored }

// D13 cut (c) deleted this function's authored `uses` row, and with it the module's now-dead
// `import std.resources`. The bare name `Filesystem` had TWO candidate providers while that import
// stood -- the std.resources RESOURCE and the extdeps.filesystem.filesystem_io SERVICE, the homonym
// `gunbc.recurring_failure_mode` `service_import_emitted_beside_its_authored_binding` names -- and
// the call site always meant the service. Dropping the import removes the candidate nothing bound,
// so the spelling now denotes the one declaration it already denoted. Consumer: namespace-wave-admission.
data gunbc_instruments_github_app_acquire_persist_issued_credentials_filesystem: TransitionAdmission = TransitionAdmission {
  label: "the dead std.resources import left gunbc.instruments.github_app_acquire, so `Filesystem` names the service alone" as NonEmptyStr,
  subject: Binding {
    enclosing: decl_ref("gunbc.instruments.github_app_acquire", "persist_issued_credentials"),
    spelling: "Filesystem" as NonEmptyStr,
    expected_candidates: [
      decl_ref("extdeps.filesystem.filesystem_io", "Filesystem"),
    ],
  },
  disposition: TargetChanged,
  deletion_follow_up: NotAuthored,
  owner_pull_request: 11744 as UInt32,
}
