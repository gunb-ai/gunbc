module gunbc.namespace.transition_admission.v2_workflow_gunbc_invoke_step_emit_gunbc_invoke_refused_char_token_string

import std.types { NonEmptyStr, List }
import std.integer { UInt32 }
import std.decl_ref { decl_ref }
import gunbc.compiler_frontend_program_interlock { TargetChanged }
import gunbc.namespace.transition_admission { TransitionAdmission, Binding, NotAuthored }

// The refused-character token moved from the ambient kernel String to the declared structural
// carrier, and that is the WHOLE POINT of the change rather than a side effect of it. The
// sanitizer it feeds is now a map over the word's own characters (v2.std.text
// string_contains_char under list_flat_map), so the token has to be something a character map can
// return -- a FreeMonoid<Char>, introduced through the Unicode-scalar-sequence homomorphism at a
// QUALIFIED v2.std.text.String boundary. A kernel String there is a different type and the
// substitution does not typecheck, which is how this was found rather than chosen.
//
// The prior binding is <kernel>: the row carried no declaring module because the kernel type set
// is appended to every visible-name set. So this is a real target change on one leaf in one
// declaration, with no membership consequence -- v2.workflow.gunbc_invoke_step_emit already
// reaches v2.std.text for string_contains_char in the same change.
//
// Consumer: namespace-wave-admission on gunbc#11648.
data v2_workflow_gunbc_invoke_step_emit_gunbc_invoke_refused_char_token_string: TransitionAdmission = TransitionAdmission {
  label: "the invoke sanitizer's refused-character token is a structural Char sequence, not a kernel String" as NonEmptyStr,
  subject: Binding {
    enclosing: decl_ref("v2.workflow.gunbc_invoke_step_emit", "gunbc_invoke_refused_char_token"),
    spelling: "String" as NonEmptyStr,
    expected_candidates: [
      decl_ref("v2.std.text", "String"),
    ],
  },
  disposition: TargetChanged,
  deletion_follow_up: NotAuthored,
  owner_pull_request: 11648 as UInt32,
}
