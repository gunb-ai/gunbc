module gunbc.namespace_pool_independence

import std.types { FilePath, List }
import gunbc.namespace_clause_e_projection_law {
  lists_agree_at,
  ListsAgree,
  ListsDisagree,
  ListStructureBroken,
  direct_file_dependency_lists_eq,
}
import std.occurrence_binding_candidates {
  ReferenceDerivedDependencyProjection,
  ReferenceDerivedDependencyProjectionReady,
  ReferenceDerivedDependencyProjectionBindingRefused,
  ReferenceDerivedDependencyProjectionFileRefused,
  CrossFileBindingProvenance,
  DirectFileDependency,
  BoundReferenceProvider,
  BoundReferencePopulation,
  AllReferencesBound,
  ReferencePopulationRefused,
}

data namespace_pool_independence_note: String = "N3-C pool-independence comparison harness (namespace_pool_independence_lane_brief_note): compare two complete ReferenceDerivedDependencyProjection carriers for the same source subject — baseline versus perturbed with one unrelated loaded file added. Equality is over the full carrier (binding_provenance, file_dependencies, bound_population, refusal variant), never the deduplicated file list alone. Positive witnesses assemble baseline and perturbed closures independently via B0 assemble_cross_file_binding_closure and B1 reference_derived_dependency_projection_for_assembled_closure; per-clause RED controls remain hand-built."

data namespace_pool_independence_section_4c_finding_note: String = "§4c COMMENT-PATH FINDING — CLOSED RECEIPT, not an open defect. THE FORMER DEFECT (executed 2026-08-07, sole carrier #7996): referenced_module_paths_in_text byte-scanned source without skipping // lines, so a comment-only dotted module path changed closure discovery. Executed evidence at the time: baseline source `module test.probe\\nimport std.types { Bool }\\n` yielded referenced_module_paths_in_text=[]; the same source with `// std.occurrence_binding_candidates.foo\\n` inserted yielded [\"std.occurrence_binding_candidates\"]. Both closure consumers called the scanner (extend_with_reference_closure and reference_pull_paths_for_source), and remediation was deferred to B2 with no CI enrollment.\n\nTHE CONSTRUCTION THAT REPLACED IT: B2 landed. v1_compiler.cli_run annotation_erased_scan_text blanks annotation regions while preserving byte offsets and line structure, and referenced_module_paths_in_text now applies it as its FIRST statement. Erasure is one authority applied at each scan entry rather than a per-scanner comment rule, so the three raw-text scanners (referenced_module_paths_in_text, destructuring_bound_spans, bare_identifier_candidates) cannot drift apart on it. String literals were already skipped; annotations were the remaining unerased region.\n\nTHE DISCRIMINATING CONTROL, which is why this is a receipt and not an assertion: cli_run.rs a_dotted_module_path_in_an_annotation_is_not_a_dependency_edge carries BOTH arms — a module path named in an annotation produces no edge, and a real import of the SAME module still produces one. A one-armed test would have gone green against a scanner that had simply stopped finding anything.\n\nTHE CONSEQUENCE WORTH CARRYING FORWARD, because it is what a later reader needs rather than the history: annotation text is now correctly OUTSIDE the dependency graph, which puts it in the non-graph residue population — a module path, address or identifier named only in an annotation has no edge, so deleting what it names cannot make it refuse. That is the right behavior and it is also exactly why prose needs its own residue disposition rather than relying on deletion as its census.\n\nWHY THIS ROW SURVIVES ITS OWN DEFECT: it is kept as a receipt rather than deleted because the defect it records was found twice by two lanes through two different token shapes (a bare identifier and a dotted path), so the class is easier to reintroduce than to remember. The note previously asserted the defect in the PRESENT TENSE with remediation deferred, and stood that way after B2 landed — a present-tense false defect claim in a carrier other lanes read, which is the same stale-standing class it now guards against."

type PoolIndependenceFailure
  = SourceSubjectConsumerFileMismatch { expected: FilePath, found: FilePath }
  | RefusalOutcomeMismatch
  | BoundReferencePopulationMismatch
  | ReferenceOccurrenceIdentityMismatch
  | DeclarationOccurrenceIdentityMismatch
  | BindingProvenanceMismatch
  | FileDependencyMismatch

type PoolIndependenceVerdict
  = PoolIndependenceEstablished
  | PoolIndependenceRefused { failure: PoolIndependenceFailure }

fn bound_reference_provider_eq(
  left: BoundReferenceProvider,
  right: BoundReferenceProvider,
) -> Bool {
  left.reference_occurrence == right.reference_occurrence
    && left.declaration_occurrence == right.declaration_occurrence
    && left.consumer_module == right.consumer_module
    && left.provider_module == right.provider_module
}

fn cross_file_binding_provenance_eq(
  left: CrossFileBindingProvenance,
  right: CrossFileBindingProvenance,
) -> Bool {
  left.reference_occurrence == right.reference_occurrence
    && left.declaration_occurrence == right.declaration_occurrence
    && left.consumer_file == right.consumer_file
    && left.provider_file == right.provider_file
}

fn bound_reference_population_eq(
  left: BoundReferencePopulation,
  right: BoundReferencePopulation,
) -> Bool {
  match left {
    AllReferencesBound { providers: left_providers } =>
      match right {
        AllReferencesBound { providers: right_providers } =>
          match lists_agree_at(
            left: left_providers,
            right: right_providers,
            agree: bound_reference_provider_eq,
          ) {
            ListsAgree => true
            _ => false
          }
        ReferencePopulationRefused { first_failure: _, more_failures: _ } => false
      }
    ReferencePopulationRefused { first_failure: left_first, more_failures: left_more } =>
      match right {
        AllReferencesBound { providers: _ } => false
        ReferencePopulationRefused {
          first_failure: right_first,
          more_failures: right_more,
        } =>
          left_first == right_first && left_more == right_more
      }
  }
}

fn reference_occurrence_lists_agree(
  left: List<BoundReferenceProvider>,
  right: List<BoundReferenceProvider>,
) -> Bool {
  match lists_agree_at(
    left: left,
    right: right,
    agree: (a, b) => a.reference_occurrence == b.reference_occurrence,
  ) {
    ListsAgree => true
    _ => false
  }
}

fn declaration_occurrence_lists_agree(
  left: List<BoundReferenceProvider>,
  right: List<BoundReferenceProvider>,
) -> Bool {
  match lists_agree_at(
    left: left,
    right: right,
    agree: (a, b) => a.declaration_occurrence == b.declaration_occurrence,
  ) {
    ListsAgree => true
    _ => false
  }
}

fn provenance_lists_agree(
  left: List<CrossFileBindingProvenance>,
  right: List<CrossFileBindingProvenance>,
) -> Bool {
  match lists_agree_at(
    left: left,
    right: right,
    agree: cross_file_binding_provenance_eq,
  ) {
    ListsAgree => true
    _ => false
  }
}

fn pool_independence_source_subject_matches_provenance(
  source_subject: FilePath,
  provenances: List<CrossFileBindingProvenance>,
) -> Bool {
  fold(
    provenances,
    init: true,
    f: (acc, row) =>
      if acc && row.consumer_file == source_subject {
        true
      } else {
        false
      },
  )
}

fn pool_independence_compare_ready_fields(
  source_subject: FilePath,
  baseline_provenances: List<CrossFileBindingProvenance>,
  baseline_dependencies: List<DirectFileDependency>,
  baseline_population: BoundReferencePopulation,
  perturbed_provenances: List<CrossFileBindingProvenance>,
  perturbed_dependencies: List<DirectFileDependency>,
  perturbed_population: BoundReferencePopulation,
) -> PoolIndependenceVerdict {
  if !pool_independence_source_subject_matches_provenance(
    source_subject: source_subject,
    provenances: baseline_provenances,
  ) {
    match baseline_provenances |> first {
      Present { value: first_row } =>
        PoolIndependenceRefused {
          failure: SourceSubjectConsumerFileMismatch {
            expected: source_subject,
            found: first_row.consumer_file,
          },
        }
      Absent =>
        PoolIndependenceRefused { failure: BindingProvenanceMismatch }
    }
  } else {
    match baseline_population {
      AllReferencesBound { providers: baseline_providers } =>
        match perturbed_population {
          AllReferencesBound { providers: perturbed_providers } =>
            if !reference_occurrence_lists_agree(
              left: baseline_providers,
              right: perturbed_providers,
            ) {
              PoolIndependenceRefused {
                failure: ReferenceOccurrenceIdentityMismatch,
              }
            } else if !declaration_occurrence_lists_agree(
              left: baseline_providers,
              right: perturbed_providers,
            ) {
              PoolIndependenceRefused {
                failure: DeclarationOccurrenceIdentityMismatch,
              }
            } else if !provenance_lists_agree(
              left: baseline_provenances,
              right: perturbed_provenances,
            ) {
              PoolIndependenceRefused { failure: BindingProvenanceMismatch }
            } else {
              match direct_file_dependency_lists_eq(
                left: baseline_dependencies,
                right: perturbed_dependencies,
              ) {
                ListStructureBroken =>
                  PoolIndependenceRefused { failure: FileDependencyMismatch }
                ListsDisagree =>
                  PoolIndependenceRefused { failure: FileDependencyMismatch }
                ListsAgree =>
                  if bound_reference_population_eq(
                    left: baseline_population,
                    right: perturbed_population,
                  ) {
                    PoolIndependenceEstablished
                  } else {
                    PoolIndependenceRefused {
                      failure: BoundReferencePopulationMismatch,
                    }
                  }
              }
            }
          ReferencePopulationRefused { first_failure: _, more_failures: _ } =>
            PoolIndependenceRefused {
              failure: BoundReferencePopulationMismatch,
            }
        }
      ReferencePopulationRefused { first_failure: _, more_failures: _ } =>
        PoolIndependenceRefused {
          failure: BoundReferencePopulationMismatch,
        }
    }
  }
}

fn assess_pool_independent_projection_equality(
  source_subject: FilePath,
  baseline: ReferenceDerivedDependencyProjection,
  perturbed: ReferenceDerivedDependencyProjection,
) -> PoolIndependenceVerdict {
  match baseline {
    ReferenceDerivedDependencyProjectionReady {
      binding_provenance: baseline_provenances,
      file_dependencies: baseline_dependencies,
      bound_population: baseline_population,
    } =>
      match perturbed {
        ReferenceDerivedDependencyProjectionReady {
          binding_provenance: perturbed_provenances,
          file_dependencies: perturbed_dependencies,
          bound_population: perturbed_population,
        } =>
          pool_independence_compare_ready_fields(
            source_subject: source_subject,
            baseline_provenances: baseline_provenances,
            baseline_dependencies: baseline_dependencies,
            baseline_population: baseline_population,
            perturbed_provenances: perturbed_provenances,
            perturbed_dependencies: perturbed_dependencies,
            perturbed_population: perturbed_population,
          )
        ReferenceDerivedDependencyProjectionBindingRefused { population: _ } =>
          PoolIndependenceRefused { failure: RefusalOutcomeMismatch }
        ReferenceDerivedDependencyProjectionFileRefused {
          first_failure: _,
          more_failures: _,
        } =>
          PoolIndependenceRefused { failure: RefusalOutcomeMismatch }
      }
    ReferenceDerivedDependencyProjectionBindingRefused { population: baseline_population } =>
      match perturbed {
        ReferenceDerivedDependencyProjectionBindingRefused {
          population: perturbed_population,
        } =>
          if bound_reference_population_eq(
            left: baseline_population,
            right: perturbed_population,
          ) {
            PoolIndependenceEstablished
          } else {
            PoolIndependenceRefused {
              failure: BoundReferencePopulationMismatch,
            }
          }
        _ => PoolIndependenceRefused { failure: RefusalOutcomeMismatch }
      }
    ReferenceDerivedDependencyProjectionFileRefused {
      first_failure: baseline_first,
      more_failures: baseline_more,
    } =>
      match perturbed {
        ReferenceDerivedDependencyProjectionFileRefused {
          first_failure: perturbed_first,
          more_failures: perturbed_more,
        } =>
          if baseline_first == perturbed_first && baseline_more == perturbed_more {
            PoolIndependenceEstablished
          } else {
            PoolIndependenceRefused { failure: RefusalOutcomeMismatch }
          }
        _ => PoolIndependenceRefused { failure: RefusalOutcomeMismatch }
      }
  }
}

fn assess_file_dependencies_only_equality(
  baseline: ReferenceDerivedDependencyProjection,
  perturbed: ReferenceDerivedDependencyProjection,
) -> Bool {
  match baseline {
    ReferenceDerivedDependencyProjectionReady {
      file_dependencies: baseline_dependencies,
      binding_provenance: _,
      bound_population: _,
    } =>
      match perturbed {
        ReferenceDerivedDependencyProjectionReady {
          file_dependencies: perturbed_dependencies,
          binding_provenance: _,
          bound_population: _,
        } =>
          match direct_file_dependency_lists_eq(
            left: baseline_dependencies,
            right: perturbed_dependencies,
          ) {
            ListsAgree => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}
