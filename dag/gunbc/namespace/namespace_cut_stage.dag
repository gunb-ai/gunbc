module gunbc.namespace_cut_stage

import std.types { String, NonEmptyStr, Bool, List }
import gunbc.compiler_frontend_program_interlock {
  ProgramMilestone,
  SelfHostRatchetGateEnrolled,
  NamespaceWaveAdmissionEnrolled,
  NamespaceBaselineObservationComplete,
}

// THE NAMESPACE-XL SERIAL CHAIN, AS A CLOSED VARIANT WITH A TOTAL PREREQUISITE FUNCTION.
// This is the namespace cut's own stage grain -- finer than the interlock's ProgramMilestone rows
// and NOT a second spelling of them: the interlock braids the namespace program against self-host
// at milestone grain, while this chain sequences the cut's own execution. The two join where the
// operator ruled they join (act0_release_milestones below, at ACT-0's RELEASE grain), and nowhere
// else.
//
// NAMING: these stages are the NAMESPACE-XL chain. An unrelated self-host chain also spells its
// work items XL-N (gunbc#9669/#9672-#9675); the variants here are namespaced (StageXL5Waves, not
// XL5) so the two vocabularies cannot collide in one corpus.
//
// The same construction rule as milestone_prerequisites applies and is restated because it is the
// whole point of the carrier: prerequisites are a TOTAL function over a CLOSED variant, so a newly
// declared stage refuses to compile until its prerequisites are stated -- an unstated-prerequisite
// stage is unwritable rather than checked. And the standing obligation the interlock records
// transfers with it: before adding a variant, ask whether it carries two facts that would state
// different prerequisites if separated; if it does, it is two variants.
type NamespaceCutStage
  = StageF0
  | StageXL0Denominator
  | StageXL1BaselineCapture
  | StageXL2RootDeletionRehearsal
  | StageXL3DeclaringIdentitySpelling
  | StageXL4ReferenceDerivedGraph
  | StageAct0ActivationGate
  | StageXL5Waves
  | StageXL6AtomicCutover
  | StageXL7GrammarDeletion

fn namespace_cut_stage_label(s: NamespaceCutStage) -> NonEmptyStr {
  match s {
    StageF0 => "F-0: truthful namespace control plane -- stage chain, subject roster, derived wave-wall enrolment" as NonEmptyStr
    StageXL0Denominator => "XL-0: repair-input origin denominator -- source-declaration carriers plus rendered target-vocabulary carriers, separately typed, over one base, before eligibility or repair disposition" as NonEmptyStr
    StageXL1BaselineCapture => "XL-1: capture capability -- the capture transaction can mint a joint binding+repair observation over one exact base; persistence against a named base is the baseline milestone, not this stage" as NonEmptyStr
    StageXL2RootDeletionRehearsal => "XL-2: root-deletion rehearsal -- the cut executed in a throwaway tree, its failure roster captured as the census" as NonEmptyStr
    StageXL3DeclaringIdentitySpelling => "XL-3: declaring-identity spelling -- every reference spelled as the fully qualified declaring identity" as NonEmptyStr
    StageXL4ReferenceDerivedGraph => "XL-4: reference-derived graph -- dependency edges derived from resolved reference targets, never declared" as NonEmptyStr
    StageAct0ActivationGate => "ACT-0: activation gate -- collecting activation evidence may BEGIN once XL-4 delivers; RELEASING the waves additionally requires the interlock triple and every digest re-executed against the pinned base B" as NonEmptyStr
    StageXL5Waves => "XL-5: the semantic waves -- exact occurrence and import-declaration rewrites under the wave-admission wall, while the legacy semantic root still stands" as NonEmptyStr
    StageXL6AtomicCutover => "XL-6: atomic cutover -- every root authority deleted in ONE motion, the whole semantic transition" as NonEmptyStr
    StageXL7GrammarDeletion => "XL-7: grammar deletion, LAST -- import becomes a typed, located parse error (gunbc.namespace_cut_landing_order namespace_cut_grammar_last_ruling)" as NonEmptyStr
  }
}

// DIRECT EDGES ONLY; the closure is derived, never restated. The chain is serial by operator
// design -- each stage's evidence is an input to the next -- so each row names its predecessor
// and nothing else. StageXL7GrammarDeletion last realizes the grammar-last ruling structurally:
// its position in this chain is DERIVED from these edges, and a reordering is an edit to exactly
// one row rather than a prose migration.
fn stage_prerequisites(s: NamespaceCutStage) -> List<NamespaceCutStage> {
  match s {
    StageF0 => []
    StageXL0Denominator => [StageF0]
    StageXL1BaselineCapture => [StageXL0Denominator]
    StageXL2RootDeletionRehearsal => [StageXL1BaselineCapture]
    StageXL3DeclaringIdentitySpelling => [StageXL2RootDeletionRehearsal]
    StageXL4ReferenceDerivedGraph => [StageXL3DeclaringIdentitySpelling]
    StageAct0ActivationGate => [StageXL4ReferenceDerivedGraph]
    StageXL5Waves => [StageAct0ActivationGate]
    StageXL6AtomicCutover => [StageXL5Waves]
    StageXL7GrammarDeletion => [StageXL6AtomicCutover]
  }
}

// WHERE THE CHAIN JOINS THE INTERLOCK, AND AT WHICH OF ACT-0'S TWO FACTS.
//
// This used to be stage_milestone_prerequisites: the interlock triple stated as ACT-0's
// PREREQUISITE, which made the gate unstartable until three program milestones cleared. That
// fused two facts the gate keeps apart, and the fusion had a direction -- it said nobody may
// COLLECT activation evidence until the interlock is clear, when what the ruling actually
// requires is that nobody may RELEASE THE WAVES until it is.
//
// "May begin collecting evidence" and "may release the waves" are two facts, so they are two
// derivations over two populations. Startability is the chain edge alone (ACT-0 becomes startable
// when XL-4 delivers). RELEASE is ACT-0's own STANDING, over the union of this roster and the
// activation receipts below -- read by gunbc.compiler_frontend_program_status's ACT-0 arm, which
// is the module that can evaluate a milestone. A milestone in this roster whose standing is
// itself unanswerable makes ACT-0 unanswerable rather than merely outstanding: the two are kept
// apart there for the same reason they are kept apart here.
//
// The roster is DATA and not a per-stage total function, because exactly one stage has this join
// and a total function over the chain would have returned the empty list for nine stages -- a
// fold permanently green on nine of ten inputs, which DESIGN section 4b calls a decoration rather
// than a weak wall. The stage it belongs to is named in its own name.
data act0_release_milestones: List<ProgramMilestone> = [
  SelfHostRatchetGateEnrolled,
  NamespaceWaveAdmissionEnrolled,
  NamespaceBaselineObservationComplete,
]

data namespace_cut_stages: List<NamespaceCutStage> = [
  StageF0,
  StageXL0Denominator,
  StageXL1BaselineCapture,
  StageXL2RootDeletionRehearsal,
  StageXL3DeclaringIdentitySpelling,
  StageXL4ReferenceDerivedGraph,
  StageAct0ActivationGate,
  StageXL5Waves,
  StageXL6AtomicCutover,
  StageXL7GrammarDeletion,
]

fn namespace_cut_stage_is(a: NamespaceCutStage, b: NamespaceCutStage) -> Bool {
  (namespace_cut_stage_label(s: a) as String) == (namespace_cut_stage_label(s: b) as String)
}

// ---------------------------------------------------------------------------------------------
// TWO KINDS OF EVIDENCE, AND CONFLATING THEM MADE THE CHAIN CIRCULAR.
//
// XL-2 and XL-4 used to clear on ACT-0's activation receipts. ACT-0 runs AFTER XL-4, and an
// activation receipt is by definition produced against a base the manager pins at ACT-0, so those
// two stages could only clear after the stage they precede had already run. A serial chain whose
// earlier stages are gated on a later stage's output is not a strong ordering, it is a chain that
// can never start, and it read as ordinary Outstanding work the whole time.
//
// The repair is that a stage's deliverable and a gate's evidence are DIFFERENT FACTS about the
// same instrument:
//
//   STAGE DELIVERY EVIDENCE -- the instrument exists and has been discriminated once, anywhere.
//     This is what a stage OWES. It is ordinary engineering output, it survives main moving, and
//     it is what clears XL-2 and XL-4.
//   ACTIVATION EVIDENCE -- that same instrument re-executed against ONE pinned activation base,
//     digested. This is what the GATE owes, it is consumed by ACT-0 and by nothing else, and it
//     does not survive main moving.
//
// The delivery receipt is therefore NOT a weaker activation receipt and must never be accepted in
// its place: it carries no base, because it makes no claim about one. That is the whole
// distinction, expressed as a missing field rather than as a rule about when to trust a field.
// ---------------------------------------------------------------------------------------------
type StageDeliveryEvidenceKind
  = RehearsalInstrumentDelivered
  | ReferenceGraphInstrumentDelivered

fn stage_delivery_evidence_label(k: StageDeliveryEvidenceKind) -> String {
  match k {
    RehearsalInstrumentDelivered => "XL-2 rehearsal instrument delivered and discriminated once"
    ReferenceGraphInstrumentDelivered => "XL-4 reference-graph instrument delivered and discriminated once"
  }
}

// A delivery receipt names the producer a reader re-runs -- DESIGN section 6, name the instrument
// rather than transcribing its output -- and the discriminating run that showed it can report the
// wrong answer. It carries NO base: see above.
type StageDeliveryReceipt {
  kind: StageDeliveryEvidenceKind
  producer: NonEmptyStr
  discriminated_by: NonEmptyStr
}

data required_stage_delivery_evidence_kinds: List<StageDeliveryEvidenceKind> = [
  RehearsalInstrumentDelivered,
  ReferenceGraphInstrumentDelivered,
]

// Empty: neither instrument is delivered. XL-4's reference-graph instrument exists, but on the
// production ingest route it emits no reference-derived edge for any fixture, so it has no accepted
// positive control there (review 64925 on gunbc#11202). A receipt discriminated only over hand-built
// roots would inflate the rung (DESIGN 4b(1)). The row lands when tools.reference_derived_graph main
// exits success on the production route, which requires its positive control.
// XL-0 OWES NO DELIVERY RECEIPT AND HAS NO DELIVERY KIND ON THIS CHANNEL, AND THAT WAS TESTED A
// THIRD TIME ON gunbc#11582: one head restored DenominatorRosterInstrumentDelivered with a receipt
// discriminated on the production route, and review 67708 showed the discriminator was the roster's
// SPELLING-DERIVED declared arm (v2.compiler.resolution_provenance) while the compiler resolver
// refuses the same reference -- a delivery of a second authority, not of the denominator. The kind
// and receipt were withdrawn again in the same PR. XL-0's readiness is the instrument question and
// nothing else, and the instrument now missing is named typed in
// gunbc.compiler_frontend_program_status: ResolverBoundDeclaringIdentity. If XL-0 ever owes this
// channel, the kind comes back WITH the standing that reads it, in the same change.
// THE RECEIPT THAT STOOD HERE WAS WITHDRAWN, BY EXECUTION, BEFORE IT EVER LANDED ON MAIN.
//
// WHAT IT CLAIMED: that v2.compiler.repair_input_origin_roster had been delivered and discriminated
// once. WHAT WAS TRUE: it had been discriminated against HAND-BUILT Node trees, and on the tree the
// production route actually yields it produced an EMPTY denominator -- zero mentions for a module
// that plainly contains them. A green witness over a universe the corpus never produces is DESIGN
// section 5's specification-without-execution wearing the costume of real execution, and a stage
// reading CLEAR off it would have reported a denominator that does not exist.
//
// ESTABLISHED BY EXECUTION, not by review: a substrate-only fixture drives the real ingest
// (v2.compiler.program_assembly module_roots_from_source_root_ingest, projected through
// v2.compiler.normalized_tree normalized_tree_roots_to_nodes), and the collector returns no sites
// at all. Independently reproduced by warm-ibex-518 over real .dag files, with and without
// normalize. The producer is named here so the next reader re-runs it rather than trusting this
// sentence: v2.test.claim.namespace_xl0.call_argument_mention_survival.
//
// WHAT THE PRODUCER ACTUALLY SEES ON THE PRODUCTION ROUTE, MEASURED OVER EVERY INGESTED ROOT
// (re-stated 2026-09-18; re-run the producer rather than trust this table):
//
//   REACHES IT:      a bare same-module value reference outside any call; a parameter reference;
//                    a bare type name in PARAMETER position;
//                    a QUALIFIED CROSS-MODULE reference in a body, outside any call, as ONE site;
//                    a QUALIFIED CROSS-MODULE type name in PARAMETER position
//   DOES NOT:        a call argument; a callee name (bare or dotted);
//                    a bare type name in FIELD position
//
// "A TYPE-POSITION NAME" IS TOO COARSE TO WRITE HERE, AND AN EARLIER REVISION OF THIS TABLE WROTE
// IT. The same bare spelling REACHES from a parameter and DOES NOT reach from a field, so a row
// naming "type position" without saying which one merges a class that works with a class that does
// not, and a trigger written against it would retire while half the class stayed dead. The producer
// that separates them is the same one this note names: its Xl0FieldOnly row is spelled bare and
// used in exactly one place, a field type, which isolates field position from qualification.
//
// THE CROSS-MODULE ROW WAS WHY XL-0 HAD NO DENOMINATOR, and it is not the same fact as the call
// erasure. An import-to-containment denominator is made of references that CROSS a module
// boundary; a bare same-module name resolves inside its own module and contributes nothing. That
// row now reaches, and the roster producer answers over it -- with spelling-derived declaring
// identities, which is why XL-0 still does not derive; the roster RUN over the pinned base is
// ACT-0's.
//
// THREE CAUSES HAVE BEEN SEPARATED SO FAR, AND THE TRIGGERS ARE NOT ONE TRIGGER:
//   1. MINE, FIXED: the collector's parse-projection exclusion skipped the subtree carrying a real
//      module's content, which blacked out the corpus while hand-built fixtures stayed green.
//   2. MINE, FIXED: its census folded the ingested roots while discarding the accumulator, so every
//      "is absent" row was measured over the LAST root alone. That one manufactured a reported miss
//      in PARAMETER type position that does not exist -- the row above is the corrected measurement.
//   3. ATTRIBUTED AND REPAIRED (smart-lynx-554, 2026-09-18): the qualified cross-module miss. It
//      was never a collector defect. The earliest unjustified boundary (DESIGN section 6b) was v2
//      body lowering, which read the first dot of a postfix chain as a BINARY OPERATOR and dropped
//      every later segment (`v2.test.p.value` reached the tree as Transform(dot, v2, test)), and
//      lowered a qualified type in parameter position to its first atom. Nothing in the v2 front
//      end constructed the fold-list spine the collector and the resolver both consume. The repair
//      is v2.compiler.body_lowering_fold body_lower_dotted_reference_optional and its type-position
//      twin; the class is rostered as gunbc.recurring_failure_mode
//      dotted_reference_truncated_at_v2_body_lowering. Whether resolution reads the chain is now
//      ANSWERED by execution: v2.test.claim.namespace_xl0.cross_module_reference_resolution -- a
//      declared cross-module fn target is FOUND and refused identity-unrepresentable (the resolver
//      carries no exact declaring identity yet), an undeclared one refuses unbound, a same-module
//      control stays Accepted. A dotted CALLEE (last segment with a call or brace suffix) is the
//      call class, not this one.
//
//   4. OPEN, ATTRIBUTED TO THE TREE, NOT REPAIRED HERE: the bare FIELD-position miss. It is a
//      fourth class rather than a dotted case, because the spelling that misses carries no dot.
//      The mechanism was located in v2.compiler.namespace_graft (the body fold, now
//      namespace_graft_body_for_graft): it flattened the module body to Named declaration edges,
//      which only a fn_decl yielded (body lowering rehomes fn_decl under its name and rehomes
//      nothing else), and fell back to raw dag_surface_top_level_item parse shells only when that
//      flattening was EMPTY. So a module with any fn DROPPED its type and data declarations
//      silently, and a module with none kept them as raw shells that resolve walked as bare
//      mentions. Two silent arms chosen by an unrelated declaration's presence is the absorbing
//      fallback of DESIGN section 5. The repair, landed as gunbc#11574, is the declaration-grafting
//      capability: every top-level unit is partitioned once (Named / residual / dissolved), so
//      type and data declarations are Named containment edges beside fns; the RECORD spelling
//      (field_decl_block) stays a residual shell under
//      gunbc.recurring_failure_mode.type_decl_field_decl_block_not_named_at_graft until body
//      lowering rehomes it, so the bare FIELD-position miss remains open there. Producer for the measurement:
//      v2.test.claim.namespace_xl0.field_type_tree_presence; the same loss is why a cross-module
//      reference to a DATA target still refuses (today-row in cross_module_reference_resolution).
//
// THE RESTORATION TRIGGER WAS THEREFORE NOT THE BODY-LOWERING REPAIR ALONE, and an earlier revision
// of this note said it was. Body lowering (XL-2, gunbc#11207) restores the call classes and NOTHING
// ELSE; the qualified cross-module class was independent of calls and has now landed on its own.
// A trigger naming less than the capability it restores gets retired while the capability stays
// dead, which DESIGN section 4b(3) names exactly. XL-0 derives when the roster's DECLARING
// identities are the resolver's bindings rather than spellings (ResolverBoundDeclaringIdentity in
// the status carrier); the producer answers on the production route today, and the base-pinned run
// of it is ACT-0's DenominatorRosterDigest, a separate later fact.
//
// XL-2 IS BLOCKED, AND UNTIL 2026-09-19 THIS BLOCK SAID NOTHING ABOUT IT. It explained XL-4's
// refused receipt and XL-0's withdrawn one at length and was silent on XL-2, which read as
// UNSTARTED -- and a lane (wise-pike-696) was dispatched to build the instrument on that reading.
// Outstanding never meant buildable: it means a named observed outstanding population, and the
// planner's inference "empty roster, therefore unstarted and otherwise buildable" was the
// planner's, not the variant's. This block exists to prevent that inference, not to recast every
// earlier Outstanding reading as false. Startability is the other axis and is unchanged by this:
// stage_startability reads only the chain, so XL-2 reports chain-startable off XL-1 while its own
// standing is NotDerivable -- current capability, delivery evidence and chain position are three
// facts and stay three.
//
// WHAT BLOCKS THE PRODUCER IS STATED ONCE, AND NOT HERE. The analysis -- the known necessary
// prerequisites (calls and arguments at body lowering, field-position types at graft, a census
// mode that resolves per module), the occurrence-completeness obligation, the residual's mixed
// occurrence-id key, and why the Step-0 canary is not the instrument -- is the label of
// gunbc.compiler_frontend_program_status missing_instrument_label ExactOccurrenceResidualCensus,
// and the XL-2 arm there (xl2_stage_standing over rehearsal_producer_standing) reads NotDerivable
// on that cause while the delivery roster below is empty, and reads the roster the moment a
// rehearsal receipt lands. A first revision of this note restated that analysis in three places
// and the copies disagreed within a day about which entry omits resolve; the label is the home
// and this note cites it. What this note carries is what belongs to the STAGE and to executing
// its cut, which the label does not own:
//
//   THE STRIP HALF EXISTS AND IS TYPED: std.import strip_import_statements, applied per source by
//   gunbc.namespace_step0_strip_producer. The census half is the v2 production route over the
//   stripped tree; the instrument is the strip fold composed with a route that carries the
//   prerequisites the label names and answers its completeness obligation, and its FIRST
//   discriminated run on the production route is the receipt this row holds.
//
//   THE REHEARSAL TREE'S ROOTS KEEP PRODUCTION'S RELATIVE SPELLINGS -- a precaution whose
//   discriminator is currently dead, stated at exactly that strength (vivid-lark-741, 2026-09-19,
//   gunbc#11738). Mechanism, real: v2.compiler.source_authority source_root_for_storage_path
//   classifies a read's tree by a TEXTUAL prefix on the path as walked (`src/` is V2Tree, else
//   DagTree), so a stripped copy read at an absolute scratch path classifies every file as
//   DagTree and v2.std.cross_tree.resolution cross_tree_edge_decision answers
//   EdgeNormalResolution where the real tree would deny. Outcome, unobserved: that lane's
//   census-resolve over the whole tree found resolve_cross_tree_import_denied ZERO times (most
//   modules refuse earlier on unbound symbols), and its three-arm differential (real tree /
//   path-faithful copy / absolute-path copy) was byte-identical -- a prediction that the denial
//   would appear was FALSIFIED. Not a demonstrated defect; kept because it costs a worktree
//   checkout and stops being free when the unbound residual closes: the rehearsal tree is a
//   worktree whose roots are passed as `dag` and `src/v2` with the process cwd inside it.
//
//   COST, since it decides whether the rehearsal can take this at all: the same run measured
//   census-resolve at the cost census mode already pays, the resolve half a fraction of a percent
//   of it (figures on gunbc#11738; re-derive, do not copy). The adjudicate baseline that
//   gunbc.rung_drop v2_native_route_off_the_merge_path records does NOT transfer -- adjudicate
//   pays infer plus per-declaration eval and a census pays neither; an earlier revision of this
//   note extrapolated a multi-hour instrument from it, which overstated it.
//
// Empty by construction again, and honestly so: no stage delivery instrument is delivered. XL-0's
// producer exists and answers on the production route (gunbc#11582), but its declared identities
// are spelling-derived, so it is not a delivery of XL-0's denominator (see above). XL-2's
// instrument is unbuilt because its census half has no honest producer yet (see above; the
// analysis is on ExactOccurrenceResidualCensus).
data held_stage_delivery_receipts: List<StageDeliveryReceipt> = []

fn stage_delivery_outstanding(held: List<StageDeliveryReceipt>) -> List<String> {
  required_stage_delivery_evidence_kinds
    |> filter(k => !any(held, r => stage_delivery_evidence_label(k: r.kind) == stage_delivery_evidence_label(k: k)))
    |> map(k => stage_delivery_evidence_label(k: k))
}

// One kind's outstanding view, for the stage that owes exactly that delivery.
fn stage_delivery_kind_outstanding(kind: StageDeliveryEvidenceKind, held: List<StageDeliveryReceipt>) -> List<String> {
  stage_delivery_outstanding(held: held)
    |> filter(label => label == stage_delivery_evidence_label(k: kind))
}

// ---------------------------------------------------------------------------------------------
// ACT-0'S POPULATION: THE RECEIPTS THE GATE MUST HOLD TO RELEASE. The activation gate is not a
// deletion stage and carries no subjects; whether it may RELEASE is derived from whether each
// required receipt is held against the pinned activation base, joined with act0_release_milestones
// above. The receipt kinds are closed so the gate's denominator is a total fold, and the
// held-roster below is the SINGLE home a receipt lands in -- reading it empty is an observation of
// the carrier, not a guess about the world.
//
// RE-RUN, NEVER UPDATE: any source-relevant movement of main invalidates a pinned base, so a
// stale receipt is retired by deleting its row and re-running the producing stage against the
// new base. A receipt row is immutable once written; there is no arm for amending one.
// ---------------------------------------------------------------------------------------------
type ActivationReceiptKind
  = DenominatorRosterDigest
  | BaselineCaptureReceipt
  | RehearsalFailureRosterDigest
  | ReferenceGraphDigest

fn activation_receipt_kind_label(k: ActivationReceiptKind) -> String {
  match k {
    DenominatorRosterDigest => "XL-0 denominator roster digest over the activation base"
    BaselineCaptureReceipt => "XL-1 baseline capture receipt over the activation base"
    RehearsalFailureRosterDigest => "XL-2 rehearsal failure-roster digest over the activation base"
    ReferenceGraphDigest => "XL-4 reference-graph digest over the activation base"
  }
}

type ActivationReceipt {
  kind: ActivationReceiptKind
  activation_base_commit: NonEmptyStr
  digest: NonEmptyStr
}

data required_activation_receipt_kinds: List<ActivationReceiptKind> = [
  DenominatorRosterDigest,
  BaselineCaptureReceipt,
  RehearsalFailureRosterDigest,
  ReferenceGraphDigest,
]

// Empty by construction today: no activation base has been pinned. A row lands here only when
// the manager executes ACT-0.
data held_activation_receipts: List<ActivationReceipt> = []

// The gate's outstanding receipt population, at receipt-kind identity grain: every required kind
// not held. Parameterized on the held roster so a witness can author both the complete and the
// incomplete population (the fixture boundary is the boundary that decides, DESIGN 4b).
fn activation_receipts_outstanding(held: List<ActivationReceipt>) -> List<String> {
  required_activation_receipt_kinds
    |> filter(k => !any(held, r => activation_receipt_kind_label(k: r.kind) == activation_receipt_kind_label(k: k)))
    |> map(k => activation_receipt_kind_label(k: k))
}
