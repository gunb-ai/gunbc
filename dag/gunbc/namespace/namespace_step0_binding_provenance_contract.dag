module gunbc.namespace_step0_binding_provenance_contract

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.decl_ref { DeclarationRef }

// THIS ROW IS DECLARED AND NO PRODUCER INHABITS IT. Read that first and read it as the whole
// standing: nothing in this repository has observed a Step 0 binding-provenance census, this module
// contains no producer that could, and its existence is not evidence that the observation happened
// or is scheduled. It is the SPECIFICATION of an observation Step 0 owes -- the typed shape a
// producer would have to fill -- and a specification with no producer is exactly the
// specification-without-execution DESIGN section 5 names, which is why the standing is stated here
// rather than left to be inferred from the absence of a caller.
//
// WHY IT IS WRITTEN NOW, BEFORE ITS PRODUCER. gunbc.namespace_step0_canary_v2's receipt must say,
// in a typed field rather than in prose, that import dependence was NOT judged and WHAT would judge
// it; naming a successor honestly means citing a declaration, and a citation resolves only against
// something that exists. So the citation target is this contract -- a specification of the
// observation -- and never a producer nobody has written. The cheap half is the roster and the
// conservation laws below: they are what decides whether a later census can be believed, and they
// are expensive to reconstruct after the census exists and is already reporting numbers.
//
// WHAT IT IS NOT. It is not a plan, not a schedule, and not a claim on anyone's time. The program
// that fills it is Step 0 PROPER -- the complete reference-occurrence census with binding-source
// attribution -- and that program is not a prerequisite of anything: it is what Step 0 turns out
// to be once the subject has been collected and stripped.

// THE DENOMINATOR IS REFERENCE OCCURRENCES, NOT REMOVED EDGES, and the ordering matters more than
// it looks. An edge view counts import statements that disappeared; an occurrence view counts the
// places a name is USED, which is where a binding can silently change. Every removed-edge figure a
// census reports must therefore be a DERIVED PROJECTION over per-occurrence rows, so the edge view
// can never define the denominator -- once it does, an occurrence whose binding moved without any
// edge changing is outside the population and unfindable.
data step0_census_denominator_law: NonEmptyStr = "the census denominator is the set of discovered REFERENCE OCCURRENCES; any removed-edge or per-import figure is a derived projection over those rows and never the population itself" as NonEmptyStr

// THE REFERENCE-FAMILY ROSTER, FROZEN BEFORE ANY CORPUS RUN. A census is believable only if the
// families it must distinguish were named before the numbers existed; naming them afterwards lets
// the roster be shaped by what the run happened to produce.
//
// THE ROSTER IS ONE AXIS AND ONLY ONE: HOW THE REFERENCE WAS WRITTEN. An earlier cut carried
// SameSpellingInTwoModules beside TypeReference and OrdinaryFunctionCall, and that row is not a way
// of WRITING a reference at all -- it is a shape of the NAME POOL the reference resolves against.
// Holding both on one axis made the roster unable to say the true and more alarming thing, which is
// that a homonym can occur under ANY family. It now lives on the binding-topology axis in
// gunbc.namespace_step0_census_calibration, where it composes with all ten rows below rather than
// standing beside six of them.
//
// AND THE ROSTER IS NEVER INFERRED FROM OBSERVED ROWS. A roster derived from what the diagnostics
// produced can only contain what the instrument already sees, so it can never name the family the
// instrument is BLIND to -- which is the one a census exists to find. It is authored ahead of the
// run for that reason, and the instrument is measured against it rather than the other way round.
type Step0ReferenceFamily
  = TypeAnnotationReference
  | GenericTypeArgumentReference
  | TopLevelValueReference
  | FunctionValueReference
  | OrdinaryCallReference
  | NullaryConstructorReference
  | PayloadConstructorReference
  | VariantExpressionReference
  | VariantPatternReference
  | QualifiedContainmentReference

fn step0_reference_family_label(family: Step0ReferenceFamily) -> NonEmptyStr {
  match family {
    TypeAnnotationReference => "a type named in a declaration, a field, a parameter or a return position" as NonEmptyStr
    GenericTypeArgumentReference => "a type named as an argument of a generic container" as NonEmptyStr
    TopLevelValueReference => "a module-scope data declaration named as a value" as NonEmptyStr
    FunctionValueReference => "a function named WITHOUT applying it, so the value is the function itself" as NonEmptyStr
    OrdinaryCallReference => "a function named in call-head position and applied" as NonEmptyStr
    NullaryConstructorReference => "a constructor with no payload, named as a value" as NonEmptyStr
    PayloadConstructorReference => "a constructor applied to a payload, in record-construction form" as NonEmptyStr
    VariantExpressionReference => "a coproduct variant named bare in expression position" as NonEmptyStr
    VariantPatternReference => "a coproduct variant named bare in a match pattern, where a binder of the same spelling could shadow it" as NonEmptyStr
    QualifiedContainmentReference => "a container.member reference resolved through containment" as NonEmptyStr
  }
}

data step0_reference_family_roster: List<Step0ReferenceFamily> = [
  TypeAnnotationReference,
  GenericTypeArgumentReference,
  TopLevelValueReference,
  FunctionValueReference,
  OrdinaryCallReference,
  NullaryConstructorReference,
  PayloadConstructorReference,
  VariantExpressionReference,
  VariantPatternReference,
  QualifiedContainmentReference
]

// THE DISCRIMINATOR IS PAIRED, BEFORE AND AFTER THE STRIP, per family. An after-only reading cannot
// tell a binding that never existed from one that moved.
data step0_family_discriminator_law: NonEmptyStr = "each family in the roster is observed as a PAIR -- the same occurrence before the strip and after it -- so a target that changed is distinguishable from one that was never bound; an after-only observation is not an observation of this class" as NonEmptyStr

// THE OUTCOME AXIS IS WIDER THAN THE ATTRIBUTION AXIS, and conflating them is how a census reports
// full coverage while measuring only its successes. v1_compiler's UnlistedImportBindingSource is the
// right SOURCE-ATTRIBUTION axis and must be REUSED rather than re-coined -- but it answers how a
// SUCCESSFUL binding was sourced and has no arms for unresolved, ambiguous, target-changed or
// unobserved. Those are outcomes, they belong in an outer result, and an occurrence that reached no
// outcome is Unobserved rather than absent.
type Step0OccurrenceOutcome
  = OccurrenceBound
  | OccurrenceUnresolved
  | OccurrenceAmbiguous
  | OccurrenceTargetChanged
  | OccurrenceUnobserved

// THE CONSERVATION LAWS. They are stated as rows rather than as a checker because no producer
// exists to check anything yet; when one lands, these are what it must satisfy, and the check is
// theirs to execute rather than this module's to promise.
//
// THE FOURTH IS A FREE LIVENESS CONTROL AND THE CHEAPEST ONE HERE. In a FULLY STRIPPED subject
// ListedImport must be uninhabited, because no import statement survives to list anything. A
// post-strip row reporting ListedImport therefore falsifies at least one of: the strip removed
// every applicable statement, the census observed the STRIPPED graph, the classifier read the
// correct graph, and the rows are bound to the correct source population. It costs one predicate
// and it discriminates four different ways of being wrong.
type Step0CensusConservationLaw
  = OccurrencesPartitionExactly
  | NoDuplicateDispositions
  | NoListedImportAfterAFullStrip
  | NoRowBoundToAForeignSubject

fn step0_conservation_law_statement(law: Step0CensusConservationLaw) -> NonEmptyStr {
  match law {
    OccurrencesPartitionExactly =>
      "discovered occurrences == bound + unresolved + ambiguous + target_changed + unobserved" as NonEmptyStr
    NoDuplicateDispositions =>
      "no occurrence carries two dispositions; duplicate dispositions == 0" as NonEmptyStr
    NoListedImportAfterAFullStrip =>
      "in a fully stripped subject, rows attributed to ListedImport == 0" as NonEmptyStr
    NoRowBoundToAForeignSubject =>
      "rows whose subject identity differs from the receipt's subject population identity == 0" as NonEmptyStr
  }
}

data step0_census_conservation_laws: List<Step0CensusConservationLaw> = [
  OccurrencesPartitionExactly,
  NoDuplicateDispositions,
  NoListedImportAfterAFullStrip,
  NoRowBoundToAForeignSubject
]

// THE IDENTITY FIELDS A CENSUS RECEIPT MUST CARRY. Each names a thing the census could otherwise be
// silently wrong about: which tree, which compiler, which population before and after the strip,
// which resolver policy answered the bindings, which roster the families came from, which row
// schema the rows were written against, and whether the observation finished.
type Step0CensusReceiptField
  = CensusSourceCommit
  | CensusSourceTree
  | CensusCompilerExecutable
  | CensusCollectorSubjectVectorIdentity
  | CensusPreStripPopulationIdentity
  | CensusStrippedPopulationIdentity
  | CensusResolverPolicyIdentity
  | CensusReferenceFamilyRosterIdentity
  | CensusRowSchemaIdentity
  | CensusCompletenessStanding

fn step0_census_receipt_field_reason(field: Step0CensusReceiptField) -> NonEmptyStr {
  match field {
    CensusSourceCommit => "which revision the census was taken at" as NonEmptyStr
    CensusSourceTree => "which content that revision held" as NonEmptyStr
    CensusCompilerExecutable => "which compiler answered the bindings; a different binary is a different oracle" as NonEmptyStr
    CensusCollectorSubjectVectorIdentity => "which collected population the census is about, named by the collector that produced it" as NonEmptyStr
    CensusPreStripPopulationIdentity => "the before half of every paired family observation" as NonEmptyStr
    CensusStrippedPopulationIdentity => "the after half, and the population the ListedImport control is asserted against" as NonEmptyStr
    CensusResolverPolicyIdentity => "which resolution policy was in force; bare-name recovery is policy-dependent and it is the mechanism under investigation" as NonEmptyStr
    CensusReferenceFamilyRosterIdentity => "which roster the families came from, so a census cannot silently drop a family it could not discriminate" as NonEmptyStr
    CensusRowSchemaIdentity => "which row shape the rows were written against, so a reader joining old and new rows refuses instead of mixing them" as NonEmptyStr
    CensusCompletenessStanding => "whether the observation finished; an incomplete census is not a smaller census" as NonEmptyStr
  }
}

data step0_census_receipt_fields: List<Step0CensusReceiptField> = [
  CensusSourceCommit,
  CensusSourceTree,
  CensusCompilerExecutable,
  CensusCollectorSubjectVectorIdentity,
  CensusPreStripPopulationIdentity,
  CensusStrippedPopulationIdentity,
  CensusResolverPolicyIdentity,
  CensusReferenceFamilyRosterIdentity,
  CensusRowSchemaIdentity,
  CensusCompletenessStanding
]

// A PROHIBITION THAT TRAVELS WITH THE CONTRACT, because it is the shortcut a producer author will
// reach for. UnlistedImportUse is advisory today (FloorNotYet). Flipping it to ENFORCED to make
// Step 0's result visible would change the acceptance path while measuring it and fuse census work
// with policy promotion -- two changes wearing one name, and the measurement is the one that
// silently becomes uninterpretable. Advisory status is exactly why the compile VERDICT cannot
// substitute for the attribution; it is not a reason to skip the attribution.
data step0_census_no_policy_promotion_rule: NonEmptyStr = "a census producer may not promote UnlistedImportUse from advisory to enforced in order to observe its own subject; the acceptance path may not be changed by the change that measures it" as NonEmptyStr

// AND THE EXISTING CENSUS'S COVERAGE IS NOT UNPROVEN -- IT IS REFUTED. This row was written as a
// caution: compile_clean_unlisted_import_census selects UnlistedImportUse rows from a masked
// type-name emission path, so its coverage of the family roster was UNESTABLISHED. That standing has
// been discharged in the harder direction. A calibration run over a hand-authored subject shows the
// reference-occurrence producer emitting no denominator row at all for two families of the roster,
// and emitting one for a named-argument label, which refers to no declaration. The population is
// therefore short real occurrences and long invented ones at the same time, and the two errors are
// over different populations and cannot cancel.
//
// WHY EVERY LAW ABOVE STAYS SATISFIED WHILE THAT IS TRUE, which is the part worth carrying forward:
// the denominator and the observations come from ONE walk. So the conservation laws balance BY
// CONSTRUCTION over whatever that walk produced, and a family it never emits is invisible to all of
// them. The anti-join cannot reach it either -- an anti-join needs a population to join against, and
// those occurrences were never in one. The unobserved-derivation law was written against a
// denominator derived from the DIAGNOSTIC; the same disease was sitting one layer above it, in a
// denominator derived from the observation walk.
//
// THE STANDING IS CITED AND NOT TRANSCRIBED. The verdict, the per-family observation table and the
// defect roster live in gunbc.namespace_step0_census_calibration, and the executing instrument that
// re-derives them is step0_calibration_probe in that module's witness. Copying its numbers here
// would put a second authority beside the one that measures them.
data step0_census_candidate_producer_standing: NonEmptyStr = "the reference-occurrence producer's coverage of the family roster is REFUTED, not merely unestablished: gunbc.namespace_step0_census_calibration records families for which it emits no denominator row and a non-reference for which it emits one, and that module's step0_calibration_standing is the sole authority for the verdict" as NonEmptyStr

// A STATEMENT COUNT IS NOT AN EDGE COUNT, AND THE DIFFERENCE IS NOT ROUNDING. The strip reports
// removed STATEMENTS, and a braced list binds several names in one statement -- so an edge or
// binding denominator derived from the statement figure is a different population wearing the same
// number. Worse, the natural derivation is from OBSERVED USES, and that erases exactly the names it
// should be counting: an imported binding with zero uses contributes no use to observe, so a
// use-derived census balances while the unused names inside multi-name statements vanish from it.
//
// So the removed-edge projection is a LEFT JOIN, not a filter: the complete imported-binding roster
// on the left, uses on the right, and zero-use bindings RETAINED with a zero. Anything else answers
// a question about uses and reports it as a question about imports.
data step0_removed_edge_projection_law: NonEmptyStr = "removed_statements is a STATEMENT-grain count and no edge or binding denominator may be derived from it; the removed-edge projection is the complete imported-binding roster LEFT JOINED to observed uses, retaining zero-use imported bindings, because a projection derived from uses alone silently erases the unused names inside multi-name import statements" as NonEmptyStr

// THE PRODUCER'S FIRST OBLIGATION IS A LIVENESS CONTROL, AND IT IS NOT OPTIONAL. On a totally
// stripped corpus the advisory diagnostic this candidate producer selects may vanish ENTIRELY --
// UnlistedImportUse is emitted about an import LIST, and a source with no import list can stop
// producing the row that names it. A producer that then returns zero has two indistinguishable
// readings, and they are opposite: "the corpus has no unlisted use" and "the instrument stopped
// seeing anything". So the ORDER of obligations is fixed here: emit a nonzero on a subject known to
// contain the class BEFORE any figure over the stripped corpus is read as a finding, and a zero
// without that control is a refusal ABOUT THE INSTRUMENT, never an observation of the corpus.
//
// The second reading is the absorbing fallback wearing a measurement's clothes -- the mechanism
// cannot see, so it reports the empty answer, and the empty answer is exactly what a clean corpus
// would look like.
// THE ZERO RULE IS DENOMINATOR-RELATIVE. "observed == 0 implies the instrument is broken" is as
// wrong as its opposite: a genuinely empty population is not an instrument defect. What decides
// between them is a denominator produced INDEPENDENTLY of the diagnostic -- the reference-occurrence
// population this contract's denominator law already fixes -- and the five states below are the
// total reading of (denominator, observed). Equality is still not admission: it is a necessary
// condition, and the sufficient one is that every occurrence has exactly one join.
type Step0CensusLivenessState
  = ReferencePopulationUnavailable
  | LegitimateEmptyPopulation
  | ProvenanceProducerSilent
  | ProvenanceCensusIncomplete
  | ProvenanceObservationOrphanedOrDuplicated

fn step0_census_liveness_state_statement(state: Step0CensusLivenessState) -> NonEmptyStr {
  match state {
    ReferencePopulationUnavailable =>
      "the reference-occurrence denominator could not be produced, so no reading of the observed figure is available in either direction" as NonEmptyStr
    LegitimateEmptyPopulation =>
      "the denominator is zero AND a total eligibility fold proves it zero, so an observed zero is the population and not a silence; a denominator merely absent does not reach this state" as NonEmptyStr
    ProvenanceProducerSilent =>
      "the denominator is nonzero and the producer observed nothing, which is a typed refusal ABOUT THE INSTRUMENT and never a finding that the corpus is clean" as NonEmptyStr
    ProvenanceCensusIncomplete =>
      "the producer observed fewer occurrences than the denominator carries, so the census has coverage debt and its figure is a lower bound rather than a measurement" as NonEmptyStr
    ProvenanceObservationOrphanedOrDuplicated =>
      "the producer observed more occurrences than the denominator carries, so an observation is orphaned or double-counted and the join is not one-to-one" as NonEmptyStr
  }
}

data step0_census_liveness_states: List<Step0CensusLivenessState> = [
  ReferencePopulationUnavailable,
  LegitimateEmptyPopulation,
  ProvenanceProducerSilent,
  ProvenanceCensusIncomplete,
  ProvenanceObservationOrphanedOrDuplicated
]

// AND Unobserved MAY NOT BE AUTHORED BY THE DIAGNOSTIC PRODUCER. A silent producer cannot report the
// occurrence it failed to see, so Unobserved is DERIVED by a total anti-join against the independent
// denominator. If occurrence discovery were itself derived from the diagnostic's own emissions, the
// diagnostic going silent would make the denominator zero and conservation would pass VACUOUSLY --
// the absorbing filter rebuilt one layer above the one subject collection just removed.
data step0_unobserved_derivation_law: NonEmptyStr = "Unobserved is never authored by the diagnostic producer and is derived by a total anti-join against a reference-occurrence denominator produced independently of that diagnostic; a denominator derived from the diagnostic's own emissions makes conservation pass vacuously the moment the diagnostic goes silent" as NonEmptyStr

type Step0CensusLivenessObligation
  = LivenessControlRequiredBeforeAnyFigure
  | ZeroWithoutLivenessIsAnInstrumentRefusal
  | ListedImportLivenessSubjectRequired

fn step0_census_liveness_obligation_statement(obligation: Step0CensusLivenessObligation) -> NonEmptyStr {
  match obligation {
    LivenessControlRequiredBeforeAnyFigure =>
      "before any census figure over a stripped population is read, the producer must emit a nonzero on a subject known to contain the class; a producer that has not been shown to emit at all has measured nothing" as NonEmptyStr
    ZeroWithoutLivenessIsAnInstrumentRefusal =>
      "an observed zero is read against the denominator, never on its own: with a nonzero denominator it is ProvenanceProducerSilent, a typed refusal about the instrument, and it is LegitimateEmptyPopulation only where a total eligibility fold proves the denominator zero" as NonEmptyStr
    ListedImportLivenessSubjectRequired =>
      "the liveness subject must exercise the LISTED-import path the diagnostic is attached to, since a totally stripped source may carry no import list for the diagnostic to be about" as NonEmptyStr
  }
}

data step0_census_liveness_obligations: List<Step0CensusLivenessObligation> = [
  LivenessControlRequiredBeforeAnyFigure,
  ZeroWithoutLivenessIsAnInstrumentRefusal,
  ListedImportLivenessSubjectRequired
]

// THE PRODUCER STANDING IS A TYPED FIELD OF THIS CONTRACT AND IS WRITABLE NOWHERE ELSE. An earlier
// draft had this contract and the canary's ImportDependenceNotJudged arm each state the same
// current-state fact in their own words -- two writable authorities for one fact, which is the
// meaning fork DESIGN section 3 forbids, arriving inside the change that exists to close one. So the
// standing lives HERE, once; the canary CITES this contract and DERIVES its consequence from this
// field rather than restating it.
type Step0BindingProvenanceProducerStanding
  = NoProducerInhabits
  | ProducerInhabits { producer: DeclarationRef }

type Step0BindingProvenanceReceiptContract {
  identity: NonEmptyStr
  denominator_law: NonEmptyStr
  family_discriminator_law: NonEmptyStr
  reference_families: List<Step0ReferenceFamily>
  conservation_laws: List<Step0CensusConservationLaw>
  receipt_fields: List<Step0CensusReceiptField>
  no_policy_promotion_rule: NonEmptyStr
  candidate_producer_standing: NonEmptyStr
  removed_edge_projection_law: NonEmptyStr
  liveness_obligations: List<Step0CensusLivenessObligation>
  liveness_states: List<Step0CensusLivenessState>
  unobserved_derivation_law: NonEmptyStr
  producer_standing: Step0BindingProvenanceProducerStanding
}

// THE CONTRACT ITSELF, LAST, SO ITS STANDING IS THE SENTENCE A READER LEAVES WITH: DECLARED, AND NO
// PRODUCER INHABITS IT. Everything above is the SHAPE an observation would have to take; nothing
// above is evidence that one was taken.
data step0_binding_provenance_receipt_contract: Step0BindingProvenanceReceiptContract = Step0BindingProvenanceReceiptContract {
  identity: "step0-binding-provenance-receipt-contract-v1" as NonEmptyStr,
  denominator_law: step0_census_denominator_law,
  family_discriminator_law: step0_family_discriminator_law,
  reference_families: step0_reference_family_roster,
  conservation_laws: step0_census_conservation_laws,
  receipt_fields: step0_census_receipt_fields,
  no_policy_promotion_rule: step0_census_no_policy_promotion_rule,
  candidate_producer_standing: step0_census_candidate_producer_standing,
  removed_edge_projection_law: step0_removed_edge_projection_law,
  liveness_obligations: step0_census_liveness_obligations,
  liveness_states: step0_census_liveness_states,
  unobserved_derivation_law: step0_unobserved_derivation_law,
  producer_standing: NoProducerInhabits
}

// THE ONE READER EVERY CONSUMER MUST GO THROUGH. A consumer asking "has this been observed" reads
// this fold rather than authoring its own sentence about the standing, so there is exactly one place
// the answer can change and exactly one place it can be wrong.
type Step0BindingProvenanceConsequence
  = BindingProvenanceUnobservable { detail: NonEmptyStr }
  | BindingProvenanceObservable { producer: DeclarationRef }

fn step0_binding_provenance_consequence() -> Step0BindingProvenanceConsequence {
  match step0_binding_provenance_receipt_contract.producer_standing {
    NoProducerInhabits => BindingProvenanceUnobservable {
      detail: "the Step 0 binding-provenance receipt contract is DECLARED and no producer inhabits it, so import dependence cannot be judged by any route in this repository" as NonEmptyStr
    }
    ProducerInhabits { producer: producer } => BindingProvenanceObservable { producer: producer }
  }
}
