module gunbc.namespace_step0_canary

import std.types { NonEmptyStr, Bool, List }
import std.content_hash { Sha256Digest }
import std.decl_ref { decl_ref }
import extdeps.git.object_store { GitObjectId, git_object_id_eq }

// THIS IS THE FROZEN STEP-0 CANARY, NOT A CENSUS AND NOT XL-1. It asks only whether the
// import-strip subject can be entered and, if it cannot, names the first transition that stopped.
// A prerequisite change may cite movement in a receipt produced by this contract; it may not edit
// this contract, the classifier below, the subject-entry rule, or the controls in
// test.claim.namespace_step0_canary_witness in the same change. A correction lands separately and
// establishes a new baseline. That separation is the stop rule: useful maintenance with no paired
// canary movement cannot delay Step 0 by calling itself a prerequisite.

type NamespaceStep0CanaryContract {
  identity: NonEmptyStr
  command: NonEmptyStr
  source_roots: List<NonEmptyStr>
  subject: NonEmptyStr
}

data namespace_step0_canary_contract: NamespaceStep0CanaryContract = NamespaceStep0CanaryContract {
  identity: "namespace-step0-strip-entry-canary-v1" as NonEmptyStr,
  command: "target/release/claim_batch --source-root dag --source-root src/v2 --entry dag/test/claim/namespace_step0_canary_witness_test.dag --functions current_main_step0_canary_receipt_is_admitted" as NonEmptyStr,
  source_roots: ["dag" as NonEmptyStr, "src/v2" as NonEmptyStr, "src/v1" as NonEmptyStr],
  subject: "every parsed DAG import statement in dag, src/v2, and src/v1, removed by a typed source rewrite before containment resolution is compiled" as NonEmptyStr
}

type NamespaceStep0CompletedTransition
  = CanaryContractFrozen
  | SourceTreePinned
  | CompilerExecutablePinned
  | InputSubjectManifestPinned
  | TypedImportStripApplied

type NamespaceStep0BlockingTransition
  = ApplyTypedImportStrip
  | CompileContainmentResolution

type NamespaceStep0BlockingCause
  = TypedSourceRewriteAndStripObservationProducerUnavailable {
      missing_operation: NonEmptyStr,
      missing_producer: NonEmptyStr
    }
  | ContainmentCompileObservationRefused { cause: NonEmptyStr }

type NamespaceStep0SubjectEntry
  = Step0SubjectEntered
  | Step0SubjectNotEntered

type NamespaceStep0ObservationCompleteness
  = Step0ObservationComplete
  | Step0ObservationIncomplete

type NamespaceStep0ObservedSubject
  = NoStep0Observation
  | Step0StripObservation {
      observed_tree: GitObjectId
      observed_manifest: NonEmptyStr
      observed_import_statements: List<NonEmptyStr>
    }

type NamespaceStep0CanaryReceipt sole_constructor {
  contract_identity: NonEmptyStr
  source_commit: GitObjectId
  source_tree: GitObjectId
  compiler_program: NonEmptyStr
  compiler_executable_sha256: Sha256Digest
  input_subject_manifest: NonEmptyStr
  completed_production_prefix: List<NamespaceStep0CompletedTransition>
  first_blocking_transition: NamespaceStep0BlockingTransition
  first_blocking_cause: NamespaceStep0BlockingCause
  subject_entry: NamespaceStep0SubjectEntry
  observation_completeness: NamespaceStep0ObservationCompleteness
  observed_subject: NamespaceStep0ObservedSubject
}

// FIXTURE-ONLY, AND NEVER A PRODUCTION ADVANCE ROUTE. This constructor exists solely so the
// canary's own witness can prove that a strictly longer frontier is inhabitable before production
// reaches it. The caller seal admits exactly that witness helper. Production may not mint
// SubjectEntered through it; the eventual strip producer must own a separate constructor whose
// inputs are the executed rewrite and its observation. Without that future producer, writing a
// receipt would be the section-5 escape hatch -- advancing the canary instead of doing the work.
fn namespace_step0_frontier_fixture_receipt(
  contract_identity: NonEmptyStr,
  source_commit: GitObjectId,
  source_tree: GitObjectId,
  compiler_program: NonEmptyStr,
  compiler_executable_sha256: Sha256Digest,
  input_subject_manifest: NonEmptyStr,
  observed_tree: GitObjectId,
  observed_import_statements: List<NonEmptyStr>
) -> NamespaceStep0CanaryReceipt
  admit_callers: [
    decl_ref(module_path: "test.claim.namespace_step0_canary_witness", decl_name: "frontier_receipt")
  ]
  = NamespaceStep0CanaryReceipt {
    contract_identity: contract_identity,
    source_commit: source_commit,
    source_tree: source_tree,
    compiler_program: compiler_program,
    compiler_executable_sha256: compiler_executable_sha256,
    input_subject_manifest: input_subject_manifest,
    completed_production_prefix: [CanaryContractFrozen, SourceTreePinned, CompilerExecutablePinned, InputSubjectManifestPinned, TypedImportStripApplied],
    first_blocking_transition: CompileContainmentResolution,
    first_blocking_cause: ContainmentCompileObservationRefused { cause: "fixture-only planted next-frontier compile observation" as NonEmptyStr },
    subject_entry: Step0SubjectEntered,
    observation_completeness: Step0ObservationIncomplete,
    observed_subject: Step0StripObservation {
      observed_tree: observed_tree,
      observed_manifest: input_subject_manifest,
      observed_import_statements: observed_import_statements
    }
  }

fn namespace_step0_malformed_fixture_receipt(
  contract_identity: NonEmptyStr,
  source_commit: GitObjectId,
  source_tree: GitObjectId,
  compiler_program: NonEmptyStr,
  compiler_executable_sha256: Sha256Digest,
  input_subject_manifest: NonEmptyStr
) -> NamespaceStep0CanaryReceipt
  admit_callers: [
    decl_ref(module_path: "test.claim.namespace_step0_canary_witness", decl_name: "entered_without_observation_receipt")
  ]
  = NamespaceStep0CanaryReceipt {
    contract_identity: contract_identity,
    source_commit: source_commit,
    source_tree: source_tree,
    compiler_program: compiler_program,
    compiler_executable_sha256: compiler_executable_sha256,
    input_subject_manifest: input_subject_manifest,
    completed_production_prefix: [CanaryContractFrozen, SourceTreePinned, CompilerExecutablePinned, InputSubjectManifestPinned],
    first_blocking_transition: ApplyTypedImportStrip,
    first_blocking_cause: TypedSourceRewriteAndStripObservationProducerUnavailable {
      missing_operation: "a typed parse-level source rewrite that removes one complete import statement" as NonEmptyStr,
      missing_producer: "an owned Step-0 producer that applies the rewrite and folds the resulting compile observation" as NonEmptyStr
    },
    subject_entry: Step0SubjectEntered,
    observation_completeness: Step0ObservationIncomplete,
    observed_subject: NoStep0Observation
  }

type NamespaceStep0ReceiptField
  = CanaryContractIdentityField
  | SourceCommitField
  | SourceTreeField
  | CompilerProgramField
  | CompilerExecutableField
  | InputSubjectManifestField
  | CompletedProductionPrefixField
  | FirstBlockingTransitionField
  | SubjectEntryField
  | ObservationCompletenessField
  | ObservedSubjectField

type NamespaceStep0CanaryAdmission
  = NamespaceStep0ReceiptAdmitted
  | NamespaceStep0ReceiptRefused {
      field: NamespaceStep0ReceiptField
      cause: NonEmptyStr
    }

fn namespace_step0_manifest_identity() -> NonEmptyStr {
  "roots=dag,src/v2,src/v1; syntax=parsed import statements including braced, single-name, and bare forms; action=remove each whole statement; successor=containment resolution; counts=non-authoritative" as NonEmptyStr
}

fn namespace_step0_unavailable_receipt(
  contract_identity: NonEmptyStr,
  source_commit: GitObjectId,
  source_tree: GitObjectId,
  compiler_program: NonEmptyStr,
  compiler_executable_sha256: Sha256Digest,
  input_subject_manifest: NonEmptyStr
) -> NamespaceStep0CanaryReceipt {
  NamespaceStep0CanaryReceipt {
    contract_identity: contract_identity,
    source_commit: source_commit,
    source_tree: source_tree,
    compiler_program: compiler_program,
    compiler_executable_sha256: compiler_executable_sha256,
    input_subject_manifest: input_subject_manifest,
    completed_production_prefix: [
      CanaryContractFrozen,
      SourceTreePinned,
      CompilerExecutablePinned,
      InputSubjectManifestPinned,
    ],
    first_blocking_transition: ApplyTypedImportStrip,
    first_blocking_cause: TypedSourceRewriteAndStripObservationProducerUnavailable {
      missing_operation: "a typed parse-level source rewrite that removes one complete import statement" as NonEmptyStr,
      missing_producer: "an owned Step-0 producer that applies the rewrite and folds the resulting compile observation" as NonEmptyStr
    },
    subject_entry: Step0SubjectNotEntered,
    observation_completeness: Step0ObservationIncomplete,
    observed_subject: NoStep0Observation
  }
}

// Admission is intentionally exact and narrow, but it is NOT frozen to today's frontier. The two
// coherent shapes are today's stop at the strip and the next possible stop after a real strip has
// entered the subject. That makes a longer prefix and a different blocker fixture-authorable now,
// before either exists in production. In particular, an empty observation cannot turn NotEntered
// into Entered, and a foreign tree cannot inherit this baseline merely because every other field
// agrees. Subject entry and completeness are checked separately because failure to reach the strip
// and failure to finish observing a reached strip have different remedies.
fn admit_namespace_step0_canary_receipt(
  receipt: NamespaceStep0CanaryReceipt,
  expected_commit: GitObjectId,
  expected_tree: GitObjectId,
  expected_compiler_sha256: Sha256Digest
) -> NamespaceStep0CanaryAdmission {
  if !(receipt.contract_identity == namespace_step0_canary_contract.identity) {
    NamespaceStep0ReceiptRefused { field: CanaryContractIdentityField, cause: "receipt names a foreign canary contract" as NonEmptyStr }
  } else if !git_object_id_eq(left: receipt.source_commit, right: expected_commit) {
    NamespaceStep0ReceiptRefused { field: SourceCommitField, cause: "receipt names a stale or foreign dispatch commit" as NonEmptyStr }
  } else if !git_object_id_eq(left: receipt.source_tree, right: expected_tree) {
    NamespaceStep0ReceiptRefused { field: SourceTreeField, cause: "receipt observation is bound to a foreign source tree" as NonEmptyStr }
  } else if !(receipt.compiler_program == "target/release/gunbc" as NonEmptyStr) {
    NamespaceStep0ReceiptRefused { field: CompilerProgramField, cause: "receipt names a different compiler program" as NonEmptyStr }
  } else if !(receipt.compiler_executable_sha256.hex == expected_compiler_sha256.hex) {
    NamespaceStep0ReceiptRefused { field: CompilerExecutableField, cause: "receipt names a different compiler executable" as NonEmptyStr }
  } else if !(receipt.input_subject_manifest == namespace_step0_manifest_identity()) {
    NamespaceStep0ReceiptRefused { field: InputSubjectManifestField, cause: "receipt input/subject manifest does not match the frozen contract" as NonEmptyStr }
  } else if receipt.completed_production_prefix == [
      CanaryContractFrozen,
      SourceTreePinned,
      CompilerExecutablePinned,
      InputSubjectManifestPinned,
    ] {
    match receipt.first_blocking_transition {
      CompileContainmentResolution => NamespaceStep0ReceiptRefused { field: FirstBlockingTransitionField, cause: "containment compilation cannot block before the strip transition completed" as NonEmptyStr }
      ApplyTypedImportStrip => match receipt.first_blocking_cause {
        ContainmentCompileObservationRefused { cause: _ } => NamespaceStep0ReceiptRefused { field: FirstBlockingTransitionField, cause: "strip blocker carries a containment-compile cause" as NonEmptyStr }
        TypedSourceRewriteAndStripObservationProducerUnavailable { missing_operation: op, missing_producer: producer } =>
          if !(op == "a typed parse-level source rewrite that removes one complete import statement" as NonEmptyStr)
            || !(producer == "an owned Step-0 producer that applies the rewrite and folds the resulting compile observation" as NonEmptyStr) {
            NamespaceStep0ReceiptRefused { field: FirstBlockingTransitionField, cause: "strip blocker cause does not name the frozen missing capabilities" as NonEmptyStr }
          } else { match receipt.subject_entry {
        Step0SubjectEntered => NamespaceStep0ReceiptRefused { field: SubjectEntryField, cause: "the Step 0 subject cannot be entered before the strip transition completes" as NonEmptyStr }
        Step0SubjectNotEntered => match receipt.observation_completeness {
          Step0ObservationComplete => NamespaceStep0ReceiptRefused { field: ObservationCompletenessField, cause: "an unentered subject cannot carry a complete observation" as NonEmptyStr }
          Step0ObservationIncomplete => match receipt.observed_subject {
            Step0StripObservation { observed_tree: _, observed_manifest: _, observed_import_statements: _ } => NamespaceStep0ReceiptRefused { field: ObservedSubjectField, cause: "an unentered subject cannot carry a planted strip observation" as NonEmptyStr }
            NoStep0Observation => NamespaceStep0ReceiptAdmitted
          }
        }
      } }
      }
    }
  } else if receipt.completed_production_prefix == [
      CanaryContractFrozen,
      SourceTreePinned,
      CompilerExecutablePinned,
      InputSubjectManifestPinned,
      TypedImportStripApplied,
    ] {
    match receipt.first_blocking_transition {
      ApplyTypedImportStrip => NamespaceStep0ReceiptRefused { field: FirstBlockingTransitionField, cause: "a completed strip cannot remain the first blocker" as NonEmptyStr }
      CompileContainmentResolution => match receipt.first_blocking_cause {
        TypedSourceRewriteAndStripObservationProducerUnavailable { missing_operation: _, missing_producer: _ } => NamespaceStep0ReceiptRefused { field: FirstBlockingTransitionField, cause: "containment-compile blocker carries the retired strip-unavailable cause" as NonEmptyStr }
        ContainmentCompileObservationRefused { cause: _ } => match receipt.subject_entry {
        Step0SubjectNotEntered => NamespaceStep0ReceiptRefused { field: SubjectEntryField, cause: "a completed strip must report that the Step 0 subject was entered" as NonEmptyStr }
        Step0SubjectEntered => match receipt.observation_completeness {
          Step0ObservationComplete => NamespaceStep0ReceiptRefused { field: ObservationCompletenessField, cause: "a receipt blocked on containment compilation cannot claim a complete observation" as NonEmptyStr }
          Step0ObservationIncomplete => match receipt.observed_subject {
            NoStep0Observation => NamespaceStep0ReceiptRefused { field: ObservedSubjectField, cause: "a completed strip must carry the observation that established subject entry" as NonEmptyStr }
            Step0StripObservation { observed_tree: observed_tree, observed_manifest: observed_manifest, observed_import_statements: observed_imports } =>
              if !git_object_id_eq(left: observed_tree, right: expected_tree) {
                NamespaceStep0ReceiptRefused { field: ObservedSubjectField, cause: "planted strip observation was taken from a different tree" as NonEmptyStr }
              } else if !(observed_manifest == namespace_step0_manifest_identity()) {
                NamespaceStep0ReceiptRefused { field: ObservedSubjectField, cause: "planted strip observation names a different manifest" as NonEmptyStr }
              } else if observed_imports == [] {
                NamespaceStep0ReceiptRefused { field: ObservedSubjectField, cause: "empty strip observation cannot establish that the Step 0 subject was entered" as NonEmptyStr }
              } else {
                NamespaceStep0ReceiptAdmitted
              }
          }
        }
      }
      }
    }
  } else {
    NamespaceStep0ReceiptRefused { field: CompletedProductionPrefixField, cause: "completed production prefix is neither the frozen baseline nor its immediate Step 0 successor" as NonEmptyStr }
  }
}
