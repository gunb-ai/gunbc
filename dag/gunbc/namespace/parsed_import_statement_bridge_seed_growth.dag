module gunbc.parsed_import_statement_bridge_seed_growth

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { String }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }

// Seed-growth obligation for the host bridge that carries the v1 parser's import-statement extents
// to the dag consumers that rewrite them. Homed beside the obligation it declares rather than in
// gunbc.seed_growth_admission, which owns the roster and the join.

data parsed_import_statement_bridge_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_interpreter", decl_name: "parsed_import_statements_value", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_interpreter", decl_name: "acquired_source_tokens_value", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "floor_source_inventory", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "floor_discovery_source_inventory", field: WholeDeclaration }
  ],
  reason: "PURPOSE: serves the v2 self-host census and import-deletion program under gunbc.v1_maintenance_standing.v1_seed_standing. The bridge carries the existing parser acquisition into std.import.ParsedImportObservation, with the consumer token instantiated as v2.std.compilers.lexing.Token. Its class preserves the seed TokenShape identity, its lexeme is sliced from the acquired NewlineIndex.char_codes at the acquired span, and import extents remain owned by v1.compiler.parse.parse_import_statement_extents. The former re-tokenization in v1.gunbc.parsed_import_statements is deleted. The source denominator is the same floor_source_inventory projection of the same source ingress used by required-floor preparation, before closure selection or witness policy; no filesystem roster or lexical scanner is added. Consumers classify sources and cause identities in .dag. The host declarations listed here only carry the existing values across the seed boundary. The dispatch additions modify existing seed items, and their lookup tables remain generated from gunbc.v1_interpreter_primitive_surface.",
  owning_dissolution_lane: "namespace-structural-observations" as RoadmapNodeId,
  trigger: "Delete these transports when an executing dag consumer can obtain the floor source ingress and its already-acquired lexical stream and parser-delimited import statements directly from the compiler that owns them, without a seed bridge. Reaching the parser symbol without carrying the first acquisition does not satisfy this trigger.",
  current_boundary: "v1_interpreter free_call.parsed_import_statements and free_call.floor_discovery_source_inventory; gunbc.parsed_import_statement_production; v2.workflow.floor_discovery_producer.floor_discovery_source_inventory; v1_compiler.cli_run.floor_source_inventory"
}
