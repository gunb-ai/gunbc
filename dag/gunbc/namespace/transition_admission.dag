module gunbc.namespace.transition_admission

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef }
import gunbc.compiler_frontend_program_interlock { NamespaceDeltaDisposition }

// The shape of one namespace transition admission. Admissions are CARRIED BY THE CHANGE THAT
// NEEDS THEM -- a transition_admission fenced block in one of that change's commit messages, holding
// one module `gunbc.namespace.transition_admission.<stem>` that imports this type -- and never by
// files in the tree.
//
// CONSUMERS (section 3c): v1_compiler.namespace_wave_admission load_carried_admissions folds the
// blocks of the commits base..head into the permission set for adjudicate, in the required-ci
// wave-admission phase; tree_carried_admission_refusal refuses any file under
// dag/gunbc/namespace/transition_admission/.
//
// WHY NOT THE TREE. The directory under this module was the roster from #11274 until this change.
// A row there was required at its owner's gate and consumed the moment the owner landed, so every
// row reached main already consumed and its deletion fell to whichever change touched the roster
// next: gunbc.recurring_failure_mode.consumed_admission_externalized_to_the_next_roster_touch.
// The two per-row debt fields -- deletion_follow_up and owner_pull_request -- existed only to
// track that debt, and are deleted with it: the owner of a carried row is the commit carrying it.
//
// EMPTY IS THE RESTING STATE, AND EMPTY IS NOT PERMISSIVE. A change carrying no block admits no
// extra delta: a run with no unadjudicated motion passes, a real TargetChanged with no block
// refuses.

// Binding.expected_candidates: candidate declaring identities, same type as enclosing. The wall
// join is module_path. decl_name must equal Binding.spelling (the relocated leaf); load refuses a
// mismatch so a phantom leaf cannot pass.
type AdmissionSubject
  = Binding {
      enclosing: DeclarationRef
      spelling: NonEmptyStr
      expected_candidates: List<DeclarationRef>
    }
  | Membership {
      from_module: NonEmptyStr
      target_module: NonEmptyStr
    }

type TransitionAdmission {
  label: NonEmptyStr
  subject: AdmissionSubject
  disposition: NamespaceDeltaDisposition
}
