module gunbc.roadmap_repo_atlas_sandbox

import std.types { Int, String, Bool, List }
import std.markup { Fragment, Element, FragmentText, Attribute, attr }
import gunbc.site.markup { txt, el, el_class, el_attrs }
import extdeps.languages.html { try_serialize_html_source, EmitOk, EmitRejected }
import gunbc.repo_atlas_projection {
  AtlasAddress,
  RepoAtlasSnapshot,
  RepoAtlasCell,
  AtlasChangeMark,
  AtlasChangesProjected,
  AtlasChangeOverlayRefused,
  AtlasOverlayRefusalCause,
  UnmergedEntryPresent,
  PairingBrokenEntryPresent,
  UnknownGitStatusPresent,
  DiffObservationTruncated,
  UnprojectedChange,
  DepartedPathPriorIdentityUnavailable,
  PathDeclaresNoModule,
  AtlasImpactOverlay,
  AtlasImpactNotComputed,
  AtlasImpactComputed,
  AtlasSubject,
  AtlasSubjectRevision,
  AtlasSubjectUnobserved,
  atlas_ring_slot_counts,
  atlas_cell_occupant_count,
  atlas_module_is_marked,
  atlas_module_is_impacted,
  atlas_impact_is_exact,
  repo_atlas_snapshot
}
import v2.lens.module_graph { module_declaration_facts_live }
import extdeps.git { GitDiffNameStatusComplete }
import v2.lens.module_impact_query {
  ModuleIdentity,
  ImpactStanding,
  ExactForGraphSubject,
  ProvisionalForObservedPool,
  Incomplete,
  PoolIndependentProjectionUnavailable
}

data repo_atlas_page_note: String = "LAYER 6 — THE PAGE. Four co-registered SVG groups over ONE projection: structure, SCM direct change, impact, and the instrument glass. They share a coordinate frame and are transformed independently, which is what makes depth a property of DIFFERENTIAL PLANE BEHAVIOUR rather than of perspective (spatial-agent-presence directive, annotation 2).

WHAT THIS PAGE DELIBERATELY DOES NOT HAVE: a client script, a canvas runtime, a stream, an incremental graph mutation, and any agent occupancy. Hover and focus use native SVG title and tabindex. The first PR is static and server-rendered because the honest v0 of the live protocol is a subject advance plus a fresh snapshot — a semantic patch needs BOTH base and head graphs and only the head exists today.

THE RENDERER RECEIVES ADDRESSES AND ROLES. It performs no Git logic, no graph traversal, and computes no pixel coordinate from a semantic fact: ring and slot become nested transforms, and that lowering is the only geometry in this file."

data atlas_svg_center: Int = 420
data atlas_svg_extent: Int = 840
data atlas_ring_gap: Int = 24
data atlas_inner_radius: Int = 34
data atlas_dot_radius: Int = 3

data repo_atlas_geometry_note: String = "The ONLY geometry in the atlas, and it is deliberately trivial: a ring index becomes a radius by multiplication, and a slot index becomes an angle by division into 360 degrees. Both are lowerings of an ordinal address, not facts about a module — a WebGPU realization computes different numbers from the same two integers.

No trigonometry appears here because SVG's own transform stack performs it: translate to the centre, rotate by the slot angle, then translate outward by the ring radius. That is the nested-transform lowering the ruling names, and it is why the model never learns sine or cosine."

fn atlas_ring_radius(ring: Int) -> Int {
  atlas_inner_radius + ring * atlas_ring_gap
}

fn atlas_ring_slot_count(ring: Int) -> Int {
  fold(
    atlas_ring_slot_counts,
    init: AtlasRingSlotProbe { index: 0, found: 1 },
    f: (acc, n) => if acc.index == ring {
      AtlasRingSlotProbe { index: acc.index + 1, found: n }
    } else {
      AtlasRingSlotProbe { index: acc.index + 1, found: acc.found }
    }
  ).found
}

type AtlasRingSlotProbe {
  index: Int
  found: Int
}

fn atlas_slot_angle_millidegrees(address: AtlasAddress) -> Int {
  address.slot * 360000 / atlas_ring_slot_count(ring: address.ring)
}

fn atlas_cell_transform(address: AtlasAddress) -> String {
  let center = to_string(atlas_svg_center)
  let angle = to_string(atlas_slot_angle_millidegrees(address: address) / 1000)
  let radius = to_string(atlas_ring_radius(ring: address.ring))
  let move_to_center = concat("translate(", concat(center, concat(" ", concat(center, ")"))))
  let turn = concat(" rotate(", concat(angle, ")"))
  let push_out = concat(" translate(0 -", concat(radius, ")"))
  concat(move_to_center, concat(turn, push_out))
}

fn sattr(name: String, value: String) -> Attribute {
  attr(name: name, value: value)
}

data repo_atlas_role_note: String = "THE FOUR ROLES ARE SEPARATE VISUAL CHANNELS AND MUST STAY DISTINGUISHABLE AT A GLANCE. A dim dot is structure. A bright crisp dot is a real SCM observation. A thin outer ring is a real impact reading. Glow belongs to selection and is not used on this page at all, because there is no selection yet and an unused channel is better than a channel that collides with occupancy.

Density, not brightness, carries a cell's occupant count: brightness is the change channel, and reusing it for population would make a crowded structural cell read as a change."

fn atlas_cell_class(cell: RepoAtlasCell, marked: Bool, impacted: Bool) -> String {
  let base = if atlas_cell_occupant_count(cell: cell) > 1 { "atlas-dot atlas-dot-shared" } else { "atlas-dot" }
  let with_change = if marked { concat(base, " atlas-dot-changed") } else { base }
  if impacted { concat(with_change, " atlas-dot-impacted") } else { with_change }
}

fn atlas_cell_any_marked(cell: RepoAtlasCell, marks: List<AtlasChangeMark>) -> Bool {
  any(cell.occupants, o => atlas_module_is_marked(marks: marks, identity: o))
}

fn atlas_cell_any_impacted(cell: RepoAtlasCell, impact: AtlasImpactOverlay) -> Bool {
  any(cell.occupants, o => atlas_module_is_impacted(overlay: impact, identity: o))
}

fn atlas_cell_title(cell: RepoAtlasCell) -> String {
  fold(cell.occupants, init: "", f: (acc, o) =>
    if acc == "" { o.name } else { concat(acc, concat(" · ", o.name)) })
}

fn atlas_structure_dot(cell: RepoAtlasCell, marks: List<AtlasChangeMark>, impact: AtlasImpactOverlay) -> Fragment {
  let marked = atlas_cell_any_marked(cell: cell, marks: marks)
  let impacted = atlas_cell_any_impacted(cell: cell, impact: impact)
  Element { tag: "g", attributes: [
    sattr(name: "transform", value: atlas_cell_transform(address: cell.address)),
  ], children: [
    Element { tag: "circle", attributes: [
      sattr(name: "r", value: to_string(atlas_dot_radius)),
      sattr(name: "class", value: atlas_cell_class(cell: cell, marked: marked, impacted: impacted)),
      sattr(name: "tabindex", value: "0"),
    ], children: [
      Element { tag: "title", attributes: [], children: [ txt(atlas_cell_title(cell: cell)) ] },
    ] },
  ] }
}

data repo_atlas_plane_note: String = "Each plane is its own SVG group so a register or a motion realization can transform one without the others. They are emitted in one document and share the coordinate frame — co-registered, not composited after the fact — which is what lets a future impulse desynchronize them the way a CRT loses hold, using the planes that already exist rather than new machinery."

fn atlas_structure_plane(snapshot: RepoAtlasSnapshot, marks: List<AtlasChangeMark>) -> Fragment {
  Element { tag: "g", attributes: [ sattr(name: "class", value: "atlas-plane atlas-plane-structure") ],
    children: map(snapshot.cells, c => atlas_structure_dot(cell: c, marks: marks, impact: snapshot.impact)) }
}

fn atlas_impact_ring(cell: RepoAtlasCell) -> Fragment {
  Element { tag: "g", attributes: [
    sattr(name: "transform", value: atlas_cell_transform(address: cell.address)),
  ], children: [
    Element { tag: "circle", attributes: [
      sattr(name: "r", value: to_string(atlas_dot_radius + 4)),
      sattr(name: "class", value: "atlas-impact-ring"),
      sattr(name: "fill", value: "none"),
    ], children: [] },
  ] }
}

data repo_atlas_impact_plane_note: String = "The impact plane renders ONLY from AtlasImpactComputed. Under AtlasImpactNotComputed it emits no group at all and the readout says impact not computed — because an empty plane and an uncomputed plane look identical on screen, and the difference is exactly what a reader needs to know before concluding nothing is affected."

fn atlas_impact_plane(snapshot: RepoAtlasSnapshot) -> List<Fragment> {
  match snapshot.impact {
    AtlasImpactNotComputed => []
    AtlasImpactComputed { reached: _, standing: _ } => [
      Element { tag: "g", attributes: [ sattr(name: "class", value: "atlas-plane atlas-plane-impact") ],
        children: map(
          filter(snapshot.cells, c => atlas_cell_any_impacted(cell: c, impact: snapshot.impact)),
          c => atlas_impact_ring(cell: c)) }
    ]
  }
}

fn atlas_glass_plane() -> Fragment {
  Element { tag: "g", attributes: [ sattr(name: "class", value: "atlas-plane atlas-plane-glass") ],
    children: [
      Element { tag: "circle", attributes: [
        sattr(name: "cx", value: to_string(atlas_svg_center)),
        sattr(name: "cy", value: to_string(atlas_svg_center)),
        sattr(name: "r", value: to_string(atlas_ring_radius(ring: 15) + 16)),
        sattr(name: "class", value: "atlas-glass-edge"),
        sattr(name: "fill", value: "none"),
      ], children: [] },
    ] }
}

fn atlas_marks_of(snapshot: RepoAtlasSnapshot) -> List<AtlasChangeMark> {
  match snapshot.changes {
    AtlasChangesProjected { marks: marks, unprojected: _ } => marks
    AtlasChangeOverlayRefused { cause: _ } => []
  }
}

fn atlas_svg(snapshot: RepoAtlasSnapshot) -> Fragment {
  let marks = atlas_marks_of(snapshot: snapshot)
  Element {
    tag: "svg",
    attributes: [
      sattr(name: "viewBox", value: concat("0 0 ", concat(to_string(atlas_svg_extent),
        concat(" ", to_string(atlas_svg_extent))))),
      sattr(name: "class", value: "atlas"),
      sattr(name: "role", value: "img"),
      sattr(name: "aria-label", value: "the .dag module population as a ring atlas"),
    ],
    children: concat(
      concat([atlas_structure_plane(snapshot: snapshot, marks: marks)], atlas_impact_plane(snapshot: snapshot)),
      [atlas_glass_plane()]),
  }
}

data repo_atlas_readout_note: String = "THE READOUT IS THE HONEST HALF OF THE PAGE AND IS NOT OPTIONAL GARNISH. Everything the atlas cannot draw truthfully is stated here in words: the refusal cause when the change overlay refused, the departed paths that have no head identity, the paths declaring no module, and whether an impact reading exists and at what standing. A viewer who reads only the picture must not be able to conclude more than the model knows."

fn atlas_refusal_text(cause: AtlasOverlayRefusalCause) -> String {
  match cause {
    UnmergedEntryPresent { path: p } =>
      concat("change overlay refused — unmerged entry at ", p)
    PairingBrokenEntryPresent { path: p } =>
      concat("change overlay refused — broken rename pairing at ", p)
    UnknownGitStatusPresent { path: p, raw: raw } =>
      concat("change overlay refused — unknown git status ", concat(raw, concat(" at ", p)))
    DiffObservationTruncated =>
      "change overlay refused — the diff observation was truncated, so entries are missing"
  }
}

fn atlas_unprojected_text(change: UnprojectedChange) -> String {
  match change {
    DepartedPathPriorIdentityUnavailable { path: p, status: _ } =>
      concat(p, " — departed; prior semantic identity is not recoverable from the head")
    PathDeclaresNoModule { path: p, status: _ } =>
      concat(p, " — changed, but the pool declares no module at this path")
  }
}

fn atlas_standing_text(standing: ImpactStanding) -> String {
  match standing {
    ExactForGraphSubject => "exact for the graph subject"
    ProvisionalForObservedPool => "provisional — relative to the observed pool"
    Incomplete { causes: causes } =>
      concat("incomplete — ", concat(to_string(causes.length()), " cause(s) recorded"))
    PoolIndependentProjectionUnavailable { trigger: _ } =>
      "pool-independent projection unavailable"
  }
}

fn atlas_impact_readout(snapshot: RepoAtlasSnapshot) -> Fragment {
  match snapshot.impact {
    AtlasImpactNotComputed =>
      el_class("p", "atlas-readout atlas-readout-absent", [
        txt("impact not computed — no reverse-dependency reading was supplied, so no ring is drawn. This is not a claim that nothing is affected."),
      ])
    AtlasImpactComputed { reached: reached, standing: standing } =>
      el_class("p", "atlas-readout", [
        txt(concat("impact — ", concat(to_string(reached.length()),
          concat(" module(s) reached, standing: ", atlas_standing_text(standing: standing))))),
      ])
  }
}

fn atlas_changes_readout(snapshot: RepoAtlasSnapshot) -> List<Fragment> {
  match snapshot.changes {
    AtlasChangeOverlayRefused { cause: cause } => [
      el_class("p", "atlas-readout atlas-readout-refused", [ txt(atlas_refusal_text(cause: cause)) ]),
    ]
    AtlasChangesProjected { marks: marks, unprojected: unprojected } => concat(
      [ el_class("p", "atlas-readout", [
          txt(concat("direct changes — ", concat(to_string(marks.length()), " module(s) marked"))),
        ]) ],
      if unprojected.length() == 0 { [] } else {
        [ el_class("div", "atlas-unprojected", [
            el_class("p", "atlas-readout", [
              txt(concat("unprojected changes — ", concat(to_string(unprojected.length()),
                " path(s) carry a change this snapshot cannot place"))),
            ]),
            Element { tag: "ul", attributes: [ sattr(name: "class", value: "atlas-unprojected-list") ],
              children: map(unprojected, u => el("li", [ txt(atlas_unprojected_text(change: u)) ])) },
          ]) ]
      })
  }
}

fn atlas_subject_text(subject: AtlasSubject) -> String {
  match subject {
    AtlasSubjectUnobserved =>
      "subject — unobserved; this snapshot names no revision"
    AtlasSubjectRevision { revision: _ } =>
      "subject — a named revision"
  }
}

data repo_atlas_occupancy_absent_note: String = "The page states the absence of agent occupancy out loud rather than simply omitting it. A viewer arriving at a repo atlas expecting to see where agents are working must not read 'no dots lit' as 'nobody is working' — the honest statement is that the channel does not exist yet."

fn atlas_legend() -> Fragment {
  Element { tag: "ul", attributes: [ sattr(name: "class", value: "atlas-legend") ], children: [
    el("li", [ txt("dim dot — a structural module cell") ]),
    el("li", [ txt("denser dot — several modules share this cell; neither displaces the other") ]),
    el("li", [ txt("bright dot — directly changed, from a real SCM comparison") ]),
    el("li", [ txt("outer ring — reached by a real reverse-dependency reading") ]),
    el("li", [ txt("no channel — agent occupancy; it is not modeled yet and nothing here stands in for it") ]),
  ] }
}

fn repo_atlas_section(snapshot: RepoAtlasSnapshot) -> Fragment {
  el_class("section", "atlas-section", concat(
    concat(
      [
        el("h2", [ txt("repo atlas") ]),
        el_class("p", "atlas-readout", [ txt(atlas_subject_text(subject: snapshot.subject)) ]),
        el_class("p", "atlas-readout", [
          txt(concat("structure — ", concat(to_string(snapshot.cells.length()), " occupied cell(s)"))),
        ]),
      ],
      atlas_changes_readout(snapshot: snapshot)),
    [
      atlas_impact_readout(snapshot: snapshot),
      atlas_svg(snapshot: snapshot),
      atlas_legend(),
    ]))
}

data repo_atlas_live_population_note: String = "THE STRUCTURE PLANE READS THE ACTUAL CURRENT MODULE POPULATION, not a fixture. That is what makes this a repo atlas rather than a drawing of one, and it is the one place the live tree is the subject.

The change and impact overlays are NOT wired to a live comparison in this slice, and the page says so through its own honest arms rather than through prose: the subject is unobserved, the diff is an empty complete observation, and impact is not computed. Supplying a real comparison is a call-site change, not a page change — which is the seam this slice exists to establish."

fn repo_atlas_live_snapshot() -> RepoAtlasSnapshot {
  repo_atlas_snapshot(
    subject: AtlasSubjectUnobserved,
    nodes: module_declaration_facts_live(pool_roots: repo_atlas_pool_roots),
    diff: GitDiffNameStatusComplete { entries: [] },
    impact: AtlasImpactNotComputed)
}

data repo_atlas_pool_roots: List<String> = ["dag", "src/v2"]

fn repo_atlas_page() -> Fragment {
  el_class("main", "atlas-page", [
    el("h1", [ txt("repo atlas — sandbox") ]),
    repo_atlas_section(snapshot: repo_atlas_live_snapshot()),
  ])
}

fn repo_atlas_html() -> String {
  match try_serialize_html_source(node: repo_atlas_page()) {
    EmitOk { html: h } => h
    EmitRejected { reason: r } => concat("EMIT REJECTED: ", r)
  }
}
