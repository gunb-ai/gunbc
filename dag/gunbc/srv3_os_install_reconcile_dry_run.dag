module gunbc.srv3_os_install_reconcile_dry_run


data srv3_os_install_reconcile_dry_run_shell_runner_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.srv3_host_effect_script",
    decl_name: "srv3_host_effect_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}

fn parse_reconcile_git_branch(stdout: String) -> NonEmptyStr {
  let parts = split(s: stdout, delimiter: "surface=git branch=")
  if parts.length() <= 1 {
    "unknown" as NonEmptyStr
  } else {
    let tail = parts.skip(n: 1).first()
    let token = split(s: tail, delimiter: " commit=").first()
    token as NonEmptyStr
  }
}

fn parse_reconcile_git_commit(stdout: String) -> NonEmptyStr {
  let parts = split(s: stdout, delimiter: " commit=")
  if parts.length() <= 1 {
    "unknown" as NonEmptyStr
  } else {
    let tail = parts.skip(n: 1).first()
    let token = split(s: tail, delimiter: "\n").first()
    token as NonEmptyStr
  }
}

func srv3_os_install_reconcile_dry_run() -> ProcessExit {
  let intent = srv3_os_install_attempt_intent
  let observe_r = srv3_host_effect_observe_read_apply()
  let observe_stdout = match srv3_shell_stdout_from_apply(r: observe_r) {
    Present { value: out } => out
    Absent =>
      return match srv3_reconciliation_failure_reason(r: observe_r) {
        Present { value: why } => exit_failure(reason: concat("srv3-install-reconcile-observe: ", why))
        Absent => exit_failure(reason: "srv3-install-reconcile-observe: host_effect_apply failed")
      }
  }
  let observation = parse_srv3_install_debug_observation(
    stdout: observe_stdout,
    intent: intent,
  )
  let grant = GrantAbsent
  let prior = NoPriorReceipt
  let result = reconcile_srv3_os_install(
    intent: intent,
    observation: observation,
    disk: srv3_install_reconcile_default_disk,
    observed_at: srv3_install_reconcile_dry_run_observed_at,
    grant: grant,
    prior: prior,
  )
  let lease = srv3_held_lease_from_serve(serve: observation.actuator_serve)
  let git_branch = parse_reconcile_git_branch(stdout: observe_stdout)
  let git_commit = parse_reconcile_git_commit(stdout: observe_stdout)
  let receipt = srv3_install_reconcile_full_receipt(
    result: result,
    intent: intent,
    observation: observation,
    grant: grant,
    prior: prior,
    lease: lease,
    git_branch: git_branch,
    git_commit: git_commit,
  )
  let action = srv3_install_reconcile_action_line(result: result)
  srv3_emit_typed_receipt(
    receipt: srv3_typed_receipt_from_lines(lines: [receipt, action]),
  )
}
