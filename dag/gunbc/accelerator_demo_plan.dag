  Placement,
  LocalAccelerator,
  LocalInProcess,
  LocalFilesystem,
  RemoteNetwork,
  RealizedStep,
  Materialization,
  Recompute,
}
import std.realization_schedule {
  RealizationPlan,
  RealizationObjective,
  Runnable,
  RunnableKernelWorkload,
  Schedule,
  CostAccount,
  cost_account_predicted_zero,
  runnable_kernel_workload_elementwise,
  runnable_kernel_workload_associative_fold,
}
import std.decl_ref { DeclarationRef }
import std.associativity_evidence {
  AssociativityEvidence,
  AssociativityLicenseVerdict,
  AssociativityLicenseGranted,
  AssociativityLicenseMissing,
  AssociativityLicenseMismatch,
  associativity_license_verdict,
  associativity_evidence_not_witnessed,
}
import std.fold_parallelism {
  FoldParallelism,
  SerialFold,
  TreeReduce,
  serial_fold_parallelism,
  derive_tree_reduce_parallelism,
  idle_lane_count,
}
import gunbc.accelerator_demo_fold {
  demo_int_sum_combine_ref,
  demo_int_sum_witnessed_associativity_evidence,
  demo_associative_fold_element_count,
  demo_simd_lane_count,
}
import std.numerical_contract {
  NumericalContract,
  IntegerExact,
  FloatApproximate,
  integer_exact_contract,
  float_contract,
  FmaContractionRefused,
  FmaContractionPermitted,
  ReductionOrderPermitted,
  ReductionOrderRefused,
  float_contract_with_reduction,
}
import std.approximate_field { ToNearestEven }
import extdeps.communication.medium { DecodeFidelity, Lossless, Lossy }
import extdeps.communication.numerical_fidelity {
  LoweringAccepted,
  LoweringRefused,
  LoweringRefusalReason,
  FmaContractionRefusedByContract,
  ReductionOrderRefusedByContract,
  UnsupportedNumericalDomain,
  lowering_fidelity_verdict_for_contract,
  tree_reduce_lowering_verdict_for_contract,
}
import extdeps.gpu.types { AcceleratorFacts }
import extdeps.vendor.nvidia { nvidia }
import extdeps.languages.simd.kernel {
  simd_kernel_target_medium_name,
  witness_relu_mul_add_kernel_surface_shape,
}

data accelerator_demo_plan_doc_provenance: String = "bind: docs/plans/accelerator-demo-roundtrip.md"

data machine_shape_orthogonal_scheduling_plan_doc_provenance: String = "bind: docs/plans/machine-shape-orthogonal-scheduling.md — the machine-shape end shape prices this demo's fusion (fused vs unfused both cost predicted-zero today, its Phase-0 displaced cost) and stages the WGSL handler wake; hand-authored staging carrier, dissolves into a registered gunbc.plan.Plan row at its Phase-1 landing (trigger declared in the md header)"

type ElementwiseFoldClass
  = PureElementwiseChain { op_count: Int }
  | AssociativeFoldChain {
      combine: DeclarationRef
      evidence: AssociativityEvidence
    }
  | EffectfulSubgraph
  | DataDependentGather

type PlacementDecision
  = PlacementChosen { domain_label: NonEmptyStr }
  | PlacementRefused { missing: List<String> }

type AcceleratorRefusalReason
  = NotElementwisePure
  | CarriesEffects
  | FmaContractionViolatesContract
  | ReductionOrderViolatesContract
  | AssociativityNotWitnessedForFold
  | AssociativityCombineMismatch
  | TreeReduceGeometryDegenerate
  | AcceleratorUnsupportedNumericalDomain

type AcceleratorRecognitionOutcome
  = Recognized {
      plan: RealizationPlan<Nano>
      kernel_step: RealizedStep<Nano>
      contract: NumericalContract
      fidelity: DecodeFidelity
      target_medium: NonEmptyStr
    }
  | Refused { reason: AcceleratorRefusalReason }

data demo_target_label: String = "accelerator-demo-relu-mul-add-v1"

data relu_mul_add_fused_op_count: Int = 3

data demo_accelerator_device: AcceleratorFacts = AcceleratorFacts {
  vendor: nvidia
  model: "A100"
}

fn demo_accelerator_placement() -> Placement {
  LocalAccelerator
}

fn demo_plan_total() -> CostAccount<Nano> {
  cost_account_predicted_zero()
}

fn demo_kernel_step(placement: Placement) -> RealizedStep<Nano> {
  RealizedStep {
    shape: ReadEffect
    placement: placement
    materialization: Recompute
    cost: demo_plan_total()
  }
}

fn relu_mul_add_schedule() -> Schedule {
  [[runnable_kernel_workload_elementwise(fused_op_count: relu_mul_add_fused_op_count)]]
}

fn associative_fold_schedule(fold_parallelism: FoldParallelism) -> Schedule {
  [[runnable_kernel_workload_associative_fold(
    fused_op_count: 0,
    fold_parallelism: fold_parallelism
  )]]
}

fn build_realization_plan(schedule: Schedule) -> RealizationPlan<Nano> {
  RealizationPlan {
    target: demo_target_label
    objective: RealizationObjective { goals: [] }
    schedule: schedule
    total: demo_plan_total()
  }
}

fn accelerator_refusal_from_lowering(reason: LoweringRefusalReason) -> AcceleratorRefusalReason {
  match reason {
    FmaContractionRefusedByContract => FmaContractionViolatesContract
    ReductionOrderRefusedByContract => ReductionOrderViolatesContract
    UnsupportedNumericalDomain => AcceleratorUnsupportedNumericalDomain
  }
}

fn choose_simd_cpu_placement(lane_count: HardwareThreadCount) -> PlacementDecision {
  if hardware_thread_count_value(t: lane_count) < 1 {
    PlacementRefused { missing: ["lane_count"] }
  } else {
    PlacementChosen { domain_label: "simd-cpu-domain" as NonEmptyStr }
  }
}

fn recognized_associative_fold_outcome(
  fold_parallelism: FoldParallelism,
  contract: NumericalContract,
  fidelity: DecodeFidelity
) -> AcceleratorRecognitionOutcome {
  Recognized {
    plan: build_realization_plan(schedule: associative_fold_schedule(fold_parallelism: fold_parallelism))
    kernel_step: demo_kernel_step(placement: demo_accelerator_placement())
    contract: contract
    fidelity: fidelity
    target_medium: simd_kernel_target_medium_name
  }
}

fn recognized_outcome(
  contract: NumericalContract,
  fidelity: DecodeFidelity
) -> AcceleratorRecognitionOutcome {
  Recognized {
    plan: build_realization_plan(schedule: relu_mul_add_schedule())
    kernel_step: demo_kernel_step(placement: demo_accelerator_placement())
    contract: contract
    fidelity: fidelity
    target_medium: simd_kernel_target_medium_name
  }
}

fn recognize_with_contract(
  contract: NumericalContract,
  insist_on_fma_fused_kernel: Bool
) -> AcceleratorRecognitionOutcome {
  match lowering_fidelity_verdict_for_contract(contract: contract) {
    LoweringRefused { reason: reason } =>
      Refused { reason: accelerator_refusal_from_lowering(reason: reason) }
    LoweringAccepted { fidelity: fidelity } =>
      match contract {
        FloatApproximate { fma_contraction: FmaContractionRefused, rounding: _, reduction_order: _ } =>
          if insist_on_fma_fused_kernel {
            Refused { reason: FmaContractionViolatesContract }
          } else {
            recognized_outcome(contract: contract, fidelity: fidelity)
          }
        IntegerExact =>
          recognized_outcome(contract: contract, fidelity: fidelity)
        FloatApproximate { fma_contraction: FmaContractionPermitted, rounding: _, reduction_order: _ } =>
          recognized_outcome(contract: contract, fidelity: fidelity)
      }
  }
}

fn recognize_elementwise_fold(class: ElementwiseFoldClass) -> AcceleratorRecognitionOutcome {
  recognize_elementwise_fold_for_lanes(
    class: class,
    lane_count: demo_simd_lane_count,
    contract: integer_exact_contract()
  )
}

fn recognize_elementwise_fold_for_lanes(
  class: ElementwiseFoldClass,
  lane_count: HardwareThreadCount,
  contract: NumericalContract
) -> AcceleratorRecognitionOutcome {
  match class {
    PureElementwiseChain { op_count: _ } =>
      recognize_with_contract(
        contract: contract,
        insist_on_fma_fused_kernel: false
      )
    AssociativeFoldChain { combine: combine, evidence: evidence } =>
      match associativity_license_verdict(
        evidence: evidence,
        scheduled_combine: combine
      ) {
        AssociativityLicenseGranted =>
          match tree_reduce_lowering_verdict_for_contract(contract: contract) {
            LoweringRefused { reason: reason } =>
              Refused { reason: accelerator_refusal_from_lowering(reason: reason) }
            LoweringAccepted { fidelity: fidelity } =>
              match derive_tree_reduce_parallelism(
                lane_count: lane_count,
                element_count: demo_associative_fold_element_count
              ) {
                Absent =>
                  Refused { reason: TreeReduceGeometryDegenerate }
                Present { value: parallelism } =>
                  recognized_associative_fold_outcome(
                    fold_parallelism: parallelism,
                    contract: contract,
                    fidelity: fidelity
                  )
              }
          }
        AssociativityLicenseMissing =>
          Refused { reason: AssociativityNotWitnessedForFold }
        AssociativityLicenseMismatch =>
          Refused { reason: AssociativityCombineMismatch }
      }
    EffectfulSubgraph => Refused { reason: CarriesEffects }
    DataDependentGather => Refused { reason: NotElementwisePure }
  }
}

fn recognize_associative_int_sum_fold() -> AcceleratorRecognitionOutcome {
  recognize_elementwise_fold(class: AssociativeFoldChain {
    combine: demo_int_sum_combine_ref()
    evidence: demo_int_sum_witnessed_associativity_evidence()
  })
}

fn recognize_associative_int_sum_fold_without_witness() -> AcceleratorRecognitionOutcome {
  recognize_elementwise_fold(class: AssociativeFoldChain {
    combine: demo_int_sum_combine_ref()
    evidence: associativity_evidence_not_witnessed()
  })
}

fn recognize_float_relu_mul_add_no_contraction() -> AcceleratorRecognitionOutcome {
  recognize_with_contract(
    contract: float_contract(rounding: ToNearestEven, fma: FmaContractionRefused),
    insist_on_fma_fused_kernel: false
  )
}

fn recognize_float_fma_fused_kernel_when_contraction_refused() -> AcceleratorRecognitionOutcome {
  recognize_with_contract(
    contract: float_contract(rounding: ToNearestEven, fma: FmaContractionRefused),
    insist_on_fma_fused_kernel: true
  )
}

fn demo_plan_fused_op_count(plan: RealizationPlan<Nano>) -> Int {
  let batch = plan.schedule.first()
  match batch.first() {
    Absent => 0
    Present { value: runnable } => match runnable {
      RunnableKernelWorkload { fused_op_count: count, fold_parallelism: _ } => count
      RunnableSingleClaim { entry: _, function: _, profile: _ } => 0
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => 0
    }
  }
}

fn demo_plan_has_three_fused_ops(plan: RealizationPlan<Nano>) -> Bool {
  demo_plan_fused_op_count(plan: plan) == 3
}

fn witness_integer_demo_emits_realization_plan_value() -> Bool {
  match recognize_elementwise_fold(class: PureElementwiseChain { op_count: 3 }) {
    Recognized { plan: plan, kernel_step: _, contract: _, fidelity: _, target_medium: _ } =>
      demo_plan_has_three_fused_ops(plan: plan)
    Refused { reason: _ } => false
  }
}

fn witness_integer_demo_plan_has_local_accelerator_placement() -> Bool {
  match recognize_elementwise_fold(class: PureElementwiseChain { op_count: 3 }) {
    Recognized { plan: _, kernel_step: step, contract: _, fidelity: f, target_medium: _ } =>
      match step.placement {
        LocalAccelerator =>
          match f {
            Lossless => true
            Lossy => false
          }
        LocalInProcess => false
        LocalFilesystem => false
        RemoteNetwork => false
      }
    Refused { reason: _ } => false
  }
}

fn witness_demo_device_identity_grounds_on_accelerator_facts() -> Bool {
  demo_accelerator_device.model == "A100"
    && demo_accelerator_device.vendor == nvidia
}

fn witness_effectful_subgraph_refused() -> Bool {
  match recognize_elementwise_fold(class: EffectfulSubgraph) {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      CarriesEffects => true
      NotElementwisePure => false
      FmaContractionViolatesContract => false
      ReductionOrderViolatesContract => false
      AssociativityNotWitnessedForFold => false
      AssociativityCombineMismatch => false
      TreeReduceGeometryDegenerate => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn witness_data_dependent_gather_refused() -> Bool {
  match recognize_elementwise_fold(class: DataDependentGather) {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      NotElementwisePure => true
      CarriesEffects => false
      FmaContractionViolatesContract => false
      ReductionOrderViolatesContract => false
      AssociativityNotWitnessedForFold => false
      AssociativityCombineMismatch => false
      TreeReduceGeometryDegenerate => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn witness_float_no_contraction_contract_accepted_lossless() -> Bool {
  match recognize_float_relu_mul_add_no_contraction() {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: f, target_medium: _ } =>
      match f {
        Lossless => true
        Lossy => false
      }
    Refused { reason: _ } => false
  }
}

fn witness_float_fma_fused_kernel_refused_when_contraction_refused() -> Bool {
  match recognize_float_fma_fused_kernel_when_contraction_refused() {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      FmaContractionViolatesContract => true
      NotElementwisePure => false
      CarriesEffects => false
      ReductionOrderViolatesContract => false
      AssociativityNotWitnessedForFold => false
      AssociativityCombineMismatch => false
      TreeReduceGeometryDegenerate => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn relu_mul_add_demo_plan() -> RealizationPlan<Nano> {
  build_realization_plan(schedule: relu_mul_add_schedule())
}

fn witness_simd_target_medium_is_inspectable() -> Bool {
  witness_relu_mul_add_kernel_surface_shape()
}

fn witness_lowering_fma_refusal_maps_to_accelerator_refusal() -> Bool {
  match accelerator_refusal_from_lowering(reason: FmaContractionRefusedByContract) {
    FmaContractionViolatesContract => true
    NotElementwisePure => false
    CarriesEffects => false
    ReductionOrderViolatesContract => false
    AssociativityNotWitnessedForFold => false
    AssociativityCombineMismatch => false
    TreeReduceGeometryDegenerate => false
    AcceleratorUnsupportedNumericalDomain => false
  }
}

fn witness_lowering_reduction_order_refusal_maps_to_accelerator_refusal() -> Bool {
  match accelerator_refusal_from_lowering(reason: ReductionOrderRefusedByContract) {
    ReductionOrderViolatesContract => true
    NotElementwisePure => false
    CarriesEffects => false
    FmaContractionViolatesContract => false
    AssociativityNotWitnessedForFold => false
    AssociativityCombineMismatch => false
    TreeReduceGeometryDegenerate => false
    AcceleratorUnsupportedNumericalDomain => false
  }
}

fn witness_lowering_unsupported_domain_maps_to_accelerator_refusal() -> Bool {
  match accelerator_refusal_from_lowering(reason: UnsupportedNumericalDomain) {
    AcceleratorUnsupportedNumericalDomain => true
    NotElementwisePure => false
    CarriesEffects => false
    FmaContractionViolatesContract => false
    ReductionOrderViolatesContract => false
    AssociativityNotWitnessedForFold => false
    AssociativityCombineMismatch => false
    TreeReduceGeometryDegenerate => false
  }
}

fn demo_plan_fold_parallelism(plan: RealizationPlan<Nano>) -> FoldParallelism {
  let batch = plan.schedule.first()
  match batch.first() {
    Absent => serial_fold_parallelism()
    Present { value: runnable } => match runnable {
      RunnableKernelWorkload { fused_op_count: _, fold_parallelism: parallelism } => parallelism
      RunnableSingleClaim { entry: _, function: _, profile: _ } => serial_fold_parallelism()
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } =>
        serial_fold_parallelism()
    }
  }
}

fn witness_associative_fold_recognized_with_tree_reduce() -> Bool {
  match recognize_associative_int_sum_fold() {
    Recognized { plan: plan, kernel_step: _, contract: _, fidelity: f, target_medium: medium } =>
      match f {
        Lossless =>
          match demo_plan_fold_parallelism(plan: plan) {
            TreeReduce { tree_depth: depth, lane_width: width } =>
              depth == 3
                && hardware_thread_count_value(t: width) == 8
                && medium == simd_kernel_target_medium_name
            SerialFold => false
          }
        Lossy => false
      }
    Refused { reason: _ } => false
  }
}

fn witness_associative_fold_refused_without_witness() -> Bool {
  match recognize_associative_int_sum_fold_without_witness() {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      AssociativityNotWitnessedForFold => true
      NotElementwisePure => false
      CarriesEffects => false
      FmaContractionViolatesContract => false
      ReductionOrderViolatesContract => false
      AssociativityCombineMismatch => false
      TreeReduceGeometryDegenerate => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn recognize_associative_int_sum_fold_with_contract(
  contract: NumericalContract
) -> AcceleratorRecognitionOutcome {
  recognize_elementwise_fold_for_lanes(
    class: AssociativeFoldChain {
      combine: demo_int_sum_combine_ref()
      evidence: demo_int_sum_witnessed_associativity_evidence()
    },
    lane_count: demo_simd_lane_count,
    contract: contract
  )
}

fn witness_float_associative_fold_refused_when_reduction_order_refused() -> Bool {
  match recognize_associative_int_sum_fold_with_contract(
    contract: float_contract_with_reduction(
      rounding: ToNearestEven,
      fma: FmaContractionRefused,
      reduction: ReductionOrderRefused
    )
  ) {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      ReductionOrderViolatesContract => true
      NotElementwisePure => false
      CarriesEffects => false
      FmaContractionViolatesContract => false
      AssociativityNotWitnessedForFold => false
      AssociativityCombineMismatch => false
      TreeReduceGeometryDegenerate => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn witness_tree_reduce_geometry_degenerate_refused() -> Bool {
  match recognize_elementwise_fold_for_lanes(
    class: AssociativeFoldChain {
      combine: demo_int_sum_combine_ref()
      evidence: demo_int_sum_witnessed_associativity_evidence()
    },
    lane_count: hardware_thread_count(count: 0),
    contract: integer_exact_contract()
  ) {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      TreeReduceGeometryDegenerate => true
      NotElementwisePure => false
      CarriesEffects => false
      FmaContractionViolatesContract => false
      ReductionOrderViolatesContract => false
      AssociativityNotWitnessedForFold => false
      AssociativityCombineMismatch => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn witness_placement_chosen_for_simd_lanes() -> Bool {
  match choose_simd_cpu_placement(lane_count: demo_simd_lane_count) {
    PlacementChosen { domain_label: label } => label == "simd-cpu-domain"
    PlacementRefused { missing: _ } => false
  }
}

fn witness_idle_lane_cost_visible_for_simd_domain() -> Bool {
  idle_lane_count(lane_count: demo_simd_lane_count) == 7
}
