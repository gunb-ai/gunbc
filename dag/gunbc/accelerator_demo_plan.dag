module gunbc.accelerator_demo_plan


data accelerator_demo_plan_doc_provenance: String = "bind: docs/plans/accelerator-demo-roundtrip.md"

data machine_shape_orthogonal_scheduling_plan_doc_provenance: String = "bind: docs/plans/machine-shape-orthogonal-scheduling.md — the machine-shape end shape prices this demo's fusion (fused vs unfused both cost predicted-zero today, its Phase-0 displaced cost) and stages the WGSL handler wake; hand-authored staging carrier, dissolves into a registered gunbc.plan.Plan row at its Phase-1 landing (trigger declared in the md header)"

type ElementwiseFoldClass
  = PureElementwiseChain { op_count: Int }
  | EffectfulSubgraph
  | DataDependentGather

type AcceleratorRefusalReason
  = NotElementwisePure
  | CarriesEffects
  | FmaContractionViolatesContract
  | AcceleratorUnsupportedNumericalDomain

type AcceleratorRecognitionOutcome
  = Recognized {
      plan: RealizationPlan<Nano>
      kernel_step: RealizedStep<Nano>
      contract: NumericalContract
      fidelity: DecodeFidelity
      target_medium: NonEmptyStr
    }
  | Refused { reason: AcceleratorRefusalReason }

data demo_target_label: String = "accelerator-demo-relu-mul-add-v1"

data relu_mul_add_fused_op_count: Int = 3

data demo_accelerator_device: extdeps.gpu.types.AcceleratorFacts = extdeps.gpu.types.AcceleratorFacts {
  vendor: extdeps.vendor.nvidia.nvidia
  model: "A100"
}

fn demo_accelerator_placement() -> Placement {
  LocalAccelerator
}

fn demo_plan_total() -> CostAccount<Nano> {
  cost_account_predicted_zero()
}

fn demo_kernel_step(placement: Placement) -> RealizedStep<Nano> {
  RealizedStep {
    shape: ReadEffect
    placement: placement
    materialization: std.realization.Recompute
    cost: demo_plan_total()
  }
}

fn relu_mul_add_schedule() -> std.realization_schedule.Schedule {
  [[RunnableKernelWorkload { fused_op_count: relu_mul_add_fused_op_count }]]
}

fn build_realization_plan(schedule: std.realization_schedule.Schedule) -> RealizationPlan<Nano> {
  RealizationPlan {
    target: demo_target_label
    objective: RealizationObjective { goals: [] }
    schedule: schedule
    total: demo_plan_total()
  }
}

fn accelerator_refusal_from_lowering(reason: extdeps.communication.numerical_fidelity.LoweringRefusalReason) -> AcceleratorRefusalReason {
  match reason {
    FmaContractionRefusedByContract => FmaContractionViolatesContract
    UnsupportedNumericalDomain => AcceleratorUnsupportedNumericalDomain
  }
}

fn recognized_outcome(
  contract: NumericalContract,
  fidelity: DecodeFidelity
) -> AcceleratorRecognitionOutcome {
  Recognized {
    plan: build_realization_plan(schedule: relu_mul_add_schedule())
    kernel_step: demo_kernel_step(placement: demo_accelerator_placement())
    contract: contract
    fidelity: fidelity
    target_medium: extdeps.languages.simd.kernel.simd_kernel_target_medium_name
  }
}

fn recognize_with_contract(
  contract: NumericalContract,
  insist_on_fma_fused_kernel: Bool
) -> AcceleratorRecognitionOutcome {
  match extdeps.communication.numerical_fidelity.lowering_fidelity_verdict_for_contract(contract: contract) {
    LoweringRefused { reason: reason } =>
      Refused { reason: accelerator_refusal_from_lowering(reason: reason) }
    LoweringAccepted { fidelity: fidelity } =>
      match contract {
        FloatApproximate { fma_contraction: FmaContractionRefused, rounding: _ } =>
          if insist_on_fma_fused_kernel {
            Refused { reason: FmaContractionViolatesContract }
          } else {
            recognized_outcome(contract: contract, fidelity: fidelity)
          }
        IntegerExact =>
          recognized_outcome(contract: contract, fidelity: fidelity)
        FloatApproximate { fma_contraction: FmaContractionPermitted, rounding: _ } =>
          recognized_outcome(contract: contract, fidelity: fidelity)
      }
  }
}

fn recognize_elementwise_fold(class: ElementwiseFoldClass) -> AcceleratorRecognitionOutcome {
  match class {
    PureElementwiseChain { op_count: _ } =>
      recognize_with_contract(
        contract: integer_exact_contract(),
        insist_on_fma_fused_kernel: false
      )
    EffectfulSubgraph => Refused { reason: CarriesEffects }
    DataDependentGather => Refused { reason: NotElementwisePure }
  }
}

fn recognize_float_relu_mul_add_no_contraction() -> AcceleratorRecognitionOutcome {
  recognize_with_contract(
    contract: float_contract(rounding: std.approximate_field.ToNearestEven, fma: FmaContractionRefused),
    insist_on_fma_fused_kernel: false
  )
}

fn recognize_float_fma_fused_kernel_when_contraction_refused() -> AcceleratorRecognitionOutcome {
  recognize_with_contract(
    contract: float_contract(rounding: std.approximate_field.ToNearestEven, fma: FmaContractionRefused),
    insist_on_fma_fused_kernel: true
  )
}

fn demo_plan_fused_op_count(plan: RealizationPlan<Nano>) -> Int {
  let batch = plan.schedule.first()
  match batch.first() {
    Absent => 0
    Present { value: runnable } => match runnable {
      RunnableKernelWorkload { fused_op_count: count } => count
      RunnableSingleClaim { entry: _, function: _, profile: _ } => 0
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => 0
    }
  }
}

fn demo_plan_has_three_fused_ops(plan: RealizationPlan<Nano>) -> Bool {
  demo_plan_fused_op_count(plan: plan) == 3
}

fn witness_integer_demo_emits_realization_plan_value() -> Bool {
  match recognize_elementwise_fold(class: PureElementwiseChain { op_count: 3 }) {
    Recognized { plan: plan, kernel_step: _, contract: _, fidelity: _, target_medium: _ } =>
      demo_plan_has_three_fused_ops(plan: plan)
    Refused { reason: _ } => false
  }
}

fn witness_integer_demo_plan_has_local_accelerator_placement() -> Bool {
  match recognize_elementwise_fold(class: PureElementwiseChain { op_count: 3 }) {
    Recognized { plan: _, kernel_step: step, contract: _, fidelity: f, target_medium: _ } =>
      match step.placement {
        LocalAccelerator =>
          match f {
            Lossless => true
            Lossy => false
          }
        LocalInProcess => false
        LocalFilesystem => false
        RemoteNetwork => false
      }
    Refused { reason: _ } => false
  }
}

fn witness_demo_device_identity_grounds_on_accelerator_facts() -> Bool {
  demo_accelerator_device.model == "A100"
    && demo_accelerator_device.vendor == extdeps.vendor.nvidia.nvidia
}

fn witness_effectful_subgraph_refused() -> Bool {
  match recognize_elementwise_fold(class: EffectfulSubgraph) {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      CarriesEffects => true
      NotElementwisePure => false
      FmaContractionViolatesContract => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn witness_data_dependent_gather_refused() -> Bool {
  match recognize_elementwise_fold(class: DataDependentGather) {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      NotElementwisePure => true
      CarriesEffects => false
      FmaContractionViolatesContract => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn witness_float_no_contraction_contract_accepted_lossless() -> Bool {
  match recognize_float_relu_mul_add_no_contraction() {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: f, target_medium: _ } =>
      match f {
        Lossless => true
        Lossy => false
      }
    Refused { reason: _ } => false
  }
}

fn witness_float_fma_fused_kernel_refused_when_contraction_refused() -> Bool {
  match recognize_float_fma_fused_kernel_when_contraction_refused() {
    Recognized { plan: _, kernel_step: _, contract: _, fidelity: _, target_medium: _ } => false
    Refused { reason: r } => match r {
      FmaContractionViolatesContract => true
      NotElementwisePure => false
      CarriesEffects => false
      AcceleratorUnsupportedNumericalDomain => false
    }
  }
}

fn relu_mul_add_demo_plan() -> RealizationPlan<Nano> {
  build_realization_plan(schedule: relu_mul_add_schedule())
}

fn witness_simd_target_medium_is_inspectable() -> Bool {
  witness_relu_mul_add_kernel_surface_shape()
}

fn witness_lowering_fma_refusal_maps_to_accelerator_refusal() -> Bool {
  match accelerator_refusal_from_lowering(reason: extdeps.communication.numerical_fidelity.FmaContractionRefusedByContract) {
    FmaContractionViolatesContract => true
    NotElementwisePure => false
    CarriesEffects => false
    AcceleratorUnsupportedNumericalDomain => false
  }
}

fn witness_lowering_unsupported_domain_maps_to_accelerator_refusal() -> Bool {
  match accelerator_refusal_from_lowering(reason: extdeps.communication.numerical_fidelity.UnsupportedNumericalDomain) {
    AcceleratorUnsupportedNumericalDomain => true
    NotElementwisePure => false
    CarriesEffects => false
    FmaContractionViolatesContract => false
  }
}
