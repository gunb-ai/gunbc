module gunbc.target_binding

import extdeps.bazel.label {
  Label, LabelCanonicalityCause, LabelCanonical, LabelNonCanonical,
  render_label, label_canonicality,
}
import std.optional { Optional, Present, Absent, optional_present, optional_absent }
import std.types { String, List, NonEmptyStr }
import std.integer { Int }
import std.measure { Millisecond }
import gunbc.native_census_verb { NativeCensusVerbWord }
import gunbc.native_serve_probe_plan { NativeServeProbe }

// A TARGET AND THE MECHANISM THAT REALIZES IT ARE PEER FACTS. BuildTarget owns the stable graph
// identity and dependency edges; this relation answers the separate realization question. In
// particular, no command line, function name, or execution closure is carried here: selecting a
// transport belongs to the later realization layer, not to either side of this model relation.
// NativeClaimProgramProducer IS GENERIC OVER ITS ENTRY AND ITS HOST DEADLINE. The entry is the
// NativeClaimDriver program; the deadline is a std.measure Millisecond wall budget on the child
// process after emit and build. Exceeding it is ObservationDidNotHold (gunbc test exit 1): the bound
// is part of the invocation's claim, the child is killed, and no partial stdout is admitted to
// native_claim_program_standing. An Optional or omitted budget is how a hang returns, so the field
// is required. The next program of this shape is one more BINDING ROW naming entry and deadline,
// never another producer arm.
// NativeServeProgramProducer is the same shape for std.compiler_entry NativeServeDriver: it emits and
// builds the named service entry, starts it, writes the requests of the row's probe reader to real
// TCP connections and hands what came back to that reader's native_serve_probe_standing. The reader
// module and the phases the run performs (gunbc.native_serve_probe_plan) are fields of the row, so a
// further served program is a binding row naming entry and probe, never a host branch. A separate arm because the
// observation differs (a served process answering requests, not a report on stdout), so folding it
// into the claim arm would give one arm two meanings.
// CliWireProgramProducer IS GENERIC OVER ENTRY AND FUNCTION. The host evaluates that function in
// the seed interpreter and classifies the returned CliWireResponse (the existing run_cli_wire_census
// runner). NativeClaimProgramProducer is emit+run of a NativeClaimDriver; this arm is not that
// driver. A second wet CliWire instrument is a binding row naming entry and function, never another
// producer arm and never a string-match inside NativeClaimProgram.
type TargetProducer
  = SelfHostProducer
  | RequiredFloorProducer
  | BazelProducer
  | BehavioralReceiptPlanProducer
  | BehavioralReceiptCensusProducer
  | BehavioralReceiptSelftestProducer
  | HeadsReadingDifferentialProducer
  | V2NativeCliProducer
  | V2NativeFrontierProducer
  | EmittedCrateWorkspaceProducer
  | EvaluationStoreAddressExactHeadProducer
  | PrimitiveEgressCensusProducer
  | PrimitiveEgressCensusV2Producer
  | PrimitiveEgressCensusDagProducer
  | PrimitiveEgressCensusSeedProducer
  | TypedGraphExclusiveBytesProducer
  | TypedGraphExclusiveBytesFloorSubjectProducer
  | RequiredLaneResolutionCensusProducer
  | BareReferenceChannelOutcomeProducer
  | SelfHostBehavioralEquivalenceProducer
  | NativeCensusVerbProducer { verb: NativeCensusVerbWord }
  | SelfHostFrontierProducer
  | GenericIdentityCensusProducer
  | InterpolationHoleCensusProducer
  | SharedTypeLeafCollisionCensusProducer
  | CardinalityRealizationProducer
  | RegenRoundCostProducer
  | NativeClaimProgramProducer { entry: String, deadline: Millisecond }
  | NativeServeProgramProducer { entry: String, probe: NativeServeProbe }
  | CliWireProgramProducer { entry: String, function: String }

// THE HOST EVALUATES THIS AT SPAWN so the child wall is the binding row's Millisecond, not a
// second Duration literal. Present only when the producer is a NativeClaimProgramProducer whose
// entry matches; every other arm is Absent.
fn native_claim_deadline_if_entry(producer: TargetProducer, want: String) -> Optional<Millisecond> {
  match producer {
    NativeClaimProgramProducer { entry: e, deadline: d } =>
      match e == want {
        true => optional_present(value: d)
        false => optional_absent()
      }
    SelfHostProducer {} => optional_absent()
    RequiredFloorProducer {} => optional_absent()
    BazelProducer {} => optional_absent()
    BehavioralReceiptPlanProducer {} => optional_absent()
    BehavioralReceiptCensusProducer {} => optional_absent()
    BehavioralReceiptSelftestProducer {} => optional_absent()
    HeadsReadingDifferentialProducer {} => optional_absent()
    V2NativeCliProducer {} => optional_absent()
    V2NativeFrontierProducer {} => optional_absent()
    EmittedCrateWorkspaceProducer {} => optional_absent()
    EvaluationStoreAddressExactHeadProducer {} => optional_absent()
    PrimitiveEgressCensusProducer {} => optional_absent()
    PrimitiveEgressCensusV2Producer {} => optional_absent()
    PrimitiveEgressCensusDagProducer {} => optional_absent()
    PrimitiveEgressCensusSeedProducer {} => optional_absent()
    TypedGraphExclusiveBytesProducer {} => optional_absent()
    TypedGraphExclusiveBytesFloorSubjectProducer {} => optional_absent()
    RequiredLaneResolutionCensusProducer {} => optional_absent()
    BareReferenceChannelOutcomeProducer {} => optional_absent()
    SelfHostBehavioralEquivalenceProducer {} => optional_absent()
    NativeCensusVerbProducer { verb: _ } => optional_absent()
    SelfHostFrontierProducer {} => optional_absent()
    GenericIdentityCensusProducer {} => optional_absent()
    InterpolationHoleCensusProducer {} => optional_absent()
    SharedTypeLeafCollisionCensusProducer {} => optional_absent()
    CardinalityRealizationProducer {} => optional_absent()
    RegenRoundCostProducer {} => optional_absent()
    NativeServeProgramProducer { entry: _, probe: _ } => optional_absent()
    CliWireProgramProducer { entry: _, function: _ } => optional_absent()
  }
}

// THE HOST EVALUATES THIS AT SPAWN, as it does the claim deadline: the probe (reader module and
// phase set) is the binding row's, so the host's serve producer holds no per-binding branch. Present
// only for a NativeServeProgramProducer whose entry matches.
fn native_serve_probe_if_entry(producer: TargetProducer, want: String) -> Optional<NativeServeProbe> {
  match producer {
    NativeServeProgramProducer { entry: e, probe: p } =>
      match e == want {
        true => optional_present(value: p)
        false => optional_absent()
      }
    _ => optional_absent()
  }
}

type TargetBinding {
  target: Label
  producer: TargetProducer
}

// THE REGISTRY IS INDEXED ON THE LABEL'S CANONICAL RENDERING, which is derived from the one target
// identity rather than accepted as a second key. Construction refuses duplicate targets, a second
// producer for one target, and bindings for unknown targets. Lookup is then one map_get, never a
// first-match scan through the population. sole_constructor keeps those admission facts attached
// to the carrier: an external module cannot forge map contents that bypass the builder.
type TargetBindingIndex sole_constructor {
  targets_by_identity: Map<String, Label>
  bindings_by_identity: Map<String, TargetBinding>
}

type TargetBindingIndexRefusal
  = TargetLabelNotCanonical { target: Label, cause: LabelCanonicalityCause }
  | DuplicateTargetIdentity { target: Label }
  | DuplicateTargetBinding { target: Label }
  | BindingNamesUnknownTarget { target: Label }

type TargetBindingIndexBuild
  = TargetBindingIndexReady { index: TargetBindingIndex }
  | TargetBindingIndexRefused { cause: TargetBindingIndexRefusal }

type TargetBindingIndexAcc {
  index: TargetBindingIndex
  refusal: Optional<TargetBindingIndexRefusal>
}

fn index_target(acc: TargetBindingIndexAcc, target: Label) -> TargetBindingIndexAcc {
  match acc.refusal {
    Present { value: _ } => acc
    Absent => match label_canonicality(label: target) {
      LabelNonCanonical { cause: cause } => TargetBindingIndexAcc {
          index: acc.index
          refusal: Present { value: TargetLabelNotCanonical { target: target, cause: cause } }
        }
      LabelCanonical => {
        let key = render_label(l: target)
        match map_get(acc.index.targets_by_identity, key) {
          Present { value: _ } => TargetBindingIndexAcc {
            index: acc.index
            refusal: Present { value: DuplicateTargetIdentity { target: target } }
          }
          Absent => TargetBindingIndexAcc {
            index: TargetBindingIndex {
              targets_by_identity: map_insert(acc.index.targets_by_identity, key, target)
              bindings_by_identity: acc.index.bindings_by_identity
            }
            refusal: Absent {}
          }
        }
      }
    }
  }
}

fn index_binding(acc: TargetBindingIndexAcc, binding: TargetBinding) -> TargetBindingIndexAcc {
  match acc.refusal {
    Present { value: _ } => acc
    Absent => match label_canonicality(label: binding.target) {
      LabelNonCanonical { cause: cause } => TargetBindingIndexAcc {
          index: acc.index
          refusal: Present { value: TargetLabelNotCanonical {
            target: binding.target,
            cause: cause
          } }
        }
      LabelCanonical => {
        let key = render_label(l: binding.target)
        match map_get(acc.index.targets_by_identity, key) {
          Absent => TargetBindingIndexAcc {
            index: acc.index
            refusal: Present { value: BindingNamesUnknownTarget { target: binding.target } }
          }
          Present { value: _ } =>
            match map_get(acc.index.bindings_by_identity, key) {
              Present { value: _ } => TargetBindingIndexAcc {
                index: acc.index
                refusal: Present { value: DuplicateTargetBinding { target: binding.target } }
              }
              Absent => TargetBindingIndexAcc {
                index: TargetBindingIndex {
                  targets_by_identity: acc.index.targets_by_identity
                  bindings_by_identity: map_insert(acc.index.bindings_by_identity, key, binding)
                }
                refusal: Absent {}
              }
            }
        }
      }
    }
  }
}

fn build_target_binding_index(
  targets: List<Label>,
  bindings: List<TargetBinding>
) -> TargetBindingIndexBuild {
  let empty = TargetBindingIndexAcc {
    index: TargetBindingIndex {
      targets_by_identity: empty_map()
      bindings_by_identity: empty_map()
    }
    refusal: Absent {}
  }
  let targets_indexed = fold(targets, init: empty, f: fn(acc, target) {
    index_target(acc: acc, target: target)
  })
  let bindings_indexed = fold(bindings, init: targets_indexed, f: fn(acc, binding) {
    index_binding(acc: acc, binding: binding)
  })
  match bindings_indexed.refusal {
    Present { value: cause } => TargetBindingIndexRefused { cause: cause }
    Absent => TargetBindingIndexReady { index: bindings_indexed.index }
  }
}

type TargetBindingLookup
  = TargetProducerBound { binding: TargetBinding }
  | KnownTargetBindingMissing { target: Label }
  | TargetUnknown { target: Label }
  | TargetLookupLabelNotCanonical { target: Label, cause: LabelCanonicalityCause }

// Query admission repeats the canonicality decision deliberately. A typed key with a sole mint
// would be preferable only if the substrate made that mint unforgeable; records and variants are
// freely constructible here, so such a key would rename this validation while leaving callers able
// to forge it. Until unforgeable construction exists, every boundary that turns a Label into the
// rendered map key must refuse noncanonical input explicitly.
fn target_binding_lookup(index: TargetBindingIndex, target: Label) -> TargetBindingLookup {
  match label_canonicality(label: target) {
    LabelNonCanonical { cause: cause } =>
      TargetLookupLabelNotCanonical { target: target, cause: cause }
    LabelCanonical => {
    let key = render_label(l: target)
    match map_get(index.targets_by_identity, key) {
      Absent => TargetUnknown { target: target }
      Present { value: _ } =>
        match map_get(index.bindings_by_identity, key) {
          Present { value: binding } => TargetProducerBound { binding: binding }
          Absent => KnownTargetBindingMissing { target: target }
        }
    }
  }
  }
}

// PRODUCER OBSERVATIONS KEEP COMPLETION APART FROM WHAT WAS OBSERVED. None of these types decides
// whether an observation blocks an aggregate. The four instruments are deliberately outside
// //:required, so that policy has no honest row to add here.
type BehavioralReceiptPlanObservation
  = BehavioralReceiptAgreed
  | BehavioralReceiptDiverged

type BehavioralReceiptPlanRefusalCause
  = ReceiptPlanMergeBaseUnresolvable
  | ReceiptPlanChangedAuthoritySetUnreadable
  | ReceiptPlanModuleCorpusUnreadable
  | ReceiptPlanExecutionRefused

type BehavioralReceiptPlanStanding
  = BehavioralReceiptPlanCompleted { observation: BehavioralReceiptPlanObservation }
  | BehavioralReceiptPlanNoSubject { head: String }
  | BehavioralReceiptPlanRefused { cause: BehavioralReceiptPlanRefusalCause }

type BehavioralReceiptCensusObservation {
  modules_planned: Int
  modules_in_population: Int
  modules_out_of_scope: List<String>
  functions_parsed: Int
  functions_derivable: Int
  functions_refused: Int
  derived_calls: Int
}

type BehavioralReceiptCensusRefusalCause
  = ReceiptCensusSourceCorpusUnreadable
  | ReceiptCensusModuleParseRefused
  | ReceiptCensusTypeReadRefused

// Census constructs its subject from the source-root corpus supplied to the producer. There is no
// external diff subject that can be absent: failure to construct or read that corpus is one of the
// typed producer refusals below, while a completed partial census carries its out-of-scope
// population in the observation rather than reporting subject absence.
type BehavioralReceiptCensusStanding
  = BehavioralReceiptCensusCompleted { observation: BehavioralReceiptCensusObservation }
  | BehavioralReceiptCensusRefused { cause: BehavioralReceiptCensusRefusalCause }

type BehavioralReceiptSelftestObservation
  = BehavioralReceiptArmsDiscriminate
  | BehavioralReceiptArmsDoNotDiscriminate

type BehavioralReceiptSelftestRefusalCause
  = ReceiptSelftestFixtureAuthorityUnreadable
  | ReceiptSelftestFixturePlanningRefused
  | ReceiptSelftestFixturePreconditionUnsatisfied
  | ReceiptSelftestCandidateUnreadable
  | ReceiptSelftestExecutionRefused

// Selftest owns a fixed authored fixture and two fixed candidate arms, so it likewise has no
// caller-selected subject that can be absent. An unreadable fixture, an underived discriminating
// input, or an execution failure is a typed producer refusal; a completed control whose arms no
// longer discriminate remains an observation.
type BehavioralReceiptSelftestStanding
  = BehavioralReceiptSelftestCompleted { observation: BehavioralReceiptSelftestObservation }
  | BehavioralReceiptSelftestRefused { cause: BehavioralReceiptSelftestRefusalCause }

type HeadsReadingDifferentialObservation {
  modules_compared: Int
  divergent: List<String>
  narrowed: List<String>
  regressed: List<String>
  both_refused: List<String>
}

type HeadsReadingDifferentialSubjectCause
  = DifferentialSourceRootAbsent
  | DifferentialSourceRootUnreadable
  | DifferentialSourcePopulationIndexRefused

type HeadsReadingDifferentialRefusalCause
  = DifferentialReadingExecutionRefused
  | DifferentialObservationAssemblyRefused

type HeadsReadingDifferentialStanding
  = HeadsReadingDifferentialCompleted { observation: HeadsReadingDifferentialObservation }
  | HeadsReadingDifferentialSubjectUnreached {
      source_roots: List<String>
      cause: HeadsReadingDifferentialSubjectCause
    }
  | HeadsReadingDifferentialRefused { cause: HeadsReadingDifferentialRefusalCause }

// ---------------------------------------------------------------------------------------------
// THE BARE-REFERENCE CHANNEL'S OUTCOME CARRIERS
// ---------------------------------------------------------------------------------------------

// WHAT THIS INSTRUMENT OBSERVES, AND WHAT IT DELIBERATELY DOES NOT.
//
// `gunbc.recurring_failure_mode.bare_reference_channel_declines_a_pull_in_silence` records that
// the loader's bare half declines silently, and names its next rung as a CARRIER for declined
// names -- which does not exist and is not built here. This instrument needs none, because it asks
// a different and answerable question: for one source file, did the bare half RUN, and which
// modules did it PULL. Both are already values the loader computes, so the observation is at the
// grain of the decision's OUTCOME rather than at the grain of the distant symptom (an unresolved
// type reported modules away) or of the reason (which only the carrier could supply).
//
// THIS CARRIER STATES NO RUNG, AND THE OMISSION IS DELIBERATE. The class's rung is the ledger
// row's fact and has exactly one home -- `gunbc.recurring_failure_mode`
// `bare_reference_channel_declines_a_pull_in_silence`, which reports 1 and says why. An earlier
// revision of this annotation claimed rung 2 here; that was a second statement of one fact on the
// carrier a reader meets first, which is the DESIGN section 3 fork, and it was wrong on the
// merits besides: a gate that changes behaviour turns this target red for whoever RUNS it and
// blocks no landing, and section 4b rung 2 is a mechanism that exposes AND blocks. Read the rung
// from the row.
type BareChannelEligibility
  = BareChannelRuns
  | BareChannelDisabledByImportLine

// ELIGIBILITY IS A SEPARATE FIELD FROM THE PULL SET AND MUST STAY ONE. An eligible file that
// pulled nothing (every arm of `pullable` declined) and a file whose channel never ran (one import
// line anywhere) both end with an empty set, and they are the two DIFFERENT gates this fixture set
// exists to tell apart. Folding them would make the entry-three row unable to fail for its own
// reason.
type BareReferenceChannelEntryReading {
  module_path: NonEmptyStr
  eligibility: BareChannelEligibility
  pulled_modules: List<String>
}

// The expectation is stated as an OUTCOME plus the condition the entry isolates, so a divergence
// reads as "entry X, which isolates gate one, now pulls" rather than as a bare set difference.
type BareReferenceChannelExpectation {
  module_path: NonEmptyStr
  isolated_condition: NonEmptyStr
  eligibility: BareChannelEligibility
  pulled_modules: List<String>
}

// SUBJECT-UNREACHED IS NOT A DIVERGENCE, on the rule every instrument on this seam follows: a
// missing fixture root observed nothing, and reporting that as a moved gate would be a fabricated
// reading.
type BareReferenceChannelSubjectCause
  = BareChannelFixtureRootAbsent { root: String }
  | BareChannelEntryAbsent { module_path: String }
  | BareChannelIndexRefused { detail: String }

// TWO ARMS, NOT THREE. A "diverged" arm carrying pre-joined pairs would give the verdict two
// homes -- the producer deciding once by choosing an arm and the classifier deciding again -- and
// the arm the producer chose would be the one a reader trusted. The producer READS and the
// classifier DECIDES: `BareReferenceChannelRead` carries what was observed and nothing about
// whether it was expected.
type BareReferenceChannelStanding
  = BareReferenceChannelRead { readings: List<BareReferenceChannelEntryReading> }
  | BareReferenceChannelSubjectUnreached { cause: BareReferenceChannelSubjectCause }
