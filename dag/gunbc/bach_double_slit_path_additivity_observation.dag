module gunbc.bach_double_slit_path_additivity_observation

import std.types { Bool, Int, String, List, NonEmptyStr }
import std.algebra_law {
  ClassicalPathAdditivityCounterexampleWitness,
  ClassicalPathAdditivityOperationSubject,
  ClassicalPathAdditivityRefutationReceipt,
  ClassicalPathAdditivityBach2013,
  classical_path_additivity_refutation_holds_for_bach_2013,
  classical_path_additivity_witness_is_counterexample,
}
import extdeps.physics.double_slit {
  BachEtAl2013DoubleSlitExperiment,
  bach_et_al_2013_double_slit,
  BachArrivalCountObservationRow,
  bach_et_al_2013_arrival_count_observations,
  SlitArrangement,
  ScreenBand,
  BachMatchedExposureSession,
  BothSlitsOpen,
  OnlyLeftSlitOpen,
  OnlyRightSlitOpen,
  BothSlitsBlocked,
  CentralBand,
  FirstMinimumBand,
  FirstSideMaximumBand,
  Bach2013MatchedExposureOne,
}

data path_additivity_evidence_kind_note: String = "Slice A empirical fold. INPUTS are cited arrival-count rows from extdeps.physics.double_slit (Bach et al. 2013) — not host-executed measurement. The DERIVATION executes: fold rows into matched-exposure totals, apply the classical exclusive-alternative additive prediction separately, compare predicted against observed at a concrete band. This is NOT lattice distributivity (Slice B deferred). This does NOT execute the physical experiment."

data path_additivity_normalization_note: String = "NORMALIZATION. Classical prediction uses raw matched-exposure arrival totals: prediction = left_only_count + right_only_count at the same band and exposure. We do NOT compare normalized P_both against normalized P_left + normalized P_right — that sum is not the classical additive mixture and would fire for trivial arithmetic reasons."

data classical_prediction_note: String = "Classical exclusive-alternative mixture implemented separately from observation rows: additive sum of single-slit arrival totals at matched exposure for the same band."

fn classical_exclusive_alternative_arrival_prediction(
  left_only_count: Int,
  right_only_count: Int,
) -> Int {
  left_only_count + right_only_count
}

fn arrival_count_row_matches(
  row: BachArrivalCountObservationRow,
  apparatus: BachEtAl2013DoubleSlitExperiment,
  arrangement: SlitArrangement,
  band: ScreenBand,
  exposure: BachMatchedExposureSession,
) -> Bool {
  row.apparatus == apparatus
    && row.arrangement == arrangement
    && row.band == band
    && row.exposure == exposure
}

fn fold_arrival_count_at(
  rows: List<BachArrivalCountObservationRow>,
  apparatus: BachEtAl2013DoubleSlitExperiment,
  arrangement: SlitArrangement,
  band: ScreenBand,
  exposure: BachMatchedExposureSession,
) -> Int {
  fold(
    rows,
    init: 0,
    f: fn(acc, row) {
      if arrival_count_row_matches(
        row: row,
        apparatus: apparatus,
        arrangement: arrangement,
        band: band,
        exposure: exposure,
      ) {
        acc + row.arrival_count
      } else {
        acc
      }
    },
  )
}

fn derive_classical_path_additivity_witness_at_band(
  rows: List<BachArrivalCountObservationRow>,
  apparatus: BachEtAl2013DoubleSlitExperiment,
  band: ScreenBand,
  exposure: BachMatchedExposureSession,
  location_label: NonEmptyStr,
) -> ClassicalPathAdditivityRefutationReceipt {
  let left_count = fold_arrival_count_at(
    rows: rows,
    apparatus: apparatus,
    arrangement: OnlyLeftSlitOpen,
    band: band,
    exposure: exposure,
  )
  let right_count = fold_arrival_count_at(
    rows: rows,
    apparatus: apparatus,
    arrangement: OnlyRightSlitOpen,
    band: band,
    exposure: exposure,
  )
  let both_count = fold_arrival_count_at(
    rows: rows,
    apparatus: apparatus,
    arrangement: BothSlitsOpen,
    band: band,
    exposure: exposure,
  )
  let prediction = classical_exclusive_alternative_arrival_prediction(
    left_only_count: left_count,
    right_only_count: right_count,
  )
  ClassicalPathAdditivityRefutationReceipt {
    subject: ClassicalPathAdditivityBach2013 {},
    witness: ClassicalPathAdditivityCounterexampleWitness {
      left_alternative_count: left_count,
      right_alternative_count: right_count,
      both_open_observed_count: both_count,
      classical_additive_prediction: prediction,
    },
    location_label: location_label,
  }
}

data path_additivity_subject: ClassicalPathAdditivityOperationSubject = ClassicalPathAdditivityBach2013 {}

data classical_path_additivity_refuted: ClassicalPathAdditivityRefutationReceipt = derive_classical_path_additivity_witness_at_band(
  rows: bach_et_al_2013_arrival_count_observations,
  apparatus: bach_et_al_2013_double_slit,
  band: FirstMinimumBand,
  exposure: Bach2013MatchedExposureOne {},
  location_label: "Bach2013MatchedExposureOne:FirstMinimumBand:BothSlitsOpen" as NonEmptyStr,
)

fn classical_path_additivity_refutation_holds() -> Bool {
  classical_path_additivity_refutation_holds_for_bach_2013(receipt: classical_path_additivity_refuted)
}

fn classical_path_additivity_no_refutation_at_blocked_zero_counts() -> Bool {
  let blocked = fold_arrival_count_at(
    rows: bach_et_al_2013_arrival_count_observations,
    apparatus: bach_et_al_2013_double_slit,
    arrangement: BothSlitsBlocked,
    band: CentralBand,
    exposure: Bach2013MatchedExposureOne {},
  )
  blocked == 0
    && !classical_path_additivity_witness_is_counterexample(
      witness: ClassicalPathAdditivityCounterexampleWitness {
        left_alternative_count: 0,
        right_alternative_count: 0,
        both_open_observed_count: 0,
        classical_additive_prediction: 0,
      },
    )
}

fn naive_normalized_probability_sum_trap_would_misfire_at_first_minimum() -> Bool {
  let left = classical_path_additivity_refuted.witness.left_alternative_count
  let right = classical_path_additivity_refuted.witness.right_alternative_count
  let both = classical_path_additivity_refuted.witness.both_open_observed_count
  let total = left + right + both
  (left + right) != both
    && (left + right) > both
}

fn central_band_additive_witness_is_not_counterexample() -> Bool {
  let receipt = derive_classical_path_additivity_witness_at_band(
    rows: bach_et_al_2013_arrival_count_observations,
    apparatus: bach_et_al_2013_double_slit,
    band: CentralBand,
    exposure: Bach2013MatchedExposureOne {},
    location_label: "Bach2013MatchedExposureOne:CentralBand:BothSlitsOpen" as NonEmptyStr,
  )
  !classical_path_additivity_witness_is_counterexample(witness: receipt.witness)
}

fn correctly_normalized_additive_matches_at_central_band() -> Bool {
  let left = fold_arrival_count_at(
    rows: bach_et_al_2013_arrival_count_observations,
    apparatus: bach_et_al_2013_double_slit,
    arrangement: OnlyLeftSlitOpen,
    band: CentralBand,
    exposure: Bach2013MatchedExposureOne {},
  )
  let right = fold_arrival_count_at(
    rows: bach_et_al_2013_arrival_count_observations,
    apparatus: bach_et_al_2013_double_slit,
    arrangement: OnlyRightSlitOpen,
    band: CentralBand,
    exposure: Bach2013MatchedExposureOne {},
  )
  let both = fold_arrival_count_at(
    rows: bach_et_al_2013_arrival_count_observations,
    apparatus: bach_et_al_2013_double_slit,
    arrangement: BothSlitsOpen,
    band: CentralBand,
    exposure: Bach2013MatchedExposureOne {},
  )
  let prediction = classical_exclusive_alternative_arrival_prediction(
    left_only_count: left,
    right_only_count: right,
  )
  both > prediction
}
