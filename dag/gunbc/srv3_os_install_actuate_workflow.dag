module gunbc.srv3_os_install_actuate_workflow


type OsInstallActuateWorkflowStep
  = WorkflowEnsureActuatorToolchain
  | WorkflowEnsureSeededInstallMedia
  | WorkflowBmcCredentialProbeAndResolve
  | WorkflowBmcwebSessionLogin
  | WorkflowNbdProxyServe
  | WorkflowOperatorApproval { escalation: gunbc.workflow_escalation.WorkflowEscalation }
  | WorkflowBootOnceCd
  | WorkflowSolConsoleCapture

data srv3_boot_once_cd_escalation: gunbc.workflow_escalation.WorkflowEscalation = gunbc.workflow_escalation.WorkflowEscalation {
  escalation_id: "srv3-boot-once-cd" as std.types.NonEmptyStr,
  rationale: "PATCH boot override to CD Once + ForceRestart is destructive and may interrupt srv3" as std.types.NonEmptyStr,
  destructive: true,
}

data srv3_boot_once_cd_default_approval: gunbc.workflow_escalation.WorkflowApprovalState = gunbc.workflow_escalation.PendingApproval {
  escalation: srv3_boot_once_cd_escalation,
}

data srv3_boot_once_cd_operator_granted_approval: gunbc.workflow_escalation.WorkflowApprovalState = gunbc.workflow_escalation.ApprovalGranted {
  escalation_id: srv3_boot_once_cd_escalation.escalation_id,
  granted_by: "operator" as std.types.NonEmptyStr,
}

fn srv3_os_install_actuate_workflow_steps() -> List<OsInstallActuateWorkflowStep> {
  [
    WorkflowEnsureActuatorToolchain,
    WorkflowEnsureSeededInstallMedia,
    WorkflowBmcCredentialProbeAndResolve,
    WorkflowBmcwebSessionLogin,
    WorkflowNbdProxyServe,
    WorkflowOperatorApproval { escalation: srv3_boot_once_cd_escalation },
    WorkflowBootOnceCd,
    WorkflowSolConsoleCapture,
  ]
}

fn srv3_os_install_actuate_workflow_step_count() -> Int {
  srv3_os_install_actuate_workflow_steps().length()
}

fn srv3_boot_once_cd_workflow_disposition(approval: gunbc.workflow_escalation.WorkflowApprovalState) -> gunbc.workflow_escalation.WorkflowStepDisposition {
  workflow_step_disposition_for_approval(
    escalation: srv3_boot_once_cd_escalation,
    approval: approval,
  )
}

fn srv3_boot_once_cd_is_runnable_with_approval(approval: gunbc.workflow_escalation.WorkflowApprovalState) -> Bool {
  match srv3_boot_once_cd_workflow_disposition(approval: approval) {
    StepRunnable => true
    _ => false
  }
}

fn srv3_os_install_actuate_workflow_includes_operator_approval_before_boot() -> Bool {
  let steps = srv3_os_install_actuate_workflow_steps()
  srv3_os_install_actuate_workflow_step_count() == 8
    && match steps.skip(n: 5).first() {
      WorkflowOperatorApproval { escalation: e } =>
        e.escalation_id == srv3_boot_once_cd_escalation.escalation_id
      _ => false
    }
    && match steps.skip(n: 6).first() {
      WorkflowBootOnceCd => true
      _ => false
    }
}

fn srv3_os_install_actuate_workflow_credential_intent_is_declared() -> Bool {
  srv3_os_install_actuate_credential_intent().rotated_secret_ref.secret == "bmc-srv3-admin" as std.types.NonEmptyStr
}

fn srv3_os_install_actuator_plan_step_count_matches_workflow_tail() -> Bool {
  match srv3_os_install_actuator_plan_standing {
    ActuatorPlanReady { plan: p, intents: _ } => p.steps.length() == 3
    ActuatorPlanRefused { cause: _ } => false
  }
}
