module gunbc.legacy_test_behavior_disposition

import std.types { Bool, FilePath, Int, List, NonEmptyStr, String }
import gunbc.ci_layer_roots {
  witness_admission_offline_exclusion_substrings,
  witness_discovery_scan_dirs,
  witness_exclusion_substrings,
}

type LegacyTestBehavior {
  source_file: FilePath
  test_fn: NonEmptyStr
}

type TestBehaviorWitness {
  entry: FilePath
  test_fn: NonEmptyStr
}

type LegacyTestBehaviorDisposition
  = CoveredByWitness {
      behavior: LegacyTestBehavior,
      witness: TestBehaviorWitness,
      distinguishing_failure: NonEmptyStr,
    }
  | DeleteLowValueBehavior {
      behavior: LegacyTestBehavior,
      reason: NonEmptyStr,
    }
  | RetainedNonMigratableBehavior {
      behavior: LegacyTestBehavior,
      reason: NonEmptyStr,
      dissolution_trigger: NonEmptyStr,
    }

data legacy_test_behavior_disposition_authority_note: String = "BEHAVIOR GRAIN, NOT MODULE GRAIN. The discovered subject is every line-anchored #[test] function under src/v1/tests/src, identified by its source file and function name. A disposition is admitted only for one such identity. CoveredByWitness additionally names a discovered `test fn` in the floor corpus and the failure that distinguishes equivalent coverage from a guard that merely stays quiet. DeleteLowValueBehavior and RetainedNonMigratableBehavior require their own reasons; retention also names its dissolution trigger and never authorizes deletion. Unclassified is deliberately not a disposition someone can author: it is the set difference discovered legacy behaviors minus disposition identities. Completion is that difference at zero together with no stale or duplicate dispositions and no unresolved witness reference. No numeric snapshot is an oracle."

data legacy_test_behavior_discovery_scaffold_note: String = "DECLARED SEED SCAFFOLD for the missing list-directory effect. cli_run.rs test_migration_behavior_discovery_report walks the legacy Rust test directory and the existing corpus_dag_files floor population, extracting line-anchored #[test] and `test fn` declarations. Discovery errors make test_migration_behavior_discovery_holds false rather than fabricating an empty population. The identities cross the interpreter boundary as canonical source-file::function strings; this module derives the same serialization from typed fields. DEFERRAL OWNER: the self-host lane's v1-hand-queue-drain ROADMAP node ('Work through the remaining hand-written files the products need'); this product-reachable cli_run.rs bridge is one of that node's hand-written files and cannot silently fall outside its derived queue. DISSOLVES WHEN .dag can enumerate repository files and read the parsed Rust/DAG declaration trees directly; the graph and its dispositions stay, only the host observation bridge deletes."

fn legacy_test_behavior_id(behavior: LegacyTestBehavior) -> String {
  concat(concat(behavior.source_file as String, "::"), behavior.test_fn as String)
}

fn test_behavior_witness_id(witness: TestBehaviorWitness) -> String {
  concat(concat(witness.entry as String, "::"), witness.test_fn as String)
}

fn legacy_test_disposition_behavior(
  disposition: LegacyTestBehaviorDisposition,
) -> LegacyTestBehavior {
  match disposition {
    CoveredByWitness { behavior, witness: _, distinguishing_failure: _ } => behavior
    DeleteLowValueBehavior { behavior, reason: _ } => behavior
    RetainedNonMigratableBehavior {
      behavior,
      reason: _,
      dissolution_trigger: _,
    } => behavior
  }
}

fn legacy_test_disposition_id(disposition: LegacyTestBehaviorDisposition) -> String {
  legacy_test_behavior_id(
    behavior: legacy_test_disposition_behavior(disposition: disposition),
  )
}

fn legacy_test_disposition_same_behavior(
  a: LegacyTestBehaviorDisposition,
  b: LegacyTestBehaviorDisposition,
) -> Bool {
  legacy_test_disposition_id(disposition: a) == legacy_test_disposition_id(disposition: b)
}

fn legacy_test_disposition_witness_resolves(
  disposition: LegacyTestBehaviorDisposition,
  discovered_witnesses: List<String>,
) -> Bool {
  match disposition {
    CoveredByWitness { behavior: _, witness, distinguishing_failure: _ } =>
      discovered_witnesses |> any(id => id == test_behavior_witness_id(witness: witness))
    DeleteLowValueBehavior { behavior: _, reason: _ } => true
    RetainedNonMigratableBehavior {
      behavior: _,
      reason: _,
      dissolution_trigger: _,
    } => true
  }
}

fn legacy_test_behavior_unclassified(
  discovered_legacy: List<String>,
  dispositions: List<LegacyTestBehaviorDisposition>,
) -> List<String> {
  discovered_legacy
    |> filter(id => !(dispositions |> any(d => legacy_test_disposition_id(disposition: d) == id)))
}

fn legacy_test_behavior_stale_dispositions(
  discovered_legacy: List<String>,
  dispositions: List<LegacyTestBehaviorDisposition>,
) -> List<LegacyTestBehaviorDisposition> {
  dispositions
    |> filter(d => !(discovered_legacy |> any(id => id == legacy_test_disposition_id(disposition: d))))
}

fn legacy_test_behavior_duplicate_dispositions(
  dispositions: List<LegacyTestBehaviorDisposition>,
) -> List<LegacyTestBehaviorDisposition> {
  dispositions
    |> filter(d => count(
      dispositions
        |> filter(peer => legacy_test_disposition_same_behavior(a: peer, b: d))
    ) > 1)
}

fn legacy_test_behavior_unresolved_witness_dispositions(
  discovered_witnesses: List<String>,
  dispositions: List<LegacyTestBehaviorDisposition>,
) -> List<LegacyTestBehaviorDisposition> {
  dispositions
    |> filter(d => !legacy_test_disposition_witness_resolves(
      disposition: d,
      discovered_witnesses: discovered_witnesses,
    ))
}

data witness_execution_wall_note: String = "A CITED WITNESS MUST EXECUTE SOMEWHERE SCHEDULED, OR THE ROW REFUSES. Resolution establishes that a CoveredByWitness names a DISCOVERED floor `test fn` — that the name exists in the corpus. It does not establish that anything ever RUNS it, and those are different facts. A row whose witness never executes reads DISCHARGED to every consumer of this graph, including the closing contract that gates the whole node, while nothing would go red if the behavior regressed.\n\nSCHEDULING IS ESTABLISHED POSITIVELY, AND THIS IS THE CORRECTION THAT DEFINES THE MECHANISM. An earlier revision asked only whether the entry matched an EXCLUSION pattern and admitted everything else. That is the absorbing inference this graph exists to refuse, made one level up: absence of exclusion is not presence of scheduling. Discovery scans gunbc.ci_layer_roots witness_discovery_scan_dirs — three paths — and a witness outside all three is invisible by OMISSION while matching no exclusion at all, so the old wall admitted it. The specimen is not hypothetical: the first migrated family cited four probes in src/v2/test/claim/round_trip, which is in no scan dir and on no exclusion list, and the populated main-push log that landed gunbc#7687 shows 2000+ witnesses executed and zero from that file. The unrelated source_authority_contract_test.dag in the same directory also executes zero, so it is a lane fact rather than a file fact. The wall reported zero non-executing rows while its own first family was entirely non-executing.\n\nFIVE STATES, TWO OF WHICH ADMIT. WitnessScheduledInDiscovery carries the scan dir that contains it — naming WHICH one, so the admission is a located fact rather than a bare true. WitnessScheduledAsDeclaredEntry covers the explicit roster, which runs as declared regardless of scan dirs. WitnessOutsideEveryScanDir is the state the old wall could not represent and is the one this correction adds. WitnessNotScheduledOffline is KNOWN not to run on any schedule — a documented local recipe is not a consumer. WitnessScheduleUnknown is an excluded lane whose schedule this graph cannot establish, and it REFUSES rather than admitting on unknown, because an excluded lane someone believes is scheduled is the state that produced the original gap. Exclusion is evaluated FIRST: an excluded path is removed from discovery even when it sits inside a scan dir, so scan-dir membership can never overturn a refusal.\n\nExpect this to flag witnesses in lanes that exist but are DARK. Those are counted refusals and real findings, not false positives to special-case away, and a zero from this wall is only worth what its controls are worth — which is why round_trip is enrolled as a permanent fixture RED rather than merely fixed and forgotten."

type WitnessExecutionStatus
  = WitnessScheduledInDiscovery { scan_dir: NonEmptyStr }
  | WitnessScheduledAsDeclaredEntry
  | WitnessOutsideEveryScanDir
  | WitnessNotScheduledOffline { pattern: NonEmptyStr }
  | WitnessScheduleUnknown { pattern: NonEmptyStr }

fn witness_exclusion_pattern_pick(
  acc: String,
  entry: FilePath,
  pattern: String,
) -> String {
  if acc != "" {
    acc
  } else if string_contains(s: entry as String, pattern: pattern) {
    pattern
  } else {
    ""
  }
}

fn witness_matching_exclusion_pattern(
  entry: FilePath,
  exclusion_patterns: List<String>,
) -> String {
  fold(
    exclusion_patterns,
    init: "",
    f: (acc, candidate) => witness_exclusion_pattern_pick(acc: acc, entry: entry, pattern: candidate),
  )
}

fn patterns_contain(patterns: List<String>, value: String) -> Bool {
  patterns |> any(p => p == value)
}

fn witness_scan_dir_pick(
  acc: String,
  entry: FilePath,
  scan_dir: String,
) -> String {
  if acc != "" {
    acc
  } else if starts_with(s: entry as String, prefix: concat(scan_dir, "/")) {
    scan_dir
  } else {
    ""
  }
}

fn witness_containing_scan_dir(
  entry: FilePath,
  scan_dirs: List<String>,
) -> String {
  fold(
    scan_dirs,
    init: "",
    f: (acc, candidate) => witness_scan_dir_pick(acc: acc, entry: entry, scan_dir: candidate),
  )
}

fn witness_entry_execution_status(
  entry: FilePath,
  scan_dirs: List<String>,
  declared_entries: List<String>,
  exclusion_patterns: List<String>,
  offline_patterns: List<String>,
) -> WitnessExecutionStatus {
  let matched = witness_matching_exclusion_pattern(
    entry: entry,
    exclusion_patterns: exclusion_patterns,
  )
  let offline = patterns_contain(patterns: offline_patterns, value: matched)
  let scan_dir = witness_containing_scan_dir(entry: entry, scan_dirs: scan_dirs)
  let declared = patterns_contain(patterns: declared_entries, value: entry as String)
  if matched != "" && offline {
    WitnessNotScheduledOffline { pattern: matched as NonEmptyStr }
  } else if matched != "" {
    WitnessScheduleUnknown { pattern: matched as NonEmptyStr }
  } else if declared {
    WitnessScheduledAsDeclaredEntry
  } else if scan_dir != "" {
    WitnessScheduledInDiscovery { scan_dir: scan_dir as NonEmptyStr }
  } else {
    WitnessOutsideEveryScanDir
  }
}

fn witness_execution_status_admits(status: WitnessExecutionStatus) -> Bool {
  match status {
    WitnessScheduledInDiscovery { scan_dir: _ } => true
    WitnessScheduledAsDeclaredEntry => true
    WitnessOutsideEveryScanDir => false
    WitnessNotScheduledOffline { pattern: _ } => false
    WitnessScheduleUnknown { pattern: _ } => false
  }
}

fn legacy_test_disposition_witness_executes(
  disposition: LegacyTestBehaviorDisposition,
  scan_dirs: List<String>,
  declared_entries: List<String>,
  exclusion_patterns: List<String>,
  offline_patterns: List<String>,
) -> Bool {
  match disposition {
    CoveredByWitness { behavior: _, witness, distinguishing_failure: _ } =>
      witness_execution_status_admits(
        status: witness_entry_execution_status(
          entry: witness.entry,
          scan_dirs: scan_dirs,
          declared_entries: declared_entries,
          exclusion_patterns: exclusion_patterns,
          offline_patterns: offline_patterns,
        ),
      )
    DeleteLowValueBehavior { behavior: _, reason: _ } => true
    RetainedNonMigratableBehavior {
      behavior: _,
      reason: _,
      dissolution_trigger: _,
    } => true
  }
}

fn legacy_test_behavior_nonexecuting_witness_dispositions(
  dispositions: List<LegacyTestBehaviorDisposition>,
  scan_dirs: List<String>,
  declared_entries: List<String>,
  exclusion_patterns: List<String>,
  offline_patterns: List<String>,
) -> List<LegacyTestBehaviorDisposition> {
  dispositions
    |> filter(d => !legacy_test_disposition_witness_executes(
      disposition: d,
      scan_dirs: scan_dirs,
      declared_entries: declared_entries,
      exclusion_patterns: exclusion_patterns,
      offline_patterns: offline_patterns,
    ))
}

data legacy_test_inflow_parser_defect_note: String = "PARSER DEFECT RECEIPT, recorded where the rename it forced actually lives. The fold above binds `candidate` rather than the obvious `pattern` because a LAMBDA PARAMETER NAMED pattern IS A PARSE ERROR in the current grammar: `fold(xs, init: \"\", f: (acc, pattern) => acc)` refuses with expected-RParen-found-Comma while `(acc, patternx)` parses, and the failing specimen never mentions the parameter in its body, so the trigger is the identifier in binder position rather than anything about the body. Measured 2026-08-02 by bisection after three wrong hypotheses. A named FUNCTION parameter called pattern parses fine (witness_exclusion_pattern_pick declares one), and `pattern:` as a named-argument label is used corpus-wide, so the defect is specific to the lambda binder. Class: false refusal of legitimate input — loud, wrong locus, parser-completeness — the same class as the if-block-read-as-record-literal specimen in the guarantee recovery queue, a DIFFERENT trigger from it, and therefore a second defect rather than a second sighting. THIS RENAME IS NOT THE FIX AND MUST NOT BE READ AS ONE: it is a real rename that happens to avoid the defect, recorded here so the absence of trouble is not mistaken for the absence of a defect. Dissolve-on: the binder-position identifier defect closes and this note deletes; the rename may stay or revert, it is immaterial."

data legacy_test_behavior_family_note: String = "A FAMILY IS A SCOPE OVER THE ONE GRAPH, NOT A SECOND CLASSIFICATION SCHEME. Migration proceeds family by family while the closing contract stays red on the rest of the corpus, so a family needs its own completion reading — but membership is derived by matching discovered behavior identities against the family's declared source files, never by listing the behaviors, so a #[test] added to a member module lands in the family's unclassified set and reds its completion the same way it reds the global frontier. Two states are refused rather than passed: a family whose declared source files discover no behavior at all is Incomplete, not vacuously complete (a renamed or misspelled path cannot read as finished work), and the family's own dispositions are checked for staleness against the WHOLE discovered population, so moving a behavior out of a member module refuses instead of quietly narrowing. Completion of a family is not completion of the contract and does not authorize deletion; it is the unit in which the frontier shrinks."

type LegacyTestBehaviorFamily {
  name: NonEmptyStr
  source_files: List<FilePath>
}

fn legacy_test_behavior_family_owns(
  family: LegacyTestBehaviorFamily,
  behavior_id: String,
) -> Bool {
  family.source_files
    |> any(source_file => starts_with(
      s: behavior_id,
      prefix: concat(source_file as String, "::"),
    ))
}

fn legacy_test_behavior_family_discovered(
  family: LegacyTestBehaviorFamily,
  discovered_legacy: List<String>,
) -> List<String> {
  discovered_legacy
    |> filter(id => legacy_test_behavior_family_owns(family: family, behavior_id: id))
}

fn legacy_test_behavior_family_dispositions(
  family: LegacyTestBehaviorFamily,
  dispositions: List<LegacyTestBehaviorDisposition>,
) -> List<LegacyTestBehaviorDisposition> {
  dispositions
    |> filter(d => legacy_test_behavior_family_owns(
      family: family,
      behavior_id: legacy_test_disposition_id(disposition: d),
    ))
}

fn legacy_test_behavior_family_unclassified(
  family: LegacyTestBehaviorFamily,
  discovered_legacy: List<String>,
  dispositions: List<LegacyTestBehaviorDisposition>,
) -> List<String> {
  legacy_test_behavior_unclassified(
    discovered_legacy: legacy_test_behavior_family_discovered(
      family: family,
      discovered_legacy: discovered_legacy,
    ),
    dispositions: legacy_test_behavior_family_dispositions(
      family: family,
      dispositions: dispositions,
    ),
  )
}

fn legacy_test_behavior_family_complete(
  discovery_holds: Bool,
  family: LegacyTestBehaviorFamily,
  discovered_legacy: List<String>,
  discovered_witnesses: List<String>,
  dispositions: List<LegacyTestBehaviorDisposition>,
  scan_dirs: List<String>,
  declared_entries: List<String>,
  exclusion_patterns: List<String>,
  offline_patterns: List<String>,
) -> Bool {
  let family_dispositions = legacy_test_behavior_family_dispositions(
    family: family,
    dispositions: dispositions,
  )
  discovery_holds
    && count(legacy_test_behavior_family_discovered(
      family: family,
      discovered_legacy: discovered_legacy,
    )) > 0
    && count(legacy_test_behavior_family_unclassified(
      family: family,
      discovered_legacy: discovered_legacy,
      dispositions: dispositions,
    )) == 0
    && count(legacy_test_behavior_stale_dispositions(
      discovered_legacy: discovered_legacy,
      dispositions: family_dispositions,
    )) == 0
    && count(legacy_test_behavior_duplicate_dispositions(
      dispositions: family_dispositions,
    )) == 0
    && count(legacy_test_behavior_unresolved_witness_dispositions(
      discovered_witnesses: discovered_witnesses,
      dispositions: family_dispositions,
    )) == 0
    && count(legacy_test_behavior_nonexecuting_witness_dispositions(
      dispositions: family_dispositions,
      scan_dirs: scan_dirs,
      declared_entries: declared_entries,
      exclusion_patterns: exclusion_patterns,
      offline_patterns: offline_patterns,
    )) == 0
}

fn legacy_test_behavior_disposition_graph_holds(
  discovery_holds: Bool,
  discovered_legacy: List<String>,
  discovered_witnesses: List<String>,
  dispositions: List<LegacyTestBehaviorDisposition>,
  scan_dirs: List<String>,
  declared_entries: List<String>,
  exclusion_patterns: List<String>,
  offline_patterns: List<String>,
) -> Bool {
  discovery_holds
    && count(legacy_test_behavior_unclassified(
      discovered_legacy: discovered_legacy,
      dispositions: dispositions,
    )) == 0
    && count(legacy_test_behavior_stale_dispositions(
      discovered_legacy: discovered_legacy,
      dispositions: dispositions,
    )) == 0
    && count(legacy_test_behavior_duplicate_dispositions(dispositions: dispositions)) == 0
    && count(legacy_test_behavior_unresolved_witness_dispositions(
      discovered_witnesses: discovered_witnesses,
      dispositions: dispositions,
    )) == 0
    && count(legacy_test_behavior_nonexecuting_witness_dispositions(
      dispositions: dispositions,
      scan_dirs: scan_dirs,
      declared_entries: declared_entries,
      exclusion_patterns: exclusion_patterns,
      offline_patterns: offline_patterns,
    )) == 0
}

data c_compilation_unit_leaf_behavior: LegacyTestBehavior = LegacyTestBehavior {
  source_file: "src/v1/tests/src/c_compilation_unit_witness_test.rs" as FilePath,
  test_fn: "c_compilation_unit_leaf_witness_green_by_execution" as NonEmptyStr,
}

data c_compilation_unit_leaf_witness: TestBehaviorWitness = TestBehaviorWitness {
  entry: "src/v2/test/claim/c_compilation_unit_witness_test.dag" as FilePath,
  test_fn: "witness_r3_header_source_object_paths" as NonEmptyStr,
}

data c_compilation_unit_leaf_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: c_compilation_unit_leaf_behavior,
  witness: c_compilation_unit_leaf_witness,
  distinguishing_failure: "The legacy Rust test is only a wrapper that resolves this exact .dag entry and requires witness_r3_header_source_object_paths to pass. That witness checks the R3 header/source/object path split; collapsing a path arm or changing the unit spelling makes the .dag witness return false, so deleting the wrapper removes no independent oracle." as NonEmptyStr,
}

data dag_comment_wall_family_closed_loop_note: String = "THE FIRST FAMILY CLASSIFIED, AND THE RECEIPT FOR WHY ITS DELETION IS HELD. Subject: after the comment-ban wall, a solidus pair or a slash-star outside a string literal must refuse, a string literal containing a solidus pair must still be accepted, and comment-free source must still compile. Classification authored four CoveredByWitness rows over src/v1/tests/src/dag_comment_wall_test.rs (gunbc#7687). The rows and the legacy module are BOTH still live, deliberately.\n\nWHY DELETION IS HELD, and it is the correction this note exists to carry: the four probes these rows cite are in a directory CI never scans. witness_discovery_scan_dirs is [dag/test/claim, src/v2/test/claim/manual, src/v2/test/claim/emit]; the probes sat in src/v2/test/claim/round_trip, which is in none of them AND matches no exclusion pattern, so they were invisible to discovery by OMISSION rather than by exclusion. Established by execution on the populated main-push log that landed gunbc#7687 — 2000+ witnesses executed, zero from that file — with source_authority_contract_test.dag in the same directory as the control, which also executes zero, making it a lane fact rather than a file fact. An earlier revision of this note said deletion had already removed the module and the rows together; that was written against a local claim_batch run, and claim_batch is not the executor that gates a merge.\n\nTHE RULE THAT FAILED, stated so it is not re-derived: a CoveredByWitness row is a claim that a named witness goes red for the same reason the deleted test existed. A witness that never runs cannot go red for any reason, so co-greenness on a developer machine is not coverage — it is the same specification-without-execution failure one level up from the one this family was migrated to fix. The probes move into a scanned directory and the rows repoint at the new path; deletion follows a CI receipt naming the four probes, never a local run.\n\nWHAT THE ROWS ARE FOR (DESIGN 4b(4)): the four executing probes — dag_comment_wall_clean_source_compiles, dag_comment_wall_line_comment_refused, dag_comment_wall_block_comment_refused, dag_comment_wall_slash_slash_inside_string_compiles — are the permanent regression wall, and their module note carries why each is discriminating against its own accepted control. They are what will make deletion safe once they execute where the merge gate can see them.\n\nTHE INVARIANT THAT STILL HOLDS: a disposition whose behavior no longer discovers is stale and this graph refuses stale rows, so classification rows are scoped to the live population by construction and cannot outlive the tests they classify. Rows and behaviors depart together — which is exactly why holding the deletion holds the rows too, rather than leaving a graph that reads discharged while nothing executes.\n\nTHE NUMBER A READER WILL GET WRONG: deletion does NOT move the unclassified frontier. Discovered behaviors and their dispositions depart together, so the difference is unchanged and only the denominator shrinks. The frontier moves on CLASSIFICATION alone; deletion collects debt classification already discharged. A flat frontier across a deletion wave is the mechanism working, not a stalled lane."

data optional_rendering_family_note: String = "THE v1-EMITTER OPTIONAL-RENDERING FAMILY, family two. Subject: how the Route-A Rust emitter treats a DECLARED optional — the signature it renders for an optional return, and the call-site construction it emits when an optional flows into a non-optional parameter. The two legacy modules are one family because they are two halves of one repair: making the signature render Option<..> faithfully is what EXPOSED the optional-into-required mismatch at call sites, and the fail-closed unwrap is what closes it. Splitting them would leave each half's control arguing about a fact the other half owns.\\n\\nWHY THIS FAMILY WAS MIGRATABLE WHERE THE TYPESCRIPT ONE WAS NOT: the assertions are about EMITTED TEXT, and compile_dag_rust_emit_check already carries emitted-substring inclusion and exclusion through the production compile path, so no host process and no new capability was needed. Where the Rust modules had to slice the emitted text to a single function before asserting a bare `Option<` — because the runtime's own types mention Option and a whole-file scan would pass on them — the migrated witnesses name the WHOLE expected signature instead, which needs no scoping and pins parameter spelling and carrier rendering as well."

data optional_rendering_family: LegacyTestBehaviorFamily = LegacyTestBehaviorFamily {
  name: "v1-emitter-optional-rendering" as NonEmptyStr,
  source_files: [
    "src/v1/tests/src/optional_carrier_signature_test.rs" as FilePath,
    "src/v1/tests/src/optional_consumer_fail_closed_test.rs" as FilePath,
  ],
}

data optional_signature_witness_entry: FilePath = "dag/test/claim/optional_carrier_signature_test.dag" as FilePath
data optional_consumer_witness_entry: FilePath = "dag/test/claim/optional_consumer_fail_closed_test.dag" as FilePath

data optional_string_signature_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: LegacyTestBehavior {
    source_file: "src/v1/tests/src/optional_carrier_signature_test.rs" as FilePath,
    test_fn: "optional_string_return_renders_option_signature" as NonEmptyStr,
  },
  witness: TestBehaviorWitness {
    entry: optional_signature_witness_entry,
    test_fn: "optional_string_return_renders_option_signature" as NonEmptyStr,
  },
  distinguishing_failure: "The regression this behavior exists to catch is the text-carrier early return short-circuiting the Optional template, which emitted a bare String while the body already produced Some/None. Executed perturbation: changing the fixture return from String? to String — the exact cardinality fact the wrap derives from — makes the emitted signature stop being Option<String> and the witness returns false. It asserts the WHOLE signature rather than a bare Option< token, so it also reds on a change that kept the wrap while altering parameter spelling or carrier rendering, which the sliced substring check in the Rust module could not see." as NonEmptyStr,
}

data non_optional_string_signature_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: LegacyTestBehavior {
    source_file: "src/v1/tests/src/optional_carrier_signature_test.rs" as FilePath,
    test_fn: "non_optional_string_return_stays_bare" as NonEmptyStr,
  },
  witness: TestBehaviorWitness {
    entry: optional_signature_witness_entry,
    test_fn: "non_optional_string_return_stays_bare" as NonEmptyStr,
  },
  distinguishing_failure: "This is the control proving the wrap is cardinality-DERIVED and not blanket-on-String: a repair that wrapped every text carrier would fix its sibling witness and break this one. Executed perturbation: giving the fixture an optional return instead makes the emitted signature wrapped and the exclusion fires, so the witness returns false. The exclusion names the specific wrapped signature rather than the token Option<, because an unscoped exclusion would red on unrelated runtime code — a guard firing for the wrong reason is not coverage." as NonEmptyStr,
}

data optional_shared_type_signature_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: LegacyTestBehavior {
    source_file: "src/v1/tests/src/optional_carrier_signature_test.rs" as FilePath,
    test_fn: "optional_shared_type_return_renders_option_rc_signature" as NonEmptyStr,
  },
  witness: TestBehaviorWitness {
    entry: optional_signature_witness_entry,
    test_fn: "optional_shared_type_return_renders_option_rc_signature" as NonEmptyStr,
  },
  distinguishing_failure: "A shared (recursive) type is a separate rendering path from the text carrier — it composes the Optional wrap with the Rc wrap — so it carries its own witness rather than sharing one. The witness names the composed signature exactly, Option<Rc<Node>>, so losing EITHER wrap reds it: emitting Rc<Node> loses the optional, emitting Option<Node> loses the sharing, and both are false where a check for the substring Option< alone would accept the second." as NonEmptyStr,
}

data non_optional_shared_type_signature_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: LegacyTestBehavior {
    source_file: "src/v1/tests/src/optional_carrier_signature_test.rs" as FilePath,
    test_fn: "non_optional_shared_type_return_stays_bare_rc" as NonEmptyStr,
  },
  witness: TestBehaviorWitness {
    entry: optional_signature_witness_entry,
    test_fn: "non_optional_shared_type_return_stays_bare_rc" as NonEmptyStr,
  },
  distinguishing_failure: "The shared-type control: the emitted signature must keep Rc while refusing Option, which separates the two wraps that the positive witness composes. It reds if a blanket optional wrap is applied to shared types, and — because it requires Rc<Node> positively rather than merely excluding Option — it also reds if the sharing wrap is dropped, a failure an exclusion-only control would pass." as NonEmptyStr,
}

data required_param_optional_arg_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: LegacyTestBehavior {
    source_file: "src/v1/tests/src/optional_consumer_fail_closed_test.rs" as FilePath,
    test_fn: "required_param_optional_arg_emits_located_fail_closed_unwrap" as NonEmptyStr,
  },
  witness: TestBehaviorWitness {
    entry: optional_consumer_witness_entry,
    test_fn: "required_param_optional_arg_emits_located_fail_closed_unwrap" as NonEmptyStr,
  },
  distinguishing_failure: "Executed perturbation: feeding the same required parameter a non-optional argument removes the located expect from the emitted call site and the witness returns false, so the assertion is attributable to the optional-into-required shape rather than to the fixture existing. The witness additionally EXCLUDES unwrap_or_default and unwrap_or_else, which is the load-bearing half: the DESIGN 5 fact is not that some unwrap is emitted but that the fabricating shape never is, and an inclusion-only witness would stay green if a fabricating fallback were added beside the expect." as NonEmptyStr,
}

data required_param_nonoptional_arg_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: LegacyTestBehavior {
    source_file: "src/v1/tests/src/optional_consumer_fail_closed_test.rs" as FilePath,
    test_fn: "required_param_nonoptional_arg_stays_bare" as NonEmptyStr,
  },
  witness: TestBehaviorWitness {
    entry: optional_consumer_witness_entry,
    test_fn: "required_param_nonoptional_arg_stays_bare" as NonEmptyStr,
  },
  distinguishing_failure: "The control that makes the unwrap type-derived rather than blanket: an implementation that unwrapped every argument passes its sibling witness and fails this one. The exclusion is whole-file rather than scoped to the emitted drive function, which the Rust module needed — verified by execution that this fixture emits no fail-closed expect anywhere, so the unscoped exclusion cannot be satisfied by absence in one function while the string appears in another." as NonEmptyStr,
}

data empty_optional_unwrap_disposition: LegacyTestBehaviorDisposition = DeleteLowValueBehavior {
  behavior: LegacyTestBehavior {
    source_file: "src/v1/tests/src/optional_consumer_fail_closed_test.rs" as FilePath,
    test_fn: "empty_optional_unwrap_panics_not_fabricates" as NonEmptyStr,
  },
  reason: "NO gunbc CODE IS IN THIS TEST'S LOOP. It builds an empty Vec in Rust, calls Option::expect on the resulting None inside catch_unwind and asserts a panic, then calls unwrap_or_default and asserts it yields 0. Both are guarantees of the Rust standard library, true independently of anything this repository emits, and neither invokes the compiler, the emitter, or any fixture source. It is a demonstration of why the emitter's choice matters, written as a test — valuable as documentation, worth nothing as an oracle, because no change to gunbc can make it fail. The fact it is really about — that the emitter chooses the aborting shape and never the fabricating one — is asserted where that choice is actually made, by the migrated call-site witness's exclusion of unwrap_or_default and unwrap_or_else. Deleted for having no gunbc-observable failure mode, not to reduce a count." as NonEmptyStr,
}

data dag_comment_wall_family_note: String = "THE dag-comment-wall BEHAVIOR FAMILY, the first family carried to completion. Subject: after the comment-ban wall, a `//` or `/* */` outside a string literal must refuse, a string literal containing `//` must still be accepted, and comment-free source must still compile. Before this migration the floor carried the subject only as two FidelityDisposition rows (test.claim.dag_comment_wall_test dag_line_comment_is_fail_closed / dag_block_comment_is_fail_closed), which assert what the language model DECLARES and stay green under a tokenizer that re-admits comment-skip — a declaration standing where an execution was available. The four executing probes now in that same file drive the production compile path (compile_dag_rust_emit_check, the compile-clean hard-diagnostic authority) that the Rust module drove through parse_with_table, so each row below names a witness that goes red for the reason its behavior existed rather than a peer that merely stays quiet. Deletability of the Rust module is separate and already authorized at stem grain: the floor witness file shares the stem dag_comment_wall_test, so the delete guard admits the module the moment a change deletes it. Deletion is deliberately NOT part of this change — a disposition whose behavior no longer discovers is stale and refuses, so classification and deletion are separate acts on this graph."

data dag_comment_wall_family: LegacyTestBehaviorFamily = LegacyTestBehaviorFamily {
  name: "dag-comment-wall" as NonEmptyStr,
  source_files: ["src/v1/tests/src/dag_comment_wall_test.rs" as FilePath],
}

data comment_wall_clean_behavior: LegacyTestBehavior = LegacyTestBehavior {
  source_file: "src/v1/tests/src/dag_comment_wall_test.rs" as FilePath,
  test_fn: "clean_source_parses" as NonEmptyStr,
}

data comment_wall_clean_witness: TestBehaviorWitness = TestBehaviorWitness {
  entry: "dag/test/claim/dag_comment_wall_test.dag" as FilePath,
  test_fn: "dag_comment_wall_clean_source_compiles" as NonEmptyStr,
}

data comment_wall_clean_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: comment_wall_clean_behavior,
  witness: comment_wall_clean_witness,
  distinguishing_failure: "The behavior exists because a wall that refuses comments must not also refuse valid code. The witness compiles the comment-free module comment_wall_clean through the production compile path and requires acceptance, so a wall widened past comments — a tokenizer arm that refuses any source containing a solidus, or a hard diagnostic raised on well-formed input — makes it return false. It is also the accepted control the two refusal witnesses are discriminated against: their probe sources differ from this one only by the comment text, so a fixture defect that redded a refusal probe for an unrelated reason reds this row too instead of passing as a wall." as NonEmptyStr,
}

data comment_wall_line_behavior: LegacyTestBehavior = LegacyTestBehavior {
  source_file: "src/v1/tests/src/dag_comment_wall_test.rs" as FilePath,
  test_fn: "line_comment_fails_to_parse" as NonEmptyStr,
}

data comment_wall_line_witness: TestBehaviorWitness = TestBehaviorWitness {
  entry: "dag/test/claim/dag_comment_wall_test.dag" as FilePath,
  test_fn: "dag_comment_wall_line_comment_refused" as NonEmptyStr,
}

data comment_wall_line_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: comment_wall_line_behavior,
  witness: comment_wall_line_witness,
  distinguishing_failure: "Restoring line-comment skipping to the tokenizer is the input this behavior exists to catch. Under that change the probe source `fn probe() -> Bool { true } // comment` stops producing hard diagnostics, compile_dag_rust_emit_check answers true, and the negated witness returns false — the same discriminating input that made the Rust assertion fail, driven through the same compile path. The pre-existing floor row dag_line_comment_is_fail_closed does NOT have this property: it compares a declared FidelityDisposition constant and stays green under exactly that tokenizer edit, which is why the migration added an executing probe rather than citing the declaration." as NonEmptyStr,
}

data comment_wall_block_behavior: LegacyTestBehavior = LegacyTestBehavior {
  source_file: "src/v1/tests/src/dag_comment_wall_test.rs" as FilePath,
  test_fn: "block_comment_fails_to_parse" as NonEmptyStr,
}

data comment_wall_block_witness: TestBehaviorWitness = TestBehaviorWitness {
  entry: "dag/test/claim/dag_comment_wall_test.dag" as FilePath,
  test_fn: "dag_comment_wall_block_comment_refused" as NonEmptyStr,
}

data comment_wall_block_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: comment_wall_block_behavior,
  witness: comment_wall_block_witness,
  distinguishing_failure: "The block form is a separate tokenizer arm from the line form, so it carries its own witness rather than sharing one: re-admitting `/* */` skipping alone leaves the line probe red while this probe's source `/* comment */` starts compiling, flipping this witness to false on its own. The floor's declared dag_block_comment_is_fail_closed row is green under that same edit." as NonEmptyStr,
}

data comment_wall_string_behavior: LegacyTestBehavior = LegacyTestBehavior {
  source_file: "src/v1/tests/src/dag_comment_wall_test.rs" as FilePath,
  test_fn: "slash_slash_inside_string_literal_parses" as NonEmptyStr,
}

data comment_wall_string_witness: TestBehaviorWitness = TestBehaviorWitness {
  entry: "dag/test/claim/dag_comment_wall_test.dag" as FilePath,
  test_fn: "dag_comment_wall_slash_slash_inside_string_compiles" as NonEmptyStr,
}

data comment_wall_string_disposition: LegacyTestBehaviorDisposition = CoveredByWitness {
  behavior: comment_wall_string_behavior,
  witness: comment_wall_string_witness,
  distinguishing_failure: "The behavior exists because the wall must stop at the string boundary. A wall implemented by refusing the solidus pair anywhere in the source — the obvious over-broad fix, and the one the Rust module was written against — makes the probe module holding \"https://example.com\" fail to compile and this witness return false. The witness file's own url literal is a second, structurally stronger oracle for the same fact: under that over-broad wall the witness module stops tokenizing and every row in it reds, so this behavior cannot be silently lost." as NonEmptyStr,
}

fn legacy_test_behavior_dispositions() -> List<LegacyTestBehaviorDisposition> {
  [
    c_compilation_unit_leaf_disposition,
    optional_string_signature_disposition,
    non_optional_string_signature_disposition,
    optional_shared_type_signature_disposition,
    non_optional_shared_type_signature_disposition,
    required_param_optional_arg_disposition,
    required_param_nonoptional_arg_disposition,
    empty_optional_unwrap_disposition,
    comment_wall_clean_disposition,
    comment_wall_line_disposition,
    comment_wall_block_disposition,
    comment_wall_string_disposition,
  ]
}

fn legacy_test_behavior_ids_live() -> List<String> {
  test_migration_legacy_behavior_ids()
}

fn test_behavior_witness_ids_live() -> List<String> {
  test_migration_witness_behavior_ids()
}

fn legacy_test_behavior_unclassified_live() -> List<String> {
  legacy_test_behavior_unclassified(
    discovered_legacy: legacy_test_behavior_ids_live(),
    dispositions: legacy_test_behavior_dispositions(),
  )
}

fn legacy_test_behavior_unclassified_count_live() -> Int {
  count(legacy_test_behavior_unclassified_live())
}

fn legacy_test_behavior_declared_slice_holds() -> Bool {
  let discovered_legacy = legacy_test_behavior_ids_live()
  let discovered_witnesses = test_behavior_witness_ids_live()
  test_migration_behavior_discovery_holds()
    && discovered_legacy |> any(id => id == legacy_test_behavior_id(
      behavior: c_compilation_unit_leaf_behavior,
    ))
    && discovered_witnesses |> any(id => id == test_behavior_witness_id(
      witness: c_compilation_unit_leaf_witness,
    ))
    && count(legacy_test_behavior_stale_dispositions(
      discovered_legacy: discovered_legacy,
      dispositions: legacy_test_behavior_dispositions(),
    )) == 0
    && count(legacy_test_behavior_duplicate_dispositions(
      dispositions: legacy_test_behavior_dispositions(),
    )) == 0
    && count(legacy_test_behavior_unresolved_witness_dispositions(
      discovered_witnesses: discovered_witnesses,
      dispositions: legacy_test_behavior_dispositions(),
    )) == 0
}

fn witness_scan_dirs_live() -> List<String> {
  witness_discovery_scan_dirs
}

data witness_declared_entry_roster_gap_note: String = "THE DECLARED-ENTRY ROSTER IS EMPTY HERE, AND EMPTY IS THE FAIL-CLOSED DIRECTION. Discovery is not the only way a witness runs: CiSpec.witness_entries carries explicit rows that execute as declared regardless of scan dirs, and a row citing one of those would be genuinely scheduled while sitting outside every scan dir. This projection does not read that roster yet, so it reports the empty list, which can only ever REFUSE a row that should have been admitted — never admit one that should have been refused. That is the direction a gap is allowed to point (DESIGN 5): an under-approximation of scheduling produces a false refusal, which is loud and counted, whereas the over-approximation this wall was built to remove produced a false admission, which is silent. No row in this graph currently cites a declared entry, so the roster is empty in fact as well as in code. DISSOLVE-ON: the first CoveredByWitness row citing an entry outside every scan dir — at that point this projection reads the real CiSpec.witness_entries roster instead of returning empty, and the row's admission is established rather than assumed."

