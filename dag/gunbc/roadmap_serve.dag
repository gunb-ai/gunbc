data roadmap_serve_table_build_note: String = "Fail-closed table construction (review 40286, the §5 catch: the earlier serve_tpl mapped MalformedPathTemplate to an EMPTY template, and an empty template matches exactly '/' — so a typo in any route literal would have silently become a second root matcher, a widen at the very seam §5 forbids). The build is now a typed fold: the FIRST malformed literal refuses the WHOLE table (RoadmapServeTableRefused carries raw/segment/reason — typed, located), and the serve entry answers EVERY request with a 500 naming the broken literal until it is fixed — a loudly broken dashboard, never silently wrong routing. The RED control is witness_malformed_route_literal_refuses_table (a bad literal through the same build fold -> Refused)."

type RoadmapServeRouteSpec {
  method: HttpMethod
  raw: String
  handler: RoadmapServeHandler
}

type RoadmapServeTableBuild
  = RoadmapServeTable { table: ServedRouteTable<RoadmapServeHandler> }
  | RoadmapServeTableRefused { raw: String, segment: String, reason: String }

fn roadmap_serve_route_specs() -> List<RoadmapServeRouteSpec> {
  [
    RoadmapServeRouteSpec { method: GET, raw: "/", handler: RoadmapDailyPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/roadmap", handler: RoadmapFullPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/ROADMAP.md", handler: RoadmapMdHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/target/roadmap-dispatch.json", handler: DispatchJsonHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/healthz", handler: HealthzHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/instance.json", handler: DashboardInstanceHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/provider.json", handler: ProviderReadinessHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/sessions.json", handler: SessionsJsonHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/attempts.json", handler: AttemptsJsonHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/workflow.json", handler: WorkflowJsonHandler },
    RoadmapServeRouteSpec { method: GET, raw: roadmap_dispatch_asset_path, handler: DispatchAssetHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/sandbox", handler: SandboxPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_sandbox_page_path, handler: InstrumentSandboxPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_tuner_page_path, handler: InstrumentTunerPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_tuner_asset_path, handler: InstrumentTunerAssetHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_motion_page_path, handler: InstrumentMotionPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_motion_asset_path, handler: InstrumentMotionAssetHandler },
    RoadmapServeRouteSpec { method: GET, raw: repo_atlas_page_path, handler: RepoAtlasPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: sandbox_asset_path, handler: SandboxAssetHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/sandbox/echo", handler: SandboxEchoHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/dispatch/\{node_id\}", handler: BeltDispatchHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/publish/\{node_id\}", handler: BeltPublishHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/cleanup/\{node_id\}", handler: BeltStopHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/stop/\{node_id\}", handler: BeltStopHandler },
  ]
}

type RoadmapServeRouteRow
  = RouteRow { route: ServedRoute<RoadmapServeHandler> }
  | RouteRowRefused { raw: String, segment: String, reason: String }

data roadmap_serve_build_shape_note: String = "Cost-shape per DESIGN §6 bare-minimum-cost (review 40297 note: the first cut grew the route list by concat inside a fold — the copied-accumulator class that is always fixed regardless of realized n): the build is now map (per-spec row sum) + a scalar first-refusal fold (no list accumulation) + flat_map projection — linear by construction. The projection's RouteRowRefused arm contributes nothing and is reached only in the refusal-free branch (the scalar fold structurally excludes refused rows there), so it is a projection, never a fabricated value."

fn roadmap_serve_route_row(spec: RoadmapServeRouteSpec) -> RoadmapServeRouteRow {
  match parse_path_template(raw: spec.raw) {
    MalformedPathTemplate { raw: r, segment: s, reason: why } =>
      RouteRowRefused { raw: r, segment: s, reason: why }
    ParsedPathTemplate { template: tpl } =>
      RouteRow { route: DynamicRoute { method: spec.method, path_pattern: tpl, handler: spec.handler } }
  }
}

fn roadmap_serve_build_from_specs(specs: List<RoadmapServeRouteSpec>) -> RoadmapServeTableBuild {
  let rows = map(specs, spec => roadmap_serve_route_row(spec: spec))
  let first_refusal = fold(rows, init: none, f: (acc, r) =>
    match acc {
      Present { value: v } => acc
      Absent =>
        match r {
          RouteRowRefused { raw: rr, segment: s, reason: why } =>
            Present { value: RoadmapServeTableRefused { raw: rr, segment: s, reason: why } }
          RouteRow { route: _ } => Absent
        }
    }
  )
  match first_refusal {
    Present { value: refusal } => refusal
    Absent =>
      RoadmapServeTable {
        table: ServedRouteTable {
          routes: rows |> flat_map(r => match r {
            RouteRow { route: rt } => [rt]
            RouteRowRefused { raw: _, segment: _, reason: _ } => []
          })
        }
      }
  }
}

fn roadmap_serve_route_table_build() -> RoadmapServeTableBuild {
  roadmap_serve_build_from_specs(specs: roadmap_serve_route_specs())
}

fn serve_text_response(status: HttpStatus, content_type: MediaType, body: String) -> ServeHttpResponse {
  ServeHttpResponse { status: status, content_type: content_type, body: body }
}

data serve_page_response_note: String = "A page render refusal is a TYPED 500 carrying the emitter's reason — never an empty page and never a dropped route (the EmitRejected => [] route-drop in node_http_server_emit is a silent widen this path deliberately does not copy; DESIGN 5). The BODY of both arms is roadmap_static_site.served_page_body, shared with the healthz digest map rather than spelled twice: healthz publishes the digest of the served surface so a deploy can prove the running process is serving THIS tree, and a digest taken over a body that is merely supposed to match the route's would be validation standing where construction was available — the check would go green while the route lied. Only the STATUS split lives here, because a digest has no status."

fn serve_page_response(page: Fragment) -> ServeHttpResponse {
  match try_serialize_html_source(node: page) {
    EmitOk { html: h } =>
      serve_text_response(status: 200, content_type: text_html_utf8, body: h)
    EmitRejected { reason: r } =>
      serve_text_response(
        status: 500,
        content_type: text_plain_utf8,
        body: page_render_refusal_body(reason: r),
      )
  }
}

fn serve_page_response_with_status(page: Fragment, status: HttpStatus) -> ServeHttpResponse {
  match try_serialize_html_source(node: page) {
    EmitOk { html } => serve_text_response(status: status, content_type: text_html_utf8, body: html)
    EmitRejected { reason } => serve_text_response(
      status: 500,
      content_type: text_plain_utf8,
      body: page_render_refusal_body(reason: reason),
    )
  }
}

data belt_dispatch_status_note: String = "TOTAL per-variant status mapping — every BeltDispatchResult arm has its own row, no lazy 200-or-500 collapse (DESIGN 5; parent review 2026-07-20). Spawned/AlreadyLive = 200 (the click achieved or already holds the desired state — the same idempotent-success fold the CLI's exit map uses); NodeNotFound = 404; AlreadyDone = 409 (the operator's signoff makes the node undisp atchable — a conflict with current state, retryable never); ObserveRefused = 503 (the live session set was unknowable, retry can succeed); SpawnFailed = 502 (actuation behind the server failed; the receipt carries step + detail)."

fn belt_dispatch_status(r: BeltDispatchResult) -> HttpStatus {
  match r {
    DispatchSpawned { node_id: _, session_name: _, provider: _ } => 200
    DispatchAlreadyLive { node_id: _, session_name: _ } => 200
    DispatchDisabled { node_id: _, instance_id: _, reason: _ } => 403
    DispatchNodeNotFound { node_id: _ } => 404
    DispatchNodeAlreadyDone { node_id: _ } => 409
    DispatchObserveRefused { node_id: _, reason: _ } => 503
    DispatchAuthorityRefused { node_id: _, detail: _ } => 503
    DispatchSpawnFailed { node_id: _, step: _, detail: _, provider: _ } => 502
    DispatchStaleSession { node_id: _, session_name: _, detail: _ } => 409
    DispatchRevisionDrifted { node_id: _, desired: _, local: _ } => 409
    DispatchRevisionUnobserved { node_id: _, cause: _ } => 503
    DispatchSessionMultiplicityConflict { node_id: _, session_names: _, session_count: _ } => 409
    DispatchSessionLivenessUnobserved { node_id: _, session_name: _, reason: _ } => 503
  }
}

fn belt_dispatch_response(r: BeltDispatchResult) -> ServeHttpResponse {
  serve_text_response(
    status: belt_dispatch_status(r: r),
    content_type: application_json_utf8,
    body: serialize_json(v: belt_dispatch_result_json_value(r: r)),
  )
}

data serve_dispatch_param_note: String = "The node_id param is bound by the route template, so an empty value is unreachable by construction (match_path_template refuses empty segments); the empty-check below is the typed backstop for that unreachable arm — a 400 refusal, never a dispatch with a fabricated id (DESIGN 5: an unreachable arm refuses, never fabricates)."

fn serve_dispatch_handler_response_for_instance(
  instance: HostDashboardInstance,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if node_id == "" {
    serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "dispatch requires a node id path segment (fail-closed; empty binding is unreachable by construction)\n",
    )
  } else {
    belt_dispatch_response(
      r: belt_dispatch_node_for_instance(instance: instance, node_id: node_id),
    )
  }
}

data serve_publish_note: String = "POST /publish/NODE_ID is the publication producer's live trigger, and it exists because belt_tick has none. Publication is wired into that actuation pass beside verification and nothing drives it, so without this route the receipt would never be written in production and the row's lamp could never move off pending - the same never-runs defect one layer out from the one this lane fixed.\\n\\nIT IS A POST BECAUSE IT WRITES. The workflow route reads and paints; this one observes two remote surfaces and persists a judgment, and putting that on the read path would make the browser poll the thing that queries GitHub - the split serve_workflow_note already draws for verification.\\n\\nTHE STATUS COMES FROM THE OUTCOME, not from whether the handler ran. A deferral is 409 and a belt-side failure is 500, so a caller can tell `the attempt is not ready` from `the belt could not do its job` without reading prose."

fn serve_publish_handler_response_for_instance(
  instance: HostDashboardInstance,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if node_id == "" {
    serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "publish requires a node id path segment (fail-closed; empty binding is unreachable by construction)\n",
    )
  } else {
    let outcome = belt_publish_node_for_instance(instance: instance, node_id: node_id)
    serve_text_response(
      status: belt_publish_outcome_http_status(o: outcome),
      content_type: application_json_utf8,
      body: serialize_json(v: belt_publish_outcome_json_value(o: outcome)),
    )
  }
}

fn serve_dispatch_handler_response(params: List<PathParamBinding>) -> ServeHttpResponse {
  serve_dispatch_handler_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    params: params,
  )
}

fn dashboard_instance_json(instance: HostDashboardInstance) -> String {
  let plan = dashboard_instance_provision_plan_rows(instance: instance)
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: dashboard_instance_health_schema)),
    json_kv(key: "instance_id", value: json_string(s: instance.instance_id as String)),
    json_kv(key: "host_identity", value: json_string(s: instance.host_identity as String)),
    json_kv(
      key: "actuation",
      value: json_string(s: dashboard_actuation_posture_label(posture: instance.actuation)),
    ),
    json_kv(key: "repo_root", value: json_string(s: instance.repo_root as String)),
    json_kv(
      key: "dispatch_worktree_root",
      value: json_string(s: dashboard_instance_dispatch_worktree_root(instance: instance) as String),
    ),
    json_kv(
      key: "dispatch_attempt_state_root",
      value: json_string(s: dashboard_instance_dispatch_attempt_state_root(instance: instance) as String),
    ),
    json_kv(key: "listen_port", value: json_int(n: instance.listen_port)),
    json_kv(key: "serve_function", value: json_string(s: instance.serve_function as String)),
    json_kv(key: "dispatch_base_ref", value: json_string(s: instance.dispatch_base_ref as String)),
    json_kv(
      key: "provision_transport",
      value: json_string(s: dashboard_provision_transport_label(
        transport: instance.provision_transport,
      )),
    ),
    json_kv(
      key: "desired_provision_plan",
      value: json_array(elements: plan |> map(row => json_object(members: [
        json_kv(key: "kind", value: json_string(s: row.kind as String)),
        json_kv(key: "target", value: json_string(s: row.target)),
        json_kv(key: "detail", value: json_string(s: row.detail)),
      ]))),
    ),
  ]))
}

data sandbox_echo_note: String = "The /sandbox echo handler answers ANY wire arm on demand so every dispatch state is pressable without spawning a session (P4). It reads ?status=LABEL from the request path (uri_query_param — the query survives in request.path; match_path_template strips it only for routing) and maps it to the belt result exemplar via belt_dispatch_result_for_label, serializing the SAME belt_dispatch_result_json_value the real dispatch returns — so the sandbox JSON shape is identical to production, never a mock. Fail-closed: an unknown or missing status refuses with a 400 that names the valid label set, never a fabricated arm."

fn sandbox_echo_response(request: ServeHttpRequest) -> ServeHttpResponse {
  let status = uri_query_param(path: request.path, key: "status")
  match belt_dispatch_result_for_label(wire_label: status) {
    Present { value: r } =>
      serve_text_response(
        status: 200,
        content_type: application_json_utf8,
        body: serialize_json(v: belt_dispatch_result_json_value(r: r)),
      )
    Absent =>
      serve_text_response(
        status: 400,
        content_type: text_plain_utf8,
        body: join([
          "unknown status label: ", status,
          " (fail-closed; valid: ", join(belt_dispatch_all_status_labels(), ", "), ")\n",
        ], ""),
      )
  }
}

data serve_invoke_request_note: String = "Every handler receives the FULL modeled ServeHttpRequest (review 40314: the request body was formerly accepted at the seam and dropped before invoke, so a body-reading POST handler would have silently seen the empty string — a latent widen)."

fn roadmap_serve_invoke_for_instance(
  instance: HostDashboardInstance,
  handler: RoadmapServeHandler,
  params: List<PathParamBinding>,
  request: ServeHttpRequest,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  match handler {
    RoadmapDailyPageHandler => serve_daily_page_response_for_instance(instance: instance)
    RoadmapFullPageHandler => serve_page_response(page: roadmap_page_for_authority())
    RoadmapMdHandler => serve_text_response(status: 200, content_type: text_plain_utf8, body: roadmap_site_roadmap_md_body())
    DispatchJsonHandler => serve_text_response(status: 200, content_type: application_json_utf8, body: roadmap_site_dispatch_json_body())
    HealthzHandler => serve_text_response(status: 200, content_type: application_json_utf8, body: roadmap_site_healthz_body_for_release(release_revision: release_revision))
    DashboardInstanceHandler =>
      serve_text_response(
        status: 200,
        content_type: application_json_utf8,
        body: dashboard_instance_json(instance: instance),
      )
    ProviderReadinessHandler =>
      serve_text_response(
        status: 200,
        content_type: application_json_utf8,
        body: dashboard_provider_readiness_json(instance: instance),
      )
    BeltDispatchHandler =>
      serve_dispatch_handler_response_for_instance(instance: instance, params: params)
    DispatchAssetHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: dispatch_client_js_source())
    SandboxPageHandler => serve_page_response(page: sandbox_page())
    InstrumentSandboxPageHandler => serve_page_response(page: instrument_sandbox_page())
    InstrumentTunerPageHandler => serve_page_response(page: instrument_tuner_page())
    InstrumentTunerAssetHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: instrument_tuner_client_js_source())
    InstrumentMotionPageHandler => serve_page_response(page: instrument_motion_page())
    InstrumentMotionAssetHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: instrument_motion_client_js_source())
    RepoAtlasPageHandler => serve_page_response(page: repo_atlas_page())
    SandboxAssetHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: sandbox_client_js_source())
    SandboxEchoHandler => sandbox_echo_response(request: request)
    SessionsJsonHandler => serve_sessions_response_for_instance(instance: instance)
    AttemptsJsonHandler => serve_attempts_response_for_instance(instance: instance)
    WorkflowJsonHandler => serve_workflow_response_for_instance(instance: instance)
    BeltStopHandler => serve_stop_handler_response_for_instance(instance: instance, params: params)
    BeltPublishHandler => serve_publish_handler_response_for_instance(instance: instance, params: params)
  }
}

fn roadmap_serve_invoke(
  handler: RoadmapServeHandler,
  params: List<PathParamBinding>,
  request: ServeHttpRequest,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_invoke_for_instance(
    instance: srv1_live_dashboard_instance(),
    handler: handler,
    params: params,
    request: request,
    release_revision: release_revision,
  )
}

fn serve_stop_handler_response_for_instance(
  instance: HostDashboardInstance,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if node_id == "" {
    serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "cleanup requires a node id path segment (fail-closed; empty binding is unreachable by construction)\n",
    )
  } else {
    let r = belt_stop_node_for_instance(instance: instance, node_id: node_id)
    serve_text_response(
      status: belt_stop_http_status(r: r),
      content_type: application_json_utf8,
      body: serialize_json(v: belt_stop_result_json_value(r: r)))
  }
}

fn serve_stop_handler_response(params: List<PathParamBinding>) -> ServeHttpResponse {
  serve_stop_handler_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    params: params,
  )
}

fn serve_attempts_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  let a = belt_attempts_observe_for_instance(instance: instance)
  serve_text_response(
    status: belt_attempts_http_status(a: a),
    content_type: application_json_utf8,
    body: belt_attempts_observed_json(a: a))
}

fn serve_attempts_response() -> ServeHttpResponse {
  serve_attempts_response_for_instance(instance: srv1_live_dashboard_instance())
}

data serve_workflow_note: String = "GET /workflow.json is the evidence-derived attempt pipeline. One observation joins current modeled state, a bounded jq projection of complete Codex attempt evidence, retained process exit, and the node's declared validation contract. The exact projector executable is an ensured platform capability. It validates each raw JSON value while omitting unbounded command payloads from the synchronous interpreted handler; projector absence or malformed input remains an explicit per-attempt refusal. The observed facts reconcile by fold against the shared desired obligation roster and expose desired/observed/remaining counts plus distinct observed-failure, observed-refusal, and unsafe-plan-refusal counts; they never upgrade provider completion into verification, publication, review, or goal audit. A refused attempts ledger returns 503; per-attempt event/process refusals remain explicit segment states in a 200 body so one damaged attempt cannot erase evidence from every other row."

data serve_daily_page_observed_note: String = "The daily page consumes the SAME attempt observation the /workflow.json wire serves (one observing authority, two projections): an observed ledger renders real activity regions and the active band; a refused ledger renders the page with the ONE workspace observation banner carrying the located reason — the page itself stays a 200 because the roadmap authority rendered fine; what failed is the activity channel, and that failure is narrated once, in place, exactly as the client would narrate it on a later poll."

data roadmap_serve_host_shell_bounded_drain_receipt_note: String = "HOST-BOUNDARY AMPLIFIER REPAIR (PR #8087, operator ruling 2026-08-10): v1_interpreter dispatch_shell drains child stdout/stderr concurrently while the child runs. Bounded the stderr buffer+clone amplifier on the shell success path — stderr retains bounded tail (16 KiB) with total_bytes, truncated, and FNV digest_hex surfaced via CapturedStreamEvidence / map_shell_outputs from_key fields; stdout complete-within 8 MiB or typed ShellOutputLimitExceeded refusal (never a silent prefix). TWO WEDGES, TWO ATTEMPTS — this note originally attributed the 59.5 MB figure to the profiled recurrence, which was wrong: attempt-state holds several attempts per node and only the -current one is projected (the gate is <instance_root>/attempt-state/<node>-current/attempt-key), and for node v2-emitter-direct-rust-door that key's mtime is 2026-08-09 17:52:15, 8m41s BEFORE the 18:00:56 wedge, naming 677905e3704d70a3. So the 2026-08-08 wedge selected ...-acc0923494fc8b9cb (60,257,673 B raw / 831 lines / 308 non-JSON / jq stdout 30,770 B / jq stderr 59,522,411 B) while the profiled 2026-08-09 recurrence selected ...-a677905e3704d70a3 (20,511,073 B raw / 355 lines / 101 non-JSON / jq stdout 15,034 B / jq stderr 18,421,072 B). Both exit 0, so both take the ExecOk arm where map_shell_outputs clones stderr into a Value::Str — the repair is correct for both, and 59,522,411 B remains the witness's legitimate worst-observed STRESS SPECIMEN rather than the recurrence's fixture. INCIDENT NOT CLOSED: wedge was finite/self-recovered; wedged route unproven — and the two candidate routes are NOT rival cost centers, because serve_daily_page_response_for_instance and serve_workflow_response_for_instance both call belt_workflow_attempts_observe_for_instance (one observing authority, two projections), so they share the projection cost and differ only in that the daily page adds the render; interpreter-concat hypothesis live and may be primary; share of two-hour peg versus queued duplicate polls unmeasured, and the share attributable to stream capture is unestablished in BOTH directions (an arithmetic argument that 18.4 MB is too small to explain the peg assumed a fixed two copies, which the profile does not support — Value::clone/String::clone sat inside the repeating evaluator path, so the multiplier is per-iteration and unmeasured). FIXTURE PROVENANCE: the pointer proves which ATTEMPT was selected at onset, not that the retained file is byte-identical to what the wedged request read — that attempt was in flight (events mtime 18:35:37, i.e. during the 18:00:56-to-~19:52 wedge), so the file grew while the route was polled and was smaller at onset; the artifact is the retained final state of the attempt selected at wedge onset, never the exact historical request input. Witness: bounded_shell_stream_capture_replay. Dissolve-on: emit-on-demand native serve and shared CapturedProcessStream carrier subsume this seed-only drain."

fn serve_daily_page_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  let page = match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsObserved { attempts } =>
      roadmap_daily_workspace_page_for_authority_observed(attempts: attempts, attempts_refused: none)
    WorkflowAttemptsRefused { reason } =>
      roadmap_daily_workspace_page_for_authority_observed(attempts: [], attempts_refused: Present { value: reason })
  }
  serve_page_response(page: page)
}

fn serve_workflow_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  let observed = belt_workflow_attempts_observe_for_instance(
    instance: instance,
  )
  serve_text_response(
    status: belt_workflow_attempts_http_status(observed: observed),
    content_type: application_json_utf8,
    body: belt_workflow_attempts_observed_json_for_instance(
      instance: instance,
      observed: observed,
    ),
  )
}

fn serve_workflow_response() -> ServeHttpResponse {
  serve_workflow_response_for_instance(instance: srv1_live_dashboard_instance())
}

data serve_sessions_note: String = "GET /sessions.json performs one session-container observation and one independently adjudicated pane/process observation. Session-list refusal serves 503 because container presence is unknowable. Pane refusal stays in each known session as process unobserved and cleanup unavailable; it cannot erase session presence. The same combined observation feeds both status and body so the route never races two reads."

fn serve_sessions_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  let o = belt_sessions_observe_for_instance(instance: instance)
  serve_text_response(
    status: belt_sessions_http_status(o: o),
    content_type: application_json_utf8,
    body: belt_sessions_observed_json(o: o))
}

fn serve_sessions_response() -> ServeHttpResponse {
  serve_sessions_response_for_instance(instance: srv1_live_dashboard_instance())
}

fn http_method_label_join(methods: List<HttpMethod>) -> String {
  join(map(methods, m => match m {
    GET => "GET"
    POST => "POST"
    PUT => "PUT"
    PATCH => "PATCH"
    DELETE => "DELETE"
    HEAD => "HEAD"
    OPTIONS => "OPTIONS"
  }), ", ")
}

fn roadmap_serve_selection_response_for_instance(
  instance: HostDashboardInstance,
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  match sel {
    SelectedDynamic { handler: h, params: ps } =>
      roadmap_serve_invoke_for_instance(
        instance: instance,
        handler: h,
        params: ps,
        request: request,
        release_revision: release_revision,
      )
    SelectedStatic { route: r } =>
      ServeHttpResponse { status: r.status_on_hit, content_type: r.content_type, body: r.body }
    MethodNotAllowed { allowed: ms } =>
      serve_text_response(
        status: 405,
        content_type: text_plain_utf8,
        body: join(["method not allowed; allowed: ", http_method_label_join(methods: ms), "\n"], ""),
      )
    NoRouteMatched =>
      serve_text_response(status: 404, content_type: text_plain_utf8, body: "not found\n")
  }
}

fn roadmap_serve_selection_response(
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_selection_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    sel: sel,
    request: request,
    release_revision: release_revision,
  )
}

fn roadmap_serve_respond_for_instance(
  instance: HostDashboardInstance,
  method_label: String,
  path: String,
  body: String,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  match parse_http_method_label(label: method_label) {
    UnknownMethod { label: l } =>
      serve_text_response(
        status: 501,
        content_type: text_plain_utf8,
        body: join(["unrecognized method: ", l, "\n"], ""),
      )
    KnownMethod { method: m } =>
      match roadmap_serve_route_table_build() {
        RoadmapServeTableRefused { raw: r, segment: s, reason: why } =>
          serve_text_response(
            status: 500,
            content_type: text_plain_utf8,
            body: join([
              "route table refused: malformed route literal raw=", r,
              " segment=", s,
              " reason=", why,
              " (fail-closed — fix the literal in gunbc.roadmap_serve.roadmap_serve_route_specs)\n",
            ], ""),
          )
        RoadmapServeTable { table: t } =>
          roadmap_serve_selection_response_for_instance(
            instance: instance,
            sel: serve_select_route(table: t, method: m, path: path),
            request: ServeHttpRequest { method: m, path: path, body: body },
            release_revision: release_revision,
          )
      }
  }
}

fn roadmap_serve_respond(
  method_label: String,
  path: String,
  body: String,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_respond_for_instance(
    instance: srv1_live_dashboard_instance(),
    method_label: method_label,
    path: path,
    body: body,
    release_revision: release_revision,
  )
}

fn roadmap_serve_handle(
  method: String,
  path: String,
  body: String,
  release_revision: CommitSha,
) -> ServeWireResponse {
  serve_wire_response(r: roadmap_serve_respond_for_instance(
    instance: srv1_live_dashboard_instance(),
    method_label: method,
    path: path,
    body: body,
    release_revision: release_revision,
  ))
}


