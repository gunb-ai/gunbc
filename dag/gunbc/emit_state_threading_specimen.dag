module gunbc.emit_state_threading_specimen

import std.types { Bool, Int, List, Map }
import std.optional { Optional, Present, Absent }

// EMISSION-MINIMUM-COST building block: observation and state threading (roadmap node
// emission-building-block-realization, first slice). Shape taken from the parse-population profile:
// a cursor over one retained source advanced by a scalar index, and a wide record accumulator
// rebuilt each step with two fields changed and the rest carried unchanged.
// STANDING: the emitted step meets the declared reference operation count (re-derived on every run of
// `gunbc test //gunbc/instruments:native-allocation-observation`, which prints the counts beside the
// reference). The ownership fact is field-granular last use of a dying owned record
// (src/v1/ownership.dag): a fn parameter read only through projections and consumed by a terminal
// literal of its own type (analyze_dying_base_sites), and a fold accumulator moved at the end of each
// branch (fold_body_branch_ends_move_acc). The emit tries Rc::get_mut on the dying box and takes the
// allocating arm when it is shared, so the representation stays Rc and no container slot widens
// (recurring_failure_mode by_value_record_widens_container_slots).
type SpecCursor {
  source: List<Int>
  index: Int
}

type SpecAcc {
  remaining: SpecCursor
  tokens: List<Int>
  pos: Int
  done: Bool
  context: Map<String, Int>
  tag: Int
}

fn spec_head(c: SpecCursor) -> Int {
  match get(xs: c.source, index: c.index) {
    Present { value: v } => v
    Absent => 0 - 1
  }
}

fn spec_step(acc: SpecAcc) -> SpecAcc {
  let h = spec_head(c: acc.remaining)
  if h < 0 {
    SpecAcc { remaining: acc.remaining, tokens: acc.tokens, pos: acc.pos, done: true, context: acc.context, tag: acc.tag }
  } else {
    SpecAcc {
      remaining: SpecCursor { source: acc.remaining.source, index: acc.remaining.index + 1 },
      tokens: list_push(acc.tokens, h),
      pos: acc.pos + 1,
      done: false,
      context: acc.context,
      tag: acc.tag
    }
  }
}

fn spec_build(n: Int) -> List<Int> {
  if n == 0 { [] } else { list_push(spec_build(n: n - 1), n) }
}

// The specimen walk returning the token SEQUENCE it built, so a measuring caller keeps the result
// (an unused result is allocation the release compiler may elide) and checks the walk, not a count.
fn spec_walk_tokens(src: List<Int>) -> List<Int> {
  let r = src |> fold(init: spec_init(src: src), f: (acc, e) => if acc.done { acc } else { spec_step(acc: acc) })
  r.tokens
}

fn spec_init(src: List<Int>) -> SpecAcc {
  SpecAcc { remaining: SpecCursor { source: src, index: 0 }, tokens: [], pos: 0, done: false, context: empty_map(), tag: 7 }
}
