module gunbc.managed_directory


data managed_directory_note: String = "A host directory the fleet owns, carried as WHO NEEDS WHAT rather than as a mode. The mode is DERIVED (managed_directory_permissions below), which is the whole point: gunbc.live_deploy.emit's install_d_owned_command hard-codes 0755 for every owned directory, so /opt/gunbc/attempt-state converged world-readable while the per-attempt directories beneath it are 0700 — the leaf could state its requirement and the root could not. Replacing that constant with a tighter constant would have moved the same undeclared number; a member whose dependents genuinely need traversal would then break with no statement of why. So a member declares its dependents and the permission is computed from them (operator direction 2026-07-30: precise, and derived from the needs/dependents).\\n\\nNOTHING HERE IS NEW VOCABULARY, deliberately. The verbs are std.effect_grant.Verb — the same Read/Write/Execute the deploy-preflight already admits against, read here to CONSTRUCT a permission instead of to authorize an action, which is the same relation emit and ingest have to one grammar. The permission carrier is extdeps.access.posix.FilePermissions, cited to Open Group sys/stat.h, which until now was defined, self-tested, and consumed by nothing — it is named on the inert-carrier roster (v2.lens.inert_carrier) for exactly that reason, and this module is the live consumer that takes it off, the same way RbacPolicy came off when extdeps/bmc/access.dag started using it. Principals are PosixUser rows from the closed gunbc.fleet_posix_accounts roster. Lifecycle is gunbc.ownership.Ownership. The only thing this module adds is the JOIN.\\n\\nCLASS ASSIGNMENT IS DERIVED, NOT DECLARED, which is what stops the dependent list from being the answer written twice: a dependent lands in the owner, group, or other class by comparing its uid and gid against the owner's, so a row cannot claim 'group' for a principal that shares no gid. Declaring the class directly would let the mode be whatever the author wanted while still looking computed.\\n\\nSCOPE (a counted frontier, not a sweep): only the attempt-state root consumes this today. The other owned directories keep the shared constant until each one's dependents are established by evidence rather than by assumption — /opt/gunbc/gunbc is written by the tree-sync unit AS the service user and read by the serve process, and getting that wrong tightens a live host out of service on the next deploy. A blanket re-derivation is a host-behaviour change disguised as a refactor. dissolve-on = every member in gunbc.live_deploy.spec deployment_owned_steps carries a ManagedDirectory, at which point install_d_owned_command loses its mode argument entirely and this frontier note is deleted."

type DirectoryDependent {
  who: extdeps.access.posix.PosixUser
  needs: List<std.effect_grant.Verb>
}

type ManagedDirectory {
  member: std.types.NonEmptyStr
  path: std.types.FilePath
  owner: extdeps.access.posix.PosixUser
  dependents: List<DirectoryDependent>
  ownership: gunbc.ownership.Ownership
}

type DependentClass = OwnerClass | GroupClass | OtherClass

fn dependent_class_eq(a: DependentClass, b: DependentClass) -> Bool {
  match a {
    OwnerClass => match b { OwnerClass => true, GroupClass => false, OtherClass => false }
    GroupClass => match b { GroupClass => true, OwnerClass => false, OtherClass => false }
    OtherClass => match b { OtherClass => true, OwnerClass => false, GroupClass => false }
  }
}

fn dependent_class_of(owner: extdeps.access.posix.PosixUser, who: extdeps.access.posix.PosixUser) -> DependentClass {
  if who.uid == owner.uid {
    OwnerClass
  } else if who.gid == owner.gid {
    GroupClass
  } else {
    OtherClass
  }
}

fn needs_verb(needs: List<std.effect_grant.Verb>, v: std.effect_grant.Verb) -> Bool {
  fold(needs, init: false, f: (acc, n) => acc || std.effect_grant.verb_eq(a: n, b: v))
}

fn class_needs(
  owner: extdeps.access.posix.PosixUser,
  dependents: List<DirectoryDependent>,
  cls: DependentClass,
) -> List<std.effect_grant.Verb> {
  flat_map(
    filter(
      xs: dependents,
      predicate: d => dependent_class_eq(
        a: dependent_class_of(owner: owner, who: d.who),
        b: cls,
      ),
    ),
    d => d.needs,
  )
}

fn class_bits(
  owner: extdeps.access.posix.PosixUser,
  dependents: List<DirectoryDependent>,
  cls: DependentClass,
) -> extdeps.access.posix.PermissionBits {
  let needs = class_needs(owner: owner, dependents: dependents, cls: cls)
  extdeps.access.posix.PermissionBits {
    read: needs_verb(needs: needs, v: std.effect_grant.Read),
    write: needs_verb(needs: needs, v: std.effect_grant.Write),
    execute: needs_verb(needs: needs, v: std.effect_grant.Execute),
  }
}

fn managed_directory_permissions(d: ManagedDirectory) -> extdeps.access.posix.FilePermissions {
  extdeps.access.posix.FilePermissions {
    ownership: extdeps.access.posix.FileOwnership { uid: d.owner.uid, gid: d.owner.gid },
    mode: extdeps.access.posix.FileMode {
      owner: class_bits(owner: d.owner, dependents: d.dependents, cls: OwnerClass),
      group: class_bits(owner: d.owner, dependents: d.dependents, cls: GroupClass),
      other: class_bits(owner: d.owner, dependents: d.dependents, cls: OtherClass),
      setuid: false,
      setgid: false,
      sticky: false,
    },
  }
}

fn managed_directory_mode_octal(d: ManagedDirectory) -> String {
  extdeps.access.posix.file_mode_octal(mode: managed_directory_permissions(d: d).mode)
}

data srv1_attempt_state_dependents_note: String = "The attempt-state root's dependents are the whole evidence base for its mode, so they are stated with their reasons rather than assumed. The service user needs all three verbs: WRITE because belt_attempt_state_initialize_for_instance writes attempt-key, the admission receipt, and the initial provider-events file; EXECUTE because creating and traversing the per-attempt subdirectory requires the directory search bit (which is why belt_footprint_root_verdict probes search separately from write); READ because belt_workflow_progress_for_attempt_ref reads back <node>-current/attempt-key on every dashboard poll. NOBODY ELSE APPEARS, and that absence is the claim being made: the CI-runner principal never touches this tree (the deploy creates the directory through sudo and hands it to the service user), and no other account on srv1 has a reason to read attempt evidence. Deriving from exactly that list gives 0700 — a tightening from the inherited 0755, and the tightening is the consequence rather than the goal. If a future consumer genuinely needs to read attempt evidence (a metrics reader, a second service account), it is added HERE as a dependent with the verbs it needs, and the mode widens by derivation with the reason recorded — never by editing a number."

fn srv1_dashboard_service_principal() -> extdeps.access.posix.PosixUser {
  gunbc.fleet_posix_accounts.fleet_posix_operator_user
}

data attempt_state_directory_is_placed_note: String = "THE DIRECTORY'S REQUIREMENTS ARE THE SAME EVERYWHERE; ITS LOCATION IS NOT. This arrived as a nullary srv1 singleton — the same nullary shape #7456 removed from deployment_owned_steps — and merging the two lanes made the mismatch live: the owned MEMBER path became instance-derived while the apply command still built its directory at srv1's literal, so a twin deployment's apply would have created and chmodded PRODUCTION's attempt-state root. That is review 45197's defect on a new member: an instance-derived path beside a hardcoded one that used to agree because only one instance existed.\\n\\nOwner and dependents genuinely do not vary — every instance's attempt state is written and read by that instance's own service user, so the derivation of the mode is unchanged and this is not a loosening. Only the placement moves to a parameter, which is the axis #7456 established as the one that varies.\\n\\nsrv1_attempt_state_directory survives as the production placement of the general row rather than as a second definition, so its single consumer keeps working and there is still exactly one statement of what the directory requires."

fn attempt_state_directory_at(path: std.types.FilePath) -> ManagedDirectory {
  let service = srv1_dashboard_service_principal()
  ManagedDirectory {
    member: "attempt-state-root" as std.types.NonEmptyStr,
    path: path,
    owner: service,
    dependents: [
      DirectoryDependent { who: service, needs: [std.effect_grant.Read, std.effect_grant.Write, std.effect_grant.Execute] },
    ],
    ownership: gunbc.ownership.Owned,
  }
}

fn srv1_attempt_state_directory() -> ManagedDirectory {
  attempt_state_directory_at(path: gunbc.host_layout.srv1_dispatch_attempt_state_root)
}
