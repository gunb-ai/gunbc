module gunbc.http_ingress_host_seed_growth

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// FORWARD-FREEZE RECEIPT FOR THE SEED'S INGRESS REALIZATION (gunbc.plans.converged_ingress (deleted 2026-11-08) M1).
//
// THE SERVE VERB IS DELETED AND THIS IS WHAT REPLACES IT. `gunbc serve` (cli_run handle_serve and
// its helpers) held its own framing, limits, release check, liveness document, argument plan,
// response-shape check and response bytes in hand Rust; those decisions are now folds in
// gunbc.http_ingress and gunbc.native_serve, and `gunbc run` realizes an HttpIngressBinding an entry
// answers. The four rows that rostered the deleted seam -- gunbc.serve_declared_binding_seed_growth,
// gunbc.serve_cookie_header_seed_growth, gunbc.fabric_door_socket_seed_growth and
// gunbc.serve_liveness_seed_growth -- are deleted with it. The last one retires on its own trigger:
// the pre-evaluation route table is now a compiled value the graph produces at startup
// (gunbc.http_ingress http_ingress_pre_evaluation_routes), so /livez is answered without entering the
// evaluator from a modeled description of the route rather than from a hand-written document.
//
// PURPOSE ADMISSION (gunbc.v1.v1_maintenance_standing v1_seed_standing): this removes a seed verb and
// its Rust policy surface and moves the binding into the deployment model; the seed keeps only the
// socket operations no fold can perform. NET: the deleted seam was larger than this module, and that
// is stated, not netted -- every declaration below is enumerated on its own.
data http_ingress_host_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "IngressAnswer", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "ingress_answer", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "fold", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "fold_int", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "fold_text", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "str_list", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "IngressConnection", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "IngressListener", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "bind_listener", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "bind_tcp", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "bind_unix", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "lock_socket_path", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "peer_uid", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "peer_user", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "read_line", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "PreEvaluationRoute", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "Limits", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "handler_args", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "RequestFailure", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "eval", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "HeadRead", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "read_head", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "evaluate_request", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "render_response_in", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "read_refused_bytes", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "budget_refused_bytes", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.http_ingress_host", decl_name: "render_response", field: WholeDeclaration },
