module gunbc.guarantee_stall

import std.types { String, List, Bool, Int }
import v2.std.algebra { fold_list }
import gunbc.guarantee_rung { GuaranteeRung, guarantee_rung_label, guarantee_rung_index }
import gunbc.lifecycle_bounded_referent {
  DashboardWorkItemReferent,
  dashboard_node_uri_scheme,
  dashboard_work_item_referent_uri,
  text_spells_a_dashboard_node_uri,
}

// THE CARRIER FOR A DESIGN section 4b(2) STALL, and it is a different fact from a section 4b(3)
// DROP (gunbc.rung_drop) rather than a variant of it. A DROP is an event: something that held a
// rung stopped holding it, and the fields record what was lost. A STALL is a standing state: a class sits
// below its attainable ceiling and has not moved, and section 4b(2) obliges it to say WHY it has
// not -- separating "cannot climb further" from "can climb after one grounding" from "can climb
// now but unbuilt", because only the first is permanent. Nothing was lost when a stall begins, so
// a drop's previous/temporary/reason fields have no answer, and forcing one would fabricate an
// event that did not happen.
//
// WHY THIS EXISTS AT ALL, measured before it was written. The obligation is real and universally
// observed in PROSE: a corpus sweep found 133 sites across 95 modules naming a next-rung or
// restoration trigger, of which 79 sit inside `//` annotations and 54 inside String bodies. Not
// one of them is reachable by a fold. The annotation half is out of reach of any PROGRAM CLAIM --
// DESIGN section 4c is explicit that an annotation is never evidence a machine claim holds, because
// no Accepted program reads one -- and the String half has no identity to key on, so a count over
// it counts phrase occurrences rather than classes. Stated precisely rather than as a blanket
// impossibility, because the overclaim would be checkable and wrong: annotations ARE captured, into
// std.source_annotation SourceAnnotationGraph, so an annotation lens could in principle scan their
// text. That does not rescue the population. Such a lens matches the literal phrase "NEXT-RUNG
// TRIGGER", which is the grep DESIGN section 6 says a lens replaces; it cannot tell a class from a
// mention of one; and every row it read would be modeling debt by that carrier's own standing law.
// The only route to a countable population is authoring the fact as data from here forward.
//
// THE ONE MECHANISM THAT TOUCHES THE CLASS TODAY confirms that reading from the other direction:
// test.claim.stage0_rust_source_lifecycle_scaffold_witness_test asserts string_contains over
// gunbc.stage0_rust_source_lifecycle_scaffold unclassified_axis_rung_note for the literal phrase
// "NEXT-RUNG TRIGGER". It is a real, executing check, and what it can establish is that one prose
// row still contains a phrase -- not that the class it belongs to named a trigger, and not that
// any other class did.
//
// WHAT THIS CARRIER ACTUALLY GUARANTEES, at its honest rung and no higher. next_rung_trigger is a
// REQUIRED field, so a stall declared through this type WITHOUT a trigger has no spelling -- for
// rows that use it, section 4b(2) is structurally impossible to violate rather than checked. It
// makes nothing unwritable about prose: a class stalling in an annotation stays exactly as
// writable as it was, and nothing detects one. That is a scope statement, not a climb, and stating
// it here is what keeps a reader from counting this module as coverage it does not provide.
//
// THE SAME SCOPE STATEMENT APPLIES TO THE TRIGGER'S SECOND WALL BELOW, and it is narrower still.
// `stall_trigger_admission` refuses a capability that spells the declared dashboard-node URI
// scheme, which is decidable because that scheme has one owner; it says nothing about a trigger
// that names a lane in words, and nothing about whether an obligation kept an accountable owner
// after that lane ended. Those are the free-prose form and the responsibility-survival trigger of
// `gunbc.recurring_failure_mode.stale_claim_survives_its_own_correct_edit`, and neither is climbed
// here.
//
// THIS MODULE CARRIES THE SHAPE AND THE FOLDS; THE ROWS ARE ONE MODULE EACH under
// gunbc.guarantee_stall.<row>, and gunbc.guarantee_stall.roster is the enumeration. The split is
// the one gunbc#10206 made for gunbc.recurring_failure_mode and it is made here for the same
// measured reason: every row PR appended at the same two points -- the declaration tail and the
// roster tail -- so row lanes conflicted with each other BY CONSTRUCTION, and no amount of timing
// changes that. Appending a stall now writes a new file and one roster line. The direction is
// forced by acyclicity rather than chosen: a row module imports GuaranteeStall from here, so the
// enumeration cannot live here.

// THE THREE-WAY DISTINCTION section 4b(2) NAMES, modeled as a closed coproduct because that is
// what makes "only the first is permanent" a fold rather than a reading. AwaitsOneGrounding
// carries the authority it waits on: a stall that cannot name what it is waiting for is not
// waiting, it is unbuilt, and the two rank differently for work.
type ClimbBlocker
  = CannotClimbFurther { why: String }
  | AwaitsOneGrounding { grounding: String }
  | ClimbableButUnbuilt

// A POPULATION MAY BE HONESTLY UNCOUNTABLE, and that must be a state rather than an empty list.
// DESIGN itself carries rows whose exposure is unbounded and says so; rendering those as
// `population: []` would read as "nothing is affected", which is the empty-observation narrow the
// failure-mode list already names -- bottom-as-answer conflated with bottom-as-ignorance.
type StallPopulation
  = BoundedPopulation { members: List<String> }
  | UncountedNotEnumerable { reason: String }

// THE TRIGGER IS TWO FACTS AND WAS ONE FIELD, which is the whole of this carrier's exposure to
// `gunbc.recurring_failure_mode.stale_claim_survives_its_own_correct_edit`. `capability` is the
// OPERATIVE half -- the condition section 4b(2) obliges the row to name, and the only half a later
// reader can re-measure. `awaiting` is the PROVENANCE half: the lifecycle-bounded lanes that were
// asked to deliver it, carried as modeled referents so that a lane closing is a fact a consumer
// can join against rather than a word inside a sentence.
//
// SEPARATING THEM IS WHAT MAKES THE STALE READING UNAVAILABLE. While both halves shared one
// `String`, "node://adhoc-a3b0e05f-374 lands: the wall materializes the operation" reads as a
// trigger whose satisfaction condition is a NODE REACHING DONE -- and three such nodes reached
// done with their conditions unmet, which `gunbc.guarantee_stall.roster` records with its dated
// reading. A row split this way cannot be read that way: the capability stands alone, and the node
// is beside it as who was asked and never as evidence that the climb happened.
//
// WHAT THIS DOES NOT CLAIM. Carrying the referent does not decide whether responsibility for the
// obligation survived that lane's closure; that is the class row's own next trigger, whose subject
// is responsibility survival through a modeled closure transition, and it is a different subject
// from this one. This carrier decides only that the trigger's operative half is stated without
// resting on a lifecycle-bounded referent, and that any referent it does rest on is modeled.
type NextRungTrigger {
  capability: String
  awaiting: List<DashboardWorkItemReferent>
}

// TWO CONSTRUCTORS BECAUSE THE EMPTY LIST IS THE COMMON AND CORRECT CASE, and spelling `awaiting:
// []` at every row would make the exceptional case indistinguishable from the ordinary one at a
// glance. `climbs_when` is the row that waits on nobody; `climbs_when_awaiting` names the lanes.
fn climbs_when(capability: String) -> NextRungTrigger {
  NextRungTrigger { capability: capability, awaiting: [] }
}

fn climbs_when_awaiting(capability: String, awaiting: List<DashboardWorkItemReferent>) -> NextRungTrigger {
  NextRungTrigger { capability: capability, awaiting: awaiting }
}

type GuaranteeStall {
  subject: String
  current: GuaranteeRung
  ceiling: GuaranteeRung
  blocker: ClimbBlocker
  population: StallPopulation
  next_rung_trigger: NextRungTrigger
}
// A STALL WHOSE CURRENT RUNG EQUALS ITS CEILING IS NOT A STALL. The type cannot forbid writing one
// -- that would need a dependent pair over the two rungs -- so this is validation standing where
// construction is not available, declared as such rather than presented as a wall.
fn stall_is_below_ceiling(s: GuaranteeStall) -> Bool {
  guarantee_rung_index(r: s.current) < guarantee_rung_index(r: s.ceiling)
}

// NO `GuaranteeStall -> Bool` PERMANENCE ACCESSOR LIVES HERE, AND ITS ABSENCE IS THE POINT.
// `stall_is_permanent` stood here until gunbc#10106 and was a second, weaker spelling of the arm
// the row already carries: DESIGN section 5 prices a check that re-states a constraint the model
// carries as a second representation of it, and the practical cost is that every later caller
// reaches for the Bool instead of the variant it came from, so "why is this permanent" stops being
// answerable at the use site. Consumers match `ClimbBlocker` themselves -- exhaustively, which is
// what makes a new arm a compile error at every consumer rather than a silent `false`.

fn climb_blocker_label(b: ClimbBlocker) -> String {
  match b {
    CannotClimbFurther { why: w } => concat("cannot climb further: ", w)
    AwaitsOneGrounding { grounding: g } => concat("awaits one grounding: ", g)
    ClimbableButUnbuilt => "climbable now but unbuilt"
  }
}

fn stall_population_render(p: StallPopulation) -> String {
  match p {
    BoundedPopulation { members: ms } => join(ms, ", ")
    UncountedNotEnumerable { reason: r } => concat("UNCOUNTED, not enumerable: ", r)
  }
}

// THE AWAITED LANES ARE RENDERED FROM THE REFERENTS AND NEVER RE-SPELLED, so the report cannot
// disagree with the field: the URI comes from the referent's own module, which owns the scheme.
// They are rendered AFTER the capability and labelled as who was asked, so a reader is never
// handed a sentence in which a lane's ending looks like the condition.
fn next_rung_trigger_render(t: NextRungTrigger) -> String {
  fold_list(
    xs: t.awaiting,
    empty: t.capability,
    cons: fn(acc, r) { concat(acc, concat(" [asked: ", concat(dashboard_work_item_referent_uri(referent: r), "]"))) },
  )
}

// ONE RENDERING, for the reason gunbc.rung_drop's renderer already gives: a consumer that spelled
// its own message would be a second authority for the row's own fields and the two would drift.
fn stall_report_message(s: GuaranteeStall) -> String {
  concat(
    concat(s.subject, concat(": STALLED at ", guarantee_rung_label(r: s.current))),
    concat(
      concat(", ceiling ", concat(guarantee_rung_label(r: s.ceiling), concat(" (", climb_blocker_label(b: s.blocker)))),
      concat(
        concat("). Population: ", stall_population_render(p: s.population)),
        concat(". Climbs when: ", concat(next_rung_trigger_render(t: s.next_rung_trigger), "."))
      )
    )
  )
}

// A STALL AT ITS CEILING IS NOT A STALL: the row would describe a class that already arrived, and
// every consumer reading it as outstanding work reads a false claim.
fn every_stall_is_below_its_ceiling(ss: List<GuaranteeStall>) -> Bool {
  fold_list(
    xs: ss,
    empty: true,
    cons: fn(acc, s) { acc && stall_is_below_ceiling(s: s) },
  )
}

// THE SECOND WALL OVER THE SAME FIELD, AND IT IS A DIFFERENT SUBJECT FROM THE FIRST. 4b(2) asks
// whether a trigger was NAMED; this asks whether what was named is a capability rather than a
// lifecycle-bounded referent's ending. A row can satisfy the first and fail this one, which is the
// state every migrated row here was in.
type TriggerAdmission
  = TriggerAdmitted
  | TriggerCapabilityEmpty { subject: String }
  | TriggerCapabilitySpellsAReferent { subject: String, scheme: String }

fn stall_trigger_admission(s: GuaranteeStall) -> TriggerAdmission {
  if s.next_rung_trigger.capability == "" {
    TriggerCapabilityEmpty { subject: s.subject }
  } else {
    if text_spells_a_dashboard_node_uri(text: s.next_rung_trigger.capability) {
      TriggerCapabilitySpellsAReferent { subject: s.subject, scheme: dashboard_node_uri_scheme }
    } else {
      TriggerAdmitted
    }
  }
}

fn trigger_admission_label(a: TriggerAdmission) -> String {
  match a {
    TriggerAdmitted => "admitted"
    TriggerCapabilityEmpty { subject: subj } => concat("untracked stall, no trigger named: ", subj)
    TriggerCapabilitySpellsAReferent { subject: subj, scheme: sch } =>
      concat(
        concat("trigger rests on a lifecycle-bounded referent spelled into its capability (", sch),
        concat("): ", subj),
      )
  }
}

fn every_stall_trigger_is_admitted(ss: List<GuaranteeStall>) -> Bool {
  fold_list(
    xs: ss,
    empty: true,
    cons: fn(acc, s) {
      acc && match stall_trigger_admission(s: s) {
        TriggerAdmitted => true
        TriggerCapabilityEmpty { subject: _ } => false
        TriggerCapabilitySpellsAReferent { subject: _, scheme: _ } => false
      }
    },
  )
}

// SECTION 4b(2) IS WHAT THIS ENFORCES: a class below its ceiling must NAME its next-rung trigger,
// so "cannot climb further" stays separable from "unbuilt". An empty trigger is the untracked
// stall that clause forbids, and it becomes decidable here rather than left to review diligence.
fn every_stall_names_a_trigger(ss: List<GuaranteeStall>) -> Bool {
  fold_list(
    xs: ss,
    empty: true,
    cons: fn(acc, s) {
      acc && match stall_trigger_admission(s: s) {
        TriggerCapabilityEmpty { subject: _ } => false
        TriggerCapabilitySpellsAReferent { subject: _, scheme: _ } => true
        TriggerAdmitted => true
      }
    },
  )
}


// THE QUANTIFIER'S DOMAIN, EXPOSED SO IT CAN BE ASSERTED. Both folds above are universally
// quantified and therefore TRUE on an empty roster, so without this a roster that lost its rows
// would satisfy every check written over it. Counting is what makes emptiness a refusable state
// rather than a silent pass.
fn stall_roster_size(ss: List<GuaranteeStall>) -> Int {
  fold_list(
    xs: ss,
    empty: 0,
    cons: fn(acc, s) { acc + 1 },
  )
}
