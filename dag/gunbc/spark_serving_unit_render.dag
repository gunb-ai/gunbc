module gunbc.spark_serving_unit_render


// THE ONE PLACE A SPARK SERVING UNIT BECOMES BYTES.
//
// `SparkServingUserUnitSpec` is deliberately typed fields and NOT systemd INI syntax -- its own
// authority note says so. That left a gap rather than a decision: nothing could turn the spec into a
// file, so `WriteUserUnitFile` had no bytes to deliver and the unit member had nothing to be
// observed against. The missing piece was never gunbc's to invent, because spelling `[Service]` and
// `ExecStart=` here would have made this module a second systemd authority (§3). It belongs to
// `extdeps.systemd.unit_file`, which is cited to systemd.unit(5) and systemd.service(5); this module
// only maps gunbc's typed fields onto it.
//
// The mapping is total and takes no decisions of its own: every directive below is a spec field or a
// path derived from the install-paths authority. There is no arm that can omit a directive or supply
// a default, so a spec change cannot silently fail to reach the file.

fn spark_serving_exec_start_command(spec: gunbc.spark_serving_install_paths.SparkServingUserUnitSpec) -> std.types.NonEmptyStr {
  join([
    gunbc.spark_serving_install_paths.spark_serving_runtime_root() as String,
    "/bin/ollama ",
    spec.exec_subcommand as String,
  ], "") as std.types.NonEmptyStr
}

// The runtime and model roots come from the install-paths authority rather than from the spec's
// relative strings, so the unit and the installer cannot disagree about where the runtime lives.
fn spark_serving_user_unit_file(spec: gunbc.spark_serving_install_paths.SparkServingUserUnitSpec) -> extdeps.systemd.unit_file.SystemdUnitFile {
  extdeps.systemd.unit_file.ServiceUnitFile {
    unit: [
      extdeps.systemd.unit_file.Description { text: spec.description },
      extdeps.systemd.unit_file.After { target: spec.after },
    ],
    service: [
      extdeps.systemd.unit_file.ServiceType { mode: spec.service_type },
      extdeps.systemd.unit_file.Environment { assignment: extdeps.ollama.server_env.ollama_host_env_assignment(bind: spec.bind_host_port) },
      extdeps.systemd.unit_file.Environment {
        assignment: extdeps.ollama.server_env.ollama_models_env_assignment(root: gunbc.spark_serving_install_paths.spark_serving_models_root() as std.types.NonEmptyStr),
      },
      extdeps.systemd.unit_file.WorkingDirectory { path: gunbc.spark_serving_install_paths.spark_serving_runtime_root() as std.types.NonEmptyStr },
      extdeps.systemd.unit_file.ExecStart { command: spark_serving_exec_start_command(spec: spec) },
      extdeps.systemd.unit_file.Restart { policy: spec.restart },
    ],
    install: extdeps.systemd.unit_file.Installable { directives: [extdeps.systemd.unit_file.WantedBy { target: spec.wanted_by }] },
  }
}

// THE DELIVERED BYTES, and the value an observed unit file is compared against. One function, so the
// write side and the observe side cannot drift into two renderings of one spec -- which would make
// every host report a permanent MemberChanged against itself.
fn spark_serving_user_unit_text(spec: gunbc.spark_serving_install_paths.SparkServingUserUnitSpec) -> String {
  extdeps.systemd.unit_file.serialize_systemd_unit_file(file: spark_serving_user_unit_file(spec: spec))
}

fn spark_serving_desired_user_unit_text() -> String {
  spark_serving_user_unit_text(
    spec: gunbc.spark_serving_install_paths.spark_serving_user_unit_spec(
      bind_host_port: gunbc.spark_serving_desired.spark_serving_desired_bind_host_port() as std.types.NonEmptyStr,
    ),
  )
}
