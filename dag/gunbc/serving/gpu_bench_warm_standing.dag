module gunbc.serving.gpu_bench_warm_standing

import std.types { String, NonEmptyStr, Bool, List }
import std.optional { Present, Absent }
import std.nat { Nat }
import std.measure { TokenCount, token_count, token_count_value }
import extdeps.gpu_bench.request_v2 {
  GpuBenchRequestV2, GpuBenchPhase, GpuBenchPhasePrime, GpuBenchPhaseWarm, GpuBenchPhaseShort,
  GpuBenchRequestStatus, GpuBenchRequestOk, GpuBenchRequestError,
}
import extdeps.gpu_bench.kit_log {
  gpu_bench_capacity_ok_tokens,
  CapacityOkRead, CapacityOkAbsent, CapacityOkMalformed,
}
import extdeps.external_authority { TranscribedUncited, CitedToAuthority }
import extdeps.ninfer.replayed_tokens_total {
  ninfer_replayed_tokens_total, ninfer_replayed_tokens_total_standing,
  NinferReplayedTokensRead, NinferReplayedTokensAbsent, NinferReplayedTokensMalformed,
}

// WARM-PERFORMANCE ELIGIBILITY FROM A GPU-BENCH V2 RECEIPT, not a rate. A tokens-per-second field
// beside a working set the measured KV pool cannot hold is not engine evidence
// (gunbc.recurring_failure_mode.benchmark_warm_capacity_violation_read_as_engine_performance).
// CONSUMER: P4 home-serving Pareto; only WarmValid is a funded axis. Measured KV is a supplied
// reading of the launch (CAPACITY_OK from the kit log), never an estimated footprint.

type GpuBenchWarmStanding
  = WarmValid { working_set_tokens: TokenCount, measured_kv_tokens: TokenCount }
  | WarmOverCapacity { working_set_tokens: TokenCount, measured_kv_tokens: TokenCount }
  | WarmRejected { cause: NonEmptyStr }
  | WarmCapacityUnread { cause: NonEmptyStr }

fn gpu_bench_any_prime_prompt_unread(records: List<GpuBenchRequestV2>) -> Bool {
  any(records, r => match r.phase {
    GpuBenchPhasePrime => match r.prompt_tokens {
      Absent => true
      Present { value: _ } => false
    }
    GpuBenchPhaseWarm => false
    GpuBenchPhaseShort => false
  })
}

fn gpu_bench_prime_working_set_tokens(records: List<GpuBenchRequestV2>) -> Nat {
  fold(records, init: 0, f: fn(acc, r) {
    match r.phase {
      GpuBenchPhasePrime => match r.prompt_tokens {
        Absent => acc
        Present { value: t } => acc + token_count_value(t: t)
      }
      GpuBenchPhaseWarm => acc
      GpuBenchPhaseShort => acc
    }
  })
}

fn gpu_bench_prime_count(records: List<GpuBenchRequestV2>) -> Nat {
  fold(records, init: 0, f: fn(acc, r) {
    match r.phase {
      GpuBenchPhasePrime => acc + 1
      GpuBenchPhaseWarm => acc
      GpuBenchPhaseShort => acc
    }
  })
}

fn gpu_bench_any_prime_or_warm_failed(records: List<GpuBenchRequestV2>) -> Bool {
  any(records, r => match r.status {
    GpuBenchRequestOk => false
    GpuBenchRequestError { detail: _ } => match r.phase {
      GpuBenchPhasePrime => true
      GpuBenchPhaseWarm => true
      GpuBenchPhaseShort => false
    }
  })
}

fn gpu_bench_warm_standing(records: List<GpuBenchRequestV2>, measured_kv: TokenCount?) -> GpuBenchWarmStanding {
  if gpu_bench_prime_count(records: records) == 0 {
    WarmRejected { cause: "no prime-phase request in the receipt" as NonEmptyStr }
  } else {
    if gpu_bench_any_prime_or_warm_failed(records: records) {
      WarmRejected { cause: "a prime or warm request did not complete" as NonEmptyStr }
    } else {
      if gpu_bench_any_prime_prompt_unread(records: records) {
        WarmRejected { cause: "a prime-phase request carries no prompt_tokens" as NonEmptyStr }
      } else {
      let working = token_count(count: gpu_bench_prime_working_set_tokens(records: records))
      match measured_kv {
        Absent => WarmCapacityUnread { cause: "measured KV capacity was not supplied" as NonEmptyStr }
        Present { value: kv } =>
          if token_count_value(t: working) > token_count_value(t: kv) {
            WarmOverCapacity { working_set_tokens: working, measured_kv_tokens: kv }
          } else {
            WarmValid { working_set_tokens: working, measured_kv_tokens: kv }
          }
      }
      }
    }
  }
}

fn gpu_bench_warm_standing_from_kit_log(records: List<GpuBenchRequestV2>, log: String) -> GpuBenchWarmStanding {
  match ninfer_replayed_tokens_total(log: log) {
    NinferReplayedTokensMalformed { cause: c } => WarmRejected { cause: c }
    NinferReplayedTokensAbsent => gpu_bench_warm_standing_from_capacity_ok(records: records, log: log)
    NinferReplayedTokensRead { tokens: _ } => gpu_bench_warm_standing_from_capacity_ok(records: records, log: log)
  }
}

fn gpu_bench_warm_standing_from_capacity_ok(records: List<GpuBenchRequestV2>, log: String) -> GpuBenchWarmStanding {
  match gpu_bench_capacity_ok_tokens(log: log) {
    CapacityOkMalformed { cause: c } => WarmRejected { cause: c }
    CapacityOkAbsent => gpu_bench_warm_standing(records: records, measured_kv: Absent)
    CapacityOkRead { tokens: kv } => gpu_bench_warm_standing(records: records, measured_kv: Present { value: kv })
  }
}

fn gpu_bench_warm_standing_from_cited_ninfer_replay(records: List<GpuBenchRequestV2>, log: String) -> GpuBenchWarmStanding {
  match gpu_bench_warm_standing_from_kit_log(records: records, log: log) {
    WarmRejected { cause: c } => WarmRejected { cause: c }
    WarmOverCapacity { working_set_tokens: w, measured_kv_tokens: k } =>
      WarmOverCapacity { working_set_tokens: w, measured_kv_tokens: k }
    WarmCapacityUnread { cause: c } => WarmCapacityUnread { cause: c }
    WarmValid { working_set_tokens: w, measured_kv_tokens: k } =>
      match ninfer_replayed_tokens_total(log: log) {
        NinferReplayedTokensMalformed { cause: c } => WarmRejected { cause: c }
        NinferReplayedTokensAbsent => WarmCapacityUnread { cause: "ninfer_replayed_tokens_total was not observed" as NonEmptyStr }
        NinferReplayedTokensRead { tokens: replayed } =>
          if token_count_value(t: replayed) > 0 {
            WarmRejected { cause: "ninfer replayed tokens; prefix restore was not a snapshot hit" as NonEmptyStr }
          } else {
            WarmValid { working_set_tokens: w, measured_kv_tokens: k }
          }
      }
  }
}

fn gpu_bench_warm_standing_with_ninfer_log(records: List<GpuBenchRequestV2>, log: String) -> GpuBenchWarmStanding {
  match gpu_bench_warm_standing_from_kit_log(records: records, log: log) {
    WarmRejected { cause: c } => WarmRejected { cause: c }
    WarmOverCapacity { working_set_tokens: w, measured_kv_tokens: k } =>
      WarmOverCapacity { working_set_tokens: w, measured_kv_tokens: k }
    WarmCapacityUnread { cause: c } => WarmCapacityUnread { cause: c }
    WarmValid { working_set_tokens: w, measured_kv_tokens: k } =>
      match ninfer_replayed_tokens_total_standing {
        TranscribedUncited { read_obligation: o } =>
          match ninfer_replayed_tokens_total(log: log) {
            NinferReplayedTokensMalformed { cause: c } => WarmRejected { cause: c }
            NinferReplayedTokensAbsent => WarmCapacityUnread {
              cause: join(["ninfer_replayed_tokens_total was not observed; ", o as String], "") as NonEmptyStr
            }
            NinferReplayedTokensRead { tokens: _ } => WarmCapacityUnread { cause: o }
          }
        CitedToAuthority { authority: _ } =>
          gpu_bench_warm_standing_from_cited_ninfer_replay(records: records, log: log)
      }
  }
}
