module gunbc.serving.router_proxy_scaffold

import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// DECLARED SCAFFOLD. extdeps.proxy.openresty renders its closed typed directive sum directly to nginx
// and Lua text instead of through extdeps/languages grammar rows. Authority: dashboard escalation
// msg_090b06a7 (calm-crab-645, plan gunbc.plans.fabric_serving_router, S1), approved by default after no
// operator answer in 15 minutes (2026-10-24). Basis: the Envoy candidate failed the stream-end falsifier
// (its only stream-end sinks are gRPC), and the proxy itself is scheduled to dissolve.
data router_proxy_direct_render_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.proxy.openresty",
    decl_name: "render_nginx_directives",
    field: WholeDeclaration
  }
}

data router_proxy_direct_render_dissolution: DissolutionCondition = unbound_dissolution(description: "DISSOLVES WHEN a v2-native streaming door carries the router's bytes itself (plan gunbc.plans.fabric_serving_router section 3, named later realization); extdeps.proxy.openresty, gunbc.serving.router_proxy_config and this row are then deleted together.")
