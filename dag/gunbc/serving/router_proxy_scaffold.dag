module gunbc.serving.router_proxy_scaffold

import std.dissolution { DissolutionCondition, bound_dissolution }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }

// DECLARED SCAFFOLD. extdeps.proxy.openresty renders its closed typed directive sum directly to nginx
// and Lua text instead of through extdeps/languages grammar rows. Authority (DESIGN section 5: operator
// approval outside the diff): the operator's ruling of 2026-10-24, in their own words, "its fine to hand
// write something as long as the debt is tracked", recorded on gunbc#14938 by calm-crab-645. This row is
// that tracked debt. Basis: Envoy's documented stream-end sinks (access-log ALS, ext_proc) are gRPC, which the
// HTTP native door does not serve (an uncommitted local run agreed; no committed instrument exists yet,
// so the choice rests on that documented fact), and the proxy itself is scheduled to dissolve.
data router_proxy_direct_render_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.proxy.openresty",
    decl_name: "render_nginx_directives",
    field: WholeDeclaration
  }
}

// The Lua text and the raw HTTP request are concatenated strings in router_callout_lines, a second
// hand-rendered declaration; it is the same scaffold and dissolves with the first.
data router_proxy_lua_hook_render_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.serving.router_proxy_config",
    decl_name: "router_callout_lines",
    field: WholeDeclaration
  }
}

// The trigger is bound, so it fires by a declaration and not by reading prose: the nginx-conf grammar's
// rows under extdeps/languages (Lua rides that grammar's phase-block production). The other exit, a
// v2-native streaming door carrying the bytes itself (plan gunbc.plans.fabric_serving_router section 3),
// retires the proxy wholesale and so deletes this row with extdeps.proxy.openresty and
// gunbc.serving.router_proxy_config; it needs no trigger of its own here.
data router_proxy_direct_render_dissolution: DissolutionCondition = bound_dissolution(ref: decl_ref(module_path: "extdeps.languages.nginx_conf", decl_name: "nginx_conf_grammar"))

// The Lua hook's own trigger: a Lua chunk grammar under extdeps/languages, from which the callout lines
// are emitted as statements rather than concatenated (the nginx grammar alone would not cover them).
data router_proxy_lua_render_dissolution: DissolutionCondition = bound_dissolution(ref: decl_ref(module_path: "extdeps.languages.lua.grammar", decl_name: "lua_chunk_grammar"))

// THE TWO HAND-RENDERED DECLARATIONS AS FRONTIER ROWS, enrolled in gunbc.census_closure_frontier, so the
// grammar trigger is evaluated (pending until the nginx-conf grammar rows exist) rather than only stated.
data router_proxy_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.proxy.openresty", decl_name: "render_nginx_directives"),
    reason: "nginx configuration text concatenated from the typed directive sum instead of emitted by grammar rows.",
    dissolution: router_proxy_direct_render_dissolution
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.router_proxy_config", decl_name: "router_callout_lines"),
    reason: "Lua callout lines and the raw HTTP/1.1 stream-end request concatenated as text.",
    dissolution: router_proxy_lua_render_dissolution
  ),
]
