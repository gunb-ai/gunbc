module gunbc.serving.rented_serve_launch

import std.types { String, NonEmptyStr, Bool, List }
import std.algebra { list_append }
import std.decl_ref { decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import std.content_hash { Sha256Digest }
import extdeps.exec.command { ArgvCommand, shell_command_render }
import gunbc.serving.rented_startup_placement { RentedStoreRoots, RentedLinkReading, RentedLinkSwitchNoop, RentedLinkSwitchCommands, rented_link_switch }
import extdeps.tools.util_linux_setsid { setsid_fork_words }
import extdeps.ninfer.ninfer_serve { NinferServeLaunch, NinferModelsList, NinferModelsAdvertised, NinferModelsUnreadable }

// THE SERVE-LAUNCH LEG IS CONVERGENCE, NOT A SCRIPT (DESIGN 3d). Before it acts it takes an independent
// readback from the lab of the port the engine listens on: whether anything answers health, and which model
// ids it serves. The decision is a caller-supplied requirement (the launch's model id) judged over that
// readback and nothing else: an engine already serving the pinned model is a Noop, only an observed absence
// starts one, and a mismatch or an unreadable answer refuses typed. There is never a blind second launch.
type RentedServeReading
  = RentedServeNotListening
  | RentedServeAnswering { healthy: Bool, models: NinferModelsList }
  | RentedServeUnreadable { cause: NonEmptyStr }

type RentedServeDecision
  = RentedServeNoop
  | RentedServeStart
  | RentedServeRefused { cause: String }

fn rented_serves_model(models: NinferModelsList, model_id: NonEmptyStr) -> Bool {
  match models {
    NinferModelsAdvertised { ids: ids } => any(xs: ids, predicate: fn(i) { i == (model_id as String) })
    NinferModelsUnreadable { cause: _ } => false
  }
}

fn rented_serve_decision(launch: NinferServeLaunch, reading: RentedServeReading) -> RentedServeDecision {
  match reading {
    RentedServeNotListening => RentedServeStart
    RentedServeUnreadable { cause: c } => RentedServeRefused { cause: join(["serve readback unreadable: ", c as String], "") }
    RentedServeAnswering { healthy: h, models: m } =>
      if h && rented_serves_model(models: m, model_id: launch.model_id) {
        RentedServeNoop
      } else {
        RentedServeRefused { cause: "something answers on the port but is unhealthy or does not serve the pinned model id; refusing a second launch" }
      }
  }
}

// THE SERVE API KEY IS A GRANT BOUND TO THE ALLOCATION, never a literal, and no such binding exists yet:
// gunbc.serving.rented_host_grant is the ssh-access authorization and not this key. So the only arm is the
// unbound one, and a launch that would need the key refuses on it. The detach mechanism is likewise a host
// fact nobody has read (whether the card's PID 1 is systemd), so it is a typed refusal and not an assumption.
type RentedServeKeyBinding
  = RentedServeKeyUnbound { grant_name: NonEmptyStr }

// THE DETACH IS setsid, AND ITS OUTPUT ROUTE IS NOT MODELED. The card's PID 1 is bash and its systemd manager
// reports offline, so systemd_run (extdeps.systemd.systemd_run) cannot start a transient unit there; that is a
// host fact of this card, which is why that tool is not used for this launch. setsid detaches the engine, but
// a detached engine whose stdout is still the ssh channel holds the session open or dies on SIGPIPE, and the
// repository models no route that sets a child's stdout to a file (FleetSsh runs portable argv with no shell,
// and no posix redirection model exists). The leg therefore refuses typed and carries the words it would have
// run, so the blocked step is visible and countable rather than hand-written as shell.
type RentedDetachLeg
  = RentedDetachRefusedNoStdoutToFileRoute { detach_words: List<String> }

fn rented_detach_leg(launch_argv: List<String>) -> RentedDetachLeg {
  RentedDetachRefusedNoStdoutToFileRoute { detach_words: setsid_fork_words(command: launch_argv) }
}

// THE LEG REFUSES FOR ITS FIRST UNMET CAUSE (the key) AND NAMES THE SECOND (the detach) beside it.
type RentedLaunchLeg
  = RentedLaunchNoop
  | RentedLaunchRefusedReadback { cause: String }
  | RentedLaunchRefusedUnmetCauses { key_grant: NonEmptyStr, detach: RentedDetachLeg }

fn rented_launch_leg(launch: NinferServeLaunch, launch_argv: List<String>, reading: RentedServeReading, key: RentedServeKeyBinding) -> RentedLaunchLeg {
  match rented_serve_decision(launch: launch, reading: reading) {
    RentedServeNoop => RentedLaunchNoop
    RentedServeRefused { cause: c } => RentedLaunchRefusedReadback { cause: c }
    RentedServeStart =>
      match key {
        RentedServeKeyUnbound { grant_name: g } => RentedLaunchRefusedUnmetCauses { key_grant: g, detach: rented_detach_leg(launch_argv: launch_argv) }
      }
  }
}

// THE WHOLE PROGRAM IN ORDER: the placement legs first, the launch leg last, so a refusal at the launch leg
// still shows the earlier legs were emitted and not skipped.
type RentedStartupProgram {
  placement_commands: List<ArgvCommand>
  launch: RentedLaunchLeg
}

fn rented_startup_program(
  roots: RentedStoreRoots,
  digest: Sha256Digest,
  link: RentedLinkReading,
  launch: NinferServeLaunch,
  launch_argv: List<String>,
  reading: RentedServeReading,
  key: RentedServeKeyBinding,
) -> RentedStartupProgram {
  RentedStartupProgram {
    placement_commands: match rented_link_switch(roots: roots, digest: digest, link: link) {
      RentedLinkSwitchNoop => []
      RentedLinkSwitchCommands { commands: cs } => cs
    },
    launch: rented_launch_leg(launch: launch, launch_argv: launch_argv, reading: reading, key: key),
  }
}

data rented_serve_launch_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.rented_serve_launch", decl_name: "rented_launch_leg"),
    reason: "the serving API key has no typed binding to the allocation, so a launch that needs it refuses and no launch command is emitted by the full sequence",
    dissolution: unbound_dissolution(description: "trigger:S4 binds the serving API key as a grant to the allocation — sufficient for the full-sequence claim to emit the launch command"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.rented_serve_launch", decl_name: "rented_detach_leg"),
    reason: "no modeled route sets a child's stdout to a file, so a setsid-detached engine would keep the ssh channel as stdout; the card's PID 1 is bash and its systemd manager is offline, so systemd_run is not used",
    dissolution: unbound_dissolution(description: "a modeled route that sets a launched program's stdout and stderr to a file over the card's transport, sufficient for the launch leg to emit the detached launch command"),
  ),
]

// THE VERSIONED RECEIPT (the runner_guest_image standing shape): the program's rendered text, one placement
// command per line then the launch leg's standing, so a reader sees what the lab would run and where it stops.
fn rented_launch_leg_text(leg: RentedLaunchLeg) -> String {
  match leg {
    RentedLaunchNoop => "launch: noop (already serving the pinned model)"
    RentedLaunchRefusedReadback { cause: c } => concat("launch: refused on readback: ", c)
    RentedLaunchRefusedUnmetCauses { key_grant: g, detach: _ } => concat("launch: refused: serve key grant unbound (", concat(g as String, "); and no modeled stdout-to-file route for the detach)"))
  }
}

fn rented_startup_program_text(program: RentedStartupProgram) -> String {
  concat(join(map(program.placement_commands, c => shell_command_render(command: c)), "\n"), concat("\n", rented_launch_leg_text(leg: program.launch)))
}
