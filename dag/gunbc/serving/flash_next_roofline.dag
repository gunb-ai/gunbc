module gunbc.serving.flash_next_roofline

import std.types { Bool, List, NonEmptyStr }
import std.nat { Nat, nat_cata, nat_min, nat_max }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.measure { ByteSize, byte_size, byte_size_count, Bandwidth, bandwidth, bandwidth_count, Microsecond, microsecond, microsecond_count, Second, second_count, token_count_value, BasisPoint, basis_point_count, Permille, permille, permille_count, giga_tensor_operations_per_second_count }
import extdeps.external_authority { CitedFigureStanding }
import extdeps.gpu.types { GpuModelCatalogRow, TensorDatatype, TensorFp4, TensorBf16, DenseTensorThroughput, gpu_dense_tensor_throughput, gpu_catalog_bandwidth_count }
import extdeps.qwen.qwen3_8_flash_next { FlashNextArchitecture, flash_next_qsa_kv_bytes_per_token, flash_next_params_per_routed_expert }
import gunbc.serving.flash_next_maxq_run_receipt { FlashNextMaxQRunReceipt }

// A ROOFLINE UPPER BOUND, NEVER A FORECAST. Every function here is integer arithmetic over cited-or-
// transcribed figures and returns the ceiling the physics of the stated figures allows; a measured row
// below its ceiling is efficiency, a measured row above it falsifies a figure. Absence is not zero: a
// quantity whose input is missing (a bandwidth the catalog does not carry, a divisor of zero, a reserve
// larger than the memory) is absent, and the prediction that depends on it is not scored.

// WHAT A CARD IS, FOR THE FOLD: the catalog row (bandwidth, tensor throughput), the memory the driver reported on the
// rented card (memory_bytes: observed, not the vendor figure), plus the three
// numbers this repository does not get from a catalog -- the weights the engine loads on it, the
// engine overhead outside weights and KV, and the engine's gpu-memory-utilization. A bandwidth the
// catalog lacks (the B200 row carries none) is supplied as an explicit operator figure and keeps its
// own standing; it is never defaulted.
// Review 84774 (flat-scalar unit fields): byte figures carry std.measure ByteSize and the bandwidth
// override carries Bandwidth (the same carrier the catalog row uses for memory_bandwidth), so a raw
// count never stands for a unit. gpu_memory_utilization rides std.measure's BasisPoint (review
// 84973: a dimensionless ratio still has a print scale, and std.measure's ratio family covers it).
type RooflineCard {
  catalog: GpuModelCatalogRow
  bandwidth_override: Bandwidth?
  memory_bytes: ByteSize
  weights_bytes: ByteSize
  overhead_bytes: ByteSize
  gpu_memory_utilization: BasisPoint
  main_kv_element_bytes: ByteSize
  math_datatype: TensorDatatype
}

fn roofline_bandwidth(card: RooflineCard) -> Bandwidth? {
  match gpu_catalog_bandwidth_count(row: card.catalog) {
    Present { value: b } => Present { value: bandwidth(count: b) }
    none => card.bandwidth_override
  }
}

fn roofline_math_rate_giga(card: RooflineCard) -> Nat? {
  match gpu_dense_tensor_throughput(row: card.catalog, datatype: card.math_datatype) {
    Present { value: t } => Present { value: giga_tensor_operations_per_second_count(r: t.rate) }
    none => none
  }
}

fn roofline_math_standing(card: RooflineCard) -> CitedFigureStanding? {
  match gpu_dense_tensor_throughput(row: card.catalog, datatype: card.math_datatype) {
    Present { value: t } => Present { value: t.standing }
    none => none
  }
}

fn ratio_permille(num: Nat, den: Nat) -> Permille? {
  if den == 0 { none } else { Present { value: permille(count: num * 1000 / den) } }
}

// P1 -- KV CAPACITY FROM MEMORY: utilization x capacity, minus weights, minus overhead, over KV bytes per
// token. Absent when the reserve consumes the budget or bytes per token is zero.
// (review 84955: kv_bytes_per_token rides std.measure's ByteSize — the one byte quantity this fn consumed
// as bare Nat. Its return is a token count, which the 84774 verdict leaves as plain Nat.)
fn kv_capacity_tokens(card: RooflineCard, kv_bytes_per_token: ByteSize) -> Nat? {
  let budget = byte_size_count(b: card.memory_bytes) * basis_point_count(bp: card.gpu_memory_utilization) / 10000
  let reserve = byte_size_count(b: card.weights_bytes) + byte_size_count(b: card.overhead_bytes)
  if byte_size_count(b: kv_bytes_per_token) == 0 || reserve >= budget {
    none
  } else {
    Present { value: (budget - reserve) / byte_size_count(b: kv_bytes_per_token) }
  }
}

// THE MAX-Q'S MEASURED KV BYTES PER TOKEN (pool bytes / pool tokens, GDN state included), the one
// calibration the registered P1 stands on. (review 84955 sweep: same pattern, ByteSize.)
fn maxq_kv_bytes_per_token(receipt: FlashNextMaxQRunReceipt) -> ByteSize? {
  let tokens = token_count_value(t: receipt.kv_cache_tokens)
  if tokens == 0 { none } else { Present { value: byte_size(count: byte_size_count(b: receipt.kv_cache_bytes) / tokens) } }
}

// KV BYTES PER TOKEN ON ANOTHER CARD: the Max-Q's measured figure, which was taken with the FP8 main KV
// (element width 1), moved by the QSA layers' K+V bytes at the card's element width. The GDN state and
// indexer cache are held at their Max-Q size; they are the part of this figure that is calibration, not
// derivation.
// (review 84955: the calibration bytes, the element width and the result ride std.measure's ByteSize —
// no locally minted per-token byte alias; the denominator, per token, lives in the fn name.)
fn kv_bytes_per_token_at_width(arch: FlashNextArchitecture, calibration_bytes_per_token: ByteSize, element_bytes: ByteSize) -> ByteSize {
  byte_size(count: byte_size_count(b: calibration_bytes_per_token) + byte_size_count(b: flash_next_qsa_kv_bytes_per_token(arch: arch, element_bytes: element_bytes)) - byte_size_count(b: flash_next_qsa_kv_bytes_per_token(arch: arch, element_bytes: byte_size(count: 1))))
}

// P2 -- MEAN-SIZE SESSIONS RESIDENT: capacity over the receipt's mean prompt tokens per request.
fn mean_prompt_tokens(receipt: FlashNextMaxQRunReceipt) -> Nat? {
  if receipt.requests == 0 { none } else { Present { value: token_count_value(t: receipt.prompt_tokens) / receipt.requests } }
}

fn sessions_resident(capacity_tokens: Nat, receipt: FlashNextMaxQRunReceipt) -> Nat? {
  match mean_prompt_tokens(receipt: receipt) {
    Present { value: m } => if m == 0 { none } else { Present { value: capacity_tokens / m } }
    none => none
  }
}

// DECODE-STEP BYTES. A routed layer reads only the experts some row in the step routed to. With uniform
// independent routing of k of E experts per row, the expected touched fraction after n rows is
// 1 - ((E-k)/E)^n; this is held in parts per million and rounded down, a lower bound on bytes. Real
// routing is correlated, which lowers the touched count further, so this is the upper edge of the
// expert-bytes term; measured expert counts are the frontier that calibrates it.
fn untouched_fraction_ppm(arch: FlashNextArchitecture, rows: Nat) -> Nat {
  let keep = (arch.routed_experts - arch.experts_per_token) * 1000000 / arch.routed_experts
  nat_cata(n: rows, zero: 1000000, succ: acc => acc * keep / 1000000)
}

fn unique_experts_per_layer(arch: FlashNextArchitecture, rows: Nat) -> Nat {
  arch.routed_experts * (1000000 - untouched_fraction_ppm(arch: arch, rows: rows)) / 1000000
}

// Routed-expert bytes at 4.5 bits per parameter (4-bit weights plus one FP8 scale per 16): the storage
// of NVFP4, and of the Marlin W4A16 repack of it.
// (review 84955 sweep: byte quantities ride std.measure's ByteSize, these two helpers included.)
fn expert_bytes(arch: FlashNextArchitecture) -> ByteSize {
  byte_size(count: flash_next_params_per_routed_expert(arch: arch) * 9 / 16)
}

fn routed_weight_bytes(arch: FlashNextArchitecture) -> ByteSize {
  byte_size(count: arch.layer_count * arch.routed_experts * byte_size_count(b: expert_bytes(arch: arch)))
}

type DecodeStepBytes {
  routed_expert_bytes: ByteSize
  non_routed_bytes: ByteSize
  qsa_kv_read_bytes: ByteSize
}

// One decode step at `concurrent` requests each carrying draft_depth+1 rows, every request at
// `context_tokens`. The non-routed term is all weights that are not routed experts, read in full each
// step -- an upper bound, since embedding rows are gathered not streamed. The QSA layers read at most
// indexer_budget_tokens of each request's KV.
fn decode_step_bytes(arch: FlashNextArchitecture, card: RooflineCard, concurrent: Nat, draft_depth: Nat, context_tokens: Nat) -> DecodeStepBytes {
  let rows = concurrent * (draft_depth + 1)
  let routed_total = byte_size_count(b: routed_weight_bytes(arch: arch))
  let weights = byte_size_count(b: card.weights_bytes)
  DecodeStepBytes {
    routed_expert_bytes: byte_size(count: arch.layer_count * unique_experts_per_layer(arch: arch, rows: rows) * byte_size_count(b: expert_bytes(arch: arch))),
    non_routed_bytes: byte_size(count: if weights > routed_total { weights - routed_total } else { 0 }),
    qsa_kv_read_bytes: byte_size(count: concurrent * byte_size_count(b: flash_next_qsa_kv_bytes_per_token(arch: arch, element_bytes: card.main_kv_element_bytes)) * nat_min(a: context_tokens, b: arch.indexer_budget_tokens)),
  }
}

fn decode_step_total(b: DecodeStepBytes) -> ByteSize {
  byte_size(count: byte_size_count(b: b.routed_expert_bytes) + byte_size_count(b: b.non_routed_bytes) + byte_size_count(b: b.qsa_kv_read_bytes))
}

// P3 CEILING -- bandwidth-bound time of one decode step, microseconds.
fn decode_step_floor_us(arch: FlashNextArchitecture, card: RooflineCard, concurrent: Nat, draft_depth: Nat, context_tokens: Nat) -> Microsecond? {
  match roofline_bandwidth(card: card) {
    Present { value: bw } => if bandwidth_count(b: bw) == 0 { none } else {
      Present { value: microsecond(count: byte_size_count(b: decode_step_total(b: decode_step_bytes(arch: arch, card: card, concurrent: concurrent, draft_depth: draft_depth, context_tokens: context_tokens))) * 1000000 / bandwidth_count(b: bw)) }
    }
    none => none
  }
}

// P4 CEILING -- one prefill chunk of `chunk_tokens`. Compute: 2 x active parameters per token, in
// giga-ops, over the card's dense rate at its math datatype. Bandwidth: a chunk this large touches every
// expert (unique_experts_per_layer saturates), so every weight streams once. The chunk's time is the
// larger of the two, and `ComputeBound` / `BandwidthBound` names which.
type PrefillBound = ComputeBound | BandwidthBound

type PrefillChunkFloor {
  compute_us: Microsecond
  bandwidth_us: Microsecond
  floor_us: Microsecond
  bound: PrefillBound
}

fn prefill_chunk_floor(arch: FlashNextArchitecture, card: RooflineCard, chunk_tokens: Nat) -> PrefillChunkFloor? {
  match roofline_math_rate_giga(card: card) {
    Present { value: rate } => match roofline_bandwidth(card: card) {
      Present { value: bw } => if rate == 0 || bandwidth_count(b: bw) == 0 { none } else {
        let giga_ops = 2 * arch.active_parameters_per_token * chunk_tokens / 1000000000
        let compute_us = giga_ops * 1000000 / rate
        let bandwidth_us = byte_size_count(b: card.weights_bytes) * 1000000 / bandwidth_count(b: bw)
        Present {
          value: PrefillChunkFloor {
            compute_us: microsecond(count: compute_us),
            bandwidth_us: microsecond(count: bandwidth_us),
            floor_us: microsecond(count: nat_max(a: compute_us, b: bandwidth_us)),
            bound: if compute_us >= bandwidth_us { ComputeBound } else { BandwidthBound },
          }
        }
      }
      none => none
    }
    none => none
  }
}

// A CEILING RATIO against the Max-Q baseline, in permille (1000 = parity), carrying the standing of the
// math-rate figure it stands on so a consumer cannot read a TranscribedUncited spec as a cited law.
type CeilingRatio {
  permille: Permille
  spec_standing: CitedFigureStanding
}

fn speed_ratio_permille(baseline_us: Microsecond, card_us: Microsecond) -> Permille? {
  ratio_permille(num: microsecond_count(m: baseline_us), den: microsecond_count(m: card_us))
}

fn p4_ceiling_ratio(arch: FlashNextArchitecture, baseline: RooflineCard, card: RooflineCard, chunk_tokens: Nat) -> CeilingRatio? {
  match prefill_chunk_floor(arch: arch, card: baseline, chunk_tokens: chunk_tokens) {
    Present { value: b } => match prefill_chunk_floor(arch: arch, card: card, chunk_tokens: chunk_tokens) {
      Present { value: c } => match speed_ratio_permille(baseline_us: b.floor_us, card_us: c.floor_us) {
        Present { value: r } => match roofline_math_standing(card: card) {
          Present { value: s } => Present { value: CeilingRatio { permille: r, spec_standing: s } }
          none => none
        }
        none => none
      }
      none => none
    }
    none => none
  }
}

fn p3_ceiling_ratio(arch: FlashNextArchitecture, baseline: RooflineCard, card: RooflineCard, concurrent: Nat, draft_depth: Nat, context_tokens: Nat) -> CeilingRatio? {
  match decode_step_floor_us(arch: arch, card: baseline, concurrent: concurrent, draft_depth: draft_depth, context_tokens: context_tokens) {
    Present { value: b } => match decode_step_floor_us(arch: arch, card: card, concurrent: concurrent, draft_depth: draft_depth, context_tokens: context_tokens) {
      Present { value: c } => match speed_ratio_permille(baseline_us: b, card_us: c) {
        Present { value: r } => match roofline_math_standing(card: card) {
          Present { value: s } => Present { value: CeilingRatio { permille: r, spec_standing: s } }
          none => none
        }
        none => none
      }
      none => none
    }
    none => none
  }
}

// P5 COMPOSITION. A request spends its non-queue service time in prefill and in decode in the receipt's
// proportion; a card that is r3 times faster in decode and r4 times in prefill serves a request in
// share_prefill / r4 + share_decode / r3 of the baseline time. Returns the request-rate ratio in
// permille. This composes ceilings or interval ends; it does not model queueing, which is the
// registered P5 basis for exceeding it ("more KV removes queueing and preemption").
fn p5_composed_permille(receipt: FlashNextMaxQRunReceipt, r3: Permille, r4: Permille) -> Permille? {
  let prefill = second_count(s: receipt.prefill_time_sum_seconds)
  let decode = second_count(s: receipt.decode_time_sum_seconds)
  let total = prefill + decode
  let r3_permille = permille_count(p: r3)
  let r4_permille = permille_count(p: r4)
  if total == 0 || r3_permille == 0 || r4_permille == 0 {
    none
  } else {
    let time_ppm = prefill * 1000000 / total * 1000 / r4_permille + decode * 1000000 / total * 1000 / r3_permille
    if time_ppm == 0 { none } else { Present { value: permille(count: 1000000000 / time_ppm) } }
  }
}

data flash_next_roofline_consumer_frontier: DissolutionCondition = unbound_dissolution(
  description: "DESIGN section 3c: the roofline folds are consumed by gunbc.serving.flash_next_predictions (P1 to P6 scoring against ceilings) and executed by test.claim.flash_next_serving_witness. Declared frontiers, each with its trigger: (1) the unique-experts term assumes uniform independent routing and the prefill term assumes every expert is touched; a measured per-layer expert count from an H200 or B200 run replaces them. (2) The decode attention term reads only the QSA budget and ignores the indexer scan over the full context and the GDN recurrent state reads; a measured step-bytes counter replaces it. (3) No kernel efficiency is modeled; efficiency is the ratio a measured row has to its ceiling." as NonEmptyStr
)
