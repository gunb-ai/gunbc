// One row per (variant, cell); a duplicate or missing pair reads as absent, never as the first hit.
fn quant_matrix_outcome(rows: List<QuantMatrixRow>, v: ServingVariant, c: QuantCell) -> CellOutcome? {
  let hits = rows |> filter(r => serving_variant_eq(a: r.variant, b: v) && quant_cell_eq(a: r.cell, b: c))
  if count(hits) == 1 {
    fold(hits, init: none, f: (_acc, r) => Present { value: r.outcome })
  } else {
    none
  }
}

// The Qwen/Qwen3.8-Flash-Next-FP8 checkpoint at revision 236dfdf285828023ca3bcd3f37366c58a3469b13 is 172.8 GiB of
// safetensors (HF tree API sum, 131 files; PLE table FP8). Upstream offloads the PLE table to host, so the GPU-resident
// share is below this and unmeasured: the FP8 cells stay Unobserved until a matrix row reports; they may refuse.
data fp8_checkpoint_safetensors_centi_gib: Nat = 17280

// OBSERVATIONS of the upstream 0.32.0 runs, relayed by the operator (run receipts; the remaining ServingRunReceipt
// fields — vbios, digests, backends per layer — are owed with the snapshots).
type UpstreamRunObservation {
  variant: ServingVariant
  gpu_uuid: NonEmptyStr
  vbios: NonEmptyStr
  power_limit_deci_watts: Nat
  driver_version: NonEmptyStr
  moe_backend: NonEmptyStr
  mtp_expert_backend: NonEmptyStr
  linear_backend: NonEmptyStr
  attention_note: NonEmptyStr
  ple_note: NonEmptyStr
}

data upstream_ple_note: NonEmptyStr = "PLE table re-expressed BF16: upstream rejected the checkpoint NVFP4 PLE geometry (expected (2500012,160), got (2500012,80)); cpu_offload on" as NonEmptyStr

data upstream_v032_run_observations: List<UpstreamRunObservation> = [
  UpstreamRunObservation { variant: H200UpstreamV032, gpu_uuid: "GPU-db782247-b35d-34cf-3f2a-02c3d8c2918e" as NonEmptyStr, vbios: "96.00.D9.00.0E" as NonEmptyStr, power_limit_deci_watts: 5000, driver_version: "615.71.09" as NonEmptyStr, moe_backend: "NvFp4 MoE MARLIN (recipe triton refuses NVFP4)" as NonEmptyStr, mtp_expert_backend: "marlin" as NonEmptyStr, linear_backend: "HummingMxfp8LinearKernel" as NonEmptyStr, attention_note: "fp8 KV + fp8 indexer KV" as NonEmptyStr, ple_note: upstream_ple_note },
  UpstreamRunObservation { variant: B200UpstreamV032, gpu_uuid: "GPU-801c30bc-4111-f820-3b13-16318ba8f211" as NonEmptyStr, vbios: "97.00.C5.00.2D" as NonEmptyStr, power_limit_deci_watts: 10000, driver_version: "580.126.09" as NonEmptyStr, moe_backend: "NvFp4 MoE FLASHINFER_TRTLLM (main experts)" as NonEmptyStr, mtp_expert_backend: "NvFp4 MoE MARLIN W4A16 (MTP experts)" as NonEmptyStr, linear_backend: "MXFP8 FlashInferCutedslMxfp8LinearKernel (main) + MarlinMxfp8LinearKernel (one other group)" as NonEmptyStr, attention_note: "FA4 Blackwell head_size 256 does not support fp8 KV; falls back to FA2 (upstream warning)" as NonEmptyStr, ple_note: upstream_ple_note },
]

// OBSERVATIONS of the upstream 0.32.0 runs that are not throughput rows (relayed by the operator, raw files under
// /root/bench/<tag>/ on each box). A defect observed is a finding about the stack, not a property of the card.
type UpstreamDefectObservation {
  variant: ServingVariant
  finding: NonEmptyStr
}

data upstream_defect_observations: List<UpstreamDefectObservation> = [
  UpstreamDefectObservation { variant: B200UpstreamV032, finding: "FP8 KV is slower than BF16 KV at c1 (357 vs 416 tok/s per request): upstream logs that FA4 Blackwell head_size=256 does not support fp8 KV and falls back to FA2; a kernel gap, not hardware" as NonEmptyStr },
  UpstreamDefectObservation { variant: H200UpstreamV032, finding: "max-model-len 1000000 (YaRN x4): server READY with 3068862 KV tokens (3.07x of 1M), then CUDA illegal memory access at about 900k context with zero bench rows; the B200 1M result is pending" as NonEmptyStr },
]

data flash_next_quant_matrix_frontier: DissolutionCondition = unbound_dissolution(
  description: "DESIGN section 3c: consumed by test.claim.flash_next_serving_witness. Frontier, trigger: server-counter aggregates replace the client agg_gen_tps for the H200 run, the B200 bench lands (throughput is empty), the Max-Q driver is committed, the FP8 cells report their GPU-resident weights, and the BF16 335 GiB figure (operator, uncited) is read from the BF16 checkpoint index." as NonEmptyStr
)
