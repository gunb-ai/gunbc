  UpstreamRunObservation { variant: B200UpstreamV032, gpu_uuid: "GPU-801c30bc-4111-f820-3b13-16318ba8f211" as NonEmptyStr, vbios: "97.00.C5.00.2D" as NonEmptyStr, power_limit_milliwatts: milliwatt(count: 1000000), driver_version: "580.126.09" as NonEmptyStr, moe_backend: "NvFp4 MoE FLASHINFER_TRTLLM (main experts)" as NonEmptyStr, mtp_expert_backend: "NvFp4 MoE MARLIN W4A16 (MTP experts)" as NonEmptyStr, linear_backend: "MXFP8 FlashInferCutedslMxfp8LinearKernel (main) + MarlinMxfp8LinearKernel (one other group)" as NonEmptyStr, attention_note: "FA4 Blackwell head_size 256 does not support fp8 KV; falls back to FA2 (upstream warning)" as NonEmptyStr, ple_note: upstream_ple_note },
