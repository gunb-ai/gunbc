  ConcurrencyReading { admission: WarmNotYetAdmitted { trigger: bench_v2_records_trigger }, concurrency: 16, decode_deci_tokens_per_second_per_request: 98, inter_token_gap_microseconds: nat_present(n: 443000), ttft_median_milliseconds: nat_present(n: 21000), ttft_max_milliseconds: none, aggregate_deci_tokens_per_second: none, preemptions: none, capacity_boundary: true },
