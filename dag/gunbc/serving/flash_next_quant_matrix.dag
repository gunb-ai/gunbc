// OBSERVATIONS of the upstream 0.32.0 runs that are not throughput rows (relayed by the operator, raw files under
// /root/bench/<tag>/ on each box). A defect observed is a finding about the stack, not a property of the card.
type UpstreamDefectObservation {
  variant: ServingVariant
  finding: NonEmptyStr
}

data upstream_defect_observations: List<UpstreamDefectObservation> = [
  UpstreamDefectObservation { variant: B200UpstreamV032, finding: "FP8 KV is slower than BF16 KV at c1 (357 vs 416 tok/s per request): upstream logs that FA4 Blackwell head_size=256 does not support fp8 KV and falls back to FA2; a kernel gap, not hardware" as NonEmptyStr },
  UpstreamDefectObservation { variant: H200UpstreamV032, finding: "max-model-len 1000000 (YaRN x4): server READY with 3068862 KV tokens (3.07x of 1M), then CUDA illegal memory access at about 900k context with zero bench rows; reproduced on the B200" as NonEmptyStr },
  UpstreamDefectObservation { variant: B200UpstreamV032, finding: "max-model-len 1000000, both KV dtypes: EngineCore RuntimeError Triton Error [CUDA] illegal memory access within about 8 s of the first ~916k-token request; reported frame qwen4_exp/nvidia/ops/hc.py _hc_gate_mix, asynchronous so not necessarily the faulting kernel; not Hopper-specific; the PLE table is the BF16 re-expression so a PLE-path fault is not excluded; cause not established" as NonEmptyStr },
]

// THE POOL IS KEYED BY max-model-len TOO: the same cell reports a larger vLLM pool at 1,000,000 (recipe long_context: YaRN x4,
// VLLM_ALLOW_LONG_MAX_MODEL_LEN=1) than at 262,144 (5.05M / 2.81M / 2.63M above); the difference is unexplained, so the
// length is part of the capacity identity and these rows never replace the 262,144 rows.
type ReportedPoolAtLength {
  variant: ServingVariant
  cell: QuantCell
  max_model_len_tokens: Nat
  kv_tokens: Nat
}

data long_context_reported_pools: List<ReportedPoolAtLength> = [
