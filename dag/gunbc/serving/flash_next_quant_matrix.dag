// BF16 KV beats FP8 KV on the decode ceiling on both cards (H200 +13%, B200 +21%): a software-path effect (FA2 fallback for
// fp8 KV at head size 256), recorded as an observation about the stack, not a property of the dtype.
fn decode_ceiling(rows: List<CeilingReading>, v: ServingVariant, c: QuantCell) -> MilliTokensPerSecond? {
  let hits = rows |> filter(r => serving_variant_eq(a: r.variant, b: v) && quant_cell_eq(a: r.cell, b: c))
  if count(hits) == 1 {
    fold(hits, init: none, f: (_acc, r) => Present { value: r.decode_tokens_per_second })
  } else {
    none
  }
}

// RESULTS THAT WERE RUN BUT NEVER RETRIEVED: the H200 and B200 rentals became unreachable (connection refused on every
// route) at about 04:55Z on 2026-10-22, before the raw files were copied. Unobserved with the cause, not Refused and not
// zero; the operator restarting the instances lets the parent pull and fill them. The B200 FP8-weights/BF16-KV cell keeps
// its matrix values (KV 1,010,317 tokens, replay rows).
type UnretrievedMode = ModeCeiling | ModeFillWithItl | ModeHitFraction | ModeOutputLength | ModeOpenLoop

type UnretrievedResult {
  variant: ServingVariant
  cell: QuantCell
  mode: UnretrievedMode
  cause: NonEmptyStr
}

data rental_ended_cause: NonEmptyStr = "rental ended before results were retrieved" as NonEmptyStr

fn unretrieved(v: ServingVariant, w: WeightDtype, kv: KvDtype, m: UnretrievedMode) -> UnretrievedResult {
  UnretrievedResult { variant: v, cell: kv_cell(weights: w, kv: kv), mode: m, cause: rental_ended_cause }
}

data flash_next_unretrieved_results: List<UnretrievedResult> = [
  unretrieved(v: B200UpstreamV032, w: WeightFp8Qwen128Blocks, kv: KvBf16, m: ModeCeiling),
  unretrieved(v: H200UpstreamV032, w: WeightNvfp4LilQad, kv: KvFp8, m: ModeFillWithItl),
  unretrieved(v: H200UpstreamV032, w: WeightNvfp4LilQad, kv: KvFp8, m: ModeHitFraction),
  unretrieved(v: H200UpstreamV032, w: WeightNvfp4LilQad, kv: KvFp8, m: ModeOutputLength),
  unretrieved(v: H200UpstreamV032, w: WeightNvfp4LilQad, kv: KvFp8, m: ModeOpenLoop),
  unretrieved(v: B200UpstreamV032, w: WeightNvfp4LilQad, kv: KvFp8, m: ModeFillWithItl),
  unretrieved(v: B200UpstreamV032, w: WeightNvfp4LilQad, kv: KvFp8, m: ModeHitFraction),
  unretrieved(v: B200UpstreamV032, w: WeightNvfp4LilQad, kv: KvFp8, m: ModeOutputLength),
  unretrieved(v: B200UpstreamV032, w: WeightNvfp4LilQad, kv: KvFp8, m: ModeOpenLoop),
]

