module gunbc.serving.flash_next_quant_matrix

import std.types { Bool, List, NonEmptyStr }
import std.nat { Nat }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.measure { byte_size, byte_size_count, ByteSize, centi_gibibyte_to_byte_size, gibibyte, gibibyte_to_byte_size, BasisPoint, basis_point, basis_point_count, Milliwatt, milliwatt, MilliTokensPerSecond, milli_tokens_per_second, milli_tokens_per_second_count, Microsecond, microsecond, microsecond_count, Millisecond, millisecond, millisecond_count }
import gunbc.serving.gpu_bench_warm_standing { GpuBenchWarmStanding, WarmValid }
import gunbc.serving.gpu_observed_memory_receipt { observed_memory_bytes, h200_nvl_observed_memory, b200_observed_memory, max_q_observed_memory }
import gunbc.serving.flash_next_experiment_identity { ServingVariant, Pro6000MaxQNative, H200UpstreamV032, B200UpstreamV032, serving_variant_eq }

// THE QUANTIZATION MATRIX: raw capacity and throughput per card x weight dtype x KV dtype, no quality assessment (the
// operator infers quality from the dtype). The indexer KV follows the KV dtype. A cell that does not fit is Refused with
// the cause; a cell nobody ran is Unobserved; neither is ever a zero.
type WeightDtype = WeightNvfp4LilQad | WeightFp8Qwen128Blocks | WeightBf16

type KvDtype = KvFp8 | KvBf16

type QuantCell {
  weights: WeightDtype
  kv: KvDtype
}

fn weight_dtype_eq(a: WeightDtype, b: WeightDtype) -> Bool {
  match a {
    WeightNvfp4LilQad => match b { WeightNvfp4LilQad => true, _ => false }
    WeightFp8Qwen128Blocks => match b { WeightFp8Qwen128Blocks => true, _ => false }
    WeightBf16 => match b { WeightBf16 => true, _ => false }
  }
}

fn kv_dtype_eq(a: KvDtype, b: KvDtype) -> Bool {
  match a {
    KvFp8 => match b { KvFp8 => true, _ => false }
    KvBf16 => match b { KvBf16 => true, _ => false }
  }
}

fn quant_cell_eq(a: QuantCell, b: QuantCell) -> Bool {
  weight_dtype_eq(a: a.weights, b: b.weights) && kv_dtype_eq(a: a.kv, b: b.kv)
}

// Throughput of one concurrency level of the session-replay bench (base 90k context, +16k new per turn, 1100 output
// tokens per turn, ignore_eos, MTP-3). Tenths of tok/s and microseconds keep the figures integral.
// A warm throughput row is scoreable only under WarmValid from gunbc.serving.gpu_bench_warm_standing (working set within
// the measured KV, prefix reuse proven; recurring failure mode benchmark_warm_capacity_violation_read_as_engine_performance).
// Rows replayed before the bench emitted gpu-bench/request/v2 records have no standing and are NotYetAdmitted.
type WarmAdmission
  = WarmAdmissionStanding { standing: GpuBenchWarmStanding }
  | WarmNotYetAdmitted { trigger: NonEmptyStr }

fn throughput_scoreable(a: WarmAdmission) -> Bool {
  match a {
    WarmAdmissionStanding { standing: WarmValid { working_set_tokens: _, measured_kv_tokens: _ } } => true
    _ => false
  }
}

data bench_v2_records_trigger: NonEmptyStr = "the bench emits gpu-bench/request/v2 records and gpu_bench_warm_run_admission plus gpu_bench_warm_standing_after_replay return WarmValid for this run" as NonEmptyStr

type ConcurrencyReading {
  admission: WarmAdmission
  concurrency: Nat
  decode_tokens_per_second_per_request: MilliTokensPerSecond
  inter_token_gap_microseconds: Microsecond?
  ttft_median_milliseconds: Millisecond?
  ttft_max_milliseconds: Millisecond?
  aggregate_tokens_per_second: MilliTokensPerSecond?
  preemptions: Nat?
  capacity_boundary: Bool
}

type CellOutcome
  = CellMeasured {
      // Review 84973: the capacity screenshots printed these GiB figures to two decimals
      // (73.39 GiB logged as 7339); they are now ByteSize, minted through std.measure's
      // centi_gibibyte_to_byte_size, so the unit lives in the type and no field name carries it.
      weights_bytes: ByteSize?
      kv_bytes: ByteSize?
      kv_tokens: Nat?
      gpu_memory_utilization: BasisPoint
      throughput: List<ConcurrencyReading>
    }
  | CellRefusedWeightsExceedUsableMemory { weights_bytes: ByteSize, usable_bytes: ByteSize }
  | CellRefusedOther { cause: NonEmptyStr }
  | CellUnobserved { trigger: NonEmptyStr }

type QuantMatrixRow {
  variant: ServingVariant
  cell: QuantCell
  outcome: CellOutcome
}

// A weight set larger than the utilization-scaled observed memory cannot be loaded: refused, with both numbers.
fn weights_outcome_for(memory_bytes: ByteSize, utilization: BasisPoint, weights_bytes: ByteSize, fits: CellOutcome) -> CellOutcome {
  let usable = byte_size_count(b: memory_bytes) * basis_point_count(bp: utilization) / 10000
  if byte_size_count(b: weights_bytes) >= usable {
    CellRefusedWeightsExceedUsableMemory { weights_bytes: weights_bytes, usable_bytes: byte_size(count: usable) }
  } else {
    fits
  }
}

data bf16_weights_bytes: ByteSize = gibibyte_to_byte_size(g: gibibyte(count: 335))

data cell_needs_run_trigger: NonEmptyStr = "a committed run receipt of this card with this weight and KV dtype" as NonEmptyStr

data maxq_unobserved_trigger: NonEmptyStr = "a spare RTX PRO 6000 is rented and this cell is run; the production card serves only the fork b12x NVFP4 + FP8 KV path" as NonEmptyStr

fn unobserved() -> CellOutcome {
  CellUnobserved { trigger: cell_needs_run_trigger }
}

fn refused_bf16(memory_bytes: ByteSize, utilization: BasisPoint) -> CellOutcome {
  weights_outcome_for(memory_bytes: memory_bytes, utilization: utilization, weights_bytes: bf16_weights_bytes, fits: unobserved())
}


fn nat_present(n: Nat) -> Nat? {
  Present { value: n }
}

// Review 84774 (flat-scalar unit fields): the relayed throughput rows carry std.measure carriers
// instead of a bare Nat whose scale lives only in the field name. The upstream bench logged tok/s to
// one decimal; the stored literals are that print figure times ten (the deci the old field names
// carried), and the milli carrier takes the print figure times a hundred, so 2987 still means
// exactly 298.7 tok/s.
fn milli_tokens_present(print_deci: Nat) -> MilliTokensPerSecond? {
  Present { value: milli_tokens_per_second(count: print_deci * 100) }
}

fn milli_tokens(print_deci: Nat) -> MilliTokensPerSecond {
  milli_tokens_per_second(count: print_deci * 100)
}

// A bare `none` at call-argument position loses the payload type (checker), so the absent arms of
// the sweep rows are declared with their carrier spelled.
data no_gap: Microsecond? = none

data no_ttft: Millisecond? = none

fn micro_present(print_us: Nat) -> Microsecond? {
  Present { value: microsecond(count: print_us) }
}

fn milli_present(print_ms: Nat) -> Millisecond? {
  Present { value: millisecond(count: print_ms) }
}

// One level of the upstream sweep. agg is the server-counted generation_tokens_total delta over the level's wall time
// (warm-turn tokens included), per_request the median per-request decode rate, both in tenths of tok/s. A level with
// preemptions or a collapse is capacity-boundary evidence, never engine throughput.
fn sweep_level(c: Nat, agg: Nat, per_request: Nat, gap_us: Microsecond?, ttft_ms: Millisecond?, preempt: Nat, boundary: Bool) -> ConcurrencyReading {
  ConcurrencyReading { admission: WarmNotYetAdmitted { trigger: bench_v2_records_trigger }, concurrency: c, decode_tokens_per_second_per_request: milli_tokens(print_deci: per_request), inter_token_gap_microseconds: gap_us, ttft_median_milliseconds: ttft_ms, ttft_max_milliseconds: none, aggregate_tokens_per_second: milli_tokens_present(print_deci: agg), preemptions: nat_present(n: preempt), capacity_boundary: boundary }
}

