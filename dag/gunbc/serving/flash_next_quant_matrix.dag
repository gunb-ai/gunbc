// One row per (variant, cell); a duplicate or missing pair reads as absent, never as the first hit.
fn quant_matrix_outcome(rows: List<QuantMatrixRow>, v: ServingVariant, c: QuantCell) -> CellOutcome? {
  let hits = rows |> filter(r => serving_variant_eq(a: r.variant, b: v) && quant_cell_eq(a: r.cell, b: c))
  if count(hits) == 1 {
    fold(hits, init: none, f: (_acc, r) => Present { value: r.outcome })
  } else {
    none
  }
}

// The Qwen/Qwen3.8-Flash-Next-FP8 checkpoint at revision 236dfdf285828023ca3bcd3f37366c58a3469b13 is 172.8 GiB of
// safetensors (HF tree API sum, 131 files; PLE table FP8). Upstream offloads the PLE table to host, so the GPU-resident
// share is below this and unmeasured: the FP8 cells stay Unobserved until a matrix row reports; they may refuse.
data fp8_checkpoint_safetensors_bytes: ByteSize = centi_gibibyte_to_byte_size(centi: 17280)

// OBSERVATIONS of the upstream 0.32.0 runs, relayed by the operator (run receipts; the remaining ServingRunReceipt
// fields — vbios, digests, backends per layer — are owed with the snapshots).
type UpstreamRunObservation {
  variant: ServingVariant
  gpu_uuid: NonEmptyStr
  vbios: NonEmptyStr
  // Deci-watt print precision carried as std.measure Milliwatt, finer resolution holds it exactly
  // (review 84774; see flash_next_experiment_identity.ServingRunReceipt for the reasoning).
  power_limit_milliwatts: Milliwatt
  driver_version: NonEmptyStr
  moe_backend: NonEmptyStr
  mtp_expert_backend: NonEmptyStr
  linear_backend: NonEmptyStr
  attention_note: NonEmptyStr
  ple_note: NonEmptyStr
}

data upstream_ple_note: NonEmptyStr = "PLE table re-expressed BF16: upstream rejected the checkpoint NVFP4 PLE geometry (expected (2500012,160), got (2500012,80)); cpu_offload on" as NonEmptyStr

data upstream_v032_run_observations: List<UpstreamRunObservation> = [
