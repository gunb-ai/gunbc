module gunbc.serving.serving_reservation

// A SERVING REPLICA'S CLAIM ON ITS HOST, SAID AS TYPED FACTS, BEFORE ANY OF IT IS SPENT.
//
// WHY THIS MODULE EXISTS (B4a, 2026-11-10). The serving path could already say how MANY replicas a host
// runs and WHAT each is configured as (serving_layout's ServingReplicaConfig, serving_replica_profile's
// ServingReplicaProfile), but nowhere could it say what a replica TAKES OFF THE HOST while it runs: which
// cores it may run on, whether those cores are held back from every other tenant, how much memory is set
// aside for it, which cards and at what power cap, and on which port and address its engine listens. The
// finding B4a closes is that these were expressible nowhere on the serving path (ServingDeviceGroup,
// ServingReplicaConfig, ServingReplicaProfile, ReplicaGpuCard, extdeps.strata.serve_flags carried none of
// them), so the only place a port appeared at all was the router's own naming row, and the runner's width
// derivation (gunbc.runner.runner_slot_allocation, gunbc.live_deploy.served_slice_charge) could charge only
// the one prod-role host and never srv3's or srv4's Strata -- because it had nothing typed to charge with.
//
// A RESERVATION IS PRICED BEFORE CI WIDTH, NOT DISCOVERED AFTER IT (operator ruling, B4a). A core the
// engine is given exclusively is a core the runner cannot hand to a CI slot; a core the engine is merely
// ALLOWED on is still a core the runner may use. The distinction is the whole of the module's reason for
// being: affinity is a fact about where a process may run, exclusivity is a fact about what is withheld
// from everyone else, and only the second one has a price against CI width. Collapsing them -- pinning and
// reserving with one field -- would either overcharge (a pinned-but-shared cpuset wrongly shrinks the
// runner) or undercharge (an exclusive range wrongly leaves its cores bookable by a second tenant). So
// they are two arms, and the width derivation reads only the exclusive one.
//
// PER-REPLICA, NOT PER-HOST (B4a ruling, and operator ruling D2 in gunbc.plans.fleet_machine_naming: a
// per-host fact is a DATA ROW keyed by the machine, never a named per-host declaration). A host that runs
// N replicas prices N reservations, one per replica row, each keyed by (host, replica id). The width a host
// gives back to the runner is the fold over its replicas' reservations -- so adding a second engine to a
// host is another row, not a fork of the derivation.
//
// NOTHING HERE DEPLOYS. This is the model the live deploy (B4b, cool-lark-40) and the runner width
// derivation consume; the witnesses under dag/test/claim/serving are the consumers that make it true by
// execution. The production consumer for the width charge is the runner's served-deployment claim, which
// today (gunbc.live_deploy.served_slice_charge, owned by PR 16058) charges the prod-role host's container
// MEMORY only -- this module supplies the CPU/GPU/memory-reservation face and charges it for EVERY serving
// host, keyed by host identity, so the prod-role restriction the finding names is not inherited here.
import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.optional { Optional, Present, Absent }
import std.measure { ByteSize, byte_size_count, byte_size, Watt, watt, watt_count }
import gunbc.serving.serving_host_memory { srv3_strata_engine_memory, srv4_serving_engine_memory, serving_reading_bytes_or_zero }
import product.host_identity { HostIdentity, host_identity_eq }
import gunbc.fleet.fleet_host_identity { operator_host_srv3, operator_host_srv4, operator_host_srv14 }

// ── CPU: A CPUSASET A PROCESS MAY RUN ON IS NOT A SET WITHHELD FROM EVERYONE ELSE ────────────────────

// AN INCLUSIVE RANGE OF CORE INDICES. `first` is never above `last` -- a witness pins that, because the
// width below is `last - first + 1` and a reversed range would underflow the naturals rather than mean
// "empty."
type CpuRange {
  first: Nat
  last: Nat
}

// A CPUSASET: the cores a process is placed among. Either nothing (an engine with no placement, which
// shares whatever the cgroup was handed) or a list of inclusive ranges. Modelled as ranges and not as a
// string like "0-39" so the width is a fact of the carrier rather than of a parser: a host's cpuset is
// counted, not decoded (gunbc.design_argument::minimize_redundancy -- no parser where data will do).
type CpuSet
  = NoCpuSet
  | CpuRanges { ranges: List<CpuRange> }

// THE PRICE-RELEVANT DISTINCTION. `CpuAffinity` says which cores the engine may run on; the host keeps
// them bookable, so the runner may still spend them on a CI slot. `CpuExclusive` says those cores are
// withheld from every other tenant for the engine's life; the runner may NOT spend them. The two carry the
// same set and cost the host different amounts, which is why they are two arms and not one field with a
// boolean.
type CpuReservation
  = CpuAffinity { set: CpuSet }
  | CpuExclusive { set: CpuSet }

// HOW MANY CORES A RANGE SPANS. Both endpoints are addressable cores, hence `+ 1`. Well-formedness
// (`first <= last`) is the caller's duty and is witnessed; a reversed range is a bug in the row, not an
// empty set.
fn cpu_range_width(r: CpuRange) -> Nat {
  r.last - r.first + 1
}

fn cpu_set_width(set: CpuSet) -> Nat {
  match set {
    NoCpuSet => 0
    CpuRanges { ranges: rs } => fold(rs, init: 0, f: (acc, r) => acc + cpu_range_width(r))
  }
}

// THE WIDTH PRICE: only exclusive cores leave the runner's bookable pool. An affinity cpuset prices zero
// against CI width, because the scheduler may still place a runner on a core an engine is merely permitted
// to use. This single line is what "affinity-only does not reduce CI width while exclusive does" rests on,
// and the witness says it in both directions.
fn cpu_reservation_excluded_cores(r: CpuReservation) -> Nat {
  match r {
    CpuAffinity { set: _ } => 0
    CpuExclusive { set: s } => cpu_set_width(s)
  }
}

// IS THIS CORE INSIDE THE RESERVATION'S SET (either arm -- placement, not price).
fn cpu_reservation_covers(r: CpuReservation, core: Nat) -> Bool {
  let set = match r {
    CpuAffinity { set: s } => s
    CpuExclusive { set: s } => s
  }
  match set {
    NoCpuSet => false
    CpuRanges { ranges: rs } => any(rs, range => core >= range.first && core <= range.last)
  }
}

// ── GPU: WHICH CARDS, AT WHAT CAP ────────────────────────────────────────────────────────────────────

// THE CARDS A REPLICA HOLDS AND THE POWER FLOOR IT SETS ON THEM. The power cap is the reason a card's
// reservation is not merely a device list: ReplicaGpuCard.power_cap was always Absent on the serving path,
// so a card an operator had capped to 35 W looked identical to an uncapped one. A Present cap is a priced
// fact (heat and clock headroom the host has committed away); Absent says nothing was capped, not that the
// cap is unknown to the point of being unusable.
type GpuReservation {
  devices: List<NonEmptyStr>
  power_cap_watts: Optional<Watt>
}

fn gpu_reservation_card_count(g: GpuReservation) -> Nat {
  count(g.devices)
}

// A REPLICA'S MEMORY RESERVATION IS A MEASURED FACT OR HONESTLY UNMEASURED -- never a fabricated number. A
// quantity observed carries bytes WITH a provenance naming where they were read; a quantity nobody has read
// yet is Unmeasured, and the width derivation FAILS CLOSED on it rather than charge a made-up figure
// (fail_closed). There is deliberately no "modeled allowance" arm: a conservative placeholder -- least of all
// a zero, the least conservative figure there is -- dressed as data is exactly the fabricated default this
// rule rejects. srv3/srv4 charge their engine's MEASURED cgroup ceiling, consumed from
// gunbc.serving.serving_host_memory (that module's own frontier note says those rows exist to be charged as
// claims); a host with no such read (butch) is Unmeasured, not zero.
type ReplicaMemoryReservation
  = MemoryMeasured { bytes: ByteSize, provenance: String }
  | MemoryUnmeasured { reason: String }

// THE BYTES a reservation COMMITS, as an Optional: a measured figure is Present; an unmeasured one is Absent --
// NEVER a fabricated zero. A total reader that handed back 0 for the unmeasured arm would let any future caller
// price an unmeasured engine at nothing; returning Absent makes that state unwritable at the type, and the fold
// in host_memory_reserved refuses to sum when any replica is Absent, so the width fails closed rather than
// charging a made-up figure (fail_closed).
fn memory_reservation_bytes(m: ReplicaMemoryReservation) -> Optional<ByteSize> {
  match m {
    MemoryMeasured { bytes: b, provenance: _ } => Present { value: b }
    MemoryUnmeasured { reason: _ } => Absent
  }
}

// ── THE REPLICA'S RESERVATION, AND THE HOST'S BIND ───────────────────────────────────────────────────

// WHAT ONE REPLICA TAKES OFF ITS HOST: cores (affinity or exclusive), a memory reservation, and its cards
// with their cap. Every field is a fact a row states; none is derived from a count of co-resident replicas,
// which is what let a per-host verdict wrongly add a second batch-1 engine onto the first.
type ReplicaReservation {
  cpu: CpuReservation
  memory: ReplicaMemoryReservation
  gpu: GpuReservation
}

// THE ADDRESS AN ENGINE BINDS AND THE PORT IT BINDS IT ON. `BindLan` is the address a Strata engine
// listens on so its siblings on the LAN can reach it -- the finding's "engines bind the LAN." `BindLoopback`
// is a local-only engine; `BindAddress` pins an explicit interface. The port is a Nat so a collision
// (two replicas one host gave the same port) is decidable rather than a string-compare accident.
type ServingBindAddress
  = BindLan
  | BindLoopback
  | BindAddress { address: NonEmptyStr }

type ServingBind {
  address: ServingBindAddress
  port: Nat
}

// AN ENGINE BINDS THE LAN: a serving replica's bind must be LAN-addressable to serve, so a loopback-only
// replica is not reachable by the router and is refused by the reachability check below. `BindAddress` on a
// LAN interface counts as binding the LAN.
fn bind_is_lan_reachable(b: ServingBind) -> Bool {
  match b.address {
    BindLan => true
    BindLoopback => false
    BindAddress { address: a } => (a as String) != "127.0.0.1" && (a as String) != "localhost"
  }
}

// ── THE STRATA RELEASE IS PINNED BY ARTIFACT DIGEST, NOT TAGGED "latest" ─────────────────────────────

// THE CONTENT REFERENCE OF THE STRATA ARTIFACT, held as an algorithm and its hex rather than one string to
// be parsed: a producer supplies "sha256" and the hex, so "is this pinned?" is a fact of the carrier and
// not of a parser (gunbc.design_argument::minimize_redundancy). A tag -- "latest", "v1", "nightly" -- is a
// name standing where the content should be (gunbc.design_argument::name_should_match_reality), so it is
// not representable as a digest at all.
type StrataArtifactDigest {
  algorithm: NonEmptyStr
  hex: NonEmptyStr
}

// WHAT A HOST'S STRATA ENGINE ACTUALLY IS, as an immutable artifact. These are genuinely different artifact
// KINDS and are kept distinct (operator ruling, 2026-11-10): a NATIVE checkout is identified by a GIT COMMIT
// (the strata server code, AND SEPARATELY the venv interpreter+packages it runs under -- on srv3/butch these
// are two DIFFERENT clean checkouts, strata-main and strata); a MANAGED RELEASE is an id in a release
// directory (srv4's /opt/gunbc-serving/srv4-daily/releases/<id>, a build chosen by the deploy tool, NOT a git
// commit); and a CONTAINER image is a CONTENT-ADDRESSED IMAGE DIGEST. Collapsing these onto one "hex" field
// would let a host's pin claim the wrong artifact -- pinning a container digest for a host that runs a native
// binary, or a git commit for a host that runs a managed release, is a FALSE pin, worse than no pin because
// it reads as reproducible and is not.
type StrataArtifact
  = StrataNativeGitCommit { checkout: NonEmptyStr, commit: NonEmptyStr }
  | StrataManagedRelease { directory: NonEmptyStr, release_id: NonEmptyStr }
  | StrataContainerImageDigest { digest: StrataArtifactDigest }

// A STRATA RELEASE THE MODEL WILL RUN. `Pinned` carries the artifacts that MAKE UP the running engine (a
// native server may span a code checkout AND a venv checkout, so a list, not one) AND the authority they were
// read from, so a pin is auditable to an observation rather than an assertion. `Unpinned` records a moving
// reference (a tag like "strata:latest", or a build never read off the box) and is refused by every consumer
// that must reproduce a byte-exact engine. Keeping `Unpinned` as a variant -- rather than making a digest
// required -- lets the model NAME a host's current unpinned state and refuse it, more honest than pretending
// every host already has a byte-exact build.
type StrataRelease
  = StrataReleasePinned { artifacts: List<StrataArtifact>, read_from: NonEmptyStr }
  | StrataReleaseUnpinned { reference: NonEmptyStr }

// A digest is content-addressed when it names a real content algorithm; the algorithm is the discriminator,
// because a tag ("latest", "nightly", "v1") is a name, never a content algorithm, and a wrong algorithm is
// refused rather than trusted. Fail closed: an unpinned release is never assumed pinned.
fn strata_digest_is_content_addressed(d: StrataArtifactDigest) -> Bool {
  (d.algorithm as String) == "sha256"
}

// A native checkout is a real pin only when it names a FULL git commit (40 hex): a short sha or a branch name
// is a moving name, not an immutable artifact, and is refused. A managed release names an immutable build in a
// release directory -- a replaced release is a different build (strata_parked_tier: "a replaced release changes
// the build and strands every save"), so a non-empty release id pins. A container image pins when its digest
// names a real content algorithm. Fail closed on each kind.
fn strata_artifact_is_immutable(a: StrataArtifact) -> Bool {
  match a {
    StrataNativeGitCommit { checkout: _, commit: c } => string_length(s: c) == 40
    StrataManagedRelease { directory: _, release_id: _ } => true
    StrataContainerImageDigest { digest: d } => strata_digest_is_content_addressed(d)
  }
}

// A release is pinned only when it names AT LEAST ONE artifact and EVERY artifact it names is immutable: an
// empty pinned list is not a pin (fail_closed -- claiming a build with no artifact is a fabricated pin), and
// one moving component among several must not let the whole release pass.
fn strata_release_is_pinned(r: StrataRelease) -> Bool {
  match r {
    StrataReleasePinned { artifacts: as, read_from: _ } => count(as) > 0 && all(as, a => strata_artifact_is_immutable(a))
    StrataReleaseUnpinned { reference: _ } => false
  }
}

// ── THE WIDTH DERIVATION: EVERY SERVING HOST PAYS FOR THE RESERVATIONS IT RUNS ────────────────────────

// A SERVING HOST'S RESERVATIONS: its identity and the per-replica reservation rows it runs. A host with no
// row is not a serving host in this model; a host with N rows runs N replicas and pays for all of them.
// This is the shape the runner width derivation folds, so the prod-role-only restriction the finding names
// (served_slice_charge keys its charge on the single prod host) cannot recur here: the key is the host's own
// identity, and any host with a row is charged.
type ServingHostReservation {
  host: HostIdentity
  replicas: List<ReplicaReservation>
}

// THE ROSTER OF SERVING HOSTS AND THEIR RESERVATIONS. Extending the fleet is a row here -- the operator's
// "adding the next machine is boring" bar -- never a branch on a machine name in the derivation below.
// srv3 and srv4 run one Strata engine each on an AFFINITY cpuset (pinned to their engine cores, but the
// cores stay bookable by the runner), so they are charged GPU and memory and cost the runner no cores; a
// host that pins its engine EXCLUSIVELY would carry a CpuExclusive row and the width would fall. This is a
// MODEL roster: butch's own rows and the live cpusets land with B4b (cool-lark-40); the rows here are the
// fleet's standing claims, and the derivation reads them all the same.
data serving_host_reservations: List<ServingHostReservation> = [
  // srv3: one Strata engine, its two cards capped, an affinity pin that leaves cores bookable. Its per-engine
  // MEMORY is MEASURED: the engine's cgroup MemoryHigh ceiling, read from its systemd drop-in and held in
  // gunbc.serving.serving_host_memory srv3_strata_engine_memory.memory_cap. That ceiling -- not an invented
  // number, not zero -- is what the runner pool must yield to the engine, so it is charged as a claim (the
  // purpose that corpus row is reserved for); charging zero left srv3's Strata memory bookable to CI (over-book).
  ServingHostReservation {
    host: operator_host_srv3,
    replicas: [
      ReplicaReservation {
        cpu: CpuAffinity { set: CpuRanges { ranges: [ CpuRange { first: 0, last: 7 } ] } },
        memory: MemoryMeasured { bytes: serving_reading_bytes_or_zero(srv3_strata_engine_memory.memory_cap), provenance: "srv3_strata_engine_memory.memory_cap (gunbc.serving.serving_host_memory): strata-pool.service cgroup MemoryHigh, the ceiling the engine cannot exceed; charged so the runner never books memory the serving engine may hold" },
        gpu: GpuReservation { devices: ["GPU-0", "GPU-1"], power_cap_watts: Present { value: watt(count: 40) } },
      },
    ],
  },
  // srv4: one Strata engine, its two cards capped, an affinity pin; memory MEASURED from its own cgroup
  // ceiling in serving_host_memory srv4_serving_engine_memory.memory_cap (gunbc-srv4-daily-engine.service
  // MemoryHigh), charged as a claim just as srv3's is.
  ServingHostReservation {
    host: operator_host_srv4,
    replicas: [
      ReplicaReservation {
        cpu: CpuAffinity { set: CpuRanges { ranges: [ CpuRange { first: 0, last: 7 } ] } },
        memory: MemoryMeasured { bytes: serving_reading_bytes_or_zero(srv4_serving_engine_memory.memory_cap), provenance: "srv4_serving_engine_memory.memory_cap (gunbc.serving.serving_host_memory): gunbc-srv4-daily-engine.service cgroup MemoryHigh, the ceiling the engine cannot exceed; charged as a claim" },
        gpu: GpuReservation { devices: ["GPU-0", "GPU-1"], power_cap_watts: Present { value: watt(count: 40) } },
      },
    ],
  },
  // BUTCH (srv14) -- THE FIRST REAL ROW, AND THE FIRST HOST THAT RUNS TWO REPLICAS. This is the operator's
  // hand-deployed serving host (2026-11-10): strata-pool@a (butch-a) and strata-pool@b (butch-b), one engine
  // each, each holding two of the four A2 cards (0+1 / 2+3) that a2-power-cap.service holds at 35 W. Its
  // cpusets are AFFINITY (the operator's word): 0-39 and 40-79 pin each engine but leave the cores bookable, so
  // butch gives the runner back no cores while still handing over all four cards -- the N-per-host price the
  // finding's per-host code could not express. Its per-engine MEMORY is HONESTLY UNMEASURED: the operator gave
  // ports, cpusets, cards and the 35 W cap, NOT a memory figure, so B4a refuses to invent one -- the row says
  // MemoryUnmeasured and the width derivation FAILS CLOSED on butch until B4b reads the reservation from the
  // box (which is correct: butch is a serving host, and an unmeasured reservation must not be charged as zero).
  // The ports, router cap (2) and sticky count (4) are the ROUTER's facts (RouterDevReplicaNaming /
  // RouterDevUpstream.capacity/retention), not a reservation, so they are not duplicated here.
  ServingHostReservation {
    host: operator_host_srv14,
    replicas: [
      ReplicaReservation {
        cpu: CpuAffinity { set: CpuRanges { ranges: [ CpuRange { first: 0, last: 39 } ] } },
        memory: MemoryUnmeasured { reason: "operator stated butch-a ports/cpusets/cards/35W cap, not a per-engine memory figure; B4b reads it from the running box" },
        gpu: GpuReservation { devices: ["GPU-0", "GPU-1"], power_cap_watts: Present { value: watt(count: 35) } },
      },
      ReplicaReservation {
        cpu: CpuAffinity { set: CpuRanges { ranges: [ CpuRange { first: 40, last: 79 } ] } },
        memory: MemoryUnmeasured { reason: "operator stated butch-b ports/cpusets/cards/35W cap, not a per-engine memory figure; B4b reads it from the running box" },
        gpu: GpuReservation { devices: ["GPU-2", "GPU-3"], power_cap_watts: Present { value: watt(count: 35) } },
      },
    ],
  },
]

fn host_reservations_for(host: HostIdentity) -> Optional<ServingHostReservation> {
  match filter(serving_host_reservations, r => host_identity_eq(r.host, host)) |> first() {
    Present { value: r } => Present { value: r }
    Absent => Absent
  }
}

// HOW MANY CORES A SERVING HOST WITHHOLDS FROM THE RUNNER: the fold of every replica's exclusive cores
// only. An affinity-pinned host gives back zero cores here -- which is the witness, stated.
fn host_cores_withheld_from_runner(host: HostIdentity) -> Nat {
  match host_reservations_for(host) {
    Present { value: r } => fold(r.replicas, init: 0, f: (acc, c) => acc + cpu_reservation_excluded_cores(c.cpu))
    Absent => 0
  }
}

// HOW MUCH MEMORY A SERVING HOST COMMITS TO ITS SERVING REPLICAS, for EVERY serving host -- not the prod-role
// host alone. The width derivation charges this against the host's runner-usable memory the same way
// served_slice_charge charges the prod host's container allowance. It returns Absent when a replica's
// reservation is unmeasured, so the consumer FAILS CLOSED instead of charging a fabricated figure; a host with
// no reservation row is established at zero (it runs no replica, and refusing it would refuse every non-serving
// host). A measured replica contributes its bytes; any unmeasured replica turns the whole host Absent (the fold
// propagates it), so the width fails closed rather than understate a host that runs an unmeasured engine.
fn host_memory_reserved(host: HostIdentity) -> Optional<ByteSize> {
  match host_reservations_for(host) {
    Absent => Present { value: byte_size(count: 0) }
    // Fold the per-replica Optional charges with an accumulating Optional: the running total turns Absent as
    // soon as ANY replica is unmeasured and stays Absent -- the unmeasured state propagates through the fold
    // rather than being caught by a separate predicate afterwards.
    Present { value: r } => fold(
      map(r.replicas, c => memory_reservation_bytes(c.memory)),
      init: Present { value: byte_size(count: 0) },
      f: (acc, charge) => match acc {
        Absent => Absent
        Present { value: a } => match charge {
          Absent => Absent
          Present { value: b } => Present { value: byte_size(count: byte_size_count(b: a) + byte_size_count(b: b)) }
        }
      }
    )
  }
}

// HOW MANY CARDS A SERVING HOST COMMITS TO SERVING, so the runner never counts a serving card as free for
// a GPU CI job on that host.
fn host_gpus_withheld_from_runner(host: HostIdentity) -> Nat {
  match host_reservations_for(host) {
    Present { value: r } => fold(r.replicas, init: 0, f: (acc, c) => acc + gpu_reservation_card_count(c.gpu))
    Absent => 0
  }
}

// THE WIDTH THE RUNNER MAY SPEND ON A SERVING HOST: its total runner cores less the cores its serving
// replicas reserve EXCLUSIVELY. Affinity reservations do not appear here -- a pinned-but-shared cpuset
// leaves the runner whole -- so an engine pinned to cores 0-39 affinitively costs the runner zero of its
// width, while an engine that takes cores 0-39 exclusively costs the runner forty. Fail closed on the
// natural subtraction: if a host's exclusive reservations would exceed its cores, the claim asks a host to
// give back more than it has, which the caller must treat as a refusal rather than a zero.
fn runner_cores_available_on(host: HostIdentity, total_runner_cores: Nat) -> Optional<Nat> {
  let withheld = host_cores_withheld_from_runner(host)
  if withheld <= total_runner_cores {
    Present { value: total_runner_cores - withheld }
  } else {
    Absent
  }
}

// THE DERIVATION'S DECISION, STATED FOR THE WITNESS: a reservation reduces a host's CI width exactly when
// it withholds cores from the runner -- i.e. only when it is exclusive. An affinity-only set does not
// reduce width; an exclusive one does.
fn reservation_reduces_runner_width(res: ReplicaReservation) -> Bool {
  cpu_reservation_excluded_cores(res.cpu) > 0
}

// ── THE ENGINE'S API KEY IS A REFERENCE, NEVER A LITERAL (operator 2026-11-10) ───────────────────────

// HOW A REPLICA'S SERVER-SIDE API KEY IS HELD. The key is a SECRET: the operator carries butch's key host to
// host and never prints it, and a request without it is refused 401 by the engine. So the model must be
// UNABLE to state a literal key -- there is no arm here that carries a secret value at all. `ApiKeyReference`
// names the secret and the path it is read from on the host; the value is resolved at deploy by B4b from
// that path, never from the model. `NoApiKey` records a replica whose key custody is not yet modeled, which
// is honest where an empty string (a "literal" of nothing) would be a lie. A whole host can be added with no
// key modeled and nothing crashes -- the reference simply comes back absent.
type ServingApiKey
  = ApiKeyReference { name: NonEmptyStr, source_path: NonEmptyStr }
  | NoApiKey

type ServingReplicaApiKey {
  host: HostIdentity
  replica: NonEmptyStr
  key: ServingApiKey
}

// ONE KEY CAN COVER SEVERAL REPLICAS: butch-a and butch-b both reference butch's single key at
// ~/strata-pool/api_key (the operator's fact), so the two rows name the SAME reference and the model can say
// "one key, two servers" without ever holding the secret. A host with no row has no key modeled -- srv3/srv4
// custody is B4b's to record -- so they come back absent rather than inventing a path.
data serving_replica_api_keys: List<ServingReplicaApiKey> = [
  ServingReplicaApiKey { host: operator_host_srv14, replica: "butch-a", key: ApiKeyReference { name: "butch-strata-pool", source_path: "~/strata-pool/api_key" } },
  ServingReplicaApiKey { host: operator_host_srv14, replica: "butch-b", key: ApiKeyReference { name: "butch-strata-pool", source_path: "~/strata-pool/api_key" } },
]

fn serving_api_key_for(host: HostIdentity, replica: NonEmptyStr) -> Optional<ServingApiKey> {
  match filter(serving_replica_api_keys, r => host_identity_eq(r.host, host) && (r.replica as String) == (replica as String)) |> first() {
    Present { value: r } => Present { value: r.key }
    Absent => Absent
  }
}

// IS THIS REPLICA'S KEY A REFERENCE (present and secret by construction). Absent -- no row at all -- is false:
// the model says nothing was modeled, which is distinct from a modeled absence and refuses nothing.
fn serving_api_key_is_reference(host: HostIdentity, replica: NonEmptyStr) -> Bool {
  match serving_api_key_for(host: host, replica: replica) {
    Present { value: ApiKeyReference { name: _, source_path: _ } } => true
    Present { value: NoApiKey } => false
    Absent => false
  }
}

// THE PATH A REPLICA'S KEY IS READ FROM, for B4b to resolve at deploy and for the witness to assert two
// replicas share one key. Two replicas reading the same path is "one key covers both servers."
fn serving_api_key_source_path(host: HostIdentity, replica: NonEmptyStr) -> Optional<NonEmptyStr> {
  match serving_api_key_for(host: host, replica: replica) {
    Present { value: ApiKeyReference { name: _, source_path: p } } => Present { value: p }
    Present { value: NoApiKey } => Absent
    Absent => Absent
  }
}

// ── EACH SERVING HOST'S STRATA IS PINNED BY THE DIGEST OF THE BUILD ACTUALLY RUNNING ─────────────────

// WHICH STRATA EACH HOST RUNS. Pinning lives on the host (a data row keyed by the machine), so "butch runs
// the same build as srv3" is two rows naming the SAME commits, not a branch. The running engine is modelled by
// the artifact KIND each host actually runs, read over ssh by smart-crane-730 (2026-11-10 ~20:10Z, clean):
//  - srv3 + butch run the NATIVE strata binary. A native server here spans TWO clean checkouts, so each host
//    pins BOTH as separate StrataNativeGitCommit artifacts: the SERVER CODE in strata-main @ 8c5fafc1fa84d1af1d
//    3f1459ae86fe55d604774c (strata-pool.service runs .venv/bin/python serve/server.py with cwd strata-main),
//    AND the venv INTERPRETER+PACKAGES in a second checkout strata @ 44df8fd5f0b26537009bb6194dc7216cc24d6b93
//    (/home/ubuntu/strata-test/strata/.venv). butch runs the same arrangement under taskset -c CPUS. Pinning
//    only the server code would silently leave the interpreter/packages unpinned, so both are named.
//  - srv4 runs a MANAGED RELEASE: gunbc-srv4-daily-engine.service runs /opt/gunbc-serving/srv4-daily/releases/
//    406c9de18cef/build/strata (bound 127.0.0.1:18080). That release id is already modelled in the corpus --
//    gunbc.serving.serving_layout (strata_srv4 layout + backend), gunbc.serving.strata_parked_tier, and
//    gunbc.serving.serving_host_memory (srv4_serving_engine_memory) all carry 406c9de18cef -- so it is CITED,
//    not refused. It is a release-directory id, a DIFFERENT kind from a git commit, kept in its own arm.
// host_strata_is_pinned is true only where a row names one or more immutable artifacts read from an authority;
// a host with no row, or one left StrataReleaseUnpinned, is not pinned. B4b keeps the authoritative ssh read of
// each box and overrides any row whose build differs -- and never the moving tag "latest".
type ServingHostStrata {
  host: HostIdentity
  strata: StrataRelease
}

data serving_host_strata_releases: List<ServingHostStrata> = [
  ServingHostStrata { host: operator_host_srv3, strata: StrataReleasePinned {
    artifacts: [
      StrataNativeGitCommit { checkout: "strata-main (server code; cwd of strata-pool.service: /home/ubuntu/strata-test/strata-main)", commit: "8c5fafc1fa84d1af1d3f1459ae86fe55d604774c" },
      StrataNativeGitCommit { checkout: "strata (venv interpreter + packages: /home/ubuntu/strata-test/strata/.venv)", commit: "44df8fd5f0b26537009bb6194dc7216cc24d6b93" },
    ],
    read_from: "both checkouts read clean over ssh by smart-crane-730 2026-11-10 ~20:10Z; strata-pool.service runs .venv/bin/python serve/server.py with cwd strata-main",
  } },
  ServingHostStrata { host: operator_host_srv4, strata: StrataReleasePinned {
    artifacts: [
      StrataManagedRelease { directory: "/opt/gunbc-serving/srv4-daily/releases", release_id: "406c9de18cef" },
    ],
    read_from: "gunbc-srv4-daily-engine.service runs /opt/gunbc-serving/srv4-daily/releases/406c9de18cef/build/strata (bound 127.0.0.1:18080), read over ssh by smart-crane-730 2026-11-10 ~20:10Z; the release id 406c9de18cef is already modelled in gunbc.serving.serving_layout / strata_parked_tier / serving_host_memory -- cited, not restated",
  } },
  ServingHostStrata { host: operator_host_srv14, strata: StrataReleasePinned {
    artifacts: [
      StrataNativeGitCommit { checkout: "strata-main (server code; cwd of strata-pool@a/b, /home/ubuntu/strata-test/strata-main)", commit: "8c5fafc1fa84d1af1d3f1459ae86fe55d604774c" },
      StrataNativeGitCommit { checkout: "strata (venv interpreter + packages: /home/ubuntu/strata-test/strata/.venv)", commit: "44df8fd5f0b26537009bb6194dc7216cc24d6b93" },
    ],
    read_from: "strata-pool@a/b under taskset -c CPUS, cwd strata-main 8c5fafc1 clean, venv strata 44df8fd clean, read over ssh by smart-crane-730 2026-11-10 ~20:10Z; same arrangement as srv3",
  } },
]

fn strata_release_for(host: HostIdentity) -> Optional<StrataRelease> {
  match filter(serving_host_strata_releases, r => host_identity_eq(r.host, host)) |> first() {
    Present { value: r } => Present { value: r.strata }
    Absent => Absent
  }
}

// A host's Strata is PINNED only when it is present AND names a content-addressed digest; a host with no row,
// or one that fell back to "latest," is not pinned and any consumer that must reproduce the byte-exact engine
// must refuse it. Fail closed on the natural reading.
fn host_strata_is_pinned(host: HostIdentity) -> Bool {
  match strata_release_for(host) {
    Present { value: r } => strata_release_is_pinned(r)
    Absent => false
  }
}
