// ── ENGINE KIND: who answers, what it loads, which refusals are real ────────────────────────────────
//
// The discriminator the roster keys on. Engine kind decides what a boot probe must wait for, who answers
// /v1/chat/completions, and which refusals are real, so it is a coproduct and not a string: a string can
// spell "vllm " or "strata2" and no type would notice, and the behaviours that differ per engine hang off
// the arms. vLLM answers the OpenAI routes and its own /v1/models, and its refusals are the routes and ids
// it never issued (a 404 on an unknown completion id, an oversized prompt past max_model_len). Strata
// answers its own /v1/* vocabulary, and its slot save/restore answers 501 while the engine runs with
// --batch (extdeps.strata.session_file, serve/server.py:4091) -- a refusal vLLM could not produce, and the
// reason srv4's disk rung must ask Admissibility rather than assume it.

type ServingEngineKind = LilVllm | StrataEngine

// What the replica loads, by engine. The values are the rows their owners hold: srv1's from the topology
// run's identity (Hub checkpoint, revision, KV dtype, image digest) plus the served model id read from the
// startup receipt; a Strata replica's from the artifact whose digests were read, with the standing saying
// WHERE they were read -- the same bytes on another host are a borrowed claim until that host reads them.

type ReplicaModel
  = LilModel {
      // The model id the engine advertises, from its own startup receipt -- never a second literal.
      served_model: NonEmptyStr
      checkpoint: HubRepoId
      checkpoint_revision: NonEmptyStr
      kv_cache_dtype: NonEmptyStr
      // The launch as modelled: profile, hardware profile, LMCache tier environment, engine flags.
      launch: LilServeLaunch
      // The run identity the figures were measured under, so a rate cannot be quoted off its image.
      run: Srv1TopologyRunIdentity
    }
  | StrataModel {
      artifact: ServingArtifact
      // Where the artifact's digests were READ. srv3's are its own; srv4's and h11's rows run the same
      // IQ3_S shards (their anchors say so, from the operator's launches) but the digests were never read
      // on those hosts, and the standing says exactly that rather than letting a borrowed digest read local.
      artifact_standing: CitedFigureStanding
      // The launch flags as a row, where one exists: srv3's are strata_ada_pair_cell's. srv4's and h11's
      // launched flags (batch size, experts mmap/locked) are described in their memory rows but no typed
      // flag row has been read from their systemd units -- Absent with the obligation on its standing,
      // never invented argv.
      flags: Optional<StrataServeFlags>
      flags_standing: Optional<CitedFigureStanding>
    }

// ── THE GPU SET: how many cards, which cards, what kind ─────────────────────────────────────────────
//
// The card rows are the serving_layout grant's own device rows (whose board catalog refs and read vram they
// carry); srv1's cards have no device row because no serving layout models srv1 yet, so srv1's rows are the
// ONE place srv1's silicon is spelled: board catalog refs from extdeps.gpu (the Max-Q and Workstation
// Edition rows the fork's measurement run names), uuids and power cap from srv1's run identity, vram Absent
// because srv1's nvidia-smi memory.total has never been recorded -- datasheet figures do not enter a host
// ledger.

type ReplicaGpuCard {
  // The device name the host enumerates, as its layout or unit names it.
  name: NonEmptyStr
  // The board catalog row that qualifies the silicon (extdeps.gpu), read from the layout's device row where
  // one exists.
  board: DeclarationRef
  // The card's memory AS READ on that host. Absent where unread -- an obligation, never a datasheet.
  vram: Optional<ServingMemoryReading>
  // The card's power cap as launched (srv1's run row: 300 W each). Absent where unread.
  power_cap: Optional<Watt>
  // The card's UUID as nvidia-smi prints it -- docker's --device word and the CDI selector are built from
  // it, so srv1_serving_replica_layout asks THIS row for it instead of keeping its own copy. Where a host's
  // layout names cards by bus or slot instead, Absent.
  uuid: Optional<NonEmptyStr>
  // The PCI bus id, where the host's own records name the card by it (srv1's two cards, 0001:01:00.0 and
  // 0004:01:00.0). Absent where unread.
  pci_bus: Optional<NonEmptyStr>
}

// A card as its host's serving_layout grant already models it: the device row is the owner of name, board
// and read vram, so a profile card for srv3/srv4/h11 DERIVES from it -- no figure is retyped.
fn card_of(d: ServingDevice) -> ReplicaGpuCard {
  ReplicaGpuCard {
    name: d.device,
    board: d.board,
    vram: Present { value: d.vram },
    power_cap: Absent,
    uuid: Absent,
    pci_bus: Absent,
  }
}

// How the replica's cards are used. A replica is ONE engine; a deployment of several replicas (srv1's pair)
// is several ROWS -- data parallelism lives in the roster's count of rows, never in a replica's shape.
// A tensor-parallel engine is a different candidate: srv1_topology_comparison measured 2xTP=1 against TP=2
// and is the only source for those figures, and no live replica runs TP=2, so no row claims one. When one
// runs, ReplicaAcrossDevices is its home, added together with its measurement.
type ReplicaParallelism
  = ReplicaOnOneDevice
  | ReplicaAcrossDevices {
      // One engine spanning the group -- Strata's layer split across the pair. The split boundary itself
      // lives in the engine's launch flags (srv3's StrataServeFlags split at 24), never re-spelled here;
      // where flags are unread the boundary is simply not claimed.
      devices: Nat
    }

// ── THE FIGURES: read on the row, or resolved from the measurement module ────────────────────────────
//
// A deployment MEASURED as a pair (srv1's two TP=1 replicas were benchmarked together -- the aggregate and
// the sessions are the PAIR's) carries a coordinate into srv1_topology_comparison rather than a copied
// figure, because the reading's owner is that module and a later receipt must not be able to detach the
// rate from the context and topology it was read at. A replica measured alone carries its figures on the
// row -- which is what serving_capacity_anchor did per anchor row before those rows moved here.

type ReplicaFigures
  = FiguresAtCoordinate {
      // The pair reading to resolve: aggregate decode, sessions and context all come from that one row.
      topology: ServingTopology
      sessions: Nat
    }
  | FiguresOnRow {
      // The context the throughput and cold-prefill figures below were read at. It travels with them so a
      // consumer cannot pair a rate with the wrong window.
      context: TokenCount
      // The host's aggregate decode at that context, at the concurrency it was read at.
      throughput: ServingThroughput
      // The cold re-read rate a store miss pays, with its standing.
      cold_prefill: Optional<TokensPerSecond>
      cold_prefill_standing: CitedFigureStanding
    }
  // A configuration the fleet has NEVER run has no figures, and the honest field is the reading it needs, not
  // a neighbour's rate. srv3 with a slot-file disk rung and srv4 at batch 8 are real candidates the operator
  // may choose between, and neither has ever been measured. Naming the reading is what lets the selector
  // answer SelectionNeedsEvidence with an obligation instead of a rate lifted off another host.
  | FiguresUnmeasured { obligation: NonEmptyStr }

// ── THE PROFILE ──────────────────────────────────────────────────────────────────────────────────────

type ServingReplicaProfile {
  // The row's id: the deployment name its anchor carries and the router prints. Router, anchor and roster
  // agree on a deployment because they read the same row, not because a caller passed a matching string.
  id: NonEmptyStr
  host: HostIdentity
  engine_kind: ServingEngineKind
  model: ReplicaModel
  gpu: List<ReplicaGpuCard>
  parallelism: ReplicaParallelism
  // The context window the replica launches with: the fleet-wide cap, whose owner is
  // gunbc.serving.serving_context_cap -- vLLM's --max-model-len flag and Strata's max_context flag both
  // render the same row, so the launch honours the pool's cap without repeating it.
  context_window: TokenCount
  figures: ReplicaFigures
  // The warm ladder, hottest first, built by serving_capacity_anchor's own constructors -- so mechanism and
  // durability are typed on every rung, not remembered per host. Durability decides what a host may still
  // hold across a restart; mechanism prices the save. serving_capacity_anchor's FRONTIER note names this
  // roster and its selector as the consumer those two fields were carried for; readers live below.
  // Empty means no warm tier was ever read -- a refusal downstream, never a zero.
  warm_ladder: List<ServingWarmSwap>
  // What the host's layout admits this replica to hold warm. GrantUnmodeled where no serving layout models
  // the host (srv1 today; its obligation says whose job that is).
  grant: ServingRetentionGrant
  // The engine's own memory row, for consumers that price its cache: WHICH serving_host_memory row belongs
  // to this replica. Absent where the host models no engine memory row at all.
  engine_memory: Optional<ServingEngineMemory>
  // WHERE THE WEIGHTS AND EXPERTS SIT, as the host's serving layout models the artifact: its device rung is
  // the bytes on the card, its host_ram rung the bytes in host memory (pinned by a lock service, or evictable
  // under a cgroup cap with a floor -- the artifact's own hold decides which), its disk rung the bytes a miss
  // reads through. Strata's --mmap-experts under the engine cgroup cap is the disk-backed expert tier; h11's
  // strata-expert-lock mlock is the RAM-locked one. Absent where no layout models the host's artifact row --
  // srv1's vLLM loads its checkpoint onto the cards and no artifact row says so yet, so its placement is an
  // OBLIGATION, not a free pass: the host-RAM charge below refuses rather than charging nothing.
  expert_artifact: Optional<ServingSharedArtifact>
  // The host's monthly price as billed, with its standing. NO MONTHLY PRICE HAS BEEN READ for any host in
  // this roster: srv1 is the operator's own card, srv3/srv4/h11 are the operator's accounts, and no bill is
  // in the repo. The selector keeps it an UNFUNDED axis -- an optional axis that never participates until a
  // bill is read and lands here, cited. Host cost is decided by what the profile charges (the readers
  // below), not by a bill that cannot be read for owned hardware.
  monthly_cost: Optional<MoneyAmountMicro>
  monthly_cost_standing: Optional<CitedFigureStanding>
}

fn borrowed(o: String) -> CitedFigureStanding { TranscribedUncited { read_obligation: o as NonEmptyStr } }

// ── READERS THE CONSUMERS USE ────────────────────────────────────────────────────────────────────────

// The replica's card count: DERIVED from the card rows, never stored beside them (a number read is not a
// number derived, and a stored count could disagree with the cards it counts).
fn replica_gpu_count(p: ServingReplicaProfile) -> Nat { p.gpu.length() }

// The card's NVIDIA UUID, where the host's records name the card by one: srv1's --device word and CDI
// selector are built from it, and srv1_serving_replica_layout asks HERE for it -- the spec row no longer
// keeps its own copy. Absent where the host's layout identifies cards by bus or slot instead.
fn replica_gpu_uuid(p: ServingReplicaProfile) -> Optional<NonEmptyStr> {
  match p.gpu.first() {
    Absent => Absent
    Present { value: c } => c.uuid
  }
}

// The replica's GPU kind: the board every card carries. A replica whose cards disagree in board is a row
// bug -- the reader refuses it (Absent) rather than answering with whichever card came first.
fn replica_gpu_board(p: ServingReplicaProfile) -> Optional<DeclarationRef> {
  match p.gpu.first() {
    Absent => Absent
    Present { value: first } =>
      if fold(p.gpu.skip(n: 1), init: true, f: (acc, c) =>
        acc && declaration_ref_identity(reference: c.board).digest == declaration_ref_identity(reference: first.board).digest) {
        Present { value: first.board }
      } else {
        Absent
      }
  }
}

// Does a restart leave anything warm? A rung whose durability is SurvivesProcessRestart means the host may
// still hold what that rung holds across a restart (a saved slot file comes back); a ladder whose every
// rung is LostWithProcess means a restart takes the whole warm tier with it and only the cold re-read
// remains. This is the field serving_capacity_anchor's FRONTIER note said would decide "what a host may
// still hold across a restart" -- here is that read.
fn replica_survives_restart(p: ServingReplicaProfile) -> Bool {
  fold(p.warm_ladder, init: false, f: (acc, r) => acc || match r {
    WarmSwapRestores { durability: SurvivesProcessRestart } => true
    _ => false
  })
}

// The mechanisms this ladder prices the save through, hottest first -- the FRONTIER note's other read:
// engine eviction costs what the engine's own cache costs, a router slot file costs what the drive takes.
// The DISTINCT mechanisms the ladder's rungs warm through, hottest first: srv1's two rungs are both LMCache
// eviction, so the answer is one mechanism over two tiers rather than the same word twice. Distinctness is
// what makes this list a claim about the replica (which mechanisms it depends on) rather than a restatement of
// the ladder's length.
fn replica_warm_mechanisms(p: ServingReplicaProfile) -> List<ServingSwapMechanism> {
  fold(p.warm_ladder, init: [] as List<ServingSwapMechanism>, f: (acc, r) => match r {
    WarmSwapRestores { mechanism: m } =>
      if acc.any(seen => seen == m) {
        acc
      } else {
        concat(acc, [m])
      }
    _ => acc
  })
}

// THE BETS THIS REPLICA'S WARM RUNGS ARE ADMITTED ON -- read off the ladder, not kept beside it. A rung's
// admission_standings are what it was admitted on (the same carrier as its figure standing, so a cited fact
// and an uncited bet share one type): srv4's disk rung carries the engine-build match the adapter assumed,
// and a host whose rungs admitted on read evidence -- srv1's own disk tier -- answers with nothing. There is
// no second list of bets on the row, because a list kept beside the ladder is a list that goes stale alone.
fn replica_assumed_admission(p: ServingReplicaProfile) -> List<CitedFigureStanding> {
  fold(p.warm_ladder, init: [], f: (acc, r) => match r {
    WarmSwapRestores { admission_standings: a } => concat(acc, a)
    _ => acc
  })
}

// The host's aggregate figures, resolved: a coordinate resolves against srv1_topology_comparison; on-row
// figures answer themselves. Absent means the coordinate has no reading -- which refuses the anchor below
// rather than quoting a stale rate.
type ResolvedFigures {
  context: TokenCount
  throughput: ServingThroughput
  cold_prefill: Optional<TokensPerSecond>
  cold_prefill_standing: CitedFigureStanding
}

// One resolver for a roster row AND for a candidate configuration, so the run-keying rule lives once. An
// on-row figure is the host's own reading and travels with its standing; a coordinate figure is looked up in
// the reading table AND checked against the identity the caller runs under -- see the run-identity section
// below. A mismatch resolves Absent: the reading stops matching, it is never re-scaled or borrowed.
fn resolve_replica_figures(figures: ReplicaFigures, live: Optional<ReplicaRunIdentity>) -> Optional<ResolvedFigures> {
  match figures {
    FiguresOnRow { context: c, throughput: t, cold_prefill: cp, cold_prefill_standing: cps } =>
      Present { value: ResolvedFigures { context: c, throughput: t, cold_prefill: cp, cold_prefill_standing: cps } }
    // Never run: nothing to resolve, and the obligation names the reading that would settle it.
    FiguresUnmeasured { obligation: obligation } => Absent
    FiguresAtCoordinate { topology: t, sessions: s } => match srv1_topology_reading(topology: t, sessions: s) {
      Absent => Absent
      Present { value: r } => match live {
        // No identity to check against is not a pass. A coordinate reading borrowed by a host whose
        // checkpoint, quant, engine, wiring or cap nobody can state is the silent borrow the keying exists to
        // stop, and fail_closed puts it away rather than pricing the row on a hope.
        Absent => Absent
        Present { value: want } => match replica_run_identity_match(want: want, taken: r.run) {
          ReplicaRunIdentityMatch { agrees: false, reasons: reasons, unchecked: unchecked } => Absent
          ReplicaRunIdentityMatch { agrees: true, reasons: reasons, unchecked: unchecked } => Present { value: ResolvedFigures {
            context: r.context,
            throughput: ThroughputOperatorReading { tokens_per_second: r.aggregate_output, at_concurrency: r.sessions, standing: r.standing },
            // srv1's cold prefill is the Max-Q fork's 128k prefill reading, resolved from its owner module --
            // the same resolution serving_capacity_anchor's anchor row performed before it moved here.
            cold_prefill: fork_cold_prefill_128k(),
            cold_prefill_standing: borrowed(o: "fork_prefill_readings cold prefill at 128k on the Max-Q fork"),
          } }
        }
      }
    }
  }
}

fn replica_figures_resolved(p: ServingReplicaProfile) -> Optional<ResolvedFigures> {
  resolve_replica_figures(figures: p.figures, live: replica_run_identity(p: p))
}

// The per-replica figures for a deployment of `width` replicas sharing one measured aggregate (srv1's pair):
// the aggregate and sessions divided across the replicas -- divided, never halved by hand. The caller reads
// the width from the roster: how many rows share this host and deployment family.
fn replica_throughput(p: ServingReplicaProfile, width: Nat) -> ServingThroughput {
  match replica_figures_resolved(p) {
    Absent => ThroughputUnread
    Present { value: f } => divide_reading(t: f.throughput, width: width)
  }
}

// One aggregate shared by `width` replicas: the rate and the session count both divide, so a replica never
// claims more than the run measured. An unread rate stays unread through the division.
fn divide_reading(t: ServingThroughput, width: Nat) -> ServingThroughput {
  match t {
    ThroughputUnread => ThroughputUnread
    ThroughputOperatorReading { tokens_per_second: tps, at_concurrency: n, standing: s } =>
      ThroughputOperatorReading {
        tokens_per_second: tokens_per_second(count: tokens_per_second_count(r: tps) / width),
        at_concurrency: n / width,
        standing: s,
      }
  }
}

// How many replicas share a coordinate's aggregate: the data-parallel width the reading was taken at (srv1's
// pair shares ONE 2xTP=1 run, so each answers with half of it). Figures written on a row are already that
// replica's own, so the width there is one and the division is the identity.
fn replica_share_width(p: ServingReplicaProfile) -> Nat {
  match p.figures {
    FiguresAtCoordinate { topology: t } => topology_dp(t: t)
    FiguresOnRow { } => 1
    // Never measured: nothing is shared, because nothing is claimed. The width only ever divides a rate that
    // exists, so for an unmeasured row it is the identity and the absence carries the refusal.
    FiguresUnmeasured { obligation: obligation } => 1
  }
}

// The anchor this profile answers with: the row's fields, handed to the anchor module's shape machinery.
// A coordinate with no reading refuses, naming its owner module -- nothing here fabricates a rate.
fn replica_anchor(p: ServingReplicaProfile) -> ServingCapacityAnchor {
  replica_anchor_named(p: p, deployment: p.id as String)
}

// The anchor with the deployment NAME the caller's join carries (the router names replicas as it joins them;
// the roster row is the source for everything the name is not).
fn replica_anchor_named(p: ServingReplicaProfile, deployment: String) -> ServingCapacityAnchor {
  match replica_figures_resolved(p) {
    Absent => ServingCapacityAnchor {
      // The refusal rides the anchor's own unread paths: an unread throughput refuses the shape
      // (serving_capacity_anchor), and the obligation names the missing reading.
      deployment: deployment as NonEmptyStr,
      grant: p.grant,
      context: match p.figures {
        FiguresOnRow { context: c } => c
        // A coordinate, and a configuration never measured at all, are both quoted at the fleet's window: the
        // anchor is about the operating point, and the missing reading is what refuses it, not the label.
        FiguresAtCoordinate { } => serving_fleet_context_cap
        FiguresUnmeasured { obligation: obligation } => serving_fleet_context_cap
      },
      throughput: ThroughputUnread,
      cold_prefill: Absent,
      cold_prefill_standing: borrowed(o: "no reading in gunbc.serving.srv1_topology_comparison at this replica's topology and session count"),
      warm_swap: p.warm_ladder,
    }
    Present { value: f } => ServingCapacityAnchor {
      deployment: deployment as NonEmptyStr,
      grant: p.grant,
      context: f.context,
      throughput: divide_reading(t: f.throughput, width: replica_share_width(p: p)),
      cold_prefill: f.cold_prefill,
      cold_prefill_standing: f.cold_prefill_standing,
      warm_swap: p.warm_ladder,
    }
  }
}

// The shape the fleet asks the anchor for, from the row.
fn replica_shape(p: ServingReplicaProfile) -> ServingCapacityShape {
  replica_shape_named(p: p, deployment: p.id as String)
}

fn replica_shape_named(p: ServingReplicaProfile, deployment: String) -> ServingCapacityShape {
  serving_capacity_shape(a: replica_anchor_named(p: p, deployment: deployment), p: serving_conversation_policy)
}

// srv1's cold prefill: the fork's 128k reading, resolved from the module that owns the readings.
fn fork_cold_prefill_128k() -> Optional<TokensPerSecond> {
  fold(fork_prefill_readings, init: Absent, f: (acc, r) =>
    if r.label == "cold prefill, 128k" { Present { value: r.tokens_per_second } } else { acc })
}

// ── THE ROSTER ───────────────────────────────────────────────────────────────────────────────────────
//
// Every replica that runs, as it runs -- the same rule the Strata layouts state: describe what is live, not
// the target batch. srv1 x2 vLLM TP=1 (the pair srv1_topology_comparison measured), srv3 and srv4 Strata
// one engine across their RTX 2000 Ada pair each, and h11's four in-service A16 engines one row apiece
// (their buses are the ones the grant lists; the disabled ones are not rows because they run nothing).

// srv1's two TP=1 vLLM replicas, one per RTX PRO 6000 (operator, 2026-11-08, on gunbc.serving.srv1_topology_comparison:
// two replicas out-produced one TP=2 engine ~2.3x at 8 warm 150k sessions). Each replica's figures are that
// run's 2xTP=1 reading resolved by coordinate -- aggregate, sessions and context from the one row, divided
// across the pair by replica_throughput with the width read from the reading's own topology. The two cards
// differ (Max-Q and Workstation Edition, both capped at the run's 300 W), so the board is spelled per row,
// ONCE. Each replica keeps its own LMCache disk tier (L2, evicting above its watermark) restored in ~156 ms
// p50 on the single-card launch (serve.log RETRIEVE finish, 203 restores, 2026-11-08); its bytes and
// per-conversation cost are serving_host_memory rows.
fn srv1_replica_profile(
  id: String,
  card_name: String,
  card_uuid: String,
  card_pci: String,
  board: DeclarationRef,
) -> ServingReplicaProfile {
  srv1_replica_profile_as(
    id: id,
    card_name: card_name,
    card_uuid: card_uuid,
    card_pci: card_pci,
    board: board,
    kv_dtype_instead: Absent,
    power_cap_instead: Absent,
  )
}

// THE SAME ROW WITH ITS RUN IDENTITY VARIED IN ONE STATED FIELD. Both real srv1 rows come through
// srv1_replica_profile above, which passes Absent for both and so gets the run's own KV dtype and cap. The
// witnesses that have to PROVE a mismatched reading stops matching -- change the KV quantization, or the power
// cap, and the figure refuses -- need a profile differing from the readings in exactly one field and nothing
// else; hand-writing a whole row to change one value would let the test drift from the row it is testing.
fn srv1_replica_profile_as(
  id: String,
  card_name: String,
  card_uuid: String,
  card_pci: String,
  board: DeclarationRef,
  kv_dtype_instead: Optional<NonEmptyStr>,
  power_cap_instead: Optional<Watt>,
) -> ServingReplicaProfile {
  ServingReplicaProfile {
    id: id as NonEmptyStr,
    host: operator_host_srv1,
    engine_kind: LilVllm,
    model: LilModel {
      served_model: srv1_serving_startup_reading.served_model_name,
      checkpoint: srv1_topology_run.checkpoint,
      checkpoint_revision: srv1_topology_run.checkpoint_revision,
      kv_cache_dtype: kv_dtype_or(own: srv1_topology_run.kv_cache_dtype, instead: kv_dtype_instead),
      launch: srv1_serving_launch,
      run: srv1_topology_run,
    },
    gpu: [ReplicaGpuCard {
      name: card_name as NonEmptyStr,
      board: board,
      vram: Absent,
      power_cap: Present { value: cap_or(own: srv1_topology_run.power_cap_each, instead: power_cap_instead) },
      // The card's UUID is its identity on srv1 -- docker's --device word and the CDI selector are built
      // from it, and srv1_serving_replica_layout asks THIS row for it instead of keeping its own copy.
      uuid: Present { value: card_uuid as NonEmptyStr },
      pci_bus: Present { value: card_pci as NonEmptyStr },
    }],
    parallelism: ReplicaOnOneDevice,
    context_window: serving_fleet_context_cap,
    figures: FiguresAtCoordinate { topology: srv1_layout(tp: 1, dp: 2), sessions: 8 },
    // THE WARM LADDER, hottest first: LMCache's L1 in host RAM, then its L2 on disk. LMCache keeps a
    // conversation in the 12 GiB host-RAM tier and evicts from it by its own policy, so a restart loses what
    // only L1 held (LostWithProcess); its L2 -- 125 GiB per replica kept at the 0.80 eviction watermark --
    // is a file on the host, so what L2 holds survives a process restart. L2 is INCLUSIVE of L1: what L1
    // holds, L2 holds too, so the held bound takes the max across the two rungs and never adds their bytes
    // (a conversation resident in RAM is also on disk; adding would over-promise).
    warm_ladder: [
      WarmSwapRestores {
        tier: SwapTierHostRam,
        mechanism: SwapByEngineEviction,
        durability: LostWithProcess,
        // The hottest rung: nothing above it to share with, so it adds to the empty tally.
        sharing: RungAdds,
        // The same cited retrieve p50 as the disk rung below: srv1's serve.log logs LMCache's RETRIEVE
        // completions without naming the tier that served them, so both rungs cite this one reading rather
        // than each claiming a tier-specific number nobody read.
        restore: millisecond(count: 156),
        cache: srv1_lmcache_l1_tier,
        slots: Absent,
        // The same conversation as the disk rung, so the same per-conversation cost row -- one authority for
        // what a conversation costs, read off the KV pool.
        cost: srv1_vllm_disk_snapshot_cost,
        standing: borrowed(o: "srv1 serve.log LMCache RETRIEVE finish_acknowledged p50 156 ms over 203 restores, 2026-11-08; the lines do not name the serving tier, and restored sizes are unread"),
        // The tier's existence and size are read (LMCACHE_L1_GB=12 in the run identity's environment,
        // corroborated by the launch script); LMCache evicts by its own watermark. Nothing here is an
        // unread basis, so no admission bet rides on it.
        admission_standings: [],
      },
      WarmSwapRestores {
        tier: SwapTierDisk,
        mechanism: SwapByEngineEviction,
        durability: SurvivesProcessRestart,
        // Inclusive of the hotter rung (see above), stated rather than left to the default.
        sharing: RungInclusiveOfHotter,
        restore: millisecond(count: 156),
        cache: srv1_vllm_disk_tier,
        slots: Absent,
        cost: srv1_vllm_disk_snapshot_cost,
        standing: borrowed(o: "srv1 serve.log LMCache RETRIEVE finish_acknowledged p50 156 ms over 203 restores, 2026-11-08; restored sizes unread"),
        // LMCache evicts by its own watermark and the restore time is cited to the serve.log, so nothing this
        // rung is admitted on is an unread basis: no admission bet rides on a claim no one checked.
        admission_standings: [],
      },
    ],
    grant: GrantUnmodeled { obligation: "no serving layout models srv1's vLLM replicas (their LMCache tiers inside srv1's shared-host budget)" as NonEmptyStr },
    // srv1's container memory row, kept for its BASE (anonymous) figure, which the host-impact charge below
    // needs. Its conversation_cache is the STALE 2026-10-30 reading (L1_GB=100, GB taken as 10^9, unconfirmed):
    // what charges host RAM for this replica is the ladder's L1 rung, cited to the 2026-11-08 environment. The
    // base is unread until the container's next start, so the RAM charge fails closed rather than guessing.
    engine_memory: Present { value: srv1_vllm_engine_memory },
    // No serving_layout artifact row models how vLLM places srv1's checkpoint (the container loads it onto its
    // card; nothing says whether it mlocks or map()s, and nvidia-smi's per-card used bytes were never
    // recorded). So the expert placement is unmodeled and its RAM charge is an obligation, not a zero.
    expert_artifact: Absent,
    monthly_cost: Absent,
    monthly_cost_standing: Absent,
    // Nothing about srv1's rungs is assumed on the admission path: LMCache evicts by its own watermark and
    // the restore times are cited to the serve.log, so no admission bet rides on a claim no one checked.
  }
}

// The two identity fields a witness may vary, defaulting to the run's own reading.
fn kv_dtype_or(own: NonEmptyStr, instead: Optional<NonEmptyStr>) -> NonEmptyStr {
  match instead {
    Absent => own,
    Present { value: value } => value,
  }
}

fn cap_or(own: Watt, instead: Optional<Watt>) -> Watt {
  match instead {
    Absent => own,
    Present { value: value } => value,
  }
}

data srv1_vllm_replica_0_profile: ServingReplicaProfile = srv1_replica_profile(
  // The deployment name the anchor carries AND the router prints as this replica's upstream:
  // one row, one name (srv1_serving_replica_layout derives the spec label from this row, so the two cannot
  // drift into "srv1-vllm" here and "srv1-vllm-0" there).
  id: "srv1-vllm",
  card_name: "srv1-gpu-maxq",
  card_uuid: "GPU-7b58568e-8bc9-4e4b-bc6c-c414b08936c3",
  card_pci: "0001:01:00.0",
  board: decl_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_max_q_board_catalog"),
)

data srv1_vllm_replica_1_profile: ServingReplicaProfile = srv1_replica_profile(
  id: "srv1-vllm-1",
  card_name: "srv1-gpu-workstation",
  card_uuid: "GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750",
  card_pci: "0004:01:00.0",
  board: decl_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_workstation_board_catalog"),
)

// srv3's Strata on two RTX 2000 Ada (iq3_s), one engine across the pair. Its engine log
// (~/strata-pool/engine.log, read 2026-11-08) shows the engine gains nothing from batching: one turn decodes
// at ~30 tok/s at 100-125k (median of 798 turns), and windows with two groups in flight run ~26 tok/s in
// aggregate (median of 3,657). A miss re-reads cold at ~838 tok/s (median of 3,496 cold turns). Strata parks
// a conversation in host RAM and restores it in ~150-300 ms for 64-131k tokens; its cache bytes and slots are
// its serving_host_memory row. Its cards are srv3's grant's device rows, its grant the layout's.
data srv3_strata_profile: ServingReplicaProfile = ServingReplicaProfile {
  id: "srv3-strata",
  host: operator_host_srv3,
  engine_kind: StrataEngine,
  model: StrataModel {
    artifact: srv3_iq3_s_artifact,
    artifact_standing: borrowed(o: "srv3's own artifact digests, read on srv3 (strata_ada_pair_cell srv3_iq3_s_artifact)"),
    flags: Present { value: srv3_strata_flags },
    flags_standing: Present { value: borrowed(o: "srv3's flags are the benchmark cell's launched flags (strata_ada_pair_cell srv3_strata_flags); re-read from the live unit") },
  },
  gpu: map(srv3_grant.devices, d => card_of(d: d)),
  parallelism: ReplicaAcrossDevices { devices: srv3_grant.devices.length() },
  context_window: serving_fleet_context_cap,
  figures: FiguresOnRow {
    context: token_count(count: 100000),
    throughput: ThroughputOperatorReading { tokens_per_second: tokens_per_second(count: 26), at_concurrency: 2, standing: borrowed(o: "srv3 engine.log 'strata batch (pipelined, 2 groups)' rows/s median 26.3 over 3,657 windows, mixed context, 2026-11-08") },
    cold_prefill: Present { value: tokens_per_second(count: 838) },
    cold_prefill_standing: borrowed(o: "srv3 engine.log cold turns (0 reused, >20k read) median 838 tok/s over 3,496, 2026-11-08"),
  },
  warm_ladder: [engine_warm_swap(e: srv3_strata_engine_memory, cost: srv3_strata_snapshot_cost, restore: millisecond(count: 300), standing: borrowed(o: "srv3 engine.log 'slot takes N tokens (copied in M ms)': 148-296 ms for 64-131k tokens, 2026-11-08"))],
  grant: single_replica_grant(layout: srv3_layout, deployment: "srv3-strata"),
  engine_memory: Present { value: srv3_strata_engine_memory },
  // WHERE SRV3'S EXPERTS SIT: the layout's artifact row decides -- a device rung on each card, a host-RAM rung
  // the engine holds itself (private anonymous, nothing maps it, so nothing can reclaim it: that is a PIN, in
  // all but name), and the GGUF on disk as the source tier. The host-RAM rung is what the selector charges.
  expert_artifact: Present { value: srv3_routed_expert_artifact },
  monthly_cost: Absent,
  monthly_cost_standing: Absent,
}

// srv4's Strata: the same card pair and model as srv3, launched for one turn at a time (its unit is "one
// turn, checkpoint capable"). Its own engine log is root-only, so its rates are BORROWED from srv3 and say
// so; its cache bytes and slots are its serving_host_memory row. THE LADDER, HOTTEST FIRST: the engine's own
// RAM conversation cache (its slots, engine eviction, lost with the process) and UNDER IT the disk rung the
// router drives through the slot-file endpoint -- inclusive of the RAM rung, not additive (a conversation the
// router saved may still sit in the RAM cache). The disk rung's restore time is an ASSUMPTION with a read
// obligation -- the operator declined the measurement ("i think it'll be fine") -- and srv4's admission also
// rests on the ENGINE BUILD matching the one that saved the slot files, which no one has read since the last
// redeploy. Both bets are named in assumed_admission below, not baked into any figure.
data srv4_strata_profile: ServingReplicaProfile = ServingReplicaProfile {
  id: "srv4-strata",
  host: operator_host_srv4,
  engine_kind: StrataEngine,
  model: StrataModel {
    artifact: srv3_iq3_s_artifact,
    artifact_standing: borrowed(o: "BORROWED: srv4 runs the same IQ3_S shards as srv3 and its digest was read THERE; read srv4's own artifact digests before quoting srv4's model as verified"),
    flags: Absent,
    flags_standing: Present { value: borrowed(o: "srv4's launched flags (--batch 8, experts mmap) are described in its serving_host_memory rows and operator notes; read the live unit's ExecStart before quoting flags") },
  },
  gpu: map(srv4_grant.devices, d => card_of(d: d)),
  parallelism: ReplicaAcrossDevices { devices: srv4_grant.devices.length() },
  context_window: serving_fleet_context_cap,
  figures: FiguresOnRow {
    context: token_count(count: 100000),
    throughput: ThroughputOperatorReading { tokens_per_second: tokens_per_second(count: 30), at_concurrency: 1, standing: borrowed(o: "borrowed from srv3 (same RTX 2000 Ada pair and iq3_s): one turn at 100-125k decodes ~30 tok/s; read srv4's own engine log") },
    cold_prefill: Present { value: tokens_per_second(count: 838) },
    cold_prefill_standing: borrowed(o: "borrowed from srv3's cold turns; read srv4's own"),
  },
  warm_ladder: [
    engine_warm_swap(e: srv4_serving_engine_memory, cost: srv4_strata_snapshot_cost, restore: millisecond(count: 300), standing: borrowed(o: "borrowed from srv3's restore times; read srv4's own")),
    slot_file_warm_swap(admissible: strata_warm_admission(v: srv4_strata_rung_admissible()), budget: srv4_strata_parked_budget, cost: srv4_strata_snapshot_cost, restore: millisecond(count: 1500), standing: TranscribedUncited { read_obligation: "no save/restore timing exists for srv4 slot files: the operator declined the measurement, so 1500 ms is derived from the declared snapshot cost against the 2.50 GB/s drive plus deserialization. Read a save and a restore of a ~100k-context conversation on srv4 against the immutable model and quote the milliseconds; until then this rung's contribution is an estimate" as NonEmptyStr }, durability: SurvivesProcessRestart),
  ],
  grant: single_replica_grant(layout: srv4_layout, deployment: "srv4-strata"),
  engine_memory: Present { value: srv4_serving_engine_memory },
  // WHERE SRV4'S EXPERTS SIT: --mmap-experts under the engine's cgroup cap, which is the disk-backed expert
  // tier with a capped RAM rung in front of it -- evictable down to its read floor, so the host can take the
  // bytes back. The layout's row states the cap, the floor and the shards; this row points at it.
  expert_artifact: Present { value: srv4_routed_expert_artifact },
  monthly_cost: Absent,
  monthly_cost_standing: Absent,
}

// One h11 Strata engine on one A16 GPU (iq3_s), one per in-service bus: ~12 tok/s single stream (the
// router's note: 10-13 warm tok/s at 200k on a 16 GB engine; 100k is at least that), one turn at a time (one
// slot), and a cold re-read of 50-115k tokens takes 4-9 minutes (~210 tok/s). Its warm tier is host RAM, read
// from the engine's launched memory row for its bus (serving_host_memory host_6ce85c_engine_as_launched).
// The grant admits one conversation per engine (the operator's four-engine ruling: four engines that each
// park one conversation beat six that skip every park) -- the grant row is the owner and its
// admitted figure is asked here, not copied.
fn h11_strata_profile(bus: String) -> ServingReplicaProfile {
  let engine = host_6ce85c_engine_as_launched(bus: bus)
  // The grant admits what the engine's OWN launched row says it slots: the four-engine ruling was four
  // engines that each park one conversation, and the slot count belongs to the engine row, not to this
  // roster. Unread slots means no warm tier is admitted -- GrantUnmodeled with the obligation.
  h11_strata_profile_with_grant(
    bus: bus,
    launch_grant: match engine.conversation_slots {
      Absent => GrantUnmodeled { obligation: "h11's engine row for this bus has not been read its conversation_slots; read the live unit before quoting its grant" as NonEmptyStr }
      Present { value: n } => GrantAdmits { conversations: n }
    },
  )
}

fn h11_strata_profile_with_grant(bus: String, launch_grant: ServingRetentionGrant) -> ServingReplicaProfile {
  let engine = host_6ce85c_engine_as_launched(bus: bus)
  let card = filter(host_6ce85c_grant.devices, d => d.device == ("a16-" + bus))
  ServingReplicaProfile {
    id: ("h11-strata-" + bus) as NonEmptyStr,
    host: operator_host_6ce85c,
    engine_kind: StrataEngine,
    model: StrataModel {
      artifact: srv3_iq3_s_artifact,
      artifact_standing: borrowed(o: "BORROWED: h11 runs the same IQ3_S shards as srv3 and the digest was read THERE; read h11's own artifact digests before quoting its model as verified"),
      flags: Absent,
      flags_standing: Present { value: borrowed(o: "h11's launched flags (experts mlocked in RAM, one slot) are described in its serving_host_memory rows; read the live units' ExecStart before quoting flags") },
    },
    gpu: map(card, d => card_of(d: d)),
    parallelism: ReplicaOnOneDevice,
    context_window: serving_fleet_context_cap,
    figures: FiguresOnRow {
      context: token_count(count: 100000),
      throughput: ThroughputOperatorReading { tokens_per_second: tokens_per_second(count: 12), at_concurrency: 1, standing: borrowed(o: "router_dev_policy note: one 16 GB A16 engine serves ~10-13 warm tok/s at 200k; read an h11 engine log at 100k") },
      cold_prefill: Present { value: tokens_per_second(count: 210) },
      cold_prefill_standing: borrowed(o: "router_dev_policy note: a moved Strata session re-reads 50-115k tokens in 4-9 min on an A16"),
    },
    warm_ladder: [engine_warm_swap(e: engine, cost: strata_iq3_s_snapshot_cost, restore: millisecond(count: 300), standing: borrowed(o: "borrowed from srv3's Strata restore times; read an h11 engine log"))],
    grant: launch_grant,
    engine_memory: Present { value: engine },
    // WHERE H11'S EXPERTS SIT: the mlocked copy strata-expert-lock.service holds -- a RAM-locked expert tier,
    // pinned, so the WHOLE figure is charged to the host and nothing may reclaim it. Moving h11 onto capped
    // mapped experts is its own modelled transition, not a choice this selector gets to make silently.
    expert_artifact: Present { value: host_6ce85c_routed_expert_artifact },
    monthly_cost: Absent,
    monthly_cost_standing: Absent,
  }
}

// h11's in-service buses are the ones the host's grant row lists (its comment carries why 86/c6/c5/c7 are
// disabled); the grant is the owner and the roster asks it, so the two cannot drift.

// The roster rows on ONE host, for consumers that ask per host -- the candidate-configuration field and the
// selector both scope this way, because the operator's question is "what should THIS host run".
fn replicas_on_host(host: HostIdentity) -> List<ServingReplicaProfile> {
  filter(serving_replica_roster, p => host_identity_eq(a: p.host, b: host))
}

// The whole fleet in one list: srv1's pair, srv3, srv4, and one row per h11 engine the grant admits.
data serving_replica_roster: List<ServingReplicaProfile> =
  concat([srv1_vllm_replica_0_profile, srv1_vllm_replica_1_profile, srv3_strata_profile, srv4_strata_profile],
         map(host_6ce85c_a16_buses, b => h11_strata_profile(bus: b)))

// ── THE SHAPE WRAPPERS THE ROUTER CALLS (moved with the rows) ──────────────────────────────────────
//
// router_dev_policy projects each joined replica onto its capacity shape through these names -- they stood
// beside the anchor rows in serving_capacity_anchor and move with them, because a shape is what a ROW
// answers with. A joined deployment carries its own name (the join names replicas as they come up), so the
// wrappers pass that name; every other figure on the shape comes from the row.

fn srv1_vllm_replica_shape(deployment: String) -> ServingCapacityShape {
  replica_shape_named(p: srv1_vllm_replica_0_profile, deployment: deployment)
}

fn srv3_strata_shape() -> ServingCapacityShape { replica_shape(p: srv3_strata_profile) }

fn srv4_strata_shape() -> ServingCapacityShape { replica_shape(p: srv4_strata_profile) }

// The anchors the witness inspects directly (their warm ladders, their grants). A row answers with its
// anchor; these are those answers, named as they were when they stood in serving_capacity_anchor.
fn srv3_strata_anchor() -> ServingCapacityAnchor { replica_anchor(p: srv3_strata_profile) }

fn srv4_strata_anchor() -> ServingCapacityAnchor { replica_anchor(p: srv4_strata_profile) }

// h11's shape at the admission the JOINED REPLICA has: one replica per card, so the join admits it its own
// figure, and where the join has not spoken the row's own grant (the engine's slots) is what launches.
fn h11_strata_shape(deployment: String, bus: String, admitted: Nat) -> ServingCapacityShape {
  replica_shape_named(p: h11_strata_profile_with_grant(bus: bus, launch_grant: GrantAdmits { conversations: admitted }), deployment: deployment)
}

// ── A READING PRICES ONLY THE RUN IT WAS TAKEN UNDER ──────────────────────────────────────────
//
// A reading is a claim about ONE run: this checkpoint at this revision, these quants (weights AND KV), this
// engine image, this card wiring under this power cap. srv1's readings carry exactly that
// (Srv1TopologyRunIdentity), and until now a coordinate hit borrowed a reading regardless of whether the
// profile ran the same thing -- a 300 W reading would have priced a launch capped at 350 W as though the cap
// were decoration, and it is not: the cap is one reason the pair and TP=2 sit apart, and the KV dtype moves
// the rate on its own. So resolution asks the identity BEFORE it borrows a number, and a mismatch resolves
// Absent with the field named. Nothing is quietly re-scaled to make a reading fit.
type ReplicaRunIdentity {
  // WHAT WAS LOADED: the checkpoint and BOTH quants. A reading of an fp8-KV run prices an nvfp4-KV launch not
  // at all, and the weight quantization moves the decode rate as much as the KV dtype does.
  checkpoint: HubRepoId
  checkpoint_revision: NonEmptyStr
  weights_quant: Optional<NonEmptyStr>
  kv_cache_dtype: NonEmptyStr
  // WHICH ENGINE, by the image digest it ran under and the profiles that selected it. A reading prices the
  // image it was taken under, not the engine's name: this subtree's history moves image digests several times
  // a week, and "vLLM" was the same word across all of them.
  engine_image_digest: NonEmptyStr
  serve_profile: NonEmptyStr
  hardware_profile: NonEmptyStr
  // HOW THE CARDS WIRED AND CAPPED, because that is part of what was measured, not how it was reported.
  peer_to_peer: Bool
  power_cap_each: Optional<Watt>
}

// What resolution asks and what it owes. `agrees` gates the borrow; `unchecked` names an axis the reading's
// own record could not carry, so the gap is a read obligation and not a silent widening. A field both sides
// state must be EQUAL -- there is no "close enough" for a digest, a revision, a dtype, or a cap. A field one
// side states where the other side's record has the field and left it unset is a disagreement: an unknown
// cannot be assumed equal (gunbc.design_argument::fail_closed).
type ReplicaRunIdentityMatch {
  agrees: Bool
  reasons: List<NonEmptyStr>
  unchecked: List<NonEmptyStr>
}

// "sha256:<hex>" and "<hex>" are the SAME digest spelled two ways in this subtree: the container's docker
// inspect and the run identity carry the prefix, the layout's artifact rows print bare hex. Containment in
// either direction is the whole difference -- a 64-hex digest cannot contain a DIFFERENT 64-hex digest.
fn digests_agree(a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  string_contains(s: a as String, pattern: b as String) || string_contains(s: b as String, pattern: a as String)
}

fn one_reason(field: String, own: String, taken: String) -> List<NonEmptyStr> {
  [
    concat(
      concat(
        concat(concat(field, ": this replica runs " as NonEmptyStr), own as NonEmptyStr),
        ", the reading took " as NonEmptyStr
      ),
      taken as NonEmptyStr
    ) as NonEmptyStr,
  ] as List<NonEmptyStr>
}

fn one_plain_reason(text: String) -> List<NonEmptyStr> {
  [text as NonEmptyStr] as List<NonEmptyStr>
}

fn no_match(reasons: List<NonEmptyStr>) -> ReplicaRunIdentityMatch {
  ReplicaRunIdentityMatch { agrees: false, reasons: reasons, unchecked: [] as List<NonEmptyStr> }
}

fn agreed_match() -> ReplicaRunIdentityMatch {
  ReplicaRunIdentityMatch { agrees: true, reasons: [] as List<NonEmptyStr>, unchecked: [] as List<NonEmptyStr> }
}

// The profile's OWN claim about what it runs, built from the rows that say so -- not from the reading it is
// about to be compared against, which would make the check vacuous. srv1's comes from the container's report
// of what it loaded (gunbc.host.srv1_serving_startup_receipt: the digest it resolves to, the revision and
// quantization it reported LOADING, the KV dtype it printed) plus the launch contract's profile and hardware
// names and the cards' cap. A Strata replica's comes from nothing today: srv3/srv4/h11 never had their power
// caps or P2P wiring read, so it is Absent, and a coordinate-resolved reading for such a host refuses rather
// than go unchecked.
fn replica_run_identity(p: ServingReplicaProfile) -> Optional<ReplicaRunIdentity> {
  match p.model {
    LilModel {
      checkpoint: checkpoint,
      checkpoint_revision: checkpoint_revision,
      kv_cache_dtype: kv_cache_dtype,
      launch: launch,
      run: run,
    } =>
      // The receipt outranks the benchmark row's transcription of it, because the receipt IS the read. The one
      // field taken from the run row is the KV dtype, which the profile states as its own claim and the
      // receipt corroborates -- comparing them is the point of the check, not a circularity.
      Present {
        value: ReplicaRunIdentity {
          checkpoint: checkpoint,
          checkpoint_revision: srv1_serving_startup_reading.checkpoint_revision,
          weights_quant: Present { value: srv1_serving_startup_reading.weight_quantization },
          kv_cache_dtype: kv_cache_dtype,
          engine_image_digest: srv1_serving_startup_reading.image_digest_sha256,
          serve_profile: serve_profile_name(profile: launch.profile),
          hardware_profile: hardware_profile_name(hardware: launch.hardware),
          // The wiring and the cap are the deployment's, read once for the host: srv1's nvidia-smi reports no
          // peer-to-peer (the run identity's own field, transcribed from `topo -p2p` and
          // cudaDeviceCanAccessPeer), and every card runs the cap its unit sets.
          peer_to_peer: run.gpu_peer_to_peer,
          power_cap_each: replica_power_cap_each(gpu: p.gpu),
        },
      },
    StrataModel { artifact: artifact } => Absent,
  }
}

// The card row's power cap, which every card of this replica runs under. Absent when the cards disagree (then
// no single cap can be claimed) or when none was read.
fn replica_power_cap_each(gpu: List<ReplicaGpuCard>) -> Optional<Watt> {
  replica_power_cap_each_walk(gpu: gpu, cap: Absent)
}

fn replica_power_cap_each_walk(gpu: List<ReplicaGpuCard>, cap: Optional<Watt>) -> Optional<Watt> {
  match gpu.first() {
    Absent => cap,
    Present { value: head } =>
      match head.power_cap {
        Absent => Absent,
        Present { value: watt } =>
          match cap {
            Absent => replica_power_cap_each_walk(gpu: gpu.skip(n: 1), cap: Present { value: watt }),
            Present { value: seen } =>
              if watt_count(w: watt) == watt_count(w: seen) {
                replica_power_cap_each_walk(gpu: gpu.skip(n: 1), cap: cap)
              } else {
                Absent
              },
          },
      },
  }
}

// The comparison resolution asks. Every stated pair must be equal; the one axis a srv1 run identity cannot
// carry (weight quantization) is reported as unchecked rather than passed.
fn replica_run_identity_match(want: ReplicaRunIdentity, taken: Srv1TopologyRunIdentity) -> ReplicaRunIdentityMatch {
  if (want.checkpoint.path as String) != (taken.checkpoint.path as String) {
    no_match(reasons: one_reason(field: "checkpoint repository", own: want.checkpoint.path as String, taken: taken.checkpoint.path as String))
  } else if (want.checkpoint_revision as String) != (taken.checkpoint_revision as String) {
    no_match(reasons: one_reason(field: "checkpoint revision", own: want.checkpoint_revision as String, taken: taken.checkpoint_revision as String))
  } else if (want.kv_cache_dtype as String) != (taken.kv_cache_dtype as String) {
    no_match(reasons: one_reason(field: "KV cache quantization", own: want.kv_cache_dtype as String, taken: taken.kv_cache_dtype as String))
  } else if (!digests_agree(a: want.engine_image_digest, b: taken.image_digest)) {
    no_match(reasons: one_reason(field: "engine image digest", own: want.engine_image_digest as String, taken: taken.image_digest as String))
  } else if (want.serve_profile as String) != (taken.serve_profile as String) {
    no_match(reasons: one_reason(field: "serve profile", own: want.serve_profile as String, taken: taken.serve_profile as String))
  } else if (want.hardware_profile as String) != (taken.hardware_profile as String) {
    no_match(reasons: one_reason(field: "hardware profile", own: want.hardware_profile as String, taken: taken.hardware_profile as String))
  } else if (want.peer_to_peer != taken.gpu_peer_to_peer) {
    // The field whose mismatch is cheapest to state and dearest to ignore: srv1 has NO peer-to-peer, so a
    // TP=2 reading taken WITH it -- the b12x fork's condition -- says nothing about what TP=2 costs here.
    no_match(reasons: one_plain_reason(text: "GPU peer-to-peer differs: this replica's host reports no P2P, and a reading taken where P2P exists prices nothing here"))
  } else {
    replica_power_cap_match(want: want, taken: taken)
  }
}

fn replica_power_cap_match(want: ReplicaRunIdentity, taken: Srv1TopologyRunIdentity) -> ReplicaRunIdentityMatch {
  match want.power_cap_each {
    // This replica states no single cap (the cards disagree, or it was never read), so no reading can be shown
    // to have been taken at this replica's cap.
    Absent => no_match(reasons: one_plain_reason(text: "this replica states no single per-card power cap, so no reading can be shown to share its cap")),
    Present { value: cap } =>
      if watt_count(w: cap) == watt_count(w: taken.power_cap_each) {
        // The weight quantization is the ONE axis the reading's own record cannot carry: Srv1TopologyRunIdentity
        // has no such field, so there is nothing on the reading's side to compare against. That is reported as
        // an UNCHECKED axis -- named, with the read that would close it -- rather than passed as an agreement.
        // When the run identity gains the field, the pair against the reading's stated quantization goes here.
        match want.weights_quant {
          Absent => ReplicaRunIdentityMatch {
            agrees: true,
            reasons: [] as List<NonEmptyStr>,
            unchecked: ["neither this replica nor the reading's run identity states a weight quantization, so the axis is unchecked on both sides" as NonEmptyStr] as List<NonEmptyStr>,
          },
          Present { value: own_quant } => ReplicaRunIdentityMatch {
            agrees: true,
            reasons: [] as List<NonEmptyStr>,
            unchecked: [concat(
              concat("this replica runs weights quantized as ", own_quant),
              " and the reading's run identity carries no weight-quantization field to compare; only the KV dtype was checked -- read the weight quantization into the run identity" as NonEmptyStr
            ) as NonEmptyStr] as List<NonEmptyStr>,
          },
        }
      } else {
        no_match(reasons: one_plain_reason(text: "per-card power cap differs between this replica and the run the reading was taken under"))
      },
  }
}

fn serve_profile_name(profile: LilServeProfile) -> NonEmptyStr {
  match profile {
    LilServeProfileName { name: name } => name,
  }
}

fn hardware_profile_name(hardware: LilServeHardware) -> NonEmptyStr {
  match hardware {
    LilServeHardwareName { name: name } => name,
  }
}

// ── WHERE THE WEIGHTS AND EXPERTS SIT ─────────────────────────────────────────────────────────
//
// A ladder again, this time for the weights rather than the KV: bytes ON THE CARD (charged to VRAM, budgeted
// per card), bytes in HOST RAM -- the WHOLE figure when a lock service mlocks them, their FLOOR when they are
// evictable under a cgroup cap, which is exactly what serving_layout's own charge rule says -- and bytes on
// DISK that a miss reads through. The hosts disagree about this the way they disagree about KV: h11's experts
// are mlocked by strata-expert-lock.service (the host pays unevictable RAM and buys bounded TTFT), srv3's sit
// in a private anonymous arena nothing can reclaim, srv4's are mapped under the engine's cgroup cap so the
// host can take the bytes back down to the floor. None of that is a preference; each host's serving_layout
// artifact row states which it is, and these rungs read THOSE rows rather than restating them.
//
// THE CONSUMER: the selector's host-RAM axis (configuration_charges below). Experts locked in host RAM are
// bytes the host cannot take back, so they are charged there; a configuration that moves them to a capped
// disk rung lowers that charge and takes the miss cost up instead. That is the trade the selector weighs, and
// it is why the placement lives on the profile rather than in prose.
type ReplicaExpertRung
  = ExpertOnDevice { bytes: Optional<ByteSize>, mechanism: NonEmptyStr }
  | ExpertInHostRam { bytes: ByteSize, holds: ServingArtifactHold, mechanism: NonEmptyStr }
  | ExpertOnDisk { bytes: Optional<ByteSize>, mechanism: NonEmptyStr }

// The host's placement rungs, read off its serving_layout artifact row: device rung = the card tier, host_ram
// rung = the RAM tier, disk rung = the disk tier. No artifact row, no rungs -- and the obligation below says
// what that costs whoever is reading.
fn replica_expert_rungs(p: ServingReplicaProfile) -> List<ReplicaExpertRung> {
  match p.expert_artifact {
    Absent => [] as List<ReplicaExpertRung>,
    Present { value: artifact } => expert_rungs_of(artifact: artifact),
  }
}

fn expert_rungs_of(artifact: ServingSharedArtifact) -> List<ReplicaExpertRung> {
  concat(concat(device_rungs(artifact: artifact), ram_rungs(artifact: artifact)), disk_rungs(artifact: artifact))
}

fn device_rungs(artifact: ServingSharedArtifact) -> List<ReplicaExpertRung> {
  match artifact.device {
    Absent => [] as List<ReplicaExpertRung>,
    Present { value: rung } =>
      [ExpertOnDevice {
        bytes: rung_bytes(rung: rung),
        mechanism: rung_mechanism(holds: rung.holds, realizes: rung.realizes),
      }] as List<ReplicaExpertRung>,
  }
}

fn ram_rungs(artifact: ServingSharedArtifact) -> List<ReplicaExpertRung> {
  match artifact.host_ram {
    Absent => [] as List<ReplicaExpertRung>,
    Present { value: rung } =>
      match rung_bytes(rung: rung) {
        // A rung whose bytes are unread cannot be placed: no bytes, no charge, no rung.
        Absent => [] as List<ReplicaExpertRung>,
        Present { value: bytes } =>
          [ExpertInHostRam {
            bytes: bytes,
            holds: rung.holds,
            mechanism: rung_mechanism(holds: rung.holds, realizes: rung.realizes),
          }] as List<ReplicaExpertRung>,
      },
  }
}

fn disk_rungs(artifact: ServingSharedArtifact) -> List<ReplicaExpertRung> {
  match artifact.disk {
    Absent => [] as List<ReplicaExpertRung>,
    Present { value: rung } =>
      [ExpertOnDisk {
        bytes: rung_bytes(rung: rung),
        mechanism: rung_mechanism(holds: rung.holds, realizes: rung.realizes),
      }] as List<ReplicaExpertRung>,
  }
}

// A rung's bytes as a charge: only a READ figure counts. An assumed figure is not a charge either way, and an
// unread one is an obligation -- both resolve to nothing placed, which the caller reports rather than sums.
fn rung_bytes(rung: ServingArtifactRung) -> Optional<ByteSize> {
  match rung.bytes {
    ServingMemoryRead { bytes: bytes, provenance: _ } => Present { value: bytes },
    _ => Absent,
  }
}

// HOW the bytes sit, in the host's own words: the lock service's mlock, the cgroup cap and its floor, the
// engine's own eviction. Taken from the artifact row's hold, never re-narrated.
fn rung_mechanism(holds: ServingArtifactHold, realizes: NonEmptyStr) -> NonEmptyStr {
  match holds {
    ArtifactHeldPinned { mechanism: mechanism } => mechanism,
    ArtifactHeldEvictable { bound_by: bound_by, floor: floor } =>
      match floor {
        // An evictable rung with no floor read is a rung the host may take ALL of: the bound is the mechanism
        // and the floor is what nobody has read, so the text says the bound and the charge reads it unread.
        ServingMemoryUnread { reason: reason } => bound_by,
        _ => concat(bound_by, " (reclaimable down to its stated floor)" as NonEmptyStr) as NonEmptyStr,
      },
  }
}

// What the experts cost the HOST, by serving_layout's own charge rule: the WHOLE bytes when pinned by a lock
// service, the FLOOR when evictable under a cap. Absent when nothing models the placement (srv1's vLLM
// weights: no artifact row says where they sit) -- an obligation the consumer reports, never a silent zero.
fn replica_expert_ram_charge(p: ServingReplicaProfile) -> Optional<ByteSize> {
  expert_ram_charge_of(artifact: p.expert_artifact)
}

fn expert_ram_charge_of(artifact: Optional<ServingSharedArtifact>) -> Optional<ByteSize> {
  match artifact {
    // Nothing models the placement at all: that is an obligation, not a zero.
    Absent => Absent,
    Present { value: row } =>
      match row.host_ram {
        // An artifact with no host-RAM rung charges the host NOTHING in RAM -- a disk-only or card-only
        // placement is real, and serving_layout's own charge rule reserves nothing for it.
        Absent => Present { value: byte_size(count: 0) },
        Present { value: rung } =>
          match serving_artifact_charged_host_ram(a: row) {
            // The reading the layout actually bills: whole bytes when pinned, the floor when evictable. The
            // rule answers a READING, so unwrap the reading first -- an assumed or unread one is not a zero,
            // it is an obligation, and the axis refuses.
            Present { value: ServingMemoryRead { bytes: bytes, provenance: _ } } => Present { value: bytes },
            Present { value: _ } => Absent,
            Absent => Absent,
          },
      },
  }
}

// Why a host has no expert rungs at all, for the consumer that has to name its gap rather than shrug.
fn replica_expert_placement_obligation(p: ServingReplicaProfile) -> Optional<NonEmptyStr> {
  match p.expert_artifact {
    Present { value: _ } => Absent,
    Absent => Present {
      value: concat(
        concat("no serving_layout artifact row models how ", p.host as NonEmptyStr),
        " places its weights and experts (which tier holds them, pinned or capped, and how many bytes); read nvidia-smi's per-card used bytes and the engine's lock or mmap state" as NonEmptyStr
      ) as NonEmptyStr,
    },
  }
}


// ── WHAT A CONFIGURATION CHARGES THE HOST ─────────────────────────────────────────────────────
//
// HOST IMPACT, not a bill: what this configuration makes the host HOLD, in the units the profile already
// charges. srv1 is the operator's own hardware, so a monthly-cost axis could never be read and would leave the
// selector refusing forever (a bar set on a fact that does not exist is not a constraint, it is a stall); the
// axes that can be read are the ones the profile already states -- host RAM (the warm RAM rung, the experts'
// host-RAM hold, the engine's anonymous base), host DISK (the warm disk rung's budget), and what a restart
// costs (bytes to save, milliseconds to restore). A bill stays an OPTIONAL, unfunded axis in
// gunbc.serving.serving_replica_choice until one exists.
//
// Fail-closed per axis: the sum of an unknown is unknown. A partial total would be a fabricated figure, so an
// unread component makes its WHOLE axis unread and names itself in `obligations` (gunbc.design_argument::
// fail_closed).
type ReplicaHostCharges {
  ram: Optional<ByteSize>
  disk: Optional<ByteSize>
  obligations: List<NonEmptyStr>
}

// One component of a charge: its bytes, and why there are none.
type ChargeComponent {
  bytes: Optional<ByteSize>
  obligations: List<NonEmptyStr>
}

fn component_unread(obligation: NonEmptyStr) -> ChargeComponent {
  ChargeComponent { bytes: Absent, obligations: [obligation] as List<NonEmptyStr> }
}

fn component_read(bytes: ByteSize) -> ChargeComponent {
  ChargeComponent { bytes: Present { value: bytes }, obligations: [] as List<NonEmptyStr> }
}

// The warm rungs' RAM charge: the HOTTEST readable RAM rung's bytes. Rungs fold inclusive unless a row says
// otherwise, so what the hot tier holds the cold tier holds too -- summing them would over-promise bytes the
// host does not hold twice (the same rule serve_warm_store folds by). A rung whose bytes are unread fails the
// axis and says so; a rung the adapter REFUSED (WarmSwapRefused) or nobody read (WarmSwapAbsent) is not an
// unread figure, it is the configuration not having that tier, and it contributes nothing without failing.
fn warm_ram_charge(ladder: List<ServingWarmSwap>) -> ChargeComponent {
  warm_charge_walk(ladder: ladder, want_disk: false, best: Absent, obligations: [] as List<NonEmptyStr>)
}

fn warm_disk_charge(ladder: List<ServingWarmSwap>) -> ChargeComponent {
  warm_charge_walk(ladder: ladder, want_disk: true, best: Absent, obligations: [] as List<NonEmptyStr>)
}

fn warm_charge_walk(ladder: List<ServingWarmSwap>, want_disk: Bool, best: Optional<ByteSize>, obligations: List<NonEmptyStr>) -> ChargeComponent {
  match ladder.first() {
    Absent =>
      match best {
        Present { value: bytes } => component_read(bytes: bytes),
        // No rung of this tier at all is not an unread axis: it is a configuration that holds nothing there.
        Absent =>
          match obligations.first() {
            Absent => component_read(bytes: byte_size(count: 0)),
            Present { value: _ } => ChargeComponent { bytes: Absent, obligations: obligations },
          },
      },
    Present { value: head } =>
      match head {
        WarmSwapRestores { tier: tier, cache: cache } =>
          if tier_is_disk(tier: tier) == want_disk {
            match cache {
              ServingMemoryRead { bytes: bytes, provenance: _ } =>
                warm_charge_walk(ladder: ladder.skip(n: 1), want_disk: want_disk, best: bigger(a: best, b: bytes), obligations: obligations),
              // An assumed byte figure is a bet on the configuration, not a reading: it charges nothing and
              // names itself, so the axis refuses rather than bill a guess.
              ServingMemoryAssumed { bytes: bytes, reason: reason } =>
                warm_charge_walk(ladder: ladder.skip(n: 1), want_disk: want_disk, best: best, obligations: concat(obligations, [reason] as List<NonEmptyStr>)),
              ServingMemoryUnread { reason: reason } =>
                warm_charge_walk(ladder: ladder.skip(n: 1), want_disk: want_disk, best: best, obligations: concat(obligations, [reason] as List<NonEmptyStr>)),
            }
          } else {
            warm_charge_walk(ladder: ladder.skip(n: 1), want_disk: want_disk, best: best, obligations: obligations)
          },
        _ => warm_charge_walk(ladder: ladder.skip(n: 1), want_disk: want_disk, best: best, obligations: obligations),
      },
  }
}

fn tier_is_disk(tier: ServingSwapTier) -> Bool {
  match tier {
    SwapTierDisk => true
    _ => false
  }
}

fn bigger(a: Optional<ByteSize>, b: ByteSize) -> Optional<ByteSize> {
  match a {
    Absent => Present { value: b },
    Present { value: seen } =>
      if byte_size_count(b: b) > byte_size_count(b: seen) {
        Present { value: b }
      } else {
        Present { value: seen }
      },
  }
}

// The engine's own anonymous footprint: the base its memory row states, which only a reading taken with
// nothing parked measures. Absent (with the reason) where no row states it -- srv1's container was never
// measured with its cache empty, which is exactly the kind of gap a charge must not paper over.
fn anonymous_base_charge(engine_memory: Optional<ServingEngineMemory>) -> ChargeComponent {
  match engine_memory {
    Absent => component_unread(obligation: "the host models no engine memory row for this replica, so the engine's anonymous base is unread" as NonEmptyStr),
    Present { value: row } =>
      match row.base {
        ServingMemoryRead { bytes: bytes, provenance: _ } => component_read(bytes: bytes),
        ServingMemoryAssumed { bytes: bytes, reason: reason } => component_unread(obligation: reason),
        ServingMemoryUnread { reason: reason } => component_unread(obligation: reason),
      },
  }
}

// The experts' host-RAM charge as a component, so its obligation reads like the others.
fn expert_charge_component(expert_artifact: Optional<ServingSharedArtifact>) -> ChargeComponent {
  match expert_ram_charge_of(artifact: expert_artifact) {
    Present { value: bytes } => component_read(bytes: bytes),
    Absent =>
      match expert_artifact {
        Absent => component_unread(obligation: "no serving_layout artifact row models this host's weights and experts, so their host-RAM hold is unread" as NonEmptyStr),
        Present { value: row } =>
          component_unread(obligation: concat(concat("the host-RAM rung of the artifact ", row.name as NonEmptyStr), " states no readable byte figure" as NonEmptyStr) as NonEmptyStr),
      },
  }
}

// N replicas of a ladder, the host's expert copy counted ONCE (it is shared resident bytes, not per-replica --
// the layout's own rule), and the engine base once per engine row. Any unread component fails its axis and
// names itself.
fn configuration_charges(ladder: List<ServingWarmSwap>, expert_artifact: Optional<ServingSharedArtifact>, engine_memory: Optional<ServingEngineMemory>, replica_count: Nat) -> ReplicaHostCharges {
  let warm_ram = warm_ram_charge(ladder: ladder)
  let warm_disk = warm_disk_charge(ladder: ladder)
  let experts = expert_charge_component(expert_artifact: expert_artifact)
  let anon = anonymous_base_charge(engine_memory: engine_memory)
  let obligations = concat(concat(concat(warm_ram.obligations, warm_disk.obligations), experts.obligations), anon.obligations)
  ReplicaHostCharges {
    ram: sum_or_absent(parts: [scale_component(base: warm_ram.bytes, times: replica_count), experts.bytes, anon.bytes] as List<Optional<ByteSize>>),
    disk: scale_component(base: warm_disk.bytes, times: replica_count),
    obligations: obligations,
  }
}

fn scale_component(base: Optional<ByteSize>, times: Nat) -> Optional<ByteSize> {
  match base {
    Absent => Absent,
    Present { value: bytes } =>
      if times == 0 {
        Present { value: byte_size(count: 0) }
      } else {
        Present { value: byte_size(count: byte_size_count(b: bytes) * times) }
      },
  }
}

// The sum, or nothing: an unread part makes the whole axis unread, and the obligations already say which
// part. Written as a read-check and a total rather than a fold of Optionals, because the resolver flattens
// nested Optionals and will not type a List<Optional<ByteSize>> element back through a match.
fn parts_are_read(parts: List<Optional<ByteSize>>) -> Bool {
  fold(parts, init: true, f: (acc, part) =>
    if acc {
      match part {
        Present { value: _ } => true,
        Absent => false,
      }
    } else {
      false
    })
}

fn parts_total_read(parts: List<Optional<ByteSize>>) -> ByteSize {
  fold(parts, init: byte_size(count: 0), f: (acc, part) =>
    match part {
      Absent => acc,
      Present { value: bytes } => byte_size(count: byte_size_count(b: acc) + byte_size_count(b: bytes)),
    })
}

fn sum_or_absent(parts: List<Optional<ByteSize>>) -> Optional<ByteSize> {
  if parts_are_read(parts: parts) {
    Present { value: parts_total_read(parts: parts) }
  } else {
    Absent
  }
}

// One replica of the roster, charged.
fn replica_host_charges(p: ServingReplicaProfile) -> ReplicaHostCharges {
  configuration_charges(
    ladder: p.warm_ladder,
    expert_artifact: p.expert_artifact,
    engine_memory: p.engine_memory,
    replica_count: 1,
  )
}

// Why a coordinate figure refused, for the witness and the selector's obligations: the identity's own words
// when that is the reason, and "no reading at that coordinate" when the table simply has no row.
fn replica_figures_refusal(p: ServingReplicaProfile) -> Optional<NonEmptyStr> {
  match p.figures {
    FiguresOnRow { context: context, throughput: throughput, cold_prefill: cold_prefill, cold_prefill_standing: cold_prefill_standing } => Absent,
    FiguresUnmeasured { obligation: obligation } => Present { value: obligation },
    FiguresAtCoordinate { topology: topology, sessions: sessions } =>
      match srv1_topology_reading(topology: topology, sessions: sessions) {
        Absent => Present { value: "no reading at that topology and concurrency" as NonEmptyStr },
        Present { value: reading } =>
          match replica_run_identity(p: p) {
            Absent => Present { value: "this replica states no run identity, so no reading can be shown to match it" as NonEmptyStr },
            Present { value: want } =>
              match replica_run_identity_match(want: want, taken: reading.run) {
                ReplicaRunIdentityMatch { agrees: true, reasons: reasons, unchecked: unchecked } => Absent,
                ReplicaRunIdentityMatch { agrees: false, reasons: reasons, unchecked: unchecked } => reasons.first(),
              },
          },
      },
  }
}
