// THE SRV1 DEV DEPLOYMENT'S ROUTING POLICY, A DECLARED SCAFFOLD (operator decision 2026-10-25, option B,
// relayed by calm-crab-645 msg_9e44dfaa and msg_cb0938f9; debt rows in gunbc.serving.router_dev_scaffold).
// The pool is served from OpenResty before the S3 callout service exists, so the decisions S3 owns are
// made here, in Lua, inside the proxy: the client key check, the session's sticky upstream, a per-upstream
// active-turn cap, and routing by advertised model name or the pool alias. That is router policy in the
// proxy, which gunbc.serving.router_realization forbids and the scaffold rows name item by item.
//
// What stays the S1 contract: bytes are relayed as they arrive (buffering and request buffering off), no
// second upstream is tried (proxy_next_upstream off), and the upstream's TLS is verified against its pinned
// certificate (proxy_ssl_verify on, one trusted bundle of the pinned leaf certificates).
//
// The proxy reads its state at start from state_dir, mounted from the host and written by the hand-run
// deploy: client_keys (one client key per line), upstreams.json (name, scheme, host, port, sni, key, model,
// cap per upstream) and upstream_ca.pem. No key is in the rendered configuration.
//
// Every interpolated value, the state directory and the alias included, passes the checked token
// constructor, which refuses a quote; a refusal names the token that failed.
//
// A session is named by x-session-id, the body user, or the first-message prefix. At each new
// request, owned capacity is chosen first; the cached binding is preferred only within that tier.
// When all compatible owned lanes are busy or temporarily unavailable, ctrl's rented-only pool
// receives the request and accounts for overflow demand. Returning owned capacity takes preference
// again on the next request. No request is retried after streaming starts; failures cool an upstream
// for 30 seconds and the client can retry. The existing local cap applies through the log phase.
// The overflow endpoint has no router-side GPU cap: ctrl discovers the cards and observes their queues.

fn tok(text: String) -> NginxToken? { nginx_token(text: text) }
fn var(text: String) -> NginxVariable? { nginx_variable(text: text) }

// A COMPARISON QUOTE: WHAT A COMPARABLE OFFER WOULD HAVE COST, kept for the fleet's own accounting. It is
// not a price the fabric pays -- an owned card's actual spend is zero and the rented pool bills by the hour
// through ctrl -- so its entire purpose is a number a reader can compare against. That makes three things
// inseparable, and all three are data: the figures, WHICH model they quote, and where they were read. A
// figure with no authority is a guess, so the standing is required by the type rather than optional.
// Figures are micros (1e-6 USD): an integer count, so a price is never a float whose rounding rule nobody
// declared, and the only place a decimal point is written is the render below.
type RouterDevComparisonQuote {
  model: String
  quantization: String
  reference_model: String
  currency: CurrencyCode
  input_per_million: MoneyAmountMicro
  cached_per_million: MoneyAmountMicro
  output_per_million: MoneyAmountMicro
  authority: ExternalAuthority
  // WHEN THE FIGURES WERE READ, not a prose "as_of=". A price is a dated observation or it is nothing.
  read_on: Timestamp
  // True while the figures are a proxy for another vendor's price rather than this fleet's own tariff. Readers of
  // comparison_pricing (the dashboard, ctrl's pool router) already read `estimated`, so the field stays.
  estimated: Bool
  method: String
}

// THE UNIT THE FIGURES ARE PER, stated once. The field names say per_million and the reader is shown this
// same text, so the spelling cannot drift from what the numbers mean.
data comparison_token_unit: String = "per_million_tokens"

fn money_micro_text(a: MoneyAmountMicro) -> String {
  to_string(money_amount_micro_count(m: a))
}

fn bool_text(b: Bool) -> String { if b { "true" } else { "false" } }

// ONE QUOTE AS ONE Lua TABLE LITERAL, with every field name and figure written here and nowhere else. The
// response header, the meter and the stats document all read THIS table, so a price has one home (gunbc.design_argument::single_authority:
// each fact lives in exactly one place).
fn router_dev_comparison_row_line(q: RouterDevComparisonQuote) -> String {
  "ROUTER_COMPARISON['" + q.model + "'] = \{model='" + q.model
    + "', quantization='" + q.quantization
    + "', reference_model='" + q.reference_model
    + "', input_micro=" + money_micro_text(a: q.input_per_million)
    + ", cached_micro=" + money_micro_text(a: q.cached_per_million)
    + ", output_micro=" + money_micro_text(a: q.output_per_million)
    + ", estimated=" + bool_text(b: q.estimated)
    + ", currency='" + currency_alphabetic_code(c: q.currency)
    + "', unit='" + comparison_token_unit
    + "', source='" + (uri_wire(uri: q.authority.uri) as String)
    + "', read_on='" + (q.read_on as String)
    + "', method='" + q.method + "'\}"
}

// THE ONE RENDERING BOUNDARY from the quote row to the wire shape the live router publishes (float figures per
// million, `as_of`, `estimated`). The row above is the only stored shape: micro integers and `read_on`. The wire
// table is derived from it here, once at init, and read by the response headers, /v1/models and the stats
// documents; the meter reads the row. Header figures are Lua tostring of the derived float, the live rule
// (the live router's price-header formatting in its header_filter phase), applied at this one place; a price with more than 14 significant digits would round,
// and the cited quotes carry at most 6. End condition: this boundary and the wire names are deleted when the
// dashboard and ctrl pool router read the row's own names (their readers are unverified from this session,
// so the live names stay until the cutover confirms them).
fn router_dev_comparison_lines() -> List<String> {
  list_append(
    left: list_append(
      left: [
        "ROUTER_COMPARISON = \{}",
        // A model with no row is unpriced: the lookup answers nil and the meter counts the turn unpriced
        // rather than inventing a figure to fill the gap.
        "function router_comparison(model) return ROUTER_COMPARISON[model] end",
      ],
      right: map(router_dev_comparison_quotes(), q => router_dev_comparison_row_line(q: q)),
    ),
    right: [
      "ROUTER_COMPARISON_WIRE = \{}",
      "for model, q in pairs(ROUTER_COMPARISON) do ROUTER_COMPARISON_WIRE[model] = \{model=q.model, quantization=q.quantization, reference_model=q.reference_model, input=q.input_micro / 1000000, cached=q.cached_micro / 1000000, output=q.output_micro / 1000000, estimated=q.estimated, currency=q.currency, unit=q.unit, source=q.source, as_of=q.read_on, method=q.method} end",
      "function router_comparison_wire(model) return ROUTER_COMPARISON_WIRE[model] end",
    ],
  )
}

// THE POOL'S OWN QUOTES, read at the URI and on the date stated in each row. They are one reference
// model's prompt, cached-prompt and output price proxy. Quantization is the vendor's word for OUR weights
// and a provider does not disclose its own precision, so a row states what is claimed; the alias answers
// from whichever engine holds the session, so its row says mixed rather than picking one and implying the
// others. Cache discounts may only be applied to tokens the provider itself reported as cached -- a row
// cannot silently discount tokens the engine never declared.
fn qwen3_flash_reference_quote(
  model: String,
  quantization: String,
) -> RouterDevComparisonQuote {
  RouterDevComparisonQuote {
    model: model,
    quantization: quantization,
    reference_model: "qwen/qwen3.8-flash",
    currency: Usd,
    input_per_million: money_amount_micro(count: 150000),
    cached_per_million: money_amount_micro(count: 16000),
    output_per_million: money_amount_micro(count: 470000),
    authority: ExternalAuthority { uri: uri_https(locator: "openrouter.ai/api/v1/models/qwen/qwen3.8-flash/endpoints" as NonEmptyStr) },
    read_on: "2026-10-26" as Timestamp,
    estimated: true,
    method: "Alibaba prompt, cached-prompt and output price proxy; vendor quantization is undisclosed. Cache discounts apply only to provider-reported cached tokens. Actual owned spend is zero.",
  }
}

fn router_dev_comparison_quotes() -> List<RouterDevComparisonQuote> {
  [
    qwen3_flash_reference_quote(model: "Qwen3.8-Flash-Next", quantization: "nvfp4"),
    qwen3_flash_reference_quote(model: "qwen3.8-flash-next-iq3_s", quantization: "iq3_s"),
    qwen3_flash_reference_quote(model: "flash-next", quantization: "mixed"),
  ]
}

fn router_dev_init_lines(state_dir: String, model_alias: String) -> List<String> {
  list_append(left: router_dev_comparison_lines(), right: [
    "local cjson = require('cjson.safe')",
    "local dir = '" + state_dir + "'",
    "local state = ngx.shared.router_state",
    "local function slurp(p) local f = io.open(p, 'r') if not f then return nil end local s = f:read('*a') f:close() return s end",
    // A counter that has never been written and one that is honestly zero are different facts; the epoch
    // says when this worker's counters started, so a reader can tell them apart across a reload.
    "state:add('meter:v2:epoch', tostring(ngx.now()))",
    "ROUTER_KEYS = \{}",
    "for line in (slurp(dir .. '/client_keys') or ''):gmatch('[^\\r\\n]+') do ROUTER_KEYS[line] = true end",
    "ROUTER_UPSTREAMS = cjson.decode(slurp(dir .. '/upstreams.json') or '[]') or \{}",
    "ROUTER_ALIAS = '" + model_alias + "'",
    // Reasoning-effort dialect per upstream MODEL, rendered from the effort_effects rows on the
    // upstream list. The alias and each engine accept a different set of effort names, and an engine
    // answers 400 on a name it does not implement, so the translation is data on the row, not a rule
    // written into this file. A name with no rule passes through and the engine answers as it likes.
    "ROUTER_EFFORT = \{}",
    "for _, u in ipairs(ROUTER_UPSTREAMS) do",
    "  if u.effort_effects ~= nil then",
    "    local t = ROUTER_EFFORT[u.model] or \{}",
    "    for _, e in ipairs(u.effort_effects) do t[e.client] = e end",
    "    ROUTER_EFFORT[u.model] = t",
    "  end",
    "end",
  ])
}

fn router_dev_models_lines() -> List<String> {
  // Pool clients select the first advertised model. Lead with the alias so they can use every
  // upstream, with the smallest context window that every upstream behind that alias supports.
  [
    "local cjson = require('cjson.safe')",
    "local h = ngx.var.http_authorization or ''",
    "if not ROUTER_KEYS[(h:match('^Bearer%s+(.+)$') or '')] then ngx.status = 401 ngx.say('\{\"error\":\{\"message\":\"invalid api key\",\"type\":\"authentication_error\"}}') return end",
    "local lens, order, all_len = \{}, \{}, nil",
    // A drained row is not advertised: a model with no live upstream, or a route to one, would be a
    // promise the router cannot keep. See RouterDevUpstream.in_service.
    "for _, u in ipairs(ROUTER_UPSTREAMS) do",
    "  if u.in_service ~= false then",
    "    local n = tonumber(u.max_model_len)",
    "    if lens[u.model] == nil then order[#order + 1] = u.model lens[u.model] = false end",
    "    if n and n > 0 then",
    "      if not lens[u.model] or n < lens[u.model] then lens[u.model] = n end",
    "      if not all_len or n < all_len then all_len = n end",
    "    end",
    "  end",
    "end",
    "local data = \{}",
    "data[#data + 1] = \{id = ROUTER_ALIAS, object = 'model', owned_by = 'gunbc', max_model_len = all_len, comparison_pricing = router_comparison_wire(ROUTER_ALIAS)}",
    "for _, m in ipairs(order) do data[#data + 1] = \{id = m, object = 'model', owned_by = 'gunbc', max_model_len = lens[m] or nil, comparison_pricing = router_comparison_wire(m)} end",
    "for _, entry in ipairs(data) do",
    "  entry.routes = \{}",
    "  for _, u in ipairs(ROUTER_UPSTREAMS) do",
    "    if u.in_service ~= false and (entry.id == ROUTER_ALIAS or entry.id == u.model) then entry.routes[#entry.routes + 1] = \{name=u.name, billing=u.overflow and 'rented_hourly' or 'owned', actual_spend_usd=u.overflow and cjson.null or 0, quantization=(router_comparison(u.model) or \{}).quantization} end",
    "  end",
    "end",
    "ngx.header['Content-Type'] = 'application/json'",
    "ngx.say(cjson.encode(\{object = 'list', data = data}))",
  ]
}

// ONE reading of which row owns a stored binding or an active counter: a row's own name or any name it
// retires, resolved against the COMPLETE configured row set and independent of the requested model. Model
// conflict, carry, retention counting, trim and the rented-pool summary all read it, so a rename cannot change
// what any of them decides. Rows are written with no retiring name shared or live (router_dev_retiring_name_conflict).
fn router_dev_row_lines() -> List<String> {
  [
    "local owner_of = \{}",
    "for _, u in ipairs(ROUTER_UPSTREAMS) do owner_of[u.name] = u.name end",
    "for _, u in ipairs(ROUTER_UPSTREAMS) do for _, old in ipairs(u.retiring_names or \{}) do owner_of[old] = u.name end end",
    "local function active(u) local st = ngx.shared.router_state local n = st:get('active:' .. u.name) or 0 for _, old in ipairs(u.retiring_names or \{}) do n = n + (st:get('active:' .. old) or 0) end return n end",
  ]
}

fn router_dev_access_lines() -> List<String> {
  list_append(left: router_dev_row_lines(), right: [
    "local cjson = require('cjson.safe')",
    "local function refuse(status, kind, msg) ngx.status = status ngx.header['Content-Type'] = 'application/json' ngx.say(cjson.encode(\{error = \{message = msg, type = kind}})) return ngx.exit(status) end",
    "local h = ngx.var.http_authorization or ''",
    "if not ROUTER_KEYS[(h:match('^Bearer%s+(.+)$') or '')] then return refuse(401, 'authentication_error', 'invalid api key') end",
    "ngx.req.read_body()",
    "local raw = ngx.req.get_body_data()",
    "if not raw then local f = ngx.req.get_body_file() if f then local h = io.open(f, 'rb') if h then raw = h:read('*a') h:close() end end end",
    "if not raw then return refuse(400, 'invalid_request_error', 'request body required') end",
    "local body = cjson.decode(raw)",
    "if type(body) ~= 'table' or type(body.model) ~= 'string' then return refuse(400, 'invalid_request_error', 'model required') end",
    "local session = ngx.var.http_x_session_id",
    "if (not session or session == '') and type(body.user) == 'string' and body.user ~= '' then session = 'user:' .. body.user end",
    "if not session or session == '' then",
    "  local sys, first = '', ''",
    "  if type(body.messages) == 'table' then",
    "    for _, m in ipairs(body.messages) do",
    "      if type(m) == 'table' then",
    "        local c = type(m.content) == 'string' and m.content or (cjson.encode(m.content) or '')",
    "        if m.role == 'system' and sys == '' then sys = c elseif m.role == 'user' and first == '' then first = c end",
    "      end",
    "    end",
    "  elseif type(body.prompt) == 'string' then first = body.prompt end",
    "  session = 'prefix:' .. ngx.md5((sys .. '\\0' .. first):sub(1, 4096))",
    "end",
    "local state = ngx.shared.router_state",
    // STRANDED DEMAND: one record per refused conversation, keyed by the REQUESTED model, holding the time of
    // the FIRST refusal across retries so its age is how long the conversation has waited. The autoscaler reads
    // the count and oldest age from /router/stats; the record expires on its own after the span.
    "local function strand()",
    "  local sk = 'pending:' .. tostring(body.model) .. '|' .. session",
    "  state:set(sk, state:get(sk) or ngx.now(), " + to_string(second_count(s: router_dev_pending_ttl())) + ")",
    "end",
    "local candidates = \{}",
    // An out-of-service row is out of the model entirely: it is not a candidate, is never picked, and is
    // not reachable by a stale binding. A drained engine left in the file only lets a hand edit or a
    // stale binding reach it again, which is why the flag exists and why coming back online is a change
    // to the row rather than an edit on the box.
    "for _, u in ipairs(ROUTER_UPSTREAMS) do",
    // ~= false, not truthiness: a row written by an older deploy (or a fixture) has no field, and an
    // absent field is a live engine. Only an explicit false drains one.
    "  if u.in_service ~= false and (body.model == ROUTER_ALIAS or body.model == u.model) then candidates[u.name] = u end",
    "end",
    "if next(candidates) == nil then return refuse(404, 'invalid_request_error', 'unknown model') end",
    // THE FORWARDED BODY IS THE CLIENT'S BYTES. The engines render the request in received order (Strata
    // prints tools with tojson(sort_keys=False) at the start of the prompt), so any re-serialization moves
    // the first prompt tokens and no prefix is reusable. A re-encode through a Lua table reorders every
    // object; on 2026-10-30 that made consecutive turns of one h11 conversation differ at byte 5 and reuse 0
    // tokens. So a rewrite is a splice of ONE string literal in place: it applies only when the literal
    // occurs exactly once outside a string, and the spliced body must decode to the intended values. A body
    // that cannot be spliced is refused, never re-encoded -- a re-encode is the silent cost this replaces.
    "local function lit(x) return (x:gsub('[%^%$%(%)%%%.%[%]%*%+%-%?]', '%%%0')) end",
    "local function splice(s, key, from, replacement, whole)",
    "  if from:find('[\"\\\\%c]') then return nil end",
    "  local pat = '\"' .. lit(key) .. '\"%s*:%s*()\"' .. lit(from) .. '\"()'",
    "  local at, va, vb, n, init = nil, nil, nil, 0, 1",
    "  while true do",
    "    local a, b, p, q = s:find(pat, init)",
    "    if not a then break end",
    "    if a == 1 or s:sub(a - 1, a - 1) ~= '\\\\' then n = n + 1 at, va, vb = a, p, q end",
    "    init = b + 1",
    "  end",
    "  if n ~= 1 then return nil end",
    "  if whole then return s:sub(1, at - 1) .. replacement .. s:sub(vb) end",
    "  return s:sub(1, va - 1) .. replacement .. s:sub(vb)",
    "end",
    // The dashboard sends the effort inside chat_template_kwargs, which is where vLLM and Strata read
    // it; a name the target model does not implement is a 400 from that engine, so the row's dialect is
    // applied at the same place the engine would read it. An unmapped name is left alone and the engine
    // answers for itself -- the router never invents a value it was not told to send.
    "local kw = body.chat_template_kwargs",
    "local asked = (type(kw) == 'table' and type(kw.reasoning_effort) == 'string') and kw.reasoning_effort or nil",
    // The bytes to forward to one upstream, and the effort it will apply; nil when no in-place splice holds.
    // Computed BEFORE any reservation or binding, so a refused body leaves no counter or binding behind.
    "local function forwarded(pick)",
    // Any string effort is reported, mapped or not: an unmapped name passes through to the engine and the
    // header still says what it was told (live behavior).
    "  local out, effort = raw, asked",
    "  if body.model == ROUTER_ALIAS then out = splice(out, 'model', ROUTER_ALIAS, cjson.encode(pick.model), false) end",
    "  local eff = asked and (ROUTER_EFFORT[pick.model] or \{})[asked] or nil",
    "  if out and eff ~= nil then",
    "    if eff.drop_thinking then out, effort = splice(out, 'reasoning_effort', asked, '\"enable_thinking\": false', true), 'off'",
    "    else out, effort = splice(out, 'reasoning_effort', asked, cjson.encode(eff.to), false), eff.to end",
    "  end",
    "  if not out then return nil end",
    "  if out == raw then return out, effort end",
    "  local chk = cjson.decode(out)",
    "  if type(chk) ~= 'table' or chk.model ~= ((body.model == ROUTER_ALIAS) and pick.model or body.model) then return nil end",
    "  if eff ~= nil then",
    "    local ck = chk.chat_template_kwargs",
    "    if type(ck) ~= 'table' then return nil end",
    "    if eff.drop_thinking and (ck.reasoning_effort ~= nil or ck.enable_thinking ~= false) then return nil end",
    "    if not eff.drop_thinking and ck.reasoning_effort ~= eff.to then return nil end",
    "  end",
    "  return out, effort",
    "end",
    "local function unspliceable() return refuse(400, 'invalid_request_error', 'the router rewrites the model and reasoning_effort in place, and this body has no single unescaped literal to rewrite') end",
    // serve() completes routing for one turn: it is the ONE place a binding is recorded and an
    // upstream is selected, so a turn that kept its bound engine and a freshly picked turn cannot drift.
    // It is reached only after begin_turn reserved the turn, which is where the turn is counted.
    "local function serve(pick, session, out, effort)",
    "  ngx.ctx.route = pick",
    "  state:delete('pending:' .. tostring(body.model) .. '|' .. session)",
    "  state:set('seen:' .. session, ngx.now(), " + to_string(second_count(s: router_dev_binding_ttl())) + ")",
    "  ngx.req.set_header('X-Pool-Session', session)",
    "  ngx.req.set_header('X-Session-Id', session)",
    "  if pick.path_prefix and pick.path_prefix ~= '' then ngx.req.set_uri(pick.path_prefix .. ngx.var.uri, false) end",
    "  state:set('session:' .. session, pick.name, " + to_string(second_count(s: router_dev_binding_ttl())) + ")",
    "  if effort ~= nil then ngx.ctx.effort = effort end",
    "  if out ~= raw then ngx.req.set_body_data(out) end",
    "  ngx.var.up = pick.host .. ':' .. tostring(pick.port)",
    "  ngx.var.up_scheme = pick.scheme",
    "  ngx.var.up_key = pick.key or ''",
    "  ngx.var.up_sni = pick.sni or pick.host",
    "end",
    // An upstream is available when it answers this model AND the health guard has not ejected it
    // (unavailable:<name> is set in the log phase on a 5xx or a 401, for the ejection span).
    "local stuck = state:get('session:' .. session)",
    // A binding to a RETIRED name belongs to the row that retires it: the engine was renamed, not lost, so its
    // session keeps its placement and its cache.
    "if stuck then stuck = owner_of[stuck] or stuck end",
    // A binding may name an engine that no longer answers this model. Refuse when the bound row is a LIVE row
    // of a different model: the caller is addressing one engine's model while holding another's cache, and
    // silently re-placing would answer from the wrong weights. A name no configured row owns is refused the
    // same way, as the live router does: unknown does not establish that no cache survives, and re-placing it
    // is a permission to reconstruct this policy does not grant (that is the relocation operation's to give).
    // A row that is out of service is not a conflict; the pick below re-places the session.
    "if stuck and stuck ~= '' and not candidates[stuck] and body.model ~= ROUTER_ALIAS then",
    "  local gone = nil",
    "  for _, u in ipairs(ROUTER_UPSTREAMS) do if u.name == stuck then gone = u end end",
    "  if gone == nil or gone.in_service ~= false then return refuse(409, 'invalid_request_error', 'session is bound to another model') end",
    "end",
    "local function available(u) return candidates[u.name] ~= nil and not state:get('unavailable:' .. u.name) end",
    // NO MOVE ON CONGESTION, for every capped row (operator 2026-10-28: one placement per conversation; deliberate
    // moves come only through the relocation operation). A bound session returns to its engine or is refused; it
    // moves only when that engine is unavailable. An uncapped rented row never refuses, so it never reaches the
    // refusal either.
    "local function uncapped(u) return u.overflow and u.cap == nil end",
    // begin_turn is the ONE place a turn is reserved, and the only place ngx.ctx.counted is set: the log
    // phase releases exactly what was reserved here. A cap is the active-turn ceiling of a row, 0 included (no
    // turns). An uncapped rented row is admitted without a ceiling and still counted, so its active figure
    // stays true.
    "local function begin_turn(u)",
    "  state:incr('active:' .. u.name, 1, 0)",
    "  if not uncapped(u) and active(u) > (u.cap or 0) then",
    "    state:incr('active:' .. u.name, -1, 0)",
    "    return false",
    "  end",
    "  ngx.ctx.counted = u.name",
    "  return true",
    "end",
    // RETENTION ADMISSION: a NEW session binds to a row only while the sessions bound there are fewer than
    // the conversations it retains (the row's derived retain). A bound session always returns to its own row,
    // and a row without retain admits as before.
    // One pass over the shared dict per request, built on first use: bindings expire by TTL, so a maintained
    // per-row counter would drift on expiry. The scan walks every key of router_state, not only the bindings:
    // the live router pays the same cost. DIVERGENCE KEPT ON PURPOSE: bindings stay in router_state as
    // 'session:<id>' because a graceful reload keeps a same-named lua_shared_dict, so every live binding
    // survives the cutover. A dedicated bindings dict needs a copy-then-switch migration leg, which belongs
    // to the cutover (owner calm-moth-166), not to this parity change.
    "local bound_counts = nil",
    "local function bound_count(name)",
    "  if not bound_counts then",
    "    bound_counts = {}",
    "    for _, k in ipairs(state:get_keys(0)) do",
    "      if k:sub(1, 8) == 'session:' and k:sub(9) ~= session then",
    "        local row = state:get(k)",
    "        row = row and (owner_of[row] or row)",
    "        if row then bound_counts[row] = (bound_counts[row] or 0) + 1 end",
    "      end",
    "    end",
    "  end",
    "  return bound_counts[name] or 0",
    "end",
    "local function retains(c) return c.retain == nil or c.name == stuck or bound_count(c.name) < c.retain end",
    "local bound = (stuck and stuck ~= '') and candidates[stuck] or nil",
    "if bound and available(bound) then",
    // A bound session is served by ITS engine or refused, on every owned row and every capped rented row: no
    // path from here reaches the pick loop while the engine is available. Falling through would migrate the
    // very session this rule exists to keep in place (operator 2026-10-28: deliberate moves come only through
    // the relocation operation), and would do it at the worst moment -- capacity just taken by another turn.
    // The former shared-cache fall-through is dropped on purpose, as the live router drops it. When begin_turn
    // refuses, the answer is 429 + Retry-After so the client retries the SAME engine rather than paying a
    // 50-115k context re-read on another one.
    "  local out, effort = forwarded(bound)",
    "  if not out then return unspliceable() end",
    "  if begin_turn(bound) then return serve(bound, session, out, effort) end",
    "  strand()",
    "  ngx.header['Retry-After'] = '2'",
    "  return refuse(429, 'rate_limit_error', 'session upstream at its active-turn cap')",
    "end",
    "local pick, priority, spare = nil, nil, -1",
    "for _, u in ipairs(ROUTER_UPSTREAMS) do",
    "  local c = candidates[u.name]",
    "  if c and not state:get('unavailable:' .. c.name) and retains(c) then",
    "    local p = c.overflow and 1 or 0",
    "    local free = uncapped(c) and 1 or ((c.cap or 0) - active(c))",
    "    if free > 0 and (not pick or p < priority or (p == priority and ((c.name == stuck and pick.name ~= stuck) or (pick.name ~= stuck and free > spare)))) then pick, priority, spare = c, p, free end",
    "  end",
    "end",
    "if not pick then strand() ngx.header['Retry-After'] = '2' return refuse(429, 'rate_limit_error', 'every compatible upstream is busy or unavailable') end",
    "local out, effort = forwarded(pick)",
    "if not out then return unspliceable() end",
    "if not begin_turn(pick) then",
    "  strand()",
    "  ngx.header['Retry-After'] = '2'",
    "  return refuse(429, 'rate_limit_error', 'upstream at its active-turn cap')",
    "end",
    "return serve(pick, session, out, effort)",
  ])
}

// The log phase releases the turn and tallies the outcome: every answered request by status, and each
// admitted one by upstream and status, so the cut-over has a 4xx/5xx rate to watch (the access log is off).
// Comparison value is metadata, never a token charge. The body and SSE bytes are relayed unchanged.
// Alibaba's current vendor rate was checked 2026-10-25; quant-specific quotes are not published.
fn router_dev_header_lines() -> List<String> {
  [
    "local u = ngx.ctx.route",
    "if u then",
    "  local p = router_comparison_wire(u.model)",
    "  ngx.header['X-Gunbc-Upstream'] = u.name",
    "  ngx.header['X-Gunbc-Model'] = u.model",
    // What the engine was actually told, after the row's dialect -- not what the client asked for.
    "  if ngx.ctx.effort then ngx.header['X-Gunbc-Reasoning-Effort'] = ngx.ctx.effort end",
    "  ngx.header['X-Gunbc-Billing'] = u.overflow and 'rented_hourly' or 'owned'",
    "  if not u.overflow then ngx.header['X-Gunbc-Actual-Spend-Usd'] = '0' end",
    // Every figure shown is READ FROM THE QUOTE ROW (rendered in init_by_lua); none of them is written
    // here. The figures are the live router's shape (floats, as_of, estimated): its readers already parse them.
    "  if p then",
    "    ngx.header['X-Gunbc-Quantization'] = p.quantization",
    "    ngx.header['X-Gunbc-Comparison-Reference-Model'] = p.reference_model",
    "    ngx.header['X-Gunbc-Comparison-Input-Per-M'] = tostring(p.input)",
    "    ngx.header['X-Gunbc-Comparison-Cached-Per-M'] = tostring(p.cached)",
    "    ngx.header['X-Gunbc-Comparison-Output-Per-M'] = tostring(p.output)",
    "    ngx.header['X-Gunbc-Comparison-Estimated'] = tostring(p.estimated)",
    "    ngx.header['X-Gunbc-Comparison-Currency'] = p.currency",
    "    ngx.header['X-Gunbc-Comparison-Unit'] = p.unit",
    "    ngx.header['X-Gunbc-Comparison-Read-On'] = p.as_of",
    "    ngx.header['X-Gunbc-Comparison-Source'] = p.source",
    "  end",
    "end",
  ]
}

// THE USAGE METER. Three rules make the tally worth reading, and all three live in the model:
//
// * OWNED AND RENTED TURNS ARE BOTH TALLIED, UNDER SEPARATE KEYS, AND ONLY AGAINST A QUOTE. A rented turn is
//   billed by the hour through ctrl, so its tally is token volume and a comparison value, never spend (that is
//   a second ledger for one fact, gunbc.design_argument::single_authority): stats `usage` is owned only and `usage_all` adds rented. An owned
//   card costs nothing per turn, so actual spend is zero and only the comparison value is a number.
// * A CACHED TOKEN IS DISCOUNTED ONLY IF THE ENGINE REPORTED IT. prompt_tokens_details.cached_tokens is
//   tracked separately from its VALUE: a turn whose engine never declared cache_reported is counted as
//   cache_unreported rather than silently valued at zero cached tokens, which would understate the
//   comparison and look like a win for the engine that never speaks.
// * A TURN IS MEASURED ONLY IF THE ENGINE SAID SO. usage absent, malformed, negative, fractional, or a
//   cached count above the prompt count is unmeasured or failed -- never a token count inferred from
//   text length. The router does not fabricate a number it was not given (gunbc.design_argument::fail_closed).
//
// The counters live in the shared dict under one prefix, keyed by model, so they survive a reload and a
// worker boundary; the epoch is set once at init so a reader can tell a zero from an untouched counter.
fn router_usage_key_root() -> String { "meter:v2:" }

// How long a refused conversation counts as stranded demand without retrying.
fn router_dev_pending_ttl() -> Second { second(count: 150) }

// THE CAP ON ONE ACCUMULATED USAGE FRAME. A stream whose usage frame will not fit is an error, not a
// truncated read -- a size, so it is a ByteSize like the body limits it sits beside, not a count whose
// unit nobody declared.
fn router_usage_frame_cap() -> ByteSize { mebibyte_to_byte_size(m: mebibyte(count: 2)) }

fn router_dev_body_filter_lines() -> List<String> {
  [
    "if not ngx.ctx.route or ngx.status ~= 200 then return end",
    "if ngx.arg[2] then ngx.ctx.usage_complete = true end",
    "if ngx.ctx.usage_error then return end",
    "local cjson = require('cjson.safe')",
    "local function observe(raw)",
    "  local v = cjson.decode(raw)",
    "  local u = type(v) == 'table' and v.usage",
    "  if type(u) ~= 'table' then return end",
    "  local a, b = u.prompt_tokens, u.completion_tokens",
    "  local details = u.prompt_tokens_details",
    // Two different facts: the VALUE, and whether the engine reported it at all. A missing field is not
    // a zero, so reported is kept beside cached rather than collapsed into it.
    "  local reported = type(details) == 'table' and details.cached_tokens ~= nil and details.cached_tokens ~= cjson.null",
    "  local cached = 0",
    "  if reported then cached = details.cached_tokens end",
    "  local function count(n) return type(n) == 'number' and n >= 0 and n < 9007199254740992 and n % 1 == 0 end",
    "  if count(a) and count(b) and count(cached) and cached <= a then",
    "    ngx.ctx.usage = \{prompt = a, generated = b, cached = cached, cache_reported = reported\}",
    "  else",
    "    ngx.ctx.usage_error = 'invalid token counters'",
    "  end",
    "end",
    // SSE frames are accumulated across chunks because a frame can split anywhere in the stream; the
    // buffer is capped, and a stream that exceeds the cap is an ERROR, not a truncated read.
    "local chunk = ngx.arg[1] or ''",
    "local buf = (ngx.ctx.usage_buffer or '') .. chunk",
    "if #buf > " + to_string(byte_size_count(b: router_usage_frame_cap())) + " then",
    "  ngx.ctx.usage_error = 'usage frame exceeded the cap' ngx.ctx.usage_buffer = nil return",
    "end",
    "local content = ngx.var.upstream_http_content_type or ''",
    "if content:find('text/event-stream', 1, true) then",
    "  local pos = 1",
    "  while true do",
    "    local stop = buf:find('\\n', pos, true)",
    "    if not stop then break end",
    "    local line = buf:sub(pos, stop - 1)",
    "    local data = line:match('^data:%s*(.-)%s*$')",
    "    if data and data ~= '[DONE]' then observe(data) end",
    "    pos = stop + 1",
    "  end",
    "  buf = buf:sub(pos)",
    "  if ngx.arg[2] and buf ~= '' then",
    "    local data = buf:match('^data:%s*(.-)%s*$')",
    "    if data and data ~= '[DONE]' then observe(data) end",
    "  end",
    "elseif ngx.arg[2] then",
    "  observe(buf)",
    "end",
    "if ngx.arg[2] then ngx.ctx.usage_buffer = nil else ngx.ctx.usage_buffer = buf end",
  ]
}

fn router_dev_log_lines() -> List<String> {
  [
    "local state = ngx.shared.router_state",
    "state:incr('status:' .. tostring(ngx.status), 1, 0)",
    "local u = ngx.ctx.route",
    "if u then",
    "  local k = '" + router_usage_key_root() + "' .. (u.overflow and 'rented' or 'owned') .. ':' .. u.model .. ':'",
    "  local usage = ngx.ctx.usage",
    "  state:incr(k .. 'requests', 1, 0)",
    "  if ngx.status ~= 200 or not ngx.ctx.usage_complete then",
    "    state:incr(k .. 'failed', 1, 0)",
    "  elseif usage and not ngx.ctx.usage_error then",
    // The value is summed in micros so the running total stays an integer count; the only decimal is the
    // one the stats document prints.
    "    local p = router_comparison(u.model)",
    "    state:incr(k .. 'measured', 1, 0)",
    "    state:incr(k .. 'prompt', usage.prompt, 0)",
    "    state:incr(k .. 'generated', usage.generated, 0)",
    "    state:incr(k .. 'cached', usage.cached, 0)",
    "    if not usage.cache_reported then state:incr(k .. 'cache_unreported', 1, 0) end",
    "    if p then",
    "      local micros = ((usage.prompt - usage.cached) * p.input_micro + usage.cached * p.cached_micro + usage.generated * p.output_micro) / 1000000",
    "      state:incr(k .. 'value_micro', math.floor(micros + 0.5), 0)",
    "    else",
    "      state:incr(k .. 'unpriced', 1, 0)",
    "    end",
    "  else",
    "    state:incr(k .. 'unmeasured', 1, 0)",
    "  end",
    "end",
    // Health ejection: a 5xx, 401 or 403 from an engine takes it out of the pick for a span instead of
    // letting every session rediscover it one failed turn at a time. The ejection is keyed by name, and
    // available() consults it, so a bound session moves only on this signal -- that is what keeps a hard
    // binding from stranding a session on a dead engine.
    "if ngx.ctx.counted then",
    "  state:incr('active:' .. ngx.ctx.counted, -1, 0)",
    "  state:incr('upstream:' .. ngx.ctx.counted .. ':' .. tostring(ngx.status), 1, 0)",
    "  if ngx.status >= 500 or ngx.status == 401 or ngx.status == 403 then",
    "    state:set('unavailable:' .. ngx.ctx.counted, true, " + to_string(second_count(s: router_dev_ejection())) + ")",
    "  end",
    "end",
  ]
}

// How long an engine that just failed stays out of the pick. Long enough to cover a retry storm, short
// enough that a recovered engine is back on its own; a declared duration rather than a Lua literal so it
// can be reasoned about next to the caps it interacts with, and rendered through the same std.measure
// carrier the proxy timeouts beside it use (review 86789: this file's own proxy_read_timeout is a Second).
fn router_dev_ejection() -> Second { second(count: 30) }

// HOW LONG A SESSION KEEPS ITS ENGINE without touching it. Long enough that a session surviving a lunch
// break still finds its cache, short enough that an abandoned binding cannot pin a lane forever; a
// declared duration, same carrier as the ejection above and the proxy timeouts in openresty.dag.
fn router_dev_binding_ttl() -> Second { second(count: 21600) }

// POST /router/trim-bindings with a client key: per row with a retain, keep the most recently seen bound
// sessions up to retain and unbind the rest, so each unbound session pays one cold turn elsewhere instead of
// evicting its neighbours on every turn. The least recently seen go first; a row without retain is never trimmed.
fn router_dev_trim_lines() -> List<String> {
  list_append(left: router_dev_row_lines(), right: [
    "local cjson = require('cjson.safe')",
    "local h = ngx.var.http_authorization or ''",
    "if not ROUTER_KEYS[(h:match('^Bearer%s+(.+)$') or '')] then ngx.status = 401 ngx.say('\{\"error\":\{\"message\":\"invalid api key\"}}') return end",
    "if ngx.req.get_method() ~= 'POST' then ngx.status = 405 ngx.say('\{\"error\":\{\"message\":\"POST only\"}}') return end",
    "local state = ngx.shared.router_state",
    "local by = \{}",
    "for _, k in ipairs(state:get_keys(0)) do",
    "  if k:sub(1, 8) == 'session:' then",
    "    local up = state:get(k)",
    "    up = up and (owner_of[up] or up)",
    "    if up then by[up] = by[up] or \{} table.insert(by[up], \{key = k, seen = state:get('seen:' .. k:sub(9)) or 0}) end",
    "  end",
    "end",
    "local out = \{}",
    "for _, u in ipairs(ROUTER_UPSTREAMS) do",
    "  local l = by[u.name]",
    "  if u.retain and l and #l > u.retain then",
    "    table.sort(l, function(a, b) return a.seen > b.seen end)",
    "    local n = 0",
    "    for i = u.retain + 1, #l do state:delete(l[i].key) n = n + 1 end",
    "    out[u.name] = \{bound = #l, kept = u.retain, unbound = n}",
    "  end",
    "end",
    "ngx.header['Content-Type'] = 'application/json'",
    "ngx.say(cjson.encode(out))",
  ])
}

// GET /router/stats with a client key: the tallies and the active turns per upstream, as JSON.
fn router_dev_stats_lines() -> List<String> {
  list_append(left: router_dev_row_lines(), right: [
    "local cjson = require('cjson.safe')",
    "local h = ngx.var.http_authorization or ''",
    "if not ROUTER_KEYS[(h:match('^Bearer%s+(.+)$') or '')] then ngx.status = 401 ngx.say('\{\"error\":\{\"message\":\"invalid api key\",\"type\":\"authentication_error\"}}') return end",
    "local state = ngx.shared.router_state",
    "local out = \{}",
    // The usage METER, not a re-total: every field is a counter the log phase wrote, read back as it is.
    // comparison_value_usd is the micros total printed by the same one rule the headers use, and a model
    // with no quote row appears with unpriced_requests filled and value nil -- absent, never zero.
    "local function row(model, billing, p)",
    "  local k = '" + router_usage_key_root() + "' .. billing .. ':' .. model .. ':'",
    "  local value_micro = state:get(k .. 'value_micro')",
    "  return \{",
    "    model = model, billing = billing, actual_spend_usd = billing == 'owned' and 0 or cjson.null, comparison_pricing = p,",
    "    requests = state:get(k .. 'requests') or 0,",
    "    measured_requests = state:get(k .. 'measured') or 0,",
    "    unmeasured_requests = state:get(k .. 'unmeasured') or 0,",
    "    failed_requests = state:get(k .. 'failed') or 0,",
    "    unpriced_requests = state:get(k .. 'unpriced') or 0,",
    "    prompt_tokens = state:get(k .. 'prompt') or 0,",
    "    completion_tokens = state:get(k .. 'generated') or 0,",
    "    cached_prompt_tokens = state:get(k .. 'cached') or 0,",
    "    cache_unreported_requests = state:get(k .. 'cache_unreported') or 0,",
    "    comparison_value_usd = value_micro and value_micro / 1000000 or nil\}",
    "end",
    "local meter = \{version = 2, epoch = state:get('meter:v2:epoch'), models = \{}}",
    "local all = \{version = 2, epoch = meter.epoch, models = \{}}",
    "local seen, seen_all = \{}, \{}",
    "for _, u in ipairs(ROUTER_UPSTREAMS) do",
    "  if u.in_service ~= false then",
    "    local billing = u.overflow and 'rented' or 'owned'",
    "    if billing == 'owned' and not seen[u.model] then seen[u.model] = true meter.models[#meter.models + 1] = row(u.model, 'owned', router_comparison_wire(u.model)) end",
    "    if not seen_all[billing .. ':' .. u.model] then seen_all[billing .. ':' .. u.model] = true all.models[#all.models + 1] = row(u.model, billing, router_comparison_wire(u.model)) end",
    "  end",
    "end",
    "out.usage = meter",
    "out.usage_all = all",
    // STRANDED DEMAND: distinct conversations refused now, by requested model, with the age of the oldest.
    "local pend = \{by_model = \{}, total = 0}",
    "for _, k in ipairs(state:get_keys(0)) do",
    "  local m = k:match('^pending:(.-)|')",
    "  local first = m and state:get(k)",
    "  if first then",
    "    local e = pend.by_model[m] or \{count = 0, oldest_s = 0}",
    "    e.count = e.count + 1",
    "    local age = math.floor(ngx.now() - first)",
    "    if age > e.oldest_s then e.oldest_s = age end",
    "    pend.by_model[m] = e",
    "    pend.total = pend.total + 1",
    "  end",
    "end",
    "out.pending = pend",
    // RENTED POOL ADMISSION: stranded demand asks for a card only when the rented pool is full. An uncapped
    // pool has no cap to be full against.
    // A capped row is full at its cap (0 included: no turns); an uncapped rented row admits without a ceiling,
    // so it is never full while it is in service and not ejected. Active counts read as admission reads them.
    "local rented = \{active = 0, cap = 0, uncapped = 0}",
    "local capped_active = 0",
    "local any_rented = false",
    "for _, u in ipairs(ROUTER_UPSTREAMS) do",
    "  if u.overflow and u.in_service ~= false then",
    "    any_rented = true",
    "    if u.cap == nil then",
    "      if not state:get('unavailable:' .. u.name) then rented.uncapped = rented.uncapped + 1 end",
    "      rented.active = rented.active + active(u)",
    "    else",
    "      local n = active(u)",
    "      rented.active = rented.active + n",
    "      capped_active = capped_active + n",
    "      rented.cap = rented.cap + u.cap",
    "    end",
    "  end",
    "end",
    "rented.full = any_rented and rented.uncapped == 0 and capped_active >= rented.cap",
    "out.rented = rented",
    "for _, k in ipairs(state:get_keys(0)) do if k:find('^status:') or k:find('^upstream:') or k:find('^active:') then out[k] = state:get(k) end end",
    "ngx.header['Content-Type'] = 'application/json'",
    "if ngx.var.arg_sessions == '1' then",
    "  out.sessions = \{}",
    "  for _, k in ipairs(state:get_keys(0)) do if k:find('^session:') then local id=k:sub(9) out.sessions[id]=\{upstream=state:get(k), last_seen=state:get('seen:' .. id)} end end",
    "end",
    "ngx.say(cjson.encode(out))",
  ])
}

type RouterDevSite {
  listen_address: String
  listen_port: Port
  state_dir: String
  model_alias: String
}

type RouterDevConfig
  = RouterDevConfigRendered { text: String }
  | RouterDevConfigRefused { token: String }

fn router_dev_location(up: NginxVariable, scheme: NginxVariable, key: NginxVariable, sni: NginxVariable, auth: NginxToken, host: NginxToken, bearer: NginxToken, http: NginxToken, ca: NginxToken, v1: NginxToken) -> NginxDirective {
  LocationBlock { matching: PrefixMatch { path: v1 }, body: [
    SetEmptyVariable { variable: up },
    SetLiteral { variable: scheme, value: http },
    SetEmptyVariable { variable: key },
    SetEmptyVariable { variable: sni },
    LuaPhaseBlock { phase: AccessPhase, lines: router_dev_access_lines() },
    ProxyHttpVersion11,
    ProxyBufferingDirective { value: ProxyBufferingOff },
    ProxyRequestBufferingDirective { value: ProxyRequestBufferingOff },
    ProxyNextUpstreamDirective { value: ProxyNextUpstreamOff },
    ProxyReadTimeout { timeout: second(count: 3600) },
    ProxySetHeader { header: auth, source: HeaderPrefixedVariable { prefix: bearer, variable: key } },
    ProxySetHeader { header: host, source: HeaderFromVariable { variable: up } },
    ProxySslServerNameOn,
    ProxySslName { variable: sni },
    ProxySslVerifyOn,
    ProxySslVerifyDepth { depth: 1 },
    ProxySslTrustedCertificate { path: ca },
    ProxyPassSchemeAndHostVariables { scheme: scheme, host: up },
    LuaPhaseBlock { phase: HeaderFilterPhase, lines: router_dev_header_lines() },
    LuaPhaseBlock { phase: BodyFilterPhase, lines: router_dev_body_filter_lines() },
    LuaPhaseBlock { phase: LogPhase, lines: router_dev_log_lines() },
  ] }
}

// The state dictionary's capacity, as the std.measure memory carrier: 10 MiB. The directive's own
// rendering (LuaSharedDict -> byte_size_count) already carries how a size is written; spelling "10m" here
// would be a second, informal way of stating a size the model has as ByteSize (gunbc.design_argument::single_authority).
fn router_state_dict_size() -> ByteSize { mebibyte_to_byte_size(m: mebibyte(count: 10)) }

fn router_dev_config(site: RouterDevSite) -> RouterDevConfig {
  match tok(text: site.state_dir) { Absent => RouterDevConfigRefused { token: "state_dir" } Present { value: _ } =>
  match tok(text: site.model_alias) { Absent => RouterDevConfigRefused { token: "model_alias" } Present { value: _ } =>
  match tok(text: site.listen_address) { Absent => RouterDevConfigRefused { token: "addr" } Present { value: addr } =>
  match tok(text: site.state_dir + "/tls/cert.pem") { Absent => RouterDevConfigRefused { token: "cert" } Present { value: cert } =>
  match tok(text: site.state_dir + "/tls/key.pem") { Absent => RouterDevConfigRefused { token: "certkey" } Present { value: certkey } =>
  match tok(text: site.state_dir + "/upstream_ca.pem") { Absent => RouterDevConfigRefused { token: "ca" } Present { value: ca } =>
  match tok(text: "router_state") { Absent => RouterDevConfigRefused { token: "dict" } Present { value: dict } =>
  match tok(text: "/router/stats") { Absent => RouterDevConfigRefused { token: "stats" } Present { value: stats } =>
  match tok(text: "/router/trim-bindings") { Absent => RouterDevConfigRefused { token: "trim" } Present { value: trim } =>
  match tok(text: "/v1/models") { Absent => RouterDevConfigRefused { token: "models" } Present { value: models } =>
  match tok(text: "/v1/") { Absent => RouterDevConfigRefused { token: "v1" } Present { value: v1 } =>
  match tok(text: "Authorization") { Absent => RouterDevConfigRefused { token: "auth" } Present { value: auth } =>
  match tok(text: "Host") { Absent => RouterDevConfigRefused { token: "host" } Present { value: host } =>
  match tok(text: "Bearer") { Absent => RouterDevConfigRefused { token: "bearer" } Present { value: bearer } =>
  match tok(text: "http") { Absent => RouterDevConfigRefused { token: "http" } Present { value: http } =>
  match var(text: "up") { Absent => RouterDevConfigRefused { token: "up" } Present { value: up } =>
  match var(text: "up_scheme") { Absent => RouterDevConfigRefused { token: "scheme" } Present { value: scheme } =>
  match var(text: "up_key") { Absent => RouterDevConfigRefused { token: "key" } Present { value: key } =>
  match var(text: "up_sni") { Absent => RouterDevConfigRefused { token: "sni" } Present { value: sni } =>
    RouterDevConfigRendered { text: render_nginx_directives(rows: [
      WorkerProcesses { count: 1 },
      EventsBlock,
      HttpBlock { body: [
        AccessLogOff,
        ClientMaxBodySize { size: router_request_body_limit() },
        ClientBodyBufferSize { size: router_request_body_buffer() },
        LuaSharedDict { name: dict, size: router_state_dict_size() },
        LuaPhaseBlock { phase: InitPhase, lines: router_dev_init_lines(state_dir: site.state_dir, model_alias: site.model_alias) },
        ServerBlock { body: [
          ListenTlsOn { address: addr, port: site.listen_port },
          SslCertificate { path: cert },
          SslCertificateKey { path: certkey },
          LocationBlock { matching: ExactMatch { path: models }, body: [LuaPhaseBlock { phase: ContentPhase, lines: router_dev_models_lines() }, LuaPhaseBlock { phase: LogPhase, lines: router_dev_log_lines() }] },
          LocationBlock { matching: ExactMatch { path: stats }, body: [LuaPhaseBlock { phase: ContentPhase, lines: router_dev_stats_lines() }] },
          LocationBlock { matching: ExactMatch { path: trim }, body: [LuaPhaseBlock { phase: ContentPhase, lines: router_dev_trim_lines() }] },
          router_dev_location(up: up, scheme: scheme, key: key, sni: sni, auth: auth, host: host, bearer: bearer, http: http, ca: ca, v1: v1),
        ] },
      ] },
    ]) }
  } } } } } } } } } } } } } } } } } } }
}

// The srv1 site (operator decision 2026-10-25): HTTPS on the host's 1G address, state mounted at
// /etc/router in the container from /home/briansrls/router on the host, and the pool alias flash-next.
fn router_dev_srv1_site() -> RouterDevSite {
  RouterDevSite { listen_address: "192.168.1.203", listen_port: 18443, state_dir: "/etc/router", model_alias: "flash-next" }
}

// The hand-run deploy's render step: writes the proxy's nginx.conf into the host state directory the
// container mounts, and refuses (exit 1) when the site's tokens are refused or the write fails:
// gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/serving/router_dev_policy.dag --function router_dev_srv1_write_config
fn router_dev_srv1_host_config_path() -> String { "/home/briansrls/router/nginx.conf" }

fn router_dev_srv1_write_config() -> ProcessExit {
  match router_dev_first_party_refusal(fp: router_dev_first_party()) {
    Present { value: refused } => refused
    Absent => match router_dev_config(site: router_dev_srv1_site()) {
    RouterDevConfigRefused { token: k } => ExitFailure { code: 1, reason: concat("refused token: ", k) }
    RouterDevConfigRendered { text: t } => {
        let w = Filesystem.Write(path: router_dev_srv1_host_config_path(), content: t)
        if w.success { ExitSuccess } else { ExitFailure { code: 1, reason: concat("write failed: ", w.error) } }
      }
    }
  }
}

// THE UPSTREAM ROWS THE PROXY ROUTES TO, in the router's terms. The launch facts (name, scheme, address,
// port, the TLS name its certificate is verified against, the advertised model id) belong to the serving
// launch that answers there; cap (active turns) is router policy; the key is a secret, never in a row, and
// is joined in by name at deploy. The first-party rows are literals until the launch model lands
// (sharp-ram-303's extdeps.vllm.lil_serve row for srv1), which then yields them.
type RouterUpstreamScheme
  = | UpstreamHttp
  | UpstreamHttps

// max_model_len is the upstream's context window under vLLM's own member name, the one a pool client reads from
// /v1/models to place a session (ctrl pool-router refuses a router whose list carries none). srv1 vLLM reports
// 262144 itself; srv3 Strata reports none, so its row carries the engine's configured n_ctx, 229376. The router
// answers each model id with the MIN over that model's upstreams, and the alias with the min over all of them.
type RouterDevUpstream {
  name: String
  scheme: RouterUpstreamScheme
  host: String
  port: Port
  tls_name: String?
  model: String
  capacity: RouterDevCapacity
  max_model_len: Int
  path_prefix: String
  // A previous name for the SAME engine, kept while its in-flight requests finish. The turn counter is
  // keyed by name, so without this a rename loses those turns from the active count. The writer refuses a
  // name here that is any row's live name or appears in two lists, so a live lane is never capped by its
  // twin's turns.
  retiring_names: List<String>
  // False when the host is out of service. An out-of-service row renders no upstream, no route and no
  // model entry, so a render cannot silently re-add it, and a stale binding cannot reach it; coming back
  // online is a change to this field, not an edit to a file on the box. This is how srv3 was drained on
  // 2026-10-26 (DIMMs at 104C with corrected ECC errors) and restored the same day with the memory
  // capped at 40 W by a systemd drop-in -- both facts moved through this row, neither through nginx.conf.
  in_service: Bool
  // How many conversations this row keeps bound (retention admission): a NEW session binds here only while
  // fewer are bound, and a bound session always returns. See RouterDevRetention.
  retention: RouterDevRetention
  // This model's reasoning-effort dialect (RouterDevEffortRule). Empty passes the client's value through.
  effort_effects: List<RouterDevEffortRule>
  // The standings the row's cap and retain rest on: empty when they are derived from cited or observed figures
  // (or are not derived at all), else every uncited figure the capacity shape used, kept typed. Their read
  // obligations are rendered, so the shipped file says which of its numbers are bets.
  capacity_rests_on: List<CitedFigureStanding>
}

// WHAT CAPS A ROW'S ACTIVE TURNS: an owned card's ceiling, 0 included (no turns).
//
// One integer read two ways was the meaning fork #15113 found: 0 meant "no turns" on an owned row and
// "uncapped" on a rented one, and only the row's billing told the two readings apart. The rented arms said it
// instead of the integer; they are retired with the roster's last rented row (operator decision 2026-11-10: no
// rented lane is in use), so a capacity in this model is an owned ceiling and a row with no ceiling cannot be
// written. The proxy still carries the rented arm of its scoring and metering -- the wire is wider than the
// roster, because upstreams.json is a hand-kept file the operator may hand a rented row into, and
// gunbc.instruments.router_proxy_falsifier falsifies that arm from its own fixture rows -- so a row the model
// cannot produce is still a row the instrument proves the proxy handles.
//
// Congestion never moves a bound session (operator 2026-10-28: one placement per conversation; deliberate moves
// come only through the relocation operation). So no row's locality is a fact the router branches on: every
// capped row holds a bound session at its cap with 429 + Retry-After and a stranded record, and the former
// per-row cache_locality field, which only EngineLocal rows honoured, is gone.
type RouterDevCapacity
  = OwnedCap { turns: Nat }

// HOW MANY CONVERSATIONS A ROW RETAINS. Every first-party row's count, and its active-turn cap, is DERIVED from
// its deployment's capacity anchor (gunbc.serving.serving_capacity_anchor serving_capacity_shape: throughput at the
// anchor context, the conversation policy and the swap path) and never typed here. A refused shape never reaches
// a row: router_dev_shaped refuses, and every writer stops. A layout that is refused or names no replica for a
// group refuses the h11 projection the same way.
type RouterDevRetention
  = NoRetention
  | RetentionAdmitted { conversations: Nat }

// HOW ONE CLIENT REASONING-EFFORT NAME IS ANSWERED BY ONE UPSTREAM MODEL'S SERVER. The pool alias and
// each engine accept a DIFFERENT set of effort names, and an engine answers 400 on a name it does not
// implement, so the translation is a property of that model's server: a row, not Lua prose. RewriteTo
// sends a name the engine does implement (iq3_s has no xhigh; its nearest is high). DropThinking removes
// the client's key and turns the engine's own thinking switch off -- "none" means no reasoning tokens,
// which for the Qwen chat template is enable_thinking=false, not an effort string. A name with no rule
// passes through unchanged, so the engine still refuses what it does not implement.
type RouterDevEffortEffect
  = | EffortRewriteTo { value: String }
  | EffortDropThinking

type RouterDevEffortRule {
  client: String
  effect: RouterDevEffortEffect
}

fn router_dev_effort_rule_value(r: RouterDevEffortRule) -> JsonValue {
  match r.effect {
    EffortRewriteTo { value: v } => json_object(members: [
      json_kv(key: "client", value: json_string(s: r.client)),
      json_kv(key: "to", value: json_string(s: v)),
    ])
    EffortDropThinking => json_object(members: [
      json_kv(key: "client", value: json_string(s: r.client)),
      json_kv(key: "drop_thinking", value: json_bool(b: true)),
    ])
  }
}

fn no_effort_rules() -> List<RouterDevEffortRule> { [] }

// The effort names the dashboard sends, and what the alias must accept: the alias has to answer every
// name a client may use, and it is the row set behind it that decides which engine can honour it.
fn qwen3_effort_rules() -> List<RouterDevEffortRule> {
  [
    // vLLM's Qwen3.8-Flash-Next template implements xhigh/medium/low and refuses "high" with a 400.
    RouterDevEffortRule { client: "high", effect: EffortRewriteTo { value: "xhigh" } },
    RouterDevEffortRule { client: "none", effect: EffortDropThinking },
  ]
}

fn iq3_s_effort_rules() -> List<RouterDevEffortRule> {
  [RouterDevEffortRule { client: "xhigh", effect: EffortRewriteTo { value: "high" } }]
}

fn upstream_scheme_text(s: RouterUpstreamScheme) -> String {
  match s { UpstreamHttp => "http" UpstreamHttps => "https" }
}

// One upstream row as a JsonValue, rendered by the repository's JSON emitter (extdeps.languages.json.emit),
// which escapes every string from its named and control-character escape rows.
fn router_dev_upstream_value(u: RouterDevUpstream) -> JsonValue {
  let tls = match u.tls_name { Present { value: n } => [json_kv(key: "sni", value: json_string(s: n))] Absent => no_members() }
  json_object(members: concat(concat(concat([
    json_kv(key: "name", value: json_string(s: u.name)),
    json_kv(key: "scheme", value: json_string(s: upstream_scheme_text(s: u.scheme))),
    json_kv(key: "host", value: json_string(s: u.host)),
    json_kv(key: "port", value: json_int(n: u.port as Int)),
  ], tls), [
    json_kv(key: "model", value: json_string(s: u.model)),
    json_kv(key: "max_model_len", value: json_int(n: u.max_model_len)),
    json_kv(key: "path_prefix", value: json_string(s: u.path_prefix)),
    json_kv(key: "retiring_names", value: json_array(elements: map(u.retiring_names, n => json_string(s: n)))),
    json_kv(key: "effort_effects", value: json_array(elements: map(u.effort_effects, r => router_dev_effort_rule_value(r: r)))),
    json_kv(key: "in_service", value: json_bool(b: u.in_service)),
  ]), concat(concat(router_dev_capacity_members(c: u.capacity), router_dev_retention_members(r: u.retention)),
    if count(u.capacity_rests_on) == 0 { no_members() } else { [json_kv(key: "capacity_rests_on", value: json_array(elements: map(standings_obligations(ss: u.capacity_rests_on), o => json_string(s: o))))] })))
}

fn no_members() -> List<JsonKeyValue> { [] }

fn router_dev_capacity_members(c: RouterDevCapacity) -> List<JsonKeyValue> {
  match c {
    OwnedCap { turns: n } => [json_kv(key: "overflow", value: json_bool(b: false)), json_kv(key: "cap", value: json_int(n: n as Int))]
  }
}

fn router_dev_retention_members(r: RouterDevRetention) -> List<JsonKeyValue> {
  match r {
    RetentionAdmitted { conversations: n } => [json_kv(key: "retain", value: json_int(n: n as Int))]
    NoRetention => no_members()
  }
}

// A ROW SHAPED BY ITS DEPLOYMENT'S CAPACITY ANCHOR: the derived turns are the row's cap and the derived held
// conversations its retain. A refused shape is a refusal carrying the deployment and its reason.
type RouterDevShaped
  = RouterDevShapedRow { row: RouterDevUpstream }
  | RouterDevShapeRefused { reason: String }

// WHETHER THE ROUTER ADMITS AN ESTIMATED CAPACITY SHAPE, and on whose word. An estimate is never promoted to a
// derived figure: under AdmitEstimatedCapacity its row is rendered WITH the obligations it rests on; under
// AdmitDerivedCapacityOnly it refuses the write, naming them.
type RouterDevCapacityAdmission
  = AdmitEstimatedCapacity { directive: NonEmptyStr }
  | AdmitDerivedCapacityOnly

// The operator's directive of 2026-11-08 (this session): "start with a heuristic anchor -- average 100k context ->
// average throughput for that load per card/deployment, and then, we can derive the config we need from there".
data router_dev_capacity_admission: RouterDevCapacityAdmission = AdmitEstimatedCapacity {
  directive: "operator 2026-11-08: start with a heuristic anchor (100k context -> per-deployment throughput) and derive the router config from it" as NonEmptyStr,
}

fn standings_obligations(ss: List<CitedFigureStanding>) -> List<String> {
  fold(ss, init: [], f: (acc, s) => match cited_figure_read_obligation(standing: s) {
    Present { value: o } => concat(acc, [o as String])
    Absent => acc
  })
}

fn router_dev_shaped_under(shape: ServingCapacityShape, admission: RouterDevCapacityAdmission, row: fn(RouterDevCapacity, RouterDevRetention, List<CitedFigureStanding>) -> RouterDevUpstream) -> RouterDevShaped {
  match shape {
    ServingShapeRefused { deployment: d, reason: r } => RouterDevShapeRefused { reason: concat("capacity shape refused for ", concat(d as String, concat(": ", serving_shape_refusal_message(reason: r)))) }
    ServingShapeDerived { deployment: _, turns: t, held: h, bound: _, cold_reread: _ } => RouterDevShapedRow { row: row(OwnedCap { turns: t }, RetentionAdmitted { conversations: h }, []) }
    ServingShapeEstimated { deployment: d, turns: t, held: h, bound: _, cold_reread: _, standings: ss } => match admission {
      AdmitEstimatedCapacity { directive: _ } => RouterDevShapedRow { row: row(OwnedCap { turns: t }, RetentionAdmitted { conversations: h }, ss) }
      AdmitDerivedCapacityOnly => RouterDevShapeRefused { reason: concat("capacity shape for ", concat(d as String, concat(" is an estimate and this router admits only derived capacity; it rests on: ", join(standings_obligations(ss: ss), "; ")))) }
    }
  }
}

fn router_dev_shaped(shape: ServingCapacityShape, row: fn(RouterDevCapacity, RouterDevRetention, List<CitedFigureStanding>) -> RouterDevUpstream) -> RouterDevShaped {
  router_dev_shaped_under(shape: shape, admission: router_dev_capacity_admission, row: row)
}

// WHICH ANCHOR A PROJECTED ROW'S CAP AND RETAIN ARE DERIVED FROM, chosen by the naming row and nowhere else. The
// projection never picks a capacity formula; a naming that names no anchor the anchor module has a formula for is
// refused, never defaulted to a plausible number (gunbc.design_argument::fail_closed). The bus lives INSIDE the h11
// arm: an h11 row is addressed by bus and needs one, srv3/srv4 carry none, so the state "an h11 row with no bus"
// (which the projection had to refuse at run time) cannot be written -- construction where a check used to stand.
// A REPLICABLE SHAPE SOURCE. h11's, srv3's and srv4's are named because their capacity rests on host-specific
// machinery (h11's per-card warm store on the bus, srv3/srv4's fixed layer-split profile). `AnchorStrataProfile`
// is the OPEN arm (B4a): a host whose Strata shape is a profile carried as DATA -- its throughput figures, cards
// and context come from the profile row, so adding a serving host is a profile row and a roster row, never a new
// named anchor or a new `router_dev_first_party_for` argument. A profile with no throughput reading yet (a host
// that has never served -- the not-yet-deployed case) yields an unread shape here, which the projection names but
// keeps out of service rather than refusing the whole router.
type RouterDevReplicaAnchor = AnchorH11Strata { bus: String } | AnchorSrv3Strata | AnchorSrv4Strata | AnchorStrataProfile { profile: ServingReplicaProfile } | AnchorStrataUnread { obligation: NonEmptyStr }

// h11's group is the bus, prefixed -- the layout names its h11 device groups "h11-strata@<bus>", so deriving the
// group from the bus keeps the two from drifting apart (review 92443): the bus is stated once, on the anchor.
fn router_dev_h11_group(bus: String) -> String {
  concat("h11-strata@", bus)
}

// An h11 replica naming, built from the bus ONCE: the group and the anchor's bus are both derived from that one
// figure, so a row cannot say one bus in its group and another in its anchor.
fn router_dev_h11_naming(name: String, port: Nat, bus: String, retiring: List<String>) -> RouterDevReplicaNaming {
  RouterDevReplicaNaming {
    group: router_dev_h11_group(bus: bus),
    name: name,
    scheme: UpstreamHttp,
    host: "192.168.1.202",
    port: port,
    tls_name: Absent,
    anchor: AnchorH11Strata { bus: bus },
    retiring: retiring,
  }
}

// The anchor, at the admission the JOINED REPLICA has. h11's needs the bus (its warm store is that card's engine
// memory row) and the replica's own admitted conversations (one replica per card, so the join gives it exactly
// one); srv3's and srv4's anchors take their grant from their own single layer-split replica, so for them the
// replica's identity and admission arrive and are not needed — the join is still what makes the row exist.
fn router_dev_replica_shape(n: RouterDevReplicaNaming, admitted: Nat) -> ServingCapacityShape {
  match n.anchor {
    AnchorH11Strata { bus: b } => h11_strata_shape(deployment: n.name, bus: b, admitted: admitted)
    AnchorSrv3Strata => srv3_strata_shape()
    AnchorSrv4Strata => srv4_strata_shape()
    AnchorStrataProfile { profile: p } => replica_shape_named(p: p, deployment: n.name)
    // A named replica whose throughput has never been read -- a host admitted but not yet serving. It carries the
    // very refusal `serving_capacity_shape` raises for ThroughputUnread, so the projection turns it into a named
    // not-in-service row rather than a refusal. `obligation` names whose job it is to produce the reading.
    AnchorStrataUnread { obligation: _ } => ServingShapeRefused { deployment: n.name as String, reason: ShapeThroughputUnread }
  }
}

// A PROJECTED ROW: the naming's endpoint facts, the capacity and retention its anchor derives. Every row that
// comes out of a layout is the same Strata iq3_s engine on the same context ceiling, which is why one builder
// serves h11, srv3 and srv4; srv1's vLLM replicas are not layout-projected and stay in the head.
fn router_dev_replica_row(n: RouterDevReplicaNaming, admitted: Nat) -> RouterDevShaped {
  router_dev_shaped(shape: router_dev_replica_shape(n: n, admitted: admitted), row: (cap, retention, rests) => RouterDevUpstream {
    name: n.name, scheme: n.scheme, host: n.host, port: n.port, tls_name: n.tls_name,
    model: "qwen3.8-flash-next-iq3_s", capacity: cap, max_model_len: 229376, path_prefix: "",
    retiring_names: n.retiring, in_service: true,
    retention: retention,
    effort_effects: iq3_s_effort_rules(),
    capacity_rests_on: rests,
  })
}

// IS THIS SHAPE REFUSED *BECAUSE THE THROUGHPUT IS UNREAD*? A replica with no throughput reading is a host that
// has never served -- not a broken host. It is caught by matching the typed `ShapeThroughputUnread` failure mode
// (serving_capacity_anchor), so the "named but not in service" arm fires for precisely that case and for nothing
// else: any OTHER shape refusal (mutable model, batch-disabled store, unread build, too-slow swap) is still a hard
// refusal, because those are faults, not absences of reading (fail_closed). Matching the constructor, not a reason
// string, is what keeps the router and the anchor from drifting apart (single_authority).
fn router_dev_shape_is_throughput_unread(shape: ServingCapacityShape) -> Bool {
  match shape {
    ServingShapeRefused { deployment: _, reason: ShapeThroughputUnread } => true
    _ => false
  }
}

// A NAMED-BUT-NOT-IN-SERVICE ROW (B4a): the naming's endpoint facts (name, scheme, address, port, TLS) so the
// replica is NAMED and discoverable, with a zero owned cap, no retention and `in_service: false` so the router
// never sends a turn to an engine that has never produced a throughput reading. This is the finding's "a replica
// with no throughput reading is named but not in service (its own arm) instead of refusing the whole router": the
// row exists and says so, and its host's refusal -- if it had none -- would refuse only itself, never its
// siblings' rows.
fn router_dev_unread_row(n: RouterDevReplicaNaming) -> RouterDevUpstream {
  RouterDevUpstream {
    name: n.name, scheme: n.scheme, host: n.host, port: n.port, tls_name: n.tls_name,
    model: "qwen3.8-flash-next-iq3_s", capacity: OwnedCap { turns: 0 }, max_model_len: 229376, path_prefix: "",
    retiring_names: n.retiring, in_service: false,
    retention: NoRetention,
    effort_effects: iq3_s_effort_rules(),
    capacity_rests_on: [] as List<CitedFigureStanding>,
  }
}

// THE ROWS FOLLOW EACH HOST'S LAYOUT REPLICA SET (operator ruling 2026-11-01, A-prime; live parity, #15622 applied
// 21:11-21:13Z; generalized to every owned Strata host 2026-11-09). An engine's NAME, address, port and retired
// names are a naming fact; its EXISTENCE and its capacity are its layout's: a replica the layout does not grant
// yields no row, so a router roster cannot outlive the grant, and an engine the naming table lists that no replica
// names is omitted — that is the A-prime case (c5/c7 left the grant). The table of h11 engine rows this replaced
// (RouterDevH11Engine / router_dev_h11_engines) is deleted: every field it carried lives in a naming row now.

// ONE GRANTED REPLICA'S ROUTER NAMING: the row's NAME, address, port, TLS and retired names — the facts only the
// naming can give — plus the LAYOUT GROUP it is this router's face for, and the anchor its capacity rests on.
// h11 names one row per card, because its layout grants one replica per card and the bus is what distinguishes
// them; srv3 and srv4 name ONE row each, because their layout grants one replica that spans both cards. The
// naming row is not a claim that the replica exists: only its layout's grant is that.
type RouterDevReplicaNaming {
  group: String
  name: String
  scheme: RouterUpstreamScheme
  host: String
  port: Port
  tls_name: String?
  anchor: RouterDevReplicaAnchor
  retiring: List<String>
}

// h11's naming. Its groups are h11-strata@<bus>; the router's NAME is not the bus (h11-05 is bus 85, h11-88 is
// bus c8), and the port follows the engine, not the name. The bus is what its anchor needs for the warm store.
fn router_dev_h11_namings() -> List<RouterDevReplicaNaming> {
  [
    router_dev_h11_naming(name: "h11-05", port: 18081, bus: "85", retiring: ["h11-a16-0"]),
    router_dev_h11_naming(name: "h11-07", port: 18083, bus: "87", retiring: ["h11-a16-2"]),
    router_dev_h11_naming(name: "h11-08", port: 18084, bus: "88", retiring: ["h11-a16-3"]),
    router_dev_h11_naming(name: "h11-88", port: 18088, bus: "c8", retiring: []),
  ]
}

// srv3's naming: ONE row, because its layout grants ONE replica across both cards (--layer-split 24 is one engine,
// so one endpoint — the second card is not a second upstream). Its engine listens plain on 18080; there is no TLS
// front on srv3. It retires h11-c1, the lane whose turns it took over. Its cap and retain are its anchor's, and
// that anchor's grant is srv3_layout's admitted retention — the hand-typed "OwnedCap turns 4" that stood here is
// gone, and the reason it was wrong is in the frontier below.
fn router_dev_srv3_namings() -> List<RouterDevReplicaNaming> {
  [RouterDevReplicaNaming { group: "strata-pool", name: "srv3-strata", scheme: UpstreamHttp, host: "192.168.1.221", port: 18080, tls_name: Absent, anchor: AnchorSrv3Strata, retiring: ["h11-c1"] }]
}

// srv4's naming, and THE ANSWER TO "TWO ENGINES, WHICH ENDPOINT?" (the operator-route question the original brief
// raised): there are not two. srv4's layout grants ONE replica spanning both cards, so the operator route
// (gunbc.harness.harness_operator_route, #16043: the srv4 TLS front to one endpoint, no fallback) addresses one
// engine and stays right. If srv4 is ever laid out as one replica per card, this naming table grows a row per card
// with its own port and the operator route must say which replica it fronts — that is a layout change, and the
// projection makes a silent answer impossible because the row set is then no longer one. Its engine serves TLS
// with CN=srv4 on 18443.
fn router_dev_srv4_namings() -> List<RouterDevReplicaNaming> {
  [RouterDevReplicaNaming { group: "gunbc-srv4-daily-engine", name: "srv4-strata", scheme: UpstreamHttps, host: "192.168.1.196", port: 18443, tls_name: Present { value: "srv4" }, anchor: AnchorSrv4Strata, retiring: [] }]
}

// THE PROJECTION READS THE CONFIGURED LAYOUT ONCE and joins each granted replica to its router naming by group,
// deriving the row's capacity and retention from THAT replica. It is h11's projection with h11's address, port
// and bus taken out of it (operator ruling 2026-11-01, A-prime, generalized 2026-11-09 so srv3 and srv4 are
// projected by the same rule and not cloned — gunbc.design_argument::root_generalization). It REFUSES, never
// narrows: a refused layout, a granted replica with no naming, and a granted replica with more than one naming are
// each a typed refusal that stops the write before any row is rendered. A naming no replica names is the only
// thing omitted — that is the A-prime case (c5/c7 left the grant), and it is the case that makes a layout refusal
// loud rather than a quietly smaller fleet: a refused layout yields NO replicas, and the writer that requires this
// host's rows then refuses the whole write.
type RouterDevReplicaProjection
  = RouterDevReplicaProjected { rows: List<RouterDevUpstream> }
  | RouterDevReplicaRefused { reason: String }

fn router_dev_replica_projection(host: String, layout: ServingLayoutResult, namings: List<RouterDevReplicaNaming>) -> RouterDevReplicaProjection {
  match layout {
    ServingLayoutRefused { refusal: _ } => RouterDevReplicaRefused { reason: concat("the serving layout of ", concat(host, " is refused, so no row set can be derived for it")) }
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } =>
      fold(rs, init: RouterDevReplicaProjected { rows: [] }, f: (acc, c) =>
        match acc {
          RouterDevReplicaRefused { reason: r } => RouterDevReplicaRefused { reason: r }
          RouterDevReplicaProjected { rows: so_far } => {
            let g = c.group as String
            let named = filter(namings, n => n.group == g)
            if count(named) == 0 { RouterDevReplicaRefused { reason: concat("a granted replica of ", concat(host, concat(" has no router naming: ", g))) } }
            else if count(named) > 1 { RouterDevReplicaRefused { reason: concat("a granted replica of ", concat(host, concat(" has more than one router naming: ", g))) } }
            else {
              fold(named, init: RouterDevReplicaProjected { rows: so_far }, f: (inner, n) =>
                match inner {
                  RouterDevReplicaRefused { reason: r } => RouterDevReplicaRefused { reason: r }
                  RouterDevReplicaProjected { rows: rows } =>
                    if router_dev_shape_is_throughput_unread(router_dev_replica_shape(n: n, admitted: c.admitted_conversations)) {
                      // A replica with no throughput reading is a host that has never served. Name it, keep it
                      // out of service, and carry on -- it is excluded, not a cause to refuse its siblings.
                      RouterDevReplicaProjected { rows: concat(rows, [router_dev_unread_row(n)]) }
                    } else {
                      match router_dev_replica_row(n: n, admitted: c.admitted_conversations) {
                        RouterDevShapeRefused { reason: r } => RouterDevReplicaRefused { reason: r }
                        RouterDevShapedRow { row: u } => RouterDevReplicaProjected { rows: concat(rows, [u]) }
                      }
                    }
                })
            }
          }
        })
  }
}

type RouterDevFirstParty
  = RouterDevFirstPartyRows { rows: List<RouterDevUpstream> }
  | RouterDevFirstPartyRefused { reason: String }

// THE FIRST-PARTY SET: the head, then every layout-projected host. Each host is projected by the
// SAME rule from ITS OWN layout, and any one of them refusing refuses the whole set — a router can never be
// rendered from a fleet that a layout does not grant.
// A HOST'S PLACE IN THE FIRST-PARTY ROUTER (B4a): the host label its rows are keyed by, the layout that grants
// its replicas, and the namings that name them. This is the shape the finding asked for -- the router is a list
// keyed by host, not a fixed h11/srv3/srv4 arity. Adding a serving host is another `RouterDevHostRoster` row,
// never a new argument to `router_dev_first_party_for` or a new named anchor.
type RouterDevHostRoster {
  host: String
  layout: ServingLayoutResult
  namings: List<RouterDevReplicaNaming>
}

// THE FLEET'S FIRST-PARTY ROSTER, as data. srv3 and srv4 join h11 here as rows; a fourth host -- another Strata
// engine on a new machine -- is another row in this list (or one passed to router_dev_first_party_for_roster
// directly), with no change to the fold below. The per-host name is a key, not a branch (operator ruling D2).
fn router_dev_host_roster() -> List<RouterDevHostRoster> {
  [
    RouterDevHostRoster { host: "h11", layout: host_6ce85c_layout, namings: router_dev_h11_namings() },
    RouterDevHostRoster { host: "srv3", layout: srv3_layout, namings: router_dev_srv3_namings() },
    RouterDevHostRoster { host: "srv4", layout: srv4_layout, namings: router_dev_srv4_namings() },
  ]
}

// THE FIRST-PARTY ROWS, FOLDED OVER A HOST-KEYED ROSTER. Every host's projection is collected in roster order; a
// hard refusal (a naming the layout does not grant, a shape refused for a reason other than an unread throughput)
// refuses the whole router -- fail closed, a smaller fleet is never read as the fleet. A throughput-unread replica
// was already turned into a named-not-in-service row inside the projection, so it never reaches this refusal path
// and cannot refuse its siblings. head (srv1's vLLM) and tail (the rented pool) bracket the projected hosts, and
// the projections are checked before the head so a projection's reason wins, as it did when the three hosts were
// chained by hand.
fn router_dev_first_party_for_roster(roster: List<RouterDevHostRoster>) -> RouterDevFirstParty {
  match fold(roster, init: RouterDevFirstPartyRows { rows: [] }, f: (acc, r) =>
    match acc {
      RouterDevFirstPartyRefused { reason: rr } => RouterDevFirstPartyRefused { reason: rr }
      RouterDevFirstPartyRows { rows: so_far } =>
        match router_dev_replica_projection(host: r.host, layout: r.layout, namings: r.namings) {
          RouterDevReplicaRefused { reason: rr } => RouterDevFirstPartyRefused { reason: rr }
          RouterDevReplicaProjected { rows: hr } => RouterDevFirstPartyRows { rows: concat(so_far, hr) }
        }
    }) {
    RouterDevFirstPartyRefused { reason: rr } => RouterDevFirstPartyRefused { reason: rr }
    RouterDevFirstPartyRows { rows: projected } => match router_dev_first_party_head() {
      RouterDevFirstPartyRefused { reason: r } => RouterDevFirstPartyRefused { reason: r }
      RouterDevFirstPartyRows { rows: head } => RouterDevFirstPartyRows { rows: concat(head, projected) }
    }
  }
}

// THE THREE FIRST-PARTY HOSTS AS THEY ARE TODAY, expressed as a roster and folded generically. The signature is
// kept (the falsifier and existing readers call it with the three layouts); it no longer hardcodes the fold -- it
// builds a roster of the same three hosts and hands it to the host-keyed fold above. h11, srv3 and srv4 therefore
// produce exactly the rows they did when the three were chained by hand: unchanged in outcome.
fn router_dev_first_party_for(h11: ServingLayoutResult, srv3: ServingLayoutResult, srv4: ServingLayoutResult) -> RouterDevFirstParty {
  router_dev_first_party_for_roster([
    RouterDevHostRoster { host: "h11", layout: h11, namings: router_dev_h11_namings() },
    RouterDevHostRoster { host: "srv3", layout: srv3, namings: router_dev_srv3_namings() },
    RouterDevHostRoster { host: "srv4", layout: srv4, namings: router_dev_srv4_namings() },
  ])
}

fn router_dev_first_party() -> RouterDevFirstParty {
  router_dev_first_party_for_roster(router_dev_host_roster())
}

// THE LIVE ROW SET (read from srv1's upstreams.json field names and values, 2026-10-31, and srv4's row added there
// 2026-11-04; keys are joined at deploy and are in no row). The h11 engines follow the layout grant (four since
// A-prime), srv1's vLLM, and srv3's and srv4's Strata. Every row's cap and retain are
// its capacity shape (gunbc.serving.serving_capacity_anchor). Retiring names count old-worker turns during a
// graceful rename.
// router_dev_first_party() is the one reader: a refused projection is a refusal and never reads as no rows or
// a smaller fleet.

// srv1 serves as two TP=1 replicas, one container per RTX PRO 6000 (operator, 2026-11-08): lil-flash-next on 18000 and
// lil-flash-next-1 on 18001, each with its own LMCache and TLS (CN=pool-card). The router splits traffic between them.
fn router_dev_head_shaped() -> List<RouterDevShaped> {
  [
    router_dev_shaped(shape: srv1_vllm_replica_shape(deployment: "srv1-vllm"), row: (cap, retention, rests) => RouterDevUpstream { name: "srv1-vllm", scheme: UpstreamHttps, host: "127.0.0.1", port: 18000, tls_name: Present { value: "pool-card" }, model: "Qwen3.8-Flash-Next", capacity: cap, max_model_len: 229376, path_prefix: "", retiring_names: [], in_service: true, retention: retention, effort_effects: qwen3_effort_rules(), capacity_rests_on: rests }),
    router_dev_shaped(shape: srv1_vllm_replica_shape(deployment: "srv1-vllm-1"), row: (cap, retention, rests) => RouterDevUpstream { name: "srv1-vllm-1", scheme: UpstreamHttps, host: "127.0.0.1", port: 18001, tls_name: Present { value: "pool-card" }, model: "Qwen3.8-Flash-Next", capacity: cap, max_model_len: 229376, path_prefix: "", retiring_names: [], in_service: true, retention: retention, effort_effects: qwen3_effort_rules(), capacity_rests_on: rests }),
  ]
}

fn router_dev_first_party_head() -> RouterDevFirstParty {
  fold(router_dev_head_shaped(), init: RouterDevFirstPartyRows { rows: [] }, f: (acc, s) =>
    match acc {
      RouterDevFirstPartyRefused { reason: r } => RouterDevFirstPartyRefused { reason: r }
      RouterDevFirstPartyRows { rows: rs } => match s {
        RouterDevShapeRefused { reason: r } => RouterDevFirstPartyRefused { reason: r }
        RouterDevShapedRow { row: u } => RouterDevFirstPartyRows { rows: concat(rs, [u]) }
      }
    })
}

fn router_dev_first_party_json(fp: RouterDevFirstParty) -> String? {
  match fp {
    RouterDevFirstPartyRows { rows: rs } => Present { value: serialize_json(v: json_array(elements: map(rs, u => router_dev_upstream_value(u: u)))) }
    RouterDevFirstPartyRefused { reason: _ } => Absent
  }
}

// The deploy's second render step: the first-party rows, without keys, for the deploy to join keys into
// by name, including the dedicated ctrl overflow credential. Rentals remain behind ctrl.
// gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/serving/router_dev_policy.dag --function router_dev_srv1_write_first_party_upstreams
// A NAME CANNOT BE BOTH A LIVE UPSTREAM AND A RETIRING NAME. The pick loop sums a row's active turns
// over its retiring names (a session keeps its binding across a rename), so a live name sitting in
// another row's retiring list makes an idle engine look busy and the client takes a 429 from a card
// that has no turns on it. Nothing at runtime reports that: the tally is simply wrong, and a wrong
// answer is what gunbc.design_argument::fail_closed forbids ("every path succeeds fully or fails with a typed, located
// diagnostic"). The write is the only place that can still refuse, so it does.
// A drained row's name is not live: retiring a session off an engine taken out of service is exactly
// what the list is for (the srv3-strata rows carry the buses they replaced).
fn upstream_name_is_live(name: String, rows: List<RouterDevUpstream>) -> Bool {
  fold(rows, init: false, f: (found, u) => found || (u.in_service && u.name == name))
}

fn upstream_retiring_holders(name: String, rows: List<RouterDevUpstream>) -> Int {
  fold(rows, init: 0, f: (n, u) =>
    fold(u.retiring_names, init: n, f: (m, old) => if old == name { m + 1 } else { m }))
}

fn router_dev_retiring_name_conflict(rows: List<RouterDevUpstream>) -> String? {
  fold(rows, init: Absent, f: (acc, u) =>
    match acc {
      Present { value: v } => Present { value: v }
      Absent => fold(u.retiring_names, init: Absent, f: (inner, old) =>
        match inner {
          Present { value: v } => Present { value: v }
          Absent => if upstream_name_is_live(name: old, rows: rows) {
            Present { value: concat("a retiring name is also a live upstream: ", old) }
          } else if upstream_retiring_holders(name: old, rows: rows) > 1 {
            Present { value: concat("a retiring name is claimed by more than one row: ", old) }
          } else { Absent }
        })
    })
}

fn router_dev_row_refusal(rows: List<RouterDevUpstream>) -> ProcessExit? {
  match router_dev_retiring_name_conflict(rows: rows) {
    Present { value: why } => Present { value: ExitFailure { code: 1, reason: concat("refused upstream rows: ", why) } }
    Absent => Absent
  }
}

fn router_dev_first_party_refusal(fp: RouterDevFirstParty) -> ProcessExit? {
  match fp {
    RouterDevFirstPartyRefused { reason: r } => Present { value: ExitFailure { code: 1, reason: concat("refused upstream rows: ", r) } }
    RouterDevFirstPartyRows { rows: rs } => router_dev_row_refusal(rows: rs)
  }
}

fn router_dev_srv1_write_first_party_upstreams() -> ProcessExit {
  match router_dev_first_party_refusal(fp: router_dev_first_party()) {
    Present { value: refused } => refused
    Absent => match router_dev_first_party_json(fp: router_dev_first_party()) {
      Absent => ExitFailure { code: 1, reason: "refused upstream rows: no first-party projection" }
      Present { value: j } => {
        let w = Filesystem.Write(path: "/home/briansrls/router/upstreams.first_party.json", content: j)
        if w.success { ExitSuccess } else { ExitFailure { code: 1, reason: concat("write failed: ", w.error) } }
      }
    }
  }
}

// Render a candidate for a graceful reload, without changing the running router's config.
fn router_dev_srv1_write_candidate() -> ProcessExit {
  match router_dev_first_party_refusal(fp: router_dev_first_party()) {
    Present { value: refused } => refused
    Absent => match router_dev_config(site: router_dev_srv1_site()) {
    RouterDevConfigRefused { token: k } => ExitFailure { code: 1, reason: concat("refused token: ", k) }
    RouterDevConfigRendered { text: t } => {
        let w = Filesystem.Write(path: "/home/briansrls/router/nginx.candidate.conf", content: t)
        if w.success { ExitSuccess } else { ExitFailure { code: 1, reason: concat("write failed: ", w.error) } }
      }
    }
  }
}
