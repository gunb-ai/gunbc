module gunbc.serving.serving_observability

import std.types { String, NonEmptyStr, List, Bool, Port }
import std.optional { Optional, Present, Absent }
import extdeps.proxy.openresty {
  NginxDirective, NginxToken, ServerBlock, ListenTlsOn, SslCertificate, SslCertificateKey,
  LocationBlock, PrefixMatch, ProxyPassToHost, ProxyHttpVersion11, nginx_token, render_nginx_directives,
}

// ── WHAT A FLEET READER CAN SEE ABOUT A SERVING ENGINE, THROUGH WHICH BOUNDARY, WITH WHAT STANDING ──
//
// A serving engine answers on its own port, but a fleet reader does not reach that port directly: it
// reaches the engine through the engine's TLS FRONT DOOR -- the nginx proxy that stands in front of the
// engine on its host (srv4's daily engine at /opt/gunbc-serving/srv4-daily/nginx.conf). Which routes
// that front forwards is what decides whether the fleet can read the engine at all, and until this row
// nothing in the model produced that route set. THE EARLIEST UNJUSTIFIED BOUNDARY is the front door's
// forwarded-route set (gunbc.design_argument::earliest_unjustified_boundary): srv4's hand-managed proxy
// forwards /v1/ and answers `return 404` to everything else, so the fleet cannot read srv4's /metrics.
//
// WHICH ROW SHOULD HAVE RENDERED IT, AND WHY IT DID NOT. gunbc.serving.router_proxy_config renders the
// ROUTER's byte door (the authz callout on srv1) -- a different proxy with a different contract, not
// this front door. gunbc.serving.serving_front_door is the APPLICATION seat-permit door (the HMAC grant
// that lets a caller forward one request), not the nginx front in front of one engine. No srv4
// daily-engine module renders the front. So the per-engine TLS front door had NO producing row, and a
// hand-authored proxy that drops a route nobody re-derived from a consumer could not be refused: the
// metrics route was never a CONSUMED requirement, so nothing joined it to the readers who need it
// (gunbc.design_argument::consumption). This module is the named home for that boundary; it derives the
// forwarded-route set from the named consumers so the missing route becomes unrenderable, not checked
// after the fact (gunbc.design_argument::guarantee_ladder, gunbc.design_argument::fail_closed).
//
// WHO CONSUMES /metrics (the consumption answer the boundary needs). Not the router (the router is one
// of the readers that CANNOT reach srv4's /metrics today). The named consumers are the availability and
// progress readers and the memory-provenance readers: the model+metrics probe
// gunbc.serving.serving_availability::serving_availability_bracketing_read, the two-/metrics-body stall
// reading gunbc.serving.engine_progress::engine_progress_read, and the /metrics provenance reads in
// gunbc.serving.serving_host_memory (expert_cache_mib, conversation_cache_min_free_mib,
// conversation_cache_mib -- each cites a /metrics read as its provenance). Each required route below
// carries its named consumer for that reason.

// A route the fleet must be able to reach THROUGH the front door, and the reader that consumes it.
type EngineFrontRoute = EngineFrontRoute {
  path: NonEmptyStr
  consumer: NonEmptyStr
}

// THE REQUIRED-ROUTE ROSTER: the single authority for what a fleet reader must reach through a serving
// engine's front door, derived from the consumers rather than hand-listed at the proxy. srv4's proxy
// omitted /metrics precisely because it was hand-written against one reader and never re-derived from
// this set. The chat and models paths are the OpenAI-compatible spellings the engine serves (the same
// paths extdeps.strata.strata_server and extdeps.vllm.server name for the engine itself).
data engine_front_required_routes: List<EngineFrontRoute> = [
  EngineFrontRoute {
    path: "/v1/chat/completions" as NonEmptyStr,
    consumer: "the seat's chat request, forwarded under the seat grant by gunbc.serving.serving_front_door::front_door_tally" as NonEmptyStr,
  },
  EngineFrontRoute {
    path: "/v1/models" as NonEmptyStr,
    consumer: "the model probe of gunbc.serving.serving_availability::serving_availability_bracketing_read" as NonEmptyStr,
  },
  EngineFrontRoute {
    path: "/metrics" as NonEmptyStr,
    consumer: "the metrics probe and stall reading gunbc.serving.engine_progress::engine_progress_read, and the /metrics provenance reads in gunbc.serving.serving_host_memory" as NonEmptyStr,
  },
]

// WHAT THE FRONT REFUSES: the case the misconfiguration becomes, so it is refused rather than rendered.
type EngineFrontProxyRefusal
  = OmitsRequiredRoute { route: NonEmptyStr }
  | InvalidToken { token: NonEmptyStr }

type EngineFrontProxyVerdict
  = EngineFrontProxyRendered { text: String }
  | EngineFrontProxyRefused { refusal: EngineFrontProxyRefusal }

// THE FORWARDED-ROUTE SET IS DERIVED, NOT AUTHORED. `forwarded` is what a hand-managed proxy actually
// proxies (the paths it sends to the engine; the catch-all `return 404` is what it does NOT forward).
// The front is accepted only when every route a named consumer requires is in `forwarded`; a front that
// omits one is refused naming it. This is the guarantee-ladder move: the bad state (forward /v1/ only,
// 404 the metrics route) has no render, so it cannot be produced rather than needing a downstream check.
fn engine_front_proxy_config(
  bind_address: NonEmptyStr,
  listen_port: Port,
  tls_cert: NonEmptyStr,
  tls_key: NonEmptyStr,
  engine_host: NonEmptyStr,
  engine_port: Port,
  forwarded: List<NonEmptyStr>,
) -> EngineFrontProxyVerdict {
  match first_unforwarded_required(forwarded: forwarded) {
    Present { value: omitted } =>
      EngineFrontProxyRefused { refusal: OmitsRequiredRoute { route: omitted } }
    Absent =>
      match engine_front_server_directives(bind_address: bind_address, listen_port: listen_port, tls_cert: tls_cert, tls_key: tls_key, engine_host: engine_host, engine_port: engine_port, forwarded: forwarded) {
        Absent => EngineFrontProxyRefused { refusal: InvalidToken { token: "a front-door token was refused by nginx_token" as NonEmptyStr } }
        Present { value: rows } => EngineFrontProxyRendered { text: render_nginx_directives(rows: rows) }
      }
  }
}

// The first required route absent from `forwarded`, in roster order, or Absent when the set is complete.
fn first_unforwarded_required(forwarded: List<NonEmptyStr>) -> Optional<NonEmptyStr> {
  fold(
    engine_front_required_routes,
    init: Absent as Optional<NonEmptyStr>,
    f: (acc: Optional<NonEmptyStr>, r: EngineFrontRoute) => match acc {
      Present { value: found } => Present { value: found }
      Absent =>
        if any(forwarded, x => (x as String) == (r.path as String)) {
          Absent
        } else {
          Present { value: r.path }
        }
    },
  )
}

// One location per required route proxy_passing to the engine, wrapped in the TLS server. Any path that
// nginx_token refuses is an Absent, which the caller turns into InvalidToken -- the render stays closed.
fn engine_front_server_directives(
  bind_address: NonEmptyStr,
  listen_port: Port,
  tls_cert: NonEmptyStr,
  tls_key: NonEmptyStr,
  engine_host: NonEmptyStr,
  engine_port: Port,
  forwarded: List<NonEmptyStr>,
) -> Optional<List<NginxDirective>> {
  match nginx_token(text: bind_address as String) {
    Absent => Absent
    Present { value: bind } =>
      match nginx_token(text: tls_cert as String) {
        Absent => Absent
        Present { value: cert } =>
          match nginx_token(text: tls_key as String) {
            Absent => Absent
            Present { value: key } =>
              match nginx_token(text: engine_host as String) {
                Absent => Absent
                Present { value: host } =>
                  match engine_front_locations(engine_host_token: host, engine_port: engine_port, forwarded: forwarded) {
                    Absent => Absent
                    Present { value: locations } =>
                      Present {
                        value: [
                          ServerBlock {
                            body: concat(
                              [ ListenTlsOn { address: bind, port: listen_port }, SslCertificate { path: cert }, SslCertificateKey { path: key } ],
                              locations,
                            ),
                          },
                        ] as List<NginxDirective>,
                      }
                  }
              }
          }
      }
  }
}

fn engine_front_locations(
  engine_host_token: NginxToken,
  engine_port: Port,
  forwarded: List<NonEmptyStr>,
) -> Optional<List<NginxDirective>> {
  fold(
    filter(engine_front_required_routes, r => any(forwarded, x => (x as String) == (r.path as String))),
    init: Present { value: [] as List<NginxDirective> } as Optional<List<NginxDirective>>,
    f: (acc: Optional<List<NginxDirective>>, r: EngineFrontRoute) => match acc {
      Absent => Absent
      Present { value: accs } =>
        match nginx_token(text: r.path as String) {
          Absent => Absent
          Present { value: loc } =>
            Present {
              value: concat(accs, [
                LocationBlock {
                  matching: PrefixMatch { path: loc },
                  body: [ ProxyHttpVersion11, ProxyPassToHost { host: engine_host_token, port: engine_port, path: loc } ],
                },
              ]),
            }
        }
    },
  )
}

// Does the rendered front door hold a proxy_pass for `route`? Used to assert the accepted control actually
// reaches the engine, not merely that the verdict was accepted.
fn engine_front_render_forwards_route(text: String, route: NonEmptyStr) -> Bool {
  string_contains(s: text, pattern: join(["proxy_pass http://", route as String], ""))
}

// ── ITEM (2): THE PER-CAUSE COLD-TOKEN BREAKDOWN IS NOT A NAMED INSTRUMENT ────────────────────────
//
// The 2026-11-24 attribution (same-card intact / same-card rewritten / rebound (moved) / no-probe) was
// produced ad hoc: /tmp/rlog.py on srv1 joined the router's prefixprobe/usageprobe/upgrade-move error-log
// lines; /tmp/snap.py and /tmp/delta.py differenced engine /metrics snapshots; the per-request Strata line
// `prompt N tokens = R reused + M read` carried the rest. It found every cause fixed that day. The
// DESIGN question (gunbc.design_argument::how_to_work, ruling gunbc.design_ruling::bad_process_is_worse_than_no_process)
// and the CI contract (gunbc.design_document::ci_contract_blocks: an instrument is a row in
// gunbc.instrument_targets produced through gunbc.target_binding::TargetProducer, and a new WIDE instrument
// must first name its real consumer, discriminator and acceptable cost) decide it: NOT an instrument. The
// job roster and CI budgets are closed to growth, and this breakdown's only real consumer was the
// operator's one-day tuning session -- a standing wide instrument over a three-authority join with no
// executing fold on the required path is exactly the bad process the ruling retires. The figures are kept
// as an operator-observed receipt of that session (extdeps.external_authority::CitedFigureStanding), never
// as deduced facts (gunbc.design_argument::epistemic_humility). The decision and its reason are recorded
// here, in the owning model, instead of building a row in gunbc.instrument_targets.

type InstrumentDecision
  = NamedInstrument { consumer: NonEmptyStr, discriminator: NonEmptyStr, acceptable_cost: NonEmptyStr }
  | NotAnInstrument { reason: NonEmptyStr, would_be_consumer: NonEmptyStr, add_when_trigger: NonEmptyStr }

data cold_token_cause_breakdown_standing: InstrumentDecision = NotAnInstrument {
  would_be_consumer: "no standing consumer: the per-cause split was read once, by the operator's 2026-11-24 tuning session, and no fold on the required path reads it" as NonEmptyStr,
  reason: "a new wide instrument must first name its real consumer, discriminator and acceptable cost (gunbc.design_document::ci_contract_blocks), and the job roster and CI budgets are closed to growth. The breakdown joins three independent authorities (the router's prefixprobe/usageprobe/upgrade-move lines, engine /metrics snapshots, and Strata's per-request reuse line) with no single executing fold on the required path, so a permanent wide instrument has no standing consumer and a cost paid against closed budgets -- the bad process gunbc.design_ruling::bad_process_is_worse_than_no_process retires. The measured per-cause counts stand as an operator-observed receipt of the 2026-11-24 session (extdeps.external_authority::CitedFigureStanding), not as deduced facts (gunbc.design_argument::epistemic_humility).",
  add_when_trigger: "promote it to a row in gunbc.instrument_targets only when a named consumer needs the per-cause split on an executing route and can carry the per-snapshot cost of the /metrics differencing",
}

// ── ITEM (3): THE ROUTER's prefixprobe/usageprobe LINES -- WHERE THEIR STANDING BELONGS ─────────────
//
// The prefixprobe/usageprobe lines the attribution was built on are marked TEMPORARY (2026-10-27/28,
// calm-crab-645) in the HAND-MANAGED srv1 ~/router/nginx.conf, yet they carried all of the day's
// attribution. Their standing is a RECEIPT OF THE HAND-MANAGED ROUTER, not a fact of the modelled
// router: they are not emitted by gunbc.serving.router_realization (which is a capability roster, not a
// log emitter), so they must not be read as if the modelled router produced them. Their removal and
// replacement belong to the modelled router's realization -- gunbc.serving.router_realization /
// gunbc.serving.turn_admission / gunbc.serving.serving_relocation -- where the prefix-overlap and
// token-usage facts they recorded become typed observations on the same authority that decides the move.
// That is a separate class (B5, router relocation); this row records their standing, it does not delete
// them while the router is hand-managed, and it does not model the relocated router here.

data router_probe_line_standing: NonEmptyStr = "the prefixprobe/usageprobe log lines are a receipt of the hand-managed srv1 ~/router/nginx.conf, not of the modelled router (gunbc.serving.router_realization emits no log line); their standing is transient and their removal belongs to the modelled router's realization (gunbc.serving.turn_admission / gunbc.serving.serving_relocation, class B5), which must carry the same prefix-overlap and token-usage facts as typed observations before the hand-managed lines are retired; until then the attribution built on them is an operator-observed receipt of 2026-11-24, never a modelled instrument" as NonEmptyStr
