module gunbc.serving.serving_observability

import std.types { String, NonEmptyStr, List, Bool, Port }
import std.optional { Optional, Present, Absent }
import std.decl_ref { DeclarationRef, decl_ref }
import extdeps.proxy.openresty {
  NginxDirective, NginxToken, ServerBlock, ListenTlsOn, SslCertificate, SslCertificateKey,
  LocationBlock, PrefixMatch, ProxyPassToHost, ProxyHttpVersion11, nginx_token, render_nginx_directives,
}

// ── WHAT A FLEET READER CAN SEE ABOUT A SERVING ENGINE, THROUGH WHICH BOUNDARY, WITH WHAT STANDING ──
//
// A serving engine answers on its own port, but a fleet reader does not reach that port directly: it
// reaches the engine through the engine's TLS FRONT DOOR -- the nginx proxy that stands in front of the
// engine on its host (srv4's daily engine at /opt/gunbc-serving/srv4-daily/nginx.conf). Which routes
// that front forwards is what decides whether the fleet can read the engine at all, and until this row
// nothing in the model produced that route set. THE EARLIEST UNJUSTIFIED BOUNDARY is the front door's
// forwarded-route set (gunbc.design_argument::earliest_unjustified_boundary): srv4's hand-managed proxy
// forwards /v1/ and answers `return 404` to everything else, so the fleet cannot read srv4's /metrics.
//
// WHICH ROW SHOULD HAVE RENDERED IT, AND WHY IT DID NOT. gunbc.serving.router_proxy_config renders the
// ROUTER's byte door (the authz callout on srv1) -- a different proxy with a different contract, not
// this front door. gunbc.serving.serving_front_door is the APPLICATION seat-permit door (the HMAC grant
// that lets a caller forward one request), not the nginx front in front of one engine. No srv4
// daily-engine module renders the front. So the per-engine TLS front door had NO producing row, and a
// hand-authored proxy that drops a route nobody re-derived from a consumer could not be refused: the
// metrics route was never a CONSUMED requirement, so nothing joined it to the readers who need it
// (gunbc.design_argument::consumption). This module is the named home for that boundary.
//
// CONSTRUCTION, NOT VALIDATION (gunbc.design_argument::guarantee_ladder, ::fail_closed). The front door
// is RENDERED FROM THE ROSTER: engine_front_proxy_config takes no forwarded-route list, so a front that
// omits a consumed route has NO CONSTRUCTOR -- it is unrenderable, not checked after the fact. A
// hand-managed proxy that actually drops a route is a DIFFERENT authority (the observed host config); it
// is reconciled against the roster by engine_front_unserved_consumers, which names the consumers whose
// reads are blocked. Checking an OBSERVED set against the authority is reconciliation, not a restatement
// of the authority; the authority itself has exactly one representation, the roster.
//
// WHO CONSUMES /metrics (the consumption answer the boundary needs). Not the router (the router is one
// of the readers that CANNOT reach srv4's /metrics today). Each required route carries its consumer as a
// typed DeclarationRef (a rename/deletion of a consumer is a decidable break -- gunbc.design_argument::
// single_authority, ::source_annotations). The consumer reference is READ by engine_front_unserved_consumers,
// whose ONLY caller today is this module's claim witness at the declared frontier; no production route
// executes it yet, and the claim does not assert one (gunbc.design_argument::epistemic_humility). The
// roster, not this fold, is the authority. The readers: the metrics
// route is consumed by gunbc.serving.engine_progress::engine_progress_read, the models route by
// gunbc.serving.serving_availability::serving_availability_bracketing_read, the chat route by
// gunbc.serving.serving_front_door::front_door_admit.
//
// CONSUMER (declared frontier, gunbc.design_argument::consumption). The rendering is consumed today by
// this module's claim witness; it dissolves into production when the live-deploy leg that emits a
// serving engine's TLS front renders its server block from engine_front_proxy_config and retires the
// hand-managed /opt/gunbc-serving/*/nginx.conf. That emitter is the next-rung trigger on the ledger row;
// until it lands the module is a frontier, exactly as gunbc.serving.router_proxy_config is a declared
// frontier to gunbc.live_deploy.apply_legs.

// A route the fleet must be able to reach THROUGH the front door, and the declaration of the reader that
// consumes it -- a typed reference, not a name spelled in prose, so a renamed consumer is decidable.
type EngineFrontRoute = EngineFrontRoute {
  path: NonEmptyStr
  consumer: DeclarationRef
}

// THE REQUIRED-ROUTE ROSTER: the single authority for what a fleet reader must reach through a serving
// engine's front door. The render is built from exactly this list, so omitting a route is not a choice a
// caller can make. srv4's proxy omitted /metrics precisely because it was hand-written against one reader
// and never re-derived from this set.
data engine_front_required_routes: List<EngineFrontRoute> = [
  EngineFrontRoute {
    path: "/v1/chat/completions" as NonEmptyStr,
    consumer: decl_ref(module_path: "gunbc.serving.serving_front_door", decl_name: "front_door_admit"),
  },
  EngineFrontRoute {
    path: "/v1/models" as NonEmptyStr,
    consumer: decl_ref(module_path: "gunbc.serving.serving_availability", decl_name: "serving_availability_bracketing_read"),
  },
  EngineFrontRoute {
    path: "/metrics" as NonEmptyStr,
    consumer: decl_ref(module_path: "gunbc.serving.engine_progress", decl_name: "engine_progress_read"),
  },
]

// The only way a correct front fails to render: an admitted-token refusal. There is no OmitsRequiredRoute
// arm, because a front that omits a required route cannot be authored at all (guarantee_ladder).
type EngineFrontProxyRefusal = InvalidToken { token: NonEmptyStr }

type EngineFrontProxyVerdict
  = EngineFrontProxyRendered { text: String }
  | EngineFrontProxyRefused { refusal: EngineFrontProxyRefusal }

// RENDER THE FRONT FROM THE ROSTER. No forwarded parameter: the server block always proxies every route a
// named consumer requires. A front missing /metrics is unrenderable, so the srv4 misconfiguration has no
// constructor rather than being a case a check must catch.
fn engine_front_proxy_config(
  bind_address: NonEmptyStr,
  listen_port: Port,
  tls_cert: NonEmptyStr,
  tls_key: NonEmptyStr,
  engine_host: NonEmptyStr,
  engine_port: Port,
) -> EngineFrontProxyVerdict {
  match engine_front_server_directives(bind_address: bind_address, listen_port: listen_port, tls_cert: tls_cert, tls_key: tls_key, engine_host: engine_host, engine_port: engine_port) {
    Absent => EngineFrontProxyRefused { refusal: InvalidToken { token: "a front-door token was refused by nginx_token" as NonEmptyStr } }
    Present { value: rows } => EngineFrontProxyRendered { text: render_nginx_directives(rows: rows) }
  }
}

// One location per REQUIRED route proxy_passing to the engine, wrapped in the TLS server. Built from the
// roster alone. Any path nginx_token refuses is an Absent, which the caller turns into InvalidToken.
fn engine_front_server_directives(
  bind_address: NonEmptyStr,
  listen_port: Port,
  tls_cert: NonEmptyStr,
  tls_key: NonEmptyStr,
  engine_host: NonEmptyStr,
  engine_port: Port,
) -> Optional<List<NginxDirective>> {
  match nginx_token(text: bind_address as String) {
    Absent => Absent
    Present { value: bind } =>
      match nginx_token(text: tls_cert as String) {
        Absent => Absent
        Present { value: cert } =>
          match nginx_token(text: tls_key as String) {
            Absent => Absent
            Present { value: key } =>
              match nginx_token(text: engine_host as String) {
                Absent => Absent
                Present { value: host } =>
                  match engine_front_locations(engine_host_token: host, engine_port: engine_port) {
                    Absent => Absent
                    Present { value: locations } =>
                      Present {
                        value: [
                          ServerBlock {
                            body: concat(
                              [ ListenTlsOn { address: bind, port: listen_port }, SslCertificate { path: cert }, SslCertificateKey { path: key } ],
                              locations,
                            ),
                          },
                        ] as List<NginxDirective>,
                      }
                  }
              }
          }
      }
  }
}

fn engine_front_locations(
  engine_host_token: NginxToken,
  engine_port: Port,
) -> Optional<List<NginxDirective>> {
  fold(
    engine_front_required_routes,
    init: Present { value: [] as List<NginxDirective> },
    f: (acc, r) => match acc {
      Absent => Absent
      Present { value: accs } =>
        match nginx_token(text: r.path as String) {
          Absent => Absent
          Present { value: loc } =>
            Present {
              value: concat(accs, [
                LocationBlock {
                  matching: PrefixMatch { path: loc },
                  body: [ ProxyHttpVersion11, ProxyPassToHost { host: engine_host_token, port: engine_port, path: loc } ],
                },
              ]),
            }
        }
    },
  )
}

// Reconcile an OBSERVED hand-managed forwarded set against the roster: the consumers whose reads are
// blocked because the host front does not forward their route. This is the class made decidable -- it
// names who srv4 shut out. It reads each route's typed consumer, giving that field its executing consumer.
// `observed` is the host proxy's actually-forwarded paths (a read, not an authority over the render).
fn engine_front_unserved_consumers(observed: List<NonEmptyStr>) -> List<DeclarationRef> {
  map(
    filter(engine_front_required_routes, r => !any(observed, x => (x as String) == (r.path as String))),
    r => r.consumer,
  )
}

// Walk the server/location tree and collect every ProxyPassToHost target path.
fn engine_front_proxied_paths(ds: List<NginxDirective>) -> List<String> {
  fold(ds, init: [] as List<String>, f: (acc, d) => concat(acc, match d {
    ServerBlock { body: b } => engine_front_proxied_paths(ds: b)
    LocationBlock { matching: _, body: b } => engine_front_proxied_paths(ds: b)
    ProxyPassToHost { host: _, port: _, path: p } => [ (p as String) ]
    _ => [] as List<String>
  }))
}

// Does the rendered front proxy `route` to the engine? Structural, over the directive list, so the witness
// proves the proxy_pass really carries the route rather than grepping rendered bytes.
fn engine_front_proxies_route(ds: List<NginxDirective>, route: NonEmptyStr) -> Bool {
  any(engine_front_proxied_paths(ds: ds), p => p == (route as String))
}

// The named consumer carried on a required route, exposed for the ledger and the witness to assert against
// without re-spelling the reference (single authority -- the roster holds it, everything else reads it).
fn engine_front_route_consumer(path: NonEmptyStr) -> Optional<DeclarationRef> {
  match first(filter(engine_front_required_routes, r => (r.path as String) == (path as String))) {
    Present { value: r } => Present { value: r.consumer }
    Absent => Absent
  }
}

// ── ITEM (2): THE PER-CAUSE COLD-TOKEN BREAKDOWN IS NOT A NAMED INSTRUMENT ────────────────────────
//
// The 2026-11-24 attribution (same-card intact / same-card rewritten / rebound (moved) / no-probe) was
// produced ad hoc (/tmp/rlog.py over the router's prefixprobe/usageprobe/upgrade-move lines; /tmp/snap.py
// and /tmp/delta.py differencing engine /metrics; the Strata per-request reuse line). It is NOT a named
// instrument. That decision, and its reason, are recorded ONCE in the owning model -- the recurring-failure-
// mode row gunbc.recurring_failure_mode.a_hand_managed_proxy_edge_drops_a_route_its_consumers_read -- which
// is what the brief asks for ("record that decision and its reason in the owning model instead of building
// one"). A decision NOT to build an instrument needs no gate type here: the ruling it rests on,
// gunbc.design_ruling::bad_process_is_worse_than_no_process, argues for deleting such machinery rather than
// keeping a local copy. The admission rule is not restated in this module either -- it is consumed from the
// authorities that own it: gunbc.design_document::ci_contract_blocks (a new wide instrument must first name
// its real consumer, discriminator and acceptable cost), gunbc.design_ruling::job_roster_closed_to_growth,
// and gunbc.design_ruling::ci_job_budgets_closed_to_growth (gunbc.design_argument::single_authority: a
// second place that independently decides it would be a fork). The measured per-cause counts stand as an
// operator-observed receipt of that session (extdeps.external_authority::CitedFigureStanding), never as
// deduced facts (gunbc.design_argument::epistemic_humility).

// ── ITEM (3): THE ROUTER's prefixprobe/usageprobe LINES -- WHERE THEIR STANDING BELONGS ─────────────
//
// The prefixprobe/usageprobe lines the attribution was built on are marked TEMPORARY (2026-10-27/28,
// calm-crab-645) in the HAND-MANAGED srv1 ~/router/nginx.conf, yet they carried all of the day's
// attribution. Their standing is a transient receipt of the HAND-MANAGED router, not a fact of the modelled
// router: gunbc.serving.router_realization emits no log line, so they must not be read as if the modelled
// router produced them. Their removal belongs to the modelled router's realization -- the rows in retires_via
// -- which must first carry the same prefix-overlap and token-usage facts as typed observations on the
// authority that decides the move (class B5). Recorded here as a TYPED RECORD of the standing, with typed
// references to the retiring rows (source_annotations: a status belongs in a typed carrier). It deliberately
// carries no retirement fold: the modelled-router side (class B5) owns WHEN these retire, on its own typed
// observations, not a Bool mirror kept here while it is unbuilt.

// The standing of a router observation line: is it a fact of the modelled router, or a transient receipt of
// the hand-managed one? A declared coproduct (ctrl review policy: a tag-plus-predicate shape must be a
// declared sum, not a Bool next to an Optional).
type ProbeStanding = TransientReceiptOfHandManagedRouter | ModelledRouterInstrument

// A typed record of where the hand-managed prefixprobe/usageprobe lines' standing belongs: the transient
// receipt of the hand-managed router, pointed at the modelled rows (class B5) whose realization retires them.
// Its only consumer is the recurring-failure-mode ledger row that cites it, and that is enough: a standing is
// a fact to be recorded, not a gate to be run.
type RouterProbeStanding = RouterProbeStanding {
  standing: ProbeStanding
  retires_via: List<DeclarationRef>
}

data router_probe_line_standing: RouterProbeStanding = RouterProbeStanding {
  standing: TransientReceiptOfHandManagedRouter,
  retires_via: [
    decl_ref(module_path: "gunbc.serving.router_realization", decl_name: "router_realization_contract"),
    decl_ref(module_path: "gunbc.serving.turn_admission", decl_name: "serving_co_tenancy"),
    decl_ref(module_path: "gunbc.serving.serving_relocation", decl_name: "admit_state_method"),
  ],
}
