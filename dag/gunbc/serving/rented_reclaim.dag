module gunbc.serving.rented_reclaim

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef, decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import gunbc.serving.rented_allocation { RentedServingAllocation, RentedAllocationIdentity, RentedAllocationEnrollable, RentedAllocationNotEnrollable, rented_allocation_enrollment }
import gunbc.serving.rented_replica { RentedReplicaIdentity }
import gunbc.harness.harness_seat { HarnessSeatReference }

// A RECLAIM TAKES AWAY ENDPOINTS. IT DOES NOT DECIDE WHERE ANYTHING GOES NEXT.
//
// The legs of a reclaim already have owners: gunbc.serving.rented_release answers each one (drain, grant
// revoke, lease anchor, store close, destroy) from a reading, and product.fabric.flex_vast_loop runs them for
// the fleet. What had no home was the OTHER half of a reclaim -- the sessions that were standing on the card
// when it went away. This module models that half and stops at the boundary: it reports which endpoint a
// reclaimed allocation took away and which seats were standing on it, and hands those seats to the front door
// as an obligation. It does not choose a card, does not rank a survivor, and does not keep a binding ledger:
// choosing is placement's job (gunbc.serving.router_realization forbids a router deciding a host, and a
// reclaim pass that picked survivors would be the same fault with a friendlier name).

// WHAT THE RECLAIM KNOWS ABOUT THE ALLOCATION IT JUST RELEASED IS A COPRODUCT, NOT A RECORD. The two facts --
// "it had an endpoint, here it is" and "it never enrolled one, here is why" -- are arms, so the state where
// both lists are empty (which reads as a clean reclaim of a quiet card) and the state where both are present
// are not writable here at all: DESIGN 5, correctness by construction rather than a witness that checks it at
// runtime. The arms mirror gunbc.serving.rented_allocation's own enrollment answer one-for-one.
type RentedReclaimLoss
  = RentedEndpointsLost { allocation: RentedAllocationIdentity, replica: RentedReplicaIdentity }
  | RentedNothingEnrolled { allocation: RentedAllocationIdentity, obligation: NonEmptyStr }

// THE ENDPOINT A RECLAIM TAKES AWAY comes from the SAME derivation the enrollment roster is built from
// (gunbc.serving.rented_allocation rented_allocation_enrollment, which
// gunbc.serving.rented_enrollment_from_allocations folds over a population). One derivation, so a reclaim
// cannot lose an endpoint the roster never carried, nor keep one it did.
fn rented_reclaim_loss(allocation: RentedServingAllocation) -> RentedReclaimLoss {
  match rented_allocation_enrollment(a: allocation) {
    RentedAllocationEnrollable { allocation: id, enrollment: e } =>
      RentedEndpointsLost { allocation: id, replica: e.endpoint.replica }
    RentedAllocationNotEnrollable { allocation: id, obligation: o } =>
      RentedNothingEnrolled { allocation: id, obligation: o }
  }
}

// A SEAT STANDING ON A CARD, as supplied by whoever holds the bindings. Both halves are the typed identities,
// not renderings of them: RentedReplicaIdentity is what the enrollment carries, and HarnessSeatReference is
// the front door's own seat reference (the record, not harness_seat_reference_wire's output -- a lookup done on
// renderings is sound only while the rendering stays injective, and this module has no business depending on
// that). The pair is taken as an INPUT on purpose: a reclaim pass that kept its own ledger of who sits where
// would be a second binding ledger, which is what the router contract refuses.
type RentedReclaimSeat { replica: RentedReplicaIdentity, seat: HarnessSeatReference }

// TWO REPLICA IDENTITIES ARE THE SAME REPLICA when all three components match: node, device index and served
// name. Componentwise rather than through a rendering, for the reason above; a replica whose node or device is
// different is a different card, and one serving a different name is a different replica on the same card.
fn rented_reclaim_same_replica(a: RentedReplicaIdentity, b: RentedReplicaIdentity) -> Bool {
  a.node == b.node && a.device_index == b.device_index && a.served_name == b.served_name
}

// THE OBLIGATION A RECLAIM LEAVES BEHIND, stated once and identically for every orphaned seat: the seat must
// ask placement again, and the endpoint incarnation it had is not reusable -- the next attempt is a new
// incarnation of the replica, not a re-attachment to a card that no longer exists.
data rented_reclaim_replacement_obligation: NonEmptyStr = "the rented card this seat was bound to has been reclaimed; the seat must ask placement again, on a new endpoint incarnation -- the reclaimed endpoint's incarnation is not reusable"

// WHICH SEATS THE RECLAIM ORPHANS: those standing on the replica this reclaim took away. Everything else is
// left untouched, including seats on other cards of the same cohort -- sweeping the cohort is how a single
// destroyed card becomes an outage across cards that are still paid for and still running.
fn rented_reclaim_orphaned_seats(loss: RentedReclaimLoss, held: List<RentedReclaimSeat>) -> List<RentedReclaimSeat> {
  match loss {
    RentedNothingEnrolled { allocation: _, obligation: _ } => [] as List<RentedReclaimSeat>
    RentedEndpointsLost { allocation: _, replica: lost } =>
      filter(held, s => rented_reclaim_same_replica(a: lost, b: s.replica))
  }
}

// THE HAND-OFF, in the shape the front door consumes: the seat, the replica it lost, and the obligation. There
// is no destination field to fill in. That is the whole claim of this module, and it is a type-level claim
// rather than a comment: a caller cannot pass a chosen card through a structure that has no place for one.
type RentedReclaimHandoff { seat: HarnessSeatReference, replica: RentedReplicaIdentity, obligation: NonEmptyStr }

fn rented_reclaim_handoffs(loss: RentedReclaimLoss, held: List<RentedReclaimSeat>) -> List<RentedReclaimHandoff> {
  map(rented_reclaim_orphaned_seats(loss: loss, held: held),
      s => RentedReclaimHandoff { seat: s.seat, replica: s.replica, obligation: rented_reclaim_replacement_obligation })
}

// DECLARED FRONTIER (DESIGN 3c). The triggers here are descriptions rather than declaration references,
// following the module this one drives (gunbc.serving.rented_release records its own frontier rows the same
// way): what is missing is a CALL in existing code, not a new named capability this repo can cite today, and a
// fabricated citation is a worse record than an honest sentence.
data rented_reclaim_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.rented_reclaim", decl_name: "rented_reclaim_handoffs"),
    reason: "Nothing hands an orphaned seat to the front door in production: the reclaim legs run (product.fabric.flex_vast_loop runs gunbc.serving.rented_release's decisions) and the obligation this module states has no consumer, so a reclaimed card silently strands the sessions that were standing on it. The callout that would consume this -- turning a refusal or a lost seat into a SubmitDemand at the single demand home (product.fabric.demand) -- belongs to the serving router's front-door work (calm-moth-166), not to this pass.",
    dissolution: unbound_dissolution(description: "trigger: the front door's refusal-to-demand callout (product.fabric.demand SubmitDemand, the same callout the ceiling refusal needs) is fed by a reclaim pass over these handoffs -- sufficient for a reclaimed card to put its sessions back into placement with no hand-written re-placement arm in the flex pass and no failover decision anywhere in the router")
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.rented_reclaim", decl_name: "rented_reclaim_orphaned_seats"),
    reason: "The seat population is a parameter nobody supplies in production yet: the bindings live in the harness seat ledger and the front door's seat permits, and no pass reads them against a reclaim receipt, so today the orphan set is computed only by this module's witnesses.",
    dissolution: unbound_dissolution(description: "trigger: the flex release pass, having taken a rented_release_receipt, reads the seats standing on the reclaimed replica (the harness seat pool for that replica) and calls this over them -- sufficient for the orphan set to be observed against a real reclaim rather than a fixture")
  ),
]
