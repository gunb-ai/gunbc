module gunbc.serving.serving_provision_derivation

import std.types { String, NonEmptyStr, List, Port }
import std.optional { Present, Absent }
import std.content_hash { Sha256Digest }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import gunbc.serving.rented_ninfer_source { RentedArtifactSource, NinferEngineRelease }
import extdeps.vllm.local_inference_lab_build { VllmEngineRelease, VllmServingImage }
import extdeps.vllm.lil_serve { LilServeLaunch }
import extdeps.huggingface.hub { HubCheckpointManifest, HubFileDigest }
import extdeps.local_inference_lab.qwen3_8_flash_next { qwen3_8_flash_next_pin_roster }
import gunbc.serving.srv1_serving_launch { srv1_serving_launch_for_port }
import extdeps.ninfer.ninfer_serve { NinferServeLaunch }
import gunbc.harness.operator_pod_launch { operator_pod_ninfer_launch }
import product.fabric.serving_recipe {
  ServingRecipe, ServingEngine, EngineNinfer, EngineVllm, ServingStartSource, StartSourcePlaced, StartSourceObserved,
  StartSourceHubPinned, StartSourcePlacementMissing, StartSourceUnread, ServingWeightsSource, WeightsPlacedOnObjectStore,
  WeightsNamedUnpinned, WeightsPinnedAtHub, serving_start_source,
}

// THE RECIPE IS THE ONE AUTHORITY FOR WHAT A SERVING HOST INSTALLS AND STARTS. This derivation reads a
// ServingRecipe and yields the inputs the S3c legs (gunbc.serving.serving_artifact_placement,
// gunbc.serving.serving_launch) take, and keeps no copy of any of them: the engine pins are the recipe's
// NinferEngineRelease, the artifact source is serving_start_source(recipe), the digest is the placed model
// row's pin, the port is the recipe's published port and the served model id is the recipe's. The launch's
// other flags have exactly one home, gunbc.harness.operator_pod_launch operator_pod_ninfer_launch, which the
// recipe's own served_model_id already references; they are read from it field by field, with the model id
// taken from the recipe, so a recipe naming another model id derives a launch for that id and not a stale copy.
type ServingProvisionInputs {
  engine: NinferEngineRelease
  source: RentedArtifactSource
  digest: Sha256Digest
  launch: NinferServeLaunch
  listen_port: Port
}

// The inputs a vLLM provision takes, derived from the recipe: the build is the recipe's, the image is
// the build's own pin (extdeps.vllm.local_inference_lab_build VllmServingImage), the checkpoint is the
// recipe's Hub pin, and the launch is the modeled srv1 lil-serve launch (gunbc.serving.srv1_serving_launch)
// at the recipe's published port. As with ServingProvisionInputs, this keeps no copies: every field
// reads its one authority.
type VllmServingProvisionInputs {
  build: VllmEngineRelease
  image: VllmServingImage
  weights: HubCheckpointManifest
  // Per-file digests the checkpoint is made of, read from the Hub-pinned revision (the
  // extdeps.local_inference_lab.qwen3_8_flash_next roster, folded against the manifest in its own
  // module). Carried here so a provision names the bytes it starts from shard by shard, not only the
  // repository total.
  weights_digests: List<HubFileDigest>
  launch: LilServeLaunch
  listen_port: Port
}

// EVERY REFUSAL IS TYPED AND NONE FALLS BACK. A vllm engine whose start route is not the pinned-Hub one
// is refused rather than defaulted to the ninfer arm (which would start the wrong engine); a start
// source that names no route this phase has read is named and not guessed. The vllm refusal by engine
// (ServingProvisionRefusedEngineVllm) is DISSOLVED (2026-10-25): the launch argv is modeled, so the
// engine arm derives.
type ServingProvisionDerivation
  = ServingProvisionDerived { inputs: ServingProvisionInputs }
  | ServingProvisionDerivedVllm { inputs: VllmServingProvisionInputs }
  | ServingProvisionRefusedStartSource { cause: NonEmptyStr }
  | ServingProvisionRefusedVllmDeployment { cause: NonEmptyStr }
  | ServingProvisionRefusedNoServedModelId

fn serving_provision_launch(model_id: NonEmptyStr) -> NinferServeLaunch {
  NinferServeLaunch {
    bind_host: operator_pod_ninfer_launch.bind_host,
    model_id: model_id,
    max_concurrency: operator_pod_ninfer_launch.max_concurrency,
    max_context: operator_pod_ninfer_launch.max_context,
    default_max_tokens: operator_pod_ninfer_launch.default_max_tokens,
    kv_dtype: operator_pod_ninfer_launch.kv_dtype,
    speculation: operator_pod_ninfer_launch.speculation,
    device_state_slots: operator_pod_ninfer_launch.device_state_slots,
    preserve_thinking: operator_pod_ninfer_launch.preserve_thinking,
    host_context: operator_pod_ninfer_launch.host_context,
    standing: operator_pod_ninfer_launch.standing,
  }
}

fn serving_provision_from_ninfer(recipe: ServingRecipe, build: NinferEngineRelease) -> ServingProvisionDerivation {
  match serving_start_source(recipe: recipe) {
    StartSourcePlaced { source: s } =>
      match recipe.model.source {
        WeightsPlacedOnObjectStore { placement: p } =>
          match recipe.model.served_model_id {
            Present { value: id } =>
              ServingProvisionDerived {
                inputs: ServingProvisionInputs {
                  engine: build,
                  source: s,
                  digest: p.model.container_sha256,
                  launch: serving_provision_launch(model_id: id),
                  listen_port: recipe.published_tcp_port,
                },
              }
            Absent => ServingProvisionRefusedNoServedModelId
          }
        WeightsNamedUnpinned { weights: _, quantization: _ } =>
          ServingProvisionRefusedStartSource { cause: "the recipe's weights are named and unpinned, so there is no digest to place" as NonEmptyStr }
      }
    // A HUB-PINNED start is unreadable to the ninfer leg the same way an observed store is: the ninfer
    // provision fetches a placed artifact, and a Hub revision at a pinned commit is not one. This arm
    // was the second gap #15222 owed when it added StartSourceHubPinned — enumerated here by walking
    // every match on that sum (§6b), found before CI did.
    StartSourceHubPinned { hub_fallback: _, standing: _ } =>
      ServingProvisionRefusedStartSource { cause: "the start source is a pinned Hub revision, not a placed artifact; the ninfer fetch route reads placements only" as NonEmptyStr }
    StartSourceObserved { store: _, hub_fallback: _, standing: _ } =>
      ServingProvisionRefusedStartSource { cause: "the start source is an observed object store, not a placed artifact; its fetch route is unmodeled" as NonEmptyStr }
    StartSourcePlacementMissing =>
      ServingProvisionRefusedStartSource { cause: "the recipe starts from placed weights but names none" as NonEmptyStr }
    StartSourceUnread =>
      ServingProvisionRefusedStartSource { cause: "the recipe's start route is unread" as NonEmptyStr }
  }
}

// The vLLM arm: the recipe must START from its Hub-pinned checkpoint (StartFromHubPinned) and carry that
// pin as its weights (WeightsPinnedAtHub) — anything else names a route this phase has not read, and is
// refused with its cause rather than defaulted. Nothing here re-pins an image, a digest or a flag.
//
// The LAUNCH binds to the recipe by IDENTITY, not by engine family. The srv1 wrapper models ONE
// deployment — its host, its API-key file, its TLS material, its LMCache tier sizes — so this arm
// derives only for the recipe that deployment belongs to
// (product.fabric.serving_recipe.serving_recipe_flash_next_lab_vllm, named by
// gunbc.serving.srv1_serving_launch.srv1_serving_launch_recipe) and REFUSES any other vLLM recipe with
// a typed cause. Handing srv1's launch to a second vLLM recipe — different checkpoint, different host —
// would produce a provision whose inputs contradict that recipe's own `weights` field, and would do so
// with no refusal: a plausible output fabricated from a deployment that was never declared.
fn serving_provision_from_vllm(recipe: ServingRecipe, build: VllmEngineRelease) -> ServingProvisionDerivation {
  if !(declaration_ref_eq(a: recipe.id, b: srv1_serving_launch_recipe)) {
    ServingProvisionRefusedVllmDeployment {
      cause: "this recipe is not the deployment the modeled srv1 lil-serve launch belongs to; its launch is unmodeled — add its own LilServeLaunch row and name it from this recipe" as NonEmptyStr,
    }
  } else {
    match serving_start_source(recipe: recipe) {
      StartSourceHubPinned { hub_fallback: _, standing: _ } =>
        match recipe.model.source {
          WeightsPinnedAtHub { checkpoint: c, quantization: _ } =>
            ServingProvisionDerivedVllm {
              inputs: VllmServingProvisionInputs {
                build: build,
                image: build.image,
                weights: c,
                weights_digests: qwen3_8_flash_next_pin_roster(),
                launch: srv1_serving_launch_for_port(port: recipe.published_tcp_port),
                listen_port: recipe.published_tcp_port,
              },
            }
        WeightsNamedUnpinned { weights: _, quantization: _ } =>
          ServingProvisionRefusedStartSource { cause: "the recipe's weights are named and unpinned, so there is no checkpoint digest to start from" as NonEmptyStr }
        WeightsPlacedOnObjectStore { placement: _ } =>
          ServingProvisionRefusedStartSource { cause: "the recipe's weights are placed on an object store while its start route is the pinned Hub; the two disagree" as NonEmptyStr }
      }
    StartSourceObserved { store: _, hub_fallback: _, standing: _ } =>
      ServingProvisionRefusedStartSource { cause: "the start source is an observed object store, not a pinned Hub revision; its fetch route is unmodeled for vllm" as NonEmptyStr }
    StartSourcePlaced { source: _ } =>
      ServingProvisionRefusedStartSource { cause: "the recipe starts from placed weights; the vllm phase reads only Hub-pinned starts" as NonEmptyStr }
    StartSourcePlacementMissing =>
      ServingProvisionRefusedStartSource { cause: "the recipe starts from placed weights but names none" as NonEmptyStr }
    StartSourceUnread =>
      ServingProvisionRefusedStartSource { cause: "the recipe's start route is unread" as NonEmptyStr }
    }
  }
}

fn serving_provision_derive(recipe: ServingRecipe) -> ServingProvisionDerivation {
  match recipe.engine {
    EngineNinfer { build: b } => serving_provision_from_ninfer(recipe: recipe, build: b)
    EngineVllm { build: b } => serving_provision_from_vllm(recipe: recipe, build: b)
  }
}

data serving_provision_derivation_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.serving_provision_derivation", decl_name: "ServingProvisionDerivation"),
    reason: "the vllm arm derives (2026-10-25): the launch argv is modeled (gunbc.serving.srv1_serving_launch, dissolving what was ServingProvisionRefusedEngineVllm), but nothing EXECUTES the derived inputs — verify/install/start of the lab vLLM build on a host is still unmodeled, and the arm never falls back to ninfer",
    dissolution: unbound_dissolution(description: "a host-convergence step executes ServingProvisionDerivedVllm on srv1 and reads the container inspect and engine banner back against it — the same trigger gunbc.serving.srv1_serving_launch srv1_serving_unmodeled_frontier_rows carries for the relaunch route"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.serving_provision_derivation", decl_name: "serving_provision_derive"),
    reason: "serving_provision_derive has no executing production caller: the InferenceServingProvision spine row names it as an authority, but no converge-loop step evaluates it on a recipe a host is handed yet, so only test.claim.serving witnesses run it",
    dissolution: unbound_dissolution(description: "a host-convergence step evaluates the InferenceServingProvision phase on the host's ServingRecipe and reads the placement back — sufficient to delete this row"),
  ),
]
