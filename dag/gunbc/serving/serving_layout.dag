module gunbc.serving.serving_layout

import std.types { String, NonEmptyStr, List, Bool }
import std.nat { Nat, nat_add }
import std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_identity }
import std.measure { ByteSize, byte_size, byte_size_count, TokenCount, token_count, token_count_value, mebibyte, mebibyte_to_byte_size, gibibyte, gibibyte_to_byte_size }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.content_hash { identity_frame }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_6ce85c, operator_host_srv4 }
import gunbc.serving.serving_context_cap { serving_fleet_context_cap }
import gunbc.host.host_memory_carrier { HostUsableRam, HostUsableRamMeasured, HostUsableRamConservativeLowerBound, HostUsableRamUnmeasured, HostFixedOverhead, HostFixedOverheadMeasured, HostFixedOverheadAllowance, HostFixedOverheadUnmeasured }
import gunbc.serving.serving_host_memory {
  ServingMemoryReading, ServingMemoryRead, ServingMemoryAssumed, ServingMemoryUnread,
  ServingEngineMemory, ServingDedicatedHostMemory, ServingMemoryVerdict, ServingMemoryFits,
  serving_host_memory_verdict, serving_reading_bytes_or_zero, serving_reading_assumption, serving_reading_missing,
  ConversationSnapshotCost, conversation_snapshot_bytes, strata_iq3_s_snapshot_cost, serving_engine_swap_bound,
  host_6ce85c_serving_memory_observed, srv4_serving_engine_memory, srv4_strata_snapshot_cost,
  srv3_strata_engine_memory, srv3_strata_snapshot_cost,
}

// HOW A SERVING HOST IS LAID OUT, DERIVED FROM WHAT IT HAS, HOW ITS DEVICES ARE GROUPED, AND WHAT THE ENGINE
// NEEDS, AGAINST A REQUIREMENT. Three inputs that answer different questions and change for different reasons:
//
//   the GRANT     what the host has: usable RAM, the host's own overhead, artifacts resident once and shared
//                 by every replica (each with the owner that keeps it resident), the swap bound, the devices;
//   the TOPOLOGY  which devices serve together: one replica (one engine process) per group;
//   the BACKEND   what one replica of this engine and model needs: per device, per process, per active
//                 request, per retained conversation, and the largest group it can still retain on.
//
// THE REQUIREMENT IS A CEILING, NOT A GUESS. Every conversation a replica admits must stay retainable until it
// reaches the maximum context, so admission is sized by the snapshot of a maximum-length conversation. How
// long conversations usually are is a performance question (which topology, how many sessions to place), and
// it is not an input here.
//
// THE RESULT IS A CONFIGURATION AND THREE SEPARATE STANDINGS: whether the budget fits under the assumptions
// it names, whether the backend supports this topology, and whether this exact configuration has been
// qualified live. They are different facts, and one is never read as another.
//
// UNAVOIDABLE DUPLICATION, named because each costs memory the operator might expect to share. Independent
// replicas each hold their own dense weights and expert cache in their own device's VRAM (a device serves only
// the replica it belongs to); each process holds its own base, including the pinned host copy of its
// max-context KV (Strata: "KV streaming ... the K/V in 1.48 GiB of pinned RAM" per engine on h11), because a
// replica's attention cache is its own. What is NOT duplicated is the routed-expert file: one locked
// page-cache copy, owned by the host's strata-expert-lock service and mapped by every replica, counted once.

// ---- THE GRANT

type ServingDevice {
  device: NonEmptyStr
  board: DeclarationRef
  vram: ServingMemoryReading
}

// WHERE AN ARTIFACT'S BYTES SIT, and what holds them there. ONE PLACEMENT VOCABULARY FOR EVERY HOST (operator,
// 2026-11-09, relayed by gentle-swift-129: "model the expert tier so it can sit in a per-profile ladder (GPU ->
// host RAM capped bytes -> disk capped bytes, with the realizing mechanism) rather than as a Strata-specific
// special case, because h11 (experts mlocked in RAM today) should become a row edit, not a redesign"). A rung is
// one medium holding some number of the artifact's bytes, with the mechanism that realizes it; the rungs are
// ordered fastest-first, and one artifact's rungs hold different amounts of it — the same routed experts sit
// 22.9 GiB on the cards, 13.2 GiB of that resident in host RAM, and all of it on the drive.
//
// THE HOST BUDGET RESERVES THE HOST-RAM RUNG ONLY: the device rung is VRAM, which the per-card terms already
// budget (ServingBackendProfile.device_fixed_vram and device_min_elastic_vram — this is that same
// fixed-plus-elastic-floor shape lifted to the host tiers), and the disk rung is disk, charged where the snapshot
// pool is budgeted, not against the engine's RAM. The rungs below the one the budget reserves exist to say what
// a miss costs, which is the whole reason they are modelled.
type ServingArtifactMedium = ArtifactOnDevice | ArtifactInHostRam | ArtifactOnDisk

// HOW A RUNG HOLDS ITS BYTES, which decides whether the host may count on them being gone. A rung held PINNED —
// mlocked by a unit, or privately allocated by the engine itself — is charged WHOLE and stays charged: nobody can
// squeeze it, so the budget must reserve all of it. A rung held EVICTABLY, as a page cache or a cache under a
// replacement policy, is BOUNDED: it grows into whatever its budget leaves free and is reclaimed first under
// pressure, so the budget reserves its FLOOR only — the part that must stay or the rung is pointless. The same
// file under --mlock and under --mmap-experts is the same bytes and a different charge. The FLOOR travels on the
// evictable arm alone: a pinned rung has no re-acquire floor to state, and an evictable rung cannot be built
// without one — so the shape the layout used to refuse at run time (an evictable rung with no floor) is unwritable,
// and the check that caught it is gone because there is nothing left for it to catch.
//
// Durability is NOT part of this pair: an expert tier's bytes are always re-readable from the model file, while a
// parked conversation's KV is not (gunbc.serving.serving_host_memory records that Strata's slot save/restore is
// unsupported under --layer-split --batch, so KV that is not persisted is LOST). Experts and conversation KV
// share this placement vocabulary and never share its mechanics or its durability.
type ServingArtifactHold = ArtifactHeldPinned { mechanism: NonEmptyStr } | ArtifactHeldEvictable { bound_by: NonEmptyStr, floor: ServingMemoryReading }

// One rung: where on ONE medium the artifact's bytes sit. `bytes` is what the rung holds; the floor an evictable
// rung must state lives on its hold. There is no `medium` field — an artifact's medium is WHICH FIELD holds the
// rung (device, host RAM, or disk) — so a rung cannot claim two media, and there is no list of rungs for the
// budget to have to pick one host-RAM rung out of.
type ServingArtifactRung = {
  bytes: ServingMemoryReading,
  holds: ServingArtifactHold,
  realizes: NonEmptyStr
}

// WHAT EVERY ENGINE ON THE HOST USES INSTEAD OF CARRYING ITS OWN COPY: a resident artifact the host budget
// charges ONCE. The bytes are the host's own figure for what the copy occupies (the model file's size is a
// separate fact, carried by the artifact row itself); whose copy it is, is `owner`; where and how it is held is
// the three optional rungs — AT MOST ONE per medium, so the two-host-RAM-rung shape the budget could not read is
// not a state that can be written. One engine per host still means one copy per host: a shared artifact names the
// copy the host pays for, not a count of processes sharing it (srv3 and srv4 each run ONE engine, so their 46.84
// GiB arena is one copy, not two — bold-wren-111's correction of 2026-11-09).
type ServingSharedArtifact = {
  name: NonEmptyStr,
  bytes: ByteSize,
  owner: NonEmptyStr,
  device: ServingArtifactRung?,
  host_ram: ServingArtifactRung?,
  disk: ServingArtifactRung?
}

// The rung's hold, as identity text. A pinned rung that becomes evictable is a different configuration and must
// requalify; this name is how the identity sees it. The medium is the field name the caller already knows.
fn serving_artifact_hold_text(h: ServingArtifactHold) -> String {
  match h { ArtifactHeldPinned { mechanism: _ } => "pinned" , ArtifactHeldEvictable { bound_by: _, floor: _ } => "evictable"  }
}

// ONE RUNG AS IDENTITY FRAMES, or nothing when the artifact has no rung on that medium. A rung that moves bytes,
// changes its hold, or states a different floor is a different configuration; the charged figures (bytes, and the
// evictable floor the budget reserves) are all in here so a change to any of them requalifies the layout.
fn serving_artifact_rung_frame(prefix: String, r: ServingArtifactRung?) -> String {
  match r {
    Absent => ""
    Present { value: rung } => concat(identity_frame(label: concat(prefix, "-hold"), value: serving_artifact_hold_text(h: rung.holds)),
      concat(identity_frame(label: concat(prefix, "-bytes"), value: to_string(byte_size_count(b: serving_reading_bytes_or_zero(r: rung.bytes)))),
      concat(identity_frame(label: concat(prefix, "-floor"), value: to_string(byte_size_count(b: match rung.holds {
        ArtifactHeldPinned { mechanism: _ } => byte_size(count: 0)
        ArtifactHeldEvictable { bound_by: _, floor: f } => serving_reading_bytes_or_zero(r: f)
      }))), identity_frame(label: concat(prefix, "-realizes"), value: rung.realizes as String))))
  }
}

// WHAT THE HOST MUST RESERVE FOR AN ARTIFACT: the whole of a pinned host-RAM rung, the floor of an evictable one.
// Nothing else is charged against the host's memory — the device rung is VRAM, budgeted per card, and the disk
// rung is disk. No host-RAM rung reserves nothing, which is right: a disk-only artifact is real. There is at most
// one host-RAM rung, so this reads THAT rung's hold; there is no list to sum and no second rung to have to refuse.
fn serving_artifact_host_ram_charge(a: ServingSharedArtifact) -> ByteSize {
  match a.host_ram {
    Absent => byte_size(count: 0)
    Present { value: r } => match r.holds {
      ArtifactHeldPinned { mechanism: _ } => serving_reading_bytes_or_zero(r: r.bytes)
      ArtifactHeldEvictable { bound_by: _, floor: f } => serving_reading_bytes_or_zero(r: f)
    }
  }
}

// charging: what the per-replica caps assume about which cgroup pays for shared pages. Linux charges a page to
// the cgroup that first touches it, so a shared artifact counted once in the host budget is only absent from
// each replica's cap if its owner faulted it in first; a stated, unverified ordering is an assumption.
type ServingResourceGrant {
  host: HostIdentity
  usable_ram: HostUsableRam
  overhead: HostFixedOverhead
  shared: List<ServingSharedArtifact>
  swap_bound: ServingMemoryReading
  devices: List<ServingDevice>
  charging: List<NonEmptyStr>
}

// ---- THE TOPOLOGY: one replica per group; a group of two or more devices is one replica across them.

type ServingDeviceGroup {
  name: NonEmptyStr
  devices: List<NonEmptyStr>
}

// ---- THE BACKEND PROFILE

type ServingBackendProfile {
  backend: NonEmptyStr
  // VRAM a device needs before its elastic expert cache, and the least expert cache the engine runs with.
  device_fixed_vram: ServingMemoryReading
  device_min_elastic_vram: ServingMemoryReading
  // Host RAM one replica process holds loaded and idle, with nothing retained.
  replica_base_ram: ServingMemoryReading
  // Requests a replica serves at once, and the host RAM each needs above the base (including the transient
  // peak of capturing or restoring a conversation snapshot).
  active_slots: Nat
  active_slot_ram: ServingMemoryReading
  // What one retained conversation costs as a function of its context.
  retention: ConversationSnapshotCost
  // The free memory the engine requires inside its own cgroup beside a snapshot before it parks one: a cap
  // without this headroom makes the engine skip parking (Strata: "skip parking (physical RAM admission; need
  // N MiB plus F MiB floor ... source cgroup)"), so the retention budget is unusable without it.
  park_free_floor: ServingMemoryReading
  // The most devices a replica may span and still retain conversations.
  max_devices_with_retention: Nat
  // The longest context a replica is launched to serve.
  max_context: TokenCount
}

type ServingRequirement {
  max_context: TokenCount
  min_retained_per_replica: Nat
}

// ---- THE RESULT

type ServingReplicaConfig {
  group: NonEmptyStr
  devices: List<NonEmptyStr>
  memory_max: ByteSize
  swap_max: ServingMemoryReading
  retention_budget: ByteSize
  admitted_conversations: Nat
  active_slots: Nat
  max_context: TokenCount
}

type ServingBackendSupport
  = ServingBackendSupportsTopology
  | ServingBackendRefusesTopology { group: NonEmptyStr, reason: NonEmptyStr }

// A live qualification is a receipt bound to the configuration it was taken on. Any change to an input that
// changes the derived configuration leaves the receipt describing a configuration that no longer exists.
type ServingLiveQualification
  = ServingLiveUnqualified { obligation: NonEmptyStr }
  | ServingLiveQualified { receipt: NonEmptyStr, configuration: String }

type ServingLiveStanding
  = ServingLiveStandingUnqualified { obligation: NonEmptyStr }
  | ServingLiveStandingQualified { receipt: NonEmptyStr }
  | ServingLiveRequalificationRequired { qualified: String, derived: String }

type ServingLayoutEvidence {
  // The configuration's identity: what a live receipt must have been taken on (serving_layout_identity).
  configuration: String
  budget: ServingMemoryVerdict
  assumptions: List<NonEmptyStr>
  backend: ServingBackendSupport
  live: ServingLiveStanding
}

type ServingLayoutRefusal
  = ServingLayoutInputsUnread { missing: List<NonEmptyStr> }
  | ServingLayoutNoGroups
  | ServingLayoutUnknownDevice { group: NonEmptyStr, device: NonEmptyStr }
  | ServingLayoutDeviceInTwoGroups { device: NonEmptyStr }
  | ServingLayoutEmptyGroup { group: NonEmptyStr }
  | ServingLayoutDuplicateGroupName { group: NonEmptyStr }
  | ServingLayoutContextAboveBackend { required: TokenCount, backend: TokenCount }
  | ServingLayoutSnapshotCostNotPositive { context: TokenCount }
  | ServingLayoutBackendCannotRetain { group: NonEmptyStr, devices: Nat, most: Nat }
  | ServingLayoutDeviceTooSmall { device: NonEmptyStr, needed: ByteSize, has: ByteSize }
  | ServingLayoutRamShort { needed: ByteSize, available: ByteSize }

type ServingLayoutResult
  = ServingLayoutConfigured { replicas: List<ServingReplicaConfig>, unallocated_ram: ByteSize, evidence: ServingLayoutEvidence }
  | ServingLayoutRefused { refusal: ServingLayoutRefusal }

// ---- THE DERIVATION

// THE CAP GRANULE: every derived cap and retention budget is a whole number of these, because a cgroup's
// MemoryMax is written in MiB. One fact; the rounding and the headroom it costs both read it.
fn serving_cap_granule() -> ByteSize { mebibyte_to_byte_size(m: mebibyte(count: 1)) }

// HOW MANY TIMES ONE REPLICA'S FIGURES ARE ROUNDED UP to the granule: its retention budget, then its cap
// (serving_replica_config). Each rounding adds less than one granule, so this many granules bounds the
// headroom one replica can cost beyond its unrounded need, however many conversations it is dealt.
fn serving_roundings_per_replica() -> Nat { 2 }

fn serving_mib_ceil(b: Nat) -> ByteSize {
  let g = byte_size_count(b: serving_cap_granule())
  byte_size(count: ((b + g - 1) / g) * g)
}

fn serving_bytes_sum(xs: List<ByteSize>) -> Nat {
  fold(xs, init: 0, f: (acc, x) => acc + byte_size_count(b: x))
}

fn serving_grant_ram(g: ServingResourceGrant) -> Nat {
  match g.usable_ram {
    HostUsableRamMeasured { bytes: b, provenance: _ } => byte_size_count(b: b)
    HostUsableRamConservativeLowerBound { bytes: b, basis: _ } => byte_size_count(b: b)
    HostUsableRamUnmeasured { reason: _ } => 0
  }
}

fn serving_grant_overhead(g: ServingResourceGrant) -> Nat {
  match g.overhead {
    HostFixedOverheadMeasured { bytes: b, provenance: _ } => byte_size_count(b: b)
    HostFixedOverheadAllowance { bytes: b, reason: _ } => byte_size_count(b: b)
    HostFixedOverheadUnmeasured { reason: _ } => 0
  }
}

fn serving_profile_readings(b: ServingBackendProfile) -> List<ServingMemoryReading> {
  [b.device_fixed_vram, b.device_min_elastic_vram, b.replica_base_ram, b.active_slot_ram, b.park_free_floor]
}

fn serving_layout_missing(g: ServingResourceGrant, b: ServingBackendProfile) -> List<NonEmptyStr> {
  let ram = match g.usable_ram {
    HostUsableRamUnmeasured { reason: r } => [r]
    _ => [] as List<NonEmptyStr>
  }
  let overhead = match g.overhead {
    HostFixedOverheadUnmeasured { reason: r } => [r]
    _ => [] as List<NonEmptyStr>
  }
  let backend_figures = flat_map(serving_profile_readings(b: b), x => serving_reading_missing(r: x))
  let devices_missing = flat_map(g.devices, d => serving_reading_missing(r: d.vram))
  // THE SWAP BOUND IS GUARDED LIKE EVERY OTHER CHARGED READING. It is charged in the identity frame and the host-memory
  // verdict through serving_reading_bytes_or_zero, whose Unread arm contributes nothing -- so an Unread bound would be
  // billed as zero, silently widening the budget (gunbc.design_argument::fail_closed). Refusing while it is unread makes
  // that collapse unreachable: an operator who has not read MemorySwapMax gets ServingLayoutInputsUnread, not a free pass.
  let swap_missing = flat_map([g.swap_bound], x => serving_reading_missing(r: x))
  concat(ram, concat(overhead, concat(backend_figures, concat(devices_missing, swap_missing))))
}

// What a configuration rests on that no reading has shown at the requirement: allowances, and a retention cost
// extrapolated past the longest conversation actually parked.
fn serving_retention_extrapolated(b: ServingBackendProfile, r: ServingRequirement) -> List<NonEmptyStr> {
  if token_count_value(t: r.max_context) > token_count_value(t: b.retention.observed_up_to) {
    ["retention cost at the context ceiling is extrapolated: no conversation that long has been parked and read" as NonEmptyStr]
  } else { [] as List<NonEmptyStr> }
}

fn serving_layout_assumptions(g: ServingResourceGrant, b: ServingBackendProfile) -> List<NonEmptyStr> {
  let overhead = match g.overhead {
    HostFixedOverheadAllowance { bytes: _, reason: r } => [r]
    _ => [] as List<NonEmptyStr>
  }
  let backend_figures = flat_map(serving_profile_readings(b: b), x => serving_reading_assumption(r: x))
  concat(overhead, concat(backend_figures, flat_map(g.devices, d => serving_reading_assumption(r: d.vram))))
}

fn serving_device_named(g: ServingResourceGrant, name: NonEmptyStr) -> ServingDevice? {
  fold(g.devices, init: Absent, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => if d.device == name { Present { value: d } } else { Absent }
  })
}

fn serving_group_count_with(groups: List<ServingDeviceGroup>, device: NonEmptyStr) -> Nat {
  fold(groups, init: 0, f: (acc, gr) => acc + filter(gr.devices, d => d == device).length())
}

// The first structural fault in the topology, in a fixed order: no groups, an empty group, a group name used
// twice, a device the grant does not have, a device in two groups. Absent when the topology is a partition of
// granted devices into uniquely named groups. A group name is a replica's name, so two groups under one name
// would be two replicas one receipt or one binding could not tell apart.
fn serving_topology_fault(g: ServingResourceGrant, groups: List<ServingDeviceGroup>) -> ServingLayoutRefusal? {
  if groups.length() == 0 { Present { value: ServingLayoutNoGroups } } else {
    fold(groups, init: Absent, f: (acc, gr) => match acc {
      Present { value: v } => Present { value: v }
      Absent =>
        if gr.devices.length() == 0 { Present { value: ServingLayoutEmptyGroup { group: gr.name } } } else if filter(groups, o => o.name == gr.name).length() > 1 { Present { value: ServingLayoutDuplicateGroupName { group: gr.name } } } else {
          fold(gr.devices, init: Absent, f: (inner, d) => match inner {
            Present { value: v } => Present { value: v }
            Absent => match serving_device_named(g: g, name: d) {
              Absent => Present { value: ServingLayoutUnknownDevice { group: gr.name, device: d } }
              Present { value: _ } => if serving_group_count_with(groups: groups, device: d) > 1 { Present { value: ServingLayoutDeviceInTwoGroups { device: d } } } else { Absent }
            }
          })
        }
    })
  }
}

// Per-device fit: every device must hold the backend's fixed VRAM plus the least elastic expert cache.
fn serving_device_fault(g: ServingResourceGrant, b: ServingBackendProfile) -> ServingLayoutRefusal? {
  let need = byte_size_count(b: serving_reading_bytes_or_zero(r: b.device_fixed_vram)) + byte_size_count(b: serving_reading_bytes_or_zero(r: b.device_min_elastic_vram))
  fold(g.devices, init: Absent, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent =>
      if byte_size_count(b: serving_reading_bytes_or_zero(r: d.vram)) < need {
        Present { value: ServingLayoutDeviceTooSmall { device: d.device, needed: byte_size(count: need), has: serving_reading_bytes_or_zero(r: d.vram) } }
      } else { Absent }
  })
}

// The backend's retention limit binds every group, whatever the requirement's minimum: serving_allocate deals
// RAM left over as retained conversations to every replica, so a minimum of zero still allocates retention
// and is no licence to span more devices than the backend retains across.
fn serving_retention_fault(groups: List<ServingDeviceGroup>, b: ServingBackendProfile) -> ServingLayoutRefusal? {
  fold(groups, init: Absent, f: (acc, gr) => match acc {
    Present { value: v } => Present { value: v }
    Absent => if gr.devices.length() > b.max_devices_with_retention { Present { value: ServingLayoutBackendCannotRetain { group: gr.name, devices: gr.devices.length(), most: b.max_devices_with_retention } } } else { Absent }
  })
}

// (There is NO run-time artifact budget check: the two shapes that used to be refused — two host-RAM rungs, and
// an evictable rung with no floor — are now unwritable in the type itself, so construction stands where the check
// used to stand. See ServingSharedArtifact / ServingArtifactHold.)

// What one replica needs beside its retention budget: its base, its active slots, and the free headroom the
// engine demands before it will park.
fn serving_replica_fixed_ram(b: ServingBackendProfile) -> Nat {
  byte_size_count(b: serving_reading_bytes_or_zero(r: b.replica_base_ram)) + b.active_slots * byte_size_count(b: serving_reading_bytes_or_zero(r: b.active_slot_ram))
    + byte_size_count(b: serving_reading_bytes_or_zero(r: b.park_free_floor))
}

fn serving_replica_config(gr: ServingDeviceGroup, b: ServingBackendProfile, r: ServingRequirement, swap: ServingMemoryReading, admitted: Nat) -> ServingReplicaConfig {
  let snapshot = byte_size_count(b: conversation_snapshot_bytes(cost: b.retention, context: r.max_context))
  let retention = serving_mib_ceil(b: admitted * snapshot)
  ServingReplicaConfig {
    group: gr.name, devices: gr.devices,
    memory_max: serving_mib_ceil(b: serving_replica_fixed_ram(b: b) + byte_size_count(b: retention)),
    swap_max: swap, retention_budget: retention, admitted_conversations: admitted,
    active_slots: b.active_slots, max_context: r.max_context,
  }
}

// The conversations replica `index` gets when `extra` are dealt one per replica in order after each has `base`.
fn serving_dealt(index: Nat, replicas: Nat, base: Nat, extra: Nat) -> Nat {
  let rounds = extra / replicas
  let remainder = extra - rounds * replicas
  if index < remainder { nat_add(a: base + rounds, b: 1) } else { base + rounds }
}

// THE RAM ALLOCATION. The pool is what the host overhead and the shared artifacts leave. Every replica first
// gets its fixed RAM, its minimum retention and the rounding headroom of its own caps; what remains becomes
// whole additional max-context conversations, dealt one per replica in group order until none fits; the rest
// is reported unallocated, not spread. Each replica's cap is then its own need rounded up to the cap granule,
// which the headroom already covers, so a dealt conversation costs its snapshot and nothing more.
fn serving_allocate(g: ServingResourceGrant, groups: List<ServingDeviceGroup>, b: ServingBackendProfile, r: ServingRequirement) -> ServingLayoutResult {
  let n = groups.length()
  let pool_total = serving_grant_ram(g: g)
  let reserved = serving_grant_overhead(g: g) + serving_bytes_sum(xs: map(g.shared, a => serving_artifact_host_ram_charge(a: a)))
  let snapshot = byte_size_count(b: conversation_snapshot_bytes(cost: b.retention, context: r.max_context))
  let per_replica_min = serving_replica_fixed_ram(b: b) + r.min_retained_per_replica * snapshot + serving_roundings_per_replica() * byte_size_count(b: serving_cap_granule())
  let needed = reserved + n * per_replica_min
  if pool_total < needed {
    ServingLayoutRefused { refusal: ServingLayoutRamShort { needed: byte_size(count: needed), available: byte_size(count: pool_total) } }
  } else {
    let extra = (pool_total - needed) / snapshot
    let configs = fold(groups, init: [] as List<ServingReplicaConfig>, f: (acc, gr) =>
      concat(acc, [serving_replica_config(gr: gr, b: b, r: r, swap: g.swap_bound, admitted: serving_dealt(index: acc.length(), replicas: n, base: r.min_retained_per_replica, extra: extra))]))
    let committed = reserved + serving_bytes_sum(xs: map(configs, c => c.memory_max))
    ServingLayoutConfigured {
      replicas: configs,
      unallocated_ram: byte_size(count: pool_total - committed),
      evidence: ServingLayoutEvidence {
        configuration: serving_layout_identity(g: g, b: b, replicas: configs),
        budget: serving_host_memory_verdict(h: serving_layout_host_memory(g: g, b: b, configs: configs)),
        assumptions: concat(serving_layout_assumptions(g: g, b: b), concat(serving_retention_extrapolated(b: b, r: r), g.charging)),
        backend: ServingBackendSupportsTopology,
        live: ServingLiveStandingUnqualified { obligation: "unqualified: no live receipt has been taken on this configuration" as NonEmptyStr },
      },
    }
  }
}

// The derived configuration as the dedicated-host tree serving_host_memory already judges, so "the budget
// fits" is the same verdict that refuses an over-committed layout, not a second arithmetic.
fn serving_layout_host_memory(g: ServingResourceGrant, b: ServingBackendProfile, configs: List<ServingReplicaConfig>) -> ServingDedicatedHostMemory {
  ServingDedicatedHostMemory {
    host: g.host, usable_ram: g.usable_ram, overhead: g.overhead,
    shared_resident: byte_size(count: serving_bytes_sum(xs: map(g.shared, a => serving_artifact_host_ram_charge(a: a)))),
    swap_bound: serving_reading_bytes_or_zero(r: g.swap_bound),
    engines: map(configs, c => ServingEngineMemory {
      name: c.group,
      memory_cap: ServingMemoryRead { bytes: c.memory_max, provenance: "derived by gunbc.serving.serving_layout serving_layout_derive" as NonEmptyStr },
      swap_cap: c.swap_max,
      base: ServingMemoryAssumed { bytes: byte_size(count: serving_replica_fixed_ram(b: b)), reason: "base, active-slot RAM and park headroom from the backend profile" as NonEmptyStr },
      conversation_cache: ServingMemoryRead { bytes: c.retention_budget, provenance: "derived by gunbc.serving.serving_layout serving_layout_derive" as NonEmptyStr },
      conversation_slots: Present { value: c.admitted_conversations },
    }),
  }
}

// THE ARM ORDER IS THE CHECK ORDER: unread inputs, the topology's structure, the context ceiling, a positive
// snapshot cost, the backend's retention limit, per-device fit, then RAM. The allocation divides the RAM it has
// left by one conversation's snapshot, so a backend whose snapshot at the required context costs nothing has no
// finite conversation count here: it refuses rather than divide by zero. A backend that genuinely retains no
// host state needs its own capacity constraint, not this byte budget.
fn serving_layout_derive(g: ServingResourceGrant, groups: List<ServingDeviceGroup>, b: ServingBackendProfile, r: ServingRequirement) -> ServingLayoutResult {
  if serving_layout_missing(g: g, b: b).length() > 0 {
    ServingLayoutRefused { refusal: ServingLayoutInputsUnread { missing: serving_layout_missing(g: g, b: b) } }
  } else {
    match serving_topology_fault(g: g, groups: groups) {
      Present { value: f } => ServingLayoutRefused { refusal: f }
      Absent =>
        if token_count_value(t: r.max_context) > token_count_value(t: b.max_context) {
          ServingLayoutRefused { refusal: ServingLayoutContextAboveBackend { required: r.max_context, backend: b.max_context } }
        } else if byte_size_count(b: conversation_snapshot_bytes(cost: b.retention, context: r.max_context)) == 0 {
          ServingLayoutRefused { refusal: ServingLayoutSnapshotCostNotPositive { context: r.max_context } }
        } else {
          match serving_retention_fault(groups: groups, b: b) {
            Present { value: f } => ServingLayoutRefused { refusal: f }
            Absent => match serving_device_fault(g: g, b: b) {
              Present { value: f } => ServingLayoutRefused { refusal: f }
              Absent => serving_allocate(g: g, groups: groups, b: b, r: r)
            }
          }
        }
    }
  }
}

// ---- LIVE QUALIFICATION AND REDERIVATION

// The configuration's identity as a receipt can bind it. Every component is length-framed through the
// repository's one identity framing (std.content_hash identity_frame, as rented_replica_wire uses), so no
// free-string name can impersonate a delimiter: ["a+b"] and ["a", "b"] are different identities. A replica's
// identity is its group, each device, cap, swap, retention budget, admitted count, active slots and ceiling.
fn serving_replica_identity(c: ServingReplicaConfig) -> String {
  concat(identity_frame(label: "group", value: c.group as String),
    concat(identity_frame(label: "devices", value: to_string(c.devices.length())),
    concat(fold(c.devices, init: "", f: (acc, d) => concat(acc, identity_frame(label: "device", value: d as String))),
    concat(identity_frame(label: "memory-max", value: to_string(byte_size_count(b: c.memory_max))),
    concat(identity_frame(label: "swap-max", value: to_string(byte_size_count(b: serving_reading_bytes_or_zero(r: c.swap_max)))),
    concat(identity_frame(label: "retention", value: to_string(byte_size_count(b: c.retention_budget))),
    concat(identity_frame(label: "admitted", value: to_string(c.admitted_conversations)),
    concat(identity_frame(label: "active-slots", value: to_string(c.active_slots)),
      identity_frame(label: "max-context", value: to_string(token_count_value(t: c.max_context)))))))))))
}

fn serving_configuration_identity(replicas: List<ServingReplicaConfig>) -> String {
  concat(identity_frame(label: "replicas", value: to_string(replicas.length())),
    fold(replicas, init: "", f: (acc, c) => concat(acc, identity_frame(label: "replica", value: serving_replica_identity(c: c)))))
}

// The grant facts the derived caps stand on: usable RAM, overhead, each shared artifact, the charging
// assumptions, and every selected device's board and VRAM. Two grants that derive equal caps from different
// hardware are different configurations: a receipt taken on 15,356 MiB devices says nothing about 24,576 MiB
// ones, nor about another board under the same device name. A board is framed by its STRUCTURAL identity
// (module, declaration and field arm each tagged), never its display key: "m" + "b::c" and "m::b" + "c"
// display alike and are different references.
fn serving_grant_identity(g: ServingResourceGrant, replicas: List<ServingReplicaConfig>) -> String {
  concat(identity_frame(label: "usable-ram", value: to_string(serving_grant_ram(g: g))),
    concat(identity_frame(label: "overhead", value: to_string(serving_grant_overhead(g: g))),
    concat(identity_frame(label: "shared", value: to_string(g.shared.length())),
    concat(fold(g.shared, init: "", f: (acc, a) => concat(acc, concat(identity_frame(label: "artifact", value: a.name as String), concat(identity_frame(label: "artifact-bytes", value: to_string(byte_size_count(b: a.bytes))), concat(identity_frame(label: "artifact-owner", value: a.owner as String), concat(serving_artifact_rung_frame(prefix: "artifact-device", r: a.device), concat(serving_artifact_rung_frame(prefix: "artifact-host-ram", r: a.host_ram), serving_artifact_rung_frame(prefix: "artifact-disk", r: a.disk)))))))),
    concat(identity_frame(label: "charging", value: to_string(g.charging.length())),
    concat(fold(g.charging, init: "", f: (acc, c) => concat(acc, identity_frame(label: "assumption", value: c as String))),
      fold(replicas, init: "", f: (acc, c) => concat(acc, fold(c.devices, init: "", f: (inner, d) => concat(inner, match serving_device_named(g: g, name: d) {
        Present { value: dv } => concat(identity_frame(label: "selected-device", value: d as String), concat(identity_frame(label: "board", value: declaration_ref_identity(reference: dv.board).digest), identity_frame(label: "vram", value: to_string(byte_size_count(b: serving_reading_bytes_or_zero(r: dv.vram))))))
        Absent => identity_frame(label: "selected-device-ungranted", value: d as String)
      }))))))))))
}

// THE WHOLE CONFIGURATION a receipt is bound to: the host, the grant facts the caps stand on, the backend (its release and model as the profile
// names them, the snapshot cost its KV settings produce, its park headroom and launched ceiling) and every
// replica. Two hosts, or two backends, deriving the same numbers are different configurations, so a receipt
// taken on one never qualifies the other. The launch row's complete argv is not yet a carrier; it joins this
// identity when the launch row renders from the layout (serving_layout_consumer_frontier).
fn serving_layout_identity(g: ServingResourceGrant, b: ServingBackendProfile, replicas: List<ServingReplicaConfig>) -> String {
  concat(identity_frame(label: "host", value: g.host as String),
    concat(identity_frame(label: "grant", value: serving_grant_identity(g: g, replicas: replicas)),
    concat(identity_frame(label: "backend", value: b.backend as String),
    concat(identity_frame(label: "snapshot-fixed", value: to_string(byte_size_count(b: b.retention.fixed))),
    concat(identity_frame(label: "snapshot-per-token", value: to_string(byte_size_count(b: b.retention.per_token))),
    concat(identity_frame(label: "park-floor", value: to_string(byte_size_count(b: serving_reading_bytes_or_zero(r: b.park_free_floor)))),
    concat(identity_frame(label: "backend-max-context", value: to_string(token_count_value(t: b.max_context))),
      serving_configuration_identity(replicas: replicas))))))))
}

// A receipt qualifies the derived configuration only if it was taken on exactly this configuration. A changed
// grant, topology, backend profile or requirement that changes the derivation leaves the old receipt naming a
// configuration that is gone, and the standing says so rather than carrying the qualification forward.
fn serving_layout_with_qualification(result: ServingLayoutResult, q: ServingLiveQualification) -> ServingLayoutResult {
  match result {
    ServingLayoutRefused { refusal: f } => ServingLayoutRefused { refusal: f }
    ServingLayoutConfigured { replicas: rs, unallocated_ram: u, evidence: e } =>
      ServingLayoutConfigured { replicas: rs, unallocated_ram: u, evidence: ServingLayoutEvidence {
        configuration: e.configuration, budget: e.budget, assumptions: e.assumptions, backend: e.backend,
        live: match q {
          ServingLiveUnqualified { obligation: o } => ServingLiveStandingUnqualified { obligation: o }
          ServingLiveQualified { receipt: rc, configuration: c } =>
            if c == e.configuration { ServingLiveStandingQualified { receipt: rc } } else { ServingLiveRequalificationRequired { qualified: c, derived: e.configuration } }
        },
      } }
  }
}

// ---- ADMISSION ARITHMETIC: a replica admits a conversation only if every admitted conversation, this one
// included, can still grow to the context ceiling within its retention budget. A refusal changes nothing: it
// never evicts. THIS IS THE COUNT, NOT THE PROTOCOL: it takes the admitted count as given, so it cannot say which
// conversations are counted, whether a request resumes one already admitted, or whether another admission ran
// concurrently. The protocol (find or acquire this conversation's retention reservation, then its turn grant,
// keyed by an authenticated conversation identity and joined to turn_admission's seat ledger) is
// serving_admission_protocol_frontier.
type ServingAdmission
  = ServingAdmitted { now_admitted: Nat }
  | ServingAdmissionRefused { admitted: Nat, capacity: Nat }

fn serving_replica_admit(c: ServingReplicaConfig, admitted: Nat) -> ServingAdmission {
  if admitted < c.admitted_conversations { ServingAdmitted { now_admitted: admitted + 1 } } else { ServingAdmissionRefused { admitted: admitted, capacity: c.admitted_conversations } }
}

// ---- h11 AS GRANTED, AND STRATA IQ3_S AS MEASURED ON IT

fn host_6ce85c_a16_device(bus: String) -> ServingDevice {
  ServingDevice {
    device: ("a16-" + bus) as NonEmptyStr,
    board: decl_ref(module_path: "extdeps.gpu.nvidia_a16", decl_name: "nvidia_a16_board_catalog"),
    vram: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 15356)), provenance: "nvidia-smi memory.total 15356 MiB, every A16 GPU on h11-a16, read 2026-10-30" as NonEmptyStr },
  }
}

// THE GRANT. RAM and the locked expert file are the observed row's; the four devices are the four buses whose
// engines are in service. 86 and c6 were already disabled; c5 and c7 are disabled by operator ruling 2026-11-01 (A-prime):
// at the 229,376-token ceiling this profile needs ~14 GiB per engine, and five engines needed 127 GB against ~118 GB
// available (the derivation refused ServingLayoutRamShort), so four engines that each park one conversation beat six that
// skip every park. c7 served nothing in the measured window and c5 the least. The host overhead is an ALLOWANCE until a reading with
// every engine stopped replaces it.
data host_6ce85c_grant: ServingResourceGrant = ServingResourceGrant {
  host: operator_host_6ce85c,
  usable_ram: host_6ce85c_serving_memory_observed.usable_ram,
  overhead: HostFixedOverheadAllowance { bytes: gibibyte_to_byte_size(g: gibibyte(count: 6)), reason: "h11 host overhead: a 6 GiB allowance for the OS, sshd and the server.py front ends until a reading with every engine stopped replaces it" as NonEmptyStr },
  shared: [ServingSharedArtifact {
    name: "Qwen3.8-Flash-Next IQ3_S routed-expert GGUF part 1" as NonEmptyStr,
    bytes: host_6ce85c_serving_memory_observed.shared_resident,
    owner: "strata-expert-lock.service (mlock, one page-cache copy mapped by every engine)" as NonEmptyStr,
    // h11's residency, spelled in the ladder every host now uses, with its charge UNCHANGED: a pinned host-RAM
    // rung reserves its whole figure, which is what this artifact charged before rungs existed. Moving h11 onto
    // evictable mapped experts is its OWN modelled transition — the lock service's ownership, the grant, the
    // launch and the qualification all move with it (bold-wren-111 and gentle-swift-129, 2026-11-09) — and is
    // deliberately NOT taken here.
    device: Absent,
    host_ram: Present { value: ServingArtifactRung {
      holds: ArtifactHeldPinned { mechanism: "strata-expert-lock.service mlocks the file; engines start After= it, so no engine pays for it and nothing can reclaim it" as NonEmptyStr },
      bytes: ServingMemoryRead { bytes: host_6ce85c_serving_memory_observed.shared_resident, provenance: "the lock service's resident copy as the host charges it (host_6ce85c_serving_memory_observed.shared_resident)" as NonEmptyStr },
      realizes: "one page-cache copy, mlocked, mapped by every engine on the host; the GGUF shard on the drive is its source, so an expert miss is a re-read, never a loss -- the drive is where the bytes come FROM, not a rung charged to anyone (review 92384)" as NonEmptyStr,
    } },
    disk: Absent,
  }],
  swap_bound: serving_engine_swap_bound,
  charging: ["shared expert pages are charged to strata-expert-lock, not the engines: 47,784 MiB of the 51.05 GiB file read unevictable in its cgroup on 2026-10-30T19:20Z, and engines start After= it from that date; the remaining ~3.3 GiB's charge is unread" as NonEmptyStr],
  devices: [host_6ce85c_a16_device(bus: "85"), host_6ce85c_a16_device(bus: "87"), host_6ce85c_a16_device(bus: "88"), host_6ce85c_a16_device(bus: "c8")],
}

// INDEPENDENT GROUPS FIRST: one replica per device.
data host_6ce85c_independent_groups: List<ServingDeviceGroup> = [
  ServingDeviceGroup { name: "h11-strata@85" as NonEmptyStr, devices: ["a16-85"] },
  ServingDeviceGroup { name: "h11-strata@87" as NonEmptyStr, devices: ["a16-87"] },
  ServingDeviceGroup { name: "h11-strata@88" as NonEmptyStr, devices: ["a16-88"] },
  ServingDeviceGroup { name: "h11-strata@c8" as NonEmptyStr, devices: ["a16-c8"] },
]

// STRATA 0.1.48 (source 44df8fd5), Qwen3.8-Flash-Next IQ3_S, on one A16 GPU (h11-a16, 2026-10-30). Fixed VRAM is
// what the engine used beside its expert cache (nvidia-smi memory.used 14544 MiB less the engine's reported
// 7935 MiB expert cache). The least expert cache, the active-slot RAM and its snapshot peaks are ASSUMED until
// read. One active slot (/props total_slots 1). THIS RELEASE rejects parking with a layer split (its
// docs/DETAILS.md: "enabled parking with --layer-split is rejected before model loading"), so a replica
// retains only on one device; srv4's later release parks across two (strata_srv4_layer_split_profile). The
// base was read after load, so it includes the pinned host copy of the max-context KV.
data strata_iq3_s_a16_profile: ServingBackendProfile = ServingBackendProfile {
  backend: "strata 0.1.48 (44df8fd5) qwen3.8-flash-next-iq3_s" as NonEmptyStr,
  device_fixed_vram: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 6609)), provenance: "h11-a16 nvidia-smi memory.used 14544 MiB less the engine's expert_cache_mib 7935, 2026-10-30" as NonEmptyStr },
  device_min_elastic_vram: ServingMemoryAssumed { bytes: gibibyte_to_byte_size(g: gibibyte(count: 2)), reason: "least expert cache the engine is run with: a 2 GiB assumption until a run below it is read" as NonEmptyStr },
  replica_base_ram: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 5747)), provenance: "h11-strata@c7 memory.current 5747 MiB (anon 3405 + shmem 2224), loaded, idle for the whole window, nothing parked, read every 15 s 2026-10-31T20:05-21:06Z by ~/runs/cm-anon-sampler.sh on h11" as NonEmptyStr },
  active_slots: 1,
  active_slot_ram: ServingMemoryAssumed { bytes: mebibyte_to_byte_size(m: mebibyte(count: 3328)), reason: "the LIVE conversation stays in host RAM after its turn: measured +2308 MiB anon on h11-strata@85 at 166,510 tokens (3289 -> 5597 MiB), +1608 MiB on c5 at 98,710 and +1033 MiB on 88 at 97,840, i.e. 10.8-17 KiB per token (sampler 2026-10-31T20:05-21:06Z). Extrapolated to the 229,376-token ceiling at the measured 14.2 KiB/token: 3328 MiB. An extrapolation, not a reading at the ceiling (the previous 512 MiB figure was 4-6x low)" as NonEmptyStr },
  retention: strata_iq3_s_snapshot_cost,
  park_free_floor: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 512)), provenance: "h11-strata@c7 engine log: skip parking (physical RAM admission; need 1250 MiB plus 512 MiB floor, 1262 MiB available, source cgroup), 2026-10-30" as NonEmptyStr },
  max_devices_with_retention: 1,
  max_context: token_count(count: 229376),
}

// THE REQUIREMENT: the fleet's one serving context cap (ruling gunbc.design_ruling one_serving_context_cap), and
// at least one conversation retained per replica. Each profile's max_context is a different fact: the ceiling
// that engine is launched with, read from its argv, which the derivation checks against this requirement.
data serving_context_ceiling_requirement: ServingRequirement = ServingRequirement { max_context: serving_fleet_context_cap, min_retained_per_replica: 1 }

data host_6ce85c_layout: ServingLayoutResult = serving_layout_with_qualification(
  result: serving_layout_derive(g: host_6ce85c_grant, groups: host_6ce85c_independent_groups, b: strata_iq3_s_a16_profile, r: serving_context_ceiling_requirement),
  q: ServingLiveUnqualified { obligation: "h11 has not run this configuration: apply it, read each engine's memory.peak through real turns at the ceiling, and bind the receipt to this configuration's identity" as NonEmptyStr },
)

// ---- srv4 AS GRANTED: ONE REPLICA ACROSS TWO GPUs

// ONE BOARD, NAMED AND SIZED BY WHOSE READING IT IS. Both srv hosts run this card; what differs is the name the
// read gives it and whether its size was read there or assumed from the other host.
fn rtx_2000_ada_device(name: String, vram: ServingMemoryReading) -> ServingDevice {
  ServingDevice {
    device: name as NonEmptyStr,
    board: decl_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_2000_ada_board_catalog"),
    vram: vram,
  }
}

fn srv4_rtx_2000_ada_device(bus: String) -> ServingDevice {
  rtx_2000_ada_device(name: "rtx2000ada-" + bus, vram: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 16380)), provenance: "srv4 nvidia-smi memory.total 16380 MiB, both RTX 2000 Ada GPUs, read 2026-10-30" as NonEmptyStr })
}

// THE GRANT is the engine service's own cgroup, not the host and no longer the slice: srv4 also runs CI runners,
// and since 2026-11-09 the operator's hand change caps the ENGINE (/etc/systemd/system/gunbc-srv4-daily-engine
// .service.d/60-expert-l1-cap.conf: MemoryHigh=40G MemoryMax=48G), which its own memory guard reports back as
// "memory guard: limit 40.0 GiB (source: cgroup)". MemoryHigh is the grant because above it the kernel throttles
// and reclaims; MemoryMax is the hard edge. The withdrawn 96 GiB row (gunbc-srv4-daily.slice MemoryHigh, read
// 2026-10-30) no longer describes srv4 and is named here so its deletion is traceable; the config it replaced is
// kept on the host as engine.json.bak-20261109-pre-mmap. Overhead is nothing: the grant IS the engine's cgroup,
// and the TLS front, journald and the CI runners are all outside it. The slice still has no swap.
data srv4_grant: ServingResourceGrant = ServingResourceGrant {
  host: operator_host_srv4,
  // The cap was RAISED the same day it was set: at MemoryHigh=40G the engine sat at its cap with ~19 GB of experts
  // page-cached against a ~22 GB per-request working set, and a cold first request decoded at 5.1 tok/s (41.5 GB
  // read from the drive) where warm requests managed 15.6 (3.1 GB read). At MemoryHigh=56G/MemoryMax=64G three warm
  // requests gave 24.5 / 25.1 / 29.1 tok/s with 1.26 / 0.81 / 1.35 GB read per request and MemoryCurrent 46.5 GB
  // (bold-wren-111, 2026-11-09 ~01:10Z, 500-token test requests). The 40/48 GiB reading is WITHDRAWN here and named
  // in this comment rather than deleted, with the config it replaced kept on the host as
  // engine.json.bak-20261109-pre-mmap. No speed ratio against the old private-arena configuration is recorded:
  // no same-prompt baseline under that configuration exists (its 35-41 tok/s figures were real long-context turns).
  // THE CAP, READ FROM THE ROW THAT OWNS IT. srv4_serving_engine_memory.memory_cap is the single literal for this
  // cgroup limit (review 38602); the basis narrates where it came from and what was measured under it and states no
  // number of its own, so a cap change lands in one place and the layout can never budget against a stale copy.
  usable_ram: HostUsableRamConservativeLowerBound { bytes: serving_reading_bytes_or_zero(r: srv4_serving_engine_memory.memory_cap), basis: "the MemoryHigh of the daily engine unit's cgroup (its drop-in, raised in place 2026-11-09 after the previous cap starved the expert working set); measured under it: warm decode in the mid-20s tok/s with about a gigabyte read per request and MemoryCurrent just under the limit. gunbc.serving.serving_host_memory srv4_serving_engine_memory.memory_cap is that reading" as NonEmptyStr },
  overhead: HostFixedOverheadAllowance { bytes: byte_size(count: 0), reason: "the grant is the engine service's own cgroup cap: the TLS front, journald and the CI runners live outside it, so nothing else is reserved inside it" as NonEmptyStr },
  shared: [srv4_routed_expert_artifact],
  // The swap bound is the engine row's OWN read (systemctl show gunbc-srv4-daily.slice MemorySwapMax=0); the
  // 2026-11-09 drop-in caps memory only, so that 0 still stands. Read once, in serving_host_memory (review 92384).
  swap_bound: srv4_serving_engine_memory.swap_cap,
  charging: [
    "the routed experts are the ENGINE's cgroup's own page cache: --mmap-experts maps the GGUF shards in place (no experts.bin), so their pages are charged to the engine that touches them and are reclaimed first under the cap — unlike h11, where strata-expert-lock holds them and the engines are charged nothing" as NonEmptyStr,
    "one copy per host, charged once: srv4 runs ONE engine across both cards, so the artifact is that engine's mapping and there is no second copy to charge (bold-wren-111, 2026-11-09)" as NonEmptyStr,
    "base and expert tier are charged SEPARATELY and must stay that way: the base is the engine's own anon and shmem (2.5 + 3.8 GiB), the 13.2 GiB of file-backed RSS is the expert rung. Charging base 52 GiB (the 2026-10-30 memory.current, when the experts were private anon inside the engine) on top of a mapped expert tier would bill the same bytes twice" as NonEmptyStr,
  ] as List<NonEmptyStr>,
  devices: [srv4_rtx_2000_ada_device(bus: "0000-01"), srv4_rtx_2000_ada_device(bus: "0004-01")],
}

// THE ROUTED EXPERTS, as one artifact on three rungs, every figure read on srv4 2026-11-09 00:18Z from
// gunbc-srv4-daily-engine (release 406c9de18cef, which is the build the mmap was read on — gentle-swift-129's
// qualification rule: an mmap'd expert tier is only as good as the installed build's --mmap-experts, and this
// build's log says "experts via mmap (--mmap-experts; the GGUF shards in place, no experts.bin)").
//
// THE ARITHMETIC THAT MAKES THE RUNGS ONE ARTIFACT, not three facts: the engine's prefill plan reads "46.8 GiB
// experts, 22.9 GiB in the GPU caches, 0.0 GiB RAM copy, file tier 24.0 GiB" — 22.9 + 24.0 = 46.9, the file
// partitions across the rungs; the 13.2 GiB of resident file RSS is the part of that 24.0 GiB the page cache is
// holding, and the plan itself says "35.2 GiB available for the page cache". A witness pins that partition.
//
// THE HOST-RAM RUNG IS ELASTIC, NOT A RESERVATION (bold-wren-111, 2026-11-09): the page cache grows into
// whatever the cap leaves free and is reclaimed first under pressure, so what the budget reserves is its FLOOR —
// the working set a turn touches — and not the 13.2 GiB snapshot taken at load. It is the RAM analogue of the
// device rung (device_fixed_vram + device_min_elastic_vram), and the floor is the top of the 4-8 GiB range
// bold-wren set for it: reserving the top is the conservative direction, because a grant is a lower bound.
data srv4_routed_expert_artifact: ServingSharedArtifact = ServingSharedArtifact {
  name: "Qwen3.8-Flash-Next iq3_s routed-expert GGUF, mmap'd by the engine under its cgroup cap" as NonEmptyStr,
  bytes: gibibyte_to_byte_size(g: gibibyte(count: 46)),
  owner: "the engine's own mmap (--mmap-experts; the GGUF shards in place, no experts.bin), held as the engine cgroup's page cache under the cap srv4_serving_engine_memory.memory_cap reads -- that row is the cap's only home (review 92380)" as NonEmptyStr,
  device: Present { value: ServingArtifactRung {
    holds: ArtifactHeldPinned { mechanism: "Strata's on-card expert cache holds its resident experts on the card for the life of the engine; the per-card elastic bound strata_srv4_layer_split_profile.device_min_elastic_vram is what caps how much of the card it may take -- a device rung reserves host RAM for nothing, so it carries no host-RAM floor (review 92466)" as NonEmptyStr },
    bytes: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 23450)), provenance: "engine.log prefill plan '22.9 GiB in the GPU caches', 2026-11-09" as NonEmptyStr },
    realizes: "Strata's expert caches on both cards, filled by the routing-aware prefetcher ahead of the walk" as NonEmptyStr,
  } },
  host_ram: Present { value: ServingArtifactRung {
    holds: ArtifactHeldEvictable { bound_by: "the engine service's cgroup cap that srv4_serving_engine_memory.memory_cap reads (its MemoryHigh, from the drop-in 60-expert-l1-cap.conf raised 2026-11-09); MemoryMax is the hard edge above it, unread by this model and held on the host's unit file" as NonEmptyStr, floor: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 22)), provenance: "the per-request expert working set, ~22 GB, read from the engine's 'file tier I/O this request' lines at 500-token requests (2026-11-09 01:10Z): at a 40 GiB cap the cache held only ~19 GB and cold decode fell to 5.1 tok/s on 41.5 GB of drive reads, which is the failure this floor exists to prevent" as NonEmptyStr } },
    // What this rung HOLDS is the file tier's 24.0 GiB — everything not already on the cards, which is what the
    // page cache would keep if nothing bounded it (the plan read "35.2 GiB available for the page cache"). What it
    // must KEEP is the per-request expert working set (the floor above), now READ rather than guessed: ~22 GB,
    // from the engine's own "file tier I/O this request ... page cache held" lines at 500-token requests (2026-11-09
    // 01:10Z). An earlier reading of this rung — 13.2 GiB of file-backed VmRSS at load, under the 40 GiB cap — is
    // withdrawn along with that cap and named in srv4_grant, not deleted.
    bytes: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 24576)), provenance: "the 24.0 GiB of shards not resident on the cards — the same figure as the disk rung, because this rung is the page cache OF that tier (engine prefill plan, 2026-11-09)" as NonEmptyStr },
    realizes: "the page cache under the engine's cgroup cap: it grows into what the cap leaves free, and cold experts are evicted and re-read from the disk rung — 1.26 / 0.81 / 1.35 GB read per warm request at the 56 GiB cap" as NonEmptyStr,
  } },
  disk: Present { value: ServingArtifactRung {
    holds: ArtifactHeldPinned { mechanism: "the GGUF shards on srv4's NVMe, in place: the copy every rung above is a copy of" as NonEmptyStr },
    bytes: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 24576)), provenance: "engine.log prefill plan 'file tier 24.0 GiB', 2026-11-09 — the shard bytes not resident in the GPU caches (46.8 - 22.9)" as NonEmptyStr },
    realizes: "Strata's file tier with io prefetch (8 I/O threads) and routing-aware prefetch, on a drive measured at 2.50 GB/s; an expert miss is a re-read, never a loss" as NonEmptyStr,
  } },
}

// ONE GROUP OF TWO: the engine splits its layers across both GPUs (--layer-split 24: CUDA0 runs layers 0-23,
// CUDA1 24-47), so the two devices are one replica.
data srv4_layer_split_groups: List<ServingDeviceGroup> = [
  ServingDeviceGroup { name: "gunbc-srv4-daily-engine" as NonEmptyStr, devices: ["rtx2000ada-0000-01", "rtx2000ada-0004-01"] },
]

// STRATA RELEASE 406c9de18cef, Qwen3.8-Flash-Next IQ3_S, layer split across two RTX 2000 Ada GPUs (srv4,
// 2026-10-30). Fixed VRAM per device is the larger of the two devices' use beside their expert caches: CUDA1
// 15216 MiB less 10687 MiB of cache is 4529 MiB (CUDA0: 15548 less 12613 is 2935 MiB); the halves differ
// because they hold different layers. The base is the engine service's memory.current loaded and idle and
// includes the routed experts. This release PARKS across the split: its log reads "layer split across 2 GPUs"
// and "parked=8". The park headroom is the engine's own conversation_cache_min_free_mib.
data strata_srv4_layer_split_profile: ServingBackendProfile = ServingBackendProfile {
  backend: "strata 406c9de18cef qwen3.8-flash-next-iq3_s, layer split 24" as NonEmptyStr,
  device_fixed_vram: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 4529)), provenance: "srv4 nvidia-smi memory.used 15216 MiB on CUDA1 less its expert cache 10687 MiB (/metrics expert_cache_mib 23300 less expert_cache_primary_mib 12613), 2026-10-30" as NonEmptyStr },
  device_min_elastic_vram: ServingMemoryAssumed { bytes: gibibyte_to_byte_size(g: gibibyte(count: 2)), reason: "least expert cache srv4's engine is run with: a 2 GiB assumption until a run below it is read" as NonEmptyStr },
  // THE ENGINE'S OWN MEMORY, read from its row (one authority for a figure two consumers need): anon + shmem,
  // with the file-backed part of its RSS belonging to the expert artifact's host-RAM rung above, not here. The
  // pre-mmap reading of 52 GiB included the private expert arena; charging it here as well as in the artifact
  // would bill the same bytes twice.
  replica_base_ram: srv4_serving_engine_memory.base,
  // THE ONE BATCH INPUT. parallel/--batch is read live (engine.json parallel 1, 2026-11-09), and every figure
  // that follows — fixed RAM, retention, the router's admission through the anchor's grant — derives from this
  // number and nothing else. bold-wren-111's batch 1/2/4 run under the mmap expert cap will replace it; until
  // then it is what is running, not a target. A srv4 winner is a CANDIDATE reading, not a fleet recommendation:
  // srv4 runs with DIMM A1 degraded (UE 262,144), so its batch numbers are conditioned on that host health
  // (gentle-swift-129, 2026-11-09) — and batch above 1 is a capability TRADE, not a free knob: this release
  // answers a slot save/restore with 501 while parallel requests are on (/opt/gunbc-serving/srv4-daily/engine/
  // serve/server.py:4091), which is the checkpoint transfer consumer gunbc.serving.strata_checkpoint_transfer
  // depends on. The selector that weighs batch must see that trade; the layer split itself does not block save.
  active_slots: 1,
  active_slot_ram: ServingMemoryAssumed { bytes: mebibyte_to_byte_size(m: mebibyte(count: 512)), reason: "RAM a request needs above srv4's base, including snapshot capture and restore peaks: a 512 MiB assumption until memory.peak is read through real turns" as NonEmptyStr },
  retention: srv4_strata_snapshot_cost,
  park_free_floor: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 2560)), provenance: "srv4 Strata /metrics conversation_cache_min_free_mib 2560, 2026-10-30" as NonEmptyStr },
  max_devices_with_retention: 2,
  max_context: token_count(count: 229376),
}

data srv4_layout: ServingLayoutResult = serving_layout_with_qualification(
  result: serving_layout_derive(g: srv4_grant, groups: srv4_layer_split_groups, b: strata_srv4_layer_split_profile, r: serving_context_ceiling_requirement),
  q: ServingLiveUnqualified { obligation: "srv4 has been read at its cap only through 500-token test requests (24.5/25.1/29.1 tok/s warm, 1.26/0.81/1.35 GB of drive reads each, MemoryCurrent 46.5 GB); what is still unread is THIS configuration at the CEILING. bold-wren-111's batch 1/2/4 run at 100k+ context is the measurement that settles the batch input and this receipt, along with memory.peak with the experts mapped and the expert rung's resident low-water through real turns - read them at the ceiling and bind the receipt to this configuration's identity. Every figure here is a CANDIDATE, not a fleet recommendation: srv4's DIMM A1 is degraded (UE 262,144). And no speed ratio between the mmap realization and the private-arena one may be quoted: no same-prompt baseline under the arena exists." as NonEmptyStr },
)

// ---- srv3 AS GRANTED: THE SAME PAIR OF CARDS, THE SAME TOPOLOGY, ITS OWN READINGS
//
// srv3 ran with NO layout at all: its router row was typed by hand, capacity and all. It runs the same model on
// the same two RTX 2000 Ada cards in the same 24/24 layer split as srv4, so it is modelled the same way, from its
// OWN live profile (bold-wren-111's revised brief, 2026-11-09: "model what is live, do not invent the target
// batch"). What srv3 has not been read to is typed as an assumption with the reading that replaces it — never as
// srv4's figure wearing a provenance it was not given.

// srv3's cards are named for their CUDA ordinals, which is how the live read identifies them (the engine runs
// CUDA0 and CUDA1 as one layer-split replica); srv4's are named for their PCI buses because that is what was read
// there. nvidia-smi -L and memory.total on srv3 replace both names and the assumed VRAM, and change the
// configuration's identity when they do.
fn srv3_rtx_2000_ada_device(slot: String) -> ServingDevice {
  rtx_2000_ada_device(name: "rtx2000ada-" + slot, vram: ServingMemoryAssumed { bytes: mebibyte_to_byte_size(m: mebibyte(count: 16380)), reason: "the same RTX 2000 Ada board srv4 reads at 16380 MiB total (nvidia-smi memory.total, 2026-10-30); srv3's own memory.total replaces it" as NonEmptyStr })
}

// THE GRANT is the strata.slice the serving runs in, not the host: srv3's 502 GiB is shared with the CI runners,
// and the figure that binds serving is the limit the engine's OWN memory guard reports — "limit 110.0 GiB
// (source: cgroup)", read over ssh 2026-11-08 by bold-wren-111. Overhead is nothing inside that grant, because
// the grant is the engine's own cgroup: the pool's other processes, sshd and the CI runners live outside it.
// Nothing is shared on srv3 today: its experts are the engine's private anonymous arena (see the artifact).
data srv3_grant: ServingResourceGrant = ServingResourceGrant {
  host: operator_host_srv3,
  // THE CAP, READ FROM THE ROW THAT OWNS IT (review 38602): srv3_strata_engine_memory.memory_cap is the single literal
  // for the limit the engine guard reads, so the grant cannot drift from what the engine reports about itself.
  usable_ram: HostUsableRamConservativeLowerBound { bytes: serving_reading_bytes_or_zero(r: srv3_strata_engine_memory.memory_cap), basis: "the strata.slice cgroup limit srv3's engine memory guard reads from its own cgroup (strata-pool.service, read over ssh 2026-11-08); the host has far more but shares it with CI runners, so the slice limit is what serving may count on. gunbc.serving.serving_host_memory srv3_strata_engine_memory.memory_cap is that reading" as NonEmptyStr },
  overhead: HostFixedOverheadAllowance { bytes: byte_size(count: 0), reason: "the grant is the engine's own cgroup limit: the pool's other processes, sshd and the CI runners live outside it, so nothing else is reserved inside it" as NonEmptyStr },
  shared: [srv3_routed_expert_artifact],
  // The swap bound is the fleet's no-swap convention for serving slices, DECLARED for srv3 and labelled Assumed
  // (review 92384): srv3's own strata.slice MemorySwapMax has never been read, but srv4's identical serving slice
  // reads MemorySwapMax=0 and h11's engines are granted only 2 GiB, so 0 is the working figure pending a read --
  // an Assumption with its read obligation, not a measurement. The engine row's own swap_cap stays Unread: the
  // engine has not reported its slice's limit; only the layout's BUDGET assumes one. (review 38602/92384)
  swap_bound: ServingMemoryAssumed {
    bytes: byte_size(count: 0),
    reason: "the fleet's no-swap convention for serving slices: srv4's gunbc-srv4-daily.slice was read to MemorySwapMax=0 (2026-10-30) and h11's engines carry only 2 GiB, so srv3's strata.slice is budgeted at no swap. UNREAD on srv3 -- read obligation: systemctl show strata-pool.service -p MemorySwapMax; the figure is taken as 0 until that read lands." as NonEmptyStr,
  },
  charging: [
    "the routed experts are the engine's OWN private anonymous memory on srv3 (no --mmap-experts, no shared file): the arena is charged inside this grant and to nobody else, and nothing about it is reclaimable — which is why its rung is pinned and charged whole" as NonEmptyStr,
    "one copy per host, charged once: srv3 runs ONE engine across both cards, so the arena is that engine's own and there is no second copy to charge (bold-wren-111, 2026-11-09); its bytes live once, in the artifact's pinned rung" as NonEmptyStr,
    "base and expert tier are charged SEPARATELY and must stay that way: the base excludes the arena, because the arena is the artifact's pinned rung. Charging an UNSPLIT base (the engine's whole resident set, experts included) on top of the pinned rung would bill the same bytes twice; srv3_strata_engine_memory.base is the split figure, and its reason carries the arithmetic that produced it" as NonEmptyStr,
    "the slice's swap limit is budgeted under the fleet no-swap convention (Assumed 0, review 92384): srv4's identical slice reads MemorySwapMax=0 and h11 grants 2 GiB; srv3's own is UNREAD -- the figure is labelled an assumption, never a reading, and carries its read obligation (systemctl show strata-pool.service -p MemorySwapMax)" as NonEmptyStr,
  ] as List<NonEmptyStr>,
  devices: [srv3_rtx_2000_ada_device(slot: "cuda0"), srv3_rtx_2000_ada_device(slot: "cuda1")],
}

// THE ROUTED EXPERTS AS SRV3 ACTUALLY HOLDS THEM: private anonymous memory inside one engine process, not a
// mapped file. Same placement vocabulary as srv4 and h11, opposite mechanics: nothing maps it, so nothing can
// evict it, and the whole 46.84 GiB must be reserved. Moving srv3 onto --mmap-experts under a cap turns this
// artifact into srv4's shape (a device rung, an evictable host-RAM rung with a floor, a disk rung) — which is the
// realization the qualification's obligation names, deliberately not taken until srv4's decode reading under the
// cap says whether the miss path is affordable at all.
data srv3_routed_expert_artifact: ServingSharedArtifact = ServingSharedArtifact {
  name: "Qwen3.8-Flash-Next iq3_s routed experts, in the engine's private anonymous arena (not mapped, not shared)" as NonEmptyStr,
  bytes: mebibyte_to_byte_size(m: mebibyte(count: 47964)),
  owner: "the engine process itself (strata-pool.service, user ubuntu, /home/ubuntu/strata-test): the arena is private anonymous memory — there is no second process to share it with today, and no unit that could reclaim it" as NonEmptyStr,
  device: Present { value: ServingArtifactRung {
    holds: ArtifactHeldPinned { mechanism: "Strata's on-card expert cache holds its resident experts on the card for the life of the engine; the per-card elastic bound strata_srv3_layer_split_profile.device_min_elastic_vram is what caps how much of the card it may take -- a device rung reserves host RAM for nothing, so it carries no host-RAM floor (review 92466)" as NonEmptyStr },
    bytes: ServingMemoryUnread { reason: "srv3's per-card expert cache has not been read; its cache held ~7,822 experts against srv4's ~12,054 on 2026-11-08, so it is smaller than srv4's 22.9 GiB and by how much is unread" as NonEmptyStr },
    realizes: "Strata's expert caches on both cards; what they cannot hold is served from the arena below" as NonEmptyStr,
  } },
  host_ram: Present { value: ServingArtifactRung {
    holds: ArtifactHeldPinned { mechanism: "private anonymous memory allocated by the engine itself (no --mmap-experts, no experts.bin, no shared file): it is not a page cache, so the kernel cannot reclaim it" as NonEmptyStr },
    bytes: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 47964)), provenance: "the engine's expert arena, 46.84 GiB of private anon per engine, read over ssh 2026-11-08 by bold-wren-111 (NOT shared, NOT mapped)" as NonEmptyStr },
    realizes: "one private copy in the one engine the host runs; an expert miss is served from it and nothing can evict it -- holding the whole arena in the process is why srv3's base row is an engine-without-mmap figure while srv4's mapped engine charges only its anon and shmem" as NonEmptyStr,
  } },
  disk: Present { value: ServingArtifactRung {
    holds: ArtifactHeldPinned { mechanism: "the two GGUF shards under /home/ubuntu/strata-test, the copy the arena was filled from" as NonEmptyStr },
    bytes: ServingMemoryAssumed { bytes: gibibyte_to_byte_size(g: gibibyte(count: 46)), reason: "srv3's own shard sizes have not been read; 46 GiB is the same model's routed-expert file as srv4's engine plans against ('46.8 GiB experts', 2026-11-09). du on the shards replaces it" as NonEmptyStr },
    realizes: "the backing store: re-readable, so an expert miss is never a loss. srv3's drive has not been timed (srv4's reads 2.50 GB/s)" as NonEmptyStr,
  } },
}

// ONE GROUP OF TWO: the engine splits its layers across both cards (--layer-split 24: CUDA0 runs layers 0-23,
// CUDA1 24-47), so the two devices are ONE replica — srv4's topology, and the reason srv3 gets one router row and
// not two. The group is named for the unit that runs it (strata-pool.service today, hand-run from
// /home/ubuntu/strata-test); the realization step keeps the name and the unit.
data srv3_layer_split_groups: List<ServingDeviceGroup> = [
  ServingDeviceGroup { name: "strata-pool" as NonEmptyStr, devices: ["rtx2000ada-cuda0", "rtx2000ada-cuda1"] },
]

// SRV3'S PROFILE: the same engine family as srv4's, at what srv3 is READ to be running — --batch 8 (parallel 8),
// its conversation cache 64 GiB in 24 slots, nvidia-smi -pl 40 per card. Every figure srv3 has not been read to
// is an assumption naming the reading that replaces it, and none of them is srv4's figure without saying so.
//
// THE ARITHMETIC THAT CLOSES, and is the reason the base may be assumed at all: srv4's pre-mmap engine read
// 52 GiB of memory.current with the experts in its own anon (2026-10-30); srv3's engine today is that same shape
// with the same 46.84 GiB private arena. 52 GiB less the arena is 5284 MiB, which the same build's mmap'd
// VmRSS on srv4 corroborates at 6451 MiB of anon+shmem. Base and expert rung together must always re-sum to what
// memory.current reads on srv3; that sum is a witness.
data strata_srv3_layer_split_profile: ServingBackendProfile = ServingBackendProfile {
  backend: "strata qwen3.8-flash-next-iq3_s, layer split 24, --batch 8 on strata-pool.service (the binary's --version is unread; the fleet's srv3 image row records strata-main master@7045b8d0)" as NonEmptyStr,
  device_fixed_vram: ServingMemoryAssumed { bytes: mebibyte_to_byte_size(m: mebibyte(count: 4529)), reason: "srv3's per-card fixed VRAM is unread; 4529 MiB is the larger of srv4's two cards measured beside its expert caches (nvidia-smi 15216 MiB less 10687 MiB of cache, 2026-10-30) on the same board, model and 24/24 split. nvidia-smi and /metrics on srv3 replace it" as NonEmptyStr },
  device_min_elastic_vram: ServingMemoryAssumed { bytes: gibibyte_to_byte_size(g: gibibyte(count: 2)), reason: "srv3's least expert cache is unread; 2 GiB is what srv4's engine is run with, and srv3's own live read shows only ~0.4 GiB free on CUDA0 — the elastic cache is running near its floor, so a run below srv4's 2 GiB is expected. /metrics expert_cache_primary_mib on srv3 replaces it" as NonEmptyStr },
  replica_base_ram: srv3_strata_engine_memory.base,
  // THE ONE BATCH INPUT, and it is what is RUNNING (parallel 8 / --batch 8, read over ssh 2026-11-08), not a
  // target: fixed RAM, retention and the router's admission through the anchor's grant all follow from this
  // number alone. What the live batch is BUYING is in srv3's own engine log, and it is not throughput: one turn
  // at 100-125k decodes at ~30 tok/s while windows with two groups in flight run ~26 tok/s in AGGREGATE (the
  // medians behind srv3's anchor, 3,657 windows, 2026-11-08) — so the eight configured slots are paying RAM for
  // less work than one slot would, which is precisely the figure bold-wren-111's measurement is about to settle.
  // It carries a capability trade the selector must see, not a tuning knob: on this release line
  // batch above 1 answers a slot save/restore with 501 "slot save/restore is not available with parallel
  // requests" (read at /opt/gunbc-serving/srv4-daily/engine/serve/server.py:4091 on srv4's 406c9de18cef), and
  // slot save/restore is what gunbc.serving.strata_checkpoint_transfer consumes. srv3's own build's behaviour
  // under batch is an obligation on srv3_layout, and the layer split itself is not shown to block save.
  active_slots: 8,
  active_slot_ram: ServingMemoryAssumed { bytes: mebibyte_to_byte_size(m: mebibyte(count: 512)), reason: "RAM a request needs above srv3's base, including snapshot capture and restore peaks: 512 MiB is what srv4's profile assumes; srv3's memory.peak through real turns at the ceiling replaces it" as NonEmptyStr },
  retention: srv3_strata_snapshot_cost,
  // srv3's /metrics has never been read, so its conversation_cache_min_free_mib is unknown; 2560 MiB is srv4's
  // read floor on the same engine family (2026-10-30). The floor is not decoration: an engine skips parking below
  // its cache budget plus this figure, so a wrong one makes the retention budget unusable — /metrics on
  // strata-pool.service replaces it.
  park_free_floor: ServingMemoryAssumed { bytes: mebibyte_to_byte_size(m: mebibyte(count: 2560)), reason: "srv3's conversation_cache_min_free_mib is unread (its /metrics has never been read); 2560 MiB is srv4's read floor on the same engine family, same release line (2026-10-30)" as NonEmptyStr },
  max_devices_with_retention: 2,
  max_context: token_count(count: 229376),
}

data srv3_layout: ServingLayoutResult = serving_layout_with_qualification(
  result: serving_layout_derive(g: srv3_grant, groups: srv3_layer_split_groups, b: strata_srv3_layer_split_profile, r: serving_context_ceiling_requirement),
  q: ServingLiveUnqualified { obligation: "srv3 has never been laid out, so nothing in this configuration has been run through it: read memory.current and memory.peak on strata-pool.service through real turns at the ceiling (its base, its active-slot RAM and its per-card fixed VRAM are all assumptions now), read its binary's --version and its slice's MemorySwapMax, and read whether ITS build answers slot save/restore with 501 under --batch 8 the way srv4's does. The realization step is a separate change owned by bold-wren-111 — moving srv3 onto --mmap-experts under a capped cgroup, which turns this artifact into srv4's evictable shape — and it is held until srv4's decode reading under the cap its memory row reports says whether the miss path is affordable." as NonEmptyStr },
)

// CONSUMER, declared frontier (gunbc.design_argument::consumption): the h11 engine units' MemoryMax, MemorySwapMax,
// --conversation-cache-mib and --conversation-cache-slots, and the router's per-replica admission, read this
// configuration. Until a launch row renders them, the witnesses are the only readers and the values are
// applied by hand from the derivation's output.
data serving_admission_protocol_frontier: DissolutionCondition = unbound_dissolution(
  description: "Delete when the router's admission is one transaction per request: find or acquire the conversation's retention reservation (keyed by authenticated namespace and explicit conversation identity, never a content hash), then its active-turn grant through gunbc.serving.turn_admission, so that retries, concurrency, storage pressure and client disconnects can neither mint capacity nor erase a reservation; and serving_replica_admit's count is read from those reservations." as NonEmptyStr
)

// A DERIVED LAYOUT IS A TARGET FOR AN EMPTY DEPLOYMENT. serving_allocate deals the extra conversations in group
// order and has no input describing current reservations, so applying it to an occupied fleet can shrink a
// replica beneath conversations it already holds (the 2026-10-30 h11 case: the target gave 85 the second
// conversation while 87 held two warm ones, and the operator chose 87 by hand).
data serving_layout_transition_frontier: DissolutionCondition = unbound_dissolution(
  description: "Delete when a transition plan derives from the applied configuration, the current reservations and their retained-state locations, and the target layout: it keeps valid placements, never shrinks a replica beneath its outstanding reservations before they are discharged, never advertises capacity before its configuration is applied and read back, names every conversation that needs drain or explicit reconstruction, and refuses when no transition fits the grant." as NonEmptyStr
)

data serving_layout_consumer_frontier: DissolutionCondition = unbound_dissolution(
  description: "Delete when the h11 Strata launch row renders each engine's MemoryMax, MemorySwapMax and conversation-cache flags from host_6ce85c_layout, and router placement admits through serving_replica_admit." as NonEmptyStr
)
