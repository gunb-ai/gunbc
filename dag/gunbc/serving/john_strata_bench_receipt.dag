// ── READERS ──────────────────────────────────────────────────────────────────────────────────────────

fn same_reason(a: NvmlClocksEventReason, b: NvmlClocksEventReason) -> Bool {
  nvml_clocks_event_reason_bit(r: a) == nvml_clocks_event_reason_bit(r: b)
}

fn card_event_samples(t: CardTelemetry, r: NvmlClocksEventReason) -> Nat {
  fold(t.events.filter(e => same_reason(a: e.reason, b: r)), init: 0, f: (acc, e) => acc + e.samples)
}

// Software and hardware thermal slowdown together: a claim that a card did not thermally throttle asks both.
fn card_thermal_slowdown_samples(t: CardTelemetry) -> Nat {
  card_event_samples(t: t, r: NvmlClocksEventSwThermalSlowdown) + card_event_samples(t: t, r: NvmlClocksEventHwThermalSlowdown)
}

fn telemetry_thermally_clean(ts: List<CardTelemetry>) -> Bool {
  ts.length() > 0 && ts.all(t => card_thermal_slowdown_samples(t: t) == 0)
}

fn telemetry_of(ts: List<CardTelemetry>, name: String) -> CardTelemetry? {
  ts.filter(t => (t.name as String) == name).first()
}

// A zone duty byte as the BMC poll printed it, read through the Supermicro OEM reply parser.
fn zone_one_duty(byte: NonEmptyStr) -> Percent? {
  supermicro_zone_duty_answer(stdout: " " + (byte as String))
}

fn duty_is_full(byte: NonEmptyStr) -> Bool {
  match zone_one_duty(byte: byte) { Present { value: p } => percent_count(p) == 100  Absent => false }
}

// THE ZONE WAS HELD AT 100% OVER THE WINDOW: logged, and the lowest byte the poll printed parses to 100. An
// unlogged window is never held, whatever was probable.
fn zone_one_held_full(z: ZoneOneReading) -> Bool {
  match z {
    ZoneOneLogged { samples: n, duty_low_byte: lo, duty_high_byte: hi, guard_running: _ } => n > 0 && duty_is_full(byte: lo) && duty_is_full(byte: hi)
    ZoneOneUnlogged { account: _ } => false
  }
}

// THE BMC REWROTE A HAND-SET 100% DUTY BELOW IT inside a logged window: the high byte is 100 and the low byte
// parses below it. This is the class's discriminating reading.
fn zone_one_rewritten_below_full(z: ZoneOneReading) -> Bool {
  match z {
    ZoneOneLogged { samples: _, duty_low_byte: lo, duty_high_byte: hi, guard_running: _ } =>
      duty_is_full(byte: hi) && match zone_one_duty(byte: lo) { Present { value: p } => percent_count(p) < 100  Absent => false }
    ZoneOneUnlogged { account: _ } => false
  }
}

// The only reason a mask names is the software power cap, and no bit is outside NVML's vocabulary.
fn mask_names_only_power_cap(mask: Nat) -> Bool {
  let m = nvml_clocks_event_mask(mask: mask)
  m.unmodeled_bits == 0 && m.reasons.length() == 1 && m.reasons.all(r => same_reason(a: r, b: NvmlClocksEventSwPowerCap))
}

fn run_named(name: String) -> LongContextRun? {
  john_long_context_runs.filter(r => (r.run as String) == name).first()
}

fn sweep_with_slots(slots: Nat) -> ConcurrencySweep? {
  john_concurrency_sweeps.filter(s => s.engine_slots == slots).first()
}

fn best_aggregate(s: ConcurrencySweep) -> Nat {
  fold(s.points, init: 0, f: (acc, p) => nat_max(a: acc, b: milli_tokens_per_second_count(r: p.aggregate)))
}

fn point_at(s: ConcurrencySweep, c: Nat) -> ConcurrencyPoint? {
  s.points.filter(p => p.concurrency == c).first()
}

fn cards_agree(a: List<JohnCard>, b: List<JohnCard>) -> Bool {
  a.length() == b.length()
    && a.all(x => b.any(y => (x.name as String) == (y.name as String) && match x.pci_bus {
      Present { value: xb } => match y.pci_bus { Present { value: yb } => (xb as String) == (yb as String)  Absent => false }
      Absent => false
    }))
}

// THE SETUP IS THE MEASURED ONE: its cards are the de facto run's cards (by name and bus), the run it names is the
// de facto layout's warm run, the zone was held at 100% over that run, no card thermally slowed, and the
// concurrency sweep it names reserved the setup's slots.
fn setup_rests_on_its_runs(s: JohnServingSetup) -> Bool {
  match run_named(name: s.warm_evidence as String) {
    Absent => false
    Present { value: r } =>
      cards_agree(a: s.cards, b: r.serving)
        && match r.standing { DeFactoLayout => true  SupersededLayout { why: _ } => false }
        && zone_one_held_full(z: r.zone_one)
        && telemetry_thermally_clean(ts: r.telemetry)
        && match john_concurrency_sweeps.filter(c => (c.run as String) == (s.concurrency_evidence as String)).first() {
          Absent => false
          Present { value: c } => c.engine_slots == s.engine_slots && zone_one_held_full(z: c.zone_one) && telemetry_thermally_clean(ts: c.telemetry)
        }
        && duty_is_full(byte: s.zone_one_duty_byte)
  }
}

data john_strata_bench_receipt_frontier: DissolutionCondition = unbound_dissolution(
  description: "gunbc.design_argument::consumption: read today by test.claim.serving.john_strata_bench_receipt_witness (the setup rests on its runs; the de facto runs are thermally clean with the zone held; the 81:00 throttle is kept with its unlogged fan standing; the 4-slot choice is the operator's, not the sweep's maximum; the BMC's rewrite of the hand-set zone is read through the OEM parser) and by gunbc.design_ruling::john_de_facto_serving_setup_2026_11_27, which governs john_de_facto_serving_setup. TRIGGERS, each its own: (1) an nvidia-smi --query-gpu=pci.bus_id,uuid,serial read on john committed like artifacts/host-observations/ken-gpu-read-2026-11-18/, plus an extdeps.gpu board catalog row for 10de:1df0 grounded in an NVIDIA document, moves the three cards into gunbc.fleet.gpu_device_observation and gunbc.fleet.fleet_physical_inventory, and JohnCard keeps only the run's conditions; (2) gunbc.fleet.gpu_power_cap_boot_state HandAppliedCapMechanism gains a per-card target (john caps each card at its OWN minimum: 150, 125 and 100 W, which one target_watts cannot carry) and gpu-power-cap.service enters hand_applied_cap_mechanisms; (3) john's Strata engine gets a gunbc.serving.serving_replica_profile row (and a serving_host_memory engine row for its MemoryMax 100G) when it is admitted to the router -- until then john_de_facto_serving_setup is the only record of its slots, and gunbc.recurring_failure_mode::engine_slots_written_beside_the_admission_that_bounds_them names what goes wrong if a router cap is later written beside it." as NonEmptyStr
)
