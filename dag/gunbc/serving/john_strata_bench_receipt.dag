module gunbc.serving.john_strata_bench_receipt

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat, nat_max }
import std.optional { Present, Absent }
import std.measure {
  Watt, watt, Celsius, celsius, celsius_count, Millisecond, millisecond, millisecond_count, Second, second,
  MilliTokensPerSecond, milli_tokens_per_second, milli_tokens_per_second_count, TokenCount, token_count,
  Percent, percent_count,
}
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.nvidia.management_library {
  NvmlClocksEventReason, NvmlClocksEventSwPowerCap, NvmlClocksEventSwThermalSlowdown,
  NvmlClocksEventHwThermalSlowdown, NvmlClocksEventHwSlowdown, nvml_clocks_event_mask, nvml_clocks_event_reason_bit,
}
import extdeps.bmc.supermicro_oem_fan { SupermicroFanMode, supermicro_zone_duty_answer }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_ba61f9 }

// JOHN'S STRATA SERVING SETUP AND THE RUNS IT RESTS ON, 2026-11-26/27: what the committed files say, typed.
//
// THE FILES ARE THE AUTHORITY, this module transcribes them: artifacts/host-observations/john-serving-2026-11-27/,
// every file pinned in its SHA256SUMS, each run's rows and telemetry by the digests carried on its row below. The
// directory's 00_README.txt names every producer (strata_bench.py and warm150k_john.py by digest, because the
// repository's .gitignore excludes *.py; the shell drivers under producers/), the awk that re-derives every
// per-card count and fan count below from the committed files, and every caveat. The precedents are
// gunbc.serving.h11_r9700_strata_bench_receipt (pinned files, transcribed) and
// gunbc.serving.t10_pair_strata_bench_receipt (relayed, TranscribedUncited); this one is the first kind.
//
// WHY NOT gunbc.serving.serving_benchmark_run_receipt. Same reason as the R9700 receipt: these are
// strata_bench.py and warm150k_john.py summary rows, not gpu-bench request/v4 rows, so they cannot inhabit
// serving-benchmark/1 (stated divergence, gunbc.design_argument::conformance).
//
// WHY THE CARDS ARE SPELLED HERE AND NOT IN gunbc.fleet.gpu_device_observation. That module is the home of a
// card's identity and limit range, and it keys a device by board asset. No GPU UUID or board serial was read on
// john, and 10de:1df0 (nvidia-smi "Tesla PG500-216", the operator's V100 32 GB) has no extdeps.gpu board catalog
// row, so no asset row can be grounded yet. What a run row carries is what THAT RUN's files print -- name, bus,
// the power.limit on every sample -- as the run's conditions, the way the R9700 receipt carries the cap in force.
// The frontier below names the read that moves the cards to their home.
//
// FAN STANDING IS PART OF EVERY THERMAL ROW. john's BMC rewrites a hand-set chassis zone duty with its own
// temperature-following curve (gunbc.recurring_failure_mode::bmc_fan_posture_judged_from_a_hand_read_outside_the_observation_joins),
// so a run's thermal reading means nothing without the zone-1 duty over its measured window, and four rows have
// no fan log at all. The zone reading is carried as the duty bytes the BMC poll printed, read through
// extdeps.bmc.supermicro_oem_fan, never as a percent typed by hand.

// The cooler a card carries, as the operator reports it. No read of a heatsink exists; the two passive cards are
// the ones whose temperature follows the chassis zone.
type JohnCardCooling = BlowerCooler | PassiveHeatsink

type JohnCard {
  // nvidia-smi's name, as the run's gpu.csv prints it.
  name: NonEmptyStr
  // The PCI function, where a committed read pairs it with the name (each run row's layout_read says which).
  pci_bus: NonEmptyStr?
  cooling: JohnCardCooling
  // The power.limit every sample of the run's gpu.csv printed for this card. Absent where the limit changed
  // during the run or no telemetry is committed.
  power_limit: Watt?
}

// How many 1 s samples of a card read one clocks_event_reasons column Active. The reason is extdeps' NVML
// vocabulary, so a count cannot name a reason NVML does not have.
type ReasonSamples {
  reason: NvmlClocksEventReason
  samples: Nat
}

// One card's 1 s nvidia-smi telemetry over a run's whole gpu.csv (idle samples included), reduced by the awk in
// 00_README.txt.
type CardTelemetry {
  name: NonEmptyStr
  samples: Nat
  temperature_max: Celsius
  events: List<ReasonSamples>
}

// Chassis zone 1 (FANA/FANB) over a run's measured window. Logged: srv2's BMC poll read the zone every ~10 s and
// the lowest and highest duty bytes it printed are carried as printed. Unlogged: no fan log covers the window, and
// the account says what is probable and why it is not proven.
type ZoneOneReading
  = ZoneOneLogged { samples: Nat, duty_low_byte: NonEmptyStr, duty_high_byte: NonEmptyStr, guard_running: Bool }
  | ZoneOneUnlogged { account: NonEmptyStr }

type WarmTurn {
  // 2 is the srv1 lil measured warm turn; 3-6 each add a 2000-token tool delta.
  turn: Nat
  prompt_tokens: TokenCount
  time_to_first_token: Millisecond
  decode: MilliTokensPerSecond
  completion_tokens: TokenCount
  // The bench's cache_hit_pct_p50 in tenths of a percent (99.9 is 999).
  cache_hit_permille: Nat
}

type ColdTurn
  = ColdTurnAnswered { prompt_tokens: TokenCount, time_to_first_token: Millisecond }
  | ColdTurnAbandoned { tokens_processed: TokenCount, after: Second, verdict: NonEmptyStr }

type BenchEngine
  = StrataSm60Build { commit: NonEmptyStr }
  | LlamaCppBuild { commit: NonEmptyStr }

type LayerSplit
  = SplitAuto { chosen: NonEmptyStr? }
  | SplitForced { boundaries: NonEmptyStr }
  | SplitByHand { placement: NonEmptyStr }

type LayoutStanding
  = DeFactoLayout
  | SupersededLayout { why: NonEmptyStr }

type LongContextRun {
  run: NonEmptyStr
  rows_sha256: NonEmptyStr?
  telemetry_sha256: NonEmptyStr?
  engine: BenchEngine
  // The cards the engine was given, in nvidia-smi PCI order.
  serving: List<JohnCard>
  // Where the run's name-to-bus pairing was read.
  layout_read: NonEmptyStr
  split: LayerSplit
  standing: LayoutStanding
  zone_one: ZoneOneReading
  cold: ColdTurn
  turns: List<WarmTurn>
  telemetry: List<CardTelemetry>
}

type ConcurrencyPoint {
  concurrency: Nat
  aggregate: MilliTokensPerSecond
  time_to_first_token_median: Millisecond
  decode_median: MilliTokensPerSecond
  gpu_temperature_max: Celsius
  // The bench's gpu_throttle_reasons_seen: the OR of clocks_event_reasons.active over the point.
  clocks_event_mask_seen: Nat
  // The bench's own gpu_avg_w, truncated to a whole watt.
  bench_gpu_power_mean: Watt
}

type ConcurrencySweep {
  run: NonEmptyStr
  rows_sha256: NonEmptyStr
  telemetry_sha256: NonEmptyStr
  // The engine config's parallel: the batch slots Strata reserves.
  engine_slots: Nat
  output_tokens_per_request: TokenCount
  zone_one: ZoneOneReading
  points: List<ConcurrencyPoint>
  telemetry: List<CardTelemetry>
}

type PinnedFile {
  path: NonEmptyStr
  sha256: NonEmptyStr
}

// THE DE FACTO SETUP (operator, 2026-11-27, gunbc.design_ruling::john_de_facto_serving_setup_2026_11_27). The
// cards and their limits, the engine slots, the fan posture and the files that hold it on the host.
type JohnServingSetup {
  host: HostIdentity
  cards: List<JohnCard>
  engine: BenchEngine
  engine_slots: Nat
  port: Nat
  fan_mode: SupermicroFanMode
  zone_one_duty_byte: NonEmptyStr
  fan_guard_period: Second
  files: List<PinnedFile>
  // The runs that measured THIS setup.
  warm_evidence: NonEmptyStr
  concurrency_evidence: NonEmptyStr
}

fn reasons(power_cap: Nat, sw_thermal: Nat, hw_slowdown: Nat, hw_thermal: Nat) -> List<ReasonSamples> {
  [
    ReasonSamples { reason: NvmlClocksEventSwPowerCap, samples: power_cap },
    ReasonSamples { reason: NvmlClocksEventSwThermalSlowdown, samples: sw_thermal },
    ReasonSamples { reason: NvmlClocksEventHwSlowdown, samples: hw_slowdown },
    ReasonSamples { reason: NvmlClocksEventHwThermalSlowdown, samples: hw_thermal },
  ]
}

fn telemetry(name: String, samples: Nat, temp_max: Int, power_cap: Nat, sw_thermal: Nat) -> CardTelemetry {
  // hw_slowdown and hw_thermal_slowdown read Active on no sample of any committed run; they are carried as the
  // zero they read, not dropped, so a claim about thermal slowdown asks both columns.
  CardTelemetry { name: name as NonEmptyStr, samples: samples, temperature_max: celsius(count: temp_max), events: reasons(power_cap: power_cap, sw_thermal: sw_thermal, hw_slowdown: 0, hw_thermal: 0) }
}

fn turn(n: Nat, prompt: Nat, ttft_ms: Nat, decode_milli: Nat, out: Nat, hit: Nat) -> WarmTurn {
  WarmTurn {
    turn: n,
    prompt_tokens: token_count(count: prompt),
    time_to_first_token: millisecond(count: ttft_ms),
    decode: milli_tokens_per_second(count: decode_milli),
    completion_tokens: token_count(count: out),
    cache_hit_permille: hit,
  }
}

fn point(c: Nat, agg_milli: Nat, ttft_ms: Nat, decode_milli: Nat, temp_max: Int, mask: Nat, power_w: Nat) -> ConcurrencyPoint {
  ConcurrencyPoint {
    concurrency: c,
    aggregate: milli_tokens_per_second(count: agg_milli),
    time_to_first_token_median: millisecond(count: ttft_ms),
    decode_median: milli_tokens_per_second(count: decode_milli),
    gpu_temperature_max: celsius(count: temp_max),
    clocks_event_mask_seen: mask,
    bench_gpu_power_mean: watt(count: power_w),
  }
}

fn card(name: String, bus: String, cooling: JohnCardCooling, limit_w: Nat) -> JohnCard {
  JohnCard { name: name as NonEmptyStr, pci_bus: Present { value: bus as NonEmptyStr }, cooling: cooling, power_limit: Present { value: watt(count: limit_w) } }
}

data john_strata_engine: BenchEngine = StrataSm60Build { commit: "8c5fafc1" as NonEmptyStr }

// The de facto layout: passive / blower (middle slot) / passive. Bus pairing read by
// thermal/ab-20261127T034432Z/run.log; no power-off between that read and 05:31Z (fans-ab-*.csv is continuous).
data john_v100_16_blower_at_01: JohnCard = card(name: "Tesla V100-SXM2-16GB", bus: "00000000:01:00.0", cooling: BlowerCooler, limit_w: 150)
data john_p100_passive_at_81: JohnCard = card(name: "Tesla P100-PCIE-16GB", bus: "00000000:81:00.0", cooling: PassiveHeatsink, limit_w: 125)
data john_v100_32_passive_at_c1: JohnCard = card(name: "Tesla PG500-216", bus: "00000000:C1:00.0", cooling: PassiveHeatsink, limit_w: 100)

data john_de_facto_cards: List<JohnCard> = [john_v100_16_blower_at_01, john_p100_passive_at_81, john_v100_32_passive_at_c1]

data john_de_facto_layout_read: NonEmptyStr = "thermal/ab-20261127T034432Z/run.log layout line (index, pci.bus_id, name, power.limit), boot 03:42:51Z; the same names and limits print on every sample of the run's gpu.csv" as NonEmptyStr

data john_layout_with_v100_32_at_81_read: NonEmptyStr = "thermal/run-20261127T015819Z/limits.txt (01:00 150 W, 81:00 100 W, C1:00 125 W) with that run's run.log card list (0 V100-SXM2-16GB, 1 PG500-216, 2 P100); the swap at ~03:05Z moved the cards" as NonEmptyStr

data john_unlogged_fan_account: NonEmptyStr = "No fan log covers this run. Zone 1 was set 0x64 by hand at 01:52:36Z after the card-swap power cycle; the host then ran until the ~03:05Z power-off with nothing reading the zone. The BMC curve raises zone 1 toward 0x64 under load (fans-ab-*.csv), so 100% under load is PROBABLE and not proven (THERMAL-NOTES.txt, the 03:23:09Z correction)." as NonEmptyStr

