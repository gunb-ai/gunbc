module gunbc.serving.router_proxy_config

import std.types { String, Int, Bool, List, NonEmptyStr }
import extdeps.proxy.openresty {
  OpenRestyVersion, openresty_1_27_1_1, NginxDirective, NginxToken, NginxVariable, WorkerProcesses, EventsBlock, HttpBlock, AccessLogOff,
  ServerBlock, ListenLoopback, LocationBlock, PrefixMatch, ExactMatch, SetEmptyVariable, ProxyHttpVersion11, ProxyBufferingDirective,
  ProxyRequestBufferingDirective, ProxyNextUpstreamDirective, ProxySetHeader, HeaderFromVariable, HeaderLiteral, ProxyPassDirective,
  ProxyTargetFromUpstreamVariable, ProxyPassLoopback, InternalLocationOnly, ProxyMethodPost, ProxyPassRequestBodyOff,
  LuaPhaseHook, AccessPhase, LogPhase, CaptureSubrequest, LogPostToLoopback, HeaderCopy,
  ProxyBufferingOff, ProxyRequestBufferingOff, ProxyNextUpstreamOff, NginxRender, render_nginx_directives,
}

// Serving-router policy over the OpenResty model: the header carrying the seat permit, the header the authz
// answer names the upstream in, and the authz and stream-end routes are gunbc facts, not OpenResty's.
data seat_permit_header: NginxToken = "x-seat-permit" as NginxToken
data upstream_answer_header: NginxToken = "x-upstream" as NginxToken
data authz_internal_path: NginxToken = "/_authz" as NginxToken
data authz_upstream_path: NginxToken = "/authz" as NginxToken
data stream_end_path: NginxToken = "/stream-end" as NginxToken
data upstream_variable: NginxVariable = "up" as NginxVariable
data permit_variable: NginxVariable = "permit" as NginxVariable

// The router's byte-carrying proxy configuration (plan gunbc.plans.fabric_serving_router, S1), as
// typed directive rows over extdeps.proxy.openresty; the text is the rendering of those rows.
// The proxy takes its upstream only from the authz callout's answer header and holds no placement
// policy: proxy_pass has a variable target (no upstream block, hence no balancing or health state),
// proxy_next_upstream is off, and a non-200 authz answer refuses before any forwarding. The stream-end
// callout fires from the log phase on every end of a request and only when a permit was issued; its
// outcome label is not used for release because the log-phase variables were unreliable on client abort.
//
// DISSOLUTION CONDITION. This module dissolves with the proxy, when a v2-native streaming door
// carries the bytes itself (plan section 3, named later realization).

fn router_proxy_pinned_version() -> OpenRestyVersion { openresty_1_27_1_1 }

fn router_proxy_directives(listen_port: Int, authz_port: Int, stream_end_port: Int) -> List<NginxDirective> {
  [
    WorkerProcesses { count: 1 },
    EventsBlock,
    HttpBlock { body: [
      AccessLogOff,
      ServerBlock { body: [
        ListenLoopback { port: listen_port },
        LocationBlock { matching: PrefixMatch { path: "/v1/" as NginxToken }, body: [
          SetEmptyVariable { variable: upstream_variable },
          SetEmptyVariable { variable: permit_variable },
          LuaPhaseHook { phase: AccessPhase, hook: CaptureSubrequest {
            location: authz_internal_path,
            failure_status: 503,
            copies: [
              HeaderCopy { header: upstream_answer_header, variable: upstream_variable },
              HeaderCopy { header: seat_permit_header, variable: permit_variable },
            ],
          } },
          ProxyHttpVersion11,
          ProxyBufferingDirective { value: ProxyBufferingOff },
          ProxyRequestBufferingDirective { value: ProxyRequestBufferingOff },
          ProxyNextUpstreamDirective { value: ProxyNextUpstreamOff },
          ProxySetHeader { header: seat_permit_header, source: HeaderFromVariable { variable: permit_variable } },
          ProxyPassDirective { target: ProxyTargetFromUpstreamVariable, variable: upstream_variable },
          LuaPhaseHook { phase: LogPhase, hook: LogPostToLoopback {
            port: stream_end_port, path: stream_end_path, timeout_ms: 2000,
            only_when_set: permit_variable, header: seat_permit_header, header_value: permit_variable,
          } },
        ] },
        LocationBlock { matching: ExactMatch { path: authz_internal_path }, body: [
          InternalLocationOnly,
          ProxyPassLoopback { port: authz_port, path: authz_upstream_path },
          ProxyMethodPost,
          ProxyPassRequestBodyOff,
          ProxySetHeader { header: "Content-Length" as NginxToken, source: HeaderLiteral { text: "0" as NginxToken } },
        ] },
      ] },
    ] },
  ]
}

fn router_proxy_config(listen_port: Int, authz_port: Int, stream_end_port: Int) -> NginxRender {
  render_nginx_directives(rows: router_proxy_directives(listen_port: listen_port, authz_port: authz_port, stream_end_port: stream_end_port))
}
