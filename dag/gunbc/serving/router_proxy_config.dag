module gunbc.serving.router_proxy_config

import std.types { String, Int, Bool, List }
import extdeps.proxy.openresty {
  OpenRestyVersion, openresty_1_27_1_1, NginxDirective, Simple, Block, LuaPhaseHook, AccessPhase, LogPhase,
  AuthzCapture, StreamEndCallout, ProxyNextUpstreamOff, ProxyBufferingOff, ProxyRequestBufferingOff,
  proxy_next_upstream_directive, proxy_buffering_directive, proxy_request_buffering_directive,
  render_nginx_directives,
}

// The router's byte-carrying proxy configuration (plan gunbc.plans.fabric_serving_router, S1), as
// typed directive rows over extdeps.proxy.openresty; the text is the rendering of those rows.
// The proxy takes its upstream only from the authz callout's answer header and holds no placement
// policy: proxy_pass has a variable target (no upstream block, hence no balancing or health state),
// proxy_next_upstream is off, and a non-200 authz answer refuses before any forwarding. The stream-end
// callout fires from the log phase on every end of a request and only when a permit was issued; its
// outcome label is not used for release because the log-phase variables were unreliable on client abort.
//
// DISSOLUTION CONDITION. This module dissolves with the proxy, when a v2-native streaming door
// carries the bytes itself (plan section 3, named later realization).

fn router_proxy_pinned_version() -> OpenRestyVersion { openresty_1_27_1_1 }

fn router_proxy_directives(listen_port: Int, authz_port: Int, stream_end_port: Int) -> List<NginxDirective> {
  [
    Simple { name: "worker_processes", args: ["1"] },
    Block { name: "events", args: [], body: [] },
    Block { name: "http", args: [], body: [
      Simple { name: "access_log", args: ["off"] },
      Block { name: "server", args: [], body: [
        Simple { name: "listen", args: ["127.0.0.1:" + (listen_port as String)] },
        Block { name: "location", args: ["/v1/"], body: [
          Simple { name: "set", args: ["$up", "''"] },
          Simple { name: "set", args: ["$permit", "''"] },
          LuaPhaseHook { phase: AccessPhase, hook: AuthzCapture { location: "/_authz", upstream_header: "x-upstream", permit_header: "x-seat-permit", refuse_status: 503 } },
          Simple { name: "proxy_http_version", args: ["1.1"] },
          proxy_buffering_directive(v: ProxyBufferingOff),
          proxy_request_buffering_directive(v: ProxyRequestBufferingOff),
          proxy_next_upstream_directive(v: ProxyNextUpstreamOff),
          Simple { name: "proxy_set_header", args: ["x-seat-permit", "$permit"] },
          Simple { name: "proxy_pass", args: ["http://$up"] },
          LuaPhaseHook { phase: LogPhase, hook: StreamEndCallout { host: "127.0.0.1", port: stream_end_port, path: "/stream-end", permit_variable: "permit" } },
        ] },
        Block { name: "location", args: ["=", "/_authz"], body: [
          Simple { name: "internal", args: [] },
          Simple { name: "proxy_pass", args: ["http://127.0.0.1:" + (authz_port as String) + "/authz"] },
          Simple { name: "proxy_method", args: ["POST"] },
          Simple { name: "proxy_pass_request_body", args: ["off"] },
          Simple { name: "proxy_set_header", args: ["Content-Length", "0"] },
        ] },
      ] },
    ] },
  ]
}

fn router_proxy_config(listen_port: Int, authz_port: Int, stream_end_port: Int) -> String {
  render_nginx_directives(rows: router_proxy_directives(listen_port: listen_port, authz_port: authz_port, stream_end_port: stream_end_port))
}
