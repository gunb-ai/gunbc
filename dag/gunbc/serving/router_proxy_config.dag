module gunbc.serving.router_proxy_config

import std.types { String, Int, NonEmptyStr }
import extdeps.proxy.openresty { OpenRestyVersion, openresty_1_27_1_1, ProxyNextUpstreamOff, ProxyBufferingOff, ProxyRequestBufferingOff, NoUpstreamBlock }

// The router's byte-carrying proxy configuration (plan gunbc.plans.fabric_serving_router, S1).
// The proxy takes its upstream only from the authz callout's answer header and holds no placement
// policy: proxy_pass has a variable target (there is no upstream block, hence no balancing or health
// state), proxy_next_upstream is off, and an unreachable or non-200 authz answer refuses before any
// forwarding. The stream-end callout fires from the log phase on every end of a request; its outcome
// label is not used for release because the log-phase variables were unreliable on client abort.
//
// DISSOLUTION CONDITION. This emitter dissolves with the proxy, when a v2-native streaming door
// carries the bytes itself (plan section 3, named later realization).

fn router_proxy_pinned_version() -> OpenRestyVersion { openresty_1_27_1_1 }

fn router_proxy_config(listen_port: Int, authz_port: Int, stream_end_port: Int) -> String {
  "worker_processes 1;\nevents {}\nhttp {\n  access_log off;\n  server {\n    listen 127.0.0.1:" + (listen_port as String) + ";\n    location /v1/ {\n      set $up '';\n      set $permit '';\n      access_by_lua_block {\n        local res = ngx.location.capture('/_authz', \{method = ngx.HTTP_POST\})\n        if res.status ~= 200 then return ngx.exit(503) end\n        ngx.var.up = res.header['x-upstream']\n        ngx.var.permit = res.header['x-seat-permit']\n      }\n      proxy_http_version 1.1;\n      proxy_buffering off;\n      proxy_request_buffering off;\n      proxy_next_upstream off;\n      proxy_set_header x-seat-permit $permit;\n      proxy_pass http://$up;\n      log_by_lua_block {\n        if ngx.var.permit == '' then return end\n        ngx.timer.at(0, function(p)\n          local s = ngx.socket.tcp()\n          s:settimeout(2000)\n          if not s:connect('127.0.0.1', " + (stream_end_port as String) + ") then return end\n          s:send('POST /stream-end HTTP/1.1\\r\\nHost: x\\r\\nx-seat-permit: ' .. ngx.var.permit .. '\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n')\n          s:receive('*a')\n          s:close()\n        end)\n      }\n    }\n    location = /_authz {\n      internal;\n      proxy_pass http://127.0.0.1:" + (authz_port as String) + "/authz;\n      proxy_method POST;\n      proxy_pass_request_body off;\n      proxy_set_header Content-Length 0;\n    }\n  }\n}\n"
}
