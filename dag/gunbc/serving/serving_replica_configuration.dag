// THE WAYS A HOST COULD RUN, not the way it runs today.
//
// WHY THIS MODULE EXISTS, in its own words: three questions get asked about the fleet and they need different
// answers. "What replica runs where" is the roster's (gunbc.serving.serving_replica_profile). "What should this
// host run" is the selector's (gunbc.serving.serving_replica_choice). And the question in between -- "what
// COULD this host run, as alternatives it might switch to" -- belongs here, because a candidate configuration
// is neither a deployed replica nor a decision: srv1 could run its model as two single-card replicas or as one
// replica across both cards; srv3 could keep its conversations in RAM only or take the slot-file disk rung at
// batch 1; h11 could serve on four A16s or on two. Each is a real option with its own ladder, its own expert
// placement and its own charges, and the roster cannot carry them without pretending the fleet runs things it
// does not.
//
// A configuration is therefore: a HOST, the roster rows it runs (EMPTY when the fleet has never run it -- which
// is honest, not missing), the warm ladder it keeps, where its weights and experts sit, the figures it
// would be quoted on, and the CONCURRENT-AGENT POPULATION it serves against the cache that serves it. Charges
// come from gunbc.serving.serving_replica_profile's own rules (one authority for what a rung and an expert
// hold cost), figures resolve through its run-identity keying (one authority for what a reading may price),
// and the cache capacity in agents comes from serving_host_memory's own fold of cache bytes against slots
// (one authority for what a warm store holds). Nothing here restates a byte, a millisecond or a token rate.
module gunbc.serving.serving_replica_configuration

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.optional { Optional, Present, Absent }
import std.algebra { take_prefix }
import std.measure { Permille, TokenCount, permille }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }
import product.host_identity { host_identity_eq }
import gunbc.fleet.fleet_host_identity {
  HostIdentity, operator_host_6ce85c, operator_host_srv1, operator_host_srv3, operator_host_srv4,
}
import gunbc.serving.serving_context_cap { serving_fleet_context_cap }
import gunbc.serving.serving_host_memory {
  ServingEngineMemory, ServingMemoryReading, ServingMemoryUnread,
  conversation_snapshot_bytes, serving_reading_bytes_or_zero, serving_warm_sessions_within,
  srv1_vllm_engine_memory, srv3_strata_engine_memory, srv4_serving_engine_memory,
}
import gunbc.serving.serving_layout {
  ServingSharedArtifact, host_6ce85c_routed_expert_artifact, srv3_routed_expert_artifact,
  srv4_routed_expert_artifact,
}
import gunbc.serving.serving_capacity_anchor {
  ServingWarmSwap, SwapTierHostRam, WarmSwapAbsent, WarmSwapRestores,
}
import gunbc.serving.srv1_topology_comparison { srv1_layout }
import gunbc.serving.serving_replica_profile {
  FiguresAtCoordinate, FiguresUnmeasured, ReplicaExpertRung, ReplicaFigures, ReplicaHostCharges,
  ReplicaRunIdentity, ResolvedFigures, ServingReplicaProfile,
  configuration_charges, expert_rungs_of, replica_figures_refusal, replica_run_identity, replicas_on_host,
  resolve_replica_figures,
  srv1_vllm_replica_0_profile, srv1_vllm_replica_1_profile, srv3_strata_profile, srv4_strata_profile,
}

// ── A CANDIDATE CONFIGURATION ─────────────────────────────────────────────────────────────────────
//
// One host, one way of running it. `replicas` is the roster rows it deploys; the empty list is a configuration
// the fleet has NEVER run, which is a fact about the fleet and not a gap in this module -- srv1's TP=2 is
// measured at 150k in srv1_topology_readings and has never been launched as a serving deployment, so it has no
// roster row and its figures come from the reading alone.
type ReplicaConfiguration {
  // Which host this configuration is a way of running. The selector's subject is the HOST, and these rows are
  // its candidates: the question the operator asks is "what should THIS host run", not "which host is next".
  host: HostIdentity
  // Stable id, unique across the field: host + shape of the configuration, so two candidates of one host
  // cannot collide and a witness can pin which one survived.
  id: NonEmptyStr
  label: NonEmptyStr
  // What changes against the configuration the host runs today, in the words of the rows that say so.
  description: NonEmptyStr
  // The roster rows this configuration deploys. Empty means never deployed, and the figures below then carry
  // either a reading taken for this exact shape or the obligation to take one.
  replicas: List<ServingReplicaProfile>
  // How many engine replicas run. Stated alongside `replicas` because a never-run configuration has a count
  // and no rows; a deployed one's count must equal its rows' length, which the field's witness checks.
  replica_count: Nat
  // The warm ladder THIS configuration keeps. Two candidates of one host may share every fact but this one --
  // the RAM-only variant of srv1's pair differs from the pair only in that LMCache's disk tier is not
  // configured, and that difference is the whole of what the selector is being asked about.
  warm_ladder: List<ServingWarmSwap>
  // Where the weights and experts sit, as the host's serving_layout artifact row says. Absent where nothing
  // models the placement, which the host-RAM axis reports rather than zeroing.
  expert_artifact: Optional<ServingSharedArtifact>
  // The engine memory row for the anonymous base. Absent means no row states it, and the RAM axis refuses.
  engine_memory: Optional<ServingEngineMemory>
  // What this configuration may be quoted for throughput and cold prefill: an on-row figure, a coordinate
  // reading, or the reading it still needs. Resolution is the profile module's, run-identity keying included.
  figures: ReplicaFigures
  // HOW MANY CONCURRENT AGENTS A SERVING PASS ON THIS VERY CONFIGURATION SERVED, as a standing rather than a
  // number: observed with the standing of the observation, or unread naming the read that would settle it.
  // There is no default, because a population defaulted to one is the failure mode this module exists to close
  // (gunbc.recurring_failure_mode::a_capacity_default_sized_for_one_workload_shape_inherited_by_another):
  // a capacity sized for one conversation at a time stays legal while the agents inside the slots multiply.
  concurrent_agents: ConcurrentAgentPopulation
  // THE HIT RATIO A SERVING PASS ON THIS VERY CONFIGURATION PRODUCED, carried as counts and their standing,
  // so a future tuning decision reads a measurement instead of a default. THE RATIO IS THE PASS'S FACT, and
  // a configuration carries one only if a pass ran on THAT configuration: a configuration that has never
  // been served carries RatioUnread naming whichever pass on its host did print counters, never that pass's
  // numbers, because a ratio measured on another way of running is not this configuration's measurement.
  // A pass that ran and printed no counters is RatioEmptyOnPass carrying its obligation; a host no pass ever
  // reported is RatioUnread -- never a zero, and never silence
  // (gunbc.design_argument::epistemic_humility: a ratio nobody observed is not a ratio).
  prefix_cache_ratio: PrefixCachePassRatio
  // Where THIS configuration comes from as a composition. The bytes, milliseconds and rates it is quoted on
  // carry their own standings on the rows they come from (the ladder rungs, the artifact row, the figures);
  // what this field answers is only "how do you know this is a way the host could run".
  provenance: NonEmptyStr
}

// ── THE POPULATION, THE CACHE THAT SERVES IT, AND THE RATIO A PASS LEAVES ───────────────────────
//
// WHY THESE THREE TYPES SIT ON A CONFIGURATION AND NOT ON A HOST: the question the selector asks is "what
// should THIS host run", and a cache's adequacy is a property of the way of running -- which tiers the
// configuration keeps, how many engines it runs, and what it is expected to hold warm at once. srv1's pair
// and srv1's TP=2 share a host and a checkpoint and differ in exactly that.
//
// THE OBSERVATION BELONGS TO A PASS, AND A CONFIGURATION CARRIES IT ONLY IF THAT PASS RAN ON IT. The
// population and the counters are facts about a run, so they are declared ONCE, as the pass's own rows
// (h11_pass_concurrent_agents, h11_pass_prefix_cache_ratio), and only the configuration that pass actually
// served carries them. h11's two-engine candidate has never been served -- its own provenance says so -- so
// it carries the unread verdict naming that pass rather than borrowing its numbers: a configuration nobody
// ran has no measurement to report, and a count copied onto it from a different configuration would read as
// a measurement of nothing (gunbc.design_argument::single_authority: one authoritative declaration of each
// meaning; gunbc.design_argument::epistemic_humility: do not assert as observed what another run observed).
//
// THE UNIT IS THE WORKLOAD'S, NOT THE ENGINE'S. serving_host_memory already folds an engine's cache BYTES
// and slot COUNT into the sessions it can keep warm (serving_warm_sessions_within), and the selector
// already places by that figure -- without ever asking how many agents are inside those slots. So the
// capacity is restated here in agents and joined to the population, and the join refuses rather than
// degrading (gunbc.design_argument::fail_closed): the alternative is a latency a reader attributes to the
// model or the network, which is what the 2026-11-21 finding on h11 actually was.
//
// THE SCOPE RULE, stated because the two sides are counted at different grains. The capacity is the
// CONFIGURATION's: one engine's widest read rung, scaled by the number of engines the configuration runs,
// the same scaling configuration_charges applies to warm RAM, because every engine adds its own cache and
// its own slots. The population is what the host carries at once. How agents distribute across one host's
// engines is NOT modeled, so Holds is a bound (the cache can hold at least this many) while Exceeded is a
// fact (no seating of the population fits).
//
// DECLARED FRONTIER (gunbc.design_argument::consumption). The production consumers of
// PrefixCacheCapacityVerdict are the placement that seats agents -- gunbc.serving.serving_replica_choice's
// axis set, and the router's admission -- and the consumer of the ratio is the tuning decision this row
// exists to inform. Neither is wired here: the selector's axes are FUNDED ones and a new axis needs a bill
// (its own header says so), and the floor that would turn a low ratio into a refusal is the operator's
// number to declare, not this model's to invent -- a floor invented here would be a fine invented here.
// TRIGGER: the per-host read mode landing (gunbc.fleet.fleet_host_truth_read, which supplies the
// population), together with a declared floor. Until then the only consumer of a verdict is a claim, which
// is what dag/test/claim/serving/serving_replica_configuration_witness.dag is for.

// The population, as a standing: a count someone observed with the standing of that observation, or the
// read that has not happened. Assumed is deliberately absent: a population is a count of what a host
// carries, and a declared allowance for it is not a count of it.
type ConcurrentAgentPopulation
  = PopulationObserved { agents: Nat, standing: CitedFigureStanding }
  | PopulationUnread { obligation: NonEmptyStr }

// What a serving pass left behind. Counts, never a pre-chewed ratio: a ratio without its denominator is
// how "three hits against fifty misses" becomes "the cache is fine". The standing says whose counters
// these are, because a relay's counters and an instrument's are different claims
// (gunbc.design_argument::external_upstreams).
//
// THREE ARMS BECAUSE THE TWO WAYS A RATIO IS NOT THERE ARE DIFFERENT FACTS, and the row names one of them
// as its RED case. A pass that ran and came back with an EMPTY hit column produced a receipt for a
// measurement that never happened; a host where no pass ever carried the counters has a missing producer.
// Collapsing them is the failure mode: an empty column read as "no news" is exactly how a 56-permille cache
// stays invisible. The population below keeps two arms, not three, because a count of who is seated has no
// separate instrument that can print an empty column -- a pass that seated nobody is a measurement of zero,
// while a pass that seated agents and reported no occupancy has no producer for that figure, which is the
// unread arm's meaning.
type PrefixCachePassRatio
  = RatioObserved { hits: Nat, misses: Nat, standing: CitedFigureStanding }
  | RatioEmptyOnPass { pass: NonEmptyStr, obligation: NonEmptyStr }
  | RatioUnread { obligation: NonEmptyStr }

// THE JOIN'S VERDICT. Exceeded carries both numbers so the refusal is actionable without opening the
// model; Undetermined carries the obligations that say which figure is missing, and it is what an
// uncounted population produces -- never a quiet Holds.
type PrefixCacheCapacityVerdict
  = CapacityHoldsPopulation { agents: Nat, warm_agents: Nat }
  | CapacityExceededByPopulation { agents: Nat, warm_agents: Nat }
  | CapacityUndetermined { obligations: List<NonEmptyStr> }

// WHAT IS MISSING WHERE NOTHING HAS COUNTED: one obligation per side, carried by every candidate whose
// host has never counted its population or printed its ratio. Written once, so nine rows cannot drift
// into nine dialects of the same gap -- and so the gap is a read obligation with a name, not a shrug.
data population_unread_obligation: NonEmptyStr = "no pass on this host has reported how many concurrent agents it serves; the per-host read (gunbc.fleet.fleet_host_truth_read) is the mode that would supply it, and until it does the cache capacity cannot be joined to a population -- an uncounted population is not a population of one" as NonEmptyStr

data ratio_unread_obligation: NonEmptyStr = "no serving pass on this host has reported prefix-cache hits and misses over a named interval; the ratio is the measurement that says whether the cache was adequate at all, and its absence is a read obligation rather than a fine" as NonEmptyStr

// THE ONE HOST THE FLEET HAS A PASS FOR. The 2026-11-21 finding on this host (operator_host_6ce85c, the
// host the fleet report of that date calls h11) printed the counters: four concurrent agents, three hits
// against fifty misses, every miss a 32 s re-prefill where a hit costs 3 s. The standing says what those
// numbers are -- a relay's printed counters, from a pass no launch record in either repository produced --
// because the finding IS that the tree could not know, and a row that dressed the relay as an instrument
// would be the same knowing-without-instrumentation one level up.
data h11_pass_population_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "the four concurrent agents come from the serving pass whose printed counters the operator's report of 2026-11-21 relayed from this host; no launch record in either repository produced that pass, so the counters are the relay's and not an instrument's -- read the live units' ExecStart and the engine's own counters before quoting this as a read (gunbc.serving.serving_replica_profile::srv_strata_profile_unread)" as NonEmptyStr,
}

data h11_pass_ratio_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "the same relay: that pass reported three hits against fifty misses, and the interval those counters cover is not stated. A lifetime ratio is refused for the same reason extdeps.vllm.metrics::prefix_cache_verdict refuses one -- read the engine's own prefix counters over a named interval before quoting this as a rate" as NonEmptyStr,
}

// THE PASS, DECLARED ONCE. The four agents and the counters are that PASS's figures, not any configuration's,
// so they are written here a single time and the configuration the pass ran on refers to them instead of
// spelling the literals again (gunbc.design_argument::single_authority). A configuration on the same host
// that the pass did not run carries the unread verdict below instead.
data h11_pass_concurrent_agents: ConcurrentAgentPopulation = PopulationObserved { agents: 4, standing: h11_pass_population_standing }

data h11_pass_prefix_cache_ratio: PrefixCachePassRatio = RatioObserved { hits: 3, misses: 50, standing: h11_pass_ratio_standing }

// THE UN-RUN CONFIGURATION'S OWN OBLIGATIONS, each naming where the only read on this host lives, so the gap
// cannot be read as an absence of data nor the pass be mistaken for this configuration's.
data h11_two_engine_population_unread_obligation: NonEmptyStr = "no pass has ever served h11 on two engines; the only concurrent-agent count this host has is the 2026-11-21 four-engine pass's (h11_pass_concurrent_agents), which is that configuration's observation and not this one's -- serve this configuration and read its concurrent agents before quoting a number for it" as NonEmptyStr

data h11_two_engine_ratio_unread_obligation: NonEmptyStr = "no pass has reported prefix-cache hits and misses for a two-engine run on this host; the only counters ever relayed here are the four-engine pass's (h11_pass_prefix_cache_ratio), and a ratio measured while four engines ran says nothing about a configuration that has never run -- run it and read the engine's prefix counters over a named interval" as NonEmptyStr

// ── THE LADDER PIECES THE CANDIDATES COMPOSE ──────────────────────────────────────────────────────
//
// A configuration's ladder is composed from rungs that already exist as rows, never re-spelled: taking a
// deployed replica's ladder and dropping its disk tier IS the RAM-only configuration, and saying so in code
// keeps the two candidates honest about what differs.
fn warm_rungs_without_disk(ladder: List<ServingWarmSwap>) -> List<ServingWarmSwap> {
  filter(ladder, r => rung_is_host_ram(rung: r))
}

fn rung_is_host_ram(rung: ServingWarmSwap) -> Bool {
  match rung {
    WarmSwapRestores { tier: tier } => match tier {
      SwapTierHostRam => true,
      _ => false,
    },
    // A refused or absent rung is not a host-RAM tier; it carries no bytes and composes into nothing.
    _ => false,
  }
}

// A tier nobody has a store for: not unread, not refused -- the configuration simply has no such tier, and the
// fold contributes nothing for it. Used where a candidate WOULD take a tier the fleet has never run there.
fn no_disk_rung() -> ServingWarmSwap {
  WarmSwapAbsent
}

// ── THE CANDIDATE FIELD: PER HOST, THE WAYS IT COULD RUN ──────────────────────────────────────────
//
// srv1's real question, from its own rows: the pair (2xTP=1) and TP=2 were BOTH measured at 150k in
// srv1_topology_readings, and NEITHER has been measured at the fleet's ~200k context window, so a selector
// asked at 200k must answer SelectionNeedsEvidence naming exactly that reading -- and the field below is built
// so that is what happens, with no rate invented to fill the gap.
data srv1_pair_l1_l2_configuration: ReplicaConfiguration = ReplicaConfiguration {
  host: operator_host_srv1,
  id: "srv1-pair-l1-l2" as NonEmptyStr,
  label: "two single-card replicas, LMCache L1 + L2" as NonEmptyStr,
  description: concat(
    concat(concat("What srv1 runs today: ", srv1_vllm_replica_0_profile.id), " and ") as NonEmptyStr,
    srv1_vllm_replica_1_profile.id
  ) as NonEmptyStr,
  replicas: replicas_on_host(host: operator_host_srv1),
  replica_count: 2,
  warm_ladder: srv1_vllm_replica_0_profile.warm_ladder,
  // vLLM loads the checkpoint onto each card and no artifact row says how; the RAM axis reports that rather
  // than charging nothing.
  expert_artifact: Absent,
  engine_memory: Present { value: srv1_vllm_engine_memory },
  figures: FiguresAtCoordinate { topology: srv1_layout(tp: 1, dp: 2), sessions: 8 },
  concurrent_agents: PopulationUnread { obligation: population_unread_obligation },
  prefix_cache_ratio: RatioUnread { obligation: ratio_unread_obligation },
  provenance: "composed from the host's own rows: its roster rows, the ladder rungs they carry, the layout's artifact row, and the readings its figures resolve to" as NonEmptyStr,
}

data srv1_pair_l1_only_configuration: ReplicaConfiguration = ReplicaConfiguration {
  host: operator_host_srv1,
  id: "srv1-pair-l1-only" as NonEmptyStr,
  label: "two single-card replicas, LMCache L1 only" as NonEmptyStr,
  // The same deployment with LMCache's disk tier not configured: same replicas, same checkpoint, same rungs
  // MINUS the disk one. Nothing survives a restart then, and the host holds no disk budget for the tier --
  // both of which the charges derive from the ladder, not from prose.
  description: "The pair as launched, with LMCache's L2 disk tier not configured: the 12 GiB host-RAM tier alone, so a restart pays cold prefill and the host holds no warm disk" as NonEmptyStr,
  replicas: replicas_on_host(host: operator_host_srv1),
  replica_count: 2,
  warm_ladder: warm_rungs_without_disk(ladder: srv1_vllm_replica_0_profile.warm_ladder),
  expert_artifact: Absent,
  engine_memory: Present { value: srv1_vllm_engine_memory },
  // The pair's decode readings stand for either warm ladder: what the warm tiers change is what a restart
  // costs and what the host holds, not the tokens per second of a resident conversation.
  figures: FiguresAtCoordinate { topology: srv1_layout(tp: 1, dp: 2), sessions: 8 },
  concurrent_agents: PopulationUnread { obligation: population_unread_obligation },
  prefix_cache_ratio: RatioUnread { obligation: ratio_unread_obligation },
  provenance: "composed from the host's own rows: its roster rows, the ladder rungs they carry, the layout's artifact row, and the readings its figures resolve to" as NonEmptyStr,
}

data srv1_tp2_l1_l2_configuration: ReplicaConfiguration = ReplicaConfiguration {
  host: operator_host_srv1,
  id: "srv1-tp2-l1-l2" as NonEmptyStr,
  label: "one replica across both cards (TP=2), LMCache L1 + L2" as NonEmptyStr,
  // MEASURED, NEVER DEPLOYED: srv1_topology_readings has TP=2 at 150k (618 tok/s at 8, single-request p50
  // 61.9), so this is not a guess -- and it has no roster row because the fleet has never run it, which is
  // what the empty `replicas` list says.
  description: "One engine across both cards, which the 150k topology comparison measured at 618 tok/s against the pair's 679: fewer replicas to warm, half the warm bytes to hold, and 9% less throughput" as NonEmptyStr,
  replicas: [] as List<ServingReplicaProfile>,
  replica_count: 1,
  // The same tiers a srv1 replica keeps; one replica now, so the ladder is charged once.
  warm_ladder: srv1_vllm_replica_0_profile.warm_ladder,
  expert_artifact: Absent,
  engine_memory: Present { value: srv1_vllm_engine_memory },
  figures: FiguresAtCoordinate { topology: srv1_layout(tp: 2, dp: 1), sessions: 8 },
  concurrent_agents: PopulationUnread { obligation: population_unread_obligation },
  prefix_cache_ratio: RatioUnread { obligation: ratio_unread_obligation },
  provenance: "composed from the host's own rows: its roster rows, the ladder rungs they carry, the layout's artifact row, and the readings its figures resolve to" as NonEmptyStr,
}

// srv3 runs one Strata engine at --batch 8 on the Ada pair, which REFUSES the slot-file disk tier: batch >1
// disables the slot endpoint (serving_layout's refusal rows say so). The alternative the operator can actually
// take is batch 1 with the slot file -- the same host, one turn at a time, with conversations that survive a
// restart. What it costs in throughput has never been measured on srv3, so its figures name the reading.
data srv3_batch8_ram_only_configuration: ReplicaConfiguration = ReplicaConfiguration {
  host: operator_host_srv3,
  id: "srv3-batch8-ram" as NonEmptyStr,
  label: "one Strata engine, --batch 8, RAM tier only" as NonEmptyStr,
  description: "What srv3 runs today: the batched engine, its conversations in host RAM, no disk tier (batch >1 refuses the slot endpoint)" as NonEmptyStr,
  replicas: replicas_on_host(host: operator_host_srv3),
  replica_count: 1,
  warm_ladder: srv3_strata_profile.warm_ladder,
  expert_artifact: Present { value: srv3_routed_expert_artifact },
  engine_memory: Present { value: srv3_strata_engine_memory },
  figures: srv3_strata_profile.figures,
  concurrent_agents: PopulationUnread { obligation: population_unread_obligation },
  prefix_cache_ratio: RatioUnread { obligation: ratio_unread_obligation },
  provenance: "composed from the host's own rows: its roster rows, the ladder rungs they carry, the layout's artifact row, and the readings its figures resolve to" as NonEmptyStr,
}

data srv3_batch1_slotfile_configuration: ReplicaConfiguration = ReplicaConfiguration {
  host: operator_host_srv3,
  id: "srv3-batch1-slotfile" as NonEmptyStr,
  label: "one Strata engine, --batch 1, RAM tier + slot-file disk tier" as NonEmptyStr,
  // The configuration srv3's own refusal rows point at: the slot file becomes admissible the moment batch is
  // 1. It has never been launched, so the disk rung has no measured restore and the throughput at batch 1 has
  // no reading -- both named rather than borrowed from srv4, whose engine and drive are its own.
  description: "The same engine at batch 1, which admits the slot-file disk tier: conversations then survive a process restart, at a throughput nobody has measured on srv3" as NonEmptyStr,
  replicas: [] as List<ServingReplicaProfile>,
  replica_count: 1,
  warm_ladder: concat(
    warm_rungs_without_disk(ladder: srv3_strata_profile.warm_ladder),
    [no_disk_rung()] as List<ServingWarmSwap>
  ),
  expert_artifact: Present { value: srv3_routed_expert_artifact },
  engine_memory: Present { value: srv3_strata_engine_memory },
  figures: FiguresUnmeasured {
    obligation: "read srv3 at --batch 1 with the slot-file tier: aggregate decode tok/s at the fleet's 229376-token window, and the save and restore milliseconds of one ~200k conversation" as NonEmptyStr,
  },
  concurrent_agents: PopulationUnread { obligation: population_unread_obligation },
  prefix_cache_ratio: RatioUnread { obligation: ratio_unread_obligation },
  provenance: "never launched on srv3; composed from srv3's own refusal rows (the slot endpoint becomes admissible at batch 1) and from the shape srv4 runs, and neither is a reading of srv3" as NonEmptyStr,
}

data srv4_batch1_slotfile_configuration: ReplicaConfiguration = ReplicaConfiguration {
  host: operator_host_srv4,
  id: "srv4-batch1-slotfile" as NonEmptyStr,
  label: "one Strata engine, --batch 1, RAM tier + slot-file disk tier" as NonEmptyStr,
  description: "What srv4 runs today: the parked tier with its disk rung, conversations surviving a restart, experts mapped under the engine cgroup cap" as NonEmptyStr,
  replicas: replicas_on_host(host: operator_host_srv4),
  replica_count: 1,
  warm_ladder: srv4_strata_profile.warm_ladder,
  expert_artifact: Present { value: srv4_routed_expert_artifact },
  engine_memory: Present { value: srv4_serving_engine_memory },
  figures: srv4_strata_profile.figures,
  concurrent_agents: PopulationUnread { obligation: population_unread_obligation },
  prefix_cache_ratio: RatioUnread { obligation: ratio_unread_obligation },
  provenance: "composed from the host's own rows: its roster rows, the ladder rungs they carry, the layout's artifact row, and the readings its figures resolve to" as NonEmptyStr,
}

// The mirror of srv3's question: srv4 could run batched, which is what buys throughput and costs the disk tier
// (batch >1 refuses the slot endpoint) -- and srv4 has never been measured at batch 8 either.
data srv4_batch8_ram_only_configuration: ReplicaConfiguration = ReplicaConfiguration {
  host: operator_host_srv4,
  id: "srv4-batch8-ram" as NonEmptyStr,
  label: "one Strata engine, --batch 8, RAM tier only" as NonEmptyStr,
  description: "The same engine batched: the disk tier is refused by batch >1, so nothing survives a restart and the host holds no warm disk budget" as NonEmptyStr,
  replicas: [] as List<ServingReplicaProfile>,
  replica_count: 1,
  warm_ladder: warm_rungs_without_disk(ladder: srv4_strata_profile.warm_ladder),
  expert_artifact: Present { value: srv4_routed_expert_artifact },
  engine_memory: Present { value: srv4_serving_engine_memory },
  figures: FiguresUnmeasured {
    obligation: "read srv4 at --batch 8 with no disk tier: aggregate decode tok/s at the fleet's 229376-token window" as NonEmptyStr,
  },
  concurrent_agents: PopulationUnread { obligation: population_unread_obligation },
  prefix_cache_ratio: RatioUnread { obligation: ratio_unread_obligation },
  provenance: "never launched on srv4 batched; composed from srv4's own refusal rows for batch >1" as NonEmptyStr,
}

// h11's question is its RAM ceiling, in its own rows: five engines needed 127 GB against the ~118 GB the host
// can actually give it (serving_host_memory's headroom reading), so the number of engines on this host is a
// live configuration choice, and the experts being mlocked means each engine's cache is RAM the host cannot
// take back.
data h11_four_engines_configuration: ReplicaConfiguration = ReplicaConfiguration {
  host: operator_host_6ce85c,
  id: "h11-four-engines-locked" as NonEmptyStr,
  label: "four A16 engines, experts mlocked in RAM" as NonEmptyStr,
  description: "What h11 runs today: one engine per in-service A16 bus, every conversation in the engine's RAM cache, experts pinned by the lock service" as NonEmptyStr,
  replicas: replicas_on_host(host: operator_host_6ce85c),
  replica_count: host_6ce85c_a16_bus_count(),
  warm_ladder: h11_engine_ladder(),
  expert_artifact: Present { value: host_6ce85c_routed_expert_artifact },
  engine_memory: h11_engine_memory(),
  figures: h11_engine_figures(),
  // THE CONFIGURATION THE 2026-11-21 PASS ACTUALLY RAN, so it carries the pass's own declaration rather than
  // a copy of it.
  concurrent_agents: h11_pass_concurrent_agents,
  prefix_cache_ratio: h11_pass_prefix_cache_ratio,
  provenance: "composed from the host's own rows: its roster rows, the ladder rungs they carry, the layout's artifact row, and the readings its figures resolve to" as NonEmptyStr,
}

data h11_two_engines_configuration: ReplicaConfiguration = ReplicaConfiguration {
  host: operator_host_6ce85c,
  id: "h11-two-engines-locked" as NonEmptyStr,
  label: "two A16 engines, experts mlocked in RAM" as NonEmptyStr,
  // The same engines on the same cards, half of them running. Fewer conversations served, and far less host
  // RAM charged: the mlocked experts are charged ONCE either way (shared resident bytes), but every engine
  // adds its own cache and its own anonymous base. That is the trade the RAM axis is for.
  description: "Half the engines on the same host: the mlocked expert copy is charged once either way, while each engine adds its own cache and base -- fewer conversations, less RAM" as NonEmptyStr,
  replicas: take_prefix(xs: replicas_on_host(host: operator_host_6ce85c), n: 2),
  replica_count: 2,
  warm_ladder: h11_engine_ladder(),
  expert_artifact: Present { value: host_6ce85c_routed_expert_artifact },
  engine_memory: h11_engine_memory(),
  figures: h11_engine_figures(),
  // NEVER SERVED, SO NOTHING IS OBSERVED HERE: the host's only population read and the host's only counters
  // belong to the four-engine pass, and this configuration refuses to borrow them. Its capacity in agents is
  // still stated (four engines' worth of cache halved), which is what makes the refusal worth reading.
  concurrent_agents: PopulationUnread { obligation: h11_two_engine_population_unread_obligation },
  prefix_cache_ratio: RatioUnread { obligation: h11_two_engine_ratio_unread_obligation },
  provenance: "never served on two engines; composed from h11's own engine rows with half of them running" as NonEmptyStr,
}

// ── THE FIELD, AND THE HOST-SCOPED VIEWS THE SELECTOR USES ────────────────────────────────────────
data replica_configuration_field: List<ReplicaConfiguration> = [
  srv1_pair_l1_l2_configuration,
  srv1_pair_l1_only_configuration,
  srv1_tp2_l1_l2_configuration,
  srv3_batch8_ram_only_configuration,
  srv3_batch1_slotfile_configuration,
  srv4_batch1_slotfile_configuration,
  srv4_batch8_ram_only_configuration,
  h11_four_engines_configuration,
  h11_two_engines_configuration,
]

// The candidates for ONE host: the selector's subject is the host, and these are the configurations it is
// being asked to choose between.
fn host_configurations(host: HostIdentity) -> List<ReplicaConfiguration> {
  filter(replica_configuration_field, c => host_identity_eq(a: c.host, b: host))
}

fn configuration_is_on_host(c: ReplicaConfiguration, host: HostIdentity) -> Bool {
  host_identity_eq(a: c.host, b: host)
}

// The identity a reading must match for THIS configuration: the deployment rows' own claim where the fleet runs
// it, and the same claim from any of the host's roster rows where it does not -- a never-run configuration
// launches the same checkpoint under the same engine and cap as the host's live deployment, which is the only
// identity there is to check against. Absent where the host states none, and then a coordinate reading refuses
// rather than going unchecked.
fn configuration_run_identity(c: ReplicaConfiguration) -> Optional<ReplicaRunIdentity> {
  match configuration_identity_row(c: c) {
    Absent => Absent,
    Present { value: row } => replica_run_identity(p: row),
  }
}

fn configuration_identity_row(c: ReplicaConfiguration) -> Optional<ServingReplicaProfile> {
  match c.replicas.first() {
    Present { value: row } => Present { value: row },
    Absent => replicas_on_host(host: c.host).first(),
  }
}

// The figures a configuration may be quoted, keyed by the run they were taken under.
fn configuration_figures_resolved(c: ReplicaConfiguration) -> Optional<ResolvedFigures> {
  resolve_replica_figures(figures: c.figures, live: configuration_run_identity(c: c))
}

fn configuration_figures_refusal(c: ReplicaConfiguration) -> Optional<NonEmptyStr> {
  match c.figures {
    FiguresUnmeasured { obligation: obligation } => Present { value: obligation },
    _ =>
      match configuration_identity_row(c: c) {
        Absent => Present { value: "this configuration has no deployment row and its host states no run identity, so no reading can be shown to match it" as NonEmptyStr },
        Present { value: row } => replica_figures_refusal(p: row),
      },
  }
}

// What the configuration charges the host: profile's rules, this row's ladder, experts counted once.
fn configuration_host_charges(c: ReplicaConfiguration) -> ReplicaHostCharges {
  configuration_charges(
    ladder: c.warm_ladder,
    expert_artifact: c.expert_artifact,
    engine_memory: c.engine_memory,
    replica_count: c.replica_count,
  )
}

// The typed placement rungs for the configuration, read off its artifact row (empty where nothing models the
// placement, which the caller reports as an obligation rather than a clean bill).
fn configuration_expert_rungs(c: ReplicaConfiguration) -> List<ReplicaExpertRung> {
  match c.expert_artifact {
    Absent => [] as List<ReplicaExpertRung>,
    Present { value: artifact } => expert_rungs_of(artifact: artifact),
  }
}

// ── THE CACHE CAPACITY IN AGENTS, AND THE JOIN TO THE POPULATION ────────────────────────────────
//
// ONE FORMULA, THE ONE serving_host_memory ALREADY OWNS. The rung's cache bytes, the rung's slots and the
// rung's own snapshot cost go into serving_warm_sessions_within at the fleet's context cap; nothing here
// re-derives a byte or a per-token cost, and the cost is the HOST's own row (h11's IQ3_S envelope is not
// srv3's, and srv3's is not srv4's -- the three differ by release and KV setting, and the module that
// carries them says so).

// The agents ONE ENGINE can keep warm on one rung, at the fleet's window. An unread cache contributes
// nothing here -- and the obligation below is what says why, rather than a zero that would promise room
// nobody read (serving_reading_bytes_or_zero is a lower-bound device for oversubscription, and this is not
// a lower bound).
fn rung_warm_agents(rung: ServingWarmSwap, context: TokenCount) -> Optional<Nat> {
  match rung {
    WarmSwapRestores { cache: cache, slots: slots, cost: cost } => match cache {
      ServingMemoryUnread { reason: _ } => Absent
      _ => Present {
        value: serving_warm_sessions_within(
          cache: serving_reading_bytes_or_zero(r: cache),
          slots: slots,
          snapshot: conversation_snapshot_bytes(cost: cost, context: context),
        )
      }
    }
    // No store, or a store the adapter refused outright: neither holds an agent, and neither is a reading.
    _ => Absent
  }
}

// THE LADDER FOLDS INCLUSIVE, exactly as the save axis does: a conversation the router parked may still sit
// in the hotter tier, so the tiers are nested and the WIDEST one bounds how many agents the engine holds
// warm. Absent when no rung read its cache -- which is a refusal, not a capacity of zero.
fn configuration_engine_warm_agents(c: ReplicaConfiguration) -> Optional<Nat> {
  fold(c.warm_ladder, init: Absent, f: (acc, rung) => match rung_warm_agents(rung: rung, context: serving_fleet_context_cap) {
    Absent => acc
    Present { value: n } => match acc {
      Absent => Present { value: n }
      Present { value: seen } => if n > seen { Present { value: n } } else { Present { value: seen } }
    }
  })
}

// THE CONFIGURATION'S CAPACITY, IN AGENTS: one engine's widest rung times the engines it runs. The scaling
// is the one configuration_charges already applies to warm RAM, and it rests on the same claim -- every
// engine adds its own cache and its own slots -- including the claim h11's own row flags: its 8192 MiB is
// one bus's config file generalized to buses never read, so the scaled figure is as unread as that row.
fn configuration_warm_agent_capacity(c: ReplicaConfiguration) -> Optional<Nat> {
  match configuration_engine_warm_agents(c: c) {
    Absent => Absent
    Present { value: per_engine } =>
      if c.replica_count == 0 {
        Absent
      } else {
        Present { value: per_engine }
      }
  }
}

// WHY THE CAPACITY CANNOT BE SAID, when it cannot: the rungs that never read their cache, and the ladder
// that has no read rung at all. These are the obligations the verdict carries, so an Undetermined names
// the reading rather than being read as a pass.
fn configuration_capacity_obligations(c: ReplicaConfiguration) -> List<NonEmptyStr> {
  let unread_rungs = fold(c.warm_ladder, init: [] as List<NonEmptyStr>, f: (acc, rung) => match rung {
    WarmSwapRestores { cache: cache, slots: _, cost: _ } => match cache {
      ServingMemoryUnread { reason: reason } => concat(acc, [reason] as List<NonEmptyStr>)
      _ => acc
    }
    _ => acc
  })
  if unread_rungs.length() > 0 {
    unread_rungs
  } else {
    match configuration_engine_warm_agents(c: c) {
      Present { value: _ } => [] as List<NonEmptyStr>
      Absent => [
        concat(concat("no rung of ", c.label), " states cache bytes, so its cache capacity in agents is unstated") as NonEmptyStr,
      ] as List<NonEmptyStr>
    }
  }
}

// THE JOIN ON SUPPLIED NUMBERS, which is where the row's red control lives: more agents than the cache
// holds warm is Exceeded, and the refusal carries both numbers. Equal is not exceeded -- the capacity is a
// count of what fits, not a margin -- and the ratio observation, not this arithmetic, is what says whether
// a cache that arithmetically fits was actually adequate.
fn prefix_cache_capacity_against(agents: Nat, warm_agents: Nat) -> PrefixCacheCapacityVerdict {
  if agents > warm_agents {
    CapacityExceededByPopulation { agents: agents, warm_agents: warm_agents }
  } else {
    CapacityHoldsPopulation { agents: agents, warm_agents: warm_agents }
  }
}

// THE JOIN AS THE ROWS ANSWER IT. Anything unread on either side refuses with the obligations that say
// which figure is missing; an uncounted population NEVER becomes a Holds.
fn configuration_prefix_cache_capacity(c: ReplicaConfiguration) -> PrefixCacheCapacityVerdict {
  let missing = configuration_capacity_obligations(c: c)
  let population_obligation = match c.concurrent_agents {
    PopulationUnread { obligation: obligation } => [obligation] as List<NonEmptyStr>
    PopulationObserved { agents: _, standing: _ } => [] as List<NonEmptyStr>
  }
  let undetermined = concat(missing, population_obligation)
  if undetermined.length() > 0 {
    CapacityUndetermined { obligations: undetermined }
  } else {
    match configuration_warm_agent_capacity(c: c) {
      Absent => CapacityUndetermined {
        obligations: [concat(concat("the cache of ", c.label), " is read but its capacity in agents did not resolve") as NonEmptyStr],
      }
      Present { value: warm } => match c.concurrent_agents {
        PopulationObserved { agents: agents, standing: _ } => prefix_cache_capacity_against(agents: agents, warm_agents: warm)
        PopulationUnread { obligation: obligation } => CapacityUndetermined { obligations: [obligation] as List<NonEmptyStr> }
      }
    }
  }
}

// THE RATIO THE PASS LEFT, in thousandths, from the counts it carried: hits over hits plus misses. A pass
// that counted NOTHING has no ratio -- Absent, never zero. Zero hits against a hundred misses is a
// measurement; an empty column is not one, and reading it as one is the row's RED case.
fn prefix_cache_ratio_permille(ratio: PrefixCachePassRatio) -> Optional<Permille> {
  match ratio {
    // Neither absence produces a ratio. The arms stay distinguishable to the caller; what they share is
    // only this: no number.
    RatioUnread { obligation: _ } => Absent
    RatioEmptyOnPass { pass: _, obligation: _ } => Absent
    RatioObserved { hits: hits, misses: misses, standing: _ } =>
      if hits + misses == 0 {
        Absent
      } else {
        Present { value: permille(count: hits * 1000 / (hits + misses)) }
      }
  }
}

// ── THE h11 ACCESSORS, SO THE ROWS ABOVE READ ONE SOURCE ──────────────────────────────────────────
//
// h11's engines are built per bus by the roster, so a candidate configuration asks the roster rather than
// copying an engine's figures or ladder. Every one of these walks the same rows the roster prints.
fn h11_engines() -> List<ServingReplicaProfile> {
  replicas_on_host(host: operator_host_6ce85c)
}

fn host_6ce85c_a16_bus_count() -> Nat {
  h11_engines().length()
}

fn h11_engine_ladder() -> List<ServingWarmSwap> {
  match h11_engines().first() {
    // No engine row means the host's grant lists no in-service bus; a candidate with no ladder charges nothing
    // rather than pretending, and the field's witness would catch the drift.
    Absent => [] as List<ServingWarmSwap>,
    Present { value: row } => row.warm_ladder,
  }
}

fn h11_engine_memory() -> Optional<ServingEngineMemory> {
  match h11_engines().first() {
    Absent => Absent,
    Present { value: row } => row.engine_memory,
  }
}

fn h11_engine_figures() -> ReplicaFigures {
  match h11_engines().first() {
    Absent => FiguresUnmeasured {
      obligation: "h11 has no in-service engine row, so nothing can be quoted for it" as NonEmptyStr,
    },
    Present { value: row } => row.figures,
  }
}
