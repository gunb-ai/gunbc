module gunbc.serving.rented_allocation_host_enrollment

import std.types { String, Bool, NonEmptyStr, List }
import product.fabric.supply { SupplierOffer }
import std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, decl_ref }
import product.fabric.flex_vast_shadow { flex_vast_offer_key_of_id }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_enrollment { HostEnrollmentIntent, inference_serving_enrollment_participation }
import gunbc.fleet.fleet_host_backing { ProviderGuest, ProviderResourceBinding, ProviderResourceAwaited, ProviderResourceAcquired }
import gunbc.fleet.provider_acquisition { ProviderResourceAcquisition }
import extdeps.cloud.vast_ai { VastAiOfferHostResources }
import gunbc.fleet.vast_ai_guest { VastGuestStandings, VastGuestEntitlementRead, VastGuestEntitlementUnread, vast_ai_guest_entitlement }
import gunbc.serving.rented_allocation { RentedServingAllocation, RentedAllocationIdentity, RentedContractRead, RentedContractUnread }

// A RENTED CARD IS ENROLLED THROUGH HOST CONVERGENCE, AS EVERY HOST IS, AND THIS IS THE ONE DERIVATION OF
// THE ENROLLMENT INTENT ITS ALLOCATION IMPLIES. The intent is never authored: the host is the allocation's
// access node, the participation is inference serving (so gunbc.host.host_assimilation_program
// assimilation_program_for selects the inference program, InferenceServingProvision included, and no runner
// phase), and the backing is ProviderGuest with the route read from the accepted offer.
//
// STATED DIVERGENCE FROM gunbc.serving.rented_allocation rented_allocation_enrollment: that function derives
// a SERVING-ROUTE row (endpoint, ceiling, host access), a different question from the host's fleet enrollment
// (what supplies the host and what it is for). They share the allocation and nothing else, so they are two
// derivations of two facts and not a fork of one; there is NO rented-only enroll path, because this intent
// is walked by the same standup spine as every host.
//
// WHAT THE ALLOCATION CANNOT SUPPLY REFUSES TYPED:
//  - the route exists only when the contract was read (RentedContractRead); an unread contract names no
//    provider route, and none is invented;
//  - the guest entitlement is a provider fact the allocation does not carry, so it is a SUPPLIED reading of the
//    offer's host resources (extdeps.cloud.vast_ai VastAiOfferHostResources) through gunbc.fleet.vast_ai_guest,
//    which refuses on every fact Vast does not document (byte basis, nested virtualization, identity URL);
//  - the provider resource is the allocation's contract id (RentedAllocationIdentity.contract, the instance
//    id the provider names the rental by, never a label). The API account credential is not a field of the
//    allocation, so the resource is ProviderResourceAwaited unless the caller supplies the acquisition, which
//    must name that same contract id or the derivation refuses.

type RentedHostEnrollmentDerivation
  = RentedHostEnrollmentDerived { allocation: RentedAllocationIdentity, intent: HostEnrollmentIntent }
  | RentedHostEnrollmentRefused { allocation: RentedAllocationIdentity, obligation: NonEmptyStr }

data rented_contract_unread_no_route_obligation: NonEmptyStr = "the allocation's provider contract is unread, so it names no provider route and the ProviderGuest backing cannot be derived" as NonEmptyStr

fn rented_resource_awaited_obligation(id: RentedAllocationIdentity) -> NonEmptyStr {
  join(["the provider API account credential for rented contract ", id.contract as String, " is not carried by the allocation, so the resource is awaited and adoption refuses on it"], "") as NonEmptyStr
}

data rented_acquisition_names_another_resource_obligation: NonEmptyStr = "the supplied provider acquisition names a resource id other than the allocation's contract id, so it is another rental's binding" as NonEmptyStr

data rented_host_resources_mismatch_obligation: NonEmptyStr = "the supplied Vast host resources are read from another offer than the allocation's accepted contract offer (offer id differs, or the contract offer's key is not a Vast offer id), so they describe another machine" as NonEmptyStr

// THE BINDING IS OFFER IDENTITY. A Vast offer is keyed by its decimal id, the rule
// product.fabric.flex_vast_shadow flex_vast_offer_key_of_id holds once, so the contract offer's key must equal the
// host row's id keyed that way; a key that is not that rendering is not a Vast offer id and refuses.
fn rented_host_matches_contract(offer: SupplierOffer<NonEmptyStr>, host: VastAiOfferHostResources) -> Bool {
  flex_vast_offer_key_of_id(id: host.id) == offer.id.key
}

fn rented_resource_binding(a: RentedServingAllocation, acquisition: ProviderResourceAcquisition?) -> ProviderResourceBinding? {
  match acquisition {
    Absent => Present { value: ProviderResourceAwaited { read_obligation: rented_resource_awaited_obligation(id: a.identity) } }
    Present { value: q } =>
      if q.resource_id == a.identity.contract { Present { value: ProviderResourceAcquired { acquisition: q } } } else { Absent }
  }
}

fn rented_allocation_host_enrollment(a: RentedServingAllocation, host: VastAiOfferHostResources, host_decl: DeclarationRef, standings: VastGuestStandings, acquisition: ProviderResourceAcquisition?) -> RentedHostEnrollmentDerivation {
  match a.contract {
    RentedContractUnread { obligation: _ } => RentedHostEnrollmentRefused { allocation: a.identity, obligation: rented_contract_unread_no_route_obligation }
    RentedContractRead { offer: offer } =>
      if !rented_host_matches_contract(offer: offer, host: host) {
        RentedHostEnrollmentRefused { allocation: a.identity, obligation: rented_host_resources_mismatch_obligation }
      } else {
      match vast_ai_guest_entitlement(host: host, offer: host_decl, standings: standings) {
        VastGuestEntitlementUnread { obligation: o } => RentedHostEnrollmentRefused { allocation: a.identity, obligation: o }
        VastGuestEntitlementRead { entitlement: e } =>
          match rented_resource_binding(a: a, acquisition: acquisition) {
            Absent => RentedHostEnrollmentRefused { allocation: a.identity, obligation: rented_acquisition_names_another_resource_obligation }
            Present { value: r } =>
              RentedHostEnrollmentDerived {
                allocation: a.identity,
                intent: HostEnrollmentIntent {
                  host: a.host.node as HostIdentity,
                  participation: inference_serving_enrollment_participation,
                  backing: ProviderGuest { route: offer.route, entitlement: e, resource: r },
                },
              }
          }
      }
      }
  }
}

data rented_allocation_host_enrollment_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.rented_allocation_host_enrollment", decl_name: "rented_allocation_host_enrollment"),
    reason: "gunbc.fleet.vast_ai_guest derives architecture, vcpus, memory and disk from the documented search-offers fields, but three facts are undocumented by Vast and so refuse with their real standings (vast_ai_guest_standings): the MB/GB byte basis (precedent extdeps.pricing.object_storage ByteBasisUnstated), nested virtualization, and the self-identity URL. No real rented card derives until they are grounded, and the API account acquisition is still supplied rather than carried",
    dissolution: unbound_dissolution(description: "trigger: docs.vast.ai (or a cited operator product fact) states the byte basis of cpu_ram and disk_space, nested virtualization, and a container-readable self-identity URL, and #13989 lands with the current card — sufficient for a real fleet_enrollments row derived through this function with vast_ai_guest_standings carrying Documented arms"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.harness.rented_allocation_seat", decl_name: "rented_allocation_seat"),
    reason: "the seat is derived from an allocation but no harness fold reads it yet, because no real allocation is enrolled",
    dissolution: unbound_dissolution(description: "trigger: the flex wet create (product.fabric.flex_market) produces a RentedAllocationAcquired allocation whose intent gunbc.serving.rented_allocation_host_enrollment derives — sufficient for harness_bind_seat to be called with this seat for the real allocation"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.serving_key_grant", decl_name: "serving_key_grant_bind"),
    reason: "no caller supplies a granted key authorization, because no operator escalation and no secret source for the serving key exist yet",
    dissolution: unbound_dissolution(description: "trigger: a secret source delivers the granted key and the launch leg calls serving_key_grant_bind with the operator-granted authorization — sufficient for a bound ServingServeKeyBinding in a real launch"),
  ),
]
