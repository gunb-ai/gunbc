    pair_power_cap: Present { value: watt(count: 70) },
  },
  // The WARM rerun at 100 W per card. The pair drew 150-175 W against its 200 W cap.
  PairBenchRow {
    cards: TeslaT10Pair,
    host: HostWithoutIdentity { name: "h11-new" as NonEmptyStr, obligation: t10_pair_bench_host_obligation },
    standing: relayed_standing(host_files: "h11-new:~/strata-test/ (t10_check.sh and the warm-run outputs it wrote, plus the cold first run kept for the page-cache comparison)." as NonEmptyStr),
    c1_aggregate: rate(milli: 25000, p: AsReported),
    c1_decode: rate(milli: 32500, p: AsReported),
    c1_time_to_first_token: ms(count: 2400, p: AsReported),
    c4_aggregate: rate(milli: 47600, p: AsReported),
    c8_aggregate: rate(milli: 54300, p: AsReported),
    long_context_cold_first_turn: ms(count: 240000, p: AsReported),
