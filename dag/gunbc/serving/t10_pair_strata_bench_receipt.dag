// THE T10's POWER FLOOR, as relayed: each card's power limit cannot be set below 100 W, so the 100 W cap the
// bench ran at IS the floor, and the pair cannot trade throughput for efficiency below 200 W of cap. This is a
// device reading (nvidia-smi power.min_limit) relayed in prose; its home once read from a committed capture is
// gunbc.fleet.gpu_device_observation, and extdeps.gpu.nvidia_t10 keeps the board power unread because no NVIDIA
// document states it.
data t10_relayed_power_min_limit_per_card: Watt = watt(count: 100)
data t10_relayed_power_min_limit_standing: CitedFigureStanding = relayed_standing(host_files: "an nvidia-smi --query-gpu=power.min_limit,power.max_limit,power.default_limit,vbios_version reading of both T10s on h11-new, committed and folded into gunbc.fleet.gpu_device_observation." as NonEmptyStr)

// THE T10 PAIR'S THERMAL READINGS UNDER LOAD, as relayed. Each row is one cooling arrangement.
type T10Cooling = ChassisFansOnly | DeltaBlowerHeldByHand

type T10ThrottleReading
  = ThrottledTo { clock: Hertz, within: BenchReading<Millisecond> }
  | NoThrottleReported

// What happened to the cooling during a run, as relayed. The hand-held blower SLIPPED once, and the peak
// temperature is attributed to that slip, not to the steady arrangement.
type T10CoolingEvent
  = BlowerSlipped { peak_during: BenchReading<Celsius> }

fn celsius_delta_le(a: CelsiusDelta, b: CelsiusDelta) -> Bool {
  celsius_delta_count(delta: a) <= celsius_delta_count(delta: b)
}

type T10ThermalRow {
  cooling: T10Cooling
  // The steady band both cards held, and the highest reading; NotMeasured where the session gave none.
  gpu_temperature_band: BenchReading<Celsius>
  gpu_temperature_peak: BenchReading<Celsius>
  // How much hotter GPU1 ran than GPU0 over the run; NotMeasured where the session gave none.
  gpu1_over_gpu0: BenchReading<CelsiusDelta>
  throttle: T10ThrottleReading
  events: List<T10CoolingEvent>
}

// THE T10's MAXIMUM OPERATING TEMPERATURE, AS THE OPERATOR STATES IT: 87 C. No NVIDIA document for the T10 is
// reachable (extdeps.gpu.nvidia_t10), so this is an operator-stated figure, not a vendor fact, and it lives here
// beside the readings it is compared with rather than in the vendor row.
data t10_operator_stated_max_operating_temperature: Celsius = celsius(count: 87)
data t10_operator_stated_max_operating_temperature_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "Stated by the operator's benching session on 2026-11-16 as the T10's maximum operating temperature. Ground it in an NVIDIA document for the Tesla T10 (none was reachable: extdeps.gpu.nvidia_t10), or in nvidia-smi -q's 'GPU Max Operating Temp' / 'GPU Slowdown Temp' on both cards on h11-new, committed as a capture." as NonEmptyStr,
}

data t10_pair_thermal_rows: List<T10ThermalRow> = [
  T10ThermalRow {
    cooling: ChassisFansOnly,
    gpu_temperature_band: NotMeasured,
    gpu_temperature_peak: NotMeasured,
    gpu1_over_gpu0: NotMeasured,
    throttle: ThrottledTo { clock: hertz(count: 300000000), within: ms(count: 90000, p: Approximate) },
    events: [],
  },
  T10ThermalRow {
    cooling: DeltaBlowerHeldByHand,
    gpu_temperature_band: bench_span(low: celsius(count: 81), high: celsius(count: 85), le: celsius_le, precision: AsReported),
    gpu_temperature_peak: bench_point(value: celsius(count: 87), precision: AsReported),
    gpu1_over_gpu0: bench_span(low: celsius_delta(count: 1), high: celsius_delta(count: 5), le: celsius_delta_le, precision: AsReported),
    throttle: NoThrottleReported,
    events: [BlowerSlipped { peak_during: bench_point(value: celsius(count: 87), precision: AsReported) }],
  },
]

data t10_pair_thermal_standing: CitedFigureStanding = relayed_standing(host_files: "the nvidia-smi temperature, clock and clocks_event_reasons samples t10_check.sh recorded on h11-new during the hand-held-blower bench and the chassis-fans-only attempt." as NonEmptyStr)

// The c1/c4/c8 aggregate figure of a reading that is one AsReported point, or nothing. A range, an approximate
// figure or an absent one answers Absent, so an ordering claim below rests only on figures the session stated
// exactly.
fn reported_rate_point(r: BenchReading<MilliTokensPerSecond>) -> Nat? {
  match r {
    Read { span: s, precision: p } => match p {
      AsReported =>
        if milli_tokens_per_second_count(r: interval_low(interval: s)) == milli_tokens_per_second_count(r: interval_high(interval: s)) {
          Present { value: milli_tokens_per_second_count(r: interval_low(interval: s)) }
        } else { Absent }
      Approximate => Absent
    }
    NotMeasured => Absent
    ReadingRefused { reason: _ } => Absent
  }
}

fn row_for(cards: PairCard) -> PairBenchRow? {
  t10_pair_bench_rows.filter(r => match r.cards {
    RtxTwoThousandAdaPair => match cards { RtxTwoThousandAdaPair => true _ => false }
    NvidiaA2Pair => match cards { NvidiaA2Pair => true _ => false }
    TeslaT10Pair => match cards { TeslaT10Pair => true _ => false }
  }).first()
}

// No reading in any row was refused (no range was written reversed).
fn reading_refused<T>(r: BenchReading<T>) -> Bool {
  match r { ReadingRefused { reason: _ } => true _ => false }
}

data t10_pair_bench_receipt_frontier: DissolutionCondition = unbound_dissolution(
  description: "gunbc.design_argument::consumption: read today by test.claim.serving.t10_pair_strata_bench_receipt_witness (the T10 pair sits between the A2 and Ada pairs on every exactly-stated aggregate; its tokens per joule sit between them too; its relayed 100 W floor is the cap it ran at; the hand-held blower kept it out of throttle only to an 87 C peak). TRIGGER: the raw outputs on h11-new are committed under artifacts/host-observations/ and these rows are re-pointed at them (standing ObservedByReceipt, not TranscribedUncited), and then the home-serving selection (gunbc.serving.home_serving_candidate_field, whose applied rungs are TranscribedUncited today) reads its T10 and A2 cells' throughput from this receipt. Until then these rows are relayed evidence for the operator's capex comparison only." as NonEmptyStr
)
