module gunbc.serving.t10_pair_strata_bench_receipt

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.optional { Present, Absent }
import std.interval { OrderedClosedInterval, closed_interval, degenerate_interval, interval_low, interval_high, interval_construction_fold, IntervalConstructionFold }
import std.measure {
  Watt, watt, watt_count, Celsius, celsius, celsius_count, Millisecond, millisecond, millisecond_count,
  Hertz, hertz, MilliTokensPerSecond, milli_tokens_per_second, milli_tokens_per_second_count,
  CelsiusDelta, celsius_delta, celsius_delta_count,
}
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv3, operator_host_srv14 }

// THREE TWO-CARD STRATA SERVING PAIRS UNDER ONE TEST SHAPE, 2026-11-16: an RTX 2000 Ada pair (srv3), an A2 pair
// (butch, srv14) and a Tesla T10 pair (the host the operator's session calls h11-new), every row as the
// operator's benching session RELAYED it.
//
// WHAT THIS IS NOT. The R9700 receipt beside this one (gunbc.serving.h11_r9700_strata_bench_receipt) transcribes
// committed, sha256-pinned files. These rows do not: the raw outputs live only on h11-new (the session reported
// "all results are saved on h11-new"), which this repository's sessions cannot reach, so no file is committed and
// no digest is carried. Every row's standing is therefore TranscribedUncited, and its read obligation names the
// files to commit; a reader who consumes these numbers as pinned evidence is the defect
// (gunbc.design_argument::epistemic_humility).
//
// THE SHAPE. The T10 pair ran srv3's exact engine config and test shape: concurrency 1, 4 and 8 short turns, and
// a 140k-token long-context conversation (a cold first turn, then warm turns reusing it). The T10s were capped at
// 100 W each with a Delta blower held over the cards by hand. The producer is h11-new:~/strata-test/t10_check.sh.
// The A2 and Ada columns are the comparison rows the same session laid beside it; their own run dates and files
// are not stated here.
//
// COLD PAGE CACHE. The T10's first run was slowed by a cold host page cache; the T10 rows below are the WARM rerun,
// and t10_check.sh now prewarms the cache before measuring. This is not
// gunbc.recurring_failure_mode::benchmark_warm_capacity_violation_read_as_engine_performance (that class is a KV
// working set over capacity); it is the cold-read cost of a first load, and the 140k cold first turn is kept as
// its own row rather than being mixed into a warm figure.
//
// THE RELAYED SUMMARY IS NOT EXACTLY THE ROWS. The session summarized the T10 pair as "about 40-60% faster than
// an A2 pair and about 75-90% of an Ada pair". The rows give c1 aggregate 25.0/18.7 = 1.34x the A2 and c8
// aggregate 54.3/74.3 = 0.73x the Ada, both outside those bands. The rows are the record; the prose is not
// carried as a figure.

// "~" on a figure is Approximate; a bare figure is AsReported (rounded as relayed, not a raw sample).
type ReadingPrecision = AsReported | Approximate

// One relayed figure. A range is an std.interval (its endpoints cannot be reversed); a single figure is the
// degenerate interval. "—" in the relayed table is NotMeasured. A reversed range is refused, never swapped.
type BenchReading<T>
  = Read { span: OrderedClosedInterval<T>, precision: ReadingPrecision }
  | NotMeasured
  | ReadingRefused { reason: NonEmptyStr }

fn bench_point<T>(value: T, precision: ReadingPrecision) -> BenchReading<T> {
  Read { span: degenerate_interval(point: value), precision: precision }
}

fn bench_span<T>(low: T, high: T, le: fn(T, T) -> Bool, precision: ReadingPrecision) -> BenchReading<T> {
  interval_construction_fold(
    construction: closed_interval(low: low, high: high, le: le),
    fold: IntervalConstructionFold {
      ready: i => Read { span: i, precision: precision },
      refused: r => ReadingRefused { reason: r },
    },
  )
}

fn rate_le(a: MilliTokensPerSecond, b: MilliTokensPerSecond) -> Bool {
  milli_tokens_per_second_count(r: a) <= milli_tokens_per_second_count(r: b)
}

fn ms_le(a: Millisecond, b: Millisecond) -> Bool {
  millisecond_count(m: a) <= millisecond_count(m: b)
}

fn watt_le(a: Watt, b: Watt) -> Bool {
  watt_count(w: a) <= watt_count(w: b)
}

fn celsius_le(a: Celsius, b: Celsius) -> Bool {
  celsius_count(c: a) <= celsius_count(c: b)
}

fn rate(milli: Nat, p: ReadingPrecision) -> BenchReading<MilliTokensPerSecond> {
  bench_point(value: milli_tokens_per_second(count: milli), precision: p)
}

fn rate_range(low: Nat, high: Nat, p: ReadingPrecision) -> BenchReading<MilliTokensPerSecond> {
  bench_span(low: milli_tokens_per_second(count: low), high: milli_tokens_per_second(count: high), le: rate_le, precision: p)
}

fn tpj(milli: Nat, p: ReadingPrecision) -> BenchReading<Nat> {
  bench_point(value: milli, precision: p)
}

fn ms(count: Nat, p: ReadingPrecision) -> BenchReading<Millisecond> {
  bench_point(value: millisecond(count: count), precision: p)
}

fn ms_range(low: Nat, high: Nat, p: ReadingPrecision) -> BenchReading<Millisecond> {
  bench_span(low: millisecond(count: low), high: millisecond(count: high), le: ms_le, precision: p)
}

// The host a pair ran on. h11-new has no HostIdentity in gunbc.fleet.fleet_host_identity, and one is not minted
// here: its name is carried with the obligation to bind it.
type PairBenchHost
  = FleetHost { host: HostIdentity }
  | HostWithoutIdentity { name: NonEmptyStr, obligation: NonEmptyStr }

type PairCard = RtxTwoThousandAdaPair | NvidiaA2Pair | TeslaT10Pair

type PairBenchRow {
  cards: PairCard
  host: PairBenchHost
  standing: CitedFigureStanding
  c1_aggregate: BenchReading<MilliTokensPerSecond>
  c1_decode: BenchReading<MilliTokensPerSecond>
  c1_time_to_first_token: BenchReading<Millisecond>
  c4_aggregate: BenchReading<MilliTokensPerSecond>
  c8_aggregate: BenchReading<MilliTokensPerSecond>
  long_context_cold_first_turn: BenchReading<Millisecond>
  long_context_warm_decode: BenchReading<MilliTokensPerSecond>
  long_context_warm_time_to_first_token: BenchReading<Millisecond>
  // Generated tokens per joule of GPU energy, in thousandths (0.54 tok/J is 540).
  // feature:tokens-per-energy-measure — dissolve-on: std.measure carries a tokens-per-energy unit
  // (a Measure<CountPerEnergy, Milli, Nat> beside MilliTokensPerSecond) and these two fields take it. It was
  // added on this PR and withdrawn: a std.measure edit reaches the ~1,700 modules importing std.measure, and
  // gunbc.heal_workflow's affected-scope round refused it twice on page thrash (MemoryStallRefusedPageThrash,
  // runs 43784613094 attempts 1-2, slots srv3-09 and srv3-17). Owning lane: heal's scope cost,
  // gunbc.plans.read_set_convergence P7. BOUNDED POPULATION: these two fields.
  c4_tokens_per_gpu_joule: BenchReading<Nat>
  c8_tokens_per_gpu_joule: BenchReading<Nat>
  // Both cards' draw under load, and the pair's cap where the session stated one.
  pair_power_under_load: BenchReading<Watt>
  pair_power_cap: Watt?
}

fn relayed_standing(host_files: NonEmptyStr) -> CitedFigureStanding {
  TranscribedUncited { read_obligation: join([
    "Relayed by the operator's benching session on 2026-11-16 as a summary table; no file is committed. Commit the raw outputs under artifacts/host-observations/ with a SHA256SUMS and re-point this row at them: ",
    host_files as String,
  ], "") as NonEmptyStr }
}

data t10_pair_bench_host_obligation: NonEmptyStr = "h11-new (h11-new.mynetworksettings.com) has no row in gunbc.fleet.fleet_host_identity. Bind it to the HostIdentity of the board it is (gunbc.machine_intake keys the H11SSL units by BMC MAC) before any fleet fold reads this row." as NonEmptyStr

data t10_pair_bench_rows: List<PairBenchRow> = [
  PairBenchRow {
    cards: RtxTwoThousandAdaPair,
    host: FleetHost { host: operator_host_srv3 },
    standing: relayed_standing(host_files: "the srv3 Ada-pair run this column was taken from (its date and files were not named by the relaying session)." as NonEmptyStr),
    c1_aggregate: rate(milli: 31200, p: AsReported),
    c1_decode: rate(milli: 38400, p: AsReported),
    c1_time_to_first_token: ms(count: 1600, p: AsReported),
    c4_aggregate: rate(milli: 58800, p: AsReported),
    c8_aggregate: rate(milli: 74300, p: AsReported),
    long_context_cold_first_turn: NotMeasured,
    long_context_warm_decode: rate_range(low: 36000, high: 38000, p: Approximate),
    long_context_warm_time_to_first_token: ms_range(low: 1900, high: 2300, p: Approximate),
    c4_tokens_per_gpu_joule: tpj(milli: 540, p: AsReported),
    c8_tokens_per_gpu_joule: tpj(milli: 690, p: AsReported),
    pair_power_under_load: bench_point(value: watt(count: 110), precision: Approximate),
    pair_power_cap: Absent,
  },
  // butch's A2s RAN at a 35 W per-card cap when this bench was taken (the operator's 2026-11-10 decision,
  // 35 W each; that decision and its four cap intents were retired on 2026-11-17 when the cards were pulled
  // from butch to be sold -- the wording is kept in the retirement note in
  // gunbc.fleet.fleet_physical_inventory, above gpu_board_07_asset), so the pair drew about its 70 W cap
  // under load. This receipt is DATED HISTORY of that shape; it is not a claim about butch today, and the
  // 2026-11-14 note above this file already says it "has no live host to re-measure against" -- as of
  // 2026-11-17 it has no GPU to re-measure against either.
  PairBenchRow {
    cards: NvidiaA2Pair,
    host: FleetHost { host: operator_host_srv14 },
    standing: relayed_standing(host_files: "the butch (srv14) A2 2x2 server run this column was taken from (its date and files were not named by the relaying session)." as NonEmptyStr),
    c1_aggregate: rate(milli: 18700, p: AsReported),
    c1_decode: rate(milli: 21800, p: AsReported),
    c1_time_to_first_token: ms(count: 2000, p: AsReported),
    c4_aggregate: rate(milli: 33600, p: AsReported),
    c8_aggregate: NotMeasured,
    long_context_cold_first_turn: ms(count: 221000, p: AsReported),
    long_context_warm_decode: rate(milli: 20500, p: Approximate),
    long_context_warm_time_to_first_token: ms_range(low: 2100, high: 2600, p: AsReported),
