    long_context_warm_time_to_first_token: ms_range(low: 3000, high: 3400, p: AsReported),
    c4_tokens_per_gpu_joule: tpj(milli: 300, p: AsReported),
    c8_tokens_per_gpu_joule: tpj(milli: 330, p: AsReported),
