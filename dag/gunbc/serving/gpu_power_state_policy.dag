module gunbc.serving.gpu_power_state_policy

import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.measure {
  Hertz, Watt, TokensPerSecond, hertz, hertz_count, watt, watt_count, tokens_per_second,
  tokens_per_second_count,
}
import std.nat { Nat }
import std.decl_ref { DeclarationRef, decl_ref }
import product.host_identity { HostIdentity, host_identity_eq }
import product.placement_supply { PhysicalAssetIdentity }
import gunbc.fleet.fleet_host_identity {
  operator_host_srv1, operator_host_srv4, operator_host_6ce85c, operator_host_e2d4b7,
}
import gunbc.fleet.fleet_asset_identity {
  gpu_board_01, gpu_board_02, gpu_board_03, gpu_board_04, gpu_board_05, gpu_board_06, gpu_board_11, gpu_board_12, gpu_board_13,
}
import gunbc.fleet.gpu_device_observation {
  GpuDeviceObservation, GpuDeviceEnumerated, GpuDeviceNotEnumerated,
  NvidiaSmiPowerLimit, AmdgpuHwmonPowerCap,
  current_gpu_device_observations_of,
}

// THE DESIRED POWER CAP OF EACH INSTALLED GPU BOARD: gunbc.plans.gpu_card_host_program (deleted 2026-11-08) row N8's home, in its
// first form. N8's finished form selects a cap through std.decision from the installed realization once the
// N7 power sweep exists. That selection does not exist, and the operator has already decided, so the ONE arm
// is the operator's own choice carried as exactly that -- who, when, and what was said. It is durable intent
// now and does not wait for the optimizer; when N8's selection lands it is a second arm of
// GpuPowerCapSelection and the admission below reads whichever arm it is given.
//
// THIS MODULE HOLDS ONLY THE DESIRED SETTING. The vendor specification is extdeps.gpu.*; what the device
// reports (its UUID, PCI function and supported limit range) is gunbc.fleet.gpu_device_observation; the
// applied setting is a readback taken after the writes by gunbc.fleet.gpu_power_cap_converge, and what is
// installed to make the cap survive a boot -- plus what that mechanism claims in its own journal -- is
// gunbc.fleet.gpu_power_cap_boot_state. Admission is the JOIN of the desired setting with the
// current observation, and the intent survives every outcome of that join: a board whose device row has not
// been read keeps its decided cap as a pending admission, it is not dropped and not admitted on hope. srv1
// reached no such arm on 2026-11-08 -- both of its RTX PRO 6000s are read and admitted -- but the arm is the
// policy's protection for a card nobody has observed, so it stays exercised (its witness is a fixture).
//
// THE RANGE IS THE DEVICE'S. nvidia-smi refuses a limit outside the device's reported [min, max], and that
// range is not the vendor's rated board power (the Max-Q is rated 300 W; its device accepts 250-325 W).
// An infeasible cap REFUSES: it is never clamped into range, because a clamp would silently change the
// decision it was asked to realize.
type GpuPowerCapSelection
  = OperatorDeclaredCap { cap: Watt, bounds: CappedPowerQuantity, decided_on: NonEmptyStr, said: NonEmptyStr }

// WHAT A CAP BOUNDS: SUSTAINED DRAW, NEVER PEAK DRAW. The operator's ruling of 2026-11-12, on the R9700's
// 210 W: "we also need to be particular that it's not a peak cap, its a sustained cap". There is deliberately
// NO peak arm. No driver control in the fleet is documented to bound instantaneous draw -- the amdgpu page
// documents power1_cap only as "selected power cap" (extdeps.linux.amdgpu_hwmon PowerCapSettingWindowUnstated)
// -- and on host-6ce85c, under a 210 W power1_cap, 43 of 224 two-second power1_average samples read above
// 210 W, up to 234 W, while the busy mean was 204 W (gunbc.serving.h11_r9700_strata_bench_receipt). So a
// cap is not a bound on what the card can draw from its supply in any instant, and a PSU, cable or connector
// budget reads the board's rated ceiling (extdeps.gpu.types gpu_board_power_ceiling), never a cap.
//
// CappedQuantityUnstated is the honest arm for decisions made before the distinction existed: srv1's
// operators said a number and nothing about its timescale, and that is not rewritten after the fact. (The
// retired srv14/butch A2 decision was of this same shape; its wording is kept in the retirement note in
// gunbc.fleet.fleet_physical_inventory, not as a live selection here.)
type CappedPowerQuantity
  = SustainedPowerDraw
  | CappedQuantityUnstated

fn gpu_power_cap_selected(s: GpuPowerCapSelection) -> Watt {
  match s {
    OperatorDeclaredCap { cap: c, bounds: _, decided_on: _, said: _ } => c
  }
}

fn gpu_power_cap_bounds(s: GpuPowerCapSelection) -> CappedPowerQuantity {
  match s {
    OperatorDeclaredCap { cap: _, bounds: b, decided_on: _, said: _ } => b
  }
}

type InstalledGpuCapIntent {
  host: HostIdentity
  board: PhysicalAssetIdentity
  selection: GpuPowerCapSelection
}

type GpuCapAdmission
  = GpuCapAdmitted { host: HostIdentity, board: PhysicalAssetIdentity, gpu_uuid: NonEmptyStr, cap: Watt }
  | GpuCapOutsideDeviceRange { board: PhysicalAssetIdentity, cap: Watt, minimum: Watt, maximum: Watt }
  | GpuCapDevicePending { board: PhysicalAssetIdentity, cap: Watt, read_obligation: NonEmptyStr }

fn admit_gpu_cap_against(intent: InstalledGpuCapIntent, observation: GpuDeviceObservation?) -> GpuCapAdmission {
  let cap = gpu_power_cap_selected(s: intent.selection)
  match observation {
    Absent => GpuCapDevicePending {
      board: intent.board, cap: cap,
      read_obligation: "no device observation exists for this board: read its GPU UUID, PCI address and power.min_limit/power.max_limit" as NonEmptyStr,
    }
    Present { value: o } => match o {
      GpuDeviceNotEnumerated { host: _, board: _, cause: c, read_on: _ } => GpuCapDevicePending {
        board: intent.board, cap: cap,
        read_obligation: join(["the board does not enumerate (", c as String, "); once it does, read its GPU UUID and power-limit range"], "") as NonEmptyStr,
      }
      GpuDeviceEnumerated { host: _, board: _, gpu_uuid: u, pci_address: _, power_limit_minimum: lo, power_limit_maximum: hi, power_limit_current: _, power_limit_default: _, power_limit_control: k, read_on: _ } =>
        if watt_count(w: cap) < watt_count(w: lo) || watt_count(w: cap) > watt_count(w: hi) {
          GpuCapOutsideDeviceRange { board: intent.board, cap: cap, minimum: lo, maximum: hi }
        } else {
          match k {
            // THE ONE MODELED REALIZATION IS nvidia-smi (gunbc.fleet.gpu_power_cap_converge). An amdgpu device's
            // cap is inside its range and still not admitted: GpuCapAdmitted is what the converge applies and reads
            // back by UUID, and no converge writes power1_cap. It stays pending with that cause rather than being
            // admitted into a realization that would refuse it.
            AmdgpuHwmonPowerCap { attribute: _ } => GpuCapDevicePending {
              board: intent.board, cap: cap,
              read_obligation: "the device's limit is the amdgpu hwmon power1_cap and no modeled converge writes it (gunbc.fleet.gpu_power_cap_converge drives nvidia-smi only); a cap written by hand to power1_cap does not survive a driver reload or a reboot" as NonEmptyStr,
            }
            NvidiaSmiPowerLimit => match u {
              Absent => GpuCapDevicePending {
                board: intent.board, cap: cap,
                read_obligation: "the device enumerates but its GPU UUID was not read; a cap is addressed by UUID, never by an index or slot that can change" as NonEmptyStr,
              }
              Present { value: uuid } => GpuCapAdmitted { host: intent.host, board: intent.board, gpu_uuid: uuid, cap: cap }
            }
          }
        }
    }
  }
}

// One board, one device here: every board that carries a cap intent today is a single-GPU card. A board
// with several devices (the A16) has several observations, and its cap is a per-device decision this
// arm does not make: it refuses rather than applying one board's cap to whichever device came first.
fn admit_gpu_cap(intent: InstalledGpuCapIntent) -> GpuCapAdmission {
  let observed = current_gpu_device_observations_of(board: intent.board)
  if observed.length() > 1 {
    GpuCapDevicePending {
      board: intent.board, cap: gpu_power_cap_selected(s: intent.selection),
      read_obligation: "the board carries several GPU devices; a cap intent must name the device it applies to" as NonEmptyStr,
    }
  } else {
    admit_gpu_cap_against(intent: intent, observation: observed.first())
  }
}

fn gpu_cap_admitted(a: GpuCapAdmission) -> Bool {
  match a {
    GpuCapAdmitted { host: _, board: _, gpu_uuid: _, cap: _ } => true
    GpuCapOutsideDeviceRange { board: _, cap: _, minimum: _, maximum: _ } => false
    GpuCapDevicePending { board: _, cap: _, read_obligation: _ } => false
  }
}

// ── srv1: the operator's decision of 2026-11-07, one value read by both RTX PRO 6000 boards ─────────────

data srv1_pro_6000_cap_decision: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 300),
  bounds: CappedQuantityUnstated,
  decided_on: "2026-11-07" as NonEmptyStr,
  said: "operator: i would just set them both to 300w, the psu is 1600w, we need more sophisticated modeling, but fo rnow i'll just be deciding that manually" as NonEmptyStr,
}

// srv14/butch's A2 cap decision was retired on 2026-11-17 with the cards themselves. It is NOT restated here as
// a GpuPowerCapSelection, because a cap with no card and no serving shape asserts a state of affairs that no
// longer holds, and a declaration nothing consumes is exactly what gunbc.design_argument::consumption refuses.
// What a retired decision still owes is its provenance, and that is what this note is -- RATIONALE, not a
// machine claim: nothing in the corpus reads this text, and no verdict depends on it (gunbc.design_argument::
// source_annotations permits an annotation to hold irreducible rationale for a construction's shape, which is
// all this is). There is no longer a declaration for a marked reference to resolve against, so the operator's words
// are recorded here once, as the citation that made the retirement a fact rather than a guess. Decision of
// 2026-11-10, recorded as OperatorDeclaredCap at 35 W with CappedQuantityUnstated bounds -- the operator said:
// "operator: 2x2 at 35 W per card; two Strata engines each layer-split across two A2s". 35 W was the driver's lowest SETTABLE power
// limit (the 2026-11-10 readings report min 35 / default 60 / max 60 W), kept deliberately distinct from the
// product page's 40-60 W TDP envelope; see the reconciling note above nvidia_a2_board_facts in
// extdeps.gpu.nvidia_a2, which still carries that range independently of the sold cards. The readings themselves
// are typed, not quoted: #gunbc.fleet.gpu_device_observation::retired_gpu_device_observations. The removal
// and the pending sale are typed too:
// #gunbc.fleet.fleet_physical_inventory::butch_a2s_removed_pending_sale.

// host-6ce85c (h11-a16): the operator's 2026-11-12 decision for its Radeon AI PRO R9700s, a SUSTAINED cap at
// 210 W -- the lowest the device's power1_cap accepts (its range reads 210-300 W). The operator wants it lower;
// 210 W is the device's floor, not the operator's target.
data h11_r9700_cap_decision: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 210),
  bounds: SustainedPowerDraw,
  decided_on: "2026-11-12" as NonEmptyStr,
  said: "operator: i'd want 210 but we also need to be particular that it's not a peak cap, its a sustained cap - i actually want to lower it more but 210 is fine for now" as NonEmptyStr,
}

// ken (host-e2d4b7): the 100 W number is the OPERATOR'S, relayed to this project on 2026-11-17 ("ken has two
// GPUs, idle at 43-44 C, with a 100 W power cap applied at boot"). The machine corroborates the number: each
// of the three functions read on the cards 2026-11-18 sits at Current Power Limit 100.00 W against a 150.00 W
// default and a 100.00-150.00 W settable range (artifacts/host-observations/ken-gpu-read-2026-11-18/,
// unit_read3.txt and gpu_identity_query.txt, pinned by SHA256SUMS). What was never said is the TIMESCALE --
// whether 100 W bounds sustained draw or only what the boot script pushes -- and the question was put to the
// operator on 2026-11-17 and unanswered at the head of this change. So the bounds arm is
// CappedQuantityUnstated, the arm this sum provides for a number said without a timescale (see the note above
// CappedPowerQuantity), and it is NOT rewritten to SustainedPowerDraw after the fact. The machine enforces
// the number today with a hand-written unit and script that the converge does not own; that gap is register
// row gunbc.integration_concern::h11ssl_unit3_t10_cap_applied_by_a_unit_the_model_cannot_express, not a
// reason to leave the operator's cap out of the model.
data ken_t10_cap_decision: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 100),
  bounds: CappedQuantityUnstated,
  decided_on: "2026-11-17" as NonEmptyStr,
  said: "two statements agreeing on the number, one relayed and one found on the machine: the operator report relayed by smart-crane-730 on 2026-11-17 ('ken has two GPUs, idle at 43-44 C, with a 100 W power cap applied at boot'), and the header of /usr/local/sbin/t10-power-cap.sh on the unit, which credits the instruction to the operator on 2026-11-15 ('lower their power as low as possible') and implements it as each card's OWN minimum limit -- 100.00 W on all three read functions. The script's authorship is unread: the file does not say who wrote it." as NonEmptyStr,
}

// srv4 (host-srv4): the Adas' cap, which until 2026-11-24 lived only in a hand-edited unit on the host.
// The number descends: the operator held both RTX 2000 Ada cards at 40 W from 2026-10-26 for noise and heat,
// took them to 30 W on 2026-11-24 for power after the surge-protecting strip tripped twice that day, and the
// same day asked for the clock lock beside it -- "lower the cap but also lower the clock rate so it doesn't
// just boost -> throttle". The lock is not a cap and gets no Watt here; the mechanism, its bytes and the
// sweep that chose 210-1500 MHz are gunbc.fleet.gpu_power_cap_boot_state's srv4 row. What this module owns is
// the DECISION and its standing, and its standing is thin in one specific way: the operator gave a number and
// a purpose and never a timescale, so the bounds arm stays CappedQuantityUnstated rather than borrowing
// srv1's sustained-draw ruling (see the note above CappedPowerQuantity). srv3's two cards carry the same
// family of decision on the host and have NO row here: the cards have never been given a physical asset
// identity, so there is nothing for a cap intent to name -- register row
// gunbc.integration_concern::srv3_serving_cards_have_no_identity_to_cap.
data srv4_rtx_2000_ada_cap_decision: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 30),
  bounds: CappedQuantityUnstated,
  decided_on: "2026-11-24" as NonEmptyStr,
  said: "operator, 2026-11-24, on the sweep: \"lower the cap but also lower the clock rate so it doesn't just boost -> throttle\"; and in the unit the operator wrote that day, the history of the number itself: \"operator 2026-10-26 noise/heat at 40 W; lowered to 30 W 2026-11-24 for power after surge-strip trips; matches srv3\". The 30 W was read back off both cards as nvidia-smi power.limit 30.00 W at the 2026-11-24 22:03-22:05 UTC ssh pass, and the sweep that chose the clock lock ran 150 s per level under live serving traffic (clocksweep.sh): 210-1500 MHz averaged 906 MHz at 27.0 W against 869 MHz unlocked at 29.1 W." as NonEmptyStr,
}

data installed_gpu_cap_intents: List<InstalledGpuCapIntent> = [
  InstalledGpuCapIntent { host: operator_host_srv1, board: gpu_board_04, selection: srv1_pro_6000_cap_decision },
  InstalledGpuCapIntent { host: operator_host_srv1, board: gpu_board_01, selection: srv1_pro_6000_cap_decision },
  // srv14/butch had four InstalledGpuCapIntent rows here, each citing one srv14_a2_cap_decision at 35 W. They
  // are GONE: the operator's 2026-11-17 report says all four A2s were physically removed from butch to be sold
  // and that butch is CI only, no serving, so there is no serving shape left to cap and no card to cap. The live
  // a2-power-cap.service that enforced them is residue the operator retired BY HAND on 2026-11-21, outside the
  // converge route (ruling gunbc.design_ruling::butch_serving_retirement_is_operator_handled_2026_11_21) -- it is
  // NOT a reason to keep an intent row nothing can satisfy. The retirement is not a fleet-converge dispatch and is
  // not routed through any butch CI runner lane: butch runs no CI runner lane to route through. The boot-enable
  // receipts for the serving units it reached live typed in
  // gunbc.serving.serving_reservation srv14_serving_unit_boot_states. Where the two retired GPU records live,
  // since neither is restated here: the operator's
  // decision is quoted below this list at its own retirement note, and the 2026-11-10 device readings that
  // admitted it are held TYPED -- unchanged, field for field -- in
  // #gunbc.fleet.gpu_device_observation::retired_gpu_device_observations, which no current-state consumer
  // folds. They are NOT in current_gpu_device_observations: that list is read as present fact by
  // admit_gpu_cap_against and by the converge and boot-state paths, and butch enumerates no A2s today.
  // host-6ce85c: one decision for both R9700s. gpu_board_02 is inside its device's range and PENDING because no
  // converge writes an amdgpu power1_cap (see admit_gpu_cap_against); it was written by hand on 2026-11-12 and is
  // lost at the next reboot. gpu_board_03 does not enumerate, so its cap is pending on the device itself.
  InstalledGpuCapIntent { host: operator_host_6ce85c, board: gpu_board_02, selection: h11_r9700_cap_decision },
  InstalledGpuCapIntent { host: operator_host_6ce85c, board: gpu_board_03, selection: h11_r9700_cap_decision },
  // ken: the operator's cap over all three read functions. Each admits through the driver's own power-limit
  // control (NvidiaSmiPowerLimit, addressed by the GPU UUID the read returned), the same route srv1's Max-Q
  // boards use; the cap sits at the device's own floor, so it is in range on every one of them.
  InstalledGpuCapIntent { host: operator_host_e2d4b7, board: gpu_board_11, selection: ken_t10_cap_decision },
  InstalledGpuCapIntent { host: operator_host_e2d4b7, board: gpu_board_12, selection: ken_t10_cap_decision },
  InstalledGpuCapIntent { host: operator_host_e2d4b7, board: gpu_board_13, selection: ken_t10_cap_decision },
  // srv4's pair, admitted through nvidia-smi's power-limit control like every NVIDIA card here. Neither row
  // admits yet: the 2026-11-07 fleet survey never read the cards' GPU UUIDs, and a cap is addressed by UUID
  // (admit_gpu_cap_against returns GpuCapDevicePending with that obligation). That is the honest state, not a
  // failure of this change -- before it the cards had no decision row at all, and the number lived only in a
  // file on the host.
  InstalledGpuCapIntent { host: operator_host_srv4, board: gpu_board_05, selection: srv4_rtx_2000_ada_cap_decision },
  InstalledGpuCapIntent { host: operator_host_srv4, board: gpu_board_06, selection: srv4_rtx_2000_ada_cap_decision },
]

fn gpu_cap_admissions_on(host: HostIdentity) -> List<GpuCapAdmission> {
  map(filter(installed_gpu_cap_intents, i => host_identity_eq(a: i.host, b: host)), i => admit_gpu_cap(intent: i))
}

// WHAT A CAP MEASURED LIKE ONCE IT WAS ON. The rows above decide a wattage; they say nothing about what the
// decision costs, and a cap decided without its price is a number the operator cannot revise. This is the price
// as the 2026-11-24 pass read it, with the instrument that produced each figure, held separately from the
// decision so that a later pricing model (the power-cap pricing class, B6) can consume it without touching what
// was decided or by whom. It is NOT a pricing model: no cost per token, no comparison across hosts, no claim
// that these windows are comparable -- each is one window's median under live traffic, and the pass's own note
// says the load changed between readings.
type MeasuredCapPrice {
  // The decision whose price this is.
  decision: DeclarationRef
  host: HostIdentity
  // The configuration the figure was taken under, stated as the two ceilings that matter: the card's power limit
  // and the host's CPU ceiling. A tok/s figure without both is not reproducible -- srv4 read 26.5 at 30 W /
  // 2.0 GHz and 24.1 at 30 W / 3.0 GHz, so the CPU ceiling alone changes it.
  card_power_limit: Watt
  // The host's CPU ceiling as a measure, not a bare count of some unit: std.measure owns frequency through
  // Hertz, and the same ceiling travels as Hertz in gunbc.fleet.cpu_freq_cap_boot_state -- so a kHz figure
  // cannot be parked in a MHz slot by spelling.
  cpu_ceiling: Hertz
  // The rate, and what it is a rate of: per conversation, not aggregate.
  decode_per_conversation: TokensPerSecond
  // What the card was doing while it produced that rate.
  card_state: NonEmptyStr
  // How the figure was produced, in the instrument's own terms.
  instrument: NonEmptyStr
  read_on_utc: NonEmptyStr
}

// The four windows the pass read on srv4's RTX 2000 Ada pair. The ladder is the finding: at 30 W the rate fell
// from 39.0 to 26.5-24.1, and going back up to 40 W recovered 28.5-34 -- so the drop belongs to the 30 W card
// cap and not to the 2.0 GHz CPU cap the same pass installed, which is the distinction an operator needs before
// agreeing to keep either. Rates are the engines' own "done: N tokens in T s (R tok/s)" lines averaged per
// window; card state is nvidia-smi clocks.sm, utilization and clocks_throttle_reasons read once a second during
// the same windows. Single windows, not averages over the day: standing
// gunbc.design_argument::epistemic_humility, and the reason this is a price record rather than a rate the
// selector may schedule on (gunbc.serving.serving_replica_profile stays the only place a serving rate is quoted
// as a figure of record).
data srv4_rtx_2000_ada_measured_prices: List<MeasuredCapPrice> = [
  MeasuredCapPrice {
    decision: decl_ref(module_path: "gunbc.serving.gpu_power_state_policy", decl_name: "srv4_rtx_2000_ada_cap_decision"),
    host: operator_host_srv4,
    card_power_limit: watt(count: 40),
    cpu_ceiling: hertz(count: 3000000000),
    decode_per_conversation: tokens_per_second(count: 39),
    card_state: "the pre-cap baseline, 06:00-09:00 UTC; the pair ran uncapped between the 40 W and 30 W edits" as NonEmptyStr,
    instrument: "engine journal \"done: N tokens in T s (R tok/s)\" averaged per conversation-window over ssh" as NonEmptyStr,
    read_on_utc: "2026-11-24T06:00-09:00Z (window)" as NonEmptyStr,
  },
  MeasuredCapPrice {
    decision: decl_ref(module_path: "gunbc.serving.gpu_power_state_policy", decl_name: "srv4_rtx_2000_ada_cap_decision"),
    host: operator_host_srv4,
    card_power_limit: watt(count: 30),
    cpu_ceiling: hertz(count: 2000000000),
    decode_per_conversation: tokens_per_second(count: 27),
    // 26.5 is the figure the pass printed; the row carries the rounded-up whole tok/s the measure admits, and
    // the printed figure travels with it below so nothing is lost to the rounding.
    card_state: "power-cap throttle: SM clock swinging 450-2130 MHz while power.draw sat at the limit" as NonEmptyStr,
    instrument: "engine journal \"done: N tokens in T s (R tok/s)\" averaged per conversation-window over ssh; printed 26.5 tok/s, carried here as the whole number the measure admits" as NonEmptyStr,
    read_on_utc: "2026-11-24, after the ~09:34 UTC cap and the ~22:02 CPU re-enable" as NonEmptyStr,
  },
  MeasuredCapPrice {
    decision: decl_ref(module_path: "gunbc.serving.gpu_power_state_policy", decl_name: "srv4_rtx_2000_ada_cap_decision"),
    host: operator_host_srv4,
    card_power_limit: watt(count: 30),
    cpu_ceiling: hertz(count: 3000000000),
    decode_per_conversation: tokens_per_second(count: 24),
    card_state: "power-cap throttle at 30 W with the CPU uncapped, which is the reading that separates the two caps: removing the CPU ceiling did not recover the rate" as NonEmptyStr,
    instrument: "engine journal \"done: N tokens in T s (R tok/s)\" averaged per conversation-window over ssh; printed 24.1 tok/s" as NonEmptyStr,
    read_on_utc: "2026-11-24, between the cap edits" as NonEmptyStr,
  },
  MeasuredCapPrice {
    decision: decl_ref(module_path: "gunbc.serving.gpu_power_state_policy", decl_name: "srv4_rtx_2000_ada_cap_decision"),
    host: operator_host_srv4,
    card_power_limit: watt(count: 40),
    cpu_ceiling: hertz(count: 2000000000),
    // The 28.5-34 band, carried at its low end so a consumer cannot under-price the recovery it is reading.
    decode_per_conversation: tokens_per_second(count: 29),
    card_state: "back at 40 W: the recovered band is 28.5-34 tok/s per conversation, and the pass read it as the evidence that the 30 W cap, not the CPU cap, caused the drop" as NonEmptyStr,
    instrument: "engine journal \"done: N tokens in T s (R tok/s)\" averaged per conversation-window over ssh; printed band 28.5-34" as NonEmptyStr,
    read_on_utc: "2026-11-24, after the ~19:24 UTC raise (before the ~22:02 return to 30 W)" as NonEmptyStr,
  },
]

// The price rows are only evidence if every one of them states the two ceilings it was taken under and the
// instrument that produced it -- a tok/s figure without its ceilings is not reproducible, and one without its
// instrument is a transcribed number of unknown origin.
fn every_measured_cap_price_states_its_configuration() -> Bool {
  fold(srv4_rtx_2000_ada_measured_prices, init: true, f: (ok, p) =>
    ok && hertz_count(h: p.cpu_ceiling) > 0
      && (p.instrument as String) != ""
      && (p.card_state as String) != ""
      && (p.read_on_utc as String) != ""
      && tokens_per_second_count(r: p.decode_per_conversation) > 0)
}

// THE THROTTLE THE CAP PRODUCED, as the same pass read it on both Adas' hosts. Recorded here because it is the
// cap's effect, not a separate device fact: what nvidia-smi reports while the cap is in force.
data srv3_rtx_2000_ada_throttle_reading: NonEmptyStr = "srv3, 2026-11-24 pass, both cards at a 30.00 W limit: GPU0 read SM clock 210 MHz at 100% utilization -- a power-cap throttle, the clock pinned at the bottom of its range while the card was fully busy -- and the pair's range under load was 210-990 MHz. nvidia-smi clocks.sm / utilization / clocks_throttle_reasons over ssh, once a second during the measurement windows; single readings, not averages (gunbc.design_argument::epistemic_humility)."
