module gunbc.serving.gpu_power_state_policy

import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.measure { Watt, watt, watt_count }
import product.host_identity { HostIdentity, host_identity_eq }
import product.placement_supply { PhysicalAssetIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv14, operator_host_6ce85c }
import gunbc.fleet.fleet_asset_identity { gpu_board_01, gpu_board_02, gpu_board_04, gpu_board_07, gpu_board_08, gpu_board_09, gpu_board_10 }
import gunbc.fleet.gpu_device_observation {
  GpuDeviceObservation, GpuDeviceEnumerated, GpuDeviceNotEnumerated,
  NvidiaSmiPowerLimit, AmdgpuHwmonPowerCap,
  current_gpu_device_observations_of,
}

// THE DESIRED POWER CAP OF EACH INSTALLED GPU BOARD: gunbc.plans.gpu_card_host_program (deleted 2026-11-08) row N8's home, in its
// first form. N8's finished form selects a cap through std.decision from the installed realization once the
// N7 power sweep exists. That selection does not exist, and the operator has already decided, so the ONE arm
// is the operator's own choice carried as exactly that -- who, when, and what was said. It is durable intent
// now and does not wait for the optimizer; when N8's selection lands it is a second arm of
// GpuPowerCapSelection and the admission below reads whichever arm it is given.
//
// THIS MODULE HOLDS ONLY THE DESIRED SETTING. The vendor specification is extdeps.gpu.*; what the device
// reports (its UUID, PCI function and supported limit range) is gunbc.fleet.gpu_device_observation; the
// applied setting is a readback taken after the writes by gunbc.fleet.gpu_power_cap_converge, and what is
// installed to make the cap survive a boot -- plus what that mechanism claims in its own journal -- is
// gunbc.fleet.gpu_power_cap_boot_state. Admission is the JOIN of the desired setting with the
// current observation, and the intent survives every outcome of that join: a board whose device row has not
// been read keeps its decided cap as a pending admission, it is not dropped and not admitted on hope. srv1
// reached no such arm on 2026-11-08 -- both of its RTX PRO 6000s are read and admitted -- but the arm is the
// policy's protection for a card nobody has observed, so it stays exercised (its witness is a fixture).
//
// THE RANGE IS THE DEVICE'S. nvidia-smi refuses a limit outside the device's reported [min, max], and that
// range is not the vendor's rated board power (the Max-Q is rated 300 W; its device accepts 250-325 W).
// An infeasible cap REFUSES: it is never clamped into range, because a clamp would silently change the
// decision it was asked to realize.
type GpuPowerCapSelection
  = OperatorDeclaredCap { cap: Watt, bounds: CappedPowerQuantity, decided_on: NonEmptyStr, said: NonEmptyStr }

// WHAT A CAP BOUNDS: SUSTAINED DRAW, NEVER PEAK DRAW. The operator's ruling of 2026-11-12, on the R9700's
// 210 W: "we also need to be particular that it's not a peak cap, its a sustained cap". There is deliberately
// NO peak arm. No driver control in the fleet is documented to bound instantaneous draw -- the amdgpu page
// documents power1_cap only as "selected power cap" (extdeps.linux.amdgpu_hwmon PowerCapSettingWindowUnstated)
// -- and on host-6ce85c, under a 210 W power1_cap, 43 of 224 two-second power1_average samples read above
// 210 W, up to 234 W, while the busy mean was 204 W (gunbc.serving.h11_r9700_strata_bench_receipt). So a
// cap is not a bound on what the card can draw from its supply in any instant, and a PSU, cable or connector
// budget reads the board's rated ceiling (extdeps.gpu.types gpu_board_power_ceiling), never a cap.
//
// CappedQuantityUnstated is the honest arm for decisions made before the distinction existed: srv1's and
// srv14's operators said a number and nothing about its timescale, and that is not rewritten after the fact.
type CappedPowerQuantity
  = SustainedPowerDraw
  | CappedQuantityUnstated

fn gpu_power_cap_selected(s: GpuPowerCapSelection) -> Watt {
  match s {
    OperatorDeclaredCap { cap: c, bounds: _, decided_on: _, said: _ } => c
  }
}

fn gpu_power_cap_bounds(s: GpuPowerCapSelection) -> CappedPowerQuantity {
  match s {
    OperatorDeclaredCap { cap: _, bounds: b, decided_on: _, said: _ } => b
  }
}

type InstalledGpuCapIntent {
  host: HostIdentity
  board: PhysicalAssetIdentity
  selection: GpuPowerCapSelection
}

type GpuCapAdmission
  = GpuCapAdmitted { host: HostIdentity, board: PhysicalAssetIdentity, gpu_uuid: NonEmptyStr, cap: Watt }
  | GpuCapOutsideDeviceRange { board: PhysicalAssetIdentity, cap: Watt, minimum: Watt, maximum: Watt }
  | GpuCapDevicePending { board: PhysicalAssetIdentity, cap: Watt, read_obligation: NonEmptyStr }

fn admit_gpu_cap_against(intent: InstalledGpuCapIntent, observation: GpuDeviceObservation?) -> GpuCapAdmission {
  let cap = gpu_power_cap_selected(s: intent.selection)
  match observation {
    Absent => GpuCapDevicePending {
      board: intent.board, cap: cap,
      read_obligation: "no device observation exists for this board: read its GPU UUID, PCI address and power.min_limit/power.max_limit" as NonEmptyStr,
    }
    Present { value: o } => match o {
      GpuDeviceNotEnumerated { host: _, board: _, cause: c, read_on: _ } => GpuCapDevicePending {
        board: intent.board, cap: cap,
        read_obligation: join(["the board does not enumerate (", c as String, "); once it does, read its GPU UUID and power-limit range"], "") as NonEmptyStr,
      }
      GpuDeviceEnumerated { host: _, board: _, gpu_uuid: u, pci_address: _, power_limit_minimum: lo, power_limit_maximum: hi, power_limit_current: _, power_limit_default: _, power_limit_control: k, read_on: _ } =>
        if watt_count(w: cap) < watt_count(w: lo) || watt_count(w: cap) > watt_count(w: hi) {
          GpuCapOutsideDeviceRange { board: intent.board, cap: cap, minimum: lo, maximum: hi }
        } else {
          match k {
            // THE ONE MODELED REALIZATION IS nvidia-smi (gunbc.fleet.gpu_power_cap_converge). An amdgpu device's
            // cap is inside its range and still not admitted: GpuCapAdmitted is what the converge applies and reads
            // back by UUID, and no converge writes power1_cap. It stays pending with that cause rather than being
            // admitted into a realization that would refuse it.
            AmdgpuHwmonPowerCap { attribute: _ } => GpuCapDevicePending {
              board: intent.board, cap: cap,
              read_obligation: "the device's limit is the amdgpu hwmon power1_cap and no modeled converge writes it (gunbc.fleet.gpu_power_cap_converge drives nvidia-smi only); a cap written by hand to power1_cap does not survive a driver reload or a reboot" as NonEmptyStr,
            }
            NvidiaSmiPowerLimit => match u {
              Absent => GpuCapDevicePending {
                board: intent.board, cap: cap,
                read_obligation: "the device enumerates but its GPU UUID was not read; a cap is addressed by UUID, never by an index or slot that can change" as NonEmptyStr,
              }
              Present { value: uuid } => GpuCapAdmitted { host: intent.host, board: intent.board, gpu_uuid: uuid, cap: cap }
            }
          }
        }
    }
  }
}

// One board, one device here: every board that carries a cap intent today is a single-GPU card. A board
// with several devices (the A16) has several observations, and its cap is a per-device decision this
// arm does not make: it refuses rather than applying one board's cap to whichever device came first.
fn admit_gpu_cap(intent: InstalledGpuCapIntent) -> GpuCapAdmission {
  let observed = current_gpu_device_observations_of(board: intent.board)
  if observed.length() > 1 {
    GpuCapDevicePending {
      board: intent.board, cap: gpu_power_cap_selected(s: intent.selection),
      read_obligation: "the board carries several GPU devices; a cap intent must name the device it applies to" as NonEmptyStr,
    }
  } else {
    admit_gpu_cap_against(intent: intent, observation: observed.first())
  }
}

fn gpu_cap_admitted(a: GpuCapAdmission) -> Bool {
  match a {
    GpuCapAdmitted { host: _, board: _, gpu_uuid: _, cap: _ } => true
    GpuCapOutsideDeviceRange { board: _, cap: _, minimum: _, maximum: _ } => false
    GpuCapDevicePending { board: _, cap: _, read_obligation: _ } => false
  }
}

// ── srv1: the operator's decision of 2026-11-07, one value read by both RTX PRO 6000 boards ─────────────

data srv1_pro_6000_cap_decision: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 300),
  bounds: CappedQuantityUnstated,
  decided_on: "2026-11-07" as NonEmptyStr,
  said: "operator: i would just set them both to 300w, the psu is 1600w, we need more sophisticated modeling, but fo rnow i'll just be deciding that manually" as NonEmptyStr,
}

// srv14/butch: the operator's 2026-11-10 serving shape caps each A2 at 35 W. 35 W is the driver's lowest
// SETTABLE power limit (observation min 35 / max 60 W), NOT the product page's 40 W TDP minimum -- the two
// quantities are kept distinct; see the reconciling note above nvidia_a2_board_facts in extdeps.gpu.nvidia_a2.
data srv14_a2_cap_decision: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 35),
  bounds: CappedQuantityUnstated,
  decided_on: "2026-11-10" as NonEmptyStr,
  said: "operator: 2x2 at 35 W per card; two Strata engines each layer-split across two A2s" as NonEmptyStr,
}

// host-6ce85c (h11-a16): the operator's 2026-11-12 decision for its Radeon AI PRO R9700, a SUSTAINED cap at
// 210 W -- the lowest the device's power1_cap accepts (its range reads 210-300 W). The operator wants it lower;
// 210 W is the device's floor, not the operator's target.
data h11_r9700_cap_decision: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 210),
  bounds: SustainedPowerDraw,
  decided_on: "2026-11-12" as NonEmptyStr,
  said: "operator: i'd want 210 but we also need to be particular that it's not a peak cap, its a sustained cap - i actually want to lower it more but 210 is fine for now" as NonEmptyStr,
}

data installed_gpu_cap_intents: List<InstalledGpuCapIntent> = [
  InstalledGpuCapIntent { host: operator_host_srv1, board: gpu_board_04, selection: srv1_pro_6000_cap_decision },
  InstalledGpuCapIntent { host: operator_host_srv1, board: gpu_board_01, selection: srv1_pro_6000_cap_decision },
  // srv14/butch: the operator's 2026-11-10 serving shape caps each A2 at 35 W (the driver's settable
  // floor, not the product page's 40 W TDP minimum -- see extdeps.gpu.nvidia_a2). Admitted against the
  // per-device observation, which reads 35 W as butch's min; the live -pl 35 (a2-power-cap.service) matches.
  InstalledGpuCapIntent { host: operator_host_srv14, board: gpu_board_07, selection: srv14_a2_cap_decision },
  InstalledGpuCapIntent { host: operator_host_srv14, board: gpu_board_08, selection: srv14_a2_cap_decision },
  InstalledGpuCapIntent { host: operator_host_srv14, board: gpu_board_09, selection: srv14_a2_cap_decision },
  InstalledGpuCapIntent { host: operator_host_srv14, board: gpu_board_10, selection: srv14_a2_cap_decision },
  // host-6ce85c: inside the device's range, and PENDING because no converge writes an amdgpu power1_cap (see
  // admit_gpu_cap_against). It was written by hand on 2026-11-12 and is lost at the next reboot.
  InstalledGpuCapIntent { host: operator_host_6ce85c, board: gpu_board_02, selection: h11_r9700_cap_decision },
]

fn gpu_cap_admissions_on(host: HostIdentity) -> List<GpuCapAdmission> {
  map(filter(installed_gpu_cap_intents, i => host_identity_eq(a: i.host, b: host)), i => admit_gpu_cap(intent: i))
}
