// The unit file itself was NOT changed by this window, so its digest is recorded to say the change is in
// the helper and the launcher and nowhere else. The unit is unchanged from the read of 2026-11-09.
type Srv1UnitFileState {
  path: NonEmptyStr,
  // the digest `sha256sum` printed ON srv1, not the one this repo believes the file has
  sha256_computed_on_host: NonEmptyStr,
  read_on_utc: NonEmptyStr,
  backup_dir: NonEmptyStr,
  // what the verbs still hand off to; the change lives in what THAT path holds, not in the unit
  exec_verbs_run: NonEmptyStr,
  changed_by_this_window: Bool,
}

data srv1_replica_unit_unchanged_2026_11_09: Srv1UnitFileState = Srv1UnitFileState {
  path: "/etc/systemd/system/lil-replica@.service" as NonEmptyStr,
  sha256_computed_on_host: "1372a94f3ea1c2787566d5f75a7c482d50128e89f3359166f2eafc94fadb336c" as NonEmptyStr,
  read_on_utc: "2026-11-09T18:48:50Z" as NonEmptyStr,
  backup_dir: "/home/briansrls/jh_backups/20261109T184850Z" as NonEmptyStr,
  exec_verbs_run: "/usr/local/sbin/lil-replica start|stop %i" as NonEmptyStr,
  changed_by_this_window: false,
}

// Which run of the boot path a receipt describes. The set is CLOSED on purpose: a cold start and a crash are
// different claims about the boot path (one proves the start path, the other proves systemd's restart), and
// HostReboot is the third case that NOBODY HAS RUN -- naming it in the type is what lets a witness assert that
// no receipt claims it, which prose could not: a free-text kind can say anything, including "reboot".
type Srv1BootPathRunKind
  = ColdStart
  | Crash
  | HostReboot

// The bar these runs were measured against: the engine must be serving within 10 minutes of the unit being
// started (the operator's window brief, step 3 and step 5). Named as a value so the witness compares a
// MEASURED duration against THIS, not against a copy of the number in the test. The crash path's floor is not
// duplicated here: it is the unit's own restart_delay on srv1_replica_unit_contract, which the witness reads.
data srv1_boot_path_ready_deadline: Second = second(600)

// One executed run of the start path or the crash path, with the numbers the scripts measured on the host.
// Durations carry std.measure's time quantity, not a bare count: the measured 46 s and the contract's 30 s
// are the same kind of thing, and a fold that compares them should not have to know which Nat is a duration.
type Srv1BootPathRun {
  replica_index: Nat,
  kind: Srv1BootPathRunKind,
  // How the run was driven, in prose: what was stopped, removed or killed. A note, never a verdict, and never
  // the thing a witness branches on -- that is `kind`.
  note: NonEmptyStr,
  window_start_utc: NonEmptyStr,
  window_end_utc: NonEmptyStr,
  container_created: Second,
  // Time from the stop/kill to the first 200 from /health is NOT a field: it is the difference of this
  // row's own two instants (srv1_boot_path_run_ready_duration below). A row that types it beside the
  // instants can disagree with them, and one of the four runs in this window did -- by 7 s.
  // container_created stays a field: it is an independent stopwatch phase (start -> container created),
  // not a difference of the window's ends, so there is no pair of instants to derive it from.
  restarts_observed: Nat,
  verdict: NonEmptyStr,
}

data srv1_boot_path_runs_executed_2026_11_09: List<Srv1BootPathRun> = [
  Srv1BootPathRun {
    replica_index: 1,
    kind: ColdStart,
    note: "systemctl stop, container removed, systemctl start on the rendered path (NOT a host reboot)" as NonEmptyStr,
    window_start_utc: "2026-11-09T21:51:38Z" as NonEmptyStr,
    window_end_utc: "2026-11-09T21:59:21Z" as NonEmptyStr,
    container_created: second(46),
    restarts_observed: 0,
    verdict: "ready inside the 10-minute deadline; engine argv carries no --api-key (count 0) and the engine's environment carries VLLM_API_KEY (count 1); router upstream srv1-vllm-1 served six /v1/chat/completions probes at 200 with zero new 502s" as NonEmptyStr,
  },
  Srv1BootPathRun {
    replica_index: 1,
    kind: Crash,
    note: "docker kill the container while the replica was serving; systemd Restart=on-failure with the contract's restart_delay as the floor" as NonEmptyStr,
    window_start_utc: "2026-11-09T22:11:01Z" as NonEmptyStr,
    window_end_utc: "2026-11-09T22:19:33Z" as NonEmptyStr,
    container_created: second(39),
    restarts_observed: 1,
    verdict: "systemd did restart it, but NOT within the 30 s the brief set as the bar: the unit's own RestartSec=30 makes 30 s the FLOOR, and the measured replacement container appeared 39 s after the kill (22:11:39Z, written by the rendered launcher's own START event). Engine ready 512 s. Auth held: 401 without the key, 200 with it. No --api-key in .Config.Cmd; VLLM_API_KEY present in the engine environment." as NonEmptyStr,
  },
  Srv1BootPathRun {
    replica_index: 0,
    kind: ColdStart,
    note: "systemctl stop, container removed, systemctl start on the rendered path (NOT a host reboot)" as NonEmptyStr,
    window_start_utc: "2026-11-09T22:24:35Z" as NonEmptyStr,
    window_end_utc: "2026-11-09T22:31:38Z" as NonEmptyStr,
    container_created: second(46),
    restarts_observed: 0,
    verdict: "ready inside the deadline; `ps` on the host shows zero processes carrying --api-key once both replicas are on this path (previously the engine's own argv named the key)" as NonEmptyStr,
  },
  Srv1BootPathRun {
    replica_index: 0,
    kind: Crash,
    note: "docker kill the container while the replica was serving; systemd Restart=on-failure with the contract's restart_delay as the floor" as NonEmptyStr,
    window_start_utc: "2026-11-09T22:32:21Z" as NonEmptyStr,
    window_end_utc: "2026-11-09T22:39:23Z" as NonEmptyStr,
    container_created: second(38),
    restarts_observed: 1,
    verdict: "replacement container 38 s after the kill (again above the 30 s bar, which the unit's RestartSec=30 sets); engine ready 422 s; auth held (401 without key, 200 with); no --api-key in .Config.Cmd" as NonEmptyStr,
  },
]

// Readiness is computed from the row's own instants, not transcribed beside them: the same ISO 8601 calendar
// the fleet module reads its NCCL spans through, so one pair of instants cannot mean two different durations
// in two rows. It answers Absent when a row names instants that do not parse or come out reversed, which is
// how a mistyped instant surfaces -- as a claim that refuses to resolve, not as a plausible number.
// The r1 crash row is the proof this was worth having: its kill instant had been transcribed 7 s late
// (22:11:08Z where the host recorded 22:11:01Z, epoch 1794262261), and the hand-typed ready duration agreed
// with the WRONG instant. Deriving it from the pair exposes the disagreement instead of hiding it.
fn srv1_boot_path_run_ready_duration(run: Srv1BootPathRun) -> Second? {
  srv1_window_seconds_between(earlier: run.window_start_utc, later: run.window_end_utc)
}


// What a reader may ask of a run receipt, phrased in the module that owns the closed set rather than in the
// test that asks it: a witness in another module branches on these, and never has to name a member.
fn srv1_boot_path_run_is_cold_start(run: Srv1BootPathRun) -> Bool { run.kind == ColdStart }
fn srv1_boot_path_run_is_crash(run: Srv1BootPathRun) -> Bool { run.kind == Crash }
// The case nobody has run. A witness asserts NO receipt has this kind; a free-text kind could not be checked
// this way, which is the reason the set is closed.
fn srv1_boot_path_run_claims_reboot(run: Srv1BootPathRun) -> Bool { run.kind == HostReboot }

// The two bars these runs are judged against, read from where they are DEFINED -- the operator's readiness bar
// above, and the unit's own restart_delay on the contract row. A test that copies 600 and 30 keeps passing
// after either one changes.
fn srv1_boot_path_ready_deadline_seconds() -> Nat { second_count(srv1_boot_path_ready_deadline) }
fn srv1_boot_path_crash_restart_floor_seconds() -> Nat { second_count(srv1_replica_unit_contract.restart_delay) }

// The disruption the window cost, counted from the router's own counters rather than estimated. The counters
// are cumulative since the router started, so the cost is a difference between two snapshots taken on srv1.
// The window is every action taken against the serving replicas on 2026-11-09: the first (failed) switch
// attempt, the two cold-start switches, the two crash tests and the NCCL re-run with both replicas stopped.
// The disruption the window cost, with the counters as FIELDS: the router's counters are cumulative, so the
// cost is a difference, and the phase and upstream breakdowns must ADD UP to that difference. In prose those
// numbers could drift apart silently; here a witness can check the arithmetic.
type Srv1RouterWindowCount {
  snapshot_from_utc: NonEmptyStr,
  status_502_before: Nat,
  status_502_after: Nat,
  status_200_before: Nat,
  status_200_after: Nat,
  // the closed set of actions this window took against the serving path; their sum is the difference above
  failed_first_attempt_502: Nat,
  replica1_switch_502: Nat,
  replica1_crash_502: Nat,
  replica0_switch_502: Nat,
  replica0_crash_502: Nat,
  nccl_window_502: Nat,
  // the two upstreams this window touched, and what everything ELSE on the router contributed
  upstream_srv1_vllm_502_added: Nat,
  upstream_srv1_vllm_1_502_added: Nat,
  other_upstreams_502_added: Nat,
  nccl_window: Second?,
  nccl_measurement: Second?,
  note: NonEmptyStr,
}

data srv1_boot_path_window_router_counting_2026_11_09: Srv1RouterWindowCount = Srv1RouterWindowCount {
  snapshot_from_utc: "2026-11-09T20:38:24Z" as NonEmptyStr,
  status_502_before: 13,
  status_502_after: 64,
  status_200_before: 27150,
  status_200_after: 29727,
  failed_first_attempt_502: 7,
  replica1_switch_502: 4,
  replica1_crash_502: 2,
  replica0_switch_502: 4,
  replica0_crash_502: 6,
  nccl_window_502: 28,
  upstream_srv1_vllm_502_added: 24,
  upstream_srv1_vllm_1_502_added: 24,
  other_upstreams_502_added: 3,
  nccl_window: srv1_collective_read_window_duration(run: srv1_collective_read_executed_2026_11_09),
  nccl_measurement: srv1_collective_read_measurement_duration(run: srv1_collective_read_executed_2026_11_09),
  note: "status:200 over the same span went 27150 -> 29727, so every 502 is a slice of real traffic, not a dry run. The NCCL window is the honest bulk of it: stopping both replicas is what the unloaded re-run required, and no rollback protects against that." as NonEmptyStr,
}

// The outage this window cost, as fields rather than a paragraph: which unit, how long, what it exited with,
// what the unit decided, and what was changed so the same recovery is not manual next time. A `no downtime`
// claim cannot be made about this row by accident, and the downtime is a duration, not a number in prose.
type Srv1BootPathIncident {
  replica_index: Nat,
  down_from_utc: NonEmptyStr,
  down_to_utc: NonEmptyStr,
  downtime: Second,
  failed_starts: Nat,
  container_exit_status: Nat,
  unit_outcome: NonEmptyStr,
  cause: NonEmptyStr,
  recovery: NonEmptyStr,
  repair: NonEmptyStr,
}

data srv1_boot_path_incident_2026_11_09: Srv1BootPathIncident = Srv1BootPathIncident {
  replica_index: 1,
  down_from_utc: "2026-11-09T21:04:54Z" as NonEmptyStr,
  down_to_utc: "2026-11-09T21:17:30Z" as NonEmptyStr,
  downtime: second(756),
  failed_starts: 4,
  container_exit_status: 2,
  unit_outcome: "lil-replica@1 exhausted its restart burst (Start request repeated too quickly after 5 attempts; StartLimitBurst=3 inside StartLimitIntervalSec=3600) and the unit entered failed" as NonEmptyStr,
  cause: "the rendered container command carried one unmatched ) : the args-file refusal had been CONCATENATED onto the end of the captured START line, so the container's bash -lc exited 2 within a second of starting, four times. The witness that was supposed to catch it asked only whether each captured line appeared INSIDE the rendered line, which an appended token cannot be caught by -- see a_control_that_shares_its_derivation_with_its_subject, SPECIMEN THREE." as NonEmptyStr,
  recovery: "manual: restore the backed-up helper, systemctl daemon-reload, systemctl reset-failed, start the old path" as NonEmptyStr,
  repair: "the switch script now rolls itself back on any failure inside the deadline (reinstall the backup, reset the counter, start the old path, report the total outage), and the containment control was replaced with whole-LINE equality plus two gates that do not travel through this module's own representation: the serving image's bash parses the emitted command, and a dry run of it must yield the argv docker inspect reported before the switch." as NonEmptyStr,
}

// The window's counter row has to ADD UP. The phase fields are the closed set of actions this window took
// against the serving path, and the two upstreams it touched plus everything else on the router must account
// for the same difference between the two snapshots. Written without subtraction on Nats: a partial sum plus
// the before-count must equal the after-count, so a row whose parts drift from its totals goes red instead of
// reading as a plausible paragraph.
fn srv1_router_window_count_balances(record: Srv1RouterWindowCount) -> Bool {
  record.status_502_before
      + record.failed_first_attempt_502 + record.replica1_switch_502 + record.replica1_crash_502
      + record.replica0_switch_502 + record.replica0_crash_502 + record.nccl_window_502
    == record.status_502_after
    && record.status_502_before
      + record.upstream_srv1_vllm_502_added + record.upstream_srv1_vllm_1_502_added + record.other_upstreams_502_added
    == record.status_502_after
    && record.status_200_after > record.status_200_before
}

// What a witness cannot see, said plainly: no host reboot has been run, so the boot path is executed but
// not shown to survive a boot. The unit's enablement (systemctl is-enabled = enabled, read 2026-11-09) is
// the only evidence about boot, and enablement is not durability.

// ── what this module does NOT model, keyed ─────────────────────────────────────────────────────────

