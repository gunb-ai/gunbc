// ── fleet boot-survival audit (D20, read-only observations) ────────────────────────────────
//
// Durability's sibling question: do the NEIGHBOURING services that share these hosts survive a
// reboot? Observed read-only 2026-11-09 via `systemctl is-enabled` (srv1 direct; srv2/srv3/srv4
// through the fleet key) — no host touched; findings are reported, and fixes land only in .dag per
// the lane's brief. The verdict vocabulary keeps UNKNOWN honest: an unreadable host is Unreadable,
// never a fabricated EnabledAtBoot.

// The boot verdict vocabulary. `UserScopeUnit` and `UserScopeUnitWithLinger` are SEPARATE verdicts
// because they answer different questions, and collapsing them is what mislabelled srv2's vast pool:
// a user-scope unit starts when the user's manager (user@<uid>.service) starts, and linger is what
// makes that manager start at boot with nobody logged in. So "user-scope" alone does not entail
// "down until someone logs in" -- it is only true where linger is off. Naming the two scales keeps
// the honest verdict readable without renaming a genuine boot failure as a success (the same
// two-scale discipline std.measure applies to Percent vs BasisPoint).
type Srv1BootSurvival
  = EnabledAtBoot
  | UserScopeUnit
  | UserScopeUnitWithLinger
  | RestartUnlessStopped
  | NotInstalled
  | Unreadable

type BootSurvivalObservation {
  host: NonEmptyStr
  unit: NonEmptyStr
  verdict: Srv1BootSurvival
  evidence: NonEmptyStr
}

fn srv1_boot_survival_eq(a: Srv1BootSurvival, b: Srv1BootSurvival) -> Bool {
  match a {
    EnabledAtBoot => match b { EnabledAtBoot => true, _ => false }
    UserScopeUnit => match b { UserScopeUnit => true, _ => false }
    UserScopeUnitWithLinger => match b { UserScopeUnitWithLinger => true, _ => false }
    RestartUnlessStopped => match b { RestartUnlessStopped => true, _ => false }
    NotInstalled => match b { NotInstalled => true, _ => false }
    Unreadable => match b { Unreadable => true, _ => false }
  }
}

// Consumers ask the question instead of naming constructors (constructors are module-internal).
fn srv1_boot_survival_verdict_is(o: BootSurvivalObservation, v: Srv1BootSurvival) -> Bool {
  srv1_boot_survival_eq(a: o.verdict, b: v)
}

fn srv1_audit_entry_is_unreadable(o: BootSurvivalObservation) -> Bool { srv1_boot_survival_eq(a: o.verdict, b: Unreadable) }
fn srv1_audit_entry_is_enabled_at_boot(o: BootSurvivalObservation) -> Bool { srv1_boot_survival_eq(a: o.verdict, b: EnabledAtBoot) }
fn srv1_audit_entry_is_user_scope(o: BootSurvivalObservation) -> Bool { srv1_boot_survival_eq(a: o.verdict, b: UserScopeUnit) }
fn srv1_audit_entry_is_user_scope_with_linger(o: BootSurvivalObservation) -> Bool { srv1_boot_survival_eq(a: o.verdict, b: UserScopeUnitWithLinger) }
fn srv1_audit_entry_is_restart_unless_stopped(o: BootSurvivalObservation) -> Bool { srv1_boot_survival_eq(a: o.verdict, b: RestartUnlessStopped) }

data srv1_fleet_boot_survival_audit: List<BootSurvivalObservation> = [
  BootSurvivalObservation { host: "srv1" as NonEmptyStr, unit: "lil-replica@0.service" as NonEmptyStr, verdict: EnabledAtBoot, evidence: "systemctl is-enabled = enabled, read on srv1 2026-11-09. SEPARATELY, and NOT the same claim: the START path on this instance was EXECUTED the same day -- cold start 2026-11-09T22:24:35Z..22:31:38Z (container created 46 s, engine ready 423 s) and a crash 22:32:21Z (replacement container 38 s, ready 422 s). A host reboot has NOT been executed, so boot-time creation of the container by the unit remains unobserved." as NonEmptyStr, },
  BootSurvivalObservation { host: "srv1" as NonEmptyStr, unit: "lil-replica@1.service" as NonEmptyStr, verdict: EnabledAtBoot, evidence: "systemctl is-enabled = enabled, read on srv1 2026-11-09; start path EXECUTED 2026-11-09 (cold start 21:51:38Z..21:59:21Z, container 46 s, ready 463 s; crash 22:11:08Z, replacement 39 s, ready 512 s); host reboot NOT executed. The failed first attempt here (21:04:54Z..21:17:30Z, four exit-2 starts, then 'Start request repeated too quickly') is the unit's StartLimitBurst=3 per 3600 s actually biting -- a property the model carried only as a number." as NonEmptyStr, },
  BootSurvivalObservation { host: "srv3", unit: "strata-pool.service", verdict: EnabledAtBoot, evidence: "systemctl is-enabled reports enabled (2026-11-09)" },
  BootSurvivalObservation { host: "srv4", unit: "gunbc-srv4-daily-engine.service", verdict: EnabledAtBoot, evidence: "systemctl is-enabled reports enabled (2026-11-09)" },
  BootSurvivalObservation { host: "srv4", unit: "gunbc-srv4-tls.service", verdict: EnabledAtBoot, evidence: "systemctl is-enabled reports enabled (2026-11-09)" },
  // CORRECTED 2026-11-09. The row previously read UserScopeUnit with the evidence "a reboot with no
  // logged-in user leaves the vast pool down until the user session starts". That evidence was wrong:
  // it asserted the consequence of a user-scope unit WITHOUT considering linger, and srv1's briansrls
  // has linger enabled. Read on srv1 as briansrls 2026-11-09: `systemctl --user is-enabled
  // session-dashboard.service` = enabled; the :3737 listener's cgroup (pid of `node server.mjs`) is
  // /user.slice/user-1000.slice/user@1000.service/app.slice/session-dashboard.service — a USER unit of
  // briansrls, not a system unit; and `loginctl show-user briansrls --property=Linger` = Linger=yes
  // (/var/lib/systemd/linger/briansrls exists). Linger starts user@1000 at boot with no login, and the
  // unit is enabled in the user scope with WantedBy=default.target, so it starts then. The pool is NOT
  // down until a login; the old evidence said it was.
  BootSurvivalObservation { host: "srv2", unit: "ctrl-vast-pool (tcp :3737)", verdict: UserScopeUnitWithLinger, evidence: "served by session-dashboard.service, a USER unit of briansrls (FragmentPath ~/.config/systemd/user/session-dashboard.service, WantedBy=default.target, systemctl --user is-enabled = enabled); briansrls has Linger=yes on srv2 (loginctl show-user, /var/lib/systemd/linger/briansrls, read 2026-11-09), so user@1000 starts at boot and the unit starts WITHOUT a login. Not a system unit, but it does survive a reboot." },
  BootSurvivalObservation { host: "h11-05", unit: "not read (ssh refused the fleet key from srv1)", verdict: Unreadable, evidence: "2026-11-09: no verdict; must NOT be reported as healthy" },
  BootSurvivalObservation { host: "h11-07", unit: "not read (ssh refused the fleet key from srv1)", verdict: Unreadable, evidence: "2026-11-09: no verdict; must NOT be reported as healthy" },
  BootSurvivalObservation { host: "h11-08", unit: "not read (ssh refused the fleet key from srv1)", verdict: Unreadable, evidence: "2026-11-09: no verdict; must NOT be reported as healthy" },
  BootSurvivalObservation { host: "h11-88", unit: "not read (ssh refused the fleet key from srv1)", verdict: Unreadable, evidence: "2026-11-09: no verdict; must NOT be reported as healthy" },
  BootSurvivalObservation { host: "srv1", unit: "gunbc-router", verdict: RestartUnlessStopped, evidence: "docker restart policy unless-stopped: survives dockerd restart and boot; the brief records this as fine" },
  // CORRECTED 2026-11-09 for the same reason as srv2's row: srv1's briansrls has Linger=yes (read on
  // srv1 with `loginctl show-user briansrls --property=Linger`; /var/lib/systemd/linger/briansrls
  // exists alongside ghrunner's), so this user unit also starts at boot without a login. It was filed
  // under UserScopeUnit only because the brief called user scope "fine"; the verdict now says what is
  // actually observed, so a reader cannot infer "down until login" from it.
  BootSurvivalObservation { host: "srv1", unit: "session-dashboard", verdict: UserScopeUnitWithLinger, evidence: "user-scope unit by design, and briansrls has Linger=yes on srv1 (loginctl show-user, read 2026-11-09), so it starts at boot without a login" },
]

// ── srv1 test-only artifacts (F27) ─────────────────────────────────────────────────────────
//
// lil's image contract (launcher.py + image-contract.json, mounted into the container) hashes the
// runtime it ships; these six host paths are the TEST-ONLY extras that accumulated under ~/lil during
// the two-replica work and belong to no module. NONE is deleted: adoption into the repo or an explicit
// operator deletion is the only ending (deleting without asking is the failure mode this row exists to
// prevent). nccl_test.py may be consumed by lane A (its nccl_probe.py rides #16116) — a deletion would
