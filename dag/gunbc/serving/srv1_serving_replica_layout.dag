]

data srv1_test_only_artifacts_frontier: FrontierRow = frontier_row_decl(
  ref: decl_ref(module_path: "gunbc.serving.srv1_serving_replica_layout", decl_name: "srv1_test_only_artifacts"),
  reason: "six test-only artifacts sit on srv1 under ~/lil owned by no module: no receipt pins their bytes, no witness reads them, and any of them could be deleted or edited unnoticed. Each must either be adopted into the repo as a hash-pinned receipt owned by a module, or deleted by an explicit operator decision. nccl_test.py additionally may be consumed by lane A (nccl_probe.py on #16116), so its disposition needs lane A's input too.",
  dissolution: unbound_dissolution(description: "every member of srv1_test_only_artifacts has a disposition: a repo module owns an adopted, hash-pinned copy, or the operator recorded a deletion. SUFFICIENT when the inventory is empty with a recorded disposition per member."),
