// A CAP THE AVERAGE EXCEEDS IS NOT A PEAK BOUND. True for a sampled run when the sampler read an AVERAGE draw
// (so an excursion is not a single-instant spike the attribute could not see), the cap in force was read, and some
// sample is above it. gunbc.serving.gpu_power_state_policy CappedPowerQuantity rests on this reading.
fn r9700_run_shows_cap_is_not_a_peak_bound(r: R9700BenchRun) -> Bool {
  match r.power {
    Absent => false
    Present { value: p } => match r.cap {
      CapNotRecorded => false
      CapReadByOperator { cap: _ } =>
        p.samples_above_cap > 0
          && match amdgpu_hwmon_power_quantity(a: p.attribute) { AveragePowerDraw => true  _ => false }
    }
  }
}

// THE BUSY MEAN STAYS WITHIN THE CAP: what a sustained cap promises, on this one run.
fn r9700_run_busy_mean_within_cap(r: R9700BenchRun) -> Bool {
  match r.power {
    Absent => false
    Present { value: p } => match r.cap {
      CapNotRecorded => false
      CapReadByOperator { cap: c } => watt_count(w: p.busy_power_mean) <= watt_count(w: c)
    }
  }
}

data h11_r9700_bench_receipt_frontier: DissolutionCondition = unbound_dissolution(
  description: "gunbc.design_argument::consumption: read today by test.claim.serving.h11_r9700_strata_bench_receipt_witness (the cap is a sustained, not a peak, bound; no follow-up turn reused a prefix). TRIGGER: the h11 serving-layout rework (gunbc.serving.serving_layout host_6ce85c rows, gunbc.serving.router_dev_policy router_dev_h11_namings) replaces the A16 profile with an R9700 one and reads its per-replica figures from a receipt; until then these rows are evidence for the cap decision only." as NonEmptyStr
)
