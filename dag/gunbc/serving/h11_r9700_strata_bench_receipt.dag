module gunbc.serving.h11_r9700_strata_bench_receipt

import std.types { Bool, List, NonEmptyStr }
import std.nat { Nat }
import std.optional { Present, Absent }
import std.measure {
  Watt, watt, watt_count, Celsius, celsius, Millisecond, millisecond, MilliTokensPerSecond, milli_tokens_per_second,
  TokenCount, token_count,
}
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.linux.amdgpu_hwmon {
  AmdgpuHwmonPowerAttribute, Power1Average, AveragePowerDraw, amdgpu_hwmon_power_quantity,
}
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_6ce85c }

// FOUR STRATA RUNS ON host-6ce85c's ONE RADEON AI PRO R9700, 2026-11-12: what the committed files say, typed.
//
// THE FILES ARE THE AUTHORITY, this module transcribes them: artifacts/host-observations/h11-r9700-2026-11-12/,
// every file pinned in its SHA256SUMS, each run's rows by the digest carried on its row below. The producer is
// strata_bench.py (committed beside the rows, sha256 36f3e6b4...) in --mode multiwarm: 4 agents, a 32000-token
// context, a 64-token first turn per agent, then two concurrent follow-up turns of 512 tokens each per agent.
// Strata is the HIP build (backend hip, TheRock gfx120X wheels) serving IQ3_S with the config in
// strata-iq3_s.json. The exact bench command line was not recorded.
//
// WHY NOT gunbc.serving.serving_benchmark_run_receipt. That receipt admits gpu-bench request/v4 rows only
// (extdeps.gpu_bench.request_v4), and these are strata_bench.py summary rows, one per agent or per turn, with no
// per-request timestamps or engine counters. They cannot inhabit serving-benchmark/1, so this is a separate
// observation (stated divergence, gunbc.design_argument::conformance), not a second run-receipt carrier.
//
// WHAT THE ROWS DO NOT SUPPORT. Every row reads cached_med 0: no follow-up turn reused a cached prefix. Turns 2
// and 3 are full re-prefills of about 31.5k and 33.9k tokens per agent, so they are NOT warm-turn evidence, and
// no row here is a warm-performance reading. The bench's own GPU sampler called nvidia-smi and crashed on this
// AMD-only host in every run (strata_bench.err.log), so GPU telemetry exists only where pwr_sampler.sh ran beside
// it (two runs).
//
// RUN-TO-RUN SPREAD. Two runs at the 300 W default (r9700-20261112, r9700-300w-measured) differ by more than the
// 210 W run differs from either, so the throughput effect of the 210 W cap is not resolved at n=1 per arm. The
// POWER effect is resolved: busy mean 266 W at the 300 W cap, 204 W at 210 W.

type R9700PowerSampling {
  // Which hwmon attribute the sampler read for power. pwr_sampler.sh reads power1_average.
  attribute: AmdgpuHwmonPowerAttribute
  samples: Nat
  sample_interval_seconds: Nat
  // Samples whose power reading is above the cap in force, and the largest reading.
  samples_above_cap: Nat
  power_max: Watt
  // Mean power over samples with gpu_busy_percent >= 50 (truncated to a whole watt) and their count.
  busy_samples: Nat
  busy_power_mean: Watt
  edge_max: Celsius
  junction_max: Celsius
  memory_max: Celsius
}

type R9700CapInForce
  = CapReadByOperator { cap: Watt }
  | CapNotRecorded

type R9700BenchRun {
  run: NonEmptyStr
  rows_sha256: NonEmptyStr
  cap: R9700CapInForce
  conversation_cache: Bool
  // Turn 1: each agent alone (concurrency 1). Agents that returned tokens, of the four.
  first_turn_agents_answered: Nat
  first_turn_ttft_min: Millisecond
  first_turn_ttft_max: Millisecond
  first_turn_decode_min: MilliTokensPerSecond
  first_turn_decode_max: MilliTokensPerSecond
  // Turns 2 and 3: all four agents at once, 512 tokens requested each (2048 per turn).
  second_turn_tokens: TokenCount
  second_turn_aggregate: MilliTokensPerSecond
  third_turn_tokens: TokenCount
  third_turn_aggregate: MilliTokensPerSecond
  // The largest cached_med on any row: 0 everywhere, so no turn reused a prefix.
  cached_tokens_max: TokenCount
  power: R9700PowerSampling?
}

data h11_r9700_bench_host: HostIdentity = operator_host_6ce85c

