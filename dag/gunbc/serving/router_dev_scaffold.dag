module gunbc.serving.router_dev_scaffold

import std.dissolution { DissolutionCondition, bound_dissolution }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_ref }

// THE SRV1 DEV DEPLOYMENT'S TRACKED DEBT. Authority (DESIGN section 5: operator approval outside the diff):
// the operator's decision of 2026-10-25, option B, to serve the pool from the S1 OpenResty proxy on srv1
// before S3 exists, relayed by calm-crab-645 (msg_9e44dfaa, msg_cb0938f9, msg_d9aa02e2), under the
// standing ruling of 2026-10-24 ("its fine to hand write something as long as the debt is tracked").
// Each row below is one debt, bound to the declaration that carries it, with the trigger that retires it.

// 1. ROUTER POLICY IN THE PROXY. gunbc.serving.router_dev_policy decides in OpenResty Lua what the S3
// callout service is to decide. Against gunbc.serving.router_realization's forbidden list it is:
//   - its own load score: spare active turns per upstream, counted in a lua_shared_dict;
//   - direct host choice: the upstream is chosen in the proxy from upstreams.json, not taken from a grant;
//   - its own binding ledger: session-to-upstream bindings, held six hours in the same dict;
//   - invented placement: no product.fabric.selection select_supply, no turn_admission, no lease;
//   - forwarding without a permit: admission is the client key and the cap, no front-door seat permit.
// Also against the S1 contract that the proxy holds no policy (plan gunbc.plans.fabric_serving_router).
// Dissolves when the S3 callout service lands and the dev site's proxy is re-rendered from
// gunbc.serving.router_proxy_config.
data router_dev_policy_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.serving.router_dev_policy",
    decl_name: "router_dev_access_lines",
    field: WholeDeclaration
  }
}

data router_dev_policy_dissolution: DissolutionCondition = bound_dissolution(ref: decl_ref(module_path: "gunbc.serving.serving_router", decl_name: "native_serve_handle"))

// 2. HAND-RUN DEPLOY. No live-deploy leg exists before S7, so the operator account on srv1 runs, in order:
//   a. build gunbc at the deployed head and run gunbc.serving.router_dev_policy router_dev_srv1_write_config,
//      which writes /home/briansrls/router/nginx.conf;
//   b. once: mint a client key into /home/briansrls/router/client_keys (mode 0600) and a self-signed
//      listener certificate into /home/briansrls/router/tls/ (kept across restarts);
//   c. write /home/briansrls/router/upstreams.json (mode 0600) from the upstream list (row 3) and the
//      upstream keys: srv1 vLLM's ~/lil/pool_key, srv3 Strata's /home/ubuntu/strata-pool/api_key (over the
//      fleet SSH key), each Vast card's api_key;
//   d. write /home/briansrls/router/upstream_ca.pem from each TLS upstream's leaf certificate, fetched once
//      and admitted only when its sha256 equals the recorded pin (row 4);
//   e. docker run -d --restart unless-stopped --network host with the pinned image
//      extdeps.proxy.openresty openresty_1_27_1_1_image, mounting /home/briansrls/router at /etc/router
//      read-only and nginx.conf over the image's configuration path; a restart re-reads state.
// Dissolves when the plan's S7 live-deploy leg emits and converges the proxy unit.
data router_dev_hand_deploy_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.serving.router_dev_policy",
    decl_name: "router_dev_srv1_write_config",
    field: WholeDeclaration
  }
}

data router_dev_hand_deploy_dissolution: DissolutionCondition = bound_dissolution(ref: decl_ref(module_path: "gunbc.live_deploy.apply_legs", decl_name: "serving_router_proxy_leg"))

// 3. HAND-MAINTAINED UPSTREAM LIST. upstreams.json names srv1 vLLM (cap 4), srv3 Strata (cap 4) and the
// rented Vast cards. The cards come from the retiring ctrl router's list, refreshed by reading srv2's
// dashboard database read-only (sqlite3 -readonly ~/.local/share/session-dashboard/db.sqlite, table
// mini_agent_pool_cards: url, api_key, model, context_window, cert_sha256) into
// /home/briansrls/router/ctrl_pool_cards.json, then into upstreams.json. While the ctrl router still
// routes to a card its cap here is 1; at cut-over every card takes its full cap. Dissolves when rented
// enrolment is durable state derived from gunbc.serving.rented_allocation (plan S5), replacing the hand list
// gunbc.serving.rented_enrollment rented_cohort_enrollments.
data router_dev_upstream_list_dissolution: DissolutionCondition = bound_dissolution(ref: decl_ref(module_path: "gunbc.serving.rented_enrollment", decl_name: "rented_cohort_enrollments_from_allocations"))

// 4. CERTIFICATE PINS AS A TRUST BUNDLE. nginx verifies an upstream against a CA file, not a fingerprint, so
// each pinned leaf certificate is installed into upstream_ca.pem after its sha256 is compared by hand with
// the recorded pin (trust on first use, as the ctrl router did). WHAT THIS DOES NOT ENFORCE (found on the
// live srv1 deploy, calm-crab-645 2026-10-25): the pool certificates all carry CN=pool-card and no
// subjectAltName, so inside one bundle any pinned card's certificate verifies as any other HTTPS upstream;
// the check is membership in the pinned set, not this upstream's pin. Dissolves with row 2's deploy leg,
// which renders one location per upstream with its own proxy_ssl_trusted_certificate, so each upstream
// is verified against its own pin.
data router_dev_pin_bundle_dissolution: DissolutionCondition = bound_dissolution(ref: decl_ref(module_path: "gunbc.live_deploy.apply_legs", decl_name: "serving_router_proxy_leg"))
