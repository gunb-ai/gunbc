// SRV1'S SERVING LAUNCH, MODELED. srv1 (the RTX PRO 6000 Blackwell box, 100.69.18.126) serves
// Qwen3.8-Flash-Next (NVFP4 weights) for the S1 router, and until this module its launch existed only
// as a hand-run script on the host (/home/briansrls/strata-test/srv1_lil_serve.sh) plus a hand-maintained
// upstream row in the router. (2) of the 2026-10-25 assignment: the launch becomes the model, and the
// router's row, the pinned weights and the provision derivation's vLLM arm all read from HERE.
//
// WHAT IS OBSERVED AND WHAT IS DERIVED (DESIGN 4d — the standings say it, not the prose):
//  - OBSERVED (extdeps.external_authority observed_receipt, via gunbc.host.srv1_serving_startup_receipt,
//    the receipt's single minter srv1_serving_startup_ground): the engine reported itself nvfp4/nvfp4_csf
//    at context 262144, the image digest the running container resolves to, the nvidia driver, and the
//    wrapper script's sha256 on the host. The lines below that restate those carry this standing.
//  - DERIVED: the argv (lil_serve_launch_argv renders it from the rows — the witness pins the render to
//    what `docker inspect` showed of the running container, so the derivation is checked against the
//    reading, never trusted blind), the router upstream launch facts, the enrollment route.
//  - POLICY: the context cap, gunbc.serving.serving_context_cap serving_fleet_context_cap (229376, one
//    value for the whole pool, ruling gunbc.design_ruling one_serving_context_cap), passed as
//    --max-model-len. It overrides the profile's 262144; the receipt read the 2026-10-31 relaunch
//    reporting 229376, so the cap is observed, not only declared.
//  - NEITHER (declared frontier, srv1_serving_unmodeled_frontier_rows): the values the launcher PROFILE
//    supplies (6019/0.96/MTP/gdn/LMCache tiers are printed in the engine's log but are NOT in the
//    wrapper's argv — they come from lil-serve's own profile, unread; the wrapper is modeled verbatim,
//    so no flag this module does not carry is presented as absent), and the relaunch route (the
//    operator-gated maintenance procedure: nothing here stops or starts the live container).

// ── the wrapper: the model is the install authority, the host copy is history ─────────────────
//
// WHY RETAINED SHELL RATHER THAN PURE MODEL (DESIGN 3b "kept with a stated reason", DESIGN 6's
// RetainedShellScript home): the container's entrypoint is this script, and its non-launch lines are
// real serving semantics no existing module models — the TLS self-mint at CN=pool-card whose pin the
// router reads, the events.log START record, the state directory, the restart-by-operator shape, and
// the API key read from a file at exec time so the secret never enters a row. The launch tail, by
// contrast, IS modeled (srv1_serving_launch below). THIS body is the copy the boot unit INSTALLS for
// the next boot (gunbc.live_deploy.srv1_serving_engine_unit installs srv1_serving_engine_wrapper_text),
// so it is the model's OWN authority and its `--device` flag is the declared GPU group's per-device
// selectors — interpolated from srv1_serving_docker_device_flag (built by srv1_serving_docker_device_words from
// the group), so `all` is UNWRITABLE rather than validated away, and srv1_serving_device_gate refuses the deploy
// install unless the declared group resolves to a fully admitted set. The host copy the
// RUNNING container was launched from (srv1_serving_wrapper_running_body, still `all`) is retained purely
// as OBSERVED history: gunbc.host.srv1_serving_startup_receipt pins its sha256 and the launch witness
// re-hashes that running body against the receipt, never this installed body. Where the two differ is
// srv1_serving_wrapper_adoption's PendingOperatorRelaunch.
data srv1_serving_wrapper: RetainedShellScript = RetainedShellScript {
  body: "#!/bin/bash\n# srv1: serve Qwen3.8-Flash-Next (NVFP4 weights, FP8 K/V) with the lil vLLM image, as the Vast \"flash-next lil v2\" template does:\n# lil-serve --profile qwen38-flash-next --hardware rtx-pro-6000-pcie, LMCache ram-disk session cache, HTTPS with a\n# self-signed key kept across restarts, an API key, restart on crash. Differences from Vast: the linux/arm64 (DGX Spark)\n# build of the image (no arm64 build of the Vast digest exists), GPU through CDI, and the container in srv1-inference.slice\n# (cores 96-127, hard cap 130 GiB, no swap; LMCache RAM tier 100 GiB, which lives in /dev/shm, so 110 GiB shm; no host IPC) so it cannot squeeze the sessions;\n# no automatic restart, so a reboot does not bring it back unattended. /cache/jit (the b12x / FlashInfer kernel\n# tuning, hours for a new batch-shape set) is on the host so a container restart keeps it.\nset -eu\n# EXTRA: more lil / vLLM options after \"--\" (e.g. \"--max-num-seqs 64 --mode off\"); they override the profile.\nEXTRA=\x24\{EXTRA:-}\nIMG=sha256:2ad6245e058de7b4d0b973b08d60f67b18f563e4bd63d6a0e9b0406222a098e9  # 58d49cac + LMCache read priority + copy-ownership quarantine and recovery (gunbc-private#267 d49433f, recovery1); was: 74b35f46 + LMCache complete-checkpoint generation retention with background reconciliation (gunbc-private#266 5360cb4); 74b35f46 = 236aa2f2 + page-loss attribution (#264); 236aa2f2 = da08aaf9 + lost-retry repair (#263); da08aaf9 = base af14f1a9 + delete-accounting repair (#255)\nB=\x24HOME/lil; mkdir -p \x24B/hf \x24B/kv \x24B/serve \x24B/jit; umask 077\n[ -s \x24B/pool_key ] || head -c 24 /dev/urandom | base64 | tr -d '/+=' > \x24B/pool_key\numask 022\ndocker rm -f lil-flash-next >/dev/null 2>&1 || true\n# Removal is asynchronous; a run issued before the name frees fails with \"Conflict\".\nfor i in \x24(seq 1 60); do docker container inspect lil-flash-next >/dev/null 2>&1 || break; sleep 2; done\ndocker run -d --name lil-flash-next --restart no {srv1_serving_docker_device_flag} --cgroup-parent=srv1-inference.slice --memory=130g --memory-swap=130g \\\n  --shm-size 110g -p 18000:18000 -e PORT=18000 -e HF_HOME=/root/.cache/huggingface \\\n  -v \x24B/hf:/root/.cache/huggingface -v \x24B/kv:/cache/kv -v \x24B/jit:/cache/jit -v \x24B/serve:/root/serve -v \x24B/pool_key:/root/.pool_key:ro \\\n  --entrypoint bash \x24IMG -lc '\nD=/root/serve; ev(){ echo \"\x24(date -u +%FT%TZ) \x24*\" >> \x24D/events.log; }\n[ -s \x24D/tls.key ] && [ -s \x24D/tls.crt ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \\\n  -days 3650 -subj \"/CN=pool-card\" -keyout \x24D/tls.key -out \x24D/tls.crt >> \x24D/events.log 2>&1\nev \"START srv1 (driver \x24(nvidia-smi --query-gpu=driver_version --format=csv,noheader), cache ram-disk, L1 100G, L2 160G, L2 16 workers O_DIRECT, checkpoint retention share 0.5 window 1800s, TLS)\"\nexec /usr/local/bin/lil-serve --profile qwen38-flash-next --hardware rtx-pro-6000-pcie \\\n  --env LMCACHE_MODE=ram-disk --env LMCACHE_L1_GB=100 --env LMCACHE_L2_GB=150 --env LMCACHE_L2_ROOT=/cache/kv --env LMCACHE_L2_WORKERS=16 --env LMCACHE_L2_ODIRECT=1 --env LMCACHE_CHECKPOINT_PROTECTED_SHARE=0.5 --env LMCACHE_CHECKPOINT_PROTECTION_WINDOW_SECONDS=1800 \\\n  -- --port 18000 '\"\x24EXTRA\"' --ssl-keyfile \x24D/tls.key --ssl-certfile \x24D/tls.crt --api-key \"\x24(cat /root/.pool_key)\" --max-model-len {to_string(token_count_value(t: serving_fleet_context_cap))} >> \x24D/serve.log 2>&1'\necho started; docker ps --filter name=lil-flash-next --format \"{{.Status}}\"\n",
  reason: "srv1's serving container entrypoint, THE COPY THE BOOT UNIT INSTALLS (gunbc.live_deploy.srv1_serving_engine_unit srv1_serving_engine_wrapper_text). Its non-launch semantics — the recovery1 image by digest, LMCACHE_L2_GB=150, TLS self-mint at CN=pool-card, the events.log START record, the API key read at exec time, the context cap (--max-model-len, its value rendered from gunbc.serving.serving_context_cap serving_fleet_context_cap under gunbc.design_ruling one_serving_context_cap) — match the host script the RUNNING container was launched from, EXCEPT the `--device` flag: this installed body passes the declared GPU group's per-device `--device nvidia.com/gpu=<UUID>` (srv1_serving_docker_device_words), not the host copy's `nvidia.com/gpu=all`. The host copy, sha256 b8b73d186a43d56c54eae5985ef0b8d1751b06af08dbf7f7013b885ba49e62bd, is retained as OBSERVED history in srv1_serving_wrapper_running_body and pinned by gunbc.host.srv1_serving_startup_receipt srv1_serving_startup_reading (its sha256, the engine reporting 229376); the launch witness re-hashes THAT running body against the receipt, and srv1_serving_wrapper_adoption types this installed-vs-running gap PendingOperatorRelaunch. THE CLAIM OF THIS ROW, narrowed to match its single dissolves_to (DESIGN 4b): the container launch itself — image by digest, restart no, srv1-inference.slice cgroup, 130g/130g memory-and-swap, 110g shm, device/env/mount flags, published port — retires into extdeps.docker.cli DockerCreateSpec rendered by docker_run_foreground_argv. The OTHER effects the script still performs (TLS self-mint, the events.log START record, the key generation, the key read at exec time) are NOT claimed by this row's trigger; each carries its own keyed trigger row in srv1_serving_unmodeled_frontier_rows below. No secret value appears in this text." as NonEmptyStr,
  dissolves_to: decl_ref(module_path: "extdeps.docker.cli", decl_name: "docker_run_foreground_argv"),
}

// The RUNNING srv1 container was launched from THIS copy of the wrapper — the pre-device-group script whose
// `--device` still names the `all` wildcard (the host hand copy at the startup receipt's wrapper_path), whose
// sha256 gunbc.host.srv1_serving_startup_receipt pins to b8b73d18.... It is the OBSERVED state, kept as history:
// the reading stays even though the launch has moved on. The installed srv1_serving_wrapper.body now carries the
// declared group's per-device selectors, so srv1_serving_wrapper_adoption reports PendingOperatorRelaunch until an
// operator relaunch (the boot unit installs the installed body; this module never restarts the live container —
// gunbc.recurring_failure_mode a_relaunch_from_the_retained_wrapper_reverts_an_image_applied_outside_it) makes the
// running copy match it. The launch witness re-hashes THIS body against the receipt (the_retained_running_body...).
data srv1_serving_wrapper_running_body: String = "#!/bin/bash\n# srv1: serve Qwen3.8-Flash-Next (NVFP4 weights, FP8 K/V) with the lil vLLM image, as the Vast \"flash-next lil v2\" template does:\n# lil-serve --profile qwen38-flash-next --hardware rtx-pro-6000-pcie, LMCache ram-disk session cache, HTTPS with a\n# self-signed key kept across restarts, an API key, restart on crash. Differences from Vast: the linux/arm64 (DGX Spark)\n# build of the image (no arm64 build of the Vast digest exists), GPU through CDI, and the container in srv1-inference.slice\n# (cores 96-127, hard cap 130 GiB, no swap; LMCache RAM tier 100 GiB, which lives in /dev/shm, so 110 GiB shm; no host IPC) so it cannot squeeze the sessions;\n# no automatic restart, so a reboot does not bring it back unattended. /cache/jit (the b12x / FlashInfer kernel\n# tuning, hours for a new batch-shape set) is on the host so a container restart keeps it.\nset -eu\n# EXTRA: more lil / vLLM options after \"--\" (e.g. \"--max-num-seqs 64 --mode off\"); they override the profile.\nEXTRA=\x24\{EXTRA:-}\nIMG=sha256:2ad6245e058de7b4d0b973b08d60f67b18f563e4bd63d6a0e9b0406222a098e9  # 58d49cac + LMCache read priority + copy-ownership quarantine and recovery (gunbc-private#267 d49433f, recovery1); was: 74b35f46 + LMCache complete-checkpoint generation retention with background reconciliation (gunbc-private#266 5360cb4); 74b35f46 = 236aa2f2 + page-loss attribution (#264); 236aa2f2 = da08aaf9 + lost-retry repair (#263); da08aaf9 = base af14f1a9 + delete-accounting repair (#255)\nB=\x24HOME/lil; mkdir -p \x24B/hf \x24B/kv \x24B/serve \x24B/jit; umask 077\n[ -s \x24B/pool_key ] || head -c 24 /dev/urandom | base64 | tr -d '/+=' > \x24B/pool_key\numask 022\ndocker rm -f lil-flash-next >/dev/null 2>&1 || true\n# Removal is asynchronous; a run issued before the name frees fails with \"Conflict\".\nfor i in \x24(seq 1 60); do docker container inspect lil-flash-next >/dev/null 2>&1 || break; sleep 2; done\ndocker run -d --name lil-flash-next --restart no --device nvidia.com/gpu=all --cgroup-parent=srv1-inference.slice --memory=130g --memory-swap=130g \\\n  --shm-size 110g -p 18000:18000 -e PORT=18000 -e HF_HOME=/root/.cache/huggingface \\\n  -v \x24B/hf:/root/.cache/huggingface -v \x24B/kv:/cache/kv -v \x24B/jit:/cache/jit -v \x24B/serve:/root/serve -v \x24B/pool_key:/root/.pool_key:ro \\\n  --entrypoint bash \x24IMG -lc '\nD=/root/serve; ev(){ echo \"\x24(date -u +%FT%TZ) \x24*\" >> \x24D/events.log; }\n[ -s \x24D/tls.key ] && [ -s \x24D/tls.crt ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \\\n  -days 3650 -subj \"/CN=pool-card\" -keyout \x24D/tls.key -out \x24D/tls.crt >> \x24D/events.log 2>&1\nev \"START srv1 (driver \x24(nvidia-smi --query-gpu=driver_version --format=csv,noheader), cache ram-disk, L1 100G, L2 160G, L2 16 workers O_DIRECT, checkpoint retention share 0.5 window 1800s, TLS)\"\nexec /usr/local/bin/lil-serve --profile qwen38-flash-next --hardware rtx-pro-6000-pcie \\\n  --env LMCACHE_MODE=ram-disk --env LMCACHE_L1_GB=100 --env LMCACHE_L2_GB=150 --env LMCACHE_L2_ROOT=/cache/kv --env LMCACHE_L2_WORKERS=16 --env LMCACHE_L2_ODIRECT=1 --env LMCACHE_CHECKPOINT_PROTECTED_SHARE=0.5 --env LMCACHE_CHECKPOINT_PROTECTION_WINDOW_SECONDS=1800 \\\n  -- --port 18000 '\"\x24EXTRA\"' --ssl-keyfile \x24D/tls.key --ssl-certfile \x24D/tls.crt --api-key \"\x24(cat /root/.pool_key)\" --max-model-len {to_string(token_count_value(t: serving_fleet_context_cap))} >> \x24D/serve.log 2>&1'\necho started; docker ps --filter name=lil-flash-next --format \"{{.Status}}\"\n"

// THE STANDING OF EVERY SRV1 SERVING READING, under this module's name for it. The seal lives with
// the receipt: gunbc.host.srv1_serving_startup_receipt srv1_serving_startup_ground is the name the
// observed_receipt admit_callers roster admits; nothing here can mint a reading, only point at it.
fn srv1_serving_ground() -> CitedFigureStanding {
  srv1_serving_startup_ground()
}

// ── the launch, as rows ──────────────────────────────────────────────────────────────────────
//
// THE ARGV THAT IS MODELED IS THE ARGV THE WRAPPER ACTUALLY PASSES. Every nvfp4/tier value the engine
// reports is supplied by lil-serve's qwen38-flash-next PROFILE, not by a flag — modeling them here as
// flags would be inventing argv the host does not run (4d). The one exception is the pool's context
// cap, which the wrapper passes because the profile's own 262144 is wider than the pool's. The rest
// stay Absent and the profile's existence is the read obligation on extdeps.vllm.lil_serve; the
// engine-reported values live in the startup receipt with their observed standing. The one other thing
// the wrapper passes verbatim — the LMCache tier environment — is carried as environment rows.
data srv1_serving_launch: LilServeLaunch = LilServeLaunch {
  profile: lil_serve_profile_qwen38_flash_next,
  hardware: lil_serve_hardware_rtx_pro_6000_pcie,
  environment: [
    lil_serve_environment_entry(key: "LMCACHE_MODE" as NonEmptyStr, value: "ram-disk" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L1_GB" as NonEmptyStr, value: "100" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L2_GB" as NonEmptyStr, value: "150" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L2_ROOT" as NonEmptyStr, value: "/cache/kv" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L2_WORKERS" as NonEmptyStr, value: "16" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L2_ODIRECT" as NonEmptyStr, value: "1" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_CHECKPOINT_PROTECTED_SHARE" as NonEmptyStr, value: "0.5" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_CHECKPOINT_PROTECTION_WINDOW_SECONDS" as NonEmptyStr, value: "1800" as NonEmptyStr),
  ],
  engine: LilServeEngineFlags {
    served_model_name: Absent,
    kv_cache_dtype: Absent,
    memory: Absent,
    max_model_len: Present { value: serving_fleet_context_cap },
    max_num_seqs: Absent,
    max_num_batched_tokens: Absent,
    chunked_prefill: Absent,
    prefix_caching: Absent,
    unmodeled_tail: [],
  },
  ssl_keyfile: "/root/serve/tls.key" as NonEmptyStr,
  ssl_certfile: "/root/serve/tls.crt" as NonEmptyStr,
  // The key's VALUE never enters the model; only the path it is read from at exec time does.
  api_key: LilServeApiKeyFromFile { path: "/root/.pool_key" as NonEmptyStr },
  listen_port: 18000,
  standing: srv1_serving_ground(),
}

// The same launch at another port — the route the provision derivation takes when a recipe's published
// port differs; every other field stays the row above's, so no second copy of the launch can drift.
fn srv1_serving_launch_for_port(port: Port) -> LilServeLaunch {
  LilServeLaunch {
    profile: srv1_serving_launch.profile,
    hardware: srv1_serving_launch.hardware,
    environment: srv1_serving_launch.environment,
    engine: srv1_serving_launch.engine,
    ssl_keyfile: srv1_serving_launch.ssl_keyfile,
    ssl_certfile: srv1_serving_launch.ssl_certfile,
    api_key: srv1_serving_launch.api_key,
    listen_port: port,
    standing: srv1_serving_launch.standing,
  }
}

// THE RENDERED ARGV, derived from the typed launch row through the launcher interface — with the
// KEY-READ TOKEN supplied by the CALLER, never constructed here (ctrl HAND-SHELL policy; review 86807;
// DESIGN 5: "A dissolution condition describes how admitted debt ends; it does not authorize creating
// it"). On srv1 the exec-time key read is spelled in exactly ONE place: the retained wrapper body
// above (srv1_serving_wrapper, whose home gunbc.retained_shell_script exists precisely to sanction
// retained scripts) — where it belongs, because it is part of the container's actual `bash -lc` command
// string, read back from `docker inspect`. No fn in this module builds shell syntax out of string
// literals and passes it to something named argv: that is medium-as-string, and a Scaffold disposition
// on such a fragment makes the debt honest without authorizing it (a temporary deviation needs
// operator approval outside the diff, not a marker inside it). A BASH realization — srv1's — passes the
// wrapper's own substitution token, which the witness pins token-for-token to `docker inspect`'s Cmd; a
// direct-exec realization reads LilServeApiKeyFromFile.path at start and passes the file's contents
// instead. The typed source on srv1_serving_launch — the path, carrying no dollar sign — is the interface
// fact either way (DESIGN 3: the interface carries no shell).
fn srv1_serving_launch_argv(api_key_wire: NonEmptyStr) -> List<String> {
  lil_serve_launch_argv(launch: srv1_serving_launch, api_key_wire: api_key_wire)
}

// THE IMAGE srv1 RUNS IS NOT THE UPSTREAM BUILD: it is the upstream image with ONE file replaced, the
// LMCache native L2 adapter's delete accounting (a delete caller timing out must not discard the native
// operation's eventual completion). Built on srv1 2026-10-28 by eager-lynx-183; the Dockerfile, the
// patch and the drain/switch receipt are retained in gunbc-private#255. This is OUR artifact, not a fact
// of the upstream (DESIGN 3, external upstream decomposition), so it lives here and not in
// extdeps.vllm.local_inference_lab_build, whose row stays the base. The relation is carried as the
// observed facts below; the build itself is not a modeled realization yet (its home is the derived-key
// pattern of gunbc.spark.vllm_image_identity, glm53_kvplan_key: base key + patch digest), and the
// standing says so (DESIGN 4d).
//
// WHY NOT A VllmServingImage: that type is extdeps.vllm.local_inference_lab_build's sole_constructor
// release identity, and minting one here would present our build as the upstream's release (the
// nickname DESIGN 3 forbids). The derivation therefore carries its OWN identity fields and holds the
// upstream row only as its base.
//
// ONE IMAGE AUTHORITY FOR THE DEPLOYMENT: gunbc.serving.serving_provision_derivation's srv1 arm takes its
// image from srv1_serving_image below, not from the recipe build's pin, so the base is reachable from a
// provision only as the release it derives from (`build`), never as the image it installs.
type Srv1ServingImageDerivation {
  repository: NonEmptyStr
  tag: NonEmptyStr
  digest_sha256: NonEmptyStr
  standing: CitedFigureStanding
  base: VllmServingImage
  // Every file the derivation changes relative to its base: a REPLACED file carries the base's digest
  // (the build's `sha256sum -c` guard) and the replacement's (read inside the running container); an
  // ADDED file carries its digest and the guard that it was absent from the base (`test ! -e`). Nonempty
  // by construction: a derivation that changes nothing is the base, and has no row here.
  changes: FreeSemigroup<Srv1ImageFileChange>
}

type Srv1ImageFileChange
  = Srv1ImageFileReplaced { path: NonEmptyStr, base_file_sha256_hex: NonEmptyStr, replaced_file_sha256_hex: NonEmptyStr }
  | Srv1ImageFileAdded { path: NonEmptyStr, added_file_sha256_hex: NonEmptyStr }

fn srv1_image_file_replaced(path: NonEmptyStr, base: NonEmptyStr, replaced: NonEmptyStr) -> Srv1ImageFileChange {
  Srv1ImageFileReplaced { path: path, base_file_sha256_hex: base, replaced_file_sha256_hex: replaced }
}

fn srv1_image_file_added(path: NonEmptyStr, added: NonEmptyStr) -> Srv1ImageFileChange {
  Srv1ImageFileAdded { path: path, added_file_sha256_hex: added }
}

data srv1_serving_image_derivation: Srv1ServingImageDerivation = Srv1ServingImageDerivation {
  repository: "local/eager-checkpoint-read-priority" as NonEmptyStr,
  tag: "recovery1" as NonEmptyStr,
  // `docker inspect --format {{.Image}} lil-flash-next` on srv1, 2026-10-30: the container that ran 12:28:12 to
