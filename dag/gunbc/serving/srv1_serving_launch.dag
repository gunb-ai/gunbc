// SRV1'S SERVING LAUNCH, MODELED. srv1 (the RTX PRO 6000 Blackwell box, 100.69.18.126) serves
// Qwen3.8-Flash-Next (NVFP4 weights) for the S1 router, and until this module its launch existed only
// as a hand-run script on the host (/home/briansrls/strata-test/srv1_lil_serve.sh) plus a hand-maintained
// upstream row in the router. (2) of the 2026-10-25 assignment: the launch becomes the model, and the
// router's row, the pinned weights and the provision derivation's vLLM arm all read from HERE.
//
// WHAT IS OBSERVED AND WHAT IS DERIVED (DESIGN 4d — the standings say it, not the prose):
//  - OBSERVED (extdeps.external_authority observed_receipt, via gunbc.host.srv1_serving_startup_receipt,
//    the receipt's single minter srv1_serving_startup_ground): the engine reported itself nvfp4/nvfp4_csf
//    at context 262144, the image digest the running container resolves to, the nvidia driver, and the
//    wrapper script's sha256 on the host. The lines below that restate those carry this standing.
//  - DERIVED: the argv (lil_serve_launch_argv renders it from the rows — the witness pins the render to
//    what `docker inspect` showed of the running container, so the derivation is checked against the
//    reading, never trusted blind), the router upstream launch facts, the enrollment route.
//  - NEITHER (declared frontier, srv1_serving_unmodeled_frontier_rows): the values the launcher PROFILE
//    supplies (262144/6019/0.96/MTP/gdn/LMCache tiers are printed in the engine's log but are NOT in the
//    wrapper's argv — they come from lil-serve's own profile, unread; the wrapper is modeled verbatim,
//    so no flag this module does not carry is presented as absent), and the relaunch route (the
//    operator-gated maintenance procedure: nothing here stops or starts the live container).

// ── the wrapper, retained verbatim ───────────────────────────────────────────────────────────
//
// WHY RETAINED SHELL RATHER THAN PURE MODEL (DESIGN 3b "kept with a stated reason", DESIGN 6's
// RetainedShellScript home): the container's entrypoint is this script, and its non-launch lines are
// real serving semantics no existing module models — the TLS self-mint at CN=pool-card whose pin the
// router reads, the events.log START record, the state directory, the restart-by-operator shape, and
// the API key read from a file at exec time so the secret never enters a row. The launch tail, by
// contrast, IS modeled (srv1_serving_launch below), and this script's own value is decidable: its body
// hashes to the wrapper_sha256_hex the startup receipt read off the host.
data srv1_serving_wrapper: RetainedShellScript = RetainedShellScript {
  body: "#!/bin/bash\n# srv1: serve Qwen3.8-Flash-Next (NVFP4 weights, FP8 K/V) with the lil vLLM image, as the Vast \"flash-next lil v2\" template does:\n# lil-serve --profile qwen38-flash-next --hardware rtx-pro-6000-pcie, LMCache ram-disk session cache, HTTPS with a\n# self-signed key kept across restarts, an API key, restart on crash. Differences from Vast: the linux/arm64 (DGX Spark)\n# build of the image (no arm64 build of the Vast digest exists), GPU through CDI, and the container in srv1-inference.slice\n# (cores 96-127, hard cap 130 GiB, no swap; LMCache RAM tier 100 GiB, which lives in /dev/shm, so 110 GiB shm; no host IPC) so it cannot squeeze the sessions;\n# no automatic restart, so a reboot does not bring it back unattended. /cache/jit (the b12x / FlashInfer kernel\n# tuning, hours for a new batch-shape set) is on the host so a container restart keeps it.\nset -eu\n# EXTRA: more lil / vLLM options after \"--\" (e.g. \"--max-num-seqs 64 --mode off\"); they override the profile.\nEXTRA=\x24\{EXTRA:-}\nIMG=sha256:74b35f46d8067dc6cae68ff6b92bf010497a5cbb8a06429f5729f8ed342ec7ba  # 236aa2f2 + LMCache checkpoint page-loss attribution, observation only (gunbc-private#264); 236aa2f2 = da08aaf9 + the lost-retry repair (#263); da08aaf9 = base af14f1a9 + the delete-accounting repair (#255)\nB=\x24HOME/lil; mkdir -p \x24B/hf \x24B/kv \x24B/serve \x24B/jit; umask 077\n[ -s \x24B/pool_key ] || head -c 24 /dev/urandom | base64 | tr -d '/+=' > \x24B/pool_key\numask 022\ndocker rm -f lil-flash-next >/dev/null 2>&1 || true\n# Removal is asynchronous; a run issued before the name frees fails with \"Conflict\".\nfor i in \x24(seq 1 60); do docker container inspect lil-flash-next >/dev/null 2>&1 || break; sleep 2; done\ndocker run -d --name lil-flash-next --restart no --device nvidia.com/gpu=all --cgroup-parent=srv1-inference.slice --memory=130g --memory-swap=130g \\\n  --shm-size 110g -p 18000:18000 -e PORT=18000 -e HF_HOME=/root/.cache/huggingface \\\n  -v \x24B/hf:/root/.cache/huggingface -v \x24B/kv:/cache/kv -v \x24B/jit:/cache/jit -v \x24B/serve:/root/serve -v \x24B/pool_key:/root/.pool_key:ro \\\n  --entrypoint bash \x24IMG -lc '\nD=/root/serve; ev(){ echo \"\x24(date -u +%FT%TZ) \x24*\" >> \x24D/events.log; }\n[ -s \x24D/tls.key ] && [ -s \x24D/tls.crt ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \\\n  -days 3650 -subj \"/CN=pool-card\" -keyout \x24D/tls.key -out \x24D/tls.crt >> \x24D/events.log 2>&1\nev \"START srv1 (driver \x24(nvidia-smi --query-gpu=driver_version --format=csv,noheader), cache ram-disk, L1 100G, L2 160G, L2 16 workers O_DIRECT, TLS)\"\nexec /usr/local/bin/lil-serve --profile qwen38-flash-next --hardware rtx-pro-6000-pcie \\\n  --env LMCACHE_MODE=ram-disk --env LMCACHE_L1_GB=100 --env LMCACHE_L2_GB=160 --env LMCACHE_L2_ROOT=/cache/kv --env LMCACHE_L2_WORKERS=16 --env LMCACHE_L2_ODIRECT=1 \\\n  -- --port 18000 '\"\x24EXTRA\"' --ssl-keyfile \x24D/tls.key --ssl-certfile \x24D/tls.crt --api-key \"\x24(cat /root/.pool_key)\" >> \x24D/serve.log 2>&1'\necho started; docker ps --filter name=lil-flash-next --format \"{{.Status}}\"",
  reason: "srv1's serving container entrypoint, retained verbatim from /home/briansrls/strata-test/srv1_lil_serve.sh (re-read off the host 2026-10-29 16:23 after the page-loss attribution relaunch, while the container ran from it; sha256 42a8e2a8ede1c90a262f4561220b08934f625d3a0347cde516aa93b424f24961, pinned in gunbc.host.srv1_serving_startup_receipt srv1_serving_startup_reading). THE CLAIM OF THIS ROW, narrowed to match its single dissolves_to (DESIGN 4b: the trigger names the capability this row loses): the container launch itself — image by digest, restart no, srv1-inference.slice cgroup, 130g/130g memory-and-swap, 110g shm, device/env/mount flags, published port — retires into extdeps.docker.cli DockerCreateSpec rendered by docker_run_foreground_argv, the dissolves_to ref, together with the launch tail srv1_serving_launch already models. The OTHER effects the script still performs (the TLS self-mint at CN=pool-card, the events.log START record, the key generation, the key read at exec time) are NOT claimed by this row's trigger; each carries its own keyed trigger row in srv1_serving_unmodeled_frontier_rows below. No secret value appears in this text." as NonEmptyStr,
  dissolves_to: decl_ref(module_path: "extdeps.docker.cli", decl_name: "docker_run_foreground_argv"),
}

// THE STANDING OF EVERY SRV1 SERVING READING, under this module's name for it. The seal lives with
// the receipt: gunbc.host.srv1_serving_startup_receipt srv1_serving_startup_ground is the name the
// observed_receipt admit_callers roster admits; nothing here can mint a reading, only point at it.
fn srv1_serving_ground() -> CitedFigureStanding {
  srv1_serving_startup_ground()
}

// ── the launch, as rows ──────────────────────────────────────────────────────────────────────
//
// THE ARGGV THAT IS MODELED IS THE ARGV THE WRAPPER ACTUALLY PASSES. Every nvfp4/context/tier value the
// engine reports is supplied by lil-serve's qwen38-flash-next PROFILE, not by a flag — modeling them
// here as flags would be inventing argv the host does not run (4d). The flags stay Absent and the
// profile's existence is the read obligation on extdeps.vllm.lil_serve; the engine-reported values
// live in the startup receipt with their observed standing. The one thing the wrapper does pass
// verbatim — the LMCache tier environment — is carried as environment rows.
data srv1_serving_launch: LilServeLaunch = LilServeLaunch {
  profile: lil_serve_profile_qwen38_flash_next,
  hardware: lil_serve_hardware_rtx_pro_6000_pcie,
  environment: [
    lil_serve_environment_entry(key: "LMCACHE_MODE" as NonEmptyStr, value: "ram-disk" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L1_GB" as NonEmptyStr, value: "100" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L2_GB" as NonEmptyStr, value: "160" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L2_ROOT" as NonEmptyStr, value: "/cache/kv" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L2_WORKERS" as NonEmptyStr, value: "16" as NonEmptyStr),
    lil_serve_environment_entry(key: "LMCACHE_L2_ODIRECT" as NonEmptyStr, value: "1" as NonEmptyStr),
  ],
  engine: LilServeEngineFlags {
    served_model_name: Absent,
    kv_cache_dtype: Absent,
    memory: Absent,
    max_model_len: Absent,
    max_num_seqs: Absent,
    max_num_batched_tokens: Absent,
    chunked_prefill: Absent,
    prefix_caching: Absent,
    unmodeled_tail: [],
  },
  ssl_keyfile: "/root/serve/tls.key" as NonEmptyStr,
  ssl_certfile: "/root/serve/tls.crt" as NonEmptyStr,
  // The key's VALUE never enters the model; only the path it is read from at exec time does.
  api_key: LilServeApiKeyFromFile { path: "/root/.pool_key" as NonEmptyStr },
  listen_port: 18000,
  standing: srv1_serving_ground(),
}

// The same launch at another port — the route the provision derivation takes when a recipe's published
// port differs; every other field stays the row above's, so no second copy of the launch can drift.
fn srv1_serving_launch_for_port(port: Port) -> LilServeLaunch {
  LilServeLaunch {
    profile: srv1_serving_launch.profile,
    hardware: srv1_serving_launch.hardware,
    environment: srv1_serving_launch.environment,
    engine: srv1_serving_launch.engine,
    ssl_keyfile: srv1_serving_launch.ssl_keyfile,
    ssl_certfile: srv1_serving_launch.ssl_certfile,
    api_key: srv1_serving_launch.api_key,
    listen_port: port,
    standing: srv1_serving_launch.standing,
  }
}

// THE RENDERED ARGV, derived from the typed launch row through the launcher interface — with the
// KEY-READ TOKEN supplied by the CALLER, never constructed here (ctrl HAND-SHELL policy; review 86807;
// DESIGN 5: "A dissolution condition describes how admitted debt ends; it does not authorize creating
// it"). On srv1 the exec-time key read is spelled in exactly ONE place: the retained wrapper body
// above (srv1_serving_wrapper, whose home gunbc.retained_shell_script exists precisely to sanction
// retained scripts) — where it belongs, because it is part of the container's actual `bash -lc` command
// string, read back from `docker inspect`. No fn in this module builds shell syntax out of string
// literals and passes it to something named argv: that is medium-as-string, and a Scaffold disposition
// on such a fragment makes the debt honest without authorizing it (a temporary deviation needs
// operator approval outside the diff, not a marker inside it). A BASH realization — srv1's — passes the
// wrapper's own substitution token, which the witness pins token-for-token to `docker inspect`'s Cmd; a
// direct-exec realization reads LilServeApiKeyFromFile.path at start and passes the file's contents
// instead. The typed source on srv1_serving_launch — the path, carrying no dollar sign — is the interface
// fact either way (DESIGN 3: the interface carries no shell).
fn srv1_serving_launch_argv(api_key_wire: NonEmptyStr) -> List<String> {
  lil_serve_launch_argv(launch: srv1_serving_launch, api_key_wire: api_key_wire)
}

// THE IMAGE srv1 RUNS IS NOT THE UPSTREAM BUILD: it is the upstream image with ONE file replaced, the
// LMCache native L2 adapter's delete accounting (a delete caller timing out must not discard the native
// operation's eventual completion). Built on srv1 2026-10-28 by eager-lynx-183; the Dockerfile, the
// patch and the drain/switch receipt are retained in gunbc-private#255. This is OUR artifact, not a fact
// of the upstream (DESIGN 3, external upstream decomposition), so it lives here and not in
// extdeps.vllm.local_inference_lab_build, whose row stays the base. The relation is carried as the
// observed facts below; the build itself is not a modeled realization yet (its home is the derived-key
// pattern of gunbc.spark.vllm_image_identity, glm53_kvplan_key: base key + patch digest), and the
// standing says so (DESIGN 4d).
//
// WHY NOT A VllmServingImage: that type is extdeps.vllm.local_inference_lab_build's sole_constructor
// release identity, and minting one here would present our build as the upstream's release (the
// nickname DESIGN 3 forbids). The derivation therefore carries its OWN identity fields and holds the
// upstream row only as its base.
//
// ONE IMAGE AUTHORITY FOR THE DEPLOYMENT: gunbc.serving.serving_provision_derivation's srv1 arm takes its
// image from srv1_serving_image below, not from the recipe build's pin, so the base is reachable from a
// provision only as the release it derives from (`build`), never as the image it installs.
type Srv1ServingImageDerivation {
  repository: NonEmptyStr
  tag: NonEmptyStr
  digest_sha256: NonEmptyStr
  standing: CitedFigureStanding
  base: VllmServingImage
  // Every file the derivation changes relative to its base: a REPLACED file carries the base's digest
  // (the build's `sha256sum -c` guard) and the replacement's (read inside the running container); an
  // ADDED file carries its digest and the guard that it was absent from the base (`test ! -e`). Nonempty
  // by construction: a derivation that changes nothing is the base, and has no row here.
  changes: FreeSemigroup<Srv1ImageFileChange>
}

type Srv1ImageFileChange
  = Srv1ImageFileReplaced { path: NonEmptyStr, base_file_sha256_hex: NonEmptyStr, replaced_file_sha256_hex: NonEmptyStr }
  | Srv1ImageFileAdded { path: NonEmptyStr, added_file_sha256_hex: NonEmptyStr }

fn srv1_image_file_replaced(path: NonEmptyStr, base: NonEmptyStr, replaced: NonEmptyStr) -> Srv1ImageFileChange {
  Srv1ImageFileReplaced { path: path, base_file_sha256_hex: base, replaced_file_sha256_hex: replaced }
}

fn srv1_image_file_added(path: NonEmptyStr, added: NonEmptyStr) -> Srv1ImageFileChange {
  Srv1ImageFileAdded { path: path, added_file_sha256_hex: added }
}

data srv1_serving_image_derivation: Srv1ServingImageDerivation = Srv1ServingImageDerivation {
  repository: "local/eager-checkpoint-attribution" as NonEmptyStr,
  tag: "20261029" as NonEmptyStr,
  // `docker inspect --format {{.Image}} lil-flash-next` on srv1, 2026-10-29 16:23, after the relaunch onto
  // the page-loss attribution build (gunbc-private#264, observation only), built FROM the lost-retry build
  // 236aa2f2 (#263), FROM the delete-accounting build da08aaf9 (#255), FROM the upstream base. Relative to
  // the base it changes seven files. The whole lmcache tree of this image was diffed against 236aa2f2's
  // (784 files): exactly the five #264 files differ, so its directory COPY added nothing unlisted.
  digest_sha256: "74b35f46d8067dc6cae68ff6b92bf010497a5cbb8a06429f5729f8ed342ec7ba" as NonEmptyStr,
  standing: TranscribedUncited {
    read_obligation: "A local build with no registry manifest: this repository read the running container's image ID and each changed file's sha256 (2026-10-29 16:23), and diffed the image's lmcache tree against its predecessor's. The build recipes (each FROM its predecessor by digest, a sha256 -c or test ! -e guard on every base file it changes, then COPY) are read from gunbc-private#255's, #263's and #264's Dockerfiles, not from a modeled realization; retiring this needs the build as a keyed realization under gunbc.spark.vllm_image_identity's derived-key pattern." as NonEmptyStr,
  },
  base: local_inference_lab_vllm_image,
  changes: FreeSemigroup {
    head: srv1_image_file_replaced(
      path: "/opt/venv/lib/python3.12/site-packages/lmcache/v1/distributed/l2_adapters/native_connector_l2_adapter.py" as NonEmptyStr,
      base: "b6e87817a179a58b239e5dfecf8df4280ea048b01d1ee5b1c2027a57580a4f93" as NonEmptyStr,
      replaced: "d4b5aef995406fcda896bb5a3a7e9f6829f7ea4a6b48203a3dd54b2630fa82a7" as NonEmptyStr,
    ),
    tail: [
      srv1_image_file_replaced(
        path: "/opt/venv/lib/python3.12/site-packages/lmcache/v1/distributed/checkpoint_retention.py" as NonEmptyStr,
        base: "bef7ab06f0f4d09b9646a89f6b8f7cd28d5f51bcb0cc9103c8f605781e12294e" as NonEmptyStr,
        replaced: "486f9a157e1cacf163a45e76a8d1b105f60f83e43e0ed72446259b135ba90c32" as NonEmptyStr,
      ),
      srv1_image_file_replaced(
        path: "/opt/venv/lib/python3.12/site-packages/lmcache/v1/distributed/storage_controllers/store_controller.py" as NonEmptyStr,
        base: "f77b7a148fcfd1b20ac53fcc12412b74048fd0c802a40cc9021e3864476c3f2f" as NonEmptyStr,
        replaced: "cbc612b142a5f87716d36b966794ab4664f938bb664de9f4c22e0b14fe92d364" as NonEmptyStr,
      ),
      srv1_image_file_replaced(
        path: "/opt/venv/lib/python3.12/site-packages/lmcache/v1/distributed/storage_manager.py" as NonEmptyStr,
        base: "5cd022eefc259c64a069e470d1621dcd6f7d4d84490b1951e59359aad7a7d22b" as NonEmptyStr,
        replaced: "a28920e1f2e5e4c82c3f3c3d4b8ec28048debc685d22ef78f2a84c449b6f67b8" as NonEmptyStr,
      ),
      srv1_image_file_replaced(
        path: "/opt/venv/lib/python3.12/site-packages/lmcache/v1/distributed/storage_controllers/eviction_controller.py" as NonEmptyStr,
        base: "f4f921edb872faa9db7b8c120154adfef88415af7912217d4f0f3f39de1d2f80" as NonEmptyStr,
        replaced: "74007ec2eda09d0a8c132416d31dca11942d386ed505bb0d5402bf74fb87662b" as NonEmptyStr,
      ),
      srv1_image_file_replaced(
        path: "/opt/venv/lib/python3.12/site-packages/lmcache/v1/multiprocess/modules/checkpoint.py" as NonEmptyStr,
        base: "4e7d3a26d9bf97b82e2deda375deb696926bb8327bf60c4f35b081d5456e74eb" as NonEmptyStr,
        replaced: "557f24b175d881757e97ceacb69c7bdb2b985230a26202760fb0b6f625dddb24" as NonEmptyStr,
      ),
      srv1_image_file_added(
        path: "/opt/venv/lib/python3.12/site-packages/lmcache/v1/distributed/checkpoint_loss.py" as NonEmptyStr,
        added: "ce95b5cd6986b62d39860e79978b2553efcfa7dc179c87c9edfbcb51796737c1" as NonEmptyStr,
      ),
    ],
  },
}

// The image and the pinned checkpoint the launch runs, exported so the router row and the witness read
// THEM rather than restating a digest (one authority; DESIGN 3).
fn srv1_serving_image() -> Srv1ServingImageDerivation {
  srv1_serving_image_derivation
}

fn srv1_serving_pinned_checkpoint() -> HubCheckpointManifest {
  qwen3_8_flash_next_manifest
}

// The recipe whose launch this is. A bare reference — importing the recipe row here would close a
// module cycle, product.fabric.serving_recipe already reading this module for the download standing.
data srv1_serving_launch_recipe: DeclarationRef = decl_ref(module_path: "product.fabric.serving_recipe", decl_name: "serving_recipe_flash_next_lab_vllm")

// ── the router upstream's LAUNCH FACTS ───────────────────────────────────────────────────────
//
// The S1 router (gunbc-router, #15113) routes Qwen3.8-Flash-Next turns to srv1's endpoint; its upstream
// row (gunbc.serving.router_dev_policy, proud-bear-756) is a router POLICY row carrying a cap the
// OPERATOR sets and a secret reference it keeps. The parts that are launch facts — the identity the
// router contacts, not what it may send — come from HERE, so a flag change at the launch moves the
// router's row and cannot leave it pointing at a stale endpoint.
//
// COORDINATION (declared, not hidden): #15113 carries the type and a literal srv1 row today; when that
// PR lands, its literal is replaced by srv1_router_upstream_launch_facts below. Until then this export
// has no production consumer on main and says so as a frontier row — the honest state, not a wired
// consumer claimed.
type Srv1RouterUpstreamLaunchFacts {
  // The router's name for the upstream, which is this container's served name.
  name: NonEmptyStr
  // The scheme and address the launch's TLS server listens at: HTTPS on the loopback address the
  // engine binds (srv1 and the router share the host). Typed, not re-invented strings (DESIGN 2):
  // the scheme is extdeps.uri's UriScheme arm (the same carrier the router's upstream URIs and
  // gunbc.spark use), and the address is extdeps.network.ipv4's Ipv4Address — a bare NonEmptyStr
  // here could spell "https://" or "localhost:18000" and the type would not notice. The router row
  // composes scheme+host+port into its Uri; render_ipv4_address gives the wire form.
  scheme: UriScheme
  host: Ipv4Address
  port: Port
  // The TLS name the router verifies. srv1's certificate is self-signed at CN=pool-card (the wrapper
  // mints it); the card's cert carries no SAN, so the router verifies this name. Read from the live
  // router deployment 2026-10-25; it is a launch fact because the mint is the launch's.
  tls_name: NonEmptyStr
  // The advertised model id — the engine's own served_model_name, read from the startup receipt, not
  // restated here as a second literal the launch could drift from.
  model: NonEmptyStr
}

// The address the engine binds: IPv4 loopback (octets 127.0.0.1 — the wrapper publishes -p
// 18000:18000 on the host stack; srv1 and the router share the host). A typed octet record, not a
// string: 256.0.0.1 and "127.0.0." are unwritable here (extdeps.network.ipv4 Octet range).
data srv1_serving_listen_address: Ipv4Address = ipv4_address(octet1: 127, octet2: 0, octet3: 0, octet4: 1)

data srv1_router_upstream_launch_facts: Srv1RouterUpstreamLaunchFacts = Srv1RouterUpstreamLaunchFacts {
  name: "srv1-vllm" as NonEmptyStr,
  scheme: Https,
  host: srv1_serving_listen_address,
  port: srv1_serving_launch.listen_port,
  tls_name: "pool-card" as NonEmptyStr,
  model: srv1_serving_startup_reading.served_model_name,
}

// ── the enrollment row: this launch, routable, with a declared ceiling ───────────────────────
//
// The FIRST-PARTY replica (srv1 is owned hardware, not rented): the identity, address and port are the
// launch's; the turn ceiling is the operator's decision (cap 4 at the 2026-10-24 router cutover,
// relayed by merry-fox-82) and is spelled CeilingByDeclaredPolicy — an allocation with a decider and a
// date, not a fabricated measurement (DESIGN 5). serving_enrollment's own rule holds: admission takes
// the minimum of this ceiling and what the route says about itself live.
data srv1_serving_route: ServingRoute = serving_replica_route(
  replica: RentedReplicaIdentity {
    node: "srv1" as NonEmptyStr,
    device_index: 0,
    served_name: srv1_router_upstream_launch_facts.name,
  },
  address: render_ipv4_address(addr: srv1_router_upstream_launch_facts.host),
  port: srv1_router_upstream_launch_facts.port,
  ceiling: CeilingByDeclaredPolicy {
    count: 4,
    decider: "operator" as NonEmptyStr,
    decided_on: "2026-10-24" as NonEmptyStr,
    basis: "S1 router cutover to srv1 (gunbc.serving.router_dev_policy, #15113): active-turn cap 4, router-side policy per proud-bear-756; restored after any maintenance relaunch" as NonEmptyStr,
  },
)

// ── what this module does NOT model, keyed ───────────────────────────────────────────────────
