        base: "5fc0db6c8ab6a33455ee7db357e6f545610a208adc041ff333295681a9071bc8" as NonEmptyStr,
        replaced: "5a6ea870e852c2ec82fda8f0614d6fe6521a40d213b721c8d4712214e09c5bfa" as NonEmptyStr,
      ),
      srv1_image_file_added(
