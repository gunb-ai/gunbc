// The image and the pinned checkpoint the launch runs, exported so the router row and the witness read
// THEM rather than restating a digest (one authority; DESIGN 3).
fn srv1_serving_image() -> Srv1ServingImageDerivation {
  srv1_serving_image_derivation
}

fn srv1_serving_pinned_checkpoint() -> HubCheckpointManifest {
  qwen3_8_flash_next_manifest
}

// The recipe whose launch this is. A bare reference — importing the recipe row here would close a
// module cycle, product.fabric.serving_recipe already reading this module for the download standing.
data srv1_serving_launch_recipe: DeclarationRef = decl_ref(module_path: "product.fabric.serving_recipe", decl_name: "serving_recipe_flash_next_lab_vllm")

// ── the router upstream's LAUNCH FACTS ───────────────────────────────────────────────────────
//
// The S1 router (gunbc-router, #15113) routes Qwen3.8-Flash-Next turns to srv1's endpoint; its upstream
// row (gunbc.serving.router_dev_policy, proud-bear-756) is a router POLICY row carrying a cap the
// OPERATOR sets and a secret reference it keeps. The parts that are launch facts — the identity the
// router contacts, not what it may send — come from HERE, so a flag change at the launch moves the
// router's row and cannot leave it pointing at a stale endpoint.
//
// COORDINATION (declared, not hidden): #15113 carries the type and a literal srv1 row today; when that
// PR lands, its literal is replaced by srv1_router_upstream_launch_facts below. Until then this export
// has no production consumer on main and says so as a frontier row — the honest state, not a wired
// consumer claimed.
type Srv1RouterUpstreamLaunchFacts {
  // The router's name for the upstream, which is this container's served name.
  name: NonEmptyStr
  // The scheme and address the launch's TLS server listens at: HTTPS on the loopback address the
  // engine binds (srv1 and the router share the host). Typed, not re-invented strings (DESIGN 2):
  // the scheme is extdeps.uri's UriScheme arm (the same carrier the router's upstream URIs and
  // gunbc.spark use), and the address is extdeps.network.ipv4's Ipv4Address — a bare NonEmptyStr
  // here could spell "https://" or "localhost:18000" and the type would not notice. The router row
  // composes scheme+host+port into its Uri; render_ipv4_address gives the wire form.
  scheme: UriScheme
  host: Ipv4Address
  port: Port
  // The TLS name the router verifies. srv1's certificate is self-signed at CN=pool-card (the wrapper
  // mints it); the card's cert carries no SAN, so the router verifies this name. Read from the live
  // router deployment 2026-10-25; it is a launch fact because the mint is the launch's.
  tls_name: NonEmptyStr
  // The advertised model id — the engine's own served_model_name, read from the startup receipt, not
  // restated here as a second literal the launch could drift from.
  model: NonEmptyStr
}

// The address the engine binds: IPv4 loopback (octets 127.0.0.1 — the wrapper publishes -p
// 18000:18000 on the host stack; srv1 and the router share the host). A typed octet record, not a
// string: 256.0.0.1 and "127.0.0." are unwritable here (extdeps.network.ipv4 Octet range).
data srv1_serving_listen_address: Ipv4Address = ipv4_address(octet1: 127, octet2: 0, octet3: 0, octet4: 1)

data srv1_router_upstream_launch_facts: Srv1RouterUpstreamLaunchFacts = Srv1RouterUpstreamLaunchFacts {
  name: "srv1-vllm" as NonEmptyStr,
  scheme: Https,
  host: srv1_serving_listen_address,
  port: srv1_serving_launch.listen_port,
  tls_name: "pool-card" as NonEmptyStr,
  model: srv1_serving_startup_reading.served_model_name,
}

// ── the enrollment row: this launch, routable, with a declared ceiling ───────────────────────
//
// The FIRST-PARTY replica (srv1 is owned hardware, not rented): the identity, address and port are the
// launch's; the turn ceiling is the operator's decision (cap 4 at the 2026-10-24 router cutover,
// relayed by merry-fox-82) and is spelled CeilingByDeclaredPolicy — an allocation with a decider and a
// date, not a fabricated measurement (DESIGN 5). serving_enrollment's own rule holds: admission takes
// the minimum of this ceiling and what the route says about itself live.
data srv1_serving_route: ServingRoute = serving_replica_route(
  replica: RentedReplicaIdentity {
    node: "srv1" as NonEmptyStr,
    device_index: 0,
    served_name: srv1_router_upstream_launch_facts.name,
  },
  address: render_ipv4_address(addr: srv1_router_upstream_launch_facts.host),
  port: srv1_router_upstream_launch_facts.port,
  ceiling: CeilingByDeclaredPolicy {
    count: 4,
    decider: "operator" as NonEmptyStr,
    decided_on: "2026-10-24" as NonEmptyStr,
    basis: "S1 router cutover to srv1 (gunbc.serving.router_dev_policy, #15113): active-turn cap 4, router-side policy per proud-bear-756; restored after any maintenance relaunch" as NonEmptyStr,
  },
)

// ── what this module does NOT model, keyed ───────────────────────────────────────────────────
data srv1_serving_unmodeled_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_launch"),
    reason: "the launcher's qwen38-flash-next PROFILE supplies the engine settings the startup receipt records as observed (batched 6019, utilization 0.96, fp8 KV, MTP 3 with acceptance 2.778, gdn_auto, LMCache connector): they are in the engine's log but NOT in the wrapper's argv, so no module models them and the launch row cannot contradict them either way. srv1_router_upstream_launch_facts also has no production consumer yet: gunbc.serving.router_dev_policy (#15113) holds a literal srv1 row until that PR lands and imports this export.",
    dissolution: unbound_dissolution(description: "(1) an extdeps module for the lil-serve launcher profiles (or extdeps.lmcache) citing the profile's engine settings, after which LilServeEngineFlags carries them and the receipt restates less; (2) gunbc.serving.router_dev_policy importing srv1_router_upstream_launch_facts in place of its literal. SUFFICIENT for retiring the half of this row each closes."),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the relaunch route is unmodeled and deliberately unexecutable from here: srv1 carries live bound sessions through the router and is the CI runner and approval/ntfy host, so stop/start happens only in an operator-granted maintenance window (router cap 0, drain, --restart no inside srv1-inference.slice, exact-flag restore with readback — relayed by merry-fox-82 2026-10-25). Nothing in this module converges the container.",
    dissolution: unbound_dissolution(description: "a host-convergence step executes gunbc.serving.serving_provision_derivation serving_provision_derive's vllm arm on srv1 and reads the running container's inspect and engine banner back against it (its serving_provision_derivation frontier row carries the same trigger); the window procedure itself lands as a fleet procedure. SUFFICIENT for deleting this row, at which point the wrapper dissolves per its dissolves_to."),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.host.srv1_serving_startup_receipt", decl_name: "srv1_serving_startup_reading"),
    reason: "the receipt read the wrapper and the launch of 2026-10-30 12:28; the wrapper body has since been edited (the pool context cap, 2026-10-30), so it does not hash to the receipt's wrapper_sha256_hex, and the engine-reported context in the receipt is the launch before the cap. The host copy carries the same edit, so body and host copy agree; body and receipt do not, and nothing here asserts they do.",
    dissolution: unbound_dissolution(description: "srv1 relaunched from this body in an operator window and the startup receipt re-read: the host wrapper's SHA-256 equals this body's, the engine reports the cap, and observed_cmd_tail is re-taken with no suffix in the launch witness."),
  ),
  // One trigger row PER RETAINED EFFECT (review 86720, DESIGN 4b meta-obligation 3: a plural loss
  // needs plural triggers). The wrapper row's own dissolves_to retires only the container launch;
  // each effect below names the capability that lets its own line leave the script.
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the TLS self-mint (openssl req -x509, EC prime256v1, CN=pool-card, kept across restarts at /root/serve/tls.key|.crt) is performed by script shell; no effect row models minting a self-signed serving certificate, though the router's verification of CN=pool-card is a modeled launch fact.",
    dissolution: unbound_dissolution(description: "an exec/openssl effect row (gunbc.host host_effect_realize vocabulary or extdeps.openssl) models generating and idempotently reusing a self-signed cert at a path, after which the wrapper's [ -s tls.key ] || openssl block is a realization of that row. SUFFICIENT for retiring this trigger row."),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the events.log START record (timestamped host-event line with driver version and cache shape) is shell echo into a file; no host-event receipt row models it.",
    dissolution: unbound_dissolution(description: "a host-event receipt row (gunbc.host) models append-with-timestamp serving-lifecycle events, consumed by whatever reads events.log. SUFFICIENT for retiring this trigger row."),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the pool-key generation (head -c 24 /dev/urandom | base64, idempotent, umask 077) is shell; no secret-reference row models generating-and-holding a serving API key at a path.",
    dissolution: unbound_dissolution(description: "a secret-reference row (the vault/secret vocabulary gunbc uses for deploy-time secrets) models an idempotently generated key file at a path, which is also the row LilServeApiKeyFromFile's path should point at. SUFFICIENT for retiring this trigger row and narrowing the wrapper to nothing but the docker run."),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the key READ at exec time is the bash command substitution inside the retained wrapper body (the cat-substitution on --api-key in the docker run argument) — shell inside the sanctioned retained script, the ONLY place this repository spells it; the model carries the typed file source only (no shell in the interface, no shell-building fn).",
    // RE-KEYED 2026-10-27 (review 86879), twice. First pass named grammar-emitted shell as the
    // waiting-on — false since #15230 landed it. Second pass used retires_dissolution on
    // srv1_serving_wrapper — also wrong: a trigger pointing at the row's own subject restates the
    // wrapper's dissolves_to instead of naming a capability (DESIGN 4b meta-obligation 3). STANDING,
    // stated per 4b meta-obligation 2: CAN CLIMB NOW BUT UNBUILT. The means exist today —
    // v2.extdeps.languages.bash_build bash_build_word_cmdsubst over
    // bash_build_command_from_lits(["cat", <path>]), emitted through v2.workflow.bash_emit
    // bash_emit_stmts, consumed in production by extdeps.posix.sh_invocation
    // posix_sh_export_from_file. The trigger names the EXACT remaining step: the render fn turning
    // LilServeApiKeyFromFile.path into that grammar-emitted --api-key word. A forward trigger on an
    // unbuilt ref, with precedent — gunbc.serving.router_proxy_scaffold triggers on
    // extdeps.languages.nginx_conf nginx_conf_grammar and extdeps.languages.lua.grammar
    // lua_chunk_grammar, both unbuilt; when srv1_serving_api_key_substitution_node lands this reads
    // DissolutionFired and the row retires. Why it did not simply land in this PR: the wrapper body is
    // a verbatim retention of the script srv1 RUNS (sha256-pinned in
    // gunbc.host.srv1_serving_startup_receipt); under the operator hold I may neither rewrite that
    // observation nor relaunch the container to prove the render. The render is modelable now — the
    // adoption against the running host is the gated half — so the trigger waits on the render, not on
    // the wrapper's larger retirement.
    dissolution: bound_dissolution(ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_api_key_substitution_node")),
  ),
]
