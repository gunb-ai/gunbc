// The image and the pinned checkpoint the launch runs, exported so the router row and the witness read
// THEM rather than restating a digest (one authority; DESIGN 3).
fn srv1_serving_image() -> Srv1ServingImageDerivation {
  srv1_serving_image_derivation
}

fn srv1_serving_pinned_checkpoint() -> HubCheckpointManifest {
  qwen3_8_flash_next_manifest
}

// The recipe whose launch this is. A bare reference — importing the recipe row here would close a
// module cycle, product.fabric.serving_recipe already reading this module for the download standing.
data srv1_serving_launch_recipe: DeclarationRef = decl_ref(module_path: "product.fabric.serving_recipe", decl_name: "serving_recipe_flash_next_lab_vllm")

// ── the router upstream's LAUNCH FACTS ───────────────────────────────────────────────────────
//
// The S1 router (gunbc-router, #15113) routes Qwen3.8-Flash-Next turns to srv1's endpoint; its upstream
// row (gunbc.serving.router_dev_policy, proud-bear-756) is a router POLICY row carrying a cap the
// OPERATOR sets and a secret reference it keeps. The parts that are launch facts — the identity the
// router contacts, not what it may send — come from HERE, so a flag change at the launch moves the
// router's row and cannot leave it pointing at a stale endpoint.
//
// COORDINATION (declared, not hidden): #15113 carries the type and a literal srv1 row today; when that
// PR lands, its literal is replaced by srv1_router_upstream_launch_facts below. Until then this export
// has no production consumer on main and says so as a frontier row — the honest state, not a wired
// consumer claimed.
type Srv1RouterUpstreamLaunchFacts {
  // The router's name for the upstream, which is this container's served name.
  name: NonEmptyStr
  // The scheme and address the launch's TLS server listens at: HTTPS on the loopback address the
  // engine binds (srv1 and the router share the host). Typed, not re-invented strings (DESIGN 2):
  // the scheme is extdeps.uri's UriScheme arm (the same carrier the router's upstream URIs and
  // gunbc.spark use), and the address is extdeps.network.ipv4's Ipv4Address — a bare NonEmptyStr
  // here could spell "https://" or "localhost:18000" and the type would not notice. The router row
  // composes scheme+host+port into its Uri; render_ipv4_address gives the wire form.
  scheme: UriScheme
  host: Ipv4Address
  port: Port
  // The TLS name the router verifies. srv1's certificate is self-signed at CN=pool-card (the wrapper
  // mints it); the card's cert carries no SAN, so the router verifies this name. Read from the live
  // router deployment 2026-10-25; it is a launch fact because the mint is the launch's.
  tls_name: NonEmptyStr
  // The advertised model id — the engine's own served_model_name, read from the startup receipt, not
  // restated here as a second literal the launch could drift from.
  model: NonEmptyStr
}

// The address the engine binds: IPv4 loopback (octets 127.0.0.1 — the wrapper publishes -p
// 18000:18000 on the host stack; srv1 and the router share the host). A typed octet record, not a
// string: 256.0.0.1 and "127.0.0." are unwritable here (extdeps.network.ipv4 Octet range).
data srv1_serving_listen_address: Ipv4Address = ipv4_address(octet1: 127, octet2: 0, octet3: 0, octet4: 1)

data srv1_router_upstream_launch_facts: Srv1RouterUpstreamLaunchFacts = Srv1RouterUpstreamLaunchFacts {
  name: "srv1-vllm" as NonEmptyStr,
  scheme: Https,
  host: srv1_serving_listen_address,
  port: srv1_serving_launch.listen_port,
  tls_name: "pool-card" as NonEmptyStr,
  model: srv1_serving_startup_reading.served_model_name,
}

// ── the DECLARED GPU GROUP the launch runs on ────────────────────────────────────────────────
//
// THE BYPASS THIS SECTION REMOVES. Until now the only device selection the srv1 serving path carried
// was the retained wrapper's `--device nvidia.com/gpu=all` — a wildcard — plus the route's literal
// `device_index: 0`. `all` means "every GPU the host enumerates at container-start time": it is correct
// only while srv1 has exactly one powered card, and adding the second installed card (the RTX PRO 6000
// Workstation, gpu_board_01 — installed WITHOUT power today, gunbc.fleet.gpu_device_observation) would
// SILENTLY grow the container to two devices under a one-card engine. A wildcard cannot be reviewed and
// cannot fail closed. So the launch's device selection is now DECLARED here as a GROUP OF BOARD
// IDENTITIES, each resolved to the device identity the device itself reports (a GPU UUID) through
// gunbc.fleet.gpu_device_observation and admitted through gunbc.fleet.gpu_power_state_policy. The launch
// renders ONE `--device nvidia.com/gpu=<UUID>` per admitted member (srv1_serving_docker_device_words) and
// never `all`, and the retained wrapper the boot unit INSTALLS for the next boot (srv1_serving_wrapper,
// installed by gunbc.live_deploy.srv1_serving_engine_unit) carries that per-device flag — the `all`
// wildcard is REMOVED from the install authority, not left to be reinterpreted. (Fleet hardware-fact
// consumption #16045, deliverable 3.) Whether the RUNNING container was started from the pre-change `all`
// body is the model-ahead-of-host case srv1_serving_wrapper_adoption types as PendingOperatorRelaunch,
// which the operator closes by a relaunch (this module never starts or stops the live container).
//
// READINESS BELONGS TO THE SELECTED CONFIGURATION, NOT TO THE HOST. The one-card configuration is
// evaluated against ITS OWN members only, so it stays evaluable while the Workstation card is pending;
// a tensor-parallel (TP=2) configuration requires BOTH members and, when one is missing, REFUSES — it
// never degrades to a one-device launch, which would run a tensor-parallel model on a single card. The
// tensor-parallel degree IS the member count (one board = one device = one rank), so it can never
// disagree with the group it counts.

// The operator's declaration of which installed boards the served configuration runs on. Membership is
// a decision with a decider and a date (DESIGN 5), not a wildcard that silently reinterprets itself.
type Srv1ServingGpuGroup {
  decider: NonEmptyStr
  decided_on: NonEmptyStr
  basis: NonEmptyStr
  boards: List<PhysicalAssetIdentity>
}

data srv1_serving_gpu_group: Srv1ServingGpuGroup = Srv1ServingGpuGroup {
  decider: "operator" as NonEmptyStr,
  decided_on: "2026-11-07" as NonEmptyStr,
  basis: "srv1 serves flash-next on the one powered card, the Max-Q (gpu_board_04). The RTX PRO 6000 Workstation (gpu_board_01) is installed WITHOUT POWER and is NOT a member: it does not join the served configuration by being physically present. Admitting it is a NEW declaration that raises the tensor-parallel degree to two and then requires BOTH members to resolve and qualify — fleet hardware-fact consumption #16045." as NonEmptyStr,
  boards: [gpu_board_04],
}

// One member's resolved place in the launch: the device UUID (from the observation authority) and its
// rank in the group (which feeds the served route's device_index). A pending member carries the operator
// action that would resolve it; there is no partial success.
type Srv1ServingDeviceMember
  = Srv1ServingDeviceSelected { board: PhysicalAssetIdentity, gpu_uuid: NonEmptyStr, rank: Nat }
  | Srv1ServingDevicePending { board: PhysicalAssetIdentity, rank: Nat, pending: NonEmptyStr }

// Whether a whole group resolved: all members selected, or refused listing the members that did not. There
// is deliberately no partial arm — a group that cannot fully resolve renders NOTHING, which is exactly what
// makes a TP=2 group refuse instead of silently launching on one card.
type Srv1ServingDeviceSelection
  = Srv1ServingDevicesSelected { tensor_parallel: Nat, members: List<Srv1ServingDeviceMember> }
  | Srv1ServingDevicesRefused { tensor_parallel: Nat, pending: List<NonEmptyStr> }

type Srv1ServingRankedMembers { rank: Nat, members: List<Srv1ServingDeviceMember> }

fn srv1_serving_nat_count(xs: List<Srv1ServingDeviceMember>) -> Nat {
  fold(xs, init: Zero, f: (n, _) => Succ { prev: n })
}

// A board resolves to an admitted device only when the OBSERVATION says the device enumerated and read its
// UUID (gunbc.fleet.gpu_device_observation — the single authority for how the device names itself) AND the
// policy join admits the decided cap within the device's range (gunbc.fleet.gpu_power_state_policy, joined
// against the SAME observation, read once). The UUID is taken from the observation, not from the admission's
// copy, so the observation is the one place the device identity comes from.
fn srv1_serving_member(board: PhysicalAssetIdentity, rank: Nat) -> Srv1ServingDeviceMember {
  let observation = current_gpu_device_observations_of(board: board).first()
  match first_where(installed_gpu_cap_intents, i => physical_asset_identity_eq(a: i.board, b: board)) {
    Absent => Srv1ServingDevicePending { board: board, rank: rank, pending: "the board carries no GPU power-cap intent, so it has no admitted device to launch on" as NonEmptyStr }
    Present { value: intent } => match observation {
      Absent => Srv1ServingDevicePending { board: board, rank: rank, pending: "no device observation exists for the board: read its GPU UUID and power-limit range" as NonEmptyStr }
      Present { value: o } => match o {
        GpuDeviceNotEnumerated { host: _, board: _, cause: c, read_on: _ } =>
          Srv1ServingDevicePending { board: board, rank: rank, pending: c }
        GpuDeviceEnumerated { host: _, board: _, gpu_uuid: uuid_opt, pci_address: _, power_limit_minimum: _, power_limit_maximum: _, power_limit_current: _, read_on: _ } =>
          match uuid_opt {
            Absent => Srv1ServingDevicePending { board: board, rank: rank, pending: "the device enumerates but its GPU UUID was not read; a device is admitted by UUID, never by an index or slot that can change" as NonEmptyStr }
            Present { value: uuid } => match admit_gpu_cap_against(intent: intent, observation: observation) {
              GpuCapAdmitted { host: _, board: _, gpu_uuid: _, cap: _ } => Srv1ServingDeviceSelected { board: board, gpu_uuid: uuid, rank: rank }
              GpuCapOutsideDeviceRange { board: _, cap: _, minimum: _, maximum: _ } => Srv1ServingDevicePending { board: board, rank: rank, pending: "the decided cap is outside the device's power.limit range" as NonEmptyStr }
              GpuCapDevicePending { board: _, cap: _, read_obligation: r } => Srv1ServingDevicePending { board: board, rank: rank, pending: r }
            }
          }
      }
    }
  }
}

fn srv1_serving_ranked_members(boards: List<PhysicalAssetIdentity>) -> List<Srv1ServingDeviceMember> {
  fold(boards, init: Srv1ServingRankedMembers { rank: Zero, members: [] }, f: (acc, b) =>
    Srv1ServingRankedMembers {
      rank: Succ { prev: acc.rank },
      members: concat(acc.members, [srv1_serving_member(board: b, rank: acc.rank)]),
    }
  ).members
}

// Whole-group-or-nothing. An empty group is refused, never read as "zero devices is fine".
fn srv1_serving_group_selection(group: Srv1ServingGpuGroup) -> Srv1ServingDeviceSelection {
  let members = srv1_serving_ranked_members(boards: group.boards)
  let pending = filter(members, m => match m {
    Srv1ServingDevicePending { board: _, rank: _, pending: _ } => true
    Srv1ServingDeviceSelected { board: _, gpu_uuid: _, rank: _ } => false
  })
  match srv1_serving_nat_count(xs: members) {
    Zero => Srv1ServingDevicesRefused { tensor_parallel: Zero, pending: ["the declared group names no board" as NonEmptyStr] }
    Succ { prev: _ } => match srv1_serving_nat_count(xs: pending) {
      Zero => Srv1ServingDevicesSelected { tensor_parallel: srv1_serving_nat_count(xs: members), members: members }
      Succ { prev: _ } => Srv1ServingDevicesRefused {
        tensor_parallel: srv1_serving_nat_count(xs: members),
        pending: map(pending, p => match p {
          Srv1ServingDevicePending { board: b, rank: _, pending: r } => join([b as String, ": ", r as String], "") as NonEmptyStr
          Srv1ServingDeviceSelected { board: _, gpu_uuid: _, rank: _ } => "resolved" as NonEmptyStr
        }),
      }
    }
  }
}

// The docker `--device` words: two tokens per admitted device (`--device` then the CDI device selector from
// extdeps.container.nvidia_container_toolkit). A pending member contributes NOTHING, so a TP=2 group that
// cannot fully resolve renders NO device — never one, never `all`. Such a body is not an installable wrapper:
// srv1_serving_wrapper_adoption reports Srv1ServingWrapperNotInstallable (and srv1_serving_device_gate refuses
// the deploy install), so no plausible GPU-less container is ever staged (DESIGN 5: no plausible output is
// fabricated — the model refuses instead).
fn srv1_serving_docker_device_words_of(members: List<Srv1ServingDeviceMember>) -> List<NonEmptyStr> {
  members.flat_map(m => match m {
    Srv1ServingDeviceSelected { board: _, gpu_uuid: u, rank: _ } => ["--device" as NonEmptyStr, nvidia_cdi_device_selector_of(uuid: u)]
    Srv1ServingDevicePending { board: _, rank: _, pending: _ } => []
  })
}

// The launch's device flags for the declared group. Today: exactly `--device nvidia.com/gpu=<Max-Q UUID>`
// (one pair); NEVER `nvidia.com/gpu=all`. The witness pins this render to the UUID the observation reports.
data srv1_serving_docker_device_words: List<NonEmptyStr> = match srv1_serving_group_selection(group: srv1_serving_gpu_group) {
  Srv1ServingDevicesSelected { tensor_parallel: _, members: ms } => srv1_serving_docker_device_words_of(members: ms)
  Srv1ServingDevicesRefused { tensor_parallel: _, pending: _ } => []
}

// The per-device `--device` words the wrapper passes, rendered ONCE from the declared group and interpolated
// into srv1_serving_wrapper.body at model load (exactly how --max-model-len renders serving_fleet_context_cap):
// the device UUID has ONE home — gunbc.fleet.gpu_device_observation, joined through gunbc.fleet.gpu_power_state_policy
// into srv1_serving_docker_device_words — and the installed wrapper is CONSTRUCTED from it, not validated against
// it (DESIGN 5: correctness by construction, not a check that restates a constraint the model already carries).
// For the one-card group this is `--device nvidia.com/gpu=<Max-Q UUID>`; a TP=2 group renders one flag per member.
data srv1_serving_docker_device_flag: String = join(map(srv1_serving_docker_device_words, w => w as String), " ")

// THE INSTALL-TIME CONTROL ON THE REAL DEPLOY PATH. The boot unit installs srv1_serving_wrapper.body — whose
// `--device` is CONSTRUCTED from srv1_serving_docker_device_flag above, so `all` is unwritable — and the engine
// wrapper is installed only when the declared group RESOLVES to a fully admitted device set. A group that cannot
// resolve (a pending member, an empty declaration, a TP=2 declaration missing a member) REFUSES the install: the
// wrapper that would start the served model against devices the group did not admit is never written. Read by
// gunbc.live_deploy.apply_legs deploy_apply_srv1_serving_engine_plan. (The power-limit READBACK that lets a
// qualified device run is NOT restated here: it is owned by gunbc.fleet.gpu_power_cap_converge and enforced on the
// real path by the engine unit's Requires=/After= on the cap unit — gunbc.live_deploy.srv1_gpu_power_cap_unit.)
type Srv1ServingDeviceGate
  = Srv1ServingDevicesAdmitted {}
  | Srv1ServingDeviceGateRefused { reason: NonEmptyStr }

fn srv1_serving_device_gate() -> Srv1ServingDeviceGate {
  match srv1_serving_group_selection(group: srv1_serving_gpu_group) {
    Srv1ServingDevicesRefused { tensor_parallel: _, pending: ps } => Srv1ServingDeviceGateRefused {
      reason: join(
        ["the declared GPU group does not resolve to a fully admitted device set (pending: ", join(map(ps, p => p as String), "; "), ") — refusing to install an engine wrapper that would start the served model against devices the group did not admit (DESIGN 5: refuse, never widen)"],
        "",
      ) as NonEmptyStr,
    }
    Srv1ServingDevicesSelected { tensor_parallel: _, members: _ } => Srv1ServingDevicesAdmitted {}
  }
}

// The state of the installed wrapper against the host the running container was launched from
// (gunbc.host.srv1_serving_startup_receipt wrapper_sha256_hex).
//
//  - Refused group → Srv1ServingWrapperNotInstallable. When the declared group cannot resolve to a fully
//    admitted set there is NOTHING to install: srv1_serving_docker_device_words renders no device, and rather
//    than present a plausible GPU-less `docker run` as an installable body (DESIGN 5: no plausible output is
//    fabricated), the model says outright it is not installable. It is the SAME condition
//    srv1_serving_device_gate reports (the deploy consults the gate), so the wrapper the boot unit could stage
//    is never a silent no-device container.
//  - Admitted group → the model body is Adopted once its sha equals the running wrapper's, and
//    PendingOperatorRelaunch while it is ahead of the host: a DECLARED, TYPED relaunch the OPERATOR performs —
//    NOT a red witness and NOT an automatic restart (this module never stops or starts the live container; see
//    gunbc.recurring_failure_mode a_relaunch_from_the_retained_wrapper_reverts_an_image_applied_outside_it).
type Srv1ServingWrapperAdoption
  = Srv1ServingWrapperNotInstallable { reason: NonEmptyStr }
  | Srv1ServingWrapperAdopted { wrapper_sha256_hex: NonEmptyStr }
  | Srv1ServingWrapperPendingOperatorRelaunch { running_sha256_hex: NonEmptyStr, installed_sha256_hex: NonEmptyStr, obligation: NonEmptyStr }

fn srv1_serving_wrapper_installed_vs_running(installed: NonEmptyStr, running: NonEmptyStr) -> Srv1ServingWrapperAdoption {
  if installed == (running as String) {
    Srv1ServingWrapperAdopted { wrapper_sha256_hex: running }
  } else {
    Srv1ServingWrapperPendingOperatorRelaunch {
      running_sha256_hex: running,
      installed_sha256_hex: installed,
      obligation: "the wrapper the boot unit installs carries the declared group's per-device --device, which the RUNNING container's wrapper does not yet: relaunch srv1's engine from the installed wrapper to adopt it (operator maintenance; the boot unit installs it and never starts it, so the next boot adopts it too)" as NonEmptyStr,
    }
  }
}

fn srv1_serving_wrapper_adoption() -> Srv1ServingWrapperAdoption {
  let installed = sha256_hex_of_text(text: srv1_serving_wrapper.body) as NonEmptyStr
  let running = srv1_serving_startup_reading.wrapper_sha256_hex
  match srv1_serving_device_gate() {
    Srv1ServingDeviceGateRefused { reason: r } => Srv1ServingWrapperNotInstallable { reason: r }
    Srv1ServingDevicesAdmitted {} => srv1_serving_wrapper_installed_vs_running(installed: installed, running: running)
  }
}

// THE DECLARED CLOSURE TRIGGER the wrapper frontier row dissolves into (gunbc.std.dissolution bound_dissolution):
// the modelled condition under which the operator's relaunch obligation is DISCHARGED. It resolves to the
// adoption condition above — the row retires when this reports Srv1ServingWrapperAdopted (a startup receipt reads
// the running wrapper's sha equal to the installed body's). It is a real declaration, not a forward reference to
// an unbuilt row, so the frontier row names a trigger that EXISTS (DESIGN 4b "a class below ceiling names its
// next-rung trigger"; DESIGN 3 "a home that does not resolve is a citation defect").
data srv1_serving_device_flag_adoption_node: Srv1ServingWrapperAdoption = srv1_serving_wrapper_adoption()

// ── the enrollment row: this launch, routable, with a declared ceiling ───────────────────────
//
// The FIRST-PARTY replica (srv1 is owned hardware, not rented): the identity, address and port are the
// launch's; the turn ceiling is the operator's decision (cap 4 at the 2026-10-24 router cutover,
// relayed by merry-fox-82) and is spelled CeilingByDeclaredPolicy — an allocation with a decider and a
// date, not a fabricated measurement (DESIGN 5). serving_enrollment's own rule holds: admission takes
// the minimum of this ceiling and what the route says about itself live.
//
// The device_index the replica identity carries is now DERIVED from the declared group's served member,
// not a literal `0`: the literal was an independent value that did not track the device the engine
// actually runs on, and it silently lied once `all` grew to a second card. The route resolves only when
// the group's own devices resolve and admit; if they do not, it is ServingRouteUnresolved (a declared
// obligation), never a route pinned to an unqualified device.
data srv1_serving_route: ServingRoute = srv1_serving_declared_route()

// The ordinal the engine binds, carried in RentedReplicaIdentity.device_index. It is the served device's
// position in the DECLARED group, which is ALSO its ordinal inside the container: the installed wrapper
// passes exactly the admitted devices via per-device CDI selectors (interpolated from srv1_serving_docker_device_flag),
// so the container re-enumerates only those, in this declared order — it cannot name a host device the group
// does not declare. This is deliberately NOT a host nvidia-smi index (which is what the rented pool's
// device_index tracks): deriving it from the declared ordering is what keeps the route correct when a second
// card is later powered and the Max-Q re-enumerates to a different host index.
fn srv1_serving_served_device_rank() -> Nat {
  match srv1_serving_ranked_members(boards: srv1_serving_gpu_group.boards).first() {
    Present { value: Srv1ServingDeviceSelected { board: _, gpu_uuid: _, rank: r } } => r
    Present { value: Srv1ServingDevicePending { board: _, rank: r, pending: _ } } => r
    // No board declared: the route is ServingRouteUnresolved (srv1_serving_declared_route) and this index is
    // never read by a live route — Zero is the first position of the empty declared ordering, not a stand-in
    // for a measurement.
    Absent => Zero
  }
}

fn srv1_serving_declared_route() -> ServingRoute {
  let replica = RentedReplicaIdentity {
    node: "srv1" as NonEmptyStr,
    device_index: srv1_serving_served_device_rank(),
    served_name: srv1_router_upstream_launch_facts.name,
  }
  let ceiling = CeilingByDeclaredPolicy {
    count: 4,
    decider: "operator" as NonEmptyStr,
    decided_on: "2026-10-24" as NonEmptyStr,
    basis: "S1 router cutover to srv1 (gunbc.serving.router_dev_policy, #15113): active-turn cap 4, router-side policy per proud-bear-756; restored after any maintenance relaunch" as NonEmptyStr,
  }
  match srv1_serving_group_selection(group: srv1_serving_gpu_group) {
    Srv1ServingDevicesSelected { tensor_parallel: _, members: _ } => serving_replica_route(
      replica: replica,
      address: render_ipv4_address(addr: srv1_router_upstream_launch_facts.host),
      port: srv1_router_upstream_launch_facts.port,
      ceiling: ceiling,
    )
    Srv1ServingDevicesRefused { tensor_parallel: _, pending: _ } => ServingRouteUnresolved {
      replica: replica,
      obligation: "the declared GPU group has no fully admitted device to serve from; see srv1_serving_group_selection for which member is unresolved" as NonEmptyStr,
    }
  }
}

// ── what this module does NOT model, keyed ───────────────────────────────────────────────────
data srv1_serving_unmodeled_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_launch"),
    reason: "the launcher's qwen38-flash-next PROFILE supplies the engine settings the startup receipt records as observed (batched 6019, utilization 0.96, fp8 KV, MTP 3 with acceptance 2.778, gdn_auto, LMCache connector): they are in the engine's log but NOT in the wrapper's argv, so no module models them and the launch row cannot contradict them either way. srv1_router_upstream_launch_facts also has no production consumer yet: gunbc.serving.router_dev_policy (#15113) holds a literal srv1 row until that PR lands and imports this export.",
    dissolution: unbound_dissolution(description: "(1) an extdeps module for the lil-serve launcher profiles (or extdeps.lmcache) citing the profile's engine settings, after which LilServeEngineFlags carries them and the receipt restates less; (2) gunbc.serving.router_dev_policy importing srv1_router_upstream_launch_facts in place of its literal. SUFFICIENT for retiring the half of this row each closes."),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the relaunch route is unmodeled and deliberately unexecutable from here: srv1 carries live bound sessions through the router and is the CI runner and approval/ntfy host, so stopping or relaunching a RUNNING engine happens only in an operator-granted maintenance window (router cap 0, drain, --restart no inside srv1-inference.slice, exact-flag restore with readback — relayed by merry-fox-82 2026-10-25). Nothing in this module converges the container. The START AT BOOT, when nothing is bound, is converged by gunbc.live_deploy.srv1_serving_engine_unit (operator, 2026-11-02), which installs this wrapper and enables a boot unit but never starts or restarts the engine during an apply.",
    dissolution: unbound_dissolution(description: "a host-convergence step executes gunbc.serving.serving_provision_derivation serving_provision_derive's vllm arm on srv1 and reads the running container's inspect and engine banner back against it (its serving_provision_derivation frontier row carries the same trigger); the window procedure itself lands as a fleet procedure. SUFFICIENT for deleting this row, at which point the wrapper dissolves per its dissolves_to."),
  ),
  // One trigger row PER RETAINED EFFECT (review 86720, DESIGN 4b meta-obligation 3: a plural loss
  // needs plural triggers). The wrapper row's own dissolves_to retires only the container launch;
  // each effect below names the capability that lets its own line leave the script.
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the TLS self-mint (openssl req -x509, EC prime256v1, CN=pool-card, kept across restarts at /root/serve/tls.key|.crt) is performed by script shell; no effect row models minting a self-signed serving certificate, though the router's verification of CN=pool-card is a modeled launch fact.",
    dissolution: unbound_dissolution(description: "an exec/openssl effect row (gunbc.host host_effect_realize vocabulary or extdeps.openssl) models generating and idempotently reusing a self-signed cert at a path, after which the wrapper's [ -s tls.key ] || openssl block is a realization of that row. SUFFICIENT for retiring this trigger row."),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the events.log START record (timestamped host-event line with driver version and cache shape) is shell echo into a file; no host-event receipt row models it.",
    dissolution: unbound_dissolution(description: "a host-event receipt row (gunbc.host) models append-with-timestamp serving-lifecycle events, consumed by whatever reads events.log. SUFFICIENT for retiring this trigger row."),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the pool-key generation (head -c 24 /dev/urandom | base64, idempotent, umask 077) is shell; no secret-reference row models generating-and-holding a serving API key at a path.",
    dissolution: unbound_dissolution(description: "a secret-reference row (the vault/secret vocabulary gunbc uses for deploy-time secrets) models an idempotently generated key file at a path, which is also the row LilServeApiKeyFromFile's path should point at. SUFFICIENT for retiring this trigger row and narrowing the wrapper to nothing but the docker run."),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.srv1_serving_launch", decl_name: "srv1_serving_wrapper"),
    reason: "the key READ at exec time is the bash command substitution inside the retained wrapper body (the cat-substitution on --api-key in the docker run argument) — shell inside the sanctioned retained script, the ONLY place this repository spells it; the model carries the typed file source only (no shell in the interface, no shell-building fn).",
    // RE-KEYED 2026-10-27 (review 86879), twice. First pass named grammar-emitted shell as the
    // waiting-on — false since #15230 landed it. Second pass used retires_dissolution on
    // srv1_serving_wrapper — also wrong: a trigger pointing at the row's own subject restates the
    // wrapper's dissolves_to instead of naming a capability (DESIGN 4b meta-obligation 3). STANDING,
    // stated per 4b meta-obligation 2: CAN CLIMB NOW BUT UNBUILT. The means exist today —
    // v2.extdeps.languages.bash_build bash_build_word_cmdsubst over
    // bash_build_command_from_lits(["cat", <path>]), emitted through v2.workflow.bash_emit
    // bash_emit_stmts, consumed in production by extdeps.posix.sh_invocation
