module gunbc.serving.serving_availability

import std.types { String, NonEmptyStr, Timestamp }
import std.measure { Second, second_count }
import product.fabric.demand { ObservationReceiptRef }
import gunbc.serving.serving_enrollment { ServingRouteEndpoint, serving_route_endpoint_wire }
import gunbc.spark.vllm_endpoint_process_launch {
  VllmEndpointProcessLaunch, VllmEndpointProcessLaunchObservation, LaunchObserved, LaunchUnobserved,
  vllm_endpoint_process_launch_is, vllm_endpoint_process_launch_key,
}

// ── WHETHER A SERVING ROUTE CAN TAKE NEW WORK, AS ONE READING ────────────────────────────────
//
// This is the authority every consumer projects from: offer readiness
// (gunbc.spark.serving_offer spark_serving_readiness_of) and the seat fence
// (gunbc.harness.harness_seat harness_fence_grant) both answer from it, so there is one statement
// of whether a route can serve rather than one per consumer.
//
// THREE ARMS, BECAUSE THE REMEDIES ARE THREE. Available is a reading that succeeded. Unavailable is a
// reading that succeeded and said no, with the typed reason. Unread is a reading that could not be
// taken at all -- the answer is not "no", it is "not established" -- and it must never be folded
// into either of the others, which would be the ⊤/⊥-as-ignorance conflation DESIGN §5 forbids.
//
// EVERY ARM CARRIES WHEN AND FROM WHERE, AND AVAILABLE CARRIES WHICH PROCESS ANSWERED. A bare Available
// with no time can outlive the observation that produced it, and one with no launch can be attached to
// an offer on a DIFFERENT exporter process: the models probe and the metrics probe are two reads, and a
// restart between them would otherwise pair process A's answer with process B's identity.
//
// MODEL ADMISSION IS NOT AVAILABILITY. A route serving a model this harness is not admitted to ask can
// still take work from a consumer that is; whether this demand may use what the route advertises is
// gunbc.serving.admitted_model's question, decided beside this one, never folded into it.
//
// THE GRAIN IS THE ENDPOINT PROCESS, NOT THE ENGINE. The launch identity here is the process that
// exports /metrics (gunbc.rung_drop serving_offer_identity_is_the_exporter_process). An unchanged
// exporter does not establish the same engine core, rank population or loaded model, and a live
// exporter over a stalled engine core reads Available. Detecting that is not this cut's to claim.
type ServingAvailability
  = ServingAvailable {
      endpoint: ServingRouteEndpoint
      launch: VllmEndpointProcessLaunch
      observed_at: Timestamp
      receipt: ObservationReceiptRef
    }
  | ServingUnavailable {
      endpoint: ServingRouteEndpoint
      observed_at: Timestamp
      cause: ServingUnavailableCause
      receipt: ObservationReceiptRef
    }
  | ServingAvailabilityUnread {
      endpoint: ServingRouteEndpoint
      attempted_at: Timestamp
      cause: NonEmptyStr
    }

// THE EVALUATED FRONT-DOOR VERDICT, SEALED. ServingAvailability is a coproduct a caller can write, and a
// sole_constructor wall on coproduct variants is not enforced on the .dag path (DESIGN §4b), so the
// verdict an offer consumer accepts is this record around it, and only serving_availability_bracketing_read
// mints one -- so holding it means a bounded front-door read happened between two launch reads. A caller
// that wants an offer cannot substitute the cheaper launch-only read, which mints a different verdict.
// Raw evidence -- FrontDoorRead, a launch observation -- stays freely constructible; it is input, not
// a conclusion.
type ServingFrontDoorAvailabilityVerdict sole_constructor {
  reading: ServingAvailability
}

// THE OTHER EVALUATED RESULT, AND IT IS A DIFFERENT PROPOSITION. "the exporter process that answered
// earlier is still the one answering" is not "the front door answered under one stable process": a seat
// fence needs the first, an offer needs the second, and one sealed type carrying both would let the
// cheaper read mint the verdict the expensive one is supposed to establish. So continuity has its own
// carrier, its own verdict, and no path from it to the offer binder.
type EndpointProcessContinuity
  = EndpointProcessUnchanged { endpoint: ServingRouteEndpoint, launch: VllmEndpointProcessLaunch, observed_at: Timestamp, receipt: ObservationReceiptRef }
  | EndpointProcessWasReplaced { endpoint: ServingRouteEndpoint, expected: VllmEndpointProcessLaunch, observed: VllmEndpointProcessLaunch, observed_at: Timestamp, receipt: ObservationReceiptRef }
  | EndpointProcessContinuityUnread { endpoint: ServingRouteEndpoint, attempted_at: Timestamp, cause: NonEmptyStr }

type EndpointProcessContinuityVerdict sole_constructor {
  reading: EndpointProcessContinuity
}

fn endpoint_process_continuity_text(c: EndpointProcessContinuity) -> String {
  match c {
    EndpointProcessUnchanged { endpoint: e, launch: l, observed_at: t, receipt: _ } =>
      join([serving_route_endpoint_wire(e: e) as String, " still answered by endpoint process ", vllm_endpoint_process_launch_key(launch: l) as String, " at ", t], "")
    EndpointProcessWasReplaced { endpoint: e, expected: x, observed: o, observed_at: t, receipt: _ } =>
      join([serving_route_endpoint_wire(e: e) as String, " endpoint process was replaced by ", t, ": bound to ", vllm_endpoint_process_launch_key(launch: x) as String, ", now ", vllm_endpoint_process_launch_key(launch: o) as String], "")
    EndpointProcessContinuityUnread { endpoint: e, attempted_at: t, cause: c2 } =>
      join([serving_route_endpoint_wire(e: e) as String, " endpoint process unread at ", t, ": ", c2 as String], "")
  }
}

// WHAT THE TRANSPORT ESTABLISHES, AND NOTHING STRONGER. A bounded GET reports one Bool, which cannot
// tell a silent socket from a refused connection or an HTTP 500, so the front-door arm says exactly
// what was seen -- no successful answer inside the bound -- and does not claim the engine is hung.
type ServingUnavailableCause
  = FrontDoorDidNotAnswerSuccessfullyWithinBound { url: NonEmptyStr, bound: Second }
  | EndpointProcessReplaced { expected: VllmEndpointProcessLaunch, observed: VllmEndpointProcessLaunch }

// WHAT THE FRONT-DOOR READ ITSELF ESTABLISHED, before any launch is joined to it. An answer that parsed
// is an answer whatever model it names; an answer nobody could read establishes nothing.
type FrontDoorRead
  = FrontDoorAnswered
  | FrontDoorDidNotAnswer { url: NonEmptyStr, bound: Second }
  | FrontDoorAnswerUnreadable { cause: NonEmptyStr }

fn serving_unavailable_cause_text(cause: ServingUnavailableCause) -> String {
  match cause {
    FrontDoorDidNotAnswerSuccessfullyWithinBound { url: u, bound: b } =>
      join(["the route at ", u as String, " did not answer successfully within ", to_string(second_count(s: b)), "s"], "")
    EndpointProcessReplaced { expected: e, observed: o } =>
      join([
        "the endpoint process was replaced: bound to ", vllm_endpoint_process_launch_key(launch: e) as String,
        ", now serving ", vllm_endpoint_process_launch_key(launch: o) as String,
      ], "")
  }
}

fn serving_availability_text(a: ServingAvailability) -> String {
  match a {
    ServingAvailable { endpoint: e, launch: l, observed_at: t, receipt: _ } =>
      join([serving_route_endpoint_wire(e: e) as String, " available at ", t, " from endpoint process ", vllm_endpoint_process_launch_key(launch: l) as String], "")
    ServingUnavailable { endpoint: e, observed_at: t, cause: c, receipt: _ } =>
      join([serving_route_endpoint_wire(e: e) as String, " unavailable at ", t, ": ", serving_unavailable_cause_text(cause: c)], "")
    ServingAvailabilityUnread { endpoint: e, attempted_at: t, cause: c } =>
      join([serving_route_endpoint_wire(e: e) as String, " availability unread at ", t, ": ", c as String], "")
  }
}

// THE LAUNCH READING AGAINST THE LAUNCH A SEAT OR OFFER WAS BOUND TO. Same process: available. A
// different process: unavailable, naming both, because work bound to the first must not land on the
// second. No reading: unread, never available -- an exporter that could not be identified is not
// evidence that the bound one is still there.
fn serving_availability_after_launch_read(
  endpoint: ServingRouteEndpoint,
  expected: VllmEndpointProcessLaunch,
  observation: VllmEndpointProcessLaunchObservation,
  now: Timestamp,
) -> EndpointProcessContinuityVerdict {
  EndpointProcessContinuityVerdict { reading: match observation {
    LaunchUnobserved { group: _, obligation: o } =>
      EndpointProcessContinuityUnread { endpoint: endpoint, attempted_at: now, cause: o }
    LaunchObserved { launch: current, receipt: r } =>
      if vllm_endpoint_process_launch_is(launch: current, other: expected) {
        EndpointProcessUnchanged { endpoint: endpoint, launch: current, observed_at: now, receipt: r }
      } else {
        EndpointProcessWasReplaced { endpoint: endpoint, expected: expected, observed: current, observed_at: now, receipt: r }
      }
  } }
}

// A FRONT-DOOR READ BRACKETED BY TWO LAUNCH READS. The launch is read before and after the front door;
// only when both name the same exporter process is the answer attributed to it. A different process
// after than before is a restart inside the bracket, so the answer belongs to neither with certainty and
// the route is unavailable naming both. Either launch unread, or an unreadable answer, is unread.
fn serving_availability_bracketing_read(
  endpoint: ServingRouteEndpoint,
  before: VllmEndpointProcessLaunchObservation,
  front_door: FrontDoorRead,
  after: VllmEndpointProcessLaunchObservation,
  now: Timestamp,
) -> ServingFrontDoorAvailabilityVerdict {
  match front_door {
    FrontDoorDidNotAnswer { url: u, bound: b } =>
      ServingFrontDoorAvailabilityVerdict { reading: ServingUnavailable { endpoint: endpoint, observed_at: now, cause: FrontDoorDidNotAnswerSuccessfullyWithinBound { url: u, bound: b }, receipt: "gunbc.serving.front-door-read" as ObservationReceiptRef } }
    FrontDoorAnswerUnreadable { cause: c } =>
      ServingFrontDoorAvailabilityVerdict { reading: ServingAvailabilityUnread { endpoint: endpoint, attempted_at: now, cause: c } }
    FrontDoorAnswered =>
      match before {
        LaunchUnobserved { group: _, obligation: o } =>
          ServingFrontDoorAvailabilityVerdict { reading: ServingAvailabilityUnread { endpoint: endpoint, attempted_at: now, cause: o } }
        LaunchObserved { launch: first, receipt: _ } =>
          ServingFrontDoorAvailabilityVerdict { reading: match serving_availability_after_launch_read(endpoint: endpoint, expected: first, observation: after, now: now).reading {
            EndpointProcessContinuityUnread { endpoint: _, attempted_at: _, cause: o } =>
              ServingAvailabilityUnread { endpoint: endpoint, attempted_at: now, cause: o }
            EndpointProcessUnchanged { endpoint: _, launch: l, observed_at: _, receipt: r } =>
              ServingAvailable { endpoint: endpoint, launch: l, observed_at: now, receipt: r }
            EndpointProcessWasReplaced { endpoint: _, expected: x, observed: o2, observed_at: _, receipt: r } =>
              ServingUnavailable { endpoint: endpoint, observed_at: now, cause: EndpointProcessReplaced { expected: x, observed: o2 }, receipt: r }
          } }
      }
  }
}
