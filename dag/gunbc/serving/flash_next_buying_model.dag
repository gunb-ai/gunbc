module gunbc.serving.flash_next_buying_model

import std.types { Bool, List, NonEmptyStr }
import std.nat { Nat, nat_range_inclusive, nat_min }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }
import gunbc.serving.flash_next_experiment_identity { ServingVariant, H200UpstreamV032, B200UpstreamV032 }
import gunbc.serving.flash_next_topology { ServingTopology }
import gunbc.serving.flash_next_quant_matrix { QuantCell, WeightNvfp4LilQad, KvFp8, CellMeasured, flash_next_quant_matrix, quant_matrix_outcome }
import gunbc.serving.flash_next_maxq_fork_measurements { ForkMaxQ300, fork_kv_pool, layout }

// THE BUYING MODEL: TYPES AND FORMULAS ONLY. Price, host cost, wall power, energy price, cooling and site budget are
// PARAMETERS of the functions below; no value of any of them is committed here (operator ruling: no quotes, prices, site or
// rental details in the public repository until the gunbc-private question is answered). The synthetic inputs in
// test.claim.flash_next_serving_witness exercise the formulas and say nothing about any real offer.

// 1. PURCHASABLE UNITS, NOT CHIPS. What can be bought is a node, and whether a node of a given card count exists is a
// quote fact, not a property of the chip. NVIDIA ships B200 as SXM in 8-GPU HGX/DGX; a single or dual B200 node is a
// hypothesis until a supplier quotes it.
type UnitCardFamily = UnitB200 | UnitH200Nvl | UnitRtxPro6000MaxQ | UnitRtxPro6000Workstation

type UnitStanding
  = ShipsAsStandardNode { cited: CitedFigureStanding }
  | ExistenceIsAQuoteFact { hypothesis: NonEmptyStr }

type PurchasableUnit {
  family: UnitCardFamily
  cards: Nat
  standing: UnitStanding
}

data b200_hgx_read_obligation: NonEmptyStr = "NVIDIA HGX B200 / DGX B200 product pages: B200 ships as SXM modules in an 8-GPU baseboard" as NonEmptyStr

data b200_hgx_standing: UnitStanding = ShipsAsStandardNode { cited: TranscribedUncited { read_obligation: b200_hgx_read_obligation } }

data quote_fact_hypothesis: NonEmptyStr = "a supplier quotes a node with exactly this card count; until then its existence is a hypothesis" as NonEmptyStr

data quote_fact_standing: UnitStanding = ExistenceIsAQuoteFact { hypothesis: quote_fact_hypothesis }

fn family_is_b200(f: UnitCardFamily) -> Bool {
  match f {
    UnitB200 => true
    _ => false
  }
}

fn unit_standing(family: UnitCardFamily, cards: Nat) -> UnitStanding {
  if family_is_b200(f: family) && cards == 8 {
    b200_hgx_standing
  } else {
    quote_fact_standing
  }
}

fn purchasable_unit(family: UnitCardFamily, cards: Nat) -> PurchasableUnit {
  PurchasableUnit { family: family, cards: cards, standing: unit_standing(family: family, cards: cards) }
}

data flash_next_candidate_units: List<PurchasableUnit> = [
  purchasable_unit(family: UnitB200, cards: 1),
  purchasable_unit(family: UnitB200, cards: 2),
  purchasable_unit(family: UnitB200, cards: 8),
  purchasable_unit(family: UnitH200Nvl, cards: 1),
  purchasable_unit(family: UnitH200Nvl, cards: 2),
  purchasable_unit(family: UnitH200Nvl, cards: 4),
  purchasable_unit(family: UnitH200Nvl, cards: 8),
  purchasable_unit(family: UnitRtxPro6000MaxQ, cards: 1),
  purchasable_unit(family: UnitRtxPro6000MaxQ, cards: 2),
  purchasable_unit(family: UnitRtxPro6000MaxQ, cards: 4),
  purchasable_unit(family: UnitRtxPro6000MaxQ, cards: 8),
  purchasable_unit(family: UnitRtxPro6000Workstation, cards: 1),
  purchasable_unit(family: UnitRtxPro6000Workstation, cards: 2),
  purchasable_unit(family: UnitRtxPro6000Workstation, cards: 4),
  purchasable_unit(family: UnitRtxPro6000Workstation, cards: 8),
]

// 2. N-REPLICA EXTRAPOLATION. One-card x N is a PREDICTION from the single-replica row, never an Observed system row: the
// only constructor of this type is scale_out, and it carries the efficiency it assumed. K_N = N K_1, B*_N = N B*_1,
// T_N = N T*_1 eta_N, eta_N = T_N / (N T_1) in basis points.
type ScaleOutPrediction {
  replicas: Nat
  resident_tokens: Nat
  knee_sessions: Nat
  throughput_deci_tokens_per_second: Nat
  efficiency_basis_points: Nat
}

fn scale_out(n: Nat, kv_tokens_one: Nat, knee_one: Nat, throughput_deci_one: Nat, efficiency_basis_points: Nat) -> ScaleOutPrediction {
  ScaleOutPrediction {
    replicas: n,
    resident_tokens: n * kv_tokens_one,
    knee_sessions: n * knee_one,
    throughput_deci_tokens_per_second: n * throughput_deci_one * efficiency_basis_points / 10000,
    efficiency_basis_points: efficiency_basis_points
  }
}

// 3. THREE KNEES PER (card, layout, context). Active throughput knee B* (measured), resident sessions R = KV / context,
// resident-to-knee ratio rho = R / B*, and the duty-cycle sufficiency: d_min ~ 1/rho on the mean and a p95 form, the
// smallest duty cycle d with P[Bin(R, d) >= B*] >= 0.95. Independent replicas do not change rho (R and B* both scale
// by N); only per-replica memory (TP/EP sharding), a shorter context or a faster restore does.
type KneeMeasurement {
  variant: ServingVariant
  context_tokens: Nat
  knee_sessions: Nat
  lower_bound_only: Bool
}

// Measured by the operator on the upstream 0.32.0 stack; the context labels are the nominal 128k and 16k of the sweep. A
// lower_bound_only knee means the sweep never reached the knee: rho is then an upper bound and the duty cycles lower bounds.
data flash_next_measured_knees: List<KneeMeasurement> = [
  KneeMeasurement { variant: H200UpstreamV032, context_tokens: 131072, knee_sessions: 8, lower_bound_only: false },
  KneeMeasurement { variant: B200UpstreamV032, context_tokens: 131072, knee_sessions: 16, lower_bound_only: false },
  KneeMeasurement { variant: H200UpstreamV032, context_tokens: 16384, knee_sessions: 32, lower_bound_only: false },
  KneeMeasurement { variant: B200UpstreamV032, context_tokens: 16384, knee_sessions: 64, lower_bound_only: true },
]

type SessionResidency
  = ResidentSessions { sessions: Nat }
  | ResidencyRefusedZeroContext

fn resident_sessions(kv_tokens: Nat, context_tokens: Nat) -> SessionResidency {
  if context_tokens == 0 {
    ResidencyRefusedZeroContext
  } else {
    ResidentSessions { sessions: kv_tokens / context_tokens }
  }
}

// rho in thousandths; a knee of zero has no ratio.
fn rho_milli(resident: Nat, knee: Nat) -> Nat? {
  if knee == 0 {
    none
  } else {
    Present { value: resident * 1000 / knee }
  }
}

// d_min ~ 1/rho = B* / R in basis points, capped at 1 (R < B* cannot sustain the knee at any duty cycle: see p95).
fn duty_mean_basis_points(resident: Nat, knee: Nat) -> Nat? {
  if resident == 0 {
    none
  } else if knee >= resident {
    Present { value: 10000 }
  } else {
    Present { value: knee * 10000 / resident }
  }
}

// P[Bin(R, d) < k] by dynamic programming over the R trials on the counts 0..k-1 (mass reaching k is dropped, which the
// lower counts do not depend on), in fixed point at scale 10^12, so there is no underflow at any d and the error is
// absolute at 10^-12 per operation.
data binomial_scale: Nat = 1000000000000

data binomial_zero: Nat = 0

type BinomialStep {
  prev: Nat
  out: List<Nat>
}

fn binomial_initial(k: Nat) -> List<Nat> {
  fold(nat_range_inclusive(lo: 0, hi: k - 1), init: [], f: (acc, i) => concat(acc, [if i == 0 { binomial_scale } else { binomial_zero }]))
}

fn binomial_trial(vec: List<Nat>, d_bp: Nat) -> List<Nat> {
  let q = 10000 - d_bp
  fold(vec, init: BinomialStep { prev: binomial_zero, out: [] }, f: (st, v) => BinomialStep { prev: v, out: concat(st.out, [v * q / 10000 + st.prev * d_bp / 10000]) }).out
}

fn binomial_mass_below(resident: Nat, k: Nat, d_bp: Nat) -> Nat {
  let vec = fold(nat_range_inclusive(lo: 1, hi: resident), init: binomial_initial(k: k), f: (v, _i) => binomial_trial(vec: v, d_bp: d_bp))
  fold(vec, init: binomial_zero, f: (a, v) => a + v)
}

// P[Bin(R, d) >= B*] >= 0.95  <=>  mass below B* <= 5%.
fn p95_holds(resident: Nat, knee: Nat, d_bp: Nat) -> Bool {
  binomial_mass_below(resident: resident, k: knee, d_bp: d_bp) * 100 <= binomial_scale * 5
}

// The predicate is monotone in d, so the smallest holding d is found by bisection; the caller guarantees it holds at hi.
fn p95_smallest(resident: Nat, knee: Nat, lo: Nat, hi: Nat) -> Nat {
  if lo >= hi {
    lo
  } else {
    let mid = (lo + hi) / 2
    if p95_holds(resident: resident, knee: knee, d_bp: mid) {
      p95_smallest(resident: resident, knee: knee, lo: lo, hi: mid)
    } else {
      p95_smallest(resident: resident, knee: knee, lo: mid + 1, hi: hi)
    }
  }
}

type DutyCycleP95
  = DutyCycleP95BasisPoints { basis_points: Nat }
  | DutyCycleUnreachable { resident: Nat, knee: Nat }

fn duty_p95_basis_points(resident: Nat, knee: Nat) -> DutyCycleP95 {
  if knee == 0 || resident < knee {
    DutyCycleUnreachable { resident: resident, knee: knee }
  } else {
    DutyCycleP95BasisPoints { basis_points: p95_smallest(resident: resident, knee: knee, lo: 0, hi: 10000) }
  }
}

// 4. LAYOUT IS A PARAMETER: the existing ServingTopology (TP x DP, EP flag). Measured rows for 1x/2x/4x Max-Q layouts
// (2xTP1, TP2, TP2+EP; 4xTP1, 2xTP2, TP4) are coming from rentals; until a row exists the layout is Unobserved, never filled.
type LayoutMeasurementStanding
  = LayoutObserved { topology: ServingTopology }
  | LayoutUnobserved { topology: ServingTopology, trigger: NonEmptyStr }

data layout_rental_trigger: NonEmptyStr = "a committed run receipt of this layout on the production fork" as NonEmptyStr

fn unobserved_layout(tp: Nat, dp: Nat, ep: Bool) -> LayoutMeasurementStanding {
  LayoutUnobserved { topology: ServingTopology { tensor_parallel: tp, data_parallel: dp, expert_parallel: ep }, trigger: layout_rental_trigger }
}

fn observed_layout(tp: Nat, dp: Nat) -> LayoutMeasurementStanding {
  LayoutObserved { topology: ServingTopology { tensor_parallel: tp, data_parallel: dp, expert_parallel: false } }
}

// Observed on the production fork: gunbc.serving.flash_next_maxq_fork_measurements. The four-card host never came up.
data flash_next_maxq_layout_plan: List<LayoutMeasurementStanding> = [
  observed_layout(tp: 1, dp: 1),
  observed_layout(tp: 1, dp: 2),
  observed_layout(tp: 2, dp: 1),
  unobserved_layout(tp: 2, dp: 1, ep: true),
  unobserved_layout(tp: 1, dp: 4, ep: false),
  unobserved_layout(tp: 2, dp: 2, ep: false),
  unobserved_layout(tp: 4, dp: 1, ep: false),
]

// 6. POWER-CAP SWEEPS are Unobserved on every rental: nvidia-smi -pl is refused (Insufficient Permissions). Recorded, not filled.
type PowerCapSweepStanding = PowerCapSweepUnobserved { cause: NonEmptyStr }

data power_cap_refusal_cause: NonEmptyStr = "nvidia-smi -pl refused on the rentals: Insufficient Permissions" as NonEmptyStr

data rental_power_cap_sweep: PowerCapSweepStanding = PowerCapSweepUnobserved { cause: power_cap_refusal_cause }

// 5. THE OUTPUT ROW PER PURCHASABLE CONFIGURATION. Every price-like input is a parameter. Latency and restore readings are
// Optional: absent means unobserved, never zero.
type BuyingParameters {
  delivered_price_cents: Nat
  host_cost_cents: Nat
  wall_power_watts: Nat
  energy_milli_cents_per_kwh: Nat
  cooling_cents: Nat
  tco_hours: Nat
}

type ConfigurationInputs {
  unit: PurchasableUnit
  parameters: BuyingParameters
  kv_tokens: Nat
  context_tokens: Nat
  knee_sessions: Nat
  knee_is_lower_bound: Bool
  throughput_deci_tokens_per_second: Nat
  tokens_per_turn: Nat
  continuation_p95_milliseconds: Nat?
  continuation_p99_milliseconds: Nat?
  restore_fraction_basis_points: Nat?
}

type ConfigurationRow {
  unit: PurchasableUnit
  resident_sessions: Nat
  knee_sessions: Nat
  knee_is_lower_bound: Bool
  rho_milli: Nat?
  duty_mean_basis_points: Nat?
  duty_p95: DutyCycleP95
  turns_per_hour: Nat
  turns_per_kwh: Nat
  tco_cents: Nat
  tco_cents_per_slo_slot: Nat?
  continuation_p95_milliseconds: Nat?
  continuation_p99_milliseconds: Nat?
  restore_fraction_basis_points: Nat?
}

// TCO = capex (delivered price + host) + energy (W x hours x price per kWh) + cooling.
fn energy_cents(p: BuyingParameters) -> Nat {
  p.wall_power_watts * p.tco_hours * p.energy_milli_cents_per_kwh / 1000000
}

fn tco_cents(p: BuyingParameters) -> Nat {
  p.delivered_price_cents + p.host_cost_cents + energy_cents(p: p) + p.cooling_cents
}

fn turns_per_hour(throughput_deci: Nat, tokens_per_turn: Nat) -> Nat {
  if tokens_per_turn == 0 { binomial_zero } else { throughput_deci * 3600 / 10 / tokens_per_turn }
}

fn turns_per_kwh(turns_per_hour: Nat, wall_power_watts: Nat) -> Nat {
  if wall_power_watts == 0 { binomial_zero } else { turns_per_hour * 1000 / wall_power_watts }
}

fn slot_cost(tco: Nat, slots: Nat) -> Nat? {
  if slots == 0 { none } else { Present { value: tco / slots } }
}

type ConfigurationRowResult
  = ConfigurationRowOk { row: ConfigurationRow }
  | ConfigurationRowRefused { cause: NonEmptyStr }

data zero_context_cause: NonEmptyStr = "context_tokens is zero: no residency ratio exists" as NonEmptyStr

fn configuration_row(i: ConfigurationInputs) -> ConfigurationRowResult {
  match resident_sessions(kv_tokens: i.kv_tokens, context_tokens: i.context_tokens) {
    ResidencyRefusedZeroContext => ConfigurationRowRefused { cause: zero_context_cause }
    ResidentSessions { sessions: r } => {
      let tph = turns_per_hour(throughput_deci: i.throughput_deci_tokens_per_second, tokens_per_turn: i.tokens_per_turn)
      let tco = tco_cents(p: i.parameters)
      ConfigurationRowOk { row: ConfigurationRow {
        unit: i.unit,
        resident_sessions: r,
        knee_sessions: i.knee_sessions,
        knee_is_lower_bound: i.knee_is_lower_bound,
        rho_milli: rho_milli(resident: r, knee: i.knee_sessions),
        duty_mean_basis_points: duty_mean_basis_points(resident: r, knee: i.knee_sessions),
        duty_p95: duty_p95_basis_points(resident: r, knee: i.knee_sessions),
        turns_per_hour: tph,
        turns_per_kwh: turns_per_kwh(turns_per_hour: tph, wall_power_watts: i.parameters.wall_power_watts),
        tco_cents: tco,
        tco_cents_per_slo_slot: slot_cost(tco: tco, slots: i.knee_sessions),
        continuation_p95_milliseconds: i.continuation_p95_milliseconds,
        continuation_p99_milliseconds: i.continuation_p99_milliseconds,
        restore_fraction_basis_points: i.restore_fraction_basis_points
      } }
    }
  }
}

// DECISION THRESHOLDS AS FUNCTIONS OF THE PRICE RATIO, not as claims. Configuration B costs less per SLO slot than R exactly
// when P_B / P_R < slots_B / slots_R; the threshold ratio in thousandths is slots_B x 1000 / slots_R, and the comparison
// is cross-multiplied so it needs no division. Prices here are whatever TCO the caller supplies.
fn price_ratio_threshold_milli(slots_b: Nat, slots_r: Nat) -> Nat? {
  if slots_r == 0 { none } else { Present { value: slots_b * 1000 / slots_r } }
}

fn b_is_cheaper_per_slot(tco_b: Nat, slots_b: Nat, tco_r: Nat, slots_r: Nat) -> Bool {
  slots_b > 0 && slots_r > 0 && tco_b * slots_r < tco_r * slots_b
}

// 7. THE FINAL RANKING. One price cell per option, each Optional: an absent price drops the option, it is never read as zero.
// Every per-layout figure below is a MEASURED curve or a measured pool; the only committed numbers are those measurements and the
// per-replica wall watts, and none is a price. The PRO 6000 curves were measured at 175k context, the H200 and B200 curves at
// 128k (raw measured values; the single context derate follows) and derated once to 97 percent in the ranking; the context_tokens parameter sets only the seat count, so a curve is not rescaled to it.
type RankedLayout
  = LayoutMaxQTp1
  | LayoutMaxQTp2Pair
  | LayoutWorkstationTp2Pair
  | LayoutH200Tp1
  | LayoutB200Tp1

fn layout_index(l: RankedLayout) -> Nat {
  match l {
    LayoutMaxQTp1 => 0
    LayoutMaxQTp2Pair => 1
    LayoutWorkstationTp2Pair => 2
    LayoutH200Tp1 => 3
    LayoutB200Tp1 => 4
  }
}

// Measured for the two Max-Q layouts; the Workstation pair borrows the Max-Q TP2 curve and pool (same silicon and memory), and the H200
// and B200 curves come from the upstream-0.32.0 sweep, so those rows are model output, not a measurement of that layout.
type RowStanding = RowMeasured | RowModelOutput

type CurvePoint {
  concurrency: Nat
  tokens_per_second: Nat
}

type MeasuredCurve {
  first: CurvePoint
  rest: List<CurvePoint>
}

fn curve_last(c: MeasuredCurve) -> CurvePoint {
  fold(c.rest, init: c.first, f: (_a, p) => p)
}

type InterpState {
  prev: CurvePoint
  value: Nat
}

// Linear interpolation between measured points, cross-multiplied so no value is subtracted; below the first point it scales
// linearly from zero, above the last point it holds the last measured value.
fn curve_at_milli(c: MeasuredCurve, x_milli: Nat) -> Nat {
  let last = curve_last(c: c)
  let xc = nat_min(a: x_milli, b: last.concurrency * 1000)
  let start = InterpState { prev: c.first, value: c.first.tokens_per_second * nat_min(a: xc, b: c.first.concurrency * 1000) / (c.first.concurrency * 1000) }
  let end = fold(c.rest, init: start, f: (s, p) =>
    if xc > s.prev.concurrency * 1000 && xc <= p.concurrency * 1000 {
      InterpState { prev: p, value: (s.prev.tokens_per_second * (p.concurrency * 1000 - xc) + p.tokens_per_second * (xc - s.prev.concurrency * 1000)) / ((p.concurrency - s.prev.concurrency) * 1000) }
    } else {
      InterpState { prev: p, value: s.value }
    })
  end.value
}

fn curve_at(c: MeasuredCurve, x: Nat) -> Nat {
  curve_at_milli(c: c, x_milli: x * 1000)
}

type LayoutFacts {
  gpus_per_replica: Nat
  kv_tokens_per_replica: Nat?
  curve: MeasuredCurve
  knee: Nat
  derate_milli: Nat
  watts_per_replica: Nat
  safe_resident_sessions: Nat
  standing: RowStanding
}

fn matrix_nvfp4_fp8_kv_tokens(v: ServingVariant) -> Nat? {
  match quant_matrix_outcome(rows: flash_next_quant_matrix, v: v, c: QuantCell { weights: WeightNvfp4LilQad, kv: KvFp8 }) {
    Present { value: o } => match o {
      CellMeasured { weights_centi_gib: _, kv_centi_gib: _, kv_tokens: t, gpu_memory_utilization_basis_points: _, throughput: _ } => t
      _ => none
    }
    none => none
  }
}

fn pro6000_tp2_curve() -> MeasuredCurve {
  MeasuredCurve { first: CurvePoint { concurrency: 1, tokens_per_second: 252 }, rest: [
    CurvePoint { concurrency: 4, tokens_per_second: 498 }, CurvePoint { concurrency: 8, tokens_per_second: 753 },
    CurvePoint { concurrency: 12, tokens_per_second: 829 }, CurvePoint { concurrency: 16, tokens_per_second: 981 },
    CurvePoint { concurrency: 20, tokens_per_second: 975 } ] }
}

fn layout_facts(l: RankedLayout) -> LayoutFacts {
  match l {
    LayoutMaxQTp1 => LayoutFacts { gpus_per_replica: 1, kv_tokens_per_replica: fork_kv_pool(card: ForkMaxQ300, topology: layout(tp: 1, dp: 1)),
      curve: MeasuredCurve { first: CurvePoint { concurrency: 1, tokens_per_second: 222 }, rest: [ CurvePoint { concurrency: 2, tokens_per_second: 261 }, CurvePoint { concurrency: 3, tokens_per_second: 398 } ] },
      knee: 3, derate_milli: 1000, watts_per_replica: 285, safe_resident_sessions: 3, standing: RowMeasured }
    LayoutMaxQTp2Pair => LayoutFacts { gpus_per_replica: 2, kv_tokens_per_replica: fork_kv_pool(card: ForkMaxQ300, topology: layout(tp: 2, dp: 1)),
      curve: pro6000_tp2_curve(), knee: 16, derate_milli: 1000, watts_per_replica: 580, safe_resident_sessions: 12, standing: RowMeasured }
    LayoutWorkstationTp2Pair => LayoutFacts { gpus_per_replica: 2, kv_tokens_per_replica: fork_kv_pool(card: ForkMaxQ300, topology: layout(tp: 2, dp: 1)),
      curve: pro6000_tp2_curve(), knee: 16, derate_milli: 1000, watts_per_replica: 1200, safe_resident_sessions: 12, standing: RowModelOutput }
    LayoutH200Tp1 => LayoutFacts { gpus_per_replica: 1, kv_tokens_per_replica: matrix_nvfp4_fp8_kv_tokens(v: H200UpstreamV032),
      curve: MeasuredCurve { first: CurvePoint { concurrency: 1, tokens_per_second: 189 }, rest: [
        CurvePoint { concurrency: 2, tokens_per_second: 310 }, CurvePoint { concurrency: 4, tokens_per_second: 423 }, CurvePoint { concurrency: 8, tokens_per_second: 675 } ] },
      knee: 8, derate_milli: 970, watts_per_replica: 480, safe_resident_sessions: 6, standing: RowModelOutput }
    LayoutB200Tp1 => LayoutFacts { gpus_per_replica: 1, kv_tokens_per_replica: matrix_nvfp4_fp8_kv_tokens(v: B200UpstreamV032),
      curve: MeasuredCurve { first: CurvePoint { concurrency: 1, tokens_per_second: 302 }, rest: [
        CurvePoint { concurrency: 4, tokens_per_second: 798 }, CurvePoint { concurrency: 8, tokens_per_second: 1241 }, CurvePoint { concurrency: 16, tokens_per_second: 1579 } ] },
      knee: 16, derate_milli: 970, watts_per_replica: 850, safe_resident_sessions: 12, standing: RowModelOutput }
  }
}

// One price per GPU in delivered cents, per option; the two Max-Q layouts share the Max-Q price.
type OptionPrices {
  maxq_cents_per_gpu: Nat?
  workstation_cents_per_gpu: Nat?
  h200_cents_per_gpu: Nat?
  b200_cents_per_gpu: Nat?
}

fn layout_price(l: RankedLayout, p: OptionPrices) -> Nat? {
  match l {
    LayoutMaxQTp1 => p.maxq_cents_per_gpu
    LayoutMaxQTp2Pair => p.maxq_cents_per_gpu
    LayoutWorkstationTp2Pair => p.workstation_cents_per_gpu
    LayoutH200Tp1 => p.h200_cents_per_gpu
    LayoutB200Tp1 => p.b200_cents_per_gpu
  }
}

// The sessions a replica holds while meeting the interactive floor, per layout. Measured where a passing point exists (Max-Q TP1: 3
// at 175k; Max-Q TP2: 12 at 175k, duty 0.23, p95 TTFT 3.7 s, while 25 collapsed); elsewhere 0.43 x the nominal count (model output).
// A caller overrides it per layout; there is no global seat share.
type SafeSessionsOverride {
  layout: RankedLayout
  sessions: Nat
}

// Open-loop throughput over the static-curve value measured 0.41 to 0.63 (TP2 S=12: 223 vs ~396 at duty 0.23, 311 vs ~763 at 0.71;
// Max-Q TP1 S=3: 0.44 to 0.63); the default is the middle.
data default_agentic_efficiency_basis_points: Nat = 5000

type RankingInputs {
  prices: OptionPrices
  safe_overrides: List<SafeSessionsOverride>
  agentic_efficiency_basis_points: Nat
  budget_cents: Nat
  host_cost_cents: Nat
  gpus_per_server: Nat
  context_tokens: Nat
  duty_basis_points: Nat
  site_watts: Nat
  host_watts: Nat
  energy_milli_cents_per_kwh: Nat
  years: Nat
}

type OptionDropCause
  = DroppedPriceAbsent
  | DroppedPriceZero
  | DroppedKvUnobserved
  | DroppedZeroContextOrServer
  | DroppedBudgetBelowOneReplica
  | DroppedZeroSeats

type RankedRow {
  layout: RankedLayout
  standing: RowStanding
  units: Nat
  hosts: Nat
  seats: Nat
  safe_sessions_per_replica: Nat
  backlogged_decode_ceiling: Nat
  expected_agentic_tokens_per_second: Nat
  board_plus_host_watts_estimate: Nat
  fits_site: Bool
  tco_cents: Nat
  cents_per_seat: Nat?
  cents_per_token_per_second: Nat?
  rank: Nat
}

type OptionOutcome
  = OptionRanked { row: RankedRow }
  | OptionDropped { layout: RankedLayout, cause: OptionDropCause }

fn ceil_div(a: Nat, b: Nat) -> Nat {
  (a + b - 1) / b
}

// The most replicas whose GPUs plus the hosts that carry them fit the budget.
fn max_units(budget: Nat, price: Nat, gpus_per_replica: Nat, gpus_per_server: Nat, host_cost: Nat) -> Nat {
  fold(nat_range_inclusive(lo: 1, hi: budget / (gpus_per_replica * price)), init: binomial_zero, f: (acc, n) =>
    if n * gpus_per_replica * price + ceil_div(a: n * gpus_per_replica, b: gpus_per_server) * host_cost <= budget { n } else { acc })
}

// Sessions of a context length the KV pool holds, per replica.
fn seats_at(kv_tokens: Nat, context_tokens: Nat) -> Nat {
  if context_tokens == 0 { binomial_zero } else { kv_tokens / context_tokens }
}

fn safe_sessions_for(l: RankedLayout, default: Nat, overrides: List<SafeSessionsOverride>) -> Nat {
  fold(overrides, init: default, f: (acc, o) => if layout_index(l: o.layout) == layout_index(l: l) { o.sessions } else { acc })
}

// Replicas needed to hold a number of sessions.
fn replicas_for(sessions: Nat, seats_per_replica: Nat) -> Nat? {
  if seats_per_replica == 0 { none } else { Present { value: ceil_div(a: sessions, b: seats_per_replica) } }
}

// GPUs one replica needs to hold the weights in 75 percent of each GPU's memory: ceil(weights / (0.75 x memory)).
fn gpus_per_replica(weights_bytes: Nat, gpu_memory_bytes: Nat) -> Nat? {
  if gpu_memory_bytes == 0 { none } else { Present { value: ceil_div(a: weights_bytes * 4, b: gpu_memory_bytes * 3) } }
}

fn rank_one(l: RankedLayout, i: RankingInputs) -> OptionOutcome {
  let f = layout_facts(l: l)
  match layout_price(l: l, p: i.prices) {
    none => OptionDropped { layout: l, cause: DroppedPriceAbsent }
    Present { value: price } =>
      if price == 0 {
        OptionDropped { layout: l, cause: DroppedPriceZero }
      } else if i.context_tokens == 0 || i.gpus_per_server == 0 {
        OptionDropped { layout: l, cause: DroppedZeroContextOrServer }
      } else {
        match f.kv_tokens_per_replica {
          none => OptionDropped { layout: l, cause: DroppedKvUnobserved }
          Present { value: kv } => {
            let units = max_units(budget: i.budget_cents, price: price, gpus_per_replica: f.gpus_per_replica, gpus_per_server: i.gpus_per_server, host_cost: i.host_cost_cents)
            let nominal = seats_at(kv_tokens: kv, context_tokens: i.context_tokens)
            let safe = safe_sessions_for(l: l, default: f.safe_resident_sessions, overrides: i.safe_overrides)
            let seats = nat_min(a: safe, b: nominal)
            if units == 0 {
              OptionDropped { layout: l, cause: DroppedBudgetBelowOneReplica }
            } else if seats == 0 {
              OptionDropped { layout: l, cause: DroppedZeroSeats }
            } else {
              let ceiling_per = curve_at(c: f.curve, x: nat_min(a: f.knee, b: nominal))
              let ceiling = units * ceiling_per * f.derate_milli / 1000
              let active_milli = nat_min(a: f.knee * 1000, b: seats * i.duty_basis_points / 10)
              let agentic = units * curve_at_milli(c: f.curve, x_milli: active_milli) * f.derate_milli / 1000 * i.agentic_efficiency_basis_points / 10000
              let hosts = ceil_div(a: units * f.gpus_per_replica, b: i.gpus_per_server)
              let watts = units * f.watts_per_replica + hosts * i.host_watts
              let tco = tco_cents(p: BuyingParameters {
                delivered_price_cents: units * f.gpus_per_replica * price,
                host_cost_cents: hosts * i.host_cost_cents,
                wall_power_watts: watts,
                energy_milli_cents_per_kwh: i.energy_milli_cents_per_kwh,
                cooling_cents: 0,
                tco_hours: 6132 * i.years })
              OptionRanked { row: RankedRow {
                layout: l, standing: f.standing, units: units, hosts: hosts, seats: units * seats, safe_sessions_per_replica: safe,
                backlogged_decode_ceiling: ceiling, expected_agentic_tokens_per_second: agentic,
                board_plus_host_watts_estimate: watts, fits_site: watts <= i.site_watts, tco_cents: tco,
                cents_per_seat: slot_cost(tco: tco, slots: units * seats),
                cents_per_token_per_second: slot_cost(tco: tco, slots: agentic),
                rank: 0 } }
            }
          }
        }
      }
  }
}

fn ranked_outcomes(i: RankingInputs) -> List<OptionOutcome> {
  [ rank_one(l: LayoutMaxQTp1, i: i), rank_one(l: LayoutMaxQTp2Pair, i: i), rank_one(l: LayoutWorkstationTp2Pair, i: i),
    rank_one(l: LayoutH200Tp1, i: i), rank_one(l: LayoutB200Tp1, i: i) ]
}

// Fits the site first, then more expected agentic throughput, then the lower layout index.
fn row_beats(a: RankedRow, b: RankedRow) -> Bool {
  if a.fits_site && !b.fits_site {
    true
  } else if !a.fits_site && b.fits_site {
    false
  } else if a.expected_agentic_tokens_per_second != b.expected_agentic_tokens_per_second {
    a.expected_agentic_tokens_per_second > b.expected_agentic_tokens_per_second
  } else {
    layout_index(l: a.layout) < layout_index(l: b.layout)
  }
}

fn unranked_rows(outcomes: List<OptionOutcome>) -> List<RankedRow> {
  fold(outcomes, init: [], f: (acc, o) => match o {
    OptionRanked { row: r } => concat(acc, [r])
    OptionDropped { layout: _, cause: _ } => acc
  })
}

// Each surviving option with its rank (1 is best); a dropped option has no row.
fn rank_configurations(i: RankingInputs) -> List<RankedRow> {
  let rows = unranked_rows(outcomes: ranked_outcomes(i: i))
  fold(rows, init: [], f: (acc, r) => concat(acc, [RankedRow {
    layout: r.layout, standing: r.standing, units: r.units, hosts: r.hosts, seats: r.seats, safe_sessions_per_replica: r.safe_sessions_per_replica,
    backlogged_decode_ceiling: r.backlogged_decode_ceiling, expected_agentic_tokens_per_second: r.expected_agentic_tokens_per_second,
    board_plus_host_watts_estimate: r.board_plus_host_watts_estimate, fits_site: r.fits_site, tco_cents: r.tco_cents,
    cents_per_seat: r.cents_per_seat, cents_per_token_per_second: r.cents_per_token_per_second,
    rank: 1 + count(rows |> filter(o => row_beats(a: o, b: r))) }]))
}

// THE CONCLUSION IS PROVISIONAL. Per delivered dollar B beats R on expected agentic tok/s exactly when price_B / price_R is below
// tok_B / tok_R; rank_configurations folds host, board-plus-host watts (an estimate, not wall power) and site terms in. Two outputs are never
// conflated: backlogged_decode_ceiling (static curve at the nominal seats) and expected_agentic_tokens_per_second (curve at safe x duty,
// times the agentic efficiency). Rests on: Max-Q TP1 3 sessions at 175k, Max-Q TP2 12 at 175k (duty 0.23, p95 TTFT 3.7 s; 25 collapsed),
// and the H200/B200 curves at 128k (ModelOutput rows, derated 0.97). NVIDIA positions Max-Q for up to 4 GPUs per workstation; 8-GPU builds use Server Edition.
data flash_next_conclusion_provisional: List<NonEmptyStr> = ["PROVISIONAL: at the measured points a PRO 6000 layout is expected to beat a single-H200 layout per dollar unless the H200 costs under about 1.3x per GPU; the B200 and H200 rows are ModelOutput" as NonEmptyStr]

// Gates that lift the PROVISIONAL standing.
data flash_next_conclusion_gates: List<NonEmptyStr> = [
  "two concurrent TP2 pairs on one host (scale-out efficiency)" as NonEmptyStr,
  "4xTP1 versus 2xTP2 on the same host" as NonEmptyStr,
  "safe resident sessions at duty 0.3 versus a declared SLO" as NonEmptyStr,
  "real coding text rather than synthetic prompts" as NonEmptyStr,
  "wall power at the socket" as NonEmptyStr,
]

// Stated narrowly: what is not known stays Unobserved, and no finding is widened past its tested configurations.
data flash_next_ranking_unobserved: List<NonEmptyStr> = [
  "TP2 versus 2xTP1 at the agent workload (only the 128k aggregate was compared)" as NonEmptyStr,
  "multi-pair scale-out efficiency" as NonEmptyStr,
  "397B-A17B: memory-fit minimum only, no throughput" as NonEmptyStr,
  "about 1M context: unsupported in the tested configurations, cause unresolved" as NonEmptyStr,
  "at three 175k sessions the tested Server Edition system was no faster than the tested Max-Q system (different SKU and host; not a power-cap sweep)" as NonEmptyStr,
]

data flash_next_buying_model_frontier: DissolutionCondition = unbound_dissolution(
  description: "DESIGN section 3c: consumed by test.claim.flash_next_serving_witness with synthetic inputs. Frontier, trigger: the gunbc-private answer lets quotes and site values be supplied as parameters, the rental layout rows (1x/2x/4x Max-Q) land and replace flash_next_maxq_layout_plan, and a measured scale-out efficiency replaces the assumed eta; no committed value of price, host cost, wall power, energy price or cooling exists in this module"
)
