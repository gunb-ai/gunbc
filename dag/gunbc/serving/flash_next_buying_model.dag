module gunbc.serving.flash_next_buying_model

import std.types { Bool, List, NonEmptyStr }
import std.nat { Nat, nat_range_inclusive }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }
import gunbc.serving.flash_next_experiment_identity { ServingVariant, H200UpstreamV032, B200UpstreamV032 }
import gunbc.serving.flash_next_topology { ServingTopology }

// THE BUYING MODEL: TYPES AND FORMULAS ONLY. Price, host cost, wall power, energy price, cooling and site budget are
// PARAMETERS of the functions below; no value of any of them is committed here (operator ruling: no quotes, prices, site or
// rental details in the public repository until the gunbc-private question is answered). The synthetic inputs in
// test.claim.flash_next_serving_witness exercise the formulas and say nothing about any real offer.

// 1. PURCHASABLE UNITS, NOT CHIPS. What can be bought is a node, and whether a node of a given card count exists is a
// quote fact, not a property of the chip. NVIDIA ships B200 as SXM in 8-GPU HGX/DGX; a single or dual B200 node is a
// hypothesis until a supplier quotes it.
type UnitCardFamily = UnitB200 | UnitH200Nvl | UnitRtxPro6000MaxQ | UnitRtxPro6000Workstation

type UnitStanding
  = ShipsAsStandardNode { cited: CitedFigureStanding }
  | ExistenceIsAQuoteFact { hypothesis: NonEmptyStr }

type PurchasableUnit {
  family: UnitCardFamily
  cards: Nat
  standing: UnitStanding
}

data b200_hgx_read_obligation: NonEmptyStr = "NVIDIA HGX B200 / DGX B200 product pages: B200 ships as SXM modules in an 8-GPU baseboard" as NonEmptyStr

data b200_hgx_standing: UnitStanding = ShipsAsStandardNode { cited: TranscribedUncited { read_obligation: b200_hgx_read_obligation } }

data quote_fact_hypothesis: NonEmptyStr = "a supplier quotes a node with exactly this card count; until then its existence is a hypothesis" as NonEmptyStr

data quote_fact_standing: UnitStanding = ExistenceIsAQuoteFact { hypothesis: quote_fact_hypothesis }

fn family_is_b200(f: UnitCardFamily) -> Bool {
  match f {
    UnitB200 => true
    _ => false
  }
}

fn unit_standing(family: UnitCardFamily, cards: Nat) -> UnitStanding {
  if family_is_b200(f: family) && cards == 8 {
    b200_hgx_standing
  } else {
    quote_fact_standing
  }
}

fn purchasable_unit(family: UnitCardFamily, cards: Nat) -> PurchasableUnit {
  PurchasableUnit { family: family, cards: cards, standing: unit_standing(family: family, cards: cards) }
}

data flash_next_candidate_units: List<PurchasableUnit> = [
  purchasable_unit(family: UnitB200, cards: 1),
  purchasable_unit(family: UnitB200, cards: 2),
  purchasable_unit(family: UnitB200, cards: 8),
  purchasable_unit(family: UnitH200Nvl, cards: 1),
  purchasable_unit(family: UnitH200Nvl, cards: 2),
  purchasable_unit(family: UnitH200Nvl, cards: 4),
  purchasable_unit(family: UnitH200Nvl, cards: 8),
  purchasable_unit(family: UnitRtxPro6000MaxQ, cards: 1),
  purchasable_unit(family: UnitRtxPro6000MaxQ, cards: 2),
  purchasable_unit(family: UnitRtxPro6000MaxQ, cards: 4),
  purchasable_unit(family: UnitRtxPro6000MaxQ, cards: 8),
  purchasable_unit(family: UnitRtxPro6000Workstation, cards: 1),
  purchasable_unit(family: UnitRtxPro6000Workstation, cards: 2),
  purchasable_unit(family: UnitRtxPro6000Workstation, cards: 4),
  purchasable_unit(family: UnitRtxPro6000Workstation, cards: 8),
]

// 2. N-REPLICA EXTRAPOLATION. One-card x N is a PREDICTION from the single-replica row, never an Observed system row: the
// only constructor of this type is scale_out, and it carries the efficiency it assumed. K_N = N K_1, B*_N = N B*_1,
// T_N = N T*_1 eta_N, eta_N = T_N / (N T_1) in basis points.
type ScaleOutPrediction {
  replicas: Nat
  resident_tokens: Nat
  knee_sessions: Nat
  throughput_deci_tokens_per_second: Nat
  efficiency_basis_points: Nat
}

fn scale_out(n: Nat, kv_tokens_one: Nat, knee_one: Nat, throughput_deci_one: Nat, efficiency_basis_points: Nat) -> ScaleOutPrediction {
  ScaleOutPrediction {
    replicas: n,
    resident_tokens: n * kv_tokens_one,
    knee_sessions: n * knee_one,
    throughput_deci_tokens_per_second: n * throughput_deci_one * efficiency_basis_points / 10000,
    efficiency_basis_points: efficiency_basis_points
  }
}

// 3. THREE KNEES PER (card, layout, context). Active throughput knee B* (measured), resident sessions R = KV / context,
// resident-to-knee ratio rho = R / B*, and the duty-cycle sufficiency: d_min ~ 1/rho on the mean and a p95 form, the
// smallest duty cycle d with P[Bin(R, d) >= B*] >= 0.95. Independent replicas do not change rho (R and B* both scale
// by N); only per-replica memory (TP/EP sharding), a shorter context or a faster restore does.
type KneeMeasurement {
  variant: ServingVariant
  context_tokens: Nat
  knee_sessions: Nat
  lower_bound_only: Bool
}

// Measured by the operator on the upstream 0.32.0 stack; the context labels are the nominal 128k and 16k of the sweep. A
// lower_bound_only knee means the sweep never reached the knee: rho is then an upper bound and the duty cycles lower bounds.
data flash_next_measured_knees: List<KneeMeasurement> = [
  KneeMeasurement { variant: H200UpstreamV032, context_tokens: 131072, knee_sessions: 8, lower_bound_only: false },
  KneeMeasurement { variant: B200UpstreamV032, context_tokens: 131072, knee_sessions: 16, lower_bound_only: false },
  KneeMeasurement { variant: H200UpstreamV032, context_tokens: 16384, knee_sessions: 32, lower_bound_only: false },
  KneeMeasurement { variant: B200UpstreamV032, context_tokens: 16384, knee_sessions: 64, lower_bound_only: true },
]

type SessionResidency
  = ResidentSessions { sessions: Nat }
  | ResidencyRefusedZeroContext

fn resident_sessions(kv_tokens: Nat, context_tokens: Nat) -> SessionResidency {
  if context_tokens == 0 {
    ResidencyRefusedZeroContext
  } else {
    ResidentSessions { sessions: kv_tokens / context_tokens }
  }
}

// rho in thousandths; a knee of zero has no ratio.
fn rho_milli(resident: Nat, knee: Nat) -> Nat? {
  if knee == 0 {
    none
  } else {
    Present { value: resident * 1000 / knee }
  }
}

// d_min ~ 1/rho = B* / R in basis points, capped at 1 (R < B* cannot sustain the knee at any duty cycle: see p95).
fn duty_mean_basis_points(resident: Nat, knee: Nat) -> Nat? {
  if resident == 0 {
    none
  } else if knee >= resident {
    Present { value: 10000 }
  } else {
    Present { value: knee * 10000 / resident }
  }
}

// P[Bin(R, d) < k] by dynamic programming over the R trials on the counts 0..k-1 (mass reaching k is dropped, which the
// lower counts do not depend on), in fixed point at scale 10^12, so there is no underflow at any d and the error is
// absolute at 10^-12 per operation.
data binomial_scale: Nat = 1000000000000

data binomial_zero: Nat = 0

type BinomialStep {
  prev: Nat
  out: List<Nat>
}

fn binomial_initial(k: Nat) -> List<Nat> {
  fold(nat_range_inclusive(lo: 0, hi: k - 1), init: [], f: (acc, i) => concat(acc, [if i == 0 { binomial_scale } else { binomial_zero }]))
}

fn binomial_trial(vec: List<Nat>, d_bp: Nat) -> List<Nat> {
  let q = 10000 - d_bp
  fold(vec, init: BinomialStep { prev: binomial_zero, out: [] }, f: (st, v) => BinomialStep { prev: v, out: concat(st.out, [v * q / 10000 + st.prev * d_bp / 10000]) }).out
}

fn binomial_mass_below(resident: Nat, k: Nat, d_bp: Nat) -> Nat {
  let vec = fold(nat_range_inclusive(lo: 1, hi: resident), init: binomial_initial(k: k), f: (v, _i) => binomial_trial(vec: v, d_bp: d_bp))
  fold(vec, init: binomial_zero, f: (a, v) => a + v)
}

// P[Bin(R, d) >= B*] >= 0.95  <=>  mass below B* <= 5%.
fn p95_holds(resident: Nat, knee: Nat, d_bp: Nat) -> Bool {
  binomial_mass_below(resident: resident, k: knee, d_bp: d_bp) * 100 <= binomial_scale * 5
}

// The predicate is monotone in d, so the smallest holding d is found by bisection; the caller guarantees it holds at hi.
fn p95_smallest(resident: Nat, knee: Nat, lo: Nat, hi: Nat) -> Nat {
  if lo >= hi {
    lo
  } else {
    let mid = (lo + hi) / 2
    if p95_holds(resident: resident, knee: knee, d_bp: mid) {
      p95_smallest(resident: resident, knee: knee, lo: lo, hi: mid)
    } else {
      p95_smallest(resident: resident, knee: knee, lo: mid + 1, hi: hi)
    }
  }
}

type DutyCycleP95
  = DutyCycleP95BasisPoints { basis_points: Nat }
  | DutyCycleUnreachable { resident: Nat, knee: Nat }

fn duty_p95_basis_points(resident: Nat, knee: Nat) -> DutyCycleP95 {
  if knee == 0 || resident < knee {
    DutyCycleUnreachable { resident: resident, knee: knee }
  } else {
    DutyCycleP95BasisPoints { basis_points: p95_smallest(resident: resident, knee: knee, lo: 0, hi: 10000) }
  }
}

// 4. LAYOUT IS A PARAMETER: the existing ServingTopology (TP x DP, EP flag). Measured rows for 1x/2x/4x Max-Q layouts
// (2xTP1, TP2, TP2+EP; 4xTP1, 2xTP2, TP4) are coming from rentals; until a row exists the layout is Unobserved, never filled.
type LayoutMeasurementStanding
  = LayoutObserved { topology: ServingTopology }
  | LayoutUnobserved { topology: ServingTopology, trigger: NonEmptyStr }

data layout_rental_trigger: NonEmptyStr = "a committed run receipt of this layout on the production fork" as NonEmptyStr

fn unobserved_layout(tp: Nat, dp: Nat, ep: Bool) -> LayoutMeasurementStanding {
  LayoutUnobserved { topology: ServingTopology { tensor_parallel: tp, data_parallel: dp, expert_parallel: ep }, trigger: layout_rental_trigger }
}

fn observed_layout(tp: Nat, dp: Nat) -> LayoutMeasurementStanding {
  LayoutObserved { topology: ServingTopology { tensor_parallel: tp, data_parallel: dp, expert_parallel: false } }
}

// Observed on the production fork: gunbc.serving.flash_next_maxq_fork_measurements. The four-card host never came up.
data flash_next_maxq_layout_plan: List<LayoutMeasurementStanding> = [
  observed_layout(tp: 1, dp: 1),
  observed_layout(tp: 1, dp: 2),
  observed_layout(tp: 2, dp: 1),
  unobserved_layout(tp: 2, dp: 1, ep: true),
  unobserved_layout(tp: 1, dp: 4, ep: false),
  unobserved_layout(tp: 2, dp: 2, ep: false),
  unobserved_layout(tp: 4, dp: 1, ep: false),
]

// 6. POWER-CAP SWEEPS are Unobserved on every rental: nvidia-smi -pl is refused (Insufficient Permissions). Recorded, not filled.
type PowerCapSweepStanding = PowerCapSweepUnobserved { cause: NonEmptyStr }

data power_cap_refusal_cause: NonEmptyStr = "nvidia-smi -pl refused on the rentals: Insufficient Permissions" as NonEmptyStr

data rental_power_cap_sweep: PowerCapSweepStanding = PowerCapSweepUnobserved { cause: power_cap_refusal_cause }

// 5. THE OUTPUT ROW PER PURCHASABLE CONFIGURATION. Every price-like input is a parameter. Latency and restore readings are
// Optional: absent means unobserved, never zero.
type BuyingParameters {
  delivered_price_cents: Nat
  host_cost_cents: Nat
  wall_power_watts: Nat
  energy_milli_cents_per_kwh: Nat
  cooling_cents: Nat
  tco_hours: Nat
}

type ConfigurationInputs {
  unit: PurchasableUnit
  parameters: BuyingParameters
  kv_tokens: Nat
  context_tokens: Nat
  knee_sessions: Nat
  knee_is_lower_bound: Bool
  throughput_deci_tokens_per_second: Nat
  tokens_per_turn: Nat
  continuation_p95_milliseconds: Nat?
  continuation_p99_milliseconds: Nat?
  restore_fraction_basis_points: Nat?
}

type ConfigurationRow {
  unit: PurchasableUnit
  resident_sessions: Nat
  knee_sessions: Nat
  knee_is_lower_bound: Bool
  rho_milli: Nat?
  duty_mean_basis_points: Nat?
  duty_p95: DutyCycleP95
  turns_per_hour: Nat
  turns_per_kwh: Nat
  tco_cents: Nat
  tco_cents_per_slo_slot: Nat?
  continuation_p95_milliseconds: Nat?
  continuation_p99_milliseconds: Nat?
  restore_fraction_basis_points: Nat?
}

// TCO = capex (delivered price + host) + energy (W x hours x price per kWh) + cooling.
fn energy_cents(p: BuyingParameters) -> Nat {
  p.wall_power_watts * p.tco_hours * p.energy_milli_cents_per_kwh / 1000000
}

fn tco_cents(p: BuyingParameters) -> Nat {
  p.delivered_price_cents + p.host_cost_cents + energy_cents(p: p) + p.cooling_cents
}

fn turns_per_hour(throughput_deci: Nat, tokens_per_turn: Nat) -> Nat {
  if tokens_per_turn == 0 { binomial_zero } else { throughput_deci * 3600 / 10 / tokens_per_turn }
}

fn turns_per_kwh(turns_per_hour: Nat, wall_power_watts: Nat) -> Nat {
  if wall_power_watts == 0 { binomial_zero } else { turns_per_hour * 1000 / wall_power_watts }
}

fn slot_cost(tco: Nat, slots: Nat) -> Nat? {
  if slots == 0 { none } else { Present { value: tco / slots } }
}

type ConfigurationRowResult
  = ConfigurationRowOk { row: ConfigurationRow }
  | ConfigurationRowRefused { cause: NonEmptyStr }

data zero_context_cause: NonEmptyStr = "context_tokens is zero: no residency ratio exists" as NonEmptyStr

fn configuration_row(i: ConfigurationInputs) -> ConfigurationRowResult {
  match resident_sessions(kv_tokens: i.kv_tokens, context_tokens: i.context_tokens) {
    ResidencyRefusedZeroContext => ConfigurationRowRefused { cause: zero_context_cause }
    ResidentSessions { sessions: r } => {
      let tph = turns_per_hour(throughput_deci: i.throughput_deci_tokens_per_second, tokens_per_turn: i.tokens_per_turn)
      let tco = tco_cents(p: i.parameters)
      ConfigurationRowOk { row: ConfigurationRow {
        unit: i.unit,
        resident_sessions: r,
        knee_sessions: i.knee_sessions,
        knee_is_lower_bound: i.knee_is_lower_bound,
        rho_milli: rho_milli(resident: r, knee: i.knee_sessions),
        duty_mean_basis_points: duty_mean_basis_points(resident: r, knee: i.knee_sessions),
        duty_p95: duty_p95_basis_points(resident: r, knee: i.knee_sessions),
        turns_per_hour: tph,
        turns_per_kwh: turns_per_kwh(turns_per_hour: tph, wall_power_watts: i.parameters.wall_power_watts),
        tco_cents: tco,
        tco_cents_per_slo_slot: slot_cost(tco: tco, slots: i.knee_sessions),
        continuation_p95_milliseconds: i.continuation_p95_milliseconds,
        continuation_p99_milliseconds: i.continuation_p99_milliseconds,
        restore_fraction_basis_points: i.restore_fraction_basis_points
      } }
    }
  }
}

// DECISION THRESHOLDS AS FUNCTIONS OF THE PRICE RATIO, not as claims. Configuration B costs less per SLO slot than R exactly
// when P_B / P_R < slots_B / slots_R; the threshold ratio in thousandths is slots_B x 1000 / slots_R, and the comparison
// is cross-multiplied so it needs no division. Prices here are whatever TCO the caller supplies.
fn price_ratio_threshold_milli(slots_b: Nat, slots_r: Nat) -> Nat? {
  if slots_r == 0 { none } else { Present { value: slots_b * 1000 / slots_r } }
}

fn b_is_cheaper_per_slot(tco_b: Nat, slots_b: Nat, tco_r: Nat, slots_r: Nat) -> Bool {
  slots_b > 0 && slots_r > 0 && tco_b * slots_r < tco_r * slots_b
}

data flash_next_buying_model_frontier: DissolutionCondition = unbound_dissolution(
  description: "DESIGN section 3c: consumed by test.claim.flash_next_serving_witness with synthetic inputs. Frontier, trigger: the gunbc-private answer lets quotes and site values be supplied as parameters, the rental layout rows (1x/2x/4x Max-Q) land and replace flash_next_maxq_layout_plan, and a measured scale-out efficiency replaces the assumed eta; no committed value of price, host cost, wall power, energy price or cooling exists in this module"
)
