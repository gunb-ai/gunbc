module gunbc.serving.caller_retry_contract

import std.types { String, NonEmptyStr, List }
import std.nat { Nat }
import std.algebra { length }
import gunbc.serving.caller_backlog {
  persist_before_offer_basis, retriable_refusal_basis, stable_turn_identity_basis, idempotent_retry_basis,
  no_expiry_on_long_wait_basis, durable_cancellation_basis, no_double_execution_basis,
}

// ── THE BACKLOG IS THE CALLER'S, AND WHAT THAT OWES IS A CONTRACT (operator ruling, 2026-10-02) ────────
//
// A turn the route cannot take now is refused, not queued: there is no server-side queue, and the route
// offer (retired gunbc.spark.group_b_serving_capacity (deleted #13779) group_b_route_offer) never exceeds the engine's ceiling, so
// no turn waits inside the engine either. What waits is the caller's. The ruling declares that backlog
// caller-owned and names what makes it DURABLE rather than merely retried: each property below. The
// seven properties are established by gunbc.serving.caller_backlog; caller_backlog_standing derives
// DurableCallerBacklog from those rows. An EXTERNAL RETRY OBLIGATION remains the name for any roster
// that has not established every property.
//
// THE STANDING IS DERIVED, NEVER AUTHORED. caller_backlog_standing folds the property rows, and a
// "durable caller backlog" exists only when every row is established with its basis. Adding a server
// queue is not the trigger; the executing basis is the caller's persisted snapshot, not a router-local
// queue.
type DurableRetryProperty
  = PersistBeforeOffer
  | RetriableRefusal
  | StableTurnIdentity
  | IdempotentRetryDuplicateSuppression
  | NoExpiryOnLongWait
  | DurableCancellation
  | NoDoubleExecution

fn durable_retry_property_wire(p: DurableRetryProperty) -> NonEmptyStr {
  match p {
    PersistBeforeOffer => "persist-before-offer" as NonEmptyStr
    RetriableRefusal => "retriable-refusal" as NonEmptyStr
    StableTurnIdentity => "stable-turn-identity" as NonEmptyStr
    IdempotentRetryDuplicateSuppression => "idempotent-retry" as NonEmptyStr
    NoExpiryOnLongWait => "no-expiry-on-long-wait" as NonEmptyStr
    DurableCancellation => "durable-cancellation" as NonEmptyStr
    NoDoubleExecution => "no-double-execution" as NonEmptyStr
  }
}

type DurableRetryPropertyStanding
  = RetryPropertyEstablished { basis: NonEmptyStr }
  | RetryPropertyUnestablished { obligation: NonEmptyStr }

type DurableRetryPropertyRow {
  property: DurableRetryProperty
  standing: DurableRetryPropertyStanding
}

type CallerBacklogStanding
  = DurableCallerBacklog
  | ExternalRetryObligation { unmet: List<DurableRetryProperty> }
  | CallerBacklogRosterMalformed { duplicated: List<DurableRetryProperty> }

fn durable_retry_property_eq(a: DurableRetryProperty, b: DurableRetryProperty) -> Bool {
  durable_retry_property_wire(p: a) as String == durable_retry_property_wire(p: b) as String
}

// THE STANDING IS DERIVED AGAINST THE CANONICAL SEVEN, NOT AGAINST WHATEVER ROWS WERE SUPPLIED (side-chat
// review): a property with no row is unmet, never vacuously satisfied, and a property with two rows is a
// malformed roster that refuses rather than letting either row decide. DurableCallerBacklog exists only
// when every one of the seven has exactly one row and that row is established.
fn caller_backlog_standing(rows: List<DurableRetryPropertyRow>) -> CallerBacklogStanding {
  let duplicated = filter(durable_retry_properties, p => length(filter(rows, r => durable_retry_property_eq(a: r.property, b: p))) > 1)
  let unmet = filter(durable_retry_properties, p => !any(rows, r => durable_retry_property_eq(a: r.property, b: p) && match r.standing {
    RetryPropertyEstablished { basis: _ } => true
    RetryPropertyUnestablished { obligation: _ } => false
  }))
  if length(duplicated) > 0 {
    CallerBacklogRosterMalformed { duplicated: duplicated }
  } else if length(unmet) == 0 {
    DurableCallerBacklog
  } else {
    ExternalRetryObligation { unmet: unmet }
  }
}

data durable_retry_properties: List<DurableRetryProperty> = [
  PersistBeforeOffer, RetriableRefusal, StableTurnIdentity, IdempotentRetryDuplicateSuppression,
  NoExpiryOnLongWait, DurableCancellation, NoDoubleExecution,
]

// ── WHAT THE SERVING ROUTE'S CALLERS ESTABLISH ──────────────────────────────────────────────────
//
// Each row names the gunbc.serving.caller_backlog fold that executes the property. The standing is
// derived: caller_backlog_standing yields DurableCallerBacklog only because every row is established
// against those folds. A router-local queue is not the basis (gunbc.serving.router_realization
// forbids MaintainAuthoritativeBindingLedger); the caller's persisted snapshot is.
data serving_route_caller_retry_rows: List<DurableRetryPropertyRow> = [
  DurableRetryPropertyRow { property: PersistBeforeOffer, standing: RetryPropertyEstablished { basis: persist_before_offer_basis } },
  DurableRetryPropertyRow { property: RetriableRefusal, standing: RetryPropertyEstablished { basis: retriable_refusal_basis } },
  DurableRetryPropertyRow { property: StableTurnIdentity, standing: RetryPropertyEstablished { basis: stable_turn_identity_basis } },
  DurableRetryPropertyRow { property: IdempotentRetryDuplicateSuppression, standing: RetryPropertyEstablished { basis: idempotent_retry_basis } },
  DurableRetryPropertyRow { property: NoExpiryOnLongWait, standing: RetryPropertyEstablished { basis: no_expiry_on_long_wait_basis } },
  DurableRetryPropertyRow { property: DurableCancellation, standing: RetryPropertyEstablished { basis: durable_cancellation_basis } },
  DurableRetryPropertyRow { property: NoDoubleExecution, standing: RetryPropertyEstablished { basis: no_double_execution_basis } },
]

fn caller_backlog_wire(s: CallerBacklogStanding) -> String {
  match s {
    DurableCallerBacklog => "the backlog is the caller's and is durable: every durable-retry property is established"
    ExternalRetryObligation { unmet: us } =>
      join(["the backlog is the caller's -- an EXTERNAL RETRY OBLIGATION, not a durable backlog; unmet: ",
        join(map(us, u => durable_retry_property_wire(p: u) as String), ", ")], "")
    CallerBacklogRosterMalformed { duplicated: ds } =>
      join(["the caller's durable-retry roster is malformed (a property has more than one row: ",
        join(map(ds, d => durable_retry_property_wire(p: d) as String), ", "), "), so no backlog standing is derived"], "")
  }
}

fn serving_route_caller_backlog() -> CallerBacklogStanding {
  caller_backlog_standing(rows: serving_route_caller_retry_rows)
}
