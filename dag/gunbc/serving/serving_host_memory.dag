module gunbc.serving.serving_host_memory

import std.types { String, NonEmptyStr, List, Bool }
import std.nat { Nat }
import std.optional { Present, Absent }
import std.measure {
  ByteSize, byte_size, byte_size_count, measure_add, Memory, One,
  TokenCount, token_count, token_count_value,
  kibibyte, kibibyte_to_byte_size, mebibyte, mebibyte_to_byte_size, gibibyte, gibibyte_to_byte_size,
  Gibibyte, gibibyte_count,
  Permille, permille, permille_count,
}
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.accounting.budget { Appropriation, LineItem }
import product.budget_tree { BudgetNode, BudgetClaim, Guaranteed, node_conserves_local }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_6ce85c, operator_host_srv3, operator_host_srv4 }
import gunbc.host.host_memory_carrier { HostUsableRam, HostUsableRamMeasured, HostUsableRamConservativeLowerBound, HostUsableRamUnmeasured, HostFixedOverhead, HostFixedOverheadMeasured, HostFixedOverheadAllowance, HostFixedOverheadUnmeasured }

// WHAT A SERVING HOST'S RAM IS SPENT ON, AND WHETHER IT FITS WITH NO SWAP. A serving engine keeps the
// sessions it is not running parked in host RAM (Strata's conversation cache, vLLM's LMCache L1), and a
// session it cannot keep parked is re-read from token 0 at prefill speed on its next turn: on h11-a16 that
// was 8-25 minutes per turn on 2026-10-30, with 810 parks skipped for lack of physical RAM. So the RAM
// budget is not a tuning detail; it is the number of sessions the host can keep warm.
//
// THE RULE: swap is an overflow guard with a declared bound, never a cache. The operator (2026-10-30): "we
// can give a bit of swap, its just that, we should be parking sessions to disk, not swap". So each engine may
// swap at most the host's swap_bound, which keeps a brief overrun from being an OOM kill; parked sessions
// belong in the engine's cache and, later, a deliberate disk tier (a declared frontier below). A layout whose
// engine may swap more than the bound is refused before anything else is weighed.
//
// THE CARRIER IS product.budget_tree, the same one gunbc.fleet.fleet_host_budget and gunbc.ci.ci_budget_tree
// use for the CI hosts. This module adds only what a serving host has that those do not: weights resident
// once and shared by every engine, and per-engine parked-session caches.

// ONE MEMORY FIGURE OF AN ENGINE: read off the host, assumed (an allowance someone declared and a reading
// will replace), or not known at all. Unread is never a zero: a cap nobody read has not been shown to be
// small, and a cache nobody read has not been shown to be empty. Assumed is a figure a verdict may use, but
// every result built on one names it among its assumptions (gunbc.serving.serving_layout).
type ServingMemoryReading
  = ServingMemoryRead { bytes: ByteSize, provenance: NonEmptyStr }
  | ServingMemoryAssumed { bytes: ByteSize, reason: NonEmptyStr }
  | ServingMemoryUnread { reason: NonEmptyStr }

// memory_cap is the engine's SOFT cgroup cap (systemd MemoryHigh, or docker's soft limit): the point at which
// the kernel starts reclaiming, NOT a hard stop. memory_max is the HARD ceiling (systemd MemoryMax, or docker
// --memory as the only limit): the figure the cgroup enforces absolutely, so it is the fail-closed number a
// serving reservation charges the runner for. They DIFFER (srv3 caps at MemoryHigh 96 GiB under MemoryMax 112
// GiB), so both are modeled rather than one resting on the other's prose (review 93375, single_authority: the
// ceiling is read once here and the reservation derives from it, not a second literal). swap_cap: MemorySwapMax
// (or --memory-swap). base: what the engine uses before it parks any session, which only a reading taken with
// nothing parked measures. conversation_cache: the parked-session budget it is launched with (Strata
// --conversation-cache-mib, vLLM LMCache L1). conversation_slots: how many sessions it may hold at once
// (Strata --conversation-cache-slots); Absent where the engine bounds parked sessions by bytes only.
type ServingEngineMemory {
  name: NonEmptyStr
  memory_cap: ServingMemoryReading
  memory_max: ServingMemoryReading
  swap_cap: ServingMemoryReading
  base: ServingMemoryReading
  conversation_cache: ServingMemoryReading
  conversation_slots: Nat?
}

// A HOST THAT DOES NOTHING BUT SERVE, so its whole RAM is this tree. A host that also runs CI or dashboard
// sessions (srv1, srv3, srv4) is NOT one: its RAM is already partitioned by gunbc.fleet.fleet_host_budget,
// and a second tree over the same RAM would be a second authority for it (gunbc.design_argument::single_authority).
type ServingDedicatedHostMemory {
  host: HostIdentity
  usable_ram: HostUsableRam
  overhead: HostFixedOverhead
  // Weights resident once and mapped by every engine (h11's routed-expert GGUF, locked in page cache by
  // strata-expert-lock.service).
  shared_resident: ByteSize
  // The most any one engine may swap (MemorySwapMax): an overrun guard, never where sessions park.
  swap_bound: ByteSize
  engines: List<ServingEngineMemory>
}

type ServingMemoryVerdict
  = ServingMemoryEngineSwapOverBound { engine: NonEmptyStr, swap_cap: ByteSize, bound: ByteSize }
  | ServingMemoryOversubscribed { committed_at_least: ByteSize, usable_ram: ByteSize }
  | ServingMemoryEngineOverCap { engine: NonEmptyStr }
  | ServingMemoryUndetermined { missing: List<NonEmptyStr> }
  | ServingMemoryFits { spare: ByteSize }

fn serving_bytes_total(xs: List<ByteSize>) -> ByteSize {
  fold(xs, init: byte_size(count: 0), f: (acc, x) => measure_add(a: acc, b: x))
}

fn serving_claim(purpose: String, amount: ByteSize) -> BudgetClaim {
  BudgetClaim { item: LineItem { purpose: purpose, amount: amount }, priority: Guaranteed }
}

// An unread figure is charged as zero HERE ONLY, inside a lower bound: a host that is oversubscribed while
// the unread figures count nothing is oversubscribed whatever they turn out to be. Fits never reads this.
fn serving_reading_bytes_or_zero(r: ServingMemoryReading) -> ByteSize {
  match r {
    ServingMemoryRead { bytes: b, provenance: _ } => b
    ServingMemoryAssumed { bytes: b, reason: _ } => b
    ServingMemoryUnread { reason: _ } => byte_size(count: 0)
  }
}

// The figure a reading HAS, or Absent when it is unread -- the third reading accessor beside
// serving_reading_bytes_or_zero (which invents a zero for a LOWER BOUND only) and serving_reading_missing. A rule
// that RELATES two figures (floor <= occupies, in serving_layout's hold gate) must ABSTAIN on an unread figure
// rather than compare against a fabricated zero: comparing an unread figure to a sibling would either refuse a
// legitimate absence or pass a real violation, so it returns Option and the caller decides what an absence means.
fn serving_reading_known_bytes(r: ServingMemoryReading) -> ByteSize? {
  match r {
    ServingMemoryRead { bytes: b, provenance: _ } => Present { value: b }
    ServingMemoryAssumed { bytes: b, reason: _ } => Present { value: b }
    ServingMemoryUnread { reason: _ } => Absent
  }
}

fn serving_reading_assumption(r: ServingMemoryReading) -> List<NonEmptyStr> {
  match r {
    ServingMemoryAssumed { bytes: _, reason: why } => [why]
    _ => [] as List<NonEmptyStr>
  }
}

fn serving_reading_missing(r: ServingMemoryReading) -> List<NonEmptyStr> {
  match r {
    ServingMemoryUnread { reason: why } => [why]
    _ => [] as List<NonEmptyStr>
  }
}

fn serving_usable_ram_bytes_or_zero(r: HostUsableRam) -> ByteSize {
  match r {
    HostUsableRamMeasured { bytes: b, provenance: _ } => b
    HostUsableRamConservativeLowerBound { bytes: b, basis: _ } => b
    HostUsableRamUnmeasured { reason: _ } => byte_size(count: 0)
  }
}

fn serving_overhead_bytes_or_zero(o: HostFixedOverhead) -> ByteSize {
  match o {
    HostFixedOverheadMeasured { bytes: b, provenance: _ } => b
    HostFixedOverheadAllowance { bytes: b, reason: _ } => b
    HostFixedOverheadUnmeasured { reason: _ } => byte_size(count: 0)
  }
}

// ONE ENGINE AS A CHILD: its appropriation is its cgroup cap, and inside that cap it owes its base and its
// parked-session budget. A cache that does not fit under the cap beside the base is a cache the engine was
// told it has and cannot use.
fn serving_engine_budget_node(e: ServingEngineMemory) -> BudgetNode {
  BudgetNode {
    name: e.name as String,
    appropriation: Appropriation { ceiling: serving_reading_bytes_or_zero(r: e.memory_cap) },
    claims: [
      serving_claim(purpose: "engine_base", amount: serving_reading_bytes_or_zero(r: e.base)),
      serving_claim(purpose: "conversation_cache", amount: serving_reading_bytes_or_zero(r: e.conversation_cache)),
    ],
    children: [],
  }
}

fn serving_host_budget_tree(h: ServingDedicatedHostMemory) -> BudgetNode {
  BudgetNode {
    name: h.host as String,
    appropriation: Appropriation { ceiling: serving_usable_ram_bytes_or_zero(r: h.usable_ram) },
    claims: [
      serving_claim(purpose: "host_fixed_overhead", amount: serving_overhead_bytes_or_zero(o: h.overhead)),
      serving_claim(purpose: "shared_resident_weights", amount: h.shared_resident),
    ],
    children: map(h.engines, e => serving_engine_budget_node(e: e)),
  }
}

fn serving_engine_swap_violation(engines: List<ServingEngineMemory>, bound: ByteSize) -> ServingMemoryVerdict? {
  fold(engines, init: Absent, f: (acc, e) =>
    match acc {
      Present { value: v } => Present { value: v }
      Absent =>
        match e.swap_cap {
          ServingMemoryUnread { reason: _ } => Absent
          _ =>
            if byte_size_count(b: serving_reading_bytes_or_zero(r: e.swap_cap)) > byte_size_count(b: bound) { Present { value: ServingMemoryEngineSwapOverBound { engine: e.name, swap_cap: serving_reading_bytes_or_zero(r: e.swap_cap), bound: bound } } } else { Absent }
        }
    })
}

fn serving_engine_over_cap(engines: List<ServingEngineMemory>) -> ServingMemoryVerdict? {
  fold(engines, init: Absent, f: (acc, e) =>
    match acc {
      Present { value: v } => Present { value: v }
      Absent =>
        match e.memory_cap {
          ServingMemoryUnread { reason: _ } => Absent
          _ =>
            if node_conserves_local(node: serving_engine_budget_node(e: e)) { Absent } else { Present { value: ServingMemoryEngineOverCap { engine: e.name } } }
        }
    })
}

// EVERY FIGURE A FITS VERDICT WOULD STAND ON, named when it is missing. An unread swap cap is missing too:
// an engine whose swap cap nobody read has not been shown to stay within the bound.
fn serving_engine_missing(e: ServingEngineMemory) -> List<NonEmptyStr> {
  concat(serving_reading_missing(r: e.memory_cap), concat(serving_reading_missing(r: e.swap_cap),
    concat(serving_reading_missing(r: e.base), serving_reading_missing(r: e.conversation_cache))))
}

fn serving_host_missing(h: ServingDedicatedHostMemory) -> List<NonEmptyStr> {
  let ram = match h.usable_ram {
    HostUsableRamMeasured { bytes: _, provenance: _ } => [] as List<NonEmptyStr>
    HostUsableRamConservativeLowerBound { bytes: _, basis: _ } => [] as List<NonEmptyStr>
    HostUsableRamUnmeasured { reason: r } => [r]
  }
  let overhead = match h.overhead {
    HostFixedOverheadMeasured { bytes: _, provenance: _ } => [] as List<NonEmptyStr>
    HostFixedOverheadAllowance { bytes: _, reason: _ } => [] as List<NonEmptyStr>
    HostFixedOverheadUnmeasured { reason: r } => [r]
  }
  concat(ram, concat(overhead, flat_map(h.engines, e => serving_engine_missing(e: e))))
}

// THE ARM ORDER IS THE POLICY. An engine that may swap past the bound refuses first: it is the rule. Then the host: what is
// committed (overhead, shared weights, every engine's cap) against usable RAM, which can be shown over
// budget from a lower bound even while some figures are unread. Then each engine against its own cap.
// Only a layout with every figure read reaches Fits.
fn serving_host_memory_verdict(h: ServingDedicatedHostMemory) -> ServingMemoryVerdict {
  let tree = serving_host_budget_tree(h: h)
  let ram = serving_usable_ram_bytes_or_zero(r: h.usable_ram)
  let committed = serving_bytes_total(xs: concat(
    [serving_overhead_bytes_or_zero(o: h.overhead), h.shared_resident],
    map(h.engines, e => serving_reading_bytes_or_zero(r: e.memory_cap))))
  let ram_read = match h.usable_ram {
    HostUsableRamUnmeasured { reason: _ } => false
    _ => true
  }
  match serving_engine_swap_violation(engines: h.engines, bound: h.swap_bound) {
    Present { value: v } => v
    Absent =>
      if ram_read && !node_conserves_local(node: tree) {
        ServingMemoryOversubscribed { committed_at_least: committed, usable_ram: ram }
      } else {
        match serving_engine_over_cap(engines: h.engines) {
          Present { value: v } => v
          Absent =>
            if serving_host_missing(h: h).length() > 0 {
              ServingMemoryUndetermined { missing: serving_host_missing(h: h) }
            } else {
              ServingMemoryFits { spare: byte_size(count: byte_size_count(b: ram) - byte_size_count(b: committed)) }
            }
        }
      }
  }
}

// THE DECISION THE OPERATOR MAKES, as arithmetic: with no swap, how much parked-session cache each of N
// equal engines can be given once the host overhead, the shared weights and each engine's base are paid.
// Absent when the engines do not fit at all: that many engines leave no cache, which is the answer, not a
// zero-sized cache.
fn serving_engine_cache_allowance(usable_ram: ByteSize, overhead: ByteSize, shared_resident: ByteSize, engines: Nat, base: ByteSize) -> ByteSize? {
  let fixed = byte_size_count(b: overhead) + byte_size_count(b: shared_resident)
  let ram = byte_size_count(b: usable_ram)
  if engines == 0 || ram <= fixed {
    Absent
  } else {
    let per_engine = (ram - fixed) / engines
    if per_engine > byte_size_count(b: base) { Present { value: byte_size(count: per_engine - byte_size_count(b: base)) } } else { Absent }
  }
}

// WHAT ONE PARKED SESSION COSTS: a fixed part (the engine's checkpoints and running state; Strata keeps up
// to 6 checkpoints of ~118 MB, docs/DETAILS.md "Conversation cache") and a part per token of context.
type ConversationSnapshotCost {
  fixed: ByteSize
  per_token: ByteSize
  provenance: NonEmptyStr
  // The longest conversation a parked snapshot was actually read at: beyond it the cost is extrapolated.
  observed_up_to: TokenCount
}

fn conversation_snapshot_bytes(cost: ConversationSnapshotCost, context: TokenCount) -> ByteSize {
  byte_size(count: byte_size_count(b: cost.fixed) + byte_size_count(b: cost.per_token) * token_count_value(t: context))
}

// HOW MANY SESSIONS OF THIS CONTEXT ONE ENGINE CAN KEEP WARM: bounded by its byte budget and by its slots.
// Absent when the cache figure is unread: an unread cache keeps no session warm that anyone can count on.
fn engine_warm_sessions(e: ServingEngineMemory, cost: ConversationSnapshotCost, context: TokenCount) -> Nat? {
  match e.conversation_cache {
    ServingMemoryUnread { reason: _ } => Absent
    _ =>
      Present { value: serving_warm_sessions_within(cache: serving_reading_bytes_or_zero(r: e.conversation_cache), slots: e.conversation_slots, snapshot: conversation_snapshot_bytes(cost: cost, context: context)) }
  }
}

fn serving_warm_sessions_within(cache: ByteSize, slots: Nat?, snapshot: ByteSize) -> Nat {
  let by_bytes = byte_size_count(b: cache) / byte_size_count(b: snapshot)
  match slots {
    Absent => by_bytes
    Present { value: n } => if by_bytes < n { by_bytes } else { n }
  }
}

// THE IQ3_S STRATA SNAPSHOT COST ON h11-a16, an upper envelope over the engine's own park lines read
// 2026-10-30 (h11-a16 ~/strata-pool/engine-87.log and engine-88.log): 5,701 tokens parked as 405,726,684
// bytes, 28,477 as 729,581,564, 65,410 as 1,299,665,064, 176,183 as 2,420,042,020. 750 MiB plus 10 KiB per
// token lies above every one of them, so it does not promise a session more room than it took.
data strata_iq3_s_snapshot_cost: ConversationSnapshotCost = ConversationSnapshotCost {
  fixed: mebibyte_to_byte_size(m: mebibyte(count: 750)),
  per_token: kibibyte_to_byte_size(k: kibibyte(count: 10)),
  provenance: "h11-a16 Strata 0.1.48 conversation-cache park lines, engine-87.log and engine-88.log, read 2026-10-30" as NonEmptyStr,
  observed_up_to: token_count(count: 176183),
}

// srv4's Strata release 406c9de18cef (q4_0 KV, 65,536 resident cells), as the upper envelope of its 63 parks
// (19 to 203,349 tokens) in the engine logs under /opt/gunbc-serving/srv4-daily/state: no park lies above
// 800 MiB plus 10 KiB per token. A different release and KV setting than h11's, so its own row.
data srv4_strata_snapshot_cost: ConversationSnapshotCost = ConversationSnapshotCost {
  fixed: mebibyte_to_byte_size(m: mebibyte(count: 800)),
  per_token: kibibyte_to_byte_size(k: kibibyte(count: 10)),
  provenance: "srv4 Strata 406c9de18cef conversation-cache park lines, state/*.log, read 2026-10-30" as NonEmptyStr,
  observed_up_to: token_count(count: 203349),
}

// srv3's Strata (strata-main build, q4_0 KV, 2x RTX 2000 Ada), the upper envelope of all 22,002 parks in
// ~/strata-pool/engine.log read 2026-11-08 (up to 228,921 tokens): at 10 KiB per token the largest fixed part
// any park needed was 1,234.2 MiB, so 1,240 MiB plus 10 KiB per token lies above every one. A different build
// from srv4's, and srv4's 800 MiB envelope does not cover it, so its own row.
// SRV4's PARKED-CONVERSATION DISK BUDGET, AND THE FREE SPACE THAT MUST ADMIT IT (operator, 2026-11-09: "small RAM L1 +
// larger disk", capped disk with minimal host impact). The BUDGET is a declared workflow figure, so it is an assumption
// carrying its reason and its read obligation -- never a ServingMemoryRead, which would present a decision as an
// observation. It is also NOT the filesystem's free space: free space is a separate reading that must admit the budget
// (gunbc.serving.strata_parked_tier), because a tier sized to whatever the disk happens to have left is a tier that
// shrinks when something else writes, and a save that fails for space must not be a surprise at park time. 128 GiB
// holds roughly seventy conversations at srv4's declared snapshot cost (srv4_strata_snapshot_cost: 800 MiB plus 10 KiB
// per token, so ~1.8 GiB at the anchor context) -- far more than the 16 GiB RAM tier's eight slots, which is the point
// of the ladder. srv3's own rows (srv3_host_free_disk, srv3_strata_parked_budget, srv3_strata_snapshot_cost) follow
// below: its replica runs --batch 8 and the engine refuses save/restore under parallel requests, so its rung is
// refused today, and those rows are what its verdict reads the day the batch lifts (it has ~1.3 TB free, read 2026-11-09).
data srv4_strata_parked_budget: ServingMemoryReading = ServingMemoryAssumed {
  bytes: gibibyte_to_byte_size(g: gibibyte(count: 128)),
  reason: "declared cap on router-driven slot-file saves (workflow decision, 2026-11-09, under the operator's capped-disk instruction): read the bytes actually written per parked conversation on srv4 (du over slot_save_path through real turns) and revise this to what the engine really costs, not what was guessed" as NonEmptyStr
}

data srv4_host_free_disk: ServingMemoryReading = ServingMemoryRead {
  bytes: gibibyte_to_byte_size(g: gibibyte(count: 186)),
  provenance: "read 2026-11-09 by bold-wren-111 over ssh: ~200 GB free on srv4 after the swap files were deleted (the disk was 85% full at 69 GB before); recorded as 186 GiB, the round figure at or under the reading (~200 GB = 186.3 GiB), so a budget this row admits is admitted by the host -- recording the observed GB as GiB would round UP and widen the very wall that admits the disk budget (gunbc.design_argument::fail_closed)" as NonEmptyStr
}

// SRV3's parked-conversation tier rows, as srv4's mirror: its OWN declared budget and its OWN free-space reading.
// srv3's live --batch 8 refuses the rung today, so these two rows are what the verdict will be checked against the
// day srv3 drops --batch; reading srv4's rows for srv3 would be the duplicated-reading defect again.
data srv3_host_free_disk: ServingMemoryReading = ServingMemoryRead {
  bytes: gibibyte_to_byte_size(g: gibibyte(count: 1200)),
  provenance: "df on srv3 (192.168.1.221), 2026-11-09, read by bold-wren-111 for this item: 1.3 TB free; recorded as 1200 GiB, the round figure at or under the reading, so a budget admitted by this row is admitted by the host." as NonEmptyStr,
}

data srv3_strata_parked_budget: ServingMemoryReading = ServingMemoryAssumed {
  bytes: gibibyte_to_byte_size(g: gibibyte(count: 32)),
  reason: "srv3's OWN declared cap on router-driven slot-file saves -- NOT the same figure as srv4 (srv4 declares 128 GiB on its dedicated release; srv3 declares 32 GiB, the conservative first-declared cap on the hand-run strata-pool host, which is a test pool at /home/ubuntu/strata-pool shared with CI runners rather than a dedicated serving box, so it is declared smaller until it earns the bytes). Each host declares independently; srv3's is a distinct bet, not a copy. Declared, not read, and UNTESTED on this host: srv3 runs --batch 8 today, which refuses slot save/restore outright, so no slot file has ever been written there. The read obligation is to re-admit the rung only when srv3's pool drops --batch (server.py:4091's 501 lifts with it) and then du the slot dir under /home/ubuntu/strata-pool. NEVER free space, which must admit this instead." as NonEmptyStr,
}

data srv3_strata_snapshot_cost: ConversationSnapshotCost = ConversationSnapshotCost {
  fixed: mebibyte_to_byte_size(m: mebibyte(count: 1240)),
  per_token: kibibyte_to_byte_size(k: kibibyte(count: 10)),
  provenance: "srv3 Strata ~/strata-pool/engine.log conversation-cache park lines (snapshot_bytes), 22,002 parks, read 2026-11-08" as NonEmptyStr,
  observed_up_to: token_count(count: 228921),
}

// srv1's vLLM conversation on LMCache's DISK tier (L2). The per-token part is the engine's own KV density: one TP=1
// replica's 14.3 GiB of FP8 KV holds 744,477 tokens (gunbc.serving.srv1_topology_comparison), 20,625 bytes per token,
// so a 150k conversation is ~3 GiB (the operator's own figure, 2026-11-08). An earlier reading of 800 B/token divided
// one 3,272,704-byte disk object by the 4,096-token chunk, but lil-serve runs --separate-object-groups, so one chunk
// spans many objects: it understated the cost ~25x and is withdrawn. This hybrid model also stores its recurrent
// state as one bundle per conversation, the largest on disk 524,922,880 bytes (500.6 MiB): 512 MiB covers it.
data srv1_vllm_disk_snapshot_cost: ConversationSnapshotCost = ConversationSnapshotCost {
  fixed: mebibyte_to_byte_size(m: mebibyte(count: 512)),
  per_token: byte_size(count: 20625),
  provenance: "srv1 TP=1 KV pool 744,477 tokens in 14.3 GiB (operator relay, 2026-11-08) and the largest state object under /cache/kv, read 2026-11-08" as NonEmptyStr,
  observed_up_to: token_count(count: 150000),
}

// srv1's LMCache disk tier PER REPLICA as it runs: LMCACHE_L2_GB=125 (LMCACHE_L1_GB=12) on each of lil-flash-next and
// lil-flash-next-1, started 2026-11-08T20:24Z, each over its own host directory (~/lil/kv and ~/lil/kv-gpu1; the
// containers' start commands, read 2026-11-08 21:5xZ). LMCache's GB is GiB: at L2_GB=150 it rejected stores at exactly
// 161,061,273,600 bytes (150 x 2^30). Kept
// at its eviction watermark of 0.80 ("L2 usage 0.80 above watermark 0.80; triggering eviction" in serve.log). The
// bytes that stay warm are the configured size at the watermark, derived from the two readings. It evicts; it does
// not refuse once full.
data srv1_lmcache_l2_configured: Gibibyte = gibibyte(count: 125)

data srv1_lmcache_l2_bytes: ByteSize = gibibyte_to_byte_size(g: srv1_lmcache_l2_configured)

data srv1_lmcache_l2_eviction_watermark: Permille = permille(count: 800)

// srv1's LMCache L1 PER REPLICA as it runs: LMCACHE_L1_GB=48 on each container. THE single authority for the
// L1 tier size — the launcher's `--env LMCACHE_L1_GB=` token, the START line's "L1 <n>G", and the host budget's
// `l1_shm` all cite THIS row, so the number that serves and the number that is priced cannot disagree (they
// could, until 2026-11-24: srv1_serving_replica_layout held its own copy and its comment asserted no owner
// here existed. It did, at this row).
//
// Read 2026-11-24 from the host's own bytes: /usr/local/etc/lil-replica/replica-{0,1}.args carry
// `LMCACHE_L1_GB=48` (both files identical, sha256 76737a58839259d3ecf4626a47bee489aea4d959cd64789e24f4e1b9bef95aca
// read on srv1), and the launcher's START event reads "L1 48G, L2 125G". The value BEFORE this read was 12 GiB
// — the run identity's environment of 2026-11-08, corroborated by srv1_lil_serve.sh's LMCache block — and the
// raise is what the eviction path's contract made necessary: under `--l2-store-policy checkpoint_on_evict` L1
// is not an optional cache but the only staging buffer between a checkpoint and the NVMe tier, so the old
// "small 12 GiB RAM tier" figure was priced against nothing. The contract and its refusal live with the
// launcher: gunbc.serving.srv1_serving_replica_layout::srv1_l1_staging_floor. The observation that found it —
// L1 pinned at 90-99%, ~740k fresh pages deleted 0.07-1 s after creation without being written, saves granted
// 48%/43% of the bytes they asked for, read from LMCache's own lines in ~/lil/serve/serve.log and
// ~/lil/serve-gpu1/serve.log by the operator's session on 2026-11-24 — is carried as the receipt on
// gunbc.recurring_failure_mode::a_serving_tier_sized_as_a_cache_while_the_store_policy_makes_it_the_only_path_to_disk.
// LMCache's GB is GiB, as the L2 row's rejection reading established. NOT the 2026-10-30 engine-memory figure
// below (L1_GB=100): that predates the 2026-11-08 move to two replicas.
// THE SAME TIER IN THE UNIT THE ENGINE'S KNOB TAKES IT, which is where the authority has to sit: LMCACHE_L1_GB
// is a whole number of gibibytes, so a row holding bytes and a second row dividing them back to GB is a second
// home for the number plus a division that can round. This is the ONE place the figure is written; the byte
// form below is DERIVED from it, and both launch paths read it — the provisioning launch's environment entry
// (gunbc.serving.srv1_serving_launch::srv1_serving_launch, which is copied into every provisioned container by
// gunbc.serving.serving_provision_derivation::srv1_serving_launch_for_port) and the boot launcher's
// LMCACHE_L1_GB argument (gunbc.serving.srv1_serving_replica_layout::srv1_replica_engine_args_body). That is
// the defect this row's existence removes: on 2026-11-24 the installed args files carried 48 while the
// provisioning row still carried the 2026-11-08 figure of 12, so a container provisioned from the model rather
// than installed by hand would have come up with a quarter of the tier its contract needs. The dated capture of
// that older reading is KEPT, as a capture, in gunbc.serving.srv1_serving_launch_witness::observed_cmd_tail.
// TYPED IN THE UNIT IT IS WRITTEN IN (review 98748): a `Nat` named `_gib` carries its unit in its name alone, and
// std.measure already has the carrier for it -- gunbc.std.measure::Gibibyte, read back with gibibyte_count. The
// bytes are derived, never written: srv1_lmcache_l1_bytes below.
data srv1_lmcache_l1_configured: Gibibyte = gibibyte(count: 48)

data srv1_lmcache_l1_bytes: ByteSize = gibibyte_to_byte_size(g: srv1_lmcache_l1_configured)

// The tier as its OWN KNOB spells it. The authority above is already a whole number of gibibytes, so this is a
// read of that row and not a conversion — which is the point: neither launch path has to divide bytes back into
// GB, and a division is exactly where a second copy of the figure used to live. The boot launcher's args file
// (gunbc.serving.srv1_serving_replica_layout::srv1_lmcache_engine_env) and this module's provisioning environment
// entry (gunbc.serving.srv1_serving_launch::srv1_serving_launch) both take the tier from here, and
// gunbc.serving.srv1_replica_rendered_boot_path_witness reads the operand out of BOTH and refuses if they differ.
fn srv1_lmcache_l1_gb_value() -> NonEmptyStr {
  to_string(gibibyte_count(g: srv1_lmcache_l1_configured)) as NonEmptyStr
}

// The disk tier's knob, spelled the same way for the same reason.
fn srv1_lmcache_l2_gb_value() -> NonEmptyStr {
  to_string(gibibyte_count(g: srv1_lmcache_l2_configured)) as NonEmptyStr
}

// THE CONTAINER'S HARD RAM CEILING, PER REPLICA — the same collapse applied to the number beside the tier.
// `docker run --memory=` (with --memory-swap equal, so it is an absolute stop and not a soft cap) was written
// in three places: srv1_serving_replica_layout's `Srv1ReplicaHostBudget.cgroup_memory_limit`, which the docker
// argv DERIVES its --memory/--memory-swap flags from, and this module's engine record srv1_vllm_engine_memory,
// which read it off the host on 2026-10-30 as 130g for the single-engine layout that no longer exists. Three
// copies of a cgroup limit is how a container can be installed at 72g while the model that budgets the host
// still believes 130g — and the budget is the copy that decides whether the pair fits the host's admitted
// memory. CITED by both from here. Read 2026-11-24 from the installed launcher's own bytes (sha256
// 1ad7de0857a4e06168aa603fd5b8d92f1a2ebc6395c84aa64900d5b968dc12ea, `--memory=72g --memory-swap=72g`); before
// that raise it was 32 GiB per replica, and 130g before the host moved to two replicas on 2026-11-08.
data srv1_replica_container_memory_cap: ByteSize = gibibyte_to_byte_size(g: gibibyte(count: 72))

data srv1_lmcache_l1_tier: ServingMemoryReading = ServingMemoryRead {
  bytes: srv1_lmcache_l1_bytes,
  provenance: "srv1 lil-flash-next and lil-flash-next-1 LMCACHE_L1_GB=48 each (the rendered args files installed on the host, sha256 76737a58839259d3ecf4626a47bee489aea4d959cd64789e24f4e1b9bef95aca read 2026-11-24; the launcher's START event reads L1 48G), was 12 GiB per replica from 2026-11-08 until that raise" as NonEmptyStr,
}

data srv1_vllm_disk_tier: ServingMemoryReading = ServingMemoryRead {
  bytes: byte_size(count: byte_size_count(b: srv1_lmcache_l2_bytes) * permille_count(p: srv1_lmcache_l2_eviction_watermark) / 1000),
  provenance: "srv1 lil-flash-next and lil-flash-next-1 LMCACHE_L2_GB=125 each (docker inspect, 2026-11-08) at the L2 eviction watermark 0.80 (serve.log eviction_controller)" as NonEmptyStr,
}

// THE SWAP BOUND, the operator's (2026-10-30): a little swap per engine so an overrun slows instead of being
// killed; 2 GiB is a small fraction of a 9-10 GiB engine and far below the 32 GiB each h11 engine had.
data serving_engine_swap_bound: ServingMemoryReading = ServingMemoryAssumed {
  bytes: gibibyte_to_byte_size(g: gibibyte(count: 2)),
  reason: "the operator's DECISION of 2026-10-30, not a measurement: a little swap per engine so an overrun slows instead of being killed; 2 GiB is a small fraction of a 9-10 GiB engine and far below the 32 GiB each h11 engine had (systemctl show h11-strata@87 MemorySwapMax=34359738368, read 2026-10-30T16:18Z). Read obligation: MemorySwapMax as actually configured on the live units, against this decision." as NonEmptyStr,
}

fn host_6ce85c_engine_as_launched(bus: String) -> ServingEngineMemory {
  ServingEngineMemory {
    name: ("h11-strata@" + bus) as NonEmptyStr,
    memory_cap: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 16)), provenance: "systemctl show h11-strata@87 MemoryMax=17179869184, the template unit every bus shares, read 2026-10-30T16:18Z" as NonEmptyStr },
    memory_max: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 16)), provenance: "systemctl show h11-strata@87 MemoryMax=17179869184 = 16 GiB, the template unit every bus shares, read 2026-10-30T16:18Z; on h11 the soft cap and the hard ceiling coincide" as NonEmptyStr },
    swap_cap: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 32)), provenance: "systemctl show h11-strata@87 MemorySwapMax=34359738368, read 2026-10-30T16:18Z" as NonEmptyStr },
    base: ServingMemoryUnread { reason: "h11 engine base: read one engine's memory.current with an empty conversation cache (right after a restart, before its first request)" as NonEmptyStr },
    conversation_cache: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 8192)), provenance: "h11-a16 ~/strata-pool/cfg-87.json --conversation-cache-mib 8192, the value convcache-8g.sh set on every bus 2026-10-27" as NonEmptyStr },
    conversation_slots: Present { value: 6 },
  }
}

// HOST host-6ce85c (H11SSL unit 1, hostname h11-a16) AS IT RUNS ON 2026-10-30: six engines (buses 85 87 88 c5 c7 c8; 86 and c6 disabled on 10-26), each
// capped at 16 GiB of RAM and allowed 32 GiB of swap, beside the routed-expert GGUF locked once in RAM.
// Eight 16 GB DIMMs are fitted, but slot H1 trains on some boots and is disabled on others
// (gunbc.machine_intake.supermicro_h11ssl_unit1_platform_standing supermicro_h11ssl_unit1_dimmh1_standing),
// and the boot this row was read on is one where it was disabled, so MemTotal is 110 GiB and not 125.
data host_6ce85c_serving_memory_observed: ServingDedicatedHostMemory = ServingDedicatedHostMemory {
  host: operator_host_6ce85c,
  usable_ram: HostUsableRamMeasured { bytes: kibibyte_to_byte_size(k: kibibyte(count: 115192288)), provenance: "h11-a16 /proc/meminfo MemTotal 115192288 kB, read 2026-10-30T16:18Z" as NonEmptyStr },
  overhead: HostFixedOverheadUnmeasured { reason: "h11 host overhead: the OS, sshd and the six server.py front ends, read with every engine stopped" as NonEmptyStr },
  // The whole routed-expert file, as strata-expert-lock holds it once it has locked all of it (VmLck 53532740
  // kB on 2026-10-30T19:05Z, equal to the 54,817,524,224-byte file). The 49,560,204 kB Mlocked read at 16:18Z
  // was the lock only partly held under that boot's memory pressure, not a smaller file.
  shared_resident: kibibyte_to_byte_size(k: kibibyte(count: 53532740)),
  swap_bound: serving_reading_bytes_or_zero(r: serving_engine_swap_bound),
  engines: [
    host_6ce85c_engine_as_launched(bus: "85"), host_6ce85c_engine_as_launched(bus: "87"), host_6ce85c_engine_as_launched(bus: "88"),
    host_6ce85c_engine_as_launched(bus: "c5"), host_6ce85c_engine_as_launched(bus: "c7"), host_6ce85c_engine_as_launched(bus: "c8"),
  ],
}

// ENGINES ON SHARED HOSTS, at engine grain only (the host trees are the frontier below).
//
// srv1 vLLM (lil-serve, one container per card). This row used to be a 2026-10-30 reading of the host —
// `--memory=130g --memory-swap=130g`, LMCache L1 100 GB, L2 150 GB, taken off ~/strata-test/srv1_lil_serve.sh
// while a single engine ran and the host was down pending a DIMM decision. It is no longer a reading: the three
// figures it restates are the launch shape, and after 2026-11-08 the launch shape lives in rows
// (gunbc.serving.srv1_serving_replica_layout renders the container from them), so restating them here was a
// SECOND ANSWER to "what is srv1's KV RAM tier" — 100 GB beside the 48 GiB the launcher renders, with nothing
// between them able to say which was running. Now CITED from the two rows that decide it:
// srv1_replica_container_memory_cap and srv1_lmcache_l1_configured. A change to the launch shape moves this row
// by construction, and the 2026-10-30 figures survive here only as provenance.
//
// IT DESCRIBES ONE OF TWO IDENTICAL REPLICAS. Since 2026-11-08 srv1 runs lil-flash-next and lil-flash-next-1,
// each TP=1 on its own card, with the same cap and the same tiers; the row is at engine grain, so its cap is
// PER REPLICA and the host carries two of them plus the PLE tables (the pair against the host's admitted
// memory is gunbc.serving.srv1_serving_replica_layout::srv1_replica_total_host_claim and the witness on it).
// What the 2026-10-30 single-engine boot read, kept because the provenance strings name it: one container at
// --memory=130g --memory-swap=130g (equal, so no swap), L1_GB=100, L2 150 GB.
data srv1_vllm_engine_memory: ServingEngineMemory = ServingEngineMemory {
  name: "srv1-lil-flash-next" as NonEmptyStr,
  memory_cap: ServingMemoryRead { bytes: srv1_replica_container_memory_cap, provenance: "CITED from srv1_replica_container_memory_cap (72 GiB per replica, the installed launcher's --memory=72g, sha256 1ad7de0857a4e06168aa603fd5b8d92f1a2ebc6395c84aa64900d5b968dc12ea read 2026-11-24). This row restated it as its own 130 GiB reading from 2026-10-30, when one container held the host; class B4 collapsed the copy" as NonEmptyStr },
  memory_max: ServingMemoryRead { bytes: srv1_replica_container_memory_cap, provenance: "CITED from srv1_replica_container_memory_cap: --memory-swap equals --memory in the installed launcher, so --memory is the absolute stop rather than a soft high-water mark — the same reading calm-crab-645 recorded of --memory=130g/--memory-swap=130g on 2026-10-30, now carried by the row instead of by this record" as NonEmptyStr },
  swap_cap: ServingMemoryRead { bytes: byte_size(count: 0), provenance: "no swap is allowed: --memory-swap=72g equals --memory=72g in the installed launcher (docker's memory-swap is RAM plus swap, so equal values leave none), read 2026-11-24; the same equality held of the 2026-10-30 pair" as NonEmptyStr },
  base: ServingMemoryUnread { reason: "srv1 vLLM base: the container's memory with LMCache L1 empty, read after its next start" as NonEmptyStr },
  // THE SECOND ANSWER TO "WHAT IS SRV1'S KV RAM TIER", CLOSED. This field read 100 GB (LMCache's GB, taken as
  // 10^9 — itself an unconfirmed reading) while the launcher rendered LMCACHE_L1_GB=12 into the container that
  // actually booted. Two figures for one tier, and the engine record was not the one any renderer read. Cited
  // from the row now, so it cannot lag the launch shape again; the durability obligation the tier carries is
  // not this record's to state and is modelled at
  // gunbc.serving.srv1_serving_replica_layout::srv1_l1_staging_floor.
  conversation_cache: ServingMemoryRead { bytes: srv1_lmcache_l1_bytes, provenance: "CITED from srv1_lmcache_l1_configured (48 GiB, LMCACHE_L1_GB=48 in the installed args files, sha256 76737a58839259d3ecf4626a47bee489aea4d959cd64789e24f4e1b9bef95aca read 2026-11-24). Read here as its own figure until class B4: LMCache L1_GB=100 on 2026-10-30 (LMCache's GB taken as 10^9 bytes, an unconfirmed reading of the unit), 12 GiB in what the launcher rendered from 2026-11-08 — three values for one tier" as NonEmptyStr },
  conversation_slots: Absent,
}

// srv3 Strata over the RTX 2000 Ada pair: its /metrics reported --conversation-cache-mib 65536 and 24 slots
// on 2026-10-30. bold-wren-111 read it over ssh on 2026-11-08 and put --mmap-experts and the service cap on it by
// hand on 2026-11-09 ~22:10Z, so "no shell on srv3" is long gone and the pinned-expert reading is withdrawn. Three
// figures now read: the cap the service's own MemoryHigh sets (96 GiB), the conversation cache, and its slots. Two
// are Stated bets with obligations: the base, derived from the live --batch-8 anon total (the loaded-and-idle anon is
// the read obligation), and the swap limit, kept Assumed(0) on the fleet convention (MemorySwapMax unread). The
// on-card expert cache and the shard size on disk stay unread/assumed on the artifact in gunbc.serving.serving_layout.
data srv3_strata_engine_memory: ServingEngineMemory = ServingEngineMemory {
  name: "srv3-strata" as NonEmptyStr,
  // THE CAP AS THE RAM L1 BOUND, modelled exactly as srv4's is. bold-wren-111 put a service drop-in on srv3
  // 2026-11-09 ~22:10Z (cfg.json.bak-20261109-pre-mmap keeps what it replaced), so what binds this engine is no
  // longer the strata.slice limit its guard reported at 110 GiB (2026-11-08) but the service's OWN MemoryHigh
  // 96 GiB (MemoryMax 112 GiB) — the slice's 110 GiB still stands above it but is no longer the tight edge, the
  // same way srv4's slice MemoryHigh no longer binds the engine its drop-in caps. The engine's own guard now
  // reports this figure from the service cgroup.
  memory_cap: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 96)), provenance: "drop-in /etc/systemd/system/strata-pool.service.d/60-expert-l1-cap.conf MemoryHigh=96G (MemoryMax=112G), installed by bold-wren-111 2026-11-09 ~22:10Z alongside --mmap-experts (the operator's 'sounds good', gunbc.design_ruling::srv3_experts_mmap_under_service_cap); the service cgroup is now the tight edge, and the strata.slice MemoryHigh 110 GiB the guard reported 2026-11-08 sits above it" as NonEmptyStr },
  memory_max: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 112)), provenance: "drop-in /etc/systemd/system/strata-pool.service.d/60-expert-l1-cap.conf MemoryMax=112G (the hard ceiling above MemoryHigh=96G), read 2026-11-09; gunbc.serving.serving_reservation srv3 charges this to the runner" as NonEmptyStr },
  swap_cap: ServingMemoryAssumed { bytes: byte_size(count: 0), reason: "the fleet's no-swap convention for serving slices: srv4's gunbc-srv4-daily.slice was read to MemorySwapMax=0 (2026-10-30) and h11's engines carry only 2 GiB, so srv3's strata.slice is budgeted at no swap. UNREAD on srv3 -- read obligation: systemctl show strata-pool.service -p MemorySwapMax; the figure is taken as 0 until that read lands. This row is srv3's swap limit's ONLY home; srv3_grant reads it rather than writing its own value (review 92498, single authority)" as NonEmptyStr },
  // THE BASE IS DERIVED FROM THE OBSERVED ANON, NOT READ AS THE IDLE BASE. base means the engine loaded and idle
  // with NOTHING retained; the only anon figure bold-wren-111 has (memory.stat anon ~8.7 GB under --mmap-experts at
  // the 96 GiB cap, 2026-11-09 ~22:10Z) was taken under LIVE --batch 8 load with long conversations retained, so it
  // is an upper estimate of the idle base, not that base. The number is kept (it is the only anon figure there is)
  // but its kind is Assumed until the idle measurement lands. It feeds srv3_grant's admitted count, so the figure is
  // stated as a bet with an obligation, not a fact. The field's VALUE is replaced by the live-derived 8297 on the
  // line below; the old Assumed 5284 MiB (srv4's pre-mmap 52 GiB less the 46.84 GiB private arena this engine no
  // longer allocates) is kept here only as the withdrawn derivation it is -- a reader must not mistake it for the
  // current figure.
  base: ServingMemoryAssumed { bytes: mebibyte_to_byte_size(m: mebibyte(count: 8297)), reason: "derived from the cgroup memory.stat anon total ~8.7 GB read by bold-wren-111 2026-11-09 ~22:10Z under --mmap-experts at the 96 GiB cap -- but taken under LIVE --batch 8 load with long conversations retained, whereas base means loaded-and-idle with nothing retained, so it is an upper estimate; read obligation: the engine's anon (memory.stat anon / VmRSS anon) on strata-pool.service with the batch warmed and nothing retained" as NonEmptyStr },
  conversation_cache: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 65536)), provenance: "srv3 Strata /metrics conversation_cache_mib 65536, read through the srv1 router's upstream 2026-10-30, and confirmed by the 2026-11-08 ssh read of strata-pool.service (conversation cache 64 GiB in 24 slots)" as NonEmptyStr },
  conversation_slots: Present { value: 24 },
}

// srv4's daily-workspace engine, on release 406c9de18cef. Read 2026-10-30T20:5xZ over the fleet credential, and
// again 2026-11-09 00:18Z after the operator's hand change (engine.json.bak-20261109-pre-mmap on the host keeps
// what it replaced): the engine now maps its experts (--mmap-experts, the GGUF shards in place, no experts.bin)
// and is capped by its own drop-in 60-expert-l1-cap.conf. The figures the change withdrew are named rather than
// quietly repainted — the slice's MemoryHigh 96 GiB / MemoryMax 120 GiB (2026-10-30) no longer describes what
// binds this engine, a base of 56,139,382,784 B that INCLUDED a 46.84 GiB private expert arena this engine no
// longer allocates, and a 32 GiB conversation cache. What binds it now is the service's own MemoryHigh 40 GiB
// (MemoryMax 48 GiB), and the base is the engine's own anon plus shmem: the 13.2 GiB of file-backed RSS beside it
// is the mapped expert tier, which gunbc.serving.serving_layout charges once as an artifact, never inside a base.
// Every figure here is a CANDIDATE reading, not a fleet recommendation: srv4's DIMM A1 is degraded (UE 262,144).
data srv4_serving_engine_memory: ServingEngineMemory = ServingEngineMemory {
  name: "gunbc-srv4-daily-engine" as NonEmptyStr,
  // THE CAP, AND THE TERMS IT HAS TO HOLD. This drop-in was written to bound one term -- the expert RAM tier
  // (the operator's 2026-11-09 instruction: "experts mmap-ed from NVMe, small RAM L1 under this cap", recorded in
  // gunbc.design_ruling::srv3_experts_mmap_under_service_cap and carried on
  // gunbc.serving.serving_layout::srv4_routed_expert_artifact) -- but the cgroup it sets is shared by four: the
  // mapped expert tier's OCCUPANCY, the conversation cache, the engine's park admission floor (its own
  // conversation_cache_min_free_mib, 2560 MiB on srv4) and the process base. At 56G/64G the cap held the expert
  // tier's 22 GiB working set and starved the other three: the conversation cache saw 2-3 GiB of room and logged
  // "conversation cache: skip parking (physical RAM admission; need N MiB plus 2560 MiB floor, M MiB available,
  // source cgroup; evicted K, 0 still parked)" on EVERY turn, so each next turn re-read a 75-95k-token prompt cold
  // (~90 s) and srv4 ran ~50% cache-warm against srv3's 96% (the operator's session, ad-hoc journal reads on srv4,
  // 2026-11-24). The operator raised the drop-in to 96G/112G -- srv3's long-standing figure -- on 2026-11-24
  // ~21:33Z (host file sha256 eb2b16e57eea76f2dd534c0bbb7aa016024462ad580cfb3836a1e8fad8bf581b, read 22:03-22:05Z);
  // afterwards the same journal logged "97815 reused + 1584 read", srv4 read 99.0% warm against 50.2%, and the
  // skip-parking line did not appear in the 21:40-21:55Z window (same instrument, same session). Those are
  // OBSERVATIONS with a named instrument, not deduced consequences: what the model now does with the number is
  // derive it from its terms -- gunbc.serving.serving_layout::serving_cgroup_terms -- and refuse a cap whose terms
  // do not fit, so the composition that was missing here cannot go missing silently again. The withdrawn 56G/64G
  // (and the 40G/48G before it, named in serving_layout::srv4_grant) stay named here rather than repainted.
  memory_cap: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 96)), provenance: "drop-in /etc/systemd/system/gunbc-srv4-daily-engine.service.d/60-expert-l1-cap.conf MemoryHigh=96G (MemoryMax=112G), the operator's hand raise of 2026-11-24 ~21:33Z over the 2026-11-09 56G/64G, which had starved the conversation cache beside the mapped expert tier (see this row's comment); matches srv3's long-standing 96G/112G and sits at the slice's own MemoryHigh (gunbc-srv4-daily.slice, 96G/120G). The engine's own memory guard reports the same limit from the cgroup" as NonEmptyStr },
  memory_max: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 112)), provenance: "drop-in /etc/systemd/system/gunbc-srv4-daily-engine.service.d/60-expert-l1-cap.conf MemoryMax=112G (the hard ceiling above MemoryHigh=96G), the 2026-11-24 raise of the 2026-11-09 64G; gunbc.serving.serving_reservation srv4 charges this to the runner" as NonEmptyStr },
  swap_cap: ServingMemoryRead { bytes: byte_size(count: 0), provenance: "systemctl show gunbc-srv4-daily.slice MemorySwapMax=0, 2026-10-30; the 2026-11-09 drop-in caps memory only, so no swap remains" as NonEmptyStr },
  base: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 6451)), provenance: "VmRSS 19.5 GB after load under --mmap-experts = anon 2.5 GiB + file 13.2 GiB + shmem 3.8 GiB; the base is the anon and shmem the engine owns (6451 MiB), the file part is the expert artifact's host-RAM rung (2026-11-09 00:18Z)" as NonEmptyStr },
  conversation_cache: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 16384)), provenance: "engine.json --conversation-cache-mib 16384, read 2026-11-09 with the mmap change (it was 32768 MiB on 2026-10-30); 3.8 GiB of shmem was resident in it at the read" as NonEmptyStr },
  conversation_slots: Present { value: 8 },
}

// RETIRED 2026-11-24: butch_a_strata_engine_memory and butch_b_strata_engine_memory are GONE with the
// operator-hand-retired engines (strata-pool@a/@b + strata-expert-lock; boot states
// gunbc.serving.serving_reservation::srv14_serving_unit_boot_states) and the discharged 192 GiB serving
// reservation (dissolved_frontier marker in gunbc.serving.serving_reservation; operator ruling
// gunbc.design_ruling::srv14_serving_memory_charge_retirement_operator_approved_2026_11_24). The 2026-11-12
// uncapped-then-capped reads (hand drop-in 60-memory-cap.conf, MemoryMax=96G, msg_5b61137b) they recorded are
// historical; the post-retirement host state is the quiescent peer read in
// gunbc.host.host_memory_observation (run 45321352046).

// DECLARED FRONTIERS (gunbc.design_argument::consumption).
//
// Consumer: the h11 cell's launch row renders its MemoryMax, MemorySwapMax (zero) and
// --conversation-cache-mib/--conversation-cache-slots from a layout this verdict passes, and the router's
// placement binds a session only where engine_warm_sessions has room. Neither exists yet; until they do
// the witnesses are the only readers.
data serving_host_memory_consumer_frontier: DissolutionCondition = unbound_dissolution(
  description: "Delete this frontier when the h11 Strata cell's launch row derives MemoryMax, MemorySwapMax and the conversation-cache flags from a serving_host_memory_verdict that is ServingMemoryFits, and the router's placement reads engine_warm_sessions." as NonEmptyStr
)

// Shared hosts: srv1, srv3 and srv4 serve beside CI runners and dashboard sessions, so their serving engines
// belong as claims in gunbc.fleet.fleet_host_budget, which already partitions those hosts' RAM.
data serving_shared_host_frontier: DissolutionCondition = unbound_dissolution(
  description: "Delete this frontier when srv1_vllm_engine_memory, srv3_strata_engine_memory and srv4_serving_engine_memory are charged as claims in gunbc.fleet.fleet_host_budget's per-host tree." as NonEmptyStr
)

// The cold tier: parked sessions moved to disk deliberately (vLLM's LMCache L2 already does this on srv1;
// Strata does not persist snapshots across restarts, docs/DETAILS.md). Not swap.
data serving_cold_session_tier_frontier: DissolutionCondition = unbound_dissolution(
  description: "Delete this frontier when a serving engine's disk tier for parked sessions is modeled here as its own budget beside the RAM tree, sized against the disk it lives on." as NonEmptyStr
)

// THE H11SSL-i UNIT 3 STRATA ENGINE (host-e2d4b7). One engine spans all three T10 cards on :18081; its
// resident ceiling is the figure that binds the host's CI seat, charged in
// gunbc.serving.serving_reservation, the way butch's two replicas are.
//
// THE CEILING WAS CUT IN HALF ON THE OPERATOR'S RULING, AND THIS ROW CARRIES BOTH SIDES OF THAT. The
// 2026-11-18T21:21Z read found MemoryMax 112 GiB (120259084288 B); the 2026-11-19T22:18:37Z re-read, taken
// after the operator trimmed the serving side and signed the number (gunbc.design_ruling
// ::ken_strata_memory_trim_buys_two_build_seats_2026_11_19, the operator's words: yeah thats fine w/ me thanks),
// finds 56 GiB (60129542144 B) in the unit file at ken-strata.service line 13, with the cgroup memory.max
// agreeing and MainPID still 162073 -- so the change landed WITHOUT a restart, exactly as butch's cap did on
// 2026-11-12. The withdrawn 112 GiB is named here rather than repainted, the way srv4's row names the figures
// its drop-in replaced: the whole point of the trim is that a reader can see what room was given back and where
// it went (gunbc.design_argument::replacement_migration).
//
// WHAT THE TRIM TOOK FROM THE SERVING SIDE IS THE OPERATOR'S REPORT, NOT A FLEET READ, and it is labelled that
// way in the ruling row: 12 GiB of parked-session cache in 6 slots, parallel 4, about 25 GB non-reclaimable, and
// a full-speed need around 53 GB (about 25 GB engine plus about 28 GiB of model page cache), below which prompt
// prefill degrades on an unmeasured curve. The cache budget and the slot count in THIS row are different: those
// two I read myself out of ~/strata-pool/cfg-ken.json at 2026-11-19T22:19:59Z, so they are ServingMemoryRead.
// The base is still unread for the reason it was unread before -- every memory.current I have taken was under live
// load with sessions parked -- and the soft ceiling is now READ, with the answer being that none is set.
data ken_strata_engine_memory: ServingEngineMemory = ServingEngineMemory {
  name: "ken-strata" as NonEmptyStr,
  // READ, AND THE READ SAYS NO SOFT CEILING EXISTS. MemoryHigh=infinity is not an unread figure: the read was
  // taken and its answer is that nothing reclaims before the hard ceiling. The arm carries no byte count because
  // there is no soft bound to convert, not because nobody looked (butch carries the same reading: a 2026-11-12
  // ssh found MemoryMax=infinity on both replicas, no ceiling to charge).
  memory_cap: ServingMemoryUnread { reason: "ken-strata soft ceiling (MemoryHigh): READ 2026-11-19T22:18:37Z over read-only ssh (ubuntu@192.168.1.236) systemctl show ken-strata.service -p MemoryHigh -> MemoryHigh=infinity, and the service cgroup reads memory.high = max. The unit sets NO soft ceiling, so the hard MemoryMax below is the only bound this engine gets and the kernel reclaims nothing before it. No byte count is reported because there is no soft bound to report; the earlier 2026-11-18T21:21Z note that the soft bound was unset-OR-UNOBSERVED is settled by this read: it is unset." as NonEmptyStr },
  memory_max: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 56)), provenance: "ken-strata.service MemoryMax = 56G. Read by this session over read-only ssh (ubuntu@192.168.1.236) 2026-11-19T22:18:37Z: systemctl show ken-strata.service -p MemoryMax -> MemoryMax=60129542144; the service cgroup reads memory.max = 60129542144; grep of /etc/systemd/system/ken-strata.service puts MemoryMax=56G at line 13, and the operator reports the line is in the unit file so it survives a reboot. MainPID is still 162073 and MemoryCurrent 23613460480, so no restart accompanied it -- the operator applied it live, the way butch's 2026-11-12 cap was applied. The operator's backups: /etc/systemd/system/ken-strata.service.bak-before-memmax-56g-20261119T174210Z (listed on the host, 760 B) and ~/strata-pool/cfg-ken.json.bak-before-mem-trim-20261119T171122Z. WHAT THIS WITHDREW: MemoryMax 112 GiB = 120259084288 B, read at the same address 2026-11-18T21:21Z. gunbc.serving.serving_reservation::host_memory_reserved charges THIS ceiling against the host's CI seat, deriving it from this field rather than restating it (review 93375)." as NonEmptyStr },
  swap_cap: ServingMemoryRead { bytes: gibibyte_to_byte_size(g: gibibyte(count: 2)), provenance: "ken-strata.service MemorySwapMax = 2G. Read 2026-11-19T22:18:37Z over read-only ssh: systemctl show ken-strata.service -p MemorySwapMax -> MemorySwapMax=2147483648; the cgroup reads memory.swap.max = 2147483648; the unit file carries MemorySwapMax=2G at line 14. The host's only swap device reads 8 GiB (swapon: /swap.img 8G), so the guard fits inside it. This was Unread on 2026-11-18T21:21Z; the read obligation named there is now discharged. It stays an overrun guard and nowhere sessions park (the operator's rule, gunbc.design_argument at the head of this module)." as NonEmptyStr },
  base: ServingMemoryUnread { reason: "ken-strata base (loaded-and-idle, nothing parked): no read taken under load gives it. The 2026-11-18T21:21Z memory.current 115788308480 was under load with sessions resident, and the 2026-11-19T22:18:37Z memory.current 23613460480 is a post-trim figure under load with 6 parked-session slots configured, so neither is base; read obligation: ken-strata.service memory.stat anon with the batch warmed and nothing retained" as NonEmptyStr },
  conversation_cache: ServingMemoryRead { bytes: mebibyte_to_byte_size(m: mebibyte(count: 12288)), provenance: "ken-strata parked-session cache budget: /home/ubuntu/strata-pool/cfg-ken.json /args carries --conversation-cache-mib 12288, read 2026-11-19T22:19:59Z over read-only ssh. The operator's report of the same trim (12 GiB of parked sessions) agrees with it; the cfg read is the referent, not the report. It was Unread on 2026-11-18T21:21Z, when only the cgroup ceilings had been read. Note what the operator did NOT change: max context stays 224k." as NonEmptyStr },
  // cfg-ken.json /args --conversation-cache-slots 6, read in the same 2026-11-19T22:19:59Z read as the cache
  // budget above (the field has no provenance carrier of its own, so the read is here: Nat? is the carrier for
  // the count). The operator's report of the trim says slots went 24 -> 6; the cfg is what this value rests on.
  conversation_slots: Present { value: 6 },
}

// ══════════════════════════════════════════════════════════════════════════════════════════════════
// THE ENGINE CONFIGURATION FILES AS THE HOSTS HOLD THEM (the 2026-11-24 / 25 host pass)
//
// The rows above are what the model believes each engine is configured with, read at various dates through
// ssh or from /metrics. The rows below are the FILES the engines actually start from, as the serving
// session's pass of 2026-11-24 / 25 found them: path, digest, when, with what instrument, and how each
// differs from the row above that answers the same question. They exist because three of the day's fixes
// were hand edits into these files, and a hand edit that is not recorded becomes a row that quietly stops
// describing the fleet -- which is how srv4's cap came to be read as 56 GiB while the engine ran under
// 96/112, and how two h11 engines served with their conversation cache off while the row above them said
// 8 GiB. Cite: gunbc.design_argument::epistemic_humility (a figure with no instrument behind it is not a
// figure), and the pass's own account of how each number was taken, which each row carries.
//
// No row here renders anything. Where the pass did not transcribe a file's bytes, the row says so and
// names the reading that would replace it; it does not reconstruct text from a digest, and a candidate
// render can only be verified once someone with a host principal supplies the bytes
// (gunbc.design_argument::fail_closed -- a render that cannot be checked against the host refuses).
// ══════════════════════════════════════════════════════════════════════════════════════════════════

// How a host's configuration file stands against the declaration that should answer for its figures.
// Three cases, deliberately not two: a file whose bytes were never transcribed cannot be said to render
// from anything, and an observation that blurred that into "diverges" would hide the read still owed.
type ServingHostConfigStanding
  = FieldsAgreeWithTheModelRow { model_row: NonEmptyStr }
  | DeclaredDivergenceFromTheModelRow {
      model_row: NonEmptyStr,
      diverging_fields: List<NonEmptyStr>,
      why: NonEmptyStr,
      owed_by: NonEmptyStr,
    }
  | BytesUnreadAgainstTheModelRow {
      model_row: NonEmptyStr,
      diverging_fields: List<NonEmptyStr>,
      why: NonEmptyStr,
      owed_by: NonEmptyStr,
      read_obligation: NonEmptyStr,
    }

// One configuration file on one serving host, as the pass read it.
type ServingHostConfigObservation {
  host: HostIdentity
  config_path: NonEmptyStr
  read_on_utc: NonEmptyStr
  instrument: NonEmptyStr
  sha256_computed_on_host: NonEmptyStr
  // What the file decides, in the file's own terms, and the figure the pass read out of it.
  what_it_holds: NonEmptyStr
  // The backup the pass found beside the file, when there was one: the hand edit's own receipt.
  backup: NonEmptyStr
  standing: ServingHostConfigStanding
}

// srv4's engine cgroup cap. This one the pass DID transcribe, and its bytes hash to the digest below;
// they are not reproduced here because a second copy of a systemd fragment in the repo is a second
// fragment (gunbc.design_argument::minimize_redundancy), and because the fields the model needs are the
// two cgroup limits, which the row carries against the reading that must replace it.
data srv4_engine_l1_cap_drop_in_observation_2026_11_24: ServingHostConfigObservation = ServingHostConfigObservation {
  host: operator_host_srv4,
  config_path: "/etc/systemd/system/gunbc-srv4-daily-engine.service.d/60-expert-l1-cap.conf" as NonEmptyStr,
  read_on_utc: "2026-11-24T22:03-22:05Z; applied live ~21:33 UTC the same day" as NonEmptyStr,
  instrument: "sha256sum over ssh on srv4; the two cgroup figures read from the file's [Service] lines, and the failure it was written against read from the engine's own log lines (\"skip parking (physical RAM admission ...)\")" as NonEmptyStr,
  sha256_computed_on_host: "eb2b16e57eea76f2dd534c0bbb7aa016024462ad580cfb3836a1e8fad8bf581b" as NonEmptyStr,
  what_it_holds: "MemoryHigh=96G and MemoryMax=112G on the daily engine's service -- srv3's numbers, up from the 56G/64G the 2026-11-09 repair left. The file's own comments date the raise and name the cause: the mmap-ed experts' page cache is charged to this cgroup, so at 64G the conversation cache had ~2-3 GB of room and refused to park every conversation, re-reading 75-95k-token prompts cold every turn; the slice above (gunbc-srv4-daily.slice) caps at 96G/120G." as NonEmptyStr,
  backup: "the 2026-11-09 drop-in it replaced is not listed as kept; the engine config beside it is, as engine.json.bak-20261109-pre-mmap (named in srv4_serving_engine_memory's provenance)" as NonEmptyStr,
  // The divergence this pass filed is CLOSED: the model row now carries the operator's figures,
  // derived from the terms that share the cgroup rather than hand-set -- the debt this row's
  // owed_by named has been paid by the srv4 memory-budget class (gunbc.serving.serving_layout::
  // serving_cgroup_terms refuses a cap whose terms do not fit), and srv4's runner seat is charged
  // from srv4_serving_engine_memory.memory_max itself, not restated (gunbc.serving.serving_reservation).
  standing: FieldsAgreeWithTheModelRow {
    model_row: "srv4_serving_engine_memory (memory_cap 96 GiB / memory_max 112 GiB -- the operator's 2026-11-24 raise, the figure this pass read on the host; the ceiling derived from its terms)" as NonEmptyStr,
  },
}

// srv3's engine launch configuration. The pass read the digest and the one line it changed; the file's text
// is not in anything the repo holds, so no render of this file can be verified from here -- which is why
// the row below is BytesUnread and not a divergence with a reconstructed body.
data srv3_engine_cfg_json_observation_2026_11_24: ServingHostConfigObservation = ServingHostConfigObservation {
  host: operator_host_srv3,
  config_path: "/home/ubuntu/strata-pool/cfg.json" as NonEmptyStr,
  read_on_utc: "2026-11-24T22:03-22:05Z; the line was changed earlier the same day and the engine restarted 19:56:36 UTC, after which the host also rebooted at ~21:57 UTC when the surge strip tripped a second time" as NonEmptyStr,
  instrument: "sha256sum over ssh on srv3, and the file read as text in the same pass for the one key it records" as NonEmptyStr,
  sha256_computed_on_host: "daf4b85aba56f797136ca655a036c4ec259d9fcebf1a77a7c2f0fe5f6097ab31" as NonEmptyStr,
  what_it_holds: "\"parallel\": 2, where this module's profile carries 8 -- strata_srv3_layer_split_profile.active_slots, THE ONE BATCH INPUT from which srv3's fixed RAM, its retention and its router admission all derive. It is also the file that carries --mmap-experts (added 2026-11-09, gunbc.design_ruling::srv3_experts_mmap_under_service_cap)." as NonEmptyStr,
  backup: "cfg.json.bak-before-parallel2-20261124T195635Z, kept beside the file on srv3" as NonEmptyStr,
  standing: BytesUnreadAgainstTheModelRow {
    model_row: "strata_srv3_layer_split_profile.active_slots (8, read over ssh 2026-11-08)" as NonEmptyStr,
    diverging_fields: ["parallel" as NonEmptyStr],
    why: "The operator lowered the engine's parallelism from 8 to 2 on 2026-11-24. The measurement behind it: on these cards MoE concurrency buys little in aggregate -- srv3's own engine log put one turn at 100-125k at ~30 tok/s while windows with two groups in flight ran ~26 tok/s in aggregate (the medians behind srv3's anchor, 3,657 windows, 2026-11-08) -- so eight configured slots pay active-slot RAM for less work than fewer would. The model row still says 8, because active_slots is not a tuning knob here: it is the single input the anchor's grant, the retention rung and the router's cap are derived from, and setting it by hand in a file no row renders leaves those derivations describing a machine nobody runs. The relationship -- engine parallelism and the router's per-upstream cap are two numbers for one fact -- is the concurrency-authority class, whose PR is open (zesty-pike-406, gunbc#17060) with this recording as its named follow-up." as NonEmptyStr,
    owed_by: "the engine-concurrency class (B3), which must make active_slots derived rather than hand-typed, and whose follow-up needs the file's bytes to verify a render" as NonEmptyStr,
    read_obligation: "Read /home/ubuntu/strata-pool/cfg.json on srv3 in full over a host principal, transcribe it, and hash the transcription against daf4b85aba56f797136ca655a036c4ec259d9fcebf1a77a7c2f0fe5f6097ab31. The named consumer of that transcription is the srv3 strata-pool engine-cfg renderer the concurrency class owes: zesty-pike-406's follow-up to gunbc#17060, whose trigger is the row gunbc.recurring_failure_mode::engine_slots_written_beside_the_admission_that_bounds_them (named there once that PR lands) -- that renderer accepts a candidate render only when its bytes hash to this digest, and refuses until the text exists. Until that hash succeeds, no candidate render of this file may be said to match the host, whatever it contains." as NonEmptyStr,
  },
}

// h11's two live engine launch configurations. THE FINDING IS NOT THE SLOT COUNT. Both files reached
// 2026-11-24 with NO conversation-cache argument at all, so those engines served with the cache at its
// default of zero -- off -- while the row above them (host_6ce85c_engine_as_launched) reported 8192 MiB
// read from a third engine's file. The pass appended the arguments; the fail-open default that let an
// engine serve for weeks with the cache silently disabled is the defect, and it belongs to the
// conversation-cache class (B1), not to this record.
data h11_engine_cfg_83_observation_2026_11_24: ServingHostConfigObservation = ServingHostConfigObservation {
  host: operator_host_6ce85c,
  config_path: "/home/ubuntu/strata-pool/cfg-83.json" as NonEmptyStr,
  read_on_utc: "2026-11-24T22:03-22:05Z; h11-strata@83 was restarted at 21:35 UTC to pick the appended arguments up, and the host then went down in the ~21:57 UTC strip trip and came back with both engines starting on their own" as NonEmptyStr,
  instrument: "sha256sum over ssh on h11-a16; the two arguments read from the file's argv list in the same pass" as NonEmptyStr,
  sha256_computed_on_host: "4a2345f803863c0a4f5af57973383382b4dc48dc1253c3302d1980c766dfa806" as NonEmptyStr,
  what_it_holds: "--conversation-cache-mib 8192 and --conversation-cache-slots 4, both appended by the 2026-11-24 pass. Before that the file carried neither, so this engine ran with the cache at its 0 default while the model's h11 engine row reported an 8 GiB cache for the fleet's buses." as NonEmptyStr,
  backup: "unnamed in the pass; the file's own history is the append" as NonEmptyStr,
  standing: BytesUnreadAgainstTheModelRow {
    model_row: "host_6ce85c_engine_as_launched (conversation_cache 8192 MiB from cfg-87.json, conversation_slots 6)" as NonEmptyStr,
    diverging_fields: ["conversation-cache-slots" as NonEmptyStr, "which engines the row describes" as NonEmptyStr],
    why: "Two divergences, one direction each way. The slot count: the host runs 4, the row says 6 -- and the row's provenance is one engine's file (cfg-87.json, the value convcache-8g.sh set on every bus 2026-10-27) generalised to a template every bus shares, which these two files show it is not. The cache itself: the model row read as though every h11 engine parked conversations in 8 GiB; two of them had the feature at its default of off, and nothing in the model could tell that, because ServingMemoryRead has no arm for \"the argument is absent, so the engine's own default applies\". What the right figure IS -- whether slots follow the card, the context cap or the RAM the engine may hold -- is the conversation-cache class (B1)." as NonEmptyStr,
    owed_by: "the conversation-cache class (B1), which owns the fail-open default: an engine that serves with its cache disabled must not be representable as a row that reports a cache" as NonEmptyStr,
    read_obligation: "Read both live cfg files in full over a host principal and hash them against 4a2345f803863c0a4f5af57973383382b4dc48dc1253c3302d1980c766dfa806 and 38eb8256e7adf87c6f25a9ed105b7e4802a1c351f2a7985f1cc0131d410b7438; and read /metrics on each h11 engine for conversation_cache_mib rather than trusting an argument list for what the engine actually allocated." as NonEmptyStr,
  },
}

// The second live h11 engine, same pass, same two arguments. Its own row rather than a note on the first:
// two engines, two files, two digests, and the finding is exactly that the files differ from each other
// and from what the shared row asserts.
data h11_engine_cfg_c3_observation_2026_11_24: ServingHostConfigObservation = ServingHostConfigObservation {
  host: operator_host_6ce85c,
  config_path: "/home/ubuntu/strata-pool/cfg-c3.json" as NonEmptyStr,
  read_on_utc: "2026-11-24T22:03-22:05Z; h11-strata@c3 restarted 21:39 UTC" as NonEmptyStr,
  instrument: "sha256sum over ssh on h11-a16; the two arguments read from the file's argv list in the same pass" as NonEmptyStr,
  sha256_computed_on_host: "38eb8256e7adf87c6f25a9ed105b7e4802a1c351f2a7985f1cc0131d410b7438" as NonEmptyStr,
  what_it_holds: "The same two arguments appended to the same file shape: --conversation-cache-mib 8192, --conversation-cache-slots 4, neither present before the 2026-11-24 pass." as NonEmptyStr,
  backup: "unnamed in the pass; the file's own history is the append" as NonEmptyStr,
  standing: BytesUnreadAgainstTheModelRow {
    model_row: "host_6ce85c_engine_as_launched (conversation_cache 8192 MiB, conversation_slots 6)" as NonEmptyStr,
    diverging_fields: ["conversation-cache-slots" as NonEmptyStr, "which engines the row describes" as NonEmptyStr],
    why: "As cfg-83.json: 4 slots against the row's 6, and the cache argument absent until the pass wrote it. Read together, the two rows are the evidence that host_6ce85c_engine_as_launched is a template inferred from one bus, not a render of the fleet's h11 launch -- which is the same finding the router's live rows make from the other side (gunbc.serving.router_dev_policy::srv1_router_live_rows_2026_11_25 lists h11-03 and h11-83 as rows no naming row produces)." as NonEmptyStr,
    owed_by: "the conversation-cache class (B1), and the h11 naming/layout drift the router rows record" as NonEmptyStr,
    read_obligation: "Read /home/ubuntu/strata-pool/cfg-c3.json on h11 in full over a host principal, transcribe it, and hash the transcription against 38eb8256e7adf87c6f25a9ed105b7e4802a1c351f2a7985f1cc0131d410b7438 (cfg-83.json carries its own digest, 4a2345f803863c0a4f5af57973383382b4dc48dc1253c3302d1980c766dfa806, and is owed the same treatment). Then read each engine's own /metrics rather than its argv, since the argument list is what was edited and /metrics is what the engine actually allocated." as NonEmptyStr,
  },
}

// The pass's host-config record as one population, so a reader can ask what is unaccounted for.
data serving_host_config_observations_of_the_2026_11_24_pass: List<ServingHostConfigObservation> = [
  srv4_engine_l1_cap_drop_in_observation_2026_11_24,
  srv3_engine_cfg_json_observation_2026_11_24,
  h11_engine_cfg_83_observation_2026_11_24,
  h11_engine_cfg_c3_observation_2026_11_24,
]

// Every observation names the declaration it departs from, states which fields depart, gives a reason, and
// names who owes the model change. An observation without a reason is the thing this population exists to
// prevent: a hand edit recorded as a fact.
fn every_serving_host_config_observation_is_accounted_for() -> Bool {
  fold(serving_host_config_observations_of_the_2026_11_24_pass, init: true, f: (ok, o) =>
    ok && (o.sha256_computed_on_host as String) != "" && (o.instrument as String) != "" && match o.standing {
      FieldsAgreeWithTheModelRow { model_row: m } => (m as String) != ""
      DeclaredDivergenceFromTheModelRow { model_row: m, diverging_fields: f, why: w, owed_by: b } =>
        (m as String) != "" && f.length() > 0 && (w as String) != "" && (b as String) != ""
      BytesUnreadAgainstTheModelRow { model_row: m, diverging_fields: f, why: w, owed_by: b, read_obligation: r } =>
        (m as String) != "" && f.length() > 0 && (w as String) != "" && (b as String) != "" && (r as String) != ""
    })
}

// Which of these files still owe their bytes -- the list a renderer must refuse to guess about.
fn serving_host_config_observations_with_unread_bytes() -> List<ServingHostConfigObservation> {
  serving_host_config_observations_of_the_2026_11_24_pass.filter(o => match o.standing {
    BytesUnreadAgainstTheModelRow { model_row: _, diverging_fields: _, why: _, owed_by: _, read_obligation: _ } => true
    _ => false
  })
}
