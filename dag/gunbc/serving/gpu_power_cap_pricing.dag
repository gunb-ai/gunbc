module gunbc.serving.gpu_power_cap_pricing

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.nat { Nat, nat_to_decimal_string }
import std.optional { Optional, Present, Absent, optional_is_absent }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_display_key, declaration_ref_eq }
import std.integer { nat_to_int }
import std.measure {
  Permille, permille,
  Watt, watt, watt_count, Milliwatt, milliwatt, milliwatt_count,
  MilliTokensPerSecond, milli_tokens_per_second, milli_tokens_per_second_count, Hertz, hertz,
}
import std.interval { IntervalReady, IntervalRefused, OrderedClosedInterval, closed_interval, interval_high, interval_low }
import std.pareto {
  AxisComparison, AxisGap, AxisReading, HigherIsBetter, LowerIsBetter, ParetoEntry, ReadingAbsent,
  ReadingDuplicated, ReadingFound, SelectionAxis, UndecidedOnEvidence, axis_comparison_interval, reading_for,
}
import std.decision {
  CausalModelUnestablished, ChoiceDomain, ContextParameter, DecisionAssessment, DecisionConstraint,
  DecisionRegion, DecisionSubject, DecisionVariable, HardConstraint, NonMoneyConstraint,
  ObjectiveMeasure, ObjectiveTerm, PhysicalModelUnestablished, RealizationSelectionResult,
  SelectionPolicy, UnfundedAxis, UniqueSurvivorRequired, select_realization,
}
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }
import product.host_identity { HostIdentity, host_identity_eq }
import gunbc.fleet.fleet_host_identity { operator_host_srv3, operator_host_srv4 }
import gunbc.fleet.fleet_power_circuit {
  SharedPowerCircuit, BoundStated, BoundUnstated, MemberDrawBound, RatingUnread, circuit_carries, circuit_carry_limit,
  circuit_label, circuit_member_draw_bound, circuit_rating_read_obligation, surge_strip,
}
import gunbc.serving.gpu_power_state_policy {
  GpuPowerCapSelection, OperatorDeclaredCap, SustainedPowerDraw, gpu_power_cap_selected,
}

// A POWER-CAP VALUE, PRICED: the decode it costs, against the circuit it was asked to protect.
//
// THE DEFECT THIS EXISTS TO CLOSE, stated as a chain. The authority that should produce a GPU power cap is
// the operator's ruling or a selection over measured candidates; today it is only the ruling
// (gunbc.serving.gpu_power_state_policy GpuPowerCapSelection, whose ONE arm is OperatorDeclaredCap, whose own
// header says the std.decision arm "does not exist" because the power sweep that would feed it never landed).
// The value then travels: admission joins it with the device's own reported [min, max]
// (admit_gpu_cap_against), the converge writes it and reads it back (gunbc.fleet.gpu_power_cap_converge), a
// boot unit keeps it across a reboot (gunbc.fleet.gpu_power_cap_boot_state). Re-derived from the authority,
// the EARLIEST BOUNDARY WHOSE DERIVATION CANNOT BE JUSTIFIED is the first one: a cap enters the model as a
// bare Watt plus who said it, and the only gate it ever passes asks whether the driver accepts the number.
// 30 W on an RTX 2000 Ada passes that gate forever, because 30 W is the floor of the device's own range
// (gunbc.fleet.gpu_device_observation, power_limit_minimum 30 W on both of srv4's cards). Nothing in the
// chain is charged with the cap's consequence, and nothing carried the circuit the watts were for
// (gunbc.fleet.fleet_power_circuit is that carrier, and it is new). So the same gate returned the same
// verdict for both of 2026-11-24's opposite decisions: 40 W -> 30 W, back to 40 W ("not worth 10 W per
// card"), and back to 30 W after the strip feeding h11 + srv3 + srv4 opened a second time.
//
// WHY THE REPAIR SITS AT THAT BOUNDARY AND NOT AT THE BOOT ROWS. The rows and the converge did their jobs:
// they applied, wrote and read back what they were handed, and they refuse a value the device rejects.
// Adding a check further down -- "warn when a cap is low" -- would be a lint over a decision nobody priced,
// and a lint is the rung below what is available here (#gunbc.design_argument::guarantee_ladder). What is
// missing is the link between the ask and the consequence, so this module IS that link: a cap candidate
// cannot be put forward as the answer to a power ask without naming the circuit the ask serves, and its
// consequence is a reading with an instrument and a standing, never a number.
//
// WHY THERE IS NO SEALED FACT HERE, unlike gunbc.serving.home_serving_power_policy. That module mints a
// funded admission a foreign module could otherwise forge, so it seals the record and rosters one mint.
// This module mints no funded fact: it returns a verdict, and the verdict's arms ARE the wall. The bad state
// -- a cap reported as the priced answer to a power ask while its consequence and its circuit are absent --
// has no carrier here to forge: `DecodeUnread` and `DrawUnread` have no field for a rate, `AskUnstated` has
// no circuit to be forgotten, and `SelectionNeedsEvidence` is reached by construction whenever a funded axis
// has no reading (std.pareto's scan_feasibility, through std.decision's select_realization). The ceiling and
// its limit are stated on the recurring_failure_mode row rather than claimed past what is built here.
//
// THREE CONTROLS RIDE THE SAME CANDIDATE, AND THAT IS THE ANSWER TO "IS IT THE SAME KIND OF CHOICE". A
// candidate here is an OPERATING POINT -- the set of controls this machine is set to (GPU power limit, CPU
// frequency cap, GPU SM clock ceiling) -- not a GPU watt. The third of them is not a refinement of the first:
// a power cap sets a ceiling on draw and the card then finds its own clock under it, which is exactly the
// boost-then-throttle behaviour the 2026-11-24 sweep was run to escape, and the sweep's own numbers show a
// clock ceiling buying watts at near-equal decode (at srv4's 30 W: 869 MHz avg at 29.1 W unlocked against
// 906 MHz avg at 27.0 W under a 1500 MHz ceiling). What conditions a reading is the CARD's state: ken's two
// cool T10s dropped 92-96 W -> 68-80 W at a 1000 MHz ceiling while GPU1, at 82 C, drew 83 W at EVERY level,
// so the same control has a different price on a leaky card -- and on a 3-way layer split that card sets the
// pace for all three. `CardCondition` carries it, and `priced_step` refuses to compare candidates whose cards
// are known to be in different states or that sit on different hosts. `CpuFrequencySetting` is a second actuator on the same candidate, priced on the same two axes,
// because the 2026-11-24 windows separate the two causes exactly: srv4 read 39.0 tok/s at 40 W / 3.0 GHz,
// 26.5 at 30 W / 2.0 GHz, and 24.1 at 30 W / 3.0 GHz. Holding the GPU cap at 30 W and RELEASED the CPU cap
// made decode WORSE, not better, so the CPU cap is not what cost the throughput; the GPU cap is. A model
// whose candidate were "the GPU watt value" could not state that fact at all, and the operator would be left
// to discover it by flipping two controls a day apart. What this module does NOT carry is the CPU cap's
// REALIZATION: no modeled converge writes scaling_max_freq (gunbc.fleet.gpu_power_cap_converge drives
// nvidia-smi only), and gunbc.plans.host_thermal_operating_point row T3 names ReadCpuOperatingLimits
// (scaling_max_freq and governor per core) as a fixed diagnostic that does not exist. Pricing a control and
// realizing it are different obligations; the second is named as the modeling obligation, not absorbed here.
//
// WHAT THIS IS NOT. It is not product.fleet_operating_point, which is the same SHAPE (throughput against AC
// power, std.pareto + std.decision) over a different SUBJECT -- the Mt. Collins deployment's socket-power and
// chassis policy against its site power limit, with its own DecisionSubject identity and its own unevidenced
// rows. Minting a second decision algebra would be the fork this repo refuses; minting a second SUBJECT for a
// different deployment over the same spine is what std.decision's DecisionScope discriminators are for. It is
// not product.rack_power (a cited PDU feed with catalog rows; gunbc.fleet.fleet_power_circuit says why the
// home circuits are not that). It is not gunbc.serving.home_serving_power_policy, which asks whether an
// applied limit exceeds a part's rated ceiling -- a different question, answered there, never re-answered
// here. And it is not the fleet's cap INTENT: the durable per-board cap rows belong to
// gunbc.serving.gpu_power_state_policy and gunbc.fleet.gpu_power_cap_boot_state, which this change does not
// touch. The rows below are the candidates the 2026-11-24 ask put forward, carried here because a priced
// field needs them; the frontier names the day this field reads the policy's own rows instead.

// ── THE AXES, MINTED HERE ──────────────────────────────────────────────────────────────────────────
//
// MINTED, not declared, per std.decision's rule that a decision's identities come from the decision module
// itself (the shape gunbc.serving.serving_replica_choice uses).
//
// THE SCALE IS MICRO OF THE NAMED UNIT on both axes, because std.pareto's readings and std.decision's
// constraint bounds are Int in micro units. Decode: micro-tokens per second, so a figure quoted to a tenth
// of a tok/s (24.1) is carried exactly as 24100000 with no rounding. Draw: microwatts.
data ax_decode_tokens_per_second: DeclarationRef = decl_ref(
  module_path: "gunbc.serving.gpu_power_cap_pricing",
  decl_name: "ax_decode_tokens_per_second",
)
data ax_host_draw_watts: DeclarationRef = decl_ref(
  module_path: "gunbc.serving.gpu_power_cap_pricing",
  decl_name: "ax_host_draw_watts",
)
data ax_gpu_draw_watts: DeclarationRef = decl_ref(
  module_path: "gunbc.serving.gpu_power_cap_pricing",
  decl_name: "ax_gpu_draw_watts",
)

// THE TWO DRAW AXES ARE NOT INTERCHANGEABLE, and this is the distinction the 2026-11-24 decision was priced
// without. `ax_gpu_draw_watts` is what an `nvidia-smi power.draw` sample set measures: ONE SUBSYSTEM of the
// machine -- the card. `ax_host_draw_watts` is the draw of the WHOLE host at its feed, which is the quantity a
// shared circuit's per-member limit is stated against, and the only axis a circuit's HardConstraint may sit
// on. Putting the card's number on the circuit's axis would price 2 W saved on the GPU as 2 W saved on the
// strip, on a feed that also carries the CPU, the board and the disks -- and the same day's own readings show
// the two moving apart (srv4's hwmon apm_xgene CPU reading went 101 W to ~40 W when the CPU was capped, while
// the GPU cap moved only the card). So the host axis enters the comparison ONLY when some candidate carries a reading
// taken at the host level, and against a stated circuit bound the fold REFUSES outright when no candidate
// does -- rather than borrowing the card's number for the machine (#gunbc.design_argument::fail_closed, no substitute;
// #gunbc.design_argument::grounding_is_intersubjective, no scale without an instrument).

// The full census of axes a candidate must ANSWER for -- as a reading or as a named gap. The fold passes
// `funded_axes_for`, which puts an axis in front of std.decision only where SOME candidate in the field carries
// a reading on it: an axis nobody has read cannot be used to rank, and (for the host axis, against a stated
// bound) must not be used at all -- the fold refuses there with the read obligation, rather than std.decision
// returning an opaque "axis not funded" defect for want of a scale.
fn funded_axes() -> List<SelectionAxis> {
  [
    SelectionAxis { identity: ax_decode_tokens_per_second, goal: HigherIsBetter },
    SelectionAxis { identity: ax_gpu_draw_watts, goal: LowerIsBetter },
    SelectionAxis { identity: ax_host_draw_watts, goal: LowerIsBetter },
  ]
}

fn gpu_axis_is_read(field: List<CapCandidate>) -> Bool {
  any(field, c => any(draw_readings_of(c: c), r => same_axis(a: r.axis, b: ax_gpu_draw_watts)))
}

fn host_axis_is_read(field: List<CapCandidate>) -> Bool {
  any(field, c => any(draw_readings_of(c: c), r => same_axis(a: r.axis, b: ax_host_draw_watts)))
}

fn same_axis(a: DeclarationRef, b: DeclarationRef) -> Bool {
  declaration_ref_eq(a: a, b: b)
}

fn funded_axes_for(field: List<CapCandidate>) -> List<SelectionAxis> {
  let with_decode = [SelectionAxis { identity: ax_decode_tokens_per_second, goal: HigherIsBetter }]
  let with_gpu = if gpu_axis_is_read(field: field) {
    concat(with_decode, [SelectionAxis { identity: ax_gpu_draw_watts, goal: LowerIsBetter }])
  } else {
    with_decode
  }
  if host_axis_is_read(field: field) {
    concat(with_gpu, [SelectionAxis { identity: ax_host_draw_watts, goal: LowerIsBetter }])
  } else {
    with_gpu
  }
}

// Is the circuit's per-member draw bound stated? The fold consults this before applying any bound: a stated
// bound with no host-level reading in the field is the 2026-11-24 case, and the answer is the reading that
// is missing, never a verdict computed from the card's numbers.
fn circuit_bound_is_stated(circuit: SharedPowerCircuit) -> Bool {
  match circuit_member_draw_bound(c: circuit) {
    BoundStated { draw_limit: _, standing: _ } => true
    BoundUnstated { read_obligation: _ } => false
  }
}

// The refusal the fold returns in exactly that case: the bound stands, the only watts on offer are a
// subsystem's, and no arithmetic gets to pretend otherwise. The cause quotes the read obligation verbatim.
fn host_bound_evidence_gap(circuit: SharedPowerCircuit) -> AxisGap {
  AxisGap {
    axis: ax_host_draw_watts,
    cause: concat(
      concat(
        concat("the bound on ", circuit_label(c: circuit)),
        " cannot be applied to any candidate: no reading in the field was taken at a machine's feed. " as NonEmptyStr
      ) as NonEmptyStr,
      host_draw_read_obligation
    ) as NonEmptyStr,
  }
}

// WHY NOT product.fabric.serving_throughput. Its reading is a TokensPerSecond, whose count is a Nat of WHOLE
// tokens per second. Every 2026-11-24 window is quoted to a tenth (39.0, 26.5, 24.1, 28.5-34), and rounding a
// measured figure to fit a carrier is the distortion #gunbc.design_argument::epistemic_humility exists to
// stop: 24.1 and 26.5 would arrive as "24" and "27", and the comparison that separates the two causes would
// be arithmetic on a rounding artifact. MilliTokensPerSecond is the same Frequency axis at Milli
// (std.measure), so the figure arrives exactly; the axis reading is then micro, which is that count times
// 1000 -- exact, and not a new scale.
type DecodeReading
  = DecodeRead {
      rate_low: MilliTokensPerSecond,
      rate_high: MilliTokensPerSecond,
      at_concurrency: Nat,
      window: NonEmptyStr,
      instrument: NonEmptyStr,
      standing: CitedFigureStanding
    }
  | DecodeUnread { read_obligation: NonEmptyStr }

// WHY A WIDTH AND NOT A POINT. The 40 W afternoon window was reported as 28.5-34 tok/s across the
// conversations in it. std.pareto's reading IS the region the evidence supports ("a sharp measurement is
// degenerate_interval(x) and carries the claim that the true value IS x"), so a window that spans a range is
// carried with its width and any dominance over it stays UndecidedOnEvidence rather than being averaged away.
// A point reading is the degenerate case, spelled by the same carrier.

// THE COST SIDE OF THE TRADE, AND WHAT QUALIFIES AS ONE. A power CAP is a bound on sustained draw and never a
// measurement of it (gunbc.serving.gpu_power_state_policy's CappedPowerQuantity note is explicit, and on
// host-6ce85c 43 of 224 two-second samples read ABOVE the 210 W cap), so a cap value may never stand in for a
// draw here. A `DrawRead` is a sample set: `samples` says how many one-second readings the average came from,
// which is what separates the sweep's 150-sample levels from the single hwmon apm_xgene readings the operator
// themselves qualified ("the load also changed between readings, so the true saving is somewhat smaller").
// `throttle_share` carries the share of the window the card sat power-capped -- the observable that tells a
// ceiling doing work from a card that is leakage-bound, which makes it a MEASURED FRACTION, not commentary:
// it is carried in Permille (a tenth-of-a-percent resolution, so ken's "1%" and the sweep's whole-percent
// figures live on one carrier) and `priced_draw_step` refuses to price the watt step between two levels
// unless both sides' shares are read. A number nobody reads would be the dangling declaration this repo's
// Consumption argument refuses; this one changes the answer. `DrawUnread` is still srv3's state for every
// candidate, and srv4's for the single-stream windows: only the two 2026-11-24 sweeps averaged draw, at their
// own levels.
// WHAT THE INSTRUMENT WAS ACTUALLY ON. `GpuSubsystem` is an nvidia-smi power.draw reading off one card: a
// fact about the card, not about the machine's load on a circuit. `HostLevel` is a reading taken at the
// machine's feed -- a wattmeter on the member's lead, or a per-host PDU/UPS outlet -- and it is the only thing
// that can fund the circuit's axis. The arm sits on the READING, not inferred from the instrument's name,
// because the name of the tool is not evidence of what it was clamped around.
type DrawSubject
  = GpuSubsystem { gpu: NonEmptyStr, instrument: NonEmptyStr }
  | HostLevel { instrument: NonEmptyStr, covers: NonEmptyStr }

// THE SHARE OF THE WINDOW SPENT POWER-CAPPED, from clocks_throttle_reasons sampled with the watts. A card
// pinned at its cap and a card freewheeling can print the same average watts; only the throttle share says
// which was read, and the ceiling decision turns on it (see `priced_draw_step`).
type ThrottleShare
  = ShareRead { power_capped: Permille, instrument: NonEmptyStr }
  | ShareUnread { read_obligation: NonEmptyStr }

type DrawReading
  = DrawRead {
      draw_low: Milliwatt,
      draw_high: Milliwatt,
      samples: Nat,
      subject: DrawSubject,
      throttle_share: ThrottleShare,
      observed_on: NonEmptyStr,
      standing: CitedFigureStanding
    }
  | DrawUnread { read_obligation: NonEmptyStr }

// THE SECOND ACTUATOR. `Uncapped` is not `Unread`: it says the machine ran at its own maximum with no cap
// applied, which is what the 3.0 GHz windows were. `SettingUnread` is the honest arm for a host nobody has
// read scaling_max_freq on.
type CpuFrequencySetting
  = CappedAt { maximum: Hertz }
  | Uncapped
  | SettingUnread { read_obligation: NonEmptyStr }

// THE THIRD ACTUATOR, AND THE ONE THAT CHANGED THE ANSWER. A power cap sets a ceiling on draw and the card
// then finds its own clock under it; on 2026-11-24 that produced the boost-then-throttle behaviour the
// operator were trying to escape ("lower the cap but also lower the clock rate so it doesn't just boost ->
// throttle"), and locking the SM clock turned out to buy watts at near-equal decode: at srv4's 30 W cap the
// unlocked level averaged 869 MHz at 29.1 W, while a 1500 MHz ceiling averaged 906 MHz at 27.0 W. A model
// whose candidate were "the GPU watt value" could not have reported that, because the fact is about a PAIR of
// controls. `Unlocked` is not `Unread`: it says the card was left to boost to its own limit, which is a
// setting that was applied.
//
// WHY IT IS A CONTROL AND NOT AN AXIS. std.pareto scores candidates on axes and identifies them by their
// configuration; the ceiling is part of the configuration, and the axes stay the two that carry consequences
// (decode, draw). A third "MHz" axis would invite a comparison that maximises clock rate, which is not what
// anyone wants -- clock rate is a means, and the sweep's own decision was made on watts and clock together
// because decode per 150 s window was too noisy to decide on. That noise is carried below as the width.
type SmClockCeiling
  = CappedWithin { maximum: Hertz }
  | Unlocked
  | CeilingUnread { read_obligation: NonEmptyStr }

// THE STATE OF THE CARD THE READING CAME OFF. This is not a third axis and it is not decoration: it is what
// makes two readings comparable at all. ken's sweep showed why -- at a 100 W cap and a 1000 MHz ceiling the
// two cool T10s held ~990 MHz power-capped 1% of the time at 68-80 W, while GPU1 at 82 C drew 83 W at EVERY
// level including 600-800 MHz, i.e. it was power-bound by leakage rather than by the ceiling, and on a
// 3-way layer split that card is the pace-setter for all three. A fold that compared "the" ken candidate
// across a cool card and a leaky one would report a saving that the leaky card never made.
//
// So the condition is carried on the candidate and gates comparability (see `priced_step`): two candidates
// whose cards are not known to be in the same state do not have a priced step between them, and the answer
// is UndecidedOnEvidence rather than a plausible number. `ConditionUnread` is the honest arm for every card
// on srv3/srv4 today: nobody has read temps or per-level power there, which is precisely why srv4's ceiling
// was chosen from srv4's own sweep and ken's from ken's.
type CardThermalState
  = Cool
  | Hot
  | PowerBoundAtEveryClock

type CardCondition
  = ConditionRead {
      card: NonEmptyStr,
      state: CardThermalState,
      sensor: NonEmptyStr,
      observed_on: NonEmptyStr,
      standing: CitedFigureStanding
    }
  | ConditionUnread { read_obligation: NonEmptyStr }

// ONE CANDIDATE AS THE ASK SEES IT: the controls this machine is set to, and what each side of the trade was
// measured to be under those controls. The GPU cap arrives as the policy's OWN carrier
// (GpuPowerCapSelection), so a priced candidate and an actuated cap are the same decision object and cannot
// drift into two watt values for one card.
type CapCandidate {
  identity: DeclarationRef
  label: NonEmptyStr
  host: HostIdentity
  gpu_cap: GpuPowerCapSelection
  cpu_cap: CpuFrequencySetting
  sm_clock: SmClockCeiling
  condition: CardCondition
  decode: DecodeReading
  draw: DrawReading
}

// ── THE ASK ────────────────────────────────────────────────────────────────────────────────────────
//
// WHAT THE WATTS WERE BEING SAVED FOR. A cap is never asked for in the abstract, and the 2026-11-24 record
// shows what happens when the reason is not carried: the same 10 W per card was judged not worth paying and
// then paid, on the same day, with nothing in the model stating which constraint the second judgment served.
// `AskUnstated` is the arm for a cap somebody set with no ask recorded -- it is NOT a synonym for "there is
// no constraint", it is the honest statement that a constraint exists and nobody wrote it down, and it
// carries the words that were said.
type PowerAsk
  = CircuitRelief { circuit: SharedPowerCircuit, asked_on: NonEmptyStr }
  | AskUnstated { cap: Watt, said: NonEmptyStr }

// ── THE SUBJECT AND ITS UNREAD ASSESSMENT ──────────────────────────────────────────────────────────
//
// One subject per circuit, because the circuit is what makes this a different decision: the same two
// operating points weighed against the strip that opened twice and against the breaker that has not are two
// questions, and std.decision's DecisionScope carries the constraint authority as one of its discriminators.
data id_objective: DeclarationRef = decl_ref(module_path: "gunbc.serving.gpu_power_cap_pricing", decl_name: "cap_ask_objective")
data id_term: DeclarationRef = decl_ref(module_path: "gunbc.serving.gpu_power_cap_pricing", decl_name: "cap_ask_term")
data id_var: DeclarationRef = decl_ref(module_path: "gunbc.serving.gpu_power_cap_pricing", decl_name: "cap_ask_var")
data id_region: DeclarationRef = decl_ref(module_path: "gunbc.serving.gpu_power_cap_pricing", decl_name: "cap_ask_region")
data id_parameter: DeclarationRef = decl_ref(module_path: "gunbc.serving.gpu_power_cap_pricing", decl_name: "cap_ask_parameter")
data id_domain: DeclarationRef = decl_ref(module_path: "gunbc.serving.gpu_power_cap_pricing", decl_name: "cap_ask_domain")
data id_policy: DeclarationRef = decl_ref(module_path: "gunbc.serving.gpu_power_cap_pricing", decl_name: "cap_ask_policy")

fn cap_ask_subject_identity(circuit: SharedPowerCircuit) -> DeclarationRef {
  decl_ref(
    module_path: "gunbc.serving.gpu_power_cap_pricing",
    decl_name: concat("cap-ask-subject-", declaration_ref_display_key(ref: circuit.identity)) as String,
  )
}

fn cap_ask_field_identity(circuit: SharedPowerCircuit, field: List<CapCandidate>) -> DeclarationRef {
  decl_ref(
    module_path: "gunbc.serving.gpu_power_cap_pricing",
    decl_name: concat(concat("cap-ask-field-", declaration_ref_display_key(ref: circuit.identity)) as String,
      concat("-", candidate_roster_tag(field: field)) as String) as String,
  )
}

fn cap_ask_evidence_identity(circuit: SharedPowerCircuit) -> DeclarationRef {
  decl_ref(
    module_path: "gunbc.serving.gpu_power_cap_pricing",
    decl_name: concat("cap-ask-evidence-", declaration_ref_display_key(ref: circuit.identity)) as String,
  )
}

// A readable tag for one candidate roster, built from the candidates' own identities, so the DecisionScope of
// an ask can be recognised in review rather than being a hash nobody can read.
fn candidate_roster_tag(field: List<CapCandidate>) -> String {
  join(map(field, c => declaration_ref_display_key(ref: c.identity)), "+")
}

data cap_ask_variable: DecisionVariable = DecisionVariable { identity: id_var }
fn cap_ask_constraint(circuit: SharedPowerCircuit) -> DecisionConstraint = DecisionConstraint { identity: constraint_identity(circuit: circuit) }
data cap_ask_parameter: ContextParameter = ContextParameter { identity: id_parameter }
data cap_ask_region: DecisionRegion = DecisionRegion { identity: id_region }
data cap_ask_domain: ChoiceDomain = ChoiceDomain { identity: id_domain, variables: [cap_ask_variable] }
fn cap_ask_policy() -> SelectionPolicy { UniqueSurvivorRequired { identity: id_policy } }

// The question, over the ground its one objective term actually holds. One term: decode per unit of draw on
// the circuit the ask serves -- a gain to maximise. The per-axis readings below are what the comparison runs
// on, and a number the axes do not carry cannot enter the comparison through the subject.
fn cap_ask_subject(circuit: SharedPowerCircuit, term_ground: CitedFigureStanding) -> DecisionSubject {
  DecisionSubject {
    identity: cap_ask_subject_identity(circuit: circuit),
    question: concat(
      concat("which operating point of the hosts on ", circuit_label(c: circuit)),
      " gives this fleet the most decode per watt drawn on that circuit" as NonEmptyStr
    ) as NonEmptyStr,
    parameters: [cap_ask_parameter],
    constraints: [cap_ask_constraint(circuit: circuit)],
    objective: ObjectiveMeasure {
      identity: id_objective,
      goal: HigherIsBetter,
      terms: [ObjectiveTerm { identity: id_term, ground: term_ground }],
    },
    choice_domain: cap_ask_domain,
  }
}

// THE ONLY ASSESSMENT THIS MODULE ASSERTS (#gunbc.design_argument::epistemic_humility). No instrument has
// ever been put on either home circuit, and no per-window power.draw average exists on srv3 or srv4, so the
// physical and causal models of "what a cap does to draw, and what draw does to a circuit" are unestablished
// here and are stated as unread. A caller that HAS readings builds its own DecisionAssessment over
// cap_ask_subject with the ground it holds -- the witness supplies a fixture one at its boundary; nothing
// here promotes an unread claim to established.
fn cap_ask_unread_assessment(circuit: SharedPowerCircuit) -> DecisionAssessment {
  DecisionAssessment {
    subject: cap_ask_subject(
      circuit: circuit,
      term_ground: TranscribedUncited {
        read_obligation: "decode tok/s per operating point is a session's journal read, not an instrument, and the draw side has never been read at all" as NonEmptyStr,
      },
    ),
    sensitivities: [], constraints: [], parameters: [],
    selected_candidate: Absent, term_drops: [],
    physical_model: PhysicalModelUnestablished {
      subject: cap_ask_subject_identity(circuit: circuit),
      read_obligation: "how a card's sustained draw responds to its power limit at this workload is unread: no per-window power.draw average exists on srv3 or srv4, and a cap is a bound, not a draw" as NonEmptyStr,
    },
    causal_model: CausalModelUnestablished {
      subject: cap_ask_subject_identity(circuit: circuit),
      read_obligation: "how decode responds to the power limit, and how the circuit's load responds to decode, are unread on these hosts" as NonEmptyStr,
    },
  }
}

// ── THE CANDIDATE FIELD, AS THE SPINE SEES IT ──────────────────────────────────────────────────────

fn micro_tokens_per_second(rate: MilliTokensPerSecond) -> Int {
  nat_to_int(n: milli_tokens_per_second_count(r: rate)) * 1000
}

fn micro_watts(draw: Milliwatt) -> Int {
  nat_to_int(n: milliwatt_count(w: draw)) * 1000
}

fn decode_gap(cause: NonEmptyStr) -> AxisGap {
  AxisGap { axis: ax_decode_tokens_per_second, cause: cause }
}

fn draw_gap(cause: NonEmptyStr) -> AxisGap {
  AxisGap { axis: ax_host_draw_watts, cause: cause }
}

fn gpu_gap(cause: NonEmptyStr) -> AxisGap {
  AxisGap { axis: ax_gpu_draw_watts, cause: cause }
}

// A gap's cause is the read obligation the missing reading carries, verbatim. A gap that only said
// "unmeasured" would be indistinguishable from a gap nobody can close, and std.decision's
// SelectionNeedsEvidence is supposed to name what to go and read.
fn candidate_entry(c: CapCandidate) -> ParetoEntry {
  ParetoEntry {
    identity: c.identity,
    display_label: c.label,
    readings: concat(decode_reading_of(c: c), draw_readings_of(c: c)),
    missing_inputs: concat(decode_gaps_of(c: c), draw_gaps_of(c: c)),
  }
}

fn decode_reading_of(c: CapCandidate) -> List<AxisReading> {
  match decode_interval(c: c) {
    Present { value: iv } => [AxisReading { axis: ax_decode_tokens_per_second, interval_micro: iv }]
    Absent => []
  }
}

fn draw_readings_of(c: CapCandidate) -> List<AxisReading> {
  concat(host_draw_reading_of(c: c), gpu_draw_reading_of(c: c))
}

fn host_draw_reading_of(c: CapCandidate) -> List<AxisReading> {
  match host_draw_interval(c: c) {
    Present { value: iv } => [AxisReading { axis: ax_host_draw_watts, interval_micro: iv }]
    Absent => []
  }
}

fn gpu_draw_reading_of(c: CapCandidate) -> List<AxisReading> {
  match gpu_draw_interval(c: c) {
    Present { value: iv } => [AxisReading { axis: ax_gpu_draw_watts, interval_micro: iv }]
    Absent => []
  }
}

// THE ONE MINT FOR A READING'S REGION. std.interval's `closed_interval` is the sole mint and it REFUSES a
// reversed pair rather than swapping it, because swapping would absorb the evidence that the caller's
// endpoints were wrong (#gunbc.design_argument::fail_closed). A refused pair becomes no reading at all, which
// std.pareto then scores as a gap on the axis: the candidate is not compared, and the ask comes back as what
// to go and read again.
fn int_le(a: Int, b: Int) -> Bool { a <= b }

fn interval_or_absent(low: Int, high: Int) -> Optional<OrderedClosedInterval<Int>> {
  match closed_interval(low: low, high: high, le: int_le) {
    IntervalReady { interval: iv } => Present { value: iv }
    IntervalRefused { reason: _ } => Absent
  }
}

fn draw_interval_read(low: Milliwatt, high: Milliwatt) -> Optional<OrderedClosedInterval<Int>> {
  interval_or_absent(low: micro_watts(draw: low), high: micro_watts(draw: high))
}

// The host's draw at its feed: only a reading TAKEN THERE qualifies. A card's power.draw is not a partial host
// draw that can be scaled up -- the rest of the machine is unread, and an unread summand is not zero.
fn host_draw_interval(c: CapCandidate) -> Optional<OrderedClosedInterval<Int>> {
  match c.draw {
    DrawRead { draw_low: lo, draw_high: hi, samples: _, subject: s, throttle_share: _, observed_on: _, standing: _ } =>
      match s {
        HostLevel { instrument: _, covers: _ } => draw_interval_read(low: lo, high: hi)
        GpuSubsystem { gpu: _, instrument: _ } => Absent
      }
    DrawUnread { read_obligation: _ } => Absent
  }
}

fn gpu_draw_interval(c: CapCandidate) -> Optional<OrderedClosedInterval<Int>> {
  match c.draw {
    DrawRead { draw_low: lo, draw_high: hi, samples: _, subject: s, throttle_share: _, observed_on: _, standing: _ } =>
      match s {
        GpuSubsystem { gpu: _, instrument: _ } => draw_interval_read(low: lo, high: hi)
        HostLevel { instrument: _, covers: _ } => Absent
      }
    DrawUnread { read_obligation: _ } => Absent
  }
}

// Was the power-capped share of this window read? The watt step between two levels is priced only when both
// sides answer this: the share is what tells a ceiling doing work from a leakage-bound card, so a step across
// an unread share would report a saving whose kind is unknown.
fn share_is_read(c: CapCandidate) -> Bool {
  match c.draw {
    DrawRead { draw_low: _, draw_high: _, samples: _, subject: _, throttle_share: sh, observed_on: _, standing: _ } =>
      match sh {
        ShareRead { power_capped: _, instrument: _ } => true
        ShareUnread { read_obligation: _ } => false
      }
    DrawUnread { read_obligation: _ } => false
  }
}

fn is_host_level_draw(c: CapCandidate) -> Bool {
  match c.draw {
    DrawRead { draw_low: _, draw_high: _, samples: _, subject: s, throttle_share: _, observed_on: _, standing: _ } =>
      match s {
        HostLevel { instrument: _, covers: _ } => true
        GpuSubsystem { gpu: _, instrument: _ } => false
      }
    DrawUnread { read_obligation: _ } => false
  }
}

// What a candidate owes before its circuit-side cost can be priced at all, quoted verbatim into the gap so the
// refusal is a to-do rather than a shrug.
data host_draw_read_obligation: NonEmptyStr =
  "the whole-host draw at this machine's feed has never been read: nvidia-smi power.draw is one subsystem (the card) and hwmon apm_xgene is another (the CPU), so neither is the host's draw on a shared circuit; what closes it is a wattmeter on the member's feed, or a per-host PDU/UPS outlet reading that covers the whole machine" as NonEmptyStr

fn decode_gaps_of(c: CapCandidate) -> List<AxisGap> {
  match c.decode {
    DecodeRead { rate_low: _, rate_high: _, at_concurrency: _, window: _, instrument: _, standing: _ } =>
      if !optional_is_absent(opt: decode_interval(c: c)) {
        [] as List<AxisGap>
      } else {
        [decode_gap(cause: "the decode window's endpoints are reversed (low exceeds high), so the reading cannot be used as given" as NonEmptyStr)]
      }
    DecodeUnread { read_obligation: o } => [decode_gap(cause: o)]
  }
}

fn draw_gaps_of(c: CapCandidate) -> List<AxisGap> {
  match c.draw {
    DrawRead { draw_low: lo, draw_high: hi, samples: _, subject: s, throttle_share: _, observed_on: _, standing: _ } =>
      match s {
        // The card's number sits on the card's axis -- and the host axis stays a gap HERE, its cause naming
        // what was offered and what would close it. This is the arm the 2026-11-24 pricing lacked: a GPU
        // reading was available, so the circuit's axis looked answered.
        GpuSubsystem { gpu: g, instrument: ins } =>
          if !optional_is_absent(opt: gpu_draw_interval(c: c)) {
            [draw_gap(cause: concat(
              concat(concat(concat("no whole-host draw for this candidate: the reading on offer is ", g as String), " (", ins as String), ") -- one subsystem, not the host at its feed; ") as NonEmptyStr,
              host_draw_read_obligation
            ) as NonEmptyStr)]
          } else {
            [gpu_gap(cause: "the draw window's endpoints are reversed (low exceeds high), so the reading cannot be used as given" as NonEmptyStr),
             draw_gap(cause: host_draw_read_obligation)]
          }
        // The mirror: a host-level reading is not the card's own power.draw either, so the card side then
        // owes its own sample set.
        HostLevel { instrument: ins, covers: cov } =>
          if !optional_is_absent(opt: host_draw_interval(c: c)) {
            [gpu_gap(cause: concat(concat(concat("no GPU-subsystem draw for this candidate: the reading on offer is host-level (", ins as String), " covering ", cov) as NonEmptyStr, "); read nvidia-smi power.draw across the level to price the card side") as NonEmptyStr)]
          } else {
            [gpu_gap(cause: host_draw_read_obligation),
             draw_gap(cause: "the draw window's endpoints are reversed (low exceeds high), so the reading cannot be used as given" as NonEmptyStr)]
          }
      }
    DrawUnread { read_obligation: o } => [draw_gap(cause: o), gpu_gap(cause: o)]
  }
}

fn candidate_entries(field: List<CapCandidate>) -> List<ParetoEntry> {
  map(field, c => candidate_entry(c: c))
}

// ── THE CONSTRAINT THE ASK SERVES ──────────────────────────────────────────────────────────────────
//
// The circuit enters twice, and both entries are load-bearing. Its RATING is what makes any bound
// meaningful at all: with no rating read, nobody knows what the circuit may carry, so no bound can be
// applied and the ask is answered with what is unread. Its MEMBER-DRAW BOUND is the number the selection
// actually applies to a candidate, and it is a DECLARED figure with a standing, never a quotient of the
// rating by the member count -- dividing a circuit's rating among its members would invent a scale no
// instrument has read, which is the same refusal product.rack_power makes about assuming a power factor.
fn circuit_obligations(circuit: SharedPowerCircuit) -> List<AxisGap> {
  concat(rating_obligation(circuit: circuit), bound_obligation(circuit: circuit))
}

fn rating_obligation(circuit: SharedPowerCircuit) -> List<AxisGap> {
  match circuit_carry_limit(c: circuit) {
    Present { value: _ } => [] as List<AxisGap>
    Absent => match circuit_rating_read_obligation(c: circuit) {
      Present { value: o } => [draw_gap(cause: o)]
      Absent => [draw_gap(cause: concat(concat("the rating of ", circuit_label(c: circuit)), " has not been read" as NonEmptyStr) as NonEmptyStr)]
    }
  }
}

fn bound_obligation(circuit: SharedPowerCircuit) -> List<AxisGap> {
  match circuit_member_draw_bound(c: circuit) {
    BoundStated { draw_limit: _, standing: _ } => [] as List<AxisGap>
    BoundUnstated { read_obligation: o } => [draw_gap(cause: o)]
  }
}

// The hard constraint, minted only when the circuit's member-draw bound is stated. std.decision requires a
// constraint's axis to be a funded selection axis (unfunded_constraint_axis_defects refuses otherwise), and
// ax_host_draw_watts is funded, so the constraint reaches the feasibility scan rather than being ignored.
fn circuit_constraints(circuit: SharedPowerCircuit) -> List<HardConstraint> {
  match circuit_member_draw_bound(c: circuit) {
    BoundStated { draw_limit: limit, standing: _ } => [HardConstraint {
      identity: constraint_identity(circuit: circuit),
      axis: ax_host_draw_watts,
      bound_micro: micro_watts(draw: milliwatt(count: watt_count(w: limit) * 1000)),
      denomination: NonMoneyConstraint,
    }]
    BoundUnstated { read_obligation: _ } => []
  }
}

fn constraint_identity(circuit: SharedPowerCircuit) -> DeclarationRef {
  decl_ref(
    module_path: "gunbc.serving.gpu_power_cap_pricing",
    decl_name: concat("circuit-member-draw-bound-", declaration_ref_display_key(ref: circuit.identity)) as String,
  )
}

// ── THE FOLD ───────────────────────────────────────────────────────────────────────────────────────
//
// A power ask is priced, or it is refused with the missing reading named. Three things must hold before the
// selection is reached, and each failure lands in a different arm:
//   1. the ask must name the circuit it serves -- an unstated ask is REFUSED, not answered;
//   2. the circuit's rating must be read and its member-draw bound stated -- otherwise the constraint the
//      ask serves has no number, and the answer is what to read;
//   3. each candidate must carry a reading on every funded axis -- std.pareto's feasibility scan refuses to
//      compare a candidate whose funded-axis reading is absent, and this module never substitutes a cap
//      value, an average, or a zero for one.
//
// THE VERDICT IS std.decision's OWN RESULT TYPE, not a local coproduct: the arms are the corpus's closed
// answer to "what came of this ask", and a second verdict vocabulary beside them would be two answers to one
// question. This module's contribution is that the ask must name its circuit and the circuit's bound must be
// read before the selection is even reached.
fn price_power_cap_ask(
  ask: PowerAsk,
  assessment: DecisionAssessment,
  field: List<CapCandidate>,
) -> RealizationSelectionResult<ParetoEntry> {
  match ask {
    AskUnstated { cap: cap, said: said } => RealizationSelectionRefused {
      defects: [
        concat(
          concat(
            concat("a cap of ", nat_to_decimal_string(value: watt_count(w: cap))),
            " W cannot be priced: the ask names no electrical constraint it serves, so there is nothing for the watts to be saved against. What was said: " as NonEmptyStr
          ),
          said
        ) as NonEmptyStr,
      ],
    }
    CircuitRelief { circuit: circuit, asked_on: _ } =>
      let obligations = circuit_obligations(circuit: circuit)
      let on_circuit = filter(field, x => circuit_carries(c: circuit, host: x.host))
      if (obligations |> count) > 0 {
        SelectionNeedsEvidence { needs: map(obligations, g => UnfundedAxis { gap: g }) }
      } else if (on_circuit |> count) == 0 {
        // A machine the circuit does not carry cannot relieve it, however good its numbers. The 2026-11-24
        // decision space contained ken's cards and srv1's; only the strip's members could price the strip's
        // ask, and an off-circuit candidate must not even tie, let alone win, one.
        SelectionNeedsEvidence { needs: [UnfundedAxis { gap: AxisGap {
          axis: ax_host_draw_watts,
          cause: concat(
            concat("no candidate in the field is carried by ", circuit_label(c: circuit)),
            "; the ask can only be answered by a machine on this circuit" as NonEmptyStr
          ) as NonEmptyStr,
        } }] }
      } else if circuit_bound_is_stated(circuit: circuit) && !host_axis_is_read(field: on_circuit) {
        SelectionNeedsEvidence { needs: [UnfundedAxis { gap: host_bound_evidence_gap(circuit: circuit) }] }
      } else {
        select_realization(
          assessment: assessment,
          candidate_field_identity: cap_ask_field_identity(circuit: circuit, field: on_circuit),
          field: candidate_entries(field: on_circuit),
          axes: funded_axes_for(field: on_circuit),
          constraints: circuit_constraints(circuit: circuit),
          constraint_authority: circuit.identity,
          policy: cap_ask_policy(),
          evidence_snapshot: cap_ask_evidence_identity(circuit: circuit),
        )
      }
  }
}

// ── THE PRICED CONSEQUENCE, DERIVED FROM THE WINDOWS THAT WERE READ ────────────────────────────────
//
// WHAT THE OPERATOR ACTUALLY NEEDED ON 2026-11-24, in one question: when the cap moves, what happens to
// decode? That question is answerable from the windows that were read, and it is answered here with
// std.pareto's own interval comparison rather than a hand-rolled quotient or a subtraction of two rounded
// figures. The answer is an AxisComparison -- Better, Worse, Same, or UndecidedOnEvidence when the widths
// overlap -- because the honest form of "what did it cost" is the region the evidence supports, not a point.
//
// THE TWO COMPARISONS THAT MATTER, and the reason the CPU cap rides the same candidate:
//   40 W / 3.0 GHz -> 30 W / 3.0 GHz  =  Worse   (39.0 -> 24.1 tok/s: the GPU cap cost the throughput)
//   30 W / 3.0 GHz -> 30 W / 2.0 GHz  =  Better  (24.1 -> 26.5 tok/s: releasing the CPU cap did not cost it)
// A candidate shaped as "the GPU watt value" cannot express the second line at all.
fn decode_cost_of_step(from: CapCandidate, to: CapCandidate) -> AxisComparison {
  match decode_interval(c: from) {
    Present { value: ai } => match decode_interval(c: to) {
      Present { value: bi } => axis_comparison_interval(goal: HigherIsBetter, a: bi, b: ai)
      Absent => UndecidedOnEvidence
    }
    Absent => UndecidedOnEvidence
  }
}

fn decode_interval(c: CapCandidate) -> Optional<OrderedClosedInterval<Int>> {
  match c.decode {
    DecodeRead { rate_low: lo, rate_high: hi, at_concurrency: _, window: _, instrument: _, standing: _ } =>
      interval_or_absent(low: micro_tokens_per_second(rate: lo), high: micro_tokens_per_second(rate: hi))
    DecodeUnread { read_obligation: _ } => Absent
  }
}

// The reading std.pareto holds for one candidate on one axis, exposed so a consumer quotes the carrier's
// figure instead of re-deriving it from the row. Absent is located: it says which axis was looked for.
fn axis_reading_of(c: CapCandidate, axis: DeclarationRef) -> Optional<OrderedClosedInterval<Int>> {
  match reading_for(e: candidate_entry(c: c), wanted: axis) {
    ReadingFound { interval_micro: i } => Present { value: i }
    ReadingAbsent { absent_axis: _ } => Absent
    ReadingDuplicated { duplicated_axis: _ } => Absent
  }
}

// Is this candidate the machine the caller asked about? Identity equality through product.host_identity's
// own comparison, the same one the cap policy joins on.
fn candidate_is_on(c: CapCandidate, host: HostIdentity) -> Bool {
  host_identity_eq(a: c.host, b: host)
}

// The cap this candidate prices, read out of the policy's own carrier rather than restated.
fn candidate_cap(c: CapCandidate) -> Watt { gpu_power_cap_selected(s: c.gpu_cap) }

// ── THE COMPARISON THE OPERATOR NEEDED, GATED ON THE CARD IT WAS READ OFF ─────────────────────────
//
// WHAT WAS ASKED ON 2026-11-24, in one question: when this control moves, what happens to decode, and what
// does it save on the circuit? Two candidates answer it only if their readings are comparable, and the sweep
// showed what breaks comparability: ken's two cool T10s held ~990 MHz at 68-80 W under a 1000 MHz ceiling
// while GPU1, at 82 C, drew 83 W at EVERY level down to 600-800 MHz. Comparing a cool-card candidate with a
// leaky-card candidate reports a saving the leaky card never made, and on a 3-way layer split the leaky card
// is the pace-setter, so the reported decode would belong to neither.
//
// So the gate is on the CONDITION, not on the host or the label: two candidates whose cards are not known to
// be in the same state have no priced step between them, and the answer is std.pareto's own
// UndecidedOnEvidence. `ConditionUnread` is srv3's and srv4's state today for every candidate below except
// the srv4 sweep rows, whose condition is what the sweep itself observed (percent of the time power-capped,
// which is the observable that distinguishes a ceiling that is doing work from a card that is leakage-bound).
fn priced_step(from: CapCandidate, to: CapCandidate) -> AxisComparison {
  if cards_compare(a: from, b: to) {
    decode_cost_of_step(from: from, to: to)
  } else {
    UndecidedOnEvidence
  }
}

// Are these two candidates' readings comparable? Two rules, both load-bearing:
//
//   1. THEY MUST BE READ OFF THE SAME MACHINE. Two hosts are two sets of cards, and a comparison across
//      hosts is a generalisation, not a measurement -- which is exactly how "1000 MHz saves 15-25 W per
//      card" left ken's sweep as though it applied to every card in the fleet.
//   2. THEIR CARDS MUST NOT BE KNOWN TO BE IN DIFFERENT STATES. This is the gate the ken sweep earns: at
//      the same cap and the same ceiling, the two cool T10s dropped from 92-96 W to 68-80 W while GPU1, at
//      82 C, sat at 83 W at EVERY level. A fold that priced a step onto that card would report a saving the
//      card never made -- and on a 3-way layer split that card sets the pace for all three.
//
// `ConditionUnread` is deliberately NOT a mismatch: an absence is not evidence of a difference, and treating
// it as one would silently refuse every comparison in a fleet whose cards have never been read. What an
// unread condition costs is the read obligation on the candidate, which the gap and the witness both name.
fn cards_compare(a: CapCandidate, b: CapCandidate) -> Bool {
  host_identity_eq(a: a.host, b: b.host) && !states_known_to_differ(a: a.condition, b: b.condition)
}

fn states_known_to_differ(a: CardCondition, b: CardCondition) -> Bool {
  match a {
    ConditionRead { card: _, state: sa, sensor: _, observed_on: _, standing: _ } =>
      match b {
        ConditionRead { card: _, state: sb, sensor: _, observed_on: _, standing: _ } => !same_state(a: sa, b: sb)
        ConditionUnread { read_obligation: _ } => false
      }
    ConditionUnread { read_obligation: _ } => false
  }
}

fn same_state(a: CardThermalState, b: CardThermalState) -> Bool {
  match a {
    Cool => match b { Cool => true  _ => false }
    Hot => match b { Hot => true  _ => false }
    PowerBoundAtEveryClock => match b { PowerBoundAtEveryClock => true  _ => false }
  }
}

// The same gate on the cost side, so a consumer cannot quote a watt saving across cards either.
fn priced_draw_step(from: CapCandidate, to: CapCandidate) -> AxisComparison {
  if cards_compare(a: from, b: to) && share_is_read(c: from) && share_is_read(c: to) {
    match gpu_draw_interval(c: from) {
      Present { value: ai } => match gpu_draw_interval(c: to) {
        Present { value: bi } => axis_comparison_interval(goal: LowerIsBetter, a: bi, b: ai)
        Absent => UndecidedOnEvidence
      }
      Absent => UndecidedOnEvidence
    }
  } else {
    UndecidedOnEvidence
  }
}

fn card_of(c: CapCandidate) -> Optional<NonEmptyStr> {
  match c.condition {
    ConditionRead { card: k, state: _, sensor: _, observed_on: _, standing: _ } => Present { value: k }
    ConditionUnread { read_obligation: _ } => Absent
  }
}

// ── THE FLEET'S OWN CANDIDATES, 2026-11-24 ─────────────────────────────────────────────────────────
//
// CARRIED WITH THEIR STANDING, NOT AS FACTS. Every figure below was read over ssh by the operator's session
// on 2026-11-24, not by a committed instrument. Each row names its instrument as the operator's addendum
// names it, and each standing is TranscribedUncited with the read obligation that would pin it. A consumer
// that may price a cap change only on pinned evidence can refuse on that standing; that is what it is for.
//
// THE INSTRUMENTS ARE DIFFERENT AND ARE KEPT APART. Three appear here, at three grains:
//   - the engine's own journal lines `done: N tokens in T s (R tok/s)`, averaged per window (single-stream
//     decode, before any clock ceiling existed);
//   - clocksweep.sh / kensweep.sh: a locked-clock sweep under live serving traffic, 150 s per level, reading
//     nvidia-smi power.draw, clocks.sm, utilization and clocks_throttle_reasons once a second, with decode
//     from the engine's per-second progress lines (srv4) or /metrics totals (ken). The operator's own note is
//     that decode per 150 s window was NOISY -- different conversations in each window -- so the choice was
//     made on average SM clock and average watts. That is carried as a width, never averaged into a point;
//   - single hwmon apm_xgene readings, taken while the load was changing, which bound nothing and are quoted
//     in the read obligations rather than carried as a draw.

data srv4_cap_40w_2026_11_24: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 40),
  bounds: SustainedPowerDraw,
  decided_on: "2026-11-24" as NonEmptyStr,
  said: "operator restored 40 W after judging the 30 W drop not worth 10 W per card; the strip opened again later the same day and the caps went back to 30 W" as NonEmptyStr,
}

data srv4_cap_30w_2026_11_24: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 30),
  bounds: SustainedPowerDraw,
  decided_on: "2026-11-24" as NonEmptyStr,
  said: "operator set srv3/srv4 GPUs to 30 W after the surge-strip openings (~09:19 and ~21:57 UTC); 30 W is the RTX 2000 Ada's minimum settable limit (gunbc.fleet.gpu_device_observation power_limit_minimum)" as NonEmptyStr,
}

data srv3_cap_40w_2026_11_24: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 40),
  bounds: SustainedPowerDraw,
  decided_on: "2026-10-26" as NonEmptyStr,
  said: "operator capped srv3's Adas at 40 W on 2026-10-26 for noise/heat; returned there on 2026-11-24 as the final choice, with no SM clock ceiling" as NonEmptyStr,
}

data ken_cap_100w_2026_11_24: GpuPowerCapSelection = OperatorDeclaredCap {
  cap: watt(count: 100),
  bounds: SustainedPowerDraw,
  decided_on: "2026-11-24" as NonEmptyStr,
  said: "operator capped each Tesla T10 on ken at 100 W (t10-power-cap.service)" as NonEmptyStr,
}

// THE CEILINGS, as the 22:45 UTC sweep decided them.
data srv4_ceiling_1500_2026_11_24: SmClockCeiling = CappedWithin { maximum: hertz(count: 1500000000) }
data srv3_ceiling_1500_2026_11_24: SmClockCeiling = CappedWithin { maximum: hertz(count: 1500000000) }
data ken_ceiling_1000_2026_11_24: SmClockCeiling = CappedWithin { maximum: hertz(count: 1000000000) }

// THE CARD CONDITIONS THE SWEEP OBSERVED. ken's two cool cards versus ken's GPU1 is the pair that makes this
// field load-bearing; srv3's GPU1 is reported hot and leakage-bound in the operator's todo, which is why it
// carries the PowerBoundAtEveryClock state with a read obligation to pin the per-level wattage.
data ken_condition_gpu0: CardCondition = ConditionRead {
  card: "ken GPU0/GPU2 (the two cool T10s)" as NonEmptyStr,
  state: Cool,
  sensor: "kensweep.sh: nvidia-smi power.draw, clocks.sm, utilization, clocks_throttle_reasons once a second, 150 s per level" as NonEmptyStr,
  observed_on: "2026-11-24" as NonEmptyStr,
  standing: TranscribedUncited {
    read_obligation: "the sweep script and its raw per-second samples are on ken, not in artifacts/host-observations/; commit them and name kensweep.sh as an instrument" as NonEmptyStr,
  },
}

// THE LEAKY CARD. 82 C, and it drew 83 W at EVERY ceiling including 600-800 MHz while holding only ~790 MHz:
// its limit is leakage, not the ceiling, so a ceiling that saves 15-25 W on a cool card saves nothing here --
// and on the 3-way layer split it is the pace-setter for all three cards. This row is the reason a card's
// state gates comparability instead of being a comment beside the number.
data ken_condition_gpu1: CardCondition = ConditionRead {
  card: "ken GPU1 (81:00.0)" as NonEmptyStr,
  state: PowerBoundAtEveryClock,
  sensor: "kensweep.sh: nvidia-smi power.draw, clocks.sm, utilization, clocks_throttle_reasons once a second, 150 s per level; temperature 82 C read at the same sweep" as NonEmptyStr,
  observed_on: "2026-11-24" as NonEmptyStr,
  standing: TranscribedUncited {
    read_obligation: "the per-level wattage that establishes leakage is quoted from the sweep session, not from committed samples; and the cooling fix this row's existence argues for is an operator action, not a model change" as NonEmptyStr,
  },
}

data condition_unread_srv4: CardCondition = ConditionUnread {
  read_obligation: "srv4's card state is unread at the levels below (the sweep was run before the ceilings were decided and reports power-capped share, not temperature): read nvidia-smi temperatures per level so a reading can be compared across candidates" as NonEmptyStr,
}

data condition_unread_srv3: CardCondition = ConditionUnread {
  read_obligation: "srv3's GPU1 is reported hot and power-bound at any clock, which would make it PowerBoundAtEveryClock, but no per-level wattage or temperature from srv3 is committed: read clocks.sm, power.draw and temperature per level on srv3 before its readings are compared with srv4's" as NonEmptyStr,
}

// THE SINGLE-STREAM WINDOWS, read before any ceiling existed. These are the figures that showed the GPU cap,
// not the CPU cap, cost the throughput.
data srv4_decode_40w_30ghz_morning: DecodeReading = DecodeRead {
  rate_low: milli_tokens_per_second(count: 39000),
  rate_high: milli_tokens_per_second(count: 39000),
  at_concurrency: 1,
  window: "2026-11-24 06:00-09:00 UTC" as NonEmptyStr,
  instrument: "engine journal lines 'done: N tokens in T s (R tok/s)', averaged per window, read over ssh" as NonEmptyStr,
  standing: TranscribedUncited {
    read_obligation: "commit the journal window under artifacts/host-observations/ and name the averaging step as an instrument; this figure is a session read, not a pinned receipt" as NonEmptyStr,
  },
}

data srv4_decode_30w_20ghz: DecodeReading = DecodeRead {
  rate_low: milli_tokens_per_second(count: 26500),
  rate_high: milli_tokens_per_second(count: 26500),
  at_concurrency: 1,
  window: "2026-11-24, after the first strip opening, with the CPU capped at 2.0 GHz" as NonEmptyStr,
  instrument: "engine journal lines 'done: N tokens in T s (R tok/s)', averaged per window, read over ssh" as NonEmptyStr,
  standing: TranscribedUncited {
    read_obligation: "same as the 40 W window: the journal window is not committed and the averaging step is not an instrument" as NonEmptyStr,
  },
}

data srv4_decode_30w_30ghz: DecodeReading = DecodeRead {
  rate_low: milli_tokens_per_second(count: 24100),
  rate_high: milli_tokens_per_second(count: 24100),
  at_concurrency: 1,
  window: "2026-11-24, 30 W with the CPU cap released" as NonEmptyStr,
  instrument: "engine journal lines 'done: N tokens in T s (R tok/s)', averaged per window, read over ssh" as NonEmptyStr,
  standing: TranscribedUncited {
    read_obligation: "same as the 40 W window: the journal window is not committed and the averaging step is not an instrument" as NonEmptyStr,
  },
}

// THE WINDOW WITH A WIDTH. Reported as 28.5-34 tok/s across the conversations in it, so it is carried with
// its width: any dominance claim against it stays UndecidedOnEvidence, which is the honest statement that
// this window does not settle the comparison.
data srv4_decode_40w_afternoon: DecodeReading = DecodeRead {
  rate_low: milli_tokens_per_second(count: 28500),
  rate_high: milli_tokens_per_second(count: 34000),
  at_concurrency: 1,
  window: "2026-11-24, back at 40 W" as NonEmptyStr,
  instrument: "engine journal lines 'done: N tokens in T s (R tok/s)', averaged per window, read over ssh" as NonEmptyStr,
  standing: TranscribedUncited {
    read_obligation: "same as the other windows; the spread across conversations is also unexplained, which is a second thing a named instrument would settle" as NonEmptyStr,
  },
}

// srv3 fell too, and harder: the operator's todo records srv3 decode at 15 tok/s per conversation before the
// cap and 6 after. The grain of "before" (which cap, which window) is not named in the record, so BOTH rows
// carry a read obligation, and the pair is what makes srv3's own step the steepest in the fleet.
data srv3_decode_40w: DecodeReading = DecodeRead {
  rate_low: milli_tokens_per_second(count: 15000),
  rate_high: milli_tokens_per_second(count: 15000),
  at_concurrency: 1,
  window: "2026-11-24, before the caps went to 30 W" as NonEmptyStr,
  instrument: "unnamed in the record; reported as srv3 decode per conversation" as NonEmptyStr,
  standing: TranscribedUncited {
    read_obligation: "name the window and the instrument: which engine's journal, at which concurrency, over what span, on 2026-11-24" as NonEmptyStr,
  },
}

data srv3_decode_30w: DecodeReading = DecodeRead {
  rate_low: milli_tokens_per_second(count: 6000),
  rate_high: milli_tokens_per_second(count: 6000),
  at_concurrency: 1,
  window: "2026-11-24, at 30 W" as NonEmptyStr,
  instrument: "unnamed in the record; reported as srv3 decode per conversation" as NonEmptyStr,
  standing: TranscribedUncited {
    read_obligation: "same obligation as srv3's 40 W figure, plus the clocks.sm range the reading sat under (the record gives 210-990 MHz for the card at 30 W without saying which window it is)" as NonEmptyStr,
  },
}

// THE COST SIDE, where it was measured. The sweep DID average nvidia-smi power.draw over its 150 s levels, so
// those candidates carry a real reading; srv3 never had one, and its whole-host draw is still
// InferredFromSimilarBuild in gunbc.fleet.fleet_host_power, so it stays a gap rather than borrowing srv4's.
data draw_unread_srv3: DrawReading = DrawUnread {
  read_obligation: "no per-window power.draw average exists on srv3: sample nvidia-smi power.draw across the same window the decode figure comes from, per card, and carry the sample count" as NonEmptyStr,
}

data draw_unread_srv4: DrawReading = DrawUnread {
  read_obligation: "no per-window power.draw average exists for srv4's single-stream windows below (the sweep below measured draw only at its own six levels): sample nvidia-smi power.draw across the same window the decode figure comes from, per card, and carry the sample count" as NonEmptyStr,
}

// One sweep level on srv4, at the 30 W cap. `samples` is the count of one-second readings behind the average
// (the operator's own warning that the CPU figures were SINGLE readings is why the count is on the carrier
// rather than implied). The rate and the watts arrive as their std.measure carriers, not as a private tenths
// scale the call site would have to rescale correctly.
fn srv4_sweep_decode(median: MilliTokensPerSecond) -> DecodeReading {
  DecodeRead {
    rate_low: median,
    rate_high: median,
    at_concurrency: 1,
    window: "2026-11-24, one 150 s level of the srv4 locked-clock sweep" as NonEmptyStr,
    instrument: "clocksweep.sh: decode from the engine's per-second progress lines, median per 150 s level" as NonEmptyStr,
    standing: TranscribedUncited {
      read_obligation: "decode per 150 s window was noisy (different conversations in each window) and the operator decided on average clock and watts, not on this figure: commit clocksweep.sh and its raw samples under artifacts/host-observations/ before a ceiling is justified by decode alone" as NonEmptyStr,
    },
  }
}

fn srv4_sweep_draw(draw: Milliwatt, share: ThrottleShare) -> DrawReading {
  DrawRead {
    draw_low: draw,
    draw_high: draw,
    samples: 150,
    subject: GpuSubsystem {
      gpu: "srv4's serving pair, averaged" as NonEmptyStr,
      instrument: "clocksweep.sh: nvidia-smi power.draw read once a second across the 150 s level, averaged" as NonEmptyStr,
    },
    throttle_share: share,
    observed_on: "2026-11-24" as NonEmptyStr,
    standing: TranscribedUncited {
      read_obligation: "the sweep's raw per-second samples are on srv4, not committed; the average is over one 150 s level under live serving traffic, so it is one sample of a level, not the level" as NonEmptyStr,
    },
  }
}

data srv4_sweep_unlocked_candidate: CapCandidate = CapCandidate {
  identity: decl_ref(module_path: "gunbc.serving.gpu_power_cap_pricing", decl_name: "srv4-30w-unlocked"),
  label: "srv4, 30 W, clock unlocked: 869 MHz avg, 29.1 W, 96% power-capped, 28.0 tok/s" as NonEmptyStr,
  host: operator_host_srv4,
  gpu_cap: srv4_cap_30w_2026_11_24,
  cpu_cap: Uncapped,
  sm_clock: Unlocked,
  condition: condition_unread_srv4,
  decode: srv4_sweep_decode(median: milli_tokens_per_second(count: 28000)),
  draw: srv4_sweep_draw(
    draw: milliwatt(count: 29100),
    share: ShareRead {
      power_capped: permille(count: 960),
      instrument: "clocksweep.sh: clocks_throttle_reasons read once a second across the 150 s level" as NonEmptyStr,
    },
  ),
}

