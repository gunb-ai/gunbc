    samples: 150,
    subject: GpuSubsystem {
      gpu: "ken GPU1 (81:00.0)" as NonEmptyStr,
      instrument: "kensweep.sh: nvidia-smi power.draw read once a second across the 150 s level, averaged per card" as NonEmptyStr,
    },
    throttle_share: ShareUnread {
      read_obligation: "the power-capped share of this level was never read onto the row: kensweep.sh sampled clocks_throttle_reasons alongside the watts -- carry the permille; for this card it decides whether 'power-bound at every ceiling' is the throttle reason or an inference from the flat 83 W" as NonEmptyStr,
    },
    observed_on: "2026-11-24" as NonEmptyStr,
    standing: TranscribedUncited {
      read_obligation: "the per-level wattage that establishes leakage is quoted from the sweep session, not from committed samples" as NonEmptyStr,
    },
  },
}

// The levels the 2026-11-24 srv4 ask put forward: the sweep, at one cap and six clock ceilings.
fn srv4_cap_ask_candidates() -> List<CapCandidate> {
  [
    srv4_sweep_unlocked_candidate,
    srv4_sweep_2400_candidate,
    srv4_sweep_1800_candidate,
    srv4_sweep_1500_candidate,
    srv4_sweep_1200_candidate,
    srv4_sweep_900_candidate,
  ]
}

fn srv4_morning_candidates() -> List<CapCandidate> {
  [
    srv4_40w_30ghz_morning_candidate,
    srv4_30w_20ghz_candidate,
    srv4_30w_30ghz_candidate,
    srv4_40w_30ghz_afternoon_candidate,
  ]
}

fn ken_cap_ask_candidates() -> List<CapCandidate> {
  [ken_t10_cool_unlocked_candidate, ken_t10_cool_1000mhz_candidate, ken_t10_leaky_1000mhz_candidate]
}

// THE FLEET'S STATE, priced with nothing read: the strip, whose rating and member-draw bound are both unread.
// The answer is SelectionNeedsEvidence naming both readings, and it must never be a cap value.
fn price_the_2026_11_24_ask() -> RealizationSelectionResult<ParetoEntry> {
  price_power_cap_ask(
    ask: CircuitRelief { circuit: surge_strip, asked_on: "2026-11-24" as NonEmptyStr },
    assessment: cap_ask_unread_assessment(circuit: surge_strip),
    field: srv4_cap_ask_candidates(),
  )
}

// The 2026-11-24 morning decision as the model sees it: a cap of 30 W put forward with no circuit named.
// This is the arm the first half of that day lives in -- somebody said a number to save power and the model
// carried no constraint for it to be weighed against.
fn price_an_unstated_ask() -> RealizationSelectionResult<ParetoEntry> {
  price_power_cap_ask(
    ask: AskUnstated {
      cap: watt(count: 30),
      said: "operator: 30 W per card on srv3/srv4 (2026-11-24, first half of the day); no circuit named" as NonEmptyStr,
    },
    assessment: cap_ask_unread_assessment(circuit: surge_strip),
    field: srv4_morning_candidates(),
  )
}
