module gunbc.serving.serving_capacity_anchor

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat, nat_max }
import std.optional { Optional, Present, Absent }
import std.measure { TokensPerSecond, tokens_per_second, tokens_per_second_count, TokenCount, token_count, token_count_value, Permille, permille, permille_count, Millisecond, millisecond, millisecond_count, token_count_duration_at }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited, cited_figure_read_obligation }
import product.fabric.serving_throughput { ServingThroughput, ThroughputOperatorReading, ThroughputUnread }
import gunbc.serving.flash_next_maxq_fork_measurements { fork_prefill_readings, ForkPrefillReading }
import gunbc.serving.flash_next_topology { topology_dp }
import gunbc.serving.srv1_topology_comparison { Srv1TopologyReading, srv1_topology_reading, srv1_layout }
import gunbc.serving.serving_layout { ServingLayoutResult, ServingLayoutConfigured, ServingLayoutRefused, srv3_layout, srv4_layout }
import gunbc.serving.strata_parked_tier { strata_warm_admission, srv4_strata_rung_admissible }
import gunbc.serving.serving_warm_admission { ServingWarmAdmission, WarmAdmit, WarmRungUnread, WarmRungRefused }
import gunbc.serving.serving_host_memory {
  ServingMemoryReading, ServingMemoryRead, ServingMemoryAssumed, ServingMemoryUnread, ServingEngineMemory, ConversationSnapshotCost,
  conversation_snapshot_bytes, serving_warm_sessions_within, srv4_strata_parked_budget,
  srv3_strata_engine_memory, srv4_serving_engine_memory, host_6ce85c_engine_as_launched,
  srv3_strata_snapshot_cost, srv4_strata_snapshot_cost, strata_iq3_s_snapshot_cost, srv1_vllm_disk_snapshot_cost, srv1_vllm_disk_tier,
}

// ── HOW MANY CONVERSATIONS A DEPLOYMENT HOLDS IS A THROUGHPUT QUESTION, NOT A RESIDENCY ONE ──────────
//
// A deployment holds a conversation when it can give that conversation's turns the rate the policy asks
// for and bring its KV cache back between turns fast enough. Residency in RAM is one way to bring it back,
// not the measure: a conversation parked on disk and restored to the GPU on its next turn is held as much
// as one parked in RAM, provided the restore is quick. So the shape of a deployment is derived from three
// things, each with its own owner:
//   - the deployment's ANCHOR (a fact about the card and engine): aggregate decode at a context, at a
//     concurrency, with its standing; the cold prefill rate a store miss pays; and the warm swap tier, if
//     the engine has one, with its restore time and how many conversations it can keep.
//   - the CONVERSATION POLICY (a workflow decision, gunbc.design_argument::interface_realization_policy): the
//     context every anchor is read at, the least decode rate one active turn may get, the share of wall
//     time a conversation spends in a turn, and the longest swap-in a turn may wait.
//   - the DERIVATION below, which composes them and owns only the combining rule
//     (gunbc.design_argument::explicit_composition).
//
// THE ANCHORS ARE ROUGH ON PURPOSE (operator, 2026-11-08: "start with a heuristic anchor -- average 100k
// context -> average throughput for that load per card/deployment, and then derive the config"). Each
// carries its standing in its type (gunbc.design_argument::epistemic_humility), so a reader can tell a
// measured row from an operator heuristic, and a measured row replaces a heuristic by editing one anchor.

// WHERE A PARKED CONVERSATION'S KV WAITS BETWEEN TURNS.
type ServingSwapTier = SwapTierHostRam | SwapTierDisk

// HOW A RUNG PUTS ITS CONVERSATIONS THERE. LMCache evicts to its own tier without being told; Strata's parked
// conversations are saved and restored by the ROUTER driving the engine's slot-file endpoint
// (extdeps.strata.session_file, gunbc.serving.strata_checkpoint_transfer). The mechanism is not decoration: it says
// who pays for the save and what a miss costs the host, and it is what makes the same bytes mean different things.
type ServingSwapMechanism = SwapByEngineEviction | SwapByRouterSlotFile

// WHAT A RESTART COSTS THE RUNG. Host-RAM conversations die with the process; a saved slot file is on disk and comes
// back. Whether it CAN come back is not a weaker durability but a restore ADMISSIBILITY question (the model must be
// immutable while its files are retained, and SessionFileIdentity must match the engine that saved it) -- refused at
// the rung that realizes it, never softened into a durability arm's name.
//
// FRONTIER: mechanism and durability have NO consuming policy in this commit. They are minted now because the Strata
// disk rung needs a place to state them, and their only declared consumer is gentle-swift-129's follow-up selection
// profile, which will read durability to decide what a host may still hold across a restart and mechanism to price
// the save. Until that profile lands they are carried, not branched on -- if no consumer arrives they are the shape-
// first drift this rule warns against, so that profile is where they must first be read.
type ServingSwapDurability = LostWithProcess | SurvivesProcessRestart

// WHETHER A COLDER RUNG ADDS CONVERSATIONS OR RE-HOLDS ONES A HOTTER RUNG ALREADY HOLDS. LMCache's L1 is a hot copy
// of its L2; Strata's RAM cache may still hold a conversation the router has also saved to disk. An inclusive rung
// contributes max(hotter, itself), an exclusive one adds. UNSTATED FOLDS INCLUSIVE, so a rung whose sharing is
// unknown never enlarges what the deployment promises (gunbc.design_argument::fail_closed).
type ServingRungSharing = RungAdds | RungInclusiveOfHotter

// ONE RUNG OF THE WARM LADDER, ONE RULE FOR EVERY RUNG. It keeps as many conversations as its warm bytes hold
// snapshots of the anchor context, capped by its slots where the engine has them: gunbc.serving.serving_host_memory
// serving_warm_sessions_within over conversation_snapshot_bytes, the same rule engine_warm_sessions applies. Only the
// inputs differ by rung: a Strata engine's warm bytes and slots are its ServingEngineMemory row (host RAM); srv1's are
// LMCache's disk tier at its eviction watermark. An unread byte figure is not unbounded: such a rung contributes
// nothing and carries its obligation.
//
// A DEPLOYMENT CARRIES A LADDER OF THESE, HOTTEST FIRST, NOT A SECOND STORE: a host with a small RAM tier and a
// larger disk tier is one store with two rungs (operator, 2026-11-09: "small RAM L1 + larger disk"), and each rung is
// judged by the same rule -- a rung whose restore exceeds the policy's swap wait contributes NOTHING (it cannot
// resume a conversation in time), a rung whose bytes are unread contributes nothing and joins its obligation to the
// standings so the shape is Estimated, and rungs combine by their sharing, never blindly summed.
type ServingWarmSwap
  = WarmSwapRestores { tier: ServingSwapTier, mechanism: ServingSwapMechanism, durability: ServingSwapDurability, sharing: ServingRungSharing?, restore: Millisecond, cache: ServingMemoryReading, slots: Nat?, cost: ConversationSnapshotCost, standing: CitedFigureStanding, admission_standings: List<CitedFigureStanding> }
  | WarmSwapAbsent
  // A rung the deployment adapter refused outright. Distinct from an unread rung (WarmSwapRestores with an
  // unread cache): this is not "we have not looked", it is "this store cannot be used here" -- batch disables the
  // slot endpoint, the model is mutable, the build changed, the disk budget does not fit, or the layout refused.
  // It contributes nothing to held and is named in the bound (review 92430 / gentle-swift-129), so it can never
  // masquerade as a read obligation.
  | WarmSwapRefused { reason: NonEmptyStr, cites: NonEmptyStr }

type ServingWarmStore
  = WarmStoreKeeps { conversations: Nat }
  | WarmStoreUnread { obligation: NonEmptyStr }

fn serving_warm_store(cache: ServingMemoryReading, slots: Nat?, cost: ConversationSnapshotCost, context: TokenCount) -> ServingWarmStore {
  match cache {
    ServingMemoryRead { bytes: b, provenance: _ } => WarmStoreKeeps { conversations: serving_warm_sessions_within(cache: b, slots: slots, snapshot: conversation_snapshot_bytes(cost: cost, context: context)) }
    ServingMemoryAssumed { bytes: b, reason: _ } => WarmStoreKeeps { conversations: serving_warm_sessions_within(cache: b, slots: slots, snapshot: conversation_snapshot_bytes(cost: cost, context: context)) }
    ServingMemoryUnread { reason: r } => WarmStoreUnread { obligation: r }
  }
}

// A Strata engine's warm tier, read from its memory row so the bytes and slots have one authority. The engine keeps
// these conversations itself and they die with the process.
fn engine_warm_swap(e: ServingEngineMemory, cost: ConversationSnapshotCost, restore: Millisecond, standing: CitedFigureStanding) -> ServingWarmSwap {
  WarmSwapRestores { tier: SwapTierHostRam, mechanism: SwapByEngineEviction, durability: LostWithProcess, sharing: Absent, restore: restore, cache: e.conversation_cache, slots: e.conversation_slots, cost: cost, standing: standing, admission_standings: [] }
}

// A RUNG THE ROUTER REALIZES, NOT THE ENGINE. The bytes are a DECLARED BUDGET (the operator wants capped disk and
// minimal host impact), never the filesystem's free space: free space is a reading that must ADMIT the budget, and
// the check that it does belongs to the deployment adapter that knows the host (see gunbc.serving.strata_parked_tier
// strata_slot_file_admissible). The adapter answers with a ServingWarmAdmission, and the two failure kinds stay
// distinct through this fold: an outright REFUSAL (batch disables the slot endpoint, mutable model, changed build,
// free space below the budget, a refused layout) arrives as WarmSwapRefused -- a typed refusal that contributes
// nothing and is NAMED in the held bound, never folded into a fabricated read obligation; only a genuinely UNREAD
// figure (budget not declared, free space not read) arrives as an unread rung, carrying its obligation into the
// standings (review 92430 / gentle-swift-129).
fn slot_file_warm_swap(admissible: ServingWarmAdmission, budget: ServingMemoryReading, cost: ConversationSnapshotCost, restore: Millisecond, standing: CitedFigureStanding, durability: ServingSwapDurability) -> ServingWarmSwap {
  match admissible {
    // The disk rung's sharing is UNREAD -- we do not know whether a conversation the router has saved is still
    // resident in the engine's RAM cache -- so it is Absent, which the ladder folds INCLUSIVE (max with the hotter
    // rung), never a sum: the store never over-promises on an unknown (rule 2, operator's "unknown folds inclusive").
    WarmAdmit { admission_standings: adm } => WarmSwapRestores { tier: SwapTierDisk, mechanism: SwapByRouterSlotFile, durability: durability, sharing: Absent, restore: restore, cache: budget, slots: Absent, cost: cost, standing: standing, admission_standings: adm }
    WarmRungUnread { reason: r } => WarmSwapRestores { tier: SwapTierDisk, mechanism: SwapByRouterSlotFile, durability: durability, sharing: Absent, restore: restore, cache: ServingMemoryUnread { reason: r }, slots: Absent, cost: cost, standing: standing, admission_standings: [] }
    WarmRungRefused { reason: r, cites: c } => WarmSwapRefused { reason: r, cites: c }
  }
}

// WHAT THE LADDER FOLDS TO: the conversations it resumes in time, and the standings of what decided that. A rung that
// read its bytes sets read_any even when it holds none -- a store that is read and empty is a refusal, not an absence.
type ServingLadderTally { kept: Nat, read_any: Bool, too_slow_any: Bool, used: List<CitedFigureStanding>, unread: List<NonEmptyStr>, refused: List<NonEmptyStr> }

fn rung_adds_hotter(sh: ServingRungSharing?) -> Bool {
  match sh {
    Present { value: RungAdds } => true
    _ => false
  }
}

fn ladder_step(t: ServingLadderTally, rung: ServingWarmSwap, wait: Millisecond, context: TokenCount) -> ServingLadderTally {
  match rung {
    WarmSwapAbsent => t
    // A rung the deployment adapter REFUSED outright (batch, immutability, build, free space below the budget,
    // a refused layout) contributes NOTHING and is NOT an unread figure: it is carried in `refused` so the held
    // bound can NAME why the store cannot hold, rather than the fold inventing a read obligation for it (review
    // 92430 / gentle-swift-129). A genuinely unread rung (undeclared budget, unread free space) is a different
    // thing and arrives as WarmSwapRestores with an unread cache below.
    WarmSwapRefused { reason: r, cites: _ } =>
      ServingLadderTally { kept: t.kept, read_any: t.read_any, too_slow_any: t.too_slow_any, used: t.used, unread: t.unread, refused: concat(t.refused, [r]) }
    WarmSwapRestores { tier: _, mechanism: _, durability: _, sharing: sh, restore: r, cache: ch, slots: sl, cost: co, standing: st, admission_standings: adm } =>
      if millisecond_count(m: r) > millisecond_count(m: wait) {
        ServingLadderTally { kept: t.kept, read_any: t.read_any, too_slow_any: true, used: concat(concat(t.used, [st]), adm), unread: t.unread, refused: t.refused }
      } else {
        match serving_warm_store(cache: ch, slots: sl, cost: co, context: context) {
          WarmStoreUnread { obligation: o } =>
            ServingLadderTally { kept: t.kept, read_any: t.read_any, too_slow_any: t.too_slow_any, used: concat(concat(t.used, [st, TranscribedUncited { read_obligation: o }]), adm), unread: concat(t.unread, [o]), refused: t.refused }
          WarmStoreKeeps { conversations: n } => {
            let grew = if rung_adds_hotter(sh: sh) { t.kept + n } else { nat_max(a: t.kept, b: n) }
            // The rung's admission standings fold into `used` ONLY (gentle-swift-129, review 92497): an assumed build
            // match is a bet on ADMISSIBILITY, so its TranscribedUncited reaches `used` (making the shape Estimated);
            // it never enters `unread`, which means "this rung's bytes were not read" and drives the unread-cache shape.
            ServingLadderTally { kept: grew, read_any: true, too_slow_any: t.too_slow_any, used: concat(concat(concat(t.used, [st]), cache_standings(cache: ch)), adm), unread: t.unread, refused: t.refused }
          }
        }
      }
  }
}

fn ladder_tally(rungs: List<ServingWarmSwap>, wait: Millisecond, context: TokenCount) -> ServingLadderTally {
  fold(rungs, init: ServingLadderTally { kept: 0, read_any: false, too_slow_any: false, used: [], unread: [], refused: [] }, f: (acc, rung) => ladder_step(t: acc, rung: rung, wait: wait, context: context))
}

fn first_obligation(os: List<NonEmptyStr>) -> NonEmptyStr {
  match os |> first() {
    Present { value: o } => o
    Absent => "no rung of the warm ladder reported its bytes" as NonEmptyStr
  }
}

fn first_refusal(os: List<NonEmptyStr>) -> NonEmptyStr {
  match os |> first() {
    Present { value: o } => o
    Absent => "a rung of the warm ladder was refused" as NonEmptyStr
  }
}

// THE RESOURCE GRANT A DEPLOYMENT'S RETENTION MAY NOT EXCEED. Where a serving layout configures the replica
// (gunbc.serving.serving_layout admitted_conversations: retainable as they grow to the context ceiling, within the
// host's grant), throughput may tighten it and never enlarge it. Where no layout models the replica yet, the
// derivation is not bounded by one and the result carries that gap as an uncited standing. A layout that REFUSES the
// deployment (or does not configure the one replica this deployment is) is a refusal, never "unmodeled": it stops the
// shape and so every router writer.
type ServingRetentionGrant
  = GrantAdmits { conversations: Nat }
  | GrantUnmodeled { obligation: NonEmptyStr }
  | GrantRefused { reason: NonEmptyStr }

type ServingCapacityAnchor {
  deployment: NonEmptyStr
  grant: ServingRetentionGrant
  // The context the throughput reading was taken at. It must be at least the policy's anchor context, so a
  // short-context reading never stands in for the anchor load.
  context: TokenCount
  // Aggregate decode at that context, at the reading's concurrency. The concurrency is also the most turns
  // the derivation will run at once: beyond it the rate is unread.
  throughput: ServingThroughput
  // The rate a store miss re-reads the anchor context at. Absent when unread, never a stand-in zero.
  cold_prefill: TokensPerSecond?
  cold_prefill_standing: CitedFigureStanding
  // THE LADDER, HOTTEST RUNG FIRST. One element is the single-tier case every deployment had before rungs existed;
  // [] or [WarmSwapAbsent] is no warm path at all, which holds the deployment to its active turns.
  warm_swap: List<ServingWarmSwap>
}

type ServingConversationPolicy {
  anchor_context: TokenCount
  min_stream_rate: TokensPerSecond
  active_share: Permille
  max_swap_wait: Millisecond
}

// WHICH TERM BOUND THE CONVERSATIONS HELD, so a reader sees why a deployment holds what it holds.
type ServingHeldBound
  = HeldByActiveShare
  | HeldBySwapStore
  | HeldToTurnsNoWarmSwap
  | HeldToTurnsSwapTooSlow
  | HeldToTurnsStoreUnread { obligation: NonEmptyStr }
  | HeldToTurnsRungRefused { reason: NonEmptyStr }
  // A rung was READ (so the ladder has a real held figure) AND another rung was REFUSED outright. The held value is
  // correct (the refused rung contributes nothing), but the bound must still NAME the refusal so a refused disk rung
  // beside a read RAM rung does not silently vanish from the bound (gentle-swift-129 sign-off, review 92430 fold:
  // refusals stay typed on every path, never dropped). The limiter (swap store vs active share) is kept.
  | HeldBySwapStoreRungRefused { reason: NonEmptyStr }
  | HeldByActiveShareRungRefused { reason: NonEmptyStr }
  | HeldByRetentionGrant

// THE SHAPE KEEPS THE STANDING OF WHAT IT WAS DERIVED FROM (gunbc.design_argument::epistemic_humility: an inference is
// typed as a bet, neither deleted nor promoted). ServingShapeDerived is reached only when every figure the derivation
// actually used is cited or observed; when any is a transcription or an assumption the result is ServingShapeEstimated
// and carries each such standing, as product.fabric.serving_recipe UnitCostEstimated does. A consumer decides whether
// it admits an estimate; the derivation never promotes one.
type ServingCapacityShape
  = ServingShapeDerived { deployment: NonEmptyStr, turns: Nat, held: Nat, bound: ServingHeldBound, cold_reread: Millisecond }
  | ServingShapeEstimated { deployment: NonEmptyStr, turns: Nat, held: Nat, bound: ServingHeldBound, cold_reread: Millisecond, standings: List<CitedFigureStanding> }
  | ServingShapeRefused { deployment: NonEmptyStr, reason: NonEmptyStr }

fn shape_refused(a: ServingCapacityAnchor, reason: String) -> ServingCapacityShape {
  ServingShapeRefused { deployment: a.deployment, reason: reason as NonEmptyStr }
}

// The figures serving_held settles on, and the standings of the inputs that decided them.
type ServingHeldFigures { turns: Nat, held: Nat, bound: ServingHeldBound, cold_reread: Millisecond, used: List<CitedFigureStanding> }

fn standing_is_uncited(s: CitedFigureStanding) -> Bool {
  match cited_figure_read_obligation(standing: s) {
    Present { value: _ } => true
    Absent => false
  }
}

fn shape_of(a: ServingCapacityAnchor, f: ServingHeldFigures) -> ServingCapacityShape {
  let uncited = filter(f.used, s => standing_is_uncited(s: s))
  if count(uncited) == 0 {
    ServingShapeDerived { deployment: a.deployment, turns: f.turns, held: f.held, bound: f.bound, cold_reread: f.cold_reread }
  } else {
    ServingShapeEstimated { deployment: a.deployment, turns: f.turns, held: f.held, bound: f.bound, cold_reread: f.cold_reread, standings: uncited }
  }
}

// The grant tightens what throughput and the warm store derived and never enlarges it.
fn within_grant(a: ServingCapacityAnchor, f: ServingHeldFigures) -> ServingCapacityShape {
  match a.grant {
    GrantRefused { reason: r } => ServingShapeRefused { deployment: a.deployment, reason: r }
    GrantUnmodeled { obligation: o } => turns_within_held(a: a, f: ServingHeldFigures { turns: f.turns, held: f.held, bound: f.bound, cold_reread: f.cold_reread, used: concat(f.used, [TranscribedUncited { read_obligation: o }]) })
    GrantAdmits { conversations: n } =>
      if n >= f.held { turns_within_held(a: a, f: f) }
      else { turns_within_held(a: a, f: ServingHeldFigures { turns: f.turns, held: n, bound: HeldByRetentionGrant, cold_reread: f.cold_reread, used: f.used }) }
  }
}

// NO MORE TURNS THAN CONVERSATIONS HELD. Whatever bound held (the warm store or the grant), a deployment cannot run more
// turns at once than it can resume, since each turn's conversation must come back within the wait. When held falls
// below the reading's concurrency the turns fall with it, and the rate at that concurrency was never read: the lowered
// figure is carried as an explicit extrapolation, so the shape is an estimate, never a derived figure at an unmeasured
// point. Held of zero resumes nothing and refuses.
fn turns_within_held(a: ServingCapacityAnchor, f: ServingHeldFigures) -> ServingCapacityShape {
  if f.held == 0 {
    ServingShapeRefused { deployment: a.deployment, reason: "the deployment can keep no conversation of the anchor context resumable within the swap wait" as NonEmptyStr }
  } else if f.held >= f.turns {
    shape_of(a: a, f: f)
  } else {
    shape_of(a: a, f: ServingHeldFigures { turns: f.held, held: f.held, bound: f.bound, cold_reread: f.cold_reread, used: concat(f.used, [TranscribedUncited { read_obligation: ("held conversations lower turns from " + to_string(f.turns as Int) + " to " + to_string(f.held as Int) + "; no throughput reading exists at the lower concurrency, so its rate is extrapolated from the reading's") as NonEmptyStr }]) })
  }
}

// A layout with exactly one configured replica grants that replica's admitted conversations. A refused layout, or one
// configuring any other number of replicas, refuses: it is a decision about this deployment, not an absent model.
fn single_replica_grant(layout: ServingLayoutResult, deployment: String) -> ServingRetentionGrant {
  match layout {
    ServingLayoutRefused { refusal: _ } => GrantRefused { reason: ("the serving layout for " + deployment + " is refused") as NonEmptyStr }
    ServingLayoutConfigured { replicas: rs, unallocated_ram: _, evidence: _ } =>
      if count(rs) == 1 {
        fold(rs, init: GrantRefused { reason: "unreachable: a one-replica layout always folds its replica" as NonEmptyStr }, f: (acc, c) => GrantAdmits { conversations: c.admitted_conversations })
      } else { GrantRefused { reason: ("the serving layout for " + deployment + " configures " + to_string(count(rs) as Int) + " replicas, not one") as NonEmptyStr } }
  }
}

// Holding exactly the active turns' conversations when no warm path qualifies assumes their KV stays resident on the
// GPU between turns; nothing here reads that, so it is carried as a bet.
fn gpu_resident_turns() -> CitedFigureStanding {
  TranscribedUncited { read_obligation: "the active turns' KV is assumed to stay GPU-resident between turns; read the engine's KV pool against the turns at the anchor context" as NonEmptyStr }
}

// An assumed byte figure is a bet too: its reason is the read that would ground it.
fn cache_standings(cache: ServingMemoryReading) -> List<CitedFigureStanding> {
  match cache {
    ServingMemoryRead { bytes: _, provenance: _ } => []
    ServingMemoryAssumed { bytes: _, reason: r } => [TranscribedUncited { read_obligation: r }]
    ServingMemoryUnread { reason: _ } => []
  }
}

// A STORE MISS RE-READS THE WHOLE ANCHOR CONTEXT COLD. When that is within the wait, the warm tier's size
// does not bound what the deployment holds; otherwise only a fast warm tier with a known size lets it hold
// more conversations than it runs at once.
fn serving_held(turns: Nat, by_share: Nat, cold: Millisecond, a: ServingCapacityAnchor, p: ServingConversationPolicy) -> ServingHeldFigures {
  let wait = millisecond_count(m: p.max_swap_wait)
  if millisecond_count(m: cold) <= wait {
    ServingHeldFigures { turns: turns, held: by_share, bound: HeldByActiveShare, cold_reread: cold, used: [] }
  } else {
    let t = ladder_tally(rungs: a.warm_swap, wait: p.max_swap_wait, context: p.anchor_context)
    if t.read_any {
      if count(t.refused) > 0 {
        // A rung was read AND another was refused: keep the correct held value, but the bound names the refusal so it
        // does not disappear beside a read rung (gentle-swift-129). The limiter is preserved: swap store if the read
        // rungs alone are the smaller figure, active share if the cap binds.
        if t.kept < by_share {
          ServingHeldFigures { turns: turns, held: t.kept, bound: HeldBySwapStoreRungRefused { reason: first_refusal(os: t.refused) }, cold_reread: cold, used: t.used }
        } else {
          ServingHeldFigures { turns: turns, held: by_share, bound: HeldByActiveShareRungRefused { reason: first_refusal(os: t.refused) }, cold_reread: cold, used: t.used }
        }
      } else if t.kept < by_share {
        ServingHeldFigures { turns: turns, held: t.kept, bound: HeldBySwapStore, cold_reread: cold, used: t.used }
      } else {
        ServingHeldFigures { turns: turns, held: by_share, bound: HeldByActiveShare, cold_reread: cold, used: t.used }
      }
    } else if count(t.refused) > 0 {
      // The store could not be used at all and the reason is a REFUSAL, not an absence of reading: the bound names
      // it (batch disables the slot endpoint, the model is mutable, the build changed, the budget does not fit, the
      // layout refused) so a reader is never handed a fabricated read obligation (fail_closed / review 92430).
      ServingHeldFigures { turns: turns, held: turns, bound: HeldToTurnsRungRefused { reason: first_refusal(os: t.refused) }, cold_reread: cold, used: concat(t.used, [gpu_resident_turns()]) }
    } else if count(t.unread) > 0 {
      ServingHeldFigures { turns: turns, held: turns, bound: HeldToTurnsStoreUnread { obligation: first_obligation(os: t.unread) }, cold_reread: cold, used: concat(t.used, [gpu_resident_turns()]) }
    } else if t.too_slow_any {
      ServingHeldFigures { turns: turns, held: turns, bound: HeldToTurnsSwapTooSlow, cold_reread: cold, used: concat(t.used, [gpu_resident_turns()]) }
    } else {
      ServingHeldFigures { turns: turns, held: turns, bound: HeldToTurnsNoWarmSwap, cold_reread: cold, used: concat(t.used, [gpu_resident_turns()]) }
    }
  }
}

// THE DERIVATION. turns = the most turns that each still get the policy's least rate, capped at the reading's
// concurrency; held = turns over the active share, bounded by the swap path as serving_held states. Every
// input that would make a figure meaningless refuses with its reason; none is defaulted.
fn serving_capacity_shape(a: ServingCapacityAnchor, p: ServingConversationPolicy) -> ServingCapacityShape {
  let stream = tokens_per_second_count(r: p.min_stream_rate)
  let share = permille_count(p: p.active_share)
  match a.throughput {
    ThroughputUnread => shape_refused(a: a, reason: "the anchor's aggregate throughput is unread")
    ThroughputOperatorReading { tokens_per_second: agg, at_concurrency: c, standing: st } =>
      if token_count_value(t: a.context) < token_count_value(t: p.anchor_context) {
        shape_refused(a: a, reason: "the anchor was read at a shorter context than the policy's anchor context")
      } else if stream == 0 {
        shape_refused(a: a, reason: "the policy's least stream rate is zero")
      } else if share == 0 || share > 1000 {
        shape_refused(a: a, reason: "the policy's active share is outside 1..1000 permille")
      } else {
        match a.cold_prefill {
          Absent => shape_refused(a: a, reason: "the anchor's cold prefill rate is unread")
          Present { value: rate } => match token_count_duration_at(tokens: p.anchor_context, rate: rate) {
            Absent => shape_refused(a: a, reason: "the anchor's cold prefill rate is zero")
            Present { value: cold } =>
              if c == 0 || tokens_per_second_count(r: agg) / c < stream {
                shape_refused(a: a, reason: "at its measured concurrency the anchor gives each turn less than the policy's least stream rate, and no reading at a lower concurrency is supplied")
              } else {
                let f = serving_held(turns: c, by_share: c * 1000 / share, cold: cold, a: a, p: p)
                within_grant(a: a, f: ServingHeldFigures { turns: f.turns, held: f.held, bound: f.bound, cold_reread: f.cold_reread, used: concat([st, a.cold_prefill_standing], f.used) })
              }
          }
        }
      }
  }
}

// ── THE POLICY (operator proposal 2026-11-08, to be tuned) ────────────────────────────────────────────
// 100k context is the anchor load. A turn should decode at 10 tok/s or better. An agent conversation is in a
// turn a quarter of its wall time (tool calls and idle are the rest). A swap-in may delay a turn by 5 s.
data serving_conversation_policy: ServingConversationPolicy = ServingConversationPolicy {
  anchor_context: token_count(count: 100000),
  min_stream_rate: tokens_per_second(count: 10),
  active_share: permille(count: 250),
  max_swap_wait: millisecond(count: 5000),
}

// ── THE ANCHORS LIVE IN THE ROSTER NOW ────────────────────────────────────────────────────────────
//
// The per-replica anchor rows that stood below (srv1's two vLLM replicas, srv3, srv4, h11) are now the
// profile rows of gunbc.serving.serving_replica_profile -- the ONE roster every consumer reads -- and this
// module supplies their machinery: the ladder types and constructors above, the shape derivation, the
// conversation policy and the grant fold. A replica's host, engine, context, cold prefill, ladder and grant
// stand in its row there; nothing here restates them.

