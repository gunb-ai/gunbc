module gunbc.serving.serving_launch

import std.types { String, NonEmptyStr, Bool, List }
import std.algebra { list_append }
import std.decl_ref { decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import std.content_hash { Sha256Digest }
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }
import extdeps.exec.command { ArgvCommand, shell_command_render }
import gunbc.serving.serving_artifact_placement { ServingStoreRoots, ServingLinkReading, ServingLinkSwitchNoop, ServingLinkSwitchCommands, ServingLinkSwitchRefusedUnreadable, serving_link_switch }
import extdeps.tools.util_linux_setsid { setsid_fork_command }
import extdeps.posix.process { PosixProcessStdoutAndStderrToOneFile, PosixFileTruncate }
import extdeps.posix.shell_command_language { admit_posix_redirect_pathname, PosixRedirectPathAdmitted, PosixRedirectPathRefused }
import gunbc.remote_shell_command { RemoteExecCommandBuilt, RemoteExecCommandRefused, RemoteExecCommandRefusalCause, remote_exec_command_rendered }
import gunbc.command_runner { command_over_transport_refusal_reason }
import gunbc.host.host_effect_argv_stdio { host_effect_argv_stdio_remote_command }
import gunbc.serving.serving_key_grant { ServingKeyGrant, serving_key_grant_name }
import extdeps.ninfer.ninfer_serve { NinferServeLaunch, NinferModelsList, NinferModelsAdvertised, NinferModelsUnreadable }

// THE SERVE-LAUNCH LEG IS CONVERGENCE, NOT A SCRIPT (DESIGN 3d). Before it acts it takes an independent
// readback from the lab of the port the engine listens on: whether anything answers health, and which model
// ids it serves. The decision is a caller-supplied requirement (the launch's model id) judged over that
// readback and nothing else: an engine already serving the pinned model is a Noop, only an observed absence
// starts one, and a mismatch or an unreadable answer refuses typed. There is never a blind second launch.
type ServingServeReading
  = ServingServeNotListening
  | ServingServeAnswering { healthy: Bool, models: NinferModelsList }
  | ServingServeUnreadable { cause: NonEmptyStr }

fn serving_serve_decision(launch: NinferServeLaunch, reading: ServingServeReading) -> UpsertDecision<NinferServeLaunch> {
  match reading {
    ServingServeNotListening => Apply { plan: launch }
    ServingServeUnreadable { cause: c } => Refuse { reason: join(["serve readback unreadable: ", c as String], "") as NonEmptyStr }
    ServingServeAnswering { healthy: h, models: m } =>
      match m {
        NinferModelsUnreadable { cause: c } => Refuse { reason: join(["served model ids unreadable: ", c as String], "") as NonEmptyStr }
        NinferModelsAdvertised { ids: ids } =>
          if h && any(xs: ids, predicate: fn(i) { i == (launch.model_id as String) }) {
            Noop
          } else {
            Refuse { reason: "something answers on the port but is unhealthy or does not serve the pinned model id; refusing a second launch" as NonEmptyStr }
          }
      }
  }
}

// THE SERVE API KEY IS A GRANT BOUND TO THE ALLOCATION, never a literal (gunbc.serving.serving_key_grant;
// gunbc.serving.rented_host_grant is the ssh-access authorization and not this key). The bound arm carries the
// grant and never the key text (the leg and ninfer_serve_launch_argv have no key field, so the key cannot reach argv by construction), and no secret source delivers the key yet, so a bound launch still refuses
// typed on the missing delivery. An unbound launch refuses as before. The detach mechanism is likewise a host
// fact nobody has read (whether the card's PID 1 is systemd), so it is a typed refusal and not an assumption.
type ServingServeKeyBinding
  = ServingServeKeyUnbound { grant_name: NonEmptyStr }
  | ServingServeKeyBound { grant: ServingKeyGrant }

// THE DETACH IS setsid --fork WITH STDOUT AND STDERR SET TO THE SERVE LOG. The card's PID 1 is bash and its
// systemd manager reports offline, so systemd_run (extdeps.systemd.systemd_run) cannot start a transient unit
// there; setsid detaches the engine, and the engine's stdout and stderr go to the log named by the store roots
// (run.sh's `> serve.log 2>&1`, truncating) so the ssh channel is not held open and the engine does not die on
// SIGPIPE. The leg carries the one remote command string the login shell re-parses
// (gunbc.host.host_effect_argv_stdio host_effect_argv_stdio_remote_command), or the typed cause the render refused.
type ServingDetachLeg
  = ServingDetachRendered { remote_command: NonEmptyStr }
  | ServingDetachRefusedLogPath { path: NonEmptyStr }
  | ServingDetachRefusedRender { cause: RemoteExecCommandRefusalCause }

fn serving_detach_leg(roots: ServingStoreRoots, launch_argv: List<String>) -> ServingDetachLeg {
  match admit_posix_redirect_pathname(path: roots.serve_log as String) {
    PosixRedirectPathRefused { cause: _ } => ServingDetachRefusedLogPath { path: roots.serve_log }
    PosixRedirectPathAdmitted { path: p } =>
      match host_effect_argv_stdio_remote_command(command: setsid_fork_command(command: launch_argv), stdio: PosixProcessStdoutAndStderrToOneFile { path: p, mode: PosixFileTruncate }) {
        RemoteExecCommandBuilt { command: c } => ServingDetachRendered { remote_command: remote_exec_command_rendered(command: c) }
        RemoteExecCommandRefused { cause: c } => ServingDetachRefusedRender { cause: c }
      }
  }
}

// THE LEG REFUSES FOR THE UNMET KEY GRANT AND CARRIES THE DETACH COMMAND IT WOULD RUN beside it.
type ServingLaunchLeg
  = ServingLaunchNoop
  | ServingLaunchRefusedReadback { cause: String }
  | ServingLaunchRefusedUnmetCauses { key_grant: NonEmptyStr, detach: ServingDetachLeg }
  | ServingLaunchRefusedKeyNotDelivered { key_grant: NonEmptyStr, detach: ServingDetachLeg }

fn serving_launch_leg(roots: ServingStoreRoots, launch: NinferServeLaunch, launch_argv: List<String>, reading: ServingServeReading, key: ServingServeKeyBinding) -> ServingLaunchLeg {
  match serving_serve_decision(launch: launch, reading: reading) {
    Noop => ServingLaunchNoop
    Refuse { reason: r } => ServingLaunchRefusedReadback { cause: r as String }
    Apply { plan: _ } =>
      match key {
        ServingServeKeyUnbound { grant_name: g } => ServingLaunchRefusedUnmetCauses { key_grant: g, detach: serving_detach_leg(roots: roots, launch_argv: launch_argv) }
        ServingServeKeyBound { grant: kg } =>
          ServingLaunchRefusedKeyNotDelivered { key_grant: serving_key_grant_name(subject: kg.subject), detach: serving_detach_leg(roots: roots, launch_argv: launch_argv) }
      }
  }
}

// THE WHOLE PROGRAM IN ORDER: the placement legs first, the launch leg last, so a refusal at the launch leg
// still shows the earlier legs were emitted and not skipped.
type ServingPlacement
  = ServingPlacementCommands { commands: List<ArgvCommand> }
  | ServingPlacementRefusedLinkUnreadable { cause: NonEmptyStr }

type ServingStartupProgram {
  placement: ServingPlacement
  launch: ServingLaunchLeg
}

fn serving_startup_program(
  roots: ServingStoreRoots,
  digest: Sha256Digest,
  link: ServingLinkReading,
  launch: NinferServeLaunch,
  launch_argv: List<String>,
  reading: ServingServeReading,
  key: ServingServeKeyBinding,
) -> ServingStartupProgram {
  ServingStartupProgram {
    placement: match serving_link_switch(roots: roots, digest: digest, link: link) {
      ServingLinkSwitchNoop => ServingPlacementCommands { commands: [] }
      ServingLinkSwitchCommands { commands: cs } => ServingPlacementCommands { commands: cs }
      ServingLinkSwitchRefusedUnreadable { cause: c } => ServingPlacementRefusedLinkUnreadable { cause: c }
    },
    launch: serving_launch_leg(roots: roots, launch: launch, launch_argv: launch_argv, reading: reading, key: key),
  }
}

data serving_serve_launch_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.serving.serving_launch", decl_name: "serving_launch_leg"),
    reason: "the serving API key is bound as a grant to the allocation but no secret source delivers its text to the launch, so a bound launch refuses on the missing delivery and no launch command is emitted by the full sequence",
    dissolution: unbound_dissolution(description: "a secret source that delivers the granted key to the engine without placing it in argv, sufficient for the full-sequence claim to emit the launch command"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.harness.harness_operator_route", decl_name: "harness_operator_route"),
    reason: "harness_operator_route is the last executing api-key path and is kept until the bound grant replaces its bearer path",
    dissolution: unbound_dissolution(description: "the bound serving key grant has an executing key delivery that replaces the harness_operator_route bearer path, sufficient to retire harness_operator_route"),
  ),
]

// THE VERSIONED RECEIPT (the runner_guest_image standing shape): the program's rendered text, one placement
// command per line then the launch leg's standing, so a reader sees what the lab would run and where it stops.
fn serving_detach_text(detach: ServingDetachLeg) -> String {
  match detach {
    ServingDetachRendered { remote_command: c } => c as String
    ServingDetachRefusedLogPath { path: p } => concat("refused: the serve log path is not a redirectable pathname: ", p as String)
    ServingDetachRefusedRender { cause: c } => concat("refused: the detach command could not be rendered for the login shell: ", command_over_transport_refusal_reason(cause: c))
  }
}

fn serving_launch_leg_text(leg: ServingLaunchLeg) -> String {
  match leg {
    ServingLaunchNoop => "launch: noop (already serving the pinned model)"
    ServingLaunchRefusedReadback { cause: c } => concat("launch: refused on readback: ", c)
    ServingLaunchRefusedUnmetCauses { key_grant: g, detach: d } => concat("launch: refused: serve key grant unbound (", concat(g as String, concat("); detach: ", serving_detach_text(detach: d))))
    ServingLaunchRefusedKeyNotDelivered { key_grant: g, detach: d } => concat("launch: refused: serve key grant bound (", concat(g as String, concat(") but no secret source delivers the key; detach: ", serving_detach_text(detach: d))))
  }
}

fn serving_placement_text(placement: ServingPlacement) -> String {
  match placement {
    ServingPlacementCommands { commands: cs } => join(map(cs, c => shell_command_render(command: c)), "\n")
    ServingPlacementRefusedLinkUnreadable { cause: c } => concat("placement: refused: the model link could not be read: ", c as String)
  }
}

fn serving_startup_program_text(program: ServingStartupProgram) -> String {
  concat(serving_placement_text(placement: program.placement), concat("\n", serving_launch_leg_text(leg: program.launch)))
}
