module gunbc.serving.caller_backlog

import std.types { Bool, String, NonEmptyStr, Int, List, brand }
import std.nat { Nat, Zero, Succ }
import std.checked_arithmetic { checked_int_to_nat }
import std.optional { Present, Absent }
import std.algebra { length }
import product.fabric.execution { ReservationRef }
import product.fabric.budget { MoneyAccount, fence_admits }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_display_key }
import std.durable_compare_and_set {
  ExpectSlotAbsent, ExpectSlotGeneration, CasCommitted, CasPreconditionFailed, CasStoreRefused,
  CasReadableAbsent, CasReadablePresent, CasObservedReadable, CasObservedUnreadable,
  CasGeneration, cas_unreadable_slot_detail,
}
import gunbc.durable_cas_file_store {
  admit_cas_attempt_for_derived_payload, DerivedPayloadAdmitted, DerivedPayloadKeyNotSlotAddressable,
  file_compare_and_set, DefaultAccessCreateOnly, observe_cas_slot_state, cas_key_is_slot_addressable,
}

// ── THE BACKLOG IS THE CALLER'S, AND IT IS A PERSISTED SNAPSHOT, NEVER A ROUTER QUEUE ─────────
//
// gunbc.serving.caller_retry_contract names the seven properties a durable caller backlog owes.
// This module is the executing basis: one logical-work record, persisted before any offer,
// resumed from the snapshot after a controller dies, fenced by the fabric money-lease generation
// (product.fabric.budget fence_admits), cancelled only into a terminal phase, and bounded across
// the WHOLE recovery history so a succeeding probe cannot reset a failing request series.
//
// THERE IS NO ROUTER-LOCAL QUEUE. gunbc.serving.router_realization forbids MaintainAuthoritativeBindingLedger;
// waiting work lives on this snapshot, which a controller restart reloads. A synthetic nudge
// (re-persist, re-offer) is not required for the same logical work to be waiting again.

type LogicalWorkId = NonEmptyStr where brand("LogicalWorkId")

type RecoveryBoundDeficit {
  probes_succeeded: Nat
  requests_failed: Nat
}

type CallerWorkPhase
  = WorkWaiting
  | WorkCompleted
  | WorkCancelled
  | WorkRecoveryBoundExceeded { deficit: RecoveryBoundDeficit }

type RecoveryKind
  = RecoveryProbe
  | RecoveryRequest

type RecoveryEvent {
  kind: RecoveryKind
  succeeded: Bool
}

type CallerWorkRecord {
  work: LogicalWorkId
  reservation: ReservationRef
  generation: Int
  phase: CallerWorkPhase
  recovery: List<RecoveryEvent>
}

type CallerBacklogSnapshot {
  records: List<CallerWorkRecord>
}

data empty_caller_backlog: CallerBacklogSnapshot = CallerBacklogSnapshot { records: [] as List<CallerWorkRecord> }

fn logical_work_eq(a: LogicalWorkId, b: LogicalWorkId) -> Bool {
  a as String == b as String
}

fn records_for(snapshot: CallerBacklogSnapshot, work: LogicalWorkId) -> List<CallerWorkRecord> {
  filter(snapshot.records, r => logical_work_eq(a: r.work, b: work))
}

type CallerRecordLookup
  = CallerRecordFound { record: CallerWorkRecord }
  | CallerRecordAbsent
  | CallerRecordDuplicated

fn lookup_record(snapshot: CallerBacklogSnapshot, work: LogicalWorkId) -> CallerRecordLookup {
  let found = records_for(snapshot: snapshot, work: work)
  if length(found) == 0 {
    CallerRecordAbsent
  } else if length(found) == 1 {
    match found.first() {
      Absent => CallerRecordAbsent
      Present { value: record } => CallerRecordFound { record: record }
    }
  } else {
    CallerRecordDuplicated
  }
}

fn replace_record(snapshot: CallerBacklogSnapshot, next: CallerWorkRecord) -> CallerBacklogSnapshot {
  CallerBacklogSnapshot {
    records: concat(
      filter(snapshot.records, r => !logical_work_eq(a: r.work, b: next.work)),
      [next],
    ),
  }
}

fn waiting_record(work: LogicalWorkId, reservation: ReservationRef, generation: Int) -> CallerWorkRecord {
  CallerWorkRecord {
    work: work,
    reservation: reservation,
    generation: generation,
    phase: WorkWaiting,
    recovery: [] as List<RecoveryEvent>,
  }
}

// Persist BEFORE offer: a turn that is not on the snapshot cannot be offered. Persist is
// idempotent for an already-waiting identity (duplicate suppression) and refuses a cancelled or
// bound-exceeded identity (cancellation is terminal; a bound is not a licence to start over).
type PersistStanding
  = WaitingPersisted { record: CallerWorkRecord }
  | PersistIdempotent { record: CallerWorkRecord }
  | PersistRefusedTerminal { phase: CallerWorkPhase }
  | PersistRefusedDuplicate

fn persist_waiting(
  snapshot: CallerBacklogSnapshot,
  work: LogicalWorkId,
  reservation: ReservationRef,
  generation: Int,
) -> PersistStanding {
  match lookup_record(snapshot: snapshot, work: work) {
    CallerRecordAbsent => WaitingPersisted { record: waiting_record(work: work, reservation: reservation, generation: generation) }
    CallerRecordDuplicated => PersistRefusedDuplicate
    CallerRecordFound { record: head } =>
      match head.phase {
        WorkWaiting => PersistIdempotent { record: head }
        WorkCompleted => PersistRefusedTerminal { phase: head.phase }
        WorkCancelled => PersistRefusedTerminal { phase: head.phase }
        WorkRecoveryBoundExceeded { deficit: _ } => PersistRefusedTerminal { phase: head.phase }
      }
  }
}

fn snapshot_after_persist(snapshot: CallerBacklogSnapshot, standing: PersistStanding) -> CallerBacklogSnapshot {
  match standing {
    WaitingPersisted { record: r } => replace_record(snapshot: snapshot, next: r)
    PersistIdempotent { record: _ } => snapshot
    PersistRefusedTerminal { phase: _ } => snapshot
    PersistRefusedDuplicate => snapshot
  }
}

type OfferStanding
  = OfferedAfterPersist { record: CallerWorkRecord }
  | OfferRefusedUnpersisted
  | OfferRefusedPhase { phase: CallerWorkPhase }
  | OfferRefusedDuplicate

fn offer_persisted(snapshot: CallerBacklogSnapshot, work: LogicalWorkId) -> OfferStanding {
  match lookup_record(snapshot: snapshot, work: work) {
    CallerRecordAbsent => OfferRefusedUnpersisted
    CallerRecordDuplicated => OfferRefusedDuplicate
    CallerRecordFound { record: head } =>
      match head.phase {
        WorkWaiting => OfferedAfterPersist { record: head }
        WorkCompleted => OfferRefusedPhase { phase: head.phase }
        WorkCancelled => OfferRefusedPhase { phase: head.phase }
        WorkRecoveryBoundExceeded { deficit: _ } => OfferRefusedPhase { phase: head.phase }
      }
  }
}

// Resume reads the DURABLE snapshot. An empty in-memory view after a controller restart is not
// a lost turn: the same logical work is still waiting, and no second persist is required.
type ResumeStanding
  = ResumedWaiting { record: CallerWorkRecord }
  | ResumedTerminal { phase: CallerWorkPhase }
  | ResumeUnknownWork
  | ResumeDuplicateWork

fn resume_from_snapshot(snapshot: CallerBacklogSnapshot, work: LogicalWorkId) -> ResumeStanding {
  match lookup_record(snapshot: snapshot, work: work) {
    CallerRecordAbsent => ResumeUnknownWork
    CallerRecordDuplicated => ResumeDuplicateWork
    CallerRecordFound { record: head } =>
      match head.phase {
        WorkWaiting => ResumedWaiting { record: head }
        WorkCompleted => ResumedTerminal { phase: head.phase }
        WorkCancelled => ResumedTerminal { phase: head.phase }
        WorkRecoveryBoundExceeded { deficit: _ } => ResumedTerminal { phase: head.phase }
      }
  }
}

type ControllerView {
  memory: CallerBacklogSnapshot
  durable: CallerBacklogSnapshot
}

fn view_after_controller_restart(durable: CallerBacklogSnapshot) -> ControllerView {
  ControllerView { memory: empty_caller_backlog, durable: durable }
}

fn resume_after_restart(view: ControllerView, work: LogicalWorkId) -> ResumeStanding {
  resume_from_snapshot(snapshot: view.durable, work: work)
}

// THE SLOT PAYLOAD IS ONE WIRE FORM. waiting_wire_separator / waiting_wire_field_count,
// waiting_phase_wire_rows, and waiting_recovery_wire_rows are the productions; encode
// selects them backward, decode selects the same rows forward. A field that could contain
// the separator is unencodable — never sanitized, never written — so persist cannot land
// a turn resume cannot read (the loss PersistBeforeOffer exists to prevent).
// generation here is product.fabric.budget MoneyLease.generation (Int), not
// std.durable_compare_and_set CasGeneration (the slot's version).

data waiting_wire_separator: String = "\t"
data waiting_wire_field_count: Int = 6
data waiting_recovery_separator: String = ","

type WaitingPhaseWireRow {
  tag: String
  closed: CallerWorkPhase?
}

data waiting_phase_wire_rows: List<WaitingPhaseWireRow> = [
  WaitingPhaseWireRow { tag: "W", closed: Present { value: WorkWaiting } },
  WaitingPhaseWireRow { tag: "C", closed: Present { value: WorkCompleted } },
  WaitingPhaseWireRow { tag: "X", closed: Present { value: WorkCancelled } },
  WaitingPhaseWireRow { tag: "B", closed: none },
]

type WaitingRecoveryWireRow {
  token: String
  event: RecoveryEvent
}

data waiting_recovery_wire_rows: List<WaitingRecoveryWireRow> = [
  WaitingRecoveryWireRow { token: "P1", event: RecoveryEvent { kind: RecoveryProbe, succeeded: true } },
  WaitingRecoveryWireRow { token: "P0", event: RecoveryEvent { kind: RecoveryProbe, succeeded: false } },
  WaitingRecoveryWireRow { token: "R1", event: RecoveryEvent { kind: RecoveryRequest, succeeded: true } },
  WaitingRecoveryWireRow { token: "R0", event: RecoveryEvent { kind: RecoveryRequest, succeeded: false } },
]

fn waiting_wire_field_is_clean(field: String) -> Bool {
  field != ""
    && length(field.split(delimiter: waiting_wire_separator)) == 1
    && length(field.split(delimiter: "\n")) == 1
}

fn waiting_generation_wire(generation: Int) -> String? {
  let s = to_string(generation)
  if !waiting_wire_field_is_clean(field: s) {
    none
  } else {
    match parse_int(s: s) {
      Absent => none
      Present { value: back } => if back == generation { Present { value: s } } else { none }
    }
  }
}

fn encode_bound_deficit(deficit: RecoveryBoundDeficit) -> String {
  concat(to_string(deficit.probes_succeeded as Int), concat(":", to_string(deficit.requests_failed as Int)))
}

fn decode_bound_deficit(s: String) -> RecoveryBoundDeficit? {
  let parts = s.split(delimiter: ":")
  if length(parts) != 2 {
    none
  } else {
    match parts.first() {
      Absent => none
      Present { value: probes_s } =>
        match parts.skip(n: 1).first() {
          Absent => none
          Present { value: requests_s } =>
            match parse_int(s: probes_s) {
              Absent => none
              Present { value: probes_i } =>
                match parse_int(s: requests_s) {
                  Absent => none
                  Present { value: requests_i } =>
                    match checked_int_to_nat(n: probes_i) {
                      Absent => none
                      Present { value: probes_succeeded } =>
                        match checked_int_to_nat(n: requests_i) {
                          Absent => none
                          Present { value: requests_failed } =>
                            Present {
                              value: RecoveryBoundDeficit {
                                probes_succeeded: probes_succeeded,
                                requests_failed: requests_failed,
                              },
                            }
                        }
                    }
                }
            }
        }
    }
  }
}

fn encode_phase_deficit(phase: CallerWorkPhase) -> String {
  match phase {
    WorkWaiting => ""
    WorkCompleted => ""
    WorkCancelled => ""
    WorkRecoveryBoundExceeded { deficit: d } => encode_bound_deficit(deficit: d)
  }
}

fn waiting_phase_row_covers(row: WaitingPhaseWireRow, phase: CallerWorkPhase, deficit: String) -> Bool {
  match row.closed {
    Present { value: p } => p == phase
    Absent => deficit != ""
  }
}

fn encode_phase_from_rows(phase: CallerWorkPhase) -> String? {
  let deficit = encode_phase_deficit(phase: phase)
  if deficit != "" && !waiting_wire_field_is_clean(field: deficit) {
    none
  } else {
    match filter(waiting_phase_wire_rows, row => waiting_phase_row_covers(row: row, phase: phase, deficit: deficit)).first() {
      Absent => none
      Present { value: row } => Present { value: row.tag }
    }
  }
}

fn decode_phase_from_rows(tag: String, deficit: String) -> CallerWorkPhase? {
  match filter(waiting_phase_wire_rows, row => row.tag == tag).first() {
    Absent => none
    Present { value: row } =>
      match row.closed {
        Present { value: p } => if deficit == "" { Present { value: p } } else { none }
        Absent =>
          match decode_bound_deficit(s: deficit) {
            Absent => none
            Present { value: d } => Present { value: WorkRecoveryBoundExceeded { deficit: d } }
          }
      }
  }
}

fn encode_recovery_event_from_rows(event: RecoveryEvent) -> String? {
  match filter(waiting_recovery_wire_rows, row => row.event == event).first() {
    Absent => none
    Present { value: row } => Present { value: row.token }
  }
}

fn decode_recovery_event_from_rows(token: String) -> RecoveryEvent? {
  match filter(waiting_recovery_wire_rows, row => row.token == token).first() {
    Absent => none
    Present { value: row } => Present { value: row.event }
  }
}

fn encode_recovery_from_rows(events: List<RecoveryEvent>) -> String? {
  fold(
    events,
    init: Present { value: "" },
    f: (acc, event) =>
      match acc {
        Absent => none
        Present { value: so_far } =>
          match encode_recovery_event_from_rows(event: event) {
            Absent => none
            Present { value: token } =>
              if so_far == "" {
                Present { value: token }
              } else {
                Present { value: concat(concat(so_far, waiting_recovery_separator), token) }
              }
          }
      },
  )
}

fn decode_recovery_from_rows(s: String) -> List<RecoveryEvent>? {
  if s == "" {
    Present { value: [] as List<RecoveryEvent> }
  } else {
    fold(
      s.split(delimiter: waiting_recovery_separator),
      init: Present { value: [] as List<RecoveryEvent> },
      f: (acc, token) =>
        match acc {
          Absent => none
          Present { value: xs } =>
            match decode_recovery_event_from_rows(token: token) {
              Absent => none
              Present { value: event } => Present { value: concat(xs, [event]) }
            }
        },
    )
  }
}

type WaitingWire
  = WaitingWireEncoded { payload: NonEmptyStr }
  | WaitingWireUnencodable { reason: NonEmptyStr }

fn encode_waiting(record: CallerWorkRecord) -> WaitingWire {
  let work_s = record.work as String
  let reservation_s = record.reservation as String
  if !waiting_wire_field_is_clean(field: work_s) {
    WaitingWireUnencodable { reason: "logical work id is not a waiting-wire field" as NonEmptyStr }
  } else if !waiting_wire_field_is_clean(field: reservation_s) {
    WaitingWireUnencodable { reason: "reservation ref is not a waiting-wire field" as NonEmptyStr }
  } else {
    match waiting_generation_wire(generation: record.generation) {
      Absent => WaitingWireUnencodable { reason: "lease generation is not a waiting-wire field" as NonEmptyStr }
      Present { value: generation_s } =>
        match encode_phase_from_rows(phase: record.phase) {
          Absent => WaitingWireUnencodable { reason: "phase is not a waiting-wire production" as NonEmptyStr }
          Present { value: tag } =>
            match encode_recovery_from_rows(events: record.recovery) {
              Absent => WaitingWireUnencodable { reason: "recovery history is not a waiting-wire production" as NonEmptyStr }
              Present { value: recovery_s } =>
                WaitingWireEncoded {
                  payload: join([
                    work_s,
                    waiting_wire_separator,
                    reservation_s,
                    waiting_wire_separator,
                    generation_s,
                    waiting_wire_separator,
                    tag,
                    waiting_wire_separator,
                    encode_phase_deficit(phase: record.phase),
                    waiting_wire_separator,
                    recovery_s,
                  ], "") as NonEmptyStr,
                }
            }
        }
    }
  }
}

fn waiting_wire_part(parts: List<String>, n: Int) -> String? {
  parts.skip(n: n).first()
}

fn decode_waiting(payload: NonEmptyStr) -> CallerWorkRecord? {
  let parts = (payload as String).split(delimiter: waiting_wire_separator)
  if length(parts) != waiting_wire_field_count {
    none
  } else {
    match waiting_wire_part(parts: parts, n: 0) {
      Absent => none
      Present { value: work_s } =>
        match waiting_wire_part(parts: parts, n: 1) {
          Absent => none
          Present { value: reservation_s } =>
            match waiting_wire_part(parts: parts, n: 2) {
              Absent => none
              Present { value: generation_s } =>
                match waiting_wire_part(parts: parts, n: 3) {
                  Absent => none
                  Present { value: tag } =>
                    match waiting_wire_part(parts: parts, n: 4) {
                      Absent => none
                      Present { value: deficit } =>
                        match waiting_wire_part(parts: parts, n: 5) {
                          Absent => none
                          Present { value: recovery_s } =>
                            if !waiting_wire_field_is_clean(field: work_s) || !waiting_wire_field_is_clean(field: reservation_s) {
                              none
                            } else {
                              match parse_int(s: generation_s) {
                                Absent => none
                                Present { value: generation } =>
                                  match waiting_generation_wire(generation: generation) {
                                    Absent => none
                                    Present { value: gen_s } =>
                                      if gen_s != generation_s {
                                        none
                                      } else {
                                        match decode_phase_from_rows(tag: tag, deficit: deficit) {
                                          Absent => none
                                          Present { value: phase } =>
                                            match decode_recovery_from_rows(s: recovery_s) {
                                              Absent => none
                                              Present { value: recovery } =>
                                                Present {
                                                  value: CallerWorkRecord {
                                                    work: work_s as LogicalWorkId,
                                                    reservation: reservation_s as ReservationRef,
                                                    generation: generation,
                                                    phase: phase,
                                                    recovery: recovery,
                                                  },
                                                }
                                            }
                                        }
                                      }
                                  }
                              }
                            }
                        }
                    }
                }
            }
        }
    }
  }
}

type DurablePersistStanding
  = DurableWaitingPersisted { record: CallerWorkRecord }
  | DurablePhasePersisted { record: CallerWorkRecord }
  | DurablePersistIdempotent { record: CallerWorkRecord }
  | DurablePersistRefusedTerminal { phase: CallerWorkPhase }
  | DurablePersistStoreRefused { detail: NonEmptyStr }
  | DurablePersistKeyNotSlotAddressable { work: LogicalWorkId }
  | DurablePersistPayloadUnencodable { reason: NonEmptyStr }
  | DurablePersistUnknownWork
  | DurablePersistDuplicate

fn persist_waiting_on_store(root: NonEmptyStr, record: CallerWorkRecord) -> DurablePersistStanding
  admit_callers: [
    decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "persist_waiting_durable"),
    decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "persist_waiting_idempotent_on_store"),
  ]
{
  let key = record.work as NonEmptyStr
  match encode_waiting(record: record) {
    WaitingWireUnencodable { reason: reason } => DurablePersistPayloadUnencodable { reason: reason }
    WaitingWireEncoded { payload: payload } =>
      match admit_cas_attempt_for_derived_payload(key: key, expected: ExpectSlotAbsent, proposed: payload) {
        DerivedPayloadKeyNotSlotAddressable { key: _ } => DurablePersistKeyNotSlotAddressable { work: record.work }
        DerivedPayloadAdmitted { verified: v } =>
          match file_compare_and_set(root: root, publication: DefaultAccessCreateOnly, verified: v) {
            CasCommitted { committed: _ } => DurableWaitingPersisted { record: record }
            CasPreconditionFailed { expected: _, observed: observed } =>
              match observed {
                CasReadableAbsent => DurablePersistStoreRefused {
                  detail: "store reported the slot absent after refusing the write" as NonEmptyStr
                }
                CasReadablePresent { version: held } =>
                  if held.value == payload {
                    DurablePersistIdempotent { record: record }
                  } else {
                    DurablePersistStoreRefused { detail: "slot already holds a different record" as NonEmptyStr }
                  }
              }
            CasStoreRefused { cause: _ } => DurablePersistStoreRefused {
              detail: "file compare-and-set refused the persist" as NonEmptyStr
            }
          }
      }
  }
}

fn persist_waiting_idempotent_on_store(root: NonEmptyStr, record: CallerWorkRecord) -> DurablePersistStanding
  admit_callers: [
    decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "persist_waiting_durable"),
  ]
{
  let key = record.work as NonEmptyStr
  match encode_waiting(record: record) {
    WaitingWireUnencodable { reason: reason } => DurablePersistPayloadUnencodable { reason: reason }
    WaitingWireEncoded { payload: payload } =>
      if !cas_key_is_slot_addressable(key: key) {
        DurablePersistKeyNotSlotAddressable { work: record.work }
      } else {
        match observe_cas_slot_state(root: root, key: key) {
          CasObservedUnreadable { cause: c } => DurablePersistStoreRefused {
            detail: cas_unreadable_slot_detail(cause: c) as NonEmptyStr
          }
          CasObservedReadable { readable: readable } =>
            match readable {
              CasReadableAbsent => persist_waiting_on_store(root: root, record: record)
              CasReadablePresent { version: held } =>
                if held.value == payload {
                  DurablePersistIdempotent { record: record }
                } else {
                  DurablePersistStoreRefused { detail: "slot already holds a different record" as NonEmptyStr }
                }
            }
        }
      }
  }
}

type DurableSlotObservation
  = DurableSlotPresent { record: CallerWorkRecord, generation: CasGeneration }
  | DurableSlotAbsent
  | DurableSlotUnreadable { detail: NonEmptyStr }
  | DurableSlotUndecodable
  | DurableSlotWorkMismatch
  | DurableSlotKeyNotSlotAddressable { work: LogicalWorkId }

fn observe_durable_record(root: NonEmptyStr, work: LogicalWorkId) -> DurableSlotObservation {
  let key = work as NonEmptyStr
  if !cas_key_is_slot_addressable(key: key) {
    DurableSlotKeyNotSlotAddressable { work: work }
  } else {
    match observe_cas_slot_state(root: root, key: key) {
      CasObservedUnreadable { cause: c } => DurableSlotUnreadable {
        detail: cas_unreadable_slot_detail(cause: c) as NonEmptyStr
      }
      CasObservedReadable { readable: readable } =>
        match readable {
          CasReadableAbsent => DurableSlotAbsent
          CasReadablePresent { version: held } =>
            match decode_waiting(payload: held.value) {
              Absent => DurableSlotUndecodable
              Present { value: record } =>
                if logical_work_eq(a: record.work, b: work) {
                  DurableSlotPresent { record: record, generation: held.generation }
                } else {
                  DurableSlotWorkMismatch
                }
            }
        }
    }
  }
}

fn singleton_snapshot(record: CallerWorkRecord) -> CallerBacklogSnapshot {
  CallerBacklogSnapshot { records: [record] }
}

fn persist_derived_phase(
  root: NonEmptyStr,
  generation: CasGeneration,
  record: CallerWorkRecord,
) -> DurablePersistStanding
  admit_callers: [
    decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "cancel_work_durable"),
    decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "commit_attempt_durable"),
    decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "note_recovery_durable"),
  ]
{
  let key = record.work as NonEmptyStr
  match encode_waiting(record: record) {
    WaitingWireUnencodable { reason: reason } => DurablePersistPayloadUnencodable { reason: reason }
    WaitingWireEncoded { payload: payload } =>
      match admit_cas_attempt_for_derived_payload(
        key: key,
        expected: ExpectSlotGeneration { generation: generation },
        proposed: payload,
      ) {
        DerivedPayloadKeyNotSlotAddressable { key: _ } => DurablePersistKeyNotSlotAddressable { work: record.work }
        DerivedPayloadAdmitted { verified: v } =>
          match file_compare_and_set(root: root, publication: DefaultAccessCreateOnly, verified: v) {
            CasCommitted { committed: _ } => DurablePhasePersisted { record: record }
            CasPreconditionFailed { expected: _, observed: observed } =>
              match observed {
                CasReadableAbsent => DurablePersistStoreRefused {
                  detail: "store reported the slot absent after refusing the write" as NonEmptyStr
                }
                CasReadablePresent { version: held } =>
                  if held.value == payload {
                    DurablePersistIdempotent { record: record }
                  } else {
                    DurablePersistStoreRefused { detail: "slot already holds a different record" as NonEmptyStr }
                  }
              }
            CasStoreRefused { cause: _ } => DurablePersistStoreRefused {
              detail: "file compare-and-set refused the persist" as NonEmptyStr
            }
          }
      }
  }
}

fn persist_waiting_durable(
  root: NonEmptyStr,
  snapshot: CallerBacklogSnapshot,
  work: LogicalWorkId,
  reservation: ReservationRef,
  generation: Int,
) -> DurablePersistStanding {
  match persist_waiting(snapshot: snapshot, work: work, reservation: reservation, generation: generation) {
    WaitingPersisted { record: r } => persist_waiting_on_store(root: root, record: r)
    PersistIdempotent { record: r } => persist_waiting_idempotent_on_store(root: root, record: r)
    PersistRefusedTerminal { phase: p } => DurablePersistRefusedTerminal { phase: p }
    PersistRefusedDuplicate => DurablePersistDuplicate
  }
}

type DurableResumeStanding
  = DurableResumedWaiting { record: CallerWorkRecord }
  | DurableResumedTerminal { phase: CallerWorkPhase }
  | DurableResumeUnknownWork
  | DurableResumeStoreUnreadable { detail: NonEmptyStr }
  | DurableResumePayloadUndecodable
  | DurableResumeWorkMismatch

fn resume_standing_of(record: CallerWorkRecord) -> DurableResumeStanding {
  match record.phase {
    WorkWaiting => DurableResumedWaiting { record: record }
    WorkCompleted => DurableResumedTerminal { phase: record.phase }
    WorkCancelled => DurableResumedTerminal { phase: record.phase }
    WorkRecoveryBoundExceeded { deficit: _ } => DurableResumedTerminal { phase: record.phase }
  }
}

fn resume_waiting_durable(root: NonEmptyStr, work: LogicalWorkId) -> DurableResumeStanding {
  match observe_durable_record(root: root, work: work) {
    DurableSlotAbsent => DurableResumeUnknownWork
    DurableSlotUnreadable { detail: d } => DurableResumeStoreUnreadable { detail: d }
    DurableSlotUndecodable => DurableResumePayloadUndecodable
    DurableSlotWorkMismatch => DurableResumeWorkMismatch
    DurableSlotKeyNotSlotAddressable { work: _ } => DurableResumeStoreUnreadable {
      detail: "work id is not a slot-addressable CAS key" as NonEmptyStr
    }
    DurableSlotPresent { record: r, generation: _ } => resume_standing_of(record: r)
  }
}

// Ready supply oscillating (2 -> 0 -> 1 -> 2) does not expire a waiting turn and does not mint a
// new identity. apply_ready_supply_law is the transition: ExpireWaitingOnZeroSupply drops the
// waiting record at ready == 0; KeepWaitingAcrossZeroSupply is the admitted law and keeps it.
// offer_against_ready_supply is what a controller does with that reading: zero supply is not
// unpersisted work, it is waiting with no replica ready to take it.
type ReadyOffer
  = SupplyReady { record: CallerWorkRecord }
  | SupplyAbsentWaiting { record: CallerWorkRecord }
  | SupplyUnknownWork
  | SupplyTerminal { phase: CallerWorkPhase }
  | SupplyDuplicate

fn offer_against_ready_supply(
  snapshot: CallerBacklogSnapshot,
  work: LogicalWorkId,
  ready: Nat,
) -> ReadyOffer {
  match lookup_record(snapshot: snapshot, work: work) {
    CallerRecordAbsent => SupplyUnknownWork
    CallerRecordDuplicated => SupplyDuplicate
    CallerRecordFound { record: head } =>
      match head.phase {
        WorkWaiting =>
          if ready == 0 {
            SupplyAbsentWaiting { record: head }
          } else {
            SupplyReady { record: head }
          }
        WorkCompleted => SupplyTerminal { phase: head.phase }
        WorkCancelled => SupplyTerminal { phase: head.phase }
        WorkRecoveryBoundExceeded { deficit: _ } => SupplyTerminal { phase: head.phase }
      }
  }
}

type ReadySupplyLaw
  = KeepWaitingAcrossZeroSupply
  | ExpireWaitingOnZeroSupply

fn drop_record(snapshot: CallerBacklogSnapshot, work: LogicalWorkId) -> CallerBacklogSnapshot {
  CallerBacklogSnapshot {
    records: filter(snapshot.records, r => !logical_work_eq(a: r.work, b: work)),
  }
}

fn apply_ready_supply_law(
  law: ReadySupplyLaw,
  snapshot: CallerBacklogSnapshot,
  work: LogicalWorkId,
  ready: Nat,
) -> CallerBacklogSnapshot {
  match offer_against_ready_supply(snapshot: snapshot, work: work, ready: ready) {
    SupplyReady { record: _ } => snapshot
    SupplyAbsentWaiting { record: _ } =>
      match law {
        KeepWaitingAcrossZeroSupply => snapshot
        ExpireWaitingOnZeroSupply => drop_record(snapshot: snapshot, work: work)
      }
    SupplyUnknownWork => snapshot
    SupplyTerminal { phase: _ } => snapshot
    SupplyDuplicate => snapshot
  }
}

fn apply_ready_supply(
  snapshot: CallerBacklogSnapshot,
  work: LogicalWorkId,
  ready: Nat,
) -> CallerBacklogSnapshot {
  apply_ready_supply_law(law: KeepWaitingAcrossZeroSupply, snapshot: snapshot, work: work, ready: ready)
}

fn waiting_survives_ready_supply(
  snapshot: CallerBacklogSnapshot,
  work: LogicalWorkId,
  supplies: List<Nat>,
) -> ResumeStanding {
  let still = fold(supplies, init: snapshot, f: (acc, n) => apply_ready_supply(snapshot: acc, work: work, ready: n))
  resume_from_snapshot(snapshot: still, work: work)
}

type AttemptCommit
  = AttemptCommitted { record: CallerWorkRecord }
  | AttemptFenceRefused
  | AttemptNotWaiting { phase: CallerWorkPhase }
  | AttemptUnknownWork
  | AttemptDuplicate

// Attempt fencing is product.fabric.budget fence_admits over the grant's reservation and the
// generation the replica presents. A resumed old replica presenting a superseded generation
// cannot commit. Completing through this fold is recovered completion: the same logical work,
// the current generation, one terminal Completed phase — a second commit sees AttemptNotWaiting.
fn commit_attempt(
  snapshot: CallerBacklogSnapshot,
  account: MoneyAccount,
  work: LogicalWorkId,
  presented: Int,
) -> AttemptCommit {
  match lookup_record(snapshot: snapshot, work: work) {
    CallerRecordAbsent => AttemptUnknownWork
    CallerRecordDuplicated => AttemptDuplicate
    CallerRecordFound { record: head } =>
      match head.phase {
        WorkWaiting =>
          if !fence_admits(a: account, reference: head.reservation, presented: presented) {
            AttemptFenceRefused
          } else {
            AttemptCommitted {
              record: CallerWorkRecord {
                work: head.work,
                reservation: head.reservation,
                generation: presented,
                phase: WorkCompleted,
                recovery: head.recovery,
              },
            }
          }
        WorkCompleted => AttemptNotWaiting { phase: head.phase }
        WorkCancelled => AttemptNotWaiting { phase: head.phase }
        WorkRecoveryBoundExceeded { deficit: _ } => AttemptNotWaiting { phase: head.phase }
      }
  }
}

fn snapshot_after_commit(snapshot: CallerBacklogSnapshot, standing: AttemptCommit) -> CallerBacklogSnapshot {
  match standing {
    AttemptCommitted { record: r } => replace_record(snapshot: snapshot, next: r)
    AttemptFenceRefused => snapshot
    AttemptNotWaiting { phase: _ } => snapshot
    AttemptUnknownWork => snapshot
    AttemptDuplicate => snapshot
  }
}

type CancelStanding
  = CancelledWaiting { record: CallerWorkRecord }
  | CancelAlreadyTerminal { phase: CallerWorkPhase }
  | CancelUnknownWork
  | CancelDuplicate

fn cancel_work(snapshot: CallerBacklogSnapshot, work: LogicalWorkId) -> CancelStanding {
  match lookup_record(snapshot: snapshot, work: work) {
    CallerRecordAbsent => CancelUnknownWork
    CallerRecordDuplicated => CancelDuplicate
    CallerRecordFound { record: head } =>
      match head.phase {
        WorkWaiting =>
          CancelledWaiting {
            record: CallerWorkRecord {
              work: head.work,
              reservation: head.reservation,
              generation: head.generation,
              phase: WorkCancelled,
              recovery: head.recovery,
            },
          }
        WorkCompleted => CancelAlreadyTerminal { phase: head.phase }
        WorkCancelled => CancelAlreadyTerminal { phase: head.phase }
        WorkRecoveryBoundExceeded { deficit: _ } => CancelAlreadyTerminal { phase: head.phase }
      }
  }
}

fn snapshot_after_cancel(snapshot: CallerBacklogSnapshot, standing: CancelStanding) -> CallerBacklogSnapshot {
  match standing {
    CancelledWaiting { record: r } => replace_record(snapshot: snapshot, next: r)
    CancelAlreadyTerminal { phase: _ } => snapshot
    CancelUnknownWork => snapshot
    CancelDuplicate => snapshot
  }
}

type DurableCancelStanding
  = DurableCancelled { record: CallerWorkRecord }
  | DurableCancelAlreadyTerminal { phase: CallerWorkPhase }
  | DurableCancelUnknownWork
  | DurableCancelStoreRefused { detail: NonEmptyStr }
  | DurableCancelKeyNotSlotAddressable { work: LogicalWorkId }

fn cancel_work_durable(
  root: NonEmptyStr,
  snapshot: CallerBacklogSnapshot,
  work: LogicalWorkId,
) -> DurableCancelStanding {
  match observe_durable_record(root: root, work: work) {
    DurableSlotAbsent => DurableCancelUnknownWork
    DurableSlotUnreadable { detail: d } => DurableCancelStoreRefused { detail: d }
    DurableSlotUndecodable => DurableCancelStoreRefused {
      detail: "slot payload is not a waiting record" as NonEmptyStr
    }
    DurableSlotWorkMismatch => DurableCancelStoreRefused {
      detail: "slot payload names different work" as NonEmptyStr
    }
    DurableSlotKeyNotSlotAddressable { work: w } => DurableCancelKeyNotSlotAddressable { work: w }
    DurableSlotPresent { record: held, generation: g } =>
      match cancel_work(snapshot: singleton_snapshot(record: held), work: work) {
        CancelUnknownWork => DurableCancelUnknownWork
        CancelDuplicate => DurableCancelStoreRefused {
          detail: "snapshot has duplicate records for this work" as NonEmptyStr
        }
        CancelAlreadyTerminal { phase: p } => DurableCancelAlreadyTerminal { phase: p }
        CancelledWaiting { record: next } =>
          match persist_derived_phase(root: root, generation: g, record: next) {
            DurablePhasePersisted { record: stored } => DurableCancelled { record: stored }
            DurablePersistIdempotent { record: stored } => DurableCancelled { record: stored }
            DurableWaitingPersisted { record: stored } => DurableCancelled { record: stored }
            DurablePersistRefusedTerminal { phase: p } => DurableCancelAlreadyTerminal { phase: p }
            DurablePersistStoreRefused { detail: d } => DurableCancelStoreRefused { detail: d }
            DurablePersistKeyNotSlotAddressable { work: w } => DurableCancelKeyNotSlotAddressable { work: w }
            DurablePersistPayloadUnencodable { reason: r } => DurableCancelStoreRefused { detail: r }
            DurablePersistUnknownWork => DurableCancelUnknownWork
            DurablePersistDuplicate => DurableCancelStoreRefused {
              detail: "snapshot has duplicate records for this work" as NonEmptyStr
            }
          }
      }
  }
}

type DurableAttemptStanding
  = DurableAttemptCommitted { record: CallerWorkRecord }
  | DurableAttemptFenceRefused
  | DurableAttemptNotWaiting { phase: CallerWorkPhase }
  | DurableAttemptUnknownWork
  | DurableAttemptStoreRefused { detail: NonEmptyStr }
  | DurableAttemptKeyNotSlotAddressable { work: LogicalWorkId }

fn commit_attempt_durable(
  root: NonEmptyStr,
  snapshot: CallerBacklogSnapshot,
  account: MoneyAccount,
  work: LogicalWorkId,
  presented: Int,
) -> DurableAttemptStanding {
  match observe_durable_record(root: root, work: work) {
    DurableSlotAbsent => DurableAttemptUnknownWork
    DurableSlotUnreadable { detail: d } => DurableAttemptStoreRefused { detail: d }
    DurableSlotUndecodable => DurableAttemptStoreRefused {
      detail: "slot payload is not a waiting record" as NonEmptyStr
    }
    DurableSlotWorkMismatch => DurableAttemptStoreRefused {
      detail: "slot payload names different work" as NonEmptyStr
    }
    DurableSlotKeyNotSlotAddressable { work: w } => DurableAttemptKeyNotSlotAddressable { work: w }
    DurableSlotPresent { record: held, generation: g } =>
      match commit_attempt(
        snapshot: singleton_snapshot(record: held),
        account: account,
        work: work,
        presented: presented,
      ) {
        AttemptUnknownWork => DurableAttemptUnknownWork
        AttemptDuplicate => DurableAttemptStoreRefused {
          detail: "snapshot has duplicate records for this work" as NonEmptyStr
        }
        AttemptFenceRefused => DurableAttemptFenceRefused
        AttemptNotWaiting { phase: p } => DurableAttemptNotWaiting { phase: p }
        AttemptCommitted { record: next } =>
          match persist_derived_phase(root: root, generation: g, record: next) {
            DurablePhasePersisted { record: stored } => DurableAttemptCommitted { record: stored }
            DurablePersistIdempotent { record: stored } => DurableAttemptCommitted { record: stored }
            DurableWaitingPersisted { record: stored } => DurableAttemptCommitted { record: stored }
            DurablePersistRefusedTerminal { phase: p } => DurableAttemptNotWaiting { phase: p }
            DurablePersistStoreRefused { detail: d } => DurableAttemptStoreRefused { detail: d }
            DurablePersistKeyNotSlotAddressable { work: w } => DurableAttemptKeyNotSlotAddressable { work: w }
            DurablePersistPayloadUnencodable { reason: r } => DurableAttemptStoreRefused { detail: r }
            DurablePersistUnknownWork => DurableAttemptUnknownWork
            DurablePersistDuplicate => DurableAttemptStoreRefused {
              detail: "snapshot has duplicate records for this work" as NonEmptyStr
            }
          }
      }
  }
}

fn is_failed_request(event: RecoveryEvent) -> Bool {
  event.kind == RecoveryRequest && !event.succeeded
}

fn recovery_event_count(events: List<RecoveryEvent>, pred: fn(RecoveryEvent) -> Bool) -> Nat {
  fold(filter(events, pred), init: Zero, f: (acc, _) => Succ { prev: acc })
}

fn recovery_bound_deficit(events: List<RecoveryEvent>) -> RecoveryBoundDeficit {
  RecoveryBoundDeficit {
    probes_succeeded: recovery_event_count(events: events, pred: e => e.kind == RecoveryProbe && e.succeeded),
    requests_failed: recovery_event_count(events: events, pred: e => is_failed_request(event: e)),
  }
}

fn recovery_deficit_text(deficit: RecoveryBoundDeficit) -> NonEmptyStr {
  join([
    "recovery bound exhausted across the logical work's whole history; probes succeeded: ",
    to_string(deficit.probes_succeeded as Int),
    "; requests failed: ",
    to_string(deficit.requests_failed as Int),
    "; probe success is not a request completion and does not reset the bound",
  ], "") as NonEmptyStr
}

type RecoveryStanding
  = RecoveryNoted { record: CallerWorkRecord }
  | RecoveryBoundExceeded { record: CallerWorkRecord }
  | RecoveryUnknownWork
  | RecoveryAlreadyTerminal { phase: CallerWorkPhase }
  | RecoveryDuplicate

fn note_recovery(
  snapshot: CallerBacklogSnapshot,
  work: LogicalWorkId,
  event: RecoveryEvent,
  bound: Nat,
) -> RecoveryStanding {
  match lookup_record(snapshot: snapshot, work: work) {
    CallerRecordAbsent => RecoveryUnknownWork
    CallerRecordDuplicated => RecoveryDuplicate
    CallerRecordFound { record: head } =>
      match head.phase {
        WorkWaiting => {
          let next_events = concat(head.recovery, [event])
          let next_phase = if length(next_events) >= bound && is_failed_request(event: event) {
            WorkRecoveryBoundExceeded { deficit: recovery_bound_deficit(events: next_events) }
          } else {
            WorkWaiting
          }
          let next = CallerWorkRecord {
            work: head.work,
            reservation: head.reservation,
            generation: head.generation,
            phase: next_phase,
            recovery: next_events,
          }
          match next_phase {
            WorkRecoveryBoundExceeded { deficit: _ } => RecoveryBoundExceeded { record: next }
            WorkWaiting => RecoveryNoted { record: next }
            WorkCompleted => RecoveryNoted { record: next }
            WorkCancelled => RecoveryNoted { record: next }
          }
        }
        WorkCompleted => RecoveryAlreadyTerminal { phase: head.phase }
        WorkCancelled => RecoveryAlreadyTerminal { phase: head.phase }
        WorkRecoveryBoundExceeded { deficit: _ } => RecoveryAlreadyTerminal { phase: head.phase }
      }
  }
}

fn snapshot_after_recovery(snapshot: CallerBacklogSnapshot, standing: RecoveryStanding) -> CallerBacklogSnapshot {
  match standing {
    RecoveryNoted { record: r } => replace_record(snapshot: snapshot, next: r)
    RecoveryBoundExceeded { record: r } => replace_record(snapshot: snapshot, next: r)
    RecoveryUnknownWork => snapshot
    RecoveryAlreadyTerminal { phase: _ } => snapshot
    RecoveryDuplicate => snapshot
  }
}

fn note_recovery_durable(
  root: NonEmptyStr,
  snapshot: CallerBacklogSnapshot,
  work: LogicalWorkId,
  event: RecoveryEvent,
  bound: Nat,
) -> DurablePersistStanding {
  match observe_durable_record(root: root, work: work) {
    DurableSlotAbsent => DurablePersistUnknownWork
    DurableSlotUnreadable { detail: d } => DurablePersistStoreRefused { detail: d }
    DurableSlotUndecodable => DurablePersistStoreRefused {
      detail: "slot payload is not a waiting record" as NonEmptyStr
    }
    DurableSlotWorkMismatch => DurablePersistStoreRefused {
      detail: "slot payload names different work" as NonEmptyStr
    }
    DurableSlotKeyNotSlotAddressable { work: w } => DurablePersistKeyNotSlotAddressable { work: w }
    DurableSlotPresent { record: held, generation: g } =>
      match note_recovery(
        snapshot: singleton_snapshot(record: held),
        work: work,
        event: event,
        bound: bound,
      ) {
        RecoveryUnknownWork => DurablePersistUnknownWork
        RecoveryDuplicate => DurablePersistDuplicate
        RecoveryAlreadyTerminal { phase: p } => DurablePersistRefusedTerminal { phase: p }
        RecoveryNoted { record: next } => persist_derived_phase(root: root, generation: g, record: next)
        RecoveryBoundExceeded { record: next } => persist_derived_phase(root: root, generation: g, record: next)
      }
  }
}

// Retriability is a typed arm, not a shared process-exit status. Waiting work comes back;
// cancellation, completion, and a surfaced recovery deficit are terminal.
type CallerRetryDisposition
  = RetryComeBack { work: LogicalWorkId }
  | RetryTerminal { work: LogicalWorkId, cause: NonEmptyStr }

fn caller_retry_disposition(record: CallerWorkRecord) -> CallerRetryDisposition {
  match record.phase {
    WorkWaiting => RetryComeBack { work: record.work }
    WorkCompleted => RetryTerminal { work: record.work, cause: "logical work already completed" as NonEmptyStr }
    WorkCancelled => RetryTerminal { work: record.work, cause: "cancellation is terminal" as NonEmptyStr }
    WorkRecoveryBoundExceeded { deficit: d } => RetryTerminal { work: record.work, cause: recovery_deficit_text(deficit: d) }
  }
}

data persist_before_offer_basis_ref: DeclarationRef = decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "persist_waiting_durable")
data retriable_refusal_basis_ref: DeclarationRef = decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "caller_retry_disposition")
data stable_turn_identity_basis_ref: DeclarationRef = decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "resume_waiting_durable")
data idempotent_retry_basis_ref: DeclarationRef = decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "persist_waiting_durable")
data no_expiry_on_long_wait_basis_ref: DeclarationRef = decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "apply_ready_supply_law")
data durable_cancellation_basis_ref: DeclarationRef = decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "cancel_work_durable")
data no_double_execution_basis_ref: DeclarationRef = decl_ref(module_path: "gunbc.serving.caller_backlog", decl_name: "commit_attempt_durable")

data persist_before_offer_basis: NonEmptyStr = declaration_ref_display_key(ref: persist_before_offer_basis_ref) as NonEmptyStr
data retriable_refusal_basis: NonEmptyStr = declaration_ref_display_key(ref: retriable_refusal_basis_ref) as NonEmptyStr
data stable_turn_identity_basis: NonEmptyStr = declaration_ref_display_key(ref: stable_turn_identity_basis_ref) as NonEmptyStr
data idempotent_retry_basis: NonEmptyStr = declaration_ref_display_key(ref: idempotent_retry_basis_ref) as NonEmptyStr
data no_expiry_on_long_wait_basis: NonEmptyStr = declaration_ref_display_key(ref: no_expiry_on_long_wait_basis_ref) as NonEmptyStr
data durable_cancellation_basis: NonEmptyStr = declaration_ref_display_key(ref: durable_cancellation_basis_ref) as NonEmptyStr
data no_double_execution_basis: NonEmptyStr = declaration_ref_display_key(ref: no_double_execution_basis_ref) as NonEmptyStr

data caller_backlog_basis_refs: List<DeclarationRef> = [
  persist_before_offer_basis_ref,
  retriable_refusal_basis_ref,
  stable_turn_identity_basis_ref,
  idempotent_retry_basis_ref,
  no_expiry_on_long_wait_basis_ref,
  durable_cancellation_basis_ref,
  no_double_execution_basis_ref,
]
