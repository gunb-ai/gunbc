module gunbc.routed_entry_closure_membership_seed_growth

import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// FORWARD-FREEZE RECEIPT for the routed-entry closure membership projection. A long wet dispatch
// was protected by naming its 19 visible route files while the resolver's actual per-entry subject
// held substantially more transitive modules. Its semantic digest could report that the hold was
// broken only after the dispatch, and its module count could not identify the member that moved.
// resolved_closure_members retains the exact population resolve_entry_with_index already returned;
// it neither scans imports nor resolves a second time. claim_batch consumes it on every entry
// resolve and prints module identity beside repository-relative source path, so a prospective
// writer can compare its path before starting the long execution.
data routed_entry_closure_membership_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "resolved_closure_members", field: WholeDeclaration }
  ],
  reason: "WHY RUST IS STILL NEEDED: claim_batch is the seed-host route that owns entry resolution and emits progress before a .dag evaluation frame exists. resolved_closure_members adds no closure semantics: it projects ResolvedGraph.modules, the resolver's already-computed authority, into stable module-and-source-path rows. The consumer is claim_batch resolve_timed, including the v2 self-host wet route whose long-lived semantic subject must be checkable before dispatch rather than only rejected after a digest mismatch.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete resolved_closure_members and this row when routed-entry closure membership is available from the modeled execution route before dispatch, including module identity and repository-relative source path derived from the same resolved subject rather than a second closure computation.",
  current_boundary: "Only claim_batch entry resolution prints this population. It prints after a successful resolve and before witness evaluation; a resolution refusal prints no fabricated partial membership. The membership identifies which source files are in the subject, while closure_content_digest still hashes each member's raw content, so any byte change in one -- including annotation prose -- moves the current semantic digest."
}
