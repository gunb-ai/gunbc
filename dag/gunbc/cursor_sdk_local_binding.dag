module gunbc.cursor_sdk_local_binding


data cursor_sdk_local_binding_note: String = "Slice-E bridge only — no live wiring. Maps dispatch CursorCredentialRef to SDK-local credential materialization. API key flows INTO the SDK call via SecretRef, never argv. CursorLocalLoginRef refuses because interactive login is not the SDK automation path."

type CursorSdkLocalCredentialAdmission
  = CursorSdkLocalCredentialAdmitted {
      credential: extdeps.llm.cursor_sdk.CursorSdkLocalCredential
      materialization: extdeps.llm.cursor_sdk.CursorSdkApiKeyMaterialization
    }
  | CursorSdkLocalCredentialRefused { reason: std.types.NonEmptyStr }

fn cursor_sdk_local_credential_from_dispatch(
  credential: gunbc.dispatch_selection.CursorCredentialRef,
) -> CursorSdkLocalCredentialAdmission {
  match credential {
    gunbc.dispatch_selection.CursorApiKeySecretRef { secret_ref: ref } =>
      match gunbc.cursor_sdk_secret_admission.cursor_sdk_admit_exact_secret_ref_version(ref: ref) {
        gunbc.cursor_sdk_secret_admission.CursorSdkSecretRefVersionRefused { reason } =>
          CursorSdkLocalCredentialRefused { reason: reason }
        gunbc.cursor_sdk_secret_admission.CursorSdkSecretRefVersionAdmitted { secret_ref: admitted_ref } => {
          let local = extdeps.llm.cursor_sdk.CursorSdkApiKeySecretRef { secret_ref: admitted_ref }
          CursorSdkLocalCredentialAdmitted {
            credential: local,
            materialization: extdeps.llm.cursor_sdk.cursor_sdk_materialize_api_key(credential: local),
          }
        }
      }
    gunbc.dispatch_selection.CursorLocalLoginRef =>
      CursorSdkLocalCredentialRefused {
        reason: "Cursor SDK local automation requires CursorApiKeySecretRef, not interactive login" as std.types.NonEmptyStr,
      }
  }
}

fn cursor_sdk_local_usage_standing() -> extdeps.llm.cursor_sdk_facts.CursorSdkLocalAccountUsageUnobservable {
  extdeps.llm.cursor_sdk_facts.cursor_sdk_local_account_usage_unobservable()
}

fn cursor_sdk_materialization_uses_secret_ref(
  materialization: extdeps.llm.cursor_sdk.CursorSdkApiKeyMaterialization,
) -> Bool {
  match materialization {
    extdeps.llm.cursor_sdk.CursorSdkApiKeyFromSecretRef { secret_ref: _ } => true
    extdeps.llm.cursor_sdk.CursorSdkApiKeyFromEnvironment { env_var: _ } => false
  }
}
