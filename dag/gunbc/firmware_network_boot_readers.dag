module gunbc.firmware_network_boot_readers

import std.types { Bool, HttpStatus, List, list_length, NonEmptyStr, String }
import std.algebra { list_map, list_flat_map }
import std.optional { Present, Absent }
import std.goal_assessment { ObservationEstablished, ObservationRefused }
import extdeps.bmc.redfish_memory_inventory { redfish_document, redfish_collection_page_of }
import extdeps.languages.json.emit { JsonValue }
import extdeps.languages.json.parse { FieldAbsent, FieldRead, FieldMalformed, json_field, json_field_string, json_field_bool, json_field_string_list }
import gunbc.firmware_network_boot_standing { boot_order_entry, FirmwareReadRefusal, VendorCommandRejected, ResourceNotFound, AuthenticationRequired, ReplyShapeUnrecognized }
import gunbc.firmware_network_boot_probe {
  AxisReply, ObservationAxis, BootOrderAxis, NicsAxis, SecureBootAxis, BiosVersionAxis,
  ReplyBootOrder, ReplyNics, ReplySecureBootEnabled, ReplySecureBootDisabled, ReplyBiosVersion, ReplyRefusedByBmc, ReplyBeyondDecoder,
}

// THE REDFISH READERS FOR THE FIRMWARE NETWORK-BOOT PROBE: the obligor of the frontier that
// gunbc.firmware_network_boot_probe names as `firmware_boot_axis_reader_ref` (this module,
// redfish_axis_replies). The probe takes decoded AxisReply values and writes no wire protocol;
// this module is the decode from what a BMC's Redfish service answered to those values.
//
// READ-ONLY BY CONSTRUCTION. The input is the RESULT of GETs already performed (RedfishGet), so
// nothing here has a request, a method or a target to mutate; a write would be a different
// module with its own admission.
//
// ONE DECODER FOR BOTH FAMILIES. AMI MegaRAC and OpenBMC (bmcweb) both publish DMTF's
// ComputerSystem, SecureBoot and EthernetInterfaces resources; the family differences are which
// resources answer, and that is already the probe's per-row coverage. A resource a family does
// not serve arrives as RedfishGetStatus 404 and becomes a ResourceNotFound refusal for exactly
// its axes, so no match here is on a family.
//
// WHAT THE FIXTURES ARE NOT (DESIGN 4d). No captured MegaRAC or OpenBMC ComputerSystem body for
// these axes is in this corpus, so the witness bodies are DMTF-schema-shaped, not observations.
// The decoder claims the schema; a real capture is a separate receipt in the observing layer.
//
// NO KIND IS GUESSED. BootOrder entries carry a reference and no kind (standing's ruling); the
// BootOptions axis, where a kind lives, is not read here and the rows declare it unanswerable. An empty
// list is likewise a refusal and never an Observed empty list.

type RedfishGet
  = RedfishGetBody { body: String }
  | RedfishGetStatus { status: HttpStatus, detail: NonEmptyStr }

// The GETs a probe performs: the ComputerSystem, its SecureBoot resource and its
// EthernetInterfaces collection, each as the service answered.
type RedfishBootReads {
  system: RedfishGet
  secure_boot: RedfishGet
  nics: RedfishGet
}

type RedfishDocRead
  = RedfishDocParsed { doc: JsonValue }
  | RedfishDocRefused { refusal: FirmwareReadRefusal }

// The status is std.types HttpStatus; a caller holding a raw Int admits it with http_status_of and
// handles the Absent arm there. extdeps.ietf.http_semantics classifies statuses but names no codes,
// so 401 and 404 are compared as RFC 9110 section 15 literals here.
// 401 is the only status that means credentials must be established. A 403 means credentials were
// accepted and the account lacks the privilege, a different remedy (a role grant), and the standing
// module has no arm for it, so it is VendorCommandRejected carrying the service's own detail.
fn redfish_status_refusal(status: HttpStatus, detail: NonEmptyStr) -> FirmwareReadRefusal {
  if status == 401 { AuthenticationRequired { detail: detail } }
  else if status == 404 { ResourceNotFound { detail: detail } }
  else { VendorCommandRejected { detail: detail } }
}

fn shape_refusal(detail: String) -> FirmwareReadRefusal {
  ReplyShapeUnrecognized { detail: detail as NonEmptyStr }
}

fn read_doc(get: RedfishGet) -> RedfishDocRead {
  match get {
    RedfishGetStatus { status: s, detail: d } => RedfishDocRefused { refusal: redfish_status_refusal(status: s, detail: d) }
    RedfishGetBody { body: b } =>
      match redfish_document(body: b) {
        ObservationEstablished { observed: d } => RedfishDocParsed { doc: d }
        ObservationRefused { cause: c } => RedfishDocRefused { refusal: ReplyShapeUnrecognized { detail: c } }
      }
  }
}

fn refused_axis(axis: ObservationAxis, refusal: FirmwareReadRefusal) -> AxisReply {
  ReplyRefusedByBmc { axis: axis, refusal: refusal }
}

// BootOrder is the ComputerSystem's `Boot.BootOrder`: an ordered list of BootOptionReference strings,
// and nothing else. A BootOrderEntry therefore carries a reference and a label and NO KIND (the
// standing module's own ruling), so no classification happens here; the reference is the entry's
// identity and, with no DisplayName in this resource, also the label (data, never consulted).
// An empty list, a non-string member or an empty reference refuses the axis.
fn boot_order_reply(system: RedfishDocRead) -> AxisReply {
  match system {
    RedfishDocRefused { refusal: r } => refused_axis(axis: BootOrderAxis, refusal: r)
    RedfishDocParsed { doc: d } =>
      match json_field(obj: d, key: "Boot") {
        FieldAbsent => refused_axis(axis: BootOrderAxis, refusal: shape_refusal(detail: "the ComputerSystem carries no Boot object, so BootOrder is not published"))
        FieldMalformed { cause: c } => refused_axis(axis: BootOrderAxis, refusal: shape_refusal(detail: c))
        FieldRead { value: boot } =>
          match json_field_string_list(obj: boot, key: "BootOrder") {
            FieldAbsent => refused_axis(axis: BootOrderAxis, refusal: shape_refusal(detail: "Boot carries no BootOrder"))
            FieldMalformed { cause: c } => refused_axis(axis: BootOrderAxis, refusal: shape_refusal(detail: c))
            FieldRead { value: refs } =>
              if refs == [] { refused_axis(axis: BootOrderAxis, refusal: shape_refusal(detail: "BootOrder is empty; an empty list is not read as no boot entries")) }
              else if list_length(items: list_flat_map(xs: refs, f: fn(r) { if r == "" { [r] } else { [] } })) > 0 { refused_axis(axis: BootOrderAxis, refusal: shape_refusal(detail: "a BootOrder member is the empty string")) }
              else { ReplyBootOrder { devices: list_map(xs: refs, f: fn(r) { boot_order_entry(reference: r as NonEmptyStr, label: r as NonEmptyStr) }) } }
          }
      }
  }
}

fn bios_version_reply(system: RedfishDocRead) -> AxisReply {
  match system {
    RedfishDocRefused { refusal: r } => refused_axis(axis: BiosVersionAxis, refusal: r)
    RedfishDocParsed { doc: d } =>
      match json_field_string(obj: d, key: "BiosVersion") {
        FieldAbsent => refused_axis(axis: BiosVersionAxis, refusal: shape_refusal(detail: "the ComputerSystem carries no BiosVersion"))
        FieldMalformed { cause: c } => refused_axis(axis: BiosVersionAxis, refusal: shape_refusal(detail: c))
        FieldRead { value: v } =>
          if v == "" { refused_axis(axis: BiosVersionAxis, refusal: shape_refusal(detail: "BiosVersion is the empty string")) }
          else { ReplyBiosVersion { version: v as NonEmptyStr } }
      }
  }
}

fn secure_boot_reply(get: RedfishGet) -> AxisReply {
  match read_doc(get: get) {
    RedfishDocRefused { refusal: r } => refused_axis(axis: SecureBootAxis, refusal: r)
    RedfishDocParsed { doc: d } =>
      match json_field_bool(obj: d, key: "SecureBootEnable") {
        FieldAbsent => refused_axis(axis: SecureBootAxis, refusal: shape_refusal(detail: "the SecureBoot resource carries no SecureBootEnable"))
        FieldMalformed { cause: c } => refused_axis(axis: SecureBootAxis, refusal: shape_refusal(detail: c))
        FieldRead { value: on } => if on { ReplySecureBootEnabled } else { ReplySecureBootDisabled }
      }
  }
}

// The interfaces are the collection's member links exactly as published. A collection that is
// empty or continues on another page cannot say which interfaces exist, so both refuse.
fn nics_reply(get: RedfishGet) -> AxisReply {
  match get {
    RedfishGetStatus { status: s, detail: d } => refused_axis(axis: NicsAxis, refusal: redfish_status_refusal(status: s, detail: d))
    RedfishGetBody { body: b } =>
      match redfish_collection_page_of(body: b) {
        ObservationRefused { cause: c } => refused_axis(axis: NicsAxis, refusal: ReplyShapeUnrecognized { detail: c })
        ObservationEstablished { observed: page } =>
          match page.next_link {
            Present { value: _ } => ReplyBeyondDecoder { axis: NicsAxis, why: "the EthernetInterfaces collection continues on another page and this decoder does not follow next links, so the NICs are not observed" }
            Absent =>
              if page.member_links == [] { refused_axis(axis: NicsAxis, refusal: shape_refusal(detail: "the EthernetInterfaces collection has no members; an empty list is not read as no NICs")) }
              else if list_length(items: list_flat_map(xs: page.member_links, f: fn(l) { if l == "" { [l] } else { [] } })) > 0 { refused_axis(axis: NicsAxis, refusal: shape_refusal(detail: "an EthernetInterfaces member link is the empty string")) }
              else { ReplyNics { nics: list_map(xs: page.member_links, f: fn(l) { l as NonEmptyStr }) } }
          }
      }
  }
}

// One reply per axis this decoder reads, always four: BootOrder, NICs, SecureBoot and BIOS version.
// BootOptions has no reply because no decoder reads it; the probe's rows say so as TransportCannotAnswer,
// so the gap is stated by us and never attributed to the BMC.
fn redfish_axis_replies(reads: RedfishBootReads) -> List<AxisReply> {
  let system = read_doc(get: reads.system)
  [
    boot_order_reply(system: system),
    nics_reply(get: reads.nics),
    secure_boot_reply(get: reads.secure_boot),
    bios_version_reply(system: system),
  ]
}
