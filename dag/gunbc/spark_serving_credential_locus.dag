module gunbc.spark_serving_credential_locus

data spark_serving_credential_locus_note: String = "THE TWO CREDENTIAL LOCI A SPARK-DIRECTED ENTRY CAN RUN UNDER. Extracted to its own module so the converge slice and the serving observation can both name the same distinction without one importing the other. AnchoredContext is the operator-workstation route: unconstructible without a context whose anchor passed a content readback, reaching the Spark over FleetSsh. RunnerAgent is the GHA self-hosted route: those hosts carry no gcloud, so the Secret Manager fetch behind AnchoredContext fails at runtime there (spark_credential_workflow spark_credential_access_token_frontier_note), and the key instead lives in the in-run ssh-agent the job materialized. RunnerAgent therefore carries NO trust facts of its own; the job establishes them out of band, exactly as the enrolled fleet_multi_principal_probe_wet does. Naming the locus in a receipt is what lets a reader tell which preconditions a run actually held instead of inferring them from a function name."

type SparkServingSliceCredentialLocus =
    SparkServingSliceAnchoredContext { context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext }
  | SparkServingSliceRunnerAgent

fn spark_serving_locus_ssh_target(host: product.placement_supply.HostIdentity) -> gunbc.fleet_known_hosts_anchor.SshTarget {
  gunbc.fleet_known_hosts_anchor.SshTarget {
    endpoint: gunbc.fleet_reach_endpoint.fleet_probe_endpoint_for(host: host as String) as std.types.NonEmptyStr,
    principal: gunbc.spark_serving_desired.spark_serving_automation_principal_login(),
  }
}

fn spark_serving_slice_transport(
  locus: SparkServingSliceCredentialLocus,
  host: product.placement_supply.HostIdentity,
) -> gunbc.host_effect.HostEffectTransport {
  match locus {
    SparkServingSliceAnchoredContext { context: c } =>
      gunbc.host_effect.FleetSsh { target: spark_serving_locus_ssh_target(host: host), context: c }
    SparkServingSliceRunnerAgent =>
      gunbc.host_effect.SshShell {
        ssh_host: join([
          gunbc.spark_serving_desired.spark_serving_automation_principal_login() as String,
          "@",
          gunbc.fleet_reach_endpoint.fleet_probe_endpoint_for(host: host as String),
        ], "") as std.types.NonEmptyStr,
      }
  }
}

fn spark_serving_slice_locus_label(locus: SparkServingSliceCredentialLocus) -> String {
  match locus {
    SparkServingSliceAnchoredContext { context: _ } => "anchored-fleet-ssh-context"
    SparkServingSliceRunnerAgent => "runner-in-run-ssh-agent"
  }
}
