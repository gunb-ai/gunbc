module gunbc.fleet_intent_network

import product.network_topology {
  NetworkAttachmentRole,
  NetworkEndpoint,
  NetworkSegment,
  NetworkTopology,
  HostOperatingSystem,
  BmcOutOfBand,
  ContainerBridgeDefault,
  ContainerBridgeSecondary,
  TailscaleEndpoint,
  LanGateway,
  Lan,
  DockerBridge,
  TailscaleOverlay,
}
import product.placement_supply { HostIdentity }

data operator_host_srv1: HostIdentity = "srv1"
data operator_host_srv2: HostIdentity = "srv2"
data operator_host_srv3: HostIdentity = "srv3"
data operator_host_srv4: HostIdentity = "srv4"

data network_endpoint_address_grounding_residual_note: String = "🟡 dissolve-on: the NetworkEndpoint.address / NetworkSegment.cidr / gateway literals in this file are still bare `\"192.168.1.x\"` / CIDR strings even though this same lane grounded the address leaves (extdeps.network.ipv4 Ipv4Address = 4 bounded Octets, extdeps.network.address IpAddress = IpV4|IpV6, and the DHCP lease rows migrated to the ipv4_address constructor). The octet decomposition is half-consumed here: product.network_topology.NetworkEndpoint.address is typed String, so grounding these sites means re-typing that field to extdeps.network.address.IpAddress (and cidr/gateway to their grounded carriers) and migrating every NetworkEndpoint/NetworkSegment consumer — a product-layer field change, not a gunbc-local edit, so it is deliberately deferred rather than half-done. DISSOLVES WHEN NetworkEndpoint.address re-grounds onto IpAddress; until then these literals are the §3 residual the reach lane closes, tracked here so the loop is visible rather than silently forked."

data operator_lan_segment: NetworkSegment = NetworkSegment {
  cidr: "192.168.1.0/24",
  gateway: Present { value: "192.168.1.1" },
  locality: Lan,
}

