  ClassifiedNonVerdictRow {
    identity: non_verdict_row_identity(module_path: "test.claim.host_phase_status", function: "witness_reconcile_covers_upsert_teardown_and_noop"),
    cause: Unmeasured { obstacle: host_phase_unmeasured_note },
    standing: StandingUnmeasured,
    measured_evidence: "no small-closure arm exists: claim_batch refuses the narrow run with `no declaration named host_phase_reconcile in this execution's loaded index`"
  },
  ClassifiedNonVerdictRow {
    identity: non_verdict_row_identity(module_path: "test.claim.host_phase_status", function: "witness_remaining_work_counts_every_unfinished_cell"),
    cause: Unmeasured { obstacle: host_phase_unmeasured_note },
    standing: StandingUnmeasured,
