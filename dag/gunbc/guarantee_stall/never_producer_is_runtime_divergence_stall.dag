module gunbc.guarantee_stall.never_producer_is_runtime_divergence_stall

import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.guarantee_stall { GuaranteeStall, AwaitsOneGrounding, BoundedPopulation, climbs_when }

data never_producer_is_runtime_divergence_stall: GuaranteeStall = GuaranteeStall {
  subject: "std.error_primitives never() mints Never from no proof; absurd(never()) sites are runtime divergence, not a bottom-type discharge",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: AwaitsOneGrounding { grounding: "checker narrowing: a Never value is only inhabitance from a match/scrutinee the checker has already judged uninhabited, so never() is no longer a producer" },
  population: BoundedPopulation { members: [
    "std.error_primitives never",
    "std.algebra trim",
    "std.encoding",
    "std.decimal",
    "extdeps.languages.simd.kernel",
    "extdeps.languages.gpu.wgsl.kernel",
    "extdeps.cloud.gcp.secret_manager",
    "gunbc.auth.approval_device_wire",
    "gunbc.auth.oidc_id_token_verification",
  ] },
  next_rung_trigger: climbs_when(capability: "checker narrowing")
}
