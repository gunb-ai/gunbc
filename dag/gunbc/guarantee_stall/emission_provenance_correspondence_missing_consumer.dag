module gunbc.guarantee_stall.emission_provenance_correspondence_missing_consumer

import gunbc.guarantee_rung { Mitigatable, StructurallyImpossible }
import gunbc.guarantee_stall { GuaranteeStall, AwaitsOneGrounding, BoundedPopulation, climbs_when }

data emission_provenance_correspondence_missing_consumer: GuaranteeStall = GuaranteeStall {
  subject: "std.emission_provenance declares resolution and correspondence types and folds with no production consumer. test.claim.emission_provenance_test is the only executing reader of emission_resolution_correspondence, emission_declaration_correspondence, EmissionResolutionCoverage, EmissionResolutionCorrespondence, EmissionDeclarationCorrespondence and EmissionResolutionUnreached (fixture, not production). emission_members_by_address and EmissionModuleAddressAmbiguous have ZERO consumers outside std.emission_provenance itself -- not even a test. The emitter-path work discharges contribution arms only.",
  current: Mitigatable,
  ceiling: StructurallyImpossible,
  blocker: AwaitsOneGrounding {
    grounding: "a production path constructs two EmissionResolutionCoverage values and reads emission_resolution_correspondence as part of an executing required-floor control, green by execution."
  },
  population: BoundedPopulation { members: [
    "std.emission_provenance.EmissionResolutionCoverage",
    "std.emission_provenance.EmissionResolutionCorrespondence",
    "std.emission_provenance.EmissionDeclarationCorrespondence",
    "std.emission_provenance.EmissionModuleCorrespondence",
    "std.emission_provenance.EmissionModuleAddressAmbiguous",
    "std.emission_provenance.EmissionResolutionUnreached",
    "std.emission_provenance.emission_members_by_address",
    "std.emission_provenance.emission_correspondence",
    "std.emission_provenance.emission_declaration_correspondence",
    "std.emission_provenance.emission_module_correspondence",
    "std.emission_provenance.emission_resolution_correspondence"
  ] },
  next_rung_trigger: climbs_when(capability: "a production path (not test.claim.emission_provenance_test) constructs two EmissionResolutionCoverage values and reads emission_resolution_correspondence as part of an executing required-floor control -- SUFFICIENT FOR that control to be green by execution and to stay enrolled as the regression evidence rather than retiring. The existing fixture claims in test.claim.emission_provenance_test already call some of these folds, so a trigger satisfied by any call site, by those fixtures remaining green, or by the types merely typechecking, does not fire it.")
}
