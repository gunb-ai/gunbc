module gunbc.guarantee_stall.census_live_routes_interpreted_only_stall

import std.types { String, List }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import gunbc.guarantee_stall { GuaranteeStall, AwaitsOneGrounding, BoundedPopulation, climbs_when }

// A STALL, NOT A DROP (DESIGN section 4b(2) against 4b(3)): the census live routes were authored
// on the interpreted producer and never ran natively, so no rung was held and then lost. The
// interpreted marker read (module_acquisition acquisition_test_markers) over the whole tracked
// .dag universe did not finish a run, and the native route is refused before it executes: the
// native resolve frontier refuses most of the corpus as declarer_refused (measured by
// `gunbc test //gunbc/instruments:v2-native-census`), and a gunbc.* entry importing v2.* is
// denied by the cross-tree import model.
//
// WHAT HOLDS MEANWHILE: the census bodies are pure functions of supplied captures and their
// witness claims execute on supplied inputs; only the live capture is unexecuted at corpus scale.
data census_live_routes_interpreted_only_stall: GuaranteeStall = GuaranteeStall {
  subject: "the claim-coverage census live route (gunbc.claim_coverage_census_live and gunbc.claim_coverage_census_s1_live) runs to completion over the tracked corpus and prints its head",
  current: Mitigatable,
  ceiling: MechanicallyPreventable,
  blocker: AwaitsOneGrounding {
    grounding: "the native compiler resolving module_acquisition and the census closure (the native resolve frontier, owned by Charter 6, not by C4-E), or the captured inputs (file list, marker reads) supplied to a native entry so the census body needs no change; a host-native marker read is that second arm and has no owner yet, so its authoring is a Charter 6 or successor item and is not claimed by this row"
  },
  population: BoundedPopulation {
    members: [
      "the claim-coverage census S1 live route, bound as CliWireProgramProducer at gunbc.instrument_targets claim_coverage_census_binding",
    ]
  },
  next_rung_trigger: climbs_when(capability: "the claim-coverage census live route completes over the tracked corpus on a fleet host and prints its head, observed as the instrument-dispatch run for its label exiting 0, with the native resolve of its closure refusing nothing as declarer_refused")
}
