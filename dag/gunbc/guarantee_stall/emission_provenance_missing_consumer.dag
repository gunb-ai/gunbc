module gunbc.guarantee_stall.emission_provenance_missing_consumer

import gunbc.guarantee_rung { Mitigatable, StructurallyImpossible }
import gunbc.guarantee_stall { GuaranteeStall, AwaitsOneGrounding, BoundedPopulation, climbs_when }

data emission_provenance_missing_consumer: GuaranteeStall = GuaranteeStall {
  subject: "std.emission_provenance defines EmissionContribution and its fold, but no emitter path constructs these values from real output text. The three contribution arms have a consumer enrolled in a required-floor discovery root (test.claim.emission_provenance_test at dag/test/claim) that constructs and reads all three arms. That consumer does NOT execute today because dag/test/claim/emission_provenance_test.dag:179 refuses to compile (gunbc.recurring_failure_mode.match_bound_element_type_mask, blocked on gunbc#10625). It will execute when the compiler repair lands; until then the module has no consumer green by execution. No production consumer constructs these values from real emitted output.",
  current: Mitigatable,
  ceiling: StructurallyImpossible,
  blocker: AwaitsOneGrounding {
    grounding: "an emitter path (src/v1 compiler emit, or the operation-callback layer the typing stall names) constructs EmissionAuthoredFragment, EmissionSourceComposition and EmissionUnobservedFragment from real contributed text and metadata, and a required executing control observes those values through emission_contribution_read and asserts the source/origin decomposition matches the contributed text."
  },
  population: BoundedPopulation { members: [
    "std.emission_provenance.EmissionAuthoredFragment",
    "std.emission_provenance.EmissionSourceComposition",
    "std.emission_provenance.EmissionUnobservedFragment",
    "std.emission_provenance.EmissionResolutionCoverage",
    "std.emission_provenance.EmissionResolutionCorrespondence",
    "std.emission_provenance.EmissionDeclarationCorrespondence",
    "std.emission_provenance.emission_contribution_read",
    "std.emission_provenance.emission_contribution_origins",
    "std.emission_provenance.emission_resolution_correspondence"
  ] },
  next_rung_trigger: climbs_when(capability: "a required executing control constructs an EmissionContribution from a real emitter path (not a hand-built fixture), reads it through emission_contribution_read, and asserts the materialized source and origins match the contributed text and metadata. The control must exercise EmissionAuthoredFragment, EmissionSourceComposition and EmissionUnobservedFragment — all three contribution arms — through emission_contribution_fold.")
}
