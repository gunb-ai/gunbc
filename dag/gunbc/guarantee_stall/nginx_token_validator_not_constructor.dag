module gunbc.guarantee_stall.nginx_token_validator_not_constructor

import std.types { Bool }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.guarantee_stall { GuaranteeStall, UncountedNotEnumerable, climbs_when, stall_trigger_admission }
import gunbc.rung_climb { ClimbableButUnbuilt, TriggerAdmitted }
import extdeps.proxy.openresty { nginx_token }

// FILED AS A STALL, NOT A RUNG DROP: the stronger rung (constructor-only admission) was NEVER held
// for these brands, so declaring a drop would invent a rung to drop from (gunbc.guarantee_stall's
// own correction, and DESIGN §4b(3): a drop asserts a regression that nothing here regressed).
//
// WHAT THE MECHANISM IS — extdeps.proxy.openresty's two token brands are admitted by whitelisted
// CONSTRUCTORS: nginx_token and nginx_variable refuse a value whose every character is not in the
// admitted class (alphanumeric plus - _ . / : % for tokens; letters, digits and _, starting at a
// letter, for Lua variable names). The emitted nginx/Lua text interpolates the brands verbatim, so a
// value that got in through a constructor cannot carry a quote, a semicolon, a comment, a block
// brace or whitespace.
//
// WHAT IT DOES NOT DO — the brands are not enforced: a cast elsewhere puts an unchecked string into
// an NginxToken or NginxVariable and renders it unescaped into the emitted config. That is the drop,
// and it is demonstrated, not asserted, by test.claim.serving.router_proxy_config_witness
// ::a_forced_cast_bypasses_the_constructor_and_renders_unescaped, which pins what such a cast
// renders today. That test is the red control: it goes RED when the refusal lands, which is its
// declared purpose, and its green-now state is what keeps this row outstanding.

data nginx_token_validator_not_constructor_stall: GuaranteeStall = GuaranteeStall {
  subject: "a value interpolated into emitted nginx or Lua text can bypass the checking constructors by a cast, so the emitted config's injection-freedom holds by convention rather than by construction",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: ClimbableButUnbuilt,
  population: UncountedNotEnumerable { reason: "every call site that names an NginxToken or NginxVariable field across every future emitter is exposed — the population is open, not a list. The instrument is per-site rather than a count: does a value of the brand exist anywhere that did not pass through nginx_token or nginx_variable. Today the only known such route is the witness's own forced cast, pinned as the red control; a frozen count would be a change detector, not an instrument" },
  next_rung_trigger: climbs_when(capability: "A CAST INTO THE NginxToken OR NginxVariable BRAND IS REFUSED WHERE THE BRAND IS DECLARED — the checked constructor is the ONLY route to a value of the type, so no call site can mint a token by naming a string. Demonstrated by the pinned red control flipping: test.claim.serving.router_proxy_config_witness ::a_forced_cast_bypasses_the_constructor_and_renders_unescaped currently renders the injected quote and is expected to go RED at the climb. Naming the brand's own declaration here would state nothing about whether the refusal exists: the declaration is already present and the guarantee is not")
}

// THE TRIGGER IS CONSUMED, NOT JUST WRITTEN: the same admission fold the census witness runs over
// the whole roster runs over this row. An empty capability — the untracked stall §4b(2) forbids —
// reds here.
test fn the_stall_trigger_is_admitted() -> Bool {
  match stall_trigger_admission(s: nginx_token_validator_not_constructor_stall) {
    TriggerAdmitted => true
    _ => false
  }
}

// THE REFUSAL BELOW THE STALL REALLY IS CONSTRUCTION: the whitelist refuses, per character, a quote
// the emitted text could never survive.
test fn a_delimiter_never_passes_construction() -> Bool {
  match nginx_token(text: "a'b") { Absent => true Present { value: _ } => false }
}
