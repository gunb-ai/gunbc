module gunbc.guarantee_stall.split_non_emptiness_unmodelled_stall

import v2.std.algebra { Cons, Empty }
import gunbc.guarantee_rung { Mitigatable, StructurallyImpossible }
import gunbc.guarantee_stall { GuaranteeStall, AwaitsOneGrounding, BoundedPopulation }

data split_non_emptiness_unmodelled_stall: GuaranteeStall = GuaranteeStall {
  subject: "split returns List<T> while its implementation guarantees a non-empty result, so every caller that reads split(...).first() carries an Absent arm the producer cannot emit, and must CHOOSE that arm's outcome rather than deriving it. One member cannot even refuse: md_parse_block returns MarkdownBlock, which declares no refusal variant, so its unreachable arm routes to the ParagraphBlock fallthrough rather than stopping the line -- the weakest member of the population and the reason the trigger is the TYPE and not a per-site convention. git_remote_ref_parts is weaker still and sets the floor for the row: it returns a plain GitRemoteRefParts record, and its three consumers -- merge_admission_walk.merge_target_refresh, merge_admission_current_context, and v2.workflow.floor_diff_observe -- each feed the result straight into a fetch remote or a default remote name, so there is no refusal channel at the producer OR at any consumer. Its Absent arm was deliberately left UNREPAIRED rather than bound to a sentinel remote name, because a fabricated remote is the plausible-output arm this ladder forbids and would be indistinguishable from a working one at every call site",
  current: Mitigatable,
  ceiling: StructurallyImpossible,
  blocker: AwaitsOneGrounding { grounding: "a non-empty list type that split's return type inhabits, so first() on a split result is total and has no Absent case to decide" },
  population: BoundedPopulation { members: Cons { head: "extdeps.languages.html.parse_one_with", tail: Cons { head: "extdeps.languages.yaml.ingest.yaml_parse_mapping_entry", tail: Cons { head: "extdeps.languages.yaml.ingest.yaml_parse_mapping_entry_from_text", tail: Cons { head: "extdeps.languages.markdown.md_parse_block", tail: Cons { head: "extdeps.git.git_remote_ref_parts", tail: Empty {} } } } } } },
  next_rung_trigger: "split's RETURN TYPE carries non-emptiness AND these callers CONSUME it -- sufficient for the Absent arms in the rostered members to be unwritable rather than merely unreachable, demonstrated by those arms failing to compile once the type lands. A non-empty type that lands unconsumed by these callers does NOT retire this row, because the chosen arms survive and every future reader must re-derive the reachability argument that justified them"
}
