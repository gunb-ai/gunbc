module gunbc.guarantee_stall.unit_modeling_carrier_totality_stall

import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.guarantee_stall { GuaranteeStall, ClimbableButUnbuilt, BoundedPopulation, climbs_when }

data unit_modeling_carrier_totality_stall: GuaranteeStall = GuaranteeStall {
  subject: "v2.lens.unit_modeling field_name_has_known_carrier is a partial map over unit_field_rows, so a numeric-looking leaf can still be a bare String",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: ClimbableButUnbuilt,
  population: BoundedPopulation { members: ["v2.lens.unit_modeling"] },
  next_rung_trigger: climbs_when(capability: "unit_field_rows total over every numeric-looking field name in the corpus, so a leaf like 4926 cannot be a bare String without a known carrier")
}
