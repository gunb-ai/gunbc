module gunbc.guarantee_stall.grounding_ledger_residue_uninhabited_stall

import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.guarantee_stall { GuaranteeStall, ClimbableButUnbuilt, BoundedPopulation, climbs_when }

data grounding_ledger_residue_uninhabited_stall: GuaranteeStall = GuaranteeStall {
  subject: "v2.lens.grounding_ledger ResidueReason (DecodeReturnedNone | UnrecognizedSiblingArm) remains inhabitable beside GroundingVerdict",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: ClimbableButUnbuilt,
  population: BoundedPopulation { members: ["v2.lens.grounding_ledger"] },
  next_rung_trigger: climbs_when(capability: "ResidueReason uninhabited so every ledger row is a GroundingVerdict — sufficient for the ledger subject to be a wall")
}
