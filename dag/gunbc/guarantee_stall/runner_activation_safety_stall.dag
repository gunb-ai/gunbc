module gunbc.guarantee_stall.runner_activation_safety_stall

import std.types { String }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.guarantee_stall { GuaranteeStall, BoundedPopulation, climbs_when }
import gunbc.rung_climb { ClimbableButUnbuilt }
import gunbc.runner.runner_host_deploy { fleet_runner_host_deploys }

// THE ROW IS ABOUT gunbc.runner.runner_service_activation AND LIVES HERE BECAUSE MEMBERSHIP OF
// gunbc.guarantee_stall.roster IS THIS DIRECTORY. It was declared in that module until the roster
// became derived; the module imports it back for runner_activation_safety_report. "This file"
// below means the activation module, which shipped the single row the paragraph describes.

// THE SAFETY ROW IS A SEPARATE FACT FROM THE REACHABILITY ROW, AND ONE ROW COULD NOT STATE BOTH
// HONESTLY. Reachability answers "can the admission ever say yes here" -- a question about
// observations and topology. Safety answers "what does the admission actually guarantee once it
// does" -- a question about who else can perform the transition. They have different blockers,
// different populations and different triggers, and the single row this file shipped with was
// answering the first while a reader would take it for both.
//
// THE HOST-WIDE RUNG IS MITIGATABLE, NOT STRUCTURAL, AND THE REASON IS A DOOR BESIDE THE WALL.
// gunbc.runner.runner_host_grants installs `systemctl enable <unit>` and `systemctl start <unit>` as raw
// per-unit NOPASSWD grants for the job user. So three claims must be kept apart, and only the first
// two survive:
//
//   enable and start are separately authorized     -- STRUCTURAL. No sudoers line derived from
//                                                     either operation matches `enable --now`, so
//                                                     the fused form the hand loop ran is refused by
//                                                     sudo on every executor host.
//   this emitter cannot activate without readiness -- STRUCTURAL, but only INSIDE the modeled call
//                                                     graph: runner_activate_command and this
//                                                     module's transitions have no constructor that
//                                                     skips the admission.
//   the host cannot activate without readiness     -- FALSE. The grantee holds the raw verbs and can
//                                                     run them directly, outside
//                                                     RunnerActivationAdmission entirely.
//
// So the admission is VALIDATION at the host boundary in DESIGN section 5's exact sense: the invalid
// state remains writable by the principal the grant is installed for. Saying otherwise would be the
// rung inflation section 4b(1) names -- a carrier claiming the top rung while occupying a lower one --
// in the module whose whole job is to stop an unadmitted activation.
//
// IT IS NAMED FOR THE STALL IT IS, NOT FOR THE GUARANTEE IT WITHHOLDS. This row was
// runner_activation_safety_guarantee, and the fields were already honest while the NAME asserted the
// rung they deny -- so a grep for what this repository guarantees about activation returned a symbol
// saying guarantee whose value says Mitigatable. That is section 4b(1)'s tell verbatim, a carrier
// named for the top rung while occupying a lower one, and it is worse than sitting low because an
// inflated class never ranks for climbing. The sibling reachability row was right the first time.
//
// WHAT WOULD MAKE IT STRUCTURAL: ghrunner never receives the systemctl verbs at all. Either it
// invokes only a root-owned helper that takes an activation receipt and validates it before touching
// systemd, or a root-owned convergence service holds the systemd authority and the job user holds
// none. Both remove the door rather than posting a sign on it; a narrower sudoers match cannot,
// because any grant that lets the sanctioned path run the command lets the grantee run it too.
data runner_activation_safety_stall: GuaranteeStall = GuaranteeStall {
  subject: "gunbc.runner.runner_service_activation -- a runner unit activated without a RunnerActivationAdmission",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: ClimbableButUnbuilt,
  population: BoundedPopulation {
    members: map(fleet_runner_host_deploys, d => d.host_label as String),
  },
  next_rung_trigger: climbs_when(capability: "the job user stops holding the systemctl verbs: activation runs through a root-owned helper that consumes and validates an activation receipt, or through a root-owned convergence service that holds the systemd authority while the job user holds none. A narrower sudoers match does not climb this rung -- any grant that lets the sanctioned path run the command lets the grantee run it directly"),
}
