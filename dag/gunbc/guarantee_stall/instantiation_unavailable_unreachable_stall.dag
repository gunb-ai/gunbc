module gunbc.guarantee_stall.instantiation_unavailable_unreachable_stall

import v2.std.algebra { Cons, Empty }
import gunbc.guarantee_rung { OutsideTheLadder, StructurallyGuaranteed }
import gunbc.guarantee_stall { GuaranteeStall, AwaitsOneGrounding, BoundedPopulation }

// THE THIRD CONSTRUCTOR HAS NO AUTHORABLE RED, AND THAT WAS MEASURED RATHER THAN ARGUED.
// RecordLitInstantiation splits three ways so that NotApplicable ("the question does not arise")
// cannot be spelled the same way as Unavailable ("the question arises and cannot be answered").
// The split is right. But Unavailable is reached by NO corpus site -- the whole-corpus run reports
// zero declines -- and by none of fifteen authored probe shapes: wrong generic arity, unresolved
// type names, type aliases, nested generics, generic coproducts, empty literals, a literal whose
// type name is incompatible with its expected type, and a literal naming a non-variant where a
// coproduct is expected.
//
// THE CAUSE IS NOT THAT THE STATE IS IMPOSSIBLE, IT IS THAT ITS POSITION IS UNJUDGED. Every route
// reaching template-selection failure lands in a return position, and return positions do not check
// whether a record literal inhabits the declared type at all. Measured with its control:
// `fn f() -> Box<Int> { Crate { stored: 1 } }` compiles with zero diagnostics and emits a file,
// while `fn f() -> Int { "s" }` is refused with a type mismatch. So the primitive return check
// exists and the record-literal one does not, which is the below-baseline floor subject rostered as
// gunbc.recurring_failure_mode.declared_type_inhabitance_unchecked_by_position.
//
// WHY THIS ROW EXISTS RATHER THAN A FIXTURE. DESIGN §4b asks whether a check's RED is authorable
// before the check is written, and answers it at the FIXTURE boundary rather than the accepted-
// corpus one. Here the fixture boundary gives the same answer as the corpus: no source handed to
// the compiler reaches the state, so a production-seam test for it would be permanently green by
// construction -- the decoration §4b names, worse than absent because it would be cited as coverage
// for the gate that keeps Unavailable out of the legacy fallback. The existing helper-grain cell is
// retained and is honestly labelled: it establishes that the helpers answer correctly when handed
// the state, and nothing about any seam producing it.
data instantiation_unavailable_unreachable_stall: GuaranteeStall = GuaranteeStall {
  subject: "RecordLitInstantiation InstantiationUnavailable is constructed at three sites in v1.compiler.infer and reached by no corpus site and no authorable source, because every route to it lands in a return position where record-literal type inhabitance is never checked -- so the gate that keeps it out of the legacy fallback, and the decline it emits, have no production-seam evidence and cannot acquire any while the position stays unjudged",
  current: OutsideTheLadder,
  ceiling: StructurallyGuaranteed,
  blocker: AwaitsOneGrounding { grounding: "return-position and binding-position record-literal type inhabitance is checked at all, so that a literal whose own type disagrees with the declared type of its position is judged rather than emitted -- the floor repair rostered as declared_type_inhabitance_unchecked_by_position" },
  population: BoundedPopulation { members: Cons { head: "v1.compiler.infer.record_lit_instantiated_fields", tail: Cons { head: "v1.compiler.infer.record_lit_instantiation_undetermined_diags", tail: Cons { head: "v1.compiler.infer.record_lit_instantiation_may_fall_back", tail: Empty {} } } } },
  next_rung_trigger: "an AUTHORED SOURCE fixture reaches InstantiationUnavailable through infer_record_lit_structural and is refused, with a paired accepting control on the same path, demonstrated by that fixture going RED when the production consumer of record_lit_instantiation_undetermined_diags is deleted and GREEN when it is restored. A helper-grain cell constructing the state directly does NOT retire this row -- that is what stands today and it is exactly what cannot distinguish a seam that produces the state from one that never does. Nor does the floor repair landing on its own, unless a fixture then actually reaches the state through it"
}
