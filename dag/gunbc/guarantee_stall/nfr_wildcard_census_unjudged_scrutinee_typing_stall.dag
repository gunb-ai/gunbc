module gunbc.guarantee_stall.nfr_wildcard_census_unjudged_scrutinee_typing_stall

import std.algebra { Cons, Empty }
import gunbc.guarantee_rung { OutsideTheLadder, MechanicallyPreventable }
import gunbc.guarantee_stall { GuaranteeStall, UncountedNotEnumerable, climbs_when }
import gunbc.rung_climb { ClimbableButUnbuilt }

// THE 124 UNJUDGED ROWS OF THE NON-FOLD-RESIDUE WILDCARD CENSUS (measured at PR 14421's head, census run
// 2026-10-23: unjudged_rows=124 = 96 scrutinee-is-an-expression + 23 scrutinee-is-not-a-parameter +
// 1 ambient-head + 4 refused-file). The host reader types these scrutinees; the NATIVE reader cannot, and
// the gap is not a bug to patch in the census: `root_member_reads` refuses an expression or a local
// scrutinee because typing it requires INFERENCE OVER THE CLOSURE -- resolving a let-bound scrutinee to
// its value's coproduct means evaluating or inferring the binding body, and resolving a call-result
// scrutinee means inferring the callee's return type -- which is self-host frontier work, not a census
// capability. The census therefore records the rows as unjudged (and exits 2, incomplete) instead of
// skipping them: DESIGN section 5, an uncounted row is not an observed one, and a skip that looks like a
// pass is the failure this ledger exists to make impossible.
//
// The population is recorded as UNCOUNTED rather than a hand-typed list of the 124 keys: the count is the
// census's own output (the summary line's unjudged_* fields), it moves whenever a file's body moves, and a
// list of keys copied from one run would be a second, stale census. The census itself is the counter.
//
// This row does NOT cover the 31 refused files (21 unique): those are seven body-lowering walls in
// v2.compiler.normalize (paren_group_unread, return_not_in_tail_position, uses_clause_unmodeled,
// service_realization_argv_refused, let_body_not_reachable_from_node, else_less_if_unlowered,
// normalized_tree_reason_wrapper_retention_not_normalized), each now NAMED on its refused line by the
// census's own refusal-cause instrumentation, and each owned by the compiler front end, not this census.
data nfr_wildcard_census_unjudged_scrutinee_typing_stall: GuaranteeStall = GuaranteeStall {
  subject: "the nfr-wildcard-census leaves rows unjudged because the native reader cannot type a non-parameter scrutinee",
  current: OutsideTheLadder,
  ceiling: MechanicallyPreventable,
  blocker: ClimbableButUnbuilt,
  population: UncountedNotEnumerable { reason: "the native census's own summary line counts them (unjudged_rows, split unjudged_expression / unjudged_non_parameter / unjudged_ambient_head / unjudged_refused_file; 124 at the 2026-10-23 head), and the class is every wildcard site whose scrutinee is an expression or a non-parameter binding rather than a closed-coproduct parameter -- typing any one of them needs inference over the enclosing closure, so the population cannot be enumerated by a reader that is precisely what is missing" },
  next_rung_trigger: climbs_when(capability: "the native reader types expression and non-parameter scrutinees through closure inference (self-host frontier), and the census summary reports unjudged_rows=0 with refused=0")
}
