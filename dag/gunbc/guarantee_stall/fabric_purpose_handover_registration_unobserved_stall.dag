module gunbc.guarantee_stall.fabric_purpose_handover_registration_unobserved_stall

import std.algebra { Cons, Empty }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.guarantee_stall { GuaranteeStall, BoundedPopulation, climbs_when }
import gunbc.rung_climb { AwaitsOneGrounding, GroundingUndeclared }

// A COMMITTED SLOT CHANGING PURPOSE IS A TENANT HANDOVER, AND ONE HALF OF IT IS UNOBSERVABLE.
//
// gunbc.runner.runner_slot_allocation fabric_execution_slot_identities holds the committed slots that
// were taken from GitHub Actions and given to fabric execution -- its members have moved twice since
// this stall was rostered, so read them from the roster rather than from this sentence -- and
// gunbc.runner.runner_slot_retirement fabric_purpose_retirees_for_host derives the retirement
// obligation that follows. What retirement
// proves is local: RunnerRetirementObservation carries a unit, a mask flag, a running flag and a
// cgroup occupancy, so RetirementComplete establishes that the mask held, the unit stopped and the
// cgroup emptied.
//
// IT DOES NOT ESTABLISH THAT THE FORMER AUTHORITY LET GO. Whether the GitHub Actions registration
// for a slot identity still exists is read by nothing: ObserveGitHubRunnerRegistration is a
// gunbc.runner.runner_lifecycle_realize scaffold that provisions nothing and answers NotConverged. So the
// dangerous state has no detector -- substrate pristine, registration live, GitHub free to dispatch
// another job onto a slot a fabric cell now owns. A clean directory is no defence against it, and
// sanitation cannot stand in: gunbc.runner.runner_microvm_cell_readiness is keyed by cell and allocation
// generation and carries no registration evidence, so making CellReady mean "GitHub has relinquished
// this identity" would be a meaning fork rather than a join.
//
// WHY THIS IS A STALL AND NOT A REFUSAL. An earlier revision of gunbc#11625 modelled the sealed join
// -- retirement AND registration-absence -- so that a handover whose registration is unobserved
// could not report relinquished. Nothing consumed it, which gunbc.design_argument::consumption makes red on its own, and
// wiring it into the fabric-cell plan would have refused convergence for cells the operator has
// explicitly admitted: ObserveGitHubRunnerRegistration answers NotConverged for every identity, so the
// sealed join fails closed on the unobservable half alone, and the slots the roster held at the time --
// the four on srv3 and srv4, whose takeover the operator authorized on 2026-09-19 -- would have stopped
// converging on a reading that no probe can answer. A guard that contradicts a standing decision is not
// a guard, so the class is rostered here where it is countable instead of asserted in a fold nothing runs.
// THAT AUTHORIZATION NO LONGER COVERS THE POPULATION. The operator ruling of 2026-11-09
// (gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci) returned those four slots to GitHub Actions, so
// what stands today is the first two sentences: no consumer, and a read that cannot answer. If the roster
// regains members whose takeover is not authorized, the refusal is the right shape and this paragraph is
// the thing to re-litigate.
//
// THE POPULATION IS BOUNDED BY THE FABRIC EXECUTION MEMBERSHIP and grows only with it; the canary slot has
// been in it since before the widening that exposed this stall, which is why the stall predates it.
data fabric_purpose_handover_registration_unobserved_stall: GuaranteeStall = GuaranteeStall {
  subject: "committed runner slots reassigned to fabric execution, whose GitHub Actions registration is unobserved so the former authority's relinquishment cannot be established",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: AwaitsOneGrounding {
    grounding: GroundingUndeclared
  },
  population: BoundedPopulation {
    members: Cons {
      head: "gunbc.runner.runner_slot_allocation fabric_execution_slot_identities -- every member of the fabric execution roster, whatever it holds at the time the stall is read (it held srv3-06, srv3-07, srv4-06 and srv4-07 until the operator ruling of 2026-11-09, gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci, returned those four to GitHub Actions)",
      tail: Empty {}
    }
  },
  next_rung_trigger: climbs_when(capability: "registration absence is constructible from an executed read, so a purpose handover can require BOTH local retirement and registration relinquishment and refuse when either is unobserved, instead of proving only the local half")
}
