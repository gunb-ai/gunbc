module gunbc.guarantee_stall.variant_owner_identity_stall

import v2.std.algebra { Cons, Empty }
import gunbc.guarantee_rung { OutsideTheLadder, StructurallyImpossible }
import gunbc.guarantee_stall { GuaranteeStall, ClimbableButUnbuilt, BoundedPopulation, climbs_when }

data variant_owner_identity_stall: GuaranteeStall = GuaranteeStall {
  subject: "runtime variant equality and native-representation selection derive from exact owner-module plus declaration identity, never parent/arm lexemes",
  current: OutsideTheLadder,
  ceiling: StructurallyImpossible,
  blocker: ClimbableButUnbuilt,
  population: BoundedPopulation { members: Cons { head: "v1_interpreter::cross_claim_memo_tests::same_spelled_variants_from_distinct_owners_reproduce_identity_residual", tail: Cons { head: "v1_interpreter::cross_claim_memo_tests::typed_bool_literals_do_not_need_lexeme_shorthands_but_zero_still_does", tail: Cons { head: "v1_interpreter canonical_content_cmp: same-spelled variant keys from distinct declarations order by spelling then full payload (an ORDERING stand-in, never identity; they tie only when they render to identical bytes, so tie order is unobservable in output -- control v1_interpreter::canonical_render_order_tests::rendered_map_bytes_are_equal_across_two_processes)", tail: Empty {} } } } },
  next_rung_trigger: climbs_when(capability: "NS-0B threads its exact owner-module plus declaration-name identity through VariantValueBinding, Value::Variant, hashing, and PortableValue::Variant; the same-spelled-owner residual changes from reproducing equality to requiring inequality, canonical_content_cmp tiebreaks same-spelled variants by declaring owner before payload, and the intentional Nat Zero native representation is selected by that identity rather than by the raw Zero lexeme")
}
