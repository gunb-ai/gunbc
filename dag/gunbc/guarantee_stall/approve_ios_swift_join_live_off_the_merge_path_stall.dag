module gunbc.guarantee_stall.approve_ios_swift_join_live_off_the_merge_path_stall

import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import gunbc.guarantee_stall { GuaranteeStall, BoundedPopulation, climbs_when }
import gunbc.rung_climb { AwaitsOneGrounding, GroundingUndeclared }

// A STANDING DEFICIT, NOT A DROP: the join of the real apps/approve-ios Swift tree to registered
// artifacts or retained rows is born in the change that declares it and has never run as a gate, so
// no mechanically-preventable rung was held and none is claimed to have fallen. Nothing on the
// required path evaluates a witness (DESIGN Building: v1_required_lanes_withdrawn), so the
// supplied-listing controls (test.claim.approve_ios_swift_join_witness: positive control, stray-file
// RED, double-account RED) and the live report are MANUALLY executed:
//   gunbc run --entry dag/gunbc/approve_ios_swift_join_live.dag --function approve_ios_swift_join_live_report
data approve_ios_swift_join_live_off_the_merge_path_stall: GuaranteeStall = GuaranteeStall {
  subject: "the join of the real apps/approve-ios Swift tree to registered generated artifacts or retained rows: unaccounted by any required-path step",
  current: Mitigatable,
  ceiling: MechanicallyPreventable,
  blocker: AwaitsOneGrounding { grounding: GroundingUndeclared },
  population: BoundedPopulation { members: [
      "gunbc.approve_ios_swift_join_live::approve_ios_swift_join_live_report"
    ] },
  next_rung_trigger: climbs_when(capability: "the required path judges a witness over git-observed input and executes approve_ios_swift_join_live_report against the real tree. NOT satisfied by the supplied-listing witness, which exercises the join and not the tree, nor by an operator running the report.")
}
