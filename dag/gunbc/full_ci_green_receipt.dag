module gunbc.full_ci_green_receipt

import std.types { NonEmptyStr, String, CommitSha, Bool, List, Int }
import extdeps.github.checks { Success, CheckConclusion }
import gunbc.floor_component_receipt {
  floor_component_receipt_schema,
}
import gunbc.floor_component_receipt_document {
  FloorComponentReceiptDocument,
  FloorComponentReceiptDecoding,
  ReceiptDecoded,
  floor_component_receipt_decode_with,
  floor_component_receipt_run_terminal_is_concluded,
}
import gunbc.merge_admission {
  MergeAdmissionReceiptV2,
  MergeAdmissionVerdict,
  MergeAdmitted,
  GateRosterHash,
  current_gate_roster_hash,
}
import gunbc.merge_admission_subject {
  WalkAttemptId,
  TestedSubject,
  walk_attempt_id_eq,
  workflow_run_id_matches_walk_attempt,
}

// Typed proof that the pull-request CI job's floor walk completed green — not build-only, not regen-only, and not the falsifier-alert workflow reading a partial checkpoint. FullCiGreenReceipt is sole_constructor-sealed; mint_full_ci_green_receipt_from_observed_ci_floor is caller-sealed via admit_callers to classify_full_ci_green_from_document only, and is reachable only after that classifier accepts a concluded ci-workflow floor-component document with zero unsuccessful summaries. Cross-module record literals, casts, and direct mint-fn calls refuse at compile time (SoleConstructorViolation / ConstructorCallAdmissionRefused). Merge admission and operator manual merge consume this receipt rather than inferring full CI green from sibling job conclusions or alert no-action arms (DESIGN section 5 state-space conflation).
data full_ci_workflow_name: NonEmptyStr = "ci" as NonEmptyStr

data falsifier_alert_workflow_name: NonEmptyStr = "falsifier-alert" as NonEmptyStr

type PartialCiGreenSignal
  = CiBuildJobSucceeded
  | CiRegenJobSucceeded
  | FalsifierAlertWorkflowSucceeded

type PartialCiGreenAdmissionVerdict
  = PartialCiGreenDeniedBuildJobSucceeded
  | PartialCiGreenDeniedRegenJobSucceeded
  | PartialCiGreenDeniedFalsifierAlertWorkflowSucceeded

// Diagnostic taxonomy for REPORTING which partial green path was observed — not the construction wall. FullCiGreenReceipt is sole_constructor-sealed; only mint_full_ci_green_receipt_from_observed_ci_floor (via classify_full_ci_green_from_document on a concluded ci-workflow floor-component document) may construct it, so rule 4 closes for every workflow without maintaining a denylist.
type FullCiGreenReceipt sole_constructor {
  head_sha: CommitSha
  workflow_run_id: NonEmptyStr
  gate_roster_hash: GateRosterHash
}

type FullCiGreenAdmissionVerdict
  = FullCiGreenAdmitted { receipt: FullCiGreenReceipt }
  | FullCiGreenDeniedNotCiWorkflow { observed: NonEmptyStr }
  | FullCiGreenDeniedRunIncomplete
  | FullCiGreenDeniedComponentFailure { count: Int }
  | FullCiGreenDeniedReceiptDecoding { decoding: FloorComponentReceiptDecoding }

type FullCiGreenMergeAdmissionMint
  = FullCiGreenMergeAdmissionMinted { receipt: MergeAdmissionReceiptV2 }
  | FullCiGreenMergeAdmissionMintDeniedSubjectMismatch {
    receipt_head_sha: CommitSha,
    subject_head_sha: CommitSha,
  }
  | FullCiGreenMergeAdmissionMintDeniedWorkflowRunMismatch {
    workflow_run_id: NonEmptyStr,
    attempt_id: WalkAttemptId,
  }
  | FullCiGreenMergeAdmissionMintDeniedAttemptMismatch {
    mint_attempt_id: WalkAttemptId,
    subject_attempt_id: WalkAttemptId,
  }

fn all_component_summaries_green(doc: FloorComponentReceiptDocument) -> Bool {
  count(doc.unsuccessful_summaries) == 0
}

fn mint_full_ci_green_receipt_from_observed_ci_floor(
  head_sha: CommitSha,
  workflow_run_id: NonEmptyStr,
  gate_roster_hash: GateRosterHash,
) -> FullCiGreenReceipt
  admit_callers: [
    decl_ref(module_path: "gunbc.full_ci_green_receipt", decl_name: "classify_full_ci_green_from_document"),
  ]
  = FullCiGreenReceipt {
    head_sha: head_sha,
    workflow_run_id: workflow_run_id,
    gate_roster_hash: gate_roster_hash,
  }

fn classify_full_ci_green_from_document(
  doc: FloorComponentReceiptDocument,
  roster: GateRosterHash,
) -> FullCiGreenAdmissionVerdict {
  if doc.subject.workflow_name != full_ci_workflow_name {
    FullCiGreenDeniedNotCiWorkflow { observed: doc.subject.workflow_name }
  } else if !floor_component_receipt_run_terminal_is_concluded(run_terminal: doc.run_terminal) {
    FullCiGreenDeniedRunIncomplete
  } else if !all_component_summaries_green(doc: doc) {
    FullCiGreenDeniedComponentFailure {
      count: count(doc.unsuccessful_summaries),
    }
  } else {
    FullCiGreenAdmitted {
      receipt: mint_full_ci_green_receipt_from_observed_ci_floor(
        head_sha: doc.subject.head_sha,
        workflow_run_id: doc.subject.run_id,
        gate_roster_hash: roster,
      ),
    }
  }
}

fn classify_full_ci_green_from_receipt_text(
  text: String,
  roster: GateRosterHash,
) -> FullCiGreenAdmissionVerdict {
  match floor_component_receipt_decode_with(text: text, expected_schema: floor_component_receipt_schema) {
    ReceiptDecoded { document: doc } =>
      classify_full_ci_green_from_document(doc: doc, roster: roster)
    decoding => FullCiGreenDeniedReceiptDecoding { decoding: decoding }
  }
}

fn classify_partial_ci_green_signal(signal: PartialCiGreenSignal) -> PartialCiGreenAdmissionVerdict {
  match signal {
    CiBuildJobSucceeded => PartialCiGreenDeniedBuildJobSucceeded
    CiRegenJobSucceeded => PartialCiGreenDeniedRegenJobSucceeded
    FalsifierAlertWorkflowSucceeded => PartialCiGreenDeniedFalsifierAlertWorkflowSucceeded
  }
}

fn mint_merge_admission_receipt_v2_from_full_ci_green(
  full_ci: FullCiGreenReceipt,
  attempt_id: WalkAttemptId,
  tested_subject: TestedSubject,
  pr_number: Int?,
) -> FullCiGreenMergeAdmissionMint {
  if full_ci.head_sha != tested_subject.head_sha {
    FullCiGreenMergeAdmissionMintDeniedSubjectMismatch {
      receipt_head_sha: full_ci.head_sha,
      subject_head_sha: tested_subject.head_sha,
    }
  } else if !workflow_run_id_matches_walk_attempt(
    workflow_run_id: full_ci.workflow_run_id,
    attempt_id: attempt_id,
  ) {
    FullCiGreenMergeAdmissionMintDeniedWorkflowRunMismatch {
      workflow_run_id: full_ci.workflow_run_id,
      attempt_id: attempt_id,
    }
  } else if !walk_attempt_id_eq(left: attempt_id, right: tested_subject.attempt_id) {
    FullCiGreenMergeAdmissionMintDeniedAttemptMismatch {
      mint_attempt_id: attempt_id,
      subject_attempt_id: tested_subject.attempt_id,
    }
  } else {
    FullCiGreenMergeAdmissionMinted {
      receipt: MergeAdmissionReceiptV2 {
        attempt_id: attempt_id,
        pr_number: pr_number,
        tested_head_sha: tested_subject.head_sha,
        tested_base_tree_hash: tested_subject.base_tree_hash,
        gate_roster_hash: full_ci.gate_roster_hash,
        conclusion: Success,
      },
    }
  }
}

fn manual_merge_admits(
  full_ci: FullCiGreenReceipt,
  tested_subject: TestedSubject,
  merge_admission_receipt: MergeAdmissionReceiptV2,
  merge_verdict: MergeAdmissionVerdict,
) -> Bool {
  merge_verdict == MergeAdmitted
    && full_ci.head_sha == tested_subject.head_sha
    && merge_admission_receipt.tested_head_sha == tested_subject.head_sha
    && full_ci.head_sha == merge_admission_receipt.tested_head_sha
    && full_ci.gate_roster_hash == current_gate_roster_hash
    && full_ci.gate_roster_hash == merge_admission_receipt.gate_roster_hash
    && workflow_run_id_matches_walk_attempt(
      workflow_run_id: full_ci.workflow_run_id,
      attempt_id: tested_subject.attempt_id,
    )
    && walk_attempt_id_eq(left: tested_subject.attempt_id, right: merge_admission_receipt.attempt_id)
    && workflow_run_id_matches_walk_attempt(
      workflow_run_id: full_ci.workflow_run_id,
      attempt_id: merge_admission_receipt.attempt_id,
    )
}
