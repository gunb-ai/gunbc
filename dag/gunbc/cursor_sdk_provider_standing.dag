module gunbc.cursor_sdk_provider_standing


data cursor_sdk_provider_standing_note: String = "Produces a six-axis ProviderStandingBundle for Cursor SDK local from modeled auth probe + typed capability gaps. Account headroom is LimitCapabilityGapUnobservable — never LimitObservedAvailable. AuthenticationAuthenticated is derived from probe only, never authored. Coordinates arm names with gunbc.provider_standing (valiant-stag-845 / PR 7926)."

data cursor_sdk_entitlement_unobserved_reason: std.types.NonEmptyStr = "entitlement surface not observed for Cursor SDK local in this slice" as std.types.NonEmptyStr

data cursor_sdk_tool_environment_unobserved_reason: std.types.NonEmptyStr = "tool environment not observed for Cursor SDK local in this slice" as std.types.NonEmptyStr

data cursor_sdk_installation_unobserved_reason: std.types.NonEmptyStr = "cursor-sdk-local-package-provisioned capability gap — @cursor/sdk not admitted on deployed host" as std.types.NonEmptyStr

fn cursor_sdk_authentication_standing_from_probe(
  probe: gunbc.cursor_sdk_auth_probe.CursorSdkAuthProbeResult,
) -> gunbc.provider_standing.ProviderAuthenticationStanding {
  match probe {
    gunbc.cursor_sdk_auth_probe.CursorSdkAuthProbeAuthenticated => gunbc.provider_standing.AuthenticationAuthenticated
    gunbc.cursor_sdk_auth_probe.CursorSdkAuthProbeCredentialsRejected { code: _ } => gunbc.provider_standing.AuthenticationCredentialsAbsent
    gunbc.cursor_sdk_auth_probe.CursorSdkAuthProbeTerminalNonAuthenticationError { code: code } =>
      if extdeps.llm.cursor_sdk_errors.cursor_sdk_error_code_is_enumerated_non_authentication_failure(code: code) {
        gunbc.provider_standing.AuthenticationAuthenticated
      } else {
        match code {
          extdeps.llm.cursor_sdk_errors.CursorSdkErrorCodeOther { raw: raw } =>
            gunbc.provider_standing.AuthenticationStandingUnobserved {
              reason: concat(
                "unrecognised terminal error code: ",
                raw,
              ) as std.types.NonEmptyStr,
            }
          _ =>
            gunbc.provider_standing.AuthenticationStandingUnobserved {
              reason: "unrecognised terminal error code" as std.types.NonEmptyStr,
            }
        }
      }
    gunbc.cursor_sdk_auth_probe.CursorSdkAuthProbeUnclassified { reason } =>
      gunbc.provider_standing.AuthenticationStandingUnobserved { reason: reason }
  }
}

fn cursor_sdk_local_limit_observation() -> gunbc.provider_standing.ProviderLimitObservation {
  gunbc.provider_standing.LimitCapabilityGapUnobservable {
    reason: extdeps.llm.cursor_sdk_facts.cursor_sdk_local_limit_standing_reason,
  }
}

fn cursor_sdk_local_provider_standing_from_auth_probe(
  probe: gunbc.cursor_sdk_auth_probe.CursorSdkAuthProbeResult,
) -> gunbc.provider_standing.ProviderStandingBundle {
  gunbc.provider_standing.ProviderStandingBundle {
    installation: gunbc.provider_standing.InstallationStandingUnobserved {
      reason: cursor_sdk_installation_unobserved_reason,
    },
    authentication: cursor_sdk_authentication_standing_from_probe(probe: probe),
    entitlement: gunbc.provider_standing.EntitlementObservationUnobserved {
      reason: cursor_sdk_entitlement_unobserved_reason,
    },
    limits: [cursor_sdk_local_limit_observation()],
    turn: gunbc.provider_standing.TurnNotStarted,
    tool_environment: gunbc.provider_standing.ToolEnvironmentStandingUnobserved {
      reason: cursor_sdk_tool_environment_unobserved_reason,
    },
  }
}

fn cursor_sdk_local_provider_standing_has_usage_capability_gap(
  standing: gunbc.provider_standing.ProviderStandingBundle,
) -> Bool {
  fold(
    standing.limits,
    init: false,
    f: fn(acc, row) {
      if acc {
        true
      } else {
        match row {
          gunbc.provider_standing.LimitCapabilityGapUnobservable { reason: reason } =>
            reason == extdeps.llm.cursor_sdk_facts.cursor_sdk_local_limit_standing_reason
          _ => false
        }
      }
    },
  )
}
