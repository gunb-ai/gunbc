module gunbc.cursor_sdk_provider_standing

import std.types { NonEmptyStr, String, List }
import gunbc.provider_standing {
  ProviderStandingBundle,
  ProviderInstallationStanding,
  ProviderAuthenticationStanding,
  ProviderEntitlementObservation,
  ProviderLimitObservation,
  ProviderTurnOutcome,
  ProviderToolEnvironmentStanding,
  InstallationStandingUnobserved,
  AuthenticationCredentialsAbsent,
  AuthenticationAuthenticated,
  EntitlementObservationUnobserved,
  LimitCapabilityGapUnobservable,
  TurnNotStarted,
  ToolEnvironmentStandingUnobserved,
}
import extdeps.llm.cursor_sdk_facts {
  cursor_sdk_local_limit_standing_reason,
  cursor_sdk_local_provision_missing_capability,
}
import gunbc.cursor_sdk_auth_probe {
  CursorSdkAuthProbeResult,
  CursorSdkAuthProbeAuthenticated,
  CursorSdkAuthProbeCredentialsRejected,
  CursorSdkAuthProbeUnclassified,
}

data cursor_sdk_provider_standing_note: String = "Produces a six-axis ProviderStandingBundle for Cursor SDK local from modeled auth probe + typed capability gaps. Account headroom is LimitCapabilityGapUnobservable — never LimitObservedAvailable. AuthenticationAuthenticated is derived from probe only, never authored. Coordinates arm names with gunbc.provider_standing (valiant-stag-845 / PR 7926)."

data cursor_sdk_entitlement_unobserved_reason: NonEmptyStr = "entitlement surface not observed for Cursor SDK local in this slice" as NonEmptyStr

data cursor_sdk_tool_environment_unobserved_reason: NonEmptyStr = "tool environment not observed for Cursor SDK local in this slice" as NonEmptyStr

data cursor_sdk_installation_unobserved_reason: NonEmptyStr = "cursor-sdk-local-package-provisioned capability gap — @cursor/sdk not admitted on deployed host" as NonEmptyStr

fn cursor_sdk_authentication_standing_from_probe(
  probe: CursorSdkAuthProbeResult,
) -> ProviderAuthenticationStanding {
  match probe {
    CursorSdkAuthProbeAuthenticated => AuthenticationAuthenticated
    CursorSdkAuthProbeCredentialsRejected { code: _ } => AuthenticationCredentialsAbsent
    CursorSdkAuthProbeUnclassified { reason } =>
      AuthenticationStandingUnobserved { reason: reason }
  }
}

fn cursor_sdk_local_limit_observation() -> ProviderLimitObservation {
  LimitCapabilityGapUnobservable {
    reason: cursor_sdk_local_limit_standing_reason,
  }
}

fn cursor_sdk_local_provider_standing_from_auth_probe(
  probe: CursorSdkAuthProbeResult,
) -> ProviderStandingBundle {
  ProviderStandingBundle {
    installation: InstallationStandingUnobserved {
      reason: cursor_sdk_installation_unobserved_reason,
    },
    authentication: cursor_sdk_authentication_standing_from_probe(probe: probe),
    entitlement: EntitlementObservationUnobserved {
      reason: cursor_sdk_entitlement_unobserved_reason,
    },
    limits: [cursor_sdk_local_limit_observation()],
    turn: TurnNotStarted,
    tool_environment: ToolEnvironmentStandingUnobserved {
      reason: cursor_sdk_tool_environment_unobserved_reason,
    },
  }
}

fn cursor_sdk_local_provider_standing_has_usage_capability_gap(
  standing: ProviderStandingBundle,
) -> Bool {
  fold(
    standing.limits,
    init: false,
    f: fn(acc, row) {
      if acc {
        true
      } else {
        match row {
          LimitCapabilityGapUnobservable { reason: reason } =>
            reason == cursor_sdk_local_limit_standing_reason
          _ => false
        }
      }
    },
  )
}
