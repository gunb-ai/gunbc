module gunbc.spark_serving_install_paths

import std.types { String, FilePath, NonEmptyStr }
import gunbc.spark_serving_desired { spark_serving_desired_bind_listen }
import gunbc.spark_serving_runtime_receipt { spark_serving_executor_home }

data spark_serving_install_paths_note: String = "Owned-runtime layout for UserUnitRealization + InstallOwnedRuntimeClosure on Spark hosts. Executor home and receipt path are gunbc.spark_serving_runtime_receipt. User unit basename is spark_serving_unit_name in this module — gunbc.spark_serving_observe still hardcodes the same string in probe argv until a follow-on imports this authority. Unit desired state is SparkServingUserUnitSpec (typed fields, not systemd INI syntax); gunbc.spark_serving_membership spark_serving_user_unit_file_write_intent carries path+spec for Phase 2 typed delivery."

data spark_serving_unit_name: String = "gunbc-spark-serving.service"

data spark_serving_runtime_root_rel: String = ".local/share/gunbc/spark-serving/ollama"

data spark_serving_models_root_rel: String = ".local/share/gunbc/spark-serving/models"

data spark_serving_user_unit_dir_rel: String = ".config/systemd/user"

type SparkServingUserUnitSpec {
  description: NonEmptyStr
  after: NonEmptyStr
  service_type: NonEmptyStr
  bind_host_port: NonEmptyStr
  models_root_rel: String
  runtime_root_rel: String
  exec_subcommand: NonEmptyStr
  restart: NonEmptyStr
  wanted_by: NonEmptyStr
}

fn spark_serving_user_unit_rel() -> String {
  join([spark_serving_user_unit_dir_rel, spark_serving_unit_name], "/")
}

fn spark_serving_runtime_root() -> FilePath {
  concat(
    spark_serving_executor_home as String,
    concat("/", spark_serving_runtime_root_rel),
  ) as FilePath
}

fn spark_serving_models_root() -> FilePath {
  concat(
    spark_serving_executor_home as String,
    concat("/", spark_serving_models_root_rel),
  ) as FilePath
}

fn spark_serving_user_unit_path() -> FilePath {
  concat(
    spark_serving_executor_home as String,
    concat("/", spark_serving_user_unit_rel()),
  ) as FilePath
}

fn spark_serving_bind_host_port() -> String {
  join([
    spark_serving_desired_bind_listen.host as String,
    ":",
    to_string(spark_serving_desired_bind_listen.port),
  ], "")
}

fn spark_serving_user_unit_spec() -> SparkServingUserUnitSpec {
  SparkServingUserUnitSpec {
    description: "gunbc Spark serving (Ollama gpt-oss:20b)" as NonEmptyStr,
    after: "network-online.target" as NonEmptyStr,
    service_type: "simple" as NonEmptyStr,
    bind_host_port: spark_serving_bind_host_port() as NonEmptyStr,
    models_root_rel: spark_serving_models_root_rel,
    runtime_root_rel: spark_serving_runtime_root_rel,
    exec_subcommand: "serve" as NonEmptyStr,
    restart: "on-failure" as NonEmptyStr,
    wanted_by: "default.target" as NonEmptyStr,
  }
}

fn spark_serving_user_unit_spec_identity(spec: SparkServingUserUnitSpec) -> String {
  join([
    spec.description as String,
    "|",
    spec.after as String,
    "|",
    spec.service_type as String,
    "|",
    spec.bind_host_port as String,
    "|",
    spec.models_root_rel,
    "|",
    spec.runtime_root_rel,
    "|",
    spec.exec_subcommand as String,
    "|",
    spec.restart as String,
    "|",
    spec.wanted_by as String,
  ], "")
}
