module gunbc.spark_serving_install_paths

import std.types { String, NonEmptyStr, FilePath }
import extdeps.ollama.api { ollama_model_ref_wire }
import extdeps.ollama.capability { ollama_gpt_oss_20b_model_ref }
import gunbc.spark_serving_desired {
  spark_serving_desired_bind_listen,
  spark_serving_automation_principal,
}
import gunbc.spark_serving_release { spark_serving_target }
import gunbc.spark_serving_realization { principal_label }
import gunbc.spark_serving_runtime_receipt { spark_serving_executor_home }

data spark_serving_install_paths_note: String = "Owned-runtime layout for UserUnitRealization + InstallOwnedRuntimeClosure on Spark hosts. Executor home and receipt path are gunbc.spark_serving_runtime_receipt; gunbc host paths are gunbc.host_layout (host_spark_serving_provision_script imports srv1_gunbc_repo_root and srv1_gunbc_serve_binary — fleet-constant /opt/gunbc layout on Spark hosts, same codex precedent)."

data spark_serving_runtime_root_rel: String = ".local/share/gunbc/spark-serving/ollama"

data spark_serving_models_root_rel: String = ".local/share/gunbc/spark-serving/models"

data spark_serving_user_unit_rel: String = ".config/systemd/user/gunbc-spark-serving.service"

fn spark_serving_runtime_root() -> FilePath {
  concat(
    spark_serving_executor_home as String,
    concat("/", spark_serving_runtime_root_rel),
  ) as FilePath
}

fn spark_serving_runtime_executable() -> FilePath {
  concat(spark_serving_runtime_root() as String, "/bin/ollama") as FilePath
}

fn spark_serving_models_root() -> FilePath {
  concat(
    spark_serving_executor_home as String,
    concat("/", spark_serving_models_root_rel),
  ) as FilePath
}

fn spark_serving_user_unit_path() -> FilePath {
  concat(
    spark_serving_executor_home as String,
    concat("/", spark_serving_user_unit_rel),
  ) as FilePath
}

fn spark_serving_desired_model_wire() -> String {
  ollama_model_ref_wire(ref: ollama_gpt_oss_20b_model_ref)
}

fn spark_serving_bind_host_port() -> String {
  join([
    spark_serving_desired_bind_listen.host as String,
    ":",
    to_string(spark_serving_desired_bind_listen.port),
  ], "")
}

fn spark_serving_automation_login() -> String {
  principal_label(p: spark_serving_automation_principal())
}

fn spark_serving_unit_name() -> String {
  match spark_serving_target(actor: spark_serving_automation_principal()) {
    t => t.unit_name as String
  }
}

fn spark_serving_user_unit_contents() -> String {
  join([
    "[Unit]\n",
    "Description=gunbc Spark serving (Ollama gpt-oss:20b)\n",
    "After=network-online.target\n",
    "\n",
    "[Service]\n",
    "Type=simple\n",
    join(["Environment=OLLAMA_HOST=", spark_serving_bind_host_port(), "\n"], ""),
    join(["Environment=OLLAMA_MODELS=%h/", spark_serving_models_root_rel, "\n"], ""),
    "Environment=HOME=%h\n",
    join(["ExecStart=%h/", spark_serving_runtime_root_rel, "/bin/ollama serve\n"], ""),
    "Restart=on-failure\n",
    "\n",
    "[Install]\n",
    "WantedBy=default.target\n",
  ], "")
}

fn spark_serving_linger_command() -> NonEmptyStr {
  join([
    "/usr/bin/loginctl enable-linger ",
    spark_serving_automation_login(),
  ], "") as NonEmptyStr
}
