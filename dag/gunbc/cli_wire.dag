module gunbc.cli_wire

// THE RETURN CONTRACT BETWEEN THE HOST AND A .dag CLI ENTRY THAT ANSWERS A QUESTION.
//
// `serve` already establishes that the host may call one .dag entry and render a TYPED value it
// returns: `fn(method, path, body) -> ServeWireResponse`, with the seam documented as parse/write
// only and any other shape refused by name. This is that pattern's second instance, for the process
// boundary rather than the HTTP one. `ProcessExit` remains the WET-GATE convention it says it is in
// `cli_run.rs` `run_claim`; it is not the only return convention the binary has, and nothing here
// changes it.
//
// WHY TWO FIELDS RATHER THAN ONE. A CLI invocation produces two facts, and neither derives from the
// other: the BYTES a reader sees, and the EXIT STATUS a script branches on. The case that settles it
// is a read verb whose repository is unavailable -- that answer still has a document worth PRINTING,
// and must still exit nonzero. A carrier holding only bytes cannot say the second; a carrier holding
// only a status cannot say the first. `ServeWireResponse` resolves the identical tension the
// identical way, carrying status beside body.
//
// WHY NOT TWO ENTRY POINTS. The alternative -- one entry returning the projection, one returning the
// exit status -- lets the two be computed from DIFFERENT reads of the repository, with nothing
// keeping them consistent: a verb could print an answer and exit as though it had refused. That is a
// state-space split introduced by the carrier's shape rather than by the domain, which is the thing
// a carrier is supposed to prevent. (Operator ruling, relayed 2026-08-28.)
//
// THIS TYPE COMPOSES TWO EXISTING AUTHORITIES AND RE-COINS NEITHER. `TerminalWriteProjection` owns
// what bytes may reach a terminal; `ProcessExit` owns how a run ends. Minting a fresh "cli output"
// string field beside them would be the section 3 nicknaming violation -- a second spelling of bytes
// whose admissibility the render authority already decides.
//
// THE PRODUCER IS THE GUARDED ENTRY, AND THAT IS LOAD-BEARING. `project_terminal_write` refuses
// `DynamicLineOpen` on a non-addressable capability BEFORE delegating to
// `project_terminal_write_admitted`. An earlier revision of this proposal named the delegate
// directly, which would have handed it exactly the contradictory state the wrapper exists to refuse
// -- removing a wall while describing itself as binding one. The wrapper is the only correct
// producer of the `write` field, and it is already a production path:
// `gunbc.observation_seed_render` calls it at two sites.

import std.process { ProcessExit }
import std.render { Append, Document, RenderCapability }
import extdeps.render.surface { RenderTarget, serialize_document }
import extdeps.render.terminal {
  TerminalWriteProjection,
  DynamicLineClosed,
  project_terminal_write,
}

type CliWireResponse {
  write: TerminalWriteProjection
  exit: ProcessExit
}

// A ONE-SHOT ANSWER STARTS FROM A CLOSED LINE AND APPENDS.
//
// `DynamicLineClosed` is not a default chosen for convenience: a CLI invocation that prints an answer
// and exits has no prior partial line of its own to continue, and claiming `DynamicLineOpen` would
// assert a predecessor write that did not happen. `Append` matches the `CursorAction` the answer's
// document carries -- a read verb emits its answer once and does not redraw, so `Overwrite` would
// make the answer's persistence depend on the destination's cursor addressability, which is a
// property of the handler rather than a fact about the answer.
fn cli_wire_response(
  doc: Document,
  target: RenderTarget,
  capability: RenderCapability,
  exit: ProcessExit
) -> CliWireResponse {
  CliWireResponse {
    write: project_terminal_write(
      prior: DynamicLineClosed,
      requested: Append,
      capability: capability,
      rendered: serialize_document(doc: doc, target: target, cap: capability)
    ),
    exit: exit,
  }
}
