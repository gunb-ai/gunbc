module gunbc.required_ci_epoch_observation

import std.types { Bool, FilePath, GitRef, Int, List, NonEmptyStr, String }
import std.contract_identity { ContractEpoch }
import gunbc.required_ci_contract_epoch { required_ci_contract_epoch_env_key }
import extdeps.git.plumbing
import extdeps.git.plumbing { GitRepositoryAddress, GitWorktreeAt }
import std.algebra { trim }
import gunbc.generated_artifact { GeneratedArtifact, WitnessFloorYamlArtifact, artifact_path }
import extdeps.languages.yaml.types { YamlValue, YamlKeyValue, YamlMapping, YamlString }
import extdeps.languages.yaml.ingest { ingest_yaml_source, IngestedYaml, YamlIngestRejected }

// THE OBSERVED EPOCH IS A PROPERTY OF THE TREE THE RUN EXECUTED, NOT OF THE JUDGE. The Required CI
// contract's epoch is emitted into the workflow artifact itself (gunbc.witness_floor_workflow), so
// the bytes GitHub executed for a push-triggered run ARE the bytes carrying the epoch: reading them
// at the triggering event's exact head_sha observes what ran, while reading the ambient checkout,
// or calling the contract authority for both sides, would only restate what the judge expects. That
// distinction is the whole point of the component -- an epoch stamped from the judge's own authority
// would make a cross-epoch admission unobservable while looking exactly like a check.
//
// THE PARSE IS STRUCTURAL, NEVER A SUBSTRING. The epoch is a top-level env member, so it is found by
// walking the ingested document's mapping entries. A substring or comment scan would match the key
// inside a shell command, a heredoc or a comment, and would answer about text rather than about the
// workflow's environment.
//
// WHY THIS FOLD TAKES SOURCE TEXT RATHER THAN PERFORMING THE READ. Keeping the decision pure is what
// makes every refusal arm authorable from a fixture: absent, duplicated and malformed are properties
// of a document, and a test can hand this function exactly the document that exhibits one. The read
// itself is the caller's effect, and its two failure modes stay separate arms here because a commit
// that cannot be read and a path that does not exist in a readable commit have different remedies.
// THE FAILURE ARMS ARE THEIR OWN COPRODUCT so a consumer that must refuse can carry the exact axis
// that failed WITHOUT carrying a success arm it would then have to prove impossible. Nesting the
// whole observation inside a refusal would put RequiredCiEpochObserved somewhere it can never occur,
// which is the state-space conflation this corpus rosters as its own failure mode.
type RequiredCiEpochUnobserved
  = RequiredCiEpochCommitUnreadable { detail: String }
  | RequiredCiEpochPathUnreadable { detail: String }
  | RequiredCiEpochDocumentUnparsable { detail: String }
  | RequiredCiEpochAbsent
  | RequiredCiEpochDuplicated { occurrences: Int }
  | RequiredCiEpochMalformed { detail: String }

type RequiredCiEpochObservation
  = RequiredCiEpochObserved { epoch: ContractEpoch }
  | RequiredCiEpochUnobservable { cause: RequiredCiEpochUnobserved }

// A DOCUMENT THAT IS NOT A MAPPING IS UNPARSABLE, NOT EMPTY. An earlier shape answered "no top-level
// entries" for a scalar or sequence document, which flowed into the absent arm and reported that the
// workflow declares no epoch -- a widened failure wearing the name of a precise one. The distinction
// is decided once, in the producer below, where the document is already in hand.
fn yaml_env_entries(entries: List<YamlKeyValue>) -> List<YamlKeyValue> {
  fold(
    entries,
    init: [],
    f: fn(acc, kv) {
      if kv.key == "env" {
        match kv.value {
          YamlMapping { entries: es } => es
          _ => acc
        }
      } else {
        acc
      }
    }
  )
}

fn epoch_entries_in(entries: List<YamlKeyValue>) -> List<YamlKeyValue> {
  filter(entries, kv => kv.key == (required_ci_contract_epoch_env_key as String))
}

// The container decides the whole outcome, which is why there is no undecodable arm: once the value
// is a nonempty string there is no further decoding step that could refuse, and an arm for it would
// be a permanently unreachable RED (std.contract_identity states that law on ContractEpoch itself).
fn epoch_from_entry(kv: YamlKeyValue) -> RequiredCiEpochObservation {
  match kv.value {
    YamlString { value: s } =>
      if s == "" {
        RequiredCiEpochUnobservable { cause: RequiredCiEpochMalformed { detail: "epoch member is the empty string" } }
      } else {
        RequiredCiEpochObserved { epoch: s as ContractEpoch }
      }
    _ => RequiredCiEpochUnobservable { cause: RequiredCiEpochMalformed { detail: "epoch member is not a string" } }
  }
}

fn required_ci_epoch_from_workflow_source(src: String) -> RequiredCiEpochObservation {
  match ingest_yaml_source(src: src) {
    YamlIngestRejected { reason: r } => RequiredCiEpochUnobservable { cause: RequiredCiEpochDocumentUnparsable { detail: r } }
    IngestedYaml { value: doc } =>
      match doc {
        YamlMapping { entries: es } => {
          let hits = epoch_entries_in(entries: yaml_env_entries(entries: es))
          let n = hits.length()
          if n == 0 {
            RequiredCiEpochUnobservable { cause: RequiredCiEpochAbsent }
          } else if n > 1 {
            RequiredCiEpochUnobservable { cause: RequiredCiEpochDuplicated { occurrences: n } }
          } else {
            match first(hits) {
              Present { value: kv } => epoch_from_entry(kv: kv)
              Absent => RequiredCiEpochUnobservable { cause: RequiredCiEpochAbsent }
            }
          }
        }
        _ =>
          RequiredCiEpochUnobservable {
            cause: RequiredCiEpochDocumentUnparsable {
              detail: "the workflow document is not a mapping, so it declares no env block at all",
            },
          }
      }
  }
}

// The operator-facing line for each way the epoch could fail to be observed. It lives here rather
// than at the consumer because the vocabulary is this module's: a consumer rendering these arms
// would be a second authority over what they mean, and would drift the first time an arm is added.
fn required_ci_epoch_unobserved_message(cause: RequiredCiEpochUnobserved) -> String {
  match cause {
    RequiredCiEpochCommitUnreadable { detail: d } =>
      concat("the triggering commit could not be read: ", d)
    RequiredCiEpochPathUnreadable { detail: d } =>
      concat("the workflow path could not be read at the triggering commit: ", d)
    RequiredCiEpochDocumentUnparsable { detail: d } =>
      concat("the workflow document at the triggering commit does not parse: ", d)
    RequiredCiEpochAbsent =>
      "the workflow at the triggering commit declares no contract epoch"
    RequiredCiEpochDuplicated { occurrences: _ } =>
      "the workflow at the triggering commit declares the contract epoch more than once"
    RequiredCiEpochMalformed { detail: d } =>
      concat("the contract epoch at the triggering commit is malformed: ", d)
  }
}

// THE EFFECTFUL HALF, kept to one small boundary. It reads the workflow artifact AT THE TRIGGERING
// COMMIT and hands the bytes to the pure fold above, so the only thing the effect decides is which
// bytes are read -- never what they mean. The ref is the event's head_sha rather than any ambient
// checkout, which is the whole content of "observed at the exact commit that ran".
//
// THE REPOSITORY IS A PARAMETER, NOT THE PROCESS WORKING DIRECTORY, which is why this reads through
// extdeps.git.plumbing rather than extdeps.git Core.Show: Show inherits whatever checkout the
// process happens to occupy, so a fixture could not hand it a repository of its own and the
// discriminating experiment -- two commits whose trees differ only in the epoch member -- would have
// no place to exist. Address-taking is one axis (extdeps.git.plumbing GitRepositoryAddress), so
// production passes its own worktree and the witness passes the fixture, over ONE code path.
//
// THE TWO READ FAILURES ARE SEPARATED BY GIT'S OWN QUESTION, NOT BY ITS PROSE. A commit that cannot
// be read and a path absent from a readable commit have different remedies, and `cat-file blob`
// reports both with a `fatal: path ...` line -- measured, on this repository, for an absent path and
// for a well-formed but unknown commit. Classifying them by substring would be a heuristic over
// upstream wording. `cat-file -e` answers commit presence with an exit code, which is the question
// git designed it to answer, so the two causes are decided by two typed probes rather than by
// reading one error message twice.
func observe_required_ci_epoch_at_commit(
  address: GitRepositoryAddress,
  head_sha: GitRef,
) -> RequiredCiEpochObservation {
  let commit_probe = git.Plumbing.CatFileExists(
    address: address,
    object: concat(head_sha as String, "^\{commit\}"),
  )
  if commit_probe.exit_code != 0 {
    RequiredCiEpochUnobservable {
      cause: RequiredCiEpochCommitUnreadable { detail: trim(commit_probe.stderr) },
    }
  } else {
    let blob = git.Plumbing.CatFileBlob(
      address: address,
      object: concat(head_sha as String, concat(":", required_ci_workflow_file_path() as String)),
    )
    if blob.exit_code != 0 {
      RequiredCiEpochUnobservable {
        cause: RequiredCiEpochPathUnreadable { detail: trim(blob.stderr) },
      }
    } else {
      required_ci_epoch_from_workflow_source(src: blob.content)
    }
  }
}

fn required_ci_workflow_file_path() -> FilePath {
  artifact_path(a: WitnessFloorYamlArtifact) as FilePath
}
