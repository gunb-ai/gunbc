module gunbc.session_auto_publish

import std.types { CommitSha, Timestamp, Bool, String, List }
import v2.std.optional { Absent, Present }

data session_auto_publish_note: String = "AUTO-PUBLISH: three independent publication facts (slice 0 recut) with immediate policy adjudication (slice 1) and default-deny remote-publish conjunction (slice 2). LocalCheckpoint tracks the local commit after dashboard autosave only — not after a push. RemoteBranchPublication tracks the remote branch head after an explicit publish and successful push. WorkerNotification tracks the worker-notification baseline stamped on user publish or drift-reminder delivery. Drift reminders diff WorkerNotification.notified_head..HEAD; conflating any axis with another sweeps unrelated churn into the worker notice (DASHBOARD_OPS_HYGIENE_BRIEF section 6.1). Silent polling OBSERVES state and must not call any transition fn — a poll push is an unrequested publication, not a local checkpoint. SLICE 2 MODELS THE DEFAULT-DENY CONSUMER BUT STILL CHANGES NO RUNTIME BEHAVIOUR: admit_remote_publication stacks slice-1 policy under a refusal conjunction — explicit PublicationRequest, expected-head compare-and-swap, clean index, zero unmerged stages, zero conflict markers, declared write set, post-write compile green, peer authorship known — and every unevaluable precondition refuses rather than passes. Incident specimens (auto_publish_incident_specimens_note) record what produced this work; neither specimen alone proves which mechanism moved a ref. Slices 0–2 change no publication behaviour until shell transport calls admit_remote_publication before any git push, gh pr create, or healer branch mutation. Deferred halves, each with a dissolution trigger: (1) shell transport wiring — session-dashboard schema and publishSessionWorktree route every publish attempt through admit_remote_publication and the slice-0 state fns instead of conflated pr_publish_head || pr_publish_notified_head; dissolves when a harness integration witness executes against the live transport; (2) publication attribution — RemoteBranchPublication carries who requested the publication and under what authority as typed facts the publication cannot be performed without, not as a log line; dissolves when every remote publication transition requires a PublicationRequest carrier with requester identity and a harness witness proves an unattributed advance is unwritable."

data auto_publish_incident_specimens_note: String = "SPECIMEN 1 (#7904): WIP auto-commit swept a throwaway spike file into a commit, pushed the branch to origin, and opened PR #7904 without author act. Proven class: local checkpoint became remote publication with no author act; author initially misattributed it to another session before discovering it was theirs. SPECIMEN 2 (2026-08-07, during operator freeze forbidding pushes): origin/session/royal-ant-539-cgroup-vertical-backup advanced from f94c17019b6 to e4e51154765e4d4b326591b9dac7479679782b4d (author and committer Brian Searls, timestamp 2026-08-07T04:52:05Z) within roughly four minutes; branch owner states they did not push in that session. HONEST BOUND ON WHAT SPECIMEN 2 PROVES: a remote ref moved and nobody can say who moved it after the fact — not that the harness auto-published it. Events API returned nothing for this repo; git author identity is the same for every session so it cannot discriminate session push from automated push; owner denial is not proof no owned process pushed. A person or subagent could have pushed. WHAT BOTH SPECIMENS ARGUE FOR: default-deny stops unauthorized publication (slice 2); attribution makes authorized publication auditable (slice 3 deferred) — a publication path whose provenance is unreconstructible after the fact is one where a wrong publication cannot be attributed, and RemoteBranchPublication describing only a head commit is weaker than it appears."

type LocalCheckpoint
  = LocalCheckpointAbsent
  | LocalCheckpointAt { local_commit: CommitSha }

type RemoteBranchPublication
  = RemoteBranchPublicationAbsent
  | RemoteBranchPublicationAt { remote_head: CommitSha }

type WorkerNotification
  = WorkerNotificationAbsent
  | WorkerNotificationStamped { notified_head: CommitSha, notified_at: Timestamp }

type SessionPublishState {
  local: LocalCheckpoint
  remote_branch: RemoteBranchPublication
  worker: WorkerNotification
}

fn empty_session_publish_state() -> SessionPublishState {
  SessionPublishState {
    local: LocalCheckpointAbsent,
    remote_branch: RemoteBranchPublicationAbsent,
    worker: WorkerNotificationAbsent,
  }
}

fn after_local_autosave(state: SessionPublishState, local_commit: CommitSha) -> SessionPublishState {
  SessionPublishState {
    local: LocalCheckpointAt { local_commit: local_commit },
    remote_branch: state.remote_branch,
    worker: state.worker,
  }
}

fn after_explicit_publish_push(
  state: SessionPublishState,
  remote_head: CommitSha,
) -> SessionPublishState {
  SessionPublishState {
    local: state.local,
    remote_branch: RemoteBranchPublicationAt { remote_head: remote_head },
    worker: state.worker,
  }
}

fn after_worker_notification(
  state: SessionPublishState,
  notified_head: CommitSha,
  at: Timestamp,
) -> SessionPublishState {
  SessionPublishState {
    local: state.local,
    remote_branch: state.remote_branch,
    worker: WorkerNotificationStamped {
      notified_head: notified_head,
      notified_at: at,
    },
  }
}

fn after_user_intent_publish(
  state: SessionPublishState,
  published_head: CommitSha,
  at: Timestamp,
) -> SessionPublishState {
  after_worker_notification(
    state: after_explicit_publish_push(state: state, remote_head: published_head),
    notified_head: published_head,
    at: at,
  )
}

fn after_drift_reminder_delivered(
  state: SessionPublishState,
  current_head: CommitSha,
  at: Timestamp,
) -> SessionPublishState {
  after_worker_notification(
    state: state,
    notified_head: current_head,
    at: at,
  )
}

data poll_observation_note: String = "Silent polling observes remote/local facts and advances no publication axis. Production must not route poll observations through after_explicit_publish_push or after_local_autosave."

fn observe_without_publishing(state: SessionPublishState) -> SessionPublishState {
  state
}

fn local_checkpoint_commit(state: SessionPublishState) -> CommitSha? {
  match state.local {
    LocalCheckpointAbsent => none
    LocalCheckpointAt { local_commit: commit } => Present { value: commit }
  }
}

fn remote_branch_head(state: SessionPublishState) -> CommitSha? {
  match state.remote_branch {
    RemoteBranchPublicationAbsent => none
    RemoteBranchPublicationAt { remote_head: head } => Present { value: head }
  }
}

fn worker_notification_head(state: SessionPublishState) -> CommitSha? {
  match state.worker {
    WorkerNotificationAbsent => none
    WorkerNotificationStamped { notified_head: head, notified_at: _ } => Present { value: head }
  }
}

data conflated_checkpoint_note: String = "THE OLD FALLBACK pr_publish_head || pr_publish_notified_head, kept only as a discriminating RED in the harness. Prefers remote branch head over worker notification head. When poll wrongly advanced RemoteBranchPublication past the last WorkerNotification stamp, drift would start from the wrong baseline. Production must call worker_notification_baseline or resolve_drift_diff_start, never this."

fn conflated_checkpoint_baseline(state: SessionPublishState) -> CommitSha? {
  match remote_branch_head(state: state) {
    Present { value: remote } => Present { value: remote }
    Absent =>
      match worker_notification_head(state: state) {
        Present { value: notified } => Present { value: notified }
        Absent =>
          match local_checkpoint_commit(state: state) {
            Present { value: local } => Present { value: local }
            Absent => Absent
          }
      }
  }
}

fn worker_notification_baseline(state: SessionPublishState) -> CommitSha? {
  worker_notification_head(state: state)
}

fn resolve_drift_diff_start(
  notified_baseline: CommitSha,
  current_head: CommitSha,
  merge_base_with_origin: CommitSha?,
  baseline_is_ancestor_of_merge_base: Bool,
) -> CommitSha {
  match merge_base_with_origin {
    Absent => notified_baseline
    Present { value: merge_base } =>
      if merge_base == notified_baseline {
        notified_baseline
      } else if baseline_is_ancestor_of_merge_base {
        merge_base
      } else {
        notified_baseline
      }
  }
}

fn drift_poll_may_run(state: SessionPublishState) -> Bool {
  match state.worker {
    WorkerNotificationAbsent => false
    WorkerNotificationStamped { notified_head: _, notified_at: _ } => true
  }
}

data immediate_policy_note: String = "Slice 1 immediate policy. Three rules, pure adjudication: scratch/probe worktree permits local checkpoint only and refuses every remote kind; dashboard autosave permits local checkpoint only; artifact healer permits bot-owned repair branch or patch artifact and refuses author-branch mutation. PublicationSubjectUnknown and HealerRepairTargetUnknown refuse remote publication — unevaluable preconditions never pass. Shell transport must call adjudicate_remote_publication before any remote write; until then the rules are modeled and witnessed only."

type RemotePublicationKind
  = RemotePushBranch
  | RemoteCreatePullRequest
  | HealerMutateAuthorBranch

type HealerRepairTarget
  = HealerRepairTargetBotBranch
  | HealerRepairTargetPatchArtifact
  | HealerRepairTargetAuthorBranch
  | HealerRepairTargetUnknown

type PublicationSubject
  = PublicationSubjectScratchProbe
  | PublicationSubjectDashboardAutosave
  | PublicationSubjectArtifactHealer { repair_target: HealerRepairTarget }
  | PublicationSubjectExplicitUserIntent
  | PublicationSubjectUnknown

type PublicationRefusalCause
  = ScratchProbeRemotePublicationForbidden
  | AutosaveRemotePublicationForbidden
  | HealerAuthorBranchMutationForbidden
  | PublicationSubjectUnknownRefused
  | HealerRepairTargetUnknownRefused
  | NoExplicitPublicationRequest
  | RemoteHeadObservationUnknownRefused
  | RemoteHeadMovedSinceObservation
  | IndexDirtyRefused
  | IndexCleanlinessUnknownRefused
  | UnmergedStagesPresent
  | UnmergedStageCountUnknownRefused
  | ConflictMarkersPresent { count: Int }
  | ConflictMarkerCountUnknownRefused
  | WriteOutsideDeclaredSet { path: String }
  | PostWriteCompileRedRefused
  | PostWriteCompileUnknownRefused
  | PeerCommitNotAuthoredByPublisherRefused
  | PeerAuthorshipUnknownRefused

type PublicationDisposition
  = PublicationPermit
  | PublicationRefuse { cause: PublicationRefusalCause }

fn publication_refusal_cause_token(cause: PublicationRefusalCause) -> String {
  match cause {
    ScratchProbeRemotePublicationForbidden => "ScratchProbeRemotePublicationForbidden"
    AutosaveRemotePublicationForbidden => "AutosaveRemotePublicationForbidden"
    HealerAuthorBranchMutationForbidden => "HealerAuthorBranchMutationForbidden"
    PublicationSubjectUnknownRefused => "PublicationSubjectUnknownRefused"
    HealerRepairTargetUnknownRefused => "HealerRepairTargetUnknownRefused"
    NoExplicitPublicationRequest => "NoExplicitPublicationRequest"
    RemoteHeadObservationUnknownRefused => "RemoteHeadObservationUnknownRefused"
    RemoteHeadMovedSinceObservation => "RemoteHeadMovedSinceObservation"
    IndexDirtyRefused => "IndexDirtyRefused"
    IndexCleanlinessUnknownRefused => "IndexCleanlinessUnknownRefused"
    UnmergedStagesPresent => "UnmergedStagesPresent"
    UnmergedStageCountUnknownRefused => "UnmergedStageCountUnknownRefused"
    ConflictMarkersPresent { count: _ } => "ConflictMarkersPresent"
    ConflictMarkerCountUnknownRefused => "ConflictMarkerCountUnknownRefused"
    WriteOutsideDeclaredSet { path: _ } => "WriteOutsideDeclaredSet"
    PostWriteCompileRedRefused => "PostWriteCompileRedRefused"
    PostWriteCompileUnknownRefused => "PostWriteCompileUnknownRefused"
    PeerCommitNotAuthoredByPublisherRefused => "PeerCommitNotAuthoredByPublisherRefused"
    PeerAuthorshipUnknownRefused => "PeerAuthorshipUnknownRefused"
  }
}

fn publication_is_permitted(disposition: PublicationDisposition) -> Bool {
  match disposition {
    PublicationPermit => true
    PublicationRefuse { cause: _ } => false
  }
}

fn adjudicate_local_checkpoint(subject: PublicationSubject) -> PublicationDisposition {
  match subject {
    PublicationSubjectScratchProbe => PublicationPermit
    PublicationSubjectDashboardAutosave => PublicationPermit
    PublicationSubjectArtifactHealer { repair_target: _ } => PublicationPermit
    PublicationSubjectExplicitUserIntent => PublicationPermit
    PublicationSubjectUnknown => PublicationRefuse { cause: PublicationSubjectUnknownRefused }
  }
}

fn adjudicate_remote_publication(
  subject: PublicationSubject,
  kind: RemotePublicationKind,
) -> PublicationDisposition {
  match subject {
    PublicationSubjectScratchProbe =>
      PublicationRefuse { cause: ScratchProbeRemotePublicationForbidden }
    PublicationSubjectDashboardAutosave =>
      PublicationRefuse { cause: AutosaveRemotePublicationForbidden }
    PublicationSubjectArtifactHealer { repair_target: target } =>
      adjudicate_healer_remote_publication(target: target, kind: kind)
    PublicationSubjectExplicitUserIntent => PublicationPermit
    PublicationSubjectUnknown =>
      PublicationRefuse { cause: PublicationSubjectUnknownRefused }
  }
}

fn adjudicate_healer_remote_publication(
  target: HealerRepairTarget,
  kind: RemotePublicationKind,
) -> PublicationDisposition {
  match target {
    HealerRepairTargetAuthorBranch =>
      PublicationRefuse { cause: HealerAuthorBranchMutationForbidden }
    HealerRepairTargetUnknown =>
      PublicationRefuse { cause: HealerRepairTargetUnknownRefused }
    HealerRepairTargetBotBranch => PublicationPermit
    HealerRepairTargetPatchArtifact =>
      match kind {
        HealerMutateAuthorBranch =>
          PublicationRefuse { cause: HealerAuthorBranchMutationForbidden }
        RemotePushBranch => PublicationPermit
        RemoteCreatePullRequest => PublicationPermit
      }
  }
}

data default_deny_conjunction_note: String = "Slice 2 default-deny consumer. admit_remote_publication runs slice-1 policy first, then a conjunction of refusals. Every arm refuses; unevaluable observations refuse rather than pass. Shell transport must call this before any remote write; until then the conjunction is modeled and witnessed only."

type PublicationRequest sole_constructor {
  requester: String
  expected_remote_head: CommitSha
  produced_head: CommitSha
}

fn mint_publication_request(
  requester: String,
  expected_remote_head: CommitSha,
  produced_head: CommitSha,
) -> PublicationRequest {
  PublicationRequest {
    requester: requester,
    expected_remote_head: expected_remote_head,
    produced_head: produced_head,
  }
}

type ObservedRemoteHead
  = RemoteHeadKnown { head: CommitSha }
  | RemoteHeadObservationUnknown

type IndexCleanliness
  = IndexClean
  | IndexDirty
  | IndexCleanlinessUnknown

type CountObservation
  = CountKnown { count: Int }
  | CountUnknown

type PostWriteCompile
  = PostWriteCompileGreen
  | PostWriteCompileRed
  | PostWriteCompileUnknown

type PeerAuthorship
  = PeerAuthoredByPublisher
  | PeerNotAuthoredByPublisher
  | PeerAuthorshipUnknown

type RemotePublishAttempt {
  subject: PublicationSubject
  kind: RemotePublicationKind
  request: PublicationRequest?
  observed_remote_head: ObservedRemoteHead
  current_remote_head: ObservedRemoteHead
  index_cleanliness: IndexCleanliness
  unmerged_stage_count: CountObservation
  conflict_marker_count: CountObservation
  declared_write_paths: List<String>
  actual_write_paths: List<String>
  post_write_compile: PostWriteCompile
  peer_authorship: PeerAuthorship
}

fn remote_head_conjunction_refusals(
  request: PublicationRequest?,
  observed: ObservedRemoteHead,
  current: ObservedRemoteHead,
) -> List<PublicationRefusalCause> {
  match request {
    Absent => []
    Present { value: req } =>
      match observed {
        RemoteHeadObservationUnknown => [RemoteHeadObservationUnknownRefused]
        RemoteHeadKnown { head: observed_head } =>
          match current {
            RemoteHeadObservationUnknown => [RemoteHeadObservationUnknownRefused]
            RemoteHeadKnown { head: current_head } =>
              if (observed_head as String) != (req.expected_remote_head as String) {
                [RemoteHeadMovedSinceObservation]
              } else if (current_head as String) != (observed_head as String) {
                [RemoteHeadMovedSinceObservation]
              } else {
                []
              }
          }
      }
  }
}

fn index_cleanliness_refusals(cleanliness: IndexCleanliness) -> List<PublicationRefusalCause> {
  match cleanliness {
    IndexClean => []
    IndexDirty => [IndexDirtyRefused]
    IndexCleanlinessUnknown => [IndexCleanlinessUnknownRefused]
  }
}

fn unmerged_stage_refusals(count_obs: CountObservation) -> List<PublicationRefusalCause> {
  match count_obs {
    CountUnknown => [UnmergedStageCountUnknownRefused]
    CountKnown { count: count } =>
      if count > 0 {
        [UnmergedStagesPresent]
      } else {
        []
      }
  }
}

fn conflict_marker_refusals(count_obs: CountObservation) -> List<PublicationRefusalCause> {
  match count_obs {
    CountUnknown => [ConflictMarkerCountUnknownRefused]
    CountKnown { count: count } =>
      if count > 0 {
        [ConflictMarkersPresent { count: count }]
      } else {
        []
      }
  }
}

fn write_set_refusals(
  declared: List<String>,
  actual: List<String>,
) -> List<PublicationRefusalCause> {
  flat_map(actual, path =>
    if contains(declared, path) {
      []
    } else {
      [WriteOutsideDeclaredSet { path: path }]
    }
  )
}

fn post_write_compile_refusals(status: PostWriteCompile) -> List<PublicationRefusalCause> {
  match status {
    PostWriteCompileGreen => []
    PostWriteCompileRed => [PostWriteCompileRedRefused]
    PostWriteCompileUnknown => [PostWriteCompileUnknownRefused]
  }
}

fn peer_authorship_refusals(authorship: PeerAuthorship) -> List<PublicationRefusalCause> {
  match authorship {
    PeerAuthoredByPublisher => []
    PeerNotAuthoredByPublisher => [PeerCommitNotAuthoredByPublisherRefused]
    PeerAuthorshipUnknown => [PeerAuthorshipUnknownRefused]
  }
}

fn remote_publish_conjunction_refusals(
  attempt: RemotePublishAttempt,
) -> List<PublicationRefusalCause> {
  append(
    match attempt.request {
      Absent => [NoExplicitPublicationRequest]
      Present { value: _ } => []
    },
    items: append(
      remote_head_conjunction_refusals(
        request: attempt.request,
        observed: attempt.observed_remote_head,
        current: attempt.current_remote_head,
      ),
      items: append(
        index_cleanliness_refusals(cleanliness: attempt.index_cleanliness),
        items: append(
          unmerged_stage_refusals(count_obs: attempt.unmerged_stage_count),
          items: append(
            conflict_marker_refusals(count_obs: attempt.conflict_marker_count),
            items: append(
              write_set_refusals(
                declared: attempt.declared_write_paths,
                actual: attempt.actual_write_paths,
              ),
              items: append(
                post_write_compile_refusals(status: attempt.post_write_compile),
                items: peer_authorship_refusals(authorship: attempt.peer_authorship),
              ),
            ),
          ),
        ),
      ),
    ),
  )
}

fn admit_remote_publication(attempt: RemotePublishAttempt) -> PublicationDisposition {
  match adjudicate_remote_publication(subject: attempt.subject, kind: attempt.kind) {
    PublicationRefuse { cause: cause } => PublicationRefuse { cause: cause }
    PublicationPermit =>
      match remote_publish_conjunction_refusals(attempt: attempt).first() {
        Absent => PublicationPermit
        Present { value: cause } => PublicationRefuse { cause: cause }
      }
  }
}
