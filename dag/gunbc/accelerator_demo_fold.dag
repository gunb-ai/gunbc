module gunbc.accelerator_demo_fold

import std.types { Int, List, Bool }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.cache_identity { ExecutionReceiptDigest }
import std.associativity_evidence {
  AssociativityEvidence,
  WitnessedAssociative,
  NotWitnessed,
  associativity_decl_ref,
  associativity_license_verdict,
  associativity_int_add_associativity_law_ref,
  associativity_int_inhabitant_ref,
  associativity_nat_add_associativity_law_ref,
  AssociativityLicenseGranted,
  AssociativityLicenseMissing,
  AssociativityLicenseCombineMismatch,
  AssociativityLicenseSubjectMismatch,
}
import std.measure { HardwareThreadCount, hardware_thread_count, hardware_thread_count_value }
import std.fold_parallelism {
  FoldParallelism,
  SerialFold,
  TreeReduce,
  serial_fold_parallelism,
  derive_tree_reduce_parallelism,
  idle_lane_count,
}

data demo_int_sum_combine_module: String = "gunbc.accelerator_demo_fold"
data demo_int_sum_combine_name: String = "demo_int_sum_combine"

fn demo_int_sum_combine(left: Int, right: Int) -> Int {
  left + right
}

fn demo_int_sum_combine_ref() -> DeclarationRef {
  associativity_decl_ref(
    module_path: demo_int_sum_combine_module,
    decl_name: demo_int_sum_combine_name
  )
}

fn demo_int_sum_not_witnessed_evidence() -> AssociativityEvidence {
  NotWitnessed
}

fn demo_int_sum_subject_bound_evidence_without_executed_receipt() -> AssociativityEvidence {
  WitnessedAssociative {
    combine: demo_int_sum_combine_ref()
    inhabitant: associativity_int_inhabitant_ref
    law: associativity_int_add_associativity_law_ref
    receipt: "unexecuted-int-add-associativity-receipt-placeholder" as ExecutionReceiptDigest
  }
}

fn demo_int_sum_nat_law_int_inhabitant_mismatch_evidence() -> AssociativityEvidence {
  WitnessedAssociative {
    combine: demo_int_sum_combine_ref()
    inhabitant: associativity_int_inhabitant_ref
    law: associativity_nat_add_associativity_law_ref
    receipt: "nat-law-int-inhabitant-mismatch-placeholder" as ExecutionReceiptDigest
  }
}

data demo_associative_fold_element_count: Int = 64

data demo_simd_lane_count: HardwareThreadCount = hardware_thread_count(count: 8)

data demo_scalar_lane_count: HardwareThreadCount = hardware_thread_count(count: 1)

fn witness_demo_tree_reduce_derives_from_simd_lanes() -> Bool {
  match derive_tree_reduce_parallelism(
    lane_count: demo_simd_lane_count,
    element_count: demo_associative_fold_element_count
  ) {
    Absent => false
    Present { value: parallelism } => match parallelism {
      SerialFold => false
      TreeReduce { tree_depth: depth, lane_width: width } =>
        hardware_thread_count_value(t: width) == 8 && depth == 3
    }
  }
}

fn witness_demo_serial_fold_at_scalar_lanes() -> Bool {
  match derive_tree_reduce_parallelism(
    lane_count: demo_scalar_lane_count,
    element_count: demo_associative_fold_element_count
  ) {
    Absent => false
    Present { value: parallelism } => match parallelism {
      TreeReduce { tree_depth: depth, lane_width: width } =>
        hardware_thread_count_value(t: width) == 1 && depth == 6
      SerialFold => false
    }
  }
}

fn witness_derive_tree_reduce_absent_at_zero_lanes() -> Bool {
  match derive_tree_reduce_parallelism(
    lane_count: hardware_thread_count(count: 0),
    element_count: demo_associative_fold_element_count
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

fn witness_associativity_license_refuses_without_executed_receipt() -> Bool {
  match associativity_license_verdict(
    evidence: demo_int_sum_subject_bound_evidence_without_executed_receipt(),
    scheduled_combine: demo_int_sum_combine_ref()
  ) {
    AssociativityLicenseMissing => true
    AssociativityLicenseGranted => false
    AssociativityLicenseCombineMismatch => false
    AssociativityLicenseSubjectMismatch => false
  }
}

fn witness_associativity_license_rejects_nat_law_int_inhabitant() -> Bool {
  match associativity_license_verdict(
    evidence: demo_int_sum_nat_law_int_inhabitant_mismatch_evidence(),
    scheduled_combine: demo_int_sum_combine_ref()
  ) {
    AssociativityLicenseSubjectMismatch => true
    AssociativityLicenseGranted => false
    AssociativityLicenseMissing => false
    AssociativityLicenseCombineMismatch => false
  }
}

fn witness_associativity_license_rejects_mismatched_combine() -> Bool {
  match associativity_license_verdict(
    evidence: demo_int_sum_subject_bound_evidence_without_executed_receipt(),
    scheduled_combine: associativity_decl_ref(
      module_path: "std.nat",
      decl_name: "nat_max"
    )
  ) {
    AssociativityLicenseCombineMismatch => true
    AssociativityLicenseGranted => false
    AssociativityLicenseMissing => false
    AssociativityLicenseSubjectMismatch => false
  }
}

fn witness_not_witnessed_evidence_refuses_license() -> Bool {
  match associativity_license_verdict(
    evidence: demo_int_sum_not_witnessed_evidence(),
    scheduled_combine: demo_int_sum_combine_ref()
  ) {
    AssociativityLicenseMissing => true
    AssociativityLicenseGranted => false
    AssociativityLicenseCombineMismatch => false
    AssociativityLicenseSubjectMismatch => false
  }
}

fn witness_idle_lane_cost_zero_at_scalar() -> Bool {
  idle_lane_count(lane_count: demo_scalar_lane_count) == 0
}

fn witness_idle_lane_cost_visible_at_simd() -> Bool {
  idle_lane_count(lane_count: demo_simd_lane_count) == 7
}
