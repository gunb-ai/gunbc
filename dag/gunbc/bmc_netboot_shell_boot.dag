module gunbc.bmc_netboot_shell_boot


data tftp_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.rfc-editor.org/rfc/rfc1350"
  }
}

// The tftp transfer semantics this boot path relies on (both busybox tftpd serving and the UEFI shell tftp command fetching) are owned by RFC 1350 (TFTP protocol revision 2) — a distinct upstream from the UEFI Shell 2.2 spec, which owns only the shell command surface.
data shell_boot_local_kernel: std.types.NonEmptyStr = "fs0:\\vmlinuz"
data shell_boot_local_initrd: std.types.NonEmptyStr = "fs0:\\initrd"

fn bmc_tftpd_serve_command(plan: gunbc.bmc_netboot_serve.BmcNetbootServePlan) -> extdeps.exec.command.ArgvCommand {
  extdeps.tools.busybox.busybox_tftpd_over_udpsvd_command(
    busybox_bin: join([plan.netboot_dir as String, "/busybox"], "") as std.types.NonEmptyStr,
    document_root: plan.netboot_dir,
  )
}

fn shell_boot_kernel_cmdline(plan: gunbc.bmc_netboot_serve.BmcNetbootServePlan) -> List<extdeps.firmware.kernel_cmdline.KernelCmdlineArg> {
  [
    extdeps.firmware.kernel_cmdline.KernelKeyValue { key: "initrd", value: "\\initrd" },
    extdeps.firmware.kernel_cmdline.KernelKeyValue { key: "ip", value: "dhcp" },
    extdeps.firmware.kernel_cmdline.KernelKeyValue { key: "url", value: extdeps.uri.uri_wire(uri: plan.bulk_iso_url) },
    extdeps.firmware.kernel_cmdline.KernelFlag { name: "autoinstall" },
    extdeps.firmware.kernel_cmdline.KernelKeyValue { key: "ds", value: gunbc.bmc_netboot_serve.bmc_netboot_seed_datasource(plan: plan) },
  ]
}

fn bmc_netboot_shell_boot_commands(plan: gunbc.bmc_netboot_serve.BmcNetbootServePlan) -> List<extdeps.firmware.uefi_shell.UefiShellCommand> {
  [
    extdeps.firmware.uefi_shell.Ifconfig { action: extdeps.firmware.uefi_shell.IfconfigSetDhcp { interface: plan.boot_interface } },
    extdeps.firmware.uefi_shell.Ping { host: plan.bmc_host },
    extdeps.firmware.uefi_shell.Tftp { interface: plan.boot_interface, server: plan.bmc_host, remote_file: "vmlinuz", local_file: shell_boot_local_kernel },
    extdeps.firmware.uefi_shell.Tftp { interface: plan.boot_interface, server: plan.bmc_host, remote_file: "initrd", local_file: shell_boot_local_initrd },
    extdeps.firmware.uefi_shell.ExecuteEfi { path: shell_boot_local_kernel, cmdline: shell_boot_kernel_cmdline(plan: plan) },
  ]
}

data srv4_shell_boot_commands: List<extdeps.firmware.uefi_shell.UefiShellCommand> = bmc_netboot_shell_boot_commands(plan: gunbc.bmc_netboot_serve.srv4_bmc_netboot_serve_plan)
