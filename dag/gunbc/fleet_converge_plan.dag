type TimerRetirementMemberAt = NonEmptyStr

data fleet_converge_plan_authority_note: String = "On-demand fleet converge PLAN authority (operator directive 2026-08-13, sleek-heron-218): membership_reconcile computes the typed hunks — MemberAdded, MemberChanged, MemberRemoved, MemberRemovalRefused — that a human reviews BEFORE apply. Plan and apply are the same spine at different poles; this module owns serialization, the content-addressed artifact, subject identity, std.temporal_effect LeaseEpoch generation protection, and the observed baseline fingerprint apply must CAS against. A plan names its subject (host + member-set fingerprint) and mints a generation-scoped lease so two applies against the same observed baseline cannot both act. Timer retirement: desired has NO fleet-converge timers; observed lists legacy units still on the host. MemberRemovalRefused arms are rendered in plan output and never filtered — they are precisely what a reviewer needs to see before approving."

type FleetConvergePlanSubject {
  host: NonEmptyStr
  member_set_fingerprint: ContentHash
}

fn fleet_converge_plan_lease_key(host: NonEmptyStr) -> NonEmptyStr {
  concat("fleet-converge-plan:", host as String) as NonEmptyStr
}

fn fleet_converge_plan_subject_identity_text(subject: FleetConvergePlanSubject) -> String {
  concat(
    concat("host:", subject.host as String),
    concat("\nmember_set:", serialize_content_hash(hash: subject.member_set_fingerprint) as String),
  )
}

fn fleet_converge_plan_resource_fingerprint(subject: FleetConvergePlanSubject) -> ContentHash {
  content_hash_of_value(value: fleet_converge_plan_subject_identity_text(subject: subject) as NonEmptyStr)
}

fn fleet_converge_plan_subject(
  host: NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  observed_spark: List<SparkServingMember>,
  observed_slots: List<RunnerSlotMember>,
  observed_fabric_cells: FabricCellPopulation,
) -> FleetConvergePlanSubject {
  FleetConvergePlanSubject {
    host: host,
    member_set_fingerprint: fleet_converge_member_set_fingerprint(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
      observed_spark: observed_spark,
      observed_slots: observed_slots,
      observed_fabric_cells: observed_fabric_cells,
    ),
  }
}

fn fleet_converge_member_set_fingerprint(
  host: NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  observed_spark: List<SparkServingMember>,
  observed_slots: List<RunnerSlotMember>,
  observed_fabric_cells: FabricCellPopulation,
) -> ContentHash {
  content_hash_of_value(
    value: observed_baseline_text(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
      observed_spark: observed_spark,
      observed_slots: observed_slots,
      observed_fabric_cells: observed_fabric_cells,
    ) as NonEmptyStr,
  )
}

fn fleet_converge_apply_subject_host_matches(planned_host: NonEmptyStr, observed_host: NonEmptyStr) -> Bool {
  planned_host == observed_host
}

fn fleet_converge_apply_subject_admits(
  planned_subject: FleetConvergePlanSubject,
  observed_host: NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  observed_spark: List<SparkServingMember>,
  observed_slots: List<RunnerSlotMember>,
  observed_fabric_cells: FabricCellPopulation,
) -> Bool {
  fleet_converge_apply_subject_host_matches(planned_host: planned_subject.host, observed_host: observed_host)
    && compare_content_hash(
      left: planned_subject.member_set_fingerprint,
      right: fleet_converge_member_set_fingerprint(
        host: observed_host,
        observed_timers: observed_timers,
        observed_caps: observed_caps,
        observed_spark: observed_spark,
        observed_slots: observed_slots,
        observed_fabric_cells: observed_fabric_cells,
      ),
    ) == ContentHashEqual
}

fn fleet_converge_plan_held_lease(
  subject: FleetConvergePlanSubject,
  prior_generation: Int,
  owner_fingerprint: ContentHash,
) -> HeldLease {
  held_lease(
    epoch: LeaseEpoch {
      lease_key: fleet_converge_plan_lease_key(host: subject.host),
      resource_fingerprint: fleet_converge_plan_resource_fingerprint(subject: subject),
      owner_fingerprint: owner_fingerprint,
      generation: prior_generation + 1,
    },
    observed: LeaseAbsent,
  )
}

fn fleet_converge_apply_generation_admits(prior_generation: Int, store_generation: Int) -> Bool {
  store_generation == prior_generation
}

fn fleet_converge_apply_generation_stale(planned_generation: Int, store_generation: Int) -> Bool {
  store_generation >= planned_generation
}

fn fleet_converge_member_set_fingerprint_matches(
  planned_fingerprint_text: String,
  host: NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  observed_spark: List<SparkServingMember>,
  observed_slots: List<RunnerSlotMember>,
  observed_fabric_cells: FabricCellPopulation,
) -> Bool {
  trim(s: planned_fingerprint_text) == (
    serialize_content_hash(
      hash: fleet_converge_member_set_fingerprint(
        host: host,
        observed_timers: observed_timers,
        observed_caps: observed_caps,
        observed_spark: observed_spark,
        observed_slots: observed_slots,
        observed_fabric_cells: observed_fabric_cells,
      ),
    ) as String
  )
}

type TimerRetirementMember {
  unit_name: NonEmptyStr
}

fn timer_member_key(m: TimerRetirementMember) -> NonEmptyStr {
  m.unit_name
}

fn timer_member_key_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  a as String == b as String
}

fn timer_member_value_eq(a: TimerRetirementMember, b: TimerRetirementMember) -> Bool {
  a.unit_name as String == b.unit_name as String
}

fn timer_member_ownership(m: TimerRetirementMember) -> Ownership? {
  Present { value: Owned }
}

fn timer_retirement_plan(observed: List<TimerRetirementMember>) -> MembershipPlan<TimerRetirementMember, TimerRetirementMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: timer_retirement_desired(),
      observed: observed,
      key_of: timer_member_key,
      key_eq: timer_member_key_eq,
      value_eq: timer_member_value_eq,
      ownership_of: timer_member_ownership,
    ),
  )
}

fn timer_member_unit_path(unit_name: NonEmptyStr) -> NonEmptyStr {
  concat("/etc/systemd/system/", unit_name as String) as NonEmptyStr
}

fn timer_retirement_desired() -> List<TimerRetirementMember> {
  []
}

fn timer_retirement_observed_legacy_srv1() -> List<TimerRetirementMember> {
  let names = deployment_spec_srv1().names
  [
    TimerRetirementMember { unit_name: fleet_converge_timer_unit_name as NonEmptyStr },
    TimerRetirementMember { unit_name: fleet_converge_service_unit_name as NonEmptyStr },
    TimerRetirementMember { unit_name: deployment_fleet_converge_timer_unit_name(names: names) },
    TimerRetirementMember { unit_name: deployment_fleet_converge_service_unit_name(names: names) },
  ]
}

fn teardown_refusal_cause_label(cause: TeardownRefusalCause) -> String {
  match cause {
    MemberNotOwned => "MemberNotOwned"
    OwnershipUnknown => "OwnershipUnknown"
    RosterDuplicateKey { roster: _ } => "RosterDuplicateKey"
  }
}

fn timer_action_line(action: MemberAction<TimerRetirementMember, TimerRetirementMemberAt>) -> String {
  match action {
    MemberAdded { at: _, to: m } => concat("ADD timer-unit ", m.unit_name as String)
    MemberChanged { at: _, from: f, to: t } =>
      concat(concat("CHANGE timer-unit ", f.unit_name as String), concat(" -> ", t.unit_name as String))
    MemberRemoved { at: _, from: m } => concat("REMOVE timer-unit ", m.unit_name as String)
    MemberRemovalRefused { from: m, cause: c } =>
      concat(
        concat("REFUSED-REMOVAL timer-unit ", m.unit_name as String),
        concat(" cause=", teardown_refusal_cause_label(cause: c)),
      )
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => "REFUSED-DUPLICATE-KEY"
  }
}

fn cap_action_line(action: MemberAction<CapMember, CapMemberAt>) -> String {
  match action {
    MemberAdded { at: _, to: m } => concat("ADD cap ", m.dropin_path as String)
    MemberChanged { at: _, from: f, to: t } =>
      concat(concat("CHANGE cap ", f.dropin_path as String), concat(" -> content drift"))
    MemberRemoved { at: _, from: m } => concat("REMOVE cap ", m.dropin_path as String)
    MemberRemovalRefused { from: m, cause: c } =>
      concat(
        concat("REFUSED-REMOVAL cap ", m.dropin_path as String),
        concat(" cause=", teardown_refusal_cause_label(cause: c)),
      )
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => "REFUSED-DUPLICATE-KEY"
  }
}

fn membership_plan_lines_timer(plan: MembershipPlan<TimerRetirementMember, TimerRetirementMemberAt>) -> List<String> {
  map(plan.actions, a => timer_action_line(action: a))
}

fn membership_plan_lines_cap(plan: MembershipPlan<CapMember, CapMemberAt>) -> List<String> {
  map(plan.actions, a => cap_action_line(action: a))
}

data slot_family_is_the_third_member_family_note: String = "THE SLOT ROSTER IS RECONCILED HERE RATHER THAN STOOD UP BY A SEPARATE SCRIPT, which is the whole point of the consolidation (operator directive 2026-08-22: this all belongs in fleet convergence). Timers and caps already flowed through membership_reconcile and slot standup did not, so the fleet had two ways to change a host: a reviewed plan artifact with a lease, a member-set fingerprint and a CAS against the observed baseline, and a hand-run provisioning path with none of those. A width change landing through the second one is unreviewed by construction.\n\nDESIRED COMES FROM THE DEPLOY ROW AND THE DEPLOY ROW DERIVES ITS WIDTH, so the roster this plan proposes is the width the admission axes committed -- not a number authored beside them. An unmodeled host emits a REFUSED line and no actions; it does not fall through to zero desired members, because zero desired against a populated host reconciles to REMOVE EVERY SLOT, which is the absorbing failure arm pointed the destructive direction.\n\nOBSERVATION REFUSAL IS UPSTREAM. gunbc.runner_slot_provision RunnerSlotsUnobserved is resolved by the caller before it reaches this module; a List<RunnerSlotMember> arriving here has already been established to be a genuine reading of the host rather than an unread one rendered as empty."

fn slot_action_line(action: MemberAction<RunnerSlotMember, RunnerSlotMemberAt>) -> String {
  match action {
    MemberAdded { at: _, to: m } => concat("ADD runner-slot ", runner_slot_member_key(m: m) as String)
    MemberChanged { at: _, from: f, to: t } =>
      concat(
        concat("CHANGE runner-slot ", runner_slot_member_key(m: f) as String),
        concat(" -> ", runner_slot_member_key(m: t) as String),
      )
    MemberRemoved { at: _, from: m } => concat("REMOVE runner-slot ", runner_slot_member_key(m: m) as String)
    MemberRemovalRefused { from: m, cause: c } =>
      concat(
        concat("REFUSED-REMOVAL runner-slot ", runner_slot_member_key(m: m) as String),
        concat(" cause=", teardown_refusal_cause_label(cause: c)),
      )
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => "REFUSED-DUPLICATE-KEY"
  }
}

type FleetConvergeSlotFamily
  = SlotFamilyPlanned { plan: RunnerSlotProvisionPlan }
  | SlotFamilyUnmodeledHost { host: HostIdentity }
  | SlotFamilyArtifactUnpublished { host: HostIdentity }

// ONE RESOLUTION FEEDS BOTH THE REVIEW LINES AND THE APPLY SCRIPT, which is not tidiness -- it is
// the property the whole plan/apply split rests on. If the renderer and the actuator each resolved
// the host and reconciled the roster on their own, the reviewer could approve one membership and
// apply could execute a different one, and the bundle hash would not catch it because both halves
// would be internally consistent. Resolving once and deriving both projections makes that
// disagreement unrepresentable rather than checked.
fn fleet_converge_slot_family(
  host: NonEmptyStr,
  observed_slots: List<RunnerSlotMember>,
) -> FleetConvergeSlotFamily {
  match runner_host_deploy_for(host: host as HostIdentity) {
    RunnerHostDeployUnmodeled { host: h } => SlotFamilyUnmodeledHost { host: h }
    RunnerHostDeployFound { deploy: d } =>
      match actions_runner_binary_artifact_for_arch(
        binary_release: actions_runner_release_2_334_0,
        arch: altra_max_m12830_catalog.architecture,
      ) {
        Absent => SlotFamilyArtifactUnpublished { host: host as HostIdentity }
        Present { value: a } =>
          SlotFamilyPlanned {
            plan: runner_slot_provision_plan(deploy: d, artifact: a, observed: observed_slots),
          }
      }
  }
}

// THE FABRIC CELL FAMILY IS A SIBLING OF THE GitHub RUNNER SLOT FAMILY, NOT A FILTER OVER IT.
//
// Its desired population comes from gunbc.runner_slot_allocation's exact fabric identities, and it
// shares with the slot family exactly one thing: the RunnerSlotIdentity that names the physical
// cell. It routes through none of runner_host_deploy_for, actions_runner_binary_artifact_for_arch
// or runner_slot_provision_plan -- those are the GitHub family's facts, and a fabric cell that
// resolved through them would be a fabric executor provisioned from an Actions runner release.
//
// THE OBSERVED SIDE IS A TYPED POPULATION RATHER THAN A BARE LIST, AND THAT IS THE WHOLE REASON
// THIS ARM EXISTS. The sibling families take List<Member> and a caller with no observer passes the
// empty list, which reconcile then reads as "the host has none of these" and plans a full install.
// For a family whose resources are a cgroup and two directories that is the empty-observation
// narrow: a probe that could not read the host is indistinguishable from a host that has nothing,
// and the two have opposite remedies. FabricCellPopulation makes them different values, so an
// unreadable cell stops the line here instead of arriving as work to do.
// PLANNED WORK WITH NO REALIZER IS A REFUSAL, NOT A ZERO-REFUSAL PLAN.
//
// AN EARLIER REVISION OF THIS FAMILY HAD A LATENT FAIL-OPEN AT THE ACTUATION SEAM, and it was latent
// only because the CLI has no observer yet. An observed-empty population produces an ordinary
// MembershipPlan with three MemberAdded actions; those render as ADD lines; the apply shell emits
// them as comments; and the refusal count -- being the MEMBERSHIP refusal count -- is zero. So the
// modeled state was "three additions due, zero refusals, zero host effects, apply completes", which
// is a plan reporting work as applied that nothing performs. Landing the observer alone would have
// turned that live on its first honest empty read.
//
// So the family has a third arm. Actions due with no host-effect realizer is REFUSED-REALIZATION:
// typed, counted, rendered in the plan and in the apply shell, and never representable as an
// ordinary converged plan. The arm carries the actions it refused to realize so the reviewer sees
// exactly what is owed.
//
// WHY THIS IS AN ARM RATHER THAN A CHECK: the alternative is a rule somewhere that says "if the
// fabric plan is nonempty and no realizer exists, refuse", which concedes that the converged-looking
// state is writable and catches it afterwards. With the arm, a fabric plan carrying actions has no
// spelling that also reports zero refusals.
//
// DISSOLVE-ON: the fabric cell host-effect realizer. When it lands, this arm's condition becomes
// unreachable for realizable actions and it narrows to whatever remains genuinely unrealizable.
type FleetConvergeFabricCellFamily
  = FabricCellFamilyConvergedNoActions
  | FabricCellFamilyRealizationUnavailable { planned: MembershipPlan<FabricCellMember, String> }
  | FabricCellFamilyObservationRefused { cause: String }

fn fleet_converge_fabric_cell_family(
  host: NonEmptyStr,
  observed_fabric_cells: FabricCellPopulation,
) -> FleetConvergeFabricCellFamily {
  match observed_fabric_cells {
    FabricCellPopulationObservationRefused { host: h, blocked: _ } =>
      FabricCellFamilyObservationRefused {
        cause: concat(
          "fabric cell observation refused for host=",
          h as String,
          "; the host was not read, so its substrate state is unknown and no membership may be planned against it",
        )
      }
    FabricCellPopulationObserved { host: _, members: observed } =>
      let planned = membership_plan_admitting_outcome(
        outcome: membership_reconcile(
          desired: fabric_cell_desired_members(host: host as HostIdentity),
          observed: observed,
          key_of: fabric_cell_member_key,
          key_eq: fabric_cell_member_key_eq,
          value_eq: fabric_cell_member_value_eq,
          ownership_of: fabric_cell_member_ownership,
        )
      )
      if list_length(items: planned.actions) == 0 {
        FabricCellFamilyConvergedNoActions
      } else {
        FabricCellFamilyRealizationUnavailable { planned: planned }
      }
  }
}

// THE REFUSAL IS RENDERED FOR THE REVIEWER RATHER THAN FILTERED, exactly as MemberRemovalRefused is.
// A plan that silently omitted the fabric family when its observation failed would read as "no
// fabric work to do", which is the same wrong answer the typed population exists to prevent, one
// layer further out. And an action this family cannot realize is rendered as the refusal it is,
// never as an ADD line a reader would take for work that will happen.
fn fleet_converge_fabric_cell_lines(
  host: NonEmptyStr,
  observed_fabric_cells: FabricCellPopulation,
) -> List<String> {
  match fleet_converge_fabric_cell_family(host: host, observed_fabric_cells: observed_fabric_cells) {
    FabricCellFamilyObservationRefused { cause: c } =>
      [concat("REFUSED-OBSERVATION fabric-cell ", c)]
    FabricCellFamilyConvergedNoActions => []
    FabricCellFamilyRealizationUnavailable { planned: p } =>
      map(p.actions, a => concat("REFUSED-REALIZATION ", fabric_cell_action_line(action: a)))
  }
}

// EVERY UNREALIZABLE ACTION COUNTS AS A REFUSAL, not one refusal for the family. The count is what
// makes the deficit's frequency visible, and the deficit is per unit of work owed: three resources
// that cannot be provisioned is three pieces of undone work, not one inconvenience.
fn fleet_converge_fabric_cell_refusal_count(
  host: NonEmptyStr,
  observed_fabric_cells: FabricCellPopulation,
) -> Int {
  match fleet_converge_fabric_cell_family(host: host, observed_fabric_cells: observed_fabric_cells) {
    FabricCellFamilyObservationRefused { cause: _ } => 1
    FabricCellFamilyConvergedNoActions => 0
    FabricCellFamilyRealizationUnavailable { planned: p } => list_length(items: p.actions)
  }
}

fn fabric_cell_action_line(action: MemberAction<FabricCellMember, String>) -> String {
  match action {
    MemberAdded { at: _, to: t } =>
      concat("ADD fabric-cell ", fabric_cell_member_key(member: t))
    MemberChanged { at: _, from: _, to: t } =>
      concat("CHANGE fabric-cell ", fabric_cell_member_key(member: t))
    MemberRemoved { at: _, from: f } =>
      concat("REMOVE fabric-cell ", fabric_cell_member_key(member: f))
    MemberRemovalRefused { from: f, cause: _ } =>
      concat("REFUSED-REMOVAL fabric-cell ", fabric_cell_member_key(member: f))
    MemberRosterDuplicateKeyRefused { roster: _, first: f, duplicate: _ } =>
      concat("REFUSED-DUPLICATE-KEY fabric-cell ", fabric_cell_member_key(member: f))
  }
}

fn fleet_converge_slot_lines(
  host: NonEmptyStr,
  observed_slots: List<RunnerSlotMember>,
) -> List<String> {
  match fleet_converge_slot_family(host: host, observed_slots: observed_slots) {
    SlotFamilyUnmodeledHost { host: h } =>
      [concat("REFUSED-UNMODELED-HOST runner-slot host=", h as String)]
    SlotFamilyArtifactUnpublished { host: h } =>
      [concat("REFUSED-NO-PUBLISHED-RUNNER-BINARY runner-slot host=", h as String)]
    SlotFamilyPlanned { plan: p } => map(p.membership.actions, a => slot_action_line(action: a))
  }
}

// SLOT ADD IS THE ONE MEMBER FAMILY THIS SCRIPT ACTUALLY EXECUTES BESIDE TIMER TEARDOWN, and the
// reason is principal, not appetite. Cap drop-ins live under /etc/systemd and belong to the
// deploy principal (fleet_converge_cap_apply_shell_note); slot directories live under the runner
// user's own /opt/actions-runner, which is exactly the principal converge already runs as. So
// emitting ADD here is converge acting within its own authority rather than reaching outside it.
//
// REMOVE AND CHANGE EMIT NOTHING, AND THAT IS THE FAIL-CLOSED ARM RATHER THAN AN OVERSIGHT.
// gunbc.runner_slot_provision runner_slot_member_ownership returns Absent for every observed slot
// because no provenance signal exists yet to tell a gunbc-managed directory from one somebody put
// there by hand. Reconcile therefore yields MemberRemovalRefused rather than MemberRemoved, those
// refusals ARE rendered into plan.txt for the reviewer, and nothing deletes a directory whose
// ownership was never established. Teardown becomes emittable when the provenance signal lands,
// not before.
//
// AN UNMODELED HOST STOPS THE SCRIPT RATHER THAN CONTRIBUTING NO LINES. Silence here would be
// indistinguishable from "this host had nothing to do", so apply would report success for a host it
// could not identify -- the fabricated plausible output at the actuation seam. The emitted exit is
// the line-stop.
// AN UNMODELED HOST COUNTS AS A REFUSAL RATHER THAN AS ZERO REFUSALS. Zero is what a reviewer reads
// as "nothing was refused on this axis", and a host nobody modeled is the largest refusal the slot
// family can produce -- so reporting it as zero would make the most severe state look like the
// cleanest one.
fn fleet_converge_slot_refusal_count(
  host: NonEmptyStr,
  observed_slots: List<RunnerSlotMember>,
) -> Int {
  match fleet_converge_slot_family(host: host, observed_slots: observed_slots) {
    SlotFamilyUnmodeledHost { host: _ } => 1
    SlotFamilyArtifactUnpublished { host: _ } => 1
    SlotFamilyPlanned { plan: p } => membership_refusal_count(plan: p.membership)
  }
}

fn slot_apply_lines(
  host: NonEmptyStr,
  observed_slots: List<RunnerSlotMember>,
) -> List<String> {
  match fleet_converge_slot_family(host: host, observed_slots: observed_slots) {
    SlotFamilyUnmodeledHost { host: h } =>
      [
        concat(
          "echo 'fleet_converge_apply: REFUSED-UNMODELED-HOST runner-slot host=",
          concat(h as String, "' >&2"),
        ),
        "exit 1",
      ]
    SlotFamilyArtifactUnpublished { host: h } =>
      [
        concat(
          "echo 'fleet_converge_apply: REFUSED-NO-PUBLISHED-RUNNER-BINARY runner-slot host=",
          concat(h as String, "' >&2"),
        ),
        "exit 1",
      ]
    SlotFamilyPlanned { plan: p } =>
      if membership_added_count(plan: p.membership) == 0 {
        ["# runner-slot: no slots to add"]
      } else {
        concat([p.base_dir_script], p.upsert_extract_scripts)
      }
  }
}

fn fleet_converge_desired_caps() -> List<CapMember> {
  let slot = gunbc_runner_slot_desired()
  [
    desired_cap_member(
      dropin_path: gunbc_runner_per_slot_dropin_path as NonEmptyStr,
      property: systemd_memory_max_property,
      bytes_value: to_string(byte_size_count(b: slot.memory_max)) as NonEmptyStr,
    ),
    desired_cap_member(
      dropin_path: gunbc_runner_per_slot_high_dropin_path as NonEmptyStr,
      property: systemd_memory_high_property,
      bytes_value: to_string(byte_size_count(b: slot.memory_high)) as NonEmptyStr,
    ),
    desired_cap_member(
      dropin_path: gunbc_runner_per_slot_swap_dropin_path as NonEmptyStr,
      property: systemd_memory_swap_max_property,
      bytes_value: to_string(byte_size_count(b: slot.memory_swap_max)) as NonEmptyStr,
    ),
    desired_cap_member(
      dropin_path: gunbc_runner_per_slot_tasks_dropin_path as NonEmptyStr,
      property: systemd_tasks_max_property,
      bytes_value: to_string(slot.tasks_max) as NonEmptyStr,
    ),
  ]
}

// THE OBSERVED SPARK POPULATION IS PART OF THE COMPARE-AND-SWAP BASELINE.
//
// It was not, and the consequence was specific rather than theoretical: the baseline fingerprinted
// host, timers and caps only, so a Spark member could change between plan and apply -- a model
// replaced, a unit rewritten, linger turned off -- WITHOUT invalidating the approved plan. The lease
// would still admit, and apply would execute operations planned against a state that no longer held.
//
// Freezing the operations (above) closed the other half of that: apply executes exactly what plan
// admitted. This closes the half the freeze cannot reach, because a frozen operation is only as
// good as the baseline it was planned against. Each member contributes its ADDRESS and its
// state_digest -- the address alone would let a value change without moving the fingerprint, which
// is precisely the drift being guarded.
// AN UNREADABLE FABRIC POPULATION CONTRIBUTES A ROW, NOT AN ABSENCE OF ROWS, AND THAT IS THE POINT
// OF CARRYING THE TYPED POPULATION THIS FAR IN. If the refused arm rendered nothing, the baseline of
// a host whose cells could not be read would be byte-identical to the baseline of a host observed to
// have no cells -- two states with opposite remedies hashing to one fingerprint, so a plan approved
// under one would admit under the other. The cause is in the row because the cause is part of what
// was observed: "we could not read it, for this reason" is the observation.
// THE REFUSAL BASELINE NAMES EVERY BLOCKED ADDRESS AND ITS CAUSE, not just that a refusal happened.
//
// A single "observation refused" row makes two hosts blocked for different reasons at different
// addresses hash identically, so a plan approved while the cgroup was unreadable would admit later
// while the attempt root was unreadable instead. The baseline exists to make the approved state and
// the applied state the same state; a refusal is part of that state, and its shape is part of the
// refusal.
fn fabric_cell_disposition_baseline_row(d: FabricCellAddressDisposition) -> String {
  match d {
    AddressUnreadable { ref: r, cause: c } =>
      concat(fabric_cell_address_ref_wire(ref: r), "=unreadable:", c)
    AddressContradicted { ref: r } =>
      concat(fabric_cell_address_ref_wire(ref: r), "=contradicted")
    AddressUnobserved { ref: r } =>
      concat(fabric_cell_address_ref_wire(ref: r), "=unobserved")
    AddressMissingOnHost { ref: r } =>
      concat(fabric_cell_address_ref_wire(ref: r), "=missing")
    AddressPresent { ref: r, member: m } =>
      concat(fabric_cell_address_ref_wire(ref: r), "=present:", m.state_digest as String)
  }
}

fn fabric_cell_baseline_rows(population: FabricCellPopulation) -> List<String> {
  match population {
    FabricCellPopulationObserved { host: _, members: ms } =>
      map(ms, m => concat(
        "fabric-cell:", fabric_cell_member_key(member: m), "=", m.state_digest as String,
      ))
    FabricCellPopulationObservationRefused { host: h, blocked: b } =>
      concat(
        [concat("fabric-cell-observation-refused:", h as String)],
        map(b, d => concat("fabric-cell-observation-blocked:", fabric_cell_disposition_baseline_row(d: d))),
      )
  }
}

fn observed_baseline_text(
  host: NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  observed_spark: List<SparkServingMember>,
  observed_slots: List<RunnerSlotMember>,
  observed_fabric_cells: FabricCellPopulation,
) -> String {
  join(
    concat(
      concat(
        concat(
          [concat("host:", host as String)],
          map(observed_timers, m => concat("timer:", m.unit_name as String)),
        ),
        concat(
          concat(
            map(observed_caps, c => concat("cap:", c.dropin_path as String, "=", c.content)),
            map(observed_spark, m => concat(
              "spark:", spark_serving_member_key(member: m), "=", m.state_digest as String,
            )),
          ),
          map(observed_slots, m => concat("slot:", runner_slot_member_key(m: m) as String)),
        ),
      ),
      fabric_cell_baseline_rows(population: observed_fabric_cells),
    ),
    "\n",
  )
}

// THE ROW FREEZES WHAT APPLY EXECUTES, not merely what it should figure out.
//
// The row used to carry the action and its effects only. `WriteUserUnitFile` is a bare variant with
// no bytes, so apply resolved the unit content, path and mode from the repository's CURRENT
// authorities at execution time -- and the bundle hash could not detect a plan/apply divergence
// because the bytes were never in the bundle. Freezing the realized operations closes that: what the
// plan admitted is exactly what runs.
// THE OPERATION LIST IS STRUCTURALLY NONEMPTY, head plus tail.
//
// It was `operations: List<RemoteOperation>` guarded by an apply-time check reading "there are
// effects and the aggregate operation list is empty". That check is over AGGREGATES, so it does not
// catch the case it exists for: one row carrying effects and ZERO operations, sitting beside another
// row that has operations. The totals are both nonzero, the check passes, and that row's effect is
// reported applied while nothing ran for it -- a fabricated plausible output at the actuation seam.
//
// Head plus tail removes the state instead of catching it (DESIGN section 5, construction over
// validation): a row with no operations has no constructor, so the aggregate check is not tightened,
// it is unnecessary. The same shape StagedIntermediates uses, for the same reason.
//
// EACH EFFECT OWNS ITS OWN OPERATIONS.
//
// The row previously carried two PARALLEL populations: a list of effects, and one flat operation
// sequence covering all of them. That guaranteed the row was nonempty and nothing more -- there was
// no relation between the two lists, so a row carrying three effects could not say which operation
// belonged to which, and no apply receipt could report "the download succeeded, the digest verified,
// the extraction failed" against the effect that owns those steps.
//
// Parallel lists are also the shape that goes wrong silently as the sequences get long. A short
// linger effect contributing one argv and a runtime install contributing nine cannot be told apart
// in a flat list of ten, so a receipt has to guess an attribution, and a guess at the actuation seam
// is the fabricated plausible output this lane keeps closing one layer down.
//
// The relation is now structural: one execution binds one effect to the operations that realize it,
// head plus tail, so an effect with zero operations has no constructor. Ordering is preserved in
// both directions -- executions in effect order, operations in realization order within each -- and
// the flat sequence the actuator consumes is DERIVED by concatenation rather than stored beside the
// executions, so the two cannot disagree.
type PlannedEffectExecution {
  effect: ServingInstallEffect
  first_step: PlannedRemoteStep
  further_steps: List<PlannedRemoteStep>
}

fn planned_effect_execution_steps(x: PlannedEffectExecution) -> List<PlannedRemoteStep> {
  concat([x.first_step], x.further_steps)
}

// The row is nonempty in EXECUTIONS now rather than in operations, and each execution is nonempty in
// operations. A row with no executions is unwritable for the same reason a row with no operations
// was: it would report its effects applied while nothing ran for them.
type FleetConvergeSparkServingTypedAction {
  action: MemberAction<SparkServingMember, SparkServingMemberAt>,
  first_execution: PlannedEffectExecution
  further_executions: List<PlannedEffectExecution>
}

fn fleet_converge_spark_serving_row_executions(
  row: FleetConvergeSparkServingTypedAction,
) -> List<PlannedEffectExecution> {
  concat([row.first_execution], row.further_executions)
}

// The effect roster is DERIVED from the executions rather than stored, which is what retires the
// parallel-population defect: there is no second list to fall out of step with the first.
fn fleet_converge_spark_serving_row_effects(
  row: FleetConvergeSparkServingTypedAction,
) -> List<ServingInstallEffect> {
  map(fleet_converge_spark_serving_row_executions(row: row), x => x.effect)
}

fn fleet_converge_spark_serving_row_steps(
  row: FleetConvergeSparkServingTypedAction,
) -> List<PlannedRemoteStep> {
  flat_map(
    fleet_converge_spark_serving_row_executions(row: row),
    x => planned_effect_execution_steps(x: x),
  )
}

// The bare operations, for the consumers that hash or count them. Deliberately DERIVED from the
// steps rather than stored, so the identities and the operations cannot describe different work.
fn fleet_converge_spark_serving_row_operations(
  row: FleetConvergeSparkServingTypedAction,
) -> List<RemoteOperation> {
  map(fleet_converge_spark_serving_row_steps(row: row), st => st.operation)
}

type FleetConvergePlanArtifact {
  subject: FleetConvergePlanSubject
  prior_generation: Int
  plan_lease: HeldLease
  observed_baseline_hex: Fnv1a64StructuralDigestHex
  plan_body: String
  apply_shell: String
  spark_serving_typed_actions: ScheduledRows<FleetConvergeSparkServingTypedAction>
}

// NO WILDCARD. The wildcard is what made ServingInstallEffect extensible in silence: a thirteenth
// variant would have landed as "UnmodeledServingInstallEffect" and read as a legitimate wire label
// that simply missed. Every variant now names itself, so the wire string says WHICH effect was
// asked for, and adding a variant makes this match non-exhaustive rather than defaulting.
// Behaviour for the implemented slice is unchanged: EnableLingerForOwnAccount is still the only
// effect the linger vertical realizes.
fn fleet_converge_spark_serving_effect_wire(effect: ServingInstallEffect) -> String {
  match effect {
    EnableLingerForOwnAccount => "EnableLingerForOwnAccount"
    WriteSystemUnitFile => "WriteSystemUnitFile"
    ReloadSystemManager => "ReloadSystemManager"
    EnableSystemUnit => "EnableSystemUnit"
    WriteUserUnitFile => "WriteUserUnitFile"
    ReloadUserManager => "ReloadUserManager"
    EnableUserUnit => "EnableUserUnit"
    StartUserUnit => "StartUserUnit"
    InstallRuntimePackage => "InstallRuntimePackage"
    InstallOwnedRuntimeClosure => "InstallOwnedRuntimeClosure"
    MaterializeModelArtifact => "MaterializeModelArtifact"
    GrantContainerRuntimeAccess => "GrantContainerRuntimeAccess"
    RunContainerAsOwnUser => "RunContainerAsOwnUser"
  }
}

fn fleet_converge_spark_serving_action_kind(action: MemberAction<SparkServingMember, SparkServingMemberAt>) -> String {
  match action {
    MemberAdded { at: _, to: _ } => "ADD"
    MemberChanged { at: _, from: _, to: _ } => "CHANGE"
    MemberRemoved { at: _, from: _ } => "REMOVE"
    MemberRemovalRefused { from: _, cause: _ } => "REFUSED-REMOVAL"
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => "REFUSED-DUPLICATE-KEY"
  }
}

// THE MEMBER VALUES ARE IN THE WIRE, NOT ONLY THE MEMBER KEY.
//
// `spark_serving_member_key` is host x principal x ADDRESS -- deliberately, because that is the
// stable identity reconcile keys on. But the hash needs the VALUE too: with the key alone, a row
// whose `to` digest changed from one model manifest to another serializes identically, so the
// approved artifact would still admit after the very drift the CAS baseline exists to catch. Key
// answers "which resource"; the digests answer "from what, to what", and an approval is about both.
//
// `from` is rendered explicitly as absent where the arm has none, rather than omitted, so an add and
// a change to the same value cannot collide on one string.
fn fleet_converge_spark_serving_action_state_wire(
  action: MemberAction<SparkServingMember, SparkServingMemberAt>,
) -> String {
  match action {
    MemberAdded { at: _, to: m } => join([" from=<none> to=", m.state_digest as String], "")
    MemberChanged { at: _, from: f, to: m } =>
      join([" from=", f.state_digest as String, " to=", m.state_digest as String], "")
    MemberRemoved { at: _, from: f } => join([" from=", f.state_digest as String, " to=<none>"], "")
    MemberRemovalRefused { from: f, cause: c } =>
      join([" from=", f.state_digest as String, " to=<refused> cause=", c], "")
    MemberRosterDuplicateKeyRefused { roster: _, first: f, duplicate: d } =>
      join([" first=", f.state_digest as String, " duplicate=", d.state_digest as String], "")
  }
}

fn fleet_converge_spark_serving_action_line(row: FleetConvergeSparkServingTypedAction) -> String {
  let member = match row.action {
    MemberAdded { at: _, to: m } => m
    MemberChanged { at: _, from: _, to: m } => m
    MemberRemoved { at: _, from: m } => m
    MemberRemovalRefused { from: m, cause: _ } => m
    MemberRosterDuplicateKeyRefused { roster: _, first: f, duplicate: _ } => f
  }
  join(
    [
      fleet_converge_spark_serving_action_kind(action: row.action),
      " spark-serving ",
      spark_serving_member_key(member: member),
      fleet_converge_spark_serving_action_state_wire(action: row.action),
      " effects=",
      join(map(fleet_converge_spark_serving_row_effects(row: row), e => fleet_converge_spark_serving_effect_wire(effect: e)), ","),
      " ops=",
      remote_operations_wire(operations: fleet_converge_spark_serving_row_operations(row: row)),
    ],
    "",
  )
}

fn fleet_converge_spark_serving_typed_actions_wire(
  rows: List<FleetConvergeSparkServingTypedAction>,
) -> String {
  join(map(rows, r => fleet_converge_spark_serving_action_line(row: r)), ";")
}

data fleet_converge_spark_typed_actions_wire_empty_canonical: NonEmptyStr = "spark-serving-typed-actions-wire-empty"

fn fleet_converge_spark_typed_actions_wire_structural_hash(wire: String) -> Fnv1a64Structural? {
  if wire == "" {
    match content_hash_of_value(value: fleet_converge_spark_typed_actions_wire_empty_canonical) {
      Fnv1a64(structural) => Present { value: structural }
      _ => Absent
    }
  } else {
    match content_hash_of_value(value: wire as NonEmptyStr) {
      Fnv1a64(structural) => Present { value: structural }
      _ => Absent
    }
  }
}

fn fleet_converge_plan_body_claims_spark_typed_actions(plan_body: String) -> Bool {
  string_contains(s: plan_body, pattern: "# spark-serving-typed-actions:")
}

fn fleet_converge_plan_spark_typed_actions_consistency_admits(
  plan_body: String,
  spark_serving_typed_actions: ScheduledRows<FleetConvergeSparkServingTypedAction>,
) -> Bool {
  let body_claims = fleet_converge_plan_body_claims_spark_typed_actions(plan_body: plan_body)
  if length(scheduled_rows_list(scheduled: spark_serving_typed_actions)) > 0 && !body_claims {
    false
  } else {
    true
  }
}

fn fleet_converge_plan_body_structural_hash(plan_body: String) -> Fnv1a64Structural? {
  match content_hash_of_value(value: plan_body as NonEmptyStr) {
    Fnv1a64(structural) => Present { value: structural }
    _ => Absent
  }
}

fn fleet_converge_plan_apply_shell_structural_hash(apply_shell: String) -> Fnv1a64Structural? {
  match content_hash_of_value(value: apply_shell as NonEmptyStr) {
    Fnv1a64(structural) => Present { value: structural }
    _ => Absent
  }
}

fn fleet_converge_plan_bundle_v1_structural_hash(plan_body: String, apply_shell: String) -> Fnv1a64Structural? {
  match fleet_converge_plan_body_structural_hash(plan_body: plan_body) {
    Present { value: plan_struct } =>
      match fleet_converge_plan_apply_shell_structural_hash(apply_shell: apply_shell) {
        Present { value: shell_struct } =>
          Present {
            value: content_hash_combine_structural(left: plan_struct, right: shell_struct),
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn fleet_converge_plan_bundle_structural_hash(
  plan_body: String,
  apply_shell: String,
  spark_typed_actions_wire: String,
) -> Fnv1a64Structural? {
  match fleet_converge_plan_bundle_v1_structural_hash(plan_body: plan_body, apply_shell: apply_shell) {
    Present { value: bundle_v1 } =>
      match fleet_converge_spark_typed_actions_wire_structural_hash(wire: spark_typed_actions_wire) {
        Present { value: spark_struct } =>
          Present {
            value: content_hash_combine_structural(left: bundle_v1, right: spark_struct),
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn fleet_converge_plan_bundle_digest_hex(
  plan_body: String,
  apply_shell: String,
  spark_typed_actions_wire: String,
) -> Fnv1a64StructuralDigestHex? {
  match fleet_converge_plan_bundle_structural_hash(
    plan_body: plan_body,
    apply_shell: apply_shell,
    spark_typed_actions_wire: spark_typed_actions_wire,
  ) {
    Present { value: bundle } => Present { value: bundle.digest }
    Absent => Absent
  }
}

fn fleet_converge_plan_bundle_matches(
  plan_body: String,
  apply_shell: String,
  spark_typed_actions_wire: String,
  claimed_hex: String,
) -> Bool {
  match fleet_converge_plan_bundle_digest_hex(
    plan_body: plan_body,
    apply_shell: apply_shell,
    spark_typed_actions_wire: spark_typed_actions_wire,
  ) {
    Present { value: computed } => trim(s: claimed_hex) == computed as String
    Absent => false
  }
}

fn fleet_converge_plan_bundle_v1_matches(plan_body: String, apply_shell: String, claimed_hex: String) -> Bool {
  match fleet_converge_plan_bundle_v1_structural_hash(plan_body: plan_body, apply_shell: apply_shell) {
    Present { value: bundle } => trim(s: claimed_hex) == bundle.digest as String
    Absent => false
  }
}

fn fleet_converge_plan_content_hash(plan_body: String) -> Fnv1a64StructuralDigestHex? {
  match fleet_converge_plan_body_structural_hash(plan_body: plan_body) {
    Present { value: structural } => Present { value: structural.digest }
    Absent => Absent
  }
}

fn fleet_converge_plan_artifact_hash(artifact: FleetConvergePlanArtifact) -> Fnv1a64StructuralDigestHex? {
  fleet_converge_plan_bundle_digest_hex(
    plan_body: artifact.plan_body,
    apply_shell: artifact.apply_shell,
    spark_typed_actions_wire: fleet_converge_spark_serving_typed_actions_wire(
      rows: scheduled_rows_list(scheduled: artifact.spark_serving_typed_actions),
    ),
  )
}

fn fleet_converge_plan_artifact_bundle_admits(artifact: FleetConvergePlanArtifact, claimed_hex: String) -> Bool {
  fleet_converge_plan_spark_typed_actions_consistency_admits(
    plan_body: artifact.plan_body,
    spark_serving_typed_actions: artifact.spark_serving_typed_actions,
  )
    && fleet_converge_plan_bundle_matches(
      plan_body: artifact.plan_body,
      apply_shell: artifact.apply_shell,
      spark_typed_actions_wire: fleet_converge_spark_serving_typed_actions_wire(
        rows: scheduled_rows_list(scheduled: artifact.spark_serving_typed_actions),
      ),
      claimed_hex: claimed_hex,
    )
}

data fleet_converge_apply_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: fleet_converge_apply_shell — concat-built bash apply runner for timer retirement only (sudo systemctl disable/rm + daemon-reload); cap drop-in mutations are live_deploy deploy-principal authority (host_axis_caps_note) and are plan-output-only here; generation compare+apply+commit runs under flock in fleet_converge_locked_apply_script; subject-host / member-set / observed-baseline gates live in fleet_converge_apply_wet before the locked transport; DISSOLVES WHEN bash-emit or host_effect_apply realizes timer teardown and lease acquisition without medium-as-string concat")

data fleet_converge_apply_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_converge_plan",
    decl_name: "fleet_converge_apply_shell_emit_dissolution_trigger",
    field: WholeDeclaration,
  },
}

fn timer_retirement_disable_line(unit_name: NonEmptyStr) -> String {
  concat("sudo -n systemctl disable --now ", unit_name as String)
}

fn timer_retirement_remove_line(unit_name: NonEmptyStr) -> String {
  concat("sudo -n rm -f /etc/systemd/system/", unit_name as String)
}

fn cap_apply_line(action: MemberAction<CapMember, CapMemberAt>) -> String {
  match action {
    MemberAdded { at: _, to: m } => cap_upsert_script(m: m)
    MemberChanged { at: _, from: _, to: t } => cap_upsert_script(m: t)
    MemberRemoved { at: _, from: m } => concat("rm -f ", m.dropin_path as String)
    MemberRemovalRefused { from: _, cause: _ } => ""
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => ""
  }
}

data fleet_converge_cap_apply_shell_note: String = "Cap MemberAdded/Changed/Removed arms are rendered in plan.txt for human review but are NOT emitted into apply.sh — PerSlotMemoryCap drop-in writes are live_deploy deploy-principal authority (host_axis_caps host_axis_caps_note); converge on the operator runner does not sudo-write /etc/systemd drop-ins."

fn timer_apply_lines(plan: MembershipPlan<TimerRetirementMember, TimerRetirementMemberAt>) -> List<String> {
  flat_map(plan.actions, a =>
    match a {
      MemberRemoved { at: _, from: m } =>
        [timer_retirement_disable_line(unit_name: m.unit_name), timer_retirement_remove_line(unit_name: m.unit_name)]
      MemberRemovalRefused { from: _, cause: _ } => []
      MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => []
      MemberAdded { at: _, to: _ } => []
      MemberChanged { at: _, from: _, to: _ } => []
    }
  )
}

data fleet_converge_generation_store_path: String = "/var/lib/gunbc/fleet-converge/plan_generation"

fn fleet_converge_parse_nonneg_generation_text(content: String) -> Int? {
  let trimmed = trim(s: content)
  if trimmed == "" {
    none
  } else {
    match parse_int(s: trimmed) {
      Present { value: n } =>
        if n >= 0 {
          Present { value: n }
        } else {
          none
        }
      Absent => none
    }
  }
}

// AN UNREADABLE STORE IS NOT A STORE THAT SAYS ZERO, AND A STORE THAT DOES NOT EXIST YET IS
// NEITHER OF THOSE. fleet_converge_generation_from_store_content used to answer `Int?` over two
// inputs and fold three states into two: it returned Present{0} whenever the read had not
// succeeded, so "no store yet, this host has never applied" and "the store is there and I could
// not read it" produced the same number, and only a corrupt-but-readable store refused. That is
// the empty-observation narrow (DESIGN, recurring failure modes) pointed at a lease guard: ⊥-as-
// answer conflated with ⊥-as-ignorance, on the value that decides whether a converge apply may
// proceed.
//
// So the observation carries three variants and ONLY ONE OF THEM HAS A NUMBER. Neither
// not-yet-existing nor could-not-read is given a numeric payload, because giving a state with no
// number a number is the entire defect. What the absent store MEANS — that this host is at the
// first generation — is a decision, and it lives in fleet_converge_generation_admission below
// where it is one named arm rather than a coercion hidden inside a read.
type GenerationStoreObservation
  = GenerationObserved { generation: Int }
  | GenerationStoreAbsent
  | GenerationUnobserved { reason: String }

fn fleet_converge_generation_observation(
  store_present: Bool,
  content: String,
) -> GenerationStoreObservation {
  if !store_present {
    GenerationStoreAbsent
  } else {
    match fleet_converge_parse_nonneg_generation_text(content: content) {
      Present { value: n } => GenerationObserved { generation: n }
      Absent =>
        GenerationUnobserved {
          reason: concat(
            "fleet_converge: generation store is present but does not decode to a non-negative integer at ",
            fleet_converge_generation_store_path,
          ),
        }
    }
  }
}

// THE ONE PLACE THE FIRST-GENERATION RULE LIVES. Both the modelled admission below and the
// emitted apply guard read this row, so the shell cannot drift into a different idea of what a
// host that has never applied is at.
data fleet_converge_first_generation: Int = 0

// WHAT THE ABSENT ARM DOES, AND THE GAP IT LEAVES — stated because a reader would otherwise
// assume it is as safe as the other two. GenerationStoreAbsent PROCEEDS, at the first
// generation. So removing the store on a host is a supported way to pass the staleness compare:
// a deleted store and a host that has never applied are the same observation, and the guard
// cannot tell them apart.
//
// This is NOT a case of evidence that exists and was not consulted. Nothing currently modelled
// separates the two histories. Filesystem.Read yields success and content, so absence carries no
// history. The store's directory is created out of band and must already exist for any commit to
// have succeeded, so its presence is evidence about provisioning, not about a prior apply. The
// lock file is created by the flock in the guard itself, so it exists on a first run too. Every
// candidate the site offers is present in both worlds.
//
// The residual is therefore a REAL bypass with no detector, not a rung this code declined to
// climb, and it is bounded to a principal who can already write /var/lib/gunbc — the same
// principal the apply runs as. It closes by CONSTRUCTION rather than by detection: provision the
// store WITH the first generation, so that a host which has applied and a host which has not both
// have a readable store, absence stops being a legitimate state, and GenerationStoreAbsent
// becomes a third refusal beside GenerationUnobserved. Until that lands, the arm below is the
// honest reading of what the host can actually be asked.
type GenerationAdmission
  = GenerationAdmitted { generation: Int }
  | GenerationAdmissionRefused { reason: String }

fn fleet_converge_generation_admission(observation: GenerationStoreObservation) -> GenerationAdmission {
  match observation {
    GenerationObserved { generation: n } => GenerationAdmitted { generation: n }
    GenerationStoreAbsent => GenerationAdmitted { generation: fleet_converge_first_generation }
    GenerationUnobserved { reason: why } =>
      GenerationAdmissionRefused {
        reason: concat("fleet_converge: refusing to plan on an unobserved generation store — ", why),
      }
  }
}

data fleet_converge_generation_lock_path: String = "/var/lib/gunbc/fleet-converge/plan_generation.lock"

data fleet_converge_locked_apply_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: fleet_converge_locked_apply_script — flock-guarded generation compare, apply.sh, and store commit in one shell transport; DISSOLVES WHEN bash-emit or host_effect_apply provides typed lease acquisition without medium-as-string concat")

// THE LEASE GUARD IS A PROGRAM, AND IT USED TO BE SPLICED INTO ANOTHER ONE BY HAND.
// The previous form built the inner body by joining concatenated command text and then wrote
// `sudo -n flock -x PATH bash -c '` ++ inner ++ `'` — hand-typed single quotes wrapped around a
// multi-line body carrying a command substitution, a redirect to stderr and a redirect to a file.
// Nothing structurally prevented an apostrophe reaching that body, and the failure mode of one
// arriving is not a refusal: it closes the quoting early and the remainder reparses as different
// shell, under flock, as root. The inner body is now a modelled bash statement list serialized
// once, and it enters the outer command as a single WORD, so the quoting is the serializer's
// (extdeps.posix.shell_command_language posix_single_quote) rather than an author's.
//
// THE READ ARM IS THE OTHER HALF, and it is the reason this function changed at all. The old
// guard read the store as `CURRENT=$(cat PATH 2>/dev/null || echo 0)` — every failure, whether
// the store was missing or present-and-unreadable, became the number zero. The modelled reader in
// this same module refuses that coercion in as many words, so the two halves of one rule
// disagreed and only the modelled half was ever read by a reviewer. The emitted guard now
// discriminates the same three states the model does: the default is the named
// fleet_converge_first_generation row (not a coerced read), the store is consulted only when it
// exists, and a store that exists but cannot be read aborts the guard under `set -e` instead of
// passing as generation zero.
//
// WHAT IS NOT CLAIMED: this is derivation of the emitted guard's CONSTANTS and arms from the
// modelled rows, not execution of the modelled decision on the host. The comparison itself is
// still spelled twice — once as fleet_converge_apply_generation_admits and once as the emitted
// `[ "$_gunbc_current" != "<prior>" ]` — and the witness below pins the emitted operands against
// the modelled ones so the two cannot drift silently. A single spelling needs the guard to call
// back into the substrate on the host, which is what this row's dissolution trigger names.
data fleet_converge_locked_apply_current_var: String = "_gunbc_current"

fn fleet_converge_generation_store_default_stmt() -> Node {
  bash_build_assign(
    name: fleet_converge_locked_apply_current_var,
    value: bash_build_word_lit(text: to_string(fleet_converge_first_generation)),
  )
}

// Read the store ONLY where it exists. A present-but-unreadable store makes the command
// substitution fail, and `set -euo pipefail` at the head of this body turns that into a nonzero
// exit — a refusal, not a zero.
fn fleet_converge_generation_store_read_stmt() -> Node {
  bash_build_if_from_stmts(
    cond: bash_build_test_bracket(words: [
      bash_build_word_lit(text: "-e"),
      bash_build_word_lit(text: fleet_converge_generation_store_path),
    ]),
    then_stmts: [
      bash_build_assign(
        name: fleet_converge_locked_apply_current_var,
        value: bash_build_word_cmdsubst(
          body: bash_build_command_with_words(words: [
            bash_build_word_lit(text: "cat"),
            bash_build_word_lit(text: fleet_converge_generation_store_path),
          ]),
        ),
      ),
    ],
  )
}

fn fleet_converge_generation_stale_guard_stmt(prior_generation: Int, planned_generation: Int) -> Node {
  bash_build_if_from_stmts(
    cond: bash_build_test_bracket(words: [
      bash_build_word_var(name: fleet_converge_locked_apply_current_var),
      bash_build_word_lit(text: "!="),
      bash_build_word_lit(text: to_string(prior_generation)),
    ]),
    then_stmts: [
      bash_build_command_with_words(words: [
        bash_build_word_lit(text: "echo"),
        bash_build_word_lit(text: "LeaseGenerationStale"),
        bash_build_word_lit(text: concat("planned=", to_string(planned_generation))),
        bash_build_word_concat_from_nodes(parts: [
          bash_build_word_lit(text: "observed="),
          bash_build_word_var(name: fleet_converge_locked_apply_current_var),
        ]),
      ]),
      bash_build_exit(code: "1"),
    ],
  )
}

fn fleet_converge_locked_apply_inner_stmts(
  prior_generation: Int,
  planned_generation: Int,
  apply_shell_path: String,
) -> List<Node> {
  [
    bash_build_command_with_words(words: [
      bash_build_word_lit(text: "set"),
      bash_build_word_lit(text: "-euo"),
      bash_build_word_lit(text: "pipefail"),
    ]),
    fleet_converge_generation_store_default_stmt(),
    fleet_converge_generation_store_read_stmt(),
    fleet_converge_generation_stale_guard_stmt(
      prior_generation: prior_generation,
      planned_generation: planned_generation,
    ),
    bash_build_command_with_words(words: [
      bash_build_word_lit(text: "bash"),
      bash_build_word_lit(text: apply_shell_path),
    ]),
    bash_build_with_redir_to_file(
      inner: bash_build_command_with_words(words: [
        bash_build_word_lit(text: "printf"),
        bash_build_word_lit(text: "%s\n"),
        bash_build_word_lit(text: to_string(planned_generation)),
      ]),
      path: bash_build_word_lit(text: fleet_converge_generation_store_path),
    ),
  ]
}

data fleet_converge_locked_apply_emit_refused_poison: String = "__GUNBC_BASH_EMIT_REFUSED__ fleet-converge lease guard intent was rejected by v2.workflow.bash_command_fold_serialize; this marker is not valid shell, so the apply refuses loudly rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)"

fn fleet_converge_bash_or_poison(stmts: List<Node>) -> String {
  match bash_fold_serialize_stmts_semi(stmts: stmts) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source
        Some { diagnostics: _ } => fleet_converge_locked_apply_emit_refused_poison
      }
    Rejected { diagnostics: _ } => fleet_converge_locked_apply_emit_refused_poison
  }
}

fn fleet_converge_locked_apply_inner_script(
  prior_generation: Int,
  planned_generation: Int,
  apply_shell_path: String,
) -> String {
  fleet_converge_bash_or_poison(
    stmts: fleet_converge_locked_apply_inner_stmts(
      prior_generation: prior_generation,
      planned_generation: planned_generation,
      apply_shell_path: apply_shell_path,
    ),
  )
}

fn fleet_converge_locked_apply_script(
  prior_generation: Int,
  planned_generation: Int,
  apply_shell_path: String,
) -> String {
  fleet_converge_bash_or_poison(stmts: [
    bash_build_command_with_words(words: [
      bash_build_word_lit(text: "set"),
      bash_build_word_lit(text: "-euo"),
      bash_build_word_lit(text: "pipefail"),
    ]),
    bash_build_command_with_words(words: [
      bash_build_word_lit(text: "sudo"),
      bash_build_word_lit(text: "-n"),
      bash_build_word_lit(text: "mkdir"),
      bash_build_word_lit(text: "-p"),
      bash_build_word_lit(text: "/var/lib/gunbc/fleet-converge"),
    ]),
    bash_build_command_with_words(words: [
      bash_build_word_lit(text: "sudo"),
      bash_build_word_lit(text: "-n"),
      bash_build_word_lit(text: "flock"),
      bash_build_word_lit(text: "-x"),
      bash_build_word_lit(text: fleet_converge_generation_lock_path),
      bash_build_word_lit(text: "bash"),
      bash_build_word_lit(text: "-c"),
      bash_build_word_lit(text: fleet_converge_locked_apply_inner_script(
        prior_generation: prior_generation,
        planned_generation: planned_generation,
        apply_shell_path: apply_shell_path,
      )),
    ]),
  ])
}

fn fleet_converge_apply_shell(
  timer_plan: MembershipPlan<TimerRetirementMember, TimerRetirementMemberAt>,
  host: NonEmptyStr,
  observed_slots: List<RunnerSlotMember>,
  observed_fabric_cells: FabricCellPopulation,
) -> String {
  join(
    concat(
      [
        concat("# ", dissolution_description(condition: fleet_converge_apply_shell_emit_dissolution_trigger)),
        concat("# ", fleet_converge_cap_apply_shell_note),
        "# Admission gates enforced in fleet_converge_apply_wet before bash — this script runs timer teardown and runner-slot ADD",
        "set -euo pipefail",
      ],
      ["# generated at plan time — apply MUST NOT recompute membership_reconcile"],
      timer_apply_lines(plan: timer_plan),
      ["sudo -n systemctl daemon-reload"],
      ["# runner-slot membership (gunbc.runner_slot_provision) — ADD only; see slot_apply_lines"],
      concat(
        slot_apply_lines(host: host, observed_slots: observed_slots),
        fabric_cell_apply_lines(host: host, observed_fabric_cells: observed_fabric_cells),
      ),
    ),
    "\n",
  )
}

// THE FABRIC FAMILY EMITS NO HOST EFFECT YET, AND THE COMMENT IT EMITS INSTEAD IS NOT DECORATION.
//
// Its resources are a cgroup slice and two directories, and provisioning them is a realization this
// cut deliberately does not ship -- the brief stops at the model and its readback. Emitting the
// resolved membership as comments keeps the property the plan/apply split rests on: what apply would
// do is derived from the SAME typed resolution the reviewer read, so when the realization lands it
// replaces a comment whose content already had to be right, rather than introducing a second
// resolution nobody had reviewed.
//
// AN OBSERVATION REFUSAL REACHES THE SCRIPT AS A REFUSAL LINE rather than as no lines at all, for
// the same reason it reaches the baseline as a row: a host that could not be read must not look
// like a host with no fabric work.
fn fabric_cell_apply_lines(
  host: NonEmptyStr,
  observed_fabric_cells: FabricCellPopulation,
) -> List<String> {
  concat(
    ["# fabric-cell membership (gunbc.fabric_cell_converge) — resolved at plan time; no host effect is emitted by this cut"],
    map(
      fleet_converge_fabric_cell_lines(host: host, observed_fabric_cells: observed_fabric_cells),
      l => concat("# ", l),
    ),
  )
}

fn fleet_converge_plan_artifact(
  host: NonEmptyStr,
  prior_generation: Int,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  observed_spark: List<SparkServingMember>,
  observed_slots: List<RunnerSlotMember>,
  observed_fabric_cells: FabricCellPopulation,
) -> FleetConvergePlanArtifact? {
  let subject = fleet_converge_plan_subject(
    host: host,
    observed_timers: observed_timers,
    observed_caps: observed_caps,
    observed_spark: observed_spark,
    observed_slots: observed_slots,
    observed_fabric_cells: observed_fabric_cells,
  )
  let timer_plan = timer_retirement_plan(observed: observed_timers)
  let cap_plan = caps_reconcile(desired: fleet_converge_desired_caps(), observed: observed_caps)
  let timer_lines = membership_plan_lines_timer(plan: timer_plan)
  let cap_lines = membership_plan_lines_cap(plan: cap_plan)
  let baseline = observed_baseline_text(
    host: host,
    observed_timers: observed_timers,
    observed_caps: observed_caps,
    observed_spark: observed_spark,
    observed_slots: observed_slots,
    observed_fabric_cells: observed_fabric_cells,
  )
  let planned_generation = prior_generation + 1
  let body = join(
    concat(
      [
        "# fleet-converge plan",
        concat("subject_host:", subject.host as String),
        concat(
          "subject_member_set:",
          serialize_content_hash(hash: subject.member_set_fingerprint) as String,
        ),
        concat("plan_generation:", to_string(planned_generation)),
        concat("lease_key:", fleet_converge_plan_lease_key(host: subject.host) as String),
        "observed_baseline:",
        baseline,
        "# timer-retirement",
      ],
      timer_lines,
      ["# cap-axis"],
      cap_lines,
      ["# runner-slot"],
      fleet_converge_slot_lines(host: host, observed_slots: observed_slots),
      ["# fabric-cell"],
      fleet_converge_fabric_cell_lines(host: host, observed_fabric_cells: observed_fabric_cells),
      [
        concat("# slot-refusals=", to_string(fleet_converge_slot_refusal_count(host: host, observed_slots: observed_slots))),
        concat("# cap-refusals=", to_string(membership_refusal_count(plan: cap_plan))),
        concat("# timer-refusals=", to_string(membership_refusal_count(plan: timer_plan))),
        concat("# fabric-cell-refusals=", to_string(fleet_converge_fabric_cell_refusal_count(host: host, observed_fabric_cells: observed_fabric_cells))),
      ],
    ),
    "\n",
  )
  let owner_fp = content_hash_of_value(value: body as NonEmptyStr)
  let lease = fleet_converge_plan_held_lease(
    subject: subject,
    prior_generation: prior_generation,
    owner_fingerprint: owner_fp,
  )
  let apply_shell = fleet_converge_apply_shell(
    timer_plan: timer_plan,
    host: host,
    observed_slots: observed_slots,
    observed_fabric_cells: observed_fabric_cells,
  )
  match content_hash_of_value(value: baseline as NonEmptyStr) {
    Fnv1a64(structural) =>
      Present {
        value: FleetConvergePlanArtifact {
          subject: subject,
          prior_generation: prior_generation,
          plan_lease: lease,
          observed_baseline_hex: structural.digest,
          plan_body: body,
          apply_shell: apply_shell,
          spark_serving_typed_actions: scheduled_rows_empty(),
        },
      }
    _ => Absent
  }
}

data fleet_converge_plan_artifact_dir: String = "/tmp/fleet-converge-plan"

data fleet_converge_plan_body_path: String = "/tmp/fleet-converge-plan/plan.txt"

data fleet_converge_plan_baseline_hex_path: String = "/tmp/fleet-converge-plan/observed_baseline.hex"

data fleet_converge_plan_apply_shell_path: String = "/tmp/fleet-converge-plan/apply.sh"

data fleet_converge_plan_content_hash_path: String = "/tmp/fleet-converge-plan/plan_content.hex"

data fleet_converge_plan_subject_host_path: String = "/tmp/fleet-converge-plan/subject_host.txt"

data fleet_converge_plan_generation_path: String = "/tmp/fleet-converge-plan/plan_generation.txt"

data fleet_converge_plan_prior_generation_path: String = "/tmp/fleet-converge-plan/prior_generation.txt"

data fleet_converge_plan_member_set_fp_path: String = "/tmp/fleet-converge-plan/subject_member_set.txt"

fn fleet_converge_observed_baseline_matches(
  host: NonEmptyStr,
  observed_baseline_hex: Fnv1a64StructuralDigestHex,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  observed_spark: List<SparkServingMember>,
  observed_slots: List<RunnerSlotMember>,
  observed_fabric_cells: FabricCellPopulation,
) -> Bool {
  let baseline = observed_baseline_text(
    host: host,
    observed_timers: observed_timers,
    observed_caps: observed_caps,
    observed_spark: observed_spark,
    observed_slots: observed_slots,
    observed_fabric_cells: observed_fabric_cells,
  )
  match content_hash_of_value(value: baseline as NonEmptyStr) {
    Fnv1a64(structural) => structural.digest == observed_baseline_hex
    _ => false
  }
}
