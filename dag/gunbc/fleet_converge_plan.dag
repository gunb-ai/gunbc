module gunbc.fleet_converge_plan


type TimerRetirementMemberAt = std.types.NonEmptyStr

data fleet_converge_plan_authority_note: String = "On-demand fleet converge PLAN authority (operator directive 2026-08-13, sleek-heron-218): membership_reconcile computes the typed hunks — MemberAdded, MemberChanged, MemberRemoved, MemberRemovalRefused — that a human reviews BEFORE apply. Plan and apply are the same spine at different poles; this module owns serialization, the content-addressed artifact, subject identity, std.temporal_effect HeldLease generation protection, and the observed baseline fingerprint apply must CAS against. A plan names its subject (host + member-set fingerprint) and mints a generation-scoped lease so two applies against the same observed baseline cannot both act. Timer retirement: desired has NO fleet-converge timers; observed lists legacy units still on the host. MemberRemovalRefused arms are rendered in plan output and never filtered — they are precisely what a reviewer needs to see before approving."

type FleetConvergePlanSubject {
  host: std.types.NonEmptyStr
  member_set_fingerprint: std.content_hash.ContentHash
}

fn fleet_converge_plan_lease_key(host: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  concat("fleet-converge-plan:", host as String) as std.types.NonEmptyStr
}

fn fleet_converge_plan_subject_identity_text(subject: FleetConvergePlanSubject) -> String {
  concat(
    concat("host:", subject.host as String),
    concat("\nmember_set:", std.content_hash.serialize_content_hash(hash: subject.member_set_fingerprint) as String),
  )
}

fn fleet_converge_plan_resource_fingerprint(subject: FleetConvergePlanSubject) -> std.content_hash.ContentHash {
  std.content_hash.content_hash_of_value(value: fleet_converge_plan_subject_identity_text(subject: subject) as std.types.NonEmptyStr)
}

fn fleet_converge_plan_subject(
  host: std.types.NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<gunbc.host_axis_caps.CapMember>,
) -> FleetConvergePlanSubject {
  FleetConvergePlanSubject {
    host: host,
    member_set_fingerprint: fleet_converge_member_set_fingerprint(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
    ),
  }
}

fn fleet_converge_member_set_fingerprint(
  host: std.types.NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<gunbc.host_axis_caps.CapMember>,
) -> std.content_hash.ContentHash {
  std.content_hash.content_hash_of_value(
    value: observed_baseline_text(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
    ) as std.types.NonEmptyStr,
  )
}

fn fleet_converge_apply_subject_admits(
  planned_subject: FleetConvergePlanSubject,
  observed_host: std.types.NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<gunbc.host_axis_caps.CapMember>,
) -> std.types.Bool {
  planned_subject.host == observed_host
    && std.content_hash.compare_content_hash(
      left: planned_subject.member_set_fingerprint,
      right: fleet_converge_member_set_fingerprint(
        host: observed_host,
        observed_timers: observed_timers,
        observed_caps: observed_caps,
      ),
    ) == std.content_hash.ContentHashEqual
}

fn fleet_converge_plan_held_lease(
  subject: FleetConvergePlanSubject,
  prior_generation: Int,
  owner_fingerprint: std.content_hash.ContentHash,
) -> std.temporal_effect.HeldLease {
  std.temporal_effect.HeldLease {
    lease_key: fleet_converge_plan_lease_key(host: subject.host),
    resource_fingerprint: fleet_converge_plan_resource_fingerprint(subject: subject),
    owner_fingerprint: owner_fingerprint,
    generation: prior_generation + 1,
    observed: std.temporal_effect.LeaseAbsent,
  }
}

fn fleet_converge_apply_generation_admits(prior_generation: Int, store_generation: Int) -> std.types.Bool {
  store_generation == prior_generation
}

fn fleet_converge_apply_generation_stale(planned_generation: Int, store_generation: Int) -> std.types.Bool {
  store_generation >= planned_generation
}

fn fleet_converge_member_set_fingerprint_matches(
  planned_fingerprint_text: String,
  host: std.types.NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<gunbc.host_axis_caps.CapMember>,
) -> std.types.Bool {
  std.algebra.trim(s: planned_fingerprint_text) == (
    std.content_hash.serialize_content_hash(
      hash: fleet_converge_member_set_fingerprint(
        host: host,
        observed_timers: observed_timers,
        observed_caps: observed_caps,
      ),
    ) as String
  )
}

type TimerRetirementMember {
  unit_name: std.types.NonEmptyStr
}

fn timer_member_key(m: TimerRetirementMember) -> std.types.NonEmptyStr {
  m.unit_name
}

fn timer_member_key_eq(a: std.types.NonEmptyStr, b: std.types.NonEmptyStr) -> std.types.Bool {
  a as String == b as String
}

fn timer_member_value_eq(a: TimerRetirementMember, b: TimerRetirementMember) -> std.types.Bool {
  a.unit_name as String == b.unit_name as String
}

fn timer_member_ownership(m: TimerRetirementMember) -> gunbc.ownership.Ownership? {
  Present { value: gunbc.ownership.Owned }
}

fn timer_retirement_plan(observed: List<TimerRetirementMember>) -> gunbc.membership_reconcile.MembershipPlan<TimerRetirementMember, TimerRetirementMemberAt> {
  gunbc.membership_reconcile.membership_plan_admitting_outcome(
    outcome: gunbc.membership_reconcile.membership_reconcile(
      desired: timer_retirement_desired(),
      observed: observed,
      key_of: timer_member_key,
      key_eq: timer_member_key_eq,
      value_eq: timer_member_value_eq,
      ownership_of: timer_member_ownership,
    ),
  )
}

fn timer_member_unit_path(unit_name: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  concat("/etc/systemd/system/", unit_name as String) as std.types.NonEmptyStr
}

fn timer_retirement_desired() -> List<TimerRetirementMember> {
  []
}

fn timer_retirement_observed_legacy_srv1() -> List<TimerRetirementMember> {
  let names = gunbc.live_deploy.spec.deployment_spec_srv1().names
  [
    TimerRetirementMember { unit_name: gunbc.fleet_converge_timer.fleet_converge_timer_unit_name as std.types.NonEmptyStr },
    TimerRetirementMember { unit_name: gunbc.fleet_converge_timer.fleet_converge_service_unit_name as std.types.NonEmptyStr },
    TimerRetirementMember { unit_name: gunbc.live_deploy.spec.deployment_fleet_converge_timer_unit_name(names: names) },
    TimerRetirementMember { unit_name: gunbc.live_deploy.spec.deployment_fleet_converge_service_unit_name(names: names) },
  ]
}

fn teardown_refusal_cause_label(cause: gunbc.membership_reconcile.TeardownRefusalCause) -> String {
  match cause {
    gunbc.membership_reconcile.MemberNotOwned => "MemberNotOwned"
    gunbc.membership_reconcile.OwnershipUnknown => "OwnershipUnknown"
    RosterDuplicateKey { roster: _ } => "RosterDuplicateKey"
  }
}

fn timer_action_line(action: gunbc.membership_reconcile.MemberAction<TimerRetirementMember, TimerRetirementMemberAt>) -> String {
  match action {
    MemberAdded { at: _, to: m } => concat("ADD timer-unit ", m.unit_name as String)
    MemberChanged { at: _, from: f, to: t } =>
      concat(concat("CHANGE timer-unit ", f.unit_name as String), concat(" -> ", t.unit_name as String))
    MemberRemoved { at: _, from: m } => concat("REMOVE timer-unit ", m.unit_name as String)
    MemberRemovalRefused { from: m, cause: c } =>
      concat(
        concat("REFUSED-REMOVAL timer-unit ", m.unit_name as String),
        concat(" cause=", teardown_refusal_cause_label(cause: c)),
      )
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => "REFUSED-DUPLICATE-KEY"
  }
}

fn cap_action_line(action: gunbc.membership_reconcile.MemberAction<gunbc.host_axis_caps.CapMember, gunbc.host_axis_caps.CapMemberAt>) -> String {
  match action {
    MemberAdded { at: _, to: m } => concat("ADD cap ", m.dropin_path as String)
    MemberChanged { at: _, from: f, to: t } =>
      concat(concat("CHANGE cap ", f.dropin_path as String), concat(" -> content drift"))
    MemberRemoved { at: _, from: m } => concat("REMOVE cap ", m.dropin_path as String)
    MemberRemovalRefused { from: m, cause: c } =>
      concat(
        concat("REFUSED-REMOVAL cap ", m.dropin_path as String),
        concat(" cause=", teardown_refusal_cause_label(cause: c)),
      )
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => "REFUSED-DUPLICATE-KEY"
  }
}

fn membership_plan_lines_timer(plan: gunbc.membership_reconcile.MembershipPlan<TimerRetirementMember, TimerRetirementMemberAt>) -> List<String> {
  map(plan.actions, a => timer_action_line(action: a))
}

fn membership_plan_lines_cap(plan: gunbc.membership_reconcile.MembershipPlan<gunbc.host_axis_caps.CapMember, gunbc.host_axis_caps.CapMemberAt>) -> List<String> {
  map(plan.actions, a => cap_action_line(action: a))
}

fn fleet_converge_desired_caps() -> List<gunbc.host_axis_caps.CapMember> {
  let slot = gunbc.runner_slot_allocation.gunbc_runner_slot_desired()
  [
    gunbc.host_axis_caps.desired_cap_member(
      dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
      property: extdeps.systemd.systemd_memory_max_property,
      bytes_value: to_string(std.measure.byte_size_count(b: slot.memory_max)) as std.types.NonEmptyStr,
    ),
    gunbc.host_axis_caps.desired_cap_member(
      dropin_path: gunbc.host_converge.gunbc_runner_per_slot_high_dropin_path as std.types.NonEmptyStr,
      property: extdeps.systemd.systemd_memory_high_property,
      bytes_value: to_string(std.measure.byte_size_count(b: slot.memory_high)) as std.types.NonEmptyStr,
    ),
    gunbc.host_axis_caps.desired_cap_member(
      dropin_path: gunbc.host_converge.gunbc_runner_per_slot_swap_dropin_path as std.types.NonEmptyStr,
      property: extdeps.systemd.systemd_memory_swap_max_property,
      bytes_value: to_string(std.measure.byte_size_count(b: slot.memory_swap_max)) as std.types.NonEmptyStr,
    ),
    gunbc.host_axis_caps.desired_cap_member(
      dropin_path: gunbc.host_converge.gunbc_runner_per_slot_tasks_dropin_path as std.types.NonEmptyStr,
      property: extdeps.systemd.systemd_tasks_max_property,
      bytes_value: to_string(slot.tasks_max) as std.types.NonEmptyStr,
    ),
  ]
}

fn observed_baseline_text(
  host: std.types.NonEmptyStr,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<gunbc.host_axis_caps.CapMember>,
) -> String {
  join(
    concat(
      [concat("host:", host as String)],
      map(observed_timers, m => concat("timer:", m.unit_name as String)),
      map(observed_caps, c => concat("cap:", c.dropin_path as String, "=", c.content)),
    ),
    "\n",
  )
}

type FleetConvergeSparkServingTypedAction {
  action: gunbc.membership_reconcile.MemberAction<gunbc.spark_serving_membership.SparkServingMember, gunbc.spark_serving_membership.SparkServingMemberAt>,
  install_effects: List<gunbc.spark_serving_realization.ServingInstallEffect>
}

type FleetConvergePlanArtifact {
  subject: FleetConvergePlanSubject
  prior_generation: Int
  plan_lease: std.temporal_effect.HeldLease
  observed_baseline_hex: std.content_hash.Fnv1a64StructuralDigestHex
  plan_body: String
  apply_shell: String
  spark_serving_typed_actions: List<FleetConvergeSparkServingTypedAction>
}

// NO WILDCARD. The wildcard is what made ServingInstallEffect extensible in silence: a thirteenth
// variant would have landed as "UnmodeledServingInstallEffect" and read as a legitimate wire label
// that simply missed. Every variant now names itself, so the wire string says WHICH effect was
// asked for, and adding a variant makes this match non-exhaustive rather than defaulting.
// Behaviour for the implemented slice is unchanged: EnableLingerForOwnAccount is still the only
// effect the linger vertical realizes.
fn fleet_converge_spark_serving_effect_wire(effect: gunbc.spark_serving_realization.ServingInstallEffect) -> String {
  match effect {
    gunbc.spark_serving_realization.EnableLingerForOwnAccount => "EnableLingerForOwnAccount"
    WriteSystemUnitFile => "WriteSystemUnitFile"
    ReloadSystemManager => "ReloadSystemManager"
    EnableSystemUnit => "EnableSystemUnit"
    WriteUserUnitFile => "WriteUserUnitFile"
    ReloadUserManager => "ReloadUserManager"
    EnableUserUnit => "EnableUserUnit"
    InstallRuntimePackage => "InstallRuntimePackage"
    InstallOwnedRuntimeClosure => "InstallOwnedRuntimeClosure"
    PullModelArtifact => "PullModelArtifact"
    GrantContainerRuntimeAccess => "GrantContainerRuntimeAccess"
    RunContainerAsOwnUser => "RunContainerAsOwnUser"
  }
}

fn fleet_converge_spark_serving_action_kind(action: gunbc.membership_reconcile.MemberAction<gunbc.spark_serving_membership.SparkServingMember, gunbc.spark_serving_membership.SparkServingMemberAt>) -> String {
  match action {
    MemberAdded { at: _, to: _ } => "ADD"
    MemberChanged { at: _, from: _, to: _ } => "CHANGE"
    MemberRemoved { at: _, from: _ } => "REMOVE"
    MemberRemovalRefused { from: _, cause: _ } => "REFUSED-REMOVAL"
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => "REFUSED-DUPLICATE-KEY"
  }
}

fn fleet_converge_spark_serving_action_line(row: FleetConvergeSparkServingTypedAction) -> String {
  let member = match row.action {
    MemberAdded { at: _, to: m } => m
    MemberChanged { at: _, from: _, to: m } => m
    MemberRemoved { at: _, from: m } => m
    MemberRemovalRefused { from: m, cause: _ } => m
    MemberRosterDuplicateKeyRefused { roster: _, first: f, duplicate: _ } => f
  }
  join(
    [
      fleet_converge_spark_serving_action_kind(action: row.action),
      " spark-serving ",
      gunbc.spark_serving_membership.spark_serving_member_key(member: member),
      " effects=",
      join(map(row.install_effects, e => fleet_converge_spark_serving_effect_wire(effect: e)), ","),
    ],
    "",
  )
}

fn fleet_converge_spark_serving_typed_actions_wire(
  rows: List<FleetConvergeSparkServingTypedAction>,
) -> String {
  join(map(rows, r => fleet_converge_spark_serving_action_line(row: r)), ";")
}

data fleet_converge_spark_typed_actions_wire_empty_canonical: std.types.NonEmptyStr = "spark-serving-typed-actions-wire-empty"

fn fleet_converge_spark_typed_actions_wire_structural_hash(wire: String) -> std.content_hash.Fnv1a64Structural? {
  if wire == "" {
    match std.content_hash.content_hash_of_value(value: fleet_converge_spark_typed_actions_wire_empty_canonical) {
      std.content_hash.Fnv1a64(structural) => Present { value: structural }
      _ => Absent
    }
  } else {
    match std.content_hash.content_hash_of_value(value: wire as std.types.NonEmptyStr) {
      std.content_hash.Fnv1a64(structural) => Present { value: structural }
      _ => Absent
    }
  }
}

fn fleet_converge_plan_body_claims_spark_typed_actions(plan_body: String) -> std.types.Bool {
  string_contains(s: plan_body, pattern: "# spark-serving-typed-actions:")
}

fn fleet_converge_plan_spark_typed_actions_consistency_admits(
  plan_body: String,
  spark_serving_typed_actions: List<FleetConvergeSparkServingTypedAction>,
) -> std.types.Bool {
  let body_claims = fleet_converge_plan_body_claims_spark_typed_actions(plan_body: plan_body)
  if length(spark_serving_typed_actions) > 0 && !body_claims {
    false
  } else {
    true
  }
}

fn fleet_converge_plan_body_structural_hash(plan_body: String) -> std.content_hash.Fnv1a64Structural? {
  match std.content_hash.content_hash_of_value(value: plan_body as std.types.NonEmptyStr) {
    std.content_hash.Fnv1a64(structural) => Present { value: structural }
    _ => Absent
  }
}

fn fleet_converge_plan_apply_shell_structural_hash(apply_shell: String) -> std.content_hash.Fnv1a64Structural? {
  match std.content_hash.content_hash_of_value(value: apply_shell as std.types.NonEmptyStr) {
    std.content_hash.Fnv1a64(structural) => Present { value: structural }
    _ => Absent
  }
}

fn fleet_converge_plan_bundle_v1_structural_hash(plan_body: String, apply_shell: String) -> std.content_hash.Fnv1a64Structural? {
  match fleet_converge_plan_body_structural_hash(plan_body: plan_body) {
    Present { value: plan_struct } =>
      match fleet_converge_plan_apply_shell_structural_hash(apply_shell: apply_shell) {
        Present { value: shell_struct } =>
          Present {
            value: std.content_hash.content_hash_combine_structural(left: plan_struct, right: shell_struct),
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn fleet_converge_plan_bundle_structural_hash(
  plan_body: String,
  apply_shell: String,
  spark_typed_actions_wire: String,
) -> std.content_hash.Fnv1a64Structural? {
  match fleet_converge_plan_bundle_v1_structural_hash(plan_body: plan_body, apply_shell: apply_shell) {
    Present { value: bundle_v1 } =>
      match fleet_converge_spark_typed_actions_wire_structural_hash(wire: spark_typed_actions_wire) {
        Present { value: spark_struct } =>
          Present {
            value: std.content_hash.content_hash_combine_structural(left: bundle_v1, right: spark_struct),
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn fleet_converge_plan_bundle_digest_hex(
  plan_body: String,
  apply_shell: String,
  spark_typed_actions_wire: String,
) -> std.content_hash.Fnv1a64StructuralDigestHex? {
  match fleet_converge_plan_bundle_structural_hash(
    plan_body: plan_body,
    apply_shell: apply_shell,
    spark_typed_actions_wire: spark_typed_actions_wire,
  ) {
    Present { value: bundle } => Present { value: bundle.digest }
    Absent => Absent
  }
}

fn fleet_converge_plan_bundle_matches(
  plan_body: String,
  apply_shell: String,
  spark_typed_actions_wire: String,
  claimed_hex: String,
) -> std.types.Bool {
  match fleet_converge_plan_bundle_digest_hex(
    plan_body: plan_body,
    apply_shell: apply_shell,
    spark_typed_actions_wire: spark_typed_actions_wire,
  ) {
    Present { value: computed } => std.algebra.trim(s: claimed_hex) == computed as String
    Absent => false
  }
}

fn fleet_converge_plan_bundle_v1_matches(plan_body: String, apply_shell: String, claimed_hex: String) -> std.types.Bool {
  match fleet_converge_plan_bundle_v1_structural_hash(plan_body: plan_body, apply_shell: apply_shell) {
    Present { value: bundle } => std.algebra.trim(s: claimed_hex) == bundle.digest as String
    Absent => false
  }
}

fn fleet_converge_plan_content_hash(plan_body: String) -> std.content_hash.Fnv1a64StructuralDigestHex? {
  match fleet_converge_plan_body_structural_hash(plan_body: plan_body) {
    Present { value: structural } => Present { value: structural.digest }
    Absent => Absent
  }
}

fn fleet_converge_plan_artifact_hash(artifact: FleetConvergePlanArtifact) -> std.content_hash.Fnv1a64StructuralDigestHex? {
  fleet_converge_plan_bundle_digest_hex(
    plan_body: artifact.plan_body,
    apply_shell: artifact.apply_shell,
    spark_typed_actions_wire: fleet_converge_spark_serving_typed_actions_wire(
      rows: artifact.spark_serving_typed_actions,
    ),
  )
}

fn fleet_converge_plan_artifact_bundle_admits(artifact: FleetConvergePlanArtifact, claimed_hex: String) -> std.types.Bool {
  fleet_converge_plan_spark_typed_actions_consistency_admits(
    plan_body: artifact.plan_body,
    spark_serving_typed_actions: artifact.spark_serving_typed_actions,
  )
    && fleet_converge_plan_bundle_matches(
      plan_body: artifact.plan_body,
      apply_shell: artifact.apply_shell,
      spark_typed_actions_wire: fleet_converge_spark_serving_typed_actions_wire(
        rows: artifact.spark_serving_typed_actions,
      ),
      claimed_hex: claimed_hex,
    )
}

data fleet_converge_apply_shell_emit_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: fleet_converge_apply_shell — concat-built bash apply runner for timer retirement only (sudo systemctl disable/rm + daemon-reload); cap drop-in mutations are live_deploy deploy-principal authority (host_axis_caps_note) and are plan-output-only here; generation compare+apply+commit runs under flock in fleet_converge_locked_apply_script; subject-host / member-set / observed-baseline gates live in fleet_converge_apply_wet before the locked transport; DISSOLVES WHEN bash-emit or host_effect_apply realizes timer teardown and lease acquisition without medium-as-string concat")

data fleet_converge_apply_shell_emit_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.fleet_converge_plan",
    decl_name: "fleet_converge_apply_shell_emit_dissolution_trigger",
    field: std.decl_ref.WholeDeclaration,
  },
}

fn timer_retirement_disable_line(unit_name: std.types.NonEmptyStr) -> String {
  concat("sudo -n systemctl disable --now ", unit_name as String)
}

fn timer_retirement_remove_line(unit_name: std.types.NonEmptyStr) -> String {
  concat("sudo -n rm -f /etc/systemd/system/", unit_name as String)
}

fn cap_apply_line(action: gunbc.membership_reconcile.MemberAction<gunbc.host_axis_caps.CapMember, gunbc.host_axis_caps.CapMemberAt>) -> String {
  match action {
    MemberAdded { at: _, to: m } => gunbc.host_axis_caps.cap_upsert_script(m: m)
    MemberChanged { at: _, from: _, to: t } => gunbc.host_axis_caps.cap_upsert_script(m: t)
    MemberRemoved { at: _, from: m } => concat("rm -f ", m.dropin_path as String)
    MemberRemovalRefused { from: _, cause: _ } => ""
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => ""
  }
}

data fleet_converge_cap_apply_shell_note: String = "Cap MemberAdded/Changed/Removed arms are rendered in plan.txt for human review but are NOT emitted into apply.sh — PerSlotMemoryCap drop-in writes are live_deploy deploy-principal authority (host_axis_caps host_axis_caps_note); converge on the operator runner does not sudo-write /etc/systemd drop-ins."

fn timer_apply_lines(plan: gunbc.membership_reconcile.MembershipPlan<TimerRetirementMember, TimerRetirementMemberAt>) -> List<String> {
  flat_map(plan.actions, a =>
    match a {
      MemberRemoved { at: _, from: m } =>
        [timer_retirement_disable_line(unit_name: m.unit_name), timer_retirement_remove_line(unit_name: m.unit_name)]
      MemberRemovalRefused { from: _, cause: _ } => []
      MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => []
      MemberAdded { at: _, to: _ } => []
      MemberChanged { at: _, from: _, to: _ } => []
    }
  )
}

data fleet_converge_generation_store_path: String = "/var/lib/gunbc/fleet-converge/plan_generation"

fn fleet_converge_parse_nonneg_generation_text(content: String) -> Int? {
  let trimmed = std.algebra.trim(s: content)
  if trimmed == "" {
    none
  } else {
    match parse_int(s: trimmed) {
      Present { value: n } =>
        if n >= 0 {
          Present { value: n }
        } else {
          none
        }
      Absent => none
    }
  }
}

fn fleet_converge_generation_from_store_content(store_present: std.types.Bool, content: String) -> Int? {
  if !store_present {
    Present { value: 0 }
  } else {
    fleet_converge_parse_nonneg_generation_text(content: content)
  }
}

data fleet_converge_generation_lock_path: String = "/var/lib/gunbc/fleet-converge/plan_generation.lock"

data fleet_converge_locked_apply_emit_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: fleet_converge_locked_apply_script — flock-guarded generation compare, apply.sh, and store commit in one shell transport; DISSOLVES WHEN bash-emit or host_effect_apply provides typed lease acquisition without medium-as-string concat")

fn fleet_converge_locked_apply_script(
  prior_generation: Int,
  planned_generation: Int,
  apply_shell_path: String,
) -> String {
  let inner = join(
    [
      concat(
        "CURRENT=$(cat \"",
        fleet_converge_generation_store_path,
        "\" 2>/dev/null || echo 0)",
      ),
      concat("if [ \"$CURRENT\" != \"", to_string(prior_generation), "\" ]; then"),
      concat(
        "  echo LeaseGenerationStale planned=",
        to_string(planned_generation),
        " observed=$CURRENT >&2",
      ),
      "  exit 1",
      "fi",
      concat("bash \"", apply_shell_path, "\""),
      concat(
        "echo \"",
        to_string(planned_generation),
        "\" > \"",
        fleet_converge_generation_store_path,
        "\"",
      ),
    ],
    "\n",
  )
  join(
    [
      "set -euo pipefail",
      "sudo -n mkdir -p /var/lib/gunbc/fleet-converge",
      concat(
        "sudo -n flock -x \"",
        fleet_converge_generation_lock_path,
        "\" bash -c '",
        inner,
        "'",
      ),
    ],
    "\n",
  )
}

fn fleet_converge_apply_shell(timer_plan: gunbc.membership_reconcile.MembershipPlan<TimerRetirementMember, TimerRetirementMemberAt>) -> String {
  join(
    concat(
      [
        concat("# ", std.dissolution.dissolution_description(condition: fleet_converge_apply_shell_emit_dissolution_trigger)),
        concat("# ", fleet_converge_cap_apply_shell_note),
        "# Admission gates enforced in fleet_converge_apply_wet before bash — this script runs timer teardown only",
        "set -euo pipefail",
      ],
      ["# generated at plan time — apply MUST NOT recompute membership_reconcile"],
      timer_apply_lines(plan: timer_plan),
      ["sudo -n systemctl daemon-reload"],
    ),
    "\n",
  )
}

fn fleet_converge_plan_artifact(
  host: std.types.NonEmptyStr,
  prior_generation: Int,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<gunbc.host_axis_caps.CapMember>,
) -> FleetConvergePlanArtifact? {
  let subject = fleet_converge_plan_subject(
    host: host,
    observed_timers: observed_timers,
    observed_caps: observed_caps,
  )
  let timer_plan = timer_retirement_plan(observed: observed_timers)
  let cap_plan = gunbc.host_axis_caps.caps_reconcile(desired: fleet_converge_desired_caps(), observed: observed_caps)
  let timer_lines = membership_plan_lines_timer(plan: timer_plan)
  let cap_lines = membership_plan_lines_cap(plan: cap_plan)
  let baseline = observed_baseline_text(
    host: host,
    observed_timers: observed_timers,
    observed_caps: observed_caps,
  )
  let planned_generation = prior_generation + 1
  let body = join(
    concat(
      [
        "# fleet-converge plan",
        concat("subject_host:", subject.host as String),
        concat(
          "subject_member_set:",
          std.content_hash.serialize_content_hash(hash: subject.member_set_fingerprint) as String,
        ),
        concat("plan_generation:", to_string(planned_generation)),
        concat("lease_key:", fleet_converge_plan_lease_key(host: subject.host) as String),
        "observed_baseline:",
        baseline,
        "# timer-retirement",
      ],
      timer_lines,
      ["# cap-axis"],
      cap_lines,
      [
        concat("# cap-refusals=", to_string(gunbc.membership_reconcile.membership_refusal_count(plan: cap_plan))),
        concat("# timer-refusals=", to_string(gunbc.membership_reconcile.membership_refusal_count(plan: timer_plan))),
      ],
    ),
    "\n",
  )
  let owner_fp = std.content_hash.content_hash_of_value(value: body as std.types.NonEmptyStr)
  let lease = fleet_converge_plan_held_lease(
    subject: subject,
    prior_generation: prior_generation,
    owner_fingerprint: owner_fp,
  )
  let apply_shell = fleet_converge_apply_shell(timer_plan: timer_plan)
  match std.content_hash.content_hash_of_value(value: baseline as std.types.NonEmptyStr) {
    std.content_hash.Fnv1a64(structural) =>
      Present {
        value: FleetConvergePlanArtifact {
          subject: subject,
          prior_generation: prior_generation,
          plan_lease: lease,
          observed_baseline_hex: structural.digest,
          plan_body: body,
          apply_shell: apply_shell,
          spark_serving_typed_actions: [],
        },
      }
    _ => Absent
  }
}

data fleet_converge_plan_artifact_dir: String = "/tmp/fleet-converge-plan"

data fleet_converge_plan_body_path: String = "/tmp/fleet-converge-plan/plan.txt"

data fleet_converge_plan_baseline_hex_path: String = "/tmp/fleet-converge-plan/observed_baseline.hex"

data fleet_converge_plan_apply_shell_path: String = "/tmp/fleet-converge-plan/apply.sh"

data fleet_converge_plan_content_hash_path: String = "/tmp/fleet-converge-plan/plan_content.hex"

data fleet_converge_plan_subject_host_path: String = "/tmp/fleet-converge-plan/subject_host.txt"

data fleet_converge_plan_generation_path: String = "/tmp/fleet-converge-plan/plan_generation.txt"

data fleet_converge_plan_prior_generation_path: String = "/tmp/fleet-converge-plan/prior_generation.txt"

data fleet_converge_plan_member_set_fp_path: String = "/tmp/fleet-converge-plan/subject_member_set.txt"

fn fleet_converge_observed_baseline_matches(
  host: std.types.NonEmptyStr,
  observed_baseline_hex: std.content_hash.Fnv1a64StructuralDigestHex,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<gunbc.host_axis_caps.CapMember>,
) -> std.types.Bool {
  let baseline = observed_baseline_text(
    host: host,
    observed_timers: observed_timers,
    observed_caps: observed_caps,
  )
  match std.content_hash.content_hash_of_value(value: baseline as std.types.NonEmptyStr) {
    std.content_hash.Fnv1a64(structural) => structural.digest == observed_baseline_hex
    _ => false
  }
}
