module gunbc.build_cache_endpoint_observation


data build_cache_endpoint_observation_authority_disposition: std.disposition.Disposition = std.disposition.SingleAuthority

// THE CI CACHE ENDPOINT PRODUCER for units, caps, and owner context. gunbc.build_cache_instance carries
// desired intent and placement derivation; this module will walk /proc for listener ownership, cgroup
// memory limits, and unit names. It gates on shell transport and returns EndpointObservationUnavailable
// with ReachRefused when transport fails — never EndpointAbsent (unreachable ≠ no listener).
//
// CORRECTED 2026-08-21: THE ENDPOINT-OWNER WALK LANDED, AND IT DID NOT LAND HERE. gunbc.build_cache_endpoint_observe
// decodes the endpoint owner, path state and observation currency, and gunbc.host_effect_realize drives it
// per effect. What this surface still cannot do is reach it, and the reason is its own signature rather
// than a missing implementation: it takes a HostIdentity and answers for the whole fleet, so there is no
// HostEffectTransport in scope to read anything through. Its remaining honest arm is therefore the
// unavailable one, and the dissolve-on below is unchanged and now precise — a HostEffectTransport
// obtainable FROM a HostIdentity is exactly what it waits on. Its only consumers today are witnesses.

fn build_cache_ci_endpoint_observed_producer(host: product.placement_supply.HostIdentity) -> gunbc.build_cache_instance.BuildCacheEndpointObservation {
  let instance = gunbc.build_cache_instance.ci_cache_instance(host: host)
  match gunbc.fleet_shell_transport_observation.fleet_shell_transport_observation(host: host) {
    gunbc.fleet_shell_transport_observation.ShellTransportSucceeded { observed_on: _, principal: _, detail: _ } =>
      gunbc.build_cache_instance.EndpointObservationUnavailable {
        instance: instance,
        reason: gunbc.build_cache_instance.ProcTableUnreadable {
          detail: "this fleet-wide surface takes only a HostIdentity and so has no transport to read an endpoint owner through; the live producer is gunbc.build_cache_endpoint_observe, driven from gunbc.host_effect_realize where a HostEffectTransport exists" as std.types.NonEmptyStr,
        },
      }
    gunbc.fleet_shell_transport_observation.ShellTransportReachRefused { observed_on: _, principal: _, detail: d, gap: _ } =>
      gunbc.build_cache_instance.EndpointObservationUnavailable {
        instance: instance,
        reason: gunbc.build_cache_instance.ReachRefused { detail: d },
      }
    gunbc.fleet_shell_transport_observation.ShellTransportUnobserved { reason: r } =>
      gunbc.build_cache_instance.EndpointObservationUnavailable {
        instance: instance,
        reason: gunbc.build_cache_instance.ReachRefused {
          detail: concat("shell transport unobserved: ", r) as std.types.NonEmptyStr,
        },
      }
  }
}

fn build_cache_ci_endpoint_observation(host: product.placement_supply.HostIdentity) -> gunbc.build_cache_instance.BuildCacheEndpointObservation {
  build_cache_ci_endpoint_observed_producer(host: host)
}

fn build_cache_ci_placement_observation(host: product.placement_supply.HostIdentity) -> gunbc.build_cache_instance.BuildCacheServerPlacement {
  gunbc.build_cache_instance.placement_of_endpoint_observation(
    observed: build_cache_ci_endpoint_observation(host: host),
  )
}


fn build_cache_ci_placement_unknown_count(hosts: List<product.placement_supply.HostIdentity>) -> Int {
  filter(
    hosts,
    h =>
      match build_cache_ci_placement_observation(host: h) {
        gunbc.build_cache_instance.ServerPlacementUnknown { detail: _ } => true
        _ => false
      },
  ).length()
}

data build_cache_ci_endpoint_observed_producer_dissolve_on: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "HostEffectTransport",
    field: std.decl_ref.WholeDeclaration,
  }
}
