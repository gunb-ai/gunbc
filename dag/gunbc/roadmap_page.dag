module gunbc.roadmap_page

import std.types { list_length }
import std.markup { MarkupNode, ElementNode, TextNode, MarkupAttr, txt, el, el_class }
import std.markdown_markup { markdown_inlines_to_markup_nodes }
import extdeps.languages.markdown { parse_inline_markdown_minimal }
import gunbc.roadmap_style { roadmap_css }
import gunbc.site.mark { render_mark }
import gunbc.roadmap_model {
  RoadmapNode, RoadmapEdge, Pointer, RoadmapNodeId,
  RoadmapParent, TopLevel, UnderParent, roadmap_parent, is_top_level,
  SectionElement, Prose, Group, SectionGroup,
  NodeSizing, Unsized, Sized,
  Intricacy, IntricacyLow, IntricacyMedium, IntricacyHigh,
  Volume, VolumeSmall, VolumeMedium, VolumeLarge,
}
import gunbc.roadmap_status { RoadmapItem, DerivableLine, AuthoredLine, PlainLine, SupersededLine, item_superseded_by, item_is_done, signoff_accepts, signoff_by }
import gunbc.roadmap_document { RoadmapDocument, RoadmapSection }
import gunbc.roadmap_authority { roadmap_authority, authored_merged_prs }
import gunbc.roadmap_spawner { spawn_frontier, SpawnFrontier }
import gunbc.roadmap_component { roadmap_dispatch_asset_path }
import gunbc.v1_deletion_plan {
  v1_deletion_gates, v1_deletion_milestones, PlanGateSpec, PlanMilestone,
  PlanGate, GateEmitterFixedPoint, GateHonestFrontier, GateLedgerGreen, GateDeletion,
  BrickState, Placed, InFlight, Gated,
  BrickRole, BarBrick, SeedShrink,
}

fn roadmap_page_max_depth() -> Int { 8 }

fn tg_gate_index(g: PlanGate) -> Int {
  match g {
    GateEmitterFixedPoint => 0
    GateHonestFrontier => 1
    GateLedgerGreen => 2
    GateDeletion => 3
  }
}

fn tg_gate_eq(a: PlanGate, b: PlanGate) -> Bool { tg_gate_index(g: a) == tg_gate_index(g: b) }

fn tg_brick_is_placed(bs: BrickState) -> Bool {
  match bs {
    Placed => true
    InFlight => false
    Gated => false
  }
}

fn tg_brick_is_remaining(bs: BrickState) -> Bool {
  match bs {
    Placed => false
    InFlight => true
    Gated => true
  }
}

fn tg_brick_state_class(bs: BrickState) -> String {
  match bs {
    Placed => "placed"
    InFlight => "inflight"
    Gated => "gated"
  }
}

fn tg_brick_state_label(bs: BrickState) -> String {
  match bs {
    Placed => "done"
    InFlight => "in flight"
    Gated => "gated"
  }
}

fn tg_is_bar_brick(m: PlanMilestone) -> Bool {
  match m.role {
    BarBrick => true
    SeedShrink => false
  }
}

fn tg_gate_bricks(g: PlanGate) -> List<PlanMilestone> {
  filter(v1_deletion_milestones, m => tg_gate_eq(a: m.gate, b: g) && tg_is_bar_brick(m: m))
}

fn tg_gate_total(g: PlanGate) -> Int { count(tg_gate_bricks(g: g)) }

fn tg_gate_placed(g: PlanGate) -> Int {
  count(filter(tg_gate_bricks(g: g), m => tg_brick_is_placed(bs: m.brick_state)))
}

fn tg_gate_percent(placed: Int, total: Int) -> Int {
  if total == 0 { 0 } else { placed * 100 / total }
}

fn tg_gate_count_label(placed: Int, total: Int) -> String {
  concat(to_string(placed), concat(" / ", to_string(total)))
}

fn tg_bar_fill(pct: Int) -> MarkupNode {
  ElementNode {
    tag: "div",
    attrs: [
      MarkupAttr { name: "class", value: "bar-fill" },
      MarkupAttr { name: "style", value: concat("width: ", concat(to_string(pct), "%")) },
    ],
    children: [],
  }
}

fn tg_brick_li(m: PlanMilestone) -> MarkupNode {
  el_class("li", concat("brick brick-", tg_brick_state_class(bs: m.brick_state)), [
    el_class("span", "brick-state", [ txt(tg_brick_state_label(bs: m.brick_state)) ]),
    el_class("span", "brick-title", [ txt(m.title) ]),
  ])
}

fn tg_gate_remaining_ul(g: PlanGate) -> MarkupNode {
  el_class("ul", "bricks",
    map(filter(tg_gate_bricks(g: g), m => tg_brick_is_remaining(bs: m.brick_state)), m => tg_brick_li(m: m)))
}

fn tg_gate_progress_row(spec: PlanGateSpec) -> MarkupNode {
  let total = tg_gate_total(g: spec.gate)
  let placed = tg_gate_placed(g: spec.gate)
  el_class("section", "gate-row", [
    el_class("div", "gate-head", [
      el_class("span", "gate-name", [ txt(spec.name) ]),
      el_class("span", "gate-count", [ txt(tg_gate_count_label(placed: placed, total: total)) ]),
    ]),
    el_class("div", "gate-bar", [ tg_bar_fill(pct: tg_gate_percent(placed: placed, total: total)) ]),
    tg_gate_remaining_ul(g: spec.gate),
  ])
}

fn tg_is_bar_gate(g: PlanGate) -> Bool {
  match g {
    GateEmitterFixedPoint => true
    GateHonestFrontier => true
    GateLedgerGreen => true
    GateDeletion => false
  }
}

fn three_gate_progress_markup() -> MarkupNode {
  el_class("section", "three-gate-progress",
    concat(
      [ el("h2", [ txt("v1-delete bar: three gates") ]) ],
      map(filter(v1_deletion_gates, spec => tg_is_bar_gate(g: spec.gate)),
          spec => tg_gate_progress_row(spec: spec))))
}

fn roadmap_header(title: String) -> MarkupNode {
  el("header", [ render_mark(depth: 1), el("h1", [ txt(title) ]) ])
}

fn node_status_symbol(rn: RoadmapNode, merged: List<Int>) -> String {
  if item_superseded_by(item: rn.line) == "" {
    if signoff_accepts(s: rn.signoff) {
      "done"
    } else {
      if item_is_done(item: rn.line, merged: merged) {
        "review"
      } else {
        "open"
      }
    }
  } else {
    "superseded"
  }
}

fn intricacy_label(i: Intricacy) -> String {
  match i {
    IntricacyLow => "i:low"
    IntricacyMedium => "i:med"
    IntricacyHigh => "i:high"
  }
}

fn volume_label(v: Volume) -> String {
  match v {
    VolumeSmall => "v:small"
    VolumeMedium => "v:med"
    VolumeLarge => "v:large"
  }
}

fn sizing_label(s: NodeSizing) -> String {
  match s {
    Unsized => ""
    Sized { intricacy, volume, repo, acceptance } =>
      join([intricacy_label(i: intricacy), " ", volume_label(v: volume), " ", repo], "")
  }
}

fn line_title(line: RoadmapItem) -> String {
  match line {
    DerivableLine { prs, title, description } => title
    AuthoredLine { done, content } => content
    PlainLine { content } => content
    SupersededLine { by: _, content } => content
  }
}

fn title_nodes(line: RoadmapItem) -> List<MarkupNode> {
  markdown_inlines_to_markup_nodes(inlines: parse_inline_markdown_minimal(text: line_title(line: line)))
}

fn pointer_link(p: Pointer) -> MarkupNode {
  ElementNode {
    tag: "a",
    attrs: [ MarkupAttr { name: "href", value: p.path } ],
    children: [ txt(p.label) ],
  }
}

fn carrier_links(carriers: List<Pointer>) -> List<MarkupNode> {
  map(carriers, p => pointer_link(p: p))
}

fn children_of(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, parent: RoadmapNodeId) -> List<RoadmapNode> {
  nodes |> filter(n => match roadmap_parent(edges: edges, node: n.node) {
    UnderParent { parent: p } => p == parent
    TopLevel => false
  })
}

fn owner_badge(rn: RoadmapNode) -> List<MarkupNode> {
  if rn.owner == "" {
    []
  } else {
    [ el_class("span", "owner", [ txt(concat("@", rn.owner)) ]) ]
  }
}

fn sizing_badge(rn: RoadmapNode) -> List<MarkupNode> {
  let label = sizing_label(s: rn.sizing)
  if label == "" {
    []
  } else {
    [ el_class("span", "sizing", [ txt(label) ]) ]
  }
}

data dispatch_button_note: String = "The launch button (operator 2026-07-20: manual click-to-dispatch). Rendered on every NOT-signoff-done node (open OR review -- DONE = the operator's signoff, never a merged PR), carrying data-node = the node id. Its client behavior is a MODELED TsProgram (gunbc.roadmap_component.dispatch_client_program), emitted as an EXTERNAL served asset (roadmap_dispatch_asset_path, served by belt B) and referenced by <script src> -- NOT a hand-concatenated JS string inlined into the HTML (the former was the dispatch-button incident's root class, §5, and the inline placement was a hack: an inline <script> text node escapes '>' under std.markup, corrupting an arrow's `=>`; external emission is escape-clean). It reads belt B's `status` contract with the ok-set DERIVED from belt_dispatch_ok_status_labels; the retired belt-A `ok`/`node` shape is gone and cannot return (the page witness holds a RED on `j.ok`)."

fn superseded_badge(rn: RoadmapNode) -> List<MarkupNode> {
  let by = item_superseded_by(item: rn.line)
  if by == "" {
    []
  } else {
    [ el_class("span", "superseded-by", [ txt(concat("→ ", by)) ]) ]
  }
}

fn dispatch_button_nodes(rn: RoadmapNode, merged: List<Int>) -> List<MarkupNode> {
  let status = node_status_symbol(rn: rn, merged: merged)
  if status == "done" || status == "superseded" {
    []
  } else {
    [
      ElementNode {
        tag: "button",
        attrs: [
          MarkupAttr { name: "class", value: "dispatch-btn" },
          MarkupAttr { name: "type", value: "button" },
          MarkupAttr { name: "data-node", value: rn.node as String },
        ],
        children: [ txt("dispatch") ],
      },
    ]
  }
}

fn dispatch_client_script() -> MarkupNode {
  ElementNode {
    tag: "script",
    attrs: [
      MarkupAttr { name: "src", value: roadmap_dispatch_asset_path },
      MarkupAttr { name: "defer", value: "" },
    ],
    children: [],
  }
}

data page_script_census_note: String = "The served-page script wall (P1): every script the page carries must be MODELED, not a hand-authored string. The page emits its dispatch behavior as an external <script src> pointing at roadmap_dispatch_asset_path (whose body IS serialize_typescript_program of a modeled TsProgram, served by belt B). So the census walks the page tree and refuses two shapes fail-closed: an inline <script> with a non-empty text node (a hand JS string, the dispatch-button incident's class) and a <script src> pointing anywhere but a known modeled asset. Green over the real page; the RED controls (a resurrected inline string script; a rogue src) each locate their violation. Mirror of the unthemed-color / untokened-length censuses: a pure reader over the same MarkupNode tree, no new substrate."

type PageScriptViolation {
  kind: String
  detail: String
}

fn script_inline_text(children: List<MarkupNode>) -> String {
  fold(children, init: "", f: (acc, c) => match c {
    TextNode { text } => concat(acc, text)
    ElementNode { tag: _, attrs: _, children: _ } => acc
  })
}

fn script_src_attr(attrs: List<MarkupAttr>) -> String {
  fold(attrs, init: "", f: (acc, a) => if a.name == "src" { a.value } else { acc })
}

fn collect_script_violations(node: MarkupNode, known_src: String) -> List<PageScriptViolation> {
  match node {
    TextNode { text: _ } => []
    ElementNode { tag, attrs, children } =>
      if tag == "script" {
        let inline = script_inline_text(children: children)
        let src = script_src_attr(attrs: attrs)
        concat(
          if inline == "" { [] } else { [PageScriptViolation { kind: "inline-js", detail: inline }] },
          if src == "" || src == known_src { [] } else { [PageScriptViolation { kind: "unknown-src", detail: src }] },
        )
      } else {
        fold(children, init: [], f: (acc, c) => concat(acc, collect_script_violations(node: c, known_src: known_src)))
      }
  }
}

fn page_script_census(page: MarkupNode) -> List<PageScriptViolation> {
  collect_script_violations(node: page, known_src: roadmap_dispatch_asset_path)
}

fn node_li(rn: RoadmapNode, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, fuel: Int) -> MarkupNode {
  let status = node_status_symbol(rn: rn, merged: merged)
  let head = concat(
    concat(
      [
        el_class("span", concat("status status-", status), [ txt(status) ]),
        el_class("span", "title", title_nodes(line: rn.line)),
      ],
      concat(superseded_badge(rn: rn), owner_badge(rn: rn)),
    ),
    concat(sizing_badge(rn: rn), carrier_links(carriers: rn.carriers)),
  )
  let kids = children_of(nodes: nodes, edges: edges, parent: rn.node)
  let child_block = if count(kids) == 0 {
    []
  } else {
    if fuel > 0 {
      [ nodes_ul(items: kids, nodes: nodes, edges: edges, merged: merged, fuel: fuel - 1) ]
    } else {
      [
        ElementNode {
          tag: "ul",
          attrs: [ MarkupAttr { name: "class", value: "depth-limited" } ],
          children: [
            el_class("li", "depth-limit", [
              txt(concat(concat("(", to_string(count(kids))), " nested node(s) hidden — depth limit)")),
            ]),
          ],
        },
      ]
    }
  }
  ElementNode {
    tag: "li",
    attrs: [ MarkupAttr { name: "class", value: concat("node node-", status) } ],
    children: concat(concat(head, dispatch_button_nodes(rn: rn, merged: merged)), child_block),
  }
}

fn nodes_ul(items: List<RoadmapNode>, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, fuel: Int) -> MarkupNode {
  el("ul", map(items, rn => node_li(rn: rn, nodes: nodes, edges: edges, merged: merged, fuel: fuel)))
}

fn group_markup(g: SectionGroup, merged: List<Int>) -> List<MarkupNode> {
  let tops = g.nodes |> filter(n => is_top_level(edges: g.edges, node: n.node))
  let ul = nodes_ul(items: tops, nodes: g.nodes, edges: g.edges, merged: merged, fuel: roadmap_page_max_depth())
  if g.label == "" {
    [ ul ]
  } else {
    [ el_class("h3", "group-label", [ txt(g.label) ]), ul ]
  }
}

fn element_markup(e: SectionElement, merged: List<Int>) -> List<MarkupNode> {
  match e {
    Prose { prose } => [ el_class("p", "prose", markdown_inlines_to_markup_nodes(inlines: parse_inline_markdown_minimal(text: prose.content))) ]
    Group { group } => group_markup(g: group, merged: merged)
  }
}

fn section_markup(s: RoadmapSection, merged: List<Int>) -> MarkupNode {
  let body = fold(s.elements, init: [], f: (acc, e) => concat(acc, element_markup(e: e, merged: merged)))
  el_class("section", "roadmap-section", concat([ el("h2", [ txt(s.title) ]) ], body))
}

fn frontier_flat_node_li(rn: RoadmapNode, merged: List<Int>) -> MarkupNode {
  let status = node_status_symbol(rn: rn, merged: merged)
  let head = concat(
    concat(
      [
        el_class("span", concat("status status-", status), [ txt(status) ]),
        el_class("span", "title", title_nodes(line: rn.line)),
      ],
      concat(superseded_badge(rn: rn), owner_badge(rn: rn)),
    ),
    concat(sizing_badge(rn: rn), carrier_links(carriers: rn.carriers)),
  )
  ElementNode {
    tag: "li",
    attrs: [ MarkupAttr { name: "class", value: concat("node node-", status) } ],
    children: concat(head, dispatch_button_nodes(rn: rn, merged: merged)),
  }
}

fn frontier_bucket_ul(items: List<RoadmapNode>, merged: List<Int>) -> MarkupNode {
  el("ul", map(items, rn => frontier_flat_node_li(rn: rn, merged: merged)))
}

fn frontier_bucket_markup(label: String, cls: String, items: List<RoadmapNode>, merged: List<Int>) -> MarkupNode {
  el_class("section", concat("frontier-bucket frontier-", cls), [
    el("h2", [ txt(label) ]),
    frontier_bucket_ul(items: items, merged: merged),
  ])
}

fn roadmap_frontier_markup(frontier: SpawnFrontier, merged: List<Int>) -> MarkupNode {
  el_class("section", "roadmap-frontier", [
    frontier_bucket_markup(label: "Ready", cls: "ready", items: frontier.ready, merged: merged),
    frontier_bucket_markup(label: "Upcoming", cls: "upcoming", items: frontier.upcoming, merged: merged),
    frontier_bucket_markup(label: "Done", cls: "done", items: frontier.done, merged: merged),
    frontier_bucket_markup(label: "Superseded", cls: "superseded", items: frontier.superseded, merged: merged),
  ])
}

fn roadmap_daily_workspace_page_impl(doc: RoadmapDocument, merged: List<Int>, main_prefix: List<MarkupNode>) -> MarkupNode {
  let frontier = spawn_frontier(doc: doc, merged: merged)
  ElementNode {
    tag: "html",
    attrs: [],
    children: [
      el("head", [
        ElementNode { tag: "meta", attrs: [ MarkupAttr { name: "charset", value: "utf-8" } ], children: [] },
        el("style", [ txt(roadmap_css()) ]),
        el("title", [ txt("gunbc — daily workspace") ]),
      ]),
      el("body", [
        roadmap_header(title: "gunbc — daily workspace"),
        el_class("main", "daily-workspace", concat(main_prefix, [
          roadmap_frontier_markup(frontier: frontier, merged: merged),
        ])),
        dispatch_client_script(),
      ]),
    ],
  }
}

fn roadmap_page_impl(doc: RoadmapDocument, merged: List<Int>, main_prefix: List<MarkupNode>) -> MarkupNode {
  let lead = map(doc.lead_lanes, s => section_markup(s: s, merged: merged))
  let secs = map(doc.sections, s => section_markup(s: s, merged: merged))
  let main_children = concat(main_prefix, concat(lead, secs))
  let body_base = [
    roadmap_header(title: "gunbc — roadmap"),
    el_class("main", "roadmap", main_children),
  ]
  let body_children = if list_length(main_children) == 0 {
    body_base
  } else {
    concat(body_base, [ dispatch_client_script() ])
  }
  ElementNode {
    tag: "html",
    attrs: [],
    children: [
      el("head", [
        ElementNode { tag: "meta", attrs: [ MarkupAttr { name: "charset", value: "utf-8" } ], children: [] },
        el("style", [ txt(roadmap_css()) ]),
        el("title", [ txt("gunbc — roadmap") ]),
      ]),
      el("body", body_children),
    ],
  }
}

fn roadmap_page(doc: RoadmapDocument, merged: List<Int>) -> MarkupNode {
  roadmap_page_impl(doc: doc, merged: merged, main_prefix: [])
}

fn roadmap_page_for_authority() -> MarkupNode {
  roadmap_page_impl(doc: roadmap_authority(), merged: authored_merged_prs(), main_prefix: [ three_gate_progress_markup() ])
}

fn roadmap_daily_workspace_page(doc: RoadmapDocument, merged: List<Int>) -> MarkupNode {
  roadmap_daily_workspace_page_impl(doc: doc, merged: merged, main_prefix: [])
}

fn roadmap_daily_workspace_page_for_authority() -> MarkupNode {
  roadmap_daily_workspace_page_impl(doc: roadmap_authority(), merged: authored_merged_prs(), main_prefix: [ three_gate_progress_markup() ])
}
