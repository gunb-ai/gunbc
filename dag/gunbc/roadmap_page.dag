module gunbc.roadmap_page

fn roadmap_page_max_depth() -> Int { 12 }

data finish_line_placement_note: String = "The finish-line block is REFERENCE prose, not operational attention (A1 of the presentation recon, operator-signed 2026-08-01): the daily workspace's declared archetype is Operational (gunbc.design.archetype dashboard_archetype), so / leads with the frontier and carries only the one-line program strip (program_progress_markup_of, the ProgramProgressView consumer); the four claims render on /roadmap, where the strategic argument lives. The 2026-07-28 stylesheet-debt scaffold that shipped this section unstyled dissolved in the same pass: the gate/brick rules are deleted, .finish-line-* rules exist on the tokened grain, and roadmap_css_lift_parity_digest was re-pinned by execution (see the A1 re-pin note in test.claim.design_register_lift_parity_witness). The count line under the heading is the LOCAL denominator — accepted finish lines over the four — never the global roadmap population, which belonged to a different question (review: the section visually implied a denominator of four while reporting an unrelated global one)."

fn finish_line_state_class(accepted: Bool) -> String {
  if accepted { "accepted" } else { "active" }
}

fn finish_line_row(spec: gunbc.v1_deletion_plan.V1FinishLineSpec, accepted_ids: List<gunbc.roadmap_model.RoadmapNodeId>) -> std.markup.Fragment {
  let accepted = v1_finish_line_accepted(spec: spec, accepted: accepted_ids)
  el_class("li", concat("finish-line finish-line-", finish_line_state_class(accepted: accepted)), [
    el_class("span", "finish-line-state", [ txt(finish_line_state_class(accepted: accepted)) ]),
    el_class("span", "finish-line-name", [ txt(spec.name) ]),
    el_class("span", "finish-line-node", [ txt(spec.node as String) ]),
    el_class("span", "finish-line-claim", [ txt(spec.claim) ]),
  ])
}

fn finish_line_local_count_label(accepted_ids: List<gunbc.roadmap_model.RoadmapNodeId>) -> String {
  join([
    to_string(v1_finish_lines_accepted_count(accepted: accepted_ids)),
    " of ",
    to_string(count(v1_exit_finish_lines())),
    " complete",
  ], "")
}

fn finish_line_progress_markup_for_accepted(accepted_ids: List<gunbc.roadmap_model.RoadmapNodeId>) -> std.markup.Fragment {
  el_class("section", "finish-line-progress", [
    el("h2", [ txt("v1 exit: four finish lines") ]),
    el_class("p", "finish-line-counts", [ txt(finish_line_local_count_label(accepted_ids: accepted_ids)) ]),
    el_class("ul", "finish-lines",
      map(v1_exit_finish_lines(), s => finish_line_row(spec: s, accepted_ids: accepted_ids))),
  ])
}

fn finish_line_progress_markup() -> std.markup.Fragment {
  match accepted_roadmap_node_ids_projection() {
    AcceptedRoadmapNodeIdsProjectionRefused { detail: detail } =>
      el_class("section", "finish-line-progress", [
        el("h2", [ txt("v1 exit: four finish lines") ]),
        el_class("p", "finish-line-refused", [
          txt(concat("acceptance carrier refused: ", detail)),
        ]),
      ])
    AcceptedRoadmapNodeIdsProjected { ids: accepted_ids } =>
      finish_line_progress_markup_for_accepted(accepted_ids: accepted_ids)
  }
}

fn dashboard_instance_banner() -> std.markup.Fragment {
  el_class("section", dashboard_instance_class, [
    el_class("span", dashboard_instance_label_class, [
      txt("instance · observing"),
    ]),
  ])
}

data sound_toggle_placement_note: String = "The mute lives in the HEADER, pushed to the far edge by margin-left auto, because it is a property of the whole surface rather than of any row — a per-row mute would be a second control on every line, which is exactly what the exemplar's scope forbids. The former empty-label rendering was corrected at A1 (presentation recon, 2026-08-01): honest-before-JS does not require blankness — a blank button has no visible content and no accessible name, which is a defect, not honesty. The TWO TOGGLES SHIP DIFFERENT AMOUNTS OF STATE, and the asymmetry is the honesty boundary, not an inconsistency (A1 reconciliation, operator feedback 2026-08-01): the theme control ships 'theme · auto' because at parse time the document carries no data-theme and prefers-color-scheme governs — which is the DEFINITION of auto, true for every visitor until the client program applies a stored choice; the sound control ships only its NAME because its state has no parse-time truth — the preference lives in this browser's storage (unreadable at serve), and for a no-JS visitor no sound ever plays, so any shipped state word would be a fabricated claim for someone. The client program repaints both from storage on load, exactly as before."

fn sound_toggle_control() -> std.markup.Fragment {
  el_attrs("button", [
    attr(name: "class", value: sound_toggle_class ),
    attr(name: "type", value: "button" ),
  ], [ txt("sound") ])
}

fn theme_toggle_control() -> std.markup.Fragment {
  el_attrs("button", [
    attr(name: "class", value: theme_toggle_class ),
    attr(name: "type", value: "button" ),
  ], [ txt(join([theme_toggle_label_prefix, theme_toggle_auto_value], "")) ])
}

data roadmap_wordmark_note: String = "A1 header decision (presentation recon, operator-signed 2026-08-01): the header carries a TEXT wordmark, not the site mark. The mark that stood here was gunbc.site.mark candidate A ('Confluence') — an explicitly unselected brand experiment (DESIGN's site thread still owes candidates B–D) whose aria-label said 'gunb.ai mark' on a gunbc operational tool: a public-site brand artifact leaking into a tool surface. The minimal correct move is the wordmark; a drawn mark returns if and when an actual brand-selection task runs (the sandbox auditioner is the venue, the swatch-graduation precedent). The h1 carries the PAGE name alone — the product name lives in the wordmark, so the two never restate each other."

data header_composition_frame_note: String = "HEADER AND CONTENT SHARE ONE COMPOSITION FRAME (A2 hierarchy closeout, operator gap ruling 2026-08-02: the wide-screen fold showed two alignment systems — the header hugging the left viewport edge while the content column centered at the page measure, leaving a dead gutter that read as accident). The header element keeps its full-width surface and border — it is a chassis edge — but its CONTENT now lives in .header-inner, the same measure_page/auto-margin frame the .roadmap and .daily-workspace columns use, so the wordmark, page name, and controls sit flush over the content column at every width. One frame, stated once: the inner wrapper consumes the identical tokens, so a measure change moves header and content together."

fn roadmap_header(page: String) -> std.markup.Fragment {
  el("header", [
    el_class("div", "header-inner", [
      el_class("span", "wordmark", [ txt("gunbc") ]),
      el("h1", [ txt(page) ]),
      sound_toggle_control(),
      theme_toggle_control(),
    ]),
  ])
}

data page_status_vocab_note: String = "The status vocabulary the page renders (chip text, node-<key> classes, altitude-band counts) is work_lifecycle_key over the seam's WorkLifecycle — the node_status_symbol decision moved to gunbc.roadmap_presentation as its single authority (operator blocker 1, 2026-08-01: the old renderer independently re-decided open/review/done/superseded beside the seam). The key set is unchanged, so the altitude machinery and the styling grain consume the same four words."

fn node_lifecycle_key(rn: gunbc.roadmap_model.RoadmapNode, merged: List<Int>) -> String {
  work_lifecycle_key(l: work_lifecycle(rn: rn, merged: merged))
}

data roadmap_lead_budget_note: String = "The lead is the row's at-a-glance face: the seam's row_headline (the ticket's typed headline; for legacy lines the named lead residue inside gunbc.roadmap_presentation). A row whose LEAD is itself paragraph-length defeats the disclosure — the brief stays collapsed but the summary line does not, so the reader pays the full text anyway. The bound is authoring residue, not a structural class: no construction forbids a long sentence, so this is the §5-sanctioned lens over the genuinely unstructurable part, and it is typed/located/counted (node id + measured length) rather than a bare Bool, so a red says WHICH row and by how much. 300 chars is the operator's declared bound (roadmap-workspace-ux-plan.md P1b); an offender is re-cut by moving its summary delimiter earlier or splitting its content, while the body remains available behind the disclosure."

fn roadmap_lead_budget_chars() -> Int { 300 }

type LeadBudgetViolation {
  node: String
  lead_chars: Int
}

fn lead_budget_violations(nodes: List<gunbc.roadmap_model.RoadmapNode>) -> List<LeadBudgetViolation> {
  fold(nodes, init: [], f: (acc, rn) => {
    let n = row_headline(line: rn.line).length()
    if n > roadmap_lead_budget_chars() {
      concat(acc, [LeadBudgetViolation { node: rn.node as String, lead_chars: n }])
    } else {
      acc
    }
  })
}

fn roadmap_authority_lead_budget_violations() -> List<LeadBudgetViolation> {
  lead_budget_violations(nodes: declared_roadmap_nodes())
}

data ticket_brief_budget_note: String = "The brief bound (operator's ticket model: a brief is ~100 words or less, read daily). Same shape as the lead budget: authoring residue no construction can forbid, so a typed located counted census — a red carries the node id and the measured count, never a bare Bool. Words, not characters, because the operator priced it in reading, and a word is the unit reading is priced in."

data ticket_brief_word_budget: Int = 100

type BriefBudgetViolation {
  node: gunbc.roadmap_model.RoadmapNodeId
  words: Int
}

fn ticket_brief_word_count(brief: String) -> Int {
  count(split(s: brief, delimiter: " "))
}

fn ticket_brief_violations(nodes: List<gunbc.roadmap_model.RoadmapNode>) -> List<BriefBudgetViolation> {
  fold(nodes, init: [], f: (acc, rn) => match line_ticket(item: rn.line) {
    Absent => acc
    Present { value: t } => {
      let words = ticket_brief_word_count(brief: t.brief)
      if words > ticket_brief_word_budget {
        concat(acc, [BriefBudgetViolation { node: rn.node, words: words }])
      } else {
        acc
      }
    }
  })
}

data ticket_brief_budget_subject_note: String = "THE BUDGET GOVERNS AUTHORED TICKET PROSE, SO IT WALKS THE AUTHORED NODES RATHER THAN THE PROJECTION. It previously walked doc_all_nodes(roadmap_authority()), which includes the DERIVED closing-contract task nodes whose boundary is generated as a fixed prefix plus the target node's red_control. That made the budget a second, indirect and undeclared constraint on red_control length: accepting any node could push a DIFFERENT node over budget, because acceptance makes the next node startable-and-unbound and therefore derives a closing-contract row for it.\n\nThat is exactly what happened when v1-interpreter-primitive-roster was accepted: v1-interpreter-primitive-dispatch-authority became the frontier, its derived row's brief came to the prefix plus a six-clause red_control, and the budget refused -- with the only available remedies being to trim a carefully authored acceptance bar to satisfy a PAGE constraint, or to leave every PR touching roadmap_authority.dag red. Neither is the budget's purpose.\n\nA derived brief is a projection of a field that is already governed where it is authored. Budgeting the projection prices the source field twice, through a channel nobody declared. So the subject is declared_roadmap_nodes(): every authored ticket, accepted or active, and nothing generated. The planted-fixture RED control is unaffected -- it passes an authored node directly to ticket_brief_violations, which still refuses at the same threshold."

fn roadmap_ticket_brief_violations() -> List<BriefBudgetViolation> {
  ticket_brief_violations(nodes: declared_roadmap_nodes())
}

fn inline_md_nodes(text: String) -> List<std.markup.Fragment> {
  markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: text))
}

fn disclosure_field_row(f: gunbc.roadmap_presentation.DisclosureField) -> std.markup.Fragment {
  el_class("div", "ticket-field", concat(
    [ el_class("span", "ticket-field-label", [ txt(f.label) ]) ],
    [ el_class("span", "ticket-field-value", inline_md_nodes(text: f.value)) ]))
}

fn disclosure_update_row(u: gunbc.roadmap_presentation.DisclosureNote) -> std.markup.Fragment {
  el_class("div", "ticket-update", concat(
    [ el_class("span", "ticket-update-date", [ txt(u.on) ]) ],
    [ el_class("span", "ticket-update-note", inline_md_nodes(text: u.note)) ]))
}

fn disclosure_updates_block(updates: List<gunbc.roadmap_presentation.DisclosureNote>) -> List<std.markup.Fragment> {
  if count(updates) == 0 {
    []
  } else {
    [ el_class("div", "ticket-updates", concat(
        [ el_class("div", "ticket-updates-head", [ txt("updates") ]) ],
        map(updates, u => disclosure_update_row(u: u)))) ]
  }
}

fn disclosure_body_nodes(d: gunbc.roadmap_presentation.DisclosureView) -> List<std.markup.Fragment> {
  match d {
    NoDisclosure => []
    TicketDisclosure { brief, fields, updates } =>
      concat(
        [ el_class("p", "ticket-brief", inline_md_nodes(text: brief)) ],
        concat(
          map(fields, f => disclosure_field_row(f: f)),
          disclosure_updates_block(updates: updates)))
    LegacyBodyDisclosure { content } =>
      markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: content))
  }
}

data item_facts_disclosure_note: String = "Supporting facts live in the disclosure, not the head row (A1 of the presentation recon, operator-signed 2026-08-01): the head line had grown to ~7 simultaneous inline facts — owner, sizing codes, carrier links, dependencies — wrapping arbitrarily under the title, which is the half-console-half-product voice fork the recon named. The head carries the row's PRIMARY facts only plus the actuator; owner/sizing/carriers are supporting facts behind the same disclosure that already held the body. A row with supporting facts but no body still discloses (summary label 'facts'), so no fact is dropped — only demoted. AT A2 this renderer reads the DECIDED view alone: supporting facts arrive as WorkRowView.supporting_facts rows (label/value/href), the body as WorkRowView.disclosure — the RoadmapNode/TicketFields reads that used to live here moved behind the seam."

fn supporting_fact_node(f: gunbc.roadmap_presentation.SupportingFact) -> std.markup.Fragment {
  if f.href == "" {
    el_class("span", f.label, [ txt(f.value) ])
  } else {
    el_attrs("a", [ attr(name: "href", value: join([github_blob_base, f.href], "") ) ], [ txt(f.value) ])
  }
}

fn view_supporting_facts(view: gunbc.roadmap_presentation.WorkRowView) -> List<std.markup.Fragment> {
  if count(view.supporting_facts) == 0 {
    []
  } else {
    [ el_class("div", "item-facts", map(view.supporting_facts, f => supporting_fact_node(f: f))) ]
  }
}

fn view_detail_block(view: gunbc.roadmap_presentation.WorkRowView) -> List<std.markup.Fragment> {
  let facts = view_supporting_facts(view: view)
  let body = disclosure_body_nodes(d: view.disclosure)
  if count(facts) == 0 && count(body) == 0 {
    []
  } else {
    let is_ticket = match view.disclosure {
      TicketDisclosure { brief: _, fields: _, updates: _ } => true
      NoDisclosure => false
      LegacyBodyDisclosure { content: _ } => false
    }
    let label = if is_ticket { "details" } else { if count(body) == 0 { "facts" } else { "brief" } }
    [ el_attrs("details", [
        attr(name: "class", value: if is_ticket { "item-detail ticket-row" } else { "item-detail" } ),
      ], [
        el("summary", [
          el_class("span", disclosure_mark_class, [ txt(disclosure_mark_glyph) ]),
          txt(label),
        ]),
        el_class("div", "item-body", concat(facts, body)),
      ]) ]
  }
}

data github_blob_base_note: String = "The per-surface link projection (remodel W2, census row 7): a Pointer's path is a REPO path — correct in GitHub's renderer, dead on the served page by construction (no /docs route). The served surface projects repo paths through the GitHub blob base so every carrier link answers; when repo paths gain a served route (the storage-blind lane, W3 neighborhood), this base swaps for that route in ONE place. The prose-inline [label](docs/...) links inside legacy AuthoredLine blobs remain relative — a named residue that dies with the blobs themselves (W2-bulk)."

data github_blob_base: String = "https://github.com/gunb-ai/gunbc/blob/main/"

fn children_of(nodes: List<gunbc.roadmap_model.RoadmapNode>, edges: List<gunbc.roadmap_model.RoadmapEdge>, parent: gunbc.roadmap_model.RoadmapNodeId) -> List<gunbc.roadmap_model.RoadmapNode> {
  nodes |> filter(n => match roadmap_primary_parent(edges: edges, node: n.node) {
    UnderParent { parent: p } => p == parent
    TopLevel => false
  })
}

data dispatch_button_note: String = "The launch button (operator 2026-07-20: manual click-to-dispatch). Rendered on every open or review node; only signoff-Done and authored Superseded rows hide it. This deliberately preserves manual out-of-order dispatch for blocked and unsized rows: spawn_frontier.ready governs automatic belt reconciliation and page grouping, not the manual POST admission contract. belt_dispatch_node currently refuses signoff-Done but does not consult Ready, so the page must not claim otherwise. The button carries data-node = the node id. Its client behavior is a MODELED TsProgram (gunbc.roadmap_component.dispatch_client_program), emitted as an EXTERNAL served asset (roadmap_dispatch_asset_path, served by belt B) and referenced by <script src> -- NOT a hand-concatenated JS string inlined into the HTML (the former was the dispatch-button incident's root class, §5, and the inline placement was a hack: an inline <script> text node escapes '>' under std.markup, corrupting an arrow's `=>`; external emission is escape-clean). It reads belt B's `status` contract with the ok-set DERIVED from belt_dispatch_ok_status_labels; the retired belt-A `ok`/`node` shape is gone and cannot return (the page witness holds a RED on `j.ok`)."

fn superseded_badge_of(view: gunbc.roadmap_presentation.WorkRowView) -> List<std.markup.Fragment> {
  if view.superseded_by == "" {
    []
  } else {
    [ el_class("span", "superseded-by", [ txt(concat("→ ", view.superseded_by)) ]) ]
  }
}

fn view_dispatch_actions(view: gunbc.roadmap_presentation.WorkRowView) -> List<gunbc.roadmap_presentation.WorkAction> {
  let primary = match view.action.primary_action {
    Present { value: a } => [a]
    Absent => []
  }
  concat(primary, view.action.secondary_actions) |> filter(a => match a.kind {
    DispatchAction => true
    ClearSessionAction => false
  })
}

data dispatch_button_axes_note: String = "THE BUTTON CARRIES ITS DECIDED AXES (A2 hierarchy closeout, operator gap ruling 2026-08-02: 'action prominence derives from selection and priority, not mere availability'). The seam already decided priority and availability per action (action_axes_note); this renderer used to flatten both into one identical class, which is exactly how fourteen equally loud pills reached the desktop fold while LANDED rows kept the ready-row treatment. The class now carries the decided priority (action-primary / action-secondary) and data-availability carries the admission fact, so the stylesheet can rest every in-row control quiet and the client program can raise ONLY the selected row's primary action to the invite band (the action-focal class — selection is client state, prominence is its projection; named for the grant, not for liveness). Status classes keep winning in the cascade: emphasis never overrides truth. No-JS visitors see every control quiet but present, labeled, and operable — honest-before-JS forbids blankness, not calm."

fn dispatch_button_nodes(view: gunbc.roadmap_presentation.WorkRowView) -> List<std.markup.Fragment> {
  map(view_dispatch_actions(view: view), a =>
    el_attrs("button", [
      attr(name: "class", value: concat("dispatch-btn action-", action_priority_key(p: a.priority)) ),
      attr(name: "type", value: "button" ),
      attr(name: "data-node", value: view.node_id ),
      attr(name: "data-availability", value: action_availability_key(a: a.availability) ),
    ], [ txt("dispatch") ]))
}

data workflow_controls_actions_only_note: String = "The actuator cell carries ACTIONS ONLY (A2, the falsifier correction — see roadmap_row_archetype_note). The server-rendered lamp strip, seven pending stage chips, and 'waiting' activity text that used to preload this wrapper were exactly the furniture the attention rule forbids: a row with no attempt renders NO workflow DOM at all, and a row with one gets its activity painted by the client into the under-head ActivityRegion from the DECIDED /workflow.json view — never into this cell. The wrapper stays always-present so the dispatch control keeps a stable actuator home and the head grid keeps its three derived tracks."

fn workflow_controls_nodes(view: gunbc.roadmap_presentation.WorkRowView) -> List<std.markup.Fragment> {
  [ el_class("div", workflow_controls_class,
      dispatch_button_nodes(view: view)) ]
}

fn dispatch_client_script() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "script",
    attributes: [
      attr(name: "src", value: roadmap_dispatch_asset_path ),
      attr(name: "defer", value: "" ),
    ],
    children: [],
  }
}

data page_script_census_note: String = "The served-page script wall (P1): every script the page carries must be MODELED, not a hand-authored string. The page emits its dispatch behavior as an external <script src> pointing at roadmap_dispatch_asset_path (whose body IS serialize_typescript_program of a modeled TsProgram, served by belt B). So the census walks the page tree and refuses two shapes fail-closed: an inline <script> with a non-empty text node (a hand JS string, the dispatch-button incident's class) and a <script src> pointing anywhere but a known modeled asset. Green over the real page; the RED controls (a resurrected inline string script; a rogue src) each locate their violation. Mirror of the unthemed-color / untokened-length censuses: a pure reader over the same Fragment tree, no new substrate."

type PageScriptViolation {
  kind: String
  detail: String
}

fn script_inline_text(children: List<std.markup.Fragment>) -> String {
  fold(children, init: "", f: (acc, c) => match c {
    FragmentText { content } => concat(acc, content)
    RawNode { content } => concat(acc, content)
    Element { tag: _, attributes: _, children: _ } => acc
  })
}

fn script_src_attr(attributes: List<std.markup.Attribute>) -> String {
  fold(attributes, init: "", f: (acc, a) => if a.name == "src" { a.value } else { acc })
}

fn collect_script_violations(node: std.markup.Fragment, known_src: String) -> List<PageScriptViolation> {
  match node {
    FragmentText { content: _ } => []
    RawNode { content: _ } => []
    Element { tag, attributes, children } =>
      if tag == "script" {
        let inline = script_inline_text(children: children)
        let src = script_src_attr(attributes: attributes)
        concat(
          if inline == "" { [] } else { [PageScriptViolation { kind: "inline-js", detail: inline }] },
          if src == "" || src == known_src { [] } else { [PageScriptViolation { kind: "unknown-src", detail: src }] },
        )
      } else {
        fold(children, init: [], f: (acc, c) => concat(acc, collect_script_violations(node: c, known_src: known_src)))
      }
  }
}

fn page_script_census(page: std.markup.Fragment) -> List<PageScriptViolation> {
  collect_script_violations(node: page, known_src: roadmap_dispatch_asset_path)
}

data a1_composition_provisional_note: String = "SCOPE STATEMENT for the A1 pass (operator feedback 2026-08-01): the flat row list, the head-line composition, and the visual style of this module are ONE PROVISIONAL RENDERER, not product ontology. What A1 fixed is which claims render and at what altitude (operational before narrative, local denominators, supporting facts demoted, routine chrome quieted); it deliberately did NOT choose the workspace's interaction model. The named misses carried forward to the presentation-seam slice (A2: WorkRowView/DailyWorkspaceView/ObservationImpactView, roadmap_page becomes serialize-only): the row's one purpose-specific supporting line (why-now / what-it-unlocks — deferred because no typed fact carries it yet, and truncating ticket prose by punctuation is exactly the heuristic class the seam exists to kill); the observation-refusal altitude split (one cause narrated once, not once per channel); availability-vs-priority on the dispatch control; family-once row grouping; routine-state collapse (open/ticket/idle lamps). Witnesses over this module assert per-claim semantics, never element order or adjacency — pinning the accidental composition would harden this renderer into the model."

// The row composition, on the declared archetype. The head line retains three derived tracks: status chip; node-mid title/meta flow; and one workflow-controls realization of ActuatorRegion carrying actions only (workflow_controls_actions_only_note). Activity — what is happening to the work — is the separate UnderHead ActivityRegion: the client creates it below this head when the decided /workflow.json view says an attempt exists, and removes it when the view says none, so the intrinsic-width third track can never again starve the title (the A2 falsifier). The li owns stable data-node identity independently of actuator presence; client observations locate the row first and only then its regions.
fn dependency_line_nodes(view: gunbc.roadmap_presentation.WorkRowView) -> List<std.markup.Fragment> {
  match scheduling_dependency_line(s: view.scheduling) {
    Present { value: line } => [ el_class("span", "dependencies", [ txt(line) ]) ]
    Absent => []
  }
}

data render_work_row_note: String = "The view-only row renderer (operator blocker 1, 2026-08-01): render_work_row and its helpers receive WorkRowView ALONE — no RoadmapNode, no RoadmapItem, no merged list, no frontier edges, no signoff or sizing constructors. Every fact they paint (status chip text, headline, superseded pointer, dependency line, dispatch action, supporting facts, disclosure body, activity region) arrives already decided by gunbc.roadmap_presentation; what remains here is serialization: markdown-inline expansion, class assembly, element nesting. The tree structure (children, depth fuel) stays outside the row renderer because parent/child is a graph fact about the PAGE, not a presentation fact about one row."

data server_activity_realization_note: String = "The SERVER realization of the activity region — the same semantic DOM the emitted client paints from the decided /workflow.json view (node-activity container with arm/attention data, one summary line via activity_summary_line, the obligation ledger and evidence rows behind the activity disclosure, the located reason on the refused arm; anomalous or refused opens the disclosure — the attention rule's server half). Two realizations, ONE deciding module; the parity witness holds their semantic regions and labels equal (operator blocker 7). A NoActiveWork view renders NOTHING, which is why a served page whose rows carry no observed attempt still ships zero workflow furniture."

fn activity_obligation_node(s: gunbc.roadmap_workflow_stage.WorkflowSegment) -> std.markup.Fragment {
  let state = workflow_segment_state_key(state: s.state)
  el_attrs("div", [
    attr(name: "class", value: activity_obligation_class ),
    attr(name: "data-state", value: state ),
  ], [ txt(join([
    workflow_segment_kind_label(kind: s.kind), activity_state_sep, state,
    if s.detail == "" { "" } else { join([activity_detail_sep, s.detail], "") },
  ], "")) ])
}

fn activity_evidence_row_node(row: gunbc.roadmap_presentation.ActivityEvidenceRow) -> std.markup.Fragment {
  el_class("div", activity_evidence_row_class, [ txt(join([row.label, activity_evidence_kv_sep, row.value], "")) ])
}

fn activity_detail_nodes(obligations: List<gunbc.roadmap_workflow_stage.WorkflowSegment>, evidence: List<gunbc.roadmap_presentation.ActivityEvidenceRow>, located_reason: String, open: Bool) -> std.markup.Fragment {
  el_attrs("details",
    concat(
      [ attr(name: "class", value: activity_detail_class ) ],
      if open { [ attr(name: "open", value: "" ) ] } else { [] }),
    [
      el("summary", [ txt(activity_disclosure_label) ]),
      el_class("div", activity_ledger_class, map(obligations, s => activity_obligation_node(s: s))),
      el_class("div", activity_evidence_class, concat(
        map(evidence, row => activity_evidence_row_node(row: row)),
        if located_reason == "" { [] } else {
          [ el_class("div", activity_located_reason_class, [ txt(located_reason) ]) ]
        })),
    ])
}

fn activity_container(a: gunbc.roadmap_presentation.ActivityView, attention: String, children: List<std.markup.Fragment>) -> std.markup.Fragment {
  el_attrs("div", concat(
    [
      attr(name: "class", value: node_activity_class ),
      attr(name: "data-arm", value: activity_arm_key(a: a) ),
    ],
    if attention == "" { [] } else { [ attr(name: "data-attention", value: attention ) ] }),
    concat([ el_class("span", activity_summary_class, [ txt(activity_summary_line(a: a)) ]) ], children))
}

fn activity_region_nodes(a: gunbc.roadmap_presentation.ActivityView) -> List<std.markup.Fragment> {
  match a {
    NoActiveWork => []
    ActivityUnobservable { reason: _ } => [ activity_container(a: a, attention: "", children: []) ]
    ActiveWork { summary: _, obligations, remaining_obligation_count: _, current_activity: _, attention, evidence } => {
      let key = activity_attention_key(a: attention)
      [ activity_container(a: a, attention: key, children: [
          activity_detail_nodes(obligations: obligations, evidence: evidence, located_reason: "", open: key == "anomalous"),
        ]) ]
    }
    ActiveWorkRefused { summary: _, located_reason, evidence } =>
      [ activity_container(a: a, attention: "", children: [
          activity_detail_nodes(obligations: [], evidence: evidence, located_reason: located_reason, open: true),
        ]) ]
    LegacySupersedableAttempt { summary: _, located_reason, attempt_key, evidence } =>
      [ activity_container(a: a, attention: "", children: [
          activity_detail_nodes(
            obligations: [],
            evidence: concat(
              evidence,
              [ gunbc.roadmap_presentation.ActivityEvidenceRow { label: "attempt key", value: attempt_key } ],
            ),
            located_reason: located_reason,
            open: true,
          ),
        ]) ]
    CompletedWork { outcome: _, evidence } =>
      [ activity_container(a: a, attention: "", children: [
          activity_detail_nodes(obligations: [], evidence: evidence, located_reason: "", open: false),
        ]) ]
  }
}

fn status_chip_nodes(view: gunbc.roadmap_presentation.WorkRowView) -> List<std.markup.Fragment> {
  if lifecycle_chip_renders(l: view.lifecycle) {
    let status = work_lifecycle_key(l: view.lifecycle)
    [ el_class("span", concat("status status-", status), [ txt(status) ]) ]
  } else {
    []
  }
}

fn render_work_row_head(view: gunbc.roadmap_presentation.WorkRowView) -> std.markup.Fragment {
  el_class("div", "node-head", concat(
    concat(
      status_chip_nodes(view: view),
      [ el_class("span", node_mid_class, concat(
          concat(
            [ el_class("span", "title", inline_md_nodes(text: view.headline)) ],
            superseded_badge_of(view: view),
          ),
          dependency_line_nodes(view: view))) ]),
    workflow_controls_nodes(view: view)))
}

fn render_work_row(view: gunbc.roadmap_presentation.WorkRowView) -> List<std.markup.Fragment> {
  concat(
    [ render_work_row_head(view: view) ],
    concat(activity_region_nodes(a: view.activity), view_detail_block(view: view)))
}

fn node_li_attributes(view: gunbc.roadmap_presentation.WorkRowView) -> List<std.markup.Attribute> {
  [
    attr(name: "class", value: concat("node node-", work_lifecycle_key(l: view.lifecycle))),
    attr(name: "data-node", value: view.node_id),
    attr(name: "tabindex", value: "0"),
  ]
}

fn node_work_row_view(rn: gunbc.roadmap_model.RoadmapNode, nodes: List<gunbc.roadmap_model.RoadmapNode>, edges: List<gunbc.roadmap_model.RoadmapEdge>, merged: List<Int>) -> gunbc.roadmap_presentation.WorkRowView {
  work_row_view(rn: rn, nodes: nodes, edges: edges, merged: merged, activity: NoActiveWork)
}

fn node_li(rn: gunbc.roadmap_model.RoadmapNode, nodes: List<gunbc.roadmap_model.RoadmapNode>, edges: List<gunbc.roadmap_model.RoadmapEdge>, merged: List<Int>, fuel: Int) -> std.markup.Fragment {
  let view = node_work_row_view(rn: rn, nodes: nodes, edges: edges, merged: merged)
  let head = render_work_row(view: view)
  let kids = gunbc.roadmap_page.children_of(nodes: nodes, edges: edges, parent: rn.node)
  let child_block = if count(kids) == 0 {
    []
  } else {
    if fuel > 0 {
      [ nodes_ul(items: kids, nodes: nodes, edges: edges, merged: merged, fuel: fuel - 1) ]
    } else {
      [ el_class("ul", "depth-limited", [
          el_class("li", "depth-limit", [
            txt(concat(concat("(", to_string(count(kids))), " nested node(s) hidden — depth limit)")),
          ]),
        ]) ]
    }
  }
  extdeps.browser.Element {
    tag: "li",
    attributes: node_li_attributes(view: view),
    children: concat(head, child_block),
  }
}

fn nodes_ul(items: List<gunbc.roadmap_model.RoadmapNode>, nodes: List<gunbc.roadmap_model.RoadmapNode>, edges: List<gunbc.roadmap_model.RoadmapEdge>, merged: List<Int>, fuel: Int) -> std.markup.Fragment {
  el("ul", map(items, rn => node_li(rn: rn, nodes: nodes, edges: edges, merged: merged, fuel: fuel)))
}

fn group_markup(g: gunbc.roadmap_model.SectionGroup, merged: List<Int>) -> List<std.markup.Fragment> {
  let tops = g.nodes |> filter(n => is_top_level(edges: g.edges, node: n.node))
  let ul = nodes_ul(items: tops, nodes: g.nodes, edges: g.edges, merged: merged, fuel: roadmap_page_max_depth())
  if g.label == "" {
    [ ul ]
  } else {
    [ el_class("h3", "group-label", [ txt(g.label) ]), ul ]
  }
}

fn element_markup(e: gunbc.roadmap_model.SectionElement, merged: List<Int>) -> List<std.markup.Fragment> {
  match e {
    Prose { prose } => [ el_class("p", "prose", markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: prose.content))) ]
    Group { group } => group_markup(g: group, merged: merged)
  }
}

// Page altitude from the attention law (composition slice 3; gunbc.roadmap_altitude carries the law, this page is its renderer — the workspace as the third renderer of 'routine collapses, anomaly expands'). A node-bearing section renders as a BAND: a details.section-fold whose summary carries the section's title and its derived counts, open exactly when the section holds non-routine work — statuses_all_routine folds the finished lanes, one working or anomalous member holds the band open, and the open attribute is DERIVED, never authored per section. A section without nodes has no altitude axis and renders flat, so prose leads never fold themselves away.
fn altitude_section(cls: String, title_nodes: List<std.markup.Fragment>, statuses: List<String>, body: List<std.markup.Fragment>) -> std.markup.Fragment {
  if count(statuses) == 0 {
    el_class("section", cls, concat(title_nodes, body))
  } else {
    let counts = el_class("span", "section-counts", [ txt(section_counts_wire(c: section_counts(statuses: statuses))) ])
    let band = el_class("summary", "section-band", concat(title_nodes, [ counts ]))
    let fold_attrs = if statuses_all_routine(statuses: statuses) {
      [ attr(name: "class", value: "section-fold" ) ]
    } else {
      [ attr(name: "class", value: "section-fold" ), attr(name: "open", value: "" ) ]
    }
    el_class("section", cls, [
      el_attrs("details", fold_attrs, concat([ band ], body)),
    ])
  }
}

fn group_statuses(g: gunbc.roadmap_model.SectionGroup, merged: List<Int>) -> List<String> {
  map(g.nodes, rn => node_lifecycle_key(rn: rn, merged: merged))
}

fn section_statuses(s: gunbc.roadmap_document.RoadmapSection, merged: List<Int>) -> List<String> {
  fold(s.elements, init: [], f: (acc, e) => match e {
    Prose { prose: _ } => acc
    Group { group } => concat(acc, group_statuses(g: group, merged: merged))
  })
}

fn section_markup(s: gunbc.roadmap_document.RoadmapSection, merged: List<Int>) -> std.markup.Fragment {
  let body = fold(s.elements, init: [], f: (acc, e) => concat(acc, element_markup(e: e, merged: merged)))
  altitude_section(
    cls: "roadmap-section",
    title_nodes: [ el("h2", [ txt(s.title) ]) ],
    statuses: section_statuses(s: s, merged: merged),
    body: body)
}

data daily_workspace_composition_note: String = "The workspace is rendered from ONE DailyWorkspaceView (operator blocker 6): active work bands ABOVE the ready queue and never folds itself away (a flat section — the attention rule says work in flight owns the operator's attention, so it gets no altitude fold to hide behind); the scheduling bands keep the frontier vocabulary and the altitude machinery. The workspace observation banner narrates a channel-level refusal ONCE, and rows the impact covers render without their per-row unobservable line (workspace_covers_row_activity — the row's typed state is unchanged, only the duplicate narration is suppressed). The program strip is the ProgramProgressView consumer: its ready-obligation count is the causal link between the program claim and the queue below it."

fn workspace_row_li(view: gunbc.roadmap_presentation.WorkRowView, observation: gunbc.roadmap_presentation.ObservationImpactView) -> std.markup.Fragment {
  let body = if workspace_covers_row_activity(observation: observation, a: view.activity) {
    concat([ render_work_row_head(view: view) ], view_detail_block(view: view))
  } else {
    render_work_row(view: view)
  }
  extdeps.browser.Element {
    tag: "li",
    attributes: node_li_attributes(view: view),
    children: body,
  }
}

fn workspace_rows_ul(rows: List<gunbc.roadmap_presentation.WorkRowView>, observation: gunbc.roadmap_presentation.ObservationImpactView) -> std.markup.Fragment {
  el("ul", map(rows, v => workspace_row_li(view: v, observation: observation)))
}

fn family_group_li(family: gunbc.roadmap_presentation.WorkFamilyView, observation: gunbc.roadmap_presentation.ObservationImpactView) -> std.markup.Fragment {
  el_class("li", "family-group", [
    el_class("div", "family-head", [
      el_class("span", "family-claim", [ txt(family.claim) ]),
      el_class("span", "family-count", [ txt(concat(to_string(count(family.rows)), " nodes")) ]),
    ]),
    el_class("ul", "family-rows", map(family.rows, v => workspace_row_li(view: v, observation: observation))),
  ])
}

fn band_entry_li(entry: gunbc.roadmap_presentation.WorkBandEntry, observation: gunbc.roadmap_presentation.ObservationImpactView) -> std.markup.Fragment {
  match entry {
    BandRow { row } => workspace_row_li(view: row, observation: observation)
    BandFamily { family } => family_group_li(family: family, observation: observation)
  }
}

fn band_entry_statuses(entry: gunbc.roadmap_presentation.WorkBandEntry) -> List<String> {
  match entry {
    BandRow { row } => [ work_lifecycle_key(l: row.lifecycle) ]
    BandFamily { family } => map(family.rows, v => work_lifecycle_key(l: v.lifecycle))
  }
}

fn workspace_entries_ul(entries: List<gunbc.roadmap_presentation.WorkBandEntry>, observation: gunbc.roadmap_presentation.ObservationImpactView) -> std.markup.Fragment {
  el("ul", map(entries, e => band_entry_li(entry: e, observation: observation)))
}

fn workspace_band(label: String, cls: String, entries: List<gunbc.roadmap_presentation.WorkBandEntry>, observation: gunbc.roadmap_presentation.ObservationImpactView) -> List<std.markup.Fragment> {
  if count(entries) == 0 && cls == "active" {
    []
  } else {
    [ altitude_section(
        cls: concat("frontier-bucket frontier-", cls),
        title_nodes: [ el("h2", [ txt(label) ]) ],
        statuses: fold(entries, init: [], f: (acc, e) => concat(acc, band_entry_statuses(entry: e))),
        body: [ workspace_entries_ul(entries: entries, observation: observation) ]) ]
  }
}

fn workspace_active_band(rows: List<gunbc.roadmap_presentation.WorkRowView>, observation: gunbc.roadmap_presentation.ObservationImpactView) -> List<std.markup.Fragment> {
  if count(rows) == 0 {
    []
  } else {
    [ el_class("section", "frontier-bucket frontier-active", [
        el("h2", [ txt("Active") ]),
        workspace_rows_ul(rows: rows, observation: observation),
      ]) ]
  }
}

fn workspace_observation_banner(observation: gunbc.roadmap_presentation.ObservationImpactView) -> List<std.markup.Fragment> {
  match observation {
    ObservationsNominal => []
    WorkspaceObservationImpact { summary, located_reason } =>
      [ el_class("section", "workspace-observation", [
          el_class("span", "workspace-observation-summary", [ txt(summary) ]),
          el_class("span", "workspace-observation-reason", [ txt(located_reason) ]),
        ]) ]
  }
}

fn workspace_markup(ws: gunbc.roadmap_presentation.DailyWorkspaceView) -> std.markup.Fragment {
  el_class("section", "roadmap-frontier", concat(
    workspace_active_band(rows: ws.active, observation: ws.observation),
    concat(workspace_band(label: "Ready", cls: "ready", entries: ws.ready, observation: ws.observation),
      concat(workspace_band(label: "Upcoming", cls: "upcoming", entries: ws.upcoming, observation: ws.observation),
        concat(workspace_band(label: "Done", cls: "done", entries: ws.done, observation: ws.observation),
          workspace_band(label: "Superseded", cls: "superseded", entries: ws.superseded, observation: ws.observation))))))
}

fn v1_exit_program_progress_view_for_accepted(accepted_ids: List<gunbc.roadmap_model.RoadmapNodeId>, ready_count: Int) -> gunbc.roadmap_presentation.ProgramProgressView {
  gunbc.roadmap_presentation.ProgramProgressView {
    name: "v1 exit",
    completed: v1_finish_lines_accepted_count(accepted: accepted_ids),
    total: count(v1_exit_finish_lines()),
    ready_obligation_count: ready_count,
  }
}

fn v1_exit_program_progress_view(ready_count: Int) -> gunbc.roadmap_presentation.ProgramProgressView {
  match accepted_roadmap_node_ids_projection() {
    AcceptedRoadmapNodeIdsProjectionRefused { detail: _ } =>
      gunbc.roadmap_presentation.ProgramProgressView {
        name: "v1 exit (acceptance carrier refused)",
        completed: 0,
        total: 0,
        ready_obligation_count: ready_count,
      }
    AcceptedRoadmapNodeIdsProjected { ids: accepted_ids } =>
      v1_exit_program_progress_view_for_accepted(accepted_ids: accepted_ids, ready_count: ready_count)
  }
}

fn program_progress_markup_of(v: gunbc.roadmap_presentation.ProgramProgressView) -> std.markup.Fragment {
  el_class("section", "program-progress", [
    el_class("span", "program-progress-name", [ txt(v.name) ]),
    el_class("span", "program-progress-count", [
      txt(join([
        to_string(v.completed), " of ", to_string(v.total), " finish lines complete",
        " · ", to_string(v.ready_obligation_count), " ready now",
      ], "")),
    ]),
  ])
}

fn daily_attempt_progress_for(node_id: String, attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress>) -> gunbc.roadmap_workflow_progress.WorkflowAttemptProgress? {
  fold(attempts, init: none, f: (acc, p) => match acc {
    Present { value: v } => Present { value: v }
    Absent => if p.node_id == node_id { Present { value: p } } else { none }
  })
}

fn daily_row_activity(node_id: String, attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress>, attempts_refused: String?) -> gunbc.roadmap_presentation.ActivityView {
  match attempts_refused {
    Present { value: reason } => gunbc.roadmap_presentation.ActivityUnobservable { reason: reason }
    Absent =>
      match daily_attempt_progress_for(node_id: node_id, attempts: attempts) {
        Present { value: p } => activity_view_from_progress(progress: p)
        Absent => NoActiveWork
      }
  }
}

// The live family facts: one WorkFamilyDecl for the closing-contract family (claim = the authority's closing_contract_family_claim, stated once) and one member fact per generator pair, each carrying the gated node's typed headline as the row subject. Fixtures construct their own decls/members, so the grouping stays witnessable without live counts.
fn closing_contract_family_id() -> String { "closing-contract" }

fn live_work_family_decls() -> List<gunbc.roadmap_presentation.WorkFamilyDecl> {
  [ gunbc.roadmap_presentation.WorkFamilyDecl { id: closing_contract_family_id(), claim: closing_contract_family_claim } ]
}

fn live_work_family_members_for_accepted(accepted: List<gunbc.roadmap_model.RoadmapNodeId>) -> List<gunbc.roadmap_presentation.WorkFamilyMemberFact> {
  closing_contract_task_pairs_for_accepted(accepted: accepted) |> map(p => gunbc.roadmap_presentation.WorkFamilyMemberFact {
    family_id: closing_contract_family_id(),
    task_node: p.task.node as String,
    subject: p.subject,
  })
}

fn daily_workspace_view_of_for_accepted(
  doc: gunbc.roadmap_document.RoadmapDocument,
  merged: List<Int>,
  accepted_ids: List<gunbc.roadmap_model.RoadmapNodeId>,
  attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress>,
  attempts_refused: String?,
) -> gunbc.roadmap_presentation.DailyWorkspaceView {
  let nodes = doc_all_nodes(doc: doc)
  let edges = doc_all_edges(doc: doc)
  let observation = observation_impact_view(workflow_refused: attempts_refused)
  let rows = map(nodes, rn => work_row_view(
    rn: rn, nodes: nodes, edges: edges, merged: merged,
    activity: daily_row_activity(node_id: rn.node as String, attempts: attempts, attempts_refused: attempts_refused)))
  let ready_count = count(rows |> filter(r =>
    !row_is_active_work(row: r) && work_scheduling_key(s: r.scheduling) == "ready"))
  daily_workspace_view(
    rows: rows,
    program: Present { value: v1_exit_program_progress_view_for_accepted(accepted_ids: accepted_ids, ready_count: ready_count) },
    observation: observation,
    families: live_work_family_decls(),
    members: live_work_family_members_for_accepted(accepted: accepted_ids))
}

fn daily_workspace_view_of(doc: gunbc.roadmap_document.RoadmapDocument, merged: List<Int>, attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress>, attempts_refused: String?) -> gunbc.roadmap_presentation.DailyWorkspaceView {
  match accepted_roadmap_node_ids_projection() {
    AcceptedRoadmapNodeIdsProjectionRefused { detail: _ } =>
      daily_workspace_view_of_for_accepted(
        doc: doc,
        merged: merged,
        accepted_ids: [],
        attempts: attempts,
        attempts_refused: attempts_refused,
      )
    AcceptedRoadmapNodeIdsProjected { ids: accepted_ids } =>
      daily_workspace_view_of_for_accepted(
        doc: doc,
        merged: merged,
        accepted_ids: accepted_ids,
        attempts: attempts,
        attempts_refused: attempts_refused,
      )
  }
}

fn roadmap_daily_workspace_page_impl_for_accepted(
  doc: gunbc.roadmap_document.RoadmapDocument,
  merged: List<Int>,
  accepted_ids: List<gunbc.roadmap_model.RoadmapNodeId>,
  main_prefix: List<std.markup.Fragment>,
  attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress>,
  attempts_refused: String?,
) -> std.markup.Fragment {
  let ws = daily_workspace_view_of_for_accepted(
    doc: doc,
    merged: merged,
    accepted_ids: accepted_ids,
    attempts: attempts,
    attempts_refused: attempts_refused,
  )
  let program_strip = match ws.program {
    Present { value: v } => [ program_progress_markup_of(v: v) ]
    Absent => []
  }
  extdeps.browser.Element {
    tag: "html",
    attributes: [ attr(name: "lang", value: "en" ) ],
    children: [
      el("head", [
        std.markup.Element { tag: "meta", attributes: [ attr(name: "charset", value: "utf-8" ) ], children: [] },
        std.markup.Element { tag: "meta", attributes: [ attr(name: "name", value: "viewport" ), attr(name: "content", value: "width=device-width, initial-scale=1" ) ], children: [] },
        el("style", [ txt(roadmap_css()) ]),
        el("title", [ txt("gunbc — daily workspace") ]),
      ]),
      el("body", [
        roadmap_header(page: "daily workspace"),
        el_class("main", "daily-workspace", concat(main_prefix, concat([fleet_hardware_standing_panel(), fleet_capacity_panel()], concat(program_strip, concat(
          workspace_observation_banner(observation: ws.observation),
          [ workspace_markup(ws: ws)]))))),
        dispatch_client_script(),
      ]),
    ],
  }
}

fn roadmap_daily_workspace_page_impl(doc: gunbc.roadmap_document.RoadmapDocument, merged: List<Int>, main_prefix: List<std.markup.Fragment>, attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress>, attempts_refused: String?) -> std.markup.Fragment {
  match accepted_roadmap_node_ids_projection() {
    AcceptedRoadmapNodeIdsProjectionRefused { detail: _ } =>
      roadmap_daily_workspace_page_impl_for_accepted(
        doc: doc,
        merged: merged,
        accepted_ids: [],
        main_prefix: main_prefix,
        attempts: attempts,
        attempts_refused: attempts_refused,
      )
    AcceptedRoadmapNodeIdsProjected { ids: accepted_ids } =>
      roadmap_daily_workspace_page_impl_for_accepted(
        doc: doc,
        merged: merged,
        accepted_ids: accepted_ids,
        main_prefix: main_prefix,
        attempts: attempts,
        attempts_refused: attempts_refused,
      )
  }
}

fn roadmap_page_impl(doc: gunbc.roadmap_document.RoadmapDocument, merged: List<Int>, main_prefix: List<std.markup.Fragment>) -> std.markup.Fragment {
  let lead = map(doc.lead_lanes, s => section_markup(s: s, merged: merged))
  let secs = map(doc.sections, s => section_markup(s: s, merged: merged))
  let main_children = concat(main_prefix, concat(lead, secs))
  let body_base = [
    roadmap_header(page: "roadmap"),
    el_class("main", "roadmap", main_children),
  ]
  let body_children = if list_length(main_children) == 0 {
    body_base
  } else {
    concat(body_base, [ dispatch_client_script() ])
  }
  extdeps.browser.Element {
    tag: "html",
    attributes: [ attr(name: "lang", value: "en" ) ],
    children: [
      el("head", [
        std.markup.Element { tag: "meta", attributes: [ attr(name: "charset", value: "utf-8" ) ], children: [] },
        std.markup.Element { tag: "meta", attributes: [ attr(name: "name", value: "viewport" ), attr(name: "content", value: "width=device-width, initial-scale=1" ) ], children: [] },
        el("style", [ txt(roadmap_css()) ]),
        el("title", [ txt("gunbc — roadmap") ]),
      ]),
      el("body", body_children),
    ],
  }
}

fn roadmap_page(doc: gunbc.roadmap_document.RoadmapDocument, merged: List<Int>) -> std.markup.Fragment {
  roadmap_page_impl(doc: doc, merged: merged, main_prefix: [])
}

data roadmap_page_focus_parameter_note: String = "roadmap_page_for_doc exists so a claim about how a TICKET ROW renders can be written without a claim about which lanes are currently shown. witness_ticket_rows_render_structured asserts the row markup — disclosure mark, brief class, displaced-cost label, carrier href — and it happened to pick a node from a lane the focus later hid, so it went red having found nothing wrong with the rendering at all. Passing an unfocused document keeps that claim measuring markup. roadmap_page_for_authority keeps the declared focus, because the served page IS the focused view."

fn roadmap_page_for_doc(doc: gunbc.roadmap_document.RoadmapDocument) -> std.markup.Fragment {
  roadmap_page_impl(
    doc: doc,
    merged: authored_merged_prs(),
    main_prefix: [
      dashboard_instance_banner(),
      finish_line_progress_markup(),
    ],
  )
}

fn roadmap_authority_refusal_markup(detail: String) -> std.markup.Fragment {
  el_class("section", "roadmap-authority-refused", [
    el("h2", [ txt("roadmap unavailable") ]),
    el_class("p", "roadmap-authority-refused-detail", [
      txt(concat("acceptance history projection refused: ", detail)),
    ]),
  ])
}

fn roadmap_page_for_authority() -> std.markup.Fragment {
  roadmap_page_for_projection(proj: roadmap_authority_projection())
}

fn roadmap_page_for_projection(proj: gunbc.roadmap_authority.RoadmapAuthorityProjection) -> std.markup.Fragment {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      roadmap_page_impl(
        doc: gunbc.roadmap_document.RoadmapDocument { preamble: [], lead_lanes: [], sections: [] },
        merged: [],
        main_prefix: [
          dashboard_instance_banner(),
          roadmap_authority_refusal_markup(detail: detail),
        ],
      )
    RoadmapAuthorityProjected { doc: doc, accepted: accepted } =>
      roadmap_page_impl(
        doc: doc,
        merged: authored_merged_prs(),
        main_prefix: [
          dashboard_instance_banner(),
          finish_line_progress_markup_for_accepted(accepted_ids: accepted),
        ],
      )
  }
}

fn roadmap_daily_workspace_page(doc: gunbc.roadmap_document.RoadmapDocument, merged: List<Int>) -> std.markup.Fragment {
  roadmap_daily_workspace_page_impl(doc: doc, merged: merged, main_prefix: [], attempts: [], attempts_refused: none)
}

// The served daily workspace consumes the OBSERVED attempt evidence at render (the serve handler decomposes the belt observation and passes progress rows or the located refusal), so the active band and every server-rendered activity region are real facts, not placeholders — the same decided views the /workflow.json wire carries, giving the client poll an identical starting DOM (the parity obligation's server half). The zero-argument form stays pure (empty attempts, nominal observation) for witnesses that assert composition without observation.
fn roadmap_daily_workspace_page_for_authority_observed(attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress>, attempts_refused: String?) -> std.markup.Fragment {
  roadmap_daily_workspace_page_for_projection_observed(
    proj: roadmap_authority_projection(),
    attempts: attempts,
    attempts_refused: attempts_refused,
  )
}

fn roadmap_daily_workspace_page_for_projection_observed(
  proj: gunbc.roadmap_authority.RoadmapAuthorityProjection,
  attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress>,
  attempts_refused: String?,
) -> std.markup.Fragment {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      roadmap_daily_workspace_page_impl(
        doc: gunbc.roadmap_document.RoadmapDocument { preamble: [], lead_lanes: [], sections: [] },
        merged: [],
        main_prefix: [
          dashboard_instance_banner(),
          roadmap_authority_refusal_markup(detail: detail),
        ],
        attempts: attempts,
        attempts_refused: attempts_refused,
      )
    RoadmapAuthorityProjected { doc: doc, accepted: accepted } =>
      roadmap_daily_workspace_page_impl_for_accepted(
        doc: doc,
        merged: authored_merged_prs(),
        accepted_ids: accepted,
        main_prefix: [
          dashboard_instance_banner(),
        ],
        attempts: attempts,
        attempts_refused: attempts_refused,
      )
  }
}

fn roadmap_daily_workspace_page_for_authority() -> std.markup.Fragment {
  roadmap_daily_workspace_page_for_projection(proj: roadmap_authority_projection())
}

fn roadmap_daily_workspace_page_for_projection(proj: gunbc.roadmap_authority.RoadmapAuthorityProjection) -> std.markup.Fragment {
  roadmap_daily_workspace_page_for_projection_observed(
    proj: proj,
    attempts: [],
    attempts_refused: none,
  )
}
