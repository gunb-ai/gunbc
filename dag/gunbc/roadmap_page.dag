fn roadmap_page_max_depth() -> Int { 12 }

data finish_line_placement_note: String = "The finish-line block is REFERENCE prose, not operational attention (A1 of the presentation recon, operator-signed 2026-08-01): the daily workspace's declared archetype is Operational (gunbc.design.archetype dashboard_archetype), so / leads with the frontier and carries only the one-line program_progress_compact_markup; the four claims render on /roadmap, where the strategic argument lives. The 2026-07-28 stylesheet-debt scaffold that shipped this section unstyled dissolved in the same pass: the gate/brick rules are deleted, .finish-line-* rules exist on the tokened grain, and roadmap_css_lift_parity_digest was re-pinned by execution (see the A1 re-pin note in test.claim.design_register_lift_parity_witness). The count line under the heading is the LOCAL denominator — accepted finish lines over the four — never the global roadmap population, which belonged to a different question (review: the section visually implied a denominator of four while reporting an unrelated global one)."

fn finish_line_state_class(accepted: Bool) -> String {
  if accepted { "accepted" } else { "active" }
}

fn finish_line_row(spec: V1FinishLineSpec, accepted_ids: List<RoadmapNodeId>) -> Fragment {
  let accepted = v1_finish_line_accepted(spec: spec, accepted: accepted_ids)
  el_class("li", concat("finish-line finish-line-", finish_line_state_class(accepted: accepted)), [
    el_class("span", "finish-line-state", [ txt(finish_line_state_class(accepted: accepted)) ]),
    el_class("span", "finish-line-name", [ txt(spec.name) ]),
    el_class("span", "finish-line-node", [ txt(spec.node as String) ]),
    el_class("span", "finish-line-claim", [ txt(spec.claim) ]),
  ])
}

fn finish_line_local_count_label(accepted_ids: List<RoadmapNodeId>) -> String {
  join([
    to_string(v1_finish_lines_accepted_count(accepted: accepted_ids)),
    " of ",
    to_string(count(v1_exit_finish_lines())),
    " complete",
  ], "")
}

fn finish_line_progress_markup() -> Fragment {
  let accepted_ids = accepted_roadmap_node_ids()
  el_class("section", "finish-line-progress", [
    el("h2", [ txt("v1 exit: four finish lines") ]),
    el_class("p", "finish-line-counts", [ txt(finish_line_local_count_label(accepted_ids: accepted_ids)) ]),
    el_class("ul", "finish-lines",
      map(v1_exit_finish_lines(), s => finish_line_row(spec: s, accepted_ids: accepted_ids))),
  ])
}

fn program_progress_compact_markup() -> Fragment {
  let accepted_ids = accepted_roadmap_node_ids()
  el_class("section", "program-progress", [
    el_class("span", "program-progress-name", [ txt("v1 exit") ]),
    el_class("span", "program-progress-count", [
      txt(join([
        to_string(v1_finish_lines_accepted_count(accepted: accepted_ids)),
        " of ",
        to_string(count(v1_exit_finish_lines())),
        " finish lines complete",
      ], "")),
    ]),
  ])
}

fn dashboard_instance_banner() -> Fragment {
  el_class("section", dashboard_instance_class, [
    el_class("span", dashboard_instance_label_class, [
      txt("instance · observing"),
    ]),
  ])
}


data sound_toggle_placement_note: String = "The mute lives in the HEADER, pushed to the far edge by margin-left auto, because it is a property of the whole surface rather than of any row — a per-row mute would be a second control on every line, which is exactly what the exemplar's scope forbids. The former empty-label rendering was corrected at A1 (presentation recon, 2026-08-01): honest-before-JS does not require blankness — a blank button has no visible content and no accessible name, which is a defect, not honesty. The TWO TOGGLES SHIP DIFFERENT AMOUNTS OF STATE, and the asymmetry is the honesty boundary, not an inconsistency (A1 reconciliation, operator feedback 2026-08-01): the theme control ships 'theme · auto' because at parse time the document carries no data-theme and prefers-color-scheme governs — which is the DEFINITION of auto, true for every visitor until the client program applies a stored choice; the sound control ships only its NAME because its state has no parse-time truth — the preference lives in this browser's storage (unreadable at serve), and for a no-JS visitor no sound ever plays, so any shipped state word would be a fabricated claim for someone. The client program repaints both from storage on load, exactly as before."

fn sound_toggle_control() -> Fragment {
  el_attrs("button", [
    attr(name: "class", value: sound_toggle_class ),
    attr(name: "type", value: "button" ),
  ], [ txt("sound") ])
}

fn theme_toggle_control() -> Fragment {
  el_attrs("button", [
    attr(name: "class", value: theme_toggle_class ),
    attr(name: "type", value: "button" ),
  ], [ txt(join([theme_toggle_label_prefix, theme_toggle_auto_value], "")) ])
}

data roadmap_wordmark_note: String = "A1 header decision (presentation recon, operator-signed 2026-08-01): the header carries a TEXT wordmark, not the site mark. The mark that stood here was gunbc.site.mark candidate A ('Confluence') — an explicitly unselected brand experiment (DESIGN's site thread still owes candidates B–D) whose aria-label said 'gunb.ai mark' on a gunbc operational tool: a public-site brand artifact leaking into a tool surface. The minimal correct move is the wordmark; a drawn mark returns if and when an actual brand-selection task runs (the sandbox auditioner is the venue, the swatch-graduation precedent). The h1 carries the PAGE name alone — the product name lives in the wordmark, so the two never restate each other."

fn roadmap_header(page: String) -> Fragment {
  el("header", [
    el_class("span", "wordmark", [ txt("gunbc") ]),
    el("h1", [ txt(page) ]),
    sound_toggle_control(),
    theme_toggle_control(),
  ])
}

fn node_status_symbol(rn: RoadmapNode, merged: List<Int>) -> String {
  if item_superseded_by(item: rn.line) == "" {
    if signoff_accepts(s: rn.signoff) {
      "done"
    } else {
      if item_is_done(item: rn.line, merged: merged) {
        "review"
      } else {
        "open"
      }
    }
  } else {
    "superseded"
  }
}

fn intricacy_label(i: Intricacy) -> String {
  match i {
    IntricacyLow => "i:low"
    IntricacyMedium => "i:med"
    IntricacyHigh => "i:high"
  }
}

fn volume_label(v: Volume) -> String {
  match v {
    VolumeSmall => "v:small"
    VolumeMedium => "v:med"
    VolumeLarge => "v:large"
  }
}

fn sizing_label(s: NodeSizing) -> String {
  match s {
    Unsized => ""
    Sized { intricacy, volume, repo, acceptance } =>
      join([intricacy_label(i: intricacy), " ", volume_label(v: volume), " ", repo], "")
  }
}

fn line_title(line: RoadmapItem) -> String {
  match line {
    DerivableLine { prs, title, description } => title
    AuthoredLine { done, content } => content
    PlainLine { content } => content
    SupersededLine { by: _, content } => content
    TicketLine { done: _, ticket } => join(["**", ticket.headline, "** — ", ticket.brief], "")
  }
}

fn title_nodes(line: RoadmapItem) -> List<Fragment> {
  markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: line_title(line: line)))
}

fn line_lead(line: RoadmapItem) -> String {
  let full = line_title(line: line)
  let dash_parts = split(s: full, delimiter: " — ")
  if count(dash_parts) > 1 {
    first(dash_parts).value
  } else {
    let dot_parts = split(s: full, delimiter: ". ")
    if count(dot_parts) > 1 { first(dot_parts).value } else { full }
  }
}

fn lead_nodes(line: RoadmapItem) -> List<Fragment> {
  markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: line_lead(line: line)))
}

data roadmap_lead_budget_note: String = "The lead is the row's at-a-glance face: everything before the first ' — ' (falling back to the first '. ', then the whole title). A row whose LEAD is itself paragraph-length defeats the disclosure — the brief stays collapsed but the summary line does not, so the reader pays the full text anyway. The bound is authoring residue, not a structural class: no construction forbids a long sentence, so this is the §5-sanctioned lens over the genuinely unstructurable part, and it is typed/located/counted (node id + measured length) rather than a bare Bool, so a red says WHICH row and by how much. 300 chars is the operator's declared bound (roadmap-workspace-ux-plan.md P1b); an offender is re-cut by moving its summary delimiter earlier or splitting its content, while the body remains available behind the disclosure."

fn roadmap_lead_budget_chars() -> Int { 300 }

type LeadBudgetViolation {
  node: String
  lead_chars: Int
}

fn lead_budget_violations(nodes: List<RoadmapNode>) -> List<LeadBudgetViolation> {
  fold(nodes, init: [], f: (acc, rn) => {
    let n = line_lead(line: rn.line).length()
    if n > roadmap_lead_budget_chars() {
      concat(acc, [LeadBudgetViolation { node: rn.node as String, lead_chars: n }])
    } else {
      acc
    }
  })
}

fn roadmap_authority_lead_budget_violations() -> List<LeadBudgetViolation> {
  lead_budget_violations(nodes: doc_all_nodes(doc: roadmap_authority()))
}

data ticket_brief_budget_note: String = "The brief bound (operator's ticket model: a brief is ~100 words or less, read daily). Same shape as the lead budget: authoring residue no construction can forbid, so a typed located counted census — a red carries the node id and the measured count, never a bare Bool. Words, not characters, because the operator priced it in reading, and a word is the unit reading is priced in."

data ticket_brief_word_budget: Int = 100

type BriefBudgetViolation {
  node: RoadmapNodeId
  words: Int
}

fn ticket_brief_word_count(brief: String) -> Int {
  count(split(s: brief, delimiter: " "))
}

fn ticket_brief_violations(nodes: List<RoadmapNode>) -> List<BriefBudgetViolation> {
  fold(nodes, init: [], f: (acc, rn) => match line_ticket(item: rn.line) {
    Absent => acc
    Present { value: t } => {
      let words = ticket_brief_word_count(brief: t.brief)
      if words > ticket_brief_word_budget {
        concat(acc, [BriefBudgetViolation { node: rn.node, words: words }])
      } else {
        acc
      }
    }
  })
}

fn roadmap_ticket_brief_violations() -> List<BriefBudgetViolation> {
  ticket_brief_violations(nodes: doc_all_nodes(doc: roadmap_authority()))
}

fn inline_md_nodes(text: String) -> List<Fragment> {
  markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: text))
}

fn ticket_field_row(label: String, value: String) -> List<Fragment> {
  if value == "" {
    []
  } else {
    [ el_class("div", "ticket-field", concat(
        [ el_class("span", "ticket-field-label", [ txt(label) ]) ],
        [ el_class("span", "ticket-field-value", inline_md_nodes(text: value)) ])) ]
  }
}

fn ticket_update_row(u: TicketUpdate) -> Fragment {
  el_class("div", "ticket-update", concat(
    [ el_class("span", "ticket-update-date", [ txt(u.on) ]) ],
    [ el_class("span", "ticket-update-note", inline_md_nodes(text: u.note)) ]))
}

fn ticket_updates_block(updates: List<TicketUpdate>) -> List<Fragment> {
  if count(updates) == 0 {
    []
  } else {
    [ el_class("div", "ticket-updates", concat(
        [ el_class("div", "ticket-updates-head", [ txt("updates") ]) ],
        map(updates, u => ticket_update_row(u: u)))) ]
  }
}

fn ticket_body_nodes(t: TicketFields, carriers: List<Pointer>) -> List<Fragment> {
  concat(
    [ el_class("p", "ticket-brief", inline_md_nodes(text: t.brief)) ],
    concat(
      concat(ticket_field_row(label: "displaced cost", value: t.displaced_cost),
        concat(ticket_field_row(label: "current state", value: t.current_state),
          concat(ticket_field_row(label: "first slice", value: t.first_slice),
            concat(ticket_field_row(label: "red control", value: t.red_control),
              concat(ticket_field_row(label: "out of scope", value: t.out_of_scope),
                ticket_field_row(label: "hand-back", value: t.handback)))))),
      concat(
        ticket_field_row(label: "verified", value: join([t.authored_on, " · last verified ", t.last_verified_on], "")),
        ticket_updates_block(updates: t.updates))))
}

fn item_body_nodes(rn: RoadmapNode) -> List<Fragment> {
  match line_ticket(item: rn.line) {
    Present { value: t } => ticket_body_nodes(t: t, carriers: rn.carriers)
    Absent => title_nodes(line: rn.line)
  }
}

fn item_is_ticket(rn: RoadmapNode) -> Bool {
  match line_ticket(item: rn.line) {
    Present { value: _ } => true
    Absent => false
  }
}

data item_facts_disclosure_note: String = "Supporting facts live in the disclosure, not the head row (A1 of the presentation recon, operator-signed 2026-08-01): the head line had grown to ~7 simultaneous inline facts — owner, sizing codes, carrier links, dependencies — wrapping arbitrarily under the title, which is the half-console-half-product voice fork the recon named. The head now carries the row's PRIMARY facts only (status, title, state badges, the dependency line that explains why an upcoming row waits) plus the actuator; owner/sizing/carriers are supporting facts behind the same disclosure that already held the body. A row with supporting facts but no body still discloses (summary label 'facts'), so no fact is dropped — only demoted. The proper display-role model (PrimaryFact/SupportingFact/EvidenceFact) is A2's presentation seam; this is the damage-removal cut of it."

fn item_supporting_facts(rn: RoadmapNode) -> List<Fragment> {
  let facts = concat(owner_badge(rn: rn), concat(sizing_badge(rn: rn), carrier_links(carriers: rn.carriers)))
  if count(facts) == 0 {
    []
  } else {
    [ el_class("div", "item-facts", facts) ]
  }
}

fn item_detail_block(rn: RoadmapNode) -> List<Fragment> {
  let facts = item_supporting_facts(rn: rn)
  let has_body = !(line_lead(line: rn.line) == line_title(line: rn.line))
  if count(facts) == 0 && !has_body {
    []
  } else {
    let is_ticket = item_is_ticket(rn: rn)
    let body = if has_body { item_body_nodes(rn: rn) } else { [] }
    let label = if is_ticket { "ticket" } else { if has_body { "brief" } else { "facts" } }
    [ el_attrs("details", [
        attr(name: "class", value: if is_ticket { "item-detail ticket-row" } else { "item-detail" } ),
      ], [
        el("summary", [
          el_class("span", disclosure_mark_class, [ txt(disclosure_mark_glyph) ]),
          txt(label),
        ]),
        el_class("div", "item-body", concat(facts, body)),
      ]) ]
  }
}

data github_blob_base_note: String = "The per-surface link projection (remodel W2, census row 7): a Pointer's path is a REPO path — correct in GitHub's renderer, dead on the served page by construction (no /docs route). The served surface projects repo paths through the GitHub blob base so every carrier link answers; when repo paths gain a served route (the storage-blind lane, W3 neighborhood), this base swaps for that route in ONE place. The prose-inline [label](docs/...) links inside legacy AuthoredLine blobs remain relative — a named residue that dies with the blobs themselves (W2-bulk)."

data github_blob_base: String = "https://github.com/gunb-ai/gunbc/blob/main/"

fn pointer_link(p: Pointer) -> Fragment {
  Element {
    tag: "a",
    attributes: [ attr(name: "href", value: join([github_blob_base, p.path], "") ) ],
    children: [ txt(p.label) ],
  }
}

fn carrier_links(carriers: List<Pointer>) -> List<Fragment> {
  map(carriers, p => pointer_link(p: p))
}

fn children_of(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, parent: RoadmapNodeId) -> List<RoadmapNode> {
  nodes |> filter(n => match roadmap_primary_parent(edges: edges, node: n.node) {
    UnderParent { parent: p } => p == parent
    TopLevel => false
  })
}

fn owner_badge(rn: RoadmapNode) -> List<Fragment> {
  if rn.owner == "" {
    []
  } else {
    [ el_class("span", "owner", [ txt(concat("@", rn.owner)) ]) ]
  }
}

fn sizing_badge(rn: RoadmapNode) -> List<Fragment> {
  let label = sizing_label(s: rn.sizing)
  if label == "" {
    []
  } else {
    [ el_class("span", "sizing", [ txt(label) ]) ]
  }
}

data dispatch_button_note: String = "The launch button (operator 2026-07-20: manual click-to-dispatch). Rendered on every open or review node; only signoff-Done and authored Superseded rows hide it. This deliberately preserves manual out-of-order dispatch for blocked and unsized rows: spawn_frontier.ready governs automatic belt reconciliation and page grouping, not the manual POST admission contract. belt_dispatch_node currently refuses signoff-Done but does not consult Ready, so the page must not claim otherwise. The button carries data-node = the node id. Its client behavior is a MODELED TsProgram (gunbc.roadmap_component.dispatch_client_program), emitted as an EXTERNAL served asset (roadmap_dispatch_asset_path, served by belt B) and referenced by <script src> -- NOT a hand-concatenated JS string inlined into the HTML (the former was the dispatch-button incident's root class, §5, and the inline placement was a hack: an inline <script> text node escapes '>' under std.markup, corrupting an arrow's `=>`; external emission is escape-clean). It reads belt B's `status` contract with the ok-set DERIVED from belt_dispatch_ok_status_labels; the retired belt-A `ok`/`node` shape is gone and cannot return (the page witness holds a RED on `j.ok`)."

fn superseded_badge(rn: RoadmapNode) -> List<Fragment> {
  let by = item_superseded_by(item: rn.line)
  if by == "" {
    []
  } else {
    [ el_class("span", "superseded-by", [ txt(concat("→ ", by)) ]) ]
  }
}

fn dispatch_button_nodes(rn: RoadmapNode, dispatchable: Bool) -> List<Fragment> {
  if dispatchable {
    [ el_attrs("button", [
        attr(name: "class", value: "dispatch-btn" ),
        attr(name: "type", value: "button" ),
        attr(name: "data-node", value: rn.node as String ),
      ], [ txt("dispatch") ]) ]
  } else {
    []
  }
}

fn node_exposes_manual_dispatch(rn: RoadmapNode, merged: List<Int>) -> Bool {
  let status = node_status_symbol(rn: rn, merged: merged)
  !(status == "done" || status == "superseded")
}

fn workflow_lamp_node(lamp: WorkflowLamp) -> Fragment {
  let key = workflow_lamp_key(lamp: lamp)
  let label = workflow_lamp_label(lamp: lamp)
  let observation = client_observation_state_key(
    state: workflow_lamp_initial_state(lamp: lamp))
  el_attrs("span", [
    attr(name: "class", value: workflow_lamp_class),
    attr(name: workflow_lamp_data_attribute, value: key),
    attr(name: workflow_observation_data_attribute, value: observation),
    attr(name: workflow_lamp_label_data_attribute, value: label),
    attr(name: "role", value: "status"),
    attr(name: "aria-label", value: join([label, ": ", observation], "")),
  ], [
    el_class("span", workflow_lamp_indicator_class, []),
    el_class("span", workflow_lamp_label_class, [ txt(label) ]),
  ])
}

fn workflow_strip_node() -> Fragment {
  el_attrs("span", [
    attr(name: "class", value: workflow_strip_class),
    attr(name: "role", value: "group"),
    attr(name: "aria-label", value: "workflow observations"),
  ], map(workflow_lamps_v0, lamp => workflow_lamp_node(lamp: lamp)))
}

fn workflow_progress_stage_node(stage: WorkflowSegmentKind) -> Fragment {
  let key = workflow_progress_stage_key(stage: stage)
  let label = workflow_progress_stage_label(stage: stage)
  el_attrs("span", [
    attr(name: "class", value: workflow_stage_class),
    attr(name: workflow_stage_data_attribute, value: key),
    attr(name: workflow_segment_state_data_attribute, value: "pending"),
    attr(name: "role", value: "status"),
    attr(name: "aria-label", value: join([label, ": pending"], "")),
  ], [txt(label)])
}

fn workflow_progress_node() -> Fragment {
  el_attrs("span", [
    attr(name: "class", value: workflow_progress_class),
    attr(name: "hidden", value: ""),
    attr(name: "role", value: "group"),
    attr(name: "aria-label", value: "attempt workflow"),
  ], concat(
    map(
      workflow_progress_stages,
      stage => workflow_progress_stage_node(stage: stage),
    ),
    [el_class("span", workflow_activity_class, [txt("waiting")])],
  ))
}

fn workflow_controls_nodes(rn: RoadmapNode, dispatchable: Bool) -> List<Fragment> {
  [ el_class("div", workflow_controls_class, concat(
      [ workflow_progress_node(), workflow_strip_node() ],
      dispatch_button_nodes(rn: rn, dispatchable: dispatchable))) ]
}

fn dispatch_client_script() -> Fragment {
  Element {
    tag: "script",
    attributes: [
      attr(name: "src", value: roadmap_dispatch_asset_path ),
      attr(name: "defer", value: "" ),
    ],
    children: [],
  }
}

data page_script_census_note: String = "The served-page script wall (P1): every script the page carries must be MODELED, not a hand-authored string. The page emits its dispatch behavior as an external <script src> pointing at roadmap_dispatch_asset_path (whose body IS serialize_typescript_program of a modeled TsProgram, served by belt B). So the census walks the page tree and refuses two shapes fail-closed: an inline <script> with a non-empty text node (a hand JS string, the dispatch-button incident's class) and a <script src> pointing anywhere but a known modeled asset. Green over the real page; the RED controls (a resurrected inline string script; a rogue src) each locate their violation. Mirror of the unthemed-color / untokened-length censuses: a pure reader over the same Fragment tree, no new substrate."

type PageScriptViolation {
  kind: String
  detail: String
}

fn script_inline_text(children: List<Fragment>) -> String {
  fold(children, init: "", f: (acc, c) => match c {
    FragmentText { content } => concat(acc, content)
    RawNode { content } => concat(acc, content)
    Element { tag: _, attributes: _, children: _ } => acc
  })
}

fn script_src_attr(attributes: List<Attribute>) -> String {
  fold(attributes, init: "", f: (acc, a) => if a.name == "src" { a.value } else { acc })
}

fn collect_script_violations(node: Fragment, known_src: String) -> List<PageScriptViolation> {
  match node {
    FragmentText { content: _ } => []
    RawNode { content: _ } => []
    Element { tag, attributes, children } =>
      if tag == "script" {
        let inline = script_inline_text(children: children)
        let src = script_src_attr(attributes: attributes)
        concat(
          if inline == "" { [] } else { [PageScriptViolation { kind: "inline-js", detail: inline }] },
          if src == "" || src == known_src { [] } else { [PageScriptViolation { kind: "unknown-src", detail: src }] },
        )
      } else {
        fold(children, init: [], f: (acc, c) => concat(acc, collect_script_violations(node: c, known_src: known_src)))
      }
  }
}

fn page_script_census(page: Fragment) -> List<PageScriptViolation> {
  collect_script_violations(node: page, known_src: roadmap_dispatch_asset_path)
}

data node_head_row_note: String = "The row composition, on the declared archetype. The head line retains three derived tracks: status chip; node-mid title/meta flow; and one workflow-controls realization of ActuatorRegion. That final wrapper is always present, carrying the workflow observation strip plus the optional dispatch button, so done/superseded rows remain observable and dynamic process evidence plus stop/clear/unavailable cleanup stay inside the existing grid cell. The li owns stable data-node identity independently of actuator presence; client observations locate the row first and only then its lamp or optional control."

fn dependency_badge(rn: RoadmapNode, edges: List<RoadmapEdge>) -> List<Fragment> {
  let parents = roadmap_parent_ids(edges: edges, node: rn.node)
  if count(parents) > 1 {
    [
      el_class(
        "span",
        "dependencies",
        [ txt(concat("requires all: ", join(map(parents, p => p as String), ", "))) ]),
    ]
  } else {
    []
  }
}

fn node_head_row(rn: RoadmapNode, edges: List<RoadmapEdge>, merged: List<Int>, dispatchable: Bool) -> Fragment {
  let status = node_status_symbol(rn: rn, merged: merged)
  el_class("div", "node-head", concat(
    [
      el_class("span", concat("status status-", status), [ txt(status) ]),
      el_class("span", node_mid_class, concat(
        concat(
          [ el_class("span", "title", lead_nodes(line: rn.line)) ],
          superseded_badge(rn: rn),
        ),
        dependency_badge(rn: rn, edges: edges))),
    ],
    workflow_controls_nodes(rn: rn, dispatchable: dispatchable)))
}

fn node_li_attributes(rn: RoadmapNode, status: String) -> List<Attribute> {
  [
    attr(name: "class", value: concat("node node-", status)),
    attr(name: "data-node", value: rn.node as String),
  ]
}

fn node_li(rn: RoadmapNode, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, fuel: Int) -> Fragment {
  let status = node_status_symbol(rn: rn, merged: merged)
  let dispatchable = node_exposes_manual_dispatch(rn: rn, merged: merged)
  let head = concat(
    [ node_head_row(rn: rn, edges: edges, merged: merged, dispatchable: dispatchable) ],
    item_detail_block(rn: rn),
  )
  let kids = children_of(nodes: nodes, edges: edges, parent: rn.node)
  let child_block = if count(kids) == 0 {
    []
  } else {
    if fuel > 0 {
      [ nodes_ul(items: kids, nodes: nodes, edges: edges, merged: merged, fuel: fuel - 1) ]
    } else {
      [ el_class("ul", "depth-limited", [
          el_class("li", "depth-limit", [
            txt(concat(concat("(", to_string(count(kids))), " nested node(s) hidden — depth limit)")),
          ]),
        ]) ]
    }
  }
  Element {
    tag: "li",
    attributes: node_li_attributes(rn: rn, status: status),
    children: concat(head, child_block),
  }
}

fn nodes_ul(items: List<RoadmapNode>, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, fuel: Int) -> Fragment {
  el("ul", map(items, rn => node_li(rn: rn, nodes: nodes, edges: edges, merged: merged, fuel: fuel)))
}

fn group_markup(g: SectionGroup, merged: List<Int>) -> List<Fragment> {
  let tops = g.nodes |> filter(n => is_top_level(edges: g.edges, node: n.node))
  let ul = nodes_ul(items: tops, nodes: g.nodes, edges: g.edges, merged: merged, fuel: roadmap_page_max_depth())
  if g.label == "" {
    [ ul ]
  } else {
    [ el_class("h3", "group-label", [ txt(g.label) ]), ul ]
  }
}

fn element_markup(e: SectionElement, merged: List<Int>) -> List<Fragment> {
  match e {
    Prose { prose } => [ el_class("p", "prose", markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: prose.content))) ]
    Group { group } => group_markup(g: group, merged: merged)
  }
}

data altitude_section_note: String = "Page altitude from the attention law (composition slice 3; gunbc.roadmap_altitude carries the law, this page is its renderer — the workspace as the third renderer of 'routine collapses, anomaly expands'). A node-bearing section renders as a BAND: a details.section-fold whose summary carries the section's title and its derived counts, open exactly when the section holds non-routine work — statuses_all_routine folds the finished lanes, one working or anomalous member holds the band open, and the open attribute is DERIVED, never authored per section. A section without nodes has no altitude axis and renders flat, so prose leads never fold themselves away."

fn altitude_section(cls: String, title_nodes: List<Fragment>, statuses: List<String>, body: List<Fragment>) -> Fragment {
  if count(statuses) == 0 {
    el_class("section", cls, concat(title_nodes, body))
  } else {
    let counts = el_class("span", "section-counts", [ txt(section_counts_wire(c: section_counts(statuses: statuses))) ])
    let band = el_class("summary", "section-band", concat(title_nodes, [ counts ]))
    let fold_attrs = if statuses_all_routine(statuses: statuses) {
      [ attr(name: "class", value: "section-fold" ) ]
    } else {
      [ attr(name: "class", value: "section-fold" ), attr(name: "open", value: "" ) ]
    }
    el_class("section", cls, [
      el_attrs("details", fold_attrs, concat([ band ], body)),
    ])
  }
}

fn group_statuses(g: SectionGroup, merged: List<Int>) -> List<String> {
  map(g.nodes, rn => node_status_symbol(rn: rn, merged: merged))
}

fn section_statuses(s: RoadmapSection, merged: List<Int>) -> List<String> {
  fold(s.elements, init: [], f: (acc, e) => match e {
    Prose { prose: _ } => acc
    Group { group } => concat(acc, group_statuses(g: group, merged: merged))
  })
}

fn section_markup(s: RoadmapSection, merged: List<Int>) -> Fragment {
  let body = fold(s.elements, init: [], f: (acc, e) => concat(acc, element_markup(e: e, merged: merged)))
  altitude_section(
    cls: "roadmap-section",
    title_nodes: [ el("h2", [ txt(s.title) ]) ],
    statuses: section_statuses(s: s, merged: merged),
    body: body)
}

fn frontier_flat_node_li(rn: RoadmapNode, edges: List<RoadmapEdge>, merged: List<Int>) -> Fragment {
  let status = node_status_symbol(rn: rn, merged: merged)
  Element {
    tag: "li",
    attributes: node_li_attributes(rn: rn, status: status),
    children: concat(
      [ node_head_row(
          rn: rn,
          edges: edges,
          merged: merged,
          dispatchable: node_exposes_manual_dispatch(rn: rn, merged: merged)) ],
      item_detail_block(rn: rn)),
  }
}

fn frontier_bucket_ul(items: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>) -> Fragment {
  el("ul", map(items, rn => frontier_flat_node_li(rn: rn, edges: edges, merged: merged)))
}

fn frontier_bucket_markup(label: String, cls: String, items: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>) -> Fragment {
  altitude_section(
    cls: concat("frontier-bucket frontier-", cls),
    title_nodes: [ el("h2", [ txt(label) ]) ],
    statuses: map(items, rn => node_status_symbol(rn: rn, merged: merged)),
    body: [ frontier_bucket_ul(items: items, edges: edges, merged: merged) ])
}

fn roadmap_frontier_markup(frontier: SpawnFrontier, edges: List<RoadmapEdge>, merged: List<Int>) -> Fragment {
  el_class("section", "roadmap-frontier", [
    frontier_bucket_markup(label: "Ready", cls: "ready", items: frontier.ready, edges: edges, merged: merged),
    frontier_bucket_markup(label: "Upcoming", cls: "upcoming", items: frontier.upcoming, edges: edges, merged: merged),
    frontier_bucket_markup(label: "Done", cls: "done", items: frontier.done, edges: edges, merged: merged),
    frontier_bucket_markup(label: "Superseded", cls: "superseded", items: frontier.superseded, edges: edges, merged: merged),
  ])
}

fn roadmap_daily_workspace_page_impl(doc: RoadmapDocument, merged: List<Int>, main_prefix: List<Fragment>) -> Fragment {
  let frontier = spawn_frontier(doc: doc, merged: merged)
  let edges = doc_all_edges(doc: doc)
  Element {
    tag: "html",
    attributes: [ attr(name: "lang", value: "en" ) ],
    children: [
      el("head", [
        Element { tag: "meta", attributes: [ attr(name: "charset", value: "utf-8" ) ], children: [] },
        Element { tag: "meta", attributes: [ attr(name: "name", value: "viewport" ), attr(name: "content", value: "width=device-width, initial-scale=1" ) ], children: [] },
        el("style", [ txt(roadmap_css()) ]),
        el("title", [ txt("gunbc — daily workspace") ]),
      ]),
      el("body", [
        roadmap_header(page: "daily workspace"),
        el_class("main", "daily-workspace", concat(main_prefix, [
          roadmap_frontier_markup(frontier: frontier, edges: edges, merged: merged),
        ])),
        dispatch_client_script(),
      ]),
    ],
  }
}

fn roadmap_page_impl(doc: RoadmapDocument, merged: List<Int>, main_prefix: List<Fragment>) -> Fragment {
  let lead = map(doc.lead_lanes, s => section_markup(s: s, merged: merged))
  let secs = map(doc.sections, s => section_markup(s: s, merged: merged))
  let main_children = concat(main_prefix, concat(lead, secs))
  let body_base = [
    roadmap_header(page: "roadmap"),
    el_class("main", "roadmap", main_children),
  ]
  let body_children = if list_length(main_children) == 0 {
    body_base
  } else {
    concat(body_base, [ dispatch_client_script() ])
  }
  Element {
    tag: "html",
    attributes: [ attr(name: "lang", value: "en" ) ],
    children: [
      el("head", [
        Element { tag: "meta", attributes: [ attr(name: "charset", value: "utf-8" ) ], children: [] },
        Element { tag: "meta", attributes: [ attr(name: "name", value: "viewport" ), attr(name: "content", value: "width=device-width, initial-scale=1" ) ], children: [] },
        el("style", [ txt(roadmap_css()) ]),
        el("title", [ txt("gunbc — roadmap") ]),
      ]),
      el("body", body_children),
    ],
  }
}

fn roadmap_page(doc: RoadmapDocument, merged: List<Int>) -> Fragment {
  roadmap_page_impl(doc: doc, merged: merged, main_prefix: [])
}

data roadmap_page_focus_parameter_note: String = "roadmap_page_for_doc exists so a claim about how a TICKET ROW renders can be written without a claim about which lanes are currently shown. witness_ticket_rows_render_structured asserts the row markup — disclosure mark, brief class, displaced-cost label, carrier href — and it happened to pick a node from a lane the focus later hid, so it went red having found nothing wrong with the rendering at all. Passing an unfocused document keeps that claim measuring markup. roadmap_page_for_authority keeps the declared focus, because the served page IS the focused view."

fn roadmap_page_for_doc(doc: RoadmapDocument) -> Fragment {
  roadmap_page_impl(
    doc: doc,
    merged: authored_merged_prs(),
    main_prefix: [
      dashboard_instance_banner(),
      finish_line_progress_markup(),
    ],
  )
}

fn roadmap_page_for_authority() -> Fragment {
  roadmap_page_impl(
    doc: roadmap_authority(),
    merged: authored_merged_prs(),
    main_prefix: [
      dashboard_instance_banner(),
      finish_line_progress_markup(),
    ],
  )
}

fn roadmap_daily_workspace_page(doc: RoadmapDocument, merged: List<Int>) -> Fragment {
  roadmap_daily_workspace_page_impl(doc: doc, merged: merged, main_prefix: [])
}

fn roadmap_daily_workspace_page_for_authority() -> Fragment {
  roadmap_daily_workspace_page_impl(
    doc: roadmap_authority(),
    merged: authored_merged_prs(),
    main_prefix: [
      dashboard_instance_banner(),
      program_progress_compact_markup(),
    ],
  )
}
