module gunbc.roadmap_page

import std.markup { MarkupNode, ElementNode, TextNode, MarkupAttr }
import std.markdown_markup { markdown_inlines_to_markup_nodes }
import extdeps.languages.markdown { parse_inline_markdown_minimal }
import gunbc.roadmap_style { roadmap_css }
import gunbc.roadmap_model {
  RoadmapNode, RoadmapEdge, Pointer, RoadmapNodeId,
  RoadmapParent, TopLevel, UnderParent, roadmap_parent, is_top_level,
  SectionElement, Prose, Group, SectionGroup,
  NodeSizing, Unsized, Sized,
  Intricacy, IntricacyLow, IntricacyMedium, IntricacyHigh,
  Volume, VolumeSmall, VolumeMedium, VolumeLarge,
}
import gunbc.roadmap_status { RoadmapItem, DerivableLine, AuthoredLine, PlainLine, item_is_done, signoff_accepts, signoff_by }
import gunbc.roadmap_document { RoadmapDocument, RoadmapSection }
import gunbc.roadmap_authority { roadmap_authority, authored_merged_prs }
import gunbc.roadmap_spawner { spawn_frontier, SpawnFrontier }
import gunbc.v1_deletion_plan {
  v1_deletion_gates, v1_deletion_milestones, PlanGateSpec, PlanMilestone,
  PlanGate, GateEmitterFixedPoint, GateHonestFrontier, GateLedgerGreen, GateDeletion,
  BrickState, Placed, InFlight, Gated,
}

fn roadmap_page_max_depth() -> Int { 8 }

fn gate_index(g: PlanGate) -> Int {
  match g {
    GateEmitterFixedPoint => 0
    GateHonestFrontier => 1
    GateLedgerGreen => 2
    GateDeletion => 3
  }
}

fn gate_eq(a: PlanGate, b: PlanGate) -> Bool { gate_index(g: a) == gate_index(g: b) }

fn brick_is_placed(bs: BrickState) -> Bool {
  match bs {
    Placed => true
    InFlight => false
    Gated => false
  }
}

fn brick_is_remaining(bs: BrickState) -> Bool {
  match bs {
    Placed => false
    InFlight => true
    Gated => true
  }
}

fn brick_state_class(bs: BrickState) -> String {
  match bs {
    Placed => "placed"
    InFlight => "inflight"
    Gated => "gated"
  }
}

fn brick_state_label(bs: BrickState) -> String {
  match bs {
    Placed => "done"
    InFlight => "in flight"
    Gated => "gated"
  }
}

fn gate_bricks(g: PlanGate) -> List<PlanMilestone> {
  filter(v1_deletion_milestones, m => gate_eq(a: m.gate, b: g))
}

fn gate_total(g: PlanGate) -> Int { count(gate_bricks(g: g)) }

fn gate_placed(g: PlanGate) -> Int {
  count(filter(gate_bricks(g: g), m => brick_is_placed(bs: m.brick_state)))
}

fn gate_percent(placed: Int, total: Int) -> Int {
  if total == 0 { 0 } else { placed * 100 / total }
}

fn gate_count_label(placed: Int, total: Int) -> String {
  concat(to_string(placed), concat(" / ", to_string(total)))
}

fn bar_fill(pct: Int) -> MarkupNode {
  ElementNode {
    tag: "div",
    attrs: [
      MarkupAttr { name: "class", value: "bar-fill" },
      MarkupAttr { name: "style", value: concat("width: ", concat(to_string(pct), "%")) },
    ],
    children: [],
  }
}

fn brick_li(m: PlanMilestone) -> MarkupNode {
  el_class("li", concat("brick brick-", brick_state_class(bs: m.brick_state)), [
    el_class("span", "brick-state", [ txt(brick_state_label(bs: m.brick_state)) ]),
    el_class("span", "brick-title", [ txt(m.title) ]),
  ])
}

fn gate_remaining_ul(g: PlanGate) -> MarkupNode {
  el_class("ul", "bricks",
    map(filter(gate_bricks(g: g), m => brick_is_remaining(bs: m.brick_state)), m => brick_li(m: m)))
}

fn gate_progress_row(spec: PlanGateSpec) -> MarkupNode {
  let total = gate_total(g: spec.gate)
  let placed = gate_placed(g: spec.gate)
  el_class("section", "gate-row", [
    el_class("div", "gate-head", [
      el_class("span", "gate-name", [ txt(spec.name) ]),
      el_class("span", "gate-count", [ txt(gate_count_label(placed: placed, total: total)) ]),
    ]),
    el_class("div", "gate-bar", [ bar_fill(pct: gate_percent(placed: placed, total: total)) ]),
    gate_remaining_ul(g: spec.gate),
  ])
}

fn three_gate_progress_markup() -> MarkupNode {
  el_class("section", "three-gate-progress",
    concat(
      [ el("h2", [ txt("v1-delete bar: three gates") ]) ],
      map(v1_deletion_gates, spec => gate_progress_row(spec: spec))))
}

fn txt(s: String) -> MarkupNode { TextNode { text: s } }

fn el(tag: String, children: List<MarkupNode>) -> MarkupNode {
  ElementNode { tag: tag, attrs: [], children: children }
}

fn el_class(tag: String, cls: String, children: List<MarkupNode>) -> MarkupNode {
  ElementNode { tag: tag, attrs: [ MarkupAttr { name: "class", value: cls } ], children: children }
}

fn node_status_symbol(rn: RoadmapNode, merged: List<Int>) -> String {
  if signoff_accepts(s: rn.signoff) {
    "done"
  } else {
    if item_is_done(item: rn.line, merged: merged) {
      "review"
    } else {
      "open"
    }
  }
}

fn intricacy_label(i: Intricacy) -> String {
  match i {
    IntricacyLow => "i:low"
    IntricacyMedium => "i:med"
    IntricacyHigh => "i:high"
  }
}

fn volume_label(v: Volume) -> String {
  match v {
    VolumeSmall => "v:small"
    VolumeMedium => "v:med"
    VolumeLarge => "v:large"
  }
}

fn sizing_label(s: NodeSizing) -> String {
  match s {
    Unsized => ""
    Sized { intricacy, volume, repo, acceptance } =>
      join([intricacy_label(i: intricacy), " ", volume_label(v: volume), " ", repo], "")
  }
}

fn line_title(line: RoadmapItem) -> String {
  match line {
    DerivableLine { prs, title, description } => title
    AuthoredLine { done, content } => content
    PlainLine { content } => content
  }
}

fn title_nodes(line: RoadmapItem) -> List<MarkupNode> {
  markdown_inlines_to_markup_nodes(inlines: parse_inline_markdown_minimal(text: line_title(line: line)))
}

fn pointer_link(p: Pointer) -> MarkupNode {
  ElementNode {
    tag: "a",
    attrs: [ MarkupAttr { name: "href", value: p.path } ],
    children: [ txt(p.label) ],
  }
}

fn carrier_links(carriers: List<Pointer>) -> List<MarkupNode> {
  map(carriers, p => pointer_link(p: p))
}

fn children_of(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, parent: RoadmapNodeId) -> List<RoadmapNode> {
  nodes |> filter(n => match roadmap_parent(edges: edges, node: n.node) {
    UnderParent { parent: p } => p == parent
    TopLevel => false
  })
}

fn owner_badge(rn: RoadmapNode) -> List<MarkupNode> {
  if rn.owner == "" {
    []
  } else {
    [ el_class("span", "owner", [ txt(concat("@", rn.owner)) ]) ]
  }
}

fn sizing_badge(rn: RoadmapNode) -> List<MarkupNode> {
  let label = sizing_label(s: rn.sizing)
  if label == "" {
    []
  } else {
    [ el_class("span", "sizing", [ txt(label) ]) ]
  }
}

fn node_li(rn: RoadmapNode, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, fuel: Int) -> MarkupNode {
  let status = node_status_symbol(rn: rn, merged: merged)
  let head = concat(
    concat(
      [
        el_class("span", concat("status status-", status), [ txt(status) ]),
        el_class("span", "title", title_nodes(line: rn.line)),
      ],
      owner_badge(rn: rn),
    ),
    concat(sizing_badge(rn: rn), carrier_links(carriers: rn.carriers)),
  )
  let kids = children_of(nodes: nodes, edges: edges, parent: rn.node)
  let child_block = if count(kids) == 0 {
    []
  } else {
    if fuel > 0 {
      [ nodes_ul(items: kids, nodes: nodes, edges: edges, merged: merged, fuel: fuel - 1) ]
    } else {
      [
        ElementNode {
          tag: "ul",
          attrs: [ MarkupAttr { name: "class", value: "depth-limited" } ],
          children: [
            el_class("li", "depth-limit", [
              txt(concat(concat("(", to_string(count(kids))), " nested node(s) hidden — depth limit)")),
            ]),
          ],
        },
      ]
    }
  }
  ElementNode {
    tag: "li",
    attrs: [ MarkupAttr { name: "class", value: concat("node node-", status) } ],
    children: concat(head, child_block),
  }
}

fn nodes_ul(items: List<RoadmapNode>, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, fuel: Int) -> MarkupNode {
  el("ul", map(items, rn => node_li(rn: rn, nodes: nodes, edges: edges, merged: merged, fuel: fuel)))
}

fn group_markup(g: SectionGroup, merged: List<Int>) -> List<MarkupNode> {
  let tops = g.nodes |> filter(n => is_top_level(edges: g.edges, node: n.node))
  let ul = nodes_ul(items: tops, nodes: g.nodes, edges: g.edges, merged: merged, fuel: roadmap_page_max_depth())
  if g.label == "" {
    [ ul ]
  } else {
    [ el_class("h3", "group-label", [ txt(g.label) ]), ul ]
  }
}

fn element_markup(e: SectionElement, merged: List<Int>) -> List<MarkupNode> {
  match e {
    Prose { prose } => [ el_class("p", "prose", markdown_inlines_to_markup_nodes(inlines: parse_inline_markdown_minimal(text: prose.content))) ]
    Group { group } => group_markup(g: group, merged: merged)
  }
}

fn section_markup(s: RoadmapSection, merged: List<Int>) -> MarkupNode {
  let body = fold(s.elements, init: [], f: (acc, e) => concat(acc, element_markup(e: e, merged: merged)))
  el_class("section", "roadmap-section", concat([ el("h2", [ txt(s.title) ]) ], body))
}

fn frontier_flat_node_li(rn: RoadmapNode, merged: List<Int>) -> MarkupNode {
  let status = node_status_symbol(rn: rn, merged: merged)
  let head = concat(
    concat(
      [
        el_class("span", concat("status status-", status), [ txt(status) ]),
        el_class("span", "title", title_nodes(line: rn.line)),
      ],
      owner_badge(rn: rn),
    ),
    concat(sizing_badge(rn: rn), carrier_links(carriers: rn.carriers)),
  )
  ElementNode {
    tag: "li",
    attrs: [ MarkupAttr { name: "class", value: concat("node node-", status) } ],
    children: head,
  }
}

fn frontier_bucket_ul(items: List<RoadmapNode>, merged: List<Int>) -> MarkupNode {
  el("ul", map(items, rn => frontier_flat_node_li(rn: rn, merged: merged)))
}

fn frontier_bucket_markup(label: String, cls: String, items: List<RoadmapNode>, merged: List<Int>) -> MarkupNode {
  el_class("section", concat("frontier-bucket frontier-", cls), [
    el("h2", [ txt(label) ]),
    frontier_bucket_ul(items: items, merged: merged),
  ])
}

fn roadmap_frontier_markup(frontier: SpawnFrontier, merged: List<Int>) -> MarkupNode {
  el_class("section", "roadmap-frontier", [
    frontier_bucket_markup(label: "Ready", cls: "ready", items: frontier.ready, merged: merged),
    frontier_bucket_markup(label: "Upcoming", cls: "upcoming", items: frontier.upcoming, merged: merged),
    frontier_bucket_markup(label: "Done", cls: "done", items: frontier.done, merged: merged),
  ])
}

fn roadmap_daily_workspace_page(doc: RoadmapDocument, merged: List<Int>) -> MarkupNode {
  let frontier = spawn_frontier(doc: doc, merged: merged)
  ElementNode {
    tag: "html",
    attrs: [],
    children: [
      el("head", [
        ElementNode { tag: "meta", attrs: [ MarkupAttr { name: "charset", value: "utf-8" } ], children: [] },
        el("style", [ txt(roadmap_css()) ]),
        el("title", [ txt("gunbc — daily workspace") ]),
      ]),
      el("body", [
        el("header", [ el("h1", [ txt("gunbc — daily workspace") ]) ]),
        el_class("main", "daily-workspace", [
          roadmap_frontier_markup(frontier: frontier, merged: merged),
        ]),
      ]),
    ],
  }
}

fn roadmap_page(doc: RoadmapDocument, merged: List<Int>) -> MarkupNode {
  let lead = map(doc.lead_lanes, s => section_markup(s: s, merged: merged))
  let secs = map(doc.sections, s => section_markup(s: s, merged: merged))
  let main_children = concat(lead, secs)
  ElementNode {
    tag: "html",
    attrs: [],
    children: [
      el("head", [
        ElementNode { tag: "meta", attrs: [ MarkupAttr { name: "charset", value: "utf-8" } ], children: [] },
        el("style", [ txt(roadmap_css()) ]),
        el("title", [ txt("gunbc — roadmap") ]),
      ]),
      el("body", [
        el("header", [ el("h1", [ txt("gunbc — roadmap") ]) ]),
        el_class("main", "roadmap", main_children),
      ]),
    ],
  }
}

fn roadmap_page_for_authority() -> MarkupNode {
  roadmap_page(doc: roadmap_authority(), merged: authored_merged_prs())
}

fn roadmap_daily_workspace_page_for_authority() -> MarkupNode {
  roadmap_daily_workspace_page(doc: roadmap_authority(), merged: authored_merged_prs())
}
