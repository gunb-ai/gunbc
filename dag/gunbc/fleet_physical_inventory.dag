module gunbc.fleet_physical_inventory


// SPATIAL-0 owned inventory bindings: extdeps rows cite vendor facts; this module binds allocated
// PhysicalAssetIdentity and HostIdentity instances to catalog declarations and rack residence.
// Mounting/shelf/U position stay UNOBSERVED until read or supplied. Amazon order IDs/URLs are
// procurement provenance, never asset identity. Nominal declared rackmount total 4+4+2+2+1+1 = 14U
// of 18U is arithmetic on catalog rack_units plus operator-declared 1U shelf for the desktop
// switch, not an observation. Raspberry Pi catalog identity remains unauthored until exact
// model/revision is observed.
data operator_site: product.placement_supply.SiteIdentity = "operator-lab" as product.placement_supply.SiteIdentity
data rack_01: product.placement_supply.RackIdentity = "rack-01" as product.placement_supply.RackIdentity

data operator_physical_site: product.placement_supply.PhysicalSite = product.placement_supply.PhysicalSite {
  identity: operator_site,
  racks: [rack_01],
}

data nominal_rackmount_units_declared: std.measure.RackUnit = rack_unit(14)
data operator_switch_shelf_units: std.measure.RackUnit = rack_unit(1)

data chassis_srv1: product.placement_supply.PhysicalAssetIdentity = "chassis-srv1" as product.placement_supply.PhysicalAssetIdentity
data chassis_srv2: product.placement_supply.PhysicalAssetIdentity = "chassis-srv2" as product.placement_supply.PhysicalAssetIdentity
data chassis_srv3: product.placement_supply.PhysicalAssetIdentity = "chassis-srv3" as product.placement_supply.PhysicalAssetIdentity
data chassis_srv4: product.placement_supply.PhysicalAssetIdentity = "chassis-srv4" as product.placement_supply.PhysicalAssetIdentity
data chassis_srv5_placeholder: product.placement_supply.PhysicalAssetIdentity = "chassis-srv5-placeholder" as product.placement_supply.PhysicalAssetIdentity
data chassis_srv6_placeholder: product.placement_supply.PhysicalAssetIdentity = "chassis-srv6-placeholder" as product.placement_supply.PhysicalAssetIdentity
data switch_01: product.placement_supply.PhysicalAssetIdentity = "switch-01" as product.placement_supply.PhysicalAssetIdentity
data pdu_01: product.placement_supply.PhysicalAssetIdentity = "pdu-01" as product.placement_supply.PhysicalAssetIdentity
data pi_controller: product.placement_supply.PhysicalAssetIdentity = "pi-controller" as product.placement_supply.PhysicalAssetIdentity

data host_srv1: product.placement_supply.HostIdentity = "srv1" as product.placement_supply.HostIdentity
data host_srv2: product.placement_supply.HostIdentity = "srv2" as product.placement_supply.HostIdentity
data host_srv3: product.placement_supply.HostIdentity = "srv3" as product.placement_supply.HostIdentity
data host_srv4: product.placement_supply.HostIdentity = "srv4" as product.placement_supply.HostIdentity
data host_srv5: product.placement_supply.HostIdentity = "srv5" as product.placement_supply.HostIdentity
data host_srv6: product.placement_supply.HostIdentity = "srv6" as product.placement_supply.HostIdentity

data srv1_chassis_asset: product.placement_supply.PhysicalAsset = product.placement_supply.PhysicalAsset {
  identity: chassis_srv1,
  catalog: std.decl_ref.DeclarationRef {
    module_path: "extdeps.chassis.rosewill",
    decl_name: "rosewill_rsv_r4000u_catalog",
    field: WholeDeclaration,
  },
  physical_serial: none,
  procurement: none,
}

data switch_01_asset: product.placement_supply.PhysicalAsset = product.placement_supply.PhysicalAsset {
  identity: switch_01,
  catalog: std.decl_ref.DeclarationRef {
    module_path: "extdeps.network.tp_link",
    decl_name: "tp_link_tl_sg1024s_catalog",
    field: WholeDeclaration,
  },
  physical_serial: none,
  procurement: none,
}

data pdu_01_asset: product.placement_supply.PhysicalAsset = product.placement_supply.PhysicalAsset {
  identity: pdu_01,
  catalog: std.decl_ref.DeclarationRef {
    module_path: "extdeps.power.eaton_tripp_lite",
    decl_name: "eaton_tripp_lite_rs_1215_family_catalog",
    field: WholeDeclaration,
  },
  physical_serial: none,
  procurement: none,
}

data rack_01_unobserved_residence: product.placement_supply.RackResidence = RackResidenceUnobserved

data fleet_host_spatial_facts: List<product.placement_supply.HostSpatialFacts> = [
  product.placement_supply.HostSpatialFacts {
    host: host_srv1,
    asset: chassis_srv1,
    residence: rack_01_unobserved_residence,
    wireless: WirelessAdapterAbsent,
    relay: RelayIncapable,
    bootstrap_need: BootstrapNotNeeded,
  },
  product.placement_supply.HostSpatialFacts {
    host: host_srv2,
    asset: chassis_srv2,
    residence: rack_01_unobserved_residence,
    wireless: WirelessAdapterUnobserved,
    relay: RelayUnprovisioned,
    bootstrap_need: BootstrapNotNeeded,
  },
  product.placement_supply.HostSpatialFacts {
    host: host_srv3,
    asset: chassis_srv3,
    residence: rack_01_unobserved_residence,
    wireless: WirelessAdapterUnobserved,
    relay: RelayUnprovisioned,
    bootstrap_need: BootstrapNotNeeded,
  },
  product.placement_supply.HostSpatialFacts {
    host: host_srv4,
    asset: chassis_srv4,
    residence: rack_01_unobserved_residence,
    wireless: WirelessAdapterUnobserved,
    relay: RelayUnprovisioned,
    bootstrap_need: BootstrapNotNeeded,
  },
  product.placement_supply.HostSpatialFacts {
    host: host_srv5,
    asset: chassis_srv5_placeholder,
    residence: rack_01_unobserved_residence,
    wireless: WirelessAdapterUnobserved,
    relay: RelayUnprovisioned,
    bootstrap_need: BootstrapNeeded,
  },
  product.placement_supply.HostSpatialFacts {
    host: host_srv6,
    asset: chassis_srv6_placeholder,
    residence: rack_01_unobserved_residence,
    wireless: WirelessAdapterUnobserved,
    relay: RelayUnprovisioned,
    bootstrap_need: BootstrapNeeded,
  },
]

// FleetOnce wifi-first-relay-standing human burden row is intentionally absent here —
// std.human_intervention authority is gunbc#7950; this module imports it and authors the burden
// row when that PR merges, not as a fourth fork of the carrier.
data srv1_measured_wireless_note: String = "srv1 fleet controller measured WirelessAdapterAbsent: docker0 enP3p3s0f0 enP3p3s0f1 enP3p5s0 enx62a53617b395 lo tailscale0 veth*, no nmcli wireless interface — so no current fleet host can associate with a DGX OOBE hotspot without a dedicated relay."

// srv3/srv4 Dynatron W1 installation, previously carried as a prose note stating it was "not yet
// modeled as a separate PhysicalAsset row". It is now exactly that: two cooler assets citing the
// vendor catalog declaration, bound to their hosts through HostContainsComponent — the same
// containment arm every other host component uses. product.cooling_qualification consumes these
// rows to reach a catalog verdict, and gunbc.bmc_fan_converge requires that verdict before any
// host may claim a thermally qualified fan configuration.
data cooler_srv3: product.placement_supply.PhysicalAssetIdentity = "cooler-srv3" as product.placement_supply.PhysicalAssetIdentity
data cooler_srv4: product.placement_supply.PhysicalAssetIdentity = "cooler-srv4" as product.placement_supply.PhysicalAssetIdentity

data srv3_cooler_asset: product.placement_supply.PhysicalAsset = product.placement_supply.PhysicalAsset {
  identity: cooler_srv3,
  catalog: std.decl_ref.DeclarationRef {
    module_path: "extdeps.cooling.dynatron",
    decl_name: "dynatron_w1_catalog",
    field: WholeDeclaration,
  },
  physical_serial: none,
  procurement: none,
}

data srv4_cooler_asset: product.placement_supply.PhysicalAsset = product.placement_supply.PhysicalAsset {
  identity: cooler_srv4,
  catalog: std.decl_ref.DeclarationRef {
    module_path: "extdeps.cooling.dynatron",
    decl_name: "dynatron_w1_catalog",
    field: WholeDeclaration,
  },
  physical_serial: none,
  procurement: none,
}

data installed_cooler_containments: List<product.placement_supply.PhysicalContainment> = [
  product.placement_supply.HostContainsComponent { host: host_srv3, component: cooler_srv3 },
  product.placement_supply.HostContainsComponent { host: host_srv4, component: cooler_srv4 },
]

// srv1/srv2 carry no cooler asset row: their installed cooling is UNOBSERVED — not absent, and
// not assumed compatible. installed_cooling_verdict_for_host reaches InstalledCoolingUnobserved
// for them, which admits fan observation and refuses thermal qualification, so the coverage
// obligation stays loud instead of defaulting to a pass.
data installed_cooling_realizations: List<product.cooling_qualification.InstalledCoolingRealization> = [
  product.cooling_qualification.InstalledCoolingRealization {
    host: host_srv3,
    cooler_asset: cooler_srv3,
    cooler: dynatron_w1_catalog,
    processor: altra_max_m12830_catalog,
    baseboard_model: srv3_baseboard.catalog.model,
  },
  product.cooling_qualification.InstalledCoolingRealization {
    host: host_srv4,
    cooler_asset: cooler_srv4,
    cooler: dynatron_w1_catalog,
    processor: altra_max_m12830_catalog,
    baseboard_model: srv4_baseboard.catalog.model,
  },
]

data rack_01_catalog_units: std.measure.RackUnit = navepoint_18u_open_frame_catalog.rack_units

// measure_add<Q, S> admits only operands of the SAME quantity and scale, so this sum is
// dimensionally checked by construction — a Millimeter or a bare count cannot enter it.
fn fleet_nominal_rackmount_arithmetic_holds() -> Bool {
  let declared = measure_add(
    a: measure_add(
      a: measure_add(
        a: measure_add(
          a: measure_add(
            a: rosewill_rsv_r4000u_catalog.rack_units,
            b: rosewill_rsv_r4000u_catalog.rack_units,
          ),
          b: rosewill_rsv_z2600u_catalog.rack_units,
        ),
        b: rosewill_rsv_z2600u_catalog.rack_units,
      ),
      b: operator_switch_shelf_units,
    ),
    b: eaton_tripp_lite_rs_1215_family_catalog.rack_units,
  )
  declared == nominal_rackmount_units_declared && rack_01_catalog_units == navepoint_18u_open_frame_catalog.rack_units
}
