]

data fleet_processor_observation_absent_cause: NonEmptyStr = "no per-host processor reading exists: the fleet processor is modeled intent (gunbc.fleet_intent fleet_intent_cpu) and no dmidecode -t processor receipt has been supplied"

data fleet_processor_observations: List<HostProcessorObservation> = [
  ProcessorObservationAbsent { host: operator_host_srv1, cause: fleet_processor_observation_absent_cause },
  ProcessorObservationAbsent { host: operator_host_srv2, cause: fleet_processor_observation_absent_cause },
  ProcessorObservationAbsent { host: operator_host_srv3, cause: fleet_processor_observation_absent_cause },
  ProcessorObservationAbsent { host: operator_host_srv4, cause: fleet_processor_observation_absent_cause },
]

data fleet_processor_verdicts: List<ProcessorReconcileVerdict> = [
  processor_reconcile_verdict(
    expectation: HostProcessorExpectation { host: operator_host_srv1, catalog: altra_max_m12830_catalog },
    observation: ProcessorObservationAbsent { host: operator_host_srv1, cause: fleet_processor_observation_absent_cause },
  ),
  processor_reconcile_verdict(
    expectation: HostProcessorExpectation { host: operator_host_srv2, catalog: altra_max_m12830_catalog },
    observation: ProcessorObservationAbsent { host: operator_host_srv2, cause: fleet_processor_observation_absent_cause },
  ),
  processor_reconcile_verdict(
    expectation: HostProcessorExpectation { host: operator_host_srv3, catalog: altra_max_m12830_catalog },
    observation: ProcessorObservationAbsent { host: operator_host_srv3, cause: fleet_processor_observation_absent_cause },
  ),
  processor_reconcile_verdict(
