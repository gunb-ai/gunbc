// SPATIAL-0 owned inventory bindings: extdeps rows cite vendor facts; this module binds allocated
// PhysicalAssetIdentity and HostIdentity instances to catalog declarations and rack residence.
// Mounting/shelf/U position stay UNOBSERVED until read or supplied. Amazon order IDs/URLs are
// procurement provenance, never asset identity. Nominal declared rackmount total 4+4+2+2+1+1 = 14U
// of 18U is arithmetic on catalog rack_units plus operator-declared 1U shelf for the desktop
// switch, not an observation. Raspberry Pi catalog identity remains unauthored until exact
// model/revision is observed.
data operator_site: SiteIdentity = "operator-lab" as SiteIdentity
data rack_01: RackIdentity = "rack-01" as RackIdentity

data operator_physical_site: PhysicalSite = PhysicalSite {
  identity: operator_site,
  racks: [rack_01],
}

data nominal_rackmount_units_declared: RackUnit = rack_unit(14)
data operator_switch_shelf_units: RackUnit = rack_unit(1)

data chassis_srv1: PhysicalAssetIdentity = "chassis-srv1" as PhysicalAssetIdentity
data chassis_srv2: PhysicalAssetIdentity = "chassis-srv2" as PhysicalAssetIdentity
data chassis_srv3: PhysicalAssetIdentity = "chassis-srv3" as PhysicalAssetIdentity
data chassis_srv4: PhysicalAssetIdentity = "chassis-srv4" as PhysicalAssetIdentity
data chassis_srv5_placeholder: PhysicalAssetIdentity = "chassis-srv5-placeholder" as PhysicalAssetIdentity
data chassis_srv6_placeholder: PhysicalAssetIdentity = "chassis-srv6-placeholder" as PhysicalAssetIdentity
data switch_01: PhysicalAssetIdentity = "switch-01" as PhysicalAssetIdentity
data pdu_01: PhysicalAssetIdentity = "pdu-01" as PhysicalAssetIdentity
data pi_controller: PhysicalAssetIdentity = "pi-controller" as PhysicalAssetIdentity


// THE SIX host_srv ROWS THAT STOOD HERE WERE A SECOND AUTHORING OF AN IDENTITY THAT ALREADY HAD ONE.
// They declared "srv1" through "srv6" as HostIdentity, byte-for-byte the values
// gunbc.fleet_intent_network already declares as operator_host_srv1 through operator_host_srv6.
// Two names, one concept, one set of values -- the section 3 nicknaming violation, and the reason
// nothing ever caught it is that the two agreed EXACTLY. Any check anyone thought to write would
// have compared them and passed. A fork of VALUES rather than of behaviour is invisible to
// comparison, and these two authorings were never once in the same scope, so no site existed at
// which the duplication could have been noticed at all.
//
// THE BRAND DID NOT HELP, AND THE REASON IS SHARPER THAN THE BRAND BEING WEAK. HostIdentity is a
// branded NonEmptyStr and BOTH authorings used it. A brand constrains what a value IS; it cannot
// require that a value be authored ONCE, because nothing compels a would-be author to reach for an
// existing declaration rather than write a new one of the same type. The brand made both
// declarations look deliberate.
//
// WHAT THIS MODULE OWNS IS PHYSICAL FACTS, NOT IDENTITY. The rows below key spatial facts, chassis
// containment, cooling realizations, and DIMM and processor expectations BY host -- the identity is
// an INDEX into this module's facts, never a fact this module establishes. That is why the repoint
// is mechanical and why no verdict moves: nothing here reads a property OF the identity.
data srv1_chassis_asset: PhysicalAsset = PhysicalAsset {
  identity: chassis_srv1,
  catalog: DeclarationRef {
    module_path: "extdeps.chassis.rosewill",
    decl_name: "rosewill_rsv_r4000u_catalog",
    field: WholeDeclaration,
  },
  physical_serial: none,
  procurement: none,
}

data switch_01_asset: PhysicalAsset = PhysicalAsset {
  identity: switch_01,
  catalog: DeclarationRef {
    module_path: "extdeps.network.tp_link",
    decl_name: "tp_link_tl_sg1024s_catalog",
    field: WholeDeclaration,
  },
  physical_serial: none,
  procurement: none,
}

data pdu_01_asset: PhysicalAsset = PhysicalAsset {
  identity: pdu_01,
  catalog: DeclarationRef {
    module_path: "extdeps.power.eaton_tripp_lite",
    decl_name: "eaton_tripp_lite_rs_1215_family_catalog",
    field: WholeDeclaration,
  },
  physical_serial: none,
  procurement: none,
}

