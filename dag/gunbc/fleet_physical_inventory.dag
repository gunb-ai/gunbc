  InstalledCoolingRealization {
    host: operator_host_srv3,
    cooler_asset: cooler_srv3,
    cooler: dynatron_w1_catalog,
    processor: altra_max_m12830_catalog,
    baseboard_model: srv3_baseboard.catalog.model,
  },
  InstalledCoolingRealization {
    host: operator_host_srv4,
    cooler_asset: cooler_srv4,
    cooler: dynatron_w1_catalog,
    processor: altra_max_m12830_catalog,
    baseboard_model: srv4_baseboard.catalog.model,
  },
]

data rack_01_catalog_units: RackUnit = navepoint_18u_open_frame_catalog.rack_units

// measure_add<Q, S> admits only operands of the SAME quantity and scale, so this sum is
// dimensionally checked by construction — a Millimeter or a bare count cannot enter it.
fn fleet_nominal_rackmount_arithmetic_holds() -> Bool {
  let declared = measure_add(
    a: measure_add(
      a: measure_add(
        a: measure_add(
          a: measure_add(
            a: rosewill_rsv_r4000u_catalog.rack_units,
            b: rosewill_rsv_r4000u_catalog.rack_units,
          ),
          b: rosewill_rsv_z2600u_catalog.rack_units,
        ),
        b: rosewill_rsv_z2600u_catalog.rack_units,
      ),
      b: operator_switch_shelf_units,
    ),
    b: eaton_tripp_lite_rs_1215_family_catalog.rack_units,
  )
  declared == nominal_rackmount_units_declared && rack_01_catalog_units == navepoint_18u_open_frame_catalog.rack_units
}

// ---------------------------------------------------------------------------
// INSTALLED DIMM AND PROCESSOR BILLS OF MATERIALS: what is expected, what has
// actually been observed, and the refusal between them.
//
// The expectation below is the operator's stated belief that all four hosts
// carry an eight-stick population of the SK Hynix part already cited in
// extdeps.memory.sk_hynix. It is authored as an expectation and nothing else:
// no PhysicalAsset row binds an installed DIMM here, because binding an asset
// would assert that somebody read a part number off a slot, and for the
// per-slot grain nobody has.
//
// THE EXPECTATION IS ALREADY REFUTED ON ONE HOST, and that is the mechanism
// working rather than an authoring error. srv1 and srv2 confirm it against
// their 2026-07-16 BMC Redfish populations; srv3's population from the same
// read is seven HMA82GR7AFR8N-VK plus one HMA82GR7AFR4N-VK, so the uniform
// expectation reaches DimmPopulationRefused with the exact part difference
// named. The rows stay as authored rather than being quietly edited to match
// srv3, because an expectation rewritten to fit the observation records
// nothing and would have made this divergence invisible.
// ---------------------------------------------------------------------------

// TWO SRV1 ROWS HAD TO BE EDITED TO MOVE ONE FACT, AND THAT IS A REPORTED DEFECT RATHER THAN A
// REPAIRED ONE (2026-08-22). This list and the inline expectations inside fleet_dimm_verdicts
// below are byte-identical copies of the same four expectations, and this list has NO consumer
// anywhere in the corpus -- a grep for its name returns only this declaration. So the live
// reconcile reads the copies, the copies drift independently, and the 2026-08-22 srv1 upgrade
// was landed against the verdict copies while this one kept naming the Hynix part. Review caught
// it; the closure compile could not, because a stale-but-well-typed catalog reference is a data
// disagreement rather than a type error.
//
// NOT DISSOLVED HERE, DELIBERATELY. The construction fix is to derive the verdicts FROM this list
// so srv1 has one row and the drift has no representation (DESIGN 5). That is the right change
// and it is not this one: the module uses no map or pipeline idiom anywhere, so deriving would
// mean introducing one on judgement, and an unconsumed declaration in this corpus may still be
// read by a lens over the Node tree, which a name grep cannot rule out. Both questions want an
// answer before the fork is removed, and neither is answerable from inside this diff.
data fleet_dimm_expectations: List<HostDimmExpectation> = [
  HostDimmExpectation { host: operator_host_srv1, catalog: m393a8g40d40_crb0q_catalog, stick_count: 8 },
  HostDimmExpectation { host: operator_host_srv2, catalog: hma82gr7afr4n_vk_catalog, stick_count: 8 },
  HostDimmExpectation { host: operator_host_srv3, catalog: m393a8g40d40_crb0q_catalog, stick_count: 8 },
  HostDimmExpectation { host: operator_host_srv4, catalog: m393a8g40d40_crb0q_catalog, stick_count: 8 },
]

data srv1_dimm_observation: HostDimmObservation = DimmPopulationObserved {
  host: operator_host_srv1,
  rows: srv1_memory_population.rows,
}

data srv2_dimm_observation: HostDimmObservation = DimmPopulationObserved {
  host: operator_host_srv2,
  rows: srv2_memory_population.rows,
}

data srv3_dimm_observation: HostDimmObservation = DimmPopulationObserved {
  host: operator_host_srv3,
  rows: srv3_memory_population.rows,
}

data srv4_dimm_observation: HostDimmObservation = DimmPopulationObserved {
  host: operator_host_srv4,
  rows: srv4_memory_population.rows,
}

data fleet_dimm_verdicts: List<DimmReconcileVerdict> = [
  dimm_reconcile_verdict(
    expectation: HostDimmExpectation { host: operator_host_srv1, catalog: m393a8g40d40_crb0q_catalog, stick_count: 8 },
    observation: srv1_dimm_observation,
  ),
  dimm_reconcile_verdict(
    expectation: HostDimmExpectation { host: operator_host_srv2, catalog: hma82gr7afr4n_vk_catalog, stick_count: 8 },
    observation: srv2_dimm_observation,
  ),
  dimm_reconcile_verdict(
    expectation: HostDimmExpectation { host: operator_host_srv3, catalog: m393a8g40d40_crb0q_catalog, stick_count: 8 },
    observation: srv3_dimm_observation,
  ),
  dimm_reconcile_verdict(
    expectation: HostDimmExpectation { host: operator_host_srv4, catalog: m393a8g40d40_crb0q_catalog, stick_count: 8 },
    observation: srv4_dimm_observation,
  ),
]

// THE PROCESSOR HALF IS UNOBSERVED ON EVERY HOST. gunbc.fleet_intent's
// fleet_intent_cpu already cites altra_max_m12830_catalog as the fleet
// processor, and every other in-tree consumer agrees with it, but that is a
// modeled intent rather than a per-host reading of what is in the socket. The
// four rows below say so, and they are what a dmidecode -t processor receipt
// dissolves.
