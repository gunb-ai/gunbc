data fleet_physical_inventory_note: String = "SPATIAL-0 owned inventory bindings: extdeps rows cite vendor facts; this module binds allocated PhysicalAssetIdentity and HostIdentity instances to catalog declarations and rack residence. Mounting/shelf/U position stay UNOBSERVED until read or supplied. Amazon order IDs/URLs are procurement provenance, never asset identity. Nominal declared rackmount total 4+4+2+2+1+1 = 14U of 18U is arithmetic on catalog rack_units plus operator-declared 1U shelf for the desktop switch, not an observation. Raspberry Pi catalog identity remains unauthored until exact model/revision is observed."

data operator_site: SiteIdentity = "operator-lab" as SiteIdentity
data rack_01: RackIdentity = "rack-01" as RackIdentity

data operator_physical_site: PhysicalSite = PhysicalSite {
  identity: operator_site,
  racks: [rack_01],
}

