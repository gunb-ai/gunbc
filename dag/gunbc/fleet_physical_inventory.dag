// ---------------------------------------------------------------------------
// THE 64 GiB DIMM LOT: thirty-two sticks, delivered, part number read.
//
// The lot went on the ledger before anybody had read its part number, because
// the supply commitment was real then and a planner that could not see it would
// have kept treating the old populations as the fleet's memory ceiling. THE READ
// OBLIGATION IS NOW DISCHARGED: the sticks arrived, the label was read, and the
// cited catalog row exists, so the catalog identity is CatalogRowExact naming
// extdeps.memory.samsung m393a8g40d40_crb0q_catalog. What the lot still does NOT
// claim is anything nobody has established: the landed cost is LandedCostUnsettled
// because the lot has not settled, and the receipt is ReceiptHeldPrivately per the
// operator's 2026-08-19 ruling that purchase provenance and money are private-tree
// facts. No price and no order identity appear here, and after the landed-cost
// split in product.inventory there is no field for either to hide in.
//
// CatalogRowExact MEANS 'CITED', NOT 'RESOLVED' -- see product.inventory
// catalog_ref_resolution_is_unchecked_note. The DeclarationRef below was checked
// against the tree by hand when it was authored; nothing in the substrate checks
// it, and that stays true until feature:cited-symbol-resolution lands.
//
// THE LEDGER IS NOW BEHIND PHYSICAL REALITY, AND THAT GAP IS DECLARED RATHER
// THAN GUESSED. It still holds exactly one event, LotAcquired, so it reports
// thirty-two units AwaitingReceipt. What actually happened: all thirty-two
// arrived, eight are installed in each of srv1, srv3 and srv4, and srv2's eight
// were installed, failed memory training, and were removed. So the true event
// sequence is a LotReceived, a QuantityQualified, three QuantityInstalled and a
// QuantityRemoved.
//
// THOSE EVENTS ARE NOT AUTHORED HERE, for two reasons that are obligations and
// not preferences. QuantityInstalled requires a PhysicalAssetIdentity per stick;
// the Redfish reads observed eight distinct serials per host but this session did
// not record them, so authoring the event would mean minting identities for
// physical objects whose real identifiers exist and were not captured -- inventing
// what could have been read (DESIGN section 5). And srv2's eight sticks have no
// established disposition: a host that fails training does not make its modules
// defective, so whether they are available spare or quarantined-for-srv2 is an
// operator judgment about parts nobody has retested, not something to infer from
// the host's failure. QuantityQualified's split depends on that same answer.
//
// DISSOLVE-ON: one Redfish read per upgraded host capturing per-DIMM SerialNumber,
// plus an operator disposition for srv2's eight. Until then the per-host figures
// stay an INTENT below, which is what they still are -- the intent was met for
// three hosts and not the fourth, and the ledger says so by being silent rather
// than by asserting a reservation nobody can back.
// ---------------------------------------------------------------------------

data fleet_lot_allocation_seed: InventoryLotAllocator = inventory_lot_allocator_initial()

data dimm_lot_64gib_32x_identity: InventoryLotIdentity = mint_inventory_lot_identity(alloc: fleet_lot_allocation_seed).id

data fleet_lot_allocator_after_dimm_lot: InventoryLotAllocator = mint_inventory_lot_identity(alloc: fleet_lot_allocation_seed).alloc

data dimm_lot_64gib_32x: ProcurementLot = ProcurementLot {
  identity: dimm_lot_64gib_32x_identity,
  receipt: ReceiptHeldPrivately,
  catalog: CatalogRowExact {
    row: DeclarationRef {
      module_path: "extdeps.memory.samsung",
      decl_name: "m393a8g40d40_crb0q_catalog",
      field: WholeDeclaration,
    },
  },
  display_label: "64 GiB DIMM lot, 32 sticks, fleet memory uplift" as NonEmptyStr,
  quantity_acquired: 32,
  landed_cost: LandedCostUnsettled,
}

data dimm_lot_64gib_32x_ledger: List<InventoryEvent> = [
  LotAcquired { lot: dimm_lot_64gib_32x_identity },
]

// The intended destination of the lot, one row per host. This is an INTENT and
// says so in its name: it commits nothing in the ledger, holds no stock, and
// is not consulted by any balance. It exists so the eight-per-host plan is a
// typed fact rather than prose, and it is discharged - not restated - by the
// QuantityReserved events that follow receipt and qualification.
type FleetLotAllocationIntent {
  lot: InventoryLotIdentity
  host: HostIdentity
  intended_quantity: Nat
}

data dimm_lot_64gib_32x_intended_allocation: List<FleetLotAllocationIntent> = [
  FleetLotAllocationIntent { lot: dimm_lot_64gib_32x_identity, host: operator_host_srv1, intended_quantity: 8 },
  FleetLotAllocationIntent { lot: dimm_lot_64gib_32x_identity, host: operator_host_srv2, intended_quantity: 8 },
  FleetLotAllocationIntent { lot: dimm_lot_64gib_32x_identity, host: operator_host_srv3, intended_quantity: 8 },
  FleetLotAllocationIntent { lot: dimm_lot_64gib_32x_identity, host: operator_host_srv4, intended_quantity: 8 },
]

fn intended_allocation_total(rows: List<FleetLotAllocationIntent>) -> Nat {
  if rows.length() == 0 {
    0
  } else {
    match rows.first() {
      Absent => 0
      Present { value: row } => row.intended_quantity + intended_allocation_total(rows: rows.skip(n: 1))
    }
  }
}

// The intent may not promise more sticks than the lot holds. This is a check
// rather than a construction wall, and the honest reason is that the lot and
// the intent rows are separately authored data with no shared constructor to
// seal; the ledger's own over-reservation refusal is the structural wall, and
// it takes effect the moment these intents become reservations.
fn dimm_lot_intent_fits_the_lot() -> Bool {
  intended_allocation_total(rows: dimm_lot_64gib_32x_intended_allocation)
    <= dimm_lot_64gib_32x.quantity_acquired
}
