module gunbc.roadmap_model

import std.types { NonEmptyStr, ContentHash }
import std.content_hash { content_hash_atom, content_hash_combine, content_hash_tagged }
import gunbc.roadmap_status {
  RoadmapItem, DriftVerdict, Signoff, signoff_accepts, signoff_drift,
  TicketFields, line_ticket,
  RedControlEvidence, HandbackEvidence,
  red_control_evidence_satisfied, handback_evidence_satisfied,
}

type RoadmapNodeId = NonEmptyStr where brand("RoadmapNodeId")

type Pointer { label: String, path: String }

type Intricacy
  = IntricacyLow
  | IntricacyMedium
  | IntricacyHigh

type Volume
  = VolumeSmall
  | VolumeMedium
  | VolumeLarge

type Acceptance
  = PrsMerged
  | ManualAcceptance

data roadmap_acceptance_boundary_note: String = "NodeSizing.acceptance names the evidence a worker must return for review; it is not the work item's lifecycle verdict. PrsMerged means a merged PR is the expected implementation artifact, while ManualAcceptance means the evidence is operator-inspected directly. In both cases RoadmapNode.signoff is the separate acceptance step and the only route to completed work. A PR can be merged while its roadmap node remains open for residue or rework."

type NodeSizing
  = Unsized
  | Sized { intricacy: Intricacy, volume: Volume, repo: String, acceptance: Acceptance }

type RoadmapNode {
  node: RoadmapNodeId
  line: RoadmapItem
  carriers: List<Pointer>
  sizing: NodeSizing
  owner: String
  signoff: Signoff
}

type RoadmapEdge {
  child: RoadmapNodeId
  parent: RoadmapNodeId
}

type SectionProse { content: String }
type SectionGroup { label: String, nodes: List<RoadmapNode>, edges: List<RoadmapEdge> }

type SectionElement
  = Prose { prose: SectionProse }
  | Group { group: SectionGroup }

fn section_prose(content: String) -> SectionElement { Prose { prose: SectionProse { content: content } } }
fn section_group(label: String, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> SectionElement {
  Group { group: SectionGroup { label: label, nodes: nodes, edges: edges } }
}

type RoadmapParent
  = TopLevel
  | UnderParent { parent: RoadmapNodeId }

fn under_parent(p: RoadmapNodeId) -> RoadmapParent { UnderParent { parent: p } }
fn top_level() -> RoadmapParent { TopLevel }

data roadmap_dependency_projection_note: String = "RoadmapEdge is the complete dependency DAG. Markdown and HTML are trees, so roadmap_primary_parent selects the first declared dependency for presentation placement only; roadmap_parent_ids preserves every prerequisite for admission and the projections render the complete set whenever there is more than one. Edge order never weakens, prioritizes, or discharges a dependency."

fn roadmap_parent_ids(edges: List<RoadmapEdge>, node: RoadmapNodeId) -> List<RoadmapNodeId> {
  edges |> filter(e => e.child == node) |> map(e => e.parent)
}

fn roadmap_primary_parent(edges: List<RoadmapEdge>, node: RoadmapNodeId) -> RoadmapParent {
  let parents = roadmap_parent_ids(edges: edges, node: node)
  if count(parents) == 0 {
    top_level()
  } else {
    under_parent(p: first(parents))
  }
}

fn is_top_level(edges: List<RoadmapEdge>, node: RoadmapNodeId) -> Bool {
  match roadmap_primary_parent(edges: edges, node: node) {
    TopLevel => true
    UnderParent { parent: _ } => false
  }
}

fn pointer_resolves(p: Pointer, existing_docs: List<String>) -> Bool {
  existing_docs |> any(d => d == p.path)
}

fn node_carrier_clean(rn: RoadmapNode, existing_docs: List<String>) -> Bool {
  all(rn.carriers, p => pointer_resolves(p: p, existing_docs: existing_docs))
}

fn node_status_drift(rn: RoadmapNode, committed_box: Bool, merged: List<Int>) -> DriftVerdict {
  signoff_drift(s: rn.signoff, committed_box: committed_box)
}

fn node_closed(rn: RoadmapNode) -> Bool {
  signoff_accepts(s: rn.signoff)
}

data roadmap_acceptance_receipt_note: String = "Acceptance is a durable typed fact, never row deletion (operator verdict 2026-07-28): before this carrier, accepting a node meant removing its only representation from the active graph, after which a dependent's prerequisite had no acceptance fact to join against and every count was a hand-reconstructed snapshot. A RoadmapAcceptanceReceipt names the node, carries the executed red-control and delivered handback evidence (reusing the #7380 evidence carriers — a receipt without an executed witness or a delivered artifact is unwritable), and pins criteria_digest = roadmap_criteria_digest over the row's own declared brief/red_control/handback. The digest closes the criteria-drift half fail-closed: editing a node's acceptance criteria changes the derived digest, the stored receipt stops matching, and the node returns to the active set while the validity witness reds — an acceptance can never silently survive a criteria rewrite. Merged pull requests never accept: node_accepted consults only receipt rows, and implementation evidence stays review input. REMAINING GAP, counted not implied (same shape as signoff_evidence_note): the witness named inside RedControlExecuted is not mechanically joined to the prose red_control it discharges — any executed witness name satisfies the evidence arm. OWNER: roadmap-runtime; DISSOLVE-ON: TicketFields.red_control becoming a typed reference to its discharging witness, at which point receipt_matches_node derives the join instead of trusting the named pair."

type RoadmapAcceptanceReceipt {
  node: RoadmapNodeId
  criteria_digest: ContentHash
  red_control: RedControlEvidence
  handback: HandbackEvidence
  accepted_by: NonEmptyStr
  accepted_on: NonEmptyStr
}

fn roadmap_criteria_digest(t: TicketFields) -> ContentHash {
  content_hash_tagged(
    tag: "roadmap-acceptance-criteria-v1",
    payload: content_hash_combine(
      left: content_hash_combine(
        left: content_hash_atom(value: t.brief as NonEmptyStr),
        right: content_hash_atom(value: t.red_control as NonEmptyStr),
      ),
      right: content_hash_atom(value: t.handback as NonEmptyStr),
    ),
  )
}

fn node_criteria_digest(rn: RoadmapNode) -> ContentHash? {
  match line_ticket(item: rn.line) {
    Present { value } => Present { value: roadmap_criteria_digest(t: value) }
    Absent => Absent
  }
}

fn receipt_evidence_complete(r: RoadmapAcceptanceReceipt) -> Bool {
  red_control_evidence_satisfied(e: r.red_control)
    && handback_evidence_satisfied(e: r.handback)
}

fn receipt_matches_node(r: RoadmapAcceptanceReceipt, rn: RoadmapNode) -> Bool {
  r.node == rn.node
    && receipt_evidence_complete(r: r)
    && match node_criteria_digest(rn: rn) {
      Present { value } => value == r.criteria_digest
      Absent => false
    }
}

fn receipts_for_node(receipts: List<RoadmapAcceptanceReceipt>, id: RoadmapNodeId) -> List<RoadmapAcceptanceReceipt> {
  receipts |> filter(r => r.node == id)
}

fn node_accepted(receipts: List<RoadmapAcceptanceReceipt>, rn: RoadmapNode) -> Bool {
  let rs = receipts_for_node(receipts: receipts, id: rn.node)
  count(rs) == 1 && all(rs, r => receipt_matches_node(r: r, rn: rn))
}
