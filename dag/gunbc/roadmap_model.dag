module gunbc.roadmap_model


type RoadmapNodeId = std.types.NonEmptyStr where brand("RoadmapNodeId")

data roadmap_node_identity_law: String = "A roadmap node's identity is MINTED, never derived. Slug, title, criteria digest, containment position, dependency neighbourhood, declaration order and file position are FORBIDDEN identity inputs — the law std.occurrence_identity states for occurrences, generalized to an entity that must outlive the graph it is read from.\n\nThe law is reused; the TYPE deliberately is not. std.occurrence_identity.OccurrenceId is an ordinal from a per-graph allocator starting at zero, so it is unique only INSIDE one constructed graph: inserting a node at the front renumbers every node after it, and two concurrent branches mint the same next integer. That is positional identity wearing an allocator's clothes — right for occurrences within one parse, wrong for a work item that must survive edits, reordering, regeneration and independent branches. What occurrence identity deliberately does not claim is PERSISTENCE SCOPE, and that is precisely what a roadmap node needs.\n\nIdentity is a REQUIRED FIELD rather than a side registry keyed by slug. A registry beside the authority leaves a node authorable without identity, detectable only by a later witness — validation standing where construction was available (DESIGN 5), and two authorities that must be kept in step (DESIGN 3). As a field, a node without durable identity is unwritable, and the slug index is DERIVED from the nodes rather than independently authored, so the two can never disagree."

type RoadmapNodeIdentity = std.types.NonEmptyStr where brand("RoadmapNodeIdentity")

type Pointer { label: String, path: String }

type Intricacy
  = IntricacyLow
  | IntricacyMedium
  | IntricacyHigh

type Volume
  = VolumeSmall
  | VolumeMedium
  | VolumeLarge

type Acceptance
  = PrsMerged
  | ManualAcceptance

data roadmap_acceptance_boundary_note: String = "NodeSizing.acceptance names the evidence a worker must return for review; it is not the work item's lifecycle verdict. PrsMerged means a merged PR is the expected implementation artifact, while ManualAcceptance means the evidence is operator-inspected directly. In both cases RoadmapNode.signoff is the separate acceptance step and the only route to completed work. A PR can be merged while its roadmap node remains open for residue or rework."

type NodeSizing
  = Unsized
  | Sized { intricacy: Intricacy, volume: Volume, repo: String, acceptance: Acceptance }

type RoadmapNode {
  identity: RoadmapNodeIdentity
  node: RoadmapNodeId
  line: gunbc.roadmap_status.RoadmapItem
  carriers: List<Pointer>
  sizing: NodeSizing
  execution: gunbc.roadmap_execution_contract.WorkItemExecutionContract
  owner: String
  signoff: gunbc.roadmap_status.Signoff
}

type RoadmapEdge {
  child: RoadmapNodeId
  parent: RoadmapNodeId
}

type SectionProse { content: String }
type SectionGroup { label: String, nodes: List<RoadmapNode>, edges: List<RoadmapEdge> }

type SectionElement
  = Prose { prose: SectionProse }
  | Group { group: SectionGroup }

fn section_prose(content: String) -> SectionElement { Prose { prose: SectionProse { content: content } } }
fn section_group(label: String, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> SectionElement {
  Group { group: SectionGroup { label: label, nodes: nodes, edges: edges } }
}

type RoadmapParent
  = TopLevel
  | UnderParent { parent: RoadmapNodeId }

fn under_parent(p: RoadmapNodeId) -> RoadmapParent { UnderParent { parent: p } }
fn top_level() -> RoadmapParent { TopLevel }

// RoadmapEdge is the complete dependency DAG. Markdown and HTML are trees, so roadmap_primary_parent selects the first declared dependency for presentation placement only; roadmap_parent_ids preserves every prerequisite for admission and the projections render the complete set whenever there is more than one. Edge order never weakens, prioritizes, or discharges a dependency.
fn roadmap_parent_ids(edges: List<RoadmapEdge>, node: RoadmapNodeId) -> List<RoadmapNodeId> {
  edges |> filter(e => e.child == node) |> map(e => e.parent)
}

fn roadmap_primary_parent(edges: List<RoadmapEdge>, node: RoadmapNodeId) -> RoadmapParent {
  let parents = roadmap_parent_ids(edges: edges, node: node)
  if count(parents) == 0 {
    top_level()
  } else {
    under_parent(p: first(parents))
  }
}

fn is_top_level(edges: List<RoadmapEdge>, node: RoadmapNodeId) -> Bool {
  match roadmap_primary_parent(edges: edges, node: node) {
    TopLevel => true
    UnderParent { parent: _ } => false
  }
}

fn pointer_resolves(p: Pointer, existing_docs: List<String>) -> Bool {
  existing_docs |> any(d => d == p.path)
}

fn node_carrier_clean(rn: RoadmapNode, existing_docs: List<String>) -> Bool {
  all(rn.carriers, p => pointer_resolves(p: p, existing_docs: existing_docs))
}

fn node_status_drift(rn: RoadmapNode, committed_box: Bool, merged: List<Int>) -> gunbc.roadmap_status.DriftVerdict {
  gunbc.roadmap_status.signoff_drift(s: rn.signoff, committed_box: committed_box)
}

fn node_closed(rn: RoadmapNode) -> Bool {
  gunbc.roadmap_status.signoff_accepts(s: rn.signoff)
}

data roadmap_acceptance_receipt_note: String = "Acceptance is a durable typed fact, never row deletion (operator verdict 2026-07-28): before this carrier, accepting a node meant removing its only representation from the active graph, after which a dependent's prerequisite had no acceptance fact to join against and every count was a hand-reconstructed snapshot. A RoadmapAcceptanceReceipt names the node, carries the executed red-control and delivered handback evidence (reusing the #7380 evidence carriers — a receipt without an executed witness or a delivered artifact is unwritable), and pins criteria_digest = roadmap_criteria_digest over the row's own declared brief/red_control/handback. The digest closes the criteria-drift half fail-closed: editing a node's acceptance criteria changes the derived digest, the stored receipt stops matching, and the node returns to the active set while the validity witness reds — an acceptance can never silently survive a criteria rewrite. Merged pull requests never accept: node_accepted consults only receipt rows, and implementation evidence stays review input. REMAINING GAP, counted not implied (same shape as signoff_evidence_note): the witness named inside RedControlExecuted is not mechanically joined to the prose red_control it discharges — any executed witness name satisfies the evidence arm. OWNER: roadmap-runtime; DISSOLVE-ON: TicketFields.red_control becoming a typed reference to its discharging witness, at which point receipt_matches_node derives the join instead of trusting the named pair."

type RoadmapAcceptanceReceipt {
  node: RoadmapNodeId
  criteria_digest: std.content_hash.Fnv1a64Structural
  red_control: gunbc.roadmap_status.RedControlEvidence
  handback: gunbc.roadmap_status.HandbackEvidence
  accepted_by: std.types.NonEmptyStr
  accepted_on: std.types.NonEmptyStr
}

fn roadmap_criteria_digest(t: gunbc.roadmap_status.TicketFields) -> std.content_hash.Fnv1a64Structural {
  std.content_hash.content_hash_tagged_structural(
    tag: "roadmap-acceptance-criteria-v1",
    payload: std.content_hash.content_hash_combine_structural(
      left: std.content_hash.content_hash_combine_structural(
        left: std.content_hash.content_hash_atom(value: t.brief as std.types.NonEmptyStr),
        right: std.content_hash.content_hash_atom(value: t.red_control as std.types.NonEmptyStr),
      ),
      right: std.content_hash.content_hash_atom(value: t.handback as std.types.NonEmptyStr),
    ),
  )
}

fn node_criteria_digest(rn: RoadmapNode) -> std.content_hash.Fnv1a64Structural? {
  match gunbc.roadmap_status.line_ticket(item: rn.line) {
    Present { value } => Present { value: roadmap_criteria_digest(t: value) }
    Absent => Absent
  }
}

fn receipt_evidence_complete(r: RoadmapAcceptanceReceipt) -> Bool {
  gunbc.roadmap_status.red_control_evidence_satisfied(e: r.red_control)
    && gunbc.roadmap_status.handback_evidence_satisfied(e: r.handback)
}

fn receipt_matches_node(r: RoadmapAcceptanceReceipt, rn: RoadmapNode) -> Bool {
  r.node == rn.node
    && receipt_evidence_complete(r: r)
    && match node_criteria_digest(rn: rn) {
      Present { value } => std.content_hash.content_hash_eq_structural(left: value, right: r.criteria_digest)
      Absent => false
    }
}

fn receipts_for_node(receipts: List<RoadmapAcceptanceReceipt>, id: RoadmapNodeId) -> List<RoadmapAcceptanceReceipt> {
  receipts |> filter(r => r.node == id)
}

fn node_accepted(receipts: List<RoadmapAcceptanceReceipt>, rn: RoadmapNode) -> Bool {
  let rs = receipts_for_node(receipts: receipts, id: rn.node)
  count(rs) == 1 && all(rs, r => receipt_matches_node(r: r, rn: rn))
}

data acceptance_receipt_continuity_wall_note: String = "THE FAIL-OPEN roadmap_acceptance_receipt_note DECLARES BUT DID NOT CLOSE. Acceptance is a durable typed fact, never row deletion — yet removing a RoadmapAcceptanceReceipt row from the authority silently returned the node to the active set with no refusal. A prior validation slice kept a second hand-maintained baseline_nodes ledger beside roadmap_acceptance_receipts, so deleting both rows stayed green — the dual representation this repository keeps paying for. THIS SLICE LANDS THE CONSTRUCTION ANSWER: roadmap_acceptance_event_history is the single authority; roadmap_acceptance_receipts is a projection only. AcceptanceRecorded appends a receipt; AcceptanceRevoked names the exact prior receipt, a disposition, and audit fields. Replay refuses a vanished recorded receipt without an exact matching revocation, a wrong prior digest, a revocation while the exact receipt is still live, a revocation with nothing live to remove, and duplicate revocations for one removal. A sealed prefix chain digest refuses edits to prior events without updating the pin; witness tests compare prior history to mutated history for the deletion arms."

type AcceptanceNodeReopensActiveFrontier {}

type AcceptanceRevocationDisposition = AcceptanceNodeReopensActiveFrontier

type RoadmapAcceptanceEvent
  = AcceptanceRecorded { receipt: RoadmapAcceptanceReceipt }
  | AcceptanceRevoked {
      exact_prior_receipt: RoadmapAcceptanceReceipt,
      disposition: AcceptanceRevocationDisposition,
      reason: std.types.NonEmptyStr,
      revoked_by: std.types.NonEmptyStr,
      revoked_on: std.types.NonEmptyStr,
    }

type AcceptanceHistoryReplayState {
  live: List<RoadmapAcceptanceReceipt>
  revoked: List<RoadmapAcceptanceReceipt>
  ever_recorded: List<RoadmapAcceptanceReceipt>
}

type AcceptanceHistoryIntegrityVerdict
  = AcceptanceHistoryIntegrityHolds
  | AcceptanceHistoryIntegrityRefusedReplay
  | AcceptanceHistoryIntegrityRefusedVanishedWithoutRevocation {
      receipt: RoadmapAcceptanceReceipt,
    }
  | AcceptanceHistoryIntegrityRefusedPriorPrefix { index: Int }
  | AcceptanceHistoryIntegrityRefusedPriorHistoryObservation { detail: String }

fn red_control_evidence_eq(a: gunbc.roadmap_status.RedControlEvidence, b: gunbc.roadmap_status.RedControlEvidence) -> Bool {
  match a {
    gunbc.roadmap_status.RedControlNotRun =>
      match b {
        gunbc.roadmap_status.RedControlNotRun => true
        gunbc.roadmap_status.RedControlExecuted { witness_module: _, witness_fn: _, executed_on: _ } => false
      }
    gunbc.roadmap_status.RedControlExecuted { witness_module: am, witness_fn: af, executed_on: ao } =>
      match b {
        gunbc.roadmap_status.RedControlNotRun => false
        gunbc.roadmap_status.RedControlExecuted { witness_module: bm, witness_fn: bf, executed_on: bo } =>
          am == bm && af == bf && ao == bo
      }
  }
}

fn handback_evidence_eq(a: gunbc.roadmap_status.HandbackEvidence, b: gunbc.roadmap_status.HandbackEvidence) -> Bool {
  match a {
    gunbc.roadmap_status.HandbackNotDelivered =>
      match b {
        gunbc.roadmap_status.HandbackNotDelivered => true
        gunbc.roadmap_status.HandbackDelivered { first_artifact: _, further_artifacts: _ } => false
      }
    gunbc.roadmap_status.HandbackDelivered { first_artifact: af, further_artifacts: afs } =>
      match b {
        gunbc.roadmap_status.HandbackNotDelivered => false
        gunbc.roadmap_status.HandbackDelivered { first_artifact: bf, further_artifacts: bfs } =>
          af == bf && non_empty_str_list_eq_ordered(a: afs, b: bfs)
      }
  }
}

fn non_empty_str_list_eq_ordered(a: List<std.types.NonEmptyStr>, b: List<std.types.NonEmptyStr>) -> Bool {
  if count(a) != count(b) {
    false
  } else if count(a) == 0 {
    true
  } else {
    first(a) == first(b)
      && non_empty_str_list_eq_ordered(
        a: drop_first_non_empty_str(items: a),
        b: drop_first_non_empty_str(items: b),
      )
  }
}

type DropFirstStrState {
  skipped: Bool
  rest: List<std.types.NonEmptyStr>
}

type DropFirstEventState {
  skipped: Bool
  rest: List<RoadmapAcceptanceEvent>
}

fn drop_first_non_empty_str(items: List<std.types.NonEmptyStr>) -> List<std.types.NonEmptyStr> {
  fold(
    items,
    init: DropFirstStrState { skipped: false, rest: [] },
    f: fn(state, item) {
      if state.skipped {
        DropFirstStrState { skipped: true, rest: concat(state.rest, [item]) }
      } else {
        DropFirstStrState { skipped: true, rest: state.rest }
      }
    },
  ).rest
}

fn acceptance_receipt_eq(a: RoadmapAcceptanceReceipt, b: RoadmapAcceptanceReceipt) -> Bool {
  a.node == b.node
    && std.content_hash.content_hash_eq_structural(left: a.criteria_digest, right: b.criteria_digest)
    && red_control_evidence_eq(a: a.red_control, b: b.red_control)
    && handback_evidence_eq(a: a.handback, b: b.handback)
    && a.accepted_by == b.accepted_by
    && a.accepted_on == b.accepted_on
}

fn acceptance_event_eq(a: RoadmapAcceptanceEvent, b: RoadmapAcceptanceEvent) -> Bool {
  match a {
    AcceptanceRecorded { receipt: ar } =>
      match b {
        AcceptanceRecorded { receipt: br } => acceptance_receipt_eq(a: ar, b: br)
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => false
      }
    AcceptanceRevoked { exact_prior_receipt: apr, disposition: ad, reason: ar, revoked_by: ab, revoked_on: ao } =>
      match b {
        AcceptanceRecorded { receipt: _ } => false
        AcceptanceRevoked { exact_prior_receipt: bpr, disposition: bd, reason: br, revoked_by: bb, revoked_on: bo } =>
          acceptance_receipt_eq(a: apr, b: bpr)
            && match ad {
              AcceptanceNodeReopensActiveFrontier {} =>
                match bd {
                  AcceptanceNodeReopensActiveFrontier {} => true
                }
            }
            && ar == br
            && ab == bb
            && ao == bo
      }
  }
}

fn receipt_present_exact(
  receipts: List<RoadmapAcceptanceReceipt>,
  receipt: RoadmapAcceptanceReceipt,
) -> Bool {
  receipts |> any(r => acceptance_receipt_eq(a: r, b: receipt))
}

fn receipt_live_for_node(
  live: List<RoadmapAcceptanceReceipt>,
  id: RoadmapNodeId,
) -> Bool {
  live |> any(r => r.node == id)
}

fn remove_exact_receipt(
  receipts: List<RoadmapAcceptanceReceipt>,
  receipt: RoadmapAcceptanceReceipt,
) -> List<RoadmapAcceptanceReceipt> {
  receipts |> filter(r => !acceptance_receipt_eq(a: r, b: receipt))
}

fn non_empty_str_list_digest(items: List<std.types.NonEmptyStr>) -> std.content_hash.Fnv1a64Structural {
  fold(
    items,
    init: std.content_hash.content_hash_atom(value: "non-empty-str-list-v1" as std.types.NonEmptyStr),
    f: fn(acc, item) {
      std.content_hash.content_hash_combine_structural(
        left: acc,
        right: std.content_hash.content_hash_atom(value: item),
      )
    },
  )
}

fn red_control_evidence_digest(e: gunbc.roadmap_status.RedControlEvidence) -> std.content_hash.Fnv1a64Structural {
  match e {
    gunbc.roadmap_status.RedControlNotRun =>
      std.content_hash.content_hash_tagged_structural(
        tag: "roadmap-red-control-not-run-v1",
        payload: std.content_hash.content_hash_atom(value: "RedControlNotRun" as std.types.NonEmptyStr),
      )
    gunbc.roadmap_status.RedControlExecuted { witness_module, witness_fn, executed_on } =>
      std.content_hash.content_hash_tagged_structural(
        tag: "roadmap-red-control-executed-v1",
        payload: std.content_hash.content_hash_combine_structural(
          left: std.content_hash.content_hash_combine_structural(
            left: std.content_hash.content_hash_atom(value: witness_module),
            right: std.content_hash.content_hash_atom(value: witness_fn),
          ),
          right: std.content_hash.content_hash_atom(value: executed_on),
        ),
      )
  }
}

fn handback_evidence_digest(e: gunbc.roadmap_status.HandbackEvidence) -> std.content_hash.Fnv1a64Structural {
  match e {
    gunbc.roadmap_status.HandbackNotDelivered =>
      std.content_hash.content_hash_tagged_structural(
        tag: "roadmap-handback-not-delivered-v1",
        payload: std.content_hash.content_hash_atom(value: "HandbackNotDelivered" as std.types.NonEmptyStr),
      )
    gunbc.roadmap_status.HandbackDelivered { first_artifact, further_artifacts } =>
      std.content_hash.content_hash_tagged_structural(
        tag: "roadmap-handback-delivered-v1",
        payload: std.content_hash.content_hash_combine_structural(
          left: std.content_hash.content_hash_atom(value: first_artifact),
          right: non_empty_str_list_digest(items: further_artifacts),
        ),
      )
  }
}

fn acceptance_receipt_digest(receipt: RoadmapAcceptanceReceipt) -> std.content_hash.Fnv1a64Structural {
  std.content_hash.content_hash_tagged_structural(
    tag: "roadmap-acceptance-receipt-v1",
    payload: std.content_hash.content_hash_combine_structural(
      left: std.content_hash.content_hash_combine_structural(
        left: std.content_hash.content_hash_atom(value: receipt.node as std.types.NonEmptyStr),
        right: std.content_hash.content_hash_combine_structural(
          left: receipt.criteria_digest,
          right: red_control_evidence_digest(e: receipt.red_control),
        ),
      ),
      right: std.content_hash.content_hash_combine_structural(
        left: handback_evidence_digest(e: receipt.handback),
        right: std.content_hash.content_hash_combine_structural(
          left: std.content_hash.content_hash_atom(value: receipt.accepted_by),
          right: std.content_hash.content_hash_atom(value: receipt.accepted_on),
        ),
      ),
    ),
  )
}

fn acceptance_revocation_disposition_digest(
  disposition: AcceptanceRevocationDisposition,
) -> std.content_hash.Fnv1a64Structural {
  match disposition {
    AcceptanceNodeReopensActiveFrontier {} =>
      std.content_hash.content_hash_tagged_structural(
        tag: "roadmap-acceptance-reopens-active-frontier-v1",
        payload: std.content_hash.content_hash_atom(value: "AcceptanceNodeReopensActiveFrontier" as std.types.NonEmptyStr),
      )
  }
}

fn acceptance_event_digest(event: RoadmapAcceptanceEvent) -> std.content_hash.Fnv1a64Structural {
  match event {
    AcceptanceRecorded { receipt } =>
      std.content_hash.content_hash_tagged_structural(
        tag: "roadmap-acceptance-recorded-v2",
        payload: acceptance_receipt_digest(receipt: receipt),
      )
    AcceptanceRevoked { exact_prior_receipt, disposition, reason, revoked_by, revoked_on } =>
      std.content_hash.content_hash_tagged_structural(
        tag: "roadmap-acceptance-revoked-v2",
        payload: std.content_hash.content_hash_combine_structural(
          left: acceptance_receipt_digest(receipt: exact_prior_receipt),
          right: std.content_hash.content_hash_combine_structural(
            left: acceptance_revocation_disposition_digest(disposition: disposition),
            right: std.content_hash.content_hash_combine_structural(
              left: std.content_hash.content_hash_atom(value: reason),
              right: std.content_hash.content_hash_combine_structural(
                left: std.content_hash.content_hash_atom(value: revoked_by),
                right: std.content_hash.content_hash_atom(value: revoked_on),
              ),
            ),
          ),
        ),
      )
  }
}

fn acceptance_history_chain_digest(events: List<RoadmapAcceptanceEvent>) -> std.content_hash.Fnv1a64Structural {
  fold(
    events,
    init: std.content_hash.content_hash_atom(value: "roadmap-acceptance-history-v1" as std.types.NonEmptyStr),
    f: fn(acc, event) {
      std.content_hash.content_hash_combine_structural(
        left: acc,
        right: acceptance_event_digest(event: event),
      )
    },
  )
}

fn drop_first_acceptance_event(events: List<RoadmapAcceptanceEvent>) -> List<RoadmapAcceptanceEvent> {
  fold(
    events,
    init: DropFirstEventState { skipped: false, rest: [] },
    f: fn(state, event) {
      if state.skipped {
        DropFirstEventState { skipped: true, rest: concat(state.rest, [event]) }
      } else {
        DropFirstEventState { skipped: true, rest: state.rest }
      }
    },
  ).rest
}

fn acceptance_history_prior_prefix_mismatch_index_at(
  prior: List<RoadmapAcceptanceEvent>,
  current: List<RoadmapAcceptanceEvent>,
  index: Int,
) -> Int {
  if count(prior) == 0 {
    index
  } else if count(current) == 0 {
    index
  } else if !acceptance_event_eq(a: first(prior), b: first(current)) {
    index
  } else {
    acceptance_history_prior_prefix_mismatch_index_at(
      prior: drop_first_acceptance_event(events: prior),
      current: drop_first_acceptance_event(events: current),
      index: index + 1,
    )
  }
}

fn acceptance_history_prior_prefix_mismatch_index(
  prior: List<RoadmapAcceptanceEvent>,
  current: List<RoadmapAcceptanceEvent>,
) -> Int {
  acceptance_history_prior_prefix_mismatch_index_at(prior: prior, current: current, index: 0)
}

fn acceptance_history_extends_prior(
  prior: List<RoadmapAcceptanceEvent>,
  current: List<RoadmapAcceptanceEvent>,
) -> Bool {
  if count(prior) == 0 {
    true
  } else if count(current) < count(prior) {
    false
  } else {
    acceptance_event_eq(a: first(prior), b: first(current))
      && acceptance_history_extends_prior(
        prior: drop_first_acceptance_event(events: prior),
        current: drop_first_acceptance_event(events: current),
      )
  }
}

fn replay_acceptance_event(
  state: AcceptanceHistoryReplayState,
  event: RoadmapAcceptanceEvent,
) -> AcceptanceHistoryReplayState? {
  match event {
    AcceptanceRecorded { receipt } =>
      if receipt_live_for_node(live: state.live, id: receipt.node)
        || receipt_present_exact(receipts: state.live, receipt: receipt) {
        none
      } else {
        Present { value: AcceptanceHistoryReplayState {
          live: concat(state.live, [receipt]),
          revoked: state.revoked,
          ever_recorded: concat(state.ever_recorded, [receipt]),
        } }
      }
    AcceptanceRevoked { exact_prior_receipt, disposition: _, reason: _, revoked_by: _, revoked_on: _ } =>
      if !receipt_present_exact(receipts: state.live, receipt: exact_prior_receipt)
        || receipt_present_exact(receipts: state.revoked, receipt: exact_prior_receipt) {
        none
      } else {
        Present { value: AcceptanceHistoryReplayState {
          live: remove_exact_receipt(receipts: state.live, receipt: exact_prior_receipt),
          revoked: concat(state.revoked, [exact_prior_receipt]),
          ever_recorded: state.ever_recorded,
        } }
      }
  }
}

fn replay_acceptance_history(events: List<RoadmapAcceptanceEvent>) -> AcceptanceHistoryReplayState? {
  fold(
    events,
    init: Present { value: AcceptanceHistoryReplayState {
      live: [],
      revoked: [],
      ever_recorded: [],
    } },
    f: fn(acc, event) {
      match acc {
        Absent => Absent
        Present { value: state } =>
          match replay_acceptance_event(state: state, event: event) {
            Absent => Absent
            Present { value: next } => Present { value: next }
          }
      }
    },
  )
}

fn ever_recorded_receipt_accounted_for(
  receipt: RoadmapAcceptanceReceipt,
  live: List<RoadmapAcceptanceReceipt>,
  revoked: List<RoadmapAcceptanceReceipt>,
) -> Bool {
  receipt_present_exact(receipts: live, receipt: receipt)
    || receipt_present_exact(receipts: revoked, receipt: receipt)
}

fn project_live_acceptance_receipts(history: List<RoadmapAcceptanceEvent>) -> List<RoadmapAcceptanceReceipt> {
  match replay_acceptance_history(events: history) {
    Present { value: state } => state.live
    Absent => []
  }
}

fn acceptance_history_integrity_verdict(
  history: List<RoadmapAcceptanceEvent>,
  prior_history: List<RoadmapAcceptanceEvent>,
) -> AcceptanceHistoryIntegrityVerdict {
  if count(prior_history) > 0 && !acceptance_history_extends_prior(prior: prior_history, current: history) {
    AcceptanceHistoryIntegrityRefusedPriorPrefix {
      index: acceptance_history_prior_prefix_mismatch_index(
        prior: prior_history,
        current: history,
      ),
    }
  } else {
    match replay_acceptance_history(events: history) {
      Absent => AcceptanceHistoryIntegrityRefusedReplay
      Present { value: state } =>
        if !all(
          state.ever_recorded,
          r => ever_recorded_receipt_accounted_for(
            receipt: r,
            live: state.live,
            revoked: state.revoked,
          ),
        ) {
          AcceptanceHistoryIntegrityRefusedVanishedWithoutRevocation {
            receipt: first(
              state.ever_recorded |> filter(r =>
                !ever_recorded_receipt_accounted_for(
                  receipt: r,
                  live: state.live,
                  revoked: state.revoked,
                )
              ),
            ),
          }
        } else {
          AcceptanceHistoryIntegrityHolds
        }
    }
  }
}

fn acceptance_history_integrity_holds(
  history: List<RoadmapAcceptanceEvent>,
  prior_history: List<RoadmapAcceptanceEvent>,
) -> Bool {
  match acceptance_history_integrity_verdict(
    history: history,
    prior_history: prior_history,
  ) {
    AcceptanceHistoryIntegrityHolds => true
    AcceptanceHistoryIntegrityRefusedReplay => false
    AcceptanceHistoryIntegrityRefusedVanishedWithoutRevocation { receipt: _ } => false
    AcceptanceHistoryIntegrityRefusedPriorPrefix { index: _ } => false
    AcceptanceHistoryIntegrityRefusedPriorHistoryObservation { detail: _ } => false
  }
}

fn acceptance_history_integrity_verdict_detail(verdict: AcceptanceHistoryIntegrityVerdict) -> String {
  match verdict {
    AcceptanceHistoryIntegrityHolds => ""
    AcceptanceHistoryIntegrityRefusedReplay =>
      "acceptance history replay refused: event sequence is not replayable"
    AcceptanceHistoryIntegrityRefusedVanishedWithoutRevocation { receipt: receipt } =>
      concat("acceptance receipt vanished without revocation: node=", receipt.node as String)
    AcceptanceHistoryIntegrityRefusedPriorPrefix { index: index } =>
      concat("prior acceptance history prefix mismatch at index ", to_string(index))
    AcceptanceHistoryIntegrityRefusedPriorHistoryObservation { detail: detail } =>
      concat("prior history observation refused: ", detail)
  }
}
