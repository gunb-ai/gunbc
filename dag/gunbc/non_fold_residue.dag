module gunbc.non_fold_residue

import std.keyed_roster { KeyedRosterBuild }
import std.roster_frontier { FrontierRow, FrontierSubject, PathSubject, frontier_units, frontier_rows_keyed_roster_build, frontier_rows_well_formed }

import std.dissolution { DissolutionCondition, unbound_dissolution }
// Single authority for the non-fold-residue roster (DESIGN §6 census; group-of-units re-home per
// gunbc.roster_registry, operator ruling 2026-07-22 — formerly the NON_FOLD_RESIDUE_ROSTER const in
// src/v1/stage0/src/cli_run.rs). Each row asserts a corpus site (a path::fn key) whose match over a
// closed coproduct -- keyed on the scrutinee's INFERRED type, so a parameter, a local binding, a
// field or a call alike -- carries a top-level wildcard arm, with its reason and dissolution
// trigger as typed fields. The site authority is the host's typed walk (cli_run/non_fold_residue.rs
// typed_fallback_arm_walk): the required floor judges it per diff (non_fold_residue_diff_verdict)
// and the whole-corpus census (nfr_whole_corpus_typed_census) derives this roster. Both read these
// rows through non_fold_residue_units_from_module_source, so rows must stay DIRECT record literals
// (a helper-fn call would blind the host reader); walk and reader fold into a pure .dag Node-tree
// lens when compile-graph access lands (gunbc#5364).
// Detection-only: never auto-delete rows — greening a site deletes its row by hand with the receipt
// on the PR.

data non_fold_residue_stale_row_ruling_note: String = "2026-07-20 stale-row-removal receipt (carried over from the Rust const): create_double_init_collapsible and create_effect_is_dedupable were rostered AND declared kernel-permanent in cla_is_kernel_permanent_fn, so the analyzer never reports them as live sites and the rows could only ever count as stale. DESIGN §6 makes the classes mutually exclusive — a non-fold residue is either a named irreducible kernel or un-migrated modeling, there is no third — so a declared kernel must not also carry a burn-down row; the kernel declaration is the authority. Attribution (checked, not assumed): main was already red on non_fold_residue_clean_holds / non_fold_residue_no_unrostered_or_stale before #6848 merged — the scheduled cold falsifier failed exactly those witnesses at 2026-07-20T14:12Z on main at 73eea76dd7 (#6914); per-PR ci stayed green because affected-set selection did not run the corpus-read nfr witnesses for those diffs (the masking class the dated reason strings below describe)."

data nfr_reason_local_tidy: String = "one-special-variant dispatch (LocalTidyCargoFmtCheck special, else the glob fallback), landed with the shell-to-dag bash de-fork (#6751); surfaced by the whole-corpus receipt after per-PR affected-set selection predict-skipped the corpus-read nfr witness at landing time (the masking class); declared so the ratchet re-arms"

data nfr_dissolve_local_tidy: DissolutionCondition = unbound_dissolution(description: "local_tidy_spec's fold migration totals the dispatch and the row deletes")

data nfr_reason_structural_eq_backfill: String = "structural equality (param scrutinee, off-variant wildcard arm returning false) landed unrostered when per-PR affected-set selection predict-skipped the corpus-read nfr witness at landing time (masking class receipted on #6530/#6533; sites from the 2026-07-18 backfill, #6857, and #6582); declared so the ratchet re-arms"

data nfr_dissolve_derived_equality: DissolutionCondition = unbound_dissolution(description: "derived equality from inhabitance lands (dag/std/algebra, DESIGN §3/§4) and the hand equality fold deletes with its row")

data nfr_reason_frontier_probe: String = "#6533 (Wave 2 frontier probe) landed this site unrostered — the nfr witnesses are corpus-read rows the affected-set selection did not run for that diff, so the red surfaced on the next whole-corpus cold sweep (masking class receipted on #6530); declared so the ratchet re-arms"

data nfr_dissolve_frontier_probe: DissolutionCondition = unbound_dissolution(description: "the frontier probe's fold migration totals the match and the row deletes")

data nfr_reason_orch_emit: String = "one-special-variant dispatch (ExprCmdSubst to cmdsubst_assign; every other Expr through the uniform spelling path) — enumerating all Expr variants would clone the general arm; landed with the shell-to-dag P2b/P4 slices (#6573), surfaced on the 2026-07-14 nightly cold sweep (masking receipt 9)"

data nfr_dissolve_orch_emit: DissolutionCondition = unbound_dissolution(description: "emit becomes the backward grammar-row fold (DESIGN §4) and the special case dissolves with the orchestration-emit fold migration")

data nfr_reason_land_red_era: String = "landed unrostered while the gate was red during the land-red-with-local-proof era (revoked 2026-07-12); declared so the ratchet re-arms"

data nfr_dissolve_owning_fold: DissolutionCondition = unbound_dissolution(description: "the owning file's fold migration totals the match and the row deletes")

data nfr_reason_legacy_slice1_bridge: String = "projection over the legacy HostConvergeSlice1HostResult bridge (host_converge_slice1_unit_outcome_to_legacy_result) — off-variant arms reduce to the identity, so enumerating would clone the arm per variant; landed with #7009, surfaced by the scheduled cold falsifier (alert #7032)"

data nfr_dissolve_legacy_slice1: DissolutionCondition = unbound_dissolution(description: "the legacy slice-1 result carrier is deleted in favor of the per-unit outcome model and the rows delete")

data nfr_reason_reaper_oracle: String = "two-axis discriminating predicate (occupant by action) with off-variant wildcard arms returning false — the reaper witnesses' oracle, same shape as the structural-equality rows; landed with #7026, surfaced by the scheduled cold falsifier (alert #7032)"

data nfr_reason_namespace_tree_eq: String = "NamespaceTree structural equality residue (nested off-variant wildcard arm returning false), landed unrostered with effect_grant.dag in #6817 and surfaced when a later branch brought the file into the affected set"

data nfr_reason_structural_eq_mint: String = "structural equality fold (param scrutinee, off-variant wildcard arm returning false) — the eq-row class the dated roster blocks cite as their sibling anchor"

data nfr_reason_mint_era: String = "match over a closed-coproduct param carrying a top-level wildcard arm — un-migrated modeling declared before per-row landing receipts were required (no dated receipt recorded; DESIGN §6: a named irreducible kernel or un-migrated modeling, there is no third)"

data nfr_dissolve_wildcard_total: DissolutionCondition = unbound_dissolution(description: "the site's wildcard arm migrates to a total match — or the fn is declared kernel-permanent in cla_is_kernel_permanent_fn, which forces this row's deletion (DESIGN §6 exclusivity, per non_fold_residue_stale_row_ruling_note) — and the row deletes")
data nfr_reason_fci1_prestate_equal: String = "FCI-1 prestate equality retains inner cross-product wildcard arms for unequal constructors; declared so the non-fold ratchet covers the live instrument site"
data nfr_dissolve_fci1_prestate_equal: DissolutionCondition = unbound_dissolution(description: "a typed equality capability becomes sufficient to compare every AllocationSlotPrestate constructor without duplicated cross-product arms, then this row deletes")
data nfr_reason_native_app_attest_arm_equal: String = "same-constructor equality over AttestationRefusal / AssertionRefusal: the outer match on the owed refusal is exhaustive (a new refusal constructor must be placed there), and each inner off-constructor wildcard answers false; enumerating it is the n-squared cross product (169 arms for AttestationRefusal) cloning one false arm, and comparing the name projections instead is wrong because those names carry payload text"
data nfr_dissolve_native_app_attest_arm_equal: DissolutionCondition = unbound_dissolution(description: "a typed constructor-equality capability (derived from inhabitance, dag/std/algebra) can compare AttestationRefusal and AssertionRefusal by arm without cross-product arms, then these rows delete")


data nfr_reason_floor_discovery_transport: String = "typed transport-state projection: the observation coproduct's non-applicable variants share one located refusal arm at each phase; enumerating them would duplicate the same wrong-phase refusal rather than add semantic coverage. Declared with the transport boundary so the ratchet remains armed."

data nfr_dissolve_floor_discovery_transport: DissolutionCondition = unbound_dissolution(description: "generated transport realization derives wrong-phase refusal from the observation-state partition and the shared arms become named total cases; the row deletes with the hand-Rust transport scaffold")

data nfr_reason_trait_derive_shape_table: String = "trait-shape→derive-trait capability table (nested match on ReprGroundingDeriveElemShape × ReprGroundingDeriveTrait with off-trait wildcard arms returning false) landed with Gate-1 sub-wall #2 predicate scaffold (#7174); surfaced by whole-corpus nfr receipt after affected-set predict-skipped corpus-read witness at landing"

data nfr_reason_native_agreement_octet: String = "RuntimeValue primitive-discriminant projection (RuntimePrimitive arm extracts byte[1]; off-variant wildcard Absent) landed with Lane B native-agreement loudness (#7111); surfaced by whole-corpus nfr receipt after affected-set predict-skipped corpus-read witness at landing"

data nfr_dissolve_native_agreement_octet: DissolutionCondition = unbound_dissolution(description: "RuntimeValue model↔realization grounds each primitive variant and the wildcard arm migrates to a total match — or the receipt formatter derives from inhabitance and the row deletes")

data nfr_reason_observation_hold_cause: String = "the CI-log renderer names the two memory-pressure holds (PsiPressure, CurrentHighWater — the crawl-window narrative) with a specific cause and gives the other five SchedulerHold variants a generic 'blocked on scheduler admission'; landed with the progress-and-observation stack (session/sleek-ibex-634, #7168) and surfaced by the whole-corpus nfr receipt after per-PR affected-set selection predict-skipped the corpus-read nfr witness at merge time (the masking class); declared so the ratchet re-arms"

data nfr_reason_resolve_realization_predicate: String = "discriminating subset predicate over ResolveRealization (param scrutinee, off-variant wildcard arm returning false) — each arms an independent RED control in floor_resolve_realization_witness_test.dag; landed with #7810 resolve-realization 0B obligation model and surfaced by the whole-corpus nfr receipt; declared so the ratchet re-arms"

data nfr_reason_cost_loop_zero_body_fold: String = "C1 zero-body summation fold over CostExpr (zero-valued CostConst collapses before binder-carrying CostSum construction; the wildcard arm is the non-degenerate summation path, not anonymous recursion) — landed with v2.lens.cost.expr carrier; surfaced by whole-corpus nfr receipt on first CI run"

data nfr_reason_cost_expr_zero_absorbing_compose: String = "zero-absorbing CostExpr composition (zero-valued CostConst is the identity for sequential add and parallel max; nested wildcard arms are the non-degenerate CostAdd/CostMax construction path, not anonymous recursion) — landed with v2.lens.cost.expr cost_expr_seq/cost_expr_par for C2 ComplexitySummary composition; surfaced by whole-corpus nfr receipt on first CI run"

data nfr_reason_cost_valuation_zero_annihilator: String = "Zero-annihilator discrimination in the C1 exact evaluator: the arms separate an ExactCost carrying Zero from every other CostEvaluation on BOTH operands, so the wildcard is a nested-VALUE discrimination and not a variant sweep — CostEvaluation has exactly two variants and the other two matches in this module were made exhaustive rather than rostered when this row was written. Enumerating it would mean writing the residual combine_evaluation call once per surviving shape, which is the redundancy DESIGN §2 forbids rather than the totality DESIGN §4 asks for, and it would put a duplicated expression underneath an arm ORDER that multiply_evaluations_zero_note declares load-bearing: the annihilator is checked before refusal-dominance, so refusal times zero answers exact zero. A later tidy that flattens these arms silently restores the defect the function exists to fix. Declared at landing with the two-sided annihilator fix, not surfaced by a later cold sweep, so the ratchet arms with the code."

data nfr_reason_provider_terminal_absorb: String = "terminal-state absorption over the provider/worker observation coproducts: the arm names each TERMINAL variant (ProviderCompleted / ProviderFailed / ProviderBudgetSpent / ProviderEventsRefused, or WorkerProcessRunning) and gives every non-terminal variant one shared arm, because those variants reduce to the identical behaviour — enumerating them would clone the arm per variant, which is the redundancy DESIGN §2 forbids rather than the totality DESIGN §4 asks for. Landed with the Codex dispatch and recursive workflow evidence slice; declared at landing (not surfaced by a later cold sweep) so the ratchet arms with the code."

data nfr_dissolve_provider_terminal_absorb: DissolutionCondition = unbound_dissolution(description: "ProviderExecutionState and WorkerProcessEvidence carry a DERIVED terminality projection from inhabitance (dag/std/algebra, DESIGN §3/§4 — the same move as derived equality), so these folds match on the partition rather than on the variant list, the shared arm becomes a named case instead of a wildcard, and the rows delete.")

data nfr_reason_verification_producer_absent: String = "NOT terminal-state absorption, which is why this row carries its own reason rather than the shared provider one it first landed under: verification_segment has no terminal arm to absorb into, because Verify has no authoritative receipt producer yet. Every arm — including ProviderCompleted — answers WorkflowSegmentPending, so the match selects only the operator-facing detail string and decides no behaviour. Enumerating the remaining provider variants would clone a Pending arm per variant. The Pending-on-agent-success arm is the deliberate DESIGN §5 refusal to fabricate a verification fact from provider evidence, and it is load-bearing until the producer exists."

data nfr_dissolve_verification_producer_absent: DissolutionCondition = unbound_dissolution(description: "the Verify receipt producer lands: the WorkItemExecutionContract's ModeledValidationCommand runs in the attempt worktree against one immutable candidate revision and persists a receipt, at which point this function folds over that receipt instead of over provider state, its arms carry distinct WorkflowSegmentStates, and the row deletes. It does NOT dissolve on the derived-terminality projection that clears its four siblings — a terminality partition over ProviderExecutionState leaves every arm answering Pending.")

data nfr_reason_work_provider_local_typed_argv_cutover: String = "unit-termination and unit-lifecycle residue in work_provider_local.dag (match arms the residue checker classifies as wildcard over the closed UnitPopulation / SystemdRunWaitSummary coproducts) predates the typed-argv cutover; that cutover's diff touched the module, so the diff-scoped residue scan now requires these sites rostered — declared so the ratchet re-arms"

data nfr_dissolve_work_provider_local_typed_argv_cutover: DissolutionCondition = unbound_dissolution(description: "the four sites' matches are spelled exhaustively over their closed coproducts (every variant named, no catch-all) in a change that edits work_provider_local.dag — the rows delete with that change")

data nfr_reason_dispatch_selection_routing: String = "provider-selection routing residue (match on ProviderSelectionRequest, ProviderOffer, or ResolvedProviderSelection with off-shape wildcard refusal or false arms) landed with Slice A dispatch_selection.dag; declared at landing so the ratchet re-arms"

data nfr_dissolve_dispatch_selection_routing: DissolutionCondition = unbound_dissolution(description: "total matches over the closed selection request and offer coproducts land and the wildcard arms migrate to named variants — rows delete with that fold")

data nfr_reason_provider_standing_limit_draw: String = "dispatch-scoped limit relevance folds (match on ProviderLimitDispatchDraw × ProviderLimitSubject and LimitRejected carve-outs with wildcard arms routing off-shape subjects) landed with provider_standing authority #7926; declared at landing so the ratchet re-arms"

data nfr_dissolve_provider_standing_limit_draw: DissolutionCondition = unbound_dissolution(description: "cited model-to-native-token joins land per provider gap notes and limit_subject_covers_dispatch_draw becomes a total match — rows delete with that fold")

data nfr_reason_binding_outcome_resolution_wildcard: String = "StructuralBindingResolution admission projection (StructuralBindingResolved arm extracts binding_outcome; off-variant wildcard Absent collapses six typed index-build refusal variants into option-absence) landed with N3-A carrier move (#7772); un-migrated modeling at assess_reference_binding_observation — the carrier distinguishes refusals but binding_outcome_from_resolution still absorbs them; declared at landing so the ratchet re-arms"

data nfr_dissolve_binding_outcome_resolution_wildcard: DissolutionCondition = unbound_dissolution(description: "assess_reference_binding_observation routes each StructuralBindingResolution variant to a distinct capability assessment without Absent collapse — total match lands with P0-2 factual carrier recut and the wildcard arm deletes with its row")

data nfr_reason_content_hash_structural_refusal: String = "ContentHash family structural filter at SourceRef list digest boundary (PR #7762): only Fnv1a64Structural participates in population digest; other family arms refuse as SourceRefContentHashStructuralNonFnv1a64 rather than silently coercing cross-family hashes. Declared at landing so the ratchet re-arms."

data nfr_dissolve_content_hash_structural_refusal: DissolutionCondition = unbound_dissolution(description: "SourceRef digest construction grounds each ContentHash family at inhabitance and the wildcard arm becomes a total match — row deletes with that fold (std.content_hash family grounding)")

data nfr_reason_arrow_body_form_eval_runtime_equals: String = "arrow_body_form_eval_runtime_int_equals matches RuntimeValue with an off-variant wildcard arm returning false for witness-side integer equality checks against eval output; landed with ArrowBodyForm semantic helpers; declared at landing so the ratchet re-arms"

data nfr_dissolve_arrow_body_form_eval_runtime_equals: DissolutionCondition = unbound_dissolution(description: "RuntimeValue projection for eval witnesses becomes a total match over inhabited primitive carriers and the wildcard arm deletes with that fold")

data nfr_reason_class_b_binding_projection: String = "Class B declared-import-closure observation projection (match on DeclaredImportClosureBindingObservation with off-variant wildcard refusal arms) landed with #7835 observe_declared_import_closure_symbol_binding builtin; callers judge ListedImport vs PoolCoincidence vs refusal — the match is the typed verdict fold over the host observation carrier, not business policy; declared at landing so the ratchet re-arms"

data nfr_reason_release_identity_absent_split: String = "one-special-variant split over RunningReleaseUnidentifiedCause: ReleaseRevisionAbsent answers ProcessIdentityAbsent because a process predating the identity channel is a MIGRATION state, and the other nine causes answer ProcessIdentityMalformed because a live channel carrying something that is not an identity is a DEFECT in the deploying machinery. The nine share one arm because they already differ where it matters — running_release_unidentified_detail names each cause before the match runs, so the arm carries the distinction rather than erasing it, and enumerating the nine would clone one arm nine times (the DESIGN §2 redundancy, not the DESIGN §4 totality). Landed with Phase A release-identity readiness; declared at landing so the ratchet arms with the code."

data nfr_dissolve_release_identity_absent_split: DissolutionCondition = unbound_dissolution(description: "the migration arm becomes unreachable once the identity-publishing release is deployed everywhere routed, at which point ReleaseRevisionAbsent is the executing RED control rather than a live arm; the split then folds into a derived migration-vs-defect partition over RunningReleaseUnidentifiedCause (the same derived-from-inhabitance move that clears the terminal-absorption rows) and this row deletes with it.")

data nfr_dissolve_class_b_binding_projection: DissolutionCondition = unbound_dissolution(description: "the observation carrier's verdict partition becomes derived from inhabitance (total match over BindingObserved vs BindingNotRunnable and over UnlistedImportBindingSource) and the wildcard arms delete with their rows")

data nfr_reason_pool_independence_projection: String = "ReferenceDerivedDependencyProjection pool-independence comparison harness (match on Ready vs BindingRefused vs FileRefused with off-variant wildcard arms returning RefusalOutcomeMismatch or false) landed with N3-C #7996; the outer match partitions the clause-(e) carrier for baseline-vs-perturbed equality, not business policy; declared at landing so the ratchet re-arms"

data nfr_dissolve_pool_independence_projection: DissolutionCondition = unbound_dissolution(description: "ReferenceDerivedDependencyProjection carrier equality becomes derived from inhabitance (total match over Ready, BindingRefused, and FileRefused with named refusal arms, or a single std projection-equality carrier) and the wildcard arms delete with their rows")



data nfr_reason_collision_population_predicate: String = "subset predicate over CollisionPopulation (PoolMeasured answers true; the off-variant wildcard answers false for WholeTreeUpperBound, the coproduct's only other arm) — the same shape as the resolve-realization predicate rows; landed with the emit-summary-map consumer partition (#8850, 2026-08-22) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_reason_git_text_observation_projection: String = "one-variant extraction over GitTextObservation: GitTextObserved yields its text and the wildcard arm is GitTextUnreadable, projected to the empty string (git_text_or_empty) or to none (git_text_value), dropping the refusal's operation, exit code and stderr at the helper. git_text_value is the discriminator repository_prestate_fault and the post-state fold use to REFUSE an unreadable head or reflog with git_text_refusal_detail, so at repository_convergence_compare the empty arm is construction-unreachable; at the observed_head receipt site it renders an unreadable head as empty text. Landed with the convergence-correctness slice (#9555, 2026-08-28) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_dissolve_git_text_observation_projection: DissolutionCondition = unbound_dissolution(description: "the convergence fold carries a refined observed-text carrier past the pre-state fault check (a String proven present by construction, never a GitTextObservation re-projected), so git_text_or_empty has no caller and deletes, and git_text_value becomes a total two-arm match or a std optional projection derived from the coproduct — the rows delete with that fold")

data nfr_reason_build_projection_fold_step: String = "accumulator fold step over a Derived | Empty | Refused projection coproduct (CashProjection, BasisProjection, ConstructibleCeiling): the outer match on the accumulator short-circuits the Refused arm and the wildcard is the two non-refused arms continuing the fold; a nested match on the same accumulator separates the running-Derived arm from the first derivation with a second wildcard. Enumerating the non-refused arms would clone the fold body once per arm (the DESIGN §2 redundancy, not the DESIGN §4 totality). Landed with I-3 inventory-aware build fulfillment (#8543, 2026-08-19) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_dissolve_build_projection_partition: DissolutionCondition = unbound_dissolution(description: "the three projection coproducts carry a derived refused-vs-open partition from inhabitance (dag/std/algebra, DESIGN §3/§4 — the same move as derived terminality), or the folds run over a std short-circuiting refusal carrier, so each step matches on the partition rather than the variant list, the wildcard arms become named cases, and the rows delete")

data nfr_reason_build_axis_reading_unreachable_arm: String = "axis-reading projection over CashProjection and ConstructibleCeiling: the Derived arm yields its magnitude and the wildcard answers a zero magnitude for the empty arm (CashNoPurchaseLines is a genuine zero; CeilingUnconstrainedByAnyLine is declared a missing input by ceiling_missing) and for the Refused arm, which candidate_missing_inputs has already declared missing, so the refused reading is construction-unreachable at the only caller (per the in-file note above cash_reading) rather than a fabricated zero. Landed with I-3 inventory-aware build fulfillment (#8543, 2026-08-19) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_dissolve_build_axis_reading_refined_carrier: DissolutionCondition = unbound_dissolution(description: "BuildCandidate carries its cash and ceiling on a refined Derived-only carrier once candidate_missing_inputs has admitted it (illegal states unrepresentable at the reading), so the readings match totally over the refined carrier and the unreachable arms delete with their rows")

data nfr_reason_json_natural_projection: String = "one-variant decode over JsonValue: JsonNumber has its lexeme parsed and round-trip checked as a non-negative Int and the wildcard collapses the other five JSON shapes (null, bool, string, array, object) into option-absence, so a shape mismatch and a malformed number are indistinguishable to the caller — the same absence-collapse shape as the binding_outcome_from_resolution row. Landed with the reference-vocabulary keying cut (#9408, 2026-08-27) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_dissolve_json_natural_projection: DissolutionCondition = unbound_dissolution(description: "typed JSON member decoding lands in the JSON language authority (extdeps.languages.json) with a per-shape refusal carrier, so the envelope reads a natural through a total decode rather than a hand match over JsonValue, and the row deletes with that decoder")

data nfr_reason_process_port_upsert_refusal_split: String = "one-special-variant split over ProcessPortObservation: PortObservationRefused threads the observe-leg reason into an Upsert Refuse decision, and the three non-refused arms (PortAbsent, PortObserved, PortObservedStaleExpected) share one arm that derives the decision from the verdict classify_process_port already computed exhaustively over the same coproduct — the second match re-discriminates a value the first fold has already partitioned. The refused arm and its wildcard landed with the NBD-proxy observe-side read-back (74b9a6e6a5, #8582, 2026-08-19; the fn itself dates from #6171) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_dissolve_process_port_upsert_refusal_split: DissolutionCondition = unbound_dissolution(description: "classify_process_port returns a carrier that already binds the refusal reason to its verdict (verdict and decision from ONE total fold over ProcessPortObservation), so classify_process_port_upsert no longer re-matches the observation and the row deletes with the second match")

data nfr_reason_acceptance_obligation_partition: String = "front-end-vs-back-end partition over DagStageObligation (eight arms): execute_obligation names the four back-end stages and routes the four front-end obligations through one wildcard StageNotRun/ExecutorUnavailable arm because they execute inside the staged front-end fold; is_front_end_obligation is the subset predicate (off-variant wildcard false); obligation_front_end_depth gives ResolveStage and every back-end obligation one shared depth. Each wildcard is the OTHER half of one partition, so enumerating it would clone one arm four or five times (the DESIGN §2 redundancy, not the DESIGN §4 totality). Landed with the .dag acceptance harness (#8821, 2026-08-21) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_dissolve_acceptance_obligation_partition: DissolutionCondition = unbound_dissolution(description: "DagStageObligation carries a derived front-end/back-end partition from inhabitance — a total projection onto staged_front_end.FrontEndStage? that is the single authority for which obligations the front-end fold owns — so the three matches fold over the partition rather than the variant list, the wildcard arms become named cases, and the rows delete")

data nfr_reason_acceptance_obligation_eq: String = "structural equality over DagStageObligation (obligation_eq): the three claim-carrying arms compare their claim identities through nested matches with off-variant wildcard false arms, and the outer wildcard compares discriminants for the five unit arms — the eq-row class the structural-equality rows above name, landed with the .dag acceptance harness (#8821, 2026-08-21) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_reason_acceptance_row_projection: String = "one-variant label extraction over StageExecution (five arms): each projection names the arm it reads (StageRejected, StagePassedWithFrontier, or StageUndecided plus StageNotRun) and gives every other arm one wildcard Absent; row_unfinished_label additionally matches StageNotRunReason with NotRequiredByContract absent and every other reason present through a nested wildcard. Enumerating the off-variant arms would clone Absent per arm (the DESIGN §2 redundancy, not the DESIGN §4 totality). Landed with the .dag acceptance harness (#8821, 2026-08-21) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_dissolve_acceptance_row_projection: DissolutionCondition = unbound_dissolution(description: "StageExecution carries a derived outcome partition from inhabitance (passed / rejected / unfinished, with StageNotRunReason partitioned into not-required vs unfinished) so each label projection folds over the partition with a named arm per class, and the rows delete with the wildcard arms")

data nfr_reason_acceptance_verdict_append: String = "one-variant append over DagAcceptanceVerdict (three arms): verdict_with_further_rejection extends AcceptanceContractRejected and verdict_with_further_unfinished extends AcceptanceContractIncomplete, each returning the other two verdicts unchanged through one wildcard identity arm. Landed with the .dag acceptance harness (#8821, 2026-08-21) unrostered and surfaced by the whole-corpus nfr receipt (cli_run nfr_roster_receipt) on 2026-08-29; declared so the ratchet re-arms"

data nfr_dissolve_acceptance_verdict_append: DissolutionCondition = unbound_dissolution(description: "the verdict is assembled once from the receipt's derived outcome partition (first and further labels computed together) rather than appended one label at a time, so the two append fns have no caller and delete with their rows — or the two matches become total over the three verdict arms")

data nfr_reason_generated_workflow_provenance_projection: String = "subset projection over GeneratedArtifact: the three workflow artifact identities carry provenance and every non-workflow artifact shares one Absent arm. Enumerating the non-workflow variants would copy a live population beside the generated-artifact commit-policy registry. The production join in generated_artifact_emit refuses GeneratedWorkflowProvenanceHeaderNotApplicable whenever artifact_commit_policy says GithubActionsWorkflow, so omission on a future workflow admission is refused even though the inconsistent pair remains writable in the two authorities. This join does not adjudicate whether a present projected generator agrees with the actual producer; that disagreement class remains open until the projection is fused with generation. Declared when the required nfr_roster_receipt first exercised the new projection on #9954, so the ratchet re-arms with the site."

data nfr_dissolve_generated_workflow_provenance_projection: DissolutionCondition = unbound_dissolution(description: "the generated-artifact registry admission for GithubActionsWorkflow carries provenance fused with its generating dispatch, so the artifact-visible citation is derivable only from the actual producer and neither an omitted nor a disagreeing provenance row is constructible; emission consumes that refined workflow-artifact declaration without projecting from the full GeneratedArtifact coproduct, and this wildcard match deletes with its row")

data nfr_reason_concurrent_divergence_repair_policy: String = "repair-policy dispatch over GeneratedArtifact: DesignRungDropsArtifact answers HealRegeneratesAfterProvisionalMerge and every other artifact shares one AuthorRegeneratesBeforeMerge arm, including DesignFailureModesArtifact (NotCommitted as of gunbc#10822) — enumerating the registry variant by variant would clone that arm per row, which is the redundancy DESIGN §2 forbids rather than the totality DESIGN §4 asks for, and it would make every new artifact edit this match. UN-MIGRATED MODELING, not a named irreducible kernel: the remaining heal subject is a MODELLED property — an append-only committed projection whose rows several lanes extend concurrently — and the policy is derivable from that property rather than from artifact identity; the identity list stands only because the property is not declared yet. Landed with the heal-delegated ledger regeneration (gunbc#10302); heal population narrowed to the rung-drop ledger when the failure-mode projection left git (gunbc#10822); declared at landing so the ratchet arms with the code."

data nfr_dissolve_concurrent_divergence_repair_policy: DissolutionCondition = unbound_dissolution(description: "GeneratedArtifact carries a declared concurrent-append property per artifact (the ledger-shaped projections that several lanes extend between merges), concurrent_divergence_repair folds over that property instead of over the variant list, the shared arm becomes a named case rather than a wildcard, and this row deletes.")

// The census these rows answer covers the TYPED population: every match whose scrutinee's
// inferred type is a closed coproduct, in every non-test module the checker types. A module
// carrying a blocking diagnostic is uncounted; that bound is stated on this roster's registration
// in gunbc.roster_registry, so an empty delta is not a claim about every closed-coproduct wildcard.
data nfr_reason_typed_census_ca5ed1724b: String = "a top-level wildcard arm over a closed coproduct found by the whole-corpus TYPED census at main ca5ed1724b (#12610's joint landing; nfr_whole_corpus_typed_census, srv1, 2026-10-02). The typed walk keys on the scrutinee's inferred type, so it sees the local-binding, field and call scrutinees the deleted parameter-keyed scan never could; these sites predate the walk and are un-migrated modeling (DESIGN §6), rostered so the ratchet arms at unrostered=0"

data nfr_reason_typed_census_undetermined_node_kind: String = "the v1 checker leaves this match's scrutinee untyped -- a .kind read on a v2.std.node Node -- so the typed census reported it undetermined; read by hand the scrutinee is NodeKind = TypeNode | ComputationNode, a closed coproduct, and the wildcard arm answers for the constructors and connectives the match does not name, which is non-fold residue. Rostered on that reading: a bet the re-census confirms once the checker types the field"

data nfr_reason_landed_after_typed_census: String = "a top-level wildcard arm over a closed coproduct that landed on main after the ca5ed1724b typed census, while that census's roster was still in review (#12980); the floor's diff-scoped typed walk named it on the roster PR's own run. Un-migrated modeling (DESIGN §6), rostered so the ratchet stays armed at unrostered=0"

data nfr_reason_eval_projection_receiver_not_aggregate: String = "field projection at eval: RuntimeAggregate is the one RuntimeValue variant that carries named fields, and every other variant refuses with the same located eval_rejected_projection_receiver_not_aggregate; enumerating them would clone one refusal arm per variant. Landed with gunbc#12506's field-projection eval route; declared at landing so the ratchet arms with the code"

data nfr_dissolve_eval_projection_receiver_not_aggregate: DissolutionCondition = unbound_dissolution(description: "RuntimeValue exposes a typed field-bearing projection (derived from its declaration, dag/std/algebra) so eval reads fields without a per-variant match, and this row deletes")

