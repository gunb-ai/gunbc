module gunbc.non_fold_residue

import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.roster_frontier { FrontierRow, PathSubject }
// Vocabulary consumed HERE: the stated std/extdeps exception list below, plus
// gunbc-layer modules that import these names. v2 subject modules that must not
// pull this file into an emit closure copy the same class strings locally
// (parent: no std/extdeps→gunbc import; shared ledger idents must not move into
// std). Each such module holds `data non_fold_residue_frontier` of DIRECT record
// literals beside the sites those rows name.
// Discovery: the host reader (cli_run/non_fold_residue.rs) walks production `.dag` files,
// keeps those whose source declares `data non_fold_residue_frontier`, and parses only those;
// a row whose PathSubject.path
// file prefix is not the file that hosts the decl is refused, located. The required floor
// judges sites per diff (non_fold_residue_diff_verdict); the whole-corpus census
// (nfr_whole_corpus_typed_census) derives the union. Walk and reader fold into a pure .dag
// Node-tree lens when compile-graph access lands (gunbc#5364).
// Detection-only: never auto-delete rows — greening a site deletes its row by hand with the
// receipt on the PR. v1 seed-reader change is admissible because it unblocks residue
// burn-down for the v2 program.

data nfr_reason_namespace_tree_eq: String = "NamespaceTree structural equality residue (nested off-variant wildcard arm returning false), landed unrostered with effect_grant.dag in #6817 and surfaced when a later branch brought the file into the affected set"

data nfr_dissolve_derived_equality: DissolutionCondition = unbound_dissolution(description: "derived equality from inhabitance lands (dag/std/algebra, DESIGN §3/§4) and the hand equality fold deletes with its row")

data nfr_reason_land_red_era: String = "landed unrostered while the gate was red during the land-red-with-local-proof era (revoked 2026-07-12); declared so the ratchet re-arms"

data nfr_dissolve_owning_fold: DissolutionCondition = unbound_dissolution(description: "the owning file's fold migration totals the match and the row deletes")

data nfr_reason_structural_eq_mint: String = "structural equality fold (param scrutinee, off-variant wildcard arm returning false) — the eq-row class the dated roster blocks cite as their sibling anchor"

data nfr_reason_provider_terminal_absorb: String = "terminal-state absorption over the provider/worker observation coproducts: the arm names each TERMINAL variant (ProviderCompleted / ProviderFailed / ProviderBudgetSpent / ProviderEventsRefused, or WorkerProcessRunning) and gives every non-terminal variant one shared arm, because those variants reduce to the identical behaviour — enumerating them would clone the arm per variant, which is the redundancy DESIGN §2 forbids rather than the totality DESIGN §4 asks for. Landed with the Codex dispatch and recursive workflow evidence slice; declared at landing (not surfaced by a later cold sweep) so the ratchet arms with the code."

data nfr_dissolve_provider_terminal_absorb: DissolutionCondition = unbound_dissolution(description: "ProviderExecutionState and WorkerProcessEvidence carry a DERIVED terminality projection from inhabitance (dag/std/algebra, DESIGN §3/§4 — the same move as derived equality), so these folds match on the partition rather than on the variant list, the shared arm becomes a named case instead of a wildcard, and the rows delete.")

data nfr_reason_typed_census_ca5ed1724b: String = "a top-level wildcard arm over a closed coproduct found by the whole-corpus TYPED census at main ca5ed1724b (#12610's joint landing; nfr_whole_corpus_typed_census, srv1, 2026-10-02). The typed walk keys on the scrutinee's inferred type, so it sees the local-binding, field and call scrutinees the deleted parameter-keyed scan never could; these sites predate the walk and are un-migrated modeling (DESIGN §6), rostered so the ratchet arms at unrostered=0"

// STATED EXCEPTION (condition 1): these seven std/extdeps subjects cannot import this
// module, and their reason/dissolution idents are shared ledger vocabulary that must not
// move into std. Their rows live here. Every other row stays in its subject module.
// Membership of the enrolled roster name is this list union the host scan of subject-module
// `data non_fold_residue_frontier` lists.
data non_fold_residue_frontier: List<FrontierRow> = [
  FrontierRow {
      subject: PathSubject { path: "dag/extdeps/git.dag::git_diff_name_status_pending_after_status" },
      reason: nfr_reason_land_red_era,
      dissolution: nfr_dissolve_owning_fold,
    },
  FrontierRow {
      subject: PathSubject { path: "dag/extdeps/languages/markdown.dag::md_nested" },
      reason: nfr_reason_land_red_era,
      dissolution: nfr_dissolve_owning_fold,
    },
  FrontierRow {
      subject: PathSubject { path: "dag/extdeps/linux/proc_self_cgroup.dag::unified_membership_outcome_tag_eq" },
      reason: nfr_reason_structural_eq_mint,
      dissolution: nfr_dissolve_derived_equality,
    },
  FrontierRow {
      subject: PathSubject { path: "dag/extdeps/tools/ldd.dag::ldd_reading_of" },
      reason: nfr_reason_typed_census_ca5ed1724b,
      dissolution: nfr_dissolve_owning_fold,
    },
  FrontierRow {
      subject: PathSubject { path: "dag/std/effect_grant.dag::namespace_tree_eq" },
      reason: nfr_reason_namespace_tree_eq,
      dissolution: nfr_dissolve_derived_equality,
    },
  FrontierRow {
      subject: PathSubject { path: "dag/std/effects.dag::key_source_eq" },
      reason: nfr_reason_structural_eq_mint,
      dissolution: nfr_dissolve_derived_equality,
    },
  FrontierRow {
      subject: PathSubject { path: "dag/std/occurrence_binding_candidates.dag::declaration_exposure_eq" },
      reason: nfr_reason_structural_eq_mint,
      dissolution: nfr_dissolve_derived_equality,
    },
  FrontierRow {
      subject: PathSubject { path: "dag/std/occurrence_binding_candidates.dag::section13_population_law_id_eq" },
      reason: nfr_reason_structural_eq_mint,
      dissolution: unbound_dissolution(description: "DISSOLVE-ON: Section13PopulationLawId equality becomes derived from inhabitance (dag/std/algebra, DESIGN §3/§4) and the hand nested-match equality fold deletes with the row"),
    },
]
