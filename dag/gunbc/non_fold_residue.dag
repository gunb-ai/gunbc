module gunbc.non_fold_residue

import std.dissolution { DissolutionCondition, unbound_dissolution }
// Shared NFR class strings live once here. Every subject module that still has a
// residue holds `data non_fold_residue_frontier` beside the sites and imports these
// names. std/extdeps may import this module: DESIGN §3's only import law is acyclicity.
// Membership is the host union (`non_fold_residue_identity_join_triples`).
// Discovery: the host reader walks production `.dag` files, keeps those whose source
// declares `data non_fold_residue_frontier`, and parses only those; a row whose
// PathSubject.path file prefix is not the file that hosts the decl is refused, located.
// The required floor judges sites per diff (non_fold_residue_diff_verdict); the
// whole-corpus census (nfr_whole_corpus_typed_census) derives the union.
// Detection-only: never auto-delete rows — greening a site deletes its row by hand with the
// receipt on the PR. v1 seed-reader change is admissible because it unblocks residue
// burn-down for the v2 program.

data nfr_reason_namespace_tree_eq: String = "NamespaceTree structural equality residue (nested off-variant wildcard arm returning false), landed unrostered with effect_grant.dag in #6817 and surfaced when a later branch brought the file into the affected set"

data nfr_dissolve_derived_equality: DissolutionCondition = unbound_dissolution(description: "derived equality from inhabitance lands (dag/std/algebra, DESIGN §3/§4) and the hand equality fold deletes with its row")

data nfr_reason_land_red_era: String = "landed unrostered while the gate was red during the land-red-with-local-proof era (revoked 2026-07-12); declared so the ratchet re-arms"

data nfr_dissolve_owning_fold: DissolutionCondition = unbound_dissolution(description: "the owning file's fold migration totals the match and the row deletes")

data nfr_reason_structural_eq_mint: String = "structural equality fold (param scrutinee, off-variant wildcard arm returning false) — the eq-row class the dated roster blocks cite as their sibling anchor"

data nfr_reason_typed_census_ca5ed1724b: String = "a top-level wildcard arm over a closed coproduct found by the whole-corpus TYPED census at main ca5ed1724b (#12610's joint landing; nfr_whole_corpus_typed_census, srv1, 2026-10-02). The typed walk keys on the scrutinee's inferred type, so it sees the local-binding, field and call scrutinees the deleted parameter-keyed scan never could; these sites predate the walk and are un-migrated modeling (DESIGN §6), rostered so the ratchet arms at unrostered=0"

data nfr_reason_landed_after_typed_census: String = "a top-level wildcard arm over a closed coproduct that landed on main after the ca5ed1724b typed census, while that census's roster was still in review (#12980); the floor's diff-scoped typed walk named it on the roster PR's own run. Un-migrated modeling (DESIGN §6), rostered so the ratchet stays armed at unrostered=0"
