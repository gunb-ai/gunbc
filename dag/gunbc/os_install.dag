data srv3_os_install_plan_standing: Srv3OsInstallPlanStanding = srv3_os_install_plan_standing_for(
  solution: gunbc.os_install_mechanism.srv3_install_mechanism_solution,
  autoinstall: srv3_ubuntu_autoinstall
)

data srv3_seeded_os_install_plan_standing: Srv3OsInstallPlanStanding = srv3_os_install_plan_standing_for(
  solution: gunbc.os_install_mechanism.srv3_install_mechanism_solution,
  autoinstall: srv3_ubuntu_autoinstall_on_iso
)

data srv3_pxe_os_install_plan: Srv3OsInstallPlan = Srv3OsInstallPlan {
  os_target: std.os.types.UbuntuOs { distro: std.os.types.NobleNumbat2404Lts },
  host_architecture: extdeps.toolchain.types.Aarch64,
  lan_survey: srv3_lan_install_survey,
  delivery: os_install_delivery_for(
    mechanism: gunbc.os_install_mechanism.PxeHttpInstall,
    pxe_chain: srv3_pxe_network_boot_chain,
    autoinstall: srv3_ubuntu_autoinstall
  ),
  bmc_boot_target: gunbc.os_install_mechanism.install_boot_target_for(mechanism: gunbc.os_install_mechanism.PxeHttpInstall),
  bmc_boot_enabled: extdeps.bmc.types.BootOverrideOnce,
  post_stage_reset: extdeps.bmc.types.ResetForceRestart,
}

type HostAutoinstall {
  host: product.placement_supply.HostIdentity
  payload: extdeps.os.ubuntu_autoinstall.UbuntuAutoinstallPayload
}

data srv3_autoinstall_spec: HostAutoinstall = HostAutoinstall {
  host: gunbc.fleet_intent_network.operator_host_srv3,
  payload: srv3_ubuntu_autoinstall,
}

data fleet_autoinstall_specs: List<HostAutoinstall> = [srv3_autoinstall_spec]

type InstallServerSpec {
  host: product.placement_supply.HostIdentity
  plan: Srv3OsInstallPlan
  serving_segment: product.network_topology.NetworkSegment
}

fn fleet_install_server_specs_for(mechanism: gunbc.os_install_mechanism.OsInstallMechanism) -> List<InstallServerSpec> {
  match mechanism {
    gunbc.os_install_mechanism.PxeHttpInstall => [srv3_install_server_spec]
    gunbc.os_install_mechanism.NbdProxyVirtualMediaInstall => []
    gunbc.os_install_mechanism.VirtualMediaInstall => []
    gunbc.os_install_mechanism.FirmwareUpdateThenVirtualMedia => []
  }
}

data srv3_install_server_spec: InstallServerSpec = InstallServerSpec {
  host: gunbc.fleet_intent_network.operator_host_srv3,
  plan: srv3_pxe_os_install_plan,
  serving_segment: gunbc.fleet_intent_network.operator_lan_segment,
}

data fleet_install_server_specs: List<InstallServerSpec> = fleet_install_server_specs_for(
  mechanism: gunbc.os_install_mechanism.srv3_install_mechanism
)
