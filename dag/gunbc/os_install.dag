module gunbc.os_install


type NetworkBootDelivery {
  chain: extdeps.provisioning.network_boot.NetworkBootChain
  autoinstall: extdeps.os.ubuntu_autoinstall.UbuntuAutoinstallPayload
}

type OsInstallDelivery
  = NetworkBoot { delivery: NetworkBootDelivery }
  | VirtualMediaIso { autoinstall: extdeps.os.ubuntu_autoinstall.UbuntuAutoinstallPayload }

fn os_install_delivery_for(mechanism: gunbc.os_install_mechanism.OsInstallMechanism, pxe_chain: extdeps.provisioning.network_boot.NetworkBootChain, autoinstall: extdeps.os.ubuntu_autoinstall.UbuntuAutoinstallPayload) -> OsInstallDelivery {
  match mechanism {
    gunbc.os_install_mechanism.NbdProxyVirtualMediaInstall => VirtualMediaIso { autoinstall: autoinstall }
    gunbc.os_install_mechanism.VirtualMediaInstall => VirtualMediaIso { autoinstall: autoinstall }
    gunbc.os_install_mechanism.FirmwareUpdateThenVirtualMedia => VirtualMediaIso { autoinstall: autoinstall }
    gunbc.os_install_mechanism.PxeHttpInstall => NetworkBoot {
      delivery: NetworkBootDelivery {
        chain: pxe_chain,
        autoinstall: autoinstall,
      },
    }
  }
}

type LanInstallInfraSurvey {
  existing_dhcp_configurable: Bool
  dedicated_install_server_present: Bool
}

fn survey_implied_dhcp_direction(survey: LanInstallInfraSurvey) -> extdeps.provisioning.network_boot.DhcpBootDirection {
  if survey.existing_dhcp_configurable {
    extdeps.provisioning.network_boot.NativeDhcpBootOptions
  } else {
    extdeps.provisioning.network_boot.ProxyDhcp
  }
}

type Srv3OsInstallPlan {
  os_target: std.os.types.OperatingSystemProduct
  host_architecture: extdeps.toolchain.types.Architecture
  lan_survey: LanInstallInfraSurvey
  delivery: OsInstallDelivery
  bmc_boot_target: extdeps.bmc.types.RedfishBootSourceOverrideTarget
  bmc_boot_enabled: extdeps.bmc.types.RedfishBootSourceOverrideEnabled
  post_stage_reset: extdeps.bmc.types.RedfishResetType
}

fn srv3_os_install_plan_autoinstall(plan: Srv3OsInstallPlan) -> extdeps.os.ubuntu_autoinstall.UbuntuAutoinstallPayload {
  match plan.delivery {
    NetworkBoot { delivery: d } => d.autoinstall
    VirtualMediaIso { autoinstall: a } => a
  }
}

// A plan is derivable only where a delivery mechanism was DERIVED. The pre-repair rows were
// total `data` values built from the board-default mechanism, so a host whose firmware could not
// justify any mechanism still produced a fully-formed, plausible install plan. Carrying the
// refusal instead of erasing it is what makes that state unrepresentable rather than merely
// detectable after the fact (DESIGN §5, construction over validation).
type Srv3OsInstallPlanStanding
  = OsInstallPlanReady { plan: Srv3OsInstallPlan }
  | OsInstallPlanRefused { cause: gunbc.os_install_mechanism.OsInstallMechanismRefusalCause }

fn srv3_os_install_plan_for(
  mechanism: gunbc.os_install_mechanism.OsInstallMechanism,
  autoinstall: extdeps.os.ubuntu_autoinstall.UbuntuAutoinstallPayload,
) -> Srv3OsInstallPlan {
  Srv3OsInstallPlan {
    os_target: std.os.types.UbuntuOs { distro: std.os.types.NobleNumbat2404Lts },
    host_architecture: extdeps.toolchain.types.Aarch64,
    lan_survey: srv3_lan_install_survey,
    delivery: os_install_delivery_for(
      mechanism: mechanism,
      pxe_chain: srv3_pxe_network_boot_chain,
      autoinstall: autoinstall
    ),
    bmc_boot_target: gunbc.os_install_mechanism.install_boot_target_for(mechanism: mechanism),
    bmc_boot_enabled: extdeps.bmc.types.BootOverrideOnce,
    post_stage_reset: extdeps.bmc.types.ResetForceRestart,
  }
}

fn srv3_os_install_plan_standing_for(
  solution: gunbc.os_install_mechanism.OsInstallMechanismSolution,
  autoinstall: extdeps.os.ubuntu_autoinstall.UbuntuAutoinstallPayload,
) -> Srv3OsInstallPlanStanding {
  match solution {
    gunbc.os_install_mechanism.OsInstallMechanismSelected { mechanism: m } =>
      OsInstallPlanReady {
        plan: srv3_os_install_plan_for(mechanism: m, autoinstall: autoinstall),
      }
    gunbc.os_install_mechanism.OsInstallMechanismRefused { cause: c } => OsInstallPlanRefused { cause: c }
  }
}

data srv3_lan_install_survey: LanInstallInfraSurvey = LanInstallInfraSurvey {
  existing_dhcp_configurable: false,
  dedicated_install_server_present: false,
}

data srv3_pxe_network_boot_chain: extdeps.provisioning.network_boot.NetworkBootChain = extdeps.provisioning.network_boot.NetworkBootChain {
  boot_mode: extdeps.provisioning.network_boot.UefiHttpBoot,
  dhcp_direction: survey_implied_dhcp_direction(survey: srv3_lan_install_survey),
  image_http_root: extdeps.uri.Uri {
    scheme: extdeps.uri.Https,
    locator: "install.srv3.lan/ubuntu-24.04/",
  },
}


