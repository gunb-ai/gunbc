  delivery: extdeps.os.ubuntu_autoinstall.NoCloudNet {
    seed_url: extdeps.uri.Uri {
      scheme: extdeps.uri.Https,
      locator: "install.srv3.lan/ubuntu-24.04/autoinstall/",
    },
  },
  fully_automated: true,
  target_distribution: std.os.types.NobleNumbat2404Lts,
  identity: srv3_autoinstall_identity,
  locale: "en_US.UTF-8",
  keyboard_layout: "us",
  install_openssh_server: true,
  ssh_authorized_keys: gunbc.fleet_ssh_access.fleet_authorized_keys,
  ssh_password_auth: false,
  storage_policy: extdeps.os.ubuntu_autoinstall.StoragePolicyAbsent,
}

