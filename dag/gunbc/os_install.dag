}

type NetworkBootDelivery {
  chain: NetworkBootChain
  autoinstall: UbuntuAutoinstallPayload
}

type OsInstallDelivery
  = NetworkBoot { delivery: NetworkBootDelivery }
  | VirtualMediaIso { autoinstall: UbuntuAutoinstallPayload }

fn os_install_delivery_for(mechanism: OsInstallMechanism, pxe_chain: NetworkBootChain, autoinstall: UbuntuAutoinstallPayload) -> OsInstallDelivery {
  match mechanism {
    NbdProxyVirtualMediaInstall => VirtualMediaIso { autoinstall: autoinstall }
    VirtualMediaInstall => VirtualMediaIso { autoinstall: autoinstall }
    PxeHttpInstall => NetworkBoot {
      delivery: NetworkBootDelivery {
        chain: pxe_chain,
        autoinstall: autoinstall,
      },
    }
  }
}

type LanInstallInfraSurvey {
  existing_dhcp_configurable: Bool
  dedicated_install_server_present: Bool
}

fn survey_implied_dhcp_direction(survey: LanInstallInfraSurvey) -> DhcpBootDirection {
  if survey.existing_dhcp_configurable {
    NativeDhcpBootOptions
  } else {
    ProxyDhcp
  }
}

type Srv3OsInstallPlan {
  os_target: OperatingSystemProduct
  host_architecture: Architecture
  lan_survey: LanInstallInfraSurvey
  delivery: OsInstallDelivery
  bmc_boot_target: RedfishBootSourceOverrideTarget
  bmc_boot_enabled: RedfishBootSourceOverrideEnabled
  post_stage_reset: RedfishResetType
}

fn srv3_os_install_plan_autoinstall(plan: Srv3OsInstallPlan) -> UbuntuAutoinstallPayload {
  match plan.delivery {
    NetworkBoot { delivery: d } => d.autoinstall
    VirtualMediaIso { autoinstall: a } => a
  }
}

// A plan is derivable only where a delivery mechanism was DERIVED. The pre-repair rows were
// total `data` values built from the board-default mechanism, so a host whose firmware could not
// justify any mechanism still produced a fully-formed, plausible install plan. Carrying the
// refusal instead of erasing it is what makes that state unrepresentable rather than merely
// detectable after the fact (DESIGN §5, construction over validation).
type Srv3OsInstallPlanStanding
  = OsInstallPlanReady { plan: Srv3OsInstallPlan }
  | OsInstallPlanRefused { cause: OsInstallMechanismRefusalCause }

fn srv3_os_install_plan_for(
  mechanism: OsInstallMechanism,
  autoinstall: UbuntuAutoinstallPayload,
) -> Srv3OsInstallPlan {
  Srv3OsInstallPlan {
    os_target: UbuntuOs { distro: NobleNumbat2404Lts },
    host_architecture: Aarch64,
    lan_survey: srv3_lan_install_survey,
    delivery: os_install_delivery_for(
      mechanism: mechanism,
      pxe_chain: srv3_pxe_network_boot_chain,
      autoinstall: autoinstall
    ),
    bmc_boot_target: install_boot_target_for(mechanism: mechanism),
    bmc_boot_enabled: BootOverrideOnce,
    post_stage_reset: ResetForceRestart,
  }
}

fn srv3_os_install_plan_standing_for(
  solution: OsInstallMechanismSolution,
  autoinstall: UbuntuAutoinstallPayload,
) -> Srv3OsInstallPlanStanding {
  match solution {
    OsInstallMechanismSelected { mechanism: m } =>
      OsInstallPlanReady {
        plan: srv3_os_install_plan_for(mechanism: m, autoinstall: autoinstall),
      }
    OsInstallMechanismRefused { cause: c } => OsInstallPlanRefused { cause: c }
  }
}

data srv3_lan_install_survey: LanInstallInfraSurvey = LanInstallInfraSurvey {
  existing_dhcp_configurable: false,
  dedicated_install_server_present: false,
}

data srv3_pxe_network_boot_chain: NetworkBootChain = NetworkBootChain {
  boot_mode: UefiHttpBoot,
  dhcp_direction: survey_implied_dhcp_direction(survey: srv3_lan_install_survey),
  image_http_root: Uri {
    scheme: Https,
    locator: "install.srv3.lan/ubuntu-24.04/",
  },
}


// NO PASSWORD HASH LIVES HERE, AND NONE MAY. These three payloads are the fleet's live install
// documents, and every one of them is rendered to bytes that leave this repository over a network:
// srv4's onto the BMC netboot volume at srv4's edge, srv3's onto the seeded ISO and the NoCloudNet
// seed URL. A committed credential hash in that path is a credential published to whoever can reach
// the port — the finding that closed the old srv4 row (dashboard node adhoc-dfa3a187, confirmed by
// side chat). So all three take the KEY-ONLY posture: no identity section, one cloud-init account
// with a locked password and the fleet's authorized keys, and the ssh section with password
// authentication off. THE RUNG IS STATED BY ROUTE, NOT CLAIMED UNIFORMLY (DESIGN.md §4b — a rung is
// the minimum across in-scope paths, and inflation is worse than sitting low):
//   * srv4's BMC netboot route is CONTRACT-GATED: gunbc.bmc.bmc_netboot_serve.bmc_netboot_user_seed_admission
//     runs the same admit_public_nocloud_seed a site PXE edge binding passes, over this document tree,
//     keyed on the plan's subject host's boot NIC. An identity section (password or not), an allow-pw
//     that is not false, or a non-canonical key refuses there BY NAME and stages nothing. That is the
//     route the finding closed.
//   * srv3's two routes are NOT contract-gated yet — they are KEY-ONLY BY DATA and pinned by witness
//     bytes, which exposes a regression but does not block one: the seeded ISO renders straight from
//     autoinstall_user_data(srv3_ubuntu_autoinstall_on_iso) (gunbc.srv3.srv3_seeded_install_media_artifact)
//     with no admission step, and the NoCloudNet payload renders the same way through the emit path.
//     The blocker is honest and named: srv3 has no measured boot-NIC row, so there is no client MAC to
//     key an instance-id on — see gunbc.provisioning.public_nocloud_seed's srv3 frontier row and
//     gunbc.host.host_network_diagnosis.boot_nic_inventory. Until that row exists AND those renderings
//     pass the admission, srv3's credential-free status rests on these rows being UserDataOnly plus the
//     witness greps, not on a contract. Anyone restoring a WithIdentity posture on an srv3 payload
//     reddens srv3_os_install_emit / srv3_seeded_install_media_witness / os_install_deduction, and owes
//     it to the reader to land srv3's boot-NIC row and route it through the admission instead.
// The two crypt(3) hashes this file used to carry are
// deleted, not moved: both were in git history, both are treated as exposed, and rotation is the
// operator's call (raised with merry-fox-82). Nothing in a console/SOL recovery route read them —
// BMC serial console goes through the Redfish SOL profile and the BMC's own credentials
// (extdeps.bmc.serial_console), and fleet shell access is key-based — so no AdminPasswordHandle
// was needed for either host: key-only for srv3 and srv4 alike.

// THE KEY-ONLY ACCOUNT, ONE ROW FOR THE srv3/srv4 DOCUMENTS AND srv14's site PXE edge install. Named "ubuntu" the way the deleted
// identities named their account, with the password locked (there is no password to unlock), the
// fleet's authorized keys, and bash as the login shell. The sudo rule is the emitter's own constant
// (gunbc.os_install_emit cloudinit_nopasswd_sudo_rule): the account has no password, so a sudo rule
// that asked for one would lock the operator out of the machine they just installed.
data srv_fleet_key_only_install_account: List<CloudInitUserEntry> = [
  CloudInitUserEntry {
    name: "ubuntu" as NonEmptyStr,
    ssh_authorized_keys: fleet_authorized_keys,
    lock_passwd: true,
    shell: BashLoginShell,
  },
]

data srv3_ubuntu_autoinstall: UbuntuAutoinstallPayload = UbuntuAutoinstallPayload {
  autoinstall_version: 1,
  delivery: NoCloudNet {
    seed_url: Uri {
      scheme: Https,
      locator: "install.srv3.lan/ubuntu-24.04/autoinstall/",
    },
  },
  fully_automated: true,
  target_distribution: NobleNumbat2404Lts,
  identity_posture: UserDataOnly { users: srv_fleet_key_only_install_account },
  locale: "en_US.UTF-8",
  keyboard_layout: "us",
  ssh: Present { value: AutoinstallSshServer { authorized_keys: fleet_authorized_keys, password_auth: false } },
  storage_policy: StoragePolicyAbsent,
}

data srv3_ubuntu_autoinstall_on_iso: UbuntuAutoinstallPayload = UbuntuAutoinstallPayload {
  autoinstall_version: 1,
  delivery: NoCloudLocal,
  fully_automated: true,
  target_distribution: NobleNumbat2404Lts,
  identity_posture: UserDataOnly { users: srv_fleet_key_only_install_account },
  locale: "en_US.UTF-8",
  keyboard_layout: "us",
  ssh: Present { value: AutoinstallSshServer { authorized_keys: fleet_authorized_keys, password_auth: false } },
  storage_policy: StoragePolicyDirectLayout,
}

data srv4_ubuntu_autoinstall_on_iso: UbuntuAutoinstallPayload = UbuntuAutoinstallPayload {
  autoinstall_version: 1,
  delivery: NoCloudLocal,
  fully_automated: true,
  target_distribution: NobleNumbat2404Lts,
  identity_posture: UserDataOnly { users: srv_fleet_key_only_install_account },
  locale: "en_US.UTF-8",
  keyboard_layout: "us",
  ssh: Present { value: AutoinstallSshServer { authorized_keys: fleet_authorized_keys, password_auth: false } },
  storage_policy: StoragePolicyDirectLayout,
}

data srv3_os_install_plan_standing: Srv3OsInstallPlanStanding = srv3_os_install_plan_standing_for(
  solution: srv3_install_mechanism_solution,
  autoinstall: srv3_ubuntu_autoinstall
)

data srv3_seeded_os_install_plan_standing: Srv3OsInstallPlanStanding = srv3_os_install_plan_standing_for(
  solution: srv3_install_mechanism_solution,
  autoinstall: srv3_ubuntu_autoinstall_on_iso
)

data srv3_pxe_os_install_plan: Srv3OsInstallPlan = Srv3OsInstallPlan {
  os_target: UbuntuOs { distro: NobleNumbat2404Lts },
  host_architecture: Aarch64,
  lan_survey: srv3_lan_install_survey,
  delivery: os_install_delivery_for(
    mechanism: PxeHttpInstall,
    pxe_chain: srv3_pxe_network_boot_chain,
    autoinstall: srv3_ubuntu_autoinstall
  ),
  bmc_boot_target: install_boot_target_for(mechanism: PxeHttpInstall),
  bmc_boot_enabled: BootOverrideOnce,
  post_stage_reset: ResetForceRestart,
}

type HostAutoinstall {
  host: HostIdentity
  payload: UbuntuAutoinstallPayload
}

data srv3_autoinstall_spec: HostAutoinstall = HostAutoinstall {
  host: operator_host_srv3,
  payload: srv3_ubuntu_autoinstall,
}

data fleet_autoinstall_specs: List<HostAutoinstall> = [srv3_autoinstall_spec]
