module gunbc.spark_serving_desired

import std.types { String, Bool, List, NonEmptyStr }
import std.measure { byte_size }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }
import gunbc.ollama_runtime_bundle { ollama_runtime_closure_digest_for_required_release }
import gunbc.model_artifact { ModelArtifact, model_artifact_from_observed_digest }
import std.content_hash { sha256_hex_digest }
import extdeps.ollama.api {
  OllamaModelRef,
  OllamaModelDigest,
  ollama_model_digest_from_wire,
}
import extdeps.ollama.binary_release {
  ollama_required_release,
}
import extdeps.ollama.capability {
  OllamaNvidiaGb10Spark,
  OllamaLinuxArm64,
  OllamaPlatformSupportApplicable,
  OllamaPlatformSupportUnmet,
  OllamaPlatformSupportUnobserved,
  OllamaPlatformSupportUncatalogued,
  ollama_runtime_model_compatibility_verdict,
}
import gunbc.spark_serving_release {
  SparkServingRelease,
  SparkServingOccurrence,
  SparkServingServingPolicy,
  RuntimeArtifactIdentity,
  ServingConfigurationIdentity,
  InferenceCapacityPolicy,
  spark_serving_release_identity,
}
import gunbc.spark_serving_realization {
  SparkServingIntent,
  UserUnitRealization,
  SurvivesReboot,
  RestartsOnFailure,
  ManagedConvergenceOwned,
  ExecutorOwnedIdentity,
  UnauthenticatedEndpoint,
  IndependentlyObservable,
  NamedPrincipal,
}

data spark_serving_desired_note: String = "OPERATOR DECLARATION (2026-08-12): LAN boundary, ollama runtime, gpt-oss:20b model, executor-owned serving process under gunbc-automation. Runtime closure identity derives from extdeps.ollama.binary_release cited digest — materialization binds through gunbc.package_delivery (#8225), not a parallel install path. Model identity is the manifest digest from /api/tags, not the serving label."

data spark_serving_configuration_digest: NonEmptyStr = "spark-serving|runtime=ollama|model=gpt-oss:20b|bind=0.0.0.0:11434|endpoint=lan-unauthenticated" as NonEmptyStr

data spark_serving_desired_gpt_oss_ref: OllamaModelRef = OllamaModelRef {
  name: "gpt-oss" as NonEmptyStr,
  tag: "20b" as NonEmptyStr,
}

data spark_serving_desired_gpt_oss_manifest_digest_wire: String = "sha256:49124fc2c622237675273a842019e83bd327d4d6c2d6e076378ca07ec7579d05"

type SparkServingDesiredAdmission
  = SparkServingDesiredAdmitted { serving_release: SparkServingRelease }
  | SparkServingDesiredRefused { cause: NonEmptyStr }

fn spark_serving_desired_model_digest() -> OllamaModelDigest {
  match ollama_model_digest_from_wire(
    ref: spark_serving_desired_gpt_oss_ref,
    hex: spark_serving_desired_gpt_oss_manifest_digest_wire,
  ) {
    Present { value: d } => d
    Absent =>
      match sha256_hex_digest(hex: "49124fc2c622237675273a842019e83bd327d4d6c2d6e076378ca07ec7579d05") {
        Present { value: digest } =>
          OllamaModelDigest {
            ref: spark_serving_desired_gpt_oss_ref,
            digest: digest,
          }
        Absent => spark_serving_desired_model_digest()
      }
  }
}

fn spark_serving_desired_model_artifact() -> ModelArtifact {
  model_artifact_from_observed_digest(
    publisher: "ollama" as NonEmptyStr,
    observed: spark_serving_desired_model_digest(),
  )
}

fn spark_serving_desired_release_admission() -> SparkServingDesiredAdmission {
  match ollama_runtime_model_compatibility_verdict(
    binary_release: ollama_required_release,
    platform: OllamaNvidiaGb10Spark,
    architecture: OllamaLinuxArm64,
    model: spark_serving_desired_gpt_oss_ref,
  ) {
    OllamaPlatformSupportApplicable =>
      SparkServingDesiredAdmitted {
        serving_release: SparkServingRelease {
          runtime: RuntimeArtifactIdentity {
            closure_digest: ollama_runtime_closure_digest_for_required_release().digest as NonEmptyStr,
          },
          model: spark_serving_desired_model_artifact(),
        },
      }
    OllamaPlatformSupportUnmet { cause: c } =>
      SparkServingDesiredRefused { cause: c }
    OllamaPlatformSupportUnobserved { cause: c } =>
      SparkServingDesiredRefused { cause: c }
    OllamaPlatformSupportUncatalogued { cause: c } =>
      SparkServingDesiredRefused { cause: c }
  }
}

data spark_serving_desired_admission: SparkServingDesiredAdmission = spark_serving_desired_release_admission()

type SparkServingFleetDesired
  = SparkServingFleetDesiredReady { occurrences: List<SparkServingOccurrence> }
  | SparkServingFleetDesiredRefused { cause: NonEmptyStr }

fn spark_serving_occurrence(host: HostIdentity, serving_release: SparkServingRelease) -> SparkServingOccurrence {
  SparkServingOccurrence {
    host: host,
    release_identity: spark_serving_release_identity(spec: serving_release),
    serving_policy: spark_serving_desired_serving_policy(),
  }
}

fn spark_serving_fleet_desired() -> SparkServingFleetDesired {
  match spark_serving_desired_admission {
    SparkServingDesiredAdmitted { serving_release: r } =>
      SparkServingFleetDesiredReady {
        occurrences: [
          spark_serving_occurrence(host: operator_host_srv5, serving_release: r),
          spark_serving_occurrence(host: operator_host_srv6, serving_release: r),
        ],
      }
    SparkServingDesiredRefused { cause: c } =>
      SparkServingFleetDesiredRefused { cause: c }
  }
}

data spark_serving_fleet_desired: SparkServingFleetDesired = spark_serving_fleet_desired()

fn spark_serving_desired_serving_policy() -> SparkServingServingPolicy {
  SparkServingServingPolicy {
    serving_configuration: ServingConfigurationIdentity {
      configuration_digest: spark_serving_configuration_digest,
    },
    capacity: InferenceCapacityPolicy {
      max_model_len: 8192,
      shared_memory_budget_bytes: byte_size(120000000000),
    },
  }
}

fn spark_serving_terminal_intent() -> SparkServingIntent {
  SparkServingIntent {
    lifecycle: SurvivesReboot,
    availability: RestartsOnFailure,
    authority: ManagedConvergenceOwned,
    service_identity: ExecutorOwnedIdentity,
    endpoint: UnauthenticatedEndpoint,
    observability: IndependentlyObservable,
  }
}

fn spark_serving_automation_principal() -> NamedPrincipal {
  NamedPrincipal { login: "gunbc-automation" as NonEmptyStr }
}
