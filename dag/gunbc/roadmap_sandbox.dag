module gunbc.roadmap_sandbox


data roadmap_sandbox_note: String = "The /sandbox design surface (P4): the register at every depth plus every component in every state, all DERIVED from the same authorities the live surfaces use, so the sandbox is a faithful mirror, never a hand mock. Roles are shown under BOTH themes at once (literal material paints inline — the one place a literal color is right, because it is DISPLAYING the role->material authority under two projections simultaneously, which var(--role) cannot do). The component gallery renders dispatch_button_component's states one-for-one; the terminal instances are exactly the wire vocabulary (totality is the P0 property, re-witnessed here as gallery coverage). The live section is one pressable instance per wire arm that POSTs /sandbox/echo?status=LABEL and renders through the SAME client program the real button uses — so every state is exercisable without dispatching a session, and the sandbox cannot drift from production render."

fn sandbox_rules() -> List<gunbc.design.material.BuildRule> {
  [
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "sandbox" }, decls: [
      decl(prop: Padding, value: scale_pair(a: space_16, b: space_24)),
      decl(prop: MaxWidth, value: scale_var(t: measure_page)),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.RawSelector { text: ".sandbox section" }, decls: [
      decl(prop: MarginBottom, value: scale_var(t: space_24)),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "swatch-row" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: AlignItems, value: "center"),
      decl(prop: Gap, value: scale_var(t: space_6)),
      decl(prop: MarginBottom, value: scale_var(t: space_2)),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "swatch" }, decls: [
      decl(prop: Display, value: "inline-block"),
      decl(prop: Width, value: scale_var(t: space_24)),
      decl(prop: Height, value: scale_var(t: space_24)),
      decl(prop: BorderRadius, value: scale_var(t: radius_3)),
      decl(prop: Border, value: scale_border(w: border_1, color_var: "var(--border)")),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "role-name" }, decls: [
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_12)),
      role_decl(prop: Color, r: TextRole),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "role-var" }, decls: [
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_12)),
      role_decl(prop: Color, r: TextDimRole),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "token-row" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: Gap, value: scale_var(t: space_8)),
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_12)),
      role_decl(prop: Color, r: TextDimRole),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "gallery-row" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: Gap, value: scale_var(t: space_8)),
      decl(prop: FlexWrap, value: "wrap"),
      decl(prop: AlignItems, value: "baseline"),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "gallery-cell" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: FlexDirection, value: "column"),
      decl(prop: AlignItems, value: "center"),
      decl(prop: Gap, value: scale_var(t: space_2)),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "gallery-arm" }, decls: [
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_10)),
      role_decl(prop: Color, r: TextDimRole),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "auditioner-bar" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: Gap, value: scale_var(t: space_4)),
      decl(prop: AlignItems, value: "center"),
      decl(prop: Margin, value: scale_triple(a: space_3, b: space_0, c: space_3)),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "band-chip" }, decls: [
      decl(prop: Display, value: "inline-block"),
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_10)),
      decl(prop: Padding, value: scale_pair(a: space_1, b: space_6)),
      decl(prop: BorderRadius, value: scale_var(t: radius_3)),
    ] },
  ]
}

data fixture_frame_width_note: String = "The three fixture frames simulate the falsifier's declared viewports (wide 1680 / medium 1024 / narrow 480) as max-width containers so the operator reads all three compositions on one screen without resizing. The px literals are DIAGNOSTIC viewport dimensions, not design lengths — they name external screen widths, which is why they do not route through gunbc.design.scale (whose tokens are the page's own spatial vocabulary); the untokened-length census scopes to roadmap_instance_rules() and these sandbox-only rules are its declared out-of-scope neighbor."

fn fixture_frame_rules() -> List<gunbc.design.material.BuildRule> {
  [
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.RawSelector { text: ".sandbox-work-row" }, decls: [
      decl(prop: MaxWidth, value: "none"),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "fixture-frame" }, decls: [
      decl(prop: Border, value: scale_border(w: border_1, color_var: "var(--border)")),
      decl(prop: Padding, value: scale_var(t: space_8)),
      decl(prop: MarginBottom, value: scale_var(t: space_16)),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "fixture-wide" }, decls: [
      decl(prop: MaxWidth, value: "1680px"),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "fixture-medium" }, decls: [
      decl(prop: MaxWidth, value: "1024px"),
    ] },
    gunbc.design.material.StaticRule { selector: extdeps.languages.css.selectors.ClassSelector { name: "fixture-narrow" }, decls: [
      decl(prop: MaxWidth, value: "480px"),
    ] },
  ]
}

fn sandbox_css() -> String {
  join([roadmap_css(), serialize_rules(rules: concat(sandbox_rules(), fixture_frame_rules()))], "\n")
}

fn role_swatch(theme: gunbc.design.theme.Theme, role: gunbc.design.theme.ThemeRole) -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "span",
    attributes: [
      attr(name: "class", value: "swatch" ),
      attr(name: "style", value: join(["background: ", paint(m: assignment_material(t: theme, r: role))], "") ),
      attr(name: "title", value: join([theme.name, " ", role_key(r: role)], "") ),
    ],
    children: [],
  }
}

fn role_row(role: gunbc.design.theme.ThemeRole) -> std.markup.Fragment {
  el_class("div", "swatch-row", [
    role_swatch(theme: night_theme, role: role),
    role_swatch(theme: day_theme, role: role),
    el_class("span", "role-name", [ txt(role_key(r: role)) ]),
    el_class("span", "role-var", [ txt(role_var(r: role)) ]),
  ])
}

fn roles_section() -> std.markup.Fragment {
  el_class("section", "sandbox-roles",
    concat([ el("h2", [ txt("roles — night / day") ]) ],
      map(theme_roles, r => role_row(role: r))))
}

fn scale_token_row(t: gunbc.design.scale.ScaleToken) -> std.markup.Fragment {
  el_class("div", "token-row", [
    el_class("span", "token-name", [ txt(t.name) ]),
    el_class("span", "token-value", [ txt(scale_value_wire(v: t.value)) ]),
  ])
}

fn scale_group(label: String, tokens: List<gunbc.design.scale.ScaleToken>) -> std.markup.Fragment {
  el_class("div", "scale-group",
    concat([ el_class("h3", "group-label", [ txt(label) ]) ],
      map(tokens, t => scale_token_row(t: t))))
}

fn scales_section() -> std.markup.Fragment {
  el_class("section", "sandbox-scales", [
    el("h2", [ txt("scales") ]),
    scale_group(label: "spacing", tokens: spacing_scale),
    scale_group(label: "type", tokens: type_scale),
    scale_group(label: "font", tokens: font_stack),
    scale_group(label: "dimension", tokens: dimension_scale),
  ])
}

fn gallery_states() -> List<gunbc.design.component.ComponentState> {
  concat([dispatch_idle_state, dispatch_requested_state], dispatch_button_terminal_states())
}

data gallery_arm_sublabel_note: String = "The caption collapse (W1d) makes band phrases the button text, so two refusal arms wear the same caption — CORRECT for the operator, ambiguous for a specimen sheet. The gallery is the diagnostic surface, so each cell carries the ARM identity as a sublabel under the instance (state.key, which for terminals IS the wire label — the same authority the coverage witness reads), and the live cells mirror it. The caption channel stays operator-vocabulary everywhere; the wire vocabulary survives only in the sublabel and title channels, where diagnosis lives."

data band_chip_note: String = "The auditioner's live preview (W1f visibility fix, operator report 2026-07-24: 'the swatches button doesn't seem to do anything' — the toggle worked, proven by execution in a DOM-stub harness, but nothing NEAR it consumed the band vars; the roles section beside it paints theme literals by design). Five chips filled from var(--band-*) sit beside the control, so a set flip repaints the strip in the same glance that clicked it. Keys derive from workspace_band_paints — the chip strip cannot drift from the band vocabulary."

fn band_chip(key: String) -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "span",
    attributes: [
      attr(name: "class", value: "band-chip" ),
      attr(name: "style", value: join(["background: var(--band-", key, "); color: var(--band-", key, "-ink)"], "") ),
    ],
    children: [ txt(key) ],
  }
}

fn gallery_cell(button: std.markup.Fragment, arm: String) -> std.markup.Fragment {
  el_class("div", "gallery-cell", [ button, el_class("span", "gallery-arm", [ txt(arm) ]) ])
}

fn gallery_instance(state: gunbc.design.component.ComponentState) -> std.markup.Fragment {
  let cls = dispatch_state_class(state: state)
  let full = if cls == "" { "dispatch-btn" } else { join(["dispatch-btn ", cls], "") }
  gallery_cell(
    button: extdeps.browser.Element {
      tag: "button",
      attributes: [
        attr(name: "class", value: full ),
        attr(name: "type", value: "button" ),
        attr(name: "disabled", value: "" ),
      ],
      children: [ txt(dispatch_state_display_text(state: state)) ],
    },
    arm: state.key,
  )
}

fn gallery_section() -> std.markup.Fragment {
  el_class("section", "sandbox-gallery", [
    el("h2", [ txt("dispatch button — every state (static)") ]),
    el_class("div", "gallery-row", map(gallery_states(), s => gallery_instance(state: s))),
  ])
}

fn live_instance(wire_label: String) -> std.markup.Fragment {
  gallery_cell(
    button: el_attrs("button", [
      attr(name: "class", value: join(["dispatch-btn ", sandbox_live_class], "") ),
      attr(name: "type", value: "button" ),
      attr(name: "data-status", value: wire_label ),
    ], [ txt(dispatch_caption_idle) ]),
    arm: wire_label,
  )
}

fn live_section() -> std.markup.Fragment {
  el_class("section", "sandbox-live", [
    el("h2", [ txt("live — press to exercise each wire arm (POST /sandbox/echo)") ]),
    el_class("div", "gallery-row", map(belt_dispatch_all_status_labels(), l => live_instance(wire_label: l))),
  ])
}

data sandbox_work_row_fixture_note: String = "The A2 composition fixture (operator blocker 6): the falsifier specimen row — long headline, seven obligations with Environment/Workspace/Agent complete, session-present/process-exited evidence, four remaining — rendered by the REAL render_work_row at the three declared falsifier widths, plus the refused-arm specimen with its located reason. Server-rendered from constructed views, so the operator critiques the exact production composition without live data, and a seam or renderer change moves these frames in the same deploy that moves the dashboard."

fn fixture_specimen_segments() -> List<gunbc.roadmap_workflow_stage.WorkflowSegment> {
  [
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "admission receipt readable" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: WorkspaceWorkflowSegment, state: WorkflowSegmentComplete, detail: "worktree created" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentComplete, detail: "turn.completed and process exit 0" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: PublicationWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: ReviewWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: GoalAuditWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
  ]
}

fn fixture_specimen_view(node_id: String, activity: gunbc.roadmap_presentation.ActivityView) -> gunbc.roadmap_presentation.WorkRowView {
  gunbc.roadmap_presentation.WorkRowView {
    node_id: node_id,
    headline: "Record which generator actually produced each result",
    summary: none,
    lifecycle: OpenLifecycle,
    scheduling: SchedulingReady,
    superseded_by: "",
    activity: activity,
    action: action_view(scheduling: SchedulingReady, lifecycle: OpenLifecycle),
    supporting_facts: [],
    disclosure: NoDisclosure,
  }
}

fn fixture_active_view() -> gunbc.roadmap_presentation.WorkRowView {
  fixture_specimen_view(node_id: "sandbox-specimen-active", activity: activity_view_from_parts(
    segments: fixture_specimen_segments(),
    remaining: 4,
    process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" },
    current_activity: "Worked for 6m 34s"))
}

fn fixture_refused_view() -> gunbc.roadmap_presentation.WorkRowView {
  fixture_specimen_view(node_id: "sandbox-specimen-refused", activity: activity_view_from_parts(
    segments: [
      gunbc.roadmap_workflow_stage.WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
      gunbc.roadmap_workflow_stage.WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentRefused, detail: "turn.completed with process unobserved: no exit was established" },
    ],
    remaining: 6,
    process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" },
    current_activity: ""))
}

fn fixture_row_li(view: gunbc.roadmap_presentation.WorkRowView) -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "li",
    attributes: node_li_attributes(view: view),
    children: render_work_row(view: view),
  }
}

fn fixture_frame(label: String, cls: String) -> std.markup.Fragment {
  el_class("div", join(["fixture-frame ", cls], ""), [
    el_class("h3", "group-label", [ txt(label) ]),
    el("ul", [
      fixture_row_li(view: fixture_active_view()),
      fixture_row_li(view: fixture_refused_view()),
    ]),
  ])
}

fn work_row_fixture_section() -> std.markup.Fragment {
  el_class("section", "sandbox-work-row", [
    el("h2", [ txt("work row — falsifier specimen at three widths (static)") ]),
    fixture_frame(label: "wide · 1680", cls: "fixture-wide"),
    fixture_frame(label: "medium · 1024", cls: "fixture-medium"),
    fixture_frame(label: "narrow · 480", cls: "fixture-narrow"),
  ])
}

data sandbox_family_fixture_note: String = "The A3 composition fixture (the #7589 deferred receipt): one declared family rendered by the REAL grouping path — band_entries folds the constructed rows against the typed WorkFamilyDecl/WorkFamilyMemberFact facts, workspace_entries_ul paints the result — so the exhibit shows exactly what production shows: the family claim stated once in the group head with the member count, member rows carrying only their subjects (the full headline is provably absent — the subject swap runs through family_subject_row, not a display trick), and an undeclared neighbour row keeping its own headline outside the group. All rows are routine (OpenLifecycle + SchedulingReady + NoActiveWork), so the frame also exhibits the A3 chip collapse: no open chips, no hollow activity. Constructed views rather than the live closing-contract family, for the same reason the A2 fixture constructs its specimen: the exhibit must stay byte-stable across roadmap edits so the three width frames compare composition, not data drift."

fn fixture_ready_view(node_id: String, headline: String) -> gunbc.roadmap_presentation.WorkRowView {
  gunbc.roadmap_presentation.WorkRowView {
    node_id: node_id,
    headline: headline,
    summary: none,
    lifecycle: OpenLifecycle,
    scheduling: SchedulingReady,
    superseded_by: "",
    activity: NoActiveWork,
    action: action_view(scheduling: SchedulingReady, lifecycle: OpenLifecycle),
    supporting_facts: [],
    disclosure: NoDisclosure,
  }
}

fn fixture_family_decl() -> gunbc.roadmap_presentation.WorkFamilyDecl {
  gunbc.roadmap_presentation.WorkFamilyDecl {
    id: "sandbox-family",
    claim: "Every startable node carries a closing contract",
  }
}

fn fixture_family_members() -> List<gunbc.roadmap_presentation.WorkFamilyMemberFact> {
  [
    gunbc.roadmap_presentation.WorkFamilyMemberFact { family_id: "sandbox-family", task_node: "sandbox-family-a", subject: "dag_compile_clean_gate" },
    gunbc.roadmap_presentation.WorkFamilyMemberFact { family_id: "sandbox-family", task_node: "sandbox-family-b", subject: "affected_set_falsifier" },
    gunbc.roadmap_presentation.WorkFamilyMemberFact { family_id: "sandbox-family", task_node: "sandbox-family-c", subject: "regen_floor_skip_witness" },
  ]
}

fn fixture_family_rows() -> List<gunbc.roadmap_presentation.WorkRowView> {
  [
    fixture_ready_view(node_id: "sandbox-family-a", headline: "Declare the closing contract for dag_compile_clean_gate"),
    fixture_ready_view(node_id: "sandbox-family-b", headline: "Declare the closing contract for affected_set_falsifier"),
    fixture_ready_view(node_id: "sandbox-family-c", headline: "Declare the closing contract for regen_floor_skip_witness"),
    fixture_ready_view(node_id: "sandbox-neighbour", headline: "Record which generator actually produced each result"),
  ]
}

fn family_fixture_frame(label: String, cls: String) -> std.markup.Fragment {
  el_class("div", join(["fixture-frame ", cls], ""), [
    el_class("h3", "group-label", [ txt(label) ]),
    workspace_entries_ul(
      entries: band_entries(
        rows: fixture_family_rows(),
        families: [fixture_family_decl()],
        members: fixture_family_members(),
      ),
      observation: ObservationsNominal,
    ),
  ])
}

fn family_fixture_section() -> std.markup.Fragment {
  el_class("section", "sandbox-family-fixture", [
    el("h2", [ txt("family grouping — claim stated once, members carry subjects (static)") ]),
    family_fixture_frame(label: "wide · 1680", cls: "fixture-wide"),
    family_fixture_frame(label: "medium · 1024", cls: "fixture-medium"),
    family_fixture_frame(label: "narrow · 480", cls: "fixture-narrow"),
  ])
}

data instrument_labs_section_note: String = "ONE CONTEXTUAL ENTRY, ON THE PAGE WHERE STUDIES LIVE, rather than three raw links in every shared header (review ruling, 2026-08-06). A header nav put development routes on the daily workspace and the roadmap, where they are noise to everyone not building the instrument. The sandbox is already the page for studies, so the labs belong here with a sentence saying what each one is for — and the rows come from gunbc.roadmap_component.instrument_lab_links, the same declaration the router builds its route specs from, so a link that resolves nowhere is caught by execution rather than by clicking."

fn instrument_lab_entry(l: gunbc.roadmap_component.InstrumentLabLink) -> std.markup.Fragment {
  el("li", [ el_attrs("a", [ attr(name: "href", value: l.path) ], [ txt(l.label) ]) ])
}

fn instrument_labs_section() -> std.markup.Fragment {
  el("section", [
    el("h2", [ txt("instrument labs") ]),
    el("ul", map(instrument_lab_links, l => instrument_lab_entry(l: l))),
  ])
}

fn sandbox_page() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "html",
    attributes: [],
    children: [
      el("head", [
        std.markup.Element { tag: "meta", attributes: [ attr(name: "charset", value: "utf-8" ) ], children: [] },
        el("style", [ txt(sandbox_css()) ]),
        el("title", [ txt("gunbc — sandbox") ]),
      ]),
      el("body", [
        roadmap_header(page: "sandbox"),
        el_class("div", "auditioner-bar", concat(
          [ el_attrs("button", [
              attr(name: "class", value: swatch_toggle_class ),
              attr(name: "type", value: "button" ),
            ], []) ],
          map(workspace_band_paints(), p => band_chip(key: p.key)))),
        el_class("main", "sandbox", [
          instrument_labs_section(),
          roles_section(),
          scales_section(),
          gallery_section(),
          live_section(),
          work_row_fixture_section(),
          family_fixture_section(),
        ]),
        std.markup.Element {
          tag: "script",
          attributes: [
            attr(name: "src", value: sandbox_asset_path ),
            attr(name: "defer", value: "" ),
          ],
          children: [],
        },
      ]),
    ],
  }
}

fn sandbox_gallery_terminal_labels() -> List<String> {
  map(component_terminal_states(c: dispatch_button_component()), s => s.key)
}
