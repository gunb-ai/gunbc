module gunbc.language_source_scaffold_index


data language_source_scaffold_index_note: String = "B2 inventory for hand-authored target-language semantics in language files. Every remaining blob of hand-written target source carries a row here whose disposition is a std.disposition Scaffold naming the construction that subsumes it. Typed on purpose: because Disposition has no prose arm, a mark WITHOUT a trigger is unwritable rather than merely counted, so this index needs no string-content classifier over the marks (which would be undecidable, and is fenced out)."

type LanguageSourceScaffoldRow {
  carrier_module: String
  blob_decl: String
  disposition: Disposition
}

data rust_pair_completion_spelling_scaffold_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.trait_derive_shape",
    decl_name: "pair_completion_op_rows",
    field: WholeDeclaration
  }
}

data rust_bool_host_bridge_scaffold_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "std.trait_derive_shape",
    decl_name: "ReprGroundingDeriveElemShape",
    field: WholeDeclaration
  }
}

data rust_dry_run_mode_scaffold_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v1.compiler.emit",
    decl_name: "BackendCapability",
    field: WholeDeclaration
  }
}

data rust_pair_completion_spelling_scaffold_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "extdeps.languages.rust.emit",
  blob_decl: "rust_pair_completion_spellings",
  disposition: rust_pair_completion_spelling_scaffold_trigger
}

data rust_bool_host_bridge_scaffold_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "extdeps.languages.rust.emit",
  blob_decl: "rust_supplemental_impls_bool_coproduct",
  disposition: rust_bool_host_bridge_scaffold_trigger
}

data rust_dry_run_mode_scaffold_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "v1.compiler.emit_rust",
  blob_decl: "emit_dry_run_module",
  disposition: rust_dry_run_mode_scaffold_trigger
}

data runtime_rust_trace_mark_scaffold_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "std.observation",
    decl_name: "Observation",
    field: WholeDeclaration
  }
}

data runtime_rust_kernel_opcode_scaffold_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "std.realization",
    decl_name: "RealizationPlan",
    field: WholeDeclaration
  }
}

data runtime_rust_fnv1a64_terminal: Disposition = Terminal {
  reason: "named irreducible intrinsic kernel: fnv1a64 is the content-hash primitive std.content_hash is defined over, so it has no substrate decomposition to dissolve into"
}

data runtime_rust_trace_mark_scaffold_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "v1.compiler.runtime_rust",
  blob_decl: "rt_resolution_silent_pick_telemetry",
  disposition: runtime_rust_trace_mark_scaffold_trigger
}

data runtime_rust_kernel_opcode_scaffold_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "v1.compiler.runtime_rust",
  blob_decl: "rt_accelerator_demo_kernel",
  disposition: runtime_rust_kernel_opcode_scaffold_trigger
}

data runtime_rust_hash_ops_terminal_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "v1.compiler.runtime_rust",
  blob_decl: "rt_hash_ops",
  disposition: runtime_rust_fnv1a64_terminal
}

data compiler_tests_rust_hand_assertion_scaffold_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v1.compiler.coercion",
    decl_name: "CoercionTestEntry",
    field: WholeDeclaration
  }
}

data compiler_tests_rust_hand_assertion_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "v1.compiler.compiler_tests_rust",
  blob_decl: "ct_groupcompletion_checkpoint_fires_under_faithful_corpus_test",
  disposition: compiler_tests_rust_hand_assertion_scaffold_trigger
}

data language_source_scaffold_roster: List<LanguageSourceScaffoldRow> = [
  rust_pair_completion_spelling_scaffold_row,
  rust_bool_host_bridge_scaffold_row,
  rust_dry_run_mode_scaffold_row,
  runtime_rust_trace_mark_scaffold_row,
  runtime_rust_kernel_opcode_scaffold_row,
  runtime_rust_hash_ops_terminal_row,
  compiler_tests_rust_hand_assertion_row
]

fn language_source_scaffold_row_is_dispositioned(row: LanguageSourceScaffoldRow) -> Bool {
  match row.disposition {
    Scaffold { dissolves_to: _, bind: bind } => bind.decl_name != "" && bind.module_path != ""
    Terminal { reason: reason } => reason != ""
  }
}

fn language_source_scaffold_roster_all_dispositioned() -> Bool {
  all(language_source_scaffold_roster, row => language_source_scaffold_row_is_dispositioned(row: row))
}

fn language_source_scaffold_row_is_scaffold(row: LanguageSourceScaffoldRow) -> Bool {
  match row.disposition {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

fn language_source_scaffold_roster_size() -> Int {
  language_source_scaffold_roster |> count
}

fn language_source_scaffold_pending_count() -> Int {
  language_source_scaffold_roster
    |> filter(row => language_source_scaffold_row_is_scaffold(row: row))
    |> count
}

fn language_source_scaffold_terminal_count() -> Int {
  language_source_scaffold_roster
    |> filter(row => language_source_scaffold_row_is_scaffold(row: row) == false)
    |> count
}
