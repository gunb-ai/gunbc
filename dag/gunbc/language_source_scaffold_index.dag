module gunbc.language_source_scaffold_index


data language_source_scaffold_index_note: String = "B2 inventory for hand-authored target-language semantics in language files. Every blob of hand-written target source carries a row here whose disposition is a std.disposition Scaffold naming the construction that subsumes it, or a Terminal stating why it is irreducible. No string-content classifier is involved: the mark is a typed value, not prose to be parsed."

data language_source_scaffold_enforcement_boundary: String = "What is actually enforced, stated precisely because the earlier wording overstated it (review 43129). CONSTRUCTION (real): Disposition has no prose and no absent arm, so a row cannot carry an unmarked or free-text disposition — Terminal-with-reason or Scaffold-with-bind are the only inhabitants, and 'unmarked' is genuinely unwritable. NOT CONSTRUCTION (validated here instead): DeclarationRef.module_path and decl_name are declared NonEmptyStr (String where non_empty) but that refinement is NOT enforced at construction — proven by execution, since the empty-bind control row in the witness typechecks and evaluates. So a Scaffold binding the empty string IS writable today, and language_source_scaffold_row_is_dispositioned is the only thing that catches it. That check is therefore load-bearing, not a second representation; it dissolves the day refinement predicates are construction-enforced, at which point the control row stops typechecking and the check can be deleted."

type LanguageSourceScaffoldRow {
  carrier_module: String
  blob_decl: String
  disposition: Disposition
}

data rust_pair_completion_spelling_scaffold_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.trait_derive_shape",
    decl_name: "pair_completion_op_rows",
    field: WholeDeclaration
  }
}

data rust_bool_host_bridge_scaffold_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.plans.value_null_split",
    decl_name: "value_null_split_plan",
    field: WholeDeclaration
  }
}

data rust_dry_run_mode_scaffold_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.execution_mode",
    decl_name: "ExecutionMode",
    field: WholeDeclaration
  }
}

data rust_dry_run_mode_scaffold_dissolve_on: String = "dissolve-on: emit_dry_run_module DryRunMode(bool) blob. BackendCapability/BackendInfo deleted as dead vocabulary (#7272 A2) — wiring five Cap* markers to satisfy a census ratchet was refused. Dissolves when dry-run is modeled on the ExecutionMode / effect-grant axis (Hermetic/Replay plan-only) rather than a hand-emitted bool wrapper; failing a substrate model, the next language-source scaffold sweep deletes the blob if no executing consumer remains."


data rust_pair_completion_spelling_scaffold_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "extdeps.languages.rust.emit",
  blob_decl: "rust_pair_completion_spellings",
  disposition: rust_pair_completion_spelling_scaffold_trigger
}

