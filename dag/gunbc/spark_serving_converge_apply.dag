module gunbc.spark_serving_converge_apply

import std.types { String, List, Bool, Int }
import gunbc.fleet_converge_plan {
  FleetConvergePlanArtifact,
  fleet_converge_plan_artifact_bundle_admits,
  fleet_converge_spark_serving_row_operations,
  fleet_converge_spark_serving_row_effects,
}
import gunbc.typed_argv_exec {
  TypedArgvExecOutcome,
  TypedArgvExecConverged,
  TypedArgvExecRefused,
}
import gunbc.host_effect {
  HostEffectTransport,
  LocalShell,
  SshShell,
  FleetSsh,
  EmitArtifactThenThinRun,
}
import gunbc.host_effect_realize { run_typed_argv_transport }
import gunbc.remote_operation {
  RemoteOperation,
  RemoteArgv,
  RemoteFileBytes,
  RemoteOperationOutcome,
  RemoteOperationSucceeded,
  RemoteOperationRefused,
}
import gunbc.typed_remote_file_write {
  TypedRemoteFileWriteAdmitted,
  TypedRemoteFileConvergence,
  TypedRemoteFileConverged,
  TypedRemoteFileConvergenceRefused,
  converge_typed_remote_file,
}

data spark_serving_converge_apply_authority_note: String = "Apply reads ONLY the frozen FleetConvergePlanArtifact.spark_serving_typed_actions rows minted at plan time — it MUST NOT re-run membership_reconcile, re-derive install_effects, or re-realize operations from live authorities. Realization happens at PLAN time and its RemoteOperation values are frozen into the row, so the bundle hash covers the exact bytes a file write will deliver; apply executes those operations verbatim. Realization emits an ORDERED SEQUENCE of gunbc.remote_operation RemoteOperation values (never one fused argv); actuation runs them in order, halting at the first failure. Dispatch is per operation kind: RemoteArgv routes through host_effect_realize run_typed_argv_transport (FleetSsh/SshShell typed argv binding — never effect_actuation shell strings), while RemoteFileBytes routes through typed_remote_file_write converge_typed_remote_file (stage, mode, atomic rename, read-back) and REFUSES on any non-FleetSsh transport, because that convergence needs the SshTarget and sealed FleetSshExecutionContext and SshShell carries neither. The two executions answer in different types and are mapped into one RemoteOperationOutcome vocabulary rather than coercing a file convergence into an argv result, which would require inventing an exit code and stdout it never had."

type SparkServingFrozenApplyResult =
    SparkServingFrozenApplied { remote_operations: List<RemoteOperation>, effect_count: Int }
  | SparkServingFrozenApplyRefused { reason: String }

type SparkServingFrozenRemoteExecResult =
    SparkServingFrozenRemoteExecApplied { exec_outcome: RemoteOperationOutcome }
  | SparkServingFrozenRemoteExecRefused { reason: String }

// APPLY EXECUTES THE FROZEN OPERATIONS. It no longer calls the realizer: the plan already did, at
// plan time, and the result is in the row. That is what makes the bundle hash meaningful for a file
// write -- the bytes are inside the thing that was hashed, so a plan/apply divergence is no longer
// possible rather than merely unlikely. Rows carrying effects but no operations refuse, because
// executing nothing while reporting the effects applied is the fail-open this freeze exists to shut.
fn spark_serving_apply_reads_frozen_typed_rows(
  artifact: FleetConvergePlanArtifact,
  claimed_bundle_hex: String,
) -> SparkServingFrozenApplyResult {
  if !fleet_converge_plan_artifact_bundle_admits(artifact: artifact, claimed_hex: claimed_bundle_hex) {
    SparkServingFrozenApplyRefused {
      reason: "spark_serving_converge_apply: plan artifact bundle/hash consistency refused — typed rows cannot be smuggled beside an unverified v1 digest",
    }
  } else {
    SparkServingFrozenApplied {
      remote_operations: flat_map(
        artifact.spark_serving_typed_actions,
        r => fleet_converge_spark_serving_row_operations(row: r),
      ),
      effect_count: length(flat_map(artifact.spark_serving_typed_actions, r => fleet_converge_spark_serving_row_effects(row: r))),
    }
  }
}

// TAKES THE TRANSPORT, DOES NOT PICK IT. The earlier signature took a context plus a
// target and assembled FleetSsh itself, which fixed one transport inside a function whose
// name then had to claim it. That made the operator-workstation credential path the only
// reachable one, and it is the path spark_credential_access_token_frontier_note says fails
// at runtime on GHA runner slots — so the CI dispatch mode this lane adds was wired to a
// route that cannot execute there. The transport is now the caller's decision, and the two
// callers hold visibly different preconditions: FleetSsh cannot be constructed without a
// context whose anchor passed a content readback, while SshShell carries no trust facts and
// relies on the runner job having established them out of band. Fusing them is what let the
// stronger name stand over the weaker guarantee.
fn spark_serving_exec_frozen_typed_rows(
  artifact: FleetConvergePlanArtifact,
  claimed_bundle_hex: String,
  transport: HostEffectTransport,
) -> SparkServingFrozenRemoteExecResult {
  match spark_serving_apply_reads_frozen_typed_rows(
    artifact: artifact,
    claimed_bundle_hex: claimed_bundle_hex,
  ) {
    SparkServingFrozenApplyRefused { reason: why } =>
      SparkServingFrozenRemoteExecRefused { reason: why }
    SparkServingFrozenApplied { remote_operations: operations, effect_count: n } =>
      if n == 0 {
        SparkServingFrozenRemoteExecApplied {
          exec_outcome: RemoteOperationRefused {
            reason: "spark_serving_converge_apply: converged plan — zero frozen install effects, remote exec is noop",
          },
        }
      } else if operations.length() == 0 {
        SparkServingFrozenRemoteExecApplied {
          exec_outcome: RemoteOperationRefused {
            reason: "spark_serving_converge_apply: frozen effects realized to zero operations — refusing rather than reporting a noop as applied",
          },
        }
      } else {
        SparkServingFrozenRemoteExecApplied {
          exec_outcome: spark_serving_run_operation_sequence(
            operations: operations,
            transport: transport,
          ),
        }
      }
  }
}

// EXECUTING ONE OPERATION, DISPATCHED ON WHAT IT IS.
//
// An argv runs through the typed-argv transport. A file write does NOT: bytes ride stdin through the
// staged convergence (stage, mode, atomic rename, read-back), which is four invocations answering in
// its own type. Coercing that into an argv result would mean inventing an exit code and a stdout it
// never had -- a fabricated plausible output at the exact seam that decides whether to keep going --
// so both are mapped into one outcome vocabulary instead.
//
// A FILE WRITE REQUIRES AN ANCHORED TRANSPORT, and that is a property of the types rather than a
// check. `converge_typed_remote_file` needs the SshTarget and the sealed FleetSshExecutionContext;
// `SshShell` carries neither and asserts no trust facts, so there is nothing to hand it. Refusing
// there is correct rather than restrictive: delivering a unit file over an unverified route is
// exactly the posture the credential lane exists to make unreachable.
func spark_serving_run_operation(
  operation: RemoteOperation,
  transport: HostEffectTransport,
) -> RemoteOperationOutcome
  uses net: Network
{
  match operation {
    RemoteArgv { argv: argv } =>
      match run_typed_argv_transport(argv: argv, transport: transport) {
        TypedArgvExecRefused { reason: why } => RemoteOperationRefused { reason: why }
        TypedArgvExecConverged { result: r } =>
          if r.success {
            RemoteOperationSucceeded { label: join(argv, " ") }
          } else {
            RemoteOperationRefused {
              reason: join([
                "argv exit=", to_string(r.exit_code), " stderr=", r.stderr,
              ], ""),
            }
          }
      }
    RemoteFileBytes { write: w, mode: m } =>
      match transport {
        FleetSsh { target: t, context: ctx } =>
          match converge_typed_remote_file(
            target: t,
            context: ctx,
            admission: TypedRemoteFileWriteAdmitted { write: w },
            mode: m,
          ) {
            TypedRemoteFileConvergenceRefused { step: step, reason: why } =>
              RemoteOperationRefused {
                reason: join(["file-write refused at ", step, ": ", why], ""),
              }
            TypedRemoteFileConverged { path: p, mode: _ } =>
              RemoteOperationSucceeded {
                label: join(["write-file ", p as String], ""),
              }
          }
        LocalShell =>
          RemoteOperationRefused {
            reason: "file write requires an anchored FleetSsh transport; LocalShell carries no remote target",
          }
        SshShell { ssh_host: h } =>
          RemoteOperationRefused {
            reason: join([
              "file write requires an anchored FleetSsh transport; SshShell(", h as String,
              ") carries no verified credential or known-hosts anchor",
            ], ""),
          }
        EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
          RemoteOperationRefused {
            reason: "file write requires an anchored FleetSsh transport; EmitArtifactThenThinRun is not a live session",
          }
      }
  }
}

// ORDERED, HALT ON FIRST FAILURE. These effects are sequential -- a unit file must exist before the
// manager reloads, and the manager must have reloaded before the unit enables -- so running the tail
// after a failed head would actuate against a state the plan never described. The accumulator is a
// coproduct rather than a sentinel outcome, because "nothing has run yet" and "something ran and
// refused" are different states and a reason string cannot be trusted to distinguish them.
type SparkServingSequenceAcc =
    SparkServingSequenceNotStarted
  | SparkServingSequenceOutcome { outcome: RemoteOperationOutcome }

func spark_serving_sequence_step(
  acc: SparkServingSequenceAcc,
  operation: RemoteOperation,
  transport: HostEffectTransport,
) -> SparkServingSequenceAcc
  uses net: Network
{
  match acc {
    SparkServingSequenceNotStarted =>
      SparkServingSequenceOutcome {
        outcome: spark_serving_run_operation(operation: operation, transport: transport),
      }
    SparkServingSequenceOutcome { outcome: prior } =>
      match prior {
        RemoteOperationRefused { reason: _ } => acc
        RemoteOperationSucceeded { label: _ } =>
          SparkServingSequenceOutcome {
            outcome: spark_serving_run_operation(operation: operation, transport: transport),
          }
      }
  }
}

func spark_serving_run_operation_sequence(
  operations: List<RemoteOperation>,
  transport: HostEffectTransport,
) -> RemoteOperationOutcome
  uses net: Network
{
  match fold(
    operations,
    init: SparkServingSequenceNotStarted,
    f: fn(acc, op) { spark_serving_sequence_step(acc: acc, operation: op, transport: transport) },
  ) {
    SparkServingSequenceNotStarted =>
      RemoteOperationRefused {
        reason: "spark_serving_converge_apply: empty operation sequence executed nothing",
      }
    SparkServingSequenceOutcome { outcome: o } => o
  }
}
