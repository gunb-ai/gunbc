  content_hash_atom,
  content_hash_combine_structural,
  content_hash_eq_structural,
  content_hash_tagged_structural,
}
import extdeps.external_authority { ExternalAuthority, CitedFigureStanding, CitedToAuthority, TranscribedUncited, cited_figure_read_obligation }
import extdeps.libxcrypt.crypt_scheme {
  CryptSchemeFormat,
  Sha512CryptFormat,
  cost_field_is_well_formed,
  crypt_acceptance_rules,
  crypt_reserved_characters,
  digest_characters_are_admitted,
  salt_holds_only_admitted_characters,
  shared_restriction_rejects,
  sha512_crypt_figure_read_obligation,
  sha512_crypt_format,
}
import extdeps.uri { Uri, Https }
import extdeps.os.ubuntu_autoinstall {
  AutoinstallIdentity,
  AutoinstallStoragePolicy,
  StoragePolicyDirectLayout,
}
import extdeps.ssh.keys { SshPublicKey, ssh_public_key_line }
import extdeps.storage.types {
