module gunbc.provisioning.network_boot_actuation

import std.decl_ref { DeclarationRef, decl_ref }
import std.dissolution { DissolutionCondition, BoundDissolution, DeclarationAppears }
import extdeps.bmc.types { RedfishBootSourceOverrideTarget }
import gunbc.fleet.site_pxe_edge_converge { SitePxeEdgePinnedChain }
import gunbc.provisioning.ubuntu_network_origin_observation { UbuntuNetworkOrigin }
import gunbc.machine_intake.subject { UnitKey, IntakeAttemptId }
import gunbc.provisioning.ubuntu_autoinstall_seed {
  UbuntuAutoinstallSeed,
  UbuntuAutoinstallSeedBinding,
  ProvisioningTargetAdmission,
  TargetDiskSelection,
  bind_ubuntu_autoinstall_seed,
  Bound,
  BindRefused,
}
import gunbc.provisioning.provisioning_arm {
  ProvisioningArm,
  AttemptBinding,
  ArmShape,
  ArmedPxeOrUefiHttp,
  ArmedVirtualMedia,
  ArmUnobserved,
  ArmRefused,
  SeedBindingRefused,
  DeliveryStrategy,
  DeliveryEvidence,
  provisioning_arm_derive,
  FirmwarePreparation,
}
import gunbc.os_install_mechanism { OsInstallMechanism, PxeHttpInstall, VirtualMediaInstall, install_boot_target_for }

// THE EXECUTING CONSUMER OF AN ArmShape (the frontier gunbc.provisioning.provisioning_arm
// `provisioning_arm_consumer_frontier` binds to `network_boot_arm_actuator_steps`). It runs nothing:
// the value it returns is the statement of what one attempt will do, and each effect still goes through
// its own admission and approval.
//
// WHAT THE ACTUATION CARRIES IS WHAT THE ARM BOUND. The pinned loader chain, the network origin, the
// seed binding and the firmware preparation travel into the result, so two armed attempts that differ in
// any of them produce different actuations. An actuation built from the mechanism constant alone would
// be identical for all of them, and the arm's whole job -- checking and binding those fields -- would be
// discharged by name only.
//
// NO EXPORT PARAMETER, AND NO PLAN. The step builder gunbc.nbd_proxy_virtual_media_install
// `os_install_actuator_plan` reads its `export` only for NbdProxyVirtualMediaInstall; the two mechanisms
// an arm can name (PxeHttpInstall, VirtualMediaInstall) ignore it, so calling it from here would force
// this module to invent a serve interface it never uses. The actuation therefore names the mechanism
// and its boot target, both from the existing install-mechanism vocabulary; assembling steps from a
// mechanism stays with that builder at the point an export actually exists.
//
// One arm yields one mechanism. A Withheld arm keeps its shape intact: there is no other arm to fall back
// to, so a blocked arm cannot become the other strategy here. Nothing reads the attempt's unit; it is
// copied through as data.
type NetworkBootActuation
  = ArmActuationPxe {
      attempt: AttemptBinding
      mechanism: OsInstallMechanism
      boot_target: RedfishBootSourceOverrideTarget
      chain: SitePxeEdgePinnedChain
      firmware: FirmwarePreparation
      origin: UbuntuNetworkOrigin
      seed: UbuntuAutoinstallSeedBinding
    }
  | ArmActuationVirtualMedia {
      attempt: AttemptBinding
      mechanism: OsInstallMechanism
      boot_target: RedfishBootSourceOverrideTarget
      media_observation: DeclarationRef
      origin: UbuntuNetworkOrigin
      seed: UbuntuAutoinstallSeedBinding
    }
  | ArmActuationWithheld {
      attempt: AttemptBinding
      shape: ArmShape
    }

fn network_boot_arm_actuator_steps(arm: ProvisioningArm) -> NetworkBootActuation {
  match arm.shape {
    ArmedPxeOrUefiHttp { chain: c, firmware: f, origin: o, seed: s } =>
      ArmActuationPxe {
        attempt: arm.attempt,
        mechanism: PxeHttpInstall,
        boot_target: install_boot_target_for(mechanism: PxeHttpInstall),
        chain: c,
        firmware: f,
        origin: o,
        seed: s,
      }
    ArmedVirtualMedia { media_observation: m, origin: o, seed: s } =>
      ArmActuationVirtualMedia {
        attempt: arm.attempt,
        mechanism: VirtualMediaInstall,
        boot_target: install_boot_target_for(mechanism: VirtualMediaInstall),
        media_observation: m,
        origin: o,
        seed: s,
      }
    ArmUnobserved { missing: _ } => ArmActuationWithheld { attempt: arm.attempt, shape: arm.shape }
    ArmRefused { cause: _ } => ArmActuationWithheld { attempt: arm.attempt, shape: arm.shape }
  }
}

// THE INSTALL-ATTEMPT-RECORD STEP: the one production call of the sealed binder. An UbuntuAutoinstallSeedBinding
// is minted only by bind_ubuntu_autoinstall_seed, so the seed an arm carries is never typed by hand; this entry
// takes the raw seed, target, unit key, intake attempt and live disk selection, binds, and only then derives
// the arm and actuates it. The strategy is a single parameter: one strategy per attempt, and a refused binding
// is Withheld, never re-armed as the other delivery. `evidence.seed` is overwritten by the binding, so a
// caller cannot present a seed that the binder did not mint for this attempt. A refused binding is
// Withheld as ArmRefused { SeedBindingRefused { blocker } }: the binder's own typed blocker survives to the
// result, never degraded to an absence.
fn network_boot_attempt_actuation(
  strategy: DeliveryStrategy,
  evidence: DeliveryEvidence,
  attempt: AttemptBinding,
  seed: UbuntuAutoinstallSeed,
  target: ProvisioningTargetAdmission,
  unit_key: UnitKey,
  intake_attempt: IntakeAttemptId,
  selection: TargetDiskSelection,
) -> NetworkBootActuation {
  match bind_ubuntu_autoinstall_seed(seed: seed, target: target, unit_key: unit_key, attempt: intake_attempt, selection: selection) {
    Bound { binding: b } =>
      network_boot_arm_actuator_steps(arm: provisioning_arm_derive(
        strategy: strategy,
        evidence: DeliveryEvidence {
          firmware: evidence.firmware,
          chain: evidence.chain,
          virtual_media: evidence.virtual_media,
          origin: evidence.origin,
          seed: Present { value: b },
        },
        attempt: attempt,
      ))
    BindRefused { blocker: b } =>
      ArmActuationWithheld { attempt: attempt, shape: ArmRefused { cause: SeedBindingRefused { blocker: b } } }
  }
}

// THE PRODUCTION CONSUMER OF network_boot_attempt_actuation DOES NOT EXIST YET. No module on main calls
// provisioning_arm_derive or network_boot_arm_actuator_steps outside the two frontiers that name them, so
// there is no boundary to wire it into today; the only caller is its witness. The consumer is the
// install-attempt record step that opens one attempt for a unit (S9a, the mtcollins1 control netboot, is the
// first wet user and is gated on the srv4 readback). That step must call this entry and never
// provisioning_arm_derive or network_boot_arm_actuator_steps directly, or the seed is no longer always
// minted by the sealed binder. The name below is coined here, as S5 coined network_boot_arm_actuator_steps:
// it is read off no existing module. Discharge-by-name proves only that the declaration exists, never that it
// calls this entry, so Fired would still not mean the binder is on the production path; that check stays
// with the review of the step that introduces it.
data network_boot_attempt_actuation_consumer_frontier: DissolutionCondition = BoundDissolution {
  trigger: DeclarationAppears { ref: network_boot_attempt_actuation_consumer_ref() },
}

fn network_boot_attempt_actuation_consumer_ref() -> DeclarationRef {
  decl_ref(module_path: "gunbc.provisioning.network_boot_install_attempt", decl_name: "network_boot_install_attempt_step")
}
