// ---------------------------------------------------------------------------
// 4b. ARCHITECTURE ROWS: which architecture a silence was established for, and what a target may install.
// ---------------------------------------------------------------------------

// WHICH ARCHITECTURE A SILENCE WAS ESTABLISHED FOR, and which seed may therefore use it. This is a row-level
// fact and not a global one: the arm64 archive and the amd64 archive are different trees with different builds
// of the same source, and the same name can be silent on one and prompt on the other. The two spellings are
// deliberately separate from `extdeps.toolchain.types.Architecture`, which is the ARCHITECTURE OF A TARGET and
// is used for admission; this one is the ARCHITECTURE OF AN ARTIFACT, and the gate below is precisely the
// statement that the two agree. Collapsing them would let a target's own value be copied into an artifact's
// field by whoever wrote the row, which is the same failure the module already forbids between a package name
// and the name written inside its receipt.
type SilencedArchitecture = Amd64Architecture | Arm64Architecture

// ROW EQUALITY ON THE ARTIFACT ARCHITECTURE, WRITTEN AS A MATCH AND NOT AN `==` OVER THE VALUES. The repo
// carries its own warning (gunbc.recurring_failure_mode.optional_equality_answers_by_representation) that
// comparing two values of a sum type can answer by representation rather than meaning; the comparison is
// spelled out over the two constructors instead of relying on the structural `==`.
fn silenced_architecture_eq(left: SilencedArchitecture, right: SilencedArchitecture) -> Bool {
  match left {
    Amd64Architecture =>
      match right {
        Amd64Architecture => true
        Arm64Architecture => false
      }
    Arm64Architecture =>
      match right {
        Amd64Architecture => false
        Arm64Architecture => true
      }
  }
}

// ONE ADMITTED PACKAGE ROW. `architecture` is the axis the seed's target is matched against; `receipt` carries
// everything else the silence claim needs (name, version, standing, citation). Rows are the only way a package
// enters a seed: an architecture with no rows is not a platform this module can build a seed for, and the
// admit door refuses it rather than producing a seed whose every package claim is unverifiable.
type SeedPackageRow sole_constructor {
  architecture: SilencedArchitecture
  receipt: PackageSilenceReceipt
}

// THE ADMITTED SET. Two architectures, each carrying the packages verified silent for IT, including
// architecture-exclusive rows: the arm64 set has no amd64-microcode because no arm64 build carries Intel/AMD
// microcode, and the amd64 set has no counterpart to a hypothetical arm64-only package by the same rule. A
// third architecture (say riscv64) becomes provisionable by adding rows here — the door's rule and the audit's
// gate change for nobody.
fn seed_package_rows() -> List<SeedPackageRow> {
  [
    // ARM64 (the ASRock Rack ALTRAD8UD-2T32F fleet).
    SeedPackageRow {
      architecture: Arm64Architecture,
      receipt: nvme_cli_silence_receipt,
    },
    SeedPackageRow {
      architecture: Arm64Architecture,
      receipt: ipmitool_silence_receipt,
    },
    SeedPackageRow {
      architecture: Arm64Architecture,
      receipt: dmidecode_silence_receipt,
    },
    SeedPackageRow {
      architecture: Arm64Architecture,
      receipt: rasdaemon_silence_receipt,
    },
    // AMD64 (the Supermicro H11SSL family). The first four are the same diagnostic and BMC tooling the arm64
    // board installs, re-verified against this architecture's own builds; the fifth is x86's CPU firmware.
    SeedPackageRow {
      architecture: Amd64Architecture,
      receipt: nvme_cli_amd64_silence_receipt,
    },
    SeedPackageRow {
      architecture: Amd64Architecture,
      receipt: ipmitool_amd64_silence_receipt,
    },
    SeedPackageRow {
      architecture: Amd64Architecture,
      receipt: dmidecode_amd64_silence_receipt,
    },
    SeedPackageRow {
      architecture: Amd64Architecture,
      receipt: rasdaemon_amd64_silence_receipt,
    },
    SeedPackageRow {
      architecture: Amd64Architecture,
      receipt: amd64_microcode_silence_receipt,
    },
  ]
}

// THE TARGET'S ARCHITECTURE SAID IN THE ARTIFACT'S VOCABULARY, or Absent when the target names an architecture
// nobody has admitted artifact rows for. This is the ONLY place the two vocabularies meet, and it is a total
// match over Architecture: a new target architecture lands in Absent, which the door reads as "refuse", until
// somebody authors its rows.
fn seed_architecture_of(architecture: Architecture) -> Optional<SilencedArchitecture> {
  match architecture {
    Aarch64 => Present { value: Arm64Architecture }
    X86_64 => Present { value: Amd64Architecture }
    _ => Absent
  }
}

// THE ADMIT DOOR'S ROW LOOKUP. Absent means no architecture row was found, which the door reads as a refusal —
// not as a default, and not as a branch that names a board or a family.
fn find_seed_architecture_row(architecture: Architecture) -> Optional<SeedPackageRow> {
  match seed_architecture_of(architecture: architecture) {
    Absent => Absent
    Present { value: wanted } =>
      seed_package_rows().filter(row =>
        silenced_architecture_eq(left: row.architecture, right: wanted)
      ).first()
  }
}

// ROW EQUALITY ON THE ARTIFACT ARCHITECTURE, WRITTEN AS A MATCH AND NOT AN `==`. The repo carries its own
// warning (gunbc.recurring_failure_mode.optional_equality_answers_by_representation) that comparing two values
// of a sum type answers by representation rather than meaning; a nullary-variant equality is exactly the shape
// that warning names, so the comparison is spelled out over the two constructors instead.

// THE DOOR'S REAL PREDICATE: not "does the architecture have a row" but "does it have a row THAT CAN CARRY A
// CLAIM INTO A SEED". A row set consisting only of receipts the audit would refuse is an architecture admitted
// in name only, so the door applies the same test the audit will, on the same rows. Admitting an architecture
// with no rows at all is therefore impossible, and it is impossible because of a fact about the rows rather
// than because a match arm says so.
fn architecture_row_admissible(
  row: SeedPackageRow,
  architecture: Architecture,
) -> Bool {
  match blocking_refusal(
    intent: PackageVerifiedSilent { silence: row.receipt },
    architecture: architecture,
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE AUDIT'S ARCHITECTURE GATE, as a function the door and the audit share. The name is checked against the
// ADMITTED ROWS for the target's architecture — the receipt's own architecture field is authoritative for what
// was verified, and this is where it is required to agree with the target. A package with no row for the
// target's architecture is refused even when the identical package name is admitted for another one: arm64's
// verified nvme-cli says nothing about the amd64 build, and an amd64 seed asking for an arm64-only row is the
// mistake this refuses — a package the target's own archive never promised was silent.
fn architecture_admits_package(
  architecture: Architecture,
  package: NonEmptyStr,
) -> Bool {
  match seed_architecture_of(architecture: architecture) {
    Absent => false
    Present { value: wanted } =>
      seed_package_rows().filter(row =>
        silenced_architecture_eq(left: row.architecture, right: wanted)
          && silenced_package(receipt: row.receipt) == package
      ).count() > 0
  }
}

// THE ARCHITECTURE A RECEIPT ITSELF WAS READ OFF. The type carries it as a field; reading it back is what lets
// a seed be audited against the evidence rather than against a name the caller repeated.
fn silenced_receipt_architecture(receipt: PackageSilenceReceipt) -> SilencedArchitecture {
  match receipt {
    SilentReceipt { package: _, architecture: arch, observed_version: _, standing: _ } => arch
  }
}

// IS THIS VERY RECEIPT ADMITTED FOR THIS ARCHITECTURE? Two conditions, both required, and the first is the one
// that cannot be faked by a caller who has read the row table but not the artifact:
//   1. the architecture the RECEIPT claims to have been read off must BE the seed's architecture — an arm64
//      receipt carried into an amd64 seed refuses whatever its package name is, because the .deb it was read
//      from is a different build;
//   2. a row must actually be shipped for that (architecture, package) pair, so a receipt with a plausible
//      architecture field that nobody admitted still refuses.
// The equality goes through silenced_architecture_eq rather than == because these are nullary-variant values
// and the repo's own rule is that comparison over them goes through a match (recurring_failure_mode.
// optional_equality_answers_by_representation).
fn silence_receipt_is_admitted_for(
  receipt: PackageSilenceReceipt,
  architecture: Architecture,
) -> Bool {
  match seed_architecture_of(architecture: architecture) {
    Absent => false
    Present { value: wanted } =>
      match silenced_architecture_eq(
        left: silenced_receipt_architecture(receipt: receipt),
        right: wanted,
      ) {
        False => false
        True =>
          architecture_admits_package(
            architecture: architecture,
            package: silenced_package(receipt: receipt),
          )
      }
  }
}

// THE ADMITTED PACKAGE ROWS FOR A TARGET, as intents. A witness or a caller builds a seed's package list from
// here rather than by hand-pairing a name with a receipt; the pairing cannot go wrong because there is no
// place left to put it wrong.
fn package_rows_for_architecture(architecture: Architecture) -> List<PackageIntent> {
  match seed_architecture_of(architecture: architecture) {
    Absent => []
    Present { value: wanted } =>
      seed_package_rows().filter(row =>
        silenced_architecture_eq(left: row.architecture, right: wanted)
      ).map(row => PackageVerifiedSilent { silence: row.receipt })
  }
}

// THE KERNEL-MODULE AXIS, KEPT APART BECAUSE IT IS NOT CHECKABLE AGAINST APT. What the board must have loaded
// inside the installer environment is not something the installer can apt-install: the installer's kernel is
// already running, so a `.ko` is a claim about which kernel package carries it, verified against the source
// tree that declares it. The rule that makes a row legal is the TRISTATE: a `bool` Kconfig symbol is built in
// and cannot be a module at all, so a row claiming one names a file no modules/* tree contains; a `tristate`
// symbol can be `m`, and the Makefile line `obj-$(CONFIG_X) += <stem>.o` is what names the object. Each row
// below was read at v6.8 — the GA flavour this fleet ships — at elixir.bootlin.com/linux/v6.8/source/<path>,
// and the symbol/stem pair is carried as data so a reviewer can check one row without reading code. A row
// whose symbol turns out to be `bool` is not a typo to fix but a row to DELETE: the thing it names is not
// loadable, and no seed may claim otherwise.
//
// THE FIRST FOUR ARE WHAT THE INSTALLER MUST DRIVE; THE LAST THREE ARE DERIVED FROM THE RECEIVED TRANSPORT.
// nvme/ahci_platform/r8169/realtek are the disk and NIC the installer has to open. usb-storage/uas/sd_mod
// exist here because a BMC virtual-media install hands the board a USB mass-storage device — a board missing
// those three cannot read the media it is installing from. That is a consequence of the delivery strategy
// arriving as data, not a machine-name branch: the same rule would fire for any unit delivered that way.
// AhciModule and IgbNicModule are the H11SSL family's own two: the chipset's SATA controller and its i210
// management NIC, each admitted as a row (name + symbol + file) rather than as a branch on a board.
type LoadableModuleClass =
    NvmeBlockModule
  | AhciPlatformModule
  | AhciModule
  | IgbNicModule
  | R8169NicModule
  | RealtekPhyModule
  | UsbStorageModule
  | UasModule
  | SdModuleModule

fn loadable_module_name(driver: LoadableModuleClass) -> NonEmptyStr {
  match driver {
    NvmeBlockModule => "nvme"
    AhciPlatformModule => "ahci_platform"
    AhciModule => "ahci"
    IgbNicModule => "igb"
    R8169NicModule => "r8169"
    RealtekPhyModule => "realtek"
    UsbStorageModule => "usb-storage"
    UasModule => "uas"
    SdModuleModule => "sd_mod"
  }
}

// WHICH KCONFIG SYMBOL DECLARES THE MODULE, AND IN WHICH FILE IT WAS READ. Derived pairs, so a row cannot
// carry a stem that its own symbol's Makefile line does not produce. BOTH are rendered into the seed token: the
// citation is part of what the seed CLAIMS (this module asserts that this symbol, in this file, was read as
// `tristate`), so it belongs in the digest — and a provenance the digest cannot see is a provenance that can be
// changed without any witness noticing.
fn loadable_module_kconfig_symbol(driver: LoadableModuleClass) -> NonEmptyStr {
  match driver {
    NvmeBlockModule => "BLK_DEV_NVME"
    AhciPlatformModule => "SATA_AHCI_PLATFORM"
    // CONFIG_SATA_AHCI is the H11SSL chipset's own AHCI host controller driver (v6.8: a `tristate` stanza
    // in drivers/ata/Kconfig, built by drivers/ata/Makefile's obj-$(CONFIG_SATA_AHCI) += ahci.o). It is a
    // different symbol from SATA_AHCI_PLATFORM above, which is why it is its own row: two names, two
    // stanzas, two failure modes.
    AhciModule => "SATA_AHCI"
    // CONFIG_IGB is the driver for the i210 gigabit NIC on the H11SSL's management path (v6.8: a
    // `tristate` stanza in drivers/net/ethernet/intel/Kconfig, built by drivers/net/ethernet/intel/Makefile's
    // obj-$(CONFIG_IGB) += igb/igb.o). The i210's device id 0x1533 is claimed in the igb driver's own
    // pci_device_id table (drivers/net/ethernet/intel/igb/igb_main.c), which is what ties THIS module to
    // THIS board's silicon rather than merely to a plausible name.
    IgbNicModule => "IGB"
    R8169NicModule => "R8169"
    RealtekPhyModule => "REALTEK_PHY"
    UsbStorageModule => "USB_STORAGE"
    UasModule => "USB_UAS"
    SdModuleModule => "BLK_DEV_SD"
  }
}

fn loadable_module_kconfig_path(driver: LoadableModuleClass) -> NonEmptyStr {
  match driver {
    NvmeBlockModule => "drivers/nvme/host/Kconfig"
    AhciPlatformModule => "drivers/ata/Kconfig"
    AhciModule => "drivers/ata/Kconfig"
    IgbNicModule => "drivers/net/ethernet/intel/Kconfig"
    R8169NicModule => "drivers/net/ethernet/realtek/Kconfig"
    RealtekPhyModule => "drivers/net/phy/Kconfig"
    UsbStorageModule => "drivers/usb/storage/Kconfig"
    UasModule => "drivers/usb/storage/Kconfig"
    SdModuleModule => "drivers/scsi/Kconfig"
  }
}

// THE POST-INSTALL MODULE SET, CLOSED FOR THE SAME REASON AND SEPARATED FOR A DIFFERENT ONE. These are the
// modules the RUNNING system needs that the installer did not have to have — the BMC channels through which
// anyone sees this board at all, and the display path the BMC's video pipeline offers. Same tristate rule as
// above: each row is a `tristate` stanza in the named file with the named Makefile object (v6.8,
// drivers/char/ipmi/Kconfig + Makefile, drivers/gpu/drm/ast/Kconfig + Makefile).
type LateDriver = KipmiIpmbDriver | KipmiSiDriver | Ast2500DrmDriver | IpmiWatchdogDriver

fn late_driver_module(driver: LateDriver) -> NonEmptyStr {
  match driver {
    KipmiIpmbDriver => "ipmi_ipmb"
    KipmiSiDriver => "ipmi_si"
    Ast2500DrmDriver => "ast"
    IpmiWatchdogDriver => "ipmi_watchdog"
  }
}

fn late_driver_kconfig_symbol(driver: LateDriver) -> NonEmptyStr {
  match driver {
    KipmiIpmbDriver => "IPMI_IPMB"
    KipmiSiDriver => "IPMI_SI"
    Ast2500DrmDriver => "DRM_AST"
    IpmiWatchdogDriver => "IPMI_WATCHDOG"
  }
}

// THE AUTHORITY FOR THE MODULE AXES: the source tree the tristate stanzas were read from. Carried as data so
// a witness can name it and a reviewer can follow it; the per-row path above is where to look within it.
data module_axis_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "elixir.bootlin.com/linux/v6.8/source"
  }
}

// THE AUTHORITY FOR THE PACKAGE AXIS: the archive the four package names were resolved against, for arm64
// specifically. An x86-only package would pass a name check against the wrong architecture's index and fail
// on the board, which is why the architecture is part of the authority rather than an assumption beside it.
data package_axis_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "packages.ubuntu.com/noble/arm64"
  }
}

// WHERE THE OPEN WORLD ENTERS, AND WHICH QUESTION THE CALLER HAS TO ANSWER TO DO IT. The closed sets cannot
// express "this fleet also wants the node exporter", so an intent enters — but it enters as ONE OF THREE
// CLOSED ARMS, not as a string. The first version of this type was `{ name: NonEmptyStr, debconf_seed:
// Optional<NonEmptyStr> }`, and that string was the hole: the audit could only ask whether the name appeared
// in the prompting table, and a name that did not appear fell through to "nothing to answer", so ANY
// prompting package outside the table got a green non-interactive proof. That is a fabricated default under
// DESIGN.md §5 ("no plausible output is fabricated"), and the module's own comment above the table said the
// opposite — an unclassified package is absent evidence, never cleared.
//
// THE THREE ARMS ARE THE THREE STATES OF KNOWLEDGE, WHICH A STRING CANNOT EXPRESS.
//   * QuestionAnswered: the package is in the table AND an answer was supplied. The audit counts it closed.
//   * QuestionUnanswered: the package is in the table AND nobody supplied an answer. The audit refuses with
//     the question named, so the operator sees which debconf key to seed.
//   * Unclassified: nobody has checked whether it prompts. The audit REFUSES, because the seed's claim is
//     "nothing will ever be asked" and an unchecked package cannot support that claim. It is not refused
//     because the package is bad; it is refused because THIS MODULE DOES NOT KNOW, and Unobserved is a
//     first-class verdict here rather than an error.
// The name lives in exactly one place for the known arms (known_prompting_package_name, below), which is also
// what makes a drift between the table and the audit impossible: there is no second spelling to drift.
// THE FOURTH ARM, WHICH THIS TYPE ALWAYS SAID IT WOULD ONE DAY HAVE. A package whose prompting has been
// checked and found SILENT is a fourth state of knowledge, not a fifth spelling of the third: it is neither
// "answered" (nothing was asked, so nothing was answered) nor "unclassified" (someone looked). Its absence was
// the reason a headless board's late package set could not be stated at all — nvme-cli, ipmitool and dmidecode
// ask nothing, so under three arms the only honest way to name them was Unclassified, which the audit refuses,
// which meant every "produced seed" fixture had to pass `late_packages: []` and the witness that claimed the
// seed installs the BMC/diagnostic tooling was asserting properties of an empty list. Loosening Unclassified into
// a pass would have fixed that witness by making it lie; this arm fixes it by making the claim checkable.
//
// WHAT MAKES A ROW LEGAL IS THE EVIDENCE IN THE ARM, NOT THE NAME. A silence claim means: the package exists in
// THIS archive at THIS version, and the shipped control tarball for that version contains no config script and
// its data tarball ships no debconf templates — i.e. nothing in the package can call db_input or db_fget at the
// version the board will install. That is why the version travels with the claim: silence is a property of a
// build, not of a name, and an upstream that adds a config script in the next point release has invalidated the
// row while leaving the name intact. A future package adds a row to the set below (or a caller mints a receipt
// of its own); nothing about the audit changes.
type PackageIntent =
    QuestionAnswered { package: KnownPromptingPackage, answers: List<DebconfSelectionRecord> }
  | QuestionUnanswered { package: KnownPromptingPackage }
  | UnclassifiedPackage { name: NonEmptyStr, answers: List<DebconfSelectionRecord> }
  | PackageVerifiedSilent { silence: PackageSilenceReceipt }

// THE ONE MINT FOR AN ANSWER, and the reason it returns a LIST rather than an Optional. The record's legality is
// decided by extdeps.debian.debconf's constructor — no whitespace in a key field, a non-empty value — and a
// consumer that had to unwrap an Optional at every literal would be tempted to mint around it. Collapsing an
// illegal attempt to NO RECORDS is the safe direction and cannot certify anything: no record means the required
// key is unestablished, the verdict is OpenQuestion, and the seed is refused. An answer that would have been
// silently mis-parsed by the old tokenizer (an owner with a space in it, a value with nothing in it) now becomes
// a refused seed instead of a green proof.
// THE KIND IS A DebconfAnswerKind, NOT THE WIRE UNION (review 83188). A caller assembling a seed cannot name a
// flag at all through this door, so it cannot author a line it might then expect to close a question; the flag
// remains representable on the shelf (extdeps.debian.debconf's debconf_flag_record, exercised by the witness
// because a real preseed does contain flag lines), and it stays inert here because the crediting path asks the
// shelf for an ANSWER KIND and a flag has none.
fn debconf_answer(
  owner: NonEmptyStr,
  kind: DebconfAnswerKind,
  label: NonEmptyStr,
  value: NonEmptyStr,
) -> List<DebconfSelectionRecord> {
  match debconf_answer_record(owner: owner, label: label, kind: kind, value: value) {
    // THE MINT'S OWN TWO ARMS. Collapsing an illegal attempt to NO RECORDS is still the safe direction and
    // certifies nothing — no record means the required key is unestablished, the verdict is OpenQuestion, and
    // the seed is refused — but the refusal now travels as a typed cause rather than as an absence, so nothing
    // downstream is tempted to ask "why" by re-running the mint's own checks.
    MintedSelection { record: record } => [record]
    RefusedAtTheMint { cause: _ } => []
  }
}

// THE SAME ANSWER UNDER THE PACKAGE'S OWN NAME, which is the form almost every caller wants: the owner is not a
// free string to get wrong, it is read from the known package the arm already names.
fn debconf_answer_for(
  package: KnownPromptingPackage,
  kind: DebconfAnswerKind,
  label: NonEmptyStr,
  value: NonEmptyStr,
) -> List<DebconfSelectionRecord> {
  debconf_answer(
    owner: known_prompting_package_name(package: package),
    kind: kind,
    label: label,
    value: value,
  )
}

// THE WARRANT BEHIND A SILENCE CLAIM, AND HOW FAR IT REACHES. `observed_version` is the build the claim was made
// against, and it travels with the claim because silence is a property of a BUILD, not of a name: an upstream
// that grows a config script in the next point release has invalidated the row while leaving the name — and any
// check that looks only at the name — intact.
//
// THE STANDING IS THE SHARED ONE, NOT A LOCAL INVENTION. extdeps.external_authority carries
// CitedFigureStanding precisely so that a second "cited / transcribed / observed" coproduct cannot be minted per
// domain; a local twin would have let a silence row claim a rung the corpus does not recognise. Its third arm
// (ObservedByReceipt) is sealed upstream, which is the right strictness: a receipt of our own observation is
// minted only by a fold that reads committed data, never by hand.
// THE RECEIPT NAMES THE PACKAGE IT WAS ESTABLISHED FOR, and the intent arm below therefore carries the receipt
// and NOTHING ELSE (review: merry-fox-82, HOLD section 5). The arm used to spell the name a second time beside
// the receipt, so a reader could pair nvme-cli's version and citation with a claim about ipmitool and the audit
// would emit NothingToAsk for a package whose silence nobody ever established. One name, in the evidence; the
// verdict reads it out rather than being handed it. A future silent package authors its own receipt — the name
// comes along for free and cannot be left behind.
type PackageSilenceReceipt = SilentReceipt {
  package: NonEmptyStr
  architecture: SilencedArchitecture
  observed_version: NonEmptyStr
  standing: CitedFigureStanding
}

// WHICH PACKAGE A SILENCE CLAIM IS ABOUT — read from the evidence, which is the only place it is written.
fn silenced_package(receipt: PackageSilenceReceipt) -> NonEmptyStr {
  match receipt {
    SilentReceipt { package: pkg, architecture: _, observed_version: _, standing: _ } => pkg
  }
}

// THE AUDIT'S VERDICT ON ONE INTENT, IN THE SAME THREE PARTS THE INTENT IS STATED IN. Derived, never stored:
// an intent that carried its own classification could disagree with the table it was checked against. The
// question text travels with the unanswered arm so a refusal names the debconf key to seed rather than
// pointing at a package and leaving the operator to look it up.
// THREE ANSWERS TO "DID IT ASK?", BECAUSE THEY SEND THE OPERATOR TO THREE DIFFERENT PLACES: closed needs
// nothing, open means go answer the named question in the seed, unclassified means nobody knows and the install
// is not authorised until somebody does. A fourth is now needed because the intent gained a fourth state:
type PackagePromptingVerdict =
    ClosedQuestion { name: NonEmptyStr, question: NonEmptyStr }
  | OpenQuestion { name: NonEmptyStr, question: NonEmptyStr }
  | UnclassifiedPrompting { name: NonEmptyStr }
  // SILENT IS NOT CLOSED. "Closed" would fold it into the same answer as "answered", and the tally's whole
  // meaning is the number of questions the seed CLOSED — a package that never asked one closed nothing. Naming
  // the receipt in the arm keeps the evidence attached to the verdict, so a consumer can refuse a silent row
  // whose standing is still transcribed instead of having to go and find the row again.
  | NothingToAsk { name: NonEmptyStr, silence: PackageSilenceReceipt }

// THE KEYS A ROW REQUIRES, WHICH IS NOT ALWAYS ONE (review: merry-fox-82). The shipped tzdata asks two:
// debian/tzdata.postinst does `db_get tzdata/Areas` and then `db_get "tzdata/Zones/$AREA"` — the zone key is
// PARAMETRIC on the area answer. Counting tzdata as a single question was the defect: a seed that supplied only
// the region closed the audit and still left the installer stopped on the zone, which is the hung unattended
// install this cut exists to prevent, reported as a pass. So the verdict is computed over EVERY key a row names,
// and the parametric key is spelled with its placeholder because the area is the operator's choice, not a fact
// this repository may fix. A future package that asks three things adds a third string here and the audit follows
// without an edit.
// THE REQUIREMENT IS A CLOSED SHAPE, NOT A KEY STRING WITH A TRAILING PLACEHOLDER. The earlier spelling was
// ["tzdata/Areas", "tzdata/Zones/"]: a truncated key that no record could ever carry, which is exactly why the
// substring audit passed it. A parametric question is a DIFFERENT KIND OF REQUIREMENT — it is answered by the key
// its own sibling answer builds — so it gets its own arm, and the join is executed by the auditor below instead
// of being written as prose. A package that asks a third fixed question adds a string to its list; a package
// whose second question is parametric on some other answer adds a ParametricKey arm naming which answer it reads.
type DebconfRequirement
  = FixedKey { key: NonEmptyStr }
  | ParametricKey { prefix: NonEmptyStr, answered_by: NonEmptyStr }

fn debconf_requirements(package: KnownPromptingPackage) -> List<DebconfRequirement> {
  match package {
    ConsoleSetupPackage => [FixedKey { key: "console-setup/ask_detect" as NonEmptyStr }]
    KeyboardConfigurationPackage => [FixedKey { key: "keyboard-configuration/layout" as NonEmptyStr }]
    // debian/tzdata.postinst: db_get tzdata/Areas, then db_get "tzdata/Zones/$AREA". The second question does
    // not exist as a name until the first is answered, so it is stated as a function of it.
    TzdataPackage => [
      FixedKey { key: "tzdata/Areas" as NonEmptyStr },
      ParametricKey { prefix: "tzdata/Zones/" as NonEmptyStr, answered_by: "tzdata/Areas" as NonEmptyStr },
    ]
    PostfixPackage => [FixedKey { key: "postfix/main_mailer_type" as NonEmptyStr }]
    NtpPackage => [FixedKey { key: "ntp/utc" as NonEmptyStr }]
    OpenSshServerPackage => [FixedKey { key: "openssh-server/password-authentication" as NonEmptyStr }]
    CloudInitPackage => [FixedKey { key: "cloud-init/datasources" as NonEmptyStr }]
  }
}

// THE LABEL A REQUIREMENT IS SATISFIED BY, or Absent when the answer it is parametric on was never established —
// in which case there is no label to look for and the requirement is unanswered, not silently skipped.
fn requirement_label(
  answers: List<DebconfSelectionRecord>,
  owner: NonEmptyStr,
  requirement: DebconfRequirement,
) -> Optional<NonEmptyStr> {
  match requirement {
    FixedKey { key: key } => Present { value: key }
    // The parametric label is BUILT FROM THE SIBLING RECORD'S VALUE, so the join between tzdata's area and its
    // zone key is a data dependency between two records rather than a string that has to appear in a blob.
    ParametricKey { prefix: prefix, answered_by: source } =>
      match value_established_for(records: answers, owner: owner, label: source) {
        Present { value: area } => Present { value: concat(prefix, area) as NonEmptyStr }
        Absent => Absent
      }
  }
}

// THE AUDIT ANSWERS KEYS, NOT PACKAGES, AND A KEY IS ANSWERED BY A RECORD AND NOTHING ELSE. Every key the row
// requires must be the LABEL of a record whose OWNER is this package and which carries a value, so a partially
// answered package stays an open question instead of being credited as closed. Absence of a record is the only
// honest "not answered": no sentinel, no empty string, no substring, and no text for a substring to live in.
fn package_prompting_verdict(intent: PackageIntent) -> PackagePromptingVerdict {
  match intent {
    QuestionAnswered { package: named, answers: answer } =>
      match all_required_keys_present(package: named, answers: answer) {
        False => OpenQuestion {
          name: known_prompting_package_name(package: named),
          question: known_prompting_package_question(package: named),
        }
        True => ClosedQuestion {
          name: known_prompting_package_name(package: named),
          question: known_prompting_package_question(package: named),
        }
      }
    QuestionUnanswered { package: named } => OpenQuestion {
      name: known_prompting_package_name(package: named),
      question: known_prompting_package_question(package: named),
    }
    // ANSWERS ATTACHED TO AN UNCLASSIFIED PACKAGE PROVE NOTHING. The refusal is about our IGNORANCE — nobody has
    // established whether this package prompts at all — and no volume of supplied answers can turn ignorance into
    // knowledge. A caller who has checked silence mints PackageVerifiedSilent with its receipt instead.
    UnclassifiedPackage { name: un, answers: _ } => UnclassifiedPrompting { name: un }
    PackageVerifiedSilent { silence: receipt } => NothingToAsk {
      name: silenced_package(receipt: receipt),
      silence: receipt,
    }
  }
}

// WHAT COUNTS AS AN ANSWER: AN ESTABLISHED RECORD, AND NOTHING ELSE.
//
// THERE IS NO PARSER HERE, AND THAT IS THE POINT (review 83132). An earlier revision of this section carried a
// hand-written tokenizer — a comment-skipping prefix, a four-field field splitter, a separator-run scanner, a
// space predicate — that took back a String this very module had authored and tried to recover its owner, label,
// type and value from it. That is DESIGN §2's String leaf hiding named parts, and §5's validation where §5 asks
// for construction: the parts were already known when the intent was built, so recovering them could only lose
// information or invent it. The defects it caused were the predictable ones. Because debconf's reader drops any
// line whose first non-space character is `#`, a line that merely MENTIONED a question closed the audit — a tzdata
// postinst commenting its own zone template while leaving the question live certified the whole seed
// non-interactive (merry-fox-82's catch), and each fix tightened the scanner instead of removing the text it was
// scanning.
//
// THE RECORDS COME FROM extdeps.debian.debconf, whose shelf owns the field count, the field order, the separator
// rule, the nine legal type words and the empty-value policy — because those are debconf's facts, in a package
// with its own version, and not ours (DESIGN §3). The consumer mints records through debconf_answer_for and reads
// them through the accessors; the wire line exists only as debconf_selection_line, derived at the moment something
// is shipped. The character classifier, the boundary scanner and the comment check are gone: with records there is no text to
// ask a question of, so "a comment is not an answer" is no longer a rule anybody has to remember correctly.
//
// THE VALUE IS REQUIRED. That policy moved to the shelf with the rest of the grammar, and it is stricter than
// upstream on purpose: upstream stores an EMPTY content when the fourth field is missing (debconf 1.5.86ubuntu1,
// debconf-set-selections lines 133-135), and an empty answer to `tzdata/Areas` selects no area, so the package
// asks the question anyway. Crediting it would certify a seed that hangs.
//
// A record whose LABEL names a question this module has no row for is KEPT, not dropped, and is inert: the audit
// only ever asks for a label it took from required_debconf_keys, so an unrecognised label can neither pass nor
// fail anything. Filtering here instead would mean a second copy of the key table — the same keys spelled twice,
// which is the drift §3 forbids and which an earlier revision of this module actually had.

// THE ONE THING THE AUDIT ASKS OF A RECORD LIST: does this owner carry a value under this label? Written once, and
// it is the only reader of the record fields anywhere in this module — no caller gets to inspect a record and
// decide for itself what counts.
//
// THE OWNER IS CHECKED, which is what makes an answer BELONG to a package: a record written for
// `keyboard-configuration` cannot close a tzdata question, and symmetrically — the half that matters on an 8-bay
// board — a record written for some other package can never close this package's question, so a seed cannot answer
// tzdata by mentioning tzdata inside another package's line. THE KIND IS CHECKED TOO: a `seen` line sets a flag on
// a question that must already exist, so it answers nothing, and a seed that certified a question closed by a flag
// would be hung by a package that still asks.
fn value_established_for(
  records: List<DebconfSelectionRecord>,
  owner: NonEmptyStr,
  label: NonEmptyStr,
) -> Optional<NonEmptyStr> {
  match records {
    Empty => Absent
    Cons { head: record, tail: rest } =>
      match debconf_selection_owner(record: record) == owner {
        True => match debconf_selection_label(record: record) == label {
          True =>
            // THE PROJECTION, NOT A PREDICATE (review 83188). Asking the shelf for the record's ANSWER KIND is
            // what credits it; a flag line has no DebconfAnswerKind to hand over, so the flag cannot be credited
            // by any call site — there is no Bool here for a future caller to ignore or invert.
            match debconf_selection_answer(record: record) {
              Present { value: _ } => Present { value: debconf_selection_value(record: record) }
              Absent => value_established_for(records: rest, owner: owner, label: label)
            }
          False => value_established_for(records: rest, owner: owner, label: label)
        }
        False => value_established_for(records: rest, owner: owner, label: label)
      }
  }
}

// THE AUDIT, OVER RECORDS. Every key the package will ask must be the LABEL of a record whose OWNER is the package
// and which carries a value. A mention, a flag line, a record belonging to another package, and a parametric key
// named in prose are all the same thing here: no record, no answer, seed refused.
fn all_required_keys_present(package: KnownPromptingPackage, answers: List<DebconfSelectionRecord>) -> Bool {
  match first_unestablished(
    needed: debconf_requirements(package: package),
    answers: answers,
    owner: known_prompting_package_name(package: package),
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

fn first_unestablished(
  needed: List<DebconfRequirement>,
  answers: List<DebconfSelectionRecord>,
  owner: NonEmptyStr,
) -> Optional<DebconfRequirement> {
  match needed {
    Empty => Absent
    Cons { head: requirement, tail: rest } =>
      match requirement_label(answers: answers, owner: owner, requirement: requirement) {
        // The label this requirement is answered under, looked up as a RECORD of this owner — so the answer must
        // exist, carry a value, and name this package.
        Present { value: label } =>
          match value_established_for(records: answers, owner: owner, label: label) {
            Present { value: _ } => first_unestablished(needed: rest, answers: answers, owner: owner)
            Absent => Present { value: requirement }
          }
        // Its sibling answer never existed, so this question cannot have been answered either. Reporting the
        // requirement (not a fabricated label) is what lets a consumer say which one is missing.
        Absent => Present { value: requirement }
      }
  }
}

// THE AREA/ZONE JOIN, AS AN ARM OF THE AUDIT RATHER THAN A COMMENT ABOUT IT. tzdata's second key is
// `tzdata/Zones/<area>`, so the zone record is looked up under the key the AREA RECORD BUILDS from its own value.
// Seeding `tzdata/Areas select Etc` while the only zone record is `tzdata/Zones/America` establishes nothing: the
// key built is tzdata/Zones/Etc, no record carries it, the verdict is OpenQuestion and the seed is refused. Under
// the old substring rule the bare word "America" anywhere in the seed — including inside a comment — passed this.
fn zone_key_for_area(area: NonEmptyStr) -> NonEmptyStr {
  concat("tzdata/Zones/", area) as NonEmptyStr
}

// THE ZONE KEY THE SEED'S OWN AREA ANSWER BUILDS, or Absent when no area is established. Exposed so a consumer
// can see WHICH area a seed committed to, rather than taking the join on faith.
fn established_zone_key(answers: List<DebconfSelectionRecord>, owner: NonEmptyStr) -> Optional<NonEmptyStr> {
  match value_established_for(records: answers, owner: owner, label: "tzdata/Areas" as NonEmptyStr) {
    Present { value: area } => Present { value: zone_key_for_area(area: area) }
    Absent => Absent
  }
}

// THE ONE PLACE A KNOWN PROMPTING PACKAGE'S NAME IS SPELLED, for the known arms of PackageIntent and for the
// diagnostics. Before this restructure the same six spellings existed twice — once here, once in a
// string-keyed lookup that turned an intent's name back into a variant — and any drift between the two
// copies landed in that lookup's fail-open `_` arm.

// WHY THIS IS NOT A LIST OF STRINGS. A prompting package with no console is not a slow install; it is an
// install that never finishes, and nobody is coming to answer. So each member names the QUESTION it asks,
// and "what makes this seed interactive by accident" becomes data with an owner instead of folklore in a
// runbook. A package that prompts and is NOT listed here is not thereby safe — it is merely unrefuted by
// this table, and the audit treats an unclassified interactive package as absent evidence (Refused), never
// as cleared. A new member is added with its question named, which is the whole discipline.
// openssh-server and cloud-init are here because BOTH ship a debconf config script that asks something on a
// fresh install (git.launchpad.net ubuntu/noble: debian/openssh-server.{templates,config},
// debian/cloud-init.templates), and both are packages this fleet genuinely installs. They were the first real
// case the old fail-open audit got wrong: openssh-server appeared in a fixture as an unseeded, unclassified
// package and earned a green non-interactive proof. A row is added by citing its template, never by deciding a
// package "probably" does not ask.
//
// AND A ROW LEAVES THE SAME WAY. ifupdown used to be listed against "ifupdown/interactive_loopback", a question
// the Debian package asked in older releases. Noble's ifupdown 0.8.35ubuntu1 does not: extracting the shipped
// arm64 .deb from the Ubuntu pool (ports.ubuntu.com noble main) with dpkg-deb -e yields only conffiles, control
// and md5sums — there is no config script and no templates file, so there is nothing for debconf to ask with.
// Keeping the row would have been the mirror image of the fail-open defect: a seed that refuses a package for a
// question it cannot ask trains the operator to disbelieve the refusals, and an unclassified package that DOES
// prompt then reads as another false alarm. Interface configuration is still covered — by the missing-mirror arm
// below, which is the way an Altra netboot actually becomes interactive over networking.
//
// WHY tzdata's question is spelled with two keys and not one. The package's config script reads tzdata/Areas and
// then tzdata/Zones/<area> — the zone key is PARAMETRIC on the area answer, which is why a single flat key name
// was wrong twice over: it named a template that does not exist ("tzdata/configure_timezone" appears nowhere in
// the shipped control scripts), and it implied one question where the installer must satisfy a pair in sequence.
// An answer seeded for the wrong key leaves the other one live, so the install still stops; a model that said
// "the timezone question" could not express that failure.
type KnownPromptingPackage =
    ConsoleSetupPackage
  | KeyboardConfigurationPackage
  | TzdataPackage
  | PostfixPackage
  | NtpPackage
  | OpenSshServerPackage
  | CloudInitPackage

fn known_prompting_package_question(package: KnownPromptingPackage) -> NonEmptyStr {
  match package {
    ConsoleSetupPackage => "console-setup/ask_detect: which keyboard and font to use"
    KeyboardConfigurationPackage => "keyboard-configuration/layout: which layout"
    TzdataPackage => "tzdata/Areas then tzdata/Zones/<area>: which region, then which city within it"
    PostfixPackage => "postfix/main_mailer_type: which mail configuration"
    NtpPackage => "ntp/utc: whether the hardware clock is UTC"
    OpenSshServerPackage =>
      "openssh-server/password-authentication: whether to allow password authentication"
    CloudInitPackage => "cloud-init/datasources: which data sources to search"
  }
}

fn known_prompting_package_name(package: KnownPromptingPackage) -> NonEmptyStr {
  match package {
    ConsoleSetupPackage => "console-setup"
    KeyboardConfigurationPackage => "keyboard-configuration"
    TzdataPackage => "tzdata"
    PostfixPackage => "postfix"
    NtpPackage => "ntp"
    OpenSshServerPackage => "openssh-server"
    CloudInitPackage => "cloud-init"
  }
}

// THE TABLE AS DATA, FOR THE WITNESS THAT THE TABLE IS THE WHOLE CLAIM. An intent's arm already carries the
// variant, so nothing in the audit path asks a name back — this list exists only so a witness can assert
// coverage over every row and catch a row added without its question being stated. It is derived from the
// same two functions the refusals print, so it cannot drift from them.
fn known_prompting_packages() -> List<KnownPromptingPackage> {
  [
    ConsoleSetupPackage,
    KeyboardConfigurationPackage,
    TzdataPackage,
    PostfixPackage,
    NtpPackage,
    OpenSshServerPackage,
    CloudInitPackage,
  ]
}

// WHAT A MIRROR IS, AND WHAT ITS ABSENCE IS. The presence is this closed record — a host, never a bare String
// that could be empty or a URL with a scheme in it. The absence is std.optional::Absent, the carrier §3b names
// for presence and absence, NOT a hand-built second arm: an earlier cut wrote `NamedMirror | MirrorAbsent`, which
// is a re-mint of that authority, and the readers paid for it — an absence re-handled at every consumer, plus a
// digest spelling that let a host literally named `absent` collide with having no mirror at all. Absent here means
// EXACTLY ONE THING: no mirror was supplied. A supplied-but-illegal mirror never reaches this field at all, because
// the host arrives through a mint whose result is a sealed record or a typed refusal (the
// `DebconfSelectionMint` idiom on the debconf shelf), and a refusal is reported, not demoted to Absent — a
// rejection and an absence are different facts and only ever occupy different types. With no mirror, subiquity has nothing to answer the
// archive-location question with, so the seed becomes interactive although no package in the list prompts — which
// is why the audit's Absent arm is a refusal and not a note beside a default. A future requirement (a per-site
// mirror with a port, or a proxy) adds a constructor to ArchiveMirrorAuthority; it does not add a String field
// that could be empty, and it cannot digest into an existing arm's bytes because mirror_diagnostic tags per arm.
type ArchiveMirrorAuthority = | NamedMirrorAuthority { host: NonEmptyStr }

type ArchiveMirror = Optional<ArchiveMirrorAuthority>

// THE LOCALE AXIS IS CLOSED TO THE TWO SPELLINGS THE INSTALLER ACCEPTS WITHOUT A FOLLOW-UP QUESTION. A
// future requirement (a French-language install, a non-UTF-8 console) adds a constructor HERE, which
// forces this module's interactive audit to be re-read; it does not let a caller paste a locale string
// that subiquity will ask about at a console nobody is standing at.
type SeedLocale = EnUsUtf8 | CUtf8

fn seed_locale_wire(locale: SeedLocale) -> NonEmptyStr {
  match locale {
    EnUsUtf8 => "en_US.UTF-8"
    CUtf8 => "C.UTF-8"
  }
}

// ---------------------------------------------------------------------------
// 3. Identity and credentials: a handle or nothing, never the secret, never nothing-and-valid.
// ---------------------------------------------------------------------------

// A CREDENTIAL IS AN OPAQUE REFERENCE OR IT IS NOT A CREDENTIAL. The secret material stays in the
// secret store; this handle carries a locator, a version, and NO READBACK — there is no accessor that
// turns a handle into a password anywhere in this module, which is what keeps a seed renderable into a
// log, an artifact name, or a digest without ever shipping a secret alongside it. The version is part of
// the identity rather than metadata because a rotated secret must change the rendered seed's digest: a
// unit that booted seed X should be answerable when X was the CURRENT credential, not a stale one. A
// future requirement to render a seed for human audit must add an accessor in extdeps.secrets; it must
// not add a String field here.
type AdminPasswordHandle sole_constructor {
  secret_locator: NonEmptyStr
  secret_version: NonEmptyStr
}

fn admin_password_handle(secret_locator: NonEmptyStr, secret_version: NonEmptyStr) -> AdminPasswordHandle {
  AdminPasswordHandle { secret_locator: secret_locator, secret_version: secret_version }
}

// WHY "NO PASSWORD" IS AN AFFIRMATIVE ARM AND NOT AN ABSENCE. On a headless board, declining a password
// is a decision someone made (keys are the only way in, or the console is open), and recording it as
// `none` would make a policy and an oversight indistinguishable — the exact confusion that lets a seed
// ship with no way in. The wire spelling is derived from the posture by credential_diagnostic, never
// stored next to it.
type AdminCredentialPosture = PasswordHandle { handle: AdminPasswordHandle } | PasswordUnset

// THE SECRET NEVER TRAVELS WITH THE SEED, AND THE TYPE SAYS SO. The payload projection upstream demands
// a NonEmptyStr hashed_password; rather than fork that shape or fabricate a string, this module's
// projection REFUSES when the posture is PasswordUnset and password authentication is being asked for.
// The refusal is the honest rendering of "upstream's record cannot express our posture" (reported
// upstream, not patched around here).
// A HEADLESS UNIT THAT IS NETWORK-REACHABLE MUST BE ENTERABLE, AND BOTH-WAYS-MISSING MUST BE
// UNNAMEABLE. There is no expression that builds an AdminAccessAuthorisation with zero authorized keys
// AND a locked console: the guard lives in the only constructor, so "the install succeeded and now nobody
// can log in" cannot be represented as a valid seed, only as a refusal the audit reports. A future
// requirement (an operator-attested break-glass console) adds a ConsoleEntryAuthorisation member and the
// attestation that unlocks it; it does not relax the guard.
type AdminAccessAuthorisation sole_constructor {
  authorised_keys: List<SshPublicKey>
  console_entry: ConsoleEntryAuthorisation
}

// THE CONSOLE IS AN AUTHORISATION, NOT A FEATURE. Unlocking a serial getty on a machine whose only other
// door is closed is a security decision with a named reason; the reason travels with it so a reader of a
// rendered seed can tell "the BMC console was opened deliberately, for SOL" from "someone forgot to lock
// it". A future requirement that needs an unlocked console without a stated reason must add a reason, not
// delete this one.
type ConsoleEntryAuthorisation =
    ConsoleEntryUnlocked { reason: ConsoleEntryUnlockReason }
  | ConsoleEntryLocked

type ConsoleEntryUnlockReason = SerialConsoleGettyUnlocked | BmcSolConsoleUnlocked

// EVERY KEY IS VALIDATED HERE, ON THE PRODUCTION ADMISSION ROUTE (review: merry-fox-82, HOLD section 3;
// this was item A of the previous HOLD, which this mint did not yet satisfy). The validation must live in
// THIS function and nowhere else, and the reason is the word "authorised": this mint is what turns a
// caller's `List<SshPublicKey>` into the fact "the board's owner authorised these keys". A check placed in a
// helper that a caller could also skip turns only the callers who remembered to call it into that fact —
// which is why the earlier revision's claim that keys "are validated through ssh_ed25519_key_identity" was
// false: nothing on the route from build_ubuntu_autoinstall_seed to the seed ever called it. Each key must
// satisfy BOTH facts before the list is credited as an authorisation, and each fact is refused as itself:
//   - the declared algorithm must be Ed25519 — the fleet's declared key type, per keys.dag's Rsa posture row
//     (ssh-rsa signatures deprecated by RFC 8332) — and
//   - the material must parse to an ssh_ed25519_key_identity (RFC 8709 §4): canonical base64, exact 19-octet
//     header, exactly 32 key octets, nothing after. A blob that fails parses as NO identity, so there is
//     nothing to authorise — the absence IS the refusal, never a string that might be a key.
// An RSA or ECDSA blob is well-formed material under ITS algorithm and is still refused here: the arms of
// SshKeyAlgorithm are the claim being checked, not decoration beside it. A list containing ONE malformed key
// is refused whole — an authorisation that silently drops a key is a board whose owner believes they are
// authorised and is not. FUTURE REQUIREMENT: admitting another algorithm adds an arm to the admitted match
// below with its own posture row; it does not become a fall-through.
fn keys_are_the_admitted_authorisation(keys: List<SshPublicKey>) -> Bool {
  match keys {
    Empty => true
    Cons { head: key, tail: rest } =>
      match key.algorithm {
        Ed25519 =>
          match ssh_ed25519_key_identity(material: key.material) {
            Absent => false
            Present { value: _ } => keys_are_the_admitted_authorisation(keys: rest)
          }
        Rsa => false
        EcdsaP256 => false
      }
  }
}

fn admit_admin_access_authorisation(
  authorised_keys: List<SshPublicKey>,
  console_entry: ConsoleEntryAuthorisation,
) -> Optional<AdminAccessAuthorisation> {
  match keys_are_the_admitted_authorisation(keys: authorised_keys) {
    False => Absent
    True =>
      match list_length(items: authorised_keys) == 0 {
        True =>
          match console_entry {
            ConsoleEntryUnlocked { reason: _ } =>
              Present {
                value: AdminAccessAuthorisation {
                  authorised_keys: authorised_keys,
                  console_entry: console_entry,
                },
              }
            ConsoleEntryLocked => Absent
          }
        False =>
          Present {
            value: AdminAccessAuthorisation {
              authorised_keys: authorised_keys,
              console_entry: console_entry,
            },
          }
      }
  }
}

fn authorised_key_count(authorisation: AdminAccessAuthorisation) -> Int {
  list_length(items: authorisation.authorised_keys)
}

// The keyboard layout the seed states. This axis EXISTS because the upstream payload requires a
// keyboard_layout string on a machine with no keyboard: the honest answer is that the value is
// ceremonial, and saying so in the type is what stops a future edit from treating it as a real setting
// (and from letting a wrong one imply a prompt — a layout subiquity has never heard of is a question).
type CeremonialKeyboardLayout = | UsLayout

fn ceremonial_keyboard_layout_wire(layout: CeremonialKeyboardLayout) -> NonEmptyStr {
  match layout { UsLayout => "us" }
}

// ---------------------------------------------------------------------------
// 4. Network posture: the non-interactive claim, made of parts rather than asserted.
// ---------------------------------------------------------------------------

// THE NETWORK CLAIM IS NOT A BOOL AND NOT THE STRING "system". A boolean would let a caller write
// non_interactive: true; delegating to the installer's own renderer is exactly the thing that can ask a
// question. So the claim is made of the parts that each CLOSE one question — who answers "which
// interface", who answers "v4 or v6", who answers "which archive" — and the audit reads the parts, never
// a flag. A future requirement (a bond, a VLAN) adds a member here and the audit row that proves it
// still closes its question.
type SeedNetworkPosture {
  addressing: SeedAddressing
  family: SeedAddressFamily
  mirror: ArchiveMirror
}

// Installer-managed addressing is left as an arm because it is a real thing callers ask for and it is the
// classic accidental prompt: with no carrier preference on a multi-NIC board the installer asks which
// interface to use, and there is nobody to ask. Naming it lets the audit REFUSE it by name instead of
// silently accepting a config that hangs.
type SeedAddressing = InstallerManaged | SeededNetplan { source: NonEmptyStr }

// WHY DUAL-STACK IS ITS OWN ARM AND NOT A FLAG. A seed that says "both" is promising the installer will
// not fall back to asking when one family fails to configure; a seed that says v4-only states the
// narrower promise. The audit treats them identically today, and keeping them apart is what lets a
// future row say "dual-stack with no v6 route observed is a prompt" without rewriting the type.
type SeedAddressFamily = DualStack | Ipv4Only

// ---------------------------------------------------------------------------
// 5. Target-disk selection: a rule over observed identity, never a device name.
// ---------------------------------------------------------------------------

// "THE NVMe" IS NOT A SELECTOR, AND THE TYPE REFUSES TO NAME ONE. There is no member here that selects
// by medium alone. On an 8-bay board a medium-only rule matches all eight bays, and a rule whose
// discriminating power comes from the board's population rather than from an identity read off the device
// is a guess wearing a rule. Every member below carries an IDENTITY-BEARING component — a serial read by
// the probe, or a catalog part number joined with a capacity — so that the number of disks it can match
// is a fact about the world the probe measured, and the selection can therefore answer "zero, one, or
// many" instead of praying. BMC virtual media makes this concrete: the BMC presents the install image as
// a USB-attached device on the board itself, so an extra device really does appear in the probe's view,
// and only an identity-bearing rule can keep the install off it.
//
// A device NAME (/dev/nvme0n1) is absent for the same reason it is absent from every serious installer:
// enumeration order is not identity, and on a multi-controller board it is not even stable across a
// reboot. A future requirement (select by NVMe namespace, by subsystem NQN) adds a member with its own
// probe-observable identity; it does not add a name.
type TargetDiskSelector =
    ByObservedSerial { serial: NonEmptyStr }
  | ByCatalogIdentity { part_number: NonEmptyStr, capacity_bytes: ByteSize }

// THE SELECTION RESULT, WITH ZERO AND MANY AS ANSWERS RATHER THAN AS ERRORS. Installing onto the wrong
// disk on an 8-bay board is the worst thing this cut can do, so the shape's job is to make "I cannot tell
// which one" the ordinary, reportable outcome rather than an exception a caller can swallow. Multiple
// carries the candidates' serials so the report says WHICH TWO — a refusal that cannot name the twins is
// a refusal nobody can act on.
// WHY THE SELECTION CARRIES ITS OWN PROVENANCE, AND WHY THAT IS A SEALED RECORD. (review: merry-fox-82) A
// binding used to take the selection as a free argument while also taking the seed, so a caller could bind a
// disk that had been selected under a DIFFERENT selector than the one the seed names — a valid disk, the wrong
// rule, and nothing in the record to show it. That is the same class of defect this module has removed twice
// already: a record asserting something no rule established. The provenance is minted only by
// select_target_disk, from the selector it was actually handed, and it is a payload record under
// sole_constructor rather than an arm modifier, because a union-level modifier is not a wall — enforcement is
// keyed on payload identity, and any arm of a sealed sum can be written by hand. With the provenance on the
// selection, the binding needs no selector argument at all: it reads the rule out of the evidence, so "seed
// says rule A, binding says rule B" is not refused at runtime, it is unnameable.
// THE CHOSEN DISK'S IDENTITY IS SEALED IN HERE, BESIDE THE RULE THAT PICKED IT, so the two can never be
// separated. The earlier shape put the device on DiskSelected beside a provenance carrying only the selector and
// the tallies, which left a seam exactly as wide as it looks: a caller could pair a legitimate provenance with a
// DIFFERENT device — a valid disk, a real selection, and a record proving nothing about the disk the install is
// about to erase. Sealing the identity removes the seam instead of policing it: one device field in the whole
// selection, minted only by the branch that established the disk is the single admissible match, and every
// reader (the projection, the binding, the digest) must go through it. The identity is the closed
// BoundDiskEvidence variant rather than a string because an unreadable serial is a state of the world with a
// different remedy, not an empty string.
type DiskSelectionProvenance sole_constructor {
  selector: TargetDiskSelector
  chosen: BoundDiskEvidence
  // How many observed disks the rule picked out, and how many the probe reported. Both are recorded so a
  // reader can see the rule's discriminating power without re-running it: one-in-eight and one-in-one are
  // different amounts of luck, and the second is a rule that was never tested against competition.
  matched: Int
  observed: Int
}

// MINTED ONLY BY THE ADMISSION BRANCH, AND IT MINTS THE DISK'S IDENTITY ITSELF from the device it was handed.
// Before this the caller passed the device to a separate evidence builder, which is the seam HOLD section 2
// found: a legitimate provenance and a different device could be paired by hand.
// THE SOLE MINT OF PROVENANCE, SEALED TO THE ONE ROUTE THAT EARNED IT (review: merry-fox-82, HOLD section 2).
// sole_constructor already makes a hand-written DiskSelectionProvenance literal a compile refusal
// (SoleConstructorViolation — same-file literals included); what remained open was this function: any caller
// could hand it an arbitrary `admitted` device plus an arbitrary `observed` population and mint a provenance
// record whose chosen identity had never been produced by a rule. admit_callers closes that: the compiler's
// declaration index refuses every other call site with ConstructorCallAdmissionRefused at resolve time, and a
// refusal of any file in the closure executes NOTHING — so "the direct probe" (a test that tried to call this)
// is not a test that can print a failure, it IS the compiler refusing the whole claim run. That is the
// evidence the seal holds; the differential in the witness (same file, same fixtures, calls through
// select_target_disk: 100+ rows green) shows the seal admits exactly the route it names and nothing else.
// FUTURE REQUIREMENT: a second legitimate selection route adds its decl_name to the list below — a named,
// reviewable widening, never an open mint.
fn disk_selection_provenance(
  selector: TargetDiskSelector,
  admitted: StorageDevice,
  observed: List<StorageDevice>,
) -> DiskSelectionProvenance admit_callers: [
  decl_ref(module_path: "gunbc.provisioning.ubuntu_autoinstall_seed", decl_name: "select_target_disk")
] {
  DiskSelectionProvenance {
    selector: selector,
    chosen: bound_disk_identity(
      device: admitted,
      matched: candidate_count(selector: selector, observed: observed),
      observed: list_length(items: observed),
    ),
    matched: candidate_count(selector: selector, observed: observed),
    observed: list_length(items: observed),
  }
}

// THE IDENTITY, DERIVED FROM THE PROBE'S OWN OBSERVATION and never from an argument a caller assembles. Two arms
// because the probe either read a serial or it did not, and the remedies differ: a serial is a handle the
// operator can check against the tray label, while a part number plus capacity is a catalog description a second
// drive could share. Collapsing the second into an empty serial hands the operator a handle that opens nothing.
fn bound_disk_identity(device: StorageDevice, matched: Int, observed: Int) -> BoundDiskEvidence {
  match storage_device_serial(d: device) {
    Present { value: serial } => BoundDisk { serial: serial, matched: matched, observed: observed }
    Absent => BoundDiskUnread { part_number: candidate_identity_label(device: device) }
  }
}

// WHICH DISK THE SEALED PROVENANCE SELECTED — the ONLY way anything gets a disk out of a selection, so no reader
// can be handed one the selection did not establish.
fn provenance_chosen_identity(provenance: DiskSelectionProvenance) -> BoundDiskEvidence {
  match provenance {
    DiskSelectionProvenance { selector: _, chosen: identity, matched: _, observed: _ } => identity
  }
}

type TargetDiskSelection
  = DiskSelected { provenance: DiskSelectionProvenance }
  | SelectionRefused { cause: DiskSelectionRefusalCause }

type DiskSelectionRefusalCause
  = NoDiskMatches { selector: TargetDiskSelector }
  | MultipleDisksMatch { selector: TargetDiskSelector, candidates: List<NonEmptyStr> }
  | CandidateIdentityUnobserved { part_number: NonEmptyStr }
  | CandidateIsNotPersistent { serial: NonEmptyStr, persistence: PersistenceKind }

// THE PERSISTENCE AXIS IS CHECKED BEFORE THE IDENTITY AXIS, AND THE ORDER IS THE POINT. An ephemeral or
// mirror disk that happens to carry the right serial (a reprovisioned drive, a mislabelled tray) must be
// refused as not-persistent, not selected-and-then-regretted: the failure mode is writing a root
// filesystem onto a cache device. Ephemeral and CachedMirror are therefore excluded by rule, not by
// convention.
// THE RULE AND THE ARDNESS OF THE DISK ARE TWO QUESTIONS, ANSWERED SEPARATELY. The rule answers "does the
// selector reach this device at all"; persistence answers "is the device it reached something you may erase". They
// were once one function, and the conflation was a live defect: one ephemeral disk that the selector reaches
// was counted as NOTHING MATCHING, sending the operator to re-admit a unit whose disks are fine instead of
// telling them the one disk they reached is a cache. Each refusal names a different remedy, so each needs its
// own count. A future selector variant enters through the closed match below; it cannot skip the persistence
// gate, because the gate lives in the caller, not in the arms.
fn selector_matches_rule(selector: TargetDiskSelector, device: StorageDevice) -> Bool {
  match selector {
    ByObservedSerial { serial: wanted } =>
      match storage_device_serial(d: device) {
        Present { value: observed } => observed == wanted
        Absent => false
      }
    ByCatalogIdentity { part_number: wanted_part, capacity_bytes: wanted_capacity } =>
      match device {
        NvmeDevice { catalog: c, serial: _, persistence: _ } =>
          c.part_number == wanted_part && measure_le(a: c.capacity_bytes, b: wanted_capacity) && measure_le(a: wanted_capacity, b: c.capacity_bytes)
        BareDevice { capacity: _, medium: _, serial: _, read_bandwidth: _, write_bandwidth: _, persistence: _ } => false
      }
  }
}

// WHAT THE RULE REACHES *AND* WHAT MAY BE ERASED. A device the rule reaches but which is not persistent is
// still not admissible, so the split above cannot widen what may be installed onto -- it only changes which
// refusal you get, and the witness pins exactly that.
fn selector_admits_observed(selector: TargetDiskSelector, device: StorageDevice) -> Bool {
  selector_matches_rule(selector: selector, device: device) && disk_may_be_erased_onto(device: device)
}

// WHY THE EMPTY AND MULTIPLE ARMS CANNOT BE SKIPPED BY A CALLER. This is the only function that turns a
// rule plus a probe reading into "install here", it is total, and it returns a refusal when the rule is
// not discriminating. There is no variant that says "picked the first match".
fn select_target_disk(
  selector: TargetDiskSelector,
  observed: List<StorageDevice>,
) -> TargetDiskSelection {
  let unexamined = match first_unexamined_candidate(selector: selector, observed: observed) {
    Present { value: cause } => SelectionRefused { cause: cause }
    // TWO COUNTS, TWO QUESTIONS, IN THIS ORDER. "How many disks does the rule pick out" and "how many of
    // those may be erased" are different questions, and collapsing them used to make one of the refusal arms
    // dead (see disk_erase_authorisation). The walk answers identity first, admissibility second, and reports the
    // first question that has no answer.
    Absent =>
      match candidate_count(selector: selector, observed: observed) {
        0 => SelectionRefused { cause: NoDiskMatches { selector: selector } }
        _ =>
          match admissible_count(selector: selector, observed: observed) {
            // NOTHING THE RULE PICKED OUT IS A LEGAL TARGET. This is the arm the old filter kept unreachable,
            // and it is a different page of the runbook from "your rule matched nothing": here the rule found
            // the drive and the drive is volatile backing or a cache mirror, so the operator goes to the tray,
            // not to the selector.
            0 => match matched_candidate(selector: selector, observed: observed) {
              Present { value: offender } => SelectionRefused {
                cause: CandidateIsNotPersistent {
                  serial: candidate_identity_label(device: offender),
                  persistence: storage_device_persistence(d: offender),
                },
              }
              // UNREACHABLE, AND STILL ANSWERED AS A REFUSAL. The count above just said at least one device
              // matched; an absent match here would mean the count and the filter disagreed, which is a bug in
              // this module rather than a state of the world. Reported as "nothing matched" because that is the
              // closest truthful thing to say, and a refusal can be investigated; there is no panic, no
              // default, and no silent success on the other side of this arm.
              Absent => SelectionRefused { cause: NoDiskMatches { selector: selector } }
            }
            1 => match admissible_candidate(selector: selector, observed: observed) {
              Present { value: only } => DiskSelected {
                provenance: disk_selection_provenance(
                  selector: selector,
                  admitted: only,
                  observed: observed,
                ),
              }
              Absent => SelectionRefused { cause: NoDiskMatches { selector: selector } }
            }
            _ => SelectionRefused {
              cause: MultipleDisksMatch {
                selector: selector,
                // THE NAMES ARE THE LEGAL ONES. The operator's job is to tell two installable drives apart;
                // listing a drive that could never be installed anyway points them at the wrong bay.
                candidates: admissible_candidate_labels(selector: selector, observed: observed),
              },
            }
          }
      }
  }
  unexamined
}

// THE PERSISTENCE TEST, NOW REACHABLE, AND WHY IT CANNOT BE MERGED BACK INTO THE PREDICATE. An nvme namespace
// reported as ephemeral is one whose contents do not survive a reset — volatile backing, a ram-backed namespace,
// a device the firmware hands out fresh — and an installer that lays a root filesystem on one has produced an
// installed system that evaporates on the next power cycle, on a board with no console to notice. Refusing is
// the only answer available at seed time. It has to run on the MATCHED candidate rather than as a filter, so
// that the refusal says "the disk your rule picked is not a legal target" instead of the far more misleading
// "your rule matched nothing" — the first sends the operator to the drive, the second sends them to the selector.
// THE DISPOSITION, ENUMERATED PER ARM — review 83320. An earlier cut answered this with a hand-written Bool
// written directly over extdeps.storage.types' three-arm `PersistenceKind`. The defect the review named is the
// *shape of the answer*: the Bool listed the arms by hand at four call sites, so a fourth `PersistenceKind`
// would arrive compile-clean and inherit an admissibility verdict nobody chose — on the code path that decides
// whether an installer may erase a disk on an eight-bay board. This function now matches the upstream coproduct
// exhaustively, with no default, so a new kind breaks the build here instead of quietly joining whichever group
// its spelling happened to land in.
//
// THE TERMINAL JUSTIFICATION FOR THE TWO DENIALS COLLAPSING, stated rather than left implied: this function
// answers ONE question — "may the installer erase onto this device" — and for that question the answer genuinely
// is the same for both denied kinds, because only `Persistent` survives a reset and surviving a reset is the
// whole requirement. It is NOT this function's job to carry *why*, and it does not have to, because the why is
// already modelled where it is used: every refusal this feeds is
// `DiskSelectionRefusalCause::CandidateIsNotPersistent { serial, persistence: PersistenceKind }`, built from
// `storage_device_persistence` directly, so an operator is told `Ephemeral` or `CachedMirror` by name and can act
// on the difference (an ephemeral namespace is volatile backing and is excluded outright; a cache mirror is
// excluded because its partner may not survive, which is a question about the *other* device). A Bool that threw
// the distinction away would have been a defect only if nothing else kept it; here the distinction has one home,
// and it is the record a human reads. `disk_erase_authorisation` is where the decision is enumerated;
// `disk_may_be_erased_onto` below is derived presence, existing only because `List.filter` wants a Bool.
//
// WITNESS RATHER THAN PLAIN BOOL, so the decision has a name and the admissible arm travels onward carrying the
// kind it was admitted as — the same construction as `debconf_selection_answer` on this PR's debconf shelf, which
// returns the answer kind rather than a Bool so a `seen` flag can never be credited as an answer. The witness here
// is simply the `PersistenceKind` itself: presence means "the probe observed this device as one the installer may
// erase onto", and the value says which kind earned that. No new record type, because the kind already is the
// evidence, and minting a wrapper around it would be a second name for one fact.
fn disk_erase_authorisation(device: StorageDevice) -> Optional<PersistenceKind> {
  match storage_device_persistence(d: device) {
    // THE ONE ADMISSIBLE ARM.
    Persistent => Present { value: Persistent }
    // BOTH DENIED ARMS ARE WRITTEN OUT, not grouped under a default, which is the point of the whole exercise:
    // a future `PersistenceKind` must be decided here, by whoever adds it, before this module compiles.
    Ephemeral => Absent
    CachedMirror => Absent
  }
}
// DERIVED PRESENCE, NOT AN ENUMERATION, and the only Bool in this path. The arms are decided above, so a new
// `PersistenceKind` fails to compile at `disk_erase_authorisation` and can never reach here unconsidered.
fn disk_may_be_erased_onto(device: StorageDevice) -> Bool {
  match disk_erase_authorisation(device: device) {
    Present { value: _ } => true
    Absent => false
  }
}

// THE COUNT IS THE RULE'S DISCRIMINATING POWER, MEASURED. A selector that matches every disk on the
// board is not closer to working than one that matches none; both are guesses, and the shape of the
// refusal is what makes the caller go tighten the rule instead of trusting the ordering of a probe.
// Filtering on the MATCH predicate (identity, medium, model — never a device name), so that a match count
// answers "how many disks does this rule pick out" and nothing else.
fn candidate_count(selector: TargetDiskSelector, observed: List<StorageDevice>) -> Int {
  observed.filter(device => selector_matches_rule(selector: selector, device: device)).length()
}

fn matched_candidate(
  selector: TargetDiskSelector,
  observed: List<StorageDevice>,
) -> Optional<StorageDevice> {
  observed.filter(device => selector_matches_rule(selector: selector, device: device)).first()
}

// THE ADMISSIBLE FILTERS: the same rule, then the persistence test that keeps a cache mirror or volatile
// namespace out of the installer's way. Kept beside the match helpers rather than folded into them so the two
// questions stay countable separately — that separation is the whole fix, and it is what makes the witness able
// to say "the rule matched, and it was refused for persistence" instead of "the rule matched nothing".
fn admissible_count(selector: TargetDiskSelector, observed: List<StorageDevice>) -> Int {
  observed
    .filter(device => selector_matches_rule(selector: selector, device: device))
    .filter(device => disk_may_be_erased_onto(device: device))
    .length()
}

fn admissible_candidate(
  selector: TargetDiskSelector,
  observed: List<StorageDevice>,
) -> Optional<StorageDevice> {
  observed
    .filter(device => selector_matches_rule(selector: selector, device: device))
    .filter(device => disk_may_be_erased_onto(device: device))
    .first()
}

fn admissible_candidate_labels(
  selector: TargetDiskSelector,
  observed: List<StorageDevice>,
) -> List<NonEmptyStr> {
  observed
    .filter(device => selector_matches_rule(selector: selector, device: device))
    .filter(device => disk_may_be_erased_onto(device: device))
    .map(device => candidate_identity_label(device: device))
}

// WHICH DISKS COLLIDED, BY SERIAL. A refusal that cannot name the twins is a refusal nobody can act on: the
// operator's next step is reading the labels off the bays, and "two matched" does not say which two. A candidate
// the probe never read a serial for is named by its part number, because an absent observation is reported as
// absent, never as an empty string.
fn matched_candidate_serials(
  selector: TargetDiskSelector,
  observed: List<StorageDevice>,
) -> List<NonEmptyStr> {
  observed
    .filter(device => selector_matches_rule(selector: selector, device: device))
    .map(device => candidate_identity_label(device: device))
}

fn candidate_identity_label(device: StorageDevice) -> NonEmptyStr {
  match storage_device_serial(d: device) {
    Present { value: serial } => serial
    Absent => match device {
      NvmeDevice { catalog: c, serial: _, persistence: _ } => c.part_number
      BareDevice { capacity: _, medium: _, serial: _, read_bandwidth: _, write_bandwidth: _, persistence: _ } =>
        "device-without-serial-or-part-number" as NonEmptyStr
    },
  }
}

// A DISK THE RULE REACHES BUT WHOSE IDENTITY THE PROBE NEVER READ IS REPORTED AS SUCH. The probe (S2)
// is allowed to have not seen a serial, and "we could not read it" must not be laundered into "no disk
// matches": the fix is different (re-probe) and the blame is different (the observation, not the rule).
// This is checked BEFORE the count, because a board whose only candidate has no readable serial must not
// be reported as "zero matches" — that would tell the operator to change the rule when the rule is fine.
// ONE PASS, ONE VERDICT PER DEVICE. Recursive over the list so `unexamined_candidate` is asked exactly once
// per device and the first refusal found is what comes back. It used to filter through a Bool predicate and
// then call unexamined_candidate again on the winner: the same verdict computed twice, with room for the two
// to disagree, and every device paid for the question twice.
fn first_unexamined_candidate(
  selector: TargetDiskSelector,
  observed: List<StorageDevice>,
) -> Optional<DiskSelectionRefusalCause> {
  match observed {
    Empty => Absent
    Cons { head: device, tail: rest } =>
      match unexamined_candidate(selector: selector, device: device) {
        Present { value: cause } => Present { value: cause }
        Absent => first_unexamined_candidate(selector: selector, observed: rest)
      }
  }
}

// ONE TOTAL FUNCTION OVER (SELECTOR, DEVICE), REPLACING THREE THAT each restated a match on a sum type as a
// Bool that the next function then re-matched as True/False. The device match is exhaustive over
// StorageDevice, so a new device kind must say whether an unread serial on it is a reportable state; it
// cannot inherit "nothing to report" the way the deleted `_`-shaped helpers let it. EXPORTED because "the
// probe never read this disk's serial" is a claim about the OBSERVATION, not about the rule, and both the
// selection path and a witness must state it the same way.
//
// Only an NVMe device can be an unexamined candidate: a bare device with no serial has no catalog row to
// have missed, so there is nothing for the probe to have failed to read, and a catalog-identity selector
// names a part number and a size that the probe DID read — an unread serial does not block it.
fn unexamined_candidate(
  selector: TargetDiskSelector,
  device: StorageDevice,
) -> Optional<DiskSelectionRefusalCause> {
  match selector {
    ByCatalogIdentity { part_number: _, capacity_bytes: _ } => Absent
    ByObservedSerial { serial: _ } =>
      match storage_device_serial(d: device) {
        Present { value: _ } => Absent
        Absent => match device {
          NvmeDevice { catalog: c, serial: _, persistence: _ } =>
            Present { value: CandidateIdentityUnobserved { part_number: c.part_number } }
          BareDevice { capacity: _, medium: _, serial: _, read_bandwidth: _, write_bandwidth: _, persistence: _ } =>
            Absent
        }
      }
  }
}

// ---------------------------------------------------------------------------
// 6. The audit: the non-interactive claim, proved from the seed's parts.
// ---------------------------------------------------------------------------

// THE AUDIT IS A FUNCTION OF THE SEED'S AXES, NOT A FLAG ON THE SEED. A seed cannot claim to be
// non-interactive; it can only be built from parts that survive this audit. Each refusal arm names the PART
// that failed, so a refusal says which decision to go back and make, and no two arms can be merged into one
// BadSeed because each has an independent reason to exist and an independent fix.
type SeedAudit
  = SeedIsNonInteractive { evidence: NonInteractiveProof }
  | SeedRefused { cause: SeedInteractiveCause }

// THE FOUR WAYS A SEED BECOMES INTERACTIVE BY ACCIDENT, NAMED AT THE LEVEL OF THE PART THAT BROKE. The
// list is closed because each member is a MECHANISM, not an example: a package that asks, an addressing
// scheme that hands the choice back, a missing mirror, and an entrypoint that does not exist. "A timezone
// question" is the TzdataPackage mechanism with its question named, not a fifth mechanism — and that
// decomposition is what lets a new package enter through PackageIntent without reopening the audit's shape.
// FOUR WAYS A SEED BECOMES A QUESTION, PLUS THE FIFTH WE COULD NOT RULE OUT. The first four are mechanisms we
// can name and have seen; the fifth is the honest limit of the model — a package nobody has checked. It is a
// REFUSAL ARM, not a warning, because the claim the green arm makes is "nothing can ever be asked", and one
// unexamined package is enough to make that claim false. Collapsing it into PackagePrompts would name a
// question we have not observed (DESIGN.md §5, "no plausible output is fabricated"); collapsing it into
// Success is the defect this enum's existence was supposed to prevent.
type SeedInteractiveCause
  = PackagePrompts { name: NonEmptyStr, question: NonEmptyStr }
  | PackagePromptingUnclassified { name: NonEmptyStr }
  | AddressingIsInstallerManaged
  | ArchiveMirrorAbsent
  // NO PAYLOAD, DELIBERATELY. This arm is built only where the key list is empty AND the console is locked,
  // so a `keys: Int` could hold only 0 and a `console_entry` only ConsoleEntryLocked: two fields restating the
  // arm's name, each a second copy of a fact the constructor already guarantees. A future requirement that
  // distinguishes WHY there is no entrypoint (say, an unlocked-but-unclaimed console) adds a NEW arm, not a
  // field here.
  | NoEntrypointAtAll
  // A SILENCE RECEIPT THAT WAS NEVER ESTABLISHED FOR THIS ARCHITECTURE. Silence is a property of a BUILD, and
  // the build is per architecture: a receipt read off the arm64 .deb says nothing about the amd64 .deb, which
  // is a differently compiled artifact that could ship a config script the arm64 one has never had. A seed for
  // one architecture carrying the other's receipts would certify "nothing can ever be asked" from evidence
  // nobody gathered for this machine — so it refuses, naming both the package and the architecture it was
  // refused against. This is the row-gate that keeps x86 from borrowing arm64's homework; there is no if-x86
  // branch anywhere, only this arm firing when the row and the axes disagree.
  | PackageSilenceUnestablishedForArchitecture { name: NonEmptyStr, architecture: NonEmptyStr }
  // THE KEY-ONLY POSTURE CARRYING NO AUTHORISED KEY. Distinct from NoEntrypointAtAll, which is "locked console
  // with no keys" and can be waived by a deliberate unlock: under a key-only posture the unlock waiver is the
  // FORGOTTEN-PASSWORD fallback, which this posture does not have, so an empty authorised-key set locks the
  // owner out through every path the seed offers and no waiver can rescue it. Named separately because the fix
  // is different: here, admit the operator's key; there, lock the console or record why not.
  | KeyOnlyPostureAdmitsNoKeys

// THE PROOF, AS DATA. The audit's green arm is neither unit nor Bool: it carries WHY it is green, in the
// same parts the refusal names, so an auditor reading a rendered seed later can re-check the claim without
// re-running this function. An empty tally would be a lie rather than an absence, which is why the count is
// a computed Int and the console stanza is a derived member.
type NonInteractiveProof {
  questions_closed: Int,
  console_stanza: NonInteractiveConsoleStanza,
}

// THE CONSOLE STANZA, DERIVED FROM THE TRANSPORT. This is the ONLY thing the delivery strategy is allowed to
// change about the seed, and its being derived is the point: a stored "no console" flag beside a strategy
// field is two facts that can disagree, and when they disagree the seed promises something about a console
// the transport cannot honour.
// ConsoleAnsweredByUnattended carries NO payload: what the arm means is a property of the transport, not a
// per-instance fact, and a String there would be commentary stored as data — copied by hand into every arm
// that builds it, and discarded by the render that consumes it. The rationale belongs in this comment.
type NonInteractiveConsoleStanza = ConsoleSuppressed | ConsoleAnsweredByUnattended

// THE STANZA IS DERIVED BY MATCHING THE TRANSPORT, NEVER BY RE-READING A BOOL THAT ALREADY FLATTENED IT.
// The two arms are the two things the seed says on the kernel command line: either a console exists and is
// answered by the unattended answer file, or there is no console to answer at all.
fn console_stanza_for(strategy: SeedDeliveryStrategy) -> NonInteractiveConsoleStanza {
  match strategy {
    // UEFI reaches a console the installer will print to, so the seed must ANSWER rather than suppress: a
    // reachable SOL console is still nobody at the panel.
    PxeStrategy { boot_mode: UefiPxe { tftp_root: _ } } => ConsoleAnsweredByUnattended
    PxeStrategy { boot_mode: UefiHttpBoot } => ConsoleAnsweredByUnattended
    PxeStrategy { boot_mode: LegacyBiosPxe { tftp_root: _ } } => ConsoleSuppressed
    VirtualMediaStrategy { media_stem: _ } => ConsoleSuppressed
  }
}

// THE AUDIT, IN THE ORDER THE FAILURES MATTER. The entrypoint check is evaluated BEFORE the package questions
// because a seed nobody can use after install is worse than a seed that asks a question: a prompt can
// sometimes be answered by someone watching SOL, a locked-out owner cannot. It is also the arm that can
// barely be reached at all — admit_admin_access_authorisation already made "no keys and locked console"
// unnameable — so it is a second line of defence against a caller that bypassed that constructor, not the
// primary guard. That redundancy is intentional: this is the failure the module exists to make impossible.
fn audit_ubuntu_autoinstall_seed(
  network: SeedNetworkPosture,
  install_packages: List<PackageIntent>,
  late_packages: List<PackageIntent>,
  locale: SeedLocale,
  entry: AdminAccessAuthorisation,
  strategy: SeedDeliveryStrategy,
  // THE AXES THE INTERACTIVITY CHAIN CANNOT SEE ON ITS OWN. The architecture decides whether a silence
  // receipt counts (a receipt established against the arm64 pool says nothing about the amd64 .deb); the
  // credential decides whether the key-only posture's own entrypoint obligation applies, which is NOT the
  // locked-console one — see key_only_posture_admits_no_entry below.
  architecture: Architecture,
  credential: AdminCredentialPosture,
) -> SeedAudit {
  // THE KEY-ONLY OBLIGATION FIRST, BEFORE THE CONSOLE MATCH. The console-unlock waiver exists for the
  // password postures (a locked-out owner can still be reached by password); a key-only posture has no such
  // fallback, so under it an empty authorised-key set admits nobody through any path and the unlock cannot
  // save it. This cannot be expressed as "empty keys are refused": the seeded-handle rows legitimately carry
  // empty keys with a deliberate unlock, because a password backs them.
  match key_only_posture_admits_no_entry(credential: credential, entry: entry) {
    True => SeedRefused { cause: KeyOnlyPostureAdmitsNoKeys }
    False =>
      match entry.console_entry {
        ConsoleEntryLocked =>
          match list_length(items: entry.authorised_keys) {
            0 =>
              SeedRefused {
                cause: NoEntrypointAtAll,
              }
            n => audit_seed_interactivity(
              network: network,
              install_packages: install_packages,
              late_packages: late_packages,
              locale: locale,
              strategy: strategy,
              architecture: architecture,
            )
          }
        ConsoleEntryUnlocked { reason: _ } => audit_seed_interactivity(
          network: network,
          install_packages: install_packages,
          late_packages: late_packages,
          locale: locale,
          strategy: strategy,
          architecture: architecture,
        )
      }
  }
}

// IS THIS POSTURE KEY-ONLY WITH NOTHING TO KEY ON? One predicate, both arms total. A declared password
// (present hash or handle-backed) is false regardless of keys: somebody can still log in. A key-only posture
// is true exactly when the admitted authorisation carries no authorised key at all — no key to present, no
// password to type, a host locked out by its own seed.
fn key_only_posture_admits_no_entry(
  credential: AdminCredentialPosture,
  entry: AdminAccessAuthorisation,
) -> Bool {
  match credential {
    PasswordHandle { handle: _ } => false
    PasswordUnset =>
      match list_length(items: entry.authorised_keys) {
        0 => true
        n => false
      }
  }
}

// THE INTERACTIVITY CHAIN, PULLED OUT SO THE ENTRYPOINT GUARD STAYS ONE MATCH OVER THE CONSUMER'S SUM TYPE.
// Ordered by which question the installer would ask FIRST, because the refusal an operator sees should be the
// one they hit first: a locale question fires before the archive is ever contacted, and a missing mirror makes
// the archive-location question unanswerable before any package is installed.
fn audit_seed_interactivity(
  network: SeedNetworkPosture,
  install_packages: List<PackageIntent>,
  late_packages: List<PackageIntent>,
  locale: SeedLocale,
  strategy: SeedDeliveryStrategy,
  architecture: Architecture,
) -> SeedAudit {
  match prompt_over_locale(locale: locale) {
    Present { value: question } =>
      SeedRefused { cause: PackagePrompts { name: "locale" as NonEmptyStr, question: question } }
    Absent =>
      match network.mirror {
        Absent => SeedRefused { cause: ArchiveMirrorAbsent }
        Present { value: _ } =>
          match network.addressing {
            InstallerManaged => SeedRefused { cause: AddressingIsInstallerManaged }
            SeededNetplan { source: _ } =>
              match first_blocking_refusal(intents: install_packages, architecture: architecture) {
                Present { value: offender } => SeedRefused { cause: offender }
                Absent =>
                  match first_blocking_refusal(intents: late_packages, architecture: architecture) {
                    Present { value: late_offender } => SeedRefused { cause: late_offender }
                    Absent =>
                      SeedIsNonInteractive {
                        evidence: NonInteractiveProof {
                          questions_closed: questions_closed_count(
                            install_packages: install_packages,
                            late_packages: late_packages,
                            network: network,
                          ),
                          console_stanza: console_stanza_for(strategy: strategy),
                        },
                      }
                  }
              }
          }
      }
  }
}

// A LOCALE CAN ITSELF BE THE QUESTION. Today both closed members are answerless, so this always returns
// Absent — and that is precisely the row a future locale constructor must edit. Writing `=> none` in a
// hardcoded match would be the placeholder version of this function; keeping it as a search over the closed
// set is what makes adding a third locale force a decision here instead of inheriting silence.
fn prompt_over_locale(locale: SeedLocale) -> Optional<NonEmptyStr> {
  match locale {
    EnUsUtf8 => Absent
    CUtf8 => Absent
  }
}

// AN OFFENDER IS A PACKAGE THAT PROMPTS AND WAS NOT SEEDED. A seeded prompter is not removed from the
// tally: the debconf seed is what closed it, and the proof's count is the evidence of that work.
// THE AUDIT ASKS THE INTENT, NEVER THE STRING. Each intent becomes its own verdict, and the first verdict that
// is not a ClosedQuestion becomes the refusal — so the mapping never needs an arm for a verdict that is not a
// problem, and there is no `_` arm for an unknown package to fall through into. Removing the string-keyed
// lookup is the actual fix: it could only answer "is this in the table", and its fail-open `_ => Absent` was
// read by the audit as "nothing to answer", so an unclassified package earned the green arm.
// ONE PASS, ONE VERDICT PER INTENT. This walks the list and asks `blocking_refusal` exactly once per
// intent, stopping at the first cause. It used to filter through a Bool predicate that recomputed the same
// answer `blocking_refusal` was about to give, so the two could drift and every intent paid for the
// question twice. A cause is never dropped: the recursion returns the FIRST Present, and Absent only when
// every intent answered its own question.
fn first_blocking_refusal(
  intents: List<PackageIntent>,
  architecture: Architecture,
) -> Optional<SeedInteractiveCause> {
  match intents {
    Empty => Absent
    Cons { head: head, tail: rest } =>
      match blocking_refusal(intent: head, architecture: architecture) {
        Present { value: cause } => Present { value: cause }
        Absent => first_blocking_refusal(intents: rest, architecture: architecture)
      }
  }
}

// ONE INTENT, ONE VERDICT, AT MOST ONE CAUSE. ClosedQuestion yields Absent because nothing is wrong; an
// OpenQuestion names the debconf key to seed; the unclassified arm deliberately carries NO question field,
// because this module has not observed a question from that package and printing one would be fabricating the
// very evidence the refusal is complaining about.
// AN ANSWER COUNTS AS AN ANSWER ONLY IF IT ANSWERS EVERY KEY THE PACKAGE WILL ASK. This is the arm the audit
// actually reaches, and this is what was wrong: the key-by-key check existed (all_required_keys_present) but was
// reachable only through package_prompting_verdict, which nothing in the module called — so the audit credited a
// package whose seed text supplied one of its two keys as fully answered. tzdata is exactly that case: its
// postinst reads tzdata/Areas and then tzdata/Zones/$AREA, so a half-seeded tzdata closed the non-interactivity
// audit and the installer would still have stopped on the zone at a console nobody is standing at. The check was
// never missing; the wiring was. The audit now CLASSIFIES ONCE, through package_prompting_verdict, and maps that
// one verdict onto its cause — so there is no second, weaker reading of the same intent for a future caller (or a
// future witness) to reach by mistake, which is what the comment above this function has always claimed and the
// code never did.
fn blocking_refusal(
  intent: PackageIntent,
  architecture: Architecture,
) -> Optional<SeedInteractiveCause> {
  match package_prompting_verdict(intent: intent) {
    ClosedQuestion { name: _, question: _ } => Absent
    // THE CAUSE IS THE VERDICT'S OWN, NOT A FRESH READING OF THE INTENT. name/question come from the closed
    // vocabulary function (known_prompting_package_*), so a refusal an operator reads is spelled the way the
    // archive spells it and no second copy of that spelling can drift.
    OpenQuestion { name: prompted, question: asked } => Present {
      value: PackagePrompts { name: prompted, question: asked },
    }
    UnclassifiedPrompting { name: un } => Present { value: PackagePromptingUnclassified { name: un } }
    // SILENT BLOCKS NOTHING — ONLY WHEN THE RECEIPT ITSELF WAS ESTABLISHED FOR THIS ARCHITECTURE. The verdict's
    // silence is checked against the seed's own architecture before it is credited. The check reads the RECEIPT,
    // not just its package name: a receipt verified against the arm64 .deb is not evidence about the amd64
    // build of the same source — differently compiled, separately versioned, free to ship a config script the
    // other never had — and an x86 seed carrying arm64's receipts would certify "nothing can ever be asked"
    // from evidence nobody gathered for this machine. The row table is consulted too, so a receipt whose own
    // architecture field agrees but whose citation nobody shipped still refuses. This is the row-gate that keeps
    // x86 from borrowing arm64's homework; there is no if-x86 branch anywhere, only this arm firing when the
    // receipt and the axes disagree.
    NothingToAsk { name: asked_name, silence: silence } =>
      match silence_receipt_is_admitted_for(receipt: silence, architecture: architecture) {
        True => Absent
        False => Present {
          value: PackageSilenceUnestablishedForArchitecture {
            name: asked_name,
            architecture: architecture_token(architecture: architecture),
          },
        }
      }
  }
}

// THE ONE PREDICATE OVER AN OPTIONAL CAUSE, USED IN A FILTER. Total over both arms, so a future arm on
// Optional here would be a compile error rather than a default.
// HOW MANY QUESTIONS THE SEED CLOSED, WHICH IS THE SEED'S OWN EVIDENCE OF ITS INDEPENDENCE. Counted, not
// asserted: a reader comparing two seed digests can see that the newer one closes more questions, which is
// the only way a "we fixed the hang" claim becomes checkable rather than remembered. Only an answered question
// counts — an unclassified package contributes nothing, because it answered nothing. The final +1 is the
// entrypoint question, closed by the authorisation the caller had to earn to get here. The addressing and
// mirror terms match their source sum types directly rather than through a Bool helper.
fn intent_answered_its_question(intent: PackageIntent) -> Bool {
  match intent {
    QuestionAnswered { package: _, answers: _ } => true
    QuestionUnanswered { package: _ } => false
    UnclassifiedPackage { name: _, answers: _ } => false
    // SILENT IS NOT ANSWERED. The tally counts questions the seed CLOSED; a package that never asked one closed
    // nothing, so crediting it would let a seed pad its own proof of non-interactivity by installing packages.
    // This arm and the blocking arm below are deliberately different answers about the same value.
    PackageVerifiedSilent { silence: _ } => false
  }
}

fn questions_closed_count(
  install_packages: List<PackageIntent>,
  late_packages: List<PackageIntent>,
  network: SeedNetworkPosture,
) -> Int {
  // COUNTED OVER THE INTENTS THEMSELVES, not over verdicts mapped from them. Mapping to a verdict and then
  // filtering it would be a second, decorative pass: the green arm of the audit is only reachable when every
  // intent left no question open, so such a filter is necessarily true of everything it sees — the shape the
  // review called predicate dissolution, one layer deeper than the helpers it named. Counting the answered arm
  // directly says the same thing once, and a new PackageIntent arm must state whether it counts as closed.
  let closed = install_packages.filter(intent => intent_answered_its_question(intent: intent)).length() + late_packages.filter(intent => intent_answered_its_question(intent: intent)).length()
  let addressing_closed = match network.addressing {
    SeededNetplan { source: _ } => 1
    InstallerManaged => 0
  }
  let mirror_closed = match network.mirror {
    Present { value: _ } => 1
    Absent => 0
  }
  closed + addressing_closed + mirror_closed + 1
}

// TOTAL OVER PackageIntent, and the only place the proof's arithmetic decides what a closed question is. An
// unanswered or unclassified intent contributes nothing: the first did not answer and the second was never
// asked about. A new arm must say which side it is on rather than inheriting a count.

// ---------------------------------------------------------------------------
// 7. The seed record, its constructor, and the projection into upstream's payload.
// ---------------------------------------------------------------------------

// THE SEED IS A STANDING, NOT A STRING. The rendered autoinstall is a projection of these axes, and keeping
// the axes is what lets a seed be audited after the fact (which part closed which question), be re-rendered
// against a fixed upstream change, and be digested without digesting formatting. sole_constructor because a
// hand-written record could pair an audited proof with inputs the audit never saw: the proof and the inputs
// it was computed from must not be independently assignable, or the field is decoration.
type UbuntuAutoinstallSeed sole_constructor {
  target: ProvisioningTargetStanding,
  network: SeedNetworkPosture,
  install_drivers: List<SeedInstallDriver>,
  loadable_modules: List<LoadableModuleClass>,
  late_drivers: List<LateDriver>,
  install_packages: List<PackageIntent>,
  late_packages: List<PackageIntent>,
  disk: TargetDiskSelector,
  entry: AdminAccessAuthorisation,
  credential: AdminCredentialPosture,
  // THE READ TRAVELS WITH THE POSTURE IT READS. A receipt is evidence about exactly one secret; sitting beside
  // the handle it was read from, it can only ever be paired with that handle. Held instead as a bind-time or
  // render-time parameter — which is how this was first written — the same function could be handed a seed and
  // some other secret's receipt, and the only thing stopping a wrong join would be the caller's care. The
  // constructor re-checks the pairing, so the field cannot be filled from an unrelated read. (review:
  // merry-fox-82)
  password_read: Optional<AdminPasswordHashReceipt>,
  locale: SeedLocale,
  delivery: SeedDeliveryStrategy,
  keyboard: CeremonialKeyboardLayout,
  proof: NonInteractiveProof,
}

// BUILDING A SEED RUNS THE AUDIT; IT DOES NOT ACCEPT ITS RESULT. The caller supplies inputs and receives
// either a seed whose proof was computed just now from exactly those inputs, or Absent. There is no parameter
// through which a caller can supply a proof, which is the difference between an audit and a stamp. A future
// requirement (re-verifying a seed built before an upstream change) adds a re-audit function beside this one;
// it does not add a proof parameter.
fn build_ubuntu_autoinstall_seed(
  target: ProvisioningTargetAdmission,
  network: SeedNetworkPosture,
  install_drivers: List<SeedInstallDriver>,
  loadable_modules: List<LoadableModuleClass>,
  late_drivers: List<LateDriver>,
  install_packages: List<PackageIntent>,
  late_packages: List<PackageIntent>,
  disk: TargetDiskSelector,
  entry: AdminAccessAuthorisation,
  credential: AdminCredentialPosture,
  // NOT A PROOF, AND NOT OPTIONAL BY CONVENIENCE. The caller hands over the receipt it actually read for THIS
  // handle — or Absent when it read none, which is the honest way to say "the vault read failed" and is a
  // documented reason a seed then refuses to render a document. The pairing is re-checked below rather than
  // trusted: a receipt naming another secret makes the build Absent, so a mismatched join cannot reach a
  // rendered file. Absent-with-a-handle and Absent-without-one stay distinguishable because the posture is
  // stored beside it.
  password_read: Optional<AdminPasswordHashReceipt>,
  locale: SeedLocale,
  delivery: SeedDeliveryStrategy,
  keyboard: CeremonialKeyboardLayout,
) -> Optional<UbuntuAutoinstallSeed> {
  match target {
    TargetRefused { reason: _ } => Absent
    TargetAdmitted { standing: admitted } =>
      match audit_ubuntu_autoinstall_seed(
        network: network,
        install_packages: install_packages,
        late_packages: late_packages,
        locale: locale,
        entry: entry,
        strategy: delivery,
        // THE ADMITTED ARCHITECTURE, not a parameter the caller can point somewhere else: the seed's target
        // carries the architecture it was admitted for, and the package rows must answer to THAT.
        architecture: admitted.architecture,
        credential: credential,
      ) {
        SeedRefused { cause: _ } => Absent
        SeedIsNonInteractive { evidence: established } =>
          match receipt_pairs_credential(credential: credential, password_read: password_read) {
            False => Absent
            True =>
              Present {
                value: UbuntuAutoinstallSeed {
                target: admitted,
                network: network,
                install_drivers: install_drivers,
                loadable_modules: loadable_modules,
                late_drivers: late_drivers,
                install_packages: install_packages,
                late_packages: late_packages,
                disk: disk,
                entry: entry,
                credential: credential,
                password_read: password_read,
                locale: locale,
                delivery: delivery,
                keyboard: keyboard,
                proof: established,
                },
            }
          }
      }
  }
}

// THE PAIRING IS CHECKED, NOT ASSUMED. A receipt is a record of a read of ONE secret, and it carries the
// locator and version it was read from for exactly this moment: handed the wrong one, a seed would render a
// credential nobody sourced for it. Refusing at construction is what makes the seed's password_read field
// evidence rather than a caller's assertion — a reader of the stored seed does not have to re-audit the join,
// because a mismatched join never became a seed. Two absences are distinguished here by the posture stored
// beside the read: PasswordUnset with no read is the declined case, and a handle with no read is "the vault
// read failed", which stays buildable so its refusal can be reported by name at document time instead of
// collapsing into the same nothing as a bad seed.
fn receipt_pairs_credential(
  credential: AdminCredentialPosture,
  password_read: Optional<AdminPasswordHashReceipt>,
) -> Bool {
  match credential {
    // A DECLINED CREDENTIAL CARRIES NO READ. A receipt naming a secret for a seed that says it has no password
    // is not extra evidence, it is a caller who has lost track of which seed they are holding.
    PasswordUnset =>
      match password_read {
        Absent => true
        Present { value: _ } => false
      }
    PasswordHandle { handle: source } =>
      match password_read {
        // NO READ YET IS HONEST, AND IT IS NOT A REFUSAL TO BUILD. The seed can exist before the vault has been
        // read; what it cannot do is render a document, which is refused by name there. Refusing the build too
        // would erase the difference between "the vault is down" and "this seed is bad".
        Absent => true
        Present { value: issued } => receipt_matches_handle(handle: source, issued: issued)
      }
  }
}

// WHICH RECEIPT BELONGS TO WHICH HANDLE — THE WHOLE RULE, IN ONE PLACE (DESIGN §3: each fact lives in exactly
// one place). This used to be spelled three times: here, in the identity projection, and in the password field
// the renderer fills. Three copies of a pairing rule is how a rotated secret ends up in a rendered shadow entry
// — loosening one copy (dropping the version, say, to "fix" a vault migration) changes one of the three doors
// and no test of the other two can see it, because they are different comparisons. If the rule moves again, it
// moves HERE: a future requirement such as accepting a receipt one version behind adds a parameter to this
// function and every door inherits it at once.
fn receipt_matches_handle(handle: AdminPasswordHandle, issued: AdminPasswordHashReceipt) -> Bool {
  issued.secret_locator == handle.secret_locator && issued.secret_version == handle.secret_version
}

// THE RECEIPT IS A SHA-512 CRYPT DIGEST, AND ITS ONLY CONSTRUCTOR PARSES ONE RATHER THAN CHECKING FOR THE
// SHAPE OF ONE. Upstream's AutoinstallIdentity carries a hashed_password string and subiquity writes that value
// into the image's shadow entry. A crypt digest is not the secret — it is what the secret's verifier looks like
// once published — but a caller who could put any string there could put a plaintext password there, and that is
// the incident this shape prevents. So the door takes the format apart: the scheme token, an optional cost, a
// salt over the crypt alphabet within the width the scheme defines, and a digest of exactly the width the scheme
// emits. A receipt therefore cannot be built from "$6$hunter2hunter2hunter2", nor from anything that merely
// BEGINS like a digest. The previous door tested a "$6$" prefix plus a length floor of 20, which accepted exactly
// that string — a sole_constructor guarded by a heuristic is a brand, against DESIGN §5 ("correctness by
// construction, not validation") and §4b ("a brand is cosmetic until construction enforces it"). The seed never
// holds this value: it is taken at the projection edge by whoever writes the file and dropped immediately.
// WHY THE RECEIPT CARRIES THE LOCATOR AND VERSION IT WAS READ FROM, AND NOT ONLY THE DIGEST. A receipt that
// records only a hash can be paired with any handle at projection time: the projection could hand a board a hash
// read from secret-v2 while the seed says the credential is secret-v7, and both records would look internally
// consistent. That is the defect merry-fox-82 caught, and it is the one this module's own digest argument keeps
// making — a record asserting a relationship nothing established. Binding the identity of the secret into the
// receipt makes the join checkable, and the fields are a locator and a version STRING, never the secret itself:
// the door's whole rule is that a credential leaves this module as a reference, and a receipt is the artifact
// most likely to be logged. sole_constructor stays on the payload record, and the only minter (below) fills both
// fields from the handle it was passed, so nobody can write a receipt whose provenance is invented.
//
// WHAT A RECEIPT DOES AND DOES NOT ASSERT (review: merry-fox-82, HOLD §4d). It is a FORMAT-VALIDATED CANDIDATE
// ASSOCIATED WITH A SUPPLIED HANDLE AND VERSION — nothing more. It does not prove a read happened: this module
// never contacts a secret store, and a caller could hand over a digest without opening anything. The claim is
// therefore deliberately weaker than "this is the password". Two things make it worth having, and they are the
// only two claimed: the string cannot have been a plaintext password, and it names the secret it purports to come
// from, so the join against the seed's handle can be checked at all. Anyone who needs "a read actually happened"
// must read that off the vault's own audit trail, which lives outside this programme's modules and is not
// reconstituted here by a field named like a receipt.
type AdminPasswordHashReceipt sole_constructor { crypt_digest: NonEmptyStr, secret_locator: NonEmptyStr, secret_version: NonEmptyStr }

// ONE SUM, SO AN ATTEMPT ANSWERS "WHICH PART FAILED" WITHOUT A SECOND FUNCTION RECOMPUTING THE VERDICT (DESIGN
// §5: every path succeeds fully or fails with a typed, located diagnostic; §2: the same answer computed twice is
// redundant work, and copies drift). A truncated digest and a non-alphabet salt are different operator problems
// with different remedies — one is a paste error at the keyboard, the other is a secret store that never held a
// crypt digest — and collapsing them into a bare `Absent` would send whoever holds the credential to the wrong
// shelf. NO ARM CARRIES ANY TEXT FROM THE CANDIDATE: a refusal is the one thing this door returns that a caller
// may log, and the candidate may BE a plaintext password, so the arms name the failed part and nothing else.
// Admitting another scheme (yescrypt's "$y$", whose digest width differs) adds a ROW to
// extdeps.libxcrypt.crypt_scheme, read from that scheme's own .hash line; it does not relax a refusal, and the
// witnesses over this door force that to be a deliberate edit rather than a widened constant.
type AdminPasswordReceiptResult = ReceiptAccepted { receipt: AdminPasswordHashReceipt } | ReceiptRefused { cause: AdminPasswordRefusalCause }

type AdminPasswordRefusalCause
  = NotACryptDigest
  // FIVE FIELDS WITH NO ROOM FOR A SALT. The cost marker was found, so the generator meant to carry a cost, and
  // the field the salt should occupy is the cost's. Naming it separately matters because this is the shape the
  // shipped library ACCEPTS and then reinterprets — it uses the unrecognised middle field as the salt — so a
  // candidate arriving in this shape was not produced by the library at all.
  | CostFormMissingSalt { fields_seen: Int }
  // A FIELD BEFORE THE SALT THAT IS NEITHER THE SALT NOR A COST. Same five-field count as a legitimate costed
  // setting, minus the marker. The library hashes it (measured: it takes that field as the salt), which is
  // exactly why a crypt_r success cannot be the oracle and this arm has to exist.
  | UnaccountedFieldBeforeSalt { fields_seen: Int }
  | SchemeUnsupported
  | RoundsMalformed
  | SaltAbsent
  | SaltTooLong { length: CharacterCount, ceiling: CharacterCount }
  | SaltHoldsForbiddenCharacter
  | DigestAbsent
  | DigestWrongLength { length: CharacterCount, expected: CharacterCount }
  | DigestNotInCryptAlphabet
  // THE SHARED RESERVED-CHARACTER REFUSAL, and why it is its own arm rather than a fold of the two above.
  // libxcrypt scans the WHOLE setting — prefix, cost, salt and digest alike — before the scheme parser runs, and
  // refuses ! * : ; \ and every non-printable byte wherever they appear. A '!' inside the DIGEST is therefore not
  // DigestNotInCryptAlphabet with extra steps: the digest arm asks "is this a base64-crypt character", and '!'
  // would be refused there too, but only by accident of the alphabet, while ':' IS a character the shared scan
  // refuses and the digest alphabet does not contain either way. The remedies differ, which is the test for
  // separate arms: an alphabet failure means the digest was not produced by a crypt generator, while a reserved
  // character means the string was assembled by hand or truncated through a shell, and on a headless board those
  // are different operators doing different things. No arm carries the offending character or any part of the
  // candidate, for the reason the header gives: the candidate may itself be the secret.
  | SettingHoldsReservedCharacter { reserved: NonEmptyStr }
  // A RECEIPT FOR A CREDENTIAL THAT WAS DECLINED. The seed said "no password", so there is no secret to read a
  // hash from; admitting one here would let a projection install a hash nobody sourced, and it would do so under
  // a record that looks like a read. Separate from NotACryptDigest because the remedy is not "fix the string" —
  // it is "the seed and the receipt disagree about whether this board has a password at all".
  | CredentialHandleUnset

// THE FIGURES COME FROM UPSTREAM, NOT FROM THIS FILE (review 81975). Scheme token, salt bounds, digest
// alphabet, digest width and the cost class are one cited row in extdeps.libxcrypt.crypt_scheme; reading them
// through that row is what keeps the numbers and their citation from drifting apart, and the witness over the
// standing fails if the row's figures are ever changed to suit a fixture. What is ours, and therefore lives
// here, is the decision about which credential form a headless seed will accept — not how a digest is spelled.
//
// WHY THE SALT AND THE DIGEST ARE CHECKED DIFFERENTLY, AND WHY THAT IS NOT AN INCONSISTENCY. The upstream salt
// class is a FORBIDDEN set (any character but '$', ':', CR, LF) while the digest class is an allowed alphabet
// (the 64-character base64-crypt set). Checking the salt against an allowed alphabet — which is what this
// module did until the spec was read — refuses "$6$sa!tsalt$…", a string libxcrypt accepts and shadow stores,
// so it can deny a legitimate administrator access to a board whose only console is the BMC. Checking the
// digest against a forbidden set would admit punctuation that is not a digest character at all. Each check is
// as wide as its class and no wider; collapsing the two is the defect, not the asymmetry.
//
// THE COST FIELD. "rounds=" must be followed by `[1-9][0-9]+` within the documented 1000..999,999,999, which
// the cited row makes decidable from the text's width and characters alone. A leading zero ("rounds=05000") and
// a single digit ("rounds=5") are therefore MALFORMED rather than silently parsed into a number that a range
// check would then accept — a cost nobody intended, on a credential that looks valid until login fails.
//
// THE DOOR. split(sep: "$") on a sha512-crypt digest yields an EMPTY FIRST SEGMENT (from the leading '$'), the
// scheme token, the salt, and the digest — or five segments with "rounds=N" between the token and the salt when
// the cost is spelled out. Both spellings are admitted because real generators emit both and shadow accepts
// both. Every part is checked and the FIRST failure in grammar order is the one reported: the checks are pure and
// bounded over fixed-width strings, so evaluating all of them costs nothing that a short-circuit would save, and
// it keeps this function one flat list instead of a six-deep nest in which an arm can be forgotten.
fn admin_password_hash_receipt(
  credential: AdminCredentialPosture,
  crypt_digest: NonEmptyStr,
) -> AdminPasswordReceiptResult {
  // A RECEIPT IS ONLY POSSIBLE FOR A CREDENTIAL THAT EXISTS. A seed that declined a password has no secret to
  // have read a hash from, so a receipt naming that handle would be a record of a read that cannot have happened
  // — and it is exactly the record that would let a projection install a hash nobody sourced. Refused, with the
  // reason named rather than a bare absence: "no password was configured" and "the hash failed the format door"
  // send the operator to different shelves.
  match credential {
    PasswordUnset => ReceiptRefused { cause: CredentialHandleUnset }
    PasswordHandle { handle: source } =>
      match admin_digest_refusal(crypt_digest: crypt_digest) {
        Present { value: cause } => ReceiptRefused { cause: cause }
        Absent => ReceiptAccepted {
          receipt: AdminPasswordHashReceipt {
            crypt_digest: crypt_digest,
            // Filled from the handle the caller named, not from an argument. There is no parameter here for a
            // caller to mislabel, which is the only reason the fields are worth trusting.
            secret_locator: source.secret_locator,
            secret_version: source.secret_version,
          },
        }
      }
  }
}

// THE FORMAT DOOR, SEPARATED FROM THE PROVENANCE SO ITS OWN TESTS STAY INTERESTING: this is the part that reads
// the string, and nothing else.
fn admin_digest_refusal(crypt_digest: NonEmptyStr) -> Optional<AdminPasswordRefusalCause> {
  let segments = (crypt_digest as String).split(sep: "$")
  let count = list_length(items: segments)
  // ONE LAYOUT FOR THE WHOLE WALK: every position-sensitive arm receives this value rather than deriving a
  // position of its own, because two derivations is exactly how two arms came to disagree about where the salt
  // lives (see crypt_layout).
  let layout = crypt_layout(segments: segments, count: count)
  first_refusal(
    causes: [
      // THE SHARED SCAN RUNS FIRST, BECAUSE UPSTREAM RUNS IT FIRST. libxcrypt checks the whole setting string in
      // lib/crypt.c before it dispatches to the sha512 parser (crypt.c at the cited tag: check_badsalt_chars is
      // called, and only after it returns does get_hashfn pick the scheme). Order is not cosmetic here: a
      // candidate with a '!' in its digest breaks both the shared scan and the digest alphabet, and the diagnosis
      // an operator acts on is the shared one — the string was assembled by something other than a crypt
      // generator. Reporting the alphabet failure instead would send them to the secret store for a shell bug.
      // See crypt_acceptance_rules in extdeps.libxcrypt.crypt_scheme, which states the same order as data and is
      // swept by the witness so a reordering here cannot become silent.
      reject_shared_scan(candidate: crypt_digest),
      reject_layout(count: count, layout: layout),
      reject_shape(segments: segments),
      reject_scheme(segments: segments, count: count),
      reject_cost(segments: segments, layout: layout),
      reject_salt_for_layout(segments: segments, layout: layout),
      reject_digest_for_layout(segments: segments, layout: layout),
    ],
  )
}

// WHAT THE SHIPPING LIBRARY DOES, RECORDED WHERE THE OBSERVATION BELONGS (review 82734). These rows
// used to sit in extdeps.libxcrypt.crypt_scheme, which is the wrong layer: DESIGN §3b puts
// "observations this repository makes" in the CONSUMING layer, and §3's decomposition line says the
// same thing from the other end -- "observations this repository makes are receipts in the observing
// layer, not facts of the observed upstream". libxcrypt publishes a document; it does not publish
// what its shipped .so did when this repository called it. Every row below is therefore ours, and it
// is consumed here rather than shelved: three sweep witnesses run every row through the door above, and
// the rows are a differential against the library that ships in the target image — deleting one or
// flipping one reddens a witness. The ledger's per-arm composition (settings the library accepted that really
// are complete stored hashes / accepted that are not / refused outright) is DERIVED, not transcribed: the witness
// re-counts it on every run through accepted_row_count, stored_hash_gap_row_count and refused_row_count, and the
// sweeps assert those counts against the total. No number in a comment here can be edited into agreement with a
// changed row set, which is the failure a stated denominator invites.
//
// WHAT IS DELIBERATELY NOT A ROW: the width disagreements — an 85-character digest, or a salt outside the
// documented range — where the library agrees and this module's shadow-entry contract still refuses.
// Those are this module's own policy, not a measurement of a disagreement, and they are pinned by their
// own witnesses (an 85-char digest, a one-character salt) rather than by a ledger row that would imply
// somebody measured the library's tolerance and found it tolerant. A one-character salt with a COMPLETE
// digest is a row, because the library really did accept it and it really is a usable stored hash; the
// refusal of the same width by the shadow-entry contract is a separate claim, stated where it is tested.
//
// THE MEASUREMENT EVIDENCE IS THE RECORD ITSELF, NOT A CITATION TO THE MANUAL (review: merry-fox-82).
// observed_build names the exact package version the probe linked against and observed_on names the
// architecture and image; the probe's source and its per-candidate watchdog live with the measurement
// (driver source in the PR's evidence account). libxcrypt's manual, cited on the extdeps shelf, establishes
// the CONTRACT; it cannot establish what the shipped .so did, and it is not offered here as if it did.
//
// THREE ARMS, BECAUSE A SUCCESSFUL crypt_r CALL ANSWERS A WEAKER QUESTION THAN "IS THIS A STORED HASH"
// (review: merry-fox-82). The library never reads back the digest field it was handed, so it hashes
// settings whose digest slot is a salt, or whose middle field it does not recognise, and returns a real
// string. Measured against libcrypt1 1:4.4.36-4build1 (Noble arm64, direct-linked, per-candidate
// watchdog; exact.c prints the library's OWN output): "$6$rounds=1000$<86>" comes back as a hash whose
// salt field IS the 86-character digest, and in "$6$ignored$saltsalt$<86>" the unrecognised middle
// field is used as the salt. So "the library accepted it" and "this can authenticate a login" are
// different claims, and recording them in one arm would hide the only disagreement that matters: on the
// rows in the middle arm the module must REFUSE where the library agrees. If those rows were folded into
// the accepted arm, the sweep witness would demand agreement with the library and this module would have
// to be wrong to pass it — which is the failure mode the whole shadow-entry contract exists to avoid.
type CryptLibraryVerdict
  = LibraryAccepted { setting: NonEmptyStr }
  // MEASURED ACCEPTED BY THE SHIPPING LIBRARY, AND NOT A COMPLETE STORED HASH. Every row here is a
  // setting the library hashed and no login could ever reproduce. The module must refuse each one by the
  // GAP arm it carries — not by an alphabet, a width, or a scheme.
  | LibraryAcceptedButNotAStoredHash { setting: NonEmptyStr, gap: UnstoredHashGap }
  | LibraryRefused { setting: NonEmptyStr }

// WHY AN ACCEPTED SETTING COULD NEVER VERIFY A PASSWORD. Closed, because these are exactly the two
// structures measured, and each sends an operator to a different generator bug: a build pipeline that
// dropped the salt after the cost, versus one that inserted a field the format has no name for. Each
// carries the field count the measurement saw, so a row cannot be re-labelled later without saying how
// many fields were involved. A third gap (a cost marker in the wrong case, say) is not added here on
// speculation — it needs its own measurement and its own row.
// THE ARMS ARE PREFIXED, NOT SHARED. They name the same two defects the door's refusal arms name, and the
// witness checks the pairing arm-for-arm. The prefix exists because one closure may not hold two variants of
// that spelling, and because a ledger row and a refusal are different kinds of thing: the row records what the
// library did, the refusal is what this module does about it. Collapsing the two would let a row be "satisfied"
// by whatever the door happened to say instead of by what was measured.
type UnstoredHashGap
  = GapCostFormMissingSalt { fields_seen: Int }
  | GapUnaccountedFieldBeforeSalt { fields_seen: Int }

// THE MEASUREMENT, AS A CLOSED ROW RATHER THAN A PROSE PARAGRAPH. Three arms and no free text: the
// build the measurement was taken against, the rows, and the single thing still owed. The build is a
// field and not a comment because a verdict recorded without its build is unusable later -- the same
// candidate was refused on one Debian libcrypt1 and accepted on another, so "libxcrypt refuses this"
// means nothing until the build is named. Absence is not modeled as an empty string anywhere here:
// `owed` is Optional, because a measurement can be complete for its own purpose, and pretending it
// always owes something would invent an obligation nobody can discharge.
type CryptLibraryAcceptance {
  observed_build: NonEmptyStr,
  observed_on: List<NonEmptyStr>,
  verdicts: List<CryptLibraryVerdict>,
  owed: Optional<NonEmptyStr>,
}

data crypt_library_acceptance: CryptLibraryAcceptance = CryptLibraryAcceptance {
  observed_build: "libcrypt1 1:4.4.36-4build1 (Ubuntu Noble), libcrypt.so.1.1.0, crypt_r(password, setting)" as NonEmptyStr,
  observed_on: [
    "amd64 Noble, the archive build linked directly" as NonEmptyStr,
    "arm64 Noble native (the target architecture)" as NonEmptyStr,
    "the CI image, Debian libcrypt1 4.4.38-1" as NonEmptyStr,
  ],
  verdicts: [
    // ACCEPTED, AND A COMPLETE STORED HASH: four- and five-field settings whose digest slot really holds the
    // 86 characters. These are where this module's door and the library agree, and the sweep requires it.
    LibraryAccepted { setting: "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // plain salt
    LibraryAccepted { setting: "$6$rounds=1000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost at the documented floor
    LibraryAccepted { setting: "$6$rounds=999999999$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost at the documented ceiling
    LibraryAccepted { setting: "$6$~a.b_c-d+e$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // punctuation INSIDE a four-field salt: not the shared scan's set, and the digest slot still holds the 86
    LibraryAccepted { setting: "$6$sa=ltx$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // an '=' inside the salt
    LibraryAccepted { setting: "$6$s$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // a one-character salt — a WIDTH disagreement, so the digest slot is still complete
    LibraryAccepted { setting: "$6$ssssssssssssssss$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // sixteen characters
    // ACCEPTED BY THE LIBRARY, AND NOT A STORED HASH — the disagreement, kept where it cannot be swept away.
    LibraryAcceptedButNotAStoredHash {
      setting: "$6$rounds=1000$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr,
      gap: GapCostFormMissingSalt { fields_seen: 4 },
    }, // the library's own reply uses the 86 as the SALT (exact.c)
    LibraryAcceptedButNotAStoredHash {
      setting: "$6$ignored$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr,
      gap: GapUnaccountedFieldBeforeSalt { fields_seen: 5 },
    }, // "ignored" is hashed AS the salt
    LibraryAcceptedButNotAStoredHash {
      setting: "$6$ROUNDS=1000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr,
      gap: GapUnaccountedFieldBeforeSalt { fields_seen: 5 },
    }, // the marker's case is load-bearing upstream too
    LibraryAcceptedButNotAStoredHash {
      setting: "$6$9999$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr,
      gap: GapUnaccountedFieldBeforeSalt { fields_seen: 5 },
    }, // digits with no marker are not a cost
    // REFUSED BY THE LIBRARY, and refused here too.
    LibraryRefused { setting: "$6$sa!tsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // salt
    LibraryRefused { setting: "$6$sa:ltsa$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // salt
    LibraryRefused { setting: "$6$sa*tsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // salt
    LibraryRefused { setting: "$6$sa ltx$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // salt
    LibraryRefused { setting: "$6$sa\tltx$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // salt
    LibraryRefused { setting: "$6$rounds=999$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost field
    LibraryRefused { setting: "$6$rounds=1000000000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost field
    LibraryRefused { setting: "$6$rounds=$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost field
    LibraryRefused { setting: "$6$rounds=-1$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost field
    LibraryRefused { setting: "$6$rounds=1 000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost field
    LibraryRefused { setting: "$6$rounds=abc$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost field
    LibraryRefused { setting: "$6$rounds=05000$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost field
    LibraryRefused { setting: "$6$rounds=1000rounds=garbage$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj." as NonEmptyStr }, // cost field
  ],
  owed: Present { value: "*0 tells you the library refused, not WHY: reserved-character and malformed-setting both arrive as errno=22, and separating them needs the library source or a status field the probe does not read. The refusals above are established; their causes are not. The same limit runs the other way: the middle arm records THAT the library hashed a setting, and the salt it used was read from the library's own reply — the probe does not ask the library which field it chose, so each gap is stated by the shape of the setting, not by a claim about the library's internals." as NonEmptyStr },
}

// THE ROWS, FOR A CONSUMER THAT MUST CHECK ITS OWN VERDICT AGAINST THEM. A function rather than the
// record, so a witness folds the rows without unpacking the build twice.
fn crypt_library_verdicts() -> List<CryptLibraryVerdict> {
  crypt_library_acceptance.verdicts
}

// GRAMMAR ORDER IS THE ORDER OF DIAGNOSTIC USEFULNESS: "that is not a digest at all" is worth more than "and its
// salt is 20 characters", because the second is only reachable once the first has been ruled out.
fn first_refusal(
  causes: List<Optional<AdminPasswordRefusalCause>>,
) -> Optional<AdminPasswordRefusalCause> {
  match causes {
    Empty => Absent
    Cons { head: head, tail: rest } =>
      match head {
        Present { value: cause } => Present { value: cause }
        Absent => first_refusal(causes: rest)
      }
  }
}

// FOUR SEGMENTS WITHOUT A COST, FIVE WITH ONE — and nothing else. The count is asserted rather than assumed, so a
// candidate with an extra '$' inside the salt region is refused for the shape it actually has instead of being
// truncated into something that looks well-formed.
// THE SHARED SCAN, DELEGATED TO THE SHELF THAT OWNS THE RULE. This function owns only the naming: it turns the
// shelf's boolean into the arm an operator acts on, and it names WHICH reserved character was found without
// quoting anything else about the candidate. Naming the character is not a leak — the set is five characters,
// all of them published in the citation — and it is the difference between "your string is wrong somewhere" and
// "your string contains a colon", the second of which a person can fix at a keyboard on a board they cannot
// reach. No other part of the candidate travels out of this function.
fn reject_shared_scan(candidate: NonEmptyStr) -> Optional<AdminPasswordRefusalCause> {
  match shared_restriction_rejects(candidate: candidate as String) {
    False => Absent
    True => Present { value: SettingHoldsReservedCharacter { reserved: first_reserved_character(candidate: candidate) } }
  }
}

// WHICH CHARACTER, ANSWERED BY ASKING THE SHELF'S OWN LIST. Folded over the published reserved set rather than
// scanning byte ranges locally: the set is upstream's, it is already data on the shelf, and a second copy here
// would be a second place to be wrong. If nothing in the set matches, the refusal must still be answered — that
// is the printable-range half of the rule (space, tab, DEL, high bytes), which is why the fallback names the
// range rather than claiming one of the five.
fn first_reserved_character(candidate: NonEmptyStr) -> NonEmptyStr {
  match fold(
    crypt_reserved_characters(),
    init: "" as String,
    f: (found, character) =>
      match found == "" {
        False => found
        True => match (candidate as String).contains(needle: character as String) {
          True => character as String
          False => ""
        }
      },
  ) {
    "" => "non-printable"
    found => found as NonEmptyStr
  }
}

// WHERE EACH FIELD SITS. One parse of the setting produces this, and every position-sensitive arm downstream
// reads its index out of IT rather than recomputing from the field count. That is the whole point: an earlier
// revision asked "four fields or five?" separately in four functions, and when one of them disagreed about a
// five-field setting the digest check was silently skipped and a garbage digest was accepted as a password hash.
// Two members because sha512-crypt has exactly two spellings — with and without the optional cost — and a third
// shape is a refusal, not a layout. A future scheme with a different grammar adds its own layout type beside this
// one; it does not widen this one, or the two-arm exhaustiveness that makes the skipping impossible is gone.
type CryptLayout
  = FourFieldsWithoutCost { salt_index: Int, digest_index: Int }
  | FiveFieldsWithCost { cost_index: Int, salt_index: Int, digest_index: Int }

// THE ONE PARSE. Returns Absent when the candidate's field structure is not a sha512-crypt setting at all, and
// names WHICH structural failure it was rather than folding the cases together: a cost with no room for a salt, a
// field before the salt that is neither the salt nor a cost, or a field count outside the two-member grammar.
// Those are three different operator conversations, and collapsing them is how a shell-assembled string gets
// diagnosed as a bad password.
fn crypt_layout(segments: List<String>, count: Int) -> Optional<CryptLayout> {
  match sha512_crypt_format {
    Sha512CryptFormat {
      scheme_token: _, cost_marker: marker, salt_forbidden_characters: _, salt_least_characters: _,
      salt_greatest_characters: _, digest_alphabet: _, digest_exact_characters: _, cost_least_digits: _,
      cost_greatest_digits: _, figure_standing: _,
    } =>
      match piece_at(pieces: segments, index: 2) {
        Absent => Absent
        // THE COST IS RECOGNISED BY ITS MARKER AT ITS OWN POSITION. Position 2, because the grammar has no other
        // place a cost can sit; and the marker comparison is case-sensitive, because upstream's strncmp against
        // "rounds=" is: "$6$ROUNDS=1000$..." is not a cost upstream either, it is a field that means nothing.
        Present { value: field } =>
          match field.starts_with(prefix: marker as String) {
            True =>
              match count {
                // A cost and then nothing to hash: the token after the cost was going to be read as the salt and
                // there is no token left. Upstream hashes this anyway — measured, not alleged: against libcrypt1
                // 1:4.4.36-4build1 (Noble arm64, direct-linked, ldd-verified, crypt_r under a per-candidate
                // watchdog) "$6$rounds=1000$<86>" returns a real hash whose own salt field is the 86-character
                // digest. THAT is why a successful crypt_r cannot be our oracle: the library never reads the
                // digest it returns, so it accepts settings that could never verify a password.
                4 => Absent
                5 => Present { value: FiveFieldsWithCost { cost_index: 2, salt_index: 3, digest_index: 4 } }
                _ => Absent
              }
            False =>
              match count {
                4 => Present { value: FourFieldsWithoutCost { salt_index: 2, digest_index: 3 } }
                5 => Absent
                _ => Absent
              }
          }
      }
  }
}

// WHICH STRUCTURAL FAILURE, SAID SEPARATELY. Split out of crypt_layout so the three diagnoses stay three arms
// (a type cannot carry "which of my Absent branches fired" without lying about the others).
// THE STRUCTURAL SENTENCE ABOUT A PARSE THAT ALREADY HAPPENED. This function no longer looks at the segments at
// all: an earlier revision re-tested the cost marker and the field count here, because reject_layout had to
// "know" whether field 2 was a cost. That was a SECOND implementation of the grammar, and DESIGN §5 names the
// defect exactly — "a check restating a constraint the model already carries is a second representation of it".
// Two derivations is also how the two functions came to disagree about where the salt lives, and it made the
// grammar mutable in two places at once: loosening the field-count rule here while crypt_layout stayed strict
// changed only the SENTENCE an operator reads, never the verdict, so no test of acceptance could see it. Now
// there is one parse, and this maps its Absent reasons onto the three operator conversations. A future grammar
// change (say a cost permitted in a sixth field) edits crypt_layout and gains a CryptLayout arm; nothing here
// needs to know the new spelling.
fn reject_layout(count: Int, layout: Optional<CryptLayout>) -> Optional<AdminPasswordRefusalCause> {
  match layout {
    Present { value: _ } => Absent
    // WHICH OF THE GRAMMAR'S THREE REFUSALS, told apart by the only thing the parse could not use: the count.
    Absent =>
      match count {
        // A cost, and then no token left to hash. Distinct from the next arm because the remedies differ: this
        // one is a truncated string, usually a shell quoting accident, while that one is a field the grammar has
        // no name for.
        4 => Present { value: CostFormMissingSalt { fields_seen: count } }
        // A fifth field that is neither a cost at its position nor a recognised token; the salt is in position 3
        // by elimination, and the shipping library would hash on it as the salt (measured), which is why the
        // shape is refused here rather than forgiven.
        5 => Present { value: UnaccountedFieldBeforeSalt { fields_seen: count } }
        // Neither documented spelling, at any count: not a sha512-crypt setting at all.
        _ => Present { value: NotACryptDigest }
      }
  }
}

// THE LEADING-TOKEN RULE ONLY. The FIELD COUNT is reject_layout's to own: it has to know the count to decide
// whether field 2 is a cost, and asking the same question in two functions is precisely how the two answers came
// to disagree. This function contributes the one thing reject_layout cannot see — that a sha512-crypt setting
// begins with '$', so the split's first token is empty.
fn reject_shape(segments: List<String>) -> Optional<AdminPasswordRefusalCause> {
  match piece_at(pieces: segments, index: 0) {
    Present { value: leading } =>
      match leading == "" {
        True => Absent
        False => Present { value: NotACryptDigest }
      }
    Absent => Present { value: NotACryptDigest }
  }
}

// THE SCHEME TOKEN IS READ FROM THE CITED ROW, never re-typed here. This is the check that makes the row
// load-bearing in this module: retyping "6" locally, or pointing at a different row, is what would let the
// figures and their citation drift apart while every witness still passed.
// THE COST IS RECOGNISED AT ITS POSITION, NOT BY HOW MANY DELIMITERS THE CANDIDATE HAPPENS TO CONTAIN
// (review: merry-fox-82). The old rule read `count == 5` and only then looked at the cost, which silently made
// segment COUNT the thing that decides — and libxcrypt never counts segments. It memcmps "rounds=" at the start
// of the field that follows the prefix. Measured consequences of the count rule, on the shipped library:
//
//   "$6$rounds=abc$<86>"  three fields, no salt   -> the LIBRARY REFUSES; the count rule called it a salt and
//                                                    ACCEPTED it. A malformed cost admitted as a salt is exactly
//                                                    the credential that looks valid until login fails.
//   "$6$rounds=1000rounds=garbage$saltsalt$<86>"   -> refused either way, but by the count rule for the WRONG
//                                                    reason (SaltTooLong), which sends the operator to the salt
//                                                    instead of to the generator that emitted the string.
//   "$6$sarounds=1000$<86>"                        -> a SALT that merely contains the marker; the library accepts
//                                                    it (case-sensitive memcmp, and it is not at position zero).
//                                                    So "does the candidate contain rounds=" cannot decide either.
//
// The rule now: look at the field that follows the scheme token; if it BEGINS with the marker, that field is a
// cost and the WHOLE field must be marker + digits, with no trailing content behind it. If it does not begin with
// the marker, there is no cost and this check has nothing to say — the salt check owns that field, including a
// salt that contains the marker. Deliberately not a split on the marker anywhere in the string: the first split
// was what let garbage hide after a valid cost, because the digits field it produced looked well-formed while the
// rest of the field was never examined.
// THE COST, CHECKED AT THE POSITION THE LAYOUT GAVE IT — and only when the layout says one exists. The earlier
// version asked this field whether it began with the marker and, when it did not, consulted a SECOND answer (the
// raw segment count) to decide whether to complain; count 5 with an unrecognised middle field was then refused by
// nobody, because the count rule had already passed and this arm stayed silent. Silence is not a verdict here.
//
// WHY REFUSE "$6$ignored$saltsalt$D86" AT ALL WHEN UPSTREAM HASHES IT. Measured against the shipping library
// (libcrypt1 1:4.4.36-4build1, Noble arm64, direct-linked, ldd-verified, crypt_r under a per-candidate watchdog),
// that candidate is ACCEPTED: crypt_r returns a real 106-character hash whose own salt field is "ignored" — the
// library read the unrecognised middle field as part of the SALT. So a successful crypt_r cannot be our oracle for
// a stored hash: the library never reads back the digest it was handed, and it will happily derive a key from a
// salt nobody chose. A string that hashes against an unintended salt is a string that can be stored as a
// credential and then NEVER verify against the password it was generated from, which is the failure this shelf
// exists to keep off the board. The refusal is therefore OURS, on that ground, and the acceptance ledger keeps
// reporting what the library does without this arm inheriting it.
// FUTURE REQUIREMENT: a second cost spelling upstream enters as another marker on the cited row and this arm
// widens by reading it. It never widens by admitting an unexamined field.
fn reject_cost(
  segments: List<String>,
  layout: Optional<CryptLayout>,
) -> Optional<AdminPasswordRefusalCause> {
  match layout {
    // No layout, no verdict: reject_layout has already refused this candidate and named why.
    Absent => Absent
    Present { value: FourFieldsWithoutCost { salt_index: _, digest_index: _ } } => Absent
    Present { value: FiveFieldsWithCost { cost_index: index, salt_index: _, digest_index: _ } } =>
      match piece_at(pieces: segments, index: index) {
        Absent => Present { value: RoundsMalformed }
        Present { value: field } =>
          match sha512_crypt_format {
            Sha512CryptFormat {
              scheme_token: _, cost_marker: marker, salt_forbidden_characters: _, salt_least_characters: _,
              salt_greatest_characters: _, digest_alphabet: _, digest_exact_characters: _, cost_least_digits: _,
              cost_greatest_digits: _, figure_standing: _,
            } =>
              match cost_field_is_well_formed(digits: field.substring(start: marker.length(), end: field.length())) {
                True => Absent
                False => Present { value: RoundsMalformed }
              }
          }
      }
  }
}

// THE SALT SITS ONE FROM THE END IN BOTH SPELLINGS, so the index follows the count instead of being two
// hard-coded positions that have to agree with each other. Width is read from the cited row and the character
// test is the upstream FORBIDDEN-set scan, not an allowed-alphabet strip (see the note above for why the
// difference is a safety property and not a style choice).
// THE WIDTHS, READ THE SAME WAY THE CHECKS READ THEM. If the segment is missing the check that refuses for it
// fires first, so zero is not a lie about a real salt — it is simply never compared. Keeping these beside
// piece_at rather than calling .length() at two call sites is what stops the measured value and the refused value
// from ever being read out of different segments.
// THE POSITIONS, ASKED OF THE LAYOUT — never recomputed from the count. `count - 2` happened to be the salt in
// both arities, which is exactly the kind of coincidence that survives a grammar change silently: with the cost
// present the salt is at 3 and the digest at 4, and only the layout knows that.
// THE SALT SITS ONE FROM THE END IN BOTH SPELLINGS, so the index follows the count instead of being two
// hard-coded positions that have to agree with each other. Width is read from the cited row and the character
// test is the upstream FORBIDDEN-set scan, not an allowed-alphabet strip (see the note above for why the
// difference is a safety property and not a style choice).
fn reject_salt_for_layout(segments: List<String>, layout: Optional<CryptLayout>) -> Optional<AdminPasswordRefusalCause> {
  match layout {
    Absent => Absent
    Present { value: shape } => reject_salt_at(segments: segments, layout: shape)
  }
}

fn reject_salt_at(segments: List<String>, layout: CryptLayout) -> Optional<AdminPasswordRefusalCause> {
  let measured_salt = character_count(count: salt_length_of(segments: segments, layout: layout))
  match sha512_crypt_format {
    Sha512CryptFormat {
      scheme_token: _, cost_marker: _, salt_forbidden_characters: _, salt_least_characters: least,
      salt_greatest_characters: greatest, digest_alphabet: _, digest_exact_characters: _, cost_least_digits: _,
      cost_greatest_digits: _, figure_standing: _,
    } =>
      match piece_at(pieces: segments, index: salt_index_of(layout: layout)) {
        Absent => Present { value: SaltAbsent }
        Present { value: salt } =>
          // Compared ON THE COUNT AXIS rather than against a bare Int. `a < b` is `not (b <= a)` because
          // std.measure offers the weak order, not the strict one; writing `salt.length() < least` would have
          // meant comparing a host integer to a measure, which is exactly the mix the carrier exists to stop.
          match measure_le(a: least, b: measured_salt) {
            False => Present { value: SaltAbsent }
            True =>
              match measure_le(a: measured_salt, b: greatest) {
                False => Present { value: SaltTooLong { length: measured_salt, ceiling: greatest } }
                True =>
                  // THE SALT CLASS, WHICH THE SHARED SCAN ALREADY ENFORCES — AND WHY IT IS STILL HERE. Every
                  // character this class forbids is refused before this line can be reached: '$' cannot occur in
                  // the segment at all, because '$' is what the segmentation splits on, and ':', CR and LF are
                  // refused by the shared scan that runs first. So the refusal below is unreachable while the
                  // ordering holds, which is exactly why the ordering is a PINNED PROPERTY rather than an
                  // assumption (witness: the_salt_character_class_is_subsumed_by_the_shared_scan) — if a future
                  // edit reorders the walk or weakens the scan, this class is what still refuses a delimiter in
                  // a salt, and the witness that pins the subsumption goes red at the same moment. It is NOT a
                  // substitute for the scan: the class alone misses '!', ';', '*', backslash and every
                  // non-printable byte, and a shelf that had only the class is what accepted "$6$sa!tsalt$..."
                  // on the strength of the .hash grammar.
                  match salt_holds_only_admitted_characters(salt: salt) {
                    True => Absent
                    False => Present { value: SaltHoldsForbiddenCharacter }
                  }
              }
          }
      }
  }
}

// THE WIDTH IS EXACT, NOT A FLOOR, and the width is the cited row's. A floor is precisely how a TRUNCATED digest
// gets in — the likeliest corruption when a hash is copied out of a terminal or a log line — to sit in a shadow
// entry where it can never authenticate, leaving a board that looks like it has no password set. The character
// test is the allowed-alphabet strip, because the digest's class IS an enumeration upstream.
fn reject_digest_for_layout(segments: List<String>, layout: Optional<CryptLayout>) -> Optional<AdminPasswordRefusalCause> {
  match layout {
    Absent => Absent
    Present { value: shape } => reject_digest_at(segments: segments, layout: shape)
  }
}

fn reject_digest_at(segments: List<String>, layout: CryptLayout) -> Optional<AdminPasswordRefusalCause> {
  let measured_digest = character_count(count: digest_length_of(segments: segments, layout: layout))
  match sha512_crypt_format {
    Sha512CryptFormat {
      scheme_token: _, cost_marker: _, salt_forbidden_characters: _, salt_least_characters: _,
      salt_greatest_characters: _, digest_alphabet: _, digest_exact_characters: width, cost_least_digits: _,
      cost_greatest_digits: _, figure_standing: _,
    } =>
      match piece_at(pieces: segments, index: digest_index_of(layout: layout)) {
        Absent => Present { value: DigestAbsent }
        Present { value: digest } =>
          match digest.length() == 0 {
            True => Present { value: DigestAbsent }
            False =>
              match measured_digest == width {
                False => Present { value: DigestWrongLength { length: measured_digest, expected: width } }
                True =>
                  match digest_characters_are_admitted(digest: digest) {
                    True => Absent
                    False => Present { value: DigestNotInCryptAlphabet }
                  }
              }
          }
      }
  }
}

// THE WIDTHS, READ THE SAME WAY THE CHECKS READ THEM. If the segment is missing the check that refuses for it
// fires first, so zero is not a lie about a real salt — it is simply never compared. Keeping these beside
// piece_at rather than calling .length() at two call sites is what stops the measured value and the refused value
// from ever being read out of different segments.
// THE POSITIONS, ASKED OF THE LAYOUT — never recomputed from the count. `count - 2` happened to be the salt in
// both arities, which is exactly the kind of coincidence that survives a grammar change silently: with the cost
// present the salt is at 3 and the digest at 4, and only the layout knows that.
fn digest_length_of(segments: List<String>, layout: CryptLayout) -> Int {
  match piece_at(pieces: segments, index: digest_index_of(layout: layout)) {
    Absent => 0
    Present { value: digest } => digest.length()
  }
}

fn salt_index_of(layout: CryptLayout) -> Int {
  match layout {
    FourFieldsWithoutCost { salt_index: index, digest_index: _ } => index
    FiveFieldsWithCost { cost_index: _, salt_index: index, digest_index: _ } => index
  }
}

fn digest_index_of(layout: CryptLayout) -> Int {
  match layout {
    FourFieldsWithoutCost { salt_index: _, digest_index: index } => index
    FiveFieldsWithCost { cost_index: _, salt_index: _, digest_index: index } => index
  }
}

// INDEXING THAT SAYS ABSENT. The builtin index/last helpers yield a null value when the list is too short, which
// is indistinguishable from an empty segment; this walks the structure so a missing piece is REFUSED rather than
// silently read as the empty string — which, for a digest, would mean a length of zero and a wrong-length
// refusal that blamed the wrong part.
fn salt_length_of(segments: List<String>, layout: CryptLayout) -> Int {
  match piece_at(pieces: segments, index: salt_index_of(layout: layout)) {
    Absent => 0
    Present { value: salt } => salt.length()
  }
}

fn reject_scheme(segments: List<String>, count: Int) -> Optional<AdminPasswordRefusalCause> {
  match sha512_crypt_format {
    Sha512CryptFormat {
      scheme_token: token, cost_marker: _, salt_forbidden_characters: _, salt_least_characters: _,
      salt_greatest_characters: _, digest_alphabet: _, digest_exact_characters: _, cost_least_digits: _,
      cost_greatest_digits: _, figure_standing: _,
    } =>
      match piece_at(pieces: segments, index: 1) {
        Present { value: found } =>
          match found == (token as String) {
            True => Absent
            False => Present { value: SchemeUnsupported }
          }
        Absent => Present { value: SchemeUnsupported }
      }
  }
}

fn piece_at(pieces: List<String>, index: Int) -> Optional<String> {
  match pieces {
    Empty => Absent
    Cons { head: first, tail: rest } =>
      if index == 0 { Present { value: first } } else { piece_at(pieces: rest, index: index - 1) }
  }
}

// THE ONLY ROUTE FROM OUR SEED INTO UPSTREAM'S PAYLOAD, AND WHERE IT REFUSES. AutoinstallIdentity demands a
// hostname and a NonEmptyStr hashed_password, and neither is something this module may supply from its own
// state: a hostname inside a seed is the machine-name prohibition, enforced in code rather than prose, and a
// password string held by the seed would be a secret sitting in a type. So the hostname is passed IN by the
// binding layer — naming is that layer's job — and the digest arrives as a receipt already validated by its
// own constructor. Two independent refusals follow: PasswordUnset cannot fill a field upstream requires (a
// shape gap reported upstream, not patched around here), and a receipt that is not a digest cannot reach the
// projection at all.
// THE PROJECTION JOINS THE RECEIPT TO THE CREDENTIAL THE SEED NAMES (review: merry-fox-82). Before this, the
// receipt's content was trusted and its provenance was not looked at: a digest read from secret-v2 could be
// projected onto a seed whose handle points at secret-v7, or onto a seed that declined a password entirely, and
// both produced a successful identity. The join compares the receipt's locator and version against the handle the
// seed carries — fields that only the door could have filled, from the handle it was passed — so agreement here
// means a read actually happened against the named secret.
//
// WHY A TYPED VERDICT RATHER THAN Absent. Every way this can fail is a different operator action: no receipt
// means nothing was read; a mismatch means the wrong secret was read (or the handle moved under the seed); a
// declined credential means the seed and the caller disagree about whether the board has a password. Returning
// `Absent` for all three is how a provisioning program ends up re-running a step forever on a mismatch it cannot
// name. Absence of a password is NOT reported as an error either — it is its own arm, because a key-only board is
// a legitimate seed and its identity legitimately has no hash.
type IdentityProjection
  = ProjectedIdentity { identity: AutoinstallIdentity }
  | IdentityHasNoCredential { posture: NonEmptyStr }
  | IdentityReceiptMissing
  | IdentityReceiptIsForeign { expected: NonEmptyStr, presented: NonEmptyStr }

fn project_autoinstall_identity(
  seed: UbuntuAutoinstallSeed,
  binding_hostname: NonEmptyStr,
  receipt: Optional<AdminPasswordHashReceipt>,
) -> IdentityProjection {
  match seed.credential {
    // THE POSTURE IS REPORTED, NOT THE ABSENCE. "No password on this seed" is the answer a caller needs; whether
    // that is fine depends on the console and key posture the seed already proved at admission, and the caller can
    // see it there. Nothing here pretends the identity is complete.
    PasswordUnset => IdentityHasNoCredential { posture: "credential-unset" }
    PasswordHandle { handle: source } =>
      match receipt {
        Absent => IdentityReceiptMissing
        Present { value: issued } =>
          match receipt_matches_handle(handle: source, issued: issued) {
            // A receipt from a different secret is refused by name — locator and version, both of which are
            // references and neither of which is the secret. Naming them is how an operator tells "the vault
            // moved" from "the seed is stale", and it is safe precisely because a locator is not a credential.
            False => IdentityReceiptIsForeign {
              expected: locator_version(locator: source.secret_locator, version: source.secret_version),
              presented: locator_version(locator: issued.secret_locator, version: issued.secret_version),
            }
            True => ProjectedIdentity {
              identity: AutoinstallIdentity {
                hostname: binding_hostname,
                username: "gunbc-admin" as NonEmptyStr,
                realname: "gunbc provisioning" as NonEmptyStr,
                hashed_password: issued.crypt_digest,
              },
            }
          }
      }
  }
}

fn locator_version(locator: NonEmptyStr, version: NonEmptyStr) -> NonEmptyStr {
  concat(concat(locator, "@"), version) as NonEmptyStr
}

// THE DISK POLICY IS DERIVED FROM THE SELECTION, NEVER FROM A NAME. Upstream's storage policy is a two-member
// enum with no selector field, which is exactly why the selection must happen HERE, before the projection: the
// payload can only say "lay down directly", and which disk that means is decided by the rule over the probe's
// observations. A projection that accepted a device name would be the guess this module exists to prevent.
// THE PROJECTION KEEPS THE DISK, OR IT SAYS IT DID NOT. (review: merry-fox-82) The upstream
// AutoinstallStoragePolicy is a two-arm switch with nowhere to put a device — it says "lay out one direct
// filesystem", not "onto which disk" — and this module must not edit it. The old projection returned that
// policy for a selected disk and dropped the disk on the floor, which is the worst shape a projection can
// have: it reports success, and the field the whole decision turned on is gone. A downstream consumer reading
// the policy alone could lay out the correct KIND of filesystem on the wrong drive, which is the failure this
// cut was chartered to prevent.
//
// So the projection is a pair or a verdict, never a bare policy: a resolved projection carries the evidence
// that the device is the one the seed's rule selected, and every way the selection can fail now has an arm that
// says which. Adding a device-bearing policy upstream would add an arm here; quietly returning the policy by
// itself is what the type now makes impossible.
type StorageProjection
  = Projected { policy: AutoinstallStoragePolicy, device: BoundDiskEvidence, provenance: DiskSelectionProvenance }
  | ProjectionUnresolved { cause: DiskSelectionRefusalCause }

fn project_storage_policy(selection: TargetDiskSelection) -> StorageProjection {
  match selection {
    DiskSelected { provenance: provenance } => Projected {
      policy: StoragePolicyDirectLayout,
      device: provenance_chosen_identity(provenance: provenance),
      provenance: provenance,
    }
    SelectionRefused { cause: cause } => ProjectionUnresolved { cause: cause }
  }
}

// ---------------------------------------------------------------------------
// 8. Rendering and the BINDING: so "the machine booted seed X" is answered with evidence.
// ---------------------------------------------------------------------------

// THE RENDERING IS A FUNCTION OF THE AXES AND NOTHING ELSE. Every wire spelling below is derived by the
// fn that owns it — the locale by seed_locale_wire, the package names by install_driver_package, the
// console stanza by console_stanza_for, the transport by delivery_strategy_diagnostic — so the digest is a
// digest of decisions, never of formatting or of a stored string that could disagree with the axis it
// claims to spell. Field order is fixed by this function rather than by a map iteration, because a digest
// that moves between two runs of the same seed is worthless as evidence.
//
// WHAT THE RENDERING DELIBERATELY OMITS, AND WHY THAT IS THE SECURITY PROPERTY: no password, no password
// handle, no SSH key material, no hostname, no unit key. A rendered seed is safe to publish as an artifact
// name, to print in a report, and to store beside a boot log precisely because the axes it renders are the
// ones that contain no secret and no identity. The credential's VERSION still reaches the digest through a
// locator-shaped atom — so a rotated secret changes the digest — without the secret itself ever being in
// scope of a hash input.
fn render_ubuntu_autoinstall_seed(seed: UbuntuAutoinstallSeed) -> NonEmptyStr {
  [
    "autoinstall/1",
    concat("arch=", architecture_token(architecture: seed.target.architecture)),
    concat("bmc=", bmc_firmware_family_diagnostic(family: seed.target.bmc_firmware)),
    concat("nic=", nic_driver_claim_diagnostic(flavour: seed.target.kernel_flavour)),
    concat("locale=", seed_locale_wire(locale: seed.locale)),
    concat("keyboard=", ceremonial_keyboard_layout_wire(layout: seed.keyboard)),
    concat("delivery=", delivery_strategy_diagnostic(strategy: seed.delivery)),
    concat("console=", console_stanza_diagnostic(stanza: seed.proof.console_stanza)),
    concat("addressing=", addressing_diagnostic(addressing: seed.network.addressing)),
    concat("family=", address_family_diagnostic(family: seed.network.family)),
    concat("mirror=", mirror_diagnostic(mirror: seed.network.mirror)),
    concat("disk=", configuration_identity_of_selector(selector: seed.disk)),
    concat("entry=", entrypoint_diagnostic(entry: seed.entry)),
    concat("password=", credential_diagnostic(posture: seed.credential)),
    concat("drivers=", install_driver_list_diagnostic(drivers: seed.install_drivers)),
    concat("modules=", loadable_module_list_diagnostic(modules: seed.loadable_modules)),
    concat("late=", late_driver_list_diagnostic(drivers: seed.late_drivers)),
    concat("packages=", package_list_diagnostic(intents: seed.install_packages)),
    concat("latepackages=", package_list_diagnostic(intents: seed.late_packages)),
    concat("closed=", int_diagnostic(count: seed.proof.questions_closed)),
  ].join("|") as NonEmptyStr
}

// THE ARCHITECTURE TOKEN IS THE FULL MATCH, NOT A DEFAULT: an architecture that has never been installed
// this way must render its own name so a digest reveals the substitution rather than silently borrowing the
// aarch64 spelling. A new architecture adds a row and the rendering changes, which is the behaviour a
// default would hide.
fn architecture_token(architecture: Architecture) -> NonEmptyStr {
  match architecture {
    Aarch64 => "aarch64"
    X86_64 => "x86_64"
    X86 => "x86"
    Arm => "arm"
    Armv7 => "armv7"
    Mips => "mips"
    Mipsel => "mipsel"
    Mips64 => "mips64"
    Mips64el => "mips64el"
    Riscv64 => "riscv64"
    Wasm32 => "wasm32"
  }
}


// THE DIGEST, TAGGED. The tag is not decoration: an untagged structural digest of a seed is byte-identical
// to a digest of some other record that happens to render the same, and the whole purpose of the digest is
// to be quotable as evidence years later. Adding a seed format (a non-autoinstall variant) means a new tag,
// and a new tag cannot silently collide with this one.
fn ubuntu_autoinstall_seed_digest(seed: UbuntuAutoinstallSeed) -> Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "gunbc.provisioning.ubuntu_autoinstall_seed/1",
    payload: content_hash_atom(value: render_ubuntu_autoinstall_seed(seed: seed)),
  )
}

// ---------------------------------------------------------------------------
// 8b. THE DOCUMENT. A seed is not a configuration until something can be written down and served;
// what is served is the payload, and what the binding records is a digest OF THAT DOCUMENT.
// ---------------------------------------------------------------------------

// WHY THE PAYLOAD IS BUILT FROM THE AXES AND NOT STORED BESIDE THEM. Every field below is derived by the fn
// that owns its spelling: the locale by seed_locale_wire, the keyboard by ceremonial_keyboard_layout_wire, the
// transport by payload_delivery_for, the key list by the seed's own admitted authorisation. So the document
// cannot disagree with the seed it came from, which is the only sense in which "the machine booted seed X" is
// a question with an answer. A future field the upstream payload grows (a proxy, a timezones section) is added
// HERE, in the one projection, and the witness below that compares documents has to see it change.
type SeedDocument
  = DocumentBuilt { payload: UbuntuAutoinstallPayload, content: NonEmptyStr }
  // REFUSAL IS A FIRST-CLASS OUTCOME, NOT AN ERROR. The YAML substrate refuses a value it cannot write with
  // its intended meaning rather than writing something merely similar; that refusal is a fact about THIS seed,
  // and the binding has to be able to say "this seed has no document, and here is why" instead of quietly
  // recording a digest of a rendering nobody was ever served.
  | DocumentRefused { reason: NonEmptyStr }

fn seed_document(seed: UbuntuAutoinstallSeed) -> SeedDocument {
  match autoinstall_payload(seed: seed) {
    Absent => DocumentRefused { reason: "seed-declares-nothing-to-write" as NonEmptyStr }
    Present { value: payload } =>
      match autoinstall_user_data(payload: payload) {
        AutoinstallUserDataRefused { reason: why } => DocumentRefused { reason: why as NonEmptyStr }
        AutoinstallUserDataRendered { content: body } =>
          DocumentBuilt { payload: payload, content: body as NonEmptyStr }
      }
  }
}

// THE PAYLOAD, OR THE REASON THERE IS NONE. Absent is reserved for the one honest case: a seed carrying no
// admin password receipt cannot fill upstream's hashed_password field, and inventing a string there would put
// a fabricated credential into a document that is about to be served to a board. (review: merry-fox-82) The
// earlier projection handed a placeholder digest to the payload and the witness then compared placeholders —
// both sides of an equality over something that was never read.
// THE PAYMENT OF A CREDENTIAL POSTURE IS PAID HERE, IN THE DOCUMENT, NOT IN A COMMENT. The seed carries which
// posture was chosen at admission; this fn turns that posture into the two sections Canonical reads —
// `identity` and the cloud-init `user-data` — and each posture gets its OWN path, never a shared literal with a
// conditional hash:
//
//   PasswordHandle   → `identity` present, with the admitted crypt digest as its hash. Byte-identical to the
//                      rendering this module produced before the key-only posture existed; the ARM digest
//                      control in the witness is the proof that this path moved nothing.
//   PasswordUnset    → `identity` ABSENT and a `user-data` users list instead. This is the posture the operator
//                      asked for — no password at all — and it is legal rather than merely tolerated because
//                      Canonical's own reference makes identity the only mandatory key "unless the user-data
//                      section is present, in which case it is optional" (cited on the identity field in
//                      extdeps.os.ubuntu_autoinstall). The user entry carries lock_passwd: true and the
//                      admitted keys and has NO field that could hold a password, so there is no hash, no lock
//                      marker, and no empty string anywhere in this document; with the ssh section's allow-pw:
//                      false, the only way in is a key.
fn autoinstall_payload(seed: UbuntuAutoinstallSeed) -> Optional<UbuntuAutoinstallPayload> {
  match seed.credential {
    PasswordHandle { handle: _ } =>
      match password_field_from(seed: seed) {
        Present { value: hashed } =>
          Present { value: UbuntuAutoinstallPayload {
            autoinstall_version: 1,
            delivery: payload_delivery_for(delivery: seed.delivery),
            fully_automated: true,
            target_distribution: NobleNumbat2404Lts,
            identity: Present { value: AutoinstallIdentity {
              hostname: "altra-installer" as NonEmptyStr,
              username: "gunbc-admin" as NonEmptyStr,
              realname: "gunbc provisioning" as NonEmptyStr,
              hashed_password: hashed,
            } },
            user_data: Absent,
            locale: seed_locale_wire(locale: seed.locale),
            keyboard_layout: ceremonial_keyboard_layout_wire(layout: seed.keyboard),
            ssh: openssh_server_section(intents: seed.install_packages, authorised_keys: seed.entry.authorised_keys),
            storage_policy: StoragePolicyDirectLayout,
          } }
        Absent => Absent
      }
    PasswordUnset =>
      Present { value: UbuntuAutoinstallPayload {
        autoinstall_version: 1,
        delivery: payload_delivery_for(delivery: seed.delivery),
        fully_automated: true,
        target_distribution: NobleNumbat2404Lts,
        identity: Absent,
        // THE NAME IS POSIX-LEGAL ON PURPOSE. gunbc.provisioning.public_nocloud_seed admits the user's name
        // through extdeps.posix.shell_command_language.admit_posix_shell_name (XBD 3.235), whose continue
        // alphabet is letters, digits and underscore — a hyphen is not in it. "gunbc-admin" would render a
        // document the seed admission refuses at the name leaf, so the key-only account is named the way the
        // rule allows. (The SEEDED-HANDLE identity above keeps "gunbc-admin": that document publishes no
        // user-data users section at all, so its username never meets the POSIX leaf, and its bytes are the
        // ones the ARM control witness pins byte-for-byte.)
        user_data: Present { value: [
          CloudInitUserEntry {
            name: "gunbcadmin" as NonEmptyStr,
            ssh_authorized_keys: seed.entry.authorised_keys,
            lock_passwd: true,
            shell: BashLoginShell,
          },
        ] },
        locale: seed_locale_wire(locale: seed.locale),
        keyboard_layout: ceremonial_keyboard_layout_wire(layout: seed.keyboard),
        ssh: openssh_server_section(intents: seed.install_packages, authorised_keys: seed.entry.authorised_keys),
        storage_policy: StoragePolicyDirectLayout,
      } }
  }
}

// THE PASSWORD FIELD COMES FROM A READ, OR THE DOCUMENT IS NOT BUILT. A hash the module minted itself is not a
// password; it is a placeholder, and a placeholder in a credential field is how a headless board ends up with
// an account nobody can name. So: only a receipt admitted against the seed's own handle, naming the same secret
// and version, fills this field. A handle whose read is missing, or whose read names a different secret, yields
// Absent — and Absent means no document, not a document with a hole in it.
//
// THE DECLINED CASE IS A LOCK MARKER, NOT AN EMPTY STRING, AND NOT A HASH. Upstream's payload demands a
// NonEmptyStr here, so declining a password still has to produce a string; the earlier draft passed "" and the
// compiler was right to refuse it (the refinement is exactly the claim "a credential field is never empty").
// The honest string is the lock marker: crypt(3) stores a locked account as a password field whose first
// character is '!' or '*', which can never be produced by a hash — and that is not folklore in this repo, it is
// a consequence of the shelf: '!' is a member of extdeps.libxcrypt's reserved set, so NO admitted digest can
// ever equal or begin with it. Two states therefore stay distinguishable in the rendered document: a seed that
// declined a password shows the lock marker and nothing else, and a seed that has one shows a digest this
// module admitted. Both are only survivable because the entry posture had to justify itself at admission —
// a locked password with no authorised key never became a seed (AdminEntryHasNoKey).
fn password_field_from(seed: UbuntuAutoinstallSeed) -> Optional<NonEmptyStr> {
  match seed.credential {
    // NO PASSWORD FIELD EXISTS UNDER THIS POSTURE — not even a lock marker. An earlier revision answered
    // "!"-marker here, which was the right answer while identity was the only place a credential could be
    // stated: with a mandatory identity section, "locked" had to be spelled AS a password value the crypt
    // scheme could never produce. Identity is now Optional (extdeps.os.ubuntu_autoinstall, Canonical citation
    // on its Optional field), so the key-only posture states no identity at all and the account lock moves to
    // where cloud-init keeps it — lock_passwd: true on the user-data user (gunbc.os_install_emit's
    // cloudinit_user_entries). Returning a marker here would put a password-shaped string back into a document
    // whose whole claim is that no password field was written, and the render witness refuses any document
    // containing one.
    PasswordUnset => Absent
    // THE READ TRAVELS INSIDE THE SEED, SO THERE IS NOTHING LEFT TO RE-PROVE HERE. An earlier revision
    // re-ran receipt_matches_handle on this path; the re-check was UNREACHABLE, because the only minter of a
    // seed refuses to build one whose read belongs to another handle, and a loosened copy of it could not be
    // detected by any test — which is DESIGN §5's definition of a check restating a constraint the model
    // already carries. The pairing therefore lives in exactly two places, each with a caller that can reach
    // it: at construction (receipt_pairs_credential), and in the identity projection, whose receipt arrives
    // from OUTSIDE the seed as a parameter and so is genuinely unaudited until checked. A future requirement
    // that lets a seed be assembled from parts adds a minter that pairs; it does not add a comparison here.
    PasswordHandle { handle: _ } =>
      match seed.password_read {
        Absent => Absent
        Present { value: issued } => Present { value: issued.crypt_digest }
      }
  }
}

// THE TRANSPORT, IN UPSTREAM'S OWN VOCABULARY. The seed's delivery axis is a decision about HOW the installer
// arrives; upstream's NoCloud pair is a decision about where the answer file is READ FROM. They are not the same
// axis, and this fn is where the two are related — deliberately one way, and deliberately lossy in the direction
// that matters: a PXE boot and a virtual-media boot both read NoCloud from the media, and no field of the seed
// selects a PXE server here. A future requirement to serve the document over HTTP (a seed_url) adds the arm and
// has to say which evidence names the URL; it may not name a machine.
fn payload_delivery_for(delivery: SeedDeliveryStrategy) -> AutoinstallDeliveryMethod {
  match delivery {
    PxeStrategy { boot_mode: _ } => NoCloudLocal
    VirtualMediaStrategy { media_stem: _ } => NoCloudLocal
  }
}

// THE PRESEED THE DELIVERY LAYER OWES, DERIVED FROM THE RECORDS AND FROM NOTHING ELSE. (review: merry-fox-82
// HOLD 1 / 83132) The audit above proves the ANSWER SET is complete; this fn produces the thing that has to
// arrive at the board for that proof to mean anything, as text in upstream's four-field form. Two claims live
// here, and only one of them is mine:
//
//   MINE: the file is a pure derivation from the records, in intent order, with no line invented and none
//   dropped. A row that carries records and contributes no line would let an unanswered question reach the
//   installer while the audit still reports SeedIsNonInteractive — the exact class of bug the tokenizer used to
//   make possible, now expressible only as a defect in this fn, where a witness can catch it.
//
// The return is String and not NonEmptyStr BECAUSE THE EMPTY FILE IS A LEGITIMATE ANSWER: a seed whose packages
// ask nothing has no preseed to ship, and forcing NonEmptyStr here would either refuse a correct seed or push a
// sentinel newline into a file the installer would then have to skip. Emptiness is carried to the delivery layer
// honestly and the row that measures it is a_seed_of_silent_packages_alone_yields_an_empty_preseed.
//
//   NOT MINE: WHETHER THE FILE IS SHIPPED. Upstream autoinstall carries preseed text under a debconf_selections
//   key, and the payload type this module hands to gunbc.os_install_emit (UbuntuAutoinstallPayload, owned by
//   extdeps.os.ubuntu_autoinstall) has NO such field today. I do not edit that module, so the seam stays open
//   and is named rather than papered over: a consumer must add the field and feed it exactly this string. Until
//   that happens, a seed whose answers change renders an IDENTICAL document — which the binding exposes
//   honestly rather than hiding: seed_digest (derived from the semantic axes, so it moves with the answers) and
//   document_digest (the served bytes, which do not) then differ in behaviour, and any claim that "the machine
//   booted these answers" must cite the seed_digest, not the document. A future edit that adds the field has to
//   delete the sentence you are reading; a future edit that does NOT add it must not claim unattended
//   non-interactivity for a package that answers only through debconf.
fn seed_preseed_file(intents: List<PackageIntent>) -> String {
  debconf_selection_file(records: preseed_records(intents: intents))
}

// STRUCTURAL RECURSION OVER THE INTENTS, WITH ALL FOUR ARMS NAMED. The two arms that carry answers (a known
// asker that was answered, and an unclassified row that carries records anyway) contribute their records. The two
// that do not — a row proven SILENT, and a known asker deliberately left unanswered — contribute NOTHING, and
// there is no branch that could invent a line from a package name. That asymmetry is the property this fn owes:
// a silent package has no question, so a line rendered for it would be an answer to a question that does not
// exist, which debconf would store happily and the installer would never ask. The unanswered arm contributes
// nothing for the opposite reason and is safe only because the audit refuses a seed containing it — the file is
// rendered from intents the audit has ALREADY refused to certify, which is why this fn is total and why no line
// here says "unanswered": a refusal has no preseed to speak of.
fn preseed_records(intents: List<PackageIntent>) -> List<DebconfSelectionRecord> {
  match intents {
    Empty => []
    Cons { head: intent, tail: rest } =>
      match intent {
        PackageVerifiedSilent { silence: _ } => preseed_records(intents: rest)
        QuestionUnanswered { package: _ } => preseed_records(intents: rest)
        QuestionAnswered { package: _, answers: answers } =>
          records_before(answers: answers, later: preseed_records(intents: rest))
        UnclassifiedPackage { name: _, answers: answers } =>
          records_before(answers: answers, later: preseed_records(intents: rest))
      }
  }
}

// AN INTENT'S OWN RECORDS FIRST, THEN EVERYTHING AFTER IT. Consed one record at a time rather than concatenated
// as lists, so the ORDER of answers inside one package survives — the order upstream's reader applies them in,
// which matters when a package's later question depends on an earlier one (tzdata's zone after its area). A list
// concatenation would give the same result here and cost an import this module does not otherwise need; the
// construction says what is actually true, that records are added one at a time in the order they were written.
fn records_before(answers: List<DebconfSelectionRecord>, later: List<DebconfSelectionRecord>) -> List<DebconfSelectionRecord> {
  match answers {
    Empty => later
    Cons { head: record, tail: rest } => Cons { head: record, tail: records_before(answers: rest, later: later) }
  }
}

// THE FIRST INTENT NAMING A PACKAGE, whichever arm it is in. The arms classify WHY a package is installable;
// they do not classify its name, so a lookup has to see through all four. Kept as its own fn rather than
// inlined into the caller because the audit below and the payload projection above must ask the same question of
// the same list — two spellings of "is this package in the seed" is two answers.
fn first_intent_named(intents: List<PackageIntent>, wanted: NonEmptyStr) -> Optional<PackageIntent> {
  match intents {
    Empty => Absent
    Cons { head: intent, tail: rest } =>
      match package_intent_names(intent: intent, wanted: wanted) {
        True => Present { value: intent }
        False => first_intent_named(intents: rest, wanted: wanted)
      }
  }
}

// THE NAME OF ANY ARM. Each arm carries its package name in exactly one place — inside the silence receipt for
// a silent row, which is where it moved when the mismatched-pair defect was closed — so reading it never
// duplicates a name, it reads the one that exists.
fn package_intent_names(intent: PackageIntent, wanted: NonEmptyStr) -> Bool {
  match intent {
    QuestionAnswered { package: named, answers: _ } =>
      wanted == known_prompting_package_name(package: named)
    QuestionUnanswered { package: named } => wanted == known_prompting_package_name(package: named)
    UnclassifiedPackage { name: un, answers: _ } => wanted == un
    PackageVerifiedSilent { silence: receipt } => wanted == silenced_package(receipt: receipt)
  }
}

// WHETHER THE SEED ASKS FOR sshd AT ALL, read from the seed's own package intents rather than from a bool// WHETHER THE SEED ASKS FOR sshd AT ALL, read from the seed's own package intents rather than from a bool
// beside them. Two fields that must agree is two fields that can disagree, and this one would disagree in the
// worst direction: a payload claiming an SSH server the seed never installs leaves the board unreachable by
// the only channel a headless box has.
fn openssh_server_section(intents: List<PackageIntent>, authorised_keys: List<SshPublicKey>) -> Optional<AutoinstallSshServer> {
  match first_intent_named(intents: intents, wanted: "openssh-server" as NonEmptyStr) {
    Absent => Absent
    Present { value: _ } => Present { value: AutoinstallSshServer { authorized_keys: authorised_keys, password_auth: false } }
  }
}

// THE DOCUMENT'S DIGEST — AND IT IS A DIGEST OF THE RENDERED DOCUMENT, NOT OF THE SEED'S FIELDS. (review:
// merry-fox-82, HOLD section 1) The binding used to record a digest of this module's own diagnostic rendering
// and then answer "did the machine boot seed X?" from a comparison of two local values, neither of which had
// ever been handed to a machine. A digest of a rendering nobody served can be computed, matched, and be
// completely unrelated to what was on the wire. So the binding takes the SHA-256 of the bytes the renderer
// produced; the rendering above stays, as a human-readable configuration identity, and is no longer what
// proves a boot.
// THE SHA-256 OF THE SERVED USER-DATA BYTES, OR NOTHING. There is deliberately no fall-back digest: when the host
// does not hand back a hex string the caller is told so with `Absent` rather than being handed a same-typed
// content-hash stand-in. A stand-in would flow into the binding's `document_digest`, its served-bundle digest and
// its address indistinguishably from a real SHA-256, and the binding's whole point — "the board was handed bytes
// whose SHA-256 is this" — would be a fabrication. Unobserved is therefore an absence, not a value. (review:
// merry-fox-82; review 83764 finding 1. A future requirement to digest by another algorithm adds a second
// `Present`-producing constructor here, never a fourth same-typed stand-in.)
fn rendered_document_digest(content: NonEmptyStr) -> Optional<Fnv1a64Structural> {
  let hex = sha256_hex_of_text(text: content)
  match hex == "" {
    True => Absent
    False =>
      Present {
        value: content_hash_tagged_structural(
          tag: "gunbc.provisioning.ubuntu_autoinstall_seed.document/sha256",
          payload: content_hash_atom(value: hex as NonEmptyStr),
        ),
      }
  }
}

// THE SERVED BUNDLE — WHAT THE BOARD ACTUALLY RECEIVES, AS ONE DIGESTED THING. (review: merry-fox-82, HOLD
// section 1, taken as option (ii): "Model a rendered document bundle containing both user-data and the preseed
// artifact, with the binding digest covering the complete served bundle".)
//
// THE DEFECT THIS CLOSES. The audit certifies a seed noninteractive by answering its debconf questions, and
// seed_preseed_file derives exactly the lines that make those answers true on the installer — but nothing
// carried those lines into the bytes the board is handed. The consequence merry named: a semantic seed digest
// could move (an answer changed) while the served-document digest stayed fixed, because the document never
// contained the answer. That is a pairing failure, and this module must not be able to express it. The bundle
// makes the pairing structural rather than aspirational: user_data and preseed travel together, and the digest
// is computed over BOTH by the only mint, so no caller can bind a seed to a served bundle whose preseed half
// was dropped, substituted, or never derived.
//
// sole_constructor, and the mint is admit_callers-sealed to the binder: a bundle whose halves were authored
// separately is exactly what this record cannot be allowed to be. A future requirement (a third served part,
// say network-config for a board whose NIC needs an early firmware blob) adds a field AND a digest term in the
// same mint — a field that does not move the digest cannot be added, because the fold below lists the parts it
// covers and the compiler catches a field it does not mention (the digest is derived here, never stored beside
// the parts it digests).
type ServedSeedBundle sole_constructor {
  user_data: NonEmptyStr,
  preseed: ServedPreseed,
  // THE SHA-256 OF THE USER-DATA HALF, carried out so the binder's `document_digest` is literally the value the
  // bundle digest folded, not a second hashing of the same bytes that could drift from it (review 83764, finding 1
  // removed the fabricated fallback that let a non-SHA-256 value masquerade here).
  document_digest: Fnv1a64Structural,
  bundle_digest: Fnv1a64Structural,
}

// THE PRESEED HALF, WITH ITS EMPTY CASE NAMED. (review: merry-fox-82, HOLD section 1) A seed whose packages ask
// no questions has no preseed lines, and that is not an absent part of the bundle — the installer is still
// handed a preseed file, it just contains nothing. Two arms rather than a String plus an emptiness test,
// because the two situations must not share a digest term with a real answer file: "the answer set is empty"
// and "the answer set is these lines" are different claims about what the board was served, and a digest that
// conflated them would let an answer file be dropped and still match. FUTURE REQUIREMENT: a new kind of served
// text (network-config, say) is a new field plus a new digest tag in the mint below, not a new arm here — this
// union answers "is there any debconf content?" and nothing else.
type ServedPreseed
  = NoDebconfQuestionsToAnswer
  | DebconfAnswersCarried { lines: NonEmptyStr }

// THE COMPLETE SERVED BUNDLE IS IN THE ADDRESS (review: merry-fox-82, HOLD section 5: "binding_digest omits the
// served-document digest. Add it, with a discriminator"). Previously the address covered the configuration, the
// unit, the attempt and the disk — nothing derived from the bytes the board is handed — so a renderer revision or
// a dropped answer file left the address untouched, and "the machine booted seed X" was answerable from memory
// instead of evidence. This is the address's single served-bytes term, and it folds BOTH halves, each
// individually named:
//
//   - the "document" term IS binding.document_digest — the same derivation (rendered_document_digest), not a
//     second spelling beside it. Two authorities over one claim is what collisions eat, so the field and the
//     address share this fn rather than each hashing the content their own way, and merry's item 5 is satisfied
//     literally: the served-document digest is now a term of the binding address.
//   - the "preseed" term is the half a document-only fold would still have omitted: the debconf answer file is
//     part of what is served, and its two cases are distinguished BY TAG, so an answer file being dropped
//     changes the digest instead of colliding with the empty case.
//
// EACH SUB-TERM HAS ITS OWN DISCRIMINATING WITNESS, which is what makes a fold term evidence instead of
// decoration: deleting the document term goes RED on the vault-read discriminator (two bindings the public
// builder produces from identical configuration and rendering whose reads carry different digests —
// credential_diagnostic covers the handle's locator and version only, so the read is the one axis that moves the
// document but not the configuration), and deleting the preseed term goes RED on the answer-pairing witness (two
// seeds differing only in an answer VALUE). A fold term no test can lose is a comment with arithmetic in it.
fn served_bundle_digest(document: Fnv1a64Structural, preseed: ServedPreseed) -> Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "gunbc.provisioning.ubuntu_autoinstall_seed.bundle/1",
    payload: content_hash_combine_structural(
      left: content_hash_tagged_structural(tag: "document", payload: document),
      right: match preseed {
        NoDebconfQuestionsToAnswer =>
          content_hash_tagged_structural(
            tag: "preseed/none",
            payload: content_hash_atom(value: "no-questions-to-answer" as NonEmptyStr),
          )
        DebconfAnswersCarried { lines: lines } =>
          content_hash_tagged_structural(
            tag: "preseed/answered",
            payload: content_hash_atom(value: lines),
          )
      },
    ),
  )
}

// THE ONLY ROUTE TO A BUNDLE: DERIVED FROM THE SEED ITSELF, NEVER SUPPLIED. Both halves are computed here from
// the same seed record the binder is binding — user_data through the REAL upstream renderer (seed_document →
// autoinstall_payload → gunbc.os_install_emit::autoinstall_user_data), preseed through the derived debconf file
// over the install AND late intents (both lists can carry answered questions; covering only the install list
// would leave a late-package answer outside the served bytes, which is the same defect one list later).
// admit_callers: the binder is the only caller. A test that wants a bundle asks the binder for one — that IS
// the point: an independently authored bundle is the forgery this seal exists to refuse, and the compiler
// refuses it (ConstructorCallAdmissionRefused), which is the evidence the seal holds.
// THE PRESEED HALF OF THE SERVED BUNDLE, RENDERED OR REFUSED. The debconf answer file is rendered from the seed's
// intents; a seed that asks nothing carries NoDebconfQuestionsToAnswer and a seed that asks carries the exact text
// that will be served. The emptiness is decided FIRST by the `== ""` guard, and only on the non-empty arm is the
// rendered text cast to its non-empty type in argument position — the same total-cast-under-a-guard shape
// rendered_document_digest uses for the sha hex. On the non-empty arm the cast cannot fail; if a renderer ever
// learned to produce text that will not cast, the compiler refuses to resolve the fn rather than silently serving
// a wrong-typed answer file, which is the honest outcome (an empty file is NoDebconfQuestionsToAnswer, never a
// one-line file with an empty value).
fn render_served_preseed(seed: UbuntuAutoinstallSeed) -> ServedPreseed {
  let intents = all_package_intents(seed: seed)
  match seed_preseed_file(intents: intents) == "" {
    True => NoDebconfQuestionsToAnswer
    False => DebconfAnswersCarried { lines: seed_preseed_file(intents: intents) as NonEmptyStr }
  }
}

fn serve_seed_bundle(seed: UbuntuAutoinstallSeed) -> Optional<ServedSeedBundle> admit_callers: [
  decl_ref(module_path: "gunbc.provisioning.ubuntu_autoinstall_seed", decl_name: "bind_ubuntu_autoinstall_seed")
] {
  match seed_document(seed: seed) {
    DocumentRefused { reason: _ } => Absent
    DocumentBuilt { payload: _, content: content } =>
      match rendered_document_digest(content: content) {
        // NO SHA-256, NO BUNDLE. The bundle's whole job is to be the digested thing the board was handed; without
        // a real SHA-256 of the user-data half the digest would be a stand-in, so nothing is served and the binder
        // refuses the seed rather than certifying a boot whose bytes cannot later be identified. (review 83764 #1.)
        Absent => Absent
        Present { value: document } =>
          match render_served_preseed(seed: seed) {
            preseed =>
              Present {
                value: ServedSeedBundle {
                  user_data: content,
                  preseed: preseed,
                  document_digest: document,
                  bundle_digest: served_bundle_digest(document: document, preseed: preseed),
                },
              }
          }
      }
  }
}

// THE INTENTS THE PRESEED IS DERIVED FROM: install first, then late, in the order the installer applies them.
// Its own fn because the mint needs it twice (the emptiness test and the digest both read it) and an expression
// repeated is an expression that can drift. Structurally recursive rather than a list concatenation, matching
// preseed_records' own construction — records arrive one at a time, in the order they were authored.
fn all_package_intents(seed: UbuntuAutoinstallSeed) -> List<PackageIntent> {
  intents_after(left: seed.install_packages, right: seed.late_packages)
}

fn intents_after(left: List<PackageIntent>, right: List<PackageIntent>) -> List<PackageIntent> {
  match left {
    Empty => right
    Cons { head: intent, tail: rest } =>
      Cons { head: intent, tail: intents_after(left: rest, right: right) }
  }
}

// EVERY DERIVED SPELLING BELOW EXISTS SO THAT THE RENDERING NEVER READS A STORED STRING. Each is the only
// place its wire token appears, and a missing row would be a compile error rather than a silent fallback —
// which is why closed unions are the right carrier for these axes.
fn bmc_firmware_family_diagnostic(family: BmcFirmwareFamily) -> NonEmptyStr {
  match family {
    OpenBmc => "openbmc"
    AmiMegaRac => "amr-megrac"
  }
}

// THE NIC CLAIM IS RENDERED THROUGH THE UPSTREAM TABLE RATHER THAN A STRING WE OWN: whether the running
// kernel flavour's r8169 driver claims the board's NIC is a fact about Canonical's kernel, so it is asked
// of extdeps.os.ubuntu_kernel_nic_coverage and the ANSWER is what enters the digest. A seed that rendered a
// driver name we had chosen ourselves would be a seed whose digest survives an upstream kernel change it
// should not survive.
fn nic_driver_claim_diagnostic(flavour: UbuntuKernelFlavour) -> NonEmptyStr {
  match r8169_claims_pci_device(flavour: flavour, device: rtl8125_device_id()) {
    True => "r8169-claims-rtl8125"
    False => "r8169-does-not-claim-rtl8125"
  }
}

fn rtl8125_device_id() -> PciDeviceId {
  "8125" as PciDeviceId
}

fn console_stanza_diagnostic(stanza: NonInteractiveConsoleStanza) -> NonEmptyStr {
  match stanza {
    ConsoleSuppressed => "suppressed"
    ConsoleAnsweredByUnattended => "unattended-answer"
  }
}

// THE SEEDED SOURCE IS COBERED, NOT JUST ITS EXISTENCE. "seeded-netplan" alone says the operator supplied
// addressing and nothing about WHAT it supplied, so two seeds with different Netplan — wrong VLAN, wrong static,
// netplan that never brings the BMC-reachable interface up — render and digest identically and the receipt cannot
// answer the question it exists to answer, "which configuration did this machine boot". The source's content is
// hashed rather than pasted: it can carry addresses and credentials that have no business in a report line.
fn addressing_diagnostic(addressing: SeedAddressing) -> NonEmptyStr {
  match addressing {
    SeededNetplan { source: s } =>
      concat("seeded-netplan,", content_coverage(label: "netplan", content: s as String)) as NonEmptyStr
    InstallerManaged => "installer-managed"
  }
}

fn address_family_diagnostic(family: SeedAddressFamily) -> NonEmptyStr {
  match family {
    DualStack => "dual"
    Ipv4Only => "v4"
  }
}

// ONE SPELLING, THE TWO ARMS TAGGED APART (review 83255). The first version rendered a named mirror as the bare
// host and an absent one as the bare word "absent" — a collision with the worst possible shape: a mirror
// literally named `absent` fed the digest EXACTLY like no mirror at all, so a receipt could not tell "this seed
// has no archive" (a refusal) from "this seed points at a host called absent" (a misconfiguration that installs
// anyway). Those two facts are one bit apart and the digest said they were the same bytes. The named arm now
// carries its OWN LENGTH FRAME (`host[<n>]:<h>`), which every present mirror must carry, and the absent arm is
// the bare token `absent`, which the framed form can never produce because no host can drop the `host[<n>]:`
// prefix. THE TAG IS WHAT SEPARATES THE ARMS; THE FRAME MAKES THE FIELD SELF-DELIMITING. Today the render is a
// fixed-order list of non-empty segments joined by '|', so a host containing that delimiter cannot yet make two
// distinct seeds collide — it can only append junk inside its own segment. The frame is what keeps it that way
// when the preimage changes shape: reorder a segment, make one optional, and an unframed host containing '|'
// starts masquerading as the next segment's label. Framing now is cheaper than reasoning about it later, and it
// is the same framing every other host- or serial-shaped field in this preimage already uses. THIS STRING IS THE
// DIGEST PREIMAGE — render_ubuntu_autoinstall_seed is its only consumer — so the tagging is not a reporting
// choice but the thing that makes the receipt's answer trustworthy; a second untagged spelling kept beside it
// would be the collision again with a greener name. A future arm of ArchiveMirrorAuthority adds a case HERE with
// its own tag (unhandled, no default), so a new kind of mirror cannot digest into an existing arm's bytes.
fn mirror_diagnostic(mirror: ArchiveMirror) -> NonEmptyStr {
  match mirror {
    Present { value: NamedMirrorAuthority { host: h } } => framed_field(label: "host", value: h)
    Absent => "absent"
  }
}

// THE SELECTOR'S CONFIGURATION IDENTITY, WITH ITS FIELDS FRAMED SO THEY CANNOT BLEED INTO ONE ANOTHER. The
// earlier spelling here was selector_diagnostic, which concatenated the part number and the capacity with no
// delimiter — and because of that, "WDS200T2X0E2000" at 398934016 bytes and "WDS200T2X0E" at 2000398934016 bytes
// rendered identically, so two seeds that selected different drives digested the same while the receipt claimed
// to frame the rule. Each field now carries its own label AND the length of the string it holds: the length is
// what makes the framing immune rather than the punctuation, because a part number containing the delimiter can
// no longer shift where a boundary falls.
//
// THE LOSSY SPELLING IS GONE, NOT KEPT ALONGSIDE THIS ONE. selector_diagnostic had exactly one caller — the
// digest line above — so leaving a human-facing version beside a safe one would be dead code plus a comment
// claiming a consumer that does not exist. A display string is added when something actually displays it, and it
// is built from these pieces, never by re-gluing fields. FUTURE REQUIREMENT: a new TargetDiskSelector arm adds a
// branch here AND one in selectors_are_the_same; both are exhaustive matches with no catch-all, so the compiler
// catches the first and a reviewer must catch the second.
fn configuration_identity_of_selector(selector: TargetDiskSelector) -> NonEmptyStr {
  match selector {
    ByObservedSerial { serial: s } =>
      framed_field(label: "serial", value: s) as NonEmptyStr
    ByCatalogIdentity { part_number: p, capacity_bytes: c } =>
      concat(
        framed_field(label: "catalog", value: p),
        concat("|", framed_field(label: "capacity", value: to_string(byte_size_count(b: c)) as NonEmptyStr)),
      ) as NonEmptyStr
  }
}

// ONE FRAMED FIELD: "label[<character-count>]:<value>". The count is taken from the value itself, so it cannot
// disagree with it, and it is what stops a value containing ':' or '|' from moving the boundary.
fn framed_field(label: NonEmptyStr, value: NonEmptyStr) -> NonEmptyStr {
  concat(
    concat(concat(label, "["), to_string(value.length()) as NonEmptyStr),
    concat("]:", value),
  ) as NonEmptyStr
}

fn capacity_diagnostic(capacity: ByteSize) -> NonEmptyStr {
  to_string(byte_size_count(b: capacity)) as NonEmptyStr
}

fn int_diagnostic(count: Int) -> NonEmptyStr {
  to_string(count) as NonEmptyStr
}

// THE CONSOLE TOKEN IS DERIVED FROM THE CONSUMER'S OWN SUM TYPE, not from a Bool beside it. The key count is
// rendered in every case — including 0 — because "keys=0,console=unlocked" and "keys=1,console=unlocked" are
// different postures and a digest that flattened them would hide a dropped authorized key.
// TWO ROWS, BECAUSE THE TYPE CAN ONLY INHABIT TWO STATES. A first version carried a third row
// ("keys=0,console=locked") that no seed could ever render: admit_admin_access_authorisation refuses that
// combination outright, so the row was a phantom in the token table — a spelling for a state the constructor
// makes unnameable, which is the kind of decoration a reader later mistakes for reachability. The key count is
// rendered in BOTH rows, so dropping an authorized key still moves the digest, and the console story is stated
// by matching the consumer's own sum type rather than by a Bool beside it.
// MATERIAL CONTENT ENTERS THE DIGEST AS A HASH, NOT AS PLAINTEXT. Three of this seed's inputs are content that
// the render must cover without reproducing: the authorized key material (so an equal-count swap of keys moves
// the digest — the bug was that a COUNT was rendered, which two swapped keys leave unchanged), the Netplan
// source (which decides the installed system's addressing, and a tag alone lets one source be swapped for
// another), and each seeded debconf answer (which is the answer to the question this cut exists to close, so a
// swapped value that still "answers" the question must not digest identically).
//
// WHY A HASH AND NOT THE STRING. This render is a diagnostic and an identity, not a config file (see the note on
// render_ubuntu_autoinstall_seed): it is printed in reports and compared in receipts, and key material and seeded
// values have no business being copied into a log line. A digest is the honest middle: it makes the identity
// depend on the bytes while publishing nothing, and it is the same primitive the seed digest itself is built
// from, so there is no second hashing story to keep consistent. A future requirement to SHOW a value must add a
// separate rendering function with its own consumers, not weaken this one.
// ANSWER COVERAGE, OVER RECORDS. Folded through the SAME content-hash combine the authorised-key coverage uses,
// so the diagnostic moves when the OWNER, the LABEL, the KIND or the VALUE of any record moves, and moves when
// their ORDER moves. A count would survive all four substitutions, and the substitution it exists to make visible
// is exactly the one a count hides: a seed whose answers have been swapped for another package's, or reordered so
// a parametric key no longer joins to its area. It deliberately does not print values — a seeded answer can name
// infrastructure, and this string is printed in reports.
fn answers_coverage(answers: List<DebconfSelectionRecord>) -> NonEmptyStr {
  let folded = fold(
    answers,
    init: content_hash_atom(value: "gunbc.altra.debconf_answers/1"),
    f: (acc, record) =>
      content_hash_combine_structural(left: acc, right: record_coverage(record: record)),
  )
  concat(concat("answers=", folded.digest as String), concat(",answered=", int_diagnostic(count: answers.length()))) as NonEmptyStr
}

// ONE RECORD'S CONTRIBUTION, as a GROUPED tuple rather than four separately folded fields. Grouping matters:
// folding every owner of every record and then every label would let two seeds with the same answers re-assigned
// to different packages collide, because the multiset of owners and the multiset of labels would both be
// unchanged. The four fields are combined inside one record's digest, and only then into the list's.
//
// EACH FIELD IS FRAMED BY ITS OWN LENGTH so the tuple is invertible before it is hashed: an unframed
// concatenation reads "openssh" + "server/…" the same as "openssh-server" + "/…", and two different record sets
// would then certify the same seed.
fn record_coverage(record: DebconfSelectionRecord) -> Fnv1a64Structural {
  let owner = content_hash_atom(
    value: framed_field(label: "owner", value: debconf_selection_owner(record: record)),
  )
  let label = content_hash_combine_structural(
    left: owner,
    right: content_hash_atom(value: framed_field(label: "label", value: debconf_selection_label(record: record))),
  )
  let kind = content_hash_combine_structural(
    left: label,
    right: content_hash_atom(
      value: framed_field(
        label: "kind",
        value: debconf_selection_kind_spelling(kind: debconf_selection_kind(record: record)),
      ),
    ),
  )
  content_hash_combine_structural(
    left: kind,
    right: content_hash_atom(value: framed_field(label: "value", value: debconf_selection_value(record: record))),
  )
}

fn content_coverage(label: NonEmptyStr, content: String) -> NonEmptyStr {
  concat(concat(label, "="), content_hash_atom(value: content as NonEmptyStr).digest as String) as NonEmptyStr
}

// THE KEY LIST IS FOLDED, NOT COUNTED. Folding with the same combine the digest uses makes the coverage depend on
// the ORDER and the IDENTITY of every key: two keys in the other order, a duplicated key where two distinct ones
// were, or one key replaced by another of the same length all move it. A count would survive all three, and that
// is precisely the substitution this row exists to make visible.
fn authorised_key_coverage(keys: List<SshPublicKey>) -> NonEmptyStr {
  let folded = fold(
    keys,
    init: content_hash_atom(value: "gunbc.altra.authorised_keys/1"),
    f: (acc, key) =>
      content_hash_combine_structural(
        left: acc,
        right: content_hash_atom(value: ssh_public_key_line(k: key) as NonEmptyStr),
      ),
  )
  concat(concat("keys=", folded.digest as String), concat(",count=", int_diagnostic(count: keys.length()))) as NonEmptyStr
}

fn entrypoint_diagnostic(entry: AdminAccessAuthorisation) -> NonEmptyStr {
  match entry.console_entry {
    // THE UNLOCK REASON IS RENDERED, NOT DISCARDED. "Unlocked" alone cannot be acted on: a serial getty open
    // at the panel and a BMC SOL console open over the network are different exposures with different fixes,
    // and on this fleet only one of them is reachable at all. Deriving the spelling from the closed reason
    // (rather than storing a string beside it) means a new unlock kind must be stated in the type before it
    // can appear in a seed, and it moves the digest.
    ConsoleEntryUnlocked { reason: SerialConsoleGettyUnlocked } =>
      concat("console=unlocked-serial-getty,", authorised_key_coverage(keys: entry.authorised_keys)) as NonEmptyStr
    ConsoleEntryUnlocked { reason: BmcSolConsoleUnlocked } =>
      concat("console=unlocked-bmc-sol,", authorised_key_coverage(keys: entry.authorised_keys)) as NonEmptyStr
    ConsoleEntryLocked =>
      concat("console=locked,", authorised_key_coverage(keys: entry.authorised_keys)) as NonEmptyStr
  }
}

// A ROTATED CREDENTIAL MOVES THE DIGEST, THE SECRET NEVER DOES. This renders the handle's locator and
// version (both non-secret identifiers) and, for PasswordUnset, its own token — so a seed that dropped a
// password is distinguishable from one that rotated it, which is exactly the pair of states a boot log has
// to be able to tell apart.
fn credential_diagnostic(posture: AdminCredentialPosture) -> NonEmptyStr {
  match posture {
    PasswordUnset => "unset"
    // FRAMED, NOT GLUED. The first version emitted `locator=<l>|version=<v>`, and two DIFFERENT handles
    // produced identical text: (locator "vault://L|version=v1", version "v2") and (locator "vault://L", version
    // "v1|version=v2") — the delimiter was inside the free-form locator, so the boundary moved. Those two
    // handles are otherwise-equal seeds digesting alike, which is the same failure the disk selector had and it
    // was found here by the same kind of example. Each part now carries its own label and its own character
    // count, so a value containing '=' or '|' cannot move a boundary. `admin_password_handle` accepted both
    // handles before this, so nothing upstream would have caught it. (review: merry-fox-82)
    PasswordHandle { handle: h } =>
      concat(
        framed_field(label: "locator", value: h.secret_locator),
        concat("|", framed_field(label: "version", value: h.secret_version)),
      ) as NonEmptyStr
  }
}

// THE PACKAGE LIST IS RENDERED SORTED-BY-NAME, WHICH IS WHY THE SEED'S DIGEST IS ORDER-INDEPENDENT. Two
// callers who list the same packages in different orders must produce the same seed — otherwise the digest
// stops meaning "the same configuration" and starts meaning "the same configuration, typed the same way",
// and the second is worthless as evidence.
fn install_driver_list_diagnostic(drivers: List<SeedInstallDriver>) -> NonEmptyStr {
  render_sorted_names(
    names: drivers
      .map(driver => concat("pkg:", install_driver_package(driver: driver)) as String),
  )
}

// THE LOADABLE-MODULE LIST, RENDERED BY ITS OWN TOKEN so the digest distinguishes "load this module" from
// "install this package" even where the two share a spelling — a firmware package and a driver module can both
// plausibly be called r8169, and the two decisions fail differently (apt fails loudly at minute twelve; a
// missing module fails as "no disks found" and gets blamed on the backplane). The Kconfig symbol rides in the
// token: two rows claiming one object stem from different symbols is a real modeling error, and a digest that
// equated them would hide it.
fn loadable_module_list_diagnostic(modules: List<LoadableModuleClass>) -> NonEmptyStr {
  render_sorted_names(
    names: modules
      .map(loaded =>
        concat(
          concat(
            concat("mod:", loadable_module_name(driver: loaded)),
            concat("=", loadable_module_kconfig_symbol(driver: loaded)),
          ),
          concat("@", loadable_module_kconfig_path(driver: loaded)),
        ) as String),
  )
}

fn late_driver_list_diagnostic(drivers: List<LateDriver>) -> NonEmptyStr {
  render_sorted_names(
    names: drivers
      .map(driver =>
        concat(
          concat("mod:", late_driver_module(driver: driver)),
          concat("=", late_driver_kconfig_symbol(driver: driver)),
        ) as String),
  )
}

// A SEEDED PROMPTER IS RENDERED AS ITS NAME WITH A MARK; AN UNSEEDED ONE CANNOT APPEAR AT ALL, because the
// audit would have refused the seed. The mark is in the digest so that a seed which seeded a prompter is
// never confused with one that omitted it — those two are different decisions with different consequences,
// and a digest that equated them would hide the exact bug this module exists to catch.
fn package_list_diagnostic(intents: List<PackageIntent>) -> NonEmptyStr {
  render_sorted_names(
    names: intents.map(intent => package_intent_diagnostic(intent: intent)).map(name => name as String),
  )
}

// ONE TOKEN PER CLOSED ARM, DERIVED FROM THE VERDICT RATHER THAN FROM A PRESENCE PREDICATE. An answered
// question, an unanswered one and an unclassified one are three different things to a reader comparing two
// seed digests, and the old code could not tell the last two apart because both had no seed to print.
// THE SEEDED VALUE IS COBERED, NOT JUST THE FACT THAT SOMETHING WAS SEEDED. The verdict arms carry the question
// text for the report, and rendering from them alone meant an answer could be REPLACED — "postfix/main_mailer_type"
// switched from "No configuration" to "Internet Site", tzdata's zone switched from the operator's city to any other
// — and the seed digest stayed identical, because every part of the render saw was the name plus "+answered". An
// answer that is wrong is still an answer to the audit, so the audit cannot catch it; only the digest can, and only
// if the value is in it. Matched on the intent rather than on the verdict for that reason: the verdict is the
// report's shape, and it correctly has no use for the value.
//
// WHY HASHED. A seeded debconf answer can be a hostname, a relay, or an administrator address, and this rendering
// is a diagnostic that travels into reports and receipts, not a config file the installer consumes. Hashing keeps
// the identity bound to the bytes while publishing none of them. An unclassified package that carries an answer is
// rendered as a value too, because the audit refuses it either way and the refusal should still be attributable to
// the exact thing that was tried.
fn package_intent_diagnostic(intent: PackageIntent) -> NonEmptyStr {
  match intent {
    QuestionAnswered { package: named, answers: answer } =>
      concat(
        concat(known_prompting_package_name(package: named), "+answered,"),
        answers_coverage(answers: answer),
      ) as NonEmptyStr
    QuestionUnanswered { package: named } =>
      concat(known_prompting_package_name(package: named), "+UNANSWERED") as NonEmptyStr
    UnclassifiedPackage { name: un, answers: answer } =>
      match answer {
        Empty => concat(un, "+unclassified") as NonEmptyStr
        Cons { head: _, tail: _ } =>
          concat(concat(un, "+unclassified,"), answers_coverage(answers: answer)) as NonEmptyStr
      }
    // THE SILENCE TRAVELS INTO THE DIGEST AS ITS OWN EVIDENCE: name, the version the silence was established at,
    // and how it was established. A seed that carried a silent row at one version and another at a second
    // version are two different installs — the second may prompt where the first could not — so they must not
    // hash alike, and a transcribed claim must not hash the same as a measured one.
    PackageVerifiedSilent { silence: receipt } =>
      concat(
        concat(concat(silenced_package(receipt: receipt), "+silent,"), silence_receipt_diagnostic(receipt: receipt)),
        ",answered=0",
      ) as NonEmptyStr
  }
}

// THE RECEIPT'S OWN DIAGNOSTIC, SHARED BY THE RENDER AND THE BINDING. Version and standing both appear: a
// silent-at-4.4.36 row and a silent-according-to-somebody row are different risks, and a binding digest that
// could not tell them apart could not later answer "what did this board actually get".
fn silence_receipt_diagnostic(receipt: PackageSilenceReceipt) -> NonEmptyStr {
  match receipt {
    SilentReceipt { package: _, architecture: _, observed_version: version, standing: how } =>
      concat(
        concat("silent@", version),
        match cited_figure_read_obligation(standing: how) {
          // Nothing owed: the claim points at an artifact anyone can re-open. The arm does NOT record which
          // artifact, because the artifact is in the standing and a second copy of it here could drift from it.
          Absent => ",cited"
          // Owed: name what has to be read. The obligation text is the standing's own, so it cannot be edited
          // into silence here while the value keeps claiming to be a transcription.
          Present { value: owed } => concat(",owed=", owed) as NonEmptyStr
        },
      ) as NonEmptyStr
  }
}

// THE SILENCE CLAIM'S OUTSTANDING OBLIGATION, exposed so a consumer can refuse to believe a silent row that is
// still transcribed rather than having to re-derive that it is. Absent means nothing is owed.
fn silence_read_obligation(receipt: PackageSilenceReceipt) -> Optional<NonEmptyStr> {
  match receipt {
    SilentReceipt { package: _, architecture: _, observed_version: _, standing: how } => cited_figure_read_obligation(standing: how)
  }
}

// THE EMPTY CASE GETS ITS OWN TOKEN RATHER THAN AN EMPTY JOIN: an empty package list and a list that
// renders to nothing must not be the same string, and the seed record should not be able to describe "no
// drivers" and "drivers whose names are the empty string" identically.
fn render_sorted_names(names: List<String>) -> NonEmptyStr {
  match names.length() == 0 {
    True => "none" as NonEmptyStr
    False => names.sort_by(n => n).join(",") as NonEmptyStr
  }
}

// ---------------------------------------------------------------------------
// 9. The BINDING: this seed, on this unit, on this attempt — with the digest as the evidence.
// ---------------------------------------------------------------------------

// WHY A BINDING IS ITS OWN RECORD AND NOT A FIELD ON THE SEED. The same seed is correct for many units
// and no two attempts of one unit are the same event; putting unit or attempt on the seed would either
// force a fresh seed object per unit (destroying the "same config, same digest" property the target
// standing is built to guarantee) or force a shared seed to claim it belongs to one unit. Separated, the
// pair of claims each has a home: the seed's digest says WHAT was booted, the binding says WHOSE board
// and WHICH attempt, and a boot log answers "the machine booted seed X" by quoting a binding rather than
// by remembering. The binding is sole_constructor for a sharper reason than the seed's: a hand-written
// record could carry a digest that was never computed from the seed it names, which is precisely the
// evidence-free claim this record exists to forbid. The constructor computes the digest itself; there is
// no digest parameter.
//
// THE ORIGIN IS NOT A FIELD. The install origin (S3's kernel/initrd/filesystem digests and their mirror
// provenance) is a property of the MEDIA the board net-booted from, and it is bound to this attempt by
// whoever records the boot event — a seed does not restate origin digests, because then a seed would be
// stale whenever the origin was republished byte-identically, and "which seed" would stop being a
// question with one answer. The binding keeps the two records side by side, each with its own digest.
type UbuntuAutoinstallSeedBinding sole_constructor {
  unit_key: UnitKey
  attempt: IntakeAttemptId
  // TWO DIGESTS BECAUSE THERE ARE TWO QUESTIONS. `seed_digest` answers "which configuration" and is computed
  // from the seed's semantic axes; `document_digest` answers "what was served" and is the SHA-256 of the bytes
  // gunbc.os_install_emit wrote for the payload (review: merry-fox-82, HOLD section 1). The record used to
  // carry one digest — of this module's own diagnostic rendering — and the boot verdict stood on it, so the
  // verdict was a comparison between two strings neither of which had ever been handed to a machine. Drop the
  // first and two documents produced by different writer versions become indistinguishable; drop the second
  // and "the machine booted seed X" has no evidence behind it at all.
  seed_digest: Fnv1a64Structural
  document_digest: Fnv1a64Structural
  seed_rendering: NonEmptyStr
  // THE SERVED BYTES, NOT JUST THE CONFIGURATION IDENTITY. (review: merry-fox-82, HOLD section 1) A binding
  // that carried only a semantic digest could report "the machine booted seed X" while the bytes the board
  // received omitted the debconf answers that make X noninteractive — the digest moved, the served document
  // did not, and nothing in the record could see the mismatch. The bundle is derived by the mint from THIS
  // seed (serve_seed_bundle), so it cannot name a document this seed did not produce, and binding_digest
  // folds its digest — an answer changed is a different binding, provably. Absent here would mean the
  // renderer refused, which the binder refuses outright rather than binding (no binding describes an
  // unservable seed), so the field is present-and-derived or the record does not exist.
  served: ServedSeedBundle
  delivery: SeedDeliveryStrategy
  disk: TargetDiskSelector
  disk_selection: BoundDiskEvidence
}

// THE DISK EVIDENCE, BOUND AT BINDING TIME. The selection is recorded INSIDE the binding rather than
// recoverable from the seed, because the same seed on a different unit selects a different disk — the
// disk the install actually targeted is a fact about the attempt. Carrying the selected serial means a
// post-incident question ("what did that install write to?") is answerable from this record alone; a
// binding that stored only the selector would require re-running the probe to reconstruct an event that
// already happened.
// The unread arm carries NO payload: what it asserts is that the probe gave us no serial for the disk we
// bound, and that is a property of the probe's answer, not a per-instance fact needing a sentence. A note
// field here would be commentary stored as data — written in one place, read in none.
// THE DISK EVIDENCE IS A VERDICT, NOT A STRING. BoundDisk carries the rule's discriminating counts alongside
// the serial; BoundDiskUnread is what the probe reported when it picked a device it could not identify — and it
// is NOT collapsed into BoundDisk with an empty serial, which is how a receipt ends up "naming" a drive nobody
// read. An unread identity on the device you are about to erase is its own answer, with the part number the
// probe did manage to read.
type BoundDiskEvidence
  = BoundDisk { serial: NonEmptyStr, matched: Int, observed: Int }
  | BoundDiskUnread { part_number: NonEmptyStr }

// WHY THE REFUSAL IS A UNION AND NOT A BARE Absent. A caller who is handed nothing cannot tell whether the
// board was never admissible or whether eight disks matched the rule — and those are different pages of the
// runbook (go re-admit the unit vs tighten the selector). The refusal that produces no record must still
// produce the diagnosis, exactly as SeedAudit and TargetDiskSelection do; an unlabelled Absent is the failure
// mode this module has now removed in three other places.
type BindingBlocker
  = TargetNotAdmitted { cause: TargetRefusalCause }
  | DiskSelectionRefused { cause: DiskSelectionRefusalCause }
  // THE SEED AND THE SELECTION DISAGREE ABOUT THE RULE. Named rather than folded into DiskSelectionRefused
  // because the operator's action is different: that one says "your rule cannot pick a disk", this one says
  // "someone handed this seed a disk picked by some other rule", which is a wiring defect in whatever produced
  // the call and not a fact about the bay.
  // BOTH SIDES OF THE DISAGREEMENT, IN THE ORDER THE READER NEEDS THEM: what the seed commanded, then what
  // was actually run. A one-sided payload (only the run provenance) forces the reader to go and find the seed
  // to know which of the two is wrong; naming them `seed`/`run` rather than two `TargetDiskSelector`s keeps the
  // executed side's evidence — the counts it matched — attached to the refusal.
  | DiskSelectorDisagreesWithSeed { seed: TargetDiskSelector, run: DiskSelectionProvenance }
  // THE SEED HAS NO SERVEABLE DOCUMENT. Either the upstream writer refused a payload field it cannot write with
  // its intended meaning, or the seed names a credential handle that carries no password read. Either way there
  // is nothing to serve the board, so a binding would be this module certifying a boot that cannot happen. Its
  // own arm rather than TargetNotAdmitted because the board is fine: the page of the runbook is "fix the seed",
  // not "re-admit the unit", and folding the two sends an operator to the wrong machine.
  | SeedHasNoRenderableDocument { reason: NonEmptyStr }

// THE TWO OUTCOMES OF A BINDING ATTEMPT, as arms rather than Optional, for the reason above: the green arm
// carries the record, the red arm carries why there is no record.
type BindingResult = Bound { binding: UbuntuAutoinstallSeedBinding } | BindRefused { blocker: BindingBlocker }

// THE ONLY DOOR INTO A BINDING. It takes the SEED (so the digest is computed now, from this record), the
// unit key and attempt (so the identity is bound, not assumed), and the live disk SELECTION (so a binding
// cannot exist for a disk the rules refused — a binding whose install had no target disk is a record of an
// install that could not have happened). A caller holding a refused selection receives Absent; the refusal
// reason is carried out so the report says why there is no binding.
fn bind_ubuntu_autoinstall_seed(
  seed: UbuntuAutoinstallSeed,
  target: ProvisioningTargetAdmission,
  unit_key: UnitKey,
  attempt: IntakeAttemptId,
  selection: TargetDiskSelection,
) -> BindingResult {
  match target {
    TargetRefused { reason: cause } => BindRefused { blocker: TargetNotAdmitted { cause: cause } }
    TargetAdmitted { standing: _ } =>
      match selection {
        SelectionRefused { cause: cause } =>
          BindRefused { blocker: DiskSelectionRefused { cause: cause } }
        // THE DISK WAS PICKED BY THE RULE THE SEED NAMES, OR THERE IS NO BINDING. Provenance is minted only by
        // select_target_disk from the selector it was handed, so comparing it against seed.disk is a comparison
        // between two facts that were each established by a call, not between two claims someone typed. The
        // defect this closes (review: merry-fox-82) was that a perfectly valid disk selected under a DIFFERENT
        // rule could be bound to this seed: the disk existed, the serial matched something, and the receipt
        // recorded a selector that had never been run against the probe.
        DiskSelected { provenance: provenance } =>
          match selectors_are_the_same(a: seed.disk, b: provenance.selector) {
            // THE PAYLOAD NAMES BOTH RULES AND SAYS WHICH IS WHICH. "seed" is the rule the seed commanded;
            // "run" is the rule that was actually executed against the probe and whose provenance is being
            // presented. Naming them the other way round — as an earlier revision did, by putting the run
            // provenance under `seed:` — tells an operator reading a refusal that their seed asked for the
            // wrong disk, and sends them to edit a seed that was correct.
            False => BindRefused { blocker: DiskSelectorDisagreesWithSeed { seed: seed.disk, run: provenance } }
            True =>
              // NO DOCUMENT, NO BINDING. The digest that leaves this function is the digest of what the board
              // will be served, so it has to be produced before the record can exist.
              match seed_document(seed: seed) {
                DocumentRefused { reason: why } =>
                  BindRefused { blocker: SeedHasNoRenderableDocument { reason: why } }
                DocumentBuilt { payload: _, content: _ } =>
              match serve_seed_bundle(seed: seed) {
                // UNREACHABLE IN THIS ARM, AND STILL SAID. serve_seed_bundle mints its halves from the same
                // seed_document this arm already built, so once a document exists the bundle exists. Saying
                // Absent => BindRefused anyway, reusing the blocker that already means "this seed has no
                // servable document", is the honest shape: the alternative is an unwritten arm that would
                // silently bind nothing, or a panic on a path a compiler cannot see is dead. If a future
                // renderer can produce a document but not a bundle, this arm becomes real and the refusal is
                // already the right answer.
                Absent =>
                  BindRefused { blocker: SeedHasNoRenderableDocument { reason: "bundle-mint-refused-after-document-built" as NonEmptyStr } }
                Present { value: served } =>
              Bound {
                binding: UbuntuAutoinstallSeedBinding {
                  unit_key: unit_key,
                  attempt: attempt,
                  seed_digest: ubuntu_autoinstall_seed_digest(seed: seed),
                  // THE SAME VALUE THE BUNDLE DIGEST FOLDED, taken out of the bundle rather than re-hashed here,
                  // so `document_digest` and the digest inside the served bundle cannot drift. The bundle is only
                  // `Present` when a real SHA-256 existed, so this field can never carry a stand-in (review 83764 #1).
                  document_digest: served.document_digest,
                  // THE RENDERING IS CARRIED, not just its digest, so the receipt can be re-checked without the
                  // seed still existing. And the disk evidence is inside the digest below, so "the machine
                  // booted seed X" cannot be answered for a machine that was pointed at a different drive.
                  seed_rendering: render_ubuntu_autoinstall_seed(seed: seed),
                  served: served,
                  delivery: seed.delivery,
                  disk: seed.disk,
                  disk_selection: provenance_chosen_identity(provenance: provenance),
                },
              }
              }
              }
          }
      }
  }
}

// SELECTORS ARE COMPARED FIELD BY FIELD, NEVER BY A FLATTENED STRING (review: merry-fox-82, HOLD section 2).
// The earlier version hashed selector_diagnostic of both sides, and that diagnostic is not injective: it glues
// the part number to the capacity with no delimiter, so two DISTINCT selectors
//   ByCatalogIdentity { part_number: "WDS200T2X0E2000", capacity_bytes: 398934016 }
//   ByCatalogIdentity { part_number: "WDS200T2X0E",     capacity_bytes: 2000398934016 }
// produced the SAME string, "catalog=WDS200T2X0E2000398934016", and the comparison called them one rule — two
// drives, one of them the wrong size by three orders of magnitude, accepted as the seed's target. Comparing the
// arms and then their fields is the only version that means what it says: the variant must match (a serial rule
// is never a catalog rule) and every field inside it must match by its own type — NonEmptyStr by string identity,
// ByteSize by measure equality, so a capacity can never agree with a part number by an accident of spelling.
//
// WHY THE FIELDS ARE FRAMED IN THE CONFIGURATION IDENTITY TOO (see configuration_identity_of_selector). The same
// collision merged two different seed renderings while the render claimed to frame the rule, which would let a
// receipt agree with a seed that meant something else. FUTURE REQUIREMENT: a new TargetDiskSelector arm adds a
// branch here and a branch in configuration_identity_of_selector; the compiler forces the first, and the second
// is the row a reviewer must see filled, which is why both are exhaustive with no catch-all.
fn selectors_are_the_same(a: TargetDiskSelector, b: TargetDiskSelector) -> Bool {
  match a {
    ByObservedSerial { serial: left } =>
      match b {
        ByObservedSerial { serial: right } => left == right
        ByCatalogIdentity { part_number: _, capacity_bytes: _ } => false
      }
    ByCatalogIdentity { part_number: left_part, capacity_bytes: left_capacity } =>
      match b {
        ByObservedSerial { serial: _ } => false
        ByCatalogIdentity { part_number: right_part, capacity_bytes: right_capacity } =>
          left_part == right_part && left_capacity == right_capacity
      }
  }
}

// WHAT A BINDING CHECK CAN AND CANNOT SAY (review: merry-fox-82, HOLD section 1). This fn compares a binding, a
// seed, and the (unit, attempt) they name — all three of which are values the caller already holds. Nothing here
// has ever contacted a board, fetched a URL, or read a console, so no outcome of this function may be spelled in
// the past tense of a boot. The names used to be BootedThisSeed / BootedADifferentSeed, and the body advertised
// a standing it had no way to observe: a caller reading "BootedThisSeed" from a local digest compare would
// believe an event had happened. What is actually decided here is whether the RECORD agrees with the SEED. The
// supplied-bytes comparison lives below, in supplied_document_standing, and is reachable only through a record.
//
// THREE ARMS, ALL POSITIVE CLAIMS ABOUT RECORDS. A fourth — "unobserved" — would be redundant here: this
// function is never the place a boot is reported, so it never needs to say "not yet".
type BindingVerdict
  = BoundConfigurationMatchesSeed
  | BoundConfigurationDiffersFromSeed
  // NO PAYLOAD: the arm asserts that the binding does not name the unit and attempt being asked about, which
  // is fully determined by the two comparisons below. A note there would be prose stored as data, constructed
  // once and read by nobody. A future need to distinguish WHICH identity mismatched adds a field with a real
  // consumer, or a new arm.
  | BindingIsForeign

fn check_binding_against_seed(
  binding: UbuntuAutoinstallSeedBinding,
  seed: UbuntuAutoinstallSeed,
  unit_key: UnitKey,
  attempt: IntakeAttemptId,
) -> BindingVerdict {
  match binding.unit_key == unit_key && binding.attempt == attempt {
    False => BindingIsForeign
    True =>
      match content_hash_eq_structural(
        left: binding.seed_digest,
        right: ubuntu_autoinstall_seed_digest(seed: seed),
      ) {
        True => BoundConfigurationMatchesSeed
        False => BoundConfigurationDiffersFromSeed
      }
  }
}

// ---------------------------------------------------------------------------
// 9b. THE BOOT OBSERVATION. Nothing in this module may say a board booted until somebody brings back
// what the board was actually served.
// ---------------------------------------------------------------------------

// AN OBSERVATION OF WHAT A BOARD WAS SERVED. This is an observation THIS REPOSITORY makes, so it is a receipt in
// the observing layer (DESIGN.md §3b: "observations this repository makes are receipts in the observing layer,
// not facts of the observed upstream") — it is not a field of the seed and not a fact about libxcrypt, Ubuntu, or
// the BMC. It exists because the alternative was worse: the binding used to answer "did it boot this seed?" from
// two digests computed in the same process, which is a tautology with a receipt printed on it.
//
// THE CONSTRUCTOR TAKES THE BYTES AND DERIVES THE DIGEST. That ordering is the whole point. A record that stored
// a digest someone handed it alongside a document it never read could assert any boot it liked; here the digest
// is computed from the fetched text by the same fn the binding's digest came from, so a boot claim can only be
// built from something that was actually fetched. The authority is the anchor for where the text came from — the
// TFTP/HTTP location and the fetch — because "the machine booted seed X" is only evidence if someone can go and
// re-read the source.
// WHAT THIS RECORD IS, AND WHAT IT IS NOT (review: merry-fox-82, HOLD section 4, taken as option (a): "Rename
// this to a supplied-document comparison, with no BootedThisSeed claim"). This module must not decide HOW the
// seed is delivered, so it can never be the authority that a fetch happened — sealing this mint to a
// delivery/readback route would name a transport it is not allowed to name, and a route that does not exist yet
// is not a seal. So the honest move is to say exactly what the record holds: bytes somebody SUPPLIED to us as
// what a board was served, under an identity they name, with the comparison digest derived here rather than
// supplied. The old name (SeedBootObservation) and the old arms (BootedThisSeed / BootedADifferentSeed) claimed
// an event this module cannot witness. The word "boot" appears nowhere below on purpose: a boot is the SERVING
// route's claim to make, and when a delivery seam eventually reports one, that report joined with THIS record is
// the boot evidence — neither half alone ever is.
//
// THE RECORD CARRIES BOTH SERVED PARTS (the user-data and the preseed), for the same reason the bundle does
// (HOLD section 1): a comparison that read only the user-data would let a served preseed full of answers be
// matched against nothing, which reopens the pairing gap one layer up. The supplied digest is folded by
// served_bundle_digest — the mint's own function — so the equality in supplied_document_standing compares
// like with like; a second spelling of the fold here would be two authorities over one comparison.
//
// THE IDENTITY IS IN THE RECORD (the second half of merry's item 4: "The same observation can also be applied to
// another unit's binding with the same document digest"). unit_key and attempt are carried at mint time, so the
// record answers "this text, supplied for THIS attempt" or it is not the record at all; the comparison below
// joins them to the binding and cannot answer about the bytes alone.
//
// sole_constructor keeps the digest from being typed by hand: the mint recomputes it from the supplied text, so
// a record cannot assert a digest its own text would not produce.
type SuppliedServedDocument sole_constructor {
  unit_key: UnitKey,
  attempt: IntakeAttemptId,
  supplied_user_data: NonEmptyStr,
  supplied_preseed: ServedPreseed,
  supplied_bundle_digest: Fnv1a64Structural,
  supplied_from: ExternalAuthority,
}

fn record_supplied_served_document(
  unit_key: UnitKey,
  attempt: IntakeAttemptId,
  supplied_user_data: NonEmptyStr,
  supplied_preseed: ServedPreseed,
  supplied_from: ExternalAuthority,
) -> Optional<SuppliedServedDocument> {
  match rendered_document_digest(content: supplied_user_data) {
    // THE COMPARISON CANNOT BE ANSWERED FOR BYTES THAT CANNOT BE DIGESTED. A supplied record whose user-data half
    // yields no SHA-256 has no digest to compare, and inventing one would let a board's boot be "confirmed" against
    // bytes the model cannot actually identify. Absent here means the standing answer is NothingSupplied-grade
    // honesty, not a false match. (Same defect class as review 83764 finding 1, on the supplied side.)
    Absent => Absent
    Present { value: document } =>
      Present {
        value: SuppliedServedDocument {
          unit_key: unit_key,
          attempt: attempt,
          supplied_user_data: supplied_user_data,
          supplied_preseed: supplied_preseed,
          supplied_bundle_digest: served_bundle_digest(document: document, preseed: supplied_preseed),
          supplied_from: supplied_from,
        },
      }
  }
}

// WHAT THE COMPARISON CAN SAY, WITH NO PAST-TENSE IN ANY ARM. Four answers about RECORDS:
//   - the supplied bytes are the bytes this binding promised;
//   - they are not;
//   - the supplied record is not about this (unit, attempt) at all, so the bytes are irrelevant — a first-class
//     arm rather than a silent "differs", because "wrong owner" and "wrong bytes" are different facts an
//     operator needs apart (the first is a filing error; the second is a serve that delivered something else);
//   - nothing was supplied: UNOBSERVED AS AN OUTCOME, carried forward rather than defaulted to the flattering
//     arm. A future requirement to distinguish "nobody looked" from "looked and it was not there" adds an arm
//     with its own evidence, not a note field here.
type SuppliedDocumentStanding
  = SuppliedBytesAreWhatThisBindingPromised
  | SuppliedBytesAreNotWhatThisBindingPromised
  | SuppliedRecordIsNotAboutThisAttempt
  | NothingSupplied

// THE JOINED COMPARISON. Identity first: a record for another attempt can never be made to speak about this
// one, even when the bytes coincide (two attempts CAN be served identical bytes; that must not make one
// attempt's record usable as the other's evidence). Then the bytes, compared as BUNDLES — the digest of the
// same tagged fold the mint used, so both user-data and preseed must agree. The configuration digest stays on
// the binding answering "which configuration did we intend"; the served bytes answer "what did the board get".
fn supplied_document_standing(
  binding: UbuntuAutoinstallSeedBinding,
  supplied: Optional<SuppliedServedDocument>,
) -> SuppliedDocumentStanding {
  match supplied {
    Absent => NothingSupplied
    Present { value: seen } =>
      match binding.unit_key == seen.unit_key && binding.attempt == seen.attempt {
        False => SuppliedRecordIsNotAboutThisAttempt
        True =>
          match content_hash_eq_structural(
            left: binding.served.bundle_digest,
            right: seen.supplied_bundle_digest,
          ) {
            True => SuppliedBytesAreWhatThisBindingPromised
            False => SuppliedBytesAreNotWhatThisBindingPromised
          }
      }
  }
}

// THE BINDING'S OWN EVIDENCE TAG, for whoever stores bindings as addressable records: tagged separately
// from the seed digest so a binding can be looked up by (unit, attempt) without being confusable with a
// seed. A future requirement to store bindings content-addressed uses THIS and not the seed digest —
// otherwise two units booting the same seed would collide in one address space, which is exactly the
// ambiguity the separation exists to prevent.
//
// THE DISK IS IN THE ADDRESS (review: merry-fox-82). The disk evidence used to be a field on the record and
// nowhere in its digest, so two bindings that differed only in which drive they targeted shared an address —
// which is precisely the question this record exists to answer later, and an address that cannot answer it will
// be overwritten by whichever write came second. Including it means "the receipt for this attempt" changes when
// the target changes, and a silent change of drive in a stored receipt becomes a different receipt rather than
// the same one.
fn binding_digest(binding: UbuntuAutoinstallSeedBinding) -> Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "gunbc.provisioning.ubuntu_autoinstall_seed.binding/3",
    payload: content_hash_combine_structural(
      left: content_hash_combine_structural(
        left: content_hash_atom(value: to_string(binding.unit_key) as NonEmptyStr),
        right: content_hash_atom(value: to_string(binding.attempt) as NonEmptyStr),
      ),
      right: content_hash_combine_structural(
        left: content_hash_combine_structural(
          left: binding.seed_digest,
          right: content_hash_atom(value: binding.seed_rendering),
        ),
        right: content_hash_combine_structural(
          // THE COMPLETE SERVED BUNDLE IS IN THE ADDRESS (review: merry-fox-82, HOLD sections 1 and 5; the tag
          // bumps to /3 because the address gains meaning, not just spelling). Previously the address covered the
          // configuration, the unit, the attempt and the disk — nothing derived from the bytes the board is handed
          // — so a renderer revision or a dropped answer file left the address untouched, and "the machine booted
          // seed X" was answerable from memory instead of evidence. This one term carries BOTH served halves,
          // each tagged by role inside served_bundle_digest: the "document" term IS the served-document digest
          // merry's item 5 asked to be added — literally so, since it folds rendered_document_digest(content), the
          // SAME derivation binding.document_digest holds, not a second spelling beside it — and the preseed term
          // is the half a document-only fold would still have omitted.
          //
          // WHY ONE SERVED TERM AND NOT binding.document_digest ALONGSIDE IT. A fold term that no test can lose is
          // decoration, and a separate document term could not be lost: served_bundle_digest already folds
          // rendered_document_digest(content), so deleting a second term over the same derivation changes nothing
          // and no mutation could name a RED witness for it. The address instead says, in one spelling, exactly
          // what it vouches for — and EACH sub-term inside served_bundle_digest has its own discriminating
          // witness: deleting the document term
          // goes RED on the vault-read discriminator (two seeds identical in configuration and rendering whose
          // read carries a different digest — credential_diagnostic covers the handle's locator and version
          // only, so this is the one axis that moves the document but not the configuration), and deleting the
          // preseed term goes RED on the answer-pairing witness. The record still CARRIES document_digest,
          // because it answers a different question (supplied_document_standing compares what somebody supplied
          // against what this binding promised); what it cannot do is pretend to protect an address it
          // contributes nothing distinguishable to.
          left: content_hash_tagged_structural(
            tag: "bundle",
            payload: binding.served.bundle_digest,
          ),
          // The disk's own tagged structural hash, not a re-derivation of its fields: BoundDisk and
          // BoundDiskUnread are different claims, and they must not be able to collide with each other or with a
          // bound disk whose serial happens to read like a part number.
          right: content_hash_atom(value: bound_disk_evidence_diagnostic(evidence: binding.disk_selection)),
        ),
      ),
    ),
  )
}

// THE EVIDENCE IN ONE LINE, AND THE TWO ARMS CANNOT PRODUCE THE SAME LINE. The verdict word is part of the
// string precisely so the unread arm cannot be mistaken for a bound disk whose serial is strange: the shapes
// differ in kind, and a rendering that flattens them is how a log line ends a claim the type refused to make.
fn bound_disk_evidence_diagnostic(evidence: BoundDiskEvidence) -> NonEmptyStr {
  match evidence {
    BoundDisk { serial: named, matched: m, observed: o } =>
      concat(
        concat(concat("bound:", named), ",rule-matched="),
        concat(int_diagnostic(count: m), concat("/of-", int_diagnostic(count: o))),
      ) as NonEmptyStr
    BoundDiskUnread { part_number: part } =>
      concat("identity-unread:", part) as NonEmptyStr
  }
}
