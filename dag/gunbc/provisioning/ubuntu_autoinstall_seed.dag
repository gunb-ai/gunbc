data gunbc_provisioning_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html"
  }
}

// CITED, AND CITED FOR THE RIGHT THING: the autoinstall reference documents which sections may be
// marked interactive, and that is exactly the clause this module's audit turns off. Its presence here
// rather than beside the payload type is deliberate — the payload shape is upstream's, the decision to
// demand proof of non-interactivity is ours.
data interactive_sections_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html#interactive-sections"
  }
}

// The debconf preseed question is the mechanism by which a package can ask something during a
// non-interactive install; the audit's PackagePrompts arm is only meaningful because debconf-seeding is
// a real, documented escape hatch and not an invention of this model.
data debconf_preseed_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "help.ubuntu.com/community/AutoInstallAndSeeding"
  }
}

// ---------------------------------------------------------------------------
// 1. What the seed may know about the unit it is for. It is not a name.
// ---------------------------------------------------------------------------

// THE TARGET STANDING IS CLOSED BECAUSE EACH MEMBER IS A REASON THE SEED COULD BE WRONG. Architecture
// selects the package set; the BMC firmware family selects the console stanza; the role decides whether
// the disks under this board are this board's to erase. A hostname is absent by design: two units of the
// same model must need the same seed, and where units genuinely differ the difference belongs in the
// BINDING, so "same config for two units" means "same seed, same digest, two bindings" — and a digest
// that two units share is evidence nobody wrote a per-host rule. A future requirement that really does
// need per-unit configuration (a unit-local mirror, say) adds a constructor to a closed axis below plus
// the evidence that justifies it; it does not add a String field keyed on a label.
type ProvisioningTargetStanding sole_constructor {
  architecture: Architecture
  bmc_firmware: BmcFirmwareFamily
  role: ProvisioningTargetRole
  kernel_flavour: UbuntuKernelFlavour
}

// THE ROLE AXIS IS PARTICIPATION, NOT MACHINE KIND (plan §2: "the model's axes are participation,
// transport, role, and hardware — never the label"). Only the Altra provisioning target may be rendered
// a seed for. The other roles are named so a caller holding a runner or a serving host is refused rather
// than quietly formatted: the failure this axis prevents is a seed aimed at a board that is holding
// somebody else's data. The refused role carries NO payload — the refusal reads participation alone, and
// a host string here would be a field with no consumer whose only effect would be to make two refusals of
// the same kind digest differently. A future requirement (serving hosts allowed to seed themselves) adds a
// constructor here and a row in the door below; it does not add a host payload to a refusal.
type ProvisioningTargetRole = ProvisioningTarget | RunnerBacked

// RENDERED OR REFUSED, WITH REFUSAL AS A VALUE. Refusal is an arm, not an error, because the program's
// rule is "no route from absent evidence to a green claim": a seed that was never admitted is not an
// exception to swallow, it is the record of why nothing was installed, and it has to survive to the
// report.
type ProvisioningTargetAdmission
  = TargetAdmitted { standing: ProvisioningTargetStanding }
  | TargetRefused { reason: TargetRefusalCause }

// THE CAUSES NAME WHAT THE PROBE DID NOT OBSERVE, NOT WHAT WENT WRONG IN THIS MODULE. Each arm is a
// piece of evidence that was absent at the seam; the module does not invent a reason, it reports which
// standing failed to be present.
type TargetRefusalCause
  = UnitKeyUnbound { cause: UnitKeyRefusalCause }
  // AN ARCHITECTURE WITH NO SEED ROW AT ALL: nobody has said what this platform's seed is built from, so a
  // seed for it would be a document whose every claim is unsourced.
  | PlatformUnsupported { architecture: Architecture }
  // AN ARCHITECTURE WITH A ROW BUT NO ADMITTED PACKAGE ROWS BENEATH IT. Distinguished from
  // PlatformUnsupported because the operator reads a different instruction from each: "no row" means the
  // platform was never brought into scope, "a row whose packages all refuse" means somebody tried, and the
  // row's own package citations are what to go fix.
  | ArchitectureHasNoPackageRows { architecture: Architecture }
  | BmcFirmwareFamilyUnobserved { discriminator: NonEmptyStr }
  | NotAnProvisioningTarget { role: ProvisioningTargetRole }

// THE ONLY DOOR INTO A TARGET STANDING, AND WHY EVERY ARGUMENT IS A STANDING RATHER THAN A FACT. A
// caller holding an unbound UnitKey or an unobserved BMC family receives a refused arm out of the
// signature itself and cannot reach the Admitted constructor by writing a record. This is where the
// probe's (S2) and identity's (S1) outputs become load-bearing: an absent observation is never defaulted
// here, it is turned away. A future requirement to admit, say, a board whose BMC family is unknown but
// whose console has been observed directly adds a standing to
// gunbc.machine_intake.bmc_first_contact_standing and a row in the match below — it does not add a
// "guess the family" default.
fn admit_provisioning_target(
  unit_key: UnitKeyStanding,
  architecture: Architecture,
  bmc_firmware: BmcFirmwareFamilyStanding,
  role: ProvisioningTargetRole,
  kernel_flavour: UbuntuKernelFlavour,
) -> ProvisioningTargetAdmission {
  match unit_key {
    UnitKeyBound { key: _ } =>
      match bmc_firmware {
        FamilyObserved { family: observed } =>
          // THE ARCHITECTURE IS ADMITTED BY ITS ROW, NEVER BY A BRANCH THAT NAMES A BOARD OR A FAMILY.
          // A platform is provisionable exactly when it carries a seed architecture row and that row
          // admits at least one package row: an architecture nobody has admitted a single verified
          // package for is not a supported platform, it is an aspiration with a name, and admitting it
          // would let a seed be built whose every package claim is unverifiable. Admitting X86_64 is
          // therefore the addition of a row, not the addition of an arm to this match.
          match find_seed_architecture_row(architecture: architecture) {
            Absent => TargetRefused { reason: PlatformUnsupported { architecture: architecture } }
            Present { value: row } =>
              match architecture_row_admissible(row: row, architecture: architecture) {
                False => TargetRefused {
                  reason: ArchitectureHasNoPackageRows { architecture: architecture },
                }
                True =>
                  match role {
                    ProvisioningTarget =>
                      TargetAdmitted {
                        standing: ProvisioningTargetStanding {
                          architecture: architecture,
                          bmc_firmware: observed,
                          role: role,
                          kernel_flavour: kernel_flavour,
                        },
                      }
                    RunnerBacked => TargetRefused {
                      reason: NotAnProvisioningTarget { role: role },
                    }
                  }
              }
          }
        FamilyUnobserved { discriminator: d } => TargetRefused {
          reason: BmcFirmwareFamilyUnobserved { discriminator: d },
        }
      }
    UnitKeyRefused { cause: c } => TargetRefused { reason: UnitKeyUnbound { cause: c } }
  }
}

// THE CONSOLE FAMILY AND THE TRANSPORT ARE SEPARATE AXES BECAUSE THEY ANSWER DIFFERENT QUESTIONS, AND
// THE SEED NEEDS BOTH ANSWERS WITHOUT ONE IMPLYING THE OTHER. Whether the BMC serves a serial-over-LAN
// console is a property of the BMC firmware family (extdeps.bmc.endpoint's closed set — reused, not
// restated). Whether the image arrives by PXE, HTTP boot, or BMC virtual media is a property of delivery,
// which the S0 seam decides and hands over. Collapsing them would let a strategy name change what the
// seed promises about its console, which is the per-host branching this program forbids.
type SeedDeliveryStrategy =
    PxeStrategy { boot_mode: ClientNetworkBootMode }
  | VirtualMediaStrategy { media_stem: NonEmptyStr }

// WHAT THE STRATEGY IS FOR, AS SEEN FROM HERE: whether the installer's serial console is opened by the
// firmware on a link the operator controls (PXE, where a TFTP/HTTP conversation is already in progress
// and a console prompt could in principle be answered by someone watching a SOL window) or arrives over
// the BMC's own virtual-media channel with no console path at all. The seed's response is one clause,
// derived — never a field beside the strategy, because two fields that must agree is two fields that can
// disagree.
// THE TRANSPORT TOKEN SPREADS THE WHOLE AXIS, INCLUDING THE BOOT MODE. Collapsing the three
// ClientNetworkBootMode members to one "pxe" spelling would put two genuinely different installs — a
// TFTP-delivered one and an HTTP-boot one, which differ in who owns the failure when a firmware release
// drops a DHCP option — under a single digest. Two boards that booted differently would then answer "the
// machine booted seed X" identically, which is exactly the memory-instead-of-evidence failure the binding
// exists to remove. The rule for a diagnostic here: it must be as narrow as the axis it spells, so a new
// ClientNetworkBootMode member forces a row here and cannot silently inherit "pxe".
fn delivery_strategy_diagnostic(strategy: SeedDeliveryStrategy) -> NonEmptyStr {
  match strategy {
    PxeStrategy { boot_mode: mode } =>
      concat("pxe-", client_network_boot_mode_token(mode: mode))
    VirtualMediaStrategy { media_stem: stem } =>
      concat("virtual-media-", stem)
  }
}

// A FULL MATCH WITH NO DEFAULT, for the reason above: an unknown boot mode that borrowed another mode's
// token would make two different transports hash alike. The TFTP locator is deliberately NOT part of the
// token — it is a server-side address owned by the PXE edge, not a decision the seed makes, and letting an
// edge's address move a seed digest would couple seed identity to a hostname.
fn client_network_boot_mode_token(mode: ClientNetworkBootMode) -> NonEmptyStr {
  match mode {
    LegacyBiosPxe { tftp_root: _ } => "bios"
    UefiPxe { tftp_root: _ } => "uefi-pxe"
    UefiHttpBoot => "uefi-http"
  }
}

// ---------------------------------------------------------------------------
// 2. The package and driver sets, and what makes either of them interactive by accident.
// ---------------------------------------------------------------------------

// TWO AXES, NOT ONE LIST: A PACKAGE AND A KERNEL MODULE ARE DIFFERENT KINDS OF THING, AND WERE MIXED.
// "ahci", "r8169-firmware", "realtek-firmware", "dca-tools" and "xserver-xorg-video-ast" — five of the seven
// spellings this set first carried — are not packages: they are what a kernel MODULE is called, wearing a
// package's clothing. That mistake is invisible to every check short of the install itself, because apt
// reports a missing package at minute twelve of an unattended run, after the board's disk has been
// partitioned, with nobody at the console and the failure blamed on the network or the media. So the axis is
// split into the two kinds, and each kind is checked the way ITS kind is checked: a package against the
// archive, a module against the Kconfig/Makefile that makes it exist.
//
// WHY THIS IS CLOSED WHEN PackageIntent Is Open. The closed sets are the members WE guarantee; anything else
// enters through PackageIntent, where the caller names it and carries its debconf burden. A member added here
// is a claim this module defends with a citation.
type SeedInstallDriver =
    NvmeCliDriver
  | IpmiToolDriver
  | DmidecodeDriver
  | LinuxFirmwareDriver
  // THE x86 CPU-FIRMWARE PACKAGE, one row per architecture that needs it. amd64-microcode carries the
  // processor microcode bundles x86 boards apply at boot; the arm64 fleet has no such package and no arm
  // profile names this variant. Admitted as a row of the driver table, never as an if-x86 branch.
  | Amd64MicrocodeDriver

// THE PACKAGE NAME IS DERIVED FROM ONE ROW, AND THE ROW CARRIES ITS WARRANT. This function is the only place
// any of these spellings exists, so a seed cannot name a package its driver set does not contain. The
// authority is per-row rather than one module-wide constant on purpose: a single citation covering the whole
// set would let one checked row launder an unchecked one, which is exactly how five fabricated spellings
// survived their first green run. Each row was admitted against the archive for THIS architecture —
// packages.ubuntu.com/noble/arm64/<name> resolving to a "Details of package" page, and the name published for
// arm64. linux-firmware is here because the r8169 driver requests firmware at probe time (drivers/net/
// ethernet/realtek/r8169_main.c at v6.8 calls request_firmware), so a board with the 8125-class NIC the S2
// probe reports cannot bring its own link up without it — an install-time need, not a cosmetic one.
fn install_driver_package(driver: SeedInstallDriver) -> NonEmptyStr {
  match driver {
    NvmeCliDriver => "nvme-cli"
    IpmiToolDriver => "ipmitool"
    DmidecodeDriver => "dmidecode"
    LinuxFirmwareDriver => "linux-firmware"
    Amd64MicrocodeDriver => "amd64-microcode"
  }
}

// THE SILENT HALF OF THE LATE SET, AS ROWS RATHER THAN AS A CLAIM ABOUT ROWS. These are the packages a headless
// Altra board needs present before anyone can log in: nvme-cli to read the SMART of the disk it just installed
// onto, ipmitool to talk to the BMC that is its only console, dmidecode to read the board's own identity back so
// the S2 probe can be checked against something other than itself, and rasdaemon so a memory or PCIe failure on
// a board nobody is standing in front of is recorded rather than silent. Each of the four was admitted the same
// way, and each row says so with the artifact it was read from: it is published for arm64 in the Noble archive at
// the version named in its receipt, and the shipped .deb FOR THAT VERSION contains no config script in its
// control tarball and no debconf templates in its data tarball — so nothing inside it can reach db_input at the
// version the board will actually install.
//
// WHY A ROW AND NOT A BOOLEAN `prompts: Bool` BESIDE THE NAME, AND WHY NOT Unclassified. A silence claim without
// an evidence arm is a guess with a confident type; and before this arm existed the only honest way to name a
// package that asks nothing was UnclassifiedPackage, which the audit refuses — so a headless board's diagnostic
// tooling could not be installed at all, and every "produced seed" fixture quietly passed `late_packages: []`
// while a witness claimed the seed installs it. That witness was asserting properties of an empty list. Loosening
// Unclassified into a pass would have fixed the witness by making it lie. A future checked-silent package adds a
// row here with its own version and standing; a package nobody has checked still enters through
// UnclassifiedPackage and is still refused.
fn board_required_late_package_rows() -> List<PackageIntent> {
  [
    PackageVerifiedSilent { silence: nvme_cli_silence_receipt },
    PackageVerifiedSilent { silence: ipmitool_silence_receipt },
    PackageVerifiedSilent { silence: dmidecode_silence_receipt },
    PackageVerifiedSilent { silence: rasdaemon_silence_receipt },
  ]
}

// THE SAME FOUR, AT THE amd64 BUILDS, FOR THE x86 BOARD. Each of these receipts names the .deb it was read
// from in the amd64 pool at archive.ubuntu.com (not the arm64 ports mirror — the two are separately built and
// separately versioned), at the noble version recorded in the receipt, and each was verified the same way:
// dpkg-deb over the downloaded artifact, no `config` member in the control tarball, no DEBIAN/templates in
// the data tarball, no db_* call in the maintainer scripts it does ship. None of the five prompts; none is
// recorded as a prompter.
fn board_required_amd64_late_package_rows() -> List<PackageIntent> {
  [
    PackageVerifiedSilent { silence: nvme_cli_amd64_silence_receipt },
    PackageVerifiedSilent { silence: ipmitool_amd64_silence_receipt },
    PackageVerifiedSilent { silence: dmidecode_amd64_silence_receipt },
    PackageVerifiedSilent { silence: rasdaemon_amd64_silence_receipt },
  ]
}

// ---------------------------------------------------------------------------
// 3e. Board seed profiles: which drivers a board's seed carries, as ONE ROW PER BOARD.
// ---------------------------------------------------------------------------

// THE BOARDS THAT HAVE A SEED PROFILE. A closed sum, not a string: "which install drivers, which loadable
// modules, which late drivers does this board's seed carry" used to be spelled at each call site, which meant
// a new board was a new copy-paste of five argument lists that nothing checked against the hardware. Adding a
// board is a constructor here plus a row below; the row is where its citations live.
type ProvisioningBoard =
    AltraBoard
  // Supermicro H11SSL-family (the X11SSM/H11SSi class with the AST2500 BMC); the unit this phase's board is
  // named for. Its profile is the row below, not an if-x86 branch.
  | SupermicroH11SslBoard

// WHAT A BOARD'S SEED CARRIES, per axis, exactly as build_ubuntu_autoinstall_seed receives the axes. This is
// not a new authority — it is the five lists the caller already had to hand over, lifted from call sites into
// rows so a board's driver set can be read, cited, and diffed against the hardware without reading Rust.
type BoardSeedProfile sole_constructor {
  install_drivers: List<SeedInstallDriver>
  loadable_modules: List<LoadableModuleClass>
  late_drivers: List<LateDriver>
  late_packages: List<PackageIntent>
}

// THE VIRTUAL-MEDIA USB SET, APPLIED TO THE PROFILE BY THE STRATEGY THAT NEEDS IT. A BMC virtual-media
// install hands the board a USB mass-storage device, so the installer needs usb-storage, uas and sd_mod
// loaded before it can read the media it installs from. This is a rule over the delivery strategy — the
// SAME rule fires for any board delivered that way — not a board-name branch, which is why it is a function
// of the strategy and not a field of the row.
fn virtual_media_usb_modules() -> List<LoadableModuleClass> {
  [
    UsbStorageModule,
    UasModule,
    SdModuleModule,
  ]
}

fn profile_with_delivery_modules(
  profile: BoardSeedProfile,
  delivery: SeedDeliveryStrategy,
) -> BoardSeedProfile {
  match delivery {
    PxeStrategy { boot_mode: _ } => profile
    VirtualMediaStrategy { media_stem: _ } =>
      BoardSeedProfile {
        install_drivers: profile.install_drivers,
        loadable_modules: list_append(left: profile.loadable_modules, right: virtual_media_usb_modules()),
        late_drivers: profile.late_drivers,
        late_packages: profile.late_packages,
      }
  }
}

// THE PROFILE ROWS. Altra's row is TODAY'S CHOICE VERBATIM — the four lists exactly as the ARM callers pass
// them, so the rename moves nothing; the digest of an Altra seed is the control that proves it. The H11SSL
// row is new, and every module in it carries its kconfig citation beside it (symbol + file, the same two
// fields the existing rows spell), verified at v6.8:
//   igb            CONFIG_IGB, tristate, drivers/net/ethernet/intel/Kconfig; built as igb/igb.o by
//                  drivers/net/ethernet/intel/igb/Makefile; the i210's 0x1533 device id is claimed in
//                  drivers/net/ethernet/intel/igb/igb_main.c's pci_device_id table.
//   ahci           CONFIG_SATA_AHCI, tristate, drivers/ata/Kconfig; built as ahci.o by
//                  drivers/ata/Makefile (obj-$(CONFIG_SATA_AHCI) += ahci.o libahci.o). Distinct from
//                  ahci_platform (SATA_AHCI_PLATFORM), which is the Altra row — different symbol, different
//                  silicon, two rows on purpose.
//   nvme           CONFIG_BLK_DEV_NVME, drivers/nvme/host/Kconfig, nvme.o — the boot disk; kept beside the
//                  arm row because the board boots from NVMe too.
//   usb set        see virtual_media_usb_modules above; arrives only with a virtual-media strategy.
//   ast            CONFIG_DRM_AST, drivers/gpu/drm/ast/Kconfig, ast.o — the AST2500 BMC's video, so the
//                  BMC console shows the installer instead of a black panel.
//   ipmi_si        CONFIG_IPMI_SI, drivers/char/ipmi/Kconfig, ipmi_si.o — the System Interface driver for
//                  the AST2500's BMC.
//   ipmi_watchdog  CONFIG_IPMI_WATCHDOG, drivers/char/ipmi/Kconfig, ipmi_watchdog.o — the BMC watchdog, so
//                  a board that hangs mid-install is reset rather than kept company by nobody.
fn board_seed_profile(board: ProvisioningBoard, delivery: SeedDeliveryStrategy) -> BoardSeedProfile {
  let row = match board {
    AltraBoard =>
      BoardSeedProfile {
        install_drivers: [
          NvmeCliDriver,
          LinuxFirmwareDriver,
        ],
        loadable_modules: [
          NvmeBlockModule,
          AhciPlatformModule,
        ],
        late_drivers: [
          KipmiSiDriver,
          IpmiWatchdogDriver,
        ],
        late_packages: board_required_late_package_rows(),
      }
    SupermicroH11SslBoard =>
      BoardSeedProfile {
        install_drivers: [
          NvmeCliDriver,
          LinuxFirmwareDriver,
          Amd64MicrocodeDriver,
        ],
        loadable_modules: [
          NvmeBlockModule,
          AhciModule,
          IgbNicModule,
        ],
        late_drivers: [
          Ast2500DrmDriver,
          KipmiSiDriver,
          IpmiWatchdogDriver,
        ],
        late_packages: board_required_amd64_late_package_rows(),
      }
  }
  profile_with_delivery_modules(profile: row, delivery: delivery)
}

// ONE RECEIPT PER PACKAGE, EACH CARRYING THE BUILD ITS CLAIM IS ABOUT. Silence is a property of a BUILD, not of a
// name: the point release that grows a config script invalidates the row while leaving every name-based check
// intact, which is exactly why the version is a field of the receipt rather than a comment above it. The four
// standings are identical today because all four were measured the same way; they are separate rows so that when
// one of them is only transcribed, or is found to prompt, it can change its standing without touching the others.
data nvme_cli_silence_receipt: PackageSilenceReceipt = SilentReceipt {
  package: "nvme-cli" as NonEmptyStr,
  architecture: Arm64Architecture,
  observed_version: "2.8-1build2" as NonEmptyStr,
  standing: CitedToAuthority { authority: nvme_cli_deb_authority },
}

data ipmitool_silence_receipt: PackageSilenceReceipt = SilentReceipt {
  package: "ipmitool" as NonEmptyStr,
  architecture: Arm64Architecture,
  observed_version: "1.8.19-7build2" as NonEmptyStr,
  standing: CitedToAuthority { authority: ipmitool_deb_authority },
}

data dmidecode_silence_receipt: PackageSilenceReceipt = SilentReceipt {
  package: "dmidecode" as NonEmptyStr,
  architecture: Arm64Architecture,
  observed_version: "3.5-3build1" as NonEmptyStr,
  standing: CitedToAuthority { authority: dmidecode_deb_authority },
}

data rasdaemon_silence_receipt: PackageSilenceReceipt = SilentReceipt {
  package: "rasdaemon" as NonEmptyStr,
  architecture: Arm64Architecture,
  observed_version: "0.8.0-2" as NonEmptyStr,
  standing: CitedToAuthority { authority: rasdaemon_deb_authority },
}

// THE ARTIFACTS THE SILENCE CLAIMS WERE READ FROM: the exact .deb in the arm64 archive, not the package's
// documentation and not a wiki. A reviewer re-derives a row by downloading this path and opening its control
// tarball, which is the whole test of whether a citation is worth its bytes — and note that the archive index is
// NOT sufficient evidence here: the HTML package pages answer 200 for names that do not exist at all, so a claim
// checked against them can look verified while nothing was checked.
data nvme_cli_deb_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "ports.ubuntu.com/ubuntu-ports/pool/main/n/nvme-cli/nvme-cli_2.8-1build2_arm64.deb"
  }
}

data ipmitool_deb_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "ports.ubuntu.com/ubuntu-ports/pool/universe/i/ipmitool/ipmitool_1.8.19-7build2_arm64.deb"
  }
}

data dmidecode_deb_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "ports.ubuntu.com/ubuntu-ports/pool/main/d/dmidecode/dmidecode_3.5-3build1_arm64.deb"
  }
}

data rasdaemon_deb_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "ports.ubuntu.com/ubuntu-ports/pool/universe/r/rasdaemon/rasdaemon_0.8.0-2_arm64.deb"
  }
}

// THE SAME FOUR QUESTIONS, ASKED OF THE AMD64 ARCHIVE, ANSWERED SEPARATELY. Silence is a property of a build,
// and an amd64 build is a different build: it has its own control tarball (which is where a config script
// would live) and its own data tarball (which is where debconf/templates would live). These five rows were
// established the same way the arm64 four were — the named .deb fetched from the named path in the amd64
// archive at archive.ubuntu.com/ubuntu/pool, `debian-binary`/`control.tar.zst`/`data.tar.zst` extracted, the
// control tarball read for a `config` member (none in any of the five) and the data tarball read for any
// `DEBIAN/templates` or `db_` call in a maintainer script (none in any of the five) — and NOT imported from
// the arm64 rows above. Two archives, two index files, two release cadences: a silent arm64 build says
// nothing about an amd64 one, so no row here is derived from its counterpart, and the two sets are allowed
// to diverge when one side grows a config script. amd64-microcode is the fifth because it is a row only the
// x86 board can use: it is the CPU's own microcode blob, so it has no arm64 counterpart to be paired with.
data nvme_cli_amd64_deb_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "archive.ubuntu.com/ubuntu/pool/main/n/nvme-cli/nvme-cli_2.8-1build2_amd64.deb"
  }
}

data ipmitool_amd64_deb_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "archive.ubuntu.com/ubuntu/pool/universe/i/ipmitool/ipmitool_1.8.19-7build2_amd64.deb"
  }
}

data dmidecode_amd64_deb_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "archive.ubuntu.com/ubuntu/pool/main/d/dmidecode/dmidecode_3.5-3build1_amd64.deb"
  }
