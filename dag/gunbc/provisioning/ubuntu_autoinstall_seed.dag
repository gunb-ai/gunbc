// THE AMD64 SILENCE ROWS, ONE PER PACKAGE, each naming the architecture it was established FOR. This is a
// field of the receipt rather than a property of the authority the receipt cites (the locator string happens to
// end in `_amd64.deb` today, and would still end in it after the artifact was moved to a mirror) because the
// admission gate below reads the ARCHITECTURE FIELD: a row silently re-pointed at another architecture's
// artifact stops admitting, where a locator-only design would keep admitting and never notice.
data nvme_cli_amd64_silence_receipt: PackageSilenceReceipt = SilentReceipt {
  package: "nvme-cli" as NonEmptyStr,
  architecture: Amd64Architecture,
  observed_version: "2.8-1build2" as NonEmptyStr,
  standing: CitedToAuthority { authority: nvme_cli_amd64_deb_authority },
}

data ipmitool_amd64_silence_receipt: PackageSilenceReceipt = SilentReceipt {
  package: "ipmitool" as NonEmptyStr,
  architecture: Amd64Architecture,
  observed_version: "1.8.19-7build2" as NonEmptyStr,
  standing: CitedToAuthority { authority: ipmitool_amd64_deb_authority },
}

data dmidecode_amd64_silence_receipt: PackageSilenceReceipt = SilentReceipt {
  package: "dmidecode" as NonEmptyStr,
  architecture: Amd64Architecture,
  observed_version: "3.5-3build1" as NonEmptyStr,
  standing: CitedToAuthority { authority: dmidecode_amd64_deb_authority },
