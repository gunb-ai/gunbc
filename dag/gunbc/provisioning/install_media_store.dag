module gunbc.provisioning.install_media_store

import std.types { NonEmptyStr, FilePath }
import std.optional { Present }
import gunbc.host_state_root { HostStateTree, host_state_tree_path, host_state_tree }
import gunbc.owned_directory { OwnedDirectoryTarget, OwnedDirectoryDeclared, ForeignOwnershipRefuses }
import gunbc.managed_directory { DeclaredDirectoryMode, DirectoryOwnerAllEveryoneTraverse }
import extdeps.posix.identity { PosixOwnerNames }
import extdeps.filesystem.filesystem_io { filesystem_listing_observation, Filesystem, FilesystemDirectoryListed, FilesystemDirectoryListingRefused, FilesystemDirectorySubjectRefused }

// THE INSTALL MEDIA ARTIFACT STORE, sealed on the gunbc side (cohort C-host). The store's records are
// the media files themselves (the fetched ISO and its `.part` staging file), so their paths ARE
// business paths and the seal is over the ROOT the paths are built under. The facts about the media --
// which version, which digest, which mirrors -- stay upstream in
// extdeps.provisioning.ubuntu_install_media, where they belong; only the host's install root lives
// here, because the root is a gunbc host-state fact, not an Ubuntu fact. The extdeps module receives
// the directory; it no longer declares it.

// THE ONE DECLARATION (operator ruling, sealed-store lane): the member the store lives under in the ONE
// host-state tree (gunbc.host_state_root host_state_tree_root), and the mode its directory is created
// with. The mint, the provisioning target and every path derive from THIS data -- no second literal.
// THE MODE IS THE OBSERVED FACT: the directory is created by the fetching handler itself --
// gunbc.url_file_acquisition ensure_url_file_parent runs shell.Mkdir.Parents (mkdir -p) before the
// staged download, at the fetcher's umask 0755 -- so 0755 with the fetcher owning it (the job user on
// srv1, where the actuator runs). DirectoryOwnerAllEveryoneTraverse is exactly 0755.
type InstallMediaSlotsDeclaration { member: NonEmptyStr, mode: DeclaredDirectoryMode }

data install_media_slots: InstallMediaSlotsDeclaration = InstallMediaSlotsDeclaration {
  member: "artifacts" as NonEmptyStr,
  mode: DirectoryOwnerAllEveryoneTraverse,
}

// THE ROOT, DERIVED: the tree's path plus this store's member. Never a literal; only the mint and the
// provisioning target read the declaration.
fn install_media_store_path(tree: HostStateTree) -> NonEmptyStr {
  join([host_state_tree_path(tree: tree) as String, "/", install_media_slots.member as String], "") as NonEmptyStr
}

// THE SEALED STORE (the operator's sealed-store shape): data only, sole_constructor, non-generic, never
// a variant arm (the seal does not reach those: test.claim.sole_constructor_completeness_audit_probe
// f13/f19). Construction is sealed to install_media_store; the rung claimed here is construction only
// (field reads are the declared residual, gunbc.recurring_failure_mode
// a_slot_store_is_built_over_a_literal_path_by_any_module): no forged or wrong-root media store.
type InstallMediaStore sole_constructor {
  root: NonEmptyStr
}

type InstallMediaStoreReading
  = InstallMediaStoreReady { store: InstallMediaStore }
  | InstallMediaStoreUnready { detail: String }

// THE ONE MINT, AND IT TAKES NO PATH: the sealed tree value plus nothing else. It observes the derived
// directory (lists it, the reference mint's route) and refuses when it cannot be listed -- a media store
// that cannot be read must not be mistaken for an empty one, because a wrong-root media store sends
// serve traffic (gunbc.srv3.srv3_serve nbdkit) at a file another principal placed.
fn install_media_store(tree: HostStateTree) -> InstallMediaStoreReading {
  let root = install_media_store_path(tree: tree)
  let listing = Filesystem.List(path: root as String)
  match filesystem_listing_observation(directory: root as String, success: listing.success, entries: listing.entries, error: listing.error) {
    FilesystemDirectorySubjectRefused { directory: _, cause: c } => InstallMediaStoreUnready { detail: join(["the install media store's directory is not admissible: ", c], "") }
    FilesystemDirectoryListingRefused { directory: _, error: e } => InstallMediaStoreUnready { detail: join(["the install media store's directory could not be listed: ", e], "") }
    FilesystemDirectoryListed(_) => InstallMediaStoreReady { store: InstallMediaStore { root: root } }
  }
}

// THE BUSINESS PATHS, over the sealed store. A media file's path is the store's root plus the row's
// cited filename (the upstream module's ubuntu_install_media_filename); a `.part` sibling is the
// staging path of the same file. NO FORMAT CHANGE (operator ruling 1 for a RECORD_DIR store): the
// on-disk bytes and names are exactly what the old root-taking functions produced -- the path the old
// ubuntu_install_media_install_path produced for a row is, byte for byte, the path this pair produces
// for the same row over host_state_tree(), asserted by the readback witness.
fn install_media_install_path(store: InstallMediaStore, filename: NonEmptyStr) -> NonEmptyStr {
  join([store.root as String, "/", filename as String], "") as NonEmptyStr
}

fn install_media_part_path(store: InstallMediaStore, filename: NonEmptyStr) -> NonEmptyStr {
  concat(install_media_install_path(store: store, filename: filename) as String, ".part") as NonEmptyStr
}

// THE STORE ROOT IS A DEMANDED DIRECTORY, derived from the same declaration as the path above. The
// handler that writes media creates the directory itself (mkdir -p before the staged download), so the
// store is self-provisioning in production; this target carries the same declaration for anyone who
// audits or enrolls the tree's children, and the mint above refuses a root that cannot be read.
fn install_media_store_directory(tree: HostStateTree, owner: PosixOwnerNames) -> OwnedDirectoryTarget {
  OwnedDirectoryDeclared {
    member: install_media_slots.member,
    path: install_media_store_path(tree: tree) as String as FilePath,
    owner: owner,
    mode: install_media_slots.mode,
    // The media files here are the images nbdkit serves to booted hosts; a directory another principal
    // left is a foreign subtree and is refused outright -- ownership of a served store is never adopted.
    group_adoption: ForeignOwnershipRefuses,
  }
}
