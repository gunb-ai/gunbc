  [
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "native_intercept:fold_list" }, form: NativeSpecial, authored_spelling: "fold_list", realization_module: "v1_interpreter", dispatch_symbol: "eval_call" },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "native_intercept:fold_list_right" }, form: NativeSpecial, authored_spelling: "fold_list_right", realization_module: "v1_interpreter", dispatch_symbol: "eval_call" },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "map_grounding:empty_map_primitive_delegate" }, form: NativeSpecial, authored_spelling: "empty_map_primitive_delegate", realization_module: "v1_interpreter", dispatch_symbol: "try_v2_std_collection_map_primitive_grounding" },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "map_grounding:empty_map_primitive_delegate" }, form: NativeSpecial, authored_spelling: "empty_map", realization_module: "v1_interpreter", dispatch_symbol: "try_v2_std_collection_map_primitive_grounding" },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "map_grounding:map_insert" }, form: NativeSpecial, authored_spelling: "map_insert", realization_module: "v1_interpreter", dispatch_symbol: "try_v2_std_collection_map_primitive_grounding" },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "parse_table_memo:parse_table_lookup" }, form: NativeSpecial, authored_spelling: "parse_table_lookup", realization_module: "v1_interpreter", dispatch_symbol: "try_parse_table_memo_dispatch" },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "parse_table_memo:parse_table_insert" }, form: NativeSpecial, authored_spelling: "parse_table_insert", realization_module: "v1_interpreter", dispatch_symbol: "try_parse_table_memo_dispatch" },
  ]
}

fn v1_interpreter_service_dispatch_arms() -> List<InterpreterPrimitiveDispatchArm> {
  [
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "service_dispatch:Filesystem.Read" }, form: ServiceDispatch, authored_spelling: "Filesystem.Read", realization_module: "v1_interpreter", dispatch_symbol: "eval_service_call" },
  ]
}

fn v1_interpreter_declared_arms() -> List<InterpreterPrimitiveDispatchArm> {
  v1_interpreter_method_call_arms()
    |> concat(v1_interpreter_native_special_arms())
    |> concat(v1_interpreter_service_dispatch_arms())
}

fn v1_interpreter_primitive_arms() -> List<InterpreterPrimitiveDispatchArm> {
  v1_interpreter_free_call_arms() |> concat(v1_interpreter_declared_arms())
}

fn form_arm_enumeration(form: InterpreterDispatchForm) -> ArmEnumeration {
  match form {
    FreeCall => DerivedFromDispatch
    MethodCall => DeclaredHere
    NativeSpecial => DeclaredHere
    ServiceDispatch => DeclaredHere
  }
}

fn v1_interpreter_derived_arm_count() -> Int { count(v1_interpreter_free_call_arms()) }

fn v1_interpreter_declared_arm_count() -> Int { count(v1_interpreter_declared_arms()) }

fn spelling_arm_identities(rows: List<InterpreterPrimitiveDispatchArm>, spelling: String) -> List<String> {
  rows |> filter(r => r.authored_spelling == spelling) |> map(r => r.arm.identity)
}

fn form_has_no_shadowed_spelling(rows: List<InterpreterPrimitiveDispatchArm>) -> Bool {
  rows |> all(r =>
    count(
      spelling_arm_identities(rows: rows, spelling: r.authored_spelling)
        |> filter(id => id != r.arm.identity)) == 0)
}

fn shadowed_spellings(rows: List<InterpreterPrimitiveDispatchArm>) -> List<String> {
  rows
    |> filter(r =>
      count(
        spelling_arm_identities(rows: rows, spelling: r.authored_spelling)
          |> filter(id => id != r.arm.identity)) > 0)
    |> map(r => r.authored_spelling)
}

fn v1_interpreter_cross_form_spellings() -> List<String> {
  let rows = v1_interpreter_primitive_arms()
  rows
    |> filter(r =>
      count(rows |> filter(o => o.authored_spelling == r.authored_spelling && o.form != r.form)) > 0)
    |> map(r => r.authored_spelling)
}

data arm_accepted_shape_gap_note: String = "ARITY IS NOT DERIVABLE FROM THIS DISPATCH, and ArmAcceptedShape is a coproduct rather than an Int so that the gap is representable instead of guessed. Arm bodies reach for positional.first(), positional.as_slice() patterns, and byte-vector coercions, so nothing structural in the arm states how many arguments it accepts. Any number written here would be a hand transcription that rots silently the first time a body changes, which is the decorative-roster failure this carrier exists to avoid. A typed absence is countable; a fabricated arity is not. DISSOLVE-ON: the R1 step where the v1_builtin_arms arm list carries an explicit parameter spec beside each body, at which point arity expands from the same tokens as the spelling and this type gains real inhabitants."

data derived_versus_declared_note: String = "WHICH ROWS ARE REAL BY CONSTRUCTION. v1_interpreter_free_call_arms is DERIVED: it projects interpreter_free_call_arm_rows, which expands from the same macro tokens as the dispatch itself, so adding an arm without a row and adding a row without an arm are both unwritable. v1_interpreter_method_call_arms, v1_interpreter_native_special_arms and v1_interpreter_service_dispatch_arms are DECLARED by hand and can go stale; they are counted separately by v1_interpreter_declared_arm_count so the frontier is a number rather than an impression. DISSOLVE-ON, per block: apply the v1_builtin_arms macro shape to eval_algebra_method_inner first (its arms are uniform string literals today, so it is the same mechanical transformation that already succeeded on eval_builtin_inner), then to eval_call, try_v2_std_collection_map_primitive_grounding and try_parse_table_memo_dispatch; delete each declared block as its projection lands. The Filesystem.Read row stays declared until the hermetic checkout carve-out itself dissolves."

data shadowed_spelling_semantics_note: String = "WHAT form_has_no_shadowed_spelling ACTUALLY DECIDES. A spelling reached by more than one ARM IDENTITY within a single form is unreachable code, because the earlier arm always wins the match. Alias spellings are deliberately NOT this: they share one arm identity, which is precisely why length, count and size cannot disagree with each other. A spelling appearing under two different FORMS is a third thing again and is not a defect at all -- it is two genuine implementations of one name, which v1_interpreter_cross_form_spellings derives and a primitive-identity join must reconcile rather than assume away. lookup is the live specimen."
