module gunbc.v1_interpreter_primitive_surface

import std.types { NonEmptyStr }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string }
import std.dissolution { DissolutionCondition, unbound_dissolution, dissolution_description }

data v1_interpreter_source_path: String = "src/v1/stage0/src/v1_interpreter.rs"

type InterpreterDispatchForm
  = FreeCall
  | MethodCall
  | ServiceDispatch
  | NativeSpecial
  | UnknownForm { label: NonEmptyStr }

type InterpreterPrimitiveArmId {
  identity: NonEmptyStr
}

type ArmEnumeration
  = AuthoredInRoster
  | DeclaredHere { dissolution: DissolutionCondition }

type InterpreterDispatchEmitSite
  = EvalBuiltinInnerSite
  | EvalAlgebraMethodInnerSite
  | EvalCallBridgeFamilySite { module: QualifiedName }
  | EvalCallNativeInterceptSite
  | TryV2StdCollectionMapPrimitiveGroundingSite
  | TryParseTableMemoDispatchSite
  | EvalMethodCallShortCircuitSite
  | EvalServiceCallCarveOutSite

type InterpreterPrimitiveDispatchArm {
  arm: InterpreterPrimitiveArmId
  form: InterpreterDispatchForm
  authored_spelling: NonEmptyStr
  realization_module: NonEmptyStr
  dispatch_symbol: NonEmptyStr
  dispatch_emit_site: InterpreterDispatchEmitSite
  enumeration: ArmEnumeration
}

data dispatch_emit_site_authority_note: String = "dispatch_emit_site REPLACES prefix-convention site routing. Each row names its own emit site directly, closed over InterpreterDispatchEmitSite; EvalCallBridgeFamilySite carries the bridge family's own module so gunbc.v1_interpreter_dispatch_emit can key one generated enum per family instead of one shared enum spanning all v4 bridge families. This is the dissolve-on the prior dispatch_emit_site_routing_scaffold_note named: the field now exists, so starts_with(v4_bridge.)/starts_with(native_intercept.) string-prefix parsing and the parallel known_dispatch_emit_site_keys validator delete in favor of reading this field directly."

data eval_call_bridge_family_module_typing_note: String = "EvalCallBridgeFamilySite.module is v2.std.qualified_name.QualifiedName, not a bare NonEmptyStr (operator correction, PR 7801, 2026-08-04). A raw string field on an otherwise closed coproduct was the same convention-over-construction defect the coproduct itself replaced -- a spelling routing key instead of an exact, resolvable module identity. QualifiedName is the corpus's single module-identity authority (std.observation's dissolve-on names it as the eventual home for module_path); every construction site builds it with qualified_name_from_dotted_string rather than an inline string literal, and gunbc.v1_interpreter_dispatch_emit reads it back through qualified_name_to_dotted_string at the one site that still needs the dotted form for Rust-identifier derivation."

type ShapeDerivability
  = ShapeNotDerivableFromDispatch
  | ShapeDerivedFromDispatch

fn v1_interpreter_arm_shape_derivability() -> ShapeDerivability {
  ShapeNotDerivableFromDispatch
}

fn decode_dispatch_form(label: String) -> InterpreterDispatchForm {
  match label {
    "FreeCall" => FreeCall
    "MethodCall" => MethodCall
    "NativeSpecial" => NativeSpecial
    "ServiceDispatch" => ServiceDispatch
    _ => UnknownForm { label: label }
  }
}

fn form_is_unknown(form: InterpreterDispatchForm) -> Bool {
  match form {
    UnknownForm { label: _ } => true
    FreeCall => false
    MethodCall => false
    NativeSpecial => false
    ServiceDispatch => false
  }
}

fn v1_interpreter_free_call_arms() -> List<InterpreterPrimitiveDispatchArm> {
  v1_interpreter_authored_roster_arms() |> filter(r => r.form == FreeCall)
}

fn v1_interpreter_method_call_arms() -> List<InterpreterPrimitiveDispatchArm> {
  v1_interpreter_authored_roster_arms() |> filter(r => r.form == MethodCall)
}

fn v1_interpreter_unknown_form_arms() -> List<InterpreterPrimitiveDispatchArm> {
  v1_interpreter_authored_roster_arms() |> filter(r => form_is_unknown(form: r.form))
}

fn v1_interpreter_declared_arms() -> List<InterpreterPrimitiveDispatchArm> {
  [
    InterpreterPrimitiveDispatchArm {
      arm: InterpreterPrimitiveArmId { identity: "method_call_short_circuit.lookup" },
      form: MethodCall,
      authored_spelling: "lookup",
      realization_module: "v1_interpreter",
      dispatch_symbol: "eval_method_call",
      dispatch_emit_site: EvalMethodCallShortCircuitSite,
      enumeration: DeclaredHere { dissolution: unbound_dissolution(description: "eval_method_call's lookup short-circuit is an if-guard rather than a match arm, so it has no token authority to expand from. It dissolves when the short-circuit is either deleted in favour of the algebra arm it shadows, or rewritten as an arm of a v1_method_short_circuit_arms macro in the shape the other five sites now use.") },
    },
    InterpreterPrimitiveDispatchArm {
      arm: InterpreterPrimitiveArmId { identity: "service_dispatch.Filesystem.Read" },
      form: ServiceDispatch,
      authored_spelling: "Filesystem.Read",
      realization_module: "v1_interpreter",
      dispatch_symbol: "eval_service_call",
      dispatch_emit_site: EvalServiceCallCarveOutSite,
      enumeration: DeclaredHere { dissolution: unbound_dissolution(description: "the hermetic checkout carve-out in eval_service_call is the interpreter's only service-name dispatch of its own; every other service operation resolves against ctx.service_ops from the declared .dag corpus. This row dissolves when the carve-out does.") },
    },
  ]
}

fn arm_is_declared_here(arm: InterpreterPrimitiveDispatchArm) -> Bool {
  match arm.enumeration {
    DeclaredHere { dissolution: _ } => true
    AuthoredInRoster => false
  }
}

// Restored with the field. The predecessor scanned the sentence for the phrase
// "dissolves when", which is a text check over prose; nonemptiness of the typed
// condition is what is actually decidable here, and the roster acceptance test
// asserts it so the contract note above is enforced rather than merely stated.
fn arm_declares_dissolution_trigger(arm: InterpreterPrimitiveDispatchArm) -> Bool {
  match arm.enumeration {
    DeclaredHere { dissolution: d } => !(dissolution_description(condition: d) == "")
    AuthoredInRoster => false
  }
}

fn v1_interpreter_primitive_arms() -> List<InterpreterPrimitiveDispatchArm> {
  v1_interpreter_authored_roster_arms() |> concat(v1_interpreter_declared_arms())
}

fn distinct_strings(xs: List<String>) -> List<String> {
  xs |> fold(init: [], f: (acc, x) => if acc |> any(y => y == x) { acc } else { acc |> concat([x]) })
}

fn v1_interpreter_derived_arm_count() -> Int {
  count(v1_interpreter_authored_roster_arms())
}

fn v1_interpreter_declared_arm_count() -> Int {
  count(v1_interpreter_declared_arms())
}

fn v1_interpreter_row_count() -> Int {
  count(v1_interpreter_primitive_arms())
}

fn dispatch_site_count() -> Int {
  count(distinct_strings(xs: v1_interpreter_primitive_arms() |> map(r => r.dispatch_symbol)))
}

fn distinct_arm_identity_count() -> Int {
  count(distinct_strings(xs: v1_interpreter_primitive_arms() |> map(r => r.arm.identity)))
}

fn authored_spelling_count() -> Int {
  count(distinct_strings(xs: v1_interpreter_primitive_arms() |> map(r => r.authored_spelling)))
}

fn spelling_arm_identities(rows: List<InterpreterPrimitiveDispatchArm>, spelling: String) -> List<String> {
  rows |> filter(r => r.authored_spelling == spelling) |> map(r => r.arm.identity)
}

fn form_has_no_shadowed_spelling(rows: List<InterpreterPrimitiveDispatchArm>) -> Bool {
  rows |> all(r =>
    count(
      spelling_arm_identities(rows: rows, spelling: r.authored_spelling)
        |> filter(id => id != r.arm.identity)) == 0)
}

fn shadowed_spellings(rows: List<InterpreterPrimitiveDispatchArm>) -> List<String> {
  let shadowed = rows
    |> filter(r =>
      count(
        spelling_arm_identities(rows: rows, spelling: r.authored_spelling)
          |> filter(id => id != r.arm.identity)) > 0)
    |> map(r => r.authored_spelling)
  distinct_strings(xs: shadowed)
}

fn row_key(row: InterpreterPrimitiveDispatchArm) -> String {
  row.dispatch_symbol
    |> concat(":")
    |> concat(row.arm.identity)
    |> concat(":")
    |> concat(row.authored_spelling)
}

fn duplicate_row_keys(rows: List<InterpreterPrimitiveDispatchArm>) -> List<String> {
  let dupes = rows
    |> filter(r =>
      count(rows |> filter(o =>
        o.authored_spelling == r.authored_spelling
          && o.arm.identity == r.arm.identity
          && o.dispatch_symbol == r.dispatch_symbol)) > 1)
    |> map(r => row_key(row: r))
  distinct_strings(xs: dupes)
}

fn v1_interpreter_cross_form_spellings() -> List<String> {
  let rows = v1_interpreter_primitive_arms()
  let cross = rows
    |> filter(r =>
      count(rows |> filter(o => o.authored_spelling == r.authored_spelling && o.form != r.form)) > 0)
    |> map(r => r.authored_spelling)
  distinct_strings(xs: cross)
}

data v1_interpreter_primitive_surface_authority_note: String = "THE V1 INTERPRETER'S PRIMITIVE DISPATCH SURFACE, MADE ENUMERABLE. Before this carrier the surface had no roster anywhere: its only authority was string match arms inside the hand-maintained seed src/v1/stage0/src/v1_interpreter.rs, so 'which primitives does the interpreter provide' was a question no consumer could ask. That is why it was the fifth surface the primitive-identity census could not read, and why v1 deletion could not be sequenced honestly: you cannot show that nothing still needs a capability you cannot enumerate.\n\nTHE SURFACE IS A CLOSED SET OF DISPATCH SYMBOLS. Measured against the tree rather than assumed: eval_builtin_inner; eval_algebra_method_inner; eval_call, which carries TWO separate mechanisms -- guard-predicated v4 std bridge families AND a native fold intercept -- both running BEFORE the free-call dispatch, which is why fold_list and the bridge names never reach the builtin registry; try_v2_std_collection_map_primitive_grounding; try_parse_table_memo_dispatch; a lookup short-circuit inside eval_method_call; and the Filesystem.Read hermetic carve-out in eval_service_call. dispatch_site_count() derives the site count from the roster rather than restating it in prose. AN EARLIER REVISION UNDERCOUNTED eval_call by modelling it as the fold intercept alone, omitting the bridge spellings; the omission was caught in review, and it is recorded here rather than quietly corrected because it is the precise failure this carrier exists to prevent -- a denominator asserted from the sites someone happened to read.\n\nR1 INVERTS THE ROSTER: v1_interpreter_authored_roster_arms() is the canonical authority; gunbc.v1_interpreter_dispatch_emit derives Rust enum variants and spelling-to-variant lookup tables into src/v1/stage0/src/v1_interpreter_dispatch_generated.rs (drift-gated via gunbc.generated_artifact V1InterpreterDispatchGeneratedRsArtifact). Handler macros in v1_interpreter.rs consult the generated lookup before matching bodies on the generated enum. Exhaustiveness is site-scoped: on single-family sites (eval_builtin_inner, eval_algebra_method_inner, try_v2_std_collection_map_primitive_grounding, try_parse_table_memo_dispatch) a roster row without a handler body fails cargo build via a non-exhaustive inner match on the generated enum; on eval_call_bridge and eval_call_native_intercept — shared enums with per-family macro subsets — the same mismatch degrades to runtime unreachable! until per-family enum split lands (named follow-up). A handler identity absent from the roster cannot be reached through generated lookup without editing the roster (DESIGN.md 5, construction over validation). No live-tree scan of Rust source is involved and none is wanted.\n\nTHE RESIDUE IS CHECKABLE, WHICH IS THE POINT. Every primitive handler macro arm carries the token form `arm \"identity\" { \"spelling\" } =>` keyed to the generated enum; routing uses the generated lookup, not the macro spelling literals. What remains in the file as a BARE quoted match arm is non-primitive dispatch: pattern kinds, shell/file output channels, auth kinds, TLS postures, HTTP methods, and similar transport and value vocabulary -- not primitive names. So 'is there an unenumerated primitive arm' is answerable by looking for a bare quoted arm outside that named list.\n\nSERVICE OPERATIONS ARE NOT ARMS, and that is a finding rather than an omission. eval_service_call resolves Service.Op against ctx.service_ops, which is built from the DECLARED .dag corpus, so that population is already enumerable as data and is deliberately outside this roster's denominator. The interpreter contributes exactly one service-name dispatch of its own -- the Filesystem.Read hermetic checkout carve-out -- plus transport realizations, which dispatch on transport and HTTP method values rather than on primitive names. Only the carve-out is a row here.\n\nROWS CARRY THE ARM'S OWN FACTS ONLY. There is deliberately no primitive-identity field, not even an optional one: an arm that joins to no known primitive must remain representable, because that population is exactly what a primitive-identity join needs to discover. A roster whose shape forbade recording an unjoined arm would be complete by construction and useless as a denominator. This carrier answers WHICH ARMS EXIST; which primitive each one realizes belongs to the join.\n\nONE ROW PER (SITE, ARM IDENTITY, SPELLING); ALIASES SHARE AN ARM IDENTITY. length, count and size are one arm under three rows, so they cannot disagree by construction. duplicate_row_keys asserts that triple is unique across the whole surface. A spelling appearing under two different arm identities at the SAME site is unreachable code, because the earlier arm always wins. A spelling appearing at two different SITES is two genuine implementations: lookup is the live specimen, dispatched both by the eval_method_call short-circuit and by the algebra arm the short-circuit shadows."

data arm_accepted_shape_gap_note: String = "ARITY IS NOT DERIVABLE FROM THIS DISPATCH, and ShapeDerivability is a coproduct rather than an Int so that the gap is representable instead of guessed. Arm bodies reach for positional.first(), positional.as_slice() patterns, and byte-vector coercions, so nothing structural in the arm states how many arguments it accepts. Any number written here would be a hand transcription that rots silently the first time a body changes, which is the decorative-roster failure this carrier exists to avoid. A typed absence is countable; a fabricated arity is not. DISSOLVE-ON: the R1 step where each arm list carries an explicit parameter spec beside each body, at which point arity expands from the same tokens as the spelling and ShapeDerivedFromDispatch becomes the honest answer."

data derived_versus_declared_note: String = "WHICH ROWS ARE REAL BY CONSTRUCTION, AND WHY PROVENANCE SITS ON THE ROW RATHER THAN ON THE FORM. Enumeration provenance is a fact about how a PARTICULAR row was obtained, not about its dispatch form. After R1, every row is AuthoredInRoster: authored once in v1_interpreter_authored_roster_arms() and routed through generated lookup in v1_interpreter_dispatch_generated.rs. The two DeclaredHere rows remain the frontier sites that are not match arms at all: eval_method_call's lookup short-circuit is an if-guard, and eval_service_call's Filesystem.Read carve-out dispatches on a service name. An earlier revision derived provenance from the form, which would have reported the short-circuit row as derived and hidden exactly the staleness the field exists to expose. So ArmEnumeration is a field, DeclaredHere carries the row's OWN dissolution trigger, and v1_interpreter_declared_arm_count counts the frontier rather than describing it.\n\nDerivedFromDispatch RETIRED (R1 closeout item SEVEN): the pre-R1 derivation model it marked is fully gone, so the variant is deleted from ArmEnumeration rather than left uninhabited -- the invalid state 'a row claims to be derived-from-dispatch-form rather than authored or declared' now has no constructor at all, climbing from a witness RED control to structurally impossible (DESIGN.md 4b). The evidence that stays enrolled and executing is roster_rows_are_authored_in_roster_not_transcribed_from_rust in test.claim.v1_interpreter_primitive_dispatch_authority_acceptance (every authored-roster row's enumeration equals AuthoredInRoster) and declared_residual_rows_retain_independent_dispositions (every declared row's enumeration is DeclaredHere with its own trigger) -- together an exhaustive positive control over the two remaining variants, not a lower-rung production check left beside a higher one.\n\nEach DeclaredHere row states what would have to change for it to dissolve via its dissolve_on field. Absence from a declared row is NOT evidence that an arm does not exist."

data shadowed_spelling_semantics_note: String = "WHAT form_has_no_shadowed_spelling ACTUALLY DECIDES. A spelling reached by more than one ARM IDENTITY within one dispatch site is unreachable code, because the earlier arm always wins the match. Alias spellings are deliberately NOT this: they share one arm identity, which is precisely why length, count and size cannot disagree with each other. A spelling appearing at two different SITES is a third thing again and is not a defect at all -- it is two genuine implementations of one name, which v1_interpreter_cross_form_spellings derives and a primitive-identity join must reconcile rather than assume away. lookup, map_insert and empty_map are load-bearing cross-site specimens. Two shadows are live and both are recorded as exact expectations rather than tolerated: the two inert-lens bridges shadow their eval_builtin_inner namesakes, and method_call_short_circuit.lookup shadows method_call.lookup. Those witnesses assert an exact set, so a NEW shadow reds this file."

data v1_interpreter_authored_roster_note: String = "CANONICAL R1 AUTHORITY for interpreter dispatch arms. Each row is authored once as InterpreterPrimitiveDispatchArm in v1_interpreter_authored_roster_arms(); v1_interpreter_dispatch_emit derives Rust enum variant names from arm identity and generates lookup tables. Handler bodies remain hand Rust behind an exhaustive match. Bootstrapped from the live interpreter macro census on 2026-08-02; ongoing edits are manual at this carrier, not regenerated from Rust."


