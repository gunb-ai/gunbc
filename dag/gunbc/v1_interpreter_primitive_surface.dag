-- DECLARED. Same trigger, applied to the three small dispatches.
fn v1_interpreter_native_special_arms() -> List<InterpreterPrimitiveDispatchArm> {
  [
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "native_intercept:fold_list" }, form: NativeSpecial, authored_spelling: "fold_list", realization_module: "v1_interpreter", dispatch_symbol: "eval_call", accepted_shape: ShapeNotDerivableFromDispatch },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "native_intercept:fold_list_right" }, form: NativeSpecial, authored_spelling: "fold_list_right", realization_module: "v1_interpreter", dispatch_symbol: "eval_call", accepted_shape: ShapeNotDerivableFromDispatch },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "map_grounding:empty_map_primitive_delegate" }, form: NativeSpecial, authored_spelling: "empty_map_primitive_delegate", realization_module: "v1_interpreter", dispatch_symbol: "try_v2_std_collection_map_primitive_grounding", accepted_shape: ShapeNotDerivableFromDispatch },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "map_grounding:empty_map_primitive_delegate" }, form: NativeSpecial, authored_spelling: "empty_map", realization_module: "v1_interpreter", dispatch_symbol: "try_v2_std_collection_map_primitive_grounding", accepted_shape: ShapeNotDerivableFromDispatch },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "map_grounding:map_insert" }, form: NativeSpecial, authored_spelling: "map_insert", realization_module: "v1_interpreter", dispatch_symbol: "try_v2_std_collection_map_primitive_grounding", accepted_shape: ShapeNotDerivableFromDispatch },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "parse_table_memo:parse_table_lookup" }, form: NativeSpecial, authored_spelling: "parse_table_lookup", realization_module: "v1_interpreter", dispatch_symbol: "try_parse_table_memo_dispatch", accepted_shape: ShapeNotDerivableFromDispatch },
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "parse_table_memo:parse_table_insert" }, form: NativeSpecial, authored_spelling: "parse_table_insert", realization_module: "v1_interpreter", dispatch_symbol: "try_parse_table_memo_dispatch", accepted_shape: ShapeNotDerivableFromDispatch },
  ]
}

-- DECLARED, and the only service-name dispatch the interpreter owns. Every other
-- Service.Op resolves against declared .dag rows, so it is enumerable there and is
-- deliberately not duplicated into this roster.
fn v1_interpreter_service_dispatch_arms() -> List<InterpreterPrimitiveDispatchArm> {
  [
    InterpreterPrimitiveDispatchArm { arm: InterpreterPrimitiveArmId { identity: "service_dispatch:Filesystem.Read" }, form: ServiceDispatch, authored_spelling: "Filesystem.Read", realization_module: "v1_interpreter", dispatch_symbol: "eval_service_call", accepted_shape: ShapeNotDerivableFromDispatch },
  ]
}

fn v1_interpreter_declared_arms() -> List<InterpreterPrimitiveDispatchArm> {
  list_concat(
    v1_interpreter_method_call_arms(),
    list_concat(v1_interpreter_native_special_arms(), v1_interpreter_service_dispatch_arms()))
}

fn v1_interpreter_primitive_arms() -> List<InterpreterPrimitiveDispatchArm> {
  list_concat(v1_interpreter_free_call_arms(), v1_interpreter_declared_arms())
}

fn form_arm_enumeration(form: InterpreterDispatchForm) -> ArmEnumeration {
  match form {
    FreeCall => DerivedFromDispatch
    MethodCall => DeclaredHere
    NativeSpecial => DeclaredHere
    ServiceDispatch => DeclaredHere
  }
}

fn v1_interpreter_derived_arm_count() -> Int { count(v1_interpreter_free_call_arms()) }

fn v1_interpreter_declared_arm_count() -> Int { count(v1_interpreter_declared_arms()) }

fn spelling_arm_identities(rows: List<InterpreterPrimitiveDispatchArm>, spelling: String) -> List<String> {
  rows |> filter(r => r.authored_spelling == spelling) |> map(r => r.arm.identity)
}

-- A spelling reached by more than one ARM inside one form is unreachable code:
-- the earlier arm always wins. Aliases are NOT this, because aliases share an arm
-- identity. This is the check that can fail.
fn form_has_no_shadowed_spelling(rows: List<InterpreterPrimitiveDispatchArm>) -> Bool {
  rows |> all(r =>
    count(
      spelling_arm_identities(rows: rows, spelling: r.authored_spelling)
        |> filter(id => id != r.arm.identity)) == 0)
}

fn shadowed_spellings(rows: List<InterpreterPrimitiveDispatchArm>) -> List<String> {
  rows
    |> filter(r =>
      count(
        spelling_arm_identities(rows: rows, spelling: r.authored_spelling)
          |> filter(id => id != r.arm.identity)) > 0)
    |> map(r => r.authored_spelling)
}

-- Spellings implemented under more than one FORM. Not a defect: two genuine
-- implementations of one name, which a primitive-identity join has to reconcile
-- rather than assume away.
fn v1_interpreter_cross_form_spellings() -> List<String> {
  let rows = v1_interpreter_primitive_arms()
  rows
    |> filter(r =>
      count(rows |> filter(o => o.authored_spelling == r.authored_spelling && o.form != r.form)) > 0)
    |> map(r => r.authored_spelling)
}
