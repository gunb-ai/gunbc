module gunbc.runner_connectivity_repair_plan


data runner_repair_effect_authority_note: String = "REPAIR CHOREOGRAPHY over the shared HostEffect arms still-ram-738 lands on gunbc.host_effect — NOT a second effect coproduct. RunnerRepairEffectStep names the operator-specified arms (ObserveRunnerLocalState, ObserveGitHubRunnerRegistration, ReplaceRunnerIncarnation) in apply order. This module sequences them; host_effect_realize owns realization cells. ctrl is dead — no script delegation."

data observe_runner_local_state_host_effect_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "ObserveRunnerLocalState",
    field: std.decl_ref.WholeDeclaration,
  }
}

data observe_github_runner_registration_host_effect_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "ObserveGitHubRunnerRegistration",
    field: std.decl_ref.WholeDeclaration,
  }
}

data replace_runner_incarnation_host_effect_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "ReplaceRunnerIncarnation",
    field: std.decl_ref.WholeDeclaration,
  }
}

data runner_jit_installation_token_cache_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.runner_lifecycle",
    decl_name: "EnsureRunnerJitWrapper",
    field: std.decl_ref.WholeDeclaration,
  }
}

data runner_jit_installation_token_cache_note: String = "LIMIT FANOUT (operator ruling 2026-08-06): cache GitHub JIT installation tokens until near expiry rather than minting a fresh token on every two-minute watchdog tick across every host. Realization lives with EnsureRunnerJitWrapper in gunbc.runner_lifecycle — this repair plan names the choreography only."

type RunnerRepairEffectStep
  = ObserveRunnerLocalState { slot: gunbc.build_cache_instance.RunnerSlotIdentity }
  | ObserveGitHubRunnerRegistration { slot: gunbc.build_cache_instance.RunnerSlotIdentity }
  | ReplaceRunnerIncarnation {
      slot: gunbc.build_cache_instance.RunnerSlotIdentity,
      from: gunbc.runner_connectivity_recovery.RunnerLocalIncarnation,
      unit: std.types.NonEmptyStr,
    }

type RunnerRepairApplyPlan
  = RepairNoop { reason: std.types.NonEmptyStr }
  | RepairRefusedPlan { slot: gunbc.build_cache_instance.RunnerSlotIdentity, reason: std.types.NonEmptyStr }
  | RepairExecute { slot: gunbc.build_cache_instance.RunnerSlotIdentity, steps: List<RunnerRepairEffectStep> }

fn repair_effect_step_count(steps: List<RunnerRepairEffectStep>) -> Int {
  std.types.list_length(items: steps)
}

fn replace_repair_steps(
  slot: gunbc.build_cache_instance.RunnerSlotIdentity,
  from: gunbc.runner_connectivity_recovery.RunnerLocalIncarnation,
) -> List<RunnerRepairEffectStep> {
  let unit = gunbc.runner_connectivity_recovery.recovery_runner_slot_unit_name(slot: slot)
  [
    ObserveRunnerLocalState { slot: slot },
    ObserveGitHubRunnerRegistration { slot: slot },
    ReplaceRunnerIncarnation { slot: slot, from: from, unit: unit },
    ObserveRunnerLocalState { slot: slot },
    ObserveGitHubRunnerRegistration { slot: slot },
  ]
}

fn project_connectivity_action_to_repair_plan(
  action: gunbc.runner_connectivity_recovery.RunnerConnectivityAction,
) -> RunnerRepairApplyPlan {
  match action {
    gunbc.runner_connectivity_recovery.RunnerConnectedNoop { local: _, remote: _ } =>
      RepairNoop { reason: "local and remote registration agree; no repair steps" as std.types.NonEmptyStr }
    gunbc.runner_connectivity_recovery.RunnerIncarnationReplace { slot: slot, from: from, cause: _ } =>
      RepairExecute {
        slot: slot,
        steps: replace_repair_steps(slot: slot, from: from),
      }
    gunbc.runner_connectivity_recovery.RunnerRepairRefused { slot: slot, cause: _ } =>
      RepairRefusedPlan {
        slot: slot,
        reason: "connectivity controller refused repair before actuation" as std.types.NonEmptyStr,
      }
  }
}

fn repair_plan_is_execute(plan: RunnerRepairApplyPlan) -> Bool {
  match plan {
    RepairExecute { slot: _, steps: _ } => true
    RepairNoop { reason: _ } => false
    RepairRefusedPlan { slot: _, reason: _ } => false
  }
}

fn repair_execute_step_count(plan: RunnerRepairApplyPlan) -> Int {
  match plan {
    RepairExecute { slot: _, steps: steps } => repair_effect_step_count(steps: steps)
    RepairNoop { reason: _ } => 0
    RepairRefusedPlan { slot: _, reason: _ } => 0
  }
}
