module gunbc.os_install_claim_evidence


type OsInstallEvidenceClaim = std.claim_evidence.Claim<product.placement_supply.HostIdentity, product.placement_supply.HostIdentity, gunbc.os_install_deduction.OsInstallRuntimeDiagnosticVerdict, gunbc.os_install_deduction.OsInstallPreflightVerdict, std.types.RunKey>

type OsInstallEvidenceLink = std.claim_evidence.EvidenceLink<gunbc.os_install_deduction.KvmOperatorAttestation, OsInstallEvidenceClaim, std.types.NonEmptyStr, gunbc.os_install_deduction.KvmObservedScreen, gunbc.readback_independence.ReadBackProbe>

type OsInstallEvidenceInference = std.claim_evidence.EvidenceInference<gunbc.os_install_deduction.KvmOperatorAttestation, OsInstallEvidenceClaim, std.types.NonEmptyStr, gunbc.os_install_deduction.KvmObservedScreen, gunbc.readback_independence.ReadBackProbe>

data os_install_kvm_observation_probe: gunbc.readback_independence.ReadBackProbe = gunbc.readback_independence.ReadBackProbe {
  label: "operator-attested KVM screen",
  subject: "one host's visible runtime screen",
  effect_on_subject: ProbeInert,
}

fn os_install_runtime_diagnostic_claim(
  target: product.placement_supply.HostIdentity,
  proposition: gunbc.os_install_deduction.OsInstallRuntimeDiagnosticVerdict,
  preflight: gunbc.os_install_deduction.OsInstallPreflightVerdict,
  bound: std.types.RunKey,
) -> OsInstallEvidenceClaim {
  std.claim_evidence.Claim {
    id: "os-install-runtime-diagnostic",
    subject: target,
    target: target,
    proposition: proposition,
    scope: preflight,
    bound: bound,
  }
}

fn os_install_boot_suggestion_claim(
  target: product.placement_supply.HostIdentity,
  preflight: gunbc.os_install_deduction.OsInstallPreflightVerdict,
  bound: std.types.RunKey,
) -> OsInstallEvidenceClaim {
  os_install_runtime_diagnostic_claim(
    target: target,
    proposition: KvmSuggestsOsBooted,
    preflight: preflight,
    bound: bound,
  )
}

fn os_install_completed_claim(
  target: product.placement_supply.HostIdentity,
  preflight: gunbc.os_install_deduction.OsInstallPreflightVerdict,
  bound: std.types.RunKey,
) -> OsInstallEvidenceClaim {
  os_install_runtime_diagnostic_claim(
    target: target,
    proposition: RuntimeOsInstalled,
    preflight: preflight,
    bound: bound,
  )
}

fn os_install_kvm_attestation_inference(
  fact_id: std.claim_evidence.RecordedFactId,
  attestation: gunbc.os_install_deduction.KvmOperatorAttestation,
  preflight: gunbc.os_install_deduction.OsInstallPreflightVerdict,
  bound: std.types.RunKey,
) -> OsInstallEvidenceInference {
  let proposition = runtime_verdict_from_kvm_attestation(
    attestation: attestation,
    preflight: preflight,
  )
  let claim = os_install_runtime_diagnostic_claim(
    target: attestation.target,
    proposition: proposition,
    preflight: preflight,
    bound: bound,
  )
  infer_probe_evidence(
    fact: std.claim_evidence.RecordedFact {
      id: fact_id,
      value: attestation,
    },
    direction: EvidenceSupports,
    inference_rule: "kvm-screen-supports-runtime-diagnostic-only",
    authority: attestation.attested_by,
    provenance: std.claim_evidence.EvidenceProvenance {
      entity: "operator-kvm-attestation",
      activity: "operator-observed-kvm-screen",
      agent: attestation.attested_by as std.claim_evidence.ProvAgentId,
    },
    freshness: std.claim_evidence.EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "attestation is retained inside the named install attempt",
    },
    fidelity: std.claim_evidence.EvidenceFidelity {
      boundary: attestation.observed_screen,
      losses: [
        "a visible login prompt suggests boot state but does not prove install completion",
      ],
    },
    probe: os_install_kvm_observation_probe,
  )
}

data os_install_claim_evidence_humility_note: std.types.NonEmptyStr = "The existing OS-install deduction fold classifies an operator-attested screen. Its claim link supports only that exact runtime diagnostic under the named preflight and attempt bound; a login prompt cannot promote RuntimeOsInstalled."
