module gunbc.os_install_claim_evidence

import std.types { NonEmptyStr, RunKey }
import std.claim_evidence {
  RecordedFactId,
  RecordedFact,
  Claim,
  EvidenceProvenance,
  ProvAgentId,
  EvidenceFreshness,
  EvidenceFidelity,
  EvidenceSupports,
  EvidenceLink,
  EvidenceInference,
}
import gunbc.os_install_deduction {
  OsInstallPreflightVerdict,
  OsInstallRuntimeDiagnosticVerdict,
  KvmOperatorAttestation,
  KvmObservedScreen,
  KvmSuggestsOsBooted,
  RuntimeOsInstalled,
  runtime_verdict_from_kvm_attestation,
}
import product.placement_supply { HostIdentity }
import gunbc.readback_independence {
  ReadBackProbe,
  ProbeInert,
}
import gunbc.claim_evidence_probe_rule { infer_probe_evidence }

type OsInstallEvidenceClaim = Claim<HostIdentity, HostIdentity, OsInstallRuntimeDiagnosticVerdict, OsInstallPreflightVerdict, RunKey>

type OsInstallEvidenceLink = EvidenceLink<KvmOperatorAttestation, OsInstallEvidenceClaim, NonEmptyStr, KvmObservedScreen, ReadBackProbe>

type OsInstallEvidenceInference = EvidenceInference<KvmOperatorAttestation, OsInstallEvidenceClaim, NonEmptyStr, KvmObservedScreen, ReadBackProbe>

data os_install_kvm_observation_probe: ReadBackProbe = ReadBackProbe {
  label: "operator-attested KVM screen",
  subject: "one host's visible runtime screen",
  effect_on_subject: ProbeInert,
}

fn os_install_runtime_diagnostic_claim(
  target: HostIdentity,
  proposition: OsInstallRuntimeDiagnosticVerdict,
  preflight: OsInstallPreflightVerdict,
  bound: RunKey,
) -> OsInstallEvidenceClaim {
  Claim {
    id: "os-install-runtime-diagnostic",
    subject: target,
    target: target,
    proposition: proposition,
    scope: preflight,
    bound: bound,
  }
}

fn os_install_boot_suggestion_claim(
  target: HostIdentity,
  preflight: OsInstallPreflightVerdict,
  bound: RunKey,
) -> OsInstallEvidenceClaim {
  os_install_runtime_diagnostic_claim(
    target: target,
    proposition: KvmSuggestsOsBooted,
    preflight: preflight,
    bound: bound,
  )
}

fn os_install_completed_claim(
  target: HostIdentity,
  preflight: OsInstallPreflightVerdict,
  bound: RunKey,
) -> OsInstallEvidenceClaim {
  os_install_runtime_diagnostic_claim(
    target: target,
    proposition: RuntimeOsInstalled,
    preflight: preflight,
    bound: bound,
  )
}

fn os_install_kvm_attestation_inference(
  fact_id: RecordedFactId,
  attestation: KvmOperatorAttestation,
  preflight: OsInstallPreflightVerdict,
  bound: RunKey,
) -> OsInstallEvidenceInference {
  let proposition = runtime_verdict_from_kvm_attestation(
    attestation: attestation,
    preflight: preflight,
  )
  let claim = os_install_runtime_diagnostic_claim(
    target: attestation.target,
    proposition: proposition,
    preflight: preflight,
    bound: bound,
  )
  infer_probe_evidence(
    fact: RecordedFact {
      id: fact_id,
      value: attestation,
    },
    direction: EvidenceSupports,
    inference_rule: "kvm-screen-supports-runtime-diagnostic-only",
    authority: attestation.attested_by,
    provenance: EvidenceProvenance {
      entity: "operator-kvm-attestation",
      activity: "operator-observed-kvm-screen",
      agent: attestation.attested_by as ProvAgentId,
    },
    freshness: EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "attestation is retained inside the named install attempt",
    },
    fidelity: EvidenceFidelity {
      boundary: attestation.observed_screen,
      losses: [
        "a visible login prompt suggests boot state but does not prove install completion",
      ],
    },
    probe: os_install_kvm_observation_probe,
  )
}

data os_install_claim_evidence_humility_note: NonEmptyStr = "The existing OS-install deduction fold classifies an operator-attested screen. Its claim link supports only that exact runtime diagnostic under the named preflight and attempt bound; a login prompt cannot promote RuntimeOsInstalled."
