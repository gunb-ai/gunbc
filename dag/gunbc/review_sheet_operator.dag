module gunbc.review_sheet_operator

import std.types { NonEmptyStr, String, Bool }
import std.human_intervention {
  HumanIntervention,
  HumanInterventionIdentity,
  FleetOnce,
  DeviceOnce,
  NoDischargeSiteModeled,
  DischargedAt,
}
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }
import gunbc.ensure { EnsurePolicy, EnsureObserveOnly }
import gunbc.gcp_service_enablement {
  ServiceEnablementDesire,
  ServiceDesiredEnabled,
  ServiceEnablementObservation,
  EnableApiPlan,
  decide_service_enablement,
}
import extdeps.cloud.gcp.gcp { GcpProjectId, ServiceAccountEmail }
import extdeps.google.sheets { sheets_serviceusage_api_id }
import extdeps.google.workspace { google_workspace_product }
import gunbc.gcp_estate_observation {
  sheets_calling_home,
  SheetsCallingHomeUnresolved,
  SheetsCallingHomeSelected,
}
import gunbc.gcp_service_enablement { ServiceEnablementUnobserved }

// Sheets API project and calling identity are the estate fact sheets_calling_home.
// This module does not keep a second standing that can stay AwaitingIdentification after
// that home resolves.

data serviceusage_services_enable_permission: NonEmptyStr = "serviceusage.services.enable"

fn sheets_api_desired_enablement(project: GcpProjectId) -> ServiceEnablementDesire {
  ServiceDesiredEnabled { project: project, service_id: sheets_serviceusage_api_id }
}

fn sheets_api_enablement_decision(
  policy: EnsurePolicy,
  project: GcpProjectId,
  observed: ServiceEnablementObservation,
) -> UpsertDecision<EnableApiPlan> {
  decide_service_enablement(
    policy: policy,
    desired: sheets_api_desired_enablement(project: project),
    observed: observed,
  )
}

fn serviceusage_enable_iam_grant_intervention(
  project: GcpProjectId,
  writer: ServiceAccountEmail,
) -> HumanIntervention {
  HumanIntervention {
    identity: join(
      [
        "gcp-serviceusage-enable-iam-",
        project as String,
        "-",
        writer as String,
      ],
      "",
    ) as HumanInterventionIdentity,
    frequency: FleetOnce,
    subject: project as String,
    instruction: join(
      [
        "Grant ",
        writer as String,
        " ",
        serviceusage_services_enable_permission as String,
        " on project ",
        project as String,
        ". One grant per project covers every API enablement converge on it; this is not a per-API click and it is not zero human steps.",
      ],
      "",
    ),
    completion_evidence: NoDischargeSiteModeled,
  }
}

type BuyerReviewSpreadsheet
  = SpreadsheetAwaitingCreation
  | SpreadsheetIdentified { spreadsheet_id: NonEmptyStr, owner: NonEmptyStr }

data buyer_review_spreadsheet: BuyerReviewSpreadsheet = SpreadsheetAwaitingCreation

type ReviewSheetAccountTenancy
  = AccountTenancyUnobserved
  | ReviewSheetWorkspaceDomain
  | ReviewSheetPlainGoogleAccount

data buyer_review_account_tenancy: ReviewSheetAccountTenancy = ReviewSheetWorkspaceDomain

type WorkspaceDomainSharingPolicy
  = DomainSharingPolicyUnobserved
  | DomainSharingForbidsExternalPrincipals
  | DomainSharingAllowsServiceAccountShare

// Operator read, 2026-09-11: Drive sharing is the three-way OFF / allowlisted domains / ON.
// A writer SA is <name>@<project>.iam.gserviceaccount.com, outside gunb.ai, so an Editor grant
// is this setting, not a GCP one. ON admits that grant. Allowlisted domains would not, unless
// gserviceaccount.com were allowlisted wholesale — broader than one principal, so not a near-miss.
// Warn-on-external-share and guest-account sub-options were not read; this arm does not depend on
// them. ON also permits anyone-with-the-link; if the setting is tightened, the surviving route is
// an in-domain Shared Drive with the SA as a member, or domain-wide delegation, not an external
// principal share.
type BuyerReviewWorkspaceSharingReading {
  policy: WorkspaceDomainSharingPolicy
  read_on: NonEmptyStr
  source: NonEmptyStr
  quoted_selection: NonEmptyStr
}

data buyer_review_workspace_sharing_reading: BuyerReviewWorkspaceSharingReading = {
  policy: DomainSharingAllowsServiceAccountShare,
  read_on: "2026-09-11" as NonEmptyStr,
  source: "Google Admin console, Apps > Google Workspace > Drive and Docs > Sharing settings, applied at gunb.ai" as NonEmptyStr,
  quoted_selection: "ON - Files owned by users or shared drives in gunb.ai can be shared outside of gunb.ai" as NonEmptyStr,
}

// RESIDENCY IS A SEPARATE FACT FROM THE SHEET'S IDENTITY, and it changes the SHAPE of the human
// obligation rather than just its target. A sheet in an owner's My Drive is reached by sharing
// that sheet with the writer, which recurs for every new sheet (spreadsheet_share_intervention
// says so). A sheet inside a Shared Drive is reached by making the writer a member of the DRIVE,
// once, after which every sheet the drive holds is already reachable -- so the per-sheet
// recurrence is not merely retargeted, it is retired. That is why residency is modelled here and
// not left as a note beside the spreadsheet id.
//
// WHAT THIS ARM DOES NOT ASSERT. The sharing annotation above reasons that an in-domain Shared
// Drive is the route that SURVIVES a tightened external-sharing policy. That is an inference from
// a 2026-09-11 console read, not a read of the Shared Drive case itself: a service account remains
// a principal outside gunb.ai whether it is added to a file or to a drive, and whether drive
// membership is governed by the same setting was never observed. Residency is therefore recorded
// as chosen, and its interaction with a tightened policy stays an open read rather than a property
// this module claims.
type ReviewSheetResidency
  = ResidencyUnobserved
  | SheetInOwnerMyDrive
  | SheetInSharedDrive { drive_id: NonEmptyStr, drive_name: NonEmptyStr }

// Operator-supplied 2026-09-16: https://drive.google.com/drive/folders/0ANpu9VSqUzO-Uk9PVA.
// A shared drive's root folder id IS the drive id, which is why a drive url reads /folders/.
//
// GROUNDING, AND ITS GRAIN. The id shape alone only suggested a shared drive. The operator then
// read the drive's own details panel -- Type: Shared drive, Owner: gunb.ai, Creator: the operator,
// Created: 2026-09-16, and "Security limitations: No limitations applied" -- which settles the
// TYPE and the NAME by observation rather than by format inference. It is a human read of a
// console, not a drives.get response, so it grounds what the panel displays and nothing beneath
// it: the membership list is a separate fact, read separately, and is not established here.
//
// The no-limitations reading also narrows why the UI refused to add the writer. It is not this
// drive restricting external principals -- the drive applies none. The refusal ("Sharing to email
// addresses without a Google account is not yet supported") is the sharing dialog declining to
// treat a gserviceaccount.com address as shareable at all, which is a property of that dialog and
// not of this drive, and is why the API path is the one the converge must take.
data review_sheet_residency: ReviewSheetResidency = SheetInSharedDrive {
  drive_id: "0ANpu9VSqUzO-Uk9PVA" as NonEmptyStr,
  drive_name: "Customer Acquisition" as NonEmptyStr,
}

// Membership in the drive, not a share of one file: FleetOnce, because the whole point of the
// Shared Drive route is that it does not recur per sheet.
fn shared_drive_member_intervention(
  drive_id: NonEmptyStr,
  drive_name: NonEmptyStr,
  writer: ServiceAccountEmail,
) -> HumanIntervention {
  HumanIntervention {
    identity: join(
      ["review-sheet-shared-drive-member-", drive_id as String, "-", writer as String],
      "",
    ) as HumanInterventionIdentity,
    frequency: FleetOnce,
    subject: drive_name as String,
    instruction: join(
      [
        "Add ",
        writer as String,
        " as a Content Manager of the shared drive ",
        drive_name as String,
        " (",
        drive_id as String,
        "). Content Manager, not Manager: the writer must add and edit files and must not administer membership. Every sheet this drive holds is then reachable without a per-sheet share, which is why this is once per drive and not once per sheet.",
      ],
      "",
    ),
    completion_evidence: NoDischargeSiteModeled,
  }
}

// The drive has to exist before anyone can be added to it, and its id is a declared fact for the
// same reason the spreadsheet id is: a caller string cannot be audited.
fn shared_drive_create_intervention() -> HumanIntervention {
  HumanIntervention {
    identity: "review-sheet-shared-drive-create" as HumanInterventionIdentity,
    frequency: FleetOnce,
    subject: "review sheet shared drive",
    instruction: "Create the shared drive that will hold the review sheets, then replace review_sheet_residency with SheetInSharedDrive carrying its drive_id and name. The drive id is the part after /drive/folders/ in its URL and is a declared fact, not a caller string.",
    completion_evidence: NoDischargeSiteModeled,
  }
}

// One residency, one next step. An unobserved residency is not silently treated as My Drive:
// that would pick the recurring per-sheet share on behalf of an operator who has not chosen.
fn review_sheet_access_intervention(
  residency: ReviewSheetResidency,
  spreadsheet: BuyerReviewSpreadsheet,
  writer: ServiceAccountEmail,
) -> HumanIntervention {
  match residency {
    ResidencyUnobserved => shared_drive_create_intervention()
    SheetInSharedDrive { drive_id: id, drive_name: n } =>
      shared_drive_member_intervention(drive_id: id, drive_name: n, writer: writer)
    SheetInOwnerMyDrive =>
      share_intervention_for_spreadsheet(spreadsheet: spreadsheet, writer: writer)
  }
}

fn buyer_review_workspace_domain_sharing() -> WorkspaceDomainSharingPolicy {
  buyer_review_workspace_sharing_reading.policy
}

fn spreadsheet_create_intervention() -> HumanIntervention {
  HumanIntervention {
    identity: "buyer-review-spreadsheet-create" as HumanInterventionIdentity,
    frequency: FleetOnce,
    subject: "buyer review spreadsheet",
    instruction: "Create the buyer review Google Sheet, then replace buyer_review_spreadsheet with SpreadsheetIdentified carrying its spreadsheet_id and the operator who owns it. The id is a declared fact, not a caller string.",
    completion_evidence: NoDischargeSiteModeled,
  }
}

fn spreadsheet_share_intervention(spreadsheet_id: NonEmptyStr, writer: ServiceAccountEmail) -> HumanIntervention {
  HumanIntervention {
    identity: join(
      [
        "buyer-review-spreadsheet-share-",
        spreadsheet_id as String,
        "-",
        writer as String,
      ],
      "",
    ) as HumanInterventionIdentity,
    frequency: DeviceOnce,
    subject: spreadsheet_id,
    instruction: join(
      [
        "Share spreadsheet ",
        spreadsheet_id as String,
        " with ",
        writer as String,
        " as Editor. A service account is a distinct principal and cannot see the sheet until this share exists; being in the owner's Workspace is not enough. Recurs for every new sheet.",
      ],
      "",
    ),
    completion_evidence: NoDischargeSiteModeled,
  }
}

type ReviewSheetOperatorAdmission
  = ReviewSheetOperatorAdmitted { spreadsheet_id: NonEmptyStr }
  | ReviewSheetAwaitingHuman { intervention: HumanIntervention }
  | ReviewSheetNeedsApiEnable { plan: EnableApiPlan }
  | ReviewSheetEstateUnresolved { subject: NonEmptyStr, reason: NonEmptyStr }
  | ReviewSheetOperatorRefused { reason: NonEmptyStr }

fn review_sheet_estate_unresolved_calling_home() -> ReviewSheetOperatorAdmission {
  match sheets_calling_home() {
    SheetsCallingHomeSelected {
      project_id: p,
      writer: _,
      refused_api_surface_project: _,
      refused_writer: _,
    } =>
      ReviewSheetOperatorRefused {
        reason: join(
          [
            "sheets_calling_home resolved to ",
            p as String,
            "; this arm answers only for the unresolved home",
          ],
          "",
        ) as NonEmptyStr,
      }
    SheetsCallingHomeUnresolved {
      refused_api_surface_project: surface,
      refused_writer: writer,
      candidate_writer_in_secrets: _,
      kitchen_sink_project: _,
      pool_host_without_sts: _,
      sts_host_without_sheets: _,
    } =>
      ReviewSheetEstateUnresolved {
        subject: "sheets_calling_home" as NonEmptyStr,
        reason: join(
          [
            "Sheets calling home unresolved; refused API surface ",
            surface as String,
            " refused writer ",
            writer as String,
            "; no selected project",
          ],
          "",
        ) as NonEmptyStr,
      }
  }
}

fn admit_identified_spreadsheet_share(
  spreadsheet_id: NonEmptyStr,
  writer: ServiceAccountEmail,
  share: HumanIntervention,
) -> ReviewSheetOperatorAdmission {
  let expected = spreadsheet_share_intervention(spreadsheet_id: spreadsheet_id, writer: writer)
  if (share.identity as String) == (expected.identity as String) {
    match share.completion_evidence {
      DischargedAt { evidence: _ } =>
        ReviewSheetOperatorAdmitted { spreadsheet_id: spreadsheet_id }
      NoDischargeSiteModeled =>
        ReviewSheetAwaitingHuman { intervention: expected }
    }
  } else {
    ReviewSheetOperatorRefused {
      reason: join(
        [
          "share intervention is not for spreadsheet ",
          spreadsheet_id as String,
          " writer ",
          writer as String,
        ],
        "",
      ) as NonEmptyStr
    }
  }
}

fn admit_review_sheet_after_enablement_ready(
  spreadsheet: BuyerReviewSpreadsheet,
  writer: ServiceAccountEmail,
  share: HumanIntervention,
  sharing_policy: WorkspaceDomainSharingPolicy,
  tenancy: ReviewSheetAccountTenancy,
) -> ReviewSheetOperatorAdmission {
  match spreadsheet {
    SpreadsheetAwaitingCreation =>
      ReviewSheetAwaitingHuman { intervention: spreadsheet_create_intervention() }
    SpreadsheetIdentified { spreadsheet_id: id, owner: _ } =>
      match tenancy {
        AccountTenancyUnobserved =>
          ReviewSheetOperatorRefused {
            reason: "Google account tenancy unread" as NonEmptyStr
          }
        ReviewSheetPlainGoogleAccount =>
          admit_identified_spreadsheet_share(
            spreadsheet_id: id,
            writer: writer,
            share: share,
          )
        ReviewSheetWorkspaceDomain =>
          match sharing_policy {
            DomainSharingPolicyUnobserved =>
              ReviewSheetOperatorRefused {
                reason: concat(
                  google_workspace_product as String,
                  " domain sharing policy unread; the operator is admin and the policy is readable",
                ) as NonEmptyStr
              }
            DomainSharingForbidsExternalPrincipals =>
              ReviewSheetOperatorRefused {
                reason: concat(
                  google_workspace_product as String,
                  " domain sharing policy forbids sharing with a service-account principal",
                ) as NonEmptyStr
              }
            DomainSharingAllowsServiceAccountShare =>
              admit_identified_spreadsheet_share(
                spreadsheet_id: id,
                writer: writer,
                share: share,
              )
          }
      }
  }
}

fn admit_serviceusage_enable_iam_for_apply(
  project: GcpProjectId,
  writer: ServiceAccountEmail,
  serviceusage_enable_iam: HumanIntervention,
  plan: EnableApiPlan,
) -> ReviewSheetOperatorAdmission {
  let expected = serviceusage_enable_iam_grant_intervention(project: project, writer: writer)
  if (serviceusage_enable_iam.identity as String) == (expected.identity as String) {
    match serviceusage_enable_iam.completion_evidence {
      NoDischargeSiteModeled =>
        ReviewSheetAwaitingHuman { intervention: expected }
      DischargedAt { evidence: _ } => ReviewSheetNeedsApiEnable { plan: plan }
    }
  } else {
    ReviewSheetOperatorRefused {
      reason: join(
        [
          "serviceusage enable iam intervention is not for project ",
          project as String,
          " writer ",
          writer as String,
        ],
        "",
      ) as NonEmptyStr
    }
  }
}

fn admit_review_sheet_operator(
  project: GcpProjectId,
  writer: ServiceAccountEmail,
  enablement: ServiceEnablementObservation,
  enablement_policy: EnsurePolicy,
  spreadsheet: BuyerReviewSpreadsheet,
  serviceusage_enable_iam: HumanIntervention,
  share: HumanIntervention,
  sharing_policy: WorkspaceDomainSharingPolicy,
  tenancy: ReviewSheetAccountTenancy,
) -> ReviewSheetOperatorAdmission {
  match sheets_api_enablement_decision(
    policy: enablement_policy,
    project: project,
    observed: enablement,
  ) {
    Refuse { reason: r } => ReviewSheetOperatorRefused { reason: r }
    Apply { plan: plan } =>
      admit_serviceusage_enable_iam_for_apply(
        project: project,
        writer: writer,
        serviceusage_enable_iam: serviceusage_enable_iam,
        plan: plan,
      )
    Noop =>
      admit_review_sheet_after_enablement_ready(
        spreadsheet: spreadsheet,
        writer: writer,
        share: share,
        sharing_policy: sharing_policy,
        tenancy: tenancy,
      )
  }
}

fn share_intervention_for_spreadsheet(
  spreadsheet: BuyerReviewSpreadsheet,
  writer: ServiceAccountEmail,
) -> HumanIntervention {
  match spreadsheet {
    SpreadsheetAwaitingCreation => spreadsheet_create_intervention()
    SpreadsheetIdentified { spreadsheet_id: id, owner: _ } =>
      spreadsheet_share_intervention(spreadsheet_id: id, writer: writer)
  }
}

// THE HOME IS SELECTED AND THE PROJECT IS NOT YET OBSERVED, AND THOSE ARE DIFFERENT FACTS.
// Selecting gunbai-sheets settles WHERE Sheets is called from; it establishes nothing about
// whether that project exists, has the API on, or has granted the writer anything. The
// enablement therefore enters as ServiceEnablementUnobserved -- not Disabled, which would
// claim a serviceusage read we have never performed against a project the operator creates by
// hand. Under EnsureObserveOnly that unobserved read reports its obligation instead of minting
// an enable plan from an absent observation, so the admission names the next human step and the
// convergence stays refused until a real read lands.
fn fleet_review_sheet_operator_admission() -> ReviewSheetOperatorAdmission {
  match sheets_calling_home() {
    SheetsCallingHomeUnresolved {
      refused_api_surface_project: _,
      refused_writer: _,
      candidate_writer_in_secrets: _,
      kitchen_sink_project: _,
      pool_host_without_sts: _,
      sts_host_without_sheets: _,
    } => review_sheet_estate_unresolved_calling_home()
    SheetsCallingHomeSelected {
      project_id: p,
      writer: w,
      refused_api_surface_project: _,
      refused_writer: _,
    } =>
      admit_review_sheet_operator(
        project: p,
        writer: w,
        enablement: ServiceEnablementUnobserved {
          project: p,
          service_id: sheets_serviceusage_api_id,
        },
        enablement_policy: EnsureObserveOnly,
        spreadsheet: buyer_review_spreadsheet,
        serviceusage_enable_iam: serviceusage_enable_iam_grant_intervention(project: p, writer: w),
        share: review_sheet_access_intervention(
          residency: review_sheet_residency,
          spreadsheet: buyer_review_spreadsheet,
          writer: w,
        ),
        sharing_policy: buyer_review_workspace_domain_sharing(),
        tenancy: buyer_review_account_tenancy,
      )
  }
}
