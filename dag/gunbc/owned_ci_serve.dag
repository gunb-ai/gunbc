module gunbc.owned_ci_serve


data owned_ci_serve_note: String = "Serve projection for owned CI v0: reads index.json and per-run run.json maintained by ci_control_plane. Missing files answer 503/404 with a located reason — never an empty success page."

fn owned_ci_serve_text_response(status: HttpStatus, content_type: MediaType, body: String) -> ServeHttpResponse {
  ServeHttpResponse { status: status, content_type: content_type, body: body }
}

fn owned_ci_serve_page_response(page: Fragment) -> ServeHttpResponse {
  match try_serialize_html_source(node: page) {
    EmitOk { html: h } =>
      owned_ci_serve_text_response(status: 200, content_type: text_html_utf8, body: h)
    EmitRejected { reason: r } =>
      owned_ci_serve_text_response(
        status: 500,
        content_type: text_plain_utf8,
        body: concat(concat("page render refused: ", r), "\n"),
      )
  }
}

fn serve_ci_runs_page_response() -> ServeHttpResponse {
  match owned_ci_classify_filesystem_text(path: owned_ci_index_rel_path()) {
    OwnedCiFilesystemTextPresent { content: body } =>
      owned_ci_serve_page_response(page: owned_ci_runs_page(body_json: body))
    OwnedCiFilesystemTextEmpty =>
      owned_ci_serve_text_response(
        status: 503,
        content_type: text_plain_utf8,
        body: "owned-ci index unavailable: .gunbc/owned-ci/index.json is empty (fail-closed)\n",
      )
    OwnedCiFilesystemTextMissing { cause: cause } =>
      owned_ci_serve_text_response(
        status: 503,
        content_type: text_plain_utf8,
        body: concat(
          concat("owned-ci index unavailable: .gunbc/owned-ci/index.json missing (", cause),
          ")\n",
        ),
      )
  }
}

fn serve_ci_run_detail_response(params: List<PathParamBinding>) -> ServeHttpResponse {
  let run_id = path_param_value(params: params, name: "run_id")
  if run_id == "" {
    owned_ci_serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "run detail requires run_id path segment (fail-closed)\n",
    )
  } else if !owned_ci_run_id_admits(run_id: run_id) {
    owned_ci_serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "owned-ci run_id refused: must be a safe path segment matching produced grammar <unix>-<8hex> (fail-closed)\n",
    )
  } else {
    match owned_ci_classify_filesystem_text(path: owned_ci_run_record_rel_path(run_id: run_id)) {
      OwnedCiFilesystemTextPresent { content: body } =>
        owned_ci_serve_page_response(page: owned_ci_run_detail_page(run_id: run_id, body_json: body))
      OwnedCiFilesystemTextEmpty =>
        owned_ci_serve_text_response(
          status: 404,
          content_type: text_plain_utf8,
          body: concat(concat("owned-ci run record empty for ", run_id), " (fail-closed)\n"),
        )
      OwnedCiFilesystemTextMissing { cause: cause } =>
        owned_ci_serve_text_response(
          status: 404,
          content_type: text_plain_utf8,
          body: concat(
            concat(concat("owned-ci run record missing for ", run_id), " ("),
            concat(cause, ")\n"),
          ),
        )
    }
  }
}

fn serve_ci_runs_json_response() -> ServeHttpResponse {
  match owned_ci_classify_filesystem_text(path: owned_ci_index_rel_path()) {
    OwnedCiFilesystemTextPresent { content: body } =>
      owned_ci_serve_text_response(status: 200, content_type: application_json_utf8, body: body)
    OwnedCiFilesystemTextEmpty =>
      owned_ci_serve_text_response(
        status: 503,
        content_type: text_plain_utf8,
        body: "owned-ci index unavailable: index.json is empty\n",
      )
    OwnedCiFilesystemTextMissing { cause: cause } =>
      owned_ci_serve_text_response(
        status: 503,
        content_type: text_plain_utf8,
        body: concat(concat("owned-ci index unavailable: index.json missing (", cause), ")\n"),
      )
  }
}
