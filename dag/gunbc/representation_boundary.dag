// CROSS-TREE IMPORT. The eleventh class, ADDED by this inventory. It is the boundary UNDERNEATH the
// coercion fork and the bindings candidate: both exist only because there are two source trees, so
// the modeled seam between those trees is beneath them rather than beside them.
data cross_tree_import_boundary: RepresentationBoundary = RepresentationBoundary {
  identity: "one-modeled-fact-crossing-between-the-dag-and-v2-source-trees" as NonEmptyStr,
  boundary_class: CrossTreeImport,
  authority: OneAuthority {
    home: HomeAuthority {
      authority: decl_ref(module_path: "v2.std.cross_tree.resolution", decl_name: "cross_tree_edge_decision")
    }
  },
  witnesses: [
    witness_subject(
      entry: "src/v2/test/claim/long/cross_tree_real_ingest_activation_test.dag",
      function: "cross_tree_real_ingest_dag_to_v2_denied_holds",
      module_path: "v2.test.long.cross_tree_real_ingest_activation"
    )
  ],
  supported_scope: "The direction of an import edge between the two trees, decided from GROUNDED source-root tags rather than guessed: tree_fundamentality_order is derived, and the QualifiedName-prefix fallback that once stood in for it is deleted. Consumed by v2.compiler.03_name_resolve admit_import_entry.",
  preservation_obligation: "An edge the model admits resolves, an edge it denies refuses, and the decision depends on the declared source-root tags rather than on how the invocation spelled its paths.",
  crossing_evidence: EvidenceOnBothRoutes {
    what_goes_red: "the activation arbiter feeds a host-tagged SourceRootIngest through the REAL grounding machinery and runs the REAL per-edge decision, with a discriminating pair rather than a positive alone: v2 to dag is admitted, and the SAME ingest with its tags reversed is denied. WHAT THE DERIVED STANDING ON THIS ROW ANSWERS, AND IT IS THE REASON THE STANDING IS DERIVED RATHER THAN AUTHORED: this entry sits under a long-running witness path and its module is v2.test.long, so whether the arbiter is reached by an ordinary required run is decided by the live exclusion frontier and gate closure at fold time, NOT by this sentence. A discriminating red that no required run reaches is a weaker fact than it reads as, and the fold is what says which it is." as NonEmptyStr
  },
  next_trigger: climbs_when(capability: "none identified by this inventory for the DECISION itself, which conforms. Whether its arbiter is reached on a required route is answered by boundary_interpreted_standing rather than asserted here.")
}

// ORDER IS SOURCE ORDER AND IS LOAD-BEARING, for the reason gunbc.guarantee_stall.roster gives:
// a consumer renders rows in roster order, so sorting this list reorders every projection derived
// from it. Append at the end.
data representation_boundary_roster: List<RepresentationBoundary> = [
  calls_boundary,
  serialization_boundary,
  coercions_boundary,
  control_flow_boundary,
  effect_execution_boundary,
  bindings_boundary,
  data_layout_boundary,
  generated_mirrors_boundary,
  materialization_boundary,
  result_projection_boundary,
  cross_tree_import_boundary,
]

// THE QUANTIFIER'S DOMAIN, EXPOSED SO IT CAN BE ASSERTED. Every wall below is universally quantified
// and therefore TRUE on an empty roster; counting is what makes emptiness refusable rather than a
// silent pass.
fn boundary_roster_size() -> Int {
  list_length(items: representation_boundary_roster)
}

fn boundary_is_interpreted_only(b: RepresentationBoundary) -> Bool {
  match b.crossing_evidence {
    InterpretedOnly { what_goes_red: _, blocked_on_a_two_route_oracle: _, unbuilt_but_testable_now: _ } => true
    AgreesByConstruction { how: _ } => false
    EvidenceOnBothRoutes { what_goes_red: _ } => false
    NoEvidence { why: _ } => false
    CarriedElsewhere { carrier: _ } => false
  }
}

// THE MEASUREMENT THE ROSTER'S HEADER CITES, DERIVED RATHER THAN TRANSCRIBED. DESIGN section 6: name
// the instrument, never transcribe its output. If a row's arm changes this number moves on its own.
fn interpreted_only_count() -> Int {
  list_length(items: filter(representation_boundary_roster, b => boundary_is_interpreted_only(b: b)))
}

// THE WORK LIST, DERIVED. A row is on it when it has NAMED a cheap local claim nobody has built.
// An empty unbuilt_but_testable_now now means "asked, and nothing found" -- which is why this count
// is meaningful rather than a measure of how much prose each row carries.
fn boundary_has_unbuilt_local_evidence(b: RepresentationBoundary) -> Bool {
  match b.crossing_evidence {
    InterpretedOnly { what_goes_red: _, blocked_on_a_two_route_oracle: _, unbuilt_but_testable_now: u } =>
      u != ""
    AgreesByConstruction { how: _ } => false
    EvidenceOnBothRoutes { what_goes_red: _ } => false
    NoEvidence { why: _ } => false
    CarriedElsewhere { carrier: _ } => false
  }
}

fn unbuilt_but_testable_now_count() -> Int {
  list_length(items: filter(representation_boundary_roster, b => boundary_has_unbuilt_local_evidence(b: b)))
}

fn boundary_has_no_evidence(b: RepresentationBoundary) -> Bool {
  match b.crossing_evidence {
    NoEvidence { why: _ } => true
    InterpretedOnly { what_goes_red: _, blocked_on_a_two_route_oracle: _, unbuilt_but_testable_now: _ } => false
    AgreesByConstruction { how: _ } => false
    EvidenceOnBothRoutes { what_goes_red: _ } => false
    CarriedElsewhere { carrier: _ } => false
  }
}

fn no_evidence_count() -> Int {
  list_length(items: filter(representation_boundary_roster, b => boundary_has_no_evidence(b: b)))
}

// TWO COUNTS, NEVER ONE, AND NEVER SUMMED. This repository has repeatedly paid for a count of
// candidates reported as a count of defects. An ESTABLISHED fork is a fact about the corpus; a
// CANDIDATE is a question with a named discriminator. Adding them produces a number that is true of
// neither population, so no declaration here adds them and none should be added later.
fn boundary_is_established_fork(b: RepresentationBoundary) -> Bool {
  match b.authority {
    TwoAuthoritiesAnswerOneQuestion { first: _, second: _, one_question: _, standing: s } =>
      match s {
        ForkEstablished { how: _ } => true
        ForkCandidate { what_was_established: _, what_was_not: _, discriminator: _ } => false
        DivergenceDeclaredOnTheCarrier { stated_by: _, what_is_duplicated: _, what_is_legitimately_layered: _ } => false
      }
    OneAuthority { home: _ } => false
    NoAuthorityExists { what_would_own_it: _ } => false
  }
}

fn boundary_is_candidate_fork(b: RepresentationBoundary) -> Bool {
  match b.authority {
    TwoAuthoritiesAnswerOneQuestion { first: _, second: _, one_question: _, standing: s } =>
      match s {
        ForkCandidate { what_was_established: _, what_was_not: _, discriminator: _ } => true
        ForkEstablished { how: _ } => false
        DivergenceDeclaredOnTheCarrier { stated_by: _, what_is_duplicated: _, what_is_legitimately_layered: _ } => false
      }
    OneAuthority { home: _ } => false
    NoAuthorityExists { what_would_own_it: _ } => false
  }
}

fn established_fork_count() -> Int {
  list_length(items: filter(representation_boundary_roster, b => boundary_is_established_fork(b: b)))
}

fn candidate_fork_count() -> Int {
  list_length(items: filter(representation_boundary_roster, b => boundary_is_candidate_fork(b: b)))
}

// THE THIRD COUNT, KEPT APART FROM THE OTHER TWO FOR THE SAME REASON THEY ARE KEPT APART FROM EACH
// OTHER. A declared divergence is neither a defect nor an open question: it is an admitted departure
// with its reason on the carrier. Summing it into either of the other counts would report an
// admitted decision as either a defect or an unsettled suspicion, which is the two-valued reading
// DESIGN section 3b exists to prevent, committed by the roster that models the three values.
fn boundary_is_declared_divergence(b: RepresentationBoundary) -> Bool {
  match b.authority {
    TwoAuthoritiesAnswerOneQuestion { first: _, second: _, one_question: _, standing: s } =>
      match s {
        DivergenceDeclaredOnTheCarrier { stated_by: _, what_is_duplicated: _, what_is_legitimately_layered: _ } => true
        ForkEstablished { how: _ } => false
        ForkCandidate { what_was_established: _, what_was_not: _, discriminator: _ } => false
      }
    OneAuthority { home: _ } => false
    NoAuthorityExists { what_would_own_it: _ } => false
  }
}

fn declared_divergence_count() -> Int {
  list_length(items: filter(representation_boundary_roster, b => boundary_is_declared_divergence(b: b)))
}

fn boundary_has_no_authority(b: RepresentationBoundary) -> Bool {
  match b.authority {
    NoAuthorityExists { what_would_own_it: _ } => true
    OneAuthority { home: _ } => false
    TwoAuthoritiesAnswerOneQuestion { first: _, second: _, one_question: _, standing: _ } => false
  }
}

fn boundaries_without_an_authority() -> Int {
  list_length(items: filter(representation_boundary_roster, b => boundary_has_no_authority(b: b)))
}

// TWO CHECKS THAT BELONG HERE BY INSTINCT ARE DELIBERATELY ABSENT, AND THE ABSENCE IS THE POINT.
// The obvious walls to write over this roster are "every candidate names a DISCRIMINATOR" and
// "every two-authority row states its ONE QUESTION". Both were written, and both were DELETED after
// asking DESIGN section 4b's question BEFORE keeping the check: is the forbidden state AUTHORABLE
// anywhere the check could run? It is not. NonEmptyStr is `String where non_empty`, so an empty
// discriminator and an empty shared question are refused by the REFINEMENT at construction --
// `"" as NonEmptyStr` typechecks and then refuses, so a fixture cannot even build the row a red
// would need. A fold over those fields would therefore be permanently green BY CONSTRUCTION,
// carrying no information and worse than absent because it would be cited as coverage of exactly
// the rule this roster is most often going to be asked about.
//
// SO THE RULE IS HELD ONE RUNG HIGHER THAN A CHECK, WHICH IS WHERE DESIGN SECTION 5 WANTS IT: the
// discriminator and the shared question are structurally impossible to omit, rather than checked
// for and found present. What remains below are the two walls whose red IS authorable -- a trigger
// capability is a plain String, so an empty one is writable; and the authority/evidence relation is
// a pair of coproduct arms either of which is freely constructible. Those two are checks because
// they have to be. The other two are not checks because they do not.

// DESIGN section 4b(2): a class below its ceiling must NAME its next-rung trigger, so "cannot climb
// further" stays separable from "unbuilt". An empty capability is the untracked stall that clause
// forbids, and it is decidable here rather than left to review diligence.
fn every_boundary_names_a_trigger() -> Bool {
  fold(
    representation_boundary_roster,
    init: true,
    f: fn(ok, b) { ok && b.next_trigger.capability != "" }
  )
}

// A ROW THAT CLAIMS NO AUTHORITY MAY NOT ALSO CLAIM EVIDENCE, and this is the one wall here that is
// about a RELATION between two fields rather than about one field being filled. If nothing declares
// the fact, there is nothing for an execution to establish agreement WITH -- so a NoAuthorityExists
// row reporting AgreesByConstruction or EvidenceOnBothRoutes would be the divergence report nobody
// can adjudicate, written down as coverage. The control-flow row is the live instance.
fn boundary_authority_and_evidence_are_consistent(b: RepresentationBoundary) -> Bool {
  if boundary_has_no_authority(b: b) {
    match b.crossing_evidence {
      NoEvidence { why: _ } => true
      CarriedElsewhere { carrier: _ } => true
      InterpretedOnly { what_goes_red: _, blocked_on_a_two_route_oracle: _, unbuilt_but_testable_now: _ } => false
      AgreesByConstruction { how: _ } => false
      EvidenceOnBothRoutes { what_goes_red: _ } => false
    }
  } else {
    true
  }
}

fn no_boundary_claims_evidence_without_an_authority() -> Bool {
  fold(
    representation_boundary_roster,
    init: true,
    f: fn(ok, b) { ok && boundary_authority_and_evidence_are_consistent(b: b) }
  )
}
