module gunbc.ci_cost_arc_closeout_receipt


type HarvestKind
  = HandHarvestedDatedAudit {}

type AffectedSelection
  = SelectionApplied {}

type AffectedCiCostAuditSubject {
  harvest: HarvestKind,
  github_actions_run_id: std.nat.Nat,
  head_commit: std.types.NonEmptyStr,
  job_name: std.types.NonEmptyStr,
  selection: AffectedSelection,
}

type FullCorpusSubjectHarvest
  = NotHarvested {}

type AdmissionSettle
  = CaptureMeasuredNetOpen {}

type NativeFleetSettle
  = EnrollmentLandedFleetRateOpen {}

// SkipProofWithdrawn added 2026-08-11 (gunbc#8146). The type had exactly one
// variant, so the receipt could not express "the proof was withdrawn" — a
// single-variant settle carrier is a claim with no way to be false, which is
// how ClosedSkipProofLanded outlived the evidence it names.
type WarmHitSettle
  = ClosedSkipProofLanded {}
  | SkipProofWithdrawn { reason: std.types.NonEmptyStr }

type RetentionSettle
  = ClosedReject {}

type UnionSettle
  = ClosedNoRepeatedTypecheck {}

type SelectionHonestySettle
  = Landed {}

type EndToEndResidual
  = UnattributedCiJobWall {}

type CompilerNextMeasuredTarget
  = PerEntryAssembly {}

fn affected_ci_cost_audit_subject() -> AffectedCiCostAuditSubject {
  AffectedCiCostAuditSubject {
    harvest: HandHarvestedDatedAudit {},
    github_actions_run_id: 30863019228,
    head_commit: "ed9785817ed8" as std.types.NonEmptyStr,
    job_name: "ci" as std.types.NonEmptyStr,
    selection: SelectionApplied {},
  }
}

fn full_corpus_subject_harvest() -> FullCorpusSubjectHarvest {
  NotHarvested {}
}

fn build_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 237000)
}

fn regen_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 510000)
}

fn ci_job_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 2509000)
}

fn pipeline_sum_wall() -> std.measure.Millisecond {
  std.measure.measure_add(a: std.measure.measure_add(a: build_wall(), b: regen_wall()), b: ci_job_wall())
}

fn capture_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 110820)
}

fn discovery_resolve_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 431122)
}

fn discovery_eval_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 65016)
}

fn classified_ci_wall() -> std.measure.Millisecond {
  std.measure.measure_add(
    a: std.measure.measure_add(a: capture_wall(), b: discovery_resolve_wall()),
    b: discovery_eval_wall()
  )
}

fn unattributed_ci_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: std.measure.millisecond_count(m: ci_job_wall()) - std.measure.millisecond_count(m: classified_ci_wall()))
}

fn cold_admission_baseline_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 197130)
}

fn selected_entry_groups() -> std.nat.Nat {
  297
}

fn total_entry_groups() -> std.nat.Nat {
  916
}

fn discovery_witness_total() -> std.nat.Nat {
  6610
}

fn discovery_witness_skipped() -> std.nat.Nat {
  4174
}

fn discovery_witness_deferred() -> std.nat.Nat {
  1020
}

fn floor_drain_peak_rss() -> std.measure.ByteSize {
  std.measure.byte_size(count: 8513646592)
}

fn calibration_floor_peak_rss() -> std.measure.ByteSize {
  std.measure.byte_size(count: 10821181440)
}

fn capture_swap_after() -> std.nat.Nat {
  0
}

fn assembly_symbol_index_merge_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 65161)
}

fn assembly_root_symbol_index_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 32084)
}

fn assembly_rewire_import_str_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 164938)
}

fn assembly_symbol_index_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 43675)
}

fn assembly_root_variant_base_wall() -> std.measure.Millisecond {
  std.measure.millisecond(count: 14178)
}

fn admission_settle() -> AdmissionSettle {
  CaptureMeasuredNetOpen {}
}

fn native_fleet_settle() -> NativeFleetSettle {
  EnrollmentLandedFleetRateOpen {}
}

fn warm_hit_settle() -> WarmHitSettle {
  SkipProofWithdrawn {
    reason: "PREVIOUS: ClosedSkipProofLanded on cross_process_hit_skips_semantic_recompute. WITHDRAWN 2026-08-11 (gunbc#8146): the module carrying that proof, v1_compiler_tests.resolve_cross_process_cache_test, was executed for the first time under the retained-kernel cutover and reports 53 passed / 3 FAILED in 1321s, so it cannot be enrolled in the required gate (it both fails and exceeds the 15-minute step budget). The skip proof itself was not among the failures, but it has no executing consumer while the module is unenrollable. This corrects a reported rung to the one executed evidence establishes rather than lowering a real one — the Landed claim was inflated from the day the suite went --no-run. RESTORATION: fix the failures, bring the module under budget, re-declare it in test.retirement.model." as std.types.NonEmptyStr
  }
}

fn retention_settle() -> RetentionSettle {
  ClosedReject {}
}

fn union_settle() -> UnionSettle {
  ClosedNoRepeatedTypecheck {}
}

fn selection_honesty_settle() -> SelectionHonestySettle {
  Landed {}
}

fn end_to_end_residual() -> EndToEndResidual {
  UnattributedCiJobWall {}
}

fn compiler_next_measured_target() -> CompilerNextMeasuredTarget {
  PerEntryAssembly {}
}

fn ci_job_wall_reconciles() -> Bool {
  let job = std.measure.millisecond_count(m: ci_job_wall())
  let parts = std.measure.millisecond_count(m: classified_ci_wall()) + std.measure.millisecond_count(m: unattributed_ci_wall())
  job == parts
}

fn pipeline_sum_reconciles() -> Bool {
  let sum = std.measure.millisecond_count(m: pipeline_sum_wall())
  let parts = std.measure.millisecond_count(m: build_wall()) + std.measure.millisecond_count(m: regen_wall()) + std.measure.millisecond_count(m: ci_job_wall())
  sum == parts
}

fn classified_equals_capture_resolve_eval() -> Bool {
  let classified = std.measure.millisecond_count(m: classified_ci_wall())
  let parts = std.measure.millisecond_count(m: capture_wall()) + std.measure.millisecond_count(m: discovery_resolve_wall()) + std.measure.millisecond_count(m: discovery_eval_wall())
  classified == parts
}
