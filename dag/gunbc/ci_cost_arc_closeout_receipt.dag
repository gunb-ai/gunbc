module gunbc.ci_cost_arc_closeout_receipt

import std.types { Bool, NonEmptyStr, List }
import std.nat { Nat }
import std.measure {
  Millisecond,
  Second,
  ByteSize,
  millisecond,
  millisecond_count,
  second,
  second_count,
  byte_size,
  measure_add,
}

type HarvestKind
  = HandHarvestedDatedAudit {}

type AffectedSelection
  = SelectionApplied {}

type AffectedCiCostAuditSubject {
  harvest: HarvestKind,
  github_actions_run_id: Nat,
  head_commit: NonEmptyStr,
  job_name: NonEmptyStr,
  selection: AffectedSelection,
}

type FullCorpusSubjectHarvest
  = NotHarvested {}

type AdmissionSettle
  = CaptureMeasuredNetOpen {}

type NativeFleetSettle
  = EnrollmentLandedFleetRateOpen {}

type WarmHitSettle
  = ClosedSkipProofLanded {}

type RetentionSettle
  = ClosedReject {}

type UnionSettle
  = ClosedNoRepeatedTypecheck {}

type SelectionHonestySettle
  = Landed {}

type EndToEndResidual
  = ReconciledCiJobWall {}

type CompilerNextMeasuredTarget
  = PerEntryAssembly {}

type CiJobWallPopulation
  = JobBootstrap {}
  | OrdinaryInitialization {}
  | MergeAdmissionCapture {}
  | CompileClean {}
  | CheapGateBatch {}
  | CompileCleanReceiptGate {}
  | AffectedDiscovery {}
  | AuxiliaryDiscovery {}
  | EmitHost {}
  | NativeSelectedLogic {}
  | OrdinaryFinalization {}
  | ScopedInitialization {}
  | ScopedWitnessExecution {}
  | FloorFinalization {}
  | JobCleanup {}

type CiJobWallBoundary {
  elapsed_since_job_start: Second,
  source_event: NonEmptyStr,
}

type CiJobWallIntervalReceipt {
  population: CiJobWallPopulation,
  start: CiJobWallBoundary,
  end: CiJobWallBoundary,
}

type CiJobWallCoverageFold {
  previous_end: Second,
  interval_count: Nat,
  adjacent: Bool,
  ordered: Bool,
}

type CiJobWallPopulationUniquenessFold {
  seen: List<CiJobWallPopulation>,
  unique: Bool,
}

data ci_job_wall_reconciliation_note: NonEmptyStr = "Non-overlapping CI-job interval receipt for affected subject run 30863019228, job 91850944162, complete at the source's WHOLE-SECOND observational grid. Every interval carries start/end offsets plus the GitHub step or claim_executor log event that supplied its boundary; duration is derived and cannot be redistributed independently. ci_job_wall_interval_chain_holds proves ordered endpoints, exact adjacency, first.start == job.start, and last.end == job.end; ci_job_wall_population_names_unique proves no named population is reused. The millisecond projection is exactly 2509000 ms because the source grid is 2509 whole seconds; it is not a claim of sub-second timestamp precision. These are ELAPSED populations, never additive resolver counters. The initial capture/resolve/eval harvest remains below as a historical nested observation and is not added to these rows. Largest populations on this exact affected subject: AffectedDiscovery 886s; ScopedInitialization plus ScopedWitnessExecution 518s; CompileClean 315s; OrdinaryInitialization 310s. This closes the denominator only: it selects no optimization mechanism." as NonEmptyStr

fn ci_job_wall_boundary(elapsed_seconds: Nat, source_event: NonEmptyStr) -> CiJobWallBoundary {
  CiJobWallBoundary {
    elapsed_since_job_start: second(count: elapsed_seconds),
    source_event: source_event,
  }
}

fn ci_job_started_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 0, source_event: "GitHub job started_at 2026-08-03T23:52:21Z" as NonEmptyStr)
}

fn floor_started_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 14, source_event: "GitHub gunbc ci step started_at 2026-08-03T23:52:35Z" as NonEmptyStr)
}

fn ordinary_plan_ready_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 324, source_event: "claim_executor ordinary executor plan 2026-08-03T23:57:45Z" as NonEmptyStr)
}

fn capture_complete_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 435, source_event: "claim_executor capture receipt and compile-clean start 2026-08-03T23:59:36Z" as NonEmptyStr)
}

