module gunbc.ci_cost_arc_closeout_receipt

import std.types { Bool, NonEmptyStr, List }
import std.nat { Nat }
import std.measure {
  Millisecond,
  ByteSize,
  millisecond,
  millisecond_count,
  byte_size,
  measure_add,
}

type HarvestKind
  = HandHarvestedDatedAudit {}

type AffectedSelection
  = SelectionApplied {}

type AffectedCiCostAuditSubject {
  harvest: HarvestKind,
  github_actions_run_id: Nat,
  head_commit: NonEmptyStr,
  job_name: NonEmptyStr,
  selection: AffectedSelection,
}

type FullCorpusSubjectHarvest
  = NotHarvested {}

type AdmissionSettle
  = CaptureMeasuredNetOpen {}

type NativeFleetSettle
  = EnrollmentLandedFleetRateOpen {}

type WarmHitSettle
  = ClosedSkipProofLanded {}

type RetentionSettle
  = ClosedReject {}

type UnionSettle
  = ClosedNoRepeatedTypecheck {}

type SelectionHonestySettle
  = Landed {}

type EndToEndResidual
  = ReconciledCiJobWall {}

type CompilerNextMeasuredTarget
  = PerEntryAssembly {}

type CiJobWallPopulation
  = JobBootstrap {}
  | OrdinaryInitialization {}
  | MergeAdmissionCapture {}
  | CompileClean {}
  | CheapGateBatch {}
  | CompileCleanReceiptGate {}
  | AffectedDiscovery {}
  | AuxiliaryDiscovery {}
  | EmitHost {}
  | NativeSelectedLogic {}
  | OrdinaryFinalization {}
  | ScopedInitialization {}
  | ScopedWitnessExecution {}
  | FloorFinalization {}
  | JobCleanup {}

type CiJobWallPopulationReceipt {
  population: CiJobWallPopulation,
  wall: Millisecond,
}

data ci_job_wall_reconciliation_note: NonEmptyStr = "Exact non-overlapping CI-job population receipt for affected subject run 30863019228, job 91850944162. Boundaries are the GitHub job step timestamps plus claim_executor's structural-role transition lines in that job log, truncated to whole seconds so adjacent intervals share one boundary and sum exactly to the job's 2509-second wall. These are ELAPSED populations, never additive resolver counters: initialization ends where capture starts; capture ends where compile-clean starts; every batch begins at the prior batch's conclusion; the scoped worker begins after ordinary finalization; cleanup ends at the job completion timestamp. The initial capture/resolve/eval harvest remains below as a historical nested observation and is not added to these rows. Largest populations on this exact affected subject: AffectedDiscovery 886s; ScopedInitialization plus ScopedWitnessExecution 557s; CompileClean 315s; OrdinaryInitialization 310s. This closes the denominator only: it selects no optimization mechanism." as NonEmptyStr

fn ci_job_wall_population_receipts() -> List<CiJobWallPopulationReceipt> {
  [
    CiJobWallPopulationReceipt { population: JobBootstrap {}, wall: millisecond(count: 14000) },
    CiJobWallPopulationReceipt { population: OrdinaryInitialization {}, wall: millisecond(count: 310000) },
    CiJobWallPopulationReceipt { population: MergeAdmissionCapture {}, wall: millisecond(count: 111000) },
    CiJobWallPopulationReceipt { population: CompileClean {}, wall: millisecond(count: 315000) },
    CiJobWallPopulationReceipt { population: CheapGateBatch {}, wall: millisecond(count: 118000) },
    CiJobWallPopulationReceipt { population: CompileCleanReceiptGate {}, wall: millisecond(count: 0) },
    CiJobWallPopulationReceipt { population: AffectedDiscovery {}, wall: millisecond(count: 886000) },
    CiJobWallPopulationReceipt { population: AuxiliaryDiscovery {}, wall: millisecond(count: 75000) },
    CiJobWallPopulationReceipt { population: EmitHost {}, wall: millisecond(count: 6000) },
    CiJobWallPopulationReceipt { population: NativeSelectedLogic {}, wall: millisecond(count: 74000) },
    CiJobWallPopulationReceipt { population: OrdinaryFinalization {}, wall: millisecond(count: 16000) },
    CiJobWallPopulationReceipt { population: ScopedInitialization {}, wall: millisecond(count: 340000) },
    CiJobWallPopulationReceipt { population: ScopedWitnessExecution {}, wall: millisecond(count: 217000) },
    CiJobWallPopulationReceipt { population: FloorFinalization {}, wall: millisecond(count: 22000) },
    CiJobWallPopulationReceipt { population: JobCleanup {}, wall: job_cleanup_wall() }
  ]
}

fn ci_job_wall_population_total(rows: List<CiJobWallPopulationReceipt>) -> Millisecond {
  fold(rows, init: millisecond(count: 0), f: (acc, row) => measure_add(a: acc, b: row.wall))
}

fn job_cleanup_wall() -> Millisecond {
  millisecond(count: 5000)
}

fn affected_ci_cost_audit_subject() -> AffectedCiCostAuditSubject {
  AffectedCiCostAuditSubject {
    harvest: HandHarvestedDatedAudit {},
    github_actions_run_id: 30863019228,
    head_commit: "ed9785817ed8" as NonEmptyStr,
    job_name: "ci" as NonEmptyStr,
    selection: SelectionApplied {},
  }
}

fn full_corpus_subject_harvest() -> FullCorpusSubjectHarvest {
  NotHarvested {}
}

fn build_wall() -> Millisecond {
  millisecond(count: 237000)
}

fn regen_wall() -> Millisecond {
  millisecond(count: 510000)
}

fn ci_job_wall() -> Millisecond {
  millisecond(count: 2509000)
}

fn pipeline_sum_wall() -> Millisecond {
  measure_add(a: measure_add(a: build_wall(), b: regen_wall()), b: ci_job_wall())
}

fn capture_wall() -> Millisecond {
  millisecond(count: 110820)
}

fn discovery_resolve_wall() -> Millisecond {
  millisecond(count: 431122)
}

fn discovery_eval_wall() -> Millisecond {
  millisecond(count: 65016)
}

fn initial_partial_classified_ci_wall() -> Millisecond {
  measure_add(
    a: measure_add(a: capture_wall(), b: discovery_resolve_wall()),
    b: discovery_eval_wall()
  )
}

fn initial_partial_unattributed_ci_wall() -> Millisecond {
  millisecond(count: millisecond_count(m: ci_job_wall()) - millisecond_count(m: initial_partial_classified_ci_wall()))
}

fn classified_ci_wall() -> Millisecond {
  ci_job_wall_population_total(rows: ci_job_wall_population_receipts())
}

fn unattributed_ci_wall() -> Millisecond {
  millisecond(count: millisecond_count(m: ci_job_wall()) - millisecond_count(m: classified_ci_wall()))
}

fn cold_admission_baseline_wall() -> Millisecond {
  millisecond(count: 197130)
}

fn selected_entry_groups() -> Nat {
  297
}

fn total_entry_groups() -> Nat {
  916
}

fn discovery_witness_total() -> Nat {
  6610
}

fn discovery_witness_skipped() -> Nat {
  4174
}

fn discovery_witness_deferred() -> Nat {
  1020
}

fn floor_drain_peak_rss() -> ByteSize {
  byte_size(count: 8513646592)
}

fn calibration_floor_peak_rss() -> ByteSize {
  byte_size(count: 10821181440)
}

fn capture_swap_after() -> Nat {
  0
}

fn assembly_symbol_index_merge_wall() -> Millisecond {
  millisecond(count: 65161)
}

fn assembly_root_symbol_index_wall() -> Millisecond {
  millisecond(count: 32084)
}

fn assembly_rewire_import_str_wall() -> Millisecond {
  millisecond(count: 164938)
}

fn assembly_symbol_index_wall() -> Millisecond {
  millisecond(count: 43675)
}

fn assembly_root_variant_base_wall() -> Millisecond {
  millisecond(count: 14178)
}

fn admission_settle() -> AdmissionSettle {
  CaptureMeasuredNetOpen {}
}

fn native_fleet_settle() -> NativeFleetSettle {
  EnrollmentLandedFleetRateOpen {}
}

fn warm_hit_settle() -> WarmHitSettle {
  ClosedSkipProofLanded {}
}

fn retention_settle() -> RetentionSettle {
  ClosedReject {}
}

fn union_settle() -> UnionSettle {
  ClosedNoRepeatedTypecheck {}
}

fn selection_honesty_settle() -> SelectionHonestySettle {
  Landed {}
}

fn end_to_end_residual() -> EndToEndResidual {
  ReconciledCiJobWall {}
}

fn compiler_next_measured_target() -> CompilerNextMeasuredTarget {
  PerEntryAssembly {}
}

fn ci_job_wall_reconciles() -> Bool {
  let job = millisecond_count(m: ci_job_wall())
  let parts = millisecond_count(m: classified_ci_wall()) + millisecond_count(m: unattributed_ci_wall())
  job == parts
}

fn pipeline_sum_reconciles() -> Bool {
  let sum = millisecond_count(m: pipeline_sum_wall())
  let parts = millisecond_count(m: build_wall()) + millisecond_count(m: regen_wall()) + millisecond_count(m: ci_job_wall())
  sum == parts
}

fn initial_partial_classified_equals_capture_resolve_eval() -> Bool {
  let classified = millisecond_count(m: initial_partial_classified_ci_wall())
  let parts = millisecond_count(m: capture_wall()) + millisecond_count(m: discovery_resolve_wall()) + millisecond_count(m: discovery_eval_wall())
  classified == parts
}

fn ci_job_population_without_cleanup_is_incomplete() -> Bool {
  let without_cleanup = millisecond_count(m: classified_ci_wall()) - millisecond_count(m: job_cleanup_wall())
  !(without_cleanup == millisecond_count(m: ci_job_wall()))
}
