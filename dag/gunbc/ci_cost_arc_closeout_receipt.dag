  ci_job_wall_boundary(elapsed_seconds: 868, source_event: "claim_executor batch 2 pass and affected batch start 2026-08-04T00:06:49Z" as NonEmptyStr)
}

fn affected_discovery_complete_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 1754, source_event: "claim_executor batch 3 pass and batch 4 start 2026-08-04T00:21:35Z" as NonEmptyStr)
}

fn auxiliary_discovery_complete_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 1829, source_event: "claim_executor batch 4 pass and batch 5 start 2026-08-04T00:22:50Z" as NonEmptyStr)
}

fn emit_host_complete_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 1835, source_event: "claim_executor batch 5 pass and batch 6 start 2026-08-04T00:22:56Z" as NonEmptyStr)
}

fn native_selected_complete_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 1909, source_event: "claim_executor batch 6 pass and receipt finalization start 2026-08-04T00:24:10Z" as NonEmptyStr)
}

fn ordinary_worker_complete_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 1964, source_event: "ordinary worker observation completed and scoped worker wait started 2026-08-04T00:25:05Z" as NonEmptyStr)
}

fn scoped_plan_ready_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 2265, source_event: "scoped claim_executor plan ready 2026-08-04T00:30:06Z" as NonEmptyStr)
}

fn scoped_witness_complete_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 2482, source_event: "scoped batch pass and receipt finalization start 2026-08-04T00:33:43Z" as NonEmptyStr)
}

fn floor_complete_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 2504, source_event: "scoped worker observation completed 2026-08-04T00:34:05Z" as NonEmptyStr)
}

fn ci_job_complete_boundary() -> CiJobWallBoundary {
  ci_job_wall_boundary(elapsed_seconds: 2509, source_event: "GitHub job completed_at 2026-08-04T00:34:10Z" as NonEmptyStr)
}

fn ci_job_wall_population_receipts() -> List<CiJobWallIntervalReceipt> {
  [
    CiJobWallIntervalReceipt { population: JobBootstrap {}, start: ci_job_started_boundary(), end: floor_started_boundary() },
    CiJobWallIntervalReceipt { population: OrdinaryInitialization {}, start: floor_started_boundary(), end: ordinary_plan_ready_boundary() },
    CiJobWallIntervalReceipt { population: MergeAdmissionCapture {}, start: ordinary_plan_ready_boundary(), end: capture_complete_boundary() },
    CiJobWallIntervalReceipt { population: CompileClean {}, start: capture_complete_boundary(), end: compile_clean_complete_boundary() },
    CiJobWallIntervalReceipt { population: CheapGateBatch {}, start: compile_clean_complete_boundary(), end: cheap_gate_complete_boundary() },
    CiJobWallIntervalReceipt { population: CompileCleanReceiptGate {}, start: cheap_gate_complete_boundary(), end: compile_clean_receipt_gate_complete_boundary() },
    CiJobWallIntervalReceipt { population: AffectedDiscovery {}, start: compile_clean_receipt_gate_complete_boundary(), end: affected_discovery_complete_boundary() },
    CiJobWallIntervalReceipt { population: AuxiliaryDiscovery {}, start: affected_discovery_complete_boundary(), end: auxiliary_discovery_complete_boundary() },
    CiJobWallIntervalReceipt { population: EmitHost {}, start: auxiliary_discovery_complete_boundary(), end: emit_host_complete_boundary() },
    CiJobWallIntervalReceipt { population: NativeSelectedLogic {}, start: emit_host_complete_boundary(), end: native_selected_complete_boundary() },
    CiJobWallIntervalReceipt { population: OrdinaryFinalization {}, start: native_selected_complete_boundary(), end: ordinary_worker_complete_boundary() },
    CiJobWallIntervalReceipt { population: ScopedInitialization {}, start: ordinary_worker_complete_boundary(), end: scoped_plan_ready_boundary() },
    CiJobWallIntervalReceipt { population: ScopedWitnessExecution {}, start: scoped_plan_ready_boundary(), end: scoped_witness_complete_boundary() },
    CiJobWallIntervalReceipt { population: FloorFinalization {}, start: scoped_witness_complete_boundary(), end: floor_complete_boundary() },
    CiJobWallIntervalReceipt { population: JobCleanup {}, start: floor_complete_boundary(), end: ci_job_complete_boundary() }
  ]
}

fn ci_job_wall_interval_seconds(row: CiJobWallIntervalReceipt) -> Second {
  second(count: second_count(s: row.end.elapsed_since_job_start) - second_count(s: row.start.elapsed_since_job_start))
}

fn ci_job_wall_population_total(rows: List<CiJobWallIntervalReceipt>) -> Millisecond {
  let seconds = fold(rows, init: 0, f: (acc, row) => acc + second_count(s: ci_job_wall_interval_seconds(row: row)))
  millisecond(count: seconds * 1000)
}

fn ci_job_wall_interval_chain_holds(
  rows: List<CiJobWallIntervalReceipt>,
  job_start: Second,
  job_end: Second
) -> Bool {
  let result = fold(rows, init: CiJobWallCoverageFold {
    previous_end: job_start,
    interval_count: 0,
    adjacent: true,
    ordered: true,
  }, f: (state, row) =>
    let start = second_count(s: row.start.elapsed_since_job_start)
    let end = second_count(s: row.end.elapsed_since_job_start)
    CiJobWallCoverageFold {
      previous_end: row.end.elapsed_since_job_start,
      interval_count: state.interval_count + 1,
      adjacent: state.adjacent && start == second_count(s: state.previous_end),
      ordered: state.ordered && start <= end,
    }
  )
  result.interval_count > 0
    && result.adjacent
    && result.ordered
    && second_count(s: result.previous_end) == second_count(s: job_end)
}

fn ci_job_wall_population_names_unique(rows: List<CiJobWallIntervalReceipt>) -> Bool {
  fold(rows, init: CiJobWallPopulationUniquenessFold {
    seen: [],
    unique: true,
  }, f: (state, row) =>
    let already_seen = count(state.seen |> filter(population => population == row.population)) > 0
    CiJobWallPopulationUniquenessFold {
      seen: concat(state.seen, [row.population]),
      unique: state.unique && !already_seen,
    }
  ).unique
}

fn ci_job_wall_population_intervals_cover_job() -> Bool {
  let rows = ci_job_wall_population_receipts()
  count(rows) == 15
    && ci_job_wall_interval_chain_holds(rows: rows, job_start: second(count: 0), job_end: second(count: 2509))
    && ci_job_wall_population_names_unique(rows: rows)
}

fn job_cleanup_wall() -> Millisecond {
  ci_job_wall_population_total(rows: [
    CiJobWallIntervalReceipt { population: JobCleanup {}, start: floor_complete_boundary(), end: ci_job_complete_boundary() }
  ])
}

fn affected_ci_cost_audit_subject() -> AffectedCiCostAuditSubject {
  AffectedCiCostAuditSubject {
    harvest: HandHarvestedDatedAudit {},
    github_actions_run_id: 30863019228,
    head_commit: "ed9785817ed8" as NonEmptyStr,
    job_name: "ci" as NonEmptyStr,
    selection: SelectionApplied {},
  }
}

fn full_corpus_subject_harvest() -> FullCorpusSubjectHarvest {
  NotHarvested {}
}

fn build_wall() -> Millisecond {
  millisecond(count: 237000)
}

fn regen_wall() -> Millisecond {
  millisecond(count: 510000)
}

fn ci_job_wall() -> Millisecond {
  millisecond(count: 2509000)
}

fn pipeline_sum_wall() -> Millisecond {
  measure_add(a: measure_add(a: build_wall(), b: regen_wall()), b: ci_job_wall())
}

fn capture_wall() -> Millisecond {
  millisecond(count: 110820)
}

fn discovery_resolve_wall() -> Millisecond {
  millisecond(count: 431122)
}

fn discovery_eval_wall() -> Millisecond {
  millisecond(count: 65016)
}

fn initial_partial_classified_ci_wall() -> Millisecond {
  measure_add(
    a: measure_add(a: capture_wall(), b: discovery_resolve_wall()),
    b: discovery_eval_wall()
  )
}

fn initial_partial_unattributed_ci_wall() -> Millisecond {
  millisecond(count: millisecond_count(m: ci_job_wall()) - millisecond_count(m: initial_partial_classified_ci_wall()))
}

fn classified_ci_wall() -> Millisecond {
  ci_job_wall_population_total(rows: ci_job_wall_population_receipts())
}

fn unattributed_ci_wall() -> Millisecond {
  millisecond(count: millisecond_count(m: ci_job_wall()) - millisecond_count(m: classified_ci_wall()))
}

fn cold_admission_baseline_wall() -> Millisecond {
  millisecond(count: 197130)
}

