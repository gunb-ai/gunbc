module gunbc.read_set_publish

import std.types { String, List }
import std.optional { Present }
import v2.std.node { Node }
import v2.std.diagnostic { Accepted, Rejected }
import v2.workflow.bash_emit { bash_emit_stmts }
import v2.extdeps.languages.bash_build {
  bash_build_word_lit, bash_build_word_var, bash_build_command_with_words,
  bash_build_pipe, bash_build_with_redir_to_file,
}
import extdeps.languages.yaml.types { YamlKeyValue, yaml_string, kv }
import extdeps.github.actions { Step, RunStep }
import gunbc.read_set_schema {
  read_set_request_family,
  read_set_receipt_basename,
  read_set_env_name,
  fast_lane_native_cli_basename,
  fast_lane_compiler_identity_basename,
}
import gunbc.parse_verdict_publish {
  materialization_family_cache_save_step,
  materialization_gha_cache_key_prefix,
  materialization_publish_if,
  parse_verdict_generation_one_bin,
  parse_verdict_fresh_compiler_expr,
  github_sha_expr,
}

// THE FAST-LANE UNIT, PUBLISHED ON MAIN (step 1 of the planning fast lane,
// @ref(gunbc.design_ruling::seed_read_set_receipt_is_admitted), @ref(gunbc.design_ruling::native_ci_checks_progress_by_plan)).
//
// WHAT IS RECORDED. The required job's emit-and-build steps run with GUNBC_READ_SET_OUT naming one
// workspace-relative file, so the seed's demand acquisition appends every file, probed path and enumerated
// directory it consumes for BOTH compiler products. On a default-branch push that receipt is saved to the
// Actions cache keyed by the commit, together with the native CLI those steps built and that binary's
// compiler identity, as ONE unit (the parse-verdict unit's scope and key family).
//
// WHY THE UNIT IS SAVED LAST. Steps after a failed step do not run, so a unit that exists for a sha is
// evidence that every earlier step of the job went green on that sha. A pull request whose diff misses the
// receipt and the fixed inputs can then reuse that verdict for the closure-dependent steps, and run only
// the whole-tree checks with the restored binary. gunbc.read_set_restore is that reader: it restores the
// unit for the nearest published first-parent ancestor of the base and decides whether it covers the change.
// The file names and receipt kinds both sides read are gunbc.read_set_schema.
//
// The binary is copied into the workspace before saving, because a cache entry's version hashes the
// path string it was saved under (gunbc.parse_verdict_publish parse_verdict_cache_working_directory): a
// path under the runner's absolute temp directory would restore only on a runner that spells it the same.
data fast_lane_stage_step_name: String = "Stage the fast-lane unit"
data fast_lane_stage_unemittable_marker: String = "__GUNBC_FAST_LANE_STAGE_UNEMITTABLE__"

fn read_set_emit_env() -> YamlKeyValue {
  kv(key: read_set_env_name, value: yaml_string(s: read_set_receipt_basename))
}

fn read_set_publish_cache_key() -> String {
  concat(materialization_gha_cache_key_prefix(family: read_set_request_family), github_sha_expr())
}

fn fast_lane_unit_path() -> String {
  join([read_set_receipt_basename, "\n", fast_lane_native_cli_basename, "\n", fast_lane_compiler_identity_basename], "")
}

fn fast_lane_lit(t: String) -> Node { bash_build_word_lit(text: t) }
fn fast_lane_var(n: String) -> Node { bash_build_word_var(name: n) }

fn fast_lane_stage_script() -> String {
  match bash_emit_stmts(
    statements: [
      bash_build_command_with_words(words: [fast_lane_lit(t: "cp"), fast_lane_var(n: "GEN_ONE"), fast_lane_lit(t: fast_lane_native_cli_basename)]),
      bash_build_with_redir_to_file(
        inner: bash_build_pipe(
          left: bash_build_command_with_words(words: [fast_lane_lit(t: "echo"), fast_lane_var(n: "COMPILER")]),
          right: bash_build_command_with_words(words: [fast_lane_lit(t: "tee"), fast_lane_lit(t: fast_lane_compiler_identity_basename)])
        ),
        path: fast_lane_lit(t: "/dev/null")
      ),
    ],
    set_e: true
  ) {
    Accepted { value: v, diagnostics: _ } => v
    Rejected { diagnostics: _ } => fast_lane_stage_unemittable_marker
  }
}

// THE STAGE READS THE FRESH PRODUCT (gunbc.parse_verdict_publish parse_verdict_generation_one_bin and
// parse_verdict_fresh_compiler_expr), never the shared native-CLI expressions, so a unit saved for a commit
// holds the binary that commit's own run built and a restored binary is never saved again under a new sha.
fn fast_lane_stage_step() -> Step {
  RunStep {
    name: Present { value: fast_lane_stage_step_name },
    id: none,
    run: fast_lane_stage_script(),
    shell: none,
    env: Present {
      value: [
        kv(key: "GEN_ONE", value: yaml_string(s: parse_verdict_generation_one_bin())),
        kv(key: "COMPILER", value: yaml_string(s: parse_verdict_fresh_compiler_expr())),
      ]
    },
    working_directory: none,
    if_condition: Present { value: materialization_publish_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn read_set_publish_save_step() -> Step {
  materialization_family_cache_save_step(
    family: read_set_request_family,
    path: fast_lane_unit_path(),
    cache_key: read_set_publish_cache_key()
  )
}

fn read_set_save_step_name() -> String {
  concat(concat("Save ", read_set_request_family), " receipts to Actions cache")
}
