data package_delivery_placement_note: String = "FIRST CONSUMED package materializer for gunbc. Lives here — not in std — until a second real consumer proves a shared abstraction. Owns Codex (and later other) product policy over upstream package facts from extdeps.npm / extdeps.package. Every production effect boundary RE-ADJUDICATES raw graphs via package_lock_admit_graph — never trusts a freely constructed PackageLockGraphAdmitted. Decoding lock SRI text is NOT artifact verification."

data package_delivery_codex_integrity_note: String = "PRODUCTION PROFILE ≠ FORMAT CLAIM. Stage split: extdeps.npm owns wire decode → NpmRegistryIntegrity; this module admits only SHA-512 from that native integrity. Malformed wire never reaches Codex policy."

data package_delivery_digest_observation_note: String = "Archive verification: DownloadToFile then sha512sum_observe_file (extdeps.tools.sha512sum) → PackageArchiveDigestObservation → admit_observed_archive_digest against lock expectation. Never digest_shell_verify_line."

data package_delivery_no_digest_shell_route_note: String = "PROVED BY ABSENCE: gunbc.package_delivery does not import digest_shell_verify_line."

data package_delivery_materialization_note: String = "CLOSED CHAIN: admit lock → select target-required registry nodes (host OS×arch ⋈ platform constraints; required nodes always; matching optional platform packages) → independently DownloadToFile+SHA-512-admit EVERY selected archive → seed an isolated npm cache from those exact bytes (npm.Cache.Add) → npm ci --offline --ignore-scripts against that cache only → read back wrapper bin and platform package directory. No network package acquisition after admission."

data codex_runtime_lock_path: NonEmptyStr = "provider-runtime/codex/package-lock.json"

data codex_runtime_manifest_path: NonEmptyStr = "provider-runtime/codex/package.json"

data codex_runtime_selection_note: String = "Exact Codex 0.146.0 selection is the committed provider-runtime/codex/\{package.json,package-lock.json\} pair generated by npm install --package-lock-only --ignore-scripts. Do not hand-author the packages map. Edges stay empty until an npm-owned realization supplies endpoints — the admitted value is a path-keyed roster, not a complete resolved dependency graph."

data codex_required_package_name: NonEmptyStr = "@openai/codex"

data codex_required_package_version: VersionIdentity = "0.146.0" as VersionIdentity

data codex_wrapper_lock_path_key: NonEmptyStr = "node_modules/@openai/codex"

data codex_bundle_executable_rel: NonEmptyStr = "node_modules/@openai/codex/bin/codex.js"

type CodexNpmIntegrityAdmission
  = CodexNpmIntegrityAdmitted {
      digest: Sha512Digest
    }
  | CodexNpmIntegritySha1Unsupported {
      digest: Sha1Digest
    }

fn codex_admit_npm_integrity(
  integrity: NpmRegistryIntegrity,
) -> CodexNpmIntegrityAdmission {
  match integrity {
    NpmRegistrySha512Integrity { digest } =>
      CodexNpmIntegrityAdmitted { digest: digest }
    NpmRegistrySha1Integrity { digest } =>
      CodexNpmIntegritySha1Unsupported { digest: digest }
  }
}

type PackageArchiveDigestObservation
  = PackageArchiveDigestObserved {
      locator: NonEmptyStr
      observed: Sha512Digest
    }
  | PackageArchiveDigestObservationRefused {
      locator: NonEmptyStr
      cause: NonEmptyStr
    }

type PackageArchiveDigestAdmission
  = PackageArchiveDigestMatched {
      locator: NonEmptyStr
      digest: Sha512Digest
    }
  | PackageArchiveDigestMismatch {
      locator: NonEmptyStr
      expected: Sha512Digest
      observed: Sha512Digest
    }
  | PackageArchiveDigestObservationFailed {
      locator: NonEmptyStr
      cause: NonEmptyStr
    }

fn admit_observed_archive_digest(
  expected: Sha512Digest,
  observation: PackageArchiveDigestObservation,
) -> PackageArchiveDigestAdmission {
  match observation {
    PackageArchiveDigestObserved { locator, observed } =>
      if (expected.hex as String) == (observed.hex as String) {
        PackageArchiveDigestMatched { locator: locator, digest: observed }
      } else {
        PackageArchiveDigestMismatch {
          locator: locator,
          expected: expected,
          observed: observed,
        }
      }
    PackageArchiveDigestObservationRefused { locator, cause } =>
      PackageArchiveDigestObservationFailed { locator: locator, cause: cause }
  }
}

fn observe_package_archive_at_path(
  locator: NonEmptyStr,
  path: FilePath,
) -> PackageArchiveDigestObservation {
  match sha512sum_observe_file(path: path) {
    Sha512FileObserved { digest } =>
      PackageArchiveDigestObserved { locator: locator, observed: digest }
    Sha512FileObservationRefused { cause } =>
      PackageArchiveDigestObservationRefused { locator: locator, cause: cause }
  }
}

data codex_npm_registry_https_prefix: String = "https://registry.npmjs.org/"

type CodexRegistryLocatorAdmission
  = CodexRegistryLocatorAdmitted {
      locator: NonEmptyStr
    }
  | CodexRegistryLocatorRefused {
      locator: NonEmptyStr
      cause: NonEmptyStr
    }

data codex_registry_locator_admission_note: String = "Digest matching proves content identity, not fetch authorization. First Codex profile admits only HTTPS locators under registry.npmjs.org/ before DownloadToFile. file:/http:/other hosts refuse."

fn admit_codex_registry_artifact_locator(
  locator: NonEmptyStr,
) -> CodexRegistryLocatorAdmission {
  let s = locator as String
  if s.starts_with(prefix: codex_npm_registry_https_prefix) {
    if s.contains("..") {
      CodexRegistryLocatorRefused {
        locator: locator,
        cause: "registry locator contains path traversal" as NonEmptyStr,
      }
    } else {
      CodexRegistryLocatorAdmitted { locator: locator }
    }
  } else {
    CodexRegistryLocatorRefused {
      locator: locator,
      cause: "locator is not an HTTPS registry.npmjs.org artifact URL" as NonEmptyStr,
    }
  }
}

fn staging_archive_name_from_lock_key(lock_node_key: NonEmptyStr) -> NonEmptyStr {
  concat(
    (lock_node_key as String).replace(from: "/", to: "__"),
    ".tgz",
  ) as NonEmptyStr
}

type AdmittedPackageArtifactReceipt {
  lock_node_key: NonEmptyStr
  package_name: NonEmptyStr
  version: VersionIdentity
  source_locator: NonEmptyStr
  expected_digest: Sha512Digest
  observed_digest: Sha512Digest
}

data admitted_package_path_note: String = "Staging archive paths are NOT durable receipt fields. StagedAdmittedPackageArtifact carries local_artifact_path only while the staging directory lives; CodexRuntimeBundleReceipt / CodexRuntimeBundle retain digest-only AdmittedPackageArtifactReceipt rows after staging is deleted."

type StagedAdmittedPackageArtifact {
  receipt: AdmittedPackageArtifactReceipt
  local_artifact_path: FilePath
}

type RegistryArtifactAcquisition
  = RegistryArtifactAdmitted {
      staged: StagedAdmittedPackageArtifact
    }
  | RegistryArtifactLocatorRefused {
      admission: CodexRegistryLocatorAdmission
    }
  | RegistryArtifactDownloadRefused {
      locator: NonEmptyStr
    }
  | RegistryArtifactIntegrityRefused {
      admission: PackageArchiveDigestAdmission
    }
  | RegistryArtifactSha1Unsupported {
      digest: Sha1Digest
    }

fn acquire_and_admit_registry_artifact(
  artifact: NpmRegistryArtifact,
  lock_node_key: NonEmptyStr,
  dest_dir: FilePath,
) -> RegistryArtifactAcquisition {
  match admit_codex_registry_artifact_locator(locator: artifact.resolved.locator) {
    CodexRegistryLocatorRefused { locator, cause } =>
      RegistryArtifactLocatorRefused {
        admission: CodexRegistryLocatorRefused { locator: locator, cause: cause },
      }
    CodexRegistryLocatorAdmitted { locator: _ } =>
      match codex_admit_npm_integrity(integrity: artifact.expected_integrity) {
        CodexNpmIntegritySha1Unsupported { digest } =>
          RegistryArtifactSha1Unsupported { digest: digest }
        CodexNpmIntegrityAdmitted { digest: expected } => {
          let dest = concat(
            dest_dir as String,
            concat("/", staging_archive_name_from_lock_key(lock_node_key: lock_node_key) as String),
          ) as FilePath
          let downloaded = http.Client.DownloadToFile(
            url: artifact.resolved.locator,
            destination: dest as NonEmptyStr,
          )
          if downloaded.success == false {
            RegistryArtifactDownloadRefused { locator: artifact.resolved.locator }
          } else {
            match admit_observed_archive_digest(
              expected: expected,
              observation: observe_package_archive_at_path(
                locator: artifact.resolved.locator,
                path: dest,
              ),
            ) {
              PackageArchiveDigestMatched { locator: _, digest } =>
                RegistryArtifactAdmitted {
                  staged: StagedAdmittedPackageArtifact {
                    receipt: AdmittedPackageArtifactReceipt {
                      lock_node_key: lock_node_key,
                      package_name: artifact.package.name,
                      version: artifact.version,
                      source_locator: artifact.resolved.locator,
                      expected_digest: expected,
                      observed_digest: digest,
                    },
                    local_artifact_path: dest,
                  },
                }
              other => RegistryArtifactIntegrityRefused { admission: other }
            }
          }
        }
      }
  }
}

fn admit_codex_package_lock_graph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>(
  raw_graph: PackageLockGraph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>,
) -> PackageLockGraphAdmission<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind> {
  package_lock_admit_graph(graph: raw_graph)
}

type CodexPackageLockGraph = PackageLockGraph<NpmPackageLockManager, NpmLockPathKey, NpmLockNodeSelection, NpmLockNodeMetadata, NpmDependencyKind>

type CodexPackageLockGraphAdmission = PackageLockGraphAdmission<NpmPackageLockManager, NpmLockPathKey, NpmLockNodeSelection, NpmLockNodeMetadata, NpmDependencyKind>

type CodexPackageLockNode = PackageLockNode<NpmLockPathKey, NpmLockNodeSelection, NpmLockNodeMetadata>

type CodexPackageLockAdmission
  = CodexPackageLockAdmitted {
      graph: CodexPackageLockGraph
      nodes: List<CodexPackageLockNode>
      registry_artifacts: List<NpmRegistryArtifact>
    }
  | CodexPackageLockParseFailed {
      cause: NonEmptyStr
    }
  | CodexPackageLockUnsupportedNodes {
      unsupported: List<NpmLockNodeFormUnsupportedCarrier>
    }
  | CodexPackageLockGraphRefused {
      admission: CodexPackageLockGraphAdmission
    }

fn codex_registry_artifacts_from_nodes(
  nodes: List<CodexPackageLockNode>,
) -> List<NpmRegistryArtifact> {
  fold(
    nodes,
    init: [],
    f: (acc, node) => match node.selection {
      NpmRegistrySelected { artifact } => acc |> list_push(artifact)
      NpmRootProject { manifest_identity: _ } => acc
    },
  )
}

fn admit_codex_package_lock_text(text: String) -> CodexPackageLockAdmission {
  match npm_decode_package_lock_text(text: text) {
    NpmPackageLockParseRefused { cause } =>
      CodexPackageLockParseFailed { cause: cause }
    NpmPackageLockParsed { manager: _, nodes, unsupported, graph } =>
      if count(unsupported) > 0 {
        CodexPackageLockUnsupportedNodes { unsupported: unsupported }
      } else {
        match admit_codex_package_lock_graph(raw_graph: graph) {
          PackageLockGraphAdmitted { graph: admitted } =>
            CodexPackageLockAdmitted {
              graph: admitted,
              nodes: nodes,
              registry_artifacts: codex_registry_artifacts_from_nodes(nodes: nodes),
            }
          other => CodexPackageLockGraphRefused { admission: other }
        }
      }
  }
}

fn codex_artifact_named(
  artifacts: List<NpmRegistryArtifact>,
  name: NonEmptyStr,
) -> NpmRegistryArtifact? {
  fold(
    artifacts,
    init: none,
    f: (acc, artifact) => match acc {
      Present { value: _ } => acc
      Absent =>
        if artifact.package.name == name {
          Present { value: artifact }
        } else {
          none
        }
    },
  )
}

type CodexWrapperLookup
  = CodexWrapperAbsent {
      key: NonEmptyStr
    }
  | CodexWrapperUnique {
      node: CodexPackageLockNode
      artifact: NpmRegistryArtifact
    }
  | CodexWrapperDuplicate {
      key: NonEmptyStr
      count: Int
    }
  | CodexWrapperWrongForm {
      key: NonEmptyStr
    }

fn codex_wrapper_lookup(
  graph: CodexPackageLockGraph,
) -> CodexWrapperLookup {
  let key = NpmRelativeLockPath { key: codex_wrapper_lock_path_key }
  match package_lock_lookup_node(graph: graph, key: key) {
    PackageLockNodeAbsent { key: _ } =>
      CodexWrapperAbsent { key: codex_wrapper_lock_path_key }
    PackageLockNodeDuplicate { key: _, count } =>
      CodexWrapperDuplicate { key: codex_wrapper_lock_path_key, count: count }
    PackageLockNodeUnique { node } =>
      match node.selection {
        NpmRegistrySelected { artifact } =>
          CodexWrapperUnique { node: node, artifact: artifact }
        NpmRootProject { manifest_identity: _ } =>
          CodexWrapperWrongForm { key: codex_wrapper_lock_path_key }
      }
  }
}

type CodexNpmRuntimeTarget {
  os: NonEmptyStr
  cpu: NonEmptyStr
}

fn codex_expected_wrapper_version() -> NonEmptyStr {
  (codex_required_package_version as String) as NonEmptyStr
}

data codex_runtime_version_identity_note: String = "ONE runtime version marker for every Codex CLI identity probe. codex_required_package_version is the sole authority; the marker is codex-cli <version> as printed by codex --version. Weak codex-cli-only checks let srv1's ambient npm install (0.133.0) pass while extdeps.llm.codex_app_server cites 0.146.0 protocol facts — two runtimes producing incompatible protocol surfaces. SATISFACTION IS EXACT-LINE, not substring: a line trimmed must equal the marker, so codex-cli 0.146.01 / 0.146.0-rc1 / 0.146.0-dev cannot pass by prefix overlap."

fn codex_runtime_version_identity_marker() -> String {
  concat("codex-cli ", codex_required_package_version as String)
}

fn codex_runtime_version_identity_line_exact(line: String) -> Bool {
  trim(s: line) == codex_runtime_version_identity_marker()
}

fn codex_runtime_version_identity_satisfied(combined_output: String) -> Bool {
  fold(
    split(s: combined_output, delimiter: "\n"),
    init: false,
    f: (acc, line) => acc || codex_runtime_version_identity_line_exact(line: line),
  )
}

data publish_codex_runtime_current_link_note: String = "Typed symlink publish via extdeps.shell.Symlink.AtomicReplace (ln -sfnT argv binding). Runs inside materialize_codex_runtime_bundle during gunbc run materialize, not on the host_effect_apply observe/ensure/read-back transport."

fn publish_codex_runtime_current_link(
  release_parent: FilePath,
  release_root: FilePath,
) -> Bool {
  let link = codex_runtime_current_link_path(release_parent: release_parent)
  shell.Symlink.AtomicReplace(target: release_root, link: link).success
}

fn codex_expected_platform_version(target: CodexNpmRuntimeTarget) -> NonEmptyStr {
  concat(
    codex_required_package_version as String,
    concat("-", concat(target.os as String, concat("-", target.cpu as String))),
  ) as NonEmptyStr
}

fn codex_registry_locator_matches_version(
  locator: NonEmptyStr,
  version: NonEmptyStr,
) -> Bool {
  (locator as String).contains(
    concat("/@openai/codex/-/codex-", concat(version as String, ".tgz")),
  )
}

type CodexNpmRuntimeTargetObservation
  = CodexNpmRuntimeTargetObserved {
      target: CodexNpmRuntimeTarget
    }
  | CodexNpmRuntimeTargetObservationRefused {
      cause: NonEmptyStr
    }

fn codex_map_uname_to_npm_target(
  kernel: String,
  machine: String,
) -> CodexNpmRuntimeTargetObservation {
  let k = kernel.trim()
  let m = machine.trim()
  let os = if k == "Linux" {
    Present { value: "linux" as NonEmptyStr }
  } else if k == "Darwin" {
    Present { value: "darwin" as NonEmptyStr }
  } else {
    none
  }
  let cpu = if m == "x86_64" || m == "amd64" {
    Present { value: "x64" as NonEmptyStr }
  } else if m == "aarch64" || m == "arm64" {
    Present { value: "arm64" as NonEmptyStr }
  } else {
    none
  }
  match os {
    Absent =>
      CodexNpmRuntimeTargetObservationRefused {
        cause: "unsupported uname kernel for npm platform" as NonEmptyStr,
      }
    Present { value: os_v } =>
      match cpu {
        Absent =>
          CodexNpmRuntimeTargetObservationRefused {
            cause: "unsupported uname machine for npm platform" as NonEmptyStr,
          }
        Present { value: cpu_v } =>
          CodexNpmRuntimeTargetObserved {
            target: CodexNpmRuntimeTarget { os: os_v, cpu: cpu_v },
          }
      }
  }
}

fn observe_codex_npm_runtime_target() -> CodexNpmRuntimeTargetObservation {
  let kernel = shell.Uname.KernelName()
  let machine = shell.Uname.Machine()
  if kernel.success == false {
    CodexNpmRuntimeTargetObservationRefused {
      cause: "uname -s failed" as NonEmptyStr,
    }
  } else if machine.success == false {
    CodexNpmRuntimeTargetObservationRefused {
      cause: "uname -m failed" as NonEmptyStr,
    }
  } else {
    codex_map_uname_to_npm_target(kernel: kernel.name, machine: machine.machine)
  }
}

data codex_exact_platform_lock_key_note: String = "FIRST PROFILE PRODUCT POLICY — not a general npm resolver. Exactly one wrapper lock-node plus exactly one (os,cpu)→platform lock-node via exact-cardinality lookup. Product admission ALSO requires exact package name, version, optionality, and platform os/cpu metadata — a modified lock that keeps the key but changes those facts refuses."

fn codex_platform_lock_path_key(target: CodexNpmRuntimeTarget) -> NonEmptyStr? {
  if (target.os as String) == "linux" && (target.cpu as String) == "arm64" {
    Present { value: "node_modules/@openai/codex-linux-arm64" as NonEmptyStr }
  } else if (target.os as String) == "linux" && (target.cpu as String) == "x64" {
    Present { value: "node_modules/@openai/codex-linux-x64" as NonEmptyStr }
  } else if (target.os as String) == "darwin" && (target.cpu as String) == "arm64" {
    Present { value: "node_modules/@openai/codex-darwin-arm64" as NonEmptyStr }
  } else if (target.os as String) == "darwin" && (target.cpu as String) == "x64" {
    Present { value: "node_modules/@openai/codex-darwin-x64" as NonEmptyStr }
  } else if (target.os as String) == "win32" && (target.cpu as String) == "arm64" {
    Present { value: "node_modules/@openai/codex-win32-arm64" as NonEmptyStr }
  } else if (target.os as String) == "win32" && (target.cpu as String) == "x64" {
    Present { value: "node_modules/@openai/codex-win32-x64" as NonEmptyStr }
  } else {
    none
  }
}

fn codex_native_executable_rel(target: CodexNpmRuntimeTarget) -> NonEmptyStr? {
  if (target.os as String) == "linux" && (target.cpu as String) == "arm64" {
    Present {
      value: "node_modules/@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/bin/codex" as NonEmptyStr,
    }
  } else if (target.os as String) == "linux" && (target.cpu as String) == "x64" {
    Present {
      value: "node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex" as NonEmptyStr,
    }
  } else if (target.os as String) == "darwin" && (target.cpu as String) == "arm64" {
    Present {
      value: "node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex" as NonEmptyStr,
    }
  } else if (target.os as String) == "darwin" && (target.cpu as String) == "x64" {
    Present {
      value: "node_modules/@openai/codex-darwin-x64/vendor/x86_64-apple-darwin/bin/codex" as NonEmptyStr,
    }
  } else {
    none
  }
}

fn codex_linux_arm64_native_executable_rel() -> NonEmptyStr? {
  codex_native_executable_rel(
    target: CodexNpmRuntimeTarget {
      os: "linux" as NonEmptyStr,
      cpu: "arm64" as NonEmptyStr,
    },
  )
}

fn codex_bundled_executable_for_srv1() -> FilePath? {
  match codex_linux_arm64_native_executable_rel() {
    Absent => none
    Present { value: rel } =>
      Present {
        value: codex_bundled_executable_at_current_link(
          release_parent: srv1_codex_runtime_release_root,
          native_executable_rel: rel,
        )
      }
  }
}

type CodexTargetPackageLookup
  = CodexTargetPackageAbsent {
      key: NonEmptyStr
    }
  | CodexTargetPackageUnique {
      node: CodexPackageLockNode
      artifact: NpmRegistryArtifact
    }
  | CodexTargetPackageDuplicate {
      key: NonEmptyStr
      count: Int
    }
  | CodexTargetPackageWrongMetadata {
      key: NonEmptyStr
      cause: NonEmptyStr
    }

fn codex_target_package_lookup(
  graph: CodexPackageLockGraph,
  target: CodexNpmRuntimeTarget,
) -> CodexTargetPackageLookup {
  match codex_platform_lock_path_key(target: target) {
    Absent =>
      CodexTargetPackageWrongMetadata {
        key: "unsupported-target" as NonEmptyStr,
        cause: "no exact platform lock-node key for observed os/cpu" as NonEmptyStr,
      }
    Present { value: path_key } => {
      let key = NpmRelativeLockPath { key: path_key }
      match package_lock_lookup_node(graph: graph, key: key) {
        PackageLockNodeAbsent { key: _ } =>
          CodexTargetPackageAbsent { key: path_key }
        PackageLockNodeDuplicate { key: _, count } =>
          CodexTargetPackageDuplicate { key: path_key, count: count }
        PackageLockNodeUnique { node } =>
          match node.selection {
            NpmRootProject { manifest_identity: _ } =>
              CodexTargetPackageWrongMetadata {
                key: path_key,
                cause: "platform lock-node is root project, not registry artifact" as NonEmptyStr,
              }
            NpmRegistrySelected { artifact } =>
              CodexTargetPackageUnique { node: node, artifact: artifact }
          }
      }
    }
  }
}

type CodexSelectedNodeAdmission
  = CodexSelectedNodeAdmitted {
      node: CodexPackageLockNode
      artifact: NpmRegistryArtifact
      lock_node_key: NonEmptyStr
    }
  | CodexSelectedNodeInstallScriptRefused {
      lock_node_key: NonEmptyStr
    }
  | CodexSelectedNodeIdentityRefused {
      lock_node_key: NonEmptyStr
      cause: NonEmptyStr
    }

data codex_install_script_refusal_note: String = "npm ci --ignore-scripts prevents execution; it does not admit a package whose lock row requires an unadmitted build effect. First Codex profile refuses any selected node with hasInstallScript=true. Measured 0.146.0 closure has none — no exception roster."

fn list_contains_str(xs: List<NonEmptyStr>, needle: NonEmptyStr) -> Bool {
  xs |> any(x => (x as String) == (needle as String))
}

fn admit_codex_selected_node(
  node: CodexPackageLockNode,
  artifact: NpmRegistryArtifact,
  lock_node_key: NonEmptyStr,
  expect_optional: Bool,
  expect_version: NonEmptyStr,
  expect_os: NonEmptyStr?,
  expect_cpu: NonEmptyStr?,
) -> CodexSelectedNodeAdmission {
  if node.metadata.flags.has_install_script {
    CodexSelectedNodeInstallScriptRefused { lock_node_key: lock_node_key }
  } else if artifact.package.name != codex_required_package_name {
    CodexSelectedNodeIdentityRefused {
      lock_node_key: lock_node_key,
      cause: "package name is not @openai/codex" as NonEmptyStr,
    }
  } else if node.metadata.flags.optional != expect_optional {
    CodexSelectedNodeIdentityRefused {
      lock_node_key: lock_node_key,
      cause: "optional flag does not match first-profile expectation" as NonEmptyStr,
    }
  } else if (artifact.version as String) != (expect_version as String) {
    CodexSelectedNodeIdentityRefused {
      lock_node_key: lock_node_key,
      cause: "package version is not the pinned Codex 0.146.0 profile identity" as NonEmptyStr,
    }
  } else if codex_registry_locator_matches_version(
    locator: artifact.resolved.locator,
    version: expect_version,
  ) == false {
    CodexSelectedNodeIdentityRefused {
      lock_node_key: lock_node_key,
      cause: "resolved locator does not match expected Codex registry tarball identity" as NonEmptyStr,
    }
  } else {
      match expect_os {
        Absent =>
          CodexSelectedNodeAdmitted {
            node: node,
            artifact: artifact,
            lock_node_key: lock_node_key,
          }
        Present { value: os_v } =>
          match expect_cpu {
            Absent =>
              CodexSelectedNodeIdentityRefused {
                lock_node_key: lock_node_key,
                cause: "platform cpu expectation missing" as NonEmptyStr,
              }
            Present { value: cpu_v } =>
              if list_contains_str(xs: node.metadata.platform.os, needle: os_v) == false {
                CodexSelectedNodeIdentityRefused {
                  lock_node_key: lock_node_key,
                  cause: "platform os metadata does not match selected target" as NonEmptyStr,
                }
              } else if list_contains_str(xs: node.metadata.platform.cpu, needle: cpu_v) == false {
                CodexSelectedNodeIdentityRefused {
                  lock_node_key: lock_node_key,
                  cause: "platform cpu metadata does not match selected target" as NonEmptyStr,
                }
              } else {
                CodexSelectedNodeAdmitted {
                  node: node,
                  artifact: artifact,
                  lock_node_key: lock_node_key,
                }
              }
          }
      }
  }
}

type CodexExactTargetClosure
  = CodexExactTargetClosureSelected {
      wrapper: CodexSelectedNodeAdmission
      platform: CodexSelectedNodeAdmission
      target: CodexNpmRuntimeTarget
      platform_lock_key: NonEmptyStr
      native_executable_rel: NonEmptyStr
    }
  | CodexExactTargetClosureWrapperRefused {
      lookup: CodexWrapperLookup
    }
  | CodexExactTargetClosurePlatformRefused {
      lookup: CodexTargetPackageLookup
    }
  | CodexExactTargetClosureInstallScriptRefused {
      lock_node_key: NonEmptyStr
    }
  | CodexExactTargetClosureIdentityRefused {
      lock_node_key: NonEmptyStr
      cause: NonEmptyStr
    }
  | CodexExactTargetClosureNativePathAbsent {
      target: CodexNpmRuntimeTarget
    }

fn select_codex_exact_target_closure(
  graph: CodexPackageLockGraph,
  target: CodexNpmRuntimeTarget,
) -> CodexExactTargetClosure {
  match codex_wrapper_lookup(graph: graph) {
    CodexWrapperUnique { node: wrapper_node, artifact: wrapper_artifact } =>
      match admit_codex_selected_node(
        node: wrapper_node,
        artifact: wrapper_artifact,
        lock_node_key: codex_wrapper_lock_path_key,
        expect_optional: false,
        expect_version: codex_expected_wrapper_version(),
        expect_os: none,
        expect_cpu: none,
      ) {
        CodexSelectedNodeInstallScriptRefused { lock_node_key } =>
          CodexExactTargetClosureInstallScriptRefused {
            lock_node_key: lock_node_key,
          }
        CodexSelectedNodeIdentityRefused { lock_node_key, cause } =>
          CodexExactTargetClosureIdentityRefused {
            lock_node_key: lock_node_key,
            cause: cause,
          }
        CodexSelectedNodeAdmitted {
          node: w_node,
          artifact: w_art,
          lock_node_key: w_key,
        } =>
          match codex_target_package_lookup(graph: graph, target: target) {
            CodexTargetPackageUnique { node: plat_node, artifact: plat_artifact } =>
              match lock_path_key_rel(key: plat_node.key) {
                Absent =>
                  CodexExactTargetClosurePlatformRefused {
                    lookup: CodexTargetPackageWrongMetadata {
                      key: "platform" as NonEmptyStr,
                      cause: "platform node key is root" as NonEmptyStr,
                    },
                  }
                Present { value: plat_key } =>
                  match admit_codex_selected_node(
                    node: plat_node,
                    artifact: plat_artifact,
                    lock_node_key: plat_key,
                    expect_optional: true,
                    expect_version: codex_expected_platform_version(target: target),
                    expect_os: Present { value: target.os },
                    expect_cpu: Present { value: target.cpu },
                  ) {
                    CodexSelectedNodeInstallScriptRefused { lock_node_key } =>
                      CodexExactTargetClosureInstallScriptRefused {
                        lock_node_key: lock_node_key,
                      }
                    CodexSelectedNodeIdentityRefused { lock_node_key, cause } =>
                      CodexExactTargetClosureIdentityRefused {
                        lock_node_key: lock_node_key,
                        cause: cause,
                      }
                    CodexSelectedNodeAdmitted {
                      node: p_node,
                      artifact: p_art,
                      lock_node_key: p_key,
                    } =>
                      match codex_native_executable_rel(target: target) {
                        Absent =>
                          CodexExactTargetClosureNativePathAbsent { target: target }
                        Present { value: native_rel } =>
                          CodexExactTargetClosureSelected {
                            wrapper: CodexSelectedNodeAdmitted {
                              node: w_node,
                              artifact: w_art,
                              lock_node_key: w_key,
                            },
                            platform: CodexSelectedNodeAdmitted {
                              node: p_node,
                              artifact: p_art,
                              lock_node_key: p_key,
                            },
                            target: target,
                            platform_lock_key: p_key,
                            native_executable_rel: native_rel,
                          }
                      }
                  }
              }
            other => CodexExactTargetClosurePlatformRefused { lookup: other }
          }
      }
    other => CodexExactTargetClosureWrapperRefused { lookup: other }
  }
}

fn lock_path_key_rel(key: NpmLockPathKey) -> NonEmptyStr? {
  match key {
    NpmRootLockPath => none
    NpmRelativeLockPath { key: rel } => Present { value: rel }
  }
}

data codex_runtime_release_parent: FilePath = srv1_codex_runtime_release_root

data codex_runtime_receipt_sidecar_name: NonEmptyStr = ".gunbc-codex-runtime-receipt" as NonEmptyStr

data admitted_codex_runtime_source_note: String = "ONE carrier binds the bytes adjudicated to the bytes executed. materialize_codex_runtime_bundle admits lock_bytes, then Filesystem.Write those exact lock_bytes and manifest_bytes into the build root before npm ci. A path-based copy of a second lock file is unwritable on this path — the admitted/executed fork is construction-closed."

type AdmittedCodexRuntimeSource {
  manifest_bytes: String
  lock_bytes: String
}

fn admitted_and_executed_lock_bytes_agree(
  admitted_lock_bytes: String,
  executed_lock_bytes: String,
) -> Bool {
  admitted_lock_bytes == executed_lock_bytes
}

data codex_runtime_bundle_receipt_note: String = "FULL cryptographic CodexRuntimeBundleReceipt: installed manifest+lock digests + target + digest-only admitted rows + installed-tree identity + native executable digest + npm+node toolchain + canonical protocol-schema bundle identity. Bundle root is content-addressed under gunbc.host_layout.ProviderRuntimePlacement.runtime_release_root/<receipt-hex> (srv1 via srv1_provider_runtime_placement; not /tmp). Mutable Codex state lives under runtime_mutable_state_root — never equate a content-derived path with immutability. Reuse requires sidecar + native digest + full rematerialized-tree identity match."

type PackageTreeEntryKind
  = PackageTreeRegularFile {
      content_digest: Sha512Digest
    }
  | PackageTreeSymlink {
      target: NonEmptyStr
    }

type PackageTreeEntryReceipt {
  rel_path: NonEmptyStr
  mode_octal: NonEmptyStr
  kind: PackageTreeEntryKind
}

type PackageMaterializedTreeReceipt {
  entries: List<PackageTreeEntryReceipt>
  tree_identity: ContentHash
}

type CodexBuildToolchainReceipt {
  npm_cli_version: NonEmptyStr
  node_version: NonEmptyStr
}

type CodexRuntimeBundleReceipt {
  manifest_digest: Sha512Digest
  lock_digest: Sha512Digest
  target: CodexNpmRuntimeTarget
  admitted_packages: List<AdmittedPackageArtifactReceipt>
  admitted_package_set_identity: ContentHash
  materialized_tree: PackageMaterializedTreeReceipt
  native_executable_digest: Sha512Digest
  toolchain: CodexBuildToolchainReceipt
  protocol_schema_identity: ContentHash
  receipt_identity: ContentHash
}

type CodexRuntimeBundle {
  root: FilePath
  native_executable_rel: NonEmptyStr
  wrapper_executable_rel: NonEmptyStr
  platform_package_rel: NonEmptyStr
  target: CodexNpmRuntimeTarget
  admitted_packages: List<AdmittedPackageArtifactReceipt>
  admitted_package_set_identity: ContentHash
  receipt: CodexRuntimeBundleReceipt
}

data admitted_package_set_identity_note: String = "AdmittedCodexPackageSetIdentity: SHA-512 over a canonical newline record of (lock_node_key, version, source_locator, observed_digest), rows ordered by lock_node_key ascending (exact two-node closure). Nested inside CodexRuntimeBundleReceipt."

fn admitted_package_receipt_canonical_line(
  receipt: AdmittedPackageArtifactReceipt,
) -> String {
  concat(
    receipt.lock_node_key as String,
    concat(
      "\t",
      concat(
        receipt.version as String,
        concat(
          "\t",
          concat(
            receipt.source_locator as String,
            concat("\t", receipt.observed_digest.hex as String),
          ),
        ),
      ),
    ),
  )
}

fn sort_admitted_packages_by_lock_key(
  receipts: List<AdmittedPackageArtifactReceipt>,
) -> List<AdmittedPackageArtifactReceipt> {
  match receipts.skip(n: 0).first() {
    Absent => [] as List<AdmittedPackageArtifactReceipt>
    Present { value: a } =>
      match receipts.skip(n: 1).first() {
        Absent => [a]
        Present { value: b } =>
          if (a.lock_node_key as String) <= (b.lock_node_key as String) {
            [a, b]
          } else {
            [b, a]
          }
      }
  }
}

fn observe_admitted_package_set_identity(
  receipts: List<AdmittedPackageArtifactReceipt>,
  staging_dir: FilePath,
) -> ContentHash? {
  let ordered = sort_admitted_packages_by_lock_key(receipts: receipts)
  let body = fold(
    ordered,
    init: "" as String,
    f: (acc, receipt) =>
      concat(acc, concat(admitted_package_receipt_canonical_line(receipt: receipt), "\n")),
  )
  let path = concat(staging_dir as String, "/admitted-package-set.canonical")
  let wrote = Filesystem.Write(path: path, content: body)
  if wrote.success == false {
    none
  } else {
    match sha512sum_observe_file(path: path as FilePath) {
      Sha512FileObserved { digest } =>
        Present { value: as_content_hash_sha512(digest: digest) }
      Sha512FileObservationRefused { cause: _ } => none
    }
  }
}

fn observe_file_sha512(path: FilePath) -> Sha512Digest? {
  match sha512sum_observe_file(path: path) {
    Sha512FileObserved { digest } => Present { value: digest }
    Sha512FileObservationRefused { cause: _ } => none
  }
}

fn content_hash_sha512_hex(hash: ContentHash) -> String? {
  match hash {
    Sha512Hash(digest) => Present { value: digest.hex as String }
    Fnv1a64(_) => none
    Sha256Hash(_) => none
    Sha1Hash(_) => none
  }
}

fn observe_npm_cli_version() -> NonEmptyStr? {
  let observed = npm.Cli.Version()
  if observed.success == false {
    none
  } else {
    let trimmed = (observed.version as String).trim()
    if trimmed == "" {
      none
    } else {
      Present { value: trimmed as NonEmptyStr }
    }
  }
}

fn observe_node_cli_version() -> NonEmptyStr? {
  let observed = nodejs.Cli.Version()
  if observed.success == false {
    none
  } else {
    let trimmed = (observed.version as String).trim()
    if trimmed == "" {
      none
    } else {
      Present { value: trimmed as NonEmptyStr }
    }
  }
}

fn observe_codex_build_toolchain() -> CodexBuildToolchainReceipt? {
  match observe_npm_cli_version() {
    Absent => none
    Present { value: npm_ver } =>
      match observe_node_cli_version() {
        Absent => none
        Present { value: node_ver } =>
          Present {
            value: CodexBuildToolchainReceipt {
              npm_cli_version: npm_ver,
              node_version: node_ver,
            },
          }
      }
  }
}

fn package_tree_entry_canonical_line(entry: PackageTreeEntryReceipt) -> String {
  match entry.kind {
    PackageTreeRegularFile { content_digest } =>
      concat(
        "f\t",
        concat(
          entry.mode_octal as String,
          concat(
            "\t",
            concat(entry.rel_path as String, concat("\t", content_digest.hex as String)),
          ),
        ),
      )
    PackageTreeSymlink { target } =>
      concat(
        "l\t",
        concat(
          entry.mode_octal as String,
          concat(
            "\t",
            concat(entry.rel_path as String, concat("\t", target as String)),
          ),
        ),
      )
  }
}

data package_tree_identity_mode_symlink_note: String = "Tree identity covers regular files AND symlinks. Each entry carries mode_octal plus either SHA-512 content (regular file) or symlink target. Enumeration uses GNU find -printf '%y\\t%m\\t%P\\t%l' so a content-preserving mode flip or symlink retarget refuses reuse."

data package_materialized_tree_linux_find_note: String = "Installed-tree enumeration currently uses GNU find -printf (mode+symlink target). The first Codex runtime profile is therefore Linux-only; Darwin targets remain declared for package selection but reuse validation on Darwin requires a typed portable filesystem enumeration (dissolve-on)."

data package_materialized_tree_observation_note: String = "TYPED FIND, TYPED REFUSAL (review 50535). This read previously built its argv by concat-ing the root into a single-quoted find string and running it through retained_foreign — medium-as-string (DESIGN §7), and a root containing an apostrophe escaped the wrapper outright. extdeps.shell already owned shell.Find, so the string form was also a §3 fork of an existing authority: the enumeration now goes through shell.Find.FilesAndSymlinksWithMode, where root is a distinct argv element and no quoting exists to escape. The trailing pipe to sort is gone too — std sort orders the rows in-substrate rather than borrowing the shell's collation, which is locale-dependent and was never declared.\n\nThe refusal half: every failure arm returned a bare none, so a missing find, a permission denial, an uninterpretable row, a digest failure and a write failure were one indistinguishable Absent and the caller's cause string was canned regardless of what actually happened (DESIGN §5 — a failure arm must refuse, and the refusal must be typed and located to be countable). Each arm now names its own cause. NOT a state this fixes, stated because the review named it: an EMPTY tree was never ambiguous — it returns an Observed receipt carrying zero entries, not a refusal."

type PackageMaterializedTreeObservation
  = PackageMaterializedTreeObserved { receipt: PackageMaterializedTreeReceipt }
  | PackageMaterializedTreeObservationRefused { cause: NonEmptyStr }

fn observe_package_materialized_tree(
  root: FilePath,
  work_dir: FilePath,
) -> PackageMaterializedTreeObservation {
  let listed = shell.Find.FilesAndSymlinksWithMode(root: root)
  if listed.success == false {
    PackageMaterializedTreeObservationRefused {
      cause: "installed-tree enumeration command failed" as NonEmptyStr,
    }
  } else {
    let rows = fold(
      split(s: listed.stdout, delimiter: "\n"),
      init: [] as List<String>,
      f: (acc, line) =>
        if line == "" {
          acc
        } else {
          acc |> list_push(line)
        },
    )
    let entries_acc = fold(
      rows,
      init: Present { value: [] as List<PackageTreeEntryReceipt> },
      f: (acc, row) => match acc {
        Absent => none
        Present { value: so_far } => {
          let cols = split(s: row, delimiter: "\t")
          match cols.skip(n: 0).first() {
            Absent => none
            Present { value: kind_ch } =>
              match cols.skip(n: 1).first() {
                Absent => none
                Present { value: mode } =>
                  match cols.skip(n: 2).first() {
                    Absent => none
                    Present { value: rel } =>
                      if rel == "" || (rel as String) == (codex_runtime_receipt_sidecar_name as String) {
                        Present { value: so_far }
                      } else if kind_ch == "f" {
                        let abs = concat(root as String, concat("/", rel))
                        match observe_file_sha512(path: abs as FilePath) {
                          Absent => none
                          Present { value: digest } =>
                            Present {
                              value: so_far |> list_push(
                                PackageTreeEntryReceipt {
                                  rel_path: rel as NonEmptyStr,
                                  mode_octal: mode as NonEmptyStr,
                                  kind: PackageTreeRegularFile { content_digest: digest },
                                },
                              ),
                            }
                        }
                      } else if kind_ch == "l" {
                        match cols.skip(n: 3).first() {
                          Absent => none
                          Present { value: target } =>
                            if target == "" {
                              none
                            } else {
                              Present {
                                value: so_far |> list_push(
                                  PackageTreeEntryReceipt {
                                    rel_path: rel as NonEmptyStr,
                                    mode_octal: mode as NonEmptyStr,
                                    kind: PackageTreeSymlink {
                                      target: target as NonEmptyStr,
                                    },
                                  },
                                ),
                              }
                            }
                        }
                      } else {
                        none
                      }
                  }
              }
          }
        }
      },
    )
    match entries_acc {
      Absent =>
        PackageMaterializedTreeObservationRefused {
          cause: "installed-tree row could not be interpreted" as NonEmptyStr,
        }
      Present { value: entries } => {
        let body = fold(
          entries,
          init: "" as String,
          f: (acc, entry) =>
            concat(acc, concat(package_tree_entry_canonical_line(entry: entry), "\n")),
        )
        let path = concat(work_dir as String, "/materialized-tree.canonical")
        let wrote = Filesystem.Write(path: path, content: body)
        if wrote.success == false {
          PackageMaterializedTreeObservationRefused {
            cause: "canonical installed-tree listing could not be written" as NonEmptyStr,
          }
        } else {
          match sha512sum_observe_file(path: path as FilePath) {
            Sha512FileObserved { digest } =>
              PackageMaterializedTreeObserved {
                receipt: PackageMaterializedTreeReceipt {
                  entries: entries,
                  tree_identity: as_content_hash_sha512(digest: digest),
                },
              }
            Sha512FileObservationRefused { cause: digest_cause } =>
              PackageMaterializedTreeObservationRefused { cause: digest_cause }
          }
        }
      }
    }
  }
}

fn json_object_keys_unique(members: List<JsonKeyValue>) -> Bool {
  match fold(
    members,
    init: Present { value: [] as List<String> },
    f: (acc, m) => match acc {
      Absent => none
      Present { value: seen } =>
        if any(seen, k => k == m.key) {
          none
        } else {
          Present { value: list_push(seen, m.key) }
        }
    },
  ) {
    Absent => false
    Present { value: _ } => true
  }
}

type JsonMemberSortAcc {
  out: List<JsonKeyValue>
  placed: Bool
}

fn insert_json_member_by_key(
  sorted: List<JsonKeyValue>,
  member: JsonKeyValue,
) -> List<JsonKeyValue> {
  let acc = fold(
    sorted,
    init: JsonMemberSortAcc {
      out: [] as List<JsonKeyValue>,
      placed: false,
    },
    f: (state, existing) =>
      if state.placed {
        JsonMemberSortAcc {
          out: list_push(state.out, existing),
          placed: true,
        }
      } else if member.key <= existing.key {
        JsonMemberSortAcc {
          out: list_push(list_push(state.out, member), existing),
          placed: true,
        }
      } else {
        JsonMemberSortAcc {
          out: list_push(state.out, existing),
          placed: false,
        }
      },
  )
  if acc.placed {
    acc.out
  } else {
    list_push(acc.out, member)
  }
}

fn sort_json_members_by_key(members: List<JsonKeyValue>) -> List<JsonKeyValue> {
  fold(
    members,
    init: [] as List<JsonKeyValue>,
    f: (sorted, member) => insert_json_member_by_key(sorted: sorted, member: member),
  )
}

fn canonicalize_json_value(v: JsonValue) -> JsonValue? {
  match v {
    JsonNull => Present { value: JsonNull }
    JsonBool { value: b } => Present { value: JsonBool { value: b } }
    JsonNumber { lexeme: l } => Present { value: JsonNumber { lexeme: l } }
    JsonString { value: s } => Present { value: JsonString { value: s } }
    JsonArray { elements } => {
      let mapped = fold(
        elements,
        init: Present { value: [] as List<JsonValue> },
        f: (acc, el) => match acc {
          Absent => none
          Present { value: so_far } =>
            match canonicalize_json_value(v: el) {
              Absent => none
              Present { value: c } => Present { value: list_push(so_far, c) }
            }
        },
      )
      match mapped {
        Absent => none
        Present { value: els } => Present { value: JsonArray { elements: els } }
      }
    }
    JsonObject { members } => {
      if json_object_keys_unique(members: members) == false {
        none
      } else {
        let sorted = sort_json_members_by_key(members: members)
        let mapped = fold(
          sorted,
          init: Present { value: [] as List<JsonKeyValue> },
          f: (acc, m) => match acc {
            Absent => none
            Present { value: so_far } =>
              match canonicalize_json_value(v: m.value) {
                Absent => none
                Present { value: cv } =>
                  Present {
                    value: list_push(
                      so_far,
                      JsonKeyValue { key: m.key, value: cv },
                    ),
                  }
              }
          },
        )
        match mapped {
          Absent => none
          Present { value: ms } => Present { value: JsonObject { members: ms } }
        }
      }
    }
  }
}

fn observe_protocol_schema_identity(
  native_executable: FilePath,
  work_dir: FilePath,
) -> ContentHash? {
  let schema_dir = concat(work_dir as String, "/protocol-schema") as FilePath
  let made = shell.Mkdir.Parents(path: schema_dir)
  if made.success == false {
    none
  } else {
    let script = retained_foreign(
      body: concat(
        "'",
        concat(
          native_executable as String,
          concat(
            "' app-server generate-json-schema -o '",
            concat(schema_dir as String, "'"),
          ),
        ),
      ),
      reason: "Codex generate-json-schema observation pending typed WitnessBin argv enrollment" as NonEmptyStr,
    )
    let gen = shell.Exec.Run(script: script)
    if gen.success == false {
      none
    } else {
      let list_script = retained_foreign(
        body: concat(
          "find '",
          concat(schema_dir as String, "' -type f -name '*.json' | sort"),
        ),
        reason: "Protocol schema bundle file list pending typed Find enrollment" as NonEmptyStr,
      )
      let listed = shell.Exec.Run(script: list_script)
      if listed.success == false {
        none
      } else {
        let abs_paths = filter(
          split(s: listed.stdout, delimiter: "\n"),
          p => p != "",
        )
        if count(abs_paths) == 0 {
          none
        } else {
          let schema_prefix = concat(schema_dir as String, "/")
          let records_acc = fold(
            abs_paths,
            init: Present { value: "" as String },
            f: (acc, abs) => match acc {
              Absent => none
              Present { value: so_far } => {
                let abs_s = abs as String
                let rel = if abs_s.starts_with(prefix: schema_prefix) {
                  substring(
                    s: abs_s,
                    start: schema_prefix.length(),
                    end: abs_s.length(),
                  )
                } else {
                  abs_s
                }
                let raw = Filesystem.Read(path: abs_s)
                if raw.success == false {
                  none
                } else {
                  match parse_json(s: raw.content) {
                    Absent => none
                    Present { value: parsed } =>
                      match canonicalize_json_value(v: parsed) {
                        Absent => none
                        Present { value: canon } =>
                          Present {
                            value: concat(
                              so_far,
                              concat(
                                rel,
                                concat("\n", concat(serialize_json(v: canon), "\n")),
                              ),
                            ),
                          }
                      }
                  }
                }
              }
            },
          )
          match records_acc {
            Absent => none
            Present { value: body } => {
              let path = concat(work_dir as String, "/protocol-schema-bundle.canonical")
              let wrote = Filesystem.Write(path: path, content: body)
              if wrote.success == false {
                none
              } else {
                match sha512sum_observe_file(path: path as FilePath) {
                  Sha512FileObserved { digest } =>
                    Present { value: as_content_hash_sha512(digest: digest) }
                  Sha512FileObservationRefused { cause: _ } => none
                }
              }
            }
          }
        }
      }
    }
  }
}

fn codex_runtime_bundle_receipt_canonical_body(
  receipt: CodexRuntimeBundleReceipt,
) -> String? {
  match content_hash_sha512_hex(hash: receipt.admitted_package_set_identity) {
    Absent => none
    Present { value: set_hex } =>
      match content_hash_sha512_hex(hash: receipt.protocol_schema_identity) {
        Absent => none
        Present { value: protocol_hex } =>
          match content_hash_sha512_hex(hash: receipt.materialized_tree.tree_identity) {
            Absent => none
            Present { value: tree_hex } =>
              Present {
                value: concat(
                  receipt.manifest_digest.hex as String,
                  concat(
                    "\n",
                    concat(
                      receipt.lock_digest.hex as String,
                      concat(
                        "\n",
                        concat(
                          receipt.target.os as String,
                          concat(
                            "/",
                            concat(
                              receipt.target.cpu as String,
                              concat(
                                "\n",
                                concat(
                                  set_hex,
                                  concat(
                                    "\n",
                                    concat(
                                      tree_hex,
                                      concat(
                                        "\n",
                                        concat(
                                          receipt.native_executable_digest.hex as String,
                                          concat(
                                            "\n",
                                            concat(
                                              receipt.toolchain.npm_cli_version as String,
                                              concat(
                                                "\n",
                                                concat(
                                                  receipt.toolchain.node_version as String,
                                                  concat("\n", protocol_hex),
                                                ),
                                              ),
                                            ),
                                          ),
                                        ),
                                      ),
                                    ),
                                  ),
                                ),
                              ),
                            ),
                          ),
                        ),
                      ),
                    ),
                  ),
                ),
              }
          }
      }
  }
}

fn observe_codex_runtime_bundle_receipt_identity(
  receipt_without_identity: CodexRuntimeBundleReceipt,
  staging_dir: FilePath,
) -> ContentHash? {
  match codex_runtime_bundle_receipt_canonical_body(receipt: receipt_without_identity) {
    Absent => none
    Present { value: body } => {
      let path = concat(staging_dir as String, "/codex-runtime-bundle.receipt.canonical")
      let wrote = Filesystem.Write(path: path, content: body)
      if wrote.success == false {
        none
      } else {
        match sha512sum_observe_file(path: path as FilePath) {
          Sha512FileObserved { digest } =>
            Present { value: as_content_hash_sha512(digest: digest) }
          Sha512FileObservationRefused { cause: _ } => none
        }
      }
    }
  }
}

fn codex_runtime_receipt_sidecar_path(release_root: FilePath) -> FilePath {
  concat(
    release_root as String,
    concat("/", codex_runtime_receipt_sidecar_name as String),
  ) as FilePath
}

fn write_codex_runtime_receipt_sidecar(
  release_root: FilePath,
  receipt_identity: ContentHash,
) -> Bool {
  match content_hash_sha512_hex(hash: receipt_identity) {
    Absent => false
    Present { value: hex } => {
      let wrote = Filesystem.Write(
        path: codex_runtime_receipt_sidecar_path(release_root: release_root) as String,
        content: hex,
      )
      wrote.success
    }
  }
}

fn read_codex_runtime_receipt_sidecar(release_root: FilePath) -> String? {
  let read = Filesystem.Read(
    path: codex_runtime_receipt_sidecar_path(release_root: release_root) as String,
  )
  if read.success == false {
    none
  } else {
    let trimmed = (read.content as String).trim()
    if trimmed == "" {
      none
    } else {
      Present { value: trimmed }
    }
  }
}

type CodexRuntimeReleaseOutcome
  = CodexRuntimeReleaseReady {
      root: FilePath
    }
  | CodexRuntimeReleaseFailed {
      cause: NonEmptyStr
    }
  | CodexRuntimeReleaseReuseMismatch {
      existing_root: FilePath
      cause: NonEmptyStr
    }

fn validate_existing_codex_runtime_release(
  existing_root: FilePath,
  receipt: CodexRuntimeBundleReceipt,
  native_executable_rel: NonEmptyStr,
  expected_hex: String,
  scratch_dir: FilePath,
) -> CodexRuntimeReleaseOutcome {
  match read_codex_runtime_receipt_sidecar(release_root: existing_root) {
    Absent =>
      CodexRuntimeReleaseReuseMismatch {
        existing_root: existing_root,
        cause: "existing release missing receipt sidecar" as NonEmptyStr,
      }
    Present { value: side_hex } =>
      if side_hex != expected_hex {
        CodexRuntimeReleaseReuseMismatch {
          existing_root: existing_root,
          cause: "existing release sidecar identity mismatch" as NonEmptyStr,
        }
      } else {
        let existing_native = concat(
          existing_root as String,
          concat("/", native_executable_rel as String),
        ) as FilePath
        match observe_file_sha512(path: existing_native) {
          Absent =>
            CodexRuntimeReleaseReuseMismatch {
              existing_root: existing_root,
              cause: "existing release native digest observation refused" as NonEmptyStr,
            }
          Present { value: observed } =>
            if observed.hex != receipt.native_executable_digest.hex {
              CodexRuntimeReleaseReuseMismatch {
                existing_root: existing_root,
                cause: "existing release native digest mismatch" as NonEmptyStr,
              }
            } else {
              let native_file = shell.Test.IsFile(path: existing_native)
              let native_exec = shell.Test.IsExecutable(path: existing_native)
              if native_file.is_file == false || native_exec.executable == false {
                CodexRuntimeReleaseReuseMismatch {
                  existing_root: existing_root,
                  cause: "existing release native entry is not a regular executable file" as NonEmptyStr,
                }
              } else {
                match observe_package_materialized_tree(
                  root: existing_root,
                  work_dir: scratch_dir,
                ) {
                  PackageMaterializedTreeObservationRefused { cause: tree_cause } =>
                    CodexRuntimeReleaseReuseMismatch {
                      existing_root: existing_root,
                      cause: tree_cause,
                    }
                  PackageMaterializedTreeObserved { receipt: tree } =>
                    match content_hash_sha512_hex(hash: tree.tree_identity) {
                      Absent =>
                        CodexRuntimeReleaseReuseMismatch {
                          existing_root: existing_root,
                          cause: "existing release tree identity is not SHA-512" as NonEmptyStr,
                        }
                      Present { value: tree_hex } =>
                        match content_hash_sha512_hex(
                          hash: receipt.materialized_tree.tree_identity,
                        ) {
                          Absent =>
                            CodexRuntimeReleaseReuseMismatch {
                              existing_root: existing_root,
                              cause: "expected receipt tree identity is not SHA-512" as NonEmptyStr,
                            }
                          Present { value: expected_tree_hex } =>
                            if tree_hex != expected_tree_hex {
                              CodexRuntimeReleaseReuseMismatch {
                                existing_root: existing_root,
                                cause: "existing release tree identity mismatch" as NonEmptyStr,
                              }
                            } else {
                              CodexRuntimeReleaseReady { root: existing_root }
                            }
                        }
                    }
                }
              }
            }
        }
      }
  }
}

data codex_runtime_release_publish_note: String = "Publication uses a UNIQUE same-parent staging directory (mktemp -d .<hex>.publishing.XXXXXX), never a deterministic .<hex>.publishing path. Tree-identity scratch (materialized-tree.canonical) is ALWAYS outside the publishing/release tree — passed as scratch_dir — so validation cannot plant a file into the tree it is measuring. Final install is GNU mv -T (no-target-directory): equivalent to renameat2(RENAME_NOREPLACE) for directories on Linux — never nests into an existing winner. On AlreadyExists, delete the contender staging tree and validate the winner with the same external scratch."

fn relocate_build_root_to_unique_publishing(
  build_root: FilePath,
  parent: FilePath,
  hex: String,
) -> FilePath? {
  let template = concat(
    parent as String,
    concat("/.", concat(hex, ".publishing.XXXXXX")),
  ) as FilePath
  let staged = shell.Mktemp.DirWithTemplate(template: template)
  if staged.success == false {
    none
  } else {
    let script = retained_foreign(
      body: concat(
        "rmdir '",
        concat(
          staged.path as String,
          concat(
            "' && mv -T '",
            concat(
              build_root as String,
              concat("' '", concat(staged.path as String, "'")),
            ),
          ),
        ),
      ),
      reason: "Exclusive unique publishing relocate: rmdir mktemp placeholder then mv -T build root onto that name" as NonEmptyStr,
    )
    let run = shell.Exec.Run(script: script)
    if run.success == false {
      let _ = shell.Remove.RecursiveForce(path: staged.path)
      none
    } else {
      Present { value: staged.path }
    }
  }
}

fn rename_publishing_noreplace(
  publishing: FilePath,
  dest: FilePath,
) -> Bool {
  let script = retained_foreign(
    body: concat(
      "mv -T '",
      concat(
        publishing as String,
        concat("' '", concat(dest as String, "'")),
      ),
    ),
    reason: "Atomic no-nest publication rename (GNU mv -T / renameat2 RENAME_NOREPLACE equivalent for dirs)" as NonEmptyStr,
  )
  shell.Exec.Run(script: script).success
}

fn codex_runtime_release_ready_with_current_link(
  release_parent: FilePath,
  root: FilePath,
) -> CodexRuntimeReleaseOutcome {
  if publish_codex_runtime_current_link(
    release_parent: release_parent,
    release_root: root,
  ) {
    CodexRuntimeReleaseReady { root: root }
  } else {
    CodexRuntimeReleaseFailed {
      cause: "codex runtime current symlink publish refused" as NonEmptyStr,
    }
  }
}

fn release_codex_runtime_bundle_immutable(
  build_root: FilePath,
  receipt: CodexRuntimeBundleReceipt,
  native_executable_rel: NonEmptyStr,
  scratch_dir: FilePath,
  release_parent: FilePath,
) -> CodexRuntimeReleaseOutcome {
  match content_hash_sha512_hex(hash: receipt.receipt_identity) {
    Absent =>
      CodexRuntimeReleaseFailed {
        cause: "receipt identity is not SHA-512" as NonEmptyStr,
      }
    Present { value: hex } => {
      let parent = release_parent
      let made = shell.Mkdir.Parents(path: parent)
      if made.success == false {
        CodexRuntimeReleaseFailed {
          cause: "release parent mkdir refused" as NonEmptyStr,
        }
      } else {
        let dest = concat(parent as String, concat("/", hex)) as FilePath
        let already = shell.Test.IsDirectory(path: dest)
        if already.is_directory {
          let validated = validate_existing_codex_runtime_release(
            existing_root: dest,
            receipt: receipt,
            native_executable_rel: native_executable_rel,
            expected_hex: hex,
            scratch_dir: scratch_dir,
          )
          match validated {
            CodexRuntimeReleaseReady { root } => {
              let _ = shell.Remove.RecursiveForce(path: build_root)
              codex_runtime_release_ready_with_current_link(
                release_parent: parent,
                root: root,
              )
            }
            CodexRuntimeReleaseFailed { cause } =>
              CodexRuntimeReleaseFailed { cause: cause }
            CodexRuntimeReleaseReuseMismatch { existing_root, cause } =>
              CodexRuntimeReleaseReuseMismatch {
                existing_root: existing_root,
                cause: cause,
              }
          }
        } else {
          match relocate_build_root_to_unique_publishing(
            build_root: build_root,
            parent: parent,
            hex: hex,
          ) {
            Absent =>
              CodexRuntimeReleaseFailed {
                cause: "unique publishing staging relocate refused" as NonEmptyStr,
              }
            Present { value: publishing } =>
              if write_codex_runtime_receipt_sidecar(
                release_root: publishing,
                receipt_identity: receipt.receipt_identity,
              ) == false {
                let _ = shell.Remove.RecursiveForce(path: publishing)
                CodexRuntimeReleaseFailed {
                  cause: "receipt sidecar write refused on publishing staging" as NonEmptyStr,
                }
              } else {
                match validate_existing_codex_runtime_release(
                  existing_root: publishing,
                  receipt: receipt,
                  native_executable_rel: native_executable_rel,
                  expected_hex: hex,
                  scratch_dir: scratch_dir,
                ) {
                  CodexRuntimeReleaseReady { root: _ } => {
                    if rename_publishing_noreplace(
                      publishing: publishing,
                      dest: dest,
                    ) {
                      codex_runtime_release_ready_with_current_link(
                        release_parent: parent,
                        root: dest,
                      )
                    } else {
                      let winner = shell.Test.IsDirectory(path: dest)
                      let _ = shell.Remove.RecursiveForce(path: publishing)
                      if winner.is_directory {
                        match validate_existing_codex_runtime_release(
                          existing_root: dest,
                          receipt: receipt,
                          native_executable_rel: native_executable_rel,
                          expected_hex: hex,
                          scratch_dir: scratch_dir,
                        ) {
                          CodexRuntimeReleaseReady { root: winner_root } =>
                            codex_runtime_release_ready_with_current_link(
                              release_parent: parent,
                              root: winner_root,
                            )
                          other => other
                        }
                      } else {
                        CodexRuntimeReleaseFailed {
                          cause: "atomic no-replace rename to content-addressed release refused" as NonEmptyStr,
                        }
                      }
                    }
                  }
                  mismatch => {
                    let _ = shell.Remove.RecursiveForce(path: publishing)
                    mismatch
                  }
                }
              }
          }
        }
      }
    }
  }
}

type CodexRuntimeMaterialization
  = CodexRuntimeMaterialized {
      bundle: CodexRuntimeBundle
    }
  | CodexRuntimeLockRefused {
      admission: CodexPackageLockAdmission
    }
  | CodexRuntimeExactClosureRefused {
      closure: CodexExactTargetClosure
    }
  | CodexRuntimeTargetObservationRefused {
      observation: CodexNpmRuntimeTargetObservation
    }
  | CodexRuntimeAcquisitionRefused {
      acquisition: RegistryArtifactAcquisition
    }
  | CodexRuntimeWorkspaceRefused {
      cause: NonEmptyStr
    }
  | CodexRuntimeCacheSeedRefused {
      path: FilePath
      stderr: String
    }
  | CodexRuntimeNpmCiOfflineRefused {
      stderr: String
    }
  | CodexRuntimeExecutableAbsent {
      path: FilePath
    }
  | CodexRuntimePlatformPackageAbsent {
      path: FilePath
    }
  | CodexRuntimeIdentityObservationRefused
  | CodexRuntimeReceiptObservationRefused {
      cause: NonEmptyStr
    }
  | CodexRuntimeReleaseRefused {
      cause: NonEmptyStr
    }
  | CodexRuntimeMaterializationReuseMismatch {
      existing_root: FilePath
      cause: NonEmptyStr
    }
  | CodexRuntimeHostDependencyRefused {
      tool: NonEmptyStr
      hint: String
    }

fn require_npm_host_dependency_for_materialization() -> CodexRuntimeMaterialization? {
  match first_absent_codex_wet_materialization_host_cli_dependency() {
    Present { value: HostCliDependencyAbsent { tool, hint } } =>
      Present {
        value: CodexRuntimeHostDependencyRefused { tool: tool, hint: hint },
      }
    Absent => none
  }
}

fn codex_runtime_materialization_failure_receipt(
  outcome: CodexRuntimeMaterialization,
) -> String {
  let generic = match codex_runtime_materialization_refusal_reason(outcome: outcome) {
    Present { value: reason } => reason as String
    Absent => ""
  }
  match outcome {
    CodexRuntimeHostDependencyRefused { tool, hint } =>
      host_dependency_absent_wire(tool: tool, hint: hint)
    CodexRuntimeMaterialized { bundle: _ } => generic
    CodexRuntimeLockRefused { admission: _ } => generic
    CodexRuntimeExactClosureRefused { closure: _ } => generic
    CodexRuntimeTargetObservationRefused { observation: _ } => generic
    CodexRuntimeAcquisitionRefused { acquisition: _ } => generic
    CodexRuntimeWorkspaceRefused { cause: _ } => generic
    CodexRuntimeCacheSeedRefused { path: _, stderr: _ } => generic
    CodexRuntimeNpmCiOfflineRefused { stderr: _ } => generic
    CodexRuntimeExecutableAbsent { path: _ } => generic
    CodexRuntimePlatformPackageAbsent { path: _ } => generic
    CodexRuntimeIdentityObservationRefused => generic
    CodexRuntimeReceiptObservationRefused { cause: _ } => generic
    CodexRuntimeReleaseRefused { cause: _ } => generic
    CodexRuntimeMaterializationReuseMismatch { existing_root: _, cause: _ } => generic
  }
}

fn codex_runtime_materialization_refusal_reason(
  outcome: CodexRuntimeMaterialization,
) -> NonEmptyStr? {
  match outcome {
    CodexRuntimeMaterialized { bundle: _ } => none
    CodexRuntimeLockRefused { admission: _ } =>
      Present { value: "codex package-lock admission refused" as NonEmptyStr }
    CodexRuntimeExactClosureRefused { closure: _ } =>
      Present { value: "codex exact target closure refused" as NonEmptyStr }
    CodexRuntimeTargetObservationRefused { observation: _ } =>
      Present { value: "codex npm runtime target observation refused" as NonEmptyStr }
    CodexRuntimeAcquisitionRefused { acquisition: _ } =>
      Present { value: "codex registry artifact acquisition refused" as NonEmptyStr }
    CodexRuntimeWorkspaceRefused { cause } => Present { value: cause }
    CodexRuntimeCacheSeedRefused { path: _, stderr: _ } =>
      Present { value: "codex isolated npm cache seed refused" as NonEmptyStr }
    CodexRuntimeNpmCiOfflineRefused { stderr: _ } =>
      Present { value: "codex npm ci --offline --ignore-scripts refused" as NonEmptyStr }
    CodexRuntimeExecutableAbsent { path: _ } =>
      Present { value: "codex native executable absent after offline install" as NonEmptyStr }
    CodexRuntimePlatformPackageAbsent { path: _ } =>
      Present { value: "codex platform package directory absent after offline install" as NonEmptyStr }
    CodexRuntimeIdentityObservationRefused =>
      Present { value: "codex admitted-package-set identity observation refused" as NonEmptyStr }
    CodexRuntimeReceiptObservationRefused { cause } => Present { value: cause }
    CodexRuntimeReleaseRefused { cause } => Present { value: cause }
    CodexRuntimeMaterializationReuseMismatch { existing_root: _, cause } => Present { value: cause }
    CodexRuntimeHostDependencyRefused { tool: _, hint: _ } =>
      Present { value: "codex runtime host dependency refused" as NonEmptyStr }
  }
}

type TargetClosureAcquisitionAcc
  = TargetClosureAcquisitionOk {
      admitted: List<StagedAdmittedPackageArtifact>
    }
  | TargetClosureAcquisitionFailed {
      acquisition: RegistryArtifactAcquisition
    }

fn acquire_and_admit_selected_pair(
  wrapper: CodexSelectedNodeAdmission,
  platform: CodexSelectedNodeAdmission,
  dest_dir: FilePath,
) -> TargetClosureAcquisitionAcc {
  match wrapper {
    CodexSelectedNodeInstallScriptRefused { lock_node_key: _ } =>
      TargetClosureAcquisitionFailed {
        acquisition: RegistryArtifactDownloadRefused {
          locator: "install-script-refused" as NonEmptyStr,
        },
      }
    CodexSelectedNodeIdentityRefused { lock_node_key: _, cause: _ } =>
      TargetClosureAcquisitionFailed {
        acquisition: RegistryArtifactDownloadRefused {
          locator: "identity-refused" as NonEmptyStr,
        },
      }
    CodexSelectedNodeAdmitted { node: _, artifact: w_art, lock_node_key: w_key } =>
      match acquire_and_admit_registry_artifact(
        artifact: w_art,
        lock_node_key: w_key,
        dest_dir: dest_dir,
      ) {
        RegistryArtifactAdmitted { staged: w_staged } =>
          match platform {
            CodexSelectedNodeInstallScriptRefused { lock_node_key: _ } =>
              TargetClosureAcquisitionFailed {
                acquisition: RegistryArtifactDownloadRefused {
                  locator: "install-script-refused" as NonEmptyStr,
                },
              }
            CodexSelectedNodeIdentityRefused { lock_node_key: _, cause: _ } =>
              TargetClosureAcquisitionFailed {
                acquisition: RegistryArtifactDownloadRefused {
                  locator: "identity-refused" as NonEmptyStr,
                },
              }
            CodexSelectedNodeAdmitted {
              node: _,
              artifact: p_art,
              lock_node_key: p_key,
            } =>
              match acquire_and_admit_registry_artifact(
                artifact: p_art,
                lock_node_key: p_key,
                dest_dir: dest_dir,
              ) {
                RegistryArtifactAdmitted { staged: p_staged } =>
                  TargetClosureAcquisitionOk {
                    admitted: [w_staged, p_staged],
                  }
                other => TargetClosureAcquisitionFailed { acquisition: other }
              }
          }
        other => TargetClosureAcquisitionFailed { acquisition: other }
      }
  }
}

fn seed_npm_cache_from_admitted(
  cache: FilePath,
  admitted: List<StagedAdmittedPackageArtifact>,
) -> FilePath? {
  fold(
    admitted,
    init: none,
    f: (fail, staged) => match fail {
      Present { value: _ } => fail
      Absent => {
        let added = npm.Cache.Add(
          cache: cache,
          tarball: staged.local_artifact_path,
        )
        if added.success == false {
          Present { value: staged.local_artifact_path }
        } else {
          none
        }
      }
    },
  )
}

fn durable_admitted_receipts(
  staged: List<StagedAdmittedPackageArtifact>,
) -> List<AdmittedPackageArtifactReceipt> {
  match staged.skip(n: 0).first() {
    Absent => [] as List<AdmittedPackageArtifactReceipt>
    Present { value: a } =>
      match staged.skip(n: 1).first() {
        Absent => [a.receipt]
        Present { value: b } => [a.receipt, b.receipt]
      }
  }
}

fn finish_codex_runtime_materialization_after_install(
  build_root: FilePath,
  staging_dir: FilePath,
  cache_dir: FilePath,
  man_dest: FilePath,
  lock_dest: FilePath,
  native_path: FilePath,
  native_executable_rel: NonEmptyStr,
  platform_lock_key: NonEmptyStr,
  selected_target: CodexNpmRuntimeTarget,
  staged_admitted: List<StagedAdmittedPackageArtifact>,
  release_parent: FilePath,
) -> CodexRuntimeMaterialization {
  let durable = durable_admitted_receipts(staged: staged_admitted)
  match observe_admitted_package_set_identity(
    receipts: durable,
    staging_dir: staging_dir,
  ) {
    Absent => CodexRuntimeIdentityObservationRefused
    Present { value: set_id } =>
      match observe_file_sha512(path: man_dest) {
        Absent =>
          CodexRuntimeReceiptObservationRefused {
            cause: "installed manifest digest observation refused" as NonEmptyStr,
          }
        Present { value: man_digest } =>
          match observe_file_sha512(path: lock_dest) {
            Absent =>
              CodexRuntimeReceiptObservationRefused {
                cause: "installed lock digest observation refused" as NonEmptyStr,
              }
            Present { value: lock_digest } =>
              match observe_file_sha512(path: native_path) {
                Absent =>
                  CodexRuntimeReceiptObservationRefused {
                    cause: "native executable digest observation refused" as NonEmptyStr,
                  }
                Present { value: native_digest } =>
                  match observe_codex_build_toolchain() {
                    Absent =>
                      CodexRuntimeReceiptObservationRefused {
                        cause: "npm/node toolchain observation refused" as NonEmptyStr,
                      }
                    Present { value: toolchain } =>
                      match observe_protocol_schema_identity(
                        native_executable: native_path,
                        work_dir: build_root,
                      ) {
                        Absent =>
                          CodexRuntimeReceiptObservationRefused {
                            cause: "canonical protocol schema bundle identity observation refused" as NonEmptyStr,
                          }
                        Present { value: protocol_id } =>
                          match observe_package_materialized_tree(
                            root: build_root,
                            work_dir: staging_dir,
                          ) {
                            PackageMaterializedTreeObservationRefused { cause: tree_cause } =>
                              CodexRuntimeReceiptObservationRefused {
                                cause: tree_cause,
                              }
                            PackageMaterializedTreeObserved { receipt: tree } => {
                              let ordered = sort_admitted_packages_by_lock_key(receipts: durable)
                              let receipt0 = CodexRuntimeBundleReceipt {
                                manifest_digest: man_digest,
                                lock_digest: lock_digest,
                                target: selected_target,
                                admitted_packages: ordered,
                                admitted_package_set_identity: set_id,
                                materialized_tree: tree,
                                native_executable_digest: native_digest,
                                toolchain: toolchain,
                                protocol_schema_identity: protocol_id,
                                receipt_identity: set_id,
                              }
                              match observe_codex_runtime_bundle_receipt_identity(
                                receipt_without_identity: receipt0,
                                staging_dir: staging_dir,
                              ) {
                                Absent =>
                                  CodexRuntimeReceiptObservationRefused {
                                    cause: "receipt identity observation refused" as NonEmptyStr,
                                  }
                                Present { value: receipt_id } => {
                                  let receipt = CodexRuntimeBundleReceipt {
                                    manifest_digest: man_digest,
                                    lock_digest: lock_digest,
                                    target: selected_target,
                                    admitted_packages: ordered,
                                    admitted_package_set_identity: set_id,
                                    materialized_tree: tree,
                                    native_executable_digest: native_digest,
                                    toolchain: toolchain,
                                    protocol_schema_identity: protocol_id,
                                    receipt_identity: receipt_id,
                                  }
                                  match release_codex_runtime_bundle_immutable(
                                    build_root: build_root,
                                    receipt: receipt,
                                    native_executable_rel: native_executable_rel,
                                    scratch_dir: staging_dir,
                                    release_parent: release_parent,
                                  ) {
                                    CodexRuntimeReleaseReady { root: release_root } => {
                                      let _ = shell.Remove.RecursiveForce(path: staging_dir)
                                      let _ = shell.Remove.RecursiveForce(path: cache_dir)
                                      CodexRuntimeMaterialized {
                                        bundle: CodexRuntimeBundle {
                                          root: release_root,
                                          native_executable_rel: native_executable_rel,
                                          wrapper_executable_rel: codex_bundle_executable_rel,
                                          platform_package_rel: platform_lock_key,
                                          target: selected_target,
                                          admitted_packages: ordered,
                                          admitted_package_set_identity: set_id,
                                          receipt: receipt,
                                        },
                                      }
                                    }
                                    CodexRuntimeReleaseFailed { cause } =>
                                      CodexRuntimeReleaseRefused { cause: cause }
                                    CodexRuntimeReleaseReuseMismatch {
                                      existing_root,
                                      cause,
                                    } =>
                                      CodexRuntimeMaterializationReuseMismatch {
                                        existing_root: existing_root,
                                        cause: cause,
                                      }
                                  }
                                }
                              }
                            }
                          }
                      }
                  }
              }
          }
      }
  }
}

fn materialize_codex_runtime_bundle(
  source: AdmittedCodexRuntimeSource,
  release_parent: FilePath,
) -> CodexRuntimeMaterialization {
  match require_npm_host_dependency_for_materialization() {
    Present { value: refused } => refused
    Absent =>
      match admit_codex_package_lock_text(text: source.lock_bytes) {
    CodexPackageLockAdmitted { graph, nodes: _, registry_artifacts: _ } =>
      match observe_codex_npm_runtime_target() {
        CodexNpmRuntimeTargetObserved { target } =>
          match select_codex_exact_target_closure(graph: graph, target: target) {
            CodexExactTargetClosureSelected {
              wrapper,
              platform,
              target: selected_target,
              platform_lock_key,
              native_executable_rel,
            } => {
              let staging = shell.Mktemp.Dir()
              if staging.success == false {
                CodexRuntimeWorkspaceRefused {
                  cause: "staging mktemp failed" as NonEmptyStr,
                }
              } else {
                match acquire_and_admit_selected_pair(
                  wrapper: wrapper,
                  platform: platform,
                  dest_dir: staging.path,
                ) {
                  TargetClosureAcquisitionFailed { acquisition } =>
                    CodexRuntimeAcquisitionRefused { acquisition: acquisition }
                  TargetClosureAcquisitionOk { admitted } => {
                    let cache = shell.Mktemp.Dir()
                    if cache.success == false {
                      CodexRuntimeWorkspaceRefused {
                        cause: "cache mktemp failed" as NonEmptyStr,
                      }
                    } else {
                      match seed_npm_cache_from_admitted(
                        cache: cache.path,
                        admitted: admitted,
                      ) {
                        Present { value: failed_path } =>
                          CodexRuntimeCacheSeedRefused {
                            path: failed_path,
                            stderr: "npm cache add refused" as String,
                          }
                        Absent => {
                          let build = shell.Mktemp.Dir()
                          if build.success == false {
                            CodexRuntimeWorkspaceRefused {
                              cause: "build mktemp failed" as NonEmptyStr,
                            }
                          } else {
                            let man_dest = concat(
                              build.path as String,
                              "/package.json",
                            ) as FilePath
                            let lock_dest = concat(
                              build.path as String,
                              "/package-lock.json",
                            ) as FilePath
                            let wrote_man = Filesystem.Write(
                              path: man_dest as String,
                              content: source.manifest_bytes,
                            )
                            let wrote_lock = Filesystem.Write(
                              path: lock_dest as String,
                              content: source.lock_bytes,
                            )
                            if wrote_man.success == false {
                              CodexRuntimeWorkspaceRefused {
                                cause: "write admitted package.json bytes failed" as NonEmptyStr,
                              }
                            } else if wrote_lock.success == false {
                              CodexRuntimeWorkspaceRefused {
                                cause: "write admitted package-lock.json bytes failed" as NonEmptyStr,
                              }
                            } else {
                              let installed = npm.Ci.IgnoreScriptsOffline(
                                workdir: build.path,
                                cache: cache.path,
                              )
                              if installed.success == false {
                                CodexRuntimeNpmCiOfflineRefused {
                                  stderr: installed.stderr,
                                }
                              } else {
                                let native_path = concat(
                                  build.path as String,
                                  concat("/", native_executable_rel as String),
                                ) as FilePath
                                let plat_path = concat(
                                  build.path as String,
                                  concat("/", platform_lock_key as String),
                                ) as FilePath
                                let native_present = shell.Test.IsFile(path: native_path)
                                let plat_present = shell.Test.IsDirectory(path: plat_path)
                                if native_present.is_file == false {
                                  CodexRuntimeExecutableAbsent { path: native_path }
                                } else if plat_present.is_directory == false {
                                  CodexRuntimePlatformPackageAbsent { path: plat_path }
                                } else {
                                  finish_codex_runtime_materialization_after_install(
                                    build_root: build.path,
                                    staging_dir: staging.path,
                                    cache_dir: cache.path,
                                    man_dest: man_dest,
                                    lock_dest: lock_dest,
                                    native_path: native_path,
                                    native_executable_rel: native_executable_rel,
                                    platform_lock_key: platform_lock_key,
                                    selected_target: selected_target,
                                    staged_admitted: admitted,
                                    release_parent: release_parent,
                                  )
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            other => CodexRuntimeExactClosureRefused { closure: other }
          }
        other => CodexRuntimeTargetObservationRefused { observation: other }
      }
    other => CodexRuntimeLockRefused { admission: other }
      }
  }
}

data spark_serving_ollama_runtime_materialization_note: String = "Archive admission only — NOT runtime install. Downloads the cited extdeps.ollama.binary_release archive, admits SHA-256, writes gunbc.spark_serving_runtime_receipt, then deletes the staging copy (local_path is not consumed downstream because nothing extracts). Does not extract, place bin/ollama, enable gunbc-spark-serving.service, or pull gpt-oss:20b. This PR cannot make srv5/srv6 answer — it pairs the receipt writer with the wet observer. Full install is #8225 follow-on; fleet registration is #8230."

type SparkServingOllamaArchiveAdmission
  = SparkServingOllamaArchiveAdmitted {
      local_path: FilePath
      digest_hex: NonEmptyStr
    }
  | SparkServingOllamaArchiveDownloadRefused {
      locator: NonEmptyStr
    }
  | SparkServingOllamaArchiveIntegrityRefused {
      cause: NonEmptyStr
    }

type SparkServingOllamaRuntimeMaterialization
  = SparkServingOllamaRuntimeMaterialized {
      receipt: SparkServingRuntimeInstallReceipt
    }
  | SparkServingOllamaRuntimeDownloadRefused {
      locator: NonEmptyStr
    }
  | SparkServingOllamaRuntimeIntegrityRefused {
      cause: NonEmptyStr
    }
  | SparkServingOllamaRuntimeReceiptWriteRefused {
      cause: NonEmptyStr
    }
  | SparkServingOllamaRuntimeWorkspaceRefused {
      cause: NonEmptyStr
    }

fn spark_serving_ollama_runtime_materialization_receipt_write_path() -> FilePath {
  spark_serving_runtime_receipt_wire_path()
}

fn acquire_and_admit_ollama_release_archive(
  binary_release: OllamaBinaryRelease,
  dest_dir: FilePath,
) -> SparkServingOllamaArchiveAdmission {
  let locator = ollama_binary_release_download_locator(binary_release: binary_release)
  let dest = concat(
    dest_dir as String,
    concat("/", ollama_binary_release_asset_name(binary_release: binary_release) as String),
  ) as FilePath
  let downloaded = http.Client.DownloadToFile(
    url: locator,
    destination: dest as NonEmptyStr,
  )
  if downloaded.success == false {
    SparkServingOllamaArchiveDownloadRefused { locator: locator }
  } else {
    match sha256sum_verify_via_shell(
      path: dest as NonEmptyStr,
      expected_digest: binary_release.digest.hex,
    ) {
      Sha256Matches =>
        SparkServingOllamaArchiveAdmitted {
          local_path: dest,
          digest_hex: binary_release.digest.hex,
        }
      Sha256Mismatch =>
        SparkServingOllamaArchiveIntegrityRefused {
          cause: "ollama release archive sha256 mismatch" as NonEmptyStr,
        }
      Sha256VerifyInfraFailure { reason } =>
        SparkServingOllamaArchiveIntegrityRefused { cause: reason }
    }
  }
}

fn materialize_spark_serving_ollama_runtime_bundle(
  host: HostIdentity,
) -> SparkServingOllamaRuntimeMaterialization {
  let staging = shell.Mktemp.Dir()
  if staging.success == false {
    SparkServingOllamaRuntimeWorkspaceRefused {
      cause: "staging mktemp failed" as NonEmptyStr,
    }
  } else {
    match acquire_and_admit_ollama_release_archive(
      binary_release: ollama_required_release,
      dest_dir: staging.path,
    ) {
      SparkServingOllamaArchiveDownloadRefused { locator } =>
        SparkServingOllamaRuntimeDownloadRefused { locator: locator }
      SparkServingOllamaArchiveIntegrityRefused { cause } =>
        SparkServingOllamaRuntimeIntegrityRefused { cause: cause }
      SparkServingOllamaArchiveAdmitted { local_path: _, digest_hex } => {
        let receipt = SparkServingRuntimeInstallReceipt {
          host: host,
          release_asset_digest_hex: digest_hex,
        }
        if write_spark_serving_runtime_install_receipt(receipt: receipt) {
          let _ = shell.Remove.RecursiveForce(path: staging.path)
          SparkServingOllamaRuntimeMaterialized { receipt: receipt }
        } else {
          let _ = shell.Remove.RecursiveForce(path: staging.path)
          SparkServingOllamaRuntimeReceiptWriteRefused {
            cause: "install receipt write refused" as NonEmptyStr,
          }
        }
      }
    }
  }
}
