data pi_reach_observe_authority_note: String = "PI-REACH-0 observe producer (2026-08-07). Execution locus is srv1 via adopt-rack-pi workflow_dispatch. Workflow-local shell bracket (umask 077, mktemp, trap) materializes fleet-automation-ssh-key before gunbc runs; gunbc reads PI_OBSERVE_KEY_PATH / PI_OBSERVE_KNOWN_HOSTS_PATH / PI_OBSERVE_WORK_DIR from env. Secret fetch uses #7995 decode_sm_access_version_wire_response via fetch_secret_ref_credential. Pi SSH uses briansrls@192.168.1.197 with attempt-scoped known_hosts."

type PiObserveKeyPaths {
  work_dir: String
  key_path: String
  known_hosts_path: String
}

type CleanupStanding
  = CleanupObservedAbsent
  | CleanupObservedPresent
  | CleanupUnobserved
  | CleanupNotApplicable

data pi_observe_workflow_key_env_note: String = "Workflow bracket exports PI_OBSERVE_WORK_DIR, PI_OBSERVE_KEY_PATH, PI_OBSERVE_KNOWN_HOSTS_PATH before pi_reach_observe_dispatch. pi_reach_write_fleet_ssh_key_to_path runs in the same shell after umask 077 so file creation inherits mode."

type PiReachJsonQuotedFieldRead
  = PiReachJsonQuotedFieldPresent { value: String }
  | PiReachJsonQuotedFieldAbsent
  | PiReachJsonQuotedFieldUnparseable

fn pi_reach_extract_quoted_value_after_needle(body: String, needle: String) -> String? {
  match split(s: body, delimiter: needle) |> skip(n: 1) |> first {
    Present { value: after } =>
      match split(s: after, delimiter: "\"") |> first {
        Present { value: extracted } => Present { value: extracted }
        Absent => none
      }
    Absent => none
  }
}

fn pi_reach_extract_json_quoted_field(body: String, field: String) -> PiReachJsonQuotedFieldRead {
  let compact_needle = concat(concat("\"", concat(field, "\":\"")), "")
  let spaced_needle = concat(concat("\"", concat(field, "\": \"")), "")
  if string_contains(s: body, pattern: compact_needle) {
    match pi_reach_extract_quoted_value_after_needle(body: body, needle: compact_needle) {
      Present { value: extracted } => PiReachJsonQuotedFieldPresent { value: extracted }
      Absent => PiReachJsonQuotedFieldUnparseable
    }
  } else if string_contains(s: body, pattern: spaced_needle) {
    match pi_reach_extract_quoted_value_after_needle(body: body, needle: spaced_needle) {
      Present { value: extracted } => PiReachJsonQuotedFieldPresent { value: extracted }
      Absent => PiReachJsonQuotedFieldUnparseable
    }
  } else if string_contains(s: body, pattern: concat("\"", concat(field, "\""))) {
    PiReachJsonQuotedFieldUnparseable
  } else {
    PiReachJsonQuotedFieldAbsent
  }
}

