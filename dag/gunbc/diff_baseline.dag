module gunbc.diff_baseline

import std.types { String, GitRef }
import std.logic { Bool }
import extdeps.git { GitRemoteRefParts, git_remote_ref }
import extdeps.git.hooks { zero_sha }
import extdeps.git.object_store { GitObjectId, git_object_id_wire_hex }
import extdeps.session_dashboard.change_window {
  DashboardReplayObservation,
  DashboardExactReplayObserved,
  DashboardReplayMalformed,
  DashboardReplayReadRefused,
  GitClaimedMergeBaseRelation
}
import extdeps.github.actions {
  github_event_name_pull_request,
  github_event_name_push,
  github_event_name_workflow_dispatch,
  github_event_name_merge_group,
  github_event_name_schedule
}

data diff_baseline_law: String = "DiffBaseline is the typed answer to 'what does the affected-set diff observe HEAD against?' — the de-fork of the origin/main policy-as-literal (DESIGN §3(c)). Arms: MergeTarget (pull_request GITHUB_BASE_REF branch name only → origin/<branch>, merge-base/triple-dot), ExactReplayBoundary (dashboard GUNBC_CI_CHANGE_WINDOW_PATH exact base/head GitObjectIds, direct/two-dot), PushBefore (push payload before SHA), PushParent (default branch for non-PR CI events), OperatorOverride (GUNBC_CI_DIFF_BASE). resolve_diff_baseline is PURE over CiDiffEvent; env reads live in v2.workflow.floor_diff_observe.floor_observe_ci_diff_event."

data diff_baseline_fail_closed_law: String = "A CI event this resolver cannot map to a base REFUSES (BaselineRefused) — it never substitutes a constant. The refusal propagates through floor_diff_observe's UnifiedDiffFail / NameStatusDiffFail into the executor's diff observation (cli_run.rs floor_git_diff_range), which HALTS the floor with a typed AFFECTED-SET REFUSAL (cause=DiffObservationRefusal): 'refuses every enrolled row rather than widening to a full-corpus run' (operator ruling 2026-07-05). The ignorance state is a loud, located, HARD STOP — NOT a run-everything widen (an earlier draft of this note misdescribed it as widen-to-whole-tree; the executor refuses, it does not widen — DESIGN §5, the exact absorbing-fallback shape being avoided). Only a genuinely-unrecognized event name lands here: the five live workflow triggers (push / pull_request / workflow_dispatch / merge_group from ci_workflow, schedule from falsifier_workflow) all map to a base arm, so a future-added trigger halts loudly until it is modeled, rather than silently defaulting to origin/main — the exact defect being deleted, now typed."

data diff_baseline_bootstrap_arm_note: String = "The empty-event-name arm ('' — no GITHUB_EVENT_NAME) is an EXPLICIT recognized state, not the catch-all: it is the local / pre-CI-bootstrap window where there is no GitHub event at all, and its correct baseline is the repo's default merge target (PushParent), which is exactly today's behavior for a bare local floor_diff_observe invocation (DiffPolicy.base = origin/main). It is grouped with workflow_dispatch / merge_group / schedule because all mean 'observe against the default branch'. Push is NOT grouped here: a push event always requires a before SHA. The catch-all (a future GitHub trigger not yet modeled — ⊤-as-ignorance, genuinely not-knowing the base) is the final else → BaselineRefused, which HALTS the floor (never a silent origin/main). Conflating the two would be the absorbing fallback DESIGN §5 forbids; keeping them distinct keeps 'no CI event' (a known state, PushParent) apart from 'CI event we cannot map' (real ignorance, halt)."

data diff_baseline_push_before_law: String = "Push events resolve PushBefore from the webhook payload's before member (extdeps.github.push_event), NOT PushParent. Absent, empty, zero (0000000000000000000000000000000000000000 — new-branch creation per cited payload semantics, not observed in-repo), equal-to-head, or head-unknown before SHAs REFUSE: a push with no prior commit has no honest affected-set window; a before SHA equal to head is a self-compare; and head unknown cannot rule out self-compare. Observation-layer refusals (unreadable event payload, malformed JSON) arrive as PushBeforeInputRefused and propagate with their computed cause — they never collapse to a generic absent. These refusals halt the floor; they never widen to origin/main. The baseline SOURCE (payload before SHA) stays separable from these policy arms so a future last-green source swap does not rewrite refusal logic."

data diff_baseline_merge_target_law: String = "pull_request MergeTarget reads GITHUB_BASE_REF as a GitHub TARGET BRANCH NAME only (extdeps.github.actions github_ci_event_surface_note). It always becomes origin/<branch> via git_remote_ref — even when the branch name is lexically 40 lowercase hex characters, because Git ref names are not reserved against object-id spellings and semantic kind cannot be recovered from text alone. Exact merge-base object identities belong in extdeps.session_dashboard.change_window (GUNBC_CI_CHANGE_WINDOW_PATH), never in GITHUB_BASE_REF."

data diff_baseline_exact_replay_law: String = "Dashboard exact replay selects ExactReplayBoundary with typed GitObjectId base/head from extdeps.session_dashboard.change_window. Git CLI operands are rendered only at the realization boundary via diff_baseline_diff_base/diff_baseline_diff_head (git_object_id_wire_hex). Comparison is direct/two-dot — not triple-dot — because the dashboard already claims the merge-base boundary. Repository availability, object kind, ancestry verification, and checkout/head pinning are PR-2 Git endpoint repairs; this arm still refuses malformed wire input and self-compare at parse time."

type DiffBaseline
  = MergeTarget { ref: GitRef }
  | ExactReplayBoundary {
      base: GitObjectId,
      head: GitObjectId,
      claimed_relation: GitClaimedMergeBaseRelation
    }
  | PushBefore { ref: GitRef }
  | PushParent { ref: GitRef }
  | OperatorOverride { ref: GitRef }

type PushBeforeInput
  = PushBeforeSha { sha: String }
  | PushBeforeZeroShaInput
  | PushBeforeInputRefused { reason: String }

type CiDiffEvent {
  override_ref: String?
  event_name: String
  base_ref: String?
  push_before: PushBeforeInput?
  head_sha: String?
  dashboard_replay: DashboardReplayObservation?
}

type DiffBaselineResolution
  = BaselineSelected { baseline: DiffBaseline }
  | BaselineRefused { reason: String }

fn diff_baseline_ref(b: DiffBaseline) -> GitRef {
  match b {
    MergeTarget { ref: r } => r
    ExactReplayBoundary { base: oid, head: _, claimed_relation: _ } =>
      git_object_id_wire_hex(oid: oid) as GitRef
    PushBefore { ref: r } => r
    PushParent { ref: r } => r
    OperatorOverride { ref: r } => r
  }
}

fn diff_baseline_diff_base(b: DiffBaseline) -> String {
  match b {
    ExactReplayBoundary { base: oid, head: _, claimed_relation: _ } =>
      git_object_id_wire_hex(oid: oid) as String
    MergeTarget { ref: r } => r as String
    PushBefore { ref: r } => r as String
    PushParent { ref: r } => r as String
    OperatorOverride { ref: r } => r as String
  }
}

fn diff_baseline_diff_head(b: DiffBaseline, default_head: String) -> String {
  match b {
    ExactReplayBoundary { base: _, head: oid, claimed_relation: _ } =>
      git_object_id_wire_hex(oid: oid) as String
    MergeTarget { ref: _ } => default_head
    PushBefore { ref: _ } => default_head
    PushParent { ref: _ } => default_head
    OperatorOverride { ref: _ } => default_head
  }
}

fn diff_baseline_is_exact_replay(b: DiffBaseline) -> Bool {
  match b {
    ExactReplayBoundary { base: _, head: _, claimed_relation: _ } => true
    MergeTarget { ref: _ } => false
    PushBefore { ref: _ } => false
    PushParent { ref: _ } => false
    OperatorOverride { ref: _ } => false
  }
}

fn resolve_dashboard_replay(observation: DashboardReplayObservation?) -> DiffBaselineResolution? {
  match observation {
    Absent => none
    Present { value: DashboardExactReplayObserved { base: base, head: head, claimed_relation: relation, producer: _ } } =>
      Present {
        value: BaselineSelected {
          baseline: ExactReplayBoundary {
            base: base,
            head: head,
            claimed_relation: relation
          }
        }
      }
    Present { value: DashboardReplayMalformed { detail: detail } } =>
      Present {
        value: BaselineRefused {
          reason: concat("dashboard exact replay malformed — ", concat(detail, "; halting the floor (AFFECTED-SET REFUSAL)"))
        }
      }
    Present { value: DashboardReplayReadRefused { path: path, cause: cause } } =>
      Present {
        value: BaselineRefused {
          reason: concat(
            concat("dashboard exact replay unreadable at ", concat(path, " — ")),
            concat(cause, "; halting the floor (AFFECTED-SET REFUSAL)")
          )
        }
      }
  }
}

fn resolve_merge_target(base_ref: String?, default_remote_name: String) -> DiffBaselineResolution {
  match base_ref {
    Present { value: b } =>
      if b == "" {
        BaselineRefused { reason: "pull_request event but GITHUB_BASE_REF is empty — cannot derive merge target; halting the floor (AFFECTED-SET REFUSAL)" }
      } else {
        BaselineSelected {
          baseline: MergeTarget {
            ref: git_remote_ref(parts: GitRemoteRefParts { remote: default_remote_name, ref_name: b })
          }
        }
      }
    Absent =>
      BaselineRefused { reason: "pull_request event but GITHUB_BASE_REF is unset — cannot derive merge target; halting the floor (AFFECTED-SET REFUSAL)" }
  }
}

fn resolve_push_before(push_before: PushBeforeInput?, head_sha: String?) -> DiffBaselineResolution {
  match push_before {
    Absent =>
      BaselineRefused {
        reason: "push event but before SHA observation is absent — cannot derive affected-set baseline; halting the floor (AFFECTED-SET REFUSAL)"
      }
    Present { value: PushBeforeInputRefused { reason: reason } } =>
      BaselineRefused { reason: reason }
    Present { value: PushBeforeZeroShaInput } =>
      BaselineRefused {
        reason: "push event before SHA is the zero SHA (new branch creation) — no prior commit to diff against; halting the floor (AFFECTED-SET REFUSAL)"
      }
    Present { value: PushBeforeSha { sha: before } } =>
      if before == "" {
        BaselineRefused {
          reason: "push event but before SHA is empty — cannot derive affected-set baseline; halting the floor (AFFECTED-SET REFUSAL)"
        }
      } else if before == zero_sha {
        BaselineRefused {
          reason: "push event before SHA is the zero SHA (new branch creation) — no prior commit to diff against; halting the floor (AFFECTED-SET REFUSAL)"
        }
      } else {
        match head_sha {
          Absent =>
            BaselineRefused {
              reason: "push event but GITHUB_SHA is unset — cannot verify before≠head; halting the floor (AFFECTED-SET REFUSAL)"
            }
          Present { value: head } =>
            if head == "" {
              BaselineRefused {
                reason: "push event but GITHUB_SHA is empty — cannot verify before≠head; halting the floor (AFFECTED-SET REFUSAL)"
              }
            } else if before == head {
              BaselineRefused {
                reason: "push event before SHA equals head — self-compare refused; halting the floor (AFFECTED-SET REFUSAL)"
              }
            } else {
              BaselineSelected { baseline: PushBefore { ref: before as GitRef } }
            }
        }
      }
  }
}

fn resolve_diff_baseline_by_event(
  event: CiDiffEvent,
  push_parent_ref: GitRef,
  default_remote_name: String
) -> DiffBaselineResolution {
  if event.event_name == github_event_name_pull_request {
    resolve_merge_target(base_ref: event.base_ref, default_remote_name: default_remote_name)
  } else if event.event_name == github_event_name_push {
    resolve_push_before(push_before: event.push_before, head_sha: event.head_sha)
  } else if event.event_name == github_event_name_workflow_dispatch
    || event.event_name == github_event_name_merge_group
    || event.event_name == github_event_name_schedule
    || event.event_name == "" {
    BaselineSelected { baseline: PushParent { ref: push_parent_ref } }
  } else {
    BaselineRefused {
      reason: concat(concat("unrecognized CI event '", event.event_name), "' for diff-baseline selection — halting the floor (AFFECTED-SET REFUSAL)")
    }
  }
}

fn resolve_diff_baseline(
  event: CiDiffEvent,
  push_parent_ref: GitRef,
  default_remote_name: String
) -> DiffBaselineResolution {
  match resolve_dashboard_replay(observation: event.dashboard_replay) {
    Present { value: dashboard_res } => dashboard_res
    Absent =>
      match event.override_ref {
        Present { value: r } =>
          if r == "" {
            resolve_diff_baseline_by_event(
              event: event,
              push_parent_ref: push_parent_ref,
              default_remote_name: default_remote_name
            )
          } else {
            BaselineSelected { baseline: OperatorOverride { ref: r as GitRef } }
          }
        Absent =>
          resolve_diff_baseline_by_event(
            event: event,
            push_parent_ref: push_parent_ref,
            default_remote_name: default_remote_name
          )
      }
  }
}
