module gunbc.native_route_refusal_summary_seed_growth

import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data native_route_refusal_summary_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.cli_run.native_lane_runner",
      decl_name: "native_file_refusal_summary",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.cli_run.native_lane_runner",
      decl_name: "file_refusal_at_text",
      field: WholeDeclaration
    }
  ],

  reason: "Renders the native route's per-file refusals, which the emitted binary already prints as file_refusal rows carrying path and a non-empty located chain whose head and last links give the head and fatal reasons (v2.compiler.native_test_vocabulary NativeTestFileRefusal). It decides nothing: it groups the fatal causes, names each refused file, and prints the chain head only as an advisory beside the cause. Before it, the summary carried a count and the identities lived only in driver-rows.jsonl, where the head (identical on every file) was read as the cause three times. The host is where the rows are decoded today, so the rendering sits beside the decoder rather than in a second reader. file_refusal_at_text (2026-10-03) renders the fatal link's typed position (v2.compiler.native_test_vocabulary FileRefusalAt) beside each refused file; it decides nothing either, and an arm it does not know refuses the decode.",

  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,

  trigger: "Delete this declaration when the native lane's row decode and summary are emitted from a .dag fold over NativeTestFileRefusal rather than hand-decoded in native_lane_runner, SUFFICIENT FOR a native-route run (gunbc test over the //v2/test/... universe, or claim_executor's required native lane) to print each refused file with its fatal cause and advisory head with no hand-authored rendering.",

  current_boundary: "src/v1/stage0/src/cli_run/native_lane_runner.rs native_file_refusal_summary, called once from run_required_v2_native_inner after the population line; reached through run_required_v2_native by gunbc test over the native route universe and by claim_executor"
}
