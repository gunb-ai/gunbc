module gunbc.kimi_code_k2_8_preview_observation

import std.types { NonEmptyStr, List }
import extdeps.moonshot.kimi_code_k2_8_preview {
  KimiCodeAliasAssignment,
  kimi_for_coding_wire_id,
  kimi_for_coding_k28_preview_assignment,
}

// RECEIPTS ABOUT THIS REPOSITORY'S COVERAGE OF THE KIMI CODE K2.8 PREVIEW SERVICE, not facts the
// vendor published. DESIGN §3: observations live in the observing product layer; Missing coverage
// is never an Unobserved property inside extdeps.moonshot.kimi_code_k2_8_preview.

data kimi_k28_checkpoint_search_observed_on: NonEmptyStr = "2026-09-11" as NonEmptyStr

type KimiCodeExecutedVersionStanding
  = ExecutedVersionUnobserved { reason: NonEmptyStr }
  | ExecutedVersionObserved { version: NonEmptyStr, receipt: NonEmptyStr }

type KimiCodeVersionEvidence
  = RequestedModelIdEvidence { model_id: NonEmptyStr }
  | ProviderDeclaredServedVersionEvidence { assignment: KimiCodeAliasAssignment }
  | ExecutedVersionEvidence { standing: KimiCodeExecutedVersionStanding }

data kimi_code_executed_version_without_receipt: KimiCodeExecutedVersionStanding = ExecutedVersionUnobserved {
  reason: "no version-bearing execution receipt observed" as NonEmptyStr,
}

data kimi_code_requested_id_evidence: KimiCodeVersionEvidence = RequestedModelIdEvidence {
  model_id: kimi_for_coding_wire_id,
}

data kimi_code_provider_declared_served_version_evidence: KimiCodeVersionEvidence = ProviderDeclaredServedVersionEvidence {
  assignment: kimi_for_coding_k28_preview_assignment,
}

data kimi_code_executed_version_evidence: KimiCodeVersionEvidence = ExecutedVersionEvidence {
  standing: kimi_code_executed_version_without_receipt,
}

type KimiK28SearchedSurface
  = MoonshotHuggingFaceOrg { locator: NonEmptyStr }
  | MoonshotGitHubOrg { locator: NonEmptyStr }
  | MoonshotModelScopeOrg { locator: NonEmptyStr }

data kimi_k28_hf_org_surface: KimiK28SearchedSurface = MoonshotHuggingFaceOrg {
  locator: "huggingface.co/moonshotai" as NonEmptyStr,
}

data kimi_k28_github_org_surface: KimiK28SearchedSurface = MoonshotGitHubOrg {
  locator: "github.com/MoonshotAI" as NonEmptyStr,
}

data kimi_k28_modelscope_org_surface: KimiK28SearchedSurface = MoonshotModelScopeOrg {
  locator: "www.modelscope.cn/organization/moonshotai" as NonEmptyStr,
}

type KimiK28ArtifactStanding
  = OfficialCheckpointLocated { locator: NonEmptyStr, observed_at: NonEmptyStr }
  | CheckpointNotLocatedOnSearchedSurfaces {
      observed_at: NonEmptyStr
      searched_surfaces: List<KimiK28SearchedSurface>
      known_unsearched_official_surfaces: List<KimiK28SearchedSurface>
      trigger: NonEmptyStr
    }

data kimi_k28_artifact_standing: KimiK28ArtifactStanding = CheckpointNotLocatedOnSearchedSurfaces {
  observed_at: kimi_k28_checkpoint_search_observed_on,
  searched_surfaces: [kimi_k28_hf_org_surface, kimi_k28_github_org_surface],
  known_unsearched_official_surfaces: [kimi_k28_modelscope_org_surface],
  trigger: "an official K2.8 checkpoint published on any official Moonshot surface, including a surface not in this search, with a citable revision" as NonEmptyStr,
}
