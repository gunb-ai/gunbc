module gunbc.compile_clean_diagnostic_policy

import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type UnlistedImportUseEnforcement
  = FloorNotYet
  | Enforced

data unlisted_import_use_enforcement_note: String = "Single policy authority for whether UnlistedImportUse blocks compile-clean (issue 11 / ci-floor-child-spawn-attribution section 7). FloorNotYet = advisory (current namespace-lane staging: the resolver emits UnlistedImportUse but compile-clean does not red). Enforced = blocking (terminal promotion when namespace-only resolution deletes the import grammar — DISSOLVES WHEN UnlistedImportUse promoted to an error per namespace_import_closure_behavioral_transport.dag:15). BOTH the floor receipt path (consume_floor_compile_clean_gate_verdict via floor_compile_clean_emit_ok_via_index) and the standalone CLI transport (gunbc compile --target dag) read this row — never restate the predicate in either consumer (DESIGN section 3)."

data compile_clean_unlisted_import_use_enforcement: UnlistedImportUseEnforcement = FloorNotYet

data compile_clean_unlisted_import_use_enforcement_dissolve_on: String = "dissolve-on: compile_clean_unlisted_import_use_enforcement — DISSOLVES WHEN v1 04_resolve promotes UnlistedImportUse to an error (namespace_import_closure_behavioral_transport.dag:15 scaffold dissolution trigger); the row flips to Enforced and both consumers (floor_compile_clean_emit_ok_via_index + CLI) red together via compile_clean_unlisted_import_use_blocks()."

data compile_clean_diagnostic_policy_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.compile_clean_diagnostic_policy",
    decl_name: "compile_clean_unlisted_import_use_enforcement",
    field: WholeDeclaration
  }
}

fn unlisted_import_use_blocks_compile_clean(enforcement: UnlistedImportUseEnforcement) -> Bool {
  match enforcement {
    FloorNotYet => false
    Enforced => true
  }
}

fn compile_clean_unlisted_import_use_blocks() -> Bool {
  unlisted_import_use_blocks_compile_clean(
    enforcement: compile_clean_unlisted_import_use_enforcement
  )
}

type UnlistedImportBindingSource
  = ListedImport
  | PoolCoincidence
  | DefinerResolvable

data unlisted_import_binding_source_note: String = "Binding-source attribution for the UnlistedImportUse census (issue 11). ListedImport = the referencing module has an import edge to the definer module but the specific name is absent from that import's name list (classic selective-import SVN miss). PoolCoincidence = no import edge to the definer; the name resolves only because the definer module is already in the compilation pool via an unrelated import elsewhere (#6985 Class B). DefinerResolvable = the reference binds via namespace/containment (qualified projection) without an import edge or pool accident — the terminal namespace-lane shape every row must eventually reach."

data unlisted_import_use_census_hand_rust_dissolve_trigger: String = "dissolve-on: compile_clean_unlisted_import_census hand-Rust transport (CLI_RUN_COMPILE_CLEAN_UNLISTED_IMPORT_CENSUS_SCAFFOLD_MARKER) — DISSOLVES WHEN namespace-only resolution deletes the import grammar and binding-source classification is modeled in the substrate (namespace-resolution-design.md section 8), or a floor-enrolled census lens subsumes the host transport; receipt rg cli_run_compile_clean_unlisted_import_census src/v1/stage0 == 1 until deletion."

data unlisted_import_use_census_hand_rust_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.compile_clean_diagnostic_policy",
    decl_name: "unlisted_import_use_census_hand_rust_dissolve_trigger",
    field: WholeDeclaration
  }
}
