    ceiling: MechanicallyFixableNow {
      repair: "list the variant in the import of its parent type (the grammar admits variant names in import lists; e.g. import v2.std.optional { Optional, Present, Absent }). The class exists separately from UnlistedImportUse on purpose -- v1.std.core's note on the variant records that the emitter's use-line synthesis must stay blind to it -- but the AUTHOR-SIDE repair is the same mechanical shape."
    },
    census: DeclarationRef {
      module_path: "gunbc.instrument_targets",
      decl_name: "compile_clean_advisory_census_binding",
      field: WholeDeclaration
    }
  },
  AdvisoryClassCeilingRow {
    class_name: "ServiceConfigReferenceJudgmentDeferred" as NonEmptyStr,
    ceiling: DeclaredAdmissionRoster {
      roster: DeclarationRef {
        module_path: "v1.std.core",
        decl_name: "service_config_field_for_property_name",
        field: WholeDeclaration
      }
    },
    census: DeclarationRef {
      module_path: "gunbc.instrument_targets",
