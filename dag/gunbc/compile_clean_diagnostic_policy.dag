      field: WholeDeclaration
    }
  },
  AdvisoryClassCeilingRow {
    class_name: "WhereRefinementUnenforced" as NonEmptyStr,
    ceiling: WallAfterGrounding {
      missing_capability: "refinement evidence at non-literal positions (refinement subtyping / parameter evidence): the check is decidable -- evidence present or not -- but the carrier is not modeled, and hard-refusing every non-literal site was measured to break dag_compile_clean across the Octet/Port/Milliseconds migration surfaces (extdeps.pin pin_refresh_window_positivity_note). Reasons observed: 'non-literal value at refined position' and 'predicate deferred at compile time'. Trigger authority: where_refinement_deferral_reason_scaffold_note (feature:where-refinement-deferral-reason-authority)."
    },
    census: DeclarationRef {
