module gunbc.compile_clean_diagnostic_policy

import std.dissolution { DissolutionCondition, unbound_dissolution, dissolution_description }

import std.types { Int, NonEmptyStr, List }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type UnlistedImportUseEnforcement
  = FloorNotYet
  | Enforced

// Single policy authority for whether UnlistedImportUse blocks compile-clean (issue 11 /
// ci-floor-child-spawn-attribution section 7). FloorNotYet = advisory (current namespace-lane
// staging: the resolver emits UnlistedImportUse but compile-clean does not red). Enforced =
// blocking (terminal promotion when namespace-only resolution deletes the import grammar —
// DISSOLVES WHEN UnlistedImportUse promoted to an error per
// namespace_import_closure_behavioral_transport.dag:15). CONSUMER TRUTH, corrected where this
// annotation previously overstated it: the floor receipt path
// (install_or_consume_floor_compile_clean_gate_receipt via floor_compile_clean_emit_ok_via_index)
// reads this row through compile_clean_unlisted_import_use_blocks; the standalone CLI (gunbc
// compile) does NOT — gunbc#8286 cut its policy read because the read mechanism was a full
// interpreter run over this module's closure to answer one Bool, and its classify_diagnostic
// consults is_interpreter_blocking_diagnostic alone. The flip's terminal shape therefore is not
// "both consumers read the row" but promotion in the single authority both already read:
// v1.std.core diagnostic_disposition gains UnlistedImportUse => GateBlocking, the override arm in
// compile_clean_diagnostic_is_hard deletes, and this row dissolves — both consumers red by
// construction, and no predicate is restated anywhere (DESIGN section 3).

data compile_clean_unlisted_import_use_enforcement: UnlistedImportUseEnforcement = FloorNotYet

data compile_clean_diagnostic_policy_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.compile_clean_diagnostic_policy",
    decl_name: "compile_clean_unlisted_import_use_enforcement",
    field: WholeDeclaration
  }
}

fn unlisted_import_use_blocks_compile_clean(enforcement: UnlistedImportUseEnforcement) -> Bool {
  match enforcement {
    FloorNotYet => false
    Enforced => true
  }
}

fn compile_clean_unlisted_import_use_blocks() -> Bool {
  unlisted_import_use_blocks_compile_clean(
    enforcement: compile_clean_unlisted_import_use_enforcement
  )
}

type UnlistedImportBindingSource
  = ListedImport
  | PoolCoincidence
  | DefinerResolvable

// Binding-source attribution for the UnlistedImportUse census (issue 11). ListedImport = the
// referencing module has an import edge to the definer module but the specific name is absent from
// that import's name list (classic selective-import SVN miss). PoolCoincidence = no import edge to
// the definer; the name resolves only because the definer module is already in the compilation pool
// via an unrelated import elsewhere (#6985 Class B). DefinerResolvable = the reference binds via
// namespace/containment (qualified projection) without an import edge or pool accident — the
// terminal namespace-lane shape every row must eventually reach.

data unlisted_import_use_census_hand_rust_dissolve_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: the UnlistedImportUse hand-Rust binding-source classification (CLI_RUN_COMPILE_CLEAN_UNLISTED_IMPORT_CENSUS_SCAFFOLD_MARKER: UnlistedImportBindingSource, classify_unlisted_import_binding_source, unlisted_import_rows_from_resolved and helpers, consumed by compile_clean_advisory_census) — DISSOLVES WHEN namespace-only resolution deletes the import grammar and binding-source classification is modeled in the substrate (namespace-resolution-design.md section 8), or a floor-enrolled census lens subsumes the host transport; receipt: the marker const stands until deletion. NOT SUBSUMED by the advisory census's reachability restoration: the census is the same hand-Rust transport made reachable, and the unmodeled-classification debt this trigger guards is unchanged.")

data unlisted_import_use_census_hand_rust_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.compile_clean_diagnostic_policy",
    decl_name: "unlisted_import_use_census_hand_rust_dissolve_trigger",
    field: WholeDeclaration
  }
}

data compile_clean_unlisted_import_use_enforcement_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: compile_clean_unlisted_import_use_enforcement — DISSOLVES WHEN UnlistedImportUse is promoted to GateBlocking in v1.std.core diagnostic_disposition (namespace_import_closure_behavioral_transport.dag:15 scaffold dissolution trigger), at which point the override arm in compile_clean_diagnostic_is_hard deletes with this row and both consumers — the floor receipt path and the standalone CLI — red through the single disposition authority, not through this staging row.")

// HOW BIG CONJUNCT (b) IS, MEASURED BY ITS AUTHORITY AND RECORDED AGAINST THE FLIP.
//
// compile_clean_unlisted_import_use_enforcement flips to Enforced on two conditions, and the second
// -- the corpus burndown of genuine unlisted uses reaching zero -- is sized by this row. A
// dissolution trigger whose remaining work is unmeasured cannot be scheduled, so the size lives at
// the one place the flip happens.
//
// THE PRODUCER IS THE RESTORED AUTHORITY CENSUS, AND THE READING IS CERTIFIED. The per-class
// advisory census runs as the rostered instrument target `gunbc test
// //gunbc/instruments:compile-clean-advisory-census` (gunbc.instrument_targets
// compile_clean_advisory_census_binding), reading the compiler's OWN diagnostics over the
// whole-tree compile-clean closure -- the same source set the floor gate compiles -- with
// binding-source attribution per row. read_as is CertifiedCount because the count is the
// resolver's emission and not an extractor's approximation: no filter decides what is scanned, so
// there is no position the instrument cannot see, and the stand-in's measured over-report is not
// constructible here -- a closure that compiles clean emits no row. Its routing is witnessed by
// test.claim.target_invocation_witness the_advisory_census_operand_routes_to_its_own_producer.
//
// THE STAND-IN READING THIS REPLACED, KEPT AS HISTORY BECAUSE THE FAILURE MODE IS GENERATIVE.
// Session clever-ibex-130's static extractor reported ~2,190 module/name pairs across 789 of 4,459
// modules at OrderOnlyBothDirections: over-reporting measured (it flagged extdeps.uri, whose
// `Optional` reference is not the class, in a closure measured compiling clean) and under-reporting
// unbounded (positions outside its filter were invisible; binding source unattributable). Its
// ten-row hand check found one false positive (a single-line inline coproduct whose variants read
// as undeclared references). That reading named an order -- roughly one module in six -- and nothing
// finer, and this row said so for its whole life. The first certified reading, at the flip, was
// different in both directions at once: FEWER modules carry the class (553, not 789) and MORE pairs
// survive the stricter key (1,648 against the stand-in's 2,190 was the over-report direction; the
// occurrence count was 4,621 at 3,704 distinct positions). The denominator also moved honestly:
// 4,057 is the modules the whole-tree closure actually compiles, not the corpus's file count. The
// certified reading is the instrument's and moves with the corpus -- the data row below carries the
// current one, and its first move landed the same day as the flip: the kernel-identity guard closed
// the defect carve-out the UnlistedImportUse ceiling row records, 4,621 -> 3,745 occurrences.
//
// THE SWEEP THAT MADE THE ORDER-ONLY READING STAND SO LONG. The census's first entry point,
// src/v1/stage0/src/bin/compile_clean_unlisted_import_census.rs, was deleted in gunbc#9160 as one
// member of the 25-file unrostered-seed-probe sweep (a deliberate Delete in
// gunbc.live_deploy.srv1_residue_rehearsal), and for its whole absence the burndown was never once
// measured by its own authority. The restoration is a ROSTERED instrument target precisely so the
// sweep's reason -- unrostered -- does not recur. The dead wrapper
// cli_run::compile_clean_unlisted_import_census deleted with this flip: the advisory census's
// unlisted_import_rows carry the same rows, and a second pub fn answering the same question was
// DESIGN 3c's dangling declaration.
//
// GRAIN. module_name_pairs counts distinct (referencing_module, referenced_name) pairs in the
// census's per-row worklist -- the stand-in's grain, now certified. The census's per-class entry
// counts occurrences (one diagnostic per emission) and distinct positions; occurrences are the
// repair worklist's grain and exceed pairs because one pair recurs across positions.
//
// WHY THE NUMBER GATES AND IS NOT HYGIENE. Every tool that compiles a SUBSET of the corpus fails
// on modules that resolve names they never import -- the synthetic-fixture instrument today, and
// any future projection machinery that has to compute a closure -- while the full-corpus compile
// stays green and says nothing.

type UnlistedImportUseSizingAuthority
  = SizedByStandInExtractor { authoring_session: NonEmptyStr, hand_checked_rows: Int, hand_checked_false_positives: Int }
  | SizedByAuthorityCensus { census: DeclarationRef }

// READ_AS IS AN AXIS AND NOT A HEDGE. OrderOnlyBothDirections is the honest arm for a stand-in
// extractor and it is STRICTLY WEAKER than a one-sided bound: the instrument over-reports (a module
// it flags was measured compiling in an isolated closure -- extdeps.uri, whose `Optional` reference
// is not the class) AND under-reports (a genuine instance at a position its filter does not scan is
// invisible to it, and it cannot attribute a binding source at all). Neither direction is bounded,
// so the number names an ORDER and nothing finer. CertifiedCount is the authority census's arm:
// the instrument is the resolver's own diagnostic stream, so the count it reports is the class's
// population by construction rather than by approximation.
type SizingReadAs
  = OrderOnlyBothDirections
  | CertifiedCount

type UnlistedImportUseSizingObservation sole_constructor {
  authority: UnlistedImportUseSizingAuthority
  denominator_modules: Int
  modules_carrying: Int
  module_name_pairs: Int
  read_as: SizingReadAs
}

data unlisted_import_use_burndown_sizing: UnlistedImportUseSizingObservation = UnlistedImportUseSizingObservation {
  authority: SizedByAuthorityCensus {
    census: DeclarationRef {
      module_path: "gunbc.instrument_targets",
      decl_name: "compile_clean_advisory_census_binding",
      field: WholeDeclaration
    }
  },
  denominator_modules: 4057,
  modules_carrying: 542,
  module_name_pairs: 1415,
  read_as: CertifiedCount
}

// THE PER-CLASS CEILING ROSTER FOR EVERY ADVISORY CLASS THE CENSUS CAN REPORT.
//
// The census (gunbc.instrument_targets compile_clean_advisory_census_binding) measures the
// population; this roster records, per class, the ATTAINABLE CEILING the burndown is aimed at --
// DESIGN 4b's derived-not-aspirational ceiling, decided from what the class IS rather than from
// how large it is. class_name is the census's own class key, whose single authority is the total
// match over v1.std.core CompilerDiagnostic in the seed projection
// (cli_run::compile_clean_diagnostic_histogram_key): a class name here joins the census output by
// string equality, and a class appearing in the census with no row here is the review tell that
// this roster has rotted. No counts are carried: counts are the census's output and rot between
// runs (DESIGN 6 -- name the instrument, never transcribe its output).
//
// THE WORK ORDER IS THE LIST ORDER, sorted by (population x mechanical-fixability) as measured by
// the 2026-09-09 census over the whole-tree closure (4,057 modules, 25,403 advisories across 6
// classes after the kernel-identity guard landed): the two mechanically fixable import-list
// classes first (UnlistedImportUse 3,745 occurrences, then UnlistedVariantValueUse 3,670), then
// the two declared-admission rosters whose instances each carry their own triggers
// (ServiceConfigReferenceJudgmentDeferred 15, MethodExistenceFrontierAdmitted 2), then the two
// wall-after-grounding classes whose promotion waits on a named evidence capability
// (WhereRefinementUnenforced 6,228, DeclaredTypeInhabitanceUndecided 11,743).

type AdvisoryClassCeiling
  = MechanicallyFixableNow { repair: NonEmptyStr }
  | WallAfterGrounding { missing_capability: NonEmptyStr }
  | DeclaredAdmissionRoster { roster: DeclarationRef }
  | DiagnosticDefectAtEmission { defect: NonEmptyStr }
  | DeliberatelyAdvisoryForever { reason: NonEmptyStr }

// THE FIVE ARMS, AND WHY THE FIFTH IS EXPECTED TO STAY UNOCCUPIED. MechanicallyFixableNow: the
// resolver already knows the binding, so the repair is derivable per site and the class burns to
// zero. WallAfterGrounding: DESIGN 5's decidable-but-ungrounded class -- the check is decidable
// (evidence present or not) but the evidence carrier is not yet modeled, so promoting now would
// refuse programs that are right but unproven; the arm names the capability that grounds it.
// DeclaredAdmissionRoster: the class's instances are not a defect population but a declared
// frontier -- each admission is a roster row carrying its own cause, occurrence budget and
// dissolution trigger, so the class empties as its roster empties and promoting the CLASS while
// rows stand would refuse declared admissions. DiagnosticDefectAtEmission: the emission site fires
// on something no author wrote, so the repair is at the emitter, not in the corpus.
// DeliberatelyAdvisoryForever is the brief's fourth category and is expected to stay UNOCCUPIED:
// DESIGN 5 admits no warnings, so a class that should stay advisory forever is usually a class
// whose subject is wrong -- an occupation of this arm is a review finding, not a routine row.

type AdvisoryClassCeilingRow {
  class_name: NonEmptyStr
  ceiling: AdvisoryClassCeiling
  census: DeclarationRef
}

data advisory_class_ceilings: List<AdvisoryClassCeilingRow> = [
  AdvisoryClassCeilingRow {
    class_name: "UnlistedImportUse" as NonEmptyStr,
    ceiling: MechanicallyFixableNow {
      repair: "add the referenced name to the referencing module's import name list (or add the import edge); the resolver already attributes every row's binding source, so the repair is derivable from the census worklist. CLOSED CARVE-OUT, a defect that lived inside the class: the emitter also charged references whose RESOLVED BINDING is a kernel-minted identity (ident span <kernel:NAME>) -- synthetic formal nodes of imported generic fns reached through the ancestry overlay, and authored occurrences of lexically-introduced type parameters. No import-list edit can discharge such a row: the binding is not import-governed, and adding the name would rebind the reference, not repair a listing gap. The pre-fix census under-counted the defect at 19 by measuring occurrence SPANS; measured by binding it was 876 of 4,621. v1.compiler.infer_resolve now guards the emission with v1.compiler.core resolved_node_is_kernel_identity_for_name, the discriminating witness test.claim.undeclared_bare_type_reference_class_witness_test imported_generic_call_charges_no_unlisted_import_use_on_the_formal is enrolled (RED pre-fix, GREEN post), and the class's remaining population is the genuine burndown worklist."
    },
    census: DeclarationRef {
      module_path: "gunbc.instrument_targets",
      decl_name: "compile_clean_advisory_census_binding",
      field: WholeDeclaration
    }
  },
  AdvisoryClassCeilingRow {
