module gunbc.tool_readiness

import std.types { Int, List, NonEmptyStr, String }
import std.integer { NonNegativeInt }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.tools { CliTool }
import extdeps.tools.rustfmt { rustfmt_cli_tool }
import extdeps.pin {
  Pin,
  PinAdmission,
  PinIntegrityAdmitted,
  PinRefused,
  PinRefusalCause,
  admit_pin_integrity,
  pin_value_eq,
}
import extdeps.tools.pin { cli_tool_pin_key_of }
import extdeps.realization.emit_on_demand_host {
  ObservedToolIdentity,
  ObservedToolIdentityFound,
  ObservedToolIdentityMissing,
  ObservedToolIdentityDuplicate,
  ResolvedBuildContext,
  observed_tool_identity,
}
import gunbc.membership_reconcile {
  MembershipPlan,
  membership_reconcile,
  membership_tally,
}
import gunbc.ownership { Ownership, Ensured }

type UnpinnedToolFrontierRow {
  tool: CliTool
  reason: String
  trigger: DeclarationRef
}

type ToolReadinessRefusalCause
  = ToolObservationMissing { tool_name: NonEmptyStr }
  | ToolObservationDuplicate { tool_name: NonEmptyStr, count: NonNegativeInt }
  | ToolMembershipNotConverged {
      plan: MembershipPlan<Pin<CliTool>>,
      admission: PinAdmission<CliTool>
    }
  | ToolPinIntegrityRefused {
      cause: PinRefusalCause,
      plan: MembershipPlan<Pin<CliTool>>
    }
  | UnpinnedToolUndeclared
  | UnpinnedToolFrontierDuplicate { count: NonNegativeInt }

type ToolReadinessRefusal {
  tool: CliTool
  cause: ToolReadinessRefusalCause
}

type ToolReadiness
  = PinnedAdmitted {
      pin: Pin<CliTool>,
      plan: MembershipPlan<Pin<CliTool>>
    }
  | PinnedRefused { refusals: List<ToolReadinessRefusal> }
  | UnpinnedFrontier {
      row: UnpinnedToolFrontierRow,
      observed: ObservedToolIdentity
    }

type ToolReadinessRequest
  = PinnedToolReadinessRequest { pin: Pin<CliTool> }
  | UnpinnedToolReadinessRequest { tool: CliTool }

data rustfmt_unpinned_frontier_rehome_note: String = "RE-HOMED FROM v2.workflow.ci_regen_rustfmt_path_emit BY THE v1 CUT, AND THE TRIGGER IS RE-DERIVED RATHER THAN COPIED. The row lived beside the regen job's PATH-ensure script because that script was its only consumer, and it pointed its DeclarationRef at that script. The v1 cut retired the regen job and the script with it -- but NOT the fact the row states: rustfmt is still spawned on every CI run by the build job's cargo fmt gate, and it still has no stable expected identity to pin against. So the row's subject survives its former consumer, which is why this is a re-home and not a retirement.

TWO THINGS WERE DELIBERATELY NOT DONE. The trigger was not carried across unchanged: it named a declaration that no longer exists, and a DeclarationRef to a deleted symbol is the stale-citation class DESIGN section 3 rules on -- it greps clean while being false. It now names gunbc.ci_spec ci_fmt_gate_line, the live consumer that actually spawns the tool. And the row was not parked in the workflow layer beside its new consumer: the frontier is a tool-readiness concept, and this module already declares UnpinnedToolFrontierRow and already says in its own authority note that the frontier count is the migration remainder until hermetic provisioning. Home is the layer that owns the concept, not the file that happens to read it."

data rustfmt_unpinned_frontier: UnpinnedToolFrontierRow = UnpinnedToolFrontierRow {
  tool: rustfmt_cli_tool,
  reason: "The CI fmt gate can establish rustfmt presence but cannot author a stable expected executable identity until toolchain-rust-hermetic provisions rustfmt into the declared repo-local root.",
  trigger: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "ci_fmt_gate_line",
    field: WholeDeclaration
  }
}

data tool_readiness_authority_note: String = "Tool readiness is one desired-versus-observed membership reconcile, not another PATH resolver. ToolReadinessRequest is a SUM: the pinned arm carries only the pin and derives its tool from pin.subject; the unpinned arm carries only the tool. A contradictory tool plus pin.subject pair is therefore unwritable rather than checked after construction. A desired Pin<CliTool> is keyed by the subject name and compared with extdeps.pin.pin_value_eq; the observed member is derived only from the named per-tool row returned by extdeps.realization.emit_on_demand_host.observed_tool_identity, never from the aggregate toolchain_identity and never from a second digest probe. Readiness is the CONJUNCTION of two non-redundant answers: membership_reconcile decides whether an ensure/upsert remains, while admit_pin_integrity decides whether the selected pin may be trusted (notably, TrackedChannel refuses even when membership is unchanged). Any reconcile hunk returns ToolMembershipNotConverged before a path/spawn effect, so the plan gates the verdict rather than riding as decorative evidence. Missing and Duplicate are separate typed, located, counted refusals. System tools are Ensured, so removing one refuses through membership_reconcile's existing R5 wall. PinnedRefused carries no spawn/path effect. UnpinnedFrontier is not an admission and not a default: it is reachable only through one declared per-tool frontier row after a Found observation. Zero rows refuses UnpinnedToolUndeclared and multiple rows refuse UnpinnedToolFrontierDuplicate. The frontier count is the honest migration remainder until hermetic provisioning makes stable expected identities authorable."

fn tool_pin_ownership(pin: Pin<CliTool>) -> Ownership? {
  Present { value: Ensured }
}

fn tool_pin_reconcile(
  desired: List<Pin<CliTool>>,
  observed: List<Pin<CliTool>>,
) -> MembershipPlan<Pin<CliTool>> {
  membership_reconcile(
    desired: desired,
    observed: observed,
    key_of: cli_tool_pin_key_of,
    key_eq: (a, b) => a == b,
    value_eq: pin_value_eq,
    ownership_of: tool_pin_ownership,
  )
}

fn observed_pin(
  desired: Pin<CliTool>,
  observation: ObservedToolIdentity,
) -> Pin<CliTool> {
  Pin {
    subject: desired.subject,
    version: desired.version,
    expected_identity: observation.observed_identity,
    selection: desired.selection,
  }
}

data observed_pin_projection_note: String = "ObservedToolIdentity carries the observed digest at per-tool grain, but does not independently carry Pin.version or Pin.selection. observed_pin therefore projects those two policy fields from desired and replaces only expected_identity with the observed digest. On this path pin_value_eq's version and selection arms are intentionally identities; executable/version-probe output is already folded into observed_identity, so host version drift changes the digest and produces a Modified -> upsert hunk. This reconcile does not claim a second independent version observation."

fn tool_refused(tool: CliTool, cause: ToolReadinessRefusalCause) -> ToolReadiness {
  PinnedRefused {
    refusals: [ToolReadinessRefusal { tool: tool, cause: cause }]
  }
}

fn pinned_tool_readiness(
  pin: Pin<CliTool>,
  context: ResolvedBuildContext,
) -> ToolReadiness {
  match observed_tool_identity(
    context: context,
    tool_name: cli_tool_pin_key_of(pin: pin),
  ) {
    ObservedToolIdentityMissing { tool_name: name } =>
      tool_refused(
        tool: pin.subject,
        cause: ToolObservationMissing { tool_name: name },
      )
    ObservedToolIdentityDuplicate { tool_name: name, count: n } =>
      tool_refused(
        tool: pin.subject,
        cause: ToolObservationDuplicate { tool_name: name, count: n },
      )
    ObservedToolIdentityFound { row: observation } => {
      let plan = tool_pin_reconcile(
        desired: [pin],
        observed: [observed_pin(desired: pin, observation: observation)],
      )
      let admission = admit_pin_integrity(
        pin: pin,
        observed_identity: observation.observed_identity,
      )
      let tally = membership_tally(plan: plan)
      if (tally.adds + tally.changes) > 0 || tally.removals > 0 || tally.refusals > 0 {
        tool_refused(
          tool: pin.subject,
          cause: ToolMembershipNotConverged {
            plan: plan,
            admission: admission,
          },
        )
      } else {
        match admission {
          PinIntegrityAdmitted { pin: admitted } =>
            PinnedAdmitted { pin: admitted, plan: plan }
          PinRefused { subject: _, cause: cause } =>
            tool_refused(
              tool: pin.subject,
              cause: ToolPinIntegrityRefused { cause: cause, plan: plan },
            )
        }
      }
    }
  }
}

fn matching_frontier_rows(
  tool: CliTool,
  frontier: List<UnpinnedToolFrontierRow>,
) -> List<UnpinnedToolFrontierRow> {
  filter(frontier, row => row.tool.name == tool.name)
}

fn unpinned_tool_readiness(
  tool: CliTool,
  frontier: List<UnpinnedToolFrontierRow>,
  context: ResolvedBuildContext,
) -> ToolReadiness {
  let matching = matching_frontier_rows(tool: tool, frontier: frontier)
  if count(matching) == 0 {
    tool_refused(tool: tool, cause: UnpinnedToolUndeclared)
  } else if count(matching) > 1 {
    tool_refused(
      tool: tool,
      cause: UnpinnedToolFrontierDuplicate { count: count(matching) },
    )
  } else {
    match matching |> first {
      Absent => tool_refused(tool: tool, cause: UnpinnedToolUndeclared)
      Present { value: frontier_row } =>
        match observed_tool_identity(context: context, tool_name: tool.name) {
          ObservedToolIdentityMissing { tool_name: name } =>
            tool_refused(
              tool: tool,
              cause: ToolObservationMissing { tool_name: name },
            )
          ObservedToolIdentityDuplicate { tool_name: name, count: n } =>
            tool_refused(
              tool: tool,
              cause: ToolObservationDuplicate { tool_name: name, count: n },
            )
          ObservedToolIdentityFound { row: observation } =>
            UnpinnedFrontier { row: frontier_row, observed: observation }
        }
    }
  }
}

fn tool_readiness(
  request: ToolReadinessRequest,
  frontier: List<UnpinnedToolFrontierRow>,
  context: ResolvedBuildContext,
) -> ToolReadiness {
  match request {
    PinnedToolReadinessRequest { pin: desired } =>
      pinned_tool_readiness(pin: desired, context: context)
    UnpinnedToolReadinessRequest { tool: tool } =>
      unpinned_tool_readiness(
        tool: tool,
        frontier: frontier,
        context: context,
      )
  }
}

fn tool_readiness_refusal_count(readiness: ToolReadiness) -> Int {
  match readiness {
    PinnedRefused { refusals: rows } => count(rows)
    PinnedAdmitted { pin: _, plan: _ } => 0
    UnpinnedFrontier { row: _, observed: _ } => 0
  }
}
