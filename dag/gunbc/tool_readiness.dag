module gunbc.tool_readiness

import std.types { Int, List, NonEmptyStr, String }
import std.integer { NonNegativeInt }
import std.decl_ref { DeclarationRef }
import extdeps.tools { CliTool }
import extdeps.pin {
  Pin,
  PinIntegrityAdmitted,
  PinRefused,
  PinRefusalCause,
  admit_pin_integrity,
  pin_value_eq,
}
import extdeps.tools.pin { cli_tool_pin_key_of }
import extdeps.realization.emit_on_demand_host {
  ObservedToolIdentity,
  ObservedToolIdentityFound,
  ObservedToolIdentityMissing,
  ObservedToolIdentityDuplicate,
  ResolvedBuildContext,
  observed_tool_identity,
}
import gunbc.membership_reconcile {
  MembershipPlan,
  membership_reconcile,
}
import gunbc.ownership { Ownership, Ensured }

type UnpinnedToolFrontierRow {
  tool: CliTool
  reason: String
  trigger: DeclarationRef
}

type ToolReadinessRefusalCause
  = ToolObservationMissing { tool_name: NonEmptyStr }
  | ToolObservationDuplicate { tool_name: NonEmptyStr, count: NonNegativeInt }
  | ToolPinIntegrityRefused {
      cause: PinRefusalCause,
      plan: MembershipPlan<Pin<CliTool>>
    }
  | UnpinnedToolUndeclared
  | UnpinnedToolFrontierDuplicate { count: NonNegativeInt }

type ToolReadinessRefusal {
  tool: CliTool
  cause: ToolReadinessRefusalCause
}

type ToolReadiness
  = PinnedAdmitted {
      pin: Pin<CliTool>,
      plan: MembershipPlan<Pin<CliTool>>
    }
  | PinnedRefused { refusals: List<ToolReadinessRefusal> }
  | UnpinnedFrontier {
      row: UnpinnedToolFrontierRow,
      observed: ObservedToolIdentity
    }

data tool_readiness_authority_note: String = "Tool readiness is one desired-versus-observed membership reconcile, not another PATH resolver. A desired Pin<CliTool> is keyed by the subject name and compared with extdeps.pin.pin_value_eq; the observed member is derived only from the named per-tool row returned by extdeps.realization.emit_on_demand_host.observed_tool_identity, never from the aggregate toolchain_identity and never from a second digest probe. Missing and Duplicate are separate typed, located, counted refusals. System tools are Ensured, so removing one refuses through membership_reconcile's existing R5 wall. PinnedRefused carries no spawn/path effect. UnpinnedFrontier is not an admission and not a default: it is reachable only through one declared per-tool frontier row after a Found observation. Zero rows refuses UnpinnedToolUndeclared and multiple rows refuse UnpinnedToolFrontierDuplicate; a supplied pin always takes the pinned path, so a frontier row cannot bypass an integrity mismatch. The frontier count is the honest migration remainder until hermetic provisioning makes stable expected identities authorable."

fn tool_pin_ownership(pin: Pin<CliTool>) -> Ownership? {
  Present { value: Ensured }
}

fn tool_pin_reconcile(
  desired: List<Pin<CliTool>>,
  observed: List<Pin<CliTool>>,
) -> MembershipPlan<Pin<CliTool>> {
  membership_reconcile(
    desired: desired,
    observed: observed,
    key_of: cli_tool_pin_key_of,
    key_eq: (a, b) => a == b,
    value_eq: pin_value_eq,
    ownership_of: tool_pin_ownership,
  )
}

fn observed_pin(
  desired: Pin<CliTool>,
  observation: ObservedToolIdentity,
) -> Pin<CliTool> {
  Pin {
    subject: desired.subject,
    version: desired.version,
    expected_identity: observation.observed_identity,
    selection: desired.selection,
  }
}

fn tool_refused(tool: CliTool, cause: ToolReadinessRefusalCause) -> ToolReadiness {
  PinnedRefused {
    refusals: [ToolReadinessRefusal { tool: tool, cause: cause }]
  }
}

fn pinned_tool_readiness(
  pin: Pin<CliTool>,
  context: ResolvedBuildContext,
) -> ToolReadiness {
  match observed_tool_identity(
    context: context,
    tool_name: cli_tool_pin_key_of(pin: pin),
  ) {
    ObservedToolIdentityMissing { tool_name: name } =>
      tool_refused(
        tool: pin.subject,
        cause: ToolObservationMissing { tool_name: name },
      )
    ObservedToolIdentityDuplicate { tool_name: name, count: n } =>
      tool_refused(
        tool: pin.subject,
        cause: ToolObservationDuplicate { tool_name: name, count: n },
      )
    ObservedToolIdentityFound { row: observation } => {
      let plan = tool_pin_reconcile(
        desired: [pin],
        observed: [observed_pin(desired: pin, observation: observation)],
      )
      match admit_pin_integrity(
        pin: pin,
        observed_identity: observation.observed_identity,
      ) {
        PinIntegrityAdmitted { pin: admitted } =>
          PinnedAdmitted { pin: admitted, plan: plan }
        PinRefused { subject: _, cause: cause } =>
          tool_refused(
            tool: pin.subject,
            cause: ToolPinIntegrityRefused { cause: cause, plan: plan },
          )
      }
    }
  }
}

fn matching_frontier_rows(
  tool: CliTool,
  frontier: List<UnpinnedToolFrontierRow>,
) -> List<UnpinnedToolFrontierRow> {
  filter(frontier, row => row.tool.name == tool.name)
}

fn unpinned_tool_readiness(
  tool: CliTool,
  frontier: List<UnpinnedToolFrontierRow>,
  context: ResolvedBuildContext,
) -> ToolReadiness {
  let matching = matching_frontier_rows(tool: tool, frontier: frontier)
  if count(matching) == 0 {
    tool_refused(tool: tool, cause: UnpinnedToolUndeclared)
  } else if count(matching) > 1 {
    tool_refused(
      tool: tool,
      cause: UnpinnedToolFrontierDuplicate { count: count(matching) },
    )
  } else {
    match matching |> first {
      Absent => tool_refused(tool: tool, cause: UnpinnedToolUndeclared)
      Present { value: frontier_row } =>
        match observed_tool_identity(context: context, tool_name: tool.name) {
          ObservedToolIdentityMissing { tool_name: name } =>
            tool_refused(
              tool: tool,
              cause: ToolObservationMissing { tool_name: name },
            )
          ObservedToolIdentityDuplicate { tool_name: name, count: n } =>
            tool_refused(
              tool: tool,
              cause: ToolObservationDuplicate { tool_name: name, count: n },
            )
          ObservedToolIdentityFound { row: observation } =>
            UnpinnedFrontier { row: frontier_row, observed: observation }
        }
    }
  }
}

fn tool_readiness(
  tool: CliTool,
  pin: Pin<CliTool>?,
  frontier: List<UnpinnedToolFrontierRow>,
  context: ResolvedBuildContext,
) -> ToolReadiness {
  match pin {
    Present { value: desired } =>
      pinned_tool_readiness(pin: desired, context: context)
    Absent =>
      unpinned_tool_readiness(
        tool: tool,
        frontier: frontier,
        context: context,
      )
  }
}

fn tool_readiness_refusal_count(readiness: ToolReadiness) -> Int {
  match readiness {
    PinnedRefused { refusals: rows } => count(rows)
    PinnedAdmitted { pin: _, plan: _ } => 0
    UnpinnedFrontier { row: _, observed: _ } => 0
  }
}
