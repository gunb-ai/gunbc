module gunbc.uefi_shell_over_sol


fn uefi_shell_serial_input(commands: List<extdeps.firmware.uefi_shell.UefiShellCommand>) -> String {
  fold(
    commands,
    init: "",
    f: (acc, cmd) => concat(acc, concat(extdeps.firmware.uefi_shell.uefi_shell_command_line(cmd: cmd), "\\r"))
  )
}

fn uefi_boot_config_sol_send_intent(
  bmc_host: std.types.NonEmptyStr,
  username: std.types.NonEmptyStr,
  desired: gunbc.uefi_boot_config.DesiredBootSource,
) -> extdeps.bmc.serial_console.SolConsoleSendIntent {
  extdeps.bmc.serial_console.SolConsoleSendIntent {
    bmc_host: bmc_host,
    transport: extdeps.bmc.serial_console.IpmiSol,
    username: username,
    input: uefi_shell_serial_input(commands: gunbc.uefi_boot_config.uefi_boot_config_commands(desired: desired)),
    settle_seconds: 3,
    read_timeout_seconds: 5,
  }
}

fn uefi_boot_config_sol_send_script(
  bmc_host: std.types.NonEmptyStr,
  username: std.types.NonEmptyStr,
  desired: gunbc.uefi_boot_config.DesiredBootSource,
) -> String {
  extdeps.bmc.serial_console.sol_console_send_script(intent: uefi_boot_config_sol_send_intent(
    bmc_host: bmc_host,
    username: username,
    desired: desired,
  ))
}

data srv4_uefi_boot_config_sol_send_intent: extdeps.bmc.serial_console.SolConsoleSendIntent = uefi_boot_config_sol_send_intent(
  bmc_host: "192.168.1.195",
  username: "root",
  desired: gunbc.uefi_boot_config.srv4_uefi_install_boot,
)
