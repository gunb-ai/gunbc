module gunbc.os_install_mechanism

import std.bmc { BmcEndpoint }
import std.types { List, String }
import extdeps.bmc.types {
  RedfishBootSourceOverrideTarget,
  BootTargetPxe,
  BootTargetCd,
}
import extdeps.bmc.capability {
  BmcCapability,
  BmcFirmwareCapabilityRow,
  BmcFirmwareVersion,
  CapabilityVirtualMedia,
  CapabilityNbdProxyVirtualMedia,
  CapabilityFirmwareUpdate,
  firmware_has_capability,
  catalog_has_vm_capable_firmware,
}
import extdeps.boards.asrock_rack {
  asrock_altrad8ud_1l2t_bmc_firmware_capability_catalog,
  asrock_altrad8ud_shipped_bmc_firmware_capabilities,
}
import gunbc.fleet_bmc_firmware_evidence {
  BmcFirmwareCapabilityEvidenceAbsent,
  BmcFirmwareCapabilityResolved,
  BmcFirmwareCapabilityVersionUncatalogued,
  BmcFirmwareEvidence,
  bmc_firmware_capability_standing,
  srv1_bmc_firmware_evidence,
  srv2_bmc_firmware_evidence,
  srv3_bmc_firmware_evidence,
  srv4_bmc_firmware_evidence,
}

type OsInstallMechanism
  = VirtualMediaInstall
  | NbdProxyVirtualMediaInstall
  | PxeHttpInstall
  | FirmwareUpdateThenVirtualMedia

fn solve_install_mechanism(
  current: BmcFirmwareCapabilityRow,
  catalog: List<BmcFirmwareCapabilityRow>
) -> OsInstallMechanism {
  if firmware_has_capability(row: current, cap: CapabilityVirtualMedia) {
    VirtualMediaInstall
  } else if firmware_has_capability(row: current, cap: CapabilityNbdProxyVirtualMedia) {
    NbdProxyVirtualMediaInstall
  } else if firmware_has_capability(row: current, cap: CapabilityFirmwareUpdate)
         && catalog_has_vm_capable_firmware(catalog: catalog) {
    FirmwareUpdateThenVirtualMedia
  } else {
    PxeHttpInstall
  }
}

type OsInstallMechanismRefusalCause
  = InstallFirmwareEvidenceAbsent { endpoint: BmcEndpoint }
  | InstallFirmwareVersionUncatalogued { firmware: BmcFirmwareVersion }

type OsInstallMechanismSolution
  = OsInstallMechanismSelected { mechanism: OsInstallMechanism }
  | OsInstallMechanismRefused { cause: OsInstallMechanismRefusalCause }

// The per-host entry point, and the reason this module now imports host evidence at all:
// solve_install_mechanism answers a question about a CAPABILITY ROW, and the defect this
// closes was feeding it the board's shipped-firmware row for every host. A capability roster
// is per firmware release, so the shipped row is a fact about what the board left the factory
// with, never about what a given BMC is running now.
fn solve_install_mechanism_from_evidence(
  evidence: BmcFirmwareEvidence,
  catalog: List<BmcFirmwareCapabilityRow>
) -> OsInstallMechanismSolution {
  match bmc_firmware_capability_standing(evidence: evidence, catalog: catalog) {
    BmcFirmwareCapabilityResolved { row: r } =>
      OsInstallMechanismSelected {
        mechanism: solve_install_mechanism(current: r, catalog: catalog),
      }
    BmcFirmwareCapabilityEvidenceAbsent { endpoint: e } =>
      OsInstallMechanismRefused { cause: InstallFirmwareEvidenceAbsent { endpoint: e } }
    BmcFirmwareCapabilityVersionUncatalogued { firmware: fw } =>
      OsInstallMechanismRefused { cause: InstallFirmwareVersionUncatalogued { firmware: fw } }
  }
}

data srv3_firmware_catalog: List<BmcFirmwareCapabilityRow> = asrock_altrad8ud_1l2t_bmc_firmware_capability_catalog

data srv1_install_mechanism_solution: OsInstallMechanismSolution = solve_install_mechanism_from_evidence(
  evidence: srv1_bmc_firmware_evidence,
  catalog: srv3_firmware_catalog
)

data srv2_install_mechanism_solution: OsInstallMechanismSolution = solve_install_mechanism_from_evidence(
  evidence: srv2_bmc_firmware_evidence,
  catalog: srv3_firmware_catalog
)

data srv3_install_mechanism_solution: OsInstallMechanismSolution = solve_install_mechanism_from_evidence(
  evidence: srv3_bmc_firmware_evidence,
  catalog: srv3_firmware_catalog
)

// srv4 is the row that makes this repair load-bearing rather than tidy: its observed firmware
// is OpenBMC 3.22.00, whose catalogued capability row carries neither CapabilityVirtualMedia
// nor CapabilityNbdProxyVirtualMedia, so the derived mechanism is PxeHttpInstall. The legacy
// board-default read below would have answered NbdProxyVirtualMediaInstall for this host —
// a delivery mechanism its BMC firmware does not implement.
data srv4_install_mechanism_solution: OsInstallMechanismSolution = solve_install_mechanism_from_evidence(
  evidence: srv4_bmc_firmware_evidence,
  catalog: srv3_firmware_catalog
)

data srv3_install_mechanism_board_default_residue: String = "🟡 dissolve-on: srv3_install_mechanism and srv3_install_boot_target are the pre-repair rows that read the BOARD's shipped-firmware capability row (asrock_altrad8ud_shipped_bmc_firmware_capabilities) instead of srv3's own firmware evidence. They are retained ONLY because their consumers — gunbc.os_install's srv3_os_install_plan / srv3_seeded_os_install_plan / fleet_install_server_specs, gunbc.nbd_proxy_virtual_media_install, gunbc.srv3_os_install_actuate_scope, gunbc.bmc_onboarding, gunbc.host_standup — are total `data` rows that cannot carry OsInstallMechanismRefused without becoming standings themselves, and fleet_install_server_specs reaches gunbc.generated_artifact. They agree with srv3_install_mechanism_solution TODAY only because srv3's observed firmware happens to equal the board's shipped version; the witness srv3_legacy_row_agrees_with_evidence_derived_solution executes that coincidence so it cannot rot silently, and there is deliberately no srv4 legacy row because it would be wrong. DISSOLVES WHEN those consumers take OsInstallMechanismSolution and the plan rows become standings (BMC-EVIDENCE-1); at that point both rows and this note are DELETED."

data srv3_install_mechanism: OsInstallMechanism = solve_install_mechanism(
  current: asrock_altrad8ud_shipped_bmc_firmware_capabilities,
  catalog: srv3_firmware_catalog
)

fn install_boot_target_for(mechanism: OsInstallMechanism) -> RedfishBootSourceOverrideTarget {
  match mechanism {
    VirtualMediaInstall => BootTargetCd
    NbdProxyVirtualMediaInstall => BootTargetCd
    PxeHttpInstall => BootTargetPxe
    FirmwareUpdateThenVirtualMedia => BootTargetCd
  }
}

data srv3_install_boot_target: RedfishBootSourceOverrideTarget = install_boot_target_for(
  mechanism: srv3_install_mechanism
)
