module gunbc.arm_ci_seller_census

import std.types { Bool, List }
import std.decl_ref { DeclarationRef, declaration_ref_eq, decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import extdeps.ci_runner.types {
  CustomerAccountNamedCloud,
  ResoldNamedCloud,
  SellerArmLinuxOffer,
  SellerOwnMetalStated,
  SoftwareOnCustomerHosts,
  CloudOperatorIsTheSeller,
  CapacityChannelUnread,
  CurrentlyAcceptingCustomers,
  SellerNotAcceptingCustomers,
  OfferStandingUnread,
}
import extdeps.ci_runner.actuated { actuated_arm_linux_offer }
import extdeps.ci_runner.aws_codebuild { aws_codebuild_arm_linux_offer }
import extdeps.ci_runner.blacksmith { blacksmith_arm_linux_offer }
import extdeps.ci_runner.buildjet { buildjet_arm_linux_offer }
import extdeps.ci_runner.buildkite { buildkite_arm_linux_offer }
import extdeps.ci_runner.circleci { circleci_arm_linux_offer }
import extdeps.ci_runner.cirrus_runners { cirrus_runners_arm_linux_offer }
import extdeps.ci_runner.depot { depot_arm_linux_offer }
import extdeps.ci_runner.github_actions { github_actions_arm_linux_offer }
import extdeps.ci_runner.gitlab { gitlab_arm_linux_offer }
import extdeps.ci_runner.google_cloud_build { google_cloud_build_arm_linux_offer }
import extdeps.ci_runner.namespace { namespace_arm_linux_offer }
import extdeps.ci_runner.runs_on { runs_on_arm_linux_offer }
import extdeps.ci_runner.semaphore { semaphore_arm_linux_offer }
import extdeps.ci_runner.sprinters { sprinters_arm_linux_offer }
import extdeps.ci_runner.warpbuild { warpbuild_arm_linux_offer }
import extdeps.pricing.ubicloud { ubicloud_arm_linux_offer }

// WHICH ARM LINUX CI SELLERS THIS REPOSITORY HAS READ. Observation layer: DESIGN
// forbids the extdeps hub from enumerating products. Adding a seller is one module
// plus one line here.
//
// Scope: Linux aarch64 CI-runner sellers only. Mac/Apple-silicon CI (Bitrise,
// Codemagic, MacStadium, and macOS families on mixed sellers) is a different market
// and is not modelled as ARM Linux shapes. Hetzner CAX (extdeps.cloud.hetzner) is ARM
// supply, not a CI-runner seller, and is not enrolled here; CAX was unread as
// orderable on three dated readings.
//
// CONSUMPTION (DESIGN §3c). Executing consumer in this tree:
// test.claim.arm_ci_seller_census_witness. Later consumers are the enrolled
// FrontierRow below, not a second prose roster.
data arm_ci_seller_census_later_consumer_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.arm_ci_seller_census", decl_name: "surveyed_arm_linux_offers"),
    reason: "surveyed_arm_linux_offers and cloud_arm_reseller_offers are observation plus the census witness until a production join outside this public tree reads them. Named consumer: strategy.ci_compute_offer_catalog (gunbc-private #113 catalog; private #88 is closed and superseded) folding SellerArmLinuxOffer including SellerOfferStanding, and strategy.node_rental SupplierHypothesis folding ArmCapacityChannel (reseller of scarce cloud ARM as a candidate Ampere buyer). Trigger: that catalog, or SupplierHypothesis, imports surveyed_arm_linux_offers or cloud_arm_reseller_offers from public gunb-ai/gunbc@main. NOT satisfied by this witness, nor by pinning a PR head, nor by restating prices in private strategy.",
    dissolution: unbound_dissolution(description: "dissolve-on: strategy.ci_compute_offer_catalog (or strategy.node_rental SupplierHypothesis) imports surveyed_arm_linux_offers or cloud_arm_reseller_offers from public origin/main; that change rebinds this row to bound_dissolution on the importing declaration. SUFFICIENT FOR deleting this row. Private modules are not DeclarationRefs in this tree (CITED-MODULE-ABSENT), so the dissolution stays unbound until the import exists as a public or overlay citation this corpus can name."),
  ),
]

fn surveyed_arm_linux_offers() -> List<SellerArmLinuxOffer> {
  [
    blacksmith_arm_linux_offer,
    depot_arm_linux_offer,
    warpbuild_arm_linux_offer,
    circleci_arm_linux_offer,
    github_actions_arm_linux_offer,
    ubicloud_arm_linux_offer,
    namespace_arm_linux_offer,
    buildjet_arm_linux_offer,
    runs_on_arm_linux_offer,
    actuated_arm_linux_offer,
    cirrus_runners_arm_linux_offer,
    buildkite_arm_linux_offer,
    gitlab_arm_linux_offer,
    aws_codebuild_arm_linux_offer,
    sprinters_arm_linux_offer,
    semaphore_arm_linux_offer,
    google_cloud_build_arm_linux_offer,
  ]
}

fn offer_resells_named_cloud(offer: SellerArmLinuxOffer) -> Bool {
  match offer.capacity {
    ResoldNamedCloud { vendor_words: _ } => true
    CustomerAccountNamedCloud { vendor_words: _ } => false
    SellerOwnMetalStated => false
    CloudOperatorIsTheSeller { vendor_words: _ } => false
    SoftwareOnCustomerHosts => false
    CapacityChannelUnread => false
  }
}

fn offer_launches_customer_cloud(offer: SellerArmLinuxOffer) -> Bool {
  match offer.capacity {
    CustomerAccountNamedCloud { vendor_words: _ } => true
    ResoldNamedCloud { vendor_words: _ } => false
    SellerOwnMetalStated => false
    CloudOperatorIsTheSeller { vendor_words: _ } => false
    SoftwareOnCustomerHosts => false
    CapacityChannelUnread => false
  }
}

fn cloud_arm_reseller_offers() -> List<SellerArmLinuxOffer> {
  filter(surveyed_arm_linux_offers(), o => offer_resells_named_cloud(offer: o))
}

fn customer_account_cloud_arm_offers() -> List<SellerArmLinuxOffer> {
  filter(surveyed_arm_linux_offers(), o => offer_launches_customer_cloud(offer: o))
}

fn offer_is_not_accepting_customers(offer: SellerArmLinuxOffer) -> Bool {
  match offer.standing {
    SellerNotAcceptingCustomers { cause: _ } => true
    CurrentlyAcceptingCustomers { status_surface: _ } => false
    OfferStandingUnread => false
  }
}

fn offer_standing_is_unread(offer: SellerArmLinuxOffer) -> Bool {
  match offer.standing {
    OfferStandingUnread => true
    CurrentlyAcceptingCustomers { status_surface: _ } => false
    SellerNotAcceptingCustomers { cause: _ } => false
  }
}

fn not_accepting_arm_linux_offers() -> List<SellerArmLinuxOffer> {
  filter(surveyed_arm_linux_offers(), o => offer_is_not_accepting_customers(offer: o))
}

fn unread_standing_arm_linux_offers() -> List<SellerArmLinuxOffer> {
  filter(surveyed_arm_linux_offers(), o => offer_standing_is_unread(offer: o))
}

fn offer_has_provider(offer: SellerArmLinuxOffer, provider: DeclarationRef) -> Bool {
  declaration_ref_eq(a: offer.provider, b: provider)
}

fn surveyed_includes_provider(provider: DeclarationRef) -> Bool {
  any(surveyed_arm_linux_offers(), o => offer_has_provider(offer: o, provider: provider))
}

fn reseller_includes_provider(provider: DeclarationRef) -> Bool {
  any(cloud_arm_reseller_offers(), o => offer_has_provider(offer: o, provider: provider))
}

fn customer_account_includes_provider(provider: DeclarationRef) -> Bool {
  any(customer_account_cloud_arm_offers(), o => offer_has_provider(offer: o, provider: provider))
}

fn not_accepting_includes_provider(provider: DeclarationRef) -> Bool {
  any(not_accepting_arm_linux_offers(), o => offer_has_provider(offer: o, provider: provider))
}

fn unread_standing_includes_provider(provider: DeclarationRef) -> Bool {
  any(unread_standing_arm_linux_offers(), o => offer_has_provider(offer: o, provider: provider))
}

fn provider_in(provider: DeclarationRef, identities: List<DeclarationRef>) -> Bool {
  any(identities, p => declaration_ref_eq(a: provider, b: p))
}
