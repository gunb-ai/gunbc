module gunbc.fleet_host_budget

fn build_cost_account(cfg: JobserverConfig) -> CostAccount<Nano> {
  CostAccount {
    time: time_measure(count: 0),
    space: cfg.mib_per_job,
    power: watt(count: 0),
    basis: Predicted,
  }
}

fn build_realization(cfg: JobserverConfig) -> RealizedStep<Nano> {
  RealizedStep {
    shape: CreateEffect { cause: CreateIfAbsent { key_source: CompositeKey { fields: ["compile_unit_content_hash", "toolchain_content_hash"] } } },
    placement: LocalFilesystem,
    materialization: Share,
    cost: build_cost_account(cfg: cfg),
  }
}

type HeadroomPolicy
  = HeadroomSet { bytes: ByteSize }
  | HeadroomUnset

data gunbc_fleet_headroom_policy: HeadroomPolicy = HeadroomUnset

data gunbc_fleet_oomd_floor_basis: String = "oomd_actuation_floor is a DERIVED lower bound on free host memory: systemd-oomd needs free headroom to evict a runaway cgroup BEFORE the kernel OOM-killer/livelock fires (the srv2-reboot vector). Basis: a fixed fraction of host RAM (1/16 = ~6.25%) as the minimum free-memory swing oomd needs to actuate; on a 125GiB host this is ~7.8GiB. This is the floor BELOW which a HeadroomSet policy is unsound (it leaves oomd no room to act). Derived, not a literal: scales with host. dissolve-on a measured oomd MemoryPressureLimit + swap-free actuation window once systemd-oomd is live (operator fix-manifest item 8)."

fn oomd_actuation_floor(host: ByteSize) -> ByteSize {
  measure_scale_fraction_floor(m: host, num: 1, den: 16)
}

type HeadroomResolution
  = HeadroomResolved { bytes: ByteSize }
  | HeadroomUnsound { reason: String }

fn resolve_headroom(policy: HeadroomPolicy, floor: ByteSize) -> HeadroomResolution {
  match policy {
    HeadroomUnset => HeadroomUnsound { reason: "headroom policy unset" }
    HeadroomSet { bytes: b } =>
      if byte_size_count(b: b) >= byte_size_count(b: floor) {
        HeadroomResolved { bytes: b }
      } else {
        HeadroomUnsound { reason: "below oomd actuation floor" }
      }
  }
}

fn gunbc_fleet_oomd_evidence_for(mode: SessionReservationMode) -> OomdEnforcementEvidence {
  match mode {
    Regime2AggregateOomd { oomd_eviction_ceiling: ceiling, session_concurrency: _, aggregate_reservation: agg } =>
      gunbc_oomd_fleet_evidence(req: OomdGroundingThresholds {
        per_session_cap: ceiling,
        parent_slice_cap: agg,
        pressure_limit: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit,
      })
    Regime1WorstCase { point: _ } => OomdUnverified
    SessionReservationModeUnset => OomdUnverified
  }
}

data gunbc_fleet_oomd_evidence: OomdEnforcementEvidence = gunbc_fleet_oomd_evidence_for(mode: gunbc_ci_session_reservation_mode)

data gunbc_compile_pool_doc: String = "THE COMPILE POOL IS A CLAIM ON HOST RAM THAT THE PER-SLOT MODEL DID NOT SEE. extdeps.cache.sccache.sccache_server_process_facts cites that cache-miss compiles execute as CHILDREN OF THE SCCACHE SERVER. So compile RSS is charged to the SERVER's cgroup, not to the runner slot that issued the compile, and a per-slot memory cap therefore does NOT bound compile memory. Measured consequence on srv1: the CI server was lazily auto-spawned inside dead slot srv1-10's cgroup and kept alive by SCCACHE_IDLE_TIMEOUT=0, so all five live slots' compiles executed under one dead slot's 15G high / 16G max caps and accumulated 229780 memory.max breach events and 12 oom_kills. Sizing is jobserver_build_pool_bytes (tokens * mib_per_job) — the same cited authority that bounds build concurrency, NOT a fresh literal: the pool must hold exactly the compiles the jobserver admits."

data gunbc_jobserver_token_override_note: String = "THE LIVE JOBSERVER ADMITS ROUGHLY TWICE THE BUILD PARALLELISM ITS OWN FORMULA ALLOWS, observed on srv1 and srv2 on 2026-08-06 and recorded here because it lands on exactly the axis the compile pool governs.\n\n/usr/local/sbin/ctrl-jobserver derives tokens = min(cores - MARGIN, floor((MemTotal_gib - MEM_RESERVE_GIB) * 1024 / MIB_PER_JOB)) — the same derivation extdeps.jobserver.derive_jobserver_tokens carries. With the cited defaults (margin 8, reserve 16GiB, 1792MiB per job) on these hosts (nproc 128, MemTotal 125.09GiB) that yields min(120, 62) = 62 tokens, the MEMORY bound binding well below the core bound.\n\nBoth hosts set CTRL_JOBSERVER_TOKENS=128 in /etc/default/ctrl-jobserver, and the script short-circuits on that variable — `if [[ -z \"$\{CTRL_JOBSERVER_TOKENS:-}\" ]]` guards the whole derivation, so an explicit setting skips the memory bound entirely rather than being clamped by it. 128 tokens at 1792MiB each is 224GiB of admissible concurrent compile memory on a 125GiB host.\n\nWHY THIS IS RECORDED AND NOT FIXED HERE: it is an operator configuration fact about a ctrl-era unit, not a gunbc-derived value, and gunbc has no realized knob for it (JobserverTokens is KnobUnimplemented — its presence is what makes interpret_host_converge refuse the whole host). Changing it is a host action with real consequences for build throughput and belongs to the jobserver re-homing lane, not to a budget module. What matters for THIS module is that the compile pool cannot be sized honestly against an admission ceiling that its own inputs disown — so when gunbc_compile_pool_placement flips to CompilePoolSliceDeclared, the pool must be sized from the DERIVED tokens, and the gap between derived and configured is the over-admission that flip would expose rather than create.\n\nCorroborating observation on the same hosts: srv1 had 85GiB of swap in use against srv2's 1.3GiB, on identical hardware with identical swap provisioning (248GiB across two files) — consistent with srv1's compile server thrashing under the starved cgroup that gunbc_compile_pool_doc describes."


type CompilePoolResolution
  = CompilePoolDerived { bytes: ByteSize }
  | CompilePoolUnresolved { reason: String }

fn compile_pool_bytes_for(
  placement: CompilePoolPlacement,
  nproc: HardwareThreadCount,
  host: ByteSize,
  citation: JobserverCitation
) -> CompilePoolResolution {
  match placement {
    CompilePoolInRunnerSlots => CompilePoolDerived { bytes: byte_size(0) }
    CompilePoolSliceDeclared { slice_unit: _ } => resolve_compile_pool(nproc: nproc, host: host, citation: citation)
  }
}

fn resolve_compile_pool(nproc: HardwareThreadCount, host: ByteSize, citation: JobserverCitation) -> CompilePoolResolution {
  match citation {
    JobserverAbsent =>
      CompilePoolUnresolved { reason: "jobserver config citation absent: the compile pool is sized by the admitted build tokens (tokens * mib_per_job); refuse to size the pool — and therefore to claim the host allocation conserves — without the cited installer knobs" }
    JobserverCited { config: cfg, provenance: _ } =>
      CompilePoolDerived { bytes: jobserver_build_pool_bytes(nproc: nproc, mem_total: host, cfg: cfg) }
  }
}

fn appropriation_of(b: ByteSize) -> Appropriation<Memory, One> {
  Appropriation { ceiling: b }
}

fn overhead_claim(overhead: ByteSize) -> BudgetClaim {
  BudgetClaim {
    item: LineItem { purpose: "host_fixed_overhead", amount: overhead },
    priority: Guaranteed,
  }
}

fn child_node(name: String, b: ByteSize) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: b),
    claims: [],
    children: [],
  }
}

fn gunbc_runner_pool_budget_for(host: HostIdentity) -> ByteSize {
  gunbc_runner_slice_cap_declared(host: host)
}

data gunbc_per_runner_memory_cap: ByteSize = gunbc_runner_slot_desired().memory_max

data gunbc_session_container_memory: ByteSize = byte_size(1073741824)

fn session_pool_bytes(active_sessions: std.nat.Nat) -> ByteSize {
  measure_scale_fraction_floor(m: gunbc_session_container_memory, num: active_sessions, den: 1)
}

// fabric_control_plane_pool IS A NAMED CHILD RATHER THAN AN ADDITION TO fixed_overhead, because the
// resident it charges has an exact identity, an exact placement, an explicit lifecycle, a measurable
// envelope and a later migration path. Folding it into overhead erases all five and makes a future
// MOVE indistinguishable from a drift in miscellaneous OS usage -- and it would double-charge the
// moment overhead is next measured on a host where the service is running.
fn host_allocation_tree(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize,
  session_pool: ByteSize,
  compile_pool: ByteSize,
  control_plane: ByteSize
) -> BudgetNode {
  BudgetNode {
    name: "host_allocation",
    appropriation: appropriation_of(b: host),
    claims: [overhead_claim(overhead: overhead)],
    children: [
      child_node(name: "runner_pool", b: runner_pool),
      child_node(name: "session_pool", b: session_pool),
      child_node(name: "compile_pool", b: compile_pool),
      child_node(name: "fabric_control_plane_pool", b: control_plane),
      child_node(name: "headroom", b: headroom),
    ],
  }
}

type HostAllocationVerdict
  = HostAllocationConserves
  | HostAllocationOversubscribed
  | HostAllocationUnchargeable { cause: String }

// THE VERDICT IS A COPRODUCT BECAUSE A Bool CANNOT SAY WHY IT IS false. "The declared claims exceed
// the host" and "one resident's size is unknown so no sum can be formed" are different states with
// different remedies -- the first is a capacity decision, the second is a measurement someone has to
// go and take -- and a shared false merges them into a plan that looks oversubscribed when it is
// merely unmeasured. A Bool projection over this verdict used to sit beside it
// and is DELETED rather than kept: gunbc.ci_runner_placement, its only production caller, now
// matches the verdict directly, and a spare yes/no left in this module is how the collapse would
// come back -- the next caller wanting a Bool would find one already written and would silently
// drop the remedy again. The witnesses that legitimately ask a yes/no question declare their own
// projection in test.claim.host_allocation_conservation, where a production import of it would be
// visibly wrong.
fn host_allocation_verdict(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize,
  session_pool: ByteSize,
  compile_pool: ByteSize,
  control_plane: HostFabricControlPlaneClaim
) -> HostAllocationVerdict {
  match control_plane {
    ControlPlaneClaimUnmeasured { cause: c } => HostAllocationUnchargeable { cause: c }
    ControlPlaneNotPlaced =>
      host_allocation_verdict_charged(
        host: host, overhead: overhead, headroom: headroom, runner_pool: runner_pool,
        session_pool: session_pool, compile_pool: compile_pool, control_plane: byte_size(0)
      )
    ControlPlaneClaimResolved { memory: m } =>
      host_allocation_verdict_charged(
        host: host, overhead: overhead, headroom: headroom, runner_pool: runner_pool,
        session_pool: session_pool, compile_pool: compile_pool, control_plane: m
      )
  }
}

fn host_allocation_verdict_charged(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize,
  session_pool: ByteSize,
  compile_pool: ByteSize,
  control_plane: ByteSize
) -> HostAllocationVerdict {
  if node_conserves(node: host_allocation_tree(
    host: host,
    overhead: overhead,
    headroom: headroom,
    runner_pool: runner_pool,
    session_pool: session_pool,
    compile_pool: compile_pool,
    control_plane: control_plane
  )) {
    HostAllocationConserves
  } else {
    HostAllocationOversubscribed
  }
}

// THE CLAIM IS A PARAMETER RATHER THAN A DEFAULT, AND THE FIRST VERSION OF THIS GOT IT WRONG. It
// passed ControlPlaneNotPlaced here, which is TRUE TODAY and would have stayed silently true after
// someone placed the control plane -- this function takes host BYTES, not a host identity, so it
// cannot derive the claim and would have gone on answering about a fleet that no longer existed.
// That is the unfirable wall in its purest form, three declarations below the annotation warning
// about it. Making it a parameter means every caller must say which host's claim it is charging,
// and the ones that cannot say so stop compiling -- which is the census, not an inconvenience.

data declared_runner_count_derivation_note: String = "This still divides the declared pool by the declared per-slot cap rather than reading gunbc_runner_slots_per_host directly, and the redundancy is now GONE rather than merely tolerated. The pool is derived as slots × MemoryMax (gunbc.runner_slot_allocation gunbc_runner_slice_cap_declared), so floor(pool ÷ MemoryMax) returns that same slot count by construction — the two agree because one is the other's inverse, not because an author kept them coherent. The old note admitted the difference: it said 80 ÷ 16 = 5 was 'coherent with slots_per_host by construction at these values', which is a coincidence with a caveat attached, and the caveat was doing the work."

fn declared_runner_count_for(host: HostIdentity) -> Int {
  measure_fit_count_floor(
    capacity: gunbc_runner_pool_budget_for(host: host),
    each: gunbc_ci_runner_cgroup_memory_cap
  )
}

fn max_concurrent_sessions(session_pool: ByteSize) -> Int {
  measure_fit_count_floor(capacity: session_pool, each: gunbc_session_container_memory)
}

fn runner_slice_cap(host: ByteSize, overhead: ByteSize, session_slice: ByteSize, headroom: ByteSize, compile_pool: ByteSize) -> ByteSize {
  let after_overhead = byte_size_saturating_sub(total: host, reserved: overhead)
  let after_session = byte_size_saturating_sub(total: after_overhead, reserved: session_slice)
  let after_headroom = byte_size_saturating_sub(total: after_session, reserved: headroom)
  byte_size_saturating_sub(total: after_headroom, reserved: compile_pool)
}

fn runner_slice_node(runner_slice: ByteSize, runner_baseline: ByteSize) -> BudgetNode {
  BudgetNode {
    name: "runner_slice",
    appropriation: appropriation_of(b: runner_slice),
    claims: [],
    children: [child_node(name: "runner_idle_baseline", b: runner_baseline)],
  }
}

fn fleet_host_budget_tree(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  runner_baseline: ByteSize,
  session_slice: ByteSize,
  headroom: ByteSize,
  runner_slice: ByteSize,
  compile_pool: ByteSize
) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: host),
    claims: [overhead_claim(overhead: overhead)],
    children: [
      child_node(name: "session_worstcase_reservation", b: session_slice),
      child_node(name: "headroom", b: headroom),
      child_node(name: "compile_pool", b: compile_pool),
      runner_slice_node(runner_slice: runner_slice, runner_baseline: runner_baseline),
    ],
  }
}

fn runner_slice_cap_drifted(disk_cap: ByteSize, effective: RunnerSliceCapEffectiveness) -> Bool {
  match effective {
    CapUnbounded => true
    CapEffective { bytes: b } => !(byte_size_count(b: disk_cap) == byte_size_count(b: b))
  }
}

type FleetHostPlan
  = FleetHostPlanDerived {
      name: String,
      tree: BudgetNode,
      runner_slice_cap: ByteSize,
      effective_build_tokens: HardwareThreadCount,
      effective_runner_cpu_cap: HardwareThreadCount,
      build_step: RealizedStep<Nano>
    }
  | FleetHostPlanUnsound { reason: String }

fn fleet_host_plan_for(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  nproc: HardwareThreadCount,
  runner: FleetContainerType,
  session_slice: ByteSize,
  citation: JobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match oomd {
    OomdUnverified =>
      FleetHostPlanUnsound { reason: "oomd enforcement unverified: systemd-oomd is the eviction backstop (srv2-reboot fix + the conservation keystone); refuse to derive a host plan without it (fail closed)" }
    OomdEnforced =>
      match citation {
        JobserverAbsent =>
          FleetHostPlanUnsound { reason: "jobserver config citation absent: refuse to derive the build token bound without the cited installer knobs (margin / mem_reserve / mib_per_job)" }
        JobserverCited { config: cfg, provenance: _ } =>
          match container_baseline_bytes(c: runner) {
            BaselineUnmeasured { reason: r } => FleetHostPlanUnsound { reason: r }
            BaselineResolved { bytes: rb } => {
              let floor = oomd_actuation_floor(host: host)
              match resolve_headroom(policy: policy, floor: floor) {
                HeadroomUnsound { reason: r } => FleetHostPlanUnsound { reason: r }
                HeadroomResolved { bytes: hr } =>
                  match compile_pool_bytes_for(placement: gunbc_compile_pool_placement, nproc: nproc, host: host, citation: citation) {
                    CompilePoolUnresolved { reason: cr } => FleetHostPlanUnsound { reason: cr }
                    CompilePoolDerived { bytes: compile_pool } => {
                      let slice = runner_slice_cap(host: host, overhead: overhead, session_slice: session_slice, headroom: hr, compile_pool: compile_pool)
                      let tree = fleet_host_budget_tree(name: name, host: host, overhead: overhead, runner_baseline: rb, session_slice: session_slice, headroom: hr, runner_slice: slice, compile_pool: compile_pool)
                      FleetHostPlanDerived {
                        name: name,
                        tree: tree,
                        runner_slice_cap: slice,
                        effective_build_tokens: derive_jobserver_tokens(nproc: nproc, mem_total: host, cfg: cfg),
                        effective_runner_cpu_cap: cpu_cores_available(nproc: nproc, margin: cfg.margin),
                        build_step: build_realization(cfg: cfg),
                      }
                    }
                  }
              }
            }
          }
      }
  }
}

fn fleet_host_plan() -> FleetHostPlan {
  fleet_host_plan_for(
    name: "fleet_host",
    host: byte_size(134217728000),
    overhead: byte_size(17179869184),
    nproc: hardware_thread_count(count: 128),
    runner: gha_runner_container,
    session_slice: byte_size(0),
    citation: jobserver_config,
    policy: gunbc_fleet_headroom_policy,
    oomd: gunbc_fleet_oomd_evidence
  )
}

fn fleet_host_plan_for_offer(
  offer: ComputeOffer,
  overhead: ByteSize,
  session_slice: ByteSize,
  citation: JobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      FleetHostPlanUnsound { reason: "compute offer has no primary CPU facts: refuse to derive a host plan without a measured core count (the CPU-core runner cap needs nproc; fail closed)" }
    Present { value: cpu } =>
      fleet_host_plan_for(
        name: offer.supply.physical.identity,
        host: host_usable_ram_ceiling_bytes(host: offer.supply.physical.identity),
        overhead: overhead,
        nproc: cpu_facts_threads(cpu: cpu),
        runner: gha_runner_container,
        session_slice: session_slice,
        citation: citation,
        policy: policy,
        oomd: oomd
      )
  }
}
