module gunbc.generated_provider_acquire_seed_growth

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// Receipt for the hand-Rust that runs generated-provider acquisition in the seed (operator rulings
// option 1b and E, 2026-10-20). The model is .dag: v1.compiler.infer emits the demands
// (InferEmissions), groups them per pass (ReconciledPass), and observes them against the checked
// closure (closure_provider_acquisition_step); std.generated_provider decides. The Rust below only
// transports: it carries the per-module demand chunks out of the seed's parallel assembly, answers
// the one fact a closure builder owns (which demanded modules its pool holds, and each acquired
// module's closure), and re-checks the grown closure.
data generated_provider_acquire_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "ProviderDemands", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "group_pass_demands", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "ClosureProviderStep", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "PoolAnswer", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "pool_observation", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "judge_closure", field: WholeDeclaration },
