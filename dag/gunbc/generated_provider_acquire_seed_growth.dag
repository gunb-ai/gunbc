    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "ClosureOfError", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "Extension", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "unreadable", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire", decl_name: "tests", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "supplied", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "refused_classes", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "judge", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "compile", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "emit_check_sources", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "emit_check_pool_acquires_the_demanded_module_then_reaches_the_fixed_point", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "emit_check_pool_reports_an_unreadable_provider_as_unreadable", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "hermetic_fixture_refuses_absent_and_refused_providers_by_their_own_causes", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "entry_resolve_pool_acquires_the_demanded_module_and_a_stalled_extension_refuses_typed", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "a_present_provider_acquires_nothing_and_a_chained_demand_acquires_only_its_own_module", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "emissions_are_built_and_projected_only_at_their_named_sites", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "extended_sources", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "a_read_failure_during_acquisition_refuses_as_module_unreadable", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "cost_receipt_exact_demand_versus_carrier_presence", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.provider_acquire.tests", decl_name: "the_real_crossing_refuses_hermetically_and_acquires_through_the_pool", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "acquire_layout_closure_seeded", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "layout_provider_answer", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire.tests", decl_name: "layout_provider_answer_keeps_unreadable_distinct_from_absent", field: WholeDeclaration },
