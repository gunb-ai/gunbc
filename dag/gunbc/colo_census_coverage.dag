import extdeps.colo.lumen { lumen_newark_165_halsey, lumen_jersey_city, lumen_weehawken, lumen_cabinet_density }
import v2.std.optional { Optional, Present, Absent }

// WHERE WE LOOKED AND FOUND NOTHING, WHICH IS A MEASUREMENT AND NOT AN ABSENCE.
//
// Two census lanes reached this need independently within an hour of each other. Southern New
// Jersey - Burlington, Camden, Gloucester, Atlantic, Cumberland, Salem, Cape May - yielded zero
// facility rows, and the Hudson Valley proper - Dutchess, Orange, Ulster, Putnam - yielded zero
// retail colocation. Both lanes wanted to record that as a RESULT and neither had anywhere to put
// it, so both wrote it into a pull-request body where the next reader will never find it.
//
// THE PROBLEM IS THAT A SURVEYED-EMPTY REGION AND AN UNSURVEYED ONE RENDER IDENTICALLY. A census
// with no row for Cape May County looks exactly the same whether somebody read every operator page
// in it and found no facility, or whether nobody has ever looked. The first is expensive knowledge
// worth keeping; the second is an open obligation. Collapsing them means the expensive half is
// re-derived by the next lane, and the open half is mistaken for settled - and this census has
// already made the second error once, when the absence of any New York row was reported as a
// consequence of a refused-operator ruling rather than as nobody having surveyed the state.
//
// This module is OURS and not an upstream fact. DESIGN section 3: observations this repository
// produces are receipts in the observing layer, never properties of the observed. So it lives
// under gunbc rather than extdeps, and it cites the facility modules rather than being cited by
// them.

// What a search actually resolved to, kept because a region is empty for reasons that differ in
// what they oblige next. A region full of aggregators needs a different follow-up from one where
// operators exist but sell no retail colocation.
type EmptyRegionCause
  = ResolvedToAggregatorsOnly { detail: NonEmptyStr }
  | ResolvedToResellersWithoutFacility { detail: NonEmptyStr }
  | OperatorsPresentButNotRetailColocation { detail: NonEmptyStr }
  | DirectoryClaimContradictedByOperator { detail: NonEmptyStr }

// The three outcomes a region can have, and the two that must never be confused.
//
// SurveyedNoRetailOperator is the case where somebody looked, systematically, and there is nothing
// to model. Its searched list is what makes it a measurement rather than an assertion: a later
// reader can see the coverage and judge whether it was thorough, instead of taking "empty" on
// trust. RegionUnsurveyed is the case where nobody has looked, and it is the only arm carrying an
// open obligation.
//
// The per-arm notes were written between the arms, where section 4c does not model annotations -
// only module-item grain is captured, so an indented comment inside a declaration body is a parse
// error rather than a preserved rationale. They are hoisted here intact.
type RegionSurveyOutcome
  = FacilitiesModelled {
      facilities: List<ColoFacilityRow>
      densities: List<CabinetDensityClaim>
    }
  | SurveyedNoRetailOperator {
      searched: List<NonEmptyStr>
      causes: List<EmptyRegionCause>
      surveyed_on: NonEmptyStr
      surveyed_by: NonEmptyStr
    }
  | RegionUnsurveyed {
      obligation: NonEmptyStr
    }

type RegionCoverage {
  region_label: NonEmptyStr
  region_code: NonEmptyStr
  outcome: RegionSurveyOutcome
}

fn coverage_is_surveyed(c: RegionCoverage) -> Bool {
  match c.outcome {
    FacilitiesModelled { facilities, densities } => true,
    SurveyedNoRetailOperator { searched, causes, surveyed_on, surveyed_by } => true,
    RegionUnsurveyed { obligation } => false,
  }
}

// A surveyed region contributes its facility count; an EMPTY surveyed region contributes zero and
// an UNSURVEYED one contributes nothing at all. The distinction is the whole point of the module,
// so the count is Optional rather than a zero that both arms could produce.
fn coverage_facility_count(c: RegionCoverage) -> Int? {
  match c.outcome {
    FacilitiesModelled { facilities, densities } => Present { value: facilities.length() },
    SurveyedNoRetailOperator { searched, causes, surveyed_on, surveyed_by } => Present { value: 0 },
    RegionUnsurveyed { obligation } => Absent,
  }
}

// THE CORRIDOR ROW, AND THE NUMBER THAT SHOULD WORRY A READER MOST. Twenty-eight facilities
// modelled in the densest colocation market in the region, and ONE of them publishes a cabinet
// density anybody has verified against page bytes. That ratio is the census's real finding about
// the corridor: the facilities are there, the retail density figures are not published, and a
// planner who wanted a dense cabinet in Hudson-Bergen-Essex would be negotiating rather than
// shopping.
//
// The count is one AFTER an audit, not before it. This region briefly read two: a Summit Secaucus
// row citing 12 kW in a 42U cabinet, whose wording reproduced in the page bytes exactly and which
// sat under a block headed "Limited Time: Chicago-Area Facility". Real figure, published price,
// wrong metro. The withdrawal is recorded in
// gunbc.recurring_failure_mode.citation_verified_against_a_rendering_that_destroyed_its_scope,
// because a citation confirmed by string occurrence alone cannot fail on correct text attached to
// the wrong subject.
// A DENSITY IS READ EXACTLY WHEN THE CARRIER CAN PRODUCE A BOUND FOR IT, and that question is
// already answered by extdeps.colo.types. Asking it through cabinet_density_air_upper_bound rather
// than re-matching the arms here keeps one authority for what "read" means: the upper bound is
// Present for both published arms - real power and apparent power - and Absent exactly for
// DensityUnread. A local predicate over the same coproduct would be a second spelling of a
// question the carrier owns, which is the fork the deleted cabinet_density_is_read was removed to
// avoid reintroducing.
fn density_claim_is_read(d: CabinetDensityClaim) -> Bool {
  match cabinet_density_air_upper_bound(d: d) {
    Present { value } => true,
    Absent => false,
  }
}

// COUNTS DENSITY CLAIMS, NOT FACILITIES, and the two differ on purpose. Several corridor operators
// publish one density statement covering every site they run, so a claim is the grain at which the
// reading actually exists; attributing an operator-level claim to each of its facilities would
// invent per-facility readings nobody published. Today the distinction changes nothing - the single
// read claim is DataBank's, which is facility-level and covers one site - but it will the moment a
// multi-site operator publishes, and a count that had silently picked the other grain would be
// wrong without changing.
fn coverage_density_read_count(c: RegionCoverage) -> Int? {
  match c.outcome {
    FacilitiesModelled { facilities, densities } => Present { value: densities.filter(d => density_claim_is_read(d: d)).length() },
    SurveyedNoRetailOperator { searched, causes, surveyed_on, surveyed_by } => Absent,
    RegionUnsurveyed { obligation } => Absent,
  }
}

// THE COUNTS ARE GONE AND THE ROWS ARE HERE INSTEAD, which is review 62780's finding fixed at the
// root: 28 and 1 were hand-transcribed measurements of the repo's own live corpus, and DESIGN
// section 6 says a measurement is cited by naming the producer that re-derives it. Deriving them
// immediately proved the point - the corridor holds TWENTY-SEVEN facility rows, not the 28 that had
// been typed. Nothing could have gone red on that: the witness asserted only
// density_read_count <= facility_count, which a wrong facility count satisfies comfortably.
//
// TWO MEMBERSHIP DECISIONS A READER SHOULD NOT HAVE TO INFER. digital_realty_ewr10 IS listed even
// though its operator no longer does: the field says facilities MODELLED, and a roster that
// silently disagreed with the corpus would be a second authority on what the census contains. Its
// withdrawal is recorded where it belongs, on the row itself, and a consumer choosing quote targets
// must read that rather than this length. And the out-of-corridor rows in these same modules -
// digital_realty_ewr20 in Clifton, three_sixty_five_bridgewater, h5_philadelphia,
// colocation_america_njdc1, databank_lga4_orangeburg - are deliberately absent: this row is a
// region, not an operator inventory.
data nj_hudson_bergen_essex_corridor: RegionCoverage = RegionCoverage {
  region_label: "NJ Hudson-Bergen-Essex corridor",
  region_code: "NJ",
  outcome: FacilitiesModelled {
    facilities: [
      equinix_ny1, equinix_ny2, equinix_ny3, equinix_ny4, equinix_ny5, equinix_ny6, equinix_ny7,
      coresite_ny2, coresite_ny3,
      centersquare_weehawken, centersquare_ewr5_secaucus,
      digital_realty_ewr10,
      three_sixty_five_carlstadt, three_sixty_five_weehawken,
      dataverge_jersey_city,
      evocative_ewr1,
      summit_secaucus,
      h5_secaucus,
      hivelocity_jfk1,
      interserver_secaucus, interserver_teb4_secaucus,
      halsey_165_newark,
      databank_ewr1_newark,
      colocation_america_njdc2_secaucus,
      lumen_newark_165_halsey, lumen_jersey_city, lumen_weehawken,
    ],
    densities: [
      equinix_cabinet_density,
      coresite_secaucus_density,
      centersquare_cabinet_density,
      digital_realty_cabinet_density,
      three_sixty_five_cabinet_density,
      dataverge_cabinet_density,
      evocative_ewr1_density,
      summit_secaucus_density,
      h5_secaucus_density,
      hivelocity_jfk1_density,
      interserver_cabinet_density,
      halsey_165_cabinet_density,
      databank_ewr1_density,
      colocation_america_cabinet_density,
      lumen_cabinet_density,
    ],
  },
}

data southern_new_jersey: RegionCoverage = RegionCoverage {
  region_label: "Southern New Jersey",
  region_code: "NJ",
  outcome: SurveyedNoRetailOperator {
    searched: [
      "Burlington County", "Camden County", "Gloucester County", "Atlantic County",
      "Cumberland County", "Salem County", "Cape May County",
    ],
    causes: [
      ResolvedToAggregatorsOnly { detail: "every search hit resolved to a directory aggregator or a lead-generation page rather than an operator publishing a facility" },
      ResolvedToResellersWithoutFacility { detail: "managed-service resellers with no facility of their own" },
      DirectoryClaimContradictedByOperator { detail: "TierPoint is directory-cited in New Jersey but its own location pages carry NO New Jersey site; Agile Data Sites is directory-cited for a Monmouth Junction facility and now redirects to databridgesites.com, which lists Silver Spring and Aurora and no New Jersey location" },
    ],
    surveyed_on: "2026-09-08",
    surveyed_by: "census lane: NJ central and south",
  },
}

data hudson_valley: RegionCoverage = RegionCoverage {
  region_label: "Hudson Valley proper",
  region_code: "NY",
  outcome: SurveyedNoRetailOperator {
    searched: ["Dutchess County", "Orange County", "Ulster County", "Putnam County"],
    causes: [
      OperatorsPresentButNotRetailColocation { detail: "what is present is enterprise or hyperscale-shaped - IBM Poughkeepsie, a CyrusOne enterprise hall, a blocked East Fishkill build - none of it publishing retail colocation at cabinet grain" },
    ],
    surveyed_on: "2026-09-08",
    surveyed_by: "census lane: NY Westchester Rockland Hudson Valley and Long Island",
  },
}

// THIS ROSTER IS INCOMPLETE BY CONSTRUCTION and must not be read as the census's coverage map. It
// carries the regions a lane surveyed, including ones surveyed and found empty; it does not carry a
// RegionUnsurveyed row for everything nobody has looked at, which is most of the country. Adding
// those rows is worth doing only when the census's geographic scope is decided - an unsurveyed
// roster over an undecided scope is a list whose length is an artefact of where the author stopped
// typing. Carried as an annotation rather than a String row because no fold reads it: per DESIGN
// section 4c an ordinary String declaration whose sole purpose is commentary is misplaced or dead
// data, and // is the explicit quarantine boundary for exactly this.
data census_regions: List<RegionCoverage> = [nj_hudson_bergen_essex_corridor, southern_new_jersey, hudson_valley]
