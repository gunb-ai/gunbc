module gunbc.fleet_receipt_collector


// Operator verdict join 5 (2026-08-09): the receipts hosts PUBLISH were consumed by
// nothing — converge wrote /opt/gunbc/receipts/<host>-converge-receipt.txt and
// fleet_convergence_verdict folded over whatever list a caller handed it, with no
// collector in between, so the fold's NotConverged came from an empty registry rather
// than from observed state. This module is that collector: read each fleet host's
// published receipt at the modeled endpoint, PARSE it through one typed grammar (the
// byte-locked converge-receipt line read back — the same grammar the CLI renders,
// asked in the other direction), and classify per host with no absorbing arm: a
// collected receipt, an absent one (typed cause — unreachable and not-yet-published
// stay distinct in the cause text carried), or an unparseable one (a receipt that
// exists but does not decode is CONTRADICTION-shaped evidence, never skipped into
// absence). Only Collected rows enter the fold; every other arm keeps the host
// knob-unobserved, which the fold already refuses to call converged.
type CollectedHostReceipt
  = ReceiptCollected { host: String, receipt: gunbc.fleet_converge_cli.ConvergeCliReceipt }
  | ReceiptAbsent { host: String, cause: String }
  | ReceiptUnparseable { host: String, line: String }
  | ReceiptConvergedUnbacked { host: String, line: String }

// Forward grammar lives in converge_cli_receipt_line; this is the backward read of the
// SAME line shape: "converge-receipt host=H applied=N drifted=N verdict=V". A missing
// prefix, missing field, or unknown verdict label refuses (gunbc.host_converge.Absent), never guesses.
fn parse_converge_receipt_line(line: String) -> gunbc.fleet_converge_cli.ConvergeCliReceipt? {
  let tokens = split(s: std.algebra.trim(s: line), delimiter: " ")
  if length(tokens) == 5
    && match tokens.first() { Present { value: t } => t == "converge-receipt" gunbc.host_converge.Absent => false } {
    match receipt_field(tokens: tokens, key: "host=") {
      Present { value: host } =>
        match receipt_field(tokens: tokens, key: "verdict=") {
          Present { value: label } =>
            match parse_converge_verdict_label(label: label) {
              Present { value: v } =>
                match parse_int(s: receipt_field_or_empty(tokens: tokens, key: "applied=")) {
                  Present { value: applied } =>
                    match parse_int(s: receipt_field_or_empty(tokens: tokens, key: "drifted=")) {
                      Present { value: drifted } =>
                        Present {
                          value: gunbc.fleet_converge_cli.ConvergeCliReceipt {
                            host: host,
                            applied: applied,
                            drifted: drifted,
                            verdict: v,
                            reason: none,
                          },
                        }
                      gunbc.host_converge.Absent => none
                    }
                  gunbc.host_converge.Absent => none
                }
              gunbc.host_converge.Absent => none
            }
          gunbc.host_converge.Absent => none
        }
      gunbc.host_converge.Absent => none
    }
  } else {
    none
  }
}

fn receipt_field(tokens: List<String>, key: String) -> String? {
  fold(tokens, init: none, f: fn(acc, t) {
    if starts_with(s: t, prefix: key) {
      Present { value: drop_prefix(s: t, prefix: key) }
    } else {
      acc
    }
  })
}

fn receipt_field_or_empty(tokens: List<String>, key: String) -> String {
  match receipt_field(tokens: tokens, key: key) {
    Present { value: v } => v
    gunbc.host_converge.Absent => ""
  }
}

fn drop_prefix(s: String, prefix: String) -> String {
  substring(s: s, start: prefix.length(), end: s.length())
}

// Review 50817: decode each label to ITS verdict constructor directly. An earlier
// revision routed drifted/absent through converge_verdict(effective: "", expected:
// label), which returns gunbc.host_converge.Absent whenever effective is empty — silently re-classifying a
// published gunbc.host_converge.Drifted as gunbc.host_converge.Absent on collection, exactly the state-space conflation the
// header forbids (different remedies: run the converge vs build the observation).
fn parse_converge_verdict_label(label: String) -> gunbc.host_converge.ConvergeVerdict? {
  if label == "converged" {
    Present { value: gunbc.host_converge.VerdictConverged }
  } else {
    if label == "drifted" {
      Present { value: gunbc.host_converge.Drifted }
    } else {
      if label == "absent" {
        Present { value: gunbc.host_converge.Absent }
      } else {
        none
      }
    }
  }
}

// One host's collection: cat the published receipt over the typed argv seam at the
// modeled endpoint. Wire refusal or transport failure -> gunbc.host_converge.Absent with the cause; a first
// line that does not decode -> Unparseable carrying the exact bytes.
fn collect_host_receipt(host: String) -> gunbc.fleet_receipt_collector.CollectedHostReceipt {
  match gunbc.fleet_reach_endpoint.fleet_probe_target_for(host: host) {
    ProbeTargetRefused { host: _, cause: c } =>
      ReceiptAbsent {
        host: host,
        cause: match c {
          gunbc.fleet_reach_endpoint.PrincipalUnobserved { note: n } => join(["principal unobserved (no SSH attempted): ", n], "")
          EndpointUnobserved { note: n } => join(["endpoint unobserved (no SSH attempted): ", n], "")
        },
      }
    ProbeTargetReady { host: _, endpoint: e, remote_principal: p } =>
  match gunbc.typed_argv_exec.typed_argv_probe_over_ssh(
    host: gunbc.fleet_reach_endpoint.fleet_probe_ready_ssh_target(t_host: host, endpoint: e, remote_principal: p) as std.types.NonEmptyStr,
    argv: ["cat", gunbc.fleet_converge_cli.fleet_converge_receipt_path(host: host)],
  ) {
    TypedArgvExecConverged { result: r } =>
      if r.success {
        classify_receipt_stdout(host: host, raw: r.stdout)
      } else {
        ReceiptAbsent { host: host, cause: std.algebra.trim(s: r.stderr) }
      }
    TypedArgvExecRefused { reason: why } => ReceiptAbsent { host: host, cause: why }
  }
  }
}

fn receipt_first_line(raw: String) -> String? {
  match split(s: raw, delimiter: "\n").first() {
    Present { value: l } => if std.algebra.trim(s: l) == "" { none } else { Present { value: std.algebra.trim(s: l) } }
    gunbc.host_converge.Absent => none
  }
}

// The pure classification of a receipt's raw bytes, split out from the wet SSH seam so the
// b1 converged-must-be-backed discriminator is testable hermetically with synthetic bytes.
// A converged line-1 verdict is admitted as Collected ONLY when the receipt also carries an
// observed revision cell; otherwise it is ConvergedUnbacked (refused from the fold), never
// laundered into the registry as converged. gunbc.host_converge.Drifted/absent verdicts do not require the
// observed cell (they are not claiming convergence). Empty stdout -> gunbc.host_converge.Absent; an undecodable
// first line -> Unparseable (contradiction-shaped, never absence).
fn classify_receipt_stdout(host: String, raw: String) -> gunbc.fleet_receipt_collector.CollectedHostReceipt {
  match receipt_first_line(raw: raw) {
    Present { value: line } =>
      match parse_converge_receipt_line(line: line) {
        Present { value: receipt } =>
          match receipt.verdict {
            VerdictConverged =>
              match converge_revision_observed_hex(raw: raw) {
                Present { value: _ } => ReceiptCollected { host: host, receipt: receipt }
                gunbc.host_converge.Absent => ReceiptConvergedUnbacked { host: host, line: line }
              }
            gunbc.host_converge.Drifted => ReceiptCollected { host: host, receipt: receipt }
            gunbc.host_converge.Absent => ReceiptCollected { host: host, receipt: receipt }
          }
        gunbc.host_converge.Absent => ReceiptUnparseable { host: host, line: line }
      }
    gunbc.host_converge.Absent => ReceiptAbsent { host: host, cause: "receipt file empty" }
  }
}

// b1 CONVERGE-close discriminator: a line-1 verdict=converged is only trustworthy when the
// SAME receipt's revision cell (line 2, converge_cli_revision_line) is the OBSERVED form —
// "converge-revision observed=<hex>". #8101 makes the CLI unable to render converged without
// an observed+matched revision, so a new-binary converged receipt always carries observed=<hex>.
// The stale receipt a pre-#8101 binary persisted carries line1 verdict=converged beside line2
// "converge-revision verdict=unobserved" (no observed hex) — the fabricated-plausible-output §5
// forbids: converged asserted by a run that never observed the ref. This scans the receipt for
// the revision cell and returns the observed hex only for the observed form; drift, unobserved,
// the old verdict= form, and a missing cell all return none. It is a structural presence test,
// NOT a freshness heuristic (parent ruling: either the revision is in the receipt or the receipt
// is unusable — no timestamp, no threshold).
fn converge_revision_observed_hex(raw: String) -> String? {
  fold(split(s: raw, delimiter: "\n"), init: none, f: fn(acc, l) {
    let tokens = split(s: std.algebra.trim(s: l), delimiter: " ")
    if match tokens.first() { Present { value: t } => t == "converge-revision" gunbc.host_converge.Absent => false } {
      match receipt_field(tokens: tokens, key: "observed=") {
        Present { value: hex } => Present { value: hex }
        gunbc.host_converge.Absent => acc
      }
    } else {
      acc
    }
  })
}

fn collected_receipts_only(collected: List<gunbc.fleet_receipt_collector.CollectedHostReceipt>) -> List<gunbc.fleet_converge_cli.ConvergeCliReceipt> {
  collected.flat_map(c => match c {
    ReceiptCollected { host: _, receipt: r } => [r]
    ReceiptAbsent { host: _, cause: _ } => []
    ReceiptUnparseable { host: _, line: _ } => []
    ReceiptConvergedUnbacked { host: _, line: _ } => []
  })
}

fn collected_line(c: gunbc.fleet_receipt_collector.CollectedHostReceipt) -> String {
  match c {
    ReceiptCollected { host: h, receipt: _ } => join(["collect host=", h, " outcome=collected"], "")
    ReceiptAbsent { host: h, cause: why } => join(["collect host=", h, " outcome=absent cause=", why], "")
    ReceiptUnparseable { host: h, line: l } => join(["collect host=", h, " outcome=unparseable line=", l], "")
    ReceiptConvergedUnbacked { host: h, line: l } => join(["collect host=", h, " outcome=converged-unbacked line=", l], "")
  }
}

data fleet_collect_receipt_path: String = "target/fleet-converge-collect-receipt.txt"

// The wet collector run: collect every fleet target, feed ONLY collected receipts to
// the atomic fold (join 5's composition — executed observation -> registry -> verdict),
// and publish one collect receipt naming each host's collection outcome plus the fold
// verdict. Exit reflects publication only: an honest NotConverged is a successful
// collection, not a process failure.
//
// Enrollment rides with the run, SAME path as probe_fleet_reach_wet (review 50900, §3
// one enrollment authority / §5 no ambient trust): the collector runs in its OWN
// isolated main-push job with a fresh ephemeral HOME and WIF-materialized key but no
// durable known_hosts, so it MUST materialize the pinned enrolled-only config before
// its SSH legs — otherwise fleet_host_key_enroll_apply's StrictHostKeyChecking-yes pin
// never lands here and the collector's ssh either refuses or falls back to ambient
// known_hosts (the exact anchor hole the pin closes for the probe). Call it FIRST and
// carry its readback in the collect receipt, mirroring the probe entry.
func collect_fleet_convergence_wet() -> std.process.ProcessExit {
  let enroll_lines = gunbc.fleet_host_key_enrollment.fleet_host_key_enroll_apply()
  let collected = map(gunbc.fleet_reach_endpoint.fleet_reach_probe_targets, h => collect_host_receipt(host: h))
  let verdict = gunbc.fleet_convergence_verdict.fleet_convergence_verdict(
    enrollments: gunbc.host_phase_status.fleet_subsumption_enrollments,
    receipts: collected_receipts_only(collected: collected),
  )
  let verdict_line = match verdict {
    FleetConverged { host_count: n } => concat("fleet-verdict converged hosts=", to_string(n))
    FleetNotConverged { standings: s } => concat("fleet-verdict not-converged standings=", to_string(length(s)))
  }
  let body = join([enroll_lines, join(map(collected, c => collected_line(c: c)), "\n"), "\n", verdict_line, "\n"], "")
  let w = Filesystem.Write(path: fleet_collect_receipt_path, content: body)
  if w.success {
    std.process.ExitSuccess
  } else {
    std.process.exit_failure(reason: concat("fleet_receipt_collector: collect receipt publication failed — ", w.error))
  }
}
