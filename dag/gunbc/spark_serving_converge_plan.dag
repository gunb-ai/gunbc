module gunbc.spark_serving_converge_plan

import std.types { String, List, Bool, NonEmptyStr, Int }
import std.content_hash { content_hash_of_value, serialize_content_hash, Fnv1a64 }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }
import gunbc.membership_reconcile { MembershipPlan, MemberAction, membership_write_count }
import gunbc.spark_serving_membership {
  SparkServingMember,
  SparkServingLingerAddress,
  spark_serving_member,
  spark_serving_serving_principal,
  spark_serving_executor_linger_state_digest,
  spark_serving_membership_reconcile,
  spark_serving_membership_noop,
}
import gunbc.spark_serving_member_realization {
  spark_serving_install_effects_for_member_action,
  spark_serving_install_effects_include,
}
import gunbc.spark_serving_realization { ServingInstallEffect, EnableLingerForOwnAccount }
import gunbc.fleet_converge_plan {
  FleetConvergePlanArtifact,
  FleetConvergeSparkServingTypedAction,
  fleet_converge_plan_subject,
  fleet_converge_plan_held_lease,
  fleet_converge_apply_shell,
  TimerRetirementMember,
  CapMember,
  timer_retirement_plan,
  membership_plan_lines_timer,
  membership_plan_lines_cap,
  fleet_converge_desired_caps,
  caps_reconcile,
  observed_baseline_text,
  fleet_converge_plan_lease_key,
  membership_refusal_count,
  fleet_converge_spark_serving_action_line,
  fleet_converge_spark_serving_typed_actions_wire,
}
data spark_serving_converge_plan_authority_note: String = "Seam 2 vertical slice — Spark serving membership frozen into FleetConvergePlanArtifact typed rows. First member kind: Ensured linger (SparkServingLingerAddress → EnableLingerForOwnAccount). Plan observes linger state, runs membership_reconcile once, serializes MemberAction + install_effects into typed_action_rows on the artifact; apply MUST read those frozen rows (never re-derive). Spark actuation is typed argv via spark_serving_converge_realize + typed_argv_exec — NOT merged into apply_shell. Change arm (disable-linger) is NOT claimed proven — sudoers grants enable-linger only."

fn spark_serving_converge_host_is_spark(host: NonEmptyStr) -> Bool {
  host == (operator_host_srv5 as NonEmptyStr) || host == (operator_host_srv6 as NonEmptyStr)
}

fn spark_serving_desired_linger_member(host: HostIdentity) -> SparkServingMember {
  spark_serving_member(
    host: host,
    principal: spark_serving_serving_principal(),
    address: SparkServingLingerAddress,
    state_digest: spark_serving_executor_linger_state_digest(),
    ownership: Ensured,
  )
}

fn spark_serving_linger_observed_members(
  host: HostIdentity,
  linger_enabled: Bool,
) -> List<SparkServingMember> {
  if linger_enabled {
    [spark_serving_desired_linger_member(host: host)]
  } else {
    [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingLingerAddress,
        state_digest: "linger=disabled" as NonEmptyStr,
        ownership: Ensured,
      ),
    ]
  }
}

fn spark_serving_linger_membership_plan(
  host: HostIdentity,
  linger_enabled: Bool,
) -> MembershipPlan<SparkServingMember> {
  spark_serving_membership_reconcile(
    desired: [spark_serving_desired_linger_member(host: host)],
    observed: spark_serving_linger_observed_members(host: host, linger_enabled: linger_enabled),
  )
}

fn fleet_converge_spark_serving_typed_action(
  action: MemberAction<SparkServingMember>,
) -> FleetConvergeSparkServingTypedAction? {
  match spark_serving_install_effects_for_member_action(action: action) {
    Present { value: effects } =>
      Present {
        value: FleetConvergeSparkServingTypedAction {
          action: action,
          install_effects: effects,
        },
      }
    Absent => Absent
  }
}

fn fleet_converge_spark_serving_typed_actions(
  plan: MembershipPlan<SparkServingMember>,
) -> List<FleetConvergeSparkServingTypedAction> {
  flat_map(plan.actions, a =>
    match fleet_converge_spark_serving_typed_action(action: a) {
      Present { value: row } => [row]
      Absent => []
    }
  )
}

fn spark_serving_fleet_converge_apply_shell(
  timer_plan: MembershipPlan<TimerRetirementMember>,
) -> String {
  fleet_converge_apply_shell(timer_plan: timer_plan)
}

fn spark_serving_fleet_converge_plan_artifact(
  host: NonEmptyStr,
  prior_generation: Int,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  linger_enabled: Bool,
) -> FleetConvergePlanArtifact? {
  if !spark_serving_converge_host_is_spark(host: host) {
    none
  } else {
    let host_identity = host as HostIdentity
    let linger_plan = spark_serving_linger_membership_plan(
      host: host_identity,
      linger_enabled: linger_enabled,
    )
    let spark_rows = fleet_converge_spark_serving_typed_actions(plan: linger_plan)
    let subject = fleet_converge_plan_subject(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
    )
    let timer_plan = timer_retirement_plan(observed: observed_timers)
    let cap_plan = caps_reconcile(desired: fleet_converge_desired_caps(), observed: observed_caps)
    let timer_lines = membership_plan_lines_timer(plan: timer_plan)
    let cap_lines = membership_plan_lines_cap(plan: cap_plan)
    let spark_lines = map(spark_rows, r => fleet_converge_spark_serving_action_line(row: r))
    let baseline = observed_baseline_text(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
    )
    let planned_generation = prior_generation + 1
    let spark_wire = fleet_converge_spark_serving_typed_actions_wire(rows: spark_rows)
    let apply_shell = spark_serving_fleet_converge_apply_shell(timer_plan: timer_plan)
    let body = join(
      concat(
        [
          "# fleet-converge plan",
          concat("subject_host:", subject.host as String),
          concat(
            "subject_member_set:",
            serialize_content_hash(hash: subject.member_set_fingerprint) as String,
          ),
          concat("plan_generation:", to_string(planned_generation)),
          concat("lease_key:", fleet_converge_plan_lease_key(host: subject.host) as String),
          "observed_baseline:",
          baseline,
          "# timer-retirement",
        ],
        timer_lines,
        ["# cap-axis"],
        cap_lines,
        ["# spark-serving-linger"],
        spark_lines,
        [
          concat("# spark-serving-typed-actions:", spark_wire),
          concat("# spark-linger-writes=", to_string(membership_write_count(plan: linger_plan))),
          concat("# cap-refusals=", to_string(membership_refusal_count(plan: cap_plan))),
          concat("# timer-refusals=", to_string(membership_refusal_count(plan: timer_plan))),
        ],
      ),
      "\n",
    )
    let owner_fp = content_hash_of_value(value: body as NonEmptyStr)
    let lease = fleet_converge_plan_held_lease(
      subject: subject,
      prior_generation: prior_generation,
      owner_fingerprint: owner_fp,
    )
    match content_hash_of_value(value: baseline as NonEmptyStr) {
      Fnv1a64(structural) =>
        Present {
          value: FleetConvergePlanArtifact {
            subject: subject,
            prior_generation: prior_generation,
            plan_lease: lease,
            observed_baseline_hex: structural.digest,
            plan_body: body,
            apply_shell: apply_shell,
            spark_serving_typed_actions: spark_rows,
          },
        }
      _ => Absent
    }
  }
}

fn spark_serving_linger_slice_noop_when_converged(linger_enabled: Bool) -> Bool {
  spark_serving_membership_noop(
    plan: spark_serving_linger_membership_plan(
      host: operator_host_srv5,
      linger_enabled: linger_enabled,
    ),
  )
}

fn spark_serving_frozen_linger_effect(row: FleetConvergeSparkServingTypedAction) -> ServingInstallEffect? {
  if spark_serving_install_effects_include(
    effects: row.install_effects,
    needle: EnableLingerForOwnAccount,
  ) {
    Present { value: EnableLingerForOwnAccount }
  } else {
    Absent
  }
}
