module gunbc.spark_serving_converge_plan

data spark_serving_converge_plan_authority_note: String = "Seam 2 vertical slice — Spark serving membership frozen into FleetConvergePlanArtifact typed rows. First member kind: Ensured linger (SparkServingLingerAddress → EnableLingerForOwnAccount). Plan observes linger state, runs membership_reconcile once, serializes MemberAction + install_effects into typed_action_rows on the artifact; apply MUST read those frozen rows (never re-derive). Spark actuation is typed argv via spark_serving_converge_realize + typed_argv_exec — NOT merged into apply_shell. Change arm (disable-linger) is NOT claimed proven — sudoers grants enable-linger only."

fn spark_serving_converge_host_is_spark(host: std.types.NonEmptyStr) -> std.types.Bool {
  host == (gunbc.fleet_intent_network.operator_host_srv5 as std.types.NonEmptyStr) || host == (gunbc.fleet_intent_network.operator_host_srv6 as std.types.NonEmptyStr)
}

fn spark_serving_desired_linger_member(host: product.placement_supply.HostIdentity) -> gunbc.spark_serving_membership.SparkServingMember {
  gunbc.spark_serving_membership.spark_serving_member(
    host: host,
    principal: gunbc.spark_serving_membership.spark_serving_serving_principal(),
    address: gunbc.spark_serving_membership.SparkServingLingerAddress,
    state_digest: gunbc.spark_serving_membership.spark_serving_executor_linger_state_digest(),
    ownership: Ensured,
  )
}

fn spark_serving_linger_observed_members(
  host: product.placement_supply.HostIdentity,
  linger_enabled: std.types.Bool,
) -> std.types.List<gunbc.spark_serving_membership.SparkServingMember> {
  if linger_enabled {
    [spark_serving_desired_linger_member(host: host)]
  } else {
    [
      gunbc.spark_serving_membership.spark_serving_member(
        host: host,
        principal: gunbc.spark_serving_membership.spark_serving_serving_principal(),
        address: gunbc.spark_serving_membership.SparkServingLingerAddress,
        state_digest: gunbc.spark_serving_membership.spark_serving_executor_linger_disabled_state_digest(),
        ownership: Ensured,
      ),
    ]
  }
}

fn spark_serving_linger_membership_plan(
  host: product.placement_supply.HostIdentity,
  linger_enabled: std.types.Bool,
) -> gunbc.membership_reconcile.MembershipPlan<gunbc.spark_serving_membership.SparkServingMember, gunbc.spark_serving_membership.SparkServingMemberAt> {
  gunbc.spark_serving_membership.spark_serving_membership_reconcile(
    desired: [spark_serving_desired_linger_member(host: host)],
    observed: spark_serving_linger_observed_members(host: host, linger_enabled: linger_enabled),
  )
}

fn fleet_converge_spark_serving_typed_action(
  action: gunbc.membership_reconcile.MemberAction<gunbc.spark_serving_membership.SparkServingMember, gunbc.spark_serving_membership.SparkServingMemberAt>,
) -> gunbc.fleet_converge_plan.FleetConvergeSparkServingTypedAction? {
  match gunbc.spark_serving_member_realization.spark_serving_install_effects_for_member_action(action: action) {
    Present { value: effects } =>
      Present {
        value: gunbc.fleet_converge_plan.FleetConvergeSparkServingTypedAction {
          action: action,
          install_effects: effects,
        },
      }
    Absent => Absent
  }
}

// A PLANNED MEMBER THAT DOES NOT TRANSLATE REFUSES; IT IS NOT DROPPED.
//
// This projection used to be `flat_map` with `Absent => []`, which discarded any action carrying no
// install effects and produced a SHORTER row list with no diagnostic. The only action that reaches
// that arm is `MemberRemovalRefused` -- itself a refusal, so the drop erased a refusal by silently
// succeeding, and the artifact then reported a typed_row_count that did not cover its own plan.
//
// Its observed frequency was zero BY CONSTRUCTION: the only live plan is linger-only and linger
// always translates, so nothing ever exercised the arm. That is what made it worth closing before
// the plan widens rather than after -- a four-member plan is exactly the input that reaches it.
type SparkServingTypedActionProjection
  = SparkServingTypedActionsProjected { rows: List<gunbc.fleet_converge_plan.FleetConvergeSparkServingTypedAction> }
  | SparkServingTypedActionsRefused { cause: String }

fn fleet_converge_spark_serving_typed_actions(
  plan: gunbc.membership_reconcile.MembershipPlan<gunbc.spark_serving_membership.SparkServingMember, gunbc.spark_serving_membership.SparkServingMemberAt>,
) -> SparkServingTypedActionProjection {
  let rows = flat_map(plan.actions, a =>
    match fleet_converge_spark_serving_typed_action(action: a) {
      Present { value: row } => [row]
      Absent => []
    }
  )
  if length(rows) == length(plan.actions) {
    SparkServingTypedActionsProjected { rows: rows }
  } else {
    SparkServingTypedActionsRefused {
      cause: join([
        "spark serving typed actions refused: ", to_string(length(plan.actions)),
        " planned member actions projected to only ", to_string(length(rows)),
        " typed rows, so a planned member would have been dropped from the frozen artifact",
      ], ""),
    }
  }
}

fn spark_serving_fleet_converge_apply_shell(
  timer_plan: gunbc.membership_reconcile.MembershipPlan<gunbc.fleet_converge_plan.TimerRetirementMember, gunbc.fleet_converge_plan.TimerRetirementMemberAt>,
) -> String {
  gunbc.fleet_converge_plan.fleet_converge_apply_shell(timer_plan: timer_plan)
}

// DECLARED RESIDUE, named rather than left to be found. This function propagates a typed-action
// refusal but not its CAUSE: `FleetConvergePlanArtifact?` has no arm to carry one, so the wet slice
// renders the generic `plan-refused` verdict and a reader cannot tell a dropped member from a
// non-Spark host. The arm is unreachable under the linger-only plan, so this is a bounded gap and
// not a live one. Trigger: it dissolves with the artifact return type, which the full-population
// cutover has to widen anyway -- that is the commit where the cause gets somewhere to go.
fn spark_serving_fleet_converge_plan_artifact(
  host: std.types.NonEmptyStr,
  prior_generation: Int,
  observed_timers: std.types.List<gunbc.fleet_converge_plan.TimerRetirementMember>,
  observed_caps: std.types.List<gunbc.host_axis_caps.CapMember>,
  linger_enabled: std.types.Bool,
) -> gunbc.fleet_converge_plan.FleetConvergePlanArtifact? {
  if !spark_serving_converge_host_is_spark(host: host) {
    none
  } else {
    let host_identity = host as product.placement_supply.HostIdentity
    let linger_plan = spark_serving_linger_membership_plan(
      host: host_identity,
      linger_enabled: linger_enabled,
    )
    match fleet_converge_spark_serving_typed_actions(plan: linger_plan) {
      SparkServingTypedActionsRefused { cause: _ } => none
      SparkServingTypedActionsProjected { rows: spark_rows } =>
        spark_serving_fleet_converge_plan_artifact_from_rows(
          host: host,
          prior_generation: prior_generation,
          observed_timers: observed_timers,
          observed_caps: observed_caps,
          linger_plan: linger_plan,
          spark_rows: spark_rows,
        )
    }
  }
}

fn spark_serving_fleet_converge_plan_artifact_from_rows(
  host: std.types.NonEmptyStr,
  prior_generation: Int,
  observed_timers: List<gunbc.fleet_converge_plan.TimerRetirementMember>,
  observed_caps: List<gunbc.host_axis_caps.CapMember>,
  linger_plan: gunbc.membership_reconcile.MembershipPlan<gunbc.spark_serving_membership.SparkServingMember, gunbc.spark_serving_membership.SparkServingMemberAt>,
  spark_rows: List<gunbc.fleet_converge_plan.FleetConvergeSparkServingTypedAction>,
) -> gunbc.fleet_converge_plan.FleetConvergePlanArtifact? {
  let subject = gunbc.fleet_converge_plan.fleet_converge_plan_subject(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
    )
    let timer_plan = gunbc.fleet_converge_plan.timer_retirement_plan(observed: observed_timers)
    let cap_plan = gunbc.fleet_converge_plan.caps_reconcile(desired: gunbc.fleet_converge_plan.fleet_converge_desired_caps(), observed: observed_caps)
    let timer_lines = gunbc.fleet_converge_plan.membership_plan_lines_timer(plan: timer_plan)
    let cap_lines = gunbc.fleet_converge_plan.membership_plan_lines_cap(plan: cap_plan)
    let spark_lines = map(spark_rows, r => gunbc.fleet_converge_plan.fleet_converge_spark_serving_action_line(row: r))
    let baseline = gunbc.fleet_converge_plan.observed_baseline_text(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
    )
    let planned_generation = prior_generation + 1
    let spark_wire = gunbc.fleet_converge_plan.fleet_converge_spark_serving_typed_actions_wire(rows: spark_rows)
    let apply_shell = spark_serving_fleet_converge_apply_shell(timer_plan: timer_plan)
    let body = join(
      concat(
        [
          "# fleet-converge plan",
          concat("subject_host:", subject.host as String),
          concat(
            "subject_member_set:",
            std.content_hash.serialize_content_hash(hash: subject.member_set_fingerprint) as String,
          ),
          concat("plan_generation:", to_string(planned_generation)),
          concat("lease_key:", gunbc.fleet_converge_plan.fleet_converge_plan_lease_key(host: subject.host) as String),
          "observed_baseline:",
          baseline,
          "# timer-retirement",
        ],
        timer_lines,
        ["# cap-axis"],
        cap_lines,
        ["# spark-serving-linger"],
        spark_lines,
        [
          concat("# spark-serving-typed-actions:", spark_wire),
          concat("# spark-linger-writes=", to_string(gunbc.membership_reconcile.membership_write_count(plan: linger_plan))),
          concat("# cap-refusals=", to_string(gunbc.fleet_converge_plan.membership_refusal_count(plan: cap_plan))),
          concat("# timer-refusals=", to_string(gunbc.fleet_converge_plan.membership_refusal_count(plan: timer_plan))),
        ],
      ),
      "\n",
    )
    let owner_fp = std.content_hash.content_hash_of_value(value: body as std.types.NonEmptyStr)
    let lease = gunbc.fleet_converge_plan.fleet_converge_plan_held_lease(
      subject: subject,
      prior_generation: prior_generation,
      owner_fingerprint: owner_fp,
    )
    match std.content_hash.content_hash_of_value(value: baseline as std.types.NonEmptyStr) {
      std.content_hash.Fnv1a64(structural) =>
        Present {
          value: gunbc.fleet_converge_plan.FleetConvergePlanArtifact {
            subject: subject,
            prior_generation: prior_generation,
            plan_lease: lease,
            observed_baseline_hex: structural.digest,
            plan_body: body,
            apply_shell: apply_shell,
            spark_serving_typed_actions: spark_rows,
          },
        }
      _ => Absent
    }
}

fn spark_serving_linger_slice_noop_when_converged(linger_enabled: std.types.Bool) -> std.types.Bool {
  gunbc.spark_serving_membership.spark_serving_membership_noop(
    plan: spark_serving_linger_membership_plan(
      host: gunbc.fleet_intent_network.operator_host_srv5,
      linger_enabled: linger_enabled,
    ),
  )
}

fn spark_serving_frozen_linger_effect(row: gunbc.fleet_converge_plan.FleetConvergeSparkServingTypedAction) -> gunbc.spark_serving_realization.ServingInstallEffect? {
  if gunbc.spark_serving_member_realization.spark_serving_install_effects_include(
    effects: row.install_effects,
    needle: gunbc.spark_serving_realization.EnableLingerForOwnAccount,
  ) {
    Present { value: gunbc.spark_serving_realization.EnableLingerForOwnAccount }
  } else {
    none
  }
}

// THE FULL-POPULATION PLAN. `spark_serving_linger_membership_plan` above reconciles a single-element
// desired list, so three of the four modeled members were never planned and the install effects that
// act on them could never be selected. This reconciles the whole declared population against what was
// actually observed.
//
// It refuses rather than planning when the observation could not be made: a refused observation
// rendered as an empty observed population would plan every member as an addition against a host
// nobody saw.
fn spark_serving_full_membership_plan(
  occurrence: gunbc.spark_serving_release.SparkServingOccurrence,
  serving_release: gunbc.spark_serving_release.SparkServingRelease,
  projection: gunbc.spark_serving_observed_members.SparkServingObservedMemberProjection,
) -> SparkServingFullMembershipPlan {
  match projection {
    SparkServingObservedMembersRefused { cause: cause } =>
      SparkServingFullMembershipPlanRefused { cause: cause }
    SparkServingObservedMembers { members: observed, unit_observed: unit_observed } =>
      SparkServingFullMembershipPlanReady {
        plan: spark_serving_membership_reconcile(
          desired: spark_serving_desired_members(
            occurrence: occurrence,
            serving_release: serving_release,
          ),
          observed: observed,
        ),
        unit_observed: unit_observed,
      }
  }
}

type SparkServingFullMembershipPlan
  = SparkServingFullMembershipPlanReady { plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>, unit_observed: Bool }
  | SparkServingFullMembershipPlanRefused { cause: String }
