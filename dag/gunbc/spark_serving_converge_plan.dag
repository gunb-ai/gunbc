data spark_serving_converge_plan_authority_note: String = "Seam 2 vertical slice — Spark serving membership frozen into FleetConvergePlanArtifact typed rows. First member kind: Ensured linger (SparkServingLingerAddress → EnableLingerForOwnAccount). Plan observes linger state, runs membership_reconcile once, serializes MemberAction + install_effects into typed_action_rows on the artifact; apply MUST read those frozen rows (never re-derive). Spark actuation is typed argv via spark_serving_converge_realize + typed_argv_exec — NOT merged into apply_shell. Change arm (disable-linger) is NOT claimed proven — sudoers grants enable-linger only."

fn spark_serving_converge_host_is_spark(host: NonEmptyStr) -> Bool {
  host == (operator_host_srv5 as NonEmptyStr) || host == (operator_host_srv6 as NonEmptyStr)
}

fn spark_serving_desired_linger_member(host: HostIdentity) -> SparkServingMember {
  spark_serving_member(
    host: host,
    principal: spark_serving_serving_principal(),
    address: SparkServingLingerAddress,
    state_digest: spark_serving_executor_linger_state_digest(),
    ownership: Ensured,
  )
}

fn spark_serving_linger_observed_members(
  host: HostIdentity,
  linger_enabled: Bool,
) -> List<SparkServingMember> {
  if linger_enabled {
    [spark_serving_desired_linger_member(host: host)]
  } else {
    [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingLingerAddress,
        state_digest: spark_serving_executor_linger_disabled_state_digest(),
        ownership: Ensured,
      ),
    ]
  }
}

fn spark_serving_linger_membership_plan(
  host: HostIdentity,
  linger_enabled: Bool,
) -> MembershipPlan<SparkServingMember, SparkServingMemberAt> {
  spark_serving_membership_reconcile(
    desired: [spark_serving_desired_linger_member(host: host)],
    observed: spark_serving_linger_observed_members(host: host, linger_enabled: linger_enabled),
  )
}

// THE OPERATIONS ARE REALIZED AT PLAN TIME AND FROZEN INTO THE ROW. Apply then executes exactly what
// the plan admitted, rather than re-deriving bytes from whatever the authorities say when it runs.
// A row whose effects cannot realize yields no row at all, which the projection above turns into a
// typed refusal -- so an unrealizable member stops the plan instead of freezing an empty operation
// list that apply would happily execute as a no-op.
fn fleet_converge_spark_serving_typed_action(
  action: MemberAction<SparkServingMember, SparkServingMemberAt>,
) -> FleetConvergeSparkServingTypedAction? {
  match spark_serving_install_effects_for_member_action(action: action) {
    Absent => Absent
    Present { value: effects } =>
      match spark_serving_planned_effect_executions(effects: effects) {
        Absent => Absent
        Present { value: executions } =>
          match executions.first() {
            Absent => Absent
            Present { value: head } =>
              Present {
                value: FleetConvergeSparkServingTypedAction {
                  action: action,
                  first_execution: head,
                  further_executions: executions.skip(n: 1),
                },
              }
          }
      }
  }
}

// REALIZED PER EFFECT, SO THE ATTRIBUTION IS ESTABLISHED WHERE IT IS KNOWN.
//
// The whole-sequence realizer folds every effect into one flat list and the attribution is lost at
// exactly the moment it was available. Realizing one effect at a time keeps it: the operations an
// effect produced are the operations bound to it, by construction rather than by a later guess at
// list offsets.
//
// One effect refusing refuses the whole row, unchanged from the fold it replaces -- a partially
// realizable member must not produce a row that applies the half that worked.
fn spark_serving_planned_effect_executions(
  effects: List<ServingInstallEffect>,
) -> List<PlannedEffectExecution>? {
  fold(effects, init: Present { value: [] }, f: fn(acc, effect) {
    match acc {
      Absent => none
      Present { value: prior } =>
        match realize_spark_serving_install_effect_command(
          effect: effect,
          executor_login: spark_serving_automation_principal_login(),
        ) {
          SparkServingInstallRemoteCommandsRefused { reason: _ } => none
          SparkServingInstallRemoteCommandsPresent { operations: ops } =>
            match ops.first() {
              Absent => none
              Present { value: head } =>
                Present {
                  value: concat(prior, [
                    PlannedEffectExecution {
                      effect: effect,
                      first_operation: head,
                      further_operations: ops.skip(n: 1),
                    },
                  ]),
                }
            }
        }
    }
  })
}

// A PLANNED MEMBER THAT DOES NOT TRANSLATE REFUSES; IT IS NOT DROPPED.
//
// This projection used to be `flat_map` with `Absent => []`, which discarded any action carrying no
// install effects and produced a SHORTER row list with no diagnostic. The only action that reaches
// that arm is `MemberRemovalRefused` -- itself a refusal, so the drop erased a refusal by silently
// succeeding, and the artifact then reported a typed_row_count that did not cover its own plan.
//
// Its observed frequency was zero BY CONSTRUCTION: the only live plan is linger-only and linger
// always translates, so nothing ever exercised the arm. That is what made it worth closing before
// the plan widens rather than after -- a four-member plan is exactly the input that reaches it.
type SparkServingTypedActionProjection
  = SparkServingTypedActionsProjected { rows: List<FleetConvergeSparkServingTypedAction> }
  | SparkServingTypedActionsRefused { cause: String }

fn fleet_converge_spark_serving_typed_actions(
  plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
) -> SparkServingTypedActionProjection {
  let rows = flat_map(plan.actions, a =>
    match fleet_converge_spark_serving_typed_action(action: a) {
      Present { value: row } => [row]
      Absent => []
    }
  )
  if length(rows) == length(plan.actions) {
    SparkServingTypedActionsProjected { rows: rows }
  } else {
    SparkServingTypedActionsRefused {
      cause: join([
        "spark serving typed actions refused: ", to_string(length(plan.actions)),
        " planned member actions projected to only ", to_string(length(rows)),
        " typed rows, so a planned member would have been dropped from the frozen artifact",
      ], ""),
    }
  }
}

fn spark_serving_fleet_converge_apply_shell(
  timer_plan: MembershipPlan<TimerRetirementMember, TimerRetirementMemberAt>,
) -> String {
  fleet_converge_apply_shell(timer_plan: timer_plan)
}

// THE FULL-POPULATION CUTOVER. This function planned a single-element linger desired list, so three
// of the four modeled members were never planned at all and the effects acting on them could not be
// selected. It now reconciles the whole declared population against what was actually observed.
//
// The return type carries a CAUSE, which dissolves the residue the previous revision declared here:
// `FleetConvergePlanArtifact?` had no arm for one, so every distinct refusal -- a non-Spark host, a
// dropped member, an unadmitted release -- rendered as the same `plan-refused` word. Each now says
// which it was.
//
// It refuses on a PARTIAL observation rather than planning through one. An unobserved unit is absent
// from the observed list, and absence is what makes reconcile plan an addition -- so planning against
// it would write the unit on every run and no second plan could ever be empty. That is the
// empty-observation narrow, and the guard is the reason `unit_observed` travels beside the members.
type SparkServingPlanArtifactVerdict
  = SparkServingPlanArtifactReady { artifact: FleetConvergePlanArtifact }
  | SparkServingPlanArtifactRefused { cause: String }

fn spark_serving_fleet_converge_plan_artifact(
  host: NonEmptyStr,
  prior_generation: Int,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  projection: SparkServingObservedMemberProjection,
) -> SparkServingPlanArtifactVerdict {
  if !spark_serving_converge_host_is_spark(host: host) {
    SparkServingPlanArtifactRefused {
      cause: join(["plan-refused host-not-spark host=", host as String], ""),
    }
  } else {
    match spark_serving_desired_admission {
      SparkServingDesiredRefused { cause: why } =>
        SparkServingPlanArtifactRefused {
          cause: join(["plan-refused desired-release-unadmitted ", why as String], ""),
        }
      SparkServingDesiredAdmitted { serving_release: admitted_release } =>
        spark_serving_fleet_converge_plan_artifact_for_release(
          host: host,
          prior_generation: prior_generation,
          observed_timers: observed_timers,
          observed_caps: observed_caps,
          projection: projection,
          serving_release: admitted_release,
        )
    }
  }
}

fn spark_serving_fleet_converge_plan_artifact_for_release(
  host: NonEmptyStr,
  prior_generation: Int,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  projection: SparkServingObservedMemberProjection,
  serving_release: SparkServingRelease,
) -> SparkServingPlanArtifactVerdict {
  match spark_serving_full_membership_plan(
    occurrence: spark_serving_occurrence(
      host: host as HostIdentity,
      serving_release: serving_release,
    ),
    serving_release: serving_release,
    projection: projection,
  ) {
    SparkServingFullMembershipPlanRefused { cause: why } =>
      SparkServingPlanArtifactRefused {
        cause: join(["plan-refused observation ", why], ""),
      }
    SparkServingFullMembershipPlanReady { plan: full_plan, unit_observed: unit_observed, enablement_observed: enablement_observed, linger_observed: linger_observed, observed_members: observed_members } =>
      if !unit_observed {
        SparkServingPlanArtifactRefused {
          cause: join([
            "plan-refused unit-unobserved host=", host as String,
            ": the unit member was not observed, and planning it as an addition against an",
            " unobserved state would write it on every run while no replan could ever be empty",
          ], ""),
        }
      } else if !enablement_observed {
        SparkServingPlanArtifactRefused {
          cause: join([
            "plan-refused unit-enablement-unobserved host=", host as String,
            ": an unobserved enablement projects no member, so the desired one reads as absent and",
            " the plan would select EnableUserUnit off a probe that never answered",
          ], ""),
        }
      } else if !linger_observed {
        SparkServingPlanArtifactRefused {
          cause: join([
            "plan-refused linger-unobserved host=", host as String,
            ": an unobserved linger is indistinguishable from a disabled one on the member list,",
            " so planning against it would select the privileged enable-linger effect off a failed probe",
          ], ""),
        }
      } else {
        match fleet_converge_spark_serving_typed_actions(plan: full_plan) {
          SparkServingTypedActionsRefused { cause: why } =>
            SparkServingPlanArtifactRefused {
              cause: join(["plan-refused typed-actions ", why], ""),
            }
          SparkServingTypedActionsProjected { rows: spark_rows } =>
            match spark_serving_fleet_converge_plan_artifact_from_rows(
              host: host,
              prior_generation: prior_generation,
              observed_timers: observed_timers,
              observed_caps: observed_caps,
              spark_plan: full_plan,
              spark_rows: spark_rows,
              observed_spark: observed_members,
            ) {
              Absent =>
                SparkServingPlanArtifactRefused {
                  cause: "plan-refused baseline-hash: the observed baseline did not hash to a structural fnv1a64",
                }
              Present { value: artifact } =>
                SparkServingPlanArtifactReady { artifact: artifact }
            }
        }
      }
  }
}

fn spark_serving_fleet_converge_plan_artifact_from_rows(
  host: NonEmptyStr,
  prior_generation: Int,
  observed_timers: List<TimerRetirementMember>,
  observed_caps: List<CapMember>,
  spark_plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
  spark_rows: List<FleetConvergeSparkServingTypedAction>,
  observed_spark: List<SparkServingMember>,
) -> FleetConvergePlanArtifact? {
  let subject = fleet_converge_plan_subject(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
      observed_spark: observed_spark,
    )
    let timer_plan = timer_retirement_plan(observed: observed_timers)
    let cap_plan = caps_reconcile(desired: fleet_converge_desired_caps(), observed: observed_caps)
    let timer_lines = membership_plan_lines_timer(plan: timer_plan)
    let cap_lines = membership_plan_lines_cap(plan: cap_plan)
    let spark_lines = map(spark_rows, r => fleet_converge_spark_serving_action_line(row: r))
    let baseline = observed_baseline_text(
      host: host,
      observed_timers: observed_timers,
      observed_caps: observed_caps,
      observed_spark: observed_spark,
    )
    let planned_generation = prior_generation + 1
    let spark_wire = fleet_converge_spark_serving_typed_actions_wire(rows: spark_rows)
    let apply_shell = spark_serving_fleet_converge_apply_shell(timer_plan: timer_plan)
    let body = join(
      concat(
        [
          "# fleet-converge plan",
          concat("subject_host:", subject.host as String),
          concat(
            "subject_member_set:",
            serialize_content_hash(hash: subject.member_set_fingerprint) as String,
          ),
          concat("plan_generation:", to_string(planned_generation)),
          concat("lease_key:", fleet_converge_plan_lease_key(host: subject.host) as String),
          "observed_baseline:",
          baseline,
          "# timer-retirement",
        ],
        timer_lines,
        ["# cap-axis"],
        cap_lines,
        ["# spark-serving-linger"],
        spark_lines,
        [
          concat("# spark-serving-typed-actions:", spark_wire),
          concat("# spark-member-writes=", to_string(membership_write_count(plan: spark_plan))),
          concat("# cap-refusals=", to_string(membership_refusal_count(plan: cap_plan))),
          concat("# timer-refusals=", to_string(membership_refusal_count(plan: timer_plan))),
        ],
      ),
      "\n",
    )
    let owner_fp = content_hash_of_value(value: body as NonEmptyStr)
    let lease = fleet_converge_plan_held_lease(
      subject: subject,
      prior_generation: prior_generation,
      owner_fingerprint: owner_fp,
    )
    match content_hash_of_value(value: baseline as NonEmptyStr) {
      Fnv1a64(structural) =>
        Present {
          value: FleetConvergePlanArtifact {
            subject: subject,
            prior_generation: prior_generation,
            plan_lease: lease,
            observed_baseline_hex: structural.digest,
            plan_body: body,
            apply_shell: apply_shell,
            spark_serving_typed_actions: spark_rows,
          },
        }
      _ => Absent
    }
}

fn spark_serving_linger_slice_noop_when_converged(linger_enabled: Bool) -> Bool {
  spark_serving_membership_noop(
    plan: spark_serving_linger_membership_plan(
      host: operator_host_srv5,
      linger_enabled: linger_enabled,
    ),
  )
}

fn spark_serving_frozen_linger_effect(row: FleetConvergeSparkServingTypedAction) -> ServingInstallEffect? {
  if spark_serving_install_effects_include(
    effects: fleet_converge_spark_serving_row_effects(row: row),
    needle: EnableLingerForOwnAccount,
  ) {
    Present { value: EnableLingerForOwnAccount }
  } else {
    none
  }
}

// THE FULL-POPULATION PLAN. `spark_serving_linger_membership_plan` above reconciles a single-element
// desired list, so three of the four modeled members were never planned and the install effects that
// act on them could never be selected. This reconciles the whole declared population against what was
// actually observed.
//
// It refuses rather than planning when the observation could not be made: a refused observation
// rendered as an empty observed population would plan every member as an addition against a host
// nobody saw.
fn spark_serving_full_membership_plan(
  occurrence: SparkServingOccurrence,
  serving_release: SparkServingRelease,
  projection: SparkServingObservedMemberProjection,
) -> SparkServingFullMembershipPlan {
  match projection {
    SparkServingObservedMembersRefused { cause: cause } =>
      SparkServingFullMembershipPlanRefused { cause: cause }
    SparkServingObservedMembers { members: observed, unit_observed: unit_observed, enablement_observed: enablement_observed, linger_observed: linger_observed } =>
      SparkServingFullMembershipPlanReady {
        plan: spark_serving_membership_reconcile(
          desired: spark_serving_desired_members(
            occurrence: occurrence,
            serving_release: serving_release,
          ),
          observed: observed,
        ),
        unit_observed: unit_observed,
        enablement_observed: enablement_observed,
        linger_observed: linger_observed,
        observed_members: observed,
      }
  }
}

type SparkServingFullMembershipPlan
  = SparkServingFullMembershipPlanReady { plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>, unit_observed: Bool, enablement_observed: Bool, linger_observed: Bool, observed_members: List<SparkServingMember> }
  | SparkServingFullMembershipPlanRefused { cause: String }
