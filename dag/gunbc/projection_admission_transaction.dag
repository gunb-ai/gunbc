module gunbc.projection_admission_transaction

import std.types { String, Bool, Int, List }
import gunbc.generated_artifact {
  GeneratedArtifact,
  WitnessFloorYamlArtifact, FleetConvergeYamlArtifact, FleetDesiredAdmissionYamlArtifact,
  GitignoreArtifact, GitattributesArtifact, RoadmapArtifact, DesignArtifact,
  DesignFailureModesArtifact, DesignRungDropsArtifact,
  GithooksPrePushArtifact, GithooksPreCommitArtifact, GeneratedArtifactMergeDriverArtifact,
  RunnerDeployArtifact, CouponCadQueryProgramArtifact,
  Stage0CrateLayoutGeneratedDagArtifact, Stage0CrateLayoutGeneratedRsArtifact,
  Stage0CratePartitionGeneratedDagArtifact, Stage0ExecutableAssemblyGeneratedDagArtifact,
  V1InterpreterDispatchGeneratedRsArtifact,
  EvaluationBudgetConsequenceGeneratedRsArtifact, FileTransportRealizationGeneratedRsArtifact,
  AutoinstallUserDataArtifact, RunnerHostSudoersArtifact, PlanArtifact,
  committed_generated_artifacts, artifact_path,
}

// WHAT THIS MODULE OWNS: the ORDER in which a serialized generated projection is derived relative
// to the advance of main, and what a slot must exclude for that order to be establishable at all.
// gunbc.merge_admission owns the static question (is THIS receipt admissible against THIS target
// and roster) and gunbc.merge_lifecycle owns the temporal one for AUTHORITY (does a merge process
// ever advance main to a tree it never verified). Neither answers the projection question, because
// a projection is not an independent authority that could carry its own receipt: it is a FUNCTION
// of the composed authority, so the only well-formed subject is a candidate that already holds
// both. This module is that subject, and it derives its verdicts from the same lifecycle idiom
// rather than restating either authority's predicate (DESIGN section 2).
//
// THE RULING THIS MODEL CONSTRUCTS (operator, 2026-09-03): a serialized generated projection must
// be derived from the composed authority INSIDE the admission transaction, and no lane may be
// responsible for holding final projection bytes while it waits for admission. Post-merge
// regeneration is rejected -- not as a style preference but because it creates an interval in
// which main holds authority and projection from DIFFERENT STATES, which is exactly the state
// `trunk_tip_is_coherent` denies. `DeriveAfterMerge` is modeled here so that interval is
// EXECUTABLE and countable, not so it is available.
//
// WHY THE heal-generated-artifacts JOB IS NOT THIS AND MUST NOT BE EXTENDED INTO IT. That job
// checks out the MUTABLE pull-request branch and pushes repairs back to it; its own authority
// (gunbc.witness.witness_floor_workflow, the note above heal_generated_artifacts_timeout_minutes)
// classifies it as a REMEDIATOR, excludes it from the required aggregate, and records that its
// pushed head requires revalidation. A remediator can reduce author effort. It cannot establish
// admission ORDER, for three reasons this model makes separately visible: its subject is mutable
// (`PeerAdvanceTrunk` may move main under it), it is not the exact final integration candidate
// (its base is the branch's, not the tip's), and a peer landing the same projection invalidates it
// with no event it can observe. So the transaction is a MERGE-CONTRACT change; making heal smarter
// cannot reach it.
//
// A FOURTH REASON, OBSERVED 2026-09-03 AND NOT MODELED HERE: the remediator's push does not merely
// fail to establish order, it can SUSPEND the thing that would. gunbc#10157 sat two hours with the
// required aggregate in action_required awaiting manual approval, because the bot-authored push
// gated the run -- and that state reads identically to "no checks reported", so nobody was waiting
// on anything they could see. This module does not model forge approval states and should not grow
// to; the reason it is recorded here rather than in the failure-mode row is that the row is a
// PROJECTED ledger, and editing it to record a fact about projection churn would cost exactly the
// serialized regeneration this lane exists to remove.
//
// THE DISPLACED COST, MEASURED ON THIS PULL REQUEST RATHER THAN ARGUED (2026-09-03). Five lanes
// contended the failure-mode ledger and four the rung-drop ledger, one lane in both; every pair
// conflicted, and the order was decided by a manager reading merge-tree output by hand. This
// module's own change was one of the five and had to be resolved against a peer that landed first.
// The projections REFUSE under the generated-artifact merge driver, so they cannot be resolved
// wrongly -- but the AUTHORITIES they project from are `merge: unspecified`, so they collide
// textually instead, and every appender after the first pays a resolve. That asymmetry is a
// separate subject about the ledger authorities' grain and is deliberately not addressed here.
//
// THE CORRECTNESS ARGUMENT FOR ADMISSION-TIME DERIVATION IS STRONGER THAN THE COST ONE, and it is
// what this paragraph exists for. Resolving an append/append roster conflict by UNION is sound
// only if nothing was deliberately DELETED on the other side: a union silently re-adds a row
// someone removed on purpose, git reports a clean resolve either way, and the re-added row then
// looks like it was always there. Nothing in the merge output distinguishes the two cases, so the
// check has to be made against the merge base before resolving -- on this change, one row added
// and none removed. A resolve performed inside an admission transaction over the composed
// candidate has the merge base and both sides in hand at the moment it decides; a human resolving
// on a mutable branch has to remember to look. That is a silent-wrongness class (section 5), not
// an efficiency complaint, and it is the reason the transaction is worth more than the queue it
// replaces.

// RUNG (DESIGN section 4b): the class sits at MITIGATABLE today. Stale projections are writable
// and cycles are wasted, but the generated-artifact merge driver refuses a diverged projection and
// the read-only `generated-artifact` required phase refuses drift, so the harm is contained rather
// than silent. Ceiling is MECHANICALLY PREVENTABLE, not higher: an admission slot is a fact about
// a coordinator's behaviour over time, which no constructor in this repository can make
// unwritable. THE READ-ONLY DRIVER AND GATE ARE RETAINED, and deliberately so -- moving generation
// inside admission does not weaken them, it changes what they are evidence about: from a late
// detector of predictable invalidation into the VERIFIER of admission-produced bytes (step 6).
// Next-rung trigger is the CAPABILITY, not an artifact: an enforced admission slot that excludes
// another main advance for the transaction's critical window, plus a production producer that
// mints the candidate. Until that lands, the explicit hand queue is the honest interim mitigation
// and is what this model prices.

// WHY THIS MODULE IS NOT MERGED YET, AND WHAT WOULD CHANGE THAT. Held at operator ruling
// 2026-09-03 pending an OPERATIONAL CONSUMER. The state machine and `projection_member_eligibility`
// are evidence today, not production: no site in this repository currently asks "may this member
// be derived here". That was established by enumeration rather than by assumption, and the
// enumeration is recorded here because a search whose result is NOTHING is the finding most likely
// to be repeated. Four sites partition the generated-artifact population, on four different axes,
// and NONE of them asks this module's question:
//   gunbc.heal_push_plan                          CREDENTIAL -- may the resolved credential push
//                                                 this path. Says nothing about derivability.
//   v2.workflow.required_regen regen_scope_select AFFECTED SET -- did the change touch this member.
//                                                 Independent axis: a member can be affected and
//                                                 still be a bootstrap mirror, or unaffected and a
//                                                 plain ledger.
//   gunbc.stage0.stage0_rust_source_lifecycle_scaffold
//                                                 GENERATED VS HAND-MAINTAINED -- an identity join
//                                                 against registry membership, which
//                                                 `committed_generated_artifacts` already answers.
//   gunbc.generated_artifact_emit main_wet        NO FILTER AT ALL -- it folds the whole committed
//                                                 population and writes all members in one pass,
//                                                 both stage0 .rs mirrors included. Verified
//                                                 against a real regeneration run, not read off
//                                                 the source.
// Consulting this module from any of the four would be a CATEGORY ERROR rather than a wiring
// change: same population, different question.
//
// THE NEAR MISS, NAMED BECAUSE IT IS THE STRONGEST CANDIDATE AND IT STILL FAILS. The repository
// already knows the fact `projection_member_eligibility` encodes. The repair steps in
// gunbc.generated_artifact_merge_driver and gunbc.proactive_verification_ledger
// `spine_regen_recipe` both prescribe a SECOND build-and-verify pass, for precisely the stated
// reason that the regen route emits the seed by running a binary built FROM the seed, so one pass
// can self-verify for the wrong reason. That is this module's bootstrap-mirror carve-out, already
// load-bearing. It is still not a consumer on two independent grounds: it is a printed STRING an
// author or workflow follows rather than a function over `GeneratedArtifact`, so there is no call
// site to rewire; and it is GLOBAL rather than per-member, applying the second pass to the whole
// seed emission without ever asking which members need it. Turning it per-member would change that
// recipe's contract, which is BUILDING the seam this module plugs into rather than finding one --
// the inversion DESIGN section 6 refuses. So: the distinction is real and the corpus already pays
// for it, but it pays as a blanket second pass rather than as a decision.
//
// TRIGGER, capability-grained and owned by someone else's future work: WHEN THE MERGE DRIVER'S
// STEP-3 REASONING BECOMES A MODELED OPERATION RATHER THAN A PRINTED STRING, ELIGIBILITY HAS A
// HOME. Until then this module is cited as a model and its witnesses as evidence for the ORDER
// claim; it is NOT coverage for any admission behaviour, because nothing admits anything through
// it.

// TWO SPECIMENS WHERE EACH SIDE IS INDIVIDUALLY VALID AND ONLY THE COMPOSITION IS WRONG, one in
// each structural layout of the same carrier. They are recorded here because they are stronger
// than the cost argument above: cost is an efficiency claim and these are correctness claims.
//
// 2026-09-03, SHARED-CARRIER LAYOUT. main went red on a required lane because a merge took both
// sides of an append collision on the failure-mode carrier and produced duplicate declarations.
// The resolver refuses duplicates, so every tree carrying main lost the ability to regenerate ANY
// projection -- main_wet could not resolve the carrier at all. Every pre-merge instrument passed,
// because each hunk was individually legitimate; the defect existed only in the COMPOSITION and
// was visible only to the resolver, which runs after the merge. The heal job could not have caught
// it: it is a remediator that runs on a branch after composition exists, and on main it was
// SKIPPED entirely.
//
// 2026-09-04, SPLIT LAYOUT, and this one survives the repair. The carrier was split one row per
// file precisely to dissolve that collision. It dissolves the AUTHORING half and leaves this
// module's half untouched: registration is still hand-asserted in a roster, so two branches can
// each produce individually-valid trees whose composition is invalid -- the same identity sited in
// differently-named files, or a roster entry naming a row the other side deleted. A structural
// split also merges with RENAME-LIKE semantics, so a branch that edited the pre-split carrier can
// have its change applied cleanly to a path that is no longer the authority: present in the tree,
// absent from the corpus, with every registration check green because the missing row is exactly
// what defines the population those checks range over. THIS BRANCH WAS THAT CASE, and its row was
// re-sited rather than unioned.
//
// Neither specimen is an argument for a better remediator, and that is the point: in both, the
// composed candidate was the only subject on which the defect was decidable.

// ---------------------------------------------------------------------------
// Authority and its projection
// ---------------------------------------------------------------------------

// A projection identity is a FUNCTION of the authority it was derived from, and carrying it as
// its own opaque tag is what would make the two independently settable -- the very state this
// model exists to deny. So `derived_from` is the whole content: two projections are equal exactly
// when they were derived from the same authority, and coherence is decidable by construction.
type AuthorityId {
  tag: String
}

type ProjectionId {
  derived_from: String
}

fn derive_projection(authority: AuthorityId) -> ProjectionId {
  ProjectionId { derived_from: authority.tag }
}

type TrunkTip {
  authority: AuthorityId
  projection: ProjectionId
}

fn trunk_tip_is_coherent(tip: TrunkTip) -> Bool {
  tip.projection.derived_from == tip.authority.tag
}

fn coherent_tip(authority: AuthorityId) -> TrunkTip {
  TrunkTip { authority: authority, projection: derive_projection(authority: authority) }
}

type RosterId {
  tag: String
}

// ---------------------------------------------------------------------------
// Projection membership: which members the FIRST implementation may cover
// ---------------------------------------------------------------------------

// THE SUBJECT IS gunbc.generated_artifact GeneratedArtifact, NOT A RECORD OF ITS OWN, and the
// difference is a RUNG rather than a refinement. An earlier cut of this module carried a
// ProjectionMember record with a hand-declared generator_built_from_own_output flag; a caller can
// build any record, so a NEWLY ADDED ARTIFACT WAS SILENTLY ELIGIBLE, and the classifier could be
// satisfied by editing the declaration while the realization lied -- DESIGN section 5's own tell
// for validation standing where construction was available. GeneratedArtifact is a closed
// coproduct whose emit dispatch is already an exhaustive match, so keying on it means a new
// variant FAILS TO COMPILE until it is classified here: the invalid state has no constructor. It
// also stops this module carrying a second identity for an artifact the registry already owns
// (section 3).
//
// THE DISCRIMINANT IS A BOOTSTRAP LOOP, decided per artifact rather than per directory. A
// projection whose generator is BUILT FROM THAT PROJECTION cannot be derived from the composed
// authority without first consuming its own stale bytes to produce the generator, so it needs a
// staged or fixed-point admission arm this module does not model. Exactly two members are in that
// state: the emitted Rust under src/v1/stage0/src, which `gunbc` itself is compiled from. The
// stage0 `.dag` projections are NOT, and the distinction is the loop rather than the neighbourhood
// -- they are read by the interpreter at run time and nothing is built from them. A whole-document
// ledger such as docs/design-failure-modes.md has no loop at all, which is why the first
// implementation covers it.
//
// THE CONSTRUCTION CLAIM IS MEASURED RATHER THAN ASSERTED, because a rung claim about a wall
// nobody fired is the inflation DESIGN section 4b(1) names. Deleting a single arm from the match
// below and compiling this module refuses with `non-exhaustive match: missing variant(s)
// <the deleted one>`, one blocking error -- so the classifier cannot silently acquire a member,
// and the same refusal is what a newly registered artifact meets. The probe is the ordinary
// `gunbc compile --entry` over this module; it needs no fixture, because the discriminating RED is
// authorable in the module itself.
type ProjectionMemberEligibility
  = DerivableFromComposedAuthority
  | RequiresBootstrapFixedPointArm

fn projection_member_eligibility(artifact: GeneratedArtifact) -> ProjectionMemberEligibility {
  match artifact {
    Stage0CrateLayoutGeneratedRsArtifact => RequiresBootstrapFixedPointArm
    V1InterpreterDispatchGeneratedRsArtifact => RequiresBootstrapFixedPointArm
    EvaluationBudgetConsequenceGeneratedRsArtifact => RequiresBootstrapFixedPointArm
    FileTransportRealizationGeneratedRsArtifact => RequiresBootstrapFixedPointArm
    WitnessFloorYamlArtifact => DerivableFromComposedAuthority
    FleetConvergeYamlArtifact => DerivableFromComposedAuthority
    FleetDesiredAdmissionYamlArtifact => DerivableFromComposedAuthority
    GitignoreArtifact => DerivableFromComposedAuthority
    GitattributesArtifact => DerivableFromComposedAuthority
    RoadmapArtifact => DerivableFromComposedAuthority
    DesignArtifact => DerivableFromComposedAuthority
    DesignFailureModesArtifact => DerivableFromComposedAuthority
    DesignRungDropsArtifact => DerivableFromComposedAuthority
    GithooksPrePushArtifact => DerivableFromComposedAuthority
    GithooksPreCommitArtifact => DerivableFromComposedAuthority
    GeneratedArtifactMergeDriverArtifact => DerivableFromComposedAuthority
    RunnerDeployArtifact => DerivableFromComposedAuthority
    Stage0CrateLayoutGeneratedDagArtifact => DerivableFromComposedAuthority
    Stage0CratePartitionGeneratedDagArtifact => DerivableFromComposedAuthority
    Stage0ExecutableAssemblyGeneratedDagArtifact => DerivableFromComposedAuthority
    CouponCadQueryProgramArtifact => DerivableFromComposedAuthority
    AutoinstallUserDataArtifact { spec: _ } => DerivableFromComposedAuthority
    RunnerHostSudoersArtifact { host: _ } => DerivableFromComposedAuthority
    PlanArtifact { plan: _ } => DerivableFromComposedAuthority
  }
}

fn member_eligibility_is_derivable(artifact: GeneratedArtifact) -> Bool {
  match projection_member_eligibility(artifact: artifact) {
    DerivableFromComposedAuthority => true
    RequiresBootstrapFixedPointArm => false
  }
}

// The population is DERIVED from the committed registry, not declared beside it: whatever
// gunbc.generated_artifact admits as committed, minus the bootstrap loop.
fn first_implementation_members() -> List<GeneratedArtifact> {
  committed_generated_artifacts() |> filter(a => member_eligibility_is_derivable(artifact: a))
}

fn deferred_bootstrap_members() -> List<GeneratedArtifact> {
  committed_generated_artifacts() |> filter(a => !member_eligibility_is_derivable(artifact: a))
}

// NO SHARD CLASSIFIER LIVES HERE, AND ITS ABSENCE IS THE RULING RATHER THAN AN OMISSION
// (operator, 2026-09-03). A shard rule must be proved by a DERIVED dependency closure, and the
// classifier this module briefly carried took its closure as a hand-supplied list -- a presumption
// wearing a parameter, which is the same defect as the record above one level down and is exactly
// what the ruling forbade when it said path-disjointness must not be presumed. It is deleted
// rather than left staged: the starting policy is global serialization, which needs no classifier
// at all, and a rule keyed on v2.lens.module_graph would come back as construction. Until then,
// two candidates are never concurrent.

// ---------------------------------------------------------------------------
// The admission slot
// ---------------------------------------------------------------------------

// EXCLUSION IS THE WHOLE PROPERTY. Each arm below states what the mechanism can do to a CONCURRENT
// MAIN ADVANCE during the transaction's critical window -- a capability of the mechanism, not a
// verdict of this module. The consequence of the capability is derived by the transition system
// below, so no arm here is load-bearing on its own.
type AdmissionSlotMechanism
  = HumanMergeAnnouncement
  | DashboardFreezeRoster
  | AdvisoryLease
  | EnforcedMergeQueue
  | AdmissionCoordinator

fn slot_excludes_concurrent_advance(mechanism: AdmissionSlotMechanism) -> Bool {
  match mechanism {
    HumanMergeAnnouncement => false
    DashboardFreezeRoster => false
    AdvisoryLease => false
    EnforcedMergeQueue => true
    AdmissionCoordinator => true
  }
}

fn all_slot_mechanisms() -> List<AdmissionSlotMechanism> {
  [HumanMergeAnnouncement, DashboardFreezeRoster, AdvisoryLease, EnforcedMergeQueue, AdmissionCoordinator]
}

// ---------------------------------------------------------------------------
// The transaction
// ---------------------------------------------------------------------------

type LaneId {
  name: String
}

// A lane is the reviewed pull-request authority head H, plus the two things about it that decide
// whether the transaction can be completed at all. `composes_cleanly` is false for the whole-row
// .dag conflict measured on 2026-09-03: step 3 is NOT total, so a refusal arm there is required
// rather than optional. `foreign_machine_authored_path` carries the step-5 violation -- a
// machine-authored change outside the derived projection set.
//
// `inherited_projection` is H's COMMITTED projection bytes. Under the ruling they are never
// inherited into the candidate; the field exists so that the rejected order can be executed and
// its interval observed, which is the only way this module's central claim can go red.
type Lane {
  id: LaneId
  authority_delta: String
  inherited_projection: ProjectionId
  composes_cleanly: Bool
  foreign_machine_authored_path: String
  members: List<GeneratedArtifact>
}

type ProjectionDerivationOrder
  = DeriveInsideAdmission
  | DeriveAfterMerge

type CandidateStage
  = CandidateOpened
  | CandidateComposed
  | CandidateDerived
  | CandidateSealed
  | CandidateVerified

type OpenCandidate {
  lane: Lane
  stage: CandidateStage
  base_authority: AuthorityId
  base_roster: RosterId
  composed_authority: AuthorityId
  candidate_projection: ProjectionId
}

type AdmissionRefusal
  = SlotUnavailable { lane: String }
  | StageOutOfOrder { lane: String }
  | AuthorityCompositionConflict { lane: String }
  | MemberNotDerivableFromComposedAuthority { lane: String, path: String }
  | ForeignMachineAuthoredChange { lane: String, path: String }
  | CandidateProjectionMismatch { lane: String }
  | BaseMovedUnderCandidate { lane: String }
  | RosterChangedUnderCandidate { lane: String }
  | ConcurrentAdvanceExcluded { peer: String }

type TransactionState {
  tip: TrunkTip
  roster: RosterId
  slot: AdmissionSlotMechanism
  order: ProjectionDerivationOrder
  open: List<OpenCandidate>
  refusals: List<AdmissionRefusal>
  incoherent_tip_seen: Bool
  unverified_advance_seen: Bool
  discarded_candidate_count: Int
}

type AdmissionEvent
  = OpenTransaction { lane: Lane }
  | ComposeCandidate
  | DeriveProjections
  | SealCandidate
  | VerifyCandidate
  | AdvanceTrunk
  | PeerAdvanceTrunk { peer: String }
  | BumpRoster

fn compose_authority(base: AuthorityId, lane: Lane) -> AuthorityId {
  AuthorityId { tag: concat(concat(base.tag, "+"), lane.authority_delta) }
}

fn placeholder_authority() -> AuthorityId {
  AuthorityId { tag: "unconstructed-candidate-authority" }
}

fn placeholder_projection() -> ProjectionId {
  ProjectionId { derived_from: "unconstructed-candidate-projection" }
}

fn initial_transaction_state(
  slot: AdmissionSlotMechanism,
  order: ProjectionDerivationOrder,
) -> TransactionState {
  TransactionState {
    tip: coherent_tip(authority: AuthorityId { tag: "main-0" }),
    roster: RosterId { tag: "roster-0" },
    slot: slot,
    order: order,
    open: [],
    refusals: [],
    incoherent_tip_seen: false,
    unverified_advance_seen: false,
    discarded_candidate_count: 0,
  }
}

fn refuse(state: TransactionState, cause: AdmissionRefusal) -> TransactionState {
  TransactionState {
    tip: state.tip,
    roster: state.roster,
    slot: state.slot,
    order: state.order,
    open: state.open,
    refusals: concat(state.refusals, [cause]),
    incoherent_tip_seen: state.incoherent_tip_seen,
    unverified_advance_seen: state.unverified_advance_seen,
    discarded_candidate_count: state.discarded_candidate_count,
  }
}

// A refused candidate RELEASES the slot and is counted. The count is the cost the hand queue pays
// today: work composed, regenerated and verified against a base that moved before it could land.
fn discard_candidate(state: TransactionState, cause: AdmissionRefusal) -> TransactionState {
  TransactionState {
    tip: state.tip,
    roster: state.roster,
    slot: state.slot,
    order: state.order,
    open: [],
    refusals: concat(state.refusals, [cause]),
    incoherent_tip_seen: state.incoherent_tip_seen,
    unverified_advance_seen: state.unverified_advance_seen,
    discarded_candidate_count: state.discarded_candidate_count + 1,
  }
}

fn with_candidate(state: TransactionState, candidate: OpenCandidate) -> TransactionState {
  TransactionState {
    tip: state.tip,
    roster: state.roster,
    slot: state.slot,
    order: state.order,
    open: [candidate],
    refusals: state.refusals,
    incoherent_tip_seen: state.incoherent_tip_seen,
    unverified_advance_seen: state.unverified_advance_seen,
    discarded_candidate_count: state.discarded_candidate_count,
  }
}

// The one place the trunk moves. Coherence is CHECKED here rather than asserted by the caller, so
// every route that advances main -- admission, a peer, or the rejected post-merge order -- is
// measured by the same predicate and the latch cannot be bypassed by adding a route.
fn advance_trunk(state: TransactionState, tip: TrunkTip, verified: Bool, close_slot: Bool) -> TransactionState {
  TransactionState {
    tip: tip,
    roster: state.roster,
    slot: state.slot,
    order: state.order,
    open: if close_slot { [] } else { state.open },
    refusals: state.refusals,
    incoherent_tip_seen: state.incoherent_tip_seen || !trunk_tip_is_coherent(tip: tip),
    unverified_advance_seen: state.unverified_advance_seen || !verified,
    discarded_candidate_count: state.discarded_candidate_count,
  }
}

fn stage_is(candidate: OpenCandidate, stage: CandidateStage) -> Bool {
  match candidate.stage {
    CandidateOpened => match stage { CandidateOpened => true  CandidateComposed => false  CandidateDerived => false  CandidateSealed => false  CandidateVerified => false }
    CandidateComposed => match stage { CandidateOpened => false  CandidateComposed => true  CandidateDerived => false  CandidateSealed => false  CandidateVerified => false }
    CandidateDerived => match stage { CandidateOpened => false  CandidateComposed => false  CandidateDerived => true  CandidateSealed => false  CandidateVerified => false }
    CandidateSealed => match stage { CandidateOpened => false  CandidateComposed => false  CandidateDerived => false  CandidateSealed => true  CandidateVerified => false }
    CandidateVerified => match stage { CandidateOpened => false  CandidateComposed => false  CandidateDerived => false  CandidateSealed => false  CandidateVerified => true }
  }
}

fn restage(candidate: OpenCandidate, stage: CandidateStage, authority: AuthorityId, projection: ProjectionId) -> OpenCandidate {
  OpenCandidate {
    lane: candidate.lane,
    stage: stage,
    base_authority: candidate.base_authority,
    base_roster: candidate.base_roster,
    composed_authority: authority,
    candidate_projection: projection,
  }
}

// GLOBAL SERIALIZATION IS THE STARTING POLICY: a second open transaction is refused, not queued
// beside the first. Sharding relaxes this only through classify_shard_admission.
fn apply_open_transaction(state: TransactionState, lane: Lane) -> TransactionState {
  match (state.open |> first) {
    Present { value: _ } => refuse(state: state, cause: SlotUnavailable { lane: lane.id.name })
    Absent =>
      with_candidate(
        state: state,
        candidate: OpenCandidate {
          lane: lane,
          stage: CandidateOpened,
          base_authority: state.tip.authority,
          base_roster: state.roster,
          composed_authority: placeholder_authority(),
          candidate_projection: placeholder_projection(),
        }
      )
  }
}

// STEP 3 IS NOT TOTAL. A whole-row .dag conflict has been measured (2026-09-03), so the composition
// arm refuses and releases the slot rather than resolving the conflict on the lane's behalf.
fn apply_compose(state: TransactionState, candidate: OpenCandidate) -> TransactionState {
  if !stage_is(candidate: candidate, stage: CandidateOpened) {
    refuse(state: state, cause: StageOutOfOrder { lane: candidate.lane.id.name })
  } else if !candidate.lane.composes_cleanly {
    discard_candidate(state: state, cause: AuthorityCompositionConflict { lane: candidate.lane.id.name })
  } else {
    with_candidate(
      state: state,
      candidate: restage(
        candidate: candidate,
        stage: CandidateComposed,
        authority: compose_authority(base: candidate.base_authority, lane: candidate.lane),
        projection: placeholder_projection()
      )
    )
  }
}

// P IS DERIVED FROM I'S MERGED AUTHORITY, and the ruling is the OMISSION: the lane's inherited
// projection bytes are not read anywhere in this function. A lane carrying a member whose generator
// is built from its own output refuses here instead, rather than being silently generalized over.
fn apply_derive(state: TransactionState, candidate: OpenCandidate) -> TransactionState {
  if !stage_is(candidate: candidate, stage: CandidateComposed) {
    refuse(state: state, cause: StageOutOfOrder { lane: candidate.lane.id.name })
  } else {
    match (candidate.lane.members |> filter(a => !member_eligibility_is_derivable(artifact: a)) |> first) {
      Present { value: member } =>
        discard_candidate(
          state: state,
          cause: MemberNotDerivableFromComposedAuthority { lane: candidate.lane.id.name, path: artifact_path(a: member) }
        )
      Absent =>
        with_candidate(
          state: state,
          candidate: restage(
            candidate: candidate,
            stage: CandidateDerived,
            authority: candidate.composed_authority,
            projection: derive_projection(authority: candidate.composed_authority)
          )
        )
    }
  }
}

fn apply_seal(state: TransactionState, candidate: OpenCandidate) -> TransactionState {
  if !stage_is(candidate: candidate, stage: CandidateDerived) {
    refuse(state: state, cause: StageOutOfOrder { lane: candidate.lane.id.name })
  } else if !(candidate.lane.foreign_machine_authored_path == "") {
    discard_candidate(
      state: state,
      cause: ForeignMachineAuthoredChange {
        lane: candidate.lane.id.name,
        path: candidate.lane.foreign_machine_authored_path
      }
    )
  } else {
    with_candidate(state: state, candidate: restage(candidate: candidate, stage: CandidateSealed, authority: candidate.composed_authority, projection: candidate.candidate_projection))
  }
}

// STEP 6 IS THE RETAINED READ-ONLY CHECK, RELOCATED RATHER THAN DELETED. This is the same equality
// the generated-artifact drift gate and the merge driver answer; here it answers about
// admission-produced bytes instead of about bytes a lane was holding.
fn apply_verify(state: TransactionState, candidate: OpenCandidate) -> TransactionState {
  if !stage_is(candidate: candidate, stage: CandidateSealed) {
    refuse(state: state, cause: StageOutOfOrder { lane: candidate.lane.id.name })
  } else if !(candidate.candidate_projection.derived_from == candidate.composed_authority.tag) {
    discard_candidate(state: state, cause: CandidateProjectionMismatch { lane: candidate.lane.id.name })
  } else {
    with_candidate(state: state, candidate: restage(candidate: candidate, stage: CandidateVerified, authority: candidate.composed_authority, projection: candidate.candidate_projection))
  }
}

// THE REJECTED ORDER IS EXECUTED HERE SO ITS INTERVAL IS COUNTABLE, not so it is available.
// DeriveAfterMerge advances the trunk with the lane's INHERITED projection bytes and regenerates
// afterwards; between the two, main holds authority and projection from different states, and every
// reader in that window -- including another lane's compose step -- reads an incoherent tip.
fn apply_advance(state: TransactionState, candidate: OpenCandidate) -> TransactionState {
  match state.order {
    DeriveInsideAdmission => {
      if !stage_is(candidate: candidate, stage: CandidateVerified) {
        refuse(state: state, cause: StageOutOfOrder { lane: candidate.lane.id.name })
      } else if !(candidate.base_authority.tag == state.tip.authority.tag) {
        discard_candidate(state: state, cause: BaseMovedUnderCandidate { lane: candidate.lane.id.name })
      } else if !(candidate.base_roster.tag == state.roster.tag) {
        discard_candidate(state: state, cause: RosterChangedUnderCandidate { lane: candidate.lane.id.name })
      } else {
        advance_trunk(
          state: state,
          tip: TrunkTip { authority: candidate.composed_authority, projection: candidate.candidate_projection },
          verified: true,
          close_slot: true
        )
      }
    }
    DeriveAfterMerge => {
      if !stage_is(candidate: candidate, stage: CandidateComposed) {
        refuse(state: state, cause: StageOutOfOrder { lane: candidate.lane.id.name })
      } else {
        advance_trunk(
          state: state,
          tip: TrunkTip { authority: candidate.composed_authority, projection: candidate.lane.inherited_projection },
          verified: false,
          close_slot: true
        )
      }
    }
  }
}

fn apply_peer_advance(state: TransactionState, peer: String) -> TransactionState {
  match (state.open |> first) {
    Present { value: _ } => {
      if slot_excludes_concurrent_advance(mechanism: state.slot) {
        refuse(state: state, cause: ConcurrentAdvanceExcluded { peer: peer })
      } else {
        advance_trunk(
          state: state,
          tip: coherent_tip(authority: AuthorityId { tag: concat(concat(state.tip.authority.tag, "+"), peer) }),
          verified: true,
          close_slot: false
        )
      }
    }
    Absent =>
      advance_trunk(
        state: state,
        tip: coherent_tip(authority: AuthorityId { tag: concat(concat(state.tip.authority.tag, "+"), peer) }),
        verified: true,
        close_slot: false
      )
  }
}

fn apply_bump_roster(state: TransactionState) -> TransactionState {
  TransactionState {
    tip: state.tip,
    roster: RosterId { tag: concat(state.roster.tag, "'") },
    slot: state.slot,
    order: state.order,
    open: state.open,
    refusals: state.refusals,
    incoherent_tip_seen: state.incoherent_tip_seen,
    unverified_advance_seen: state.unverified_advance_seen,
    discarded_candidate_count: state.discarded_candidate_count,
  }
}

// A derive with NO open transaction is post-merge regeneration in the rejected order, and it
// repairs the tip. That repair is exactly why the LATCH and not the end state is the evidence: the
// interval closes, and having existed is the defect.
fn apply_to_open_candidate(state: TransactionState, ev: AdmissionEvent) -> TransactionState {
  match (state.open |> first) {
    Absent =>
      match ev {
        DeriveProjections =>
          advance_trunk(state: state, tip: coherent_tip(authority: state.tip.authority), verified: true, close_slot: false)
        OpenTransaction { lane: _ } => state
        ComposeCandidate => state
        SealCandidate => state
        VerifyCandidate => state
        AdvanceTrunk => state
        PeerAdvanceTrunk { peer: _ } => state
        BumpRoster => state
      }
    Present { value: candidate } =>
      match ev {
        ComposeCandidate => apply_compose(state: state, candidate: candidate)
        DeriveProjections => apply_derive(state: state, candidate: candidate)
        SealCandidate => apply_seal(state: state, candidate: candidate)
        VerifyCandidate => apply_verify(state: state, candidate: candidate)
        AdvanceTrunk => apply_advance(state: state, candidate: candidate)
        OpenTransaction { lane: _ } => state
        PeerAdvanceTrunk { peer: _ } => state
        BumpRoster => state
      }
  }
}

fn apply_admission_event(state: TransactionState, ev: AdmissionEvent) -> TransactionState {
  match ev {
    OpenTransaction { lane } => apply_open_transaction(state: state, lane: lane)
    PeerAdvanceTrunk { peer } => apply_peer_advance(state: state, peer: peer)
    BumpRoster => apply_bump_roster(state: state)
    ComposeCandidate => apply_to_open_candidate(state: state, ev: ev)
    DeriveProjections => apply_to_open_candidate(state: state, ev: ev)
    SealCandidate => apply_to_open_candidate(state: state, ev: ev)
    VerifyCandidate => apply_to_open_candidate(state: state, ev: ev)
    AdvanceTrunk => apply_to_open_candidate(state: state, ev: ev)
  }
}

fn simulate_transaction(
  slot: AdmissionSlotMechanism,
  order: ProjectionDerivationOrder,
  events: List<AdmissionEvent>,
) -> TransactionState {
  fold(events, init: initial_transaction_state(slot: slot, order: order), f: fn(state, ev) {
    apply_admission_event(state: state, ev: ev)
  })
}

fn transaction_admits_incoherent_tip(
  slot: AdmissionSlotMechanism,
  order: ProjectionDerivationOrder,
  events: List<AdmissionEvent>,
) -> Bool {
  simulate_transaction(slot: slot, order: order, events: events).incoherent_tip_seen
}

fn transaction_discarded_count(
  slot: AdmissionSlotMechanism,
  order: ProjectionDerivationOrder,
  events: List<AdmissionEvent>,
) -> Int {
  simulate_transaction(slot: slot, order: order, events: events).discarded_candidate_count
}

// ---------------------------------------------------------------------------
// Bounded-exhaustive enumeration over the transaction script
// ---------------------------------------------------------------------------

// THE WINDOW IS THE SCRIPT WITH INTERFERENCE INSERTED, NOT THE FREE MONOID OVER THE ALPHABET.
// The six steps are a staged protocol, so enumerating arbitrary orderings would spend the whole
// window on StageOutOfOrder noise and would answer a question nobody asks (does the protocol
// refuse a derive before a compose -- it does, and one witness states it). The interesting axis is
// WHERE ANOTHER PRINCIPAL ACTS while a transaction is open, so the enumeration inserts the
// interference events at EVERY position of the script, singly and in every ordered pair. That is
// exhaustive over the declared window "one transaction, at most one concurrent main advance and at
// most one roster bump", and every count below is asserted rather than sampled.

// THE SCRIPT IS THE ORDER'S OWN, and taking that from the order rather than from the caller is
// what makes the two windows comparable at all. Under DeriveInsideAdmission the six steps are the
// ruled transaction. Under DeriveAfterMerge the script IS the rejected shape -- compose, advance,
// then regenerate -- because running the ruled script under that order would only produce
// StageOutOfOrder refusals and would measure nothing about the order.
fn transaction_script(lane: Lane, order: ProjectionDerivationOrder) -> List<AdmissionEvent> {
  match order {
    DeriveInsideAdmission =>
      [
        OpenTransaction { lane: lane },
        ComposeCandidate,
        DeriveProjections,
        SealCandidate,
        VerifyCandidate,
        AdvanceTrunk,
      ]
    DeriveAfterMerge =>
      [
        OpenTransaction { lane: lane },
        ComposeCandidate,
        AdvanceTrunk,
        DeriveProjections,
      ]
  }
}

// The insertion point is recognised by the accumulator's OWN length, which passes through `index`
// exactly once: after the insertion the accumulator is index+2 long and can never match again, so
// a single event is inserted with no second-hit guard. Index == length(seq) appends.
fn insert_at(seq: List<AdmissionEvent>, index: Int, ev: AdmissionEvent) -> List<AdmissionEvent> {
  let placed = fold(seq, init: [], f: fn(acc, item) {
    if length(acc) == index { concat(acc, [ev, item]) } else { concat(acc, [item]) }
  })
  if index >= length(seq) { concat(seq, [ev]) } else { placed }
}

fn insertion_positions(seq: List<AdmissionEvent>) -> List<Int> {
  fold(seq, init: [0], f: fn(acc, item) { concat(acc, [length(acc)]) })
}

fn single_insertions(seq: List<AdmissionEvent>, ev: AdmissionEvent) -> List<List<AdmissionEvent>> {
  insertion_positions(seq: seq) |> map(index => insert_at(seq: seq, index: index, ev: ev))
}

// PEER ADVANCE AND ROSTER BUMP ARE SEPARATED, because only the first is what a slot can exclude.
// A roster bump under an open candidate is a CORRECT refusal in both slot kinds -- the criteria
// moved, so the receipt is stale -- and folding it into the slot window would have made an
// enforced slot look like it loses candidates it does not lose.
fn peer_interference_sequences(lane: Lane, order: ProjectionDerivationOrder, peer: String) -> List<List<AdmissionEvent>> {
  single_insertions(seq: transaction_script(lane: lane, order: order), ev: PeerAdvanceTrunk { peer: peer })
}

fn roster_interference_sequences(lane: Lane, order: ProjectionDerivationOrder) -> List<List<AdmissionEvent>> {
  single_insertions(seq: transaction_script(lane: lane, order: order), ev: BumpRoster)
}

fn interference_sequences(lane: Lane, order: ProjectionDerivationOrder, peer: String) -> List<List<AdmissionEvent>> {
  let with_peer = peer_interference_sequences(lane: lane, order: order, peer: peer)
  let with_bump = roster_interference_sequences(lane: lane, order: order)
  let with_both = fold(with_peer, init: [], f: fn(acc, seq) {
    concat(acc, single_insertions(seq: seq, ev: BumpRoster))
  })
  concat(concat(with_peer, with_bump), with_both)
}

fn count_incoherent_admitting_sequences(
  slot: AdmissionSlotMechanism,
  order: ProjectionDerivationOrder,
  seqs: List<List<AdmissionEvent>>,
) -> Int {
  fold(seqs, init: 0, f: fn(acc, seq) {
    if transaction_admits_incoherent_tip(slot: slot, order: order, events: seq) { acc + 1 } else { acc }
  })
}

fn count_discarding_sequences(
  slot: AdmissionSlotMechanism,
  order: ProjectionDerivationOrder,
  seqs: List<List<AdmissionEvent>>,
) -> Int {
  fold(seqs, init: 0, f: fn(acc, seq) {
    if transaction_discarded_count(slot: slot, order: order, events: seq) > 0 { acc + 1 } else { acc }
  })
}
