module gunbc.roadmap_publish

import std.types { String, NonEmptyStr, Int, Bool, List, CommitSha }
import extdeps.github.pulls {
  PullRequest,
  PullRequestState, Open,
}

data publish_producer_note: String = "THE PRODUCER THE PUBLICATION SEGMENT DID NOT HAVE. roadmap_attempt_workflow_stage_note declares seven obligations and says Verification, Publication, Review and Goal Audit 'remain desired obligations until independent producers ground them'. roadmap_verify.dag grounded the first. This grounds Publication, and only Publication.\\n\\nIT IS INSTANTIATION, NOT INVENTION. extdeps.github.pulls already models PullRequest and PullRequestRef against the cited upstream, and the mock corpus already keys the operations. What was missing was nothing at the extdeps layer and everything at the join: no function anywhere took an attempt's branch and returned the pull request it became.\\n\\nTHE BELT OBSERVES, IT DOES NOT PUBLISH (operator ruling, 2026-07-31). Nothing here pushes a branch or opens a pull request. Publication concludes on remote READ-BACK of an action the worker or agent performed, which keeps the belt a reconciler rather than making it an author — the same posture gunbc.membership_reconcile takes toward every other member it manages. Making the belt push would be a deliberate responsibility change with its own authorization story, not an implementation convenience."

data review_is_not_observed_here_note: String = "REVIEW IS PRODUCED BY THE ROADMAP, NOT OBSERVED FROM A FORGE (operator ruling, 2026-07-31), and this module deliberately stops at Publication because of it.\\n\\nAn earlier cut of this file classified pull-request review verdicts read from github.Pulls.ListReviews, on the assumption that the Review obligation meant the forge's review of the candidate. It does not. The roadmap's Review stage is a review the roadmap TRIGGERS — from its own UI, against the item's candidate — whose findings are routed back to the worker so it can iterate. That is a control loop the belt drives, not a remote fact the belt reads, and the two have opposite shapes: an observation concludes, a loop continues.\\n\\nThe measured fact that made the error visible rather than merely theoretical: every review in this repository is produced by a system that never writes to the forge, so github.Pulls.ListReviews returns an empty list for every pull request here. A classifier over that surface would have answered 'no review' forever and never once looked wrong — the observation would have been perfectly stable and perfectly meaningless.\\n\\nReview's producer therefore belongs with the trigger that runs it, and gunbc.tools.review and gunbc.tools.review_codex — two forked, unconsumed LLM review agents that differ only by provider — are its prior art, not this module."

data publication_arms_note: String = "ABSENT IS NOT A FAILURE, AND THERE IS NO REFUSAL ARM BECAUSE THE SUBSTRATE CANNOT BUILD ONE. PublicationAbsent means the pull request list was READ and this branch is not in it — the agent has not opened one yet, which is ordinary progress. It carries the number of open pull requests it saw, which is what makes it a real negative observation rather than a failed one: a caller can tell 'read 9, none matched' from 'read nothing'.\\n\\nAn earlier draft of this module declared PublicationRefused for the failure case — a missing token, a rate limit, a transport that did not deliver — and NEVER CONSTRUCTED EITHER (review 45531). That is specification without the behaviour it documents, and the reviewer was right to reject it. The arms are deleted rather than left standing, because a declared-but-unreachable refusal is exactly the shape that lets a reader believe a failure is handled when it is not.\\n\\nWHY IT COULD NOT BE BUILT, stated so the gap is countable rather than implied: v1_interpreter turns every non-2xx response AND every transport error into an untyped InterpError::TypeError, so the `401 => GitHubErrorShape` arms extdeps.github.pulls declares are dead at runtime. There is no value for a .dag caller to match on. A failed observation therefore RAISES rather than returning, and a caller that needs to distinguish it must do so at its own boundary.\\n\\nDISSOLVES ON the interpreter surfacing a declared error-response arm as a value; at that point the refusal arms return here and the observe functions below stop being able to raise.\\n\\nThe head sha rides on the observed arm because it is the whole point. A pull request number identifies a conversation; the head sha identifies the CANDIDATE, and every downstream judgment — review verdicts, audit, acceptance — is about a candidate."

data observation_is_split_from_classification_note: String = "THE CALL AND THE JUDGMENT ARE TWO FUNCTIONS, which is what makes the judgment testable at all. publication_from_pulls is pure and total over values a caller already holds; observe_publication is a thin impure wrapper that fetches and delegates. Before the split there was one function doing both, so nothing in the corpus could execute the classification without reaching GitHub — and the module landed with no witness at all (review 45531).\\n\\nThis is the same shape gunbc.roadmap_verify's witness already relies on: it claims the outcome-to-disposition mapping and the receipt projection, and never runs a process to do it."


type PublicationOutcome
  = PublicationObserved {
      branch: NonEmptyStr,
      pr_number: Int,
      head_sha: CommitSha,
      url: NonEmptyStr,
      draft: Bool,
    }
  | PublicationAbsent {
      branch: NonEmptyStr,
      open_pull_requests_seen: Int,
    }

fn pull_request_for_branch(pulls: List<PullRequest>, branch: NonEmptyStr) -> PullRequest? {
  first(filter(pulls, p => (p.head.ref as String) == (branch as String)))
}

fn publication_from_pulls(pulls: List<PullRequest>, branch: NonEmptyStr) -> PublicationOutcome {
  match pull_request_for_branch(pulls: pulls, branch: branch) {
    Absent =>
      PublicationAbsent {
        branch: branch,
        open_pull_requests_seen: count(pulls),
      }
    Present { value: pr } =>
      PublicationObserved {
        branch: branch,
        pr_number: pr.number,
        head_sha: pr.head.sha,
        url: pr.html_url,
        draft: pr.draft,
      }
  }
}

fn observe_publication(
  owner: String,
  repo: String,
  branch: NonEmptyStr,
) -> PublicationOutcome {
  let listed = github.Pulls.List(
    auth_token: "",
    owner: owner,
    repo: repo,
    state: Open,
  )
  publication_from_pulls(pulls: listed.pulls, branch: branch)
}

data publication_detail_note: String = "The segment detail is derived from the outcome rather than authored beside it, so a new arm cannot render as a stale sentence. These strings are what the row strip's reason surface shows an operator, and gunbc.roadmap_component's reason_surface_producers_note is the rule they obey: a located reason belongs on a surface the operator reads, never only in a title attribute."

fn publication_detail(outcome: PublicationOutcome) -> String {
  match outcome {
    PublicationObserved { branch: _, pr_number, head_sha, url: _, draft } =>
      join([
        if draft { "draft pull request #" } else { "pull request #" },
        to_string(pr_number),
        " at ",
        head_sha as String,
      ], "")
    PublicationAbsent { branch, open_pull_requests_seen } =>
      join([
        "no open pull request for ",
        branch as String,
        " (",
        to_string(open_pull_requests_seen),
        " open pull requests read)",
      ], "")
  }
}
