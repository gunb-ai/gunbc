module gunbc.roadmap_publish

import std.types { String, NonEmptyStr, Int, Bool, List, CommitSha }
import extdeps.github.pulls {
  PullRequest,
  PullRequestState, Open,
}

data publish_producer_note: String = "PUBLICATION IS ADJUDICATED AGAINST AN EXACT HEAD, NOT LOOKED UP BY BRANCH (operator ruling, 2026-07-31). An earlier cut of this module answered 'which pull request belongs to this branch', which is a lookup rather than a judgment: it reported whatever head that pull request happened to carry and left the caller to compare. Every downstream obligation — verify, review, audit, acceptance — is about one exact commit, so the question Publication has to answer is whether THIS commit is the one on offer.\\n\\nThe branch is a lookup and publication handle. A completed judgment belongs to a head sha.\\n\\nTHE ARM THAT MOTIVATES THE REWRITE is PublicationHeadDiverged. A pull request exists, its branch matches, and its head is NOT the commit under judgment — the ordinary state after a worker pushes a revision while a review is in flight. Under a branch lookup that reads as a successful publication, and every later receipt binds to a commit nobody assessed. It is the one outcome a lookup cannot express and the one most likely to occur."

data belt_observes_note: String = "THE BELT OBSERVES; THIS ADJUDICATES. Nothing here pushes a branch or opens a pull request, and nothing here calls a service. The adjudicator takes observations a caller already holds, so every arm is reachable from constructed values with no network and no token — which is what lets the judgment be witnessed at all.\\n\\nThe observations are COPRODUCTS rather than bare lists because a failed read must not be indistinguishable from an empty one. 'No pull requests exist' and 'I could not find out' have different remedies, and a caller handed an empty list for both would report the branch unpublished when the truth is that nothing was learned. That is the ignorance-as-answer conflation, arriving in the direction that looks like an ordinary negative result.\\n\\nThis also replaces the previous module's honest but awkward position that a refusal arm could not be built because the interpreter raises on transport failure. It could not be built THERE, in a function that called the service itself. Here the caller performs the read and reports what happened, so the refusal is an ordinary value and the arm is reachable."

type PullRequestObservation
  = PullRequestsRead { pulls: List<PullRequest> }
  | PullRequestsUnreadable { detail: String }

type RemoteBranchObservation
  = RemoteBranchesRead { branches: List<String> }
  | RemoteBranchesUnreadable { detail: String }

type PublicationOutcome
  = PublicationBound {
      branch: NonEmptyStr,
      pr_number: Int,
      pr_head: CommitSha,
      url: NonEmptyStr,
      draft: Bool,
    }
  | PublicationHeadDiverged {
      branch: NonEmptyStr,
      pr_number: Int,
      pr_head: CommitSha,
      candidate_head: CommitSha,
      url: NonEmptyStr,
    }
  | BranchPublishedWithoutPullRequest {
      branch: NonEmptyStr,
    }
  | BranchNotPublished {
      branch: NonEmptyStr,
      remote_branches_seen: Int,
    }
  | PublicationObservationRefused {
      detail: String,
    }

data draft_is_carried_not_judged_note: String = "Draft is REPORTED, never derived from. A draft pull request is a perfectly good publication surface for the roadmap's own review process — readiness for review is decided by the roadmap's Run Review action, not by the forge's draft flag — so this module carries the flag and refuses to conclude anything from it. Treating draft as not-yet-published would import a forge convention into a roadmap decision, and would make the roadmap's own trigger unable to review a candidate the operator deliberately kept out of the forge's review queue."

fn pull_request_for_branch(pulls: List<PullRequest>, branch: NonEmptyStr) -> PullRequest? {
  first(filter(pulls, p => (p.head.ref as String) == (branch as String)))
}

data remote_qualification_note: String = "Remote branch listings arrive qualified by their remote (origin/dispatch/x), so the comparison qualifies the branch rather than searching for a substring. A contains-style match would accept origin/dispatch/x-old for the branch dispatch/x, which is exactly the near-miss this arm exists to catch: a stale sibling branch reported as the candidate's publication."

fn remote_carries_branch(
  branches: List<String>,
  remote: NonEmptyStr,
  branch: NonEmptyStr,
) -> Bool {
  let qualified = join([remote as String, "/", branch as String], "")
  any(branches, b => trim(b) == qualified || trim(b) == (branch as String))
}

fn adjudicate_publication(
  pulls: PullRequestObservation,
  remotes: RemoteBranchObservation,
  remote: NonEmptyStr,
  branch: NonEmptyStr,
  candidate_head: CommitSha,
) -> PublicationOutcome {
  match pulls {
    PullRequestsUnreadable { detail } =>
      PublicationObservationRefused {
        detail: join(["the open pull requests could not be read: ", detail], ""),
      }
    PullRequestsRead { pulls: listed } =>
      match pull_request_for_branch(pulls: listed, branch: branch) {
        Present { value: pr } =>
          if (pr.head.sha as String) == (candidate_head as String) {
            PublicationBound {
              branch: branch,
              pr_number: pr.number,
              pr_head: pr.head.sha,
              url: pr.html_url,
              draft: pr.draft,
            }
          } else {
            PublicationHeadDiverged {
              branch: branch,
              pr_number: pr.number,
              pr_head: pr.head.sha,
              candidate_head: candidate_head,
              url: pr.html_url,
            }
          }
        Absent =>
          match remotes {
            RemoteBranchesUnreadable { detail } =>
              PublicationObservationRefused {
                detail: join([
                  "no pull request names this branch, and the remote branches could not be read, so whether the branch was pushed at all is unknown: ",
                  detail,
                ], ""),
              }
            RemoteBranchesRead { branches } =>
              if remote_carries_branch(branches: branches, remote: remote, branch: branch) {
                BranchPublishedWithoutPullRequest { branch: branch }
              } else {
                BranchNotPublished {
                  branch: branch,
                  remote_branches_seen: count(branches),
                }
              }
          }
      }
  }
}

data publication_detail_note: String = "The segment detail is derived from the outcome rather than authored beside it, so a new arm cannot render as a stale sentence. The diverged arm names BOTH heads, because the operator's next action depends on which is stale: a worker that pushed during review needs a re-review of the new head, while a pull request pointing at an older commit than the one verified needs a push."

fn publication_detail(outcome: PublicationOutcome) -> String {
  match outcome {
    PublicationBound { branch: _, pr_number, pr_head, url: _, draft } =>
      join([
        if draft { "draft pull request #" } else { "pull request #" },
        to_string(pr_number),
        " at ",
        pr_head as String,
      ], "")
    PublicationHeadDiverged { branch: _, pr_number, pr_head, candidate_head, url: _ } =>
      join([
        "pull request #",
        to_string(pr_number),
        " is at ",
        pr_head as String,
        " but the commit under judgment is ",
        candidate_head as String,
        " — the branch moved, so this pull request offers a different change",
      ], "")
    BranchPublishedWithoutPullRequest { branch } =>
      join([
        "the branch ",
        branch as String,
        " is on the remote but no open pull request names it",
      ], "")
    BranchNotPublished { branch, remote_branches_seen } =>
      join([
        "the branch ",
        branch as String,
        " is not on the remote (",
        to_string(remote_branches_seen),
        " remote branches read)",
      ], "")
    PublicationObservationRefused { detail } => detail
  }
}

data offers_the_candidate_note: String = "The single question a downstream obligation asks of Publication: is the commit I am about to judge the one actually on offer? Exactly one arm answers yes. Diverged answers NO despite a pull request existing, which is the whole point — and a refusal answers no rather than propagating ignorance as permission."

fn publication_offers_the_candidate(outcome: PublicationOutcome) -> Bool {
  match outcome {
    PublicationBound { branch: _, pr_number: _, pr_head: _, url: _, draft: _ } => true
    PublicationHeadDiverged {
      branch: _, pr_number: _, pr_head: _, candidate_head: _, url: _,
    } => false
    BranchPublishedWithoutPullRequest { branch: _ } => false
    BranchNotPublished { branch: _, remote_branches_seen: _ } => false
    PublicationObservationRefused { detail: _ } => false
  }
}
