module gunbc.publication_decision


data publication_decision_note: String = "Exceptional publication decisions bind to content identity, not pathnames. publication_decision_authorizes_newly_public is the single authority for whether a receipt authorizes a newly public subject: matching subject/content identity, candidate policy_version, sole publisher authority, and UniversalPublicationAudience."

type PublicationAuthorityId = std.types.NonEmptyStr where brand("PublicationAuthorityId")

type PublicationAudience
  = UniversalPublicationAudience
  | EnumeratedPublicationAudience { label: String }

type PublicationDecisionReceipt {
  subject_identity: std.content_hash.ContentHash
  content_identity: std.content_hash.ContentHash
  audience: PublicationAudience
  policy_version: std.types.NonEmptyStr
  authority: PublicationAuthorityId
}

fn publication_decision_binds_content(
  receipt: PublicationDecisionReceipt,
  subject_identity: std.content_hash.ContentHash,
  content_identity: std.content_hash.ContentHash,
) -> Bool {
  receipt.subject_identity == subject_identity && receipt.content_identity == content_identity
}

fn publication_decision_authorizes_newly_public(
  receipt: PublicationDecisionReceipt,
  subject: gunbc.public_projection.PublicProjectionSubject,
  policy_version: std.types.NonEmptyStr,
  authority: PublicationAuthorityId,
) -> Bool {
  publication_decision_binds_content(
    receipt: receipt,
    subject_identity: subject.subject_identity,
    content_identity: subject.content_identity,
  )
    && receipt.policy_version == policy_version
    && receipt.authority == authority
    && match receipt.audience {
      UniversalPublicationAudience => true
      EnumeratedPublicationAudience { label: _ } => false
    }
}

fn publication_decision_requires_refresh(
  receipt: PublicationDecisionReceipt,
  subject_identity: std.content_hash.ContentHash,
  content_identity: std.content_hash.ContentHash,
) -> Bool {
  receipt.subject_identity == subject_identity && receipt.content_identity != content_identity
}
