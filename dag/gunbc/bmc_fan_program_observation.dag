module gunbc.bmc_fan_program_observation

import std.types { Bool, Int, NonEmptyStr, String }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.languages.json.emit { JsonValue, serialize_json }
import extdeps.languages.json.parse { JsonDocumentParsed, parse_json_document }
import gunbc.bmc_fan_program_capture {
  CapturedFanProgram,
  srv3_captured_program,
  srv4_captured_program,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE FIRST HALF OF THE OBSERVER: THE CAPTURED ARTIFACT, READ AND PARSED, WITH NOTHING YET SAID
// ABOUT FANS.
//
// IT IS A JSON-VALUE OBSERVATION AND NOT A LOSSLESS SYNTAX ONE, AND AN EARLIER REVISION NAMED IT
// THE STRONGER THING. What survives is member order, duplicate member names, number lexemes and
// value structure. What does not survive is whitespace, the original spelling of string escapes,
// and therefore the exact source bytes. Calling that "syntax" claims a fidelity the carrier does
// not have, and the claim would have been inherited by everything built on top - so the type is
// named for what it holds. The exact-byte half is the capture's sha256, not this.
//
// AND parse-serialize-parse IDEMPOTENCE PROVES LESS THAN IT LOOKS. It establishes that the
// canonicalised value is a fixed point. It does NOT by itself establish that no source member was
// lost, because a decoder that dropped a member consistently would still be idempotent. That
// stronger property comes from the generic parser's construction and, above this layer, from the
// semantic conservation check over occurrence identities. It answers one question - can this repository turn its own committed bytes into a
// JsonValue without losing what the bytes mean - and stops there. Deciding that a member named
// "zones" is a fan controller is the semantic layer and lives above this.
//
// WHY THIS IS NOT A COMPILER CHANGE, WHICH IS WHERE THIS LANE NEARLY WENT WRONG. The plan of
// record was a new v1 artifact-admission bridge: a preflight that reads bytes, hashes them and
// injects them into the hermetic envelope. That was designed against a premise this module
// disproves by executing - that the hermetic frame refuses to read the checkout at all. It does
// not. `v1_interpreter` `hermetic_checkout_input_disposition_under` treats a readonly
// Filesystem.Read of a path proven under the checkout root as INPUT access, because the commit is
// the run's deterministic input. So the route already existed, and building a second admission
// path beside it would have been a parallel authority for a capability the substrate has - and,
// while the wider declined population stays declined, an escape hatch around an operator-owned
// cost decision.
//
// WHAT IS ACTUALLY BLOCKED, AND IT IS A PLANNER AND NOT AN ENVELOPE. The floor's `DeclinedLiveTree`
// arm vetoes any FILE declaring ReadsLiveTree before the interpreter is ever asked to classify the
// effect. `v2.workflow.required_floor` records that premise as stale and stages the arm for
// deletion at the root. This module therefore declares ReadsLiveTree honestly and is DECLINED by
// today's floor - discovered, counted, not run.
//
// SO THE EVIDENCE IS LABELLED AT TWO GRAINS AND THE SECOND ONE IS NOT COVERAGE:
//
//   HermeticDirectExecutionEstablished    executed against the committed artifacts through the
//                                         ordinary interpreter, reading the real bytes
//   RequiredFloorCadenceNotEstablished    NOT enrolled in any required run, because the planner
//                                         declines the file
//
// Citing this as floor coverage while the decline stands would be the decoration DESIGN calls
// worse than absent. Its required cadence arrives with the live-tree decline's deletion, in
// flight as gunbc#9106, and needs nothing from this module when it does.

type ArtifactJsonValueObservation
  = ArtifactJsonValueObserved {
      artifact_path: NonEmptyStr,
      byte_count: Int,
      document: JsonValue,
    }
  | ArtifactByteCountDisagrees {
      artifact_path: NonEmptyStr,
      expected: Int,
      observed: Int,
    }
  | ArtifactNotParseable { artifact_path: NonEmptyStr }

// THE BYTE COUNT IS CHECKED AGAINST THE CAPTURE BEFORE THE DOCUMENT IS BUILT, so a truncated or
// swapped artifact refuses instead of parsing cleanly into a smaller program. It is a weaker
// custody check than the sha256 the capture carries and it is the half expressible here: hashing
// needs a digest builtin this module does not reach, and a count that disagrees is already enough
// to refuse.
//
// success IS DELIBERATELY NOT CONSULTED. Under the hermetic filesystem_read path the returned
// record carries only `content`; the `success` and `error` channels the service declares are not
// populated, so branching on `read.success` takes the failure arm for a read that in fact
// succeeded. Measured, not assumed. The byte-count comparison below is therefore the read's
// success test as well as its integrity test, which is why a zero-length result cannot pass as an
// empty document.
// THE KERNEL IS PURE AND TAKES ITS CONTENT, so the not-parseable arm is reachable from an inline
// string. An earlier revision fused the read into this function, and the only control that could
// have exercised ArtifactNotParseable was a committed non-JSON file - which fails the byte-count
// comparison FIRST and returns before parsing ever happens. That arm was therefore unreachable
// from the witness while looking covered.
fn observe_artifact_content(
  artifact_path: NonEmptyStr,
  content: String,
  expected_byte_count: Int,
) -> ArtifactJsonValueObservation {
  let observed = content.length()
  if observed != expected_byte_count {
    ArtifactByteCountDisagrees {
      artifact_path: artifact_path,
      expected: expected_byte_count,
      observed: observed,
    }
  } else {
    match parse_json_document(s: content) {
      JsonDocumentParsed { value: document } =>
        ArtifactJsonValueObserved {
          artifact_path: artifact_path,
          byte_count: observed,
          document: document,
        }
      other => ArtifactNotParseable { artifact_path: artifact_path }
    }
  }
}

// SEMANTIC IDEMPOTENCE IS THE PROOF SHAPE, AND THE ALTERNATIVE IS UNSATISFIABLE RATHER THAN MERELY
// WEAKER. serialize(parse(bytes)) == bytes cannot hold for these artifacts: they are pretty-printed
// and the serializer emits compact form, so the round trip drops roughly half the file. A check
// written that way would be permanently red, and its only closing move would be to reformat the
// artifact - destroying the exact bytes the capture preserves and an adoption is addressed against.
//
// What IS provable, and what the observer needs, is that the document is a fixed point of
// parse-then-serialize: serializing it and reparsing yields the same serialization. That says the
// parse lost nothing the serializer would have re-expressed differently.
fn json_value_observation_is_idempotent(observation: ArtifactJsonValueObservation) -> Bool {
  match observation {
    ArtifactJsonValueObserved { artifact_path, byte_count, document } => {
      let once = serialize_json(v: document)
      match parse_json_document(s: once) {
        JsonDocumentParsed { value: reparsed } => serialize_json(v: reparsed) == once
        other => false
      }
    }
    other => false
  }
}

// THE PATH AND THE COUNT COME FROM THE CAPTURE, AND AN EARLIER REVISION RE-AUTHORED BOTH. It read
// artifact_path: "artifacts/bmc/srv3-config-asrr.json" and expected_byte_count: 5212 as literals
// beside a carrier that already holds exactly those two facts. Everything passed, and the passing
// meant nothing: "the observation matches the capture" was an agreement between two strings one
// author typed on one afternoon, not a join any machine performed. Editing the capture's path or
// count would have left the observer reading the old file against the old number, silently.
//
// Deriving both from CapturedFanProgram makes the mutation land: change the capture and the
// observation moves or refuses with it, because there is only one place the fact lives.
fn observe_captured_program(capture: CapturedFanProgram) -> ArtifactJsonValueObservation {
  let read = Filesystem.Read(path: capture.artifact_path as String)
  observe_artifact_content(
    artifact_path: capture.artifact_path,
    content: read.content,
    expected_byte_count: capture.artifact_byte_count,
  )
}

data srv3_program_json: ArtifactJsonValueObservation = observe_captured_program(capture: srv3_captured_program.program)

data srv4_program_json: ArtifactJsonValueObservation = observe_captured_program(capture: srv4_captured_program.program)
