module gunbc.durable_exclusive_hold_file_store

// THE HOLD PROTOCOL REALIZED OVER THE FILE-BACKED COMPARE-AND-SET.
//
// std.durable_exclusive_hold owns the transitions; gunbc.durable_cas_file_store
// owns the conditional write. This module is the join: it renders a hold state
// into the file store's NonEmptyStr payload, reads one back, and turns an
// eligible assessment into exactly one admitted CAS attempt. It is the ONE
// place the held|/free| spelling exists. Two consumers that each carried their
// own rendering would be two authorities for one wire, free to disagree, and a
// slot written by one and read by the other would decode as garbage -- or,
// worse, as free.
//
// THE TAGS ARE A MATERIALIZATION OF THE HOLD PROTOCOL INTO THIS STORE'S
// PAYLOAD, NOT FACTS ABOUT CAS. durable_cas_file_store is not edited by this
// module and knows nothing of holders; it is consumed through its public mint
// and write, the same way any other CAS consumer reaches it.
//
// THE BYTES ARE THE ONES gunbc.fabric.fabric_control_plane WROTE BEFORE THIS MODULE
// EXISTED -- "held|" followed by the owner, "free|" followed by the release
// reference -- because slots already on disk under /var/lib/gunbc/fabric were
// written in that spelling and must decode unchanged. A compatibility witness
// pins the specimens byte-for-byte.

import std.types { NonEmptyStr, String }
import std.decl_ref { decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { retires_dissolution }
import std.durable_compare_and_set {
  CasExpectation, ExpectSlotGeneration, CasCommitted, CasPreconditionFailed, CasStoreRefused,
  CasStoreFailure, CasSlotObservationRefused,
  CasSlotObservation, CasObservedReadable, CasObservedUnreadable,
  CasReadableAbsent, CasReadablePresent, CasGeneration,
  ExpectSlotAbsent, CasGenerationSuccessor, CasSuccessorGeneration, cas_generation_successor, cas_generation_first,
}
import std.durable_exclusive_hold {
  DurableHoldOwnerRef, DurableHoldReleaseRef,
  DurableHoldState, DurableHoldHeld, DurableHoldFree,
  DurableHoldObservation, HoldSlotAbsent, HoldSlotFree, HoldSlotHeld,
  HoldSlotUndecodable, HoldObservationUnavailable,
  DurableHoldAcquireRefusal, HoldAcquireEligible, HoldAcquireRefused,
  HoldAcquireOccupied, HoldAcquireSlotUndecodable, HoldAcquireObservationUnavailable,
  HoldReleaseEligible, HoldReleaseRefused, DurableHoldReleaseAssessment, DurableHoldReleaseRefusal,
  durable_hold_acquire_assess, durable_hold_release_assess,
  DurableHoldHolderReport, DurableHoldRecoveryRefusal, DurableHoldRecoveryAssessment, HoldRecoveryEligible, HoldRecoveryRefused,
  DurableHoldHolderLiveness, HolderObservedLive, HolderObservedDead, HolderLivenessUnobservable,
  HoldRecoveryNothingHeld, HoldRecoveryHolderLive, HoldRecoveryHolderUnobservable,
  HoldRecoverySlotUndecodable, HoldRecoveryObservationUnavailable,
  durable_hold_recovery_assess,
  DurableHoldNonHolderRelease, DurableHoldNonHolderReleaseRefusal, DurableHoldNonHolderReleaseBasis,
  NonHolderReleaseEligible, NonHolderReleaseRefused, durable_hold_nonholder_release_assess, DurableHoldRef,
}
import gunbc.durable_cas_file_store { KeepAllGenerations, KeepGenerationWindow, CasSlotRetention,
  CasGenerationWindow, DefaultAccessCreateOnly, DerivedPayloadAdmitted, DerivedPayloadKeyNotSlotAddressable,
  admit_cas_attempt_for_derived_payload, file_compare_and_set, file_compare_and_set_retained,
  observe_cas_slot_state, observe_cas_slot_state_retained,
  cas_verify_named_window_head, CasNamedWindowVerify, NamedWindowHeadCurrent, NamedWindowHeadMoved,
}

// THE TAGS ARE NAMED ONCE AND THE BODY IS DERIVED FROM THE TAG THAT MATCHED.
//
// An earlier cut of this codec (in the fabric module) spelled each tag twice
// and sliced the body at the length of the HELD tag for both arms, which
// worked only because the two tags happen to be the same length. A third tag
// of any other length would have decoded to a body cut at the wrong offset,
// silently, with the round trip still green for the two that existed. So the
// body is always sliced at the length of the tag that matched.
data hold_held_tag: String = "held|"

data hold_free_tag: String = "free|"

fn hold_slot_body(text: String, tag: String) -> String {
  substring(s: text, start: string_length(s: tag), end: string_length(s: text))
}

fn hold_slot_payload(state: DurableHoldState) -> NonEmptyStr {
  match state {
    DurableHoldHeld { owner: o } => concat(hold_held_tag, o as String) as NonEmptyStr
    DurableHoldFree { released_by: b } => concat(hold_free_tag, b as String) as NonEmptyStr
  }
}

// A DECODE THAT REFUSES RATHER THAN GUESSES. An unrecognised payload is not a
// free slot and not a held one: it is a slot this module cannot interpret, and
// it gets its own arm so a caller stops rather than proceeds on a guess.
//
// The parse is the render read backwards over the same two tags, not a second
// grammar. It splits once on the tag so an owner containing the separator
// survives the round trip -- a fabric reservation reference is itself a demand
// and an offer joined by that character.
type HoldPayloadDecode
  = HoldPayloadDecoded { state: DurableHoldState }
  | HoldPayloadUndecodable { detail: NonEmptyStr }

fn decode_hold_slot_payload(payload: NonEmptyStr) -> HoldPayloadDecode {
  let text = payload as String
  if starts_with(s: text, prefix: hold_held_tag) {
    hold_decode_held_body(text: text, body: hold_slot_body(text: text, tag: hold_held_tag))
  } else {
    if starts_with(s: text, prefix: hold_free_tag) {
      hold_decode_free_body(text: text, body: hold_slot_body(text: text, tag: hold_free_tag))
    } else {
      HoldPayloadUndecodable {
        detail: concat("slot payload carries no recognised state tag: ", text) as NonEmptyStr,
      }
    }
  }
}

// A TAG WITH NOTHING AFTER IT IS UNDECODABLE, NOT A HOLDER OR A RELEASE WITH AN
// EMPTY NAME. The branded values are NonEmptyStr and the cast from a String does
// not enforce that at this position (the refinement is deferred), so the body is
// checked for emptiness BEFORE either branded value is constructed. The free arm
// is the dangerous one: a bare "free|" read as a free slot would be
// acquisition-eligible, and a corrupted or truncated slot would be taken over.
fn hold_decode_held_body(text: String, body: String) -> HoldPayloadDecode {
  if body == "" {
    HoldPayloadUndecodable { detail: concat("slot payload carries the held tag with no owner: ", text) as NonEmptyStr }
  } else {
    HoldPayloadDecoded { state: DurableHoldHeld { owner: body as DurableHoldOwnerRef } }
  }
}

fn hold_decode_free_body(text: String, body: String) -> HoldPayloadDecode {
  if body == "" {
    HoldPayloadUndecodable { detail: concat("slot payload carries the free tag with no release reference: ", text) as NonEmptyStr }
  } else {
    HoldPayloadDecoded { state: DurableHoldFree { released_by: body as DurableHoldReleaseRef } }
  }
}

// From what the CAS store observed to what the hold protocol decides over. Pure,
// so a witness can supply the store's observation and exercise every arm of the
// protocol without a filesystem; the live form below is this over a real read.
fn hold_observation_of_cas(observed: CasSlotObservation<NonEmptyStr>) -> DurableHoldObservation {
  match observed {
    CasObservedUnreadable { cause: c } => HoldObservationUnavailable { cause: c }
    CasObservedReadable { readable: CasReadableAbsent } => HoldSlotAbsent
    CasObservedReadable { readable: CasReadablePresent { version: v } } =>
      match decode_hold_slot_payload(payload: v.value) {
        HoldPayloadUndecodable { detail: d } => HoldSlotUndecodable { generation: v.generation, detail: d }
        HoldPayloadDecoded { state: DurableHoldHeld { owner: o } } => HoldSlotHeld { generation: v.generation, owner: o }
        HoldPayloadDecoded { state: DurableHoldFree { released_by: b } } => HoldSlotFree { generation: v.generation, released_by: b }
      }
  }
}

// RETENTION IS THE SLOT'S DECLARATION, passed by its consumer (gunbc.durable_cas_file_store
// CasSlotRetention): a hold whose history is an audit trail keeps every generation; a hold taken and
// released on every commit of a bounded store keeps a window, or its own bookkeeping would grow
// without bound. Read, plan and commit carry the same declaration.
fn observe_file_hold_retained(root: NonEmptyStr, key: NonEmptyStr, retention: CasSlotRetention) -> DurableHoldObservation
  admit_callers: [
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "observe_file_hold"),
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_acquire_prepare_retained"),
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_release_assess_retained"),
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_recovery_assess_retained"),
  ]
{
  hold_observation_of_cas(observed: observe_cas_slot_state_retained(root: root, key: key, retention: retention))
}

fn observe_file_hold(root: NonEmptyStr, key: NonEmptyStr) -> DurableHoldObservation {
  observe_file_hold_retained(root: root, key: key, retention: KeepAllGenerations)
}

// Named-window head movement is a file/window realization outcome, not a
// protocol refusal. Keep-all consumers of DurableHoldReleaseAssessment never
// see it; only windowed named verify mints these arms.
type WindowedHoldReleaseFromVerify
  = WindowedHoldReleaseProtocol { assessment: DurableHoldReleaseAssessment }
  | WindowedHoldReleaseNamedHeadMoved { named: CasGeneration }

type WindowedHoldRecoveryFromVerify
  = WindowedHoldRecoveryProtocol { assessment: DurableHoldRecoveryAssessment }
  | WindowedHoldRecoveryNamedHeadMoved { named: CasGeneration }

fn windowed_hold_release_from_verify(
  verify: CasNamedWindowVerify,
  owner: DurableHoldOwnerRef,
  acquired_generation: CasGeneration,
) -> WindowedHoldReleaseFromVerify
  admit_callers: [
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_release_assess_windowed_at"),
    decl_ref(module_path: "test.claim.durable_exclusive_hold_witness", decl_name: "named_window_head_moved_release_does_not_claim_an_observed_current_generation"),
  ]
{
  match verify {
    NamedWindowHeadMoved { named_generation: n } =>
      WindowedHoldReleaseNamedHeadMoved { named: n }
    NamedWindowHeadCurrent { observation: o } =>
      WindowedHoldReleaseProtocol {
        assessment: durable_hold_release_assess(observed: hold_observation_of_cas(observed: o), owner: owner, acquired_generation: acquired_generation),
      }
  }
}

fn windowed_hold_recovery_from_verify(
  verify: CasNamedWindowVerify,
  report: DurableHoldHolderReport,
) -> WindowedHoldRecoveryFromVerify
  admit_callers: [
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_recovery_assess_windowed"),
    decl_ref(module_path: "test.claim.durable_exclusive_hold_witness", decl_name: "named_window_head_moved_recovery_does_not_claim_an_observed_current_generation"),
  ]
{
  match verify {
    NamedWindowHeadMoved { named_generation: n } =>
      WindowedHoldRecoveryNamedHeadMoved { named: n }
    NamedWindowHeadCurrent { observation: o } =>
      WindowedHoldRecoveryProtocol {
        assessment: durable_hold_recovery_assess(observed: hold_observation_of_cas(observed: o), report: report),
      }
  }
}

// EVERY EFFECTFUL HOLD WRITE IS LIVE READ -> SEALED PLAN -> CAS COMMIT, AND NO
// WRITER ACCEPTS AN OBSERVATION FROM ITS CALLER.
//
// An earlier cut of this module exposed the write half over a caller-supplied
// CasSlotObservation, so that a witness could hand two contenders one
// observation. That reopened the exact path the first amendment closed, one
// layer down: a caller holding a synthetic "free at N" for a slot that is really
// HELD at N would have derived ExpectSlotGeneration(N) and overwritten the live
// hold (side-chat review on gunbc#11661). So the plan is minted ONLY by a
// function that performs the read itself, the plan is sole_constructor and
// carries the root and key it was read from, and the commit takes nothing but
// the plan. On the source-to-.dag acceptance path there is therefore no route by
// which a caller-authored observation reaches a write: the forgeries have no
// constructor here, rather than being refused. The emitted-Rust path is not
// claimed, for the reason durable_cas_file_store states on VerifiedCasAttempt.
//
// The split is still a split -- prepare, then commit -- because a consumer may
// have work between the two (the fabric settles money), and because a race is
// exercised honestly as ONE live read minting ONE plan that two contenders then
// commit: the store admits exactly one.
type FileHoldAcquirePlan sole_constructor {
  root: NonEmptyStr
  slot_key: NonEmptyStr
  owner: DurableHoldOwnerRef
  expected: CasExpectation
  held_payload: NonEmptyStr
  retention: CasSlotRetention
}

type FileHoldAcquirePreparation
  = FileHoldAcquirePlanned { plan: FileHoldAcquirePlan }
  | FileHoldAcquireNotEligible { slot_key: NonEmptyStr, refusal: DurableHoldAcquireRefusal }

// The live read and the protocol's judgement of it. Only an absent or a free
// slot yields a plan; the expectation on the plan is derived from what was read.
fn file_hold_acquire_prepare_retained(
  root: NonEmptyStr,
  slot_key: NonEmptyStr,
  requested_owner: DurableHoldOwnerRef,
  retention: CasSlotRetention,
) -> FileHoldAcquirePreparation
  admit_callers: [
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_acquire_prepare"),
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_acquire_retained"),
  ]
{
  match durable_hold_acquire_assess(observed: observe_file_hold_retained(root: root, key: slot_key, retention: retention)) {
    HoldAcquireRefused { refusal: r } => FileHoldAcquireNotEligible { slot_key: slot_key, refusal: r }
    HoldAcquireEligible { expected: e } =>
      FileHoldAcquirePlanned {
        plan: FileHoldAcquirePlan {
          root: root,
          slot_key: slot_key,
          owner: requested_owner,
          expected: e,
          held_payload: hold_slot_payload(state: DurableHoldHeld { owner: requested_owner }),
          retention: retention,
        },
      }
  }
}

fn file_hold_acquire_prepare(root: NonEmptyStr, slot_key: NonEmptyStr, requested_owner: DurableHoldOwnerRef) -> FileHoldAcquirePreparation {
  file_hold_acquire_prepare_retained(root: root, slot_key: slot_key, requested_owner: requested_owner, retention: KeepAllGenerations)
}

// THE GENERATION THIS PLAN'S COMMIT LANDS ON, read off the expectation the live read derived.
// A commit either lands exactly here or does not land (the store refuses any other generation), so
// a consumer that must write a fact keyed by the landing generation INTO the same payload can name
// it before the write rather than after it. That is what makes the write one transition instead of
// a hold followed by a second record a crash could separate from it.
fn file_hold_acquire_plan_landing(plan: FileHoldAcquirePlan) -> CasGenerationSuccessor {
  match plan.expected {
    ExpectSlotAbsent => CasSuccessorGeneration { generation: cas_generation_first() }
    ExpectSlotGeneration { generation: g } => cas_generation_successor(g: g)
  }
}

// THE SAME PLAN UNDER ANOTHER OWNER. The expectation is kept -- it is still the one the live read
// derived, so occupancy is judged exactly as before and no caller-supplied generation enters -- and
// the payload is re-derived from the new owner by this module's own codec. Confined to the one
// consumer whose owner depends on the landing generation.
fn file_hold_acquire_plan_for_owner(plan: FileHoldAcquirePlan, owner: DurableHoldOwnerRef) -> FileHoldAcquirePlan
  admit_callers: [decl_ref(module_path: "gunbc.fabric.fabric_cell_grant", decl_name: "grant_selected_cell_under_exclusion")]
{
  FileHoldAcquirePlan {
    root: plan.root,
    slot_key: plan.slot_key,
    owner: owner,
    expected: plan.expected,
    held_payload: hold_slot_payload(state: DurableHoldHeld { owner: owner }),
    retention: plan.retention,
  }
}

// EVERY WAY AN ACQUIRE ENDS, TYPED AND SEPARATE, because the remedies differ.
// Occupied is the protocol's answer and retrying will not change it until the
// holder releases; Lost is a race after this caller's own read and the remedy
// is to re-observe; StoreUnavailable says nothing about the slot; an
// undecodable slot needs an operator; an unaddressable key is the caller's
// defect. Collapsing store refusal into a lost race is the class rostered as
// store_refusal_reported_as_contention, and it is kept apart here by
// construction of the outcome, not by a comment.
type FileHoldAcquireOutcome
  = FileHoldAcquired { slot_key: NonEmptyStr, owner: DurableHoldOwnerRef, generation: CasGeneration }
  | FileHoldOccupied { slot_key: NonEmptyStr, holder: DurableHoldOwnerRef, generation: CasGeneration }
  | FileHoldAcquireLost { slot_key: NonEmptyStr }
  | FileHoldAcquireStoreUnavailable { slot_key: NonEmptyStr, cause: CasStoreFailure }
  | FileHoldSlotUndecodable { slot_key: NonEmptyStr, generation: CasGeneration, detail: NonEmptyStr }
  | FileHoldKeyNotSlotAddressable { slot_key: NonEmptyStr }

// admit_cas_attempt_for_derived_payload rather than admit_cas_attempt: the
// payload on the plan was derived from the state by this module, so there is no
// caller digest that could legitimately disagree, and the only refusal that
// remains reachable is a key that does not address a slot.
fn file_hold_acquire_commit(plan: FileHoldAcquirePlan) -> FileHoldAcquireOutcome {
  match admit_cas_attempt_for_derived_payload(key: plan.slot_key, expected: plan.expected, proposed: plan.held_payload) {
    DerivedPayloadKeyNotSlotAddressable { key: _ } => FileHoldKeyNotSlotAddressable { slot_key: plan.slot_key }
    DerivedPayloadAdmitted { verified: v } =>
      match file_compare_and_set_retained(root: plan.root, publication: DefaultAccessCreateOnly, retention: plan.retention, verified: v).outcome {
        CasCommitted { committed: c } =>
          FileHoldAcquired { slot_key: plan.slot_key, owner: plan.owner, generation: c.generation }
        CasPreconditionFailed { expected: _, observed: _ } => FileHoldAcquireLost { slot_key: plan.slot_key }
        CasStoreRefused { cause: c } => FileHoldAcquireStoreUnavailable { slot_key: plan.slot_key, cause: c }
      }
  }
}

// THE PRODUCTION ACQUIRE: prepare, then commit, in one call. It takes no
// CasExpectation and no observation: it reads the slot, admits only absent or
// free, derives the expectation from that read, and writes. A caller cannot
// present a generation, so it cannot overwrite a hold whose generation it
// happens to know.
fn file_hold_acquire_retained(
  root: NonEmptyStr,
  slot_key: NonEmptyStr,
  requested_owner: DurableHoldOwnerRef,
  retention: CasSlotRetention,
) -> FileHoldAcquireOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_acquire"),
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_acquire_windowed"),
  ]
{
  match file_hold_acquire_prepare_retained(root: root, slot_key: slot_key, requested_owner: requested_owner, retention: retention) {
    FileHoldAcquirePlanned { plan: p } => file_hold_acquire_commit(plan: p)
    FileHoldAcquireNotEligible { slot_key: _, refusal: r } =>
      match r {
        HoldAcquireOccupied { generation: g, holder: h } =>
          FileHoldOccupied { slot_key: slot_key, holder: h, generation: g }
        HoldAcquireSlotUndecodable { generation: g, detail: d } =>
          FileHoldSlotUndecodable { slot_key: slot_key, generation: g, detail: d }
        HoldAcquireObservationUnavailable { cause: c } =>
          FileHoldAcquireStoreUnavailable { slot_key: slot_key, cause: CasSlotObservationRefused { cause: c } }
      }
  }
}

fn file_hold_acquire(root: NonEmptyStr, slot_key: NonEmptyStr, requested_owner: DurableHoldOwnerRef) -> FileHoldAcquireOutcome {
  file_hold_acquire_retained(root: root, slot_key: slot_key, requested_owner: requested_owner, retention: KeepAllGenerations)
}

fn file_hold_acquire_windowed(root: NonEmptyStr, slot_key: NonEmptyStr, requested_owner: DurableHoldOwnerRef, window: CasGenerationWindow) -> FileHoldAcquireOutcome
  admit_callers: [
    decl_ref(module_path: "extdeps.realization.materialization_store_local", decl_name: "local_store_acquire_settled"),
    decl_ref(module_path: "test.claim.materialization_store_local_wet_witness", decl_name: "a_hold_left_by_a_dead_writer_is_recovered_by_observation_by_real_execution"),
  ]
{
  file_hold_acquire_retained(root: root, slot_key: slot_key, requested_owner: requested_owner, retention: KeepGenerationWindow { window: window })
}

// RELEASE IS ASSESS-THEN-COMMIT, NOT ONE INDIVISIBLE FREE, because a consumer
// has settlement to do between the two: the fabric releases or settles money
// and frees the cell only if the ledger advanced. So the assessment produces a
// PLAN and the commit consumes it. The plan is minted here and nowhere else --
// sole_constructor -- so a caller cannot author "release generation 7 for
// owner A" from its own bookkeeping; every field is copied from the live read
// the assessment itself performs.
type FileHoldReleasePlan sole_constructor {
  root: NonEmptyStr
  slot_key: NonEmptyStr
  owner: DurableHoldOwnerRef
  generation: CasGeneration
  free_payload: NonEmptyStr
  retention: CasSlotRetention
}

type FileHoldReleaseAssessment
  = FileHoldReleasePlanned { plan: FileHoldReleasePlan }
  | FileHoldReleaseNotEligible { slot_key: NonEmptyStr, refusal: DurableHoldReleaseRefusal }

type FileHoldWindowedReleaseAssessment
  = FileHoldWindowedReleasePlanned { plan: FileHoldReleasePlan }
  | FileHoldWindowedReleaseNotEligible { slot_key: NonEmptyStr, refusal: DurableHoldReleaseRefusal }
  | FileHoldWindowedReleaseNamedHeadMoved { slot_key: NonEmptyStr, named: CasGeneration }

// THE ONLY MINT OF A RELEASE PLAN READS THE SLOT ITSELF. There is deliberately
// no variant over a supplied observation: a synthetic "held by A at N" handed to
// such a mint would produce a plan that frees a real hold of B's at N, and the
// plan being sole_constructor would then protect nothing. Every field on the
// plan is copied from this live read.
fn file_hold_release_assess_retained(
  root: NonEmptyStr,
  slot_key: NonEmptyStr,
  owner: DurableHoldOwnerRef,
  acquired_generation: CasGeneration,
  released_by: DurableHoldReleaseRef,
  retention: CasSlotRetention,
) -> FileHoldReleaseAssessment
  admit_callers: [
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_release_assess"),
  ]
{
  match durable_hold_release_assess(
    observed: observe_file_hold_retained(root: root, key: slot_key, retention: retention),
    owner: owner,
    acquired_generation: acquired_generation,
  ) {
    HoldReleaseRefused { refusal: r } => FileHoldReleaseNotEligible { slot_key: slot_key, refusal: r }
    HoldReleaseEligible { generation: g } =>
      FileHoldReleasePlanned {
        plan: FileHoldReleasePlan {
          root: root,
          slot_key: slot_key,
          owner: owner,
          generation: g,
          free_payload: hold_slot_payload(state: DurableHoldFree { released_by: released_by }),
          retention: retention,
        },
      }
  }
}

fn file_hold_release_assess(root: NonEmptyStr, slot_key: NonEmptyStr, owner: DurableHoldOwnerRef, acquired_generation: CasGeneration, released_by: DurableHoldReleaseRef) -> FileHoldReleaseAssessment {
  file_hold_release_assess_retained(root: root, slot_key: slot_key, owner: owner, acquired_generation: acquired_generation, released_by: released_by, retention: KeepAllGenerations)
}

fn file_hold_release_assess_windowed_at(root: NonEmptyStr, slot_key: NonEmptyStr, owner: DurableHoldOwnerRef, acquired_generation: CasGeneration, released_by: DurableHoldReleaseRef, window: CasGenerationWindow) -> FileHoldWindowedReleaseAssessment
  admit_callers: [
    decl_ref(module_path: "extdeps.realization.materialization_store_local", decl_name: "local_store_release_family_hold"),
  ]
{
  match windowed_hold_release_from_verify(
    verify: cas_verify_named_window_head(root: root, key: slot_key, generation: acquired_generation),
    owner: owner,
    acquired_generation: acquired_generation,
  ) {
    WindowedHoldReleaseNamedHeadMoved { named: n } =>
      FileHoldWindowedReleaseNamedHeadMoved { slot_key: slot_key, named: n }
    WindowedHoldReleaseProtocol { assessment: a } =>
      match a {
        HoldReleaseRefused { refusal: r } => FileHoldWindowedReleaseNotEligible { slot_key: slot_key, refusal: r }
        HoldReleaseEligible { generation: g } =>
          FileHoldWindowedReleasePlanned {
            plan: FileHoldReleasePlan {
              root: root,
              slot_key: slot_key,
              owner: owner,
              generation: g,
              free_payload: hold_slot_payload(state: DurableHoldFree { released_by: released_by }),
              retention: KeepGenerationWindow { window: window },
            },
          }
      }
  }
}

// The commit still tells a lost race from an unavailable store. A release
// assessed at generation N and committed after the slot moved is
// FileHoldReleaseLost -- the hold this plan described no longer exists -- and
// a caller that has already settled against the plan needs to know that its
// settlement and the slot have come apart, which a store fault would not tell it.
type FileHoldReleaseOutcome
  = FileHoldReleased { slot_key: NonEmptyStr, generation: CasGeneration }
  | FileHoldReleaseLost { slot_key: NonEmptyStr }
  | FileHoldReleaseStoreUnavailable { slot_key: NonEmptyStr, cause: CasStoreFailure }
  | FileHoldReleaseKeyNotSlotAddressable { slot_key: NonEmptyStr }

fn file_hold_release_commit(plan: FileHoldReleasePlan) -> FileHoldReleaseOutcome {
  match admit_cas_attempt_for_derived_payload(
    key: plan.slot_key,
    expected: ExpectSlotGeneration { generation: plan.generation },
    proposed: plan.free_payload,
  ) {
    DerivedPayloadKeyNotSlotAddressable { key: _ } => FileHoldReleaseKeyNotSlotAddressable { slot_key: plan.slot_key }
    DerivedPayloadAdmitted { verified: v } =>
      match file_compare_and_set_retained(root: plan.root, publication: DefaultAccessCreateOnly, retention: plan.retention, verified: v).outcome {
        CasCommitted { committed: c } => FileHoldReleased { slot_key: plan.slot_key, generation: c.generation }
        CasPreconditionFailed { expected: _, observed: _ } => FileHoldReleaseLost { slot_key: plan.slot_key }
        CasStoreRefused { cause: c } => FileHoldReleaseStoreUnavailable { slot_key: plan.slot_key, cause: c }
      }
  }
}

// RECOVERING A DEAD HOLDER'S HOLD FREES IT THROUGH THE SAME PLAN AND COMMIT AS A RELEASE: the write
// is identical -- held at N becomes free at N+1 -- and only the eligibility differs (the holder was
// observed dead rather than presenting itself). So the plan is minted here from THIS live read, bound
// to the report's holder and generation, and committed by file_hold_release_commit, which still tells
// a slot that moved after this read (Lost) from a store fault. The released_by carries the dead holder
// and the evidence, so the freed slot says why it was freed.
//
// The report is a verdict about the world that only the observing consumer can take, so this mint
// admits its callers by name: a caller that could hand it an authored HolderObservedDead would be the
// forged-release path the release plan's sole_constructor exists to close.
type FileHoldRecoveryAssessment
  = FileHoldRecoveryPlanned { plan: FileHoldReleasePlan, dead_holder: DurableHoldOwnerRef, evidence: NonEmptyStr }
  | FileHoldRecoveryNotEligible { slot_key: NonEmptyStr, refusal: DurableHoldRecoveryRefusal }

type FileHoldWindowedRecoveryAssessment
  = FileHoldWindowedRecoveryPlanned { plan: FileHoldReleasePlan, dead_holder: DurableHoldOwnerRef, evidence: NonEmptyStr }
  | FileHoldWindowedRecoveryNotEligible { slot_key: NonEmptyStr, refusal: DurableHoldRecoveryRefusal }
  | FileHoldWindowedRecoveryNamedHeadMoved { slot_key: NonEmptyStr, named: CasGeneration }

fn file_hold_recovery_assess_retained(
  root: NonEmptyStr,
  slot_key: NonEmptyStr,
  report: DurableHoldHolderReport,
  released_by: DurableHoldReleaseRef,
  retention: CasSlotRetention,
) -> FileHoldRecoveryAssessment
  admit_callers: [
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_recovery_assess"),
  ]
{
  match durable_hold_recovery_assess(observed: observe_file_hold_retained(root: root, key: slot_key, retention: retention), report: report) {
    HoldRecoveryRefused { refusal: r } => FileHoldRecoveryNotEligible { slot_key: slot_key, refusal: r }
    HoldRecoveryEligible { generation: g, dead_holder: h, evidence: e } =>
      FileHoldRecoveryPlanned {
        plan: FileHoldReleasePlan {
          root: root,
          slot_key: slot_key,
          owner: h,
          generation: g,
          free_payload: hold_slot_payload(state: DurableHoldFree { released_by: released_by }),
          retention: retention,
        },
        dead_holder: h,
        evidence: e,
      }
  }
}

fn file_hold_recovery_assess(root: NonEmptyStr, slot_key: NonEmptyStr, report: DurableHoldHolderReport, released_by: DurableHoldReleaseRef) -> FileHoldRecoveryAssessment
  admit_callers: [
    decl_ref(module_path: "gunbc.host.managed_host_unit_hold", decl_name: "unit_hold_recover_dead_holder"),
    decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_recover_dead_holder"),
  ]
{
  file_hold_recovery_assess_retained(root: root, slot_key: slot_key, report: report, released_by: released_by, retention: KeepAllGenerations)
}

// THE ONE DEAD-HOLDER RECOVERY, written once for every root. A consumer that found its slot
// occupied owes three things and no more: observe WHO holds it, prove THAT holder dead, and take
// the slot with a release naming who did the proving. Only the first differs between roots -- a
// managed host unit names a systemd unit, the fleet printer controller names an authorization plus
// a process -- so it arrives as a function and the other two steps stay HERE, where the report
// mint, the eligibility check and the CAS commit each already have their own admission. This is
// the arm the two earlier consumers each hand-carried and a third root skipped: a root that never
// admitted the recovery ends in a slot nothing can release.
//
// Refusing typed is the point. A holder observed LIVE is refused as live and an unobservable one as
// unobservable, because the thing that makes recovery sound -- a death someone actually saw -- is
// exactly what neither of those two arms has. A caller cannot pass a dead-looking verdict in as
// data: report lives in std.durable_exclusive_hold's closed set, and DurableHoldHolderReport has
// no declaration outside the mint.
// Each arm says why the slot is STILL held, in one of the store's own words, so a consumer maps its
// typed refusal without re-telling the story: a live holder means wait, an unobservable one means go
// look, a lost commit means the slot moved under us and a retry must re-observe from scratch.
type FileHoldDeadHolderRecovery
  = FileHoldDeadHolderRecovered { dead_holder: DurableHoldOwnerRef, evidence: NonEmptyStr }
  | FileHoldDeadHolderHolderLive { holder: DurableHoldOwnerRef, evidence: NonEmptyStr }
  | FileHoldDeadHolderHolderUnobservable { holder: DurableHoldOwnerRef, cause: NonEmptyStr }
  | FileHoldDeadHolderNotEligible { refusal: DurableHoldRecoveryRefusal }
  | FileHoldDeadHolderReleaseLost
  | FileHoldDeadHolderReleaseStoreUnavailable { cause: NonEmptyStr }
  | FileHoldDeadHolderReleaseKeyNotAddressable

fn file_hold_recover_dead_holder(
  root: NonEmptyStr,
  slot_key: NonEmptyStr,
  holder: DurableHoldOwnerRef,
  generation: CasGeneration,
  released_by: DurableHoldReleaseRef,
  live_owner: fn(DurableHoldOwnerRef) -> DurableHoldHolderLiveness,
) -> FileHoldDeadHolderRecovery
  admit_callers: [
    decl_ref(module_path: "gunbc.host.managed_host_unit_hold", decl_name: "unit_hold_recover_dead_holder"),
    decl_ref(module_path: "gunbc.fleet.printer_execution_hold", decl_name: "with_execution_hold"),
  ]
{
  match live_owner(h: holder) {
    HolderObservedDead { evidence: e } =>
      match file_hold_recovery_assess(root: root, slot_key: slot_key, report: DurableHoldHolderReport { holder: holder, generation: generation, liveness: HolderObservedDead { evidence: e } }, released_by: released_by) {
        FileHoldRecoveryPlanned { plan: p, dead_holder: d, evidence: ev } =>
          match file_hold_release_commit(plan: p) {
            FileHoldReleased { slot_key: _, generation: _ } => FileHoldDeadHolderRecovered { dead_holder: d, evidence: ev }
            FileHoldReleaseLost { slot_key: _ } => FileHoldDeadHolderReleaseLost
            FileHoldReleaseStoreUnavailable { slot_key: _, cause: c } => FileHoldDeadHolderReleaseStoreUnavailable { cause: c }
            FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } => FileHoldDeadHolderReleaseKeyNotAddressable
          }
        FileHoldRecoveryNotEligible { slot_key: _, refusal: r } => FileHoldDeadHolderNotEligible { refusal: r }
      }
    HolderObservedLive { evidence: e } => FileHoldDeadHolderHolderLive { holder: holder, evidence: e }
    HolderLivenessUnobservable { cause: c } => FileHoldDeadHolderHolderUnobservable { holder: holder, cause: c }
  }
}

fn file_hold_recovery_assess_windowed(root: NonEmptyStr, slot_key: NonEmptyStr, report: DurableHoldHolderReport, released_by: DurableHoldReleaseRef, window: CasGenerationWindow) -> FileHoldWindowedRecoveryAssessment
  admit_callers: [
    decl_ref(module_path: "extdeps.realization.materialization_store_local", decl_name: "local_store_hold_occupied"),
  ]
{
  match windowed_hold_recovery_from_verify(
    verify: cas_verify_named_window_head(root: root, key: slot_key, generation: report.generation),
    report: report,
  ) {
    WindowedHoldRecoveryNamedHeadMoved { named: n } =>
      FileHoldWindowedRecoveryNamedHeadMoved { slot_key: slot_key, named: n }
    WindowedHoldRecoveryProtocol { assessment: a } =>
      match a {
        HoldRecoveryRefused { refusal: r } => FileHoldWindowedRecoveryNotEligible { slot_key: slot_key, refusal: r }
        HoldRecoveryEligible { generation: g, dead_holder: h, evidence: e } =>
          FileHoldWindowedRecoveryPlanned {
            plan: FileHoldReleasePlan {
              root: root,
              slot_key: slot_key,
              owner: h,
              generation: g,
              free_payload: hold_slot_payload(state: DurableHoldFree { released_by: released_by }),
              retention: KeepGenerationWindow { window: window },
            },
            dead_holder: h,
            evidence: e,
          }
      }
  }
}

// A NON-HOLDER RELEASE FREES THROUGH THE SAME PLAN AND COMMIT AS A RELEASE AND A RECOVERY. The write is
// identical -- held at N becomes free at N+1, compare-and-set on the generation THIS live read observed --
// and only the eligibility differs: the protected section was observed complete, or an operator
// authorized it. So the plan is minted here from this module's own read, bound to the subject the
// evidence or the grant names, and committed by file_hold_release_commit, which still tells a slot that
// moved after this read (Lost) from a store fault. The released_by is the consumer's, as on recovery.
//
// The evidence is a verdict about the world that only the observing consumer can take, so this mint
// admits its callers by name, as recovery's does: a caller free to hand it an authored
// SectionObservedComplete would be the forged-release path the plan's sole_constructor exists to close.
// Keep-all only: no windowed consumer exists, and the consumer this is for is a lease whose generations
// are its audit trail.
// A FILE HOLD'S IDENTITY IS ITS STORE AND ITS SLOT, joined the way this store joins them on disk. The key
// is slot-addressable only without a "/" (gunbc.durable_cas_file_store cas_key_is_slot_addressable), so
// the join splits uniquely at its last separator and two distinct (root, key) pairs never mint one ref.
// It is the only mint of a DurableHoldRef for a file hold, used both by a caller naming the hold it
// wants released and by the assessment naming the slot it read, so the two agree exactly when they
// name the same store and slot. Spelling the same store two ways (a trailing separator, a relative
// root) mints two refs and refuses as another hold: fail-closed, never a cross-slot release.
fn file_hold_ref(root: NonEmptyStr, slot_key: NonEmptyStr) -> DurableHoldRef {
  concat(concat(root as String, "/"), slot_key as String) as DurableHoldRef
}

type FileHoldNonHolderReleaseAssessment<Observation>
  = FileHoldNonHolderReleasePlanned { plan: FileHoldReleasePlan, released_holder: DurableHoldOwnerRef, basis: DurableHoldNonHolderReleaseBasis<Observation> }
  | FileHoldNonHolderReleaseNotEligible { slot_key: NonEmptyStr, refusal: DurableHoldNonHolderReleaseRefusal<Observation> }

fn file_hold_nonholder_release_assess<Observation>(
  root: NonEmptyStr,
  slot_key: NonEmptyStr,
  request: DurableHoldNonHolderRelease<Observation>,
  released_by: DurableHoldReleaseRef,
) -> FileHoldNonHolderReleaseAssessment<Observation>
  admit_callers: [
    decl_ref(module_path: "test.claim.durable_exclusive_hold_nonholder_release_wet_witness", decl_name: "nr_assess_at"),
    decl_ref(module_path: "gunbc.fleet.printer_execution_hold", decl_name: "printer_hold_nonholder_assess"),
  ]
{
  match durable_hold_nonholder_release_assess(hold: file_hold_ref(root: root, slot_key: slot_key), observed: observe_file_hold(root: root, key: slot_key), request: request) {
    NonHolderReleaseRefused { refusal: r } => FileHoldNonHolderReleaseNotEligible { slot_key: slot_key, refusal: r }
    NonHolderReleaseEligible { generation: g, released_holder: h, basis: b } =>
      FileHoldNonHolderReleasePlanned {
        plan: FileHoldReleasePlan {
          root: root,
          slot_key: slot_key,
          owner: h,
          generation: g,
          free_payload: hold_slot_payload(state: DurableHoldFree { released_by: released_by }),
          retention: KeepAllGenerations,
        },
        released_holder: h,
        basis: b,
      }
  }
}

// THE NON-HOLDER RELEASE'S PRODUCTION CONSUMER IS A DECLARED FRONTIER (DESIGN 3c), folded by
// gunbc.census_closure_frontier. gunbc.deploy_transition clears its transition lease on exactly the
// two bases modeled here, over a hand-rolled exclusive create whose outcome type is LeaseCreateOutcome.
// The trigger is that type RETIRING: it exists today, so the trigger is verifiable now, and it cannot
// survive the lease moving onto this hold library, so the census reports this row fired-but-present
// the moment the migration lands and the row must be deleted with it.
data durable_hold_nonholder_release_consumer_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.durable_exclusive_hold_file_store", decl_name: "file_hold_nonholder_release_assess"),
    reason: "file_hold_nonholder_release_assess (and std.durable_exclusive_hold durable_hold_nonholder_release_assess beneath it) is consumed in its introducing change only by test.claim.durable_exclusive_hold_nonholder_release_witness and test.claim.durable_exclusive_hold_nonholder_release_wet_witness. Named production consumer: gunbc.deploy_transition's transition lease, whose ClearedByEvidence becomes ReleasedOnEvidence and whose ClearedByAbandonment becomes ReleasedByOperator when acquire_transition_lease moves off its exclusive-create lock onto this hold library (the change after gunb-ai/gunbc#15061). That change also types the lease's Observation (today ResidueEvidence.observed_head is a caller-supplied String) and adds itself to this function's admit_callers.",
    dissolution: retires_dissolution(ref: decl_ref(module_path: "gunbc.deploy_transition", decl_name: "LeaseCreateOutcome")),
  ),
]
