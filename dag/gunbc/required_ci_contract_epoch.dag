module gunbc.required_ci_contract_epoch

import std.types { NonEmptyStr, String, List }
import std.contract_identity { ContractEpoch }
import std.content_hash { content_hash_of_value, serialize_content_hash }
import v2.std.algebra { list_map, fold_list }
import std.algebra { list_append }
import gunbc.emitted_subject_build_gate {
  emitted_subject_build_rows,
  emitted_subject_build_label_text,
  native_step_memory_envelope_env_name,
}
import v2.cli.population_verb_names { cli_verb_check_layout, cli_verb_parse_population }

// THE REQUIRED CI CONTRACT'S DECLARED EFFECTIVE EPOCH, in one place, because both sides of the
// comparison must read the SAME authority or the comparison is between two independently writable
// answers rather than between an observation and a requirement.
//
// WHY THIS IS ITS OWN MODULE AND NOT A ROW IN EITHER CONSUMER. Two modules need this value for
// opposite reasons: gunbc.witness.compiler_gate_workflow EMITS it into the workflow the required run
// executes, so the epoch is observable at the exact commit that ran; gunbc.fleet.fleet_revision_acceptance
// REQUIRES it, so fleet admission can refuse a contract whose obligations were revised under an
// unchanged name. Putting the value in either consumer would make the other import its peer for a
// single datum and would give the emitting side authority over what the judging side requires --
// which is the layer inversion §3 names, and would also make the epoch trivially self-satisfying.
//
// WHAT MOVES THIS VALUE. The epoch is a digest of required_ci_obligation_rows: what a green result
// entitles a consumer to conclude, plus the required context name. Adding, removing, or renaming an
// obligation row moves it. Do NOT digest the workflow text or the step list -- an internal change
// (a prelude step, a timeout, a cache key) must not move fleet admission. The residual manual
// question, now that materiality is the row set, is whether a new step adds an obligation row.
//
// THE HONEST RUNG. A cross-epoch admission is MECHANICALLY PREVENTED by the production join that
// compares this required value against the observed one. Materiality is DERIVED from the obligation
// rows. What remains diligence is classifying a change as an obligation rather than as the
// contract's own business.

// THE REQUIRED CONTEXT NAME, one spelling. gunbc.witness.compiler_gate_workflow's job id,
// gunbc.witness.witness_floor_workflow_job_id, and gunbc.repo.repo_ruleset desired_required_contexts
// all read this. A second literal "v2-bootstrap" beside it is the nickname this module exists to
// close (operator-approved name, 2026-10-10).
data required_ci_context_name: NonEmptyStr = "v2-bootstrap" as NonEmptyStr

// ONE ROW PER OBLIGATION, NEVER PER STEP. The kind is a closed coproduct so an invented kind is
// unwritable (DESIGN §5). The key is the stable identity of that obligation (a subject label, a
// verb spelling, the context name) and is read from the module that owns it.
type RequiredCiObligationKind
  = RequiredContextName
  | EmittedSubjectBuiltAndStarted
  | MemoryEnvelope
  | SourceLayoutCheck
  | PopulationParse

type RequiredCiObligation {
  kind: RequiredCiObligationKind
  key: NonEmptyStr
}

fn required_ci_obligation_kind_digest_name(k: RequiredCiObligationKind) -> String {
  match k {
    RequiredContextName => "required_context_name"
    EmittedSubjectBuiltAndStarted => "emitted_subject_built_and_started"
    MemoryEnvelope => "memory_envelope"
    SourceLayoutCheck => "source_layout_check"
    PopulationParse => "population_parse"
  }
}

fn required_ci_obligation(kind: RequiredCiObligationKind, key: NonEmptyStr) -> RequiredCiObligation {
  RequiredCiObligation { kind: kind, key: key }
}

fn required_ci_emitted_subject_obligations() -> List<RequiredCiObligation> {
  list_map(xs: emitted_subject_build_rows(), f: fn(row) {
    required_ci_obligation(
      kind: EmittedSubjectBuiltAndStarted,
      key: emitted_subject_build_label_text(row: row) as NonEmptyStr,
    )
  })
}

fn required_ci_obligation_rows() -> List<RequiredCiObligation> {
  list_append(
    left: [required_ci_obligation(kind: RequiredContextName, key: required_ci_context_name)],
    right: list_append(
      left: required_ci_emitted_subject_obligations(),
      right: [
        required_ci_obligation(kind: MemoryEnvelope, key: native_step_memory_envelope_env_name as NonEmptyStr),
        required_ci_obligation(kind: SourceLayoutCheck, key: cli_verb_check_layout as NonEmptyStr),
        required_ci_obligation(kind: PopulationParse, key: cli_verb_parse_population as NonEmptyStr),
      ],
    ),
  )
}

fn required_ci_obligation_line(row: RequiredCiObligation) -> String {
  concat(concat(concat(required_ci_obligation_kind_digest_name(k: row.kind), "\t"), row.key as String), "\n")
}

fn required_ci_obligation_digest_text(rows: List<RequiredCiObligation>) -> String {
  fold_list(xs: rows, empty: "", cons: fn(acc, row) { concat(acc, required_ci_obligation_line(row: row)) })
}

fn required_ci_contract_epoch_of(rows: List<RequiredCiObligation>) -> ContractEpoch {
  serialize_content_hash(hash: content_hash_of_value(value: required_ci_obligation_digest_text(rows: rows) as NonEmptyStr)) as ContractEpoch
}

data required_ci_contract_epoch: ContractEpoch = required_ci_contract_epoch_of(rows: required_ci_obligation_rows())

// The env member name the workflow authority emits and the exact-commit reader looks up. It is
// declared here beside the value because the KEY and the VALUE are one fact about how this epoch is
// carried: a reader looking up a key the emitter does not write, or an emitter writing a key no
// reader looks up, is the same fork in two directions.
data required_ci_contract_epoch_env_key: NonEmptyStr = "GUNBC_REQUIRED_CI_CONTRACT_EPOCH" as NonEmptyStr
