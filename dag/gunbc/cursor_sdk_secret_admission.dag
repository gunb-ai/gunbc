module gunbc.cursor_sdk_secret_admission

import std.types { NonEmptyStr, String }
import extdeps.cloud.gcp.secret_ref { SecretRef }

data cursor_sdk_secret_admission_note: String = "Slice after 7922: Cursor SDK local binds an EXACT GCP Secret Manager version — never latest. Key material flows into the SDK credential path only; it is not argv, logs, or probe stdout."

data secret_ref_latest_version_literal: NonEmptyStr = "latest" as NonEmptyStr

type CursorSdkSecretRefVersionAdmission
  = CursorSdkSecretRefVersionAdmitted { secret_ref: SecretRef }
  | CursorSdkSecretRefVersionRefused { reason: NonEmptyStr }

fn cursor_sdk_secret_ref_version_is_exact(ref: SecretRef) -> Bool {
  ref.version != secret_ref_latest_version_literal
}

fn cursor_sdk_admit_exact_secret_ref_version(
  ref: SecretRef,
) -> CursorSdkSecretRefVersionAdmission {
  if cursor_sdk_secret_ref_version_is_exact(ref: ref) {
    CursorSdkSecretRefVersionAdmitted { secret_ref: ref }
  } else {
    CursorSdkSecretRefVersionRefused {
      reason: "Cursor SDK local requires an exact GCP Secret Manager version, never latest" as NonEmptyStr,
    }
  }
}
