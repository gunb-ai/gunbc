module gunbc.typed_argv_exec


data typed_argv_exec_note: String = "Realization edge for remote command dispatch over SSH: one argv shape per op, taken from the extdeps authority that owns that operation, handed to the ssh.Session.ExecArgv transport.\\n\\nWhy the allowlist below is a wall and not decoration: the remote half of that transport is a command STRING, and under the OpenSSH client and server the corpus actually deploys against, that string is re-parsed by the remote user's shell. Those are two facts of different weight and extdeps.ssh.session ssh_remote_exec_carries_a_command_string_note separates them - the STRING is protocol (RFC 4254 section 6.5 gives the exec request one string-typed command field, so argv structure cannot cross as structure under any client), the RE-PARSING is OpenSSH behavior the protocol does not mandate. This wall is justified by the second, which is why it is scoped to a deployment fact rather than claimed as universal. So a word this edge lets through is a word the remote shell will interpret. typed_argv_shell_safe_refusal_argv admits only [A-Za-z0-9._-/@:=] and refuses the empty word, which leaves no space, quote, redirect, expansion, or separator able to reach that shell, and refuses (typed, located, carrying the offending word) rather than quoting or dropping it.\\n\\nThe wall is at this edge rather than in the transport, so it holds for callers that come through typed_argv_exec_over_ssh or typed_argv_probe_over_ssh - today the only callers of ExecArgv in the corpus - and not by construction for a future caller that imports extdeps.ssh.session directly. Wave C5 / bash-emit #5828 slice."

type TypedArgvExecOutcome =
  | TypedArgvExecConverged { result: extdeps.ssh.session.SshSessionExecResult }
  | TypedArgvExecRefused { reason: String }

fn typed_argv_portable_argv_char_allowed(cp: Int) -> Bool {
  (cp >= 65 && cp <= 90)
    || (cp >= 97 && cp <= 122)
    || (cp >= 48 && cp <= 57)
    || cp == 46
    || cp == 95
    || cp == 45
    || cp == 47
    || cp == 64
    || cp == 58
    || cp == 61
}

fn typed_argv_portable_argv_token_at(token: String, i: Int, len: Int) -> Bool {
  if i >= len {
    true
  } else {
    let cp = code_point(ch: char_at(token, i))
    if !typed_argv_portable_argv_char_allowed(cp: cp) {
      false
    } else {
      typed_argv_portable_argv_token_at(token: token, i: i + 1, len: len)
    }
  }
}

fn typed_argv_portable_argv_token(token: String) -> Bool {
  let len = string_length(s: token)
  if len == 0 {
    false
  } else {
    typed_argv_portable_argv_token_at(token: token, i: 0, len: len)
  }
}

fn typed_argv_shell_safe_refusal_token(token: String) -> String? {
  if typed_argv_portable_argv_token(token: token) {
    none
  } else {
    Present {
      value: concat(
        "typed_argv: argv token outside portable allowlist (fail-closed; ssh remote argv is shell-reinterpreted): ",
        token
      )
    }
  }
}

fn typed_argv_shell_safe_refusal_argv(argv: List<String>) -> String? {
  match v2.std.algebra.list_head(xs: argv) {
    HeadFound { value: token } =>
      match typed_argv_shell_safe_refusal_token(token: token) {
        Present { value: why } => Present { value: why }
        Absent =>
          match v2.std.algebra.list_tail(xs: argv) {
            TailFound { tail: rest } => typed_argv_shell_safe_refusal_argv(argv: rest)
            TailAbsent => none
          }
      }
    HeadAbsent => none
  }
}

fn typed_argv_exec_over_ssh(host: std.types.NonEmptyStr, argv: List<String>) -> TypedArgvExecOutcome {
  match typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: why } => TypedArgvExecRefused { reason: why }
    Absent => TypedArgvExecConverged { result: ssh_session_exec_argv(host: host, argv: argv) }
  }
}

fn typed_argv_probe_over_ssh(host: std.types.NonEmptyStr, argv: List<String>) -> TypedArgvExecOutcome {
  match typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: why } => TypedArgvExecRefused { reason: why }
    Absent => {
      let result = ssh.Session.ExecArgv(
        host: host,
        argv: argv,
        expect: OutcomeIsData,
      )
      TypedArgvExecConverged {
        result: ssh_session_exec_result_from_service(
          exit_code: result.exit_code,
          success: result.success,
          stdout: result.stdout,
          stderr: result.stderr,
        ),
      }
    }
  }
}


// THE CONTEXT-AWARE SEAM every FleetSsh leaf routes through. It is a separate function from
// typed_argv_exec_over_ssh rather than an added parameter, because the two take DIFFERENT
// PRECONDITIONS and fusing them would let the weaker one satisfy the stronger's signature: the
// SshShell form takes a bare endpoint and assembles an invocation with no trust facts, while this
// one cannot be called at all without a context whose anchor passed a content readback.
//
// The portable-word check is not duplicated here. typed_argv_shell_safe_refusal_argv exists at the
// SshShell seam for the same reason, but the wall this path relies on is portable_remote_words,
// which REFUSES INTO A TYPE rather than returning a diagnostic beside a still-usable list -- a word
// that fails has no PortableRemoteWord, so there is nothing to hand the shaper. Keeping both would
// be two representations of one rule, and the typed one is strictly stronger.
fn typed_argv_exec_over_fleet_ssh(
  target: gunbc.fleet_known_hosts_anchor.SshTarget,
  context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext,
  argv: List<String>,
) -> TypedArgvExecOutcome {
  match portable_remote_words(raws: argv) {
    Absent => TypedArgvExecRefused {
      reason: concat(
        "remote words are not portable under the far-side shell re-parse, so the leg was NOT attempted for ",
        target.endpoint as String,
      ),
    }
    Present { value: words } => TypedArgvExecConverged {
      result: ssh_session_exec_portable_words(
        client_args: shape_fleet_ssh_exec(context: context, target: target, words: words),
      ),
    }
  }
}
