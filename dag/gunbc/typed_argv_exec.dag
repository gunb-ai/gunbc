  exec_as_fleet_principal,
  exec_fleet_remote_leg,
  exec_as_fleet_principal_on_fresh_connection,
  BootstrapCredentialInRunEnvironment,
  FleetPrincipalLegRan,
  FleetPrincipalLegRefused,
}

// Realization edge for remote command dispatch over SSH: one argv shape per op, taken from the
// extdeps authority that owns that operation, handed to the ssh.Session.ExecPortableWords
// transport. ExecPortableWords takes client_args already shaped (with host, credentials, and
// portable-word allowlist) rather than building [ssh, host, --, argv] inside a transport literal,
// so the shaping is callable and testable by witnesses.\n\nWhy
// the allowlist below is a wall and not decoration: the remote half of that transport is a command
// STRING, and under the OpenSSH client and server the corpus actually deploys against, that string
// is re-parsed by the remote user's shell. Those are two facts of different weight and
// extdeps.ssh.session ssh_remote_exec_carries_a_command_string_note separates them - the STRING is
// protocol (RFC 4254 section 6.5 gives the exec request one string-typed command field, so argv
// structure cannot cross as structure under any client), the RE-PARSING is OpenSSH behavior the
// protocol does not mandate. This wall is justified by the second, which is why it is scoped to a
// deployment fact rather than claimed as universal. So a word this edge lets through is a word the
// remote shell will interpret. typed_argv_shell_safe_refusal_argv admits only [A-Za-z0-9._-/@:=]
// and refuses the empty word, which leaves no space, quote, redirect, expansion, or separator able
// to reach that shell, and refuses (typed, located, carrying the offending word) rather than
// quoting or dropping it.\n\nThe wall is at this edge rather than in the transport, so it holds for
// callers that come through typed_argv_exec_over_ssh or typed_argv_probe_over_ssh, and not by
// construction for a future caller that imports extdeps.ssh.session directly. Wave C5
// typed-argv slice.

type TypedArgvExecOutcome =
  | TypedArgvExecConverged { result: SshSessionExecResult }
  | TypedArgvExecRefused { reason: String }

fn typed_argv_portable_argv_char_allowed(cp: Int) -> Bool {
  (cp >= 65 && cp <= 90)
    || (cp >= 97 && cp <= 122)
    || (cp >= 48 && cp <= 57)
    || cp == 46
    || cp == 95
    || cp == 45
    || cp == 47
    || cp == 64
    || cp == 58
    || cp == 61
}

fn typed_argv_portable_argv_token_at(token: String, i: Int, len: Int) -> Bool {
  if i >= len {
    true
  } else {
    let cp = code_point(c: char_at(token, i))
    if !typed_argv_portable_argv_char_allowed(cp: cp) {
      false
    } else {
      typed_argv_portable_argv_token_at(token: token, i: i + 1, len: len)
    }
  }
}

fn typed_argv_portable_argv_token(token: String) -> Bool {
  let len = string_length(s: token)
  if len == 0 {
    false
  } else {
    typed_argv_portable_argv_token_at(token: token, i: 0, len: len)
  }
}

fn typed_argv_shell_safe_refusal_token(token: String) -> String? {
  if typed_argv_portable_argv_token(token: token) {
    none
  } else {
    Present {
      value: concat(
        "typed_argv: argv token outside portable allowlist (fail-closed; ssh remote argv is shell-reinterpreted): ",
        token
      )
    }
  }
}

fn typed_argv_shell_safe_refusal_argv(argv: List<String>) -> String? {
  match list_head(xs: argv) {
    Present { value: token } =>
      match typed_argv_shell_safe_refusal_token(token: token) {
        Present { value: why } => Present { value: why }
        Absent =>
          match list_tail(xs: argv) {
            Present { value: rest } => typed_argv_shell_safe_refusal_argv(argv: rest)
            Absent => none
          }
      }
    Absent => none
  }
}

fn typed_argv_exec_over_ssh(host: NonEmptyStr, argv: List<String>) -> TypedArgvExecOutcome {
  match typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: why } => TypedArgvExecRefused { reason: why }
    Absent => TypedArgvExecConverged {
      result: ssh_session_exec_portable_words(
        client_args: shape_ssh_shell_exec(host: host, argv: argv),
      ),
    }
  }
}

// THE STDIN SIBLING, same wall, same admission order. It exists because one op in a host-effect
// fold (dd receiving unit-file bytes) carries its payload as DATA, and the payload is not what the
// wall judges -- the ARGV is. The check runs before the transport call exactly as in
// typed_argv_exec_over_ssh, so a word the remote shell would re-parse refuses here rather than
// reaching ssh, whether or not the leg carries stdin. Kept as a separate function rather than an
// optional-stdin parameter on typed_argv_exec_over_ssh because the transport ops themselves are
// two distinct declarations (ExecPortableWords / ExecPortableWordsWithStdin); fusing here would
// make the seam read as one operation when the transport spells two.
fn typed_argv_exec_over_ssh_with_stdin(
  host: NonEmptyStr,
  argv: List<String>,
  stdin_payload: String,
) -> TypedArgvExecOutcome {
  match typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: why } => TypedArgvExecRefused { reason: why }
    Absent => TypedArgvExecConverged {
      result: ssh_session_exec_portable_words_with_stdin(
        client_args: shape_ssh_shell_exec(host: host, argv: argv),
        stdin_payload: stdin_payload,
      ),
    }
  }
}

fn typed_argv_probe_over_ssh(host: NonEmptyStr, argv: List<String>) -> TypedArgvExecOutcome {
  match typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: why } => TypedArgvExecRefused { reason: why }
    Absent => {
      let result = ssh.Session.ExecPortableWords(
        client_args: shape_ssh_shell_exec(host: host, argv: argv),
        expect: OutcomeIsData,
      )
      TypedArgvExecConverged {
        result: ssh_session_exec_result_from_service(
          exit_code: result.exit_code,
          success: result.success,
          stdout: result.stdout,
          stderr: result.stderr,
        ),
      }
    }
  }
}

// THE CONTEXT-AWARE SEAM every FleetSsh leaf routes through. It is a separate function from
// typed_argv_exec_over_ssh rather than an added parameter, because the two take DIFFERENT
// PRECONDITIONS and fusing them would let the weaker one satisfy the stronger's signature: the
// SshShell form takes a bare endpoint and assembles an invocation with no trust facts, while this
// one cannot be called at all without a context whose anchor passed a content readback.
//
// The portable-word check is not duplicated here. typed_argv_shell_safe_refusal_argv exists at the
// SshShell seam for the same reason, but the wall this path relies on is portable_remote_words,
// which REFUSES INTO A TYPE rather than returning a diagnostic beside a still-usable list -- a word
// that fails has no PortableRemoteWord, so there is nothing to hand the shaper. Keeping both would
// be two representations of one rule, and the typed one is strictly stronger.
// THE SESSION IS A FACT OF THE PRINCIPAL, READ HERE RATHER THAN ASSUMED. This arm named
// shape_fleet_ssh_exec, so every typed argv run against the bootstrap principal was a key-session
// leg against an account that holds no key. gunbc.fleet.fleet_bootstrap_principal_session decides.
// THE SAME TYPED LEG ON A CONNECTION OF ITS OWN (gunbc.fleet.fleet_bootstrap_principal_session
// exec_as_fleet_principal_on_fresh_connection): for a readback that must authenticate as a new login.
fn typed_argv_exec_over_fleet_ssh_fresh_connection(
  target: SshTarget,
  context: FleetSshExecutionContext,
  argv: List<String>,
) -> TypedArgvExecOutcome {
  match portable_remote_words(raws: argv) {
    Absent => TypedArgvExecRefused {
      reason: concat(
        "remote words are not portable under the far-side shell re-parse, so the leg was NOT attempted for ",
        ssh_target_wire(target: target) as String,
      ),
    }
    Present { value: words } =>
      match exec_as_fleet_principal_on_fresh_connection(context: context, target: target, words: words) {
        FleetPrincipalLegRefused { cause: why } => TypedArgvExecRefused { reason: why as String }
        FleetPrincipalLegRan { session: _, result: r } => TypedArgvExecConverged { result: r }
      }
  }
}

fn typed_argv_exec_over_fleet_ssh(
  target: SshTarget,
  context: FleetSshExecutionContext,
  argv: List<String>,
) -> TypedArgvExecOutcome {
  match portable_remote_words(raws: argv) {
    Absent => TypedArgvExecRefused {
      reason: concat(
        "remote words are not portable under the far-side shell re-parse, so the leg was NOT attempted for ",
        ssh_target_wire(target: target) as String,
      ),
    }
    Present { value: words } =>
      match exec_as_fleet_principal(
        context: context, target: target, words: words,
        credential: BootstrapCredentialInRunEnvironment,
      ) {
        FleetPrincipalLegRefused { cause: why } => TypedArgvExecRefused { reason: why as String }
        FleetPrincipalLegRan { session: _, result: r } => TypedArgvExecConverged { result: r }
      }
  }
}

// THE LOGIN SHELL OF THE TARGET PRINCIPAL, READ, NOT ASSUMED: `getent passwd <principal>` over the bare-word edge (every
// word is in the alphabet), parsed by the one mint of PosixLoginShellProof.
fn read_fleet_login_shell(target: SshTarget, context: FleetSshExecutionContext) -> LoginShellStanding {
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ["getent", "passwd", target.principal as String]) {
    TypedArgvExecRefused { reason: why } => LoginShellUnreadable { principal: target.principal, reason: why }
    TypedArgvExecConverged { result: r } => login_shell_standing(target: target, success: r.success, output: r.stdout)
  }
}

// THE TWO RELEASES THE QUOTED ROUTE DEPENDS ON, MEASURED IN THE SAME CALL: the executor's `ssh -V` (the client the
// transport's argv names) and the target's `sshd -V` over the bare-word edge (both words in the alphabet). `-V` prints
// on stderr (ssh.c, sshd.c case 'V').
fn read_posix_remote_route(target: SshTarget, context: FleetSshExecutionContext, proof: PosixLoginShellProof) -> PosixRemoteRouteStanding {
  let client = openssh.Client.Version()
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: openssh_server_version_argv(binary: fleet_openssh_server_binary)) {
    TypedArgvExecRefused { reason: why } => posix_remote_route_standing(proof: proof, client_success: client.success, client_output: client.stderr, server_success: false, server_output: why)
    TypedArgvExecConverged { result: r } => posix_remote_route_standing(proof: proof, client_success: client.success, client_output: client.stderr, server_success: r.success, server_output: r.stderr)
  }
}

// THE QUOTED ROUTE: the same leg as typed_argv_exec_over_fleet_ssh, for words the alphabet refuses. It reads the target
// principal's login shell ITSELF, in this call, over the same target and context, and quotes only under the proof that
// read mints, and only over a route whose client and server releases it has just measured and found covered. The
// quoted leg it runs takes its target from that proof (FleetPosixQuotedLeg has no target of its own), so
// no other target can receive the quoted words, and no proof carried in from an earlier read authorizes them.
fn typed_argv_exec_over_fleet_ssh_posix(
  target: SshTarget,
  context: FleetSshExecutionContext,
  argv: List<String>,
) -> TypedArgvExecOutcome {
  match read_fleet_login_shell(target: target, context: context) {
    LoginShellUnreadable { principal: _, reason: r } => TypedArgvExecRefused { reason: concat("the target's login shell could not be read, so no word is quoted: ", r) }
    LoginShellNotPosix { principal: _, shell: sh } => TypedArgvExecRefused { reason: concat("the target's login shell is not a POSIX sh, so no word is quoted: ", sh) }
    LoginShellPosix { proof: shell } =>
      match read_posix_remote_route(target: target, context: context, proof: shell) {
        PosixRemoteRouteUnmeasured { side: sd, reason: r } => TypedArgvExecRefused { reason: concat("no word is quoted: ", posix_remote_route_refusal_text(standing: PosixRemoteRouteUnmeasured { side: sd, reason: r })) }
        PosixRemoteRouteUncovered { side: sd, release_name: rl } => TypedArgvExecRefused { reason: concat("no word is quoted: ", posix_remote_route_refusal_text(standing: PosixRemoteRouteUncovered { side: sd, release_name: rl })) }
        PosixRemoteRouteCovered { route: route } =>
          match fleet_posix_quoted_leg(route: route, argv: argv) {
            Absent => TypedArgvExecRefused {
              reason: concat("a remote word is empty or carries NUL, which no argv carries, so the leg was NOT attempted for ", ssh_target_wire(target: target) as String),
            }
            Present { value: leg } =>
              match exec_fleet_remote_leg(
                context: context, leg: leg,
                credential: BootstrapCredentialInRunEnvironment,
              ) {
                FleetPrincipalLegRefused { cause: why } => TypedArgvExecRefused { reason: why as String }
                FleetPrincipalLegRan { session: _, result: r } => TypedArgvExecConverged { result: r }
              }
          }
      }
  }
}
