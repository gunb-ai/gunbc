module gunbc.extdeps_scope_frontier

data extdeps_scope_frontier_law: String = "Staged, fail-closed enrollment of the ExternalModelScope requirement (DESIGN §3 'External upstream decomposition'; operator verdicts on gunbc#7556 and gunbc#7571): every extdeps module must eventually carry one extdeps_model_scope: ExternalModelScope declaration. The corpus cannot be gated retroactively red in one change, so enrollment is staged at the storage grain the cover witness walks: every .dag file under dag/extdeps is EXACTLY ONE of scope_carrier_paths (carries a declared scope, admitted by execution), scope_machinery_exempt_paths (the citation vocabulary itself plus synthetic mock corpora — the v2.lens.mandatory_tag region-1 exemption semantics), or a row of the FROZEN legacy manifest (legacy_extdeps_scope_frontier_manifest_path). The cover witness (dag/test/claim/external_model_scope_witness_test.dag) walks dag/extdeps live, parses the manifest, and refuses any file in none of the three — a NEW extdeps module cannot land silently unenrolled: it adopts a scope (joining scope_carrier_paths) or is genuinely machinery; it does NOT join the manifest. There are no other exemption channels."

data legacy_manifest_shape_note: String = "The legacy population lives OUTSIDE the semantic module as a frozen manifest artifact (operator verdict on gunbc#7571, 2026-08-01: 399 hand-listed rows plus a hand-moved count inside the .dag authority were a second, churn-heavy representation of the extdeps file population). The manifest is one repo-relative path per line; its row count is DERIVED by the parser, never hand-declared; the exact live diff (both directions) is the enforcement. Lifecycle: FROZEN — rows are only ever REMOVED (a module migrates by adding its extdeps_model_scope declaration, moving to scope_carrier_paths, and deleting its manifest row in the same change); a row addition is a review red by inspection of the manifest diff. DISSOLVE-ON: when the manifest drains, the requirement is promoted to a second v2.lens.mandatory_tag region (required_decl_name extdeps_model_scope, required_type_name ExternalModelScope — the same compile-grain wall region 1 already runs for extdeps_external_authority_anchor), at which point the manifest, the parser, and the cover witness delete and the module-name grain replaces the storage grain. Paths are discriminators, not gospel (DESIGN §3): the storage grain exists only because the interim cover walker sees files."

data extdeps_scope_frontier_fixture_note: String = "The v2 red-control plants (src/v2/test/fixture/extdeps_external_authority/*/plant.dag) declare extdeps.* module names outside dag/extdeps; they are outside this walk and outside the requirement, exactly as they are exempt from mandatory-tag region 1."

data legacy_extdeps_scope_frontier_manifest_path: String = "dag/gunbc/legacy_extdeps_scope_frontier.tsv"

fn parse_frontier_manifest(content: String) -> List<String> {
  split(content, separator: "\n") |> filter(line => line != "")
}

data scope_carrier_paths: List<String> = [
  "dag/extdeps/vendor/atlassian.dag",
  "dag/extdeps/vendor/microsoft.dag"
]

data scope_machinery_exempt_paths: List<String> = [
  "dag/extdeps/external_authority.dag",
  "dag/extdeps/uri.dag",
  "dag/extdeps/bmc/mock_corpus.dag",
  "dag/extdeps/cloud/gcp/mock_corpus.dag",
  "dag/extdeps/cron/mock_corpus.dag",
  "dag/extdeps/diagnostic_mock_corpus.dag",
  "dag/extdeps/ebay/mock_corpus.dag",
  "dag/extdeps/filesystem/mock_corpus.dag",
  "dag/extdeps/github/mock_corpus.dag",
  "dag/extdeps/git/mock_corpus.dag",
  "dag/extdeps/linux/mock_corpus.dag",
  "dag/extdeps/llm/mock_corpus.dag",
  "dag/extdeps/sec/mock_corpus.dag",
  "dag/extdeps/shell_mock_corpus.dag",
  "dag/extdeps/ssh/mock_corpus.dag",
  "dag/extdeps/tcgplayer/mock_corpus.dag",
  "dag/extdeps/test/mock_corpus.dag"
]
