module gunbc.bmc_model

import std.types { Bool, Int, List, NonEmptyStr }
import std.measure { Second, second, second_count }
import std.optional { Present, Absent }
import std.algebra { list_snoc_item }
import extdeps.bmc.ipmi_channel { IpmiChannelNumber, IpmiUserId, IpmiUserChannelAccess, IpmiChannelPrivilegeLimit }
import extdeps.bmc.types { RedfishAccountRole }
import extdeps.bmc.redfish { redfish_password_change_required_body }
import extdeps.bmc.redfish_telemetry { RedfishLogEntry, RedfishLogService, RedfishTelemetryPoint }
import extdeps.bmc.redfish_virtual_media { RedfishVirtualMediaObservation }
import extdeps.bmc.ipmi_sdr { SdrTypeLine }
import extdeps.bmc.ipmi_chassis_control {
  IpmiChassisControlAction, IpmiChassisPowerDown, IpmiChassisPowerUp, IpmiChassisPowerCycle, IpmiChassisHardReset,
}
import std.roster_frontier { FrontierRow, PathSubject }
import gunbc.non_fold_residue { nfr_dissolve_owning_fold, nfr_reason_typed_census_ca5ed1724b }

// THE ONE BMC MODEL: scenario state and its transitions, nothing else. The controller operations and
// their response shapes are interface facts owned by extdeps.bmc (ipmi, ipmi_chassis_control,
// megarac, ipmitool_observed_output); this module never re-declares one. It is consumed by the dry
// operation realizations (gunbc.bmc_dry_realization, gunbc.machine_intake.mtcollins1_boot_dry_realization)
// and is written to be consumed unchanged by a protocol-speaking simulator later: every transition is
// pure, time is an INPUT, and persistence is the world value.
type BmcPower
  = BmcPowerOn
  | BmcPowerOff

// THE ONE-SHOT BOOT OVERRIDE (IPMI boot parameter 5), in the two states this controller has been
// observed in: no override, and a valid next-boot EFI CD/DVD override. A next-boot override is
// consumed by the boot it applies to, which is what the post-attempt read reports.
type BmcBootOverride
  = BootOverrideNone
  | BootOverrideCdromEfiNextBoot

// An event the world undergoes on its own, independent of any request. AC loss is grounded in the
// Mt. Collins SEL (run 36335369059, mtcollins1-boot-diagnostics.txt sha256
// eda19cde2e60d90d3d04946273e615eb5bf774496b9907e03d3bc15dbedc2c1c: `Power Unit ChassisPwrStatus | AC lost`).
// A dropped SOL session is the controller ending the serial session on its own, which the 2026-09-27
// incident (gunbc#12423) recorded as a loss mid-boot while the management interface kept answering.
// A power restore is the second half of a power cycle: the controller drops power, and after the
// scenario's off interval brings it back, so a read taken inside the interval sees it off.
type BmcEvent
  = BmcAcPowerLost {}
  | BmcPowerRestored {}
  | BmcSolSessionDropped {}
  | BmcKvmStreamClosed {}

type BmcScheduledEvent {
  at: Second
  event: BmcEvent
}

// One system event log record, in the fields `ipmitool sel elist` prints
// (extdeps.bmc.ipmitool_observed_output ipmitool_sel_elist_line).
type BmcSelRecord {
  id_hex: String
  date: String
  time: String
  sensor: String
  event: String
  state: String
}

// THE READ-ONLY RECORD SURFACES A CONTROLLER SERVES BESIDE ITS STATE, one field per upstream surface
// a modeled reader reads: the five a prior-life archive reads (docs/plans/machine-intake-design.md §5;
// consumed by gunbc.machine_intake.prior_life_boundary) and the IPMI SDR the boot's post-power-on fan
// gate reads (gunbc.machine_intake.mtcollins1_boot_fan_gate). Each is Absent when a world does not model
// it, so a reader that needs a surface refuses rather than reading an unmodeled surface as an empty
// record; bmc_world() leaves all six unmodeled, and no transition in this module changes any of them.
// - manager_date_time: the Redfish Manager resource's DateTime property (Manager.v1_0_0), as the
//   controller renders its own clock. It is an observation and never an ordering clock.
// - log_services: the Redfish LogService resources the controller serves, each with its LogEntry
//   members (extdeps.bmc.redfish_telemetry RedfishLogService, LogService.v1_0_0 / LogEntry.v1_9_0).
// - account_events: the LogEntry members of the log service that records AccountService events
//   (session and account changes). Redfish standardizes the entries, not which service holds them.
// - virtual_media: the VirtualMedia members (extdeps.bmc.redfish_virtual_media).
// - sensors: the Sensor members (extdeps.bmc.redfish_telemetry RedfishTelemetryPoint, Sensor.v1_2_0).
// - ipmi_sdr: the sensor records the controller publishes over IPMI, each under the SDR sensor-type
//   name `ipmitool sdr type` selects by (extdeps.bmc.ipmi SdrTypeList sensor_type) and in the fields
//   extdeps.bmc.ipmi_sdr decodes. It is a separate surface from `sensors` for the reason the SEL is
//   separate from log_services: the controller serves both, and the IPMI record carries a sensor number
//   and entity id a Redfish Sensor does not, so neither is derivable from the other.
// The IPMI SEL, the boot override and the power state are already fields of BmcWorld.
type BmcSdrRecord {
  sensor_type: NonEmptyStr
  line: SdrTypeLine
}

type BmcRecordSurfaces {
  manager_date_time: NonEmptyStr?
  log_services: List<RedfishLogService>?
  account_events: List<RedfishLogEntry>?
  virtual_media: List<RedfishVirtualMediaObservation>?
  sensors: List<RedfishTelemetryPoint>?
  ipmi_sdr: List<BmcSdrRecord>?
}

data bmc_record_surfaces_unmodeled: BmcRecordSurfaces = BmcRecordSurfaces {
  manager_date_time: none,
  log_services: none,
  account_events: none,
  virtual_media: none,
  sensors: none,
  ipmi_sdr: none,
}

// sol_drop_after_boot, when a scenario sets it, schedules the controller dropping its SOL session that
// long after the host starts booting, so the loss follows the route's own power-on rather than a clock
// guessed in advance.
// host_booted_at is the virtual instant the host last started booting (power on, or the restore of a
// cycle); the host's console is timed from it. booted_via_override records whether that boot consumed
// the one-shot override.
type BmcWorld {
  power: BmcPower
  pending: List<BmcScheduledEvent>
  fired: List<BmcScheduledEvent>
  boot_override: BmcBootOverride
  sel: List<BmcSelRecord>
  sol_session_open: Bool
  cycle_off_interval: Second
  host_booted_at: Second?
  booted_via_override: Bool
  sol_drop_after_boot: Second?
  web: BmcWebWorld
  ipmi_users: List<BmcIpmiUser>
  ipmi_user_access: List<IpmiUserChannelAccess>
  record_surfaces: BmcRecordSurfaces
  // The Redfish account service this controller serves (the AccountService/ManagerAccountCollection
  // surface). One entry per account the Redfish surface lists; the forced-change flag and failed-login
  // counter live here. See the Redfish account section below for the shared-vs-own-credential store.
  // A typed surface read, NOT a defaulted collection (DESIGN 5): `none` means the Redfish surface was
  // never modeled for this scenario (an unreadable surface, which the dry read reports as absence, never
  // as an empty census); `Present { [] }` means the surface is modeled and serves zero accounts. The two
  // are distinct facts and the dry read must not collapse them. Default `none` keeps an IPMI-only world
  // (which never touches Redfish) honest as "unmodeled" without forcing every literal to name it.
  redfish_accounts: List<BmcRedfishAccount>? = none
}

fn bmc_world(power: BmcPower) -> BmcWorld {
  BmcWorld {
    power: power, pending: [], fired: [], boot_override: BootOverrideNone, sel: [],
    sol_session_open: false, cycle_off_interval: second(count: 5), host_booted_at: none, booted_via_override: false, sol_drop_after_boot: none,
    web: bmc_web_world_untouched, ipmi_users: [], ipmi_user_access: [], record_surfaces: bmc_record_surfaces_unmodeled, redfish_accounts: none,
  }
}

// THE WEB AND KVM SURFACE OF A MANAGEMENT CONTROLLER, as this repository's own model (no vendor wire
// shape is carried here). World state only:
// the web sessions the controller holds, the account it accepts, the KVM viewers other clients hold,
// and the one KVM stream this world's client may open. `canvas_readable` is a BROWSER-side fact the
// a protocol adapter would read -- whether the page's canvas can be exported -- and no transition changes it.
type BmcWebSession {
  id: Int
  csrf_token: String
  privilege: Int
}

type BmcWebAccount {
  username: String
  password: String
  privilege: Int
}

type BmcKvmStream
  = BmcKvmIdle {}
  | BmcKvmStreaming { session: Int }
  | BmcKvmClosedByController { session: Int }

type BmcWebWorld {
  account: BmcWebAccount?
  sessions: List<BmcWebSession>
  next_session_id: Int
  other_kvm_viewers: Int
  kvm: BmcKvmStream
  canvas_readable: Bool
}

// A world whose web surface nobody has touched: it holds NO account, so every login is refused by
// construction. The first slice's worlds carry it unchanged.
data bmc_web_world_untouched: BmcWebWorld = BmcWebWorld {
  account: none,
  sessions: [],
  next_session_id: 1,
  other_kvm_viewers: 0,
  kvm: BmcKvmIdle {},
  canvas_readable: true,
}

// A COMMAND'S EFFECT AND ITS REPLY ARE SEPARATE FACTS. effect_taken says whether the world changed;
// the reply is the adapter's to render. §28.3 recommends a controller refuse a power cycle at an OFF
// host with completion code D5h; the Mt. Collins MegaRAC does not, and answers success doing nothing
// (extdeps.bmc.ipmi_chassis_control, run 36023602469). The model follows the observed unit, and that
// departure from the recommendation is the reason the arm exists.
type BmcChassisControlStep {
  world: BmcWorld
  effect_taken: Bool
}

fn bmc_power_is_on(world: BmcWorld) -> Bool {
  match world.power {
    BmcPowerOn => true
    BmcPowerOff => false
  }
}

fn bmc_with_power(world: BmcWorld, power: BmcPower) -> BmcWorld {
  BmcWorld {
    power: power, pending: world.pending, fired: world.fired, boot_override: world.boot_override, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: world.sol_drop_after_boot,
    web: world.web, ipmi_users: world.ipmi_users, ipmi_user_access: world.ipmi_user_access, record_surfaces: world.record_surfaces, redfish_accounts: world.redfish_accounts,
  }
}

fn bmc_with_web(world: BmcWorld, web: BmcWebWorld) -> BmcWorld {
  BmcWorld {
    power: world.power, pending: world.pending, fired: world.fired, boot_override: world.boot_override, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: world.sol_drop_after_boot,
    web: web, ipmi_users: world.ipmi_users, ipmi_user_access: world.ipmi_user_access, record_surfaces: world.record_surfaces, redfish_accounts: world.redfish_accounts,
  }
}

fn bmc_with_record_surfaces(world: BmcWorld, surfaces: BmcRecordSurfaces) -> BmcWorld {
  BmcWorld {
    power: world.power, pending: world.pending, fired: world.fired, boot_override: world.boot_override, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: world.sol_drop_after_boot,
    web: world.web, ipmi_users: world.ipmi_users, ipmi_user_access: world.ipmi_user_access, record_surfaces: surfaces, redfish_accounts: world.redfish_accounts,
  }
}

fn bmc_web_with(web: BmcWebWorld, sessions: List<BmcWebSession>, next_session_id: Int, kvm: BmcKvmStream) -> BmcWebWorld {
  BmcWebWorld { account: web.account, sessions: sessions, next_session_id: next_session_id, other_kvm_viewers: web.other_kvm_viewers, kvm: kvm, canvas_readable: web.canvas_readable }
}

// ── WEB SESSION AND KVM TRANSITIONS ──────────────────────────────────────────────────────────────

type BmcWebLoginReply
  = BmcWebLoginAccepted { session: BmcWebSession }
  | BmcWebLoginRefused {}

type BmcWebLoginStep {
  world: BmcWorld
  reply: BmcWebLoginReply
}

// POST /api/session. A world with no account refuses every login; otherwise an exact match opens a
// session with a fresh id and CSRF token, and anything else is refused with the world unchanged.
fn bmc_web_login(world: BmcWorld, username: String, password: String) -> BmcWebLoginStep {
  let web = world.web
  match web.account {
    Absent => BmcWebLoginStep { world: world, reply: BmcWebLoginRefused {} }
    Present { value: account } =>
      if username == account.username && password == account.password {
        let session = BmcWebSession { id: web.next_session_id, csrf_token: concat("csrf-", to_string(web.next_session_id)), privilege: account.privilege }
        BmcWebLoginStep {
          world: bmc_with_web(world: world, web: bmc_web_with(web: web, sessions: list_snoc_item(xs: web.sessions, item: session), next_session_id: web.next_session_id + 1, kvm: web.kvm)),
          reply: BmcWebLoginAccepted { session: session },
        }
      } else {
        BmcWebLoginStep { world: world, reply: BmcWebLoginRefused {} }
      }
  }
}

fn bmc_web_session_of_token(world: BmcWorld, csrf_token: String) -> List<BmcWebSession> {
  filter(world.web.sessions, s => s.csrf_token == csrf_token)
}

// The KVM viewer count: every viewer the controller is serving, ours included.
fn bmc_kvm_viewer_count(world: BmcWorld) -> Int {
  world.web.other_kvm_viewers + match world.web.kvm {
    BmcKvmStreaming { session: _ } => 1
    BmcKvmIdle {} => 0
    BmcKvmClosedByController { session: _ } => 0
  }
}

type BmcKvmConnectStep {
  world: BmcWorld
  accepted: Bool
}

// The /kvm WebSocket for a session this world holds. A token naming no session is refused.
//
// OCCUPIED SEAT, A MODELING DECISION (not a captured fact): while a stream is held -- by this
// world's client or by another viewer (other_kvm_viewers) -- a further connect is REFUSED, never
// allowed to take the stream over. A read of the viewer count does not exclude a competing connect
// arriving after it, so the model answers the connect itself. A captured multi-viewer answer from a
// controller replaces this decision.
fn bmc_kvm_connect(world: BmcWorld, csrf_token: String) -> BmcKvmConnectStep {
  let occupied = bmc_kvm_viewer_count(world: world) > 0
  match bmc_web_session_of_token(world: world, csrf_token: csrf_token).first() {
    Absent => BmcKvmConnectStep { world: world, accepted: false }
    Present { value: _ } => if occupied { BmcKvmConnectStep { world: world, accepted: false } } else { bmc_kvm_connect_admitted(world: world, csrf_token: csrf_token) }
  }
}

fn bmc_kvm_connect_admitted(world: BmcWorld, csrf_token: String) -> BmcKvmConnectStep {
  match bmc_web_session_of_token(world: world, csrf_token: csrf_token).first() {
    Absent => BmcKvmConnectStep { world: world, accepted: false }
    Present { value: s } => BmcKvmConnectStep {
      world: bmc_with_web(world: world, web: bmc_web_with(web: world.web, sessions: world.web.sessions, next_session_id: world.web.next_session_id, kvm: BmcKvmStreaming { session: s.id })),
      accepted: true,
    }
  }
}

type BmcWebLogoutStep {
  world: BmcWorld
  released: Bool
}

// DELETE /api/session: the session goes, and a KVM stream it owned ends with it.
fn bmc_web_logout(world: BmcWorld, csrf_token: String) -> BmcWebLogoutStep {
  match bmc_web_session_of_token(world: world, csrf_token: csrf_token).first() {
    Absent => BmcWebLogoutStep { world: world, released: false }
    Present { value: s } => {
      let kvm = match world.web.kvm {
        BmcKvmStreaming { session: k } => if k == s.id { BmcKvmIdle {} } else { world.web.kvm }
        other => other
      }
      BmcWebLogoutStep {
        world: bmc_with_web(world: world, web: bmc_web_with(web: world.web, sessions: filter(world.web.sessions, x => x.id != s.id), next_session_id: world.web.next_session_id, kvm: kvm)),
        released: true,
      }
    }
  }
}

fn bmc_with_override(world: BmcWorld, over: BmcBootOverride) -> BmcWorld {
  BmcWorld {
    power: world.power, pending: world.pending, fired: world.fired, boot_override: over, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: world.sol_drop_after_boot,
    web: world.web, ipmi_users: world.ipmi_users, ipmi_user_access: world.ipmi_user_access, record_surfaces: world.record_surfaces, redfish_accounts: world.redfish_accounts,
  }
}

fn bmc_with_sol_session(world: BmcWorld, open: Bool) -> BmcWorld {
  BmcWorld {
    power: world.power, pending: world.pending, fired: world.fired, boot_override: world.boot_override, sel: world.sel,
    sol_session_open: open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: world.sol_drop_after_boot,
    web: world.web, ipmi_users: world.ipmi_users, ipmi_user_access: world.ipmi_user_access, record_surfaces: world.record_surfaces, redfish_accounts: world.redfish_accounts,
  }
}

fn bmc_with_pending(world: BmcWorld, pending: List<BmcScheduledEvent>, fired: List<BmcScheduledEvent>) -> BmcWorld {
  BmcWorld {
    power: world.power, pending: pending, fired: fired, boot_override: world.boot_override, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: world.sol_drop_after_boot,
    web: world.web, ipmi_users: world.ipmi_users, ipmi_user_access: world.ipmi_user_access, record_surfaces: world.record_surfaces, redfish_accounts: world.redfish_accounts,
  }
}

// The host starts booting now: power is on, the boot is timed from here, and a pending next-boot
// override is consumed by it.
fn bmc_host_boots(world: BmcWorld, now: Second) -> BmcWorld {
  let via = match world.boot_override { BootOverrideCdromEfiNextBoot => true BootOverrideNone => false }
  let pending = match world.sol_drop_after_boot {
    Absent => world.pending
    Present { value: after } => list_snoc_item(xs: world.pending, item: BmcScheduledEvent { at: second(count: second_count(s: now) + second_count(s: after)), event: BmcSolSessionDropped {} })
  }
  BmcWorld {
    power: BmcPowerOn, pending: pending, fired: world.fired, boot_override: BootOverrideNone, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: Present { value: now }, booted_via_override: via, sol_drop_after_boot: world.sol_drop_after_boot,
    web: world.web, ipmi_users: world.ipmi_users, ipmi_user_access: world.ipmi_user_access, record_surfaces: world.record_surfaces, redfish_accounts: world.redfish_accounts,
  }
}

fn bmc_chassis_control(world: BmcWorld, action: IpmiChassisControlAction, now: Second) -> BmcChassisControlStep {
  match action {
    IpmiChassisPowerUp =>
      if bmc_power_is_on(world: world) { BmcChassisControlStep { world: world, effect_taken: false } }
      else { BmcChassisControlStep { world: bmc_host_boots(world: world, now: now), effect_taken: true } }
    IpmiChassisPowerDown => BmcChassisControlStep { world: bmc_with_power(world: world, power: BmcPowerOff), effect_taken: bmc_power_is_on(world: world) }
    IpmiChassisPowerCycle =>
      if bmc_power_is_on(world: world) {
        let off = bmc_with_power(world: world, power: BmcPowerOff)
        let restore = BmcScheduledEvent { at: second(count: second_count(s: now) + second_count(s: world.cycle_off_interval)), event: BmcPowerRestored {} }
        BmcChassisControlStep { world: bmc_with_pending(world: off, pending: list_snoc_item(xs: off.pending, item: restore), fired: off.fired), effect_taken: true }
      } else { BmcChassisControlStep { world: world, effect_taken: false } }
    IpmiChassisHardReset =>
      if bmc_power_is_on(world: world) { BmcChassisControlStep { world: bmc_host_boots(world: world, now: now), effect_taken: true } }
      else { BmcChassisControlStep { world: world, effect_taken: false } }
  }
}

// A stream the controller closes on its own (the dropped /kvm connection) ends the stream but not
// the web session that opened it.
fn bmc_apply_event(world: BmcWorld, event: BmcEvent, at: Second) -> BmcWorld {
  match event {
    BmcAcPowerLost {} => bmc_with_power(world: world, power: BmcPowerOff)
    BmcPowerRestored {} => bmc_host_boots(world: world, now: at)
    BmcSolSessionDropped {} => bmc_with_sol_session(world: world, open: false)
    BmcKvmStreamClosed {} => match world.web.kvm {
      BmcKvmStreaming { session: k } => bmc_with_web(world: world, web: bmc_web_with(web: world.web, sessions: world.web.sessions, next_session_id: world.web.next_session_id, kvm: BmcKvmClosedByController { session: k }))
      BmcKvmIdle {} => world
      BmcKvmClosedByController { session: _ } => world
    }
  }
}

// EVERY EVENT DUE AT OR BEFORE `now` FIRES, EARLIEST FIRST, AND AN EVENT A TRANSITION SCHEDULES IS
// KEPT. One due event is taken off the world's own pending list, applied, and recorded as fired; the
// advance then repeats on the world THAT TRANSITION PRODUCED, so an event it scheduled -- a power
// restore arming its SOL drop -- stays pending and fires in turn if it too is due. (An earlier fold
// rebuilt pending from its own accumulator after each transition and so discarded exactly those
// events: #12423 side-chat review 5342387382.) Each step fires one due event, so the repetition ends.
// With nothing due the world is returned as it is rather than rebuilt.
fn bmc_advance(world: BmcWorld, now: Second) -> BmcWorld {
  match bmc_first_due(pending: world.pending, now: now) {
    Absent => world
    Present { value: e } => {
      let remaining = bmc_without_first(pending: world.pending, event: e)
      let applied = bmc_apply_event(world: bmc_with_pending(world: world, pending: remaining, fired: world.fired), event: e.event, at: e.at)
      bmc_advance(world: bmc_with_pending(world: applied, pending: applied.pending, fired: list_snoc_item(xs: applied.fired, item: e)), now: now)
    }
  }
}

// The due event with the earliest instant; among equal instants, the first in schedule order.
fn bmc_no_event() -> BmcScheduledEvent? {
  none
}

fn bmc_first_due(pending: List<BmcScheduledEvent>, now: Second) -> BmcScheduledEvent? {
  fold(pending, init: bmc_no_event(), f: fn(acc, e) {
    if second_count(s: e.at) > second_count(s: now) { acc } else {
      match acc {
        Absent => Present { value: e }
        Present { value: best } => if second_count(s: e.at) < second_count(s: best.at) { Present { value: e } } else { acc }
      }
    }
  })
}

type BmcPendingRemoval {
  kept: List<BmcScheduledEvent>
  removed: Bool
}

// Removes ONE occurrence -- the first equal to `event` -- so two identical scheduled events fire twice.
fn bmc_without_first(pending: List<BmcScheduledEvent>, event: BmcScheduledEvent) -> List<BmcScheduledEvent> {
  fold(pending, init: BmcPendingRemoval { kept: [], removed: false }, f: fn(acc, e) {
    if !acc.removed && second_count(s: e.at) == second_count(s: event.at) && e.event == event.event {
      BmcPendingRemoval { kept: acc.kept, removed: true }
    } else {
      BmcPendingRemoval { kept: list_snoc_item(xs: acc.kept, item: e), removed: acc.removed }
    }
  }).kept
}

fn bmc_with_sol_drop_after_boot(world: BmcWorld, after: Second) -> BmcWorld {
  BmcWorld {
    power: world.power, pending: world.pending, fired: world.fired, boot_override: world.boot_override, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: Present { value: after },
    web: world.web, ipmi_users: world.ipmi_users, ipmi_user_access: world.ipmi_user_access, record_surfaces: world.record_surfaces, redfish_accounts: world.redfish_accounts,
  }
}

fn bmc_sol_drop_fired(world: BmcWorld) -> Bool {
  !all(world.fired, e => match e.event { BmcSolSessionDropped {} => false _ => true })
}

// ── IPMI USER PASSWORD ───────────────────────────────────────────────────────────────────────────
//
// THE CONTROLLER'S IPMI USER TABLE, AS FAR AS A PASSWORD WRITE TOUCHES IT. A world starts with no
// users, so every write against an untouched world is refused by construction. The transition is the
// Set User Password command of the public IPMI v2.0 specification (App NetFn, command 47h, operation
// "set password"): it addresses a user by id and replaces that user's password, and it changes
// nothing else. Whether the user is enabled or what privilege it holds is a separate command, so it is
// not changed here. A write to an id the table does not hold changes nothing and is not completed.
type BmcIpmiUser {
  id: IpmiUserId
  password: String
}

type BmcIpmiSetUserPasswordStep {
  world: BmcWorld
  completed: Bool
}

fn bmc_with_ipmi_users(world: BmcWorld, users: List<BmcIpmiUser>) -> BmcWorld {
  BmcWorld {
    power: world.power, pending: world.pending, fired: world.fired, boot_override: world.boot_override, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: world.sol_drop_after_boot,
    web: world.web, ipmi_users: users, ipmi_user_access: world.ipmi_user_access, record_surfaces: world.record_surfaces, redfish_accounts: world.redfish_accounts,
  }
}

fn bmc_ipmi_set_user_password(world: BmcWorld, user: IpmiUserId, password: String) -> BmcIpmiSetUserPasswordStep {
  if any(world.ipmi_users, u => (u.id as Int) == (user as Int)) {
    BmcIpmiSetUserPasswordStep {
      world: bmc_with_ipmi_users(
        world: world,
        users: map(world.ipmi_users, u => if (u.id as Int) == (user as Int) { BmcIpmiUser { id: u.id, password: password } } else { u }),
      ),
      completed: true,
    }
  } else {
    BmcIpmiSetUserPasswordStep { world: world, completed: false }
  }
}

// Whether the controller would authenticate this user with this password: the readback a write is
// judged by, independent of the write's own completion.
fn bmc_ipmi_user_accepts(world: BmcWorld, user: IpmiUserId, password: String) -> Bool {
  any(world.ipmi_users, u => (u.id as Int) == (user as Int) && u.password == password)
}

// ── IPMI USER ACCESS ─────────────────────────────────────────────────────────────────────────────
//
// THE CONTROLLER'S PER-CHANNEL USER ACCESS TABLE: one (channel, user, privilege limit) row per pair
// the controller holds, the shape Get User Access returns (extdeps.bmc.ipmi_channel). The transition
// is the Set User Access command of the public IPMI v2.0 specification (App NetFn, command 43h): it
// sets one user's privilege limit on one channel and changes nothing else -- not the password, not
// the row of any other channel or user. A write for a user the IPMI user table does not hold changes
// nothing and is not completed.
type BmcIpmiSetUserAccessStep {
  world: BmcWorld
  completed: Bool
}

fn bmc_with_ipmi_user_access(world: BmcWorld, rows: List<IpmiUserChannelAccess>) -> BmcWorld {
  BmcWorld {
    power: world.power, pending: world.pending, fired: world.fired, boot_override: world.boot_override, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: world.sol_drop_after_boot,
    web: world.web, ipmi_users: world.ipmi_users, ipmi_user_access: rows, record_surfaces: world.record_surfaces, redfish_accounts: world.redfish_accounts,
  }
}

fn bmc_ipmi_set_user_access(world: BmcWorld, access: IpmiUserChannelAccess) -> BmcIpmiSetUserAccessStep {
  if any(world.ipmi_users, u => (u.id as Int) == (access.user as Int)) {
    let others = filter(world.ipmi_user_access, r => !((r.user as Int) == (access.user as Int) && (r.channel as Int) == (access.channel as Int)))
    BmcIpmiSetUserAccessStep { world: bmc_with_ipmi_user_access(world: world, rows: list_snoc_item(xs: others, item: access)), completed: true }
  } else {
    BmcIpmiSetUserAccessStep { world: world, completed: false }
  }
}

// Get User Access for one (channel, user): the readback a channel-access write is judged by,
// independent of the write's completion. Absent when the controller holds no row for the pair.
fn bmc_ipmi_get_user_access(world: BmcWorld, user: IpmiUserId, channel: IpmiChannelNumber) -> IpmiChannelPrivilegeLimit? {
  let wanted: IpmiChannelPrivilegeLimit? = none
  filter(world.ipmi_user_access, r => (r.user as Int) == (user as Int) && (r.channel as Int) == (channel as Int))
    |> fold(init: wanted, f: (acc, r) => match acc { Absent => Present { value: r.privilege }  Present { value: _ } => acc })
}

data non_fold_residue_frontier: List<FrontierRow> = [
  FrontierRow { subject: PathSubject { path: "bmc_sol_drop_fired" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
]

// ── REDFISH ACCOUNT SERVICE ───────────────────────────────────────────────────────────────────
//
// THE REDFISH SURFACE OF THE SAME MANAGEMENT CONTROLLER this world already models over IPMI and the web:
// the AccountService/ManagerAccountCollection surface the O1b BmcSecure dry fold drives. It carries an
// account whose password must change on first login (the 03.22.00 factory build answers every authenticated
// request but the one Password PATCH with 403 while that stands), the credential itself, and the
// failed-login counter that may lock the account. The IPMI user table above is KEPT unchanged -- the
// Redfish accounts are the Redfish view of the controller's accounts, not a replacement, and the two
// surfaces share a credential only where the build's policy row grounds that.
//
// ONE STORE, NOT TWO COPIES. On an OpenBMC build whose credential-policy row (gunbc.machine_intake.
// bmc_credential_policy, shared_store_surfaces) grounds one password per account across Redfish and IPMI,
// root is ONE account holding ONE password: the shared variant stores that password in its one home, the
// IPMI user table, and references the user id here -- so the Redfish view reads the SAME credential
// bmc_ipmi_user_accepts reads and a password write through Redfish changes the one stored secret, never a
// second copy. Where a surface's sharing is NOT grounded by the policy row -- 03.22.00 grounds the Redfish
// surface alone (IPMI lanplus is explicitly not grounded), so its root Redfish account is a single
// credential in its own right -- the dedicated variant carries its own password. WHICH variant a build's
// root uses is the caller's decision from the policy row (made in gunbc.machine_intake.bmc_secure, the
// consumer of these transitions), never the world's guess: the world offers both shapes and reads each
// honestly, so it can neither silently duplicate a shared secret nor silently claim a shared secret that
// the build does not ground.

type BmcRedfishAccount
  = BmcRedfishAccountSharesIpmi {
      name: String
      ipmi_user: IpmiUserId
      role: RedfishAccountRole
      enabled: Bool
      locked: Bool
      forced_password_change: Bool
      failed_logins: Int
    }
  | BmcRedfishAccountOwnCredential {
      name: String
      password: String
      role: RedfishAccountRole
      enabled: Bool
      locked: Bool
      forced_password_change: Bool
      failed_logins: Int
    }

// Which accounts the Redfish surface serves. The dry Redfish read (gunbc.machine_intake.bmc_secure's
// dry_read_bmc_account_state) is the consumer that reads this census; a world built with none reads as
// "the Redfish surface serves no account," which is NOT the same as the surface being unreadable.
fn bmc_with_redfish_accounts(world: BmcWorld, accounts: List<BmcRedfishAccount>) -> BmcWorld {
  BmcWorld {
    power: world.power, pending: world.pending, fired: world.fired, boot_override: world.boot_override, sel: world.sel,
    sol_session_open: world.sol_session_open, cycle_off_interval: world.cycle_off_interval,
    host_booted_at: world.host_booted_at, booted_via_override: world.booted_via_override, sol_drop_after_boot: world.sol_drop_after_boot,
    web: world.web, ipmi_users: world.ipmi_users, ipmi_user_access: world.ipmi_user_access, record_surfaces: world.record_surfaces,
    redfish_accounts: Present { value: accounts },
  }
}

fn bmc_redfish_account_name(account: BmcRedfishAccount) -> String {
  match account {
    BmcRedfishAccountSharesIpmi { name: name } => name
    BmcRedfishAccountOwnCredential { name: name } => name
  }
}

fn bmc_redfish_account_enabled(account: BmcRedfishAccount) -> Bool {
  match account {
    BmcRedfishAccountSharesIpmi { enabled: enabled } => enabled
    BmcRedfishAccountOwnCredential { enabled: enabled } => enabled
  }
}

fn bmc_redfish_account_locked(account: BmcRedfishAccount) -> Bool {
  match account {
    BmcRedfishAccountSharesIpmi { locked: locked } => locked
    BmcRedfishAccountOwnCredential { locked: locked } => locked
  }
}

fn bmc_redfish_account_forced(account: BmcRedfishAccount) -> Bool {
  match account {
    BmcRedfishAccountSharesIpmi { forced_password_change: forced } => forced
    BmcRedfishAccountOwnCredential { forced_password_change: forced } => forced
  }
}

fn bmc_redfish_account_failed_logins(account: BmcRedfishAccount) -> Int {
  match account {
    BmcRedfishAccountSharesIpmi { failed_logins: n } => n
    BmcRedfishAccountOwnCredential { failed_logins: n } => n
  }
}

// The account's `@odata.id`, the form srv13's ManagerAccountCollection published ("/redfish/v1/AccountService/
// Accounts/<name>"). This is what the build embeds as the target URI of its forced-change 403, so it is a
// served-shape fact -- but it is derived here from the name the collection grounds, not carried per account,
// so a world cannot disagree with itself about where an account lives.
fn bmc_redfish_account_odata_id(name: String) -> String {
  concat("/redfish/v1/AccountService/Accounts/", name)
}

// The census the Redfish surface serves, as a plain list for lookups. An UNMODELED surface (none) yields
// the empty list here -- but that is deliberately NOT what the dry read consumes: bmc_redfish_surface
// exposes the raw typed absence so a caller can tell "unmodeled" from "serves zero." Nothing below turns an
// unmodeled surface into a claim that the controller has no accounts; only a lookup returns nothing.
fn bmc_redfish_census(world: BmcWorld) -> List<BmcRedfishAccount> {
  match world.redfish_accounts {
    Absent => []
    Present { value: accounts } => accounts
  }
}

// THE TYPED SURFACE READ, for the dry read (gunbc.machine_intake.bmc_secure's dry_read_bmc_account_state).
// `Absent` = the Redfish surface was never modeled (report the reading as absence, not as an empty census);
// `Present { [] }` = the surface is modeled and genuinely serves zero accounts. Never collapse the two.
fn bmc_redfish_surface(world: BmcWorld) -> List<BmcRedfishAccount>? {
  world.redfish_accounts
}

fn bmc_redfish_account(world: BmcWorld, name: String) -> BmcRedfishAccount? {
  let wanted: BmcRedfishAccount? = none
  filter(bmc_redfish_census(world: world), a => bmc_redfish_account_name(account: a) == name)
    |> fold(init: wanted, f: (acc, a) => match acc { Absent => Present { value: a }  Present { value: _ } => acc })
}

// THE PASSWORD, read through to its one home. A shared account's password lives in the IPMI user table
// (read from there, never copied); a dedicated account's lives in its own record. `Absent` is a real answer:
// a shared account whose IPMI user the table no longer holds has no credential to authenticate -- fail closed
// rather than assume one.
fn bmc_ipmi_user_password(world: BmcWorld, user: IpmiUserId) -> String? {
  let wanted: String? = none
  filter(world.ipmi_users, u => (u.id as Int) == (user as Int))
    |> fold(init: wanted, f: (acc, u) => match acc { Absent => Present { value: u.password }  Present { value: _ } => acc })
}

fn bmc_redfish_account_password(world: BmcWorld, account: BmcRedfishAccount) -> String? {
  match account {
    BmcRedfishAccountSharesIpmi { ipmi_user: ipmi_user } => bmc_ipmi_user_password(world: world, user: ipmi_user)
    BmcRedfishAccountOwnCredential { password: password } => Present { value: password }
  }
}

// THE CREDENTIAL IS PRESENTED two ways and both must meet the same gate: HTTP Basic, and a Redfish session
// token (the world's session authority is the web-session model above; the credential check below is the
// account check both transports bottom out in). The transport is carried so a check can assert the forced
// gate does not depend on it.
type RedfishAuthTransport
  = RedfishBasicAuth {}
  | RedfishSessionAuth {}

// Whether the request is the one Password PATCH the build admits while a change is forced. Any other
// authenticated request -- even with the correct current credential -- is refused with 403 while the forced
// change stands.
type RedfishRequestKind
  = RedfishOrdinaryRequest {}
  | RedfishPasswordPatch {}

// THE THREE AUTHENTICATED OUTCOMES the dry Redfish surface answers with, and nothing else: 200 (access
// granted), 401 (the credential did not authenticate -- wrong password, disabled, locked, or no such
// account, all reported the same way so the reply leaks nothing), and the 403 forced-change refusal whose
// body the build serves (emitted through extdeps.bmc.redfish redfish_password_change_required_body, which
// the witness inhabits against the committed srv13 capture). A `String` credential is the dry model's
// representation, matching BmcIpmiUser.password; the real route materialises the secret at the Redfish
// boundary, not in the world.
type RedfishAuthOutcome
  = RedfishAuthAccepted { via: RedfishAuthTransport }
  | RedfishAuthUnauthorized {}
  | RedfishAuthForcedPasswordChange { body: String }

// Authenticate a request to the Redfish surface. `forced_message_id` is the build's message id
// ("Base.1.16.0.PasswordChangeRequired" for 03.22.00), supplied by the caller from its policy row -- the
// world does not hardcode a build's message registry version. Fail-closed order: an unknown account, a
// disabled account, a locked account, or a mismatched credential is 401; a correct credential is 403-forced
// while the flag stands UNLESS the request is the admitted PATCH, and 200 otherwise.
fn bmc_redfish_authorize(
  world: BmcWorld, name: String, password: String, transport: RedfishAuthTransport, request: RedfishRequestKind, forced_message_id: String
) -> RedfishAuthOutcome {
  match bmc_redfish_account(world: world, name: name) {
    Absent => RedfishAuthUnauthorized {}
    Present { value: account } =>
      if !bmc_redfish_account_enabled(account: account) || bmc_redfish_account_locked(account: account) {
        RedfishAuthUnauthorized {}
      } else {
        match bmc_redfish_account_password(world: world, account: account) {
          Absent => RedfishAuthUnauthorized {}
          Present { value: secret } =>
            if secret != password {
              RedfishAuthUnauthorized {}
            } else if bmc_redfish_account_forced(account: account) {
              match request {
                RedfishPasswordPatch {} => RedfishAuthAccepted { via: transport }
                RedfishOrdinaryRequest {} => RedfishAuthForcedPasswordChange {
                  body: redfish_password_change_required_body(account_odata_id: bmc_redfish_account_odata_id(name: name), message_id: forced_message_id)
                }
              }
            } else {
              RedfishAuthAccepted { via: transport }
            }
        }
      }
  }
}

// THE ONE PASSWORD WRITE. Applying the admitted Password PATCH writes the account's credential and clears
// the forced flag -- the two effects the change is made of. For a shared account the credential is written to
// its ONE home via bmc_ipmi_set_user_password (the shared write goes through the IPMI user, so there is still
// a single stored password); for a dedicated account it is written in the record. A write to an account the
// Redfish surface does not serve changes nothing and is not completed. The failed-login counter resets on a
// completed change. `completed` is the world's fact about whether the account existed -- the caller's
// re-read, not this reply, decides whether the account is secured (DESIGN 4b rung discipline).
type BmcRedfishPasswordChangeStep {
  world: BmcWorld
  completed: Bool
}

fn bmc_redfish_change_password(world: BmcWorld, name: String, new_password: String) -> BmcRedfishPasswordChangeStep {
  match bmc_redfish_account(world: world, name: name) {
    Absent => BmcRedfishPasswordChangeStep { world: world, completed: false }
    Present { value: account } =>
      let cleared = match account {
        BmcRedfishAccountSharesIpmi { name: n, ipmi_user: i, role: r, enabled: e, locked: l } =>
          BmcRedfishAccountSharesIpmi { name: n, ipmi_user: i, role: r, enabled: e, locked: l, forced_password_change: false, failed_logins: 0 }
        BmcRedfishAccountOwnCredential { name: n, role: r, enabled: e, locked: l } =>
          BmcRedfishAccountOwnCredential { name: n, password: new_password, role: r, enabled: e, locked: l, forced_password_change: false, failed_logins: 0 }
      }
      let with_accounts = bmc_with_redfish_accounts(
        world: world,
        accounts: map(bmc_redfish_census(world: world), a => if bmc_redfish_account_name(account: a) == name { cleared } else { a }),
      )
      match account {
        BmcRedfishAccountSharesIpmi { ipmi_user: i } =>
          let wrote = bmc_ipmi_set_user_password(world: with_accounts, user: i, password: new_password)
          BmcRedfishPasswordChangeStep { world: wrote.world, completed: wrote.completed }
        BmcRedfishAccountOwnCredential { password: _ } =>
          BmcRedfishPasswordChangeStep { world: with_accounts, completed: true }
      }
  }
}

// THE FAILED-LOGIN COUNTER is the world's; the SERVED threshold that decides when it locks is declared by
// the lockout lane in extdeps.bmc.redfish (RedfishAccountServiceLockoutServed: AccountLockoutThreshold), NOT
// here. Until that shape lands the threshold is supplied by the caller and `0` means NEVER lock -- the
// lockout lane's upstream-grounded rule (a threshold of 0 means the account shall never be locked), cited
// there, not inferred here. So a build that serves no lockout is modelled without inventing a threshold, and
// a build that does reaches the lock only through a threshold the lockout lane declared. PROSE FRONTIER:
// when RedfishAccountServiceLockoutServed lands, the caller passes its account_lockout_threshold here and this
// comment is replaced by the read; the trigger is that shape landing on main.
type BmcRedfishFailedLoginStep {
  world: BmcWorld
  locked_now: Bool
}

fn bmc_redfish_note_failed_login(world: BmcWorld, name: String, at_lockout_threshold: Int) -> BmcRedfishFailedLoginStep {
  match bmc_redfish_account(world: world, name: name) {
    Absent => BmcRedfishFailedLoginStep { world: world, locked_now: false }
    Present { value: account } =>
      let count = bmc_redfish_account_failed_logins(account: account) + 1
      let should_lock = at_lockout_threshold != 0 && count >= at_lockout_threshold
      let bumped = match account {
        BmcRedfishAccountSharesIpmi { name: n, ipmi_user: i, role: r, enabled: e, locked: l, forced_password_change: f } =>
          BmcRedfishAccountSharesIpmi { name: n, ipmi_user: i, role: r, enabled: e, locked: l || should_lock, forced_password_change: f, failed_logins: count }
        BmcRedfishAccountOwnCredential { name: n, password: p, role: r, enabled: e, locked: l, forced_password_change: f } =>
          BmcRedfishAccountOwnCredential { name: n, password: p, role: r, enabled: e, locked: l || should_lock, forced_password_change: f, failed_logins: count }
      }
      BmcRedfishFailedLoginStep {
        world: bmc_with_redfish_accounts(
          world: world,
          accounts: map(bmc_redfish_census(world: world), a => if bmc_redfish_account_name(account: a) == name { bumped } else { a }),
        ),
        locked_now: should_lock,
      }
  }
}
