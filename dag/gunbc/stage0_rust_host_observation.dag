module gunbc.stage0_rust_host_observation

import std.algebra { trim }

import extdeps.git
import gunbc.output_policy { ExpectSuccess }
import gunbc.repo_identity { gunbc_merge_target_ref }
import gunbc.seed_growth { SeedGrowthJustification }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.stage0_cargo_manifest {
  CargoManifestBinParse,
  CargoManifestBinsParsed,
  CargoManifestBinsParseRefused,
  stage0_cargo_toml_repo_path,
  stage0_package_root
}
import std.content_hash { Fnv1a64Structural, content_hash_atom }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, RealizationDispatch, Scaffold }
import std.types { CommitSha, GitRef, String }
import v2.std.algebra { fold_list, list_snoc_item }
import v2.std.collection { List }

data stage0_rust_host_observation_note: String = "Rust-source OBSERVATION prerequisite only; lifecycle totality remains downstream in gunbc.stage0_rust_source_lifecycle_scaffold / v1-honest-frontier. extdeps.git owns the Git operation shapes. This module supplies repository policy (HEAD versus gunbc_merge_target_ref), filters the exact revision-addressed path population, normalizes authored Cargo target paths, hashes the exact manifest text through std.content_hash, and joins those facts. The temporary Rust seed owns only TOML decoding into CargoManifestBinParse plus its interpreter projection. CargoBin is a source role and cannot satisfy a maintenance disposition."

type RustSourceHostObservation
  = RustManifestObserved {
      repository_revision: CommitSha,
      manifest_content_identity: Fnv1a64Structural,
      tracked_rust_repo_paths: List<String>,
      prior_tracked_rust_repo_paths: List<String>,
      cargo_bin_repo_paths: List<String>
    }
  | RustManifestReadRefused { detail: String }
  | RustManifestParseRefused { detail: String }
  | GitObservationRefused { detail: String }

type CargoBinRepoPathProjection
  = CargoBinRepoPathProjected { path: String }
  | CargoBinRepoPathProjectionRefused { authored_path: String, detail: String }

type CargoBinRepoPathsProjection
  = CargoBinRepoPathsProjected { paths: List<String> }
  | CargoBinRepoPathsProjectionRefused { authored_path: String, detail: String }

fn git_refusal_detail(operation: String, stderr: String) -> String {
  let detail = trim(stderr)
  if detail == "" {
    concat(operation, " refused without stderr")
  } else {
    concat(operation, concat(": ", detail))
  }
}

fn rust_paths_from_nul(raw: String) -> List<String> {
  filter(
    xs: split(s: raw, delimiter: from_code_point(0)),
    predicate: fn(path) {
      let n = string_length(s: path)
      n >= 3 && substring(s: path, start: n - 3, end: n) == ".rs"
    }
  )
}

fn cargo_path_has_parent_segment(path: String) -> Bool {
  string_contains(s: concat("/", concat(path, "/")), pattern: "/../")
}

fn normalize_cargo_bin_repo_path(package_root: String, authored_path: String) -> CargoBinRepoPathProjection {
  if authored_path == "" {
    CargoBinRepoPathProjectionRefused {
      authored_path: authored_path,
      detail: "Cargo [[bin]].path is empty"
    }
  } else if starts_with(s: authored_path, prefix: "/")
    || string_contains(s: authored_path, pattern: "\\")
    || cargo_path_has_parent_segment(path: authored_path) {
    CargoBinRepoPathProjectionRefused {
      authored_path: authored_path,
      detail: "Cargo [[bin]].path escapes or is not a canonical repository-relative slash path"
    }
  } else {
    let segments = filter(
      xs: split(s: authored_path, delimiter: "/"),
      predicate: fn(segment) { segment != "" && segment != "." }
    )
    let normalized = join(segments, "/")
    if normalized == "" {
      CargoBinRepoPathProjectionRefused {
        authored_path: authored_path,
        detail: "Cargo [[bin]].path has no path segments"
      }
    } else {
      CargoBinRepoPathProjected { path: concat(package_root, normalized) }
    }
  }
}

fn normalize_cargo_bin_repo_paths(
  package_root: String,
  authored_paths: List<String>
) -> CargoBinRepoPathsProjection {
  fold_list(
    xs: authored_paths,
    empty: CargoBinRepoPathsProjected { paths: [] },
    cons: fn(acc, authored_path) {
      match acc {
        CargoBinRepoPathsProjectionRefused { authored_path: refused, detail: detail } =>
          CargoBinRepoPathsProjectionRefused { authored_path: refused, detail: detail }
        CargoBinRepoPathsProjected { paths: paths } =>
          match normalize_cargo_bin_repo_path(
            package_root: package_root,
            authored_path: authored_path
          ) {
            CargoBinRepoPathProjectionRefused { authored_path: refused, detail: detail } =>
              CargoBinRepoPathsProjectionRefused { authored_path: refused, detail: detail }
            CargoBinRepoPathProjected { path: path } =>
              CargoBinRepoPathsProjected { paths: list_snoc_item(xs: paths, item: path) }
          }
      }
    }
  )
}

fn observe_stage0_rust_sources(
  manifest_repo_path: String,
  package_root: String,
  base_ref: String
) -> RustSourceHostObservation {
  let head = git.Inspect.HeadCommit(expect: ExpectSuccess)
  if !head.success || (head.sha as String) == "" {
    GitObservationRefused { detail: "git.Inspect.HeadCommit refused or returned an empty revision" }
  } else {
    let revision = head.sha as String
    let baseline = git.Inspect.MergeBase(
      left: revision as GitRef,
      right: base_ref as GitRef,
      expect: ExpectSuccess
    )
    if !baseline.success || (baseline.sha as String) == "" {
      GitObservationRefused {
        detail: git_refusal_detail(operation: "git.Inspect.MergeBase", stderr: baseline.stderr)
      }
    } else {
      let current_tree = git.Inspect.ListTreePathsAtRevision(
        ref: revision as GitRef,
        expect: ExpectSuccess
      )
      if !current_tree.success {
        GitObservationRefused {
          detail: git_refusal_detail(
            operation: "git.Inspect.ListTreePathsAtRevision(HEAD)",
            stderr: current_tree.stderr
          )
        }
      } else {
        let prior_tree = git.Inspect.ListTreePathsAtRevision(
          ref: baseline.sha as GitRef,
          expect: ExpectSuccess
        )
        if !prior_tree.success {
          GitObservationRefused {
            detail: git_refusal_detail(
              operation: "git.Inspect.ListTreePathsAtRevision(merge-base)",
              stderr: prior_tree.stderr
            )
          }
        } else {
          let manifest = git.Core.Show(
            ref: revision as GitRef,
            path: manifest_repo_path,
            expect: ExpectSuccess
          )
          if !manifest.success {
            RustManifestReadRefused {
              detail: git_refusal_detail(operation: "git.Core.Show(manifest)", stderr: manifest.stderr)
            }
          } else {
            match parse_stage0_cargo_manifest_bins(manifest: manifest.content) {
              CargoManifestBinsParseRefused { detail: detail } =>
                RustManifestParseRefused { detail: detail }
              CargoManifestBinsParsed { authored_relative_paths: authored_paths } =>
                match normalize_cargo_bin_repo_paths(
                  package_root: package_root,
                  authored_paths: authored_paths
                ) {
                  CargoBinRepoPathsProjectionRefused { authored_path: authored_path, detail: detail } =>
                    RustManifestParseRefused {
                      detail: concat(
                        "Cargo [[bin]].path ",
                        concat(authored_path, concat(" refused: ", detail))
                      )
                    }
                  CargoBinRepoPathsProjected { paths: cargo_bin_repo_paths } =>
                    RustManifestObserved {
                      repository_revision: revision,
                      manifest_content_identity: content_hash_atom(value: manifest.content),
                      tracked_rust_repo_paths: rust_paths_from_nul(raw: current_tree.paths_nul),
                      prior_tracked_rust_repo_paths: rust_paths_from_nul(raw: prior_tree.paths_nul),
                      cargo_bin_repo_paths: cargo_bin_repo_paths
                    }
                }
            }
          }
        }
      }
    }
  }
}

data host_observation_invocation_note: String = "THIS IS A FUNCTION AND NOT A TOP-LEVEL data BY CONSTRUCTION, WHICH IS THE WALL AND NOT A STYLE PREFERENCE. It was `data rust_source_host_observation = observe_stage0_rust_sources(...)`, and a top-level data declaration is EVALUATED WHEN A MODULE IMPORTS IT. So every module that named the symbol in an import list performed Git I/O as a consequence of loading, whether or not it used the value.\n\nThat is not hypothetical: it happened. A witness file kept the symbol in its import list after the three functions using it had moved to another file, and the dead import alone reached git.Inspect.HeadCommit under the hermetic envelope, refused, and failed the entire per-PR discovery batch of 105 rows -- on a file whose test bodies no longer touched the observation at all. Deleting the import fixed that incident. It did not fix the class, because the next module to import the symbol would have done the same thing, and nothing would have stopped it.\n\nAs a function the effect is reachable only by CALLING it. A module may import the RustSourceHostObservation coproduct, the path normalizers, and the verdict fold without observing the host, because none of those are this function. The wet entry calls it deliberately; the hermetic lane cannot reach the effect by importing anything. This is the DESIGN section 5 construction-over-validation move: documenting that imports evaluate live data does not stop the next import from doing so, and the determinism thread is the standing reminder that silence is not a wall.\n\nThe injection boundary is kept rather than replaced: rust_source_manifest_state_verdict(observation) still takes the observation as a parameter, so every consumer of the verdict remains pure and testable against constructed observations."

fn current_stage0_rust_source_observation() -> RustSourceHostObservation {
  observe_stage0_rust_sources(
    manifest_repo_path: stage0_cargo_toml_repo_path,
    package_root: stage0_package_root,
    base_ref: gunbc_merge_target_ref as String
  )
}

data stage0_cargo_manifest_parser_seed_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v1_compiler.cli_run",
    decl_name: "parse_stage0_cargo_manifest_bin_paths",
    field: WholeDeclaration
  }
}

data stage0_cargo_manifest_projection_seed_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v1_compiler.v1_interpreter",
    decl_name: "eval_builtin_inner",
    field: WholeDeclaration
  }
}

data stage0_rust_observation_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
      decl_name: "Stage0CargoManifestBinParse",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
      decl_name: "Stage0CargoBinManifestParseRefusal",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
      decl_name: "stage0_cargo_bin_paths_from_manifest_text",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
      decl_name: "parse_stage0_cargo_manifest_bin_paths",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
      decl_name: "stage0_cargo_manifest_parser_tests",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.v1_interpreter",
      decl_name: "eval_builtin_inner",
      field: WholeDeclaration
    }
  ],
  reason: "The substrate can execute modeled Git operations and own path policy, but it cannot yet decode Cargo TOML into typed [[bin]] facts. The seed parser and value projection are the bounded compatibility bridge; generated builtin registry output is not hand-authored growth, which is why the v1_compiler_infer_method.rs delta is absent from this census -- that file is claimed by the derived generated population (gunbc.stage0_rust_source_lifecycle_scaffold derived_generated_stage0_repo_paths) and is regenerated from src/v1/04_method.dag rather than authored. (This clause formerly cited gunbc.stage0_emit_model generated_stage0_files -- a module path that had ALREADY been deleted when it was written, so the citation named nothing; it is repointed at the live derivation rather than at a second dead roster.)\n\nAN EARLIER REVISION OF THIS ROW LISTED TWO DECLARATIONS AND WAS WRONG. The count is recorded here rather than quietly corrected because it is the precise failure this receipt exists to prevent. It named the two declarations someone had looked at -- the seed parser entry point and the interpreter arm -- and omitted the coproduct Stage0CargoManifestBinParse, the refusal enum Stage0CargoBinManifestParseRefusal, the Display realization on that refusal enum, the private helper stage0_cargo_bin_paths_from_manifest_text, and the stage0_cargo_manifest_parser_tests module. A witness then pinned the census at exactly two, so the understatement was enshrined as the contract instead of being exposed by it. The census is now taken by ENUMERATING every hand-authored declaration this change adds to the seed, which is the only method that does not silently understate: counting the declarations one happens to have touched is how a census goes wrong twice.\n\nTHE SEVENTH ITEM IS REAL BUT NOT CITABLE, AND THAT IS RECORDED HERE RATHER THAN FORCED INTO A FIELD IT IS NOT. The hand-authored surface this change adds is seven Rust items; the list above carries six. The missing one is the Display realization named above: `impl std::fmt::Display for Stage0CargoBinManifestParseRefusal`, an item in its own right and not part of the enum declaration already cited. std.decl_ref DeclField offers exactly WholeDeclaration or NamedField, and a trait-impl method is neither -- the impl block has no name, and fmt is a method on it, not a field of the enum, which has three unit variants and no fields at all. Two earlier revisions each tried to make the vocabulary say it anyway: the first invented the symbol Stage0CargoBinManifestParseRefusal_Display, which resolves to nothing (review 46351); the second wrote a NamedField citing fmt, which type-checks and greps clean while asserting a field that does not exist (review 46383). Both are one defect -- a citation shaped to fit the carrier rather than the code -- and the second is the DESIGN 5 workaround class exactly: the obstacle was the vocabulary, and respelling around it concealed that instead of stopping the line. So the row is dropped, the citable count is six, and the seventh is named here in prose where it is at least true; scaffold_host_observation_hand_rust_receipt_is_bounded asserts both the six and this paragraph, so the item cannot go missing by someone editing the list alone. Dissolve-on: DeclField gains a variant naming a trait-impl method, at which point this paragraph deletes and the row returns. That is a corpus-wide std change -- 161 modules import std.decl_ref and several match DeclField exhaustively -- so it is deliberately not carried here, and saying so is the honest boundary rather than a reason to fabricate a seventh row.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete all seven declarations when a modeled Cargo-manifest grammar/ingestion realization produces CargoManifestBinParse, or when the v1 interpreter and cli_run seed retire.",
  current_boundary: "gunbc.stage0_cargo_manifest CargoManifestBinParse -> v1_compiler.cli_run parse_stage0_cargo_manifest_bin_paths -> v1_compiler.v1_interpreter eval_builtin_inner"
}
