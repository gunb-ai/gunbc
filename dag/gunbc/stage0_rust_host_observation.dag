module gunbc.stage0_rust_host_observation

import extdeps.git
import gunbc.output_policy { OutcomeIsData }
import gunbc.repo_identity { gunbc_merge_target_ref }
import gunbc.roadmap_authority { SeedGrowthJustification }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.stage0_cargo_manifest {
  CargoManifestBinParse,
  CargoManifestBinsParsed,
  CargoManifestBinsParseRefused,
  stage0_cargo_toml_repo_path,
  stage0_package_root
}
import std.content_hash { content_hash_atom }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, RealizationDispatch, Scaffold }
import std.types { GitRef, String }
import v2.std.algebra { fold_list, list_snoc_item }
import v2.std.collection { List }

data stage0_rust_host_observation_note: String = "Rust-source OBSERVATION prerequisite only; lifecycle totality remains downstream in gunbc.stage0_rust_source_lifecycle_scaffold / v1-honest-frontier. extdeps.git owns the Git operation shapes. This module supplies repository policy (HEAD versus gunbc_merge_target_ref), filters the exact revision-addressed path population, normalizes authored Cargo target paths, hashes the exact manifest text through std.content_hash, and joins those facts. The temporary Rust seed owns only TOML decoding into CargoManifestBinParse plus its interpreter projection. CargoBin is a source role and cannot satisfy a maintenance disposition."

type RustSourceHostObservation
  = RustManifestObserved {
      repository_revision: String,
      manifest_digest: String,
      tracked_rust_repo_paths: List<String>,
      prior_tracked_rust_repo_paths: List<String>,
      cargo_bin_repo_paths: List<String>
    }
  | RustManifestReadRefused { detail: String }
  | RustManifestParseRefused { detail: String }
  | GitObservationRefused { detail: String }

type CargoBinRepoPathProjection
  = CargoBinRepoPathProjected { path: String }
  | CargoBinRepoPathProjectionRefused { authored_path: String, detail: String }

type CargoBinRepoPathsProjection
  = CargoBinRepoPathsProjected { paths: List<String> }
  | CargoBinRepoPathsProjectionRefused { authored_path: String, detail: String }

fn git_refusal_detail(operation: String, stderr: String) -> String {
  let detail = trim(stderr)
  if detail == "" {
    concat(operation, " refused without stderr")
  } else {
    concat(operation, concat(": ", detail))
  }
}

fn rust_paths_from_nul(raw: String) -> List<String> {
  filter(
    xs: split(s: raw, delimiter: from_code_point(0)),
    predicate: fn(path) {
      let n = string_length(s: path)
      n >= 3 && substring(s: path, start: n - 3, end: n) == ".rs"
    }
  )
}

fn cargo_path_has_parent_segment(path: String) -> Bool {
  string_contains(s: concat("/", concat(path, "/")), pattern: "/../")
}

fn normalize_cargo_bin_repo_path(package_root: String, authored_path: String) -> CargoBinRepoPathProjection {
  if authored_path == "" {
    CargoBinRepoPathProjectionRefused {
      authored_path: authored_path,
      detail: "Cargo [[bin]].path is empty"
    }
  } else if starts_with(s: authored_path, prefix: "/")
    || string_contains(s: authored_path, pattern: "\\")
    || cargo_path_has_parent_segment(path: authored_path) {
    CargoBinRepoPathProjectionRefused {
      authored_path: authored_path,
      detail: "Cargo [[bin]].path escapes or is not a canonical repository-relative slash path"
    }
  } else {
    let segments = filter(
      xs: split(s: authored_path, delimiter: "/"),
      predicate: fn(segment) { segment != "" && segment != "." }
    )
    let normalized = join(segments, "/")
    if normalized == "" {
      CargoBinRepoPathProjectionRefused {
        authored_path: authored_path,
        detail: "Cargo [[bin]].path has no path segments"
      }
    } else {
      CargoBinRepoPathProjected { path: concat(package_root, normalized) }
    }
  }
}

fn normalize_cargo_bin_repo_paths(
  package_root: String,
  authored_paths: List<String>
) -> CargoBinRepoPathsProjection {
  fold_list(
    xs: authored_paths,
    empty: CargoBinRepoPathsProjected { paths: [] },
    cons: fn(acc, authored_path) {
      match acc {
        CargoBinRepoPathsProjectionRefused { authored_path: refused, detail: detail } =>
          CargoBinRepoPathsProjectionRefused { authored_path: refused, detail: detail }
        CargoBinRepoPathsProjected { paths: paths } =>
          match normalize_cargo_bin_repo_path(
            package_root: package_root,
            authored_path: authored_path
          ) {
            CargoBinRepoPathProjectionRefused { authored_path: refused, detail: detail } =>
              CargoBinRepoPathsProjectionRefused { authored_path: refused, detail: detail }
            CargoBinRepoPathProjected { path: path } =>
              CargoBinRepoPathsProjected { paths: list_snoc_item(xs: paths, item: path) }
          }
      }
    }
  )
}

fn observe_stage0_rust_sources(
  manifest_repo_path: String,
  package_root: String,
  base_ref: String
) -> RustSourceHostObservation {
  let head = git.Inspect.HeadCommit(expect: OutcomeIsData)
  if !head.success || (head.sha as String) == "" {
    GitObservationRefused { detail: "git.Inspect.HeadCommit refused or returned an empty revision" }
  } else {
    let revision = head.sha as String
    let baseline = git.Inspect.MergeBase(
      left: revision as GitRef,
      right: base_ref as GitRef,
      expect: OutcomeIsData
    )
    if !baseline.success || (baseline.sha as String) == "" {
      GitObservationRefused {
        detail: git_refusal_detail(operation: "git.Inspect.MergeBase", stderr: baseline.stderr)
      }
    } else {
      let current_tree = git.Inspect.ListTreePathsAtRevision(
        ref: revision as GitRef,
        expect: OutcomeIsData
      )
      if !current_tree.success {
        GitObservationRefused {
          detail: git_refusal_detail(
            operation: "git.Inspect.ListTreePathsAtRevision(HEAD)",
            stderr: current_tree.stderr
          )
        }
      } else {
        let prior_tree = git.Inspect.ListTreePathsAtRevision(
          ref: baseline.sha as GitRef,
          expect: OutcomeIsData
        )
        if !prior_tree.success {
          GitObservationRefused {
            detail: git_refusal_detail(
              operation: "git.Inspect.ListTreePathsAtRevision(merge-base)",
              stderr: prior_tree.stderr
            )
          }
        } else {
          let manifest = git.Core.Show(
            ref: revision as GitRef,
            path: manifest_repo_path,
            expect: OutcomeIsData
          )
          if !manifest.success {
            RustManifestReadRefused {
              detail: git_refusal_detail(operation: "git.Core.Show(manifest)", stderr: manifest.stderr)
            }
          } else {
            match parse_stage0_cargo_manifest_bins(manifest: manifest.content) {
              CargoManifestBinsParseRefused { detail: detail } =>
                RustManifestParseRefused { detail: detail }
              CargoManifestBinsParsed { authored_relative_paths: authored_paths } =>
                match normalize_cargo_bin_repo_paths(
                  package_root: package_root,
                  authored_paths: authored_paths
                ) {
                  CargoBinRepoPathsProjectionRefused { authored_path: authored_path, detail: detail } =>
                    RustManifestParseRefused {
                      detail: concat(
                        "Cargo [[bin]].path ",
                        concat(authored_path, concat(" refused: ", detail))
                      )
                    }
                  CargoBinRepoPathsProjected { paths: cargo_bin_repo_paths } =>
                    RustManifestObserved {
                      repository_revision: revision,
                      manifest_digest: content_hash_atom(value: manifest.content) as String,
                      tracked_rust_repo_paths: rust_paths_from_nul(raw: current_tree.paths_nul),
                      prior_tracked_rust_repo_paths: rust_paths_from_nul(raw: prior_tree.paths_nul),
                      cargo_bin_repo_paths: cargo_bin_repo_paths
                    }
                }
            }
          }
        }
      }
    }
  }
}

data rust_source_host_observation: RustSourceHostObservation = observe_stage0_rust_sources(
  manifest_repo_path: stage0_cargo_toml_repo_path,
  package_root: stage0_package_root,
  base_ref: gunbc_merge_target_ref as String
)

data stage0_cargo_manifest_parser_seed_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v1_compiler.cli_run",
    decl_name: "parse_stage0_cargo_manifest_bin_paths",
    field: WholeDeclaration
  }
}

data stage0_cargo_manifest_projection_seed_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v1_compiler.v1_interpreter",
    decl_name: "eval_builtin_inner",
    field: WholeDeclaration
  }
}

data stage0_rust_observation_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
      decl_name: "parse_stage0_cargo_manifest_bin_paths",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.v1_interpreter",
      decl_name: "eval_builtin_inner",
      field: WholeDeclaration
    }
  ],
  reason: "The substrate can execute modeled Git operations and own path policy, but it cannot yet decode Cargo TOML into typed [[bin]] facts. The seed parser and value projection are the bounded compatibility bridge; generated builtin registry output is not hand-authored growth.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete both declarations when a modeled Cargo-manifest grammar/ingestion realization produces CargoManifestBinParse, or when the v1 interpreter and cli_run seed retire.",
  current_boundary: "gunbc.stage0_cargo_manifest CargoManifestBinParse -> v1_compiler.cli_run parse_stage0_cargo_manifest_bin_paths -> v1_compiler.v1_interpreter eval_builtin_inner"
}
