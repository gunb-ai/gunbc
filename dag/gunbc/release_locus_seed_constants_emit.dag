module gunbc.release_locus_seed_constants_emit

import extdeps.languages.rust.string_literal { escape_rust_cooked_string_literal_body }
import gunbc.cli_run_workspace_root_scaffold {
  gunbc_workspace_root_env_name, release_locus_tree_receipt_name,
}
import std.types { String }

// THE RELEASE LOCUS CONTRACT'S TWO SPELLINGS, PROJECTED INTO THE SEED SO THE SEED STOPS
// TRANSCRIBING THEM.
//
// The env var name and the tree-receipt file name are ONE fact each, and each had two authors: the
// .dag rows that the emitter renders into the release-locus unit
// (gunbc.live_deploy.emit release_locus_workspace_root_environment,
// approval_broker_tree_receipt_path_for) and a `const` of the same spelling hand-written in
// src/v1/stage0/src/cli_run.rs. Nothing joined them. If either side moved alone, the emitted unit
// would set one name and the binary would read the other, and every release-locus unit would exit
// 101 in workspace_root at start -- the exact failure the spawn-root arm exists to repair, measured
// live on srv1 2026-09-21.
//
// WHY THIS AND NOT A WITNESS THAT READS cli_run.rs. A check over two independently-authored
// literals can only ever be a drift DETECTOR, and it detects after the fork already exists. This
// removes the second author instead: the seed references the generated const, so a spelling that
// moves on the .dag side moves in the seed at the next regen, and one that is hand-edited in the
// generated file is refused by the generated-artifact drift wall. Construction over validation
// (DESIGN section 5) -- and the same reasoning gunbc.evaluation_budget_consequence_emit records for
// refusing a runtime read of the .dag applies unchanged here.
//
// WHY A DEDICATED ARTIFACT. Its subject is the release-locus spawn contract. Appending these two
// consts to an existing generated module whose subject is something else would be the DESIGN
// section 3 fork wearing a generated file's clothes, which that module's own note names.
//
// THE LITERALS BELOW ARE NOT AUTHORED HERE. This emitter evaluates the two rows and escapes the
// results; neither "GUNBC_WORKSPACE_ROOT" nor ".gunbc-tree-receipt" appears anywhere in this
// module. An emitter that spelled either value in its own template would be a third authority, and
// the authority-movement falsifier -- change the row, regenerate, require the new value in the
// generated Rust and zero occurrences of the old one -- would pass while proving nothing.
fn expected_release_locus_seed_constants_generated_rs() -> String {
  concat(
    concat(
      "// Generated by gunbc release_locus_seed_constants_emit — do not hand-edit.\n",
      "// Authority: gunbc.cli_run_workspace_root_scaffold gunbc_workspace_root_env_name and\n// release_locus_tree_receipt_name. The release-locus spawn contract's two spellings, projected\n// so the seed reads them rather than transcribing them: regenerate rather than edit.\n",
    ),
    concat(
      concat(
        "pub(crate) const GUNBC_WORKSPACE_ROOT_ENV: &str = \"",
        concat(escape_rust_cooked_string_literal_body(s: gunbc_workspace_root_env_name), "\";\n"),
      ),
      concat(
        "pub(crate) const RELEASE_LOCUS_TREE_RECEIPT_NAME: &str = \"",
        concat(escape_rust_cooked_string_literal_body(s: release_locus_tree_receipt_name), "\";\n"),
      ),
    ),
  )
}
