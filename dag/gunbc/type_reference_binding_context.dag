module gunbc.type_reference_binding_context


data type_reference_binding_context_path_scope_note: String = "PATH SCOPE (quiet-hawk-219 / calm-badger-682, DESIGN 4b): the coincidence-binding defect class exists on TWO structurally distinct paths. THIS slice closes the RESOLVE path only — v1 typecheck pool-membership coincidence where flat symbol_index_lookup / lookup_type_for hits masquerade as binding (Class B, section 14.1). EMIT-SIDE LIVE INSTANCE (explicitly OUT OF SLICE; fix owned by warm-wolf-814 — cite, do not fix): emit_var_ref / emit_value_ref_ident key the flat item_registry on LEAF NAME ONLY, so module_a.homonym_value can bind module_b's ItemInfo when both declare the same leaf. #7685 did not repair the cross-module same-leaf case; the collision is LIVE on main. #7705's detector cross_module_same_leaf_emits_qualifier_module_not_registry_winner is RED on main (run 30769280389 at 2383069da) — bottom rung: invalid state occurs, detector exists, detection is not prevention. Emit maintains its own registry key and never consults this containment authority. Second grounded specimen of binding-by-insufficient-key on an independent stage; unlike resolve, not instrument-relative (one reproducible witness, positive and negative arms). Any claim that 'binding is now decided by containment' without 'on the resolve path' is rung inflation. Whether emit later consumes containment authority is a follow-on question, not N2."

data type_reference_binding_context_pr_b_motivation_note: String = "PR-B motivation (resolve path): Class B pool-membership coincidence on masked type leaves — parallel independent specimen to the emit-side live instance above (#7705 RED control). Closing resolve via containment kernel + resolve_node_bounded changeover is the slice-2 obligation; emit-side repair is warm-wolf-814's subtree."

data type_reference_binding_context_pr_b_hardening_note: String = "PR-B hardening conditions (quiet-hawk-219, bind under codex outage): (1) EQUIVALENCE RECEIPT — discriminating production corpus where legacy masked-leaf path and containment-switched path both run and agree; every disagreement arm enumerated and explained as a fixed defect of the old path (not only new-path witnesses). Cross-module coverage required — same-module-only is insufficient; bar includes authored imports no longer deciding binding and removing one now-redundant import changing nothing. (2) FAIL-CLOSED — refusal or typed diagnostic on the new path; never silent fallback to lookup_type_for when containment cannot answer (absorbing arm forbidden). (3) RUNG WORDING — binding decided by containment ONLY on the resolve path switched; emit keys flat item_registry on leaf name alone, untouched by dag/std containment binding, LIVE red detector on main (#7705); unscoped closure claims are rung inflation (DESIGN 4b minimum-across-paths). Authority: dag/test/claim/type_reference_resolve_changeover_equivalence_witness_test.dag."

type TypeReferenceBindingContext {
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
}

data type_reference_binding_context_absent_note: String = "Absent TypeReferenceBindingContext on resolve_node_bounded preserves the legacy lookup path unchanged (quiet-hawk-219 ruling 2). PR-B wires the masked leaf arm only when context is Present."

data declaration_exposure_from_containment_tree_note: String = "Exposure derivation site (PR-A): reads containment prefix shape and module path only — never OccurrenceCategory, never symbol_index flat lookup, never hand-authored module rosters. Delegates to the single exposure authority std.occurrence_binding_candidates declaration_exposure_from_containment under NamespaceStructuralRootExposure grounding (N3-B0): empty ancestor chain => RootExposure (structural namespace root in the containment tree); single-ancestor chain => ModuleExposure for the declaring module; deeper nesting => LexicalExposure whose exposing_scope is the nearest ancestor containment prefix."

fn authored_order_row_from_entry(entry: std.occurrence_identity.OccurrenceIndexEntry) -> std.occurrence_binding_candidates.AuthoredOrderRow {
  std.occurrence_binding_candidates.AuthoredOrderRow {
    occurrence: entry.projection.occurrence,
    ordinal: std.occurrence_identity.AuthoredTokenOrdinal {
      value: entry.projection.diagnostic_span.start,
    },
  }
}

fn occurrence_binding_inputs_from_module_transport(
  module_path: std.types.NonEmptyStr,
  transport: std.occurrence_identity.OccurrenceTransport
) -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
    module_paths: reverse(fold(
      transport.index.entries,
      init: [],
      f: (acc, entry) =>
        concat([
          std.occurrence_binding_candidates.OccurrenceModulePathRow {
            occurrence: entry.projection.occurrence,
            module_path: module_path,
          },
        ], acc),
    )),
    exposure_rows: reverse(fold(
      transport.declarations,
      init: [],
      f: (acc, declaration) =>
        concat([
          std.occurrence_binding_candidates.DeclarationExposureRow {
            occurrence: declaration.occurrence,
            exposure: std.occurrence_binding_candidates.declaration_exposure_from_containment(
              module_path: module_path,
              containment: declaration.containment,
              grounding: std.occurrence_binding_candidates.NamespaceStructuralRootExposure,
            ),
          },
        ], acc),
    )),
    authored_order_rows: reverse(fold(
      transport.index.entries,
      init: [],
      f: (acc, entry) =>
        concat([authored_order_row_from_entry(entry: entry)], acc),
    )),
  }
}

fn merge_occurrence_binding_input_rows(
  left: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
  right: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs
) -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
    module_paths: concat(left.module_paths, right.module_paths),
    exposure_rows: concat(left.exposure_rows, right.exposure_rows),
    authored_order_rows: concat(left.authored_order_rows, right.authored_order_rows),
  }
}

type ModuleOccurrenceBindingSource {
  module_path: std.types.NonEmptyStr,
  transport: std.occurrence_identity.OccurrenceTransport,
}

fn build_graph_type_reference_binding_inputs(
  sources: List<ModuleOccurrenceBindingSource>
) -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  fold(
    sources,
    init: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
      module_paths: [],
      exposure_rows: [],
      authored_order_rows: [],
    },
    f: (acc, source) =>
      merge_occurrence_binding_input_rows(
        left: acc,
        right: occurrence_binding_inputs_from_module_transport(
          module_path: source.module_path,
          transport: source.transport,
        ),
      ),
  )
}

fn build_type_reference_binding_context(
  transport: std.occurrence_identity.OccurrenceTransport,
  sources: List<ModuleOccurrenceBindingSource>
) -> TypeReferenceBindingContext {
  TypeReferenceBindingContext {
    transport: transport,
    inputs: build_graph_type_reference_binding_inputs(sources: sources),
  }
}
