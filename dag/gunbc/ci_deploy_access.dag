module gunbc.ci_deploy_access

import std.types { NonEmptyStr, List, String, Bool }
import std.access { AccessDecision, Permit, Deny }
import std.disposition { Disposition, Scaffold, RealizationDispatch, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.materialization_ladder { Frame, SharedStateFrame }
import std.effect_grant { Grant, Envelope, verb_of_effect_shape, admit_effect, EffectAdmission, Admitted, EffectOutsideGrant }
import std.effects { ExecuteEffect }
import gunbc.fleet_intent { ComputeHost, srv1_host }
import gunbc.fleet_intent_network { operator_host_srv1 }
import gunbc.fleet_posix_accounts {
  GroundedPosixPrincipal,
  PosixSudoGrant,
  DeployRunnerPrincipal,
  FleetAccountCiRunner,
  FleetAccountOperator,
  srv1_ci_deploy_runner_principal,
  fleet_posix_principal,
  fleet_deploy_job_principal,
  grounded_posix_principal_name,
  fleet_apt_get_binary_path,
  posix_sudo_grant_to_effect_grant,
}
import gunbc.host_effect {
  HostEffect,
  ReadEffectivePosixPrincipal,
  SudoNopasswdExecuteProbe,
  SudoNopasswdGrantListProbe,
  HostEffectTransport,
  LocalShell,
  SshShell,
  EmitArtifactThenThinRun,
}
import extdeps.access.posix_effective_principal { EffectivePosixPrincipalRead }
import extdeps.sudo.nopasswd_execute_probe {
  SudoNopasswdExecuteProbeShape,
  SudoNopasswdGrantListProbeShape,
  NopasswdExecuteCheck,
  NopasswdGrantListCheck,
}
import gunbc.ci_deploy_target_host {
  DeployTargetHostProof,
  deploy_target_proof,
  deploy_target_host_preflight_block,
}

type PrivilegedCommand {
  grant: PosixSudoGrant
}

type DeployAccess {
  principal: GroundedPosixPrincipal
  host: ComputeHost
  transport: HostEffectTransport
  privileged_commands: List<PrivilegedCommand>
}

type DeployAccessJobPrincipalRefusal {
  job_user: NonEmptyStr
  runner: DeployRunnerPrincipal
}

type DeployAccessOrRefusal
  = DeployAccessReady { access: DeployAccess }
  | DeployAccessJobPrincipalRefused { refusal: DeployAccessJobPrincipalRefusal }

type DeployAccessActor {
  observed_name: NonEmptyStr
  sudo_granted: Bool
}

type DeployAuthorizationQuery {
  expected_principal: NonEmptyStr
  envelope: Envelope
}

data deploy_access_frame: Frame = Frame { name: "deploy", kind: SharedStateFrame }

data deploy_access_authorization_query_note: String = "Wave C (shell-intent-emit-realization-design.md): deploy-preflight is an AUTHORIZATION QUERY — the deploy frame requires the current principal to hold Execute grants over privileged command paths and to match the expected job principal (DeployRunnerPrincipal.job_user, never unit_user). Grants project from GroundedPosixPrincipal.sudo_grants via posix_sudo_grant_to_effect_grant (never a parallel grant vocabulary). Observation and typed-effect execution live in gunbc.ci_deploy_access_observe / gunbc.host_effect_realize at the runtime-present realization edge: present binaries use sudo.NopasswdExecuteProbe.Check; package-managed binaries that may not exist yet use sudo.NopasswdGrantListProbe.Check. The duplicate in-script gunbc.ci_deploy_access_emit path is deleted; gunbc.ci_deploy_sudoers remains the roster-derived sudoers materialization."

data deploy_access_refusal_prefix: String = "deploy_access: typed refusal before mutation"

data gunbc_deploy_sudoers_dropin: NonEmptyStr = "/etc/sudoers.d/gunbc-deploy"

data deploy_preflight_shell_header: String = "set -eu"

data deploy_access_apt_get_binary_path: NonEmptyStr = fleet_apt_get_binary_path

fn deploy_access_apt_get_privileged_command() -> PrivilegedCommand {
  PrivilegedCommand {
    grant: PosixSudoGrant {
      command_path: deploy_access_apt_get_binary_path,
      probe: NopasswdExecuteCheck { check_argv: "--help" },
    }
  }
}

fn posix_sudo_grant_to_privileged(g: PosixSudoGrant) -> PrivilegedCommand {
  PrivilegedCommand { grant: g }
}

fn grounded_principal_privileged_commands(p: GroundedPosixPrincipal) -> List<PrivilegedCommand> {
  map(p.sudo_grants, g => posix_sudo_grant_to_privileged(g: g))
}

data deploy_job_principal_unresolved_refusal_note: String = "fleet_deploy_job_principal Absent is a typed refusal — never silently map to FleetAccountCiRunner and never fabricate a GroundedPosixPrincipal (no uid=0/gid=0 root-in-disguise). live_deploy/emit threads ci_deploy_srv1_access_or_refusal: Absent → deploy_access_job_principal_refused_emit_poison (un-emittable shell); Present → normal pipeline. srv1 closed roster resolves via witness_srv1_job_principal_resolves_from_runner."

data deploy_job_principal_unresolved_emit_poison_prefix: String = "__GUNBC_DEPLOY_ACCESS_REFUSED__ job_user not in fleet roster — deploy shell is un-emittable"

fn deploy_access_job_principal_refused_emit_poison(refusal: DeployAccessJobPrincipalRefusal) -> String {
  concat(
    concat(concat(deploy_job_principal_unresolved_emit_poison_prefix, ": job_user="), refusal.job_user as String),
    concat(" unit_user=", refusal.runner.unit_user as String)
  )
}

fn deploy_access_or_refusal_for_runner(
  runner: DeployRunnerPrincipal,
  host: ComputeHost,
  transport: HostEffectTransport,
) -> DeployAccessOrRefusal {
  match fleet_deploy_job_principal(runner: runner) {
    Present { value: p } =>
      DeployAccessReady {
        access: DeployAccess {
          principal: p,
          host: host,
          transport: transport,
          privileged_commands: grounded_principal_privileged_commands(p: p),
        }
      }
    Absent =>
      DeployAccessJobPrincipalRefused {
        refusal: DeployAccessJobPrincipalRefusal {
          job_user: runner.job_user,
          runner: runner,
        }
      }
  }
}

fn ci_deploy_srv1_access_or_refusal() -> DeployAccessOrRefusal {
  deploy_access_or_refusal_for_runner(
    runner: srv1_ci_deploy_runner_principal,
    host: srv1_host,
    transport: LocalShell,
  )
}

data ci_deploy_srv1_access_roster_closure_note: String = "srv1 CI deploy access is roster-closed: witness_srv1_job_principal_resolves_from_runner proves fleet_deploy_job_principal(srv1_ci_deploy_runner_principal) == fleet_posix_principal(FleetAccountCiRunner). Authority is the roster row — never Optional-erase into a fabricated principal."

fn ci_deploy_srv1_local_access() -> DeployAccess {
  let principal = fleet_posix_principal(key: FleetAccountCiRunner)
  DeployAccess {
    principal: principal,
    host: srv1_host,
    transport: LocalShell,
    privileged_commands: grounded_principal_privileged_commands(p: principal),
  }
}

data ci_deploy_srv1_access: DeployAccess = ci_deploy_srv1_local_access()

fn ci_deploy_srv1_operator_ssh_access() -> DeployAccess {
  let principal = fleet_posix_principal(key: FleetAccountOperator)
  DeployAccess {
    principal: principal,
    host: srv1_host,
    transport: SshShell { ssh_host: operator_host_srv1 as NonEmptyStr },
    privileged_commands: grounded_principal_privileged_commands(p: principal),
  }
}

data ci_deploy_srv1_operator_access: DeployAccess = ci_deploy_srv1_operator_ssh_access()

fn deploy_access_sudoers_line(access: DeployAccess, cmd: PrivilegedCommand) -> String {
  concat(
    concat(grounded_posix_principal_name(p: access.principal) as String, " ALL=(ALL) NOPASSWD: "),
    cmd.grant.command_path
  )
}

fn deploy_target_proof_from_access(access: DeployAccess) -> DeployTargetHostProof {
  deploy_target_proof(host: access.host.identity, transport: access.transport)
}

fn deploy_target_host_preflight_script(access: DeployAccess) -> String {
  let proof = deploy_target_proof_from_access(access: access)
  concat(
    concat(concat(deploy_preflight_shell_header, "\n"), deploy_target_host_preflight_block(proof: proof)),
    ""
  )
}

fn deploy_access_with_ssh_transport(access: DeployAccess, ssh_host: NonEmptyStr) -> DeployAccess {
  DeployAccess {
    principal: access.principal,
    host: access.host,
    transport: SshShell { ssh_host: ssh_host },
    privileged_commands: access.privileged_commands,
  }
}

fn deploy_access_projected_grants(access: DeployAccess) -> List<Grant> {
  map(
    access.principal.sudo_grants,
    g => posix_sudo_grant_to_effect_grant(g: g)
  )
}

fn deploy_access_grant_envelope(access: DeployAccess) -> Envelope {
  Envelope {
    frame: deploy_access_frame,
    grants: deploy_access_projected_grants(access: access),
  }
}

fn deploy_access_authorization_query(access: DeployAccess) -> DeployAuthorizationQuery {
  DeployAuthorizationQuery {
    expected_principal: grounded_posix_principal_name(p: access.principal),
    envelope: deploy_access_grant_envelope(access: access),
  }
}

fn deploy_access_read_principal_effect() -> HostEffect {
  ReadEffectivePosixPrincipal { read: EffectivePosixPrincipalRead {} }
}

fn deploy_access_sudo_probe_effect(cmd: PrivilegedCommand) -> HostEffect {
  match cmd.grant.probe {
    NopasswdExecuteCheck { check_argv: check } =>
      SudoNopasswdExecuteProbe {
        probe: SudoNopasswdExecuteProbeShape {
          command_path: cmd.grant.command_path,
          check_argv: check,
        }
      }
    NopasswdGrantListCheck =>
      SudoNopasswdGrantListProbe {
        probe: cmd.grant.command_path as SudoNopasswdGrantListProbeShape
      }
  }
}

fn deploy_access_grant_admits_probe(
  access: DeployAccess,
  cmd: PrivilegedCommand
) -> EffectAdmission {
  let grant = posix_sudo_grant_to_effect_grant(g: cmd.grant)
  admit_effect(
    env: deploy_access_grant_envelope(access: access),
    verb: verb_of_effect_shape(shape: ExecuteEffect),
    target: grant.root
  )
}

data deploy_access_preflight_shell_disposition: Disposition = Terminal {
  reason: "deploy_access_preflight_script dissolved (Wave B): deploy-preflight is an authorization query + typed effect-plan, not a concat shell script. Authority: deploy_access_authorization_query + deploy_access_preflight_plan; observation: gunbc.ci_deploy_access_observe."
}

data deploy_access_preflight_plan_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.ci_deploy_access_observe",
    decl_name: "deploy_access_preflight_plan",
    field: WholeDeclaration
  }
}

fn deploy_access_privileged_fixture_actor(access: DeployAccess) -> DeployAccessActor {
  DeployAccessActor {
    observed_name: grounded_posix_principal_name(p: access.principal),
    sudo_granted: true,
  }
}

data deploy_access_unprivileged_fixture_principal: NonEmptyStr = "nobody"

fn deploy_access_unprivileged_fixture_actor() -> DeployAccessActor {
  DeployAccessActor { observed_name: deploy_access_unprivileged_fixture_principal, sudo_granted: false }
}

fn deploy_access_sudo_miss_reason(access: DeployAccess) -> String {
  let sample = access.privileged_commands.first()
  concat(
    concat(
      concat(deploy_access_refusal_prefix, " — privileged commands not granted (sudo -n preflight miss)\n"),
      concat(concat("Add to ", gunbc_deploy_sudoers_dropin), ":\n")
    ),
    deploy_access_sudoers_line(access: access, cmd: sample)
  )
}

fn deploy_access_check(access: DeployAccess, actor: DeployAccessActor) -> AccessDecision {
  let expected = grounded_posix_principal_name(p: access.principal)
  if actor.observed_name != expected {
    Deny {
      reason: Present {
        value: concat(
          concat(
            concat(deploy_access_refusal_prefix, " — principal mismatch expected="),
            expected
          ),
          concat(" actual=", actor.observed_name)
        )
      }
    }
  } else {
    if actor.sudo_granted {
      Permit
    } else {
      Deny {
        reason: Present {
          value: deploy_access_sudo_miss_reason(access: access)
        }
      }
    }
  }
}

fn deploy_access_decision_reason(d: AccessDecision) -> String {
  match d {
    Permit => ""
    Deny { reason: r } =>
      match r {
        Present { value: why } => why
        Absent => deploy_access_refusal_prefix
      }
  }
}

fn deploy_access_principal_line(success: Bool, stdout: String) -> NonEmptyStr? {
  if !success {
    none
  } else {
    let line = trim(stdout)
    if line == "" { none } else { Present { value: line as NonEmptyStr } }
  }
}

fn deploy_access_is_local_apply(access: DeployAccess) -> Bool {
  match access.transport {
    LocalShell => true
    SshShell { ssh_host: _ } => false
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => false
  }
}

fn deploy_access_preflight_pass_message(access: DeployAccess) -> String {
  concat(
    "deploy-access-preflight: PASS principal=",
    grounded_posix_principal_name(p: access.principal) as String
  )
}

fn srv1_live_deploy_privileged_commands() -> List<PrivilegedCommand> {
  grounded_principal_privileged_commands(
    p: fleet_posix_principal(key: FleetAccountCiRunner)
  )
}
