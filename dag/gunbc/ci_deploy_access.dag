module gunbc.ci_deploy_access



type PrivilegedCommand {
  grant: gunbc.fleet_posix_accounts.PosixSudoGrant
}

type DeployAccess {
  principal: gunbc.fleet_posix_accounts.GroundedPosixPrincipal
  host: gunbc.fleet_intent.ComputeHost
  transport: gunbc.host_effect.HostEffectTransport
  privileged_commands: List<PrivilegedCommand>
}

type DeployAccessJobPrincipalRefusal {
  job_user: std.types.NonEmptyStr
  runner: gunbc.fleet_posix_accounts.DeployRunnerPrincipal
}

type DeployAccessOrRefusal
  = DeployAccessReady { access: DeployAccess }
  | DeployAccessJobPrincipalRefused { refusal: DeployAccessJobPrincipalRefusal }

type DeployAccessActor {
  observed_name: std.types.NonEmptyStr
  sudo_granted: Bool
}

type DeployAuthorizationQuery {
  expected_principal: std.types.NonEmptyStr
  envelope: std.effect_grant.Envelope
}

data deploy_access_frame: std.materialization_ladder.Frame = std.materialization_ladder.Frame { name: "deploy", kind: SharedStateFrame }

data deploy_access_authorization_query_note: String = "Wave C (shell-intent-emit-realization-design.md): deploy-preflight is an AUTHORIZATION QUERY — the deploy frame requires the current principal to hold Execute grants over privileged command paths and to match the expected job principal (DeployRunnerPrincipal.job_user, never unit_user). Grants project from GroundedPosixPrincipal.sudo_grants via posix_sudo_grant_to_effect_grant (never a parallel grant vocabulary). Observation and typed-effect execution live in gunbc.ci_deploy_access_observe / gunbc.host_effect_realize at the runtime-present realization edge: present binaries use sudo.NopasswdExecuteProbe.Check; package-managed binaries that may not exist yet use sudo.NopasswdGrantList.Read plus an exact NOPASSWD-row check for the roster path. A successful list query alone is not authorization evidence. The duplicate in-script gunbc.ci_deploy_access_emit path is deleted; gunbc.ci_deploy_sudoers remains the roster-derived sudoers materialization."

data deploy_access_refusal_prefix: String = "deploy_access: typed refusal before mutation"

data gunbc_deploy_sudoers_dropin: std.types.NonEmptyStr = "/etc/sudoers.d/gunbc-deploy"

data deploy_preflight_shell_header: String = "set -eu"

data deploy_access_apt_get_binary_path: std.types.NonEmptyStr = fleet_apt_get_binary_path

fn deploy_access_apt_get_privileged_command() -> PrivilegedCommand {
  PrivilegedCommand {
    grant: gunbc.fleet_posix_accounts.PosixSudoGrant {
      command_path: deploy_access_apt_get_binary_path,
      probe: extdeps.sudo.nopasswd_execute_probe.NopasswdExecuteCheck { check_argv: "--help" },
    }
  }
}

fn posix_sudo_grant_to_privileged(g: gunbc.fleet_posix_accounts.PosixSudoGrant) -> PrivilegedCommand {
  PrivilegedCommand { grant: g }
}

fn grounded_principal_privileged_commands(p: gunbc.fleet_posix_accounts.GroundedPosixPrincipal) -> List<PrivilegedCommand> {
  map(p.sudo_grants, g => posix_sudo_grant_to_privileged(g: g))
}

// fleet_deploy_job_principal Absent is a typed refusal — never silently map to FleetAccountCiRunner and never fabricate a GroundedPosixPrincipal (no uid=0/gid=0 root-in-disguise). live_deploy/emit threads ci_deploy_srv1_access_or_refusal: Absent → deploy_access_job_principal_refused_emit_poison (un-emittable shell); Present → normal pipeline. srv1 closed roster resolves via witness_srv1_job_principal_resolves_from_runner.
data deploy_job_principal_unresolved_emit_poison_prefix: String = "__GUNBC_DEPLOY_ACCESS_REFUSED__ job_user not in fleet roster — deploy shell is un-emittable"

fn deploy_access_job_principal_refused_emit_poison(refusal: DeployAccessJobPrincipalRefusal) -> String {
  concat(
    concat(concat(deploy_job_principal_unresolved_emit_poison_prefix, ": job_user="), refusal.job_user as String),
    concat(" unit_user=", refusal.runner.unit_user as String)
  )
}

fn deploy_access_or_refusal_for_runner(
  runner: gunbc.fleet_posix_accounts.DeployRunnerPrincipal,
  host: gunbc.fleet_intent.ComputeHost,
  transport: gunbc.host_effect.HostEffectTransport,
) -> DeployAccessOrRefusal {
  match fleet_deploy_job_principal(runner: runner) {
    Present { value: p } =>
      DeployAccessReady {
        access: DeployAccess {
          principal: p,
          host: host,
          transport: transport,
          privileged_commands: grounded_principal_privileged_commands(p: p),
        }
      }
    Absent =>
      DeployAccessJobPrincipalRefused {
        refusal: DeployAccessJobPrincipalRefusal {
          job_user: runner.job_user,
          runner: runner,
        }
      }
  }
}

fn ci_deploy_srv1_access_or_refusal() -> DeployAccessOrRefusal {
  deploy_access_or_refusal_for_runner(
    runner: srv1_ci_deploy_runner_principal,
    host: srv1_host,
    transport: LocalShell,
  )
}

// srv1 CI deploy access is roster-closed: witness_srv1_job_principal_resolves_from_runner proves fleet_deploy_job_principal(srv1_ci_deploy_runner_principal) == fleet_posix_principal(FleetAccountCiRunner). Authority is the roster row — never Optional-erase into a fabricated principal.
fn ci_deploy_srv1_local_access() -> DeployAccess {
  let principal = fleet_posix_ci_runner_principal()
  DeployAccess {
    principal: principal,
    host: srv1_host,
    transport: LocalShell,
    privileged_commands: grounded_principal_privileged_commands(p: principal),
  }
}

data ci_deploy_srv1_access: DeployAccess = ci_deploy_srv1_local_access()

fn ci_deploy_srv1_operator_ssh_access() -> DeployAccess {
  let principal = fleet_posix_operator_principal()
  DeployAccess {
    principal: principal,
    host: srv1_host,
    transport: gunbc.host_effect.SshShell { ssh_host: operator_host_srv1 as std.types.NonEmptyStr },
    privileged_commands: grounded_principal_privileged_commands(p: principal),
  }
}

data ci_deploy_srv1_operator_access: DeployAccess = ci_deploy_srv1_operator_ssh_access()

fn deploy_access_sudoers_line(access: DeployAccess, cmd: PrivilegedCommand) -> String {
  concat(
    concat(grounded_posix_principal_name(p: access.principal) as String, " ALL=(ALL) NOPASSWD: "),
    cmd.grant.command_path
  )
}

fn deploy_target_proof_from_access(access: DeployAccess) -> gunbc.ci_deploy_target_host.DeployTargetHostProof {
  deploy_target_proof(host: access.host.identity, transport: access.transport)
}

fn deploy_target_host_preflight_script(access: DeployAccess) -> String {
  let proof = deploy_target_proof_from_access(access: access)
  concat(
    concat(concat(deploy_preflight_shell_header, "\n"), deploy_target_host_preflight_block(proof: proof)),
    ""
  )
}

fn deploy_access_with_ssh_transport(access: DeployAccess, ssh_host: std.types.NonEmptyStr) -> DeployAccess {
  DeployAccess {
    principal: access.principal,
    host: access.host,
    transport: gunbc.host_effect.SshShell { ssh_host: ssh_host },
    privileged_commands: access.privileged_commands,
  }
}

fn deploy_access_projected_grants(access: DeployAccess) -> List<std.effect_grant.Grant> {
  map(
    access.principal.sudo_grants,
    g => posix_sudo_grant_to_effect_grant(g: g)
  )
}

fn deploy_access_grant_envelope(access: DeployAccess) -> std.effect_grant.Envelope {
  std.effect_grant.Envelope {
    frame: deploy_access_frame,
    grants: deploy_access_projected_grants(access: access),
  }
}

fn deploy_access_authorization_query(access: DeployAccess) -> DeployAuthorizationQuery {
  DeployAuthorizationQuery {
    expected_principal: grounded_posix_principal_name(p: access.principal),
    envelope: deploy_access_grant_envelope(access: access),
  }
}

fn deploy_access_read_principal_effect() -> gunbc.host_effect.HostEffect {
  gunbc.host_effect.ReadEffectivePosixPrincipal { read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead {} }
}

fn deploy_access_sudo_probe_effect(cmd: PrivilegedCommand) -> gunbc.host_effect.HostEffect {
  match cmd.grant.probe {
    NopasswdExecuteCheck { check_argv: check } =>
      gunbc.host_effect.SudoNopasswdExecuteProbe {
        probe: extdeps.sudo.nopasswd_execute_probe.SudoNopasswdExecuteProbeShape {
          command_path: cmd.grant.command_path,
          check_argv: check,
        }
      }
    NopasswdGrantListCheck =>
      gunbc.host_effect.SudoNopasswdGrantListProbe {
        probe: cmd.grant.command_path as extdeps.sudo.nopasswd_execute_probe.SudoNopasswdGrantListProbeShape
      }
  }
}

fn deploy_access_grant_admits_probe(
  access: DeployAccess,
  cmd: PrivilegedCommand
) -> std.access.AccessDecision {
  let grant = posix_sudo_grant_to_effect_grant(g: cmd.grant)
  admit_effect(
    env: deploy_access_grant_envelope(access: access),
    verb: verb_of_effect_shape(shape: ExecuteEffect),
    target: grant.root
  )
}

data deploy_access_preflight_shell_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "deploy_access_preflight_script dissolved (Wave B): deploy-preflight is an authorization query + typed effect-plan, not a concat shell script. Authority: deploy_access_authorization_query + deploy_access_preflight_plan; observation: gunbc.ci_deploy_access_observe."
}

data deploy_access_preflight_plan_disposition: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.ci_deploy_access_observe",
    decl_name: "deploy_access_preflight_plan",
    field: WholeDeclaration
  }
}

fn deploy_access_privileged_fixture_actor(access: DeployAccess) -> DeployAccessActor {
  DeployAccessActor {
    observed_name: grounded_posix_principal_name(p: access.principal),
    sudo_granted: true,
  }
}

data deploy_access_unprivileged_fixture_principal: std.types.NonEmptyStr = "nobody"

fn deploy_access_unprivileged_fixture_actor() -> DeployAccessActor {
  DeployAccessActor { observed_name: deploy_access_unprivileged_fixture_principal, sudo_granted: false }
}

fn deploy_access_sudo_miss_reason(access: DeployAccess) -> String {
  let sample = access.privileged_commands.first()
  concat(
    concat(
      concat(deploy_access_refusal_prefix, " — privileged commands not granted (sudo -n preflight miss)\n"),
      concat(concat("Add to ", gunbc_deploy_sudoers_dropin), ":\n")
    ),
    deploy_access_sudoers_line(access: access, cmd: sample)
  )
}

fn deploy_access_check(access: DeployAccess, actor: DeployAccessActor) -> std.access.AccessDecision {
  let expected = grounded_posix_principal_name(p: access.principal)
  if actor.observed_name != expected {
    access_policy_refusal(
      profile: "deploy-access", subject: actor.observed_name, action: "execute", object: expected,
      reason: concat(
          concat(
            concat(deploy_access_refusal_prefix, " — principal mismatch expected="),
            expected
          ),
          concat(" actual=", actor.observed_name)
        ),
    )
  } else {
    if actor.sudo_granted {
      Permit
    } else {
      access_policy_refusal(profile: "deploy-access", subject: actor.observed_name, action: "execute", object: expected, reason: deploy_access_sudo_miss_reason(access: access))
    }
  }
}

fn deploy_access_decision_reason(d: std.access.AccessDecision) -> String {
  match d {
    Permit => ""
    Deny { refusal: refusal } => access_refusal_reason(refusal: refusal)
  }
}

fn deploy_access_principal_line(success: Bool, stdout: String) -> std.types.NonEmptyStr? {
  if !success {
    none
  } else {
    let line = trim(stdout)
    if line == "" { none } else { Present { value: line as std.types.NonEmptyStr } }
  }
}

fn deploy_access_is_local_apply(access: DeployAccess) -> Bool {
  match access.transport {
    LocalShell => true
    SshShell { ssh_host: _ } => false
    FleetSsh { target: _, context: _ } => false
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => false
  }
}

fn deploy_access_preflight_pass_message(access: DeployAccess) -> String {
  concat(
    "deploy-access-preflight: PASS principal=",
    grounded_posix_principal_name(p: access.principal) as String
  )
}

fn srv1_live_deploy_privileged_commands() -> List<PrivilegedCommand> {
  grounded_principal_privileged_commands(
    p: fleet_posix_ci_runner_principal()
  )
}
