module gunbc.frontend_eval.attempt_rows

// A DECLARED, BOUNDED TRANSCRIPTION (DESIGN section 4b(3) shape, per review 65843), not an instrument
// output: one row per (task, arm) attempt against the GLM-5.3-Flash canary, produced by the Demo 0
// driver, which is local tooling outside the substrate by the repo_workspace rule that no Python is
// committed. What re-derives these rows is that driver, not anything in this tree; the identities each
// row binds (model snapshot, compiler program sha256, card sha256, tool-schema sha256) are what a
// re-run must match to be the same experiment. POPULATION: the frontend_eval_tasks roster times
// eval_arms. RESTORATION TRIGGER: the harness worker (gunbc.harness.harness_cli) running off a fleet
// host over an isolated-closure workspace, at which point rows are produced by an in-tree instrument
// and this module is regenerated by it. Consumed by gunbc.frontend_eval.instrument write_report.
// Never hand-edited.

import std.types { List, NonEmptyStr }
import std.measure { millisecond, token_count }
import extdeps.vllm.sampling_params { sampling_temperature }
import gunbc.frontend_eval.task { ExpressionNesting, LabeledPositionShape, CoproductIdentity, MatchArmCoverage, ImportTopologySentinel }
import gunbc.frontend_eval.attempt {
  EvalAttempt, EvalUsage, LowEffortBare, MaxEffortBare, LowEffortTools, LowEffortToolsCard,
  AcceptedRepair, FrontendStillRed, TestsRed, ScopeExceeded, BudgetExhausted, TransportFailed,
}

// Rows are built through the temperature constructor so a refused temperature empties the roster
// rather than fabricating a value; the report then shows every arm as not run.
