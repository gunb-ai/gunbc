module gunbc.frontend_eval.task

import std.types { String, Bool, Int, List, NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import extdeps.languages.json.emit {
  JsonValue, JsonKeyValue, json_kv, json_string, json_int, json_array, json_object, serialize_json,
}

// DEMO 0 OF THE .DAG FRONTEND EVAL: A MEASURED LOOP, NOT A TUNE. The question the roster answers is
// whether an agent can take an accepted std module that one controlled mutation has made the real
// frontend refuse, and return it to accepted with a bounded patch -- and at what reasoning cost.
// Every row is a mutation of accepted source, so the reference repair is the unmutated text and the
// acceptance oracle is the entry's own executing test fns; the roster carries neither answers nor
// the refusal text, because both are re-derived by running the compiler on the mutated workspace.
//
// FOUR STABLE FRONTEND CLASSES AND ONE SENTINEL, scored apart. The four classes are properties of
// the language: expression nesting, labeled-position shape, coproduct identity, match coverage. The
// sentinel (a name misspelled into another module's declaration) is a property of repository
// topology: it tests whether the agent consults the workspace for who declares a name rather than
// recalling it, so its score is evidence about tool routing and never about whether language facts
// belong in weights. The sentinel was first authored as a dropped import member and the control run
// PASSED all four: this frontend resolves a name whether or not its module imported it, so that
// mutation has no authorable RED (DESIGN section 4b) and was replaced rather than kept as a
// decoration -- which is why the class is named for what its live specimens are, not for imports.
//
// SCOPE OF THE NESTING CLASS, stated so the table is not over-read: its four specimens are
// delimiter and `else` structure at parse level. They do not exercise a valid-but-subtle
// composition such as a `d == Failed && match ...` arm, which is the idiom the operator's trace
// litigated; a contrast set whose answer turns on composition or precedence is a separate roster
// and a precondition for concluding anything about a language-prior tune from these rows.
type FrontendMutationClass
  = ExpressionNesting
  | LabeledPositionShape
  | CoproductIdentity
  | MatchArmCoverage
  | CrossModuleNameSentinel

fn mutation_class_scored_separately(class: FrontendMutationClass) -> Bool {
  match class {
    ExpressionNesting => false
    LabeledPositionShape => false
    CoproductIdentity => false
    MatchArmCoverage => false
    CrossModuleNameSentinel => true
  }
}

fn mutation_class_key(class: FrontendMutationClass) -> String {
  match class {
    ExpressionNesting => "expression_nesting"
    LabeledPositionShape => "labeled_position_shape"
    CoproductIdentity => "coproduct_identity"
    MatchArmCoverage => "match_arm_coverage"
    CrossModuleNameSentinel => "cross_module_name_sentinel"
  }
}

// THE STAGE THE REFUSAL IS EXPECTED FROM. A nesting mutation is refused by the parser; every other
// class parses and is refused by resolution. Recording the stage keeps a task honest about which
// wall it exercises, and lets the control run refuse a specimen that fails at the wrong stage.
type EvalFrontendStage = RefusedAtParse | RefusedAtResolve

fn frontend_stage_key(stage: EvalFrontendStage) -> String {
  match stage {
    RefusedAtParse => "parse"
    RefusedAtResolve => "resolve"
  }
}

// A TEXT MUTATION NAMES ITS SITE BY CONTENT, NOT POSITION (DESIGN section 3: cite the symbol). The
// `old` text must occur exactly once in the subject module's source; a realization applying it
// refuses on zero or several occurrences rather than picking one, the same rule the harness's edit
// tool carries. `new` is what the mutated workspace holds; the reference repair is `old`.
type TextMutation {
  old: String
  new: String
}

type EvalTask {
  id: NonEmptyStr
  class: FrontendMutationClass
  subject: DeclarationRef
  subject_path: String
  entry_path: String
  mutation: TextMutation
  expected_stage: EvalFrontendStage
  expected_lexeme: String
}

data pareto_path: String = "dag/std/pareto.dag"
data pareto_entry: String = "dag/test/claim/pareto_selection_witness_test.dag"
data frame_boundary_path: String = "dag/std/frame_boundary.dag"
data frame_boundary_entry: String = "dag/test/claim/frame_boundary_witness_test.dag"
data evaluation_budget_path: String = "dag/std/evaluation_budget.dag"
data evaluation_budget_entry: String = "dag/test/claim/evaluation_budget_witness_test.dag"
data goal_assessment_path: String = "dag/std/goal_assessment.dag"
data goal_assessment_entry: String = "dag/test/claim/goal_assessment_witness_test.dag"

