// TWO PROJECTIONS, BECAUSE THE DRIVER IS ALSO THE BOUNDARY THAT DECIDES WHAT THE MODEL SEES. The
// model-visible task names the subject and the entry and nothing else; the judge specification
// carries the reference repair (`old`), the mutation, the expected stage and lexeme, and is read
// only by the judge and the control. One projection carrying both would leave nothing to establish
// that the answer stayed on the judge's side of the boundary.
fn model_task_json(task: EvalTask) -> JsonValue {
  json_object([
    json_kv(key: "id", value: json_string(s: task.id as String)),
    json_kv(key: "class", value: json_string(s: mutation_class_key(class: task.class))),
    json_kv(key: "subject_module", value: json_string(s: task.subject.module_path as String)),
    json_kv(key: "subject_decl", value: json_string(s: task.subject.decl_name as String)),
    json_kv(key: "subject_path", value: json_string(s: task.subject_path)),
    json_kv(key: "entry_path", value: json_string(s: task.entry_path)),
  ])
}

fn judge_spec_json(task: EvalTask) -> JsonValue {
  json_object([
    json_kv(key: "id", value: json_string(s: task.id as String)),
    json_kv(key: "old", value: json_string(s: task.mutation.old)),
    json_kv(key: "new", value: json_string(s: task.mutation.new)),
    json_kv(key: "expected_stage", value: json_string(s: frontend_stage_key(stage: task.expected_stage))),
    json_kv(key: "expected_lexeme", value: json_string(s: task.expected_lexeme)),
  ])
}

fn frontend_eval_model_tasks_json() -> String {
  serialize_json(v: json_array(elements: frontend_eval_tasks |> map(t => model_task_json(task: t))))
}

fn frontend_eval_judge_spec_json() -> String {
  serialize_json(v: json_array(elements: frontend_eval_tasks |> map(t => judge_spec_json(task: t))))
}

fn frontend_eval_task_count() -> Int {
  count(frontend_eval_tasks)
}
