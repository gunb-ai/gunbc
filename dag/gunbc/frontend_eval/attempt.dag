module gunbc.frontend_eval.attempt

import std.types { String, Bool, Int, List, NonEmptyStr }
import std.measure { Millisecond, TokenCount, token_count, token_count_value, measure_add }
import extdeps.vllm.sampling_params { SamplingTemperature }
import gunbc.frontend_eval.task { EvalTask, FrontendMutationClass, mutation_class_scored_separately, frontend_eval_tasks }

// AN ATTEMPT IS AN INDEPENDENT RECORD OF ONE RUN OF ONE TASK UNDER ONE ARM, and it binds every
// identity a reader would need to re-run it: the model as served, the compiler program that judged
// it, the card and tool schema it saw, and the decode configuration. A row missing any of those
// would compare two arms that were not the same experiment.
type EvalArm
  = LowEffortBare
  | MaxEffortBare
  | LowEffortTools
  | LowEffortToolsCard

fn eval_arm_key(arm: EvalArm) -> String {
  match arm {
    LowEffortBare => "low_bare"
    MaxEffortBare => "max_bare"
    LowEffortTools => "low_tools"
    LowEffortToolsCard => "low_tools_card"
  }
}

data eval_arms: List<EvalArm> = [LowEffortBare, MaxEffortBare, LowEffortTools, LowEffortToolsCard]

// CORRECTNESS IS LEXICOGRAPHIC. Only AcceptedRepair counts; the other arms say WHICH gate refused,
// so a red is attributable rather than a bare failure. ScopeExceeded is the evaluator-modification
// wall: any byte changed outside the subject module -- the entry, a neighbour -- refuses the attempt
// regardless of whether the tests then pass.
type EvalOutcome
  = AcceptedRepair
  | FrontendStillRed
  | TestsRed
  | ScopeExceeded
  | BudgetExhausted
  | TransportFailed

fn eval_outcome_accepted(outcome: EvalOutcome) -> Bool {
  match outcome {
    AcceptedRepair => true
    FrontendStillRed => false
    TestsRed => false
    ScopeExceeded => false
    BudgetExhausted => false
    TransportFailed => false
  }
}

// USAGE IS WIRE-OBSERVED, NOT MODEL-REPORTED: the counts come from the serving engine's usage
// block on each response, summed over the attempt's cycles, carried as std.measure token counts.
type EvalUsage {
  prompt_tokens: TokenCount
  completion_tokens: TokenCount
  reasoning_tokens: TokenCount
}

type EvalAttempt {
  task_id: NonEmptyStr
  class: FrontendMutationClass
  arm: EvalArm
  model_id: String
  model_snapshot: String
  compiler_program_sha256: String
  card_sha256: String
  tool_schema_sha256: String
  temperature: SamplingTemperature
  max_tokens: TokenCount
  usage: EvalUsage
  cycles: Int
  tool_calls: Int
  edits: Int
  outcome: EvalOutcome
  wall: Millisecond
}

// THE PER-ARM FOLD, JOINED AGAINST THE ROSTER BY TASK IDENTITY (DESIGN section 5: completeness is an
// identity join, not a count equality). Denominators are the roster's tasks, never the rows
// present, so an arm with rows for eleven of sixteen language tasks renders as 11/16 with five
// named as not run -- a partial population must not print as a complete rate. Accepted counts are
// split into the four language classes and the sentinel, because the ruling that admitted this
// demo scores them apart: a sentinel success is evidence about tool routing, not the language prior.
type ArmSummary {
  arm: EvalArm
  attempts: Int
  language_tasks: Int
  language_run: Int
  language_accepted: Int
  sentinel_tasks: Int
  sentinel_run: Int
  sentinel_accepted: Int
  reasoning_tokens_over_accepted: TokenCount
  completion_tokens_over_accepted: TokenCount
  cycles_over_accepted: Int
  tool_calls_over_accepted: Int
}

fn tokens_int(t: TokenCount) -> Int {
  token_count_value(t: t)
}

fn rows_for(attempts: List<EvalAttempt>, arm: EvalArm, task: EvalTask) -> List<EvalAttempt> {
  attempts |> filter(a => a.arm == arm && a.task_id == task.id)
}

fn task_ran(attempts: List<EvalAttempt>, arm: EvalArm, task: EvalTask) -> Bool {
  count(rows_for(attempts: attempts, arm: arm, task: task)) > 0
}

fn task_accepted(attempts: List<EvalAttempt>, arm: EvalArm, task: EvalTask) -> Bool {
  count(rows_for(attempts: attempts, arm: arm, task: task) |> filter(a => eval_outcome_accepted(outcome: a.outcome))) > 0
}

fn language_tasks() -> List<EvalTask> {
  frontend_eval_tasks |> filter(t => mutation_class_scored_separately(class: t.class) == false)
}

fn sentinel_tasks() -> List<EvalTask> {
  frontend_eval_tasks |> filter(t => mutation_class_scored_separately(class: t.class))
}

fn accepted_rows(attempts: List<EvalAttempt>, arm: EvalArm) -> List<EvalAttempt> {
  attempts |> filter(a => a.arm == arm && eval_outcome_accepted(outcome: a.outcome))
}

// THE POPULATION IS ADMITTED BEFORE ANYTHING IS SUMMED: exactly one row per (task, arm) and every
// row's task in the roster. Without this, a duplicated task doubles a numerator its denominator
// counts once, and an unknown id adds cost with no task behind it -- a fabricated mean (review 65900).
type ReportAdmission
  = ReportAdmitted { attempts: List<EvalAttempt> }
  | ReportRefused { detail: String }

fn task_known(a: EvalAttempt) -> Bool {
  count(frontend_eval_tasks |> filter(t => t.id == a.task_id)) == 1
}

fn duplicate_cell(attempts: List<EvalAttempt>, a: EvalAttempt) -> Bool {
  count(attempts |> filter(b => b.arm == a.arm && b.task_id == a.task_id)) > 1
}

fn admit_report_population(attempts: List<EvalAttempt>) -> ReportAdmission {
  let unknown = attempts |> filter(a => task_known(a: a) == false)
  let duplicated = attempts |> filter(a => duplicate_cell(attempts: attempts, a: a))
  if count(unknown) > 0 {
    ReportRefused { detail: join(["attempt names a task not in the roster: ", first_task_id(rows: unknown)], "") }
  } else {
    if count(duplicated) > 0 {
      ReportRefused { detail: join(["more than one attempt for one (task, arm) cell: ", first_task_id(rows: duplicated)], "") }
    } else {
      ReportAdmitted { attempts: attempts }
    }
  }
}

fn first_task_id(rows: List<EvalAttempt>) -> String {
  match rows |> first {
    Present { value: a } => a.task_id as String
    Absent => ""
  }
}

// Over an ADMITTED population: accepted rows and accepted tasks are the same set, so the sums and
// the denominator below describe one population.
fn arm_summary(attempts: List<EvalAttempt>, arm: EvalArm) -> ArmSummary {
  let accepted = accepted_rows(attempts: attempts, arm: arm)
  ArmSummary {
    arm: arm,
    attempts: count(attempts |> filter(a => a.arm == arm)),
    language_tasks: count(language_tasks()),
    language_run: count(language_tasks() |> filter(t => task_ran(attempts: attempts, arm: arm, task: t))),
    language_accepted: count(language_tasks() |> filter(t => task_accepted(attempts: attempts, arm: arm, task: t))),
    sentinel_tasks: count(sentinel_tasks()),
    sentinel_run: count(sentinel_tasks() |> filter(t => task_ran(attempts: attempts, arm: arm, task: t))),
    sentinel_accepted: count(sentinel_tasks() |> filter(t => task_accepted(attempts: attempts, arm: arm, task: t))),
    reasoning_tokens_over_accepted: fold(accepted, init: token_count(count: 0), f: (acc, a) => measure_add(a: acc, b: a.usage.reasoning_tokens)),
    completion_tokens_over_accepted: fold(accepted, init: token_count(count: 0), f: (acc, a) => measure_add(a: acc, b: a.usage.completion_tokens)),
    cycles_over_accepted: fold(accepted, init: 0, f: (acc, a) => acc + a.cycles),
    tool_calls_over_accepted: fold(accepted, init: 0, f: (acc, a) => acc + a.tool_calls),
  }
}

fn coverage_text(accepted: Int, run: Int, tasks: Int) -> String {
  if run == 0 {
    "not run"
  } else {
    if run == tasks {
      join([to_string(value: accepted), "/", to_string(value: tasks)], "")
    } else {
      join([to_string(value: accepted), "/", to_string(value: tasks), " (", to_string(value: tasks - run), " not run)"], "")
    }
  }
}

fn mean_text(total: Int, n: Int) -> String {
  if n == 0 { "-" } else { to_string(value: total / n) }
}

fn arm_summary_line(s: ArmSummary, accepted: Int) -> String {
  join([
    "| ", eval_arm_key(arm: s.arm),
    " | ", coverage_text(accepted: s.language_accepted, run: s.language_run, tasks: s.language_tasks),
    " | ", coverage_text(accepted: s.sentinel_accepted, run: s.sentinel_run, tasks: s.sentinel_tasks),
    " | ", mean_text(total: tokens_int(t: s.reasoning_tokens_over_accepted), n: accepted),
    " | ", mean_text(total: tokens_int(t: s.completion_tokens_over_accepted), n: accepted),
    " | ", mean_text(total: s.cycles_over_accepted, n: accepted),
    " | ", mean_text(total: s.tool_calls_over_accepted, n: accepted),
    " |",
  ], "")
}

// THE REPORT IS GENERATED FROM ATTEMPT ROWS, never transcribed (DESIGN section 6: name the
// instrument). Means are over ACCEPTED attempts only, because correctness is lexicographically
// prior: a cheap wrong answer is not a cheaper answer.
fn arm_line(attempts: List<EvalAttempt>, arm: EvalArm) -> String {
  arm_summary_line(s: arm_summary(attempts: attempts, arm: arm), accepted: count(accepted_rows(attempts: attempts, arm: arm)))
}

type ReportRead
  = ReportRendered { text: String }
  | ReportNotRendered { detail: String }

fn frontend_eval_report(attempts: List<EvalAttempt>) -> ReportRead {
  match admit_report_population(attempts: attempts) {
    ReportRefused { detail } => ReportNotRendered { detail: detail }
    ReportAdmitted { attempts: admitted } => ReportRendered { text: join(concat([
      "| arm | language accepted | sentinel accepted | mean reasoning tok (accepted) | mean completion tok (accepted) | mean cycles (accepted) | mean tool calls (accepted) |",
      "|---|---|---|---|---|---|---|",
    ], eval_arms |> map(arm => arm_line(attempts: admitted, arm: arm))), "\n") }
  }
}
