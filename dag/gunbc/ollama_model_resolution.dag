    media_type: "application/vnd.ollama.image.model" as NonEmptyStr,
  },
  OllamaBlobDigest {
    hex: "fa6710a93d78da62641e192361344be7a8c0a1c3737f139cf89f20ce1626b99c" as NonEmptyStr,
    media_type: "application/vnd.ollama.image.template" as NonEmptyStr,
  },
  OllamaBlobDigest {
    hex: "f60356777647e927149cbd4c0ec1314a90caba9400ad205ddc4ce47ed001c2d6" as NonEmptyStr,
