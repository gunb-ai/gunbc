fn ollama_manifest_reading_wire(reading: OllamaManifestReading) -> String {
  join([reading.authority as String, "@", reading.observed_at, "=", reading.observed_identity.hex as String], "")
}

// The whole resolution as one line, so a receipt can carry WHY an identity is desired rather than
// only which one. A consumer printing the identity alone reproduces the situation this file exists
// to end: a digest with no account of where it came from.
fn gpt_oss_20b_resolution_wire() -> String {
  join([
    ollama_model_ref_wire(ref: gpt_oss_20b_resolution().reference),
    " -> ",
    serialize_content_hash(hash: gpt_oss_20b_resolution().resolved_identity) as String,
    " resolved_at=",
    gpt_oss_20b_resolution().resolved_at,
    " evidence=",
    join(map(tracked_reference_resolution_evidence(resolution: gpt_oss_20b_resolution()), r => ollama_manifest_reading_wire(reading: r)), " | "),
  ], "")
}

fn gpt_oss_20b_resolution_evidence_count() -> Int {
  length(tracked_reference_resolution_evidence(resolution: gpt_oss_20b_resolution()))
}

// WHAT THE EVIDENCE ACTUALLY ESTABLISHES, DECIDED PER ARM.
//
// ollama_resolved_manifest_evidence_is_unanimous answers one question -- do the readings agree with
// the settled identity -- and that question is necessary for both arms and SUFFICIENT for neither on
// its own. Read alone it invites the inference this file most needs to prevent: that a higher
// reading count is stronger provenance. It is not. Four readings taken from two hosts filled by the
// same hand cannot disagree about a locally-authored artifact that is wrong, so unanimity there is
// silent on the failure mode registry corroboration exists to catch.
//
// So the word is not reused across the two arms. This projects what each one has EARNED, and it is
// the value consumers match on rather than a Bool they can read as a grade.
//
// THE REFUSAL ARM IS REACHABLE FROM BOTH SIDES, which is what keeps this from being decoration:
// disagreeing readings refuse under either provenance, and a locally-materialized manifest resting
// on a SINGLE reading refuses as well -- one host agreeing with itself is not corroboration, and it
// is the state a copy-paste of this block onto a new tag would most easily produce.
type OllamaManifestCorroboration
  = IndependentlySelected { registry_authority: NonEmptyStr, reading_count: Int }
  | CrossHostAgreementOnly { reading_count: Int }
  | CorroborationRefused { cause: NonEmptyStr }

fn ollama_resolved_manifest_corroboration(m: OllamaResolvedManifest) -> OllamaManifestCorroboration {
  let readings = ollama_resolved_manifest_evidence(m: m)
  if !ollama_resolved_manifest_evidence_is_unanimous(m: m) {
    CorroborationRefused {
      cause: "a reading disagrees with the identity this resolution settled on" as NonEmptyStr,
    }
  } else {
    match m.provenance {
      UpstreamPublished { registry_authority: a } =>
        IndependentlySelected { registry_authority: a, reading_count: length(readings) }
      LocallyMaterialized { producer: _, derived_from: _ } =>
        if length(readings) < 2 {
          CorroborationRefused {
            cause: "a locally materialized manifest rests on fewer than two readings, so nothing independent corroborates it" as NonEmptyStr,
          }
        } else {
          CrossHostAgreementOnly { reading_count: length(readings) }
        }
    }
  }
}
