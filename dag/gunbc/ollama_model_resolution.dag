// THE MANIFEST AND ITS CLOSURE ARE ONE FACT, AND WERE TWO DECLARATIONS.
//
// Added on review of #9749 (codex/gpt-5.6-sol, REQUEST_CHANGES), whose finding was correct and
// whose scope was larger than the diff that provoked it: `gpt_oss_120b_resolution` and
// `gpt_oss_120b_blob_closure` were independent values with no edge between them, so pairing the
// digest with a DIFFERENT five-entry closure -- or rewiring the resolution's reference or evidence
// -- left every claim green. The 20b pair beside it had the same shape, which is why this repair is
// made at the root for both rather than only for the row under review.
//
// WHY THE EDGE MATTERS RATHER THAN BEING TIDIER. A closure is not a list that happens to sit near a
// digest; it is the set of blobs THAT MANIFEST names, and the install plan's whole safety property
// is that the bytes fetched are the bytes the resolved manifest called for. Two free-standing
// declarations can drift into disagreeing while every consumer keeps reading whichever one it
// imported -- DESIGN §3's fork, in the input to a materializer. One constructor carrying both makes
// the association the thing consumers hold, so a claim about a manifest is unavoidably a claim
// about its closure too.
// WHERE A RESOLVED MANIFEST'S BYTES WERE SELECTED, which is a PROPERTY OF THE SUBJECT and not a gap
// in its evidence list.
//
// THE DISTINCTION IS FORCED BY A REAL ARTIFACT. Every manifest in this file until now was an
// upstream-published library tag, and the note on OllamaManifestReading states the discipline that
// rests on it: "the registry is what SELECTS the bytes, and the two host readings are independent
// confirmations that the host already holds what the registry now serves." That sentence is exactly
// true and exactly unavailable for deepseek-v4-gguf:no-h3-stop, which was produced by POST
// /api/create on each host. There is no registry to read, and there never will be.
//
// WHY THIS IS NOT A DECLARED RUNG DROP. A §4b(3) drop records a TEMPORARY loss retired BY ITS
// TRIGGER. A trigger naming "a registry reading for a locally-created tag" names a thing that cannot
// come into existence, so the row could never be retired and would sit in the roster forever. "No
// upstream exists" is a true and permanent property, and a property is MODELED, not deferred.
//
// WHY NOT SIMPLY AUTHOR MORE READINGS. Four readings were available for the local tag -- two hosts x
// (manifest file, /api/tags) -- and they are unanimous, which is numerically MORE corroboration than
// gpt-oss:120b's three. Authoring them under the same carrier would have been the worst of the
// options on offer, because it inflates a count while deleting a kind. Ask whether the RED of
// ollama_resolved_manifest_evidence_is_unanimous is AUTHORABLE for a locally-materialized manifest:
// both hosts were fed by the same hand, so an artifact that is wrong is IDENTICALLY wrong on both,
// and the check is permanently green by construction for the failure that registry corroboration
// exists to catch. That is DESIGN §4b's decoration case, and it would have been cited as coverage
// precisely BECAUSE the count was higher.
//
// So the two arms carry different guarantees at different grains, and both are real:
//   - UpstreamPublished: an independent authority selected the bytes; host readings can DISAGREE
//     with it, which is the 2026-08-19 republish this file was built to record.
//   - LocallyMaterialized: no independent selector exists. Cross-host agreement is still a genuine
//     property at its own grain -- a host whose store diverged IS detectable -- but it is a
//     different claim and is named as one rather than borrowing the word "unanimous".
type OllamaManifestProvenance
  = UpstreamPublished { registry_authority: NonEmptyStr }
  | LocallyMaterialized { producer: NonEmptyStr, derived_from: NonEmptyStr }

type OllamaResolvedManifest {
  resolution: TrackedReferenceResolution<OllamaModelRef, OllamaManifestReading>
  closure: List<OllamaBlobDigest>
  provenance: OllamaManifestProvenance
}

fn ollama_resolved_manifest_provenance(m: OllamaResolvedManifest) -> OllamaManifestProvenance {
  m.provenance
}

fn ollama_resolved_manifest_reference(m: OllamaResolvedManifest) -> OllamaModelRef {
  m.resolution.reference
}

fn ollama_resolved_manifest_identity(m: OllamaResolvedManifest) -> String {
  serialize_content_hash(hash: m.resolution.resolved_identity) as String
}

fn ollama_resolved_manifest_closure(m: OllamaResolvedManifest) -> List<OllamaBlobDigest> {
  m.closure
}

// THE DIGEST A MATERIALIZER CAN ACTUALLY CHECK BYTES AGAINST.
//
// The resolution stores a family-grounded ContentHash, which is the right carrier for an identity
// but not directly usable as the left column of a sha256sum check. This projects the one family
// that column means, and REFUSES for the other three rather than rendering them -- because a
// checksum file is a claim about which algorithm produced the hex beside the path, and writing an
// fnv1a64 or sha512 digest there would produce a check that fails for a reason unrelated to the
// bytes. The Absent arm is a typed refusal at the boundary, not a fallback.
fn ollama_resolved_manifest_sha256_digest(m: OllamaResolvedManifest) -> Sha256Digest? {
  match m.resolution.resolved_identity {
    Sha256Hash(d) => Present { value: d }
    Fnv1a64(_) => Absent
    Sha1Hash(_) => Absent
    Sha512Hash(_) => Absent
  }
}

fn ollama_resolved_manifest_evidence(m: OllamaResolvedManifest) -> List<OllamaManifestReading> {
  tracked_reference_resolution_evidence(resolution: m.resolution)
}

// Membership by identity, which is what DESIGN §5 asks of a completeness check and what a count
// cannot give: a closure of the right length holding the wrong bytes is exactly the state the
// review found unprotected.
fn ollama_resolved_manifest_names_blob(m: OllamaResolvedManifest, hex: NonEmptyStr) -> Bool {
  any(ollama_resolved_manifest_closure(m: m), b => b.hex as String == hex as String)
}

// Every reading behind this manifest agrees with the identity the resolution settled on. An
// evidence row that disagreed would mean the three authorities did not in fact concur, which is the
// premise the whole three-reading discipline rests on and was nowhere checked.
fn ollama_resolved_manifest_evidence_is_unanimous(m: OllamaResolvedManifest) -> Bool {
  let settled = ollama_resolved_manifest_identity(m: m)
  !any(ollama_resolved_manifest_evidence(m: m), r =>
    !(serialize_content_hash(hash: as_content_hash_cryptographic(digest: r.observed_identity)) as String == settled))
}

data gpt_oss_20b_manifest: OllamaResolvedManifest = OllamaResolvedManifest {
  resolution: gpt_oss_20b_resolution(),
  closure: gpt_oss_20b_blob_closure,
  provenance: UpstreamPublished {
    registry_authority: "registry.ollama.ai/v2/library/gpt-oss/manifests/20b" as NonEmptyStr,
  },
}

data gpt_oss_120b_manifest: OllamaResolvedManifest = OllamaResolvedManifest {
  resolution: gpt_oss_120b_resolution(),
  closure: gpt_oss_120b_blob_closure,
  provenance: UpstreamPublished {
    registry_authority: "registry.ollama.ai/v2/library/gpt-oss/manifests/120b" as NonEmptyStr,
  },
}

// ============================================================================================
// THE LOCALLY MATERIALIZED SERVING ARTIFACT
// ============================================================================================
//
// WHAT THIS TAG IS AND WHY IT EXISTS. deepseek-v4-gguf:no-h3-stop is the repair of a DEFECT IN A
// MODELFILE, not a new model. Its parent, hf.co/antirez/deepseek-v4-gguf:latest, carries
// `PARAMETER stop "###"`. Markdown H3 is `###`, so generation TERMINATED SILENTLY the first time an
// answer reached a third-level heading -- a truncated response with a normal stop reason and no
// error anywhere, which is DESIGN §5's fabricated-plausible-output failure arriving through a
// configuration row. The repair removes that one parameter and changes nothing else.
//
// THE REFERENCE IS DECLARED HERE, IN THE GUNBC LAYER, AND NOT IN extdeps.ollama.capability. DESIGN's
// external-upstream rule is explicit that observations produced by this repository are receipts in
// the observing layer and never facts authored inside the observed upstream's module. There is no
// `deepseek-v4-gguf` in the ollama library; this name exists because we created it on our own hosts.
// Writing it into the upstream catalogue would be authoring a fact about ollama that ollama does not
// hold.
data deepseek_v4_no_h3_stop_model_ref: OllamaModelRef = OllamaModelRef {
  name: "deepseek-v4-gguf" as NonEmptyStr,
  tag: "no-h3-stop" as NonEmptyStr,
}

data deepseek_v4_no_h3_stop_manifest_digest_2026_09_02: Sha256Digest = Sha256Digest {
  hex: "52ff2c31b90ec6680869fa0604e4c719a1a8553ee498c2e46109f331e83f6eed" as Sha256DigestHex,
}

// FOUR READINGS, TWO HOSTS x TWO SOURCES, and the pairing is the point rather than the count. There
// is no registry row because there is no registry (see OllamaManifestProvenance). What these four
// CAN establish is that the two serving cells hold the same artifact; what they cannot establish is
// that the artifact is the one anyone intended, because both stores were filled by the same hand.
data deepseek_v4_no_h3_stop_srv5_manifest_file_reading: OllamaManifestReading = OllamaManifestReading {
  authority: "srv5 ollama model store manifest file for deepseek-v4-gguf:no-h3-stop" as NonEmptyStr,
  observed_at: "2026-09-02T17:00Z",
  observed_identity: deepseek_v4_no_h3_stop_manifest_digest_2026_09_02,
}

data deepseek_v4_no_h3_stop_srv5_api_tags_reading: OllamaManifestReading = OllamaManifestReading {
  authority: "srv5 ollama /api/tags digest for deepseek-v4-gguf:no-h3-stop" as NonEmptyStr,
  observed_at: "2026-09-02T17:00Z",
  observed_identity: deepseek_v4_no_h3_stop_manifest_digest_2026_09_02,
}

data deepseek_v4_no_h3_stop_srv6_manifest_file_reading: OllamaManifestReading = OllamaManifestReading {
  authority: "srv6 ollama model store manifest file for deepseek-v4-gguf:no-h3-stop" as NonEmptyStr,
  observed_at: "2026-09-02T17:00Z",
  observed_identity: deepseek_v4_no_h3_stop_manifest_digest_2026_09_02,
}

data deepseek_v4_no_h3_stop_srv6_api_tags_reading: OllamaManifestReading = OllamaManifestReading {
  authority: "srv6 ollama /api/tags digest for deepseek-v4-gguf:no-h3-stop" as NonEmptyStr,
  observed_at: "2026-09-02T17:00Z",
  observed_identity: deepseek_v4_no_h3_stop_manifest_digest_2026_09_02,
}

fn deepseek_v4_no_h3_stop_resolution() -> TrackedReferenceResolution<OllamaModelRef, OllamaManifestReading> {
  tracked_reference_resolution(
    reference: deepseek_v4_no_h3_stop_model_ref,
    resolved_identity: as_content_hash_cryptographic(digest: deepseek_v4_no_h3_stop_manifest_digest_2026_09_02),
    resolved_at: "2026-09-02T17:00Z",
    first_evidence: deepseek_v4_no_h3_stop_srv5_manifest_file_reading,
    further_evidence: [
      deepseek_v4_no_h3_stop_srv5_api_tags_reading,
      deepseek_v4_no_h3_stop_srv6_manifest_file_reading,
      deepseek_v4_no_h3_stop_srv6_api_tags_reading,
    ],
  )
}

// FOUR ENTRIES AND NOT FIVE. The upstream gpt-oss closures carry a license blob; this manifest names
// none, because POST /api/create wrote exactly the layers the Modelfile produced. The absence is
// read off the manifest body, not inferred from the parent.
//
// THE MODEL LAYER IS ESTABLISHED BY SIZE, NOT BY CONTENT, and that is stated rather than rounded up.
// The config, template and params blobs are small and were hashed where they sit. The model layer is
// 86720111200 bytes -- the size the manifest declares for it, to the byte -- and was not re-hashed,
// because that read is not worth 86 GB twice on a serving host.
data deepseek_v4_no_h3_stop_blob_closure: List<OllamaBlobDigest> = [
  OllamaBlobDigest {
