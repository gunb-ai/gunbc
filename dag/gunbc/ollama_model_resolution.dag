module gunbc.ollama_model_resolution

import std.types { String, NonEmptyStr, List, Bool, Int, Timestamp }
import std.content_hash { ContentHash, Fnv1a64, Sha256Hash, Sha1Hash, Sha512Hash, Sha256Digest, Sha256DigestHex, as_content_hash_cryptographic, serialize_content_hash }
import extdeps.pin { TrackedReferenceResolution, tracked_reference_resolution, tracked_reference_resolution_evidence }
import extdeps.ollama.api { OllamaModelRef, ollama_model_ref_wire }
import extdeps.ollama.capability { ollama_gpt_oss_20b_model_ref, ollama_gpt_oss_120b_model_ref }

// WHICH BYTES `gpt-oss:20b` NAMED ON A GIVEN DAY, recorded as a resolution rather than assumed as a
// property of the tag.
//
// THE INCIDENT THIS CARRIER ANSWERS. Desired state pinned the manifest digest
// 49124fc2c62223... under the 2026-08-12 reading, and that was correct then. On 2026-08-19 the
// registry, srv6's manifest file, and srv6's /api/tags all answered 17052f91a42e97... -- three
// independent readings agreeing with each other and disagreeing with the pin. Upstream republished
// the tag. Nothing on srv6 drifted.
//
// WHY THE PIN COULD NOT EXPRESS THE REPAIR. The old carrier authored a Sha256Digest literal and
// handed it to model_artifact_from_observed_digest, a function whose name and authority both say the
// digest came off an endpoint. It had not. So desired state asserted a provenance it did not have,
// and the only thing distinguishing a measured identity from a typed-in one was that someone had
// measured it once and remembered.
//
// A RESOLUTION IS THE HONEST SHAPE. It names the reference that was resolved, the identity that
// resulted, when, and on what evidence -- and its evidence field is required, so the version of this
// row that merely asserts a digest cannot be written.

// One reading of one authority. The authority is spelled out because the three readings below are
// not interchangeable: the registry is what SELECTS the bytes, and the two host readings are
// independent confirmations that srv6 already holds what the registry now serves. Collapsing them
// into an unlabelled list would lose exactly the distinction that makes the confirmations worth
// having.
type OllamaManifestReading sole_constructor {
  authority: NonEmptyStr
  observed_at: Timestamp
  observed_identity: Sha256Digest
}

fn ollama_manifest_reading(authority: NonEmptyStr, observed_at: Timestamp, observed_identity: Sha256Digest) -> OllamaManifestReading {
  OllamaManifestReading { authority: authority, observed_at: observed_at, observed_identity: observed_identity }
}

data gpt_oss_20b_manifest_digest_2026_08_19: Sha256Digest = Sha256Digest {
  hex: "17052f91a42e97930aa6e28a6c6c06a983e6a58dbb00434885a0cf5313e376f7" as Sha256DigestHex,
}

// The superseded reading, kept as history rather than as desired state. It is a real past resolution
// of the same reference, and deleting it would erase the only record that this tag moves at all --
// which is the fact every future reader of this file needs most.
data gpt_oss_20b_manifest_digest_2026_08_12: Sha256Digest = Sha256Digest {
  hex: "49124fc2c622237675273a842019e83bd327d4d6c2d6e076378ca07ec7579d05" as Sha256DigestHex,
}

data gpt_oss_20b_registry_reading: OllamaManifestReading = OllamaManifestReading {
  authority: "registry.ollama.ai/v2/library/gpt-oss/manifests/20b" as NonEmptyStr,
  observed_at: "2026-08-19T14:28Z",
  observed_identity: gpt_oss_20b_manifest_digest_2026_08_19,
}

data gpt_oss_20b_srv6_manifest_file_reading: OllamaManifestReading = OllamaManifestReading {
  authority: "srv6 ollama model store manifest file for gpt-oss:20b" as NonEmptyStr,
  observed_at: "2026-08-19T14:28Z",
  observed_identity: gpt_oss_20b_manifest_digest_2026_08_19,
}

data gpt_oss_20b_srv6_api_tags_reading: OllamaManifestReading = OllamaManifestReading {
  authority: "srv6 ollama /api/tags digest for gpt-oss:20b" as NonEmptyStr,
  observed_at: "2026-08-19T14:28Z",
  observed_identity: gpt_oss_20b_manifest_digest_2026_08_19,
}

// The selection. Registry first because it is the authority that decides what the tag names; the two
// srv6 readings follow as confirmations, and their agreement is why re-pinning to this identity plans
// zero model action rather than a pull.
fn gpt_oss_20b_resolution() -> TrackedReferenceResolution<OllamaModelRef, OllamaManifestReading> {
  tracked_reference_resolution(
    reference: ollama_gpt_oss_20b_model_ref,
    resolved_identity: as_content_hash_cryptographic(digest: gpt_oss_20b_manifest_digest_2026_08_19),
    resolved_at: "2026-08-19T14:28Z",
    first_evidence: gpt_oss_20b_registry_reading,
    further_evidence: [gpt_oss_20b_srv6_manifest_file_reading, gpt_oss_20b_srv6_api_tags_reading],
  )
}

// WHICH BYTES `gpt-oss:120b` NAMED ON 2026-08-30, recorded the same way and for the same reason.
//
// SPARK-PAIR-0 P1. The reference resolved on srv5 after the pull, and the three readings below are
// the same three authorities the 20b resolution uses, in the same order and for the same reason: the
// registry is what SELECTS the bytes, and the two host readings are independent confirmations that
// srv5 already holds what the registry now serves. All three answered the identity below.
//
// THE READING THAT IS NOT HERE. There is no superseded 120b digest, because this is the first
// resolution of this reference -- not because the tag is known to be stable. gpt-oss:20b moved once
// already, which is the incident the carrier above exists to record, and nothing about 120b makes it
// less likely to move.
data gpt_oss_120b_manifest_digest_2026_08_30: Sha256Digest = Sha256Digest {
  hex: "a951a23b46a1f6093dafee2ea481d634b4e31ac720a8a16f3f91e04f5a40ecd9" as Sha256DigestHex,
}

data gpt_oss_120b_registry_reading: OllamaManifestReading = OllamaManifestReading {
  authority: "registry.ollama.ai/v2/library/gpt-oss/manifests/120b" as NonEmptyStr,
  observed_at: "2026-08-30T12:00Z",
  observed_identity: gpt_oss_120b_manifest_digest_2026_08_30,
}

data gpt_oss_120b_srv5_manifest_file_reading: OllamaManifestReading = OllamaManifestReading {
  authority: "srv5 ollama model store manifest file for gpt-oss:120b" as NonEmptyStr,
