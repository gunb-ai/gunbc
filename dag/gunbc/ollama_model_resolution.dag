// holds for it is exactly 65369799840 bytes, which is the size the manifest declares for it to the
// byte. So four by content and the fifth by size, which is stated rather than rounded up to
// "verified" -- the same distinction the 20b row draws, reached by a different route: there the
// fifth was checked by reachability against the registry, here by the size of bytes already resident.
data gpt_oss_120b_blob_closure: List<OllamaBlobDigest> = [
  OllamaBlobDigest {
    hex: "0b3eaefc220f88ee3875909c1306654b2fbda9e31dae0133d6cdf488b37f9402" as NonEmptyStr,
