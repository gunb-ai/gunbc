// THE SECOND LOCAL COPY OF ONE RULE, SIGHTED BY THE Mt. COLLINS UI ASSET OBSERVER (DESIGN section 6b:
// "the trigger is the second local implementation of one rule"). Verified at 9230f9d0893486a2d3812d2669b1cc120aa67add
// with `git grep -nE "fn [a-z_]*(index_of|starts_with|ends_with|match_at)\\(" -- dag`: nine declarations answer two
// questions -- where does a needle first occur in a haystack, and does this sequence end with that one.
// The list is a candidate inventory from that grep, not a complete census of the tree.
data byte_sequence_search_reimplemented_per_module: IntegrationConcern = IntegrationConcern {
  identity: "byte_sequence_search_reimplemented_per_module",
  kind: SuspectedFork {
    authorities: DistinctAuthorities {
      first: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of"),
      second: decl_ref(module_path: "gunbc.instruments.known_red_derivation", decl_name: "known_red_index_of"),
      rest: [
        decl_ref(module_path: "extdeps.version.semver", decl_name: "semver_index_of"),
        decl_ref(module_path: "gunbc.instruments.emit_copy_qualification_transport", decl_name: "path_ends_with"),
        decl_ref(module_path: "gunbc.auth.heal_publisher_provision", decl_name: "ends_with_segment"),
        decl_ref(module_path: "extdeps.languages.json.grammar", decl_name: "json_text_starts_with_at"),
        decl_ref(module_path: "extdeps.whatwg.html_attribute_tokenization", decl_name: "html_octets_match_at"),
        decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_starts_with"),
        decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_string_ends_with"),
      ],
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of"),
    tail: [
      decl_ref(module_path: "gunbc.instruments.known_red_derivation", decl_name: "known_red_index_of"),
      decl_ref(module_path: "extdeps.version.semver", decl_name: "semver_index_of"),
      decl_ref(module_path: "gunbc.instruments.emit_copy_qualification_transport", decl_name: "path_ends_with"),
      decl_ref(module_path: "gunbc.auth.heal_publisher_provision", decl_name: "ends_with_segment"),
      decl_ref(module_path: "extdeps.languages.json.grammar", decl_name: "json_text_starts_with_at"),
      decl_ref(module_path: "std.bytes", decl_name: "bytes_octets"),
      decl_ref(module_path: "std.algebra", decl_name: "string_contains"),
    ],
  },
  question: "Where does one octet-sequence search live, and which local copies migrate to it? std.bytes today carries octet constructors and no search; std.algebra's string_contains answers whether text contains text and reports no offset, so nothing in std is a home a caller can already use. The candidates: does one rule cover octets and text, or does an octet search and a text search stay two rules with two homes?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "9230f9d0893486a2d3812d2669b1cc120aa67add",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "gunbc.instruments.known_red_derivation", decl_name: "known_red_index_of") }],
      },
      account: "PR 15724's reviewer ran the grep above at the PR head and counted a sixth local copy of the same two rules. The new copies exist because the observation walks a fetched JavaScript asset by BYTE OFFSET -- the offset and length it commits must be offsets into the asset's octets, so a text-level contains test cannot produce the evidence -- and std offers no octet-level index or suffix primitive. The copies are not generalizing because no std home exists to generalize INTO: adding one here means choosing std.bytes' shape for six call sites in five modules, three of which are read by other lanes' sweeps.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: HomeUnresolved { question: "std.bytes (which holds octet constructors, no search) or std.algebra beside string_contains (whose needle is text, not octets)? The two questions decide each other: an octet search placed in std.algebra would duplicate string_contains, and one placed in std.bytes leaves text callers with a second rule." },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of"),
        control: Present { value: decl_ref(module_path: "test.claim.machine_intake.mtcollins1_ui_status_asset_observation_witness", decl_name: "w_an_asset_that_never_reads_the_rows_status_has_nothing_to_quote") },
        statement: "no match is an ABSENT optional, never a zero offset, and every caller distinguishes the two by matching the optional rather than comparing it to none -- the PR's evidence gate failed open exactly once when a no-match reading was inverted, so a shared helper must carry Absent through unchanged and a migration is only done when a no-match input still refuses",
      },
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of"),
        control: Present { value: decl_ref(module_path: "test.claim.machine_intake.mtcollins1_ui_status_asset_observation_witness", decl_name: "w_the_excerpt_is_not_checkable_when_the_offset_moves_by_one") },
        statement: "the offset it reports is an index into OCTETS, not into characters or UTF-16 units, because the committed excerpt records are byte offsets and byte lengths within the asset",
      },
    ],
    next: climbs_when(capability: "a shared octet-sequence index/starts-with/ends-with rule exists in std with a home chosen above, and one existing caller outside this PR is migrated to it and its witness stays green -- the first migration proves the shape fits a call site the author does not own; the remaining copies then follow, and the leaf copies are deleted in the same change that migrates them"),
  },
}

// THE NEIGHBOUR, not a second row: this concern stands beside
// equality_synthesis_helper_binding_is_import_authority (same family) and covers only what that row
// cannot witness - the census-absent refusal arm of the gate. Filed from the independent review of
// the root fix (2026-11-06): the function-member red cell counts EqualityOnFunctionMember and
// EqualityMemberUnjudgeable wall classes and so does NOT discriminate this arm; fail-closed holds
// by source construction only.
data equality_missing_helper_census_refusal_unwitnessed: IntegrationConcern = IntegrationConcern {
  identity: "gunbc.integration_concern.equality_missing_helper_census_refusal_unwitnessed",
  kind: SuspectedCapabilityGap {
    model: Declared { declaration: decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_body_block_reason") },
    requirement: "When a derived equality body needs a helper that no module declares, the closure REFUSES at the use door with the located reason naming the helper, and no call to the undeclared helper is emitted - witnessed by execution, not by construction alone",
    standing: RequirementUnestablished { decided_by: "the independent exact-tree review of the #15992 root fix (2026-11-06) found no discriminating witness for this arm: no census fixture can make a pool-declared helper census-absent by omission, because omission also drops realization" },
  },
  affected: AffectedScope {
    head: [decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_helper_declared")],
    tail: [decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_body_block_reason"), decl_ref(module_path: "gunbc.instruments.multi_module_compile_fixture", decl_name: "MultiModuleCompileFixture")],
  },
  question: "Can the census-absent refusal be witnessed? DESIGN ONLY (instrument implementation is a separate scope decision): the fixture denies the helper by REMOVING the actual std.algebra.map_values_eq declaration from the fixture pool BEFORE the production census is built - never by faking a census answer; the fixture carries (a) a same-source positive control that keeps the declaration and is admitted, proving the population otherwise reaches the new arm, (b) the refusing cell located at the Map-bearing subject (fixture type Bag, Map only, no function members) with the exact helper reason naming std.algebra.map_values_eq, (c) an irrelevant-zip_eq control showing a Map-only subject produces no zip_eq reason, and (d) a zero-competing-wall requirement: the census shows no other blocking class at the subject. A pool-local helper declaration cannot serve as the positive control, because the gate looks up std.algebra.map_values_eq by that exact qualified name.",
  sightings: [
    ConcernSighting {
      revision: "02569a6da785",
      evidence: FreeSemigroup(head: SightingEvidence(artifact: CitesArtifact(path: "src/v1/04_infer.dag", locator: "equality_helper_declared false branch")), tail: FreeSemigroup(head: SightingEvidence(artifact: CitesArtifact(path: "dag/test/claim/self_host_equality_admission_witness.dag", locator: "unexecuted-obligation comment above nested_skipped_sibling_via_container_red_source")), tail: FreeSemigroupEmpty())),
      account: "Filed by the author at the consolidated-correction revision, from the independent review finding that the function-member red does not discriminate the census-absent arm. UNEXECUTED: no run exists for this refusal, and none is claimed. Instrument change (fixture denylist) awaits its own scope decision.",
    },
  ],
  disposition: Open,
}

// srv13 AND srv15 NAME ONE BOARD (recorded 2026-11-05; the operator keeps srv15, "bobo"). Both slots read
// ASRock Rack ALTRAD8UD-1L2T board serial BR80S6102300049 with host NIC 9c:6b:00:e7:ca:63. srv13's first
// contact (2026-10-07) found the controller at 192.168.1.247, MAC 9c:6b:00:e7:c9:83, on BMC 2.07.00, and
// pushed 3.22.00. srv15's in-band recovery (2026-10-29) found it at 192.168.1.248, MAC 9c:6b:00:e7:c9:e7.
// On 2026-11-05 the router lists .247 inactive and .248 active, and .248's unauthenticated Redfish root
// answers ServiceEntryPointUUID 6e884505-ba5e-49f2-af66-cedf82ef8d8c, the one srv13's capture carries.
// The merge is left open, not done, because srv13's slot is not only a name: the machine-intake witnesses
// replay its 2026-10-07 captures at .247 through srv13's own write-controller row, and the row model has no
// way to name an endpoint a board HAD. Repointing them at srv15 (.248) would assert the captures came from
// an address they did not.
data srv13_srv15_sighting_revision: CommitSha = "64671d19744d133e78e2e9af35602833cfa07dc5"


data srv13_and_srv15_name_one_board: IntegrationConcern = IntegrationConcern {
  identity: "srv13_and_srv15_name_one_board",
  kind: SuspectedFork {
    authorities: DistinctAuthorities {
      first: decl_ref(module_path: "gunbc.fleet.fleet_host_identity", decl_name: "operator_host_srv13"),
      second: decl_ref(module_path: "gunbc.fleet.fleet_host_identity", decl_name: "operator_host_srv15"),
      rest: [
        decl_ref(module_path: "gunbc.fleet.fleet_intent", decl_name: "srv13_baseboard"),
        decl_ref(module_path: "gunbc.fleet.fleet_intent", decl_name: "srv15_baseboard"),
      ],
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.machine_intake.bmc_write_controller", decl_name: "srv13_bmc_write_controller"),
    tail: [
      decl_ref(module_path: "gunbc.machine_intake.bmc_write_controller", decl_name: "srv15_bmc_write_controller"),
      decl_ref(module_path: "gunbc.hostname_allocation", decl_name: "gunbc_fleet_hostname_allocations"),
      decl_ref(module_path: "gunbc.fleet.machine_board", decl_name: "machine_board_rows"),
      decl_ref(module_path: "gunbc.machine_intake.mtjade1_factory_network", decl_name: "srv13_bmc_observed_network"),
    ],
  },
  question: "Which slot is the ALTRAD8UD-1L2T with board serial BR80S6102300049, and how do the machine-intake witnesses keep replaying its 2026-10-07 captures at 192.168.1.247 once srv13 stops being a fleet host?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: srv13_srv15_sighting_revision,
      evidence: FreeSemigroup {
        head: CitesArtifact {
          label: "artifacts/bmc/srv13-first-contact-2026-10-07/bmc-3.22.00/root_Systems_system.json (SerialNumber BR80S6102300049)",
          sha256: Sha256Digest { hex: "fd4ad69ffdbef8db4e21eedb4b7c107627abd662d9f0bc3fd0effff1484469da" as Sha256DigestHex },
        },
        tail: [
          CitesArtifact {
            label: "artifacts/bmc/srv15-inband-recovery-2026-10-29/redfish_v1_Systems_system.json (SerialNumber BR80S6102300049)",
            sha256: Sha256Digest { hex: "281dbfefd5d55d5c30b2d6f730d45d28062162bc9a2d5ce6be396a30bbfe948a" as Sha256DigestHex },
          },
          CitesArtifact {
            label: "artifacts/bmc/srv13-first-contact-2026-10-07/FINDINGS.txt (BMC 192.168.1.247 MAC 9c:6b:00:e7:c9:83; host NIC 9C:6B:00:E7:CA:63)",
            sha256: Sha256Digest { hex: "81bb5b9576a26c909ed769ebb3ae75cc85c3397192ec82e2a98613e329041567" as Sha256DigestHex },
          },
          CitesArtifact {
            label: "artifacts/bmc/srv15-inband-recovery-2026-10-29/00_README.txt (BMC 192.168.1.248 MAC 9c:6b:00:e7:c9:e7; board serial BR80S6102300049; host lease from NIC 9c:6b:00:e7:ca:63)",
            sha256: Sha256Digest { hex: "6f4a3c900238b2575d386bd4b6d96cb014e1d8439d3b2274b988d8644b8e0d4e" as Sha256DigestHex },
          },
        ],
      },
      account: "Both slots' captures report board serial BR80S6102300049 and host NIC 9c:6b:00:e7:ca:63, an Intel I210 address burned into the board; only the controller's MAC and lease differ, across a BMC firmware push from 2.07.00 to 3.22.00 that srv13's own capture records. Read-only on 2026-11-05: the controller at .248 serves Redfish with srv13's captured ServiceEntryPointUUID, and the router shows srv13's reservation (.247) inactive. srv15's recovery also found the root credential changed by hand without a record, which is what srv13's forced first rotation would leave. Not established: whether the MAC change came from the firmware push or from a later reflash.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "gunbc.fleet.fleet_host_identity", decl_name: "operator_host_srv15") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.machine_intake.bmc_write_controller", decl_name: "srv15_bmc_write_controller"),
        control: decl_ref(module_path: "test.claim.machine_intake.machine_intake_bmc_write_controller_witness", decl_name: "srv15_admits_a_per_write_approval_at_its_own_controller"),
        statement: "the board's write-controller row admits a per-write approval only at the board's own current controller and refuses the standing grant",
      },
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.machine_intake.mtjade1_factory_network", decl_name: "srv13_bmc_observed_network"),
        control: decl_ref(module_path: "test.claim.machine_intake.machine_intake_bmc_forced_first_rotation_witness", decl_name: "the_forced_state_admits_only_its_own_controller_and_build"),
        statement: "the forced-first-rotation and arrival witnesses keep replaying the board's 2026-10-07 factory 403 and Manager captures against the controller as it was then (192.168.1.247, OpenBMC 3.22.00), and still refuse another controller or build",
      },
    ],
    next: climbs_when(capability: "a write-controller row (or the witnesses' supplied controller) can name the endpoint a board HAD at a capture's time apart from the endpoint it has now, so srv13's 2026-10-07 captures replay against srv15's board; then operator_host_srv13, srv13_baseboard, srv13_bmc_write_controller and srv13's hostname row are deleted and every srv13 consumer is repointed at srv15"),
  },
}

data run_closure_typecheck_exceeds_eval_demand: IntegrationConcern = IntegrationConcern {
  identity: "run_closure_typecheck_exceeds_eval_demand",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "resolve_entry_graph_demand_acquired"),
    requirement: "a gunbc run pays memory and wall time for the part of its entry's closure that evaluation reaches, not for every module the import closure names, while every refusal that typechecking the closure raises today still fires where it fires today",
    standing: RequirementUnestablished { decided_by: "a design that names which typecheck obligations an unreached module still owes (its own refusals, its importers' bindings) and shows they can be discharged without typechecking its bodies; until then the requirement is a memory and wall-time observation, not an established obligation" },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "resolve_entry_graph_demand_acquired"),
    tail: [decl_ref(module_path: "v2.compiler.module_acquisition", decl_name: "acquisition_lookup")],
  },
  question: "Is the pre-entry typecheck of a gunbc run's whole demand-acquired closure owed, or is it the larger half of the private lanes' memory floor that no model has yet been asked to narrow? Measured at seed e1f753b9 with the private overlay: the private drift entry typechecks 2918 closure modules, the roster entry 3245, and evaluation touches 227-278 of them (about 9.5 percent); the isolated audit_packet_witness entry reaches 12.9 GiB at the end of pre-entry (closure_typecheck 664,822 ms over 2775 files) before evaluation starts. This floor is undesigned and carries no estimate: the whole-pool burst (keyed_module_reads_walk_the_whole_pool) is the named, repairable part, and removing it leaves this floor standing.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "f08a6ae4e44dc0636eda71f25f0009e97ffde1d1",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "resolve_entry_graph_demand_acquired") },
        tail: [],
      },
      account: "Bisect of the private projection-drift regression (2026-11-05) and two isolated srv1 runs (qn-roster-peak40: roster cgroup peak 35.88 GiB; qn-auditpacket-peak40: audit_packet_witness VmHWM 26.84 GiB) put roughly 13-16 GiB of each private lane in pre-entry typecheck and the rest in one whole-pool burst plus per-witness evaluation. The same floor shows up as wall time on small entries: a read-only runner_host_file_observe on srv3 (run 42037046961) spent its whole 15-minute step typechecking v2.compiler modules its entry's closure names and timed out before reading a drop-in. Recorded so a lane blocked on it can cite a named cause rather than an assertion; no fix is designed.",
    },
    tail: [],
  },
  disposition: Open,
}

data keyed_module_reads_walk_the_whole_pool: IntegrationConcern = IntegrationConcern {
  identity: "keyed_module_reads_walk_the_whole_pool",
  kind: SuspectedFork {
    authorities: DistinctAuthorities {
      first: decl_ref(module_path: "v1_compiler.cli_run.entry_resolve", decl_name: "with_module_path_index"),
      second: decl_ref(module_path: "v1_compiler.cli_run.source_layout_lookup", decl_name: "module_storage_relative"),
      rest: [decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_decl_facts_at")],
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "v1_compiler.cli_run.entry_resolve", decl_name: "module_declaration_fact_at"),
    tail: [
      decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_decl_facts_at"),
      decl_ref(module_path: "v2.lens.module_graph", decl_name: "module_declaration_facts_at_live"),
    ],
  },
  question: "Where is a module found by name? gunbc.source_layout says the name determines the path (DESIGN section 3: a location read out of a file is a second authority, and makes finding one module cost reading all of them), and gunbc run's demand acquisition already finds modules that way through module_storage_relative. The keyed reads module_declaration_fact_at and eval_decl_facts_at instead answer from a whole-pool index built by reading every pool file's declaration, so their first call costs the population read they were written to avoid.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "f08a6ae4e44dc0636eda71f25f0009e97ffde1d1",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "v1_compiler.cli_run.entry_resolve", decl_name: "module_declaration_fact_at") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_decl_facts_at") }],
      },
      account: "Found while choosing the repair for the private audit_packet burst (strategy.audit_packet audit_module_facts, measured +8.3 GiB in 16 s from one module_declaration_facts call over the composed pool of 10164 files). Moving that consumer to either keyed read would move the burst to the first lookup and remove nothing, because module_declaration_fact_at reads through with_module_path_index and eval_decl_facts_at filters decl_facts_for_roots_shared. The repair belongs in the keyed reads: derive the storage path from the name per pool root and read that one file, keeping multiplicity across roots so DeclarationRefAmbiguous still fires.",
    },
    tail: [],
  },
  disposition: Open,
}

// #15175's synthesized derived-equality bodies bind the std comparison helpers they call by NAME
// SPELLING, which resolves through the HOLDER module's import set -- so whether a type has a
// derived == depends on an incidental import in the holder, not on equality. v2.std.symbol_index
// (imports std.algebra without map_values_eq) versus v2.std.node (imports zip_eq) is that accident
// on either side of the import list. Interim, filed with the fix that adds the fail-closed
// synthesis gate equality_helpers_visible: when a helper is not in view the derived is skipped and
// the holder refuses at its authored comparison, located. The root disposition: the compiler's own
// construction binds these helpers by DECLARING identity, as the derived equality binds `==`
// 
// itself; when that lands, delete the gate and cover it in self_host_equality_admission_witness.
// RE-LAND UPDATE 2026-11-06: the re-base at 4f581cb5 binds helpers by declaring identity (qualified
// call + census gate); the import-view gate named above lived only in the #15175 line and is gone
// from the DAG. The committed stage0 mirror still carries the old bearer pending heal publication.
data equality_synthesis_helper_binding_is_import_authority: IntegrationConcern = IntegrationConcern {
  identity: "equality_synthesis_helper_binding_is_import_authority",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_synth_qcall"),
    requirement: "a generated comparison body binds the equality vocabulary it calls (std.algebra map_values_eq / zip_eq, std.optional optional_eq, and the routed equality functions) by the declaring identity of the named declaration, independent of the holder module's import set, as the derived equality already binds `==` by the type's own declaration",
    standing: RequirementEstablished { by: CitesArtifact { label: "new-interpreter compile of a pre-#15175 dag tree: 49 hard 'function std.algebra.map_values_eq not found in scope (<derived:v2.std.symbol_index>)' -- resolution of the synthesized body tracked the holder's selective imports", sha256: Sha256Digest { hex: "88c2cf1e3de156a200f8bf5fefdb03e075de3ab7577e8b0b4c8b3d6c89e9d6c2" as Sha256DigestHex } } },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_synth_qcall"),
    tail: [
      decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_synthesized_for"),
      decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_derived_body_emitted"),
      decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_helper_declared"),
      decl_ref(module_path: "std.algebra", decl_name: "map_values_eq"),
    ],
  },
  question: "Should synthesized equality calls carry a resolved declaring reference (like the derived equality's own == binding) instead of a name spelling resolved through the holder's imports? Trigger REACHED: the re-base at 4f581cb5 binds helpers by declaring identity and the import-view gate is gone from the DAG; the row stays Open until the executed validation named in the latest sighting retires it.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "3bb5cbff9dad86fec9636a6f5ba82a675b504e66",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "v2.std.symbol_index", decl_name: "SymbolIndex") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_synth_compare") }],
      },
      account: "symbol_index imports std.algebra without map_values_eq while v2.std.node imports zip_eq; the same synthesized-body mechanism resolves in one holder and dangles in the other, so the import set -- not the equality model -- decides. Observed as 49 hard diagnostics under a new interpreter over a dag tree predating #15175's import co-update.",
    },
    tail: [ConcernSighting {
      revision: "3bb5cbff9dad86fec9636a6f5ba82a675b504e66",
      evidence: FreeSemigroup {
        head: CitesArtifact { label: "main-tree host_effect closure compile with the #15175 interpreter: 1 blocking diagnostic (CreateCause), derived bodies clean -- green only because every holder imports what the emitter spells", sha256: Sha256Digest { hex: "7cc9e9d96b7c0c51734e99422f98fcdefbc04e2f425cf22cc3a8f8f1b777e71c" as Sha256DigestHex } },
        tail: [],
      },
      account: "On main's own tree the family is latent, not broken: the co-updated imports carry every spelled name, so the import-as-authority defect shows only when emitter and imports drift (mixed-tree compile above) or a new holder forgets a name.",
    }, ConcernSighting {
      revision: "ae95c5e073e7",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "v2.std.diagnostic", decl_name: "NonEmptyDiagnostics") },
        tail: [],
      },
      account: "AUTHORING LEAK, STATED AS AN INTERIM, SCOPE: FOREIGN HELPERS ONLY. The emitted module v2.std.diagnostic (src/v2/std/diagnostic.dag) must import, for the compiler's synthesized equality bodies ONLY (hand-written code in the module uses none of these names): from std.algebra: zip_eq, map_values_eq. A module is made to import names that only the compiler's synthesized body uses. A module's OWN declarations -- including its own synthesized equality bodies -- are visible in that module by definition: the one predicate equality_derived_body_emitted answers from the module's own symbol table PLUS its named imports, and helpers the declaring module itself declares never require an import. A module importing itself (import v2.std.diagnostic { equality_derived_* } inside v2/std/diagnostic.dag, attempted at 3bc7bc26f297) is an import-graph SELF-LOOP forbidden by the acyclicity law main enforces, and main has no precedent for it: std.node imports only std.algebra helpers. Dissolution trigger: a synthesized equality body references its helpers by the declaring module's path (std.algebra), not through the consumer's import scope -- at that point zip_eq and map_values_eq are deleted from the std.algebra import verbatim, as listed. OBSERVATION: CI v2-bootstrap at 334f4ed refused the emitted build with E0425 'cannot find function equality_derived_non_empty_diagnostics in this scope' at the emitted v2_std_diagnostic.rs:590:30 -- a nested structural comparison inside a sibling derived body lowered to a call of a body the definition door had skipped because its FOREIGN helpers were not imported; importing zip_eq and map_values_eq (the ruled foreign-helper interim) makes every structural sibling in this closure emittable, which is the closure CI then judges. RESIDUAL OF THIS FAMILY (open; OWNED BY ITS OWN MAIN SLICE adhoc-a166f310-af0, filed by silent-bee-845 to start after #15972 lands -- deliberately NOT widened into #15972, whose failure mode for this residual is loud, an E0425 at emit, never a silent wrong answer, and it does not reach the closure #15972 judges): the definition door asks the predicate about the body's own FOREIGN helpers only; it does not yet ask it transitively about nested sibling declarations, so a future sibling whose own foreign imports are missing would leave a dangling nested call. The repair, when that slice runs, is transitive recursion of the SAME predicate over the plan's reachable declarations -- not a second check, and not an import self-loop.",
    }, ConcernSighting {
      revision: "4e94027d72ec",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "v2.std.runtime", decl_name: "EvaluationEnvironment") },
        tail: [],
      },
      account: "SECOND MODULE ENUMERATED, SAME CLASS, FIX-FORWARD ON MAIN (fixes main-red v2-bootstrap run 42215276019 job 127883604511 at pre-merge PR head 1d2448554aa6 tree 2f828ba5 (NOT at merged 90549a23b6c3 — attribution corrected per review): E0425 'cannot find function equality_derived_evaluation_environment in this scope' at emitted v2_std_runtime.rs:667:194, 3 errors in all, stderr_tail truncated at first_error). v2.std.runtime (src/v2/std/runtime.dag) must now import, for its synthesized equality bodies ONLY: from std.algebra, additionally zip_eq and map_values_eq (hand-written code in the module uses neither). Needed because EvaluationEnvironment { bindings: Map<EnvironmentBindingKey, RuntimeValue> } takes the FOREIGN map_values_eq value step and the compared List fields take zip_eq; without them the one predicate skips those bodies and same-module == nodes lower to the skipped derived calls -- the loud E0425 the interim documents, not a silent wrong answer. Full recorded list for mechanical deletion across both interim modules: v2.std.diagnostic -- std.algebra {zip_eq, map_values_eq}; v2.std.runtime -- std.algebra {zip_eq, map_values_eq} (appended to fold_list). Dissolution trigger unchanged.",
    }, ConcernSighting {
      revision: "35d5ab5d93ce",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "v2.std.symbol_index", decl_name: "SymbolIndex") },
        tail: [],
      },
      account: "THIRD MODULE ENUMERATED, SAME CLASS, FIX-FORWARD ON MAIN (fixes v2-bootstrap run 42225685321 job 127918456923 at fix-forward head 35d5ab5d93ce: E0425 'cannot find function equality_derived_symbol_index in module crate::v2_std_symbol_index' at emitted v2_compiler_symbol_index_fill.rs:391:34, retained_probe_root on the runner host). v2.std.symbol_index (src/v2/std/symbol_index.dag) must now import, for its synthesized equality bodies ONLY: from std.algebra, additionally zip_eq and map_values_eq (hand-written code in the module uses neither; it already imported fold_list and the map helpers). Needed because SymbolIndex carries Map<QualifiedName, ...> fields whose value steps take the FOREIGN map_values_eq and compared List steps take zip_eq; without them the one predicate skips those bodies and same-module == nodes lower to the skipped derived calls -- loud E0425, never silent. Full recorded list for mechanical deletion across all three interim modules: v2.std.diagnostic -- std.algebra {zip_eq, map_values_eq}; v2.std.runtime -- std.algebra {zip_eq, map_values_eq} (appended to fold_list); v2.std.symbol_index -- std.algebra {zip_eq, map_values_eq} (appended to the existing list). Dissolution trigger unchanged.",
    }, ConcernSighting {
      revision: "cf31183f8d46",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "v2.std.symbol_index", decl_name: "SymbolIndex") },
        tail: [],
      },
      account: "WHOLE-CLOSURE ENUMERATION APPLIED IN ONE PASS (per manager ruling msg_6ccb1ed4: no one-CI-hour-per-name iteration; superset-biased: a false positive costs one recorded interim import, a false negative costs a CI hour; NOT individually CI-evidenced beyond the three modules above). Method: entries from instrument_targets.dag (self_host_entry src/v2/compiler/source_root_eval.dag; v2_native_cli_entry src/v2/cli/compile_cli.dag); BFS over the import graph (module map v2.->src/v2, v1.->src/v1, else dag/); derived-body needs mirror equality_step_helpers in src/v1/stage0/src/v1_compiler_infer.rs: Map<> field -> std.algebra map_values_eq, List<> -> std.algebra zip_eq, Optional<> -> std.optional optional_eq, recursing through nested declared types; candidate filter: types referenced textually by any closure module containing ==. Fixed point reached: re-run reports zero remaining required imports. Every module below got ONLY the listed foreign helper names (each addition behind the two-line INTERIM comment; all removable mechanically when the predicate reads the declaring module's own symbol table): extdeps.external_authority { zip_eq }; extdeps.languages.json.emit { zip_eq }; extdeps.languages.json.grammar { zip_eq }; extdeps.rust.cargo { zip_eq }; extdeps.uri_path { zip_eq }; extdeps.version.semver { zip_eq }; gunbc.crate_partition { map_values_eq, optional_eq, zip_eq }; gunbc.namespace_cut.ambient_name_home { optional_eq }; gunbc.parse_population_refusals { zip_eq }; std.bit { zip_eq }; std.cache_interface { zip_eq }; std.coercion { zip_eq }; std.effects { zip_eq }; std.graph { map_values_eq, zip_eq }; std.judgment_contract { zip_eq }; std.literal_elaboration { zip_eq }; std.materialization_ladder { zip_eq }; std.occurrence_identity { map_values_eq, zip_eq }; std.operation_argv { zip_eq }; std.operator_realization { zip_eq }; std.pareto { zip_eq }; std.source_annotation { map_values_eq, zip_eq }; std.syntax { map_values_eq, zip_eq }; std.termination { zip_eq