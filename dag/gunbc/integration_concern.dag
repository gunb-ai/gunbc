// CREDENTIAL CONSOLIDATION, P2b: the per-provider presentation helpers release a sealed credential's
// secret only after admission at the call, but the language confines construction and callers, not
// field reads. Decided with cool-badger-99 (2026-11-08): no seed transport change and no corpus census;
// the field carries a name nothing else uses, and the exact grep below is the check every credential PR
// carries.
data credential_p2b_base_revision: CommitSha = "230ec4869280e4d33e7aff973d32341d80f851f0"

data credential_secret_field_reads_confined_by_name_not_construction: IntegrationConcern = IntegrationConcern {
  identity: "credential_secret_field_reads_confined_by_name_not_construction",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "extdeps.cloud.gcp.iam", decl_name: "GcpImpersonatedAccessCredential"),
    requirement: "a sealed credential's secret is read only by its provider's presentation helper, after admission at the call; no other module can obtain the secret and send it unjudged",
    standing: RequirementEstablished { by: CitesDeclaration { declaration: decl_ref(module_path: "std.credential_admission", decl_name: "present_credential") } },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "extdeps.cloud.gcp.iam", decl_name: "gcp_impersonated_presentation"),
    tail: [decl_ref(module_path: "extdeps.github.app", decl_name: "github_installation_presentation")],
  },
  question: "Can any module other than the provider read secret_released_only_by_admission? Construction is sealed (sole_constructor) and the mint's callers are confined (admit_callers), but a field read is not refused by the language, so a holder could send the secret without admission.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: credential_p2b_base_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "extdeps.cloud.gcp.iam", decl_name: "gcp_impersonated_presentation") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "std.credential_admission", decl_name: "present_credential") }],
      },
      account: "THE CHECK: `git grep -n secret_released_only_by_admission -- '*.dag'`. Any read of the field must spell its name, whether by dot access or by record pattern, so this is an exact count of reads, not a heuristic. ALLOWED SITES, the complete list: (1) dag/std/credential_admission.dag -- the sealed CredentialPresentation arm that carries the released secret, its construction in present_credential, and their comments; (2) dag/extdeps/cloud/gcp/iam.dag -- the GcpImpersonatedAccessCredential field declaration, the constructor in impersonated_access_credential_of, the read in gcp_impersonated_presentation, and its comment; (3) dag/extdeps/github/app.dag -- the GitHubInstallationCredential field declaration, the constructor in installation_credential_of, the read in github_installation_presentation, and its comment; (4) each adapter that owns an operation, matching CredentialPresented and invoking that operation in the same call -- today test.claim.credential_dispatch_probe echo_with_gcp_credential and the witness's send_presented; each production adapter (heal publication, P3) is added here when it lands. The provider presentations admit only adapters and the witness's test rows (admit_callers), so a CredentialPresentation is never held by a caller that could retain it or reuse it for a retry; (5) dag/test/claim/credential_confinement_witness.dag -- the sealed-literal probe string, which the compiler must refuse; (6) this row. A hit in any other file is a bypass and is rejected in review. Every credential PR body carries this grep's output. RESTORATION TRIGGER: v2's transport realizing credential admission at dispatch, or a language field-read confinement (admit_readers) consumed by these two types -- either makes a read outside the provider unwritable rather than visible.",
    },
    tail: [],
  },
  disposition: Open,
}

// CREDENTIAL CONSOLIDATION, the gh disposition (plan review 2, section 4): a gh CLI route authenticates
// from gh's own ambient login and issues its own HTTP sends inside the subprocess, so the
// presentation path (std.credential_admission present_credential) cannot admit them. They are retained
// as a declared subprocess boundary, each with its migration path, rather than migrated blind.
data gh_disposition_base_revision: CommitSha = "afffc115416352a86e522dddf89b733bc679c88d"

data gh_cli_routes_authenticate_from_ambient_login: IntegrationConcern = IntegrationConcern {
  identity: "gh_cli_routes_authenticate_from_ambient_login",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "std.credential_admission", decl_name: "present_credential"),
    requirement: "every bearer-carrying GitHub request is made with a credential admitted at that request; a gh CLI route instead authenticates inside the subprocess from GH_TOKEN or GITHUB_TOKEN (in that precedence) or gh's stored login, and gh may issue several HTTP requests per launch (--paginate), none of which gunbc admits",
    standing: RequirementEstablished { by: CitesDeclaration { declaration: decl_ref(module_path: "std.credential_admission", decl_name: "present_credential") } },
  },
  affected: FreeSemigroup {
    head: decl_field_ref(module_path: "extdeps.github.pulls", decl_name: "github", field_name: "CliPulls"),
    tail: [
      decl_field_ref(module_path: "extdeps.github.actions_runs", decl_name: "github", field_name: "CliActionsRuns"),
      decl_field_ref(module_path: "extdeps.github.ci_runner", decl_name: "github", field_name: "CliOrgSelfHostedRunners"),
      decl_field_ref(module_path: "extdeps.github.org_actions", decl_name: "github", field_name: "CliOrgRunnerGroups"),
      decl_field_ref(module_path: "extdeps.github.organizations", decl_name: "github", field_name: "CliOrganizations"),
      decl_ref(module_path: "extdeps.tools.gh", decl_name: "gh_run_download_argv"),
      decl_ref(module_path: "extdeps.tools.gh", decl_name: "gh_run_download_command"),
    ],
  },
  question: "Which credential does each gh CLI route send, and when is it judged? gunbc controls only the process launch; the token, its lifetime and every HTTP send belong to gh.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: gh_disposition_base_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_field_ref(module_path: "extdeps.github.pulls", decl_name: "github", field_name: "CliPulls") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "extdeps.tools.gh", decl_name: "gh_run_download_command") },
          CitesDeclaration { declaration: decl_ref(module_path: "std.credential_admission", decl_name: "present_credential") },
        ],
      },
      account: "THE POPULATION at this revision: nine service operations across five services, plus the artifact-download command family. The services are anchored by their namespace fields (an operation is a child of its service, so a module-level reference to the operation name would not resolve): github.CliPulls ListOpenJson, ViewMergedJson, SquashMergeExactHead; github.CliActionsRuns ListRunsJson; github.CliOrgSelfHostedRunners ListOrgRunnersPage, GetOrgRunner; github.CliOrgRunnerGroups ListRunnerGroupRepositoriesJson, CreateRunnerGroupJson; github.CliOrganizations GetOrganization -- found by `git grep -n -E 'argv: \\[\\s*\"gh\"|^\\s*\"gh\", ' -- dag/extdeps`. The artifact-download family, extdeps.tools.gh gh_run_download_argv and gh_run_download_command, builds `gh run download` through gh_program() and so is not found by that grep; its live consumer is gunbc.runner.runner_user_session_receipt, executed by runner_user_session_receipt_observed. AUTHENTICATION: gh reads GH_TOKEN, then GITHUB_TOKEN, ahead of its stored login, all inside the subprocess. THE DISPOSITION: retained as a subprocess boundary, not migrated in this program's P2 -- a check before launching gh cannot be reported as admitting the requests gh then makes. EACH ROUTE'S MIGRATION is a direct REST operation behind an operation adapter (the pattern of test.claim.credential_dispatch_probe echo_with_gcp_credential), made when that route's consumer migrates. It is not a drop-in: gunbc.instruments cross_pr_contradiction_instrument and path_writer_set_instrument read gh's changedFiles from ListOpenJson, which the REST list endpoint does not return; pr_containment_instrument shares that route but reads only number and headRefName. A route whose only consumer is a retired census instrument goes with it instead of migrating. This row closes when no gh route remains, or as distinct with a reason per route.",
    },
    tail: [],
  },
  disposition: Open,
}

// The revision the accumulator-copy measurement was made against (parse ladder, native --release).
data accumulator_move_source_revision: CommitSha = "708057ca4b3a4eb046adab96e10586ccb6cb335c"

// A linear (non-backtracking) accumulator that is a record field is copied on every persistent update:
// record-update lowering emits rc_map_insert(record.field.clone(), ..). Measured: aliased im insert
// 1.7-3.7 us (grows with size) vs uniquely owned 0.38-0.52 us. The v2 parser's own sharing is
// backtracking, so it was fixed at its source (SpanIndex built from the committed tree) and this
// emitter gap is recorded, not built.
data emitter_never_moves_unique_accumulator_field: IntegrationConcern = IntegrationConcern {
  identity: "emitter_never_moves_unique_accumulator_field",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "v1.compiler.ownership", decl_name: "build_movable_set"),
    requirement: "the v1 emitter moves a uniquely-owned accumulator field (projection b.f of a threaded non-fold accumulator) into a persistent update (rc_map_insert, merge, list push, set insert) instead of cloning it, so a linear accumulator does not copy-on-write every update",
    standing: RequirementUnestablished { decided_by: "a prototype of the sound rule, fail-closed (wrong liveness is rustc E0507/E0382, never mem::take), run on the parse ladder: if the linear accumulator's update cost falls to the uniquely-owned figure, the rule is established" },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "v1.compiler.ownership", decl_name: "build_movable_set"),
    tail: [
      decl_ref(module_path: "v1.compiler.ownership", decl_name: "moved_at_its_only_argument"),
      decl_ref(module_path: "v1.compiler.ownership", decl_name: "analyze_dying_base_sites"),
    ],
  },
  question: "Should one liveness rule subsume build_movable_set/moved_at_its_only_argument, FoldAccUnwrapProof/fold_body_safe_field_moves and analyze_dying_base_sites (TCO only) so a projection of a threaded accumulator is moved when it dies at the update?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: accumulator_move_source_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "v1.compiler.ownership", decl_name: "build_movable_set") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "v1.compiler.ownership", decl_name: "analyze_dying_base_sites") }],
      },
      account: "Microbench: aliased im insert 1.7-3.7 us vs uniquely owned 0.38-0.52 us vs std HashMap 0.10 us. An emitter move rule was prototyped and captured 0% on the parser (IDX_UNIQUE=0) because that sharing is backtracking; the existing leaves none covers a projection of a threaded non-fold accumulator.",
    },
    tail: [],
