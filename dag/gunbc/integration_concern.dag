data execution_grant_composition_integration: IntegrationConcern = IntegrationConcern {
  identity: "execution_grant_composition_integration",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "product.fabric.execution", decl_name: "ExecutionGrant"),
