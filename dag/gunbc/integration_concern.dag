// Every module the target-syntax ledger rows implicate, read from the ledger rather than restated, so
// a row added there widens this concern's relevance with no edit here.
data target_syntax_ledger_ref: DeclarationRef = decl_ref(module_path: "gunbc.target_syntax_transcription", decl_name: "target_syntax_debts")
data target_syntax_built_by_hand_in_application_modules: IntegrationConcern = IntegrationConcern {
  identity: "target_syntax_built_by_hand_in_application_modules",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "v2.std.compilers.target_model", decl_name: "TargetValueExpressionProjection"),
    requirement: "an application written as ordinary .dag is emitted to Swift and TypeScript by the target model and each language's grammar rows, so no application module names a target language's syntax constructors (DESIGN section 4, one grammar read in both directions)",
    standing: RequirementEstablished { by: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.approve_ios_app", decl_name: "approve_ios_transcribed_swift_frontier") } },
  },
  affected: FreeSemigroup { head: target_syntax_ledger_ref, tail: flat_map(target_syntax_debts, d => debt_declarations(d: d)) },
  question: "Which forms must the shared value-expression projection and the declaration door gain -- and which browser and Node surfaces must be modelled as extdeps -- before each ledgered module can be written as ordinary .dag and emitted, and in what order do they unblock the most modules?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "fe796707f7a302c58830523b17b528c02c988f61",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: target_syntax_ledger_ref },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "v2.extdeps.languages.swift_expr_door", decl_name: "swift_syntax_forms_outside_value_expression_projection_frontier") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.approve_ios_app", decl_name: "approve_ios_bodied_member_frontier") },
        ],
      },
      account: "Read with git grep over dag/ and src/ for calls to any function named sw_* or ts_*, excluding the grammars (extdeps/languages and src/v2/extdeps/languages) and the compiler's emit and parse claims, and three name collisions that are not builders (v2.compiler.infer ts_declared_inhabitants_*, gunbc.instruments.emit_host_transport ts_host_stdout_is_the_sum, test.claim.scoped_authorization_scope_wire sw_scope). Swift: the five approve_ios_swift_* printers build every generated app file's tree; three of them are recorded by the app's own frontier rows, the two that print from a model (enrolment machine, operation errors) were recorded nowhere, and six app files are hand-written with retained rows. TypeScript: twelve browser and server client modules build their scripts as ts_* trees -- the largest are gunbc.roadmap.roadmap_component and gunbc.roadmap.roadmap_issue_sort, mostly ts_ident, ts_member, ts_call, ts_binop and string literals over DOM, fetch, timers and storage -- and none carried a dissolution or frontier row, so that debt was an untracked stall until the ledger. On the route side: the Swift door spells only identifiers, positional calls, member access, bool and int literals and memberwise init, and lists the rest at swift_syntax_forms_outside_value_expression_projection_frontier; the TypeScript route already emits closures, enum unions, imports and record construction from ordinary .dag by execution (src/v2/test/claim/execution typescript_*_by_execution), but has no row naming the forms it cannot, and no extdeps model of the browser surfaces the clients call. Not read: other targets (bash, YAML, CSS, HTML), and whether any client could migrate today.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "v2.std.compilers.target_model", decl_name: "TargetValueExpressionProjection") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.approve_ios_swift_wire", decl_name: "approve_ios_wire_swift_file"),
        control: Absent,
        statement: "a migrated module's emitted file stays what its consumer runs today: the app's Swift files and the served scripts change only where the migration intends, read against the files the printers produce at the revision the migration starts from",
      },
    ],
    next: climbs_when(capability: "the shared value-expression projection and the declaration door print the forms the ledgered modules use (statements, closures, string and collection literals, operators, switch bodies), and the browser and Node surfaces they call are modelled as extdeps, SUFFICIENT FOR one ledgered module per target -- a Swift model printer and a TypeScript client -- to be rewritten as ordinary .dag, emitted by the route, and its ledger row removed"),
  },
}

// THE CAS GENERATION RULE IS DECIDED TWICE. Whether an attempt's expectation is admissible against what
// a compare-and-set slot holds is answered by std.durable_compare_and_set's cas_expectation_admits AND,
// independently, by the ProbedAbsent arm of gunbc.durable_cas_file_store's cas_compare_and_set_outcome.
// The fork is measured, not inferred: a mutation that makes the std arm admit ExpectSlotGeneration against
// an absent observation leaves EVERY row of test.claim.durable_cas_file_store_wet_witness green (branch
// sharp-otter-429/d6-witness-main-mutant-stdfold at 2167708a09307e9c24dc0718401e02570d4b690f, six rows
// PASS), while the same retired ordering restored in the store's own arm turns exactly the empty-store row
// red and leaves the other five green (505c4b6e2839beefe999a13cea3502b1d7822df2). A mutation of the std
// rule cannot reach the store's rows at all, which is what a duplicated rule looks like in execution. The
// std fold's only consumer is gunbc.roadmap.roadmap_event_carrier's roadmap_event_parent_admitted.
data cas_generation_expectation_admitted_twice: IntegrationConcern = IntegrationConcern {
  identity: "cas_generation_expectation_admitted_twice",
  kind: SuspectedFork {
    authorities: DistinctAuthorities {
      first: decl_ref(module_path: "gunbc.durable_cas_file_store", decl_name: "cas_compare_and_set_outcome"),
      second: decl_ref(module_path: "std.durable_compare_and_set", decl_name: "cas_expectation_admits"),
      rest: [],
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.durable_cas_file_store", decl_name: "cas_compare_and_set_outcome"),
    tail: [
      decl_ref(module_path: "std.durable_compare_and_set", decl_name: "cas_expectation_admits"),
      decl_ref(module_path: "gunbc.roadmap.roadmap_event_carrier", decl_name: "roadmap_event_parent_admitted"),
      decl_ref(module_path: "test.claim.durable_cas_file_store_wet_witness", decl_name: "a_generation_expectation_against_an_empty_store_refuses_and_writes_no_slot_by_real_execution"),
    ],
  },
  question: "Which declaration decides whether an attempt's generation expectation is admissible against what a compare-and-set slot holds, and in particular who refuses ExpectSlotGeneration against a slot that was never created?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: d6_witness_measurement_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.durable_cas_file_store", decl_name: "cas_compare_and_set_outcome") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "std.durable_compare_and_set", decl_name: "cas_expectation_admits") },
          CitesDeclaration { declaration: decl_ref(module_path: "test.claim.durable_cas_file_store_wet_witness", decl_name: "a_generation_expectation_against_an_empty_store_refuses_and_writes_no_slot_by_real_execution") },
        ],
      },
      account: "Six rows of the store's wet witness were run at two heads. Mutating the std fold's absent arm to admit a generation expectation: six green, no row moved. Mutating the store's own ProbedAbsent arm to commit a generation expectation at the successor of the EXPECTED generation -- the ordering the store's header retires -- reddened exactly the empty-store row. The store reads the slot and decides inline; it never calls the std fold. So the rule the store enforces and the rule the std fold enforces are two rules, kept in agreement by nothing.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "std.durable_compare_and_set", decl_name: "cas_expectation_admits") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.durable_cas_file_store", decl_name: "cas_compare_and_set_outcome"),
        control: decl_ref(module_path: "test.claim.durable_cas_file_store_wet_witness", decl_name: "a_generation_expectation_against_an_empty_store_refuses_and_writes_no_slot_by_real_execution"),
        statement: "an ExpectSlotGeneration attempt against a store holding nothing refuses, the refusal names the absence rather than a competing version, and the store is left with no slot file at all",
      },
    ],
    next: climbs_when(capability: "the file store's absent-slot arm consumes std.durable_compare_and_set's cas_expectation_admits and its inline copy is deleted, so a mutation of that one rule reddens a store row -- measured today, a mutation of that rule reddens none"),
  },
}

// THE FOLD'S OWN CLAIMS HAVE NO EXECUTING WITNESS. test.claim.durable_compare_and_set states the fold's
// decision table, including the superseded-generation refusal the store relies on, but its module resolves
// none of its own types: it imports neither std.types (which declares NonEmptyStr) nor
// std.durable_compare_and_set. Measured at base bbec474015b with the same compiler used for the runs beside
// the row above: the entry refuses with 134 hard errors, the first an unresolved type 'LiveTreeDisposition'
// at the file's first data declaration, and the same 134 with src/v1 added as a source root. The claim lane
// discovers rows by the test fn marker in the file and runs them by name, so an entry that never resolves
// has zero executable rows: its nine rows are unevaluated claims, and they have been silently rotting. A row
// of mine added there was reverted for exactly this reason -- it could not go red.
data cas_fold_claims_have_no_executing_witness: IntegrationConcern = IntegrationConcern {
  identity: "cas_fold_claims_have_no_executing_witness",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "std.durable_compare_and_set", decl_name: "cas_expectation_admits"),
    requirement: "a generation-expectation rule that the store enforces has a witness row that executes at the entry it is claimed from, so a change to the rule cannot land without a row going red",
    standing: RequirementEstablished {
      by: CitesDeclaration { declaration: decl_ref(module_path: "test.claim.durable_cas_file_store_wet_witness", decl_name: "a_generation_expectation_against_an_empty_store_refuses_and_writes_no_slot_by_real_execution") },
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "test.claim.durable_compare_and_set", decl_name: "an_update_from_a_superseded_generation_refuses_and_reports_the_current_head"),
    tail: [
      decl_ref(module_path: "test.claim.durable_compare_and_set", decl_name: "an_attempt_against_the_last_generation_refuses_as_exhausted_and_one_below_commits_to_it"),
      decl_ref(module_path: "std.durable_compare_and_set", decl_name: "cas_expectation_admits"),
      decl_ref(module_path: "test.claim.durable_cas_file_store_wet_witness", decl_name: "a_generation_expectation_against_an_empty_store_refuses_and_writes_no_slot_by_real_execution"),
    ],
  },
  question: "Does any claim in test.claim.durable_compare_and_set lack a witness elsewhere -- and if none does, is that entry revived (given its imports, its rows re-checked against the current fold) or retired with each claim named against the row that now covers it?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: d6_witness_base_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "test.claim.durable_compare_and_set", decl_name: "an_update_from_a_superseded_generation_refuses_and_reports_the_current_head") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "std.durable_compare_and_set", decl_name: "cas_generation_exhausted") }],
      },
      account: "Compiling the file as its own entry produced 134 hard errors, the first an unresolved type at the file's first data declaration; adding src/v1 as a source root changed nothing. The row I had added there was reverted rather than left as an unexecutable claim. The same rule is witnessed today only at the store surface, by the row named in the requirement above.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: HomeUnresolved {
      question: "revive the entry beside std.durable_compare_and_set's own claims, or retire it and name where each of its nine claims is witnessed",
    },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "test.claim.durable_compare_and_set", decl_name: "an_update_from_a_superseded_generation_refuses_and_reports_the_current_head"),
        control: Absent,
        statement: "an update attempted from a generation the store no longer holds refuses and reports the generation the store does hold; wherever that claim is witnessed, it must go red if the refusal stops naming the current head",
      },
    ],
    next: climbs_when(capability: "the entry compiles at its own entry and its rows execute, or the file is retired with every claim named against the row that covers it"),
  },
}

data broker_status_decision_is_unreceipted: IntegrationConcern = IntegrationConcern {
  identity: "broker_status_decision_is_unreceipted",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.auth.approval_gate", decl_name: "approval_standing_read"),
    requirement: "an operator decision acted on by a non-operator runner job is the broker's MAC-receipted store record, verifiable by the runner with a verify-only key half, not a bare loopback status response",
    standing: RequirementUnestablished { decided_by: "approval_store_receipt_mac_key_secret_ref is not yet minted, and a verifier holding the current single key could also mint receipts, so a verify-only half must exist first" },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.fleet.printer_execution_hold", decl_name: "printer_hold_broker_standing"),
    tail: [
      decl_ref(module_path: "gunbc.fleet.printer_execution_hold", decl_name: "printer_hold_operator_grant"),
      decl_ref(module_path: "gunbc.fleet.printer_operator_approval", decl_name: "approve_and_print"),
    ],
  },
  question: "How does a runner job verify that a decision read from the broker's loopback escalation-status route is the operator's recorded decision? Residual until then: a loopback-reachable forger of the status response can present Approved for the printer hold release and for the bed-clear approval, which both read that route at the same trust.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "b79423bb29e6b7a2804dc0bd0d3db629eb5688f4",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.auth.approval_gate", decl_name: "approval_standing_read") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "gunbc.fleet.printer_execution_hold", decl_name: "printer_hold_broker_standing") }],
      },
      account: "The printer job runs as the plain CI runner and cannot read the operator-only approval store, so the printer hold release reads the decision through the broker's unauthenticated loopback status route, the same route and trust as the converge's bed-clear approval. The MAC-receipted store route exists but its key is unminted.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "gunbc.auth.approval_gate", decl_name: "approval_standing_read") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.fleet.printer_execution_hold", decl_name: "printer_hold_operator_grant"),
        control: Absent,
        statement: "a hold releases only on an approved decision over this exact hold and generation; Denied, Expired, Pending and mismatched intent refuse",
      },
    ],
    next: climbs_when(capability: "the store-receipt MAC key is minted and pinned with a verify-only half the runner holds, and approval_standing_read verifies the receipt before returning a standing for both the printer hold and bed-clear consumers"),
  },
}


data typed_argv_allowlist_refuses_a_modeled_format_constant: IntegrationConcern = IntegrationConcern {
  identity: "typed_argv_allowlist_refuses_a_modeled_format_constant",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.typed_argv_exec", decl_name: "typed_argv_portable_argv_char_allowed"),
    requirement: "a command word that a modeled constant DECLARES (the stat format gunbc.owned_directory owned_directory_stat_format, spelled %F|%U|%G|%a) is admitted by the typed argv route that carries it over ssh, instead of being refused as an unportable token",
    standing: RequirementEstablished { by: lab_stat_format_refusal },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.owned_directory", decl_name: "owned_directory_stat_format"),
    tail: [
      decl_ref(module_path: "gunbc.typed_argv_exec", decl_name: "typed_argv_portable_argv_char_allowed"),
      decl_ref(module_path: "gunbc.executor_privileged_operation", decl_name: "ReadDirectoryIdentity"),
    ],
  },
  question: "How does a modeled format constant reach a remote typed argv without widening the portable character allowlist by hand: does the format word travel as a typed value the route quotes, or is the route-local allowlist a second authority over what a declared word may spell?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "0c283689c72649d1ee996cf3f52ae1949636006f",
      evidence: FreeSemigroup {
        head: lab_stat_format_refusal,
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "gunbc.owned_directory", decl_name: "owned_directory_stat_format") }],
      },
      account: "srv1_lab_dashboard_preflight_wet at this head returned the source decision Ready, then refused at step initial-reconcile: the stat of /opt/gunbc-lab was carried over ssh and typed_argv refused the argv token %F|%U|%G|%a as outside the portable allowlist. The word is the one owned_directory_stat_format declares. The srv1 lab no longer reaches this route (its transport is selected local from placement), so the defect stays live for any genuinely remote apply, srv2 next.",
    },
    tail: [],
  },
  disposition: Open,
}

data lab_stat_format_refusal: SightingEvidence = CitesArtifact {
  label: "loyal-deer-449 srv1 preflight log ld449-pf15877.log at head 0c283689c726, step initial-reconcile refusal",
  sha256: Sha256Digest { hex: "253cedfce9673503494475953815c7ba199dfcb9fd6f71d202fb8abbf4871d21" as Sha256DigestHex },
}

// THE SECOND LOCAL COPY OF ONE RULE, SIGHTED BY THE Mt. COLLINS UI ASSET OBSERVER (DESIGN section 6b:
// "the trigger is the second local implementation of one rule"). Verified at 9230f9d0893486a2d3812d2669b1cc120aa67add
// with `git grep -nE "fn [a-z_]*(index_of|starts_with|ends_with|match_at)\\(" -- dag`: nine declarations answer two
// questions -- where does a needle first occur in a haystack, and does this sequence end with that one.
// The list is a candidate inventory from that grep, not a complete census of the tree.
data byte_sequence_search_reimplemented_per_module: IntegrationConcern = IntegrationConcern {
  identity: "byte_sequence_search_reimplemented_per_module",
  kind: SuspectedFork {
    authorities: DistinctAuthorities {
      first: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of"),
      second: decl_ref(module_path: "gunbc.instruments.known_red_derivation", decl_name: "known_red_index_of"),
      rest: [
        decl_ref(module_path: "extdeps.version.semver", decl_name: "semver_index_of"),
        decl_ref(module_path: "gunbc.instruments.emit_copy_qualification_transport", decl_name: "path_ends_with"),
        decl_ref(module_path: "gunbc.auth.heal_publisher_provision", decl_name: "ends_with_segment"),
        decl_ref(module_path: "extdeps.languages.json.grammar", decl_name: "json_text_starts_with_at"),
        decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_match_at"),
        decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_starts_with"),
        decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_string_ends_with"),
      ],
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of"),
    tail: [
      decl_ref(module_path: "gunbc.instruments.known_red_derivation", decl_name: "known_red_index_of"),
      decl_ref(module_path: "extdeps.version.semver", decl_name: "semver_index_of"),
      decl_ref(module_path: "gunbc.instruments.emit_copy_qualification_transport", decl_name: "path_ends_with"),
      decl_ref(module_path: "gunbc.auth.heal_publisher_provision", decl_name: "ends_with_segment"),
      decl_ref(module_path: "extdeps.languages.json.grammar", decl_name: "json_text_starts_with_at"),
      decl_ref(module_path: "std.bytes", decl_name: "bytes_octets"),
      decl_ref(module_path: "std.algebra", decl_name: "string_contains"),
    ],
  },
  question: "Where does one octet-sequence search live, and which local copies migrate to it? std.bytes today carries octet constructors and no search; std.algebra's string_contains answers whether text contains text and reports no offset, so nothing in std is a home a caller can already use. The candidates: does one rule cover octets and text, or does an octet search and a text search stay two rules with two homes?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "9230f9d0893486a2d3812d2669b1cc120aa67add",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "gunbc.instruments.known_red_derivation", decl_name: "known_red_index_of") }],
      },
      account: "PR 15724's reviewer ran the grep above at the PR head and counted a sixth local copy of the same two rules. The new copies exist because the observation walks a fetched JavaScript asset by BYTE OFFSET -- the offset and length it commits must be offsets into the asset's octets, so a text-level contains test cannot produce the evidence -- and std offers no octet-level index or suffix primitive. The copies are not generalizing because no std home exists to generalize INTO: adding one here means choosing std.bytes' shape for six call sites in five modules, three of which are read by other lanes' sweeps.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: HomeUnresolved { question: "std.bytes (which holds octet constructors, no search) or std.algebra beside string_contains (whose needle is text, not octets)? The two questions decide each other: an octet search placed in std.algebra would duplicate string_contains, and one placed in std.bytes leaves text callers with a second rule." },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of"),
        control: Present { value: decl_ref(module_path: "test.claim.machine_intake.mtcollins1_ui_status_asset_observation_witness", decl_name: "w_an_asset_that_never_reads_the_rows_status_has_nothing_to_quote") },
        statement: "no match is an ABSENT optional, never a zero offset, and every caller distinguishes the two by matching the optional rather than comparing it to none -- the PR's evidence gate failed open exactly once when a no-match reading was inverted, so a shared helper must carry Absent through unchanged and a migration is only done when a no-match input still refuses",
      },
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.machine_intake.mtcollins1_ui_status_asset_observation", decl_name: "ui_octets_index_of"),
        control: Present { value: decl_ref(module_path: "test.claim.machine_intake.mtcollins1_ui_status_asset_observation_witness", decl_name: "w_the_excerpt_is_not_checkable_when_the_offset_moves_by_one") },
        statement: "the offset it reports is an index into OCTETS, not into characters or UTF-16 units, because the committed excerpt records are byte offsets and byte lengths within the asset",
      },
    ],
    next: climbs_when(capability: "a shared octet-sequence index/starts-with/ends-with rule exists in std with a home chosen above, and one existing caller outside this PR is migrated to it and its witness stays green -- the first migration proves the shape fits a call site the author does not own; the remaining copies then follow, and the leaf copies are deleted in the same change that migrates them"),
  },
}

data integration_concerns: List<IntegrationConcern> = [support_restriction_scope, started_operation_ownership, duct_placement_chosen_by_hand, target_syntax_built_by_hand_in_application_modules, cas_generation_expectation_admitted_twice, cas_fold_claims_have_no_executing_witness, typed_argv_allowlist_refuses_a_modeled_format_constant, broker_status_decision_is_unreceipted, byte_sequence_search_reimplemented_per_module]
fn fork_rows_have_distinct_authorities() -> Bool {
  all(integration_concerns, c => fork_authorities_distinct(c: c))
}

// ---------------------------------------------------------------------------------------------
// THE READING PATH.
//
//   CONCERN_CHANGED=a.b,c.d CONCERN_REFERENCED=e.f gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/integration_concern.dag
//   CONCERN_SUBTREE=product gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/integration_concern.dag
//
// Module paths are comma-separated. With neither variable set it lists every open concern.
// Deriving `changed` and `referenced` from a diff is not done here; the caller supplies them.

fn env_list(name: String) -> List<String> {
  match shell.Env.Get(name: name as NonEmptyStr).value {
    Absent => []
    Present { value: v } => filter(split(s: v, delimiter: ","), x => x != "")
  }
}

fn declaration_text(r: DeclarationRef) -> String {
  let base = concat(r.module_path as String, concat(" ", r.decl_name as String))
  match r.field {
    WholeDeclaration => base
    NamedField { field_name: f } => concat(base, concat(".", f as String))
    TypeParameter { name: n } => concat(base, concat("<", concat(n as String, ">")))
  }
}

fn evidence_text(e: SightingEvidence) -> String {
  match e {
    CitesDeclaration { declaration: d } => concat("declaration ", declaration_text(r: d))
    CitesHistorical { declaration: h } => join(["declaration ", h.module_path as String, " ", h.decl_name as String, " at ", h.at as String], "")
    CitesArtifact { label: l, sha256: d } => join(["artifact sha256 ", d.hex as String, " (", l as String, ")"], "")
  }
}

fn sighting_lines(g: ConcernSighting) -> List<String> {
  concat(
    [concat("  sighting at ", g.revision as String), concat("    account: ", g.account as String)],
    map(concat([g.evidence.head], g.evidence.tail), e => concat("    cites: ", evidence_text(e: e))),
  )
}

fn requirement_lines(k: ConcernKind) -> List<String> {
  match k {
    SuspectedFork { authorities: _ } => []
    SuspectedCapabilityGap { model: m, requirement: r, standing: st } => [
      concat("  model: ", declaration_text(r: m)),
      concat("  requirement: ", r as String),
      match st {
        RequirementEstablished { by: e } => concat("  requirement established by: ", evidence_text(e: e))
        RequirementUnestablished { decided_by: d } => concat("  requirement NOT established; decided by: ", d as String)
      },
    ]
  }
}

fn obligation_lines(d: ConcernDisposition) -> List<String> {
  match d {
    Triaged { home: _, preserve: ps, next: _ } => map(ps, o => join(["  preserve (", declaration_text(r: o.holder), "): ", o.statement as String], ""))
    _ => []
  }
}

fn concern_text(c: IntegrationConcern) -> String {
  join(concat(concat(concat(
    [
      concat("- ", c.identity as String),
      concat("  kind: ", kind_label(k: c.kind)),
      concat("  disposition: ", disposition_label(d: c.disposition)),
      concat("  question: ", c.question as String),
      concat("  modules: ", join(concern_modules(c: c), ", ")),
    ],
    requirement_lines(k: c.kind)),
    obligation_lines(d: c.disposition)),
    flat_map(concat([c.sightings.head], c.sightings.tail), g => sighting_lines(g: g))), "\n")
}

fn reading_text(title: String, rows: List<IntegrationConcern>) -> String {
  join(concat(concat([title], map(rows, c => concern_text(c: c))), concat(["unconnected routes:"], map(unconnected_routes, r => concat("- ", r)))), "\n")
}

fn main() -> CliWireResponse {
  let changed = env_list(name: "CONCERN_CHANGED")
  let referenced = env_list(name: "CONCERN_REFERENCED")
  let subtree = env_list(name: "CONCERN_SUBTREE")
  let open_rows = filter(integration_concerns, c => concern_is_open(c: c))
  let text = if count(subtree) > 0 {
    reading_text(title: concat("open integration concerns in subtree ", join(subtree, ",")), rows: flat_map(subtree, p => concerns_in_subtree(prefix: p, rows: open_rows)))
  } else if count(changed) + count(referenced) > 0 {
    reading_text(title: "open integration concerns relevant to the given scope", rows: concerns_for(s: ConcernScope { changed: changed, referenced: referenced }, rows: open_rows))
  } else {
    reading_text(title: "all open integration concerns", rows: open_rows)
  }
  CliWirePrintable { bytes: text, exit: ExitSuccess }
}
