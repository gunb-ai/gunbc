data gcp_token_lifetime_condition_and_expiry_unconsumed: IntegrationConcern = IntegrationConcern {
  identity: "gcp_token_lifetime_condition_and_expiry_unconsumed",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "extdeps.cloud.gcp.iam", decl_name: "default_token_lifetime"),
    requirement: "Google's GenerateAccessToken contract has a default and an ordinary maximum of one hour, a twelve-hour maximum only for service accounts allowed by constraints/iam.allowServiceAccountCredentialLifetimeExtension, and a response expireTime. The model holds default_seconds 3600 and max_seconds 43200 with no condition, no inspected production request path consumes it, and the returned expiry is discarded, so no downstream claim about credential validity can consume it.",
    standing: RequirementUnestablished { decided_by: "a cited read of Google's projects.serviceAccounts.generateAccessToken reference (default and ordinary maximum lifetime, the twelve-hour maximum under constraints/iam.allowServiceAccountCredentialLifetimeExtension, and the expireTime response field) carried into extdeps.cloud.gcp.iam; the declarations in this row are the implementation being questioned, not the authority for the requirement" },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "extdeps.cloud.gcp.iam", decl_name: "default_token_lifetime"),
    tail: [
      decl_ref(module_path: "extdeps.cloud.gcp.iam", decl_name: "TokenLifetime"),
      decl_ref(module_path: "gunbc.auth.optional_impersonation", decl_name: "optional_impersonation"),
      decl_ref(module_path: "gunbc.auth.gcp_iam_bootstrap_authority", decl_name: "bootstrap_authority_may_grant"),
      decl_ref(module_path: "gunbc.auth.gcp_operation_wait", decl_name: "gcp_operation_budget_fits_actuation_allowance"),
    ],
  },
  question: "Where does the conditional lifetime rule live, and which request paths consume it instead of restating 3600? The upstream model owes the provider default, the ordinary limit, the conditional extended limit and the condition for a named account; the wire form (a protobuf Duration string) belongs to the API model, not to optional_impersonation's concat; and a claim that a credential is still usable (gcp_operation_budget_fits_actuation_allowance compares two configured durations only) needs the observed expireTime.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "8d22701ad6ca9edf3e98ad5562efcd04031f4f36",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "extdeps.cloud.gcp.iam", decl_name: "default_token_lifetime") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.auth.optional_impersonation", decl_name: "optional_impersonation") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.auth.gcp_iam_bootstrap_authority", decl_name: "bootstrap_authority_may_grant") },
        ],
      },
      account: "Found while writing the DESIGN worked example: default_token_lifetime has no consumer; optional_impersonation restates the 3600 s limit as a retired where-refinement and drops expire_time; bootstrap_authority_may_grant restates 3600 as a bare literal.",
    },
    tail: [],
  },
  disposition: Open,
}

data jwks_cache_freshness_without_origin_evidence: IntegrationConcern = IntegrationConcern {
  identity: "jwks_cache_freshness_without_origin_evidence",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.auth.oidc_id_token_verification", decl_name: "jwks_cache_decode"),
    requirement: "Google directs verifiers to use the key response's Cache-Control to decide when to fetch again, and HTTP freshness is computed against the response's current age, with directives that can require validation or prohibit storage (RFC 9111). The cache marks an entry fresh by local age against a fixed 3600 s and stores only fetched_at and body, so it cannot derive freshness from the response that produced it.",
    standing: RequirementUnestablished { decided_by: "a cited read of Google's ID-token verification guidance (refetch the keys per the response's Cache-Control) and RFC 9111 (freshness from current age; directives that require validation or forbid storage) carried into an extdeps model; the cache declarations in this row are the implementation being questioned, not the authority for the requirement" },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.auth.oidc_id_token_verification", decl_name: "jwks_cache_decode"),
    tail: [
      decl_ref(module_path: "gunbc.auth.oidc_id_token_verification", decl_name: "google_oidc_jwks_cache_ttl_seconds"),
      decl_ref(module_path: "gunbc.auth.oidc_id_token_verification", decl_name: "google_oidc_jwks_fetch_max_seconds"),
    ],
  },
  question: "Where do the origin's freshness directives (an observation), the verifier's retention cap (policy) and the reuse decision (their composition) live? A local cap may shorten a permitted freshness interval and may never authorize reuse the response forbids. Separately, the fetch budget is a string handed to GetWithin's NonEmptyStr input: unit, admissible range and curl's zero-means-no-timeout sentinel are three obligations a retype alone does not discharge.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "8d22701ad6ca9edf3e98ad5562efcd04031f4f36",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.auth.oidc_id_token_verification", decl_name: "jwks_cache_decode") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "gunbc.auth.oidc_id_token_verification", decl_name: "google_oidc_jwks_fetch_max_seconds") }],
      },
      account: "Found while writing the DESIGN worked example on durations, by reading jwks_cache_decode and the JWKS fetch at this revision.",
    },
    tail: [],
  },
  disposition: Open,
}

data operator_route_sighting_revision: CommitSha = "6530632b94e12a393dae4e6589ed9c84ebbe1f65"

// RAISED BY WORK ITEM adhoc-9058fcaa-636 (the srv4 strata operator route), 2026-11-07, on PR #16043.
// The operator route's serving unit became a POLICY FACT (harness_operator_unit_policy) rather than a
// second hard-wired route (DESIGN 3: a policy, not a type and not a mechanism). Reading it from
// product.fabric.selection's priced supply fold was ruled out at authoring: a route is not priced supply
// structure (CandidateOffer carries structure only), and the serving -> select_supply path is itself a
// declared frontier. So the hand-chosen constant forks std.decision select_realization: both answer
// "which realization serves this demand", and while the unit is a constant the fold's chosen supply and
// the operator route's unit can disagree with nothing checking it. WHY IT IS NOT BLOCKING TODAY, stated
// against the state THIS diff leaves (my first version claimed exactly one operator candidate existed,
// which this very diff falsifies by adding the srv4 strata row -- review 91848): TWO route rows now exist,
// so the disagreement is expressible in principle. What keeps it from mattering today is contingent, not
// structural -- the policy names the fabric router, the strata figures are all TranscribedUncited so a
// strata round refuses at the wire before any request leaves (gunbc.harness.harness_reasoning_wire
// harness_strata_reasoning_kwargs), and nothing else can select a second route. The obligation is carried,
// not deferred silently: the lookup refuses with a typed cause when the policy names a unit no row
// carries, on bind, placement AND observation, and those refusals are witnessed.
data operator_route_unit_chosen_by_hand: IntegrationConcern = IntegrationConcern {
  identity: "operator_route_unit_chosen_by_hand",
  kind: SuspectedFork {
    authorities: DistinctAuthorities {
      first: decl_ref(module_path: "gunbc.harness.harness_operator_route", decl_name: "harness_operator_unit_policy"),
      second: decl_ref(module_path: "std.decision", decl_name: "select_realization"),
      rest: [],
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.harness.harness_operator_route", decl_name: "operator_route_for_unit"),
    tail: [
      decl_ref(module_path: "gunbc.harness.harness_seat", decl_name: "harness_bind_operator"),
      decl_ref(module_path: "gunbc.harness.harness_seat", decl_name: "harness_operator_placement_for_unit"),
    ],
  },
  question: "Which authority names the serving unit of the operator route: the harness_operator_unit_policy value, or std.decision select_realization once serving offers reach the priced supply fold? While the unit is a hand-chosen constant, can the fold's chosen supply and the operator route's unit disagree with nothing checking?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: operator_route_sighting_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.harness.harness_operator_route", decl_name: "harness_operator_unit_policy") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "std.decision", decl_name: "select_realization") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.harness.harness_operator_route", decl_name: "operator_route_for_unit") },
        ],
      },
      account: "Seen while porting the lab's srv4 strata operator route to main: the port needed ONE fact naming which serving unit the operator endpoint answers for, and the only shaped choice available was a policy constant, beside the decision home that exists to make exactly that choice.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "std.decision", decl_name: "select_realization") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.harness.harness_operator_route", decl_name: "operator_route_for_unit"),
        control: Present { value: decl_ref(module_path: "test.claim.operator_endpoint_witness", decl_name: "the_placement_path_refuses_when_no_row_carries_the_named_unit") },
        statement: "when the choice moves to the decision home, a policy naming a unit no route row carries must still refuse with its typed cause on BOTH bind and placement -- no fallback to the fleet seat, because the refusal IS the point of the lookup (DESIGN 5: refuse, never widen)",
      },
    ],
    next: climbs_when(capability: "serving offers reach product.fabric.selection as priced supply structure (the flex_select_supply_consumer_frontier), so std.decision select_realization chooses over operator routes and harness_operator_unit_policy retires with this row"),
  },
}

// THE FLEET AUTOMATION PRINCIPAL HAS TWO NAMES (recorded 2026-11-08, PR 16079). The automation identity is
// spelled by two declarations that never import each other: gunbc.fleet.fleet_posix_accounts
// fleet_automation_user (name "gunbc-fleet", uid/gid 1001, the srv automation allocations) and
// gunbc.fleet.fleet_ssh_locus fleet_automation_principal_login ("gunbc-automation", the login the fleet SSH
// transport authenticates as and whose authorized_keys hold the fleet roster). They coexisted as separate
// standing notes until 16079 gave the diskless runner boot stage a REAL login account under the transport's
// name on every boot, which makes the divergence material: two routes could create two accounts or write the
// fleet keys to the wrong home. It is recorded UNRESOLVED -- which name is THE fleet automation principal is
// NOT decided by this row (gunbc.design_argument::single_authority).
data fleet_automation_principal_has_two_names: IntegrationConcern = IntegrationConcern {
  identity: "fleet_automation_principal_has_two_names",
  kind: SuspectedFork {
    authorities: DistinctAuthorities {
      first: decl_ref(module_path: "gunbc.fleet.fleet_posix_accounts", decl_name: "fleet_automation_user"),
      second: decl_ref(module_path: "gunbc.fleet.fleet_ssh_locus", decl_name: "fleet_automation_principal_login"),
      rest: [],
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.fleet.fleet_posix_accounts", decl_name: "fleet_automation_user"),
    tail: [
      decl_ref(module_path: "gunbc.fleet.fleet_ssh_locus", decl_name: "fleet_automation_principal_login"),
      decl_ref(module_path: "gunbc.runner.runner_host_medium", decl_name: "runner_host_fleet_authorized_keys_command"),
    ],
  },
  question: "Which declaration is the fleet automation principal's ONE authoritative POSIX identity -- fleet_automation_user (name gunbc-fleet, uid/gid 1001, the srv automation allocations) or fleet_automation_principal_login (gunbc-automation, the login the fleet SSH transport authenticates as and whose authorized_keys hold the fleet roster)? If they are one principal, one of these is a fork of the other; if they are two accounts, the boot stage that realizes a login account and the SSH locus that authenticates it must agree on which one, and the fleet keys must land in exactly one home.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "29452aa0398d504c37ec856acafe5caa7c304e35",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.fleet.fleet_posix_accounts", decl_name: "fleet_automation_user") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.fleet.fleet_ssh_locus", decl_name: "fleet_automation_principal_login") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.runner.runner_host_medium", decl_name: "runner_host_fleet_authorized_keys_command") },
        ],
      },
      account: "PR 16079's diskless runner boot stage (gunbc.runner.runner_host_medium runner_host_fleet_authorized_keys_command) was given the transport login fleet_automation_principal_login (gunbc-automation) -- it creates that account and writes the fleet authorized_keys into its home on every boot -- while the same automation identity is modelled elsewhere as fleet_automation_user (gunbc-fleet, uid/gid 1001) in fleet_posix_accounts, which owns the srv automation allocations and its login shell. The two names had coexisted as separate standing notes with no import between them; a boot-time account creation and authorized_keys write makes the divergence material rather than cosmetic, so it is recorded unresolved instead of the boot stage silently adopting one name.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: HomeUnresolved {
      question: "Which module owns the fleet automation principal's single POSIX identity -- gunbc.fleet.fleet_posix_accounts (fleet_automation_user, gunbc-fleet) or gunbc.fleet.fleet_ssh_locus (fleet_automation_principal_login, gunbc-automation)? Neither imports the other's name today; resolving names one authoritative declaration and makes the boot stage, the SSH-transport login, and the srv automation allocations all read it.",
    },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.runner.runner_host_medium", decl_name: "runner_host_fleet_authorized_keys_command"),
        control: Present { value: decl_ref(module_path: "test.claim.runner.runner_host_medium_fleet_keys_witness", decl_name: "the_fleet_boot_stage_authorizes_exactly_the_fleet_roster") },
        statement: "the boot stage writes exactly the fleet roster (gunbc.fleet.fleet_ssh_access fleet_authorized_keys) into ONE automation login's authorized_keys and no other principal; whichever name is designated authoritative, that witness must still pin the same login and the same two keys -- a resolution may not silently move the fleet keys to a different account or add a third identity",
      },
    ],
    next: climbs_when(capability: "one of fleet_automation_user and fleet_automation_principal_login is designated the authoritative fleet automation principal, the other is aliased to it or removed, and the boot stage, the SSH-transport login, and the srv automation allocations all read the surviving name -- proven by an existing witness that changes if either name is renamed, so the two cannot silently diverge again"),
  },
}

data equality_wall_three_site_measure_stopgap_interim: IntegrationConcern = IntegrationConcern {
  identity: "equality_wall_three_site_measure_stopgap_interim",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_admission_wall_note"),
    requirement: "the generic comparison forms at the three production fleet-converge sites (host_effect.dag host_effect_is_converge_loop_evidence, fleet_physical_inventory.dag fleet_nominal_rackmount_arithmetic_holds, compute_seat_ensure.dag seat_fell_by) resolve and judge through the declaring-scope equality admission, so the interim constructor-match and measure_count spellings are removed",
    standing: RequirementEstablished { by: CitesDeclaration { declaration: decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_argument_by_target") } },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.host.host_effect", decl_name: "host_effect_is_converge_loop_evidence"),
    tail: [
      decl_ref(module_path: "gunbc.fleet.fleet_physical_inventory", decl_name: "fleet_nominal_rackmount_arithmetic_holds"),
      decl_ref(module_path: "gunbc.compute.compute_seat_ensure", decl_name: "seat_fell_by"),
    ],
  },
        question: "The question this row carried: may the three production sites compare structurally, and where is that decided? While the wall stood the production fleet-converge entry (dag/gunbc/runner/runner_host_file_converge.dag) refused in RESOLVE at these sites (EqualityMemberUnjudgeable: CreateCause routed member inside a generic application at host_effect.dag, Measure sites at fleet_physical_inventory and compute_seat_ensure), so no fleet converge could run. The interim rewrites of #16045 (fleet) and #16099 (compute_seat_ensure, host_effect) closed that production refusal on main, and this row carried the record that they were interim and what their removal depended on. Each interim replaced a Measure comparison whose operands were same-unit by declaration (fleet: the declared sum and nominal_rackmount_units_declared were both RackUnit; rack: data rack_01_catalog_units IS navepoint_18u_open_frame_catalog.rack_units; seat: seat_fell_by declared before/after/granted all Kibibyte), which is why the measure_count cardinality comparison was faithful there -- measure_count names no units, so that faithfulness was a property of those declarations, not of the helper. The host_effect interim carried a drift risk the row recorded at the time: its hand-written match duplicated the constructor shape of data host_effect_converge_loop_evidence, so an edit to one spelling without the other would have classified the sentinel as OneShot instead of ConvergeLoop with no refusal. The named sentinel host_effect_apply_witness was not executable through the claim route at that pin (no import lines; resolve failed on the claim route; inventory in the retained 30-P-CAND.stderr), and it stayed unexecuted: the row claimed no executability either way. It remains rostered as an offline local recipe (WitnessExclusionRow in gunbc.ci.ci_layer_roots, classification OfflineLocalRecipe), with no gate enrollment. The dependency this row named for removal was the root repair, which had itself been blocked by an E0369 synthesis regression in the emitted source_root_eval closure (v2-bootstrap 42414168425, E0369 Rc<DemandEngine<Rc<NativeDemandValue>>>, the occurrence-based pairing of #15992); that pairing was measured unsound and deleted, and the repair that landed judges each written type argument where the declaration's own parameter occurs. The three sites now read as plain structural '==' again and the interims are deleted: see the disposition and the closing sighting, which carry the executions.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "1bdf7152c79b56933e069a66db86293559b191b3",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.host.host_effect", decl_name: "host_effect_is_converge_loop_evidence") },
        tail: [],
      },
      account: "Observed subject: main at 1bdf7152c79b56933e069a66db86293559b191b3, clean local release build, binary sha256 acd2d80336c2ce7ac2ff23ec621d5c58a0a4027c47d0be793f2d727015359962 (receipt of quiet-raven-506 / fierce-gull-111): the production fleet-converge entry exits 1 at resolve refusing at fleet_physical_inventory Measure, host_effect CreateCause and compute_seat_ensure Measure. A second observation at 708057ca4b3a4eb046adab96e10586ccb6cb335c (sleek-wren-619, --dry-run resolve) refuses at the same three sites. The turn is between f6f57e7e16cc6b68b2d4e02e3de8adc7d2421996 (fleet run 42230507796 resolved the same entry) and these revisions; the identified trigger is withheld (source range vs build provenance open). The stopgap patch base 4aa7a03c48bb6a0819adfee2cca095fb6ddadea4 is the lineage base, NOT an observation subject. Stopgap prepared at the lane owner's request (keen-otter authorization via cool-badger routing).",
    },
    tail: [
      ConcernSighting {
        revision: "eeae4193aaf5a1d7054a80eb0100a850244378b0",
        evidence: FreeSemigroup {
          head: CitesDeclaration { declaration: decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_argument_by_target") },
          tail: [CitesDeclaration { declaration: decl_ref(module_path: "v1.compiler.infer", decl_name: "is_unit_variant_phantom_argument") }],
        },
      account: "Closing read, measured at eeae4193aaf5 with a compiler built from that seed AND with the partition crates (src/v1/stage0_v1_infer, stage0_emit_core, stage0_std_surface) actually recompiled: the generated mirrors are pulled into those crates through #[path] includes outside their own src/, and a build that only rebuilds v1-compiler keeps the previously compiled rule -- that is how an earlier read on this branch reported these entries green while they still refused, and how a later read reported the shipped arms as failing specimens they in fact pass. Both of those reads are withdrawn. Measured with the crates recompiled, the two arms in the position they ship admit Holder<FooBarUnit> on a marker declared in the specimen module, Holder<RackUnitHeight>, Holder<Length>, Pair<Length, Nat> and the written Measure<Length, RackUnitHeight, Nat>, and the three entries that used to refuse each resolve with zero equality rows and zero resolve-failed headers; at 3d34fc61ca6e the same entries refused at host_effect_is_converge_loop_evidence, seat_fell_by and fleet_nominal_rackmount_arithmetic_holds. The only specimen refusals left are the alias-as-argument ones, recorded in their own row. The self-host instrument builds under rustc with zero E0369 where the previous head failed v2-bootstrap with E0369. The whole equality witness module runs 76 PASS and 4 FAIL, and those four fail identically under a compiler built from origin/main, so the repair admits the structural shapes without moving any refusal.",
      },
    ],
  },
  disposition: Integrated { evidence: IntegrationEvidence {
    integrated_at: "eeae4193aaf5a1d7054a80eb0100a850244378b0" as CommitSha,
    // The interim leaves this PR deletes, each cited at the revision that introduced it: #16099 rewrote the
    // host_effect CreateCause site and seat_fell_by, #16045 rewrote the fleet rackmount arithmetic. With the
