module gunbc.integration_concern

import std.types { String, List, Bool, Int, NonEmptyStr, CommitSha }
import std.optional { Optional, Present, Absent }
import std.algebra { FreeSemigroup }
import std.list { first_duplicate_by_key, distinct_by_key }
import std.decl_ref { DeclarationRef, DeclField, WholeDeclaration, NamedField, TypeParameter, decl_ref, decl_field_ref }
import std.content_hash { Sha256Digest, Sha256DigestHex }
import std.process { ExitSuccess }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import gunbc.guarantee_stall { NextRungTrigger, climbs_when }
import gunbc.target_syntax_transcription { target_syntax_debts, debt_declarations }
import extdeps.shell

// THE INTEGRATION REGISTER: where an unfinished reconciliation is recorded instead of remembered
// (DESIGN section 6b, continuous generalization; ruling gunbc.design_ruling
// continuous_generalization_is_two_sided). A change may leave integration unfinished; a material
// concern it identified stays discoverable here, with an explicit disposition, after the session
// that found it ends.
//
// WHAT THIS IS NOT. It is not a census and it gates nothing: rows are concerns somebody raised, not
// a population discovered completely. It is not evidence that pressure is operating: briefing does
// not read it, nothing schedules a periodic review over it, and no handoff transfers a row's
// ownership when a session ends. Those three routes are reported as unconnected (`unconnected_routes`)
// until they exist, and the view prints that list beside every reading.
//
// ONE MODULE, NOT ONE FILE PER ROW, DELIBERATELY. The one-row-per-file ledgers
// (gunbc.recurring_failure_mode, gunbc.rung_drop, gunbc.guarantee_stall) get their rosters from the
// seed's DERIVED_ROW_ROSTERS table; enrolling a fourth is a seed change this first cut does not
// need for a handful of rows. The cost is merge contention when two lanes add rows at once; the
// trigger to move to row files is that contention actually occurring.

// A SUSPECTED FORK NEEDS TWO DISTINCT AUTHORITIES. FreeSemigroup only proves one or more, and two
// entries need not be two sites, so the checked constructor is `distinct_authorities`, which refuses
// any repeated declaration. Outside this module the compiler refuses a DistinctAuthorities literal
// (sole_constructor). Inside it, a row literal cannot call the checked constructor (a data row has no
// way to unwrap the refusal), so `fork_rows_have_distinct_authorities` re-checks every committed fork
// row through it and the witness holds that reading -- validation over this module's rows, stated as such. A repeated identity is the module path and declaration name:
// two fields of one declaration are one authority for this purpose.
type DistinctAuthorities sole_constructor {
  first: DeclarationRef
  second: DeclarationRef
  rest: List<DeclarationRef>
}

// The identity key: module path and declaration name, joined by a space, which neither may contain.
fn declaration_identity(r: DeclarationRef) -> String {
  concat(r.module_path as String, concat(" ", r.decl_name as String))
}

fn distinct_authorities(first: DeclarationRef, second: DeclarationRef, rest: List<DeclarationRef>) -> DistinctAuthorities? {
  match first_duplicate_by_key(xs: concat([first, second], rest), key: r => declaration_identity(r: r)) {
    Present { value: _ } => Absent
    Absent => Present { value: DistinctAuthorities { first: first, second: second, rest: rest } }
  }
}

fn authorities_list(d: DistinctAuthorities) -> List<DeclarationRef> {
  concat([d.first, d.second], d.rest)
}

fn fork_authorities_distinct(c: IntegrationConcern) -> Bool {
  match c.kind {
    SuspectedFork { authorities: d } => match distinct_authorities(first: d.first, second: d.second, rest: d.rest) { Present { value: _ } => true Absent => false }
    SuspectedCapabilityGap { model: _, requirement: _, standing: _ } => true
  }
}

// BOTH KINDS ARE SUSPICIONS UNTIL TRIAGE. A fork is two or more authorities that seem to answer one
// question; a capability gap is one model that seems unable to express a concrete requirement, so
// pressure can start before anyone writes the second path. Neither is a confirmed defect: triage,
// not the kind, carries the conclusion.
type ConcernKind
  = SuspectedFork { authorities: DistinctAuthorities }
  | SuspectedCapabilityGap { model: DeclarationRef, requirement: NonEmptyStr, standing: RequirementStanding }

// WHETHER THE REQUIREMENT A GAP NAMES IS ITSELF ESTABLISHED. A gap can be recorded before anyone
// knows the requirement is real; recording it does not promote it. Unestablished names the reading
// that would decide it, and the view prints that beside the row.
type RequirementStanding
  = RequirementEstablished { by: SightingEvidence }
  | RequirementUnestablished { decided_by: NonEmptyStr }

// WHERE THE SHARED MEANING BELONGS is a semantic fact, separate from where the affected
// declarations are stored. Namespace ancestry is never consulted for it.
type ConceptHome
  = ExistingHome { model: DeclarationRef }
  | HomeUnresolved { question: NonEmptyStr }

// A CITATION AT THE REVISION WHERE IT EXISTED. Closing a concern usually deletes its superseded
// declarations, so these are plain names pinned to a commit and are never resolved against HEAD;
// a closed record must not break because the integration it records happened.
type HistoricalDeclaration {
  at: CommitSha
  module_path: NonEmptyStr
  decl_name: NonEmptyStr
}

// A RETAINED EXECUTION RESULT: which control ran, where the run's record is kept, and what it
// concluded. A control that merely exists is not a result.
type RetainedExecutionResult {
  control: DeclarationRef
  run: NonEmptyStr
  conclusion: NonEmptyStr
}

// WHAT A SIGHTING CITES. Facts with an owner are cited, not restated: a quantity is cited through
// the declaration that owns it, an output through its digest, a removed declaration at its
// revision. Nothing here is a second copy of a number another module carries.
type SightingEvidence
  = CitesDeclaration { declaration: DeclarationRef }
  | CitesHistorical { declaration: HistoricalDeclaration }
  | CitesArtifact { label: NonEmptyStr, sha256: Sha256Digest }

// ONE SIGHTING OF A CONCERN: the main revision it was made against, what it cites, and the account
// of what was seen -- the one irreducibly prose part. A later sighting of the same concern is
// appended to the row's `sightings`; it never adds a second row.
type ConcernSighting {
  revision: CommitSha
  evidence: FreeSemigroup<SightingEvidence>
  account: NonEmptyStr
}

// AN OBLIGATION A CONSOLIDATION MUST KEEP, held by a declaration, with the control that exercises
// it where one exists. Its holder is an implicated declaration, so it takes part in relevance.
type PreservedObligation {
  holder: DeclarationRef
  control: DeclarationRef?
  statement: NonEmptyStr
}

type IntegrationEvidence {
  integrated_at: CommitSha
  superseded: List<HistoricalDeclaration>
  replacement: FreeSemigroup<DeclarationRef>
  executions: FreeSemigroup<RetainedExecutionResult>
}

// THE DISPOSITION. Only Distinct, Withdrawn and Integrated close a row. Triaged carries its next
// step as gunbc.guarantee_stall NextRungTrigger: the capability owed stands alone and any work item
// is an `awaiting` referent beside it, so a work item reaching done, being archived or being
// reassigned closes nothing -- only Integrated evidence does.
type ConcernDisposition
  = Open
  | Triaged { home: ConceptHome, preserve: List<PreservedObligation>, next: NextRungTrigger }
  | Distinct { reason: NonEmptyStr, scope_examined: NonEmptyStr }
  | Withdrawn { reason: NonEmptyStr }
  | Integrated { evidence: IntegrationEvidence }

type IntegrationConcern {
  identity: NonEmptyStr
  kind: ConcernKind
  affected: FreeSemigroup<DeclarationRef>
  question: NonEmptyStr
  sightings: FreeSemigroup<ConcernSighting>
  disposition: ConcernDisposition
}

fn concern_is_open(c: IntegrationConcern) -> Bool {
  match c.disposition {
    Open => true
    Triaged { home: _, preserve: _, next: _ } => true
    Distinct { reason: _, scope_examined: _ } => false
    Withdrawn { reason: _ } => false
    Integrated { evidence: _ } => false
  }
}

fn kind_label(k: ConcernKind) -> String {
  match k {
    SuspectedFork { authorities: _ } => "suspected fork"
    SuspectedCapabilityGap { model: _, requirement: _, standing: _ } => "suspected capability gap"
  }
}

fn disposition_label(d: ConcernDisposition) -> String {
  match d {
    Open => "open, untriaged"
    Triaged { home: _, preserve: _, next: n } => concat("triaged; owed: ", n.capability)
    Distinct { reason: r, scope_examined: _ } => concat("closed as distinct: ", r as String)
    Withdrawn { reason: r } => concat("withdrawn: ", r as String)
    Integrated { evidence: e } => concat("integrated at ", e.integrated_at as String)
  }
}

fn kind_declarations(k: ConcernKind) -> List<DeclarationRef> {
  match k {
    SuspectedFork { authorities: a } => authorities_list(d: a)
    SuspectedCapabilityGap { model: m, requirement: _, standing: _ } => [m]
  }
}

fn disposition_declarations(d: ConcernDisposition) -> List<DeclarationRef> {
  match d {
    Triaged { home: h, preserve: ps, next: _ } => concat(match h { ExistingHome { model: m } => [m] HomeUnresolved { question: _ } => [] }, map(ps, o => o.holder))
    _ => []
  }
}

// Every declaration a concern implicates: its affected locations, the authorities or model its
// kind names, and, once triaged, an existing semantic home and the holders of preserved obligations.
// Sighting evidence is cited, not implicated, so it does not take part in relevance.
fn concern_declarations(c: IntegrationConcern) -> List<DeclarationRef> {
  concat(concat(concat([c.affected.head], c.affected.tail), kind_declarations(k: c.kind)), disposition_declarations(d: c.disposition))
}

fn concern_modules(c: IntegrationConcern) -> List<String> {
  distinct_by_key(xs: map(concern_declarations(c: c), r => r.module_path as String), key: m => m)
}

// RELEVANCE IS MEMBERSHIP, NOT ANCESTRY. A change is described by the modules it changes and the
// existing models it references -- a new consumer is relevant to the model it reads even when it
// changes nothing there. A concern is relevant when one of its declarations lives in one of those
// modules exactly. Sharing a namespace prefix with a concern never makes it relevant.
type ConcernScope {
  changed: List<String>
  referenced: List<String>
}

fn concern_relevant(c: IntegrationConcern, s: ConcernScope) -> Bool {
  let scope_modules = concat(s.changed, s.referenced)
  any(concern_modules(c: c), m => any(scope_modules, x => x == m))
}

fn concerns_for(s: ConcernScope, rows: List<IntegrationConcern>) -> List<IntegrationConcern> {
  filter(rows, c => concern_relevant(c: c, s: s))
}

// BROWSING, NOT RELEVANCE: every concern with a declaration inside the subtree, including concerns
// whose other declarations live elsewhere. The match is on whole path segments, so `product.print`
// does not contain `product.printing`.
fn module_in_subtree(m: String, prefix: String) -> Bool {
  m == prefix || starts_with(s: m, prefix: concat(prefix, "."))
}

fn concerns_in_subtree(prefix: String, rows: List<IntegrationConcern>) -> List<IntegrationConcern> {
  filter(rows, c => any(concern_modules(c: c), m => module_in_subtree(m: m, prefix: prefix)))
}

// THE ROUTES THAT WOULD MAKE THIS REGISTER EXERT PRESSURE, AND THAT DO NOT EXIST YET. Printed with
// every reading so a reader is never told the practice is operating when only the record is.
data unconnected_routes: List<String> = [
  "briefing: no work-item brief is generated with the relevant concerns; a brief carries them only if its author ran this view",
  "periodic review: nothing schedules a bounded integration review over open rows",
  "ownership handoff: a session or work item closing does not transfer the rows it raised; a row's obligation survives only as the row",
]

// ---------------------------------------------------------------------------------------------
