    requirement: "an operator decision acted on by a non-operator runner job is the broker's MAC-receipted store record, verifiable by the runner with a verify-only key half, not a bare loopback status response",
    standing: RequirementUnestablished { decided_by: "approval_store_receipt_mac_key_secret_ref is not yet minted, and a verifier holding the current single key could also mint receipts, so a verify-only half must exist first" },
