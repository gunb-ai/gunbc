module gunbc.cli_wire_host_admission

import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Terminal }
import std.types { String }
import v2.std.collection { List }

data cli_wire_host_receipt_disposition: Disposition = Terminal {
  reason: "Single authority for the SEED-GROWTH RECEIPT owed by the host renderer that carries a modeled CliWireResponse to a process's stdout and exit status. It declares WHICH hand-authored Rust declarations that change adds to the seed, why they exist, and what retires them. It does NOT admit them: the realization disposition is an operator judgment and fails closed in its absence, because a receipt that also granted its own admission would be the self-authorized dissolution failure DESIGN names. Terminal because the RECEIPT is permanent -- it outlives the code it describes, recording what was owed and on what trigger it was discharged."
}

// WHAT THIS GROWTH BOUGHT, STATED AS THE DEFECT IT REMOVED RATHER THAN AS A FEATURE.
//
// gunbc.cli_dispatch_surface already carried a row saying the scm family REFUSES UNWIRED: the
// modeled command surface computed an answer and no route existed to deliver it. So every scm
// entry was a value the host discarded -- specification without execution, DESIGN section 5's
// deepest trap, and flagged by the compiler's OWN surface model rather than discovered by review.
// The three declarations below are the route: classify a returned value as a CliWireResponse or
// refuse to call it one, decide what the host must DO about it, and exit accordingly.
//
// WHY THE CLASSIFIER CANNOT BE MODELED AWAY TODAY. It reads an interpreter Value -- a host runtime
// representation with no .dag denotation -- and asks whether it inhabits a declared coproduct. The
// answer is a fact about the modeled type, but the SUBJECT is a seed data structure, so the fold
// has to live where that structure lives. That is the same boundary every other value-projecting
// item in this roster sits on, not new debt of its own kind.

// exit_status_for_class IS NOT NEW BEHAVIOUR, and why the roster counts it anyway. Its body was
// MOVED out of main.rs's exit_status_for, which now delegates to it. It is enumerated below because
// it is a hand-authored declaration that did not exist before at that name and in that module, and
// netting a relocation against an addition is exactly the arithmetic gunbc.seed_growth_admission
// refuses -- but a reader counting BEHAVIOUR rather than DECLARATIONS should know that the
// process-exit path gained nothing here and was only made callable from the wire path beside it.
//
// This was a `data ... : String` row until review 58455 named it: a String declaration whose only
// purpose is commentary is the state DESIGN section 4c quarantines, because nothing distinguishes it
// from program data. It is authored rationale about why the roster has the shape it has, so it is an
// annotation. The fact it carried -- that one of the five is a relocation -- is stated inside the
// justification's own `reason`, where a consumer reading the receipt can see it.
data cli_wire_host_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
