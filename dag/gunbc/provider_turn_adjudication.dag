module gunbc.provider_turn_adjudication

import std.types { Bool, NonEmptyStr, String }

data provider_turn_adjudication_note: String = "Terminal disposition and native cause are distinct axes (provider-control-interface-audit §3.2). A turn may be terminally failed while its cause stays unclassified; unknown cause MUST NOT authorize automatic recovery. Wire event classification lands with the JSON-AST reader — this module owns the adjudication law, not fabricated protocol shapes."

type ProviderCauseClass
  = QuotaExhausted
  | AuthenticationRequired
  | RetryableTransient
  | NonRetryableRejected

type ProviderTurnCause
  = ProviderNativeCauseClassified {
      class: ProviderCauseClass
      evidence: NonEmptyStr
    }
  | ProviderNativeCauseUnknown {
      evidence: NonEmptyStr
    }

type ProviderTurnDisposition
  = ProviderTurnCompleted
  | ProviderTurnFailed {
      cause: ProviderTurnCause
    }
  | ProviderTurnNotObserved

data press_start_is_not_turn_note: String = "An admitted CodexPressStart names the attempt/turn/interface subject. It is NOT a turn observation. ProviderTurnNotObserved is the honest standing until a native terminal event is retained."

fn automatic_recovery_authorized(disposition: ProviderTurnDisposition) -> Bool {
  match disposition {
    ProviderTurnCompleted => false
    ProviderTurnNotObserved => false
    ProviderTurnFailed { cause } =>
      match cause {
        ProviderNativeCauseUnknown { evidence: _ } => false
        ProviderNativeCauseClassified { class, evidence: _ } =>
          match class {
            RetryableTransient => true
            QuotaExhausted => false
            AuthenticationRequired => false
            NonRetryableRejected => false
          }
      }
  }
}

fn press_display_finished(disposition: ProviderTurnDisposition) -> Bool {
  match disposition {
    ProviderTurnCompleted => true
    ProviderTurnFailed { cause: _ } => true
    ProviderTurnNotObserved => false
  }
}

fn press_display_running(disposition: ProviderTurnDisposition) -> Bool {
  match disposition {
    ProviderTurnNotObserved => false
    ProviderTurnCompleted => false
    ProviderTurnFailed { cause: _ } => false
  }
}
