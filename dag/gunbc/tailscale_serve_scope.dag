module gunbc.tailscale_serve_scope

import std.types { Bool, NonEmptyStr }
import std.key_relation { KeyRelation, KeyedResourceRelation, StateRelation }
import product.network_topology { NetworkEndpoint }
import extdeps.tailscale.serve {
  TailscaleServeEndpoint, TailscaleServeRouteKey, tailscale_serve_route_key,
  tailscale_endpoint_state_of, tailscale_endpoint_state_eq, tailscale_endpoint_value_eq,
}

// WHICH FLEET DEVICE A SERVE ROUTE LIVES ON. extdeps.tailscale.serve models the upstream serve
// surface (listener, mount, backend, the listener x mount route key); grounding that surface's
// device on this fleet's topology row (product.network_topology NetworkEndpoint) and keying routes
// per device are this repository's facts, not Tailscale's, so they live here. Held in extdeps they
// made every reader of the serve vocabulary -- the approval broker's access-path modeling
// included -- import the fleet topology and, through it, placement, DHCP and DNS.
//
// PER-DEVICE SERVE CONFIGURATION (tailscale.com/kb/1242): route identity is unique within one tailnet device's `serve` surface, not universe-wide. `node` is grounded on product.network_topology NetworkEndpoint with role TailscaleEndpoint — the fleet tailnet device rows in gunbc.fleet.fleet_intent_network (srv1_tailscale_endpoint, srv2_tailscale_endpoint, …), not a minted parallel identity. `service` names the upstream Serve CLI surface on that device.
type TailscaleServeService
  = | ServeCli

type TailscaleServeScope {
  node: NetworkEndpoint
  service: TailscaleServeService
}

type TailscaleServeRouteSubject {
  scope: TailscaleServeScope
  endpoint: TailscaleServeEndpoint
}

fn tailscale_serve_service() -> TailscaleServeService {
  ServeCli
}

fn tailscale_serve_scope(node: NetworkEndpoint) -> TailscaleServeScope {
  TailscaleServeScope { node: node, service: tailscale_serve_service() }
}

fn tailscale_serve_route_subject(
  scope: TailscaleServeScope,
  endpoint: TailscaleServeEndpoint,
) -> TailscaleServeRouteSubject {
  TailscaleServeRouteSubject { scope: scope, endpoint: endpoint }
}

// Scope identity keys on NetworkEndpoint.label only (see TailscaleServeScopeIdentity): fleet tailnet device rows are singleton authorities per label (gunbc.fleet.fleet_intent_network). If endpoint rows at the same label can diverge on host/address/role/locality, widen equality here before call sites depend on label alone.
fn tailscale_network_endpoint_label_eq(a: NetworkEndpoint, b: NetworkEndpoint) -> Bool {
  a.label == b.label
}

// THE COMPARED SCOPE IDENTITY, EXACTLY: node label plus service, nothing else. A keyed index uses the
// projection's own structural equality, so the projection must carry no more than was compared
// (two endpoints sharing a label but differing in host/address/role are one scope).
type TailscaleServeScopeIdentity {
  node_label: NonEmptyStr
  service: TailscaleServeService
}

fn tailscale_serve_scope_identity(scope: TailscaleServeScope) -> TailscaleServeScopeIdentity {
  TailscaleServeScopeIdentity { node_label: scope.node.label, service: scope.service }
}

fn tailscale_serve_route_scope_of(subject: TailscaleServeRouteSubject) -> TailscaleServeScopeIdentity {
  tailscale_serve_scope_identity(scope: subject.scope)
}

fn tailscale_serve_route_key_of(subject: TailscaleServeRouteSubject) -> TailscaleServeRouteKey {
  tailscale_serve_route_key(endpoint: subject.endpoint)
}

// Phantom relation brand (std.key_relation key_relation_brand_type_tag_note): keeps this relation distinct from other TailscaleServeEndpoint x ScopedKey rows that share carriers — orthogonal to scope correctness (see the // block above tailscale_serve_route_key_relation).
type TailscaleServeRouteKeyRelation

// KEYING-0 follow-on (node://adhoc-907f1da5-c20): tailscale_serve_route_key_relation scopes route keys by TailscaleServeScope { node, service } instead of GlobalKeyScope. Two nodes may each own the same listener×mount route as distinct scoped keys; collapsing them was the DeploymentArtifactStep poison class reached from the scope axis. Witness: test.claim.tailscale_serve_route_key_witness w_per_device_scope_preserves_distinct_nodes_same_route and its GlobalKeyScope RED control.
data tailscale_serve_route_key_relation: KeyRelation<TailscaleServeRouteKeyRelation, TailscaleServeRouteSubject, TailscaleServeScopeIdentity, TailscaleServeRouteKey> = KeyRelation {
  scope_of: tailscale_serve_route_scope_of,
  key_of: tailscale_serve_route_key_of,
}

fn tailscale_serve_route_endpoint_state_of(subject: TailscaleServeRouteSubject) -> NonEmptyStr {
  tailscale_endpoint_state_of(endpoint: subject.endpoint)
}

fn tailscale_serve_route_subject_value_eq(a: TailscaleServeRouteSubject, b: TailscaleServeRouteSubject) -> Bool {
  tailscale_endpoint_value_eq(a: a.endpoint, b: b.endpoint)
}

data tailscale_serve_resource_relation: KeyedResourceRelation<TailscaleServeRouteKeyRelation, TailscaleServeRouteSubject, TailscaleServeScopeIdentity, TailscaleServeRouteKey, NonEmptyStr> = KeyedResourceRelation {
  key: tailscale_serve_route_key_relation,
  state: StateRelation {
    state_of: tailscale_serve_route_endpoint_state_of,
    state_eq: tailscale_endpoint_state_eq,
  },
}
