module gunbc.landing_workflow

import std.types { Bool, CommitSha, Int, List, NonEmptyStr, String, Timestamp }
import v2.std.optional { Optional, Present, Absent }
import gunbc.source_integration_landing_spine { LandingActorAuthorityHandle }
import gunbc.merge_admission { MergeStrategy, SquashMerge }

data landing_workflow_v1_note: String = "The operator landing lane is a projection over dashboard-owned facts, never a second review authority. DashboardMergeCriteriaSnapshot is the merge_criteria object returned by the dashboard reviews summary; `ready` is its verdict. This module preserves every failed requirement as a typed, PR-located blocker and checks that the supplied requirement rows agree with the authority's ready bit. A disagreement refuses the projection rather than choosing either representation silently. Only LandingAtDecisionBoundary carries a LandingMergeAdmission, so a blocked or untracked pull request cannot reach the action carrier. Actors remain fields projected from session/work-item/process/provider facts; there is deliberately no Actor record or registry. The only v1 action is an exact-head squash merge performed after a fresh summary read, with the admission snapshot and actor authority handle retained in the receipt."

type DashboardRequirementKey
  = DashboardApprovalsRequirement
  | DashboardRequestChangesRequirement
  | DashboardActiveReviewsRequirement
  | DashboardOpenRequirement
  | DashboardDraftRequirement
  | DashboardMergeableRequirement
  | DashboardChecksRequirement
  | DashboardUnclassifiedRequirement { key: String }

type DashboardMergeCriteriaRequirement {
  key: DashboardRequirementKey
  label: String
  ok: Bool
  actual: String
}

type DashboardMergeCriteriaSnapshot {
  ready: Bool
  head_sha: CommitSha
  required_approval_count: Int
  approval_count: Int
  approval_providers: List<NonEmptyStr>
  request_changes_count: Int
  request_change_providers: List<NonEmptyStr>
  stale_provider_count: Int
  stale_providers: List<NonEmptyStr>
  active_review_count: Int
  mergeable: String
  checks_state: String
  is_draft: Bool
  lifecycle: String
  requirements: List<DashboardMergeCriteriaRequirement>
}

type LandingReviewArtifactProjection {
  artifact_id: Int
  provider: NonEmptyStr
  reviewed_head: CommitSha
  verdict: String
  artifact_url: NonEmptyStr
}

type LandingPullRequestProjection {
  work_item_id: NonEmptyStr
  work_item_title: String
  session_id: NonEmptyStr?
  provider_instance: NonEmptyStr?
  branch: NonEmptyStr?
  repo: NonEmptyStr
  pr_number: Int
  pr_url: NonEmptyStr
  pr_title: String
}

data landing_actor_projection_note: String = "Thin actor projection only: work_item_id, session_id, provider_instance and branch remain independently optional facts on the pull-request row. No Actor carrier is introduced and no identity is synthesized when one of those source facts is absent. The merge receipt names the already-existing LandingActorAuthorityHandle used by the P0 landing spine; it does not mint a person or provider object."

type LandingBlockerLocation {
  repo: NonEmptyStr
  pr_number: Int
  head_sha: CommitSha
  requirement: DashboardRequirementKey
}

type LandingBlocker
  = AwaitingFirstReview { at: LandingBlockerLocation, required: Int }
  | AwaitingApprovals { at: LandingBlockerLocation, actual: Int, required: Int }
  | StaleApprovalReReviewPending { at: LandingBlockerLocation, provider: NonEmptyStr }
  | RequestChangesBy { at: LandingBlockerLocation, provider: NonEmptyStr }
  | RequestChangesUnattributed { at: LandingBlockerLocation, count: Int }
  | ActiveReviewOnCurrentHead { at: LandingBlockerLocation, count: Int }
  | PullRequestNotOpen { at: LandingBlockerLocation, lifecycle: String }
  | DraftPullRequest { at: LandingBlockerLocation }
  | MergeConflict { at: LandingBlockerLocation, mergeable: String }
  | MergeabilityUnknown { at: LandingBlockerLocation, mergeable: String }
  | ChecksPending { at: LandingBlockerLocation }
  | ChecksFailing { at: LandingBlockerLocation, state: String }
  | RequirementBlockedUnclassified { at: LandingBlockerLocation, actual: String }

type LandingEvidenceProjection {
  review_artifacts: List<LandingReviewArtifactProjection>
  checks_url: NonEmptyStr
  pull_request_url: NonEmptyStr
}

type LandingMergeAdmission {
  pull_request: LandingPullRequestProjection
  head_sha: CommitSha
  criteria: DashboardMergeCriteriaSnapshot
  evidence: LandingEvidenceProjection
  actor_authority: LandingActorAuthorityHandle
  strategy: MergeStrategy
}

type LandingDecision
  = LandingAtDecisionBoundary { admission: LandingMergeAdmission }
  | LandingBlocked {
      pull_request: LandingPullRequestProjection,
      criteria: DashboardMergeCriteriaSnapshot,
      blockers: List<LandingBlocker>,
      evidence: LandingEvidenceProjection,
    }
  | LandingSummaryDiverged {
      pull_request: LandingPullRequestProjection,
      criteria: DashboardMergeCriteriaSnapshot,
      projected_blocker_count: Int,
      reason: String,
    }
  | LandingObservationRefused {
      pull_request: LandingPullRequestProjection,
      reason: String,
    }

type UntrackedPullRequest {
  repo: NonEmptyStr
  pr_number: Int
  pr_url: NonEmptyStr
  reason: String
}

type LandingQueueProjection {
  ready: List<LandingMergeAdmission>
  blocked: List<LandingDecision>
  untracked: List<UntrackedPullRequest>
}

fn landing_blocker_location(
  pr: LandingPullRequestProjection,
  criteria: DashboardMergeCriteriaSnapshot,
  requirement: DashboardRequirementKey,
) -> LandingBlockerLocation {
  LandingBlockerLocation {
    repo: pr.repo,
    pr_number: pr.pr_number,
    head_sha: criteria.head_sha,
    requirement: requirement,
  }
}

fn landing_approval_requirement_blockers(
  pr: LandingPullRequestProjection,
  criteria: DashboardMergeCriteriaSnapshot,
) -> List<LandingBlocker> {
  let at = landing_blocker_location(
    pr: pr,
    criteria: criteria,
    requirement: DashboardApprovalsRequirement,
  )
  let approval = if criteria.approval_count == 0 && criteria.stale_provider_count == 0 {
    [AwaitingFirstReview { at: at, required: criteria.required_approval_count }]
  } else {
    [AwaitingApprovals {
      at: at,
      actual: criteria.approval_count,
      required: criteria.required_approval_count,
    }]
  }
  append(
    approval,
    items: map(criteria.stale_providers, provider =>
      StaleApprovalReReviewPending { at: at, provider: provider }),
  )
}

fn landing_request_changes_blockers(
  pr: LandingPullRequestProjection,
  criteria: DashboardMergeCriteriaSnapshot,
) -> List<LandingBlocker> {
  let at = landing_blocker_location(
    pr: pr,
    criteria: criteria,
    requirement: DashboardRequestChangesRequirement,
  )
  if count(criteria.request_change_providers) == 0 {
    [RequestChangesUnattributed { at: at, count: criteria.request_changes_count }]
  } else {
    map(criteria.request_change_providers, provider =>
      RequestChangesBy { at: at, provider: provider })
  }
}

fn landing_failed_requirement_blockers(
  pr: LandingPullRequestProjection,
  criteria: DashboardMergeCriteriaSnapshot,
  requirement: DashboardMergeCriteriaRequirement,
) -> List<LandingBlocker> {
  if requirement.ok {
    []
  } else {
    let at = landing_blocker_location(
      pr: pr,
      criteria: criteria,
      requirement: requirement.key,
    )
    match requirement.key {
      DashboardApprovalsRequirement =>
        landing_approval_requirement_blockers(pr: pr, criteria: criteria)
      DashboardRequestChangesRequirement =>
        landing_request_changes_blockers(pr: pr, criteria: criteria)
      DashboardActiveReviewsRequirement =>
        [ActiveReviewOnCurrentHead { at: at, count: criteria.active_review_count }]
      DashboardOpenRequirement =>
        [PullRequestNotOpen { at: at, lifecycle: criteria.lifecycle }]
      DashboardDraftRequirement => [DraftPullRequest { at: at }]
      DashboardMergeableRequirement =>
        if criteria.mergeable == "CONFLICTING" || criteria.mergeable == "DIRTY" {
          [MergeConflict { at: at, mergeable: criteria.mergeable }]
        } else {
          [MergeabilityUnknown { at: at, mergeable: criteria.mergeable }]
        }
      DashboardChecksRequirement =>
        if criteria.checks_state == "pending" || criteria.checks_state == "queued" || criteria.checks_state == "in_progress" {
          [ChecksPending { at: at }]
        } else {
          [ChecksFailing { at: at, state: criteria.checks_state }]
        }
      DashboardUnclassifiedRequirement { key: _ } =>
        [RequirementBlockedUnclassified { at: at, actual: requirement.actual }]
    }
  }
}

fn landing_blockers(
  pr: LandingPullRequestProjection,
  criteria: DashboardMergeCriteriaSnapshot,
) -> List<LandingBlocker> {
  flat_map(
    criteria.requirements,
    requirement => landing_failed_requirement_blockers(
      pr: pr,
      criteria: criteria,
      requirement: requirement,
    ),
  )
}

fn landing_checks_url(pr: LandingPullRequestProjection) -> NonEmptyStr {
  concat(pr.pr_url as String, "/checks") as NonEmptyStr
}

fn landing_evidence_projection(
  pr: LandingPullRequestProjection,
  review_artifacts: List<LandingReviewArtifactProjection>,
) -> LandingEvidenceProjection {
  LandingEvidenceProjection {
    review_artifacts: review_artifacts,
    checks_url: landing_checks_url(pr: pr),
    pull_request_url: pr.pr_url,
  }
}

fn project_landing_decision(
  pr: LandingPullRequestProjection,
  criteria: DashboardMergeCriteriaSnapshot,
  review_artifacts: List<LandingReviewArtifactProjection>,
  actor_authority: LandingActorAuthorityHandle,
) -> LandingDecision {
  let blockers = landing_blockers(pr: pr, criteria: criteria)
  let evidence = landing_evidence_projection(pr: pr, review_artifacts: review_artifacts)
  let projection_ready = count(blockers) == 0
  if criteria.ready != projection_ready {
    LandingSummaryDiverged {
      pull_request: pr,
      criteria: criteria,
      projected_blocker_count: count(blockers),
      reason: "dashboard merge_criteria.ready disagrees with its own requirement rows; admission refused and the dashboard summary remains authoritative",
    }
  } else if criteria.ready {
    LandingAtDecisionBoundary {
      admission: LandingMergeAdmission {
        pull_request: pr,
        head_sha: criteria.head_sha,
        criteria: criteria,
        evidence: evidence,
        actor_authority: actor_authority,
        strategy: SquashMerge,
      }
    }
  } else {
    LandingBlocked {
      pull_request: pr,
      criteria: criteria,
      blockers: blockers,
      evidence: evidence,
    }
  }
}

fn landing_queue_projection(
  decisions: List<LandingDecision>,
  untracked: List<UntrackedPullRequest>,
) -> LandingQueueProjection {
  LandingQueueProjection {
    ready: flat_map(decisions, decision => match decision {
      LandingAtDecisionBoundary { admission } => [admission]
      LandingBlocked { pull_request: _, criteria: _, blockers: _, evidence: _ } => []
      LandingSummaryDiverged { pull_request: _, criteria: _, projected_blocker_count: _, reason: _ } => []
      LandingObservationRefused { pull_request: _, reason: _ } => []
    }),
    blocked: filter(decisions, decision => match decision {
      LandingAtDecisionBoundary { admission: _ } => false
      LandingBlocked { pull_request: _, criteria: _, blockers: _, evidence: _ } => true
      LandingSummaryDiverged { pull_request: _, criteria: _, projected_blocker_count: _, reason: _ } => true
      LandingObservationRefused { pull_request: _, reason: _ } => true
    }),
    untracked: untracked,
  }
}

type LandingMergeActionRefusal
  = LandingMergeNotAdmitted { repo: NonEmptyStr, pr_number: Int }
  | LandingMergeHeadMoved { admitted: CommitSha, observed: CommitSha }
  | LandingMergeActuationFailed { detail: String }

type LandingMergeReceipt {
  repo: NonEmptyStr
  pr_number: Int
  admitted_head_sha: CommitSha
  criteria: DashboardMergeCriteriaSnapshot
  actor_authority: LandingActorAuthorityHandle
  strategy: MergeStrategy
  merged_at: Timestamp
  transport_receipt: String
}

type LandingMergeActionResult
  = LandingMergeActuated { receipt: LandingMergeReceipt }
  | LandingMergeRefused { refusal: LandingMergeActionRefusal }

fn admit_landing_merge_action(
  admission: LandingMergeAdmission,
  observed_head: CommitSha,
) -> LandingMergeActionRefusal? {
  if admission.head_sha == observed_head {
    none
  } else {
    Present { value: LandingMergeHeadMoved {
      admitted: admission.head_sha,
      observed: observed_head,
    } }
  }
}

fn landing_merge_action_result(
  admission: LandingMergeAdmission,
  observed_head: CommitSha,
  actuation_succeeded: Bool,
  transport_receipt: String,
  merged_at: Timestamp,
) -> LandingMergeActionResult {
  match admit_landing_merge_action(admission: admission, observed_head: observed_head) {
    Present { value: refusal } => LandingMergeRefused { refusal: refusal }
    Absent =>
      if actuation_succeeded {
        LandingMergeActuated { receipt: LandingMergeReceipt {
          repo: admission.pull_request.repo,
          pr_number: admission.pull_request.pr_number,
          admitted_head_sha: admission.head_sha,
          criteria: admission.criteria,
          actor_authority: admission.actor_authority,
          strategy: admission.strategy,
          merged_at: merged_at,
          transport_receipt: transport_receipt,
        } }
      } else {
        LandingMergeRefused {
          refusal: LandingMergeActuationFailed { detail: transport_receipt },
        }
      }
  }
}
