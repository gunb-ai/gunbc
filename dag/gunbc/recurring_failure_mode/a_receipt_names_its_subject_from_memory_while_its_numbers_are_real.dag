module gunbc.recurring_failure_mode.a_receipt_names_its_subject_from_memory_while_its_numbers_are_real

// Filed on quick-newt-573's instruction (2026-11-02) after two instances landed inside one day in the
// same lane, one of them in an evidence artifact that lane posted itself. The corpus search that
// preceded this filing is recorded in the PR body and in the NOT THIS CLASS receipts below: the nearest
// rows are about a receipt that LOST a coordinate it once had
// (receipt_names_a_property_not_the_tree_it_holds_of,
// a_per_run_receipt_read_back_without_binding_the_run_it_answers,
// a_revision_pinned_reading_cites_a_declaration_without_its_revision), about an identity that exists
// somewhere the reader cannot see (witness_reads_a_probe_file_the_commit_does_not_contain), or about a
// CLAIM with no authority anywhere behind it (unbacked_execution_claim). None of them is this class.
// Here the authority exists and was read: the run happened, the log carries the counts, the symbols
// resolve. What was never read is the IDENTITY of the thing reported on, and identity is the one field a
// reviewer does not think to re-derive -- which is why the harm is not embarrassment but a false
// premise a reader plans on.

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.recurring_failure_mode { AtCeiling, FoundOnRung, RecurringFailureMode, RungRead }
import gunbc.guarantee_rung { Mitigatable }


data a_receipt_names_its_subject_from_memory_while_its_numbers_are_real: RecurringFailureMode = RecurringFailureMode {
  identity: "a_receipt_names_its_subject_from_memory_while_its_numbers_are_real" as NonEmptyStr,

  rung: RungRead {
    found_at: FoundOnRung { rung: Mitigatable },
    standing: AtCeiling {
      rung: Mitigatable,
      ceiling_reason: "The ceiling is the MINIMUM across the in-scope paths, and one of the two paths this class covers is not mechanically decidable: whether a branch decides what a sentence says it decides (instance 1) is answerable only by reading, so the class as a whole cannot be driven below review. The distinction matters because it is the subject of a sibling row: the TYPE admits BelowCeiling { current: Mitigatable, ceiling: Mitigatable }, and since the rung census was retired (#15557, which removed gunbc.instruments.rfm_rung_census and with it the only refusal of an equal-rung BelowCeiling) no executing check refuses it (that unconstructed fact is itself filed as gunbc.recurring_failure_mode.below_ceiling_order_is_checked_at_runtime_not_constructed, blocked on a strict-order witness over GuaranteeRung, since v2.std.cardinality NatLeWitness is non-strict). Filing the equal-rung BelowCeiling would therefore compile and be refused by nothing -- an inflated typed claim the row's own prose denies. The IDENTITY half by itself does reach MechanicallyPreventable, and that reach is kept where the carrier allows it, in the receipts (RUNG AND CEILING, NEXT-RUNG TRIGGER): a narrowed identity-only class should file its own row with MechanicallyPreventable as its ceiling once the emitted-receipt capability exists. A consequence stated rather than hidden: an at-ceiling row does not rank for climbing, so the mechanical half is carried by naming its capability in this row's receipts and by that future narrowed row, not by inflating this one."
    }
  },

  receipts: [
    "INVALID STATE: an evidence artifact states the IDENTITY of the thing it reports on -- a file path, a commit sha, a module or declaration name -- from the author's recollection rather than from the artifact that was read, while its numbers, quotes, and reasoning are genuine and were read from something. The invalid part is the BINDING between observation and subject, not the observation, and the observation is what a reader checks.",

    "HARM: a reader credits an observation of an artifact that does not exist, or credits a decision to code that does not make it, and plans on it. In instance 2 the specific false premise was that a named environmental gap had closed -- the fabricated path was the srv1-lab sandbox witness's, whose real result is 14 PASS / 9 FAIL in an environment without systemd-run -- so the conclusion the artifact invited was precisely the one that was false. The second cost is quieter and larger: the true parts of the same receipt stop being usable, because a reader who finds one invented identity has no way to tell which of the remaining identities were read.",

    "WHY IT SURVIVES REVIEW, stated as a property and not as a complaint: the artifact passes the plausibility check reviewers actually apply. Counts are internally consistent, the quoted row names are real, the head sha is real, the tree really was clean at the time of the run. The identity is the single field nobody can check without opening the runner script or the tree at that head, and opening those is outside a review's normal reading path. Both instances were caught by a reader who went and opened the source, which is the rung this row is found at.",

    "ATTESTED INSTANCE 1 (2026-11-02, side-chat review of #15665, REQUEST_CHANGES at commit 82289116601d). The row gunbc.recurring_failure_mode.release_gate_requires_evidence_the_held_population_never_wrote carried two receipts, a CURRENT RUNG and a SITE 1, attributing to gunbc.compute.work_provider_local unit_termination_unconfirmed and unit_lifecycle_unpopulated the rule that a compute seat is freed only beside a stop-record observation. Both decl_refs RESOLVED, and the attributed rule was real -- in the #15640 candidate at c6ae064696c6, which was open and unmerged, not in the main-based tree the row cited. Those two branches in the cited tree still decided an absent unit from a bare LoadState reading (UnitAbsentAuthoritatively, UnitTerminatedCauseUnknown). Nobody had opened them; the prose had been transcribed from the candidate pull request's own description of itself. Repaired in 157214382975 after reading the two folds in the row's own tree, with the receipts now attributing the mitigation to the candidate and stating that it is neither implemented by that row nor established as deployed.",

    "THE DISTINCTION INSTANCE 1 TEACHES, in the words quick-newt-573 drew from it: a resolving decl_ref proves the symbol exists, not that it does what the receipt says. Existence is one field of a citation and is mechanically checkable; behaviour is a second field and is obtained only by opening the branch. A row that cites a symbol and describes its behaviour has made two claims and typically verified one.",

    "ATTESTED INSTANCE 2 (2026-11-02, pull request #15640 comment 6575044021, posted and then corrected by the lane that posted it). A dated re-run table named the three witness files it claimed to report on as dag/test/claim/gunbc/compute/sandbox_wet.dag, dag/test/claim/gunbc/roadmap/roadmap_attempt_exit_spool_witness.dag, and dag/test/claim/gunbc/roadmap/roadmap_work_request_witness.dag. None of the three exists anywhere in the repository. The counts beside them (26/0, 25/0, 24/0, each exit 0) and every quoted row name had been read from the executed logs, and the files actually executed were dag/test/claim/roadmap/session_placement_wet_witness.dag, dag/test/claim/roadmap/roadmap_attempt_exit_spool_witness.dag, and dag/test/claim/compute/work_request_witness.dag. Every number was therefore true and each was about a different file from the one named on its row. Caught by quick-newt-573 comparing the comment against the runner script's own run lines; no check in the repository could have caught it, because the artifact was prose carried outside the tree.",

    "THE CORRECTION IS PART OF THE RECEIPT. The wrong names were quoted inside a visible correction paragraph rather than silently deleted, and the replacement paths were taken from the runner script and existence-checked with test -f on all five named files before reposting. Silently deleting a wrong identity destroys the only record of how the wrongness arose, and that record is what a class like this one is made of.",

    "RECOGNITION RULE, mechanical, applied at the moment the artifact is produced and not at review: every identity in it is resolved against the artifact it reports on by a command that is run then. A path comes from the executed command line or from the log, and is test -f'd at the recorded head; a sha comes from git rev-parse, with ancestry from git merge-base --is-ancestor run in the tree that is being claimed; a count comes from the log's own verdict lines, and a row name is quoted from the log rather than recalled; a claim about what code decides is written only after the branch is opened and its line read. If a name cannot be produced by a command that was run, it is a recollection, and a recollection is not evidence.",

    "NOT THIS CLASS, against unbacked_execution_claim, the nearest neighbour and the one a careless filing would have appended to. That row's invalid state is a prose claim with NO authority behind it at all -- its origins are an executor deleted, a cited symbol reduced to an annotation, a relation never backed. Here the authority exists and was read: the run happened and the log carries the counts. What is missing is the JOIN between an honest observation and the identity of what was observed. Appending to that row would have prescribed deleting an unsupported claim, which here would destroy true evidence and leave the actual defect, the unverified identity, completely untouched.",

    "NOT THIS CLASS, against a_per_run_receipt_read_back_without_binding_the_run_it_answers and receipt_names_a_property_not_the_tree_it_holds_of. Those two are receipts that OMIT a coordinate they once had -- which run a per-run receipt answers, which tree a zero-diff receipt holds of -- so their harm is silent expiry or ambiguity across real artifacts, and their repair is to add the missing coordinate. This class ASSERTS an identity positively and wrongly: there is no ambiguity about which run answered, the named file never existed, and adding a coordinate to it would produce a more precise falsehood.",

    "NOT THIS CLASS, against a_revision_pinned_reading_cites_a_declaration_without_its_revision and unlanded_citation_indistinguishable_at_the_citing_end. Both have a referent somewhere on the timeline -- a declaration that existed at the pin, a symbol that exists but has not landed -- and their defect is that the citation lacks the coordinate that would locate it. This class's referent may never have existed at any revision, and its claim is not a citation to a dependency but the identity of the artifact the evidence is about.",

    "NOT THIS CLASS, against witness_reads_a_probe_file_the_commit_does_not_contain. There the file is real in the author's worktree and merely absent from the commit, the cause is a host-wide ignore rule the reading tool applies, and the floor refuses the claim in-tree. Here the name never referred to any file, on any host, and no in-tree floor could have seen it, because the artifact carrying it was prose posted outside the repository -- which is also why this class's trigger is a producing capability and not a repository validator alone.",

    "NOT THIS CLASS, against witness_oracle_transcribed_from_the_tree_it_measures and a_witness_asserts_a_sibling_output_not_the_one_consumers_read, though all three belong to one family: something that should have been read was transcribed. In the first, VALUES are transcribed from a real producer, so the fix is a lens over literals against their producers; in the second, the subject is real and the wrong one of several products is asserted. Here the direction is the opposite -- the values were read and the IDENTITY was recalled -- so neither the literal lens nor the product roster would find it.",

    "NOT THIS CLASS, against a_citation_attests_a_decision_rule_the_code_does_not_implement, and it is the closest on harm. That row's cited authority is an EXTERNAL STANDARD which a module attests while implementing a weaker rule, so the two objects live in different corpora and its ceiling stops at Mitigatable because the claim is semantic. Instance 1 shares that harm shape inside one repository: an internal symbol, cited by a reference that resolves, described as deciding something it does not decide. Read rather than assumed, that sibling row states no ceiling at all (rung: RungUnread { cause: CeilingNotStated }), so this row does not borrow a ceiling from it; what it takes from it is the shape of the semantic limit, which is one of the two reasons this row's own ceiling is Mitigatable.",

    "RUNG FOUND AT: 1, Mitigatable, and both instances were caught by a reviewing authority that went and read the source. CEILING: Mitigatable, the MINIMUM across the in-scope paths, as the typed field states -- one of the two paths this class covers, whether a branch decides what a sentence claims it decides, is answerable only by reading, and no check can decide it. The IDENTITY half on its own reaches further: whether a named path exists in the tree at a given head, and whether it appears in the command lines of the run being reported, is decidable. That asymmetry is stated here in prose because the carrier gives no typed field for it: AtCeiling carries one rung and no trigger arm, so at-ceiling-with-a-trigger genuinely has no constructor, while the alternative filing (BelowCeiling with current equal to the ceiling) is constructible and, since the rung census was retired, refused by nothing -- which is the point the sibling row below_ceiling_order_is_checked_at_runtime_not_constructed files, and the reason the typed ceiling here is the honest minimum rather than the aspirational maximum. Where the further reach is therefore kept: in this receipt and in the NEXT-RUNG TRIGGER receipt, and in a narrowed identity-only row that should be filed separately with MechanicallyPreventable as its ceiling once the emitted-receipt capability exists. Inflating this row to claim the mechanical ceiling for the whole class was considered and rejected: an inflated class never ranks for climbing, and here the inflation would have been exactly the defect the row is about -- a receipt asserting more than its author read.",

    "NEXT-RUNG TRIGGER, at capability grain, stated here rather than in a typed field because the class's ceiling is Mitigatable and AtCeiling admits no trigger arm: receipts emitted from the runner's own run lines instead of hand-written -- a capability that builds each evidence row (the entry path actually passed, the head, the dirty-file count, the binary digest, the per-file counts) from the command that executed and the log it produced, joined to a check that refuses an evidence artifact whose named file, sha, or symbol identity does not appear in the artifact it reports on or does not exist in the tree at the recorded head. Its observable signature when it exists is that no evidence artifact in the lane is hand-typed, and an artifact naming a path outside its own run's log, or a sha whose ancestry does not hold, is refused at the point of producing it instead of being caught at review. Building it does not move this row's ceiling -- the behaviour-prose path still needs a reader -- but it is what a narrowed identity-only row would be filed against, and that row would be the one to claim MechanicallyPreventable.",

    "SELF-RECEIPT, and the reason this row is filed by the author of one of its instances rather than by the reader who caught it. unbacked_execution_claim records that its own first revision contained two unbacked claims, and its lesson was that the row is worth more when the person who produced the specimen writes it down. Both instances here came from one lane in one day, which is the recurring part of recurring failure mode, and the lane that produced instance 2 is the lane that ran the two checks that found it.",

  ],

  evidence: [
    decl_ref(module_path: "gunbc.recurring_failure_mode", decl_name: "RecurringFailureMode"),
    decl_ref(module_path: "gunbc.compute.work_provider_local", decl_name: "unit_termination_unconfirmed"),
    decl_ref(module_path: "gunbc.compute.work_provider_local", decl_name: "unit_lifecycle_unpopulated"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.unbacked_execution_claim", decl_name: "unbacked_execution_claim"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.a_per_run_receipt_read_back_without_binding_the_run_it_answers", decl_name: "a_per_run_receipt_read_back_without_binding_the_run_it_answers"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.receipt_names_a_property_not_the_tree_it_holds_of", decl_name: "receipt_names_a_property_not_the_tree_it_holds_of"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.a_revision_pinned_reading_cites_a_declaration_without_its_revision", decl_name: "a_revision_pinned_reading_cites_a_declaration_without_its_revision"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.unlanded_citation_indistinguishable_at_the_citing_end", decl_name: "unlanded_citation_indistinguishable_at_the_citing_end"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.witness_reads_a_probe_file_the_commit_does_not_contain", decl_name: "witness_reads_a_probe_file_the_commit_does_not_contain"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.witness_oracle_transcribed_from_the_tree_it_measures", decl_name: "witness_oracle_transcribed_from_the_tree_it_measures"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.a_witness_asserts_a_sibling_output_not_the_one_consumers_read", decl_name: "a_witness_asserts_a_sibling_output_not_the_one_consumers_read"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.a_citation_attests_a_decision_rule_the_code_does_not_implement", decl_name: "a_citation_attests_a_decision_rule_the_code_does_not_implement"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.below_ceiling_order_is_checked_at_runtime_not_constructed", decl_name: "below_ceiling_order_is_checked_at_runtime_not_constructed"),
    decl_ref(module_path: "gunbc.recurring_failure_mode.release_gate_requires_evidence_the_held_population_never_wrote", decl_name: "release_gate_requires_evidence_the_held_population_never_wrote"),
  ],
}
