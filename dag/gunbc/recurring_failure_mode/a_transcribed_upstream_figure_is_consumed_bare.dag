module gunbc.recurring_failure_mode.a_transcribed_upstream_figure_is_consumed_bare

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { CeilingAmbiguous, RecurringFailureMode, RungUnread }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data a_transcribed_upstream_figure_is_consumed_bare: RecurringFailureMode = RecurringFailureMode {
  identity: "a_transcribed_upstream_figure_is_consumed_bare" as NonEmptyStr,

  rung: RungUnread { cause: CeilingAmbiguous },

  receipts: [
    "INVALID STATE: a figure that an upstream's operator only STATED (a limit, a field spelling, a token) is typed as a bare value, and a consumer enforces or parses by it as if it had been read. HARM: a bet is consumed as deduced fact (gunbc.design_argument::epistemic_humility). When the live service differs, the consumer fails, or silently mis-parses, at its first real use. FOUND AT: lab PR 14244 (the lab-only pool front module extdeps.pool.pool_front, whose limits and reasoning spellings were transcribed from the pool operator's messages), reviews 81458, 81465 and 81526. That module exists only on the lab integration branch (bright-moth-475/integration at abcbf27e4cc3). It was never carried to main, because main's operator route reaches the srv1 fabric router instead (#15789).",
    "RECOGNITION RULE: a number or spelling in an extdeps module whose only citation is a message from the service's operator, read by a consumer that checks no standing. REPAIR ON MAIN: where a lab-policy bound can stand in for the upstream figure, the consumer enforces its OWN policy, typed as a policy with its reason, and claims no reading. gunbc.harness.harness_reasoning_wire PoolBudgetPolicy carries that reason, router_concurrency_budget_policy is the router route's instance, and test.claim.operator_endpoint_witness the_route_carries_the_labs_declared_ceiling_and_its_reason_not_a_reading discriminates it. Where no policy fallback exists, a figure's standing is carried by extdeps.external_authority CitedFigureStanding, and a TranscribedUncited figure names its read obligation. The lab also wrote a CitedFigure<T> carrier with a refusing read. It is NOT carried to main, because no main consumer reads an upstream figure that way, and landing it would leave a dangling declaration (gunbc.design_argument::consumption). RUNG FOUND AT: mitigatable. CEILING: structurally guaranteed for figures with a policy fallback; a boundary obligation for the rest. NEXT TRIGGER: the first main consumer that must act on an operator-stated upstream figure with no policy fallback. That consumer lands the value-plus-standing carrier together with its refusing read.",
  ],

  evidence: [
    DeclarationRef { module_path: "extdeps.external_authority", decl_name: "CitedFigureStanding", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.harness.harness_reasoning_wire", decl_name: "PoolBudgetPolicy", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.harness.harness_operator_route", decl_name: "router_concurrency_budget_policy", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.operator_endpoint_witness", decl_name: "the_route_carries_the_labs_declared_ceiling_and_its_reason_not_a_reading", field: WholeDeclaration },
  ],
}
