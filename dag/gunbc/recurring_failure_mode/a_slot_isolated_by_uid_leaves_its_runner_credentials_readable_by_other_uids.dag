module gunbc.recurring_failure_mode.a_slot_isolated_by_uid_leaves_its_runner_credentials_readable_by_other_uids

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { AtCeiling, FoundBelowTheLadder, RecurringFailureMode, RungRead }
import gunbc.guarantee_rung { MechanicallyPreventable }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data a_slot_isolated_by_uid_leaves_its_runner_credentials_readable_by_other_uids: RecurringFailureMode = RecurringFailureMode {
  identity: "a_slot_isolated_by_uid_leaves_its_runner_credentials_readable_by_other_uids" as NonEmptyStr,

  rung: RungRead { found_at: FoundBelowTheLadder, standing: AtCeiling { rung: MechanicallyPreventable, ceiling_reason: "mechanically preventable: what another account can read is a fact of the live host (modes, owners, groups, ACLs, a umask), outside the modeled guarantee, so it is read back at the boundary and refused there. The converge's readback and the route admission (gunbc.ci.deploy_slot_tenancy deploy_slot_observed_tenancy) refuse a reachable or unread path; nothing can make the host state unwritable." as NonEmptyStr } },

  receipts: [
    "INVALID STATE: a runner slot given its own job account so that no other slot's jobs share its uid, whose tree and listener state (the registration .runner, .credentials and the RSA key .credentials_rsaparams; extdeps.github.actions_runner actions_runner_state_paths) are readable by another slot's account. Whoever reads them can run a listener as that runner and take the next job GitHub assigns it, so the uid split isolates nothing: for the deploy slot, that job is a main-pinned fleet-converge dispatch holding the administrator's key.",

    "RECEIPT 2026-10-30, srv1, read after L2 run 41055515944 had made srv1-02 run as ghdeploy: /opt/actions-runner/srv1-02 was 0755 ghdeploy, its .credentials and .credentials_rsaparams 0644, the unit's UMask 0022, and test -r on the RSA key succeeded as ghrunner, the account pull request jobs run as. The tree mode came from the executor's one managed directory mode (gunbc.executor_privileged_operation executor_managed_directory_mode, 0755), used for every slot tree regardless of role, and the tenancy model (gunbc.ci.deploy_slot_tenancy) had two walls, a restricted group and a distinct uid, and no confidentiality wall, so deploy_slot_observed_tenancy would have answered SoleTenantOfJobUid over this host. Found by a human read before the route switched: no deploy dispatch had run on the slot.",

    "HARM: a pull request job on the same host impersonates the deploy runner and receives a deploy dispatch, with its GITHUB_TOKEN, its secrets and the administrator's key in its agent. RUNG FOUND AT: below the ladder (the model would have minted the sole-tenant answer). NOW: the deploy role's tree is owner-only and its unit's UMask=0077 (gunbc.runner.runner_slot_job_role runner_slot_job_role_tree_mode, runner_slot_job_role_umask), every slot directory operation takes the slot's mode, the converge rebuilds a deploy tree at any other mode, and it reads back, path by path and ancestor by ancestor, whether any other runnable slot's account reaches the tree or a listener state path, refusing on a reachable or unread one; the route admission requires that reading. A CI slot's tree keeps 0755 because CI slots share one account and no CI slot holds a credential another does not."
  ],

  evidence: [
    DeclarationRef { module_path: "gunbc.ci.deploy_slot_tenancy", decl_name: "deploy_slot_privacy", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.ci.deploy_slot_tenancy", decl_name: "deploy_slot_observed_tenancy", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.runner.runner_slot_job_role", decl_name: "runner_slot_job_role_tree_mode", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.runner.runner_host_file_converge", decl_name: "observe_deploy_slot_host_reading", field: WholeDeclaration },
  ],
}
