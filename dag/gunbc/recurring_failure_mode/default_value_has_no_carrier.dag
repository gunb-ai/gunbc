module gunbc.recurring_failure_mode.default_value_has_no_carrier

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data default_value_has_no_carrier: RecurringFailureMode = RecurringFailureMode {
  identity: "default_value_has_no_carrier" as NonEmptyStr,

  receipts: [
    "INVALID STATE: a default value (`= expr`) on a fn or pattern parameter (`version: NonEmptyStr = \"latest\"`) or on a record field (`headless: Bool = false`), which v1 reads (`v1` `02_parse` `parse_param` / `parse_field`), has nothing to hold it on the lowered parameter or field: the one binder the lowering builds carries a name and a type, not an optional default.",
    "HARM: a parameter or field lowered without its default silently changes every call site or construction that omits it -- from 'takes the default' to an arity or field-completeness error, or worse, to a different value supplied elsewhere.",
    "CONTAINED, NOT SILENT: every position parses the one `v2.extdeps.languages.dag` `dag_grammar_default_value_expr` production, and lowering refuses located at it as `body_lowering_reason_default_value_unmodeled` -- a fn through `v2.compiler.body_lowering_fold` `body_lower_param_default_refusal_optional` on both arms, a record field through `body_lower_field_decl_block_payload`. A service io field's default is set aside with the service's other interface members, and the service refuses whole.",
    "RUNG FOUND AT: mitigated (typed, located refusal). CEILING: structurally impossible -- a default is a field of the binder it belongs to. NEXT-RUNG TRIGGER, NAMING THE CAPABILITY: the one binder representation carrying an optional default, shared by fn params, service io fields and record fields, so every default lowers onto its binder and `body_lowering_reason_default_value_unmodeled` has no producer.",
    "CLIMBED, BY THE TRIGGER AS STATED (XL-2 PR2c-ii). The binder node (v2.std.node_query binder_node_parts; XL-2 PR2b-3) carries an optional default, and lowering now reads every default onto its binder: a fn or pattern parameter's through v2.compiler.body_lowering_fold body_lower_typed_param_optional, a record field's and a service io field's from the field tail, all through body_lower_binder_edge_read. body_lowering_reason_default_value_unmodeled has no producer and is deleted with its refusal; infer judges that a default inhabits its binder's declared type. The two reds flipped into positive controls (a_parameter_default_lowers_onto_its_binder_holds, a_record_field_default_lowers_onto_its_binder_holds) and stay enrolled (DESIGN 4b(4)). A record field's or io field's WIRE KEY is a different fact (realization) and still refuses or is set aside until the realization binding.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.test.claim.parse.default_value", decl_name: "a_parameter_default_lowers_onto_its_binder_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.parse.default_value", decl_name: "a_record_field_default_lowers_onto_its_binder_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.binder_node", decl_name: "a_binder_with_a_default_reads_back_both", field: WholeDeclaration },
  ],
}
