module gunbc.recurring_failure_mode.trigger_refires_on_a_nonempty_spool_whose_head_cannot_leave

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.recurring_failure_mode { BelowCeiling, FoundOnRung, RecurringFailureMode, RungRead }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable, StructurallyGuaranteed }
import gunbc.rung_climb { AwaitsOneGrounding, GroundingUndeclared }

data trigger_refires_on_a_nonempty_spool_whose_head_cannot_leave: RecurringFailureMode = RecurringFailureMode {
  identity: "trigger_refires_on_a_nonempty_spool_whose_head_cannot_leave" as NonEmptyStr,

  rung: RungRead { found_at: FoundOnRung { rung: Mitigatable }, standing: BelowCeiling { current: FoundOnRung { rung: MechanicallyPreventable }, ceiling: StructurallyGuaranteed, blocker: AwaitsOneGrounding { grounding: GroundingUndeclared }, trigger_capability: "the producer cannot write a spool entry the consumer cannot move, plus a privileged clear of a foreign-owned entry through the approval-broker route." } },

  receipts: [
    "**a level trigger (systemd DirectoryNotEmpty=) paired with a consumer whose removal of the head entry can fail has no terminal: every consumer exit, whatever its status, re-fires the trigger over the same entry, forever.** (INVALID STATE: a non-empty spool whose head entry the consumer cannot remove, watched by a level trigger. HARM: a hot loop -- srv1 lab 2026-10-21, 01:19Z to 01:54Z, each pass about 6 minutes of CPU at an 8.1 GB peak -- plus whatever effect the consumer performs before the removal, repeated every pass (see refusal_decided_after_a_mutation). RECOGNITION RULE: for each .path unit with DirectoryNotEmpty=, ask what the consumer does with an entry it cannot move, and what stops the trigger then; the tell is a consumer whose only exit for an unmovable entry is a failure status, which a level trigger ignores. DISTINGUISHING FACTS: an entry the consumer's principal cannot rename (a root-owned directory), a malformed entry, a full disk or a read-only mount all produce it; an EDGE trigger (PathChanged) cannot, which is why the publication answer path is an edge.) RUNG FOUND AT: mitigatable (the operator stopped the path and service by hand and kept the entry as evidence).",
    "REPAIR AND RUNG AFTER REPAIR (the factory model, DESIGN section 5: a refusal that fires stops the line). The terminal does not depend on the operation that failed: the drain's own verdict -- this pass claimed nothing and at least one entry was unmovable -- writes a typed stall record, create-only, into the sibling directory stalled/ (spool_stall_record_at). The belt-exit service carries ConditionDirectoryNotEmpty=!stalled, so it is skipped (a condition-skipped service is not failed, and launches no process), the path unit re-fires into its pinned trigger limit (TriggerLimitIntervalSec=2s, TriggerLimitBurst=200, systemd 255 defaults verified on srv1) and fails loudly -- a failed .path in systemctl --failed -- and the deploy readiness receipt reports 'exit spool stalled: N entries waiting behind <entry>' (event_backlog_judge). The route out is modeled: belt_exit_stall_analyze_cli (read-only) and belt_exit_stall_release_cli (re-claims every recorded entry, deletes the record only when none is still unmovable, re-arms the path unit). Entries that arrive while stalled wait unconsumed. RUNG AFTER REPAIR: mechanically preventable. The invalid state remains writable (an unmovable entry can still appear); what is guaranteed is the stop, by the verdict-gated record, the unit-file gate and the pinned limit, each enrolled as a discriminating RED (test.claim.roadmap.roadmap_belt_exit_drain_wet_witness, test.claim.systemd_unit_file_witness). CEILING: structurally guaranteed would need the producer to be unable to write an entry the consumer cannot move (the root-owned ExecStopPost=+mkdir producer defect is routed to WRE-1b); an entry's ownership on a real host is outside the modeled guarantee. NEXT-RUNG TRIGGER: the WRE-1b producer repair landing, plus belt_exit_stall_clear_cli, the unprivileged operator-invoked clear of an EMPTY foreign-owned entry (create it in the move's target stage, rmdir the foreign one), which is an operator route and leaves the producer defect visible). NO RUNG DROP: the stop is the designed terminal.",
  ],

  evidence: [
    decl_ref(module_path: "gunbc.roadmap.roadmap_belt_actuate", decl_name: "belt_exit_stall_verdict"),
    decl_ref(module_path: "gunbc.roadmap.spool_stall", decl_name: "spool_stall_record_at"),
    decl_ref(module_path: "gunbc.roadmap.attempt_system_unit_launch", decl_name: "attempt_unit_stall_verdict"),
    decl_ref(module_path: "gunbc.roadmap.roadmap_belt_tick_cli", decl_name: "attempt_unit_stall_release_cli"),
    decl_ref(module_path: "gunbc.roadmap.roadmap_belt_actuate", decl_name: "belt_exit_stall_release_at"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "live_deploy_belt_exit_drain_service_unit_file"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "live_deploy_belt_exit_path_unit_file"),
    decl_ref(module_path: "gunbc.roadmap.roadmap_launch_deployment_observe", decl_name: "event_backlog_judge"),
    decl_ref(module_path: "gunbc.rung_drop.publication_path_unbounded_retrigger", decl_name: "publication_path_unbounded_retrigger"),
  ],
}
