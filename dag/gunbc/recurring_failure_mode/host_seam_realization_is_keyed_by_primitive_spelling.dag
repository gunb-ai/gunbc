module gunbc.recurring_failure_mode.host_seam_realization_is_keyed_by_primitive_spelling

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { BelowCeiling, FoundOnRung, RecurringFailureMode, RungRead }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.rung_climb { ClimbableButUnbuilt }

data host_seam_realization_is_keyed_by_primitive_spelling: RecurringFailureMode = RecurringFailureMode {
  identity: "host_seam_realization_is_keyed_by_primitive_spelling" as NonEmptyStr,

  rung: RungRead { found_at: FoundOnRung { rung: Mitigatable }, standing: BelowCeiling { current: FoundOnRung { rung: Mitigatable }, ceiling: StructurallyGuaranteed, blocker: ClimbableButUnbuilt, trigger_capability: "the emitter keys host seams by declaration identity: rust_host_seam_is_realized selects a same-name self-call as a realized seam from the declaration's own std.primitive_projection row, and the runtime bridge is addressed from that identity rather than from a primitive spelling" } },

  receipts: [
    "**a same-name HostRealizedSeam self-call is realized by looking its SPELLING up in extdeps.languages.rust.emit rt_function_registry (rust_seam_primitive_name, rust_runtime_primitive_has_bridge), not by the declaration's identity.** INVALID STATE: a declared seam whose spelling has no bridge row (or whose row names another primitive of the same spelling) is emitted as unconditional recursion. HARM: rustc rejects it under -D warnings as 'function cannot return without recursing', so the failure is loud and located but only after emission; the seam's realization is a second name for a fact the projection row already carries (DESIGN section 3, a spelling-keyed dispatch).",
    "RECEIPT 2026-10-22 (sunny-bee-153, PR #14751 at 4d4cf77ac21): std.algebra declared list_push as a HostRealizedSeam before the mirror carried its std.primitive_projection row; emitted std_algebra.rs:248/:260 failed 'function cannot return without recursing' in heal-generated-artifacts and N7. The rt_function_registry row list_push -> rc_list_push (emit.dag) was kept by the #14751 no-second-route disposition (tidy-ant-251) as realization, not a binding route; this row records it as the known residue for Seat 13's 'realization by declaration identity' check.",
    "RECEIPT 2026-11-01 (valiant-deer-27, char_at egress step 1, measured at 956dc433116f): THE RUNTIME HALF OF THE SAME KEYING, AND IT FORKS MEANING INSIDE ONE SCOPE. std.host_text declares char_at(text: HostText, pos: Nat) -> Optional<HostText> and carries the HostRealizedSeam projection row for primitive_char_at. On the claim route the CHECKER binds that declaration -- src/v2/test/claim/char_at_unicode_witness.dag type-checks only because the call's result is Optional<HostText>, and an ambient String result refuses in the helper's HostText parameter -- while the interpreter answers the same call's VALUE by SPELLING: lookup_eval_builtin_inner maps the authored spelling to EvalBuiltinArm::FreeCallCharAt, the arm gunbc.v1.v1_interpreter_primitive_surface declares as free_call.char_at with authored_spelling 'char_at', and that dispatch is reached before the declaration's own body is ever evaluated. HARM MEASURED: reading one past the four code points of the multibyte sample answered the builtin's empty-text sentinel instead of Absent, so the declaration's typed absence could not be landed as a green claim; two authorities, one spelling, one run.",
    "THE LOCAL FIX THE KEYING INVITES IS UNSOUND, WHICH IS WHAT MAKES THIS A ROOT DEFECT rather than a missing leaf: the declaration-scoped mechanism the interpreter already has is the call-bridge family (v1_bridge_dispatch, is_v4_bridge_family), and it admits an arm by ctx.item_registry.get(spelling).module_name over a registry merged by NAME across the whole closure with no origin file. An arm for 'char_at' in the std.host_text family would therefore answer EVERY char_at call in any closure containing std.host_text: census at this head found 60 .dag files spelling char_at(, and exactly three pre-existing modules that both import std.host_text and spell it -- dag/extdeps/numeric/base16.dag, dag/extdeps/languages/yaml/ingest.dag, dag/gunbc/roadmap/roadmap_auth_routes.dag -- every one of those sites consuming a String today. A per-name bridge arm silently retypes three modules the change does not own, so it was not landed. THE FIX THIS ROW POINTS AT APPLIES TO EVALUATION TOO: a free call evaluates by the declaration the lookup resolved (src/v1/04_lookup.dag's resolved_declaration_call_target) and spelling-first dispatch applies only where no declaration was bound. That change's discriminating pair is the assertion withheld from the char_at witness -- at_absent(read: char_at(text: the four-code-point sample, pos: 4)) -- red without resolved-target dispatch, green with it.",
    "RUNG FOUND AT: mitigated -- the unrealized seam refuses at the Rust compiler, never silently, and the 2026-11-01 specimen refuses as a located claim failure (a Present where the declaration answers Absent), never as a wrong-looking green. CEILING: structurally guaranteed -- the realization is derivable from the declaration's projection row. NEXT TRIGGER: the emitter keys host seams by declaration identity AND the interpreter keys a free call by its resolved declaration target; climbable now but unbuilt, and it touches a load-bearing stage, so it needs its own plan."
  ],

  evidence: [
    DeclarationRef { module_path: "extdeps.languages.rust.emit", decl_name: "rt_function_registry", field: WholeDeclaration },
    DeclarationRef { module_path: "std.primitive_projection", decl_name: "primitive_projection_roster", field: WholeDeclaration },
    DeclarationRef { module_path: "std.host_text", decl_name: "char_at", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.v1.v1_interpreter_primitive_surface", decl_name: "v1_interpreter_free_call_arms", field: WholeDeclaration },
  ],
}
