module gunbc.recurring_failure_mode.v2_grammar_admits_a_continuation_line_data_initializer_the_host_route_refuses

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data v2_grammar_admits_a_continuation_line_data_initializer_the_host_route_refuses: RecurringFailureMode = RecurringFailureMode {
  identity: "v2_grammar_admits_a_continuation_line_data_initializer_the_host_route_refuses" as NonEmptyStr,

  receipts: [
    "**a `data` declaration whose initializer begins on the line AFTER the `=` parses in the v2 grammar route and is REFUSED by the v1 host route** (INVALID STATE: `data t: Int =` with `  2` on the next line: `decl_facts`' walk over the v2 grammar admits it, `concept_decl_facts`' parse route refuses it fail-closed with 'expected expression, found Newline' at the `=`'s column. The same file is simultaneously grammatical and ungrammatical, so every consumer of one route silently disagrees with the other; gunbc#14608 was forced to JOIN such initializers onto the `=` line to satisfy the host after gunbc#14559 landed them in the continuation layout that the grammar route had admitted.)",
    "WHERE, cited by symbol. The v2 side declares NOTHING about the line: `v2.extdeps.languages.dag` `dag_grammar_data_decl_expr` sequences data, ident, :, type_expr, `=`, Expect(`v2.extdeps.languages.dag.dag_production_expr`) with no `v2.std.grammar` AfterLineBreak anywhere in it, while AfterLineBreak IS the vocabulary the spec uses when it DOES condition a production on line structure (`dag_grammar_additive_newline_minus_guard`, the dual-role `-` guard) -- so the matcher's newline-skipping default accepts. The v1 side refuses by ACCIDENT, not by rule: `v1.compiler.parse` `parse_data_after_kw` fed the token right after ExpectEq straight into `parse_expr`, which refuses a Newline at expression start -- while every sibling `=` position in the same parser (`=` of a type alias, of an expression-bodied `fn`, of `let`) calls `skip_newlines` after its `=`. The data site was the odd one out INSIDE v1, and neither host's behavior was declared anywhere: a second authority by absence.",
    "SCOPE. Only the data initializer: an initializer that continues onto a later line, in any file, read by one route and not the other. The fail-closed half is SHARED and stays shared: with no initializer at all (`data t: Int =` then a blank line or the next declaration), an expression cannot start at the `data` keyword, and BOTH routes refuse at that token (measured: the blank and dangling cells agree on both sides of the fix). Corpus census at the fix (text-shape scan of the authored tree): 32,393 joined initializers, ZERO authored continuation sites; the single text-shape match is `src/v1/stage0/tests/fixtures/fact_cardinality_split_brace.dag`, a headerless fragment whose unparseability is the subject of `extract_top_level_decls_captures_split_brace_body` (`v1_compiler.cli_run`) -- so the acceptance change reaches no authored text and only converts previously-refused VALID text into accepted text, declared here.",
    "RUNG FOUND AT: below the floor (silent disagreement between two parse authorities over one text; each consumer of a route reads a different grammar). CEILING: one rule, both routes. NEXT-RUNG TRIGGER, NAMING THE CAPABILITY: the data initializer's line rule is declared in ONE place and both parse routes follow it -- decided (manager ruling 2026-10-21) to be the permissive rule that every sibling `=` position already follows: after the data `=`, the initializer is the expression production with newlines skipped, refusing only where no expression can start.",
    "CLIMBED, THE TRIGGER CAPABILITY MET (this row's fix PR). `v1.compiler.parse` `parse_data_after_kw` now calls `skip_newlines` after its ExpectEq, the same call its sibling `=` sites make, so the host route follows the declared permissive rule and the grammar route's default IS the rule; the fix is not a number or a special case -- it removes the missing call that made the data site the exception. The four-cell claim runs one text through BOTH routes in one binary (the v1 host route over the compiled-in `dag_parse_environment`, the v2 route over `dag_prepared_grammar`): joined and continuation accept on both, blank and dangling refuse on both, and the refuse string prints the per-cell verdicts, so a regression that re-splits any cell reports which one.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.test.claim.parse.data_initializer_layout_parse", decl_name: "a_continuation_line_data_initializer_parses_on_both_routes", field: WholeDeclaration },
  ],
}
