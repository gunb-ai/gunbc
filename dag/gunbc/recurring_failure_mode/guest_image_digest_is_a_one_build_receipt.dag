module gunbc.recurring_failure_mode.guest_image_digest_is_a_one_build_receipt

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data guest_image_digest_is_a_one_build_receipt: RecurringFailureMode = RecurringFailureMode {
  identity: "guest_image_digest_is_a_one_build_receipt" as NonEmptyStr,

  receipts: [
    "INVALID STATE: a guest image's SHA-256 (workspace image, revision-job image) read as a promise that rebuilding from the same pinned inputs yields the same bytes, or as a correctness oracle.",
    "HARM: a digest that cannot be reproduced cannot be re-derived by a second producer, so a rebuild that must match a running image, or a third party checking the image, silently has nothing to compare; and a pin read as correctness would bless whatever the one build produced.",
    "DISTINGUISHING FACTS: mke2fs -d populates the image with no fixed UUID, hash seed or timestamps (code-derived from gunbc.extdeps.tools.e2fsprogs mke2fs_populate_command, not measured), so two builds from identical pinned inputs are not byte-identical; the pin is an IDENTITY BINDING (the installed bytes are the bytes CI built and the reviewer pinned), not evidence the image is correct.",
    "RUNG FOUND AT: mitigatable. The build refuses unless every input matches its pin and the installer refuses typed on a digest mismatch or absent artifact, but the image bytes themselves are one build's.",
    "CEILING: mechanically preventable by a deterministic image build (fixed UUID, hash seed and timestamps) checked by building twice and comparing digests. NEXT-RUNG TRIGGER (can climb now, unbuilt, and not yet owed): when a second, independent producer must agree with the first -- third-party verification, or a rebuild that must match a running image.",
    "SUBJECTS: gunbc.workspace_image_delivery workspace_image_build_wet; gunbc.revision_job_image_delivery revision_job_image_build_wet.",
  ],

  evidence: [],
}
