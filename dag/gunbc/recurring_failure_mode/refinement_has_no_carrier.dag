module gunbc.recurring_failure_mode.refinement_has_no_carrier

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data refinement_has_no_carrier: RecurringFailureMode = RecurringFailureMode {
  identity: "refinement_has_no_carrier" as NonEmptyStr,

  receipts: [
    "INVALID STATE (historical): a where clause refining a fn parameter, record field or io field, which v1 reads, while v2 dropped the clause on the lowered binder because body_lower_kept_where_clause served only a type variant.",
    "CLIMB RECEIPT: the binder's lowered type IS the type-variant Conj. Fields (body_lower_field_binder_edges, body_lower_io_item_step) and parameters (body_lower_typed_param_optional via body_lower_binder_edge_read) call body_lower_type_with_kept_where, which is body_lower_kept_where_clause plus the same children a type variant stores. body_lowering_reason_field_refinement_unmodeled and body_lowering_reason_parameter_refinement_unmodeled have no producer. infer refinement_declaration reads that Conj inline (refinement_declaration_of_node) as well as via a named alias. Not v2.std.refinement Refined<B>.",
    "HARM of the remaining class: a predicate on a non-literal is still the sibling gunbc.recurring_failure_mode refinement_predicate_enforced_only_where_the_value_is_a_literal; this row was the missing CARRIER, not that judgment.",
    "RUNG FOUND AT (executed 2026-10-13, native v1_compiled sha256 c10a8997989699ecfe243509a4e1f5739cb70407df04a7245ef8d1106161c613 from seed emit of v2.cli.compile_cli on main+#13803+this PR): structurally guaranteed for the carrier. Native emit --entry v2.cli.compile_cli first fatal is body_lowering_reason_service_realization_unreachable at extdeps.filesystem.filesystem_io, not body_lowering_reason_field_refinement_unmodeled at std.decimal. Native emit --entry std.decimal and --entry extdeps.languages.go.go_mod refuse at resolve_reason_unbound_symbol, not field refinement. claim_batch PASS: a_refined_field_lowers_holds, a_refined_field_type_is_the_type_variant_where_conj_holds, a_refined_parameter_lowers_holds, an_inline_field_refinement_and_a_type_alias_refuse_the_same_violating_literal_holds. CEILING for the carrier: structurally impossible (no constructor that drops the clause). NEXT-RUNG TRIGGER for PREDICATE checking stays with refinement_predicate_enforced_only_where_the_value_is_a_literal.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.test.claim.parse.parameter_refinement", decl_name: "a_refined_parameter_parses_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.parse.parameter_refinement", decl_name: "a_refined_parameter_lowers_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.parse.population_grammar_gaps", decl_name: "a_refined_field_parses_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.parse.population_grammar_gaps", decl_name: "a_refined_field_lowers_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.parse.population_grammar_gaps", decl_name: "a_refined_field_type_is_the_type_variant_where_conj_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.parse.population_grammar_gaps", decl_name: "a_refined_io_field_parses_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.parse.population_grammar_gaps", decl_name: "an_inline_field_refinement_and_a_type_alias_refuse_the_same_violating_literal_holds", field: WholeDeclaration },
  ],
}
