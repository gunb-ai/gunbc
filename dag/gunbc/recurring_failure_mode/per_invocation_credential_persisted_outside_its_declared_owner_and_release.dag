module gunbc.recurring_failure_mode.per_invocation_credential_persisted_outside_its_declared_owner_and_release

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { BlockerClassUnstated, RecurringFailureMode, RungUnread }

data per_invocation_credential_persisted_outside_its_declared_owner_and_release: RecurringFailureMode = RecurringFailureMode {
  identity: "per_invocation_credential_persisted_outside_its_declared_owner_and_release" as NonEmptyStr,
  rung: RungUnread { cause: BlockerClassUnstated },

  receipts: [
    "**A credential handed to a tool for one invocation is silently written to storage the tool chooses, which no owner declared and no release removes** (INVALID STATE: a secret outlives the attempt that was granted it, in a location nothing tracks; harm: the credential persists on disk under an operator's or another attempt's home, readable after the custody release, and later invocations silently authenticate from it).",
    "SPECIMEN, observed on srv2 2026-10-17 with cursor-agent 2026.09.15-d2fe57e: a keyed invocation PERSISTS [accessToken, refreshToken, apiKey] under $XDG_CONFIG_HOME/cursor/auth.json, in whatever HOME/XDG root the invocation inherited. Passing the key in the environment, which the custody design treats as per-invocation, is not per-invocation for this tool.",
    "DISTINGUISHING FACTS: the leak is a side effect of the tool, absent from its argv and from its exit status, so no refusal fires; it is found only by listing the config root after a keyed call. Removing the snapshot tombstones the custody copy and leaves the tool's copy.",
    "RUNG FOUND AT: mitigatable (found by observation after the fact). CEILING: structurally guaranteed when the root is attempt-owned, registered on the A3 record before it exists, created 0700, and removed under the same gate as the snapshot tombstone. NEXT-RUNG TRIGGER: step 3 binds HOME and XDG_CONFIG_HOME to that root on every Cursor invocation; until then the root is created and cleaned but nothing runs under it.",
  ],
  evidence: [
    DeclarationRef { module_path: "gunbc.dispatch_credential_acquisition", decl_name: "credential_create_cursor_runtime_root", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.dispatch_credential_acquisition", decl_name: "credential_discard_taken_attempt", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.dispatch_credential_acquisition", decl_name: "credential_seal_after_terminate", field: WholeDeclaration },
  ],
}
