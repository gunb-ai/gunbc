module gunbc.recurring_failure_mode.a_wire_field_bounded_by_upstream_is_fed_an_unbounded_identifier

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { BelowCeiling, FoundOnRung, RecurringFailureMode, RungRead }
import gunbc.rung_climb { ClimbableButUnbuilt }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable, StructurallyImpossible }

data a_wire_field_bounded_by_upstream_is_fed_an_unbounded_identifier: RecurringFailureMode = RecurringFailureMode {
  identity: "a_wire_field_bounded_by_upstream_is_fed_an_unbounded_identifier" as NonEmptyStr,

  rung: RungRead { found_at: FoundOnRung { rung: Mitigatable }, standing: BelowCeiling { current: FoundOnRung { rung: MechanicallyPreventable }, ceiling: StructurallyImpossible, blocker: ClimbableButUnbuilt, trigger_capability: "the capability of constructing an ApnsCollapseId only through a constructor whose output is bounded by apns_collapse_id_max_size (the digest, or a checked constructor returning Optional), so an over-long collapse id has no spelling and the brand cast is not a route" } },

  receipts: [
    "**an upstream field with a length cap is filled with an identifier of our own whose length nothing bounds, so a whole family of identifiers is refused at send time** (INVALID STATE: gunbc.auth.approval_apns_publish approval_push_request used an approval request's escalation id verbatim as the APNs apns-collapse-id, which Apple caps at 64 bytes (extdeps.apple.apns apns_collapse_id_max_size), while escalation ids carry no length bound; every printer request id is a prefix plus a 64-hex digest, 78 to 85 bytes. HARM: the broker filed the card and refused the push, so the operator's phone never heard of the printer hold-release request of 2026-11-05 (fleet-converge run 42031845788: 'device push 0/1 accepted: ... the notice's locator is longer than APNs admits for a collapse id'), and the card expired unseen after its 30-minute window; every printer-start approval would have done the same. DISTINGUISHING FACTS: the refusal was typed and located, so this was never silent -- but a refusal over a population our own naming produces is a wall we built in front of ourselves; the cap belongs to the upstream field, and the identifier's shape is ours. RECOGNITION RULE: when a value of our own fills an upstream field that has a size cap, ask whether the value's type bounds it below the cap; if not, derive the field by a construction whose output is bounded for every input (a fixed-width digest), rather than refusing the inputs that happen to be long. RUNG FOUND AT: mitigatable (typed refusal at send). CURRENT RUNG: mechanically preventable -- the one producer is now the SHA-256 of the locator (gunbc.auth.approval_apns_publish apns_collapse_id_of), 64 lowercase hex octets for every locator, and the length refusal is deleted; the discriminating control is test.claim.approval_apns_publish_witness an_escalation_id_longer_than_the_collapse_cap_is_sent_under_its_digest, which fails against the verbatim form; the brand cast `as ApnsCollapseId` still admits an over-long value, so the state stays writable. CEILING: structurally impossible per field (NEXT-RUNG TRIGGER: the brand is constructible only through a bounded constructor); other capped upstream fields fed our identifiers are a sibling search, not covered by this row.)",
  ],

  evidence: [
    DeclarationRef { module_path: "gunbc.auth.approval_apns_publish", decl_name: "apns_collapse_id_of", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.auth.approval_apns_publish", decl_name: "approval_push_request", field: WholeDeclaration },
    DeclarationRef { module_path: "extdeps.apple.apns", decl_name: "apns_collapse_id_max_size", field: WholeDeclaration },
  ],
}
