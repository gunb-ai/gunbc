module gunbc.recurring_failure_mode.instrumentation_counters_inside_a_semantic_value_defeat_identity

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data instrumentation_counters_inside_a_semantic_value_defeat_identity: RecurringFailureMode = RecurringFailureMode {
  identity: "instrumentation_counters_inside_a_semantic_value_defeat_identity" as NonEmptyStr,

  receipts: [
    "INVALID STATE: a value that carries semantic content also carries counters that observe its own use, which change on every operation. Two values holding the same semantic content therefore never compare equal, so any identity keyed on the value (a content-keyed memo, a demand key, a dedup) can never recur. Every demand over it is a guaranteed miss that still pays key construction, stores an entry and keeps the argument alive.",
    "INSTANCE: v2.compiler.parse ParseTableRealization carries memo_hits, memo_misses and memo_lookup_calls beside its entries, furthest failure and carried grammar analysis. parse_table_record_lookup_call, parse_table_record_hit and parse_table_record_miss rebuild the record on every lookup, so every call taking the table presents the seed eval-frame memo (extdeps.realization.eval_memo) with a new, never-recurring key. The seed memo still keys each such call, stores one entry and retains every table version (eval_call_memo_put). The key-derivation repair (per-insert map key, beside #12066's per-push list key) makes each of those keys O(1) plus the changed entry. It makes the redundant work CHEAP; it does not remove it. That is DESIGN section 2's warning that caching makes redundant work cheap and suppresses the signal that would rank it for deletion.",
    "HARM: bounded per call after the key repair, but unbounded in aggregate: one retained table version per table-taking call for the provider scope, and a memo that reports misses on a population no admission could ever serve. It also hid the parse's quadratic key cost behind the parser's own name (the 02_parse list-literal cost that blocked #12377), where it presented as a grammar defect.",
    "RUNG FOUND AT: mitigatable. Nothing stops a semantic carrier from embedding its own instrumentation; the key repair only bounds the cost.",
    "ATTAINABLE CEILING: structurally impossible for carriers whose identity is consumed. Instrumentation is an observation of an occurrence (std.observation), not a field of the observed value, so a counter belongs in the observation channel beside the value, never inside it. NEXT-RUNG TRIGGER, NAMED AS A CAPABILITY: the parse's memo statistics (ParseMemoStats) produced by an observation channel the parse threads beside ParseTable, SUFFICIENT FOR ParseTable to compare equal across two calls that did the same semantic work, with every current ParseMemoStats consumer reading the channel instead of the table. The admission side of the same demand population (whether the seed memo should key a call that cannot recur) is the roadmap row eval-memo-admission-rewire-program, not this row.",
  ],

  evidence: [
    decl_ref(module_path: "v2.compiler.parse", decl_name: "ParseTableRealization"),
    decl_ref(module_path: "v2.compiler.parse", decl_name: "parse_table_record_lookup_call"),
    decl_ref(module_path: "v2.compiler.parse", decl_name: "parse_table_memo_stats"),
    decl_ref(module_path: "extdeps.realization.eval_memo", decl_name: "eval_memo_facts"),
  ],
}
