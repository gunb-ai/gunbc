module gunbc.recurring_failure_mode.a_secret_crosses_into_shell_stdin_as_a_plain_string

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { FoundAtAmbiguous, RecurringFailureMode, RungUnread }

data a_secret_crosses_into_shell_stdin_as_a_plain_string: RecurringFailureMode = RecurringFailureMode {
  identity: "a_secret_crosses_into_shell_stdin_as_a_plain_string" as NonEmptyStr,

  rung: RungUnread { cause: FoundAtAmbiguous },

  receipts: [
    "INVALID STATE: a value declared Secret is bound to a shell transport's stdin and executed, and nothing at the crossing records that it was a Secret. The seed's shell_stdin_payload (src/v1/stage0/src/v1_interpreter.rs) accepts any Value::Str and writes its bytes. Secret is std.types `nominal_opaque = String`, so at runtime it is indistinguishable from a String, and no declared conversion stands between the Secret position and the String-typed stdin field. That is an implicit crossing, which DESIGN section 4 admits only when it is consent-free, and handing a credential to a child process is not consent-free.",
    "WHY IT MATTERS, AND WHERE THE GUARANTEE STOPS TODAY: keeping the secret out of observable output rests on a code-path reading, not executed evidence. render_shell_completion_trace renders argv, intent, timing and, on a failed outcome, a tail of captured stderr; it never renders stdin. But nothing witnesses this with a sentinel value, no other receipt or claim-render path has been checked, and a child that echoes its input to stderr would put the secret into the Failed trace through the stderr tail.",
    "HARM: a credential can leave its custody boundary (DESIGN section 5, 'never conceal the deficit') through a trace or receipt, with no typed refusal, because the type that would carry the custody obligation has already been erased to String at the crossing.",
    "DISTINCT FROM gunbc.recurring_failure_mode.kernel_type_secret_has_no_v2_value_type_node: that row is about the v2 resolve-to-infer judgment of Secret-declared positions. This row is about the runtime crossing into a transport field and the unwitnessed redaction, and it survives that row's trigger: a v2 value-type node for Secret makes the declaration decidable, but it does not make the stdin crossing a declared conversion, and it does not witness redaction.",
    "RUNG FOUND AT: no guarantee rung established. Omitting stdin from completion traces is a source-observed partial mitigation; containment across the in-scope receipt and render paths is not established. CEILING: structurally guaranteed. A Secret reaches a transport field only through a declared, consent-bearing conversion whose realization the compiler checks for redaction on every receipt and render path. Decidable once Secret has its v2 node and the transport binding vocabulary distinguishes a secret-carrying field.",
    "NEXT-RUNG TRIGGERS, naming capabilities: (1) mechanically preventable: an executed witness that runs a stdin-bound shell operation with a sentinel Secret through every receipt and render path, the Failed stderr tail included, and finds the sentinel absent, with a RED where rendering stdin makes it fail. On retirement that sentinel witness must exercise the echo-to-stderr failure path (a child that echoes its stdin to stderr, then fails), not only refuse the implicit conversion. (2) structurally guaranteed: a declared Secret-to-transport conversion, refused when implicit, sufficient for a Secret-typed input bound to a String-typed shell field to refuse on the acceptance path.",
    "FILED 2026-10-18 at merry-fox-82's direction, from royal-moth-277's read-only check while choosing the mtcollins1 lost-boot sweep's token route. That sweep took the existing typed REST route (github.ActionsSelfHostedRunners, Bearer auth from an installation_token typed Secret) partly because the stdin route carried this unchecked crossing. Not fixed here."
  ],

  evidence: [
    DeclarationRef { module_path: "std.types", decl_name: "Secret", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.recurring_failure_mode.kernel_type_secret_has_no_v2_value_type_node", decl_name: "kernel_type_secret_has_no_v2_value_type_node", field: WholeDeclaration },
  ],
}
