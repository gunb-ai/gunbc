module gunbc.recurring_failure_mode.ts_single_quoted_string_body_reuses_the_double_quoted_char_class

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { CeilingStatedWithoutTrigger, RecurringFailureMode, RungUnread }

data ts_single_quoted_string_body_reuses_the_double_quoted_char_class: RecurringFailureMode = RecurringFailureMode {
  identity: "ts_single_quoted_string_body_reuses_the_double_quoted_char_class" as NonEmptyStr,

  rung: RungUnread { cause: CeilingStatedWithoutTrigger },

  receipts: [
    "INVALID STATE: v2.extdeps.languages.typescript ts_string_lit_lex_rule delimited a single-quoted string with a body of RepeatPattern over StringTextChar, the DOUBLE-quoted body class (v2.compiler.tokenize: excludes the double quote and newline, not the single quote). The greedy body consumed the closing quote, the close never matched, and every single-quoted TypeScript string refused in tokenize.",

    "SPECIMENS: `const bit: 'On' | 'Off' = bit;` refused tokenize_lex_e1_unrecognized_char at the first quote (gunbc run, BuildBuddy invocation b9e2870f), as did the three-variant status union. Both were data TestClaim rows no runner executes.",

    "HARM: a modeled token class that can never be produced; any TypeScript claim over a string literal was false and silent.",

    "REPAIR: ONE single-quoted body authority, v2.std.compilers.lexing SingleQuotedStringTextChar (excludes only the single quote and newline; matched in v2.compiler.tokenize beside StringTextChar), consumed by ts_string_lit_lex_rule. The delimiter is excluded by the class, so body and close are disjoint by construction and a double quote is ordinary text; no NotFollowedByPattern guard remains. A first repair guarded each body char with NotFollowedByPattern but still reused StringTextChar, so 'a\"b' still refused (side-chat review of gunbc#13760). Escapes (a backslash-escaped quote) are a stated frontier: the TS subset models none. CONTROLS: a_single_quoted_ts_string_lexes_as_one_string_token_holds ('On') and a_double_quote_inside_a_single_quoted_ts_string_stays_in_one_token_holds ('a\"b'), both in v2.test.claim.parse.parse_test_typescript_grammar.",

    "RUNG FOUND AT: below the floor (unexecuted). CEILING: 2 -- the control is the wall; a delimited pattern whose body can match its own close is decidable from the rule and could be refused when the lexer is prepared (3), which is the next trigger. OWNER: grammar program (stern-bear-500).",
  ],

  evidence: [],
}
