module gunbc.recurring_failure_mode.a_recursive_record_declaration_cascades_module_wide_grounding_failure

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { RecurringFailureMode }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data a_recursive_record_declaration_cascades_module_wide_grounding_failure: RecurringFailureMode = RecurringFailureMode {
  identity: "a_recursive_record_declaration_cascades_module_wide_grounding_failure" as NonEmptyStr,

  receipts: [
    "a recursive record declaration undoes grounding for the whole module. INVALID STATE: an author declares a record whose field names the record's own type (`type N = Wrap { seed: N }`) and writes an ordinary fn over it (`fn f(a: N) -> N { a }`); infer refuses the module with a cascade of ~28 infer_grounding_not_derived diagnostics -- including inhabitance_undecidable_formal_unresolved and inhabitance_undecidable_argument_type_not_derived mid-chain -- so every fact in the module is underived, with no diagnostic naming the self-referential declaration as the cause. HARM: one declaration's cycle is reported as a module-wide failure to ground; the reader is sent to debug every binding in the module instead of the one declaration that carries the cycle.",

    "RECEIPT, 2026-10-06, session clever-bat-68, minimal fixture from the variant-scrutinee infer work (#13210), printed by reading the readings through the gunbc run --function decode route rather than inferred. A one-module fixture program assembled through v2.compiler.program_assembly assemble_program_from_ingest declares `type N = Wrap { seed: N }` and `fn f(a: N) -> N { a }`; infer refuses with the cascade above. The SAME fixture shape with the recursive field removed (types carrying payload variants over bare-Int fields, non-recursive, as v2.test.claim.match_binder.match_binder_typing's mbt_decls does) grounds and its claims pass on the same route -- so the cascade tracks the recursive declaration, not the assembled-program route, the one-module shape, or the bare-Int spelling. The grounding wall reads type-name atoms through the one binding->value-type join (v2.std.inhabitance's dag_binding_denotation seam, inhabitance.dag lines ~3553-3557: 'a declared type that is a bare atom the join does not denote ... is counted UndecidableFormalUnresolved'); a self-referential record is exactly a bare atom the join does not denote, and the cascade is the wall answering module-wide for it.",

    "RUNG FOUND AT: below the ladder -- the cascade is silent about its cause: no diagnostic names the recursive declaration, and the refusal chain reads as if every binding in the module were separately ungroundable. ATTAINABLE CEILING: structurally decidable -- the declaration graph of a module is finite, so a cycle in it is findable at fill time and can be named. NEXT-RUNG TRIGGER: the binding->value-type join either grounds a declaration whose field type names its own declared type (a fixpoint read) or refuses WITH the cycle's declaration named in a located diagnostic, so a module containing one self-referential record does not turn into a module-wide grounding cascade. NOT FIXED IN #13210: the probe routes around this shape (its fixtures are non-recursive) and this row records it for its own follow-up.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.test.claim.variant_field_infer_probe", decl_name: "vfp_fx2_src", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.std.inhabitance", decl_name: "declared_type_inhabitance", field: WholeDeclaration },
  ],
}
