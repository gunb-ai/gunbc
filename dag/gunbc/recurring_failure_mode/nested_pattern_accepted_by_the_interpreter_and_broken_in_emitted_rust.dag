module gunbc.recurring_failure_mode.nested_pattern_accepted_by_the_interpreter_and_broken_in_emitted_rust

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data nested_pattern_accepted_by_the_interpreter_and_broken_in_emitted_rust: RecurringFailureMode = RecurringFailureMode {
  identity: "nested_pattern_accepted_by_the_interpreter_and_broken_in_emitted_rust" as NonEmptyStr,

  receipts: [
    "INVALID STATE: a match that the seed's typecheck and interpreter accept, and whose emitted Rust either does not compile or panics. Two shapes, both found by the EdgeLabel cut (quiet-koi-814, gunbc#12799) only when neat-boar-16 ran self-host on srv1 -- no local claim, compile or interpreter run showed either. (1) A RECORD PATTERN that destructures a coproduct field -- `Edge { label: Authored { name: f }, target: t }` beside `Edge { label: Positional, target: _ }` -- is not checked for exhaustiveness over the field's coproduct, so adding an EdgeLabel arm left two such matches (`v2.extdeps.languages.dag` `dag_int_literal_magnitude_edge_target_optional` and its twin in `v2.std.compilers.target_model`) accepted and the emitted crate failed rustc E0004. The same blind spot covers a match whose scrutinee reaches the checker through a generic call (`list_at_optional`), which surfaced as six runtime pattern-match failures in the interpreter. (2) A THREE-LEVEL CONSTANT PATTERN -- `StructuralLabel { label: CoreMarker { marker: ArrowBodyEdge } }` beside a sibling arm with a different constant marker -- is lowered by `v1.compiler.emit_rust` as a guard on the middle variant only plus a `let ... else { unreachable!() }` on the innermost constant, so the first arm with the right middle variant but the wrong marker panics (`v2.std.node` `arrow_signature_edges_conform`, emitted line 676, in the self-host binary and the census driver). The interpreter evaluates both shapes correctly.",
    "HARM: the self-host route and every emitted consumer fail where every interpreter-side check is green, so the defect is found by the most expensive run and after review; shape (2) is a panic in a compiler binary, not a typed refusal.",
    "RUNG FOUND AT: below the floor on the emitted path for shape (2) (an accepted program that panics), rung 1 for shape (1) (rustc refuses the emitted crate, loudly but late). The interpreter path is correct for both. CEILING: structurally guaranteed -- exhaustiveness over nested and record patterns is decidable, and a constant nested pattern has a total lowering (a nested match, not a guard plus let-else). NEXT-RUNG TRIGGERS, NAMING THE CAPABILITIES: the seed's match exhaustiveness check descends into record-pattern fields and through generic-call scrutinees, so an incomplete coproduct match refuses at typecheck; and `v1.compiler.emit_rust` lowers a nested constant pattern to a nested match (or a total guard over every level), so no accepted pattern lowers to unreachable!(). Until then the EdgeLabel cut spells marker tests as `v2.std.node` `edge_is_core` predicates rather than three-level constant patterns -- a stated workaround, not a fix.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.std.node", decl_name: "edge_is_core", field: WholeDeclaration },
  ],
}
