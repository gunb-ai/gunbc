  rung: RungRead { found_at: FoundOnRung { rung: Mitigatable }, standing: BelowCeiling { current: FoundOnRung { rung: MechanicallyPreventable }, ceiling: StructurallyGuaranteed, blocker: ClimbableButUnbuilt, trigger_capability: "the capability of reading, for every job that waits on another run, the runner labels that run's jobs require, so generation refuses a wait placed on any runner the awaited run can need, rather than only the branch run grant's wait off GitHub-hosted runners." } },

