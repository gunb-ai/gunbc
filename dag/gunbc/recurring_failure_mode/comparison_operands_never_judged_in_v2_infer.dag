module gunbc.recurring_failure_mode.comparison_operands_never_judged_in_v2_infer

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data comparison_operands_never_judged_in_v2_infer: RecurringFailureMode = RecurringFailureMode {
  identity: "comparison_operands_never_judged_in_v2_infer" as NonEmptyStr,

  receipts: [
    "**In v2 infer, the operands of an equality or ordering comparison are never judged against each other.** Measured on session/stern-swift-290-literal (XL-2 literal elaboration), with fixtures assembled through the production route and inferred: `fn k(n: Nat) -> Bool { n == (0 + 1) }`, where n is std.nat Nat and the right operand is an Int, is ACCEPTED. A Nat compared with an Int is a type error the compiler floor owes (DESIGN section 4b, values inhabit declared types), so this is below the floor and silently admitted.",

    "DISTINGUISHING FACTS. (1) v2.compiler.infer infer_binary_algebra_field reads the operator's canonical-operation wire and answers a field only for AlgebraPrimitive (`+` ^ring_field_add, `||` ^lattice_field_join, `&&` ^lattice_field_meet). For EqualityComparison and OrderingComparison (`==`, `!=`, `<`, `<=`, `>`, `>=`) it answers Absent. (2) A binary Transform whose operator is not an algebra primitive stays GroundingNotDerived, so infer_unify_transform_operand_types is never reached for it and nothing compares the two operand types. (3) This is not a literal problem: any two operands of different types compare without a diagnostic. Found while measuring the reach of a literal-elaboration change, where a control expected `n == 0` to exercise the operand route and it did not.",

    "RUNG FOUND AT: below the floor (silently admitted). CEILING: structurally guaranteed. Whether two operand types can be compared is decidable over modeled types: through the equality and ordering structures (Equivalence, ordered structures) the operand type's AlgebraInhabitanceDecl rows declare. NEXT-RUNG TRIGGER, NAMED AS A CAPABILITY: an infer arm that judges comparison operands -- and the inverse-compose operators (`-`) of the receipt below -- through the equality/ordering structure via the same inhabitance rows the algebra-operator arm reads (gunbc#13060's route extended to EqualityComparison and OrderingComparison), sufficient for every comparison whose operand types are derived to be judged rather than left GroundingNotDerived. Owner, per the N7 manager: the #13060 operator route.",
    "SECOND OPERATOR POPULATION, SAME CLASS (calm-boar-904): subtraction. The `-` token canonicalizes to canonical_operation_op_sub, an AlgebraInverseCompose (add composed with the group inverse), and infer_canonical_operation_field answers Absent for AlgebraInverseCompose exactly as for the comparisons, so a binary `-` also stays GroundingNotDerived and its operands are never judged. Specimen: v2.std.node's `count(children) - positional_child_count(children: children)`, where count returns std.nat Nat and positional_child_count returns Int, passes with no diagnostic. The repair the trigger names covers both populations together: comparisons through the equality/ordering structure, and inverse-compose operators through their binary field plus the inverse the structure declares.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.compiler.infer", decl_name: "infer_binary_algebra_field", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.compiler.infer", decl_name: "infer_unify_transform_operand_types", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.std.node", decl_name: "positional_child_count", field: WholeDeclaration },
  ],
}
