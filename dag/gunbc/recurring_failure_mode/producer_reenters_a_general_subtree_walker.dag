module gunbc.recurring_failure_mode.producer_reenters_a_general_subtree_walker

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data producer_reenters_a_general_subtree_walker: RecurringFailureMode = RecurringFailureMode {
  identity: "producer_reenters_a_general_subtree_walker" as NonEmptyStr,

  receipts: [
    "**a producer re-enters a general subtree walker and multiplies work by enclosing-tree depth** (INVALID STATE: a body producer that owns a captured slot reaches its content not by consuming that slot once but by handing it to a GENERAL reader -- the value reader `v2.compiler.body_lowering_fold` `body_lower_value_lowered`, which folds the subtree bottom-up and, when the fold does not bring it to a lowered node, falls to the top-down walker `body_lower_body_subtree_lower` and its deep searches (`body_lower_find_captured`, `body_lower_find_control_form_optional`) -- and that reader in turn reaches the NEXT producer the same way. Each nesting level then re-traverses what the levels above it already traversed, so the visits per owned node grow with the depth of the tree enclosing it rather than staying bounded.)",
    "RECEIPT (2026-09-25, neat-boar-16 on srv1, gunbc#12210 at dfbae61a4b stacked on gunbc#12208): on the three largest closure files (`v2.extdeps.languages.dag` at 209k nodes and depth 750, `v2.compiler.body_lowering_fold`, `v2.std.compilers.target_model`) the native route cost at least 33x the wall time of the base, and the 133-file context produced no split row in 55 minutes, so the native route could not reach the seven. The HYPOTHESIS, not yet a finding: gunbc#12208 routes every value position through `body_lower_value_lowered`, and gunbc#12210's function-value producer (`body_lower_function_value`) re-enters that door for an expression body and `body_lower_body_from_fn_captured` for a block body, while deferring function values from the bottom-up fold -- so a value containing a function value no longer folds whole and falls to the walker, whose own comment on `body_lower_value_lowered` prices entering it first as exponential in nesting depth. Wall time rules out non-termination and does not establish the shape; operation counts on fixed-shape specimens do.",
    "DISTINGUISHING FACTS. This is a COST class, separate from the semantic class `lambda_has_no_lowered_function_value_form`: the lowering it produces can be correct while its cost is unbounded, so the semantic row's controls stay green over it. It is not a missing memo: DESIGN section 2 prices a cache over repeated demand as suppressing the signal, and the repair is the demand graph -- each producer consumes its own captured slots directly. The recognition rule: the count of entries into a general reader, divided by the number of nodes the input owns, GROWS with input depth or size (visits/nodes bounded is a constant factor; growing is amplification).",
    "RUNG FOUND AT: mitigatable at best -- nothing refuses the shape; it is observed only as wall time on large inputs. CEILING: structurally guaranteed. Whether a producer reaches its content through its own captured slots or through a general walker is decidable on the producer's call structure.",
    "NEXT-RUNG TRIGGER, NAMING THE CAPABILITY: every body producer consumes its direct captured slots -- the production identity is already known at dispatch, `v2.compiler.fold_lowering` `FunctionValueParts` carries the exact body slot, and that body is lowered once through a scoped producer -- so each owned node is visited a bounded number of times, and an unsupported operand refuses when it is visited, in work bounded by its own captured subtree, never by a search of unrelated siblings. The evidence that climbs it is per-reader visit counts on deep and wide specimens with visits/nodes bounded, plus the three large closure files and the 133-file context reaching the seven.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.compiler.body_lowering_fold", decl_name: "body_lower_value_lowered", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.compiler.body_lowering_fold", decl_name: "body_lower_function_value", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.compiler.body_lowering_fold", decl_name: "body_lower_body_subtree_lower", field: WholeDeclaration },
  ],
}
