module gunbc.recurring_failure_mode.match_bound_element_type_mask

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data match_bound_element_type_mask: RecurringFailureMode = RecurringFailureMode {
  identity: "match_bound_element_type_mask" as NonEmptyStr,
  receipts: [
    "**A FreeMonoid<DeclarationRef> or FreeMonoid<ApplicationRow> bound by a match-arm pattern mask does not carry its element type into a lambda passed to a container method** — the element type arrives as the Empty variant of FreeMonoid, so `origin.decl_name` on `observed` (type FreeMonoid<DeclarationRef>) or `row.label` on `rows` (type FreeMonoid<ApplicationRow>) fails with `no field X on type Empty`. The same usage on a `let` binding from a field access type-checks correctly.",
    "SPECIMEN 1 (gunbc#10600) — `EmissionOriginsIncomplete { observed, missing } => observed |> map(origin => origin.decl_name)` reports `no field 'decl_name' on type 'Empty'` at dag/test/claim/emission_provenance_test.dag:179 test fn `emission_combined_read_preserves_content_order_and_origin_multiplicity`. The `observed` variable is `FreeMonoid<DeclarationRef>` by the variant declaration. Preserved as a discriminating RED: the test file retains this line; the floor will red until the compiler defect is repaired.",
    "SPECIMEN 2 (gunbc#10625) — `RowsPresent { rows } => rows |> any(row => row.label == \"kept\")` reports `no field 'label' on type 'Empty'` at dag/test/claim/algebra_receiver_application_witness_test.dag and dag/test/claim/algebra_receiver_forwarding_witness_test.dag (the forwarding file carries it twice, including inside a nested `bound => match bound` arm showing the mask survives a whole-value rebind). The `rows` variable is `FreeMonoid<ApplicationRow>` by the variant declaration. #10625's repair preserves nominal generic applications at `pattern_subject_from_node` in the v1 compiler; as of this writing #10625 is unmerged and its repair is unestablished.",
    "CLASS BOUNDARIES, traced but not convicted: `match` evaluates the scrutinee (a coproduct), selects the variant arm, and binds field variables (including FreeMonoid<T> containers) into the arm's scope. The element type T survives into the binder's resolved type node, as evidenced by `let` bindings and function parameters resolving correctly. But when a lambda inside a method-call (map, any, all, filter) accesses the element — i.e., when the element passes through the ReceiverElement type variable in an algebra template — the type checker resolves it as the Empty variant of the container rather than the actual element type. This suggests the binder's element type is structurally expanded to Empty during some resolution step that `let` bindings skip.",
    "RUNG FOUND: floor (compile-time refusal). CEILING: compiler-guarantee (a required executing control that rejects this class on any FreeMonoid<T> call site where T is a record type with named fields accessed in the lambda). NEXT-RUNG TRIGGER: an executing control that binds a FreeMonoid<DeclarationRef> by match-arm pattern, calls `map(r => r.decl_name)`, and expects `true` (green compile) followed by runtime identity assertion — the requested control is distinct from both PR workarounds and must establish the element type survives through algebra-template instantiation from a match-bound receiver.",
  ],
  evidence: [],
}
