module gunbc.recurring_failure_mode.expected_type_not_supplied_to_a_fold_step_body

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { BlockerClassUnstated, RecurringFailureMode, RungUnread }

data expected_type_not_supplied_to_a_fold_step_body: RecurringFailureMode = RecurringFailureMode {
  identity: "expected_type_not_supplied_to_a_fold_step_body" as NonEmptyStr,

  rung: RungUnread { cause: BlockerClassUnstated },

  receipts: [
    "INVALID STATE: the step lambda of a fold is typed without the fold call's own result type flowing in as the expected type of the step return. The fold's result type argument is, by the builtin's own signature, the expected type of the step's return value; supplying it would type the body's literals and calls against a known shape instead of synthesizing them bare. Decided, in review of gunbc#<F#>, 2026-11-12, to be a legitimate separate improvement (not a defect blocking the fold-accumulator work): synthesis without an expected type is legitimate and must keep working, so this is not the boundary for any current refusal - it is a missed derivation. Measured context: during the fold-accumulator inference work (gunbc#<F#>) the accumulator of an applied fold at the emitted v2 extdeps_uri_validation.rs from_attr site rendered `|acc: _,` while the fold call's result type was the fact that would have determined it.",
    "RUNG FOUND AT: above the floor, honest: with the expected type absent, the accumulator either stays an honest `_` (rustc infers) or is derived by the existing refinement routes; nothing is fabricated. CEILING: reachable now - the fold call site has the result type argument in hand when it types the step lambda. NEXT-RUNG TRIGGER, NAMING THE CAPABILITY: flow the fold call's expected/result type into step-body typing at the v1 fold-call typing site so literals in the step body receive an applied expected type, with a claim that goes red by asserting an emitted accumulator annotation (or a refusal) that bare synthesis does not produce. Needed for no current site; file the change when a consumer requires the annotation rather than rustc's fallback. Owner unassigned at filing.",
    "CLIMB RECEIPT: pending.",
  ],

  evidence: [
    decl_ref(module_path: "v1.compiler.infer", decl_name: "refine_fold_acc_from_step_return"),
  ],
}
