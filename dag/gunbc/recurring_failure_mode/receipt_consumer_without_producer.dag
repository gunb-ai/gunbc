module gunbc.recurring_failure_mode.receipt_consumer_without_producer

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data receipt_consumer_without_producer: RecurringFailureMode = RecurringFailureMode {
  identity: "receipt_consumer_without_producer" as NonEmptyStr,
  receipts: [
    "2026-10-09 srv1 workspace bringup, PR #13607: allocation offer admission and the controller require a gateway forwarding observation no older than 60 seconds, but workspace_refresh_gateway_wet had no production caller. The observer existed and its decoder was tested, while every real offer necessarily refused an absent or stale receipt. A bounded foreground operator command now calls the existing observer and protected publication repeatedly using the enrolled agent and host keys; no scheduler or private-key copy is introduced. Acceptance still requires the live forwarding receipt and authenticated guest SSH, not just the command returning success.",
    "PR #12421 review 5331195485: gunbc_ci_namecheap_observe_invoke supplied receipt_rel as though it captured execution output, but gunbc_invoke_receipt_steps only read an existing file. A successful observer therefore failed the shell step and suppressed its artifact upload. Invalid state: an emitted receipt read with no producer. Harm: successful observation becomes workflow failure. Discriminating facts: execute emitted shell in a clean root with only the declared output; a planted unmatched read must fail. Mitigation: writer, console display and uploader derive the path from one declaration. Ceiling: workflow construction rejects a receipt consumer without a producer edge; next trigger: that consumed workflow admission relation.",
  ],
  evidence: [],
