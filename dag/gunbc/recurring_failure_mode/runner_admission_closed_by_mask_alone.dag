module gunbc.recurring_failure_mode.runner_admission_closed_by_mask_alone

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { CeilingNotStated, RecurringFailureMode, RungUnread }

data runner_admission_closed_by_mask_alone: RecurringFailureMode = RecurringFailureMode {
  identity: "runner_admission_closed_by_mask_alone" as NonEmptyStr,

  rung: RungUnread { cause: CeilingNotStated },
  receipts: [
    "INVALID STATE: a runner host is called drained when its slot units are masked, while an already-running idle listener keeps polling GitHub and can be assigned a job at any instant. Masking inhibits only the successor of an exited unit.",
    "HARM: the template-level cap drop-ins re-apply to every running slot on daemon-reload, so a job assigned in the gap can be OOM-killed by the new cap; stopping the idle listener instead races the same assignment and cancels the job. One visibly cancelled, re-runnable job, only on a cap change.",
    "REPAIR: gunbc.runner.runner_host_cap_bracket closes admission first and judges idleness under that closure. Under the declared AdmissionMaskOnly closure a running idle listener refuses the host (AdmissionNotClosed, naming the units) and nothing is written. Under AdmissionMaskRosterAndNoWorker (gunbc.design_ruling runner_listener_admission_is_mask_roster_and_no_worker) an idle listener is admitted to the write and to its stop/start only when three readings agree: its unit is masked, the organization roster says its registration is busy=false, and its cgroup holds no Runner.Worker. All three are re-read immediately before the stop; a reading that is unread or disagreeing refuses AdmissionNotClosed with its cause and never restarts. There is no deregister: nothing re-registers a long-lived slot. CURRENT RUNG: mitigated, with the residual below typed.",
    "RESIDUAL (gunbc.design_ruling runner_listener_admission_is_mask_roster_and_no_worker): a job GitHub assigns to the still-registered idle listener after the last of the three readings and before the stop lands is not closed, only narrowed to the readings' own latency (gunbc.runner.runner_host_cap_bracket listener_restart_residual). RE-REGISTRATION IS A DECLARED FRONTIER (listener_reregistration_frontier). NEXT-RUNG TRIGGER: an upstream-documented atomic busy-refusing admission close or deregistration, at which point the restart can be gated on that close instead of on three readings.",

    "SPECIMEN, SAME SHAPE (mask alone does not exclude; a residual window between readings) (gunbc#15413, attempt-state move into the sealed store): the move's legacy-writer exclusion is OBSERVED, NOT ENFORCED. gunbc.roadmap.roadmap_dashboard_instance_apply dashboard_legacy_writer_drift reads is-active and is-enabled for the declared units (gunbc.roadmap.roadmap_dashboard_instance legacy_writer_fences) at entry, before every entry, before every flat-entry removal, after the last entry, at the DashboardAssertLegacyWriterExcluded activation gate, and on the MoveNoop route. A mask is a root-owned symlink to /dev/null, so lifting it and restarting the unit is a privileged out-of-band act that no gunbc route performs and none prevents. EXACT SEQUENCE: (1) boundary k observes the unit stopped and masked; (2) a privileged actor unmasks and restarts it between boundary k and boundary k+1; (3) the legacy writer mints a flat entry n1 in the old place; (4) a later boundary observes the writer live or unmasked and refuses, but the duplicate flat entry stands and the identity it minted may already be in use. NOT PROTECTED AGAINST: that duplicate identity can be irreversible. This is an UNRESOLVED ambient-authority risk, NOT fail-closed and NOT mechanically prevented: the model detects at observation points only, and a state arising and ending between two observations is unseen. Residual owner and owner of the next rung: the ambient-authority lane, no dependency (operator ruling relayed 2026-10-31). Inventory and deploy-route finding: the declared fence lists the units that can reach the identity mint; no modeled deploy route unmasks or restarts them (the srv1-lab units are hand-installed; deployment_spec_for has no production caller); belt.service's starter is recorded as unknown. EXECUTING EVIDENCE (detection only): test.claim.roadmap.attempt_state_move_apply_wet_witness the_exclusion_lifted_mid_cutover_stops_the_line_before_any_flat_entry_is_removed, a_noop_move_with_a_live_or_unmasked_writer_is_refused_and_with_an_excluded_one_proceeds, the_activation_gate_refuses_a_running_writer.",
  ],
  evidence: [],
}
