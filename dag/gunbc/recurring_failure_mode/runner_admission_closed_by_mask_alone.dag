module gunbc.recurring_failure_mode.runner_admission_closed_by_mask_alone

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data runner_admission_closed_by_mask_alone: RecurringFailureMode = RecurringFailureMode {
  identity: "runner_admission_closed_by_mask_alone" as NonEmptyStr,
  receipts: [
    "INVALID STATE: a runner host is called drained when its slot units are masked, while an already-running idle listener keeps polling GitHub and can be assigned a job at any instant. Masking inhibits only the successor of an exited unit.",
    "HARM: the template-level cap drop-ins re-apply to every running slot on daemon-reload, so a job assigned in the gap can be OOM-killed by the new cap; stopping the idle listener instead races the same assignment and cancels the job. One visibly cancelled, re-runnable job, only on a cap change.",
    "REPAIR: gunbc.runner.runner_host_cap_bracket closes admission first and judges idleness under that closure; under the declared AdmissionMaskOnly closure a running idle listener refuses the host (AdmissionNotClosed, naming the units) and nothing is written. CURRENT RUNG: mitigated by typed refusal, never actuating on a mask-only closure.",
    "RESIDUAL (operator ruling, option A): the closing leg is the GitHub REST read of busy then deregister; the window between the busy read and the deregistration is a typed residual, because the docs for the delete-runner endpoint state no busy refusal and no in-flight fate. NEXT-RUNG TRIGGER: an upstream-documented atomic busy-refusing deregistration, or an upstream-documented admission close.",
  ],
  evidence: [],
}
