module gunbc.recurring_failure_mode.nat_infix_subtraction_below_zero_yields_a_negative_nat

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { RecurringFailureMode }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data nat_infix_subtraction_below_zero_yields_a_negative_nat: RecurringFailureMode = RecurringFailureMode {
  identity: "nat_infix_subtraction_below_zero_yields_a_negative_nat" as NonEmptyStr,

  receipts: [
    "INVALID STATE: a value typed std.nat Nat that is negative. The infix `-` on two Nat operands is admitted by the type checker and realized as the kernel integer's subtraction on both routes: the interpreter's checked Int subtraction and the emitted v1_rt::int_sub. Both refuse only i64 overflow, so `2 - 3` at Nat yields -1 typed Nat. The refusing form exists -- std.nat nat_sub returns NatSubtraction and answers NatSubtrahendExceedsMinuend -- but nothing routes the operator to it.",

    "HARM: silent wrongness (DESIGN section 5), outside the section 4b ladder: a Nat that is not a natural flows into every consumer that relies on Nat being non-negative (counts, sizes, durations), and both routes agree, so no interpreted-equals-emitted control can expose it. PRE-EXISTING ON MAIN: before the Nat de-fork (gunbc#12846) Nat was an alias over the kernel integer and realized the same way; the de-fork neither introduced nor repaired it, and recorded it while repairing the sibling class gunbc.recurring_failure_mode a_representation_change_drops_the_types_realization_checkpoint.",

    "RUNG, STATED AT WHAT EXECUTES TODAY: none -- the class is silently wrong on main and on the de-fork head; no gate, witness or refusal covers it.",

    "NEXT TRIGGER, as a capability: the infix `-` over std.nat Nat operands realized as the refusing natural subtraction on BOTH routes -- elaborated in the one realization fold (v1.compiler.infer ground_kernel_views), which already rewrites Nat constructors and matches for the emitter and the interpreter alike -- or refused at typecheck where the author must name nat_sub; with a discriminating red (Nat `2 - 3` refuses on both routes) and a positive control (`3 - 2` is 1). Owned by the follow-up work item opened from gunbc#12846.",

    "CEILING: structurally guaranteed. Whether an operator's result inhabits Nat is decidable from the operator and the declared operand types, so an Accepted program need contain no unrefused Nat subtraction."
  ],

  evidence: [
    DeclarationRef { module_path: "std.nat", decl_name: "nat_sub", field: WholeDeclaration },
  ],
}
