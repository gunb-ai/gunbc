module gunbc.recurring_failure_mode.record_versus_block_at_a_brace_is_decided_by_lookahead

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data record_versus_block_at_a_brace_is_decided_by_lookahead: RecurringFailureMode = RecurringFailureMode {
  identity: "record_versus_block_at_a_brace_is_decided_by_lookahead" as NonEmptyStr,

  receipts: [
    "**After a lowercase identifier, a brace is a record initializer or a block, and the grammar decides it by speculative parse, not by position** (`match x { none => .. }` probes `x { none` as a record; `if b { x } else` is cut by dag_grammar_block_of_one_name_before_else_expr; `loop b { x }` reads as the record `b { x }`). Consequence measured 2026-10-21 on gunbc#14595: a guard at the pun position that refuses a reserved word whatever follows it refused 521 corpus modules (parse_keyword_as_value_name), attributed (inferred, not isolated) to the probe reaching blocks that open with a statement keyword; a guard keyed on the next token is defeated by an omitted comma (`R { none x }`). The pun refusal therefore lives in body lowering, keyed on the parsed pun field (body_lower_field_init_pun_edge), with the parse admitting the pun.",
    "RUNG: mechanically preventable for the none pun (an executed lowering refusal, located at the name). The ambiguity itself is below that: a lowercase head followed by a one-name block not before else parses as a record, as `b { x }` does. CEILING: structurally guaranteed once the record/block decision is a position fact (a discriminator at the lbrace, which v2's grammar cannot read from the head's case today, v1 uses an uppercase head). NEXT TRIGGER: the capability, a record-versus-block discriminator at the brace that does not need an arm-by-arm cut; owned by the lex/parse lane (nimble-otter-791). Cost shape to preserve: any new cut is over the arm HEAD (pattern and =>), never the whole arm, or each match nesting level re-parses the bodies below it.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.test.claim.compiler.optional_native_controls", decl_name: "onc_none_pun_omitted_comma_refuses_in_lowering", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.parse.keyword_value_name_parse", decl_name: "kvn_keyword_block_after_ident_control_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.compiler.body_lowering_fold", decl_name: "body_lower_field_init_pun_edge", field: WholeDeclaration },
  ],
}
