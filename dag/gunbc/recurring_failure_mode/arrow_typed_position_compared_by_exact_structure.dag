module gunbc.recurring_failure_mode.arrow_typed_position_compared_by_exact_structure

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { CeilingNotStated, RecurringFailureMode, RungUnread }

data arrow_typed_position_compared_by_exact_structure: RecurringFailureMode = RecurringFailureMode {
  identity: "arrow_typed_position_compared_by_exact_structure" as NonEmptyStr,
  rung: RungUnread { cause: CeilingNotStated },

  receipts: [
    "INVALID STATE: a callable at an Arrow-typed declared position (a record field typed `fn(Int) -> Bool`, a higher-order formal) is compared with the position's declared type by exact node structure. An Arrow's domain members carry authored binder names, so a named fn whose parameter is `n` does not structurally equal a declared `fn(x: Int) -> Bool` though both have the signature Int -> Bool. HARM: a false definitive refusal, `record_field_value_does_not_inhabit` or `application_argument_does_not_inhabit`, of a well-typed program.",
    "FOUND AT: a false definitive refusal on the data-constant route, then WIDENED to fn bodies when fn_body_record_construct_unjudged_on_native_route was fixed (the construct row began judging fn-body constructs and met the same comparison). Executed: infer_optional_at_required_witness oar_arrow_named_ok / named_x / nullary / arg_ok were red without the arm and pass with it.",
    "CURRENT PER PATH (gunbc#13735): v2.std.inhabitance declared_type_inhabitance has an Arrow arm; a readable first-order non-generic signature is compared by domain types positionally and the return, ignoring binder names, and is DECIDED. Generic (type-params edge), unreadable-order and nested-Arrow signatures stay on the exact comparison and MAY STILL REFUSE when binders differ, never accepted as undecidable (that would be a silent widen, review 78749). A lambda value at an Arrow position is not this class: it stays at the counted frontier of lambda_value_has_no_derived_type_in_v2_infer. RUNG FOUND AT: below the floor for the false refusal's victims (a correct program unwritable). RUNG NOW, PER PATH (DESIGN section 4b(1)): structurally guaranteed for the readable first-order arm; mitigatable on the generic, unreadable-order and nested-Arrow paths (a loud, located refusal that may be false). CLASS RUNG: mitigatable, the minimum across its in-scope paths.",
    "NEXT-RUNG TRIGGER, NAMING THE CAPABILITY: v2.std.inhabitance normalizes nested and generic Arrow signatures recursively (binder-name-insensitive, with a generic Arrow's type parameters matched by position), SUFFICIENT FOR every readable Arrow-at-Arrow obligation to be decided by structure rather than by exact node comparison.",
  ],
  evidence: [
    DeclarationRef { module_path: "v2.std.inhabitance", decl_name: "declared_type_inhabitance_arrow", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.std.inhabitance", decl_name: "declared_type_inhabitance_exact", field: WholeDeclaration },
  ],
}
