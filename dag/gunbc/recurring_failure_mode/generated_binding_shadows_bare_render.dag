module gunbc.recurring_failure_mode.generated_binding_shadows_bare_render

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data generated_binding_shadows_bare_render: RecurringFailureMode = RecurringFailureMode {
  identity: "generated_binding_shadows_bare_render" as NonEmptyStr,

  receipts: [
    "generated binding shadows a bare render (an emitter that renders a name by SPELLING while a different generator in the same emission adds a binding for that spelling — a use line, an alias, a prelude — composes into a silent rebinding: each generator is locally correct and the artifact realizes the wrong declaration, with the diagnostic landing at the CONSUMER of the emitted file, far from either producer. ",

    "SPECIMEN (XL-0T, PR #9720): modules carrying kernel-String data rows plus transitively referenced structural v2.std.text signatures got a generated v2_std_text String use line; the six type renderers' is_host_text_carrier_type short-circuit rendered those kernel rows as the bare spelling String, which the use line then bound to the structural carrier — 160 E0308 rows in one closure, none of them at a line either generator wrote. ",

    "FIX SHAPE, and the reason this is a class rather than a bug: render by DECLARATION IDENTITY, and give the non-local realization the GROUNDING spelling no local binding can shadow (std::string::String), keeping the bare reference spelling only for the declaration the module's own binding names — the same two-spelling split std.coercion TypeCheckpoint already carries as reference_base vs grounding_base. ",

    "RECOGNITION RULE: whenever one generator emits a binding for a spelling and any other render site emits that spelling bare, ask which declaration each intends; if they can differ, the bare render needs the grounding spelling or the identity key, because 'correct at every generator' does not compose to 'correct in the artifact'.)",
  ],

  evidence: [],
}
