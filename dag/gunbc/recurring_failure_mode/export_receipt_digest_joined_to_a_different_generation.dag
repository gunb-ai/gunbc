module gunbc.recurring_failure_mode.export_receipt_digest_joined_to_a_different_generation

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data export_receipt_digest_joined_to_a_different_generation: RecurringFailureMode = RecurringFailureMode {
  identity: "export_receipt_digest_joined_to_a_different_generation" as NonEmptyStr,

  receipts: [
    "INVALID STATE: a custody export receipt names a Secret Manager version identity from the fetch that placed the file, and a sha256 digest taken from a later, unrelated reread of the same path. HARM: the snapshot take treats the pair as proof of WHICH generation it copied, and a matching digest then certifies the wrong generation. DISTINGUISHING FACTS: the digest must be of the same resolved material whose placement was established; publication is owed only after custody_run_settled of that placement, and a failed or interrupted publication must not report a successful export. RECOGNITION RULE: if a receipt's sm_version and its digest can be assembled from two observations, the join is fabricated. RUNG FOUND AT: design review; never observed. WRITER STANDING: plan_host_custody_export takes sm_version and placed_material as two parameters; they agree because its one caller (converge_host_credential_custody) passes one fetch's version and payload. That is mitigated by code shape at one call site, not construction. CEILING: a sealed fetch result carrying both, consumed whole by the plan, so no caller can pair a version with another production's payload. NEXT-RUNG TRIGGER: that sealed carrier lands, or the reader requires the receipt.",
  ],

  evidence: [
    DeclarationRef { module_path: "gunbc.fleet.host_credential_custody_converge", decl_name: "plan_host_custody_export", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.host_custody_export_receipt_witness", decl_name: "a_run_that_is_not_settled_publishes_nothing", field: WholeDeclaration },
  ],
}
