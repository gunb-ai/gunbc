module gunbc.recurring_failure_mode.a_required_launch_capability_the_model_cannot_name_is_decided_by_the_engine_build

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { RecurringFailureMode, BelowCeiling, FoundBelowTheLadder, FoundOnRung, RungRead }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.rung_climb { ClimbableButUnbuilt }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data a_required_launch_capability_the_model_cannot_name_is_decided_by_the_engine_build: RecurringFailureMode = RecurringFailureMode {
  // THE MODEL HAD NO FIELD FOR THE CHOICE, SO THE ENGINE'S BUILD MADE IT, AND THE HOST ANSWERED CORRECTLY
  // THE WHOLE TIME. A flag a launch does not carry is not an unstated opinion -- it is the upstream binary's
  // default stating a policy nobody authored. When the flag row has no field for that flag at all, the
  // omission is not even a value a reviewer could question: it is unrepresentable, so it cannot be refused,
  // cannot be diffed, and cannot be distinguished from a launch that considered it and declined.

  identity: "a_required_launch_capability_the_model_cannot_name_is_decided_by_the_engine_build" as NonEmptyStr,

  rung: RungRead {
    found_at: FoundBelowTheLadder,
    standing: BelowCeiling {
      current: FoundOnRung { rung: Mitigatable },
      ceiling: StructurallyGuaranteed,
      blocker: ClimbableButUnbuilt,
      trigger_capability: "the row that states a serving launch reads back the argv it rendered -- the running unit's ExecStart, or the budget the engine itself reports at /metrics (conversation_cache_mib) as a typed observation -- and the agreement is judged against THAT reading rather than against the flag row, so the model cannot vouch for a parked-conversation cache the engine does not have. The rung below this one is already built, and it is stated at the rung it holds: extdeps.strata.serve_flags::StrataLaunchParameters carries the cache policy as a field EVERY launch row must state -- conversation_cache: Optional<StrataConversationCache> -- where the three arms of extdeps.strata.serve_flags::StrataConversationCache are what a READ argv says (a budget with its slot count / an explicit off with its reason / the argv READ and carrying neither word), and absent() is this repository's own claim that the argv has not been read, an absence carrier rather than an arm of the upstream's flag type (gunbc.design_argument::external_upstreams). What that type establishes is only this much: no launch row speaks about parked conversations without naming which of those four states it is. It does NOT establish that a row cannot be written with no policy -- absent() and the Unset arm are both writable -- and claiming otherwise would be the rung inflation gunbc.design_argument::guarantee_ladder refuses -- the reported rung equals the rung established by executed evidence, and a type name establishes nothing. The refusal is therefore made where the record is judged: gunbc.serving.serving_replica_profile::strata_launch_parking_agreement reads the LAUNCH RECORD that gunbc.serving.serving_replica_profile::replica_engine_launch derives -- the parameters the row carries plus the live slot count the deployment's capacity shape admits, from one authority rather than two flag structs (the neighbouring class gunbc.recurring_failure_mode::engine_slots_written_beside_the_admission_that_bounds_them) -- and REFUSES a launch that names no policy (ParkedConversationsLeftToTheBuild), ASKS for the read where the argv was never read (ParkingNeedsReading { cause: LaunchNeverRead }), and reports a LOCATED SHORTFALL where it names a capacity too small to cover what the layout's ServingRetentionGrant holds warm beyond the engine's live slots. WHAT THAT RUNG DOES NOT CLOSE, stated because the alternative is the rung inflation gunbc.design_argument::guarantee_ladder names: the verdict has ONE consumer in this checkout, the claim route test.claim.serving.strata_conversation_cache_parking_witness. No serving path in this repository renders a Strata argv -- the fleet's engines start from systemd units on the hosts, and the only Strata command line the model renders is the benchmark container's (gunbc.instruments.serving_benchmark_run) -- so today the agreement CLASSIFIES and LOCATES the failure rather than preventing a start. The reading above is what turns the verdict into a launch that cannot happen; until it lands, this row's tell is a fleet that still discovers the failure by walking onto a host"
    }
  },

  receipts: [
    "INVALID STATE: a capability a consumer REQUIRES is configured by a flag whose row the model does not carry; the launch omits it; the upstream build's default chooses the policy; the service starts, answers correctly, and is never once wrong in a way a judgement can see. The state is not invalid in any schema -- it is a policy with no author.",

    "FOUND: 2026-11-24, on h11 (H11SSL, 2x R9700, Strata 0.1.38 HIP build), engines h11-strata@83 and h11-strata@c3 from ~/strata-pool/cfg-83.json and cfg-c3.json. Neither config carried --conversation-cache-mib or --conversation-cache-slots, and on that build the default is off: each engine kept the KV of only its LIVE conversation, so every other conversation re-read its whole prompt cold. The operator added `--conversation-cache-mib 8192 --conversation-cache-slots 4` to both by hand (restarted 21:35 / 21:39 UTC). STANDING OF THE FIGURES: read ad hoc by the operator's session 21:40-21:55 UTC, not by an instrument of this repository, and carried here as an observation -- prompt-cache warm went 0% -> 98.4% on h11-83 and 0% -> 94.0% on h11-03/c3, with 96-99% of each prompt reused while each engine alternated between two conversations. The claim this row needs from them is only that the two states differ enormously and that the difference was invisible from inside the model.",

    "WHY THE MODEL COULD NOT HAVE CAUGHT IT -- the boundary. Re-derived from the authority that should have produced the config: (1) extdeps.strata.serve_flags::StrataServeFlags carried nine flags and NO field for the conversation-cache pair. An omission of a field that does not exist is not a value, so no type error, no refusal and no diff could point at it. (The row that carries those flags today is extdeps.strata.serve_flags::StrataLaunchParameters, split from StrataServeFlags by a neighbouring class so the admitted concurrency has one authority; the cache pair is the tenth parameter, required, and the pair's absence is a policy with four named states rather than no state.) (2) The parked capacity the host was relying on lived elsewhere: gunbc.serving.serving_host_memory::host_6ce85c_engine_as_launched states conversation_cache 8192 MiB in 6 slots for EVERY bus -- with the provenance naming ONE config file, ~/strata-pool/cfg-87.json, and the 2026-10-27 script that set it -- generalized to buses that were never read, including the two that actually ran. So the model held a cache figure for engines that had no cache, and held no flag row for the thing the config omitted. (3) Nothing joined the two: the grant (gunbc.serving.serving_capacity_anchor::ServingRetentionGrant) says how many conversations a replica holds warm, the memory row says how many could be parked, the flag row says nothing, and no consumer asked whether the three agree. EARLIEST UNJUSTIFIED BOUNDARY: (1). Repairing (2) or (3) alone would leave a launch row able to omit the pair while a reader looked elsewhere for its answer.",

    "WHY IT IS SILENT, and why below the ladder. A cold prompt re-read is a LEGAL answer: correct output, well-formed, merely late and expensive. There is no refusal to stand on and no invalid value to reject; the only trace is a hit ratio no instrument of this repository reads. What made it findable at all was an operator walking onto the host and reading counters. This is the rung-below-the-ladder shape gunbc.design_argument::epistemic_humility names for measurements -- the run was successful at every point where success is judged.",

    "THE FAIL-OPEN DEFAULT, in the upstream's own words. extdeps' model of Strata (extdeps.strata.serve_flags, from the upstream docs at the pinned commit) records that `--conversation-cache-mib N --conversation-cache-slots K` is opt-in and that the docs' own way to park nothing is `--conversation-cache-mib 0` -- an explicit word for off exists, which is why this model renders an explicit off rather than omitting the pair (gunbc.design_argument::declared_intent: a default that silently chooses a policy is a policy nobody expressed). The same docs record that from 0.2.3 (#3493) an absent budget is AUTO-SIZED from free RAM rather than off; h11's 0.1.38 predates that, and this repository has not read 0.1.38's release notes, so the model carries the pre-0.2.3 reading as a standing with an open read obligation (extdeps.strata.serve_flags::strata_conversation_cache_unset_standing_pre_0_2_3) rather than as a deduced default. A single upstream release changed what an omission MEANS: an omission is not a stable place to put a policy.",

    "WHERE THE TREE ALREADY HALF-HAD THIS: gunbc.serving.serving_host_memory::engine_warm_sessions already bounds the conversations one engine can keep warm by its cache bytes and its slots, and gunbc.serving.serving_capacity_anchor::ServingRetentionGrant already states what a replica is admitted to hold warm. Neither could see the omission, because both read the memory row and neither read the launch. The gap was the join, and the field that would have made the join readable did not exist.",

    "THE SHAPE, NOT THE CASE: any flag that turns a capability on or off, whose upstream default is the OFF state, and whose row the model does not carry. Every engine row in this fleet is a candidate -- the flag rows this class touched are Strata's; the same shape sits on any launcher whose flags are described in prose or in a memory row instead of typed. It does NOT apply where the default is the ON state, nor to a flag whose absence is genuinely no opinion; the test is whether the build decides something a consumer depends on.",

    "THE NEARBY ROWS THAT ARE NOT THIS ROW: gunbc.recurring_failure_mode::a_capacity_default_sized_for_one_workload_shape_inherited_by_another is a capacity that IS stated, sized for a workload that changed under it -- there the number is right and exceeded; here the number was never the launch's at all, and the row carrying it was read off a different bus. gunbc.recurring_failure_mode::a_host_absent_from_a_converge_roster_silently_keeps_the_upstream_default is the same silence on the other side of the producer: a host missing from a desired-rows roster keeps the OS default, where the roster is the missing row; here the roster is complete and the FIELD is missing. gunbc.recurring_failure_mode::absent_reads_identically_to_never_looked is the reading of an absence; this row is the case where the absence is a policy.",

    "RECOGNITION RULE: for every flag an upstream binary documents as gating a capability a consumer depends on, ask which of the two the model holds -- a typed field on the launch row, or a figure read somewhere else about the host. If only the second, the first is a fail-open default with no owner, and the fix is the field, not a check on the figure. AND WHERE A CAPACITY IS NAMED, ask whether it REACHES what the grant holds beyond the engine's live slots: an undersized cache is this same failure with a number in it, and quieter still, because a row now states a figure and reads as covered.",

    "CEILING AND ITS TELL: StructurallyGuaranteed, because a launch row whose agreement is judged against the argv the running unit actually carries (or the budget the engine itself reports) cannot vouch for a capability the engine lacks -- the disagreement becomes the finding. The tell that the ceiling has NOT been reached: a launch row's agreement still rests on a memory row read on another bus, another date, or another host -- as h11's did here -- and the fleet discovers the disagreement by walking onto the machine.",

    "WHAT THIS ROW'S OWN PR REMOVED, AND WHAT IT LEFT: the agreement now refuses to AGREE on a row it did not read. A launch whose argv was read and carries neither flag is `left to the build` even when a memory row states a capacity that would cover the grant, and a launch whose argv was never read gets an ask that CARRIES that capacity as evidence and says which read settles it (`gunbc.serving.serving_replica_profile::strata_launch_parking_agreement`, with `gunbc.serving.serving_replica_profile::strata_parking_read_obligation` composing the two upstream standings with this repository's own receipt of what its hosts run, and `gunbc.serving.serving_replica_profile::strata_parking_agreement_sentence` the single place a verdict is turned into a sentence -- every figure it names comes off a field of the verdict, which is what keeps a consumer from having to parse English to act (gunbc.design_argument::source_annotations)). That closes the false agreement; it does not raise the rung, because the verdict still has the single consumer named above -- a claim route, not a launcher. The rung moves when a launch row is judged against the `ExecStart` its unit actually carries, or the budget the engine itself reports; the first call that rung makes is `extdeps.strata.serve_flags::strata_conversation_cache_mebibytes_from_int`, the only checked route from a READ MiB figure to a budget -- a read of `0` lands on the Off arm naming what it observed, never on a budget of nothing the engine obeys by parking no one. Until that rung exists the route's only caller is the claim route, and this row is where that is recorded rather than left to be rediscovered.",
  ],

  evidence: [
    DeclarationRef { module_path: "extdeps.strata.serve_flags", decl_name: "StrataConversationCache", field: WholeDeclaration },
    DeclarationRef { module_path: "extdeps.strata.serve_flags", decl_name: "strata_conversation_cache_words", field: WholeDeclaration },
    DeclarationRef { module_path: "extdeps.strata.serve_flags", decl_name: "strata_conversation_cache_unset_standing_pre_0_2_3", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.serving.serving_replica_profile", decl_name: "strata_launch_parking_agreement", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.serving.serving_host_memory", decl_name: "host_6ce85c_engine_as_launched", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.serving.strata_conversation_cache_parking_witness", decl_name: "witness_a_launch_that_names_nothing_is_refused", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.serving.strata_conversation_cache_parking_witness", decl_name: "witness_the_operator_named_budget_is_accepted", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.serving.strata_conversation_cache_parking_witness", decl_name: "witness_a_budget_smaller_than_the_grant_needs_is_a_located_shortfall", field: WholeDeclaration },
    DeclarationRef { module_path: "extdeps.strata.serve_flags", decl_name: "strata_parallel_minimum_slots", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.serving.serving_replica_profile", decl_name: "strata_parking_read_obligation", field: WholeDeclaration },
    // The fleet observation lives with the consumer, not in the upstream module
    // (gunbc.design_argument::external_upstreams): the host, the deployed build and the operator's ad-hoc read
    // are this repository's receipt, and the flag coproduct carries only what Strata documents.
    DeclarationRef { module_path: "gunbc.serving.serving_replica_profile", decl_name: "StrataDeployedBuildObservation", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.serving.serving_replica_profile", decl_name: "strata_deployed_build_precedes_the_auto_size", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.serving.serving_replica_profile", decl_name: "parking_ask_agreement", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.serving.serving_replica_profile", decl_name: "replica_engine_launch", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.serving.serving_replica_profile", decl_name: "parking_judgement_for_launch", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.serving.strata_conversation_cache_parking_witness", decl_name: "witness_a_read_row_does_not_answer_a_launch_that_names_nothing", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.serving.strata_conversation_cache_parking_witness", decl_name: "witness_read_silence_and_an_unread_argv_are_different_facts", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.serving.strata_conversation_cache_parking_witness", decl_name: "witness_the_live_slot_count_is_read_from_the_launch_record_and_not_from_a_second_flags_struct", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.serving.strata_conversation_cache_parking_witness", decl_name: "witness_a_launch_that_admits_no_turn_is_located_rather_than_agreed", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.serving.strata_conversation_cache_parking_witness", decl_name: "witness_a_zero_mebibyte_budget_has_no_constructor", field: WholeDeclaration },
    // THE DECLARED FRONTIER, CARRIED AS A REF SO IT IS CHECKED AND NOT MERELY ASSERTED: the checked read
    // route exists today only on the claim route, and the next rung named below is what calls it in
    // production -- a read of `0` has to land on the Off arm naming what it observed, never on a budget of
    // nothing, so no row may build a budget by hand past this route.
    DeclarationRef { module_path: "extdeps.strata.serve_flags", decl_name: "strata_conversation_cache_mebibytes_from_int", field: WholeDeclaration },
    DeclarationRef { module_path: "extdeps.strata.serve_flags", decl_name: "StrataConversationCacheMebibytesBuild", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.serving.serving_replica_profile", decl_name: "strata_parking_agreement_sentence", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.serving.serving_replica_profile", decl_name: "ParkingNeedsReadingCause", field: WholeDeclaration },
    DeclarationRef { module_path: "test.claim.serving.strata_conversation_cache_parking_witness", decl_name: "witness_the_read_obligation_follows_the_standings_it_is_given", field: WholeDeclaration },
  ]
}
