module gunbc.recurring_failure_mode.capacity_lent_at_runtime_is_lost_on_borrower_death

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.recurring_failure_mode { BlockerClassUnstated, RecurringFailureMode, RungUnread }

data capacity_lent_at_runtime_is_lost_on_borrower_death: RecurringFailureMode = RecurringFailureMode {
  identity: "capacity_lent_at_runtime_is_lost_on_borrower_death" as NonEmptyStr,

  rung: RungUnread { cause: BlockerClassUnstated },

  receipts: [
    "INVALID STATE: a host-wide server lends capacity at runtime (the ctrl-jobserver GNU make FIFO, /var/lib/ctrl/jobserver/host.fifo) and the borrower returns it cooperatively; a borrower SIGKILLed mid-compile returns nothing and no owner reclaims it, so the pool shrinks for the daemon's lifetime while the host still accepts work.",

    "HARM, measured 2026-10-14: free tokens srv3 25/120, srv4 56/120, srv1 91/128, with builds throttled while about 88% of the CPU sat idle. It is a slow queue, never a failure, which is why it was carried as a declared containment (cancel-in-progress disabled) rather than seen.",

    "DISTINGUISHING FACTS: capacity is lost, not over-used; the loss is proportional to cancellations, not load; restarting the daemon restores it. The tell is a runtime lender with no reaper standing where an up-front allocation was available.",

    "RUNG FOUND AT: mitigatable (gunbc.compile_permit_scope fleet_compile_cancellation_standing keeps cancellation off). CEILING: structurally impossible -- allocation is declared in the model up front (operator ruling 2026-10-14) as each runner slot's CPUQuota with CARGO_BUILD_JOBS bound to it (gunbc.ci.ci_runner_placement host_cpu_allocation), so nothing is lent and nothing can leak. A1 (this change) makes that the rendered and converged realization and retires the daemon from hosts through gunbc.runner.runner_host_file_converge with an absence readback.",

    "NEXT TRIGGER, DISCHARGED BY A2: srv3 and srv4 observed reading InvocationLocalCargo; A2 deleted the BorrowerHeldCooperativeHostFifo constructor, its unit rendering, extdeps.jobserver and the jobserver-sized compile pool, so the lent state has no constructor (structurally impossible). The discriminating REDs stay enrolled: a unit carrying MAKEFLAGS, CTRL_JOBSERVER_FIFO or ordering on ctrl-jobserver.service reads as unreadable, never safe (gunbc.compile_permit_scope_observe realization_from_unit_text), and the host converge refuses MAKEFLAGS in the runner environment and reads the retired daemon residue absent.",
  ],

  evidence: [
    decl_ref(module_path: "gunbc.ci.ci_runner_placement", decl_name: "host_cpu_allocation"),
    decl_ref(module_path: "gunbc.runner.runner_host_file_converge", decl_name: "ctrl_jobserver_retired_residue"),
    decl_ref(module_path: "gunbc.compile_permit_scope_observe", decl_name: "realization_from_unit_text"),
  ],
}
