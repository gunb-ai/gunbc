module gunbc.recurring_failure_mode.as_cast_has_no_lowered_form

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data as_cast_has_no_lowered_form: RecurringFailureMode = RecurringFailureMode {
  identity: "as_cast_has_no_lowered_form" as NonEmptyStr,

  receipts: [
    "no lowered form for an `as` cast `e as T` in v2 body lowering: `as` is not an operator of the precedence tower `v2.compiler.body_lowering_fold` `body_lower_read_operator_expression` reads, and no other reader lowers the cast. As an operator operand -- usually parenthesised, `(e as T) == ..` -- it refuses as `body_lowering_reason_operator_operand_unread`; on the value route the target type `T` does not reach the reference-site collector.",
    "SPECIMENS AND PINNED LOCUS: `dag/test/claim/extdeps/apt_package_of_witness_test.dag` `apt_installed_bin_path_is_apt_bin_dir_plus_the_binary_name` (`(apt_installed_bin_path(..) as String) == ..`), `dag/gunbc/host/host_resource.dag` (`(left.host as T)`), `dag/test/claim/data_reference_kind_from_resolved_node_witness_test.dag` (`(gigabyte.legal_name as T)`); each refuses at the parenthesised operand. A parenthesised CALL operand without a cast is read (control: `a_parenthesised_call_operand_resolves`), so the group is not the cause.",
    "EXPOSED, NOT INTRODUCED: the parent of gunbc#12145 (2de78893dfe) accepted this shape only by SILENT NARROWING -- the operand reader answered a sequence with its left element -- so the refusal on main after gunbc#12173 is a pre-existing defect made visible, not a new regression. Found by the XL-2 three-baseline identity census on gunbc#12194 (321 paths: 18 refusing at 2de78893dfe, 167 at ada85b9452, 101 after gunbc#12173).",
    "RUNG FOUND AT: mitigated on the operator route; below the floor on the value route (the cast's type was dropped, so `x as Q` was Accepted with `Q` declared nowhere). CEILING: structurally guaranteed -- a cast lowers to a value carrying its operand and its target type, or refuses.",
    "RUNG NOW: mitigated on EVERY route. `v2.compiler.body_lowering_fold` `body_lower_postfix_expr` refuses a postfix chain carrying an as-suffix with `body_lowering_reason_type_annotation_not_carried` located at the authored target type -- the one reason for a type the lowering cannot carry, shared with the let annotation -- and `body_lower_arm_operand_resolved_optional` declines a cast so a let value or an arm reaches that refusal instead of answering the operand. A declared target refuses too: nothing is carried, so nothing is accepted. As an operator operand the cast now refuses with the same reason, because the postfix is folded before the operator reader sees it. CENSUS: the v2-route identity census over the 321-path population (`v2.compiler.reference_conservation_census` `reference_conservation_stratified_sample_paths` plus six) run before and after on srv1; see the PR.",
    "NEXT-RUNG TRIGGER, NAMING THE CAPABILITY: a TYPED CAST NODE -- `e as T` lowers to Transform[coerce, e] with `v2.std.type_binder` `<cast-target>` -> T beside its positional children, and that node is SUFFICIENT FOR: resolve binding T in type role through the shared type-role frame (an undeclared T refusing at T); infer admitting the crossing through `v2.std.coercion` (not `std.coercion` `dag_cast_rules`, which is v1's side of `coercion_two_algebras_answer_one_question_stall`) or refusing typed; and translate and eval realizing it or refusing typed -- on every route, for every cast the refusal now stops. It needs a `CanonicalOperation` for coercion in `v2.std.compilers.target_model` with its dag canonicalization of `as` and per-target realization rows; the node shape rule (`v2.std.node` PositionalPlusOneNamedEdges) lands with the let-annotation carrier.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.test.claim.body_cast_target_refusal", decl_name: "bctr_tail_cast_refuses_at_q", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.body_cast_target_refusal", decl_name: "bctr_let_value_cast_refuses_at_q", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.body_cast_target_refusal", decl_name: "bctr_call_argument_cast_refuses_at_q", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.body_cast_target_refusal", decl_name: "bctr_if_arm_cast_refuses_at_q", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.body_cast_target_refusal", decl_name: "bctr_match_arm_cast_refuses_at_q", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.body_cast_target_refusal", decl_name: "bctr_uncast_accepts", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.call_argument_value_resolve_refusal", decl_name: "an_as_cast_operand_refuses_at_normalize", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.call_argument_value_resolve_refusal", decl_name: "a_parenthesised_call_operand_resolves", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.call_argument_value_resolve_refusal", decl_name: "an_undeclared_name_in_a_parenthesised_call_operand_refuses_at_resolve_at_its_atom", field: WholeDeclaration },
  ],
}
