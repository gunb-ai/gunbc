module gunbc.recurring_failure_mode.cyclic_alias_head_is_accepted

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { BelowCeiling, FoundBelowTheLadder, FoundOnRung, RecurringFailureMode, RungRead }
import gunbc.guarantee_rung { MechanicallyPreventable, StructurallyGuaranteed }
import gunbc.rung_climb { ClimbableButUnbuilt }

data cyclic_alias_head_is_accepted: RecurringFailureMode = RecurringFailureMode {
  identity: "cyclic_alias_head_is_accepted" as NonEmptyStr,
  rung: RungRead {
    found_at: FoundBelowTheLadder,
    standing: BelowCeiling { current: FoundOnRung { rung: MechanicallyPreventable }, ceiling: StructurallyGuaranteed, blocker: ClimbableButUnbuilt, trigger_capability: "the capability of judging a transparent alias cycle on every in-scope path by ONE rule: the v1 declaration refusal and the v2 carrier reader carrier_chain_cycles share one cycle rule, and the refusal witness is a row of the required emitted-subject gate, so the discriminating RED is executed on the acceptance path rather than by a local claim run." },
  },

  receipts: [
    "INVALID STATE AND HARM: a transparent alias-head chain returns to a declaration already on its path, yet source using that chain is accepted. The compiler has not established a finite declared head for the position it admits. This is the names-resolve and values-inhabit-declared-types floor, not a claim about productive recursive product types.",
    "REF-BOUND MEASUREMENT: release seed from 03a3b91fb4c1ea7e408df2cb484f475d75080a7f, executable SHA256 8692902cd6540b0cd1bd5f73701c6a3910bb3c87a73110f8125b0c00cdbfa02b, invocation https://app.buildbuddy.io/invocation/5b341ce2-2377-471f-a1ac-47128df431e8. Isolated repository-local source declares type Left = Right; type Right = Left; fn take(q: Left) -> Int { 1 }; fn probe(q: Right) -> Int { take(q: q) }. It terminates, resolves one source, emits six files and reports zero diagnostics.",
    "PAIRED ROUTING PROBE: with type Marker and type Record<P> { n: Int }, take(q: Record<Marker>) and probe(q: Left), the Left/Right head cycle also accepts with one source, six files, zero diagnostics. Changing only Right to Record<Marker> makes an acyclic chain and remains accepted. On the same binary, the parser constructor-equality field-access negative refuses while its parenthesized positive accepts; the instrument can report a refusal.",
    "ARGUMENT BOUNDARY: type Loop = Record<Loop> at the same probe terminates with zero diagnostics on this seed. That is termination evidence only. A productive recursive application is not equated with an alias-head cycle, and this row makes no argument-cycle inhabitance or rejection claim.",
    "RUNG FOUND AT AND CURRENT RUNG: OutsideTheLadder for the measured transparent head-cycle acceptance. No general cycle refusal is implemented or claimed. CEILING: a structurally derived, typed and located refusal when alias-head traversal revisits an existing std.decl_ref.DeclarationRef.",
    "NEXT-RUNG TRIGGER: the alias-resolution authority retains the visited declaration path and transports its cyclic outcome to every relevant consumer without converting it to an unexposed head or a partial successful answer. Execute the cyclic negative, acyclic positive, and a mutation that removes the refusal; enumerate the consumer population before claiming general coverage.",
    "CLIMBED (gunbc#14702, v1 seed path): the v1 front end now refuses every transparent alias cycle with a typed, located TypeAliasCycle on each member, raised once per declaration at v1.compiler.resolve resolve_item_types from SymbolIndex.alias_cycles, computed once by one linear pass over the alias graph (v1.compiler.infer transparent_alias_graph; identity edges are the same edge rule under the declared plain_only filter). The fuel-bounded chase and the per-alias walk are deleted, so no alias walk carries a fuel guard. SymbolIndex covers every module of the corpus, so a cycle in a module no entry reaches refuses too.",
    "EVIDENCE, EXECUTED: test.claim.alias_cycle_refusal_witness run with gunbc run --claim-run on a binary built from regenerated mirrors: the two-member, self, three-member and parameterized cycles refuse (PASS), and the controls A=B/B=Int, alias-of-alias of a generic and a 21-hop acyclic chain are accepted (PASS). REVERT ARM: the same witness on the pre-regeneration binary of the same head, which lacks the check, FAILS the four REDs and PASSES the three controls. Whole-corpus regeneration over the new check resolved the package graph without a TypeAliasCycle (it first refused bodiless opaque declarations such as Never, which are not alias edges because they record no authored right-hand side); the dedicated whole-tree compile-clean census exceeded the remote deadline and is not claimed.",
    "RUNG HONESTY (review 84464): the class rung is the minimum across in-scope paths (section 4b ob.1), so it is recorded MechanicallyPreventable, below the StructurallyGuaranteed ceiling: the v1 declaration refusal is derived structurally, but the v2 carrier path is a separate rule and the witness is executed by a local claim run, not enrolled on the required gate. The standing climbs when both are closed (the trigger).",
    "SCOPE AND RESIDUE: the structural refusal is for the v1 seed path. The v2 carrier reader's carrier_chain_cycles is a separate path that refuses the same shape on its own input; v1 TypeAliasCycle is the declaration rule and the two are not unified here. Identity-map construction still keys bare names by global uniqueness, which is the pre-existing ambiguity hole and not widened.",
    "DISPOSITION: separate from the generic-inhabitance carrier repair. That repair may distinguish cyclic and unexposed results for its first routed product-application consumer. Such a scoped refusal does not discharge this general alias-head class.",
  ],
  evidence: [],
}
