module gunbc.recurring_failure_mode.alias_declaration_binding_row_not_carried

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data alias_declaration_binding_row_not_carried: RecurringFailureMode = RecurringFailureMode {
  identity: "alias_declaration_binding_row_not_carried" as NonEmptyStr,

  receipts: [
    "**An `alias Name = a.b.C` declaration bound Name to its own grafted node on the native route, not to a.b.C** (INVALID STATE: the `alias` keyword form (dag_grammar_alias_decl_expr, kw_alias -- NOT a `type X = Y` type alias, which lowers as a type declaration) was lowered as metadata and grafted as a member named Name, and no alias binding row was read from the normalized tree, so symbol_index_lexical_lookup of Name HIT a node that is not the target. HARM: an accepted program whose alias name means something other than what it says -- a silent wrong answer (DESIGN section 5). DISTINGUISHING FACTS: measured at main 6296275 with v2.test.parse.alias_decl_parse alias_decl_fill_lexical_lookup_holds on the normalized route: target indexed, LexicalHit, hit != target, zero rows accepted by alias_binding_row_from_decl_node over the normalized tree. The claim was ungated and had been fed a raw parse tree, so the defect was invisible twice over (gunbc#13372 census). No .dag source declares an alias, so no compile closure reached it. RUNG FOUND AT: below the ladder (silent). INTERIM (operator ruling via stern-bear-500, 2026-10-05, gunbc#13375): the native normalize refused the declaration, typed and located, so the form was unusable. CLIMBED (ruling B, carry, stern-bear-500 for the grammar program, 2026-10-05): the alias is a ruled mechanism (docs/plans/namespace-resolution-design.md section 13, operator 2026-07-21), so it is carried rather than deleted -- the graft dissolves the declaration as it does an import (v2.compiler.namespace_graft namespace_graft_unit_disposition), normalize carries its row on import_bindings (v2.compiler.normalize import_binding_capture), and the symbol index fill binds it at the declaring module, so the name resolves to its target by unique-on-chain; the interim refusal arm is deleted. RUNG NOW: structurally guaranteed on the native normalize -> symbol index -> resolve path = CEILING. EVIDENCE (kept enrolled, DESIGN section 4b(4)): the alias name hits its target; an alias to an undeclared target is unbound and resolve refuses resolve_reason_unbound_symbol at the reference; an Ambiguous name is disambiguated by an alias. With the graft arm reverted, all three go red. OWNER: the grammar program (stern-bear-500). RESIDUE, recorded rather than fixed here: an alias whose target never resolves and that nothing references is accepted silently (unused, lintable dead code per section 13), and v2.compiler.symbol_index_fill symbol_index_alias_rows_of still reads alias rows from a raw root for hand-built fixtures, a second reader of the same row that the normalized route never reaches.)",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.compiler.namespace_graft", decl_name: "namespace_graft_unit_disposition", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.compiler.normalize", decl_name: "import_binding_capture", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.parse.alias_decl_parse", decl_name: "alias_decl_fill_lexical_lookup_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.parse.alias_decl_parse", decl_name: "alias_decl_unresolved_target_refuses_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.parse.alias_decl_parse", decl_name: "alias_decl_disambiguates_holds", field: WholeDeclaration },
  ],
}
