module gunbc.recurring_failure_mode.declaration_reference_cites_a_declaration_nothing_resolved

import std.types { Int, List, NonEmptyStr }
import std.decl_ref { decl_ref }
import gunbc.recurring_failure_mode { RecurringFailureMode, RungRead, FoundBelowTheLadder, FoundOnRung, BelowCeiling }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.rung_climb { AwaitsOneGrounding, GroundingUndeclared }

data declaration_reference_cites_a_declaration_nothing_resolved: RecurringFailureMode = RecurringFailureMode {
  identity: "declaration_reference_cites_a_declaration_nothing_resolved" as NonEmptyStr,

  rung: RungRead {
    found_at: FoundBelowTheLadder,
    standing: BelowCeiling {
      current: FoundOnRung { rung: Mitigatable },
      ceiling: StructurallyGuaranteed,
      blocker: AwaitsOneGrounding { grounding: GroundingUndeclared },
      trigger_capability: "a required-path check that refuses an unresolvable DeclarationRef literal, with discriminating REDs (invented reference, bare head, alias of the reference type, invented prose span) enrolled beside a positive control; the decl-ref-census label that once measured this was retired (gunbc#15423, doctrine of gunb-ai/gunbc#15415, bad process is worse than no process), so no instrument measures the class until then; the further ceiling step needs substrate construction that refuses an unresolvable DeclarationRef literal",
    },
  },

  receipts: [
    "**a DeclarationRef literal, or a backtick symbol in ledger prose, names a module or declaration that does not exist, and nothing refuses it** (module_path, decl_name and field are three unchecked strings at construction, so an invented or stale citation is as writable as a real one).",

    "INVALID STATE: a citation consumed as a pointer to a declaration that no longer exists or never did. HARM: a reader follows it to nothing, or trusts a claim whose cited authority was renamed away. A stale symbol is decidable from the Node tree (gunbc.design_argument::single_authority), so every instance is a missed refusal, not an unknowable.",

    "RUNG FOUND AT: silent wrongness below the ladder for literals and prose alike. WAS mitigatable while the decl-ref-census instrument existed (retired in gunbc#15423, so nothing measures this class now and the rung is read as found-on-rung mitigatable only by the declared frontier above). It resolved every literal and every ledger backtick span through the native ingest and refused an unrostered unresolved identity by name, but it ran only on manual dispatch (the instrument-dispatch workflow), no required step runs it, and its discriminating REDs are not enrolled, so no merge is blocked by it and the rung is not mechanically preventable. Rostered identities carry one typed reason each and the retired census refused a roster row that matched nothing, so the recorded debt only shrinks when the instrument is run.",

    "CEILING: structurally guaranteed for literals (construction refuses an unresolvable reference) once the substrate can resolve at construction; prose spans stay a validator because a backtick span is not typed as a symbol. NEXT-RUNG TRIGGERS, two capabilities and then a third. (1) To reach mechanically preventable: a check on the required path (a row in the emitted subject build rows, which is closed to new jobs without operator sign-off) AND its REDs enrolled. (2) To reach structurally guaranteed: substrate construction that refuses an unresolvable DeclarationRef literal (the seed rosters are frozen with that dissolve-on).",

    "UNENROLLED EVIDENCE, A DECLARED STALL: the discriminating REDs for an invented reference, a bare head, an alias of the reference type and an invented prose span were executed as dispatch-only fixtures at gunbc#14598 and are not enrolled, because the census takes its source roots from the self-host roots and no fixture root can be passed through its label. The standing in-corpus RED is the deliberate-absent roster rows. TRIGGER (a capability): a required-path check that takes a fixtures directory, after which the four fixtures are enrolled with a positive control, and this stall closes. The census label that would have carried it is retired.)",

    "RECEIPT, v1_src_dag_parse ON MAIN (gunbc#14878): the seed sweep `v1_src_dag_parse`, built from main 82a77ab6271 BEFORE the PR, exited 1 with 60 *-ABSENT findings besides 13 CITATION-DEBT-ROW-STALE rows, so main carried citations to modules and declarations that do not exist while the rows meant to account for them rotted separately. The PR clears the 13 stale rows and 2 dead citation classes (modules deleted by #13703 and #13641); the residual 57 findings are a parked backlog, listed with owners in the PR body. This receipt is the SAME class at the seed sweep's grain: the sweep refuses them, but v1_src_dag_parse is on no required path, which is why main was red unobserved.",

    "OWNERS OF THE RESIDUAL (gunbc#14878 body): the 10 citations of `gunbc.provisioning.network_boot_actuation` are main citing a module that exists only on zesty-bear-293's branch (the unlanded-citation shape of `unlanded_citation_indistinguishable_at_the_citing_end`); the remaining ~47 are owner unassigned, routed to sleek-owl-397.",

    "RECEIPT, THE ONLY CITATION RESOLVER IN THE TREE IS FROZEN AND NO LONGER COMPILES (2026-11-17, still-fox-404, work item node://adhoc-4889d4a5-f3b). The single entry in the tree that resolves a `DeclarationRef` at all is the file `dag/test/claim/long/decl_ref_resolution_witness.dag` (6 test fns), and `gunbc.witness.witness_deferral_freeze` `frozen_path_deferrals` carries all six as a FrozenPathDeferral, so it runs on no cadence and no green run of it is available to any PR. It was dispatched by hand at tree 898378e1133c on a claim_batch binary sha256 c29788a12a335ab04d1d56aed901074b707afb09872339a88762a7f590521dae (its src identical to that binary's build point 5215eaaf821e), 385 s: ALL 6 fns FAIL at resolve, before one assertion evaluates -- `:78:10: error: effect summary incomplete: call to 'decl_ref' in test.claim.long.decl_ref_resolution_witness.decl_ref_resolves_decl_ref_constructor has no established callee identity, so its effects cannot be joined`. The class is then operating on its own instrument: the entry whose job is to refuse a citation to a callee nothing resolves cites `decl_ref` in a spelling that itself has no established callee identity, and it sits under a cause no witness executes. So a green v2-bootstrap and a green per-PR witness pass are compatible with a dead resolver, which is the mechanism the next receipt needed. WHY THE FAILING FN IS NAMED IN PROSE AND NOT CARRIED AS EVIDENCE: it is authored in a witness module, and `std.decl_ref` `CitationIndexCoverage` records exactly that state -- a declaration authored in a witness module is absent from the index while its module is present, so a reference to it is TRUE AND UNRESOLVABLE at once, the exclusion being the one `gunbc.ci.ci_layer_roots` carries a row to keep visible. A row about unresolvable citations will not add a citation the future resolver cannot see. WHAT THIS RECEIPT DOES NOT CLAIM: no bisect was run, so which change broke the entry is unknown; nothing here says the resolver's logic is wrong, only that it cannot currently be compiled; 6 failing fns are 6 fns of one entry, not 6 independent defects. The entry path, the function grain, the tree and the binary of that run are carried below the row as a typed record rather than left to be re-grepped out of this paragraph, and a witness compares that record against the freeze ledger and against the shape a digest has."

    "RECEIPT, ONE BRANCH WROTE ELEVEN FALSE CITATIONS AND EVERY PER-PR WITNESS STAYED GREEN (2026-11-17, still-fox-404, on branch session/still-fox-404 while bringing a hand-installed host under the modeled lifecycle; a reading at tree bd56f2e41970 over the 19 `.dag` files that branch touched -- a reading by one lane at one tree, not a live census and not an instrument the repo runs). METHOD, because these counts cannot be read without it: a parse-and-grep pass that collects declaration literals from `dag/**/*.dag` and looks each `decl_ref` module_path and decl_name pair up, skipping references into `v2.*` because the pass has no Rust index; it cannot tell rot from intent for host-side (Rust) declarations, protocol route names, or dissolved hosts, so those print unresolved and were judged by hand. THIS BRANCH'S OWN CITATIONS: 7 of the 47 `decl_ref` literals the branch had added named nothing -- a carrier type its own earlier commit had deleted (`remote_build_pool_width_reservations`, the roster fork review 96009 caught); a fan duty floor and a fan tach expectation cited into modules that do not own them (`fleet_fan_duty_floor`, `host_fan_tach_expectation_for`) instead of `gunbc.fleet.fleet_fan_converge_route` and `fan_converge_route_for_family`; a board profile module that was never declared (`extdeps.bmc.supermicro_aten_ast2600_board_profile`); the hostname allocation authority under the wrong declaration (`allocate_unique_hostname` where `hostname_allocation_admission` is what exists); a rotation route under its pre-rename module (`gunbc.machine_intake.bmc_secure` for what `gunbc.machine_intake.bmc_rotation_route` declares); and a federation provision cited from the module that only names it rather than the one that declares it. Plus 4 of the 68 module-and-declaration spans in prose named nothing: one INVENTED outright, an integration-concern register row (`site_pxe_edge_pinned_aarch64_chainloader_member_absent_from_srv4`) that was never filed, the fact being a receipt path inside `gunbc.host_network.site_pxe_edge_observe`; one given a date suffix the cited row does not carry; one naming a nonexistent type for `GetFanMode` and `GetZoneDuty`, which are operations of `service supermicro.OemFan`; and one attributing `host_memory_reserved` to `gunbc.runner.runner_slot_allocation` when `gunbc.serving.serving_reservation` declares it. All 11 were repaired on the branch (gunbc#16602, unlanded when this receipt was written, so cited by number). WHY NO WITNESS REDDED THEM: nothing on the required path resolves a literal, the branch's own per-PR witnesses passed at every head while all 11 stood, and the only resolver is the frozen entry of the receipt above. NOTE ON FORM: the false names are written here as module and declaration apart, never as a single module-and-declaration span, so a future prose-citation scanner does not read this row as an authority for a name that never existed. SCALE THIS BRANCH DID NOT AUTHOR: those same 19 files carry 686 `decl_ref` literals and the same pass printed 122 unresolved -- other lanes' rows, illustrative names, and host-side or route names the pass cannot judge -- so 122 is an upper bound over an unjudged set, not a count of defects, and that spread is why the class is systemic rather than one lane's carelessness. REPAIR PATH: `v2.compiler.decl_ref_disposition_roster` already answers what a citation may point at -- `HistoricalReceipt` carries the commit a name was true at, and `NameUnrecoveredFromHistory`, `IllustrativeName`, `DeclNameIsAParameter`, `DeliberateAbsentFixture`, `DeliberatelyAbsentCapability`, `UpstreamFieldUnmodeled`, `BindTargetDeleted`, `HostBuiltinSeam`, `DataRowFieldNotResolvable`, `ProductLabelTypedAsDeclarationRef` cover the rest -- and it deliberately carries NO stale-citation reason, because a stale reference is repaired or deleted; gunbc#15273 extends the citation census to the references built by `std.decl_ref`'s own constructors, which is the shape all 7 of these took, the literal-only reader having left them unjudged.",
  ],

  // THE TWO CITATIONS THIS ROW STANDS ON ARE READ, NOT ASSERTED: both name a declaration outside any
  // test module, inside the index a future resolver will use, and a witness below compares each against
  // what the row carries -- so renaming either reds there instead of leaving a name inside a paragraph.
  // Nothing further is cited: the frozen entry's own failing fn sits in a witness module and would be a
  // TRUE AND UNRESOLVABLE reference (the second citation is the carrier that says so), and adding an
  // unverified literal to the row that records the defect of unverified literals is the wrong direction.
  evidence: [
    decl_ref(
      module_path: "gunbc.witness.witness_deferral_freeze",
      decl_name: "frozen_path_deferrals",
    ),
    decl_ref(
      module_path: "std.decl_ref",
      decl_name: "CitationIndexCoverage",
    ),
  ],
}

// THE FROZEN-INSTRUMENT SIGHTING IN A TYPED CARRIER, added after review 96154 said the prose witnesses
// had no referent but their own text. What is carried here is only what something OUTSIDE this file can
// check: the entry path and the function grain are compared against
// gunbc.witness.witness_deferral_freeze frozen_path_deferrals as that ledger stands in this tree, and the
// tree and binary tokens are checked for the shape a short commit tree and a sha256 digest have (length,
// and characters drawn from the hex alphabet). The wall-clock, the diagnostic text and the outcome stay
// in the receipt prose above on purpose: their referent is one hand dispatch at one tree, which nothing in
// this tree can re-read, so a claim over them could only detect an edit to this file.
type FrozenResolverRunSighting {
  entry_file: String,
  functions: List<String>,
  tree: String,
  binary_digest: String,
  wall_seconds: Int,
}

data declaration_reference_cites_a_declaration_nothing_resolved_frozen_run: FrozenResolverRunSighting = FrozenResolverRunSighting {
  entry_file: "dag/test/claim/long/decl_ref_resolution_witness.dag",
  functions: [
    "decl_ref_resolves_node_kind_authority",
    "decl_ref_resolves_decl_ref_constructor",
    "decl_ref_refuses_module_absent",
    "decl_ref_refuses_declaration_absent",
    "decl_ref_refuses_ambiguous_binding",
    "decl_ref_refuses_named_field_absent",
  ],
  tree: "898378e1133c",
  binary_digest: "c29788a12a335ab04d1d56aed901074b707afb09872339a88762a7f590521dae",
  wall_seconds: 385,
}
