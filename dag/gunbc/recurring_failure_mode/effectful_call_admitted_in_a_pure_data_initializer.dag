module gunbc.recurring_failure_mode.effectful_call_admitted_in_a_pure_data_initializer

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { BelowCeiling, FoundOnRung, RecurringFailureMode, RungRead }
import gunbc.guarantee_rung { Mitigatable, StructurallyGuaranteed }
import gunbc.rung_climb { ClimbableButUnbuilt }

data effectful_call_admitted_in_a_pure_data_initializer: RecurringFailureMode = RecurringFailureMode {
  identity: "effectful_call_admitted_in_a_pure_data_initializer" as NonEmptyStr,

  rung: RungRead { found_at: FoundOnRung { rung: Mitigatable }, standing: BelowCeiling { current: FoundOnRung { rung: Mitigatable }, ceiling: StructurallyGuaranteed, blocker: ClimbableButUnbuilt, trigger_capability: "either of two capabilities, each sufficient for the refusal to land without reddening working programs: (1) effect evidence carried on function types, the missing capability gunbc.compile_clean_diagnostic_policy names for EffectSummaryIncompleteAtFunctionValue, so an arrow-typed field can declare the effects its inhabitants perform and a data initializer storing an effectful closure is refused at the check; (2) gunbc.filesystem_interface FilesystemInterface modeled as a resource with per-realization capabilities (emitted as an async trait), bound per realization, so the CAS store reaches the filesystem through a declared effect instead of through closures stored in pure data" } },

  receipts: [
    "**an effectful operation call inside a pure `data` initializer is admitted** (INVALID STATE: v1's front end accepts a `data` item whose initializer performs a declared effect -- directly, or inside a function value it stores -- although data is pure and no resource binding exists where it is evaluated. Specimen: gunbc.filesystem_interface data local_filesystem, a FilesystemInterface record whose six fields are closures calling extdeps.filesystem.filesystem_io Filesystem.Read / List / Delete / WriteCreateNew / WriteCreateNewWithMode / WriteOwnerOnly.",

    "HARM: emission realizes the data item as a thread-local cached value whose closures call the service through a handle nothing binds, inside synchronous closures. Dated specimen, 2026-10-24 (wise-wolf-174, class 10 of stern-bat-401's emitter-debt list), `gunbc compile --source-root dag --source-root src/v2 --entry dag/gunbc/durable_cas_file_store.dag --target rust` on main 7a1c55247016 (via scratch branch session/wise-wolf-174-route-main2 @286476d40ae9, which changes only an unrelated census entry), then cargo build: gunbc_filesystem_interface.rs lines 68/77/86/94/104/114 each carry rustc E0425 `cannot find value filesystem in this scope` and E0728 `await is only allowed inside async functions and blocks`, at the emitted `let r = filesystem.read(path.clone()).await?;` and its five siblings. Interpreted, the same module runs correctly: the interpreter performs the effect dynamically, so the defect is invisible until a native closure reaches it.",

    "WHY IT IS NOT REFUSED NOW (stern-bat-401 ruling, 2026-10-24): the effect is decidable for a direct call in the initializer (v1.compiler.infer_service records the data item's service_names, closed over callees), but a refusal today would red the 50 modules that import gunbc.durable_cas_file_store and run correctly under the interpreter, and turning local_filesystem into a function over an explicit Filesystem handle cannot make the crate build either, because the closures it returns still perform async effects inside synchronous Rc<dyn Fn> (v1 function types carry no effects). The buildable repair is the store's interface model (trigger 2), staffed as its own change; gunbc.durable_cas_file_store is a DESIGN-named leasing authority.",

    "RUNG: found at mitigatable (rustc refuses the emitted crate; the interpreter path is correct). Ceiling structurally guaranteed: with either trigger in place the check refuses an effect in a data initializer, direct or through a stored function value, from the modeled effect facts rather than a spelling.",
  ],
  evidence: [
    DeclarationRef { module_path: "gunbc.filesystem_interface", decl_name: "local_filesystem", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.filesystem_interface", decl_name: "FilesystemInterface", field: WholeDeclaration },
    DeclarationRef { module_path: "gunbc.compile_clean_diagnostic_policy", decl_name: "compile_clean_diagnostic_policy_scaffold", field: WholeDeclaration },
  ],
}
