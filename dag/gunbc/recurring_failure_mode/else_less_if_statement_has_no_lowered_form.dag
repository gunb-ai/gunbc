module gunbc.recurring_failure_mode.else_less_if_statement_has_no_lowered_form

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data else_less_if_statement_has_no_lowered_form: RecurringFailureMode = RecurringFailureMode {
  identity: "else_less_if_statement_has_no_lowered_form" as NonEmptyStr,

  receipts: [
    "no lowered form for an else-less `if` used as a statement (`if c { return x }` followed by further statements) in v2 body lowering: `v2.compiler.body_lowering_fold` `body_lower_try_if_from_captured` requires an else arm, and a Branch without one has no core shape, so it refuses as `body_lowering_reason_else_less_if_unlowered`, located at the `if`.",
    "SPECIMEN AND PINNED LOCUS: `dag/gunbc/machine_intake/mtcollins1_handoff_probe.dag` `mtcollins1_admission_probe`, at `if admitted == false { return exit_failure(..) }`, a guard followed by more statements.",
    "EXPOSED, NOT INTRODUCED: the parent of gunbc#12145 (2de78893dfe) accepted this shape only by SILENT NARROWING -- the operand reader answered a sequence with its left element -- so the refusal on main after gunbc#12173 is a pre-existing defect made visible, not a new regression. Found by the XL-2 three-baseline identity census on gunbc#12194 (321 paths: 18 refusing at 2de78893dfe, 167 at ada85b9452, 101 after gunbc#12173).",
    "RUNG FOUND AT: mitigated (a located refusal). CEILING: structurally guaranteed -- an early-return guard lowers to a Branch whose else is the remainder of the statement spine, or refuses. NEXT-RUNG TRIGGER, NAMING THE CAPABILITY: v2 body lowering lowers a statement-form else-less `if` whose arm returns by binding the rest of the statement spine as its else, so that every statement after the guard reaches the reference-site collector.",
    "SEQUENCED BEHIND THE RETURN FLOOR FIX (XL-2, sharp-carp-336): the guard's lowering needs the tail position carried through the value readers, the next-rung trigger of `gunbc.recurring_failure_mode` `return_lowered_as_its_operand_outside_the_function_tail`. That row's repair made every return outside a function's own tail refuse located instead of lowering to its operand; the guard keeps refusing here, pinned then by the floor fix's witness.",
    "TRIGGER MET (XL-2, sharp-carp-336): a statement-form else-less `if` heading a tail spine with a following statement, whose arm ends in a return, lowers to Branch(c, <arm>, <rest of the spine>) (`v2.compiler.body_lowering_fold` `body_lower_guard_branch`), admitted by the one top-down tail walk `body_lower_exit_outside_tail_optional`, so every statement after the guard reaches the reference-site collector. RUNG NOW: structurally guaranteed for the guard. RESIDUE: an else-less `if` whose arm falls through with no return, or that is the last statement, or that sits outside a tail spine, still refuses `body_lowering_reason_else_less_if_unlowered`, located at it.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.call_argument_value_resolve_refusal", decl_name: "an_else_less_if_guard_resolves", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.return_tail_position", decl_name: "an_else_less_if_that_falls_through_still_refuses_as_unlowered", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.return_tail_position", decl_name: "an_else_less_if_as_the_last_statement_still_refuses_as_unlowered", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.return_tail_position", decl_name: "a_guard_in_a_non_tail_spine_still_refuses_as_unlowered", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.return_tail_position", decl_name: "a_guard_followed_by_statements_is_accepted", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.return_tail_position", decl_name: "a_guard_arm_return_operand_is_read_and_refuses_unbound_at_its_atom", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.namespace_xl0.return_tail_position", decl_name: "the_statements_after_a_guard_are_read_and_refuse_unbound_at_their_atom", field: WholeDeclaration },
  ],
}
