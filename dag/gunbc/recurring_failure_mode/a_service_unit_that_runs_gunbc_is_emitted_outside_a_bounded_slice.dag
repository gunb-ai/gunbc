module gunbc.recurring_failure_mode.a_service_unit_that_runs_gunbc_is_emitted_outside_a_bounded_slice

import std.types { NonEmptyStr }
import gunbc.recurring_failure_mode { RecurringFailureMode, BelowCeiling, FoundOnRung, RungRead }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable, StructurallyImpossible }
import gunbc.rung_climb { ClimbableButUnbuilt }

data a_service_unit_that_runs_gunbc_is_emitted_outside_a_bounded_slice: RecurringFailureMode = RecurringFailureMode {
  identity: "a_service_unit_that_runs_gunbc_is_emitted_outside_a_bounded_slice" as NonEmptyStr,

  rung: RungRead { found_at: FoundOnRung { rung: Mitigatable }, standing: BelowCeiling { current: FoundOnRung { rung: MechanicallyPreventable }, ceiling: StructurallyImpossible, blocker: ClimbableButUnbuilt, trigger_capability: "one builder for gunbc-running service bodies that includes the slice by construction, with the sibling sites migrated to it" } },

  receipts: [
    "INVALID STATE: a service unit whose ExecStart runs the gunbc binary is emitted without Slice=, so it lands in system.slice, where gunbc refuses to run (user_work_scope: observed-bound arm did not admit, UncappedSystemSlice). The unit starts, is refused, exits 2, trips its start limit, and a .path unit that triggers it fails with it.",
    "RECEIPT, srv1 lab 2026-10-21 (lab-dev + main + #14619 e926e9f9): the new attempt-unit drain oneshot (live_deploy_attempt_unit_drain_service_unit_file) carried no Slice=. The deploy apply reported rc=0 and removed the old sudoers route in the same apply, so the lab held a revision whose root drain could not start and no sudo route to fall back on. Six sibling gunbc-running services each repeated ServiceSlice by hand; the seventh was written without it.",
    "DISTINGUISHING FACTS: the refusal text names UncappedSystemSlice:system.slice:<unit>; the unit file text has no Slice= line; sibling units in the same apply have one. The apply is not wrong about what it did (it installed the unit it was told to); no stage reads whether the installed unit can start.",
    "HARM: a successful apply over an inoperable privileged path; with the retired route deleted in the same apply there was no working launcher until the next deploy.",
    "RUNG FOUND AT: mitigatable (the lab owner's observation). CURRENT RUNG at the grain of the apply text: mechanically preventable, a claim over every [Service] body of the full-install apply that runs ` run --source-root` requires a Slice= naming the deployment or broker slice (RED as fixture source: a service text without Slice= is found unsliced; GREEN on the real lab apply). The directive is still written by hand at each site, so omission remains writable.",
    "CEILING: structurally impossible by one builder for gunbc-running service bodies that includes the slice by construction (the sibling sites migrate to it). NEXT-RUNG TRIGGER: that builder; a replacement migration over the seven sibling sites, enumerated by the claim above. Residual outside the guarantee: whether an installed unit can START on the host is observed only by running it (the apply does not read it); a post-apply start probe is the independent observation, and its absence is declared here.",
    "NEIGHBOURS: fci1_controls_unrunnable_under_wrap_policy and wrap_refusal_after_host_script_proceed_mutation concern the same refusal read at a different link (controls and host scripts); this row is the emitted-unit link.",
  ],
  evidence: [],
}
