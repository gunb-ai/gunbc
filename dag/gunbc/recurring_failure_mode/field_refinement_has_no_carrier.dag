module gunbc.recurring_failure_mode.field_refinement_has_no_carrier

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data field_refinement_has_no_carrier: RecurringFailureMode = RecurringFailureMode {
  identity: "field_refinement_has_no_carrier" as NonEmptyStr,

  receipts: [
    "INVALID STATE: a record or io field's type is refined by a where clause (`n: Int where range(min: 0)`), which v1 reads (`v1` `02_parse` `parse_field`: type, refinement, wire key, default), and v2 has no way to carry the refinement on a lowered field: the field's type is read by `body_lower_type_expr_lowered_optional`, which keeps the base type.",
    "HARM: a field lowered without its refinement admits every value of the base type where the author narrowed it, silently -- the refinement is the field's contract.",
    "CONTAINED, NOT SILENT: the grammar parses the refinement (`v2.extdeps.languages.dag` `dag_grammar_io_field_decl_expr`, the first slot of the field tail) and body lowering refuses the field on every arm that reads a field item, located at the clause, as `body_lowering_reason_field_refinement_unmodeled` (`body_lower_first_field_refinement_optional` for a record, `body_lower_io_item_step` for an io block). The module refuses at normalize. Before this the form did not parse, which refused the module at the parse population without naming the cause.",
    "RUNG FOUND AT: mitigated (typed, located refusal). CEILING: structurally impossible -- a field's refinement is part of its lowered type. NEXT-RUNG TRIGGER, NAMING THE CAPABILITY: a field's lowered type carries its where-clause refinement, read through the one where-clause reader type variants use rather than a second one, so `body_lowering_reason_field_refinement_unmodeled` has no producer. Retires with the parameter case (gunbc.recurring_failure_mode parameter_refinement_has_no_carrier), the same capability.",
  ],

  evidence: [
    DeclarationRef { module_path: "v2.test.claim.parse.population_grammar_gaps", decl_name: "a_refined_field_parses_holds", field: WholeDeclaration },
    DeclarationRef { module_path: "v2.test.claim.parse.population_grammar_gaps", decl_name: "a_refined_field_refuses_at_its_clause_holds", field: WholeDeclaration },
  ],
}
