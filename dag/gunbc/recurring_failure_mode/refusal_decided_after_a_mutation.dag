module gunbc.recurring_failure_mode.refusal_decided_after_a_mutation

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data refusal_decided_after_a_mutation: RecurringFailureMode = RecurringFailureMode {
  identity: "refusal_decided_after_a_mutation" as NonEmptyStr,

  receipts: [
    "**a withholdable or emit-time refuse that runs after a host mutation is a refusal after its effects** (INVALID STATE: a Decide that may refuse is sequenced after a Mutate, so the host already holds the candidate binary, tree or unit when the standing becomes Refused. RECOGNITION RULE: the emit concatenates mutation commands, then a poison marker that fail-fasts; a restart would start the new bytes under the still-loaded old claim. DISTINCT FROM [[enforcement_gate_positioned_after_the_effect_it_guards]]: there the verdict is computed before the effect and not branched on; here the verdict is computed, then the effect runs, then a later step refuses.)",
    "FOUND AT (bright-moth-475, srv1 PRODUCTION apply from clean main c22acb7, live_deploy_apply_prod_role_operator_local_wet; pre-apply probe InPlace global_unobservable=[srv2]). Exit 1. Cap step WITHHELD with 'surplus slots have not retired: actions-runner@srv1-12.service' (CapConvergeWithheld) — that echo is HostScriptProceed (2026-09-17). Door cutover refused; srv1-live still served 19b12d88. By then /opt/gunbc/bin, tree and unit file were at c22acb7 with NeedDaemonReload=yes (SystemdUnit stopped after unit install, before that member's daemon-reload). MEASURED CAUSE vs transcript: asked bright-moth-475 (msg_fc54059f) for the last command between roadmap unit install and SystemdUnit daemon-reload. Until that log line is pasted, the construction covers every emit-time __GUNBC_DEPLOY_REFUSED__/__GUNBC_OIDC_READBACK_REFUSED__/__GUNBC_FLEET_CONVERGE_REFUSED__ producer that used to sit inside Mutate after earlier writes — including approval_broker_helper_grant_admission — by lifting them into Decide{Refused} so compose_host_script emits no Mutate.",
    "RUNG FOUND AT: mitigatable. CURRENT: mechanically preventable — compose_host_script concatenates every Decide before every Mutate and returns an empty Mutate list when standing is Refused; apply_emit_time_refuse_fragments and approval_broker_dark_install_intent classify grant/oidc/owned-directory/fabric-door/fleet-timer poisons as Decide{Refused}; a cap withhold stays a CONVERGE_WITHHELD echo and HostScriptProceed. CEILING: structurally guaranteed once a Mutate fragment cannot be authored after a refuse Decide except through compose_host_script. NEXT-RUNG TRIGGER: an emit claim that a Decide{Refused} listed after a Mutate still precedes it and yields zero mutation steps, enrolled on apply_intent_from_effects, plus the bright-moth-475 transcript line naming the actual poison or runtime nonzero.",
  ],

  evidence: [
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "compose_host_script"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "apply_emit_time_refuse_fragments"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "apply_intent_from_effects"),
    decl_ref(module_path: "gunbc.host_axis_caps", decl_name: "cap_converge_decision_over_targets"),
  ],
}
