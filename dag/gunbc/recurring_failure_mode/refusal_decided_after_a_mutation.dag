module gunbc.recurring_failure_mode.refusal_decided_after_a_mutation

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data refusal_decided_after_a_mutation: RecurringFailureMode = RecurringFailureMode {
  identity: "refusal_decided_after_a_mutation" as NonEmptyStr,

  receipts: [
    "**a withholdable or fail-closed step that runs after a host mutation is a refusal after its effects** (INVALID STATE: a later command withholds or exits nonzero after a Mutate, so the host already holds the candidate binary, tree or unit when the apply fails. RECOGNITION RULE: the emit concatenates mutation commands, then a poison or a runtime fail-fast; a restart would start the new bytes under the still-loaded old claim.)",
    "FOUND AT (bright-moth-475, srv1:~/bm475-prod-apply-c22acb7-2026-10-12.log). NOT a poison: no __GUNBC_DEPLOY_REFUSED__. Cap WITHHELD is stderr line 471, an echo, HostScriptProceed. Outer: host_effect_apply shell exec exit=2. Last visudo stdout: /etc/sudoers.d/gunbc-approval-broker-helpers parsed OK. Last on-disk mutation that file 04:12:13; roadmap unit 04:09:19; NeedDaemonReload=yes (daemon-reload never ran). Nested gunbc was tree convergence (receipt 04:05:14), not the exit.",
    "FIXED: emit-time poisons are Decide with standing Refused and compose_host_script emits no Mutate (2026-09-17 withhold stays HostScriptProceed plus a CONVERGE_WITHHELD echo). Helper grant is installed before the roadmap unit dest, so a helpers-stretch failure no longer strands NeedDaemonReload. cmp without -s. compose prefixes __GUNBC_HOST_SCRIPT_STEP__ from each HostScriptFragment; apply frame exec 2>&1 so the next failure names its step on one stream even under bash -s. The cap member no longer shares the apply fold's staging dir with the helpers readback (private _gunbc_cap_stage; one EXIT trap removes both).",
    "NOT FIXED: the run-1 exit-2 command is UNCONFIRMED. Discriminator: CapConvergeWithheld vs Authorized (actions-runner@srv1-12 present vs retired). The withheld-vs-authorized emit diff names only the echo (exit 0) as withheld-only, sitting before unit install and daemon-reload; cmp -s is not a sufficient cause (the rerun from the same c22acb7 checkout passed after srv1-12 retired). Rival readings: (a) a post-helpers command whose result depended on host state that changed when srv1-12 retired — no such operand is named in that stretch; (b) cap-step exit 2 — fits the discriminator and the operator inference, not the concat order nor helpers having already mutated in the same bash -s. probable cause: the cap member and the helpers readback shared _gunbc_stage (the authorized-only writers being deploy_cap_upsert_staged_stmts); exact mechanism (perms, ownership, ordering or revert scope) unconfirmed; fix: a private cap stage.",
    "CONFIRMING EXPERIMENT, proposed, NOT run (wet srv1 is operator-scoped): a LAB apply on srv1 while one runner slot is held unretired (cap WITHHELD), from a head carrying the markers, with stdout and stderr merged into one ordered stream.",
    "RUNG FOUND AT: mitigatable. CURRENT: mechanically preventable for emit-after-mutate poisons, silent cmp -s, and untraced bash -s. The run-1 exit 2 command is unconfirmed. CEILING: structurally guaranteed once a silent fail-closed command cannot be authored in a Mutate. NEXT-RUNG TRIGGER: a withheld-cap apply whose merged stream carries __GUNBC_HOST_SCRIPT_STEP__ for the command that returned 2.",
  ],

  evidence: [
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "compose_host_script"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "memory_cap_withheld_line"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "deploy_shell_merge_stderr_command"),
    decl_ref(module_path: "gunbc.live_deploy.operations", decl_name: "deploy_stage_cmp_stages_command"),
    decl_ref(module_path: "gunbc.live_deploy.operations", decl_name: "deploy_cap_stage_dir_var"),
    decl_ref(module_path: "gunbc.host_axis_caps", decl_name: "deploy_cap_upsert_staged_stmts"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "emit_release_member_effects"),
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "reconcile_shell_exec_observed"),
    decl_ref(module_path: "gunbc.host_axis_caps", decl_name: "cap_converge_decision_over_targets"),
  ],
}
