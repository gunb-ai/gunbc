module gunbc.recurring_failure_mode.refusal_decided_after_a_mutation

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data refusal_decided_after_a_mutation: RecurringFailureMode = RecurringFailureMode {
  identity: "refusal_decided_after_a_mutation" as NonEmptyStr,

  receipts: [
    "**a withholdable or fail-closed step that runs after a host mutation is a refusal after its effects** (INVALID STATE: a later command withholds or exits nonzero after a Mutate, so the host already holds the candidate binary, tree or unit when the apply fails. RECOGNITION RULE: the emit concatenates mutation commands, then a poison or a runtime fail-fast; a restart would start the new bytes under the still-loaded old claim.)",
    "FOUND AT (bright-moth-475, srv1:~/bm475-prod-apply-c22acb7-2026-10-12.log). NOT a poison: no __GUNBC_DEPLOY_REFUSED__. Cap WITHHELD is stderr line 471, an echo, HostScriptProceed. Outer: host_effect_apply shell exec exit=2. Last visudo stdout: /etc/sudoers.d/gunbc-approval-broker-helpers parsed OK. Last on-disk mutation that file 04:12:13; roadmap unit 04:09:19; NeedDaemonReload=yes (daemon-reload never ran). Nested gunbc was tree convergence (receipt 04:05:14), not the exit.",
    "COMMANDS AFTER FINAL HELPERS VISUDO, c22acb7 UnitFile (roadmap unit already installed): (1) deploy_stage_install_from_command — sudo install -m 0400 -o ghrunner the helpers sudoers into $_gunbc_stage/gunbc-approval-broker-helpers.readback. GNU install typically exits 1 on failure, not 2. (2) deploy_stage_cmp_stages_command — cmp -s staged .sudoers vs .readback. cmp(1): 0 identical, 1 differ, 2 error (missing file, I/O). -s suppresses ALL output including 'No such file'. THIS IS THE ONLY COMMAND IN THE STRETCH WHOSE DOCUMENTED NONZERO IS 2 AND THAT PRINTS NOTHING. Matches the silent log. (3) approval_broker_helper_snapshot_retire_command — find -exec rm; GNU find exits 0 or 1. (4–5) broker slice/unit dest install — would bump /etc/systemd/system/gunbc-approval-broker.* mtimes; not observed after 04:12:13, so these did not run. (6) systemctl daemon-reload — did not run. ROOT: cmp -s on a missing staged operand. Likely cause of the miss: install_from did not create .readback at the path cmp reads (or left/right operand missing) and -s hid it. COVER: UnitFile now emits helper grant before the roadmap unit dest. FIX of the command: cmp without -s so a missing file names both paths. OBSERVABILITY: compose_host_script prefixes every Decide/Mutate step with __GUNBC_HOST_SCRIPT_STEP__ <kind> <member> <index> derived from HostScriptFragment.",
    "RUNG FOUND AT: mitigatable. CURRENT: mechanically preventable — cmp no longer silent; compose traces every fragment step; grant-before-unit cover. CEILING: structurally guaranteed once a silent fail-closed command cannot be authored in a Mutate. NEXT-RUNG TRIGGER: compose_traces_each_decide_and_mutate_step plus the grant claim that step 16 is cmp without -s.",
  ],

  evidence: [
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "compose_host_script"),
    decl_ref(module_path: "gunbc.live_deploy.operations", decl_name: "deploy_stage_cmp_stages_command"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "emit_release_member_effects"),
    decl_ref(module_path: "gunbc.host_axis_caps", decl_name: "cap_converge_decision_over_targets"),
  ],
}
