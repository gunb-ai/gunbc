module gunbc.recurring_failure_mode.refusal_decided_after_a_mutation

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.recurring_failure_mode { RecurringFailureMode }

data refusal_decided_after_a_mutation: RecurringFailureMode = RecurringFailureMode {
  identity: "refusal_decided_after_a_mutation" as NonEmptyStr,

  receipts: [
    "**a withholdable or fail-closed step that runs after a host mutation is a refusal after its effects** (INVALID STATE: a later command withholds or exits nonzero after a Mutate, so the host already holds the candidate binary, tree or unit when the apply fails. RECOGNITION RULE: the emit concatenates mutation commands, then a poison or a runtime fail-fast; a restart would start the new bytes under the still-loaded old claim. DISTINCT FROM [[enforcement_gate_positioned_after_the_effect_it_guards]]: there the verdict is computed before the effect and not branched on; here the effect runs, then a later step refuses.)",
    "FOUND AT (bright-moth-475, srv1 PRODUCTION apply from clean main c22acb7, live_deploy_apply_prod_role_operator_local_wet; log srv1:~/bm475-prod-apply-c22acb7-2026-10-12.log, 500 lines, copy of /tmp/prod-apply.log). ONE shell.Exec.Run (21 min); mktemp /tmp/tmp.Kgpm19JyxW gone so per-command order is not in the log. NOT an emit-time poison: no __GUNBC_DEPLOY_REFUSED__ line anywhere, nothing naming approval_broker_helper_grant_admission. Cap withhold (stderr line 471) is the CONVERGE_WITHHELD echo — HostScriptProceed, not the exit. Outer result: 'host_effect_apply: shell exec returned a nonzero exit code (exit=2); fail-closed'. stdout visudo: gunbc-deploy parsed OK; target/release/gunbc OK; /opt/gunbc/bin/gunbc OK; gunbc-approval-broker-helpers.sudoers parsed OK; helpers.new parsed OK; /etc/sudoers.d/gunbc-approval-broker-helpers parsed OK (grant admitted and installed). Nested gunbc (449 files) last effect Filesystem.Read /opt/gunbc/receipts/repository-convergence.json (tree already converged). Door (line 500): 'tailnet door cutover refused with no route effect: the door is not ready: the deployment mutation did not converge'. On-disk mtimes: gunbc-deploy sudoers and /opt/gunbc/bin 03:50:59; repository-convergence.json 04:05:14 verdict converged c22acb7; /etc/systemd/system/gunbc-roadmap.service 04:09:19; /etc/sudoers.d/gunbc-approval-broker-helpers 04:12:13 LAST visible mutation. NeedDaemonReload=yes: no daemon-reload after the unit write. CONFIRMED CHAIN: unit dest installed, then helper sudoers install succeeded, then a later silent command returned 2 (log cannot name which: post-visudo readback/cmp, snapshot retire, or broker unit stage) before daemon-reload. WITHHELD echo did not set exit 2 (it is echo >&2).",
    "RUNG FOUND AT: mitigatable. CURRENT: mechanically preventable — compose_host_script drops Mutate on Decide{Refused} (emit-time poisons); UnitFile emits apply_approval_broker_unit_write_steps before the roadmap unit dest install so a runtime nonzero in the helper-grant/broker-unit stretch cannot leave NeedDaemonReload; cap withhold stays CONVERGE_WITHHELD HostScriptProceed. CEILING: structurally guaranteed once a Mutate that can fail-closed cannot be authored after the unit dest install except through compose_host_script. NEXT-RUNG TRIGGER: helper_grant_precedes_the_roadmap_unit_install plus a_supplied_refused_decide_yields_zero_mutation_steps enrolled on the production emit_release_member_effects / compose_host_script route.",
  ],

  evidence: [
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "compose_host_script"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "apply_emit_time_refuse_fragments"),
    decl_ref(module_path: "gunbc.live_deploy.emit", decl_name: "emit_release_member_effects"),
    decl_ref(module_path: "gunbc.host_axis_caps", decl_name: "cap_converge_decision_over_targets"),
  ],
}
