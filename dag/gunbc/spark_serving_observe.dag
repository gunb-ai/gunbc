module gunbc.spark_serving_observe

import std.types { String, Bool, List, NonEmptyStr }
import std.algebra { trim }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import product.placement_supply { HostIdentity }
import extdeps.ssh.session { ssh_session_exec_portable_words, SshSessionExecResult }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.clock_read { clock_now_probed_at }
import gunbc.fleet_reach_endpoint { fleet_probe_endpoint_for }
import gunbc.fleet_known_hosts_anchor {
  FleetSshExecutionContext,
  fleet_ssh_execution_context_of,
  materialize_fleet_known_hosts_anchor,
  known_hosts_materialization_receipt,
  fleet_ssh_attempt_identity,
  SshTarget,
  portable_remote_words,
  shape_fleet_ssh_exec,
}
import gunbc.fleet_multi_principal_probe { fleet_ssh_attempt_raw_from_env }
import gunbc.spark_credential_workflow { run_with_materialized_fleet_ssh_binding }
import gunbc.auth.access_token_source { GcloudPrintToken }
import gunbc.spark_serving_loaded_release {
  SparkServingReadback,
  derive_spark_serving_observation,
}
import gunbc.spark_serving_release {
  SparkServingObservation,
  SparkServingAbsent,
  SparkServingObserved,
  SparkServingObservationRefused,
}

data spark_serving_observe_transport_note: String = "OBSERVATION PRODUCER (SPARK-SERVE-BIND-0 item B) over FleetSsh — the same bound-credential context spark_managed_access_apply uses, never a second SSH path."

data spark_serving_observe_note: String = "Wet observation only; a green witness over fixture strings is not proof gpt-oss:20b is serving. Nothing is live until host_effect_apply binds InstallOwnedRuntimeClosure through #8225 package_delivery."

data spark_serving_observe_receipt_path: String = "target/spark-serving-observe-receipt.txt"

data spark_serving_probe_principal: String = "gunbc-automation"

data spark_serving_probe_hosts: List<String> = ["srv5", "srv6"]

data spark_serving_unit_probe_words: List<String> = [
  "systemctl", "--user", "is-active", "gunbc-spark-serving.service",
]

data spark_serving_version_probe_words: List<String> = [
  "curl", "-sf", "http://127.0.0.1:11434/api/version",
]

data spark_serving_tags_probe_words: List<String> = [
  "curl", "-sf", "http://127.0.0.1:11434/api/tags",
]

fn spark_serving_probe_leg(
  context: FleetSshExecutionContext,
  host: String,
  raw_words: List<String>,
) -> SshSessionExecResult? {
  match portable_remote_words(raws: raw_words) {
    Absent => none
    Present { value: words } => Present {
      value: ssh_session_exec_portable_words(
        client_args: shape_fleet_ssh_exec(
          context: context,
          target: SshTarget {
            endpoint: fleet_probe_endpoint_for(host: host) as NonEmptyStr,
            principal: spark_serving_probe_principal as NonEmptyStr,
          },
          words: words,
        ),
      ),
    }
  }
}

fn spark_serving_unit_active(result: SshSessionExecResult?) -> Bool {
  match result {
    Absent => false
    Present { value: r } => r.success && trim(s: r.stdout) == "active"
  }
}

fn spark_serving_runtime_version_from_version_json(stdout: String) -> String? {
  let needle = "v0.9.6"
  if string_contains(s: stdout, pattern: needle) {
    Present { value: needle }
  } else if string_contains(s: stdout, pattern: "0.9.6") {
    Present { value: "v0.9.6" }
  } else {
    none
  }
}

fn spark_serving_model_digest_from_tags_json(stdout: String) -> String? {
  if string_contains(s: stdout, pattern: "gpt-oss") && string_contains(s: stdout, pattern: "sha256:") {
    Present { value: "observed-from-tags-pending-exact-parse" }
  } else {
    none
  }
}

fn spark_serving_readback_from_probe_results(
  host: HostIdentity,
  unit: SshSessionExecResult?,
  version: SshSessionExecResult?,
  tags: SshSessionExecResult?,
) -> SparkServingReadback {
  SparkServingReadback {
    host: host,
    unit_active: spark_serving_unit_active(result: unit),
    runtime_version: match version {
      Absent => none
      Present { value: r } => if r.success { spark_serving_runtime_version_from_version_json(stdout: r.stdout) } else { none }
    },
    model_repository: match tags {
      Absent => none
      Present { value: r } => if r.success && string_contains(s: r.stdout, pattern: "gpt-oss") { Present { value: "gpt-oss" } } else { none }
    },
    model_revision_digest: match tags {
      Absent => none
      Present { value: r } => if r.success { spark_serving_model_digest_from_tags_json(stdout: r.stdout) } else { none }
    },
    bind_address: none,
  }
}

fn spark_serving_readback_line(readback: SparkServingReadback) -> String {
  join([
    "observe host=", readback.host as String,
    " unit_active=", if readback.unit_active { "true" } else { "false" },
    " runtime_version=", match readback.runtime_version { Absent => "absent" Present { value: v } => v },
    " model_repo=", match readback.model_repository { Absent => "absent" Present { value: v } => v },
    " model_rev=", match readback.model_revision_digest { Absent => "absent" Present { value: v } => v },
    "\n",
  ], "")
}

fn spark_serving_observation_line(observation: SparkServingObservation) -> String {
  match observation {
    SparkServingAbsent { host: h } => join(["observation host=", h as String, " state=absent\n"], "")
    SparkServingObservationRefused { host: h, cause: c } =>
      join(["observation host=", h as String, " state=refused cause=", c as String, "\n"], "")
    SparkServingObserved { host: h, loaded_release: r } =>
      join(["observation host=", h as String, " state=observed digest=", r.digest.digest as String, "\n"], "")
  }
}

fn spark_serving_observe_host_block(
  context: FleetSshExecutionContext,
  host: String,
) -> String {
  let unit = spark_serving_probe_leg(context: context, host: host, raw_words: spark_serving_unit_probe_words)
  let version = spark_serving_probe_leg(context: context, host: host, raw_words: spark_serving_version_probe_words)
  let tags = spark_serving_probe_leg(context: context, host: host, raw_words: spark_serving_tags_probe_words)
  let readback = spark_serving_readback_from_probe_results(
    host: host as HostIdentity,
    unit: unit,
    version: version,
    tags: tags,
  )
  join([
    spark_serving_readback_line(readback: readback),
    spark_serving_observation_line(observation: derive_spark_serving_observation(readback: readback)),
  ], "")
}

func spark_serving_observe_wet() -> ProcessExit
  uses net: Network
{
  match fleet_ssh_attempt_raw_from_env() {
    Absent =>
      exit_failure(
        reason: "spark_serving_observe_wet requires GUNBC_FLEET_SSH_ATTEMPT_RAW or GitHub GITHUB_RUN_ID+GITHUB_RUN_ATTEMPT env"
      )
    Present { value: attempt_raw } => spark_serving_observe_with_attempt(attempt_raw: attempt_raw)
  }
}

func spark_serving_observe_with_attempt(attempt_raw: String) -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  run_with_materialized_fleet_ssh_binding(
    attempt_raw: attempt_raw,
    token_source: GcloudPrintToken,
    body: fn(credential) {
      let body = match fleet_ssh_attempt_identity(raw: attempt_raw) {
        Absent =>
          join(["spark serving observe probed_at=", now as String, " REFUSED: attempt identity is not a safe path segment\n"], "")
        Present { value: attempt } => {
          let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
          match fleet_ssh_execution_context_of(outcome: materialization, credential: credential) {
            Absent => join([
              "spark serving observe probed_at=", now as String,
              " REFUSED: ", known_hosts_materialization_receipt(outcome: materialization), "\n",
            ], "")
            Present { value: context } => join([
              join(["spark serving observe probed_at=", now as String, " attempt_raw=", attempt_raw, "\n"], ""),
              known_hosts_materialization_receipt(outcome: materialization),
              join(map(spark_serving_probe_hosts, h => spark_serving_observe_host_block(context: context, host: h)), ""),
            ], "")
          }
        }
      }
      let w = Filesystem.Write(path: spark_serving_observe_receipt_path, content: body)
      if w.success {
        ExitSuccess
      } else {
        exit_failure(reason: join(["spark serving observe receipt write failed: ", w.error], ""))
      }
    },
  )
}
