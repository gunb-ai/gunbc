module gunbc.git_argv_route_wall

import std.types { String, List, Bool, NonEmptyStr, Int }
import std.algebra { list_at_optional }
import std.optional { Present, Absent }

// git argv is written in two dressings (`extdeps/git.dag`):
//
//   * a BARE word-list whose leading token is the git subcommand --
//     `["commit","-q","--allow-empty","-m",msg]` -- for a route that carries the working
//     directory itself, and
//   * an IN-REPO list that names the repository up front -- `["-C",repo,"commit","-m",msg]` --
//     for a route that carries none.
//
// A bare word-list carries no place to run. Handed to a route that names no working directory,
// git acts on whatever repository the process happens to sit in, so a bare MUTATING argv can
// commit into a tree its caller does not own -- under whatever identity the ambient config names
// -- and report only a boolean. Where that tree is a gate tree the damage is silent: `git checkout
// -f` does not remove untracked files, so a stray commit or file survives into the next head's
// gate and changes what was gated.
//
// This module is the consumer-side WALL over that pairing. Policy stays with the consumer and
// `extdeps/git.dag` stays anemic: every fn here is a decidable predicate over argv WORDS -- no
// command builder, no spawn, no grounding. It is the general form of the answer `belt_commit_git`
// already gives: belt_commit_git refuses to spawn at all until the worktree's own gitfile is
// verified, so no caller reaches the tool without naming where the tool runs. Here the same
// refusal is stated for every route:
//
//   * a route that CARRIES a working directory may take a bare mutating argv, because git then runs
//     exactly where the route says, and
//   * a route that names NO working directory admits ONLY an argv that names where it acts: the
//     in-repo dressing (`-C`/`--git-dir`/`--work-tree`), or a bare argv whose leading subcommand is on
//     a CLOSED allowlist of read-only inspection verbs. Everything else -- a bare mutating argv, and
//     fail-closed any verb the allowlist has not earned -- is refused. So the in-repo dressing is the
//     only mutating way to reach such a route, and an unconsidered verb is refused rather than
//     admitted: the failure direction is a route that fails loudly, never an ambient-tree write.
//
// `admit_git_argv_on_route` is the single decision a route branches on before spawning:
// GitArgvAdmitted, or the distinct GitArgvRefused variant -- a typed,
// located refusal, never an invisible default (fail_closed). It spawns nothing and claims no
// authority over wetness; naming where the tool runs stays the route's own obligation. The point
// is that a git route reaches a spawn only by branching on this decision. Its discriminating
// witness is `test.claim.git_bare_mutating_route_wall_witness`.

// The two route kinds, told apart by whether the route names where git runs. There is no third
// kind: a route either carries a directory or it does not, and the admissible argv follows. A
// carrying route names a NON-EMPTY place by construction -- `workdir: NonEmptyStr` makes "advertises
// a working directory but names nowhere" an unrepresentable value, so no runtime empty-check is
// needed and no caller can build the mis-joined route at all (fail_closed: unwritable beats caught).
type GitArgvRoute
  = GitWorkdirCarrying { workdir: NonEmptyStr }
  | GitWorkdirFree

// The single classification a workdir-free route needs is `git_subcommand_is_safe_read_only` below
// plus `git_argv_is_in_repo_dressed`: an argv is admissible at a workdir-free route ONLY if it names
// its repository or its leading verb is on the closed read-only allowlist. There is deliberately NO
// separate "is this verb mutating" denylist beside it: the wall must carry ONE classification of
// "may this argv run without a place?", so the two lists can never drift into disagreeing about the
// same verb. A verb is refused because it is not proven safe, not because it is proven dangerous --
// which is why an explicit dangerous-list would be both dead weight and a second source of truth.

// A git subcommand that only ever READS -- an inspection verb that cannot write the repository or the
// working tree, whatever its arguments. This is the CLOSED allowlist a workdir-free route admits in
// place of the in-repo dressing: the workdir-free decision admits ONLY an argv that names its
// repository (`-C`/`--git-dir`/`--work-tree`) or whose leading subcommand appears HERE, and refuses
// everything else. The burden is inverted from a denylist: a verb nobody enumerated -- `pull`,
// `revert`, `commit-tree`, `notes`, `submodule`, a future git verb -- is REFUSED, so the gap surfaces
// as someone's route failing loudly, never as a silent write into the ambient tree (fail_closed: the
// wrong state is unwritable, not caught).
//
// Only UNAMBIGUOUSLY read-only verbs belong here. A verb whose write-ness is argument-dependent is
// NOT safe at a route that names no place to run, so it stays out and is refused: `config <k> <v>`
// writes while `config <k>` reads; `branch`/`tag` create by default; `remote add/remove` write;
// `stash`, `clean`, `bisect` mutate state. Reaching one of those at a workdir-free route means
// re-dressing it (`-C <repo> ...`) or taking a directory-carrying route -- never admitting an
// unconsidered verb by default.
fn git_subcommand_is_safe_read_only(subcommand: String) -> Bool {
     subcommand == "status"
  || subcommand == "log"
  || subcommand == "show"
  || subcommand == "diff"
  || subcommand == "cat-file"
  || subcommand == "rev-parse"
  || subcommand == "rev-list"
  || subcommand == "ls-files"
  || subcommand == "ls-tree"
  || subcommand == "ls-remote"
  || subcommand == "describe"
  || subcommand == "name-rev"
  || subcommand == "merge-base"
  || subcommand == "blame"
  || subcommand == "shortlog"
  || subcommand == "whatchanged"
  || subcommand == "grep"
  || subcommand == "reflog"
}

// The in-repo dressing: git's global `-C <repo>` option in first position with a non-empty
// repository operand, OR a `--git-dir`/`--work-tree` global naming its target -- is what makes a
// route that carries no working directory SAFE to spawn: git runs against the named repository, not
// the ambient tree. Admitted, never refused. Recognising all the repo-naming globals (not just `-C`)
// is what lets a `--git-dir` commit be admitted for the RIGHT reason -- it names its target -- rather
// than by the accident of a flag that happens to read as non-mutating.
fn git_argv_is_in_repo_dressed(argv: List<String>) -> Bool {
  match list_at_optional(xs: argv, index: 0) {
    Absent => false
    Present { value: head } =>
      if head == "-C" || head == "--git-dir" || head == "--work-tree" {
        match list_at_optional(xs: argv, index: 1) {
          Present { value: repo } => repo != ""
          Absent => false
        }
      } else {
        names_repo_with_equals(head: head)
      }
  }
}

// `--git-dir=<path>` / `--work-tree=<path>`: a single option token whose right-hand side is non-empty.
fn names_repo_with_equals(head: String) -> Bool {
     option_equals_nonempty(head: head, prefix: "--git-dir=")
  || option_equals_nonempty(head: head, prefix: "--work-tree=")
}

// head starts with `prefix` and is strictly longer than it (a non-empty right-hand side).
fn option_equals_nonempty(head: String, prefix: String) -> Bool {
  starts_with(s: head, prefix: prefix) && !ends_with(s: head, suffix: prefix)
}

// The leading subcommand, stepping over a leading run of git GLOBAL options (any token beginning with
// "-"), consuming the operand of a value-taking option given as a separate argument; the first token
// that is not an option is the subcommand. Stepping over OPTIONS -- not just `-C` -- is what stops a
// bare mutation hiding its verb behind `-c k=v` / `--no-pager` / `--git-dir` at a route that carries
// no directory (fail_closed: the verb is found, not skipped past). An argv too short to carry one
// yields "" and so classifies as neither mutating nor a command.
fn git_argv_leading_subcommand(argv: List<String>) -> String {
  git_argv_leading_subcommand_at(argv: argv, index: 0)
}

// Value-taking git globals supplied as `-X value` (separate operand). The `--opt=value` spelling is a
// single token and is NOT in this set -- it is stepped over as one option token.
fn git_option_takes_separate_operand(option: String) -> Bool {
     option == "-c"
  || option == "-C"
  || option == "--git-dir"
  || option == "--work-tree"
  || option == "--namespace"
  || option == "--exec-path"
}

fn git_argv_leading_subcommand_at(argv: List<String>, index: Int) -> String {
  match list_at_optional(xs: argv, index: index) {
    Absent => ""
    Present { value: head } =>
      if !starts_with(s: head, prefix: "-") {
        head
      } else if git_option_takes_separate_operand(option: head) {
        git_argv_leading_subcommand_at(argv: argv, index: index + 2)
      } else {
        git_argv_leading_subcommand_at(argv: argv, index: index + 1)
      }
  }
}

// The decision a route branches on before spawning: Admitted, or a distinct Refused variant. There
// is no admissible-but-warned state, no admitted-by-default and no string label a typo could turn
// into "admitted" -- fail_closed, a wrong answer is a located, typed variant, not an invisible
// default. There is exactly one Refused VARIANT, but it now covers every bare argv at a workdir-free
// route that neither names a repository (`-C`/`--git-dir`/`--work-tree`) nor is a safe read-only verb
// -- the bare-mutating mis-join AND any unrecognised verb the closed allowlist has not earned. So
// `GitArgvRefused` stays a nullary variant rather than a reason sum: the refusal is located (this
// route, this argv) and the model does not pretend to a finer reason taxonomy it has not enumerated;
// the "carrying route names no directory" half never needs a reason because `workdir: NonEmptyStr`
// makes that route unconstructable.
type GitArgvRouteAdmission
  = GitArgvAdmitted
  | GitArgvRefused

// THE WALL. The single decision a route makes before any spawn.
fn admit_git_argv_on_route(route: GitArgvRoute, argv: List<String>) -> GitArgvRouteAdmission {
  match route {
    // Carries the directory: a bare argv is legitimate, because git then runs exactly where the
    // route says. The route cannot advertise a directory and name nowhere -- `workdir: NonEmptyStr`
    // makes that value unconstructable -- so there is nothing left to refuse on this arm.
    GitWorkdirCarrying => GitArgvAdmitted
    // Names no directory: admit ONLY an argv that carries its own place to act -- the in-repo
    // dressing (`-C`/`--git-dir`/`--work-tree`, the short-circuit below) or a bare argv whose leading
    // subcommand is a safe read-only inspection verb. Everything else is REFUSED: a bare mutating
    // argv (it would mutate whatever tree the process sits in) and, fail-closed, any UNRECOGNISED
    // verb -- one not on the read-only allowlist -- because a git subcommand nobody enumerated may
    // write the ambient tree just as `commit` does. The default is refusal, so the allowlist can
    // never be silently incomplete in the dangerous direction.
    GitWorkdirFree =>
      if git_argv_is_in_repo_dressed(argv) {
        GitArgvAdmitted
      } else if git_subcommand_is_safe_read_only(git_argv_leading_subcommand(argv)) {
        GitArgvAdmitted
      } else {
        GitArgvRefused
      }
  }
}
