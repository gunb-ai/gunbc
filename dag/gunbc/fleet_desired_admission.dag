module gunbc.fleet_desired_admission

// THIS MODULE IS THE LIVE HALF OF THE ADMISSION GATE, AND IT EXISTS BECAUSE THE GATE HAD
// NO PRODUCTION CONSUMER. gunbc.fleet_main_revision states the rule in its own header —
// the desired revision derives from MERGED, FLOOR-GREEN main, never from raw HEAD — and
// models it as admit_fleet_desired_advance, whose refusal names the prevented class
// ("raw-HEAD simultaneous fleet-bricking"). Until this module landed that function's ONLY
// caller was its witness test, while the shell step emitted by gunbc.ci_spec
// (gunbc_ci_advance_fleet_desired_script) stamped $GITHUB_SHA on every push to main
// without consulting it. That is specification-without-execution (DESIGN §5) with the
// unproven path live: the modeled wall stood beside an actuator that walked around it.
//
// WHY THE ADMISSION CANNOT LIVE IN THE DEPLOY JOB. The required floor takes ~30 minutes,
// so at push-trigger time no floor conclusion exists for the candidate. A push-triggered
// advance can only ever fabricate floor-green or refuse forever; neither is the gate. The
// conclusion becomes observable exactly once — when the floor run completes — so the
// admission is keyed to that event and reads the conclusion GitHub delivers, rather than
// inferring it from the trigger that happened to fire.
//
// WHAT THIS BUYS DOWNSTREAM, which is more than a correctly-named ref: gunbc.roadmap_belt_actuate
// gates worker DISPATCH on revision standing, and its own note calls a dispatch from an
// unadmitted tree "a worker spawned from code the fleet never admitted, reported as an
// ordinary spawn". Advancing desired to whatever last landed makes that comparison agree
// unconditionally, so the gate passes silently. Gating the advance is what gives the
// dispatch gate something real to compare against.
data fleet_desired_admission_note: String = "The live consumer of gunbc.fleet_main_revision admit_fleet_desired_advance. See the annotation above it."

// The floor run's event payload, copied to a modeled path by the workflow step so the
// decision reads a path this module names rather than an environment variable it cannot
// see. The copy is the only thing the surrounding shell decides; every admission fact is
// read from the payload here.
data fleet_desired_admission_event_payload_path: String = "target/fleet-desired-admission-event.json"

// The authorized actuation. The model writes the exact push this admission authorized —
// including the compare-and-swap prior it observed — and the workflow executes that file
// and nothing else. The shell therefore carries no candidate revision, no ref name and no
// expected prior of its own: it cannot push a revision the gate did not admit, because it
// has no other push to run. Full construction (a typed CAS service op) is not reachable
// yet — extdeps.git.publication_transport PushRefUpdate is shadow-only and models no
// --force-with-lease — so the actuation stays shell; what changed is that the DECISION no
// longer does.
data fleet_desired_admission_authorized_push_path: String = "target/fleet-desired-authorized-push.sh"

// The repository root the observation reads. The admission runs in the checkout the
// workflow prepared, so the desired ref is observed through that checkout's origin.
data fleet_desired_admission_repo_root: std.types.FilePath = "." as std.types.FilePath

type FleetDesiredAdmissionOutcome
  = AdmissionAdvanceAuthorized { from: extdeps.git.object_store.GitObjectId, to: extdeps.git.object_store.GitObjectId }
  | AdmissionRefused { cause: String }

// THE TRUST WALL RE-CHECKS WHAT THE TRIGGER FILTER ALREADY CLAIMS, and that is deliberate
// rather than redundant. The workflow_run trigger names the floor workflow, but a trigger
// widened later — a second workflow added to the list, a branch filter dropped, the file
// edited on another branch — would silently route a foreign run's conclusion into an
// admission. The reader refuses on identity it can see in the payload, so a widened
// trigger is caught here instead of admitted. Each arm names the member that disagreed and
// both sides of the comparison; none of them widens to a default.
fn fleet_desired_admission_event_trusted(event: extdeps.github.workflow_run_event.WorkflowRunEvent) -> String? {
  if event.activity != "completed" {
    Present { value: concat("fleet_desired_admission: workflow_run activity is not completed: ", event.activity) }
  } else {
    if event.workflow_name != gunbc.witness_floor_workflow.witness_floor_workflow_name {
      Present {
        value: join([
          "fleet_desired_admission: conclusion belongs to workflow ",
          event.workflow_name,
          ", not the required floor (",
          gunbc.witness_floor_workflow.witness_floor_workflow_name,
          ")",
        ], ""),
      }
    } else {
      if event.head_branch != gunbc.repo_identity.gunbc_default_branch_name {
        Present {
          value: join([
            "fleet_desired_admission: floor run is on branch ",
            event.head_branch,
            ", not ",
            gunbc.repo_identity.gunbc_default_branch_name,
            " — only the default branch admits a fleet revision",
          ], ""),
        }
      } else {
        if event.head_repository_full_name != event.repository_full_name {
          Present {
            value: join([
              "fleet_desired_admission: floor run head repository ",
              event.head_repository_full_name,
              " is not this repository ",
              event.repository_full_name,
              " — a fork's run never admits a fleet revision",
            ], ""),
          }
        } else {
          none
        }
      }
    }
  }
}

// floor_green is DERIVED FROM THE DELIVERED CONCLUSION AND NOWHERE ELSE. Only Success is
// green; every other conclusion — including Cancelled, Skipped and StartupFailure — leaves
// it false and the modeled gate refuses with its own cause. There is no arm here that
// decides a non-Success conclusion is close enough, which is the point: the argument this
// function feeds is the one the authority says the ref advances on.
fn fleet_desired_floor_green(conclusion: extdeps.github.workflow_runs.WorkflowRunConclusion) -> std.types.Bool {
  match conclusion {
    Success => true
    Failure => false
    Cancelled => false
    Neutral => false
    Skipped => false
    TimedOut => false
    ActionRequired => false
    StartupFailure => false
  }
}

// AN UNOBSERVED PRIOR REFUSES; IT IS NEVER READ AS "no prior, so this is the first
// admission". gunbc.fleet_desired_observe reports a transport refusal and an unadvertised
// ref as the same FleetDesiredUnobserved with different causes, so this consumer cannot
// tell them apart — and the two demand opposite actuations: a first admission is a plain
// push, a transport refusal must not push at all. Collapsing them would make an ls-remote
// failure create the ref from scratch and overwrite an admitted revision it simply could
// not read, which is the empty-observation narrow with the fleet as the blast radius. The
// ref exists, so refusing costs nothing real; if a genuine first admission is ever needed
// it arrives as a distinguished observation, not as this arm guessing.
fn fleet_desired_admission_decide(event: extdeps.github.workflow_run_event.WorkflowRunEvent, observed: gunbc.fleet_main_revision.FleetDesiredRevision) -> FleetDesiredAdmissionOutcome {
  match fleet_desired_admission_event_trusted(event: event) {
    Present { value: refusal } => AdmissionRefused { cause: refusal }
    Absent =>
      match observed {
        FleetDesiredUnobserved { cause: why } =>
          AdmissionRefused {
            cause: join([
              "fleet_desired_admission: the admitted prior could not be observed, so no advance is authorized (an unobserved prior is never read as an absent one): ",
              why,
            ], ""),
          }
        FleetDesiredAbsent =>
          AdmissionRefused {
            cause: "fleet_desired_admission: the admitted prior is ABSENT, and an absent prior authorizes nothing. Advancing here would write a first admission from an arm that cannot tell a genuine first admission from a lost ref; a real first admission arrives as a distinguished observation.",
          }
        FleetDesiredUndecodable { advertised: advertised } =>
          AdmissionRefused {
            cause: concat("fleet_desired_admission: the admitted prior was advertised but did not decode, so the prior is unknown rather than absent and no advance is authorized: ", advertised),
          }
        FleetDesiredAdmitted { revision: prior } =>
          match extdeps.git.object_store.git_object_id_from_untagged_hex(hex: event.head_sha as String) {
            Absent =>
              AdmissionRefused {
                cause: concat("fleet_desired_admission: floor run head_sha is not a decodable object id: ", event.head_sha as String),
              }
            Present { value: candidate } =>
              match gunbc.fleet_main_revision.admit_fleet_desired_advance(
                candidate: candidate,
                floor_green: fleet_desired_floor_green(conclusion: event.conclusion),
                current: Present { value: prior },
              ) {
                AdvanceRefused { cause: why } =>
                  AdmissionRefused {
                    cause: join([
                      why,
                      " [floor conclusion: ",
                      extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(conclusion: event.conclusion),
                      "; candidate: ",
                      event.head_sha as String,
                      "]",
                    ], ""),
                  }
                AdvanceAdmitted { from: _, to: admitted } =>
                  AdmissionAdvanceAuthorized { from: prior, to: admitted }
              }
          }
      }
  }
}

// ONE SCAFFOLD OBLIGATION COVERS THE RENDERER AND ITS EXECUTOR, because they are one
// independently removable unit: the renderer exists solely to feed that executor, both dissolve
// into the same typed git CAS realization, and neither has a useful life without the other. The
// predecessor this replaces (`gunbc.ci_spec` `gunbc_ci_advance_fleet_desired_script`) carried the
// same pair of rows; re-declaring them here is where the remaining shell actually lives.
//
// THIS ROW AUTHORIZES NOTHING. `std.disposition.Scaffold` records the temporary construction and
// its dissolution binding and says nothing about permission — the operator verdict is an external
// fact bound to the current head, and unmarked debt is not a way to defer it (it is marked debt's
// violation plus concealment). Declaring the population is what makes the verdict decidable.
data fleet_desired_authorized_push_shell_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.fleet_desired_admission",
    decl_name: "fleet_desired_authorized_push_script",
    field: std.decl_ref.WholeDeclaration
  }
}

data fleet_desired_authorized_push_shell_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: fleet_desired_authorized_push_script + gunbc.fleet_desired_admission_workflow fleet_desired_admission_push_step — the admitted advance is a model-rendered script executed by `sh`, because extdeps.git.publication_transport PushRefUpdate is shadow-only and models no --force-with-lease, so the compare-and-swap the authority requires has no typed carrier; DISSOLVES WHEN the SCM ref-update realization lands as a typed git CAS service op carrying the expected-prior operand (membership-diff spine classify_change SCM-ref arm) invoked via host_effect_apply, at which point the renderer and the sh step are deleted together")

// The authorized push, rendered from the decision's own operands. --force-with-lease names
// the observed prior as the expected value, so a concurrent admission refuses at the remote
// instead of silently overwriting — the compare-and-swap the authority requires, with the
// `from` side supplied by the gate rather than re-read by the shell.
fn fleet_desired_authorized_push_script(from: extdeps.git.object_store.GitObjectId, to: extdeps.git.object_store.GitObjectId) -> String {
  let from_hex = extdeps.git.object_store.git_object_id_wire_hex(oid: from) as String
  let to_hex = extdeps.git.object_store.git_object_id_wire_hex(oid: to) as String
  join([
    "set -eu\n",
    "git push --force-with-lease=", gunbc.fleet_main_revision.fleet_desired_ref_name, ":", from_hex,
    " origin ", to_hex, ":", gunbc.fleet_main_revision.fleet_desired_ref_name, "\n",
    "echo \"[fleet-desired] admitted ", from_hex, " -> ", to_hex, "\"\n",
  ], "")
}

func admit_fleet_desired_from_floor_event_wet() -> std.process.ProcessExit {
  match extdeps.github.workflow_run_event.workflow_run_event_from_event_path(path: fleet_desired_admission_event_payload_path) {
    WorkflowRunEventObserved { event: event } =>
      match fleet_desired_admission_decide(
        event: event,
        observed: gunbc.fleet_desired_observe.observe_fleet_desired_revision(repo: fleet_desired_admission_repo_root),
      ) {
        AdmissionRefused { cause: why } => std.process.exit_failure(reason: why)
        AdmissionAdvanceAuthorized { from: from_oid, to: to_oid } => {
          let wrote = extdeps.filesystem.filesystem_io.Filesystem.Write(
            path: fleet_desired_admission_authorized_push_path,
            content: fleet_desired_authorized_push_script(from: from_oid, to: to_oid),
          )
          if wrote.success {
            std.process.ExitSuccess
          } else {
            std.process.exit_failure(
              reason: join([
                "fleet_desired_admission: the advance was admitted but the authorized push could not be written to ",
                fleet_desired_admission_authorized_push_path,
                ": ",
                wrote.error,
              ], ""),
            )
          }
        }
      }
    WorkflowRunEventMemberAbsent { member: m } =>
      std.process.exit_failure(reason: concat("fleet_desired_admission: floor run event payload is missing a required member: ", m))
    WorkflowRunEventMemberMalformed { member: m, detail: d } =>
      std.process.exit_failure(reason: join(["fleet_desired_admission: floor run event member ", m, " is malformed: ", d], ""))
    WorkflowRunEventMalformed { detail: d } =>
      std.process.exit_failure(reason: concat("fleet_desired_admission: floor run event payload is malformed: ", d))
    WorkflowRunEventPayloadReadRefused { path: p, cause: c } =>
      std.process.exit_failure(reason: join(["fleet_desired_admission: floor run event payload could not be read at ", p, ": ", c], ""))
  }
}
