module gunbc.typecheck_store_ci_frontier

import std.types { NonEmptyStr }
import std.dissolution { DissolutionCondition, unbound_dissolution }

data typecheck_store_selector_ci_frontier: DissolutionCondition = unbound_dissolution(description: "CI NEVER EXERCISES THE DURABLE TYPECHECK STORE: no generated workflow sets typecheck_store_selector_env_name, so every CI compile reports not_configured and no lookup, hit or restore runs in CI beyond the unit witnesses; this change delivers no CI speedup until this is met. TRIGGER: a persistent store volume is attached to the runners at std.materialization_store_grant materialization_store_durable_root_path (the runner attempt launch attaches it) AND the compiler gate workflow sets the selector to typecheck_store_selector_admitted_value for its compiles. SUFFICIENT FOR: a required CI run whose receipt line reports hit greater than zero on a warm run. Retired by that capability and nothing else." as NonEmptyStr)
