module gunbc.plan

import std.markdown {
  MarkdownDocument, MarkdownBlock,
  HeadingBlock, ParagraphBlock,
  TextInline, H1, H2,
}
import extdeps.languages.markdown { serialize_markdown_source }
import std.types { NonEmptyStr }
import std.dissolution { DissolutionCondition, dissolution_description }

type PlanRetirement
  = PlanRetiresWhen { condition: DissolutionCondition }
  | PlanHasNoRetirement

// WHETHER THIS PLAN'S MARKDOWN IS A COMMITTED ARTIFACT AT ALL, declared by the plan and by
// nothing else.
//
// A plan carrier declares a slug, and the generated-artifact registry turned that slug into a
// committed path unconditionally -- so deleting a plan's markdown left the authority still
// producing it, and the registry kept offering a path for a file the repository had decided
// not to commit. That went unnoticed for exactly as long as nothing adjudicated the population.
// The moment a drift phase does, the absence stops the line and the cheapest way to clear it is
// to REGENERATE, which recreates content a commit deliberately removed: a dormant registry
// mistake converted into a standing obligation to resurrect deleted files, green either way.
//
// So the disposition is a declared fact on the plan rather than an inference from the tree.
// `PlanIsAuthorityOnly` carries the ruling that removed the projection, symbolically, so the
// row cannot drift from its reason; it is not an exemption list and not a shrink of the
// registry -- the plan is still rostered, still generated, still refused if generation fails.
// What changes is only whether its bytes are expected on disk.
type PlanProjection
  = PlanProjectsCommittedMarkdown
  | PlanIsAuthorityOnly { ruling: String }

type Plan {
  slug: String,
  title: String,
  body: List<MarkdownBlock>,
  retirement: PlanRetirement,
  projection: PlanProjection,
}

fn plan_h1(text: String) -> MarkdownBlock { HeadingBlock { level: H1, inlines: [TextInline { text: text }] } }
fn plan_h2(text: String) -> MarkdownBlock { HeadingBlock { level: H2, inlines: [TextInline { text: text }] } }
fn plan_p(text: String) -> MarkdownBlock { ParagraphBlock { inlines: [TextInline { text: text }] } }

fn plan_retirement_blocks(p: Plan) -> List<MarkdownBlock> {
  match p.retirement {
    PlanRetiresWhen { condition } =>
      [plan_h2(text: "Dissolution trigger (DESIGN §6)"), plan_p(text: dissolution_description(condition: condition))]
    PlanHasNoRetirement => []
  }
}

fn plan_to_blocks(p: Plan) -> List<MarkdownBlock> {
  concat(concat([plan_h1(text: p.title)], p.body), plan_retirement_blocks(p: p))
}

fn plan_to_document(p: Plan) -> MarkdownDocument {
  MarkdownDocument { blocks: plan_to_blocks(p: p) }
}

// Retained deliberately. The payload is now a DissolutionCondition, whose own
// literal-empty form is refused at construction, but refinement at NON-literal
// positions is still deferred -- so an empty description can still reach this
// carrier through that gap and this is the check that refuses it. It dissolves
// when nonliteral refinement enforcement is real, not before.
fn plan_has_retirement(p: Plan) -> Bool {
  match p.retirement {
    PlanRetiresWhen { condition: c } => dissolution_description(condition: c).length() > 0
    PlanHasNoRetirement => false
  }
}

fn plans_all_have_retirement(plans: List<Plan>) -> Bool {
  all(plans, p => plan_has_retirement(p: p))
}

fn plan_title_is_present(p: Plan) -> Bool {
  p.title.length() > 0
}

fn plans_all_titled(plans: List<Plan>) -> Bool {
  all(plans, p => plan_title_is_present(p: p))
}

fn plan_doc_path(slug: String) -> String {
  concat("docs/plans/", concat(slug, ".md"))
}

fn plan_path(p: Plan) -> String {
  plan_doc_path(slug: p.slug)
}

fn expected_plan_md(p: Plan) -> String {
  serialize_markdown_source(doc: plan_to_document(p: p))
}
