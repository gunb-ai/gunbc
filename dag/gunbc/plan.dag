module gunbc.plan

import std.markdown {
  MarkdownDocument, MarkdownBlock, MarkdownListItem, MarkdownInline,
  HeadingBlock, ParagraphBlock, UnorderedListBlock,
  TextInline, StrongInline, LinkInline, H1, H2,
}
import gunbc.plan_governance {
  PlanGovernance, AdmittedPlanGovernanceGraph, PlanGovernanceAdmission, GovernanceAdmitted, GovernanceRefused,
  plan_governance_admission, graph_parent_of, graph_children_of, plan_governance_role_label, governance_refusal_label,
}
import extdeps.languages.markdown { serialize_markdown_source }
import std.types { NonEmptyStr }
import std.dissolution { DissolutionCondition, dissolution_description }

type PlanRetirement
  = PlanRetiresWhen { condition: DissolutionCondition }
  | PlanHasNoRetirement

// WHETHER THIS PLAN'S MARKDOWN IS A COMMITTED ARTIFACT AT ALL, declared by the plan and by
// nothing else.
//
// The generated-artifact registry turned every plan slug into a committed path unconditionally,
// so deleting a plan's markdown left the authority still producing it and the registry offering a
// path the repository had decided not to commit. Unnoticed until a drift phase adjudicated the
// population; then the absence stops the line and the cheapest clearance is to REGENERATE content
// a commit deliberately removed -- a dormant registry mistake turned into a standing obligation
// to resurrect deleted files, green either way.
//
// So the disposition is a declared fact on the plan, not an inference from the tree.
// `PlanIsAuthorityOnly` carries the ruling that removed the projection, symbolically, so the row
// cannot drift from its reason; it is not an exemption list and not a shrink of the registry --
// the plan is still rostered, generated, and refused if generation fails. Only whether its bytes
// are expected on disk changes.
//
// `PlanProjectsDerivedMarkdown` is a committed projection part of whose body is DERIVED from the
// live tree rather than authored. The derivation is a nullary function so it runs where the bytes
// are generated and nowhere else: every reader of `all_plans` (the plan lens, the doc graph) would
// otherwise pay a namespace read to learn a title or a slug. It either renders its blocks, which
// follow the authored body, or refuses with a typed reason -- and a refusal refuses the artifact,
// so the drift gate goes red instead of committing a section the derivation could not stand
// behind.
type PlanProjection
  = PlanProjectsCommittedMarkdown
  | PlanProjectsDerivedMarkdown { derive: fn() -> PlanDerivation }
  | PlanIsAuthorityOnly { ruling: String }

type PlanDerivation
  = PlanDerived { blocks: List<MarkdownBlock> }
  | PlanDerivationRefused { reason: String }

type PlanGeneration
  = PlanGenerated { content: String }
  | PlanGenerationRefused { reason: String }

type Plan {
  slug: String,
  title: String,
  body: List<MarkdownBlock>,
  retirement: PlanRetirement,
  projection: PlanProjection,
}

fn plan_h1(text: String) -> MarkdownBlock { HeadingBlock { level: H1, inlines: [TextInline { text: text }] } }
fn plan_h2(text: String) -> MarkdownBlock { HeadingBlock { level: H2, inlines: [TextInline { text: text }] } }
fn plan_p(text: String) -> MarkdownBlock { ParagraphBlock { inlines: [TextInline { text: text }] } }

fn plan_retirement_blocks(p: Plan) -> List<MarkdownBlock> {
  match p.retirement {
    PlanRetiresWhen { condition } =>
      [plan_h2(text: "Dissolution trigger (DESIGN §6)"), plan_p(text: dissolution_description(condition: condition))]
    PlanHasNoRetirement => []
  }
}

// THE GOVERNANCE BANNER AND CHILDREN LIST ARE DERIVED, NEVER AUTHORED IN A BODY. The one authored
// fact is the gunbc.plan_governance row; a plan with no row and no children renders exactly as
// before, so every projection outside the compiler document graph is byte-identical.
fn plan_governance_link(slug: String) -> List<MarkdownInline> {
  [LinkInline { inlines: [TextInline { text: slug }], url: plan_doc_name(slug: slug) }]
}

fn plan_governed_by_blocks(p: Plan, graph: AdmittedPlanGovernanceGraph) -> List<MarkdownBlock> {
  match graph_parent_of(graph: graph, child: p.slug) {
    none => []
    Present { value: g } => [
      ParagraphBlock {
        inlines: concat(
          concat([StrongInline { inlines: [TextInline { text: "Governed by" }] }, TextInline { text: " " }], plan_governance_link(slug: g.governed_by_slug)),
          [TextInline { text: concat(concat(concat(" as a ", plan_governance_role_label(role: g.role)), concat(" of the stage: ", g.stage)), ". Derived from gunbc.plan_governance; the body restates none of it.") }]
        ),
      },
    ]
  }
}

fn plan_governs_item(g: PlanGovernance) -> MarkdownListItem {
  MarkdownListItem {
    blocks: [
      ParagraphBlock {
        inlines: concat(
          plan_governance_link(slug: g.plan_slug),
          [TextInline { text: concat(concat(concat(" -- ", plan_governance_role_label(role: g.role)), concat(": ", g.stage)), "") }]
        ),
      },
    ],
  }
}

fn plan_governs_blocks(p: Plan, graph: AdmittedPlanGovernanceGraph) -> List<MarkdownBlock> {
  let children = graph_children_of(graph: graph, parent: p.slug)
  let has_children = fold(children, init: false, f: (acc, g) => true)
  if has_children {
    [
      ParagraphBlock { inlines: [StrongInline { inlines: [TextInline { text: "Governs" }] }, TextInline { text: " (derived from gunbc.plan_governance):" }] },
      UnorderedListBlock { items: map(children, g => plan_governs_item(g: g)) },
    ]
  } else {
    []
  }
}

// EVERY PROJECTION CONSUMES THE ADMITTED GRAPH AND NOTHING ELSE. plan_generation refuses before this
// is reached when the governance relation is inadmissible, so no projection is ever rendered from a
// first match over raw rows.
fn plan_to_blocks(p: Plan, graph: AdmittedPlanGovernanceGraph, derived: List<MarkdownBlock>) -> List<MarkdownBlock> {
  concat(
    concat(concat(concat([plan_h1(text: p.title)], plan_governed_by_blocks(p: p, graph: graph)), plan_governs_blocks(p: p, graph: graph)), p.body),
    concat(derived, plan_retirement_blocks(p: p))
  )
}

fn plan_markdown(p: Plan, graph: AdmittedPlanGovernanceGraph, derived: List<MarkdownBlock>) -> String {
  serialize_markdown_source(doc: MarkdownDocument { blocks: plan_to_blocks(p: p, graph: graph, derived: derived) })
}

// Retained deliberately. The payload is a DissolutionCondition whose literal-empty form is refused
// at construction, but refinement at NON-literal positions is still deferred, so an empty
// description can still reach this carrier through that gap; this check refuses it. Dissolves when
// nonliteral refinement enforcement is real, not before.
fn plan_has_retirement(p: Plan) -> Bool {
  match p.retirement {
    PlanRetiresWhen { condition: c } => dissolution_description(condition: c).length() > 0
    PlanHasNoRetirement => false
  }
}

fn plans_all_have_retirement(plans: List<Plan>) -> Bool {
  all(plans, p => plan_has_retirement(p: p))
}

fn plan_title_is_present(p: Plan) -> Bool {
  p.title.length() > 0
}

fn plans_all_titled(plans: List<Plan>) -> Bool {
  all(plans, p => plan_title_is_present(p: p))
}

data plan_doc_directory: String = "docs/plans"

fn plan_doc_name(slug: String) -> String {
  concat(slug, ".md")
}

fn plan_doc_path(slug: String) -> String {
  concat(concat(plan_doc_directory, "/"), plan_doc_name(slug: slug))
}

fn plan_path(p: Plan) -> String {
  plan_doc_path(slug: p.slug)
}

// A PlanIsAuthorityOnly row is still a plan; it is not a document-graph root. Extra roots
// naming a path that is not in the docs universe are counted, not silently dropped
// (cli_run build_doc_graph_report). Including authority-only slugs as roots made
// doc_graph_registered_plan_roots_all_admitted permanently red after #9635 deleted those
// markdown projections — the same class as a HandAuthoredDocBind whose slug has no file.
fn plan_projects_committed_markdown(p: Plan) -> Bool {
  match p.projection {
    PlanProjectsCommittedMarkdown => true
    PlanProjectsDerivedMarkdown { derive: _ } => true
    PlanIsAuthorityOnly { ruling: _ } => false
  }
}

// A PLAN WHOSE GOVERNANCE IS AMBIGUOUS IS NOT PROJECTED. Two rows for one slug would render a
// banner naming one parent while two parents' children lists claimed the child; refusing here is
// what keeps the derived presentation consistent with the one authored relation.
fn plan_generation(p: Plan) -> PlanGeneration {
  match plan_governance_admission {
    GovernanceRefused { refusals } =>
      PlanGenerationRefused {
        reason: concat(
          concat(concat("plan ", p.slug), " is not projected: gunbc.plan_governance is not an admitted graph -- "),
          fold(refusals, init: "", f: (acc, r) => concat(concat(acc, governance_refusal_label(r: r)), "; "))
        ),
      }
    GovernanceAdmitted { graph } => plan_generation_admitted(p: p, graph: graph)
  }
}

fn plan_generation_admitted(p: Plan, graph: AdmittedPlanGovernanceGraph) -> PlanGeneration {
  match p.projection {
    PlanProjectsDerivedMarkdown { derive } =>
      match derive() {
        PlanDerived { blocks } => PlanGenerated { content: plan_markdown(p: p, graph: graph, derived: blocks) }
        PlanDerivationRefused { reason } =>
          PlanGenerationRefused { reason: concat(concat(concat("plan ", p.slug), " refused its derived section: "), reason) }
      }
    PlanProjectsCommittedMarkdown => PlanGenerated { content: plan_markdown(p: p, graph: graph, derived: []) }
    PlanIsAuthorityOnly { ruling: _ } => PlanGenerated { content: plan_markdown(p: p, graph: graph, derived: []) }
  }
}
