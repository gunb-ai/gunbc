// READ-ONLY measurement (parent msg_e767a783): before anyone grants new access, measure
// whether the fleet key is already enrolled for SOME pre-existing account on srv3/srv4.
// gunbc-fleet@srv3/srv4 refusing proves only that the account we just invented is not
// there — it says nothing about accounts that existed at OOBE (the Sparks carried the
// fleet key for a pre-existing account). This probes the SAME in-run WIF-materialized
// key against ALTERNATIVE principals. NO WRITES, no account creation: each leg is a
// hostname read (command reach) and a `sudo -n -l` (grant listing without prompting).
// Every leg's outcome is DATA, classified into a typed arm, never a step failure.
// srv5/srv6 ADDED (2026-08-10). They belong here on the module's own rationale: the comment above
// cites the Sparks as the REASON this probe exists -- "the Sparks carried the fleet key for a
// pre-existing account" -- while the population it measured was srv3/srv4, so the two hosts the
// argument is about were the two it never asked about. Their endpoints were already modeled
// (fleet_reach_endpoint resolves srv5/srv6 by address because those names are not resolvable), and
// fleet_reach_probe_targets already carries all six, so this row was the only place the Sparks
// were missing.
//
// This is the observation that lets gunbc.fleet_converge_cli's spark_managed_access_standing stop
// returning a hardcoded SparkManagedAccessAbsent whose cause claims it measured the host. It is
// safe to widen because the probe is READ-ONLY by construction -- a hostname read and `sudo -n -l`
// per leg, every outcome classified as data rather than a step failure -- so it manufactures none
// of the runner obligations host_assimilation_program forbids crossing a Spark with.
//
// It also replaces work rather than adding any: the deleted spark-canary-probe.yml asked exactly
// this question in hand-authored shell, against this same principal list, and a hand-written
// workflow is hand-applying (operator ruling, 2026-08-10).
data multi_principal_probe_hosts: List<String> = ["srv3", "srv4", "srv5", "srv6"]

data multi_principal_probe_principals: List<String> = ["ubuntu", "briansrls", "ghrunner", "root", "gunbc-automation"]

data fleet_multi_principal_probe_receipt_path: String = "target/fleet-multi-principal-probe-receipt.txt"

// One leg's line: authentication accepted/refused, and if accepted whether a command
// executed (shell present) — with the observed values carried, never a bare verdict.
// ONE LEG, and every option it carries derived from the sealed context rather than assembled here.
// The words go through portable_remote_words, so a command this probe cannot transport safely
// refuses before the leg rather than being quoted into something the remote shell may re-split.
fn probe_leg(context: FleetSshExecutionContext, host: String, principal: String, raw_words: List<String>) -> SshSessionExecResult? {
  match portable_remote_words(raws: raw_words) {
    Absent => none
    Present { value: words } => Present {
      value: ssh_session_exec_portable_words(
        client_args: shape_fleet_ssh_exec(
          context: context,
          target: SshTarget {
            endpoint: fleet_probe_endpoint_for(host: host) as NonEmptyStr,
            principal: principal as NonEmptyStr,
          },
          words: words,
        ),
      ),
    }
  }
}

fn multi_principal_reach_line(context: FleetSshExecutionContext, host: String, principal: String) -> String {
  match probe_leg(context: context, host: host, principal: principal, raw_words: ["hostname"]) {
    Absent => join(["reach host=", host, " principal=", principal, " probe-refused cause=non-portable-remote-word\n"], "")
    Present { value: r } =>
      if r.success {
        join(["reach host=", host, " principal=", principal, " auth=accepted command=executed hostname=", trim(s: r.stdout), "\n"], "")
      } else {
        join(["reach host=", host, " principal=", principal, " auth-or-command=refused stderr=", trim(s: r.stderr), " stdout=", trim(s: r.stdout), "\n"], "")
      }
  }
}

fn multi_principal_sudo_line(context: FleetSshExecutionContext, host: String, principal: String) -> String {
  match probe_leg(context: context, host: host, principal: principal, raw_words: ["sudo", "-n", "-l"]) {
    Absent => join(["sudo  host=", host, " principal=", principal, " probe-refused cause=non-portable-remote-word\n"], "")
    Present { value: r } =>
      if r.success {
        join(["sudo  host=", host, " principal=", principal, " sudo-n-l=listed grants=", trim(s: r.stdout), "\n"], "")
      } else {
        join(["sudo  host=", host, " principal=", principal, " sudo-n-l=refused stderr=", trim(s: r.stderr), "\n"], "")
      }
  }
}

fn multi_principal_host_block(context: FleetSshExecutionContext, host: String) -> String {
  join(
    map(multi_principal_probe_principals, p =>
      join([multi_principal_reach_line(context: context, host: host, principal: p), multi_principal_sudo_line(context: context, host: host, principal: p)], "")),
    "")
}

fn probe_attempt_identity(raw: String) -> FleetSshAttemptIdentity? {
  fleet_ssh_attempt_identity(raw: raw)
}

// Fleet SSH private key material resolves inside this boundary from Secret Manager — never as an
// argv-passed identity_file path.
func fleet_multi_principal_probe_wet(attempt_raw: String) -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  let token_source = GcloudPrintToken
  match materialize_fleet_ssh_credential_binding(
    attempt_raw: attempt_raw,
    token_source: token_source,
  ) {
    FleetSshCredentialMaterializationRefused { reason: reason } =>
      exit_failure(reason: reason as String)
    FleetSshCredentialMaterialized { binding: credential } => {
      let identity_file = credential.identity_file as String
      let body = match probe_attempt_identity(raw: attempt_raw) {
        Absent =>
          join(["multi-principal fleet-key probe probed_at=", now as String, " REFUSED before any ssh leg: attempt identity is not a safe path segment\n"], "")
        Present { value: attempt } => {
          let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
          match fleet_ssh_execution_context_of(outcome: materialization, credential: credential) {
            Absent => join([
              "multi-principal fleet-key probe probed_at=", now as String,
              " REFUSED before any ssh leg: ", known_hosts_materialization_receipt(outcome: materialization), "\n",
            ], "")
            Present { value: context } => join([
              join(["multi-principal fleet-key probe probed_at=", now as String, " (read-only: hostname + sudo -n -l)\n"], ""),
              known_hosts_materialization_receipt(outcome: materialization),
              join(["credential identity_file=", identity_file, " public_material_identity=", serialize_content_hash(hash: credential.credential_identity) as String, " agent=suppressed ambient_config=suppressed\n"], ""),
              join(map(multi_principal_probe_hosts, h => multi_principal_host_block(context: context, host: h)), ""),
            ], "")
          }
        }
      }
      let w = Filesystem.Write(path: fleet_multi_principal_probe_receipt_path, content: body)
      if w.success {
        ExitSuccess
      } else {
        exit_failure(reason: join(["multi-principal probe receipt write failed: ", w.error], ""))
      }
    }
  }
}


// ── The derived standing, from the same legs the receipt above reports ──────────────────────────

// One typed observation per (host, principal), which is the grain the account model already uses.
// The credential identity rides every row, so a reader can tell WHICH key produced the result rather
// than inferring it from the run that happened to be executing.
fn principal_observation(
  context: FleetSshExecutionContext,
  credential_identity: ContentHash,
  host: String,
  principal: String,
) -> PrincipalReachObservation {
  let reach = probe_leg(context: context, host: host, principal: principal, raw_words: ["hostname"])
  let sudo = probe_leg(context: context, host: host, principal: principal, raw_words: ["sudo", "-n", "-l"])
  PrincipalReachObservation {
    host: host as HostIdentity,
    principal_login_name: principal as NonEmptyStr,
    credential_identity: credential_identity,
    authenticated: match reach { Present { value: r } => r.success Absent => false },
    passwordless_privilege: match sudo { Present { value: r } => r.success Absent => false },
  }
}

fn spark_standing_line(standing: SparkManagedAccessStanding) -> String {
  match standing {
    ManagedAccessGrounded { occurrence: o } =>
      join(["standing host=", o.host as String, " managed-access=GROUNDED\n"], "")
    ManagedAccessBootstrapRequired { host: h, missing: _, bootstrap_transport: _ } =>
      join(["standing host=", h as String, " managed-access=BOOTSTRAP-REQUIRED (human bootstrap observed, managed executor absent)\n"], "")
    ManagedAccessUnobserved { host: h } =>
      join(["standing host=", h as String, " managed-access=UNOBSERVED (no reachable principal, so no transport to bootstrap through)\n"], "")
  }
}

// The authorization is DERIVED and printed, never asked. What reaches the operator is the exact
// effect population requiring privilege -- not the question "does this need root", which nobody can
// evaluate without the list.
fn spark_authorization_lines(standing: SparkManagedAccessStanding, credential_identity: ContentHash) -> String {
  match derive_spark_bootstrap_plan(standing: standing, fleet_public_material_identity: credential_identity) {
    Absent => ""
    Present { value: plan } => {
      let effects = join(map(spark_bootstrap_plan_effects(plan: plan), e =>
        join(["  effect ", spark_bootstrap_effect_label(effect: e), "\n"], "")), "")
      match authorize_spark_bootstrap(plan: plan) {
        BootstrapProceedsUnprivileged { plan: _ } =>
          join(["authorization host=", plan.host as String, " UNPRIVILEGED\n", effects], "")
        OperatorBootstrapCredentialRequired { host: h, first_privileged: f, more_privileged: m, secret_purpose: p } =>
          join([
            "authorization host=", h as String, " OPERATOR-CREDENTIAL-REQUIRED privileged_effects=",
            to_string(1 + length(m)), "\n  purpose ", p as String, "\n", effects,
            "  first-privileged ", spark_bootstrap_effect_label(effect: f), "\n",
          ], "")
      }
    }
  }
}

data spark_standing_receipt_path: String = "target/spark-managed-access-standing-receipt.txt"

// The Spark hosts only: this derivation is about the serving fleet, and running it over srv1..srv4
// would produce bootstrap plans for hosts whose managed access is a different lane's question.
data spark_standing_hosts: List<String> = ["srv5", "srv6"]

func spark_managed_access_standing_wet(attempt_raw: String) -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  let token_source = GcloudPrintToken
  match materialize_fleet_ssh_credential_binding(
    attempt_raw: attempt_raw,
    token_source: token_source,
  ) {
    FleetSshCredentialMaterializationRefused { reason: reason } =>
      exit_failure(reason: reason as String)
    FleetSshCredentialMaterialized { binding: credential } => {
      let body = match probe_attempt_identity(raw: attempt_raw) {
        Absent => "spark managed-access standing REFUSED: attempt identity is not a safe path segment\n"
        Present { value: attempt } => {
          let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
          match fleet_ssh_execution_context_of(outcome: materialization, credential: credential) {
            Absent => join([
              "spark managed-access standing REFUSED before any ssh leg: ",
              known_hosts_materialization_receipt(outcome: materialization), "\n",
            ], "")
            Present { value: context } => {
              let observations = flat_map(spark_standing_hosts, h =>
                map(multi_principal_probe_principals, p =>
                  principal_observation(
                    context: context,
                    credential_identity: credential.credential_identity,
                    host: h,
                    principal: p,
                  )))
              join([
                join(["spark managed-access standing probed_at=", now as String,
                      " credential_identity=", serialize_content_hash(hash: credential.credential_identity) as String, "\n"], ""),
                join(map(observations, o => join([
                  "observed host=", o.host as String, " principal=", o.principal_login_name as String,
                  " authenticated=", if o.authenticated { "true" } else { "false" },
                  " passwordless_privilege=", if o.passwordless_privilege { "true" } else { "false" }, "\n",
                ], "")), ""),
                join(map(spark_standing_hosts, h => {
                  let standing = derive_spark_managed_access_standing(host: h as HostIdentity, observations: observations)
                  join([
                    spark_standing_line(standing: standing),
                    spark_authorization_lines(standing: standing, credential_identity: credential.credential_identity),
                  ], "")
                }), ""),
              ], "")
            }
          }
        }
      }
      let w = Filesystem.Write(path: spark_standing_receipt_path, content: body)
      if !w.success {
        exit_failure(reason: join(["spark standing receipt write failed: ", w.error], ""))
      } else {
        if string_contains(s: body, pattern: "REFUSED") {
          exit_failure(reason: join(["spark managed-access standing could not be observed:\n", body], ""))
        } else {
          ExitSuccess
        }
      }
    }
  }
}
