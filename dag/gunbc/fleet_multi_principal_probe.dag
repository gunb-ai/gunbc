module gunbc.fleet_multi_principal_probe


// READ-ONLY measurement (parent msg_e767a783): before anyone grants new access, measure
// whether the fleet key is already enrolled for SOME pre-existing account on srv3/srv4.
// gunbc-fleet@srv3/srv4 refusing proves only that the account we just invented is not
// there — it says nothing about accounts that existed at OOBE (the Sparks carried the
// fleet key for a pre-existing account). This probes the SAME in-run WIF-materialized
// key against ALTERNATIVE principals. NO WRITES, no account creation: each leg is a
// hostname read (command reach) and a `sudo -n -l` (grant listing without prompting).
// Every leg's outcome is DATA, classified into a typed arm, never a step failure.
// srv5/srv6 ADDED (2026-08-10). They belong here on the module's own rationale: the comment above
// cites the Sparks as the REASON this probe exists -- "the Sparks carried the fleet key for a
// pre-existing account" -- while the population it measured was srv3/srv4, so the two hosts the
// argument is about were the two it never asked about. Their endpoints were already modeled
// (fleet_reach_endpoint resolves srv5/srv6 by address because those names are not resolvable), and
// fleet_reach_probe_targets already carries all six, so this row was the only place the Sparks
// were missing.
//
// This is the observation that lets gunbc.fleet_converge_cli's spark_managed_access_standing stop
// returning a hardcoded SparkManagedAccessAbsent whose cause claims it measured the host. It is
// safe to widen because the probe is READ-ONLY by construction -- a hostname read and `sudo -n -l`
// per leg, every outcome classified as data rather than a step failure -- so it manufactures none
// of the runner obligations host_assimilation_program forbids crossing a Spark with.
//
// It also replaces work rather than adding any: the deleted spark-canary-probe.yml asked exactly
// this question in hand-authored shell, against this same principal list, and a hand-written
// workflow is hand-applying (operator ruling, 2026-08-10).
data multi_principal_probe_hosts: List<String> = ["srv3", "srv4", "srv5", "srv6"]

data multi_principal_probe_principals: List<String> = ["ubuntu", "briansrls", "ghrunner", "root", "gunbc-automation"]

data fleet_multi_principal_probe_receipt_path: String = "target/fleet-multi-principal-probe-receipt.txt"

// One leg's line: authentication accepted/refused, and if accepted whether a command
// executed (shell present) — with the observed values carried, never a bare verdict.
// ONE LEG, and every option it carries derived from the sealed context rather than assembled here.
// The words go through portable_remote_words, so a command this probe cannot transport safely
// refuses before the leg rather than being quoted into something the remote shell may re-split.
fn probe_leg(context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext, host: String, principal: String, raw_words: List<String>) -> extdeps.ssh.session.SshSessionExecResult? {
  match gunbc.fleet_known_hosts_anchor.portable_remote_words(raws: raw_words) {
    Absent => none
    Present { value: words } => Present {
      value: extdeps.ssh.session.ssh_session_exec_portable_words(
        client_args: gunbc.fleet_known_hosts_anchor.shape_fleet_ssh_exec(
          context: context,
          target: gunbc.fleet_known_hosts_anchor.SshTarget {
            endpoint: gunbc.fleet_reach_endpoint.fleet_probe_endpoint_for(host: host) as std.types.NonEmptyStr,
            principal: principal as std.types.NonEmptyStr,
          },
          words: words,
        ),
      ),
    }
  }
}

fn multi_principal_reach_line(context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext, host: String, principal: String) -> String {
  match probe_leg(context: context, host: host, principal: principal, raw_words: ["hostname"]) {
    Absent => join(["reach host=", host, " principal=", principal, " probe-refused cause=non-portable-remote-word\n"], "")
    Present { value: r } =>
      if r.success {
        join(["reach host=", host, " principal=", principal, " auth=accepted command=executed hostname=", std.algebra.trim(s: r.stdout), "\n"], "")
      } else {
        join(["reach host=", host, " principal=", principal, " auth-or-command=refused stderr=", std.algebra.trim(s: r.stderr), " stdout=", std.algebra.trim(s: r.stdout), "\n"], "")
      }
  }
}

fn multi_principal_sudo_line(context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext, host: String, principal: String) -> String {
  match probe_leg(context: context, host: host, principal: principal, raw_words: ["sudo", "-n", "-l"]) {
    Absent => join(["sudo  host=", host, " principal=", principal, " probe-refused cause=non-portable-remote-word\n"], "")
    Present { value: r } =>
      if r.success {
        join(["sudo  host=", host, " principal=", principal, " sudo-n-l=listed grants=", std.algebra.trim(s: r.stdout), "\n"], "")
      } else {
        join(["sudo  host=", host, " principal=", principal, " sudo-n-l=refused stderr=", std.algebra.trim(s: r.stderr), "\n"], "")
      }
  }
}

fn multi_principal_host_block(context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext, host: String) -> String {
  join(
    map(multi_principal_probe_principals, p =>
      join([multi_principal_reach_line(context: context, host: host, principal: p), multi_principal_sudo_line(context: context, host: host, principal: p)], "")),
    "")
}

// CI / in-run agent path: reuses SSH_AUTH_SOCK from gunbc_ci_fleet_key_agent_script — no Secret
// Manager fetch and no GcloudPrintToken (those hosts do not carry gcloud).
fn multi_principal_reach_line_agent_backed(host: String, principal: String) -> String {
  let target = join([principal, "@", gunbc.fleet_reach_endpoint.fleet_probe_endpoint_for(host: host)], "")
  match gunbc.typed_argv_exec.typed_argv_probe_over_ssh(host: target as std.types.NonEmptyStr, argv: ["hostname"]) {
    TypedArgvExecConverged { result: r } =>
      if r.success {
        join(["reach host=", host, " principal=", principal, " auth=accepted command=executed hostname=", std.algebra.trim(s: r.stdout), "\n"], "")
      } else {
        join(["reach host=", host, " principal=", principal, " auth-or-command=refused stderr=", std.algebra.trim(s: r.stderr), " stdout=", std.algebra.trim(s: r.stdout), "\n"], "")
      }
    TypedArgvExecRefused { reason: why } =>
      join(["reach host=", host, " principal=", principal, " probe-refused cause=", why, "\n"], "")
  }
}

fn multi_principal_sudo_line_agent_backed(host: String, principal: String) -> String {
  let target = join([principal, "@", gunbc.fleet_reach_endpoint.fleet_probe_endpoint_for(host: host)], "")
  match gunbc.typed_argv_exec.typed_argv_probe_over_ssh(host: target as std.types.NonEmptyStr, argv: ["sudo", "-n", "-l"]) {
    TypedArgvExecConverged { result: r } =>
      if r.success {
        join(["sudo  host=", host, " principal=", principal, " sudo-n-l=listed grants=", std.algebra.trim(s: r.stdout), "\n"], "")
      } else {
        join(["sudo  host=", host, " principal=", principal, " sudo-n-l=refused stderr=", std.algebra.trim(s: r.stderr), "\n"], "")
      }
    TypedArgvExecRefused { reason: why } =>
      join(["sudo  host=", host, " principal=", principal, " probe-refused cause=", why, "\n"], "")
  }
}

fn multi_principal_host_block_agent_backed(host: String) -> String {
  join(
    map(multi_principal_probe_principals, p =>
      join([
        multi_principal_reach_line_agent_backed(host: host, principal: p),
        multi_principal_sudo_line_agent_backed(host: host, principal: p),
      ], "")),
    "")
}

// THE AGENT THIS RUN AUTHENTICATES THROUGH, named rather than inherited. `ssh-add -l` is asked
// against this exact socket, so "the agent holds the fleet key" is a claim about a socket the receipt
// can carry, not about whatever `SSH_AUTH_SOCK` happened to be when the process started.
fn probe_agent_socket() -> std.types.NonEmptyStr? {
  match shell.Env.Get(name: "SSH_AUTH_SOCK" as std.types.NonEmptyStr).value {
    Present { value: raw } => if std.algebra.trim(s: raw) == "" { none } else { Present { value: std.algebra.trim(s: raw) as std.types.NonEmptyStr } }
    Absent => none
  }
}

// The public key file that selects the fleet identity out of the agent. Not a secret, and not what
// authenticates -- see `openssh_exact_agent_credential_options`. It is named here so the binding this
// probe verifies is the same binding an exact transport would carry.

// The verification, replacing `modeled_fleet_automation_credential_identity`. That function hashed
// the DECLARED material and stamped it onto every `PrincipalReachObservation`, so the receipt's
// `credential_identity` was an assertion about which key authenticated that nothing had observed --
// the same defect `gunbc.fleet_ssh_credential_verify` closed on the identity-file route, present a
// second time on this one. The identity now comes from a binding that exists only because the agent
// was observed to hold the declared fingerprint.
func probe_agent_credential_verification(attempt: gunbc.fleet_known_hosts_anchor.FleetSshAttemptIdentity) -> gunbc.fleet_ssh_credential_verify.FleetSshCredentialVerification
  uses net: std.resources.Network
{
  match probe_agent_socket() {
    Absent =>
      gunbc.fleet_ssh_credential_verify.FleetSshCredentialDerivationRefused {
        cause: "SSH_AUTH_SOCK is unset or empty: this run has no named agent to verify the fleet credential against",
      }
    Present { value: sock } =>
      match gunbc.fleet_ssh_credential_verify.materialize_agent_public_selector(attempt: attempt, key: gunbc.fleet_ssh_access.fleet_automation_ssh_key) {
        AgentSelectorRefused { cause: cause } => gunbc.fleet_ssh_credential_verify.FleetSshCredentialDerivationRefused { cause: cause }
        AgentSelectorMaterialized { selector: selector } =>
          gunbc.fleet_ssh_credential_verify.verify_fleet_ssh_agent_credential(
            agent_socket: sock,
            selector: selector,
            expected_key: gunbc.fleet_ssh_access.fleet_automation_ssh_key,
            expected_fingerprint: gunbc.fleet_ssh_access.fleet_automation_ssh_key_fingerprint as std.types.NonEmptyStr,
          )
      }
  }
}

fn agent_backed_probe_success(host: String, principal: String, argv: List<String>) -> Bool {
  let target = join([principal, "@", gunbc.fleet_reach_endpoint.fleet_probe_endpoint_for(host: host)], "")
  match gunbc.typed_argv_exec.typed_argv_probe_over_ssh(host: target as std.types.NonEmptyStr, argv: argv) {
    TypedArgvExecConverged { result: r } => r.success
    TypedArgvExecRefused { reason: _ } => false
  }
}

fn agent_backed_principal_observation(
  credential_identity: std.content_hash.ContentHash,
  host: String,
  principal: String,
) -> gunbc.spark_managed_access_bootstrap.PrincipalReachObservation {
  gunbc.spark_managed_access_bootstrap.PrincipalReachObservation {
    host: host as product.placement_supply.HostIdentity,
    principal_login_name: principal as std.types.NonEmptyStr,
    credential_identity: credential_identity,
    authenticated: agent_backed_probe_success(host: host, principal: principal, argv: ["hostname"]),
    holds_any_passwordless_grant: agent_backed_probe_success(host: host, principal: principal, argv: ["sudo", "-n", "-l"]),
  }
}

fn probe_attempt_identity(raw: String) -> gunbc.fleet_known_hosts_anchor.FleetSshAttemptIdentity? {
  gunbc.fleet_known_hosts_anchor.fleet_ssh_attempt_identity(raw: raw)
}

fn env_var_nonempty(name: std.types.NonEmptyStr) -> String? {
  match shell.Env.Get(name: name).value {
    Present { value: raw } => {
      let line = std.algebra.trim(s: raw)
      if line == "" { none } else { Present { value: line } }
    }
    Absent => none
  }
}

fn compose_fleet_ssh_attempt_raw(run_id: String, run_attempt: String) -> String? {
  if run_id == "" || run_attempt == "" {
    none
  } else {
    Present { value: join(["run-", run_id, "-attempt-", run_attempt], "") }
  }
}

// ENV OBSERVATION lives here because gunbc run --function cannot pass argv (belt_dispatch note).
// GUNBC_FLEET_SSH_ATTEMPT_RAW overrides; otherwise GITHUB_RUN_ID + GITHUB_RUN_ATTEMPT compose
// run-<id>-attempt-<n>, the same shape fleet_known_hosts_anchor witnesses pin.
fn fleet_ssh_attempt_raw_from_env() -> String? {
  match env_var_nonempty(name: "GUNBC_FLEET_SSH_ATTEMPT_RAW" as std.types.NonEmptyStr) {
    Present { value: explicit } => Present { value: explicit }
    Absent =>
      match env_var_nonempty(name: "GITHUB_RUN_ID" as std.types.NonEmptyStr) {
        Absent => none
        Present { value: run_id } =>
          match env_var_nonempty(name: "GITHUB_RUN_ATTEMPT" as std.types.NonEmptyStr) {
            Absent => none
            Present { value: run_attempt } =>
              compose_fleet_ssh_attempt_raw(run_id: run_id, run_attempt: run_attempt)
          }
      }
  }
}

data spark_converge_target_env_name: std.types.NonEmptyStr = "SPARK_CONVERGE_TARGET"

data spark_converge_execute_env_name: std.types.NonEmptyStr = "SPARK_CONVERGE_EXECUTE"

// TARGET SELECTION REFUSES; IT NEVER WIDENS. The earlier reader returned HostIdentity?
// and its consumer read Absent as "every enrolled Spark", which fused three different
// states onto one arm: no target requested, an unrecognized target, and an actuating run
// with no target at all. On the observing path that is merely imprecise; on the actuating
// path it is DESIGN section 5's absorbing fallback with effects — SPARK_CONVERGE_EXECUTE is
// set unconditionally by the emitted step and the workflow's target input is optional, so a
// dispatch that omitted or misspelled the target would have run enable-linger against BOTH
// Sparks while reporting a normal converge. Widening is never the answer to not knowing.
type SparkConvergeTargetSelection =
    SparkConvergeTargetSingle { host: product.placement_supply.HostIdentity }
  | SparkConvergeTargetAllObserveOnly
  | SparkConvergeTargetRefused { reason: String }

fn spark_converge_target_selection(execute_apply: Bool) -> SparkConvergeTargetSelection {
  spark_converge_target_selection_of(
    raw: env_var_nonempty(name: spark_converge_target_env_name),
    execute_apply: execute_apply,
  )
}

// The decision, separated from the environment read so it is witnessable at all. A rule
// that can only be exercised by setting a process env var is a rule no hermetic witness
// can hold, which is how the widening arm survived unnoticed in the first place.
fn spark_converge_target_selection_of(
  raw: std.types.NonEmptyStr?,
  execute_apply: Bool,
) -> SparkConvergeTargetSelection {
  match raw {
    Present { value: raw } =>
      if raw == "srv5" {
        SparkConvergeTargetSingle { host: gunbc.fleet_intent_network.operator_host_srv5 }
      } else if raw == "srv6" {
        SparkConvergeTargetSingle { host: gunbc.fleet_intent_network.operator_host_srv6 }
      } else {
        SparkConvergeTargetRefused {
          reason: join([
            "SPARK_CONVERGE_TARGET names no enrolled Spark target (expected srv5 or srv6): ",
            raw as String,
          ], ""),
        }
      }
    Absent =>
      if execute_apply {
        SparkConvergeTargetRefused {
          reason: "SPARK_CONVERGE_EXECUTE=1 with no SPARK_CONVERGE_TARGET — refusing rather than actuating against every enrolled Spark",
        }
      } else {
        SparkConvergeTargetAllObserveOnly
      }
  }
}

fn spark_converge_execute_apply_from_env() -> Bool {
  match env_var_nonempty(name: spark_converge_execute_env_name) {
    Present { value: v } => v == "1"
    Absent => false
  }
}

// Enrolled CI entry (gunbc_ci_multi_principal_probe_invoke): reuses the in-run WIF ssh-agent from
// gunbc_ci_fleet_key_agent_script — NOT a Secret Manager fetch and NOT GcloudPrintToken.
func fleet_multi_principal_probe_wet() -> std.process.ProcessExit {
  let now = gunbc.clock_read.clock_now_probed_at()
  let body = join([
    join([
      "multi-principal fleet-key probe probed_at=", now as String,
      " (read-only: hostname + sudo -n -l; in-run ssh-agent from WIF key materialization)\n",
    ], ""),
    join(map(multi_principal_probe_hosts, h => multi_principal_host_block_agent_backed(host: h)), ""),
  ], "")
  let w = Filesystem.Write(path: fleet_multi_principal_probe_receipt_path, content: body)
  if w.success {
    std.process.ExitSuccess
  } else {
    std.process.exit_failure(reason: join(["multi-principal probe receipt write failed: ", w.error], ""))
  }
}

// Operator-workstation wet path: materializes fleet privkey from Secret Manager inside the workflow
// boundary (trusted anchor + exact IdentityFile). NOT valid on GHA runner slots — use
// fleet_multi_principal_probe_wet for CI.
func fleet_multi_principal_probe_with_attempt(attempt_raw: String) -> std.process.ProcessExit
  uses net: std.resources.Network
{
  let now = gunbc.clock_read.clock_now_probed_at()
  let token_source = gunbc.auth.access_token_source.GcloudPrintToken
  gunbc.spark_credential_workflow.run_with_materialized_fleet_ssh_binding(
    attempt_raw: attempt_raw,
    token_source: token_source,
    body: fn(credential) {
      let credential_locus = gunbc.fleet_known_hosts_anchor.fleet_ssh_credential_locus_label(binding: credential)
      let body = match probe_attempt_identity(raw: attempt_raw) {
        Absent =>
          join(["multi-principal fleet-key probe probed_at=", now as String, " REFUSED before any ssh leg: attempt identity is not a safe path segment\n"], "")
        Present { value: attempt } => {
          let materialization = gunbc.fleet_known_hosts_anchor.materialize_fleet_known_hosts_anchor(attempt: attempt)
          match gunbc.fleet_known_hosts_anchor.fleet_ssh_execution_context_of(outcome: materialization, credential: credential) {
            Absent => join([
              "multi-principal fleet-key probe probed_at=", now as String,
              " REFUSED before any ssh leg: ", gunbc.fleet_known_hosts_anchor.known_hosts_materialization_receipt(outcome: materialization), "\n",
            ], "")
            Present { value: context } => join([
              join(["multi-principal fleet-key probe probed_at=", now as String, " (read-only: hostname + sudo -n -l)\n"], ""),
              gunbc.fleet_known_hosts_anchor.known_hosts_materialization_receipt(outcome: materialization),
              join(["credential ", credential_locus, " public_material_identity=", std.content_hash.serialize_content_hash(hash: gunbc.fleet_known_hosts_anchor.fleet_ssh_credential_identity(binding: credential)) as String, " ambient_config=suppressed\n"], ""),
              join(map(multi_principal_probe_hosts, h => multi_principal_host_block(context: context, host: h)), ""),
            ], "")
          }
        }
      }
      let w = Filesystem.Write(path: fleet_multi_principal_probe_receipt_path, content: body)
      if w.success {
        std.process.ExitSuccess
      } else {
        std.process.exit_failure(reason: join(["multi-principal probe receipt write failed: ", w.error], ""))
      }
    },
  )
}


// THE EXACT GRANT, enumerated rather than reduced. holds_any_passwordless_grant answers "is there
// ANY nopasswd entry", which is what `sudo -n -l` succeeding means -- and reading that as "this
// account can act privileged" is the conflation this block exists to repair. A serving install must
// join against the POPULATION of permitted commands, so the receipt reports sudo's stdout verbatim
// and reduces nothing.
data spark_grant_probe_receipt_path: String = "target/spark-exact-grant-probe-receipt.txt"

// ONE TYPED OUTCOME PER HOST. An earlier revision of this probe decided its exit status with
// string_contains(body, "REFUSED") -- the prose-decision defect this same PR removes from the apply
// path, reintroduced here (review 51704). It was worse than the one it copied: the refused-leg arm
// spells "probe-refused" in lower case, which does not contain "REFUSED", so a leg that never ran
// exited 0. The receipt is now a PROJECTION of these variants rather than the thing decided upon.
type SparkGrantOutcome
  = GrantEnumerated { listing: String }
  | GrantAbsent { detail: String }
  | GrantProbeRefused { cause: String }

type SparkGrantRow {
  host: String
  principal: String
  outcome: SparkGrantOutcome
}

// Head-plus-tail: a grant probe that observed no host has no constructor, because "every host is
// clean" and "nothing was asked" must not share a representation.
type SparkGrantReport
  = GrantsObserved { first: SparkGrantRow, more: List<SparkGrantRow> }
  | GrantProbeNotAttempted { cause: String }

fn spark_exact_grant_row(context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext, host: String, principal: String) -> SparkGrantRow {
  SparkGrantRow {
    host: host,
    principal: principal,
    outcome: match probe_leg(context: context, host: host, principal: principal, raw_words: ["sudo", "-n", "-l"]) {
      Absent => GrantProbeRefused { cause: "non-portable-remote-word" }
      Present { value: r } =>
        if r.success {
          GrantEnumerated { listing: r.stdout }
        } else {
          GrantAbsent { detail: join(["exit=", to_string(r.exit_code), " stderr=", std.algebra.trim(s: r.stderr)], "") }
        }
    },
  }
}

// GrantAbsent is NOT a failure: "this account holds no passwordless grant" is a real, useful
// observation and the one the Sparks are expected to report before a serving grant is widened. Only
// GrantProbeRefused -- we could not ask -- fails the process, which is the distinction the substring
// gate could not draw at all.
fn spark_grant_report_refusal(report: SparkGrantReport) -> String? {
  match report {
    GrantProbeNotAttempted { cause: c } => Present { value: c }
    GrantsObserved { first: f, more: m } =>
      fold(concat([f], m), init: none, f: fn(acc, row) {
        match acc {
          Present { value: _ } => acc
          Absent => match row.outcome {
            GrantProbeRefused { cause: c } => Present { value: join(["host=", row.host, " principal=", row.principal, " probe-refused cause=", c], "") }
            GrantEnumerated { listing: _ } => none
            GrantAbsent { detail: _ } => none
          }
        }
      })
  }
}

fn spark_grant_row_text(row: SparkGrantRow) -> String {
  match row.outcome {
    GrantEnumerated { listing: l } => join(["grant host=", row.host, " principal=", row.principal, " enumerated:\n", l, "\n"], "")
    GrantAbsent { detail: d } => join(["grant host=", row.host, " principal=", row.principal, " NO-PASSWORDLESS-GRANT ", d, "\n"], "")
    GrantProbeRefused { cause: c } => join(["grant host=", row.host, " principal=", row.principal, " probe-refused cause=", c, "\n"], "")
  }
}

fn spark_grant_report_text(report: SparkGrantReport) -> String {
  match report {
    GrantProbeNotAttempted { cause: c } => join(["spark exact-grant probe not attempted: ", c, "\n"], "")
    GrantsObserved { first: f, more: m } => join(map(concat([f], m), r => spark_grant_row_text(row: r)), "")
  }
}

fn spark_exact_grant_report(context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext) -> SparkGrantReport {
  let rows = map(spark_standing_hosts, h =>
    spark_exact_grant_row(context: context, host: h, principal: "gunbc-automation"))
  match v2.std.algebra.list_head(rows) {
    HeadAbsent => GrantProbeNotAttempted { cause: "no standing hosts are declared" }
    HeadFound { value: f } => match v2.std.algebra.list_tail(rows) {
      TailAbsent => GrantsObserved { first: f, more: [] }
      TailFound { tail: t } => GrantsObserved { first: f, more: t }
    }
  }
}

func spark_exact_grant_probe_wet(attempt_raw: String) -> std.process.ProcessExit
  uses net: std.resources.Network
{
  gunbc.spark_credential_workflow.run_with_materialized_fleet_ssh_binding(
    attempt_raw: attempt_raw,
    token_source: gunbc.auth.access_token_source.GcloudPrintToken,
    body: fn(credential) {
      let report = match probe_attempt_identity(raw: attempt_raw) {
        Absent => GrantProbeNotAttempted { cause: "attempt identity is not a safe path segment" }
        Present { value: attempt } => {
          let materialization = gunbc.fleet_known_hosts_anchor.materialize_fleet_known_hosts_anchor(attempt: attempt)
          match gunbc.fleet_known_hosts_anchor.fleet_ssh_execution_context_of(outcome: materialization, credential: credential) {
            Absent => GrantProbeNotAttempted {
              cause: join(["trust could not be established, so no ssh leg ran: ", gunbc.fleet_known_hosts_anchor.known_hosts_materialization_receipt(outcome: materialization)], ""),
            }
            Present { value: context } => spark_exact_grant_report(context: context)
          }
        }
      }
      let w = Filesystem.Write(path: spark_grant_probe_receipt_path, content: spark_grant_report_text(report: report))
      if !w.success {
        std.process.exit_failure(reason: join(["exact-grant probe receipt write failed: ", w.error], ""))
      } else {
        match spark_grant_report_refusal(report: report) {
          Present { value: c } => std.process.exit_failure(reason: join(["spark exact-grant probe could not run: ", c], ""))
          Absent => std.process.ExitSuccess
        }
      }
    },
  )
}

// ── The derived standing, from the same legs the receipt above reports ──────────────────────────

// One typed observation per (host, principal), which is the grain the account model already uses.
// The credential identity rides every row, so a reader can tell WHICH key produced the result rather
// than inferring it from the run that happened to be executing.
fn principal_observation(
  context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext,
  credential_identity: std.content_hash.ContentHash,
  host: String,
  principal: String,
) -> gunbc.spark_managed_access_bootstrap.PrincipalReachObservation {
  let reach = probe_leg(context: context, host: host, principal: principal, raw_words: ["hostname"])
  let sudo = probe_leg(context: context, host: host, principal: principal, raw_words: ["sudo", "-n", "-l"])
  gunbc.spark_managed_access_bootstrap.PrincipalReachObservation {
    host: host as product.placement_supply.HostIdentity,
    principal_login_name: principal as std.types.NonEmptyStr,
    credential_identity: credential_identity,
    authenticated: match reach { Present { value: r } => r.success Absent => false },
    holds_any_passwordless_grant: match sudo { Present { value: r } => r.success Absent => false },
  }
}

fn spark_standing_line(standing: gunbc.spark_managed_access_bootstrap.SparkManagedAccessStanding) -> String {
  match standing {
    ManagedAccessGrounded { occurrence: o } =>
      join(["standing host=", o.host as String, " managed-access=GROUNDED\n"], "")
    ManagedAccessBootstrapRequired { host: h, missing: _, bootstrap_transport: _ } =>
      join(["standing host=", h as String, " managed-access=BOOTSTRAP-REQUIRED (human bootstrap observed, managed executor absent)\n"], "")
    ManagedAccessUnobserved { host: h } =>
      join(["standing host=", h as String, " managed-access=UNOBSERVED (no reachable principal, so no transport to bootstrap through)\n"], "")
  }
}

// The authorization is DERIVED and printed, never asked. What reaches the operator is the exact
// effect population requiring privilege -- not the question "does this need root", which nobody can
// evaluate without the list.
fn spark_authorization_lines(standing: gunbc.spark_managed_access_bootstrap.SparkManagedAccessStanding, credential_identity: std.content_hash.ContentHash) -> String {
  match gunbc.spark_managed_access_bootstrap.derive_spark_bootstrap_plan(standing: standing, fleet_public_material_identity: credential_identity) {
    Absent => ""
    Present { value: plan } => {
      let effects = join(map(gunbc.spark_managed_access_bootstrap.spark_bootstrap_plan_effects(plan: plan), e =>
        join(["  effect ", gunbc.spark_managed_access_bootstrap.spark_bootstrap_effect_label(effect: e), "\n"], "")), "")
      match gunbc.spark_managed_access_bootstrap.authorize_spark_bootstrap(plan: plan) {
        BootstrapProceedsUnprivileged { plan: _ } =>
          join(["authorization host=", plan.host as String, " UNPRIVILEGED\n", effects], "")
        OperatorBootstrapCredentialRequired { host: h, first_privileged: f, more_privileged: m, secret_purpose: p } =>
          join([
            "authorization host=", h as String, " OPERATOR-CREDENTIAL-REQUIRED privileged_effects=",
            to_string(1 + length(m)), "\n  purpose ", p as String, "\n", effects,
            "  first-privileged ", gunbc.spark_managed_access_bootstrap.spark_bootstrap_effect_label(effect: f), "\n",
          ], "")
      }
    }
  }
}

data spark_standing_receipt_path: String = "target/spark-managed-access-standing-receipt.txt"

// The Spark hosts only: this derivation is about the serving fleet, and running it over srv1..srv4
// would produce bootstrap plans for hosts whose managed access is a different lane's question.
data spark_standing_hosts: List<String> = ["srv5", "srv6"]

func spark_managed_access_standing_wet() -> std.process.ProcessExit
  uses net: std.resources.Network
{
  match fleet_ssh_attempt_raw_from_env() {
    Absent =>
      std.process.exit_failure(
        reason: "spark_managed_access_standing_wet requires GUNBC_FLEET_SSH_ATTEMPT_RAW or GitHub GITHUB_RUN_ID+GITHUB_RUN_ATTEMPT env"
      )
    Present { value: attempt_raw } => spark_managed_access_standing_with_attempt(attempt_raw: attempt_raw)
  }
}

// THE STANDING EXIT, folded over the derived standings rather than over the rendered receipt. The
// substring gate this replaces asked whether the body contained "REFUSED" -- and no arm of
// spark_standing_line or spark_authorization_lines ever emits that word, so the gate could not fire
// at all and the func exited 0 whatever it observed (found while fixing the sibling defect in
// review 51704). ManagedAccessBootstrapRequired is a real observation and stays a success; only
// ManagedAccessUnobserved -- no reachable principal, so nothing was measured -- fails.
fn spark_standing_unobserved_host(standings: List<gunbc.spark_managed_access_bootstrap.SparkManagedAccessStanding>) -> String? {
  fold(standings, init: none, f: fn(acc, standing) {
    match acc {
      Present { value: _ } => acc
      Absent => match standing {
        ManagedAccessUnobserved { host: h } => Present { value: h as String }
        ManagedAccessGrounded { occurrence: _ } => none
        ManagedAccessBootstrapRequired { host: _, missing: _, bootstrap_transport: _ } => none
      }
    }
  })
}

// ONE derivation, read twice: the receipt renders the standings and the exit folds the same values.
// Deriving them a second time for the exit would let the two disagree (review 51710).
func spark_managed_access_standing_with_attempt(attempt_raw: String) -> std.process.ProcessExit {
  match probe_attempt_identity(raw: attempt_raw) {
    Absent =>
      std.process.exit_failure(reason: "spark managed-access standing refused before any observation: attempt identity is not a safe path segment, so the agent selector has no attempt-owned path to be materialized at")
    Present { value: attempt } =>
      spark_managed_access_standing_for_attempt(attempt_raw: attempt_raw, attempt: attempt)
  }
}

// The credential gate, split out so the attempt-identity match above has one expression per arm
// rather than a nested match indented back to the outer column (review 52733).
func spark_managed_access_standing_for_attempt(
  attempt_raw: String,
  attempt: gunbc.fleet_known_hosts_anchor.FleetSshAttemptIdentity,
) -> std.process.ProcessExit
  uses net: std.resources.Network
{
  match probe_agent_credential_verification(attempt: attempt) {
    FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed } =>
      std.process.exit_failure(
        reason: gunbc.fleet_ssh_credential_verify.fleet_ssh_credential_verification_refusal_reason(
          verification: gunbc.fleet_ssh_credential_verify.FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed },
        ),
      )
    FleetSshCredentialDerivationRefused { cause: cause } =>
      std.process.exit_failure(
        reason: gunbc.fleet_ssh_credential_verify.fleet_ssh_credential_verification_refusal_reason(
          verification: gunbc.fleet_ssh_credential_verify.FleetSshCredentialDerivationRefused { cause: cause },
        ),
      )
    FleetSshCredentialVerified { binding: binding } =>
      spark_managed_access_standing_with_verified_credential(
        attempt_raw: attempt_raw,
        credential_identity: gunbc.fleet_known_hosts_anchor.fleet_ssh_credential_identity(binding: binding),
      )
  }
}

// The observing half, entered only with an identity that came from a verified binding.
func spark_managed_access_standing_with_verified_credential(
  attempt_raw: String,
  credential_identity: std.content_hash.ContentHash,
) -> std.process.ProcessExit
  uses net: std.resources.Network
{
  let now = gunbc.clock_read.clock_now_probed_at()
  let observations = flat_map(spark_standing_hosts, h =>
    map(multi_principal_probe_principals, p =>
      agent_backed_principal_observation(
        credential_identity: credential_identity,
        host: h,
        principal: p,
      )))
  let standings = map(spark_standing_hosts, h =>
    gunbc.spark_managed_access_bootstrap.derive_spark_managed_access_standing(host: h as product.placement_supply.HostIdentity, observations: observations))
  let body = join([
    join([
      "spark managed-access standing probed_at=", now as String,
      " attempt_raw=", attempt_raw,
      " credential_identity=", std.content_hash.serialize_content_hash(hash: credential_identity) as String,
      " transport=in-run-ssh-agent\n",
    ], ""),
    join(map(observations, o => join([
      "observed host=", o.host as String, " principal=", o.principal_login_name as String,
      " authenticated=", if o.authenticated { "true" } else { "false" },
      " holds_any_passwordless_grant=", if o.holds_any_passwordless_grant { "true" } else { "false" }, "\n",
    ], "")), ""),
    join(map(standings, standing =>
      join([
        spark_standing_line(standing: standing),
        spark_authorization_lines(standing: standing, credential_identity: credential_identity),
      ], "")), ""),
  ], "")
  let w = Filesystem.Write(path: spark_standing_receipt_path, content: body)
  if !w.success {
    std.process.exit_failure(reason: join(["spark standing receipt write failed: ", w.error], ""))
  } else {
    match spark_standing_unobserved_host(standings: standings) {
      Present { value: h } =>
        std.process.exit_failure(reason: join(["spark managed-access standing could not be observed on host=", h, ": no reachable principal, so no transport to bootstrap through"], ""))
      Absent => std.process.ExitSuccess
    }
  }
}
