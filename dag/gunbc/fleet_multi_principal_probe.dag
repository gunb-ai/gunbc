module gunbc.fleet_multi_principal_probe

import std.types { String, Bool, List, NonEmptyStr }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.algebra { trim }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.typed_argv_exec { typed_argv_probe_over_ssh, TypedArgvExecOutcome, TypedArgvExecConverged, TypedArgvExecRefused }
import gunbc.fleet_reach_endpoint { fleet_probe_endpoint_for }
import gunbc.fleet_host_key_enrollment { fleet_host_key_enroll_apply }
import gunbc.clock_read { clock_now_probed_at }

// READ-ONLY measurement (parent msg_e767a783): before anyone grants new access, measure
// whether the fleet key is already enrolled for SOME pre-existing account on srv3/srv4.
// gunbc-fleet@srv3/srv4 refusing proves only that the account we just invented is not
// there — it says nothing about accounts that existed at OOBE (the Sparks carried the
// fleet key for a pre-existing account). This probes the SAME in-run WIF-materialized
// key against ALTERNATIVE principals. NO WRITES, no account creation: each leg is a
// hostname read (command reach) and a `sudo -n -l` (grant listing without prompting).
// Every leg's outcome is DATA, classified into a typed arm, never a step failure.
// srv5/srv6 ADDED (2026-08-10). They belong here on the module's own rationale: the comment above
// cites the Sparks as the REASON this probe exists -- "the Sparks carried the fleet key for a
// pre-existing account" -- while the population it measured was srv3/srv4, so the two hosts the
// argument is about were the two it never asked about. Their endpoints were already modeled
// (fleet_reach_endpoint resolves srv5/srv6 by address because those names are not resolvable), and
// fleet_reach_probe_targets already carries all six, so this row was the only place the Sparks
// were missing.
//
// This is the observation that lets gunbc.fleet_converge_cli's spark_managed_access_standing stop
// returning a hardcoded SparkManagedAccessAbsent whose cause claims it measured the host. It is
// safe to widen because the probe is READ-ONLY by construction -- a hostname read and `sudo -n -l`
// per leg, every outcome classified as data rather than a step failure -- so it manufactures none
// of the runner obligations host_assimilation_program forbids crossing a Spark with.
//
// It also replaces work rather than adding any: the deleted spark-canary-probe.yml asked exactly
// this question in hand-authored shell, against this same principal list, and a hand-written
// workflow is hand-applying (operator ruling, 2026-08-10).
data multi_principal_probe_hosts: List<String> = ["srv3", "srv4", "srv5", "srv6"]

data multi_principal_probe_principals: List<String> = ["ubuntu", "briansrls", "ghrunner", "root"]

data fleet_multi_principal_probe_receipt_path: String = "target/fleet-multi-principal-probe-receipt.txt"

// One leg's line: authentication accepted/refused, and if accepted whether a command
// executed (shell present) — with the observed values carried, never a bare verdict.
fn multi_principal_reach_line(host: String, principal: String) -> String {
  let target = join([principal, "@", fleet_probe_endpoint_for(host: host)], "")
  match typed_argv_probe_over_ssh(host: target as NonEmptyStr, argv: ["hostname"]) {
    TypedArgvExecConverged { result: r } =>
      if r.success {
        join(["reach host=", host, " principal=", principal, " auth=accepted command=executed hostname=", trim(s: r.stdout), "\n"], "")
      } else {
        join(["reach host=", host, " principal=", principal, " auth-or-command=refused stderr=", trim(s: r.stderr), " stdout=", trim(s: r.stdout), "\n"], "")
      }
    TypedArgvExecRefused { reason: why } =>
      join(["reach host=", host, " principal=", principal, " probe-refused cause=", why, "\n"], "")
  }
}

fn multi_principal_sudo_line(host: String, principal: String) -> String {
  let target = join([principal, "@", fleet_probe_endpoint_for(host: host)], "")
  match typed_argv_probe_over_ssh(host: target as NonEmptyStr, argv: ["sudo", "-n", "-l"]) {
    TypedArgvExecConverged { result: r } =>
      if r.success {
        join(["sudo  host=", host, " principal=", principal, " sudo-n-l=listed grants=", trim(s: r.stdout), "\n"], "")
      } else {
        join(["sudo  host=", host, " principal=", principal, " sudo-n-l=refused stderr=", trim(s: r.stderr), "\n"], "")
      }
    TypedArgvExecRefused { reason: why } =>
      join(["sudo  host=", host, " principal=", principal, " probe-refused cause=", why, "\n"], "")
  }
}

fn multi_principal_host_block(host: String) -> String {
  join(
    map(multi_principal_probe_principals, p =>
      join([multi_principal_reach_line(host: host, principal: p), multi_principal_sudo_line(host: host, principal: p)], "")),
    "")
}

// Enrollment rides with the run, SAME path as probe_fleet_reach_wet and
// collect_fleet_convergence_wet (review 50900). This was the one fleet-SSH entry that did
// not call it, so this restores an invariant its two siblings already hold.
//
// THIS DOES NOT, ON ITS OWN, RESTORE PROBE REACH, and the comment says so because measuring
// it is what refuted the first reading of this defect. probe_fleet_reach_wet DOES call
// fleet_host_key_enroll_apply and, in run 31458845499, failed identically -- every host
// unreachable behind "No ED25519 host key is known ... Host key verification failed". So the
// missing call and the pin's own breakage are TWO defects, and only the first is fixed here.
//
// The pin regression itself is measured, not inferred: run 31346260819 (PRE-pin) produced
// real principal-level answers -- srv3/ubuntu accepted and executed hostname, srv4/briansrls
// accepted, ghrunner "This account is currently not available", root permission-denied --
// while run 31458845499 (POST-pin) refused EVERY leg of EVERY host on every entry. Nothing
// about the fleet changed between them; fleet_host_key_enroll_apply's
// StrictHostKeyChecking-yes pin landed 2026-08-10. Root cause is open at the pin, not here.
//
// WHY IT STAYED INVISIBLE, which is the part worth keeping: the enroll readback is
// `ssh-keygen -F <endpoint> -f <staged fragment>`, which interrogates the FRAGMENT FILE and
// not the binding ssh actually resolves, so it reports readback=found-in-pinned-fragment for
// all six hosts in the very same job whose next step cannot verify one of them. A success
// criterion that cannot express the failure mode is not evidence of the guarantee (DESIGN
// §5), and here it concealed a total loss of probe reach across the whole fleet.
//
// The receipt carries enroll_lines FIRST so a reader sees the anchor this run actually used
// rather than inferring it. With or without this call the probe exits 0 and writes a
// well-formed receipt -- every leg simply reads `refused` -- which is the dangerous shape:
// a host-key configuration failure wearing the costume of a principal-absence measurement.
// Grounding gunbc.fleet_converge_cli spark_managed_access_standing on such a receipt would
// re-introduce the exact fabricated SparkManagedAccessAbsent that #8073 removed, one layer
// further down where the cause string looks measured. Until the pin is repaired, a refused
// leg in this receipt is evidence about ssh configuration and about nothing else.
func fleet_multi_principal_probe_wet() -> ProcessExit {
  let enroll_lines = fleet_host_key_enroll_apply()
  let now = clock_now_probed_at()
  let body = join([
    enroll_lines,
    join(["multi-principal fleet-key probe probed_at=", now as String, " (read-only: hostname + sudo -n -l)\n"], ""),
    join(map(multi_principal_probe_hosts, h => multi_principal_host_block(host: h)), ""),
  ], "")
  let w = Filesystem.Write(path: fleet_multi_principal_probe_receipt_path, content: body)
  if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: join(["multi-principal probe receipt write failed: ", w.error], ""))
  }
}
