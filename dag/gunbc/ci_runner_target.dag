module gunbc.ci_runner_target

import extdeps.cloud.ubicloud { UbicloudRunnerCatalogRow, ubicloud_standard_16_arm_catalog }
import extdeps.github.actions { RunnerSpec, SelfHosted }
import extdeps.github.hosted_runners { GithubHostedRunnerCatalogRow }
import gunbc.ci_fleet { gunbc_ci_fleet_offer }
import gunbc.runner_slot_allocation { RunnerSlotDesired, gunbc_runner_slot_desired }
import gunbc.ci_floor_measurement { gunbc_ci_runner_slot_ram_speed_ceiling }
import gunbc.runner_spec_from_offer { runner_spec_from_offer }
import std.measure { ByteSize }

data ci_runner_target_mapping_note: String = "The single seam the 2026-07-11 ubicloud iteration window proved missing: 'which machine runs CI' was modeled as a label, so switching runners propagated nothing (CARGO_BUILD_JOBS stayed fleet-derived, the toolchain-image assumption stayed baked, the memory regime stayed invisible). This module makes the selection one fact with N projections: selected_ci_runner_target() is the authority; the runs-on spec and the memory regime PROJECT from it; a runner switch is a one-row edit here and every derivation follows (DESIGN 2, model-local/derive-global). Fleet labels stay DERIVED from the fleet offer (gunbc.runner_spec_from_offer, unchanged authority); cloud rows carry the provider's cited runs-on token (extdeps catalog rows), not a re-derivation. Consumers migrate to the projections as they need them - ci_workflow reads the spec projection now; the floor budget's regime read (gunbc.ci_floor_measurement live rows) is the declared convergence successor: once a completed fleet floor readback proves live == declared, the budget reads ci_runner_target_memory_regime and the live rows collapse (their own dissolve-on)."

type CiRunnerTarget
  = FleetSelfHosted
  | UbicloudRunner { row: UbicloudRunnerCatalogRow }
  | GithubHostedRunner { row: GithubHostedRunnerCatalogRow }

type RunnerMemoryRegime
  = SlotCarved { desired: RunnerSlotDesired }
  | WholeMachine { ram: ByteSize }

fn ci_runner_target_spec(target: CiRunnerTarget) -> RunnerSpec {
  match target {
    FleetSelfHosted => runner_spec_from_offer(offer: gunbc_ci_fleet_offer)
    UbicloudRunner { row: row } => SelfHosted { labels: [row.runs_on_label] }
    GithubHostedRunner { row: row } => SelfHosted { labels: [row.runs_on_label] }
  }
}

fn ci_runner_target_memory_regime(target: CiRunnerTarget) -> RunnerMemoryRegime {
  match target {
    FleetSelfHosted => SlotCarved { desired: gunbc_runner_slot_desired() }
    UbicloudRunner { row: row } => WholeMachine { ram: row.memory_bytes }
    GithubHostedRunner { row: row } => WholeMachine { ram: row.memory_bytes }
  }
}

fn ci_runner_target_ram_speed_budget(target: CiRunnerTarget) -> ByteSize {
  match ci_runner_target_memory_regime(target: target) {
    SlotCarved { desired: _ } => gunbc_ci_runner_slot_ram_speed_ceiling()
    WholeMachine { ram: ram } => ram
  }
}

data selected_ci_runner_target_note: String = "Operator routing 2026-07-11: ubicloud-standard-16-arm while the self-hosted fleet is slot-contended - and THROUGH this selection row, not as an override beside it (the #6489 iteration window's override forked the runner authority and needed a paired revert; this row IS the sanctioned switch point). The projections carry everything the override could not: runs-on labels, the memory regime (WholeMachine, no memory.high carve - the floor's swap-throttle class does not exist on this shape), the RAM-speed budget (catalog 48GB feeds CARGO_BUILD_JOBS and floor width in place of the fleet slot ceiling), and the fleet derivation stays live and witnessed for the flip back. Returning to the fleet = FleetSelfHosted here + regen; nothing else moves."

fn selected_ci_runner_target() -> CiRunnerTarget {
  UbicloudRunner { row: ubicloud_standard_16_arm_catalog }
}

fn gunbc_ci_selected_runner_spec() -> RunnerSpec {
  ci_runner_target_spec(target: selected_ci_runner_target())
}
