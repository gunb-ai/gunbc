module gunbc.deploy_transition_bootstrap


import std.types { String, Bool, List, NonEmptyStr }
import gunbc.live_deploy.spec {
  DeploymentNames,
  deployment_belt_service_unit_name,
  deployment_belt_timer_unit_name,
}
import gunbc.live_deploy.operations {
  systemctl_mask_now_command,
  systemctl_unmask_command,
  systemctl_start_command,
}

// THE FIRST TRANSITION IS NOT PROTECTED BY ANY MARKER, AND THAT IS NOT A GAP IN THE MARKER.
//
// `gunbc.deploy_transition` inhibits release-consuming actuators by writing a durable record that
// the actuator READS. That works for every actuator running a release which knows the record
// exists. It cannot work for the FIRST activation, because the belt timer and the HTTP dispatcher
// live during it are running the OLD binary -- the one installed before the mechanism was written
// -- and no file can inhibit a program that never looks for it. The new release is not installed
// until partway through the very transition that needs protecting.
//
// So there are two regimes and the transition between them is itself a modeled step.
//
// BOOTSTRAP: the old release's actuators are stopped from OUTSIDE the process, by disabling their
// systemd units. That requires nothing of the old binary and survives both a reboot and the death
// of the deploying process, which is the property an in-process gate cannot have here. It is
// stronger than the steady-state mechanism and correspondingly more expensive: the dashboard is
// down for the window, which the single-deployment ruling already accepts as the cost of a
// restart-in-place deployment.
//
// STEADY STATE: the installed release consults the durable marker itself, so its units may run
// while a transition is in force -- every actuation path inside them refuses on its own. The units
// are re-enabled at that point even though the inhibition is still set, because the inhibition is
// now enforced one level in.
//
// THE SWITCH IS A WALL, NOT A STEP. Re-enabling the units is admitted only when the INSTALLED
// release is observed to be marker-aware. Re-enabling over an unaware release would restore exactly
// the unprotected actuator the bootstrap regime exists to stop, at the moment the tree is most
// likely to be half-converged -- and it would look like progress.

type ReleaseMarkerAwareness
  = MarkerAware { release_identity: String }
  | MarkerUnaware { release_identity: String }
  | MarkerAwarenessUnobserved { cause: String }

type QuiescenceRegime
  = BootstrapExternalQuiescence
  | SteadyStateInProcessInhibition

type QuiescenceRegimeDecision
  = QuiescenceRegimeIs { regime: QuiescenceRegime }
  | QuiescenceRegimeUndecidable { cause: String }

// AN UNOBSERVED AWARENESS REFUSES RATHER THAN CHOOSING THE STRONGER REGIME. Defaulting to bootstrap
// would be safe in outcome and wrong in kind: it answers a question it could not compute with the
// most protective value, which zeroes the frequency of the observation deficit by construction and
// makes an unobservable release indistinguishable from an old one. A transition that cannot tell
// which release is running has no business starting.
fn quiescence_regime(awareness: ReleaseMarkerAwareness) -> QuiescenceRegimeDecision {
  match awareness {
    MarkerAware { release_identity: _ } =>
      QuiescenceRegimeIs { regime: SteadyStateInProcessInhibition }
    MarkerUnaware { release_identity: _ } =>
      QuiescenceRegimeIs { regime: BootstrapExternalQuiescence }
    MarkerAwarenessUnobserved { cause: c } =>
      QuiescenceRegimeUndecidable {
        cause: join([
          "gunbc.deploy_transition_bootstrap: the running release's marker awareness is unobserved, so neither quiescence regime can be selected -- ",
          c,
        ], ""),
      }
  }
}

// THE QUIESCED SET IS EVERY UNIT THAT CAN ACTUATE A RELEASE, and both of the belt's units are in it
// rather than only the timer. Disabling the timer alone leaves the one-shot service startable by
// anything that reaches systemd, and the HTTP dispatcher lives in the serve unit -- the deploy
// convergence design record already records that stopping only the timer leaves the click path
// admitting against a half-published release, which is this defect one layer out.
fn bootstrap_quiesced_units(names: DeploymentNames) -> List<NonEmptyStr> {
  [
    deployment_belt_timer_unit_name(names: names),
    deployment_belt_service_unit_name(names: names),
    names.unit_name,
  ]
}

// `mask --now` AND NOT `disable --now`, AND THIS ROW IS A CORRECTION RATHER THAN A PREFERENCE. It
// previously read `disable --now`, on the argument that disabling removes the enablement symlinks
// and is therefore durable where `stop` is not. The durability argument against `stop` still holds
// and is why this is not `stop`. The rest of it was FALSE FOR ONE OF THE THREE UNITS THIS QUIESCES,
// which is worse than a weak choice because the row asserted a guarantee the operation does not
// deliver.
//
// MEASURED, not reasoned: `gunbc.live_deploy.emit` renders the belt SERVICE with
// `install: NotInstallable` -- it is a STATIC unit, activated by the belt timer rather than by an
// [Install] section. A static unit has no enablement symlinks, so `systemctl disable` has nothing
// to remove and does nothing; only the `--now` half took effect, and that half is exactly the
// non-durable `stop` the row above rejects. So for the belt service the declared durability was
// supplied by the timer being disabled separately, and not by anything this function did.
//
// `mask` is correct for both kinds and is stronger on the axis that actually matters here: it links
// the unit to /dev/null, so activation is refused whatever requests it -- the timer, a dependency,
// or a hand at a terminal. `disable` never prevented a manual `systemctl start`, and a bootstrap
// quiescence whose whole purpose is that NOTHING actuates during the first transition cannot leave
// that route open.
//
// AND MASK IS STATE-PRESERVING, WHICH IS WHY THE RESTORE BELOW GOT SIMPLER RATHER THAN LONGER.
// `disable` DESTROYS enablement state, so a restore has to re-decide what that state was -- and the
// previous restore re-enabled all three unconditionally, which would have ENABLED a unit an
// operator had deliberately disabled before the transition began, and would additionally have
// failed on the static one, since `enable` has no install section to act on either. `mask` layers
// over the existing state and `unmask` removes the layer, leaving prior enablement exactly as
// found. The restore therefore asserts nothing about what was enabled; it only stops overriding.
fn bootstrap_quiesce_commands(names: DeploymentNames, privileged: Bool) -> List<String> {
  map(
    bootstrap_quiesced_units(names: names),
    u => systemctl_mask_now_command(unit: u, privileged: privileged),
  )
}

// NO `start` HERE, AND ITS ABSENCE IS THE SAME STATE-PRESERVING ARGUMENT. The previous restore
// started all three units after enabling them, which asserts that all three were RUNNING before the
// quiescence. The belt timer starts the belt service on its own cadence and the serve unit is
// started by its enablement at boot, so starting them by hand here would both duplicate that and
// paper over the case where one of them was legitimately down. Unmasking returns the host to the
// state the transition found; it does not decide what that state should be.
// QUIESCENCE IS TWO INDEPENDENTLY OBSERVED FACTS, AND ONE COMMAND EXIT PROVES NEITHER.
// (Operator ruling relayed 2026-08-28.) `stop` establishes CURRENTLY INACTIVE. `mask` is intended
// to establish NOT STARTABLE. They are different propositions about different times -- "nothing is
// running now" and "nothing can start while I am gone" -- and the transition needs BOTH. This is
// the same lease/inhibition split this lane already accepted, applied one layer out to the units.
//
// AND THE ADMISSION LAW IS PHRASED ON THE OBSERVED REFUSAL, NEVER ON THE MECHANISM. It does not say
// "a mask symlink was written": these units are installed as local /etc/systemd/system files, and
// masking mechanics differ between persistent and runtime masks over locally-installed units, so
// binding the law to a mechanism FORCES a realization and would refuse a valid systemd that chose
// another. Binding it to the refusal lets systemd pick the mechanism while this gate consumes the
// stronger fact.
//
// WHY A SUCCESSFUL EXIT CODE IS NOT THE RECEIPT. `systemctl mask` returning 0 says the request was
// accepted, not that activation is refused -- it cannot distinguish a real mask from a unit that is
// merely stopped and disabled, which is exactly the state this module shipped before the mask
// correction and exactly the state that reads as quiesced while remaining startable. So the
// activation standing is minted ONLY from the outcome of a PLANTED DIRECT START, and the arms are
// assigned against intuition: a start that FAILED is the admitting evidence, and a start that
// SUCCEEDED refuses the transition. There is no arm in which an exit code from the mask itself
// reaches this standing.
//
// THE PLANTED START IS DESTRUCTIVE IF IT SUCCEEDS, AND THAT IS PART OF THE MEASUREMENT RATHER THAN
// A HAZARD TO SUPPRESS. If the probe starts the belt service, an actuator has just run against a
// tree mid-transition -- which is the failure this whole lane exists to prevent, now OBSERVED
// instead of assumed. `ActivationObservedAdmitted` therefore refuses loudly and names the unit; the
// caller re-quiesces and does not proceed. Suppressing the probe to avoid the risk would leave the
// same state unobserved, which is how it got here.
type UnitInactiveStanding
  = UnitObservedInactive { unit: NonEmptyStr }
  | UnitObservedActive { unit: NonEmptyStr }
  | UnitInactivityUnobserved { unit: NonEmptyStr, cause: String }

type UnitActivationInhibitedStanding
  = ActivationObservedRefused { unit: NonEmptyStr, detail: String }
  | ActivationObservedAdmitted { unit: NonEmptyStr, detail: String }
  | ActivationInhibitionUnobserved { unit: NonEmptyStr, cause: String }

// THE PROBE COMMAND IS A DIRECT START, deliberately bypassing the timer, because the timer is one of
// the things being quiesced and a probe that went through it would test the timer's disablement
// rather than the unit's activation.
fn quiescence_probe_start_command(unit: NonEmptyStr, privileged: Bool) -> String {
  systemctl_start_command(unit: unit, privileged: privileged)
}

fn unit_inactive_standing(
  unit: NonEmptyStr,
  observed: Bool,
  active: Bool,
  cause: String,
) -> UnitInactiveStanding {
  if !observed {
    UnitInactivityUnobserved { unit: unit, cause: cause }
  } else {
    if active { UnitObservedActive { unit: unit } } else { UnitObservedInactive { unit: unit } }
  }
}

fn unit_activation_standing(
  unit: NonEmptyStr,
  probe_ran: Bool,
  start_succeeded: Bool,
  detail: String,
) -> UnitActivationInhibitedStanding {
  if !probe_ran {
    ActivationInhibitionUnobserved { unit: unit, cause: detail }
  } else {
    if start_succeeded {
      ActivationObservedAdmitted { unit: unit, detail: detail }
    } else {
      ActivationObservedRefused { unit: unit, detail: detail }
    }
  }
}

// `sole_constructor`, so no caller can assert a quiescence it did not observe. The only mint takes
// both standings, which is what makes "one command exit proves neither" structural rather than
// advisory: there is no spelling of this record that carries a mask's exit status.
type ExternalQuiescence sole_constructor {
  unit: NonEmptyStr
  inactive: UnitInactiveStanding
  activation: UnitActivationInhibitedStanding
}

fn observe_unit_quiescence(
  unit: NonEmptyStr,
  inactive: UnitInactiveStanding,
  activation: UnitActivationInhibitedStanding,
) -> ExternalQuiescence {
  ExternalQuiescence { unit: unit, inactive: inactive, activation: activation }
}

type QuiescenceAdmission
  = QuiescenceInForce
  | QuiescenceRefused { cause: String }

// BOTH ARMS MUST BE THE OBSERVED-GOOD ONE, and each way of failing keeps its own cause because the
// remedies differ: still active means stop it, still startable means the mask did not take, and
// unobserved means the host did not answer -- which is not a permit.
fn unit_quiescence_admission(q: ExternalQuiescence) -> QuiescenceAdmission {
  match q.inactive {
    UnitObservedActive { unit: u } =>
      QuiescenceRefused {
        cause: join(["gunbc.deploy_transition_bootstrap: ", u as String, " is still active"], ""),
      }
    UnitInactivityUnobserved { unit: u, cause: why } =>
      QuiescenceRefused {
        cause: join([
          "gunbc.deploy_transition_bootstrap: whether ", u as String,
          " is inactive was not observed -- ", why,
        ], ""),
      }
    UnitObservedInactive { unit: _ } =>
      match q.activation {
        ActivationObservedAdmitted { unit: u, detail: d } =>
          QuiescenceRefused {
            cause: join([
              "gunbc.deploy_transition_bootstrap: a planted direct start of ", u as String,
              " SUCCEEDED, so activation is not inhibited and an actuator has just run against a",
              " tree mid-transition -- re-quiesce before proceeding -- ", d,
            ], ""),
          }
        ActivationInhibitionUnobserved { unit: u, cause: why } =>
          QuiescenceRefused {
            cause: join([
              "gunbc.deploy_transition_bootstrap: no start was planted against ", u as String,
              ", so activation inhibition is unobserved and a mask exit code is not a substitute -- ",
              why,
            ], ""),
          }
        ActivationObservedRefused { unit: _, detail: _ } => QuiescenceInForce
      }
  }
}

fn quiescence_admits(a: QuiescenceAdmission) -> Bool {
  match a {
    QuiescenceInForce => true
    QuiescenceRefused { cause: _ } => false
  }
}

// THE ROSTER LAW IS AN IDENTITY JOIN, NOT A COUNT. A quiescence record for some other unit cannot
// stand in for a missing one, so the expected roster is walked and each unit must be BOTH present
// in the observations and admitting. A count would let three observations of two units pass.
fn roster_quiescence_admission(
  names: DeploymentNames,
  observed: List<ExternalQuiescence>,
) -> QuiescenceAdmission {
  fold(
    bootstrap_quiesced_units(names: names),
    init: QuiescenceInForce,
    f: (acc, u) =>
      match acc {
        QuiescenceRefused { cause: why } => QuiescenceRefused { cause: why }
        QuiescenceInForce =>
          match first(filter(observed, q => (q.unit as String) == (u as String))) {
            Absent =>
              QuiescenceRefused {
                cause: join([
                  "gunbc.deploy_transition_bootstrap: no quiescence was observed for ", u as String,
                ], ""),
              }
            Present { value: q } => unit_quiescence_admission(q: q)
          }
      },
  )
}

fn bootstrap_restore_commands(names: DeploymentNames, privileged: Bool) -> List<String> {
  map(
    bootstrap_quiesced_units(names: names),
    u => systemctl_unmask_command(unit: u, privileged: privileged),
  )
}

type SteadyStateAdoption
  = SteadyStateAdopted { release_identity: String }
  | SteadyStateRefused { cause: String }

// THE SWITCH IS ADMITTED BY THE INSTALLED RELEASE, NOT BY THE DEPLOYING PROCESS'S INTENTION. The
// argument is the awareness of what is now ON DISK, observed after installation -- a deploy that
// asked about the release it MEANT to install would be checking its own plan rather than the host.
fn adopt_steady_state(installed: ReleaseMarkerAwareness) -> SteadyStateAdoption {
  match installed {
    MarkerAware { release_identity: r } => SteadyStateAdopted { release_identity: r }
    MarkerUnaware { release_identity: r } =>
      SteadyStateRefused {
        cause: join([
          "gunbc.deploy_transition_bootstrap: refusing to restore actuator units over release ",
          r,
          ", which does not consult the durable inhibition; external quiescence stays in force",
        ], ""),
      }
    MarkerAwarenessUnobserved { cause: c } =>
      SteadyStateRefused {
        cause: join([
          "gunbc.deploy_transition_bootstrap: refusing to restore actuator units without observing the installed release's marker awareness -- ",
          c,
        ], ""),
      }
  }
}

// THE ORDER IS THE SAFETY PROPERTY, so it is a modeled successor relation rather than the order in
// which a caller happens to write the calls. Every adjacent pair below is one of the requirements
// this lane exists to hold, and a skipped or reordered step is a refusal naming both steps rather
// than a run that quietly omitted one.
//
// THE SEQUENCE IS PRINCIPAL -> LEASE -> OPERANDS -> MUTATION (operator ruling, 2026-08-28), and the
// first arrow is the one an earlier revision of this vocabulary got wrong: it began at
// `StepLeaseHeld`, which reads as harmless and is not. ACQUISITION IS ITSELF A PRIVILEGED WRITE. A
// unit that acquires before establishing which principal it runs as creates the lease -- mode 0600,
// owned by whoever happened to be executing -- and that is precisely the unreadable-marker state
// this lane spent its existence removing, manufactured by the guard itself. The guard cannot be the
// thing that produces the hazard it exists to detect, so the principal is admitted first and
// everything else is downstream of it.
//
// The four-phase reading maps onto the seven steps as: PRINCIPAL is `StepPrincipalAdmitted`; LEASE
// is `StepLeaseHeld`; OPERANDS are `StepExternallyQuiesced` and `StepInhibitionPersisted`, the two
// preconditions that must stand before anything is written; MUTATION is `StepReleaseInstalled` and
// the three steps that give the host back. They are one vocabulary at two grains, not two.
//
// Read the rest as the two invariants it encodes. Nothing mutates before the principal is known, the
// lease is held and the old actuators are quiesced. Nothing is released -- units, then marker, then
// lease -- until the layer beneath it is in place: units restore only over an aware release, the
// marker clears only after the units are governed in-process, and the lease releases last so a
// second transition cannot begin while any of it is outstanding.
type TransitionStep
  = StepPrincipalAdmitted
  | StepLeaseHeld
  | StepExternallyQuiesced
  | StepInhibitionPersisted
  | StepReleaseInstalled
  | StepSteadyStateAdopted
  | StepInhibitionCleared
  | StepLeaseReleased

fn transition_step_label(step: TransitionStep) -> String {
  match step {
    StepPrincipalAdmitted => "principal-admitted"
    StepLeaseHeld => "lease-held"
    StepExternallyQuiesced => "externally-quiesced"
    StepInhibitionPersisted => "inhibition-persisted"
    StepReleaseInstalled => "release-installed"
    StepSteadyStateAdopted => "steady-state-adopted"
    StepInhibitionCleared => "inhibition-cleared"
    StepLeaseReleased => "lease-released"
  }
}

// WHERE A CRASH LEAVES THE HOST, per step, and the property that holds at every one of them: no
// state below leaves an unguarded actuator over a tree that may be half-converged.
//
// After principal-admitted: nothing has been written at all -- no lease, no marker -- so a crash here
// leaves the host exactly as it was. That is the whole reason this step is first.
// After lease-held: nothing mutated; the lease file is residue, resolved by the clearance path in
// gunbc.deploy_transition on evidence. After externally-quiesced: the units are disabled and stay
// disabled across a reboot, so the dashboard is down -- an outage, and the SAFE side of this
// mechanism, restored by re-running the deployment or by an operator abandonment plus a deliberate
// enable, both of which leave a record. Through inhibition-persisted and release-installed both
// mechanisms are in force at once, which is the only overlap in the sequence and is deliberate: the
// marker takes over from external quiescence rather than replacing it in one uncovered instant.
// After steady-state-adopted the units run again and refuse in-process, because the switch was
// admitted only over a release that consults the marker. After inhibition-cleared only the lease is
// outstanding, which is the cheapest residue in the sequence.
fn transition_step_successor(step: TransitionStep) -> TransitionStep? {
  match step {
    StepPrincipalAdmitted => Present { value: StepLeaseHeld }
    StepLeaseHeld => Present { value: StepExternallyQuiesced }
    StepExternallyQuiesced => Present { value: StepInhibitionPersisted }
    StepInhibitionPersisted => Present { value: StepReleaseInstalled }
    StepReleaseInstalled => Present { value: StepSteadyStateAdopted }
    StepSteadyStateAdopted => Present { value: StepInhibitionCleared }
    StepInhibitionCleared => Present { value: StepLeaseReleased }
    StepLeaseReleased => none
  }
}

type StepAdmission
  = StepAdmitted { step: String }
  | StepOutOfOrder { expected: String, attempted: String }
  | StepAfterCompletion { attempted: String }

fn transition_step_advance(from: TransitionStep, to: TransitionStep) -> StepAdmission {
  match transition_step_successor(step: from) {
    Absent => StepAfterCompletion { attempted: transition_step_label(step: to) }
    Present { value: next } =>
      if transition_step_label(step: next) == transition_step_label(step: to) {
        StepAdmitted { step: transition_step_label(step: to) }
      } else {
        StepOutOfOrder {
          expected: transition_step_label(step: next),
          attempted: transition_step_label(step: to),
        }
      }
  }
}

