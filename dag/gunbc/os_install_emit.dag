module gunbc.os_install_emit

import std.logic { Bool }
import std.optional { Absent, Present }
import std.types { List, NonEmptyStr, String }
import extdeps.os.ubuntu_autoinstall {
  UbuntuAutoinstallPayload,
  AutoinstallIdentity,
  WithIdentity,
  UserDataOnly,
  CloudInitUserEntry,
  // NAMED, NOT ASSUMED. cloudinit_user_shell_text matches on these two arms and its return is
  // NonEmptyStr; the closed schema in gunbc.provisioning.public_nocloud_seed admits exactly these two
  // spellings at that leaf, so the renderer names the type it branches on rather than letting a bare
  // identifier resolve to whatever a transitive import happened to publish.
  CloudInitUserShell,
  BashLoginShell,
  PosixShell,
  AutoinstallStoragePolicy,
  StoragePolicyAbsent,
  StoragePolicyDirectLayout,
  AutoinstallDirectLayoutTarget,
  InstallerChoosesDisk,
  MatchedDisk,
  AutoinstallDiskPin,
  autoinstall_disk_pin_serial,
  autoinstall_disk_pin_model,
  autoinstall_match_field_serial,
  autoinstall_match_field_model,
  UbuntuAutoinstallLiveCommands,
  AutoinstallSshServer,
}
import extdeps.storage.device_identification { device_identification_token_text }
import extdeps.ssh.keys { SshPublicKey, ssh_public_key_canonical_line, ssh_public_key_line }
import extdeps.languages.yaml.types {
  YamlValue, YamlKeyValue,
  yaml_mapping, yaml_sequence, yaml_string, yaml_int, yaml_bool,
  kv, empty_yaml_values
}
import extdeps.languages.yaml.emit { emit_yaml, EmittedYaml, YamlEmitRefused, yaml_emit_refusal_text }

fn identity_entries(id: AutoinstallIdentity) -> List<YamlKeyValue> {
  [
    kv(key: "hostname", value: yaml_string(s: id.hostname)),
    kv(key: "username", value: yaml_string(s: id.username)),
    kv(key: "realname", value: yaml_string(s: id.realname)),
    kv(key: "password", value: yaml_string(s: id.hashed_password)),
  ]
}

// THE CLOUD-INIT USER ENTRY, EMITTED WITH CLOUD-INIT'S OWN KEY SPELLINGS (schema-cloud-config-v1.json:
// name, ssh_authorized_keys, lock_passwd, shell, sudo). There is deliberately NO branch that could emit
// `passwd` or `hashed_passwd`: the type CloudInitUserEntry has no such field, so a key-only user cannot
// state a password even by mistake, which is the operator's condition enforced by shape rather than by
// policy. `shell` renders from a CLOSED TYPE (CloudInitUserShell), and the two spellings emitted here are
// exactly the two values gunbc.provisioning.public_nocloud_seed admits at that leaf — so the document this
// emits is the document that audit admits, with no free text in between. `sudo` is a CONSTANT, not a field:
// a locked, passwordless account can only be granted the NOPASSWD rule, and the closed schema admits exactly
// that one string, so there is no choice for a caller to make and none for this renderer to branch on.
// `gecos` is not emitted: the closed schema does not admit it and the type no longer carries it.
fn cloudinit_user_shell_text(shell: CloudInitUserShell) -> NonEmptyStr {
  match shell {
    BashLoginShell => "/bin/bash"
    PosixShell => "/bin/sh"
  }
}

// THE ONE SUDO RULE A LOCKED, PASSWORDLESS ACCOUNT CAN HOLD. It is data rather than a parameter because
// there is nothing else to say: gunbc.provisioning.public_nocloud_seed's user schema admits only this string
// (cloud-init cc_users_groups, sudo), and a rule that asked for a password would lock the account out of its
// own privilege escalation.
data cloudinit_nopasswd_sudo_rule: NonEmptyStr = "ALL=(ALL) NOPASSWD:ALL"

fn cloudinit_user_entries(user: CloudInitUserEntry) -> List<YamlKeyValue> {
  [
    kv(key: "name", value: yaml_string(s: user.name)),
    kv(key: "lock_passwd", value: yaml_bool(b: user.lock_passwd)),
    kv(
      key: "ssh_authorized_keys",
      // The user table only exists on the key-only route (AutoinstallIdentityPosture.UserDataOnly), which is
      // the route the public seed contract governs, so canonical is the only spelling that can be admitted.
      value: yaml_sequence(elements: map(user.ssh_authorized_keys, k => yaml_string(s: ssh_public_key_canonical_line(k: k)))),
    ),
    kv(key: "shell", value: yaml_string(s: cloudinit_user_shell_text(shell: user.shell))),
    kv(key: "sudo", value: yaml_string(s: cloudinit_nopasswd_sudo_rule)),
  ]
}

// AN AUTHORIZED KEY IS WRITTEN TWO WAYS, AND THE ENTRY ROUTE DECIDES WHICH — because the two routes ship
// this document somewhere with different rules.
//
// * UserDataOnly is the key-only posture, and its document is what
//   gunbc.provisioning.public_nocloud_seed.admit_public_nocloud_seed seals for the PXE edge to serve. That
//   contract admits only the CANONICAL public key line: keytype plus blob, no comment, because sshd(8)'s
//   comment field is free text and a public volume must not carry it (merry-fox-82's hold at 0dd912cd, cited
//   on public_nocloud_seed.seed_public_key_line). Emit the comment there and the mint refuses the seed.
// * WithIdentity is the seeded-handle route, and its document goes to a BMC-staged NoCloud volume and to
//   srv3's seeded ISO. Those volumes are not published, and the fleet's own live installs (srv3_ubuntu_autoinstall,
//   srv3_ubuntu_autoinstall_on_iso, srv4_ubuntu_autoinstall_on_iso — all WithIdentity, all with an ssh section)
//   have ALWAYS carried the commented line. Canonicalizing there would have been a quiet edit to documents
//   live installs consume, stripping their key comments with nothing recording it — gunbc.design_argument::guarantee_ladder, no silent
//   regression. The witness test the_identity_route_still_writes_commented_authorized_keys pins those bytes.
//
// So this is not "two renderers for the same thing": the posture is the fact that determines the rules, and
// it is read off the declared coproduct rather than inferred from a flag.
fn autoinstall_authorized_key_line(posture: AutoinstallIdentityPosture, k: SshPublicKey) -> String {
  match posture {
    UserDataOnly { users: _ } => ssh_public_key_canonical_line(k: k)
    WithIdentity { identity: _, user_data: _ } => ssh_public_key_line(k: k)
  }
}

// ONE RULE, ONE PLACE (gunbc.design_argument::root_generalization, minimize_redundancy). The upstream
// `ssh` section -- install-server true, authorized-keys from the caller's roster, allow-pw from the
// posture -- is laid out HERE and nowhere else, so a new upstream key or a changed allow-pw default
// cannot land in one renderer and miss the other. It differs from a plain key list on exactly ONE thing:
// how a key line is spelled, and that difference is already a declared fact on the coproduct
// (autoinstall_authorized_key_line). So the caller SUPPLIES `line` rather than the section builder
// guessing from a flag: the installed route passes the posture-chosen line (canonical for a user-data-only
// seed where a public key comment must not ride into a distributed volume, the comment-bearing line for an
// identity seed). This is the INSTALLED-system ssh section -- a Subiquity target-system feature. The
// diskless runner medium does not reach it (it never installs); its fleet keys go through the live-session
// boot stage in gunbc.runner.runner_host_medium, not through here.
fn autoinstall_ssh_section(ssh: AutoinstallSshServer, line: fn(SshPublicKey) -> String) -> YamlKeyValue {
  kv(key: "ssh", value: yaml_mapping(entries: [
    kv(key: "install-server", value: yaml_bool(b: true)),
    kv(key: "authorized-keys", value: yaml_sequence(elements: map(ssh.authorized_keys, k =>
      yaml_string(s: line(k))))),
    kv(key: "allow-pw", value: yaml_bool(b: ssh.password_auth)),
  ]))
}

fn autoinstall_inner_entries(payload: UbuntuAutoinstallPayload) -> List<YamlKeyValue> {
  // THE ENTRY ROUTE IS READ OFF A DECLARED CHOICE, so this function has no invalid combination to notice.
  // AutoinstallIdentityPosture (extdeps.os.ubuntu_autoinstall) has exactly two arms because upstream has
  // exactly two legal documents: identity present, or user-data present and identity omitted (Canonical:
  // identity "is the only configuration key that must be present (unless the user-data section is present,
  // in which case it is optional)"). The head of the document is the same in both arms — version, locale,
  // keyboard — and then the arms differ in which section follows, at the position identity has always sat.
  // WithIdentity renders exactly the old four identity entries, in the old order, at the old position:
  // byte-for-byte the rendering that predates the key-only posture.
  let head = [
    kv(key: "version", value: yaml_int(n: payload.autoinstall_version)),
    kv(key: "locale", value: yaml_string(s: payload.locale)),
    kv(key: "keyboard", value: yaml_mapping(entries: [
      kv(key: "layout", value: yaml_string(s: payload.keyboard_layout)),
    ])),
  ]
  let with_user_data = match payload.identity_posture {
    // The user-data section sits beside identity, not inside it: upstream reads it as its own section.
    // An empty user list still emits the section, as before — the section's PRESENCE is what makes the
    // identity waiver legal, and refusing on an empty list would silently change which documents upstream
    // accepts. (The seed audit is what refuses a key-only entry with no keys; see the witness's RED.)
    WithIdentity { identity: id, user_data: optional_users } => append(
      append(head, items: [
        kv(key: "identity", value: yaml_mapping(entries: identity_entries(id: id))),
      ]),
      items: match optional_users {
        Present { value: users } => [
          kv(key: "user-data", value: yaml_mapping(entries: [
            kv(key: "users", value: yaml_sequence(elements: map(users, u =>
              yaml_mapping(entries: cloudinit_user_entries(user: u))))),
          ])),
        ]
        Absent => []
      },
    )
    UserDataOnly { users: users } => append(head, items: [
      kv(key: "user-data", value: yaml_mapping(entries: [
        kv(key: "users", value: yaml_sequence(elements: map(users, u =>
          yaml_mapping(entries: cloudinit_user_entries(user: u))))),
      ])),
    ])
  }
  let with_ssh = match payload.ssh {
    Present { value: ssh } => append(with_user_data, items: [
      autoinstall_ssh_section(ssh: ssh, line: k =>
        autoinstall_authorized_key_line(posture: payload.identity_posture, k: k)),
    ])
    Absent => with_user_data
  }
  if payload.fully_automated {
    let automated = append(with_ssh, items: [
      kv(key: "interactive-sections", value: yaml_sequence(elements: empty_yaml_values)),
    ])
    match payload.storage_policy {
      StoragePolicyAbsent => automated
      StoragePolicyDirectLayout { target: target } => append(automated, items: [
        kv(key: "storage", value: yaml_mapping(entries: [
          kv(key: "layout", value: yaml_mapping(entries: autoinstall_direct_layout_entries(target: target))),
        ])),
      ])
    }
  } else {
    with_ssh
  }
}

// THE `layout` MAPPING OF THE DIRECT LAYOUT, entry by entry. `name: direct` is upstream's own spelling for
// the layout this arm is (`storage: {layout: {name: direct, match: {...}}}`, the reference's example); `match`
// is emitted exactly when the payload names the disk, in the upstream order (name, then match). An emitted
// `match` is the conjunction the reference describes ("Every supplied key must match"), so the keys are
// rendered in the order the payload carries them and no key is invented here.
//
// WHO DECIDES THAT A `match` IS ADMISSIBLE — not here, and not by a check either. This is a renderer over the
// policy it is handed, and a renderer that started refusing would be a second authority over the disk question.
// The rule that a destructive install's match names ONE disk lives in the TYPE it renders: the arm carries an
// extdeps.os.ubuntu_autoinstall AutoinstallDiskPin, which cannot be built without the serial that picks the one
// device, and the only function that turns a disk FACT into that arm is
// gunbc.provisioning.install_target_disk's install_target_disk_direct_layout_target, reachable only from
// admit_install_target_disk. A match of `ssd`/`size` alone has no type to be held in and no renderer that would
// write it; the claim that a reading with no serial yields no pin is at install_target_disk_witness
// a_model_without_a_serial_is_refused_because_it_names_no_single_disk.
fn autoinstall_direct_layout_entries(target: AutoinstallDirectLayoutTarget) -> List<YamlKeyValue> {
  let named = [kv(key: "name", value: yaml_string(s: "direct"))]
  match target {
    InstallerChoosesDisk => named
    MatchedDisk { pin: pin } => append(named, items: [
      kv(key: "match", value: yaml_mapping(entries: autoinstall_match_entries(pin: pin))),
    ])
  }
}

// THE `match` MAPPING: the serial, always — the pin cannot be held without it — and the model when the reading
// reported one, in the order the reference's own example gives. Both field names come from the reference
// through extdeps.os.ubuntu_autoinstall (autoinstall_match_field_serial / autoinstall_match_field_model), never
// from a string written here, and both values are admitted device-identification tokens, so what can be
// rendered is what extdeps.storage.device_identification said a disk serial may look like. There is no arm for
// `ssd`/`size`/`path` here because there is no field to carry them: this renderer cannot write a match that
// leaves the installer choosing a disk, which is the state the operator's 2026-11-10 review named — and it
// cannot be asked to, rather than being checked before it is allowed to.
fn autoinstall_match_entries(pin: AutoinstallDiskPin) -> List<YamlKeyValue> {
  let serial_entry = kv(
    key: autoinstall_match_field_serial() as String,
    value: yaml_string(s: device_identification_token_text(token: autoinstall_disk_pin_serial(pin: pin)) as String),
  )
  match autoinstall_disk_pin_model(pin: pin) {
    Absent => [ serial_entry ]
    Present { value: model } => append(items: [ serial_entry ], items: [
      kv(
        key: autoinstall_match_field_model() as String,
        value: yaml_string(s: device_identification_token_text(token: model) as String),
      ),
    ])
  }
}

// THE RENDERED USER-DATA, OR THE WRITER'S REFUSAL. extdeps.languages.yaml.emit emit_yaml refuses a
// value it cannot write with its meaning -- a malformed number lexeme, a key held twice, a character
// outside the repertoire it reads back -- and cloud-init is handed bytes, so that refusal travels to
// whoever wanted the media rather than being rendered into the document it is about.
type AutoinstallUserData
  = AutoinstallUserDataRendered { content: String }
  | AutoinstallUserDataRefused { reason: String }

// THE DOCUMENT AND ITS RENDERING ARE TWO STEPS, so a consumer that must audit the document before it is published
// (gunbc.provisioning.public_nocloud_seed) audits the same tree this module renders, never a re-parse of its text.
fn autoinstall_user_data_document(payload: UbuntuAutoinstallPayload) -> YamlValue {
  yaml_mapping(entries: [
    kv(key: "autoinstall", value: yaml_mapping(entries: autoinstall_inner_entries(payload: payload))),
  ])
}

fn autoinstall_user_data(payload: UbuntuAutoinstallPayload) -> AutoinstallUserData {
  cloud_config_user_data(document: autoinstall_user_data_document(payload: payload))
}

// The one #cloud-config rendering of a user-data document.
fn cloud_config_user_data(document: YamlValue) -> AutoinstallUserData {
  let top = document
  match emit_yaml(v: top) {
    EmittedYaml { text: t } => AutoinstallUserDataRendered { content: concat("#cloud-config\n", t) }
    YamlEmitRefused { path: p, reason: r } =>
      AutoinstallUserDataRefused { reason: yaml_emit_refusal_text(module_path: "gunbc.os_install_emit", path: p, reason: r) }
  }
}

// The same contract for the live-session document: its keys are literal and distinct and its one
// int is rendered from an Int, so the writer admits it by construction of this function -- but the
// substrate has no way to say so short of the outcome, so the outcome travels.
fn autoinstall_live_commands_user_data(payload: UbuntuAutoinstallLiveCommands) -> AutoinstallUserData {
  let top = yaml_mapping(entries: [
    kv(key: "autoinstall", value: yaml_mapping(entries: [
      kv(key: "version", value: yaml_int(n: payload.autoinstall_version)),
      kv(key: "interactive-sections", value: yaml_sequence(elements: [yaml_string(s: "*")])),
      kv(key: "early-commands", value: yaml_sequence(elements: map(payload.early_commands, c => yaml_string(s: c)))),
    ])),
  ])
  match emit_yaml(v: top) {
    EmittedYaml { text: t } => AutoinstallUserDataRendered { content: concat("#cloud-config\n", t) }
    YamlEmitRefused { path: p, reason: r } =>
      AutoinstallUserDataRefused { reason: yaml_emit_refusal_text(module_path: "gunbc.os_install_emit", path: p, reason: r) }
  }
}
