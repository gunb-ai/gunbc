module gunbc.os_install_emit

import std.logic { Bool }
import std.optional { Absent, Present }
import std.types { List, String }
import extdeps.os.ubuntu_autoinstall {
  UbuntuAutoinstallPayload,
  AutoinstallIdentity,
  WithIdentity,
  UserDataOnly,
  CloudInitUserEntry,
  AutoinstallStoragePolicy,
  StoragePolicyAbsent,
  StoragePolicyDirectLayout,
  UbuntuAutoinstallLiveCommands,
}
import extdeps.ssh.keys { SshPublicKey, ssh_public_key_canonical_line }
import extdeps.languages.yaml.types {
  YamlValue, YamlKeyValue,
  yaml_mapping, yaml_sequence, yaml_string, yaml_int, yaml_bool,
  kv, empty_yaml_values
}
import extdeps.languages.yaml.emit { emit_yaml, EmittedYaml, YamlEmitRefused, yaml_emit_refusal_text }

fn identity_entries(id: AutoinstallIdentity) -> List<YamlKeyValue> {
  [
    kv(key: "hostname", value: yaml_string(s: id.hostname)),
    kv(key: "username", value: yaml_string(s: id.username)),
    kv(key: "realname", value: yaml_string(s: id.realname)),
    kv(key: "password", value: yaml_string(s: id.hashed_password)),
  ]
}

// THE CLOUD-INIT USER ENTRY, EMITTED WITH CLOUD-INIT'S OWN KEY SPELLINGS (schema-cloud-config-v1.json:
// name, ssh_authorized_keys, lock_passwd, shell, sudo). There is deliberately NO branch that could emit
// `passwd` or `hashed_passwd`: the type CloudInitUserEntry has no such field, so a key-only user cannot
// state a password even by mistake, which is the operator's condition enforced by shape rather than by
// policy. `shell` renders from a CLOSED TYPE (CloudInitUserShell), and the two spellings emitted here are
// exactly the two values gunbc.provisioning.public_nocloud_seed admits at that leaf — so the document this
// emits is the document that audit admits, with no free text in between. `sudo` is a CONSTANT, not a field:
// a locked, passwordless account can only be granted the NOPASSWD rule, and the closed schema admits exactly
// that one string, so there is no choice for a caller to make and none for this renderer to branch on.
// `gecos` is not emitted: the closed schema does not admit it and the type no longer carries it.
fn cloudinit_user_shell_text(shell: CloudInitUserShell) -> NonEmptyStr {
  match shell {
    BashLoginShell => "/bin/bash"
    PosixShell => "/bin/sh"
  }
}

// THE ONE SUDO RULE A LOCKED, PASSWORDLESS ACCOUNT CAN HOLD. It is data rather than a parameter because
// there is nothing else to say: gunbc.provisioning.public_nocloud_seed's user schema admits only this string
// (cloud-init cc_users_groups, sudo), and a rule that asked for a password would lock the account out of its
// own privilege escalation.
data cloudinit_nopasswd_sudo_rule: NonEmptyStr = "ALL=(ALL) NOPASSWD:ALL"

fn cloudinit_user_entries(user: CloudInitUserEntry) -> List<YamlKeyValue> {
  [
    kv(key: "name", value: yaml_string(s: user.name)),
    kv(key: "lock_passwd", value: yaml_bool(b: user.lock_passwd)),
    kv(
      key: "ssh_authorized_keys",
      value: yaml_sequence(elements: map(user.ssh_authorized_keys, k => yaml_string(s: ssh_public_key_canonical_line(k: k)))),
    ),
    kv(key: "shell", value: yaml_string(s: cloudinit_user_shell_text(shell: user.shell))),
    kv(key: "sudo", value: yaml_string(s: cloudinit_nopasswd_sudo_rule)),
  ]
}

fn autoinstall_inner_entries(payload: UbuntuAutoinstallPayload) -> List<YamlKeyValue> {
  // THE ENTRY ROUTE IS READ OFF A DECLARED CHOICE, so this function has no invalid combination to notice.
  // AutoinstallIdentityPosture (extdeps.os.ubuntu_autoinstall) has exactly two arms because upstream has
  // exactly two legal documents: identity present, or user-data present and identity omitted (Canonical:
  // identity "is the only configuration key that must be present (unless the user-data section is present,
  // in which case it is optional)"). The head of the document is the same in both arms — version, locale,
  // keyboard — and then the arms differ in which section follows, at the position identity has always sat.
  // WithIdentity renders exactly the old four identity entries, in the old order, at the old position:
  // byte-for-byte the rendering that predates the key-only posture.
  let head = [
    kv(key: "version", value: yaml_int(n: payload.autoinstall_version)),
    kv(key: "locale", value: yaml_string(s: payload.locale)),
    kv(key: "keyboard", value: yaml_mapping(entries: [
      kv(key: "layout", value: yaml_string(s: payload.keyboard_layout)),
    ])),
  ]
  let with_user_data = match payload.identity_posture {
    // The user-data section sits beside identity, not inside it: upstream reads it as its own section.
    // An empty user list still emits the section, as before — the section's PRESENCE is what makes the
    // identity waiver legal, and refusing on an empty list would silently change which documents upstream
    // accepts. (The seed audit is what refuses a key-only entry with no keys; see the witness's RED.)
    WithIdentity { identity: id, user_data: optional_users } => append(
      append(head, items: [
        kv(key: "identity", value: yaml_mapping(entries: identity_entries(id: id))),
      ]),
      items: match optional_users {
        Present { value: users } => [
          kv(key: "user-data", value: yaml_mapping(entries: [
            kv(key: "users", value: yaml_sequence(elements: map(users, u =>
              yaml_mapping(entries: cloudinit_user_entries(user: u))))),
          ])),
        ]
        Absent => []
      },
    )
    UserDataOnly { users: users } => append(head, items: [
      kv(key: "user-data", value: yaml_mapping(entries: [
        kv(key: "users", value: yaml_sequence(elements: map(users, u =>
          yaml_mapping(entries: cloudinit_user_entries(user: u))))),
      ])),
    ])
  }
  let with_ssh = match payload.ssh {
    Present { value: ssh } => append(with_user_data, items: [
      kv(key: "ssh", value: yaml_mapping(entries: [
        kv(key: "install-server", value: yaml_bool(b: true)),
        kv(key: "authorized-keys", value: yaml_sequence(elements: map(ssh.authorized_keys, k => yaml_string(s: ssh_public_key_canonical_line(k: k))))),
        kv(key: "allow-pw", value: yaml_bool(b: ssh.password_auth)),
      ])),
    ])
    Absent => with_user_data
  }
  if payload.fully_automated {
    let automated = append(with_ssh, items: [
      kv(key: "interactive-sections", value: yaml_sequence(elements: empty_yaml_values)),
    ])
    match payload.storage_policy {
      StoragePolicyAbsent => automated
      StoragePolicyDirectLayout => append(automated, items: [
        kv(key: "storage", value: yaml_mapping(entries: [
          kv(key: "layout", value: yaml_mapping(entries: [
            kv(key: "name", value: yaml_string(s: "direct")),
          ])),
        ])),
      ])
    }
  } else {
    with_ssh
  }
}

// THE RENDERED USER-DATA, OR THE WRITER'S REFUSAL. extdeps.languages.yaml.emit emit_yaml refuses a
// value it cannot write with its meaning -- a malformed number lexeme, a key held twice, a character
// outside the repertoire it reads back -- and cloud-init is handed bytes, so that refusal travels to
// whoever wanted the media rather than being rendered into the document it is about.
type AutoinstallUserData
  = AutoinstallUserDataRendered { content: String }
  | AutoinstallUserDataRefused { reason: String }

// THE DOCUMENT AND ITS RENDERING ARE TWO STEPS, so a consumer that must audit the document before it is published
// (gunbc.provisioning.public_nocloud_seed) audits the same tree this module renders, never a re-parse of its text.
fn autoinstall_user_data_document(payload: UbuntuAutoinstallPayload) -> YamlValue {
  yaml_mapping(entries: [
    kv(key: "autoinstall", value: yaml_mapping(entries: autoinstall_inner_entries(payload: payload))),
  ])
}

fn autoinstall_user_data(payload: UbuntuAutoinstallPayload) -> AutoinstallUserData {
  cloud_config_user_data(document: autoinstall_user_data_document(payload: payload))
}

// The one #cloud-config rendering of a user-data document.
fn cloud_config_user_data(document: YamlValue) -> AutoinstallUserData {
  let top = document
  match emit_yaml(v: top) {
    EmittedYaml { text: t } => AutoinstallUserDataRendered { content: concat("#cloud-config\n", t) }
    YamlEmitRefused { path: p, reason: r } =>
      AutoinstallUserDataRefused { reason: yaml_emit_refusal_text(module_path: "gunbc.os_install_emit", path: p, reason: r) }
  }
}

// The same contract for the live-session document: its keys are literal and distinct and its one
// int is rendered from an Int, so the writer admits it by construction of this function -- but the
// substrate has no way to say so short of the outcome, so the outcome travels.
fn autoinstall_live_commands_user_data(payload: UbuntuAutoinstallLiveCommands) -> AutoinstallUserData {
  let top = yaml_mapping(entries: [
    kv(key: "autoinstall", value: yaml_mapping(entries: [
      kv(key: "version", value: yaml_int(n: payload.autoinstall_version)),
      kv(key: "interactive-sections", value: yaml_sequence(elements: [yaml_string(s: "*")])),
      kv(key: "early-commands", value: yaml_sequence(elements: map(payload.early_commands, c => yaml_string(s: c)))),
    ])),
  ])
  match emit_yaml(v: top) {
    EmittedYaml { text: t } => AutoinstallUserDataRendered { content: concat("#cloud-config\n", t) }
    YamlEmitRefused { path: p, reason: r } =>
      AutoinstallUserDataRefused { reason: yaml_emit_refusal_text(module_path: "gunbc.os_install_emit", path: p, reason: r) }
  }
}
