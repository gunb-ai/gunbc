module gunbc.host_runner_memory_provision


data host_runner_memory_provision_scope_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.host_converge_realize",
    decl_name: "interpret_converge_knob",
    field: WholeDeclaration,
  },
}

data host_runner_memory_provision_scope_note: String = "Path (b) modeled ConvergePlan ensure on assimilation spine (P1:runner-deploy-slot): MemoryMax/MemoryHigh/MemorySwapMax per-slot knobs from gunbc.runner_slot_allocation, shaped as host_effect_apply_gated → ConvergePlan — never hand systemctl. LIVE APPLY now interprets PerSlotMemoryCap to a derived drop-in write + daemon-reload (host_converge_realize KnobEffect) executed through host_effect_realize run_shell_transport (in-process LocalShell), grounded on the REAL exit code — a nonzero exit is a typed NotConverged refusal, never a fabricated exit 0. Read-back verdict helper (per_slot_memory_cap_verdict_from_unit_read) is mandatory on the verify path; apply-path read-back is dissolve-on with the realize scaffold."

data host_runner_memory_provision_realize_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect_realize",
    decl_name: "host_effect_apply_gated",
    field: WholeDeclaration,
  }
}

data runner_memory_cap_knob_names: List<String> = [
  "per_slot_memory_max_bytes",
  "per_slot_memory_high_bytes",
  "per_slot_memory_swap_max_bytes",
]

fn runner_memory_knob_selected(name: String) -> Bool {
  fold(runner_memory_cap_knob_names, init: false, f: (acc, n) => acc || n == name)
}

fn runner_memory_knobs_from(host: HostConverge) -> List<ConvergeKnob> {
  fold(host.knobs, init: [], f: (acc, k) =>
    if runner_memory_knob_selected(name: k.name) { concat(acc, [k]) } else { acc }
  )
}

fn runner_memory_host_converge(host: HostIdentity) -> HostConverge? {
  match host_converge_from_policy(policy: fleet_converge_policy(), host: host) {
    Present { value: full } =>
      let memory_knobs = runner_memory_knobs_from(host: full)
      if memory_knobs.length() == 0 {
        none
      } else {
        Present {
          value: HostConverge {
            identity: full.identity,
            knobs: memory_knobs,
            membership: NoMembershipProbe,
          }
        }
      }
    Absent => none
  }
}

fn runner_memory_cap_readback_verdict(read: RunnerUnitMemoryLiveRead, knob: ConvergeKnob) -> ConvergeVerdict? {
  per_slot_memory_cap_verdict_from_unit_read(read: read, target: knob.target)
}

fn runner_memory_knob_apply_interpreted(knob: ConvergeKnob) -> Bool {
  match interpret_converge_knob(knob: knob) {
    KnobEffect { knob_name: _, effect_script: s } => s != ""
    KnobUnimplemented { target_kind: _, knob_name: _, reason: _ } => false
  }
}

fn host_runner_memory_provision_scope_binds_realize_frontier() -> Bool {
  match host_runner_memory_provision_scope_disposition {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: _ },
    } =>
      m == "gunbc.host_converge_realize" && n == "interpret_converge_knob"
    Terminal { reason: _ } => false
  }
}

fn provision_runner_memory_caps_routes_through_host_effect_apply() -> Bool {
  match host_runner_memory_provision_realize_scaffold {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: _ },
    } =>
      m == "gunbc.host_effect_realize" && n == "host_effect_apply_gated"
    Terminal { reason: _ } => false
  }
}

fn runner_memory_converge_effect(host: HostIdentity) -> HostEffect? {
  match runner_memory_host_converge(host: host) {
    Present { value: host_converge } => Present { value: ConvergePlan { policy: host_converge } }
    Absent => none
  }
}

func provision_runner_memory_caps(host: HostIdentity) -> ProcessExit
  uses net: Network
{
  match host_toolchain_ensure_access(host: host) {
    Present { value: access } =>
      match fleet_compute_host_for_identity(identity: host) {
        Present { value: compute_host } =>
          match runner_memory_converge_effect(host: host) {
            Present { value: effect } =>
              match host_effect_apply_gated(
                access: access,
                target: HostOs { node: compute_host },
                effect: effect,
                evidence: host_effect_converge_loop_evidence,
                transport: access.transport,
                fixture_actor: none,
              ) {
                Converged { evidence: _, applied: _ } => ExitSuccess
                NotConverged { reason: why, applied: _ } => exit_failure(reason: why)
              }
            Absent =>
              exit_failure(
                reason: concat(
                  "host_runner_memory_provision: memory-cap converge knobs absent from fleet_converge_policy for ",
                  host as String
                )
              )
          }
        Absent =>
          exit_failure(
            reason: concat(
              "host_runner_memory_provision: host absent from compute inventory ",
              host as String
            )
          )
      }
    Absent =>
      exit_failure(
        reason: concat(
          "host_runner_memory_provision: no deploy access for host ",
          host as String,
          " — typed refusal, no hand systemctl"
        )
      )
  }
}
