module gunbc.host_runner_memory_provision

import std.types { String, List, Bool, NonEmptyStr }
import std.disposition { Disposition, Scaffold, RealizationDispatch, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import product.placement_supply { HostIdentity }
import gunbc.host_converge {
  fleet_converge_policy,
  HostConverge,
  ConvergeKnob,
  ConvergeVerdict,
  NoMembershipProbe,
  PerSlotMemoryCap,
  SliceProperty,
  gunbc_runner_unit_template,
}
import gunbc.host_converge_slice1 { host_converge_from_policy }
import gunbc.host_toolchain_ensure { host_toolchain_ensure_access }
import gunbc.fleet_converge_apply { fleet_compute_host_for_identity }
import gunbc.host_effect {
  HostEffect,
  ConvergePlan,
  HostOs,
  host_effect_converge_loop_evidence,
}
import gunbc.host_effect_realize { host_effect_apply_gated }
import gunbc.fleet_show_effective_read { per_slot_memory_cap_verdict_from_unit_read }
import gunbc.runner_unit_live_read { RunnerUnitMemoryLiveRead }
import extdeps.os.oomd {
  oomd_managed_oom_memory_pressure_property,
  oomd_managed_oom_memory_pressure_limit_property,
}
import std.realization_reconcile { Converged, NotConverged }

data host_runner_memory_provision_scope_disposition: Disposition = Terminal {
  reason: "srv3 runner memory policy via host-standup converge (operator mandate 2026-07-21; Brief 3 thrash-not-fail extension): MemoryMax/MemoryHigh/MemorySwapMax per-slot knobs plus per_slot_oom_pressure_kill=true and per_slot_oom_pressure_limit_pct percent(60) (ManagedOOMMemoryPressure=kill — horizontal extension of gunbc_oomd_sessions_policy sustained stall-time fraction over second(20) duration window; NOT PSI samples). Knob selection narrows by ConvergeTarget variant (PerSlotMemoryCap for byte caps; SliceProperty on actions-runner@ for OOM policy knobs) — never string-name rosters. All knobs derive from gunbc.runner_slot_allocation + gunbc.runner_slot_oom_policy single authorities, applied as a ConvergePlan host-effect ensure on the assimilation spine (P1:runner-deploy-slot), routed through host_effect_apply_gated — never hand systemctl or raw drop-ins. Values are never fresh literals; per-unit caps derive from gunbc_runner_slot_desired() and runner_instance_glob(host). Read-back is mandatory for byte caps: applied-without-read-back refuses (per_slot_memory_cap_verdict_from_unit_read). FreshStandup apply mode for srv3 is host_converge.gunbc_apply_mode_for_host, not a separate cap row. Live host mutation requires deploy access; absent access yields a typed refusal naming the host."
}

data host_runner_memory_provision_realize_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect_realize",
    decl_name: "host_effect_apply_gated",
    field: WholeDeclaration,
  }
}

fn runner_memory_knob_is_per_slot_memory_cap(knob: ConvergeKnob) -> Bool {
  match knob.target {
    PerSlotMemoryCap { dropin_path: _, instance_glob: _, property: _, bytes_value: _ } => true
    _ => false
  }
}

fn runner_memory_knob_is_runner_slot_oom_policy(knob: ConvergeKnob) -> Bool {
  match knob.target {
    SliceProperty { unit: u, property: p, apply_value: _, expected_effective: _ } =>
      u == gunbc_runner_unit_template
        && (p == oomd_managed_oom_memory_pressure_property || p == oomd_managed_oom_memory_pressure_limit_property)
    _ => false
  }
}

fn runner_memory_cap_knobs_from(host: HostConverge) -> List<ConvergeKnob> {
  fold(host.knobs, init: [], f: (acc, k) =>
    if runner_memory_knob_is_per_slot_memory_cap(knob: k) { concat(acc, [k]) } else { acc }
  )
}

fn runner_memory_provision_knobs_from(host: HostConverge) -> List<ConvergeKnob> {
  fold(host.knobs, init: [], f: (acc, k) =>
    if runner_memory_knob_is_per_slot_memory_cap(knob: k) || runner_memory_knob_is_runner_slot_oom_policy(knob: k) { concat(acc, [k]) } else { acc }
  )
}

fn runner_memory_knobs_from(host: HostConverge) -> List<ConvergeKnob> {
  runner_memory_cap_knobs_from(host: host)
}

fn runner_memory_host_converge(host: HostIdentity) -> HostConverge? {
  match host_converge_from_policy(policy: fleet_converge_policy(), host: host) {
    Present { value: full } =>
      let memory_knobs = runner_memory_provision_knobs_from(host: full)
      if memory_knobs.length() == 0 {
        none
      } else {
        Present {
          value: HostConverge {
            identity: full.identity,
            knobs: memory_knobs,
            membership: NoMembershipProbe,
          }
        }
      }
    Absent => none
  }
}

fn runner_memory_cap_readback_verdict(read: RunnerUnitMemoryLiveRead, knob: ConvergeKnob) -> ConvergeVerdict? {
  per_slot_memory_cap_verdict_from_unit_read(read: read, target: knob.target)
}

fn runner_memory_readback_required_after_apply() -> Bool {
  true
}

fn provision_runner_memory_caps_routes_through_host_effect_apply() -> Bool {
  match host_runner_memory_provision_realize_scaffold {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: _ },
    } =>
      m == "gunbc.host_effect_realize" && n == "host_effect_apply_gated"
    Terminal { reason: _ } => false
  }
}

fn runner_memory_converge_effect(host: HostIdentity) -> HostEffect? {
  match runner_memory_host_converge(host: host) {
    Present { value: host_converge } => Present { value: ConvergePlan { policy: host_converge } }
    Absent => none
  }
}

func provision_runner_memory_caps(host: HostIdentity) -> ProcessExit
  uses net: Network
{
  match host_toolchain_ensure_access(host: host) {
    Present { value: access } =>
      match fleet_compute_host_for_identity(identity: host) {
        Present { value: compute_host } =>
          match runner_memory_converge_effect(host: host) {
            Present { value: effect } =>
              match host_effect_apply_gated(
                access: access,
                target: HostOs { node: compute_host },
                effect: effect,
                evidence: host_effect_converge_loop_evidence,
                transport: access.transport,
                fixture_actor: none,
              ) {
                Converged { evidence: _, applied: _ } => ExitSuccess
                NotConverged { reason: why, applied: _ } => exit_failure(reason: why)
              }
            Absent =>
              exit_failure(
                reason: concat(
                  "host_runner_memory_provision: memory-cap converge knobs absent from fleet_converge_policy for ",
                  host as String
                )
              )
          }
        Absent =>
          exit_failure(
            reason: concat(
              "host_runner_memory_provision: host absent from compute inventory ",
              host as String
            )
          )
      }
    Absent =>
      exit_failure(
        reason: concat(
          "host_runner_memory_provision: no deploy access for host ",
          host as String,
          " — typed refusal, no hand systemctl"
        )
      )
  }
}
