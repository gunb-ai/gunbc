module gunbc.workspace_commissioning_executor_input

import gunbc.workspace_commissioning_input_store { workspace_commissioning_input_read, WorkspaceCommissioningInputPresent, WorkspaceCommissioningInputRefused }

import gunbc.workspace_commissioning_dispatch_operations { workspace_dispatch_grant_path, workspace_dispatch_grant_content, workspace_dispatch_grant_read_operation }

import gunbc.executor_privileged_operation { executor_privileged_operation_elevated_command }
import gunbc.command_runner { run_shell_command_capture }
import extdeps.exec.command { LocalExec }
import extdeps.shell.exec { ProcessOutcome, ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused, ProcessCaptured, ProcessCaptureNotSpawned, ProcessCaptureOutcome}

import extdeps.crypto.hash { Digest, sha256sum_line_digest }
import extdeps.tools.sha256sum { sha256sum_stdin_digest_via_shell, Sha256FileDigest, Sha256FileDigestUnavailable }

import std.types { String, NonEmptyStr, CommitSha, Bool }
import std.algebra { trim }
import extdeps.systemd.systemctl
import gunbc.workspace_commissioning_executor { workspace_commissioning_executor_script }
import gunbc.workspace_commissioning_executor_artifact { workspace_executor_helper_script }
import gunbc.workspace_commissioning_executor_unit { workspace_executor_script_name, workspace_executor_helper_name, workspace_executor_unit_path, workspace_executor_unit_text, workspace_executor_unit_instance_name, workspace_executor_wait_bound }
import gunbc.fleet.fleet_generation_execution { fleet_generation_lock }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.runner.runner_microvm_cell_readiness { StoreRootOwned, StoreNotRootOwned }
import gunbc.runner.runner_microvm_cell_readiness_store { read_store_ownership, OwnershipRead, OwnershipUnread }
import gunbc.workspace_commissioning_executor_plan {
  WorkspaceExecutorPlanBytes, workspace_executor_plan_bytes, WorkspaceExecutorPlanBytesVerified,
}
import gunbc.workspace_commissioning_executor_helper { workspace_executor_actor_observe, WorkspaceExecutorActorObserved, WorkspaceExecutorActorRefused }
import gunbc.build_cache.build_cache_instance { runner_slot_instance_name }
import gunbc.runner.runner_microvm_slot_unit { microvm_controller_root }
import gunbc.live_deploy.release_locus { release_locus_dir, RevisionBoundAtEmission }
import gunbc.runner.runner_microvm_slot_controller {
  bind_slot_host, resolve_network_subject, NetworkSubjectResolved, NetworkSubjectRefused,
}
import gunbc.runner.runner_microvm_host_ready { MicrovmHostBound, MicrovmHostBindingRefused }
import gunbc.runner.runner_microvm_network { SlotNetworkSanitationSubject }

// The reviewed artifacts are one immutable protected CAS value, published by fleet dispatch.
type WorkspaceExecutorInput sole_constructor {
  plan: WorkspaceExecutorPlanBytes
  release_dir: NonEmptyStr
  login: NonEmptyStr
  network: SlotNetworkSanitationSubject
}

type WorkspaceExecutorInputRead
  = WorkspaceExecutorInputObserved { input: WorkspaceExecutorInput }
  | WorkspaceExecutorInputRefused { reason: String }

fn workspace_executor_protected_text(path: String) -> String? {
  match read_store_ownership(path: path) {
    OwnershipRead { ownership: StoreRootOwned } => {
      let read = Filesystem.Read(path: path)
      if read.success { Present { value: read.content } } else { none }
    }
    OwnershipRead { ownership: StoreNotRootOwned { owner_uid: _, mode: _ } } => none
    OwnershipUnread { reason: _ } => none
  }
}

fn workspace_executor_input_observe(slot: NonEmptyStr, executor: NonEmptyStr) -> WorkspaceExecutorInputRead {
  match workspace_executor_actor_observe(slot: slot) {
    WorkspaceExecutorActorObserved { actor } => if actor.invocation != executor {
      WorkspaceExecutorInputRefused { reason: "input reader is not this executor" }
    } else { match workspace_commissioning_input_read(slot: slot) {
      WorkspaceCommissioningInputPresent { bytes: _, plan } => workspace_executor_input_from_plan(plan: plan)
      WorkspaceCommissioningInputAbsent => WorkspaceExecutorInputRefused { reason: "protected reviewed input is unavailable" }
      WorkspaceCommissioningInputRefused { reason: _ } => WorkspaceExecutorInputRefused { reason: "protected reviewed input is unavailable" }
    } }
    WorkspaceExecutorActorRefused { reason: _ } => WorkspaceExecutorInputRefused { reason: "input reader is outside the actual executor" }
  }
}

fn workspace_executor_input_from_plan(plan: WorkspaceExecutorPlanBytes) -> WorkspaceExecutorInputRead {
  let slot = runner_slot_instance_name(slot: plan.provenance.slot)
  match bind_slot_host(slot: plan.provenance.slot) {
    MicrovmHostBound { spec, host: _ } => match resolve_network_subject(slot: plan.provenance.slot) {
      NetworkSubjectResolved { subject } => {
        let installed = release_locus_dir(root: microvm_controller_root,
          revision: RevisionBoundAtEmission { revision: plan.provenance.source_revision as CommitSha })
        match workspace_executor_installed_adapter_verdict(release_dir: installed, slot: slot) {
          AdapterUnreadable { cause: c } =>
            WorkspaceExecutorInputRefused { reason: join(["installed executor grant could not be read: ", c], "") }
          AdapterDiffers => WorkspaceExecutorInputRefused { reason: "installed executor artifacts or loaded unit differ from the reviewed release" }
          AdapterMatches => WorkspaceExecutorInputObserved { input: WorkspaceExecutorInput {
            plan: plan, release_dir: installed as NonEmptyStr, login: spec.job_user, network: subject,
          } }
        }
      }
      NetworkSubjectRefused { refusal: _ } => WorkspaceExecutorInputRefused { reason: "commissioning network subject is unavailable" }
    }
    MicrovmHostBindingRefused { cause: _ } => WorkspaceExecutorInputRefused { reason: "commissioning input is not on its selected host" }
  }
}

fn workspace_executor_owned_text_equals(path: String, expected: String) -> Bool {
  match workspace_executor_protected_text(path: path) {
    Present { value } => value == expected
    Absent => false
  }
}

// THE GRANT DIGEST VERDICT HAS THREE STANDINGS. A digest that was never computed -- by an unspawned
// command, a refused digest utility or an unreadable grant -- matched NOTHING and differed from
// NOTHING: reporting "differs from the reviewed release" from it would be an unheld fact. The cause
// (program and refusal) travels to the refusal instead. Pure over the capture, so the witness drives
// every standing including the never-spawned one.
type WorkspaceExecutorGrantVerdict
  = GrantMatches
  | GrantDiffers
  | GrantUnreadable { cause: String }

fn workspace_executor_grant_digest_verdict(expected: Digest, observed: ProcessCaptureOutcome) -> WorkspaceExecutorGrantVerdict {
  match observed {
    // Nothing was digested, so neither match nor difference is held: a digest read off an unspawned
    // command would be a digest of nothing claiming to be the grant's.
    ProcessCaptureNotSpawned { program: p, cause: why } => GrantUnreadable { cause: join([p, ": ", why], "") }
    ProcessCaptured { outcome } => match outcome {
      ProcessOutputPresent { text } => match sha256sum_line_digest(line: text) {
        Present { value: actual } => if actual == expected { GrantMatches } else { GrantDiffers }
        Absent => GrantUnreadable { cause: join(["the digest command's output is not a digest line: ", trim(s: text)], "") }
      }
      ProcessOutputAbsent => GrantUnreadable { cause: "the digest command returned no output" }
      ProcessRefused { exit_code: e, stderr: s } => GrantUnreadable { cause: join(["the digest command refused: exit ", to_string(e), " ", trim(s: s)], "") }
    }
  }
}

fn workspace_executor_grant_verdict(expected: String) -> WorkspaceExecutorGrantVerdict {
  match read_store_ownership(path: workspace_dispatch_grant_path) {
    OwnershipRead { ownership: StoreRootOwned } => match sha256sum_stdin_digest_via_shell(content: expected) {
      Sha256FileDigest { digest } => workspace_executor_grant_digest_verdict(expected: digest,
        observed: run_shell_command_capture(command: executor_privileged_operation_elevated_command(
          op: workspace_dispatch_grant_read_operation()), transport: LocalExec))
      Sha256FileDigestUnavailable { path: p, reason: r } => GrantUnreadable { cause: join(["the expected grant digest could not be computed for ", p, ": ", r], "") }
    }
    // A grant not root-owned is not the reviewed grant: that difference is a held fact.
    OwnershipRead { ownership: StoreNotRootOwned { owner_uid: _, mode: _ } } => GrantDiffers
    OwnershipUnread { reason: r } => GrantUnreadable { cause: concat("the grant ownership could not be read: ", r) }
  }
}

// THE ADAPTER READBACK HAS THREE STANDINGS TOO: the grant half is unreadable-or-not, and 'differ' is
// only claimed when every check actually answered and one disagreed.
type WorkspaceExecutorAdapterVerdict
  = AdapterMatches
  | AdapterDiffers
  | AdapterUnreadable { cause: String }

fn workspace_executor_installed_adapter_verdict(release_dir: String, slot: NonEmptyStr) -> WorkspaceExecutorAdapterVerdict {
  let unit = workspace_executor_unit_instance_name(slot: slot)
  let fragment = systemd.Systemctl.ShowProperty(unit: unit, property: "FragmentPath")
  let dropins = systemd.Systemctl.ShowProperty(unit: unit, property: "DropInPaths")
  let reload = systemd.Systemctl.ShowProperty(unit: unit, property: "NeedDaemonReload")
  let conjuncts_held = fragment.success && trim(s: fragment.value) == (workspace_executor_unit_path() as String)
    && dropins.success && trim(s: dropins.value) == ""
    && reload.success && trim(s: reload.value) == "no"
    && workspace_executor_owned_text_equals(path: workspace_executor_unit_path() as String,
      expected: workspace_executor_unit_text(release_dir: release_dir, fleet_lock: fleet_generation_lock, wait_bound: workspace_executor_wait_bound))
    && workspace_executor_owned_text_equals(path: join([release_dir, "/", workspace_executor_script_name], ""), expected: workspace_commissioning_executor_script())
    && workspace_executor_owned_text_equals(path: join([release_dir, "/", workspace_executor_helper_name], ""), expected: workspace_executor_helper_script(release_dir: release_dir))
  match workspace_executor_grant_verdict(expected: concat(workspace_dispatch_grant_content(release_dir: release_dir as NonEmptyStr), "\n")) {
    GrantUnreadable { cause: c } => AdapterUnreadable { cause: c }
    GrantDiffers => AdapterDiffers
    GrantMatches => if conjuncts_held { AdapterMatches } else { AdapterDiffers }
  }
}
