module gunbc.host_identity_converge


fn host_identity_precondition_verdict(
  base: gunbc.deployed_intent_v0.DeployedIntentV0,
  observed: gunbc.host_identity_observation.HostIdentityObservation,
  desired: gunbc.deployed_intent_v1.DeployedIntentV1,
) -> gunbc.host_identity_knob.HostIdentityLeafVerdict {
  host_identity_patch_from_intents(
    base_hostname: deployed_intent_observed_short_hostname(d: base),
    observed_hostname: observed.short_hostname,
    desired_hostname: desired.desired_hostname_short as String,
  )
}

fn host_identity_precondition_allows_mutation(verdict: gunbc.host_identity_knob.HostIdentityLeafVerdict) -> Bool {
  keyed_leaf_verdict_fold(
    verdict: verdict,
    fold: std.change.KeyedLeafVerdictFold {
      unchanged: false,
      conflict: false,
      apply_hunk: fn(_, _) { true },
      added: fn(_) { true },
      removed: fn(_) { true },
    },
  )
}

fn host_identity_precondition_permits_apply(verdict: gunbc.host_identity_knob.HostIdentityLeafVerdict) -> Bool {
  host_identity_precondition_allows_mutation(verdict: verdict)
}

fn host_identity_precondition_is_noop(verdict: gunbc.host_identity_knob.HostIdentityLeafVerdict) -> Bool {
  keyed_leaf_verdict_fold(
    verdict: verdict,
    fold: std.change.KeyedLeafVerdictFold {
      unchanged: true,
      conflict: false,
      apply_hunk: fn(_, _) { false },
      added: fn(_) { false },
      removed: fn(_) { false },
    },
  )
}

fn host_identity_precondition_is_conflict(verdict: gunbc.host_identity_knob.HostIdentityLeafVerdict) -> Bool {
  keyed_leaf_verdict_fold(
    verdict: verdict,
    fold: std.change.KeyedLeafVerdictFold {
      unchanged: false,
      conflict: true,
      apply_hunk: fn(_, _) { false },
      added: fn(_) { false },
      removed: fn(_) { false },
    },
  )
}

type HostIdentityPlan
  = ApplyPlan { base: extdeps.dns.domain_name.DnsLabel, desired: extdeps.dns.domain_name.DnsLabel }
  | NoopPlan
  | ConflictPlan { verdict: gunbc.host_identity_knob.HostIdentityLeafVerdict }

fn host_identity_plan_from_verdict(
  verdict: gunbc.host_identity_knob.HostIdentityLeafVerdict,
  base: extdeps.dns.domain_name.DnsLabel,
  desired: extdeps.dns.domain_name.DnsLabel,
) -> HostIdentityPlan {
  match verdict {
    KeyedApplyHunk { from: _, to: _ } => ApplyPlan { base: base, desired: desired }
    KeyedUnchanged => NoopPlan
    KeyedConflict => ConflictPlan { verdict: verdict }
    KeyedVerdictAdded { value: _ } => ConflictPlan { verdict: verdict }
    KeyedVerdictRemoved { value: _ } => ConflictPlan { verdict: verdict }
  }
}

fn host_identity_plan_effect(plan: HostIdentityPlan) -> gunbc.host_effect.HostEffect? {
  match plan {
    ApplyPlan { base: b, desired: d } =>
      Present {
        value: gunbc.host_effect.SetHostnameCas {
          hostnamectl_path: host_identity_hostnamectl_path,
          base: b,
          desired: d,
        }
      }
    NoopPlan => none
    ConflictPlan { verdict: _ } => none
  }
}

data host_identity_hostname_key_source: std.effects.KeySource = std.effects.CompositeKey { fields: ["host", "hostname_short"] }

data host_identity_hostname_effect_shape: EffectShape<std.effects.KeySource> = std.effects.UpsertEffect { key_source: host_identity_hostname_key_source }

data host_identity_hostname_idempotency_evidence: std.effects.IdempotencyEvidence = std.effects.LatticeEffect { shape: host_identity_hostname_effect_shape }

fn host_identity_apply_evidence() -> std.effects.IdempotencyEvidence {
  host_identity_hostname_idempotency_evidence
}

fn host_identity_apply_denied(
  target: gunbc.host_effect.NodeControlPlane,
  effect: gunbc.host_effect.HostEffect,
  transport: gunbc.host_effect.HostEffectTransport,
  reason: String,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  std.realization_reconcile.NotConverged {
    reason: reason,
    applied: gunbc.host_effect.HostEffectIntent {
      target: target,
      effect: effect,
      evidence: host_identity_apply_evidence(),
      transport: transport,
      privilege_denial: none,
    },
  }
}

fn host_identity_apply_gated(
  access: gunbc.ci_deploy_access.DeployAccess,
  target: gunbc.host_effect.NodeControlPlane,
  plan: HostIdentityPlan,
  transport: gunbc.host_effect.HostEffectTransport,
  fixture_actor: gunbc.ci_deploy_access.DeployAccessActor?,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>? {
  match host_identity_plan_effect(plan: plan) {
    Present { value: effect } =>
      Present {
        value: host_effect_apply_gated(
          access: access,
          target: target,
          effect: effect,
          evidence: host_identity_apply_evidence(),
          transport: transport,
          fixture_actor: fixture_actor,
        )
      }
    Absent => none
  }
}

fn host_identity_read_back_matches(
  observed: gunbc.host_identity_observation.HostIdentityObservation,
  desired_hostname: extdeps.dns.domain_name.DnsLabel,
) -> Bool {
  observed.short_hostname == (desired_hostname as String)
}

fn host_identity_observation_live(
  target: gunbc.host_effect.NodeControlPlane,
  transport: gunbc.host_effect.HostEffectTransport,
  probed_at: std.types.NonEmptyStr,
) -> gunbc.host_identity_observation.HostIdentityObservation? {
  match host_identity_observation_from_apply(
    r: host_identity_observation_apply(target: target, transport: transport),
    probed_at: probed_at,
  ) {
    Present { value: obs } => Present { value: obs }
    Absent => none
  }
}

fn host_identity_unprivileged_refusal_has_no_marker(
  r: std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>,
  marker: String,
) -> Bool {
  match r {
    NotConverged { reason: why, applied: intent } =>
      !string_contains(s: why, pattern: marker)
        && match intent.privilege_denial {
          Present { value: std.access.Deny { refusal: _ } } => true
          _ => false
        }
    std.realization_reconcile.Converged { evidence: _, applied: _ } => false
  }
}

fn host_identity_privilege_denial_reason(
  r: std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>,
) -> String {
  match r {
    NotConverged { reason: why, applied: intent } =>
      match intent.privilege_denial {
        Present { value: d } => deploy_access_decision_reason(d: d)
        Absent => why
      }
    std.realization_reconcile.Converged { evidence: _, applied: _ } => ""
  }
}

fn host_identity_apply_converged(
  r: std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>,
) -> Bool {
  reconciliation_converged(r: r)
}
