module gunbc.target_syntax_transcription

import std.types { List, NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// THE TARGET-SYNTAX DEBT LEDGER: application code that names a target language's syntax, and what
// would let it stop.
//
// THE RULE IT IS DEBT AGAINST (gunbc.design_argument::closed_grounded_substrate, "one grammar, read in both directions"): an
// application is ordinary .dag, and emitting it to a target language is that language's grammar rows
// read backward through the shared target model (v2.std.compilers.target_model) -- a new target is
// rows in extdeps/languages, never an edit to the application. Rust is emitted that way. Swift and
// TypeScript application code mostly is not yet: where the emit route could not print what an app
// needed, its modules build the target's syntax tree themselves (sw_* from v2.extdeps.languages.swift.syntax,
// ts_* from extdeps.languages.typescript), or the target source is written by hand outside .dag. That
// is admitted in the short term (operator, 2026-11-04) on the condition that all of it is tracked
// here with what would dissolve it.
//
// TWO KINDS OF ROW.
// - A TRANSCRIBED TREE: a module that constructs target syntax. It dissolves when the emit route
//   prints the module's facts from ordinary .dag and the module stops importing the target's
//   constructors; its consumer then reads the emitted artifact through the route, not the tree.
// - HAND-WRITTEN SOURCE: a target file with no .dag authority at all. It dissolves when a model
//   exists that the route can print it from.
// Where a row's debt is already recorded with its own dissolution, the row CITES that record
// (DebtRecordedAt) instead of restating it, so the ledger never becomes a second authority for a
// trigger another module owns.
//
// SCOPE, AND WHAT THIS IS NOT. The rows are the application modules a reading found at the revision
// cited by gunbc.integration_concern target_syntax_built_by_hand_in_application_modules, with the
// command that produced it. It is not a census and gates nothing: a module that starts naming target
// syntax is not refused for being absent here; it is added when noticed. Excluded on purpose: the
// grammars themselves (extdeps/languages, src/v2/extdeps/languages) and the compiler's emit and parse
// claims, which test the target languages and must name their syntax; captured fixtures of served
// output (dag/test/fixture/gunb_ai); and the Python transport harness under test/namecheap, which no
// one has yet decided is application code. Other targets (bash, YAML, CSS, HTML) were not read.

type TargetLanguage = TargetSwift | TargetTypeScript

type TranscriptionDebt
  = DebtRecordedAt { record: DeclarationRef }
  | DebtRecordedHere { dissolution: DissolutionCondition }

type TargetSyntaxDebt
  = TranscribedTree {
      builder: DeclarationRef
      target: TargetLanguage
      emits: NonEmptyStr
      debt: TranscriptionDebt
    }
  | HandWrittenSource {
      path: NonEmptyStr
      target: TargetLanguage
      debt: TranscriptionDebt
    }

// ── What would dissolve the rows that have no record of their own ─────────────────────────────

// The browser clients: each builds the statements of a served script by hand. Two capabilities are
// owed, and the second is useless without the first.
data typescript_browser_client_dissolution: DissolutionCondition = unbound_dissolution(
  description: "DISSOLVES WHEN (a) the browser surfaces these clients use -- DOM query, attribute and class edits, event listeners, timers, fetch, localStorage, Web Audio -- are modelled as extdeps (the WHATWG and W3C specifications, one module each, cited), SUFFICIENT FOR a client's behaviour to be written as ordinary .dag over them, and (b) the v2 emit route prints such a module to TypeScript through v2.std.compilers.target_model and the typescript grammar rows, SUFFICIENT FOR the served script to be produced from that module with the client no longer importing extdeps.languages.typescript constructors",
)

// The server emitter builds a Node.js program; Node's http module is the surface it needs.
data typescript_node_server_dissolution: DissolutionCondition = unbound_dissolution(
  description: "DISSOLVES WHEN Node.js's http and fs surfaces are modelled as extdeps and the v2 emit route prints a module written over them to TypeScript, SUFFICIENT FOR emit_node_http_static_server_program's program to be produced from an ordinary .dag description of the static server",
)

// The two Swift printers that already read a model: the facts are derived, only the syntax is
// hand-built. Their trigger is the general one for Swift declarations.
data swift_model_printer_dissolution: DissolutionCondition = unbound_dissolution(
  description: "DISSOLVES WHEN the v2 emit route prints a module's coproducts, records and total functions to Swift through the closure-emit door (the swift_decl rows, gunbc#12218) with statements and switch bodies, SUFFICIENT FOR the printed file to be emitted from the model module itself (gunbc.approve_ios_enrolment_machine, gunbc.approve_ios_operation_errors) so the printer module can be deleted",
)

