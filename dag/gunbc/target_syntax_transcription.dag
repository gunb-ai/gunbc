// ── Readings ──────────────────────────────────────────────────────────────────────────────────
// Consumed by gunbc.integration_concern target_syntax_built_by_hand_in_application_modules, whose
// affected set is these declarations, so the concern is relevant to any change touching a row.

fn debt_record(d: TargetSyntaxDebt) -> TranscriptionDebt {
  match d {
    TranscribedTree { builder: _, target: _, emits: _, debt: r } => r
    HandWrittenSource { path: _, target: _, debt: r } => r
  }
}

// The declarations a debt implicates: the tree's builder, and wherever its debt is recorded. A
// hand-written file has no declaration of its own, only its record.
fn debt_declarations(d: TargetSyntaxDebt) -> List<DeclarationRef> {
  let recorded = match debt_record(d: d) {
    DebtRecordedAt { record: r } => [r]
    DebtRecordedHere { dissolution: _ } => []
  }
  match d {
    TranscribedTree { builder: b, target: _, emits: _, debt: _ } => concat([b], recorded)
    HandWrittenSource { path: _, target: _, debt: _ } => recorded
  }
}
