module gunbc.information_retrieval

import std.types { String, NonEmptyStr, List, EpochMs }
import extdeps.uri { Uri, uri_wire }
import extdeps.http.client
import extdeps.external_authority { ExternalAuthority }
import std.citation {
  CitationRetrievalRequest,
  CitationUnreachable,
  TransportUnreachable,
  CitationTarget,
  CitationSelector,
  verify_citation_representation,
}
import std.claim_evidence {
  RecordedFactId,
  EvidenceProvenance,
  EvidenceDirection,
}
import gunbc.information_query {
  InformationEvidence,
  InformationEvidenceUnobservable,
  InformationTemporalScope,
  InformationEvidenceProbeIndependence,
  information_evidence_from_verification,
}

// THE RETRIEVAL REALIZATION, WHICH IS WHY IT IS NOT IN gunbc.information_query. That module owns
// what may become admissible evidence; this one owns the transport that produces an observation for
// it to judge. DESIGN section 3 keeps interface, realization and policy apart, and binding curl into
// the evidence join would fuse the transport to the decision -- one of N handlers written as though
// it were a fact about the concept.

// A RESPONSE THIS TRANSPORT CANNOT WITNESS DOES NOT BECOME AN OBSERVATION. http.Client.GetBounded
// reports only body and success: the HTTP status is never observed, and reconciling bytes against a
// pin needs a sha256 over the body that no in-memory realization provides. Constructing a
// CitationRetrievalObservation here would mean writing an unobserved status into an observation
// record -- fabricated plausible output (DESIGN section 5), committed by the very path whose purpose
// is to stop unverified material from acquiring verified standing. So the reachable case produces NO
// observation at all: it is typed InformationEvidenceUnobservable and refuses.
//
// Only the unreachable case yields an observation, because every field of it is genuinely witnessed:
// the request we issued, the moment we issued it, and a transport that did not complete.
//
// THE CAPABILITY THIS WAITS ON is a retrieval operation that reports what it actually saw -- the
// response status, and a digest of the body -- rather than a bare success flag. Named as a
// capability rather than a pull request, because a trigger naming an artifact is satisfied while the
// capability stays dead (DESIGN 4b(3)).

// THE JOIN, so that this module is a consumer of gunbc.information_query and not a second evidence
// authority beside it. Every arm routes through verify_citation_representation and the module's own
// fold; nothing here decides admissibility.
fn information_retrieve_evidence(
  target: CitationTarget<CitationSelector>,
  observed_at: EpochMs,
  fact_id: RecordedFactId,
  scope: InformationTemporalScope,
  direction: EvidenceDirection,
  authority: ExternalAuthority,
  provenance: EvidenceProvenance,
  freshness_basis: NonEmptyStr,
  fidelity_losses: List<NonEmptyStr>,
  independence: InformationEvidenceProbeIndependence,
) -> InformationEvidence {
  let request = CitationRetrievalRequest {
    locator: target.expected_pin.subject.access_route,
  }
  let got = http.Client.GetBounded(url: uri_wire(uri: request.locator))
  if got.success {
    InformationEvidenceUnobservable {
      detail: "a response was served, but this transport reports neither its status nor a digest of its body, so no citation observation can be witnessed" as NonEmptyStr,
    }
  } else {
    information_evidence_from_verification(
      fact_id: fact_id,
      outcome: verify_citation_representation(
        target: target,
        observation: CitationUnreachable {
          request: request,
          observed_at: observed_at,
          cause: TransportUnreachable,
        },
      ),
      scope: scope,
      direction: direction,
      authority: authority,
      provenance: provenance,
      freshness_basis: freshness_basis,
      fidelity_losses: fidelity_losses,
      independence: independence,
    )
  }
}
