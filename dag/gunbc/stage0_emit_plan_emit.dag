module gunbc.stage0_emit_plan_emit


type Stage0EmitPlanGenerationOutcome
  = Stage0EmitPlanGenerated { content: String }
  | Stage0EmitPlanGenerationRefused

fn escape_dag_string_body(s: String) -> String {
  replace(replace(replace(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")
}

fn render_dag_string_list_items(xs: List<String>) -> String {
  fold(xs, init: "", f: fn(acc, item) {
    let line = concat("  \"", escape_dag_string_body(s: item), "\"")
    if acc == "" { line } else { concat(acc, concat(",\n", line)) }
  })
}

fn render_dag_string_list(xs: List<String>) -> String {
  concat("[\n", concat(render_dag_string_list_items(xs: xs), "\n]"))
}

fn render_stage0_emit_plan_generated_dag(rows: List<Stage0EmissionPlanRow>) -> String {
  concat(
    "module gunbc.stage0_emit_plan_generated\n\n",
    "import std.types { List, String }\n\n",
    "data stage0_emit_plan_generated_note: String = \"Generated projection — do not hand-edit. Authority: gunbc.stage0_emit_plan over parse-derived regen source identities. DECLARED SCAFFOLD supply; dissolve-on: generated_artifact_gate accepts v2.compiler.source_authority.ModuleStorageIndex, then the host supply deletes. Regen via dag/tools/generated_artifact_gate.dag main_wet.\"\n\n",
    "data generated_stage0_files: List<String> = ",
    render_dag_string_list(xs: generated_stage0_files_from_plan_rows(rows: rows)),
    "\n\n",
    "data generated_stage0_paths: List<String> = ",
    render_dag_string_list(xs: generated_stage0_paths_from_plan_rows(rows: rows)),
    "\n"
  )
}

fn stage0_emit_plan_generation_from_outcome(outcome: Stage0EmissionPlanOutcome) -> Stage0EmitPlanGenerationOutcome {
  match outcome {
    Stage0EmissionPlanRefused { cause: _ } => Stage0EmitPlanGenerationRefused
    Stage0EmissionPlanAccepted { rows } => Stage0EmitPlanGenerated {
      content: render_stage0_emit_plan_generated_dag(rows: rows)
    }
  }
}

fn expected_stage0_emit_plan_generated_dag() -> Stage0EmitPlanGenerationOutcome {
  stage0_emit_plan_generation_from_outcome(outcome: stage0_emission_plan())
}
