module gunbc.native_process_memory_census_seed_growth

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// FORWARD-FREEZE RECEIPT for the hand Rust behind `gunbc test //gunbc/instruments:native-process-memory-census`.
// Same shape and owner as gunbc.type_declaration_use_census_seed_growth.
//
// PURPOSE (gunbc.v1.v1_maintenance_standing v1_seed_standing). The instrument measures the NATIVE v2
// binary, the self-host program's product; it invests nothing in the seed's own memory. Every decision
// -- the workload's identity, the stage reached, the peak as a std.realization_measurement
// ResidencyObservation, the control discrimination and the standing -- is a .dag fold
// (gunbc.instruments.native_process_memory_reading). The host Rust performs only what no fold can:
// write the control root from the reader's rows, spawn the prepared binary twice through a small trampoline that reaps each
// child with wait4, and pass the readings to the reader.
//
// WHAT IS NOT NETTED. The NativeProcessMemory arm on V2NativeCensusReading and the registry row extend
// existing rosters. reader_standing_outcome is the type-declaration census's existing CliWireResponse
// classification, lifted out so the two producers share it rather than copy it.
data native_process_memory_census_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.target_invocation_host", decl_name: "NativeCensusVerb", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.target_invocation_host", decl_name: "NativeMeasuredWorkload", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.target_invocation_host", decl_name: "run_native_process_memory", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "NativeChildMeasured", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "NativeProcessMemoryRuns", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "run_native_child_measured", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "MEASURED_SPAWN_RECEIPT_ENV", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "measured_spawn_trampoline", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "MEASURED_SPAWN_OPERAND", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "MEASURED_SPAWN_DIR", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "MeasuredSpawnRoute", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "measured_spawn_route", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "measured_spawn_run_dir", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "measured_spawn_receipt_in", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_lane_runner", decl_name: "run_native_process_memory_runs", field: WholeDeclaration }
  ],
  reason: "gunbc test //gunbc/instruments:native-process-memory-census reads the native v2 binary's own peak resident bytes and wall time, which needs a prepared native binary, two spawns and a wait4 reap per child -- process effects no .dag fold performs. NativeCensusVerb and NativeMeasuredWorkload mirror gunbc.instruments.native_process_memory_reading's types for the binding row. run_native_process_memory writes the control root from native_process_memory_control_path / native_process_memory_control_content, calls run_native_process_memory_runs (one prepare_emitted_compiler, two run_native_child_measured spawns, each through measured_spawn_trampoline: the seed executable re-entered at the top of gunbc test before any work, because Linux seeds ru_maxrss at exec from the replaced address space and a child spawned straight from the emitting seed inherited the seed's peak) and hands both NativeChildMeasured readings to native_process_memory_standing, which decides.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete these items when gunbc test runs on the v2-native CLI with a native instrument door that can spawn a child, reap it with its resource usage, and read its output as values, so the reader is called by a .dag entry rather than by host Rust.",
  current_boundary: "Reachable only from the gunbc test arm for this label and, for the trampoline, only through the reserved operand //gunbc/internal:measured-spawn that run_native_child_measured alone emits: measured_spawn_route refuses GUNBC_MEASURED_SPAWN_RECEIPT beside any other operand, the reserved operand without it, and a receipt outside MEASURED_SPAWN_DIR. Writes only under target/native-process-memory-census (MEASURED_SPAWN_DIR), inside one directory per invocation created exclusively by measured_spawn_run_dir (emitted_closure_compile_host create_private_probe_root) that holds the control root, the receipt and its argv file and is removed whole by that invocation alone, spawns only the prepared native binary, decides no verdict, and substitutes no value for a refused run: every failure returns a typed InvocationOutcome (SubjectUnreached or Refused)."
}
