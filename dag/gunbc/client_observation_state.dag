module gunbc.client_observation_state

type ClientObservationState
  = ClientObservationPending
  | ClientObservationOff
  | ClientObservationOn
  | ClientObservationRefused { reason: String }

data client_observation_state_note: String = "The shared presentation-grain state of an asynchronous observation, first consumed by roadmap workflow lamps and reserved for the floor-verdict rollup on the same belt-B surface. Pending means no answer has arrived. Off means a successful observation asserted absence. On means a successful observation asserted presence. Refused carries why the set is unknowable. These four states may not collapse: dark cannot mean both observed-absent and unknowable, just as a missing floor verdict cannot render as checks-passing. This is transient client read state, never a persisted workflow status."

fn client_observation_state_from(
  refused: Bool,
  asserted: Bool,
  reason: String,
) -> ClientObservationState {
  if refused {
    ClientObservationRefused { reason: reason }
  } else if asserted {
    ClientObservationOn
  } else {
    ClientObservationOff
  }
}

fn client_observation_state_key(state: ClientObservationState) -> String {
  match state {
    ClientObservationPending => "pending"
    ClientObservationOff => "off"
    ClientObservationOn => "on"
    ClientObservationRefused { reason: _ } => "refused"
  }
}

fn client_observation_state_reason(state: ClientObservationState) -> String {
  match state {
    ClientObservationPending => ""
    ClientObservationOff => ""
    ClientObservationOn => ""
    ClientObservationRefused { reason } => reason
  }
}

fn client_observation_state_is_on(state: ClientObservationState) -> Bool {
  match state {
    ClientObservationPending => false
    ClientObservationOff => false
    ClientObservationOn => true
    ClientObservationRefused { reason: _ } => false
  }
}
