module gunbc.workflow_escalation

import std.types { NonEmptyStr, String, Bool, Timestamp }
import std.scoped_authorization {
  AuthorizationRequest,
  ScopedAuthorization,
  AuthorizationDecision,
  AuthorizationPermitted,
  AuthorizationRefused,
  AuthorizationRefusalCause,
  AuthorizationNotGranted,
  AuthorizationExpired,
  AuthorizationAlreadyCompleted,
  AuthorizationClaimedByOtherAttempt,
  AuthorizationAborted,
  AuthorizationEscalationMismatch,
  AuthorizationScopeNotGranted,
  AuthorizationScopesUnstated,
  AuthorizationAttemptMismatch,
  AuthorizationIntentMismatch,
  AuthorizationIntentIncomparable,
  authorize,
  authorization_refusal_reason,
}

// WHAT MOVED AND WHY. This module used to declare WorkflowEscalation { escalation_id, rationale,
// destructive } and WorkflowApprovalState = PendingApproval | ApprovalGranted { escalation_id,
// granted_by }. Both are dissolved into std.scoped_authorization, which carries the same act with
// the five facts the pair was missing -- what access, on which resource, for which attempt, until
// when, and for what stated purpose. The move is not a relocation for tidiness: a SECOND instance
// of the identical shape is landing (the Spark first-boot agreement acceptance, which authorizes
// one action on one device for one attempt and must refuse on absence, staleness and mismatch),
// and modeling it beside this one would have been the §3 fork. std.temporal_effect's
// DurableApprovalGrant -- the pre-existing fork of the SAME meaning, with expiry and single-use
// modeled and zero production consumers -- is dissolved into it in the same motion.
//
// WHAT STAYS HERE, because it is genuinely a different fact: whether a WORKFLOW STEP may run.
// std.scoped_authorization answers "is this authorization valid for this request"; the projection
// below answers "therefore, what does the step do". The two are separable -- the same decision
// drives a step, a fleet phase, or a wizard screen -- and only the second is workflow vocabulary.

type WorkflowStepDisposition<Subject>
  = StepRunnable
  | StepBlocked { reason: String }
  | StepAwaitingApproval { request: AuthorizationRequest<Subject> }

// THE FAIL-CLOSED SPLIT, and it is the whole safety content of this projection. Exactly ONE
// refusal cause -- nobody has granted anything yet -- routes to StepAwaitingApproval, the arm a
// caller is expected to answer by asking the operator. EVERY other cause routes to StepBlocked:
// an expired grant, a grant for a different attempt, a grant whose scope does not reach the
// requested resource, and a grant issued against a different planned action are not "still
// waiting", they are a live disagreement between what was approved and what is about to run.
// Folding them into the awaiting arm would make the natural remedy "ask again and it will
// proceed", which is the absorbing fallback DESIGN §5 names: the precise deficit disappears and
// the widened arm succeeds. So the disagreement blocks, carrying its own located cause.
fn workflow_step_disposition_for_authorization<Subject>(
  request: AuthorizationRequest<Subject>,
  authorization: ScopedAuthorization<Subject>,
  observed_at: Timestamp,
) -> WorkflowStepDisposition<Subject> {
  workflow_step_disposition_for_decision(
    request: request,
    decision: authorize(
      authorization: authorization,
      request: request,
      observed_at: observed_at,
    ),
  )
}

// THE ARM THE DENIAL DISTINCTION EXISTS FOR. StepAwaitingApproval is what makes the workflow ask
// the operator again; every other cause blocks. Routing a denial to that arm would re-notify them
// forever, so while a deny could not be represented separately from absence this fold had exactly
// one terminal state -- eventual yes. AuthorizationDeniedByOperator blocks, carrying the operator's
// own reason through to the disposition.
fn workflow_step_disposition_for_decision<Subject>(
  request: AuthorizationRequest<Subject>,
  decision: AuthorizationDecision<Subject>,
) -> WorkflowStepDisposition<Subject> {
  match decision {
    AuthorizationPermitted { grant: _ } => StepRunnable
    AuthorizationRefused { cause: cause } =>
      match cause {
        AuthorizationNotGranted { escalation_id: _ } =>
          StepAwaitingApproval { request: request }
        AuthorizationDeniedByOperator { escalation_id: _, denied_by: _, denied_at: _, reason: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationExpired { expires_at: _, observed_at: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationAlreadyCompleted { completed_by: _, completed_at: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationClaimedByOtherAttempt { requested: _, holder: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationAborted { aborted_by: _, cause: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationEscalationMismatch { requested: _, granted: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationScopeNotGranted { required: _, granted: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationScopesUnstated { escalation_id: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationAttemptMismatch { requested: _, granted: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationIntentMismatch { requested: _, granted: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
        AuthorizationIntentIncomparable { requested: _, granted: _ } =>
          StepBlocked { reason: authorization_refusal_reason(cause: cause) }
      }
  }
}

fn workflow_step_is_runnable<Subject>(disposition: WorkflowStepDisposition<Subject>) -> Bool {
  match disposition {
    StepRunnable => true
    StepBlocked { reason: _ } => false
    StepAwaitingApproval { request: _ } => false
  }
}

// The refusal sentence a caller puts in front of a human. The empty string is reserved for the
// runnable arm ALONE, and every caller reads it as "no refusal" -- so no refusing arm may render
// "" and no arm may fall through to a default (§5: one refusal, one destination).
fn workflow_destructive_step_refusal_reason<Subject>(disposition: WorkflowStepDisposition<Subject>) -> String {
  match disposition {
    StepRunnable => ""
    StepBlocked { reason: r } => r
    StepAwaitingApproval { request: req } =>
      concat(
        "operator approval required before ",
        concat(req.escalation_id as String, concat(": ", req.purpose as String)),
      )
  }
}
