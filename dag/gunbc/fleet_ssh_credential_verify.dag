module gunbc.fleet_ssh_credential_verify


// WHICH KEY IS ACTUALLY IN THE FILE, observed rather than declared.
//
// A `FleetSshCredentialBinding` names the credential an SSH leg authenticated with, and that name is
// only worth carrying if something established it. Until this module the identity-file route
// established nothing: `spark_credential_workflow` fetched Secret Manager `versions/1` into a file
// and then constructed a binding from `fleet_automation_ssh_key.material`, a constant read out of
// `gunbc.fleet_ssh_access`. The two were never compared. A rotated secret, a wrong pinned version, a
// truncated fetch, or a materialization that wrote the wrong bytes all produce the same binding and
// the same receipt.
//
// The comparison is separated from the observation on purpose. `classify_derived_public_key_line` is
// pure and total over the process observation, so every arm -- match, mismatch, refusal, empty
// output -- is reachable by a hermetic witness with no key on disk and no `ssh-keygen` on the host.
// The effectful half does nothing but run the command and hand its result over, so there is no
// judgment inside the part that cannot be tested.

data fleet_ssh_credential_shell_verification_supersession_note: String = "gunbc.ci_spec gunbc_ci_fleet_key_agent_script derives the public key with `ssh-keygen -y` and compares its fingerprint to fleet_automation_ssh_key_fingerprint inside a hand-authored GitHub Actions run: fragment. That check is correct and it is the reason the CI agent route is not exposed to the defect this module closes -- but it answers, in emitted shell, the question this module now owns in the model, and it protects only the route it is spliced into. It is not deleted here because that fragment is a foreign-executor (GitHub Actions run:) step which already carries gunbc_ci_fleet_key_agent_shell_emit_dissolution_trigger: it dissolves when the typed secret-materialization effect lands on host_effect_apply. THIS note records that when it does, the verification half must route through classify_derived_public_key_line rather than being re-spelled a third time, and that the two checks must not be allowed to disagree in the interim -- both read the same declared authority for the expected key."

// The line `ssh-keygen -y -f FILE` prints for a public key: the registered wire token, a space, and
// the base64 material. Built from the modeled key so the check covers the ALGORITHM as well as the
// material -- a file holding a different key type is a mismatch, not a passed comparison on a field
// that happened to be absent.
fn expected_public_key_line(key: extdeps.ssh.SshPublicKey) -> String {
  join([extdeps.ssh.ssh_key_algorithm_token(a: key.algorithm) as String, " ", key.material as String], "")
}

type FleetSshCredentialVerification =
    FleetSshCredentialVerified { binding: gunbc.fleet_known_hosts_anchor.FleetSshCredentialBinding }
  | FleetSshCredentialIdentityMismatch { expected_line: String, observed_line: String }
  | FleetSshCredentialDerivationRefused { cause: String }

// Pure and total. Note what the success arm does NOT do: it does not treat a zero exit as evidence
// on its own. `ssh-keygen -y` exiting 0 with output that is not the expected key is a MISMATCH, and
// an exit of 0 with empty output falls into the same arm rather than passing -- the empty string is
// not equal to the expected line and does not carry it as a prefix, so the fail-closed direction is
// a consequence of the comparison rather than a special case somebody remembered to write.
//
// The trailing-space form is admitted because ssh-keygen may append a comment. Requiring the space
// matters: a bare `starts_with` would accept a longer material sharing the expected one as a prefix.
//
// The material handed to the mint is the material OBSERVED: equality with the expected line has just
// been established over both the algorithm token and the material, so `expected_key.material` and the
// bytes in the file are the same bytes at that point. Hashing that constant WITHOUT first proving the
// equality is precisely the superseded route this module replaces.
fn classify_derived_public_key_line(
  identity_file: std.types.NonEmptyStr,
  expected_key: extdeps.ssh.SshPublicKey,
  derivation_succeeded: std.types.Bool,
  derivation_stdout: String,
  derivation_stderr: String,
) -> FleetSshCredentialVerification {
  if derivation_succeeded {
    let observed = std.algebra.trim(s: derivation_stdout)
    let expected = expected_public_key_line(key: expected_key)
    if observed == expected || starts_with(s: observed, prefix: concat(expected, " ")) {
      FleetSshCredentialVerified {
        binding: gunbc.fleet_known_hosts_anchor.fleet_ssh_credential_binding_of_derived_material(
          identity_file: identity_file,
          derived_material: expected_key.material,
        ),
      }
    } else {
      FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed }
    }
  } else {
    FleetSshCredentialDerivationRefused {
      cause: concat("ssh-keygen -y refused for the materialized identity file: ", std.algebra.trim(s: derivation_stderr)),
    }
  }
}

// The observation, carrying no judgment. `LocalExec` because the identity file is on the machine
// running the workflow; this must never reach a remote host, since the whole point is to decide
// whether to contact one at all.
func derive_identity_file_public_key_line(identity_file: std.types.NonEmptyStr) -> gunbc.command_runner.ShellCaptureResult
  uses net: std.resources.Network
{
  gunbc.command_runner.run_shell_command_capture(
    command: extdeps.exec.command.ArgvCommand { argv: ["ssh-keygen", "-y", "-f", identity_file as String] },
    transport: extdeps.exec.command.LocalExec,
  )
}

// THE ROUTE. Observe, then judge. A mismatch here contacts no host: the caller holds a verification
// with no binding in it, and `FleetSshExecutionContext` cannot be assembled without one.
func verify_fleet_ssh_credential(
  identity_file: std.types.NonEmptyStr,
  expected_key: extdeps.ssh.SshPublicKey,
) -> FleetSshCredentialVerification
  uses net: std.resources.Network
{
  let observation = derive_identity_file_public_key_line(identity_file: identity_file)
  classify_derived_public_key_line(
    identity_file: identity_file,
    expected_key: expected_key,
    derivation_succeeded: observation.success,
    derivation_stdout: observation.stdout,
    derivation_stderr: observation.stderr,
  )
}

// ── The agent arm ───────────────────────────────────────────────────────────────────────────────
//
// Same question, different observation. The private half is held by an agent and never appears on
// disk, so there is no file to derive a public key from; what CAN be observed is the agent's own
// listing, and `ssh-add -l` prints one line per identity as `<bits> <fingerprint> <comment> (<type>)`.
// The declared fingerprint authority is `gunbc.fleet_ssh_access` `fleet_automation_ssh_key_fingerprint`,
// which is the same constant the hand-authored CI shell compares against today.
//
// The membership test is space-delimited rather than a bare substring: the haystack is padded on both
// sides and the needle carries its own surrounding spaces, so a fingerprint that merely CONTAINS the
// declared one as a prefix is not a match. `ssh-add -l` always prints the bit count before the
// fingerprint and a comment or type after it, so both delimiters are present on a real line.
fn agent_listing_lists_fingerprint(listing: String, fingerprint: std.types.NonEmptyStr) -> std.types.Bool {
  string_contains(
    join([" ", listing, " "], ""),
    join([" ", fingerprint as String, " "], ""),
  )
}

// Fail-closed on the states `ssh-add` distinguishes and a Boolean would flatten. Exit 1 is "the agent
// has no identities" and exit 2 is "cannot connect to the agent" -- both arrive here as a failed
// derivation, and neither may produce a binding. An empty listing on a ZERO exit is likewise a
// mismatch, because the empty string does not contain the fingerprint.
fn classify_agent_key_listing(
  agent_socket: std.types.NonEmptyStr,
  public_selector_file: std.types.NonEmptyStr,
  expected_key: extdeps.ssh.SshPublicKey,
  expected_fingerprint: std.types.NonEmptyStr,
  listing_succeeded: std.types.Bool,
  listing_stdout: String,
  listing_stderr: String,
) -> FleetSshCredentialVerification {
  if listing_succeeded {
    if agent_listing_lists_fingerprint(listing: listing_stdout, fingerprint: expected_fingerprint) {
      FleetSshCredentialVerified {
        binding: gunbc.fleet_known_hosts_anchor.fleet_ssh_agent_credential_binding_of_listed_key(
          agent_socket: agent_socket,
          public_selector_file: public_selector_file,
          listed_material: expected_key.material,
        ),
      }
    } else {
      FleetSshCredentialIdentityMismatch {
        expected_line: expected_fingerprint as String,
        observed_line: std.algebra.trim(s: listing_stdout),
      }
    }
  } else {
    FleetSshCredentialDerivationRefused {
      cause: concat("ssh-add -l refused for the named agent socket: ", std.algebra.trim(s: listing_stderr)),
    }
  }
}

// The observation. `SSH_AUTH_SOCK` is passed explicitly rather than inherited, so the agent that
// answered is the agent the binding names.
func list_agent_identities(agent_socket: std.types.NonEmptyStr) -> gunbc.command_runner.ShellCaptureResult
  uses net: std.resources.Network
{
  gunbc.command_runner.run_shell_command_capture(
    command: extdeps.exec.command.ArgvCommand {
      argv: ["env", join(["SSH_AUTH_SOCK=", agent_socket as String], ""), "ssh-add", "-l"],
    },
    transport: extdeps.exec.command.LocalExec,
  )
}

func verify_fleet_ssh_agent_credential(
  agent_socket: std.types.NonEmptyStr,
  public_selector_file: std.types.NonEmptyStr,
  expected_key: extdeps.ssh.SshPublicKey,
  expected_fingerprint: std.types.NonEmptyStr,
) -> FleetSshCredentialVerification
  uses net: std.resources.Network
{
  let observation = list_agent_identities(agent_socket: agent_socket)
  classify_agent_key_listing(
    agent_socket: agent_socket,
    public_selector_file: public_selector_file,
    expected_key: expected_key,
    expected_fingerprint: expected_fingerprint,
    listing_succeeded: observation.success,
    listing_stdout: observation.stdout,
    listing_stderr: observation.stderr,
  )
}

// The refusal reason a consumer reports when it declines to proceed. Kept beside the coproduct so a
// caller cannot invent its own wording for a state the model already names.
fn fleet_ssh_credential_verification_refusal_reason(
  verification: FleetSshCredentialVerification,
) -> String {
  match verification {
    FleetSshCredentialVerified { binding: _ } =>
      "credential verified; not a refusal"
    FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed } =>
      join([
        "FleetSshCredentialIdentityMismatch: the materialized identity file holds `", observed,
        "`, not the declared fleet key `", expected,
        "`; contacting NO host",
      ], "")
    FleetSshCredentialDerivationRefused { cause: cause } => cause
  }
}
