module gunbc.flex_aws_credential

import std.types { NonEmptyStr }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.secret_provision { fleet_secret_ref, secret_ref_pin_version }

// THE FLEX POOL'S AWS CREDENTIAL, the same custody pattern as gunbc.flex_vast_credential: the store is the
// authority, the host holds one copy for the loop, and the loop names only the copy's path. The copy is an
// AWS shared-credentials file (0600, owner only) read by the AWS CLI through AWS_SHARED_CREDENTIALS_FILE
// (extdeps.cloud.aws_cli), so the key never enters an argv or an environment the pass prints. Its grants
// are the IAM policy of gunbc.plans.flex_supplier_generalization section 4, conditioned on the owner tag.
data flex_aws_credentials_secret_ref: SecretRef = secret_ref_pin_version(
  ref: fleet_secret_ref(secret_id: "flex-aws-credentials"),
  version: "latest",
)

data flex_aws_credentials_custody_host: HostIdentity = operator_host_srv1

data flex_aws_credentials_host_path: NonEmptyStr = "/etc/gunbc-flex/aws-credentials" as NonEmptyStr

// DECLARED FRONTIER: no custody row places this file yet. Adding the row to
// gunbc.fleet.host_credential_custody_converge before the secret exists would make the srv1 custody
// converge fail on a secret nobody created, so the row lands with the operator's action. Until then the
// AWS row of the flex pass finds no credential and refuses, typed, while the Vast row runs unchanged.
data flex_aws_credentials_custody_frontier: DissolutionCondition = unbound_dissolution(description: "Dissolves when the operator has created flex-aws-credentials in gunbai-secrets (the IAM principal of gunbc.plans.flex_supplier_generalization section 4) and a HostCredentialCustodyRow places it at flex_aws_credentials_host_path on srv1, owner-only, beside FlexVastApiKey.")
