data bmc_fan_atomic_transaction_dissolution_trigger: String = "🟡 dissolve-on: replace the phase-partial mutation refusal when one atomically published content-addressed backup manifest binds transaction id, exact target and stable BMC identity, firmware, config path, before/backup digests, and creation generation; restore proves the manifest digest, restored-byte digest, controller readback, and bounded thermal/tach monitoring receipt. Until then the live actuator is observation-only and cannot mutate."

type BmcFanConvergeTarget {
  host: ComputeHost
  board: BaseboardModel
  onboarding: BmcOnboardingPlan
  projection: BmcFanPolicyProjectionCapability?
  durability_generation: StatePerturbationGeneration
  durability_evidence: List<BmcFanDurabilityEvidence>
  ssh_known_hosts_path: NonEmptyStr
  expected_bmc_machine_id_path: NonEmptyStr
}

type BmcFanTypedObservationPlan {
  config_path: NonEmptyStr
  controller_service: NonEmptyStr
  controller_zone_path: NonEmptyStr
  tach_sensors: List<NonEmptyStr>
  temperature_sensors: List<NonEmptyStr>
}

fn bmc_fan_typed_observation_plan(
  projection: BmcFanPolicyProjectionCapability,
  intent: BmcControlPlaneIntent,
) -> BmcFanTypedObservationPlan {
  BmcFanTypedObservationPlan {
    config_path: projection.config_path,
    controller_service: projection.controller_service,
    controller_zone_path: projection.controller_zone_path,
    tach_sensors: projection.required_tach_inputs,
    temperature_sensors: append(
      ["TEMP_SOC"],
      items: intent.fan_policy.thermal_guard.required_component_sensors,
    ),
  }
}

data srv3_bmc_fan_converge_target: BmcFanConvergeTarget = BmcFanConvergeTarget {
  host: srv3_host,
  board: srv3_baseboard.catalog.model,
  onboarding: srv3_onboarding_plan,
  projection: none,
  durability_generation: 1,
  durability_evidence: [],
  ssh_known_hosts_path: "/etc/gunbc/bmc-known-hosts/srv3",
  expected_bmc_machine_id_path: "/etc/gunbc/bmc-identities/srv3-machine-id",
}

data srv4_bmc_fan_converge_target: BmcFanConvergeTarget = BmcFanConvergeTarget {
  host: srv4_host,
  board: srv4_baseboard.catalog.model,
  onboarding: srv4_onboarding_plan,
  projection: Present { value: srv4_bmc_fan_projection_capability },
  durability_generation: srv4_bmc_fan_perturbation_generation,
  durability_evidence: srv4_bmc_fan_durability_evidence,
  ssh_known_hosts_path: "/etc/gunbc/bmc-known-hosts/srv4",
  expected_bmc_machine_id_path: "/etc/gunbc/bmc-identities/srv4-machine-id",
}

type BmcFanLiveObservation {
  policy: BmcFanPolicyObservation
  persistence: BmcConfigPersistenceObservation
  zone_control_path: NonEmptyStr
  zone_failsafe_active: Bool
  active_config_digest: Digest
  tach_health: List<OpenBmcTachHealth>
  temperatures: List<BmcFanTemperatureObservation>
}

type BmcFanTemperatureObservation {
  sensor: NonEmptyStr
  value: OpenBmcSensorValueResult
}

type BmcFanLiveObservationResult
  = BmcFanLiveObserved { observation: BmcFanLiveObservation }
  | BmcFanLiveObservationRefused { reason: String }

type BmcFanLiveIdentity {
  firmware: BmcFirmwareVersion
  machine: NonEmptyStr
  stable_machine_id: NonEmptyStr
}

type BmcFanLiveIdentityResult
  = BmcFanLiveIdentityObserved { identity: BmcFanLiveIdentity }
  | BmcFanLiveIdentityRefused { reason: String }

type BmcFanRequestedAction
  = BmcFanObserveOnly
  | BmcFanConvergeRequested
  | BmcFanRollbackPrevious

type ParsedCurveSteps
  = CurveStepsParsed { steps: List<BmcFanCurveStep> }
  | CurveStepsParseRefused { reason: String }

type ParsedFanCurve
  = FanCurveParsed { curve: BmcFanCurve }
  | FanCurveParseRefused { reason: String }

type ParsedFanControllerShape
  = FanControllerShapeParsed { shape: BmcFanControllerShape }
  | FanControllerShapeParseRefused { reason: String }

type BmcFanObservedPartsResult
  = BmcFanObservedParts {
      selected_config_path: NonEmptyStr,
      board_config_path: NonEmptyStr,
      controller_service: NonEmptyStr,
      controller_binary: NonEmptyStr,
      zone_control_path: NonEmptyStr,
      zone_failsafe_active: Bool,
      writable: Bool,
      upper_override_present: Bool,
      available_bytes: ByteSize,
      observed_at: NonEmptyStr,
      overlay: LinuxOverlayObservation,
      config: OpenBmcFanConfigObservation,
      config_digest: Digest,
      tach_health: List<OpenBmcTachHealth>,
      temperatures: List<BmcFanTemperatureObservation>,
    }
  | BmcFanObservedPartsRefused { reason: String }

type BmcFanRollbackReceipt
  = BmcFanRollbackNotAttempted
  | BmcFanPreviousConfigRestored {
      config_path: NonEmptyStr,
      backup_path: NonEmptyStr,
      firmware: BmcFirmwareVersion,
    }
  | BmcFanRollbackAttemptFailed {
      config_path: NonEmptyStr,
      backup_path: NonEmptyStr,
      firmware: BmcFirmwareVersion,
      reason: String,
    }

type BmcFanTypedMutationResult
  = BmcFanAppliedAndVerified {
      rollback: BmcFanRollbackReceipt,
    }
  | BmcFanAppliedWithCleanupDebt {
      cleanup_debt: String,
      rollback: BmcFanRollbackReceipt,
    }
  | BmcFanRestoredAndVerified {
      rollback: BmcFanRollbackReceipt,
    }
  | BmcFanRestoredWithCleanupDebt {
      cleanup_debt: String,
      rollback: BmcFanRollbackReceipt,
    }
  | BmcFanApplyFailedAndRestored {
      reason: String,
      rollback: BmcFanRollbackReceipt,
    }
  | BmcFanApplyFailedAndRestoreFailed {
      reason: String,
      rollback: BmcFanRollbackReceipt,
    }
  | BmcFanNoEffectRefused {
      reason: String,
      rollback: BmcFanRollbackReceipt,
    }

fn bmc_fan_curve_readings(curve: BmcFanCurve) -> List<Int> {
  curve.steps |> map(step => celsius_count(step.at_or_above))
}

fn bmc_fan_curve_outputs(curve: BmcFanCurve) -> List<Int> {
  curve.steps |> map(step => percent_count(step.duty))
}

fn bmc_fan_policy_projection_request(
  curve: BmcFanCurve,
  projection: BmcFanPolicyProjectionCapability,
) -> OpenBmcFanConfigDesired {
  OpenBmcFanConfigDesired {
    readings: bmc_fan_curve_readings(curve: curve),
    outputs: bmc_fan_curve_outputs(curve: curve),
    minimum_duty: percent_count(curve.minimum_duty),
    sensor_failsafe_duty: percent_count(curve.sensor_unavailable_duty),
    zone_failsafe_duty: percent_count(curve.zone_failsafe_duty),
    positive_hysteresis: curve.positive_hysteresis_degrees_celsius,
    negative_hysteresis: curve.negative_hysteresis_degrees_celsius,
    fan_controller_name: projection.aggregate_fan_pid_entry,
    fan_inputs: projection.required_tach_inputs,
  }
}

fn bmc_fan_observation_value(lines: List<String>, key: String) -> String? {
  let prefix = concat(key, "=")
  if lines.length() == 0 {
    none
  } else {
    let line = lines.first()
    if starts_with(s: line, prefix: prefix) {
      Present {
        value: substring(
          s: line,
          start: prefix.length(),
          end: line.length(),
        ),
      }
    } else {
      bmc_fan_observation_value(lines: lines.skip(n: 1), key: key)
    }
  }
}

fn bmc_fan_observation_value_or_empty(lines: List<String>, key: String) -> String {
  match bmc_fan_observation_value(lines: lines, key: key) {
    Present { value: value } => value
    Absent => ""
  }
}

fn bmc_fan_unquote_os_release_value(raw: String) -> String {
  let value = trim(raw)
  if value.length() >= 2
    && starts_with(s: value, prefix: "\"")
    && ends_with(s: value, suffix: "\"") {
    substring(s: value, start: 1, end: value.length() - 1)
  } else {
    value
  }
}

fn bmc_fan_parse_os_release_identity(
  content: String,
  stable_machine_id: NonEmptyStr,
) -> BmcFanLiveIdentityResult {
  let lines = split(s: content, delimiter: "\n")
  let firmware = bmc_fan_observation_value_or_empty(
    lines: lines,
    key: "VERSION_ID",
  )
  let machine = bmc_fan_observation_value_or_empty(
    lines: lines,
    key: "OPENBMC_TARGET_MACHINE",
  )
  let unquoted_firmware = bmc_fan_unquote_os_release_value(raw: firmware)
  let unquoted_machine = bmc_fan_unquote_os_release_value(raw: machine)
  if unquoted_firmware == "" {
    BmcFanLiveIdentityRefused {
      reason: "BMC fan identity observer omitted firmware",
    }
  } else if unquoted_machine == "" {
    BmcFanLiveIdentityRefused {
      reason: "BMC fan identity observer omitted target machine",
    }
  } else {
    BmcFanLiveIdentityObserved {
      identity: BmcFanLiveIdentity {
        firmware: BmcFirmwareVersion {
          family: OpenBmc,
          version: unquoted_firmware as NonEmptyStr,
        },
        machine: unquoted_machine as NonEmptyStr,
        stable_machine_id: stable_machine_id,
      },
    }
  }
}

fn bmc_fan_observe_live_identity(
  session: PasswordSshSession,
) -> BmcFanLiveIdentityResult {
  let os_release = openbmc_read_file(session: session, path: "/etc/os-release")
  let remote_machine_id = openbmc_read_file(session: session, path: "/etc/machine-id")
  let admitted_machine_id = Filesystem.Read(
    path: session.expected_machine_id_path as String,
  )
  if !os_release.success {
    BmcFanLiveIdentityRefused {
      reason: join(["BMC fan identity observation transport failed: ", os_release.stderr], ""),
    }
  } else if !remote_machine_id.success || trim(remote_machine_id.stdout) == "" {
    BmcFanLiveIdentityRefused {
      reason: "BMC stable machine identity observation failed",
    }
  } else if !admitted_machine_id.success || trim(admitted_machine_id.content) == "" {
    BmcFanLiveIdentityRefused {
      reason: "target-specific admitted BMC machine identity is absent",
    }
  } else if trim(remote_machine_id.stdout) != trim(admitted_machine_id.content) {
    BmcFanLiveIdentityRefused {
      reason: "live BMC stable machine identity differs from the target-specific admission",
    }
  } else {
    bmc_fan_parse_os_release_identity(
      content: os_release.stdout,
      stable_machine_id: trim(remote_machine_id.stdout) as NonEmptyStr,
    )
  }
}

fn bmc_fan_identity_matches_firmware_intent(
  identity: BmcFanLiveIdentity,
  intent: BmcFirmwareIntent,
) -> Bool {
  match intent {
    BmcFirmwareUnpinned => false
    BmcFirmwareTrackRequired { track: track } =>
      bmc_firmware_version_matches_track(
        firmware: identity.firmware,
        track: track,
      )
  }
}

fn bmc_fan_firmware_intent_requirement(intent: BmcFirmwareIntent) -> String {
  match intent {
    BmcFirmwareUnpinned => "a pinned OpenBMC firmware track"
    BmcFirmwareTrackRequired { track: track } =>
      concat(
        "OpenBMC ",
        concat(to_string(track.major_version), ".x"),
      )
  }
}

fn bmc_fan_build_curve_steps_rec(
  readings: List<Int>,
  outputs: List<Int>,
  previous_reading: Int?,
  previous_output: Int?,
  built: List<BmcFanCurveStep>,
) -> ParsedCurveSteps {
  if readings.length() == 0 {
    if outputs.length() == 0 && built.length() > 0 {
      match previous_output {
        Present { value: 100 } => CurveStepsParsed { steps: built }
        Present { value: _ } =>
          CurveStepsParseRefused {
            reason: "fan curve lacks terminal full duty",
          }
        Absent =>
          CurveStepsParseRefused {
            reason: "fan curve has no terminal duty",
          }
      }
    } else {
      CurveStepsParseRefused {
        reason: "fan curve readings/outputs differ or are empty",
      }
    }
  } else if outputs.length() == 0 {
    CurveStepsParseRefused {
      reason: "fan curve readings and outputs have different cardinality",
    }
  } else {
    let reading = readings.first()
    let output = outputs.first()
    let ordered = match previous_reading {
      Present { value: previous } => reading > previous
      Absent => true
    }
    let nondecreasing = match previous_output {
      Present { value: previous } => output >= previous
      Absent => true
    }
    if !ordered {
      CurveStepsParseRefused {
        reason: "fan curve temperature breakpoints are not strictly increasing",
      }
    } else if output < 0 || output > 100 {
      CurveStepsParseRefused {
        reason: "fan curve output is outside 0..100 percent",
      }
    } else if !nondecreasing {
      CurveStepsParseRefused {
        reason: "fan curve duty decreases at a later temperature",
      }
    } else {
      bmc_fan_build_curve_steps_rec(
        readings: readings.skip(n: 1),
        outputs: outputs.skip(n: 1),
        previous_reading: Present { value: reading },
        previous_output: Present { value: output },
        built: append(
          built,
          items: [
            BmcFanCurveStep {
              at_or_above: celsius(reading),
              duty: percent(output),
            },
          ],
        ),
      )
    }
  }
}

fn bmc_fan_build_curve_steps(
  readings: List<Int>,
  outputs: List<Int>,
) -> ParsedCurveSteps {
  bmc_fan_build_curve_steps_rec(
    readings: readings,
    outputs: outputs,
    previous_reading: none,
    previous_output: none,
    built: [],
  )
}

fn bmc_fan_nonempty_whitespace_tokens(raw: String) -> List<String> {
  split(s: trim(raw), delimiter: " ")
    |> filter(token => trim(token) != "")
    |> map(token => trim(token))
}

fn bmc_fan_busctl_payload(raw: String) -> String {
  let tokens = bmc_fan_nonempty_whitespace_tokens(raw: raw)
  if tokens.length() < 2 {
    ""
  } else {
    concat("", tokens.skip(n: 1).first())
  }
}

fn bmc_fan_bool_text(value: Bool) -> String {
  if value { "true" } else { "false" }
}

fn bmc_fan_sensor_integer_value(raw: String) -> String {
  let payload = trim(raw)
  if payload == "" || payload == "nan" || payload == "inf" || payload == "-inf" {
    "absent"
  } else {
    let whole = split(s: payload, delimiter: ".").first()
    match parse_int(s: whole) {
      Present { value: value } => to_string(value)
      Absent => "absent"
    }
  }
}

fn bmc_fan_observe_temperature(
  session: PasswordSshSession,
  sensor_name: NonEmptyStr,
) -> BmcFanTemperatureObservation {
  let sensor_path = join(
    ["/xyz/openbmc_project/sensors/temperature/", sensor_name as String],
    "",
  ) as NonEmptyStr
  let service_result = openbmc_sensor_service(
    session: session,
    sensor_path: sensor_path,
  )
  let value = match service_result {
    OpenBmcSensorServicesRefused { reason } =>
      OpenBmcSensorValueRefused { reason: reason }
    OpenBmcSensorServicesObserved { services } =>
      match services {
        OpenBmcCollectionZero => OpenBmcSensorValueAbsent
        OpenBmcCollectionMany { values: _ } =>
          OpenBmcSensorValueRefused {
            reason: "temperature ObjectMapper service binding is ambiguous",
          }
        OpenBmcCollectionOne { value: selected_service } =>
          openbmc_sensor_value(
            session: session,
            service: selected_service,
            sensor_path: sensor_path,
          )
      }
  }
  BmcFanTemperatureObservation { sensor: sensor_name, value: value }
}

fn bmc_fan_observe_temperatures(
  session: PasswordSshSession,
  sensor_names: List<NonEmptyStr>,
) -> List<BmcFanTemperatureObservation> {
  sensor_names |> map(sensor =>
    bmc_fan_observe_temperature(
      session: session,
      sensor_name: sensor,
    )
  )
}

type BmcFanTachHealthListResult
  = BmcFanTachHealthListObserved { values: List<OpenBmcTachHealth> }
  | BmcFanTachHealthListRefused { reason: String }

fn bmc_fan_observe_tach_health_rec(
  session: PasswordSshSession,
  sensors: List<NonEmptyStr>,
  built: List<OpenBmcTachHealth>,
) -> BmcFanTachHealthListResult {
  if sensors.length() == 0 {
    BmcFanTachHealthListObserved { values: built }
  } else {
    match openbmc_tach_health(session: session, sensor: sensors.first()) {
      OpenBmcTachHealthRefused { reason } =>
        BmcFanTachHealthListRefused { reason: reason }
      OpenBmcTachHealthObserved { health } =>
        bmc_fan_observe_tach_health_rec(
          session: session,
          sensors: sensors.skip(n: 1),
          built: append(built, items: [health]),
        )
    }
  }
}

fn bmc_fan_observe_tach_health(
  session: PasswordSshSession,
  sensors: List<NonEmptyStr>,
) -> BmcFanTachHealthListResult {
  bmc_fan_observe_tach_health_rec(
    session: session,
    sensors: sensors,
    built: [],
  )
}

fn bmc_fan_df_available_bytes(raw: String) -> Int? {
  let lines = split(s: trim(raw), delimiter: "\n")
  if lines.length() < 2 {
    none
  } else {
    let fields = bmc_fan_nonempty_whitespace_tokens(
      raw: lines.skip(n: 1).first(),
    )
    if fields.length() < 4 {
      none
    } else {
      match parse_int(s: fields.skip(n: 3).first()) {
        Present { value: kib } => Present { value: kib * 1024 }
        Absent => none
      }
    }
  }
}

fn bmc_fan_observe_typed_parts(
  session: PasswordSshSession,
  identity: BmcFanLiveIdentity,
  plan: BmcFanTypedObservationPlan,
) -> BmcFanObservedPartsResult {
  let selected = openbmc_resolve_path(
    session: session,
    path: "/usr/share/swampd/config.json",
  )
  let service = openbmc_systemd_is_active(
    session: session,
    service: plan.controller_service,
  )
  let zone = openbmc_zone_failsafe(
    session: session,
    zone_path: plan.controller_zone_path,
  )
  let config = openbmc_fan_config_observe(
    session: session,
    config_path: plan.config_path,
  )
  let config_digest = openbmc_file_sha256(session: session, path: plan.config_path)
  let mounts = openbmc_read_file(session: session, path: "/proc/mounts")
  let parent = openbmc_parent_directory(
    session: session,
    path: plan.config_path,
  )
  let disk = openbmc_disk_usage_kib(session: session, path: "/")
  let timestamp = openbmc_utc_timestamp(session: session)
  if !selected.success {
    BmcFanObservedPartsRefused {
      reason: concat("selected fan-config path observation failed: ", selected.stderr),
    }
  } else if !service.success {
    BmcFanObservedPartsRefused {
      reason: concat("fan controller is not active: ", service.stderr),
    }
  } else if !zone.success {
    BmcFanObservedPartsRefused {
      reason: concat("fan zone failsafe observation failed: ", zone.stderr),
    }
  } else if !mounts.success {
    BmcFanObservedPartsRefused {
      reason: concat("BMC mount-table observation failed: ", mounts.stderr),
    }
  } else if !parent.success || trim(parent.stdout) == "" {
    BmcFanObservedPartsRefused {
      reason: concat("fan config parent-directory observation failed: ", parent.stderr),
    }
  } else if !disk.success {
    BmcFanObservedPartsRefused {
      reason: concat("BMC filesystem capacity observation failed: ", disk.stderr),
    }
  } else if !timestamp.success || trim(timestamp.stdout) == "" {
    BmcFanObservedPartsRefused {
      reason: concat("BMC timestamp observation failed: ", timestamp.stderr),
    }
  } else {
    match config {
      OpenBmcFanConfigObservationRefused { reason } =>
        BmcFanObservedPartsRefused {
          reason: join(["fan config semantic observation failed: ", reason], ""),
        }
      OpenBmcFanConfigObserved { observation: config_observation } =>
        match config_digest {
          OpenBmcDigestRefused { reason } =>
            BmcFanObservedPartsRefused {
              reason: join(["active fan config digest failed: ", reason], ""),
            }
          OpenBmcDigestObserved { digest: observed_digest } =>
        match linux_overlay_observation_from_proc_mounts(
          proc_mounts: mounts.stdout,
        ) {
          Absent =>
            BmcFanObservedPartsRefused {
              reason: "BMC root OverlayFS lower/upper backing-mount relationship is absent",
            }
          Present { value: overlay } => {
        let writable = openbmc_path_is_writable(
          session: session,
          path: trim(parent.stdout) as NonEmptyStr,
        )
        let upper_override = openbmc_path_exists(
          session: session,
          path: join(
            [overlay.upper_directory as String, plan.config_path as String],
            "",
          ) as NonEmptyStr,
        )
            let temperatures = bmc_fan_observe_temperatures(
              session: session,
              sensor_names: plan.temperature_sensors,
            )
            match bmc_fan_df_available_bytes(raw: disk.stdout) {
              Absent =>
                BmcFanObservedPartsRefused {
                  reason: "persistent overlay available-byte observation is absent or invalid",
                }
              Present { value: available_bytes } =>
                match bmc_fan_parse_bool(raw: bmc_fan_busctl_payload(raw: zone.stdout)) {
                  Absent =>
                    BmcFanObservedPartsRefused {
                      reason: "fan zone failsafe response is not boolean",
                    }
                  Present { value: zone_failsafe_active } =>
                    match bmc_fan_observe_tach_health(
                      session: session,
                      sensors: plan.tach_sensors,
                    ) {
                      BmcFanTachHealthListRefused { reason } =>
                        BmcFanObservedPartsRefused { reason: reason }
                      BmcFanTachHealthListObserved { values: tach_health } =>
                        BmcFanObservedParts {
                          selected_config_path: "/usr/share/swampd/config.json",
                          board_config_path: trim(selected.stdout) as NonEmptyStr,
                          controller_service: plan.controller_service,
                          controller_binary: "/usr/bin/swampd",
                          zone_control_path: plan.controller_zone_path,
                          zone_failsafe_active: zone_failsafe_active,
                          writable: writable.success,
                          upper_override_present: upper_override.success,
                          available_bytes: byte_size(available_bytes),
                          observed_at: trim(timestamp.stdout) as NonEmptyStr,
                          overlay: overlay,
                          config: config_observation,
                          config_digest: observed_digest,
                          tach_health: tach_health,
                          temperatures: temperatures,
                        }
                    }
                }
            }
          }
        }
        }
    }
  }
}

fn bmc_fan_parse_curve(config: OpenBmcFanConfigObservation) -> ParsedFanCurve {
  match config.stepwise {
    OpenBmcSelectionZero =>
      FanCurveParseRefused { reason: "TEMP_SOC stepwise controller is absent" }
    OpenBmcSelectionMany { count: _ } =>
      FanCurveParseRefused { reason: "TEMP_SOC stepwise controller is ambiguous" }
    OpenBmcSelectionOne { value: controller } =>
      if controller.minimum_duty < 0 || controller.minimum_duty > 100
        || controller.sensor_failsafe_duty < 0 || controller.sensor_failsafe_duty > 100
        || controller.zone_failsafe_duty < 0 || controller.zone_failsafe_duty > 100
        || controller.positive_hysteresis < 0 || controller.negative_hysteresis < 0 {
        FanCurveParseRefused {
          reason: "fan curve duty or hysteresis is outside its admissible range",
        }
      } else {
        match bmc_fan_build_curve_steps(
          readings: controller.readings,
          outputs: controller.outputs,
        ) {
          CurveStepsParseRefused { reason } => FanCurveParseRefused { reason: reason }
          CurveStepsParsed { steps } => {
            let raw_curve = BmcFanCurve {
                control_sensor: "TEMP_SOC",
                steps: steps,
                minimum_duty: percent(controller.minimum_duty),
                sensor_unavailable_duty: percent(controller.sensor_failsafe_duty),
                zone_failsafe_duty: percent(controller.zone_failsafe_duty),
                positive_hysteresis_degrees_celsius: controller.positive_hysteresis,
                negative_hysteresis_degrees_celsius: controller.negative_hysteresis,
              }
            match validate_bmc_fan_curve(curve: raw_curve) {
              BmcFanCurveInvalid { cause: _ } =>
                FanCurveParseRefused {
                  reason: "fan curve failed the shared validated-curve constructor",
                }
              BmcFanCurveValid { curve: validated } =>
                FanCurveParsed { curve: validated.curve }
            }
          }
        }
      }
  }
}

fn bmc_fan_parse_controller_shape(
  config: OpenBmcFanConfigObservation,
) -> ParsedFanControllerShape {
  match config.fan_controllers {
    OpenBmcCollectionZero =>
      FanControllerShapeParseRefused { reason: "fan PID controller is absent" }
    OpenBmcCollectionOne { value: controller } =>
      if controller.inputs.length() == 0 {
        FanControllerShapeParseRefused { reason: "aggregate fan tach inputs are absent" }
      } else {
        FanControllerShapeParsed {
          shape: FanPidAggregatedEntry {
            entry_name: controller.name,
            tach_inputs: controller.inputs,
          },
        }
      }
    OpenBmcCollectionMany { values } =>
      FanControllerShapeParsed {
        shape: FanPidIndependentEntries {
          entry_names: values |> map(controller => controller.name),
        },
      }
  }
}

fn bmc_fan_parse_bool(raw: String) -> Bool? {
  if raw == "true" {
    Present { value: true }
  } else {
    if raw == "false" {
      Present { value: false }
    } else {
      none
    }
  }
}

fn bmc_fan_build_live_observation(
  identity: BmcFanLiveIdentity,
  selected_config_path: NonEmptyStr,
  board_config_path: NonEmptyStr,
  controller_service: NonEmptyStr,
  controller_binary: NonEmptyStr,
  zone_control_path: NonEmptyStr,
  zone_failsafe_active: Bool,
  writable: Bool,
  upper_override_present: Bool,
  available_bytes: ByteSize,
  observed_at: NonEmptyStr,
  overlay: LinuxOverlayObservation,
  config: OpenBmcFanConfigObservation,
  config_digest: Digest,
  tach_health: List<OpenBmcTachHealth>,
  temperatures: List<BmcFanTemperatureObservation>,
) -> BmcFanLiveObservationResult {
  let firmware = identity.firmware.version as String
  let machine = identity.machine as String
  let selected_path = selected_config_path as String
  let board_path = board_config_path as String
  let service = controller_service as String
  let binary = controller_binary as String
  let service_active = "active"
  let zone_path = zone_control_path as String
  let zone_failsafe = if zone_failsafe_active { "true" } else { "false" }
  let available_raw = to_string(byte_size_count(available_bytes))
  if firmware == "" {
    BmcFanLiveObservationRefused {
      reason: "BMC fan observer omitted firmware",
    }
  } else if selected_path == "" {
    BmcFanLiveObservationRefused {
      reason: "BMC fan observer omitted selected config path",
    }
  } else if board_path == "" {
    BmcFanLiveObservationRefused {
      reason: "BMC fan observer omitted resolved board config path",
    }
  } else if service == "" {
    BmcFanLiveObservationRefused {
      reason: "BMC fan observer omitted controller service",
    }
  } else if binary == "" {
    BmcFanLiveObservationRefused {
      reason: "BMC fan observer omitted controller binary",
    }
  } else if observed_at == "" {
    BmcFanLiveObservationRefused {
      reason: "BMC fan observer omitted observation timestamp",
    }
  } else if zone_path == "" {
    BmcFanLiveObservationRefused {
      reason: "BMC fan observer omitted zone control path",
    }
  } else if zone_failsafe != "true" && zone_failsafe != "false" {
    BmcFanLiveObservationRefused {
      reason: "BMC fan observer omitted a typed zone failsafe state",
    }
  } else if machine != "altrad8ud-1l2t" {
    BmcFanLiveObservationRefused {
      reason: concat("BMC target machine is not altrad8ud-1l2t: ", machine),
    }
  } else if service_active != "active" {
    BmcFanLiveObservationRefused {
      reason: concat("fan controller service is not active: ", service_active),
    }
  } else {
          match bmc_fan_parse_curve(config: config) {
            FanCurveParseRefused { reason: reason } =>
              BmcFanLiveObservationRefused { reason: reason }
            FanCurveParsed { curve: curve } =>
              match bmc_fan_parse_controller_shape(config: config) {
                FanControllerShapeParseRefused { reason: reason } =>
                  BmcFanLiveObservationRefused { reason: reason }
                FanControllerShapeParsed { shape: shape } =>
                  match parse_int(s: available_raw) {
                    Absent =>
                      BmcFanLiveObservationRefused {
                        reason: "persistent overlay available-byte observation is absent or invalid",
                      }
                    Present { value: available } =>
                      if available <= 0 {
                        BmcFanLiveObservationRefused {
                          reason: "persistent overlay free-space observation is absent",
                        }
                      } else {
                        let firmware_version = BmcFirmwareVersion {
                          family: OpenBmc,
                          version: firmware as NonEmptyStr,
                        }
                        BmcFanLiveObserved {
                          observation: BmcFanLiveObservation {
                            policy: BmcFanPolicyObservation {
                              firmware: firmware_version,
                              curve: curve,
                              selected_config_path: selected_path as NonEmptyStr,
                              board_config_path: board_path as NonEmptyStr,
                              controller_service: service as NonEmptyStr,
                              controller_binary: binary as NonEmptyStr,
                              controller_shape: shape,
                              observed_at: observed_at,
                            },
                            persistence: BmcOverlayConfigObserved {
                              firmware: firmware_version,
                              config_path: board_path as NonEmptyStr,
                              overlay: overlay,
                              writable: writable,
                              upper_override_present: upper_override_present,
                              available_bytes: available_bytes,
                              observed_at: observed_at,
                            },
                            zone_control_path: zone_path as NonEmptyStr,
                            zone_failsafe_active: zone_failsafe_active,
                            active_config_digest: config_digest,
                            tach_health: tach_health,
                            temperatures: temperatures,
                          },
                        }
                      }
                  }
              }
          }
  }
}

fn bmc_fan_temperature_for_sensor(
  temperatures: List<BmcFanTemperatureObservation>,
  sensor: NonEmptyStr,
) -> OpenBmcSensorValueResult? {
  if temperatures.length() == 0 {
    none
  } else {
    match temperatures.first() {
      Absent => none
      Present { value: candidate } =>
        if candidate.sensor == sensor {
          Present { value: candidate.value }
        } else {
          bmc_fan_temperature_for_sensor(
            temperatures: temperatures.skip(n: 1),
            sensor: sensor,
          )
        }
    }
  }
}

fn bmc_fan_tach_health_for_sensor(
  health: List<OpenBmcTachHealth>,
  sensor: NonEmptyStr,
) -> OpenBmcTachHealth? {
  if health.length() == 0 {
    none
  } else {
    match health.first() {
      Absent => none
      Present { value: candidate } => {
        let candidate_sensor = match candidate {
          OpenBmcTachThresholdUnstated { sensor, reason: _ } => sensor
          OpenBmcTachBelowThreshold { sensor, reading_rpm: _, minimum_rpm: _, source: _ } => sensor
          OpenBmcTachAtOrAboveThreshold { sensor, reading_rpm: _, minimum_rpm: _, source: _ } => sensor
        }
        if candidate_sensor == sensor {
          Present { value: candidate }
        } else {
          bmc_fan_tach_health_for_sensor(
            health: health.skip(n: 1),
            sensor: sensor,
          )
        }
      }
    }
  }
}

fn bmc_fan_first_unhealthy_tach(
  health: List<OpenBmcTachHealth>,
  required: List<NonEmptyStr>,
) -> String? {
  if required.length() == 0 {
    none
  } else {
    let tach = required.first()
    match bmc_fan_tach_health_for_sensor(health: health, sensor: tach) {
      Absent =>
        Present {
          value: join(["required tach health is absent: ", tach as String], ""),
        }
      Present { value: observed } =>
        match observed {
          OpenBmcTachThresholdUnstated { sensor: _, reason } =>
            Present {
              value: join(
                ["required tach threshold is unstated: ", tach as String, ": ", reason],
                "",
              ),
            }
          OpenBmcTachBelowThreshold { sensor: _, reading_rpm, minimum_rpm, source: _ } =>
          Present {
            value: join(
              [
                "required tach is below its OpenBMC threshold: ",
                tach as String,
                "=",
                to_string(reading_rpm),
                " < ",
                to_string(minimum_rpm),
              ],
              "",
            ),
          }
          OpenBmcTachAtOrAboveThreshold { sensor: _, reading_rpm: _, minimum_rpm: _, source: _ } =>
            bmc_fan_first_unhealthy_tach(
              health: health,
              required: required.skip(n: 1),
            )
        }
    }
  }
}

fn bmc_fan_first_unhealthy_component(
  temperatures: List<BmcFanTemperatureObservation>,
  required: List<NonEmptyStr>,
  rollback_temperature: Int,
) -> String? {
  if required.length() == 0 {
    none
  } else {
    let sensor = required.first()
    match bmc_fan_temperature_for_sensor(
      temperatures: temperatures,
      sensor: sensor,
    ) {
      Absent =>
        Present {
          value: join(["required component temperature is absent: ", sensor as String], ""),
        }
      Present { value: OpenBmcSensorValueAbsent } =>
        Present {
          value: join(["required component temperature is absent: ", sensor as String], ""),
        }
      Present { value: OpenBmcSensorValueRefused { reason } } =>
        Present {
          value: join(
            ["required component temperature was refused: ", sensor as String, ": ", reason],
            "",
          ),
        }
      Present { value: OpenBmcSensorValueObserved { value: temperature } } =>
          if temperature >= rollback_temperature {
            Present {
              value: join(
                [
                  "component reached rollback temperature: ",
                  sensor as String,
                  "=",
                  to_string(temperature),
                  "C >= ",
                  to_string(rollback_temperature),
                  "C",
                ],
                "",
              ),
            }
          } else {
            bmc_fan_first_unhealthy_component(
              temperatures: temperatures,
              required: required.skip(n: 1),
              rollback_temperature: rollback_temperature,
            )
          }
    }
  }
}

fn bmc_fan_live_thermal_tach_safety_refusal(
  observation: BmcFanLiveObservation,
  intent: BmcControlPlaneIntent,
  projection: BmcFanPolicyProjectionCapability,
) -> String? {
  let processor_rollback = celsius_count(
    intent.fan_policy.thermal_guard.processor_rollback_temperature,
  )
  let component_rollback = celsius_count(
    intent.fan_policy.thermal_guard.component_rollback_temperature,
  )
  match bmc_fan_temperature_for_sensor(
    temperatures: observation.temperatures,
    sensor: "TEMP_SOC",
  ) {
    Absent => Present { value: "TEMP_SOC is absent" }
    Present { value: OpenBmcSensorValueAbsent } =>
      Present { value: "TEMP_SOC is absent" }
    Present { value: OpenBmcSensorValueRefused { reason } } =>
      Present { value: join(["TEMP_SOC observation was refused: ", reason], "") }
    Present { value: OpenBmcSensorValueObserved { value: temperature } } =>
      if temperature >= processor_rollback {
        Present {
          value: concat(
            concat("TEMP_SOC reached rollback temperature: ", to_string(temperature)),
            concat("C >= ", concat(to_string(processor_rollback), "C")),
          ),
        }
      } else {
        match bmc_fan_first_unhealthy_tach(
          health: observation.tach_health,
          required: projection.required_tach_inputs,
        ) {
          Present { value: reason } => Present { value: reason }
          Absent =>
            bmc_fan_first_unhealthy_component(
              temperatures: observation.temperatures,
              required: intent.fan_policy.thermal_guard.required_component_sensors,
              rollback_temperature: component_rollback,
            )
        }
      }
  }
}

fn bmc_fan_live_thermal_tach_safety_holds(
  observation: BmcFanLiveObservation,
  intent: BmcControlPlaneIntent,
  projection: BmcFanPolicyProjectionCapability,
) -> Bool {
  match bmc_fan_live_thermal_tach_safety_refusal(
    observation: observation,
    intent: intent,
    projection: projection,
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

fn bmc_fan_live_digest_matches(
  live_digest: Digest,
  admitted_digest: Digest,
) -> Bool {
  live_digest == admitted_digest
}

fn bmc_fan_live_safety_refusal(
  observation: BmcFanLiveObservation,
  intent: BmcControlPlaneIntent,
  projection: BmcFanPolicyProjectionCapability,
) -> String? {
  if !bmc_fan_live_digest_matches(
    live_digest: observation.active_config_digest,
    admitted_digest: projection.projected_config_digest,
  ) {
    Present { value: "live active fan-config digest differs from the admitted digest" }
  } else if observation.zone_failsafe_active {
    Present { value: "fan controller zone is in failsafe" }
  } else if observation.zone_control_path != projection.controller_zone_path {
    Present { value: "observed fan-controller zone path differs from the exact projection" }
  } else {
    bmc_fan_live_thermal_tach_safety_refusal(
      observation: observation,
      intent: intent,
      projection: projection,
    )
  }
}

fn bmc_fan_live_safety_holds(
  observation: BmcFanLiveObservation,
  intent: BmcControlPlaneIntent,
  projection: BmcFanPolicyProjectionCapability,
) -> Bool {
  match bmc_fan_live_safety_refusal(
    observation: observation,
    intent: intent,
    projection: projection,
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

fn bmc_fan_remote_state_directory() -> NonEmptyStr {
  "/var/lib/gunbc/bmc-fan-policy"
}

fn bmc_fan_remote_backup_path() -> NonEmptyStr {
  "/var/lib/gunbc/bmc-fan-policy/previous.json"
}

fn bmc_fan_remote_backup_stage_path() -> NonEmptyStr {
  "/var/lib/gunbc/bmc-fan-policy/previous.json.gunbc-stage"
}

fn bmc_fan_remote_backup_version_path() -> NonEmptyStr {
  "/var/lib/gunbc/bmc-fan-policy/previous.version"
}

fn bmc_fan_remote_backup_version_stage_path() -> NonEmptyStr {
  "/var/lib/gunbc/bmc-fan-policy/previous.version.gunbc-stage"
}

fn bmc_fan_remote_lock_path() -> NonEmptyStr {
  "/run/gunbc-bmc-fan-converge.lock"
}

fn bmc_fan_remote_config_stage_path(
  plan: BmcFanPolicyApplyPlan,
) -> NonEmptyStr {
  concat(plan.config_path as String, ".gunbc-stage") as NonEmptyStr
}

fn bmc_fan_mutation_refused(reason: String) -> BmcFanTypedMutationResult {
  BmcFanNoEffectRefused {
    reason: reason,
    rollback: BmcFanRollbackNotAttempted,
  }
}

fn bmc_fan_mutation_applied() -> BmcFanTypedMutationResult {
  BmcFanAppliedAndVerified {
    rollback: BmcFanRollbackNotAttempted,
  }
}

fn bmc_fan_previous_config_restored(
  plan: BmcFanPolicyApplyPlan,
) -> BmcFanTypedMutationResult {
  BmcFanRestoredAndVerified {
    rollback: BmcFanPreviousConfigRestored {
      config_path: plan.config_path,
      backup_path: bmc_fan_remote_backup_path(),
      firmware: plan.observed.firmware,
    },
  }
}

fn bmc_fan_refused_with_rollback(
  reason: String,
  rollback: BmcFanRollbackReceipt,
) -> BmcFanTypedMutationResult {
  match rollback {
    BmcFanRollbackNotAttempted =>
      BmcFanNoEffectRefused { reason: reason, rollback: rollback }
    BmcFanPreviousConfigRestored {
      config_path: _,
      backup_path: _,
      firmware: _,
    } =>
      BmcFanApplyFailedAndRestored { reason: reason, rollback: rollback }
    BmcFanRollbackAttemptFailed {
      config_path: _,
      backup_path: _,
      firmware: _,
      reason: _,
    } =>
      BmcFanApplyFailedAndRestoreFailed { reason: reason, rollback: rollback }
  }
}

fn bmc_fan_mutation_succeeded(
  result: BmcFanTypedMutationResult,
) -> Bool {
  match result {
    BmcFanAppliedAndVerified { rollback: _ } => true
    BmcFanAppliedWithCleanupDebt { cleanup_debt: _, rollback: _ } => true
    BmcFanRestoredAndVerified { rollback: _ } => true
    BmcFanRestoredWithCleanupDebt { cleanup_debt: _, rollback: _ } => true
    BmcFanApplyFailedAndRestored { reason: _, rollback: _ } => false
    BmcFanApplyFailedAndRestoreFailed { reason: _, rollback: _ } => false
    BmcFanNoEffectRefused { reason: _, rollback: _ } => false
  }
}

fn bmc_fan_record_cleanup_debt(
  result: BmcFanTypedMutationResult,
  cleanup_debt: String,
) -> BmcFanTypedMutationResult {
  match result {
    BmcFanAppliedAndVerified { rollback } =>
      BmcFanAppliedWithCleanupDebt {
        cleanup_debt: cleanup_debt,
        rollback: rollback,
      }
    BmcFanRestoredAndVerified { rollback } =>
      BmcFanRestoredWithCleanupDebt {
        cleanup_debt: cleanup_debt,
        rollback: rollback,
      }
    BmcFanAppliedWithCleanupDebt { cleanup_debt: prior, rollback } =>
      BmcFanAppliedWithCleanupDebt {
        cleanup_debt: join([prior, "; ", cleanup_debt], ""),
        rollback: rollback,
      }
    BmcFanRestoredWithCleanupDebt { cleanup_debt: prior, rollback } =>
      BmcFanRestoredWithCleanupDebt {
        cleanup_debt: join([prior, "; ", cleanup_debt], ""),
        rollback: rollback,
      }
    BmcFanApplyFailedAndRestored { reason, rollback } =>
      BmcFanRestoredWithCleanupDebt {
        cleanup_debt: join([reason, "; ", cleanup_debt], ""),
        rollback: rollback,
      }
    BmcFanApplyFailedAndRestoreFailed { reason, rollback } =>
      BmcFanApplyFailedAndRestoreFailed { reason: reason, rollback: rollback }
    BmcFanNoEffectRefused { reason, rollback } =>
      BmcFanNoEffectRefused { reason: reason, rollback: rollback }
  }
}

fn bmc_fan_mutation_failure_reason(
  reason: String,
  rollback: BmcFanRollbackReceipt,
) -> String {
  match rollback {
    BmcFanRollbackNotAttempted => reason
    BmcFanPreviousConfigRestored {
      config_path: _,
      backup_path: _,
      firmware: _,
    } =>
      concat(reason, "; previous config restored and controller re-verified")
    BmcFanRollbackAttemptFailed {
      config_path: _,
      backup_path: _,
      firmware: _,
      reason: rollback_reason,
    } =>
      concat(reason, concat("; rollback also failed: ", rollback_reason))
  }
}

fn bmc_fan_publish_staged_config(
  session: PasswordSshSession,
  protocol: LinuxFilePublicationProtocol,
  staged_path: NonEmptyStr,
  destination_path: NonEmptyStr,
) -> BmcFanTypedMutationResult {
  if !linux_file_publication_has_synchronized_commit(protocol: protocol) {
    bmc_fan_mutation_refused(
      reason: "fan config publication plan lacks staged validation, atomic replacement, or synchronization",
    )
  } else {
    let validated = openbmc_fan_config_validate(
      session: session,
      config_path: staged_path,
    )
    if !validated.success {
      bmc_fan_mutation_refused(
        reason: concat("staged fan config is not valid JSON: ", validated.stderr),
      )
    } else {
      match protocol.replacement {
        ReplacementAtomicityUnspecified =>
          bmc_fan_mutation_refused(
            reason: "fan config publication plan omits same-directory rename replacement",
          )
        RenameReplaceWithinTargetDirectory => {
          let replaced = openbmc_rename_replace(
            session: session,
            source_path: staged_path,
            destination_path: destination_path,
          )
          if !replaced.success {
            bmc_fan_mutation_refused(
              reason: concat("atomic fan config replacement failed: ", replaced.stderr),
            )
          } else {
            match protocol.synchronization {
              NoExplicitFilesystemSynchronization =>
                bmc_fan_mutation_refused(
                  reason: "fan config publication replaced the file but lacks a filesystem synchronization barrier",
                )
              SyncAllFilesystemsAfterReplacement => {
                let synchronized = openbmc_synchronize_filesystems(
                  session: session,
                )
                if synchronized.success {
                  bmc_fan_mutation_applied()
                } else {
                  bmc_fan_mutation_refused(
                    reason: concat(
                      "filesystem synchronization failed after fan config replacement: ",
                      synchronized.stderr,
                    ),
                  )
                }
              }
            }
          }
        }
      }
    }
  }
}

fn bmc_fan_wait_for_failsafe_clear(
  session: PasswordSshSession,
  zone_path: NonEmptyStr,
  attempts_remaining: Int,
) -> BmcFanTypedMutationResult {
  let observed = openbmc_zone_failsafe(
    session: session,
    zone_path: zone_path,
  )
  if observed.success
    && bmc_fan_busctl_payload(raw: observed.stdout) == "false" {
    bmc_fan_mutation_applied()
  } else if attempts_remaining <= 1 {
    bmc_fan_mutation_refused(
      reason: "fan controller zone remained in failsafe after bounded restart polling",
    )
  } else {
    let waited = openbmc_wait_seconds(session: session, seconds: 1)
    if !waited.success {
      bmc_fan_mutation_refused(
        reason: concat("failsafe polling delay failed: ", waited.stderr),
      )
    } else {
      bmc_fan_wait_for_failsafe_clear(
        session: session,
        zone_path: zone_path,
        attempts_remaining: attempts_remaining - 1,
      )
    }
  }
}

fn bmc_fan_restart_and_verify_controller(
  session: PasswordSshSession,
  plan: BmcFanPolicyApplyPlan,
  desired: OpenBmcFanConfigDesired?,
) -> BmcFanTypedMutationResult {
  let restarted = openbmc_systemd_restart(
    session: session,
    service: plan.controller_service,
  )
  if !restarted.success {
    bmc_fan_mutation_refused(
      reason: concat("fan controller restart failed: ", restarted.stderr),
    )
  } else {
    let waited = openbmc_wait_seconds(session: session, seconds: 5)
    if !waited.success {
      bmc_fan_mutation_refused(
        reason: concat("fan controller stabilization delay failed: ", waited.stderr),
      )
    } else {
      let active = openbmc_systemd_is_active(
        session: session,
        service: plan.controller_service,
      )
      if !active.success || trim(active.stdout) != "active" {
        bmc_fan_mutation_refused(
          reason: concat("fan controller is not active after restart: ", active.stderr),
        )
      } else {
        match desired {
          Present { value: desired } => {
            let verified = openbmc_fan_config_verify(
              session: session,
              config_path: plan.config_path,
              desired: desired,
            )
            if !verified.success {
              bmc_fan_mutation_refused(
                reason: concat("semantic fan config readback differs from intent: ", verified.stderr),
              )
            } else {
              bmc_fan_wait_for_failsafe_clear(
                session: session,
                zone_path: plan.projection.controller_zone_path,
                attempts_remaining: 15,
              )
            }
          }
          Absent =>
            bmc_fan_wait_for_failsafe_clear(
              session: session,
              zone_path: plan.projection.controller_zone_path,
              attempts_remaining: 15,
            )
        }
      }
    }
  }
}

fn bmc_fan_restore_previous_locked(
  session: PasswordSshSession,
  plan: BmcFanPolicyApplyPlan,
) -> BmcFanTypedMutationResult {
  let staged = bmc_fan_remote_config_stage_path(plan: plan)
  let copied = openbmc_copy_file_preserving_metadata(
    session: session,
    source_path: bmc_fan_remote_backup_path(),
    destination_path: staged,
  )
  if !copied.success {
    bmc_fan_mutation_refused(
      reason: concat("previous fan config could not be staged: ", copied.stderr),
    )
  } else {
    let published = bmc_fan_publish_staged_config(
      session: session,
      protocol: plan.projection.publication_protocol,
      staged_path: staged,
      destination_path: plan.config_path,
    )
    if !bmc_fan_mutation_succeeded(result: published) {
      published
    } else {
      let restarted = bmc_fan_restart_and_verify_controller(
        session: session,
        plan: plan,
        desired: none,
      )
      match restarted {
        BmcFanAppliedAndVerified { rollback: _ } =>
          bmc_fan_previous_config_restored(plan: plan)
        BmcFanNoEffectRefused {
          reason: reason,
          rollback: _,
        } =>
          bmc_fan_mutation_refused(reason: reason)
        _ =>
          bmc_fan_mutation_refused(
            reason: "controller restart returned an impossible transaction outcome",
          )
      }
    }
  }
}

fn bmc_fan_failure_with_restore(
  session: PasswordSshSession,
  plan: BmcFanPolicyApplyPlan,
  reason: String,
) -> BmcFanTypedMutationResult {
  let restored = bmc_fan_restore_previous_locked(
    session: session,
    plan: plan,
  )
  match restored {
    BmcFanRestoredAndVerified { rollback: rollback } =>
      bmc_fan_refused_with_rollback(
        reason: reason,
        rollback: rollback,
      )
    BmcFanNoEffectRefused {
      reason: restore_reason,
      rollback: _,
    } =>
      bmc_fan_refused_with_rollback(
        reason: reason,
        rollback: BmcFanRollbackAttemptFailed {
          config_path: plan.config_path,
          backup_path: bmc_fan_remote_backup_path(),
          firmware: plan.observed.firmware,
          reason: restore_reason,
        },
      )
    _ =>
      bmc_fan_refused_with_rollback(
        reason: reason,
        rollback: BmcFanRollbackAttemptFailed {
          config_path: plan.config_path,
          backup_path: bmc_fan_remote_backup_path(),
          firmware: plan.observed.firmware,
          reason: "restore returned an impossible transaction outcome",
        },
      )
  }
}

fn bmc_fan_prepare_backup(
  session: PasswordSshSession,
  plan: BmcFanPolicyApplyPlan,
  local_version_path: NonEmptyStr,
) -> BmcFanTypedMutationResult {
  let state_dir = openbmc_make_directory(
    session: session,
    path: bmc_fan_remote_state_directory(),
    parents: true,
  )
  if !state_dir.success {
    bmc_fan_mutation_refused(
      reason: concat("fan rollback state directory could not be created: ", state_dir.stderr),
    )
  } else {
    let copied = openbmc_copy_file_preserving_metadata(
      session: session,
      source_path: plan.config_path,
      destination_path: bmc_fan_remote_backup_stage_path(),
    )
    if !copied.success {
      bmc_fan_mutation_refused(
        reason: concat("current fan config backup failed: ", copied.stderr),
      )
    } else {
      let backup_replaced = openbmc_rename_replace(
        session: session,
        source_path: bmc_fan_remote_backup_stage_path(),
        destination_path: bmc_fan_remote_backup_path(),
      )
      if !backup_replaced.success {
        bmc_fan_mutation_refused(
          reason: concat("fan config backup publication failed: ", backup_replaced.stderr),
        )
      } else {
        let version_uploaded = openbmc_upload_file(
          session: session,
          local_path: local_version_path,
          remote_path: bmc_fan_remote_backup_version_stage_path(),
        )
        if !version_uploaded.success {
          bmc_fan_mutation_refused(
            reason: concat("fan config backup version upload failed: ", version_uploaded.stderr),
          )
        } else {
          let version_replaced = openbmc_rename_replace(
            session: session,
            source_path: bmc_fan_remote_backup_version_stage_path(),
            destination_path: bmc_fan_remote_backup_version_path(),
          )
          if !version_replaced.success {
            bmc_fan_mutation_refused(
              reason: concat("fan config backup version publication failed: ", version_replaced.stderr),
            )
          } else {
            let synchronized = openbmc_synchronize_filesystems(
              session: session,
            )
            if synchronized.success {
              bmc_fan_mutation_applied()
            } else {
              bmc_fan_mutation_refused(
                reason: concat("fan config backup synchronization failed: ", synchronized.stderr),
              )
            }
          }
        }
      }
    }
  }
}

fn bmc_fan_apply_from_local_files(
  session: PasswordSshSession,
  plan: BmcFanPolicyApplyPlan,
  desired: OpenBmcFanConfigDesired,
  local_stage_path: NonEmptyStr,
  local_version_path: NonEmptyStr,
) -> BmcFanTypedMutationResult {
  let backup = bmc_fan_prepare_backup(
    session: session,
    plan: plan,
    local_version_path: local_version_path,
  )
  if !bmc_fan_mutation_succeeded(result: backup) {
    backup
  } else {
    let remote_stage = bmc_fan_remote_config_stage_path(plan: plan)
    let uploaded = openbmc_upload_file(
      session: session,
      local_path: local_stage_path,
      remote_path: remote_stage,
    )
    if !uploaded.success {
      bmc_fan_mutation_refused(
        reason: concat("projected fan config upload failed: ", uploaded.stderr),
      )
    } else {
      let published = bmc_fan_publish_staged_config(
        session: session,
        protocol: plan.projection.publication_protocol,
        staged_path: remote_stage,
        destination_path: plan.config_path,
      )
      match published {
        BmcFanNoEffectRefused {
          reason: reason,
          rollback: _,
        } =>
          bmc_fan_failure_with_restore(
            session: session,
            plan: plan,
            reason: reason,
          )
        BmcFanAppliedAndVerified { rollback: _ } => {
          let restarted = bmc_fan_restart_and_verify_controller(
            session: session,
            plan: plan,
            desired: Present { value: desired },
          )
          match restarted {
            BmcFanAppliedAndVerified { rollback: _ } =>
              bmc_fan_mutation_applied()
            BmcFanNoEffectRefused {
              reason: reason,
              rollback: _,
            } =>
              bmc_fan_failure_with_restore(
                session: session,
                plan: plan,
                reason: reason,
              )
            _ =>
              bmc_fan_failure_with_restore(
                session: session,
                plan: plan,
                reason: "controller verification returned an impossible transaction outcome",
              )
          }
        }
        _ =>
          bmc_fan_failure_with_restore(
            session: session,
            plan: plan,
            reason: "publication returned an impossible transaction outcome",
          )
      }
    }
  }
}

fn bmc_fan_apply_locked(
  session: PasswordSshSession,
  plan: BmcFanPolicyApplyPlan,
) -> BmcFanTypedMutationResult {
  match bmc_fan_observe_live_identity(session: session) {
    BmcFanLiveIdentityRefused { reason: reason } =>
      bmc_fan_mutation_refused(reason: reason)
    BmcFanLiveIdentityObserved { identity: identity } =>
      if identity.firmware != plan.observed.firmware {
        bmc_fan_mutation_refused(
          reason: "BMC firmware changed after fan-policy observation",
        )
      } else {
        let selected = openbmc_resolve_path(
          session: session,
          path: "/usr/share/swampd/config.json",
        )
        if !selected.success || trim(selected.stdout) != (plan.config_path as String) {
          bmc_fan_mutation_refused(
            reason: "selected board fan config changed after observation",
          )
        } else {
          let current = openbmc_read_file(
            session: session,
            path: plan.config_path,
          )
          if !current.success {
            bmc_fan_mutation_refused(
              reason: concat("current fan config read failed: ", current.stderr),
            )
          } else {
            let temp = shell.Mktemp.Dir()
            if !temp.success {
              bmc_fan_mutation_refused(
                reason: "local fan config staging directory creation failed",
              )
            } else {
              let input_path = concat(temp.path as String, "/current.json") as NonEmptyStr
              let stage_path = concat(temp.path as String, "/projected.json") as NonEmptyStr
              let version_path = concat(temp.path as String, "/previous.version") as NonEmptyStr
              let source_write = Filesystem.Write(
                path: input_path as String,
                content: current.stdout,
              )
              let desired = bmc_fan_policy_projection_request(
                curve: plan.desired_curve,
                projection: plan.projection,
              )
              let result = if !source_write.success {
                bmc_fan_mutation_refused(
                  reason: concat("local source config staging failed: ", source_write.error),
                )
              } else {
                let projected = openbmc_fan_config_project_local(
                  input_path: input_path,
                  desired: desired,
                )
                if !projected.success {
                  bmc_fan_mutation_refused(
                    reason: concat("semantic jq fan config projection failed: ", projected.stderr),
                  )
                } else if !json_text_parseable(s: projected.content) {
                  bmc_fan_mutation_refused(
                    reason: "projected fan config is not parseable JSON",
                  )
                } else {
                  let stage_write = Filesystem.Write(
                    path: stage_path as String,
                    content: projected.content,
                  )
                  let version_write = Filesystem.Write(
                    path: version_path as String,
                    content: concat(identity.firmware.version as String, "\n"),
                  )
                  if !stage_write.success || !version_write.success {
                    bmc_fan_mutation_refused(
                      reason: "local projected config or backup-version staging failed",
                    )
                  } else {
                    bmc_fan_apply_from_local_files(
                      session: session,
                      plan: plan,
                      desired: desired,
                      local_stage_path: stage_path,
                      local_version_path: version_path,
                    )
                  }
                }
              }
              let cleaned = shell.Remove.RecursiveForce(path: temp.path)
              if !cleaned.success && bmc_fan_mutation_succeeded(result: result) {
                bmc_fan_record_cleanup_debt(
                  result: result,
                  cleanup_debt: "local staging cleanup failed",
                )
              } else {
                result
              }
            }
          }
        }
      }
  }
}

fn bmc_fan_apply_typed(
  session: PasswordSshSession,
  plan: BmcFanPolicyApplyPlan,
) -> BmcFanTypedMutationResult {
  bmc_fan_mutation_refused(
    reason: "BMC fan mutation is phase-partial: atomic content-addressed backup manifest and bounded monitoring receipt are not yet admitted",
  )
}

fn bmc_fan_rollback_typed(
  session: PasswordSshSession,
  plan: BmcFanPolicyApplyPlan,
) -> BmcFanTypedMutationResult {
  bmc_fan_mutation_refused(
    reason: "BMC fan rollback is phase-partial: no atomic content-addressed backup manifest receipt is admitted",
  )
}

fn bmc_fan_observe_with_credential(
  target: BmcFanConvergeTarget,
  credential: Secret,
) -> BmcFanLiveObservationResult {
  let session = PasswordSshSession {
    host: target.onboarding.bmc.host,
    username: target.onboarding.factory_login.username,
    password: credential,
    known_hosts_path: target.ssh_known_hosts_path,
    expected_machine_id_path: target.expected_bmc_machine_id_path,
  }
  match bmc_fan_observe_live_identity(session: session) {
    BmcFanLiveIdentityRefused { reason: reason } =>
      BmcFanLiveObservationRefused { reason: reason }
    BmcFanLiveIdentityObserved { identity: identity } =>
      if identity.machine != "altrad8ud-1l2t" {
        BmcFanLiveObservationRefused {
          reason: concat(
            "BMC fan identity is not altrad8ud-1l2t: ",
            identity.machine as String,
          ),
        }
      } else if !bmc_fan_identity_matches_firmware_intent(
        identity: identity,
        intent: fleet_bmc_valid_state.firmware,
      ) {
        BmcFanLiveObservationRefused {
          reason: concat(
            concat(
              "BMC fan convergence refused before version-specific config observation: observed OpenBMC ",
              identity.firmware.version as String,
            ),
            concat(
              "; fleet valid state requires ",
              bmc_fan_firmware_intent_requirement(
                intent: fleet_bmc_valid_state.firmware,
              ),
            ),
          ),
        }
      } else {
        match target.projection {
          Absent =>
            BmcFanLiveObservationRefused {
              reason: concat(
                "BMC fan convergence has no exact board-and-firmware projection for observed OpenBMC ",
                identity.firmware.version as String,
              ),
            }
          Present { value: projection } =>
            if projection.firmware != identity.firmware {
              BmcFanLiveObservationRefused {
                reason: concat(
                  concat(
                    "BMC fan convergence has no exact config projection for observed OpenBMC ",
                    identity.firmware.version as String,
                  ),
                  concat(
                    "; available projection is ",
                    projection.firmware.version as String,
                  ),
                ),
              }
            } else {
              match bmc_fan_observe_typed_parts(
                session: session,
                identity: identity,
                plan: bmc_fan_typed_observation_plan(
                  projection: projection,
                  intent: fleet_bmc_valid_state,
                ),
              ) {
                BmcFanObservedPartsRefused { reason: reason } =>
                  BmcFanLiveObservationRefused { reason: reason }
                BmcFanObservedParts {
                  selected_config_path,
                  board_config_path,
                  controller_service,
                  controller_binary,
                  zone_control_path,
                  zone_failsafe_active,
                  writable,
                  upper_override_present,
                  available_bytes,
                  observed_at,
                  overlay: overlay,
                  config: config,
                  config_digest: config_digest,
                  tach_health: tach_health,
                  temperatures,
                } =>
                  bmc_fan_build_live_observation(
                    identity: identity,
                    selected_config_path: selected_config_path,
                    board_config_path: board_config_path,
                    controller_service: controller_service,
                    controller_binary: controller_binary,
                    zone_control_path: zone_control_path,
                    zone_failsafe_active: zone_failsafe_active,
                    writable: writable,
                    upper_override_present: upper_override_present,
                    available_bytes: available_bytes,
                    observed_at: observed_at,
                    overlay: overlay,
                    config: config,
                    config_digest: config_digest,
                    tach_health: tach_health,
                    temperatures: temperatures,
                  )
              }
            }
        }
  }
}
}

fn bmc_fan_rollback_after_failed_readback(
  target: BmcFanConvergeTarget,
  credential: Secret,
  plan: BmcFanPolicyApplyPlan,
  reason: String,
) -> ProcessExit {
  let rollback = bmc_fan_rollback_typed(
    session: PasswordSshSession {
      host: target.onboarding.bmc.host,
      username: target.onboarding.factory_login.username,
      password: credential,
      known_hosts_path: target.ssh_known_hosts_path,
      expected_machine_id_path: target.expected_bmc_machine_id_path,
    },
    plan: plan,
  )
  match rollback {
    BmcFanRestoredAndVerified { rollback: _ } =>
      exit_failure(
        reason: concat(
          "BMC fan convergence failed independent readback and restored the previous config: ",
          reason,
        ),
      )
    BmcFanNoEffectRefused {
      reason: rollback_reason,
      rollback: rollback_receipt,
    } =>
      exit_failure(
        reason: concat(
          concat(
            "BMC fan convergence failed independent readback and rollback also failed: ",
            reason,
          ),
          concat(
            "; typed rollback: ",
            bmc_fan_mutation_failure_reason(
              reason: rollback_reason,
              rollback: rollback_receipt,
            ),
          ),
        ),
      )
    _ =>
      exit_failure(
        reason: join(
          [
            "BMC fan convergence failed independent readback; rollback produced a non-refusal effect outcome requiring receipt persistence: ",
            reason,
          ],
          "",
        ),
      )
  }
}

fn bmc_fan_observe_only_with_credential(
  target: BmcFanConvergeTarget,
  credential: Secret,
) -> ProcessExit {
  match bmc_fan_observe_with_credential(
    target: target,
    credential: credential,
  ) {
    BmcFanLiveObservationRefused { reason: reason } =>
      exit_failure(reason: reason)
    BmcFanLiveObserved { observation: observed } => {
      let classified = bmc_fan_policy_classification(
        host: target.host.identity,
        board: target.board,
        intent: fleet_bmc_valid_state,
        observation: Present { value: observed.policy },
        persistence: Present { value: observed.persistence },
        projection: target.projection,
        durability_generation: target.durability_generation,
        durability_evidence: target.durability_evidence,
      )
      match classified.decision {
        Refuse { reason: reason } =>
          exit_failure(reason: concat("BMC fan read-only classification refused: ", reason))
        Noop =>
          match target.projection {
            Absent =>
              exit_failure(reason: "BMC fan policy is converged but no exact live-safety projection is available")
            Present { value: projection } =>
              match bmc_fan_live_safety_refusal(
                observation: observed,
                intent: fleet_bmc_valid_state,
                projection: projection,
              ) {
                Absent => ExitSuccess
                Present { value: reason } =>
                  exit_failure(
                    reason: concat(
                      "BMC fan read-only classification is converged, but live safety refused: ",
                      reason,
                    ),
                  )
              }
          }
        Apply { plan: plan } =>
          match bmc_fan_live_thermal_tach_safety_refusal(
            observation: observed,
            intent: fleet_bmc_valid_state,
            projection: plan.projection,
          ) {
            Absent =>
              exit_failure(reason: "BMC fan read-only classification observed safe drift: apply required")
            Present { value: reason } =>
              exit_failure(
                reason: concat(
                  "BMC fan read-only classification observed drift, but pre-apply safety refused: ",
                  reason,
                ),
              )
          }
      }
    }
  }
}

fn bmc_fan_rollback_previous_with_credential(
  target: BmcFanConvergeTarget,
  credential: Secret,
) -> ProcessExit {
  match target.projection {
    Absent =>
      exit_failure(reason: "BMC fan rollback has no exact board-and-firmware projection")
    Present { value: projection } =>
      match bmc_fan_observe_with_credential(
        target: target,
        credential: credential,
      ) {
        BmcFanLiveObservationRefused { reason: reason } =>
          exit_failure(reason: reason)
        BmcFanLiveObserved { observation: observed } => {
          let plan = BmcFanPolicyApplyPlan {
            host: target.host.identity,
            observed: observed.policy,
            desired_curve: fleet_bmc_valid_state.fan_policy.curve,
            config_path: projection.config_path,
            controller_service: projection.controller_service,
            projection: projection,
          }
          let rollback = bmc_fan_rollback_typed(
            session: PasswordSshSession {
              host: target.onboarding.bmc.host,
              username: target.onboarding.factory_login.username,
              password: credential,
              known_hosts_path: target.ssh_known_hosts_path,
              expected_machine_id_path: target.expected_bmc_machine_id_path,
            },
            plan: plan,
          )
          match rollback {
            BmcFanNoEffectRefused {
              reason: reason,
              rollback: rollback_receipt,
            } =>
              exit_failure(
                reason: concat(
                  "BMC fan rollback failed: ",
                  bmc_fan_mutation_failure_reason(
                    reason: reason,
                    rollback: rollback_receipt,
                  ),
                ),
              )
            BmcFanRestoredAndVerified { rollback: _ } =>
              match bmc_fan_observe_with_credential(
                target: target,
                credential: credential,
              ) {
                BmcFanLiveObservationRefused { reason: reason } =>
                  exit_failure(reason: concat("BMC fan rollback completed but independent observation failed: ", reason))
                BmcFanLiveObserved { observation: readback } =>
                  match bmc_fan_live_thermal_tach_safety_refusal(
                    observation: readback,
                    intent: fleet_bmc_valid_state,
                    projection: projection,
                  ) {
                    Absent => ExitSuccess
                    Present { value: reason } =>
                      exit_failure(
                        reason: concat(
                          "BMC fan rollback completed but independent safety refused: ",
                          reason,
                        ),
                      )
                  }
              }
            _ =>
              exit_failure(
                reason: "BMC fan rollback produced a cleanup-debt or impossible effect outcome; the typed receipt must be retained",
              )
          }
        }
      }
  }
}

fn bmc_fan_converge_with_credential(
  target: BmcFanConvergeTarget,
  credential: Secret,
) -> ProcessExit {
  match bmc_fan_observe_with_credential(
    target: target,
    credential: credential,
  ) {
    BmcFanLiveObservationRefused { reason: reason } =>
      exit_failure(reason: reason)
    BmcFanLiveObserved { observation: observed } => {
      let classified = bmc_fan_policy_classification(
        host: target.host.identity,
        board: target.board,
        intent: fleet_bmc_valid_state,
        observation: Present { value: observed.policy },
        persistence: Present { value: observed.persistence },
        projection: target.projection,
        durability_generation: target.durability_generation,
        durability_evidence: target.durability_evidence,
      )
      match classified.decision {
        Refuse { reason: reason } =>
          exit_failure(reason: concat("BMC fan convergence refused: ", reason))
        Noop =>
          match target.projection {
            Absent =>
              exit_failure(reason: "BMC fan policy is semantically converged but has no exact safety-probe projection")
            Present { value: projection } =>
              match bmc_fan_live_safety_refusal(
                observation: observed,
                intent: fleet_bmc_valid_state,
                projection: projection,
              ) {
                Absent => ExitSuccess
                Present { value: reason } =>
                  exit_failure(
                    reason: concat(
                      "BMC fan policy matches intent but live safety readback refused: ",
                      reason,
                    ),
                  )
              }
          }
        Apply { plan: plan } =>
          match bmc_fan_live_thermal_tach_safety_refusal(
            observation: observed,
            intent: fleet_bmc_valid_state,
            projection: plan.projection,
          ) {
            Present { value: reason } =>
              exit_failure(
                reason: concat(
                  "BMC fan convergence refused before mutation because live safety did not hold: ",
                  reason,
                ),
              )
            Absent => {
            let apply_run = bmc_fan_apply_typed(
              session: PasswordSshSession {
                host: target.onboarding.bmc.host,
                username: target.onboarding.factory_login.username,
                password: credential,
                known_hosts_path: target.ssh_known_hosts_path,
                expected_machine_id_path: target.expected_bmc_machine_id_path,
              },
              plan: plan,
            )
            match apply_run {
              BmcFanNoEffectRefused {
                reason: reason,
                rollback: rollback_receipt,
              } =>
                exit_failure(
                  reason: concat(
                    "BMC fan apply failed: ",
                    bmc_fan_mutation_failure_reason(
                      reason: reason,
                      rollback: rollback_receipt,
                    ),
                  ),
                )
              BmcFanAppliedAndVerified { rollback: _ } =>
              match bmc_fan_observe_with_credential(
                target: target,
                credential: credential,
              ) {
                BmcFanLiveObservationRefused { reason: reason } =>
                  bmc_fan_rollback_after_failed_readback(
                    target: target,
                    credential: credential,
                    plan: plan,
                    reason: reason,
                  )
                BmcFanLiveObserved { observation: readback } => {
                  let reclassified = bmc_fan_policy_classification(
                    host: target.host.identity,
                    board: target.board,
                    intent: fleet_bmc_valid_state,
                    observation: Present { value: readback.policy },
                    persistence: Present { value: readback.persistence },
                    projection: target.projection,
                    durability_generation: target.durability_generation,
                    durability_evidence: target.durability_evidence,
                  )
                  match reclassified.decision {
                    Noop =>
                      if bmc_fan_live_safety_holds(
                        observation: readback,
                        intent: fleet_bmc_valid_state,
                        projection: plan.projection,
                      ) {
                        ExitSuccess
                      } else {
                        bmc_fan_rollback_after_failed_readback(
                          target: target,
                          credential: credential,
                          plan: plan,
                          reason: "post-apply thermal/tach safety probe did not hold",
                        )
                      }
                    Refuse { reason: reason } =>
                      bmc_fan_rollback_after_failed_readback(
                        target: target,
                        credential: credential,
                        plan: plan,
                        reason: concat("post-apply classification refused: ", reason),
                      )
                    Apply { plan: _ } =>
                      bmc_fan_rollback_after_failed_readback(
                        target: target,
                        credential: credential,
                        plan: plan,
                        reason: "post-apply classification remained drifted",
                      )
                  }
                }
              }
              _ =>
                exit_failure(
                  reason: "BMC fan apply produced a cleanup-debt or non-primary effect outcome; the typed receipt must be retained",
                )
            }
          }
          }
      }
    }
  }
}

func bmc_fan_run(
  target: BmcFanConvergeTarget,
  action: BmcFanRequestedAction,
) -> ProcessExit
  uses net: Network
{
  let sshpass = shell.Which.Check(command: "sshpass")
  if !sshpass.exists {
    return exit_failure(
      reason: "BMC fan convergence needs sshpass (password is fed through fd 0, never argv)",
    )
  }
  match fetch_secret_ref_credential(
    secret_ref: onboarding_secret_ref(plan: target.onboarding),
    token_source: GcloudPrintToken,
  ) {
    SecretCredentialAccessUpsertRequired { plan: plan } =>
      exit_failure(reason: access_token_upsert_required_reason(plan: plan))
    SecretCredentialFetchRefused { reason: reason } =>
      exit_failure(reason: reason as String)
    SecretCredentialReady { credential: credential } =>
      match action {
        BmcFanObserveOnly =>
          bmc_fan_observe_only_with_credential(
            target: target,
            credential: credential,
          )
        BmcFanConvergeRequested =>
          bmc_fan_converge_with_credential(
            target: target,
            credential: credential,
          )
        BmcFanRollbackPrevious =>
          bmc_fan_rollback_previous_with_credential(
            target: target,
            credential: credential,
          )
      }
  }
}

func srv3_bmc_fan_observe() -> ProcessExit
  uses net: Network
{
  bmc_fan_run(
    target: srv3_bmc_fan_converge_target,
    action: BmcFanObserveOnly,
  )
}

func srv3_bmc_fan_converge() -> ProcessExit
  uses net: Network
{
  bmc_fan_run(
    target: srv3_bmc_fan_converge_target,
    action: BmcFanConvergeRequested,
  )
}

func srv4_bmc_fan_observe() -> ProcessExit
  uses net: Network
{
  bmc_fan_run(
    target: srv4_bmc_fan_converge_target,
    action: BmcFanObserveOnly,
  )
}

func srv4_bmc_fan_converge() -> ProcessExit
  uses net: Network
{
  bmc_fan_run(
    target: srv4_bmc_fan_converge_target,
    action: BmcFanConvergeRequested,
  )
}

func srv4_bmc_fan_rollback_previous() -> ProcessExit
  uses net: Network
{
  bmc_fan_run(
    target: srv4_bmc_fan_converge_target,
    action: BmcFanRollbackPrevious,
  )
}

data bmc_fan_converge_subsumption_note: String = "The BMC fan subsumption entrypoint is now an actual observe -> typed classify -> apply/noop -> independent observe -> thermal/tach proof loop. GCP access remains demand-derived through fetch_secret_ref_credential. Password SSH receives the Secret on fd 0, stages JSON on the config filesystem, validates it, atomically replaces it, restarts phosphor-pid-control, and retains an exact-version previous config. Any immediate or independent readback failure restores that prior file. srv4 has an exact 3.22 projection and can converge; srv3 refuses before mutation because its observed 2.07 firmware does not satisfy the global 3.x intent."
