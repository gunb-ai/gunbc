module gunbc.host_codex_runtime_provision_script


data host_codex_runtime_provision_script_dissolution_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: host_codex_runtime_provision_script — concat-built observe/ensure/read-back shell; DISSOLVES WHEN bash-emit (#5828) realizes ProvisionCodexRuntime as typed host-effect argv and realize_provision_codex_runtime retires shell_exec_via_bash transport.")

data host_codex_runtime_provision_script_census_row_note: String = "CENSUS STANDING: docs/plans/shell-to-dag-residual-census-and-arc-completion.md §4.A keys this file as the builder for host_effect_realize.ProvisionCodexRuntime, action DECOMPOSE, sub-class A5 (srv* cluster, operator-deferred 2026-07-22 — same deferral class as host_build_cache_provision_script; un-defer trigger is the operator). This site is RUNTIME-PRESENT (realizes through host_effect_apply on LocalShell/SshShell), so per that doc's routing decision its end state is typed observe/ensure/read-back argv with NO bash emitted — the four *_body builders below are the debt, not the design. This PR introduces the debt to close a fleet gap (nothing ensured /opt/gunbc/provider-runtime/codex at the pinned lock); it is not an uncited expansion of an unrelated surface. Standing constraint while the row is deferred (review 42401 on the build-cache twin): NEW emitted shell must be a DEDUCTION or a cited-de-fork SWAP — here it is the minimum transport for a NEW ProvisionCodexRuntime effect, mirroring the build-cache lane's interim shape until #5828. Adding further *_body builders or uncited shell leaves is a census regression."

data host_codex_runtime_provision_script_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_codex_runtime_provision_script",
    decl_name: "host_codex_runtime_provision_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}

fn codex_runtime_gunbc_src_v2_root(gunbc_repo: String) -> String {
  concat(gunbc_repo, "/src/v2")
}

fn codex_runtime_observe_body(executable: String, marker: String) -> String {
  let executable_q = shell_quote(arg: executable)
  let marker_q = shell_quote(arg: marker)
  join([
    "observe_out=\"\"",
    "observe_rc=0",
    join(["if [ -x ", executable_q, " ]; then"], " "),
    join(["  observe_out=$(", executable_q, " --version 2>&1) || observe_rc=$?"], " "),
    "else",
    "  printf '%s\\n' \"CodexRuntimeProvisionReceipt: observe=absent\"",
    "  observe_rc=127",
    "fi",
    "if [ \"$observe_rc\" -eq 0 ]; then",
    join(["  if printf '%s' \"$observe_out\" | grep -Fx ", marker_q, " >/dev/null; then"], " "),
    "    printf '%s\\n' \"CodexRuntimeProvisionReceipt: observe=ok\"",
    "    printf '%s\\n' \"$observe_out\"",
    "    exit 0",
    "  fi",
    "fi",
    "",
  ], "\n")
}

fn codex_runtime_ensure_body(
  release_parent: String,
  gunbc_binary: String,
  gunbc_repo: String,
) -> String {
  let release_parent_q = shell_quote(arg: release_parent)
  let gunbc_binary_q = shell_quote(arg: gunbc_binary)
  let gunbc_repo_q = shell_quote(arg: gunbc_repo)
  let gunbc_src_v2_q = shell_quote(arg: codex_runtime_gunbc_src_v2_root(gunbc_repo: gunbc_repo))
  join([
    join(["mkdir -p ", release_parent_q], " "),
    join([
      "if ! ",
      gunbc_binary_q,
      " run --source-root ",
      gunbc_repo_q,
      " --source-root ",
      gunbc_src_v2_q,
      " --entry dag/gunbc/host_codex_runtime_provision.dag --function materialize_codex_runtime_on_local_host; then",
      "  printf '%s\\n' \"CodexRuntimeProvisionReceipt: ensure=FAILED\"",
      "  exit 1",
      "fi",
    ], " "),
    "",
  ], "\n")
}

fn codex_runtime_read_back_body(executable: String, marker: String) -> String {
  let executable_q = shell_quote(arg: executable)
  let marker_q = shell_quote(arg: marker)
  join([
    join(["if ver_out=$(", executable_q, " --version 2>&1); then"], " "),
    join(["  if printf '%s' \"$ver_out\" | grep -Fx ", marker_q, " >/dev/null; then"], " "),
    "    printf '%s\\n' \"CodexRuntimeProvisionReceipt: read_back=ok\"",
    "    printf '%s\\n' \"$ver_out\"",
    "    exit 0",
    "  fi",
    "fi",
    "printf '%s\\n' \"CodexRuntimeProvisionReceipt: read_back=FAILED identity not realized\"",
    "exit 1",
    "",
  ], "\n")
}

fn codex_runtime_provision_script_body(
  executable: String,
  release_parent: String,
  gunbc_binary: String,
  gunbc_repo: String,
) -> String {
  let marker = codex_runtime_version_identity_marker()
  join([
    "set -euo pipefail",
    codex_runtime_observe_body(executable: executable, marker: marker),
    "printf '%s\\n' \"CodexRuntimeProvisionReceipt: ensure=starting\"",
    codex_runtime_ensure_body(
      release_parent: release_parent,
      gunbc_binary: gunbc_binary,
      gunbc_repo: gunbc_repo,
    ),
    codex_runtime_read_back_body(executable: executable, marker: marker),
  ], "\n")
}

fn codex_runtime_provision_read_back_fails_closed() -> Bool {
  let body = codex_runtime_read_back_body(
    executable: "/opt/gunbc/provider-runtime/codex/current/bin/codex",
    marker: codex_runtime_version_identity_marker(),
  )
  string_contains(s: body, pattern: "read_back=FAILED")
    && string_contains(s: body, pattern: "exit 1")
}

fn codex_runtime_provision_shell_uses_exact_line_grep() -> Bool {
  let body = codex_runtime_provision_script_body(
    executable: "/opt/gunbc/provider-runtime/codex/current/bin/codex",
    release_parent: srv1_codex_runtime_release_root as String,
    gunbc_binary: srv1_gunbc_serve_binary as String,
    gunbc_repo: srv1_gunbc_repo_root as String,
  )
  string_contains(s: body, pattern: "grep -Fx ")
    && !string_contains(s: body, pattern: "grep -Fq ")
}

fn codex_runtime_provision_fleet_paths_are_shell_safe() -> Bool {
  let paths = [
    srv1_codex_runtime_release_root as String,
    srv1_gunbc_serve_binary as String,
    srv1_gunbc_repo_root as String,
    codex_runtime_version_identity_marker(),
    "/opt/gunbc/provider-runtime/codex/current/bin/codex",
  ]
  fold(
    paths,
    init: true,
    f: (acc, path) => acc && !string_contains(s: path, pattern: "'"),
  )
}

fn codex_runtime_provision_shell_uses_shell_quote_authority() -> Bool {
  let body = codex_runtime_provision_script_body(
    executable: "/opt/gunbc/provider-runtime/codex/current/bin/codex",
    release_parent: srv1_codex_runtime_release_root as String,
    gunbc_binary: srv1_gunbc_serve_binary as String,
    gunbc_repo: srv1_gunbc_repo_root as String,
  )
  string_contains(s: body, pattern: shell_quote(arg: srv1_gunbc_serve_binary as String))
    && string_contains(s: body, pattern: shell_quote(arg: srv1_gunbc_repo_root as String))
}

fn codex_runtime_provision_shell_script(
  executable: String,
  release_parent: String,
  gunbc_binary: String,
  gunbc_repo: String,
) -> String {
  shell_exec_via_bash(
    body: codex_runtime_provision_script_body(
      executable: executable,
      release_parent: release_parent,
      gunbc_binary: gunbc_binary,
      gunbc_repo: gunbc_repo,
    ),
  )
}
