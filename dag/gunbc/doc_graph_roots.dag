fn hand_authored_doc_graph_roots() -> List<String> {
  map(hand_authored_doc_binds, b => hand_authored_doc_path(b: b))
}

fn doc_graph_roots_all() -> List<String> {
  concat(plan_doc_graph_roots(), hand_authored_doc_graph_roots())
}

fn hand_authored_plan_slug_is_unregistered(b: HandAuthoredDocBind) -> Bool {
  match b.home {
    PlanDoc => all(all_plans, p => p.slug != b.slug)
    ProbeDoc => true
  }
}

fn hand_authored_slugs_all_unregistered() -> Bool {
  all(hand_authored_doc_binds, b => hand_authored_plan_slug_is_unregistered(b: b))
}
