module gunbc.doc_graph_roots

import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.plan { Plan, plan_path, plan_doc_path, DissolutionTrigger, HasTrigger }
import gunbc.plan_registry { all_plans }

data doc_graph_roots_note: String = "The single authority for doc-graph roots. Registered plans derive theirs (a PlanArtifact registration IS the document binding); hand-authored docs declare typed HandAuthoredDocBind rows — symbolic identity (home + slug, the same key space as Plan.slug; the file path is a derived storage projection, never stored), the .dag work the doc binds to, and the trigger that deletes the row. No prose 'bind:' scan remains: an unbound doc is an orphan, loudly; a hand-authored slug colliding with a registered plan slug is a red (the row outlived its migration)."

fn plan_doc_graph_roots() -> List<String> {
  map(all_plans, p => plan_path(p: p))
}

type DocHome
  = PlanDoc
  | ProbeDoc

type HandAuthoredDocBind {
  home: DocHome,
  slug: String,
  work: DeclarationRef,
  dissolution: DissolutionTrigger,
}

fn hand_authored_doc_path(b: HandAuthoredDocBind) -> String {
  match b.home {
    PlanDoc => plan_doc_path(slug: b.slug)
    ProbeDoc => concat("docs/probes/", concat(b.slug, ".md"))
  }
}

