module gunbc.doc_graph_roots

import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.plan { Plan, plan_path, DissolutionTrigger, HasTrigger }
import gunbc.plan_registry { all_plans }

data doc_graph_roots_note: String = "The single authority for doc-graph roots. Registered plans derive theirs (a PlanArtifact registration IS the document binding); hand-authored docs declare theirs as typed HandAuthoredDocBind rows — doc, the .dag work it binds to, and the trigger that deletes the row. No prose 'bind:' scan remains: an unbound doc is an orphan, loudly."

fn plan_doc_graph_roots() -> List<String> {
  map(all_plans, p => plan_path(p: p))
}

type HandAuthoredDocBind {
  doc_path: String,
  work: DeclarationRef,
  dissolution: DissolutionTrigger,
}

data hand_authored_doc_binds: List<HandAuthoredDocBind> = [
  HandAuthoredDocBind {
    doc_path: "docs/plans/accelerator-demo-roundtrip.md",
    work: DeclarationRef { module_path: "extdeps.languages.simd.kernel", decl_name: "simd_kernel_medium", field: WholeDeclaration },
    dissolution: HasTrigger { text: "doc migrates into a registered gunbc.plan.Plan row; §6 item 2 execution lane lands on the simd handler" },
  },
  HandAuthoredDocBind {
    doc_path: "docs/plans/accelerator-demo-roundtrip.md",
    work: DeclarationRef { module_path: "gunbc.accelerator_demo_plan", decl_name: "AcceleratorRecognitionOutcome", field: WholeDeclaration },
