import gunbc.plan_registry { all_plans }
import v2.lens.module_graph { module_declaration_facts_live }
import v2.lens.doc_reachability { doc_graph_clean_holds, doc_graph_orphan_clean_holds }
import v2.std.algebra { filter, list_flat_map }
import v2.std.decl_index { decl_facts }
import v2.std.decl_ref_resolution { declaration_ref_resolves }
import std.keyed_row { KeyedRow }
import std.keyed_roster {
  KeyedRosterBuild,
  KeyedRosterBuilt,
  KeyedRosterBuildDuplicateKey,
  keyed_roster_build,
}

data doc_graph_roots_note: String = "The single authority for doc-graph roots. Registered plans derive theirs (a PlanArtifact registration IS the document binding); hand-authored docs declare typed HandAuthoredDocBind rows — symbolic identity (home + slug, the same key space as Plan.slug; the file path is a derived storage projection, never stored), the .dag work the doc binds to, and its PlanRetirement. Most rows retire: the condition names the change that deletes the row. Some do NOT -- the cited-symbol-resolution discriminating controls (hand_authored_bind_is_cited_symbol_resolution_control) are permanent evidence and carry PlanHasNoRetirement, because a climb deletes production machinery and keeps the discriminating evidence (DESIGN 4b(4)). A permanent row stating 'never retires' inside an unbound condition would be a model contradiction: the coproduct would say retires-when while the payload said never. No prose 'bind:' scan remains: an unbound doc is an orphan, loudly; a hand-authored slug colliding with a registered plan slug is a red (the row outlived its migration)."

fn plan_doc_graph_roots() -> List<String> {
  map(all_plans, p => plan_path(p: p))
}

type DocHome
  = PlanDoc
  | ProbeDoc

type HandAuthoredDocBind {
  home: DocHome,
  slug: String,
  primary_work: DeclarationRef,
  additional_works: List<DeclarationRef>,
  dissolution: PlanRetirement,
}

fn hand_authored_bind_works(b: HandAuthoredDocBind) -> List<DeclarationRef> {
  concat([b.primary_work], b.additional_works)
}

fn declaration_ref_carries_symbol(r: DeclarationRef) -> Bool {
  r.module_path != "" && r.decl_name != ""
}

fn hand_authored_works_refs_all_carry_symbols() -> Bool {
  match hand_authored_doc_binds_population() {
    HandAuthoredDocBindsBuilt { binds: binds } =>
      all(binds, b => all(hand_authored_bind_works(b: b), r => declaration_ref_carries_symbol(r: r)))
    HandAuthoredDocBindsDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

fn hand_authored_bind_is_cited_symbol_resolution_control(b: HandAuthoredDocBind) -> Bool {
  b.slug == "g1-cited-symbol-control-declaration-absent"
    || b.slug == "g1-cited-symbol-control-module-absent"
    || b.slug == "g1-cited-symbol-control-field-absent"
}

fn hand_authored_production_doc_binds() -> List<HandAuthoredDocBind> {
  match hand_authored_doc_binds_population() {
    HandAuthoredDocBindsBuilt { binds: binds } =>
      filter(binds, b => !hand_authored_bind_is_cited_symbol_resolution_control(b: b))
    HandAuthoredDocBindsDuplicateKey { key: _, first: _, duplicate: _ } => []
  }
}

fn hand_authored_doc_declaration_refs() -> List<DeclarationRef> {
  list_flat_map(xs: hand_authored_doc_binds(), f: fn(b) { hand_authored_bind_works(b: b) })
}

fn hand_authored_production_doc_declaration_refs() -> List<DeclarationRef> {
  list_flat_map(xs: hand_authored_production_doc_binds(), f: fn(b) { hand_authored_bind_works(b: b) })
}

fn hand_authored_cited_symbol_control_declaration_refs() -> List<DeclarationRef> {
  list_flat_map(
    xs: filter(hand_authored_doc_binds(), b => hand_authored_bind_is_cited_symbol_resolution_control(b: b)),
    f: fn(b) { hand_authored_bind_works(b: b) }
  )
}

fn hand_authored_works_resolution_pool_roots() -> List<String> {
  compile_clean_source_roots()
}

fn hand_authored_works_refs_all_resolve() -> Bool {
  match hand_authored_doc_binds_population() {
    HandAuthoredDocBindsDuplicateKey { key: _, first: _, duplicate: _ } => false
    HandAuthoredDocBindsBuilt { binds: _ } => {
      let pool = hand_authored_works_resolution_pool_roots()
      let facts = decl_facts(pool_roots: pool)
      let modules = module_declaration_facts_live(pool_roots: pool)
      all(
        hand_authored_production_doc_declaration_refs(),
        r => declaration_ref_resolves(ref: r, facts: facts, modules: modules)
      )
    }
  }
}

fn hand_authored_bind_key(b: HandAuthoredDocBind) -> String {
  match b.home {
    PlanDoc => concat("plan/", b.slug)
    ProbeDoc => concat("probe/", b.slug)
  }
}

fn hand_authored_doc_path(b: HandAuthoredDocBind) -> String {
  match b.home {
    PlanDoc => plan_doc_path(slug: b.slug)
    ProbeDoc => concat("docs/probes/", concat(b.slug, ".md"))
  }
}

data body_lowering_ref_home_note: String = "THE THREE BODY-LOWERING SYSTEM REFERENCES LIVE HERE, ONCE, BECAUSE TWO DOCUMENTS NAME THEM. The generated design document names them in its body-lowering paragraph and the hand-authored general-body-producer plan names them in its discharged-prerequisite paragraph, so authoring one DeclarationRef literal in each place would be the dual representation this program exists to remove -- and the copies would then rot independently, which is precisely the failure that produced the bind below. The home is this module rather than gunbc.documentary_refs because the union projection imports in that direction; reversing it would be a cycle."

data body_lowering_symbol_index_ref: DeclarationRef = DeclarationRef { module_path: "v2.std.symbol_index", decl_name: "SymbolIndex", field: WholeDeclaration }

data body_lowering_lexical_lookup_ref: DeclarationRef = DeclarationRef { module_path: "v2.std.symbol_index", decl_name: "symbol_index_lexical_lookup", field: WholeDeclaration }

data body_lowering_production_consumer_ref: DeclarationRef = DeclarationRef { module_path: "v2.compiler.resolve", decl_name: "lookup_symbol_index_atom_identity", field: WholeDeclaration }

data mock_corpus_prefilter_control_note: String = "LIVE CONTROL FOR THE MOCK-CORPUS DECLARER OBSERVATION, and the reason this sentence names the type it does. This module imports v2 modules and sits under dag/, so it is exactly the shape that broke the floor when whole-tree published-mock declarer selection was decided by a substring scan: a documentary row naming PublishedMockCase made this file read as a corpus declarer, its closure could not resolve under the dag-only roots that precompute uses, and the run refused before any witness executed. The declarer decision is now the exact type-annotation check. This sentence therefore MENTIONS PublishedMockCase without declaring one, so if the substring shortcut is ever restored the floor reds here first."

