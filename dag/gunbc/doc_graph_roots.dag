  HandAuthoredDocBind {
    doc_path: "docs/plans/rc-ownership-wrap-decision-design.md",
    work: DeclarationRef { module_path: "v2.compiler.wrap_decision", decl_name: "WrapDecisionBundleChildLookup", field: WholeDeclaration },
