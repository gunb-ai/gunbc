// The single authority for doc-graph roots. Registered plans derive theirs (a PlanArtifact
// registration IS the document binding); hand-authored docs declare typed HandAuthoredDocBind rows
// — symbolic identity (home + slug, the same key space as Plan.slug; the file path is a derived
// storage projection, never stored), the .dag work the doc binds to, and its PlanRetirement. EVERY
// ROW RETIRES: the condition names the change that deletes the row. It was not always so -- three
// cited-symbol-resolution discriminating controls sat here carrying PlanHasNoRetirement, and a
// slug-matched predicate subtracted them again from document production. They were never documents:
// they are machine discriminators for v2.lens.cited_symbol_resolution, and after the 2026-08-24
// bankruptcy deleted docs/probes they were document binds naming no document. They moved to that
// lens as a typed control carrier on 2026-08-25 (operator ruling), so the exemption, the predicate
// and the non-retiring arm all left with them. A bind that does not retire now has no home here.
//
// SIXTEEN PROBE-DOC BINDS WERE DELETED THE SAME DAY, AND THE HOME AXIS DELIBERATELY SURVIVED THEM.
// Every remaining ProbeDoc row named a file under docs/probes that the 2026-08-24 bankruptcy
// deleted -- all sixteen, with no survivor -- and a bind whose document does not exist is not a
// root: build_doc_graph_report admits an extra root only when it is present in the doc universe and
// counts what it admitted, so those rows made doc_graph_registered_plan_roots_all_admitted RED,
// invisible only because that witness declares ReadsLiveTree and the floor declines it before the
// fold. Deleting the DocHome coproduct along with them was drafted and then REVERTED, because the
// population is not closed the way an empty variant suggests: the bankruptcy principle is that
// UNCONSUMED TRANSCRIPTION disappears while CONSUMED EVIDENCE stays attached to its consumer, and
// the directory a file sits in is not the authority on which it is -- the exact consumer relation
// is. At least one probe document is consumed evidence and IS NOW RE-BOUND
// (leading_minus_continuation_silently_truncates_2026-08-23, the parser-defect receipt
// extdeps.cpu_attachment.lotes_azifa072 cites). Deleting the axis and restoring it one change later
// would have been work authored to be thrown away, and would have put a permanence claim in this
// note that was false before the week ended. No prose 'bind:' scan remains: an unbound doc is an
// orphan, loudly; a hand-authored slug colliding with a registered plan slug is a red (the row
// outlived its migration).

fn plan_doc_graph_roots() -> List<String> {
  map(filter(all_plans, p => plan_projects_committed_markdown(p: p)), p => plan_path(p: p))
}

type DocHome
  = PlanDoc
  | ProbeDoc

type HandAuthoredDocBind {
  home: DocHome,
  slug: String,
  primary_work: DeclarationRef,
  additional_works: List<DeclarationRef>,
  dissolution: PlanRetirement,
}

fn hand_authored_bind_works(b: HandAuthoredDocBind) -> List<DeclarationRef> {
  concat([b.primary_work], b.additional_works)
}

fn declaration_ref_carries_symbol(r: DeclarationRef) -> Bool {
  r.module_path != "" && r.decl_name != ""
}

fn hand_authored_works_refs_all_carry_symbols() -> Bool {
  match hand_authored_doc_binds_population() {
    HandAuthoredDocBindsBuilt { binds: binds } =>
      all(binds, b => all(hand_authored_bind_works(b: b), r => declaration_ref_carries_symbol(r: r)))
    HandAuthoredDocBindsDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

fn hand_authored_doc_declaration_refs() -> List<DeclarationRef> {
  list_flat_map(xs: hand_authored_doc_binds(), f: fn(b) { hand_authored_bind_works(b: b) })
}

// TWO DOCUMENTS BIND TO THE WITNESS THAT IS THEIR EVIDENCE, AND NO RESOLVER CAN REACH IT. IT WAS
// FOUR UNTIL 2026-08-25, AND THE OTHER TWO WERE DELETED BY THE POPULATION THEY EXEMPTED GOING AWAY:
// both named the claude paired-entitlement probe's witnesses, and the only bind carrying those
// references was the ProbeDoc row for a document the measurement bankruptcy deleted. An exemption
// whose subject no longer exists is not harmless bookkeeping -- this roster is a literal list
// beside the bind population rather than a projection of it, so an orphaned row breaks the
// partition identity that proves no authored work falls out of every bucket, and the fast witness
// cited_symbol_production_population_loses_nothing went RED by exactly two when the bind was
// deleted without them. That red is the mechanism working: the roster and the binds are two
// representations of one population, and the substrate refused to let them drift apart silently.
// v2.std.decl_index decl_facts does not index declarations in test .dag files — deliberately, and
// gunbc.ci_layer_roots records that exclusion in the row explaining why a second walk must not
// repeat it — so a reference into a witness module refuses as DeclarationRefDeclarationAbsent no
// matter how correct it is. These two references are correct: the declarations exist, and the
// citation is the honest one to make, because the witness IS what the document binds to.
//
// MEASURED, WITH A POSITIVE CONTROL, so this is a cause and not an assumption (2026-08-21,
// BuildBuddy). Both files report indexed_in_decl_facts=false and module_declared=true, while
// src/v2/lens/cited_symbol_resolution.dag and dag/gunbc/doc_graph_roots.dag — the controls — report
// true and true. The src/v2 root is therefore walked; the exclusion is on the TEST file, not the
// root, which is why the src/v2/test row belongs to the same class as the three under
// dag/test/claim rather than to a second one.
//
// WHAT THIS IS NOT: an exemption list. The rows carry std.decl_ref CitationIndexCoverage — one
// axis, the same one gunbc.lambda_argument_typing_gate and gunbc.list_membership_operation_gap
// carry, not a second shape — and the population is COUNTED rather than silently subtracted. The
// dodge this admits in principle, marking a resolvable reference outside-index to escape a red, is
// refused by execution rather than by review: v2.lens.cited_symbol_resolution's report REFUSES a
// row marked outside-index that actually resolves, and refuses a count disagreement, and that
// report REFUSES BY EXECUTION rather than by review whenever it is run. WHAT IT IS NOT RUN BY,
// corrected 2026-08-25: nothing on a push. This sentence read "runs on every CI run as
// claim_executor --required-cited-symbol, its own required check in the cited-symbol job of
// .github/workflows/witnesses.yml", and that was true when written and false from 2026-08-23, when
// the operator directive deleted the cited-symbol job. The flag was DELETED with the Rust census
// behind it, so this lens's report cannot be run at all, and a marking that lies no longer fails
// the run that made it because no run is made. THAT IS NOT THE CURRENT STATE OF THE RULE, and
// reading it as one is the error this row keeps correcting in itself: as of 2026-08-25
// v1_compiler.declaration_index resolves every authored DeclarationRef at INGESTION, inside the
// parse phase of --required-ci, so DESIGN RETIRES the drop and the rung is mechanically preventable
// again. It bears directly on THESE rows rather than merely nearby: the new index INDEXES TEST
// MODULES, which is exactly the exclusion that forced the outside-index disposition, so the class
// these rows exist to carry is dissolving at its cause rather than being marked around. The rows
// stay only until that cut lands.
//
// DISSOLVE-ON: decl_facts covers test modules, or a witness-declaration index becomes reachable
// from the resolver — at which point these rows delete and both references join the ordinary
// citable population.

type OutsideIndexWork {
  reference: DeclarationRef,
  coverage: CitationIndexCoverage,
}

data hand_authored_outside_index_works: List<OutsideIndexWork> = [
  OutsideIndexWork {
    reference: DeclarationRef { module_path: "test.claim.floor_materialization_witness", decl_name: "floor_materialization_witness_note", field: WholeDeclaration },
    coverage: OutsideDeclIndexTestWitnessModule,
  },
  OutsideIndexWork {
    reference: DeclarationRef { module_path: "v2.test.round_trip.dag_comment_wall_test", decl_name: "dag_comment_wall_line_comment_refused", field: WholeDeclaration },
    coverage: OutsideDeclIndexTestWitnessModule,
  },
]

fn hand_authored_outside_index_declaration_refs() -> List<DeclarationRef> {
  map(
    filter(hand_authored_outside_index_works, w => citation_is_outside_index(coverage: w.coverage)),
    w => w.reference
  )
}

fn hand_authored_outside_index_count() -> Int {
  length(xs: hand_authored_outside_index_declaration_refs())
}

fn declaration_ref_is_outside_index(r: DeclarationRef) -> Bool {
  any(
    hand_authored_outside_index_declaration_refs(),
    o => o.module_path == r.module_path && o.decl_name == r.decl_name
  )
}

fn hand_authored_production_doc_declaration_refs() -> List<DeclarationRef> {
  filter(hand_authored_doc_declaration_refs(), r => !declaration_ref_is_outside_index(r: r))
}

fn hand_authored_works_resolution_pool_roots() -> List<String> {
  compile_clean_source_roots()
}

fn hand_authored_works_refs_all_resolve() -> Bool {
  match hand_authored_doc_binds_population() {
    HandAuthoredDocBindsDuplicateKey { key: _, first: _, duplicate: _ } => false
    HandAuthoredDocBindsBuilt { binds: _ } => {
      let pool = hand_authored_works_resolution_pool_roots()
      all(
        hand_authored_production_doc_declaration_refs(),
        r => declaration_ref_resolves_live(ref: r, pool_roots: pool)
      )
    }
  }
}

fn hand_authored_bind_key(b: HandAuthoredDocBind) -> String {
  match b.home {
    PlanDoc => concat("plan/", b.slug)
    ProbeDoc => concat("probe/", b.slug)
  }
}

fn hand_authored_doc_path(b: HandAuthoredDocBind) -> String {
  match b.home {
    PlanDoc => plan_doc_path(slug: b.slug)
    ProbeDoc => concat("docs/probes/", concat(b.slug, ".md"))
  }
}

// THE THREE BODY-LOWERING SYSTEM REFERENCES LIVE HERE, ONCE, BECAUSE TWO DOCUMENTS NAME THEM. The
// generated design document names them in its body-lowering paragraph and the hand-authored
// general-body-producer plan names them in its discharged-prerequisite paragraph, so authoring one
// DeclarationRef literal in each place would be the dual representation this program exists to
// remove -- and the copies would then rot independently, which is precisely the failure that
// produced the bind below. The home is this module rather than gunbc.documentary_refs because the
// union projection imports in that direction; reversing it would be a cycle.

data body_lowering_symbol_index_ref: DeclarationRef = DeclarationRef { module_path: "v2.std.symbol_index", decl_name: "SymbolIndex", field: WholeDeclaration }

data body_lowering_lexical_lookup_ref: DeclarationRef = DeclarationRef { module_path: "v2.std.symbol_index", decl_name: "symbol_index_lexical_lookup", field: WholeDeclaration }

data body_lowering_production_consumer_ref: DeclarationRef = DeclarationRef { module_path: "v2.compiler.resolve", decl_name: "lookup_symbol_index_atom_identity", field: WholeDeclaration }

