type HandAuthoredDocBindsPopulation
  = HandAuthoredDocBindsBuilt { binds: List<HandAuthoredDocBind> }
  | HandAuthoredDocBindsDuplicateKey {
      key: String,
      first: HandAuthoredDocBind,
      duplicate: HandAuthoredDocBind,
    }

fn hand_authored_bind_key_eq(a: String, b: String) -> Bool {
  a == b
}

fn hand_authored_binds_to_keyed_rows(binds: List<HandAuthoredDocBind>) -> List<KeyedRow<String, HandAuthoredDocBind>> {
  map(binds, b => KeyedRow { row_key: hand_authored_bind_key(b: b), value: b })
}

fn hand_authored_doc_binds_keyed_build(incomings: List<HandAuthoredDocBind>) -> KeyedRosterBuild<String, HandAuthoredDocBind> {
  keyed_roster_build(
    incomings: hand_authored_binds_to_keyed_rows(binds: incomings),
    key_eq: hand_authored_bind_key_eq,
  )
}

fn hand_authored_doc_binds_construct() -> KeyedRosterBuild<String, HandAuthoredDocBind> {
  hand_authored_doc_binds_keyed_build(incomings: hand_authored_doc_bind_incomings)
}

fn hand_authored_doc_binds_population() -> HandAuthoredDocBindsPopulation {
  match hand_authored_doc_binds_construct() {
    KeyedRosterBuilt { rows: rows } =>
      HandAuthoredDocBindsBuilt { binds: map(rows, row => row.value) }
    KeyedRosterBuildDuplicateKey { key: k, first: f, duplicate: d } =>
      HandAuthoredDocBindsDuplicateKey {
        key: k,
        first: f.value,
        duplicate: d.value,
      }
  }
}

fn hand_authored_doc_binds() -> List<HandAuthoredDocBind> {
  match hand_authored_doc_binds_population() {
    HandAuthoredDocBindsBuilt { binds: binds } => binds
    HandAuthoredDocBindsDuplicateKey { key: _, first: _, duplicate: _ } => []
  }
}

fn hand_authored_bind_identities_unique() -> Bool {
  match hand_authored_doc_binds_population() {
    HandAuthoredDocBindsBuilt { binds: _ } => true
    HandAuthoredDocBindsDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

fn hand_authored_doc_graph_roots() -> List<String> {
  map(hand_authored_doc_binds(), b => hand_authored_doc_path(b: b))
}

fn doc_graph_roots_all() -> List<String> {
  concat(plan_doc_graph_roots(), hand_authored_doc_graph_roots())
}

fn doc_graph_floor_orphan_clean_holds() -> Bool {
  doc_graph_orphan_clean_holds(plan_roots: doc_graph_roots_all())
}

fn doc_graph_floor_clean_holds() -> Bool {
  doc_graph_clean_holds(plan_roots: doc_graph_roots_all())
}

fn hand_authored_plan_slug_is_unregistered(b: HandAuthoredDocBind) -> Bool {
  match b.home {
    PlanDoc => all(all_plans, p => p.slug != b.slug)
    ProbeDoc => true
  }
}

fn hand_authored_slugs_all_unregistered() -> Bool {
  match hand_authored_doc_binds_population() {
    HandAuthoredDocBindsBuilt { binds: binds } =>
      all(binds, b => hand_authored_plan_slug_is_unregistered(b: b))
    HandAuthoredDocBindsDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}
