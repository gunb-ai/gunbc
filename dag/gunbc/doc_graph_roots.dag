    work: DeclarationRef { module_path: "tools.self_host_curated_probe_cargo", decl_name: "curated_probe_cargo_toml_from_cssl_authority", field: WholeDeclaration },
    dissolution: HasTrigger { text: "modeled probe transport lands (bash-emit #5828)" },
