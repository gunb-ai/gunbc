fn hand_authored_doc_graph_roots() -> List<String> {
  map(hand_authored_doc_binds, b => b.doc_path)
}

fn doc_graph_roots_all() -> List<String> {
  concat(plan_doc_graph_roots(), hand_authored_doc_graph_roots())
}
