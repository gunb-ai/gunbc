module gunbc.provider_standing_probe_bridge


data provider_standing_probe_bridge_authority_note: String = "OBSERVATION BRIDGE (deep-raven-684 msg_a203fe4d): factors dashboard Codex probes into a six-axis ProviderStandingBundle without inferring limit capacity or entitlement availability from authentication. Login-status and version probes ground installation and authentication only. Entitlement and account-limit axes stay honestly unobserved at this boundary unless a dedicated observation path supplies them. DISSOLVES ON: the first RecordedFact<ProviderStandingObservationFact> standing-observation path supersedes probe-derived inventory standing (nimble-owl-833)."

data provider_standing_probe_bridge_entitlement_note: String = "EntitlementObservationUnobserved at the login-status bridge is not a positive availability claim and does not derive from authentication success. Selection eligibility for entitlement unobserved is unchanged: the axis must be observed available or selection refuses."

data provider_standing_probe_bridge_limit_note: String = "LimitObservationUnobserved at the login-status bridge is silence on account capacity, not a healthy balance. It blocks automatic dispatch so an exhausted account cannot read as available merely because login-status succeeded."

data provider_standing_probe_bridge_claude_control_note: String = "Claude credential control probes ground authentication from token state, never from subscription profile metadata alone. tokenSource=none with profile metadata present maps to AuthenticationProfilePresentTokenAbsent, not AuthenticationAuthenticated. Installation and tool environment are not observed at this bridge — only authentication is derived from the credential-control input."

data provider_standing_probe_bridge_claude_installation_unobserved_reason: std.types.NonEmptyStr = "installation not observed at credential-control bridge" as std.types.NonEmptyStr

data provider_standing_probe_bridge_claude_tool_environment_unobserved_reason: std.types.NonEmptyStr = "tool environment not observed at credential-control bridge" as std.types.NonEmptyStr

type ProviderDashboardExecProbe
  = ProviderDashboardExecProbeRefused { detail: std.types.NonEmptyStr }
  | ProviderDashboardExecProbeReported {
      succeeded: Bool,
      stdout: String,
      stderr: String,
    }

type CodexProviderStateRootProbe
  = CodexStateRootProbeRefused { reason: std.types.NonEmptyStr }
  | CodexStateRootAbsent
  | CodexStateRootPresent

type CodexProviderDashboardProbeObservation {
  state_root: CodexProviderStateRootProbe,
  runtime: ProviderDashboardExecProbe,
  auth: ProviderDashboardExecProbe,
}

type ClaudeCredentialControlProbeObservation {
  token_source: std.types.NonEmptyStr,
  subscription_tier: std.types.NonEmptyStr,
}

data provider_dashboard_exec_probe_transport_refused_reason: std.types.NonEmptyStr = "dashboard provider exec probe transport refused" as std.types.NonEmptyStr

data provider_standing_probe_bridge_entitlement_unobserved_reason: std.types.NonEmptyStr = "entitlement surface not read at login-status bridge" as std.types.NonEmptyStr

data provider_standing_probe_bridge_limit_unobserved_reason: std.types.NonEmptyStr = "account limit surface not read at login-status bridge" as std.types.NonEmptyStr

data provider_standing_probe_bridge_installation_unobserved_reason: std.types.NonEmptyStr = "installation could not be observed before auth probe" as std.types.NonEmptyStr

data provider_standing_probe_bridge_state_root_absent_installation_reason: std.types.NonEmptyStr = "provider state root absent; executable not probed at this bridge" as std.types.NonEmptyStr

data provider_standing_probe_bridge_tool_environment_unobserved_reason: std.types.NonEmptyStr = "tool environment could not be observed before auth probe" as std.types.NonEmptyStr

fn provider_dashboard_exec_probe_refused(
  detail: std.types.NonEmptyStr,
) -> ProviderDashboardExecProbe {
  ProviderDashboardExecProbeRefused { detail: detail }
}

fn provider_dashboard_exec_probe_reported(
  succeeded: Bool,
  stdout: String,
  stderr: String,
) -> ProviderDashboardExecProbe {
  ProviderDashboardExecProbeReported {
    succeeded: succeeded,
    stdout: stdout,
    stderr: stderr,
  }
}

fn provider_dashboard_exec_probe_transport_refused() -> ProviderDashboardExecProbe {
  provider_dashboard_exec_probe_refused(
    detail: provider_dashboard_exec_probe_transport_refused_reason,
  )
}

fn provider_dashboard_exec_probe_is_transport_refused(
  probe: ProviderDashboardExecProbe,
) -> Bool {
  match probe {
    ProviderDashboardExecProbeRefused { detail: _ } => true
    ProviderDashboardExecProbeReported { succeeded: _, stdout: _, stderr: _ } => false
  }
}

fn provider_standing_bundle_unobserved_installation(
  reason: std.types.NonEmptyStr,
) -> gunbc.provider_standing.ProviderInstallationStanding {
  gunbc.provider_standing.InstallationStandingUnobserved { reason: reason }
}

fn provider_standing_bundle_unobserved_authentication(
  reason: std.types.NonEmptyStr,
) -> gunbc.provider_standing.ProviderAuthenticationStanding {
  gunbc.provider_standing.AuthenticationStandingUnobserved { reason: reason }
}

fn provider_standing_bundle_unobserved_tool_environment(
  reason: std.types.NonEmptyStr,
) -> gunbc.provider_standing.ProviderToolEnvironmentStanding {
  gunbc.provider_standing.ToolEnvironmentStandingUnobserved { reason: reason }
}

fn provider_standing_bundle_honest_limit_unobserved() -> List<gunbc.provider_standing.ProviderLimitObservation> {
  [
    gunbc.provider_standing.LimitObservationUnobserved {
      reason: provider_standing_probe_bridge_limit_unobserved_reason,
    },
  ]
}

fn provider_standing_bundle_honest_entitlement_unobserved() -> gunbc.provider_standing.ProviderEntitlementObservation {
  gunbc.provider_standing.EntitlementObservationUnobserved {
    reason: provider_standing_probe_bridge_entitlement_unobserved_reason,
  }
}

data codex_entitlement_realm_policy_note: String = "ENTITLEMENT IS POLICY OVER AN OBSERVATION, AND THE TWO LIVE IN DIFFERENT MODULES. gunbc.codex_app_server_press decodes what upstream reported — which account union arm, which plan — and asserts nothing about whether it may serve work. This function is the gunbc half: given that observation, may a dispatch requiring personal ChatGPT OAuth draw on this credential?\n\nTHE THREE ANSWERS ARE NOT TWO. An apiKey or amazonBedrock account is REJECTED, not unobserved: the account was read successfully and it is a different credential realization, so the profile is answered in the negative rather than left open. A plan this pin does not recognize is UNOBSERVED, not rejected: upstream added a plan and our roster is stale, which is a fact about us. Collapsing either direction would be wrong in a way the other cannot fix — a stale roster that rejects would refuse a legitimately entitled account forever, and an unrecognized realm that reads as unobserved would let a Bedrock contract look like a temporarily unread subscription.\n\nCodexPlanUnknown IS DELIBERATELY OFF THE ROSTER. It is a real member of the cited enum, so it decodes cleanly, and it means upstream itself does not assert the plan. Admitting it would convert their uncertainty into our positive claim."

data codex_entitling_plan_roster_note: String = "NARROWED TO THE OBSERVED DEPLOYMENT (analyst P0, 2026-08-12). This roster first admitted every plan except free and unknown — go, plus, pro, team, edu and all business/enterprise variants — from a note that simultaneously admitted no upstream plan-to-entitlement mapping exists. That is a broad ALLOW decision derived from a locally authored assumption, which is the exact class that escapes review: a refusal gets scrutinized, an admission that merely widens looks like nothing happening.\n\nThe admitted set is now the one plan actually observed on the deployed credential. Everything else decodes correctly and is simply not admitted yet.\n\nA non-admitted plan reads UNOBSERVED rather than REJECTED, and the line is the same one the rest of this module draws: the remedy decides the arm. A plan outside the deployment policy is repaired by ratifying it here — our side, like a stale pin — so the honest state is that we have not decided. An apiKey or amazonBedrock account stays REJECTED because no edit to this roster makes it a personal ChatGPT subscription; that one is repaired only by changing the credential."

type CodexPersonalSubscriptionPolicy {
  admitted_plans: List<extdeps.llm.codex_app_server.CodexPlanType>
}

data codex_first_deployment_subscription_policy: CodexPersonalSubscriptionPolicy = CodexPersonalSubscriptionPolicy {
  admitted_plans: [extdeps.llm.codex_app_server.CodexPlanPro],
}

fn codex_plan_eq(a: extdeps.llm.codex_app_server.CodexPlanType, b: extdeps.llm.codex_app_server.CodexPlanType) -> Bool {
  extdeps.llm.codex_app_server.codex_plan_type_wire_name(p: a) == extdeps.llm.codex_app_server.codex_plan_type_wire_name(p: b)
}

fn codex_policy_admits_plan(policy: CodexPersonalSubscriptionPolicy, plan: extdeps.llm.codex_app_server.CodexPlanType) -> Bool {
  any(policy.admitted_plans, p => codex_plan_eq(a: p, b: plan))
}

fn codex_plan_is_entitling(plan: extdeps.llm.codex_app_server.CodexPlanType) -> Bool {
  codex_policy_admits_plan(
    policy: codex_first_deployment_subscription_policy,
    plan: plan,
  )
}

fn provider_entitlement_from_codex_plan_reading(
  reading: gunbc.codex_app_server_press.CodexPlanTypeReading,
) -> gunbc.provider_standing.ProviderEntitlementObservation {
  match reading {
    gunbc.codex_app_server_press.CodexPlanTypeObserved { plan: p } =>
      if codex_plan_is_entitling(plan: p) {
        gunbc.provider_standing.EntitlementObservedAvailable
      } else {
        gunbc.provider_standing.EntitlementObservationUnobserved {
          reason: join([
            "codex chatgpt plan ",
            extdeps.llm.codex_app_server.codex_plan_type_wire_name(p: p) as String,
            " is not yet admitted by the deployed profile",
          ], "") as std.types.NonEmptyStr,
        }
      }
    gunbc.codex_app_server_press.CodexPlanTypeUnrecognized { native: n } =>
      gunbc.provider_standing.EntitlementObservationUnobserved {
        reason: join([
          "codex chatgpt planType ",
          n as String,
          " is outside the cited 0.146.0 PlanType enum; this pin is stale",
        ], "") as std.types.NonEmptyStr,
      }
    gunbc.codex_app_server_press.CodexPlanTypeMalformed { cause: c } =>
      gunbc.provider_standing.EntitlementObservationUnobserved { reason: c }
  }
}

fn provider_entitlement_from_codex_realm(
  realm: gunbc.codex_app_server_press.CodexAccountRealm,
) -> gunbc.provider_standing.ProviderEntitlementObservation {
  match realm {
    gunbc.codex_app_server_press.CodexChatgptRealm { plan: reading } =>
      provider_entitlement_from_codex_plan_reading(reading: reading)
    gunbc.codex_app_server_press.CodexApiKeyRealm =>
      gunbc.provider_standing.EntitlementRejected {
        reason: "codex account is an apiKey platform credential, not the personal ChatGPT subscription this profile requires" as std.types.NonEmptyStr,
      }
    gunbc.codex_app_server_press.CodexAmazonBedrockRealm =>
      gunbc.provider_standing.EntitlementRejected {
        reason: "codex account is an amazonBedrock contract credential, not the personal ChatGPT subscription this profile requires" as std.types.NonEmptyStr,
      }
    gunbc.codex_app_server_press.CodexAccountRealmAbsent =>
      gunbc.provider_standing.EntitlementObservationUnobserved {
        reason: "codex account/read reported no account; entitlement is unread until the credential authenticates" as std.types.NonEmptyStr,
      }
    gunbc.codex_app_server_press.CodexAccountRealmUnrecognizedType { native: n } =>
      gunbc.provider_standing.EntitlementObservationUnobserved {
        reason: join([
          "codex account type ",
          n as String,
          " is outside the cited 0.146.0 Account union; this pin is stale",
        ], "") as std.types.NonEmptyStr,
      }
    gunbc.codex_app_server_press.CodexAccountRealmUnobserved { reason: r } =>
      gunbc.provider_standing.EntitlementObservationUnobserved { reason: r }
  }
}

fn provider_entitlement_from_codex_press_receipt(
  receipt: gunbc.codex_app_server_press.CodexAccountStandingReceipt,
) -> gunbc.provider_standing.ProviderEntitlementObservation {
  provider_entitlement_from_codex_realm(
    realm: receipt.standing.evidence.account_realm,
  )
}

data codex_credential_liveness_bridge_note: String = "LIVENESS IS NOT REALM (continuity receipt 2026-08-13). account/read can report chatgpt/pro while account/rateLimits/read returns no buckets — the dead-credential trap. AuthenticationAuthenticated derives from CodexCredentialLive (buckets returned, token exercised upstream), never from account_realm or account_read disposition alone. Realm stays on the entitlement bridge; this bridge owns the authentication axis only."

fn provider_authentication_from_codex_credential_liveness(
  liveness: gunbc.codex_app_server_press.CodexCredentialLiveness,
) -> gunbc.provider_standing.ProviderAuthenticationStanding {
  match liveness {
    gunbc.codex_app_server_press.CodexCredentialLive { bucket_count: _ } => gunbc.provider_standing.AuthenticationAuthenticated
    gunbc.codex_app_server_press.CodexCredentialDead { reason: r } =>
      gunbc.provider_standing.AuthenticationRefreshFailed { reason: r }
    gunbc.codex_app_server_press.CodexCredentialLivenessUnobserved { reason: r } =>
      gunbc.provider_standing.AuthenticationStandingUnobserved { reason: r }
  }
}

fn provider_authentication_from_codex_press_receipt(
  receipt: gunbc.codex_app_server_press.CodexAccountStandingReceipt,
) -> gunbc.provider_standing.ProviderAuthenticationStanding {
  provider_authentication_from_codex_credential_liveness(
    liveness: receipt.standing.evidence.credential_liveness,
  )
}

data codex_press_standing_bundle_installation_unobserved_reason: std.types.NonEmptyStr = "installation not derived at codex press receipt bridge; runtime materialization is separate" as std.types.NonEmptyStr

data codex_press_standing_bundle_tool_environment_unobserved_reason: std.types.NonEmptyStr = "tool environment not derived at codex press receipt bridge" as std.types.NonEmptyStr

fn provider_standing_bundle_from_codex_press_receipt(
  receipt: gunbc.codex_app_server_press.CodexAccountStandingReceipt,
) -> gunbc.provider_standing.ProviderStandingBundle {
  gunbc.provider_standing.ProviderStandingBundle {
    installation: provider_standing_bundle_unobserved_installation(
      reason: codex_press_standing_bundle_installation_unobserved_reason,
    ),
    authentication: provider_authentication_from_codex_press_receipt(receipt: receipt),
    entitlement: provider_entitlement_from_codex_press_receipt(receipt: receipt),
    limits: provider_limit_observations_from_codex_press_receipt(receipt: receipt),
    turn: gunbc.provider_standing.TurnNotStarted,
    tool_environment: provider_standing_bundle_unobserved_tool_environment(
      reason: codex_press_standing_bundle_tool_environment_unobserved_reason,
    ),
  }
}

fn provider_standing_bundle_from_codex_dashboard_probes(
  observation: CodexProviderDashboardProbeObservation,
) -> gunbc.provider_standing.ProviderStandingBundle {
  match observation.state_root {
    CodexStateRootProbeRefused { reason } =>
      gunbc.provider_standing.ProviderStandingBundle {
        installation: provider_standing_bundle_unobserved_installation(reason: reason),
        authentication: provider_standing_bundle_unobserved_authentication(reason: reason),
        entitlement: provider_standing_bundle_honest_entitlement_unobserved(),
        limits: provider_standing_bundle_honest_limit_unobserved(),
        turn: gunbc.provider_standing.TurnNotStarted,
        tool_environment: provider_standing_bundle_unobserved_tool_environment(
          reason: provider_standing_probe_bridge_tool_environment_unobserved_reason,
        ),
      }
    CodexStateRootAbsent =>
      gunbc.provider_standing.ProviderStandingBundle {
        installation: provider_standing_bundle_unobserved_installation(
          reason: provider_standing_probe_bridge_state_root_absent_installation_reason,
        ),
        authentication: gunbc.provider_standing.AuthenticationCredentialsAbsent,
        entitlement: provider_standing_bundle_honest_entitlement_unobserved(),
        limits: provider_standing_bundle_honest_limit_unobserved(),
        turn: gunbc.provider_standing.TurnNotStarted,
        tool_environment: gunbc.provider_standing.ToolEnvironmentUnavailable {
          reason: "provider state root absent" as std.types.NonEmptyStr,
        },
      }
    CodexStateRootPresent => {
      let installation = match observation.runtime {
        ProviderDashboardExecProbeRefused { detail } =>
          provider_standing_bundle_unobserved_installation(reason: detail)
        ProviderDashboardExecProbeReported { succeeded, stdout: _, stderr: _ } =>
          if succeeded {
            gunbc.provider_standing.InstallationReady
          } else {
            gunbc.provider_standing.InstallationExecutableMissing
          }
      }
      let tool_environment = match observation.runtime {
        ProviderDashboardExecProbeRefused { detail } =>
          provider_standing_bundle_unobserved_tool_environment(reason: detail)
        ProviderDashboardExecProbeReported { succeeded, stdout: _, stderr: _ } =>
          if succeeded {
            gunbc.provider_standing.ToolEnvironmentReady
          } else {
            gunbc.provider_standing.ToolEnvironmentUnavailable {
              reason: "provider runtime probe failed" as std.types.NonEmptyStr,
            }
          }
      }
      let authentication = match observation.auth {
        ProviderDashboardExecProbeRefused { detail } =>
          provider_standing_bundle_unobserved_authentication(reason: detail)
        ProviderDashboardExecProbeReported { succeeded, stdout: _, stderr: _ } =>
          if succeeded {
            gunbc.provider_standing.AuthenticationAuthenticated
          } else {
            gunbc.provider_standing.AuthenticationCredentialsAbsent
          }
      }
      gunbc.provider_standing.ProviderStandingBundle {
        installation: installation,
        authentication: authentication,
        entitlement: provider_standing_bundle_honest_entitlement_unobserved(),
        limits: provider_standing_bundle_honest_limit_unobserved(),
        turn: gunbc.provider_standing.TurnNotStarted,
        tool_environment: tool_environment,
      }
    }
  }
}

fn provider_standing_bundle_from_claude_credential_control_probe(
  observation: ClaudeCredentialControlProbeObservation,
) -> gunbc.provider_standing.ProviderStandingBundle {
  let authentication = if observation.token_source == ("none" as std.types.NonEmptyStr) {
      if observation.subscription_tier == ("none" as std.types.NonEmptyStr) {
        gunbc.provider_standing.AuthenticationCredentialsAbsent
      } else {
        gunbc.provider_standing.AuthenticationProfilePresentTokenAbsent {
          subscription_tier: observation.subscription_tier,
          token_source: observation.token_source,
        }
      }
    } else {
      gunbc.provider_standing.AuthenticationAuthenticated
    }
  gunbc.provider_standing.ProviderStandingBundle {
    installation: provider_standing_bundle_unobserved_installation(
      reason: provider_standing_probe_bridge_claude_installation_unobserved_reason,
    ),
    authentication: authentication,
    entitlement: provider_standing_bundle_honest_entitlement_unobserved(),
    limits: provider_standing_bundle_honest_limit_unobserved(),
    turn: gunbc.provider_standing.TurnNotStarted,
    tool_environment: provider_standing_bundle_unobserved_tool_environment(
      reason: provider_standing_probe_bridge_claude_tool_environment_unobserved_reason,
    ),
  }
}

data codex_press_limit_bridge_note: String = "THE CONSUMER THE PRESS RECEIPT NAMED. gunbc.codex_app_server_press account_standing_authenticated_rate_limits_readable_note specifies this bridge and carries its dissolution: read evidence.rate_limit_buckets per limit_id, project each CodexRateLimitBucketVerdict to ProviderNativeLimitBucket, and NEVER route through ProviderAccountLimit or through CodexPressAccountReady as the limit axis.\n\nWHY THE SUBJECT MUST BE THE BUCKET. The account-standing classification gates on codex_default_rate_limit_id alone, so it reports Ready while a sibling bucket is exhausted and reports the account blocked while a sibling has capacity. Promoting either reading to account scope erases bucket identity and refuses — or admits — work for the wrong reason. One bucket is one subject; the draw decides which subject a dispatch actually consults.\n\nCAPACITY-UNKNOWN IS NOT CAPACITY, AND IT IS NOT UNIVERSAL EITHER. CodexBucketCapacityUnknown carries a limit_id whose window did not decode, so it becomes LimitSubjectUnobserved ON THAT BUCKET and never LimitObservedAvailable. It first mapped to the subject-less LimitObservationUnobserved, which blocks every draw — so one bucket failing to decode refused a draw naming a measured, available sibling, discarding a limit_id the producer already held (review 51237) — the empty-observation narrow is the failure mode here, not the widen: reading could-not-decode as nothing-is-wrong would admit a dispatch against a bucket nobody measured.\n\nAN EMPTY BUCKET LIST IS ALSO NOT CAPACITY. limit_observations_are_selection_eligible already refuses an empty list, so this projection does not change that verdict; what it adds is a located reason, so the refusal says which observation was missing instead of arriving as a bare false."

fn provider_limit_observation_from_codex_bucket(
  credential: gunbc.provider_standing.ProviderLimitCredentialIdentity,
  verdict: gunbc.codex_app_server_press.CodexRateLimitBucketVerdict,
) -> gunbc.provider_standing.ProviderLimitObservation {
  match verdict {
    gunbc.codex_app_server_press.CodexBucketCapacityAvailable { limit_id: id } =>
      gunbc.provider_standing.LimitObservedAvailable {
        subject: gunbc.provider_standing.ProviderNativeLimitBucket { credential: credential, native_key: id },
      }
    gunbc.codex_app_server_press.CodexBucketUnavailableUntilReset { limit_id: id, reached_type: rt, resets_at: ra } =>
      gunbc.provider_standing.LimitUnavailableUntilReset {
        subject: gunbc.provider_standing.ProviderNativeLimitBucket { credential: credential, native_key: id },
        cause: match rt {
          Present { value: t } => gunbc.provider_standing.NativeCauseReported { token: t }
          Absent => gunbc.provider_standing.NativeCauseUnreported
        },
        reset: match ra {
          Present { value: at } => gunbc.provider_standing.LimitResetAt { at: at }
          Absent => gunbc.provider_standing.LimitResetInstantUnobserved
        },
        reason: codex_press_bucket_unavailable_reason,
      }
    gunbc.codex_app_server_press.CodexBucketCapacityUnknown { limit_id: id } =>
      gunbc.provider_standing.LimitSubjectUnobserved {
        subject: gunbc.provider_standing.ProviderNativeLimitBucket { credential: credential, native_key: id },
        native_token: id,
        reason: codex_press_bucket_capacity_unknown_reason,
      }
  }
}

data codex_press_native_cause_token_note: String = "DISSOLVED AS DECLARED. This note previously said limit_id remained the cause fallback because native_token was not optional, and that resets_at was dropped because LimitUnavailableUntilReset had nowhere to put it — with the dissolve-on named as *that arm gains a typed reset instant*. It has one now, so both discards are gone: the cause is ProviderNativeLimitCause and answers NativeCauseUnreported when the wire omits rateLimitReachedType, and the reset is ProviderLimitReset carrying the decoded resetsAt.\n\nKept rather than deleted because the shape of the error is worth more than the fix: a required field whose producer lacks a value is what MANUFACTURES a fallback. The substitution was not chosen, it was the only expression that typechecked. Where an observation may not be there, the carrier has to say so, or the projection will invent something plausible in the slot."

data codex_press_bucket_unavailable_reason: std.types.NonEmptyStr = "codex app-server rate-limit bucket reported exhausted until reset" as std.types.NonEmptyStr
data codex_press_bucket_capacity_unknown_reason: std.types.NonEmptyStr = "codex app-server rate-limit bucket window did not decode; capacity unmeasured" as std.types.NonEmptyStr
data codex_press_no_buckets_reason: std.types.NonEmptyStr = "codex app-server rate-limit response carried no decodable bucket; no limit was observed" as std.types.NonEmptyStr

fn provider_limit_observations_from_codex_buckets(
  credential: gunbc.provider_standing.ProviderLimitCredentialIdentity,
  buckets: List<gunbc.codex_app_server_press.CodexRateLimitBucketVerdict>,
) -> List<gunbc.provider_standing.ProviderLimitObservation> {
  if list_length(items: buckets) == 0 {
    [gunbc.provider_standing.LimitObservationUnobserved { reason: codex_press_no_buckets_reason }]
  } else {
    map(buckets, b =>
      provider_limit_observation_from_codex_bucket(credential: credential, verdict: b))
  }
}

data codex_press_credential_binding_note: String = "THE CREDENTIAL COMES FROM THE RECEIPT, NOT FROM THE CALLER (review artifact 51237 handback item 1). provider_limit_observations_from_codex_press_evidence takes the credential identity and the evidence as INDEPENDENT arguments, so nothing stops a caller taking buckets observed under one CODEX_HOME and publishing them as the standing of a different credential. The standing would be honestly decoded and attached to the wrong account — a forgery no arm refuses, because both arguments are individually valid.\n\nThe receipt already carries the answer: CodexAccountPreflightSubject.credential is the exact ambient context the trip ran under. So the receipt-taking entry point DERIVES the identity from that subject and gives the caller no place to supply one. The evidence-taking form remains for callers that genuinely hold only evidence, but it is no longer the way a receipt reaches the standing.\n\nCODEX_HOME is the identity because it IS the isolation mechanism (extdeps.llm.codex_auth codex_state_root_isolation_note): two homes are two credential stores, and one home is one account's tokens.\\n\\nTHE FIRST FIX WAS INCOMPLETE AND THAT IS THE POINT OF THIS PARAGRAPH. Adding the receipt-taking entry point did not remove the forgery — provider_limit_observations_from_codex_press_evidence still took a credential and an evidence record as independent arguments, so the exact construction the correction was meant to eliminate stayed reachable beside the corrected one. A safe path added next to an unsafe path leaves the unsafe path. It is deleted; the only production entry consumes the complete receipt, and the bucket-list helper takes an already-bound credential rather than a free one."

fn codex_press_credential_identity(
  credential: gunbc.codex_app_server_press.AmbientCodexCredentialContext,
) -> gunbc.provider_standing.ProviderLimitCredentialIdentity {
  gunbc.provider_standing.LimitCredentialLabel { label: credential.codex_home as std.types.NonEmptyStr }
}

fn provider_limit_observations_from_codex_press_receipt(
  receipt: gunbc.codex_app_server_press.CodexAccountStandingReceipt,
) -> List<gunbc.provider_standing.ProviderLimitObservation> {
  provider_limit_observations_from_codex_buckets(
    credential: codex_press_credential_identity(credential: receipt.subject.credential),
    buckets: receipt.standing.evidence.rate_limit_buckets,
  )
}
