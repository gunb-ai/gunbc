module gunbc.self_host_compile_phase_live_gate

import std.types { Bool, Int, String, NonEmptyStr }
import extdeps.languages.rust.compiler_phases { RustcPhase, rustc_phase_name }
import tools.emission_entry_instrument { RustfmtParseObservation }
import gunbc.self_host_compile_phase_frontier {
  RustcPhaseBoard,
  CompilePhaseInvocation,
  CompilePhaseFrontierReceipt,
  CompilePhaseFrontierStanding,
  CompilePhaseFrontierEmpty,
  CompilePhaseFrontierValidated,
  CompilePhaseFrontierInvalid,
  compile_phase_frontier_standing,
  PersistedPhaseBoardFold,
  phase_board_from_census_identities,
  PhaseRatchetHeld,
  PhaseRatchetRefused,
  phase_ratchet_with_dispositions,
  board_all_identities
}

// WHY THIS MODULE EXISTS, AND WHAT IT DELIBERATELY DOES NOT DO.
//
// `gunbc.self_host_compile_phase_frontier` already carries the ratchet. Its subject is the
// PERSISTED RECEIPT SERIES: it decides whether the recorded observations are linked, coherent and
// non-regressing with respect to one another. Nothing in it re-measures the tree, so between one
// receipt and the next a regression is invisible -- it surfaces only when a human dispatches a run
// and authors the next receipt. This module closes that window by supplying the LIVE tree as the
// current row against the persisted latest.
//
// IT MINTS NO SECOND CENSUS. The live board is folded by the frontier's own
// `phase_board_from_census_identities` over raw identity rows produced by the same
// `rustc_diagnostic_row` serializer the receipts carry, and the comparison is the frontier's own
// `phase_ratchet_with_dispositions`. There is no count literal anywhere in this module and no
// second digest: the persisted receipt is the monotone debt contract, its universe is the closure
// the instrument measured, membership is at identity grain, and this module only joins the live
// population to it. Automating the receipt's update could not collapse anything here into
// `measure() == measure()`, because nothing here compares a measurement to a transcription.
//
// SCOPE, STATED SO IT CANNOT BE READ WIDER THAN IT IS. The subject is ONE ENTRY CLOSURE -- the
// closure the persisted receipts name in their producer row, `src/v2/compiler/00_compile.dag`.
// It is not the corpus, and `gunbc.compiler_frontend_program_status` records why the two are
// different questions: the union of per-entry closures is not the corpus. A verdict from this
// module answers for the compiler's own entry closure and for nothing else.

// The toolchain half of the receipt subject, read from the host rather than authored. The live
// observation is comparable to a receipt only when these agree EXACTLY with what that receipt
// declares; a difference is a different comparison epoch, and the frontier already refuses to
// compare across one without a reclassified predecessor.
type LiveToolchainReading {
  cargo_identity: NonEmptyStr
  rustc_identity: NonEmptyStr
  invocation: CompilePhaseInvocation
}

type LiveComparability
  = LiveComparable
  | LiveIncomparable { reason: NonEmptyStr }

// EQUALITY, FIELD BY FIELD, AND THE ERROR DIRECTION IS THE POINT. The live toolchain strings are
// composed from the toolchain's own self-report; if that composition is wrong by one character the
// answer is Incomparable, which the gate reports as UNMEASURED and exits nonzero on. No spelling
// error in this derivation can produce a green.
fn live_comparability(latest: CompilePhaseFrontierReceipt, live: LiveToolchainReading) -> LiveComparability {
  if latest.subject.cargo_identity != live.cargo_identity {
    LiveIncomparable {
      reason: concat(
        concat("the live cargo identity is not the latest receipt's: live=", live.cargo_identity as String),
        concat(" receipt=", latest.subject.cargo_identity as String)
      ) as NonEmptyStr
    }
  } else if latest.subject.rustc_identity != live.rustc_identity {
    LiveIncomparable {
      reason: concat(
        concat("the live rustc identity is not the latest receipt's: live=", live.rustc_identity as String),
        concat(" receipt=", latest.subject.rustc_identity as String)
      ) as NonEmptyStr
    }
  } else if latest.subject.invocation.target != live.invocation.target {
    LiveIncomparable {
      reason: concat(
        concat("the live host target is not the latest receipt's: live=", live.invocation.target),
        concat(" receipt=", latest.subject.invocation.target)
      ) as NonEmptyStr
    }
  } else if latest.subject.invocation.profile != live.invocation.profile {
    LiveIncomparable {
      reason: concat(
        concat("the live cargo profile is not the latest receipt's: live=", live.invocation.profile),
        concat(" receipt=", latest.subject.invocation.profile)
      ) as NonEmptyStr
    }
  } else if latest.subject.invocation.features != live.invocation.features {
    LiveIncomparable {
      reason: "the live feature selection is not the latest receipt's" as NonEmptyStr
    }
  } else {
    LiveComparable
  }
}

// THREE OUTCOMES, NOT TWO, AND THE THIRD IS WHY THIS IS NOT AN ABSORBING FALLBACK. A gate that
// could only hold or refuse would have to fold "the tree regressed" together with "the measurement
// never happened", and the second would then be indistinguishable from the first for a reader and
// from a pass for a maintainer who saw the run complete. Unmeasured is its own arm, it names its
// cause, and the actuator exits nonzero on it exactly as it does on a refusal: a live gate that
// cannot measure stops the line, it does not widen to a pass.
type LiveFrontierVerdict
  = LiveFrontierHeld { live_identity_count: Int }
  | LiveFrontierRefused { identities: List<String>, reason: NonEmptyStr }
  | LiveFrontierUnmeasured { reason: NonEmptyStr }

// The live observation, in exactly the two populations a receipt carries: rustfmt's refusal list
// and the raw coded/uncoded error identity rows. Everything else about the live board is DERIVED
// from these by the frontier's fold, so a board cannot be authored beside its census.
type LiveCompilePhaseObservation {
  parse_observation: RustfmtParseObservation
  raw_error_diagnostic_identities: List<String>
  toolchain: LiveToolchainReading
}

fn live_phase_board(observation: LiveCompilePhaseObservation) -> PersistedPhaseBoardFold {
  phase_board_from_census_identities(
    parse_observation: observation.parse_observation,
    raw_identities: observation.raw_error_diagnostic_identities
  )
}

// THE DISPOSITION LIST IS EMPTY AND THAT IS THE RATCHET, NOT AN OVERSIGHT. A newly exposed
// identity is admitted by a receipt that names its cause and is checked against the predecessor
// board; a live tree carries no such authored disposition, so any identity the live board holds
// and the latest receipt does not refuses here. The remedy is to append a receipt -- to make the
// exposure a declared, checked fact -- and not to teach this gate to guess a cause.
fn live_tree_frontier_verdict(
  series: List<CompilePhaseFrontierReceipt>,
  observation: LiveCompilePhaseObservation
) -> LiveFrontierVerdict {
  match compile_phase_frontier_standing(series: series) {
    CompilePhaseFrontierInvalid { reason: why } => LiveFrontierRefused {
      identities: [],
      reason: concat(
        "the persisted receipt series does not validate, so the live tree has nothing to be ratcheted against: ",
        why as String
      ) as NonEmptyStr
    }
    CompilePhaseFrontierEmpty => LiveFrontierUnmeasured {
      reason: "the persisted receipt series is empty, so no frontier exists for the live tree to be compared to" as NonEmptyStr
    }
    CompilePhaseFrontierValidated { latest: latest } =>
      match live_comparability(latest: latest, live: observation.toolchain) {
        LiveIncomparable { reason: why } => LiveFrontierUnmeasured {
          reason: concat(
            "the live observation is not in the latest receipt's comparison epoch, so no count between them is meaningful: ",
            why as String
          ) as NonEmptyStr
        }
        LiveComparable => {
          let live = live_phase_board(observation: observation).board
          match phase_ratchet_with_dispositions(previous: latest.board, current: live, dispositions: []) {
            PhaseRatchetHeld => LiveFrontierHeld { live_identity_count: count(board_all_identities(board: live)) }
            PhaseRatchetRefused { phase: p, identities: ids, reason: why } => LiveFrontierRefused {
              identities: ids,
              reason: concat(
                concat(concat("the live tree regressed against receipt ", latest.invocation as String), concat(" at rustc phase ", rustc_phase_name(phase: p))),
                concat(": ", why as String)
              ) as NonEmptyStr
            }
          }
        }
      }
  }
}

fn live_frontier_verdict_text(verdict: LiveFrontierVerdict) -> String {
  match verdict {
    LiveFrontierHeld { live_identity_count: n } =>
      concat("held\tthe live 00_compile closure carries ", concat(to_string(n), " diagnostic identities and gained none against the latest receipt"))
    LiveFrontierRefused { identities: ids, reason: why } =>
      concat(concat("refused\t", why as String), concat("\n", ids |> map(identity => concat("identity\t", identity)) |> join(separator: "\n")))
    LiveFrontierUnmeasured { reason: why } => concat("unmeasured\t", why as String)
  }
}

// ENROLMENT, IN TWO HALVES, BECAUSE STATING ONLY ONE OF THEM WOULD BE THE INERT-LENS LIE IN EITHER
// DIRECTION.
//
// THE GATE'S BEHAVIOUR IS ENFORCED TODAY. The fold above is witnessed by
// `test.claim.self_host_compile_phase_live_gate_witness`, which the required floor already picks up
// under its existing `test.claim.self_host_` prefix -- no roster widening, nothing to price. Break
// the join, weaken it to a count comparison, or let the unmeasurable arm render as a pass, and a
// required run goes red on the next push.
//
// THE TREE IS NOT YET GATED BY IT. What executes on every required run is the LOGIC; what does not
// execute there is the MEASUREMENT. So a reader who sees eight passing required witnesses must not
// conclude the compile-phase frontier is walled: it is walled against its own regressions, and the
// live population still reaches it only when `tools.compile_phase_frontier_live_gate` `check` is
// invoked by hand.
//
// WHY, AND IT IS NOT COST. The wet measurement was priced by one dispatch of
// `tools.emission_entry_instrument` `measure` over the entry named above, on an amd64 runner with
// eleven cores and a twenty-gigabyte budget, and it returned inside the floor lane's wall clock.
// Re-derive that with the same instrument rather than quoting a figure from here.
//
// The blocker is the COMPARISON EPOCH, and it generalises past this gate. Every persisted receipt
// names host x86_64-unknown-linux-gnu; every required lane of `gunbc.witness_floor_workflow` runs
// on self-hosted arm64. A measurement taken where the gate would be enrolled is therefore not in
// the latest receipt's epoch, the frontier already refuses to count across one without a
// reclassified predecessor, and this gate answers Unmeasured and exits nonzero there. A required
// phase wired today would be permanently red rather than protective -- which is worse than absent,
// because a permanently red required phase is disabled by whoever is unblocking the trunk.
//
// THE DURABLE FINDING IS ABOUT THE RECEIPT SUBJECT, NOT ABOUT THIS GATE. The subject binds the
// tree, the invocation, the artifact and compiler digests, the identities and the producer. It does
// not bind the assembled-module SCOPE, and the export index is scoped to the run's assembled module
// list, so an entry-scoped and a pool-scoped run can resolve the same source differently. It also
// does not bind the toolchain EPOCH in any form a consumer enforces -- the epoch string is authored
// and checked only for changing when the other fields do, never against the host that produced the
// measurement. Both are parameters that VARY THE ANSWER while being absent from what any consumer
// checks, which is one defect with two instances. This gate is the first consumer that refuses
// instead of silently comparing, and that refusal is what surfaced the second instance.
type LiveGateEnrolment
  = LiveGateEnrolledAsRequiredPhase { phase: NonEmptyStr, lane: NonEmptyStr }
  | LiveGateDeclaredNotEnrolled { blocker: NonEmptyStr, trigger: NonEmptyStr }

data self_host_compile_phase_live_gate_enrolment: LiveGateEnrolment = LiveGateDeclaredNotEnrolled {
  blocker: "the live measurement of the tree is not enrolled in any required lane. The fold and its refusals ARE enrolled, through the required floor's existing test.claim.self_host_ prefix; what no required run performs is the measurement that would supply the tree as the current row. The cause is not wall clock: every persisted receipt names host x86_64-unknown-linux-gnu while every required lane of gunbc.witness_floor_workflow runs on self-hosted linux/arm64, so a measurement taken on a required runner falls outside the latest receipt's comparison epoch, this gate answers Unmeasured there, and a required phase wired today would be permanently red" as NonEmptyStr,
  trigger: "a VALIDATED compile-phase frontier receipt in the required runners' own comparison epoch, SUFFICIENT FOR enrolling the live measurement as a required phase -- which is more than an arm64 row existing. Sufficiency is decided by execution, not by inspection: the receipt's rustc_identity, cargo_identity and invocation.target must equal what the self-hosted arm64 runners actually report, and the check is that live_tree_frontier_verdict returns Held on an UNPERTURBED run of tools.compile_phase_frontier_live_gate check ON ONE OF THOSE RUNNERS. A receipt that leaves the gate answering Unmeasured there does not retire this row, a measurement taken anywhere the gate will not be enrolled does not retire it, and neither does the required-phase edit itself. Because this is an epoch transition, that receipt also owes the reclassified predecessor the frontier's fold demands, joined to the x86_64 population at identity grain -- file, code and label -- and never by position: the arm64 population will differ from the x86_64 one in ways that are real rather than regressions" as NonEmptyStr
}
