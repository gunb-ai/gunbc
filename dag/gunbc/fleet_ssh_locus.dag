module gunbc.fleet_ssh_locus
// A FLEET SSH CREDENTIAL LOCUS. Renamed out of `gunbc.spark.serving_credential_locus` because nothing
// in it was ever about Spark: it admits an attempt identity, finds the agent socket, materializes an
// attempt-owned public selector, verifies it against `fleet_automation_ssh_key` -- a FLEET credential
// -- and seals a `FleetSshExecutionContext`. Zero references to serving, models, or endpoints. The
// spark name was a nickname for a general capability (DESIGN §3), and the cost of leaving it there was
// concrete rather than aesthetic: `gunbc.live_deploy` needs exactly this preparation to observe a
// deployed tree over ssh, and its only options while the nickname stood were to import spark from
// live_deploy (cementing the nickname and inverting the layer) or to author a second preparation
// beside it (the fork §3 exists to prevent). A rename was the only move that violated nothing.
//
// ONE SPARK COUPLING SURVIVES AND IS NAMED RATHER THAN HIDDEN: `fleet_locus_ssh_target` still reads
// the login principal from `gunbc.spark.serving_desired`. That principal resolves to the fleet
// automation account and is almost certainly a second instance of the same nickname, but confirming
// it is a separate reading and the honest state today is a fleet module importing a spark one. The
// next step is to parameterize the principal at the locus rather than import a default, which turns
// this edge into an argument and lets each caller name the account it is entitled to -- deliberately
// NOT done in the same change as the rename, so that a mechanical move stays mechanically verifiable.



// ONE CREDENTIAL LOCUS, because there is only one kind of thing an SSH leg may run under: a sealed
// `FleetSshExecutionContext`.
//
// WHAT THIS DELETES AND WHY. `SparkServingSliceCredentialLocus` used to be a two-armed coproduct --
// `SparkServingSliceAnchoredContext { context }` for the operator workstation, and a nullary
// `SparkServingSliceRunnerAgent` for the GHA route. The second arm's own authority note said it
// "carries NO trust facts of its own; the job establishes them out of band", and it projected to a
// bare `SshShell { ssh_host: "user@host" }` -- no anchor, no credential, no OpenSSH posture. Every
// exactness property the fleet SSH machinery exists to hold was absent on the route that actually
// runs against the Sparks.
//
// It existed because of a REPRESENTATION GAP, not a decision: `FleetSshCredentialBinding` required an
// identity file, an agent-held key has none, so the runner route could not build a binding, could not
// build a context, and had nothing to pass. Once the agent-held locus and its verification landed,
// that arm stopped being a second kind of run and became a second name for one -- so it is deleted
// rather than kept beside the thing that replaced it.
//
// With one arm left the coproduct itself was a nickname for `FleetSshExecutionContext`, so it is gone
// too. The helpers below take the context directly.

fn fleet_locus_ssh_target(host: product.placement_supply.HostIdentity) -> gunbc.fleet_known_hosts_anchor.SshTarget {
  gunbc.fleet_known_hosts_anchor.SshTarget {
    endpoint: fleet_probe_endpoint_for(host: host as String) as std.types.NonEmptyStr,
    principal: spark_serving_automation_principal_login(),
  }
}

// One transport, derived. There is no arm that can produce an unanchored one.
fn fleet_locus_transport(
  context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext,
  host: product.placement_supply.HostIdentity,
) -> gunbc.host_effect.HostEffectTransport {
  gunbc.host_effect.FleetSsh { target: fleet_locus_ssh_target(host: host), context: context }
}

// The receipt line naming where the credential was held, read off the binding the context carries
// rather than off a label the caller chose. A run cannot claim an anchored posture it did not obtain,
// because the string is derived from the sealed value.
fn fleet_locus_label(context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext) -> String {
  fleet_ssh_credential_locus_label(binding: context.credential)
}

// ── Preparing the runner-side context ───────────────────────────────────────────────────────────

type FleetSshContextPreparation =
    FleetSshContextReady { context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext, receipt: String }
  | FleetSshContextRefused { cause: String }

fn fleet_ssh_agent_socket() -> std.types.NonEmptyStr? {
  match shell.Env.Get(name: "SSH_AUTH_SOCK" as std.types.NonEmptyStr).value {
    Present { value: raw } =>
      if trim(s: raw) == "" { none } else { Present { value: trim(s: raw) as std.types.NonEmptyStr } }
    Absent => none
  }
}

// THE RUNNER ROUTE'S CONTEXT, built here rather than assumed.
//
// The entries that used to pass `SparkServingSliceRunnerAgent` carried a `trust_line` reading
// "established by the runner job, not by this entry". That sentence was accurate and it was the
// problem: the entry asserted a precondition it had no way to check, so a job step that silently
// stopped materializing the anchor, or an agent holding a different key, produced the same receipt.
//
// Each step here is observed and each refusal is typed and located. On any refusal the caller holds
// no context, and since `fleet_locus_transport` is the only way to a transport and it
// requires one, zero SSH legs execute -- a property of the types rather than a discipline.
func prepare_fleet_ssh_agent_context(attempt_raw: String) -> FleetSshContextPreparation
  uses net: std.resources.Network
{
  match fleet_ssh_attempt_identity(raw: attempt_raw) {
    Absent =>
      FleetSshContextRefused {
        cause: join([
          "fleet ssh context refused: attempt identity `", attempt_raw,
          "` is not a safe path segment, so the anchor and selector have no attempt-owned path",
        ], ""),
      }
    Present { value: attempt } =>
      match fleet_ssh_agent_socket() {
        Absent =>
          FleetSshContextRefused {
            cause: "fleet ssh context refused: SSH_AUTH_SOCK is unset or empty, so there is no named agent to verify the fleet credential against",
          }
        Present { value: sock } =>
          match materialize_agent_public_selector(attempt: attempt, key: fleet_automation_ssh_key) {
            AgentSelectorRefused { cause: cause } =>
              FleetSshContextRefused { cause: cause }
            AgentSelectorMaterialized { selector: selector } =>
              match verify_fleet_ssh_agent_credential(
                agent_socket: sock,
                selector: selector,
                expected_key: fleet_automation_ssh_key,
                expected_fingerprint: fleet_automation_ssh_key_fingerprint as std.types.NonEmptyStr,
              ) {
                FleetSshCredentialIdentityMismatch { expected_line: e, observed_line: o } =>
                  FleetSshContextRefused {
                    cause: fleet_ssh_credential_verification_refusal_reason(
                      verification: gunbc.fleet_ssh_credential_verify.FleetSshCredentialIdentityMismatch { expected_line: e, observed_line: o },
                    ),
                  }
                FleetSshCredentialDerivationRefused { cause: cause } =>
                  FleetSshContextRefused {
                    cause: fleet_ssh_credential_verification_refusal_reason(
                      verification: gunbc.fleet_ssh_credential_verify.FleetSshCredentialDerivationRefused { cause: cause },
                    ),
                  }
                FleetSshCredentialVerified { binding: binding } =>
                  fleet_ssh_context_from_verified_binding(
                    attempt: attempt,
                    binding: binding,
                  )
              }
          }
      }
  }
}

// The anchor half, entered only with a verified credential. Deliberately last: materializing a
// known-hosts file is cheap and harmless, but the ORDER states the priority -- the credential is
// established before anything about reaching a host is prepared.
func fleet_ssh_context_from_verified_binding(
  attempt: gunbc.fleet_known_hosts_anchor.FleetSshAttemptIdentity,
  binding: gunbc.fleet_known_hosts_anchor.FleetSshCredentialBinding,
) -> FleetSshContextPreparation
  uses net: std.resources.Network
{
  let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
  match fleet_ssh_execution_context_of(outcome: materialization, credential: binding) {
    Absent =>
      FleetSshContextRefused {
        cause: join([
          "fleet ssh context refused before any ssh leg: ",
          known_hosts_materialization_receipt(outcome: materialization),
        ], ""),
      }
    Present { value: context } =>
      FleetSshContextReady {
        context: context,
        receipt: join([
          "credential ", fleet_ssh_credential_locus_label(binding: binding),
          " trust=attempt-owned known_hosts anchor materialized and content-verified by THIS entry\n",
          known_hosts_materialization_receipt(outcome: materialization),
        ], ""),
      }
  }
}
