  + weigh(b: the_x64_sku_refuses_on_the_m12830(), w: 16384)
  + weigh(b: an_arm_sku_refuses_on_an_x64_processor(), w: 32768)
  + weigh(b: a_matching_architecture_still_derives(), w: 65536)
  + weigh(b: a_ddr5_module_refuses_against_the_ddr4_platform(), w: 131072)
  + weigh(b: one_incompatible_module_refuses_the_whole_offer(), w: 262144)
  + weigh(b: an_existing_128gib_host_reports_what_it_provides_and_its_shortfall(), w: 524288)
  + weigh(b: the_admission_fold_and_the_observation_disagree_on_reachable_bounds(), w: 1048576)
  + weigh(b: an_exactly_sized_machine_is_evenly_bound(), w: 2097152)
  + weigh(b: observation_refuses_a_mismatched_architecture_too(), w: 4194304)
  + weigh(b: the_documented_four_module_shape_is_declined_not_invalid(), w: 8388608)
  + weigh(b: the_permissive_policy_admits_the_documented_partial_shapes(), w: 16777216)
  + weigh(b: a_board_without_a_cited_population_table_refuses_the_permissive_policy(), w: 33554432)
  + weigh(b: the_same_uncited_board_derives_under_the_full_channel_policy(), w: 67108864)
  + weigh(b: three_boards_are_answered_and_every_channel_count_is_derived(), w: 134217728)
  + weigh(b: a_2dpc_board_reaches_a_target_the_1dpc_board_cannot(), w: 268435456)
  + weigh(b: github_x64_is_unreadable_rather_than_contradicting(), w: 536870912)
  + weigh(b: every_declared_sku_is_supported_and_still_carries_its_contradictions(), w: 1073741824)
  + weigh(b: a_declared_decimal_basis_converts_to_bytes(), w: 2147483648)
  + weigh(b: the_same_quoted_figure_differs_under_a_binary_basis(), w: 4294967296)
  + weigh(b: an_undeclared_basis_refuses_the_capacity_derivation(), w: 8589934592)
