  the_population_names_its_overshoot,
  a_mixed_unit_label_sample_refuses_a_ratio,
  the_same_sample_in_one_unit_yields_a_ratio,
}

fn weigh(b: Bool, w: Nat) -> Nat { if b { w - w } else { w } }

fn suite_failure_mask() -> Nat {
  weigh(b: ubicloud_and_blacksmith_publish_three_gb_per_arm_vcpu(), w: 1)
  + weigh(b: depot_publishes_four_gb_per_arm_vcpu(), w: 2)
  + weigh(b: a_provider_with_non_uniform_sizes_refuses_a_single_ratio(), w: 4)
  + weigh(b: circleci_x86_docker_is_two_gb_per_vcpu(), w: 8)
  + weigh(b: only_ubicloud_states_a_dedicated_core_entitlement(), w: 16)
  + weigh(b: ubicloud_x64_entitlement_is_an_smt_thread(), w: 32)
  + weigh(b: ubicloud_supports_the_three_gb_value_sku(), w: 64)
  + weigh(b: ubicloud_contradicts_the_four_gb_memory_sku(), w: 128)
  + weigh(b: github_arm_cannot_support_any_declared_figure(), w: 256)
  + weigh(b: circleci_contrasts_with_the_x64_sku_rather_than_supporting_it(), w: 512)
  + weigh(b: a_sku_standing_only_on_contradictions_is_unsupported(), w: 1024)
  + weigh(b: arm_benchmarks_record_the_providers_own_entitlement_silence(), w: 2048)
  + weigh(b: the_sku_entitlement_is_declared_not_inherited(), w: 4096)
