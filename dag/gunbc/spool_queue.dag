module gunbc.spool_queue

import std.types { String, NonEmptyStr, List, Bool, Int, path_segment_is_safe }
import std.optional { Optional, Present, Absent }

// THE QUEUE CONTRACT FOR THE CROSS-PRIVILEGE SPOOLS, as PURE TRANSITION SEMANTICS with no store, no filesystem
// and no codec in it (the shape std.durable_exclusive_hold has for its occupancy question). Three spools are
// rename state machines claimed by Move.NoReplaceDirectory whose records are payload-less directory NAMES:
// the attempt-unit request spool, the attempt-exit spool and the publication request spool. Each hand-spelled
// its stages in host_layout, took instance_root as a String, and decided "who owns this entry" by which
// directory it happened to be found in.
//
// WHY THIS IS A NEW HOME AND NOT AN EXISTING ONE (DESIGN section 2, DFS first). None of the neighbours
// carries a queue or claim contract:
//   - product.capacity.event_chain / pool_events / gunbc.fabric.fabric_event_log: a hash-linked LOG under a
//     head expectation. One total order, no per-entry state, no claim. Spool entries are independent and each
//     is claimed exactly once.
//   - std.durable_exclusive_hold: held/free of ONE keyed slot with an owner and a release. A queue entry is
//     created, claimed once and then terminal; it is never freed and re-held. Stretching Hold over that
//     lifecycle would give "release" two meanings (DESIGN section 3, meaning fork).
//   - std.durable_compare_and_set: judges the GENERATION of a payload slot. These records have no payload and
//     rename(2) is the election, so a CAS body would be a format change.
//   - std.observation: occurrences for reports, not a state machine.
// What is reused is the VOCABULARY of std.durable_exclusive_hold, not its protocol: occupancy is derived from
// an observation and never accepted from a caller, and an unreadable observation is not a state.
//
// INVENTORY: rows Sbb01362f (attempt-unit request spool), S4df2b101 (attempt-exit spool) and S29c50e03
// (publication requests) of the store inventory at commit c5671ca07216.
//
// MODEL ONLY. This module declares the closed stage roles, the per-spool declaration row, the sealed entry key
// and the pure decisions of the four operations (enqueue, claim, complete, observe) plus the two crash decisions
// (spool_requeue_assess on boot-id evidence, then spool_stale_assess for the line stop). The effect layer (listing, create-only write, the rename) is
// the implementation PR; its REDs are the expecting-red claims in test.claim.spool_queue_seal_witness.

type SpoolKind
  = SpoolAttemptUnit
  | SpoolAttemptExit
  | SpoolPublication

// The closed set of places an entry can stand. HostSpoolStage (gunbc.durable_handoff_host) is the exit spool's
// private five-stage enum (inbox = RolePending, queued = RoleHandedOff, running = RoleClaimed, done = RoleDone,
// refused = RoleRefused). STAGED, not yet cut: HostSpoolStage still exists at this revision, and the witness
// claim the_host_spool_stage_enum_is_importable_today holds it red-to-flip. The cut is the implementation PR,
// because its consumers (durable_handoff_host, spool_stall, roadmap_attempt_exit_spool, roadmap_belt_actuate,
// roadmap_launch_deployment_observe/_receipt) are effect code, which this model-only lane was ruled not to touch
// (parent jolly-hawk-60, design approval). The change node://adhoc-ec4fbad6-dec deletes HostSpoolStage in the same change (DESIGN section 3).
type SpoolRole
  = RolePending
  | RoleHandedOff
  | RoleClaimed
  | RoleDone
  | RoleRefused

// Who may perform a verb. ExternalHook is a writer the corpus does not execute (a systemd ExecStopPost mkdir).
type SpoolPrincipal
  = PrincipalRequester
  | PrincipalDrainer
  | PrincipalExternalHook

// chain: the non-terminal roles in order. A claim advances an entry ONE step along it; there is no step back.
// terminals: the roles an entry can finish in. A role in neither list is not declared for the spool.
// entry_kind: what one entry IS on disk. The exit and unit spools are directory NAMES (payload-less, claimed by
// shell.Move.NoReplaceDirectory); the publication spool holds FILES WITH BODIES (written create-new, retired by
// Move.File). wire_suffix is the file extension an entry carries on disk ("" for a directory name).
type SpoolEntryKind
  = SpoolEntryDirectory
  | SpoolEntryFile

type SpoolDeclaration {
  entry_kind: SpoolEntryKind
  wire_suffix: String
  chain: List<SpoolRole>
  terminals: List<SpoolRole>
  enqueuer: SpoolPrincipal
  claimant: SpoolPrincipal
  key_separator: String
  key_part_count: Int
}

// THE DECLARATION IS DATA: adding a spool is a variant and a row here, never a stage list at a call site.
fn spool_declaration(kind: SpoolKind) -> SpoolDeclaration {
  match kind {
    SpoolAttemptUnit => SpoolDeclaration {
      entry_kind: SpoolEntryDirectory,
      wire_suffix: "",
      chain: [RolePending, RoleClaimed],
      terminals: [],
      enqueuer: PrincipalRequester,
      claimant: PrincipalDrainer,
      key_separator: "-",
      key_part_count: 2,
    }
    SpoolAttemptExit => SpoolDeclaration {
      entry_kind: SpoolEntryDirectory,
      wire_suffix: "",
      chain: [RolePending, RoleHandedOff, RoleClaimed],
      terminals: [RoleDone, RoleRefused],
      enqueuer: PrincipalExternalHook,
      claimant: PrincipalDrainer,
      key_separator: "+",
      key_part_count: 7,
    }
    SpoolPublication => SpoolDeclaration {
      entry_kind: SpoolEntryFile,
      wire_suffix: ".json",
      chain: [RolePending],
      terminals: [RoleRefused],
      enqueuer: PrincipalRequester,
      claimant: PrincipalDrainer,
      key_separator: "-",
      key_part_count: 1,
    }
  }
}

// THE DISK AS IT IS: the wire directory each role stands in, under the spool root (attempt-exit-spool,
// attempt-unit-spool, publication-spool). Absent means the role has NO directory: the unit spool's refusal is an
// answers/ file (out of scope, the answer-store frontier) and the publication helper works the request in place, so
// it has no claimed directory. A move into a role with no directory is refused typed, never silent.
fn spool_role_dir(kind: SpoolKind, role: SpoolRole) -> Optional<String> {
  match kind {
    SpoolAttemptExit =>
      match role {
        RolePending => Present { value: "inbox" }
        RoleHandedOff => Present { value: "queued" }
        RoleClaimed => Present { value: "running" }
        RoleDone => Present { value: "done" }
        RoleRefused => Present { value: "refused" }
      }
    SpoolAttemptUnit =>
      match role {
        RolePending => Present { value: "requests" }
        RoleClaimed => Present { value: "claimed" }
        RoleHandedOff => Absent
        RoleDone => Absent
        RoleRefused => Absent
      }
    SpoolPublication =>
      match role {
        RolePending => Present { value: "requests" }
        RoleRefused => Present { value: "requests-refused" }
        RoleClaimed => Absent
        RoleHandedOff => Absent
        RoleDone => Absent
      }
  }
}

fn spool_role_has_dir(kind: SpoolKind, role: SpoolRole) -> Bool {
  match spool_role_dir(kind: kind, role: role) {
    Present { value: _ } => true
    Absent => false
  }
}

// A claim exists for a spool only if its chain has a step beyond the first role (exactly-one-consumer by rename).
fn spool_claim_realized(kind: SpoolKind) -> Bool {
  spool_declaration(kind: kind).chain |> any(r => spool_role_rank(role: r) > 0)
}

// THE WRITERS COLUMN, DERIVED (the single source). Who may create an entry INTO a role: the enqueuer and the claimant
// into the first role (the claimant by spool_requeue_assess, the one move to an earlier role), the claimant into
// every later one. The READER ROUTE is gunbc.live_deploy.emit, which creates each spool directory with the
// ownership these principals imply instead of spelling it beside host_layout's path functions; that rewrite is
// node://adhoc-ec4fbad6-dec. Requeue's writer is therefore IN this column, so the planned ownership cannot refuse it.
fn spool_pending_writers(kind: SpoolKind) -> List<SpoolPrincipal> {
  if spool_claim_realized(kind: kind) {
    [spool_declaration(kind: kind).enqueuer, spool_declaration(kind: kind).claimant]
  } else {
    [spool_declaration(kind: kind).enqueuer]
  }
}

fn spool_role_writers(kind: SpoolKind, role: SpoolRole) -> List<SpoolPrincipal> {
  match role {
    RolePending => spool_pending_writers(kind: kind)
    RoleHandedOff => [spool_declaration(kind: kind).claimant]
    RoleClaimed => [spool_declaration(kind: kind).claimant]
    RoleDone => [spool_declaration(kind: kind).claimant]
    RoleRefused => [spool_declaration(kind: kind).claimant]
  }
}

// THE SEALED ENTRY KEY. Minted only from the business key's parts (or decoded from a name through the same
// declaration); never from a path. The mint is INJECTIVE: each part must be a safe path segment and must not
// contain the separator, so two different part lists can never produce one name, and the parts are recoverable.
type SpoolEntryKey sole_constructor {
  kind: SpoolKind
  name: NonEmptyStr
}

type SpoolKeyMint
  = SpoolKeyMinted { key: SpoolEntryKey }
  | SpoolKeyRefused { detail: String }

fn spool_part_admitted(part: String, separator: String) -> Bool {
  path_segment_is_safe(raw: part) && !string_contains(s: part, pattern: separator)
}

fn spool_entry_key(kind: SpoolKind, parts: List<String>) -> SpoolKeyMint {
  let declaration = spool_declaration(kind: kind)
  if count(parts) != declaration.key_part_count {
    SpoolKeyRefused { detail: "the part count differs from the spool's declared key shape" }
  } else if parts |> any(p => !spool_part_admitted(part: p, separator: declaration.key_separator)) {
    SpoolKeyRefused { detail: "a key part is empty, unsafe as a path segment, or contains the spool's separator" }
  } else {
    SpoolKeyMinted { key: SpoolEntryKey { kind: kind, name: join(parts, declaration.key_separator) as NonEmptyStr } }
  }
}

// THE ONE DECODE: a name read out of a directory becomes a key only by splitting on the declared separator and
// re-minting its parts. A foreign name (wrong count, empty or unsafe part) is SpoolKeyRefused, never a key.
fn spool_entry_key_of_name(kind: SpoolKind, name: String) -> SpoolKeyMint {
  spool_entry_key(kind: kind, parts: name.split(delimiter: spool_declaration(kind: kind).key_separator))
}

fn spool_entry_key_parts(key: SpoolEntryKey) -> List<String> {
  (key.name as String).split(delimiter: spool_declaration(kind: key.kind).key_separator)
}

// One observation of ONE key across the spool's roles. Two roles holding the same key is Ambiguous and is never
// resolved by picking one; an observation that could not be made says nothing about the entry.
type SpoolEntryState
  = EntryAbsent
  | EntryStanding { role: SpoolRole }
  | EntryAmbiguous { roles: List<SpoolRole> }
  | EntryObservationUnavailable { detail: String }

fn spool_role_is_declared(kind: SpoolKind, role: SpoolRole) -> Bool {
  spool_declaration(kind: kind).chain |> any(r => r == role) || spool_role_is_terminal(kind: kind, role: role)
}

fn spool_role_is_terminal(kind: SpoolKind, role: SpoolRole) -> Bool {
  spool_declaration(kind: kind).terminals |> any(r => r == role)
}

// THE ONLY FORWARD STEP. The successor of a role is the first chain role of strictly greater rank; the LAST chain role (the claim
// itself) and every terminal have none. THE ONLY CONSTRUCTOR THAT MOVES AN ENTRY TO AN EARLIER ROLE IS
// spool_requeue_assess, gated on a typed claimant-dead observation (a boot id differing from the one the claim
// recorded). No unevidenced requeue, no reap-and-reclaim, no age-based release exist; without evidence the line
// stops through gunbc.roadmap.spool_stall.
fn spool_role_rank(role: SpoolRole) -> Int {
  match role {
    RolePending => 0
    RoleHandedOff => 1
    RoleClaimed => 2
    RoleDone => 3
    RoleRefused => 3
  }
}

fn spool_chain_successor(kind: SpoolKind, role: SpoolRole) -> SpoolRole? {
  spool_declaration(kind: kind).chain |> filter(r => spool_role_rank(role: r) > spool_role_rank(role: role)) |> first()
}

type SpoolEnqueueAssessment
  = EnqueueEligible { into: SpoolRole }
  | EnqueueAlreadyPresent { state: SpoolEntryState }
  | EnqueueRefused { detail: String }

fn spool_enqueue_assess(kind: SpoolKind, observed: SpoolEntryState) -> SpoolEnqueueAssessment {
  match observed {
    EntryAbsent => EnqueueEligible { into: RolePending }
    EntryStanding { role: _ } => EnqueueAlreadyPresent { state: observed }
    EntryAmbiguous { roles: _ } => EnqueueRefused { detail: "the entry stands in two stages" }
    EntryObservationUnavailable { detail: d } => EnqueueRefused { detail: d }
  }
}

// CLAIM advances one chain step. A lost election (the entry already stands at the last chain role) is typed.
type SpoolClaimAssessment
  = ClaimEligible { from: SpoolRole, into: SpoolRole }
  | ClaimAbsent
  | ClaimAlreadyClaimed
  | ClaimTerminal { state: SpoolEntryState }
  | ClaimRoleUndeclared { role: SpoolRole }
  | ClaimNotRealized
  | ClaimRefused { detail: String }

fn spool_claim_assess(kind: SpoolKind, observed: SpoolEntryState) -> SpoolClaimAssessment {
  if spool_claim_realized(kind: kind) {
    spool_claim_over(kind: kind, observed: observed)
  } else {
    ClaimNotRealized
  }
}

fn spool_claim_over(kind: SpoolKind, observed: SpoolEntryState) -> SpoolClaimAssessment {
  match observed {
    EntryAbsent => ClaimAbsent
    EntryAmbiguous { roles: _ } => ClaimRefused { detail: "the entry stands in two stages" }
    EntryObservationUnavailable { detail: d } => ClaimRefused { detail: d }
    EntryStanding { role: r } =>
      if spool_role_is_terminal(kind: kind, role: r) {
        ClaimTerminal { state: observed }
      } else {
        if spool_role_is_declared(kind: kind, role: r) {
          match spool_chain_successor(kind: kind, role: r) {
            Present { value: next } => ClaimEligible { from: r, into: next }
            Absent => ClaimAlreadyClaimed
          }
        } else {
          ClaimRoleUndeclared { role: r }
        }
      }
  }
}

// COMPLETE consumes a claim: only an entry at the LAST chain role (claimed) may finish, into a terminal the spool declares.
type SpoolOutcome
  = SpoolOutcomeDone
  | SpoolOutcomeRefused { cause: String }

type SpoolCompleteAssessment
  = CompleteEligible { into: SpoolRole }
  | CompleteNotClaimed { state: SpoolEntryState }
  | CompleteRoleUndeclared { role: SpoolRole }
  | CompleteRoleHasNoDirectory { role: SpoolRole }
  | CompleteRefused { detail: String }

fn spool_outcome_role(outcome: SpoolOutcome) -> SpoolRole {
  match outcome {
    SpoolOutcomeDone => RoleDone
    SpoolOutcomeRefused { cause: _ } => RoleRefused
  }
}

fn spool_complete_into(kind: SpoolKind, target: SpoolRole) -> SpoolCompleteAssessment {
  if spool_role_is_terminal(kind: kind, role: target) {
    if spool_role_has_dir(kind: kind, role: target) {
      CompleteEligible { into: target }
    } else {
      CompleteRoleHasNoDirectory { role: target }
    }
  } else {
    CompleteRoleUndeclared { role: target }
  }
}

// The role a completion consumes from: the LAST chain role (claimed where a claim exists; the publication spool has
// no claim, so its pending entry is retired in place).
fn spool_role_is_last(kind: SpoolKind, role: SpoolRole) -> Bool {
  if spool_declaration(kind: kind).chain |> any(c => c == role) {
    match spool_chain_successor(kind: kind, role: role) {
      Present { value: _ } => false
      Absent => true
    }
  } else {
    false
  }
}

fn spool_complete_assess(kind: SpoolKind, observed: SpoolEntryState, outcome: SpoolOutcome) -> SpoolCompleteAssessment {
  match observed {
    EntryAbsent => CompleteNotClaimed { state: observed }
    EntryAmbiguous { roles: _ } => CompleteRefused { detail: "the entry stands in two stages" }
    EntryObservationUnavailable { detail: d } => CompleteRefused { detail: d }
    EntryStanding { role: r } =>
      if spool_role_is_last(kind: kind, role: r) {
        spool_complete_into(kind: kind, target: spool_outcome_role(outcome: outcome))
      } else {
        CompleteNotClaimed { state: observed }
      }
  }
}

// CRASH REFUSAL. The verdict is an OBSERVATION of the claimant, never an age. ONE ordered policy over a dead claimant:
// spool_requeue_assess is consulted first and requeues only on boot-id evidence; where it refuses (no boot-id
// observation) a claimant observed dead by other means STOPS THE LINE here, through gunbc.roadmap.spool_stall. This
// decision itself has no arm that offers the entry again. Unobservable is not dead.
type SpoolClaimantLiveness
  = ClaimantObservedLive { evidence: NonEmptyStr }
  | ClaimantObservedDead { evidence: NonEmptyStr }
  | ClaimantUnobservable { cause: NonEmptyStr }

type SpoolStaleAssessment
  = StaleNotApplicable { state: SpoolEntryState }
  | StaleClaimantLive
  | StaleStopTheLine { evidence: NonEmptyStr }
  | StaleRefused { cause: NonEmptyStr }

fn spool_stale_assess(observed: SpoolEntryState, liveness: SpoolClaimantLiveness) -> SpoolStaleAssessment {
  match observed {
    EntryStanding { role: r } =>
      if (r == RoleClaimed) {
        match liveness {
          ClaimantObservedLive { evidence: _ } => StaleClaimantLive
          ClaimantObservedDead { evidence: e } => StaleStopTheLine { evidence: e }
          ClaimantUnobservable { cause: c } => StaleRefused { cause: c }
        }
      } else {
        StaleNotApplicable { state: observed }
      }
    EntryAbsent => StaleNotApplicable { state: observed }
    EntryAmbiguous { roles: _ } => StaleNotApplicable { state: observed }
    EntryObservationUnavailable { detail: _ } => StaleNotApplicable { state: observed }
  }
}

// REQUEUE ON EVIDENCE. Claimed -> the spool's first chain role, and only on a typed claimant-dead observation: the
// claim records the boot id it was taken under, and a DIFFERENT current boot id is the evidence (the claimant cannot
// have survived a reboot), as std.durable_exclusive_hold ReleasedOnEvidence. Age is never evidence; an absent
// observation refuses and the line stops through gunbc.roadmap.spool_stall.
type SpoolRequeueEvidence
  = BootsObserved { claim_boot_id: NonEmptyStr, current_boot_id: NonEmptyStr }
  | NoClaimantObservation { cause: NonEmptyStr }

type SpoolRequeueAssessment
  = RequeueEligible { from: SpoolRole, into: SpoolRole }
  | RequeueClaimantStillBound
  | RequeueNotClaimed { state: SpoolEntryState }
  | RequeueRefused { cause: NonEmptyStr }

fn spool_requeue_target(kind: SpoolKind) -> Optional<SpoolRole> {
  spool_declaration(kind: kind).chain |> first()
}

fn spool_requeue_on_boots(kind: SpoolKind, claim_boot_id: NonEmptyStr, current_boot_id: NonEmptyStr) -> SpoolRequeueAssessment {
  if (claim_boot_id == current_boot_id) {
    RequeueClaimantStillBound
  } else {
    match spool_requeue_target(kind: kind) {
      Present { value: t } => RequeueEligible { from: RoleClaimed, into: t }
      Absent => RequeueRefused { cause: "the spool declares no chain" as NonEmptyStr }
    }
  }
}

fn spool_requeue_assess(kind: SpoolKind, observed: SpoolEntryState, evidence: SpoolRequeueEvidence) -> SpoolRequeueAssessment {
  match observed {
    EntryStanding { role: r } =>
      if (r == RoleClaimed) && spool_claim_realized(kind: kind) {
        match evidence {
          BootsObserved { claim_boot_id: c, current_boot_id: n } => spool_requeue_on_boots(kind: kind, claim_boot_id: c, current_boot_id: n)
          NoClaimantObservation { cause: m } => RequeueRefused { cause: m }
        }
      } else {
        RequeueNotClaimed { state: observed }
      }
    EntryAbsent => RequeueNotClaimed { state: observed }
    EntryAmbiguous { roles: _ } => RequeueNotClaimed { state: observed }
    EntryObservationUnavailable { detail: _ } => RequeueNotClaimed { state: observed }
  }
}

// FRONTIERS (declared, consumed by a named later change, DESIGN 3c). Annotations, not rows: nothing reads them, and
// a String row that no fold reads is the dead data of DESIGN 4c. The implementation change is node://adhoc-ec4fbad6-dec
// (cut HostSpoolStage, move its 7 consumer modules, wire live_deploy.emit); it gives each a typed carrier.
//  - answers/: the reply record keyed to a request (publication and attempt-unit spools). Trigger: the publication
//    spool migrates onto spool_queue; the answer store is then modeled as its own sealed face.
//  - writers reader: gunbc.live_deploy.emit spells directory ownership beside host_layout; it derives from
//    spool_role_writers when the implementation PR migrates the three spools and deletes the literal spellings.
//  - out-of-corpus writers (the ExecStopPost hook is derived from the codec; any other principal is not): no rung is
//    established by this model-only change, so none is dropped here. The implementation PR files the gunbc.rung_drop
//    row (previous rung, temporary rung, reason, population, trigger). Restoration capability: each spool directory
//    creatable only by the principals spool_role_writers names, kernel-refusing others; a permission-bits readback
//    does not retire it.
