module gunbc.workspace_allocation_milestones

import std.types { String, NonEmptyStr, Timestamp, Bool }
import std.content_hash { content_hash_of_value, serialize_content_hash }
import std.durable_compare_and_set { ExpectSlotAbsent, CasCommitted, CasPreconditionFailed, CasObservedReadable, CasReadablePresent }
import gunbc.durable_cas_fabric_storage { fabric_storage_compare_and_set, fabric_storage_observe_cas_slot }
import gunbc.durable_cas_file_store { admit_cas_attempt_for_derived_payload, DerivedPayloadAdmitted }
import gunbc.fabric_storage_client { FabricStorageBinding }
import gunbc.workspace_allocation_store { WorkspaceAllocation, WorkspaceReleased }
import gunbc.workspace_allocation { WorkspaceReservation, workspace_reservation_json }
import gunbc.auth.approval_capability { utc_instant_is_canonical, utc_instant_before, utc_instant_seconds_after }
import extdeps.languages.json.emit { JsonValue, json_null, json_int, serialize_json }

fn workspace_first_ready_key(reservation: WorkspaceReservation) -> NonEmptyStr {
  concat("workspace-first-ready-", serialize_content_hash(hash: content_hash_of_value(value: serialize_json(v: workspace_reservation_json(reservation: reservation)) as NonEmptyStr)) as String) as NonEmptyStr
}

// The immutable incarnation key makes subsequent ready observations retain the first clock.
fn workspace_record_first_ready(store: FabricStorageBinding, reservation: WorkspaceReservation, observed_at: Timestamp) -> Bool {
  if !utc_instant_is_canonical(t: observed_at) { false }
  else { match admit_cas_attempt_for_derived_payload(key: workspace_first_ready_key(reservation: reservation), expected: ExpectSlotAbsent, proposed: observed_at as NonEmptyStr) {
    DerivedPayloadAdmitted { verified: proposed } => match fabric_storage_compare_and_set(store: store, verified: proposed) {
      CasCommitted { committed: _ } => true
      CasPreconditionFailed { expected: _, observed: _ } => true
      other => false
    }
    other => false
  } }
}

fn workspace_first_ready_at(store: FabricStorageBinding, reservation: WorkspaceReservation) -> Timestamp {
  match fabric_storage_observe_cas_slot(store: store, key: workspace_first_ready_key(reservation: reservation)) {
    CasObservedReadable { readable: CasReadablePresent { version: recorded } } => if utc_instant_is_canonical(t: recorded.value as String) { recorded.value as String } else { "" }
    other => ""
  }
}

// Unknown clocks and backwards readings are absent, never a synthetic zero duration.
fn workspace_observed_duration(later: Timestamp, earlier: Timestamp) -> JsonValue {
  if !utc_instant_is_canonical(t: later) || !utc_instant_is_canonical(t: earlier) || utc_instant_before(a: later, b: earlier) { json_null() }
  else { json_int(n: utc_instant_seconds_after(later: later, earlier: earlier)) }
}

// Released.observed_at is the actual successful cleanup publication, never lease expiry.
fn workspace_release_to_clean_seconds(allocation: WorkspaceAllocation) -> JsonValue {
  if allocation.phase != WorkspaceReleased { json_null() }
  else { workspace_observed_duration(later: allocation.observed_at, earlier: allocation.retired_at) }
}
