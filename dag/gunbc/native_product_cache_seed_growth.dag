module gunbc.native_product_cache_seed_growth

import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// FORWARD-FREEZE RECEIPT for the hand Rust that keys, stores and reuses the two native instruments'
// emitted products (CI programme row R3, docs/plans/ci-end-to-end-accounting.md).
//
// PURPOSE (gunbc.v1_maintenance_standing v1_seed_standing). `//gunbc/instruments:self-host` and
// `:v2-native-cli` each emit and cargo-build one closure on every required run, then run their
// door and refusal controls against the executable. The emit/build is a pure function of the six
// causal axes of v2.compiler.self_host.generation PreMaterializationIdentity, so the repeat is
// authored redundancy (DESIGN section 2). The consumer is the seed's own preparation step
// (cli_run native_lane_runner prepare_emitted_compiler_for_entry): it is the only producer of these
// products today, so the keyed store lands where the production is. It serves the v2 self-host
// lane, and it is the first consumer of std.materialization_provider
// ArtifactRequest::NativeCompilerArtifactRequest.
data native_product_cache_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.cli_run.native_product_cache", decl_name: "assemble_key", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_product_cache", decl_name: "derive_key", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_product_cache", decl_name: "lookup", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.native_product_cache", decl_name: "commit", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.emitted_closure_compile_host", decl_name: "probe_toolchain_identity_for_key", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.emitted_closure_compile_host", decl_name: "probe_build_configuration_for_key", field: WholeDeclaration }
  ],
  reason: "derive_key folds the six PreMaterializationIdentity axes in declared order (producer = the seed's own source tree, source closure plus the census-only declaration universe at content grain, target, toolchain, build configuration, lens contract) with SHA-256; lookup serves an entry only after re-hashing the executable against its manifest and the manifest against the key, and refuses and removes any entry that disagrees; commit writes a private sibling directory and renames it, only after the discriminating red held. Executed controls: four seed unit tests (hit under the key and miss under a changed one, corrupted executable refused and removed, entry without the red refused, every measured input reaches the key through assemble_key, the fold derive_key uses) and the CI run's hit/miss counters.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete these items when the native ancestry lane makes std.materialization_provider provider_serve the only producer of the native compiler artifact, serving it through a read-back digest of the executable and a request_key over the same six axes. A provider that keys but does not verify the executable on read would satisfy a trigger naming only the key while a corrupted store entry is still served.",
  current_boundary: "Reachable only from prepare_emitted_compiler_for_entry, and only when GUNBC_NATIVE_CACHE_ROOT names a store; with it unset nothing is read or written. Writes only under <root>/native-products."
}
