module gunbc.bmc_fan_program_capture

import std.types { EpochMs, Int, List, NonEmptyStr }
import product.placement_supply { HostIdentity }

// THE BYTES THAT WERE RUNNING, CAPTURED BEFORE ANYTHING ELSE IS MODELLED. srv3 and srv4 hold a fan
// control program that was arrived at by hand and that this repository cannot regenerate: the
// curve, the split between cooler and chassis actuator groups, the offsets and the slew limits are
// the outcome of live measurement against real DIMM temperatures, not a derivation from anything
// in the tree. If a BMC is reflashed or factory reset, that work is gone and no amount of modelling
// recovers it. So the bytes are captured first and everything else - the observer, the intent, the
// alignment - is authored afterwards against a fact that already exists.
//
// THIS IS NOT THE OBSERVER. It stores an artifact and its digest, and it deliberately does NOT
// decode the program into typed PID rows. Decoding is the observer cut's job and has its own
// acceptance boundary: the complete ordered PID population, every coefficient and limit and slew,
// unknown fields and unknown PID types retained rather than dropped, and absent/null/empty
// distinguished. Publishing a half-decode here would create a second, weaker representation of the
// same program for the observer to later contradict - and the capture would then be worth less than
// the raw bytes it started from.
//
// THREE DECODE HAZARDS ARE ALREADY VISIBLE IN THE CAPTURED BYTES, recorded here because they
// constrain the observer's shape and because each was found by reading the artifact rather than by
// reasoning about the format. They are rationale for a future author, not facts a program reads.
//
// ONE - THE STEP CURVE'S reading AND output ARE JSON OBJECTS WITH STRING KEYS "0".."8", NOT
// ARRAYS. An earlier revision of this note said they are paired by INDEX and that reordering the
// members can therefore mispair them. That was imprecise and the correction matters, because it
// changes which decoder is dangerous. They are paired by KEY IDENTITY - reading["3"] belongs with
// output["3"] - so reordering the members changes the BYTES and leaves the pairing intact as long
// as the keys survive.
//
// The decoder that actually corrupts the curve is the one that converts each object independently
// to a list of values, DROPS the keys, and zips the two lists. That produces a table whose every
// value is correct and whose pairings are wrong - a plausible-looking curve commanding the wrong
// duty at every temperature, and the highest-consequence field in the file. So the requirement is
// not "preserve order" but the stronger and more specific: preserve every member key, require the
// reading and output key sets to be EQUAL, refuse duplicate keys, join by exact key, and only then
// order the typed steps by parsed index.
//
// TWO - ABSENT IS NOT false. srv3 and srv4 both omit ignoreDbusMinMax on FAN4 while setting it true
// on every other fan. Both hosts agree, so this predates any hand editing and comes from the
// vendor's shipped configuration. Semantically absent may well behave as false, and that is exactly
// what makes it dangerous: a decoder that normalises absent to false changes nothing about
// behaviour and everything about BYTES, so the re-emitted file no longer matches the digest that
// was adopted. The adoption receipt is content-addressed, so a lossless round trip is what makes
// adoption meaningful at all.
//
// THREE - BYTE IDENTITY AND SEMANTIC IDENTITY ARE ALREADY DIFFERENT ACROSS THIS PAIR, and it is
// demonstrated inside the capture rather than argued from the format. srv3 writes failsafePercent
// 30.0 and 75.0 and minThermalOutput 30.0; srv4 writes 30, 75 and 30 for the same fields. Same
// numbers, different lexemes, different bytes, identical meaning.
//
// So one digest cannot answer both questions. sha256 over the exact artifact answers "are these the
// bytes that were adopted"; a digest over a canonical typed program would answer "is this the same
// control behaviour". A formatting-only rewrite moves the first and leaves the second still, while
// a change to an offset, a slew limit or a curve pairing must move both. Asking the artifact digest
// to certify behaviour would make every reformat look like a policy change and give the operator a
// stream of adoptions to ratify that mean nothing.
//
// FOUR - THE SENSOR ROSTER IS NOT THE POPULATED ROSTER. srv3 declares a FAN2 sensor and srv3 has
// no FAN2 fan; the bay is empty. So the deployed program's sensor list cannot be read as evidence
// of what is installed, and an observer that derived a fan population from it would resurrect
// exactly the fleet-wide required_tach_inputs defect this lane already removed - a header required
// to report that can only ever read absent.
//
// WHY THE PATH IS A DISCRIMINATOR AND NOT THE FACT. The artifacts sit outside dag/ because they are
// captured foreign bytes rather than authored source; the fact this module owns is the DIGEST, and
// the path is how a reader finds the bytes that produce it.

// WHAT THE DIGEST IS OVER, STATED SO IT CANNOT BE READ AS ANYTHING ELSE. It is sha256 of the exact
// committed artifact, byte for byte, with no normalisation, no re-serialisation and no JSON
// round-trip. That matters because a digest taken after a parse would answer a question about this
// repository's parser rather than about the deployed file, and the two come apart precisely when a
// field is unknown or a duplicate key appears - the cases where the difference is load-bearing.
//
// THE DIGEST WAS CONFIRMED FROM BOTH ENDS. Each BMC computed sha256sum over its own
// /usr/share/swampd/config-asrr.json and the value matched the committed artifact for both hosts,
// so the transfer is established as lossless by agreement between two independent computations
// rather than by the absence of an error from scp.
type CapturedProgramDigest {
  algorithm: NonEmptyStr
  hex: NonEmptyStr
}

// WHERE THE BYTES CAME FROM, AT A GRAIN THAT SURVIVES A REIMAGE. The machine id is carried beside
// the host name because a host name is a label this repository assigns and can be reassigned; the
// machine id is what distinguishes "the same BMC, reconfigured" from "a different BMC answering to
// the same name". A restore that cannot tell those apart is a restore that can write one machine's
// program onto another.
type CaptureOrigin {
  host: HostIdentity
  bmc_machine_id: NonEmptyStr
  firmware_version: NonEmptyStr
  source_path: NonEmptyStr
}

// HOW THE PROGRAM CAME TO HAVE THESE BYTES. This is not decoration: a restore decision depends on
// it. A hand-applied program is one nothing in this repository can regenerate, so restoring it means
// replaying these exact bytes; a converged program could instead be re-derived from intent. Marking
// a hand-applied program as converged would license discarding the only copy.
type ProgramProvenance
  = HandAppliedNotReproducibleFromSource
  | ConvergedFromModelledIntent
  | ProgramProvenanceUnobserved

type CapturedFanProgram {
  origin: CaptureOrigin
  captured_at: EpochMs
  artifact_path: NonEmptyStr
  artifact_byte_count: Int
  digest: CapturedProgramDigest
  provenance: ProgramProvenance
}

// THE ACOUSTIC OUTCOME THESE BYTES PRODUCED, RECORDED AS A MEASUREMENT AND NOT AS A TARGET. It is
// carried here rather than in an intent because it is a property of THIS program on THIS hardware,
// observed after it was applied - it is what the bytes did, not what anyone asked for. When the
// intent is finally authored, this is the figure it has to reproduce, and having it beside the
// bytes is what makes that check possible at all.
//
// tenths_dba is used rather than a decimal because std.acoustic carries A-weighted levels in tenths
// and this module does not get to invent a second scale for the same quantity.
type CapturedAcousticOutcome {
  tenths_dba: Int
  dimms_over_guard: Int
  dimm_population: Int
}

type CapturedProgramReceipt {
  program: CapturedFanProgram
  outcome: CapturedAcousticOutcome
}

data srv3_captured_program: CapturedProgramReceipt = CapturedProgramReceipt {
  program: CapturedFanProgram {
    origin: CaptureOrigin {
      host: "srv3",
      bmc_machine_id: "61c058a5db564eb3a20f6c891820fedd",
      firmware_version: "3.22.00",
      source_path: "/usr/share/swampd/config-asrr.json",
    },
    captured_at: 1787802300000,
    artifact_path: "artifacts/bmc/srv3-config-asrr.json",
    artifact_byte_count: 5212,
    digest: CapturedProgramDigest {
      algorithm: "sha256",
      hex: "b6e43af4652688330a3f8c1a979f9a178adc436d84f14c54651fe0cd9405161a",
    },
    provenance: HandAppliedNotReproducibleFromSource,
  },
  outcome: CapturedAcousticOutcome {
    tenths_dba: 350,
    dimms_over_guard: 0,
    dimm_population: 9,
  },
}

data srv4_captured_program: CapturedProgramReceipt = CapturedProgramReceipt {
  program: CapturedFanProgram {
    origin: CaptureOrigin {
      host: "srv4",
      bmc_machine_id: "4344cff41d7346c2b8a1a971d5aea590",
      firmware_version: "3.22.00",
      source_path: "/usr/share/swampd/config-asrr.json",
    },
    captured_at: 1787802300000,
    artifact_path: "artifacts/bmc/srv4-config-asrr.json",
    artifact_byte_count: 5206,
    digest: CapturedProgramDigest {
      algorithm: "sha256",
      hex: "e9357d5731b7131de1d3a7e20ffec9b397e65ebc3a4c50eb1d36f6a306d3e614",
    },
    provenance: HandAppliedNotReproducibleFromSource,
  },
  outcome: CapturedAcousticOutcome {
    tenths_dba: 349,
    dimms_over_guard: 0,
    dimm_population: 9,
  },
}

data fleet_captured_fan_programs: List<CapturedProgramReceipt> = [
  srv3_captured_program,
  srv4_captured_program,
]
