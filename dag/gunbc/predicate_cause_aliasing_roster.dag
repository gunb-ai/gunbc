fn negative_control_site_is_named(row: NegativeControlSite) -> Bool {
  row.module_path != "" && row.symbol != ""
}

test fn every_negative_control_row_names_its_site() -> Bool {
  fold_list(
    xs: bare_false_negative_controls,
    empty: true,
    cons: fn(ok, row) { ok && negative_control_site_is_named(row: row) }
  )
}
