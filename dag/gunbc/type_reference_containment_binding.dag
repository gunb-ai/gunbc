module gunbc.type_reference_containment_binding

import std.types { String, NonEmptyStr }
import std.disposition { Disposition, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data type_reference_containment_binding_authority_note: String = "N2 slice 1 (quiet-hawk-219 / smart-eagle-409): THE substrate entry for cross-module type-reference containment binding. TypeOccurrence references resolve ONLY through std.occurrence_binding_candidates.resolve_type_reference_containment_binding — P2a candidate population (DeclarationExposure authority, authored-order gating, declarations_by_name index) handed to std.occurrence_binding_resolve.resolve_reference_occurrence_binding's single occurrence_binding_from_candidates fold. Flat symbol_index_lookup / lookup_type_by_name are NOT binding selectors on this path. Authority: docs/plans/containment-binding-cross-module-type-references-design.md Phase B; operational plan section 4 namespace-reference-derived-closure + namespace-binding-kernel."

data type_reference_containment_binding_slice1_scope_note: String = "Slice 1 scope: substrate authority + executing fixture witnesses for TypeOccurrence through the structural kernel. IN: hand-built OccurrenceTransport fixtures proving cross-module bare containment bind, module-sibling visibility, unbound when not exposed, and category inadmissibility. OUT OF SLICE: v1 production lookup_type_by_name changeover (slice 2+), qualified namespace-segment projection (std.types.ContentHash terminal path), N1a measure-arm removal, resolution_divergence_census type-site generalization — each carries its own dissolution trigger and must not be smuggled in here."

data type_reference_containment_binding_scaffold: Disposition = SingleAuthority {
  bind: DeclarationRef {
    module_path: "std.occurrence_binding_candidates" as NonEmptyStr,
    decl_name: "resolve_type_reference_containment_binding" as NonEmptyStr,
    field: WholeDeclaration
  }
}
