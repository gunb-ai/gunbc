  StructuralTextOccurrencePopulation { module_path: "v2.std.compilers.lexing" as NonEmptyStr, occurrence_count: 4, in_measured_compiler_closure: true },
  StructuralTextOccurrencePopulation { module_path: "v2.test.tokenize.source_text_ingress" as NonEmptyStr, occurrence_count: 1, in_measured_compiler_closure: false }
]

