  NewlyExposedRustDiagnosticIdentity { declaration: decl_ref(module_path: "v2.compiler.source_authority" as NonEmptyStr, decl_name: "source_ir_artifact_provenance_from_model" as NonEmptyStr), diagnostic_code: "E0308" as NonEmptyStr, multiplicity: 1 },
