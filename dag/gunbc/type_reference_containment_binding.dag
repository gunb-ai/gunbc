  NewlyExposedRustDiagnosticIdentity { declaration: decl_ref(module_path: "v2.compiler.tokenize" as NonEmptyStr, decl_name: "tokenize_module_authority_note" as NonEmptyStr), diagnostic_code: "E0308" as NonEmptyStr, multiplicity: 1 },
