module gunbc.type_reference_containment_binding

import std.dissolution { DissolutionCondition, unbound_dissolution }

import std.types { String, NonEmptyStr }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data type_reference_containment_binding_authority_note: String = "N2 slice 1 (quiet-hawk-219 / smart-eagle-409): THE substrate entry for cross-module type-reference containment binding. TypeOccurrence references resolve ONLY through std.occurrence_binding_candidates.resolve_type_reference_containment_binding — P2a candidate population (DeclarationExposure authority, authored-order gating, declarations_by_name index) handed to std.occurrence_binding_resolve.resolve_reference_occurrence_binding's single occurrence_binding_from_candidates fold. Flat symbol_index_lookup / lookup_type_by_name are NOT binding selectors on this path. Authority: docs/plans/containment-binding-cross-module-type-references-design.md Phase B; operational plan section 4 namespace-reference-derived-closure + namespace-binding-kernel."

data type_reference_containment_binding_slice1_scope_note: String = "Slice 1 scope: substrate authority + executing fixture witnesses for TypeOccurrence through the structural kernel. IN: hand-built OccurrenceTransport fixtures proving cross-module bare containment bind, module-sibling visibility, unbound when not exposed, and category inadmissibility. OUT OF SLICE: v1 production lookup_type_by_name changeover (slice 2+), qualified namespace-segment projection (std.types.ContentHash terminal path), N1a measure-arm removal, resolution_divergence_census type-site generalization — each carries its own dissolution trigger and must not be smuggled in here."

// ROOT-CUT RECEIPT, attached to this authority rather than minted as a second migration ledger.
// The four perturbations were made only in copies of one preserved emitted artifact; none is a
// proposed per-module repair. Their successor identities show that changing one consumer merely
// moves the carrier boundary. The production X named here is therefore #9813's module-wide flat
// TypeEnv binding (import union -> kernel overlay -> direct-selected overlay with kernel names
// skipped). The replacement Y is the authority above: one exact declaration binding per
// TypeOccurrence, derived from containment/qualification and carried through typecheck and emit.
data type_reference_containment_binding_string_root_cut_receipt: String = "MEASURED on source revision cd3cf69bda0 with gunbc.instruments.emission_entry_instrument over src/v2/compiler/00_compile.dag: 166 emitted modules; baseline 65 unique Rust error identities = 64 coded + 1 codeless. String is the only v2.std top-level declaration colliding with the Rust prelude; 18 closure modules import v2.std.text.String and all 18 emit zero exact v2_std_text::String use-lines with nonzero bare String spellings. Throwaway-copy identity deltas over one preserved emitted tree, with no netting: tokenize use-line vanished 41 incumbent E0308, persisted zero of those identities, and newly appeared 12 NewlyExposedByRootCut identities; tokenize occurrence qualification vanished the same 41, persisted zero, and newly appeared 11, including the same six downstream identities; target_model use-line vanished six of seven incumbent identities (E0277, E0282, E0599, three E0308), persisted one E0308, and newly appeared 17; target_model occurrence qualification vanished the same six, persisted the same one E0308, and newly appeared a different population of 28. The target_model four-code spectrum moved together under one carrier-binding decision. No local import-line, emitted-qualification, or per-consumer respelling establishes one representation through the dependency chain. Production X being retired is #9813's module-wide flat TypeEnv precedence; replacement Y is one exact declaration binding per TypeOccurrence through resolve_type_reference_containment_binding, consumed by typecheck and emission without re-resolution through X."

// Positive evidence, not the missing-guarantee denominator. These occurrences already spell the
// intended Y identity explicitly; counting them as residue would read a selection view as the
// population authority. The future denominator is every production TypeOccurrence currently
// bound through X, partitioned by old/new occurrence-binding result.
data type_reference_containment_binding_structural_text_positive_subset_receipt: String = "AlreadyOccurrenceBoundStructuralText: 30 hand-authored v2.std.text.String occurrences across src/v2. Breakdown: v2.compiler.tokenize 25, v2.std.compilers.lexing 4, v2.test.tokenize.source_text_ingress 1. The measured 166-module compiler closure contains the first 29 across two modules; the test occurrence is outside it. All 30 positions require the structural carrier, but the set is an independently-derived positive subset, never a drop population or denominator. The unmeasured denominator is every production TypeOccurrence whose declaration identity currently comes through the flat TypeEnv/precedence path; this instrument did not enumerate that population. Replacement-census partitions: OldAndNewAgree, OldAndNewDisagree, OldBinds_NewUnresolved, OldBinds_NewAmbiguous, OldUnresolved_NewBinds."

// The tokenizer root-cut probe's twelve successors remain named so the migration cannot net them
// off against the 41 incumbents. Multiplicity is part of identity where one source symbol contains
// more than one distinct failing occurrence; emitted line numbers are deliberately absent.
data type_reference_containment_binding_newly_exposed_string_identities_receipt: String = "NewlyExposedByRootCut after structuralizing tokenizer: v2.compiler.tokenize::lex_rule_thunk E0308 x2; v2.compiler.tokenize::lex_walk_step E0308 x2; v2.compiler.tokenize::tokenize E0599 x1; v2.compiler.tokenize::tokenize_module_authority_note E0308 x1; v2.compiler.compile::compile_ingest_with_admission E0308 x1; v2.compiler.compile::stage_tokenize E0308 x1; v2.compiler.program_assembly::program_assembly_read_to_normalized_root_prepared E0308 x1; v2.compiler.source_authority::parse_dag_source_ast_with_model E0308 x1; v2.compiler.source_authority::source_ir_artifact_provenance_from_model E0308 x1; v2.compiler.source_authority::module_storage_binding_from_read_prepared E0308 x1. Total 12 identities; they are fix-forward population behind the root cut, not regressions and not a count to net against incumbents."

// CODELESS IS A FIRST-CLASS PARTITION. A code-keyed census reports 64 and silently loses this
// row; the explicit reconciliation is the receipt. Its repair belongs to the declaration-bound
// formal carrier transaction, where emission is the third consumer beside compatibility and
// inhabitance, not to a witness-specific parallel carrier.
data type_reference_containment_binding_codeless_emission_consumer_receipt: String = "Fresh emitted-Rust census reconciliation: coded 64 + codeless 1 = total 65. The codeless identity is v2.compiler.compile::apply_compile_lens_introspect — witness carrier type arg unresolved for variant Violates. infer_call_arguments_generic_pass computes the substituted formal and build_call_application_plan retains formal_subst transiently, but the emitted argument carries neither; rust_witness_type_arg_for_variant therefore cannot recover Witness<Node>. Emission is the third consumer of the single declaration-bound formal authority, and requires its substitution basis."

data type_reference_containment_binding_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.occurrence_binding_candidates" as NonEmptyStr,
    decl_name: "resolve_type_reference_containment_binding" as NonEmptyStr,
    field: WholeDeclaration
  }
}

data type_reference_containment_binding_dissolve_on: DissolutionCondition = unbound_dissolution(description: "DISSOLVE-ON: v1 type positions consume std.occurrence_binding_candidates.resolve_type_reference_containment_binding by execution (not a parallel lookup), N1a measure predicate deletes per gunbc.type_ref_hit_ne_bind_measure type_ref_hit_ne_bind_measure_dissolve_trigger, and flat lookup-as-binding paths retain only migration-oracle status until census parity. This authority module deletes when the d")
