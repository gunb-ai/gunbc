fn probe_oracle_len() -> Int {
  gunbc.accelerator_demo_eval.eval_accelerator_program(
    program: gunbc.accelerator_demo_program.relu_mul_add_pure_program,
    a: [2, -1, 0, 5],
    b: [3, 4, 7, -2],
    c: [1, 10, -3, 8]
  ).length()
}

fn probe_oracle_first() -> Int {
  match gunbc.accelerator_demo_eval.eval_accelerator_program(
    program: gunbc.accelerator_demo_program.relu_mul_add_pure_program,
    a: [2, -1, 0, 5],
    b: [3, 4, 7, -2],
    c: [1, 10, -3, 8]
  ).first() {
    Present { value: v } => v
    Absent => 0 - 999
  }
}

fn oracle_out() -> List<Int> {
  gunbc.accelerator_demo_eval.eval_accelerator_program(
    program: gunbc.accelerator_demo_program.relu_mul_add_pure_program,
    a: [2, -1, 0, 5],
    b: [3, 4, 7, -2],
    c: [1, 10, -3, 8]
  )
}

fn probe_skip1() -> List<Int> {
  oracle_out().skip(n: 1)
}

fn probe_skip1_len() -> Int {
  oracle_out().skip(n: 1).length()
}

fn probe_elem1() -> Int {
  match oracle_out().skip(n: 1).first() {
    Present { value: v } => v
    Absent => 0 - 999
  }
}

fn probe_eq_via_realize_copy() -> Bool {
  gunbc.accelerator_demo_realize.int_list_eq(left: oracle_out(), right: [7, 6, 0, 0])
}

fn my_int_list_eq(left: List<Int>, right: List<Int>) -> Bool {
  if left.length() != right.length() {
    false
  } else if left.length() == 0 {
    true
  } else {
    match left.first() {
      Present { value: l } =>
        match right.first() {
          Present { value: r } =>
            if l != r {
              false
            } else {
              my_int_list_eq(left: left.skip(n: 1), right: right.skip(n: 1))
            }
          Absent => false
        }
      Absent => false
    }
  }
}

fn probe_eq_my_copy() -> Bool {
  my_int_list_eq(left: oracle_out(), right: [7, 6, 0, 0])
}

fn probe_len_neq() -> Bool {
  oracle_out().length() != 4
}

fn eq_debug(left: List<Int>, right: List<Int>, depth: Int) -> Int {
  if left.length() != right.length() {
    100 + depth
  } else if left.length() == 0 {
    0 - 1
  } else {
    match left.first() {
      Present { value: l } =>
        match right.first() {
          Present { value: r } =>
            if l != r {
              200 + depth
            } else {
              eq_debug(left: left.skip(n: 1), right: right.skip(n: 1), depth: depth + 1)
            }
          Absent => 300 + depth
        }
      Absent => 400 + depth
    }
  }
}

fn probe_eq_debug() -> Int {
  eq_debug(left: oracle_out(), right: [7, 6, 0, 0], depth: 0)
}

fn probe_relu_zero() -> Int {
  gunbc.accelerator_demo_eval.int_relu(x: 0 - 3)
}

fn probe_relu_zero_eq() -> Bool {
  gunbc.accelerator_demo_eval.int_relu(x: 0 - 3) == 0
}

fn probe_intmax_zero_eq() -> Bool {
  int_max(a: 0, b: 0 - 3) == 0
}

fn probe_elem2_eq_zero() -> Bool {
  match oracle_out().skip(n: 2).first() {
    Present { value: v } => v == 0
    Absent => false
  }
}

fn probe_elem2_neq_zero() -> Bool {
  match oracle_out().skip(n: 2).first() {
    Present { value: v } => v != 0
    Absent => true
  }
}

fn probe_elem2_plus_one() -> Int {
  match oracle_out().skip(n: 2).first() {
    Present { value: v } => v + 1
    Absent => 0 - 999
  }
}

fn probe_elem_fn_eq() -> Bool {
  gunbc.accelerator_demo_eval.eval_relu_mul_add_elem_at_index(ai: 0, bi: 7, ci: 0 - 3) == 0
}

fn probe_elem_via_firsts_eq() -> Bool {
  match [0].first() {
    Present { value: ai } =>
      match [7].first() {
        Present { value: bi } =>
          match [0 - 3].first() {
            Present { value: ci } =>
              gunbc.accelerator_demo_eval.eval_relu_mul_add_elem_at_index(ai: ai, bi: bi, ci: ci) == 0
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

fn probe_concat_elem_eq() -> Bool {
  match concat([], [gunbc.accelerator_demo_eval.eval_relu_mul_add_elem_at_index(ai: 0, bi: 7, ci: 0 - 3)]).first() {
    Present { value: v } => v == 0
    Absent => false
  }
}

fn probe_fold_direct_eq() -> Bool {
  match gunbc.accelerator_demo_eval.eval_pure_map_at_indices(
    ops: gunbc.accelerator_demo_program.relu_mul_add_ops,
    a: [0], b: [7], c: [0 - 3], acc: []
  ).first() {
    Present { value: v } => v == 0
    Absent => false
  }
}

fn my_fold(
  ops: List<gunbc.accelerator_demo_program.ElementwiseArrayOp>,
  a: List<Int>,
  b: List<Int>,
  c: List<Int>,
  acc: List<Int>
) -> List<Int> {
  if !gunbc.accelerator_demo_program.pure_elementwise_ops_shape_recognizable(ops: ops) {
    []
  } else {
    match a.first() {
      Absent => acc
      Present { value: ai } =>
        match b.first() {
          Absent => acc
          Present { value: bi } =>
            match c.first() {
              Absent => acc
              Present { value: ci } =>
                my_fold(
                  ops: ops,
                  a: a.skip(n: 1),
                  b: b.skip(n: 1),
                  c: c.skip(n: 1),
                  acc: concat(
                    acc,
                    [gunbc.accelerator_demo_eval.eval_relu_mul_add_elem_at_index(ai: ai, bi: bi, ci: ci)]
                  )
                )
            }
        }
    }
  }
}

fn probe_my_fold_eq() -> Bool {
  match my_fold(ops: gunbc.accelerator_demo_program.relu_mul_add_ops, a: [0], b: [7], c: [0 - 3], acc: []).first() {
    Present { value: v } => v == 0
    Absent => false
  }
}
