      program: gunbc.accelerator_demo_program.relu_mul_add_pure_program,
      a: gunbc.accelerator_demo_realize.demo_fixture_a(),
      b: gunbc.accelerator_demo_realize.demo_fixture_b(),
      c: gunbc.accelerator_demo_realize.demo_fixture_c()
    ),
    right: gunbc.accelerator_demo_realize.demo_fixture_expected()
  )
}

fn probe_eq_literals() -> Bool {
