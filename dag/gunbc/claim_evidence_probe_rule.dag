module gunbc.claim_evidence_probe_rule


fn infer_probe_evidence<F, C, A, FidelityBoundary>(
  fact: RecordedFact<F>,
  direction: std.claim_evidence.EvidenceDirection,
  inference_rule: std.claim_evidence.InferenceRuleId,
  authority: A,
  provenance: std.claim_evidence.EvidenceProvenance,
  freshness: std.claim_evidence.EvidenceFreshness<C>,
  fidelity: EvidenceFidelity<FidelityBoundary>,
  probe: gunbc.readback_independence.ReadBackProbe,
) -> EvidenceInference<F, C, A, FidelityBoundary, ReadBackProbe> {
  let supports = evidence_direction_fold(
    direction: direction,
    fold: std.claim_evidence.EvidenceDirectionFold {
      supports: true,
      challenges: false,
    },
  )
  let probe_is_independent = probe_effect_on_subject_fold(
    effect: probe.effect_on_subject,
    fold: gunbc.readback_independence.ProbeEffectOnSubjectFold {
      inert: true,
      may_establish: fn(_) { false },
      answers_without_subject: fn(_) { false },
      unknown: fn(_) { false },
    },
  )
  if supports && !probe_is_independent {
    insufficient_evidence_inference(
      insufficiency: std.claim_evidence.EvidenceInsufficiency {
        fact: fact,
        claim: freshness.maximum_conclusion,
        inference_rule: inference_rule,
        probe_independence: probe,
        reason: "a positive result from this probe may establish the subject it reports",
      },
    )
  } else {
    applicable_evidence_inference(
      link: std.claim_evidence.EvidenceLink {
        fact: fact,
        direction: direction,
        inference_rule: inference_rule,
        authority: authority,
        provenance: provenance,
        freshness: freshness,
        fidelity: fidelity,
        probe_independence: probe,
      },
    )
  }
}
