module gunbc.physics.which_path_four_model_comparison


// Slice B kernel: cross CompositionModel (ClassicalExclusiveProbabilityMixture | CoherentAlternativeComposition) with DisclosureAxis (PassivePathDisclosure | DistinguishableRecordChangesCoherence). All four prediction cells execute; single-axis variation cannot reconcile both cited Chapman visibility observations. Path ontology underdetermined — no which-path labels.
type CompositionModel
  = ClassicalExclusiveProbabilityMixture
  | CoherentAlternativeComposition

type DisclosureAxis
  = PassivePathDisclosure
  | DistinguishableRecordChangesCoherence

type FourModelPredictionCell
  = ClassicalPassiveCell
  | ClassicalDistinguishableCell
  | CoherentPassiveCell
  | CoherentDistinguishableCell

fn disclosure_axis_from_record(
  record: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.WhichPathDistinguishabilityRecord,
) -> DisclosureAxis {
  match record {
    extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.DistinguishableWhichPathRecordNotProduced => PassivePathDisclosure
    extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.DistinguishableWhichPathRecordProduced => DistinguishableRecordChangesCoherence
  }
}

fn predict_interference_visibility(
  composition: CompositionModel,
  disclosure: DisclosureAxis,
) -> extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisibility {
  match composition {
    ClassicalExclusiveProbabilityMixture =>
      extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
    CoherentAlternativeComposition =>
      match disclosure {
        PassivePathDisclosure => extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisible
        DistinguishableRecordChangesCoherence => extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
      }
  }
}

fn four_model_cell_prediction(
  cell: FourModelPredictionCell,
) -> extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisibility {
  match cell {
    ClassicalPassiveCell =>
      predict_interference_visibility(
        composition: ClassicalExclusiveProbabilityMixture,
        disclosure: PassivePathDisclosure,
      )
    ClassicalDistinguishableCell =>
      predict_interference_visibility(
        composition: ClassicalExclusiveProbabilityMixture,
        disclosure: DistinguishableRecordChangesCoherence,
      )
    CoherentPassiveCell =>
      predict_interference_visibility(
        composition: CoherentAlternativeComposition,
        disclosure: PassivePathDisclosure,
      )
    CoherentDistinguishableCell =>
      predict_interference_visibility(
        composition: CoherentAlternativeComposition,
        disclosure: DistinguishableRecordChangesCoherence,
      )
  }
}

fn all_four_model_predictions_execute() -> Bool {
  four_model_cell_prediction(cell: ClassicalPassiveCell) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
    && four_model_cell_prediction(cell: ClassicalDistinguishableCell) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
    && four_model_cell_prediction(cell: CoherentPassiveCell) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisible
    && four_model_cell_prediction(cell: CoherentDistinguishableCell) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
}

fn composition_axis_predictions_differ_at_passive_disclosure() -> Bool {
  predict_interference_visibility(
    composition: ClassicalExclusiveProbabilityMixture,
    disclosure: PassivePathDisclosure,
  ) != predict_interference_visibility(
    composition: CoherentAlternativeComposition,
    disclosure: PassivePathDisclosure,
  )
}

fn disclosure_axis_predictions_differ_at_coherent_composition() -> Bool {
  predict_interference_visibility(
    composition: CoherentAlternativeComposition,
    disclosure: PassivePathDisclosure,
  ) != predict_interference_visibility(
    composition: CoherentAlternativeComposition,
    disclosure: DistinguishableRecordChangesCoherence,
  )
}

fn classical_disclosure_variation_cannot_explain_visible_passive() -> Bool {
  predict_interference_visibility(
    composition: ClassicalExclusiveProbabilityMixture,
    disclosure: PassivePathDisclosure,
  ) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
    && predict_interference_visibility(
      composition: ClassicalExclusiveProbabilityMixture,
      disclosure: DistinguishableRecordChangesCoherence,
    ) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
}

fn coherent_disclosure_variation_explains_both_cited_visibilities() -> Bool {
  predict_interference_visibility(
    composition: CoherentAlternativeComposition,
    disclosure: PassivePathDisclosure,
  ) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisible
    && predict_interference_visibility(
      composition: CoherentAlternativeComposition,
      disclosure: DistinguishableRecordChangesCoherence,
    ) == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeAbsent
}

fn single_axis_change_insufficient_for_cited_visibility_pair() -> Bool {
  composition_axis_predictions_differ_at_passive_disclosure()
    && disclosure_axis_predictions_differ_at_coherent_composition()
    && classical_disclosure_variation_cannot_explain_visible_passive()
    && coherent_disclosure_variation_explains_both_cited_visibilities()
}

fn cited_row_matches_coherent_prediction(
  record: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.WhichPathDistinguishabilityRecord,
  visibility: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisibility,
) -> Bool {
  predict_interference_visibility(
    composition: CoherentAlternativeComposition,
    disclosure: disclosure_axis_from_record(record: record),
  ) == visibility
}

fn cited_row_matches_classical_prediction(
  record: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.WhichPathDistinguishabilityRecord,
  visibility: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.InterferenceFringeVisibility,
) -> Bool {
  predict_interference_visibility(
    composition: ClassicalExclusiveProbabilityMixture,
    disclosure: disclosure_axis_from_record(record: record),
  ) == visibility
}
