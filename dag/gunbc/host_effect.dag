module gunbc.host_effect

import std.types { String, Int, NonEmptyStr }
import std.access { AccessDecision }
import extdeps.bmc.types { RedfishSystemAction }
import gunbc.fleet_intent { ComputeHost }
import std.effects {
  EffectShape,
  ReadEffect,
  AppendEffect,
  IdempotencyEvidence,
  LatticeEffect,
  IdentityEffect,
  NonIdempotent,
  is_idempotent_effect,
}

type HostEffect =
    ShellCommand { script: String }
  | RedfishAction { action: RedfishSystemAction }

type NodeControlPlane =
    HostOs { node: ComputeHost }
  | BmcController { node: ComputeHost }

type Drive = OneShot | ConvergeLoop

type HostEffectTransport =
    LocalShell
  | SshShell { ssh_host: NonEmptyStr }

type HostEffectIntent {
  target: NodeControlPlane
  effect: HostEffect
  evidence: IdempotencyEvidence
  transport: HostEffectTransport
  privilege_denial: AccessDecision?
}

type HostEffectEvidence =
    ShellEffectApplied { exit_code: Int, stdout: String }

fn host_effect_drive_from_evidence(evidence: IdempotencyEvidence) -> Drive {
  match evidence {
    IdentityEffect => OneShot
    LatticeEffect { shape: shape } =>
      if is_idempotent_effect(shape: shape) {
        OneShot
      } else {
        ConvergeLoop
      }
    NonIdempotent { shape: _, reason: _ } => ConvergeLoop
  }
}

fn host_effect_drive(intent: HostEffectIntent) -> Drive {
  host_effect_drive_from_evidence(evidence: intent.evidence)
}

data host_effect_identity_evidence: IdempotencyEvidence = IdentityEffect

data host_effect_read_evidence: IdempotencyEvidence = LatticeEffect { shape: ReadEffect }

data host_effect_converge_loop_evidence: IdempotencyEvidence = NonIdempotent {
  shape: AppendEffect,
  reason: "converge to fixpoint — external redrive until observed state matches desired",
}

fn host_effect_lattice_evidence(shape: EffectShape) -> IdempotencyEvidence {
  LatticeEffect { shape: shape }
}
