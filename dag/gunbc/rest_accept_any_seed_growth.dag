module gunbc.rest_accept_any_seed_growth

import std.decl_ref {
  DeclarationRef, WholeDeclaration,
}
import std.types { String }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }

data rest_accept_any_seed_growth_note: String = "Seed-growth obligation for the interpreter's accept-any TLS verifier (RestAcceptAnyVerifier + rest_accept_any_agent), added by PR #10215 (curl/Lane A migration). Homed here, beside the obligation it declares, rather than inside gunbc.seed_growth_admission, which owns the ROSTER and the join.\n\nWHAT THE CHANGE IS. dispatch_rest in v1_interpreter.rs realizes transport rest's tls: InsecureAcceptAnyCert posture via an accept-any rustls verifier and a ureq Agent configured with it, selected ONLY for operations declaring that posture (absent = VerifyPeer, the fail-closed default). Before this change, the interpreter refused InsecureAcceptAnyCert as emit-only (2026-07-16 ruling). The emitted reqwest path is unchanged.\n\nWHY IT PASSES THE PURPOSE TEST, stated so the row can be reasoned about without re-reading the PR. The redfish operations (extdeps/bmc/http.dag GetServiceRoot, GetSystem, GetChassisSensors, GetPower, GetThermal) are the only declared consumers of this posture; all five carry tls: InsecureAcceptAnyCert. These same operations already realize the TLS bypass in the interpreter today, through curl's -k flag — the interpreter dispatches a subprocess with hand-typed curl argv. Realizing InsecureAcceptAnyCert in-process for the SAME operations removes the subprocess and argv indirection without widening the population that bypasses verification. It serves the v2 self-host program by unblocking the curl argv → transport rest migration (gunbc.plans.transport_argv_anemia_dissolution Lane A), which clears corpus debt and reduces the shell-transport census.\n\nHOW THE DECLARATIONS WERE MEASURED. By reading the diff at the commit that added them. Both are free functions, so the citable count and the real count are both two; nothing here lands in seed_growth_uncitable_item_keys. The Cargo.toml rustls dependency addition is a manifest entry, not a Rust declaration, and is covered by the current_boundary field rather than enumerated here.\n\nENUMERATED RATHER THAN COUNTED, per the carrier's own rule: one row per declaration the join counts against, so a later author removing or renaming an item deletes its row in the same motion."

data rest_accept_any_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.v1_interpreter" as NonEmptyStr,
      decl_name: "RestAcceptAnyVerifier" as NonEmptyStr,
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.v1_interpreter" as NonEmptyStr,
      decl_name: "rest_accept_any_agent" as NonEmptyStr,
      field: WholeDeclaration
    },
  ],
  reason: "The interpreter's accept-any TLS verifier for InsecureAcceptAnyCert rest transport rows. RestAcceptAnyVerifier is the zero-assertion ServerCertVerifier; rest_accept_any_agent builds the ureq Agent. Both are selected ONLY for operations declaring tls: InsecureAcceptAnyCert (absent = VerifyPeer, fail-closed). The trait impl (impl rustls::client::danger::ServerCertVerifier for RestAcceptAnyVerifier with 4 methods: verify_server_cert, verify_tls12_signature, verify_tls13_signature, supported_verify_schemes) is forced by the rustls trait and each method is uncitable as a DeclarationRef — noted here, not enumerated in seed_growth_uncitable_item_keys. 6 hand items total: 2 citable + 4 uncitable. This change CREATES the first N=5 declared consumers of InsecureAcceptAnyCert in extdeps/bmc/http.dag (GetServiceRoot, GetSystem, GetChassisSensors, GetPower, GetThermal). Those same 5 operations already bypass TLS via curl -k in the interpreter's subprocess path on origin/main (verified: every argv among the 5 carried -k). The no-widening claim is: the REDFISH REQUESTS that bypass TLS are unchanged; what changes is that 5 of 8 ops declare it as a modeled posture rather than spell it by hand. The 3 remaining shell ops (SetAccountPassword, SetBootSourceOverride, ResetSystem) still carry -k by hand and are named here as the residual.",
  owning_dissolution_lane: "transport-argv-anemia-dissolution" as RoadmapNodeId,
  trigger: "Retired when NO operation in extdeps/bmc/http.dag reaches an accept-any TLS path — neither through the interpreter's accept-any agent nor through a hand-authored -k in a curl argv — because all 8 operations are served by emitted reqwest realizations. The trigger names the CAPABILITY (all-declarative TLS posture, making interpreter-side accept-any and hand-authored -k both unnecessary), not an artifact.",
  current_boundary: "src/v1/stage0/src/v1_interpreter.rs (RestAcceptAnyVerifier struct + 4 trait methods + rest_accept_any_agent + rest_tls_posture_interp_disposition Option<Agent> return + dispatch_rest accept-any agent match); src/v1/stage0/Cargo.toml (rustls = \"0.23\"); dag/extdeps/bmc/http.dag (5 rest-transport ops + 3 shell-transport ops)"
}
