module gunbc.rest_accept_any_seed_growth

import std.decl_ref {
  DeclarationRef, WholeDeclaration,
}
import std.types { String }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }

// Seed-growth obligation for the interpreter's accept-any TLS verifier (RestAcceptAnyVerifier +
// rest_accept_any_agent), added by PR #10215 (curl/Lane A migration). Homed here, beside the
// obligation it declares, rather than inside gunbc.seed_growth_admission, which owns the ROSTER
// and the join.
//
// WHAT THE CHANGE IS: see the SeedGrowthJustification reason field below. The declaration
// method is described there rather than re-stated in prose.

data rest_accept_any_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.v1_interpreter" as NonEmptyStr,
      decl_name: "RestAcceptAnyVerifier" as NonEmptyStr,
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.v1_interpreter" as NonEmptyStr,
      decl_name: "rest_accept_any_agent" as NonEmptyStr,
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.v1_interpreter" as NonEmptyStr,
      decl_name: "param_name_matches_declared" as NonEmptyStr,
      field: WholeDeclaration
    },
  ],
  reason: "The interpreter's accept-any TLS verifier for InsecureAcceptAnyCert rest transport rows. RestAcceptAnyVerifier is the zero-assertion ServerCertVerifier; rest_accept_any_agent builds the ureq Agent. Both are selected ONLY for operations declaring tls: InsecureAcceptAnyCert (absent = VerifyPeer, fail-closed). The trait impl (impl rustls::client::danger::ServerCertVerifier for RestAcceptAnyVerifier with 4 methods: verify_server_cert, verify_tls12_signature, verify_tls13_signature, supported_verify_schemes) is forced by the rustls trait and each method is uncitable as a DeclarationRef — enumerated in seed_growth_uncitable_item_keys as standing roster entries; the scanner also projects them for this change, because a standing entry and a change projection are different populations that coincide only in the admitting change. 7 hand items total: 3 citable + 4 uncitable. This change CREATES the first N=5 declared consumers of InsecureAcceptAnyCert in extdeps/bmc/http.dag (GetServiceRoot, GetSystem, GetChassisSensors, GetPower, GetThermal). Those same 5 operations already bypass TLS via curl -k in the interpreter's subprocess path on origin/main (verified: every argv among the 5 carried -k). The no-widening claim is: the REDFISH REQUESTS that bypass TLS are unchanged; what changes is that 5 of 8 ops declare it as a modeled posture rather than spell it by hand. The 3 remaining shell ops (SetAccountPassword, SetBootSourceOverride, ResetSystem) still carry -k by hand and are named here as the residual.",
  owning_dissolution_lane: "transport-argv-anemia-dissolution" as RoadmapNodeId,
  trigger: "Retired when NO operation in extdeps/bmc/http.dag reaches an accept-any TLS path — neither through the interpreter's accept-any agent nor through a hand-authored -k in a curl argv — because all 8 operations are served by emitted reqwest realizations. The trigger names the CAPABILITY (all-declarative TLS posture, making interpreter-side accept-any and hand-authored -k both unnecessary), not an artifact.",
  current_boundary: "v1_compiler.v1_interpreter [RestAcceptAnyVerifier, rest_accept_any_agent, rest_tls_posture_interp_disposition, dispatch_rest accept-any agent match] + 4 uncitable trait methods in seed_growth_uncitable_item_keys; Cargo.toml rustls entry; dag/extdeps/bmc/http.dag (5 rest-transport ops + 3 shell-transport ops)"
}
