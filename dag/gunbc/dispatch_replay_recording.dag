module gunbc.dispatch_replay_recording

import std.types { String, NonEmptyStr, List, Bool, Int, FilePath }
import std.algebra { trim }
import extdeps.git
import extdeps.git.plumbing
import extdeps.git.plumbing {
  GitRepositoryAddress,
  GitWorktreeAt,
  GitParents,
  GitCreateRefIfAbsent,
  GitRefMutationOutcome,
  GitRefMutationApplied,
  GitRefMutationPreconditionNotHeld,
  GitRefMutationExecutionRefused,
  GitRefMutationObservationRefused,
  GitRefMutationReadBackMismatch,
  git_ref_mutation_outcome,
  git_ref_mutation_applied,
}
import extdeps.git.object_store { GitRefName, GitObjectId, git_object_id_from_untagged_hex, git_object_id_wire_hex }
import extdeps.systemd.service_exec { ServiceResult, ServiceResultSuccess, ServiceResultExitCode, service_result_of_wire }
import std.decl_ref { decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import gunbc.devboot.transport { devboot_repo_address, devboot_observe_ref }
import gunbc.roadmap.roadmap_attempt_exit_spool {
  AttemptExitRecord,
  AttemptProcessExitedWith,
  AttemptProcessSignaled,
}

// A RECORDING IS A COMPLETED ATTEMPT'S END STATE, CAPTURED BY THE CONTROLLER (the replay executor, DESIGN 3 pairing
// obligation). A recording is the receipt that a real worker emitted this shape: its base, the tree it left, and
// how its unit ended. A hand-authored fixture would owe a separate claim that a real worker emits that shape;
// a recording owes none ONCE recording_capture runs, which is why the replay executor takes recordings and nothing else.
//
// DECLARED FRONTIER: recording_capture has no executing consumer on the production path in this change; until it
// does, a recording can only be written by hand and the 'owes none' claim above is NOT yet established. The
// tracking authority is the frontier row below (dispatch_replay_recording_frontier_rows), read by
// gunbc.census_closure_frontier; until it dissolves, the lab operator captures a recording with the entry
// gunbc.dispatch_replay_capture srv1_lab_recording_capture_cli, which reads one completed attempt's own records.
//
// WHERE IT LIVES: refs/gunbc/recordings/<RecordingId> in the controller's repository, a commit whose tree is the
// result tree and whose single parent is the base. The existing refs/gunbc/ consumers are named single refs
// (the admitted-revision pointers of gunbc.roadmap.roadmap_dashboard_instance) and the devboot request and produced
// namespaces; this prefix is disjoint from each, so no existing consumer reads or races a recording.
//
// WHO WRITES IT: recording_capture, run by the controller as the controller's own account. A worker unit's
// ReadWritePaths never include the controller's repository ref store, and the ref is written create-only, so a
// recording can be neither forged nor moved by the process it later constrains.
//
// THE ID IS ITS PREIMAGE, NOT A HASH OF IT: <base>.<result tree>.<exit status>.<manager result>. The same facts are
// the same recording and any differing fact is a different ref, so one recording is one fact by construction and
// replay reads the facts back out of the id it was given without a second record that could disagree. The two
// objects are git's own GitObjectId (extdeps.git.object_store), so an id whose base or tree is not an object id
// has no value; they become hex only in the id text and in git argv.
type RecordingId {
  base: GitObjectId
  result_tree: GitObjectId
  end: RecordedEnd
}

// HOW THE RECORDED UNIT ENDED, as the only two shapes a replay can reproduce by exiting: exit 0 with the manager's
// 'success', or a nonzero status with 'exit-code'. Every other ServiceResult (signal, timeout, oom-kill, ...)
// was not an end by exiting and has no arm here, so the manager result is derived from the arm, never stored
// beside a status it could contradict. The status of RecordedExitCode is admitted only by recorded_end_of
// (1..255 and not the replay refusal code); the type does not yet bound an Int to that interval.
type RecordedEnd
  = RecordedSuccess
  | RecordedExitCode { status: Int }

fn recorded_end_status(end: RecordedEnd) -> Int {
  match end {
    RecordedSuccess => 0
    RecordedExitCode { status } => status
  }
}

fn recorded_end_manager_result(end: RecordedEnd) -> ServiceResult {
  match end {
    RecordedSuccess => ServiceResultSuccess
    RecordedExitCode { status: _ } => ServiceResultExitCode
  }
}

data recording_ref_prefix: String = "refs/gunbc/recordings/"

// Assembled from parts because the braces of git's peel syntax are interpolation in a string literal.
data recording_peel_to_tree_suffix: String = join(["^", "{", "tree", "}"], "")

data recording_id_separator: String = "."

data recorded_success_word: String = "success"

data recorded_exit_code_word: String = "exit-code"

fn recorded_end_word(end: RecordedEnd) -> String {
  match end {
    RecordedSuccess => recorded_success_word
    RecordedExitCode { status: _ } => recorded_exit_code_word
  }
}

fn recording_object_hex(oid: GitObjectId) -> String {
  git_object_id_wire_hex(oid: oid) as String
}

fn recording_id_text(id: RecordingId) -> String {
  join(
    [
      recording_object_hex(oid: id.base),
      recording_id_separator,
      recording_object_hex(oid: id.result_tree),
      recording_id_separator,
      to_string(value: recorded_end_status(end: id.end)),
      recording_id_separator,
      recorded_end_word(end: id.end),
    ],
    "",
  )
}

fn recording_ref_of(id: RecordingId) -> String {
  concat(recording_ref_prefix, recording_id_text(id: id))
}

// The exit code a replay REFUSAL exits with. The exit record keeps only the status, so a recording that carried this
// status would read the same downstream as a refused replay; the end constructor refuses it, typed.
data replay_refusal_exit_code: Int = 78

// THE ONE ADMISSION of a recorded end, shared by the id decode and by capture: a status and a manager result
// become a RecordedEnd only when replaying by exiting reproduces both.
type RecordedEndUnreplayable
  = RecordedEndOutOfRange { status: Int }
  | RecordedEndCollidesWithReplayRefusal { status: Int }
  | RecordedEndPairNotReproducible { status: Int, manager_result: ServiceResult }

type RecordedEndAdmission
  = RecordedEndAdmitted { end: RecordedEnd }
  | RecordedEndRefused { cause: RecordedEndUnreplayable }

fn recorded_end_of(status: Int, result: ServiceResult) -> RecordedEndAdmission {
  if status < 0 || status > 255 {
    RecordedEndRefused { cause: RecordedEndOutOfRange { status: status } }
  } else if status == replay_refusal_exit_code {
    RecordedEndRefused { cause: RecordedEndCollidesWithReplayRefusal { status: status } }
  } else if status == 0 && result == ServiceResultSuccess {
    RecordedEndAdmitted { end: RecordedSuccess }
  } else if status != 0 && result == ServiceResultExitCode {
    RecordedEndAdmitted { end: RecordedExitCode { status: status } }
  } else {
    RecordedEndRefused { cause: RecordedEndPairNotReproducible { status: status, manager_result: result } }
  }
}

fn recorded_end_unreplayable_reason(cause: RecordedEndUnreplayable) -> String {
  match cause {
    RecordedEndOutOfRange { status: _ } => "the exit status is outside 0..255, which no process exit can carry"
    RecordedEndCollidesWithReplayRefusal { status: _ } =>
      "the exit status is the replay refusal code, which an exit record could not tell from a refused replay"
    RecordedEndPairNotReproducible { status: _, manager_result: _ } =>
      "the manager result does not follow from the exit status, so replaying by exiting could not reproduce it"
  }
}

type RecordingIdDecode
  = RecordingIdDecoded { id: RecordingId }
  | RecordingIdMalformed { text: String, reason: String }

fn recording_id_part(parts: List<String>, index: Int) -> String {
  match parts.get(index) {
    Present { value: v } => v
    Absent => ""
  }
}

fn recording_id_decode(text: String) -> RecordingIdDecode {
  let parts = text.split(delimiter: recording_id_separator)
  if count(parts) != 4 {
    RecordingIdMalformed { text: text, reason: join(["a recording id has four '.'-separated parts (base, result tree, exit status, manager result); this has ", to_string(value: count(parts))], "") }
  } else {
    match git_object_id_from_untagged_hex(hex: recording_id_part(parts: parts, index: 0)) {
      Absent => RecordingIdMalformed { text: text, reason: "the base part is not a git object id" }
      Present { value: base } =>
        match git_object_id_from_untagged_hex(hex: recording_id_part(parts: parts, index: 1)) {
          Absent => RecordingIdMalformed { text: text, reason: "the result tree part is not a git object id" }
          Present { value: tree } =>
            match parse_int(text: recording_id_part(parts: parts, index: 2)) {
              Absent => RecordingIdMalformed { text: text, reason: "the exit status part is not a number" }
              Present { value: status } =>
                match recorded_end_of(status: status, result: service_result_of_wire(word: recording_id_part(parts: parts, index: 3))) {
                  RecordedEndRefused { cause } => RecordingIdMalformed { text: text, reason: recorded_end_unreplayable_reason(cause: cause) }
                  RecordedEndAdmitted { end } => RecordingIdDecoded { id: RecordingId { base: base, result_tree: tree, end: end } }
                }
            }
        }
    }
  }
}

type RecordingCaptureRefusal
  = RecordingCaptureExitSignaled
  | RecordingCaptureExitUnreplayable { cause: RecordedEndUnreplayable }
  | RecordingCaptureObjectUnusable { object: String, detail: String }
  | RecordingCaptureAlreadyRecorded { ref_name: String }
  | RecordingCaptureWriteRefused { ref_name: String, detail: String }

type RecordingCapture
  = RecordingCaptured { id: RecordingId, ref_name: String }
  | RecordingCaptureRefused { cause: RecordingCaptureRefusal }

fn recording_capture_write(repo_root: String, id: RecordingId) -> RecordingCapture {
  let committed = git.Plumbing.CommitTree(
    address: devboot_repo_address(repo_root: repo_root),
    tree: recording_object_hex(oid: id.result_tree),
    parents: GitParents { first: git_object_id_wire_hex(oid: id.base), remaining: [] },
    message: concat("replay recording ", recording_id_text(id: id)),
  )
  if !(committed.exit_code == 0) {
    RecordingCaptureRefused { cause: RecordingCaptureWriteRefused { ref_name: recording_ref_of(id: id), detail: trim(s: committed.stderr) } }
  } else {
    let commit_hex = trim(s: committed.commit)
    match git_object_id_from_untagged_hex(hex: commit_hex) {
      Absent =>
        RecordingCaptureRefused { cause: RecordingCaptureWriteRefused { ref_name: recording_ref_of(id: id), detail: "commit-tree returned an object id this capture cannot decode" } }
      Present { value: commit_oid } =>
        let mutation = GitCreateRefIfAbsent { name: recording_ref_of(id: id) as GitRefName, new: commit_oid }
        let attempted = git.Plumbing.CreateRefIfAbsent(
          address: devboot_repo_address(repo_root: repo_root),
          ref_name: recording_ref_of(id: id),
          new: commit_hex,
        )
        let outcome = git_ref_mutation_outcome(
          mutation: mutation,
          exit_code: attempted.exit_code,
          stderr: trim(s: attempted.stderr),
          observed_after: devboot_observe_ref(repo_root: repo_root, ref_name: recording_ref_of(id: id)),
        )
        if git_ref_mutation_applied(outcome: outcome) {
          RecordingCaptured { id: id, ref_name: recording_ref_of(id: id) }
        } else {
          match outcome {
            GitRefMutationPreconditionNotHeld { mutation: _, observed: _ } =>
              RecordingCaptureRefused { cause: RecordingCaptureAlreadyRecorded { ref_name: recording_ref_of(id: id) } }
            GitRefMutationApplied { mutation: _ } =>
              RecordingCaptureRefused { cause: RecordingCaptureWriteRefused { ref_name: recording_ref_of(id: id), detail: "applied outcome read as not applied" } }
            GitRefMutationExecutionRefused { mutation: _, exit_code: _, stderr } =>
              RecordingCaptureRefused { cause: RecordingCaptureWriteRefused { ref_name: recording_ref_of(id: id), detail: stderr } }
            GitRefMutationObservationRefused { mutation: _, exit_code: _, stderr } =>
              RecordingCaptureRefused { cause: RecordingCaptureWriteRefused { ref_name: recording_ref_of(id: id), detail: stderr } }
            GitRefMutationReadBackMismatch { mutation: _, observed: _ } =>
              RecordingCaptureRefused { cause: RecordingCaptureWriteRefused { ref_name: recording_ref_of(id: id), detail: "the ref does not hold the recording commit after the write" } }
          }
        }
    }
  }
}

// THE CAPTURE OPERATION over a completed attempt's durable records: the base the belt recorded
// (spawn-destination.json), the result commit the belt committed, and the unit's exit record. It reads the result
// commit's tree from the object store rather than accepting a tree from the caller, so the recorded tree is the
// tree of a commit that exists.
fn recording_capture(repo_root: String, base_sha: String, result_commit: String, exit: AttemptExitRecord) -> RecordingCapture {
  match exit.end {
    AttemptProcessSignaled { signal: _ } => RecordingCaptureRefused { cause: RecordingCaptureExitSignaled }
    AttemptProcessExitedWith { status } =>
      match recorded_end_of(status: status, result: exit.result) {
        RecordedEndRefused { cause } => RecordingCaptureRefused { cause: RecordingCaptureExitUnreplayable { cause: cause } }
        RecordedEndAdmitted { end } =>
          match git_object_id_from_untagged_hex(hex: base_sha) {
            Absent =>
              RecordingCaptureRefused { cause: RecordingCaptureObjectUnusable { object: base_sha, detail: "the base is not a git object id" } }
            Present { value: base } =>
              recording_capture_read_tree(repo_root: repo_root, base: base, result_commit: result_commit, end: end)
          }
      }
  }
}

// The result tree is read only after the base is admitted as an object id, so capture never mints an id the decode
// would reject.
fn recording_capture_read_tree(repo_root: String, base: GitObjectId, result_commit: String, end: RecordedEnd) -> RecordingCapture {
  let tree_read = git.Plumbing.ObserveRef(
    address: devboot_repo_address(repo_root: repo_root),
    ref_name: concat(result_commit, recording_peel_to_tree_suffix),
  )
  match git_object_id_from_untagged_hex(hex: trim(s: tree_read.revision)) {
    Absent =>
      RecordingCaptureRefused { cause: RecordingCaptureObjectUnusable { object: result_commit, detail: trim(s: tree_read.stderr) } }
    Present { value: tree } =>
      recording_capture_write(repo_root: repo_root, id: RecordingId { base: base, result_tree: tree, end: end })
  }
}

// REPLAY IS EXACT OR REFUSES. The attempt's base must equal the recording's base byte for byte: no rebase, no
// merge, no 'close enough'. The comparison is the whole admission, so a mismatch is the typed cause below and
// nothing downstream of it runs.
type RecordingReplayAdmission
  = RecordingReplayAdmitted { id: RecordingId }
  | RecordingReplayBaseMismatch { recorded_base: String, attempt_base: String }

fn recording_replay_admission(id: RecordingId, attempt_base: String) -> RecordingReplayAdmission {
  if recording_object_hex(oid: id.base) == attempt_base {
    RecordingReplayAdmitted { id: id }
  } else {
    RecordingReplayBaseMismatch { recorded_base: recording_object_hex(oid: id.base), attempt_base: attempt_base }
  }
}

data dispatch_replay_recording_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.dispatch_replay_recording", decl_name: "recording_capture"),
    reason: "recording_capture is not yet bound to a completed attempt's belt step; until it is, its executing consumer is the operator-run entry gunbc.dispatch_replay_capture srv1_lab_recording_capture_cli over one completed attempt's records",
    dissolution: unbound_dissolution(description: "No production path captures a recording: recording_capture's only caller in this tree is the operator-run entry srv1_lab_recording_capture_cli, and no belt step calls it. UNBOUND ON PURPOSE -- dissolution_status decides a bound condition by asking whether a named declaration is present, and a new CALLER appearing is not a declaration the model can test, so retires_dissolution would read Fired today (the reference it names is absent). TRIGGER: a belt step of a completed lab attempt invokes recording_capture over that attempt's own durable records. SUFFICIENT FOR deleting this row."),
  ),
]
