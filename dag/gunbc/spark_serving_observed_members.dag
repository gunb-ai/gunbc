module gunbc.spark_serving_observed_members


// THE OBSERVED SIDE OF THE FOUR-MEMBER POPULATION.
//
// WHAT THIS REPLACES. `spark_serving_desired_members` builds the full desired population -- runtime
// root, user unit, primary model slot, linger -- and until now it had ZERO production consumers. The
// live plan was `spark_serving_linger_membership_plan`, whose desired side is the single-element list
// `[spark_serving_desired_linger_member(host)]`. So three of the four modeled members were never
// planned, and the three unrealized install effects that act on them could never be SELECTED however
// well they were implemented. Adding executor arms above a linger-only plan is
// specification-without-execution: it typechecks, it witnesses green, and it converges nothing.
//
// The desired side already exists and is correct. What was missing is the observed side, which is
// what this module supplies, plus the plan that reconciles the two (gunbc.spark_serving_converge_plan
// `spark_serving_full_membership_plan`).
//
// PER-ADDRESS IDENTITIES, NOT ONE FUSED DIGEST. An earlier revision put
// `serialize_content_hash(loaded.digest)` -- the aggregate over the WHOLE release -- into BOTH the
// runtime-root and the model-slot member, while desired carries `runtime.closure_digest` and
// `model.identity` separately. Two consequences, and the first made convergence unreachable: neither
// observed digest could ever equal its desired counterpart, so a correctly installed host reported
// both members changed forever and the plan never emptied; and the two observed members carried the
// SAME value as each other, which is wrong on its face because two distinct addresses cannot share
// one state. The components were never missing -- `derive_loaded_spark_serving_release` produces
// them and the observation used to discard them, so the repair was to stop fusing at the source.
//
// THE PROJECTION IS FROM AN OBSERVATION, NEVER FROM THE DESIRED STATE. Deriving an observed member's
// state digest from the desired release would make every member reconcile as converged by
// construction -- the reconcile would compare a value to itself and the plan would always be empty.
// That is the failure this whole lane exists to avoid, so the desired release is deliberately NOT a
// parameter of the observed projection.

// WHAT AN OBSERVATION CAN AND CANNOT ESTABLISH, as a typed value rather than an assumption.
//
// `SparkServingObserved` carries a `SparkServingReleaseIdentity` -- one digest over the runtime and
// model the host actually has loaded. That is enough to state the runtime and model members. It says
// NOTHING about the unit file's bytes: the live observer reads LoadState and is-active, not the
// file's content and not `is-enabled`.
//
// So a converged-looking host cannot yet have its user-unit member OBSERVED, and this type says so
// instead of guessing. `UserUnitStateUnobserved` is not a failure -- it is the honest answer for an
// observation that did not carry those bytes, and it keeps "we did not look" separate from "the unit
// is absent", which have different remedies and must not collapse.
type SparkServingObservedUnitState
  = UserUnitStateObserved { unit_state_digest: std.types.NonEmptyStr }
  | UserUnitStateAbsent
  | UserUnitStateUnobserved

// Linger is observed by its own slice over a separate probe, so it arrives beside the serving
// observation rather than inside it.
type SparkServingObservedLingerState
  = LingerObservedEnabled
  | LingerObservedDisabled
  | LingerUnobservedState

type SparkServingObservedMemberProjection
  = SparkServingObservedMembers { members: List<gunbc.spark_serving_membership.SparkServingMember>, unit_observed: Bool }
  | SparkServingObservedMembersRefused { cause: String }

// A member is present in the OBSERVED list only when something was actually observed to be there.
// Absence from the list is what makes `membership_reconcile` plan an addition, so an unobserved
// member must not be listed -- listing it with a placeholder digest would either fabricate a state
// or plan a change against a value nobody measured.
fn spark_serving_observed_linger_members(
  host: product.placement_supply.HostIdentity,
  linger: SparkServingObservedLingerState,
) -> List<gunbc.spark_serving_membership.SparkServingMember> {
  match linger {
    LingerObservedEnabled => [
      gunbc.spark_serving_membership.spark_serving_member(
        host: host,
        principal: gunbc.spark_serving_membership.spark_serving_serving_principal(),
        address: gunbc.spark_serving_membership.SparkServingLingerAddress,
        state_digest: gunbc.spark_serving_membership.spark_serving_executor_linger_state_digest(),
        ownership: gunbc.ownership.Ensured,
      ),
    ]
    LingerObservedDisabled => []
    LingerUnobservedState => []
  }
}

fn spark_serving_observed_unit_members(
  host: product.placement_supply.HostIdentity,
  unit: SparkServingObservedUnitState,
) -> List<gunbc.spark_serving_membership.SparkServingMember> {
  match unit {
    UserUnitStateObserved { unit_state_digest: d } => [
      gunbc.spark_serving_membership.spark_serving_member(
        host: host,
        principal: gunbc.spark_serving_membership.spark_serving_serving_principal(),
        address: gunbc.spark_serving_membership.SparkServingUserUnitAddress,
        state_digest: d,
        ownership: gunbc.ownership.Owned,
      ),
    ]
    UserUnitStateAbsent => []
    UserUnitStateUnobserved => []
  }
}

// THE PROJECTION.
//
// `SparkServingAbsent` is a real observation, not ignorance: the host was reached and the serving
// runtime is not there. So the runtime and model members are genuinely absent and the plan should
// add them -- which is exactly the bare-srv6 path this lane needs.
//
// `SparkServingObservationRefused` is the opposite and refuses the whole projection: an observation
// that could not be made cannot be rendered as "nothing is there", which would narrow the plan to
// nothing and silently converge a host we never saw. That is the empty-observation narrow DESIGN
// names, and it is the mirror of the absorbing fallback.
//
// `unit_observed` travels beside the members so a consumer can tell a plan built on a complete
// observation from one built on a partial one, without inferring it from list length.
fn spark_serving_observed_members(
  observation: gunbc.spark_serving_release.SparkServingObservation,
  unit: SparkServingObservedUnitState,
  linger: SparkServingObservedLingerState,
) -> SparkServingObservedMemberProjection {
  match observation {
    SparkServingObservationRefused { host: h, cause: cause } =>
      SparkServingObservedMembersRefused {
        cause: join([
          "spark serving observed members refused for host=", h as String,
          ": the observation itself was refused (", cause as String,
          "), and an observation that could not be made must not be rendered as an empty population",
        ], ""),
      }
    SparkServingAbsent { host: h } =>
      SparkServingObservedMembers {
        members: concat(
          spark_serving_observed_unit_members(host: h, unit: unit),
          spark_serving_observed_linger_members(host: h, linger: linger),
        ),
        unit_observed: spark_serving_unit_state_was_observed(unit: unit),
      }
    SparkServingObserved { host: h, loaded_release: loaded } =>
      SparkServingObservedMembers {
        members: concat(
          [
            gunbc.spark_serving_membership.spark_serving_member(
              host: h,
              principal: gunbc.spark_serving_membership.spark_serving_serving_principal(),
              address: gunbc.spark_serving_membership.SparkServingRuntimeRootAddress,
              state_digest: loaded.runtime.closure_digest,
              ownership: gunbc.ownership.Owned,
            ),
            gunbc.spark_serving_membership.spark_serving_member(
              host: h,
              principal: gunbc.spark_serving_membership.spark_serving_serving_principal(),
              address: gunbc.spark_serving_membership.SparkServingModelSlotAddress { slot: gunbc.spark_serving_membership.spark_serving_primary_model_slot },
              state_digest: std.content_hash.serialize_content_hash(hash: loaded.model.identity) as std.types.NonEmptyStr,
              ownership: gunbc.ownership.Owned,
            ),
          ],
          concat(
            spark_serving_observed_unit_members(host: h, unit: unit),
            spark_serving_observed_linger_members(host: h, linger: linger),
          ),
        ),
        unit_observed: spark_serving_unit_state_was_observed(unit: unit),
      }
  }
}

fn spark_serving_unit_state_was_observed(unit: SparkServingObservedUnitState) -> Bool {
  match unit {
    UserUnitStateObserved { unit_state_digest: _ } => true
    UserUnitStateAbsent => true
    UserUnitStateUnobserved => false
  }
}

// A plan built while the unit member was never looked at cannot honestly report convergence: the
// unit would be planned as an addition on every run, so a second plan can never be empty. Consumers
// that care about the empty-replan bar read this rather than re-deriving it.
fn spark_serving_projection_supports_empty_replan(
  projection: SparkServingObservedMemberProjection,
) -> Bool {
  match projection {
    SparkServingObservedMembersRefused { cause: _ } => false
    SparkServingObservedMembers { members: _, unit_observed: observed } => observed
  }
}
