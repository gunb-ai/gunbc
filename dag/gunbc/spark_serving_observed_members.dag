module gunbc.spark_serving_observed_members

import std.types { Bool, List, NonEmptyStr, String }
import product.placement_supply { HostIdentity }
import gunbc.ownership { Owned, Ensured }
import gunbc.spark_serving_release {
  SparkServingObservation,
  SparkServingObserved,
  SparkServingAbsent,
  SparkServingObservationRefused,
}
import extdeps.systemd.systemctl { systemctl_user_is_enabled_argv }
import gunbc.spark_serving_install_paths { spark_serving_user_unit_path }
import gunbc.spark_serving_unit_identity { spark_serving_unit_name }
import gunbc.spark_serving_unit_render {
  spark_serving_user_unit_content_identity,
}
import gunbc.ollama_runtime_bundle {
  RuntimeMaterializationObservation,
  runtime_materialization_state_digest,
  runtime_materialization_was_observed,
  ModelStoreObservation,
  model_store_state_digest,
  model_store_was_observed,
}
import gunbc.spark_serving_membership {
  SparkServingMember,
  SparkServingRuntimeRootAddress,
  SparkServingUserUnitAddress,
  SparkServingModelSlotAddress,
  SparkServingLingerAddress,
  spark_serving_member,
  spark_serving_primary_model_slot,
  spark_serving_serving_principal,
  spark_serving_executor_linger_state_digest,
  spark_serving_user_unit_state_digest,
}

// THE OBSERVED SIDE OF THE FOUR-MEMBER POPULATION.
//
// WHAT THIS REPLACES. `spark_serving_desired_members` builds the full desired population -- runtime
// root, user unit, primary model slot, linger -- and until now it had ZERO production consumers. The
// live plan was `spark_serving_linger_membership_plan`, whose desired side is the single-element list
// `[spark_serving_desired_linger_member(host)]`. So three of the four modeled members were never
// planned, and the three unrealized install effects that act on them could never be SELECTED however
// well they were implemented. Adding executor arms above a linger-only plan is
// specification-without-execution: it typechecks, it witnesses green, and it converges nothing.
//
// The desired side already exists and is correct. What was missing is the observed side, which is
// what this module supplies, plus the plan that reconciles the two (gunbc.spark_serving_converge_plan
// `spark_serving_full_membership_plan`).
//
// PER-ADDRESS IDENTITIES, NOT ONE FUSED DIGEST. An earlier revision put
// `serialize_content_hash(loaded.digest)` -- the aggregate over the WHOLE release -- into BOTH the
// runtime-root and the model-slot member, while desired carries `runtime.closure_digest` and
// `model.identity` separately. Two consequences, and the first made convergence unreachable: neither
// observed digest could ever equal its desired counterpart, so a correctly installed host reported
// both members changed forever and the plan never emptied; and the two observed members carried the
// SAME value as each other, which is wrong on its face because two distinct addresses cannot share
// one state. The components were never missing -- `derive_loaded_spark_serving_release` produces
// them and the observation used to discard them, so the repair was to stop fusing at the source.
//
// THE PROJECTION IS FROM AN OBSERVATION, NEVER FROM THE DESIRED STATE. Deriving an observed member's
// state digest from the desired release would make every member reconcile as converged by
// construction -- the reconcile would compare a value to itself and the plan would always be empty.
// That is the failure this whole lane exists to avoid, so the desired release is deliberately NOT a
// parameter of the observed projection.

// WHAT AN OBSERVATION CAN AND CANNOT ESTABLISH, as a typed value rather than an assumption.
//
// `SparkServingObserved` carries a `SparkServingReleaseIdentity` -- one digest over the runtime and
// model a RUNNING server reports. An earlier revision of this comment said that was enough to state
// the runtime and model members; it was not, and believing it is what put a process's self-report
// behind two members keyed on bytes at rest. It says nothing about the runtime root's extraction,
// nothing about the model store's blob closure, and nothing about the unit file's bytes -- the live
// observer reads LoadState and is-active, not content and not `is-enabled`.
//
// So a converged-looking host cannot yet have its user-unit member OBSERVED, and this type says so
// instead of guessing. `UserUnitStateUnobserved` is not a failure -- it is the honest answer for an
// observation that did not carry those bytes, and it keeps "we did not look" separate from "the unit
// is absent", which have different remedies and must not collapse.
type SparkServingObservedUnitState
  = UserUnitStateObserved { unit_state_digest: NonEmptyStr }
  | UserUnitStateAbsent
  | UserUnitStateUnobserved

// Linger is observed by its own slice over a separate probe, so it arrives beside the serving
// observation rather than inside it.
type SparkServingObservedLingerState
  = LingerObservedEnabled
  | LingerObservedDisabled
  | LingerUnobservedState

type SparkServingObservedMemberProjection
  = SparkServingObservedMembers { members: List<SparkServingMember>, runtime_observed: Bool, model_observed: Bool, unit_observed: Bool, registration_observed: Bool, enablement_observed: Bool, linger_observed: Bool }


// A member is present in the OBSERVED list only when something was actually observed to be there.
// Absence from the list is what makes `membership_reconcile` plan an addition, so an unobserved
// member must not be listed -- listing it with a placeholder digest would either fabricate a state
// or plan a change against a value nobody measured.
fn spark_serving_observed_linger_members(
  host: HostIdentity,
  linger: SparkServingObservedLingerState,
) -> List<SparkServingMember> {
  match linger {
    LingerObservedEnabled => [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingLingerAddress,
        state_digest: spark_serving_executor_linger_state_digest(),
        ownership: Ensured,
      ),
    ]
    LingerObservedDisabled => []
    LingerUnobservedState => []
  }
}

fn spark_serving_observed_unit_members(
  host: HostIdentity,
  unit: SparkServingObservedUnitState,
) -> List<SparkServingMember> {
  match unit {
    UserUnitStateObserved { unit_state_digest: d } => [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingUserUnitAddress,
        state_digest: d,
        ownership: Owned,
      ),
    ]
    UserUnitStateAbsent => []
    UserUnitStateUnobserved => []
  }
}

// THE RUNTIME ROOT IS OBSERVED FROM THE FILESYSTEM, NOT FROM A RUNNING PROCESS.
//
// It used to be projected from `loaded.runtime.closure_digest` -- a value derived by joining
// `/api/version` with the archive-admission receipt. That pair proves a running server reported a
// version and an archive was once downloaded and digest-admitted. It does not prove the runtime root
// was extracted, placed, or published correctly, which is precisely what the runtime-root ADDRESS is
// about. A host whose root is half-extracted while a previously-installed server still answers would
// have reported the runtime member converged.
//
// The two facts also have different lifetimes: a runtime can be perfectly materialized with nothing
// running, and a process can answer long after its root was corrupted underneath it. Reading the
// address from the thing the address names is what makes a host mid-install observable at all --
// which is the property whose absence made every partial state unhealable.
//
// This is why the runtime member is projected in BOTH observation arms. `SparkServingAbsent` means no
// serving runtime answered, not that nothing is on disk; deriving the runtime member from the serving
// observation would have made a materialized-but-not-running root indistinguishable from a bare host.
fn spark_serving_observed_runtime_members(
  host: HostIdentity,
  runtime: RuntimeMaterializationObservation,
) -> List<SparkServingMember> {
  match runtime_materialization_state_digest(observation: runtime) {
    Absent => []
    Present { value: d } => [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingRuntimeRootAddress,
        state_digest: d,
        ownership: Owned,
      ),
    ]
  }
}

// THE MODEL SLOT IS OBSERVED FROM THE STORE ON DISK, for the same reason the runtime root is.
//
// It was projected from `loaded.model.identity` -- the model a RUNNING server reports having loaded.
// That is a fact about a process's current state, not about the address the member names, and the
// two come apart in both directions that matter here. A host can hold a complete manifest and blob
// closure with nothing running, which is a materialized model slot reporting as absent; and a server
// can report a loaded model whose blobs were since removed underneath it, which is an absent slot
// reporting as converged. The second is the dangerous one, because it is the state a plan would
// decline to repair.
//
// Reading the address from the thing the address names also makes the no-repull law derivable rather
// than asserted: an exact manifest identity plus a complete blob closure IS the observed digest, so
// it equals desired and reconcile emits no action. Nothing has to check whether a pull is needed --
// the pull is simply not planned, which is the construction form of the law rather than a guard in
// front of it.
//
// Projected in BOTH arms, since a materialized store with no serving process is a real state.
fn spark_serving_observed_model_members(
  host: HostIdentity,
  store: ModelStoreObservation,
) -> List<SparkServingMember> {
  match model_store_state_digest(observation: store) {
    Absent => []
    Present { value: d } => [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingModelSlotAddress { slot: spark_serving_primary_model_slot },
        state_digest: d,
        ownership: Owned,
      ),
    ]
  }
}

// THE PROJECTION.
//
// `SparkServingAbsent` is a real observation, not ignorance: the host was reached and the serving
// runtime is not there. So the runtime and model members are genuinely absent and the plan should
// add them -- which is exactly the bare-srv6 path this lane needs.
//
// `SparkServingObservationRefused` is the opposite and refuses the whole projection: an observation
// that could not be made cannot be rendered as "nothing is there", which would narrow the plan to
// nothing and silently converge a host we never saw. That is the empty-observation narrow DESIGN
// names, and it is the mirror of the absorbing fallback.
//
// `unit_observed` travels beside the members so a consumer can tell a plan built on a complete
// observation from one built on a partial one, without inferring it from list length.
// MEMBERSHIP TAKES A HOST, NOT A SERVING OBSERVATION, and removing that parameter is the fix.
//
// This took the aggregate SparkServingObservation and refused the WHOLE projection on
// SparkServingObservationRefused. That looked fail-closed and was not: the serving observation is
// about whether the API answers, and an unavailable API says nothing whatever about bytes on disk.
// So an inactive unit or an unreachable endpoint erased runtime, model, unit, enablement and linger
// facts that had each been independently established -- and with the members gone, ordinary
// reconciliation could not select the start or enable that would have fixed it. The state
//
//     resources converged, serving unhealthy
//
// is real and common, and it was unrepresentable: the observation that proves it is the one that
// deleted the evidence.
//
// The parameter is gone rather than its refusal arm being softened, and that follows from something
// already true here: once every member came from the evidence for its own address, the Observed and
// Absent arms produced identical populations. The observation was contributing exactly one fact --
// which host -- so it is now asked for exactly that.
//
// WHAT STILL REFUSES, because this must not read as removing a wall. Each subject carries its own
// refusal: an SSH leg that could not run yields RuntimeMaterializationObservationRefused,
// ModelStoreObservationRefused, or an Unobserved unit/enablement/linger state, and the plan refuses
// on those. Host unreachability therefore still stops actuation -- through the probes that actually
// looked, rather than through an API check that never did.
//
// Serving health does not disappear; it moves to where it belongs. Whether /api/version agrees,
// whether the planned model is loaded, whether a generation returns exactly "pong" -- those are
// terminal evidence asked AFTER the resource plan is empty, of the running system. Conflating them
// with membership is what let a process vouch for a filesystem, and then veto it.
fn spark_serving_observed_members(
  host: HostIdentity,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  unit: SparkServingObservedUnitState,
  enablement: SparkServingUnitManagerState,
  linger: SparkServingObservedLingerState,
) -> SparkServingObservedMemberProjection {
  spark_serving_reached_host_members(
    host: host, runtime: runtime, store: store, unit: unit, enablement: enablement, linger: linger,
  )
}


fn spark_serving_reached_host_members(
  host: HostIdentity,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  unit: SparkServingObservedUnitState,
  enablement: SparkServingUnitManagerState,
  linger: SparkServingObservedLingerState,
) -> SparkServingObservedMemberProjection {
  SparkServingObservedMembers {
    members: concat(
      concat(
        spark_serving_observed_runtime_members(host: host, runtime: runtime),
        spark_serving_observed_model_members(host: host, store: store),
      ),
      concat(
        concat(
          spark_serving_observed_unit_members(host: host, unit: unit),
          concat(
            spark_serving_observed_unit_registration_members(
              host: host, manager: enablement, unit: unit,
            ),
            spark_serving_observed_unit_enablement_members(host: host, manager: enablement),
          ),
        ),
        spark_serving_observed_linger_members(host: host, linger: linger),
      ),
    ),
    runtime_observed: runtime_materialization_was_observed(observation: runtime),
    model_observed: model_store_was_observed(observation: store),
    unit_observed: spark_serving_unit_state_was_observed(unit: unit),
    registration_observed: spark_serving_registration_was_observed(manager: enablement),
    enablement_observed: spark_serving_enablement_was_observed(manager: enablement),
    linger_observed: spark_serving_linger_state_was_observed(linger: linger),
  }

}

// AN UNOBSERVED LINGER IS NOT A DISABLED LINGER. Both project to the empty member list -- absence is
// what makes reconcile plan a change -- so on the members alone the two are indistinguishable, and a
// FAILED probe would select the privileged enable-linger effect. That is the empty-observation
// narrow selecting an actuation, which is worse than the merely-uncovered form: the remedy for
// "linger is off" is to enable it, and the remedy for "we could not ask" is to stop.
//
// The completeness fact therefore travels beside the members exactly as the unit's does, and the
// consumer refuses on it. It is NOT repaired by filtering the member list, because a projection that
// dropped the member would still be reporting a population it could not vouch for.
// ENABLEMENT CARRIES ITS OWN COMPLETENESS FACT. It used to borrow `unit_observed=false` as an
// indirect refusal wall, which only worked because the content classifier was erasing itself on the
// enablement's behalf. With the subjects separated, each owes its own answer to "was this measured".
fn spark_serving_enablement_was_observed(manager: SparkServingUnitManagerState) -> Bool {
  match manager {
    UserUnitManagerEnabled => true
    UserUnitManagerDisabled => true
    UserUnitManagerNotRegistered => true
    UserUnitManagerUnobserved => false
  }
}

// Registration is established by exactly the same probe, so its completeness bit is the same
// question asked of the same answer. It is stated separately rather than shared because the two are
// now separate subjects, and a future registration probe that does not come from is-enabled must not
// silently inherit enablement's completeness.
fn spark_serving_registration_was_observed(manager: SparkServingUnitManagerState) -> Bool {
  match manager {
    UserUnitManagerEnabled => true
    UserUnitManagerDisabled => true
    UserUnitManagerNotRegistered => true
    UserUnitManagerUnobserved => false
  }
}

fn spark_serving_linger_state_was_observed(linger: SparkServingObservedLingerState) -> Bool {
  match linger {
    LingerObservedEnabled => true
    LingerObservedDisabled => true
    LingerUnobservedState => false
  }
}

fn spark_serving_unit_state_was_observed(unit: SparkServingObservedUnitState) -> Bool {
  match unit {
    UserUnitStateObserved { unit_state_digest: _ } => true
    UserUnitStateAbsent => true
    UserUnitStateUnobserved => false
  }
}

// A plan built while the unit member was never looked at cannot honestly report convergence: the
// unit would be planned as an addition on every run, so a second plan can never be empty. Consumers
// that care about the empty-replan bar read this rather than re-deriving it.
fn spark_serving_projection_supports_empty_replan(
  projection: SparkServingObservedMemberProjection,
) -> Bool {
  match projection {
    SparkServingObservedMembers {
      members: _,
      runtime_observed: rt_seen,
      model_observed: model_seen,
      unit_observed: observed,
      registration_observed: reg_seen,
      enablement_observed: enab_seen,
      linger_observed: linger_seen,
    } => rt_seen && model_seen && observed && reg_seen && enab_seen && linger_seen
  }
}

// ── Observing the unit, so `unit_observed` can stop being false ─────────────────────────────────

// THE PROBE READS THE FILE'S BYTES, because the member's state IS the unit's content. The live
// observer reads LoadState and is-active, and neither answers what this member is keyed on: a unit
// can be loaded and active while its file on disk differs from the desired spec, which is precisely
// the drift the member exists to catch.
// IT READS THEM BASE64-ENCODED, because the channel that carries the answer trims.
//
// `cat` was correct about intent and impossible in practice. The shell transport delivers stdout
// through `retained_utf8_lossy_trimmed`, so the bytes of any file ending in whitespace cannot arrive
// intact -- and a systemd unit always ends in a newline. Measured on srv6: the destination held
// exactly the declared 500 bytes and the observation saw 499, so the content member compared unequal
// to itself and planned a rewrite on every run, forever. That is worse than a failure: the host was
// right, the observation was wrong, and the plan could never admit convergence.
//
// base64 -w 0 emits one line whose only trailing whitespace is the newline the trim removes, so the
// payload survives the channel exactly. The identity is still taken over the file's bytes on both
// sides -- the desired side encodes the same way -- so this is a wire encoding, not a change of what
// is being identified. No verdict semantics, no identity relative to desired, no second domain.
//
// If base64 is absent or rejects -w, the leg fails and the state is Unobserved, which refuses the
// plan. That is the correct arm: an unreadable unit must not be planned as an absent one.
fn spark_serving_user_unit_read_argv() -> List<String> {
  ["base64", "-w", "0", spark_serving_user_unit_path() as String]
}

fn spark_serving_user_unit_is_enabled_argv() -> List<String> {
  systemctl_user_is_enabled_argv(unit: spark_serving_unit_name as NonEmptyStr)
}

// CLASSIFYING THE READ, without ever deriving the answer from the desired state.
//
// The comparison is against the rendered desired text, and that is legitimate rather than circular:
// the digest is NOT copied from the desired member. What is observed is a byte equality, which is a
// real measurement of the file on disk. Equal bytes establish that the address holds the desired
// spec, so the observed member carries the same digest and reconciles as converged; different bytes
// carry a digest OF THE OBSERVED CONTENT, which differs and reconciles as a change.
//
// The distinction that matters: a failed read is NOT absence. `cat` exits non-zero both when the
// file is missing and when it cannot be read, and only the first means the member is absent. Since
// the two have different remedies -- write the unit, versus fix why it is unreadable -- a failed
// read stays `UserUnitStateUnobserved` and never collapses into `UserUnitStateAbsent`.
// systemd's own answers, modeled rather than collapsed. `is-enabled` exits non-zero for a DISABLED
// unit and for a unit that does not exist, and treating every nonzero exit as infrastructure failure
// would render a perfectly healthy disabled unit as unobservable.
// ONE PROBE, TWO FACTS. `systemctl --user is-enabled` answers about the manager, and its answer
// establishes two separate subjects: whether a unit is REGISTERED with the manager at all, and, only
// when it is, whether that unit is ENABLED. This type is the manager's raw answer -- it is named for
// what it is rather than for one of the two facts derived from it, because calling it an enablement
// while it carries a not-registered arm is what let absence-of-subject reconcile as a change to the
// subject.
type SparkServingUnitManagerState
  = UserUnitManagerEnabled
  | UserUnitManagerDisabled
  | UserUnitManagerNotRegistered
  | UserUnitManagerUnobserved

// CLASSIFYING THE READ, with the identity taken over bytes on BOTH sides.
//
// There is no equality arm: the observed identity is always the identity of what was read. Equality
// with desired therefore FALLS OUT of byte equality rather than being imported, which is what keeps
// the two sides in one identity domain. An earlier revision returned the desired spec's digest when
// bytes matched, so the same file on disk changed identity whenever desired state changed.
//
// ENABLEMENT IS PART OF THE MEMBER'S STATE, not a separate readout. A unit whose bytes are exactly
// right but which is DISABLED will not survive a reboot, so reporting it as matching desired would
// claim a convergence that the next power cycle refutes. It is folded into the identity, so a
// disabled unit is drift rather than a match.
//
// A failed read is NOT absence: `cat` exits non-zero both when the file is missing and when it
// cannot be read, and only the first means the member is absent. The remedies differ -- write the
// unit, versus fix why it is unreadable -- so they stay distinct states.
// THE CONTENT CLASSIFIER READS ONLY THE FILE-READ EVIDENCE.
//
// It took the manager answer, and its unobserved arm turned a SUCCESSFULLY READ FILE into
// UserUnitStateUnobserved -- so failing to observe one subject erased an established fact about a
// different one. Splitting the member addresses did not fix that; it left the collapse one level up,
// in the classifier, where a subject's own evidence is the only thing entitled to decide it.
//
// A read that succeeded establishes the content. Whether the unit is enabled is a separate question
// answered by separate evidence, and its failure scopes to its own member.
fn classify_observed_user_unit(
  read_succeeded: Bool,
  read_stdout: String,
  file_absent: Bool,
) -> SparkServingObservedUnitState {
  if read_succeeded {
    UserUnitStateObserved {
      unit_state_digest: spark_serving_user_unit_content_identity(wire_base64: read_stdout),
    }
  } else {
    if file_absent { UserUnitStateAbsent } else { UserUnitStateUnobserved }
  }
}

// THE ENABLEMENT MEMBER, projected from the same probe but as its own fact.
//
// The content identity above is now identity-of-bytes on both sides with nothing folded in, so
// exact bytes match exact bytes whatever the enablement. Enablement answers separately here, and a
// disabled-but-correct unit therefore plans EnableUserUnit alone rather than a rewrite plus reload.
//
// Unobserved projects to no member at all, exactly as the other unobserved states do: absence from
// the observed list is what makes reconcile plan a change, so a member nobody measured must not
// appear -- and the projection's completeness bit is what stops that absence being read as drift.
// NOT REGISTERED PRODUCES NO ENABLEMENT MEMBER, AND THAT IS THE WHOLE POINT.
//
// Enablement is meaningful only over a unit the manager knows about. When the manager answers
// not-found there is no enablement fact to report -- not an unknown one, and not a not-registered
// one. Reporting a member here is what made an absent subject reconcile as a CHANGE at the
// enablement address, which then selected enable as the remedy for a unit that had never been
// written. The remedies differ (a registered-but-disabled unit needs enable; an unregistered one
// needs write, reload, then enable), so one member could never have carried both.
//
// This is NOT the unobserved arm wearing another name. The host answered; a real fact was
// established. It is simply a fact about REGISTRATION, and it is reported there.
fn spark_serving_observed_unit_enablement_members(
  host: HostIdentity,
  manager: SparkServingUnitManagerState,
) -> List<SparkServingMember> {
  match manager {
    UserUnitManagerUnobserved => []
    UserUnitManagerNotRegistered => []
    UserUnitManagerEnabled => [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingUserUnitEnablementAddress,
        state_digest: spark_serving_user_unit_enabled_state,
        ownership: Owned,
      ),
    ]
    UserUnitManagerDisabled => [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingUserUnitEnablementAddress,
        state_digest: spark_serving_user_unit_disabled_state,
        ownership: Owned,
      ),
    ]
  }
}

// REGISTRATION NAMES THE DEFINITION THE MANAGER HOLDS, NOT MERELY THAT IT HOLDS ONE.
//
// Writing new bytes does not change what systemd already loaded, so registered is not by itself a
// converged state: a manager holding a stale definition and one holding the current definition both
// answer enabled. The observed state therefore carries the digest of the file actually on disk, and
// the desired state carries the desired digest, so staleness is an ordinary member difference rather
// than a special check -- and reload is selected exactly when the manager has not consumed the bytes
// we want it to have.
//
// The identity is a function of OBSERVATIONS ONLY. Defining freshness as observed-equals-desired
// would import the answer this projection exists to establish, which is the error recorded on the
// content classifier above.
//
// Registered with no file on disk is its own observed state. It is neither absence nor staleness
// against known bytes, and folding it into either would claim something that was not measured.
fn spark_serving_observed_unit_registration_members(
  host: HostIdentity,
  manager: SparkServingUnitManagerState,
  unit: SparkServingObservedUnitState,
) -> List<SparkServingMember> {
  match manager {
    UserUnitManagerUnobserved => []
    UserUnitManagerNotRegistered => [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingUserUnitRegistrationAddress,
        state_digest: spark_serving_user_unit_not_registered_state,
        ownership: Owned,
      ),
    ]
    UserUnitManagerEnabled =>
      spark_serving_registered_member_for_content(host: host, unit: unit)
    UserUnitManagerDisabled =>
      spark_serving_registered_member_for_content(host: host, unit: unit)
  }
}

// A manager that holds a definition while the content probe could not read the file establishes no
// freshness fact: the bytes it consumed are unknown, so the honest projection is no member rather
// than a guess in either direction.
fn spark_serving_registered_member_for_content(
  host: HostIdentity,
  unit: SparkServingObservedUnitState,
) -> List<SparkServingMember> {
  match unit {
    UserUnitStateObserved { unit_state_digest: d } => [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingUserUnitRegistrationAddress,
        state_digest: spark_serving_user_unit_registration_state(content_digest: d),
        ownership: Owned,
      ),
    ]
    UserUnitStateAbsent => [
      spark_serving_member(
        host: host,
        principal: spark_serving_serving_principal(),
        address: SparkServingUserUnitRegistrationAddress,
        state_digest: spark_serving_user_unit_registered_without_content_state,
        ownership: Owned,
      ),
    ]
    UserUnitStateUnobserved => []
  }
}

