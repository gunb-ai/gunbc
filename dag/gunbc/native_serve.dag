module gunbc.native_serve

import std.types { Int, List, String, Bool, CommitSha }
import std.measure { ByteSize, byte_size, byte_size_count, Millisecond, millisecond, millisecond_count, Second, second }
import std.algebra { Cons, Empty, trim, list_push }
import extdeps.http.server { ServeWireResponse, ServeWireHeader }
import extdeps.tailscale.identity { tailscale_user_login_header }
import gunbc.serve_liveness { serve_liveness_path, serve_liveness_document }

// THE NATIVE SERVE DOOR: EVERYTHING A SERVED REQUEST DECIDES, AS FOLDS THE RENDERED MAIN CALLS.
//
// std.compiler_entry NativeIngressDriver is the arm; this module is the request half of its
// contract, and gunbc.http_ingress is the binding half. The rendered main
// (v1.compiler.emit_rust emit_native_ingress_driver_main_rs) performs only what no fold can -- read
// argv into the binding constructor's declared arguments, bind and accept the listener, read bytes
// off the connection within the limits the contract hands it, call the handler, write the response
// value back -- and every decision between those reads and writes is a fold: which address to bind,
// which release this process is and what its deadline is (gunbc.http_ingress
// http_ingress_native_contract, over the binding the exact constructor returned), whether a request
// head is admissible and how many body bytes to read (native_serve_frame), and whether the request is
// answered before the handler is entered (native_serve_route). The handler contract is the seed's
// whole one: the handler's request parameters are planned by gunbc.http_ingress http_ingress_fact_plan
// over the binding's listener, exactly as the seed's realization plans them, followed by zero or one
// startup value from the exact startup declaration (a realization fact, not a request fact), and the
// combined signature is judged before any bind (gunbc.http_ingress http_ingress_native_contract;
// gunbc.plans.converged_ingress M2b). The listener is TCP or a unix socket whose every peer the
// kernel attests; peer_user is read off the accepted connection, never from the request.
//
// WHERE THIS DOOR IS BETTER THAN THE SEED'S, WHICH IS THE BAR (gunbc.design_argument::self_hosting):
// - the 40-hex release check is the binding constructor's (gunbc.http_ingress http_ingress_binding,
//   over gunbc.running_release_identity release_revision_text_valid, the predicate that reads the
//   identity back off the wire), not a second hand-Rust copy of it;
// - head and body limits and the read timeout are VALUES in the contract the main reads, and the
//   startup announcement prints them, where the seed buried them as `const`s inside its reader;
// - every 400 is a typed refusal produced here, with the reason it names, not a Rust format string;
// - /livez is answered from gunbc.serve_liveness serve_liveness_document, so the path and the
//   member names are read from the graph rather than restated in hand Rust. The seed's ingress
//   realization answers it from the same document (gunbc.http_ingress
//   http_ingress_pre_evaluation_routes).
// - the per-request budget: one effective deadline, armed when the request head is complete,
//   covers framing, the admitted body read, argument construction, the handler and response
//   rendering. A compiled handler cannot be unwound in-process, so a request that crosses the
//   deadline with the handler still running is answered with native_serve_deadline_refused and the
//   process then exits with native_serve_deadline_exit_code for its supervisor to restart: the
//   timed-out computation ends with the process rather than surviving abandoned (operator decision
//   2026-11-04, exit-after-timeout).

// The seed's limits, carried as values in the units std.measure owns. They are the seed's numbers
// because the served programs were written against them; a change to either is a change to every
// served program's contract.
data native_serve_head_limit: ByteSize = byte_size(count: 16384)
data native_serve_body_limit: ByteSize = byte_size(count: 1048576)
data native_serve_read_timeout: Millisecond = millisecond(count: 10000)

// The default bound on a worker generation's STARTUP readiness. A program descriptor that names a
// startup fold states its own bound (std.compiler_entry NativeIngressStartup bound); this value is the
// one a descriptor with no startup carries, where nothing waits on it. Sized from the measured
// device-crypto self-check, about 0.5 s for the sha256 of the binary and about 60 ms per P-256 verify,
// with ~40x headroom for a loaded host. A worker that has not finished its startup by then is the
// modeled startup refusal (exit native_serve_startup_refused_exit_code).
data native_serve_startup_deadline: Second = second(count: 30)

// EX_TEMPFAIL (sysexits.h 75): a temporary condition a restart is expected to clear. The process
// exits with it after answering a request that crossed its deadline, because the compiled handler it
// abandoned cannot be stopped any other way.
data native_serve_deadline_exit_code: Int = 75

// The identity header is extdeps.tailscale.identity's fact (the header Tailscale Serve sets), read
// from there rather than restated; Content-Length is RFC 9110 section 8.6's.
data native_serve_content_length_header: String = "Content-Length"

data native_serve_text_plain: String = "text/plain; charset=utf-8"
data native_serve_application_json: String = "application/json; charset=utf-8"

// THE CONTRACT ONE NATIVE PROCESS SERVES UNDER, derived from the binding its exact constructor
// returned (gunbc.http_ingress http_ingress_native_contract), never parsed from a second argv.
// cpu_limit and wall_limit are the binding's declared budgets; request_deadline is the one effective
// deadline the native door enforces, their minimum: a single thread that stops at it has spent no
// more CPU and no more wall time than either bound, and the process exit after a crossing is what
// makes "stops at it" true. handler_identity is the module-qualified handler the binding names, which
// /livez reports. Which address to bind is the binding's listener, carried beside this contract
// (gunbc.http_ingress HttpIngressNativeStart), never restated in it.
type NativeServeContract {
  release_revision: CommitSha
  handler_identity: String
  head_limit: ByteSize
  body_limit: ByteSize
  read_timeout: Millisecond
  cpu_limit: Millisecond
  wall_limit: Millisecond
  request_deadline: Millisecond
  startup_deadline: Second
}

fn native_serve_announcement(c: NativeServeContract, bound_host: String, bound_port: Int) -> String {
  join([
    "native-serve listening on ", bound_host, ":", to_string(value: bound_port),
    " release_revision=", c.release_revision as String,
    " handler=", c.handler_identity,
    " head_limit_bytes=", to_string(value: byte_size_count(b: c.head_limit)),
    " body_limit_bytes=", to_string(value: byte_size_count(b: c.body_limit)),
    " read_timeout_ms=", to_string(value: millisecond_count(m: c.read_timeout)),
    " declared_cpu_limit_ms=", to_string(value: millisecond_count(m: c.cpu_limit)),
    " declared_wall_limit_ms=", to_string(value: millisecond_count(m: c.wall_limit)),
    " effective_native_deadline_ms=", to_string(value: millisecond_count(m: c.request_deadline)),
  ], "")
}

// ── FRAMING: THE HEAD THE MAIN READ, JUDGED HERE ─────────────────────────────────────────────
// The main hands over the request line and the header lines exactly as read (line terminators
// stripped), having enforced only the byte limit it was given. Everything those lines MEAN is
// decided below: the method and origin-form target, which headers are duplicated, how many body
// bytes follow, and the identity header. The body length is returned so the main reads exactly
// that many bytes and no more; the main never reads a header itself.

// `headers` is every header field as read, in arrival order, so a handler contract that declares
// the request's headers (gunbc.http_ingress IngressFactRequestHeaders) reads them from the same
// parse that judged them, never from a second reader.
type NativeServeRequestHead {
  method: String
  target: String
  tailscale_identity: String
  headers: List<NativeServeHeaderField>
}

// The Authorization value a handler receives is DERIVED from the head's header fields, never
// stored beside them (one authority for one fact). The framing fold has already refused a
// duplicated Authorization header, so the first value is the only one; absent is "".
fn native_serve_authorization(head: NativeServeRequestHead) -> String {
  match native_serve_named(fields: head.headers, wanted: "Authorization") |> first { Present { value: v } => v Absent => "" }
}

type NativeServeFrame
  = NativeServeFramed { head: NativeServeRequestHead, body_length: Int }
  | NativeServeFrameRefused { response: ServeWireResponse }

fn native_serve_bad_request(reason: String) -> NativeServeFrame {
  NativeServeFrameRefused { response: ServeWireResponse {
    status: 400,
    content_type_label: native_serve_text_plain,
    body: concat("bad request: ", concat(reason, "\n")),
    headers: [],
  } }
}

fn ascii_lower_code_point(cp: Int) -> Int {
  if cp >= 65 && cp <= 90 { cp + 32 } else { cp }
}

// RFC 9110 section 5.1: field names are case-insensitive. Compared code point by code point with
// ASCII case folded on both sides, so no lowercased copy of every header is built.
fn field_name_is_from(name: String, wanted: String, i: Int) -> Bool {
  if i >= string_length(s: wanted) {
    true
  } else if ascii_lower_code_point(cp: code_point(substring(s: name, start: i, end: i + 1))) != ascii_lower_code_point(cp: code_point(substring(s: wanted, start: i, end: i + 1))) {
    false
  } else {
    field_name_is_from(name: name, wanted: wanted, i: i + 1)
  }
}

fn field_name_is(name: String, wanted: String) -> Bool {
  string_length(s: name) == string_length(s: wanted) && field_name_is_from(name: name, wanted: wanted, i: 0)
}

type NativeServeHeaderField {
  name: String
  value: String
}

type NativeServeHeaderParse
  = NativeServeHeaderParsed { field: NativeServeHeaderField }
  | NativeServeHeaderMalformed { line: String }

fn native_serve_header(line: String) -> NativeServeHeaderParse {
  match split(s: line, delimiter: ":") {
    Cons { head: name, tail: rest } =>
      match rest {
        Empty => NativeServeHeaderMalformed { line: line }
        Cons { head: _, tail: _ } =>
          if name == "" || trim(s: name) != name {
            NativeServeHeaderMalformed { line: line }
          } else {
            NativeServeHeaderParsed { field: NativeServeHeaderField { name: name, value: trim(s: join(rest, ":")) } }
          }
      }
    Empty => NativeServeHeaderMalformed { line: line }
  }
}

type NativeServeHeaders
  = NativeServeHeadersRead { fields: List<NativeServeHeaderField> }
  | NativeServeHeadersRefused { reason: String }

fn native_serve_headers(lines: List<String>, acc: List<NativeServeHeaderField>) -> NativeServeHeaders {
  match lines {
    Empty => NativeServeHeadersRead { fields: acc }
    Cons { head: line, tail: rest } =>
      match native_serve_header(line: line) {
        NativeServeHeaderParsed { field: f } => native_serve_headers(lines: rest, acc: acc |> list_push(f))
        NativeServeHeaderMalformed { line: _ } => NativeServeHeadersRefused { reason: "malformed header line" }
      }
  }
}

fn native_serve_named(fields: List<NativeServeHeaderField>, wanted: String) -> List<String> {
  fields |> filter(f => field_name_is(name: f.name, wanted: wanted)) |> map(f => f.value)
}

fn native_serve_frame_fields(method: String, target: String, fields: List<NativeServeHeaderField>, body_limit: Int) -> NativeServeFrame {
  let identity_header = tailscale_user_login_header as String
  let lengths = native_serve_named(fields: fields, wanted: native_serve_content_length_header)
  let identities = native_serve_named(fields: fields, wanted: identity_header)
  let authorizations = native_serve_named(fields: fields, wanted: "Authorization")
  if (lengths |> count) > 1 {
    native_serve_bad_request(reason: "duplicate Content-Length header")
  } else if (authorizations |> count) > 1 {
    native_serve_bad_request(reason: "duplicate Authorization header")
  } else if (identities |> count) > 1 {
    native_serve_bad_request(reason: concat("duplicate ", concat(identity_header, " header")))
  } else {
    let identity = match identities |> first {
      Present { value: v } => v
      Absent => ""
    }
    match lengths |> first {
      Absent => NativeServeFramed { head: NativeServeRequestHead { method: method, target: target, tailscale_identity: identity, headers: fields }, body_length: 0 }
      Present { value: text } =>
        match parse_int(s: text) {
          Absent => native_serve_bad_request(reason: concat("bad Content-Length: ", text))
          Present { value: n } =>
            if n < 0 {
              native_serve_bad_request(reason: concat("bad Content-Length: ", text))
            } else if n > body_limit {
              native_serve_bad_request(reason: concat("body of ", concat(to_string(value: n), concat(" bytes exceeds the ", concat(to_string(value: body_limit), " byte serve limit")))))
            } else {
              NativeServeFramed { head: NativeServeRequestHead { method: method, target: target, tailscale_identity: identity, headers: fields }, body_length: n }
            }
        }
    }
  }
}

// THE FRAMING RULE TAKES ONLY THE LIMIT IT READS, so the native door (its contract's body limit,
// native_serve_frame) and the seed's ingress realization (gunbc.http_ingress http_ingress_frame)
// judge a head by one rule rather than two.
fn native_serve_frame(contract: NativeServeContract, request_line: String, header_lines: List<String>) -> NativeServeFrame {
  native_serve_frame_within(body_limit: byte_size_count(b: contract.body_limit), request_line: request_line, header_lines: header_lines)
}

fn native_serve_frame_within(body_limit: Int, request_line: String, header_lines: List<String>) -> NativeServeFrame {
  match split(s: request_line, delimiter: " ") |> filter(p => p != "") {
    Cons { head: method, tail: r1 } =>
      match r1 {
        Cons { head: target, tail: _ } =>
          if !starts_with(s: target, prefix: "/") {
            native_serve_bad_request(reason: concat("request target must be origin-form, got ", target))
          } else {
            match native_serve_headers(lines: header_lines, acc: []) {
              NativeServeHeadersRefused { reason: r } => native_serve_bad_request(reason: r)
              NativeServeHeadersRead { fields: fields } => native_serve_frame_fields(method: method, target: target, fields: fields, body_limit: body_limit)
            }
          }
        Empty => native_serve_bad_request(reason: "missing request target")
      }
    Empty => native_serve_bad_request(reason: "empty request line")
  }
}

// The refusal the main writes when the head outgrew its limit or the bytes were not text: the
// main observes those (it is the one counting bytes), and this fold says what they mean.
fn native_serve_read_refused(reason: String) -> ServeWireResponse {
  ServeWireResponse { status: 400, content_type_label: native_serve_text_plain, body: concat("bad request: ", concat(reason, "\n")), headers: [] }
}

// The answer when the handler's effect transport failed (a bound handler -- the clock's shell call, a
// REST exchange -- returned an error the handler propagated rather than modeled). The main observes
// the failure, this fold says what it means: the server failed, not the request, so 500 and not 400.
fn native_serve_effect_failed(reason: String) -> ServeWireResponse {
  ServeWireResponse { status: 500, content_type_label: native_serve_text_plain, body: concat("effect transport failed: ", concat(reason, "\n")), headers: [] }
}

// THE EFFECT WORKER. The rendered main realizes ONE worker generation that owns the effect executor
// and every admitted handle (none for an entry with no effects), and reuses it for each request it
// answers; a generation that panics is abandoned and a replacement realized (a panicked thread runs
// nothing further, so nothing is left running for it), and a request that crosses its deadline ends
// the process (native_serve_deadline_exit_code). A generation that cannot be realized is NOT an
// effect transport failure (native_serve_effect_failed): no handler ran, and none can. At startup the
// main refuses with this reason before it announces -- exit 2, like every launch refusal -- so no
// process answers /livez that cannot serve a handler. A REPLACEMENT that cannot be realized ends the
// process with native_serve_worker_replacement_exit_code after the request in hand is answered, for
// its supervisor to restart it.
fn native_serve_worker_unrealized(reason: String) -> String {
  concat("the effect worker could not be realized: ", reason)
}

// EX_TEMPFAIL (sysexits.h 75): a restart re-runs the startup realization, which refuses with exit 2
// if the condition persists.
data native_serve_worker_replacement_exit_code: Int = 75

// ── ROUTING BEFORE THE HANDLER ──────────────────────────────────────────────────────────────
// GET /livez is answered without entering the handler, for the reason gunbc.serve_liveness
// states: the conditions that make a served process unhealthy are the conditions under which its
// handler fails, so a health answer behind the handler answers "healthy" or nothing.
type NativeServeRoute
  = NativeServeAnswered { response: ServeWireResponse }
  | NativeServeToHandler

fn native_serve_route(contract: NativeServeContract, head: NativeServeRequestHead, bound_host: String, bound_port: Int) -> NativeServeRoute {
  let liveness_path = serve_liveness_path as String
  if head.method == "GET" && head.target == liveness_path {
    NativeServeAnswered { response: ServeWireResponse {
      status: 200,
      content_type_label: native_serve_application_json,
      body: serve_liveness_document(revision: contract.release_revision, entry_function: contract.handler_identity, bound_host: bound_host, bound_port: bound_port),
      headers: [],
    } }
  } else {
    NativeServeToHandler
  }
}

// THE OPTIONAL STARTUP FOLD. A program descriptor MAY name one (std.compiler_entry
// NativeIngressStartup), of shape `(executable_octets: List<Int>) -> NativeServeStartup<S>`; the
// rendered main then runs it once PER WORKER GENERATION (the handler's values are not Send, so the
// fold runs on the worker that serves; a replacement generation reruns it), the first before any
// listener is bound, bounded by the descriptor's own startup bound rather than the request deadline,
// with the octets of the running executable's own file -- the host's only job is to read those bytes
// (it computes nothing about them). The fold decides everything: a NativeServeStartupRefused makes
// the main print native_serve_startup_refusal_line on stderr and exit native_serve_startup_refused_exit_code
// without binding, so a process whose self-check refused never becomes reachable and never serves.
// The first consumer is gunbc.auth.approval_device_crypto_serve, whose receipt is minted over the
// binary identity this carries. Instrument: //gunbc/instruments:native-serve-device-crypto.

// S is the handler's startup payload: the typed value the fold passed with, handed to every handler call as a
// trailing argument (the device-crypto handler's is its DeviceCryptoHandlerReceipt). The line is only what the
// process announces; nothing reads it back.
type NativeServeStartup<S>
  = NativeServeStartupPassed { line: String, value: S }
  | NativeServeStartupRefused { reason: String }

// Distinct from 2 (a refused start) so a supervisor and the instruments can tell a failed
// self-check from a bad argv; nonzero, so nothing treats the process as having started.
data native_serve_startup_refused_exit_code: Int = 3

fn native_serve_startup_refusal_line(reason: String) -> String {
  concat("REFUSED: startup self-check: ", reason)
}

fn native_serve_startup_passed_line(line: String) -> String {
  concat("native-serve startup self-check passed: ", line)
}

// ── WHAT LEAVES THE PROCESS ─────────────────────────────────────────────────────────────────
// Every response the main writes passes here first, whoever produced it. The status must be an
// HTTP status (RFC 9110 section 15: three digits, 100-599), and the content type and every header
// value must be free of CR, LF and NUL (the content type is an unrestricted String the main writes
// into the header block just like a header value), because a value is handler data and one carrying a line break would split the
// header block. The seed makes the same two checks in hand Rust after evaluation; here they are a
// fold, and a response that fails them is answered as a typed 500 naming why, never written.
// Header NAMES need no check: a ServeWireHeader is sole_constructor in extdeps.http.server and is
// built only from a ServeResponseHeader, whose open arm carries an HttpExtensionFieldName, so the
// framing headers the main writes itself (Content-Type, Content-Length, Connection) cannot be set.
type NativeServeOutgoing {
  status: Int
  content_type_label: String
  header_lines: List<String>
  body: String
}

fn native_serve_value_is_field_safe(value: String) -> Bool {
  (split(s: value, delimiter: "\r") |> count) == 1
    && (split(s: value, delimiter: "\n") |> count) == 1
    && (split(s: value, delimiter: "\u{0}") |> count) == 1
}

fn native_serve_unwritable(reason: String) -> NativeServeOutgoing {
  NativeServeOutgoing {
    status: 500,
    content_type_label: native_serve_text_plain,
    header_lines: [],
    body: concat("the handler's response cannot be written: ", concat(reason, "\n")),
  }
}

fn native_serve_header_line(h: ServeWireHeader) -> String {
  concat(h.name, concat(": ", h.value))
}

fn native_serve_outgoing(r: ServeWireResponse) -> NativeServeOutgoing {
  let unsafe_headers = r.headers |> filter(h => !native_serve_value_is_field_safe(value: h.value))
  if r.status < 100 || r.status > 599 {
    native_serve_unwritable(reason: concat("status ", concat(to_string(value: r.status), " is not an HTTP status")))
  } else if !native_serve_value_is_field_safe(value: r.content_type_label) {
    native_serve_unwritable(reason: "the content type carries CR, LF or NUL")
  } else if (unsafe_headers |> count) > 0 {
    native_serve_unwritable(reason: "a header value carries CR, LF or NUL")
  } else {
    NativeServeOutgoing {
      status: r.status,
      content_type_label: r.content_type_label,
      header_lines: r.headers |> map(h => native_serve_header_line(h: h)),
      body: r.body,
    }
  }
}

// ── THE PER-REQUEST BUDGET, DECIDED HERE ──────────────────────────────────────────────────────
// The rendered main asks native_serve_deadline_refused for the response when a request crosses the
// contract's effective deadline, writes it, and exits with native_serve_deadline_exit_code.

// THE REQUEST'S ARGUMENTS DO NOT HAVE THE SHAPES THE HANDLER WAS TYPED WITH. The start judged every
// planned fact against its parameter's shape before binding (gunbc.http_ingress
// http_ingress_native_contract), so no request reaches this; the worker answers it rather than call the
// handler with values of another shape, and nothing ran.
fn native_serve_arguments_unplanned() -> ServeWireResponse {
  ServeWireResponse {
    status: 500,
    content_type_label: native_serve_text_plain,
    body: "the request's arguments do not have the shapes the handler was planned with; the handler was not called\n",
    headers: [],
  }
}

// A WORKER THAT ENDS WITHOUT AN ANSWER -- the compiled handler panicked, so its result never reached
// the loop -- is a handler failure, not a deadline: it is answered with this typed 500, and the
// panicked worker is replaced, because nothing is still running for it.
fn native_serve_handler_failed() -> ServeWireResponse {
  ServeWireResponse {
    status: 500,
    content_type_label: native_serve_text_plain,
    body: "the handler ended without an answer and was refused; nothing is left running for it\n",
    headers: [],
  }
}

// The answer when the remaining deadline could not be installed as the connection's read bound: the main refuses to
// read under a stale bound, answers this, and exits with native_serve_deadline_exit_code, as after a crossing.
fn native_serve_deadline_uninstallable(contract: NativeServeContract, reason: String) -> ServeWireResponse {
  ServeWireResponse {
    status: 500,
    content_type_label: native_serve_text_plain,
    body: concat("the request's ", concat(to_string(value: millisecond_count(m: contract.request_deadline)), concat(" ms deadline could not be installed on its connection (", concat(reason, "); this process exits for its supervisor to restart it, so no read proceeded without the bound\n")))),
    headers: [],
  }
}

fn native_serve_deadline_refused(contract: NativeServeContract) -> ServeWireResponse {
  ServeWireResponse {
    status: 500,
    content_type_label: native_serve_text_plain,
    body: concat("the request exceeded its ", concat(to_string(value: millisecond_count(m: contract.request_deadline)), " ms deadline and was refused; this process exits for its supervisor to restart it, so nothing is left running for it\n")),
    headers: [],
  }
}
