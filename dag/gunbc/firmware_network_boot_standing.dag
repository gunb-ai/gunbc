module gunbc.firmware_network_boot_standing

// THE FLEET-WIDE ANSWER TO "CAN THIS UNIT NETWORK-BOOT, AND WHAT MUST HAPPEN FIRST".
//
// Before this seam that question was answered in four unrelated places: the serving edge in
// extdeps.provisioning.network_boot, the delivery admission and its boot-control receipt in
// gunbc.network_boot_delivery, the per-unit firmware facts only inside the Spark-specific
// gunbc.spark.pxe_rescue_observation, and an operator's judgement of what to do about it.
// Nothing in the corpus could state, for one unit, that it is READY to network boot together
// with the evidence that makes the claim good — nor, just as importantly, that it is NOT, with
// the route a controller or a human must take to make it so. Cut 6 of
// gunbc.plans.physical_machine_boot_program needs exactly one place that says either.
//
// WHY THE NAMES HERE ARE THE NAMES THE PROBE MUST EMIT. gunbc.firmware_network_boot_probe (S2)
// emits these five axis types; it does not define them. A probe that owned its own vocabulary
// could invent an arm the seam does not recognise, and the seam would answer "Ready" to a fact
// it never modelled. This module is therefore the contract, and the probe is one of its vendors.
//
// MACHINE NAMES NEVER SELECT ANYTHING HERE. Neither the standing nor a route is chosen by a
// unit, a host, or a model string. The route is derived from the observed standing; the catalog
// row below owns which routes exist. A unit identity is carried through as data so a receipt can
// name what it covers, and no match in this module is ever on it.

import std.types { Bool, EpochMs, Int, List, NonEmptyStr }
import std.algebra { length, fold_list, list_append, contains, Cons, Empty }
import std.optional { Optional, Present, Absent }
import extdeps.external_authority { CitedFigureStanding, CitedToAuthority, ExternalAuthority, TranscribedUncited }
import extdeps.uri { uri_https }
import extdeps.provisioning.network_boot {
  ClientNetworkBootMode,
  UefiHttpBoot,
  UefiPxe,
}
// THE TARGET ENUM IS NOT MINE TO REINVENT (review 81711). extdeps.bmc.types already models the
// Redfish BootSourceOverrideTarget value set that the BMC protocol defines; classifying a boot
// entry as network-or-not is a question about THAT enum, so it is asked against it.
import extdeps.bmc.types {
  RedfishBootSourceOverrideTarget,
  RedfishBootTargetNetworkStanding,
  NetworkBootTarget,
  NotNetworkBootTarget,
  redfish_boot_target_network_standing,
  BootTargetNone,
  BootTargetPxe,
  BootTargetHdd,
  BootTargetCd,
  BootTargetUsb,
  BootTargetBiosSetup,
  BootTargetDiags,
  BootTargetUefiHttp,
}
import gunbc.network_boot_delivery { BootControlReceiptStanding }
// THE FRONTIER IS DATA, NOT PROSE (review 81734 / DESIGN 3c). A '//' note naming the future probe
// is unreadable to any tool and is deleted by the next refactor that does not happen to need it;
// std.dissolution already models 'an obligation discharged by a declaration that does not exist
// yet' as a bound trigger over a DeclarationRef, and dissolution_status answers Pending or Fired
// against a real declaration population. So the frontier and the inhabitation claim are carriers
// here, and the witness asserts their CURRENT status -- which is the only form in which 'this is a
// declared frontier with its trigger' is checkable rather than claimed.
import std.dissolution {
  DissolutionCondition,
  DissolutionStatus,
  BoundDissolution,
  DeclarationAppears,
  dissolution_status,
}
import std.decl_ref { DeclarationRef, decl_ref }

// ---------------------------------------------------------------------------
// THE UNIT OBSERVATION: the firmware-side facts a standing is computed from.
//
// ONE UNION PER AXIS, REFUSAL INCLUDED. A bool-ish state wrapped in an
// Observed/Unobserved/Refused ENVELOPE lets the envelope and the value disagree — a record that
// says "the BMC refused" while still carrying SecureBootEnabled is a contradiction nothing can
// adjudicate. So each axis is ONE union whose arms are the answer, the not-asked, and the
// refused. Unobserved and Refused are not errors and never were: an unasked axis means go and
// ask (a probe coverage gap), a refused axis means stop asking that way (a transport or policy
// fact). Those two have different remedies, which is exactly why they are different arms.
// ---------------------------------------------------------------------------

// WHY A REFUSAL IS A UNION AND NOT A STRING. A refusal string cannot be routed to a remedy:
// VendorCommandRejected means the transport does not speak that command (change the route),
// ResourceNotFound means the transport speaks it but this unit has no such object (change the
// question), AuthenticationRequired means someone must establish credentials (a human or a
// secret store), and ReplyShapeUnrecognized means the reply did not match the schema (a
// toolchain/version problem, and a fact worth recording because it usually means the BMC
// firmware drifted). Four different next actions, so four arms. A family row can be checked
// against this union; it cannot be checked against prose.
type FirmwareReadRefusal
  = VendorCommandRejected { detail: NonEmptyStr }
  | ResourceNotFound { detail: NonEmptyStr }
  | AuthenticationRequired { detail: NonEmptyStr }
  | ReplyShapeUnrecognized { detail: NonEmptyStr }

// BootOrder is the firmware's own list of what it will try. A network stack in this list is the
// precondition the readiness fn checks first, because every remote override mechanism merely
// points at an entry this list already contains.
// A BOOT ENTRY IS TYPED, NOT NAMED (review 81711). These two lists once held the firmware's label
// strings and the seam GUESSED network-ness by substring over them: "IPv4" matches an iSCSI entry,
// "HTTP" matches vendor diagnostics tooling, "Network" matches a disabled legacy option, and a
// wrong guess here is a Ready that boots nothing -- the exact class of failure this seam exists to
// prevent. DESIGN.md 4: in a closed system a heuristic is never necessary, the richer source
// always exists or can be written. It already exists: the Redfish BootSourceOverrideTarget enum in
// extdeps.bmc.types, which is what a BMC actually speaks. So the probe classifies each entry
// against that schema and this seam consumes the KIND. The label is kept as data -- it is what a
// human reads when a kind is not enough to find the entry on a console -- and it is never
// consulted by a decision.
// BOOT ORDER AND BOOT OPTIONS ARE DIFFERENT READS OF THE SAME THING, AND UNTIL THIS CHANGE THE
// SEAM COULD NOT TELL THEM APART -- both were List<BootEntry>, each entry carrying its own `kind`
// (merry-fox-82, blocker 1). That single shape is what produced the false Ready: the fold filtered
// a list down to the network-kind entries and took the head, so a BootOrder of [Hdd, Pxe] reported
// the head as Pxe and answered Ready, when the firmware's own first entry says it boots the disk.
// And a BootOrder of [Pxe] against options [UefiHttp] reported Ready while quoting a target the
// unit does not have, because the two lists were only ever asked "does SOME network entry exist".
//
// THE REPAIR IS A TYPE CHANGE, NOT AN EXTRA CHECK. A BootOrder entry now carries an IDENTITY and a
// label, and NO KIND: kind exists only on an enumerated BootOption. So "the head of the boot order
// is a network target" is not a question this module can ask of BootOrder alone -- it can only be
// answered by JOINING the head's reference to the enumeration, and the join is where enabled-ness
// and kind come from together. The wrong answer merry found is not caught by a new predicate; it
// has no spelling (DESIGN 5: stronger than catching a wrong state is making it unwritable).
type BootOrderEntry {
  // Redfish BootOptionReference (e.g. "0000" / "Boot0001"). The ONLY thing the two reads agree on,
  // and therefore the only thing a join may be keyed on: kind is not identity (a unit may hold two
  // PXE entries for two ports), and label certainly is not -- labels are vendor prose.
  reference: NonEmptyStr
  label: NonEmptyStr
}

// An entry as the enumeration reports it: identity, WHAT it is, what a human sees, and WHETHER THE
// FIRMWARE WILL USE IT. `enabled` is not decoration -- a disabled BootOption cannot be pointed at
// by UefiBootNext either, so "exists" and "can be booted" are genuinely different states and the
// old single BootEntry type had no way to say them apart.
type BootOption {
  reference: NonEmptyStr
  kind: RedfishBootSourceOverrideTarget
  label: NonEmptyStr
  enabled: Bool
}

fn boot_order_entry(reference: NonEmptyStr, label: NonEmptyStr) -> BootOrderEntry {
  BootOrderEntry { reference: reference, label: label }
}

fn boot_option(
  reference: NonEmptyStr,
  kind: RedfishBootSourceOverrideTarget,
  label: NonEmptyStr,
  enabled: Bool
) -> BootOption {
  BootOption {
    reference: reference,
    kind: kind,
    label: label,
    enabled: enabled,
  }
}

type BootOrderObservation
  = BootOrderObserved { devices: List<BootOrderEntry> }
  | BootOrderUnobserved { reason: NonEmptyStr }
  | BootOrderRefused { refusal: FirmwareReadRefusal }

// BootOptions are the entries the firmware can be pointed at (Redfish BootOptions /
// UefiBootNext targets). A unit can have a network entry in BootOrder yet no usable network
// boot OPTION, which is why these are two axes rather than one.
type BootOptionsObservation
  = BootOptionsObserved { options: List<BootOption> }
  | BootOptionsUnobserved { reason: NonEmptyStr }
  | BootOptionsRefused { refusal: FirmwareReadRefusal }

// Which interfaces the firmware believes are bootable. The fleet has been burned once by reading
// an empty list as "no NICs": it is also what some MegaRAC releases answer when asked badly.
// That is why the probe answers this axis with Unobserved or Refused, never with an empty list.
type NicsObservation
  = NicsObserved { nics: List<NonEmptyStr> }
  | NicsUnobserved { reason: NonEmptyStr }
  | NicsRefused { refusal: FirmwareReadRefusal }

// ON, OFF, NEVER ASKED, and ASKED-AND-DENIED are four states, not two states plus a wrapper.
// Secure Boot decides whether the pinned unsigned iPXE chainloader (S1) ever reaches a shell: a
// fleet that cannot say which of these four it is in cannot say whether its own pin will boot.
// The standing is read-only here; enrolling or clearing a key is a change of state, not a
// reading of one, and belongs to a route with its own readback.
type SecureBootObservation
  = SecureBootEnabled
  | SecureBootDisabled
  | SecureBootUnobserved { reason: NonEmptyStr }
  | SecureBootRefused { refusal: FirmwareReadRefusal }

// BIOS version is on the seam because a firmware update changes which override mechanism a unit
// supports. Treating it as informational is how a route keeps being applied to a unit that
// stopped supporting it two firmware releases ago.
type BiosVersionObservation
  = BiosVersionObserved { version: NonEmptyStr }
  | BiosVersionUnobserved { reason: NonEmptyStr }
  | BiosVersionRefused { refusal: FirmwareReadRefusal }

// THE FIVE AXES, ALL REQUIRED. There is no constructor for four of them: a partial set is a
// partial PROBE, and that is modelled by the per-axis Unobserved arms rather than by a missing
// field, so "we did not look" stays visible instead of becoming a field nobody filled in.
type FirmwareBootObservation {
  boot_order: BootOrderObservation
  boot_options: BootOptionsObservation
  nics: NicsObservation
  secure_boot: SecureBootObservation
  bios_version: BiosVersionObservation
}

fn firmware_boot_observation(
  boot_order: BootOrderObservation,
  boot_options: BootOptionsObservation,
  nics: NicsObservation,
  secure_boot: SecureBootObservation,
  bios_version: BiosVersionObservation
) -> FirmwareBootObservation {
  FirmwareBootObservation {
    boot_order: boot_order,
    boot_options: boot_options,
    nics: nics,
    secure_boot: secure_boot,
    bios_version: bios_version,
  }
}

// ---------------------------------------------------------------------------
// THE ROUTES: what must be DONE before a unit can network boot, and by which mechanism.
//
// EACH ARM CARRIES WHAT ITS OWN EXECUTOR NEEDS AND NOTHING ELSE. A single flat "route record"
// with one optional field per mechanism lets an IpmiOneShotOverride carry a Redfish service root
// and a UefiShell route carry an IPMI channel, and the only way anyone finds out is on the unit,
// during an attempt. The arms below are disjoint by construction: the fields that exist are the
// fields that mechanism reads.
//
// HUMAN CONSOLE IS A ROUTE, NOT A FAILURE. Some units can only be prepared by a person at a
// console — a BIOS that accepts no remote override, a prompt behind a password nobody wants to
// record. Making that Refused loses the information that the unit IS network-bootable once a
// human acts; making it a route keeps the standing honest AND the plan actionable. It is also,
// deliberately, not reachable from an Unobserved axis: a human console is a route for a unit
// whose firmware answered and refused every remote mechanism, never a substitute for not having
// looked.
// ---------------------------------------------------------------------------

// THE ROUTE IS THE CATALOG ROW, AND THE CATALOG ROW IS THE ROUTE (review 81760).
//
// I had written this down twice. `FirmwareNetworkBootPreparationRoute` was a flat union of six
// mechanisms, and beside it `RouteAuthority` was a union of five rows carrying `*Remedy` unions of
// the SAME six mechanisms -- IpmiOneShotOverride against IpmiOneShotRemedy, HumanConsole against
// ConsoleRemedy, arm for arm, differing only in name. `route_of` existed to translate between two
// names for one thing, and `route_eq` to compare them, which is DESIGN 3's nicknaming with a
// translation layer on top. Worse, the flat union was the half that kept the old behaviour: it was
// the type a caller could hold, hand to the attempt, and get checked at runtime.
//
// So there is now ONE union, and its arms are the mechanisms the fleet drives. Each arm carries the
// fields its own executor reads plus the authority and obligation for that row. The arm name states
// what the mechanism does, because the same Redfish Bios PATCH used to enable a stack, pick a port,
// and change Secure Boot is THREE different fleet actions with three different readbacks -- naming
// all three `RedfishBiosAttributes` is what let the wrong one be filed under the wrong blocker.
//
// THE PAIRING IS STILL THE TYPE. `blocker_of` is derived from the arm, so constructing
// `EnableNetworkStack` IS the claim 'this fixes no-network-stack'; there is no separate route value
// to mis-pair, no remedy union to widen, and no capability table to keep in step. A witness asserts
// every arm's derived blocker (each_route_arm_derives_the_blocker_the_fleet_acts_on) because the
// derivation is the one remaining place a human writes a pairing by hand.
//
// HUMAN CONSOLE IS A ROUTE, NOT A FAILURE. Some units can only be prepared by a person at a console
// -- a BIOS that accepts no remote override, a prompt behind a password nobody wants to record.
// Making that Refused loses the information that the unit IS network-bootable once a human acts. It
// is deliberately not reachable from an Unobserved axis: a console is the answer for a unit whose
// firmware answered and refused every remote mechanism, never a substitute for not having looked.

// 'The boot order has no network stack at all' -- empty, or every entry's KIND is non-network. The
// only thing that changes that is making the stack exist, which is a persistent BIOS attribute
// PATCH followed by a reset and a BootOrder re-read.
// WHAT A ROUTE DEMANDS OF ITS EXECUTOR, TYPED (review 81802). Every route used to carry this as
// one `obligation: NonEmptyStr`, and four separate facts were smeared through it: whether the
// change persists or dies with the next boot, whether a reset is needed, which property to re-read
// to prove the change landed, and whether a human has to consent first. Only the prose said so,
// nothing read it, and that is exactly how the fold was able to hand back a redirect for a unit
// that lists nothing to redirect to -- the precondition saying 'this route needs an option that
// already exists' lived in a sentence, so no check could notice it being contradicted.
//
// IT IS NOW A UNION AND THE PRECONDITIONS ARE MEMBERS OF IT. `requires` is a LIST because a route
// genuinely demands more than one thing (enable a stack: persistent, then reset, then re-read
// BootOrder, and consent only when it removes a security control -- a single arm could not say
// that). DESIGN 4c: an invariant belongs in a carrier, and a String whose only purpose was
// commentary was misplaced data.
//
// WHAT THIS ACTUALLY GUARANTEES, STATED AT ITS REAL RUNG (review 81884, DESIGN 4b meta-obligation
// 1: the reported rung must equal the rung the evidence establishes -- an inflated class never ranks
// for climbing). This is RUNG 2, mechanically preventable, NOT a type guarantee, and the earlier
// version of this comment claimed otherwise. Precisely:
//   * The catalog stores ROUTES ONLY. It has no blocker field, because `blocker_of` derives the
//     blocker from the arm. So 'pair this redirect with that blocker' is not something an author can
//     write down as data at all -- there is nowhere to write it.
//   * What CAN be edited is `blocker_of` itself: re-keying a redirect's arm to
//     `NetworkBootOptionAbsent`. That is caught at runtime by `route_is_admissible_for`, which drops
//     the row (the fold then reports the gap by name rather than emitting a plan that cannot run),
//     and it is caught at test time -- the witness's admissibility test is the mutation guard, and
//     the mutation is a one-line edit to that one function.
//   * A true rung 3 would PARTITION the route union so the option-denying blockers could not name a
//     redirect constructor. Deliberately not done: the release catalog is required to hold ONE
//     mechanism union (review 81760 deleted a second route vocabulary for exactly that reason), and
//     partitioning it by capability reintroduces two namespaces over one family of mechanisms. The
//     precondition lives in the arms; the check lives in one function; the witness ties them.
type ProcedureRequires
  = RequiresPersistentChange
  | RequiresOneShotOnly
  | RequiresReset
  | RequiresReadbackOf { property: NonEmptyStr }
  | RequiresOperatorConsent { reason: NonEmptyStr }
  // THE PRECONDITION THAT WAS ONLY PROSE: this mechanism redirects or references a boot option the
  // unit ALREADY lists. Routes carrying it are refused at lookup for any blocker that says there is
  // none (`route_is_admissible_for`), which is a runtime check over the catalog rather than a
  // construction the language forbids -- stated at that rung, with its mutation witness, there.
  | RequiresExistingBootOption

// The prose a human reads when they are handed a route, derived from the typed procedure rather
// than stored beside it. A second home for the same fact is DESIGN 3's nicknaming, and here it is
// worse than duplication: prose and carriers disagree silently, and prose is what an operator
// trusts. So nothing stores an obligation sentence -- `route_prose` renders the arms, and the only
// sentence a route carries is one this function cannot produce for an arm nobody wrote (no default).
fn requires_prose(requirement: ProcedureRequires) -> NonEmptyStr {
  match requirement {
    RequiresPersistentChange => "persistent change: it survives the reboot and must be undone deliberately"
    RequiresOneShotOnly => "next boot only: nothing persists, so a second attempt must set it again"
    RequiresReset => "the unit must be reset for the change to take effect"
    RequiresReadbackOf { property: property } =>
      concat("read ", concat(property, " back before trusting it; an unverified change is an unmade change"))
    RequiresOperatorConsent { reason: reason } =>
      concat("operator consent first: ", concat(reason, " -- this changes a security control, not a boot pointer"))
    RequiresExistingBootOption =>
      "the unit must ALREADY list the boot option this redirects to; if it lists none, this route is unavailable and the standing must say so rather than invent one"
  }
}

// A ROUTE'S PROCEDURE, derived from the arm: one list per mechanism, in the order an executor does
// it. A route's arms are irreplaceable, so the mapping is total by construction -- no lookup to
// drift, and a new arm forces someone to write what it demands.
fn route_requires(route: FirmwareNetworkBootPreparationRoute) -> List<ProcedureRequires> {
  match route {
    EnableNetworkStack { service_root: _, attribute: _, authority: _ } => [
      RequiresPersistentChange,
      RequiresReadbackOf { property: "BootOrder" },
      RequiresReset,
    ]
    PointUefiBootNext { service_root: _, boot_option: _, authority: _ } => [
      RequiresOneShotOnly,
      RequiresReadbackOf { property: "UefiBootNext" },
      RequiresReset,
      RequiresExistingBootOption,
    ]
    RedfishOneShotOverride { service_root: _, authority: _ } => [
      RequiresOneShotOnly,
      RequiresReadbackOf { property: "BootSourceOverrideEnabled" },
      RequiresReset,
      RequiresExistingBootOption,
    ]
    IpmiOneShotOverride { channel: _, authority: _ } => [
      RequiresOneShotOnly,
      RequiresReadbackOf { property: "IPMI chassis boot flags" },
      RequiresReset,
      RequiresExistingBootOption,
    ]
    SelectNicBoot { service_root: _, attribute: _, authority: _ } => [
      RequiresPersistentChange,
      RequiresReadbackOf { property: "Bios.Attributes" },
      RequiresReset,
    ]
    SetSecureBootAttribute { service_root: _, attribute: _, authority: _ } => [
      RequiresPersistentChange,
      RequiresOperatorConsent { reason: "Secure Boot state is a security control and this fleet has never been given consent to alter it" },
      RequiresReadbackOf { property: "SecureBoot" },
      RequiresReset,
    ]
    UefiShellOverSol { sol_channel: _, shell_script: _, authority: _ } => [
      RequiresOneShotOnly,
      RequiresReadbackOf { property: "SOL console transcript" },
    ]
    HumanConsole { instruction: _, authority: _ } => [
      RequiresOperatorConsent { reason: "a person must be physically at the unit's console" },
    ]
  }
}

// THE ROUTE AS THE PLAN STEP READS IT, RENDERED FROM THE CARRIERS. No route stores a sentence, so
// no route's sentence can contradict its carriers -- there is nowhere to store a contradiction.
fn route_prose(route: FirmwareNetworkBootPreparationRoute) -> NonEmptyStr {
  fold_list(
    xs: route_requires(route: route),
    empty: mechanism_name(route: route),
    cons: fn(acc, requirement) { concat(acc, concat("; ", requires_prose(requirement: requirement))) },
  )
}

type FirmwareNetworkBootPreparationRoute
  = EnableNetworkStack {
      service_root: NonEmptyStr,
      attribute: NonEmptyStr,
      authority: CitedFigureStanding,
    }
  // 'A stack exists but nothing points at it': point UefiBootNext at an option the unit ALREADY
  // lists. Cannot author an option -- if the unit lists none, this is not the route. The
  // precondition is written ONCE, as the `RequiresExistingBootOption` arm of this route's procedure,
  // and consulted at lookup time by `route_is_admissible_for`; see that function for what is and is
  // not guaranteed, and at which rung.
  | PointUefiBootNext {
      service_root: NonEmptyStr,
      boot_option: NonEmptyStr,
      authority: CitedFigureStanding,
    }
  // The same redirect over Redfish's generic BootObject override (PATCH BootSourceOverrideEnabled
  // = Once, read the property back, reset).
  | RedfishOneShotOverride {
      service_root: NonEmptyStr,
      authority: CitedFigureStanding,
    }
  // The same redirect again, over the IPMI chassis boot selector -- the control plane a MegaRAC
  // unit with no usable Redfish service actually answers to.
  | IpmiOneShotOverride {
      channel: NonEmptyStr,
      authority: CitedFigureStanding,
    }
  // 'Several candidate NICs, none evidenced as the one carrying PXE'. Which PORT boots is a
  // firmware setting: a redirect can only pick among entries that already exist, so it is not this
  // route's answer. Persistent attribute, then reset.
  | SelectNicBoot {
      service_root: NonEmptyStr,
      attribute: NonEmptyStr,
      authority: CitedFigureStanding,
    }
  // 'Secure Boot rejects the pinned chainloader'. Firmware STATE, so its own readback and consent,
  // and the standing returns to Unobserved until the new state is re-read.
  | SetSecureBootAttribute {
      service_root: NonEmptyStr,
      attribute: NonEmptyStr,
      authority: CitedFigureStanding,
    }
  // 'The API refused the override itself', so what is left in-band is a scripted UEFI shell over
  // SOL -- only where a shell is present and SOL is configured.
  | UefiShellOverSol {
      sol_channel: NonEmptyStr,
      shell_script: NonEmptyStr,
      authority: CitedFigureStanding,
    }
  // The same refusal, answered by a person. Credited with every blocker, which is exactly why the
  // fold may never reach it from a silence.
  | HumanConsole {
      instruction: NonEmptyStr,
      authority: CitedFigureStanding,
    }

// THE BLOCKER IS READ OFF THE ARM. A stored copy could contradict the mechanism it sits beside (a
// row that says 'no network stack' while driving a one-shot override is the bug that shipped twice,
// in 81711 and again in 81734's critique of my first fix), so nothing stores it: the arm you were
// able to construct already answers it, and this fn is the single place the answer is written.
fn blocker_of(route: FirmwareNetworkBootPreparationRoute) -> PreparationBlockingOn {
  match route {
    // Authoring, not redirecting: on this firmware the PXE boot option exists because the stack is
    // enabled, so this is the one mechanism in the catalog that answers 'there is no option'.
    EnableNetworkStack { service_root: _, attribute: _, authority: _ } =>
      NetworkBootOptionAbsent
    PointUefiBootNext { service_root: _, boot_option: _, authority: _ } =>
      NetworkBootOptionNotSelected
    RedfishOneShotOverride { service_root: _, authority: _ } =>
      NetworkBootOptionNotSelected
    IpmiOneShotOverride { channel: _, authority: _ } =>
      NetworkBootOptionNotSelected
    SelectNicBoot { service_root: _, attribute: _, authority: _ } =>
      NoInterfaceCarriesPxe
    SetSecureBootAttribute { service_root: _, attribute: _, authority: _ } =>
      SecureBootBlocksUnsignedChainloader
    UefiShellOverSol { sol_channel: _, shell_script: _, authority: _ } =>
      OverrideMechanismUnsupported
    HumanConsole { instruction: _, authority: _ } =>
      OverrideMechanismUnsupported
  }
}

// THE MECHANISM AS AN OPERATOR NAMES IT, for logs and for the plan's step text. Total over the
// arms with no default, so a new arm forces someone to say what it is called out loud.
fn mechanism_name(route: FirmwareNetworkBootPreparationRoute) -> NonEmptyStr {
  match route {
    EnableNetworkStack { service_root: _, attribute: _, authority: _ } => "redfish-bios-network-stack"
    PointUefiBootNext { service_root: _, boot_option: _, authority: _ } => "redfish-uefi-boot-next"
    RedfishOneShotOverride { service_root: _, authority: _ } => "redfish-one-shot-override"
    IpmiOneShotOverride { channel: _, authority: _ } => "ipmi-one-shot-override"
    SelectNicBoot { service_root: _, attribute: _, authority: _ } => "redfish-bios-nic-boot-selection"
    SetSecureBootAttribute { service_root: _, attribute: _, authority: _ } => "redfish-bios-secure-boot"
    UefiShellOverSol { sol_channel: _, shell_script: _, authority: _ } => "uefi-shell-over-sol"
    HumanConsole { instruction: _, authority: _ } => "human-console"
  }
}

fn authority_of(route: FirmwareNetworkBootPreparationRoute) -> CitedFigureStanding {
  match route {
    EnableNetworkStack { service_root: _, attribute: _, authority: a } => a
    PointUefiBootNext { service_root: _, boot_option: _, authority: a } => a
    RedfishOneShotOverride { service_root: _, authority: a } => a
    IpmiOneShotOverride { channel: _, authority: a } => a
    SelectNicBoot { service_root: _, attribute: _, authority: a } => a
    SetSecureBootAttribute { service_root: _, attribute: _, authority: a } => a
    UefiShellOverSol { sol_channel: _, shell_script: _, authority: a } => a
    HumanConsole { instruction: _, authority: a } => a
  }
}

// NO `obligation_of`, AND NO OBLIGATION FIELD ON ANY ROUTE (review 81802). The routes used to
// carry `obligation: NonEmptyStr` -- unclassified prose that read exactly like the executor's
// procedure and was read by nobody: not `network_boot_attempt`, not the readiness fold, not the
// witness. Unread prose is dead code that has convinced its author a check exists, and here it was
// worse than dead: the precondition that made one pairing impossible was written only in that
// prose, so no check could notice the pairing. What the prose was trying to say is now
// `ProcedureRequires` (typed, per arm, and consumed by `route_prose` for the human-facing text);
// re-deriving it by hand is what DESIGN 3 forbids.
data firmware_network_boot_standing_authority: CitedFigureStanding = CitedToAuthority {
  authority: ExternalAuthority { uri: uri_https(locator: "redfish.dmtf.org/schemas/v1/ComputerSystem.v1_0_0.json#Boot") },
}

data firmware_network_boot_console_authority: CitedFigureStanding = TranscribedUncited {
  read_obligation: "Re-derive per unit from the board vendor manual's boot-menu section; the ALTRAD8UD-1L2T prompt key has never been transcribed into this corpus, which is why HumanConsole rows are uncited and stay that way until someone reads the manual."
}

// THE CATALOG: the mechanisms the fleet actually drives, one entry per (blocker, mechanism) it
// knows how to drive. A row is a route, not a pointer to one -- so there is nothing to mis-pair and
// nothing to look up twice. Rows are keyed on the BLOCKER and on nothing unit-shaped: this table
// says which mechanisms the fleet knows how to drive and says nothing about which unit needs which
// (operator policy: machine names never select).
//
// LIST ORDER IS THE FLEET'S PREFERENCE, not an accident of authoring: where a blocker has several
// working mechanisms the first is what the fleet tries, and the witness keeps the table total.
data firmware_network_boot_preparation_routes: List<FirmwareNetworkBootPreparationRoute> = [
  // 'No network stack in the boot order' -- the list is empty, or every entry's KIND is non-network.
  // Only making the stack exist changes that, and only a BIOS attribute does that.
  EnableNetworkStack {
    service_root: "redfish:Bios",
    attribute: "NetworkStack",
    authority: firmware_network_boot_standing_authority,
  },
  // 'No network boot option listed' -- the unit has a stack and lists nothing to point at. All three
  // are redirects to an option that ALREADY exists; if a unit lists none, the standing must say so
  // rather than invent one, which is why the fold reaches this arm only with a stack present.
  PointUefiBootNext {
    service_root: "redfish:Systems/Self",
    boot_option: "uefi-boot-next",
    authority: firmware_network_boot_standing_authority,
  },
  RedfishOneShotOverride {
    service_root: "redfish:Systems/Self",
    authority: firmware_network_boot_standing_authority,
  },
  IpmiOneShotOverride {
    channel: "ipmi:chassis-boot-override",
    authority: firmware_network_boot_standing_authority,
  },
  // 'Several candidate NICs, none evidenced as the one carrying PXE'. A redirect cannot answer
  // 'which port' -- it only picks among entries that already exist.
  SelectNicBoot {
    service_root: "redfish:Bios",
    attribute: "NicBootSelection",
    authority: firmware_network_boot_standing_authority,
  },
  // Secure Boot ON against an unsigned chainloader: firmware state, so its own readback plus
  // consent, and the standing returns to Unobserved until the new state is re-read.
  SetSecureBootAttribute {
    service_root: "redfish:Bios",
    attribute: "SecureBoot",
    authority: firmware_network_boot_standing_authority,
  },
  // 'The override mechanism itself is unsupported': the API refused, so what is left is out of band.
  UefiShellOverSol {
    sol_channel: "sol:0",
    shell_script: "netboot.efi",
    authority: firmware_network_boot_standing_authority,
  },
  HumanConsole {
    instruction: "attend the unit and select the network device",
    authority: firmware_network_boot_console_authority,
  },
]

// THE FOLD'S ONLY WAY TO OBTAIN A ROUTE, and the only place the table is searched. A blocker with
// no row is reported as a refusal naming it, never patched over with an improvised route: 'we know
// what is wrong with this unit and own no mechanism for it' is a fleet fact an operator needs.
fn route_for_blocking(blocker: PreparationBlockingOn) -> Optional<FirmwareNetworkBootPreparationRoute> {
  firmware_network_boot_preparation_routes
    |> filter(route => route_is_admissible_for(route: route, blocker: blocker))
    |> first
}

// THE PROCEDURE IS CONSUMED, NOT JUST CARRIED. `blocker_of` says which blocker an author wrote a
// row to drive; `route_requires` says what executing that mechanism actually demands. They are
// different facts (one is per-row authoring, one is per-arm physics), and the defect review 81802
// found is precisely what happens when nobody checks the first against the second: a row keyed to
// 'there is no network option' drove a redirect, which cannot run when there is nothing to point
// at. So a row is admissible only if BOTH agree:
//
//   * it was written for this blocker, and
//   * nothing its procedure demands is contradicted by this blocker. Today that is one rule, and it
//     is the whole reason `RequiresExistingBootOption` exists as an arm rather than a sentence: a
//     redirect credited to `NetworkBootOptionAbsent` is dropped rather than emitted, and the
//     standing reports the modeling gap by name instead of handing an operator a plan that cannot
//     succeed. RUNG, STATED HONESTLY (review 81884): this is RUNTIME VALIDATION over the catalog,
//     not a type guarantee -- a redirect is still a constructible value, and nothing stops someone
//     writing `blocker_of(PointUefiBootNext{..}) = NetworkBootOptionAbsent`. What makes that safe to
//     ship is that the edit is (a) one line in one total function, (b) neutralised here, where the
//     row is dropped and the gap reported by name instead of a bogus plan being emitted, and (c)
//     caught by the witness's admissibility test, whose mutation is exactly that edit. The catalog
//     stores routes and NO blocker column, so the pairing cannot be authored as data either: there
//     is no field to write it into.
//
// WHY NOT LET `blocker_of` CARRY IT ALONE: then the precondition would again live in one author's
// care, and the arm's demand would be unenforced decoration -- the same shape as the prose field
// this replaced.
// WHAT THE BLOCKER ITSELF ASSERTS ABOUT EXISTING OPTIONS -- a union, not a Bool, for the same
// reason the classifier above is one (review 81853). The first version was
// `blocker_requires_existing_option(blocker) -> Bool`, which matched a coproduct and returned
// true/false, so the fold's one consumer could not tell 'this blocker says an option exists' from
// 'this blocker says nothing either way', and neither could a reader. Those two are different facts
// with different remedies, and the admissibility decision below reads them differently: an
// option-neutral blocker (NIC selection, Secure Boot, an unsupported override) does not care whether a
// redirect needs an existing option, while an option-denying blocker forbids one. Naming the arms
// also keeps the function total: a new blocker must say which kind it is.
type BlockerOptionStanding
  = BlockerNeedsAnExistingOption
  // The blocker means 'there is no network option to point at', or it does not speak the question.
  // Either way a route that demands an existing option is inadmissible for it: for the denying case
  // because the demand is false, for the neutral case because the route's demand is unevidenced.
  | BlockerDeniesOrIgnoresExistingOption

fn blocker_option_standing(blocker: PreparationBlockingOn) -> BlockerOptionStanding {
  match blocker {
    // The unit was asked and answered 'nothing to select'.
    NetworkBootOptionAbsent => BlockerDeniesOrIgnoresExistingOption
    // An option exists and the order does not name it: redirecting is exactly the remedy.
    NetworkBootOptionNotSelected => BlockerNeedsAnExistingOption
    // Which PORT boots, whether Secure Boot accepts the chainloader, and whether the API honours an
    // override are none of them statements about the boot option list, so a redirect's precondition
    // is unevidenced rather than satisfied.
    NoInterfaceCarriesPxe => BlockerDeniesOrIgnoresExistingOption
    SecureBootBlocksUnsignedChainloader => BlockerDeniesOrIgnoresExistingOption
    OverrideMechanismUnsupported => BlockerDeniesOrIgnoresExistingOption
  }
}

fn route_is_admissible_for(
  route: FirmwareNetworkBootPreparationRoute,
  blocker: PreparationBlockingOn,
) -> Bool {
  if blocker_of(route: route) != blocker {
    false
  } else {
    match blocker_option_standing(blocker: blocker) {
      BlockerNeedsAnExistingOption => true
      BlockerDeniesOrIgnoresExistingOption =>
        // The blocker says there is no option to point at (or never said there was one), so a route
        // whose procedure demands one may not be reached for it. The demand is read out of the
        // procedure LIST -- the same arms route_prose renders, so there is one source for what a
        // mechanism requires and no second classification of it.
        !procedure_demands_existing_option(route: route)
    }
  }
}

// EXISTS OVER THE PROCEDURE, not a re-classification of it: this asks the list `route_requires`
// already returns whether one named requirement is in it. It adds no new vocabulary about routes --
// the requirement is a member of ProcedureRequires, written by the same match that writes the rest
// of the procedure.
// MEMBERSHIP, NOT RE-CLASSIFICATION: std.algebra's canonical `contains` asks whether the named
// requirement is among the arms `route_requires` already returns. The first version hand-rolled this
// as filter(match each arm to true/false) |> length > 0, which is a second classification of a
// coproduct that already exists -- six arms written down again, all but one of them ignored, and a
// new ProcedureRequires arm would have to be added here to be answered false. Equality comes from
// `==` on the union, the same structural equality the witness uses elsewhere, so there is no
// hand-written comparator and nothing to drift.
fn procedure_demands_existing_option(route: FirmwareNetworkBootPreparationRoute) -> Bool {
  contains(
    xs: route_requires(route: route),
    item: RequiresExistingBootOption,
    eq: fn(a, b) { a == b },
  )
}

// NO HAND-WRITTEN EQUALITIES HERE. Route and blocker identity are structural `==` (verified
// against this compiler): the earlier `route_eq`/`blocking_eq` were a hand-maintained second
// definition of identity that had to be kept in step with the arms -- and `route_eq`'s job was
// really 'is this free-floating route one of ours', which is a membership question the catalog
// answers by lookup, not by comparison. Review 81760.

// ---------------------------------------------------------------------------
// THE SEAM.
// ---------------------------------------------------------------------------

// READY CARRIES ONE AXIS, NOT TWO (review 81689). An earlier cut of this type stored a
// ClientNetworkBootMode beside a second `NetworkBootProtocol` enum of mine. That enum was a
// nickname: its two arms were extdeps.provisioning.network_boot's DhcpBootDirection.ProxyDhcp and
// ClientNetworkBootMode.UefiHttpBoot wearing new names, and having an axis of my own beside the
// upstream one is what let a Ready state the pair (DhcpProxy, UefiHttpBoot) -- a URL handed over a
// proxy offer that cannot carry one -- and what forced the seam to invent a TFTP root to fill the
// derived half. DESIGN.md 5: correctness by construction, not validation. So the second axis is
// gone: what the unit is booting IS ClientNetworkBootMode, stated once, by its upstream type, and
// supplied by the caller that actually knows the edge. The DHCP direction is a wire fact the site
// edge receipts (S7) observe; it is not the unit's standing.

// READY IS NOT AUTHORABLE. ReadyEvidence is sole_constructor and its only constructor takes the
// observation it was computed from, the authority that published it, and the moment it was taken.
// So "ready" without evidence is not a thing that can be written down, and a Ready that someone
// hand-rolled cannot be distinguished from a computed one — because there is no second way to
// get one. The observation stays INSIDE the evidence rather than being dropped after the check,
// so a later reader can re-derive the verdict instead of trusting it.
type ReadyEvidence sole_constructor {
  observation_authority: CitedFigureStanding
  observed_at: EpochMs
  observation: FirmwareBootObservation
}

fn ready_evidence(
  observation_authority: CitedFigureStanding,
  observed_at: EpochMs,
  observation: FirmwareBootObservation
) -> ReadyEvidence {
  ReadyEvidence {
    observation_authority: observation_authority,
    observed_at: observed_at,
    observation: observation,
  }
}

type FirmwareNetworkBootStanding
  = Ready {
      firmware_mode: ClientNetworkBootMode,
      network_interface: NonEmptyStr,
      // WHICH NETWORK TARGET THE UNIT WILL ACTUALLY BOOT, taken from the boot-order head.
      // (review 81853) This field is the reason the classification is a union at all: the fold used
      // to prove 'something network-shaped is present' via a Bool and discard the kinds, so a Ready
      // could not tell an operator whether the board was going to PXE or to UEFI-HTTP. It is NOT a
      // second name for `firmware_mode` -- that is the EDGE's claim about the client, this is the
      // UNIT's own answer about the device it will use. The two are different facts and are allowed
      // to disagree (an HTTP-serving edge in front of a unit whose head option is PXE is exactly such
      // a unit), and the disagreement is only reportable because both are carried.
      boot_target: RedfishBootSourceOverrideTarget,
      evidence: ReadyEvidence,
    }
  | NeedsPreparation { route: FirmwareNetworkBootPreparationRoute, blocking: PreparationBlockingOn }
  | Unobserved { unanswered: List<UnansweredAxis> }
  // `gaps` is not decoration (review 81689): the earlier shape short-circuited at the FIRST
  // unanswered axis, so a unit missing both its boot order and its Secure Boot answer was
  // reported as missing only one, and an early refusal hid every later unknown. That is a lossy
  // report, and DESIGN.md 5 asks for every degradation typed, located and countable. A single
  // `cause` stays because an executor acts on one thing at a time; `gaps` says everything else the
  // fleet still does not know about this unit, so the operator learns it all in one visit instead
  // of one per attempt.
  | Refused { cause: FirmwareNetworkBootRefusal, gaps: List<UnansweredAxis> }

// WHAT IS IN THE WAY, named. A NeedsPreparation that says only "not ready" sends someone to
// re-read the observation themselves; the blocking axis says what to act on, and it is a
// different question from the route (which is HOW to act).
// THE BLOCKERS ARE SPLIT WHERE THE REMEDIES DIVERGE (review 81802). These two used to be ONE arm,
// `NoNetworkBootOptionListed`, covering both 'the unit lists no network option' and 'a network
// option exists and the boot order does not name it'. One arm meant one remedy set, and the remedy
// set this fleet drives for the area is three REDIRECTS -- mechanisms that point the next boot at an
// option that ALREADY exists. Correct for the second case; IMPOSSIBLE for the first. A unit with
// nothing to point at was being handed a plan that cannot succeed, and the precondition that made
// the pairing impossible ('this route needs an option that already exists') lived only in the prose
// field `obligation`, which nothing reads. So the fix is not a comment: it is splitting the blocker
// at the place the two observations actually differ, which is exactly where `decide` can already
// tell them apart by counting.
//
//   NetworkBootOptionAbsent       -- the BootOptions enumeration contains no network-kind entry.
//                                    Only a mechanism that CREATES one can help, so the catalog
//                                    credits it the BIOS stack attribute (on this firmware the PXE
//                                    option exists because the stack is enabled, so enabling it IS
//                                    the authoring), and every redirect is excluded by
//                                    `route_is_admissible_for`: a redirect's procedure carries
//                                    `RequiresExistingBootOption` and this blocker says there is
//                                    none. Not a refusal, because the fleet does own a mechanism.
//   NetworkBootOptionNotSelected  -- an option EXISTS and the boot order does not name it. This is
//                                    the case redirects were built for, and the only case they
//                                    should ever have been reached for.
//
// NEITHER CARRIES AN OPTION COUNT. 'Four options, none of them network' and 'the unit lists nothing
// at all' are worth distinguishing in a report, but the observation already carries both lists, so
// a report can count them there; a number in the blocker would be a second home for a fact the probe
// owns, and no decision in the seam reads it (DESIGN 3: net concepts must not grow by re-invention).
type PreparationBlockingOn
  = NetworkBootOptionAbsent
  | NetworkBootOptionNotSelected
  | NoInterfaceCarriesPxe
  | SecureBootBlocksUnsignedChainloader
  | OverrideMechanismUnsupported

// Which axis came back unanswered. Axis-level attribution is what lets a fleet report say "three
// units were never asked about Secure Boot" instead of the earlier, useless "some units are not
// ready".
// WHY AN AXIS CAN BE MISSING IN TWO TYPED WAYS. 'We never asked' and 'we asked and were told no'
// have different remedies, and BOTH are gaps the report must be able to count. Keeping them as
// one reason string would let a probe coverage gap and a transport refusal be tallied together,
// which is how 'BMC will not answer' gets filed as 'nobody ran the probe'.
type AxisAbsence
  = AxisNotAsked { reason: NonEmptyStr }
  | AxisRefused { refusal: FirmwareReadRefusal }

type UnansweredAxis
  = BootOrderAxisUnanswered { absence: AxisAbsence }
  | BootOptionsAxisUnanswered { absence: AxisAbsence }
  | NetworkInterfaceAxisUnanswered { absence: AxisAbsence }
  | SecureBootAxisUnanswered { absence: AxisAbsence }
  | BiosAxisUnanswered { absence: AxisAbsence }

// A REFUSAL IS A STANDING, and its cause set is closed over exactly the ways an agent can say no
// to this question: a transport that rejects the command, a firmware mode this fleet's edge will
// not serve, an operator policy, and a unit that is not there. A refusal with no cause is not in
// the set, because an uncaused refusal cannot be acted on and so cannot be reported usefully.
type FirmwareNetworkBootRefusal
  = TransportRefusedVendorCommand { refusal: FirmwareReadRefusal }
  | FirmwareModeUnsupportedByEdge { why: NonEmptyStr }
  | RefusedByOperatorPolicy { policy: NonEmptyStr }
  // THE UNIT HAS NO NETWORK INTERFACE AT ALL (review 81893). This used to be `NoSuchUnit`, which sent
  // an operator or an actuator to inventory for a unit that is present, answered every axis, and told
  // us it has no NIC -- a hardware fact whose remedy is the firmware setting that enables the port.
  // DESIGN 3: one name, two materially different meanings, and the material difference here is the
  // REMEDY, which is exactly what a refusal cause exists to route.
  | NoNetworkInterfacePresent { why: NonEmptyStr }
  // A blocker the catalog owns no remedy for. Reachable only by an edit to this module's table --
  // which is the point: it turns 'someone added a blocker and a route by hand' into a visible
  // refusal instead of an attempt that cannot possibly boot.
  | NoRouteOwnsThisBlocking { why: NonEmptyStr }
  // THE TWO FIRMWARE ENUMERATIONS DISAGREE (review 81802's split made this state reachable, and it
  // deserves naming rather than an inference). BootOrder references a network-kind entry that the
  // BootOptions enumeration does not list. Choosing a side would be guessing which read is stale --
  // and the guess here carries a persistent firmware write -- so the seam stops and says which two
  // facts are in conflict.
  | BootOrderNamesUnenumeratedNetworkOption { why: NonEmptyStr }

// ---------------------------------------------------------------------------
// THE ATTEMPT. One boot attempt, from the change through the reset to the DHCP it produced.
//
// THE BOOT-CONTROL RECEIPT IS ABSORBED, NOT DUPLICATED. gunbc.network_boot_delivery already
// owns what a boot-control change's receipt looks like (NetworkBootBootControlReceipt) and how
// it can fail to exist (BootControlReceiptStanding); a second spelling of that receipt here
// would let the two disagree about whether the same override was ever recorded, which is the
// precise class of bug this seam exists to remove. The attempt therefore imports those types and
// adds only the two things delivery does not model: the firmware ROUTE the attempt took, and the
// DHCP the resulting boot produced.
// ---------------------------------------------------------------------------

type NetworkBootAttempt {
  route: FirmwareNetworkBootPreparationRoute
  boot_control: BootControlReceiptStanding
  reset_observed_at: EpochMs
  resulting_dhcp: AttemptDhcpStanding
  unit_label: NonEmptyStr
}

// CONSTRUCTION IS A VERDICT, NOT AN OPTIONAL, AND THE CALLER NEVER SUPPLIES A ROUTE
// (review 81760). `NetworkBootAttempt` used to take a free route and check it against the catalog at
// runtime -- `if route_is_cataloged(...)`, backed by a hand-written `route_eq` -- which is the same
// failure as the catalog rows being writable by hand, one level down: an unrepresentable state was
// represented and then policed. The caller now names the BLOCKER it believes is in the way and the
// module supplies the mechanism by looking it up, so there is no path on which a caller hands in a
// route the fleet does not own, and no membership test to get wrong. Absent is reported, not
// swallowed: an attempt whose blocker the fleet owns no mechanism for is a one-off nobody can
// reproduce or audit, so it is refused at the boundary where refusal is still cheap -- and the
// refusal names the blocker, which is the thing an operator needs.
//
// The blocker is not stored on the attempt: `blocker_of(attempt.route)` already says it, and storing
// it beside the route is the ready-to-drift pattern this module has now removed in three places
// (Ready's mode, the catalog row's blocker, and here).
type NetworkBootAttemptConstruction
  = AttemptConstructed { attempt: NetworkBootAttempt }
  | AttemptBlockerUncataloged { blocker: PreparationBlockingOn }

fn network_boot_attempt(
  blocker: PreparationBlockingOn,
  boot_control: BootControlReceiptStanding,
  reset_observed_at: EpochMs,
  resulting_dhcp: AttemptDhcpStanding,
  unit_label: NonEmptyStr
) -> NetworkBootAttemptConstruction {
  match route_for_blocking(blocker: blocker) {
    Present { value: route } =>
      AttemptConstructed {
        attempt: NetworkBootAttempt {
          route: route,
          boot_control: boot_control,
          reset_observed_at: reset_observed_at,
          resulting_dhcp: resulting_dhcp,
          unit_label: unit_label,
        },
      }
    Absent => AttemptBlockerUncataloged { blocker: blocker }
  }
}

// What the attempt's reset produced on the wire. These three are different facts: no packet
// (the edge never answered), an offer that was not for us (another edge answered, or the router
// is answering when it should not be), and an offer we can take. Collapsing the first two is how
// "PXE is broken" gets reported when the real finding is "two DHCP edges are both answering".
type AttemptDhcpStanding
  = DhcpOfferObserved { offer_ref: NonEmptyStr }
  | DhcpSilent { why: NonEmptyStr }
  | DhcpForeignOffer { observed_from: NonEmptyStr }

// An attempt's receipt: the standing it ended in plus the change it made. Sole_constructor, so a
// receipt cannot be authored without the attempt it receipts and the standing it produced.
// NO control_receipt FIELD. The attempt already owns the boot-control standing (absorbed from
// gunbc.network_boot_delivery); carrying a second copy here would give the same fact two homes
// that can disagree, which is the defect this seam exists to remove.
type FirmwareNetworkBootAttemptReceipt sole_constructor {
  attempt: NetworkBootAttempt
  outcome: FirmwareNetworkBootStanding
}

fn firmware_network_boot_attempt_receipt(
  attempt: NetworkBootAttempt,
  outcome: FirmwareNetworkBootStanding
) -> FirmwareNetworkBootAttemptReceipt {
  FirmwareNetworkBootAttemptReceipt { attempt: attempt, outcome: outcome }
}

// ---------------------------------------------------------------------------
// THE READINESS FN. TOTAL: every input produces a standing; nothing errors, nothing panics.
//
// THE ORDER OF THE CHECKS IS THE FLEET'S ANSWER TO "what do we ask first", and it is load-bearing:
// any one axis Unobserved outranks a plausible-looking Ready, because an absent Secure Boot answer
// is exactly the case in which a false Ready is most expensive (it sends an unsigned chainloader
// at a board that will refuse it, and the failure shows up as a timeout on the far end).
// ---------------------------------------------------------------------------

fn firmware_network_boot_standing(
  observation: FirmwareBootObservation,
  authority: CitedFigureStanding,
  observed_at: EpochMs,
  boot_mode: ClientNetworkBootMode
) -> FirmwareNetworkBootStanding {
  // THE EDGE'S OWN LIMITATION OUTRANKS THE FIRMWARE'S ANSWERS: a unit whose firmware the edge
  // cannot serve is not "unready firmware", it is a mismatch between the unit and OUR edge, and
  // the report has to say which one has to change. Gaps still ride along, because the unit may
  // ALSO be unanswered on other axes and that is worth knowing before someone drives over with a
  // console.
  match edge_serviceable_for_mode(boot_mode: boot_mode) {
    // The refusal's `why` is the arm's own data. There is no second match on ClientNetworkBootMode
    // anywhere in this module, so there is no arm left that could return a sentence about a case it
    // was not asked about (review 81853); and a caller that dropped this arm could not construct a
    // FirmwareNetworkBootStanding at all.
    EdgeCannotServe { why: why } =>
      Refused {
        cause: FirmwareModeUnsupportedByEdge { why: why },
        gaps: axis_gaps(observation: observation),
      }
    EdgeCanServe => {
    // TWO PHASES, NOT ONE SHORT-CIRCUITING MATCH (review 81689). Phase one asks every axis what
    // it has; phase two decides. The earlier single nested match returned at the FIRST unanswered
    // axis, which lost information the type had promised to carry: a unit missing both Secure Boot
    // and BIOS version was reported as missing only Secure Boot, and any refusal made the later
    // unknowns invisible. Counting the gaps first is also what makes the report queryable per
    // axis, which is the entire reason UnansweredAxis names an axis at all.
    let gaps = axis_gaps(observation: observation)
    if length(xs: gaps) > 0 {
      match first_refusal(gaps: gaps) {
        Present { value: refusal } =>
          Refused { cause: TransportRefusedVendorCommand { refusal: refusal }, gaps: gaps }
        Absent => Unobserved { unanswered: gaps }
      }
    } else {
      // EVERY AXIS IS ANSWERED, so the decision can be made -- and it is made in ONE place.
      // This used to be a second copy of the axis fan-out, matching boot_order, then
      // boot_options, then nics, then secure_boot, then bios_version again, and passing four
      // destructured lists to `decide` alongside the observation. That duplication was not
      // cosmetic (merry-fox-82, blocker 2): the four lists were arguments a caller-controlled
      // value could contradict, and the two copies of 'what does a refused BootOrder mean' could
      // drift. `decide` now takes the observation ALONE and does its own exhaustive match, so a
      // refused or unanswered axis has exactly one meaning in this module and the Ready below
      // reports on the same bytes its evidence quotes.
      decide(
        observation: observation,
        authority: authority,
        observed_at: observed_at,
        boot_mode: boot_mode,
      )
    }
    }
  }
}

// EVERY UNANSWERED AXIS, IN BOOT-ORDER-TO-BIOS ORDER, WITH ITS KIND. No short-circuit: this walk
// is the difference between 'the unit is not ready' and 'these three axes were never asked, and
// the fourth refused us'. Order is fixed so the report reads the same for the same unit every
// time, which matters when two operators are comparing notes on the same machine.
fn axis_gaps(observation: FirmwareBootObservation) -> List<UnansweredAxis> {
  concat(
    concat(boot_order_gap(boot_order: observation.boot_order), boot_options_gap(options: observation.boot_options)),
    concat(
      nics_gap(nics: observation.nics),
      concat(secure_boot_gap(secure_boot: observation.secure_boot), bios_gap(bios_version: observation.bios_version)),
    ),
  )
}

fn boot_order_gap(boot_order: BootOrderObservation) -> List<UnansweredAxis> {
  match boot_order {
    BootOrderObserved { devices: _ } => []
    BootOrderUnobserved { reason: r } => [BootOrderAxisUnanswered { absence: AxisNotAsked { reason: r } }]
    BootOrderRefused { refusal: f } => [BootOrderAxisUnanswered { absence: AxisRefused { refusal: f } }]
  }
}

fn boot_options_gap(options: BootOptionsObservation) -> List<UnansweredAxis> {
  match options {
    BootOptionsObserved { options: _ } => []
    BootOptionsUnobserved { reason: r } => [BootOptionsAxisUnanswered { absence: AxisNotAsked { reason: r } }]
    BootOptionsRefused { refusal: f } => [BootOptionsAxisUnanswered { absence: AxisRefused { refusal: f } }]
  }
}

fn nics_gap(nics: NicsObservation) -> List<UnansweredAxis> {
  match nics {
    NicsObserved { nics: _ } => []
    NicsUnobserved { reason: r } => [NetworkInterfaceAxisUnanswered { absence: AxisNotAsked { reason: r } }]
    NicsRefused { refusal: f } => [NetworkInterfaceAxisUnanswered { absence: AxisRefused { refusal: f } }]
  }
}

fn secure_boot_gap(secure_boot: SecureBootObservation) -> List<UnansweredAxis> {
  match secure_boot {
    SecureBootEnabled => []
    SecureBootDisabled => []
    SecureBootUnobserved { reason: r } => [SecureBootAxisUnanswered { absence: AxisNotAsked { reason: r } }]
    SecureBootRefused { refusal: f } => [SecureBootAxisUnanswered { absence: AxisRefused { refusal: f } }]
  }
}

fn bios_gap(bios_version: BiosVersionObservation) -> List<UnansweredAxis> {
  match bios_version {
    BiosVersionObserved { version: _ } => []
    BiosVersionUnobserved { reason: r } => [BiosAxisUnanswered { absence: AxisNotAsked { reason: r } }]
    BiosVersionRefused { refusal: f } => [BiosAxisUnanswered { absence: AxisRefused { refusal: f } }]
  }
}

// THE FIRST REFUSAL IS THE ONE AN EXECUTOR ACTS ON, so Refused keeps a single cause: a human
// chasing four refusals at once does none of them. That is an executor convenience, not a report
// limit -- `gaps` carries all of them, refusals included.
// THE FIRST REFUSAL, DECIDED ONCE. `first` over the mapped option list: `refusal_of_gap` is the
// only function that reads an axis and says whether it refused, and filter_map-style selection over
// its Optional is the same question asked a second time. The earlier shape ran gap_is_refusal to
// pick a gap and then refusal_of_gap to extract from the gap it had just picked -- two readings of
// one fact, which is DESIGN 3's rule restated (review 81780).
fn first_refusal(gaps: List<UnansweredAxis>) -> Optional<FirmwareReadRefusal> {
  refusals_in_order(gaps: gaps) |> first
}

// THE REFUSALS, IN GAP ORDER, WITHOUT AN OPTIONAL-OF-OPTIONAL IN THE MIDDLE. Collecting into a
// plain list and taking `first` is the same shape the catalog lookup uses; mapping to Optional and
// filtering the Absents instead would produce List<Optional<_>>, which this resolver cannot type a
// value out of -- an awkwardness of the toolchain, noted so nobody reintroduces the shape and reads
// the failure as a modeling problem.
fn refusals_in_order(gaps: List<UnansweredAxis>) -> List<FirmwareReadRefusal> {
  fold_list(
    xs: gaps,
    empty: [] as List<FirmwareReadRefusal>,
    cons: fn(acc, gap) {
      match refusal_of_gap(gap: gap) {
        Present { value: refusal } => list_append(left: acc, right: refusal)
        Absent => acc
      }
    },
  )
}

fn refusal_of_gap(gap: UnansweredAxis) -> Optional<FirmwareReadRefusal> {
  match gap_absence(gap: gap) {
    AxisRefused { refusal: f } => Present { value: f }
    AxisNotAsked { reason: _ } => Absent
  }
}

// The absence behind any named axis, so the five constructor arms stay one union for consumers.
fn gap_absence(gap: UnansweredAxis) -> AxisAbsence {
  match gap {
    BootOrderAxisUnanswered { absence: a } => a
    BootOptionsAxisUnanswered { absence: a } => a
    NetworkInterfaceAxisUnanswered { absence: a } => a
    SecureBootAxisUnanswered { absence: a } => a
    BiosAxisUnanswered { absence: a } => a
  }
}


// THE ONE PLACE A NeedsPreparation IS CONSTRUCTED. Which mechanism can move which blocker is no
// longer something this fn (or anyone) can get wrong: the remedy a row may carry is fixed by the
// arm of RouteAuthority that had to be constructed to reach here, so there is no pair to validate
// and no second copy of the rule to keep in step with the first. A blocker with no row is a
// modeling gap IN THIS MODULE and is reported as a refusal naming it -- inventing a route for a
// blocker nobody has written a remedy for is exactly what produces an attempt that cannot boot.
fn prepare(blocker: PreparationBlockingOn) -> FirmwareNetworkBootStanding {
  match route_for_blocking(blocker: blocker) {
    Present { value: route } => NeedsPreparation { route: route, blocking: blocker }
    Absent =>
      Refused {
        cause: NoRouteOwnsThisBlocking { why: "no catalog row resolves this blocker" },
        gaps: [],
      }
  }
}

// The three facts that actually make a unit bootable over the network: a network stack the
// firmware will try, a network option it can be pointed at, and exactly one interface to do it
// on. Anything else is either preparation or a refusal — never a silent Ready.
// THE DECISION, GIVEN ONE OBSERVATION. It takes the observation and nothing else that could
// contradict it (merry-fox-82, blocker 2): the earlier signature carried `devices`, `options`,
// `nics` and `bios` ALONGSIDE `observation`, so a caller could hand in four lists that agreed with
// each other and disagreed with the observation the evidence would later quote. Every fact now comes
// out of `observation`, which means the Ready at the bottom and the evidence it carries are computed
// from the same bytes -- there is no second copy to keep in sync, and no argument to forge.
//
// THE TWO ENUMERATIONS ANSWER DIFFERENT QUESTIONS, AND THE OLD FOLD ASKED THE WRONG ONE OF EACH.
// BootOptions answers 'does an option EXIST, of what kind, enabled?' (review 81802); BootOrder
// answers 'which one is SELECTED, in what position?' (review 81853, merry blocker 1). Each question
// goes to the mechanism that can answer it:
//
//   nothing exists             -> NetworkBootOptionAbsent      -> authoring (the stack attribute)
//   exists, not selected       -> NetworkBootOptionNotSelected -> redirect  (UefiBootNext / one-shot)
//   selected, usable, one NIC  -> Ready, quoting the joined option
//
// ORDERED THAT WAY ON PURPOSE: existence is checked first because it decides which mechanism is
// even possible, and a redirect is never offered for the absent case -- `route_is_admissible_for`
// drops one if a row ever claims it (rung 2, mechanically preventable, not a type guarantee).
fn decide(
  observation: FirmwareBootObservation,
  authority: CitedFigureStanding,
  observed_at: EpochMs,
  boot_mode: ClientNetworkBootMode
) -> FirmwareNetworkBootStanding {
  // EVERY FACT BELOW IS READ OUT OF THE OBSERVATION. The four matches here are exhaustive, so an
  // unanswered axis cannot be mistaken for an answered one -- the arms exist because the compiler
  // requires them, and each reports rather than lying, so a future gap-pass bug surfaces as an
  // Unobserved instead of a fabricated Ready.
  match observation.boot_order {
    BootOrderRefused { refusal: f } =>
      Refused { cause: TransportRefusedVendorCommand { refusal: f }, gaps: axis_gaps(observation: observation) }
    BootOrderUnobserved { reason: r } =>
      Unobserved { unanswered: [BootOrderAxisUnanswered { absence: AxisNotAsked { reason: r } }] }
    BootOrderObserved { devices: devices } =>
      match observation.boot_options {
        BootOptionsRefused { refusal: f } =>
          Refused { cause: TransportRefusedVendorCommand { refusal: f }, gaps: axis_gaps(observation: observation) }
        BootOptionsUnobserved { reason: r } =>
          Unobserved { unanswered: [BootOptionsAxisUnanswered { absence: AxisNotAsked { reason: r } }] }
        BootOptionsObserved { options: options } =>
          match observation.nics {
            NicsRefused { refusal: f } =>
              Refused { cause: TransportRefusedVendorCommand { refusal: f }, gaps: axis_gaps(observation: observation) }
            NicsUnobserved { reason: r } =>
              Unobserved { unanswered: [NetworkInterfaceAxisUnanswered { absence: AxisNotAsked { reason: r } }] }
            NicsObserved { nics: nics } =>
              match observation.secure_boot {
                SecureBootRefused { refusal: f } =>
                  Refused { cause: TransportRefusedVendorCommand { refusal: f }, gaps: axis_gaps(observation: observation) }
                SecureBootUnobserved { reason: r } =>
                  Unobserved { unanswered: [SecureBootAxisUnanswered { absence: AxisNotAsked { reason: r } }] }
                SecureBootEnabled =>
                  // Secure Boot ON with an unsigned chainloader is neither Ready nor Refused: a
                  // covering certificate may make it boot, which is an observation we do not have.
                  // Preparation with a route -- the enrolment or the attribute change a human performs.
                  prepare(blocker: SecureBootBlocksUnsignedChainloader)
                SecureBootDisabled =>
                  match observation.bios_version {
                    BiosVersionRefused { refusal: f } =>
                      Refused { cause: TransportRefusedVendorCommand { refusal: f }, gaps: axis_gaps(observation: observation) }
                    BiosVersionUnobserved { reason: r } =>
                      Unobserved { unanswered: [BiosAxisUnanswered { absence: AxisNotAsked { reason: r } }] }
                    BiosVersionObserved { version: _ } => decide_from_joins(
                      join: join_head_to_options(devices: devices, options: options),
                      available: available_network_options(options: options),
                      nics: nics,
                      boot_mode: boot_mode,
                      authority: authority,
                      observed_at: observed_at,
                      observation: observation,
                    )
                  }
              }
          }
      }
  }
}

// THE JOIN ARMS DECIDE THE BLOCKER; NOTHING ELSE IS ASKED OF THE TWO LISTS. Split out of `decide`
// so the axis fan-out above stays a single-screen read and the boot-option reasoning stays one
// match on one value.
fn decide_from_joins(
  join: HeadJoinStanding,
  available: AvailableNetworkStanding,
  nics: List<NonEmptyStr>,
  boot_mode: ClientNetworkBootMode,
  authority: CitedFigureStanding,
  observed_at: EpochMs,
  observation: FirmwareBootObservation
) -> FirmwareNetworkBootStanding {
  match join {
    // THE HEAD DOES NOT APPEAR IN THE ENUMERATION, and the enumeration was not empty. Two positive
    // reads disagree -- real firmware does this (a hidden or vendor-removed option stays listed in
    // BootOrder). Neither read may be silently trusted over the other: the alternative is a
    // persistent BIOS write justified by guessing which read is stale, which is exactly the uncaused
    // plausible action a refusal exists to prevent (DESIGN 5). The remedy is a re-read of BootOptions,
    // which is why the reference and the count both travel with the cause.
    HeadOptionNotEnumerated { order_head_reference: _, enumerated_count: _ } =>
      Refused {
        // THE SPECIFICS TRAVEL AS TYPED FIELDS ON THE CAUSE, not interpolated into this sentence. The
        // fold already knows the reference and the count and puts them on the arm; repeating them
        // here would create a second copy that can drift from the fields a machine reads, and a
        // diagnostic whose prose disagrees with its own typed payload is worse than one with no prose
        // (DESIGN 5: no plausible output is fabricated). The sentence names the situation and the
        // remedy; the arm carries the evidence.
        cause: BootOrderNamesUnenumeratedNetworkOption {
          why: "the BootOrder head references a BootOptionReference the BootOptions enumeration does not contain, while the enumeration was non-empty; the two reads disagree and neither may be trusted over the other without a re-read of BootOptions",
        },
        gaps: axis_gaps(observation: observation),
      }
    // THE HEAD IS ENABLED, so the join is real and its kind is in hand. But ENABLED IS NOT NETWORK:
    // the head may well be the disk, which is the normal state of every unit in the fleet that boots
    // normally. So the kind is asked here, of the joined option (extdeps.bmc.types classifies it, so
    // this module adds no notion of network-ness of its own):
    //   network head + one NIC -> Ready, quoting the joined option
    //   non-network head       -> the selection is wrong, not the firmware. Whether that is a
    //                             redirect or a BIOS write depends on whether a usable network option
    //                             EXISTS, which is the OTHER join's answer -- hence decide_absent
    //                             rather than a hardcoded blocker.
    // The two BootOrder orderings [PXE, disk] and [disk, PXE] now take different paths through this
    // arm, which is precisely merry-fox-82's blocker 1: the old fold filtered the order to network
    // kinds before taking the head, so both read Ready.
    HeadJoinsEnabledOption { head: head_option } =>
      match redfish_boot_target_network_standing(t: head_option.kind) {
        NetworkBootTarget { via: _ } =>
          ready_or_refuse_on_nics(
            head_option: head_option,
            nics: nics,
            boot_mode: boot_mode,
            authority: authority,
            observed_at: observed_at,
            observation: observation,
          )
        NotNetworkBootTarget { why: _ } => decide_absent(available: available)
      }
    // THE HEAD IS LISTED BUT DISABLED: the firmware will not boot it as things stand. Not a Ready
    // (the unit does not boot it), not a refusal (nothing is broken; this is a configuration the
    // fleet can change). The blocker is 'not selected' because the remediation is the same shape --
    // point the firmware at a usable entry, one-shot or persistent -- and a disabled entry is
    // precisely what a one-shot override exists to bypass.
    HeadJoinsDisabledOption { head: _ } =>
      prepare(blocker: NetworkBootOptionNotSelected)
    // NOTHING IS SELECTED, OR THE ENUMERATION WAS EMPTY. Both mean 'there is nothing to select yet',
    // which is the ordinary shape of a board nobody has ever configured -- and NOT the conflict
    // above, which required a non-empty enumeration to disagree with. Existence is answered before
    // selection because it decides which mechanism is possible: with nothing usable to point at, only
    // the authoring route can help, and the catalog has exactly one.
    HeadOrderEmpty => decide_absent(available: available)
    HeadEnumerationEmpty { examined_count: _ } => decide_absent(available: available)
  }
}

// THE ABSENT CASE, ASKED OF THE ENUMERATION RATHER THAN THE ORDER. `available` is what makes this
// more than `prepare(NetworkBootOptionAbsent)`: an order can be empty because the board is
// unconfigured, or because every network option in the enumeration is DISABLED -- and those two
// have different remediations. A disabled option exists, so the authoring route is not what is
// missing; what is missing is that nobody enabled it.
fn decide_absent(available: AvailableNetworkStanding) -> FirmwareNetworkBootStanding {
  match available {
    AvailableNetworkOptionsPresent { head: _, additional_count: _ } =>
      // Options exist and at least one is a usable network target; the order simply does not select
      // it. Redirect, do not write BIOS.
      prepare(blocker: NetworkBootOptionNotSelected)
    NoAvailableNetworkOption { examined_count: _ } =>
      // Nothing usable exists at all: the network stack has to be authored first.
      prepare(blocker: NetworkBootOptionAbsent)
  }
}

// THE LAST TWO FACTS BEFORE A VERDICT: is there exactly one interface to boot from, and which NIC
// is it. Extracted rather than nested deeper, so the boot-option reasoning stays readable in one
// pass -- the fold's whole job is getting these questions into the right order.
fn ready_or_refuse_on_nics(
  head_option: BootOption,
  nics: List<NonEmptyStr>,
  boot_mode: ClientNetworkBootMode,
  authority: CitedFigureStanding,
  observed_at: EpochMs,
  observation: FirmwareBootObservation
) -> FirmwareNetworkBootStanding {
  // ONE MATCH OVER THE THREE SHAPES, not a length ladder followed by `|> first` (review 81893). The
  // ladder needed FOUR outcomes for three questions: zero, one, several -- and 'counted exactly one
  // but the head was Absent', a state that can only arise from the fold disagreeing with itself. Three
  // arms, three remedies, and no arm that has to guess what its own contradiction means.
  match nic_candidates(nics: nics) {
    // A HARDWARE FACT ABOUT THE UNIT, and the most common real finding on a board whose NIC firmware
    // is disabled -- which is why it gets its own name rather than wearing a generic 'no such unit'.
    // An operator reading the wrong name would go looking for a missing unit in inventory.
    NoNicCandidate =>
      Refused {
        cause: NoNetworkInterfacePresent {
          why: "every axis answered and the boot order's head joins a usable network option, but the firmware reports no bootable network interface at all",
        },
        gaps: [],
      }
    // Several candidates and no evidence which port carries PXE is a PREPARATION question. Taking the
    // first would be machine-name selection wearing a different hat: stable, reproducible, and wrong
    // on the first unit whose ports differ from the guess. Review 81711: this branch used to get a
    // Redfish one-shot override, which redirects among EXISTING entries and so cannot answer 'which
    // port' -- the same defect review 81802 caught in the sibling branch.
    SeveralNicCandidates { count: _ } =>
      prepare(blocker: NoInterfaceCarriesPxe)
    // THE ONLY READY IN THE MODULE. The head option arrived here by reference join, so `boot_target`
    // is the kind the ENUMERATION says the boot-order head is -- not a target this fold selected from
    // a filtered list, which is what made the old verdict wrong for [Hdd, Pxe] (merry blocker 1).
    // The label is never consulted: it is kept for a human reading a console, and a guess against
    // 'Network'/'HTTP'/'NIC1' is how a Ready boots nothing (DESIGN 4: a heuristic is never
    // necessary when the typed source exists).
    OneNicCandidate { nic: nic } =>
      Ready {
        // The mode is the caller's edge fact, carried through untouched. The seam adds no site
        // knowledge of its own: no TFTP root, no URL, no board spelling.
        firmware_mode: boot_mode,
        network_interface: nic,
        // WHAT WILL ACTUALLY BOOT, quoted from the joined option (review 81853). This is where the
        // brief's `protocol` lives. It is NOT a second name for `firmware_mode` -- that is the EDGE's
        // claim about the client, this is the UNIT's own answer about the device it will use, and the
        // two may disagree (an HTTP-serving edge in front of a unit whose head is PXE is exactly such
        // a unit), which is reportable only because both are carried.
        boot_target: head_option.kind,
        evidence: ready_evidence(
          observation_authority: authority,
          observed_at: observed_at,
          observation: observation,
        ),
        // NO gaps FIELD, AND NOT AN OMITTED ONE -- Ready has no such arm field (only Refused does,
        // review 81689). This is the one place in the module that may mint a Ready, and it is
        // reachable only after every axis has been matched as answered, so a gap list here could only
        // ever be empty: an always-empty list would invite a reader to believe gaps are sometimes
        // reported on a Ready. If a future change lets a Ready be reached with an unanswered axis, the
        // compiler makes that a type error rather than a silent short-circuit.
      }
  }
}

// WHETHER A LIST OF FIRMWARE BOOT ENTRIES CONTAINS A NETWORK TARGET -- ANSWERED WITH THE KINDS, NOT
// WITH A YES/NO (review 81853).
//
// extdeps.bmc.types introduces RedfishBootTargetNetworkStanding by saying it answers 'with a union
// rather than a Bool, because the arm IS the finding', and its own comment adds that 'a Bool cannot
// be quoted at an operator when a unit boots the wrong thing'. This module was that union's first
// consumer and the first thing it did was discard the arms: filter(... => true/false) |> length > 0.
// That is a meaning fork (DESIGN 3) -- the classification stays in the tree as decoration while the
// decision runs on a bit -- and the concrete loss was specific: which network target a Ready unit
// will actually boot (PXE, or UEFI-HTTP) was thrown away on the way to a verdict whose entire job is
// to say what the unit can deliver.
//
// BOTH ARMS ARE READ AND NEITHER IS A STAND-IN FOR THE OTHER:
//   * NoNetworkEntry is the enumeration ANSWERING 'none of the N entries I examined is a network
//     target'. That is not silence, and it is not `false`: it is what makes the standing a
//     preparation (a mechanism exists that creates the option) rather than a coverage gap, and its
//     count is what distinguishes a conflict from an unconfigured board in `decide`.
//   * NetworkEntriesPresent carries the kinds in the order the firmware listed them, so the caller
//     can name what it is relying on instead of asserting that 'something network-ish' is present.
//
// WHY A FOLD HERE AND NOT ANOTHER PREDICATE: the classification arrives already typed from extdeps,
// so this module adds no re-derivation of what counts as network -- no spelling list, no local
// notion of network-ness, nothing to drift. It only collects, in one pass, what extdeps said.
// THE SHAPES OF 'WHICH NETWORK OPTIONS DOES THIS LIST CONTAIN', ONE PER QUESTION THE FOLD ASKS.
// (review 81893) Both of these replaced a `length(xs: ...) == 0 / > 1 / else` ladder followed by
// `|> first`, and that ladder is what made three refusals necessary: a fold that COUNTS a list and
// then takes its HEAD can represent states it should never be able to reach -- 'counted one, listed
// none' -- and each unreachable state needs an arm, a cause, and a witness. Matching the shape once
// deletes the states instead of handling them: DESIGN 5, 'stronger than catching a wrong state is
// making it unwritable'.
//
// `NetworkEntryStanding` therefore hands up the HEAD, because the head is the entry the firmware
// will boot, and the only way to get a `Ready` is to have matched a `Present` arm that carries one.
// There is no code path from 'network entries present' to 'Ready' that does not name the target.
type HeadJoinStanding
  // THE HEAD OF THE BOOT ORDER, JOINED TO THE ENUMERATION BY REFERENCE. Five arms because five
  // materially different things are true of a real unit, and each has a different next action:
  //   HeadJoinsEnabledOption      -> the kind and enabled-ness are IN HAND (Ready/prep/NIC phase)
  //   HeadJoinsDisabledOption     -> the firmware will not use it: preparation, not Ready
  //   HeadOptionNotEnumerated     -> the two reads genuinely disagree: refuse, re-read (never guess)
  //   HeadOrderEmpty              -> nothing is selected at all: preparation (author the option)
  //   HeadEnumerationEmpty        -> unconfigured board: preparation, NOT a conflict
  // The old shape collapsed these into "does some network entry exist" twice, once per list, which
  // is what let [Hdd, Pxe] read as Ready/Pxe (merry-fox-82 blocker 1).
  = HeadJoinsEnabledOption { head: BootOption }
  | HeadJoinsDisabledOption { head: BootOption }
  | HeadOptionNotEnumerated { order_head_reference: NonEmptyStr, enumerated_count: Int }
  | HeadOrderEmpty
  | HeadEnumerationEmpty { examined_count: Int }

// THE JOIN. BootOrder answers 'what is selected, in what order'; BootOptions answers 'what exists,
// as what kind, and is it enabled'. Neither answer is complete alone -- the order names references
// it does not characterize, and the enumeration has no order. The join is the ONLY place the two
// are combined, which is the point: with `kind` existing only on BootOption, there is no expression
// in this module that can call the boot-order head a network target without going through an
// enumerated, enabled option that carries that kind.
//
// THE HEAD IS THE FIRMWARE'S FIRST ENTRY, not the first network-looking one. The old fold filtered
// the order down to network kinds before taking the head, so any unit with a disk before its PXE
// entry -- which is every unit that boots its disk normally, i.e. the fleet's default state --
// reported Ready as if it already booted the network. Filtering is what the JOIN replaces.
//
// The accumulator is a plain List and the shape decision is one match on Empty/Cons{head,tail}:
// an Optional-of-record accumulator resolves to T under this compiler (see
// gunbc.recurring_failure_mode.generic_identity_decided_by_spelling), and a length-ladder plus
// `|> first` needed an arm for a contradiction between its own two measurements (review 81893).
fn join_head_to_options(
  devices: List<BootOrderEntry>,
  options: List<BootOption>
) -> HeadJoinStanding {
  match devices {
    Empty => HeadOrderEmpty
    Cons { head: first, tail: _ } =>
      if length(xs: options) == 0 {
        // The order names something and the enumeration returned nothing. Not yet a conflict: an
        // EMPTY BootOptions list is what a board nobody has ever configured answers, and it is not
        // a positive statement that the order's entries are absent. Preparation, never a refusal --
        // refusing here would refuse every unconfigured board, the exact population this cut installs.
        HeadEnumerationEmpty { examined_count: 0 }
      } else {
        match option_with_reference(options: options, reference: first.reference) {
          // THE TWO READS DISAGREE, and neither may be silently trusted over the other. A real
          // firmware does this (a hidden or vendor-removed option left in BootOrder). The honest
          // report is 'your reads disagree, re-read BootOptions' -- not a BIOS write justified by
          // guessing which read is stale (DESIGN 5: no uncaused plausible action).
          Absent => HeadOptionNotEnumerated {
            order_head_reference: first.reference,
            enumerated_count: length(xs: options),
          }
          Present { value: option } =>
            if option.enabled {
              HeadJoinsEnabledOption { head: option }
            } else {
              // The firmware will not boot this entry on its own. That is a fact about the unit's
              // configuration, so it is a PREPARATION, not a refusal and never a Ready: an operator
              // or a route enables it (or points at something else that is enabled).
              HeadJoinsDisabledOption { head: option }
            }
        }
      }
  }
}

// IDENTITY LOOKUP, NO FUZZY FALLBACK. Matching on the reference and nothing else, so a shared
// label cannot join two different options -- the failure that made labels dangerous in the first
// place. `fold_list` so the first match wins deterministically on a firmware that answers twice.
fn option_with_reference(
  options: List<BootOption>,
  reference: NonEmptyStr
) -> Optional<BootOption> {
  // A LIST ACCUMULATOR, then one match -- not fold_list over an Optional<Record>. This compiler
  // decides a generic parameter's identity by its SPELLING, and an Optional-of-record accumulator
  // collides with List's own element child: it resolves the accumulator to `T` and every field read
  // fails to resolve with 'no field head on type T'. That is a documented recurring failure mode
  // (gunbc.recurring_failure_mode.generic_identity_decided_by_spelling), and it bit this module once
  // already at 00a220793, where the whole file failed to resolve.
  let matches: List<BootOption> = fold_list(
    xs: options,
    empty: [],
    cons: fn(acc, option) {
      if option.reference == reference { list_append(left: acc, right: [option]) } else { acc }
    },
  )
  match matches {
    Empty => Absent
    // First match wins, deterministically, on the rare firmware that answers the same reference
    // twice. There is no default, no fallback, and no fuzzy second pass.
    Cons { head: found, tail: _ } => Present { value: found }
  }
}

// HOW MANY ENUMERATED OPTIONS ARE BOOTABLE NETWORK TARGETS, and which comes first. This is the
// BootOptions-side question -- 'does an option EXIST that could be pointed at' -- which is
// DIFFERENT from the order's 'what is selected'. `enabled` is part of existence in the useful
// sense: a listed-but-disabled option cannot be pointed at by UefiBootNext either, so counting it
// as available would send the unit to a redirect that cannot work.
type AvailableNetworkStanding
  = NoAvailableNetworkOption { examined_count: Int }
  | AvailableNetworkOptionsPresent { head: BootOption, additional_count: Int }

fn available_network_options(options: List<BootOption>) -> AvailableNetworkStanding {
  let candidates: List<BootOption> = fold_list(
    xs: options,
    empty: [],
    cons: fn(acc, option) {
      match redfish_boot_target_network_standing(t: option.kind) {
        NetworkBootTarget { via: _ } =>
          if option.enabled { list_append(left: acc, right: [option]) } else { acc }
        NotNetworkBootTarget { why: _ } => acc
      }
    },
  )
  match candidates {
    // The count is the number of options LOOKED AT, not of matches: it is what lets `decide` tell
    // 'the enumeration reported four options, none usable-and-network' from 'the enumeration was
    // empty' (an unconfigured board). Only the first is a conflict with a BootOrder that names one.
    Empty => NoAvailableNetworkOption { examined_count: length(xs: options) }
    Cons { head: first_option, tail: rest } =>
      AvailableNetworkOptionsPresent { head: first_option, additional_count: length(xs: rest) }
  }
}

// THE NIC QUESTION, ANSWERED THE SAME WAY. Three arms because three different things can be true and
// each has a different remedy: no interface at all (a hardware fact, a refusal), exactly one (boot
// from it), or several with no evidence which carries PXE (a preparation: a firmware setting has to
// change). The old code counted, then took `|> first`, and so needed a fourth state -- 'counted one,
// enumerated none' -- which it reported as a refusal with no more meaning than 'my own two
// measurements disagreed' (review 81893).
type NicCandidateStanding
  = NoNicCandidate
  | OneNicCandidate { nic: NonEmptyStr }
  | SeveralNicCandidates { count: Int }

fn nic_candidates(nics: List<NonEmptyStr>) -> NicCandidateStanding {
  // ONE MATCH, THREE SHAPES -- and the interfaces are already a List, so there is nothing to
  // accumulate and nothing to infer. No `|> first` anywhere: the single-interface arm binds the name
  // from the pattern, so 'counted exactly one but could not enumerate it' is not a state this
  // function can return (review 81893: it used to be, and it surfaced as a refusal whose meaning was
  // no more than 'my two measurements disagreed').
  match nics {
    Empty => NoNicCandidate
    // `rest` decides only WHICH non-empty arm this is; the name comes from the pattern.
    Cons { head: only, tail: rest } =>
      if length(xs: rest) > 0 {
        SeveralNicCandidates { count: length(xs: nics) }
      } else {
        OneNicCandidate { nic: only }
      }
  }
}

// the refusal reason CARRIED BY THE ARM THAT DECIDES IT.
//
// (review 81789) The first version was `LegacyBiosPxe { .. } => true, _ => false`, and the `_ =>
// false` was the bug: a fourth ClientNetworkBootMode added upstream would have counted as
// serviceable with no compile error, walking straight toward a Ready.
//
// (review 81853) Fixing that introduced a second bug, which this block removes. There used to be a
// SIBLING function `edge_refusal_reason(boot_mode)` that matched this union a second time and, for
// the `EdgeCanServe` arm, returned a constructed string: "edge can serve this mode, refusal is a
// modeling bug: ...". Its comment asserted the arm was unreachable because the only caller refuses
// precisely when the arm says so. That reasoning does not hold: an arm that returns a plausible
// diagnostic and is merely UNEXERCISED is not safe, it is untested. Reorder the caller's guard and
// every unsupported mode now ships a refusal whose text claims the model is broken -- a fabricated
// diagnostic standing in for a real one, which is DESIGN 5's "no plausible output is fabricated"
// and the reason 'unreachable' is never a reason to keep a code path.
//
// So: exactly ONE match on ClientNetworkBootMode in the module, the `why` arrives as data on the arm
// that knows it, and the caller matches the same union -- to produce any standing at all it must
// handle both arms, which makes a reordering a type error rather than a wrong sentence. Deleting the
// second match is the fix; there is no longer a place for a fall-through to invent anything.
//
// `EdgeCanServe` also LOSES its `mode: NonEmptyStr` prose field. Nothing read it, and it was a second
// home for facts that belong to the edge (dnsmasq ProxyDHCP, the HTTP URI) -- the same category of
// mistake as the `obligation` prose removed from the routes above. Whether the edge can serve a mode
// is this seam's fact; HOW it serves it is not.
// (review 81789) The first version of this fn was `LegacyBiosPxe { .. } => true, _ => false`, and
// the `_ => false` was the bug: a fourth ClientNetworkBootMode added upstream would have counted as
// serviceable with no compile error, walking straight toward a Ready -- the exact silent widen the
// comment above `edge_serviceable_for_mode`'s own arms claim to prevent. Each mode now says WHY the edge can or
// cannot serve it, so adding a mode is a compile error that forces the question 'can our dnsmasq
// ProxyDHCP edge boot this?' instead of an assumed answer.
//
// Legacy BIOS is refused rather than Unobserved because the finding is real and belongs in the
// report: the unit's firmware is fine, OUR edge (gunbc.site_uefi_arm64_pxe_edge, cut 6) serves UEFI
// only, so the thing that has to change is not the unit. A future legacy-capable edge adds the arm
// together with the evidence that it exists.
type EdgeServiceableByMode
  = EdgeCanServe
  | EdgeCannotServe { why: NonEmptyStr }

fn edge_serviceable_for_mode(boot_mode: ClientNetworkBootMode) -> EdgeServiceableByMode {
  match boot_mode {
    LegacyBiosPxe { tftp_root: _ } =>
      EdgeCannotServe {
        why: "the site PXE edge of cut 6 serves UEFI only; a PXE BIOS unit has no boot target here",
      }
    // Both UEFI modes are served. Neither arm restates HOW: that is the edge module's fact, and the
    // seam has no dnsmasq or URI knowledge of its own to keep current.
    UefiPxe { tftp_root: _ } => EdgeCanServe
    UefiHttpBoot => EdgeCanServe
  }
}

// ---------------------------------------------------------------------------
// THE DECLARED FRONTIER (DESIGN 3c: name the consumer and the executing route, or classify it).
//
// WHY THIS IS HERE RATHER THAN IN A COMMENT. This seam is the readiness contract that cut 6 of
// gunbc.plans.physical_machine_boot_program needs, and the two modules at its boundaries are landing
// as separate PRs: the probe that EMITS FirmwareBootObservation (gunbc.firmware_network_boot_probe,
// #14275) and the actuation step that READS this standing to decide what to do with a unit
// (gunbc.provisioning.network_boot_actuation::network_boot_arm_actuator_steps, cut 6/S9). Neither is
// on main yet, so a reader -- or a reviewer, as happened -- cannot tell 'frontier' from 'dangling' by
// looking. Note the consumer is the ACTUATOR and not the arm DERIVATION: deriving an arm shape from a
// strategy does not read this standing, and a frontier discharged by a non-reader is a lie that
// reports success (review 81884). The repository already
// has the right carrier for exactly that distinction: a bound dissolution trigger over a
// DeclarationRef, whose status is COMPUTED from a declaration population rather than asserted.
//
// THAT LAST WORD IS WHAT KEEPS THIS COMMENT FROM GOING STALE (review 81792 called an earlier draft
// of it stale within a day, and it was right -- prose that describes who-has-landed is a snapshot).
// Nothing here says whether the probe exists; `frontier_status` answers that against the population
// it is handed. On main today it is DissolutionPending. On a merge ref that contains #14275 it is
// DissolutionFired, with no edit to this file, and the witness asserts both of those outcomes
// rather than the state of the world this week.
// ---------------------------------------------------------------------------

// THE PRODUCER THAT MUST EXIST. The probe is the only module permitted to construct
// FirmwareBootObservation: this seam never fabricates an axis, which is why every axis has an
// Unobserved arm. Naming the specific declaration -- not 'some probe module' -- is what makes the
// trigger checkable: dissolution_status asks whether THAT ref is present.
data firmware_network_boot_probe_frontier: DissolutionCondition = BoundDissolution {
  trigger: DeclarationAppears { ref: firmware_network_boot_probe_producer_ref() },
}

// THE CONSUMER THAT MUST EXIST. Cut 6 derives its delivery strategy from the standing, never from a
// host row (operator policy: machine names never select), and the arm is a function of
// Ready/NeedsPreparation/Unobserved/Refused. Until this lands, the seam has no executing route and
// the plan step it serves is not done -- DESIGN 5's 'green by execution' is owed to it.
data firmware_network_boot_standing_consumer_frontier: DissolutionCondition = BoundDissolution {
  trigger: DeclarationAppears { ref: firmware_network_boot_standing_consumer_ref() },
}

// THE NAME IS LOOKED UP, NOT INVENTED. A trigger bound to a declaration nobody will ever write is
// worse than the prose it replaced: it reports Pending forever and looks like honest tracking while
// nothing can discharge it. `probe` is the fn in gunbc.firmware_network_boot_probe (S2, PR #14275)
// that builds FirmwareBootObservation today -- read off that branch, not guessed -- and the witness
// re-asserts the spelling as an independent literal so a silent rename here cannot keep the
// frontier quietly unsatisfiable.
fn firmware_network_boot_probe_producer_ref() -> DeclarationRef {
  decl_ref(module_path: "gunbc.firmware_network_boot_probe", decl_name: "probe")
}

// THE NAME IS LOOKED UP AND CARRIED BY AN OWNED COMMITMENT, NOT INVENTED (review 81884). This ref
// used to name `gunbc.provisioning.provisioning_arm::provisioning_arm_derive`, and that was wrong in
// a way the witness could not see: the declaration is real (PR #14284) but it does not READ this
// standing -- its derivation takes (strategy, evidence, attempt), so the frontier could have been
// discharged by a module that never consumes the type it is a frontier FOR. A trigger satisfied by a
// non-consumer is worse than no trigger, because it reports Fired and stops anyone asking.
//
// It now names the ACTUATION step, which is the thing that must read Ready/NeedsPreparation/
// Unobserved/Refused in order to do anything at all -- DESIGN 3c asks for the consumer AND the
// executing route, and the executing route is this one. The name is carried by an owned work item
// (node://adhoc-9cc8b205-64b, 'Cut 6/S9 owner: network-boot arm actuation'), so it is a commitment
// somebody has been assigned rather than a name I made up; and the S5 lane's own frontier names the
// same declaration, so the two seams agree on the join instead of each inventing one.
//
// WHAT PENDING MEANS, READ CORRECTLY: no executing route exists yet, so the plan step this seam
// serves is NOT done. Pending is not a tracking inconvenience -- it is the honest state, and it is
// the reason this module does not claim cut 6's 'green by execution'.
fn firmware_network_boot_standing_consumer_ref() -> DeclarationRef {
  decl_ref(
    module_path: "gunbc.provisioning.network_boot_actuation",
    decl_name: "network_boot_arm_actuator_steps",
  )
}

// THE FRONTIER AS A MACHINE CAN ANSWER IT. The caller supplies the declaration population it
// actually read; there is no default, because 'nothing is present' and 'nobody looked' are different
// answers and a frontier that cannot tell them apart will cheerfully report itself discharged.
fn frontier_status(condition: DissolutionCondition, present_decls: List<DeclarationRef>) -> DissolutionStatus {
  dissolution_status(condition: condition, present_decls: present_decls)
}

// WHY THE FRONTIER AND THE INHABITATION CLAIM ARE SEPARATE CARRIERS: a fired trigger proves the
// producer's NAME exists, and nothing about the shape it emits. A probe named
// probe_firmware_network_boot that defaults an axis to Ready would fire the frontier and still be
// the most dangerous module in the fleet. Only InhabitedByProducer, with evidence, closes it.

// THE INHABITATION CLAIM DESIGN 3c REQUIRES OF EVERY SUPPLIED BOUNDARY: one claim that the real
// producer emits this shape. It is NOT satisfied by this module's witness hand-building an
// observation -- a test that supplies its own fixture proves the fold works on fixtures and nothing
// about what a BMC parser produces. So the claim names who owes it, over what evidence, and what
// would falsify it, and it is constructed as a boundary that is explicitly UNINHABITED until that
// evidence exists.
type BoundaryInhabitation
  = Uninhabited { owed_by: DeclarationRef, over: NonEmptyStr, falsified_by: NonEmptyStr }
  | InhabitedByProducer { evidence: CitedFigureStanding, observed: NonEmptyStr }

data firmware_network_boot_observation_inhabitation: BoundaryInhabitation = Uninhabited {
  owed_by: firmware_network_boot_probe_producer_ref(),
  over: "FirmwareBootObservation: five axes, each an Observed/Unobserved/Refused union, boot entries typed by RedfishBootSourceOverrideTarget kind rather than label, and every refusal a FirmwareReadRefusal carrying the failing verb plus raw detail",
  falsified_by: "a probe that defaults an axis to Ready, invents a boot-entry kind from a label, or reports a refusal as an empty list -- any of which would let this seam read Ready on a unit whose firmware was never asked",
}

