module gunbc.fn_arrow_skeleton_seed_constants_emit

import extdeps.languages.rust.string_literal { escape_rust_cooked_string_literal_body }
import v2.std.compilers.body_lowering { body_view_unprojected_leaf_marker }
import v2.std.compilers.lexing { symbol_lexeme }
import std.types { String }

// THE UNPROJECTED-LEAF MARKER, PROJECTED INTO THE SEED SO THE SEED DOES NOT TRANSCRIBE IT.
//
// v1_compiler.coproduct_reflection marshal_generic emits the typed opaque leaf that
// v2.std.compilers.body_lowering node_is_unprojected_leaf admits, and the leaf is recognised by ONE
// spelling: body_view_unprojected_leaf_marker. A literal in the seed would be a second author of
// that spelling, and if either side moved alone every unprojected leaf would read as residue again
// and every fn-arrow call walk would refuse. So the seed references the generated const, and a
// hand edit to the generated file is refused by the generated-artifact drift wall -- the same
// construction gunbc.release_locus_seed_constants_emit records for its two spellings.
//
// A DEDICATED ARTIFACT, because its subject is the fn-arrow skeleton contract; appending it to the
// release-locus constants would give that module a second subject.
//
// THE MARKER IS NOT SPELLED HERE. This emitter evaluates the declaration and escapes its lexeme.
fn expected_fn_arrow_skeleton_seed_constants_generated_rs() -> String {
  concat(
    concat(
      "// Generated by gunbc fn_arrow_skeleton_seed_constants_emit — do not hand-edit.\n",
      "// Authority: v2.std.compilers.body_lowering body_view_unprojected_leaf_marker. The fn-arrow\n// skeleton's unprojected-leaf marker, projected so the seed reads it rather than transcribing it:\n// regenerate rather than edit.\n",
    ),
    concat(
      "pub(crate) const FN_ARROW_SKELETON_UNPROJECTED_LEAF_MARKER: &str = \"",
      concat(
        escape_rust_cooked_string_literal_body(s: symbol_lexeme(sym: body_view_unprojected_leaf_marker)),
        "\";\n",
      ),
    ),
  )
}
