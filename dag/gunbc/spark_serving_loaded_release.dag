module gunbc.spark_serving_loaded_release

import std.types { String, NonEmptyStr }
import product.placement_supply { HostIdentity }
import gunbc.ollama_runtime_bundle { ollama_runtime_closure_digest_for_reported_version }
import gunbc.model_artifact { ModelArtifact, model_artifact_from_observed_digest }
import extdeps.ollama.api { OllamaModelRef, ollama_model_digest_from_wire }
import gunbc.spark_serving_readback_parse {
  SparkServingReadbackField,
  spark_serving_readback_field_present_value,
  spark_serving_first_readback_refusal,
}
import gunbc.spark_serving_runtime_admission { spark_serving_runtime_admission_refusal_cause }
import gunbc.spark_serving_release {
  SparkServingObservation,
  SparkServingObserved,
  SparkServingAbsent,
  SparkServingObservationRefused,
  SparkServingRelease,
  SparkServingReleaseIdentity,
  RuntimeArtifactIdentity,
  spark_serving_release_identity,
}

data spark_serving_loaded_release_note: String = "LOADED-RELEASE FINGERPRINT (SPARK-SERVE-BIND-0 item C). Independent of transport: the same derivation consumes wet SSH readback or fixture rows in witnesses. Loaded identity covers runtime closure + model manifest digest only — serving policy is desired state, never imported into observations."

data spark_serving_unit_probe_outcome_note: String = "Only SparkServingUnitAbsent licenses SparkServingAbsent. SSH failure, transport failure, unreadable user manager, systemctl failure, and inactive units must never collapse into absent — that is the empty-observation narrow (DESIGN failure-mode list)."

type SparkServingUnitProbeOutcome
  = SparkServingUnitActive
  | SparkServingUnitInactive
  | SparkServingUnitAbsent
  | SparkServingUnitObservationRefused { cause: NonEmptyStr }

type SparkServingReadback {
  host: HostIdentity
  unit_outcome: SparkServingUnitProbeOutcome
  runtime_version: SparkServingReadbackField
  model_name: SparkServingReadbackField
  model_tag: SparkServingReadbackField
  model_manifest_digest: SparkServingReadbackField
  nvidia_driver: SparkServingReadbackField
  bind_address: SparkServingReadbackField
}

fn spark_serving_loaded_model_artifact(
  name: String,
  tag: String,
  digest_wire: String,
) -> ModelArtifact? {
  match ollama_model_digest_from_wire(
    ref: OllamaModelRef { name: name as NonEmptyStr, tag: tag as NonEmptyStr },
    hex: digest_wire,
  ) {
    Absent => none
    Present { value: observed } =>
      Present {
        value: model_artifact_from_observed_digest(
          publisher: "ollama" as NonEmptyStr,
          observed: observed,
        ),
      }
  }
}

fn derive_loaded_spark_serving_release(readback: SparkServingReadback) -> SparkServingRelease? {
  match readback.unit_outcome {
    SparkServingUnitInactive => none
    SparkServingUnitAbsent => none
    SparkServingUnitObservationRefused { cause: _ } => none
    SparkServingUnitActive =>
      match spark_serving_readback_field_present_value(field: readback.runtime_version) {
        Absent => none
        Present { value: ver } =>
          match ollama_runtime_closure_digest_for_reported_version(version: ver) {
            Absent => none
            Present { value: runtime_digest } =>
              match spark_serving_readback_field_present_value(field: readback.model_name) {
                Absent => none
                Present { value: name } =>
                  match spark_serving_readback_field_present_value(field: readback.model_tag) {
                    Absent => none
                    Present { value: tag } =>
                      match spark_serving_readback_field_present_value(field: readback.model_manifest_digest) {
                        Absent => none
                        Present { value: digest_wire } =>
                          match spark_serving_loaded_model_artifact(
                            name: name,
                            tag: tag,
                            digest_wire: digest_wire,
                          ) {
                            Absent => none
                            Present { value: model } =>
                              Present {
                                value: SparkServingRelease {
                                  runtime: RuntimeArtifactIdentity {
                                    closure_digest: runtime_digest.digest as NonEmptyStr,
                                  },
                                  model: model,
                                }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

fn derive_loaded_spark_serving_release_identity(readback: SparkServingReadback) -> SparkServingReleaseIdentity? {
  match derive_loaded_spark_serving_release(readback: readback) {
    Absent => none
    Present { value: spec } => Present { value: spark_serving_release_identity(spec: spec) }
  }
}

fn derive_spark_serving_observation(readback: SparkServingReadback) -> SparkServingObservation {
  match readback.unit_outcome {
    SparkServingUnitAbsent =>
      SparkServingAbsent { host: readback.host }
    SparkServingUnitInactive =>
      SparkServingObservationRefused {
        host: readback.host,
        cause: "serving unit is present but inactive" as NonEmptyStr,
      }
    SparkServingUnitObservationRefused { cause: c } =>
      SparkServingObservationRefused { host: readback.host, cause: c }
    SparkServingUnitActive =>
      match spark_serving_first_readback_refusal(fields: [
        readback.runtime_version,
        readback.model_name,
        readback.model_tag,
        readback.model_manifest_digest,
        readback.nvidia_driver,
      ]) {
        Present { value: cause } =>
          SparkServingObservationRefused { host: readback.host, cause: cause }
        Absent =>
          match spark_serving_runtime_admission_refusal_cause(nvidia_driver: readback.nvidia_driver) {
            Present { value: admission_cause } =>
              SparkServingObservationRefused { host: readback.host, cause: admission_cause }
            Absent =>
              match derive_loaded_spark_serving_release_identity(readback: readback) {
                Absent =>
                  SparkServingObservationRefused {
                    host: readback.host,
                    cause: "serving unit is active but loaded-release fingerprint could not be derived from independent readback" as NonEmptyStr,
                  }
                Present { value: loaded } =>
                  SparkServingObserved { host: readback.host, loaded_release: loaded }
              }
          }
      }
  }
}
