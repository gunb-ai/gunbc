module gunbc.spark_serving_loaded_release


data spark_serving_loaded_release_note: String = "LOADED-RELEASE FINGERPRINT (SPARK-SERVE-BIND-0 item C). Independent of transport: the same derivation consumes wet SSH readback or fixture rows in witnesses. Loaded identity covers runtime closure + model manifest digest only — serving policy is desired state, never imported into observations. Runtime closure requires release-archive admission receipt digest (gunbc.spark_serving_runtime_receipt — archive verified, not install completed) AND /api/version agreement — never either alone."

data spark_serving_unit_probe_outcome_note: String = "Only SparkServingUnitAbsent licenses SparkServingAbsent. SSH failure, transport failure, unreadable user manager, systemctl failure, and inactive units must never collapse into absent — that is the empty-observation narrow (DESIGN failure-mode list)."

type SparkServingUnitProbeOutcome
  = SparkServingUnitActive
  | SparkServingUnitInactive
  | SparkServingUnitAbsent
  | SparkServingUnitObservationRefused { cause: std.types.NonEmptyStr }

type SparkServingReadback {
  host: product.placement_supply.HostIdentity
  unit_outcome: SparkServingUnitProbeOutcome
  runtime_version: gunbc.spark_serving_readback_parse.SparkServingReadbackField
  runtime_release_asset_digest: gunbc.spark_serving_readback_parse.SparkServingReadbackField
  model_name: gunbc.spark_serving_readback_parse.SparkServingReadbackField
  model_tag: gunbc.spark_serving_readback_parse.SparkServingReadbackField
  model_manifest_digest: gunbc.spark_serving_readback_parse.SparkServingReadbackField
  nvidia_driver: gunbc.spark_serving_readback_parse.SparkServingReadbackField
  bind_address: gunbc.spark_serving_readback_parse.SparkServingReadbackField
}

fn spark_serving_loaded_model_artifact(
  name: String,
  tag: String,
  digest_wire: String,
) -> gunbc.model_artifact.ModelArtifact? {
  match ollama_model_digest_from_wire(
    ref: extdeps.ollama.api.OllamaModelRef { name: name as std.types.NonEmptyStr, tag: tag as std.types.NonEmptyStr },
    hex: digest_wire,
  ) {
    Absent => none
    Present { value: observed } =>
      Present {
        value: model_artifact_from_observed_digest(
          publisher: "ollama" as std.types.NonEmptyStr,
          observed: observed,
        ),
      }
  }
}

fn derive_loaded_spark_serving_release(readback: SparkServingReadback) -> gunbc.spark_serving_release.SparkServingRelease? {
  match readback.unit_outcome {
    SparkServingUnitInactive => none
    SparkServingUnitAbsent => none
    SparkServingUnitObservationRefused { cause: _ } => none
    SparkServingUnitActive =>
      match spark_serving_readback_field_present_value(field: readback.runtime_version) {
        Absent => none
        Present { value: ver } =>
          match spark_serving_readback_field_present_value(field: readback.runtime_release_asset_digest) {
            Absent => none
            Present { value: asset_digest_hex } =>
              match ollama_runtime_closure_digest_for_observed_release(
                version: ver,
                asset_digest_hex: asset_digest_hex,
              ) {
                Absent => none
                Present { value: runtime_digest } =>
                  match spark_serving_readback_field_present_value(field: readback.model_name) {
                    Absent => none
                    Present { value: name } =>
                      match spark_serving_readback_field_present_value(field: readback.model_tag) {
                        Absent => none
                        Present { value: tag } =>
                          match spark_serving_readback_field_present_value(field: readback.model_manifest_digest) {
                            Absent => none
                            Present { value: digest_wire } =>
                              match spark_serving_loaded_model_artifact(
                                name: name,
                                tag: tag,
                                digest_wire: digest_wire,
                              ) {
                                Absent => none
                                Present { value: model } =>
                                  Present {
                                    value: gunbc.spark_serving_release.SparkServingRelease {
                                      runtime: gunbc.spark_serving_release.RuntimeArtifactIdentity {
                                        closure_digest: runtime_digest.digest as std.types.NonEmptyStr,
                                      },
                                      model: model,
                                    }
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

fn derive_loaded_spark_serving_release_identity(readback: SparkServingReadback) -> gunbc.spark_serving_release.SparkServingReleaseIdentity? {
  match derive_loaded_spark_serving_release(readback: readback) {
    Absent => none
    Present { value: spec } => Present { value: spark_serving_release_identity(spec: spec) }
  }
}

fn derive_spark_serving_observation(readback: SparkServingReadback) -> gunbc.spark_serving_release.SparkServingObservation {
  match readback.unit_outcome {
    SparkServingUnitAbsent =>
      SparkServingAbsent { host: readback.host }
    SparkServingUnitInactive =>
      SparkServingObservationRefused {
        host: readback.host,
        cause: "serving unit is present but inactive" as std.types.NonEmptyStr,
      }
    SparkServingUnitObservationRefused { cause: c } =>
      SparkServingObservationRefused { host: readback.host, cause: c }
    SparkServingUnitActive =>
      match spark_serving_first_readback_refusal(fields: [
        readback.runtime_version,
        readback.runtime_release_asset_digest,
        readback.model_name,
        readback.model_tag,
        readback.model_manifest_digest,
        readback.nvidia_driver,
      ]) {
        Present { value: cause } =>
          SparkServingObservationRefused { host: readback.host, cause: cause }
        Absent =>
          match spark_serving_runtime_admission_refusal_cause(nvidia_driver: readback.nvidia_driver) {
            Present { value: admission_cause } =>
              SparkServingObservationRefused { host: readback.host, cause: admission_cause }
            Absent =>
              match derive_loaded_spark_serving_release(readback: readback) {
                Absent =>
                  SparkServingObservationRefused {
                    host: readback.host,
                    cause: "serving unit is active but loaded-release fingerprint could not be derived from independent readback" as std.types.NonEmptyStr,
                  }
                Present { value: loaded } =>
                  SparkServingObserved { host: readback.host, loaded_release: loaded }
              }
          }
      }
  }
}
