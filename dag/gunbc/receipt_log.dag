module gunbc.receipt_log

import std.types { String, NonEmptyStr, Int, Bool, List }

data receipt_log_shape_note: String = "A RECEIPT MUST BE READABLE, AND JSON IS NOT (operator direction, 2026-07-31). The corpus has serialize_json and no JSON parser at all, so a .dag receipt written as a JSON document is WRITE-ONLY. The live validation receipt makes that visible: it is interrogated by re-serializing an expected byte PREFIX and checking the document starts with it, which can only ever recover the leading field. That is why the live receipt is subject-less in practice — writing a revision into it would not have made the revision readable.\\n\\nSo the persistence format is a line-oriented record log: one record per line, fields separated by a tab, parsed with the split primitive the interpreter actually realizes. It is deliberately the smallest thing that round-trips, not a database.\\n\\nAPPEND-ONLY BY SHAPE. A record is one line, so a new record is a concatenation and never a rewrite. Nothing edits an existing line, which is what lets a later verification of a later head coexist with an earlier one instead of replacing it — the property the attempt-grain receipt could not have, since a whole-document write has no choice but to overwrite."

data escaping_is_not_optional_note: String = "THE DELIMITER MUST NOT BE WRITABLE INTO A FIELD, or the format silently misparses exactly the records that matter most. Evidence fields carry command output, and command output contains tabs and newlines routinely — so an unescaped writer would produce a line that parses into the wrong number of fields, or worse, into the right number with the values shifted. A shifted record is not a parse error; it is a receipt that reads as being about a different subject.\\n\\nThree characters are escaped and the backslash is escaped FIRST on the way out and LAST on the way back, which is the whole correctness argument: any other order lets an authored backslash-t become a real tab, so a field whose literal text contained the two characters backslash and t would round-trip into a delimiter and split the record."

data field_separator: String = from_code_point(9)
data record_separator: String = from_code_point(10)
data escape_marker: String = from_code_point(92)

fn escape_field(value: String) -> String {
  value
    |> replace(pattern: escape_marker, replacement: join([escape_marker, escape_marker], ""))
    |> replace(pattern: field_separator, replacement: join([escape_marker, "t"], ""))
    |> replace(pattern: record_separator, replacement: join([escape_marker, "n"], ""))
}

fn unescape_field(value: String) -> String {
  value
    |> replace(pattern: join([escape_marker, "n"], ""), replacement: record_separator)
    |> replace(pattern: join([escape_marker, "t"], ""), replacement: field_separator)
    |> replace(
        pattern: join([escape_marker, escape_marker], ""),
        replacement: escape_marker,
      )
}

fn serialize_record(fields: List<String>) -> String {
  join(map(fields, f => escape_field(value: f)), field_separator)
}

fn parse_record(line: String) -> List<String> {
  map(split(line, field_separator), f => unescape_field(value: f))
}

data append_note: String = "Appending is a fold over existing content rather than a write of a whole document, and the trailing record separator is written WITH each record rather than between records. A separator written between records makes the last line indistinguishable from a partial write; written after, every complete record ends the same way and a truncated tail is visibly incomplete."

fn append_record(existing: String, fields: List<String>) -> String {
  join([existing, serialize_record(fields: fields), record_separator], "")
}

fn parse_log(content: String) -> List<List<String>> {
  split(content, record_separator)
    |> filter(line => trim(line) != "")
    |> map(line => parse_record(line: line))
}

data field_count_is_checked_note: String = "A RECORD WITH THE WRONG FIELD COUNT IS REFUSED, NOT PADDED. A reader that tolerated a short record would supply a default for the missing column, and the default most likely to be chosen for a subject field is the empty string — which reads as a receipt about nothing rather than as a corrupt record. Since the whole purpose of this format is that a verdict names its subject, a silently widened record defeats it precisely when it matters."

type RecordRead
  = RecordFields { fields: List<String> }
  | RecordArityMismatch { expected: Int, observed: Int }

fn read_record(line: String, expected: Int) -> RecordRead {
  let fields = parse_record(line: line)
  if count(fields) == expected {
    RecordFields { fields: fields }
  } else {
    RecordArityMismatch { expected: expected, observed: count(fields) }
  }
}
