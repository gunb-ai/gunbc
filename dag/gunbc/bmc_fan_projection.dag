module gunbc.bmc_fan_projection

import extdeps.bmc.capability { BmcFirmwareVersion }
import extdeps.bmc.types {
  BmcFanCurve,
  BmcFanPolicyObservation,
  FanPidAggregatedEntry,
  FanPidIndependentEntries,
}
import extdeps.boards.types { BaseboardModel }
import extdeps.crypto.hash { Digest, sha256_digest }
import gunbc.bmc_intent { fleet_quiet_temp_soc_fan_curve }
import extdeps.filesystem.linux {
  LinuxFilePublicationProtocol,
  LinuxFilePublicationProtocolUnsynchronized,
  LinuxSynchronizedRenameReplacePublication,
}
import product.placement_supply { HostIdentity }
import std.state_durability {
  NoDurabilityCommitBarrier,
  StateDurabilityAdmission,
  StateDurabilityBoundary,
  StateDurabilityCapability,
  StateDurabilityCapabilityVersion,
  StateDurabilityEvidence,
  StatePerturbationGeneration,
  StateRealizationIdentity,
  SynchronizedCommit,
}
import std.types { Bool, List, NonEmptyStr }

type BmcFanConfigReadbackSubject {
  config_path: NonEmptyStr
}

type BmcFanDurabilityAdmission =
  StateDurabilityAdmission<HostIdentity, BmcFanConfigReadbackSubject>

type BmcFanDurabilityEvidence =
  StateDurabilityEvidence<HostIdentity, BmcFanConfigReadbackSubject>

type BmcFanPolicyProjectionCapability {
  board: BaseboardModel
  firmware: BmcFirmwareVersion
  projected_curve: BmcFanCurve
  projected_config_digest: Digest
  config_path: NonEmptyStr
  controller_service: NonEmptyStr
  controller_zone_path: NonEmptyStr
  aggregate_fan_pid_entry: NonEmptyStr
  realization: StateRealizationIdentity
  durability_capability_version: StateDurabilityCapabilityVersion
  publication_protocol: LinuxFilePublicationProtocol
  durability_boundaries: List<StateDurabilityBoundary>
  required_tach_inputs: List<NonEmptyStr>
}

type BmcAdmittedConfigDigest
  = AdmittedConfigDigestKnown { digest: Digest }
  | AdmittedConfigDigestUnavailable

type BmcProjectedConfigDigest
  = ProjectedConfigDigestKnown { digest: Digest }
  | ProjectedConfigDigestUnavailable

data altrad8ud_openbmc_322_swampd_config_asrr_path: NonEmptyStr = "/usr/share/swampd/config-asrr.json"

data altrad8ud_openbmc_322_swampd_temp_soc_jffs2_realization_id: NonEmptyStr = "altrad8ud-openbmc-3.22.00-swampd-asrr-temp-soc-jffs2-v1"

data altrad8ud_openbmc_322_fleet_quiet_temp_soc_projected_config_digest: Digest = sha256_digest(
  hex: "4812a134939f6e6eba9c90fe15fa93cc05936d0d2ef1a4365cc4ee0a4d262481",
)

data bmc_fan_witness_digest_mismatch_sentinel: Digest = sha256_digest(
  hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
)

fn bmc_fan_projected_config_digest(
  curve: BmcFanCurve,
  intent_curve: BmcFanCurve,
  realization: StateRealizationIdentity,
  config_path: NonEmptyStr,
) -> BmcProjectedConfigDigest {
  if curve == intent_curve
    && curve == fleet_quiet_temp_soc_fan_curve
    && realization.realization_id == altrad8ud_openbmc_322_swampd_temp_soc_jffs2_realization_id
    && config_path == altrad8ud_openbmc_322_swampd_config_asrr_path {
    ProjectedConfigDigestKnown {
      digest: altrad8ud_openbmc_322_fleet_quiet_temp_soc_projected_config_digest,
    }
  } else {
    ProjectedConfigDigestUnavailable
  }
}

fn bmc_fan_admitted_config_digest(
  curve: BmcFanCurve,
  intent_curve: BmcFanCurve,
  projected_config_digest: Digest?,
) -> BmcAdmittedConfigDigest {
  if curve == intent_curve {
    match projected_config_digest {
      Present { value: digest } => AdmittedConfigDigestKnown { digest: digest }
      Absent => AdmittedConfigDigestUnavailable
    }
  } else {
    AdmittedConfigDigestUnavailable
  }
}

fn bmc_fan_policy_projection_capability(
  board: BaseboardModel,
  firmware: BmcFirmwareVersion,
  projected_curve: BmcFanCurve,
  projected_config_digest: Digest,
  config_path: NonEmptyStr,
  controller_service: NonEmptyStr,
  controller_zone_path: NonEmptyStr,
  aggregate_fan_pid_entry: NonEmptyStr,
  realization: StateRealizationIdentity,
  durability_capability_version: StateDurabilityCapabilityVersion,
  publication_protocol: LinuxFilePublicationProtocol,
  durability_boundaries: List<StateDurabilityBoundary>,
  required_tach_inputs: List<NonEmptyStr>,
) -> BmcFanPolicyProjectionCapability {
  BmcFanPolicyProjectionCapability {
    board: board,
    firmware: firmware,
    projected_curve: projected_curve,
    projected_config_digest: projected_config_digest,
    config_path: config_path,
    controller_service: controller_service,
    controller_zone_path: controller_zone_path,
    aggregate_fan_pid_entry: aggregate_fan_pid_entry,
    realization: realization,
    durability_capability_version: durability_capability_version,
    publication_protocol: publication_protocol,
    durability_boundaries: durability_boundaries,
    required_tach_inputs: required_tach_inputs,
  }
}

fn bmc_fan_policy_projection_apply_suitability(
  capability: BmcFanPolicyProjectionCapability,
  board: BaseboardModel,
  desired_curve: BmcFanCurve,
  observation: BmcFanPolicyObservation,
) -> Bool {
  capability.board == board
    && capability.firmware == observation.firmware
    && capability.projected_curve == desired_curve
    && capability.config_path == observation.board_config_path
    && capability.controller_service == observation.controller_service
}

fn bmc_fan_policy_projection_live_digest_matches(
  capability: BmcFanPolicyProjectionCapability,
  observation: BmcFanPolicyObservation,
) -> Bool {
  observation.active_config_digest == capability.projected_config_digest
}

fn bmc_fan_state_durability_capability(
  realization: StateRealizationIdentity,
  capability_version: StateDurabilityCapabilityVersion,
  boundaries: List<StateDurabilityBoundary>,
  publication_protocol: LinuxFilePublicationProtocol,
) -> StateDurabilityCapability {
  StateDurabilityCapability {
    realization: realization,
    capability_version: capability_version,
    supported_boundaries: boundaries,
    commit_barrier: match publication_protocol {
      LinuxSynchronizedRenameReplacePublication => SynchronizedCommit
      LinuxFilePublicationProtocolUnsynchronized {
        stage_in_target_directory: _,
        staged_content_validated: _,
        replacement: _,
        synchronization: _,
      } => NoDurabilityCommitBarrier
    },
  }
}

fn bmc_fan_policy_projection_durability_capability(
  capability: BmcFanPolicyProjectionCapability,
) -> StateDurabilityCapability {
  bmc_fan_state_durability_capability(
    realization: capability.realization,
    capability_version: capability.durability_capability_version,
    boundaries: capability.durability_boundaries,
    publication_protocol: capability.publication_protocol,
  )
}

fn bmc_fan_policy_projection_durability_admission(
  host: HostIdentity,
  capability: BmcFanPolicyProjectionCapability,
  perturbation_generation: StatePerturbationGeneration,
) -> BmcFanDurabilityAdmission {
  StateDurabilityAdmission {
    target: host,
    desired_state_digest: capability.projected_config_digest,
    realization: capability.realization,
    capability_version: capability.durability_capability_version,
    perturbation_generation: perturbation_generation,
    readback_subject: BmcFanConfigReadbackSubject {
      config_path: capability.config_path,
    },
  }
}

fn bmc_fan_policy_projection_topology_matches(
  capability: BmcFanPolicyProjectionCapability,
  observation: BmcFanPolicyObservation,
) -> Bool {
  match observation.controller_shape {
    FanPidAggregatedEntry {
      entry_name: entry_name,
      tach_inputs: tach_inputs,
    } =>
      entry_name == capability.aggregate_fan_pid_entry
        && tach_inputs == capability.required_tach_inputs
    FanPidIndependentEntries { entry_names: _ } => false
  }
}

data bmc_fan_projection_exact_version_note: String = "A fleet firmware track says which states are valid; it does not select a JSON realizer. A projection capability is admitted only for an exact board, firmware version, desired semantic curve, desired projected-config digest derived from that curve and realization, config path, controller service, zone control path, aggregate fan PID entry, and installed tach-input topology witnessed together. bmc_fan_projected_config_digest derives the digest from intent curve plus realization identity and config path; it never reads observation. bmc_fan_admitted_config_digest takes the intent curve and an optional caller-supplied projection-derived digest at the reconcile site; it returns AdmittedConfigDigestUnavailable when the curve is not the modeled intent curve or the digest is absent. bmc_fan_witness_digest_mismatch_sentinel is witness-only observation input for live-digest mismatch controls, not an admitted digest authority. Its durability capability and admission are derived from the same realization content identity, capability version/hash, lifecycle boundaries, executable publication protocol, target host, readback subject, and declared perturbation generation; there is no separately writable string ID that can let an old receipt qualify changed policy bytes. Ordinary convergence requires the live canonical config digest to equal the projection-derived admitted digest; durability qualification is a separate post-apply gate and never uses converge-noop as an activation premise."
