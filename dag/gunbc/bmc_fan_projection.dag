module gunbc.bmc_fan_projection

import extdeps.bmc.capability { BmcFirmwareVersion }
import extdeps.bmc.types {
  BmcFanPolicyObservation,
  FanPidAggregatedEntry,
  FanPidIndependentEntries,
}
import extdeps.boards.types { BaseboardModel }
import extdeps.filesystem.linux {
  LinuxFilePublicationProtocol,
  linux_file_publication_has_synchronized_commit,
}
import std.state_durability {
  NoDurabilityCommitBarrier,
  StateDurabilityBoundary,
  StateDurabilityCapability,
  SynchronizedCommit,
  durability_commit_barrier_is_synchronized,
}
import std.types { Bool, List, NonEmptyStr }

type BmcFanPolicyProjectionCapability {
  board: BaseboardModel
  firmware: BmcFirmwareVersion
  config_path: NonEmptyStr
  controller_service: NonEmptyStr
  controller_zone_path: NonEmptyStr
  aggregate_fan_pid_entry: NonEmptyStr
  projection_id: NonEmptyStr
  publication_protocol: LinuxFilePublicationProtocol
  durability_boundaries: List<StateDurabilityBoundary>
  required_tach_inputs: List<NonEmptyStr>
}

fn bmc_fan_policy_projection_supports_apply(
  capability: BmcFanPolicyProjectionCapability,
  board: BaseboardModel,
  observation: BmcFanPolicyObservation,
) -> Bool {
  capability.board == board
    && capability.firmware == observation.firmware
    && capability.config_path == observation.board_config_path
    && capability.controller_service == observation.controller_service
    && linux_file_publication_has_synchronized_commit(
      protocol: capability.publication_protocol,
    )
    && durability_commit_barrier_is_synchronized(
      barrier: bmc_fan_policy_projection_durability_capability(
        capability: capability,
      ).commit_barrier,
    )
}

fn bmc_fan_state_durability_capability(
  realization_id: NonEmptyStr,
  boundaries: List<StateDurabilityBoundary>,
  publication_protocol: LinuxFilePublicationProtocol,
) -> StateDurabilityCapability {
  StateDurabilityCapability {
    realization_id: realization_id,
    supported_boundaries: boundaries,
    commit_barrier: if linux_file_publication_has_synchronized_commit(
      protocol: publication_protocol,
    ) {
        SynchronizedCommit
      } else {
        NoDurabilityCommitBarrier
      },
  }
}

fn bmc_fan_policy_projection_durability_capability(
  capability: BmcFanPolicyProjectionCapability,
) -> StateDurabilityCapability {
  bmc_fan_state_durability_capability(
    realization_id: capability.projection_id,
    boundaries: capability.durability_boundaries,
    publication_protocol: capability.publication_protocol,
  )
}

fn bmc_fan_policy_projection_topology_matches(
  capability: BmcFanPolicyProjectionCapability,
  observation: BmcFanPolicyObservation,
) -> Bool {
  match observation.controller_shape {
    FanPidAggregatedEntry {
      entry_name: entry_name,
      tach_inputs: tach_inputs,
    } =>
      entry_name == capability.aggregate_fan_pid_entry
        && tach_inputs == capability.required_tach_inputs
    FanPidIndependentEntries { entry_names: _ } => false
  }
}

data bmc_fan_projection_exact_version_note: String = "A fleet firmware track says which states are valid; it does not select a JSON realizer. A projection capability is admitted only for an exact board, firmware version, config path, controller service, zone control path, aggregate fan PID entry, and installed tach-input topology witnessed together. Its durability capability is derived from the same projection identity, lifecycle boundaries, and executable publication protocol; there is no separately writable durability claim that can fork from the realizer. Thus OpenBMC 3.06 and 3.22 can both satisfy a 3.x intent while only 3.22 has the currently qualified projection."
