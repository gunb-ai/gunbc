module gunbc.bmc_fan_projection


type BmcFanProjectionApplyRefusalCause
  = BmcFanProjectionBoardMismatch
  | BmcFanProjectionFirmwareMismatch
  | BmcFanProjectionCurveMismatch
  | BmcFanProjectionConfigPathMismatch
  | BmcFanProjectionControllerServiceMismatch

type BmcFanProjectionApplySuitability
  = BmcFanProjectionApplySuitable
  | BmcFanProjectionApplyRefused {
      cause: BmcFanProjectionApplyRefusalCause,
    }

type BmcFanProjectionLiveDigestRefusalCause {
  observed: extdeps.crypto.hash.Digest
  expected: extdeps.crypto.hash.Digest
}

type BmcFanProjectionLiveDigestSuitability
  = BmcFanProjectionLiveDigestMatches
  | BmcFanProjectionLiveDigestRefused {
      cause: BmcFanProjectionLiveDigestRefusalCause,
    }

type BmcFanProjectionTopologyRefusalCause
  = BmcFanProjectionAggregatedTopologyAbsent
  | BmcFanProjectionEntryNameMismatch
  | BmcFanProjectionTachInputsMismatch

type BmcFanProjectionTopologySuitability
  = BmcFanProjectionTopologyMatches
  | BmcFanProjectionTopologyRefused {
      cause: BmcFanProjectionTopologyRefusalCause,
    }

type BmcFanPolicyDriftCause
  = BmcFanPolicyCurveDrift
  | BmcFanPolicyTopologyDrift {
      cause: BmcFanProjectionTopologyRefusalCause,
    }
  | BmcFanPolicyDigestDrift {
      cause: BmcFanProjectionLiveDigestRefusalCause,
    }

type BmcFanPolicyDriftAssessment
  = BmcFanPolicyConverged
  | BmcFanPolicyDrifted { cause: BmcFanPolicyDriftCause }

type BmcFanConfigReadbackSubject {
  config_path: std.types.NonEmptyStr
}

type BmcFanDurabilityAdmission =
  std.state_durability.StateDurabilityAdmission<product.placement_supply.HostIdentity, BmcFanConfigReadbackSubject>

type BmcFanDurabilityEvidence =
  std.state_durability.StateDurabilityEvidence<product.placement_supply.HostIdentity, BmcFanConfigReadbackSubject>

type BmcFanPolicyProjectionCapability {
  board: extdeps.boards.types.BaseboardModel
  firmware: extdeps.bmc.capability.BmcFirmwareVersion
  projected_curve: extdeps.bmc.types.BmcFanCurve
  projected_config_digest: extdeps.crypto.hash.Digest
  config_path: std.types.NonEmptyStr
  controller_service: std.types.NonEmptyStr
  controller_zone_path: std.types.NonEmptyStr
  aggregate_fan_pid_entry: std.types.NonEmptyStr
  realization: std.state_durability.StateRealizationIdentity
  durability_capability_version: std.state_durability.StateDurabilityCapabilityVersion
  publication_protocol: extdeps.filesystem.linux.LinuxFilePublicationProtocol
  durability_boundaries: List<std.state_durability.StateDurabilityBoundary>
  required_tach_inputs: List<std.types.NonEmptyStr>
}

type BmcAdmittedConfigDigest
  = AdmittedConfigDigestKnown { digest: extdeps.crypto.hash.Digest }
  | AdmittedConfigDigestUnavailable

type BmcProjectedConfigDigest
  = ProjectedConfigDigestKnown { digest: extdeps.crypto.hash.Digest }
  | ProjectedConfigDigestUnavailable

data altrad8ud_openbmc_322_swampd_config_asrr_path: std.types.NonEmptyStr = "/usr/share/swampd/config-asrr.json"

data altrad8ud_openbmc_322_swampd_temp_soc_jffs2_realization_id: std.types.NonEmptyStr = "altrad8ud-openbmc-3.22.00-swampd-asrr-temp-soc-jffs2-v1"

data altrad8ud_openbmc_322_fleet_quiet_projected_config_sha256_hex: std.types.NonEmptyStr = "f559aff7f3455011e951bed1eac52e8cbe7a724b772fe6ece1d8545ff47cb5bc"

type BmcProjectedConfigContentIdentity {
  realization_id: std.types.NonEmptyStr
  config_path: std.types.NonEmptyStr
  projected_curve: extdeps.bmc.types.BmcFanCurve
  projected_config_sha256_hex: std.types.NonEmptyStr
}

