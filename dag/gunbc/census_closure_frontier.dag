module gunbc.census_closure_frontier

import std.roster_frontier {
  FrontierRow,
  TriggerProse,
  concat_frontier_row_groups,
  decl_ref,
  frontier_row_decl,
}
import extdeps.cloud.hetzner { hetzner_money_rate_frontier_rows }
import extdeps.dhcp.v4 { mac_address_anemic_brand_frontier_rows }
import extdeps.docker.container_inspect {
  container_state_detail_redundant_bools_frontier_rows,
  memory_swap_unlimited_convention_frontier_rows,
  hostconfig_containerconfig_anemic_leaves_frontier_rows,
  network_settings_bare_strings_frontier_rows,
  container_inspect_error_closure_frontier_rows,
}
import extdeps.docker.container_stats {
  cpu_percent_ratio_carrier_frontier_rows,
  container_stats_error_closure_frontier_rows,
  memory_stats_working_set_frontier_rows,
  blkio_value_unit_ambiguity_frontier_rows,
}
import extdeps.docker.endpoint { endpoint_string_type_frontier_rows }
import extdeps.github.merge_state { merge_state_graphql_transport_frontier_rows }
import extdeps.github.workflow_runs { conclusion_authority_consolidation_frontier_rows }
import extdeps.network.ipv6 { ipv6_text_codec_staged_frontier_rows }
import extdeps.pricing.hetzner_dedicated { cpu_description_string_leaf_frontier_rows }
import extdeps.router.verizon_cr1000a {
  cr1000a_dhcp_lease_transport_frontier_rows,
  cr1000a_host_name_raw_parse_frontier_rows,
  cr1000a_delegated_prefix_length_scalar_frontier_rows,
  cr1000a_expires_in_ui_text_frontier_rows,
}
import extdeps.tools.sha256sum { sha256_verify_native_transport_frontier_rows }

data census_closure_count_witness_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(
      module_path: "test.claim.annotation_carrier",
      decl_name: "census_closure_frontier_rows_count_is_twenty_one",
    ),
    reason: "Hand count beside structure is a conversion receipt (#7207 class-5); retires when roster assembly is registry-derived",
    trigger: TriggerProse {
      text: "census_closure_frontier_rows is registry-derived without a hand-count witness",
    },
  )
]

fn census_closure_frontier_row_groups() -> List<List<FrontierRow>> {
  [
    hetzner_money_rate_frontier_rows,
    mac_address_anemic_brand_frontier_rows,
    container_state_detail_redundant_bools_frontier_rows,
    memory_swap_unlimited_convention_frontier_rows,
    hostconfig_containerconfig_anemic_leaves_frontier_rows,
    network_settings_bare_strings_frontier_rows,
    container_inspect_error_closure_frontier_rows(),
    cpu_percent_ratio_carrier_frontier_rows,
    container_stats_error_closure_frontier_rows(),
    memory_stats_working_set_frontier_rows,
    blkio_value_unit_ambiguity_frontier_rows,
    endpoint_string_type_frontier_rows,
    merge_state_graphql_transport_frontier_rows,
    conclusion_authority_consolidation_frontier_rows,
    ipv6_text_codec_staged_frontier_rows,
    cpu_description_string_leaf_frontier_rows,
    cr1000a_dhcp_lease_transport_frontier_rows,
    cr1000a_host_name_raw_parse_frontier_rows,
    cr1000a_delegated_prefix_length_scalar_frontier_rows,
    cr1000a_expires_in_ui_text_frontier_rows,
    sha256_verify_native_transport_frontier_rows,
  ]
}

fn census_closure_frontier_rows() -> List<FrontierRow> {
  concat_frontier_row_groups(groups: census_closure_frontier_row_groups())
}
