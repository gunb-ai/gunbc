// CONVERGENCE-ONE C1. Binds the C0 census to the canonical stack without host actuation.
// gunbc.ensure remains the adapter: its observation spelling projects onto
// ObservationAttempt<ShowEffectiveRead<E>, String>.
// RUNG: mechanically preventable on the enrolled REDs; empty GoalDiverged remains
// structurally impossible in std.goal_assessment.
// HostEffectDomainProjection is observe, assess, decide. inspect_via consumes
// observe/assess this cut. decide is a §3c declared frontier typed onto
// std.upsert_decision UpsertDecision. C3 named live_deploy_inspect_member and
// admit_live_deploy_member_basis as plan-side consumers; apply stays C4.
// Readiness is NOT a field on this projection. C5 landed gunbc.readiness
// Readiness = Ready | Pending | Refused, independent of Reconciliation.
// Provider readiness is consumed by gunbc.roadmap_serve, not by a fourth
// field here: a Reconciliation-typed readiness field remains the control-8
// hazard and is not restored.
// C0 left ensure_decide and observe_executable as inline cites; those two
// have no named census accessor, so the bind holds one decl_ref each.
// NEXT-RUNG (control 1): a compile instrument that imports inspect_goal.
// Control 8: production observers return gunbc.readiness Readiness, which
// has no inhabitant in Reconciliation or ReconciledEffect. Conversion still
// exists at live_deploy_apply_readiness_gate_with_readiness, so the class is
// mechanically preventable there (the gate admits Ready only), not
// structurally impossible. Discriminating REDs remain enrolled
// (test.claim.readiness_algebra_witness pending-vs-refused classify
// controls and witness_red_control_observe_unplaced_executable_runs_the_producer;
// test.claim.live_deploy.apply
// witness_red_control_pending_readiness_cannot_converge). Isolated compile_fixture still cannot import live
// types; that residual is control 1's compile instrument, not this class.

data ensure_decide_id: DeclarationRef = decl_ref(
  module_path: "gunbc.ensure",
  decl_name: "ensure_decide",
)

data observe_executable_id: DeclarationRef = decl_ref(
  module_path: "gunbc.live_deploy.member_observe",
  decl_name: "observe_executable",
)

type CanonicalProtocolLayer
  = LayerSelect
  | LayerObserveAssess
  | LayerRemedy
  | LayerReadback
  | LayerEnsureAdapter
  | LayerFleetPlan
  | LayerFleetApply
  | LayerDeployObserve
  | LayerDeployReadiness

type CanonicalLayerBinding {
  layer: CanonicalProtocolLayer
  authority: DeclarationRef
}

data canonical_protocol_bindings: List<CanonicalLayerBinding> = [
  CanonicalLayerBinding {
    layer: LayerSelect,
    authority: std_decision(),
  },
  CanonicalLayerBinding {
    layer: LayerObserveAssess,
    authority: std_goal_assessment(),
  },
  CanonicalLayerBinding {
    layer: LayerRemedy,
    authority: std_upsert(),
  },
  CanonicalLayerBinding {
    layer: LayerReadback,
    authority: std_reconcile(),
  },
  CanonicalLayerBinding {
    layer: LayerEnsureAdapter,
    authority: ensure_decide_id,
  },
  CanonicalLayerBinding {
    layer: LayerFleetPlan,
    authority: fleet_plan(),
  },
  CanonicalLayerBinding {
    layer: LayerFleetApply,
    authority: fleet_apply(),
  },
  CanonicalLayerBinding {
    layer: LayerDeployObserve,
    authority: observe_executable_id,
  },
  CanonicalLayerBinding {
    layer: LayerDeployReadiness,
    authority: live_readiness(),
  },
]

data required_canonical_layers: List<CanonicalProtocolLayer> = [
  LayerSelect,
  LayerObserveAssess,
  LayerRemedy,
  LayerReadback,
  LayerEnsureAdapter,
  LayerFleetPlan,
  LayerFleetApply,
  LayerDeployObserve,
  LayerDeployReadiness,
]

type CanonicalLayerJoin
  = CanonicalLayersCovered
  | CanonicalLayerMissing { layer: CanonicalProtocolLayer }
  | CanonicalLayerDuplicated { layer: CanonicalProtocolLayer }

fn canonical_layer_tag(layer: CanonicalProtocolLayer) -> Int {
  match layer {
    LayerSelect => 0
    LayerObserveAssess => 1
    LayerRemedy => 2
    LayerReadback => 3
    LayerEnsureAdapter => 4
    LayerFleetPlan => 5
    LayerFleetApply => 6
    LayerDeployObserve => 7
    LayerDeployReadiness => 8
  }
}

fn canonical_layer_eq(a: CanonicalProtocolLayer, b: CanonicalProtocolLayer) -> Bool {
  canonical_layer_tag(layer: a) == canonical_layer_tag(layer: b)
}

fn canonical_layer_join(
  required: List<CanonicalProtocolLayer>,
  bindings: List<CanonicalLayerBinding>,
) -> CanonicalLayerJoin {
  fold(required, init: CanonicalLayersCovered, f: fn(acc, layer) {
    match acc {
      CanonicalLayerMissing { layer: m } => CanonicalLayerMissing { layer: m }
      CanonicalLayerDuplicated { layer: d } => CanonicalLayerDuplicated { layer: d }
      CanonicalLayersCovered => {
        let hits = filter(xs: bindings, predicate: fn(b) { canonical_layer_eq(a: b.layer, b: layer) })
        if length(xs: hits) == 0 {
          CanonicalLayerMissing { layer: layer }
        } else {
          if length(xs: hits) > 1 {
            CanonicalLayerDuplicated { layer: layer }
          } else {
            CanonicalLayersCovered
          }
        }
      }
    }
  })
}

type ProtocolPhaseBinding
  = PhasesBound { phases: ProtocolPhases }
  | SelectionLeakedIntoObservation { phases: ProtocolPhases }
  | SelectionLeakedIntoAssessment { phases: ProtocolPhases }

fn admit_protocol_phases(phases: ProtocolPhases) -> ProtocolPhaseBinding {
  if phases.selects && phases.observes {
    SelectionLeakedIntoObservation { phases: phases }
  } else {
    if phases.selects && phases.assesses {
      SelectionLeakedIntoAssessment { phases: phases }
    } else {
      PhasesBound { phases: phases }
    }
  }
}

type CensusPhaseStanding
  = CensusPhasesBound
  | CensusStandingMalformed { cause: HostConvergenceCensusRefusal }
  | CensusSelectionLeaked { identity: DeclarationRef, leak: ProtocolPhaseBinding }

fn bind_census_protocol_phases(census: HostConvergenceCensus) -> CensusPhaseStanding {
  match census {
    CensusMalformed { cause: c } => CensusStandingMalformed { cause: c }
    CensusWellFormed { rows: rows } =>
      fold(rows, init: CensusPhasesBound, f: fn(acc, row) {
        match acc {
          CensusStandingMalformed { cause: c } => CensusStandingMalformed { cause: c }
          CensusSelectionLeaked { identity: i, leak: l } =>
            CensusSelectionLeaked { identity: i, leak: l }
          CensusPhasesBound =>
            match admit_protocol_phases(phases: row.phases) {
              PhasesBound { phases: _ } => CensusPhasesBound
              SelectionLeakedIntoObservation { phases: p } =>
                CensusSelectionLeaked {
                  identity: row.identity,
                  leak: SelectionLeakedIntoObservation { phases: p },
                }
              SelectionLeakedIntoAssessment { phases: p } =>
                CensusSelectionLeaked {
                  identity: row.identity,
                  leak: SelectionLeakedIntoAssessment { phases: p },
                }
            }
        }
      })
  }
}

type ProtocolDeclaredFrontier {
  declaration: DeclarationRef
  named_consumer: DeclarationRef
  trigger_capability: DeclarationRef
}

// A FRONTIER WHOSE CONSUMER DOES NOT EXIST YET IS A DIFFERENT ROW, NOT A WEAKER ONE.
// ProtocolDeclaredFrontier names a consumer that calls the declaration and a capability
// that is still missing; its three predicates refuse a row that names itself. Before C4
// there was no way to write "declared, consumer not yet built" except by naming a
// consumer that does not call the declaration (a false citation) or by leaving the row
// self-referential (a protocol that can never bind). FrontierConsumerAwaiting is that
// third state, and its discharge inhabits std.dissolution rather than a new trigger
// vocabulary. It is never read as FrontierHonest.
type ProtocolFrontierRow
  = FrontierConsumerNamed { frontier: ProtocolDeclaredFrontier }
  | FrontierConsumerAwaiting { declaration: DeclarationRef, discharge: DissolutionCondition }

// The population a BoundDissolution discharge is answered against. Unobserved is not an
// empty population: an empty list would report every DeclarationAppears trigger Pending
// forever (the hazard gunbc.dissolution_observation records), so a bound discharge with
// no observed population refuses instead of answering.
type FrontierPresenceEvidence
  = FrontierPresenceObserved { present_decls: List<DeclarationRef> }
  | FrontierPresenceUnobserved

type FrontierStanding
  = FrontierHonest
  | FrontierConsumerIsDeclaration { frontier: ProtocolDeclaredFrontier }
  | FrontierTriggerIsDeclaration { frontier: ProtocolDeclaredFrontier }
  | FrontierTriggerIsTheConsumer { frontier: ProtocolDeclaredFrontier }
  | FrontierAwaitingDischarge { declaration: DeclarationRef, discharge: DissolutionCondition }
  | FrontierDischargeFired { declaration: DeclarationRef, discharge: DissolutionCondition }
  | FrontierDischargeUnobservable { declaration: DeclarationRef, discharge: DissolutionCondition }

type CanonicalProtocolStanding
  = CanonicalProtocolBound { frontiers: List<FrontierStanding> }
  | CanonicalFrontiersUnbound { frontiers: List<FrontierStanding> }
  | CanonicalLayersUnbound { join: CanonicalLayerJoin }
  | CensusProtocolUnbound { standing: CensusPhaseStanding }

type HostEffectDomainProjection<Subject, Goal, Request, Observed, Evidence, Deviation, UnknownFact, ObserveRefusal, AssessRefusal, Plan> {
  observe: fn(Subject, Request) -> ObservationAttempt<Observed, ObserveRefusal>
  assess: fn(Goal, Observed) -> GoalAssessment<Evidence, Deviation, UnknownFact, AssessRefusal>
  decide: fn(GoalAssessment<Evidence, Deviation, UnknownFact, AssessRefusal>) -> UpsertDecision<Plan>
}

fn inspect_via_host_effect_projection<Subject, Goal, Request, Observed, Evidence, Deviation, UnknownFact, ObserveRefusal, AssessRefusal, Plan>(
  subject: Subject,
  goal: Goal,
  request: Request,
  projection: HostEffectDomainProjection<Subject, Goal, Request, Observed, Evidence, Deviation, UnknownFact, ObserveRefusal, AssessRefusal, Plan>,
) -> GoalInspection<Subject, Goal, Request, Observed, Evidence, Deviation, UnknownFact, ObserveRefusal, AssessRefusal> {
  inspect_goal(
    subject: subject,
    goal: goal,
    request: request,
    observe: projection.observe,
    assess: projection.assess,
  )
}

// C3 plan-side discharge. named_consumer is the function that actually calls the declaration.
// trigger_capability is a remaining capability, not the consumer: inspect_via still observes via
// supplied ObservedMember rather than wet observe_executable. HostEffectDomainProjection is used
// by admit; fleet_converge_plan_artifact_of_request now consumes LiveDeployConverge.
// host_effect_decide_apply_frontier is an awaiting row (C4, below).
data live_deploy_inspect_member_id: DeclarationRef = decl_ref(
  module_path: "gunbc.live_deploy.fleet_request",
  decl_name: "live_deploy_inspect_member",
)

data admit_live_deploy_member_basis_id: DeclarationRef = decl_ref(
  module_path: "gunbc.live_deploy.fleet_request",
  decl_name: "admit_live_deploy_member_basis",
)

data host_effect_observe_frontier: ProtocolDeclaredFrontier = ProtocolDeclaredFrontier {
  declaration: decl_ref(
    module_path: "gunbc.host_convergence_protocol",
    decl_name: "inspect_via_host_effect_projection",
  ),
  named_consumer: live_deploy_inspect_member_id,
  trigger_capability: observe_executable_id,
}

data host_effect_decide_plan_frontier: ProtocolDeclaredFrontier = ProtocolDeclaredFrontier {
  declaration: decl_ref(
    module_path: "gunbc.host_convergence_protocol",
    decl_name: "HostEffectDomainProjection",
  ),
  named_consumer: admit_live_deploy_member_basis_id,
  trigger_capability: fleet_plan(),
}

// C4. THE APPLY ROW AWAITS A CONSUMER THAT DOES NOT EXIST. The declaration is
// HostEffectDomainProjection's decide on the apply side. gunbc.fleet_converge_apply
// converge_apply_for_host does NOT call it: it calls gunbc.host_effect_realize
// host_effect_apply directly, so naming it the consumer would be a citation that lies.
// The row used to carry fleet_apply() as both consumer and trigger, which
// frontier_trigger_is_not_the_consumer refuses, so the protocol could never bind.
// The discharge is UNBOUND on purpose. The capability that would discharge it (C8:
// apply routed through the projection's decide) has no declaration in the corpus yet.
// A DeclarationAppears trigger on a symbol nobody has declared is the fabricated
// citation class (DESIGN §3); gunbc.runner.runner_spec_from_offer made the same
// choice for the same reason. host_effect_apply is not a DeclarationRetires candidate
// either, because C8 keeps it as the realization and routes to it.
// NEXT RUNG: when C8 names its projection-routed apply carrier, this row moves to
// bound_dissolution on that ref, and FrontierDischargeFired becomes mechanically
// checkable against an observed population.
data host_effect_decide_apply_frontier: ProtocolFrontierRow = FrontierConsumerAwaiting {
  declaration: decl_ref(
    module_path: "gunbc.host_convergence_protocol",
    decl_name: "HostEffectDomainProjection",
  ),
  discharge: unbound_dissolution(
    description: "C8: a fleet apply entry that routes the apply-side UpsertDecision through HostEffectDomainProjection.decide and then reconciles through gunbc.host_effect_realize host_effect_apply with independent readback. gunbc.fleet_converge_apply converge_apply_for_host calls host_effect_apply directly today and is not this consumer.",
  ),
}

data host_effect_declared_frontiers: List<ProtocolFrontierRow> = [
  FrontierConsumerNamed { frontier: host_effect_observe_frontier },
  FrontierConsumerNamed { frontier: host_effect_decide_plan_frontier },
  host_effect_decide_apply_frontier,
]

fn frontier_names_a_distinct_consumer(f: ProtocolDeclaredFrontier) -> Bool {
  !declaration_ref_eq(a: f.declaration, b: f.named_consumer)
}

fn frontier_trigger_is_not_declaration(f: ProtocolDeclaredFrontier) -> Bool {
  !declaration_ref_eq(a: f.declaration, b: f.trigger_capability)
}

fn frontier_trigger_is_not_the_consumer(f: ProtocolDeclaredFrontier) -> Bool {
  !declaration_ref_eq(a: f.trigger_capability, b: f.named_consumer)
}

fn reconcile_from_read_attempt<P, R, E>(
  decision: UpsertDecision<P>,
  application: Application,
  after: ObservationAttempt<ShowEffectiveRead<R>, String>,
  grounding: Grounding<E>,
) -> ReconciledEffect<P, E> {
  match after {
    ObservationEstablished { observed: read } =>
      reconcile_effect(
        decision: decision,
        application: application,
        show_read: read,
        grounding: grounding,
      )
    ObservationRefused { cause: cause } =>
      reconcile_effect_without_read(
        decision: decision,
        application: application,
        reason: cause,
      )
  }
}

fn admit_frontier(f: ProtocolDeclaredFrontier) -> FrontierStanding {
  if frontier_names_a_distinct_consumer(f: f) {
    if frontier_trigger_is_not_declaration(f: f) {
      if frontier_trigger_is_not_the_consumer(f: f) {
        FrontierHonest
      } else {
        FrontierTriggerIsTheConsumer { frontier: f }
      }
    } else {
      FrontierTriggerIsDeclaration { frontier: f }
    }
  } else {
    FrontierConsumerIsDeclaration { frontier: f }
  }
}

// Awaiting is admitted to the binding only while its discharge has not fired. An
// Unbound discharge cannot fire and is admitted with its description carried; a bound
// one needs an observed population, and fired means the capability arrived and nobody
// discharged the row.
fn admit_awaiting_frontier(
  declaration: DeclarationRef,
  discharge: DissolutionCondition,
  evidence: FrontierPresenceEvidence,
) -> FrontierStanding {
  match discharge {
    UnboundDissolution { description: _ } =>
      FrontierAwaitingDischarge { declaration: declaration, discharge: discharge }
    BoundDissolution { trigger: _ } =>
      match evidence {
        FrontierPresenceUnobserved =>
          FrontierDischargeUnobservable { declaration: declaration, discharge: discharge }
        FrontierPresenceObserved { present_decls: present } =>
          match dissolution_status(condition: discharge, present_decls: present) {
            DissolutionFired =>
              FrontierDischargeFired { declaration: declaration, discharge: discharge }
            DissolutionPending =>
              FrontierAwaitingDischarge { declaration: declaration, discharge: discharge }
            DissolutionUnbound =>
              FrontierAwaitingDischarge { declaration: declaration, discharge: discharge }
          }
      }
  }
}

fn admit_frontier_row(row: ProtocolFrontierRow, evidence: FrontierPresenceEvidence) -> FrontierStanding {
  match row {
    FrontierConsumerNamed { frontier: f } => admit_frontier(f: f)
    FrontierConsumerAwaiting { declaration: d, discharge: c } =>
      admit_awaiting_frontier(declaration: d, discharge: c, evidence: evidence)
  }
}

fn frontier_standing_is_honest(s: FrontierStanding) -> Bool {
  match s {
    FrontierHonest => true
    FrontierConsumerIsDeclaration { frontier: _ } => false
    FrontierTriggerIsDeclaration { frontier: _ } => false
    FrontierTriggerIsTheConsumer { frontier: _ } => false
    FrontierAwaitingDischarge { declaration: _, discharge: _ } => false
    FrontierDischargeFired { declaration: _, discharge: _ } => false
    FrontierDischargeUnobservable { declaration: _, discharge: _ } => false
  }
}

fn frontier_standing_admits_binding(s: FrontierStanding) -> Bool {
  match s {
    FrontierHonest => true
    FrontierAwaitingDischarge { declaration: _, discharge: _ } => true
    FrontierConsumerIsDeclaration { frontier: _ } => false
    FrontierTriggerIsDeclaration { frontier: _ } => false
    FrontierTriggerIsTheConsumer { frontier: _ } => false
    FrontierDischargeFired { declaration: _, discharge: _ } => false
    FrontierDischargeUnobservable { declaration: _, discharge: _ } => false
  }
}

fn bind_declared_frontiers(
  frontiers: List<ProtocolFrontierRow>,
  evidence: FrontierPresenceEvidence,
) -> CanonicalProtocolStanding {
  let standings = fold(frontiers, init: [], f: fn(acc, row) {
    concat(acc, [admit_frontier_row(row: row, evidence: evidence)])
  })
  if fold(standings, init: true, f: fn(ok, s) {
    if ok {
      frontier_standing_admits_binding(s: s)
    } else {
      false
    }
  }) {
    CanonicalProtocolBound { frontiers: standings }
  } else {
    CanonicalFrontiersUnbound { frontiers: standings }
  }
}

fn bind_canonical_protocol() -> CanonicalProtocolStanding {
  match bind_census_protocol_phases(census: host_convergence_census_standing) {
    CensusStandingMalformed { cause: c } =>
      CensusProtocolUnbound { standing: CensusStandingMalformed { cause: c } }
    CensusSelectionLeaked { identity: i, leak: l } =>
      CensusProtocolUnbound { standing: CensusSelectionLeaked { identity: i, leak: l } }
    CensusPhasesBound =>
      match canonical_layer_join(
        required: required_canonical_layers,
        bindings: canonical_protocol_bindings,
      ) {
        CanonicalLayerMissing { layer: m } =>
          CanonicalLayersUnbound { join: CanonicalLayerMissing { layer: m } }
        CanonicalLayerDuplicated { layer: d } =>
          CanonicalLayersUnbound { join: CanonicalLayerDuplicated { layer: d } }
        CanonicalLayersCovered =>
          bind_declared_frontiers(
            frontiers: host_effect_declared_frontiers,
            evidence: FrontierPresenceUnobserved,
          )
      }
  }
}

// THE PRODUCTION GATE. gunbc.fleet_converge_plan_cli refuses to plan unless this admits.
// It STOPS: a malformed census, a missing or duplicated canonical layer, any frontier row
// naming itself (the three ProtocolDeclaredFrontier defect arms), a discharge that fired
// without the row being discharged, and a bound discharge with no observed population.
// It does NOT stop a declared frontier that is openly awaiting an unbuilt consumer.
type CanonicalProtocolGate
  = CanonicalProtocolAdmitted { frontiers: List<FrontierStanding> }
  | CanonicalProtocolRefused { standing: CanonicalProtocolStanding }

fn canonical_protocol_gate(standing: CanonicalProtocolStanding) -> CanonicalProtocolGate {
  match standing {
    CanonicalProtocolBound { frontiers: fs } => CanonicalProtocolAdmitted { frontiers: fs }
    CanonicalFrontiersUnbound { frontiers: _ } => CanonicalProtocolRefused { standing: standing }
    CanonicalLayersUnbound { join: _ } => CanonicalProtocolRefused { standing: standing }
    CensusProtocolUnbound { standing: _ } => CanonicalProtocolRefused { standing: standing }
  }
}

fn canonical_protocol_standing_label(standing: CanonicalProtocolStanding) -> String {
  match standing {
    CanonicalProtocolBound { frontiers: _ } => "CanonicalProtocolBound"
    CanonicalFrontiersUnbound { frontiers: _ } => "CanonicalFrontiersUnbound"
    CanonicalLayersUnbound { join: _ } => "CanonicalLayersUnbound"
    CensusProtocolUnbound { standing: _ } => "CensusProtocolUnbound"
  }
}
