module gunbc.stage0_rust_source_lifecycle_scaffold

import gunbc.stage0_cargo_manifest { stage0_cargo_bin_repo_paths_from_manifest_ref }
import gunbc.stage0_emit_model {
  generated_stage0_files,
  is_generated_stage0_file
}
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import v2.compiler.self_host.frontier { hand_maintained_stage0_filenames }
import v2.std.algebra { any, fold_list, length, list_map, list_snoc_item }
import v2.std.collection { List }
import v2.std.text { String }
import v2.workflow.rust_crate_partition { stage0_partition_crate_rows }

data stage0_rust_source_lifecycle_scaffold_note: String = "SCAFFOLD — NOT the live ZeroHandMaintainedRust instrument (V1FinishLine in PR #7393). Stage0 seed-surface lifecycle: joins existing .dag authorities (generated_stage0_files, hand_maintained_stage0_filenames, stage0_partition_crate_rows) plus file-grain residue rows. Cargo [[bin]] paths are host-derived from Cargo.toml (gunbc.stage0_cargo_manifest), never hand-listed. Full-repo tracked .rs manifest is RustManifestUnmeasured until host execution supplies RustManifestMeasured — Unmeasured cannot masquerade as zero unclassified. Discovery prefix hints name where the future manifest consumer should look; they do NOT classify children. Dissolves when rust_source_tracked_manifest_note host consumer lands and this scaffold promotes to the ZeroHandMaintainedRust acceptance graph."

data zero_hand_maintained_rust_finish_line_attachment_note: String = "Attach to V1FinishLine ZeroHandMaintainedRust (PR #7393) when that finish line lands: acceptance requires RustManifestMeasured with newly_unclassified=0, stale_lifecycle_rows=0, duplicate_exact_paths=0, and hand_maintained_count ratchet — not this scaffold's partial joins alone."

data rust_source_tracked_manifest_note: String = "Follow-on: host emits tracked .rs paths (git ls-files shape) and computes set-difference against file_grain_classified + residue rows. Discovery prefix hints (rust_source_discovery_prefix_hints) are INPUTS to that consumer only — never lifecycle dispositions. Until measured, rust_source_manifest_state stays RustManifestUnmeasured."

type RustSourceManifestState
  = RustManifestUnmeasured { awaiting: String }
  | RustManifestMeasured {
      tracked_count: Int,
      classified_file_grain_count: Int,
      unclassified_count: Int,
      newly_unclassified: Int,
      stale_lifecycle_rows: Int,
      duplicate_exact_paths: Int,
      hand_maintained_count: Int,
      hand_maintained_prior_count: Int
    }

data rust_source_manifest_state: RustSourceManifestState = RustManifestUnmeasured {
  awaiting: "v1_compiler.cli_run.git_tracked_rust_repo_paths + set-difference consumer"
}

type RustSourceManifestStateVerdict
  = ManifestStateScaffoldOk
  | ManifestStateScaffoldRefused { cause: RustSourceManifestStateRefusal }

type RustSourceManifestStateRefusal
  = UnmeasuredTrackedManifest { awaiting: String }
  | MeasuredNewlyUnclassified { count: Int }
  | MeasuredStaleLifecycleRows { count: Int }
  | MeasuredDuplicateExactPaths { count: Int }
  | MeasuredHandMaintainedGrew { prior: Int, current: Int }
  | MeasuredClaimsUnclassified { count: Int }

data rust_source_manifest_state_verdict_query_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.stage0_rust_source_lifecycle_scaffold",
    decl_name: "rust_source_manifest_state_verdict",
    field: WholeDeclaration
  }
}

data rust_source_manifest_state_verdict_dissolve_trigger: String = "🟡 dissolve-on: rust_source_manifest_state_verdict — interim scaffold query fold over RustSourceManifestState; DISSOLVES WHEN PR #7393 ZeroHandMaintainedRust V1FinishLine lands (ROADMAP.md hand-maintained-Rust-to-zero lane, authority dag/gunbc/v1_deletion_plan.dag) and manifest ratchet enforcement moves to the finish-line acceptance graph"

fn rust_source_manifest_state_verdict(state: RustSourceManifestState) -> RustSourceManifestStateVerdict {
  match state {
    RustManifestUnmeasured { awaiting: awaiting } =>
      ManifestStateScaffoldRefused { cause: UnmeasuredTrackedManifest { awaiting: awaiting } }
    RustManifestMeasured {
      tracked_count: _,
      classified_file_grain_count: _,
      unclassified_count: unclassified_count,
      newly_unclassified: newly_unclassified,
      stale_lifecycle_rows: stale_lifecycle_rows,
      duplicate_exact_paths: duplicate_exact_paths,
      hand_maintained_count: hand_maintained_count,
      hand_maintained_prior_count: hand_maintained_prior_count
    } =>
      if newly_unclassified != 0 {
        ManifestStateScaffoldRefused { cause: MeasuredNewlyUnclassified { count: newly_unclassified } }
      } else if stale_lifecycle_rows != 0 {
        ManifestStateScaffoldRefused { cause: MeasuredStaleLifecycleRows { count: stale_lifecycle_rows } }
      } else if duplicate_exact_paths != 0 {
        ManifestStateScaffoldRefused { cause: MeasuredDuplicateExactPaths { count: duplicate_exact_paths } }
      } else if hand_maintained_count > hand_maintained_prior_count {
        ManifestStateScaffoldRefused {
          cause: MeasuredHandMaintainedGrew { prior: hand_maintained_prior_count, current: hand_maintained_count }
        }
      } else if unclassified_count != 0 {
        ManifestStateScaffoldRefused { cause: MeasuredClaimsUnclassified { count: unclassified_count } }
      } else {
        ManifestStateScaffoldOk
      }
  }
}

data rust_source_discovery_prefix_hints: List<String> = [
  "src/v1/tests/",
  "dag/tools/",
  "src/v1/stage0/tests/",
  "src/v1/stage0/examples/"
]

data stage0_src_repo_prefix: String = "src/v1/stage0/src/"

data generated_stage0_files_authority_ref: DeclarationRef = DeclarationRef {
  module_path: "gunbc.stage0_emit_model",
  decl_name: "generated_stage0_files",
  field: WholeDeclaration
}

data hand_maintained_stage0_filenames_authority_ref: DeclarationRef = DeclarationRef {
  module_path: "v2.compiler.self_host.frontier",
  decl_name: "hand_maintained_stage0_filenames",
  field: WholeDeclaration
}

data stage0_partition_crate_rows_authority_ref: DeclarationRef = DeclarationRef {
  module_path: "v2.workflow.rust_crate_partition",
  decl_name: "stage0_partition_crate_rows",
  field: WholeDeclaration
}

data stage0_cargo_bin_manifest_authority_ref: DeclarationRef = stage0_cargo_bin_repo_paths_from_manifest_ref

data behavioral_oracle_carrier_ref: DeclarationRef = DeclarationRef {
  module_path: "tools.self_host_module_behavioral_transport_roster",
  decl_name: "compiler_module_behavioral_transport_roster",
  field: WholeDeclaration
}

type RustSourceLifecycleObligation
  = DerivedGenerated { authority: DeclarationRef }
  | DerivedHandMaintainedLayout { authority: DeclarationRef }
  | DerivedCargoBinManifest { authority: DeclarationRef }
  | DerivedPartitionCrateRoot { authority: DeclarationRef }
  | CitedBehavioralOracleCarrier { carrier: DeclarationRef }
  | ResidueHandMaintenance { reason: String, dissolve_on: String }

type RustSourceLifecycleRow {
  path: String
  obligations: List<RustSourceLifecycleObligation>
}

fn stage0_src_repo_path(filename: String) -> String {
  concat(stage0_src_repo_prefix, filename)
}

fn derived_generated_stage0_repo_paths() -> List<String> {
  list_map(xs: generated_stage0_files, f: fn(basename) { stage0_src_repo_path(filename: basename) })
}

fn derived_hand_maintained_stage0_repo_paths() -> List<String> {
  list_map(
    xs: hand_maintained_stage0_filenames(),
    f: fn(filename) { stage0_src_repo_path(filename: filename) }
  )
}

fn partition_crate_lib_repo_path(crate_dir: String) -> String {
  concat(crate_dir, "/src/lib.rs")
}

fn derived_partition_crate_lib_repo_paths() -> List<String> {
  list_map(
    xs: stage0_partition_crate_rows(),
    f: fn(row) { partition_crate_lib_repo_path(crate_dir: row.crate_dir) }
  )
}

fn derived_cargo_bin_repo_paths() -> List<String> {
  stage0_cargo_bin_manifest_repo_paths()
}

fn list_concat_unique(acc: List<String>, items: List<String>) -> List<String> {
  fold_list(
    xs: items,
    init: acc,
    cons: fn(acc_paths, path) {
      if any(xs: acc_paths, predicate: fn(p) { p == path }) {
        acc_paths
      } else {
        list_snoc_item(xs: acc_paths, item: path)
      }
    }
  )
}

fn derived_authority_join_repo_paths() -> List<String> {
  let from_generated = derived_generated_stage0_repo_paths()
  let with_hand = list_concat_unique(acc: from_generated, items: derived_hand_maintained_stage0_repo_paths())
  let with_partition = list_concat_unique(acc: with_hand, items: derived_partition_crate_lib_repo_paths())
  list_concat_unique(acc: with_partition, items: derived_cargo_bin_repo_paths())
}

fn derived_cargo_bin_paths_in_authority_join_holds() -> Bool {
  fold_list(
    xs: derived_cargo_bin_repo_paths(),
    init: true,
    cons: fn(ok, cargo_path) {
      ok && any(
        xs: derived_authority_join_repo_paths(),
        predicate: fn(join_path) { join_path == cargo_path }
      )
    }
  )
}

fn path_has_prefix(path: String, prefix: String) -> Bool {
  starts_with(s: path, prefix: prefix)
}

fn path_matches_discovery_prefix_hint(path: String) -> Bool {
  any(
    xs: rust_source_discovery_prefix_hints,
    predicate: fn(prefix) { path_has_prefix(path: path, prefix: prefix) }
  )
}

data residue_bootstrap_layout_copy_reason: String = "bootstrap copy of gunbc.stage0_crate_layout_generated.rs committed under src/v1/stage0/src for stage0 seed compile — not a generated_stage0_files basename"

data residue_bootstrap_layout_copy_dissolve_on: String = "dissolve-on: bootstrap_stage0_crate_layout_generated.rs is either enrolled in generated_stage0_files or deleted when layout regen routes through a single authority"

data residue_cssl_assembly_reason: String = "hand-retained cssl seed-linked closure assembly kernel — not regen-emitted; counted scaffold until harness consolidation emits it"

data residue_cssl_assembly_dissolve_on: String = "dissolve-on: cssl_seed_linked_closure_assembly.rs migrates to generated_stage0_files membership or a typed emit producer row deletes the hand file"

data residue_module_path_index_reason: String = "hand_maintained_stage0_dirs lists module_path_index/ but file membership is not enumerated by any join authority yet"

data residue_module_path_index_dissolve_on: String = "dissolve-on: module_path_index/*.rs paths derive from hand_maintained_stage0_dirs + host census, or the directory dissolves into generated emit"

data residue_frontier_module_gap_reason: String = "frontier module with behavioral receipt roster row but not yet on hand_maintained_stage0_filenames / generated_stage0_files join"

data residue_frontier_module_gap_dissolve_on: String = "dissolve-on: the module basename appears on hand_maintained_stage0_filenames() or generated_stage0_files and this residue row deletes"

data residue_stage0_core_lib_reason: String = "src/v1/stage0_core/src/lib.rs exists on disk but is absent from stage0_partition_crate_rows — authority contradiction surfaced for operator resolution"

data residue_stage0_core_lib_dissolve_on: String = "dissolve-on: stage0_partition_crate_rows enrolls src/v1/stage0_core OR the crate deletes"

fn residue_obligation(reason: String, dissolve_on: String) -> RustSourceLifecycleObligation {
  ResidueHandMaintenance { reason: reason, dissolve_on: dissolve_on }
}

fn residue_row(path: String, reason: String, dissolve_on: String) -> RustSourceLifecycleRow {
  RustSourceLifecycleRow {
    path: path,
    obligations: [residue_obligation(reason: reason, dissolve_on: dissolve_on)]
  }
}

data rust_source_lifecycle_residue_rows: List<RustSourceLifecycleRow> = [
  residue_row(
    path: "src/v1/stage0/src/bootstrap_stage0_crate_layout_generated.rs",
    reason: residue_bootstrap_layout_copy_reason,
    dissolve_on: residue_bootstrap_layout_copy_dissolve_on
  ),
  residue_row(
    path: "src/v1/stage0/src/cssl_seed_linked_closure_assembly.rs",
    reason: residue_cssl_assembly_reason,
    dissolve_on: residue_cssl_assembly_dissolve_on
  ),
  residue_row(
    path: "src/v1/stage0/src/module_path_index/mod.rs",
    reason: residue_module_path_index_reason,
    dissolve_on: residue_module_path_index_dissolve_on
  ),
  residue_row(
    path: "src/v1/stage0/src/module_path_index/index.rs",
    reason: residue_module_path_index_reason,
    dissolve_on: residue_module_path_index_dissolve_on
  ),
  residue_row(
    path: "src/v1/stage0/src/module_path_index/parsed_dag_file.rs",
    reason: residue_module_path_index_reason,
    dissolve_on: residue_module_path_index_dissolve_on
  ),
  residue_row(
    path: "src/v1/stage0/src/v2_compiler_compile.rs",
    reason: residue_frontier_module_gap_reason,
    dissolve_on: residue_frontier_module_gap_dissolve_on
  ),
  residue_row(
    path: "src/v1/stage0/src/v2_compiler_program_assembly.rs",
    reason: residue_frontier_module_gap_reason,
    dissolve_on: residue_frontier_module_gap_dissolve_on
  ),
  residue_row(
    path: "src/v1/stage0/src/v2_compiler_source_authority.rs",
    reason: residue_frontier_module_gap_reason,
    dissolve_on: residue_frontier_module_gap_dissolve_on
  ),
  residue_row(
    path: "src/v1/stage0_core/src/lib.rs",
    reason: residue_stage0_core_lib_reason,
    dissolve_on: residue_stage0_core_lib_dissolve_on
  )
]

fn residue_lifecycle_repo_paths() -> List<String> {
  list_map(xs: rust_source_lifecycle_residue_rows, f: fn(row) { row.path })
}

fn derived_cargo_bin_paths_disjoint_from_residue_holds() -> Bool {
  !any(
    xs: derived_cargo_bin_repo_paths(),
    predicate: fn(cargo_path) {
      any(xs: residue_lifecycle_repo_paths(), predicate: fn(residue_path) { residue_path == cargo_path })
    }
  )
}

fn file_grain_lifecycle_repo_paths() -> List<String> {
  list_concat_unique(acc: derived_authority_join_repo_paths(), items: residue_lifecycle_repo_paths())
}

fn declaration_ref_populated(ref: DeclarationRef) -> Bool {
  !(ref.module_path == "") && !(ref.decl_name == "")
}

fn rust_source_lifecycle_obligation_well_formed(obligation: RustSourceLifecycleObligation) -> Bool {
  match obligation {
    DerivedGenerated { authority: ref } => declaration_ref_populated(ref: ref)
    DerivedHandMaintainedLayout { authority: ref } => declaration_ref_populated(ref: ref)
    DerivedCargoBinManifest { authority: ref } => declaration_ref_populated(ref: ref)
    DerivedPartitionCrateRoot { authority: ref } => declaration_ref_populated(ref: ref)
    CitedBehavioralOracleCarrier { carrier: ref } => declaration_ref_populated(ref: ref)
    ResidueHandMaintenance { reason: reason, dissolve_on: dissolve_on } =>
      !(reason == "") && !(dissolve_on == "")
  }
}

data lifecycle_row_well_formed_query_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.stage0_rust_source_lifecycle_scaffold",
    decl_name: "lifecycle_row_well_formed",
    field: WholeDeclaration
  }
}

data lifecycle_row_well_formed_query_dissolve_trigger: String = "🟡 dissolve-on: lifecycle_row_well_formed — interim scaffold obligation-shape validator; DISSOLVES WHEN PR #7393 ZeroHandMaintainedRust V1FinishLine lands and row well-formedness derives from the finish-line acceptance graph"

fn lifecycle_row_well_formed(row: RustSourceLifecycleRow) -> Bool {
  !(row.path == "")
    && length(xs: row.obligations) > 0
    && fold_list(
      xs: row.obligations,
      init: true,
      cons: fn(ok, obligation) {
        ok && rust_source_lifecycle_obligation_well_formed(obligation: obligation)
      }
    )
}

fn rust_source_lifecycle_residue_rows_well_formed() -> Bool {
  fold_list(
    xs: rust_source_lifecycle_residue_rows,
    init: true,
    cons: fn(ok, row) { ok && lifecycle_row_well_formed(row: row) }
  )
}

fn path_occurrence_count(paths: List<String>, needle: String) -> Int {
  fold_list(
    xs: paths,
    init: 0,
    cons: fn(count, path) {
      if path == needle {
        count + 1
      } else {
        count
      }
    }
  )
}

fn list_paths_all_unique(paths: List<String>) -> Bool {
  fold_list(
    xs: paths,
    init: true,
    cons: fn(ok, path) { ok && path_occurrence_count(paths: paths, needle: path) == 1 }
  )
}

fn rust_source_lifecycle_residue_paths_unique() -> Bool {
  list_paths_all_unique(paths: residue_lifecycle_repo_paths())
}

fn duplicate_exact_paths_zero_holds() -> Bool {
  list_paths_all_unique(paths: file_grain_lifecycle_repo_paths())
}

fn generated_repo_paths_cover_authority_holds() -> Bool {
  fold_list(
    xs: generated_stage0_files,
    init: true,
    cons: fn(ok, basename) {
      ok && any(
        xs: derived_generated_stage0_repo_paths(),
        predicate: fn(p) { p == stage0_src_repo_path(filename: basename) }
      )
    }
  )
}

fn generated_authority_subset_of_derived_holds() -> Bool {
  fold_list(
    xs: derived_generated_stage0_repo_paths(),
    init: true,
    cons: fn(ok, path) {
      let basename = replace(path, stage0_src_repo_prefix, "")
      ok && is_generated_stage0_file(basename: basename)
    }
  )
}

fn partition_crate_paths_complete_holds() -> Bool {
  length(xs: derived_partition_crate_lib_repo_paths()) == length(xs: stage0_partition_crate_rows())
}

fn derived_generated_hand_disjoint_holds() -> Bool {
  !any(
    xs: derived_hand_maintained_stage0_repo_paths(),
    predicate: fn(path) {
      any(xs: derived_generated_stage0_repo_paths(), predicate: fn(gen_path) { gen_path == path })
    }
  )
}

fn classified_residue_disjoint_holds() -> Bool {
  !any(
    xs: residue_lifecycle_repo_paths(),
    predicate: fn(residue_path) {
      any(xs: derived_authority_join_repo_paths(), predicate: fn(derived_path) { derived_path == residue_path })
    }
  )
}

fn file_grain_paths_avoid_discovery_prefix_holds() -> Bool {
  !any(
    xs: file_grain_lifecycle_repo_paths(),
    predicate: fn(file_path) { path_matches_discovery_prefix_hint(path: file_path) }
  )
}

fn manifest_state_verdict_scaffold_holds() -> Bool {
  match rust_source_manifest_state_verdict(state: rust_source_manifest_state) {
    ManifestStateScaffoldOk => true
    ManifestStateScaffoldRefused { cause: UnmeasuredTrackedManifest { awaiting: _ } } => true
    ManifestStateScaffoldRefused { cause: _ } => false
  }
}

fn stage0_rust_lifecycle_scaffold_mechanical_checks_holds() -> Bool {
  generated_repo_paths_cover_authority_holds()
    && generated_authority_subset_of_derived_holds()
    && partition_crate_paths_complete_holds()
    && derived_generated_hand_disjoint_holds()
    && classified_residue_disjoint_holds()
    && derived_cargo_bin_paths_in_authority_join_holds()
    && derived_cargo_bin_paths_disjoint_from_residue_holds()
    && stage0_cargo_bin_manifest_parse_complete_holds()
    && file_grain_paths_avoid_discovery_prefix_holds()
    && duplicate_exact_paths_zero_holds()
    && rust_source_lifecycle_residue_rows_well_formed()
    && rust_source_lifecycle_residue_paths_unique()
    && manifest_state_verdict_scaffold_holds()
}

data rust_source_lifecycle_partition_contradiction_note: String = "OPEN: src/v1/stage0_core/src/lib.rs is tracked on disk but stage0_partition_crate_rows has no src/v1/stage0_core row. Residue row surfaces the contradiction; operator resolves via partition row or crate deletion."
