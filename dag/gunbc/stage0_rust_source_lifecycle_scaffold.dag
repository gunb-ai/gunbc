module gunbc.stage0_rust_source_lifecycle_scaffold



data stage0_rust_source_lifecycle_scaffold_note: String = "SCAFFOLD — NOT the live ZeroHandMaintainedRust instrument. gunbc.stage0_rust_host_observation supplies the exact tracked-Rust subject plus Cargo target ROLE facts. This module keeps role and maintenance disposition independent: CargoBin never classifies a path as Generated, DeleteWith, RetainedKernel, or HandScaffold. A Cargo target with no maintenance disposition refuses as CargoTargetMissingLifecycleDisposition. Product reachability and LOC/capability ratchets remain explicit v1-honest-frontier follow-on work; this observation prerequisite does not claim those finish lines."

data zero_hand_maintained_rust_finish_line_attachment_note: String = "Observation prerequisite only: RustManifestObserved establishes the revision-addressed subject and Cargo roles. v1-honest-frontier must separately derive maintenance disposition, product reachability, generation authority, retirement trigger, hand LOC, and typed hand obligations before V1FinishLine ZeroHandMaintainedRust can consume it."

type RustSourceManifestStateVerdict
  = ManifestStateScaffoldOk
  | ManifestStateScaffoldRefused { cause: RustSourceManifestStateRefusal }

type RustSourceManifestStateRefusal
  = HostManifestReadRefused { detail: String }
  | HostManifestParseRefused { detail: String }
  | HostGitObservationRefused { detail: String }
  | DerivedNewlyUnclassified { count: Int }
  | DerivedStaleLifecycleRows { count: Int }
  | DerivedDuplicateExactPaths { count: Int }
  | DerivedHandMaintainedGrew { prior: Int, current: Int }
  | DerivedUnclassifiedTracked { count: Int }
  | EmitPopulationUnobservedEvidence { detail: String }
  | ObservedCargoPathUntracked { path: String }
  | CargoTargetMissingLifecycleDisposition { path: String }

data rust_source_manifest_state_verdict_query_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.stage0_rust_source_lifecycle_scaffold",
    decl_name: "rust_source_manifest_state_verdict",
    field: std.decl_ref.WholeDeclaration
  }
}

data rust_source_manifest_state_verdict_dissolve_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: rust_source_manifest_state_verdict — interim scaffold evidence fold; DISSOLVES WHEN V1FinishLine ZeroHandMaintainedRust acceptance graph subsumes path-derived ratchets (authority dag/gunbc/v1_deletion_plan.dag, ROADMAP.md:24 / v1-zero-hand-maintained-rust)")

fn path_in_list(path: String, paths: std.types.List<String>) -> Bool {
  v2.std.algebra.any(xs: paths, predicate: fn(p) { p == path })
}

fn observed_cargo_paths_subset_of_tracked(
  cargo_bin_repo_paths: std.types.List<String>,
  tracked_paths: std.types.List<String>
) -> Bool {
  v2.std.algebra.fold_list(
    xs: cargo_bin_repo_paths,
    empty: true,
    cons: fn(ok, cargo_path) { ok && path_in_list(path: cargo_path, paths: tracked_paths) }
  )
}

fn first_untracked_cargo_path(
  cargo_bin_repo_paths: std.types.List<String>,
  tracked_paths: std.types.List<String>
) -> String {
  v2.std.algebra.fold_list(
    xs: cargo_bin_repo_paths,
    empty: "",
    cons: fn(first, cargo_path) {
      if first != "" {
        first
      } else if path_in_list(path: cargo_path, paths: tracked_paths) {
        ""
      } else {
        cargo_path
      }
    }
  )
}

fn count_tracked_unclassified(tracked_paths: std.types.List<String>, classified_paths: std.types.List<String>) -> Int {
  v2.std.algebra.fold_list(
    xs: tracked_paths,
    empty: 0,
    cons: fn(count, path) {
      if path_in_list(path: path, paths: classified_paths) {
        count
      } else {
        count + 1
      }
    }
  )
}

fn count_newly_unclassified_tracked(
  tracked_paths: std.types.List<String>,
  prior_tracked_paths: std.types.List<String>,
  classified_paths: std.types.List<String>
) -> Int {
  v2.std.algebra.fold_list(
    xs: tracked_paths,
    empty: 0,
    cons: fn(count, path) {
      let is_new = !path_in_list(path: path, paths: prior_tracked_paths)
      let is_classified = path_in_list(path: path, paths: classified_paths)
      if is_new && !is_classified {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_stale_lifecycle_rows(tracked_paths: std.types.List<String>, lifecycle_paths: std.types.List<String>) -> Int {
  v2.std.algebra.fold_list(
    xs: lifecycle_paths,
    empty: 0,
    cons: fn(count, path) {
      if path_in_list(path: path, paths: tracked_paths) {
        count
      } else {
        count + 1
      }
    }
  )
}

fn count_hand_maintained_in_tracked(tracked_paths: std.types.List<String>) -> Int {
  v2.std.algebra.fold_list(
    xs: derived_hand_maintained_disposition_repo_paths(),
    empty: 0,
    cons: fn(count, hand_path) {
      if path_in_list(path: hand_path, paths: tracked_paths) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_hand_maintained_in_prior_tracked(prior_tracked_paths: std.types.List<String>) -> Int {
  v2.std.algebra.fold_list(
    xs: derived_hand_maintained_disposition_repo_paths(),
    empty: 0,
    cons: fn(count, hand_path) {
      if path_in_list(path: hand_path, paths: prior_tracked_paths) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_duplicate_path_excess(paths: std.types.List<String>) -> Int {
  v2.std.algebra.fold_list(
    xs: paths,
    empty: 0,
    cons: fn(excess, path) {
      let occurrences = std.keyed_roster.path_occurrence_count(paths: paths, target: path)
      if occurrences > 1 {
        excess + (occurrences - 1)
      } else {
        excess
      }
    }
  )
}

fn count_observed_manifest_duplicate_excess(
  tracked_paths: std.types.List<String>,
  prior_tracked_paths: std.types.List<String>,
  cargo_bin_repo_paths: std.types.List<String>
) -> Int {
  v2.std.algebra.fold_list(
    xs: [tracked_paths, prior_tracked_paths, cargo_bin_repo_paths],
    empty: 0,
    cons: fn(sum, paths) { sum + count_duplicate_path_excess(paths: paths) }
  )
}

// A CARGO TARGET MUST BE NAMED BY AN AUTHORITY, NOT MERELY FALL UNDER THE EMITTER'S COMPLEMENT.
// CargoTargetMissingLifecycleDisposition asks whether some authority accounts for a [[bin]]
// path. It formerly compared against the whole lifecycle population, which was safe while the
// generated half was an enumerated roster. It is not safe now: the derived half claims EVERY
// unclaimed direct child of the stage0 root, so any new [[bin]] under that root would answer
// "dispositioned" by construction and the refusal could never fire again. That is the DESIGN 5
// absorbing fallback exactly -- the arm widens instead of refusing, and its firing rate goes to
// zero by construction rather than because the defect stopped occurring. Caught by execution:
// scaffold_observed_cargo_role_does_not_supply_lifecycle_disposition went red on the floor while
// two reviews passed over the change. The comparison is against the AUTHORED classification.
// ON THE EmitPopulationUnobserved ARM BELOW: THE LINE STOPS; IT DOES NOT WIDEN. Without the
// emitter's declaration this module cannot separate "the emitter produces this" from "nobody
// registered this", which is precisely the deficit #8674's rung drop was declared over. Falling
// back to the crate-layout complement in that arm would restore the deficit while still reporting
// a verdict, with its own firing rate zeroed by construction -- the absorbing fallback DESIGN 5
// forbids. So the arm refuses, typed and located, and the degradation is countable.
fn rust_source_manifest_state_verdict(observation: RustSourceHostObservation) -> RustSourceManifestStateVerdict {
  match observation {
    RustManifestReadRefused { detail: detail } =>
      ManifestStateScaffoldRefused { cause: HostManifestReadRefused { detail: detail } }
    RustManifestParseRefused { detail: detail } =>
      ManifestStateScaffoldRefused { cause: HostManifestParseRefused { detail: detail } }
    GitObservationRefused { detail: detail } =>
      ManifestStateScaffoldRefused { cause: HostGitObservationRefused { detail: detail } }
    RustManifestObserved {
      repository_revision: repository_revision,
      manifest_content_identity: manifest_content_identity,
      tracked_rust_repo_paths: tracked_paths,
      prior_tracked_rust_repo_paths: prior_tracked_paths,
      cargo_bin_repo_paths: cargo_bin_repo_paths,
      emit_population_evidence: emit_population_evidence
    } =>
      if repository_revision == "" {
        ManifestStateScaffoldRefused { cause: HostManifestReadRefused { detail: "observed manifest missing repository_revision" } }
      } else {
        match emit_population_evidence {
          EmitPopulationUnobserved { detail: detail } =>
            ManifestStateScaffoldRefused { cause: EmitPopulationUnobservedEvidence { detail: detail } }
          EmitPopulationConfirmed { emitted_stage0_repo_paths: emitted_stage0_repo_paths } =>
            let file_grain_paths = file_grain_lifecycle_repo_paths(
              emitted_stage0_repo_paths: emitted_stage0_repo_paths,
              tracked_paths: tracked_paths
            )
            let classified_paths = file_grain_paths
            let lifecycle_paths = classified_paths
            let newly_unclassified = count_newly_unclassified_tracked(
              tracked_paths: tracked_paths,
              prior_tracked_paths: prior_tracked_paths,
              classified_paths: classified_paths
            )
            let unclassified = count_tracked_unclassified(tracked_paths: tracked_paths, classified_paths: classified_paths)
            let stale = count_stale_lifecycle_rows(tracked_paths: tracked_paths, lifecycle_paths: lifecycle_paths)
            let duplicate_excess = count_observed_manifest_duplicate_excess(
              tracked_paths: tracked_paths,
              prior_tracked_paths: prior_tracked_paths,
              cargo_bin_repo_paths: cargo_bin_repo_paths
            )
            let hand_current = count_hand_maintained_in_tracked(tracked_paths: tracked_paths)
            let hand_prior = count_hand_maintained_in_prior_tracked(prior_tracked_paths: prior_tracked_paths)
            let untracked_cargo = first_untracked_cargo_path(
              cargo_bin_repo_paths: cargo_bin_repo_paths,
              tracked_paths: tracked_paths
            )
            let cargo_without_disposition = first_untracked_cargo_path(
              cargo_bin_repo_paths: cargo_bin_repo_paths,
              tracked_paths: non_generated_classified_repo_paths()
            )
            if length(xs: cargo_bin_repo_paths) == 0 {
              ManifestStateScaffoldRefused { cause: HostManifestParseRefused { detail: "observed manifest missing cargo_bin_repo_paths evidence" } }
            } else if untracked_cargo != "" {
              ManifestStateScaffoldRefused { cause: ObservedCargoPathUntracked { path: untracked_cargo } }
            } else if cargo_without_disposition != "" {
              ManifestStateScaffoldRefused {
                cause: CargoTargetMissingLifecycleDisposition { path: cargo_without_disposition }
              }
            } else if newly_unclassified != 0 {
              ManifestStateScaffoldRefused { cause: DerivedNewlyUnclassified { count: newly_unclassified } }
            } else if stale != 0 {
              ManifestStateScaffoldRefused { cause: DerivedStaleLifecycleRows { count: stale } }
            } else if duplicate_excess != 0 {
              ManifestStateScaffoldRefused { cause: DerivedDuplicateExactPaths { count: duplicate_excess } }
            } else if hand_current > hand_prior {
              ManifestStateScaffoldRefused { cause: DerivedHandMaintainedGrew { prior: hand_prior, current: hand_current } }
            } else if unclassified != 0 {
              ManifestStateScaffoldRefused { cause: DerivedUnclassifiedTracked { count: unclassified } }
            } else {
              ManifestStateScaffoldOk
            }
        }
      }
  }
}

data rust_source_prefix_test_harness: String = "src/v1/tests/"

data rust_source_prefix_stage0_test: String = "src/v1/stage0/tests/"

data rust_source_prefix_stage0_example: String = "src/v1/stage0/examples/"

data rust_source_prefix_tooling: String = "dag/tools/"

data rust_source_discovery_prefix_hints: std.types.List<String> = [
  rust_source_prefix_test_harness,
  rust_source_prefix_tooling,
  rust_source_prefix_stage0_test,
  rust_source_prefix_stage0_example
]

data stage0_src_repo_prefix: String = "src/v1/stage0/src/"

data hand_maintained_stage0_filenames_authority_ref: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "v2.compiler.self_host.stage0_crate_layout",
  decl_name: "hand_maintained_stage0_filenames",
  field: std.decl_ref.WholeDeclaration
}

data stage0_partition_crate_rows_authority_ref: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "v2.workflow.rust_crate_partition",
  decl_name: "stage0_partition_crate_rows",
  field: std.decl_ref.WholeDeclaration
}

data stage0_cargo_bin_manifest_authority_ref: std.decl_ref.DeclarationRef = gunbc.stage0_cargo_manifest.stage0_cargo_bin_paths_observation_ref

data behavioral_oracle_carrier_ref: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "tools.self_host_module_behavioral_transport_roster",
  decl_name: "compiler_module_behavioral_transport_roster",
  field: std.decl_ref.WholeDeclaration
}

type RustSourceRole
  = CargoBin
  | CargoLib
  | Test
  | BehavioralOracle
  | Tooling

type RustMaintenanceDisposition
  = Generated { authority: std.decl_ref.DeclarationRef }
  | EmitFrom { authority: std.decl_ref.DeclarationRef }
  | DeleteWith { roadmap_node: gunbc.roadmap_model.RoadmapNodeId }
  | RetainedKernel { reason: String }
  | HandScaffold { reason: std.types.NonEmptyStr, dissolution: std.dissolution.DissolutionCondition }

type RustSourceLifecycleRow {
  path: String
  roles: std.types.List<RustSourceRole>
  maintenance_dispositions: std.types.List<RustMaintenanceDisposition>
}

fn stage0_src_repo_path(filename: String) -> String {
  concat(stage0_src_repo_prefix, filename)
}


//
// `claimed` is hoisted rather than inlined into the predicate: non_generated_classified_repo_paths()
// folds three rosters through list_concat_unique, which is quadratic in its own length, and
// calling it per tracked path would multiply that by the whole observed tree.
// THE GENERATED POPULATION IS THE ONE THE EMITTER DECLARED, READ RATHER THAN RECONSTRUCTED.
//
// It was, in order: a 100+ row hand roster with no producer (deleted by #8674, because its
// producer died in the #8406 regen cut); then the COMPLEMENT of the crate-layout claim over the
// observed tree. The complement is a faithful reconstruction and it still cannot answer the
// question this module asks, which is why #8674 had to declare a rung drop: a direct child of
// the stage0 root that nobody claims is "generated" BY DEFINITION under a complement, so a newly
// hand-added file nobody registered could never surface as unclassified, and the refusal's firing
// rate went to zero by construction.
//
// The emitter now declares its own population (`v1.compiler.emit_rust`
// `emit_emitted_population_manifest` -> `src/v1/stage0/src/emitted_population.rs`), the
// observation reads it at the revision, and this filter selects the tracked paths that
// declaration names. A file the emitter does not produce is now absent from the generated
// population no matter where it sits, which restores exactly the distinction the drop declared
// unavailable -- "the emitter produces this" versus "nobody registered this".
//
// The intersection with `tracked_paths` is deliberate and is not a narrowing: the population this
// module classifies is the OBSERVED tree, so a declared path absent from the tree is not this
// carrier's subject. `required_regen`'s `committed_not_emitted` / `emitted_not_committed` arms
// are the authority on that disagreement and they compare against the real emit, which no at-rest
// fact can. Two carriers, two questions, no second answer to either.
fn derived_generated_stage0_repo_paths(
  emitted_stage0_repo_paths: List<String>,
  tracked_paths: List<String>
) -> List<String> {
  filter(
    xs: tracked_paths,
    predicate: fn(path) { path_in_list(path: path, paths: emitted_stage0_repo_paths) }
  )
}

fn derived_hand_maintained_stage0_repo_paths() -> std.types.List<String> {
  v2.std.algebra.list_map(
    xs: v2.compiler.self_host.stage0_crate_layout.hand_maintained_stage0_filenames(),
    f: fn(filename) { stage0_src_repo_path(filename: filename) }
  )
}

data residue_frontier_module_gap_dissolved_note: String = "v2_compiler_compile.rs, v2_compiler_program_assembly.rs and v2_compiler_source_authority.rs carried a residue_frontier_module_gap row each, whose own dissolution condition read: 'dissolve-on: the module basename appears on hand_maintained_stage0_filenames() ... and this residue row deletes.' The #8428 regen-survivability backfill (pre_existing_hand_retained_registration_backfill_note, v2.compiler.self_host.stage0_crate_layout) registered all three as SeedRetainedIntrinsicRegistration rows, so the trigger fired and the three residue rows are deleted here rather than left stale — the dissolution condition is evidence consumed, not a permission grant kept beside a state it no longer describes."

data residue_cssl_hand_maintained_overlap_note: String = "cssl_seed_linked_closure_assembly.rs is BOTH a residue row here (not yet regen-emitted) AND, since the #8428 backfill, a hand_maintained_stage0_filenames() member (excluded from required_regen_host's compile_stage0() population comparison, since it is a CSSL-harness-compiled oracle never part of the stage0 crate's own mod tree). THIS NOTE FORMERLY TURNED ON A DISTINCTION THAT NO LONGER EXISTS: it argued the dual classification was genuine because the dissolution trigger named generated_stage0_files membership rather than hand_maintained_stage0_filenames() membership -- two rosters, two memberships. With the generated population derived as the complement of the crate-layout claim, those are one membership read two ways, and the trigger is restated accordingly. The dual classification itself survives and is still genuine (residue-pending-emission AND emit-comparison-excluded); what dies is the two-roster argument for it. classified_residue_disjoint_holds is scoped to exclude this single known, named path rather than silently widening to tolerate any future collision."

data generated_artifact_disposition_derivation_note: String = "derived_hand_maintained_stage0_repo_paths() answers ONE question: which paths must be pub-mod-declared for the crate to link (layout membership, per hand_maintained_stage0_filenames_authority_ref). It does not answer who maintains a path's contents. A layout member's maintenance disposition is DERIVED, never hand-enumerated: gunbc.generated_artifact's generated_artifact_registry is the closed, single authority over every drift-gated artifact this repo produces, and artifact_path is its per-variant path projection — the same projection generated_artifact_emit.dag's artifact_generate dispatch already reads. Any stage0-src path that is a member of that registry (generated_artifact_stage0_src_repo_paths, an identity join by artifact_path, not a filename literal) is EmitFrom the registry's real generation authority, never HandScaffold and never silently excluded by a hand-picked path. v1_interpreter_dispatch_generated.rs (V1InterpreterDispatchGeneratedRsArtifact) is the discriminating case that exposed the conflation; bootstrap_stage0_crate_layout_generated.rs (Stage0CrateLayoutGeneratedRsArtifact) is the second instance the same join surfaces — both derive from the identical registry membership check, no per-file code. derived_hand_maintained_disposition_repo_paths() is the corrected maintenance-disposition population: layout membership minus the generated-artifact-registry overlap. This is the single authority consumed by count_hand_maintained_in_tracked/count_hand_maintained_in_prior_tracked and by gunbc.stage0_rust_honest_frontier_integration's exact_hand_maintained_* joins."

data v1_interpreter_dispatch_generated_repo_path: String = stage0_src_repo_path(
  filename: "v1_interpreter_dispatch_generated.rs"
)

data bootstrap_stage0_crate_layout_generated_repo_path: String = stage0_src_repo_path(
  filename: "bootstrap_stage0_crate_layout_generated.rs"
)

data generated_artifact_emit_authority_ref: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.generated_artifact_emit",
  decl_name: "artifact_generate",
  field: std.decl_ref.WholeDeclaration
}

fn generated_artifact_repo_paths() -> std.types.List<String> {
  v2.std.algebra.list_map(xs: gunbc.generated_artifact.generated_artifact_registry, f: fn(a) { gunbc.generated_artifact.artifact_path(a: a) })
}

fn generated_artifact_stage0_src_repo_paths() -> std.types.List<String> {
  v2.std.algebra.filter(
    xs: generated_artifact_repo_paths(),
    predicate: fn(path) { rust_source_path_has_prefix(path: path, prefix: stage0_src_repo_prefix) }
  )
}

fn generated_artifact_stage0_src_disposition_rows() -> std.types.List<RustSourceLifecycleRow> {
  v2.std.algebra.list_map(
    xs: generated_artifact_stage0_src_repo_paths(),
    f: fn(path) {
      RustSourceLifecycleRow {
        path: path,
        roles: [],
        maintenance_dispositions: [
          EmitFrom { authority: generated_artifact_emit_authority_ref }
        ]
      }
    }
  )
}

fn disposition_authority_rows() -> std.types.List<RustSourceLifecycleRow> {
  v2.std.algebra.fold_list(
    xs: generated_artifact_stage0_src_disposition_rows(),
    empty: rust_source_lifecycle_residue_rows,
    cons: fn(acc, row) { v2.std.algebra.list_snoc_item(xs: acc, item: row) }
  )
}

fn derived_hand_maintained_disposition_repo_paths() -> std.types.List<String> {
  v2.std.algebra.filter(
    xs: derived_hand_maintained_stage0_repo_paths(),
    predicate: fn(path) {
      !path_in_list(path: path, paths: generated_artifact_stage0_src_repo_paths())
    }
  )
}

fn generated_artifact_layout_overlap_repo_paths() -> std.types.List<String> {
  v2.std.algebra.filter(
    xs: derived_hand_maintained_stage0_repo_paths(),
    predicate: fn(path) { path_in_list(path: path, paths: generated_artifact_stage0_src_repo_paths()) }
  )
}

fn generated_artifact_layout_overlap_subset_of_hand_maintained_holds() -> Bool {
  v2.std.algebra.fold_list(
    xs: generated_artifact_layout_overlap_repo_paths(),
    empty: true,
    cons: fn(ok, path) {
      ok && path_in_list(path: path, paths: derived_hand_maintained_stage0_repo_paths())
    }
  )
}

fn generated_artifact_stage0_src_disposition_rows_well_formed() -> Bool {
  v2.std.algebra.fold_list(
    xs: generated_artifact_stage0_src_disposition_rows(),
    empty: true,
    cons: fn(ok, row) { ok && lifecycle_row_well_formed(row: row) }
  )
}

fn generated_artifact_stage0_src_disjoint_from_residue_holds() -> Bool {
  !v2.std.algebra.any(
    xs: generated_artifact_stage0_src_repo_paths(),
    predicate: fn(path) { path_in_list(path: path, paths: residue_lifecycle_repo_paths()) }
  )
}

fn partition_crate_lib_repo_path(crate_dir: String) -> String {
  concat(crate_dir, "/src/lib.rs")
}

fn derived_partition_crate_lib_repo_paths() -> std.types.List<String> {
  v2.std.algebra.list_map(
    xs: v2.workflow.rust_crate_partition.stage0_partition_crate_rows(),
    f: fn(row) { partition_crate_lib_repo_path(crate_dir: row.crate_dir) }
  )
}

fn list_concat_unique(acc: std.types.List<String>, items: std.types.List<String>) -> std.types.List<String> {
  v2.std.algebra.fold_list(
    xs: items,
    empty: acc,
    cons: fn(acc_paths, path) {
      if v2.std.algebra.any(xs: acc_paths, predicate: fn(p) { p == path }) {
        acc_paths
      } else {
        v2.std.algebra.list_snoc_item(xs: acc_paths, item: path)
      }
    }
  )
}

fn rust_source_path_has_prefix(path: String, prefix: String) -> Bool {
  starts_with(s: path, prefix: prefix)
}

fn path_matches_discovery_prefix_hint(path: String) -> Bool {
  v2.std.algebra.any(
    xs: rust_source_discovery_prefix_hints,
    predicate: fn(prefix) { rust_source_path_has_prefix(path: path, prefix: prefix) }
  )
}

