data residue_cssl_assembly_dissolution: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on: cssl_seed_linked_closure_assembly.rs leaves hand_maintained_stage0_filenames() -- i.e. compile_stage0() emits it, so the derived generated population claims it -- or a typed emit producer row deletes the hand file")

data residue_module_path_index_reason: String = "hand_maintained_stage0_dirs lists module_path_index/ but file membership is not enumerated by any join authority yet"

data residue_module_path_index_dissolution: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on: module_path_index/*.rs paths derive from hand_maintained_stage0_dirs + host census, or the directory dissolves into generated emit")

data residue_stage0_core_lib_reason: String = "src/v1/stage0_core/src/lib.rs exists on disk but is absent from stage0_partition_crate_rows — authority contradiction surfaced for operator resolution"

data residue_stage0_core_lib_dissolution: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on: stage0_partition_crate_rows enrolls src/v1/stage0_core OR the crate deletes")

fn residue_row(path: String, reason: String, dissolution: std.dissolution.DissolutionCondition) -> RustSourceLifecycleRow {
  RustSourceLifecycleRow {
    path: path,
    roles: [],
    maintenance_dispositions: [
      HandScaffold { reason: reason as std.types.NonEmptyStr, dissolution: dissolution }
    ]
  }
}

data rust_source_lifecycle_residue_rows: std.types.List<RustSourceLifecycleRow> = [
  residue_row(
    path: "src/v1/stage0/src/cssl_seed_linked_closure_assembly.rs",
    reason: residue_cssl_assembly_reason,
    dissolution: residue_cssl_assembly_dissolution
  ),
  residue_row(
    path: "src/v1/stage0/src/module_path_index/mod.rs",
    reason: residue_module_path_index_reason,
    dissolution: residue_module_path_index_dissolution
  ),
  residue_row(
    path: "src/v1/stage0/src/module_path_index/index.rs",
    reason: residue_module_path_index_reason,
    dissolution: residue_module_path_index_dissolution
  ),
  residue_row(
    path: "src/v1/stage0/src/module_path_index/parsed_dag_file.rs",
    reason: residue_module_path_index_reason,
    dissolution: residue_module_path_index_dissolution
  ),
  residue_row(
    path: "src/v1/stage0_core/src/lib.rs",
    reason: residue_stage0_core_lib_reason,
    dissolution: residue_stage0_core_lib_dissolution
  )
]

fn residue_lifecycle_repo_paths() -> std.types.List<String> {
  v2.std.algebra.list_map(xs: rust_source_lifecycle_residue_rows, f: fn(row) { row.path })
}

// The classified population that does NOT come from the observed tree: every path some
// authority names outright. `derived_generated_stage0_repo_paths` is defined as the observed
// stage0 direct children this list does not claim, so the two are disjoint by construction --
// which is why `derived_generated_hand_disjoint_holds`, the check that used to assert exactly
// that over two hand rosters, is deleted rather than kept green (DESIGN 4b: a climb dissolves
// the production machinery it obsoletes).
fn non_generated_classified_repo_paths() -> std.types.List<String> {
  let with_residue = list_concat_unique(
    acc: derived_hand_maintained_stage0_repo_paths(),
    items: residue_lifecycle_repo_paths()
  )
  list_concat_unique(acc: with_residue, items: generated_artifact_stage0_src_repo_paths())
}

fn file_grain_lifecycle_repo_paths(
  emitted_stage0_repo_paths: List<String>,
  tracked_paths: List<String>
) -> List<String> {
  list_concat_unique(
    acc: non_generated_classified_repo_paths(),
    items: derived_generated_stage0_repo_paths(
      emitted_stage0_repo_paths: emitted_stage0_repo_paths,
      tracked_paths: tracked_paths
    )
  )
}

// FIXTURE GENERATED PATHS ARE SYNTHETIC AND DELIBERATELY SO. The generated population is now
// a function of the tracked list, so a fixture that derived its tracked list from the
// classified population would be circular -- it would observe only what it already named and
// could never exercise the filter. These two names are not real files; they exercise the
// derivation (direct-child .rs under the stage0 root, claimed by no authority) without
// coupling the witnesses to whichever real modules happen to be emitted today.
data witness_generated_stage0_fixture_paths: std.types.List<String> = [
  stage0_src_repo_path(filename: "witness_generated_fixture_a.rs"),
  stage0_src_repo_path(filename: "witness_generated_fixture_b.rs")
]

fn witness_fixture_tracked_paths() -> std.types.List<String> {
  list_concat_unique(
    acc: non_generated_classified_repo_paths(),
    items: witness_generated_stage0_fixture_paths
  )
}

fn witness_observation_covering_lifecycle_plus_extra(extra_path: String) -> gunbc.stage0_rust_host_observation.RustSourceHostObservation {
  let classified = witness_fixture_tracked_paths()
  gunbc.stage0_rust_host_observation.RustManifestObserved {
    repository_revision: "witness-deadbeef",
    manifest_content_identity: std.content_hash.Fnv1a64Structural { digest: "abc1230000000000" },
    tracked_rust_repo_paths: list_concat_unique(acc: classified, items: [extra_path]),
    prior_tracked_rust_repo_paths: classified,
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"],
    emit_population_evidence: EmitPopulationConfirmed {
      emitted_stage0_repo_paths: witness_generated_stage0_fixture_paths
    }
  }
}

fn witness_hand_maintained_growth_observation() -> gunbc.stage0_rust_host_observation.RustSourceHostObservation {
  let prior_file_grain = list_concat_unique(
    acc: witness_generated_stage0_fixture_paths,
    items: residue_lifecycle_repo_paths()
  )
  let classified = witness_fixture_tracked_paths()
  let prior_classified = prior_file_grain
  gunbc.stage0_rust_host_observation.RustManifestObserved {
    repository_revision: "witness-deadbeef",
    manifest_content_identity: std.content_hash.Fnv1a64Structural { digest: "abc1230000000000" },
    tracked_rust_repo_paths: classified,
    prior_tracked_rust_repo_paths: prior_classified,
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"],
    emit_population_evidence: EmitPopulationConfirmed {
      emitted_stage0_repo_paths: witness_generated_stage0_fixture_paths
    }
  }
}

fn witness_honest_minimal_observation_ok() -> gunbc.stage0_rust_host_observation.RustSourceHostObservation {
  let classified = witness_fixture_tracked_paths()
  gunbc.stage0_rust_host_observation.RustManifestObserved {
    repository_revision: "witness-deadbeef",
    manifest_content_identity: std.content_hash.Fnv1a64Structural { digest: "abc1230000000000" },
    tracked_rust_repo_paths: classified,
    prior_tracked_rust_repo_paths: classified,
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"],
    emit_population_evidence: EmitPopulationConfirmed {
      emitted_stage0_repo_paths: witness_generated_stage0_fixture_paths
    }
  }
}

// The standing-unclassified fixture, and the reason it is authored separately from the
// sibling constructors above rather than being one more `extra_path` argument to them.
//
// count_newly_unclassified_tracked is checked BEFORE count_tracked_unclassified in the verdict
// fold, and it is the narrower predicate: a tracked path that is unclassified AND absent from
// prior_tracked. So every constructor that adds its extra path to tracked alone lands on
// DerivedNewlyUnclassified and can never reach the arm below it. That is not a second way of
// exercising the same axis -- it is the reason DerivedUnclassifiedTracked had no discriminating
// input at all, while a witness NAMED for the unclassified axis asserted the newly arm and
// passed. This constructor puts the planted path in BOTH tracked and prior_tracked, which is the
// only shape that reaches the standing arm, and it is what makes the two arms distinguishable by
// execution rather than by reading the fold.
//
// Controlled fixture, not a tree-copied pin: the input population and the expected population are
// authored independently here (one planted path in, exactly one counted out), so automating the
// expected value would not collapse the assertion to measure() == measure().
fn witness_standing_unclassified_observation(planted_path: String) -> gunbc.stage0_rust_host_observation.RustSourceHostObservation {
  let classified = witness_fixture_tracked_paths()
  let tracked = list_concat_unique(acc: classified, items: [planted_path])
  gunbc.stage0_rust_host_observation.RustManifestObserved {
    repository_revision: "witness-deadbeef",
    manifest_content_identity: std.content_hash.Fnv1a64Structural { digest: "abc1230000000000" },
    tracked_rust_repo_paths: tracked,
    prior_tracked_rust_repo_paths: tracked,
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"],
    emit_population_evidence: EmitPopulationConfirmed {
      emitted_stage0_repo_paths: witness_generated_stage0_fixture_paths
    }
  }
}

fn first_classified_repo_path(classified: std.types.List<String>) -> String {
  v2.std.algebra.fold_list(
    xs: classified,
    empty: "",
    cons: fn(first, path) {
      if first == "" {
        path
      } else {
        first
      }
    }
  )
}

fn witness_duplicate_tracked_observation() -> gunbc.stage0_rust_host_observation.RustSourceHostObservation {
  let classified = witness_fixture_tracked_paths()
  let dup_path = first_classified_repo_path(classified: classified)
  let tracked_with_dup = v2.std.algebra.list_snoc_item(xs: classified, item: dup_path)
  gunbc.stage0_rust_host_observation.RustManifestObserved {
    repository_revision: "witness-deadbeef",
    manifest_content_identity: std.content_hash.Fnv1a64Structural { digest: "abc1230000000000" },
    tracked_rust_repo_paths: tracked_with_dup,
    prior_tracked_rust_repo_paths: classified,
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"],
    emit_population_evidence: EmitPopulationConfirmed {
      emitted_stage0_repo_paths: witness_generated_stage0_fixture_paths
    }
  }
}

fn declaration_ref_populated(ref: std.decl_ref.DeclarationRef) -> Bool {
  !(ref.module_path == "") && !(ref.decl_name == "")
}

fn rust_maintenance_disposition_well_formed(disposition: RustMaintenanceDisposition) -> Bool {
  match disposition {
    Generated { authority: ref } => declaration_ref_populated(ref: ref)
    EmitFrom { authority: ref } => declaration_ref_populated(ref: ref)
    DeleteWith { roadmap_node: node } => !((node as String) == "")
    RetainedKernel { reason: reason } => !(reason == "")
    HandScaffold { reason: reason, dissolution: d } =>
      !((reason as String) == "") && !(std.dissolution.dissolution_description(condition: d) == "")
  }
}

data lifecycle_row_well_formed_query_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.stage0_rust_source_lifecycle_scaffold",
    decl_name: "lifecycle_row_well_formed",
    field: std.decl_ref.WholeDeclaration
  }
}

data lifecycle_row_well_formed_query_dissolve_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: lifecycle_row_well_formed — interim scaffold obligation-shape validator; DISSOLVES WHEN V1FinishLine ZeroHandMaintainedRust acceptance graph subsumes row well-formedness (authority dag/gunbc/v1_deletion_plan.dag)")

fn lifecycle_row_well_formed(row: RustSourceLifecycleRow) -> Bool {
  !(row.path == "")
    && v2.std.algebra.length(xs: row.maintenance_dispositions) > 0
    && v2.std.algebra.fold_list(
      xs: row.maintenance_dispositions,
      empty: true,
      cons: fn(ok, disposition) {
        ok && rust_maintenance_disposition_well_formed(disposition: disposition)
      }
    )
}

fn rust_source_lifecycle_residue_rows_well_formed() -> Bool {
  v2.std.algebra.fold_list(
    xs: rust_source_lifecycle_residue_rows,
    empty: true,
    cons: fn(ok, row) { ok && lifecycle_row_well_formed(row: row) }
  )
}

fn list_paths_all_unique(paths: std.types.List<String>) -> Bool {
  v2.std.algebra.fold_list(
    xs: paths,
    empty: true,
    cons: fn(ok, path) { ok && std.keyed_roster.path_occurrence_count(paths: paths, target: path) == 1 }
  )
}

fn rust_source_lifecycle_residue_paths_unique() -> Bool {
  list_paths_all_unique(paths: residue_lifecycle_repo_paths())
}

// Both checks range over `non_generated_classified_repo_paths()` rather than the whole
// lifecycle population, because the derived half can no longer violate either: every member
// comes from one filter over the observed tracked list, so it is unique if the observation is
// (the observation's own duplicates are reported by `count_observed_manifest_duplicate_excess`,
// which is where that defect belongs) and it is under `stage0_src_repo_prefix` by the filter
// itself, which no discovery-prefix hint matches.
fn duplicate_exact_paths_zero_holds() -> Bool {
  list_paths_all_unique(paths: non_generated_classified_repo_paths())
}

fn partition_crate_paths_complete_holds() -> Bool {
  v2.std.algebra.length(xs: derived_partition_crate_lib_repo_paths()) == v2.std.algebra.length(xs: v2.workflow.rust_crate_partition.stage0_partition_crate_rows())
}

data cssl_seed_linked_closure_assembly_repo_path: String = stage0_src_repo_path(
  filename: "cssl_seed_linked_closure_assembly.rs"
)

fn residue_hand_maintained_overlap_repo_paths() -> std.types.List<String> {
  v2.std.algebra.filter(
    xs: residue_lifecycle_repo_paths(),
    predicate: fn(residue_path) {
      v2.std.algebra.any(
        xs: derived_hand_maintained_stage0_repo_paths(),
        predicate: fn(derived_path) { derived_path == residue_path }
      )
    }
  )
}

fn classified_residue_disjoint_holds() -> Bool {
  residue_hand_maintained_overlap_repo_paths() == [cssl_seed_linked_closure_assembly_repo_path]
}

fn file_grain_paths_avoid_discovery_prefix_holds() -> Bool {
  !v2.std.algebra.any(
    xs: non_generated_classified_repo_paths(),
    predicate: fn(file_path) { path_matches_discovery_prefix_hint(path: file_path) }
  )
}

fn manifest_state_verdict_scaffold_holds() -> Bool {
  match rust_source_manifest_state_verdict(observation: gunbc.stage0_rust_host_observation.current_stage0_rust_source_observation()) {
    ManifestStateScaffoldOk => true
    ManifestStateScaffoldRefused { cause: _ } => false
  }
}

fn stage0_rust_lifecycle_scaffold_join_mechanical_checks_holds() -> Bool {
  partition_crate_paths_complete_holds()
    && classified_residue_disjoint_holds()
    && file_grain_paths_avoid_discovery_prefix_holds()
    && duplicate_exact_paths_zero_holds()
    && rust_source_lifecycle_residue_rows_well_formed()
    && rust_source_lifecycle_residue_paths_unique()
    && generated_artifact_layout_overlap_subset_of_hand_maintained_holds()
    && generated_artifact_stage0_src_disposition_rows_well_formed()
    && generated_artifact_stage0_src_disjoint_from_residue_holds()
    && gunbc.seed_growth_admission.seed_growth_roster_well_formed_gate_holds()
}

fn stage0_rust_lifecycle_scaffold_mechanical_checks_holds() -> Bool {
  stage0_rust_lifecycle_scaffold_join_mechanical_checks_holds()
    && manifest_state_verdict_scaffold_holds()
}

data unclassified_axis_rung_note: String = "RUNG DROP, DECLARED (2026-08-20). SUBJECT: the unclassified axis -- count_tracked_unclassified here, and unclassified_paths in gunbc.stage0_rust_lifecycle_totality, which answer the same question over the same two authorities. DECLARED RUNG: mitigatable. It is NOT mechanically preventable, and it was reported as though it were by carriers that derive the axis correctly while nothing executing can make it fire.\n\nMEASURED AT 026a709a71636d60df325f9183b78febff22901d, by execution, both directions. LIVE: current_stage0_rust_source_observation() through lifecycle_totality_receipt gives tracked=270, generated=126, disposition=7, stale=0, UNCLASSIFIED=137, paths enumerated. HERMETIC: the same predicate over lifecycle_totality_witness_observation(extra_paths: []) gives ZERO. The predicate is not wrong; the subject is. That constructor sets tracked := classified ++ extra_paths, so unclassified_paths is IDENTICALLY extra_paths -- confirmed by planting a path that does not exist on disk and getting back exactly it. A hermetic witness of this carrier can only discover what its author already typed into the call.\n\nTHE LIVE ARM DOES NOT RESCUE IT, FOR TWO REASONS THAT ARE INDEPENDENT OF EACH OTHER. First, it executes nowhere: both files reaching it declare ReadsLiveTree, which the required floor declines, and their exclusion rows name bin_witness_wet_entries as their real executing consumer -- a roster of 94 rows across 38 entry files whose consumer, the ci.yml wet job, was deleted at 611fd02770. Second, and worse, the live witnesses would not detect the frontier even when run: measured under claim_batch --wet at this ref, all three PASS at 137 unclassified. One accepted DerivedUnclassifiedTracked with a positive count OR CargoTargetMissingLifecycleDisposition OR ManifestStateScaffoldOk -- three mutually contradictory states, so it was green at 137 and would have been green at 0. The other asserted only that two Bools are false, which any refusal satisfies, including a git outage. Both disjunctions are repaired in this change; that repair removes a fabricated green and does NOT change the rung, because the witnesses still execute nowhere.\n\nWHAT THIS CHANGE ACTUALLY BUYS, stated narrowly so it is not mistaken for the climb: DerivedUnclassifiedTracked now has a discriminating RED that runs on the required floor. It had none. count_newly_unclassified_tracked is checked first and is the narrower predicate, so every pre-existing constructor reached the newly arm and the standing arm was unreachable by any executing input -- including from a witness named for the unclassified axis that asserted the newly arm and passed. That is one arm of one carrier made falsifiable. The AXIS is still measured over a manufactured subject.\n\nCEILING AND WHY: mechanically preventable is not the ceiling and structural impossibility is. Classification is decidable and fully modeled -- a tracked path either is or is not a member of two closed authorities -- so the reachable end state is that an unclassified file cannot be WRITTEN, not that a check finds it. That is section 4b's construction rung and it is a property of the file, not of two lists that can both omit it.\n\nNEXT-RUNG TRIGGER, and it is deliberately not a wall: an executing consumer for the live observation. Not a restored wet lane by itself -- ReadsLiveTree declines these files from the floor independently, so a wet lane alone leaves them off. Until some executing path reaches the real tracked population, a construction wall over the live arm would be a SECOND unexecuted artifact sitting at exactly this rung while looking like a climb, which is the rung inflation 4b names as worse than sitting low. The 137 is a decision about what this repository intends to classify and is routed to the operator as a discovery rather than landed as a refusal.\n\nRESTORATION: this row is rewritten as an ordinary description -- not amended -- when the axis has an executing consumer over the live population, at which point the honest rung can be re-measured instead of re-argued."

data unclassified_axis_rung_restoration: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on: the unclassified axis acquires an executing consumer over the LIVE tracked population (not a manufactured observation), at which point unclassified_axis_rung_note is rewritten in one pass and this row deletes with it")

data rust_source_lifecycle_partition_contradiction_note: String = "OPEN: src/v1/stage0_core/src/lib.rs is tracked on disk but stage0_partition_crate_rows has no src/v1/stage0_core row. Residue row surfaces the contradiction; operator resolves via partition row or crate deletion."
