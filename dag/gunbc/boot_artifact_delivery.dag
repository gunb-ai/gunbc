  RedfishVirtualMediaProbe,
  RedfishVirtualMediaProbeReceipt,
  RedfishVirtualMediaTransferProtocol,
  ResourceReadable,
  TransferProtocolAdmitted,
  redfish_transfer_protocol_in,
}
import extdeps.bmc.access_profile {
  BmcAccessProfileProvenance,
  BmcAccessSurface,
  SurfaceAbsentFromLiveObservation,
  SurfaceAbsentFromProfile,
  SurfaceEligible,
  SurfaceOemNbdWebsocket,
  SurfaceOemRestRemoteMedia,
  SurfaceProfileObservationIdentityMismatch,
  SurfaceRedfishVirtualMedia,
  bmc_profile_megarac_image_redirection,
  bmc_profile_nbd_websocket_path,
  bmc_surface_eligibility,
}
import gunbc.machine_intake_access {
  AccessContextBound,
  AccessContextCatalogRefused,
  AccessContextObservationEvidenceMismatch,
  AccessContextObservationForOtherAttempt,
  AccessContextProfileAmbiguous,
  AccessContextProfileLookupNotRun,
  AccessContextProfileUncatalogued,
  AccessContextUnobserved,
  BoundBmcAccessContext,
  BoundBmcAccessContextStanding,
}
