// A2 in-run key materialization (parent msg_72e2dcee): foreign-executor shell that
// exchanges nothing itself — the WIF access token arrives from the google_auth_action
// step via env — and turns Secret Manager versions/1 (PINNED, never `latest`) into a
// loaded ssh-agent identity. SECRET HYGIENE, load-bearing: the payload flows
// curl -> python3 decode -> file mode 0600 -> ssh-add -> rm; it is never echoed, never
// written under a durable HOME, and no digest of it is printed. The only stdout is the
// identity NAME line. The agent socket/pid go to GITHUB_ENV so the probe step's ssh
// children inherit them; the job's always() cleanup step kills the agent.
data gunbc_ci_fleet_key_agent_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "gunbc_ci_fleet_key_agent_script",
    field: WholeDeclaration
  }
}

data gunbc_ci_fleet_key_agent_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: gunbc_ci_fleet_key_agent_script — concat-built foreign-executor (GitHub Actions run:) shell materializing the fleet automation key from Secret Manager versions/1 into an in-run ssh-agent; DISSOLVES WHEN the typed secret-materialization effect (SecretRef -> in-run agent, SECRET-VERSION-LIFECYCLE-0 machinery) lands on host_effect_apply and the step becomes an emitted typed effect")

// Repairs #3 and #4 (operator scan of #8083, 2026-08-09):
// #3 FAILURE-SAFE CLEANUP — a `trap cleanup EXIT` is armed BEFORE the key touches disk,
//    so any failure in curl/base64/chmod/keygen/agent/add removes the key file and kills
//    the agent regardless of where set -e aborts. The outer always() step stays as
//    defense in depth. The old ordering (rm only on the happy path, PID exported last)
//    could leave the key on disk with no exported PID for the outer cleanup to find.
// #4 SECRET-IDENTITY VERIFICATION — before ssh-add, derive the public key from the fetched
//    private material (ssh-keygen -y) and its fingerprint (ssh-keygen -lf) and compare to
//    the modeled fleet_automation_ssh_key_fingerprint. A wrong secret VERSION is then a
//    located ProbeCredentialIdentityMismatch that CONTACTS NO HOST, never a downstream
//    host-auth failure. The comparison is against the repo's single fingerprint authority.
fn gunbc_ci_fleet_key_agent_script() -> String {
  join([
    "# ", dissolution_description(condition: gunbc_ci_fleet_key_agent_shell_emit_dissolution_trigger), "\n",
    "set -euo pipefail\n",
    "umask 077\n",
    "KEY_FILE=\"$RUNNER_TEMP/fleet-automation-key\"\n",
    "AGENT_STARTED=0\n",
    "cleanup() { rm -f \"$KEY_FILE\"; if [ \"$AGENT_STARTED\" = 1 ] && [ -n \"$\{SSH_AGENT_PID:-}\" ]; then ssh-agent -k >/dev/null 2>&1 || true; fi; }\n",
    "trap cleanup EXIT\n",
    "curl -sSf -H \"Authorization: Bearer $WIF_ACCESS_TOKEN\" \"", fleet_automation_privkey_sm_access_url(), "\" | python3 -c 'import sys,json,base64; sys.stdout.buffer.write(base64.b64decode(json.load(sys.stdin)[\"payload\"][\"data\"]))' > \"$KEY_FILE\"\n",
    "chmod 600 \"$KEY_FILE\"\n",
    "EXPECTED_FP=\"", fleet_automation_ssh_key_fingerprint, "\"\n",
    "OBSERVED_FP=\"$(ssh-keygen -y -f \"$KEY_FILE\" | ssh-keygen -lf - | awk '\{print $2}')\"\n",
    "if [ \"$OBSERVED_FP\" != \"$EXPECTED_FP\" ]; then echo \"ProbeCredentialIdentityMismatch: fetched secret ", fleet_automation_privkey_version_segment(), " fingerprint $OBSERVED_FP != modeled $EXPECTED_FP; contacting NO host\" >&2; exit 1; fi\n",
    "eval \"$(ssh-agent -s)\" >/dev/null\n",
    "AGENT_STARTED=1\n",
    "ssh-add \"$KEY_FILE\" 2>/dev/null\n",
    "rm -f \"$KEY_FILE\"\n",
    "trap - EXIT\n",
    "echo \"SSH_AUTH_SOCK=$SSH_AUTH_SOCK\" >> \"$GITHUB_ENV\"\n",
    "echo \"SSH_AGENT_PID=$SSH_AGENT_PID\" >> \"$GITHUB_ENV\"\n",
    "echo \"fleet-key: agent loaded (identity fleet-automation@gunbc; secret versions/1 pinned; fingerprint verified against modeled authority; key file wiped)\"\n",
  ], "")
}

// A3 in-run administrator-credential materialization, the same lifecycle as the fleet key one step
// above and deliberately not a variation on it: WIF token from the google_auth_action step by env,
// one PINNED secret version, a 0600 file under RUNNER_TEMP, and a trap armed BEFORE the credential
// touches disk so any failure removes it regardless of where set -e aborts.
//
// WHAT GOES TO GITHUB_ENV IS THE PATH, NEVER THE CREDENTIAL. An environment variable holding the
// password would be readable by every child process the job spawns and printed by any diagnostic
// that dumps the environment — and this repository's own receipts print argv. A path discloses
// nothing to anyone who cannot already read the file.
//
// The URL is derived from the modeled SecretRef rather than spelled, so this step and the lease that
// authorizes it cannot name different versions. There is no fingerprint check as there is for the
// key: a password has no derivable public half to compare against, so the identity evidence is
// sudo's own accept-or-reject, which the privileged step classifies as its own outcome.
//
// THE HTTP STATUS IS CLASSIFIED, NOT COLLAPSED, and the first cut of this step got that wrong in a
// way that cost a run to discover. It piped `curl -sSf` straight into a decoder and checked the file
// size afterwards, so a 403 surfaced as a JSON decode traceback followed by "produced no payload" --
// a sentence true of the file and false about the world. Unreadable and enrolled-but-blank have
// different remedies, and neither is discoverable from an empty file.
//
// A 403 DOES NOT ESTABLISH THAT THE SECRET EXISTS, and the second cut of this step claimed it did:
// "an access grant and not a missing secret". Secret Manager answers 403 both for a version that
// exists and is not readable and for one that does not exist -- it hides existence from principals
// who may not read it. gunbc.spark.bootstrap_provision already records exactly this ambiguity about
// exactly this API, having been burned by reading an empty testIamPermissions response as proof of
// denial rather than of nothing. So the refusal states the ambiguity and gives the remedy that
// covers both arms, rather than picking the arm that happens to fit the current guess.
data gunbc_ci_spark_admin_credential_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "gunbc_ci_spark_admin_credential_script",
    field: WholeDeclaration
  }
}

data gunbc_ci_spark_admin_credential_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: gunbc_ci_spark_admin_credential_script — concat-built foreign-executor (GitHub Actions run:) shell materializing the spark administrator password from its modeled Secret Manager version into a 0600 RUNNER_TEMP file whose PATH (never the credential) is exported; DISSOLVES WHEN a job-scoped secret-materialization lifetime (SecretRef -> run-local file that PERSISTS across GitHub Actions steps, with explicit cleanup) is modeled on the CI-emission layer -- the root v2.workflow.gunbc_invoke_step_emit gunbc_run_step_script already dissolved four sibling markers through -- and this step becomes an emitted typed effect. THIS TRIGGER WAS REWRITTEN 2026-08-21 BECAUSE ITS FIRST FORM COULD NEVER FIRE, and the correction is recorded rather than silently swapped because an unfalsifiable trigger is worse than no trigger: it reads as tracked debt while being unreachable. It named host_effect_apply, whose HostEffectIntent.target is a NodeControlPlane, whose only two arms both require a ComputeHost -- a full hardware description in gunbc.fleet_intent (baseboard, processors, memory devices, storage, network interfaces). An ephemeral GitHub runner is not one, and gunbc.ci_deploy_target_host already refuses exactly this conflation (runner identity does not prove target host). It also cited SECRET-VERSION-LIFECYCLE-0, which models secret ROTATION -- how a secret's value is replaced -- and never answers how a running step consumes a secret already at rest. Both errors have the same origin: reaching for the nearest carrier whose NAME matched, without checking that its subject did. The real foundation is gunbc.auth.materialized_secret, whose SshKeyFile leg is landed and correctly scoped to fleet transports authenticating to real ComputeHosts; its own Scaffold row is falsifiable BECAUSE its population fits that surface. This step is the other population -- a runner materializing a secret for its own local use, authenticating to no host -- and the lifetime it needs is not the landed materialize/use/shred bracket, which is synchronous and single-call, but one that survives the step boundary by design")

fn gunbc_ci_spark_admin_credential_script() -> String {
  join([
    "# ", dissolution_description(condition: gunbc_ci_spark_admin_credential_shell_emit_dissolution_trigger), "\n",
    "set -euo pipefail\n",
    "umask 077\n",
    "CRED_FILE=\"$RUNNER_TEMP/spark-administrator-credential\"\n",
    "cleanup() { rm -f \"$CRED_FILE\" \"$RUNNER_TEMP/spark-administrator-response.json\"; }\n",
    "trap cleanup EXIT\n",
    "RESP_FILE=\"$RUNNER_TEMP/spark-administrator-response.json\"\n",
    "HTTP_CODE=\"$(curl -sS -o \"$RESP_FILE\" -w '%\{http_code}' -H \"Authorization: Bearer $WIF_ACCESS_TOKEN\" \"", secret_ref_access_url(ref: spark_administrator_password_secret_ref), "\" || echo 000)\"\n",
    "if [ \"$HTTP_CODE\" = 403 ]; then echo \"SparkAdministratorCredentialUnreadable: ", secret_ref_version_resource(ref: spark_administrator_password_secret_ref), " answered 403 to ", spark_bootstrap_cloud_principal_member(), ". Secret Manager returns 403 both when a version exists and is not readable AND when it does not exist, so this run cannot tell those apart -- REMEDY EITHER WAY: confirm the version exists and grant that principal roles/secretmanager.secretAccessor on it. Contacting NO host.\" >&2; exit 1; fi\n",
    "if [ \"$HTTP_CODE\" = 404 ]; then echo \"SparkAdministratorCredentialAbsent: ", secret_ref_version_resource(ref: spark_administrator_password_secret_ref), " answered 404; the modeled reference names a version Secret Manager does not hold. Contacting NO host.\" >&2; exit 1; fi\n",
    "if [ \"$HTTP_CODE\" != 200 ]; then echo \"SparkAdministratorCredentialFetchFailed: HTTP $HTTP_CODE from ", secret_ref_version_resource(ref: spark_administrator_password_secret_ref), "; contacting NO host.\" >&2; exit 1; fi\n",
    "python3 -c 'import sys,json,base64; sys.stdout.buffer.write(base64.b64decode(json.load(open(sys.argv[1]))[\"payload\"][\"data\"]))' \"$RESP_FILE\" > \"$CRED_FILE\"\n",
    "rm -f \"$RESP_FILE\"\n",
    "chmod 600 \"$CRED_FILE\"\n",
    "if [ ! -s \"$CRED_FILE\" ]; then echo \"SparkAdministratorCredentialEmpty: ", secret_ref_version_resource(ref: spark_administrator_password_secret_ref), " returned 200 with an empty payload, which is an enrolled-but-blank secret and never a blank password; contacting NO host\" >&2; exit 1; fi\n",
    "trap - EXIT\n",
    "echo \"", spark_grant_credential_path_env as String, "=$CRED_FILE\" >> \"$GITHUB_ENV\"\n",
    "echo \"spark-admin-credential: materialized from ", secret_ref_version_resource(ref: spark_administrator_password_secret_ref), " to a 0600 run-local file; the PATH is exported, the credential is not\"\n",
  ], "")
}

// The credential teardown, a FRESH per-job effect for the same reason the agent teardown is: each
// isolated job materializes and must remove its own file. Named so the workflow step and any
// fresh-effect list reference ONE authority rather than an inline literal duplicated per job.
fn gunbc_ci_spark_admin_credential_cleanup_script() -> String {
  join([
    "if [ -n \"$\{", spark_grant_credential_path_env as String, ":-}\" ]; then rm -f \"$\{",
    spark_grant_credential_path_env as String, "}\" || true; fi\n",
  ], "")
}

// The in-run ssh-agent teardown — a FRESH per-job effect (each isolated job starts and
// must kill its own agent; nothing is memoizable across jobs), named so both the workflow
// step and the materialization gate's fresh-effect list reference ONE authority (§3),
// rather than an inline literal duplicated per job that the ladder would read as authored
// cross-job duplication.
fn gunbc_ci_fleet_key_agent_cleanup_script() -> String {
  "if [ -n \"$\{SSH_AGENT_PID:-}\" ]; then ssh-agent -k || true; fi\n"
}

