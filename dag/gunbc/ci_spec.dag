}
import extdeps.github.actions { RunnerSpec }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type DiffMode = DiffMergeBase | DiffTwoDot

type DiffPolicy {
  base: String
  head: String
  mode: DiffMode
}

type DeployStage {
  id: String
  step_name: String
  entry: String
  function: String
  needs: List<String>
  access: DeployAccess
  runner: RunnerSpec
}

data ci_spec_witness_entries_note: String = "witness_entries is the opt-in CI witness roster (operator inversion 2026-07-04): the floor runs exactly these declared witnesses, never a tree scan; empty means the plan carries no witness-corpus node at all. Enrollment authority: gunbc.commit_workflow.commit_gate_roster CommitWitnessClaim rows on the GithubActionsCiJob surface (see ci_witness_optin_inversion there)."

type CiSpec {
  gates: List<Gate>
  witness_entries: List<ScheduleWitnessEntry>
  diff_policy: DiffPolicy
  notice_title: String
  deploy_stages: List<DeployStage>
}

data gunbc_ci_floor_gates: List<Gate> = project_ci_floor_gates(roster: commit_gate_roster)

data gunbc_ci_regen_floor_gates: List<Gate> = project_ci_regen_job_gates(roster: commit_gate_roster)

data gunbc_ci_two_job_split_note: String = "Two-job split (operator ruling 2026-07-07, #6350): the self-host fixed-point class — RegenVerifyGate + SelfHostStalenessGate — is a §7 ASPIRATION, not a current invariant (the committed seed is knowingly hand-maintained ahead of its .dag), so enforcing byte-identical self-host as a HARD required gate keeps main red-by-construction on unfinished aspiration. project_ci_floor_gates (GithubActionsCiJob surface) is the REQUIRED green job — every grounded invariant, must go green. project_ci_regen_job_gates (GithubActionsCiRegenJob surface) is the NON-required regen job — honest-red until the seed<->.dag reconcile lands. The green job is kept §5-honest against escape-hatch (debt growing silently behind the non-required red door) by the regen_divergence ratchet: a REQUIRED monotone-shrink guard (divergence count may only decrease, baseline drift-checked against origin/main so a baseline-raise is unwritable) that AUTO-PROMOTES the class back to hard when the count reaches 0 (bound to the byte-diff==0 oracle, no manual flip). SelfHostReadsRealBytesGate (provenance, measured-holding) stays on the required green surface."

data gunbc_ci_floor_witness_entries: List<ScheduleWitnessEntry> = project_ci_floor_witness_entries(roster: commit_gate_roster)

data gunbc_ci_rust_job_gates: List<Gate> = project_ci_rust_job_gates(roster: commit_gate_roster)

data gunbc_ci_gates: List<Gate> = concat(gunbc_ci_floor_gates, gunbc_ci_rust_job_gates)

data live_deploy_apply_entry: String = "dag/gunbc/live_deploy/apply.dag"
data live_deploy_apply_srv1_wet_function: String = "live_deploy_apply_srv1_wet"

data gunbc_ci_deploy_srv1_stage: DeployStage = {
  id: "deploy_dashboard_srv1",
  step_name: "Deploy dashboard to srv1 (live_deploy_apply_srv1_wet)",
  entry: live_deploy_apply_entry,
  function: live_deploy_apply_srv1_wet_function,
  needs: ["ci"],
  access: ci_deploy_srv1_access,
  runner: gunbc_ci_deploy_srv1_runner_spec(),
}

data gunbc_ci_deploy_stages: List<DeployStage> = [gunbc_ci_deploy_srv1_stage]

data gunbc_ci_spec: CiSpec = {
  gates: gunbc_ci_floor_gates,
  witness_entries: gunbc_ci_floor_witness_entries,
  diff_policy: {
    base: "origin/main",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "v2 claim corpus",
  deploy_stages: gunbc_ci_deploy_stages,
}

data gunbc_ci_regen_spec: CiSpec = {
  gates: gunbc_ci_regen_floor_gates,
  witness_entries: [],
  diff_policy: {
    base: "origin/main",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "self-host fixed-point (regen + staleness) — non-required",
  deploy_stages: [],
}

fn ci_spec_with_witness_entries(spec: CiSpec, entries: List<ScheduleWitnessEntry>) -> CiSpec {
  CiSpec {
    gates: spec.gates,
    witness_entries: entries,
    diff_policy: spec.diff_policy,
    notice_title: spec.notice_title,
    deploy_stages: spec.deploy_stages,
  }
}

data ci_release_features: String = "text_lookup_work_counter"

fn ci_repo_root_shell() -> String {
  "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
}

data ci_release_build_regen_stage0_note: String = "regen_stage0 is built here (unconditionally, via cargo) alongside claim_executor/gunbc — NOT lazily via ensure_regen_stage0_built's build-if-absent. On the self-hosted runners target/release/ persists across jobs, so build-if-absent would run a STALE regen_stage0 from a prior commit; the ci_regen_ratchet job then reads no regen_divergence_count contract from that stale binary and fails the no-count refusal. cargo build is source-change-aware, so listing --bin regen_stage0 here guarantees a fresh binary that emits the count (receipt: ci_regen_ratchet job 85537100872, run 28841755357 @ 7927413 — stale-binary no-count refusal)."

fn ci_release_build_line() -> String {
  concat(
    concat(
      "\"$CARGO_HOME/bin/cargo\" build -p v1-compiler --release --features ",
      ci_release_features
    ),
    " --bin claim_executor --bin gunbc --bin regen_stage0"
  )
}

fn ci_cargo_eagain_retry_core(command: String) -> String {
  concat(
    concat(
      concat("BUILD_LOG=$(mktemp)\n", "if ! ("),
      concat(command, ") 2>&1 | tee \"$BUILD_LOG\"; then\n")
    ),
    concat(
      concat(
        concat(
          concat(concat("  if grep -qiE '", infra_retry_grep_alternation()), "' \"$BUILD_LOG\"; then\n"),
          "    echo \"::warning::cargo/sccache EAGAIN under fleet pressure; cold retry CARGO_BUILD_JOBS=1 (keep sccache)\"\n"
        ),
        concat(
          concat("    RETRY_LOG=$(mktemp)\n", "    if ! ( CARGO_BUILD_JOBS=1 "),
          concat(command, " ) 2>&1 | tee \"$RETRY_LOG\"; then\n")
        )
      ),
      concat(
        concat(
          concat(
            concat(concat("      if grep -qiE '", infra_retry_grep_alternation()), "' \"$RETRY_LOG\"; then\n"),
            "        echo \"::warning::cargo/sccache still failing; retry without RUSTC_WRAPPER\"\n"
          ),
          concat("        env -u RUSTC_WRAPPER CARGO_BUILD_JOBS=1 ", concat(command, " || exit 1\n"))
        ),
        concat(
          concat("      else\n", "        exit 1\n"),
          concat("      fi\n", "    fi\n")
        )
      )
    ),
    concat(
      concat(
        concat("    rm -f \"$RETRY_LOG\"\n", "  else\n"),
        concat("    exit 1\n", "  fi\n")
      ),
      concat("fi\n", "rm -f \"$BUILD_LOG\"\n")
    )
  )
}

fn ci_cargo_eagain_retry_script(command: String) -> String {
  concat("set -o pipefail\n", ci_cargo_eagain_retry_core(command: command))
}

fn ci_cargo_eagain_retry_shell_exec(command: String) -> String {
  concat(
    concat("bash -o pipefail <<'__GUNBC_CI_RETRY__'\n", ci_cargo_eagain_retry_core(command: command)),
    "__GUNBC_CI_RETRY__"
  )
}

data ci_floor_required_artifact_names: List<String> = ["claim_executor", "gunbc"]

fn artifact_shell_path(name: String) -> String {
  concat(concat("\"$ROOT/target/release/", name), "\"")
}

fn ci_floor_build_verify_script() -> String {
  let bin = claim_executor_bin_shell()
  let paths = fold(
    ci_floor_required_artifact_names,
    init: "",
    f: (acc, name) => concat(acc, concat(" ", artifact_shell_path(name: name)))
  )
  concat(concat(concat(bin, " --verify-build-artifacts"), paths), "\n")
}

fn ci_release_build_script() -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      ci_cargo_eagain_retry_script(command: ci_release_build_line()),
      concat(
        ci_floor_build_verify_script(),
        "sccache --show-stats 2>/dev/null || true"
      )
    )
  )
}

fn claim_executor_bin_shell() -> String {
  "\"$ROOT/target/release/claim_executor\""
}

fn join_slash(parts: List<String>) -> String {
  fold(parts, init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, "/"), p) })
}

data ci_documentation_only_floor_shortcut_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "ci_documentation_only_floor_shortcut_script",
    field: WholeDeclaration
  }
}

data ci_documentation_only_floor_shortcut_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: ci_documentation_only_floor_shortcut_script — concat-built bash path-prefix predicate + heredoc over git diff --name-only (interim path heuristic until affected-set-scoped compile-clean); DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0) realizes floor scoping through orchestration emit and this shortcut retires"

data ci_documentation_only_diff_note: String = "Interim compile-clean scoping: merge-base diffs whose only changed paths are under docs/ skip the compose floor. Path-prefix matching is an interim heuristic — dissolve-on: affected-set-scoped compile-clean (Ruling 1 path grain) replaces it. Empty _ci_changed (git fetch/diff failure) short-circuits this block and falls through to the full floor (fail-closed, not widening). Merge-admission stamps Skipped (not Success) via CI_FLOOR_DISPOSITION=documentation_only_skipped so floor-not-run ≠ floor-green. Generated-artifact carriers (.gitignore, README.md/CLAUDE.md/DESIGN.md symlinks) are excluded from the allowlist — their only drift guard is floor-resident; whitelisting them would self-shortcut that gate (#6236 class). CI substrate (.github/workflows/ci.yml, dag/gunbc/ci_spec.dag, ci_spec witnesses) is likewise excluded."

fn ci_merge_base_diff_range(policy: DiffPolicy) -> String {
  match policy.mode {
    DiffMergeBase => concat(concat(policy.base, "..."), policy.head)
    DiffTwoDot => concat(concat(policy.base, ".."), policy.head)
  }
}

fn ci_documentation_only_floor_shortcut_script(policy: DiffPolicy) -> String {
  let range = ci_merge_base_diff_range(policy: policy)
  concat(
    concat(
      concat(
        concat("_ci_changed=$(git diff --name-only ", range),
        " 2>/dev/null || true)\n"
      ),
      concat(
        "if [ -n \"$_ci_changed\" ]; then\n",
        concat(
          concat("# ", concat(ci_documentation_only_diff_note, "\n")),
          concat("# ", concat(ci_documentation_only_floor_shortcut_shell_emit_dissolution_trigger, "\n"))
        )
      )
    ),
    concat(
      concat(
        concat(
          "  DOCS_ONLY=1\n",
          "  while IFS= read -r _ci_path; do\n"
        ),
        "    [ -z \"$_ci_path\" ] && continue\n"
      ),
      concat(
        concat(
          concat(
            "    if [[ \"$_ci_path\" == docs/* ]]; then\n",
            "      :\n"
          ),
          "    else\n"
        ),
        concat(
          concat(
            "      DOCS_ONLY=0\n",
            "      break\n"
          ),
          concat(
            "    fi\n",
            concat(
              "  done <<_ci_diff_eof_\n",
              "$_ci_changed\n"
            )
          )
        )
      )
    ),
    concat(
      concat(
        "_ci_diff_eof_\n",
        "  if [ \"$DOCS_ONLY\" = \"1\" ]; then\n"
      ),
      concat(
        concat(
          concat(
            "    echo \"claim_executor: documentation-only diff — floor skipped (CI_FLOOR_DISPOSITION=",
            merge_admission_floor_disposition_documentation_only_skipped
          ),
          concat(
            ")\"\n",
            concat(
              "    CI_FLOOR_DISPOSITION=",
              concat(
                merge_admission_floor_disposition_documentation_only_skipped,
                concat(" ", merge_admission_stamp_invoke())
              )
            )
          )
        ),
        concat(
          "    exit $?\n",
          "  fi\nfi\n"
        )
      )
    )
  )
}

fn git_fetch_script(policy: DiffPolicy) -> String {
  let parts = split(s: policy.base, delimiter: "/")
  let remote = parts.first()
  let ref_name = join_slash(parts: parts.skip(n: 1))
  concat(
    concat(concat("git fetch --no-tags ", remote), " "),
    concat(ref_name, " 2>/dev/null || true")
  )
}

data floor_plan_entry: String = "src/v2/workflow/ci_floor_plan.dag"
data floor_plan_function: String = "gunbc_ci_floor_batches"
data regen_floor_plan_function: String = "gunbc_ci_regen_floor_batches"

fn scheduler_invoke_with(spec: CiSpec, plan_function: String) -> String {
  concat(
    concat(
      concat(
        concat(concat(claim_executor_bin_shell(), witness_layer_source_flags(roots: witness_layer_roots)), concat(" --plan-entry ", floor_plan_entry)),
        concat(" --plan-function ", plan_function)
      ),
      concat(concat(" --notice-title \"", spec.notice_title), "\"")
    ),
    ""
  )
}

fn scheduler_invoke(spec: CiSpec) -> String {
  scheduler_invoke_with(spec: spec, plan_function: floor_plan_function)
}

fn gunbc_ci_floor_only_script(spec: CiSpec) -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(git_fetch_script(policy: spec.diff_policy), "\n"),
      concat(
        concat(ci_documentation_only_floor_shortcut_script(policy: spec.diff_policy), "\n"),
        concat(
          concat("set +e\n", concat(scheduler_invoke(spec: spec), "\n")),
          ci_floor_stamp_merge_admission_script()
        )
      )
    )
  )
}

fn gunbc_ci_run_script(spec: CiSpec) -> String {
  concat(concat(ci_release_build_script(), "\n"), gunbc_ci_floor_only_script(spec: spec))
}

fn gunbc_ci_regen_floor_only_script(spec: CiSpec) -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(git_fetch_script(policy: spec.diff_policy), "\n"),
      concat(scheduler_invoke_with(spec: spec, plan_function: regen_floor_plan_function), "\n")
    )
  )
}

fn gunbc_ci_regen_floor_run(spec: CiSpec) -> String {
  gunbc_ci_regen_floor_only_script(spec: spec)
}

data regen_ratchet_entry: String = "dag/tools/regen_divergence_ratchet.dag"
data regen_ratchet_function: String = "regen_divergence_ratchet_gate"

fn gunbc_ci_regen_ratchet_invoke() -> String {
  concat(
    concat(
      concat(
        concat("\"$ROOT/target/release/gunbc\" run", witness_layer_source_flags(roots: witness_layer_roots)),
        concat(" --entry ", regen_ratchet_entry)
      ),
      concat(" --function ", regen_ratchet_function)
    ),
    "\n"
  )
}

fn gunbc_ci_regen_ratchet_only_script() -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(git_fetch_script(policy: gunbc_ci_spec.diff_policy), "\n"),
      gunbc_ci_regen_ratchet_invoke()
    )
  )
}

fn gunbc_ci_workflow_run(spec: CiSpec) -> String {
  gunbc_ci_floor_only_script(spec: spec)
}

fn gunbc_ci_floor_run(spec: CiSpec) -> String {
  gunbc_ci_floor_only_script(spec: spec)
}

fn gunbc_ci_rust_gate_invoke() -> String {
  ci_cargo_eagain_retry_script(
    command: concat(
      concat("\"$ROOT/target/release/gunbc\" run", witness_layer_source_flags(roots: witness_layer_roots)),
      " --entry dag/tools/rust_gates_ci.dag --function main"
    )
  )
}

fn gunbc_ci_rust_gate_only_script() -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(git_fetch_script(policy: gunbc_ci_spec.diff_policy), "\n"),
      gunbc_ci_rust_gate_invoke()
    )
  )
}

fn gunbc_ci_rust_job_run() -> String {
  concat(concat(ci_release_build_script(), "\n"), gunbc_ci_rust_gate_only_script())
}

fn gunbc_ci_deploy_invoke(stage: DeployStage) -> String {
  concat(
    concat(
      concat(
        concat("\"$ROOT/target/release/gunbc\" run", witness_layer_source_flags(roots: witness_layer_roots)),
        concat(" --entry ", stage.entry)
      ),
      concat(" --function ", stage.function)
    ),
    "\n"
  )
}

fn gunbc_ci_deploy_run_script(stage: DeployStage) -> String {
  concat(concat(ci_release_build_script(), "\n"), gunbc_ci_deploy_invoke(stage: stage))
}

