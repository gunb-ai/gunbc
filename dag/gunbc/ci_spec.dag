type DiffMode = DiffMergeBase | DiffTwoDot

type FloorBatchStopPolicy = StopBeforeDependents | FullLedger

data gunbc_ci_floor_batch_stop_policy_note: String = "Floor batch stop policy (operator ruling 2026-07-22, fail-fast lane): claim_executor's walk halt is event-scoped so cheap-gate-early reorder does not truncate main's ledger. pull_request → StopBeforeDependents (fail-fast: a cheap-gate red stops before compile/corpus). push (main) and schedule (falsifier) → FullLedger (record batch failure and continue; exit non-zero at end). Unknown/unrecognized events default to FullLedger — never silently stop-early and lose ledger (the absorbing fallback). Authority: gunbc_ci_floor_batch_stop_policy_for_github_event in v2.workflow.ci_floor_plan; consumer: claim_executor.rs run_walk (see gunbc_ci_floor_batch_stop_policy_claim_executor_seed_note)."

data gunbc_ci_floor_batch_stop_policy_claim_executor_seed_note: String = "§7 seed-retained HAND-RUST bridge (src/v1/stage0/src/bin/claim_executor.rs): FloorBatchStopPolicy enum mirrors this type; run_walk halts or continues based on the variant returned by gunbc_ci_floor_batch_stop_policy_for_github_event after gunbc_ci_floor_plan_uses_batch_stop_policy gates enrollment. Reason: batch-walk halt is executor realization — host-process control flow over an already-evaluated .dag policy, not yet expressible as substrate behavior inside claim_executor. Checkable receipts: witness_floor_stop_policy_* + witness_floor_batch_stop_policy_plan_roster_enrolled in ci_floor_plan_witness_test; acceptance measurement (PR fail-fast ~2min; main push prints complete gate+corpus ledger under FullLedger). Dissolve-on: v2 self-emitted claim_executor run_walk when the executor bin crosses the self-host frontier (DESIGN §7 terminal collapse of stage0 host bins)."

data gunbc_ci_floor_batch_stop_policy_claim_executor_seed_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "FloorBatchStopPolicy",
    field: WholeDeclaration
  }
}

type DiffPolicy {
  base: String
  head: String
  mode: DiffMode
}

type DeployStage {
  id: String
  step_name: String
  entry: String
  function: String
  needs: List<String>
  access: DeployAccess
  runner: RunnerSpec
}

data ci_spec_witness_entries_note: String = "witness_entries is the opt-in CI witness roster (operator inversion 2026-07-04): declared CommitWitnessClaim rows on the GithubActionsCiJob surface (see ci_witness_optin_inversion in gunbc.commit_workflow), projected as explicit entries. Since the discovery flip (see ci_spec_discovery_flip_note) the roster is no longer the only witness source: discovery_scan_dirs re-admits the tree-wide corpus shrunk by affected-set selection, and the roster remains the home for rows that must run as declared explicit entries (execution-kind rows with their own resource profile). Empty witness_entries AND empty discovery_scan_dirs means the plan carries no witness-corpus node at all (the regen spec's shape)."

data ci_spec_discovery_flip_note: String = "discovery_scan_dirs is the affected-set enrollment flip (operator acceptance 2026-07-09 on #6403; re-landed 2026-07-10 after the operator's direct go, merged onto the resolve-receipt-gate era): the ci floor's corpus batch scans these dirs (plus the source-root *_test.dag walk) with SelectionApplied, so a PR runs the tree-wide witness corpus SHRUNK to the diff's affected set instead of the fixed opt-in roster. Rationale accepted: at flip authoring per-PR coverage was 8 of ~1721 discoverable witnesses, so a selection miss (skipped-but-affected witness) is bounded by the status quo - the witness would not have run at all - while the nightly affected-set-falsifier keeps running the full corpus cold with predictions recorded, so any missing selection edge still surfaces as a counted divergence within one cadence window. Selection stays fail-closed per the PR-A rulings (a provenance gap refuses, never widens; host-scaffold/live-tree rows never predict-skip). The 8-clean-window falsifier criterion continues to govern the falsifier's own retirement, not this flip. Empty list = no discovery (the regen spec, and synthetic test specs exercising pure roster machinery)."
type CiSpec {
  gates: List<Gate>
  witness_entries: List<ScheduleWitnessEntry>
  discovery_scan_dirs: List<String>
  diff_policy: DiffPolicy
  notice_title: String
  deploy_stages: List<DeployStage>
}

data gunbc_ci_floor_gates: List<Gate> = project_ci_floor_gates(roster: commit_gate_roster)

data gunbc_ci_regen_floor_gates: List<Gate> = project_ci_regen_job_gates(roster: commit_gate_roster)

data gunbc_ci_floor_witness_entries: List<ScheduleWitnessEntry> = project_ci_floor_witness_entries(roster: commit_gate_roster)

data gunbc_ci_gates: List<Gate> = gunbc_ci_floor_gates

data live_deploy_apply_entry: String = "dag/gunbc/live_deploy/apply.dag"
data live_deploy_apply_srv1_wet_function: String = "live_deploy_apply_srv1_wet"

data gunbc_ci_deploy_srv1_stage: DeployStage = {
  id: "deploy_dashboard_srv1",
  step_name: "Deploy dashboard to srv1 (live_deploy_apply_srv1_wet)",
  entry: live_deploy_apply_entry,
  function: live_deploy_apply_srv1_wet_function,
  needs: ["ci"],
  access: ci_deploy_srv1_access,
  runner: gunbc_ci_deploy_srv1_runner_spec(),
}

data gunbc_ci_deploy_stages: List<DeployStage> = [gunbc_ci_deploy_srv1_stage]

data gunbc_ci_spec: CiSpec = {
  gates: gunbc_ci_floor_gates,
  witness_entries: gunbc_ci_floor_witness_entries,
  discovery_scan_dirs: witness_discovery_scan_dirs,
  diff_policy: {
    base: gunbc_merge_target_ref as String,
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "v2 claim corpus",
  deploy_stages: gunbc_ci_deploy_stages,
}

