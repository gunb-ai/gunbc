data ci_heal_generated_artifact_gate_entry: String = "dag/tools/generated_artifact_gate.dag"

data ci_heal_generated_artifact_regen_function: String = "main_wet"

data ci_heal_regen_note: String = "The heal REGEN invoke: gunbc run on the generated-artifact drift gate's main_wet, which writes each committed_generated_artifacts() projection to its path (fail-closed fold — a write error stops the line, never a partial commit). Runs on the same witness_layer_roots and released gunbc binary the deploy job consumes. Idempotent by construction: on a tree already at the fixed point the writes are byte-identical, so the downstream commit-push step sees no git diff and pushes nothing — the loop terminates in one heal. That fixed point is the enforced contract of generated_artifact_drift_fixed_point_witness_test.witness_committed_is_fixed_point (committed bytes == artifact_generate), so a non-terminating heal loop is unwritable while that witness stays green."

fn gunbc_ci_heal_regen_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: ci_heal_generated_artifact_gate_entry,
    function: ci_heal_generated_artifact_regen_function,
    claim_run: false,
    receipt_rel: none
  )
}

data ci_heal_repo_local_git_config_entry: String = "dag/gunbc/repo_local_git_config.dag"
data ci_heal_repo_local_git_config_function: String = "converge"

data ci_heal_repo_local_git_config_note: String = "Immediately after the release gunbc binary is unpacked, converge repository-local Git integration bindings (merge.generated-artifact.driver and core.hooksPath) via the modeled repo_local_git_config actuator — BEFORE the skew-guard git merge, so merge=generated-artifact rows govern the remedy merge rather than dying as unresolved conflicts. Ordering is after unpack (converge is gunbc run) and before ci_heal_binary_source_skew_guard_step (that step's git merge is the first merge on this checkout). Heal push uses git -c core.hooksPath= so the post-converge hooksPath binding does not invoke pre-push during the unattended push (cargo is absent from the hook PATH on heal runners — a push refusal, not a formatting finding). Idempotent: already-converged checkouts are a no-op."



fn gunbc_ci_heal_repo_local_git_config_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: ci_heal_repo_local_git_config_entry,
    function: ci_heal_repo_local_git_config_function,
    claim_run: false,
    receipt_rel: none
  )
}

data ci_heal_dispatch_entry: String = "dag/tools/ci_heal_dispatch.dag"
data ci_heal_dispatch_function: String = "main"

fn gunbc_ci_heal_dispatch_invoke() -> String {
  gunbc_run_invocation_script_with_env(
    env: [
      EnvSet { name: "GUNBC_HEALED_HEAD", value: "\"$HEALED_HEAD\"" },
      EnvSet { name: "GUNBC_HEAL_BRANCH_REF", value: "\"$\{{ github.head_ref || github.ref_name \}}\"" }
    ],
    source_roots: witness_layer_roots,
    entry: ci_heal_dispatch_entry,
    function: ci_heal_dispatch_function,
    claim_run: false
  )
}

data ci_heal_dispatch_invoke_note: String = "After a successful push the heal invokes tools.ci_heal_dispatch, which binds the modeled github.Workflows.CreateDispatch operation. The moving branch ref and immutable HEALED_HEAD are distinct inputs. The dispatched run binds the branch resolution recorded in github.sha and its checkout head to that immutable input before any witness can count. The workflow RunStep projects github.token into its GITHUB_TOKEN environment because GitHub Actions does not inject the installation token as a process variable by default; CreateDispatch auth_source reads that env var. A transport refusal makes the gunbc invocation nonzero; the surrounding heal script classifies HealDispatchRefused, keeps revalidation required, and fails loudly. There is deliberately no fallback to the ordinary push event and no silent retry."

data ci_heal_binary_source_skew_note: String = "RETIRED 2026-08-18 WITH THE REGEN ROOT CUT: the guard this note describes is DELETED and no function implements it. Everything below is the incident record that produced it, kept because the receipt outlives the mechanism; read it in the past tense. THE PAIRING THE HEAL JOB NEVER MODELED (incident 2026-07-29). A generated artifact's identity is (authority source x compiler), and this job silently pairs TWO DIFFERENT REVISIONS of that product: the release binary comes from `build`, which uses the default pull_request checkout — the MERGE ref (main + PR) — while this job checks out `github.head_ref`, the BRANCH HEAD, because it pushes the regeneration back (ci_heal_branch_checkout_note reasons carefully about the push semantics and never about the binary's provenance; it calls build's output 'the release gunbc binary', treating a projection of one revision as a context-free tool). The skew is latent until a seed change adds a Rust->.dag call: then the merge-ref binary invokes a `.dag` function the branch-head tree does not contain, `lookup_fn` misses, and the run dies mid-regen. Live receipt: #7348 landed the scoped-run observation seed, whose Rust calls gunbc.observation_seed_render.scoped_run_begin_write_measured; every open PR whose branch head predated it went red at once (#7392, #7394, #7395 — identical failure, none of them at fault), while main stayed green because ci_regen_heal_if skips this job on push. Reproduced by execution: ONE binary built from the merge ref, run against a pre-#7348 tree -> the exact CI failure; run against the same tree with origin/main merged in -> ExitSuccess, zero drift. The guard below refuses the unsound pairing instead of discovering it as a mid-regen crash."

data ci_heal_binary_source_skew_guard_note: String = "RETIRED 2026-08-18 WITH THE REGEN ROOT CUT: the guard is DELETED. The operator ruling of 2026-07-29 recorded below is kept as the ruling it was, not as a description of live behaviour. THE COMPARAND IS THE BUILT-FROM REVISION, NOT A BRANCH NAME (operator ruling 2026-07-29). The first cut of this guard compared against `origin/main`, and that was wrong on the operator's own objection: `origin/main` names several different things — the one on this runner, the one on a developer's machine, and the actual source of truth — so a guard keyed on it asserts a relationship between the tree and WHICHEVER main this box last fetched, and can even race an advance mid-run. There is no ambiguity to resolve because the question was never about main: it is 'was this binary compiled from a revision this tree can satisfy'. `github.sha` answers it exactly — on a pull_request it IS the merge commit the build job checked out, so the guard compares the tree against the binary's own provenance, in the same workflow run, with no floating ref anywhere. The guard fails closed if that revision cannot be resolved: an unverifiable provenance is a refusal, never an assumed-fine.\n\nPRECISION IS ALSO THE POINT (DESIGN §5 — refuse, never widen; and never manufacture friction the defect does not warrant). A blanket 'tree must equal the built-from revision' would red nearly every PR to catch a rare pairing — a wall priced in other people's time. The DECIDABLE condition that actually matters is narrower: the binary is unsound against this tree exactly when the built-from revision carries SEED commits (src/v1 — the Rust the binary is compiled from) this tree lacks, because only those can introduce a Rust->.dag expectation the tree cannot satisfy. `git rev-list HEAD..$BUILT_FROM -- src/v1` is exactly that set: empty on the overwhelming majority of PRs (a .dag-only advance cannot skew a compiled binary), non-empty precisely in the #7348 shape. VERIFIED BY EXECUTION on the incident itself: at the pre-#7348 branch point the set is two commits and one of them IS 445bac31c (#7348), so the guard names the responsible commit in its own refusal; at current main and at the same branch after the advance was merged in, the set is empty and the guard is silent — the heal that went green on #7395 is the live receipt for the passing arm. On non-empty the step REFUSES rather than regenerating with a compiler that disagrees with the tree, which is the fabricated-plausible-output arm §5 forbids: main_wet would write whatever artifacts that mismatched pair produces and the commit-push step would push them to the branch. NOT IN SCOPE: preventing a stale branch from MERGING at all. That is merge-admission policy, it needs a source-of-truth model this repo does not have yet (operator: the SCM lane after v1 deletion), and this guard deliberately does not pretend to supply one — it protects the one pairing this job has agency over."

data ci_heal_skew_auto_remedy_note: String = "RETIRED 2026-08-18 WITH THE REGEN ROOT CUT: the guard and its remedy are DELETED. The operator ruling of 2026-07-29 recorded below is kept as the ruling it was, not as a description of live behaviour. THE GUARD APPLIES ITS OWN REMEDY (operator ruling 2026-07-29: 'we can also try to apply the remedy automatically'). The first cut printed 'merge the base branch, then re-run' and exited 1, which is a correct refusal and a wasted round trip: the job holds contents:write, already pushes commits to this branch, and the fix is a merge it is fully authorized to perform. Making a human perform a mechanical repair the machine can do is the kind of toil this pipeline exists to remove.\n\nThis is a REPAIR, not a widen, and the distinction is the whole reason it is admissible under DESIGN §5. The refused arm does not proceed despite the skew — it REMOVES the skew by bringing the tree up to the revision the binary was built from, then re-checks the same condition it just failed. Regeneration runs only if that second check passes, so the artifacts are still projected by a compiler the tree agrees with. Nothing is assumed; the invariant is re-established and re-verified.\n\nBoth failure arms stay closed. A merge that CONFLICTS aborts and refuses with the original diagnostic plus the conflicting paths — the machine will not resolve semantic conflicts on an author's behalf. A merge that succeeds but leaves the seed still ahead (possible if the base moved again mid-run) refuses too, rather than looping. The remedy is attempted exactly once."

data ci_heal_author_commit_artifact_dir: String = "heal-author-commit-required"

data ci_heal_author_commit_artifact_name: String = "heal-author-commit-required"

data ci_heal_author_commit_regen_command: String = "gunbc run --source-root dag --source-root src/v2 --entry dag/tools/generated_artifact_gate.dag --function main_wet"

fn path_has_hidden_segment(path: String) -> Bool {
  string_contains(s: concat("/", path), pattern: "/.")
}

fn ci_heal_author_commit_artifact_includes_hidden_files() -> Bool {
  any(author_commit_required_committed_artifact_paths(), p => path_has_hidden_segment(path: p))
}

data ci_heal_commit_push_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "gunbc_ci_heal_commit_push_script",
    field: WholeDeclaration
  }
}

data ci_heal_commit_push_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: gunbc_ci_heal_commit_push_script — the entire foreign-executor heal commit RunStep, including git config/add/commit/push, workflow author-commit drift detection (git diff over author_commit_required_committed_artifact_paths), repair-artifact packaging (mkdir/cp into heal-author-commit-required/), and HealAuthorCommitRequired diagnostic emission. All of this is today concat-built bash under the single Scaffold disposition beside ci_heal_commit_push_shell_emit_scaffold (ci_heal_git_add_lines was already the prior git-staging half; #7659 extends the same surface for AuthorCommitRequired, not a second unmarked shell). The former merge-admission emitter peer stays deleted: its runtime-present work executes as typed git/filesystem operations inside WalkPlan success stages. DISSOLVES WHEN the shell→intent lane models the full heal repair disposition on host_effect_apply — git transport, filesystem packaging, typed diagnostic — via orchestration bash-emit or typed Do-effects (host-effect-orchestration, ROADMAP shell→intent Phase 2), at which point this RunStep is a realization handler, not emitted bash. The regen half (main_wet) is already modeled separately.")

fn ci_heal_git_add_lines() -> List<String> {
  map(auto_push_eligible_committed_artifact_paths(), p =>
    concat("if [ -e \"", concat(p, concat("\" ]; then git add \"", concat(p, concat("\"; else echo \"chore-heal: registered generated artifact absent on this tree, not staging: ", concat(p, "\"; fi")))))))
}

fn ci_heal_author_commit_drift_lines() -> List<String> {
  concat(
    ["AUTHOR_COMMIT_DRIFT=\"\""],
    map(author_commit_required_committed_artifact_paths(), p =>
      concat("if [ -e \"", concat(p, concat("\" ] && ! git diff --quiet -- \"", concat(p, concat("\"; then AUTHOR_COMMIT_DRIFT=\"$AUTHOR_COMMIT_DRIFT ", concat(p, "\"; fi")))))))
  )
}

data ci_heal_author_commit_required_output: String = "heal_author_commit_required"

fn ci_heal_author_commit_package_lines() -> List<String> {
  [
    concat(concat("echo \"", ci_heal_author_commit_required_output), "=0\" >> \"$GITHUB_OUTPUT\""),
    "if [ -n \"$AUTHOR_COMMIT_DRIFT\" ]; then",
    concat("  rm -rf \"", concat(ci_heal_author_commit_artifact_dir, "\"")),
    "  for p in $AUTHOR_COMMIT_DRIFT; do",
    concat("    if ! mkdir -p \"", concat(ci_heal_author_commit_artifact_dir, "/$(dirname \"$p\")\"; then echo \"::error::HealRepairBundleIncomplete path=$p\" >&2; exit 1; fi")),
    concat("    if ! cp \"$p\" \"", concat(ci_heal_author_commit_artifact_dir, "/$p\"; then echo \"::error::HealRepairBundleIncomplete path=$p\" >&2; exit 1; fi")),
    "  done",
    concat(concat("  echo \"", ci_heal_author_commit_required_output), "=1\" >> \"$GITHUB_OUTPUT\""),
    "fi"
  ]
}

fn ci_heal_shell_lines() -> List<String> {
  concat(
    [
      "git config user.name \"gunbc-ci-auto-heal\"",
      "git config user.email \"gunbc-ci-auto-heal@users.noreply.github.com\""
    ],
    concat(
      ci_heal_author_commit_drift_lines(),
      concat(
        ci_heal_author_commit_package_lines(),
        concat(
          ci_heal_git_add_lines(),
          [
            "PRIOR_HEAD=$(git rev-parse HEAD)",
            "if git diff --cached --quiet; then",
            "  if [ -n \"$AUTHOR_COMMIT_DRIFT\" ]; then",
            concat("    echo \"::error::HealAuthorCommitRequired head=$PRIOR_HEAD author_commit_paths=$AUTHOR_COMMIT_DRIFT cause=", concat(live_heal_push_refusal_cause_token(), concat(" regen_command='", concat(ci_heal_author_commit_regen_command, "'\" >&2")))),
            "    exit 1",
            "  fi",
            "  echo \"HealNoChange head=$PRIOR_HEAD\"",
            "  exit 0",
            "else",
            "  CHANGED_ARTIFACTS=$(git diff --cached --name-only)",
            "  git commit --no-verify -m \"chore: regenerate drifted generated artifacts (ci auto-heal)\"",
            "  HEALED_HEAD=$(git rev-parse HEAD)",
            "  git -c core.hooksPath= push origin HEAD:${{ github.head_ref || github.ref_name }}",
            "  echo \"HealProduced prior_head=$PRIOR_HEAD healed_head=$HEALED_HEAD changed_artifacts=$CHANGED_ARTIFACTS\"",
            "  ROOT=$(git rev-parse --show-toplevel)"
          ]
        )
      )
    )
  )
}

fn gunbc_ci_heal_commit_push_script() -> String {
  concat(
    fold(ci_heal_shell_lines(), init: "", f: fn(acc, line) { concat(acc, concat(line, "\n")) }),
    concat(
      concat("  if ! ", gunbc_ci_heal_dispatch_invoke()),
      concat(
        "  then\n  echo \"::error::HealDispatchRefused healed_head=$HEALED_HEAD cause=CreateWorkflowDispatchFailed\" >&2\n  exit 1\n  fi\n",
        concat(
          "  echo \"SupersededByHealedHead prior_head=$PRIOR_HEAD healed_head=$HEALED_HEAD; revalidation-required\"\n",
          "  if [ -n \"$AUTHOR_COMMIT_DRIFT\" ]; then\n",
          concat("    echo \"::error::HealAuthorCommitRequired head=$HEALED_HEAD author_commit_paths=$AUTHOR_COMMIT_DRIFT cause=", concat(live_heal_push_refusal_cause_token(), concat(" regen_command='", concat(ci_heal_author_commit_regen_command, "'\" >&2\n")))),
          "  fi\n",
          "  exit 1\nfi\n"
        )
      )
    )
  )
}
