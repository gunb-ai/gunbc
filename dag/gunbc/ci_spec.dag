fn ci_spec_with_witness_entries(spec: CiSpec, entries: List<ScheduleWitnessEntry>) -> CiSpec {
  CiSpec {
    gates: spec.gates,
    witness_entries: entries,
    discovery_scan_dirs: spec.discovery_scan_dirs,
    diff_policy: spec.diff_policy,
    notice_title: spec.notice_title,
    deploy_stages: spec.deploy_stages,
  }
}

fn ci_spec_with_discovery_scan_dirs(spec: CiSpec, dirs: List<String>) -> CiSpec {
  CiSpec {
    gates: spec.gates,
    witness_entries: spec.witness_entries,
    discovery_scan_dirs: dirs,
    diff_policy: spec.diff_policy,
    notice_title: spec.notice_title,
    deploy_stages: spec.deploy_stages,
  }
}

data ci_release_features: String = "text_lookup_work_counter"

fn ci_repo_root_shell() -> String {
  "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
}

fn ci_release_build_line() -> String {
  concat(
    concat(
      "\"$CARGO_HOME/bin/cargo\" build -p v1-compiler --release --features ",
      ci_release_features
    ),
    fold(
      ci_floor_required_artifact_names,
      init: "",
      f: (acc, name) => concat(acc, concat(" --bin ", name))
    )
  )
}

fn ci_retry_body_run(command: String) -> Run {
  Run {
    command: command,
    env: [],
    redirect: Present { value: StdoutAndStderr },
    capture: Present { value: TeeTo { log: "BUILD_LOG" } }
  }
}

fn ci_retry_exhausted_pipeline() -> Pipeline {
  Pipeline {
    steps: [Do { run: Run { command: "exit 1", env: [], redirect: Absent, capture: Absent } }],
    on_failure: FailFast
  }
}

fn ci_retry_escalation_level1() -> EscalationLevel {
  EscalationLevel {
    detect: LogMatches { source: "BUILD_LOG", pattern: infra_retry_grep_alternation() },
    warning: EmitDirective {
      severity: SeverityWarning,
      message: "cargo/sccache EAGAIN under fleet pressure; cold retry CARGO_BUILD_JOBS=1 (keep sccache)"
    },
    env: [EnvSet { name: "CARGO_BUILD_JOBS", value: "1" }]
  }
}

fn ci_retry_escalation_level2() -> EscalationLevel {
  EscalationLevel {
    detect: LogMatches { source: "RETRY_LOG", pattern: infra_retry_grep_alternation() },
    warning: EmitDirective {
      severity: SeverityWarning,
      message: "cargo/sccache still failing; retry without RUSTC_WRAPPER"
    },
    env: [
      EnvUnset { name: "RUSTC_WRAPPER" },
      EnvSet { name: "CARGO_BUILD_JOBS", value: "1" }
    ]
  }
}

fn ci_cargo_eagain_retry_intent(command: String) -> PipelineStep {
  Retry {
    body: Pipeline {
      steps: [Do { run: ci_retry_body_run(command: command) }],
      on_failure: FailFast
    },
    escalations: [ci_retry_escalation_level1(), ci_retry_escalation_level2()],
    on_exhausted: ci_retry_exhausted_pipeline()
  }
}

data ci_retry_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ retry-intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid workflow shell, so the committed ci.yml drift gate and the yaml parse gate both go red rather than a hand-spelled fallback masking the refusal (DESIGN 5: refuse, never widen - the String-typed seam cannot carry the diagnostics, so it carries a loud poison instead)\n"

fn ci_cargo_eagain_retry_core(command: String) -> String {
  match orch_emit_step(
    s: ci_cargo_eagain_retry_intent(command: command),
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => ci_retry_emit_refused_poison
      }
    Rejected { diagnostics: _ } => ci_retry_emit_refused_poison
  }
}

fn ci_cargo_eagain_retry_script(command: String) -> String {
  concat("set -o pipefail\n", ci_cargo_eagain_retry_core(command: command))
}

fn ci_cargo_eagain_retry_shell_exec(command: String) -> String {
  concat(
    concat("bash -o pipefail <<'__GUNBC_CI_RETRY__'\n", ci_cargo_eagain_retry_core(command: command)),
    "__GUNBC_CI_RETRY__"
  )
}

data ci_floor_required_artifact_names: List<String> = [
  "claim_executor",
  "gunbc",
  "floor_skip_discovery_witness",
  "discover_source_root_ingest",
  "claim_batch",
  "regen_stage0",
  "interp_recorded_fixture_witness",
  "v1_src_dag_parse",
  "auth_declared_but_unwired_witness",
  "bootstrap_witness",
  "dag_collect_fingerprint_witness",
  "diagnostics_witness",
  "effects_rest_transport_witness",
  "infer_semantics_witness",
  "parse_witness"
]

data ci_floor_required_artifact_names_note: String = "This list is the single cross-job handoff manifest (operator job-split ruling 2026-07-11): ci_release_build_line derives its --bin flags from it (build/manifest skew is unwritable), the build job verifies these bins post-build, packs exactly these into the release-bins artifact, and every downstream job (ci floor, emit_determinism) unpacks and re-verifies the same list before running. Membership = the floor-invoked bins (claim_executor, gunbc, floor_skip_discovery_witness) plus the FULL bin_name universe of tools.host_prelude transports (witness_bin / ensure_bin_built_and_verified) that corpus witnesses can address — pre-split those fell back to in-job cargo builds against the build step's warm target/ (cheap); post-split the floor job has no build cache, so a bin missing here would silently re-absorb the ~33min monolith cold compile the job split exists to bound. The intentionally-absent negative control (no_such_witness_bin_zzz) is excluded. The build-if-absent stale-binary class (#6352) is out of scope: a same-run artifact is fresh by construction."

fn artifact_shell_path(name: String) -> String {
  concat(concat("\"$ROOT/target/release/", name), "\"")
}

fn ci_floor_build_verify_script() -> String {
  let bin = claim_executor_bin_shell()
  let paths = fold(
    ci_floor_required_artifact_names,
    init: "",
    f: (acc, name) => concat(acc, concat(" ", artifact_shell_path(name: name)))
  )
  concat(concat(concat(bin, " --verify-build-artifacts"), paths), "\n")
}

data ci_release_bins_archive_name: String = "release-bins.tgz"

fn ci_release_bins_pack_script() -> String {
  let names = fold(
    ci_floor_required_artifact_names,
    init: "",
    f: (acc, name) => concat(acc, concat(" ", concat("\"", concat(name, "\""))))
  )
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(concat("tar -czf \"$ROOT/", ci_release_bins_archive_name), "\" -C \"$ROOT/target/release\""),
      concat(names, "\n")
    )
  )
}

fn ci_release_bins_unpack_verify_script() -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      "mkdir -p \"$ROOT/target/release\"\n",
      concat(
        concat(concat("tar -xzf \"$ROOT/", ci_release_bins_archive_name), "\" -C \"$ROOT/target/release\"\n"),
        concat(
          concat(concat("rm -f \"$ROOT/", ci_release_bins_archive_name), "\"\n"),
          ci_floor_build_verify_script()
        )
      )
    )
  )
}

fn ci_release_build_script() -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      ci_cargo_eagain_retry_script(command: ci_release_build_line()),
      concat(
        ci_floor_build_verify_script(),
        "sccache --show-stats 2>/dev/null || true"
      )
    )
  )
}

fn claim_executor_bin_shell() -> String {
  "\"$ROOT/target/release/claim_executor\""
}

fn join_slash(parts: List<String>) -> String {
  fold(parts, init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, "/"), p) })
}

data ci_documentation_only_floor_shortcut_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "ci_documentation_only_floor_shortcut_script",
    field: WholeDeclaration
  }
}

data ci_documentation_only_floor_shortcut_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: ci_documentation_only_floor_shortcut_script — concat-built bash path-prefix predicate + heredoc over git diff --name-only (interim path heuristic until affected-set-scoped compile-clean); DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0) realizes floor scoping through orchestration emit and this shortcut retires"

data ci_documentation_only_diff_note: String = "Interim plan-artifact scoping: merge-base diffs whose only changed paths are under docs/ or dag/gunbc/plans/ run compile-clean then skip the witness corpus. Path-prefix matching is an interim heuristic — dissolve-on: affected-set-scoped compile-clean (Ruling 1 path grain) replaces it. Empty _ci_changed (git fetch/diff failure) short-circuits this block and falls through to the full floor (fail-closed, not widening). Merge-admission stamps Skipped (not Success) via CI_FLOOR_DISPOSITION=documentation_only_skipped so floor-not-run ≠ floor-green. Generated-artifact carriers (.gitignore, README.md/CLAUDE.md/DESIGN.md symlinks) are excluded from the allowlist — their only drift guard is floor-resident; whitelisting them would self-shortcut that gate (#6236 class). CI substrate (.github/workflows/ci.yml, dag/gunbc/ci_spec.dag, ci_spec witnesses) is likewise excluded."

fn ci_merge_base_diff_range(policy: DiffPolicy) -> String {
  match policy.mode {
    DiffMergeBase => concat(concat(policy.base, "..."), policy.head)
    DiffTwoDot => concat(concat(policy.base, ".."), policy.head)
  }
}

fn ci_plan_artifact_compile_clean_invoke() -> String {
  concat(
    concat(
      concat(
        concat(claim_executor_bin_shell(), witness_layer_source_flags_rooted(roots: witness_layer_roots)),
        " --entry \"$ROOT/dag/tools/floor_effect_gate_witness.dag\""
      ),
      " --function dag_compile_clean_gate_passes"
    ),
    ""
  )
}

fn ci_documentation_only_floor_shortcut_script(policy: DiffPolicy) -> String {
  let range = ci_merge_base_diff_range(policy: policy)
  concat(
    concat(
      concat(
        concat("_ci_changed=$(git diff --name-only ", range),
        " 2>/dev/null || true)\n"
      ),
      concat(
        "if [ -n \"$_ci_changed\" ]; then\n",
        concat(
          concat("# ", concat(ci_documentation_only_diff_note, "\n")),
          concat("# ", concat(ci_documentation_only_floor_shortcut_shell_emit_dissolution_trigger, "\n"))
        )
      )
    ),
    concat(
      concat(
        concat(
          "  PLAN_ARTIFACT_ONLY=1\n",
          "  while IFS= read -r _ci_path; do\n"
        ),
        "    [ -z \"$_ci_path\" ] && continue\n"
      ),
      concat(
        concat(
          concat(
            "    if [[ \"$_ci_path\" == docs/* ]] || [[ \"$_ci_path\" == dag/gunbc/plans/* ]]; then\n",
            "      :\n"
          ),
          "    else\n"
        ),
        concat(
          concat(
            "      PLAN_ARTIFACT_ONLY=0\n",
            "      break\n"
          ),
          concat(
            "    fi\n",
            concat(
              "  done <<_ci_diff_eof_\n",
              "$_ci_changed\n"
            )
          )
        )
      )
    ),
    concat(
      concat(
        "_ci_diff_eof_\n",
        "  if [ \"$PLAN_ARTIFACT_ONLY\" = \"1\" ]; then\n"
      ),
      concat(
        concat(
          concat(
            concat(concat("    ", concat(ci_plan_artifact_compile_clean_invoke(), " || exit $?\n"))),
            concat(
              "    mkdir -p target\n",
              concat(
                concat("    echo ", merge_admission_floor_disposition_documentation_only_skipped),
                concat(" > ", concat(ci_floor_disposition_marker_path, "\n"))
              )
            )
          ),
          concat(
            "    echo \"claim_executor: plan-artifact-only diff — compile-clean ok; floor skipped (CI_FLOOR_DISPOSITION=",
            merge_admission_floor_disposition_documentation_only_skipped
          )
        ),
        concat(
          concat(
            ")\"\n",
            concat(
              "    CI_FLOOR_DISPOSITION=",
              concat(
                merge_admission_floor_disposition_documentation_only_skipped,
                concat(" ", merge_admission_stamp_invoke())
              )
            )
          ),
          concat(
            "    exit $?\n",
            "  fi\nfi\n"
          )
        )
      )
    )
  )
}

fn git_fetch_script(policy: DiffPolicy) -> String {
  let parts = split(s: policy.base, delimiter: "/")
  let remote = parts.first()
  let ref_name = join_slash(parts: parts.skip(n: 1))
  concat(
    concat(concat("git fetch --no-tags ", remote), " "),
    concat(ref_name, " 2>/dev/null || true")
  )
}

data floor_plan_entry: String = "src/v2/workflow/ci_floor_plan.dag"
data floor_plan_function: String = "gunbc_ci_floor_batches"
data regen_floor_plan_function: String = "gunbc_ci_regen_floor_batches"
data emit_determinism_floor_plan_function: String = "gunbc_ci_emit_determinism_batches"

fn scheduler_invoke_with(spec: CiSpec, plan_function: String) -> String {
  concat(
    concat(
      concat(
        concat(concat(claim_executor_bin_shell(), witness_layer_source_flags_rooted(roots: witness_layer_roots)), concat(" --plan-entry ", floor_plan_entry)),
        concat(" --plan-function ", plan_function)
      ),
      concat(concat(" --notice-title \"", spec.notice_title), "\"")
    ),
    ""
  )
}

fn scheduler_invoke(spec: CiSpec) -> String {
  scheduler_invoke_with(spec: spec, plan_function: floor_plan_function)
}

fn gunbc_ci_floor_only_script(spec: CiSpec) -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(git_fetch_script(policy: spec.diff_policy), "\n"),
      concat(
        concat(ci_floor_disposition_marker_init_script(), "\n"),
        concat(
          concat(ci_documentation_only_floor_shortcut_script(policy: spec.diff_policy), "\n"),
          concat(
            concat("set +e\n", concat(scheduler_invoke(spec: spec), "\n")),
            ci_floor_stamp_merge_admission_script()
          )
        )
      )
    )
  )
}

fn gunbc_ci_run_script(spec: CiSpec) -> String {
  concat(concat(ci_release_build_script(), "\n"), gunbc_ci_floor_only_script(spec: spec))
}

fn gunbc_ci_regen_floor_only_script(spec: CiSpec) -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(git_fetch_script(policy: spec.diff_policy), "\n"),
      concat(scheduler_invoke_with(spec: spec, plan_function: regen_floor_plan_function), "\n")
    )
  )
}

fn gunbc_ci_regen_floor_run(spec: CiSpec) -> String {
  gunbc_ci_regen_floor_only_script(spec: spec)
}

fn gunbc_ci_emit_determinism_floor_only_script(spec: CiSpec) -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(git_fetch_script(policy: spec.diff_policy), "\n"),
      concat(scheduler_invoke_with(spec: spec, plan_function: emit_determinism_floor_plan_function), "\n")
    )
  )
}

fn gunbc_ci_emit_determinism_floor_run(spec: CiSpec) -> String {
  gunbc_ci_emit_determinism_floor_only_script(spec: spec)
}

fn gunbc_ci_workflow_run(spec: CiSpec) -> String {
  gunbc_ci_floor_only_script(spec: spec)
}

fn gunbc_ci_floor_run(spec: CiSpec) -> String {
  gunbc_ci_floor_only_script(spec: spec)
}

fn gunbc_ci_deploy_invoke(stage: DeployStage) -> String {
  concat(
    concat(
      concat(
        concat("\"$ROOT/target/release/gunbc\" run", witness_layer_source_flags_rooted(roots: witness_layer_roots)),
        concat(" --entry ", stage.entry)
      ),
      concat(" --function ", stage.function)
    ),
    "\n"
  )
}

fn gunbc_ci_deploy_run_script(stage: DeployStage) -> String {
  concat(concat(ci_release_build_script(), "\n"), gunbc_ci_deploy_invoke(stage: stage))
}

