data ci_fmt_gate_note: String = "cargo fmt --all --check, RE-ENROLLED in CI 2026-07-15 (operator ruling, this PR) as a standalone build-job step — NOT a RustMonolithGate re-enrollment, which gunbc.commit_workflow.commit_gate_rust_suite_removed_disposition rejects and this row does not touch. That ruling (2026-07-11) removed the fmt+nextest bundle for reasons that are all facts about NEXTEST — ~37 GiB, red on main, non-required, a permanent tolerated red (DESIGN 5) — and fmt was collateral damage of a DESIGN 3 fusion: tools.rust_gates_ci.run_gates welds two separable facts (fmt: 4.3s measured, parse-only, no build, green; nextest: 37 GiB compile+run, red) into one ProcessExit, so killing the bundle killed the cheap green half too. The ruling's declared replacement coverage — the pre-push hook (CommitCargoFmtCheck on GitPrePushHook) — is an escape hatch (DESIGN 5: opt-in per clone via a manual core.hooksPath config, bypassable with --no-verify, absent in container worktrees) and is PROVEN ineffective: #6658 landed an unformatted .rs on main 2026-07-15 and nothing caught it; the falsifier lane found it only by running fmt by hand. Placement: FIRST step of the build job, before the ~33min release build, so a 4-second violation fails in 4 seconds rather than after the build; build is not protection-required itself but ci needs:[build], so a red here blocks the required job by construction. Cost: 4.3s measured whole-workspace, on a toolchain that already installs the rustfmt component in ci_prelude_steps. 🟡 dissolve-on: the fmt spelling here is a shell-transport realization of extdeps.cargo_build cargo.Build.Fmt (the same operation tools.rust_gates_ci calls through the effect model); it collapses onto that single authority when the ci.yml emit seam can bind a typed cargo operation instead of a hand-spelled argv line — the same de-fork ci_release_build_line awaits. Retires WITH the v1 seed at DESIGN 7 terminal collapse, when no .rs remains to format."

fn ci_fmt_gate_line() -> String {
  "\"$CARGO_BIN\" fmt --all --check"
}

fn ci_retry_body_run(command: String) -> Run {
  Run {
    command: command,
    env: [],
    redirect: Absent,
    capture: Absent
  }
}

fn ci_retry_exhausted_pipeline() -> Pipeline {
  Pipeline {
    steps: [Do { run: Run { command: "exit 1", env: [], redirect: Absent, capture: Absent } }],
    on_failure: FailFast
  }
}

fn ci_retry_escalation_level1() -> EscalationLevel {
  EscalationLevel {
    detect: LogMatches { source: "BUILD_LOG", pattern: infra_retry_grep_alternation() },
    warning: EmitDirective {
      severity: SeverityWarning,
      message: "cargo/sccache EAGAIN under fleet pressure; cold retry CARGO_BUILD_JOBS=1 (keep sccache)"
    },
    env: [EnvSet { name: "CARGO_BUILD_JOBS", value: "1" }]
  }
}

fn ci_cargo_eagain_retry_intent(command: String) -> PipelineStep {
  Retry {
    body: Pipeline {
      steps: [Do { run: ci_retry_body_run(command: command) }],
      on_failure: FailFast
    },
    escalations: [ci_retry_escalation_level1()],
    on_exhausted: ci_retry_exhausted_pipeline()
  }
}

data ci_floor_required_artifact_names_note: String = "DERIVED pack membership — authority is gunbc.ci_release_bins (ci_floor_invoked_bins ∪ witness_declared_release_bins). The hand List that lived here was deleted 2026-07-26: fan-out (build --bin flags / pack / verify) still folds ci_floor_required_artifact_names(), but MEMBERSHIP is no longer a free-floating hand list in this module. See gunbc.ci_release_bins.ci_release_bins_authority_note for the construction wall (WitnessBinNotEnrolled) and the dissolve-on for witness_declared_release_bins. Operator job-split ruling 2026-07-11 still applies to the handoff shape. The intentionally-absent negative control (no_such_witness_bin_zzz) is excluded. The build-if-absent stale-binary class (#6352) is out of scope: a same-run artifact is fresh by construction."

fn artifact_shell_path(name: String) -> String {
  concat(concat("\"$ROOT/target/release/", name), "\"")
}

fn ci_floor_build_verify_script() -> String {
  let paths = map(ci_floor_required_artifact_names(), name => artifact_shell_path(name: name))
  claim_executor_verify_artifacts_shell(artifact_paths: paths)
}

data ci_release_bins_archive_name: String = "release-bins.tgz"

data ci_release_bins_pack_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "ci_release_bins_pack_script",
    field: WholeDeclaration
  }
}

data ci_release_bins_pack_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: ci_release_bins_pack_script — concat-built foreign-executor (GitHub Actions run:) release-bins tar pack runner; membership of archived bin names is derived from gunbc.ci_release_bins, but the pack transport itself remains hand-shell; DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0 / shell→intent Phase 2) realizes the pack runner through orchestration emit or typed host_effect_apply without a medium-as-string concat scaffold"

fn ci_release_bins_pack_script() -> String {
  let names = fold(
    ci_floor_required_artifact_names(),
    init: "",
    f: (acc, name) => concat(acc, concat(" ", concat("\"", concat(name, "\""))))
  )
  concat(
    concat("# ", concat(ci_release_bins_pack_shell_emit_dissolution_trigger, "\n")),
    concat(
      concat("ROOT=", ci_repo_root_shell(), "\n"),
      concat(
        concat(concat("tar -czf \"$ROOT/", ci_release_bins_archive_name), "\" -C \"$ROOT/target/release\""),
        concat(names, "\n")
      )
    )
  )
}

data ci_release_bins_unpack_verify_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "ci_release_bins_unpack_verify_script",
    field: WholeDeclaration
  }
}

data ci_release_bins_unpack_verify_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: ci_release_bins_unpack_verify_script — concat-built foreign-executor (GitHub Actions run:) release-bins unpack + claim_executor --verify-build-artifacts runner; membership of verified paths is derived from gunbc.ci_release_bins, but the unpack/verify transport itself remains hand-shell; DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0 / shell→intent Phase 2) realizes the unpack/verify runner through orchestration emit or typed host_effect_apply without a medium-as-string concat scaffold"

fn ci_release_bins_unpack_verify_script() -> String {
  concat(
    concat("# ", concat(ci_release_bins_unpack_verify_shell_emit_dissolution_trigger, "\n")),
    concat(
      concat("ROOT=", ci_repo_root_shell(), "\n"),
      concat(
        "mkdir -p \"$ROOT/target/release\"\n",
        concat(
          concat(concat("tar -xzf \"$ROOT/", ci_release_bins_archive_name), "\" -C \"$ROOT/target/release\"\n"),
          concat(
            concat(concat("rm -f \"$ROOT/", ci_release_bins_archive_name), "\"\n"),
            ci_floor_build_verify_script()
          )
        )
      )
    )
  )
}

fn join_slash(parts: List<String>) -> String {
  fold(parts, init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, "/"), p) })
}

data ci_documentation_only_floor_shortcut_retired_note: String = "REMOVED 2026-07-21 (gunbc#7023 / proud-cat-517): the documentation_only_skip shell shortcut exited before claim_executor, bypassing the witness corpus entirely on docs-only PRs. That bypassed the existing ReadsLiveTree never-predict-skip lane — doc_reachability_witness_test.dag already declared ReadsLiveTree since #6654, but the shell never reached selection. Docs-only PRs now run the normal floor (SelectionApplied): import-closure skips non-live-tree witnesses cheaply; ReadsLiveTree rows (doc-graph wall, corpus-read host-fed lenses) always run. The isolated pre-executor skip-label binary and its unreachable persistent disposition transport retired afterward; compile-clean docs-universe scoping remains independently exercised on the live floor path."

fn ci_merge_base_diff_range(policy: DiffPolicy) -> String {
  match policy.mode {
    DiffMergeBase => concat(concat(policy.base, "..."), policy.head)
    DiffTwoDot => concat(concat(policy.base, ".."), policy.head)
  }
}

fn git_fetch_script(policy: DiffPolicy) -> String {
  let parts = git_remote_ref_parts(ref: policy.base as GitRef)
  git_fetch_no_tags_shell(remote: parts.remote, ref_name: parts.ref_name, ignore_failure: true)
}

data floor_plan_entry: String = "src/v2/workflow/ci_floor_plan.dag"
data floor_plan_function: String = "gunbc_ci_floor_batches"
data plan_artifact_plan_function: String = "gunbc_ci_plan_artifact_batches"
data regen_floor_plan_function: String = "gunbc_ci_regen_floor_batches"


fn scheduler_invoke_with(spec: CiSpec, plan_function: String) -> String {
  claim_executor_run_plan_shell(
    source_roots: witness_layer_roots,
    plan_entry: floor_plan_entry,
    plan_function: plan_function,
    notice_title: Present { value: spec.notice_title },
    rooted: true
  )
}

fn scheduler_invoke(spec: CiSpec) -> String {
  scheduler_invoke_with(spec: spec, plan_function: floor_plan_function)
}

fn gunbc_ci_floor_only_script(spec: CiSpec) -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(
        concat("# ", concat(ci_documentation_only_floor_shortcut_retired_note, "\n")),
        concat(git_fetch_script(policy: spec.diff_policy), "\n")
      ),
      concat(
        concat("set +e\n", concat(scheduler_invoke(spec: spec), "\n")),
        ci_floor_stamp_merge_admission_script()
      )
    )
  )
}

data regen_floor_skip_witness_bin: String = "regen_floor_skip_witness"

data ci_regen_floor_skip_policy_note: String = "Affected-set-scoped regen admission (pull_request only): on a pull_request event, regen_floor_skip_witness intersects the merge-base diff with the [src/v1, dag] regen input closure (shared authority cli_run::regen_input_sources — the exact set regen_stage0 compiles; both the RegenVerifyGate and the SelfHostStalenessGate invoke regen_stage0, so the closure covers both). A PR diff touching none of src/v1/** (emitter source + committed stage0 outputs), v1's transitive dag import-closure, or the Cargo/toolchain build config cannot change the self-host fixed-point, so the regen step exits 0 immediately (a required step that passes because the self-host fixed-point is provably unchanged — regen runs before the floor so emitter drift fails fast, with no floor or merge-admission dependency). Empty diff / diff failure / closure failure runs regen (fail-closed). COLD CONTROL: the skip is gated to pull_request events via GITHUB_EVENT_NAME, so push-to-main and workflow_dispatch run regen UNCONDITIONALLY (no witness). A wrong closure that lets a PR wrongly skip therefore surfaces as a counted divergence on the very next merge to main — the squash-merge main-push run has an empty diff and runs regen cold, reding main if the seed is stale (a one-merge acceptance window, the discovery-flip shape). The 4-hourly falsifier does NOT run regen_stage0; the unconditional main-push regen is the cold control."

fn ci_regen_floor_skip_shortcut_script() -> String {
  concat(
    concat("# ", concat(ci_regen_floor_skip_policy_note, "\n")),
    concat(
      "if [ \"$GITHUB_EVENT_NAME\" = \"pull_request\" ]; then\n",
      concat(
        concat(
          concat("  _ci_regen_skip=$(", concat(artifact_shell_path(name: regen_floor_skip_witness_bin), " 2>/dev/null || echo run_regen)")),
          "\n  if [ \"$_ci_regen_skip\" = \"regen_not_affected_skip\" ]; then\n"
        ),
        concat(
          "      echo \"gunbc ci regen: pull_request diff does not intersect the [src/v1, dag] regen input closure — self-host fixed-point provably unchanged; skipping (push-to-main runs regen unconditionally as the cold control)\"\n",
          concat("      exit 0\n", concat("  fi\n", "fi\n"))
        )
      )
    )
  )
}

fn gunbc_ci_regen_floor_only_script(spec: CiSpec) -> String {
  concat(
    concat(ci_regen_ensure_rustfmt_path_script(), "\n"),
    concat(
      concat("ROOT=", ci_repo_root_shell(), "\n"),
      concat(
        concat(git_fetch_script(policy: spec.diff_policy), "\n"),
        concat(
          concat(ci_regen_floor_skip_shortcut_script(), "\n"),
          concat(scheduler_invoke_with(spec: spec, plan_function: regen_floor_plan_function), "\n")
        )
      )
    )
  )
}

fn gunbc_ci_regen_floor_run(spec: CiSpec) -> String {
  gunbc_ci_regen_floor_only_script(spec: spec)
}

fn gunbc_ci_workflow_run(spec: CiSpec) -> String {
  gunbc_ci_floor_only_script(spec: spec)
}

fn gunbc_ci_floor_run(spec: CiSpec) -> String {
  gunbc_ci_floor_only_script(spec: spec)
}

fn gunbc_ci_deploy_invoke(stage: DeployStage) -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    gunbc_run_shell(
      source_roots: witness_layer_roots,
      entry: stage.entry,
      function: stage.function,
      rooted: true,
      claim_run: false
    )
  )
}

data ci_heal_generated_artifact_gate_entry: String = "dag/tools/generated_artifact_gate.dag"

data ci_heal_generated_artifact_regen_function: String = "main_wet"

data ci_heal_regen_note: String = "The heal REGEN invoke: gunbc run on the generated-artifact drift gate's main_wet, which writes each committed_generated_artifacts() projection to its path (fail-closed fold — a write error stops the line, never a partial commit). Runs on the same witness_layer_roots and released gunbc binary the deploy job consumes. Idempotent by construction: on a tree already at the fixed point the writes are byte-identical, so the downstream commit-push step sees no git diff and pushes nothing — the loop terminates in one heal. That fixed point is the enforced contract of generated_artifact_drift_test.witness_committed_is_fixed_point (committed bytes == artifact_generate), so a non-terminating heal loop is unwritable while that witness stays green."

fn gunbc_ci_heal_regen_invoke() -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    gunbc_run_shell(
      source_roots: witness_layer_roots,
      entry: ci_heal_generated_artifact_gate_entry,
      function: ci_heal_generated_artifact_regen_function,
      rooted: true,
      claim_run: false
    )
  )
}

data ci_heal_commit_push_note: String = "The heal COMMIT+PUSH step: a GitHub Actions run: foreign-executor context (the shell-intent design's bootstrap/foreign-executor case that renders through bash), so the git commit/push is a hand-authored shell string like the deploy invoke and the release-bins unpack script beside it. COMMIT SCOPE IS ARTIFACT-ONLY BY CONSTRUCTION (review 41703, DESIGN §5 no-silent-widen): staging is `git add` over EXACTLY committed_generated_artifact_paths() (the registry the drift gate guards and the exact set main_wet writes) — never `git add -A`, so an incidental dirty file on the runner (checkout residue, line-ending normalization, leftover state) can never be swept into an unattended push. Each path is guarded by a `[ -e ]` existence test (ci_heal_git_add_lines): a registered artifact that is absent on this tree — e.g. one a later PR deleted while its registry row lingered (the #7121 FleetConvergeArtifact incident) — is loudly echoed and skipped, never an exit-128 `git add` pathspec error that fails the whole heal; the drift gate remains the wall for a registered-but-missing artifact, the heal just commits what main_wet actually produced. The commit fires ONLY when `git diff --cached --quiet` reports a staged change — i.e. only when main_wet actually healed a registry artifact — so a clean tree is a no-op, and the byte-idempotent fixed point makes the healed commit's own re-run a no-op that terminates the loop. The push target is the TRIGGERING branch, not hardcoded main: `git push origin HEAD:${{ github.head_ref || github.ref_name }}` resolves to the PR source branch on a pull_request and to main on a push (operator-directed 2026-07-23: heal pushes to PRs so drift is repaired on the PR branch before it reaches main). The push authenticates with the job's GITHUB_TOKEN (persisted by actions/checkout, which checked out that same branch head) and needs the job-scoped contents:write grant. Loop termination is NOT a re-run of CI on the healed commit: a push made with the workflow's GITHUB_TOKEN does NOT trigger a new workflow run (GitHub's cascade-prevention is by design), so the healed commit fires no follow-on run — termination is guaranteed instead by the byte-idempotent fixed point itself, PROVEN pre-merge by generated_artifact_drift_test.witness_committed_is_fixed_point (committed bytes == artifact_generate) with its RED control, so a second heal would be a no-op even if one were triggered (review 41782 correction: the earlier 'verified by execution on the healed commit' claim was wrong — no such run exists). The healed artifacts are re-validated by the batch-0 drift gate on the NEXT unrelated PR/push, not on the heal commit, which is correct-by-construction (it is main_wet's own output). A concurrent advance on the target branch makes the push a non-fast-forward that fails LOUDLY (never a force-push), and the next run on that branch retries. A fork PR's branch is not writable by the workflow GITHUB_TOKEN, so a fork heal push fails loudly rather than silently — fork heals are out of scope; the fleet's PR model is same-repo session branches, which are pushable."

data ci_heal_commit_push_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_spec",
    decl_name: "gunbc_ci_heal_commit_push_script",
    field: WholeDeclaration
  }
}

data ci_heal_commit_push_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: gunbc_ci_heal_commit_push_script — hand-authored git config/add/commit/push shell for the unattended generated-artifact heal, a foreign-executor (GitHub Actions run:) git transport (the same scaffold class as merge_admission_shell_emit_disposition beside it; the merge-admission GATE peer left this class in #7363 — merge_admission_ci_gate_step_disposition is now Terminal because its step renders from a typed EffectPlan whose argv derives from extdeps declarations, which is the shape this row is still waiting for); DISSOLVES WHEN the shell→intent lane models git commit/push as typed host effects on host_effect_apply (host-effect-orchestration Do-effect migration, ROADMAP shell→intent), at which point the heal's git transport is a realization handler bound to the modeled operation, not emitted bash — the regen half (main_wet) is already modeled, only the git transport awaits (the host_effect Do-effect carrier, not a command string)."

fn ci_heal_git_add_lines() -> List<String> {
  map(committed_generated_artifact_paths(), p =>
    concat("if [ -e \"", concat(p, concat("\" ]; then git add \"", concat(p, concat("\"; else echo \"chore-heal: registered generated artifact absent on this tree, not staging: ", concat(p, "\"; fi")))))))
}

fn ci_heal_shell_lines() -> List<String> {
  concat(
    [
      "git config user.name \"gunbc-ci-auto-heal\"",
      "git config user.email \"gunbc-ci-auto-heal@users.noreply.github.com\""
    ],
    concat(
      ci_heal_git_add_lines(),
      [
        "if git diff --cached --quiet; then",
        "  echo \"chore-heal: no generated-artifact drift on this tree; nothing to commit\"",
        "else",
        "  git commit -m \"chore: regenerate drifted generated artifacts (ci auto-heal)\"",
        "  git push origin HEAD:${{ github.head_ref || github.ref_name }}",
        "  echo \"chore-heal: pushed regenerated generated artifacts to the triggering branch\"",
        "fi"
      ]
    )
  )
}

fn gunbc_ci_heal_commit_push_script() -> String {
  fold(ci_heal_shell_lines(), init: "", f: fn(acc, line) { concat(acc, concat(line, "\n")) })
}
