module gunbc.repo_local_git_config

data repo_local_git_config_authority_note: String = "Repository-local Git configuration desired state for gunbc integration-policy projections (generated-file conflict policy charter, lane 2). The merge-driver definition for merge=generated-artifact and core.hooksPath are modeled facts reconciled against observed read-back — a documented manual git config command with no read-back is declared-but-unrealized configuration and does not satisfy the lane. merge.generated-artifact.driver no longer answers `true`. `true` took the ours side and exited 0, so git recorded a CLEAN merge while the other side's authority-derived bytes were dropped with no signal — the DESIGN section 5 absorbing fallback at the integration boundary, measured twice on PR #7836 against the stage0 seed. The binding now names the emitted refusing driver (gunbc.generated_artifact_merge_driver), which leaves the ours side in the worktree verbatim with no conflict markers, marks the path unmerged, and exits nonzero with the located regeneration recipe. Git invokes a low-level merge driver only when BOTH sides changed the path relative to the merge base, so the refusal fires exactly where taking either side drops the other side and adds no stop to a merge that was previously correct. It raises the class to mechanically preventable, not to structural: commit-writer admission plus regeneration receipts remain the boundary a writer cannot pass. Bindings are Ensured: reconcile upserts drift, never tears down a binding absent from desired. Read-back uses git config --local --get so a matching global/system value cannot fabricate convergence. Hook install argv and git.Core.ConfigLocal\{Get,Set\}\{,InRepo\} transport both derive from extdeps.git shape_git_config_local_* — one executable authority, cwd-relative for generated hooks and -C repo for the actuator."

type RepoLocalGitConfigMemberAt = String

type RepoLocalGitConfigBinding {
  key: String
  value: String
}

type RepoLocalGitConfigApplyReceipt {
  all_success: Bool
  first_failure: String
}

type RepoLocalGitConfigConvergedEvidence {
  upserts_applied: Int
  observed_bindings: List<RepoLocalGitConfigBinding>
}

data generated_artifact_merge_driver_key: String = "merge.generated-artifact.driver"
data generated_artifact_merge_driver_value: String = generated_artifact_merge_driver_config_value()
data core_hooks_path_key: String = "core.hooksPath"
data core_hooks_path_value: String = ".githooks"

data repo_local_git_config_converge_entry: String = "dag/gunbc/repo_local_git_config.dag"
data repo_local_git_config_converge_function: String = "converge"
data repo_local_git_config_lane2_followup_typed_readback_refusal: String = "🟡 dissolve-on: repo_local_git_config read-back — collapse absence / wrong value / read failure into RepoLocalGitConfigApplyReceipt \{ all_success, first_failure \} only; upgrade to typed refusals per charter (operator nonblocking 2026-08-01, crisp-bat-830 second-pass). Countable follow-up slice; not lane-2 PR boundary."

data repo_local_git_config_clone_setup_note: String = "One-time manual seed per clone: set core.hooksPath=.githooks (DESIGN Building & checks). Generated pre-commit/pre-push hooks then run idempotent local binding convergence on every invocation — argv derived from reconcile_install_argv (the merge.generated-artifact.driver binding and core.hooksPath re-assertion). gunbc run … repo_local_git_config converge remains the explicit actuator/CI entry. Safe degradation, and it is a real coverage bound rather than a nicety: a clone that never set hooksPath gets vanilla git text-merge for generated-artifact paths, so it gets neither the take-ours transport nor the refusing driver — a concurrent divergence there surfaces as ordinary conflict-marker text in a generated file, and the drift gate remains the CI-side guard. The merge-driver binding is not self-healed until hooks run."

fn desired_repo_local_git_config_bindings() -> List<RepoLocalGitConfigBinding> {
  [
    RepoLocalGitConfigBinding {
      key: generated_artifact_merge_driver_key,
      value: generated_artifact_merge_driver_value
    },
    RepoLocalGitConfigBinding {
      key: core_hooks_path_key,
      value: core_hooks_path_value
    }
  ]
}

fn binding_key(b: RepoLocalGitConfigBinding) -> String { b.key }
fn binding_key_eq(a: String, b: String) -> Bool { a == b }
fn binding_value_eq(a: RepoLocalGitConfigBinding, b: RepoLocalGitConfigBinding) -> Bool {
  a.value == b.value
}
fn binding_ownership(_: RepoLocalGitConfigBinding) -> Ownership? {
  Present { value: Ensured }
}

fn repo_local_git_config_reconcile(
  desired: List<RepoLocalGitConfigBinding>,
  observed: List<RepoLocalGitConfigBinding>,
) -> MembershipPlan<RepoLocalGitConfigBinding, RepoLocalGitConfigMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: binding_key,
      key_eq: binding_key_eq,
      value_eq: binding_value_eq,
      ownership_of: binding_ownership,
    ),
  )
}

fn reconcile_install_argv(binding: RepoLocalGitConfigBinding) -> List<String> {
  shape_git_config_local_argv(key: binding.key, value: binding.value)
}

// THE COMMAND FORM OF THE SAME INSTALL. The hook emitter renders one command to text and the
// actuator hands words to a transport; both now derive from extdeps.git git_config_local_set_args,
// so neither re-spells --local. The emitter previously wrapped this argv in a hand-written
// ArgvCommand record, which is the construction extdeps.exec.command's seal removes.
fn reconcile_install_command(binding: RepoLocalGitConfigBinding) -> ArgvCommand {
  git_config_local_set_command(key: binding.key, value: binding.value)
}

fn reconcile_read_back_argv(binding: RepoLocalGitConfigBinding) -> List<String> {
  shape_git_config_local_get_argv(key: binding.key)
}

fn binding_read_back_matches(binding: RepoLocalGitConfigBinding, observed_value: String) -> Bool {
  std.algebra.trim(s: observed_value) == binding.value
}

fn all_desired_bindings_read_back(observed: List<RepoLocalGitConfigBinding>) -> Bool {
  all(desired_repo_local_git_config_bindings(), desired =>
    any(observed, o => o.key == desired.key && binding_read_back_matches(binding: desired, observed_value: o.value))
  )
}

fn observed_binding(key: String, value: String) -> RepoLocalGitConfigBinding {
  RepoLocalGitConfigBinding { key: key, value: value }
}

fn repo_local_git_config_converged(observed: List<RepoLocalGitConfigBinding>) -> Bool {
  membership_write_count(plan: repo_local_git_config_reconcile(
    desired: desired_repo_local_git_config_bindings(),
    observed: observed,
  )) == 0
    && membership_removal_count(plan: repo_local_git_config_reconcile(
      desired: desired_repo_local_git_config_bindings(),
      observed: observed,
    )) == 0
    && membership_refusal_count(plan: repo_local_git_config_reconcile(
      desired: desired_repo_local_git_config_bindings(),
      observed: observed,
    )) == 0
    && all_desired_bindings_read_back(observed: observed)
}

fn observe_binding_at_repo(
  repo: std.types.FilePath,
  desired: RepoLocalGitConfigBinding,
) -> RepoLocalGitConfigBinding? {
  let result = git.Core.ConfigLocalGetInRepo(repo: repo, key: desired.key)
  if result.success && binding_read_back_matches(binding: desired, observed_value: result.value) {
    Present { value: observed_binding(key: desired.key, value: std.algebra.trim(s: result.value)) }
  } else {
    none
  }
}

fn observe_repo_local_git_config_bindings_at_repo(repo: std.types.FilePath) -> List<RepoLocalGitConfigBinding> {
  fold(
    desired_repo_local_git_config_bindings(),
    init: [],
    f: fn(acc, desired) {
      match observe_binding_at_repo(repo: repo, desired: desired) {
        Present { value: binding } => append(acc, items: [binding])
        Absent => acc
      }
    },
  )
}

fn apply_repo_local_git_config_action_at_repo(
  repo: std.types.FilePath,
  acc: RepoLocalGitConfigApplyReceipt,
  action: MemberAction<RepoLocalGitConfigBinding, RepoLocalGitConfigMemberAt>,
) -> RepoLocalGitConfigApplyReceipt {
  if !acc.all_success {
    acc
  } else {
    match action {
      MemberAdded { at: _, to: binding } => apply_repo_local_git_config_binding(repo: repo, binding: binding, acc: acc)
      MemberChanged { at: _, from: _, to: binding } => apply_repo_local_git_config_binding(repo: repo, binding: binding, acc: acc)
      _ => acc
    }
  }
}

data repo_local_git_config_write_arm_note: String = "MemberAdded and MemberChanged BOTH write, through this one fn. The arms are listed separately rather than left to the wildcard on purpose: the wildcard exists for the construction-unreachable removal arms (bindings are Ensured, so MemberRemoved/MemberRemovalRefused cannot arise — see gunbc.non_fold_residue), and a MemberChanged silently falling into it would drop exactly the drift this module exists to converge. A binding whose observed value drifted from desired is a Modified hunk, and re-setting it IS the module's job."

fn apply_repo_local_git_config_binding(
  repo: std.types.FilePath,
  binding: RepoLocalGitConfigBinding,
  acc: RepoLocalGitConfigApplyReceipt,
) -> RepoLocalGitConfigApplyReceipt {
  let result = git.Core.ConfigLocalSetInRepo(repo: repo, key: binding.key, value: binding.value)
  if result.success {
    acc
  } else {
    RepoLocalGitConfigApplyReceipt {
      all_success: false,
      first_failure: concat(
        concat("git config --local set failed for ", binding.key),
        concat(": ", result.stderr),
      ),
    }
  }
}

fn apply_repo_local_git_config_plan_at_repo(
  repo: std.types.FilePath,
  plan: MembershipPlan<RepoLocalGitConfigBinding, RepoLocalGitConfigMemberAt>,
) -> RepoLocalGitConfigApplyReceipt {
  fold(
    plan.actions,
    init: RepoLocalGitConfigApplyReceipt { all_success: true, first_failure: "" },
    f: fn(acc, action) {
      apply_repo_local_git_config_action_at_repo(repo: repo, acc: acc, action: action)
    },
  )
}

fn repo_local_git_config_converge_actuate_at(
  repo: std.types.FilePath,
) -> Reconciliation<List<RepoLocalGitConfigBinding>, RepoLocalGitConfigConvergedEvidence> {
  let desired = desired_repo_local_git_config_bindings()
  let observed_before = observe_repo_local_git_config_bindings_at_repo(repo: repo)
  let plan = repo_local_git_config_reconcile(desired: desired, observed: observed_before)
  let refusals = membership_refusal_count(plan: plan)
  if refusals > 0 {
    NotConverged {
      reason: "repo local git config reconcile emitted refusals",
      applied: desired,
    }
  } else {
    let writes = membership_write_count(plan: plan)
    let applied = if writes > 0 {
      apply_repo_local_git_config_plan_at_repo(repo: repo, plan: plan)
    } else {
      RepoLocalGitConfigApplyReceipt { all_success: true, first_failure: "" }
    }
    if !applied.all_success {
      NotConverged { reason: applied.first_failure, applied: desired }
    } else {
      let observed_after = observe_repo_local_git_config_bindings_at_repo(repo: repo)
      if repo_local_git_config_converged(observed: observed_after) {
        Converged {
          evidence: RepoLocalGitConfigConvergedEvidence {
            upserts_applied: writes,
            observed_bindings: observed_after,
          },
          applied: observed_after,
        }
      } else {
        NotConverged {
          reason: "repo local git config read-back failed after apply — local bindings absent or mismatched",
          applied: observed_after,
        }
      }
    }
  }
}

fn repo_local_git_config_converge_actuate() -> Reconciliation<List<RepoLocalGitConfigBinding>, RepoLocalGitConfigConvergedEvidence> {
  let root = git.Inspect.Toplevel()
  repo_local_git_config_converge_actuate_at(repo: root.path)
}

func converge() -> ProcessExit {
  match repo_local_git_config_converge_actuate() {
    Converged { evidence: _, applied: _ } => ExitSuccess
    NotConverged { reason: r, applied: _ } =>
      exit_failure(reason: concat("repo local git config converge refused: ", r))
  }
}
