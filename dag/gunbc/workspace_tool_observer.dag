module gunbc.workspace_tool_observer

import extdeps.shell.exec { ProcessOutputAbsent, ProcessRefused }
import std.types { String, NonEmptyStr, Timestamp }
import std.algebra { trim }
import extdeps.tools.hostname { hostname_short_read_command }
import extdeps.posix.test_utility { test_executable_command }
import gunbc.command_runner { run_shell_command_capture, ProcessOutputPresent, LocalExec, process_outcome_admitted }
import gunbc.clock_read { clock_now_probed_at }
import gunbc.auth.approval_capability { utc_instant_is_canonical, utc_instant_seconds_after }
import gunbc.runner_microvm_host_ready { FirecrackerHostStanding, observe_firecracker_host_standing_at_binary_wet, firecracker_host_ready_in_this_process }
import gunbc.runner_microvm_slot_unit { microvm_controller_vmm_binary, microvm_controller_jailer_binary }
import gunbc.hostname_allocation { canonical_hostname_for_fleet_slot }
import product.host_identity { HostIdentity }
import gunbc.build_cache_instance { RunnerSlotIdentity }

type WorkspaceToolsObserved sole_constructor { host: NonEmptyStr, observed_at: Timestamp, release_dir: NonEmptyStr, standing: FirecrackerHostStanding }
type WorkspaceToolsRead = WorkspaceToolsReady { observation: WorkspaceToolsObserved } | WorkspaceToolsUnobserved { reason: NonEmptyStr }

// This executes on the selected controller host and uses the same installed release paths as the
// runtime. Its output cannot be manufactured from a caller's readiness boolean.
fn workspace_observe_tools(release_dir: NonEmptyStr, login: NonEmptyStr) -> WorkspaceToolsRead {
  match run_shell_command_capture(command: hostname_short_read_command(), transport: LocalExec) {
    ProcessOutputPresent { text: raw_host } => if trim(s: raw_host) == "" { WorkspaceToolsUnobserved { reason: "controller host name is empty" } }
    else {
      let standing = observe_firecracker_host_standing_at_binary_wet(binary: microvm_controller_vmm_binary(release_dir: release_dir as String), login: login)
      if !firecracker_host_ready_in_this_process(standing: standing) { WorkspaceToolsUnobserved { reason: "installed controller Firecracker or current KVM access is unavailable" } }
      else if !process_outcome_admitted(outcome: run_shell_command_capture(command: test_executable_command(path: microvm_controller_jailer_binary(release_dir: release_dir as String)), transport: LocalExec)) {
        WorkspaceToolsUnobserved { reason: "installed controller jailer is not executable" }
      } else { match clock_now_probed_at() {
        Absent => WorkspaceToolsUnobserved { reason: "controller tool observation clock is unavailable" }
        Present { value: observed_time } => WorkspaceToolsReady { observation: WorkspaceToolsObserved { host: trim(s: raw_host) as NonEmptyStr, observed_at: observed_time as String, release_dir: release_dir, standing: standing } }
      } }
    }
    ProcessOutputAbsent => WorkspaceToolsUnobserved { reason: "controller host identity is unreadable" }
    ProcessRefused { exit_code: _, stderr: _ } => WorkspaceToolsUnobserved { reason: "controller host identity is unreadable" }
  }
}

// The observation carries the controller's KERNEL hostname, and the slot carries a stable identity;
// they are joined through the hostname the naming authority allocated to that identity, never by
// assuming the two spellings agree. A slot host with no allocated hostname cannot be matched, so the
// observation is refused as belonging elsewhere rather than accepted on a coincidence.
fn workspace_observation_is_slot_host(observed: NonEmptyStr, slot_host: HostIdentity) -> Bool {
  match canonical_hostname_for_fleet_slot(fleet_slot: slot_host) {
    Present { value: h } => (h as String) == (observed as String)
    Absent => false
  }
}

fn workspace_tools_refusal(observation: WorkspaceToolsObserved, slot: RunnerSlotIdentity, now: Timestamp) -> NonEmptyStr? {
  if !workspace_observation_is_slot_host(observed: observation.host, slot_host: slot.host) { Present { value: "tool observation belongs to another host" } }
  else if !utc_instant_is_canonical(t: now) || !utc_instant_is_canonical(t: observation.observed_at)
    || utc_instant_seconds_after(later: now, earlier: observation.observed_at) < 0
    || utc_instant_seconds_after(later: now, earlier: observation.observed_at) > 60 { Present { value: "controller tool observation is stale or unclocked" } }
  else { none }
}
