module gunbc.instrument_client

import std.types { String, Bool, Int, List }
import extdeps.languages.typescript.program {
  TsProgram, TsExpr, TsStmt, TsObjectField, serialize_typescript_program,
  ts_ident, ts_lit_str, ts_lit_num, ts_member, ts_call, ts_binop, ts_arrow, ts_block,
  ts_const, ts_expr_stmt, ts_if, ts_return, ts_prefix, ts_object, ts_field, ts_array,
  ts_index, ts_cond,
}
import gunbc.design.instrument_camera {
  camera_storage_key, camera_wire_sep, camera_initial,
  program_depth_key, DepthProgram, DepthOutcome, DepthFront, DepthNode, DepthEvidence,
  program_mode_key, ModeStatus, ModeRemaining, ModeWhy,
  focus_subject_key, NoSubjectSelected,
}
import gunbc.roadmap_component {
  sound_preamble_statements, sound_toggle_bind_statements, theme_toggle_bind_statements,
}

data instrument_tuner_asset_path: String = "/assets/instrument-tuner.js"

data instrument_tuner_client_note: String = "THE OPERABLE HALF OF THE V1-DELETION INSTRUMENT. The static study at /sandbox/instrument renders one server-side camera state with no client program; this asset is the declared follow-on — persistent camera in localStorage, selection parity with the production roadmap's row gestures, one-detent depth movement on wheel and arrow keys, and working depth/mode controls that drive the pre-rendered reading rows. It never writes a program fact: every mutation stays inside depth, mode and focus keys."

data instrument_subject_class: String = "instrument-subject"
data instrument_subject_selected_class: String = "instrument-subject-selected"
data instrument_reading_class: String = "instrument-reading"
data instrument_depth_btn_class: String = "instrument-depth-btn"
data instrument_mode_btn_class: String = "instrument-mode-btn"
data instrument_tuner_root_class: String = "instrument-tuner"

data js_camera_var: String = "gunbcCamera"
data js_load_camera_fn: String = "gunbcLoadCamera"
data js_save_camera_fn: String = "gunbcSaveCamera"
data js_apply_camera_fn: String = "gunbcApplyCamera"
data js_step_depth_fn: String = "gunbcStepDepth"
data js_set_mode_fn: String = "gunbcSetMode"
data js_select_subject_fn: String = "gunbcSelectSubject"
data js_clear_subject_fn: String = "gunbcClearSubjectSelection"

fn depth_keys() -> List<String> {
  [
    program_depth_key(d: DepthProgram),
    program_depth_key(d: DepthOutcome),
    program_depth_key(d: DepthFront),
    program_depth_key(d: DepthNode),
    program_depth_key(d: DepthEvidence),
  ]
}

fn mode_keys() -> List<String> {
  [
    program_mode_key(m: ModeStatus),
    program_mode_key(m: ModeRemaining),
    program_mode_key(m: ModeWhy),
  ]
}

fn ts_keys_array(keys: List<String>) -> TsExpr {
  ts_array(elements: map(keys, k => ts_lit_str(value: k)))
}

fn js_camera_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: js_camera_var), property: name)
}

fn js_reading_key_expr() -> TsExpr {
  ts_binop(
    left: ts_binop(
      left: js_camera_member(name: "depth"),
      op: "+",
      right: ts_lit_str(value: camera_wire_sep),
    ),
    op: "+",
    right: ts_binop(
      left: js_camera_member(name: "mode"),
      op: "+",
      right: ts_binop(
        left: ts_lit_str(value: camera_wire_sep),
        op: "+",
        right: js_camera_member(name: "focus"),
      ),
    ),
  )
}

fn js_query_all(class_name: String) -> TsExpr {
  ts_call(
    callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
    args: [ts_lit_str(value: join([".", class_name], ""))],
  )
}

fn js_toggle_class_on(el: String, cls: String, on: TsExpr) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: ts_member(object: ts_ident(name: el), property: "classList"), property: "toggle"),
    args: [ts_lit_str(value: cls), on],
  ))
}

fn camera_preamble_statements() -> List<TsStmt> {
  [
    ts_const(name: js_camera_var, value: ts_object(fields: [
      ts_field(key: "depth", value: ts_lit_str(value: program_depth_key(d: camera_initial.depth))),
      ts_field(key: "mode", value: ts_lit_str(value: program_mode_key(m: camera_initial.mode))),
      ts_field(key: "focus", value: ts_lit_str(value: focus_subject_key(f: camera_initial.focus))),
    ])),
    ts_const(name: "DEPTH_KEYS", value: ts_keys_array(keys: depth_keys())),
    ts_const(name: "MODE_KEYS", value: ts_keys_array(keys: mode_keys())),
    ts_const(name: js_load_camera_fn, value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_const(name: "w", value: ts_call(
        callee: ts_member(object: ts_ident(name: "localStorage"), property: "getItem"),
        args: [ts_lit_str(value: camera_storage_key)],
      )),
      ts_if(cond: ts_prefix(op: "!", expr: ts_ident(name: "w")), then: ts_return(expr: none), else_stmt: none),
      ts_const(name: "parts", value: ts_call(
        callee: ts_member(object: ts_ident(name: "w"), property: "split"),
        args: [ts_lit_str(value: camera_wire_sep)],
      )),
      ts_if(
        cond: ts_binop(
          left: ts_member(object: ts_ident(name: "parts"), property: "length"),
          op: "!==",
          right: ts_lit_num(text: "3")),
        then: ts_return(expr: none),
        else_stmt: none,
      ),
      ts_expr_stmt(expr: ts_binop(
        left: js_camera_member(name: "depth"),
        op: "=",
        right: ts_index(object: ts_ident(name: "parts"), index: ts_lit_num(text: "0")),
      )),
      ts_expr_stmt(expr: ts_binop(
        left: js_camera_member(name: "mode"),
        op: "=",
        right: ts_index(object: ts_ident(name: "parts"), index: ts_lit_num(text: "1")),
      )),
      ts_expr_stmt(expr: ts_binop(
        left: js_camera_member(name: "focus"),
        op: "=",
        right: ts_index(object: ts_ident(name: "parts"), index: ts_lit_num(text: "2")),
      )),
    ]))),
    ts_const(name: js_save_camera_fn, value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "localStorage"), property: "setItem"),
      args: [ts_lit_str(value: camera_storage_key), js_reading_key_expr()],
    )))),
    ts_const(name: js_apply_camera_fn, value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_const(name: "key", value: js_reading_key_expr()),
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: js_query_all(class_name: instrument_reading_class), property: "forEach"),
        args: [ts_arrow(params: ["r"], body: ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "r"), property: "hidden"),
          op: "=",
          right: ts_binop(
            left: ts_call(
              callee: ts_member(object: ts_ident(name: "r"), property: "getAttribute"),
              args: [ts_lit_str(value: "data-reading-key")],
            ),
            op: "!==",
            right: ts_ident(name: "key"),
          ),
        )))]),
      )),
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: js_query_all(class_name: instrument_depth_btn_class), property: "forEach"),
        args: [ts_arrow(params: ["b"], body: js_toggle_class_on(
          el: "b",
          cls: "is-active",
          on: ts_binop(
            left: ts_call(
              callee: ts_member(object: ts_ident(name: "b"), property: "getAttribute"),
              args: [ts_lit_str(value: "data-depth")],
            ),
            op: "===",
            right: js_camera_member(name: "depth"),
          ),
        ))],
      )),
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: js_query_all(class_name: instrument_mode_btn_class), property: "forEach"),
        args: [ts_arrow(params: ["b"], body: js_toggle_class_on(
          el: "b",
          cls: "is-active",
          on: ts_binop(
            left: ts_call(
              callee: ts_member(object: ts_ident(name: "b"), property: "getAttribute"),
              args: [ts_lit_str(value: "data-mode")],
            ),
            op: "===",
            right: js_camera_member(name: "mode"),
          ),
        ))],
      )),
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: js_query_all(class_name: instrument_subject_class), property: "forEach"),
        args: [ts_arrow(params: ["li"], body: ts_block(stmts: [
          ts_const(name: "k", value: ts_call(
            callee: ts_member(object: ts_ident(name: "li"), property: "getAttribute"),
            args: [ts_lit_str(value: "data-subject-key")],
          )),
          js_toggle_class_on(
            el: "li",
            cls: instrument_subject_selected_class,
            on: ts_binop(left: ts_ident(name: "k"), op: "===", right: js_camera_member(name: "focus")),
          ),
          js_toggle_class_on(
            el: "li",
            cls: "salience-focal",
            on: ts_binop(left: ts_ident(name: "k"), op: "===", right: js_camera_member(name: "focus")),
          ),
          js_toggle_class_on(
            el: "li",
            cls: "salience-supporting",
            on: ts_binop(
              left: ts_binop(
                left: js_camera_member(name: "focus"),
                op: "!==",
                right: ts_lit_str(value: focus_subject_key(f: NoSubjectSelected)),
              ),
              op: "&&",
              right: ts_binop(left: ts_ident(name: "k"), op: "!==", right: js_camera_member(name: "focus")),
            ),
          ),
        ]))],
      )),
    ]))),
    ts_const(name: js_step_depth_fn, value: ts_arrow(params: ["dir"], body: ts_block(stmts: [
      ts_const(name: "i", value: ts_call(
        callee: ts_member(object: ts_ident(name: "DEPTH_KEYS"), property: "indexOf"),
        args: [js_camera_member(name: "depth")],
      )),
      ts_if(cond: ts_binop(left: ts_ident(name: "i"), op: "<", right: ts_lit_num(text: "0")), then: ts_return(expr: none), else_stmt: none),
      ts_if(
        cond: ts_binop(
          left: ts_binop(left: ts_ident(name: "dir"), op: "===", right: ts_lit_str(value: "in")),
          op: "&&",
          right: ts_binop(
            left: ts_ident(name: "i"),
            op: "<",
            right: ts_binop(
              left: ts_member(object: ts_ident(name: "DEPTH_KEYS"), property: "length"),
              op: "-",
              right: ts_lit_num(text: "1"),
            ),
          ),
        ),
        then: ts_expr_stmt(expr: ts_binop(
          left: js_camera_member(name: "depth"),
          op: "=",
          right: ts_index(
            object: ts_ident(name: "DEPTH_KEYS"),
            index: ts_binop(left: ts_ident(name: "i"), op: "+", right: ts_lit_num(text: "1")),
          ),
        )),
        else_stmt: none,
      ),
      ts_if(
        cond: ts_binop(
          left: ts_binop(left: ts_ident(name: "dir"), op: "===", right: ts_lit_str(value: "out")),
          op: "&&",
          right: ts_binop(left: ts_ident(name: "i"), op: ">", right: ts_lit_num(text: "0")),
        ),
        then: ts_expr_stmt(expr: ts_binop(
          left: js_camera_member(name: "depth"),
          op: "=",
          right: ts_index(
            object: ts_ident(name: "DEPTH_KEYS"),
            index: ts_binop(left: ts_ident(name: "i"), op: "-", right: ts_lit_num(text: "1")),
          ),
        )),
        else_stmt: none,
      ),
      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_save_camera_fn), args: [])),
      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_apply_camera_fn), args: [])),
    ]))),
    ts_const(name: js_set_mode_fn, value: ts_arrow(params: ["m"], body: ts_block(stmts: [
      ts_expr_stmt(expr: ts_binop(left: js_camera_member(name: "mode"), op: "=", right: ts_ident(name: "m"))),
      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_save_camera_fn), args: [])),
      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_apply_camera_fn), args: [])),
    ]))),
    ts_const(name: js_clear_subject_fn, value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_expr_stmt(expr: ts_binop(
        left: js_camera_member(name: "focus"),
        op: "=",
        right: ts_lit_str(value: focus_subject_key(f: NoSubjectSelected)),
      )),
      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_save_camera_fn), args: [])),
      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_apply_camera_fn), args: [])),
    ]))),
    ts_const(name: js_select_subject_fn, value: ts_arrow(params: ["key"], body: ts_block(stmts: [
      ts_if(
        cond: ts_binop(left: js_camera_member(name: "focus"), op: "===", right: ts_ident(name: "key")),
        then: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_clear_subject_fn), args: [])),
        else_stmt: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(left: js_camera_member(name: "focus"), op: "=", right: ts_ident(name: "key"))),
          ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_save_camera_fn), args: [])),
          ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_apply_camera_fn), args: [])),
        ]),
      ),
    ]))),
  ]
}

fn instrument_control_bind_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: js_query_all(class_name: instrument_depth_btn_class), property: "forEach"),
      args: [ts_arrow(params: ["b"], body: ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_ident(name: "b"), property: "addEventListener"),
        args: [
          ts_lit_str(value: "click"),
          ts_arrow(params: [], body: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(
              left: js_camera_member(name: "depth"),
              op: "=",
              right: ts_call(
                callee: ts_member(object: ts_ident(name: "b"), property: "getAttribute"),
                args: [ts_lit_str(value: "data-depth")],
              ),
            )),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_save_camera_fn), args: [])),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_apply_camera_fn), args: [])),
          ])),
        ],
      )))]),
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: js_query_all(class_name: instrument_mode_btn_class), property: "forEach"),
      args: [ts_arrow(params: ["b"], body: ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_ident(name: "b"), property: "addEventListener"),
        args: [
          ts_lit_str(value: "click"),
          ts_arrow(params: [], body: ts_block(stmts: [
            ts_expr_stmt(expr: ts_call(
              callee: ts_ident(name: js_set_mode_fn),
              args: [ts_call(
                callee: ts_member(object: ts_ident(name: "b"), property: "getAttribute"),
                args: [ts_lit_str(value: "data-mode")],
              )],
            )),
          ])),
        ],
      )))]),
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
          args: [ts_lit_str(value: join([".", instrument_tuner_root_class], ""))],
        ),
        property: "addEventListener",
      ),
      args: [
        ts_lit_str(value: "wheel"),
        ts_arrow(params: ["e"], body: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "e"), property: "preventDefault"),
            args: [])),
          ts_expr_stmt(expr: ts_call(
            callee: ts_ident(name: js_step_depth_fn),
            args: [
              ts_cond(
                test: ts_binop(left: ts_member(object: ts_ident(name: "e"), property: "deltaY"), op: "<", right: ts_lit_num(text: "0")),
                consequent: ts_lit_str(value: "out"),
                alternate: ts_lit_str(value: "in"),
              ),
            ],
          )),
        ])),
      ],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "addEventListener"),
      args: [
        ts_lit_str(value: "keydown"),
        ts_arrow(params: ["e"], body: ts_block(stmts: [
          ts_if(
            cond: ts_binop(left: ts_member(object: ts_ident(name: "e"), property: "key"), op: "===", right: ts_lit_str(value: "Escape")),
            then: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_clear_subject_fn), args: [])),
            else_stmt: none,
          ),
          ts_if(
            cond: ts_binop(left: ts_member(object: ts_ident(name: "e"), property: "key"), op: "===", right: ts_lit_str(value: "ArrowDown")),
            then: ts_block(stmts: [
              ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "e"), property: "preventDefault"), args: [])),
              ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_step_depth_fn), args: [ts_lit_str(value: "in")])),
            ]),
            else_stmt: none,
          ),
          ts_if(
            cond: ts_binop(left: ts_member(object: ts_ident(name: "e"), property: "key"), op: "===", right: ts_lit_str(value: "ArrowUp")),
            then: ts_block(stmts: [
              ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "e"), property: "preventDefault"), args: [])),
              ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_step_depth_fn), args: [ts_lit_str(value: "out")])),
            ]),
            else_stmt: none,
          ),
        ])),
      ],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "addEventListener"),
      args: [
        ts_lit_str(value: "click"),
        ts_arrow(params: ["e"], body: ts_block(stmts: [
          ts_const(name: "t", value: ts_member(object: ts_ident(name: "e"), property: "target")),
          ts_if(
            cond: ts_binop(
              left: ts_prefix(op: "!", expr: ts_ident(name: "t")),
              op: "||",
              right: ts_prefix(op: "!", expr: ts_member(object: ts_ident(name: "t"), property: "closest"))),
            then: ts_return(expr: none),
            else_stmt: none,
          ),
          ts_if(
            cond: ts_call(
              callee: ts_member(object: ts_ident(name: "t"), property: "closest"),
              args: [ts_lit_str(value: "button, a, input, select, textarea")]),
            then: ts_return(expr: none),
            else_stmt: none,
          ),
          ts_const(name: "li", value: ts_call(
            callee: ts_member(object: ts_ident(name: "t"), property: "closest"),
            args: [ts_lit_str(value: join(["li.", instrument_subject_class], ""))],
          )),
          ts_if(cond: ts_prefix(op: "!", expr: ts_ident(name: "li")), then: ts_return(expr: none), else_stmt: none),
          ts_expr_stmt(expr: ts_call(
            callee: ts_ident(name: js_select_subject_fn),
            args: [ts_call(
              callee: ts_member(object: ts_ident(name: "li"), property: "getAttribute"),
              args: [ts_lit_str(value: "data-subject-key")],
            )],
          )),
        ])),
      ],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "addEventListener"),
      args: [
        ts_lit_str(value: "focusin"),
        ts_arrow(params: ["e"], body: ts_block(stmts: [
          ts_const(name: "t", value: ts_member(object: ts_ident(name: "e"), property: "target")),
          ts_if(
            cond: ts_binop(
              left: ts_prefix(op: "!", expr: ts_ident(name: "t")),
              op: "||",
              right: ts_prefix(op: "!", expr: ts_member(object: ts_ident(name: "t"), property: "matches"))),
            then: ts_return(expr: none),
            else_stmt: none,
          ),
          ts_if(
            cond: ts_prefix(op: "!", expr: ts_call(
              callee: ts_member(object: ts_ident(name: "t"), property: "matches"),
              args: [ts_lit_str(value: ":focus-visible")])),
            then: ts_return(expr: none),
            else_stmt: none,
          ),
          ts_const(name: "li", value: ts_call(
            callee: ts_member(object: ts_ident(name: "t"), property: "closest"),
            args: [ts_lit_str(value: join(["li.", instrument_subject_class], ""))],
          )),
          ts_if(
            cond: ts_ident(name: "li"),
            then: ts_expr_stmt(expr: ts_call(
              callee: ts_ident(name: js_select_subject_fn),
              args: [ts_call(
                callee: ts_member(object: ts_ident(name: "li"), property: "getAttribute"),
                args: [ts_lit_str(value: "data-subject-key")],
              )],
            )),
            else_stmt: none,
          ),
        ])),
      ],
    )),
  ]
}

fn instrument_tuner_client_program() -> TsProgram {
  TsProgram {
    ts_nocheck: false,
    header_lines: [
      "gunbc v1-deletion instrument tuner — emitted from gunbc.instrument_client.instrument_tuner_client_program",
      "Persistent camera, selection parity, one-detent depth movement, working controls.",
    ],
    statements: concat(
      sound_preamble_statements(),
      concat(
        camera_preamble_statements(),
        concat(
          sound_toggle_bind_statements(),
          concat(
            theme_toggle_bind_statements(),
            concat(
              instrument_control_bind_statements(),
              [
                ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_load_camera_fn), args: [])),
                ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_apply_camera_fn), args: [])),
              ],
            ),
          ),
        ),
      ),
    ),
  }
}

fn instrument_tuner_client_js_source() -> String {
  serialize_typescript_program(p: instrument_tuner_client_program())
}
