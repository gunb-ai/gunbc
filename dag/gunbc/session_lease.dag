module gunbc.session_lease





type ProcessPortScope {
  listen_port: Int
  expected_owner_label: std.types.NonEmptyStr
  expected_process_fingerprint: std.types.NonEmptyStr
}

type ProcessPortObservation
  = PortAbsent
  | PortObserved {
      observed_port: Int
      pid: Int
      cmdline: std.types.NonEmptyStr
      process_fingerprint: std.types.NonEmptyStr
    }
  | PortObservedStaleExpected {
      observed_port: Int
      pid: Int
      cmdline: std.types.NonEmptyStr
      process_fingerprint: std.types.NonEmptyStr
      stale_reason: std.types.NonEmptyStr
    }
  | PortInaccessible

type ProcessLeasePlan
  = Start
  | DrainMatchingStaleThenStart
  | RefuseForeignOwner

fn classify_process_port(
  scope: ProcessPortScope,
  obs: ProcessPortObservation,
) -> std.upsert_decision.ObservationVerdict {
  match obs {
    PortAbsent => Absent
    PortInaccessible => Inaccessible
    PortObserved {
      observed_port: port,
      pid: _,
      cmdline: _,
      process_fingerprint: fingerprint,
    } =>
      if port != scope.listen_port {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Converged
        } else {
          Conflict
        }
      }
    PortObservedStaleExpected {
      observed_port: port,
      pid: _,
      cmdline: _,
      process_fingerprint: fingerprint,
      stale_reason: _,
    } =>
      if port != scope.listen_port {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Drifted
        } else {
          Conflict
        }
      }
  }
}

fn decision_for_process_port_verdict(
  verdict: std.upsert_decision.ObservationVerdict,
) -> UpsertDecision<ProcessLeasePlan> {
  match verdict {
    Converged => Noop
    Absent => Apply { plan: Start }
    Drifted => Apply { plan: DrainMatchingStaleThenStart }
    Conflict => Refuse { reason: "foreign process owns port" as std.types.NonEmptyStr }
    Inaccessible => Refuse { reason: "port inaccessible or wrong listen port" as std.types.NonEmptyStr }
    UnknownRefused => Refuse { reason: "port observation refused" as std.types.NonEmptyStr }
  }
}

fn classify_process_port_upsert(
  scope: ProcessPortScope,
  obs: ProcessPortObservation,
) -> std.upsert_decision.UpsertClassification<ProcessLeasePlan> {
  let verdict = classify_process_port(scope: scope, obs: obs)
  std.upsert_decision.UpsertClassification {
    verdict: verdict,
    decision: decision_for_process_port_verdict(verdict: verdict),
  }
}
