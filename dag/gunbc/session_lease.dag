module gunbc.session_lease


import std.types { String, NonEmptyStr, Int, Bool }
import std.upsert_decision {
  ObservationVerdict,
  Converged,
  Absent,
  Drifted,
  Conflict,
  Inaccessible,
  UpsertDecision,
  UpsertClassification,
  Noop,
  Apply,
  Refuse,
}
type ProcessPortScope {
  listen_port: Int
  expected_owner_label: NonEmptyStr
  expected_process_fingerprint: NonEmptyStr
}

// PortObservedStaleExpected: the live process fingerprint is not the expected one.
// That is not grant expiry. Expiry of a held lease is std.temporal_effect LeaseRunningPastExpiry.
type ProcessPortObservation
  = PortAbsent
  | PortObserved {
      observed_port: Int
      pid: Int
      cmdline: NonEmptyStr
      process_fingerprint: NonEmptyStr
    }
  | PortObservedStaleExpected {
      observed_port: Int
      pid: Int
      cmdline: NonEmptyStr
      process_fingerprint: NonEmptyStr
      stale_reason: NonEmptyStr
    }
  | PortInaccessible
  | PortObservationRefused { reason: NonEmptyStr }

// A PLAN IS WHAT `Apply` EXECUTES, SO A REFUSAL IS NOT ONE. Refusing because a foreign
// process owns the port is a DECISION, and decision_for_process_port_verdict already
// answers it on the `Refuse` arm with the reason attached. Carrying a refusal here as
// well gave one fact two representations, and made `Apply { plan: RefuseForeignOwner }`
// -- execute the refusal -- a state every consumer had to answer for and no producer
// could reach.
type ProcessLeasePlan
  = Start
  | DrainMatchingStaleThenStart

// ONE total fold over the closed coproduct ProcessPortObservation is the single authority
// (classify_process_port_upsert below); this fn is its verdict projection, so there is no second
// match over the observation. PortObservationRefused keeps threading its real observe-leg refusal
// reason into the decision (decision_for_process_port_verdict only sees the verdict, which would
// erase the reason a second time).
fn classify_process_port(
  scope: ProcessPortScope,
  obs: ProcessPortObservation,
) -> ObservationVerdict {
  classify_process_port_upsert(scope: scope, obs: obs).verdict
}

fn decision_for_process_port_verdict(
  verdict: ObservationVerdict,
) -> UpsertDecision<ProcessLeasePlan> {
  match verdict {
    Converged => Noop
    Absent => Apply { plan: Start }
    Drifted => Apply { plan: DrainMatchingStaleThenStart }
    Conflict => Refuse { reason: "foreign process owns port" as NonEmptyStr }
    Inaccessible => Refuse { reason: "port inaccessible or wrong listen port" as NonEmptyStr }
    UnknownRefused => Refuse { reason: "port observation refused" as NonEmptyStr }
  }
}

// ONE total fold over the closed coproduct ProcessPortObservation (this fn) is the single
// authority for the (verdict, decision) pair; classify_process_port is a projection of it
// (.verdict), so nothing second re-discriminates the observation (DESIGN §3). Every arm returns
// the same verdict it gets today; only PortObservationRefused binds its real observe-leg refusal
// reason into the decision -- decision_for_process_port_verdict only sees the verdict, so routing
// it through there would erase the reason a second time (the split the ratchet rostered).
fn classify_process_port_upsert(
  scope: ProcessPortScope,
  obs: ProcessPortObservation,
) -> std.upsert_decision.UpsertClassification<ProcessLeasePlan> {
  match obs {
    PortAbsent =>
      UpsertClassification {
        verdict: Absent,
        decision: decision_for_process_port_verdict(verdict: Absent),
      }
    PortInaccessible =>
      UpsertClassification {
        verdict: Inaccessible,
        decision: decision_for_process_port_verdict(verdict: Inaccessible),
      }
    PortObservationRefused { reason: why } =>
      UpsertClassification { verdict: UnknownRefused, decision: Refuse { reason: why } }
    PortObserved {
      observed_port: port,
      pid: _,
      cmdline: _,
      process_fingerprint: fingerprint,
    } =>
      let verdict = if port != scope.listen_port {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Converged
        } else {
          Conflict
        }
      }
      UpsertClassification {
        verdict: verdict,
        decision: decision_for_process_port_verdict(verdict: verdict),
      }
    PortObservedStaleExpected {
      observed_port: port,
      pid: _,
      cmdline: _,
      process_fingerprint: fingerprint,
      stale_reason: _,
    } =>
      let verdict = if port != scope.listen_port {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Drifted
        } else {
          Conflict
        }
      }
      UpsertClassification {
        verdict: verdict,
        decision: decision_for_process_port_verdict(verdict: verdict),
      }
  }
}
