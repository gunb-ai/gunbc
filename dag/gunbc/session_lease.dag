module gunbc.session_lease





type ProcessPortScope {
  listen_port: Int
  expected_owner_label: std.types.NonEmptyStr
  expected_process_fingerprint: std.types.NonEmptyStr
}

type ProcessPortObservation
  = PortAbsent
  | PortObserved {
      observed_port: Int
      pid: Int
      cmdline: std.types.NonEmptyStr
      process_fingerprint: std.types.NonEmptyStr
    }
  | PortObservedStaleExpected {
      observed_port: Int
      pid: Int
      cmdline: std.types.NonEmptyStr
      process_fingerprint: std.types.NonEmptyStr
      stale_reason: std.types.NonEmptyStr
    }
  | PortInaccessible
  | PortObservationRefused { reason: std.types.NonEmptyStr }

type ProcessLeasePlan
  = Start
  | DrainMatchingStaleThenStart
  | RefuseForeignOwner

fn classify_process_port(
  scope: ProcessPortScope,
  obs: ProcessPortObservation,
) -> std.upsert_decision.ObservationVerdict {
  match obs {
    PortAbsent => std.upsert_decision.Absent
    PortInaccessible => std.upsert_decision.Inaccessible
    PortObservationRefused { reason: _ } => UnknownRefused
    PortObserved {
      observed_port: port,
      pid: _,
      cmdline: _,
      process_fingerprint: fingerprint,
    } =>
      if port != scope.listen_port {
        std.upsert_decision.Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          std.upsert_decision.Converged
        } else {
          std.upsert_decision.Conflict
        }
      }
    PortObservedStaleExpected {
      observed_port: port,
      pid: _,
      cmdline: _,
      process_fingerprint: fingerprint,
      stale_reason: _,
    } =>
      if port != scope.listen_port {
        std.upsert_decision.Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          std.upsert_decision.Drifted
        } else {
          std.upsert_decision.Conflict
        }
      }
  }
}

fn decision_for_process_port_verdict(
  verdict: std.upsert_decision.ObservationVerdict,
) -> std.upsert_decision.UpsertDecision<ProcessLeasePlan> {
  match verdict {
    std.upsert_decision.Converged => std.upsert_decision.Noop
    std.upsert_decision.Absent => std.upsert_decision.Apply { plan: Start }
    std.upsert_decision.Drifted => std.upsert_decision.Apply { plan: DrainMatchingStaleThenStart }
    std.upsert_decision.Conflict => std.upsert_decision.Refuse { reason: "foreign process owns port" as std.types.NonEmptyStr }
    std.upsert_decision.Inaccessible => std.upsert_decision.Refuse { reason: "port inaccessible or wrong listen port" as std.types.NonEmptyStr }
    UnknownRefused => std.upsert_decision.Refuse { reason: "port observation refused" as std.types.NonEmptyStr }
  }
}

// PortObservationRefused carries the real refusal reason from the observe leg (e.g. "systemctl
// is-active refused ..."); decision_for_process_port_verdict only sees the verdict, so the
// UnknownRefused arm there answers with a fixed fallback string. Threading the real reason means
// this fn cannot build the decision purely from the verdict for this one observation shape --
// routing through the verdict here would erase the reason a second time.
fn classify_process_port_upsert(
  scope: ProcessPortScope,
  obs: ProcessPortObservation,
) -> std.upsert_decision.UpsertClassification<ProcessLeasePlan> {
  let verdict = classify_process_port(scope: scope, obs: obs)
  match obs {
    PortObservationRefused { reason: why } =>
      std.upsert_decision.UpsertClassification { verdict: verdict, decision: std.upsert_decision.Refuse { reason: why } }
    _ =>
      std.upsert_decision.UpsertClassification {
        verdict: verdict,
        decision: decision_for_process_port_verdict(verdict: verdict),
      }
  }
}
