module gunbc.ci_deploy_access_emit

import std.types { String, NonEmptyStr, List, Bool }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.algebra { fold_list, any, list_map, list_flat_map }
import gunbc.fleet_posix_accounts { grounded_posix_principal_name }
import gunbc.ci_deploy_access {
  DeployAccess,
  PrivilegedCommand,
  deploy_access_refusal_prefix,
}
import extdeps.sudo.nopasswd_execute_probe {
  SudoNopasswdExecuteProbeShape,
  sudo_nopasswd_grant_list_probe_note,
}
import extdeps.access.posix_effective_principal {
  EffectivePosixPrincipalRead,
  posix_effective_principal_read_note,
}
import v2.std.orchestration {
  Pipeline,
  PipelineStep,
  Do,
  If,
  Let,
  Run,
  Predicate,
  Not,
  StrEq,
  ExitZero,
  Expr,
  ExprCmdSubst,
  FailFast,
  DiscardAll,
  DiscardOut,
}
import v2.std.collection { Absent, Present }

data deploy_access_emit_preflight_note: String = "Wave C envelope-only on #7011 realization: deploy-access preflight + roster-emitted sudoers dropin run in-script before the first mutation (apply and retract share deploy_apply_preamble_steps; retract may install the dropin on first retract-after-flip — idempotent). Bootstrap order (review 40903): principal + roster grants first, then sudoers install — no blessed-helper grant (#7011 owns tree-sync/ownership/teardown realization). Package-managed grant paths (tailscale) use sudo -l grant-list probes so a missing binary cannot masquerade as a sudoers miss (review 41039). Typed refusal prefixes match deploy_access_refusal_prefix; no absorbing fallback."

data deploy_access_emit_preflight_dissolution_trigger: String = "🟡 dissolve-on: gunbc.ci_deploy_access_emit — deploy-access preflight modeled as v2.std.orchestration Pipeline/PipelineStep (principal probe + sudo -n grant probes); DISSOLVES WHEN extdeps access/sudo typed-argv op transport and live_deploy_emit_shell_dissolution_trigger retire (bash-emit #5828 / shell-intent Phase 2 realizes preflight through typed effect-plan emit without medium-as-string concat)."

data deploy_access_emit_preflight_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_deploy_access_emit",
    decl_name: "deploy_access_emit_preflight_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data deploy_access_emit_grant_list_probe_paths: List<NonEmptyStr> = [
  "/usr/bin/tailscale",
]

data deploy_access_emit_exec_probe_refusal_suffix: String = " — privileged commands not granted (sudo -n preflight miss)"

data deploy_access_emit_grant_list_probe_refusal_suffix: String = " — privileged command not in sudoers (sudo -l preflight miss)"

fn privileged_command_uses_grant_list_probe(cmd: PrivilegedCommand) -> Bool {
  any(deploy_access_emit_grant_list_probe_paths, p => p == cmd.path)
}

fn deploy_access_emit_principal_read_script(read: EffectivePosixPrincipalRead) -> String {
  let _authority = posix_effective_principal_read_note
  let _read = read
  "whoami"
}

fn deploy_access_emit_sudo_execute_probe_script(probe: SudoNopasswdExecuteProbeShape) -> String {
  concat(
    concat(concat("sudo -n ", probe.command_path as String), " "),
    probe.check_argv as String
  )
}

fn deploy_access_emit_sudo_grant_list_probe_script(command_path: NonEmptyStr) -> String {
  let _authority = sudo_nopasswd_grant_list_probe_note
  concat("sudo -n -l ", command_path as String)
}

fn deploy_access_emit_refusal_echo_step(message: String) -> PipelineStep {
  Do {
    run: Run {
      command: join(["echo \"", message, "\""], ""),
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn deploy_access_emit_exit_1_step() -> PipelineStep {
  Do {
    run: Run { command: "exit 1", env: [], redirect: Absent, capture: Absent }
  }
}

fn deploy_access_emit_principal_probe_steps(access: DeployAccess) -> List<PipelineStep> {
  let expected = grounded_posix_principal_name(p: access.principal) as String
  let read_script = deploy_access_emit_principal_read_script(read: EffectivePosixPrincipalRead {})
  [
    Let {
      name: "_gunbc_principal",
      value: ExprCmdSubst { callee: read_script, args: [] }
    },
    If {
      cond: Not {
        inner: StrEq {
          lhs: "\"$_gunbc_principal\"",
          rhs: join(["\"", expected, "\""], "")
        }
      },
      then_: Pipeline {
        steps: [
          deploy_access_emit_refusal_echo_step(
            message: join([deploy_access_refusal_prefix, " — principal mismatch expected=", expected, " actual=$_gunbc_principal"], "")
          ),
          deploy_access_emit_exit_1_step()
        ],
        on_failure: FailFast
      },
      else_: Absent
    }
  ]
}

fn deploy_access_emit_sudo_execute_probe_step(cmd: PrivilegedCommand) -> PipelineStep {
  let probe = SudoNopasswdExecuteProbeShape { command_path: cmd.path, check_argv: cmd.check }
  If {
    cond: Not {
      inner: ExitZero {
        run: Run {
          command: deploy_access_emit_sudo_execute_probe_script(probe: probe),
          env: [],
          redirect: Present { value: DiscardOut },
          capture: Absent
        }
      }
    },
    then_: Pipeline {
      steps: [
        deploy_access_emit_refusal_echo_step(
          message: concat(deploy_access_refusal_prefix, deploy_access_emit_exec_probe_refusal_suffix)
        ),
        deploy_access_emit_exit_1_step()
      ],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn deploy_access_emit_sudo_grant_list_probe_step(cmd: PrivilegedCommand) -> PipelineStep {
  If {
    cond: Not {
      inner: ExitZero {
        run: Run {
          command: deploy_access_emit_sudo_grant_list_probe_script(command_path: cmd.path),
          env: [],
          redirect: Present { value: DiscardAll },
          capture: Absent
        }
      }
    },
    then_: Pipeline {
      steps: [
        deploy_access_emit_refusal_echo_step(
          message: concat(deploy_access_refusal_prefix, deploy_access_emit_grant_list_probe_refusal_suffix)
        ),
        deploy_access_emit_exit_1_step()
      ],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn deploy_access_emit_sudo_probe_step(cmd: PrivilegedCommand) -> PipelineStep {
  if privileged_command_uses_grant_list_probe(cmd: cmd) {
    deploy_access_emit_sudo_grant_list_probe_step(cmd: cmd)
  } else {
    deploy_access_emit_sudo_execute_probe_step(cmd: cmd)
  }
}

fn deploy_access_emit_bootstrap_probes_steps(access: DeployAccess) -> List<PipelineStep> {
  list_map(access.privileged_commands, cmd => deploy_access_emit_sudo_probe_step(cmd: cmd))
}

fn deploy_access_emit_bootstrap_preflight_steps(access: DeployAccess) -> List<PipelineStep> {
  concat(
    [
      Do {
        run: Run {
          command: concat("# ", deploy_access_emit_preflight_dissolution_trigger),
          env: [],
          redirect: Absent,
          capture: Absent
        }
      },
      Do {
        run: Run {
          command: "# deploy-access-bootstrap-preflight (principal + roster grants)",
          env: [],
          redirect: Absent,
          capture: Absent
        }
      }
    ],
    concat(
      deploy_access_emit_principal_probe_steps(access: access),
      deploy_access_emit_bootstrap_probes_steps(access: access)
    )
  )
}
