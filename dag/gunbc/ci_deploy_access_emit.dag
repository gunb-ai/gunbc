module gunbc.ci_deploy_access_emit

import std.types { String, NonEmptyStr, List, Bool }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.algebra { fold_list, filter, is_empty }
import v2.std.collection { Absent, Present, optional_absent, optional_present }
import gunbc.ci_deploy_access {
  DeployAccess,
  PrivilegedCommand,
  deploy_access_refusal_prefix,
  grounded_posix_principal_name,
}
import gunbc.host_effect_deploy_access_probe_script {
  host_effect_read_effective_posix_principal_script,
  host_effect_sudo_nopasswd_execute_probe_script,
}
import gunbc.fleet_posix_accounts {
  gunbc_deploy_privileged_helper_path,
}
import extdeps.sudo.nopasswd_execute_probe { SudoNopasswdExecuteProbeShape }
import extdeps.access.posix_effective_principal { EffectivePosixPrincipalRead }

data deploy_access_emit_preflight_note: String = "Wave C envelope-only on #7011 realization: deploy-access preflight + roster-emitted sudoers dropin run in-script before the first mutation (apply and retract share deploy_apply_preamble_shell). Bootstrap order (review 40903): principal + historical roster grants first, then sudoers install — no blessed-helper grant (#7011 owns tree-sync/ownership/teardown realization). Typed refusal prefixes match deploy_access_refusal_prefix; no absorbing fallback."

data deploy_access_emit_preflight_dissolution_trigger: String = "🟡 dissolve-on: gunbc.ci_deploy_access_emit — concat-built deploy-access preflight shell (principal probe + sudo -n grant probes); DISSOLVES WHEN host_effect_deploy_access_probe_script_dissolution_trigger and live_deploy_emit_shell_dissolution_trigger retire (bash-emit #5828 / shell-intent Phase 2 realizes preflight through typed effect-plan emit without medium-as-string concat)."

data deploy_access_emit_preflight_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_deploy_access_emit",
    decl_name: "deploy_access_emit_preflight_dissolution_trigger",
    field: WholeDeclaration,
  }
}

fn privileged_command_is_blessed_helper(cmd: PrivilegedCommand) -> Bool {
  cmd.path == gunbc_deploy_privileged_helper_path
}

fn deploy_access_bootstrap_privileged_commands(access: DeployAccess) -> List<PrivilegedCommand> {
  filter(
    access.privileged_commands,
    cmd => !privileged_command_is_blessed_helper(cmd: cmd)
  )
}

fn deploy_access_helper_privileged_command(access: DeployAccess) -> PrivilegedCommand? {
  let blessed = filter(
    access.privileged_commands,
    cmd => privileged_command_is_blessed_helper(cmd: cmd)
  )
  if is_empty(blessed) {
    optional_absent()
  } else {
    optional_present(value: blessed.first())
  }
}

fn deploy_access_emit_principal_probe_shell(access: DeployAccess) -> String {
  let expected = grounded_posix_principal_name(p: access.principal) as String
  let read_script = host_effect_read_effective_posix_principal_script(read: EffectivePosixPrincipalRead {})
  join([
    "_gunbc_principal=\"$(", read_script, ")\"\n",
    "if [ \"$_gunbc_principal\" != \"", expected, "\" ]; then\n",
    "  echo \"", deploy_access_refusal_prefix, " — principal mismatch expected=", expected, " actual=$_gunbc_principal\"\n",
    "  exit 1\n",
    "fi\n",
  ], "")
}

fn deploy_access_emit_sudo_probe_shell(cmd: PrivilegedCommand) -> String {
  let probe = SudoNopasswdExecuteProbeShape { command_path: cmd.path, check_argv: cmd.check }
  concat(
    concat(host_effect_sudo_nopasswd_execute_probe_script(probe: probe), " >/dev/null"),
    " || { echo \"", deploy_access_refusal_prefix, " — privileged commands not granted (sudo -n preflight miss)\"; exit 1; }"
  )
}

fn deploy_access_emit_bootstrap_probes_shell(access: DeployAccess) -> String {
  fold_list(
    xs: deploy_access_bootstrap_privileged_commands(access: access),
    empty: "",
    cons: (acc, cmd) =>
      if acc == "" {
        deploy_access_emit_sudo_probe_shell(cmd: cmd)
      } else {
        concat(acc, concat("\n", deploy_access_emit_sudo_probe_shell(cmd: cmd)))
      }
  )
}

fn deploy_access_emit_bootstrap_preflight_block(access: DeployAccess) -> String {
  concat(
    concat(
      concat("# deploy-access-bootstrap-preflight (principal + historical roster grants)\n", deploy_access_emit_principal_probe_shell(access: access)),
      deploy_access_emit_bootstrap_probes_shell(access: access)
    ),
    ""
  )
}

fn deploy_access_emit_helper_probe_block(access: DeployAccess) -> String {
  match deploy_access_helper_privileged_command(access: access) {
    Present { value: cmd } =>
      concat(
        concat(
          concat("# deploy-access-helper-preflight (post-install blessed helper probe)\n", deploy_access_emit_sudo_probe_shell(cmd: cmd)),
          "\n"
        ),
        concat(
          "echo \"deploy-access-preflight: PASS principal=",
          concat(grounded_posix_principal_name(p: access.principal) as String, "\"")
        )
      )
    Absent =>
      concat(
        concat("echo \"", deploy_access_refusal_prefix, " — blessed helper grant missing from roster\"\n"),
        "exit 1\n"
      )
  }
}

fn deploy_access_emit_preflight_block(access: DeployAccess) -> String {
  concat(
    deploy_access_emit_bootstrap_preflight_block(access: access),
    deploy_access_emit_helper_probe_block(access: access)
  )
}
