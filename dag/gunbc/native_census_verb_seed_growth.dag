module gunbc.native_census_verb_seed_growth

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data native_census_verb_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.cli_run.native_lane_runner",
      decl_name: "run_v2_census_verb",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.target_invocation_host",
      decl_name: "run_census_verb",
      field: WholeDeclaration
    }
  ],

  reason: "The one producer arm for every whole-corpus census (gunbc.target_binding NativeCensusVerbProducer { verb }); it replaces the per-census arms DependencyDemandCensusProducer and DeclRefCensusProducer, so a further census is a .dag verb in v2.compiler.source_root_eval plus an instrument_targets row naming it, never another Rust arm. Its host part is only what no .dag fold can do: emit and build the compiler closure through the existing prepare_emitted_compiler, spawn the built binary in the row's verb, and relay its stdout and status unjudged. Every line and the exit are decided by the verb inside the emitted binary, so the host adds no verdict. It sits in the host because a census reads the whole corpus through the emitted front end, which no interpreted .dag entry can afford.",

  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,

  trigger: "Delete these declarations when gunbc test's producer dispatch is emitted rather than hand-mirrored (the capability gunbc.target_invocation_seed_growth names for target_invocation_host as a whole) AND an emitted driver can spawn a built program and hand its stdout and status to a .dag fold, SUFFICIENT FOR EVERY NativeCensusVerbProducer ROW to run with no hand-authored producer body.",

  current_boundary: "src/v1/stage0/src/cli_run/native_lane_runner.rs run_v2_census_verb, called from src/v1/stage0/src/target_invocation_host.rs run_census_verb, behind each gunbc test label bound to a NativeCensusVerbProducer"
}
