module gunbc.required_lane_resolution_census

import std.types { String, Bool, List, Int }
import std.optional { Optional, Present, Absent }
import extdeps.languages.json.emit { serialize_json_string }

// FOR EVERY MODULE UNDER THE SOURCE ROOTS, DOES AT LEAST ONE REQUIRED LANE RESOLVE IT?
//
// DESIGN section 3 states the hazard as a warning: outside the required gate the substrate still
// refuses and nothing asks it to, so a product-layer dependent can stop resolving, stay broken,
// and let every required lane report SUCCESS. On 2026-09-20 it was the live state --
// gunbc.fleet.site_pxe_edge_converge did not resolve on main while all four required lanes were green,
// with four approvals and a place in the merge queue (gunbc#11607) -- and the question "which
// modules can do that" had no instrument, only the warning. This module is the instrument's fold:
// pure, over supplied populations, so its claims discriminate at one interface and its live
// entry (gunbc.required_lane_resolution_census_live) supplies the populations from the lanes'
// own producers.
//
// "RESOLVE" MEANS ONE THING: the module's source is in the source set the lane's compile
// transaction hands to compile_to_resolved under the Strict gate. A module named only in a
// `run:` line's argv is not resolved by that step unless the entry's closure reaches it.
//
// NOMINAL, NOT DIFF-SCOPED. The floor also seeds its subject from a run's diff, so a module a PR
// touches is resolved on THAT run. The population this census reports is the complement of what
// the lanes resolve when the diff seeds nothing -- exactly the modules a rename elsewhere can
// break without any lane noticing, which is the incident's shape.
//
// IDENTITIES ARE THE PRODUCT. The unreached population is printed by identity and every count in
// the receipt is rendered from a list the receipt also prints; nothing here is a number to be
// transcribed into prose (DESIGN section 6: name the instrument).

// One population of module identities as a compiler query answers it, or the typed reason the
// population could not be established. The live entry's three queries
// (source_root_ingest_module_identities, required_floor_nominal_subject_module_identities,
// entry_closure_module_identities) return this; the census refuses on the second arm rather than
// treating an unestablished population as empty.
type ModuleIdentityPopulation
  = ModuleIdentityPopulationObserved { modules: List<String> }
  | ModuleIdentityPopulationRefused { cause: String }

// WHAT ONE REQUIRED JOB RESOLVES, as a subject kind naming the producer that decides it.
//   FloorNominalPreparedSubject -- `claim_executor --required-ci --required-lane witnesses`: the
//     prepared subject over the gate's nominal seeds (v1_compiler.cli_run
//     required_floor_nominal_subject_seeds, assemble_prepared_subject_closure).
//   RunEntryClosure -- `gunbc run --entry <path>`: the entry's loader closure
//     (v1_compiler.cli_run load_sources_for_entry_with_pool, the call resolve_entry_graph makes).
//   ResolvesNoDagModule -- a job that compiles Rust or aggregates lane results and hands no .dag
//     source to the compiler; the reason names what it does instead.
type LaneResolutionSubject
  = FloorNominalPreparedSubject
  | RunEntryClosure { entry_path: String }
  | ResolvesNoDagModule { reason: String }

// One required job and the subjects its steps resolve. A job may carry several (the floor job
// runs the witness fold AND the drift gate); a job with none is unclassified, which the live
// entry refuses rather than reading as "resolves nothing".
type LaneResolutionRow {
  job_id: String
  subjects: List<LaneResolutionSubject>
}

// The resolved population one (job, subject) pair contributed, supplied to the fold.
type LaneResolvedPopulation {
  job_id: String
  subject: LaneResolutionSubject
  modules: List<String>
}

// ONE AUTHORED ROSTER ROW AS THE CENSUS STANDS ON IT. The roster is the authored population --
// `v2.workflow.required_floor` `required_gate_authored_modules`, the seed the deleted manual
// required-floor runner seeded its gate from. Since the floor runner was deleted and `v2-bootstrap`
// runs no witness, no required job runs any row of that roster: the loss is the declared drop
// gunbc.rung_drop v1_required_lanes_withdrawn, and this census is that drop's named re-deriver, so
// it prints the roster at identity grain instead of leaving it prose.
//   RosterRowResolvedByRequiredLane -- some required lane resolves the row's module, and `resolved_by` names the
//     (job, subject) pairs that do; NO ROW STANDS IN THIS ARM TODAY (the floor runner that seeded
//     it is deleted and no required job runs a witness), which is the point of the census.
//     RESOLUTION GRAIN: a lane's compile closure containing a module is not that module being
//     executed (DESIGN section 5: a typecheck is not a consumer), so this arm never claims execution.
//   RosterRowUnreachedByRequiredLane -- the module resolves (it is in the admitted population) and no required
//     lane resolves it. This is a member of the declared drop, printed by identity.
//   RosterRowUnresolvable -- the roster names a module the ingestion does not admit: no `.dag`
//     carries that `module` line. That is a refusal (the live entry's exit-2 arm), never a row read
//     as "unreached": a roster that can name a nonexistent module would let the declared drop
//     silently shrink to fewer rows than it authores.
type RosterRowStanding
  = RosterRowResolvedByRequiredLane { module: String, resolved_by: List<String> }
  | RosterRowUnreachedByRequiredLane { module: String }
  | RosterRowUnresolvable { module: String }

type ResolutionCensusInputs {
  admitted: List<String>
  resolved: List<LaneResolvedPopulation>
  roster: List<String>
}

type ResolutionCensus {
  admitted: List<String>
  reached: List<String>
  unreached: List<String>
  lanes: List<LaneResolvedPopulation>
  roster_rows: List<RosterRowStanding>
}

type ResolutionCensusStanding
  = ResolutionCensusHeld
  | ResolutionCensusDidNotHold { unreached: List<String> }
  | ResolutionCensusRefused { cause: String }

// THE JOIN IS AT IDENTITY GRAIN. Reached is every admitted identity some lane resolved; unreached
// is the rest, in the admitted order. A resolved identity the ingestion does not admit is not an
// admitted module and is neither reached nor unreached: the denominator is the ingestion's, not
// the union's.
//
// THE AUTHORED ROSTER IS ENUMERATED AT IDENTITY GRAIN IN THE SAME JOIN, not recounted in prose.
// Each row is judged against the SAME reached/not-reached fact as every other admitted identity
// (one answer per row, no parallel judgment a roster line could drift from), and a row naming a
// module the ingestion does not admit is unresolvable -- which the standing refuses. A roster row
// is thereby a NAMED member of the drop population gunbc.rung_drop v1_required_lanes_withdrawn:
// greppable by identity from the receipt, never a paragraph standing in for a list.
fn roster_row_standing(admitted: List<String>, resolved: List<LaneResolvedPopulation>, m: String) -> RosterRowStanding {
  let in_admitted = (admitted |> filter(x => x == m) |> count) > 0
  let resolved_by = resolved |> filter(l => (l.modules |> filter(x => x == m) |> count) > 0) |> map(l => concat(concat(l.job_id, "|"), subject_rendered(s: l.subject)))
  if !in_admitted { RosterRowUnresolvable { module: m } }
  else if (resolved_by |> count) == 0 { RosterRowUnreachedByRequiredLane { module: m } }
  else { RosterRowResolvedByRequiredLane { module: m, resolved_by: resolved_by } }
}

fn roster_row_standings(inputs: ResolutionCensusInputs) -> List<RosterRowStanding> {
  inputs.roster |> map(m => roster_row_standing(admitted: inputs.admitted, resolved: inputs.resolved, m: m))
}

fn unresolvable_roster_modules(rows: List<RosterRowStanding>) -> List<String> {
  rows |> filter(r =>
    match r {
      RosterRowUnresolvable { module: _ } => true
      RosterRowResolvedByRequiredLane { module: _, resolved_by: _ } => false
      RosterRowUnreachedByRequiredLane { module: _ } => false
    })
    |> map(r => match r {
      RosterRowUnresolvable { module: m } => m
      RosterRowResolvedByRequiredLane { module: m, resolved_by: _ } => m
      RosterRowUnreachedByRequiredLane { module: m } => m
    })
}

fn first_or_empty(xs: List<String>) -> String {
  xs |> fold(init: "", f: (acc, x) => if acc == "" { x } else { acc })
}

fn resolution_census(inputs: ResolutionCensusInputs) -> ResolutionCensus {
  let reached_by_any = inputs.resolved |> fold(init: empty_map(), f: fn(acc, lane) {
    lane.modules |> fold(init: acc, f: fn(m, x) { map_insert(m, x, true) })
  })
  let reached = inputs.admitted |> filter(x => map_contains_key(reached_by_any, x))
  let unreached = inputs.admitted |> filter(x => !map_contains_key(reached_by_any, x))
  ResolutionCensus { admitted: inputs.admitted, reached: reached, unreached: unreached, lanes: inputs.resolved, roster_rows: roster_row_standings(inputs: inputs) }
}

// A ROSTER ROW NAMING A NONEXISTENT MODULE REFUSES THE CENSUS, before the held/did-not-hold
// judgment: an authored roster that cannot be enumerated at identity grain bounds nothing, and
// reading its unresolvable rows as merely "unreached drop members" would let the declared drop
// silently lose rows. The cause names the first such row (the receipt has no rows on this arm; the
// live entry prints the cause with its exit-2).
fn resolution_census_standing(c: ResolutionCensus) -> ResolutionCensusStanding {
  let unresolvable = unresolvable_roster_modules(rows: c.roster_rows)
  if (unresolvable |> count) > 0 { ResolutionCensusRefused { cause: concat("the authored required-floor roster names module `", concat(first_or_empty(xs: unresolvable), "`, which no .dag under the source roots carries a `module` line for (the ingestion does not admit it); a roster row must name a real module")) } }
  else if (c.unreached |> count) == 0 { ResolutionCensusHeld {} } else { ResolutionCensusDidNotHold { unreached: c.unreached } }
}

fn subject_rendered(s: LaneResolutionSubject) -> String {
  match s {
    FloorNominalPreparedSubject => "floor-nominal-prepared-subject"
    RunEntryClosure { entry_path: p } => concat("run-entry-closure:", p)
    ResolvesNoDagModule { reason: _ } => "resolves-no-dag-module"
  }
}

fn json_string_list(xs: List<String>) -> String {
  concat(concat("[", xs |> map(x => serialize_json_string(s: x)) |> join(separator: ",")), "]")
}

// THE RECEIPT: one JSON object per line. A summary line whose counts are the lengths of lists
// printed beneath it; one `lane` line per (job, subject) with the identities it resolved; one
// `admitted` line per admitted identity; and one `unreached` line per unreached identity, so the
// population is greppable by identity and a consumer never has to re-derive it from a count.
// THE ADMITTED LINES EXIST TO SEPARATE TWO ABSENCES that were previously one AT POPULATION
// GRAIN: an identity with an `admitted` line and no `unreached` line is admitted and reached.
// Without the admitted lines, "resolved by a lane" and "not a module" both read as absence from
// the unreached list, and the census could not tell a green lane from a typo. What absence from
// BOTH lines MEANS for one identity is NOT left for a reader to infer -- DESIGN section 5
// refuses absence-as-evidence -- the per-identity verdict is the TYPED ARM its named producer
// prints: `claim_executor --required-ci --query-module <identity>` answers `never-admitted`
// with its evidence (the run's SHA, and the deleting commit when history proves one, derived by
// pickaxe over the module header, never hand-written), or `index-refused` when the state was
// never observed. The receipt shows the population; the query arm PRIVES the single identity.
fn census_receipt_lines(c: ResolutionCensus) -> List<String> {
  let summary = concat(concat(concat(concat(
    "{\"kind\":\"summary\",\"instrument\":\"required-lane-resolution-census\",\"admitted\":", to_string(c.admitted |> count)),
    concat(",\"reached\":", to_string(c.reached |> count))),
    concat(",\"unreached\":", to_string(c.unreached |> count))),
    concat(",\"lanes\":", concat(to_string(c.lanes |> count), "}")))
  let lane_lines = c.lanes |> map(l =>
    concat(concat(concat(concat(concat(concat(
      "{\"kind\":\"lane\",\"job_id\":", serialize_json_string(s: l.job_id)),
      ",\"subject\":"), serialize_json_string(s: subject_rendered(s: l.subject))),
      ",\"resolved\":"), to_string(l.modules |> count)),
      concat(",\"modules\":", concat(json_string_list(xs: l.modules), "}"))))
  let admitted_lines = c.admitted |> map(m => concat(concat("{\"kind\":\"admitted\",\"module\":", serialize_json_string(s: m)), "}"))
  let unreached_lines = c.unreached |> map(m => concat(concat("{\"kind\":\"unreached\",\"module\":", serialize_json_string(s: m)), "}"))
  // One `roster` line per authored row of `v2.workflow.required_floor` required_gate_authored_modules,
  // by identity, naming its standing: `resolved-by-required-lane` (with the (job|subject) lanes whose compile closure
  // contains it; resolution grain, NOT execution -- a closure is not a consumer),
  // `unreached-drop-member` (resolves; no required lane's closure reaches it -- a named member of gunbc.rung_drop
  // v1_required_lanes_withdrawn), or `unresolvable` (names a module no .dag carries; the standing
  // refuses, and the live entry exits 2 before any line is printed).
  let roster_lines = c.roster_rows |> map(r =>
    match r {
      RosterRowResolvedByRequiredLane { module: m, resolved_by: e } =>
        concat(concat(concat(concat("{\"kind\":\"roster\",\"module\":", serialize_json_string(s: m)), ",\"standing\":\"resolved-by-required-lane\",\"resolved_by\":"), json_string_list(xs: e)), "}")
      RosterRowUnreachedByRequiredLane { module: m } =>
        concat(concat("{\"kind\":\"roster\",\"module\":", serialize_json_string(s: m)), ",\"standing\":\"unreached-drop-member\"}")
      RosterRowUnresolvable { module: m } =>
        concat(concat("{\"kind\":\"roster\",\"module\":", serialize_json_string(s: m)), ",\"standing\":\"unresolvable\"}")
    })
  concat(concat(concat(concat([summary], lane_lines), admitted_lines), unreached_lines), roster_lines)
}
