module gunbc.scm_compatibility.pijul


data pijul_compatibility_binding_note: std.types.NonEmptyStr = "The Pijul R1 handler consumes Pijul's own projection decoder, channel state identity, recorded changes, dependency/context graph, graph-conflict facts, partial availability, and independent read-back assessment. Those facts remain in PijulCompatibilityReceipt. The shared target and generation handles are opaque projections only; they are not commits, refs, branches, or semantic conflict verdicts, and R0 honestly reports conditional advance as unavailable."

data pijul_compatibility_read_back_identity_note: std.types.NonEmptyStr = "A PijulCompatibilityReceipt is constructible by this handler only after pijul_assess_read_back proves that the independently decoded observation equals repository. Its common read-back handle fingerprints the decoded repository state and availability plus the observing Pijul version; the producer version never substitutes for state identity."

type PijulCompatibilityReceipt {
  target: extdeps.pijul.PijulChannelName
  generation: extdeps.pijul.PijulChannelStateIdentity
  repository: extdeps.pijul.PijulDecodedRepository
  projection: extdeps.pijul.PijulRepositoryProjection
  read_back: extdeps.pijul.PijulReadBackObservation
  advance: extdeps.pijul.PijulConditionalAdvanceCapability
}

type PijulCompatibilityRefusal
  = PijulCompatibilityDecodeRejected { cause: extdeps.pijul.PijulProjectionRefusal }
  | PijulCompatibilityTargetMissing { target: extdeps.pijul.PijulChannelName }
  | PijulCompatibilityReadBackMismatch { axis: extdeps.pijul.PijulReadBackMismatchAxis }
  | PijulCompatibilityReadBackInvalid { cause: extdeps.pijul.PijulProjectionRefusal }

type PijulCompatibilityBindingOutcome
  = PijulCompatibilityBound { receipt: PijulCompatibilityReceipt }
  | PijulCompatibilityBindingRefused { cause: PijulCompatibilityRefusal }

type PijulCompatibilityBindingOutcomeFold<R> {
  bound: fn(PijulCompatibilityReceipt) -> R
  refused: fn(PijulCompatibilityRefusal) -> R
}

fn pijul_compatibility_binding_outcome_fold<R>(
  outcome: PijulCompatibilityBindingOutcome,
  fold: PijulCompatibilityBindingOutcomeFold<R>,
) -> R {
  match outcome {
    PijulCompatibilityBound { receipt } => fold.bound(receipt)
    PijulCompatibilityBindingRefused { cause } => fold.refused(cause)
  }
}

fn pijul_compatibility_bind(
  projection: extdeps.pijul.PijulRepositoryProjection,
  target: extdeps.pijul.PijulChannelName,
  read_back: extdeps.pijul.PijulReadBackObservation,
) -> PijulCompatibilityBindingOutcome {
  match pijul_decode_projection(projection: projection) {
    PijulDecodeRefused { cause } =>
      PijulCompatibilityBindingRefused {
        cause: PijulCompatibilityDecodeRejected { cause: cause },
      }
    PijulDecoded { repository } =>
      match pijul_find_channel(
        channels: repository.state.channels,
        name: target,
      ) {
        v2.std.optional.Absent =>
          PijulCompatibilityBindingRefused {
            cause: PijulCompatibilityTargetMissing { target: target },
          }
        v2.std.optional.Present { value: channel } =>
          match pijul_assess_read_back(
            expected: projection,
            observation: read_back,
          ) {
            PijulReadBackMatches { observation: _ } =>
              PijulCompatibilityBound {
                receipt: PijulCompatibilityReceipt {
                  target: target,
                  generation: channel.state_identity,
                  repository: repository,
                  projection: projection,
                  read_back: read_back,
                  advance: pijul_r0_conditional_advance(),
                },
              }
            PijulReadBackMismatch { axis } =>
              PijulCompatibilityBindingRefused {
                cause: PijulCompatibilityReadBackMismatch { axis: axis },
              }
            PijulReadBackInvalid { cause } =>
              PijulCompatibilityBindingRefused {
                cause: PijulCompatibilityReadBackInvalid { cause: cause },
              }
          }
      }
  }
}

fn pijul_compatibility_fidelity() -> gunbc.scm_compatibility_shape.CompatibilityFidelityProfile {
  gunbc.scm_compatibility_shape.CompatibilityFidelityProfile {
    endpoint_state: CompatibilityFidelityPreserved,
    upstream_change_evidence: CompatibilityFidelityPreserved,
    native_proposal_contract: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
      cause: "Pijul recorded changes retain upstream operations and dependencies, not the native proposal's full reads/frame/ensures contract",
    },
    history: CompatibilityFidelityPreserved,
    publication: gunbc.scm_compatibility_shape.CompatibilityFidelityDowngraded {
      cause: "a Pijul channel is retained as native state, not promoted into the product publication policy",
    },
    conflict_facts: CompatibilityFidelityPreserved,
    path_and_mode: CompatibilityFidelityPreserved,
    availability: CompatibilityFidelityPreserved,
    native_identity: CompatibilityFidelityPreserved,
  }
}

fn pijul_compatibility_version_text(
  version: extdeps.pijul.PijulUpstreamVersion,
) -> std.types.NonEmptyStr {
  concat(
    to_string(version.major),
    concat(
      ".",
      concat(
        to_string(version.minor),
        concat(
          ".",
          concat(
            to_string(version.patch),
            concat("-beta.", to_string(version.beta)),
          ),
        ),
      ),
    ),
  )
}

fn pijul_compatibility_octets_identity(
  tag: std.types.NonEmptyStr,
  octets: List<std.integer.UInt8>,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: tag,
    members: octets
      |> map(octet =>
        compatibility_identity_text(
          tag: "octet",
          value: to_string(octet),
        )
      ),
  )
}

fn pijul_compatibility_bytes_identity(
  tag: std.types.NonEmptyStr,
  bytes: Bytes,
) -> std.content_hash.Fnv1a64Structural {
  pijul_compatibility_octets_identity(
    tag: tag,
    octets: bytes_octets(b: bytes),
  )
}

fn pijul_compatibility_path_identity(
  tag: std.types.NonEmptyStr,
  path: extdeps.pijul.PijulPath,
) -> std.content_hash.Fnv1a64Structural {
  pijul_compatibility_octets_identity(
    tag: tag,
    octets: path.octets,
  )
}

fn pijul_compatibility_vertex_identity(
  tag: std.types.NonEmptyStr,
  vertex: extdeps.pijul.PijulVertexId,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: tag,
    members: [
      compatibility_identity_text(
        tag: "introduced-by",
        value: vertex.introduced_by as String,
      ),
      compatibility_identity_text(
        tag: "position",
        value: to_string(vertex.position.value),
      ),
    ],
  )
}

fn pijul_compatibility_graph_vertex_identity(
  vertex: extdeps.pijul.PijulGraphVertex,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: "pijul-graph-vertex",
    members: [
      pijul_compatibility_vertex_identity(
        tag: "id",
        vertex: vertex.id,
      ),
      pijul_compatibility_bytes_identity(
        tag: "content",
        bytes: vertex.content,
      ),
    ],
  )
}

fn pijul_compatibility_edge_disposition_identity(
  disposition: extdeps.pijul.PijulEdgeDisposition,
) -> std.content_hash.Fnv1a64Structural {
  let label = match disposition {
    PijulAliveEdge => "alive"
    PijulDeletedEdge => "deleted"
  }
  compatibility_identity_text(
    tag: "pijul-edge-disposition",
    value: label,
  )
}

fn pijul_compatibility_graph_edge_identity(
  edge: extdeps.pijul.PijulGraphEdge,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: "pijul-graph-edge",
    members: [
      pijul_compatibility_vertex_identity(
        tag: "source",
        vertex: edge.source,
      ),
      pijul_compatibility_vertex_identity(
        tag: "target",
        vertex: edge.target,
      ),
      compatibility_identity_text(
        tag: "introduced-by",
        value: edge.introduced_by as String,
      ),
      pijul_compatibility_edge_disposition_identity(
        disposition: edge.disposition,
      ),
    ],
  )
}

fn pijul_compatibility_change_hashes_identity(
  tag: std.types.NonEmptyStr,
  changes: List<extdeps.pijul.PijulChangeHash>,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: tag,
    members: changes
      |> map(change =>
        compatibility_identity_text(
          tag: "change",
          value: change as String,
        )
      ),
  )
}

fn pijul_compatibility_vertices_identity(
  tag: std.types.NonEmptyStr,
  vertices: List<extdeps.pijul.PijulVertexId>,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: tag,
    members: vertices
      |> map(vertex =>
        pijul_compatibility_vertex_identity(
          tag: "vertex",
          vertex: vertex,
        )
      ),
  )
}

fn pijul_compatibility_paths_identity(
  tag: std.types.NonEmptyStr,
  paths: List<extdeps.pijul.PijulPath>,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: tag,
    members: paths
      |> map(path =>
        pijul_compatibility_path_identity(
          tag: "path",
          path: path,
        )
      ),
  )
}

fn pijul_compatibility_conflict_identity(
  conflict: extdeps.pijul.PijulConflictFact,
) -> std.content_hash.Fnv1a64Structural {
  pijul_conflict_fact_fold(
    conflict: conflict,
    fold: extdeps.pijul.PijulConflictFactFold {
      order: fn(left, right, at) {
        compatibility_identity_sequence(
          tag: "pijul-order-conflict",
          members: [
            compatibility_identity_text(
              tag: "left",
              value: left as String,
            ),
            compatibility_identity_text(
              tag: "right",
              value: right as String,
            ),
            pijul_compatibility_vertex_identity(
              tag: "at",
              vertex: at,
            ),
          ],
        )
      },
      cycle: fn(changes, vertices) {
        compatibility_identity_sequence(
          tag: "pijul-cycle-conflict",
          members: [
            pijul_compatibility_change_hashes_identity(
              tag: "changes",
              changes: changes,
            ),
            pijul_compatibility_vertices_identity(
              tag: "vertices",
              vertices: vertices,
            ),
          ],
        )
      },
      zombie: fn(introduced_by, vertex) {
        compatibility_identity_sequence(
          tag: "pijul-zombie-conflict",
          members: [
            compatibility_identity_text(
              tag: "introduced-by",
              value: introduced_by as String,
            ),
            pijul_compatibility_vertex_identity(
              tag: "vertex",
              vertex: vertex,
            ),
          ],
        )
      },
      name: fn(left, right, path) {
        compatibility_identity_sequence(
          tag: "pijul-name-conflict",
          members: [
            compatibility_identity_text(
              tag: "left",
              value: left as String,
            ),
            compatibility_identity_text(
              tag: "right",
              value: right as String,
            ),
            pijul_compatibility_path_identity(
              tag: "path",
              path: path,
            ),
          ],
        )
      },
      move: fn(changes, inode, paths) {
        compatibility_identity_sequence(
          tag: "pijul-move-conflict",
          members: [
            pijul_compatibility_change_hashes_identity(
              tag: "changes",
              changes: changes,
            ),
            compatibility_identity_text(
              tag: "inode",
              value: inode as String,
            ),
            pijul_compatibility_paths_identity(
              tag: "paths",
              paths: paths,
            ),
          ],
        )
      },
    },
  )
}

fn pijul_compatibility_tree_entry_kind_identity(
  kind: extdeps.pijul.PijulTreeEntryKind,
) -> std.content_hash.Fnv1a64Structural {
  let label = match kind {
    PijulDirectoryEntry => "directory"
    PijulFileEntry => "file"
    PijulSymlinkEntry => "symlink"
  }
  compatibility_identity_text(
    tag: "pijul-tree-entry-kind",
    value: label,
  )
}

fn pijul_compatibility_tree_entry_identity(
  entry: extdeps.pijul.PijulTreeEntry,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: "pijul-tree-entry",
    members: [
      compatibility_identity_text(
        tag: "inode",
        value: entry.inode as String,
      ),
      pijul_compatibility_path_identity(
        tag: "path",
        path: entry.path,
      ),
      pijul_compatibility_tree_entry_kind_identity(kind: entry.kind),
      compatibility_identity_text(
        tag: "introduced-by",
        value: entry.introduced_by as String,
      ),
    ],
  )
}

fn pijul_compatibility_working_copy_disposition_identity(
  disposition: extdeps.pijul.PijulWorkingCopyDisposition,
) -> std.content_hash.Fnv1a64Structural {
  let label = match disposition {
    PijulWorkingCopyClean => "clean"
    PijulWorkingCopyModified => "modified"
    PijulWorkingCopyUntracked => "untracked"
  }
  compatibility_identity_text(
    tag: "pijul-working-copy-disposition",
    value: label,
  )
}

fn pijul_compatibility_working_copy_entry_identity(
  entry: extdeps.pijul.PijulWorkingCopyEntry,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: "pijul-working-copy-entry",
    members: [
      pijul_compatibility_path_identity(
        tag: "path",
        path: entry.path,
      ),
      pijul_compatibility_bytes_identity(
        tag: "content",
        bytes: entry.content,
      ),
      pijul_compatibility_working_copy_disposition_identity(
        disposition: entry.disposition,
      ),
    ],
  )
}

fn pijul_compatibility_channel_identity(
  channel: extdeps.pijul.PijulChannel,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: "pijul-channel",
    members: [
      compatibility_identity_text(
        tag: "name",
        value: channel.name as String,
      ),
      compatibility_identity_text(
        tag: "state",
        value: channel.state_identity.state as String,
      ),
      pijul_compatibility_change_hashes_identity(
        tag: "changes",
        changes: channel.state_identity.changes
          |> sort_by(change => change as String),
      ),
    ],
  )
}

fn pijul_compatibility_availability_identity(
  availability: extdeps.pijul.PijulDecodedAvailability,
) -> std.content_hash.Fnv1a64Structural {
  match availability {
    PijulDecodedComplete =>
      compatibility_identity_sequence(
        tag: "pijul-complete",
        members: [],
      )
    PijulDecodedPartial {
      missing_changes,
      missing_vertices,
      missing_paths,
    } =>
      compatibility_identity_sequence(
        tag: "pijul-partial",
        members: [
          pijul_compatibility_change_hashes_identity(
            tag: "missing-changes",
            changes: missing_changes,
          ),
          pijul_compatibility_vertices_identity(
            tag: "missing-vertices",
            vertices: missing_vertices,
          ),
          pijul_compatibility_paths_identity(
            tag: "missing-paths",
            paths: missing_paths,
          ),
        ],
      )
  }
}

fn pijul_compatibility_observed_state_identity(
  repository: extdeps.pijul.PijulDecodedRepository,
) -> std.content_hash.Fnv1a64Structural {
  let state = repository.state
  compatibility_identity_sequence(
    tag: "pijul-readback-state-v1",
    members: [
      compatibility_identity_sequence(
        tag: "changes",
        members: state.changes
          |> map(change =>
            compatibility_identity_text(
              tag: "change",
              value: change.identity.hash as String,
            )
          ),
      ),
      compatibility_identity_sequence(
        tag: "vertices",
        members: state.pristine.vertices
          |> map(vertex =>
            pijul_compatibility_graph_vertex_identity(vertex: vertex)
          ),
      ),
      compatibility_identity_sequence(
        tag: "edges",
        members: state.pristine.edges
          |> map(edge =>
            pijul_compatibility_graph_edge_identity(edge: edge)
          ),
      ),
      compatibility_identity_sequence(
        tag: "conflicts",
        members: state.pristine.conflicts
          |> map(conflict =>
            pijul_compatibility_conflict_identity(conflict: conflict)
          ),
      ),
      compatibility_identity_sequence(
        tag: "tree",
        members: state.tree.entries
          |> map(entry =>
            pijul_compatibility_tree_entry_identity(entry: entry)
          ),
      ),
      compatibility_identity_sequence(
        tag: "working-copy",
        members: state.working_copy.entries
          |> map(entry =>
            pijul_compatibility_working_copy_entry_identity(entry: entry)
          ),
      ),
      compatibility_identity_sequence(
        tag: "channels",
        members: state.channels
          |> map(channel =>
            pijul_compatibility_channel_identity(channel: channel)
          )
          |> sort_by(identity => identity as String),
      ),
      compatibility_identity_text(
        tag: "current-channel",
        value: state.current_channel as String,
      ),
      pijul_compatibility_availability_identity(
        availability: repository.availability,
      ),
    ],
  )
}

fn pijul_compatibility_projection_receipt(
  receipt: PijulCompatibilityReceipt,
) -> gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt {
  let generation = receipt.generation.state as std.types.NonEmptyStr
  let state = pijul_compatibility_observed_state_identity(
    repository: receipt.repository,
  )
  match receipt.advance {
    PijulConditionalAdvanceUnavailable { reason } =>
      gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt {
        realization: "pijul-r0",
        target: receipt.target as std.types.NonEmptyStr,
        generation_evidence: generation,
        projection: compatibility_projection_handle(
          realization: "pijul-r0",
          state: state,
        ),
        read_back: compatibility_read_back_handle(
          realization: "pijul-r0",
          producer: pijul_compatibility_version_text(
            version: receipt.read_back.pijul_version,
          ),
          state: state,
        ),
        advance: gunbc.scm_compatibility_shape.CompatibilityAdvanceUnavailable { cause: reason },
        fidelity: pijul_compatibility_fidelity(),
      }
  }
}

fn pijul_compatibility_projection_handler(
) -> CompatibilityProjectionHandler<PijulCompatibilityReceipt> {
  gunbc.scm_compatibility_shape.CompatibilityProjectionHandler {
    project: fn(receipt) {
      pijul_compatibility_projection_receipt(receipt: receipt)
    },
  }
}
