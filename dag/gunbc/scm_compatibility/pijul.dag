module gunbc.scm_compatibility.pijul

import std.types { NonEmptyStr }
import v2.std.optional { Present, Absent }
import extdeps.pijul {
  PijulUpstreamVersion,
  PijulChannelName,
  PijulChannelStateIdentity,
  PijulRepositoryProjection,
  PijulDecodedRepository,
  PijulProjectionRefusal,
  PijulReadBackObservation,
  PijulReadBackMismatchAxis,
  PijulConditionalAdvanceCapability,
  PijulDecoded,
  PijulDecodeRefused,
  PijulReadBackMatches,
  PijulReadBackMismatch,
  PijulReadBackInvalid,
  PijulConditionalAdvanceUnavailable,
  pijul_decode_projection,
  pijul_assess_read_back,
  pijul_find_channel,
  pijul_r0_conditional_advance,
}
import gunbc.scm_compatibility_shape {
  CompatibilityProjectionReceipt,
  CompatibilityProjectionHandler,
  CompatibilityFidelityProfile,
  CompatibilityUpstreamChangeEvidenceCaptured,
  CompatibilityFidelityPreserved,
  CompatibilityFidelityDowngraded,
  CompatibilityFidelityUnavailable,
  CompatibilityAdvanceUnavailable,
}

data pijul_compatibility_binding_note: NonEmptyStr = "The Pijul R1 handler consumes Pijul's own projection decoder, channel state identity, recorded changes, dependency/context graph, graph-conflict facts, partial availability, and independent read-back assessment. Those facts remain in PijulCompatibilityReceipt. The shared target and generation handles are opaque projections only; they are not commits, refs, branches, or semantic conflict verdicts, and R0 honestly reports conditional advance as unavailable."

type PijulCompatibilityReceipt {
  target: PijulChannelName
  generation: PijulChannelStateIdentity
  repository: PijulDecodedRepository
  projection: PijulRepositoryProjection
  read_back: PijulReadBackObservation
  advance: PijulConditionalAdvanceCapability
}

type PijulCompatibilityRefusal
  = PijulCompatibilityDecodeRejected { cause: PijulProjectionRefusal }
  | PijulCompatibilityTargetMissing { target: PijulChannelName }
  | PijulCompatibilityReadBackMismatch { axis: PijulReadBackMismatchAxis }
  | PijulCompatibilityReadBackInvalid { cause: PijulProjectionRefusal }

type PijulCompatibilityBindingOutcome
  = PijulCompatibilityBound { receipt: PijulCompatibilityReceipt }
  | PijulCompatibilityBindingRefused { cause: PijulCompatibilityRefusal }

type PijulCompatibilityBindingOutcomeFold<R> {
  bound: fn(PijulCompatibilityReceipt) -> R
  refused: fn(PijulCompatibilityRefusal) -> R
}

fn pijul_compatibility_binding_outcome_fold<R>(
  outcome: PijulCompatibilityBindingOutcome,
  fold: PijulCompatibilityBindingOutcomeFold<R>,
) -> R {
  match outcome {
    PijulCompatibilityBound { receipt } => fold.bound(receipt)
    PijulCompatibilityBindingRefused { cause } => fold.refused(cause)
  }
}

fn pijul_compatibility_bind(
  projection: PijulRepositoryProjection,
  target: PijulChannelName,
  read_back: PijulReadBackObservation,
) -> PijulCompatibilityBindingOutcome {
  match pijul_decode_projection(projection: projection) {
    PijulDecodeRefused { cause } =>
      PijulCompatibilityBindingRefused {
        cause: PijulCompatibilityDecodeRejected { cause: cause },
      }
    PijulDecoded { repository } =>
      match pijul_find_channel(
        channels: repository.state.channels,
        name: target,
      ) {
        Absent =>
          PijulCompatibilityBindingRefused {
            cause: PijulCompatibilityTargetMissing { target: target },
          }
        Present { value: channel } =>
          match pijul_assess_read_back(
            expected: projection,
            observation: read_back,
          ) {
            PijulReadBackMatches { observation: _ } =>
              PijulCompatibilityBound {
                receipt: PijulCompatibilityReceipt {
                  target: target,
                  generation: channel.state_identity,
                  repository: repository,
                  projection: projection,
                  read_back: read_back,
                  advance: pijul_r0_conditional_advance(),
                },
              }
            PijulReadBackMismatch { axis } =>
              PijulCompatibilityBindingRefused {
                cause: PijulCompatibilityReadBackMismatch { axis: axis },
              }
            PijulReadBackInvalid { cause } =>
              PijulCompatibilityBindingRefused {
                cause: PijulCompatibilityReadBackInvalid { cause: cause },
              }
          }
      }
  }
}

fn pijul_compatibility_fidelity() -> CompatibilityFidelityProfile {
  CompatibilityFidelityProfile {
    endpoint_state: CompatibilityFidelityPreserved,
    upstream_change_evidence: CompatibilityFidelityPreserved,
    native_proposal_contract: CompatibilityFidelityUnavailable {
      cause: "Pijul recorded changes retain upstream operations and dependencies, not the native proposal's full reads/frame/ensures contract",
    },
    history: CompatibilityFidelityPreserved,
    publication: CompatibilityFidelityDowngraded {
      cause: "a Pijul channel is retained as native state, not promoted into the product publication policy",
    },
    conflict_facts: CompatibilityFidelityPreserved,
    path_and_mode: CompatibilityFidelityPreserved,
    availability: CompatibilityFidelityPreserved,
    native_identity: CompatibilityFidelityPreserved,
  }
}

fn pijul_compatibility_read_back_handle(
  version: PijulUpstreamVersion,
) -> NonEmptyStr {
  concat(
    "pijul-readback:",
    concat(
      to_string(version.major),
      concat(
        ".",
        concat(
          to_string(version.minor),
          concat(
            ".",
            concat(
              to_string(version.patch),
              concat("-beta.", to_string(version.beta)),
            ),
          ),
        ),
      ),
    ),
  )
}

fn pijul_compatibility_projection_receipt(
  receipt: PijulCompatibilityReceipt,
) -> CompatibilityProjectionReceipt {
  let generation = receipt.generation.state as NonEmptyStr
  match receipt.advance {
    PijulConditionalAdvanceUnavailable { reason } =>
      CompatibilityProjectionReceipt {
        realization: "pijul-r0",
        target: receipt.target as NonEmptyStr,
        generation_evidence: generation,
        capture: CompatibilityUpstreamChangeEvidenceCaptured,
        projection: concat("pijul-channel-state:", generation),
        read_back: pijul_compatibility_read_back_handle(
          version: receipt.read_back.pijul_version,
        ),
        advance: CompatibilityAdvanceUnavailable { cause: reason },
        fidelity: pijul_compatibility_fidelity(),
      }
  }
}

fn pijul_compatibility_projection_handler(
) -> CompatibilityProjectionHandler<PijulCompatibilityReceipt> {
  CompatibilityProjectionHandler {
    project: fn(receipt) {
      pijul_compatibility_projection_receipt(receipt: receipt)
    },
  }
}
