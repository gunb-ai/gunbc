module gunbc.scm_compatibility.git


data git_compatibility_binding_note: std.types.NonEmptyStr = "The Git R1 handler consumes Git's own decoded projection, independent read-back, and exact-old-OID transition model. GitObjectId, GitRefName, tree/index/worktree facts, and unsupported-boundary rows remain in GitCompatibilityReceipt; the common projection contains no Git object, ref, commit, or branch type. CompatibilityAdvanceModeled is deliberately weaker than P3's executed-and-read-back transition receipt."

type GitCompatibilityReceipt {
  target: extdeps.git.object_store.GitRefName
  generation: extdeps.git.object_store.GitObjectId
  projection: extdeps.git.object_store.GitR0Projection
  read_back: extdeps.git.object_store.GitR0ReadBackObservation
  advance: extdeps.git.object_store.GitModeledRefTransition
  unsupported: List<extdeps.git.object_store.GitR0UnsupportedBoundary>
}

type GitCompatibilityObjectPurpose
  = GitCompatibilityGenerationCommit
  | GitCompatibilityProjectionTree
  | GitCompatibilityAdvanceTarget

type GitCompatibilityRefusal
  = GitCompatibilityObjectWrongKind {
      purpose: gunbc.scm_compatibility.git.GitCompatibilityObjectPurpose,
      stored: extdeps.git.object_store.StoredObject,
    }
  | GitCompatibilityObjectPromisorUnavailable {
      purpose: gunbc.scm_compatibility.git.GitCompatibilityObjectPurpose,
      oid: extdeps.git.object_store.GitObjectId,
      promisor: std.types.NonEmptyStr,
    }
  | GitCompatibilityObjectUnexpectedlyMissing {
      purpose: gunbc.scm_compatibility.git.GitCompatibilityObjectPurpose,
      oid: extdeps.git.object_store.GitObjectId,
    }
  | GitCompatibilityObjectCorrupt {
      purpose: gunbc.scm_compatibility.git.GitCompatibilityObjectPurpose,
      oid: extdeps.git.object_store.GitObjectId,
      reason: std.types.NonEmptyStr,
    }
  | GitCompatibilityRepositoryInvalid {
      purpose: gunbc.scm_compatibility.git.GitCompatibilityObjectPurpose,
      cause: extdeps.git.object_store.GitRepositoryDecodeRefusal,
    }
  | GitCompatibilityReadBackRejected { axis: extdeps.git.object_store.GitReadBackMismatchAxis }
  | GitCompatibilityAdvanceRepositoryInvalid {
      cause: extdeps.git.object_store.GitRepositoryDecodeRefusal,
    }
  | GitCompatibilityAdvanceStale {
      name: extdeps.git.object_store.GitRefName,
      expected_old: extdeps.git.object_store.GitObjectId,
      observed: extdeps.git.object_store.GitObjectId,
    }
  | GitCompatibilityAdvanceMissing { name: extdeps.git.object_store.GitRefName }
  | GitCompatibilityAdvanceDuplicate {
      name: extdeps.git.object_store.GitRefName,
      count: std.integer.NonNegativeInt,
    }
  | GitCompatibilityAdvanceSymbolicCycle {
      name: extdeps.git.object_store.GitRefName,
      chain: List<extdeps.git.object_store.GitRefName>,
    }
  | GitCompatibilityAdvanceFormatMismatch {
      repository_format: extdeps.git.object_store.GitObjectFormat,
      oid: extdeps.git.object_store.GitObjectId,
    }
  | GitCompatibilityAdvanceTargetKindRefused {
      name: extdeps.git.object_store.GitRefName,
      oid: extdeps.git.object_store.GitObjectId,
      object_type: extdeps.git.ObjectType,
    }

type GitCompatibilityBindingOutcome
  = GitCompatibilityBound { receipt: gunbc.scm_compatibility.git.GitCompatibilityReceipt }
  | GitCompatibilityBindingRefused { cause: gunbc.scm_compatibility.git.GitCompatibilityRefusal }

type GitCompatibilityBindingOutcomeFold<R> {
  bound: fn(gunbc.scm_compatibility.git.GitCompatibilityReceipt) -> R
  refused: fn(gunbc.scm_compatibility.git.GitCompatibilityRefusal) -> R
}

fn git_compatibility_binding_outcome_fold<R>(
  outcome: gunbc.scm_compatibility.git.GitCompatibilityBindingOutcome,
  fold: gunbc.scm_compatibility.git.GitCompatibilityBindingOutcomeFold<R>,
) -> R {
  match outcome {
    GitCompatibilityBound { receipt } => fold.bound(receipt)
    GitCompatibilityBindingRefused { cause } => fold.refused(cause)
  }
}

fn git_compatibility_object_refusal(
  purpose: gunbc.scm_compatibility.git.GitCompatibilityObjectPurpose,
  lookup: extdeps.git.object_store.ObjectLookupResult,
) -> gunbc.scm_compatibility.git.GitCompatibilityRefusal {
  match lookup {
    ObjectFound { stored } =>
      GitCompatibilityObjectWrongKind {
        purpose: purpose,
        stored: stored,
      }
    ObjectPromisorUnavailable { oid, promisor } =>
      GitCompatibilityObjectPromisorUnavailable {
        purpose: purpose,
        oid: oid,
        promisor: promisor,
      }
    ObjectUnexpectedlyMissing { oid } =>
      GitCompatibilityObjectUnexpectedlyMissing {
        purpose: purpose,
        oid: oid,
      }
    ObjectCorrupt { oid, reason } =>
      GitCompatibilityObjectCorrupt {
        purpose: purpose,
        oid: oid,
        reason: reason,
      }
    ObjectRepositoryInvalid { cause } =>
      GitCompatibilityRepositoryInvalid {
        purpose: purpose,
        cause: cause,
      }
  }
}

fn git_compatibility_bind_commit(
  repository: extdeps.git.object_store.GitRepositoryState,
  tree: extdeps.git.object_store.GitObjectId,
  read_back: extdeps.git.object_store.GitR0ReadBackObservation,
  target: extdeps.git.object_store.GitRefName,
  expected_generation: extdeps.git.object_store.GitObjectId,
  proposed_generation: extdeps.git.object_store.GitObjectId,
) -> gunbc.scm_compatibility.git.GitCompatibilityBindingOutcome {
  match git_project_repository(
    repo: repository,
    tree_oid: tree,
  ) {
    GitProjected { projection } =>
      match git_verify_independent_read_back(
        projection: projection,
        observation: read_back,
      ) {
        GitReadBackVerified { observation } =>
          match git_model_update_ref_exact(
            repo: repository,
            name: target,
            new_oid: proposed_generation,
            expected_old: expected_generation,
          ) {
            GitRefTransitionModeled {
              repository: _,
              transition,
            } =>
              GitCompatibilityBound {
                receipt: gunbc.scm_compatibility.git.GitCompatibilityReceipt {
                  target: target,
                  generation: expected_generation,
                  projection: projection,
                  read_back: observation,
                  advance: transition,
                  unsupported: git_r0_unsupported_boundary,
                },
              }
            GitRefAdvanceRepositoryInvalid {
              repository: _,
              cause,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceRepositoryInvalid {
                  cause: cause,
                },
              }
            GitRefAdvanceStale {
              repository: _,
              name,
              expected_old,
              observed,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceStale {
                  name: name,
                  expected_old: expected_old,
                  observed: observed,
                },
              }
            GitRefAdvanceMissing { repository: _, name } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceMissing { name: name },
              }
            GitRefAdvanceDuplicate {
              repository: _,
              name,
              count,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceDuplicate {
                  name: name,
                  count: count,
                },
              }
            GitRefAdvanceSymbolicCycle {
              repository: _,
              name,
              chain,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceSymbolicCycle {
                  name: name,
                  chain: chain,
                },
              }
            GitRefAdvanceFormatMismatch {
              repository: _,
              repository_format,
              oid,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceFormatMismatch {
                  repository_format: repository_format,
                  oid: oid,
                },
              }
            GitRefAdvanceTargetUnavailable {
              repository: _,
              oid: _,
              lookup,
            } =>
              GitCompatibilityBindingRefused {
                cause: git_compatibility_object_refusal(
                  purpose: GitCompatibilityAdvanceTarget,
                  lookup: lookup,
                ),
              }
            GitRefAdvanceTargetKindRefused {
              repository: _,
              name,
              oid,
              object_type,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceTargetKindRefused {
                  name: name,
                  oid: oid,
                  object_type: object_type,
                },
              }
          }
        GitReadBackMismatch { axis } =>
          GitCompatibilityBindingRefused {
            cause: GitCompatibilityReadBackRejected { axis: axis },
          }
      }
    GitProjectionRefused { cause } =>
      GitCompatibilityBindingRefused {
        cause: git_compatibility_object_refusal(
          purpose: GitCompatibilityProjectionTree,
          lookup: cause,
        ),
      }
  }
}

fn git_compatibility_generation_wrong_kind(
  stored: extdeps.git.object_store.StoredObject,
) -> gunbc.scm_compatibility.git.GitCompatibilityBindingOutcome {
  GitCompatibilityBindingRefused {
    cause: GitCompatibilityObjectWrongKind {
      purpose: GitCompatibilityGenerationCommit,
      stored: stored,
    },
  }
}

fn git_compatibility_bind(
  repository: extdeps.git.object_store.GitRepositoryState,
  read_back: extdeps.git.object_store.GitR0ReadBackObservation,
  target: extdeps.git.object_store.GitRefName,
  expected_generation: extdeps.git.object_store.GitObjectId,
  proposed_generation: extdeps.git.object_store.GitObjectId,
) -> gunbc.scm_compatibility.git.GitCompatibilityBindingOutcome {
  match git_lookup_object(
    repo: repository,
    oid: expected_generation,
  ) {
    ObjectFound { stored } =>
      store_object_fold(
        object: stored.object,
        fold: extdeps.git.object_store.StoreObjectFold {
          blob: fn(_) {
            git_compatibility_generation_wrong_kind(stored: stored)
          },
          tree: fn(_) {
            git_compatibility_generation_wrong_kind(stored: stored)
          },
          commit: fn(commit) {
            git_compatibility_bind_commit(
              repository: repository,
              tree: commit.tree,
              read_back: read_back,
              target: target,
              expected_generation: expected_generation,
              proposed_generation: proposed_generation,
            )
          },
          tag: fn(_) {
            git_compatibility_generation_wrong_kind(stored: stored)
          },
        },
      )
    rejected =>
      GitCompatibilityBindingRefused {
        cause: git_compatibility_object_refusal(
          purpose: GitCompatibilityGenerationCommit,
          lookup: rejected,
        ),
      }
  }
}

fn git_compatibility_octets_identity(
  tag: std.types.NonEmptyStr,
  octets: List<std.integer.UInt8>,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: tag,
    members: octets
      |> map(octet =>
        compatibility_identity_text(
          tag: "octet",
          value: to_string(octet),
        )
      ),
  )
}

fn git_compatibility_bytes_identity(
  tag: std.types.NonEmptyStr,
  bytes: Bytes,
) -> std.content_hash.Fnv1a64Structural {
  git_compatibility_octets_identity(
    tag: tag,
    octets: bytes_octets(b: bytes),
  )
}

fn git_compatibility_object_id_identity(
  oid: extdeps.git.object_store.GitObjectId,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_text(
    tag: "git-object-id",
    value: git_object_id_wire_hex(oid: oid) as String,
  )
}

fn git_compatibility_object_format_identity(
  format: extdeps.git.object_store.GitObjectFormat,
) -> std.content_hash.Fnv1a64Structural {
  let label = match format {
    GitObjectFormatSha1 => "sha1"
    GitObjectFormatSha256 => "sha256"
  }
  compatibility_identity_text(
    tag: "git-object-format",
    value: label,
  )
}

fn git_compatibility_tree_wire_entry_identity(
  entry: extdeps.git.object_store.GitTreeWireEntry,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: "git-tree-wire-entry",
    members: [
      compatibility_identity_text(
        tag: "mode",
        value: entry.mode as String,
      ),
      compatibility_identity_text(
        tag: "object-type",
        value: entry.object_type as String,
      ),
      git_compatibility_object_id_identity(oid: entry.oid),
      git_compatibility_octets_identity(
        tag: "name",
        octets: entry.name.octets,
      ),
    ],
  )
}

fn git_compatibility_ref_target_identity(
  target: extdeps.git.object_store.RefTarget,
) -> std.content_hash.Fnv1a64Structural {
  match target {
    DirectTarget { oid } =>
      compatibility_identity_sequence(
        tag: "git-direct-target",
        members: [git_compatibility_object_id_identity(oid: oid)],
      )
    SymbolicTarget { ref_name } =>
      compatibility_identity_text(
        tag: "git-symbolic-target",
        value: ref_name as String,
      )
  }
}

fn git_compatibility_ref_identity(
  record: extdeps.git.object_store.GitRefRecord,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: "git-ref",
    members: [
      compatibility_identity_text(
        tag: "name",
        value: record.name as String,
      ),
      git_compatibility_ref_target_identity(target: record.target),
    ],
  )
}

fn git_compatibility_tree_mode_identity(
  mode: extdeps.git.object_store.GitTreeMode,
) -> std.content_hash.Fnv1a64Structural {
  let label = match mode {
    GitRegularBlobMode => "regular"
    GitExecutableBlobMode => "executable"
    GitSymlinkMode => "symlink"
    GitSubtreeMode => "subtree"
    GitlinkMode => "gitlink"
  }
  compatibility_identity_text(
    tag: "git-tree-mode",
    value: label,
  )
}

fn git_compatibility_index_stage_identity(
  stage: extdeps.git.object_store.GitIndexStage,
) -> std.content_hash.Fnv1a64Structural {
  let label = match stage {
    GitIndexStageNormal => "normal"
    GitIndexStageBase => "base"
    GitIndexStageOurs => "ours"
    GitIndexStageTheirs => "theirs"
  }
  compatibility_identity_text(
    tag: "git-index-stage",
    value: label,
  )
}

fn git_compatibility_index_entry_identity(
  entry: extdeps.git.object_store.GitIndexEntry,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: "git-index-entry",
    members: [
      git_compatibility_octets_identity(
        tag: "path",
        octets: git_path_octets(path: entry.path),
      ),
      git_compatibility_tree_mode_identity(mode: entry.mode),
      git_compatibility_object_id_identity(oid: entry.oid),
      git_compatibility_index_stage_identity(stage: entry.stage),
    ],
  )
}

fn git_compatibility_worktree_entry_identity(
  entry: extdeps.git.object_store.GitWorktreeEntry,
) -> std.content_hash.Fnv1a64Structural {
  match entry {
    GitWorktreeRegular { path, executable, content } =>
      compatibility_identity_sequence(
        tag: "git-worktree-regular",
        members: [
          git_compatibility_octets_identity(
            tag: "path",
            octets: git_path_octets(path: path),
          ),
          compatibility_identity_text(
            tag: "executable",
            value: to_string(executable),
          ),
          git_compatibility_bytes_identity(
            tag: "content",
            bytes: content,
          ),
        ],
      )
    GitWorktreeSymlink { path, target } =>
      compatibility_identity_sequence(
        tag: "git-worktree-symlink",
        members: [
          git_compatibility_octets_identity(
            tag: "path",
            octets: git_path_octets(path: path),
          ),
          git_compatibility_bytes_identity(
            tag: "target",
            bytes: target,
          ),
        ],
      )
    GitWorktreeGitlink { path, checkout } =>
      compatibility_identity_sequence(
        tag: "git-worktree-gitlink",
        members: [
          git_compatibility_octets_identity(
            tag: "path",
            octets: git_path_octets(path: path),
          ),
          git_compatibility_object_id_identity(oid: checkout),
        ],
      )
  }
}

fn git_compatibility_unavailable_identity(
  unavailable: extdeps.git.object_store.GitUnavailableObject,
) -> std.content_hash.Fnv1a64Structural {
  git_unavailable_object_fold(
    unavailable: unavailable,
    fold: extdeps.git.object_store.GitUnavailableObjectFold {
      promisor: fn(oid, promisor) {
        compatibility_identity_sequence(
          tag: "git-promisor-unavailable",
          members: [
            git_compatibility_object_id_identity(oid: oid),
            compatibility_identity_text(
              tag: "promisor",
              value: promisor as String,
            ),
          ],
        )
      },
      unexpected_missing: fn(oid) {
        compatibility_identity_sequence(
          tag: "git-unexpected-missing",
          members: [git_compatibility_object_id_identity(oid: oid)],
        )
      },
      corrupt: fn(oid, reason) {
        compatibility_identity_sequence(
          tag: "git-corrupt",
          members: [
            git_compatibility_object_id_identity(oid: oid),
            compatibility_identity_text(
              tag: "reason",
              value: reason as String,
            ),
          ],
        )
      },
    },
  )
}

fn git_compatibility_observed_state_identity(
  observation: extdeps.git.object_store.GitR0ReadBackObservation,
) -> std.content_hash.Fnv1a64Structural {
  compatibility_identity_sequence(
    tag: "git-readback-state-v1",
    members: [
      git_compatibility_object_format_identity(
        format: observation.object_format,
      ),
      git_compatibility_object_id_identity(oid: observation.tree_oid),
      compatibility_identity_sequence(
        tag: "tree-entries",
        members: observation.tree_entries
          |> map(entry =>
            git_compatibility_tree_wire_entry_identity(entry: entry)
          ),
      ),
      compatibility_identity_sequence(
        tag: "tag-oids",
        members: observation.tag_oids
          |> map(oid => git_compatibility_object_id_identity(oid: oid)),
      ),
      compatibility_identity_sequence(
        tag: "refs",
        members: observation.refs
          |> map(record => git_compatibility_ref_identity(record: record)),
      ),
      compatibility_identity_sequence(
        tag: "index",
        members: observation.index
          |> map(entry =>
            git_compatibility_index_entry_identity(entry: entry)
          ),
      ),
      compatibility_identity_sequence(
        tag: "worktree",
        members: observation.worktree
          |> map(entry =>
            git_compatibility_worktree_entry_identity(entry: entry)
          ),
      ),
      compatibility_identity_sequence(
        tag: "unavailable",
        members: observation.unavailable
          |> map(unavailable =>
            git_compatibility_unavailable_identity(
              unavailable: unavailable,
            )
          ),
      ),
    ],
  )
}

fn git_compatibility_fidelity() -> gunbc.scm_compatibility_shape.CompatibilityFidelityProfile {
  gunbc.scm_compatibility_shape.CompatibilityFidelityProfile {
    endpoint_state: CompatibilityFidelityPreserved,
    upstream_change_evidence: gunbc.scm_compatibility_shape.CompatibilityFidelityDowngraded {
      cause: "an exact Git endpoint and history do not recover an authored source operation",
    },
    native_proposal_contract: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
      cause: "ordinary Git import carries no native reads/frame/ensures proposal contract",
    },
    history: CompatibilityFidelityPreserved,
    publication: CompatibilityFidelityPreserved,
    conflict_facts: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
      cause: "R0 does not promote Git conflict presentation into semantic evidence",
    },
    path_and_mode: CompatibilityFidelityPreserved,
    availability: CompatibilityFidelityPreserved,
    native_identity: CompatibilityFidelityPreserved,
  }
}

fn git_compatibility_projection_receipt(
  receipt: gunbc.scm_compatibility.git.GitCompatibilityReceipt,
) -> gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt {
  let generation = git_object_id_wire_hex(oid: receipt.generation) as std.types.NonEmptyStr
  let state = git_compatibility_observed_state_identity(
    observation: receipt.read_back,
  )
  gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt {
    realization: "git-r0",
    target: receipt.target as std.types.NonEmptyStr,
    generation_evidence: generation,
    projection: compatibility_projection_handle(
      realization: "git-r0",
      state: state,
    ),
    read_back: compatibility_read_back_handle(
      realization: "git-r0",
      producer: receipt.read_back.git_version,
      state: state,
    ),
    advance: gunbc.scm_compatibility_shape.CompatibilityAdvanceModeled {
      guarantee: CompatibilityExactCompareAndAdvance,
    },
    fidelity: git_compatibility_fidelity(),
  }
}

fn git_compatibility_projection_handler() -> gunbc.scm_compatibility_shape.CompatibilityProjectionHandler<gunbc.scm_compatibility.git.GitCompatibilityReceipt> {
  gunbc.scm_compatibility_shape.CompatibilityProjectionHandler {
    project: fn(receipt) {
      git_compatibility_projection_receipt(receipt: receipt)
    },
  }
}
