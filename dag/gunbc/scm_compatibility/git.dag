module gunbc.scm_compatibility.git

import std.types { List, NonEmptyStr }
import std.integer { NonNegativeInt }
import extdeps.git { ObjectType }
import extdeps.git.object_store {
  GitObjectId,
  GitObjectFormat,
  GitRefName,
  GitRepositoryState,
  GitRepositoryDecodeRefusal,
  StoredObject,
  StoreObjectFold,
  ObjectLookupResult,
  GitR0Projection,
  GitR0ReadBackObservation,
  GitReadBackMismatchAxis,
  GitModeledRefTransition,
  GitR0UnsupportedBoundary,
  GitProjected,
  GitProjectionRefused,
  GitReadBackVerified,
  GitReadBackMismatch,
  GitRefTransitionModeled,
  GitRefAdvanceRepositoryInvalid,
  GitRefAdvanceStale,
  GitRefAdvanceMissing,
  GitRefAdvanceDuplicate,
  GitRefAdvanceSymbolicCycle,
  GitRefAdvanceFormatMismatch,
  GitRefAdvanceTargetUnavailable,
  GitRefAdvanceTargetKindRefused,
  ObjectFound,
  ObjectPromisorUnavailable,
  ObjectUnexpectedlyMissing,
  ObjectCorrupt,
  ObjectRepositoryInvalid,
  store_object_fold,
  git_project_repository,
  git_verify_independent_read_back,
  git_model_update_ref_exact,
  git_lookup_object,
  git_object_id_content_hash,
  git_r0_unsupported_boundary,
}
import gunbc.scm_compatibility_shape {
  CompatibilityProjectionReceipt,
  CompatibilityProjectionHandler,
  CompatibilityFidelityProfile,
  CompatibilityEndpointStateCaptured,
  CompatibilityFidelityPreserved,
  CompatibilityFidelityDowngraded,
  CompatibilityFidelityUnavailable,
  CompatibilityAdvanceModeled,
  CompatibilityExactCompareAndAdvance,
}

data git_compatibility_binding_note: NonEmptyStr = "The Git R1 handler consumes Git's own decoded projection, independent read-back, and exact-old-OID transition model. GitObjectId, GitRefName, tree/index/worktree facts, and unsupported-boundary rows remain in GitCompatibilityReceipt; the common projection contains no Git object, ref, commit, or branch type. CompatibilityAdvanceModeled is deliberately weaker than P3's executed-and-read-back transition receipt."

type GitCompatibilityReceipt {
  target: GitRefName
  generation: GitObjectId
  projection: GitR0Projection
  read_back: GitR0ReadBackObservation
  advance: GitModeledRefTransition
  unsupported: List<GitR0UnsupportedBoundary>
}

type GitCompatibilityObjectPurpose
  = GitCompatibilityGenerationCommit
  | GitCompatibilityProjectionTree
  | GitCompatibilityAdvanceTarget

type GitCompatibilityRefusal
  = GitCompatibilityObjectWrongKind {
      purpose: GitCompatibilityObjectPurpose,
      stored: StoredObject,
    }
  | GitCompatibilityObjectPromisorUnavailable {
      purpose: GitCompatibilityObjectPurpose,
      oid: GitObjectId,
      promisor: NonEmptyStr,
    }
  | GitCompatibilityObjectUnexpectedlyMissing {
      purpose: GitCompatibilityObjectPurpose,
      oid: GitObjectId,
    }
  | GitCompatibilityObjectCorrupt {
      purpose: GitCompatibilityObjectPurpose,
      oid: GitObjectId,
      reason: NonEmptyStr,
    }
  | GitCompatibilityRepositoryInvalid {
      purpose: GitCompatibilityObjectPurpose,
      cause: GitRepositoryDecodeRefusal,
    }
  | GitCompatibilityReadBackRejected { axis: GitReadBackMismatchAxis }
  | GitCompatibilityAdvanceRepositoryInvalid {
      cause: GitRepositoryDecodeRefusal,
    }
  | GitCompatibilityAdvanceStale {
      name: GitRefName,
      expected_old: GitObjectId,
      observed: GitObjectId,
    }
  | GitCompatibilityAdvanceMissing { name: GitRefName }
  | GitCompatibilityAdvanceDuplicate {
      name: GitRefName,
      count: NonNegativeInt,
    }
  | GitCompatibilityAdvanceSymbolicCycle {
      name: GitRefName,
      chain: List<GitRefName>,
    }
  | GitCompatibilityAdvanceFormatMismatch {
      repository_format: GitObjectFormat,
      oid: GitObjectId,
    }
  | GitCompatibilityAdvanceTargetKindRefused {
      name: GitRefName,
      oid: GitObjectId,
      object_type: ObjectType,
    }

type GitCompatibilityBindingOutcome
  = GitCompatibilityBound { receipt: GitCompatibilityReceipt }
  | GitCompatibilityBindingRefused { cause: GitCompatibilityRefusal }

type GitCompatibilityBindingOutcomeFold<R> {
  bound: fn(GitCompatibilityReceipt) -> R
  refused: fn(GitCompatibilityRefusal) -> R
}

fn git_compatibility_binding_outcome_fold<R>(
  outcome: GitCompatibilityBindingOutcome,
  fold: GitCompatibilityBindingOutcomeFold<R>,
) -> R {
  match outcome {
    GitCompatibilityBound { receipt } => fold.bound(receipt)
    GitCompatibilityBindingRefused { cause } => fold.refused(cause)
  }
}

fn git_compatibility_object_refusal(
  purpose: GitCompatibilityObjectPurpose,
  lookup: ObjectLookupResult,
) -> GitCompatibilityRefusal {
  match lookup {
    ObjectFound { stored } =>
      GitCompatibilityObjectWrongKind {
        purpose: purpose,
        stored: stored,
      }
    ObjectPromisorUnavailable { oid, promisor } =>
      GitCompatibilityObjectPromisorUnavailable {
        purpose: purpose,
        oid: oid,
        promisor: promisor,
      }
    ObjectUnexpectedlyMissing { oid } =>
      GitCompatibilityObjectUnexpectedlyMissing {
        purpose: purpose,
        oid: oid,
      }
    ObjectCorrupt { oid, reason } =>
      GitCompatibilityObjectCorrupt {
        purpose: purpose,
        oid: oid,
        reason: reason,
      }
    ObjectRepositoryInvalid { cause } =>
      GitCompatibilityRepositoryInvalid {
        purpose: purpose,
        cause: cause,
      }
  }
}

fn git_compatibility_bind_commit(
  repository: GitRepositoryState,
  tree: GitObjectId,
  read_back: GitR0ReadBackObservation,
  target: GitRefName,
  expected_generation: GitObjectId,
  proposed_generation: GitObjectId,
) -> GitCompatibilityBindingOutcome {
  match git_project_repository(
    repo: repository,
    tree_oid: tree,
  ) {
    GitProjected { projection } =>
      match git_verify_independent_read_back(
        projection: projection,
        observation: read_back,
      ) {
        GitReadBackVerified { observation } =>
          match git_model_update_ref_exact(
            repo: repository,
            name: target,
            new_oid: proposed_generation,
            expected_old: expected_generation,
          ) {
            GitRefTransitionModeled {
              repository: _,
              transition,
            } =>
              GitCompatibilityBound {
                receipt: GitCompatibilityReceipt {
                  target: target,
                  generation: expected_generation,
                  projection: projection,
                  read_back: observation,
                  advance: transition,
                  unsupported: git_r0_unsupported_boundary,
                },
              }
            GitRefAdvanceRepositoryInvalid {
              repository: _,
              cause,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceRepositoryInvalid {
                  cause: cause,
                },
              }
            GitRefAdvanceStale {
              repository: _,
              name,
              expected_old,
              observed,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceStale {
                  name: name,
                  expected_old: expected_old,
                  observed: observed,
                },
              }
            GitRefAdvanceMissing { repository: _, name } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceMissing { name: name },
              }
            GitRefAdvanceDuplicate {
              repository: _,
              name,
              count,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceDuplicate {
                  name: name,
                  count: count,
                },
              }
            GitRefAdvanceSymbolicCycle {
              repository: _,
              name,
              chain,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceSymbolicCycle {
                  name: name,
                  chain: chain,
                },
              }
            GitRefAdvanceFormatMismatch {
              repository: _,
              repository_format,
              oid,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceFormatMismatch {
                  repository_format: repository_format,
                  oid: oid,
                },
              }
            GitRefAdvanceTargetUnavailable {
              repository: _,
              oid: _,
              lookup,
            } =>
              GitCompatibilityBindingRefused {
                cause: git_compatibility_object_refusal(
                  purpose: GitCompatibilityAdvanceTarget,
                  lookup: lookup,
                ),
              }
            GitRefAdvanceTargetKindRefused {
              repository: _,
              name,
              oid,
              object_type,
            } =>
              GitCompatibilityBindingRefused {
                cause: GitCompatibilityAdvanceTargetKindRefused {
                  name: name,
                  oid: oid,
                  object_type: object_type,
                },
              }
          }
        GitReadBackMismatch { axis } =>
          GitCompatibilityBindingRefused {
            cause: GitCompatibilityReadBackRejected { axis: axis },
          }
      }
    GitProjectionRefused { cause } =>
      GitCompatibilityBindingRefused {
        cause: git_compatibility_object_refusal(
          purpose: GitCompatibilityProjectionTree,
          lookup: cause,
        ),
      }
  }
}

fn git_compatibility_generation_wrong_kind(
  stored: StoredObject,
) -> GitCompatibilityBindingOutcome {
  GitCompatibilityBindingRefused {
    cause: GitCompatibilityObjectWrongKind {
      purpose: GitCompatibilityGenerationCommit,
      stored: stored,
    },
  }
}

fn git_compatibility_bind(
  repository: GitRepositoryState,
  read_back: GitR0ReadBackObservation,
  target: GitRefName,
  expected_generation: GitObjectId,
  proposed_generation: GitObjectId,
) -> GitCompatibilityBindingOutcome {
  match git_lookup_object(
    repo: repository,
    oid: expected_generation,
  ) {
    ObjectFound { stored } =>
      store_object_fold(
        object: stored.object,
        fold: StoreObjectFold {
          blob: fn(_) {
            git_compatibility_generation_wrong_kind(stored: stored)
          },
          tree: fn(_) {
            git_compatibility_generation_wrong_kind(stored: stored)
          },
          commit: fn(commit) {
            git_compatibility_bind_commit(
              repository: repository,
              tree: commit.tree,
              read_back: read_back,
              target: target,
              expected_generation: expected_generation,
              proposed_generation: proposed_generation,
            )
          },
          tag: fn(_) {
            git_compatibility_generation_wrong_kind(stored: stored)
          },
        },
      )
    rejected =>
      GitCompatibilityBindingRefused {
        cause: git_compatibility_object_refusal(
          purpose: GitCompatibilityGenerationCommit,
          lookup: rejected,
        ),
      }
  }
}

fn git_compatibility_fidelity() -> CompatibilityFidelityProfile {
  CompatibilityFidelityProfile {
    endpoint_state: CompatibilityFidelityPreserved,
    upstream_change_evidence: CompatibilityFidelityDowngraded {
      cause: "an exact Git endpoint and history do not recover an authored source operation",
    },
    native_proposal_contract: CompatibilityFidelityUnavailable {
      cause: "ordinary Git import carries no native reads/frame/ensures proposal contract",
    },
    history: CompatibilityFidelityPreserved,
    publication: CompatibilityFidelityPreserved,
    conflict_facts: CompatibilityFidelityUnavailable {
      cause: "R0 does not promote Git conflict presentation into semantic evidence",
    },
    path_and_mode: CompatibilityFidelityPreserved,
    availability: CompatibilityFidelityPreserved,
    native_identity: CompatibilityFidelityPreserved,
  }
}

fn git_compatibility_projection_receipt(
  receipt: GitCompatibilityReceipt,
) -> CompatibilityProjectionReceipt {
  let generation = git_object_id_content_hash(oid: receipt.generation) as NonEmptyStr
  let projection = git_object_id_content_hash(
    oid: receipt.projection.tree_oid,
  ) as NonEmptyStr
  CompatibilityProjectionReceipt {
    realization: "git-r0",
    target: receipt.target as NonEmptyStr,
    generation_evidence: generation,
    capture: CompatibilityEndpointStateCaptured,
    projection: projection,
    read_back: concat("git-readback:", receipt.read_back.git_version),
    advance: CompatibilityAdvanceModeled {
      guarantee: CompatibilityExactCompareAndAdvance,
    },
    fidelity: git_compatibility_fidelity(),
  }
}

fn git_compatibility_projection_handler() -> CompatibilityProjectionHandler<GitCompatibilityReceipt> {
  CompatibilityProjectionHandler {
    project: fn(receipt) {
      git_compatibility_projection_receipt(receipt: receipt)
    },
  }
}
