fn sign(rn: RoadmapNode, s: Signoff) -> RoadmapNode {
  RoadmapNode {
    node: rn.node,
    line: rn.line,
    carriers: rn.carriers,
    sizing: rn.sizing,
    execution: rn.execution,
    owner: rn.owner,
    signoff: s,
  }
}

fn carrier(path: String) -> List<Pointer> {
  [Pointer { label: "authority", path: path }]
}

fn fields(
  headline: String,
  boundary: String,
  displaced_cost: String,
  first_slice: String,
  red_control: String,
  out_of_scope: String,
  handback: String
) -> TicketFields {
  TicketFields {
    headline: headline,
    brief: boundary,
    displaced_cost: displaced_cost,
    current_state: concat("Unaccepted; next executable slice: ", first_slice),
    first_slice: first_slice,
    red_control: red_control,
    out_of_scope: out_of_scope,
    handback: handback,
    updates: [],
    authored_on: "",
    last_verified_on: "",
  }
}

fn active_sized(
  id: String,
  owner: String,
  path: String,
  intricacy: Intricacy,
  volume: Volume,
  t: TicketFields
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: TicketLine { done: false, ticket: t },
    carriers: carrier(path: path),
    sizing: Sized {
      intricacy: intricacy,
      volume: volume,
      repo: "gunbc",
      acceptance: ManualAcceptance,
    },
    execution: ExecutionContractUnspecified,
    owner: owner,
    signoff: Unsigned,
  }
}

fn active(id: String, owner: String, path: String, t: TicketFields) -> RoadmapNode {
  active_sized(
    id: id,
    owner: owner,
    path: path,
    intricacy: IntricacyMedium,
    volume: VolumeMedium,
    t: t,
  )
}

fn active_small(id: String, owner: String, path: String, t: TicketFields) -> RoadmapNode {
  active_sized(
    id: id,
    owner: owner,
    path: path,
    intricacy: IntricacyLow,
    volume: VolumeSmall,
    t: t,
  )
}

fn active_large(id: String, owner: String, path: String, t: TicketFields) -> RoadmapNode {
  active_sized(
    id: id,
    owner: owner,
    path: path,
    intricacy: IntricacyHigh,
    volume: VolumeLarge,
    t: t,
  )
}

fn edge(child: String, parent: String) -> RoadmapEdge {
  RoadmapEdge { child: nid(s: child), parent: nid(s: parent) }
}

type SeedGrowthJustification {
  reason: String
  owning_dissolution_lane: RoadmapNodeId
  trigger: String
  current_boundary: String
}

fn observation_scoped_run_seed_growth_justification() -> SeedGrowthJustification {
  SeedGrowthJustification {
    reason: "Showing progress while a command runs has to reach the point where the old runner starts a program. It needs to know which piece of code was chosen, hold back error output until it can be shown in the right order, and report exactly one ending — and the rules for all of that live in the substrate, not in Rust.",
    owning_dissolution_lane: nid(s: "v1-hand-queue-drain"),
    trigger: "Move this reach-through into a described operation, then hollow out the corresponding part of the command-line tool so generated code does the work; the hand-written bridge is deleted at that point.",
    current_boundary: "dag/gunbc/observation_seed_render.dag; dag/test/claim/observation_seed_scoped_run_witness_test.dag; src/v1/stage0/src/cli_run.rs; src/v1/stage0/src/v1_interpreter.rs; src/v1/stage0/tests/scoped_run_observation.rs",
  }
}

fn caret_parse_smoke_seed_growth_justification() -> SeedGrowthJustification {
  SeedGrowthJustification {
    reason: "This old hand-written parser test predates a later change that added fields to a structure it builds. It was updated only enough to keep compiling — no new behaviour — but it is still a hand-written Rust file, so it needs to be counted rather than forgotten.",
    owning_dissolution_lane: nid(s: "v1-zero-hand-maintained-rust"),
    trigger: "Either regenerate this test from a description, or delete it once equivalent coverage exists that would still catch the same bug; then remove this row.",
    current_boundary: "src/v1/stage0/tests/caret_parse_smoke.rs",
  }
}

fn seed_growth_fields(j: SeedGrowthJustification) -> TicketFields {
  fields(
    headline: "Account for the five hand-written files that progress output still needs",
    boundary: concat(
      "Showing progress while a command runs still relies on hand-written code, in exactly these five files and no others: ",
      j.current_boundary,
    ),
    displaced_cost: concat("Why it is needed: ", j.reason),
    first_slice: concat(
      "Hand the job of deleting these files to ",
      concat(j.owning_dissolution_lane as String, ", without adding a sixth file."),
    ),
    red_control: concat(
      "Any new hand-written code for this outside those five files, or without this plan, is refused. The plan: ",
      j.trigger,
    ),
    out_of_scope: "Not a general list of hand-written files, not new progress features, and not a status report.",
    handback: concat(
      "Show that the five files are still the only ones, and carry this exact plan into ",
      j.owning_dissolution_lane as String,
    ),
  )
}

fn caret_parse_smoke_seed_growth_fields(j: SeedGrowthJustification) -> TicketFields {
  fields(
    headline: "Regenerate or delete one leftover hand-written parser test",
    boundary: concat(
      "Exactly one hand-written file is kept for now: ",
      concat(j.current_boundary, ". This adds no new test behaviour and no second hand-written file."),
    ),
    displaced_cost: concat("Why it is still here: ", j.reason),
    first_slice: concat("Do what the owning item's plan says: ", j.trigger),
    red_control: concat(
      "If the file stays hand-written without exactly one item owned by ",
      concat(
        j.owning_dissolution_lane as String,
        " tracking it, or if a second file joins it, this is refused.",
      ),
    ),
    out_of_scope: "No changes to what the test checks, to the parser, or to other hand-written files; no separate written-down list.",
    handback: concat(
      "Show the file regenerated or deleted, with equivalent coverage in place if its behaviour moved, then remove this row from ",
      j.owning_dissolution_lane as String,
    ),
  )
}

fn declared_roadmap_nodes() -> List<RoadmapNode> {
  [
    active_sized(
      id: "2-scm-git-upstream-model",
      owner: "source-intent",
      path: "docs/plans/dag-scm-design.md",
      intricacy: IntricacyHigh,
      volume: VolumeMedium,
      t: fields(
        headline: "Write down how Git really stores things",
        boundary: "Describe Git on its own terms: files, folders, commits, tags, file permissions, symlinks, links to other repositories, and how it names and finds them. Prove it by reading a small repository and writing it back unchanged.",
        displaced_cost: "If we invent a one-size-fits-all model first, it quietly drops things like executable permissions and symlinks — and every tool built on top inherits the loss.",
        first_slice: "Finish the storage description, then read one small repository and write it back unchanged.",
        red_control: "A plain file, an executable file, a symlink, a link to another repository, and a tag all stay distinguishable; writing against an out-of-date starting point refuses instead of overwriting; a missing object never reads as empty.",
        out_of_scope: "No shared source-control interface, no hosting or server work, and no guessing that a renamed file is the same file.",
        handback: "The model with citations to Git's own docs, the read/write-back receipts, the refusal receipt, and a list of anything we still cannot represent."
      )
    ),
    active_sized(
      id: "2-scm-mercurial-upstream-model",
      owner: "source-intent",
      path: "docs/plans/dag-scm-design.md",
      intricacy: IntricacyHigh,
      volume: VolumeMedium,
      t: fields(
        headline: "Write down how Mercurial really works, in its own words",
        boundary: "Describe Mercurial from its own documentation: its permanent change IDs versus the numbers local to one copy, its branches, bookmarks, tags, and its draft/published states. Use no Git vocabulary.",
        displaced_cost: "Mercurial's ideas are not Git's. Renaming them into Git words loses the differences, and a later shared design would be built on a mistranslation.",
        first_slice: "Write the description and read one small repository back out, leaving anything we cannot safely write marked unavailable.",
        red_control: "A copy-local revision number can change while the permanent change ID does not; draft, published, and hidden stay three different things; a bookmark, a named branch, and a branch tip cannot collapse into one idea.",
        out_of_scope: "No Mercurial support in the product, no shared source-control interface, and no faking missing facts from timestamps.",
        handback: "The description with citations, the read-back receipt, an explicit list of what we cannot do yet, and the differences that must survive into any later shared design."
      )
    ),
    active_sized(
      id: "2-scm-pijul-upstream-model",
      owner: "source-intent",
      path: "docs/plans/dag-scm-design.md",
      intricacy: IntricacyHigh,
      volume: VolumeMedium,
      t: fields(
        headline: "Write down how Pijul really works, in its own words",
        boundary: "Describe Pijul from its own documentation: individual changes that carry their own identity, what each change depends on, and how a channel is a set of changes rather than a pointer to the newest one.",
        displaced_cost: "Pijul does not have a 'latest commit'. Modelling it as if it does erases the thing that makes it different, and a third viewpoint is what stops us from mistaking Git's habits for universal truth.",
        first_slice: "Write the description, then apply a small set of changes, read them back, and try them in a different order.",
        red_control: "A channel cannot be reduced to one newest commit; one change keeps the same identity in two channels; applying a change whose prerequisites are missing refuses instead of applying an empty change.",
        out_of_scope: "No Pijul support in the product, no adopting its conflict rules as ours, and no shared source-control interface.",
        handback: "The description with citations, the round-trip and out-of-order receipts, and an explicit list of what we cannot do yet."
      )
    ),
    active_sized(
      id: "2-claim-indexed-evidence",
      owner: "deduction",
      path: "docs/plans/dag-scm-design.md",
      intricacy: IntricacyHigh,
      volume: VolumeMedium,
      t: fields(
        headline: "Say once what counts as evidence for a claim",
        boundary: "One shared way to record a fact, state a claim, and link evidence that supports or contradicts it — including how much a piece of evidence can prove on its own. Three existing features adopt it.",
        displaced_cost: "Right now each feature invents its own yes/no test, so a weak signal gets promoted into a confident claim. 'We stored a login' starts meaning 'the login works'.",
        first_slice: "Reuse what already exists for this, then run it through the three features that need it and check they agree.",
        red_control: "A stored login plus a failed live request supports 'we have a credential' but not 'the service is ready'; contradictory evidence stays contradictory and missing evidence stays missing, rather than the newest answer winning.",
        out_of_scope: "No source-control solver, no per-feature copy of the idea, and no treating 'we recorded this' as proof that it is true.",
        handback: "The shared model, receipts from all three features, the supports/contradicts/both/neither cases, and anything the substrate still cannot express."
      )
    ),

    active(
      id: "namespace-occurrence-transport",
      owner: "namespace",
      path: "docs/plans/namespace-unique-on-chain-operational-plan.md",
      t: fields(
        headline: "Keep track of exactly which name is which",
        boundary: "When the compiler sees a name, carry along exactly where it was written and exactly which declaration it came from. Carrying that information, not yet deciding what it means.",
        displaced_cost: "The compiler currently throws away where a name came from and then tries to reconstruct it, so two different things with the same short name can be confused.",
        first_slice: "Carry one ordinary type name and its declaration's location through the compiler without keeping a second copy of that information.",
        red_control: "Two things written in different places that happen to share a short name stay distinguishable; a missing or made-up location refuses instead of being guessed.",
        out_of_scope: "No nearest-match lookup, no falling back to 'there is only one of these anywhere', and no rules specific to one part of the compiler.",
        handback: "The working mechanism plus a test that two same-named things in different places really do stay apart."
      )
    ),
    active_large(
      id: "namespace-canonical-binding",
      owner: "namespace",
      path: "docs/plans/namespace-unique-on-chain-operational-plan.md",
      t: fields(
        headline: "Have exactly one rule decide what every name refers to",
        boundary: "Work out the candidates by looking outward from where the name was written, then call one shared decision function once. Not several mechanisms racing to answer.",
        displaced_cost: "Several lookup mechanisms exist today and they can disagree about the same name, which is how a program silently ends up meaning something other than what was written.",
        first_slice: "Route type names, value names, and function calls through the one decision function.",
        red_control: "No candidates means unresolved and two equally good candidates means ambiguous — neither quietly picks one.",
        out_of_scope: "No configuration switch between old and new behaviour, no retrying with a different rule when the first answer is unwelcome.",
        handback: "Worked examples of the unique, unresolved, ambiguous, and duplicate cases, all actually run."
      )
    ),
    active(
      id: "namespace-bound-only-consumers",
      owner: "namespace",
      path: "docs/plans/namespace-unique-on-chain-operational-plan.md",
      t: fields(
        headline: "Make the rest of the compiler use only that one answer",
        boundary: "Type checking, call lookup, and argument-count checks all read the single decided answer. When the answer is 'unresolved' or 'ambiguous', they stop rather than carrying on with a guess.",
        displaced_cost: "While parts of the compiler still do their own lookup, the one shared rule is advisory rather than authoritative.",
        first_slice: "Move one real type-checking consumer over to the single answer.",
        red_control: "Unresolved and ambiguous names stop the compiler before type checking or call lookup runs.",
        out_of_scope: "No compatibility path that quietly falls back to the old lookup.",
        handback: "The migrated consumer plus proof the old path did not run."
      )
    ),
    active_small(
      id: "namespace-v2-import-completion",
      owner: "namespace",
      path: "docs/plans/namespace-unique-on-chain-operational-plan.md",
      t: fields(
        headline: "Do the same for imports",
        boundary: "Every place the newer compiler resolves an import or a dotted name reads the single decided answer, before the old mechanisms are deleted.",
        displaced_cost: "If imports are left behind, they become a second source of truth about what a name means — exactly the problem this whole chain exists to remove.",
        first_slice: "Move the remaining import resolution over.",
        red_control: "An import that bypasses the single answer is flagged by the inventory.",
        out_of_scope: "No new precedence rules and no compatibility lookup.",
        handback: "The complete inventory of import consumers plus a run showing an ambiguous import refuses."
      )
    ),
    active_small(
      id: "namespace-legacy-choice-retirement",
      owner: "namespace",
      path: "docs/plans/namespace-unique-on-chain-operational-plan.md",
      t: fields(
        headline: "Delete every other way of deciding what a name means",
        boundary: "Once all ordinary consumers use the one rule, remove the older mechanisms: name-string matching, walking up the parent chain, the global pool of bare names, and the import retry.",
        displaced_cost: "Leaving them in place means one name can still get different answers from different code paths.",
        first_slice: "Inventory every remaining place that decides what a name refers to, and remove one complete family.",
        red_control: "The inventory refuses anything it cannot classify and must reach zero before this closes.",
        out_of_scope: "Code that merely stores where things are written, without choosing meanings, stays.",
        handback: "The zero-remaining inventory plus proof the compiler still behaves the same."
      )
    ),

    active_small(
      id: "pderive-typesafe-nullary-reflection",
      owner: "self-host",
      path: "docs/plans/v2-self-hosting.md",
      t: fields(
        headline: "Stop the compiler from mixing up one type with another",
        boundary: "When the compiler asks 'what are the possible values of this type?', the answer comes from that actual type. Asking about one type and receiving another should be impossible to express.",
        displaced_cost: "The old mechanism passed a bare name and an unconstrained answer type, so it could hand back the values of a completely different type and nothing would notice.",
        first_slice: "Replace the loose lookup with one that carries the type, and move its first caller across.",
        red_control: "Asking about one type while requesting another either cannot be written down or refuses outright.",
        out_of_scope: "No rules specific to one feature baked into this general mechanism.",
        handback: "Both the working case and the mismatched-type case, actually run."
      )
    ),
    active(
      id: "pderive-static-supplemental-contract",
      owner: "self-host",
      path: "docs/plans/v2-self-hosting.md",
      t: fields(
        headline: "Write down which extra type requirements each generated shape needs",
        boundary: "For each shape we generate Rust for, record which extra requirements each of its type slots needs. 'No requirements' and 'we never said' stay different answers.",
        displaced_cost: "The generator currently guesses these, so generated Rust fails to compile in ways that look like a dozen unrelated bugs.",
        first_slice: "Record and read back the requirements for one shape with several type slots.",
        red_control: "Missing, malformed, duplicated, wrong-slot, and wrong-requirement entries all refuse; a deliberate 'none' survives.",
        out_of_scope: "No generator changes and no linking to source code in this step — just the record.",
        handback: "Proof the record survives a write/read round trip unchanged, plus the refusals."
      )
    ),
    active_large(
      id: "pderive-source-slot-binding",
      owner: "self-host",
      path: "docs/plans/v2-self-hosting.md",
      t: fields(
        headline: "Attach those requirements to the right type, not just the right position",
        boundary: "Connect each recorded slot to the exact declaration it belongs to, using the name resolution work above.",
        displaced_cost: "Matching by position or by short name attaches a requirement to the wrong type whenever two types share a name or the order shifts.",
        first_slice: "Connect one nested generic declaration to its slots.",
        red_control: "Swapped, missing, duplicated, or unresolved declarations refuse.",
        out_of_scope: "The requirement record must not start carrying source-code identity itself.",
        handback: "The exact declaration-to-slot mapping plus a swap test that catches a mismatch."
      )
    ),
    active_large(
      id: "pderive-single-emitter",
      owner: "self-host",
      path: "docs/plans/v2-self-hosting.md",
      t: fields(
        headline: "Generate those requirements from one place in the generator",
        boundary: "The Rust generator reads the record and the mapping through its existing path, rather than needing a special case per shape.",
        displaced_cost: "Every shape currently needing its own hand-written patch is a shape someone has to fix again next time.",
        first_slice: "Generate one previously failing nested generic declaration through the shared path.",
        red_control: "Removing or swapping one requirement changes the generated output or refuses — it never silently compiles anyway.",
        out_of_scope: "No second Rust-generation path.",
        handback: "The generated source plus a real compile of the discriminating example."
      )
    ),
    active_small(
      id: "pderive-error-movement-receipt",
      owner: "self-host",
      path: "docs/plans/v2-self-hosting.md",
      t: fields(
        headline: "Count the compiler errors before and after, to prove it helped",
        boundary: "Re-run the same set of modules and compare the error counts and kinds.",
        displaced_cost: "A fix that makes one example compile can leave the real number untouched; without the count we would not know.",
        first_slice: "Measure the same modules before and after, changing nothing else.",
        red_control: "The named error kind must actually drop, and a report that only shows the first error may not hide a new kind appearing.",
        out_of_scope: "No claiming success from a clean type check or a matching text file alone.",
        handback: "Full before/after counts, real builds, and any newly exposed problem."
      )
    ),

    active_small(
      id: "observation-scoped-run-seed-growth-justification",
      owner: "ci-observation",
      path: "dag/gunbc/plans/cli_run_hollowing_plan.dag",
      t: seed_growth_fields(j: observation_scoped_run_seed_growth_justification())
    ),
    active(
      id: "observation-scoped-run-consumer",
      owner: "ci-observation",
      path: "docs/plans/progress-observation-design.md",
      t: fields(
        headline: "Show honest progress while a command runs",
        boundary: "Running a command announces that it started and reports exactly one ending. In a terminal it updates in place; piped to a file it appends plain lines.",
        displaced_cost: "Progress is printed raw today, so a terminal shows a mess and a log file shows something different again.",
        first_slice: "Wire up one real command without changing what it computes.",
        red_control: "Terminal overwriting, piped appending, a refusal, and a missing reason are each checked separately.",
        out_of_scope: "No tidying up stray print statements before one real consumer works.",
        handback: "The exact bytes produced in both terminal and piped modes, from a real run."
      )
    ),
    active_large(
      id: "observation-ci-event-grouping",
      owner: "ci-observation",
      path: "docs/plans/progress-observation-design.md",
      t: fields(
