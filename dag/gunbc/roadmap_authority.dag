fn nid(s: String) -> RoadmapNodeId { s }

fn signed(by: String, works: RedControlEvidence, scope_equivalent: HandbackEvidence, as_expected: Bool) -> Signoff {
  SignedOff { by: by, works: works, scope_equivalent: scope_equivalent, as_expected: as_expected }
}

data roadmap_execution_contract_frontier_note: String = "Every node below is ExecutionContractUnspecified: the declared, fail-closed migration frontier for gunbc.roadmap_execution_contract. A node states the exact validation operations that close it before the actuator will spawn for it, so dispatch refuses with a typed environment-admission diagnostic rather than guessing validations or dependencies. The prior binding lived on a pre-refresh operator-TODO node deleted by the 2026-07-27 authority refresh; re-binding is per-node roadmap authoring, never a merge-time default."

fn authored(id: String, done: Bool, content: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: AuthoredLine { done: done, content: content },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn derivable(id: String, prs: List<Int>, title: String, description: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: description },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn derivable_wi(
  id: String,
  prs: List<Int>,
  title: String,
  description: String,
  intricacy: Intricacy,
  volume: Volume,
  repo: String
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: description },
    carriers: [],
    sizing: Sized {
      intricacy: intricacy,
      volume: volume,
      repo: repo,
      acceptance: PrsMerged,
    },
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

