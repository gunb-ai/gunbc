      section_group(
        label: "Fabric dispatch — RunShape → Allocation → Receipt (GitHub is the queue, not the scheduler)",
        nodes: [
          ticket_wi(id: "2-strictlease", done: false, t: TicketFields {
            headline: "StrictLease allocation model (Policy 0)",
            brief: "Every provider exposes strict, non-oversubscribed RunShape offers first: one allocation consumes its declared RAM/swap/CPU budget, period. srv1/srv2 are modeled like ephemeral providers (N fixed slots, hard cgroup caps, read-back receipts before work); Ubicloud is a provider offer with EphemeralVm isolation. Four nouns, no scheduler: RunShape · ProviderOffer · Allocation · Receipt (effective limits observed, peak usage, pressure/OOM events, release result).",
            displaced_cost: "",
            current_state: "",
            first_slice: "",
            red_control: "Accept ([checklist](docs/plans/fleet-acceptance-criteria.md)): one real CI job runs under a StrictLease allocation on srv1/srv2 whose Receipt proves effective limits == the offer's declared limits (read back from the live cgroup, never asserted), and a second job requesting more than remaining capacity is refused a lease rather than co-scheduled",
            out_of_scope: "burst/oversubscription — Policy 1's row",
            handback: "",
            updates: [
              TicketUpdate { on: "2026-07-25", note: "migrated to ticket form (W2-bulk tranche 16)" },
