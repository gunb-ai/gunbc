            current_state: "run 29219740765 (session/clever-hawk-862) has been queued since 2026-07-13; run 25906916260 (main ci spot rerun) since 2026-05-15",
            first_slice: "cancel or disposition both exact runs, then decide and encode the retention/priority rule that prevents a new zombie",
            red_control: "the queue observation must still name any queued run older than the declared retention bound",
            out_of_scope: "general floor speed; this row owns zombie disposition and queue-retention policy",
            handback: "the retention and main-priority policy is an operator ruling",
            updates: [
              TicketUpdate { on: "2026-07-27", note: "restored after the #7301 deletion audit proved the two named queued runs still exist; no completion receipt or successor was found" },
            ],
            authored_on: "2026-07-22",
            last_verified_on: "2026-07-27",
          }),
          superseded(
