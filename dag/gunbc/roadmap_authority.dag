          ticket_pp(id: "2-merge-admission", done: false, t: TicketFields {
            headline: "merge-admission gate: close the HELD state",
            brief: "Wired (#5974/#6080) but the freshness block is HELD pending a real green-on-main receipt, and the #6080→#6101 accidental re-apply/re-revert needs a clean landing.",
            displaced_cost: "stale-base merges landed BOTH the .gitignore drift (healed #6110/#6111) AND the extdeps.shell collision that kept main red — green-on-branch is not green-on-main",
            current_state: "HELD",
