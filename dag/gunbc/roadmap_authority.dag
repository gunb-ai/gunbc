          }, carriers: [ptr(label: "carrier", path: "dag/product/budget_tree.dag"), ptr(label: "grounding", path: "docs/plans/budget-tree.md")]),
          ticket_row(id: "1-placement-authority", done: false, t: TicketFields {
            headline: "one Placement authority",
            brief: "jobs (GitHub) · threads (spawn_width) · sessions (ctrl capacity) are 3 forks of put-work-on-a-host; Placement/Materialization are modeled but inert — CI consuming them is the lane's real deliverable.",
