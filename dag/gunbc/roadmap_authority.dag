      volume: VolumeMedium,
      t: fields(
        headline: "Complete the Git upstream fidelity model before adapter extraction",
        boundary: "Model Git as Git in extdeps: blob/tree/commit/tag objects, tree-entry modes, raw paths, worktree/index state, refs and symbolic refs, object/hash format, unavailable objects, and exact-old-object update-ref. The bounded fixture decodes, projects, and independently reads back without declaring a common SCM interface.",
        displaced_cost: "Prevents an incomplete first realization from erasing executable bits, symlinks, gitlinks, tags, paths, availability, or hash-format facts and then cementing those omissions into every later adapter.",
        first_slice: "Complete the existing Git object-store authority and execute one bounded repository round-trip plus stale expected-OID refusal.",
        red_control: "Ordinary and executable blobs, symlinks, gitlinks, and annotated tags remain distinct; stale expected OID refuses without mutation; unavailable objects never decode as empty; no shared SCM carrier or vendor switch lands.",
        out_of_scope: "No semantic integration kernel, forge transport, product hosting, inferred rename identity, universal branch/ref abstraction, or common compatibility carrier.",
        handback: "Return cited upstream types, bounded decode/project/read-back receipts, conditional-advance receipt, unsupported fidelity inventory, and the tempting common fields deliberately not extracted."
      )
    ),
    active_sized(
      id: "2-scm-mercurial-upstream-model",
