        boundary: "Observe firmware, board, controller, fan topology, thermal limits, and policy; plan/apply/read back with rollback on unsafe or mismatched state.",
        displaced_cost: "Replaces one-off fan tuning with a reproducible safety-checked lifecycle.",
        first_slice: "Converge the supported host and refuse unsupported firmware before mutation.",
        red_control: "Wrong firmware, board, topology, sensor, failsafe, or readback triggers refusal or rollback.",
        out_of_scope: "No firmware update without approved image, digest, recovery, and return proof.",
        handback: "Return apply, no-op, rollback, reboot-persistence, and unsupported-host receipts."
      )
    ),
    active(
      id: "fleet-closed-loop-converge",
      owner: "fleet",
      path: "docs/plans/host-effect-orchestration.md",
      t: fields(
        headline: "Run one host converge hunk closed-loop",
        boundary: "Typed desired state is observed, diffed, applied, independently read back, and only then marked converged.",
        displaced_cost: "Turns inert infrastructure declarations into changeable, re-runnable control.",
        first_slice: "Close one narrow service or host knob end to end.",
        red_control: "Apply success without independent readback remains NotConverged.",
        out_of_scope: "No broad host subsumption before one narrow loop proves the spine.",
        handback: "Return apply, no-op, retract, and failed-readback receipts."
      )
    ),
    active(
      id: "fleet-anti-entropy-hygiene",
      owner: "fleet",
      path: "docs/plans/fleet-acceptance-criteria.md",
      t: fields(
        headline: "Schedule anti-entropy and owned-subtree hygiene",
        boundary: "A periodic consumer re-observes every enrolled member and detects unowned state inside owned subtrees.",
        displaced_cost: "Finds leaked configuration and stale processes before the next deploy incident.",
        first_slice: "Enroll one converged workflow in periodic observation and residue detection.",
        red_control: "A removed member, stale process, or foreign file inside an owned subtree creates a located divergence.",
        out_of_scope: "Foreign state outside declared ownership is not deleted.",
        handback: "Return cadence execution and three divergence controls."
      )
    ),
    active(
      id: "fleet-receipt-qualified-control",
      owner: "fleet",
      path: "docs/plans/fleet-acceptance-criteria.md",
      t: fields(
        headline: "Qualify fleet control by live apply and periodic receipts",
        boundary: "Fleet work closes only when the live actuator, independent readback, safe re-run, retract path, and periodic consumer all execute.",
        displaced_cost: "Prevents modeled algebra or a one-time apply from being mistaken for operable infrastructure.",
        first_slice: "Promote one closed-loop converge item from live apply to periodic enforcement.",
        red_control: "Missing readback, unsafe re-run, failed retract, or missed cadence blocks qualification.",
        out_of_scope: "No acceptance from fixture-only evidence.",
        handback: "Return the T4/T5 receipt packet and operator-checkable fleet state."
      )
    ),

    queued(
      id: "product-scm-git-upstream",
      owner: "product",
      path: "docs/plans/dag-scm-design.md",
      t: fields(
        headline: "Queue the independent Git upstream model and fixture",
        boundary: "Model Git's real snapshot, ref, object, publication, and compare-and-advance semantics independently before extracting a common SCM shape.",
        displaced_cost: "Prevents the first adoption realization from becoming the universal interface by accident.",
        first_slice: "A bounded cited Git fixture over import, proposal, and exact-parent advance.",
        red_control: "Git-only facts cannot appear in the later common kernel without an explicit adapter.",
        out_of_scope: "Queued product work is non-spawnable until operator promotion.",
        handback: "Return cited upstream rows and fixture only after promotion."
      )
    ),
    queued(
      id: "product-scm-mercurial-upstream",
      owner: "product",
      path: "docs/plans/dag-scm-design.md",
      t: fields(
        headline: "Queue the independent Mercurial upstream model and fixture",
        boundary: "Model Mercurial identity, phases, bookmarks, and publication semantics on their own terms.",
        displaced_cost: "Falsifies Git-shaped identity and publication assumptions.",
        first_slice: "A bounded cited Mercurial fixture that stresses identity and publication metadata.",
        red_control: "The fixture must fail a Git-ref-shaped compatibility assumption.",
        out_of_scope: "Queued product work is non-spawnable until operator promotion.",
        handback: "Return cited upstream rows and fixture only after promotion."
      )
    ),
    queued(
      id: "product-scm-pijul-upstream",
      owner: "product",
      path: "docs/plans/dag-scm-design.md",
      t: fields(
        headline: "Queue the independent Pijul upstream model and fixture",
        boundary: "Model first-class changes, dependencies, and set-valued channels independently.",
        displaced_cost: "Falsifies commit/single-head assumptions before they enter the common shape.",
        first_slice: "A bounded cited Pijul fixture over change dependencies and channel state.",
        red_control: "The fixture must fail a linear commit/ref-shaped compatibility assumption.",
        out_of_scope: "Queued product work is non-spawnable until operator promotion.",
        handback: "Return cited upstream rows and fixture only after promotion."
      )
    ),
    queued(
      id: "product-scm-common-shape",
      owner: "product",
      path: "docs/plans/dag-scm-design.md",
      t: fields(
        headline: "Queue common SCM realization roles after three falsifiers",
        boundary: "DFS the three independent fixtures and extract only their proven common import, proposal, transition, and projection roles.",
        displaced_cost: "Avoids N adapters to a Git-shaped nickname interface.",
        first_slice: "Extract the minimal witnessed common shape and keep provider facts behind adapters.",
        red_control: "Adding a fourth SCM requires only a new adapter and rows, never a core vendor arm.",
        out_of_scope: "No common shape is authorized before all three upstream fixtures execute.",
        handback: "Return the DFS map, reduced shape, and fourth-provider discriminator after promotion."
      )
    ),
    queued(
      id: "product-source-intent-kernel",
      owner: "product",
      path: "docs/plans/dag-scm-design.md",
      t: fields(
        headline: "Queue the bounded source-intent landing kernel",
        boundary: "Compose authenticated authored transformations, claim-indexed evidence, admission, exact transition, readback, and projection into Landed, ChoiceRequired, or CouldNotLand.",
        displaced_cost: "Moves replay, integration mechanics, and machine-answerable repair out of the user's workflow.",
        first_slice: "Run one Git-compatible proposal through the bounded kernel without vendor switches.",
        red_control: "Unclosed semantics, stale parent, unauthorized effect, or failed readback cannot project Landed.",
        out_of_scope: "No hosted authority, storage service, or customer mutation before product promotion.",
        handback: "Return bounded closure, refusal partitions, and exact-parent transition receipts after promotion."
      )
    ),
    queued(
      id: "product-agent-landing-benchmark",
      owner: "product",
      path: "docs/plans/dag-scm-product-strategy.md",
      t: fields(
        headline: "Queue the fixed-contract agent landing benchmark",
        boundary: "Compare ordinary Git integration and the source-intent kernel under one fixed safety contract before any design-partner shadow or hosted promotion.",
        displaced_cost: "Tests whether semantic landing displaces real replay, CI, and judgment cost.",
        first_slice: "Run the benchmark on gunbc with reversible Git output.",
        red_control: "Ordinary queue, rebase, or cache improvements that erase the claimed advantage stop or narrow the product lane.",
        out_of_scope: "No customer source access, ref write authority, hosting, or adjacent product grant.",
        handback: "Return public checkable receipts and a promote, narrow, or stop disposition after operator promotion."
      )
    ),
  ]
}

