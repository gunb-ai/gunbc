fn declared_roadmap_edges() -> List<RoadmapEdge> {
  concat([
    edge(child: "2-scm-compatibility-shape", parent: "2-scm-git-upstream-model"),
    edge(child: "2-scm-compatibility-shape", parent: "2-scm-mercurial-upstream-model"),
    edge(child: "2-scm-compatibility-shape", parent: "2-scm-pijul-upstream-model"),
    edge(child: "2-scm-p0-landing-spine", parent: "2-scm-compatibility-shape"),
    edge(child: "2-scm-p0-landing-spine", parent: "2-claim-indexed-evidence"),
    edge(child: "2-scm-p1-proof-kernel", parent: "2-scm-p0-landing-spine"),

    edge(child: "namespace-binding-kernel", parent: "namespace-occurrence-transport"),
    edge(child: "namespace-reference-derived-closure", parent: "namespace-binding-kernel"),
    edge(child: "namespace-structural-observations", parent: "namespace-binding-kernel"),
    edge(child: "namespace-cross-file-provenance", parent: "namespace-binding-kernel"),
    edge(child: "namespace-pool-independence", parent: "namespace-cross-file-provenance"),
    edge(child: "namespace-reference-derived-closure", parent: "namespace-structural-observations"),
    edge(child: "namespace-reference-derived-closure", parent: "namespace-pool-independence"),
    edge(child: "namespace-ambiguity-discharge", parent: "namespace-reference-derived-closure"),
    edge(child: "namespace-canonical-binding", parent: "namespace-ambiguity-discharge"),
    edge(child: "namespace-bound-only-consumers", parent: "namespace-canonical-binding"),
