      section_group(
        label: "Open floor holes",
        nodes: [
          ticket_row(id: "1-nightly", done: true, t: TicketFields {
            headline: "full-corpus selector-backstop — live at 4-hourly cadence",
            brief: "falsifier.yml cron runs the corpus cold with predictions recorded (the flip note names it the selection's soundness governor); falsifier-alert (#7022) closes the silent-red loudness gap. Regen's cold control is separate (unconditional main-push regen).",
            displaced_cost: "",
            current_state: "green again per #7083",
            first_slice: "",
            red_control: "",
            out_of_scope: "",
            handback: "",
            updates: [
