    edge(child: "v1-interpreter-delete", parent: "v1-seed-honesty-decision"),
    edge(child: "v1-interpreter-delete", parent: "namespace-legacy-choice-retirement"),
    edge(child: "v1-interpreter-delete", parent: "pderive-error-movement-receipt"),
    edge(child: "v1-zero-hand-maintained-rust", parent: "v1-interpreter-delete"),
    edge(child: "v1-zero-hand-maintained-rust", parent: "caret-parse-smoke-seed-growth-justification"),

