          }),
          sign(rn: owned(rn: authored_wi(id: "1-resolver-pathology-a", done: true, content: "**resolver pathology A — profile receipt only** — the 518s resolve: cold-resolve profile receipt (harness deleted with `scripts/` 2026-07-23; method recorded in the plan doc); top-N entry offenders; pair `budget_roster_completeness_test` vs `fold_list_generic_instantiation` (34.7× cold wall); hypothesis: `typecheck_module` in `reconcile_with_typed_cache`.", intricacy: IntricacyHigh, volume: VolumeSmall, repo: "gunbc"), owner: "dispatched 2026-07-01 · adhoc-51b0b8e7-0be"), s: signed(by: "operator", works: true, scope_equivalent: true, as_expected: true)),
