          }),
          ticket_row(id: "ts-dispatch-rework", done: false, t: TicketFields {
            headline: "rework is a first-class disposition, designed against LLM defensiveness",
            brief: "Returning from later evidence to an earlier causal-arc segment must be cheap and expected, never a negotiation. Three mechanisms: (a) the BRIEF declares rework a normal outcome — expectation set at dispatch, not sprung at review; (b) a NeedsRework verdict dispatches a FRESH session carrying the original brief + the prior attempt's diff + the located debts — never ask the context that produced the work to unwind it (in-context sunk cost is the defensiveness mechanism; the goldfish property becomes the asset); (c) independently keyed artifacts make rework a re-derivation — edit the model, regenerate downstream.",
            displaced_cost: "rework as negotiation; the producing context defending its own work",
            current_state: "priced up front as design; mechanism (b) enforces at ts-wf-belt-refusals, (c) at ts-wf-stage-artifacts",
            first_slice: "",
