fn roadmap_authority() -> RoadmapDocument {
  RoadmapDocument {
    preamble: preamble(),
    lead_lanes: [task_sheet_lead_lane()],
    sections: [section_0(), section_1(), section_2(), section_3(), section_4()],
  }
}

fn authored_merged_prs() -> List<Int> {
  [5873, 6009, 6061, 6097, 6099, 6104, 6106, 6107, 6224, 6479]
}

fn expected_roadmap_md() -> String {
  serialize_markdown_source(doc: project_roadmap_to_markdown(doc: roadmap_authority(), merged: authored_merged_prs()))
}

fn roadmap_drifted(committed: String) -> Bool {
  !(committed == expected_roadmap_md())
}
