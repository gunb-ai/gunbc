fn accepted_roadmap_nodes() -> List<RoadmapNode> {
  let receipts = roadmap_acceptance_receipts()
  declared_roadmap_nodes() |> filter(n => node_accepted(receipts: receipts, rn: n))
}

fn accepted_roadmap_node_ids() -> List<RoadmapNodeId> {
  accepted_roadmap_nodes() |> map(n => n.node)
}

fn active_roadmap_nodes() -> List<RoadmapNode> {
  let accepted = accepted_roadmap_node_ids()
  declared_roadmap_nodes() |> filter(n => !(accepted |> any(a => a == n.node)))
}

data closing_contract_task_projection_boundary_note: String = "The derived tasks are added at the PROJECTION, not to active_roadmap_nodes. Folding them into the active set reded witness_active_set_is_declared_minus_accepted and witness_accepted_parent_discharges_active_dependency, and those witnesses are right: 'active = declared minus accepted' is a law about the AUTHORITY, and a derived projection row is not a declared deliverable. Keeping the law intact is also what makes the derivation safe — the authority stays exactly what someone authored, and the frontier view is a function of it."

fn projected_roadmap_nodes() -> List<RoadmapNode> {
  concat(active_roadmap_nodes(), closing_contract_task_nodes())
}

fn projected_roadmap_edges() -> List<RoadmapEdge> {
  concat(active_roadmap_edges(), closing_contract_task_edges())
}

data closing_contract_task_naming_correction_note: String = "THESE ARE CLOSING-CONTRACT TASKS, NOT ACCEPTANCE TASKS, and the earlier name caused a real category error. The projection computes active AND ExecutionContractUnspecified AND every-prerequisite-accepted, which is the set of nodes whose completion nothing can yet CHECK. Authoring that check is contract work. Acceptance is a separate, later, operator act on work already done and verified.\n\nThe old name made those two look like one state, and a node can be in any of several: blocked on unaccepted prerequisites; missing a closing contract; dispatchable; implemented but verification-red; implemented and green, awaiting operator acceptance; accepted. v2-emitter-producer-provenance is the specimen that exposed it — it is BOUND, so it never appears in this projection, while what it actually needs is acceptance of landed work. A projection named for acceptance that structurally cannot surface the thing needing acceptance is misnamed, so it was renamed to startable_nodes_missing_closing_contract.\n\nKNOWN GAP, recorded rather than papered over: a derived task is itself built with ExecutionContractUnspecified, and dispatch refuses an unspecified contract. So the belt cannot dispatch these rows — the target waits on a contract, and the contract-authoring row has no contract of its own. Manual child spawning works around it; end-to-end dispatch does not. Closing it wants ONE parameterized ClosingContractAuthoring kind whose completion predicate is reusable across every target (target now carries exactly one contract, with at least one validation, every referenced validation resolves, a planted failure shows the validation can reject, and the contract names the same target identity) rather than ten bespoke meta-witnesses. Not landed here; this note is its trigger."

data closing_contract_task_derivation_note: String = "CLOSING-CONTRACT TASKS ARE DERIVED, NOT AUTHORED (operator ruling 2026-07-29: 'you shouldn't need to manually maintain that stuff — the relationship should be inferred from one side or the other'). The first cut hand-wrote four acceptance nodes and four edges, and one had to be hand-removed within minutes because pderive-typesafe-nullary-reflection was already accepted: a new prerequisite on completed work retroactively un-satisfies it, which witness_accepted_parents_precede_dependents caught. That is the hand-maintained-count failure this repository refuses everywhere else — two things that must be kept in step, drifting the moment either side moves.\n\nThe relationship is a FUNCTION of the node: startable (every prerequisite accepted) AND unbound (ExecutionContractUnspecified) means its closing validation does not exist, so authoring that validation is the work that unblocks it. Nothing else needs saying. An accepted node leaves the active set and its task disappears; a node that gains a contract stops being unbound and its task disappears; a node whose prerequisite lands becomes startable and its task appears. No cleanup step exists because there is nothing to clean.\n\nThe frontier is deliberately STARTABLE-only rather than every unbound node. A terminus like v1-zero-hand-maintained-rust is unbound too, but surfacing a closing-contract task for work whose prerequisites are years out is noise that would bury the four rows that matter today.\n\nOn identity: a derived row takes a deterministic id from its target rather than a minted one, and that is consistent with the identity law rather than an exception to it. The law governs declared DELIVERABLES, which must survive rename and reordering. A closing-contract task is a projection of a frontier state — it has no history to preserve, it exists exactly while its target lacks a contract, and if the target's slug changes it is honestly a different task."

fn node_is_startable(n: RoadmapNode) -> Bool {
  let accepted = accepted_roadmap_node_ids()
  all(
    roadmap_parent_ids(edges: declared_roadmap_edges(), node: n.node),
    p => accepted |> any(a => a == (p as String)),
  )
}

fn node_lacks_closing_validation(n: RoadmapNode) -> Bool {
  match n.execution {
    ExecutionContractUnspecified => true
    ExecutionContract { validations: _, extra_capabilities: _ } => false
  }
}

fn ticket_headline_of(n: RoadmapNode) -> String {
  match line_ticket(item: n.line) {
    Present { value: t } => t.headline
    Absent => n.node as String
  }
}

fn ticket_red_control_of(n: RoadmapNode) -> String {
  match line_ticket(item: n.line) {
    Present { value: t } => t.red_control
    Absent => "the node states no red control"
  }
}

data roadmap_identity_prefix_is_cosmetic_note: String = "DO NOT 'FIX' 2-scm-compatibility-shape's rnfx_ IDENTITY PREFIX. It reads as a test-fixture prefix where every other declared node uses rn_, and that asymmetry is real but it is COSMETIC: no witness asserts any prefix, and roadmap_node_identity_law constrains what may not be an identity INPUT (slug, title, criteria digest, containment position, dependency neighbourhood, declaration order, file position), never the alphabet of the minted value.\n\nRewriting it would be the actual violation. The law's whole persistence argument is that an identity must survive edits, reordering, regeneration and independent branches; mutating a live identity for tidiness is precisely the churn it exists to forbid, and it would silently break anything holding the old value. The prefix carries no meaning to any mechanism, so the honest disposition is to leave it and record why — which is what this row is for. A prefix convention worth enforcing would be enforced at MINT time by construction, not by editing identities already in the graph."

fn startable_nodes_missing_closing_contract() -> List<RoadmapNode> {
  let accepted = accepted_roadmap_node_ids()
  declared_roadmap_nodes()
    |> filter(n => !(accepted |> any(a => a == n.node)))
    |> filter(n => node_lacks_closing_validation(n: n))
    |> filter(n => node_is_startable(n: n))
}

fn closing_contract_task_for(n: RoadmapNode) -> RoadmapNode {
  RoadmapNode {
    identity: concat(n.identity as String, "-closing-contract") as RoadmapNodeIdentity,
    node: concat(n.node as String, "-closing-contract") as RoadmapNodeId,
    line: TicketLine {
      done: false,
      ticket: fields(
        headline: concat("Write the closing check for: ", ticket_headline_of(n: n)),
        boundary: concat("One executable check states when this is done, transcribed from the node's own bar: ", ticket_red_control_of(n: n)),
        displaced_cost: "Turns a prose bar into a runnable verdict, so the node it gates can be dispatched and its completion checked rather than judged.",
        first_slice: "Write the check and prove each refusal arm fires on a planted input.",
        red_control: concat("The check must fail when the condition fails: ", ticket_red_control_of(n: n)),
        out_of_scope: "Write the statement of done; do not do the work it gates.",
        handback: "Return the executable check, each arm firing on a planted input, and the gated node bound to it."
      ),
    },
    carriers: n.carriers,
    sizing: Sized {
      intricacy: IntricacyLow,
      volume: VolumeSmall,
      repo: "gunbc",
      acceptance: ManualAcceptance,
    },
    execution: ExecutionContractUnspecified,
    owner: n.owner,
    signoff: Unsigned,
  }
}

fn closing_contract_task_nodes() -> List<RoadmapNode> {
  startable_nodes_missing_closing_contract() |> map(n => closing_contract_task_for(n: n))
}

fn closing_contract_task_edges() -> List<RoadmapEdge> {
  startable_nodes_missing_closing_contract()
    |> map(n => RoadmapEdge {
      child: n.node,
      parent: concat(n.node as String, "-closing-contract") as RoadmapNodeId,
    })
}

fn active_roadmap_edges() -> List<RoadmapEdge> {
  let accepted = accepted_roadmap_node_ids()
  declared_roadmap_edges() |> filter(e =>
    !(accepted |> any(a => a == e.child)) && !(accepted |> any(a => a == e.parent)))
}

fn preamble() -> List<MarkdownBlock> {
  [
    HeadingBlock { level: H1, inlines: [TextInline { text: "gunbc — Roadmap" }] },
    ParagraphBlock { inlines: [TextInline { text: "`DESIGN.md` is the authority for why. This file projects the remaining committed deliverables and their dependency order from `dag/gunbc/roadmap_authority.dag`. The authority declares every node and records a typed acceptance receipt per accepted node; the active set is derived as declared minus validly accepted, so acceptance never deletes a row and this projection stays active-only. It carries no mutable pull-request, CI, session, or attempt state. Implementation evidence does not equal acceptance; a merged but unaccepted deliverable remains active." }] },
    ParagraphBlock { inlines: [TextInline { text: "Indented rows depend on the row above them. Some deliverables have additional cross-chain prerequisites represented by `RoadmapEdge` in the authority. Every active row requires explicit manual acceptance. Automatic admission from this refreshed authority is future work; the existing manual dispatch path remains live and outside this model slice. Ready may schedule only after every dependency is accepted; it never overrides a dependency or refusal. Parked plans remain reachable through the documentation graph but are not active roadmap rows." }] },
    ParagraphBlock { inlines: [TextInline { text: "Parked context (non-dispatchable): [compiler algorithm survey](docs/plans/compiler-algorithm-survey-2026-07-04.md) · [SCM product strategy and post-prerequisite lanes](docs/plans/dag-scm-product-strategy.md) · [dispatch maintain CC](docs/plans/dispatch-maintain-cc.md) · [eval bind proposal](docs/plans/eval-bind-node-eval-propose.md) · [interpreter memory chronicle](docs/plans/interpreter-memory-chronicle.md) · [node/subtree visibility grants](docs/plans/node-subtree-visibility-grants.md) · [non-fold residue catalogue](docs/plans/non-fold-irreducible-residue-catalogue.md) · [post-engine roadmap](docs/plans/post-engine-pr-roadmap.md) · [post-zero regen placement](docs/plans/post-zero-regen-gate-placement.md) · [syntactic sample audit](docs/plans/real-debt-syntactic-sample-audit.md) · [regen 31/32 reconciliation](docs/plans/regen-divergence-31-vs-32-reconciliation.md) · [regen divergence ratchet](docs/plans/regen-divergence-ratchet-shape.md) · [roadmap spawner](docs/plans/roadmap-spawner.md) · [seed honesty discharge](docs/plans/seed-honesty-discharge-design.md) · [space lens minimal project](docs/plans/space-lens-minimal-project.md)." }] },
  ]
}

data roadmap_focus_selection_note: String = "THE ONE ROW THAT SETS THE VIEW. Focusing is a projection policy, not an edit — every node and edge stays declared in this file, the dispatch surface still sees the whole graph, and setting this back to NoFocus restores the full page with no recovery step. It is set to the v1 exit lane because that is the sustained effort under way (the v1 → v2 emitter exit plan); the other lanes remain real work, they are simply not on the page while this one is being ground out. The projection states how many it is hiding, derived rather than transcribed, so a focused page can never read as a shorter roadmap."

data roadmap_focus_selection: RoadmapFocus = FocusOnOwners {
  label: "the v1 deletion lane",
  owners: ["self-host"],
}

fn active_section() -> RoadmapSection {
  active_section_for(focus: roadmap_focus_selection)
}

data roadmap_authority_focus_parameter_note: String = "roadmap_authority_for exists so a claim about the AUTHORITY can be written without a claim about the current VIEW. A witness that asserts which lanes are active, but reads the projected markdown to do it, silently becomes a witness about whatever focus happens to be set — it would go red the moment someone focused the page, having found nothing wrong with the roadmap at all. Passing NoFocus makes that independence explicit at the call site rather than leaving it to coincidence. roadmap_authority() keeps the declared focus, because the generated ROADMAP.md IS the focused view."

fn roadmap_authority_for(focus: RoadmapFocus) -> RoadmapDocument {
  RoadmapDocument {
    preamble: preamble(),
    lead_lanes: [],
    sections: [active_section_for(focus: focus), guarantee_ladder_section()],
  }
}

fn active_section_for(focus: RoadmapFocus) -> RoadmapSection {
  RoadmapSection {
    title: "Active deliverables — dependency order",
    elements: concat(
      [
        section_prose(content: "The graph has ten lanes: SCM compatibility · namespace · P-derive · observation · placement · v1 exit (four finish lines: compiler fixed point, interpreter deleted, products v1-free, zero hand-maintained Rust) · shell · roadmap runtime · fleet/hygiene · hermetic toolchain. The three independent SCM R0 models, the separate P−1 evidence carrier, and R1 compatibility-shape extraction are landed prerequisites; P0's user-contract and layered landing spine is the active SCM slice, while the P1 semantic kernel and later product lanes remain parked. The toolchain pin model is an independent root. The P-derive receipt feeds the emitter fixed point, so the v1 chain nests under it. Node fields define boundary, first slice, RED control, exclusions, owner, and handback."),
      ],
      concat(
        if focus_is_active(focus: focus) {
          [section_prose(content: focus_notice(
            focus: focus,
            nodes: projected_roadmap_nodes(),
            edges: projected_roadmap_edges(),
          ))]
        } else {
          []
        },
        [
          section_group(
            label: "",
            nodes: focus_visible_nodes(
              focus: focus,
              nodes: projected_roadmap_nodes(),
              edges: projected_roadmap_edges(),
            ),
            edges: focus_visible_edges(
              focus: focus,
              nodes: projected_roadmap_nodes(),
              edges: projected_roadmap_edges(),
            )
          ),
        ],
      ),
    ),
  }
}

data guarantee_ladder_section_note: String = "STATE vs WORK, the split that keeps this section honest (DESIGN 4b): a guarantee class's CURRENT RUNG is state and its single authority is the Stage-1 ErrorClassGuarantee carrier (seeded from the census in docs/plans/compiler-guarantee-recovery-gap-analysis.md sec 1c) — never these nodes. These nodes track CLIMBS: discrete work moving named classes between rungs, each closeable by signoff like any roadmap node. The per-class rung table is EMITTED from the carrier (the ladder-census-emitters node), so ROADMAP.md and the served roadmap page render ladder state without this section restating it — restating it here would be rung inflation's cousin, a second hand-maintained ledger (DESIGN 3). This section is focus-independent: it is the designed-up-front backlog the operator staffs by dispatching a node (belt dispatch / work-items), so hiding it under an owner focus would hide exactly the unstaffed work it exists to hold. Nodes are Unsigned, owner-empty, sized for dispatch."

