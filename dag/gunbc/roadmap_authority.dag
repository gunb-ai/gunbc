fn nid(s: String) -> RoadmapNodeId { s }

fn signed(by: String, works: Bool, scope_equivalent: Bool, as_expected: Bool) -> Signoff {
  SignedOff { by: by, works: works, scope_equivalent: scope_equivalent, as_expected: as_expected }
}

fn authored(id: String, done: Bool, content: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: AuthoredLine { done: done, content: content },
    carriers: [],
    sizing: Unsized,
    owner: "",
    signoff: Unsigned,
  }
}

fn derivable(id: String, prs: List<Int>, title: String, description: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: description },
    carriers: [],
    sizing: Unsized,
    owner: "",
    signoff: Unsigned,
  }
}

fn derivable_wi(
  id: String,
  prs: List<Int>,
  title: String,
  description: String,
  intricacy: Intricacy,
  volume: Volume,
  repo: String
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: description },
    carriers: [],
    sizing: Sized {
      intricacy: intricacy,
      volume: volume,
      repo: repo,
      acceptance: PrsMerged,
    },
    owner: "",
    signoff: Unsigned,
  }
}

fn authored_wi(
  id: String,
  done: Bool,
  content: String,
  intricacy: Intricacy,
  volume: Volume,
  repo: String
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: AuthoredLine { done: done, content: content },
    carriers: [],
    sizing: Sized {
      intricacy: intricacy,
      volume: volume,
      repo: repo,
      acceptance: ManualAcceptance,
    },
    owner: "",
    signoff: Unsigned,
  }
}

fn ticket_row(id: String, done: Bool, t: TicketFields) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: TicketLine { done: done, ticket: t }, carriers: [], sizing: Unsized, owner: "", signoff: Unsigned }
}

fn seed_growth_justification_row(
  id: String,
  done: Bool,
  justification: SeedGrowthJustification,
  carriers: List<Pointer>
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: SeedGrowthJustificationLine {
      done: done,
      seed_growth_justification: justification,
    },
    carriers: carriers,
    sizing: Unsized,
    owner: "",
    signoff: Unsigned,
  }
}

data ticket_write_interface_note: String = "Recorded at the operator's question mid-bulk (2026-07-25): is the migration a consumer for a programmatic read/write interface? Assessed — the READ side exists and is proven at this grain (non_fold_residue_units_from_module_source reads typed record rows from module source; ingest parses any module to a Node tree), the WRITE side exists only as emission (authority -> projection via main_wet; dag is a registered emit target), and there is no in-place source editor — the Node-tree read/write seam is what gunbc#5364 gates. VERDICT: the one-time migration is NOT the right first consumer (its hard half is editorial judgment no interface removes; its mechanical half is already execution-verified per tranche — a harness for the remainder is the purity trap, section 6). The RECURRING consumer is typed TicketUpdate APPEND: belt verdicts landing on the sheet (ts-wf-shape / ts-dispatch-verdict), sessions writing back at close (ts-doc-anchor), typed dissolution triggers firing (ts-group-dissolve-typed) — bounded, typed, append-only writes to the updates axis the migration created. When the write interface lands, the updates axis is its first API and those three rows are its first consumers."


data ticket_carrier_constructors_note: String = "ticket_doc / ticket_pp (W2-bulk): the carrier-preserving ticket constructors, the exact siblings authored_doc/authored_pp are to authored. Without them, migrating a pointer-carrying prose row through ticket_row would silently DROP its carriers — the doc-graph's inbound links — which is content loss the migration's own honesty rules forbid and the orphan witness may red on. References reuse the node's carriers per ticket_line_note; these constructors are that reuse, not a new refs concept."

fn ticket_doc(id: String, done: Bool, t: TicketFields, path: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: TicketLine { done: done, ticket: t }, carriers: plan_ptr(path: path), sizing: Unsized, owner: "", signoff: Unsigned }
}

fn ticket_pp(id: String, done: Bool, t: TicketFields, carriers: List<Pointer>) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: TicketLine { done: done, ticket: t }, carriers: carriers, sizing: Unsized, owner: "", signoff: Unsigned }
}

fn ticket_wi(id: String, done: Bool, t: TicketFields, intricacy: Intricacy, volume: Volume, repo: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: TicketLine { done: done, ticket: t },
    carriers: [],
    sizing: Unsized,
    owner: "",
    signoff: Unsigned,
  }
}

fn ticket_wi(
  id: String,
  done: Bool,
  t: TicketFields,
  intricacy: Intricacy,
  volume: Volume,
  repo: String
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: TicketLine { done: done, ticket: t },
    carriers: [],
    sizing: Sized {
      intricacy: intricacy,
      volume: volume,
      repo: repo,
      acceptance: ManualAcceptance,
    },
    owner: "",
    signoff: Unsigned,
  }
}

fn superseded(id: String, by: String, content: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: SupersededLine { by: by, content: content },
    carriers: [],
    sizing: Unsized,
    owner: "",
    signoff: Unsigned,
  }
}

fn sign(rn: RoadmapNode, s: Signoff) -> RoadmapNode {
  RoadmapNode {
    node: rn.node,
    line: rn.line,
    carriers: rn.carriers,
    sizing: rn.sizing,
    owner: rn.owner,
    signoff: s,
  }
}

fn carrier(path: String) -> List<Pointer> {
  [Pointer { label: "authority", path: path }]
}

fn fields(
  headline: String,
  boundary: String,
  displaced_cost: String,
  first_slice: String,
  red_control: String,
  out_of_scope: String,
  handback: String
) -> TicketFields {
  TicketFields {
    headline: headline,
    brief: boundary,
    displaced_cost: displaced_cost,
    current_state: concat("Unaccepted; next executable slice: ", first_slice),
    first_slice: first_slice,
    red_control: red_control,
    out_of_scope: out_of_scope,
    handback: handback,
    updates: [],
    authored_on: "",
    last_verified_on: "",
  }
}

fn active_sized(
  id: String,
  owner: String,
  path: String,
  intricacy: Intricacy,
  volume: Volume,
  t: TicketFields
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: TicketLine { done: false, ticket: t },
    carriers: carrier(path: path),
    sizing: Sized {
      intricacy: intricacy,
      volume: volume,
      repo: "gunbc",
      acceptance: ManualAcceptance,
    },
    owner: owner,
    signoff: Unsigned,
  }
}

fn active(id: String, owner: String, path: String, t: TicketFields) -> RoadmapNode {
  active_sized(
    id: id,
    owner: owner,
    path: path,
    intricacy: IntricacyMedium,
    volume: VolumeMedium,
    t: t,
  )
}

fn active_small(id: String, owner: String, path: String, t: TicketFields) -> RoadmapNode {
  active_sized(
    id: id,
    owner: owner,
    path: path,
    intricacy: IntricacyLow,
    volume: VolumeSmall,
    t: t,
  )
}

fn active_large(id: String, owner: String, path: String, t: TicketFields) -> RoadmapNode {
  active_sized(
    id: id,
    owner: owner,
    path: path,
    intricacy: IntricacyHigh,
    volume: VolumeLarge,
    t: t,
  )
}

fn edge(child: String, parent: String) -> RoadmapEdge {
  RoadmapEdge { child: nid(s: child), parent: nid(s: parent) }
}

type SeedGrowthJustification {
  reason: String
  owning_dissolution_lane: RoadmapNodeId
  trigger: String
  current_boundary: String
}

fn observation_scoped_run_seed_growth_justification() -> SeedGrowthJustification {
  SeedGrowthJustification {
    reason: "The scoped observation consumer must cross the current interpreter entry seam to bind the runtime-selected declaration identity, capture and replay deferred stderr, and project exactly one terminal outcome while the typed observation policy remains in .dag.",
    owning_dissolution_lane: nid(s: "v1-hand-queue-drain"),
    trigger: "Extract the scoped-run observation seam into typed host-effect transport, then hollow cli_run.rs Chunk F so generated workflow orchestration consumes the .dag projection; delete the interpreter-facing Rust bridge at that cut.",
    current_boundary: "dag/gunbc/observation_seed_render.dag; dag/test/claim/observation_seed_scoped_run_witness_test.dag; src/v1/stage0/src/cli_run.rs; src/v1/stage0/src/v1_interpreter.rs; src/v1/stage0/tests/scoped_run_observation.rs",
  }
}

fn seed_growth_fields(j: SeedGrowthJustification) -> TicketFields {
  fields(
    headline: "Justify the bounded scoped-run observation seed bridge",
    boundary: concat(
      "The admitted growth is restricted to exactly these five files: ",
      j.current_boundary,
    ),
    displaced_cost: concat("Reason: ", j.reason),
    first_slice: concat(
      "Route the bridge's deletion obligation to ",
      concat(j.owning_dissolution_lane as String, " without admitting another seed file."),
    ),
    red_control: concat(
      "Any interpreter-facing bridge growth outside the five-file boundary, or growth without this trigger, refuses acceptance: ",
      j.trigger,
    ),
    out_of_scope: "No general seed-growth ledger, observation feature expansion, or implementation-status record.",
    handback: concat(
      "Return the five-file boundary receipt and carry this exact dissolution trigger into ",
      j.owning_dissolution_lane as String,
    ),
  )
}

