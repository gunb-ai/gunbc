fn roadmap_authority() -> RoadmapDocument {
  RoadmapDocument {
    preamble: preamble(),
    lead_lanes: [],
    sections: [active_section()],
  }
}

fn authored_merged_prs() -> List<Int> { [] }

fn expected_roadmap_md() -> String {
  serialize_markdown_source(
    doc: project_roadmap_to_markdown(
      doc: roadmap_authority(),
      merged: authored_merged_prs()
    )
  )
}

fn roadmap_drifted(committed: String) -> Bool {
  !(committed == expected_roadmap_md())
}
