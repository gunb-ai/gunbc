module gunbc.roadmap_authority

import gunbc.roadmap_document { RoadmapDocument, RoadmapSection, project_roadmap_to_markdown }
import gunbc.roadmap_model {
  RoadmapNode, RoadmapEdge, Pointer, RoadmapNodeId,
  Intricacy, IntricacyLow, IntricacyMedium, IntricacyHigh,
  Volume, VolumeSmall, VolumeMedium, VolumeLarge,
  Acceptance, PrsMerged, ManualAcceptance,
  NodeSizing, Unsized, Sized,
  SectionElement, section_prose, section_group,
}
import gunbc.roadmap_status {
  RoadmapItem, DerivableLine, AuthoredLine, PlainLine, SupersededLine, TicketLine,
  TicketFields, TicketUpdate,
  Signoff, Unsigned, SignedOff,
}
import std.markdown { MarkdownBlock, HeadingBlock, ParagraphBlock, TextInline, H1 }
import extdeps.languages.markdown { serialize_markdown_source }

fn nid(s: String) -> RoadmapNodeId { s }

fn ptr(label: String, path: String) -> Pointer { Pointer { label: label, path: path } }
fn plan_ptr(path: String) -> List<Pointer> { [Pointer { label: "plan", path: path }] }

fn unsigned() -> Signoff { Unsigned }

fn signed(by: String, works: Bool, scope_equivalent: Bool, as_expected: Bool) -> Signoff {
  SignedOff { by: by, works: works, scope_equivalent: scope_equivalent, as_expected: as_expected }
}

fn authored(id: String, done: Bool, content: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: AuthoredLine { done: done, content: content }, carriers: [], sizing: Unsized, owner: "", signoff: Unsigned }
}

fn authored_doc(id: String, done: Bool, content: String, path: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: AuthoredLine { done: done, content: content }, carriers: plan_ptr(path: path), sizing: Unsized, owner: "", signoff: Unsigned }
}

fn authored_pp(id: String, done: Bool, content: String, carriers: List<Pointer>) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: AuthoredLine { done: done, content: content }, carriers: carriers, sizing: Unsized, owner: "", signoff: Unsigned }
}

fn plain(id: String, content: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: PlainLine { content: content }, carriers: [], sizing: Unsized, owner: "", signoff: Unsigned }
}

fn derivable(id: String, prs: List<Int>, title: String, description: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: DerivableLine { prs: prs, title: title, description: description }, carriers: [], sizing: Unsized, owner: "", signoff: Unsigned }
}
fn derivable_doc(id: String, prs: List<Int>, title: String, description: String, path: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: DerivableLine { prs: prs, title: title, description: description }, carriers: plan_ptr(path: path), sizing: Unsized, owner: "", signoff: Unsigned }
}
fn derivable_pp(id: String, prs: List<Int>, title: String, description: String, carriers: List<Pointer>) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: DerivableLine { prs: prs, title: title, description: description }, carriers: carriers, sizing: Unsized, owner: "", signoff: Unsigned }
}

fn derivable_wi(id: String, prs: List<Int>, title: String, description: String, intricacy: Intricacy, volume: Volume, repo: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: description },
    carriers: [],
    sizing: Sized { intricacy: intricacy, volume: volume, repo: repo, acceptance: PrsMerged },
    owner: "",
    signoff: Unsigned,
  }
}

fn authored_wi(id: String, done: Bool, content: String, intricacy: Intricacy, volume: Volume, repo: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: AuthoredLine { done: done, content: content },
    carriers: [],
    sizing: Sized { intricacy: intricacy, volume: volume, repo: repo, acceptance: ManualAcceptance },
    owner: "",
    signoff: Unsigned,
  }
}

fn ticket_row(id: String, done: Bool, t: TicketFields) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: TicketLine { done: done, ticket: t }, carriers: [], sizing: Unsized, owner: "", signoff: Unsigned }
}

data w2_bulk_resweep_hold_note: String = "The typed hold (management ruling 2026-07-25, ratifying the migration-side finding and sharpening it into a counted state): the ts-pr-audit children are one-fact PR-disposition snapshots — a ticket around a one-liner is nine empty fields of costume, the exact dual of the anemic-String defect (schema over-fit), and the fused-fields defect W2 kills is absent in them, so migrating displaces no cost. They are HELD, not forgotten: this roster is the mechanical worklist the operator's re-sweep consumes, and the legacy frontier decomposes honestly into not-yet-migrated vs held-for-disposition. DISSOLVE-ON: ts-pr-audit's re-sweep after the merge wave settles — each child merges, folds, or closes there; a child the sweep keeps open either migrates on its merits or, if a second one-fact family has appeared by then, earns the lighter row species at its second consumer (deliberately not minted now — the hold is what makes deferring that call cheap). A held id whose row has been migrated or deleted is a red: the hold outlived its state."

type HeldForOperatorResweep {
  node_id: String
}

data w2_bulk_resweep_held: List<HeldForOperatorResweep> = [
  HeldForOperatorResweep { node_id: "ts-pr-7008" },
  HeldForOperatorResweep { node_id: "ts-pr-7027" },
  HeldForOperatorResweep { node_id: "ts-pr-7050" },
  HeldForOperatorResweep { node_id: "ts-pr-7058" },
  HeldForOperatorResweep { node_id: "ts-pr-7066" },
  HeldForOperatorResweep { node_id: "ts-pr-7068" },
  HeldForOperatorResweep { node_id: "ts-pr-7069" },
  HeldForOperatorResweep { node_id: "ts-pr-7072" },
  HeldForOperatorResweep { node_id: "ts-pr-7074" },
  HeldForOperatorResweep { node_id: "ts-pr-7076" },
  HeldForOperatorResweep { node_id: "ts-pr-7077" },
  HeldForOperatorResweep { node_id: "ts-pr-7078" },
  HeldForOperatorResweep { node_id: "ts-pr-7080" },
]

fn w2_bulk_resweep_held_ids() -> List<String> {
  map(w2_bulk_resweep_held, h => h.node_id)
}

data ticket_carrier_constructors_note: String = "ticket_doc / ticket_pp (W2-bulk): the carrier-preserving ticket constructors, the exact siblings authored_doc/authored_pp are to authored. Without them, migrating a pointer-carrying prose row through ticket_row would silently DROP its carriers — the doc-graph's inbound links — which is content loss the migration's own honesty rules forbid and the orphan witness may red on. References reuse the node's carriers per ticket_line_note; these constructors are that reuse, not a new refs concept."

fn ticket_doc(id: String, done: Bool, t: TicketFields, path: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: TicketLine { done: done, ticket: t }, carriers: plan_ptr(path: path), sizing: Unsized, owner: "", signoff: Unsigned }
}

fn ticket_pp(id: String, done: Bool, t: TicketFields, carriers: List<Pointer>) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: TicketLine { done: done, ticket: t }, carriers: carriers, sizing: Unsized, owner: "", signoff: Unsigned }
}

fn ticket_wi(id: String, done: Bool, t: TicketFields, intricacy: Intricacy, volume: Volume, repo: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: TicketLine { done: done, ticket: t },
    carriers: [],
    sizing: Sized { intricacy: intricacy, volume: volume, repo: repo, acceptance: ManualAcceptance },
    owner: "",
    signoff: Unsigned,
  }
}

fn superseded(id: String, by: String, content: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: SupersededLine { by: by, content: content }, carriers: [], sizing: Unsized, owner: "", signoff: Unsigned }
}

fn owned(rn: RoadmapNode, owner: String) -> RoadmapNode {
  RoadmapNode { node: rn.node, line: rn.line, carriers: rn.carriers, sizing: rn.sizing, owner: owner, signoff: rn.signoff }
}

fn with_plan(rn: RoadmapNode, path: String) -> RoadmapNode {
  RoadmapNode { node: rn.node, line: rn.line, carriers: concat(rn.carriers, plan_ptr(path: path)), sizing: rn.sizing, owner: rn.owner, signoff: rn.signoff }
}

fn sign(rn: RoadmapNode, s: Signoff) -> RoadmapNode {
  RoadmapNode { node: rn.node, line: rn.line, carriers: rn.carriers, sizing: rn.sizing, owner: rn.owner, signoff: s }
}

fn preamble() -> List<MarkdownBlock> {
  [
    HeadingBlock { level: H1, inlines: [TextInline { text: "gunbc — Roadmap" }] },
    ParagraphBlock { inlines: [TextInline { text: "`DESIGN.md` is the authority for *why*. This is the **shape of the work** — a scannable, dependency-ordered checklist. **Checkboxes are authoritative for progress**; detail lives in the linked plan docs — don't restate it here (no dual representations). A task's real state is its branch/PR." }] },
    ParagraphBlock { inlines: [TextInline { text: "Legend: `[x]` done · `[ ]` todo · ~~struck~~ **superseded →** successor (the named carrier/lane now owns the territory; the row is kept as the pointer, never dispatched) · **indentation = depends on the item it sits under**. Each section opens with a **◆ Milestones** spine — the *verifiable* checkpoints in dependency order (`✓` reached · `▸` now · `○` ahead); the checklist below is the work toward them. Read L→R = the path." }] },
    ParagraphBlock { inlines: [TextInline { text: "**Reset 2026-07-01 (operator-directed).** The roadmap is collapsed to **two pillars** — **§1 get off v1** and **§2 own the compute fabric** — plus **§3 the floor + audit**: the walls that keep both pillars honest, and an execution-grounded audit of what the existing machinery *actually does* (green by execution, red by perturbation). Everything else is **§4 shelved**: parked, not deleted — plan docs and carriers stay, no work dispatches from it, and un-shelving is a PR that moves a node into §1–§3 with a displaced-cost justification (DESIGN §6). The prior roadmap with full detail is in git history. Priority order, top = now." }] },
  ]
}

fn section_0() -> RoadmapSection {
  RoadmapSection {
    title: "0. Priorities — current execution order (rearranged 2026-07-06)",
    elements: [
      section_prose(content: "The two pillars — §1 get off v1, §2 own the compute fabric — stand as the strategic goal. This section is the **current priority ordering** over them and the walls that keep them honest, rearranged 2026-07-06 to **frontload the compile wall and complexity enforcement**: fix what blocks CI now, then make the regression classes *unwritable* before they recur (construction over after-the-fact catching, DESIGN §5). Each item points into the detailed lane; work dispatches from the lane, not from the pointer. Lanes marked *un-shelved* here are moved out of §4 by this ordering."),
      section_prose(content: "**① Compile wall** — the acute blocker. The `.dag` compile-clean floor runs **100+min** (#6239), past the CI job kills, so every PR is red on the floor and the rust-gate timeout thrash (the 10-min-drift #6339 + witness #6342, 2026-07-06) is a *downstream symptom* of the wall outgrowing the step budgets. Levers, in leverage order: affected-set-scope the compile-clean to the changed node-closure (→ ③), cross-run resolve memoization, per-module shard so `spawn_width` finally applies to the dominant node. Detail: §2 *kill the serial compile-clean wall*."),
      section_prose(content: "**② Complexity enforcement, whole codebase** *(frontloaded — un-shelved from §4)*. Make the regression classes unwritable, not caught-after: the **repo-wide complexity budget**, the **enforcement-intent gate** (`StandingIntent` ⇄ `LensContract` ⇄ `CoverageReceipt`, fail-closed — a mechanism *claiming* enforcement is complete only when the gate proves it from receipts), **intent-linearity** (model the axioms A1–A3 and enforce the syllogism — every claim a consequence-chain back to an axiom, no orphan and no cycle; [draft](docs/plans/intent-linearity-design-draft.md)), and the **gap analysis** — which regression classes *cannot* be caught yet (the expressibility frontier: wall vs lens vs review; [frontier](docs/plans/expressibility-frontier.md)). Detail: §3 *enforcement intent + model-quality walls*; §4 *complexity budget whole-codebase* + *fail-closed meta band* (promoted here)."),
      section_prose(content: "**③ Affected set live in CI** — per-PR selection that shrinks the floor to the changed node-closure and returns witness enrollment to affected-set-shrunk discovery (today enrollment is opt-in *because* selection is not live — itself a compile-wall multiplier). Obligations: soundness (a skipped-but-affected witness is the fail-open catastrophe), effectiveness receipts on real scoped diffs, fail-closed default on a provenance gap. Detail: §2 *affected-set de-fork*; §3 *affected-set lens*."),
      section_prose(content: "**④ Realization** — inhabit the content-addressed carrier so caching, memoization, and provisioning all *derive* from one content-hash instead of N hand-rolled caches (v2 still hand-rolls `ParseTable`; floor shared-compute memoization is a Realization arm; DESIGN §2). Includes the **dag↔v2 de-fork grounding** — the fixed point must be well-defined over ONE algebra. Includes **execution-as-realization** (operator-affirmed 2026-07-07): `run ≜ realize ∘ materialize ∘ dependency_view` ([spine](docs/plans/execution-spine-design.md)) — interpreted-vs-compiled is a per-node realization *policy*, not an architecture. The interpreter is the pay-every-run realizer; the emitted native artifact is the pay-once-per-content-hash one, so **emit-on-demand** (emit closure → build → run, artifact `Share`d by content-hash) is the canonical execution path for a closed static substrate — no bytecode VM, no JIT (nothing dynamic left to profile; DESIGN §4). The tree-walker's surviving roles (bootstrap S1 receipts · compile-time eval) are bounded scaffolds dissolving with §1 self-hosting. **Materialization placement is derived, never hand-added (operator, 2026-07-09 — the state×decision ladder, `std.materialization_ladder`):** demand is read off ONE *nested* DependencyView — scopes nest eval → plan → process → emitted shell → CI run, a 'run' at any layer being a frame one scope up, never a different kind of thing (every layer is emitted from the same substrate, so the qualifier reaches all of them: it injects a content-hash skip into emitted shell as readily as a `Share` inside the plan). The law: plurality of demand per identity per frame decides — 0×pure = dead code, 0×effect = the effect is the use, 1 = Recompute, ≥2 with shared-state LCA = authored duplication (ERROR, rewire), ≥2 across isolation = memo obligation at the LCA that MUST be discharged by a covering content-keyed provider with declared eviction (`ScopeExit` scoped / `SpacePacked` persistent — dropping pure facts is always sound); *declared-emergent* frames (retry replay, unbounded siblings: server loops, CI-runs-over-time) obligate UP FRONT — expected emergent redundancy unprepared-for is an error, unexpected emergence is typed acceptance that converts to a declared row next run; an `ExistenceKeyed` provider is refused (existence ≠ identity — the build-if-absent red, #6352); a redundant `WorldRead` without a declared staleness envelope is refused (a TTL is a confession: unmodeled dependency or undeclared staleness). Un-shelves §4 *caching completion*'s 'one Materialization kernel'; subsumes ①'s 'cross-run resolve memoization' and §2's 'NOT cross-run caching' into per-node derived verdicts; §3-convergence: `v1.compiler.ownership`'s `binding_fan_out` is the eval-frame instance (Threaded-excluded plurality; SoleOwner/SharedError), retiring with the seed. Displaced cost already paid: the 9 GB retain-forever resolve store · build-if-absent stale binary · the ~275s double-resolve · the 3× CI release build. Detail: [duplicate-work](docs/plans/duplicate-work-graph-lens-design.md). Detail: §1 *de-fork grounding cluster* + *emit-on-demand execution*; §2 shared-compute memoization."),
      section_prose(content: "**⑤ Everything linear / efficient / minimal — dev UX** *(un-shelved from §4)*. The authoring experience is minimal and non-redundant: **fold-ergonomics** (inert-abstraction lens, non-fold-residue audit, ban source comments), **namespace-only resolution** (minimal naming, delete `import`, no ambiguity — operator-signed 2026-07-06, its two rules *are* the §2/§4 minimality + no-ambiguity walls; gated on the `SymbolIndex` substrate; [design](docs/plans/namespace-resolution-design.md)), and local iteration speed. Detail: §4 *fold-ergonomics lane* (promoted); the namespace-only lane."),
      section_prose(content: "**In-flight lane snapshot (2026-07-22, silent-ibex-417 — effect-grants):** dissolving the forked `Hermetic | Wet | Record` bit into the (frame × verb × subtree) grant model (DESIGN open thread; not a pillar item). P-A/P-B landed; **P-C slice 1 MERGED (#6987)** (derived axes + presets), **P-C slice 2 in review (#7071)** (per-grant `HandlerBinding` selection — 2 approvals, mergeable, CI running). Remaining: `LiveTreeDisposition` stamp-retire (blocked on an operator path-A/B decision), `Hermetic|Wet|Record` enum deletion (gated on slice 2 + stamp-retire), hermetic-native run + network isolation (deferred behind a target-env trigger). Full PR ledger + blockers: [effect-namespace-grants §4](docs/plans/effect-namespace-grants.md)."),
    ],
  }
}

fn section_1() -> RoadmapSection {
  RoadmapSection {
    title: "1. Get off v1 — v2 self-hosts (TERMINAL: `src/v1` deleted)",
    elements: [
      section_prose(content: "Anchor (do not flip-flop): `.dag` = truth; v2 emits its own seed (no stage0 hand-edits); the trust chain is discharged by execution; then the hand-written seed is deleted. Terminal is **hand-written compiler logic → 0**, not zero bytes of Rust: a pinned v2-emitted bootstrap kernel (~8–15k LOC — `claim_executor`, evaluator host-physics, the regen oracle) survives as the content-addressed seed. → [plan](docs/plans/v2-self-hosting.md) · [de-fork audit](docs/plans/dag-v2-defork-audit.md) · [seed census](docs/plans/seed-shrink-census.md)"),
      section_prose(content: "Ground truth (2026-07-05): `src/v1` = ~174k hand-written `.rs` LOC (the ~154k figure in older docs is stale) + 44 `.dag` files of v1's own modeling; `src/v2` = 874 `.dag`, zero `.rs`. HAND_MAINTAINED roster went 24 → 7 files and has REGROWN to 25 (re-measured 2026-07-23: native-routing shims + governor/pre-push seeds, each with its own dissolution trigger) + `module_path_index` (~22.3k LOC: the three lens projections drained #6158/#6211/#6212; `phase_profile.rs` ADDED 2026-07-04 with its own dissolution trigger); `patch_*` is fully dead in-tree; the `dag_collect` pair briefly went HAND-only in #6262's regen unbreak, then RETURNED to GENERATED in #6239 (registry authority verified 2026-07-05: `regen_stage0.rs` GENERATED includes the pair, HAND count 7, witness pins 92). The regen gate now proves fresh-vs-committed byte-identity unconditionally in CI (#6957/#6958, 98/98 files), so emitter improvements are no longer latent and cargo-green is continuous by composition (see 5-regen-cutover / 5-cargo-green-continuous, closed 2026-07-23) — today's walls are that identity + well-typed emit. INTERIM (operator-accepted, 2026-07-05): the CI floor's compile-clean step cannot complete inside its 10-minute step budget (#6232; restructured #6273 so a breach fails the STEP loudly instead of cancelling the job silently, and `rust_tests` fits at 30min) while compile-clean runs ~40+min, — DISCHARGED since (2026-07-23): compile-clean is CI-scoped per import closure and regen `--verify` is a required CI step, so the walls are CI-proven now."),
      section_prose(content: "**◆ Milestones:** front-end ✓ · emit-rust well-typed ✓ · cross-tree import ✓ (#5473) · emitted crate cargo-green, 0 rustc errors ✓ (#5777/#5873, re-verified #6099; fresh emit re-greened and byte-identical to the committed seed since #6958) · `regen --verify` in CI ✓ (#5873) · interim fixpoint gate, 2-of-92 roster ✓ (#6009) · full-roster 92-file byte-fold + host-grounded digest ✓ (#6218) · v1 self-resolution: #6235 arm fixed ✓ (#6250) · #6241 `get`-registry arm ✓ (#6255, operator-resolved collision) · #6242 comment/registry break ✓ (#6262 — third dark-regen break in four days) · emitter mass fix ✓ (#6243 merged 2026-07-05: the 1667-error fresh-emit red root-caused to ONE `field_is_boxed` predicate bug = 1482 of 1667, plus the 139-error alias-brand/use-line import class; #6266 = byte-identical template hygiene) → regen `--verify` required in CI ✓ (#6957/#6958 — 98/98 byte-identical fresh-vs-committed) → **▸ NOW: the three-gate v1-deletion bar (dag/gunbc/v1_deletion_plan.dag — emitter fixed point · honest frontier · ledger green)** → seed-honesty (DDC — see the prereq-drift flag on 5-collapse-v1) → **TERMINAL: `src/v1` deleted**"),
      section_group(
        label: "",
        nodes: [
          authored(id: "5-regen-cutover", done: true, content: "**regen-cutover cadence — closed by construction (audit 2026-07-23)**: `regen --verify` is a required CI step, green on every main push; #6957/#6958 moved rustfmt normalization to production emit, so all 98 generated files are byte-identical fresh-vs-committed and the two-generation latency this cadence existed to absorb is unwritable. The July-5 cargo-RED/cutover-blocked receipts died with #6243. Forward fixed-point work lives in the v1-deletion plan (^regen_fixed_point_receipt)."),
          superseded(id: "5-real-fixpoint", by: "dag/gunbc/v1_deletion_plan.dag ^emitter_fixed_point + ^regen_fixed_point_receipt", content: "**real fixed point** — re-based to the behavioral 2-generation bar (byte-fixpoint an explicit non-goal, #6922/#7092); the landed byte-fold half (#6218) lives on as the required ci_regen gate. Residual the successor does not carry: generate_stage_candidate_from_ingest has zero consumers (candidate_generation.dag)."),
          authored(id: "5-dissolve-patches", done: false, content: "**drain the HAND_MAINTAINED queue** — re-measured 2026-07-23: 25 files + `module_path_index` (regrown from 7 by pre_push, memory_governor, census_exclude_derive, std_lens_verdict, 3 usv_pilot files, and 10 v2_compiler_* native-routing shims — each landed with its own dissolution trigger; drain as the triggers fire). The cli_run.rs drain has its own plan: [cli_run.rs hollowing, #7084](docs/plans/cli-run-hollowing-plan.md)."),
          superseded(id: "5-emit-on-demand", by: "witness-realization lane — v1_deletion_plan ^witness_realization_kernel / ^witness_family_fanout · docs/plans/witness-realization-plan.md", content: "**emit-on-demand execution** — landed there by execution: kernel #6879, family fanout #6893/#6894/#6895/#6917, native path 9/9 families green + falsifier wet-cadence enrollment #6990, one-build-grain #7042, artifact store #6738; carrier src/v2/std/emit_on_demand.dag. The S1-parse-census first-customer framing is obsolete."),
          derivable(id: "5-dual-rep-lens", prs: [6104], title: "**no-dual-representation-test lens rebuilt pure-v2**", description: "— lens verdict moves off v1 Rust, the lens-E retirement pattern continued (landed #6104)"),
          authored(id: "5-defork", done: false, content: "**de-fork dag ↔ v2 grounding cluster** (one std authority — the fixed point must be well-defined over ONE algebra): `algebra` first (LIVE fail-open, 75 floor entries) → effects/float/integer/logic → `nat` LAST. Operator rulings stand: coproduct = structural authority; grounded-realization wins. The cost of not de-forking is no longer theoretical: the `extdeps.shell` dag↔v2 fork silently shadowed `shell.Which` in the two-root module index and kept main red from #6097 until the de-fork hotfix. [brief](docs/plans/dag-v2-defork-audit.md)"),
          authored(id: "5-root-b", done: false, content: "**Root B repoints** — def-unification (coproduct authority + aliases) → repoints (algebra/nat/integer/float/logic/effects/verification) → 🟡-marker dissolution (keystone #5552 merged)"),
          authored(id: "5-v1coupled", done: false, content: "v1-coupled `coercion`/`node` renames — deferred to v1-delete"),
          authored_wi(id: "5-test-migration", done: false, content: "**test-migration lane** — live debt per the `v2.lens.test_migration_debt` shrink-only ratchet: 73 v1 test modules / 731 `#[test]` fns / ~23k LOC with no exact-stem floor witness (baselines 77/912/28546 set 2026-07-02; `pipeline.rs` alone is 417 fns, the dominant unit); the delete-guard blocks removing a v1 test module without its floor witness (hard gate per module, bulk-delete forbidden). **Scrutinize before migrating (operator, 2026-07-05): tests are not inherently valuable — triage each module first (migrate · delete-as-redundant · delete-as-low-value); the guard currently requires an exact-stem witness for ANY delete, so the lane's first deliverable is a typed retirement path through the guard, never a bypass.** Parallelizable now; gates the terminal collapse per module. NOTE: migrated witnesses run on the local discovery path — CI enrollment is opt-in (#6232) until affected-set selection lands. UPDATE (2026-07-05): the typed retirement path LANDED (#6261 — `RetirementDisposition` model, guard union, import-bound `covered_by`), and the first drain tranche merged the same day (#6268/#6270/#6271/#6272: complexity-bounds, transport_emit, scrambled_name, self_gen8 clusters; baselines ratcheted 912→881 fns / 28546→28054 LOC, tightening further at each rebase). Triage finding so far: the delete mass concentrates in the `pipeline.rs`/`parse.rs` batteries (~64% of debt fns); the small-module tail mostly guards real v1 behavior whose dag/std concept exists but is UNWITNESSED — genuine migration work, not deadweight.", intricacy: IntricacyMedium, volume: VolumeLarge, repo: "gunbc"),
          authored(id: "5-emitted-crate-partition", done: false, content: "**emitted crate partition** — derived partition LANDED #6747: v2.workflow.rust_crate_partition grounds on the self-host frontier roster → stage0_crate_partition_generated.dag → consumed by src/v1/stage0_crates.dag, proven by build + regen_verify. Remaining open: the rows are a HandExplicit interim (dissolve-on: PolicyPartition) and interface Node grounding is deferred (stage0_module_dag_interface_grounding debt note). [design](docs/plans/emitted-crate-partition-design.md)"),
          authored(id: "5-cargo-green-continuous", done: true, content: "**make cargo-green continuous (or cheap)** — resolved by construction, neither named option: post-#6958 the fresh emit is byte-identical to the committed seed (98/98, production-side normalization), the required ci_regen step proves that identity on every main push, and CI builds the committed seed every run — so fresh-emit cargo-green is continuous by composition; the named failure mode (bytes stable per the old seed, fresh build broken) is unwritable. Residual cleanup: route_a_emit_fresh_cargo_green_test still #[ignore] — keep-as-local or delete."),
          authored(id: "5-seed-honesty", done: false, content: "**seed-honesty discharge** (Diverse Double-Compiling) — modeled in `bootstrap.dag` (`SeedHonestyDischarge`), no execution exists; worse, the modeled witness is fail-open by construction (its evidence argument is the same atom it checks against — Holds trivially, no red case constructible) until Stage 3's executing consumer lands. Needs a reproducible artifact to double-compile. Design proposal (second-compiler candidate `ddc_reference_compiler` + computed fixed-point digest, reusing `self_host.dag`'s `canonical_emitted_bytes_digest`; FLAGs A–D open for operator sign-off): [seed-honesty discharge design](docs/plans/seed-honesty-discharge-design.md)"),
          superseded(id: "5-collapse-v1", by: "dag/gunbc/v1_deletion_plan.dag ^v1_quarantine + ^v1_delete (three-gate bar, #6922/#7092)", content: "**TERMINAL — collapse src/v1** — the deletion bar lives in the three-gate plan (GateEmitterFixedPoint · GateHonestFrontier · GateLedgerGreen) with frontier.dag (#7058) carrying per-module dispositions. PREREQ DRIFT ruled 2026-07-23 (prereq_drift_ruling_2026_07_23 in v1_deletion_plan.dag, PR #7110): the three gates are the interpreter-deletion bar and correctly omit all three; the terminal claims restore them as GateDeletion bricks — hand_queue_drain before v1_quarantine, test_migration + seed_honesty_decision before v1_delete."),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "5-real-fixpoint"), parent: nid(s: "5-regen-cutover") },
          RoadmapEdge { child: nid(s: "5-dual-rep-lens"), parent: nid(s: "5-dissolve-patches") },
          RoadmapEdge { child: nid(s: "5-root-b"), parent: nid(s: "5-defork") },
          RoadmapEdge { child: nid(s: "5-v1coupled"), parent: nid(s: "5-defork") },
          RoadmapEdge { child: nid(s: "5-seed-honesty"), parent: nid(s: "5-real-fixpoint") },
          RoadmapEdge { child: nid(s: "5-collapse-v1"), parent: nid(s: "5-real-fixpoint") },
          RoadmapEdge { child: nid(s: "5-collapse-v1"), parent: nid(s: "5-dissolve-patches") },
          RoadmapEdge { child: nid(s: "5-collapse-v1"), parent: nid(s: "5-test-migration") },
          RoadmapEdge { child: nid(s: "5-collapse-v1"), parent: nid(s: "5-seed-honesty") },
          RoadmapEdge { child: nid(s: "5-collapse-v1"), parent: nid(s: "5-defork") },
        ],
      ),
    ],
  }
}

fn section_2() -> RoadmapSection {
  RoadmapSection {
    title: "2. Compute fabric — own the infra (CI · deploy · control plane)",
    elements: [
      section_prose(content: "State (2026-07-01): required CI is back on the fleet after the Ubicloud detour (#6107, reverted #6111). The detour was the **diagnostic and emergency valve, not a failure**: it proved raw VM isolation alone does not solve a serial floor (same ~50min wall on both runner types), and it stays the **break-glass/burst option**, just not the active required path. So the active work is (1) reduce floor recompute, (2) make fleet admission/caps safe — the dominant wall-clock is inside the floor, not host placement alone. The fleet — srv1/srv2 (128c/125GiB Ampere) + srv3 (greenfield, OpenBMC) — carries agent sessions, the dashboard, and all runners, with live cgroup caps, runner registration, sudoers, and tailscale-ACL actuation still **hand-managed**; the fleet-era OOM/sccache exposure returned with the traffic (operator-accepted interim). #6096 (fleet converge control plane) was **closed unmerged**; its review gap-list is the re-land spec, and the findings apply to the committed `.github/fleet-converge.sh` too (mutate-then-read, `|| true` swallowing, no hostname dispatch) — the re-land is an architecture change, not a rebase. → [CI humming](docs/plans/ci-humming.md) · [host-effect orchestration](docs/plans/host-effect-orchestration.md) · [compute envelope](docs/plans/compute-envelope-model.md) · [charter](docs/plans/ci-process-end-to-end.md) · [host-converge inventory](docs/plans/host-converge-inventory.md)"),
      section_prose(content: "**The core design rule (operator-signed, 2026-07-01):** provider-specific power is earned behind a `ProviderOffer` adapter; the core fabric only knows `RunShape → Allocation → Receipt`; default allocation is **strict/ephemeral**; oversubscription is an optimization proven by receipts, never assumed by placement. Not \"Ubicloud vs fleet\" — GitHub Actions asks for a RunShape, the fabric chooses a ProviderOffer (srv1/srv2 fixed-host slice, Ubicloud ephemeral VM, or later others). srv1/srv2 are modeled as little Ubiclouds first (N strict slots, hard caps, read-back receipts); their richer allocation opportunity (stranded cores, burst, co-residency) is Phase 2, earned by receipts."),
      section_prose(content: "**◆ Milestones:** OOM root-caused (hand-set caps vs measured peaks + budget double-count) ✓ · Ubicloud stabilization trialed ✓ (#6107) → reverted, operator call (#6111 — no wall-clock win; width=9 was live by construction and never touched the serial wall) · converge shell emitted ✓ (#5725/#5827) · `apply()` Phase A ✓ (#5756) · CD to srv1 ✓ (#6030/#6060/#6093) · witness-level affected-set pruning LIVE ✓ (#6061) → **▸ NOW: kill the serial compile-clean wall · floor <1min · CD wrong-host fix · stateless-frontend MVP (first non-CI fabric consumer) · converge re-land to the signed design** → srv1/srv2 runner-allocation v0 (hand-config retired) → StrictLease + shape labels → dormant-Ubicloud provider row (design-break probe) → periodic actuation with receipts → srv3 OsInstalled · `apply()` Phases B–D → **TERMINAL: required CI runs on the compute fabric — the model can choose any admitted ProviderOffer, the receipt proves the shape was honored, and install/manage/decom all ride `apply()` with fail-closed receipts**"),
      section_prose(content: "**Acceptance rule (operator, 2026-07-02): an item is not complete because its algebra exists — it is complete only when a NAMED consumer uses it on the LIVE path and produces a receipt** (DESIGN §5: a typecheck or a grep is not a consumer). Completion tiers: **T0** modeled · **T1** fixture/synthetic witness · **T2** wired to the intended consumer (proof by consumption, never grep) · **T3** live dry-run receipt · **T4** live apply + independent read-back receipt · **T5** a periodic/CI consumer keeps it alive. Every dispatchable node states **Accept:** — its required tier plus an operator-checkable end state on the real fleet (what is different on srv1/srv2 or in CI afterward) plus a discriminating RED; control-plane/fabric items close at **T4/T5**, and anything below the named tier is a subtask, never completion. A sized node without an explicit Accept is not ready to dispatch; algebra, carriers, and lenses are mechanisms and never their own acceptance. The bar for real progress: *can srv1/srv2 runner allocation be changed through the model, read back, re-run safely, and retracted?* Until yes, the work is scaffolding. Full per-node checklists: [fleet acceptance criteria](docs/plans/fleet-acceptance-criteria.md) — the node's Accept line is the summary, the doc is the checklist, and edits to one land with the other."),
      section_group(
        label: "Now — correctness of the current posture",
        nodes: [
          owned(rn: authored_wi(id: "2-cd-transport", done: true, content: "**fix the CD transport premise — a deploy needs a target-host proof** — `deploy_dashboard_srv1` is a *srv1 effect*, but job placement is not an srv1 *proof*: `LocalShell` with principal `runner` assumed the runner is ON srv1 (#6093), while `[self-hosted, linux, arm64]` can land on srv2 (and during the Ubicloud window it was a rented VM). A `LocalShell` deploy is valid ONLY when the runner identity proves it is already on srv1 — either pin the job to an srv1-specific trusted runner label, or make the effect `SshShell`-over-tailnet with an explicit srv1 target + typed credential (#6066 Phase 2). Until then every main push gambles the deploy host.", intricacy: IntricacyHigh, volume: VolumeSmall, repo: "gunbc"), owner: "dispatched 2026-07-01 · adhoc-75790c4c-4e0"),
          with_plan(rn: ticket_wi(id: "2-dispatch-actuator", done: false, t: TicketFields {
            headline: "roadmap dispatch actuator",
            brief: "The dispatch machinery is landed and live: the first end-to-end dispatch ran on srv1 by execution, the button reads the belt-B status contract, claude preflight refuses typed, and tmux read-back is the independent witness.",
            displaced_cost: "a ready roadmap row becomes a working session in one click, with refusals typed instead of mystery hangs",
            current_state: "live since the #7096 go-live receipt: belt A #6942, belt B gunbc serve #6940, single dispatch authority #6914, spawn/observe/reap #6836",
            first_slice: "(landed) — remaining work tracks the T4 accept",
            red_control: "a bogus node id answers node_not_found live; a missing claude dies behind typed spawn_failed preflight steps",
            out_of_scope: "Stop verb and GET /sessions (PR-B); re-dispatch after Stop (ts-dispatch-redispatch)",
            handback: "T4 accept rows that need operator signoff",
            updates: [
              TicketUpdate { on: "2026-07-23", note: "go-live receipt collected on srv1" },
              TicketUpdate { on: "2026-07-24", note: "remaining vs T4 accept named: no Stop verb, no GET /sessions surface, re-dispatch one-shot-broken" },
            ],
            authored_on: "2026-07-20",
            last_verified_on: "2026-07-23",
          }, intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc"), path: "docs/plans/dispatch-maintain-cc.md"),
          authored_wi(id: "2-admission-model", done: false, content: "**workload-class admission model** *(operator directive, 2026-07-01: 1 core → 3 GiB + swap)* — runners are capacity surfaces, not concurrency proof. Define CI workload classes (`floor_light` · `rust_heavy` · `deploy` · `session`) with measured RAM/swap/pids/CPU-token demand; **admitted concurrency per host derives from HostSupply × WorkloadClassDemand, never from runner-slot count**. Initial 128c/125GiB policy: ~42 build tokens per host (≈1 core : 3 GiB, the `ubicloud-standard-16-arm` shape generalized), with intentionally-stranded cores reserved for sessions and low-memory work — stranded is not wasted. Measured anchors: ci ~11GiB · rust_tests ~37GiB peaks vs the old 8G slot caps. **Accept:** admitted concurrency for srv1/srv2 derives by execution from HostSupply × WorkloadClassDemand (witnessed, not hand-set to match), and a proposed allocation whose Σ exceeds supply is REFUSED with a typed verdict — perturb: inflate one class's measured demand and admission shrinks.", intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc"),
          authored(id: "2-cap-deconflation", done: false, content: "**cap/admission de-conflation** — re-based 2026-07-23: the three facts now live in three mechanisms — per-slot containment = cgroup caps via converge (#7009/#7000) · host admission = fleet_host_budget conservation (host_allocation_conserves) · build width = the runtime AIMD memory governor (2026-07-12 adaptive-width ruling, which retired the width folds and per-shard byte predictions the original framing assumed). Remaining ask: a receipt that the three mechanisms cover the original knobs with no conflated survivor, or re-home the residue."),
          authored_pp(id: "2-merge-admission", done: false, content: "**merge-admission gate: close the HELD state** — wired (#5974/#6080) but the freshness block is HELD pending a real green-on-main receipt, and the #6080→#6101 accidental re-apply/re-revert needs a clean landing. Evidence it is needed: stale-base merges landed BOTH `.gitignore` drift (healed #6110/#6111) AND the `extdeps.shell` collision that kept main red — green-on-branch is not green-on-main.", carriers: [ptr(label: "decision record", path: "docs/plans/ci-merge-freshness.md")]),
          authored_wi(id: "2-stateless-frontend", done: false, content: "**stateless frontend MVP on fabric** — milestone (A) LANDED: roadmap static site served on srv1 (#6128) + healthz REST GET readiness edge (#6753) + bounded read-back (#6769) + roadmap_site_healthz_validate; live_deploy apply/retract on the membership spine (#6814/#6940/#7011). REMAINING: milestone (B) fabric SiteLease on the same allocation model as CI (waits on the control-plane read-back); the public-domain discharge (gunb.ai Pages cutover) is assigned to the site-subsumption lane and has NOT merged yet.", intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc"),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "2-stateless-frontend"), parent: nid(s: "2-cd-transport") },
        ],
      ),
      section_group(
        label: "SCM — node-grain source control, visibility-first (operator-directed 2026-07-25)",
        nodes: [
          with_plan(rn: authored_wi(id: "2-scm-visibility-stage0", done: false, content: "**repo visibility NOW — the `Publish`/`Reference` grant model implemented properly, realized over git public/private roots** — operator plan (2026-07-25): land the real grant algebra (visibility design P-A model + P-B enforcement), with today's realization = two git storage roots (public + private overlay), file-grain `Publish` declarations, the push-time guard wall, and the one-time bulk stamp (`Publish \{ audience: World \}`) of the already-public corpus so the narrowest default only ever bites new content. The SAME grant interface is later carried unchanged by the node-grain SCM — a git repo is one storage realization of the grants, never the model. **Accept:** T3 — a planted `Publish`-violating file REDS the push guard by execution and never reaches the public root; an undeclared new file refuses loudly (narrowest default); the stamped corpus round-trips public unchanged; RED control: delete one grant row → the guard refuses.", intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc"), path: "docs/plans/node-subtree-visibility-grants.md"),
          with_plan(rn: authored(id: "2-scm-publication-ladder", done: false, content: "**publication ladder + locked realizations (design)** — `Publish` refines from a boolean to a rung: full source · emitted-artifact-only · ciphertext+interface (locked) · interface-only · commitment-hash · absence. Locked nodes ship in-artifact encrypted at the subtree boundary (plaintext residue = interface at the cut + commitment), per-audience key-wraps on the `AudienceScopeTree`, decrypt-then-VERIFY against the commitment (wrong key = typed `KeyMismatch`, never garbage admitted), keyless reach = `LockedNodeUnrealizable` — a counted `LockedBlocked` witness state, never a silent skip or stubbed default (§5). Churn blinding: salted (hiding) commitments re-randomized per release for secrets-as-code; the stable `SecretRef` wrapper stays reserved for secrets-as-material (wrapping CODE in it would break content-addressed determinism — the stable-identity × changing-secret × public-verifiability pick-two); crypto-shred (key destruction) is the erasure story for PII-typed nodes, and type-derived grants (`Secret`/`Pii` ⇒ narrowest `Publish` by construction) beat any scanner. Design-only until Stage 0 lands."), path: "docs/plans/dag-scm-design.md"),
          with_plan(rn: authored_wi(id: "2-scm-node-merge", done: false, content: "**node-grain SCM core — merges/conflicts at node identity, git as the compatibility surface** — merge = keyed diff over node identity (`std.change.keyed_two_way_diff`, the membership-reconcile spine precedent — one diff authority, never a text fork): conflicts locate at nodes, not textual hunks — finer grain, fewer conflicts, fewer tokens spent resolving them. The git interface is preserved as ONE storage realization (ingest/emit git trees via the same grammar-both-directions machinery, §4), so adoption cost is a realization choice, not a rewrite. Binary provenance sorts three ways by construction: derived artifacts = materialization cache (never versioned source) · structured formats ingest where `DecodeFidelity` is `Lossless` (the LFS dual-store dissolves) · genuinely opaque leaves = chunked content-addressed bytes.", intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc"), path: "docs/plans/dag-scm-design.md"),
          authored(id: "2-scm-remote-realization", done: false, content: "**remote realization of withheld nodes — the SCM's CI** — a locked/interface-only node executes server-side through the same execution-as-realization spine (§0-④): interface public, realization hosted, effect envelope declared so admission works without decryption; metered per invocation (the protection mechanism IS the billing mechanism — the `gunbc.econ` metered-compute axis). Strongest secrecy placement (the consumer never holds the bytes); the oracle-extraction residue is priced by metering, never denied."),
          with_plan(rn: authored(id: "2-scm-infra-econ", done: false, content: "**storage + serving infra, economics-grounded** — content-addressed node store with N storage realizations (rides the module-identity storage-binding thread); serving surface rides `gunbc serve`/belt B. Launch economics are cited carriers, not guesses: the GitLab 10-K corpus (serving = 11–13% of revenue; the spend is S&M/R&D) and `gunbc.econ.free_tier_serving` (10k free users floor ≈ 2×AX41-1-LTD ≈ 115 EUR/month, witnessed; metered CI compute is the abuse axis — GitLab's 400-free-minutes fence is the receipt)."), path: "docs/plans/dag-scm-design.md"),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "2-scm-publication-ladder"), parent: nid(s: "2-scm-visibility-stage0") },
          RoadmapEdge { child: nid(s: "2-scm-node-merge"), parent: nid(s: "2-scm-visibility-stage0") },
          RoadmapEdge { child: nid(s: "2-scm-remote-realization"), parent: nid(s: "2-scm-publication-ladder") },
          RoadmapEdge { child: nid(s: "2-scm-infra-econ"), parent: nid(s: "2-scm-node-merge") },
        ],
      ),
      section_prose(content: "**Fabric-hostable rule (operator-signed):** a service is fabric-hostable when it is expressible as **immutable storage + stateless compute + explicit route + read-back receipt**; anything requiring local mutable state is not fabric-portable until its state moves into a `StorageBinding`. \"Connect the right users to the right resources\" is the fabric's future value, not active work: `RoutePolicy` (nearest/cheapest/least-loaded/trust), multi-replica routes, cert/DNS automation land later, when they hurt — the first version connects ONE domain to ONE admitted allocation and proves it did."),
      section_group(
        label: "Floor throughput — reduce work, then schedule it (26m → <1min on a typical PR)",
        nodes: [
          authored(id: "2-compile-clean-serial", done: false, content: "**kill the serial compile-clean wall** — re-based 2026-07-23: lever (a) LANDED — per-PR import-closure scoping via tools.dag_compile_clean_scope (2026-07-16) + loader-closure de-fork #6950; the cost picture moved under it (#7001 memory-thrash-not-compute · #6808 sigs-env 2461s→65s, 37.6× · #6999/#7030 namespace-walk fixes; width regime = adaptive governor). Remaining: lever (c) — shard A's compose proof landed but shards were never enrolled in the floor plan (2-compile-clean-shard-b, re-price first); whole-tree baseline runs still pay the serial wall on the falsifier/cold cadence."),
          ticket_row(id: "1-wallclock-measured", done: false, t: TicketFields {
            headline: "floor wall-clock on a scoped PR — target under 1 min",
            brief: "The original headline (the floor is a full recompute every run) is discharged: witness-level affected-set selection is LIVE in CI (discovery flip, operator acceptance 2026-07-09; fail-closed selection + falsifier cold control) plus compile-clean closure scoping.",
            displaced_cost: "",
            current_state: "the 2026-06-24 profile numbers predate #6848/#6808/#6999 and are void; target unmet on cold/whole-tree paths",
            first_slice: "remaining lever is resolve-phase incrementality, re-based on current receipts",
            red_control: "",
            out_of_scope: "",
            handback: "",
            updates: [
              TicketUpdate { on: "2026-07-25", note: "migrated to ticket form (W2-bulk tranche 13)" },
            ],
            authored_on: "",
            last_verified_on: "",
          }),
          ticket_doc(id: "1-affected-set-defork", done: false, t: TicketFields {
            headline: "affected-set de-fork — v2.lens.affected_set as single authority",
            brief: "Witness-level run/skip live (#6061, v1 force_run_all hack retired).",
            displaced_cost: "",
            current_state: "",
            first_slice: "precompute-skip wired to the same one .dag query, the Rust parallel (NodeFrontierSeeds) deleted (N→1), and a wall-clock+RSS receipt on a scoped diff",
            red_control: "",
            out_of_scope: "",
            handback: "",
            updates: [
              TicketUpdate { on: "2026-07-25", note: "migrated to ticket form (W2-bulk tranche 13)" },
            ],
            authored_on: "",
            last_verified_on: "",
          }, path: "docs/plans/affected-set-precompute-pruning.md"),
          derivable_doc(id: "2-provenance-ingest", prs: [6105], title: "**provenance ingest live at floor runtime**", description: "— successor lane: resolver S2a + skip-before-resolve remaining fix (PR #6105 closed 2026-07-02 measured work-neutral); node-closure grounding for `v2.lens.affected_set` to be live during the floor pass; gates node-level pruning + the Rust-bridge deletion", path: "docs/plans/affected-set-precompute-pruning.md"),
          derivable_doc(id: "2-host-scaffold-classifier-defork", prs: [6224, 6479], title: "**host-scaffold witness classifier de-fork — DONE**", description: "— the claim_executor Rust text classifier (`witness_test_fn_uses_live_host_scan`) and the interim `floor:host_scaffold` marker are dissolved into the substrate-declared `LiveTreeDisposition` row (#6479). Placement correction vs this row's original wording: the disposition lives as a `data live_tree_disposition` row in the WITNESS ENTRY FILE (`v2.std.live_tree`), not as a field on `TestClaim` rows — a claim row asserting a foreign entry's liveness would be a second carrier of the same fact (§3 dual representation); the entry's own row is the single authority. Undeclared = ReadsLiveTree = never predict-skip (fail-closed); the nightly affected-set falsifier is the enforcement for lying declarations; call-reachability grade re-derivation is the later lane", path: "docs/plans/affected-set-precompute-pruning.md"),
          owned(rn: authored_wi(id: "2-compile-clean-shard-a", done: true, content: "**compile-clean shard A — partition boundary + ONE shard + compose proof** — the direct attack on the serial wall (lever c above): identify the module partition boundary for `dag_compile_clean_gate`, run ONE module shard (manually or via minimal wrapper), and prove the shard verdict composes with the existing whole-tree gate (a shard-green ∧ … ∧ shard-green tree is whole-tree green, and a broken module reds its shard). Non-goals: NO floor-plan/scheduler integration, no width tuning. The partition receipt is the deliverable even if enrollment never follows.", intricacy: IntricacyHigh, volume: VolumeSmall, repo: "gunbc"), owner: "dispatched 2026-07-01 · adhoc-3e95c046-279"),
          authored_wi(id: "2-compile-clean-shard-b", done: false, content: "**compile-clean shard B — enroll shards in the floor plan** — batch-1 becomes N shard nodes so `spawn_width` finally applies to the dominant cost; before/after batch-1 wall-clock receipt on a real run. Gated on shard A's compose proof. **Accept ([checklist](docs/plans/fleet-acceptance-criteria.md)):** the floor plan CONSUMES the shards (shard A's exemplar is not sharding); every shard derives from the same source-root authority as the whole-tree gate; compose(shards) ≡ the whole-tree verdict on a green tree, a planted bad module fails the composed verdict, an empty roster is Unknown/fail-closed; receipt = before/after batch-1 wall-clock + shard count; RED: drop one shard from the roster → the coverage witness fails.", intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc"),
          ticket_row(id: "1-double-resolve", done: false, t: TicketFields {
            headline: "kill the within-run double-resolve",
            brief: "Discovery and execution each resolve the corpus (~275s second pass); execution piggybacks the discovery resolve. Pure within-run win.",
            displaced_cost: "",
            current_state: "M1 within-walk memo landed #6008 — this is the cross-phase half",
            first_slice: "",
            red_control: "",
            out_of_scope: "",
            handback: "",
            updates: [
              TicketUpdate { on: "2026-07-25", note: "migrated to ticket form (W2-bulk tranche 13)" },
            ],
            authored_on: "",
