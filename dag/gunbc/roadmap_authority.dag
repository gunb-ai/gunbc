        ],
        edges: [
          RoadmapEdge { child: nid(s: "2-stateless-frontend"), parent: nid(s: "2-cd-transport") },
        ],
      ),
      section_group(
        label: "SCM — node-grain source control, visibility-first (operator-directed 2026-07-25)",
        nodes: [
          with_plan(rn: ticket_wi(id: "2-scm-visibility-stage0", done: false, t: TicketFields {
            headline: "repo visibility NOW — the Publish/Reference grant model implemented properly, realized over git public/private roots",
            brief: "Land the real grant algebra (visibility design P-A model + P-B enforcement), with today's realization = two git storage roots (public + private overlay), file-grain Publish declarations, the push-time guard wall, and the one-time bulk stamp (Publish audience: World) of the already-public corpus so the narrowest default only ever bites new content. The SAME grant interface is later carried unchanged by the node-grain SCM — a git repo is one storage realization of the grants, never the model.",
            displaced_cost: "",
            current_state: "",
            first_slice: "",
            red_control: "Accept: T3 — a planted Publish-violating file REDS the push guard by execution and never reaches the public root; an undeclared new file refuses loudly (narrowest default); the stamped corpus round-trips public unchanged; RED control: delete one grant row → the guard refuses",
            out_of_scope: "",
            handback: "",
            updates: [
              TicketUpdate { on: "2026-07-25", note: "operator plan authored this date; migrated to ticket form same day (W2-bulk tranche 18)" },
            ],
            authored_on: "2026-07-25",
            last_verified_on: "",
          }, intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc"), path: "docs/plans/node-subtree-visibility-grants.md"),
          with_plan(rn: ticket_row(id: "2-scm-publication-ladder", done: false, t: TicketFields {
            headline: "publication ladder + locked realizations (design)",
            brief: "Publish refines from a boolean to a rung: full source · emitted-artifact-only · ciphertext+interface (locked) · interface-only · commitment-hash · absence. Locked nodes ship in-artifact encrypted at the subtree boundary, per-audience key-wraps on the AudienceScopeTree, decrypt-then-VERIFY against the commitment (wrong key = typed KeyMismatch, never garbage admitted), keyless reach = LockedNodeUnrealizable — a counted LockedBlocked witness state, never a silent skip (§5). Crypto-shred is the erasure story for PII-typed nodes, and type-derived grants (Secret/Pii ⇒ narrowest Publish by construction) beat any scanner.",
            displaced_cost: "",
            current_state: "design-only until Stage 0 lands",
            first_slice: "",
            red_control: "",
            out_of_scope: "churn blinding detail preserved: salted (hiding) commitments re-randomized per release for secrets-as-MATERIAL only — wrapping CODE in it would break content-addressed determinism (the stable-identity × changing-secret × public-verifiability pick-two)",
            handback: "",
            updates: [
              TicketUpdate { on: "2026-07-25", note: "migrated to ticket form (W2-bulk tranche 18)" },
            ],
            authored_on: "",
            last_verified_on: "",
          }), path: "docs/plans/dag-scm-design.md"),
          with_plan(rn: ticket_wi(id: "2-scm-node-merge", done: false, t: TicketFields {
            headline: "node-grain SCM core — merges/conflicts at node identity, git as the compatibility surface",
            brief: "merge = keyed diff over node identity (std.change.keyed_two_way_diff, the membership-reconcile spine precedent — one diff authority, never a text fork): conflicts locate at nodes, not textual hunks — finer grain, fewer conflicts, fewer tokens spent resolving them. The git interface is preserved as ONE storage realization (ingest/emit git trees via the same grammar-both-directions machinery, §4), so adoption cost is a realization choice, not a rewrite. Binary provenance sorts three ways by construction: derived artifacts = materialization cache · structured formats ingest where DecodeFidelity is Lossless · genuinely opaque leaves = chunked content-addressed bytes.",
            displaced_cost: "",
