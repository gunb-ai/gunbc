fn ticket_row(id: String, done: Bool, t: TicketFields) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: TicketLine { done: done, ticket: t },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn ticket_wi(
  id: String,
  done: Bool,
  t: TicketFields,
  intricacy: Intricacy,
  volume: Volume,
  repo: String
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: TicketLine { done: done, ticket: t },
    carriers: [],
    sizing: Sized {
      intricacy: intricacy,
      volume: volume,
      repo: repo,
      acceptance: ManualAcceptance,
