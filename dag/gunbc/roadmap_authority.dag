          RoadmapEdge { child: nid(s: "2-runner-allocation-v0"), parent: nid(s: "2-converge-reland") },
          RoadmapEdge { child: nid(s: "2-runner-allocation-v0"), parent: nid(s: "2-host-admission") },
          RoadmapEdge { child: nid(s: "2-debash-orchestration"), parent: nid(s: "6-shell-emission") },
          RoadmapEdge { child: nid(s: "2-emit-partition"), parent: nid(s: "2-debash-orchestration") },
