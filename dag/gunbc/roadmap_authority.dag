          }),
          ticket_row(id: "ts-dispatch-verdict", done: false, t: TicketFields {
            headline: "typed review verdict is the only acceptance authority",
            brief: "Every dispatched item closes with the operator's three questions as the verdict's fields: (1) antagonistic product review — did the PR accomplish what the brief asked; what remains, what blocked, what planning updates follow; (2) modeling audit — what models it adds, whether it should add more, anemia check; (3) planning update — the verdict lands on this sheet so the next session inherits it (sessions are goldfish; the sheet is the anchor). Vocabulary: Accepted | AcceptedWithResidue (residue becomes counted rows, item STAYS OPEN) | NeedsRework (return to a named causal-arc segment + located debts) | Abandoned (reason).",
            displaced_cost: "merged residue with no row; AcceptedWithResidue is the honest form of the half-done merge",
            current_state: "vocabulary in hand use on this sheet; the typed carrier rides ts-wf-stage-artifacts",
            first_slice: "",
            red_control: "",
            out_of_scope: "the Verdict carrier types (ts-wf-stage-artifacts)",
            handback: "",
