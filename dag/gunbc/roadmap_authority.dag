      t: fields(
        headline: "Only call the machines 'managed' once all of it has really run",
        boundary: "This closes when applying for real, reading back, re-running safely, undoing, and the periodic check have all actually happened.",
        displaced_cost: "Stops a tidy model or a single successful run from being mistaken for infrastructure you can rely on.",
        first_slice: "Take one settled item from a live apply through to the periodic check.",
        red_control: "A missing read-back, an unsafe re-run, a failed undo, or a missed schedule blocks this.",
        out_of_scope: "No accepting this on made-up examples.",
        handback: "The full set of receipts and a machine state someone can go and verify."
      )
    ),
  ]
}

