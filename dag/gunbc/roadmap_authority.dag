            last_verified_on: "",
          }),
          ticket_wi(id: "3-audit-artifact-freshness", done: false, t: TicketFields {
            headline: "artifact-freshness gate",
            brief: "We half-have one: the per-PR drift gate proves committed==emitted for the PR's OWN tree, but drift still LANDED on main (.gitignore stale vs its authority since #6097; found and healed by #6110/#6111) because admission never re-validates against CURRENT main — green-on-branch is not green-on-main. The closing mechanism is the §2 merge-admission freshness block (HELD); this item is its receipt pair.",
