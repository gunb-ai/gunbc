      path: "docs/plans/hermetic-tool-provisioning-design.md",
      intricacy: IntricacyMedium,
      volume: VolumeLarge,
      t: fields(
        headline: "Drive bare tool names and host path literals to zero",
        boundary: "Every mechanical invocation names a resolved tool; bare executable names and absolute host path literals are migrated or classified as declared floor members.",
        displaced_cost: "Removes non-portable host layout from the corpus and stops the census regrowing.",
        first_slice: "Migrate the hardcoded home-directory toolchain paths and one bare-name family onto resolved tools.",
        red_control: "A newly introduced bare tool name or host path literal reds; the construction half makes an argv position reject an unresolved string.",
        out_of_scope: "Interactive developer environments are never in scope; mechanical paths only.",
        handback: "Return the migrated sites, the remaining classified residue, and the guarding lens."
      )
    ),
    active_small(
