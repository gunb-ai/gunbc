module gunbc.roadmap_authority

import gunbc.roadmap_document {
  RoadmapDocument,
  RoadmapSection,
  project_roadmap_to_markdown,
}
import gunbc.roadmap_model {
  RoadmapNode,
  RoadmapEdge,
  Pointer,
  RoadmapNodeId,
  IntricacyMedium,
  VolumeMedium,
  Sized,
  Unsized,
  PrsMerged,
  section_group,
  section_prose,
}
import gunbc.roadmap_status {
  AuthoredLine,
  TicketLine,
  TicketFields,
  Signoff,
  Unsigned,
  SignedOff,
}
import std.markdown {
  MarkdownBlock,
  HeadingBlock,
  ParagraphBlock,
  TextInline,
  H1,
}
import extdeps.languages.markdown { serialize_markdown_source }

fn nid(s: String) -> RoadmapNodeId { s }

fn signed(by: String, works: Bool, scope_equivalent: Bool, as_expected: Bool) -> Signoff {
  SignedOff { by: by, works: works, scope_equivalent: scope_equivalent, as_expected: as_expected }
}

fn authored(id: String, done: Bool, content: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: AuthoredLine { done: done, content: content },
    carriers: [],
    sizing: Unsized,
    owner: "",
    signoff: Unsigned,
  }
}

fn carrier(path: String) -> List<Pointer> {
  [Pointer { label: "authority", path: path }]
}

fn fields(
  headline: String,
  boundary: String,
  displaced_cost: String,
  first_slice: String,
  red_control: String,
  out_of_scope: String,
  handback: String
) -> TicketFields {
  TicketFields {
    headline: headline,
    brief: boundary,
    displaced_cost: displaced_cost,
    current_state: "Remaining committed deliverable. Implementation evidence is reviewed separately from acceptance.",
    first_slice: first_slice,
    red_control: red_control,
    out_of_scope: out_of_scope,
    handback: handback,
    updates: [],
    authored_on: "",
    last_verified_on: "",
  }
}

fn active(
  id: String,
  owner: String,
  path: String,
  t: TicketFields
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: TicketLine { done: false, ticket: t },
    carriers: carrier(path: path),
    sizing: Sized {
      intricacy: IntricacyMedium,
      volume: VolumeMedium,
      repo: "gunbc",
      acceptance: PrsMerged,
    },
    owner: owner,
    signoff: Unsigned,
  }
}

fn queued(
  id: String,
  owner: String,
  path: String,
  t: TicketFields
) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: TicketLine { done: false, ticket: t },
    carriers: carrier(path: path),
    sizing: Unsized,
    owner: owner,
    signoff: Unsigned,
  }
}

fn edge(child: String, parent: String) -> RoadmapEdge {
  RoadmapEdge { child: nid(s: child), parent: nid(s: parent) }
}

