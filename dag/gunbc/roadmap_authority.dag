            updates: [
              TicketUpdate { on: "2026-07-27", note: "split from ts-deploy-tail during #7301 audit; the old row named this question but its deletion had no successor" },
            ],
            authored_on: "2026-07-27",
            last_verified_on: "2026-07-27",
          }),
          ticket_row(id: "ts-native-flip-revert", done: false, t: TicketFields {
            headline: "first NativeRouted flip reverted by receipt — the frontier working as designed",
            brief: "Main run 29963619401 (#7069 merge, srv2-05) redded the family-crate agreement WARM (compile_skipped=true ×3, false in 496ms): a genuine native-vs-eval divergence or member-run failure, NOT cold cache. Remedy per design: complement + meet_join back to InterpretedRetained agreement_red_on_main — a two-row data edit, receipt on the carrier, investigation off the merge-critical path, the falsifier cold control still exercising both legs.",
            displaced_cost: "",
            current_state: "the divergence carrier LANDED 2026-07-23 (v2.std.native_agreement — the receipt names the member and both runtime answers), closing the named loudness gap; the pair's re-flip gate is EXACTLY the frontier rows' own dissolve_on — divergence root-caused with member + both values named, then a fresh warm per-host agreement receipt; NO store condition (the pair already rides the crate leg — why the revert receipt was warm). The store gates the other NINE families' FIRST flip, not this pair's re-flip",
