module gunbc.srv3.srv3_os_install_actuate

// This module used to resolve every cross-module name through the bare channel. A module that
// declares imports has its bare channel off, so every provider name it reads is imported here
// explicitly, each from the module that declares it.
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import std.types { NonEmptyStr, PathSegment, Secret, String }
import gunbc.auth.private_secret_file {
  PrivateSecretFileCompleted,
  PrivateSecretFileCompletedResidueRemains,
  PrivateSecretFileNotEntered,
  PrivateSecretFileNotEnteredResidueRemains,
  with_private_secret_file,
}
import gunbc.auth.access_token_source { access_token_upsert_required_reason }
import gunbc.nbd_proxy_virtual_media_install { ActuatorPlanRefused, srv3_os_install_actuator_plan_standing }
import gunbc.provisioning.seeded_install_media_publish { SeededImageResolution }
import gunbc.srv3.srv3_bmc_credential_resolve { BmcCredentialAccessUpsertRequired, BmcCredentialFetchRefused, BmcCredentialMaterialized, BmcCredentialResolution, CredentialResolutionRefused, UseFactoryCredential, UseRotatedSecretRef, bmcweb_login_body_content, materialize_bmc_login_password, observe_and_resolve_srv3_bmc_credential, srv3_os_install_actuate_credential_intent }
import gunbc.srv3.srv3_host_effect_apply { srv3_apply_to_process_exit, srv3_bmcweb_session_login_apply, srv3_bmcweb_token_extract_apply, srv3_nbd_proxy_serve_apply }


data gunbc_srv3_os_install_actuate_scope_disposition: Disposition = std.disposition.Terminal {
  reason: "prefix:os-install-actuated runnable prep — ISO fetch, derived actuator host, three-step actuator plan (nbd_proxy_serve, boot-once-cd, force-restart) as gunbc run entrypoints. Scope boundary: gunbc.srv3.srv3_os_install_actuate_scope (actuator prep + runbook ONLY; seed gap fail-closed; credential debt scaffold). Live mount+boot+install operator-gated; nbd_proxy_serve is a held session via host_effect_apply (systemd transient units)."
}

data srv3_os_install_actuate_operator_runbook: NonEmptyStr = "docs/runbooks/srv3-os-install-actuate.md"

fn srv3_bmcweb_login_body_content() -> String {
  let intent = srv3_os_install_actuate_credential_intent()
  bmcweb_login_body_content(
    username: intent.account,
    password: intent.factory_login.published_password as String,
  )
}

fn srv3_bmcweb_login_body_content_for_resolution(resolution: BmcCredentialResolution, password: String) -> String {
  match resolution {
    UseFactoryCredential { login: l } =>
      bmcweb_login_body_content(username: l.username, password: password)
    UseRotatedSecretRef { secret_ref: _ } => {
      let intent = srv3_os_install_actuate_credential_intent()
      bmcweb_login_body_content(username: intent.account, password: password)
    }
    CredentialResolutionRefused { reason: _ } => {
      let intent = srv3_os_install_actuate_credential_intent()
      bmcweb_login_body_content(username: intent.account, password: password)
    }
  }
}

fn srv3_bmcweb_session_login() -> ProcessExit
{
  let resolution = observe_and_resolve_srv3_bmc_credential()
  return match resolution {
    CredentialResolutionRefused { reason: r } =>
      exit_failure(reason: concat("bmcweb-login: credential resolution refused: ", r))
    UseFactoryCredential { login: _ } => srv3_bmcweb_session_login_resolved(resolution: resolution)
    UseRotatedSecretRef { secret_ref: _ } => srv3_bmcweb_session_login_resolved(resolution: resolution)
  }
}

// THE EMPTY-TOKEN CHECK THAT STOOD IN THIS FOLD IS DELETED, NOT MOVED (DESIGN §4b, dissolution on
// climb). It ran shell.Test.IsNonEmpty on srv3_bmcweb_token_path — the file the extract step had
// just written — so it conceded that writing an empty credential file was reachable and merely
// reported it afterwards. gunbc.host.host_effect_realize `bmcweb_token_extraction_verdict` now refuses an
// absent, null or blank token BEFORE Filesystem.Write, so a converged extract cannot have produced
// an empty file and a second reading has nothing left to discover.
fn srv3_bmcweb_session_login_resolved(resolution: BmcCredentialResolution) -> ProcessExit
{
  let materialization = materialize_bmc_login_password(resolution: resolution)
  let password = match materialization {
    BmcCredentialMaterialized { password: password } => password
    BmcCredentialAccessUpsertRequired { plan: plan } =>
      return exit_failure(
        reason: concat(
          "bmcweb-login: ",
          access_token_upsert_required_reason(plan: plan),
        ),
      )
    BmcCredentialFetchRefused { reason: reason } =>
      return exit_failure(reason: concat("bmcweb-login: ", reason as String))
  }

  // THE LOGIN BODY HOLDS THE BMC PASSWORD, so it exists only inside this bracket: an owner-only file
  // in a fresh 0700 directory, removed with the directory when the login returns, on every arm. It
  // used to be Filesystem.Write to the fixed /tmp/srv3_bmcweb_login_body.json at the ambient umask,
  // never removed. It is a file, not stdin, because the login runs as a described curl command
  // through the host-effect transport, which has no stdin channel.
  let login_exit = match with_private_secret_file(
    file_name: "bmcweb_login_body.json" as PathSegment,
    content: srv3_bmcweb_login_body_content_for_resolution(resolution: resolution, password: password) as Secret,
    use: fn(body_file) {
      srv3_apply_to_process_exit(
        d: srv3_bmcweb_session_login_apply(request_body_file: body_file),
        failure_prefix: "bmcweb-login: curl login failed: ",
      )
    },
  ) {
    PrivateSecretFileCompleted { value: exit } => exit
    PrivateSecretFileCompletedResidueRemains { value: _ } =>
      exit_failure(reason: "bmcweb-login: the login ran (a session may have been opened) but its private request body could not be removed, so the BMC password may remain on disk and requires cleanup before retry")
    PrivateSecretFileNotEntered { cause: c } =>
      exit_failure(reason: concat("bmcweb-login: the login body could not be placed owner-only, so no login was attempted: ", c as String))
    PrivateSecretFileNotEnteredResidueRemains { cause: c } =>
      exit_failure(reason: concat("bmcweb-login: the login body could not be placed AND credential material may remain on disk, requiring cleanup before retry: ", c as String))
  }
  match login_exit {
    ExitSuccess => {}
    ExitFailure { code: _, reason: _ } => return login_exit
  }

  let extract_exit = srv3_apply_to_process_exit(
    d: srv3_bmcweb_token_extract_apply(),
    failure_prefix: "bmcweb-login: token extract failed: ",
  )
  match extract_exit {
    ExitSuccess => {}
    ExitFailure { code: _, reason: _ } => return extract_exit
  }

  ExitSuccess
}

fn srv3_nbd_proxy_serve() -> ProcessExit
{
  srv3_apply_to_process_exit(
    d: srv3_nbd_proxy_serve_apply(),
    failure_prefix: "nbd-proxy-serve: host effect apply refused: ",
  )
}

// The step count was never the subject — that the plan is DERIVED from the solved mechanism was.
// srv3's BMC upgrade propagates through that derivation and the plan now refuses, which is what
// distinguishes a derived plan from a hardcoded three-step one: a hardcoded plan would still be Ready.
// THE REFUSAL MUST BE THE MECHANISM'S. The plan is also a function of the served image, and an
// unresolved image refuses the serve step on its own; a caller supplying a RESOLVED image isolates
// the mechanism as the only thing left that can refuse.
fn srv3_os_install_actuator_plan_refuses_on_unestablished_path(image: SeededImageResolution) -> Bool {
  match srv3_os_install_actuator_plan_standing(image: image) {
    ActuatorPlanRefused { cause: ActuatorMechanismRefused { cause: _ } } => true
    ActuatorPlanReady { plan: _, intents: _ } => false
    ActuatorPlanRefused { cause: ActuatorStepsUnrealized { refusals: _ } } => false
  }
}

fn srv3_os_install_actuate_runbook_is_declared() -> Bool {
  string_contains(s: srv3_os_install_actuate_operator_runbook as String, pattern: "srv3-os-install-actuate")
}
