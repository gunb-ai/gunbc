module gunbc.srv3.srv3_seeded_install_media_artifact

import gunbc.host_command_binding { LocalCommandHost, CreationNotRequested }

import extdeps.provisioning.ubuntu_install_media {
  noble_numbat_2404_3_live_server_arm64,
}
// THE ARTIFACTS DIRECTORY IS THE SEALED MEDIA STORE (cohort C-host): the mint gates both operations
// (a store that cannot be listed publishes nothing and resolves nothing), and the directory the
// publication writes into is read off the minted record -- this module carries no literal.
import gunbc.provisioning.install_media_store {
  InstallMediaStore, InstallMediaStoreReading, InstallMediaStoreReady, InstallMediaStoreUnready,
  install_media_store, install_media_install_path, install_media_parent_directory,
}
import gunbc.host_state_root { host_state_tree }
import extdeps.provisioning.ubuntu_seeded_install_media {
  UbuntuSeededInstallMediaBuildInput,
  ubuntu_seeded_install_media_default_nocloud_dir,
  ubuntu_seeded_install_media_grub_kernel_cmdline,
}
import gunbc.os_install { srv3_ubuntu_autoinstall_on_iso }
import gunbc.fleet.fleet_host_identity { operator_host_srv3 }
import gunbc.os_install_emit { autoinstall_user_data, AutoinstallUserData, AutoinstallUserDataRendered, AutoinstallUserDataRefused }
import gunbc.provisioning.seeded_install_media_policy { seeded_install_media_pinned_dates, seeded_install_media_builder_revision }
import gunbc.provisioning.seeded_install_media_publish {
  HostArtifactsDirectory,
  SeededImagePublication,
  SeededImagePublicationRefused,
  SeededImageResolution,
  SeededImageUnobservable,
  SeededImageWriteBoundary,
  publish_seeded_image,
  resolve_seeded_image,
}
import std.types { List, NonEmptyStr, String }

// THE SEED DIRECTORY IS NAMED FROM THE HOST IDENTITY, NOT FROM THE DOCUMENT. It used to read the
// autoinstall identity's hostname; the payload is key-only now (no identity section), so the only
// honest source left is gunbc.fleet.fleet_host_identity's own row — the single authority for what a
// host is called (§3). The bytes are unchanged ("nocloud/srv3"), because they always were this string.
data srv3_seeded_nocloud_dir_on_iso: NonEmptyStr = ubuntu_seeded_install_media_default_nocloud_dir(
  hostname: operator_host_srv3,
)

data srv3_seeded_grub_kernel_cmdline: NonEmptyStr = ubuntu_seeded_install_media_grub_kernel_cmdline(
  nocloud_dir: srv3_seeded_nocloud_dir_on_iso,
)

// The install payload is srv3's autoinstall, so the image is an INSTALLER and keeps the label the
// earlier remaster gave it; nothing reads srv3's boot-medium label. The stem is its own row because
// it is made of the stock point release and the host, neither of which is seeded content: a reader
// that wants the name does not need the derivation to have succeeded.
data srv3_seeded_install_media_image_stem: NonEmptyStr = "ubuntu-24.04.3-live-server-srv3-seeded"

// EVERY BUILD INPUT BUT THE USER-DATA BODY IS A CONSTANT OF THIS MODULE; the body is the one field
// that is rendered, so it is the one parameter. A witness that supplies a body at this boundary gets
// the real input shape without re-running the renderer (DESIGN §3, a witness discriminates at one
// interface); the real route below is the inhabitance claim that the renderer's output reaches it.
fn srv3_seeded_install_media_input_for(user_data_body: NonEmptyStr) -> UbuntuSeededInstallMediaBuildInput {
  UbuntuSeededInstallMediaBuildInput {
    stock_artifact: noble_numbat_2404_3_live_server_arm64,
    nocloud_dir_on_iso: srv3_seeded_nocloud_dir_on_iso,
    user_data_body: user_data_body,
    seed_files: [],
    seed_artifacts: [],
    grub_kernel_cmdline: srv3_seeded_grub_kernel_cmdline,
    volume_id: "UBUNTU_SEEDED",
    pinned_dates: seeded_install_media_pinned_dates,
    image_stem: srv3_seeded_install_media_image_stem,
    builder_revision: seeded_install_media_builder_revision,
  }
}

// THE DERIVATION CARRIES THE RENDERER'S REFUSAL, because the seeded image IS its rendered user-data:
// the body is written into the ISO's seed and is in the build key, so a document the YAML writer
// will not write leaves no image to build, publish, or resolve. Every consumer of the row below
// therefore matches this outcome and refuses in its own vocabulary -- publication and resolution
// through the refusal arms gunbc.provisioning.seeded_install_media_publish already carries.
type Srv3SeededInstallMedia
  = Srv3SeededInstallMediaDerived { input: UbuntuSeededInstallMediaBuildInput }
  | Srv3SeededInstallMediaRefused { reason: String }

fn srv3_seeded_install_media_derivation() -> Srv3SeededInstallMedia {
  match autoinstall_user_data(payload: srv3_ubuntu_autoinstall_on_iso) {
    AutoinstallUserDataRefused { reason: r } => Srv3SeededInstallMediaRefused { reason: r }
    AutoinstallUserDataRendered { content: body } =>
      Srv3SeededInstallMediaDerived { input: srv3_seeded_install_media_input_for(user_data_body: body as NonEmptyStr) }
  }
}

data srv3_seeded_install_media: Srv3SeededInstallMedia = srv3_seeded_install_media_derivation()

fn srv3_seeded_install_media_refusal_text(reason: String) -> String {
  concat("the srv3 seeded image has no derivation: ", reason)
}

// The actuator host serves the image over its own NBD proxy from its artifacts directory, beside the
// stock medium it was derived from.
// THE MINT GATES BOTH OPERATIONS. A media store that cannot be listed publishes nothing (a
// publication would write where nothing may be read) and resolves nothing (a resolution would report
// served bytes nobody confirmed readable). The refusal states the mint's observation -- the
// SeededImagePublicationRefused / SeededImageUnobservable arms the module already had.
fn srv3_seeded_install_media_publish() -> SeededImagePublication {
  match srv3_seeded_install_media {
    Srv3SeededInstallMediaRefused { reason: r } =>
      SeededImagePublicationRefused { reason: srv3_seeded_install_media_refusal_text(reason: r), work: CreationNotRequested }
    Srv3SeededInstallMediaDerived { input: i } =>
      match install_media_store(tree: host_state_tree()) {
        InstallMediaStoreUnready { detail: d } =>
          SeededImagePublicationRefused { reason: concat("the install media store refused to open: ", d), work: CreationNotRequested }
        InstallMediaStoreReady { store: s } =>
          publish_seeded_image(
            host: LocalCommandHost,
            input: i,
            stock_path: install_media_install_path(store: s, artifact: noble_numbat_2404_3_live_server_arm64),
            boundary: HostArtifactsDirectory { dir: install_media_parent_directory(store: s) },
          )
      }
  }
}

fn srv3_seeded_install_media_resolve() -> SeededImageResolution {
  match srv3_seeded_install_media {
    Srv3SeededInstallMediaRefused { reason: r } =>
      SeededImageUnobservable { reason: srv3_seeded_install_media_refusal_text(reason: r) }
    Srv3SeededInstallMediaDerived { input: i } =>
      match install_media_store(tree: host_state_tree()) {
        InstallMediaStoreUnready { detail: d } =>
          SeededImageUnobservable { reason: concat("the install media store refused to open: ", d) }
        InstallMediaStoreReady { store: s } =>
          resolve_seeded_image(host: LocalCommandHost, input: i, dir: install_media_parent_directory(store: s))
      }
  }
}
