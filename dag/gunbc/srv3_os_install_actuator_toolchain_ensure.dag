module gunbc.srv3_os_install_actuator_toolchain_ensure

import gunbc.ci_deploy_access { ci_deploy_srv1_operator_access }
import gunbc.host_effect {
  OsInstallActuatorToolchainEnsure,
  HostOs,
  host_effect_identity_evidence,
}
import gunbc.host_effect_realize { host_effect_apply_gated }
import gunbc.os_install_actuator_selection { srv3_os_install_actuator_host }
import std.realization_reconcile { Converged, NotConverged }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.types { Bool }
import std.resources { Network }
import std.disposition { Disposition, Terminal, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data srv3_os_install_actuator_toolchain_ensure_scaffold: Disposition = Terminal {
  reason: "host_effect_apply binds OsInstallActuatorToolchainEnsure via typed apt/curl/websocat argv effects in host_effect_realize"
}

data os_install_actuator_toolchain_ensure_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect_realize",
    decl_name: "realize_os_install_actuator_toolchain_ensure",
    field: WholeDeclaration,
  }
}

func srv3_os_install_actuator_toolchain_ensure() -> ProcessExit
  uses net: Network
{
  let target = HostOs { node: srv3_os_install_actuator_host }
  let access = ci_deploy_srv1_operator_access
  match host_effect_apply_gated(
    access: access,
    target: target,
    effect: OsInstallActuatorToolchainEnsure {},
    evidence: host_effect_identity_evidence,
    transport: access.transport,
    fixture_actor: none,
  ) {
    Converged { evidence: _, applied: _ } => ExitSuccess
    NotConverged { reason: why, applied: _ } => exit_failure(reason: why)
  }
}

fn os_install_actuator_toolchain_ensure_routes_through_host_effect_apply() -> Bool {
  match srv3_os_install_actuator_toolchain_ensure_scaffold {
    Terminal { reason: why } => string_contains(s: why, pattern: "OsInstallActuatorToolchainEnsure")
    Scaffold { dissolves_to: _, bind: _ } => false
  }
}
