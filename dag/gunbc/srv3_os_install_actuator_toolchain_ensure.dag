module gunbc.srv3_os_install_actuator_toolchain_ensure

import gunbc.host_toolchain_ensure { host_toolchain_ensure, OsInstallActuator }
import gunbc.fleet_intent_network { operator_host_srv3 }
import std.process { ProcessExit }
import std.resources { Network }
import std.types { Bool }
import std.disposition { Disposition, Scaffold, RealizationDispatch, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data srv3_os_install_actuator_toolchain_ensure_scaffold: Disposition = Terminal {
  reason: "Thin caller of host_toolchain_ensure(host: srv3, kind: OsInstallActuator) — srv3 behavioral fork dissolved (P-D)."
}

data os_install_actuator_toolchain_ensure_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect_realize",
    decl_name: "realize_os_install_actuator_toolchain_ensure",
    field: WholeDeclaration,
  }
}

func srv3_os_install_actuator_toolchain_ensure() -> ProcessExit
  uses net: Network
{
  host_toolchain_ensure(host: operator_host_srv3, kind: OsInstallActuator)
}

fn os_install_actuator_toolchain_ensure_routes_through_host_effect_apply() -> Bool {
  match os_install_actuator_toolchain_ensure_dissolution_trigger {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: _ },
    } =>
      m == "gunbc.host_effect_realize" && n == "realize_os_install_actuator_toolchain_ensure"
    Terminal { reason: _ } => false
  }
}
