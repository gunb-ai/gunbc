module gunbc.workspace_commissioning_history

import std.types { String, NonEmptyStr }
import std.algebra { trim }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.build_cache_instance { RunnerSlotIdentity, runner_slot_instance_name }
import gunbc.runner_microvm_slot_unit { microvm_slot_controller_receipt_dir }
import gunbc.runner_microvm_cell_readiness { StoreRootOwned, StoreNotRootOwned }
import gunbc.runner_microvm_cell_readiness_store { read_store_ownership, OwnershipRead, OwnershipUnread }

// A receipt which says the controller never acquired a reservation carries no attempt subject.
// Any executed attempt, unknown receipt or unreadable file requires recovery, not generation zero.
// A commissioning refusal is before VM launch by construction of that controller mode; a partial
// commissioning transaction is recovered from its separate protected journal.
fn workspace_initial_receipt_refusal(content: String) -> String? {
  let text = trim(s: content)
  if starts_with(s: text, prefix: "refused: ReservationNotObserved ")
    || starts_with(s: text, prefix: "refused: WorkloadAdmissionRefused commissioning: ") {
    none
  } else { Present { value: "slot controller history is not an unstarted refusal; recover the recorded incarnation" } }
}

fn workspace_initial_controller_history_refusal(slot: RunnerSlotIdentity) -> String? {
  match read_store_ownership(path: microvm_slot_controller_receipt_dir) {
    OwnershipRead { ownership: StoreRootOwned } => {
      let names = Filesystem.List(path: microvm_slot_controller_receipt_dir)
      if !names.success { Present { value: "slot controller receipt history could not be enumerated" } }
      else {
        let prefix = concat(runner_slot_instance_name(slot: slot) as String, "-")
        let selected = filter(split(s: names.entries, delimiter: "\n"), name => starts_with(s: name, prefix: prefix))
        fold(selected, init: none, f: (prior, name) => match prior {
          Present { value: _ } => prior
          Absent => {
            let path = join([microvm_slot_controller_receipt_dir, "/", name], "")
            match read_store_ownership(path: path) {
              OwnershipRead { ownership: StoreRootOwned } => {
                let read = Filesystem.Read(path: path)
                if !read.success { Present { value: "a slot controller receipt is unreadable" } }
                else { workspace_initial_receipt_refusal(content: read.content) }
              }
              OwnershipRead { ownership: StoreNotRootOwned { owner_uid: _, mode: _ } } => Present { value: "a slot controller receipt is not root-authoritative" }
              OwnershipUnread { reason: _ } => Present { value: "a slot controller receipt is not root-authoritative" }
            }
          }
        })
      }
    }
    OwnershipRead { ownership: StoreNotRootOwned { owner_uid: _, mode: _ } } => Present { value: "slot controller history is absent, unreadable or outside root custody" }
    OwnershipUnread { reason: _ } => Present { value: "slot controller history is absent, unreadable or outside root custody" }
  }
}
