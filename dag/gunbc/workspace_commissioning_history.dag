module gunbc.workspace_commissioning_history

import std.types { String, NonEmptyStr }
import std.algebra { trim }
import gunbc.build_cache.build_cache_instance { RunnerSlotIdentity, runner_slot_instance_name }
import gunbc.runner.runner_microvm_slot_unit { MicrovmReceiptStoreReady, MicrovmReceiptStoreUnready, microvm_receipt_store, MicrovmReceiptHistoryRead, MicrovmReceiptHistoryRefused, microvm_receipt_history }
import gunbc.host_state_root { host_state_tree }

// A receipt which says the controller never acquired a reservation carries no attempt subject.
// Any executed attempt, unknown receipt or unreadable file requires recovery, not generation zero.
// A commissioning refusal is before VM launch by construction of that controller mode; a partial
// commissioning transaction is recovered from its separate protected journal.
fn workspace_initial_receipt_refusal(content: String) -> String? {
  let text = trim(s: content)
  if starts_with(s: text, prefix: "refused: ReservationNotObserved ")
    || starts_with(s: text, prefix: "refused: WorkloadAdmissionRefused commissioning: ") {
    none
  } else { Present { value: "slot controller history is not an unstarted refusal; recover the recorded incarnation" } }
}

fn workspace_initial_controller_history_refusal(slot: RunnerSlotIdentity) -> String? {
  match microvm_receipt_store(tree: host_state_tree()) {
    MicrovmReceiptStoreUnready { detail } => Present { value: join(["slot controller history is absent, unreadable or outside root custody: ", detail], "") }
    MicrovmReceiptStoreReady { store } =>
      match microvm_receipt_history(store: store, instance: runner_slot_instance_name(slot: slot) as String) {
        MicrovmReceiptHistoryRefused { detail } => Present { value: detail }
        MicrovmReceiptHistoryRead { texts } =>
          fold(texts, init: none, f: (prior, text) => match prior {
            Present { value: _ } => prior
            Absent => workspace_initial_receipt_refusal(content: text)
          })
      }
  }
}
