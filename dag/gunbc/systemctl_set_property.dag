module gunbc.systemctl_set_property


fn systemctl_set_property_operation_argv(unit: std.types.NonEmptyStr, property: std.types.NonEmptyStr, value: std.types.NonEmptyStr) -> List<String> {
  systemctl_set_property_argv(unit: unit, property: property, value: value)
}

fn systemctl_set_property_operation_argv_matches_transport(
  unit: std.types.NonEmptyStr,
  property: std.types.NonEmptyStr,
  value: std.types.NonEmptyStr,
) -> Bool {
  let materialized = systemctl_set_property_operation_argv(unit: unit, property: property, value: value)
  let authority = systemctl_set_property_argv(unit: unit, property: property, value: value)
  join(materialized, " ") == join(authority, " ")
}

fn systemctl_set_property_local(unit: std.types.NonEmptyStr, property: std.types.NonEmptyStr, value: std.types.NonEmptyStr) -> Bool {
  let result = systemd.Systemctl.SetProperty(unit: unit, property: property, value: value)
  result.success
}
