module gunbc.systemctl_set_property

import std.types { String, NonEmptyStr, List, Bool }
import extdeps.exec.command { ArgvCommand, LocalExec }
import extdeps.systemd.systemctl
import gunbc.command_runner { run_shell_command_capture }

fn systemctl_set_property_operation_argv(unit: NonEmptyStr, property: NonEmptyStr, value: NonEmptyStr) -> List<String> {
  systemctl_set_property_argv(unit: unit, property: property, value: value)
}

fn systemctl_set_property_operation_argv_matches_transport(
  unit: NonEmptyStr,
  property: NonEmptyStr,
  value: NonEmptyStr,
) -> Bool {
  let materialized = systemctl_set_property_operation_argv(unit: unit, property: property, value: value)
  let authority = systemctl_set_property_argv(unit: unit, property: property, value: value)
  join(materialized, " ") == join(authority, " ")
}

fn systemctl_set_property_privileged_operation_argv_matches_authority(
  unit: NonEmptyStr,
  property: NonEmptyStr,
  value: NonEmptyStr,
) -> Bool {
  let materialized = systemctl_set_property_privileged_argv(unit: unit, property: property, value: value)
  let authority = systemctl_set_property_privileged_argv(unit: unit, property: property, value: value)
  join(materialized, " ") == join(authority, " ")
}

fn systemctl_set_property_local(unit: NonEmptyStr, property: NonEmptyStr, value: NonEmptyStr) -> Bool {
  let result = run_shell_command_capture(
    command: ArgvCommand {
      argv: systemctl_set_property_privileged_argv(unit: unit, property: property, value: value),
    },
    transport: LocalExec,
  )
  result.success
}
