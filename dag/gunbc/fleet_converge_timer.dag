module gunbc.fleet_converge_timer

import std.types { String, NonEmptyStr, Bool, Int }
import std.nat { Nat }
import std.measure { Second, second, second_count }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// Arc item 4 (timer / anti-entropy, operator directive 2026-08-08): the steady-state
// enforcement loop is a PER-HOST systemd timer executing the converge circuit against
// the admitted desired revision (gunbc.fleet_main_revision) — never a central cron, an
// SSH star, or a GHA event as steady state. Every firing emits a receipt; a host that
// was offline across a desired-state change converges on return because the timer's
// next firing reads the admitted ref (catch-up is a property of following the ref, plus
// Persistent= for missed calendar firings). This module is the SINGLE authority for the
// unit names, cadence, and unit CONTENT — the emitted files derive from these rows, so
// a hand-edited unit is drift against this authority, not a second truth.
//
// Timer shape is the design doc's Option A (OnCalendar + Persistent=true + jitter):
// Persistent only functions with OnCalendar (systemd ignores it on monotonic timers),
// and calendar catch-up is exactly the offline-host property the arc requires.
data fleet_converge_service_unit_name: String = "ctrl-fleet-converge.service"
data fleet_converge_timer_unit_name: String = "ctrl-fleet-converge.timer"
data fleet_converge_timer_on_calendar: String = "*:0/15"
data fleet_converge_timer_randomized_delay: Second = second(count: 90)
data fleet_converge_binary_path: String = "/opt/gunbc/bin/gunbc"
data fleet_converge_env_file_path: String = "/etc/gunbc/fleet-converge.env"

// String-built medium: unit INI text is rendered by join/concat rather than as a Node
// emitted through grammar rows — the medium-as-string shape the shell→intent lane's
// containment exists to stop spreading. Tolerated only while this module is tests-only
// (no production emitter consumes it); the typed row below carries the dissolution.
data fleet_converge_unit_text_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration,
  }
}

// 🟡 dissolve-on: fleet-converge unit-body single render (review 50806) — the unit BODY
// is currently authored TWICE: these content fns (consumed by the srv2–srv4 self-install
// route) and gunbc.live_deploy.emit emit_fleet_converge_{service,timer}_unit_doc (the
// srv1 membership route, which adds After/Wants=network-online.target and
// WorkingDirectory=, omits EnvironmentFile=, and derives only cadence/jitter from this
// authority). A §3 parallel representation across the two consumers — srv1 and srv2–4
// do NOT receive byte-identical units, and an edit to either producer can drift them.
// Not merged blind here because the emit side's bytes are golden-pinned and deployed on
// srv1 (a silent byte churn of a live unit is the wrong side of the trade mid-arc).
// DISSOLVES WHEN one render authority (these content fns, Doc-wrapped) feeds both
// routes and the emit goldens re-pin from it.
// b1 UPGRADE (CONVERGE close): the fork is no longer only a byte-drift risk — it is now a
// CORRECTNESS fork. The emit side (srv1) was moved off User=root to User=/Group=service_user
// with an owned receipts dir, because a root run cannot observe refs/fleet/desired inside a
// service-user-owned repo with no root-side credential. This body still renders "User=root\n"
// AND omits WorkingDirectory=, so the srv2–srv4 self-install route inherits the exact b1
// defect srv1 just shed (root ls-remote in a foreign-owned tree, and no workdir to run git in
// at all). Dissolving this to the single emit authority is therefore a b1 correctness
// requirement for srv2–srv4, not merely DRY; patching "User=root" here in isolation is
// declined because the missing WorkingDirectory makes this body wrong regardless of principal.
data fleet_converge_unit_body_fork_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "emit_fleet_converge_service_unit_doc",
    field: WholeDeclaration,
  }
}

fn fleet_converge_service_content(host_arg: String) -> String {
  join([
    "[Unit]\n",
    "Description=gunbc fleet converge (self)\n",
    "\n",
    "[Service]\n",
    "Type=oneshot\n",
    "User=root\n",
    "EnvironmentFile=-", fleet_converge_env_file_path, "\n",
    "ExecStart=", fleet_converge_binary_path, " converge --host ", host_arg, "\n",
  ], "")
}

fn fleet_converge_timer_content() -> String {
  join([
    "[Unit]\n",
    "Description=gunbc fleet converge cadence\n",
    "\n",
    "[Timer]\n",
    "OnCalendar=", fleet_converge_timer_on_calendar, "\n",
    "Persistent=true\n",
    "RandomizedDelaySec=", to_string(second_count(s: fleet_converge_timer_randomized_delay)), "\n",
    "Unit=", fleet_converge_service_unit_name, "\n",
    "\n",
    "[Install]\n",
    "WantedBy=timers.target\n",
  ], "")
}

// The service converges SELF only: the unit text never names a remote host, so the
// central-actor-converges-remote-host shape is unwritable from this authority (the
// design doc's invariant: CI never runs converge against a remote N).
fn fleet_converge_service_content_self() -> String {
  fleet_converge_service_content(host_arg: "self")
}
