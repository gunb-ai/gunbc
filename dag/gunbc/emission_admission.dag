module gunbc.emission_admission

import std.types { String, NonEmptyStr, Bool, Int, List, FilePath, CommitSha }
import std.content_hash { Fnv1a64Structural }
import gunbc.bootstrap { CompilerStage, Emit, Infer, ChangeClassification }
import gunbc.generated_artifact { GeneratedArtifact, CiYamlArtifact }
import gunbc.guarantee_measurement {
  MeasurementRevision,
  ContentFingerprint,
  GitRevision,
  GuaranteeTargetName,
}
import v2.std.algebra { any, contains, fold_list }
import v2.std.change { ChangeSet }

data emission_admission_charter_note: String = "STAGE 1 OF THE EMISSION-ADMISSION SPINE (design docs/plans/emission-admission-stage-aware-pipeline-design.md): vocabulary, pure admit_emission_delta, and synthetic witnesses only. No PR derivation, no regen phase stamp, no warm-merge consumer — those are downstream stages. This module carries EmissionSurface, StageStamp, DeclaredChangeSet, EmissionDelta, and EmissionAdmissionVerdict so regen/floor/admission phases can share one fail-closed seam instead of collapsing to bytes_equal / bytes_differ. CompilerStage authority is gunbc.bootstrap; MeasurementRevision is reused from gunbc.guarantee_measurement; FrontierProbeStage is harness vocabulary and is NOT imported here."

type PipelinePhase
  = RegenPhase
  | FloorPhase
  | AdmissionPhase

type EmissionSurface
  = Stage0SeedFile { rel_path: FilePath }
  | GeneratedArtifactSurface { artifact: GeneratedArtifact }
  | TargetLanguageBundle { target: GuaranteeTargetName, module: NonEmptyStr }
  | OrchestrationMedium { medium: NonEmptyStr }

type StageContribution
  = StageProduced { stage: CompilerStage }
  | StageForwarded { stage: CompilerStage, from_prior_phase: PipelinePhase }
  | UpstreamRefusalEmbedded { origin_stage: CompilerStage, diagnostic: NonEmptyStr }

type StageStamp {
  phase: PipelinePhase
  contributions: List<StageContribution>
  substrate_revision: ContentFingerprint
}

type DeclaredChangeEvidence
  = DerivedFromAffectedSet { changes: ChangeSet }
  | DerivedFromBootstrapPlan { change: ChangeClassification }
  | AuthorExplicit { reason: NonEmptyStr }

type DeclaredChangeSet {
  subject_revision: MeasurementRevision
  allowed_stage_moves: List<CompilerStage>
  allowed_surface_moves: List<EmissionSurface>
  derivation_evidence: DeclaredChangeEvidence
}

type EmissionDelta {
  surface: EmissionSurface
  before: ContentFingerprint
  after: ContentFingerprint
  stage_stamp: StageStamp
  observed_at_phase: PipelinePhase
}

type EmissionRegressionCause
  = SurfaceMovedWithoutDeclaration
  | StageAttributionMismatch
  | UpstreamRefusalMaskedAtEmit
  | BehavioralWitnessFailed
  | DigestMismatchUndeclared

type EmissionAdmissionVerdict
  = AdmittedDeclared {
      delta: EmissionDelta
      matched_declaration: DeclaredChangeSet
    }
  | RefusedRegression {
      delta: EmissionDelta
      cause: EmissionRegressionCause
    }
  | RefusedUndeclaredDelta {
      delta: EmissionDelta
      missing_from_declaration: EmissionSurface
    }
  | RefusedStageMismatch {
      delta: EmissionDelta
      declared_stages: List<CompilerStage>
      observed_stage: CompilerStage
    }
  | RefusedStaleSubstrate {
      stamp: StageStamp
      cause: NonEmptyStr
    }

type EmissionAdmissionVerdictFold<R> {
  admitted_declared: fn(EmissionDelta, DeclaredChangeSet) -> R
  refused_regression: fn(EmissionDelta, EmissionRegressionCause) -> R
  refused_undeclared: fn(EmissionDelta, EmissionSurface) -> R
  refused_stage_mismatch: fn(EmissionDelta, List<CompilerStage>, CompilerStage) -> R
  refused_stale_substrate: fn(StageStamp, NonEmptyStr) -> R
}

fn emission_admission_verdict_fold<R>(
  v: EmissionAdmissionVerdict,
  fold: EmissionAdmissionVerdictFold<R>
) -> R {
  match v {
    AdmittedDeclared { delta: d, matched_declaration: m } => fold.admitted_declared(d, m)
    RefusedRegression { delta: d, cause: c } => fold.refused_regression(d, c)
    RefusedUndeclaredDelta { delta: d, missing_from_declaration: s } => fold.refused_undeclared(d, s)
    RefusedStageMismatch { delta: d, declared_stages: ds, observed_stage: os } =>
      fold.refused_stage_mismatch(d, ds, os)
    RefusedStaleSubstrate { stamp: s, cause: c } => fold.refused_stale_substrate(s, c)
  }
}

fn emission_admission_is_admitted(v: EmissionAdmissionVerdict) -> Bool {
  emission_admission_verdict_fold(
    v: v,
    fold: EmissionAdmissionVerdictFold {
      admitted_declared: fn(_, _) { true },
      refused_regression: fn(_, _) { false },
      refused_undeclared: fn(_, _) { false },
      refused_stage_mismatch: fn(_, _, _) { false },
      refused_stale_substrate: fn(_, _) { false },
    },
  )
}

fn emission_surface_eq(left: EmissionSurface, right: EmissionSurface) -> Bool {
  match left {
    Stage0SeedFile { rel_path: lp } => match right {
      Stage0SeedFile { rel_path: rp } => lp == rp
      _ => false
    }
    GeneratedArtifactSurface { artifact: la } => match right {
      GeneratedArtifactSurface { artifact: ra } => la == ra
      _ => false
    }
    TargetLanguageBundle { target: lt, module: lm } => match right {
      TargetLanguageBundle { target: rt, module: rm } => (lt as String) == (rt as String) && (lm as String) == (rm as String)
      _ => false
    }
    OrchestrationMedium { medium: lm } => match right {
      OrchestrationMedium { medium: rm } => (lm as String) == (rm as String)
      _ => false
    }
  }
}

fn surface_allowed(surface: EmissionSurface, allowed: List<EmissionSurface>) -> Bool {
  any(
    xs: allowed,
    predicate: fn(s) { emission_surface_eq(left: surface, right: s) },
  )
}

fn stage_contribution_stage(c: StageContribution) -> CompilerStage {
  match c {
    StageProduced { stage: s } => s
    StageForwarded { stage: s, from_prior_phase: _ } => s
    UpstreamRefusalEmbedded { origin_stage: s, diagnostic: _ } => s
  }
}

fn stage_stamp_has_upstream_refusal(stamp: StageStamp) -> Bool {
  any(
    xs: stamp.contributions,
    predicate: fn(c) {
      match c {
        UpstreamRefusalEmbedded { origin_stage: _, diagnostic: _ } => true
        _ => false
      }
    },
  )
}

fn first_stage_mismatch(
  stamp: StageStamp,
  allowed: List<CompilerStage>
) -> CompilerStage? {
  fold_list(
    xs: stamp.contributions,
    empty: Absent as CompilerStage?,
    cons: fn(acc, c) {
      match acc {
        Present { value: _ } => acc
        Absent => {
          let stage = stage_contribution_stage(c: c)
          if contains(xs: allowed, item: stage, eq: fn(l, r) { l == r }) {
            Absent
          } else {
            Present { value: stage }
          }
        }
      }
    },
  )
}

fn content_fingerprint_eq(left: ContentFingerprint, right: ContentFingerprint) -> Bool {
  match left {
    ContentFingerprint { digest: ld } => match right {
      ContentFingerprint { digest: rd } => (ld as String) == (rd as String)
    }
  }
}

fn emission_delta_is_no_op(delta: EmissionDelta) -> Bool {
  content_fingerprint_eq(left: delta.before, right: delta.after)
}

fn upstream_refusal_masked(delta: EmissionDelta) -> Bool {
  emission_delta_is_no_op(delta: delta) == false
    && stage_stamp_has_upstream_refusal(stamp: delta.stage_stamp)
}

fn admit_emission_delta(
  delta: EmissionDelta,
  declared: DeclaredChangeSet
) -> EmissionAdmissionVerdict {
  if emission_delta_is_no_op(delta: delta) {
    AdmittedDeclared { delta: delta, matched_declaration: declared }
  } else if !surface_allowed(surface: delta.surface, allowed: declared.allowed_surface_moves) {
    RefusedUndeclaredDelta {
      delta: delta,
      missing_from_declaration: delta.surface,
    }
  } else {
    match first_stage_mismatch(stamp: delta.stage_stamp, allowed: declared.allowed_stage_moves) {
      Present { value: observed } => RefusedStageMismatch {
        delta: delta,
        declared_stages: declared.allowed_stage_moves,
        observed_stage: observed,
      }
      Absent => if upstream_refusal_masked(delta: delta) {
        RefusedRegression {
          delta: delta,
          cause: UpstreamRefusalMaskedAtEmit,
        }
      } else {
        AdmittedDeclared { delta: delta, matched_declaration: declared }
      }
    }
  }
}
