module gunbc.host_effect_nbd_proxy_serve



data host_effect_nbd_proxy_serve_dissolution_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: host_effect_nbd_proxy_serve — systemd transient-unit realize transport for Srv3NbdProxyServe (P6 Part 2; operator ruling 2026-07-14: no trap/&/$! ShellStmt vocabulary); DISSOLVES WHEN observe-side port/unit query is grounded on cited extdeps.systemd/systemctl read-back and typed argv dispatch retires WitnessBin systemd-run scaffolding. Token bridge: start_units materializes BMCWEB session token from srv3_bmcweb_token_path via Filesystem.Read into websocat argv (replaces deleted wrapper export). Wave 4 residue (shell→dag census §1C category C).")

data host_effect_nbd_proxy_serve_scaffold: std.disposition.Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect_nbd_proxy_serve",
    decl_name: "host_effect_nbd_proxy_serve_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data nbd_proxy_serve_expected_owner_label: std.types.NonEmptyStr = "gunbc-nbd-proxy" as std.types.NonEmptyStr

data nbd_proxy_serve_expected_process_fingerprint: std.types.NonEmptyStr = "gunbc-nbd-proxy" as std.types.NonEmptyStr

fn host_effect_nbd_proxy_serve_session_policy(lease_key: std.types.NonEmptyStr) -> std.temporal_effect.TemporalEffectPolicy {
  std.temporal_effect.HeldSessionLease { lease_key: lease_key }
}

fn host_effect_nbd_proxy_serve_session_policy_is_held_lease(lease_key: std.types.NonEmptyStr) -> Bool {
  match host_effect_nbd_proxy_serve_session_policy(lease_key: lease_key) {
    HeldSessionLease { lease_key: lk } => lk == lease_key
    PureRead => false
    CreateIfAbsent { content_key: _ } => false
    ReplaceIfStale { content_key: _ } => false
    UpsertScope { scope_key: _ } => false
    DestructiveOnce { approval_id: _, idempotency_key: _ } => false
  }
}

fn host_effect_nbd_proxy_serve_session_scope(intent: extdeps.bmc.webui.nbd_proxy_serve.NbdProxyServeTransportIntent) -> gunbc.session_lease.ProcessPortScope {
  gunbc.session_lease.ProcessPortScope {
    listen_port: intent.local_nbd_port,
    expected_owner_label: nbd_proxy_serve_expected_owner_label,
    expected_process_fingerprint: nbd_proxy_serve_session_fingerprint(),
  }
}

type NbdProxyServeSessionBinding {
  intent: extdeps.bmc.webui.nbd_proxy_serve.NbdProxyServeTransportIntent
  lease_key: std.types.NonEmptyStr
  scope: gunbc.session_lease.ProcessPortScope
  policy: std.temporal_effect.TemporalEffectPolicy
}

fn host_effect_nbd_proxy_serve_session_binding(
  intent: extdeps.bmc.webui.nbd_proxy_serve.NbdProxyServeTransportIntent,
  lease_key: std.types.NonEmptyStr,
) -> NbdProxyServeSessionBinding {
  NbdProxyServeSessionBinding {
    intent: intent,
    lease_key: lease_key,
    scope: host_effect_nbd_proxy_serve_session_scope(intent: intent),
    policy: host_effect_nbd_proxy_serve_session_policy(lease_key: lease_key),
  }
}

fn host_effect_nbd_proxy_serve_append_argv(
  acc: List<String>,
  argv: List<String>,
) -> List<String> {
  fold(argv, init: acc, f: (xs, arg) => list_push(xs, arg))
}

fn host_effect_nbd_proxy_serve_witness_bin_run_argv(
  transport: gunbc.host_effect.HostEffectTransport,
  bin_path: String,
  args: List<String>,
) -> Bool {
  match transport {
    LocalShell =>
      gunbc.WitnessBin.Run(workdir: "/", bin_path: bin_path, args: args).success
    SshShell { ssh_host: _ } => false
    FleetSsh { target: _, context: _ } => false
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => false
  }
}

fn host_effect_nbd_proxy_serve_systemd_run_transient(
  unit: std.types.NonEmptyStr,
  command_argv: List<String>,
  transport: gunbc.host_effect.HostEffectTransport,
) -> Bool {
  let args = host_effect_nbd_proxy_serve_append_argv(
    acc: ["--unit", unit as String, "--collect", "--"],
    argv: command_argv,
  )
  host_effect_nbd_proxy_serve_witness_bin_run_argv(
    transport: transport,
    bin_path: "/usr/bin/systemd-run",
    args: args,
  )
}

fn host_effect_nbd_proxy_serve_systemd_stop_unit(
  unit: std.types.NonEmptyStr,
  transport: gunbc.host_effect.HostEffectTransport,
) -> Bool {
  host_effect_nbd_proxy_serve_witness_bin_run_argv(
    transport: transport,
    bin_path: "/usr/bin/systemctl",
    args: ["stop", unit as String],
  )
}

fn host_effect_nbd_proxy_serve_observe_port(
  _scope: gunbc.session_lease.ProcessPortScope,
  transport: gunbc.host_effect.HostEffectTransport,
) -> gunbc.session_lease.ProcessPortObservation {
  match transport {
    LocalShell => PortInaccessible
    SshShell { ssh_host: _ } => PortInaccessible
    FleetSsh { target: _, context: _ } => PortInaccessible
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => PortInaccessible
  }
}

fn host_effect_nbd_proxy_serve_apply_refuses_when_observe_unimplemented(
  binding: NbdProxyServeSessionBinding,
  transport: gunbc.host_effect.HostEffectTransport,
) -> Bool {
  match host_effect_nbd_proxy_serve_apply(binding: binding, transport: transport) {
    NbdProxyServeApplyRefused { reason: why } =>
      string_contains(s: why, pattern: "port inaccessible")
    _ => false
  }
}

fn host_effect_nbd_proxy_serve_apply_classification(
  binding: NbdProxyServeSessionBinding,
  obs: gunbc.session_lease.ProcessPortObservation,
) -> UpsertClassification<gunbc.session_lease.ProcessLeasePlan> {
  classify_process_port_upsert(scope: binding.scope, obs: obs)
}

fn host_effect_nbd_proxy_serve_apply_refuses_foreign_port(
  binding: NbdProxyServeSessionBinding,
  obs: gunbc.session_lease.ProcessPortObservation,
) -> Bool {
  match host_effect_nbd_proxy_serve_apply_classification(binding: binding, obs: obs) {
    UpsertClassification { verdict: Conflict, decision: Refuse { reason: _ } } => true
    _ => false
  }
}

fn host_effect_nbd_proxy_serve_apply_drains_stale_matching(
  binding: NbdProxyServeSessionBinding,
  obs: gunbc.session_lease.ProcessPortObservation,
) -> Bool {
  match host_effect_nbd_proxy_serve_apply_classification(binding: binding, obs: obs) {
    UpsertClassification {
      verdict: Drifted,
      decision: Apply { plan: DrainMatchingStaleThenStart },
    } => true
    _ => false
  }
}

fn host_effect_nbd_proxy_serve_read_session_token() -> String? {
  let read = Filesystem.Read(path: srv3_bmcweb_token_path)
  match read.success {
    true =>
      match read.content != "" {
        true => Present { value: read.content }
        false => Absent
      }
    false => Absent
  }
}

fn host_effect_nbd_proxy_serve_websocat_argv_materialized(
  intent: extdeps.bmc.webui.nbd_proxy_serve.NbdProxyServeTransportIntent,
  token: std.types.NonEmptyStr,
) -> List<String> {
  nbd_proxy_serve_websocat_argv(
    intent: nbd_proxy_serve_transport_intent(
      bmc_host: intent.bmc_host,
      session_token: token,
      ws_path: intent.ws_path,
      iso_path: intent.iso_path,
      local_nbd_port: intent.local_nbd_port,
    ),
  )
}

fn host_effect_nbd_proxy_serve_websocat_argv_materialized_omits_shell_env_ref(
  intent: extdeps.bmc.webui.nbd_proxy_serve.NbdProxyServeTransportIntent,
  token: std.types.NonEmptyStr,
) -> Bool {
  let argv = host_effect_nbd_proxy_serve_websocat_argv_materialized(intent: intent, token: token)
  let surface = fold(
    argv,
    init: "",
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
  string_contains(s: surface, pattern: token as String)
    && !string_contains(s: surface, pattern: "$BMCWEB_SESSION_TOKEN")
}

fn host_effect_nbd_proxy_serve_start_units(
  binding: NbdProxyServeSessionBinding,
  transport: gunbc.host_effect.HostEffectTransport,
) -> Bool {
  let nbdkit_unit = nbd_proxy_serve_nbdkit_unit_name(lease_key: binding.lease_key)
  let websocat_unit = nbd_proxy_serve_websocat_unit_name(lease_key: binding.lease_key)
  match host_effect_nbd_proxy_serve_read_session_token() {
    Absent => false
    Present { value: token } =>
      host_effect_nbd_proxy_serve_systemd_run_transient(
        unit: nbdkit_unit,
        command_argv: nbd_proxy_serve_nbdkit_argv(intent: binding.intent),
        transport: transport,
      )
        && host_effect_nbd_proxy_serve_systemd_run_transient(
          unit: websocat_unit,
          command_argv: host_effect_nbd_proxy_serve_websocat_argv_materialized(
            intent: binding.intent,
            token: token as std.types.NonEmptyStr,
          ),
          transport: transport,
        )
  }
}

fn host_effect_nbd_proxy_serve_drain_stale_units(
  binding: NbdProxyServeSessionBinding,
  transport: gunbc.host_effect.HostEffectTransport,
) -> Bool {
  host_effect_nbd_proxy_serve_systemd_stop_unit(
    unit: nbd_proxy_serve_nbdkit_unit_name(lease_key: binding.lease_key),
    transport: transport,
  )
    && host_effect_nbd_proxy_serve_systemd_stop_unit(
      unit: nbd_proxy_serve_websocat_unit_name(lease_key: binding.lease_key),
      transport: transport,
    )
}

type NbdProxyServeApplyOutcome
  = NbdProxyServeApplyConverged { stdout: String }
  | NbdProxyServeApplyRefused { reason: String }

fn host_effect_nbd_proxy_serve_apply(
  binding: NbdProxyServeSessionBinding,
  transport: gunbc.host_effect.HostEffectTransport,
) -> NbdProxyServeApplyOutcome {
  let obs = host_effect_nbd_proxy_serve_observe_port(scope: binding.scope, transport: transport)
  match host_effect_nbd_proxy_serve_apply_classification(binding: binding, obs: obs).decision {
    Noop =>
      NbdProxyServeApplyConverged {
        stdout: concat(
          "NbdProxyServeSessionReceipt: verdict=Converged unit=",
          nbd_proxy_serve_websocat_unit_name(lease_key: binding.lease_key) as String,
        ),
      }
    Refuse { reason: why } =>
      NbdProxyServeApplyRefused { reason: why as String }
    Apply { plan: Start } =>
      if host_effect_nbd_proxy_serve_start_units(binding: binding, transport: transport) {
        NbdProxyServeApplyConverged {
          stdout: concat(
            "NbdProxyServeSessionReceipt: verdict=Absent plan=Start unit=",
            nbd_proxy_serve_websocat_unit_name(lease_key: binding.lease_key) as String,
          ),
        }
      } else {
        NbdProxyServeApplyRefused { reason: "nbd-proxy-serve: systemd-run transient start failed; fail-closed" }
      }
    Apply { plan: DrainMatchingStaleThenStart } =>
      if host_effect_nbd_proxy_serve_drain_stale_units(binding: binding, transport: transport)
        && host_effect_nbd_proxy_serve_start_units(binding: binding, transport: transport)
      {
        NbdProxyServeApplyConverged {
          stdout: concat(
            "NbdProxyServeSessionReceipt: verdict=Drifted plan=DrainMatchingStaleThenStart unit=",
            nbd_proxy_serve_websocat_unit_name(lease_key: binding.lease_key) as String,
          ),
        }
      } else {
        NbdProxyServeApplyRefused { reason: "nbd-proxy-serve: stale drain or restart failed; fail-closed" }
      }
  }
}

fn host_effect_nbd_proxy_serve_apply_with_observation(
  binding: NbdProxyServeSessionBinding,
  obs: gunbc.session_lease.ProcessPortObservation,
  transport: gunbc.host_effect.HostEffectTransport,
) -> NbdProxyServeApplyOutcome {
  match host_effect_nbd_proxy_serve_apply_classification(binding: binding, obs: obs).decision {
    Noop =>
      NbdProxyServeApplyConverged { stdout: "NbdProxyServeSessionReceipt: verdict=Converged" }
    Refuse { reason: why } =>
      NbdProxyServeApplyRefused { reason: why as String }
    Apply { plan: Start } =>
      if host_effect_nbd_proxy_serve_start_units(binding: binding, transport: transport) {
        NbdProxyServeApplyConverged { stdout: "NbdProxyServeSessionReceipt: verdict=Absent plan=Start" }
      } else {
        NbdProxyServeApplyRefused { reason: "nbd-proxy-serve: systemd-run transient start failed; fail-closed" }
      }
    Apply { plan: DrainMatchingStaleThenStart } =>
      if host_effect_nbd_proxy_serve_drain_stale_units(binding: binding, transport: transport)
        && host_effect_nbd_proxy_serve_start_units(binding: binding, transport: transport)
      {
        NbdProxyServeApplyConverged {
          stdout: "NbdProxyServeSessionReceipt: verdict=Drifted plan=DrainMatchingStaleThenStart",
        }
      } else {
        NbdProxyServeApplyRefused { reason: "nbd-proxy-serve: stale drain or restart failed; fail-closed" }
      }
  }
}
