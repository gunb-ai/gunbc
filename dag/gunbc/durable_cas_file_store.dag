module gunbc.durable_cas_file_store

import std.types { NonEmptyStr, String, Int, Bool, List }
import std.algebra { trim }
import std.content_hash { ContentHash, content_hash_of_value, compare_content_hash, ContentHashEqual, ContentHashDifferent, ContentHashCrossFamilyIncomparable }
import std.durable_compare_and_set { CasAttempt, cas_attempt, CasOutcome, CasCommitted, CasPreconditionFailed, CasStoreRefused, CasExpectation, ExpectSlotAbsent, ExpectSlotGeneration, CasGeneration, CasSlotVersion, CasReadableAbsent, CasReadablePresent, CasSlotObservation, CasObservedReadable, CasObservedUnreadable, CasUnreadableMalformed, CasUnreadableReadRefused, CasUnreadableObservationBoundExceeded, CasStoreFailure, CasSlotObservationRefused, CasGenerationPublicationRefused, cas_generation_first, cas_generation_next, cas_generation_count }
import extdeps.filesystem.filesystem_io {
  Filesystem,
  FilesystemCreateNew, FilesystemCreated, FilesystemCreateTargetOccupied, FilesystemCreateRefused, FilesystemCreateKindUnrecognized,
  FilesystemExactRead, FilesystemExactPathRead, FilesystemExactPathAbsent, FilesystemExactPathUnreadable, FilesystemExactPathKindUnrecognized,
  FilesystemFailureKind,   filesystem_create_new, filesystem_exact_read, filesystem_failure_kind_name,
}

data authorization_claim_store_root: NonEmptyStr = "/var/lib/gunbc/authorization-claims" as NonEmptyStr

// The first production realization of std.durable_compare_and_set: one keyed
// slot backed by generation-suffixed files, exclusion supplied by O_EXCL.
//
// WHY THIS SHAPE. The interface module states the realization it wants --
// "folding read and conditional-write into ONE store-owned operation so no
// caller ever supplies an observation separately", with the store reading
// attempt.key itself. That is what file_compare_and_set is. The caller hands
// over an attempt and never an observation, so the declared key-relation
// boundary obligation is CLOSED HERE BY CONSTRUCTION rather than observed and
// refused: there is no second argument in which a caller could supply an
// observation read from another slot.
//
// WHY GENERATION-SUFFIXED FILES, which is the whole mechanism. A slot at
// generation N is the file <root>/<key>.<N>, written once and never rewritten.
// Then BOTH expectations collapse into the same primitive:
//
//   ExpectSlotAbsent          -> create-new <key>.1
//   ExpectSlotGeneration{N}   -> create-new <key>.<N+1>
//
// and create-new is O_EXCL, which fails if the path exists. So the exclusion
// is performed by the operating system on the write itself, not by a lock the
// caller holds. That is the gap the interface module names: the exclusion in
// fleet_converge_plan_cli is flock, which is single-host by construction and
// cannot serialize two writers on different hosts. O_EXCL on a shared
// filesystem can -- BUT ONLY AGAINST THE SAME STORE INSTANCE, and the premise
// matters enough to state rather than imply. O_EXCL serializes two writers when
// they address one store: a shared filesystem whose exclusive-create semantics
// are trusted, or a single control plane performing the operation. Two LOCAL
// roots on two hosts are two independent stores and exclude nothing from each
// other. No update-in-place operation is needed at all, and one is deliberately
// not offered.
//
// THE ORDERING, CORRECTED. An earlier revision of this module read "the write
// DECIDES and the read only REPORTS", and computed the target generation from
// the expectation alone before writing. That is sound for ExpectSlotAbsent and
// WRONG for ExpectSlotGeneration, because O_EXCL excludes competing writers for
// the TARGET PATH and establishes nothing about which generation is currently
// the head.
//
// The counterexample that retired it: an EMPTY store, an attempt expecting
// generation 7. The target is 8, no key.8 exists, the exclusive create succeeds,
// and the old code reported CasCommitted -- committing on a precondition that
// was never true. Likewise a slot at generation 3 expecting 7: key.8 is free, so
// the write wins and skips 4 through 7.
//
// THE CORRECT INVARIANT IS: THE READ ESTABLISHES ELIGIBILITY, THE EXCLUSIVE
// WRITE DECIDES THE WINNER. Reading first does NOT reopen a time-of-check to
// time-of-use race, which is the objection that produced the wrong ordering in
// the first place: if two writers both observe head N, both derive target N+1,
// and both attempt an exclusive create, exactly one succeeds. The race is
// resolved by the write exactly as before -- what the read adds is that a writer
// whose expectation never matched the store is refused instead of winning.
//
// So the sequence is: observe the slot, compare the observation against the
// expectation, derive the target from the OBSERVATION, create it exclusively,
// and only then report a commit.

// WHY A FAILED PUBLICATION IS CLASSIFIED BY filesystem_create_new THEN A
// SECOND OBSERVATION, NEVER BY write.error TEXT. Occupancy is the host kind
// already_exists (FilesystemCreateTargetOccupied). Permission, space, IO,
// staging and unrecognized kinds are CasStoreRefused. Occupancy without a
// readable winner is also CasStoreRefused -- re-observing absence must not
// mint CasPreconditionFailed. The observation is consulted only after the
// host has already said the name was occupied.
//
// WHAT THIS MODULE DOES NOT DO. It does not create <root>; a missing root
// surfaces as a store refusal rather than being silently created, because
// creating the directory that defines the control plane's identity is a
// convergence decision and not a side effect of one attempt. It offers no
// delete and no rewrite, so the append-only invariant the disambiguation above
// depends on is preserved by the absence of an operation rather than by a rule
// anyone has to follow.

// The verified attempt, and the reason it exists is a gap this realization
// found in the interface by being the first thing to implement it.
//
// CasOutcome has exactly three arms -- committed, precondition failed, store
// refused -- and NONE of them can say "the attempt's proposed_content is not
// the digest of its proposed value". Reporting that as CasStoreRefused would
// blame the store for a caller's inconsistency, which is the state-space
// conflation DESIGN names: two states with opposite owners and opposite
// repairs collapsed onto one symbol.
//
// The interface module says the pairing "cannot be closed by construction in a
// pure generic fold" because content_hash_of_value is not generic over T, and
// that is correct THERE. It does not bind HERE: this realization is concrete
// at NonEmptyStr, which is exactly the type content_hash_of_value accepts, so
// the digest IS derivable from the payload at this layer. The interface also
// names where the duty belongs -- "the obligation belongs to the immutable
// object store that realizes this interface: it holds the bytes, so it can
// verify bytes against digest" -- and this is that store.
//
// So rather than widen CasOutcome, the input is narrowed. Verification happens
// at the mint, and file_compare_and_set accepts only the minted form; the
// unverified pair is not refused downstream, it is unwritable there. This is
// the same move the interface made when it narrowed CasSlotObservation to
// CasReadableSlot -- deleting arms instead of checking them.
//
// sole_constructor is the wall: admit_cas_attempt is the only mint, so no
// caller in any other module can produce a VerifiedCasAttempt by writing the
// record literal. RUNG: structurally guaranteed on the source-to-.dag
// acceptance path, which is the path this store is consumed on. It is NOT
// claimed for the emitted-Rust path, where DESIGN records by execution that a
// sole_constructor type's emitted mirror is forgeable; that is a known gap in
// the wall itself and not a property of this carrier.
type VerifiedCasAttempt sole_constructor {
  attempt: CasAttempt<NonEmptyStr>
}

// Why a digest disagreement and a cross-family pair are separate arms: they
// have different repairs. A mismatch means the caller paired one value with
// another value's digest and the fix is in the caller. Incomparable means the
// two hashes are from different families and no comparison was possible at
// all, so nothing was checked -- an absence of evidence, and reporting it as a
// mismatch would be a verdict the store never reached. compare_content_hash
// exists precisely to refuse that collapse, and consuming it while flattening
// its third arm would discard the distinction it was built to preserve.
// THE KEY MUST NAME A SLOT, NOT A PATH, and this arm is a defect found by
// building the realization rather than by reading the model.
//
// cas_file_slot_path interpolates the key straight into a filesystem path. A
// key containing a slash therefore stops being an identifier and becomes
// navigation: "../../etc/passwd" writes OUTSIDE the store root entirely, and
// any key with a slash also needs directories this store deliberately does not
// create. Neither is a store fault to be reported -- both are keys that should
// never have reached the store.
//
// REFUSING THE SLASH IS SUFFICIENT, and the reason is worth stating because it
// is not obvious. A bare ".." is harmless here: the generation suffix is ALWAYS
// appended, so ".." becomes the file "...1" and can never be the final path
// component. Traversal needs a separator to climb, so removing the separator
// removes the class -- this is one predicate, not a blocklist of dangerous
// spellings, and a blocklist would be the heuristic DESIGN 4 says a closed
// system never needs.
type CasAttemptAdmission
  = CasAttemptAdmitted { verified: VerifiedCasAttempt }
  | CasAttemptKeyNotSlotAddressable { key: NonEmptyStr }
  | CasAttemptDigestMismatch { claimed: ContentHash, actual: ContentHash }
  | CasAttemptDigestIncomparable { claimed: ContentHash, actual: ContentHash }

fn cas_key_is_slot_addressable(key: NonEmptyStr) -> Bool {
  !(key as String).contains("/")
}

fn admit_cas_attempt(attempt: CasAttempt<NonEmptyStr>) -> CasAttemptAdmission {
  if !cas_key_is_slot_addressable(key: attempt.key) {
    CasAttemptKeyNotSlotAddressable { key: attempt.key }
  } else {
    cas_admit_verified_digest(attempt: attempt)
  }
}

fn cas_admit_verified_digest(attempt: CasAttempt<NonEmptyStr>) -> CasAttemptAdmission {
  let actual = content_hash_of_value(value: attempt.proposed)
  match compare_content_hash(left: attempt.proposed_content, right: actual) {
    ContentHashEqual => CasAttemptAdmitted { verified: VerifiedCasAttempt { attempt: attempt } }
    ContentHashDifferent => CasAttemptDigestMismatch { claimed: attempt.proposed_content, actual: actual }
    ContentHashCrossFamilyIncomparable => CasAttemptDigestIncomparable { claimed: attempt.proposed_content, actual: actual }
  }
}

// A CALLER THAT DERIVED THE DIGEST FROM THE PAYLOAD CANNOT DISAGREE WITH ITSELF.
//
// `admit_cas_attempt` must ask, because it accepts a digest the caller SUPPLIED, and the whole point
// of that check is that a supplied digest can be a forgery -- the generic mint's discriminating red.
// But a caller that computes `content_hash_of_value` over the very value it is proposing has no
// second opinion to disagree with: the comparison is `f(x)` against `f(x)`. Both digest arms are
// unreachable for it, and `gunbc.scm.repository_slot` was carrying a public
// `RepositoryPublicationDigestDisagreed` to match them -- the `callee_arm_carried_past_its_exclusion` class again, honest about
// this module's domain and dishonest about the caller's. Found by external review.
//
// SO THE DIGEST IS DERIVED HERE RATHER THAN ACCEPTED, and the outcome narrows to the one refusal that
// IS reachable: a key that does not address a slot. That is not a weaker admission -- it is the same
// admission asked of a caller who has nothing to forge WITH, because it never held a digest to pass.
type DerivedPayloadAdmission
  = DerivedPayloadAdmitted { verified: VerifiedCasAttempt }
  | DerivedPayloadKeyNotSlotAddressable { key: NonEmptyStr }

fn admit_cas_attempt_for_derived_payload(
  key: NonEmptyStr,
  expected: CasExpectation,
  proposed: NonEmptyStr,
) -> DerivedPayloadAdmission {
  if !cas_key_is_slot_addressable(key: key) {
    DerivedPayloadKeyNotSlotAddressable { key: key }
  } else {
    DerivedPayloadAdmitted {
      verified: VerifiedCasAttempt {
        attempt: cas_attempt(
          key: key,
          expected: expected,
          proposed: proposed,
          proposed_content: content_hash_of_value(value: proposed),
        )
      }
    }
  }
}

// The path a slot's generation occupies. The generation is IN the path, which
// is what lets an exclusive create serve as the conditional write: two
// generations of one slot are two different files, so the OS decides the race.
fn cas_file_slot_path(root: NonEmptyStr, key: NonEmptyStr, generation: CasGeneration) -> String {
  concat(concat(concat(concat(root as String, "/"), key as String), "."), cas_generation_count(g: generation) as String)
}

// HOW THE SLOT IS OBSERVED, AND THE BOUND IS PART OF THE CONTRACT.
//
// Generations are contiguous and append-only, so the head is found by probing
// upward from 1 until a generation is absent. That needs only Read, no
// directory listing and no parsing of names back into numbers -- a filesystem
// layout that had to be re-parsed to be understood would be a second identity
// authority beside the key.
//
// THE PROBE IS BOUNDED AND THE BOUND REFUSES RATHER THAN TRUNCATING. Running off
// the end returns a typed refusal, not "the head is wherever I stopped looking":
// a walk that silently reported its own patience as the answer would be the
// bound-shaped closure DESIGN names, where a real number satisfies a question it
// never measured.
//
// READ CLASSIFICATION IS THE HOST KIND CHANNEL, NEVER THE ERROR TEXT.
// filesystem_exact_read already partitions NotFound from PermissionDenied /
// Other / unrecognized names. Treating every unsuccessful Read as the end of
// the chain was the same empty-observation collapse observe_cas_slot_state
// exists to refuse: a generation that could not be read was reported as absent,
// and a decision caller would try to occupy it.
type CasSlotProbe
  = ProbedAbsent
  | ProbedHead { generation: CasGeneration, value: NonEmptyStr }
  | ProbedBeyondBound { bound: Int }
  | ProbedUnreadable { generation: CasGeneration, kind: FilesystemFailureKind }
  | ProbedReadKindUnrecognized { generation: CasGeneration, observed: String }

data cas_max_generation_probe: Int = 4096

fn cas_probe_from(root: NonEmptyStr, key: NonEmptyStr, generation: CasGeneration, previous: NonEmptyStr) -> CasSlotProbe {
  if cas_generation_count(g: generation) > cas_max_generation_probe {
    ProbedBeyondBound { bound: cas_max_generation_probe }
  } else {
    let path = cas_file_slot_path(root: root, key: key, generation: generation)
    let read = Filesystem.Read(path: path)
    cas_probe_from_exact(
      root: root,
      key: key,
      generation: generation,
      previous: previous,
      exact: filesystem_exact_read(path: path, content: read.content, success: read.success, error: read.error, error_kind: read.error_kind),
    )
  }
}

fn cas_probe_from_exact(
  root: NonEmptyStr,
  key: NonEmptyStr,
  generation: CasGeneration,
  previous: NonEmptyStr,
  exact: FilesystemExactRead,
) -> CasSlotProbe {
  match exact {
    FilesystemExactPathRead { path: _, content: c } =>
      cas_probe_from(root: root, key: key, generation: cas_generation_next(g: generation), previous: c as NonEmptyStr)
    FilesystemExactPathAbsent { path: _ } =>
      if cas_generation_count(g: generation) == 1 {
        ProbedAbsent
      } else {
        ProbedHead { generation: cas_generation_count(g: generation) - 1, value: previous }
      }
    FilesystemExactPathUnreadable { path: _, kind: k, error: _ } =>
      ProbedUnreadable { generation: generation, kind: k }
    FilesystemExactPathKindUnrecognized { path: _, observed: o, error: _ } =>
      ProbedReadKindUnrecognized { generation: generation, observed: o }
  }
}

fn cas_observe_slot(root: NonEmptyStr, key: NonEmptyStr) -> CasSlotProbe {
  cas_probe_from(root: root, key: key, generation: cas_generation_first(), previous: "unread" as NonEmptyStr)
}

// THE PROJECTION TAKES A HEAD, NOT A PROBE, AND THE DELETED ARM IS THE REPAIR.
//
// An earlier revision was `cas_probe_as_readable(probe: CasSlotProbe)`, total over the probe, mapping
// `ProbedBeyondBound` to `CasReadableAbsent`. Every call site happened to be inside a `ProbedHead`
// arm, so the bound arm was dead at all of them -- and `.dag` has no module privacy, so what the
// corpus actually carried was an importable function that turns EXPLICIT INABILITY TO OBSERVE into
// ESTABLISHED ABSENCE. That is the absorbing fallback DESIGN section 5 names, and the defence written
// beside it -- that answering absent is correct "for reporting what beat a lost race" -- was
// falsified by this module's own bound counterexample two screens down, where a writer really did
// publish and the probe still could not see it.
//
// Narrowing the parameter to the head deletes the arm rather than fixing its answer, so there is no
// projection left for a future caller to reach with a bound-exhausted probe.
fn cas_head_as_readable(generation: CasGeneration, value: NonEmptyStr) -> CasReadableSlot<NonEmptyStr> {
  CasReadablePresent {
    version: CasSlotVersion {
      generation: generation,
      content: content_hash_of_value(value: value),
      value: value,
    }
  }
}

// ONE AUTHORITY FOR WHAT BOUND EXHAUSTION IS. Three sites spelled it independently, twice as a
// malformed head, and a fourth spelling would have arrived with the next caller.
fn cas_slot_observation_bound_exceeded(bound: Int) -> CasUnreadableSlot {
  CasUnreadableObservationBoundExceeded { bound: bound }
}

// AN UNREADABLE GENERATION IS A SLOT-OBSERVATION REFUSAL, NEVER AN ABSENT SLOT.
//
// gunbc#11335 made the probe read through the host's failure kind, so a generation that exists and
// cannot be read is no longer the end of the chain. Its first projection then answered
// `CasReadableAbsent` for that arm, for bound exhaustion and for an unrecognized kind -- the
// importable inability-to-observe-as-absence this module had already deleted once. So the causes are
// named here, once, and no projection anywhere turns them into a readable answer. An unrecognized
// kind stays `CasUnreadableMalformed`: the host answered with a kind this corpus cannot name.
fn cas_generation_unreadable(generation: CasGeneration, kind: FilesystemFailureKind) -> CasUnreadableSlot {
  CasUnreadableReadRefused {
    detail: concat(
      concat("generation ", cas_generation_count(g: generation) as String),
      concat(" unreadable:", filesystem_failure_kind_name(kind: kind)),
    ) as NonEmptyStr
  }
}

fn cas_generation_read_kind_unrecognized(generation: CasGeneration, observed: String) -> CasUnreadableSlot {
  CasUnreadableMalformed {
    detail: concat(
      concat("generation ", cas_generation_count(g: generation) as String),
      concat(" read failure kind unrecognized: ", observed),
    ) as NonEmptyStr
  }
}

fn cas_probe_as_observation(probe: CasSlotProbe) -> CasSlotObservation<NonEmptyStr> {
  match probe {
    ProbedBeyondBound { bound: b } =>
      CasObservedUnreadable { cause: cas_slot_observation_bound_exceeded(bound: b) }
    ProbedUnreadable { generation: g, kind: k } =>
      CasObservedUnreadable { cause: cas_generation_unreadable(generation: g, kind: k) }
    ProbedReadKindUnrecognized { generation: g, observed: o } =>
      CasObservedUnreadable { cause: cas_generation_read_kind_unrecognized(generation: g, observed: o) }
    ProbedAbsent => CasObservedReadable { readable: CasReadableAbsent }
    ProbedHead { generation: h, value: v } =>
      CasObservedReadable { readable: cas_head_as_readable(generation: h, value: v) }
  }
}

// THE STORE'S OBSERVATION, FOR CALLERS THAT MUST DECIDE BEFORE THEY WRITE.
//
// file_compare_and_set needs no such surface: it observes and decides in one
// step, and its callers hand it an attempt rather than an observation. A
// caller that has to answer a question about the slot BEFORE proposing
// anything -- is this cell held, and by whom -- has no way to ask, and hand
// building an observation to feed such a decision would make the caller the
// author of the fact it is supposed to be reading.
//
// THE BOUND ARM IS UNREADABLE-WITH-A-CAUSE, and it is now the ONLY reading of
// it anywhere: the projection that used to answer CasReadableAbsent for it has
// been narrowed out of existence. A caller must not read "the slot holds
// nothing" from a store that could not tell it anything and then choose the
// remedy for an empty cell.
fn observe_cas_slot_state(root: NonEmptyStr, key: NonEmptyStr) -> CasSlotObservation<NonEmptyStr> {
  cas_probe_as_observation(probe: cas_observe_slot(root: root, key: key))
}

// ACCESS MODE AND CONDITIONAL PUBLICATION ARE TWO FACTS, AND THIS STORE HELD THEM AS ONE.
//
// Every generation was published with `Filesystem.WriteOwnerOnly`, so one operation decided both
// "publish this generation exclusively" and "these bytes are readable only by their owner". A caller
// could not select the second without inheriting the first, which is the interface/realization/policy
// fusion DESIGN section 3 names: confidentiality is a POLICY fact about a particular store's contents,
// and it was being decided by the store's write verb.
//
// SO THE BINDING IS A PARAMETER, AND IT IS REQUIRED RATHER THAN DEFAULTED. A default would have let
// the SCM slot inherit owner-only silently, exactly the way it inherited it before, and the point of
// separating the facts is that the choice becomes visible at each call site.
//
// THE TWO BINDINGS ARE NOT EQUALLY SAFE, AND SAYING SO IS THE WHOLE VALUE OF NAMING THEM.
//
//   DefaultAccessCreateOnly   Filesystem.WriteCreateNew. Its realization stages the bytes in a
//                             sibling file created O_EXCL, writes them all, synchronizes that inode,
//                             and only then hard-links it into the generation's name -- and a
//                             hard_link FAILS IF THE TARGET EXISTS, so exclusion is preserved. The
//                             generation name therefore never exists holding a partial document: the
//                             file is complete or it is absent.
//
//   OwnerOnlyCreateOnly       Filesystem.WriteOwnerOnly. Its realization opens the GENERATION NAME
//                             ITSELF with create_new + mode 0600 and writes into it directly. O_EXCL
//                             still decides who acquires the name, so the winner-selection property is
//                             intact -- but an interrupted or failed write_all leaves that name
//                             holding a READABLE PREFIX. The probe below then reads it successfully,
//                             promotes it to head, and computes a content hash from the prefix, so
//                             the truncation is internally consistent and nothing refuses. A reader
//                             sees neither the complete old document nor the complete new one.
//
// A DECLARED CURRENT LIMITATION ON THE OWNER-ONLY BINDING -- NOT A RUNG DROP, AND THE FIRST WRITING
// CALLED IT ONE.
//
// It was filed as a DESIGN section 4b(3) declared drop whose `previous rung` was `n/a`. Those cannot
// both be true: a drop is a REGRESSION RECORD, so it presupposes a guarantee that was held and is
// being given up, and a class with no previous rung has nothing to regress from. This hazard was
// never absent -- every generation was published this way from the module's first commit, undeclared.
// So what is owed is a limitation with a restoration trigger, which is what this is. Caught by
// external review of the drop row itself.
//
// THE POPULATION IS TWO CALLERS, AND THEY ARE NAMED. `gunbc.srv3.srv3_boot_once_cd` and
// `gunbc.machine_intake_mtcollins1_boot_run` publish authorization claim state under
// `authorization_claim_store_root`, and that root is a bare path constant: no
// modeled directory ownership or mode authority stands beside it. Mode 0600 on the generation file is
// therefore the ONLY confidentiality that state has, including for free-form abort-cause text, so
// flipping it to the atomic binding would trade a durable-state hazard for a real privacy regression.
// Both other consumers moved to `DefaultAccessCreateOnly`: the fabric reservations because
// `gunbc.fabric.fabric_allocation_store_substrate` already models both the store and its namespace as
// root-owned 0700 -- an unauthorized principal cannot traverse the directory, so file-level 0600 adds
// no reader exclusion there while retaining the hazard -- and the live probe because an instrument is
// not a final consumer that can justify keeping an unsafe arm alive in the production domain.
//
// RESTORATION TRIGGER, NAMING THE CAPABILITY AND NOT AN ARTIFACT: a modeled directory ownership and
// mode authority for the authorization-claim root, of the kind `AllocationStoreSubstrateSpec` already
// carries for fabric -- SUFFICIENT FOR that root to enforce confidentiality by traversal, at which
// point srv3 binds `DefaultAccessCreateOnly`, `OwnerOnlyCreateOnly` has no consumer, and this
// coproduct collapses to the single admitted publication operation. It is retired by that and by
// nothing else; in particular it is NOT retired by a failure-atomic mode-carrying write, which would
// be a different and larger capability than this population needs.
type CasGenerationPublication
  = DefaultAccessCreateOnly
  | OwnerOnlyCreateOnly

// THE ACTUATOR TAKES AN ADMITTED PUBLICATION, NOT A PATH AND SOME BYTES.
//
// `cas_generation_published(publication, path, content)` and
// `cas_commit_at(root, publication, attempt, target)` were both importable, and `.dag` has no module
// privacy, so the sequence `file_compare_and_set` is supposed to OWN -- verify the attempt, observe
// the slot, admit the expectation against the real head, derive the target FROM that observation,
// then publish -- was a convention among its own callers rather than a property of the actuator. A
// direct caller could supply `ExpectSlotGeneration { 999 }` against an empty store, choose target
// generation 1, and be answered `CasCommitted`; or write arbitrary content to an arbitrary path,
// bypassing key admission including the path-escape check. That the one live caller composes them
// correctly does not constrain their domains. Found by external review.
//
// `AdmittedCasPublication` is `sole_constructor`, so it can be built only inside this module, and the
// only two places that build it are the branches of `file_compare_and_set` reached AFTER the attempt
// was verified, the slot observed, and the expectation matched against the real head -- each carrying
// the target DERIVED from that observation. The actuator takes it, so the
// path is derived from the admitted key rather than accepted, and the bytes are the verified
// attempt's rather than an argument.
type AdmittedCasPublication sole_constructor {
  root: NonEmptyStr
  publication: CasGenerationPublication
  attempt: CasAttempt<NonEmptyStr>
  target: CasGeneration
}

// TWO BINDINGS, TWO CLASSIFIERS, AND THE DIFFERENCE IS WHAT THE HOST CAN SAY.
//
// `WriteCreateNew` answers the host's failure kind, so its refusal is classified by
// `filesystem_create_new` and no error text is read: occupancy is `FilesystemCreateTargetOccupied`
// and every other kind is the store refusing to publish. `WriteOwnerOnly` answers no kind, so its
// failure is classified the only structural way available -- re-observe and ask whether the target
// generation appeared -- in `cas_owner_only_failed_publication`.
fn cas_commit_at(admitted: AdmittedCasPublication) -> CasOutcome<NonEmptyStr> {
  let root = admitted.root
  let attempt = admitted.attempt
  let target = admitted.target
  let path = cas_file_slot_path(root: root, key: attempt.key, generation: target)
  let content = attempt.proposed as String
  match admitted.publication {
    DefaultAccessCreateOnly => {
      let write = Filesystem.WriteCreateNew(path: path, content: content)
      cas_outcome_from_create(
        attempt: attempt,
        target: target,
        created: filesystem_create_new(path: write.path, success: write.success, error: write.error, error_kind: write.error_kind),
        post: observe_cas_slot_state(root: root, key: attempt.key),
      )
    }
    OwnerOnlyCreateOnly => {
      let write = Filesystem.WriteOwnerOnly(path: path, content: content)
      if write.success {
        CasCommitted {
          committed: CasSlotVersion { generation: target, content: attempt.proposed_content, value: attempt.proposed }
        }
      } else {
        cas_owner_only_failed_publication(root: root, attempt: attempt, target: target, detail: write.error)
      }
    }
  }
}

// THE CLASSIFICATION FOLD FOR THE TYPED BINDING (gunbc#11335). Occupancy is
// FilesystemCreateTargetOccupied PLUS a readable winner; an occupied report whose re-observation
// cannot be read refuses with that observation's cause; an occupied report with no winner, and
// every other kind, is the store refusing to publish. Re-observing absence after a failed
// publication must not mint CasPreconditionFailed: that is the store-refusal-as-contention widen.
fn cas_outcome_from_create(
  attempt: CasAttempt<NonEmptyStr>,
  target: CasGeneration,
  created: FilesystemCreateNew,
  post: CasSlotObservation<NonEmptyStr>,
) -> CasOutcome<NonEmptyStr> {
  match created {
    FilesystemCreated { path: _ } =>
      CasCommitted {
        committed: CasSlotVersion { generation: target, content: attempt.proposed_content, value: attempt.proposed }
      }
    FilesystemCreateTargetOccupied { path: _ } => cas_occupied_publication_outcome(attempt: attempt, post: post)
    FilesystemCreateRefused { path: _, kind: k, error: _ } =>
      cas_publication_refused(detail: concat("the store refused publication: ", filesystem_failure_kind_name(kind: k)))
    FilesystemCreateKindUnrecognized { path: _, observed: o, error: _ } =>
      cas_publication_refused(detail: concat("the store refused publication with an unrecognized failure kind: ", o))
  }
}

fn cas_occupied_publication_outcome(
  attempt: CasAttempt<NonEmptyStr>,
  post: CasSlotObservation<NonEmptyStr>,
) -> CasOutcome<NonEmptyStr> {
  match post {
    CasObservedUnreadable { cause: c } => CasStoreRefused { cause: CasSlotObservationRefused { cause: c } }
    CasObservedReadable { readable: r } =>
      match r {
        CasReadablePresent { version: _ } =>
          CasPreconditionFailed { expected: attempt.expected, observed: r }
        CasReadableAbsent =>
          cas_publication_refused(detail: "exclusive create reported occupancy and no readable generation was observed")
      }
  }
}

// A FAILED WRITE IS NOT EVIDENCE THAT SOMEBODY ELSE WON, AND THIS FUNCTION IS THE REPAIR OF A LINE
// THAT SAID IT WAS. It now serves only the owner-only binding, whose write answers no failure kind.
//
// The earlier body answered `CasPreconditionFailed` for EVERY unsuccessful write, with the observed
// slot re-read afterwards. When the failure was a genuine lost race that is exactly right: the target
// generation exists because another writer took it, and the re-observation names what beat us. When
// the failure was the HOST -- no space, no permission, a staging budget exhausted -- the target does
// not exist, the re-observation returns the same generation we expected, and the store reported:
//
//   CasPreconditionFailed { expected: generation 7, observed: generation 7 }
//
// A precondition failure whose precondition plainly held. That is a fabricated cause, and it is the
// worse kind: it routes an operator to look for a competing writer that does not exist, while the
// actual fault -- a store that cannot accept writes -- goes unreported and uncounted. The wet
// two-writer control cannot catch it, because in that run both writes are valid and one genuinely
// loses; nothing there presents a host refusal.
//
// SO THE RE-OBSERVATION DECIDES, AND IT ASKS THE ONE QUESTION THAT DISCRIMINATES: DID THE TARGET
// GENERATION APPEAR? If the head has reached the target, some other writer published it and this is a
// lost race. If it has not, nothing took our slot and the store simply refused us. The host's text is
// carried into the refusal and never parsed -- classifying by matching on an error string is the
// anemic leaf this module already refuses one screen up.
//
// AND THE REFUSAL NOW HAS ITS OWN CONSTRUCTOR. An earlier revision routed it through
// `CasUnreadableMalformed`, on the ground that the caller's remedy -- investigate the store -- is the
// same either way. That reasoning was wrong and is worth keeping visible: identical remedies do not
// make two facts one fact, and the fact is what a caller reads back, logs and counts. A write failure
// wearing a read failure's constructor reports "the head I read is garbage" for an event in which
// nothing was read and the head is fine. `std.durable_compare_and_set.CasStoreFailure` now carries the
// distinction, so this says what happened.
fn cas_owner_only_failed_publication(
  root: NonEmptyStr,
  attempt: CasAttempt<NonEmptyStr>,
  target: CasGeneration,
  detail: String,
) -> CasOutcome<NonEmptyStr> {
  let probe = cas_observe_slot(root: root, key: attempt.key)
  match probe {
    ProbedHead { generation: h, value: v } =>
      if cas_generation_count(g: h) >= cas_generation_count(g: target) {
        CasPreconditionFailed {
          expected: attempt.expected,
          observed: cas_head_as_readable(generation: h, value: v),
        }
      } else {
        cas_publication_refused(detail: detail)
      }
    ProbedAbsent => cas_publication_refused(detail: detail)
    ProbedBeyondBound { bound: b } => cas_publication_beyond_bound(bound: b)
    ProbedUnreadable { generation: g, kind: k } =>
      CasStoreRefused { cause: CasSlotObservationRefused { cause: cas_generation_unreadable(generation: g, kind: k) } }
    ProbedReadKindUnrecognized { generation: g, observed: o } =>
      CasStoreRefused {
        cause: CasSlotObservationRefused { cause: cas_generation_read_kind_unrecognized(generation: g, observed: o) }
      }
  }
}

// THE BOUND ARM CANNOT SAY THE STORE REFUSED TO PUBLISH, AND A FIRST CUT SAID IT ANYWAY.
//
// It routed `ProbedBeyondBound` to the publication refusal along with the other two, on the reasoning
// that the write had failed and the target had not appeared. The second half does not follow. Consider
// a slot whose head is 4095 and two writers targeting 4096:
//
//   the other writer wins 4096; this writer's create fails
//   the re-observation reads 4096 successfully and probes 4097
//   4097 exceeds the bound, so the probe answers ProbedBeyondBound
//
// Another writer DID publish. Reporting a publication refusal there invents the wrong cause -- the
// same fabrication the lost-race repair one screen up exists to remove, reappearing in the arm that
// repair did not consider. Found by external review.
//
// SO THIS ANSWERS WHAT IS ACTUALLY KNOWN: the slot could not be observed. It is a slot-observation
// refusal, not a publication refusal and not a precondition failure, because the probe no longer holds
// a readable head to report as the winner. The ordinary two-writer control runs far below the bound
// and cannot discriminate this arm, so it has its own control.
//
// AND THE CAUSE IS BOUND EXHAUSTION, NOT A MALFORMED HEAD, which the first version of this repair got
// wrong in the other direction: it stopped claiming the publication failed and then said the slot's
// contents were garbage. A slot holding 4096 contiguous, perfectly well formed generations is not
// malformed, and telling an operator it is sends them to repair bytes that are fine. Found by external
// review, on this function's own repair.
fn cas_publication_beyond_bound(bound: Int) -> CasOutcome<NonEmptyStr> {
  CasStoreRefused {
    cause: CasSlotObservationRefused { cause: cas_slot_observation_bound_exceeded(bound: bound) }
  }
}

fn cas_publication_refused(detail: String) -> CasOutcome<NonEmptyStr> {
  CasStoreRefused {
    cause: CasGenerationPublicationRefused { detail: detail as NonEmptyStr }
  }
}

// The store-owned compare-and-set. It reads attempt.key itself; no caller
// supplies an observation, which is what closes the key-relation obligation.
//
// THE TARGET GENERATION IS DERIVED FROM THE OBSERVATION, NEVER FROM THE
// EXPECTATION. That is the whole correction: an expectation is a claim about the
// store, and deriving the write target from the claim rather than from the store
// is what let an attempt expecting generation 7 commit against an empty slot.
fn file_compare_and_set(
  root: NonEmptyStr,
  publication: CasGenerationPublication,
  verified: VerifiedCasAttempt,
) -> CasOutcome<NonEmptyStr> {
  let attempt = verified.attempt
  let probe = cas_observe_slot(root: root, key: attempt.key)
  match probe {
    ProbedBeyondBound { bound: b } =>
      CasStoreRefused {
        cause: CasSlotObservationRefused { cause: cas_slot_observation_bound_exceeded(bound: b) }
      }
    ProbedUnreadable { generation: g, kind: k } =>
      CasStoreRefused { cause: CasSlotObservationRefused { cause: cas_generation_unreadable(generation: g, kind: k) } }
    ProbedReadKindUnrecognized { generation: g, observed: o } =>
      CasStoreRefused {
        cause: CasSlotObservationRefused { cause: cas_generation_read_kind_unrecognized(generation: g, observed: o) }
      }
    ProbedAbsent =>
      match attempt.expected {
        ExpectSlotAbsent =>
          cas_commit_at(
            admitted: AdmittedCasPublication {
              root: root, publication: publication, attempt: attempt,
              target: cas_generation_first(),
            }
          )
        ExpectSlotGeneration { generation: _ } =>
          CasPreconditionFailed { expected: attempt.expected, observed: CasReadableAbsent }
      }
    ProbedHead { generation: h, value: v } =>
      match attempt.expected {
        ExpectSlotAbsent =>
          CasPreconditionFailed { expected: attempt.expected, observed: cas_head_as_readable(generation: h, value: v) }
        ExpectSlotGeneration { generation: g } =>
          if cas_generation_count(g: g) == cas_generation_count(g: h) {
            cas_commit_at(
              admitted: AdmittedCasPublication {
                root: root, publication: publication, attempt: attempt,
                target: cas_generation_next(g: h),
              }
            )
          } else {
            CasPreconditionFailed { expected: attempt.expected, observed: cas_head_as_readable(generation: h, value: v) }
          }
      }
  }
}

// ── Which slots exist ────────────────────────────────────────────────────────────────────────
// THE STORE OWNS BOTH DIRECTIONS OF ITS LAYOUT. cas_file_slot_path renders "<root>/<key>.<n>", so
// the inverse over a directory listing strips exactly one trailing ".<digits>" -- the generation
// is always the LAST dotted component and always numeric, so a key that itself contains "." reads
// back unchanged. This is the one place a name is parsed back into a key, beside the function
// that made the name; a consumer that split file names itself would be the second identity
// authority the head-probe note above refuses. The listing answers WHICH keys have a slot; each
// key's standing is still read through observe_cas_slot_state.
type CasSlotKeys
  = CasSlotKeysListed { keys: List<NonEmptyStr> }
  | CasSlotKeysListingRefused { root: NonEmptyStr, detail: String }

fn cas_digit_char(ch: String) -> Bool {
  ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9"
}

fn cas_digits_from(s: String, i: Int) -> Bool {
  if i >= string_length(s: s) { true } else { cas_digit_char(ch: char_at(s: s, pos: i)) && cas_digits_from(s: s, i: i + 1) }
}

fn cas_name_is_digits(s: String) -> Bool {
  s != "" && cas_digits_from(s: s, i: 0)
}

// "<key>.<n>" -> key, or none for a name that is not a slot file.
fn cas_key_of_slot_name(name: String) -> NonEmptyStr? {
  let parts = name.split(delimiter: ".")
  if count(parts) < 2 { none } else {
    let last = match parts |> get(count(parts) - 1) {
      null => ""
      p => p
    }
    if !cas_name_is_digits(s: last) { none } else {
      let key = join(parts |> take(count(parts) - 1), ".")
      if key == "" { none } else { Present { value: key as NonEmptyStr } }
    }
  }
}

fn cas_slot_keys(root: NonEmptyStr) -> CasSlotKeys {
  let listing = Filesystem.List(path: root as String)
  if !listing.success { CasSlotKeysListingRefused { root: root, detail: listing.error } } else {
    let names = filter(listing.entries.split(delimiter: "\n"), n => trim(s: n) != "")
    CasSlotKeysListed { keys: fold(names, init: [], f: (acc, n) => match cas_key_of_slot_name(name: trim(s: n)) {
      Absent => acc
      Present { value: k } => if any(acc, x => x == k) { acc } else { acc |> list_push(k) }
    }) }
  }
}
