module gunbc.actions_job_observation

import std.types { NonEmptyStr, String, Int, Bool, List }
import v2.std.algebra { fold_list, filter }
import gunbc.actions_runner_label { third_party_runner_machine_prefixes }

// WHAT A CI OBSERVATION ESTABLISHES, SEPARATED FROM WHAT IT LOOKS LIKE IT ESTABLISHES. Every type
// here exists because a plausible reading of run-level data was made and was wrong, and the
// distinction is carried in the types so the next reader cannot make it by accident.
//
// The two confusions, both measured on gunb-ai/gunbc probe runs 35169284367 and 35169573172:
//
//   1. A WORKFLOW RUN'S WALL-CLOCK IS NOT RUNNER OCCUPANCY. The probe ran 34 seconds of wall-clock
//      while its two jobs occupied 27 and 28 seconds -- 55 job-seconds. Wall-clock approximates the
//      critical path, so it UNDERCOUNTS parallel work; and a run gated on approval inflates
//      wall-clock while occupying no runner at all, so it also OVERCOUNTS waiting. The two errors
//      do not cancel and neither is bounded.
//
//   2. A RUN'S ADMISSION DELAY IS NOT A RUNNER QUEUE WAIT. The same probe reported run created and
//      run started in the same second -- zero -- while its jobs waited 4 and 5 seconds before a
//      runner picked them up. A zero at run level says nothing about whether jobs queued.
//
// Both were reported as findings before they were measured. The types below make the wrong reading
// unwritable rather than merely discouraged.

type JobConclusion
  = JobSucceeded
  | JobFailed
  | JobCancelled
  | JobSkipped
  | JobConclusionForeign { raw: String }

fn job_conclusion_from_wire(raw: String) -> JobConclusion {
  if raw == "success" {
    JobSucceeded
  } else {
    if raw == "failure" {
      JobFailed
    } else {
      if raw == "cancelled" {
        JobCancelled
      } else {
        if raw == "skipped" {
          JobSkipped
        } else {
          JobConclusionForeign { raw: raw }
        }
      }
    }
  }
}

// RUNNER PROVENANCE IS STRUCTURAL, NOT INFERRED FROM A LABEL. The jobs API reports runner_name, and
// a GitHub-hosted runner is named "GitHub Actions <n>" while a self-hosted one carries whatever its
// operator chose. That is the only externally readable fact that separates them -- a label cannot,
// because a self-hosted runner may be labelled to look exactly like a hosted larger runner.
// THREE ARMS, NOT TWO, and the third exists because of an example left in a deleted annotation:
// extdeps.github.workflow_runs recorded that a Depot job reports the runner name "depot-1mw2k81zm2".
// That is neither GitHub-hosted nor self-hosted -- it is a third party's fleet -- and folding it in
// with self-hosted would put a paying provider customer in the same arm as a team running its own
// hardware. For a prospect census those are opposite facts: one is a displacement target, the other
// is a different product entirely.
//
// The provider arm is recognised by the MACHINE-NAME roster in gunbc.actions_runner_label, which is
// a different roster from the label one and deliberately so: a workflow says "depot-ubuntu-24.04"
// while that vendor's machine says "depot-1mw2k81zm2", and matching the second against the first
// answers no for a machine that is plainly Depot's. A name matching nothing known is
// FleetRunnerObserved, which is the honest default: not-GitHub is established, and whose fleet it
// is, is not.
type RunnerProvenance
  = HostedRunnerObserved { runner_name: String }
  | ProviderRunnerObserved { runner_name: String, provider: NonEmptyStr }
  | FleetRunnerObserved { runner_name: String }
  | RunnerProvenanceUnread

data hosted_runner_name_prefix: String = "GitHub Actions"

fn runner_provenance(runner_name: String) -> RunnerProvenance {
  if runner_name == "" {
    RunnerProvenanceUnread
  } else {
    if starts_with(s: runner_name, prefix: hosted_runner_name_prefix) {
      HostedRunnerObserved { runner_name: runner_name }
    } else {
      provenance_from_provider_roster(runner_name: runner_name)
    }
  }
}

fn provenance_from_provider_roster(runner_name: String) -> RunnerProvenance {
  match filter(third_party_runner_machine_prefixes, p => starts_with(s: runner_name, prefix: p as String)) |> first {
    Present { value: p } => ProviderRunnerObserved { runner_name: runner_name, provider: p }
    Absent => FleetRunnerObserved { runner_name: runner_name }
  }
}

// A JOB THAT NEVER STARTED HAS NO OCCUPANCY AND NO DELAY, and that is a third state rather than a
// zero. A skipped job and a job that occupied a runner for zero measurable seconds are different
// facts, and summing them as zeroes loses the count of work that never ran.
type JobTiming
  = JobExecuted { prestart_seconds: Int, occupancy_seconds: Int }
  | JobNeverStarted
  | JobTimingUnread { reason: NonEmptyStr }

fn job_timing(created_epoch: Int, started_epoch: Int, completed_epoch: Int) -> JobTiming {
  if started_epoch <= 0 {
    JobNeverStarted
  } else {
    if completed_epoch < started_epoch {
      JobTimingUnread {
        reason: "completed precedes started; the pair cannot be read as an interval" as NonEmptyStr
      }
    } else {
      if created_epoch > started_epoch {
        JobTimingUnread {
          reason: "started precedes created; the pair cannot be read as a delay" as NonEmptyStr
        }
      } else {
        JobExecuted {
          prestart_seconds: started_epoch - created_epoch,
          occupancy_seconds: completed_epoch - started_epoch,
        }
      }
    }
  }
}

// THE PRE-START INTERVAL IS NOT A CAPACITY QUEUE, and the name says so. It composes waiting for an
// approval, a concurrency-group lock, a dependency, and a free runner, and nothing in the jobs
// response separates them. Naming it RunnerQueueDelay would assert a cause the observation cannot
// carry, which is the error that produced a confident zero from the wrong boundary.
type PrestartReading {
  seconds: Int
  composed_of_unseparated_causes: Bool
}

fn prestart_reading(t: JobTiming) -> PrestartReading? {
  match t {
    JobExecuted { prestart_seconds: p, occupancy_seconds: _ } =>
      Present { value: PrestartReading { seconds: p, composed_of_unseparated_causes: true } }
    JobNeverStarted => none
    JobTimingUnread { reason: _ } => none
  }
}

// OCCUPANCY IS A SUM OVER JOBS AND NEVER A RUN'S DURATION. This is the whole repair: a consumer
// wanting runner-minutes folds executed jobs, and a consumer holding only run records cannot
// answer at all rather than answering with wall-clock.
fn job_occupancy_seconds(t: JobTiming) -> Int {
  match t {
    JobExecuted { prestart_seconds: _, occupancy_seconds: o } => o
    JobNeverStarted => 0
    JobTimingUnread { reason: _ } => 0
  }
}

fn total_occupancy_seconds(timings: List<JobTiming>) -> Int {
  fold_list(timings, 0, (acc, t) => acc + job_occupancy_seconds(t: t))
}

// A run's wall-clock is deliberately NOT offered as an occupancy fold anywhere in this module. The
// closest thing is this refusal, which exists so a caller reaching for it finds a reason instead of
// a number.
type OccupancyFromRunWallClock
  = OccupancyNotDerivableFromRunDuration { reason: NonEmptyStr }

fn occupancy_from_run_wall_clock() -> OccupancyFromRunWallClock {
  OccupancyNotDerivableFromRunDuration {
    reason: "a run's wall-clock approximates its critical path: it undercounts parallel jobs and overcounts non-executing waits, and neither error is bounded. Fold job occupancy instead" as NonEmptyStr
  }
}

// CANCELLATION IS CHURN UNTIL ITS OCCUPANCY IS KNOWN. A run cancelled before any job started cost
// nothing and may mean the team has correct cancel-in-progress hygiene; one cancelled after jobs
// ran for minutes is consumed capacity. The rate alone cannot tell them apart, so the carrier holds
// both and a consumer asking about waste must read the seconds.
type CancellationReading {
  cancelled_jobs: Int
  cancelled_occupancy_seconds: Int
  jobs_total: Int
}

fn cancellation_is_waste_evidence(r: CancellationReading) -> Bool {
  r.cancelled_occupancy_seconds > 0
}
