import std.nat { Nat }
import std.algebra { trim }
import std.measure { TokenCount, ConcurrentRequestHundredths }
import product.placement_supply { HostIdentity }
import extdeps.exec.command { ArgvCommand, argv_words }
import extdeps.docker.cli {
  docker_container_inspect_command, docker_logs_command,
  docker_container_inspect_names_no_such_container,
  docker_exec_command, DockerEnvAssignment,
}
