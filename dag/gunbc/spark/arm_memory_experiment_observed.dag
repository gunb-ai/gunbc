// ── THE SUPPLY DEDUCTIONS, CARRIED FROM THE CARVE AND THE BOOT READINGS ──────────────────────────
//
// THE HOST/OS RESERVE BASIS is the 0.8567 envelope's host-reserve carve: the engine's decided
// envelope claims 8567 basis points of the pool, so the remaining 1433 basis points --
// everything outside the envelope -- is host/OS/control-plane/co-tenant territory the arm does
// not claim, and the deduction's upper endpoint is that carve at the pool span's HIGH reading.
// THE TWO DEDUCTIONS ARE DEVICE-COUPLED on the real devices: at every host the carve splits into
// the observed foreign occupancy plus a host residue, and the observed pairs (14.49/2.95,
// 13.17/4.27, 12.80/4.64, 10.58/6.57 GiB) all sum back under the host's carve. A SUBJECT-LEVEL
// SCALAR PAIR cannot express that per-device coupling, so the pair below carries foreign at its
// observed band high (sound at every device) and host at carve-high minus foreign-low (sound:
// every device's host residue is at most carve_high - that device's foreign, hence at most
// carve_high - foreign_low); the scalar pair's sum exceeding any single device's carve is the
// honest price of the coupling, and the launch wall's conservation obligation names it.

fn arm_experiment_kvplan_v2_2026_09_26_carve_high(pool_high: ByteSize) -> ByteSize {
  byte_size(count: byte_size_count(b: pool_high) * 1433 / 10000)
}

fn arm_experiment_kvplan_v2_2026_09_26_launch_wall_deductions(pool_high: ByteSize) -> ArmSupplyDeductions {
  let foreign_readings = map(arm_experiment_kvplan_v2_2026_09_26_boot_readings, r => arm_experiment_kvplan_v2_2026_09_26_foreign_hundredths(r))
  let foreign_high_hundredths = fold(foreign_readings, init: 0, f: (acc, h) => nat_max(acc, h))
  let foreign_low_hundredths = fold(foreign_readings, init: 12169, f: (acc, h) => nat_min(acc, h))
  let foreign_high = arm_experiment_gib_hundredths_upper(hundredths: foreign_high_hundredths)
  let foreign_low = arm_experiment_gib_hundredths_lower(hundredths: foreign_low_hundredths)
  ArmSupplyDeductions {
    host_os_control_reserve: arm_experiment_component_interval(
      lower: byte_size(count: 0),
      upper: byte_size(count: byte_size_count(b: arm_experiment_kvplan_v2_2026_09_26_carve_high(pool_high: pool_high)) - byte_size_count(b: foreign_low)),
      how: "the 0.8567 envelope's host-reserve carve: the engine claims 8567 basis points of the pool, so the remaining 1433 basis points are host/OS/control-plane/co-tenant territory the arm does not claim; the upper endpoint is the carve at the pool span's high reading minus the observed foreign floor -- every device's host residue (carve minus that device's foreign occupancy) is bounded above by carve_high - foreign_low, the observed per-device pairs summing back under each host's own carve. The scalar subject-level pair cannot express the per-device coupling; the launch wall's conservation obligation names the byte-exact pool producer as the resolver" as NonEmptyStr),
    foreign_residency: arm_experiment_component_interval(
      lower: byte_size(count: 0),
      upper: foreign_high,
      how: "observed foreign occupancy at this launch's own boot readings: device total minus free memory at the 'Free memory on device' profile lines (gpu_worker.py:867, 2026-09-26T05:42:33Z), 14.49 / 13.17 / 12.80 / 10.58 GiB across srv9/srv10/srv12/srv11; the upper endpoint is the observed band's high at the reporter's rounding unit, sound at every device the arm can land on" as NonEmptyStr),
  }
}


// ── THE CHECKPOINT INDEX CENSUS AND THE TP4 PLACEMENT RULES ──────────────────────────────────────
//
// THE PER-TENSOR READ OF THE CHECKPOINT'S OWN INDEX (model.safetensors.index.json at the pinned
// snapshot /home/briansrls/.cache/huggingface/hub/models--zai-org--GLM-5.3-Flash/snapshots/
// eb9eb208eb0d988989d07a6a12d0fdeb5f52574a/, fetched to srv2 2026-09-26): the weight map names
// every tensor's shard, and the metadata names the tensor-byte total -- the population census
// below is parsed from it, not transcribed from the architecture. THE INDEX DOES NOT CARRY
// SHAPES OR DTYPES (those live in each shard's safetensors header); the shard-header and
// config.json fetches have since COMPLETED, and the byte projection they enabled is landed in
// the section below -- everything the index itself vouches is landed here. THE TENSOR TOTAL IS
// THE AUTHORITY ROW: 328,326,771,576 bytes of tensor data, against
// the manifest module's 328,337,455,672 file bytes (glm_5_3_flash_native_manifest.safetensors_bytes)
// -- the 10,684,096-byte difference is the 62 shards' own headers, named so no reader prices it
// as weights.

data glm_checkpoint_index_revision: NonEmptyStr = "eb9eb208eb0d988989d07a6a12d0fdeb5f52574a" as NonEmptyStr

data glm_checkpoint_index_file: NonEmptyStr = "model.safetensors.index.json" as NonEmptyStr

data glm_checkpoint_index_tensor_count: Nat = 76108

data glm_checkpoint_index_shard_count: Nat = 62

data glm_checkpoint_index_tensor_bytes: ByteSize = byte_size(count: 328326771576)

data glm_checkpoint_index_file_bytes: ByteSize = byte_size(count: 328337455672)

// THE SHARD-HEADER OVERHEAD, derived not transcribed: file bytes minus tensor bytes.
fn glm_checkpoint_index_header_overhead_bytes() -> ByteSize {
  byte_size(count: byte_size_count(b: glm_checkpoint_index_file_bytes) - byte_size_count(b: glm_checkpoint_index_tensor_bytes))
}

// THE LAYER CENSUS, by attention mechanism (classified from the self_attn tensor names in the
// weight map: kv_b_proj/indexer names mark MLA, A_log/conv1d names mark KDA). THE CHECKPOINT
// CONFIRMS THE CORPUS SHAPE: 34 KDA + 11 sparse-MLA over the 45 base layers, and names the MTP
// layer (index 45, MLA attention) the shape row does not carry. THE MLP AXIS IS SEPARATE FROM
// THE ATTENTION AXIS: layers 0-2 carry a dense MLP (no experts); every layer from 3 through the
// MTP carries MoE (288 routed experts + shared experts).
data glm_checkpoint_index_sparse_base_layer_indices: List<Nat> = [3, 7, 11, 15, 19, 23, 27, 31, 35, 39, 43]

data glm_checkpoint_index_mtp_layer_indices: List<Nat> = [45]

data glm_checkpoint_index_kda_layer_indices: List<Nat> = [
  0, 1, 2, 4, 5, 6, 8, 9, 10, 12, 13, 14, 16, 17, 18, 20, 21, 22,
  24, 25, 26, 28, 29, 30, 32, 33, 34, 36, 37, 38, 40, 41, 42, 44,
]

data glm_checkpoint_index_dense_mlp_layer_indices: List<Nat> = [0, 1, 2]

data glm_checkpoint_index_routed_experts_per_layer: Nat = 288

data glm_checkpoint_index_scale_tensor_count: Nat = 37338

// THE VISION TOWER IS IN THE CHECKPOINT (24 blocks + patch embed + merger + downsample + post
// norm): whether THIS LAUNCH loads it is a config.json architectures fact (Glm5NextForCausalLM
// builds the text model; Glm5NextForConditionalGeneration, the GLM4V-pattern multimodal wrapper
// at glm5next/nvidia/model.py:963, builds the visual tower too) -- config.json rides the same
// fetch as the shard headers, and the projection plus the loaded-weight comparison settles it.
data glm_checkpoint_index_visual_block_count: Nat = 24

// THE CENSUS CONSISTENCY LAW, checked not trusted: the classification partitions the 45 base
// layers, the MTP list is the 46th layer, the dense-MLP list is the first three KDA layers.
fn glm_checkpoint_index_census_holds() -> Bool {
  length(glm_checkpoint_index_sparse_base_layer_indices) == 11
    && length(glm_checkpoint_index_kda_layer_indices) == 34
    && length(glm_checkpoint_index_sparse_base_layer_indices) + length(glm_checkpoint_index_kda_layer_indices) == 45
    && length(glm_checkpoint_index_mtp_layer_indices) == 1
    && length(glm_checkpoint_index_dense_mlp_layer_indices) == 3
    && glm_checkpoint_index_tensor_count > 0
    && glm_checkpoint_index_scale_tensor_count > 0
    && byte_size_count(b: glm_checkpoint_index_header_overhead_bytes()) == 10684096
    && byte_size_count(b: glm_checkpoint_index_tensor_bytes) + byte_size_count(b: glm_checkpoint_index_header_overhead_bytes()) == byte_size_count(b: glm_checkpoint_index_file_bytes)
}

// ── THE TP4 PLACEMENT RULES, FROM THE PINNED SOURCE ──────────────────────────────────────────────
//
// THE AUTHORITY IS vllm@8d09804c8's OWN MODULE CONSTRUCTION (docs/plans/moa-memory-modeling.md:
// placement derives from the checkpoint manifest x the loader's placement rules -- the rules are
// the engine's, cited symbol-first below). AT THIS LAUNCH tensor parallelism is 4, expert
// parallelism is unset, and the EP group IS the TP group for MoE models (distributed/
// parallel_state.py:2085-2119 builds the ep group from the TP ranks when DP and PCP are 1), so
// the expert population splits across the same four ranks. SEQUENCE PARALLELISM IS OFF (the
// launch carries no such flag), so the Column/Row sharding below is the standard TP split, not
// the sequence-parallel replication (Glm5NextMLP's disable_tp branch is not taken).
//
// EMBED_TOKENS IS VOCAB-SHARDED (VocabParallelEmbedding, model.py:603); LM_HEAD IS VOCAB-SHARDED
// (ParallelLMHead, model.py:881). DENSE MLP: gate/up MERGED-COLUMN-SHARDED, down ROW-SHARDED
// (Glm5NextMLP, model.py:116-128). MOE: THE ROUTER IS REPLICATED (GateLinear IS-A ReplicatedLinear,
// model_executor/layers/fused_moe/router/gate_linear.py:18, with e_score_correction_bias a plain
// parameter); THE EXPERT BODIES SPLIT OVER THE EP GROUP (FusedMoEFactory, model.py:226-246);
// SHARED EXPERTS ARE THE DENSE-MLP SHARDING (model.py:196-208). MLA: q_a REPLICATED AND kv_a
// COLUMN-SHARDED INSIDE THE FUSED QKV-A PROJ (DeepSeekV2FusedQkvAProjLinear, the fused branch this
// checkpoint's q_a_proj + kv_a_proj_with_mqa names select), q_b/kv_b COLUMN-SHARDED, o_proj
// ROW-SHARDED (attention.py:447-484). KDA: in_proj_qkvbfg_a MERGED-COLUMN (with the class's
// replicated-shard exceptions), f_b/g_b/q/k/v COLUMN-SHARDED, o_proj ROW-SHARDED, A_log/dt_bias/
// o_norm PARAMETERS REPLICATED (kda.py:181-256). INDEXER: wk COLUMN-SHARDED (MergedColumnParallel),
// wq_b REPLICATED (attention.py:250-255,253). NORMS/LAYERNORMS/HC_* PARAMETERS REPLICATED.
// VISION TOWER: THE GLM4V-PATTERN VISUAL ENCODER IS BUILT FROM PLAIN MODULES, NOT TP-WRAPPED --
// REPLICATED WHEREVER IT LOADS (model.py:963 class note; settled by the loaded-weight comparison).

type ArmCheckpointPlacementKind
  = ArmPlacementVocabSharded
  | ArmPlacementColumnSharded
  | ArmPlacementRowSharded
  | ArmPlacementExpertSplit
  | ArmPlacementReplicated

fn arm_checkpoint_placement_kind_wire(k: ArmCheckpointPlacementKind) -> String {
  match k {
    ArmPlacementVocabSharded => "vocab-sharded"
    ArmPlacementColumnSharded => "column-sharded"
    ArmPlacementRowSharded => "row-sharded"
    ArmPlacementExpertSplit => "expert-split"
    ArmPlacementReplicated => "replicated"
  }
}

// ONE PROJECTED TENSOR ROW: the tensor's checkpoint name, its placement kind, and its byte size.
// `bytes` is OPTIONAL because the index does not carry shapes or dtypes: Absent names the
// shard-header fetch as the completing read, and the folds below refuse to price an Absent row
// rather than read it as a zero.
type ArmCheckpointTensorRow {
  name: NonEmptyStr
  kind: ArmCheckpointPlacementKind
  bytes: ByteSize?
}

// THE PER-RANK SHARE OF ONE ROW: sharded and expert-split kinds contribute bytes/rank_count to
// every rank (modulo shard padding, priced when the shapes land); replicated contributes the
// whole tensor to every rank. PADDING IS NAMED, NOT MODELED: vocab and dim sizes divide by 4 up
// to a sub-block remainder, and the conservation law below absorbs it as a named deviation.
fn arm_checkpoint_row_per_rank_bytes(row: ArmCheckpointTensorRow, rank_count: Nat) -> ByteSize? {
  match row.bytes {
    Absent => none
    Present { value: b } =>
      match row.kind {
        ArmPlacementReplicated => Present { value: b }
        _ => Present { value: byte_size(count: byte_size_count(b: b) / rank_count) }
      }
  }
}

// THE PER-RANK PLACEMENT FIGURES: one sum per rank over the row population. A row whose bytes
// are Absent makes EVERY rank's figure Absent -- the projection has no spelling for an unpriced
// tensor.
fn arm_checkpoint_placement_rank_figures(rows: List<ArmCheckpointTensorRow>, rank_count: Nat) -> List<ByteSize?> {
  map(nat_range_inclusive(lo: 1, hi: rank_count), rank =>
    fold(rows, init: Present { value: byte_size(count: 0) }, f: (acc, row) =>
      match acc {
        Absent => none
        Present { value: n } =>
          match arm_checkpoint_row_per_rank_bytes(row: row, rank_count: rank_count) {
            Absent => none
            Present { value: share } => Present { value: byte_size(count: byte_size_count(b: n) + byte_size_count(b: share)) }
          }
      }))
}

// THE PLACEMENT CONSERVATION LAW: the per-rank figures sum back to the sharded and expert bytes
// once plus the replicated bytes rank_count times -- the exactness wall the real projection must
// pass. THE REAL PROJECTION'S INSTANCE: the sum must equal the index tensor bytes
// 328,326,771,576 plus 3 x the replicated population minus the shard-padding remainder -- every
// deviation named, none silent. A TENSOR MOVED TO A DIFFERENT SHARD CHANGES A RANK FIGURE by
// kind-delta x bytes x (rank_count - 1)/rank_count, and this law is what makes that change
// decidable instead of anecdotal.
fn arm_checkpoint_placement_conserved(rows: List<ArmCheckpointTensorRow>, rank_count: Nat) -> Bool {
  let sharded_and_expert = fold(rows, init: byte_size(count: 0), f: (acc, row) =>
    match row.bytes {
      Absent => acc
      Present { value: b } =>
        match row.kind {
          ArmPlacementReplicated => acc
          _ => byte_size(count: byte_size_count(b: acc) + byte_size_count(b: b))
        }
    })
  let replicated = fold(rows, init: byte_size(count: 0), f: (acc, row) =>
    match row.bytes {
      Absent => acc
      Present { value: b } =>
        match row.kind {
          ArmPlacementReplicated => byte_size(count: byte_size_count(b: acc) + byte_size_count(b: b))
          _ => acc
        }
    })
  let figures = arm_checkpoint_placement_rank_figures(rows: rows, rank_count: rank_count)
  let figure_sum = fold(figures, init: Present { value: byte_size(count: 0) }, f: (acc, f2) =>
    match acc {
      Absent => none
      Present { value: n } =>
        match f2 {
          Absent => none
          Present { value: v } => Present { value: byte_size(count: byte_size_count(b: n) + byte_size_count(b: v)) }
        }
    })
  match figure_sum {
    Absent => false
    Present { value: sum } =>
      byte_size_count(b: sum) == byte_size_count(b: sharded_and_expert) + rank_count * byte_size_count(b: replicated)
  }
}

// THE CATEGORY CLASSIFIER over the checkpoint's tensor-name shapes, in match order (the first
// matching rule wins, so the population's exceptions precede its generalities): the language
// model's projections by module class as cited above, the expert bodies by population, the
// router/norms/parameters replicated, and the vision prefix replicated wherever it loads. A
// name matching nothing explicit lands REPLICATED -- the conservative reading for the small
// residual classes -- and the projection's conservation check against the composite readings is
// the wall that exposes any misclassification.
fn arm_checkpoint_classify(name: String) -> ArmCheckpointPlacementKind {
  if string_contains(s: name, pattern: "model.visual.") {
    ArmPlacementReplicated
  } else if string_contains(s: name, pattern: "embed_tokens") {
    ArmPlacementVocabSharded
  } else if string_contains(s: name, pattern: "lm_head") {
    ArmPlacementVocabSharded
  } else if string_contains(s: name, pattern: "mlp.experts.") {
    ArmPlacementExpertSplit
  } else if string_contains(s: name, pattern: "mlp.gate.") {
    ArmPlacementReplicated
  } else if string_contains(s: name, pattern: "wq_b") {
    ArmPlacementReplicated
  } else if string_contains(s: name, pattern: "q_a_proj") {
    ArmPlacementReplicated
  } else if string_contains(s: name, pattern: "A_log") || string_contains(s: name, pattern: "dt_bias") || string_contains(s: name, pattern: "hc_") || string_contains(s: name, pattern: "e_score_correction_bias") || string_contains(s: name, pattern: "index_kpool_compress") {
    ArmPlacementReplicated
  } else if string_contains(s: name, pattern: "down_proj") {
    ArmPlacementRowSharded
  } else if string_contains(s: name, pattern: "o_proj") {
    ArmPlacementRowSharded
  } else if string_contains(s: name, pattern: "conv1d") {
    ArmPlacementColumnSharded
  } else if string_contains(s: name, pattern: "gate_proj") || string_contains(s: name, pattern: "up_proj") {
    ArmPlacementColumnSharded
  } else if string_contains(s: name, pattern: "kv_a_proj_with_mqa") || string_contains(s: name, pattern: "weights_proj") || string_contains(s: name, pattern: "q_b_proj") || string_contains(s: name, pattern: "kv_b_proj") || string_contains(s: name, pattern: "wk.weight") || string_contains(s: name, pattern: "q_proj") || string_contains(s: name, pattern: "k_proj") || string_contains(s: name, pattern: "v_proj") || string_contains(s: name, pattern: "b_proj") || string_contains(s: name, pattern: "f_a_proj") || string_contains(s: name, pattern: "f_b_proj") || string_contains(s: name, pattern: "g_a_proj") || string_contains(s: name, pattern: "g_b_proj") || string_contains(s: name, pattern: "eh_proj") {
    ArmPlacementColumnSharded
  } else {
    ArmPlacementReplicated
  }
}

// THE FETCHES, RECORDED AS COMPLETED: the 62 shards' safetensors headers (bounded 262,144-byte
// windows at the pinned snapshot, every header complete, no shortfall) delivered every tensor's
// shape and dtype, and config.json's architectures field
// (["Glm5NextForConditionalGeneration"]) settled the vision tower: it LOADS. What remains open
// at the launch wall after the projection are the two phase obligations the minted experiment
// plans name -- the loader transient and the fragmentation churn -- each with its runbook row
// below; the projection itself is landed (the byte census section above) and its Absent-row
// fail-closed behavior stays as the machinery's exactness property.
fn glm_checkpoint_projection_pending_obligation() -> NonEmptyStr {
  "the shard headers and config.json fetches are COMPLETE: the byte census is landed (the projection section above reconstructs the index tensor total with slack zero) and config.json's architectures field settles the vision tower as loading; the launch wall's remaining completing acts are the two minted experiment plans -- the loader transient and the fragmentation churn, each with its runbook row below -- and the Absent-bytes fold behavior remains as the machinery's fail-closed exactness property, not a pending read" as NonEmptyStr
}


// ── THE BYTE CENSUS FROM THE SHARD HEADERS, AND THE EXACT PER-RANK PROJECTION ────────────────────
//
// THE 62 SHARD HEADERS (fetched 2026-09-26, 262,144 bytes per shard's opening, every header
// complete -- no window shortfall) carry every tensor's shape and dtype; byte-sized and
// classified, they reconstruct the index tensor total EXACTLY (328,326,771,576, slack zero) --
// the exactness wall the aggregate carry could never pass. DTYPE POPULATION, named: 37,338
// F8_E4M3 weight bodies beside 37,338 F32 weight_scale_inv block scales (128-block fp8), 1,141
// BF16 unquantized projections (the MLA projections are BF16 in checkpoint per
// glm5next/nvidia/attention.py:425), and the F32 parameter/residual population.

data glm_checkpoint_projection_vocab_bytes: ByteSize = byte_size(count: 2537553920)

data glm_checkpoint_projection_column_bytes: ByteSize = byte_size(count: 8919910400)

data glm_checkpoint_projection_row_bytes: ByteSize = byte_size(count: 3599034368)

data glm_checkpoint_projection_expert_bytes: ByteSize = byte_size(count: 311729651712)

data glm_checkpoint_projection_replicated_bytes: ByteSize = byte_size(count: 1540621176)

// THE VISUAL TOWER'S BYTES (1,127,254,016 across 347 tensors), a named subset of the replicated
// population: config.json's architectures field reads ["Glm5NextForConditionalGeneration"], the
// GLM4V-pattern multimodal wrapper (glm5next/nvidia/model.py:963) -- THE ENGINE BUILDS THE
// VISUAL TOWER, so the tower LOADS at this launch, replicated on every rank. tie_word_embeddings
// is false, so lm_head loads beside embed_tokens, consistent with the vocab-sharded class.
data glm_checkpoint_projection_visual_bytes: ByteSize = byte_size(count: 1127254016)

data glm_checkpoint_config_architectures: NonEmptyStr = "Glm5NextForConditionalGeneration" as NonEmptyStr

// THE PROJECTION CENSUS, checked not trusted: the five kind sums reconstruct the index tensor
// total exactly, and the conservation law holds with slack zero -- four times the per-rank
// figure equals the sharded-plus-expert bytes once plus the replicated bytes four times.
fn glm_checkpoint_projection_census_holds() -> Bool {
  byte_size_count(b: glm_checkpoint_projection_vocab_bytes)
    + byte_size_count(b: glm_checkpoint_projection_column_bytes)
    + byte_size_count(b: glm_checkpoint_projection_row_bytes)
    + byte_size_count(b: glm_checkpoint_projection_expert_bytes)
    + byte_size_count(b: glm_checkpoint_projection_replicated_bytes)
    == byte_size_count(b: glm_checkpoint_index_tensor_bytes)
    && 4 * byte_size_count(b: glm_checkpoint_projection_per_rank_bytes())
    == byte_size_count(b: glm_checkpoint_projection_vocab_bytes)
      + byte_size_count(b: glm_checkpoint_projection_column_bytes)
      + byte_size_count(b: glm_checkpoint_projection_row_bytes)
      + byte_size_count(b: glm_checkpoint_projection_expert_bytes)
      + 4 * byte_size_count(b: glm_checkpoint_projection_replicated_bytes)
}

// THE EXACT PER-RANK PLACEMENT FIGURE: the sharded and expert classes over four ranks plus the
// replicated population -- identical on every rank by construction, which is the projection's
// structural finding: the checkpoint places EVENLY, and the composite readings' rank spread
// (83.34 / 86.51 / 87.65 / 88.50 GiB floors) lives in the non-checkpoint residue.
fn glm_checkpoint_projection_per_rank_bytes() -> ByteSize {
  let sharded = byte_size_count(b: glm_checkpoint_projection_vocab_bytes)
    + byte_size_count(b: glm_checkpoint_projection_column_bytes)
    + byte_size_count(b: glm_checkpoint_projection_row_bytes)
    + byte_size_count(b: glm_checkpoint_projection_expert_bytes)
  byte_size(count: sharded / 4 + byte_size_count(b: glm_checkpoint_projection_replicated_bytes))
}

// THE NON-CHECKPOINT RESIDUE per rank: the composite observation's floor minus the exact
// placement -- what runtime-fixed, collective, and any other non-checkpoint allocation share on
// that rank. THE RESIDUE TABLE, pinned: 106,681,602 / 3,274,219,983 / 4,412,386,317 /
// 5,260,642,358 bytes across TP0-TP3 -- the rank-varying shape collective workspace wears.
fn arm_experiment_kvplan_v2_2026_09_26_residue(r: ArmExperimentEnvelopeDerivedArenaReading) -> ByteSize {
  byte_size(count: byte_size_count(b: arm_experiment_gib_hundredths_floor(hundredths: r.weights_nontorch_hundredths_gib)) - byte_size_count(b: glm_checkpoint_projection_per_rank_bytes()))
}

// ── THE TWO COMPLETING WET ACTS, IN EXECUTABLE FORM ──────────────────────────────────────────────
//
// THE BRACKET'S EXPERIMENT PLANS, minted through the same wall the launch gate uses
// (gunbc.spark.arm_memory_fit arm_memory_fit_experiment_plan): the subject tuple is the launch
// wall's own, the envelope is the normal-serving decision (8567 basis points -- conservative
// means no larger), each plan targets ONE open obligation, names the receipt kind the run must
// mint, and carries the stop/cleanup contract and route-enrollment prohibition. THE RUNBOOK ROWS
// beside each plan pin the anchor strings, the poll cadence, and the pass/fail bounds the
// bracket executes against.

fn arm_experiment_kvplan_v2_2026_09_26_workload() -> ServingCapacityIntent {
  match uniform_cold_seats(each: token_count(count: 262144), seats: 6, max_batched_tokens: token_count(count: 2048)) {
    ServingCapacityIntentAdmitted { intent: i } => i
    ServingCapacityIntentRefused { cause: _ } => ServingCapacityIntent { cold_sequence_budgets: [], max_batched_tokens: token_count(count: 1) }
  }
}

fn arm_experiment_kvplan_v2_2026_09_26_policy_profile() -> ServingLaunchProfile {
  profile_for_intent(
    intent: arm_experiment_kvplan_v2_2026_09_26_workload(),
    decided_gpu_memory_basis_points: basis_point(count: 8567),
    kv_cache_dtype_wire: "fp8" as NonEmptyStr,
    serve_port: 30000,
    served_alias: "glm-5.3-flash" as NonEmptyStr,
    prefix_caching: PrefixCachingExplicit { enabled: true })
}

// THE LOADER-TRANSIENT PLAN: one bounded launch, the load phase bracketed per rank, the peak
// over repeated loads the bound. Targets the loader-transform obligation; the receipt kind the
// run must mint is CheckpointRankResidencyBound.
fn arm_experiment_kvplan_v2_2026_09_26_loader_transient_plan() -> ArmMemoryExperimentAdmission {
  arm_memory_fit_experiment_plan(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    workload: arm_experiment_kvplan_v2_2026_09_26_workload(),
    policy_profile: arm_experiment_kvplan_v2_2026_09_26_policy_profile(),
    targets: [ArmLoaderTransform])
}

type ArmExperimentRunbookRow {
  plan: NonEmptyStr
  anchor_start: NonEmptyStr
  anchor_end: NonEmptyStr
  poll_seconds: Nat
  runs: Nat
  pass_bound: NonEmptyStr
  fail_bound: NonEmptyStr
  receipt_kind: NonEmptyStr
}

data arm_experiment_kvplan_v2_2026_09_26_loader_runbook: ArmExperimentRunbookRow = ArmExperimentRunbookRow {
  plan: "loader-transient" as NonEmptyStr,
  anchor_start: "engine container start on the rank (the load transient begins with the first checkpoint byte read)" as NonEmptyStr,
  anchor_end: "the rank's gpu_worker.py:867 'Free memory on device' profile line (load, profile and capture all inside the bracket)" as NonEmptyStr,
  poll_seconds: 2,
  runs: 3,
  pass_bound: "the peak-over-loads ceiling per rank, minted as a CheckpointRankResidencyBound receipt, closes the loader-transform obligation at all four ranks when priced into the launch wall" as NonEmptyStr,
  fail_bound: "a rank's load-phase peak above its envelope floor (102.54-104.25 GiB at this launch) falsifies the model: the engine's own accounting would refuse the load" as NonEmptyStr,
  receipt_kind: "CheckpointRankResidencyBound" as NonEmptyStr,
}

// THE FRAGMENTATION-CHURN PLAN: the warm engine driven through six cold full-window prefills
// and a bounded mixed-length churn window, the allocator's unreclaimable gap the bound. Targets
// the fragmentation-allowance obligation; the receipt kind is AllocatorFragmentationBound.
fn arm_experiment_kvplan_v2_2026_09_26_fragmentation_churn_plan() -> ArmMemoryExperimentAdmission {
  arm_memory_fit_experiment_plan(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    workload: arm_experiment_kvplan_v2_2026_09_26_workload(),
    policy_profile: arm_experiment_kvplan_v2_2026_09_26_policy_profile(),
    targets: [ArmFragmentationAllowance])
}

data arm_experiment_kvplan_v2_2026_09_26_fragmentation_runbook: ArmExperimentRunbookRow = ArmExperimentRunbookRow {
  plan: "fragmentation-churn" as NonEmptyStr,
  anchor_start: "the rank's gpu_worker.py:867 profile line (engine warm, pool constructed, serving state)" as NonEmptyStr,
  anchor_end: "churn window expiry, then the bracket's stop contract: engine stopped on every rank and the container removed before the observer preserves receipts" as NonEmptyStr,
  poll_seconds: 5,
  runs: 1,
  pass_bound: "the window's peak unreclaimable allocator gap (allocated minus reserved headroom beyond the engine's block accounting), minted as an AllocatorFragmentationBound receipt, keeps the peak-serving mandatory demand within supply at all four ranks when priced into the launch wall" as NonEmptyStr,
  fail_bound: "a peak unreclaimable gap that pushes the peak-serving demand lower past a rank's conservative supply refuses the six-seat point: the service intent must re-price at 262144 before normal serving" as NonEmptyStr,
  receipt_kind: "AllocatorFragmentationBound" as NonEmptyStr,
}


// ── THE LOADER-TRANSIENT RECEIPTS, MINTED FROM THE EXECUTED BRACKET ──────────────────────────────
//
// THE RUN EXECUTED (parent, 2026-09-26): three consecutive bounded experiment launches at this
// subject (image derived-kvplan-v2-20260926, the per-rank readback bracket), ALL converged,
// zero failed legs -- the falsification pass/fail (any rank OOM / the launch failing its own
// accounting) recorded NONE. Per-rank host-pool traces (MemAvailable kB at 2-second cadence,
// whole load-to-ready window) stand in /tmp/loader-transient-run{1,2,3}.jsonl; the minima below
// are read from them at the reporter's precision.
//
// THE INTERPRETATION LAW, stated once and binding on every receipt minted from these traces:
// MemAvailable is the HOST view of the GB10's unified pool -- it counts RECLAIMABLE page-cache
// pressure from reading the 305.8 GiB checkpoint alongside engine-pinned demand, so a receipt
// minted from it is an OUTER bound on load-phase host pressure (page cache counted as consumed),
// NEVER engine-pinned device demand alone. The page-cache component is named as the mechanism
// to refine later IF the bound is ever the pinch -- and at the conservative supply spelling it
// is (see below), so the refinement (the engine's own byte-exact load accounting, or a
// drop-caches rerun) is carried as the completing act, named.
data arm_loader_trace_runs: Nat = 3

data arm_loader_trace_cadence_seconds: Nat = 2

data arm_loader_trace_converged: Nat = 3

data arm_loader_trace_failed_legs: Nat = 0

// THE MINIMA, per host, at the hundredths floor of the raw kB readings (peak-over-loads takes
// the worst run per host): srv9 7.70 / srv10 8.14 / srv11 7.86 / srv12 8.19 GiB. Host-to-rank
// mapping is the bundle's (TP0 srv9, TP1 srv10, TP2 srv12, TP3 srv11).
data arm_loader_trace_min_hundredths_gib: List<Nat> = [770, 814, 819, 786]

// THE BOUND per rank: the host's pool reading (hundredths, from the boot rows) minus the worst
// observed MemAvailable floor -- the load-phase peak pressure of the unified pool, page cache
// included, at the conservative floor spelling.
fn arm_loader_trace_pool_hundredths(rank: Nat) -> Nat {
  match rank {
    3 => 11969
    _ => 12169
  }
}

fn arm_loader_trace_host_floor_hundredths(rank: Nat) -> Nat {
  match rank {
    0 => 770
    1 => 814
    2 => 819
    _ => 786
  }
}

fn arm_loader_trace_bound(rank: Nat) -> ByteSize {
  arm_experiment_gib_hundredths_floor(hundredths: arm_loader_trace_pool_hundredths(rank: rank) - arm_loader_trace_host_floor_hundredths(rank: rank))
}

// THE ADMISSION GATE, typed: a trace reading enters the model ONLY as the named outer bound --
// the receipt text must name the page-cache mechanism, the conservative direction, the
// peak-over-loads protocol, and this subject's identity, or the gate is false and the term
// stays open. A trace reading claimed as ENGINE-PINNED DEVICE DEMAND is refused here, which is
// the RED the doctrine's weaker-evidence rule requires: an observation whose soft component is
// not named cannot bound a harder quantity.
fn arm_loader_trace_receipt_admitted(bytes: ByteSize, receipt: NonEmptyStr) -> Bool {
  byte_size_count(b: bytes) > 0
    && string_contains(s: receipt as String, pattern: "page cache")
    && string_contains(s: receipt as String, pattern: "OUTER bound")
    && string_contains(s: receipt as String, pattern: "peak over ")
    && string_contains(s: receipt as String, pattern: serving_checkpoint_wire(c: Glm53NativeFp8) as String)
    && string_contains(s: receipt as String, pattern: serving_topology_wire(t: FourSparkTp4) as String)
}

fn arm_loader_trace_receipt(rank: Nat, host: NonEmptyStr) -> NonEmptyStr {
  join([
    "loader-transient host-pool trace, 2026-09-26 bracket: three consecutive bounded experiment launches at this subject (image derived-kvplan-v2-20260926, per-rank readback bracket), all converged, zero failed legs; MemAvailable kB at ", to_string(arm_loader_trace_cadence_seconds),
    "-second cadence across the load-to-ready window, peak over ", to_string(arm_loader_trace_runs), " runs on ", host as String,
    ": worst MemAvailable floor ", to_string(arm_loader_trace_host_floor_hundredths(rank: rank)), " hundredths GiB against the host pool ", to_string(arm_loader_trace_pool_hundredths(rank: rank)), " hundredths. INTERPRETATION LAW: the trace is the HOST view of the unified pool and INCLUDES reclaimable page-cache pressure from reading the 305.8 GiB checkpoint -- this receipt is an OUTER bound on load-phase host pressure (page cache counted as consumed), NOT engine-pinned device demand; the page-cache component is the named mechanism to refine (engine byte-exact load accounting or a drop-caches rerun) if this bound is ever the pinch. Subject: ",
    arm_experiment_kvplan_v2_2026_09_26_carry_identity() as String,
  ], "") as NonEmptyStr
}

// THE MINT: the loader-transform term carries the gated ceiling -- the gate passes (the receipt
// names the mechanism), so the four open loader obligations CLOSE and the term bounds the
// load-phase pressure whole, checkpoint double-count NAMED as the conservative direction: the
// ceiling bounds the phase total including the resident checkpoint, and the phase fold also
// charges checkpoint residency -- the over-count is the price of an unsplittable trace, stated
// here rather than silently absorbed.
fn arm_experiment_kvplan_v2_2026_09_26_loader_carry(rank: Nat, host: NonEmptyStr) -> ArmComponentBound {
  let receipt = arm_loader_trace_receipt(rank: rank, host: host)
  let bytes = arm_loader_trace_bound(rank: rank)
  if arm_loader_trace_receipt_admitted(bytes: bytes, receipt: receipt) {
    ComponentBoundCeiling { bytes: bytes, receipt: receipt }
  } else {
    ComponentBoundOpen { obligation: "the loader-transient trace reading was not admitted: a host-pool trace enters the model only as the named outer bound (page-cache mechanism, conservative direction, peak-over-loads protocol, subject identity) -- an unnamed reading cannot bound the loader term, and the term stays open until a receipt passes the gate" as NonEmptyStr }
  }
}
