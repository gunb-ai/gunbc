]

data arm_experiment_2026_09_26_limiting_rank: Nat = 3

data arm_experiment_2026_09_26_generation: NonEmptyStr = "group-b/bounded-experiment-2026-09-26" as NonEmptyStr

// ── THE SUBJECT ──────────────────────────────────────────────────────────────────────────────────
//
// THE COMPLETING RUN'S OWN SUBJECT, minted from the workload the experiment RAN -- six cold seats
// at 262144 tokens, a 2048 batch ceiling -- which at this launch IS the declared group B
// restoration workload (the bounded experiment launches the group B restoration executable). The
// launch policy beside the workload is the arm's standing policy, spelled here exactly as the
// 2026-09-25 bundle spells it (this module mints its subjects from its own runs, and the two
// bundles agree on the policy values by quoting them, not by sharing an import the observation
// layer has no business in). Absent means the workload refused to derive -- a state the bindings
// below cannot be claimed in.
fn arm_experiment_2026_09_26_subject_mint() -> MemoryProofSubjectMint {
  match uniform_cold_seats(each: token_count(count: 262144), seats: 6, max_batched_tokens: token_count(count: 2048)) {
    ServingCapacityIntentRefused { cause: _ } =>
      MemoryProofSubjectRefused { cause: "the completing run's own workload (six 262144-token seats at a 2048 batch ceiling) refused to derive, so the subject these readings bind to has no spelling" as NonEmptyStr }
    ServingCapacityIntentAdmitted { intent: experiment_intent } =>
      memory_proof_subject_for_launch(
        checkpoint: Glm53NativeFp8,
        runtime: GunbcGlm53NopeDerivedGb10,
        topology: FourSparkTp4,
        profile: profile_for_intent(
          intent: experiment_intent,
          decided_gpu_memory_basis_points: basis_point(count: 8567),
          kv_cache_dtype_wire: "fp8" as NonEmptyStr,
          serve_port: 30000,
          served_alias: "glm-5.3-flash" as NonEmptyStr,
          prefix_caching: PrefixCachingExplicit { enabled: true }),
        launch_generation: arm_experiment_2026_09_26_generation,
      )
  }
}

fn arm_experiment_2026_09_26_subject() -> MemoryProofSubject? {
  match arm_experiment_2026_09_26_subject_mint() {
    MemoryProofSubjectReady { subject: s } => Present { value: s }
    MemoryProofSubjectRefused { cause: _ } => none
  }
}

// ── THE ARENA BINDINGS: THE FOUR READINGS BESIDE THEIR DOCTRINE STANDING ─────────────────────────
//
// FOUR BINDINGS, one per rank: the KV arena against the ArmKvCache term, admitted as an OBSERVED
// INTERVAL at the reporter's rounding unit -- the 64K bundle's standing unchanged. The term BOUND
// stays open in every binding: a wet observation is not a bound, and the standing carries what
// the reading establishes until a bounding protocol or a derivation discharges the obligation.
fn arm_experiment_2026_09_26_provenance(host: NonEmptyStr) -> NonEmptyStr {
  join([
    "2026-09-26 completing bounded experiment (6x262144, 2048 batched, fp8 KV, 8567 basis points, engine ",
    arm_experiment_2026_09_26_engine_self_report as String, ") on ", host as String,
    ", per-rank memory-profile line at gpu_worker.py:867 captured by the experiment's per-rank readback bracket (receipt target/spark-native-experiment-apply-receipt.txt)",
  ], "") as NonEmptyStr
}

fn arm_experiment_2026_09_26_open_bound(obligation: NonEmptyStr) -> ArmComponentBound {
  ComponentBoundOpen { obligation: obligation }
}

fn arm_experiment_2026_09_26_arena_binding(reading: ArmExperimentArenaReading, measured_on: MemoryProofSubject) -> ArmWetReceiptBinding {
  let provenance = arm_experiment_2026_09_26_provenance(host: reading.host)
  ArmWetReceiptBinding {
    term: MemoryTerm {
      component: ArmKvCache,
      placement_law: MemoryPlacementAllocatorCarve,
      scaling_law: MemoryScalingStaticResidency,
      phase: ArmPhaseIdleServing,
      lifetime: MemoryLifetimeLaunch,
      bound: arm_experiment_2026_09_26_open_bound(obligation: "the observed carve bounds no demand term; the arena is supply evidence for the cache fold once a roster exists, and the cache subproof decides by the direct fold alone" as NonEmptyStr),
      derivation: "admitted KV arena carve at the experiment's allocator decision (8567 basis points on the rank's pool): what the engine's profiling left for the cache, observed on this rank by the completing launch's readback bracket" as NonEmptyStr,
    },
    rank: reading.rank,
    standing: ArmWetObservedInterval {
      lower: arm_experiment_gib_hundredths_lower(hundredths: reading.kv_arena_hundredths_gib),
      upper: arm_experiment_gib_hundredths_upper(hundredths: reading.kv_arena_hundredths_gib),
      receipt: provenance,
    },
    measured_on: measured_on,
    provenance: provenance,
  }
}

// ALL FOUR BINDINGS, or none while the subject refuses.
fn arm_experiment_2026_09_26_bindings() -> List<ArmWetReceiptBinding> {
  match arm_experiment_2026_09_26_subject() {
    Absent => [] as List<ArmWetReceiptBinding>
    Present { value: measured_on } =>
      map(arm_experiment_2026_09_26_arena_readings, r => arm_experiment_2026_09_26_arena_binding(reading: r, measured_on: measured_on))
  }
}

// ── THE RANK-SUPPLY PROJECTION: THE FORM THE CACHE FOLD CONSUMES ─────────────────────────────────
//
// THE FOLD'S SUPPLY VOCABULARY, projected from the readings: the arena at the hundredths FLOOR --
// the conservative point of the observed interval, the same spelling the 2026-09-25-derived
// supplies carried (commit 0fd1d463f5's witness priced rank 0's arena that way). The rounding
// unit (0.01 GiB, about 10.7 MB) sits two orders of magnitude below the byte wall's worst-rank
// headroom (about 18.44 GB), so floor-versus-interval cannot move the wall: the demand is 0.67%
// even of the worst rank's floor. THE ALLOCATOR INVENTORY IS THE CALLER'S: the plan's 1035-block
// figure is launch-level and arrives from the demand side, never from this observation layer.
fn arm_experiment_2026_09_26_cache_supplies(allocator_blocks: AllocatorBlockCount) -> List<ArmRankCacheSupply> {
  map(arm_experiment_2026_09_26_arena_readings, r => ArmRankCacheSupply {
    rank: r.rank,
    allocator_blocks: allocator_blocks,
