// ── THE LAUNCH-WALL CARRIES AT THE 262144x6 SUBJECT ──────────────────────────────────────────────
//
// THE WHOLE-ARM VERDICT'S OPEN TERMS, discharged or carried honestly from THIS LAUNCH's own
// evidence (docs/plans/moa-memory-modeling.md's three admissible uses of measurement: validate a
// derived bound, fill a narrowly named underivable term, falsify the model). Every carry below is
// built from the v2-plan bundle's own rows or the launch's own profile lines, and every carry's
// text names what it establishes and what it deliberately leaves open. NOTHING here promotes the
// whole arm: the loader transient and the fragmentation allowance stay open, and the composite
// carries name their composite-ness wherever they lean on the weights+nontorch reading.
//
// THE BOOT READINGS the "Free memory on device" profile lines carried beside the usage figures
// (gpu_worker.py:867, 2026-09-26T05:42:33Z, receipt target/spark-native-experiment-apply-receipt.txt):
// the device's total and its free memory at startup. THE FOREIGN OCCUPANCY at boot is their
// difference — 14.49 / 13.17 / 12.80 / 10.58 GiB across the four hosts, the "~11-15 GiB" the
// deduction carry prices. THE FREE FIGURE'S PRECISION is the print's own: format_gib renders two
// decimals and strips the trailing zero, so "107.2" is a 107.20-hundredths reading and rides at
// the same reporter's unit as every other figure in this bundle.

type ArmExperimentBootReading {
  rank: Nat
  host: NonEmptyStr
  free_hundredths_gib: Nat
  total_hundredths_gib: Nat
}

data arm_experiment_kvplan_v2_2026_09_26_boot_readings: List<ArmExperimentBootReading> = [
  ArmExperimentBootReading { rank: 0, host: "srv9" as NonEmptyStr, free_hundredths_gib: 10720, total_hundredths_gib: 12169 },
  ArmExperimentBootReading { rank: 1, host: "srv10" as NonEmptyStr, free_hundredths_gib: 10852, total_hundredths_gib: 12169 },
  ArmExperimentBootReading { rank: 2, host: "srv12" as NonEmptyStr, free_hundredths_gib: 10889, total_hundredths_gib: 12169 },
  ArmExperimentBootReading { rank: 3, host: "srv11" as NonEmptyStr, free_hundredths_gib: 10911, total_hundredths_gib: 11969 },
]

// THE BOOT DERIVATION, CHECKED NOT TRUSTED: foreign occupancy at boot = total - free in the
// hundredths arithmetic the lines were reported at, and the observed foreign band names the whole
// span the four hosts evidenced.
fn arm_experiment_kvplan_v2_2026_09_26_boot_derivation_holds() -> Bool {
  all(arm_experiment_kvplan_v2_2026_09_26_boot_readings, r =>
    r.free_hundredths_gib <= r.total_hundredths_gib
      && arm_experiment_kvplan_v2_2026_09_26_foreign_hundredths(r) == r.total_hundredths_gib - r.free_hundredths_gib)
}

fn arm_experiment_kvplan_v2_2026_09_26_foreign_hundredths(r: ArmExperimentBootReading) -> Nat {
  r.total_hundredths_gib - r.free_hundredths_gib
}

// THE POOL CARVE THE LAUNCH CONSTRUCTED, carried with the plan-capture provenance: the v2
// emission vouched allocator_blocks 1012 x physical_pool_bytes_per_block 13,602,816 =
// 13,766,049,792 bytes (dag/test/fixture/kv_allocation_plan_emission real_262144x6_v2_line, the
// engine's own startup line at this launch). The cache fold prices capacity against it; the
// launch wall charges it as the persistent KV residency term, exact because the engine vouched it.
data arm_experiment_kvplan_v2_2026_09_26_pool_carve_bytes: ByteSize = byte_size(count: 13766049792)

// THE SHAPE CONSTANTS the persistent-residency derivation reads: the launch's batch ceiling (the
// same 2048 every subject mint at this bundle spells) and the engine-pinned index_topk 2048
// (FLASHINFER_MLA_SPARSE_SM120 requires it, flashinfer_mla_sparse.py lines 216-227 at 8d09804c8,
// cited through extdeps.vllm.sparse_prefill_transient's term 3); the KPool interval is the
// model's own (glm_5_3_flash_hybrid_shape.index_kpool).
data arm_experiment_kvplan_v2_2026_09_26_max_num_batched_tokens: Nat = 2048
data arm_experiment_kvplan_v2_2026_09_26_index_topk: Nat = 2048

// THE INTERVAL MINT, localized: a reversed derived pair is an Open carrying the refusal cause,
// never a silently swapped pair (std.interval's law, through gunbc.spark.arm_memory_fit's mint).
fn arm_experiment_component_interval(lower: ByteSize, upper: ByteSize, how: NonEmptyStr) -> ArmComponentBound {
  match component_bound_interval(lower: lower, upper: upper, how: how) {
    ArmComponentBoundReady { bound: b } => b
    ArmComponentBoundRefused { cause: c } => ComponentBoundOpen { obligation: c }
  }
}

// THE IDENTITY WIRES every non-open carry names, as the fit subject's provenance check requires.
fn arm_experiment_kvplan_v2_2026_09_26_carry_identity() -> NonEmptyStr {
  join([
    serving_checkpoint_wire(c: Glm53NativeFp8) as String, " x ",
    serving_runtime_wire(r: GunbcGlm53NopeDerivedGb10) as String, " x ",
    serving_topology_wire(t: FourSparkTp4) as String,
  ], "") as NonEmptyStr
}

// ── TERM: CHECKPOINT PLACEMENT, CARRIED AS A DERIVED CONSERVATIVE INTERVAL ───────────────────────
//
// THE DOCTRINE'S FORBIDDEN-MOVE LAW (docs/plans/moa-memory-modeling.md): weights+nontorch is a
// COMPOSITE profile term, NOT a checkpoint-placement receipt -- it does not separate checkpoint
// tensors from runtime-fixed, allocator, communication or other non-Torch allocations, so it can
// never discharge the placement obligation by itself. WHAT THE COMPOSITE OBSERVATION DOES
// ESTABLISH, soundly: the rank's checkpoint residency is BOUNDED ABOVE by the composite floor
// (every checkpoint byte is either a torch weight or a non-torch allocation at the profiling
// phase, so checkpoint_r <= composite_r), and the rank-to-rank spread (77.62 / 80.57 / 81.63 /
// 82.42 GiB at this launch) is the genuinely observational part: placement is NOT an even
// quarter, and the carry's per-rank upper endpoints carry that asymmetry verbatim. THE LOWER
// ENDPOINT IS ZERO, and that is the honest scalar: no positive per-rank lower bound is derivable
// without the per-tensor safetensors index (the aggregate pigeonhole bounds only the MAX-loaded
// rank, which the subject's checkpoint_total interval already carries). THE AGGREGATE GAP, named
// because a reader will trip on it: the manifest's safetensors total (328,337,455,672 bytes at
// revision eb9eb208, extdeps.zhipu.glm_5_3_flash glm_5_3_flash_native_manifest) EXCEEDS the sum of
// the four composite floors (322.24 GiB) by ~6.1 GiB, so at least that many manifest bytes are not
// resident in weights+nontorch at any rank at this launch -- an unloaded tower, index tensors, or
// scales the composite cannot place. THE COMPLETING ACT, named: a per-tensor read of the
// checkpoint's safetensors index (model.safetensors.index.json at /weights on any group B host)
// lets the exact TP4 placement projection bound every rank's checkpoint residency from the
// manifest x the loader's placement rules, replacing this carry.

// THE CHECKPOINT TERM IS THE PROJECTION'S EXACT PER-RANK FIGURE: 83,237,158,776 bytes,
// identical on every rank (every large tensor class shards or expert-splits across the four
// ranks; only norms/router/parameters and the visual tower replicate -- and the visual tower
// LOADS, config.json architectures Glm5NextForConditionalGeneration, the GLM4V-pattern
// multimodal wrapper at model.py:963). The composite carry it replaces is retired: the
// composite observation was the interim upper bound, and it now decomposes exactly -- composite
// floor minus placement -- into the residue that prices runtime-fixed and collective below.
fn arm_experiment_kvplan_v2_2026_09_26_checkpoint_projected() -> ArmComponentBound {
  ComponentBoundExact {
    bytes: glm_checkpoint_projection_per_rank_bytes(),
    how: join([
      "checkpoint residency DERIVED EXACT by the TP4 placement projection: the checkpoint's own index (76,108 tensors at revision eb9eb208) classified by the pinned source's placement rules (VocabParallel embed/lm_head; ColumnParallel q/k/v/b/f/g/q_b/kv_b/wk/conv1d and MergedColumn gate_up/shared_experts/in_proj; RowParallel down_proj/o_proj; FusedMoE expert bodies over the EP group, which IS the TP group at this launch; GateLinear router, norms, A_log/dt_bias/hc_/indexer wq_b/q_a and the loading visual tower replicated), byte-sized from the 62 shard headers -- vocab 2,537,553,920 + column 8,919,910,400 + row 3,599,034,368 + expert 311,729,651,712, over four ranks, plus the replicated population 1,540,621,176 on every rank = 83,237,158,776 bytes per rank, identical on all four. The conservation wall holds with slack zero: the four figures sum to 332,948,635,104 = the sharded-plus-expert bytes once plus the replicated bytes four times. Per-tensor shard padding rides as a named sub-block deviation, under one KiB per tensor class aggregate. Subject: ",
      arm_experiment_kvplan_v2_2026_09_26_carry_identity() as String,
    ], "") as NonEmptyStr,
  }
}

// ── TERM: RUNTIME-FIXED, BOUNDED FROM THE PINNED SOURCE AND THE COMPOSITE DECOMPOSITION ──────────
//
// THE LOWER ENDPOINT IS DERIVED, not measured: the sparse-attention top-k index buffer,
// (max_num_batched_tokens, buffer_width) int32 allocated ONCE at model init
// (glm5next/nvidia/model.py lines 588-606 at 8d09804c8, cited through extdeps.vllm.
