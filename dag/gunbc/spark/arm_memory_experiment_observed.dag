  ArmExperimentArenaReading { rank: 1, host: "srv10" as NonEmptyStr, kv_arena_hundredths_gib: 1862 },
  ArmExperimentArenaReading { rank: 2, host: "srv12" as NonEmptyStr, kv_arena_hundredths_gib: 1890 },
