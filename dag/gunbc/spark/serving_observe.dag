// OBSERVATION PRODUCER (SPARK-SERVE-BIND-0 item B) over FleetSsh — callers supply a sealed
// FleetSshExecutionContext rather than hardcoding one credential route.

// Wet observation only; a green witness over fixture strings is not proof gpt-oss:20b is serving.
// Runtime closure identity requires the release-archive admission receipt under
// ~/.local/share/gunbc/spark-serving/ (archive digest admitted at materialization — not proof of
// completed install) plus independent /api/version and /api/tags probes. This branch does not
// install or start Ollama on the hosts.

data spark_serving_observe_receipt_path: String = "target/spark-serving-observe-receipt.txt"

// A SEPARATE PATH FOR THE RUNNER-SIDE ENTRY, so a receipt on disk is unambiguous about which
// entry produced it and therefore which credential locus and trust preconditions were in play.
// Sharing one path would make an anchored-context observation and an ssh-agent observation
// indistinguishable after the fact.
data spark_serving_observe_ci_receipt_path: String = "target/spark-serving-observe-ci-receipt.txt"

fn spark_serving_load_state_probe_words() -> List<String> {
  [
    "systemctl", "--user", "show", spark_serving_unit_name, "--property=LoadState", "--value",
  ]
}

fn spark_serving_active_probe_words() -> List<String> {
  [
    "systemctl", "--user", "is-active", spark_serving_unit_name,
  ]
}

// READ THE DEFINITION IDENTITY FROM THE PROCESS SYSTEMD IS ACTUALLY SUPERVISING.
//
// Neither the unit file nor `systemctl show ExecStart` answers this question after daemon-reload:
// both describe the new definition while the old process can remain alive. MainPID selects the
// running invocation and /proc/<pid>/environ retains the identity stamped into that invocation at
// exec. The PID AND Linux process start time are read around the environment so a concurrent
// restart refuses instead of joining bytes from one invocation to the manager state of another;
// the start-time bracket also catches the rarer case where the numeric PID is reused inside the
// window.
//
// A SUCCESSFUL read with no marker prints `absent`: that is positive evidence that this invocation
// came from the earlier, unstamped definition deployed before this capability existed. It is not
// unobservable. Only inability to read procfs or a malformed/moving MainPID refuses.
fn spark_serving_running_definition_probe_argv() -> List<String> {
  [
    "bash", "-lc",
    join([
      "pid_before=$(systemctl --user show ", spark_serving_unit_name,
      " --property=MainPID --value) || exit $?; ",
      "case \"$pid_before\" in ''|*[!0-9]*|0) echo 'running-definition: MainPID did not name a running process' >&2; exit 65;; esac; ",
      "start_before=$(awk '{print $22}' /proc/$pid_before/stat) || exit $?; ",
      "identity=$(awk -v 'RS=\\0' -F= '$1 == \"GUNBC_SPARK_SERVING_DEFINITION_IDENTITY\" { print \"present:\" substr($0, index($0, \"=\") + 1); found=1 } END { if (!found) print \"absent\" }' /proc/$pid_before/environ) || exit $?; ",
      "pid_after=$(systemctl --user show ", spark_serving_unit_name,
      " --property=MainPID --value) || exit $?; ",
      "start_after=$(awk '{print $22}' /proc/$pid_after/stat) || exit $?; ",
      "test \"$pid_before:$start_before\" = \"$pid_after:$start_after\" || { echo 'running-definition: MainPID or process start time moved during observation' >&2; exit 67; }; ",
      "printf '%s\\n' \"$identity\"",
    ], ""),
  ]
}

data spark_serving_version_probe_words: List<String> = [
  "curl", "-sf", "http://127.0.0.1:11434/api/version",
]

data spark_serving_tags_probe_words: List<String> = [
  "curl", "-sf", "http://127.0.0.1:11434/api/tags",
]

data spark_serving_nvidia_driver_probe_words: List<String> = [
  "nvidia-smi", "--query-gpu=driver_version", "--format=csv,noheader",
]

// PRIVILEGE IS PART OF WHAT A HOST HOLDS, so it is read on the leg that reads everything else. This
// is not a new probe entry: the automation principal is the account that needs the grants, and this
// path already connects as it, so measuring here costs one more leg and no new workflow mode.
//
// It is a READ. `sudo -n -l` enumerates and never actuates, which is why it can ride an observation
// at all -- and why a failure of it is an observation too, not an error.
data spark_serving_grant_probe_words: List<String> = [
  "sudo", "-n", "-l",
]

fn spark_serving_grant_outcome_from_probe(probe: SshSessionExecResult?) -> SparkGrantOutcome {
  match probe {
    Absent => GrantProbeRefused { cause: "the grant probe leg did not run" }
    Present { value: r } =>
      if r.success {
        GrantEnumerated { listing: r.stdout }
      } else {
        GrantAbsent { detail: join(["exit=", to_string(r.exit_code), " stderr=", trim(s: r.stderr)], "") }
      }
  }
}

// THE ACCOUNT THIS PATH CONNECTS AS IS ALSO A FACT THE FLEET AUTHORITY WANTS, and it rides the same
// leg for the same reason the grant probe does: the automation principal IS the account in question,
// this path already connects as it, so measuring costs one more read and no new workflow mode.
//
// WHY IT EXISTS AT ALL. gunbc.fleet_posix_accounts is the account authority and carries no row for
// srv5 or srv6 -- its allocations cover srv1/srv2 applied and srv3/srv4 pending. So the accounts
// that actually exist on the two Sparks are absent from the authority in any form, and the only
// thing that could be said about them today would be INFERRED (a converged grant standing implies a
// grant bound to some login; the units serve, so an account exists). Inference is not observation,
// and authoring a well-shaped row from it is precisely the error this vertical just deleted a whole
// module over -- facts authored as inputs to a run that never happened rather than as observations
// of the units as they stand. So the authority's rows wait on this probe rather than on a guess.
//
// BOTH LEGS ARE READS. `getent passwd` and `stat` enumerate and never actuate, which is what lets
// them ride an observation, and a failure of either is an observation too rather than an error.
//
// WHAT IS DELIBERATELY NOT PROBED HERE: the gunbc-inference identity. This path connects as
// gunbc-automation, so reading that account's own passwd row and its own ~/.ssh is unprivileged,
// while reading another account's home is not. A second identity is therefore a COVERAGE OBLIGATION
// named here, not a field inferred from this one.
data spark_serving_account_probe_login: NonEmptyStr = spark_managed_executor_login as NonEmptyStr

fn spark_serving_account_probe_words() -> List<String> {
  ["getent", "passwd", spark_serving_account_probe_login as String]
}

// `stat -c` IS UNUSABLE THROUGH THIS TRANSPORT, and the reason is a wall doing its job rather than a
// defect. portable_remote_word admits only [A-Za-z0-9._-/@:=,] -- every shell metacharacter is
// refused, `%` among them -- so no stat format string can ever be a portable word. Two wet runs
// established this: `%a %U %G` was refused (spaces), and so was `%a:%U:%G` (the percent itself), the
// second of which is what proved the first diagnosis wrong.
//
// So the mode is read with `ls -ld`, which needs no format string at all. Its first field is the
// symbolic mode -- and symbolic is arguably the better carrier here anyway, because the property
// this observation exists to record is that the key file is not group- or world-readable, which
// `-rw-------` states directly and `600` states by convention.
fn spark_serving_authorized_keys_probe_words() -> List<String> {
  [
    "ls", "-ld",
    join([
      spark_managed_principal_home(login: spark_serving_account_probe_login) as String,
      "/.ssh/authorized_keys",
    ], ""),
  ]
}

// A passwd row is a colon record and is decomposed as one -- login, uid, gid, shell -- rather than
// carried as the line it arrived on. A String leaf hiding named parts is anemic modeling, and the
// fields are exactly what fleet_posix_accounts PosixUser already asks for.
type SparkManagedAccountObservation
  = ManagedAccountObserved {
      login: NonEmptyStr,
      uid: NonEmptyStr,
      gid: NonEmptyStr,
      shell: NonEmptyStr,
      authorized_keys_mode: NonEmptyStr,
      authorized_keys_owner: NonEmptyStr,
    }
  | ManagedAccountKeyFileUnread {
      login: NonEmptyStr,
      uid: NonEmptyStr,
      gid: NonEmptyStr,
      shell: NonEmptyStr,
      cause: NonEmptyStr,
    }
  | ManagedAccountAbsent { detail: NonEmptyStr }
  | ManagedAccountRowMalformed { detail: NonEmptyStr }
  | ManagedAccountProbeRefused { cause: NonEmptyStr }

// THE KEY-FILE ARM IS SEPARATE FROM THE ACCOUNT ARM ON PURPOSE. An account that exists with an
// unreadable authorized_keys is a different state from an account that does not exist, and they have
// different remedies; collapsing them would be the state-space conflation DESIGN names. Partial is
// honest -- the arm carries what was measured and names what was not.
// `ls -ld` pads its columns, so a naive split on " " yields empty fields between runs of spaces and
// every index after the first is wrong. Dropping empties makes the position stable whatever the
// padding is -- which matters because the fields this reads are at positions 0 and 2.
fn spark_serving_nonempty_fields(row: List<String>) -> List<String> {
  fold(row, init: [], f: fn(acc, field) {
    if field == "" { acc } else { concat(acc, [field]) }
  })
}

// THIS FUNCTION USED TO RETURN "" FOR A MISSING INDEX, and the empty string was then cast into a
// NonEmptyStr field. Two things were wrong with that and only one of them is about types. The
// carrier's whole purpose is that an empty value is unrepresentable, so laundering one through
// `as NonEmptyStr` inverts the rung it exists to hold -- and downstream, a truncated getent row and
// a well-formed one both arrived as ManagedAccountObserved with no way to tell them apart. That is
// the fabricated-plausible-output failure DESIGN section 5 forbids, sitting inside a decoder I wrote
// specifically to be honest about partial states. I then wrote a test asserting the empty value was
// fine, which is how it survived to review.
//
// A missing OR empty field is now Absent, and the caller must dispose of it. Empty is folded in with
// missing deliberately: for the four fields this reads, an empty column is exactly as unusable as a
// column that is not there, and giving them separate states would be a distinction with no
// difference in remedy.
fn spark_serving_account_field(row: List<String>, index: Int) -> String? {
  match row.skip(n: index).first() {
    Absent => none
    Present { value: v } => if v == "" { none } else { Present { value: v } }
  }
}

// THE PROVEN ROW. Decoding lands here or it does not land at all, so every consumer downstream takes
// four fields that are non-empty BY CONSTRUCTION rather than four that were checked somewhere. The
// nesting is confined to this one function, which is the price of making the malformed state
// unrepresentable instead of detectable.
type SparkPasswdRow {
  login: NonEmptyStr
  uid: NonEmptyStr
  gid: NonEmptyStr
  shell: NonEmptyStr
}

fn spark_serving_passwd_row(fields: List<String>) -> SparkPasswdRow? {
  match spark_serving_account_field(row: fields, index: 0) {
    Absent => none
    Present { value: login } => match spark_serving_account_field(row: fields, index: 2) {
      Absent => none
      Present { value: uid } => match spark_serving_account_field(row: fields, index: 3) {
        Absent => none
        Present { value: gid } => match spark_serving_account_field(row: fields, index: 6) {
          Absent => none
          Present { value: shell } => Present {
            value: SparkPasswdRow {
              login: login as NonEmptyStr,
              uid: uid as NonEmptyStr,
              gid: gid as NonEmptyStr,
              shell: shell as NonEmptyStr,
            },
          }
        }
      }
    }
  }
}

// THE KEY-FILE FACTS get the same treatment, but their malformed case does NOT need a new variant:
// `ls -ld` output that will not decode is a key file we could not read, which is precisely what
// ManagedAccountKeyFileUnread already says. Minting a second variant for it would be the state-space
// split with no remedy difference that the passwd case genuinely does have.
type SparkKeyFileFacts {
  mode: NonEmptyStr
  owner: NonEmptyStr
}

fn spark_serving_key_file_facts(fields: List<String>) -> SparkKeyFileFacts? {
  match spark_serving_account_field(row: fields, index: 0) {
    Absent => none
    Present { value: mode } => match spark_serving_account_field(row: fields, index: 2) {
      Absent => none
      Present { value: owner } => Present {
        value: SparkKeyFileFacts { mode: mode as NonEmptyStr, owner: owner as NonEmptyStr },
      }
    }
  }
}

fn spark_serving_account_observation_from_probes(
  passwd_probe: SshSessionExecResult?,
  key_probe: SshSessionExecResult?,
) -> SparkManagedAccountObservation {
  match passwd_probe {
    Absent => ManagedAccountProbeRefused { cause: "the account probe leg did not run" }
    Present { value: pw } =>
      if pw.success == false {
        ManagedAccountAbsent {
          detail: join([
            "getent passwd ", spark_serving_account_probe_login as String,
            " exit=", to_string(pw.exit_code), " stderr=", trim(s: pw.stderr),
          ], "") as NonEmptyStr,
        }
      } else {
        match spark_serving_passwd_row(fields: split(trim(s: pw.stdout), ":")) {
          Absent =>
            ManagedAccountRowMalformed {
              detail: join([
                "getent passwd returned a row that does not decode: ", trim(s: pw.stdout),
              ], "") as NonEmptyStr,
            }
          Present { value: row } => match key_probe {
            Absent =>
              ManagedAccountKeyFileUnread {
                login: row.login, uid: row.uid, gid: row.gid, shell: row.shell,
                cause: "the authorized_keys probe leg did not run" as NonEmptyStr,
              }
            Present { value: k } =>
              if k.success == false {
                ManagedAccountKeyFileUnread {
                  login: row.login, uid: row.uid, gid: row.gid, shell: row.shell,
                  cause: join([
                    "ls -ld exit=", to_string(k.exit_code), " stderr=", trim(s: k.stderr),
                  ], "") as NonEmptyStr,
                }
              } else {
                match spark_serving_key_file_facts(
                  fields: spark_serving_nonempty_fields(row: split(trim(s: k.stdout), " ")),
                ) {
                  Absent =>
                    ManagedAccountKeyFileUnread {
                      login: row.login, uid: row.uid, gid: row.gid, shell: row.shell,
                      cause: join([
                        "ls -ld output does not decode: ", trim(s: k.stdout),
                      ], "") as NonEmptyStr,
                    }
                  Present { value: kf } =>
                    ManagedAccountObserved {
                      login: row.login, uid: row.uid, gid: row.gid, shell: row.shell,
                      authorized_keys_mode: kf.mode,
                      authorized_keys_owner: kf.owner,
                    }
                }
              }
          }
        }
      }
  }
}

fn spark_serving_account_line(host: HostIdentity, account: SparkManagedAccountObservation) -> String {
  match account {
    ManagedAccountObserved { login: l, uid: u, gid: g, shell: sh, authorized_keys_mode: m, authorized_keys_owner: o } =>
      join([
        "account host=", host as String, " login=", l as String, " uid=", u as String,
        " gid=", g as String, " shell=", sh as String,
        " authorized_keys_mode=", m as String, " authorized_keys_owner=", o as String, "\n",
      ], "")
    ManagedAccountKeyFileUnread { login: l, uid: u, gid: g, shell: sh, cause: c } =>
      join([
        "account host=", host as String, " login=", l as String, " uid=", u as String,
        " gid=", g as String, " shell=", sh as String,
        " authorized_keys=UNREAD cause=", c as String, "\n",
      ], "")
    ManagedAccountAbsent { detail: d } =>
      join(["account host=", host as String, " state=absent detail=", d as String, "\n"], "")
    ManagedAccountRowMalformed { detail: d } =>
      join(["account host=", host as String, " state=row-malformed detail=", d as String, "\n"], "")
    ManagedAccountProbeRefused { cause: c } =>
      join(["account host=", host as String, " state=probe-refused cause=", c as String, "\n"], "")
  }
}

// THE READBACK TRAVELS WITH THE OBSERVATION, and it is not bookkeeping. The observation line says
// only observed/absent/refused plus a release digest; every fact the derivation CONSUMED to reach
// that verdict -- unit outcome, runtime version, model digest, and now boot provenance -- lived on
// the readback and was dropped on the floor. So the wet receipt could report a host as observed
// while staying silent on whether its unit would survive a power cycle, which is exactly the
// question the run was dispatched to answer. A field with a witness and no wet reader is a carrier,
// not an observation.
// THE HOST WAS CARRIED TWICE AND COVERAGE JOINED ONE OF THEM.
//
// Found on review of #9754. Every SparkServingObservation arm carries its own `host`, so a row could
// be authored with readback.host = srv6 and observation.host = srv7: coverage would be satisfied for
// srv6 while the report emitted an observation of srv7. The production path could not do this --
// derive_spark_serving_observation sets the observation's host from readback.host in every arm -- but
// the TYPE permitted it, and "the only current producer happens to agree" is not a property, it is a
// coincidence that holds until someone writes a second producer. The fixtures in this repository
// already construct both halves independently, so the counterexample was not hypothetical.
//
// THE REPAIR IS CONSTRUCTION, NOT A SECOND CHECK. Adding a readback.host == observation.host guard
// beside the coverage join would be validation standing exactly where construction was available,
// and DESIGN §5's tell applies literally: it could be satisfied by editing the declaration while the
// realization still lied. sole_constructor confines the mint to this module, and the single mint
// below DERIVES the observation from the readback rather than accepting it. The disagreeing state
// now has no constructor, which is why the coverage join can read readback.host and be reading the
// only host there is.
type SparkServingHostObservation sole_constructor {
  readback: SparkServingReadback
  observation: SparkServingObservation
  account: SparkManagedAccountObservation
  projection: SparkServingObservedMemberProjection
  provenance: SparkServingObservationProvenance
}

// P0-C3: THE PLANNING PROJECTION IS CARRIED BY THE OBSERVATION THAT PRODUCED IT.
//
// This carrier held only the reporting facts, so the planner could not be fed from it. The two
// routes available instead were both wrong in the same way: parse the human receipt back into
// members, or run a SECOND observation for planning. The second is the one that looks harmless --
// it is only more probes -- and it is the one that silently joins a unit's content read at one
// moment with its enablement read at another. Two facts about one machine taken from two
// observations are not an observation of that machine.
//
// WHAT IS TRUE TODAY, STATED AT ITS ACTUAL STRENGTH. The paragraph that stood here said "one
// observation, one producer" was the DESTINATION and not yet the state, and it was right to: at the
// time, is-active and the runtime receipt were each probed twice, and the via-locus path mixed
// executor adapters -- readback through one leg runner, projection helpers reaching for another.
//
// That is now the state. Every capture in a host observation comes from one
// SparkServingObservationTransaction: one host, one credential locus, one observation attempt
// derived from the sealed fleet attempt and a typed phase, and exactly one capture per required
// request, with missing and duplicated requests both refusing admission. The derivations below hold
// no transport, so none of them can add a leg; the capture carries its request rather than a label
// beside an argv, so none of them can be misfiled; and this mint is sealed by admit_callers to the
// transaction projectors and one named hermetic fixture, so an observation cannot be assembled
// without a transaction behind it.
//
// The post-apply replan used to be the exception, probing linger on its own and passing a Bool. It
// now acquires its own transaction under SparkServingPostApplyObservation, so there is no planning
// input anywhere that is not a projection of the transaction it was planned from.
//
// THE MINT TAKES PROBES, NOT A FINISHED PROJECTION, AND THAT IS THE WHOLE PROVENANCE ARGUMENT.
//
// A first version of this took the projection as a parameter, on the reasoning that it is a function
// of four probes this type does not carry, so a mint claiming to derive it would be fabricating
// them. That reasoning was right about the probes and wrong about the interface, and it reopened the
// exact class #9754 had just closed one field over: nothing stopped a caller pairing srv5's readback
// with a projection built for srv6. Two hosts, one carrier, disagreeing -- the same defect, a
// different field.
//
// So the mint takes the four PROBE OBSERVATIONS and builds the projection itself from
// `readback.host`. Nothing is fabricated: every probe result still arrives from the caller that ran
// it. What the caller no longer supplies is the HOST those probes are about, because there is only
// one host in this carrier and it comes from the readback. A projection about a different machine
// is now unconstructible rather than merely discouraged.
// THE MINT IS SEALED, SO A HOST OBSERVATION CANNOT BE ASSEMBLED WITHOUT A TRANSACTION BEHIND IT.
//
// sole_constructor stopped an outside module writing the record literal. It did not stop this
// general-purpose factory from being called with independently supplied readback, runtime, store,
// unit and linger values -- which is the old free-standing route, still production-equivalent, and
// the reason a downstream consumer could not tell an observation projected from an admitted
// transaction apart from one somebody assembled. The provenance field made that distinction
// STATABLE; admit_callers is what makes it TRUE.
//
// TWO CALLERS, BOTH TRANSACTION PROJECTORS. NO FIXTURE REACHES THIS MINT.
//
// A fixture used to be admitted here by name, and review found what that bought: the fixture could
// pair an ACQUIRED provenance -- honestly projected from a real admitted transaction -- with runtime,
// store, unit and linger values authored independently of that transaction's captures. The arm was
// authentic and the facts under it were not, which is this carrier's own defect one layer up, and no
// RED caught it because the REDs all proved that the WRONG ARM is refused.
//
// So the fixture route is gone from here. Witnesses that need an observation carrying independently
// authored facts go through spark_serving_hermetic_host_observation below, which cannot express an
// acquired arm at all; witnesses that need an ACQUIRED observation must build captures whose stdout
// makes the production projectors derive the state they want, and come through
// spark_serving_host_observation_from_transaction like production does.
fn spark_serving_host_observation(
  readback: SparkServingReadback,
  account: SparkManagedAccountObservation,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  observed_unit: SparkServingObservedUnit,
  linger: SparkServingObservedLingerState,
  provenance: SparkServingObservationProvenance,
) -> SparkServingHostObservation
  admit_callers: [
    decl_ref(
      module_path: "gunbc.spark.serving_observe",
      decl_name: "spark_serving_host_observation_from_transaction",
    ),
    decl_ref(
      module_path: "gunbc.spark.serving_observe",
      decl_name: "spark_serving_host_observation_from_refused_transaction",
    ),
    decl_ref(
      module_path: "gunbc.spark.serving_observe",
      decl_name: "spark_serving_hermetic_host_observation",
    ),
  ]
{
  SparkServingHostObservation {
    readback: readback,
    observation: derive_spark_serving_observation(readback: readback),
    account: account,
    projection: spark_serving_observed_members_for_unit(
      host: readback.host,
      runtime: runtime,
      store: store,
      observed_unit: observed_unit,
      linger: linger,
      provenance: provenance,
    ),
    provenance: provenance,
  }
}

// THE FIXTURE MINT, AND IT CANNOT EXPRESS AN ACQUIRED ARM.
//
// This is how independently authored facts enter a host observation, and it is deliberately not a
// parameterisation of the privileged mint: there is NO provenance parameter. The provenance is the
// hermetic arm, always, by construction. So the invalid state review found -- independent runtime,
// store, unit and linger sitting under SparkServingObservationAcquired -- has no constructor
// anywhere, rather than being a route somebody remembered not to take.
//
// That is the difference between deleting a caller and closing a class. Deleting the fixture from
// the privileged mint would have left the splice writable by the next fixture; removing the
// provenance PARAMETER means no fixture can author one, present or future.
//
// A witness that wants a genuinely acquired observation has exactly one route, the same one
// production takes: choose capture stdout so the production projectors derive the state, admit a
// transaction, and project it with spark_serving_host_observation_from_transaction.
fn spark_serving_hermetic_host_observation(
  readback: SparkServingReadback,
  account: SparkManagedAccountObservation,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  observed_unit: SparkServingObservedUnit,
  linger: SparkServingObservedLingerState,
  fixture_identity: NonEmptyStr,
) -> SparkServingHostObservation
  admit_callers: [
    decl_ref(
      module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture",
      decl_name: "hermetic_host_observation",
    ),
  ]
{
  spark_serving_host_observation(
    readback: readback,
    account: account,
    runtime: runtime,
    store: store,
    observed_unit: observed_unit,
    linger: linger,
    provenance: spark_serving_hermetic_provenance_of(
      host: readback.host,
      fixture_identity: fixture_identity,
    ),
  )
}

fn spark_serving_transaction_provenance(
  txn: SparkServingObservationTransaction,
) -> SparkServingObservationProvenance {
  spark_serving_acquired_provenance_of(txn: txn)
}

// THE LINGER PROBE WORDS LIVE HERE NOW, and serving_converge_slice_wet imports them rather than
// declaring its own copy. They were duplicated across the transport boundary -- one spelling on the
// context path, an identical one on the HostEffectTransport path -- which is the §3 fork: the same
// argv authored twice, free to drift the first time loginctl's interface moves.
fn spark_serving_linger_probe_words() -> List<String> {
  [
    "loginctl",
    "show-user",
    spark_serving_automation_principal_login() as String,
    "-p",
    "Linger",
  ]
}

// THE CANONICAL THREE-VALUED LINGER DECODER, for the unified observation producer.
//
// WHY THE DISTINCTION IS LOAD-BEARING: an unobserved property must not enter the observed member
// list, because absence from that list is what makes membership_reconcile plan an ADDITION. So
// "the probe did not answer" and "linger is off" must not become one value.
//
// WHAT THIS DOES NOT DO, recorded because an earlier revision claimed it did.
// serving_converge_slice_wet was described here as collapsing unobserved into disabled. That was
// measured and is FALSE: the slice already refuses transport refusal, nonzero exit, and malformed
// stdout -- setting LingerUnobserved with zero planned rows -- before any Boolean translation is
// reached. The claim was inferred from a `Bool?` in a signature rather than from the control flow.
// This function does not repair that slice; it serves a new consumer that needs the third value.
fn spark_serving_observed_linger_from_probe(
  result: SshSessionExecResult?,
) -> SparkServingObservedLingerState {
  match result {
    Absent => LingerUnobservedState
    Present { value: r } =>
      if r.exit_code != 0 {
        LingerUnobservedState
      } else if trim(s: r.stdout) == "Linger=yes" {
        LingerObservedEnabled
      } else if trim(s: r.stdout) == "Linger=no" {
        LingerObservedDisabled
      } else {
        LingerUnobservedState
      }
  }
}

type SparkServingObservationReport
  = SparkServingObservationsProduced {
      first: SparkServingHostObservation,
      more: List<SparkServingHostObservation>,
    }
  | SparkServingObservationReportRefused { refusal: SparkServingObservationReportRefusal }

// THE COVERAGE JOIN COMPUTED A TYPED RESULT AND THE REPORT KEPT ONLY ITS RENDERER.
//
// Found on review of #9754. spark_observation_coverage answers with three separate identity
// populations -- missing, foreign, duplicated -- because they are three different defects with three
// different causes. The report's refusal arm carried a single NonEmptyStr, so the constructor
// formatted those populations into "missing=... foreign=... duplicated=..." and threw the structure
// away at the moment it was computed. A downstream consumer could not ask WHICH identities were
// missing; it could only parse presentation text.
//
// That is the producer-versus-renderer confusion, and it matters beyond tidiness: P0-C3 needs a
// planner refusal to stay attributable to the exact observation-scope defect rather than arriving as
// an undifferentiated sentence. Rendering now happens at the receipt boundary and nowhere else.
//
// THE PREREQUISITE ARM IS NOT A LOOPHOLE. Attempt-identity refusal and known-hosts materialization
// refusal are genuinely un-typed strings from outside this module's vocabulary, so they keep a cause.
// The coverage arm must never use it -- routing a coverage defect through the prose arm would restore
// exactly the loss this type was introduced to end.
type SparkServingObservationReportRefusal
  = SparkServingObservationScopeEmpty
  | SparkServingObservationCoverageIncomplete {
      missing: List<HostIdentity>
      foreign: List<HostIdentity>
      duplicated: List<HostIdentity>
    }
  | SparkServingObservationPrerequisiteRefused { cause: NonEmptyStr }

// LOCUS-PARAMETERIZED PROBE LEG. Same observation, either credential locus. The
// context-taking leg below remains for the operator-workstation entry; this one is what the
// runner entry uses, because a GHA self-hosted slot carries no gcloud and cannot build an
// anchored context at all (spark_credential_access_token_frontier_note). Refusals stay typed
// rather than collapsing to `none`, so an unreachable host and an unportable word list do not
// arrive at the caller as the same value.
// THE TRANSPORT'S REFUSAL REASON IS CARRIED, and this is the fourth instrument of this exact shape
// this lane has had to repair. The arm read `TypedArgvExecRefused { reason: _ } => none`, so a leg
// the transport declined became indistinguishable from a leg nobody asked for, and every consumer
// downstream could say only "probe leg did not run" -- the shape that costs a whole diagnostic cycle
// because the one fact needed to end it was computed and thrown away one line from the caller.
//
// A refused leg now surfaces as a result carrying the reason on stderr with a non-zero exit, which
// is the same shape a genuinely failing command produces and which every field reader already
// renders with its cause attached. The distinction the exit code preserves: 127 is "this leg was
// never attempted", not "the command ran and failed".

// ACQUISITION HAPPENS HERE AND NOWHERE ELSE.
//
// One transport, one pass, one capture per leg. The leg list is written out rather than folded over
// a table because each leg's argv comes from its own authority, and a table would need a second
// naming scheme mapping leg to argv -- the fold would buy nothing and cost a nickname.
//
// The blob-digest leg is the one that cannot be acquired in the same pass: its argv is DERIVED from
// the manifest capture's stdout, so it is a second round by necessity rather than by oversight. It
// is acquired here, in the same transaction, so the derived leg still belongs to one attempt and one
// locus; what it must never become is a leg some downstream derivation reaches for on its own.
fn spark_serving_acquire_observation_transaction(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  phase: SparkServingObservationPhase,
) -> SparkServingTransactionAdmission {
  let manifest = spark_serving_captured_leg(
    context: context, host: host, request: ModelManifestRequest,
  )
  spark_serving_observation_transaction_of(
    request: spark_serving_observation_request(
      host: host,
      fleet_attempt: context.attempt,
      phase: phase,
    ),
    credential: context.credential,
    captures: concat(
      [
        spark_serving_captured_leg(context: context, host: host, request: LoadStateRequest),
        spark_serving_captured_leg(context: context, host: host, request: IsActiveRequest),
        spark_serving_captured_leg(context: context, host: host, request: VersionRequest),
        spark_serving_captured_leg(context: context, host: host, request: TagsRequest),
        spark_serving_captured_leg(context: context, host: host, request: NvidiaDriverRequest),
        spark_serving_captured_leg(context: context, host: host, request: RuntimeReceiptRequest),
        spark_serving_captured_leg(context: context, host: host, request: ActiveEnterRequest),
        spark_serving_captured_leg(context: context, host: host, request: DefaultTargetEnterRequest),
        spark_serving_captured_leg(context: context, host: host, request: UptimeRequest),
        spark_serving_captured_leg(context: context, host: host, request: GrantsRequest),
        spark_serving_captured_leg(context: context, host: host, request: PasswdRequest),
        spark_serving_captured_leg(context: context, host: host, request: AuthorizedKeysRequest),
        spark_serving_captured_leg(context: context, host: host, request: LingerRequest),
        manifest,
        spark_serving_captured_leg(context: context, host: host, request: ModelBlobsListingRequest),
        spark_serving_captured_leg(context: context, host: host, request: ModelManifestDigestRequest),
        spark_serving_captured_leg(context: context, host: host, request: UserUnitReadRequest),
        spark_serving_captured_leg(context: context, host: host, request: UserUnitIsEnabledRequest),
        spark_serving_captured_leg(context: context, host: host, request: RunningDefinitionRequest),
        spark_serving_captured_leg(context: context, host: host, request: RuntimeRootRequest),
        spark_serving_captured_leg(context: context, host: host, request: RuntimeExecutableRequest),
        spark_serving_captured_leg(context: context, host: host, request: RuntimeExecutableBitRequest),
        spark_serving_captured_leg(context: context, host: host, request: RuntimeRootListingRequest),
      ],
      [
        spark_serving_captured_leg(
          context: context, host: host,
          request: ModelBlobDigestsRequest {
            digests: spark_serving_manifest_required_digests(
              manifest_body: spark_serving_capture_stdout(c: manifest),
            ),
          },
        ),
      ],
    ),
  )
}

// THE ARGV IS DERIVED FROM THE LEG, NOT SUPPLIED BESIDE IT.
//
// While the mint took (leg, argv) as independent arguments, a capture could be MISLABELLED: running
// the linger argv and filing it under ProbeIsActive produced a perfectly well-formed capture that
// every downstream reader would trust, and no check anywhere could notice, because the label was the
// only claim about what ran. One authority maps leg to argv, and the capture mint reads it, so the
// label and the command are one fact rather than two that happen to agree.
//
// The blob-digest leg is the single leg whose argv depends on an earlier capture, so the mapping
// takes the manifest body it needs. That is a parameter of the ARGV, not a second naming scheme:
// every other leg ignores it.
fn spark_serving_probe_request_argv(request: SparkServingProbeRequest) -> List<String> {
  match request {
    LoadStateRequest => spark_serving_load_state_probe_words()
    IsActiveRequest => spark_serving_active_probe_words()
    VersionRequest => spark_serving_version_probe_words
    TagsRequest => spark_serving_tags_probe_words
    NvidiaDriverRequest => spark_serving_nvidia_driver_probe_words
    RuntimeReceiptRequest => spark_serving_runtime_materialization_receipt_probe_argv()
    ActiveEnterRequest => spark_serving_active_enter_probe_argv()
    DefaultTargetEnterRequest => spark_serving_default_target_enter_probe_argv()
    UptimeRequest => spark_serving_uptime_probe_argv()
    GrantsRequest => spark_serving_grant_probe_words
    PasswdRequest => spark_serving_account_probe_words()
    AuthorizedKeysRequest => spark_serving_authorized_keys_probe_words()
    LingerRequest => spark_serving_linger_probe_words()
    ModelManifestRequest => spark_serving_model_manifest_probe_argv()
    ModelBlobsListingRequest => spark_serving_model_blobs_listing_argv()
    ModelManifestDigestRequest => spark_serving_model_manifest_digest_argv()
    ModelBlobDigestsRequest { digests: hexes } =>
      spark_serving_model_blob_digest_argv(digest_hexes: hexes)
    UserUnitReadRequest => spark_serving_user_unit_read_argv()
    UserUnitIsEnabledRequest => spark_serving_user_unit_is_enabled_argv()
    RunningDefinitionRequest => spark_serving_running_definition_probe_argv()
    RuntimeRootRequest => spark_serving_runtime_root_probe_argv()
    RuntimeExecutableRequest => spark_serving_runtime_executable_probe_argv()
    RuntimeExecutableBitRequest => spark_serving_runtime_executable_bit_probe_argv()
    RuntimeRootListingRequest => spark_serving_runtime_root_listing_argv()
  }
}

// A REFUSED TRANSPORT IS RECORDED AS A REFUSAL, NOT AS A COMMAND THAT EXITED 127.
//
// The prerequisite arm is the blob-digest request with an empty digest population. The old builder
// produced a bare ["sha256sum"] there and executed it, which is not a request to verify zero named
// blob files -- it is a request to verify nothing, whose success would have been read as "every
// required blob verified" by a store classifier that asked how many failed.
fn spark_serving_captured_leg(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  request: SparkServingProbeRequest,
) -> SparkServingProbeLegCapture {
  spark_serving_probe_leg_capture_of(
    request: request,
    outcome: match spark_serving_request_prerequisite_refusal(request: request) {
      Present { value: cause } => SparkServingProbePrerequisiteRefused { cause: cause }
      Absent => spark_serving_run_probe_request(context: context, host: host, request: request)
    },
  )
}

// EVERY REQUEST ANSWERS THIS QUESTION, WHICH IS WHY THERE IS NO WILDCARD.
//
// The first cut wrote `_ => no prerequisite` beside the one arm that has one. That is non-fold
// residue -- the repository's own roster check found it -- and it is the kind that costs something
// real: a new request added tomorrow would silently inherit "nothing to check" from the wildcard,
// which is exactly how the bare-digest defect got in. Spelled out, the closed sum makes the compiler
// ask the question again every time the vocabulary grows.
fn spark_serving_request_prerequisite_refusal(
  request: SparkServingProbeRequest,
) -> NonEmptyStr? {
  match request {
    ModelBlobDigestsRequest { digests: hexes } =>
      if length(hexes) == 0 {
        Present {
          value: join([
            "the model manifest named no blob digests to verify, so there is no blob-digest",
            " command to run: executing a bare digest over an empty list would report every",
            " required blob verified by requiring none",
          ], "") as NonEmptyStr,
        }
      } else {
        none
      }
    LoadStateRequest => none
    IsActiveRequest => none
    VersionRequest => none
    TagsRequest => none
    NvidiaDriverRequest => none
    RuntimeReceiptRequest => none
    ActiveEnterRequest => none
    DefaultTargetEnterRequest => none
    UptimeRequest => none
    GrantsRequest => none
    PasswdRequest => none
    AuthorizedKeysRequest => none
    LingerRequest => none
    ModelManifestRequest => none
    ModelBlobsListingRequest => none
    ModelManifestDigestRequest => none
    UserUnitReadRequest => none
    UserUnitIsEnabledRequest => none
    RunningDefinitionRequest => none
    RuntimeRootRequest => none
    RuntimeExecutableRequest => none
    RuntimeExecutableBitRequest => none
    RuntimeRootListingRequest => none
  }
}

fn spark_serving_run_probe_request(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  request: SparkServingProbeRequest,
) -> SparkServingProbeOutcome {
  match run_typed_argv_transport(
    argv: spark_serving_probe_request_argv(request: request),
    transport: fleet_locus_transport(context: context, host: host),
  ) {
    TypedArgvExecConverged { result: r } => SparkServingProbeExecuted { result: r }
    TypedArgvExecRefused { reason: why } =>
      SparkServingProbeTransportRefused {
        cause: join(["transport refused the leg, it was never attempted: ", why], "") as NonEmptyStr,
      }
  }
}

fn spark_serving_probe_leg_via_locus(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  raw_words: List<String>,
) -> SshSessionExecResult? {
  match run_typed_argv_transport(
    argv: raw_words,
    transport: fleet_locus_transport(context: context, host: host),
  ) {
    TypedArgvExecConverged { result: r } => Present { value: r }
    TypedArgvExecRefused { reason: why } =>
      Present {
        value: SshSessionExecResult {
          exit_code: 127,
          success: false,
          stdout: "",
          stderr: join(["transport refused the leg, it was never attempted: ", why], ""),
        },
      }
  }
}

// EVERY FACT IN THIS OBSERVATION COMES OUT OF ONE TRANSACTION.
//
// The previous shape ran its own legs through the locus and then called three sub-observers, each of
// which reached for the OTHER adapter and ran more legs of its own. So a "locus observation" was a
// mixture of two credential paths, is_active was executed twice, and the number of times we touched
// the host was not readable from any value. Now acquisition is one call and everything below it is a
// pure read: no derivation in this function has a transport in scope to reach for.
fn spark_serving_observe_host_via_locus(
  context: FleetSshExecutionContext,
  host: HostIdentity,
) -> SparkServingHostObservation {
  match spark_serving_acquire_observation_transaction(
    context: context,
    host: host,
    phase: SparkServingReportObservation,
  ) {
    SparkServingTransactionRefused { refusal: r } =>
      spark_serving_host_observation_from_refused_transaction(refusal: r)
    SparkServingTransactionAdmitted { txn: txn } =>
      spark_serving_host_observation_from_transaction(txn: txn)
  }
}

// THE THREE SUB-OBSERVATIONS COME OUT OF ONE ACQUISITION, FOR THE SAME REASON THE READBACK DOES.
//
// The converge slice called the runtime, store and unit observers as three separate expressions, so
// planning a host opened three independent sets of SSH legs whose only relationship was the shared
// `host` argument -- and the unit observer among them re-ran is_active a fourth time. This is the
// one entry point for that trio: one transaction, four pure reads, and the refusal arm cannot be
// mistaken for empty observations.
//
// LINGER TRAVELS WITH THEM FOR THE SAME REASON. The slice ran its own loginctl leg through
// spark_serving_probe_linger and then acquired a transaction that captured ProbeLinger as well, so
// linger was read twice per host from two instants -- the same class as the is_active double read,
// reintroduced from the caller's side while the carrier was being built. One capture, one reader.
// IT HANDS BACK THE OBSERVATION, NOT FIVE LOOSE FACTS.
//
// The Ready arm used to carry runtime, store, unit, linger and provenance as five separate fields,
// and every caller immediately recombined them into a projection. That recombination was the fixture
// splice in production dress: five values that came from one transaction, travelling apart, free to
// be paired with a sixth that did not -- and the converge slice did exactly that, passing a
// provenance beside facts it rebuilt itself. One value travels now, and it is the carrier the rest
// of this module already projects, so there is nothing to recombine and nothing to mispair.
type SparkServingObservedFacts
  = SparkServingObservedFactsRefused { cause: NonEmptyStr }
  | SparkServingObservedFactsReady { observation: SparkServingHostObservation }

fn spark_serving_observed_facts_via_locus(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  phase: SparkServingObservationPhase,
) -> SparkServingObservedFacts {
  match spark_serving_acquire_observation_transaction(
    context: context,
    host: host,
    phase: phase,
  ) {
    SparkServingTransactionRefused { refusal: r } =>
      SparkServingObservedFactsRefused { cause: r.cause }
    SparkServingTransactionAdmitted { txn: txn } =>
      SparkServingObservedFactsReady {
        observation: spark_serving_host_observation_from_transaction(txn: txn),
      }
  }
}

// A REFUSED TRANSACTION IS NOT AN EMPTY OBSERVATION.
//
// Every field reads Unobserved rather than Absent: nothing was measured, and the difference between
// "we looked and found nothing" and "we never got a coherent look" is the whole subject of the
// unobserved arms downstream. The readback carries the cause so the refusal is located.
fn spark_serving_host_observation_from_refused_transaction(
  refusal: SparkServingTransactionRefusal,
) -> SparkServingHostObservation {
  spark_serving_host_observation(
    readback: spark_serving_readback_from_probe_results(
      host: refusal.request.host,
      load_state: none, is_active: none, version: none, tags: none, nvidia_driver: none,
      runtime_receipt: none, active_enter: none, default_target_enter: none, uptime: none,
      grants: none,
    ),
    account: spark_serving_account_observation_from_probes(passwd_probe: none, key_probe: none),
    runtime: RuntimeMaterializationObservationRefused { cause: refusal.cause },
    store: ModelStoreObservationRefused { cause: refusal.cause },
    observed_unit: SparkServingObservedUnit {
      state: UserUnitStateUnobserved,
      enablement: UserUnitManagerUnobserved,
      activity: UnitActivityUnobserved,
    },
    linger: LingerUnobservedState,
    provenance: spark_serving_refused_provenance_of(refusal: refusal),
  )
}

fn spark_serving_host_observation_from_transaction(
  txn: SparkServingObservationTransaction,
) -> SparkServingHostObservation {
  spark_serving_host_observation(
    readback: spark_serving_readback_from_probe_results(
      host: txn.request.host,
      load_state: spark_serving_transaction_result(txn: txn, leg: ProbeLoadState),
      is_active: spark_serving_transaction_result(txn: txn, leg: ProbeIsActive),
      version: spark_serving_transaction_result(txn: txn, leg: ProbeVersion),
      tags: spark_serving_transaction_result(txn: txn, leg: ProbeTags),
      nvidia_driver: spark_serving_transaction_result(txn: txn, leg: ProbeNvidiaDriver),
      runtime_receipt: spark_serving_transaction_result(txn: txn, leg: ProbeRuntimeReceipt),
      active_enter: spark_serving_transaction_result(txn: txn, leg: ProbeActiveEnter),
      default_target_enter: spark_serving_transaction_result(txn: txn, leg: ProbeDefaultTargetEnter),
      uptime: spark_serving_transaction_result(txn: txn, leg: ProbeUptime),
      grants: spark_serving_transaction_result(txn: txn, leg: ProbeGrants),
    ),
    account: spark_serving_account_observation_from_probes(
      passwd_probe: spark_serving_transaction_result(txn: txn, leg: ProbePasswd),
      key_probe: spark_serving_transaction_result(txn: txn, leg: ProbeAuthorizedKeys),
    ),
    runtime: spark_serving_runtime_materialization_from_transaction(txn: txn),
    store: spark_serving_model_store_from_transaction(txn: txn),
    observed_unit: spark_serving_user_unit_from_transaction(txn: txn),
    linger: spark_serving_observed_linger_from_probe(
      result: spark_serving_transaction_result(txn: txn, leg: ProbeLinger),
    ),
    provenance: spark_serving_transaction_provenance(txn: txn),
  )
}

fn spark_serving_unit_outcome_from_probe_results(
  load_state: SshSessionExecResult?,
  is_active: SshSessionExecResult?,
) -> SparkServingUnitProbeOutcome {
  match load_state {
    Absent =>
      SparkServingUnitObservationRefused {
        cause: "unit LoadState probe leg did not run" as NonEmptyStr,
      }
    Present { value: load } =>
      if load.success == false {
        SparkServingUnitObservationRefused {
          cause: join([
            "unit LoadState probe failed for ", spark_serving_unit_name,
            " exit=", to_string(load.exit_code),
            " stderr=", load.stderr,
          ], "") as NonEmptyStr,
        }
      } else if trim(s: load.stdout) == (systemd_unit_load_state_not_found_wire as String) {
        SparkServingUnitAbsent
      } else {
        match is_active {
          Absent =>
            SparkServingUnitObservationRefused {
              cause: "unit is-active probe leg did not run after LoadState observation" as NonEmptyStr,
            }
          Present { value: active } =>
            if active.success && trim(s: active.stdout) == "active" {
              SparkServingUnitActive
            } else if active.exit_code == 3 {
              SparkServingUnitInactive
            } else if active.success == false {
              SparkServingUnitObservationRefused {
                cause: join([
                  "unit is-active probe failed for ", spark_serving_unit_name,
                  " exit=", to_string(active.exit_code),
                  " stderr=", active.stderr,
                ], "") as NonEmptyStr,
              }
            } else {
              SparkServingUnitInactive
            }
        }
      }
  }
}

fn spark_serving_version_field_from_probe(probe: SshSessionExecResult?) -> SparkServingReadbackField {
  match probe {
    Absent =>
      SparkServingReadbackRefused {
        cause: "probe leg did not run" as NonEmptyStr,
      }
    Present { value: r } =>
      if r.success {
        spark_serving_parse_version_json(stdout: r.stdout)
      } else {
        SparkServingReadbackRefused {
          cause: join([
            "probe failed exit=", to_string(r.exit_code), " stderr=", r.stderr,
          ], "") as NonEmptyStr,
        }
      }
  }
}

fn spark_serving_tags_fields_from_probe(probe: SshSessionExecResult?) -> SparkServingTagsReadbackFields {
  match probe {
    Absent =>
      SparkServingTagsReadbackFields {
        model_name: SparkServingReadbackRefused {
          cause: "probe leg did not run" as NonEmptyStr,
        },
        model_tag: SparkServingReadbackRefused {
          cause: "probe leg did not run" as NonEmptyStr,
        },
        model_manifest_digest: SparkServingReadbackRefused {
          cause: "probe leg did not run" as NonEmptyStr,
        },
      }
    Present { value: r } =>
      if r.success {
        spark_serving_parse_tags_json(stdout: r.stdout)
      } else {
        SparkServingTagsReadbackFields {
          model_name: SparkServingReadbackRefused {
            cause: join([
              "probe failed exit=", to_string(r.exit_code), " stderr=", r.stderr,
            ], "") as NonEmptyStr,
          },
          model_tag: SparkServingReadbackRefused {
            cause: join([
              "probe failed exit=", to_string(r.exit_code), " stderr=", r.stderr,
            ], "") as NonEmptyStr,
          },
          model_manifest_digest: SparkServingReadbackRefused {
            cause: join([
              "probe failed exit=", to_string(r.exit_code), " stderr=", r.stderr,
            ], "") as NonEmptyStr,
          },
        }
      }
  }
}

fn spark_serving_unit_outcome_label(outcome: SparkServingUnitProbeOutcome) -> String {
  match outcome {
    SparkServingUnitActive => "active"
    SparkServingUnitInactive => "inactive"
    SparkServingUnitAbsent => "absent"
    SparkServingUnitObservationRefused { cause: _ } => "refused"
  }
}

fn spark_serving_nvidia_driver_field_from_probe(probe: SshSessionExecResult?) -> SparkServingReadbackField {
  match probe {
    Absent =>
      SparkServingReadbackRefused {
        cause: "probe leg did not run" as NonEmptyStr,
      }
    Present { value: r } =>
      if r.success {
        spark_serving_parse_nvidia_driver_version(stdout: r.stdout)
      } else {
        SparkServingReadbackRefused {
          cause: join([
            "probe failed exit=", to_string(r.exit_code), " stderr=", r.stderr,
          ], "") as NonEmptyStr,
        }
      }
  }
}

fn spark_serving_readback_from_probe_results(
  host: HostIdentity,
  load_state: SshSessionExecResult?,
  is_active: SshSessionExecResult?,
  version: SshSessionExecResult?,
  tags: SshSessionExecResult?,
  nvidia_driver: SshSessionExecResult?,
  runtime_receipt: SshSessionExecResult?,
  active_enter: SshSessionExecResult?,
  default_target_enter: SshSessionExecResult?,
  uptime: SshSessionExecResult?,
  grants: SshSessionExecResult?,
) -> SparkServingReadback {
  let tags_fields = spark_serving_tags_fields_from_probe(probe: tags)
  SparkServingReadback {
    host: host,
    unit_outcome: spark_serving_unit_outcome_from_probe_results(
      load_state: load_state,
      is_active: is_active,
    ),
    runtime_version: spark_serving_version_field_from_probe(probe: version),
    runtime_materialization_identity: spark_serving_materialization_receipt_field_from_probe(probe: runtime_receipt),
    model_name: tags_fields.model_name,
    model_tag: tags_fields.model_tag,
    model_manifest_digest: tags_fields.model_manifest_digest,
    nvidia_driver: spark_serving_nvidia_driver_field_from_probe(probe: nvidia_driver),
    bind_address: SparkServingReadbackAbsent,
    boot_provenance: spark_serving_boot_provenance_from_probes(
      active_enter: active_enter,
      default_target_enter: default_target_enter,
      uptime: uptime,
    ),
    grants: spark_serving_grant_outcome_from_probe(probe: grants),
  }
}

// A probe leg that never ran is UNOBSERVED, never a verdict that the unit failed to come up with the
// boot. Collapsing an absent leg into a durability failure would manufacture the exact finding this
// observation exists to report honestly.
fn spark_serving_boot_provenance_from_probes(
  active_enter: SshSessionExecResult?,
  default_target_enter: SshSessionExecResult?,
  uptime: SshSessionExecResult?,
) -> SparkServingBootProvenance {
  match active_enter {
    Absent => BootProvenanceUnobserved { cause: "ActiveEnterTimestampMonotonic probe leg did not run" as NonEmptyStr }
    Present { value: enter } =>
      match default_target_enter {
        Absent => BootProvenanceUnobserved { cause: "default.target ActiveEnterTimestampMonotonic probe leg did not run" as NonEmptyStr }
        Present { value: target } =>
          match uptime {
            Absent => BootProvenanceUnobserved { cause: "/proc/uptime probe leg did not run" as NonEmptyStr }
            Present { value: up } =>
              spark_serving_classify_boot_provenance(
                active_enter: enter,
                default_target_enter: target,
                uptime: up,
              )
          }
      }
  }
}

fn spark_serving_readback_line(readback: SparkServingReadback) -> String {
  join([
    "observe host=", readback.host as String,
    " unit_outcome=", spark_serving_unit_outcome_label(outcome: readback.unit_outcome),
    " runtime_version=", spark_serving_readback_field_label(field: readback.runtime_version),
    " runtime_materialization_identity=", spark_serving_readback_field_label(field: readback.runtime_materialization_identity),
    " model_name=", spark_serving_readback_field_label(field: readback.model_name),
    " model_tag=", spark_serving_readback_field_label(field: readback.model_tag),
    " model_digest=", spark_serving_readback_field_label(field: readback.model_manifest_digest),
    " nvidia_driver=", spark_serving_readback_field_label(field: readback.nvidia_driver),
    " ", spark_serving_boot_provenance_wire(p: readback.boot_provenance),
    "\n",
    spark_managed_grant_report(host: readback.host, outcome: readback.grants),
  ], "")
}

fn spark_serving_observation_line(observation: SparkServingObservation) -> String {
  match observation {
    SparkServingAbsent { host: h } => join(["observation host=", h as String, " state=absent\n"], "")
    SparkServingObservationRefused { host: h, cause: c } =>
      join(["observation host=", h as String, " state=refused cause=", c as String, "\n"], "")
    SparkServingObserved { host: h, loaded_release: r } =>
      join([
        "observation host=", h as String, " state=observed digest=",
        spark_serving_release_identity(spec: r).digest.digest as String, "\n",
      ], "")
  }
}

// THE DECLARED RETURN TYPE WAS WRONG AND NOTHING REFUSED. This read `-> SparkServingObservation`
// while the body returns a SparkServingHostObservation, and its only caller,
// spark_serving_observations_from_hosts, declares List<SparkServingHostObservation> -- so the two
// declarations contradicted each other across one call and the corpus typechecked clean. The runtime
// value was always the host observation, so nothing was ever wrong at execution; what was wrong is
// that the declaration lied to every reader, and a checker that later takes these seriously would
// have surfaced it as a mystery rather than a typo. Repaired in passing because this change adds a
// field to exactly that record.
// THE DIRECT-SSH OBSERVER IS DELETED, NOT KEPT BESIDE THE LOCUS ONE.
//
// spark_serving_observe_host ran the same twenty-odd legs as the locus observer through a different
// adapter -- ssh_session_exec_portable_words against a target this module shaped itself, rather than
// the transport the execution context carries. Two observers of one fact is the §3 violation, and it
// had the concrete consequence the ruling names: which credential path produced an observation was
// not a property of the observation, it was a property of which function the caller happened to
// reach for. The observe CLI now travels the same locus as the converge slice, so there is one
// answer to "how did we get in" and one place to change it.
fn spark_serving_observations_from_hosts(
  context: FleetSshExecutionContext,
  hosts: List<HostIdentity>,
) -> List<SparkServingHostObservation> {
  map(hosts, h => spark_serving_observe_host_via_locus(context: context, host: h))
}

// P0-C2: THE REPORT IS BUILT FROM AN IDENTITY JOIN, AND THE COUNT GUARD IS GONE RATHER THAN KEPT.
//
// What stood here refused only an EMPTY observation list, on the stated ground that empty is
// ignorance and not a clean fleet. That is true, and it was useless in the incident it was supposed
// to catch: the roster held {srv5}, which is not empty, so nothing fired while the one host that
// mattered went unprobed. A count cannot tell "every expected host answered" from "some other host
// answered instead" -- and fleet-converge run 33296910990 reported observed_hosts=1 with a green
// report.
//
// So the guard is REPLACED, not joined. Keeping both would be two authorities for one question, and
// the weaker one would keep answering first. Once an admitted nonempty expected scope and exact
// identity coverage both hold, nonemptiness is DERIVED -- there is nothing left for a cardinality
// check to add.
//
// THE EXPECTED SCOPE IS ADMITTED BEFORE THE JOIN, because an empty expected roster would make
// coverage vacuously true: no host is missing from a roster that demands nobody. That is the
// empty_observation_narrow failure wearing the join's clothes, so it refuses on its own arm with its
// own cause rather than passing through as Covered.
//
// WHAT THIS FUNCTION DOES NOT DECIDE. Coverage asks whether the required subject roster produced one
// result row per identity. It does NOT ask whether each probe answered -- that is
// spark_serving_report_observations_were_made, and the two are deliberately not one Bool. A row for
// srv6 carrying SparkServingAbsent SATISFIES coverage and is a genuine observation: the correct
// post-retirement state for a read-only instrument. A row carrying SparkServingObservationRefused
// also satisfies coverage while failing the observation terminal. Only a MISSING srv6 row refuses
// here, before any "fleet observed" report exists at all.
fn spark_serving_observed_host_keys(
  observations: List<SparkServingHostObservation>,
) -> List<HostIdentity> {
  map(observations, o => o.readback.host)
}

fn spark_serving_host_identity_words(hosts: List<HostIdentity>) -> String {
  if length(hosts) == 0 {
    "none"
  } else {
    join(map(hosts, h => h as String), ",")
  }
}

// THE ONLY RENDERER. Called at the receipt boundary, never by the constructor -- the report carries
// the identities and a reader turns them into words, not the other way round.
fn spark_serving_observation_refusal_wire(refusal: SparkServingObservationReportRefusal) -> NonEmptyStr {
  match refusal {
    SparkServingObservationScopeEmpty =>
      "spark serving observation scope is empty: coverage over an empty expected roster is vacuous, not clean" as NonEmptyStr
    SparkServingObservationPrerequisiteRefused { cause: c } => c
    SparkServingObservationCoverageIncomplete { missing: m, foreign: f, duplicated: d } =>
      join([
        "spark serving observation does not cover its physical scope: missing=",
        spark_serving_host_identity_words(hosts: m),
        " foreign=",
        spark_serving_host_identity_words(hosts: f),
        " duplicated=",
        spark_serving_host_identity_words(hosts: d),
      ], "") as NonEmptyStr
  }
}

fn spark_serving_observation_report_from_observations(
  expected: List<HostIdentity>,
  observations: List<SparkServingHostObservation>,
) -> SparkServingObservationReport {
  if length(expected) == 0 {
    SparkServingObservationReportRefused { refusal: SparkServingObservationScopeEmpty }
  } else {
    match spark_observation_coverage(
      expected: expected,
      observed: spark_serving_observed_host_keys(observations: observations),
    ) {
      SparkObservationIncomplete { missing: m, foreign: f, duplicated: d } =>
        SparkServingObservationReportRefused {
          refusal: SparkServingObservationCoverageIncomplete {
            missing: m,
            foreign: f,
            duplicated: d,
          },
        }
      SparkObservationCovered =>
        SparkServingObservationsProduced {
          first: observations.first(),
          more: observations.skip(n: 1),
        }
    }
  }
}

// The hosts probed and the hosts EXPECTED are the same roster here by construction, which is the
// property that makes this entry's coverage meaningful rather than circular: the caller passes the
// physical scope once, and a probe that fails to produce a row for one of them is exactly what the
// join catches.
fn spark_serving_observe_with_context(
  context: FleetSshExecutionContext,
  hosts: List<HostIdentity>,
) -> SparkServingObservationReport {
  spark_serving_observation_report_from_observations(
    expected: hosts,
    observations: spark_serving_observations_from_hosts(context: context, hosts: hosts),
  )
}

// ONE RENDERER FOR A HOST OBSERVATION, because there were two and that is why this change did not
// appear in the receipt the first time it ran. The per-host lines were joined by hand in
// spark_serving_observation_report_text AND again in spark_serving_observe_ci_with_context, so
// adding a line to one left the other silently short -- and the CI entry is the one that actually
// runs against the fleet. A second copy of a rendering is the section 3 fork; it was found by
// executing the path rather than by reading it, which is the whole argument for running the thing.
// ONE RENDERER FOR THE BODY OF A REPORT, and the previous fix on this exact seam is why this one
// exists. Extracting spark_serving_host_observation_lines unified the PER-HOST join and left the
// REPORT-LEVEL assembly still forked in two places -- so the fleet standing, which is a
// report-level fact, was derived correctly, rendered by spark_serving_observation_report_text, and
// silently absent from the receipt the CI entry actually writes. Found by running it, again.
//
// The lesson the first fix missed: unifying the inner join does not unify the outer one. A fork is
// closed at the grain of the fact being added, and a report-level fact needs the report-level
// assembly to have a single owner. Both callers now prepend their own header -- which genuinely
// differ, one carrying a materialization receipt and the other a credential locus -- to this one
// body.
fn spark_serving_report_body_lines(report: SparkServingObservationReport) -> String {
  join(
    concat(
      match report {
        SparkServingObservationReportRefused { refusal: _ } => []
        SparkServingObservationsProduced { first: f, more: m } =>
          map(concat([f], m), ho => spark_serving_host_observation_lines(ho: ho))
      },
      [spark_serving_current_boot_durability_line(
        standing: spark_serving_current_boot_durability_standing(report: report),
      )],
    ),
    "",
  )
}

// THE RECEIPT CARRIES ITS ACQUISITION, NOT ONLY ITS CONCLUSIONS.
//
// These three lines describe what was concluded and say nothing about the observation they came
// from, so a reader could not tell a host measured under one credential locus in one attempt from a
// value assembled some other way. The provenance line is what a canary reads to establish that every
// fact in the report belongs to one acquisition.
fn spark_serving_host_observation_lines(ho: SparkServingHostObservation) -> String {
  join([
    spark_serving_provenance_receipt_line(p: ho.provenance),
    spark_serving_readback_line(readback: ho.readback),
    spark_serving_observation_line(observation: ho.observation),
    spark_serving_account_line(host: ho.readback.host, account: ho.account),
  ], "")
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// CURRENT-BOOT DURABILITY STANDING
// ═══════════════════════════════════════════════════════════════════════════════════════
//
// WHAT THIS ANSWERS, and it is narrower than "is the fleet durable": does THIS BOOT, on the
// hosts we just observed, exhibit the auto-start property. Nothing here remembers a past
// proof; remembering one needs a receipt that outlives its run, and no such carrier exists
// (the durability receipt is written under target/, which is gitignored and worktree-local).
// That half is deliberately not built rather than faked with a field.
//
// WHY THERE IS NO PER-HOST STANDING TYPE, because the obvious design is a nickname. A
// four-state per-host coproduct -- exhibited / not-exhibited / unit-not-active / unobserved --
// maps ONE-TO-ONE onto SparkServingBootProvenance's four variants. That is a second name for
// one concept, which DESIGN section 3 forbids and which costs twice over because everything
// derived from it forks too. The per-host fact already has an authority and a wire rendering;
// what did NOT exist is the FLEET aggregate, and an aggregate over N hosts is genuinely new
// information rather than a rename of one host's state.
//
// IT ALSO GIVES AN ORPHANED ORACLE ITS FIRST CONSUMER.
// spark_serving_boot_provenance_establishes_durability had zero production callers -- only its
// own witness imported it. A predicate nothing asks is a verdict with no consumer: it can be
// correct forever and change nothing, and it cannot rot loudly because nothing depends on it.
// This routes the fleet verdict through it rather than re-deciding which provenance states
// count, so the "only UnitStartedByManagerAtBoot establishes durability" rule stays in one
// place.
//
// THE THREE STATES ARE NOT THREE FLAVOURS OF FAILURE. Exhibited-on-every-observed-host,
// measured-and-some-do-not, and nothing-observed have different remedies: the second is a real
// property of this boot, the third is a coverage gap. Collapsing them is the state-space
// conflation that has cost this lane a module already. And NotExhibited does NOT mean durability
// FAILED -- a unit started after boot is most likely one our own convergence run started, so the
// auto-start property is not disproven, it is simply not exercised by this boot. The variant is
// named for what was measured, not for a verdict it cannot support.
//
// THAT CAUTION IS NOT HYPOTHETICAL. Measured 2026-08-22 (run 32543249175), both converged hosts
// classify UnitStartedAfterBoot because they entered active ~10.6s into a boot 28 HOURS old,
// against a fitted 10s window -- 6% over, on two independent hosts, which is a wrong constant
// rather than two hand starts. So this standing will report not-exhibited on a fleet whose real
// durability is UNDETERMINED. That is honest only because the variant and its wire both say what
// the probe failed to establish rather than what the fleet failed to do; the underlying
// classification is fixed by replacing the window constant with a relation, which is separate
// work and is not done here.
type SparkServingCurrentBootDurabilityStanding
  = CurrentBootDurabilityExhibitedFleetWide { observed_hosts: Int }
  | CurrentBootDurabilityNotExhibited { exhibiting: Int, observed_hosts: Int }
  | CurrentBootDurabilityUnobserved { cause: NonEmptyStr }

fn spark_serving_host_exhibits_current_boot_durability(ho: SparkServingHostObservation) -> Bool {
  spark_serving_boot_provenance_establishes_durability(p: ho.readback.boot_provenance)
}

fn spark_serving_current_boot_durability_standing(
  report: SparkServingObservationReport,
) -> SparkServingCurrentBootDurabilityStanding {
  match report {
    SparkServingObservationReportRefused { refusal: r } =>
      CurrentBootDurabilityUnobserved { cause: spark_serving_observation_refusal_wire(refusal: r) }
    SparkServingObservationsProduced { first: f, more: m } => {
      let hosts = concat([f], m)
      let observed = length(hosts)
      let exhibiting = fold(hosts, init: 0, f: fn(acc, ho) {
        if spark_serving_host_exhibits_current_boot_durability(ho: ho) { acc + 1 } else { acc }
      })
      if exhibiting == observed {
        CurrentBootDurabilityExhibitedFleetWide { observed_hosts: observed }
      } else {
        CurrentBootDurabilityNotExhibited { exhibiting: exhibiting, observed_hosts: observed }
      }
    }
  }
}

// THE WIRE SAYS "not-exhibited-this-boot", never "failed". A reader who sees this line in a
// receipt and reports "durability failed on srv6" would be asserting something the measurement
// does not support, and that mis-reading is exactly what this standing exists to stop.
fn spark_serving_current_boot_durability_line(
  standing: SparkServingCurrentBootDurabilityStanding,
) -> String {
  match standing {
    CurrentBootDurabilityExhibitedFleetWide { observed_hosts: n } =>
      join([
        "current-boot-durability=exhibited observed_hosts=", to_string(n),
        " -- every observed host's unit came up WITH this boot\n",
      ], "")
    CurrentBootDurabilityNotExhibited { exhibiting: e, observed_hosts: n } =>
      join([
        "current-boot-durability=not-exhibited-this-boot exhibiting=", to_string(e),
        " observed_hosts=", to_string(n),
        " -- this probe does not establish auto-start on every observed host; NOT a finding that durability failed\n",
      ], "")
    CurrentBootDurabilityUnobserved { cause: c } =>
      join([
        "current-boot-durability=unobserved cause=", c as String,
        " -- nobody looked; this is a coverage gap, not a property of the fleet\n",
      ], "")
  }
}

// THE STANDING IS RENDERED ON BOTH ARMS, not merely derivable, and both halves of that are
// deliberate. A verdict nothing prints is the orphaned-oracle shape this standing exists to fix
// one level down -- it would be a poor joke to reproduce it here. And the REFUSED arm carries it
// too, because "nobody looked" is a STATE of the standing rather than the absence of one:
// printing the line only on the success path would leave an unobserved fleet silently
// indistinguishable from one nobody had asked about, which is the empty-observation narrow.
fn spark_serving_observation_report_text(
  report: SparkServingObservationReport,
  probed_at: String,
  attempt_raw: String,
  materialization_receipt: String,
) -> String {
  match report {
    SparkServingObservationReportRefused { refusal: r } =>
      join([
        "spark serving observe probed_at=", probed_at,
        " attempt_raw=", attempt_raw, "\n",
        materialization_receipt,
        "REFUSED: ", spark_serving_observation_refusal_wire(refusal: r) as String, "\n",
        spark_serving_report_body_lines(report: report),
      ], "")
    SparkServingObservationsProduced { first: _, more: _ } =>
      join([
        join(["spark serving observe probed_at=", probed_at, " attempt_raw=", attempt_raw, "\n"], ""),
        materialization_receipt,
        spark_serving_report_body_lines(report: report),
      ], "")
  }
}

fn spark_serving_observation_succeeded(observation: SparkServingObservation) -> Bool {
  match observation {
    SparkServingObserved { host: _, loaded_release: _ } => true
    SparkServingAbsent { host: _ } => false
    SparkServingObservationRefused { host: _, cause: _ } => false
  }
}

fn spark_serving_all_observations_succeeded(observations: List<SparkServingObservation>) -> Bool {
  fold_list(
    xs: observations,
    empty: true,
    cons: fn(acc, obs) {
      acc && spark_serving_observation_succeeded(observation: obs)
    },
  )
}

// THIS IS A ROLE QUESTION, AND IT IS NO LONGER THE OBSERVER'S TERMINAL.
//
// "Did every host answer" and "is every host serving" are different questions, and this one answers
// the second: SparkServingAbsent counts as failure here. That was harmless while the observation
// roster was the DESIRED roster, because a desired host that is absent genuinely is a fault. Once the
// roster became the physical Spark population it stopped being harmless -- a RETIRED training cell is
// structurally SparkServingAbsent, so a successful retirement would make this report "unsuccessful"
// and drive the workstation observer to exit non-zero on the exactly-correct final state. Fail-closed,
// but the wrong answer for an instrument whose job is to describe what is there.
//
// Both observer entries therefore terminate on spark_serving_report_observations_were_made, which asks
// whether the probe answered. A serving-health verdict over the DESIRED subset is a separate consumer
// that judges srv5 and ignores srv6 by policy; it is not written yet, and this row is retained for it
// rather than deleted.
//
// THE TERMINAL SWAP BELOW HAS EVIDENCE, AND THAT EVIDENCE DOES NOT EXECUTE.
//
// spark_serving_observe_witness_test already pins the exact distinction this repair turns on -- it
// asserts was_made(obs) is true while succeeded(obs) is false for an absent host -- so the control is
// authored and discriminating. It is also inert: that module is test.claim.spark.*, outside the
// required gate closure, so it has never run in CI. An attempt to restate the claim under the executed
// v2.test.* prefix was made and abandoned on measurement, not preference: importing this module to
// reach these two predicates pulls its 46-import closure and the claim module is killed during resolve
// with no rows, the same wall that holds the 59 nonterminal identities.
//
// CORRECTION (P0-C2): the sentence that stood here said editing that inert module would classify its
// witnesses as changed-and-declined and red the required floor, and therefore that the predicates
// could not be moved. That is no longer true and was already false when it merged. #9728 landed
// PlannedAsChangedWitness, which seeds changed-witness modules into preparation EVEN WHEN THEY SIT
// OUTSIDE THE FLOOR ROSTER, so an edit to a test.claim.spark.* module now executes in the required
// sublane rather than being automatically declined -- measured on this lane, standing
// planned-and-passed. The enrollment argument for leaving the predicates where they are has
// dissolved; the resolve-cost argument above has not, and it is the one that still holds.
//
// So the honest standing of the swap is: correct by argument, controlled by an authored claim, and
// NOT established by execution. It is recorded here rather than in a commit message because a reader
// of this function is the person who needs to know it.
//
// RETAINED, NOT KEPT: by the trimming rule applied elsewhere in this stack, a row whose only consumers
// are its own claims should be deleted until a real consumer exists. The reason recorded here used to
// be an enrollment gap -- that editing test.claim.spark.* would classify its witnesses as changed-and-
// declined and red the floor. #9728 dissolved that gap (see the correction above), so it is no longer
// what blocks the deletion. What blocks it now is that this predicate answers the ROLE question --
// "is every observed host serving" -- which is a real question P0 has not finished asking, and which
// is deliberately NOT the coverage question the report constructor above now decides.
fn spark_serving_observation_report_succeeded(report: SparkServingObservationReport) -> Bool {
  match report {
    SparkServingObservationsProduced { first: f, more: m } =>
      spark_serving_observation_succeeded(observation: f.observation)
        && spark_serving_all_observations_succeeded(observations: map(m, ho => ho.observation))
    SparkServingObservationReportRefused { refusal: _ } => false
  }
}

// A read-only observation entry answers "did the probe reach every host", NOT "is the fleet
// converged". SparkServingAbsent is a genuine observation of a host that is reachable and bare,
// so reading it as a failed probe would conflate a working instrument with a broken one;
// SparkServingObservationRefused is the probe failing to answer at all, and refuses. This axis is
// deliberately weaker than spark_serving_observation_succeeded, which the converge entries use
// because there absence means the desired state was not reached.
fn spark_serving_observation_was_made(observation: SparkServingObservation) -> Bool {
  match observation {
    SparkServingObserved { host: _, loaded_release: _ } => true
    SparkServingAbsent { host: _ } => true
    SparkServingObservationRefused { host: _, cause: _ } => false
  }
}

fn spark_serving_all_observations_were_made(observations: List<SparkServingObservation>) -> Bool {
  fold_list(
    xs: observations,
    empty: true,
    cons: fn(acc, obs) {
      acc && spark_serving_observation_was_made(observation: obs)
    },
  )
}

fn spark_serving_report_observations_were_made(report: SparkServingObservationReport) -> Bool {
  match report {
    SparkServingObservationsProduced { first: f, more: m } =>
      spark_serving_observation_was_made(observation: f.observation)
        && spark_serving_all_observations_were_made(observations: map(m, ho => ho.observation))
    SparkServingObservationReportRefused { refusal: _ } => false
  }
}

func spark_serving_observe_wet() -> ProcessExit
  uses net: Network
{
  match fleet_ssh_attempt_raw_from_env() {
    Absent =>
      exit_failure(
        reason: "spark_serving_observe_wet requires GUNBC_FLEET_SSH_ATTEMPT_RAW or GitHub GITHUB_RUN_ID+GITHUB_RUN_ATTEMPT env"
      )
    Present { value: attempt_raw } => spark_serving_observe_with_attempt(attempt_raw: attempt_raw)
  }
}

func spark_serving_observe_with_attempt(attempt_raw: String) -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  run_with_materialized_fleet_ssh_binding(
    attempt_raw: attempt_raw,
    token_source: GcloudPrintToken,
    body: fn(credential) {
      let report = match fleet_ssh_attempt_identity(raw: attempt_raw) {
        Absent =>
          SparkServingObservationReportRefused {
            refusal: SparkServingObservationPrerequisiteRefused {
              cause: "attempt identity is not a safe path segment" as NonEmptyStr,
            },
          }
        Present { value: attempt } => {
          let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
          match fleet_ssh_execution_context_of(outcome: materialization, credential: credential) {
            Absent =>
              SparkServingObservationReportRefused {
                refusal: SparkServingObservationPrerequisiteRefused {
                  cause: known_hosts_materialization_receipt(outcome: materialization) as NonEmptyStr,
                },
              }
            Present { value: context } =>
              spark_serving_observe_with_context(
                context: context,
                hosts: spark_serving_observation_scope(),
              )
          }
        }
      }
      let materialization_receipt = match fleet_ssh_attempt_identity(raw: attempt_raw) {
        Absent => ""
        Present { value: attempt } =>
          known_hosts_materialization_receipt(
            outcome: materialize_fleet_known_hosts_anchor(attempt: attempt),
          )
      }
      let receipt = spark_serving_observation_report_text(
        report: report,
        probed_at: probed_at_word(reading: now) as String,
        attempt_raw: attempt_raw,
        materialization_receipt: materialization_receipt,
      )
      if spark_serving_report_observations_were_made(report: report) == false {
        exit_failure(reason: receipt)
      } else {
        let w = Filesystem.Write(path: spark_serving_observe_receipt_path, content: receipt)
        if w.success {
          ExitSuccess
        } else {
          exit_failure(reason: join(["spark serving observe receipt write failed: ", w.error], ""))
        }
      }
    },
  )
}

// RUNNER-SIDE OBSERVATION ENTRY. spark_serving_observe_wet above resolves a credential through
// GcloudPrintToken and is therefore an operator-workstation route only; a GHA self-hosted slot
// carries no gcloud and that fetch fails at runtime rather than degrading. This entry observes
// through the in-run ssh-agent the job already materialized, so the same probe legs run where
// the fleet actually is. It is READ-ONLY: every word list here is a query.
func spark_serving_observe_ci_wet() -> ProcessExit {
  match prepare_fleet_ssh_agent_context(attempt_raw: spark_serving_observe_ci_attempt_raw) {
    FleetSshContextRefused { cause: cause } => exit_failure(reason: cause)
    FleetSshContextReady { context: context, receipt: context_receipt } =>
      spark_serving_observe_ci_with_context(context: context, context_receipt: context_receipt)
  }
}

// The attempt this entry owns. It names the entry rather than a run, because the anchor and selector
// paths it scopes live under target/ in a workspace one job owns.
data spark_serving_observe_ci_attempt_raw: String = "spark-serving-observe-ci"

func spark_serving_observe_ci_with_context(
  context: FleetSshExecutionContext,
  context_receipt: String,
) -> ProcessExit {
  let now = clock_now_probed_at()
  let observations = map(
    spark_serving_observation_scope(),
    h => spark_serving_observe_host_via_locus(context: context, host: h),
  )
  let report = spark_serving_observation_report_from_observations(
    expected: spark_serving_observation_scope(),
    observations: observations,
  )
  let body = join([
    join(["spark_serving_observe_ci_wet probed_at=", probed_at_word(reading: now) as String, "\n"], ""),
    join(["credential_locus=", fleet_locus_label(context: context), "\n"], ""),
    context_receipt,
    spark_serving_report_body_lines(report: report),
  ], "")
  let w = Filesystem.Write(path: spark_serving_observe_ci_receipt_path, content: body)
  if w.success == false {
    exit_failure(reason: join(["receipt write failed: ", w.error], ""))
  } else if spark_serving_report_observations_were_made(report: report) == false {
    exit_failure(
      reason: join(
        ["spark_serving_observe_ci_wet: at least one host could not be observed\n", body],
        "",
      ),
    )
  } else {
    ExitSuccess
  }
}

// ── Observing the user unit, on the same SSH legs as everything else ────────────────────────────

// systemd's `is-enabled` answers with a WORD on stdout and an exit code, and the two disagree in a
// way that matters: a disabled unit exits non-zero while printing "disabled", which is a successful
// observation of a real state. Reading only the exit code would render that as a failed probe, so
// the word is what is classified and the exit code only distinguishes "we could not ask".
fn classify_is_enabled_stdout(result: SshSessionExecResult) -> SparkServingUnitManagerState {
  let word = trim(s: result.stdout)
  if word == "enabled" || word == "enabled-runtime" {
    UserUnitManagerEnabled
  } else if word == "disabled" {
    UserUnitManagerDisabled
  } else if word == "not-found" {
    UserUnitManagerNotRegistered
  } else {
    UserUnitManagerUnobserved
  }
}

// A `cat` that fails because the file is missing is ABSENCE; a `cat` that fails for any other reason
// is an unobserved member. systemd's own message is not available here, so the discriminator is the
// exit code GNU coreutils uses for a missing operand target alongside a stderr naming the path --
// and where neither holds, the honest answer is unobserved rather than a guess at absence.
fn cat_reported_missing_file(result: SshSessionExecResult) -> Bool {
  string_contains(result.stderr, "No such file or directory")
}

// BOTH FACTS FROM ONE PAIR OF PROBES. The unit's content and its enablement are separate resources
// and reconcile against separate addresses, but they come from the same two remote legs -- so they
// are read once and returned together rather than by two callers each paying the round trips again.
type SparkServingObservedUnit {
  state: SparkServingObservedUnitState
  enablement: SparkServingUnitManagerState
  activity: SparkServingObservedActivityState
}

// `systemctl --user is-active` and nothing else decides this, and it answers in THREE definite ways
// before it answers in none. Exit 0 with "active" is running. Exit 3 is systemd's documented answer
// for a unit that exists and is not running. Exit 4 is "no such unit" -- equally definite, and the
// arm whose absence blocked first provisioning: folded into Unobserved, a host with nothing
// installed read as a host we had failed to measure, so the plan refused instead of installing.
//
// Every OTHER outcome does leave the activity unobserved, and that arm is still load-bearing: a
// manager we could not reach has not told us the unit is dead, and planning a start on that silence
// would actuate off a probe that never answered.
fn classify_is_active_result(result: SshSessionExecResult) -> SparkServingObservedActivityState {
  if result.success && trim(s: result.stdout) == "active" {
    UnitActivityRunning
  } else if result.exit_code == 3 {
    UnitActivityStopped
  } else if result.exit_code == 4 {
    UnitActivityNoSuchUnit
  } else if result.success {
    UnitActivityStopped
  } else {
    UnitActivityUnobserved
  }
}

// WHICH DEFINITION THE RUNNING INVOCATION WAS STARTED FROM is a separate observation from unit
// activity. `is-active` establishes only running/not-running; this carrier joins that answer to the
// identity read from the process selected by MainPID. Keeping the subjects separate prevents an
// active process from becoming "current" merely because its file or the manager's loaded definition
// advanced after exec.
fn spark_serving_running_definition_from_probe_results(
  is_active: SshSessionExecResult?,
  running_definition: SshSessionExecResult?,
) -> SparkServingRunningDefinition {
  match is_active {
    Absent => RunningDefinitionUnobserved {
      cause: "unit activity probe did not run, so no running invocation can be selected" as NonEmptyStr,
    }
    Present { value: active } =>
      if active.success && trim(s: active.stdout) == "active" {
        match running_definition {
          Absent => RunningDefinitionUnobserved {
            cause: "unit is active but the running-definition probe did not run" as NonEmptyStr,
          }
          Present { value: definition } =>
            if definition.success && trim(s: definition.stdout) == "absent" {
              RunningDefinitionUnstamped
            } else if definition.success && starts_with(s: trim(s: definition.stdout), prefix: "present:") {
              let wire = trim(s: definition.stdout)
              let identity = substring(s: wire, start: 8, end: length(wire))
              if identity == "" {
                RunningDefinitionUnobserved {
                  cause: "running process carried an empty definition identity" as NonEmptyStr,
                }
              } else {
                RunningDefinitionObserved { definition_identity: identity as NonEmptyStr }
              }
            } else {
              RunningDefinitionUnobserved {
                cause: join([
                  "running-definition probe refused exit=", to_string(definition.exit_code),
                  " stderr=", definition.stderr,
                ], "") as NonEmptyStr,
              }
            }
        }
      } else if active.exit_code == 3 || active.exit_code == 4 || active.success {
        RunningDefinitionNotRunning
      } else {
        RunningDefinitionUnobserved {
          cause: join([
            "unit activity probe refused exit=", to_string(active.exit_code),
            " stderr=", active.stderr,
          ], "") as NonEmptyStr,
        }
      }
  }
}

fn spark_serving_running_definition_from_transaction(
  txn: SparkServingObservationTransaction,
) -> SparkServingRunningDefinition {
  spark_serving_running_definition_from_probe_results(
    is_active: spark_serving_transaction_result(txn: txn, leg: ProbeIsActive),
    running_definition: spark_serving_transaction_result(txn: txn, leg: ProbeRunningDefinition),
  )
}

// THE MODEL STORE PRODUCER -- the evidence behind the model-slot member.
//
// TWO LEGS, AND THE SECOND IS THE ONE THAT MATTERS. The manifest leg answers whether the reference
// resolves to anything at all; the blob leg answers whether the bytes it names are actually there.
// A check that stopped at the manifest would report a store as installed when an interrupted pull
// left the manifest written and layers missing -- a host that looks converged and cannot serve a
// token, which is precisely the state a long, interruptible pull produces.
//
// THE BLOB CLOSURE IS READ FROM THE MANIFEST, NOT ASSUMED. The manifest lists its layers by digest,
// so the set of blobs to require is upstream's answer rather than ours; deriving it from the model
// reference would be inventing a fact the store already carries.
//
// The counting leg is deliberately a single argv rather than one probe per blob: a model has many
// layers, and paying a remote round trip each would make observation cost scale with model size for
// a fact one command answers. `grep -o` over the manifest yields the digests, and the comparison is
// against what the blobs directory holds.
//
// WHAT THIS DOES NOT ESTABLISH: that the blobs are INTACT. Presence is a filename fact; a truncated
// layer has the right name. Verifying each blob's digest is a further rung this producer does not
// reach, and `ModelStoreComplete` is documented as meaning present-and-named, not verified.
fn spark_serving_model_manifest_probe_argv() -> List<String> {
  ["cat", spark_serving_desired_model_manifest_path() as String]
}

fn spark_serving_model_blobs_listing_argv() -> List<String> {
  ["ls", "-A", spark_serving_desired_model_blobs_dir() as String]
}

// BLOB CONTENTS, NOT BLOB NAMES -- and the distinction is the whole no-repull law.
//
// The listing above establishes that a file with the expected name exists. It establishes nothing
// about what is IN it, and a truncated or corrupted blob keeps its name: an interrupted pull, a full
// disk, a partially written layer all leave a correctly-named file. Reporting that store complete
// suppresses MaterializeModelArtifact, so the repair for a corrupt model is exactly the operation the
// observation prevents. That is a fail-open whose failure mode is a host that can never self-heal.
//
// Ollama names each blob for its own sha256, so the expected value travels WITH the file and needs
// no separate manifest at compare time: hashing the blob and comparing to the hex in its own name is
// the integrity check, self-describing and read-only. Observation must not mutate, which rules out
// writing a checksum document on the target the way the installer legitimately does.
//
// THE COST IS REAL AND IS NOT HIDDEN. This hashes the full closure -- gigabytes -- on every
// observation, and that is the honest price of the claim on a first canary. The cheaper steady-state
// reading is immutability plus a previously admitted receipt, and that is an evidence-frequency
// POLICY with its own carrier and its own decision, not something to arrive at by quietly checking
// names and calling it complete. Until such a policy exists, this pays the cost.
// The argv needs the required digests before the classifier runs, so the decode happens once here and
// once inside the classifier. A decode that refuses yields an EMPTY argv list, which makes sha256sum
// read no files and produce no lines -- and the classifier then refuses on its own decode, so the
// empty case cannot be mistaken for "every blob verified".
fn spark_serving_manifest_required_digests(manifest_body: String) -> List<NonEmptyStr> {
  match spark_serving_manifest_decode(body: manifest_body) {
    SparkServingManifestDigests { first: f, further: r } => concat([f], r)
    SparkServingManifestUnparseable => []
    SparkServingManifestMalformed { detail: _ } => []
    SparkServingManifestNamesNoBlobs => []
  }
}

fn spark_serving_model_blob_digest_argv(digest_hexes: List<NonEmptyStr>) -> List<String> {
  concat(
    ["sha256sum"],
    map(digest_hexes, h => join([
      spark_serving_desired_model_blobs_dir() as String,
      "/",
      ollama_blob_file_name(digest_hex: h) as String,
    ], "")),
  )
}

// Each `sha256sum` line is "<hex>  <path>". A blob is intact when the computed hex equals the hex
// its own filename carries; anything else -- a short read, a rewritten layer, a name that does not
// match its bytes -- is a mismatch, and the FIRST one is reported rather than a count, because an
// operator repairs a named blob and not a number.
fn spark_serving_first_corrupt_blob(stdout: String, expected: List<NonEmptyStr>) -> NonEmptyStr? {
  fold(expected, init: none, f: fn(acc, want) {
    match acc {
      Present { value: found } => Present { value: found }
      Absent =>
        if any(
          split(trim(s: stdout), "\n"),
          line =>
            string_contains(line, ollama_blob_file_name(digest_hex: want) as String)
              && trim(s: split(trim(s: line), " ")[0]) == (want as String),
        ) {
          none
        } else {
          Present { value: want }
        }
    }
  })
}

// THE MANIFEST'S BLOB CLOSURE, DECODED BY THE JSON PARSER RATHER THAN SCANNED FOR.
//
// A `grep -o sha256:[0-9a-f]*` over the body would find the same digests today and would also find
// any digest that appeared anywhere for any reason -- in an annotation, a media type, a field this
// decoder does not model. Reading the structure the manifest actually declares is the difference
// between knowing which blobs are REQUIRED and knowing which hex strings are present in a file.
//
// An OCI-shaped manifest carries `config` (one descriptor) and `layers` (many). Both are blobs the
// store must hold, and omitting the config is the kind of gap that shows up as a model that pulls
// forever because one always-missing blob is never counted.
// A DECODE VERDICT, NOT A BARE LIST. An empty list answered for three different things -- the body
// did not parse, a key was duplicated, the manifest genuinely named nothing -- and all three then
// refused with the same cause, which would tell an operator "names no blob digests" about a file
// that is in fact unparseable. The refusal was already fail-closed; what was wrong was the sentence
// it produced, and a diagnostic that misdescribes the fault sends the reader to the wrong place.
type SparkServingManifestDecode
  = SparkServingManifestDigests { first: NonEmptyStr, further: List<NonEmptyStr> }
  | SparkServingManifestUnparseable
  | SparkServingManifestMalformed { detail: NonEmptyStr }
  | SparkServingManifestNamesNoBlobs

fn spark_serving_manifest_decode(body: String) -> SparkServingManifestDecode {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: _ } => SparkServingManifestUnparseable
    JsonDocumentParsed { value: doc } =>
      match spark_serving_manifest_descriptor_lists(doc: doc) {
        SparkServingManifestMalformed { detail: d } => SparkServingManifestMalformed { detail: d }
        SparkServingManifestUnparseable => SparkServingManifestUnparseable
        SparkServingManifestNamesNoBlobs => SparkServingManifestNamesNoBlobs
        SparkServingManifestDigests { first: f, further: r } =>
          SparkServingManifestDigests { first: f, further: r }
      }
  }
}

fn spark_serving_manifest_descriptor_lists(doc: JsonValue) -> SparkServingManifestDecode {
  match spark_serving_manifest_config_digest(doc: doc) {
    SparkServingManifestMalformed { detail: d } => SparkServingManifestMalformed { detail: d }
    SparkServingManifestUnparseable => SparkServingManifestUnparseable
    SparkServingManifestDigests { first: _, further: _ } =>
      spark_serving_manifest_join_layers(
        doc: doc,
        config: spark_serving_manifest_digest_list(v: spark_serving_manifest_config_digest(doc: doc)),
      )
    SparkServingManifestNamesNoBlobs =>
      spark_serving_manifest_join_layers(doc: doc, config: [])
  }
}

fn spark_serving_manifest_join_layers(
  doc: JsonValue,
  config: List<NonEmptyStr>,
) -> SparkServingManifestDecode {
  match spark_serving_manifest_layer_digests(doc: doc) {
    SparkServingManifestMalformed { detail: d } => SparkServingManifestMalformed { detail: d }
    SparkServingManifestUnparseable => SparkServingManifestUnparseable
    SparkServingManifestNamesNoBlobs =>
      match config.first() {
        Absent => SparkServingManifestNamesNoBlobs
        Present { value: h } => SparkServingManifestDigests { first: h, further: config.skip(n: 1) }
      }
    SparkServingManifestDigests { first: lf, further: lr } => {
      let all = concat(config, concat([lf], lr))
      match all.first() {
        Absent => SparkServingManifestNamesNoBlobs
        Present { value: h } => SparkServingManifestDigests { first: h, further: all.skip(n: 1) }
      }
    }
  }
}

fn spark_serving_manifest_digest_list(v: SparkServingManifestDecode) -> List<NonEmptyStr> {
  match v {
    SparkServingManifestDigests { first: f, further: r } => concat([f], r)
    SparkServingManifestUnparseable => []
    SparkServingManifestMalformed { detail: _ } => []
    SparkServingManifestNamesNoBlobs => []
  }
}

// A DESCRIPTOR WITHOUT A USABLE DIGEST IS MALFORMED, NOT EMPTY. A layer entry that carries no
// digest, carries two, or carries one this decoder cannot read means the manifest is not the shape
// upstream documents -- and treating it as "this layer requires nothing" would quietly shrink the
// required closure, which is the direction that reports a store complete when it is not.
fn spark_serving_descriptor_digest(v: JsonValue) -> SparkServingManifestDecode {
  match json_object_unique_member(v: v, key: "digest") {
    JsonMemberFound { value: d } =>
      match spark_serving_digest_hex_from_wire(wire: json_string_value_or_empty(v: d)) {
        Absent =>
          SparkServingManifestMalformed {
            detail: "a descriptor digest is not a readable sha256 wire value" as NonEmptyStr,
          }
        Present { value: hex } => SparkServingManifestDigests { first: hex, further: [] }
      }
    JsonMemberAbsent =>
      SparkServingManifestMalformed {
        detail: "a descriptor carries no digest" as NonEmptyStr,
      }
    JsonMemberDuplicated { count: _ } =>
      SparkServingManifestMalformed {
        detail: "a descriptor carries more than one digest" as NonEmptyStr,
      }
    JsonMemberNotAnObject =>
      SparkServingManifestMalformed {
        detail: "a descriptor is not an object" as NonEmptyStr,
      }
  }
}

// `sha256:<hex>` is the WIRE spelling. The on-disk file is `sha256-<hex>`, and conflating the two is
// how a consumer ends up looking for a file that exists on no host. The prefix is stripped here so
// the digest travels as its hex alone and each side spells it its own way.
fn spark_serving_digest_hex_from_wire(wire: String) -> NonEmptyStr? {
  let parts = split(wire, ":")
  if length(parts) == 2 && parts[0] == "sha256" {
    match parts[1] {
      Present { value: hex } =>
        if hex != "" { Present { value: hex as NonEmptyStr } } else { none }
      Absent => none
    }
  } else {
    none
  }
}

fn spark_serving_manifest_config_digest(doc: JsonValue) -> SparkServingManifestDecode {
  match json_object_unique_member(v: doc, key: "config") {
    JsonMemberFound { value: cfg } => spark_serving_descriptor_digest(v: cfg)
    JsonMemberAbsent => SparkServingManifestNamesNoBlobs
    JsonMemberDuplicated { count: _ } =>
      SparkServingManifestMalformed { detail: "manifest carries more than one config" as NonEmptyStr }
    JsonMemberNotAnObject =>
      SparkServingManifestMalformed { detail: "manifest is not an object" as NonEmptyStr }
  }
}

fn spark_serving_manifest_layer_digests(doc: JsonValue) -> SparkServingManifestDecode {
  match json_object_unique_member(v: doc, key: "layers") {
    JsonMemberFound { value: layers } =>
      match layers {
        JsonArray { elements: els } =>
          fold(els, init: SparkServingManifestNamesNoBlobs, f: fn(acc, el) {
            match acc {
              SparkServingManifestMalformed { detail: d } =>
                SparkServingManifestMalformed { detail: d }
              SparkServingManifestUnparseable => SparkServingManifestUnparseable
              SparkServingManifestNamesNoBlobs => spark_serving_descriptor_digest(v: el)
              SparkServingManifestDigests { first: f, further: r } =>
                match spark_serving_descriptor_digest(v: el) {
                  SparkServingManifestMalformed { detail: d } =>
                    SparkServingManifestMalformed { detail: d }
                  SparkServingManifestUnparseable => SparkServingManifestUnparseable
                  SparkServingManifestNamesNoBlobs =>
                    SparkServingManifestDigests { first: f, further: r }
                  SparkServingManifestDigests { first: nf, further: nr } =>
                    SparkServingManifestDigests {
                      first: f,
                      further: concat(r, concat([nf], nr)),
                    }
                }
            }
          })
        JsonObject { members: _ } =>
          SparkServingManifestMalformed { detail: "manifest layers is not an array" as NonEmptyStr }
        JsonString { value: _ } =>
          SparkServingManifestMalformed { detail: "manifest layers is not an array" as NonEmptyStr }
        JsonNumber { lexeme: _ } =>
          SparkServingManifestMalformed { detail: "manifest layers is not an array" as NonEmptyStr }
        JsonBool { value: _ } =>
          SparkServingManifestMalformed { detail: "manifest layers is not an array" as NonEmptyStr }
        JsonNull =>
          SparkServingManifestMalformed { detail: "manifest layers is not an array" as NonEmptyStr }
      }
    JsonMemberAbsent => SparkServingManifestNamesNoBlobs
    JsonMemberDuplicated { count: _ } =>
      SparkServingManifestMalformed { detail: "manifest carries more than one layers key" as NonEmptyStr }
    JsonMemberNotAnObject =>
      SparkServingManifestMalformed { detail: "manifest is not an object" as NonEmptyStr }
  }
}

fn spark_serving_blob_file_name_for(digest_hex: NonEmptyStr) -> String {
  ollama_blob_file_name(digest_hex: digest_hex)
}

// THE IDENTITY IS READ, NOT COMPUTED THIS SIDE, AND THE FAMILY IS WHY.
//
// An earlier revision identified the observed manifest with content_hash_atom over the bytes -- an
// fnv1a64 structural digest. Desired carries `ModelArtifact.identity`, which comes off an ollama
// model digest and is therefore Sha256. Comparing them does not yield "different"; it yields
// ContentHashCrossFamilyIncomparable, so the model member could never have converged and the plan
// could never have emptied. The cross-family wall was doing its job -- what was wrong was minting an
// identity in whichever family happened to be convenient at the observation site.
//
// So the host computes it, in the family desired already speaks.
//
// VERIFIED BY THE srv6 CANARY, 2026-08-19, AND IT HOLDS. That sha256 of the manifest file equals the
// digest `/api/tags` reports was stated here as an unverified upstream property, with its failure
// named -- a member reconciling as drift forever -- and this canary nominated as what would decide
// it. Both mechanisms were then measured against the same live store on srv6 and answered the same
// value, 17052f91a42e97930aa6e28a6c6c06a983e6a58dbb00434885a0cf5313e376f7. The property stands and
// the sha256sum leg is a sound way to read this identity.
//
// A CORRECTION IS RECORDED HERE BECAUSE THIS FILE BRIEFLY CLAIMED THE OPPOSITE. An earlier revision
// of this comment declared the assumption refuted and rerouted the identity through /api/tags. That
// conclusion came from comparing the observed value against the DECLARED desired digest and blaming
// the difference on the mechanism, without ever measuring the second mechanism. The two mechanisms
// never disagreed. What disagrees is the declaration and the host, and rerouting the observation
// could not have touched that -- it only changed the format, since the API returns bare hex where
// serialize_content_hash emits the sha256: form, which would have made the member unconvergeable on
// spelling even had the values matched.
//
// THE DISAGREEMENT IS RESOLVED AND WAS NOT THIS FUNCTION'S TO SETTLE. It was a declaration problem:
// desired state pinned the identity the tag resolved to on 2026-08-12, upstream republished, and the
// pin then named bytes the tag no longer served. The operator re-selected on 2026-08-19 and desired
// state now consumes gunbc.ollama_model_resolution, which records the reference, the resolved
// identity, when, and the three readings behind it. Nothing about the observation changed, which was
// the point of the correction above.
fn spark_serving_model_manifest_digest_argv() -> List<String> {
  ["sha256sum", spark_serving_desired_model_manifest_path() as String]
}

fn spark_serving_model_store_from_transaction(
  txn: SparkServingObservationTransaction,
) -> ModelStoreObservation {
  match spark_serving_transaction_result(txn: txn, leg: ProbeModelManifest) {
    Absent =>
      ModelStoreObservationRefused {
        cause: "model manifest probe leg did not run" as NonEmptyStr,
      }
    Present { value: manifest } =>
      if manifest.success == false {
        if cat_reported_missing_file(result: manifest) {
          ModelStoreAbsent
        } else {
          ModelStoreObservationRefused {
            cause: join([
              "model manifest unreadable exit=", to_string(manifest.exit_code),
              " stderr=", manifest.stderr,
            ], "") as NonEmptyStr,
          }
        }
      } else {
        match spark_serving_transaction_result(txn: txn, leg: ProbeModelBlobsListing) {
          Absent =>
            ModelStoreObservationRefused {
              cause: "model blob listing leg did not run, so a complete manifest cannot be told from a complete store" as NonEmptyStr,
            }
          Present { value: blobs } =>
            if blobs.success == false {
              ModelStoreObservationRefused {
                cause: join([
                  "model blob listing failed exit=", to_string(blobs.exit_code),
                  " stderr=", blobs.stderr,
                ], "") as NonEmptyStr,
              }
            } else {
              match spark_serving_transaction_result(txn: txn, leg: ProbeModelManifestDigest) {
                Absent =>
                  ModelStoreObservationRefused {
                    cause: "model manifest digest leg did not run, and an identity this side invented would not be comparable to the desired one" as NonEmptyStr,
                  }
                Present { value: digest } =>
                  if digest.success == false {
                    ModelStoreObservationRefused {
                      cause: join([
                        "model manifest digest failed exit=", to_string(digest.exit_code),
                        " stderr=", digest.stderr,
                      ], "") as NonEmptyStr,
                    }
                  } else {
                    match spark_serving_transaction_result(txn: txn, leg: ProbeModelBlobDigests) {
                      Absent =>
                        ModelStoreObservationRefused {
                          cause: "model blob digest leg did not run, so blob contents were never verified" as NonEmptyStr,
                        }
                      Present { value: blobdigests } =>
                        spark_serving_classify_model_store(
                          manifest_body: manifest.stdout,
                          manifest_digest_stdout: digest.stdout,
                          blobs_listing: blobs.stdout,
                          blob_digest_stdout: blobdigests.stdout,
                        )
                    }
                  }
              }
            }
        }
      }
  }
}

// A MANIFEST THAT PARSES TO NO LAYERS IS A REFUSAL, NOT AN EMPTY STORE. A readable file naming zero
// blobs means either the manifest is not the shape this decoder expects or upstream changed it, and
// answering "complete with zero blobs" to either would be the emptiest possible fabrication: every
// blob it requires is present because it requires none.
fn spark_serving_classify_model_store(
  manifest_body: String,
  manifest_digest_stdout: String,
  blobs_listing: String,
  blob_digest_stdout: String,
) -> ModelStoreObservation {
  let present = split(trim(s: blobs_listing), "\n")
  match spark_serving_manifest_decode(body: manifest_body) {
    SparkServingManifestUnparseable =>
      ModelStoreObservationRefused {
        cause: "model manifest is not parseable JSON" as NonEmptyStr,
      }
    SparkServingManifestMalformed { detail: d } =>
      ModelStoreObservationRefused {
        cause: join(["model manifest is malformed: ", d as String], "") as NonEmptyStr,
      }
    SparkServingManifestNamesNoBlobs =>
      ModelStoreObservationRefused {
        cause: "model manifest names no blob digests — refusing rather than reporting a store complete against an empty requirement" as NonEmptyStr,
      }
    SparkServingManifestDigests { first: rf, further: rr } => {
      let required = concat([rf], rr)
      let observed_identity = spark_serving_sha256sum_identity(stdout: manifest_digest_stdout)
      let missing = fold(required, init: [], f: fn(acc, want) {
        if any(present, p => trim(s: p) == spark_serving_blob_file_name_for(digest_hex: want)) {
          acc
        } else {
          concat(acc, [want])
        }
      })
      match observed_identity {
        Absent =>
          ModelStoreObservationRefused {
            cause: "sha256sum output is not a readable sha256 hex digest" as NonEmptyStr,
          }
        Present { value: ident } =>
          match missing.first() {
            Absent =>
              match spark_serving_first_corrupt_blob(stdout: blob_digest_stdout, expected: required) {
                Present { value: bad } =>
                  ModelStoreCorrupt { manifest_identity: ident, first_corrupt_blob: bad }
                Absent =>
                  ModelStoreComplete {
                    manifest_identity: ident,
                    blob_closure_count: length(required),
                  }
              }
            Present { value: head } =>
              ModelStoreIncomplete {
                manifest_identity: ident,
                first_missing_blob: head,
                further_missing_blobs: missing.skip(n: 1),
              }
          }
      }
    }
  }
}

// is_active IS READ FROM THE SAME CAPTURE THE READBACK READS.
//
// This observer used to run spark_serving_active_probe_words() itself, so every host was asked
// whether the unit was active TWICE, at two instants, and a readback saying active beside a unit
// saying inactive was a perfectly ordinary value that no consumer could tell from a real transition.
// One capture, two readers.
fn spark_serving_user_unit_from_transaction(
  txn: SparkServingObservationTransaction,
) -> SparkServingObservedUnit {
  match spark_serving_transaction_result(txn: txn, leg: ProbeUserUnitRead) {
    Absent =>
      SparkServingObservedUnit {
        state: UserUnitStateUnobserved,
        enablement: UserUnitManagerUnobserved,
        activity: UnitActivityUnobserved,
      }
    Present { value: read } =>
      match spark_serving_transaction_result(txn: txn, leg: ProbeUserUnitIsEnabled) {
        Absent =>
          SparkServingObservedUnit {
            state: UserUnitStateUnobserved,
            enablement: UserUnitManagerUnobserved,
            activity: UnitActivityUnobserved,
          }
        Present { value: enabled } =>
          match spark_serving_transaction_result(txn: txn, leg: ProbeIsActive) {
            Absent =>
              SparkServingObservedUnit {
                state: classify_observed_user_unit(
                  read_succeeded: read.success,
                  read_stdout: read.stdout,
                  file_absent: cat_reported_missing_file(result: read),
                ),
                enablement: classify_is_enabled_stdout(result: enabled),
                activity: UnitActivityUnobserved,
              }
            Present { value: active } =>
              SparkServingObservedUnit {
                state: classify_observed_user_unit(
                  read_succeeded: read.success,
                  read_stdout: read.stdout,
                  file_absent: cat_reported_missing_file(result: read),
                ),
                enablement: classify_is_enabled_stdout(result: enabled),
                activity: classify_is_active_result(result: active),
              }
          }
      }
  }
}

// THE RUNTIME MATERIALIZATION PRODUCER -- the evidence behind the runtime-root member.
//
// This is what makes `RuntimeMaterializationObservation` a fact rather than a vocabulary. Until it
// existed every `Complete` in the tree was caller-authored, and the runtime member was projected
// from `/api/version` joined with the archive-admission receipt -- a pair that proves a process
// answered and an archive was once admitted, and says nothing about the tree on disk.
//
// THE LEGS ARE `test`, WHICH ANSWERS BY EXIT CODE. That matters for the refusal boundary: a leg that
// did not run at all yields `none` from the probe and REFUSES the observation, while a leg that ran
// and exited nonzero is a successful measurement of a negative. Collapsing those would let an
// unreachable host report a bare runtime and select a full materialization from ignorance.
//
// The order is root, then executable, then executable bit, and each answers a different question
// with a different remedy. It stops at the first negative because the later legs are not meaningful
// past it -- asking whether a missing file is executable has no answer worth carrying.
//
// The listing leg is CONDITIONAL and runs only when the root exists but the executable does not: an
// empty root and a populated-but-wrong root are different failures (an interrupted extraction versus
// a wrong recipe or a wrong release), and without it both would report as one missing executable.
// It costs a fourth remote leg only on hosts that are already broken.
//
// NOT YET IN THIS PRODUCER, named rather than implied: the completion receipt and the local
// executable's own reported version. Both belong here -- an extraction that finished and an
// executable that IS the release the identity names are separate facts from the file merely being
// present and +x -- and neither is observed yet, so `Complete` still means "the expected executable
// is in the expected place and is executable", not "the tree is the one the identity names".
fn spark_serving_runtime_root_probe_argv() -> List<String> {
  ["test", "-d", spark_serving_required_runtime_root() as String]
}

fn spark_serving_runtime_executable_probe_argv() -> List<String> {
  ["test", "-f", spark_serving_required_runtime_executable_path() as String]
}

fn spark_serving_runtime_executable_bit_probe_argv() -> List<String> {
  ["test", "-x", spark_serving_required_runtime_executable_path() as String]
}

fn spark_serving_runtime_root_listing_argv() -> List<String> {
  ["ls", "-A", spark_serving_required_runtime_root() as String]
}

fn spark_serving_required_runtime_executable_rel() -> NonEmptyStr {
  ollama_required_release.executable_relative_path
}

fn spark_serving_classify_runtime_executable_absence(
  listing: SshSessionExecResult?,
) -> RuntimeMaterializationObservation {
  let identity = ollama_runtime_materialization_identity_for_required_release()
  match listing {
    Absent =>
      RuntimeMaterializationObservationRefused {
        cause: "runtime root listing leg did not run, so an empty root cannot be told from a populated one" as NonEmptyStr,
      }
    Present { value: ls } =>
      if ls.success == false {
        RuntimeMaterializationObservationRefused {
          cause: join([
            "runtime root listing failed exit=", to_string(ls.exit_code), " stderr=", ls.stderr,
          ], "") as NonEmptyStr,
        }
      } else {
        if (ls.stdout as String).trim() == "" {
          RuntimeMaterializationIncomplete {
            identity: identity,
            first_defect: RuntimeRootPresentButEmpty,
            further_defects: [],
          }
        } else {
          RuntimeMaterializationIncomplete {
            identity: identity,
            first_defect: RuntimeExecutableMissing {
              expected_relative_path: spark_serving_required_runtime_executable_rel(),
            },
            further_defects: [],
          }
        }
      }
  }
}

// THE RECEIPT LEG, which is what stops an arbitrary executable reading as an installed closure.
//
// The install sequence writes this file last, after digest admission, extraction, the entrypoint
// check and publication, so its presence is the one on-disk fact that covers the steps a directory
// listing cannot see. Reading it is the difference between "something executable is at the expected
// path" and "the closure this path names was installed by a sequence that completed".
//
// IT READS THE CONTENT, NOT JUST EXISTENCE. The installer writes the materialization identity into
// this file, so `cat` plus a comparison establishes that the receipt names THE PLANNED closure --
// where `test -f` established only that some receipt was there. A receipt left by a previous
// materialization at a different identity is exactly the case that matters: the content-addressed
// root makes that unlikely by construction, and an observation that cannot tell the difference is
// still one that would be believed if it happened.
fn spark_serving_runtime_materialization_receipt_probe_argv() -> List<String> {
  ["cat", spark_serving_required_runtime_receipt_path() as String]
}

// TERMINAL SERVING HEALTH, OBSERVED. Two legs, in order: the version endpoint says the runtime that
// answers is the planned one, and the generate endpoint says it can actually serve the planned model.
//
// A leg that did not run yields the EMPTY capture rather than a fabricated body, and the health fold
// renders that as `ServingHealthUnobserved` -- so an unreachable endpoint reports as unobserved, not
// as unhealthy. The distinction matters because the two have different next steps: unhealthy means
// investigate the host, unobserved means the probe never got an answer to judge.
// THE PROBE CARRIES ITS OWN REQUEST BODY, and this is a repair with a receipt. The body was written
// by the model-materialization sequence, so it existed only on a host where the model had just been
// materialized -- and the moment srv5's membership converged, that sequence stopped running and the
// probe went back to failing with curl exit 26 on a host that was serving perfectly. A precondition
// of a read that is produced by an unrelated write is a precondition that disappears exactly when
// everything else starts working.
//
// It is not a seventh membership member either: the body is scratch a read needs, not declared host
// state anyone reconciles toward. It is deterministic -- the same bytes from the same authority on
// every run -- so writing it before each probe is idempotent setup, not a failure arm that widens.
//
// The write refusing does NOT fabricate a health verdict: the probe then reads nothing, the capture
// is empty, and the fold says unobserved. A body we could not place and a server that did not answer
// are both "we did not learn", which is the honest arm for either.
// THE PLACEMENT RESULT IS CONSUMED, not discarded. Its failure used to be invisible: the binding was
// `let _prepared = ...`, execution continued, curl was handed `--data @<a file that is not there>`,
// and the resulting empty capture decoded as "the endpoint answered its version but served nothing".
// So OUR OWN failed scratch write was reported as the model serving nothing.
//
// With nothing to ask WITH, asking is NOT-APPLICABLE rather than unobserved -- a different arm, not a
// rename of the same one -- so this refuses before either probe runs and names the placement as the
// cause.
fn spark_serving_observe_terminal_health(
  context: FleetSshExecutionContext,
  host: HostIdentity,
) -> SparkServingTerminalHealth {
  if spark_serving_place_health_request_body(context: context, host: host) == false {
    ServingHealthUnobserved {
      cause: "the health request body was not placed on the host, so no generation probe was issued -- this is a defect on the OBSERVING side and says nothing about whether the host serves" as NonEmptyStr,
    }
  } else {
    spark_serving_health_from_captures(
      version: spark_serving_probe_capture(
        context: context, host: host, raw_words: spark_serving_health_version_probe_argv(),
      ),
      generate: spark_serving_probe_capture(
        context: context, host: host, raw_words: spark_serving_health_generate_probe_argv(),
      ),
    )
  }
}

// A capture that distinguishes never-ran from ran-and-failed from ran-and-answered. The old
// `spark_serving_probe_stdout_or_empty` mapped the first two onto the third's empty case, which is
// the empty-observation narrow: a non-zero exit is a REAL observation from the far side, and
// recording it as silence loses the one fact that says whose problem it is.
// RESIDENCY IS OBSERVED ONLY THROUGH A CONVERGED VERDICT, and the signature is what enforces it:
// spark_serving_residency_from_capture takes a SparkServingServedProof, whose sole constructor is
// the converged arm of spark_serving_served_proof. So an unhealthy or unobserved host has nothing
// to pass and this function cannot ask the question at all -- it answers ResidencyUnobserved with
// the reason being the HEALTH verdict, not a failed probe.
//
// That ordering is a data dependency rather than a convention: /api/ps reports what is resident
// NOW, so it answers "where did the generation run" only within keep_alive of a generation we
// actually issued. Asking it of a host that never generated returns a true fact about an
// unrelated moment.
fn spark_serving_observe_residency(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  health: SparkServingTerminalHealth,
) -> SparkServingResidency {
  match spark_serving_served_proof(health: health) {
    Absent =>
      ResidencyUnobserved {
        cause: "no generation was proven on this host, so nothing anchors a residency read to a moment we caused" as NonEmptyStr,
      }
    Present { value: proof } =>
      spark_serving_residency_from_capture(
        proof: proof,
        capture: spark_serving_probe_capture(
          context: context, host: host, raw_words: spark_serving_health_ps_probe_argv(),
        ),
      )
  }
}

fn spark_serving_probe_capture(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  raw_words: List<String>,
) -> SparkServingProbeCapture {
  match spark_serving_probe_leg_via_locus(context: context, host: host, raw_words: raw_words) {
    Absent =>
      ProbeNeverRan {
        cause: "the probe leg did not execute: no transport result was produced" as NonEmptyStr,
      }
    Present { value: r } =>
      if r.success {
        ProbeAnswered { stdout: r.stdout }
      } else {
        ProbeFailed { exit_code: r.exit_code, stderr: r.stderr }
      }
  }
}

// Placing the body is two ordinary legs -- make the directory, write the bytes -- through the same
// typed file write every other remote write uses, so the path is admitted for containment and
// far-side portability rather than trusted.
func spark_serving_place_health_request_body(
  context: FleetSshExecutionContext,
  host: HostIdentity,
) -> Bool
  uses net: Network
{
  let made = spark_serving_probe_leg_via_locus(
    context: context,
    host: host,
    raw_words: ["mkdir", "-p", spark_serving_readiness_scratch_root() as String],
  )
  match made {
    Absent => false
    Present { value: m } =>
      if m.success == false {
        false
      } else {
        match typed_remote_file_write_seal(
          path: spark_serving_health_request_body_path(),
          content: spark_serving_health_request_body(),
          allowed_scope: FileTreeScope { root_path: spark_serving_executor_home as NonEmptyStr },
        ) {
          TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
          TypedRemoteFileWriteAdmitted { write: w } =>
            remote_execution_permits_continuation(
              execution: spark_serving_run_operation(
                operation: RemoteFileBytes { write: w, mode: RemoteFileModeOwnerReadWrite },
                transport: fleet_locus_transport(context: context, host: host),
              ),
            )
        }
      }
  }
}

// A FAILED LEG IS AN EMPTY CAPTURE, NOT A MISSING ONE. `curl -fsS` exits nonzero on an HTTP error and
// writes nothing useful, so returning its stdout regardless would hand the decoder an error page to
// interpret. Empty is the honest input: it decodes to unobserved.
fn spark_serving_runtime_materialization_from_transaction(
  txn: SparkServingObservationTransaction,
) -> RuntimeMaterializationObservation {
  let identity = ollama_runtime_materialization_identity_for_required_release()
  match spark_serving_transaction_result(txn: txn, leg: ProbeRuntimeRoot) {
    Absent =>
      RuntimeMaterializationObservationRefused {
        cause: "runtime root probe leg did not run" as NonEmptyStr,
      }
    Present { value: root } =>
      if root.success == false {
        RuntimeMaterializationAbsent
      } else {
        match spark_serving_transaction_result(txn: txn, leg: ProbeRuntimeExecutable) {
          Absent =>
            RuntimeMaterializationObservationRefused {
              cause: "runtime executable probe leg did not run" as NonEmptyStr,
            }
          Present { value: exe } =>
            if exe.success == false {
              spark_serving_classify_runtime_executable_absence(
                listing: spark_serving_transaction_result(txn: txn, leg: ProbeRuntimeRootListing),
              )
            } else {
              match spark_serving_transaction_result(txn: txn, leg: ProbeRuntimeExecutableBit) {
                Absent =>
                  RuntimeMaterializationObservationRefused {
                    cause: "runtime executable-bit probe leg did not run" as NonEmptyStr,
                  }
                Present { value: bit } =>
                  if bit.success == false {
                    RuntimeMaterializationIncomplete {
                      identity: identity,
                      first_defect: RuntimeExecutableNotExecutable {
                        expected_relative_path: spark_serving_required_runtime_executable_rel(),
                      },
                      further_defects: [],
                    }
                  } else {
                    match spark_serving_transaction_result(txn: txn, leg: ProbeRuntimeReceipt) {
                      Absent =>
                        RuntimeMaterializationObservationRefused {
                          cause: "runtime materialization receipt probe leg did not run" as NonEmptyStr,
                        }
                      Present { value: receipt } =>
                        if receipt.success == false {
                          RuntimeMaterializationIncomplete {
                            identity: identity,
                            first_defect: RuntimeMaterializationReceiptMissing,
                            further_defects: [],
                          }
                        } else if trim(s: receipt.stdout) != (identity.digest as String) {
                          RuntimeMaterializationIncomplete {
                            identity: identity,
                            first_defect: RuntimeMaterializationReceiptIdentityMismatch {
                              observed: trim(s: receipt.stdout) as NonEmptyStr,
                            },
                            further_defects: [],
                          }
                        } else {
                          RuntimeMaterializationComplete { identity: identity }
                        }
                    }
                  }
              }
            }
        }
      }
  }
}

// ONE OBSERVATION IN, ONE PROJECTION OUT.
//
// The production caller was invoking the probe pair TWICE -- once for .state and once for
// .enablement -- which paid four remote legs and, worse, could join content read at one moment with
// enablement read at another. Two facts about one unit taken from two different observations is not
// an observation of that unit. This takes the bound pair so the join is structural.
fn spark_serving_observed_members_for_unit(
  host: HostIdentity,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  observed_unit: SparkServingObservedUnit,
  linger: SparkServingObservedLingerState,
  provenance: SparkServingObservationProvenance,
) -> SparkServingObservedMemberProjection {
  spark_serving_observed_members(
    provenance: provenance,
    host: host,
    runtime: runtime,
    store: store,
    unit: observed_unit.state,
    enablement: observed_unit.enablement,
    activity: observed_unit.activity,
    linger: linger,
  )
}

// `sha256sum` prints "<hex>  <path>". Only the hex is taken, and it must parse as a real sha256 --
// a truncated or error-shaped line refuses rather than becoming an identity nothing can compare.
fn spark_serving_sha256sum_identity(stdout: String) -> NonEmptyStr? {
  match split(trim(s: stdout), " ").first() {
    Absent => none
    Present { value: hex } =>
      match sha256_hex_digest(hex: trim(s: hex)) {
        Absent => none
        Present { value: d } =>
          Present {
            value: serialize_content_hash(hash: as_content_hash_cryptographic(digest: d)) as NonEmptyStr,
          }
      }
  }
}
