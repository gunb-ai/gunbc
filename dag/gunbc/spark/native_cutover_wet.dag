// ── ONE OPERATOR-REACHABLE ROOT THAT OWNS THE WHOLE TRANSACTION ────────────────────────────────
//
// Every value this performs comes from the model: the host population and rank assignment from the launch
// plan, the argv from the checkpoint and runtime rows, the endpoint from the fleet roster, the acceptance
// criterion from the readback assessor, the rollback target from the launch fold's retained started
// population. Nothing is parsed from a rendered table and nothing is chosen by whoever invokes it.
//
// THE FIRST THING IT DOES IS ASK WHETHER THE WORK IS ALREADY DONE. A cutover invoked twice must not stop an
// incumbent that is no longer serving or relaunch four containers that are already right, so the readback
// runs BEFORE any authorisation or any destructive step. Idempotence here is not a convenience: the second
// invocation is exactly the one a person makes after being interrupted, when they least know the state.
//
// AND THE CLAIM IS A DURABLE COMPARE-AND-SET, NOT A FLAG. `set -C` makes the shell refuse to truncate an
// existing file, so creating the claim file either succeeds because no other attempt holds it or fails
// because one does -- an atomic test-and-set against a durable object on the head host. A second actor
// running this root while the first is mid-transaction is refused before it stops anything.

data native_claim_path: NonEmptyStr = "/home/briansrls/acq/glm-native-cutover.claim" as NonEmptyStr

// THE ATTEMPT IDENTITY IS MINTED PER ATTEMPT AND IS NOT DECORATION. It is the authorisation subject the
// durable claim carries, and it is the same token every device-memory observation is stamped with -- so a
// reading taken under a previous attempt refuses as RankEnvelopeStaleAttempt rather than being believed
// about a machine whose containers have since been removed. Reusing one across attempts would make both of
// those checks vacuous at exactly the moment they matter, which is a retry after a failure.
//
// -4 IS THE FIRST ATTEMPT UNDER THE RESOLVED ENVELOPE. Attempts 1 through 3 launched against a fraction
// derived from total capacity; this is a different plan built from observed supply, so it is a different
// subject and not a repeat of the same one.
data native_attempt_raw: String = "glm-native-tp4-cutover-4"

// THE READINESS BUDGET IS UPSTREAM'S FIGURE FOR THIS MODEL, and the poll interval is chosen so the budget
// is spent in observations rather than in one long blind wait.
data native_ready_poll_budget: Nat = 240
data native_ready_poll_interval_seconds: Nat = 15

type NativeCutoverTerminal
  = NativeAlreadyConverged { receipt: NonEmptyStr }
  | NativeCutoverWithheld { reasons: List<NonEmptyStr> }
  | NativeServing { receipt: NonEmptyStr, probe: NonEmptyStr }
  | NativeFailedAndIncumbentRestored {
      failure: NonEmptyStr,
      cleanup: List<RankRollbackOutcome>,
      incumbent: IncumbentRestoredReceipt,
    }
  | NativeFailedAndIncumbentLost {
      failure: NonEmptyStr,
      cleanup: List<RankRollbackOutcome>,
      restoration_failure: NonEmptyStr,
    }

fn terminal_text(t: NativeCutoverTerminal) -> String {
  match t {
    NativeAlreadyConverged { receipt: r } =>
      join(["ALREADY CONVERGED, nothing was touched: ", r as String], "")
    NativeCutoverWithheld { reasons: rs } =>
      join(["WITHHELD before acting: ", join(map(rs, x => x as String), "; ")], "")
    NativeServing { receipt: r, probe: p } =>
      join(["SERVING and accepted: ", r as String, " -- probe: ", p as String], "")
    NativeFailedAndIncumbentRestored { failure: f, cleanup: cs, incumbent: inc } =>
      join([
        "FAILED and the incumbent is back: ", f as String,
        " -- cleanup: ", join(map(cs, c => rank_rollback_text(o: c)), "; "),
        " -- incumbent ", inc.container_id as String, " answers ", inc.endpoint_status as String,
      ], "")
    NativeFailedAndIncumbentLost { failure: f, cleanup: cs, restoration_failure: rf } =>
      join([
        "FAILED AND THE INCUMBENT IS DOWN -- this is an outage needing a person: ", f as String,
        " -- cleanup: ", join(map(cs, c => rank_rollback_text(o: c)), "; "),
        " -- restoration: ", rf as String,
      ], "")
  }
}

fn terminal_is_success(t: NativeCutoverTerminal) -> Bool {
  match t {
    NativeServing { receipt: _, probe: _ } => true
    NativeAlreadyConverged { receipt: _ } => true
    NativeCutoverWithheld { reasons: _ } => false
    NativeFailedAndIncumbentRestored { failure: _, cleanup: _, incumbent: _ } => false
    NativeFailedAndIncumbentLost { failure: _, cleanup: _, restoration_failure: _ } => false
  }
}

// ── THE DURABLE CLAIM ─────────────────────────────────────────────────────────────────────────
fn claim_argv(attempt: String) -> List<String> {
  ["sh", "-c", join([
    "set -C; { echo ", attempt, " > ", native_claim_path as String, "; } 2>/dev/null && echo CLAIMED || echo HELD",
  ], "")]
}

fn settle_argv(status: String) -> List<String> {
  ["sh", "-c", join([
    "printf '%s\\n' ", status, " >> ", native_claim_path as String, "; rm -f ", native_claim_path as String, "; echo SETTLED",
  ], "")]
}

func win_claim(ctx: SparkRemoteExecutionContext, host: HostIdentity, attempt: String) -> Bool
  uses net: Network
{
  remote_run_stdout(r: spark_exec(ctx: ctx, host: host, argv: claim_argv(attempt: attempt))) == "CLAIMED"
}

func settle_claim(ctx: SparkRemoteExecutionContext, host: HostIdentity, status: String) -> Bool
  uses net: Network
{
  remote_run_stdout(r: spark_exec(ctx: ctx, host: host, argv: settle_argv(status: status))) == "SETTLED"
}

// ── READINESS AND THE SEMANTIC PROBE ──────────────────────────────────────────────────────────
fn native_probe_argv() -> List<String> {
  ["sh", "-c", join([
    "curl -sf -o /dev/null -m 10 http://127.0.0.1:", to_string(glm_native_serve_port), "/v1/models && echo SERVING || echo DOWN",
  ], "")]
}

fn native_sleep_argv() -> List<String> {
  ["sleep", to_string(native_ready_poll_interval_seconds)]
}

// ── WAITING IS A QUESTION ABOUT THE WHOLE POPULATION ──────────────────────────────────────────
//
// AN EARLIER FORM RETURNED A Bool AND ASKED ONLY THE HEAD'S PORT, so a group that had already died looked
// exactly like a group that was still loading. On 2026-09-10 that cost an hour: two peer ranks refused
// within seconds of starting, and this loop spent its entire 240-poll budget asking the head whether it was
// serving yet, then reported "the endpoint never answered within the readiness budget" -- a true statement
// about the wrong host. The reason nothing looked wrong is that a Bool has no room to say WHY it is still
// false.
//
// SO EVERY POLL ALSO ASKS WHETHER THE STARTED RANKS ARE STILL ALIVE, and one that is not ends the wait
// immediately with its own log attached. The budget is for slowness, not for a decided failure.
type NativeReadiness
  = NativeEndpointServing
  | NativeReadinessPeerFailed { standing: RankStartupStanding }
  | NativeReadinessBudgetExhausted

func await_native_endpoint(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, started: List<ArmNode>, remaining: Nat,
) -> NativeReadiness
  uses net: Network
{
  if remaining == 0 { NativeReadinessBudgetExhausted } else {
    if remote_run_stdout(r: spark_exec(ctx: ctx, host: host, argv: native_probe_argv())) == "SERVING" {
      NativeEndpointServing
    } else {
      match first_failed_rank_startup(ctx: ctx, started: started) {
        Present { value: s } => NativeReadinessPeerFailed { standing: s }
        Absent => {
          let waited = spark_exec(ctx: ctx, host: host, argv: native_sleep_argv())
          await_native_endpoint(ctx: ctx, host: host, started: started, remaining: remaining - 1)
        }
      }
    }
  }
}

// THE PROBE IS SHORT AND DISCRIMINATING, and it is bound to the alias the plan declared. A completion from
// some other process on the same port cannot satisfy this transaction, so the served name is what the
// assertion is about rather than the status code alone.
fn semantic_probe_argv() -> List<String> {
  ["sh", "-c", join([
    "curl -s -m 180 http://127.0.0.1:", to_string(glm_native_serve_port), "/v1/chat/completions",
    " -H 'Content-Type: application/json'",
    " -d '{\"model\":\"", glm_native_served_model_alias as String,
    "\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: ONLINE\"}],\"max_tokens\":24,\"temperature\":0}'",
    " | head -c 400",
  ], "")]
}

func run_semantic_probe(ctx: SparkRemoteExecutionContext, host: HostIdentity) -> NonEmptyStr?
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: semantic_probe_argv())
  let body = remote_run_stdout(r: r)
  if string_contains(s: body, pattern: glm_native_served_model_alias as String) && string_contains(s: body, pattern: "choices") {
    Present { value: body as NonEmptyStr }
  } else { none }
}

// ── THE ROLLBACK PATH, SHARED BY EVERY POST-STOP FAILURE ──────────────────────────────────────
//
// ONE PATH, SO NO FAILURE ARM CAN FORGET A STEP. Every post-stop failure cleans up the started ranks,
// restarts the retained incumbent, observes its endpoint, and settles the claim as aborted -- in that order,
// because cleaning up after restoring would leave four engines contending for memory on the same hosts.
func roll_back(
  ctx: SparkRemoteExecutionContext,
  head: HostIdentity,
  started: List<ArmNode>,
  failure: NonEmptyStr,
) -> NativeCutoverTerminal
  uses net: Network
{
  let cleanup = rollback_started_ranks(ctx: ctx, started: started)
  match restore_incumbent(ctx: ctx, host: head) {
    IncumbentRestored { receipt: rec } => {
      let settled = settle_claim(ctx: ctx, host: head, status: "aborted")
      NativeFailedAndIncumbentRestored { failure: failure, cleanup: cleanup, incumbent: rec }
    }
    IncumbentRestorationFailed { cause: c, start_attempted: _ } => {
      let settled = settle_claim(ctx: ctx, host: head, status: "aborted-incumbent-lost")
      NativeFailedAndIncumbentLost { failure: failure, cleanup: cleanup, restoration_failure: c }
    }
  }
}

// ── THE ENVELOPE IS RESOLVED TWICE AND THE TWO STAGES ASK DIFFERENT QUESTIONS ──────────────────
//
// STAGE ONE RUNS WHILE THE INCUMBENT IS STILL SERVING, AND IT DELIBERATELY EXCLUDES THE INCUMBENT'S HOST.
// The head is holding a loaded engine, so its device-free reading is a reading of an occupied machine and
// would refuse every launch -- correctly, and uselessly. The three PEERS are the hosts whose supply is
// knowable in advance, and on 2026-09-10 the peers were exactly where the shortfall was. Checking them
// before displacing anything is the difference between withholding and an outage.
//
// STAGE TWO RUNS AFTER THE INCUMBENT IS STOPPED AND BEFORE ANY RANK STARTS, over ALL FOUR ranks, and its
// result is the one the launch uses. Only then is the head's supply the supply a rank will meet, and the
// peers are re-read rather than carried forward because a reading taken minutes ago describes a machine
// that has since had time to change. A stage-two refusal restarts the incumbent and launches nothing.
//
// A STAGE-ONE PASS IS NOT EVIDENCE FOR STAGE TWO AND IS NOT TREATED AS ANY. It is a cheap veto, nothing
// more; the plan is built from stage two's resolution alone.
fn plan_peer_nodes(nodes: List<ArmNode>, head: HostIdentity) -> List<ArmNode> {
  filter(nodes, n => !host_identity_eq(a: n.host, b: head))
}

func stage_one_peer_envelope(
  ctx: SparkRemoteExecutionContext, nodes: List<ArmNode>, head: HostIdentity, attempt: String,
) -> ResolvedDeviceMemoryEnvelope
  uses net: Network
{
  glm_native_tp4_resolve_envelope(
    ctx: ctx,
    nodes: plan_peer_nodes(nodes: nodes, head: head),
    attempt: attempt as NonEmptyStr,
  )
}

// ── THE TRANSACTION ───────────────────────────────────────────────────────────────────────────
//
// THE PLAN IS NOW THE LAST THING BUILT RATHER THAN THE FIRST. Its memory fraction is a resolved fact about
// four machines at one moment, so there is nothing to plan until that fact exists -- and the roster the
// observation needs is available without a plan, from the same function the plan itself uses.
func perform_native_cutover(ctx: SparkRemoteExecutionContext, attempt: String) -> NativeCutoverTerminal
  uses net: Network
{
  match glm_native_tp4_nodes() {
    ArmNodeRosterRefused { cause: c } => NativeCutoverWithheld { reasons: [c] }
    ArmNodesResolved { nodes: ns, master: _ } =>
      match ns.first() {
        Absent => NativeCutoverWithheld { reasons: ["the roster names no head rank" as NonEmptyStr] }
        Present { value: head } =>
          match stage_one_peer_envelope(ctx: ctx, nodes: ns, head: head.host, attempt: attempt) {
            NoFeasibleDeviceMemoryEnvelope { cause: c, standings: ss } => NativeCutoverWithheld {
              reasons: [
                join(["the non-incumbent peers cannot supply this arm's memory floor, so nothing was stopped: ",
                      c as String], "") as NonEmptyStr,
                join(map(ss, x => "peer standing recorded" as String), "") as NonEmptyStr,
              ],
            }
            ResolvedForAttempt { basis_points: _, binding_node_rank: _, policy: _, attempt: _, standings: _ } =>
              cutover_after_peer_preflight(ctx: ctx, nodes: ns, head: head, attempt: attempt)
          }
      }
  }
}

// ── THE IDEMPOTENCE CHECK COMPARES AGAINST THE FRACTION THAT IS ACTUALLY RUNNING ───────────────
//
// IT CANNOT RESOLVE ONE OF ITS OWN, AND THAT IS THE CONSTRAINT THAT SHAPES THIS. A resolved envelope is a
// reading of idle machines, and this check runs while something is serving -- the incumbent on the head, or an
// already-converged native population. Either is holding the memory a resolution would measure, so an
// all-rank resolution taken here refuses by construction exactly when there is something to be idempotent
// about. Resolving before the stop and reusing it after would be worse still: it would launch against a
// supply reading taken while a 76 GiB engine was resident.
//
// SO THE FRACTION IS RECOVERED FROM THE RUNNING DEPLOYMENT RATHER THAN CHOSEN. A previous revision built the
// comparison plan at the policy ceiling and declared the consequence honestly -- a native arm serving at any
// lower resolved fraction read as divergent, and the transaction then withheld because the incumbent was not
// retainable. Safe, legible, and wrong about the world. gunbc.spark.native_rank_observer now reads the
// `--gpu-memory-utilization` value out of the argv it already captures, so the comparison is exact for every
// fraction the resolution can produce, and the ceiling-built plan is gone.
//
// AN UNRECOVERABLE FRACTION MEANS THERE IS NOTHING TO BE IDEMPOTENT ABOUT, WHICH IS AN ANSWER RATHER THAN A
// FAILURE. The head has no running native container, or its line does not carry a fraction this repository
// would have written -- either way no already-converged deployment has been established, so the transaction
// proceeds to the ordinary path, where the incumbent check and the two envelope stages each get their say. It
// does not proceed to a destructive step on the strength of this read.
fn recovered_envelope(basis_points: Nat, attempt: String) -> ResolvedDeviceMemoryEnvelope {
  ResolvedForAttempt {
    basis_points: basis_points,
    binding_node_rank: 0,
    policy: glm_native_device_memory_policy,
    attempt: attempt as NonEmptyStr,
    standings: [],
  }
}

func cutover_after_peer_preflight(
  ctx: SparkRemoteExecutionContext, nodes: List<ArmNode>, head: ArmNode, attempt: String,
) -> NativeCutoverTerminal
  uses net: Network
{
  match observe_rank_utilization_basis_points(ctx: ctx, node: head) {
    Absent => attempt_cutover(ctx: ctx, nodes: nodes, head: head.host, attempt: attempt)
    Present { value: running_bp } => {
      let reference = glm_native_tp4_launch_plan(envelope: recovered_envelope(basis_points: running_bp, attempt: attempt))
      let already = accept_deployment(inspection: inspect_native_deployment(
        subject: "the native four-rank deployment" as NonEmptyStr,
        plan: reference,
        reading: observe_native_population(ctx: ctx, plan: reference),
      ))
      match already {
        DeploymentAccepted { receipt: r } =>
          NativeAlreadyConverged {
            receipt: join(["four ranks already agree with the plan at ", r.image_digest as String], "") as NonEmptyStr,
          }
        DeploymentRejected { deviations: _ } => attempt_cutover(ctx: ctx, nodes: nodes, head: head.host, attempt: attempt)
        DeploymentUnverified { unknowns: _ } => attempt_cutover(ctx: ctx, nodes: nodes, head: head.host, attempt: attempt)
        DeploymentUnverifiable { cause: _ } => attempt_cutover(ctx: ctx, nodes: nodes, head: head.host, attempt: attempt)
      }
    }
  }
}

func attempt_cutover(ctx: SparkRemoteExecutionContext, nodes: List<ArmNode>, head: HostIdentity, attempt: String) -> NativeCutoverTerminal
  uses net: Network
{
  let incumbent = observe_incumbent(ctx: ctx, host: head)
  if !incumbent_is_retainable(o: incumbent) {
    NativeCutoverWithheld {
      reasons: ["the incumbent is not observed running and answering, so there is nothing this transaction could restore if the native arm fails" as NonEmptyStr],
    }
  } else {
    if !win_claim(ctx: ctx, host: head, attempt: attempt) {
      NativeCutoverWithheld { reasons: ["another attempt holds the durable cutover claim" as NonEmptyStr] }
    } else {
      match stop_incumbent_retaining_it(ctx: ctx, host: head, observed: incumbent) {
        IncumbentStopFailed { cause: c } => {
          let settled = settle_claim(ctx: ctx, host: head, status: "aborted-before-stop")
          NativeCutoverWithheld { reasons: [c as NonEmptyStr] }
        }
        IncumbentStopped { container_id: _ } =>
          launch_after_stop(ctx: ctx, nodes: nodes, head: head, attempt: attempt)
      }
    }
  }
}

// ── STAGE TWO: THE ONLY RESOLUTION A LAUNCH IS BUILT FROM ──────────────────────────────────────
//
// THIS IS THE FIRST MOMENT THE READING MEANS WHAT THE LAUNCH NEEDS IT TO MEAN. The incumbent has released
// the head's memory, no native rank has started, and every one of the four hosts is in the state a rank
// will find. The peers are re-read rather than carried from stage one, because stage one's purpose was to
// avoid an outage and not to supply a budget -- and minutes have passed since.
//
// THE PAGE CACHE IS RELEASED BEFORE THE READING THAT GOVERNS, AND THAT IS MEASURED RATHER THAN HOPEFUL. On
// srv10 the same device probe answered 10.82 GiB with the acquisition's page cache resident and 117.08 GiB
// immediately after releasing it, so a resolution taken without that step would refuse four correct machines.
// The remedy's own outcomes are EVIDENCE and not a second admission decision: if a host still cannot supply
// the floor, the envelope refuses on the device reading, which remains the only authority here.
//
// A STAGE-TWO REFUSAL LAUNCHES NOTHING AND PUTS THE INCUMBENT BACK. The rollback path is entered with an
// empty started population, which is exactly what it is for: no container to remove, one engine to restore,
// one claim to settle as aborted.
func launch_after_stop(
  ctx: SparkRemoteExecutionContext, nodes: List<ArmNode>, head: HostIdentity, attempt: String,
) -> NativeCutoverTerminal
  uses net: Network
{
  let remedies = release_population_page_cache(ctx: ctx, nodes: nodes)
  let envelope = glm_native_tp4_resolve_envelope(ctx: ctx, nodes: nodes, attempt: attempt as NonEmptyStr)
  let plan = glm_native_tp4_launch_plan(envelope: envelope)
  match plan {
    ArmLaunchRefused { cause: c } =>
      roll_back(ctx: ctx, head: head, started: [], failure: join([
        c as String, " -- page cache remedy: ",
        join(map(remedies, x => memory_remedy_text(o: x)), "; "),
      ], "") as NonEmptyStr)
    ArmLaunchPlanned { lines: _, master: _ } =>
      match launch_native_population(ctx: ctx, plan: plan) {
        LaunchPopulationHadNoPlan { cause: c } =>
          roll_back(ctx: ctx, head: head, started: [], failure: c)
        LaunchPopulationIncomplete { outcomes: os, started: st, first_failure_rank: fr } =>
          roll_back(ctx: ctx, head: head, started: st, failure: join([
            "rank ", to_string(fr), " did not start: ",
            join(map(os, o => rank_outcome_text(o: o)), " | "),
          ], "") as NonEmptyStr)
        EveryRankStarted { outcomes: _, started: st } =>
          match await_native_endpoint(ctx: ctx, host: head, started: st, remaining: native_ready_poll_budget) {
            NativeReadinessBudgetExhausted =>
              roll_back(ctx: ctx, head: head, started: st,
                failure: "every rank started, every rank stayed running, and the endpoint never answered within the readiness budget" as NonEmptyStr)
            NativeReadinessPeerFailed { standing: sg } =>
              roll_back(ctx: ctx, head: head, started: st, failure: join([
                "a started rank left the group before the endpoint answered, so the wait was abandoned rather than spent: ",
                rank_startup_text(s: sg),
              ], "") as NonEmptyStr)
            NativeEndpointServing =>
              accept_or_roll_back(ctx: ctx, plan: plan, head: head, started: st)
          }
      }
  }
}

// THE ACCEPTANCE TAIL IS ITS OWN FUNCTION BECAUSE THE READINESS MATCH ABOVE IS ALREADY THREE ARMS DEEP, and
// a fourth level of nesting is where an arm gets dropped without anyone seeing it.
func accept_or_roll_back(
  ctx: SparkRemoteExecutionContext, plan: ArmLaunchPlan, head: HostIdentity, started: List<ArmNode>,
) -> NativeCutoverTerminal
  uses net: Network
{
  match accept_deployment(inspection: inspect_native_deployment(
    subject: "the native four-rank deployment" as NonEmptyStr,
    plan: plan,
    reading: observe_native_population(ctx: ctx, plan: plan),
  )) {
    DeploymentRejected { deviations: _ } =>
      roll_back(ctx: ctx, head: head, started: started, failure: "the deployment readback DIVERGED from the plan" as NonEmptyStr)
    DeploymentUnverified { unknowns: _ } =>
      roll_back(ctx: ctx, head: head, started: started, failure: "the deployment readback could not establish every fact it must assert" as NonEmptyStr)
    DeploymentUnverifiable { cause: c } =>
      roll_back(ctx: ctx, head: head, started: started, failure: c)
    DeploymentAccepted { receipt: rec } =>
      match run_semantic_probe(ctx: ctx, host: head) {
        Absent =>
          roll_back(ctx: ctx, head: head, started: started, failure: "the endpoint answered and the semantic probe did not return a completion for the declared alias" as NonEmptyStr)
        Present { value: body } => {
          let settled = settle_claim(ctx: ctx, host: head, status: "completed")
          NativeServing {
            receipt: join([
              "four ranks agreed at ", rec.image_digest as String,
              " serving ", rec.model_path as String,
            ], "") as NonEmptyStr,
            probe: body,
          }
        }
      }
  }
}

// ── THE OPERATOR-REACHABLE ROOT ───────────────────────────────────────────────────────────────
func glm_native_tp4_cutover_wet() -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  match observe_executor_reach() {
    ExecutorReachUnknown { cause: c } => exit_failure(reason: join(["native cutover: ", c], ""))
    ExecutorReachKnown { short_hostname: executor, path: path } =>
      match read_bootstrap_credential() {
        BootstrapCredentialNotMaterialized { cause: c } => exit_failure(reason: c as String)
        BootstrapCredentialReady { secret: administrator } =>
          match fleet_ssh_attempt_identity(raw: native_attempt_raw) {
            Absent => exit_failure(reason: "the attempt identity is not a safe path segment")
            Present { value: attempt } => {
              let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
              match fleet_openssh_trust_policy_of(outcome: materialization) {
                Absent => exit_failure(reason: join([
                  "trust could not be established, so no leg ran: ",
                  known_hosts_materialization_receipt(outcome: materialization),
                ], ""))
                Present { value: trust } =>
                  match with_materialized_ssh_key_file(
                    identity_file_name: "gunbc-glm-native-cutover-admin-password" as NonEmptyStr,
                    secret_bytes: administrator as Secret,
                    use: fn(file) {
                      perform_native_cutover(
                        ctx: SparkRemoteExecutionContext {
                          trust: trust,
                          reach_path: path,
                          administrator: administrator as Secret,
                          administrator_file: file,
                        },
                        attempt: native_attempt_raw,
                      )
                    },
                  ) {
                    MaterializedSshKeyFileBracketRefused { cause: c } => exit_failure(reason: c as String)
                    MaterializedSshKeyFileBracketCompleted { value: terminal } =>
                      if terminal_is_success(t: terminal) { ExitSuccess }
                      else { exit_failure(reason: terminal_text(t: terminal)) }
                  }
              }
            }
          }
      }
  }
}
