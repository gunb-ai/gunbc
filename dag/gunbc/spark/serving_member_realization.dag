module gunbc.spark.serving_member_realization


data spark_serving_member_realization_authority_note: String = "Per-member-type realization bundle for Spark serving: maps membership_reconcile actions/effects onto the EXISTING gunbc.spark.serving_realization ServingInstallEffect vocabulary (UserUnitRealization scope only — never live_deploy SystemdUnit/system-scoped handlers). MemberEffect<M> classifies change; this module supplies how to realize each action for SparkServingMember addresses. Admission boundaries and API readiness observations stay outside this bundle."

// THE CONTENT ADDRESS NO LONGER ENABLES. Splitting enablement into its own resource changed the
// decomposition but left the old bundled remedy underneath it: content mapped to write-reload-ENABLE
// while enablement also mapped to enable, so a bare host -- where BOTH members drift -- froze TWO
// enable operations for one unit.
//
// Adding an address does not divide a responsibility; removing it from the old owner does. Content
// owns getting the right bytes in place; enablement owns whether the unit survives a reboot.
//
// AND THE RELOAD HAS NOW MOVED FOR THE SAME REASON THE ENABLE DID. It stayed here on the grounds
// that reload is what makes new bytes visible, which is true and is still not an argument for who
// OWNS it: with registration modelled as its own resource, reload is the remedy that establishes
// registration -- the manager holding the definition we want it to hold. Leaving it bundled here
// would have recreated the defect recorded directly above, one subject over: a bare host drifts at
// BOTH content and registration, so content emitting a reload while registration also emits one
// freezes TWO daemon-reloads for one unit.
//
// Content now emits exactly one operation, and every address in this map has exactly one remedy.
fn spark_serving_user_unit_install_effects() -> std.types.List<gunbc.spark.serving_realization.ServingInstallEffect> {
  [gunbc.spark.serving_realization.WriteUserUnitFile]
}

fn spark_serving_install_effects_for_address(address: gunbc.spark.serving_membership.SparkServingResourceAddress) -> std.types.List<gunbc.spark.serving_realization.ServingInstallEffect> {
  match address {
    SparkServingRuntimeRootAddress => [gunbc.spark.serving_realization.InstallOwnedRuntimeClosure]
    SparkServingUserUnitAddress => spark_serving_user_unit_install_effects()
    SparkServingUserUnitRegistrationAddress => [gunbc.spark.serving_realization.ReloadUserManager]
    SparkServingUserUnitEnablementAddress => [gunbc.spark.serving_realization.EnableUserUnit]
    SparkServingUserUnitActivityAddress => [gunbc.spark.serving_realization.StartUserUnit]
    SparkServingModelSlotAddress { slot: _ } => [gunbc.spark.serving_realization.MaterializeModelArtifact]
    SparkServingLingerAddress => [gunbc.spark.serving_realization.EnableLingerForOwnAccount]
  }
}

fn spark_serving_install_effects_for_add(member: gunbc.spark.serving_membership.SparkServingMember) -> std.types.List<gunbc.spark.serving_realization.ServingInstallEffect> {
  spark_serving_install_effects_for_address(address: member.address)
}

// THE PRIOR STATE IS DELIBERATELY UNUSED, AND THE UNDERSCORE IS THE POINT.
//
// This parameter was bound as `from` and silently discarded, which reads as consumed and is not. The
// generic spine carries both sides on purpose -- its own authority note says a handler replacing a
// member must be able to retire the prior realization -- so dropping it was how one remedy came to
// answer for transitions that needed different ones: not-registered and disabled both arrived at
// this address and both selected enable, when the first needed write and reload first.
//
// After the registration split every address in the effect map has exactly one remedy, so the prior
// state genuinely does not select anything here and the honest spelling is the one this module
// already uses for the remove arm. If a future address gains a state-dependent remedy, the
// underscore comes off and this function matches on it -- an unused name is a decision recorded,
// where a used-looking one was a defect hidden.
fn spark_serving_install_effects_for_change(
  _from: gunbc.spark.serving_membership.SparkServingMember,
  to: gunbc.spark.serving_membership.SparkServingMember,
) -> std.types.List<gunbc.spark.serving_realization.ServingInstallEffect> {
  spark_serving_install_effects_for_address(address: to.address)
}

fn spark_serving_install_effects_for_remove(_member: gunbc.spark.serving_membership.SparkServingMember) -> std.types.List<gunbc.spark.serving_realization.ServingInstallEffect> {
  []
}

fn spark_serving_install_effects_for_member_action(
  action: gunbc.membership_reconcile.MemberAction<gunbc.spark.serving_membership.SparkServingMember, gunbc.spark.serving_membership.SparkServingMemberAt>,
) -> std.types.List<gunbc.spark.serving_realization.ServingInstallEffect>? {
  match action {
    MemberAdded { at: _, to: member } =>
      Present { value: spark_serving_install_effects_for_add(member: member) }
    MemberChanged { at: _, from: f, to: t } =>
      Present { value: spark_serving_install_effects_for_change(from: f, to: t) }
    MemberRemoved { at: _, from: member } =>
      Present { value: spark_serving_install_effects_for_remove(member: member) }
    MemberRemovalRefused { from: _, cause: _ } => Absent
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => Absent
  }
}

fn spark_serving_install_effects_for_member_effect(
  effect: gunbc.membership_reconcile.MemberEffect<gunbc.spark.serving_membership.SparkServingMember>,
) -> std.types.List<gunbc.spark.serving_realization.ServingInstallEffect> {
  match effect {
    EffectAdd { to: member } => spark_serving_install_effects_for_add(member: member)
    EffectReplace { from: f, to: t } =>
      spark_serving_install_effects_for_change(from: f, to: t)
    EffectRemove { from: member } => spark_serving_install_effects_for_remove(member: member)
  }
}

fn spark_serving_install_effects_include(
  effects: std.types.List<gunbc.spark.serving_realization.ServingInstallEffect>,
  needle: gunbc.spark.serving_realization.ServingInstallEffect,
) -> Bool {
  any(effects, e => e == needle)
}
