module gunbc.spark.native_deployment_readback

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import v2.std.algebra { non_empty_to_list }
import product.placement_supply { HostIdentity, host_identity_eq }
import extdeps.network.ipv4 { Ipv4Address, render_ipv4_address }
import std.goal_assessment {
  ObservationAttempt, ObservationEstablished, ObservationRefused,
  GoalAssessment, GoalSatisfied, GoalDiverged, GoalIndeterminate, GoalAssessmentRefused,
  GoalInspection, GoalInspected, GoalObservationRefused,
  inspect_goal, assess_by_deviations_and_unknowns,
}
import gunbc.spark.serving_arm_launch {
  ArmLaunchPlan, ArmLaunchPlanned, ArmLaunchRefused,
  ArmNodeLaunch, ArmNode,
}
import gunbc.spark.container_realization {
  ObservedContainerRealization, RealizationDeviation, realization_deviations, realization_deviation_text,
}
import extdeps.docker.cli { DockerCreateSpec }
import gunbc.spark.collective_transport {
  CollectiveTransportPlan, transport_requires_verbs, transport_expected_device,
  transport_expected_out_of_band, collective_transport_requirement_wire,
}

// ── WHY THE THREE-FIELD ARM IDENTITY IS NOT A DEPLOYMENT RECEIPT ───────────────────────────────
//
// gunbc.spark.serving_arm_convergence identifies a served arm by alias, quantisation word and rank
// count, and that is the right grain for ITS question -- WHICH PRODUCT ARM is serving, decided against a
// running engine's own launch line, deliberately ignoring tuning so a batched-token drift cannot read as
// a different model. It is not the right grain for accepting a cutover.
//
// TWO DEPLOYMENTS CAN AGREE ON ALL THREE AND DIFFER IN EVERYTHING THAT MATTERS: a different image
// digest, a different checkpoint revision, half the context window, a tenfold sequence budget, a
// different cache policy, absent parsers, speculation on, or collectives on the wrong interface. Every
// one of those is a fact somebody would want to know before believing the fleet serves what was
// authorised, and none of them changes the coarse identity.
//
// THE GOAL IS DERIVED FROM THE PLAN THAT LAUNCHED, WHICH IS THE POINT. This module does not restate the
// desired profile -- it reads the ArmLaunchPlan and compares the world to THAT. A readback whose
// expectations were spelled again beside the launcher would be a second authority for one fact, free to
// drift from the argv it claims to verify, and the drift would be invisible precisely because both
// sides would agree with themselves.
//
// AND IT ASSESSES RATHER THAN DECIDES. std.goal_assessment owns the remedy-free relation; whether a
// divergence should roll back, retry or be accepted belongs to the transaction that reads this.

// ── WHAT IS READ FROM ONE RANK ─────────────────────────────────────────────────────────────────
//
// THE ARGV IS ORDERED AND CARRIED WHOLE, because the flags that decide behaviour are exactly the ones a
// summary would drop. It is read from the running container rather than derived, so this type describes
// a MEASUREMENT and every field can disagree with the plan.
//
// THE FABRIC INTERFACE IS OPTIONAL AND THAT IS DELIBERATE. Which interface NCCL selected is printed by
// the engine at start-up, and a reader that did not capture it has NOT established it -- inferring the
// interface from the environment the launch requested would make the check agree with itself, since the
// launch is what set the variable. An unread interface is an unknown, not a pass.
// THE CREATION STATE IS PART OF THE OBSERVATION, NOT A SEPARATE ERRAND. A rank reading that carried the
// selected transport and not the container it was selected in could establish that NCCL chose verbs and
// say nothing about whether this repository could produce that container again -- which is the state the
// fleet was found in on 2026-09-14, accepted and unreproducible.
type RankObservation sole_constructor {
  host: HostIdentity
  node_rank: Nat
  image_digest: NonEmptyStr
  model_path: NonEmptyStr
  argv: List<String>
  selected_transport: NcclTransportObservation
  realization: ObservedContainerRealization
}

fn rank_observation(
  host: HostIdentity,
  node_rank: Nat,
  image_digest: NonEmptyStr,
  model_path: NonEmptyStr,
  argv: List<String>,
  selected_transport: NcclTransportObservation,
  realization: ObservedContainerRealization,
) -> RankObservation {
  RankObservation {
    host: host,
    node_rank: node_rank,
    image_digest: image_digest,
    model_path: model_path,
    argv: argv,
    selected_transport: selected_transport,
    realization: realization,
  }
}

type NativeDeploymentObserved
  = DeploymentRanksRead { ranks: List<RankObservation>, endpoint_alias: NonEmptyStr? }
  | DeploymentNothingRunning { detail: NonEmptyStr }

type DeploymentDeviation
  = RankAbsent { expected_rank: Nat, expected_host: NonEmptyStr }
  | RankOnWrongHost { node_rank: Nat, expected_host: NonEmptyStr, observed_host: NonEmptyStr }
  | RankImageDigestDiffers { node_rank: Nat, desired: NonEmptyStr, observed: NonEmptyStr }
  | RankModelPathDiffers { node_rank: Nat, desired: NonEmptyStr, observed: NonEmptyStr }
  | RankArgvDiffers { node_rank: Nat, first_difference_position: Nat, desired_word_count: Nat, observed_word_count: Nat }
  | RankFabricInterfaceDiffers { node_rank: Nat, desired: NonEmptyStr, observed: NonEmptyStr }
  | DeploymentNotServing { detail: NonEmptyStr }
  | EndpointAliasDiffers { desired: NonEmptyStr, observed: NonEmptyStr }
  | DuplicateObservedRank { node_rank: Nat, observations: Nat }
  | UnexpectedObservedRank { node_rank: Nat }
  | RankRealizationDiffers { deviation: RealizationDeviation }

type DeploymentUnknown
  = FabricInterfaceUnread { node_rank: Nat }
  | FabricOutOfBandUnread { node_rank: Nat }
  | EndpointAliasUnread

type DeploymentReceipt sole_constructor {
  ranks_agreed: Nat
  image_digest: NonEmptyStr
  model_path: NonEmptyStr
}

// A PLAN THAT REFUSED IS A MALFORMED QUESTION HERE, not a divergence: there is no desired deployment to
// compare the world against, so any verdict would certify a comparison that never ran.
type DeploymentAssessRefusal
  = NoPlanToVerify { cause: NonEmptyStr }

fn plan_lines(plan: ArmLaunchPlan) -> List<ArmNodeLaunch> {
  match plan {
    ArmLaunchPlanned { lines: ls, master: _ } => ls
    ArmLaunchRefused { cause: _ } => []
  }
}

fn observation_for_rank(observed: List<RankObservation>, rank: Nat) -> RankObservation? {
  filter(observed, o => o.node_rank == rank).first()
}

// THE PLANNER STATES THE IMAGE; THIS NO LONGER GUESSES IT FROM THE WORDS. The previous body filtered the
// launch line for a word containing "@sha256:" and joined the matches, which returned "" for an arm pinned
// by a bare content id -- and an empty join coerced to NonEmptyStr without complaint, so a rank whose image
// was exactly right refused against a planned value that was not there to read.
fn argv_image_digest(l: ArmNodeLaunch) -> NonEmptyStr {
  l.image_reference
}

fn argv_model_path(l: ArmNodeLaunch) -> NonEmptyStr {
  join(filter(l.engine_argv, w => string_contains(s: w, pattern: "/snapshots/") || w == "/model"), "") as NonEmptyStr
}

// ── ORDERED ARGV COMPARISON, WALKED IN STEP ────────────────────────────────────────────────────
//
// THIS WAS A WORD COUNT AND THAT WAS NOT GOOD ENOUGH. The previous revision compared list LENGTHS and
// declared the gap honestly, which is better than hiding it and still admits the case that matters: a
// running command with the same number of words and one changed value passed the check. Argument ORDER
// was one of the things this program has already paid to preserve -- the whole reason the launch line is
// carried as a list rather than a string -- so a comparison that cannot see a reordering is not a
// comparison of it.
//
// THE RECURSION IS THE COMPARISON, and it descends on both tails at once, which is the shape a list-zip
// primitive would have provided. Heads equal, compare tails; one list empty and the other not, different;
// heads differ, different AT THIS POSITION -- and the position is what the deviation carries, because
// "the argv differs" sends a reader to diff two 58-word lines by eye.
fn argv_equal(a: List<String>, b: List<String>) -> Bool {
  match a.first() {
    Absent =>
      match b.first() {
        Absent => true
        Present { value: _ } => false
      }
    Present { value: ah } =>
      match b.first() {
        Absent => false
        Present { value: bh } =>
          if ah == bh { argv_equal(a: a.skip(n: 1), b: b.skip(n: 1)) } else { false }
      }
  }
}

// THE FIRST DIFFERING POSITION, counted from zero. A trailing extra word reports at the length of the
// shorter list, which is where a reader should look.
fn argv_first_difference(a: List<String>, b: List<String>, position: Nat) -> Nat {
  match a.first() {
    Absent => position
    Present { value: ah } =>
      match b.first() {
        Absent => position
        Present { value: bh } =>
          if ah == bh { argv_first_difference(a: a.skip(n: 1), b: b.skip(n: 1), position: position + 1) } else { position }
      }
  }
}

// ── THE TRANSPORT IS A BACKEND AND A DEVICE, NOT AN INTERFACE NAME ────────────────────────────
//
// A NETDEV NAME CANNOT SAY WHICH TRANSPORT RAN OVER IT, and reducing the observation to one meant the
// readback could not tell RoCE from TCP on the same rail. Both NCCL backends use enp1s0f1np1: the IB
// backend for verbs traffic with the socket only for out-of-band bootstrap, the Socket backend for
// everything. So "the interface is the one we intended" was satisfied by the deployment that had
// silently fallen back, which is the whole defect.
//
// AND THE OLD READER COULD NOT REPRESENT THE ANSWER IT WAS ABOUT TO BE GIVEN. It matched only
// "NET/Socket : Using ...". The moment the RDMA realization lands, NCCL prints NET/IB instead, the
// reader returns nothing, and a correct deployment reports DeploymentUnverified -- a reader whose
// success case becomes unreadable exactly when the system is fixed. That is the same shape as a check
// that cannot go red, one layer out, and it would have cost a weight-load cycle to discover.
type NcclTransportObservation
  = NcclIbTransport { hca: NonEmptyStr, oob_netdev: NonEmptyStr? }
  | NcclSocketTransport { netdev: NonEmptyStr }
  | NcclTransportUnread { cause: NonEmptyStr }

fn nccl_transport_text(t: NcclTransportObservation) -> String {
  match t {
    NcclIbTransport { hca: h, oob_netdev: _ } => join(["verbs over ", h as String], "")
    NcclSocketTransport { netdev: n } => join(["TCP sockets over ", n as String], "")
    NcclTransportUnread { cause: c } => c as String
  }
}

// ── ONE RANK'S DEVIATIONS ──────────────────────────────────────────────────────────────────────
fn rank_deviations(desired: ArmNodeLaunch, observed: RankObservation) -> List<DeploymentDeviation> {
  concat(concat(concat(
    if host_identity_eq(a: desired.node.host, b: observed.host) { [] } else {
      [RankOnWrongHost {
        node_rank: desired.node.node_rank,
        expected_host: desired.node.host as NonEmptyStr,
        observed_host: observed.host as NonEmptyStr,
      }]
    },
    if (argv_image_digest(l: desired) as String) == (observed.image_digest as String) { [] } else {
      [RankImageDigestDiffers {
        node_rank: desired.node.node_rank,
        desired: argv_image_digest(l: desired),
        observed: observed.image_digest,
      }]
    }),
    if (argv_model_path(l: desired) as String) == (observed.model_path as String) { [] } else {
      [RankModelPathDiffers {
        node_rank: desired.node.node_rank,
        desired: argv_model_path(l: desired),
        observed: observed.model_path,
      }]
    }),
    if argv_equal(a: desired.engine_argv, b: observed.argv) { [] } else {
      [RankArgvDiffers {
        node_rank: desired.node.node_rank,
        first_difference_position: argv_first_difference(a: desired.engine_argv, b: observed.argv, position: 0),
        desired_word_count: count(desired.engine_argv),
        observed_word_count: count(observed.argv),
      }]
    })
}

// THE COMPARISON IS AGAINST THE PLAN, WHICH IS WHERE THE REQUIREMENT LIVES. This asked whether the
// observation was NcclIbTransport and accepted any answer that was -- so a rank reporting verbs over
// an HCA nobody planned passed, and, measured 2026-09-14, four ranks whose transport reading was a
// misparse of the IB plugin's `Using [RO]` banner passed as an RDMA deployment. The plan now carries
// the requirement, the device and the out-of-band interface, and each is compared.
//
// A SOCKET RANK UNDER A VERBS REQUIREMENT IS A DIVERGENCE AND NOT A DETAIL: its capacity, its latency
// and every throughput standing scoped to the intended transport are different facts. A VERBS rank
// under a permitted-socket plan is equally a divergence -- the realization is not the one selected,
// and a standing measured over sockets does not describe it.
fn rank_transport_deviation(desired: ArmNodeLaunch, node_rank: Nat, observed: NonEmptyStr) -> List<DeploymentDeviation> {
  [RankFabricInterfaceDiffers {
    node_rank: node_rank,
    desired: join([
      collective_transport_requirement_wire(r: desired.transport.requirement) as String,
      " (", transport_expected_device(plan: desired.transport) as String,
      ", out of band ", transport_expected_out_of_band(plan: desired.transport) as String, ")",
    ], "") as NonEmptyStr,
    observed: observed,
  }]
}

fn rank_interface_deviations(desired: ArmNodeLaunch, observed: RankObservation) -> List<DeploymentDeviation> {
  match observed.selected_transport {
    NcclTransportUnread { cause: _ } => []
    NcclSocketTransport { netdev: n } =>
      if transport_requires_verbs(plan: desired.transport) {
        rank_transport_deviation(desired: desired, node_rank: desired.node.node_rank,
          observed: join(["NCCL TCP sockets over ", n as String], "") as NonEmptyStr)
      } else if (n as String) != (transport_expected_device(plan: desired.transport) as String) {
        rank_transport_deviation(desired: desired, node_rank: desired.node.node_rank,
          observed: join(["NCCL TCP sockets over ", n as String], "") as NonEmptyStr)
      } else {
        []
      }
    NcclIbTransport { hca: h, oob_netdev: oob } =>
      if !transport_requires_verbs(plan: desired.transport) {
        rank_transport_deviation(desired: desired, node_rank: desired.node.node_rank,
          observed: join(["NCCL verbs over ", h as String], "") as NonEmptyStr)
      } else if (h as String) != (transport_expected_device(plan: desired.transport) as String) {
        rank_transport_deviation(desired: desired, node_rank: desired.node.node_rank,
          observed: join(["NCCL verbs over ", h as String], "") as NonEmptyStr)
      } else {
        match oob {
          Absent => []
          Present { value: o } =>
            if (o as String) == (transport_expected_out_of_band(plan: desired.transport) as String) {
              []
            } else {
              rank_transport_deviation(desired: desired, node_rank: desired.node.node_rank,
                observed: join(["NCCL verbs over ", h as String, " bootstrapping on ", o as String], "") as NonEmptyStr)
            }
        }
      }
  }
}

// AN IB SELECTION THAT NAMED NO OUT-OF-BAND INTERFACE IS A FACT THE RECEIPT CANNOT ASSERT. NCCL prints
// the bootstrap socket beside the device it selected; a reading without it establishes the payload path
// and not the path the ranks found each other on, which is one of the three facts acceptance promises.
fn rank_unknowns(desired: ArmNodeLaunch, observed: RankObservation) -> List<DeploymentUnknown> {
  match observed.selected_transport {
    NcclIbTransport { hca: _, oob_netdev: oob } =>
      match oob {
        Present { value: _ } => []
        Absent => [FabricOutOfBandUnread { node_rank: desired.node.node_rank }]
      }
    NcclSocketTransport { netdev: _ } => []
    NcclTransportUnread { cause: _ } => [FabricInterfaceUnread { node_rank: desired.node.node_rank }]
  }
}

// ── THE POPULATIONS MUST BE A BIJECTION, NOT A LOOKUP THAT SUCCEEDED ──────────────────────────
//
// EVERY PLANNED RANK FINDING AT LEAST ONE AGREEABLE ROW IS NOT THE SAME AS THE DEPLOYMENT AGREEING.
// observation_for_rank takes the FIRST row for a rank, and the assessment iterates the PLANNED lines,
// so two failures slipped through both: a rank observed twice whose first row agrees and whose second
// disagrees was reduced to the agreeable one, and a rank running that the plan never named was not
// looked at by anything. The receipt's ranks_agreed is derived from the planned count, so it would
// have reported full agreement over a population that was neither complete nor exclusive.
//
// THIS MATTERS MOST TO WHAT CONSUMES THE VERDICT. An incarnation receipt built on "all ranks agree"
// must not mean "each planned rank had a row we liked": a fifth process serving different weights on
// the same group is exactly the case where a turn would be placed on an engine nobody observed.
// THE PLANNED SIDE IS NOT CHECKED HERE BECAUSE ITS CONSTRUCTOR ALREADY SEALS IT. A bijection needs
// uniqueness on both sides, and only the observed side is a population this module receives:
// gunbc.spark.serving_arm_launch arm_node_step assigns node_rank from a fold accumulator and
// increments it per host, so planned ranks are 0,1,2,... strictly increasing by construction and a
// DuplicatePlannedRank arm would be a check whose red no caller could author -- the decoration DESIGN
// section 4b forbids at the top rung.
//
// WHAT THAT SEAL DOES NOT COVER IS HOST UNIQUENESS, and this says so rather than implying a stronger
// guarantee: arm_ordered_hosts places the head first and filters it from the tail, so the head cannot
// repeat, but two ranks landing on one host would require gunbc.spark.fabric_switch_observed
// fabric_group_hosts to answer a host twice. That is an invariant of the observed group membership and
// belongs to the planner if it is ever violated, not to a second check inside this assessment.
fn observations_for_rank(observed: List<RankObservation>, rank: Nat) -> List<RankObservation> {
  filter(observed, o => o.node_rank == rank)
}

fn planned_rank_present(plan_lines: List<ArmNodeLaunch>, rank: Nat) -> Bool {
  count(filter(plan_lines, l => l.node.node_rank == rank)) != 0
}

fn duplicate_rank_deviations(observed: List<RankObservation>, ls: List<ArmNodeLaunch>) -> List<DeploymentDeviation> {
  flat_map(ls, l =>
    if count(observations_for_rank(observed: observed, rank: l.node.node_rank)) > 1 {
      [DuplicateObservedRank {
        node_rank: l.node.node_rank,
        observations: count(observations_for_rank(observed: observed, rank: l.node.node_rank)),
      }]
    } else { [] })
}

fn unexpected_rank_deviations(observed: List<RankObservation>, ls: List<ArmNodeLaunch>) -> List<DeploymentDeviation> {
  flat_map(observed, o =>
    if planned_rank_present(plan_lines: ls, rank: o.node_rank) { [] }
    else { [UnexpectedObservedRank { node_rank: o.node_rank }] })
}

fn population_deviations(observed: List<RankObservation>, ls: List<ArmNodeLaunch>) -> List<DeploymentDeviation> {
  concat(
    duplicate_rank_deviations(observed: observed, ls: ls),
    unexpected_rank_deviations(observed: observed, ls: ls))
}

fn line_deviations(observed: List<RankObservation>, l: ArmNodeLaunch) -> List<DeploymentDeviation> {
  match observation_for_rank(observed: observed, rank: l.node.node_rank) {
    Absent => [RankAbsent { expected_rank: l.node.node_rank, expected_host: l.node.host as NonEmptyStr }]
    Present { value: o } =>
      concat(
        concat(rank_deviations(desired: l, observed: o), rank_interface_deviations(desired: l, observed: o)),
        map(realization_deviations(planned: l.spec, observed: o.realization), d => RankRealizationDiffers { deviation: d }))
  }
}

fn line_unknowns(observed: List<RankObservation>, l: ArmNodeLaunch) -> List<DeploymentUnknown> {
  match observation_for_rank(observed: observed, rank: l.node.node_rank) {
    Absent => []
    Present { value: o } => rank_unknowns(desired: l, observed: o)
  }
}

fn deployment_deviations(plan: ArmLaunchPlan, observed: NativeDeploymentObserved) -> List<DeploymentDeviation> {
  match observed {
    DeploymentNothingRunning { detail: d } => [DeploymentNotServing { detail: d }]
    DeploymentRanksRead { ranks: rs, endpoint_alias: ep } =>
      concat(
        concat(
          population_deviations(observed: rs, ls: plan_lines(plan: plan)),
          flat_map(plan_lines(plan: plan), l => line_deviations(observed: rs, l: l))),
        match ep {
          Absent => []
          Present { value: a } =>
            if (a as String) == "glm-5.3-flash" { [] } else {
              [EndpointAliasDiffers { desired: "glm-5.3-flash" as NonEmptyStr, observed: a }]
            }
        })
  }
}

fn deployment_unknowns(plan: ArmLaunchPlan, observed: NativeDeploymentObserved) -> List<DeploymentUnknown> {
  match observed {
    DeploymentNothingRunning { detail: _ } => []
    DeploymentRanksRead { ranks: rs, endpoint_alias: ep } =>
      concat(
        flat_map(plan_lines(plan: plan), l => line_unknowns(observed: rs, l: l)),
        match ep {
          Present { value: _ } => []
          Absent => [EndpointAliasUnread]
        })
  }
}

fn deployment_receipt(plan: ArmLaunchPlan, observed: NativeDeploymentObserved) -> DeploymentReceipt {
  match plan_lines(plan: plan).first() {
    Absent => DeploymentReceipt {
      ranks_agreed: 0,
      image_digest: "no planned line" as NonEmptyStr,
      model_path: "no planned line" as NonEmptyStr,
    }
    Present { value: l } => DeploymentReceipt {
      ranks_agreed: count(plan_lines(plan: plan)),
      image_digest: argv_image_digest(l: l),
      model_path: argv_model_path(l: l),
    }
  }
}

fn assess_native_deployment(plan: ArmLaunchPlan, observed: NativeDeploymentObserved) -> GoalAssessment<DeploymentReceipt, DeploymentDeviation, DeploymentUnknown, DeploymentAssessRefusal> {
  match plan {
    ArmLaunchRefused { cause: c } => GoalAssessmentRefused { cause: NoPlanToVerify { cause: c } }
    ArmLaunchPlanned { lines: _, master: _ } => assess_by_deviations_and_unknowns(
      evidence: deployment_receipt(plan: plan, observed: observed),
      deviations: deployment_deviations(plan: plan, observed: observed),
      unknowns: deployment_unknowns(plan: plan, observed: observed),
    )
  }
}

type NativeDeploymentInspection = GoalInspection<NonEmptyStr, ArmLaunchPlan, NativeDeploymentObserved, NativeDeploymentObserved, DeploymentReceipt, DeploymentDeviation, DeploymentUnknown, NonEmptyStr, DeploymentAssessRefusal>

fn observe_deployment(subject: NonEmptyStr, reading: NativeDeploymentObserved) -> ObservationAttempt<NativeDeploymentObserved, NonEmptyStr> {
  ObservationEstablished { observed: reading }
}

fn inspect_native_deployment(subject: NonEmptyStr, plan: ArmLaunchPlan, reading: NativeDeploymentObserved) -> NativeDeploymentInspection {
  inspect_goal(
    subject: subject,
    goal: plan,
    request: reading,
    observe: observe_deployment,
    assess: assess_native_deployment,
  )
}

// ── WHETHER A CUTOVER MAY BE ACCEPTED ──────────────────────────────────────────────────────────
//
// ACCEPTANCE REQUIRES AGREEMENT AND NOTHING WEAKER. An indeterminate readback is not an acceptable
// deployment: it means a fact the receipt promises was never established, and a transaction that
// completed on it would record a claim nobody checked. That is the same precedence std.goal_assessment
// gives unknowns over deviations, applied to the decision this readback exists to inform.
type DeploymentAcceptance
  = DeploymentAccepted { receipt: DeploymentReceipt }
  | DeploymentRejected { deviations: List<DeploymentDeviation> }
  | DeploymentUnverified { unknowns: List<DeploymentUnknown> }
  | DeploymentUnverifiable { cause: NonEmptyStr }

fn accept_deployment(inspection: NativeDeploymentInspection) -> DeploymentAcceptance {
  match inspection {
    GoalObservationRefused { subject: _, goal: _, request: _, cause: c } => DeploymentUnverifiable { cause: c }
    GoalInspected { subject: _, goal: _, request: _, observed: _, assessment: a } =>
      match a {
        GoalAssessmentRefused { cause: _ } => DeploymentUnverifiable { cause: "no planned deployment to verify against" as NonEmptyStr }
        GoalSatisfied { evidence: r } => DeploymentAccepted { receipt: r }
        GoalIndeterminate { known_deviations: _, unknowns: us } => DeploymentUnverified { unknowns: non_empty_to_list(xs: us) }
        GoalDiverged { deviations: ds } => DeploymentRejected { deviations: non_empty_to_list(xs: ds) }
      }
  }
}

// ── A REFUSAL THAT DISCARDS ITS OWN CAUSE IS HALF A REFUSAL ───────────────────────────────────
//
// THE UNKNOWNS AND DEVIATIONS ARE COMPUTED AND WERE THROWN AWAY. gunbc.spark.native_cutover_wet bound
// both lists to `_` and rolled back with a sentence naming neither, so a reader was told that some fact
// could not be established and never which one. Measured 2026-09-13: a cutover whose engine had already
// answered GET /v1/models with 200 OK on rank zero refused with "the deployment readback could not
// establish every fact it must assert", and nothing in the output distinguished an unread fabric
// interface on one rank from an unread endpoint alias -- two facts with entirely different repairs.
//
// THE DATA EXISTED THE WHOLE TIME, which is what makes this worth fixing rather than investigating: the
// assessment already carries typed values naming the rank and the missing reading. Rendering them costs
// nothing and turns a second twenty-minute launch into a sentence.
fn deployment_unknown_text(u: DeploymentUnknown) -> String {
  match u {
    FabricInterfaceUnread { node_rank: r } =>
      join(["rank ", to_string(r), ": the selected fabric interface could not be read"], "")
    FabricOutOfBandUnread { node_rank: r } =>
      join(["rank ", to_string(r), ": the verbs selection named no out-of-band interface"], "")
    EndpointAliasUnread => "the endpoint's served model alias could not be read"
  }
}

fn deployment_deviation_text(d: DeploymentDeviation) -> String {
  match d {
    RankAbsent { expected_rank: r, expected_host: h } =>
      join(["rank ", to_string(r), " expected on ", h as String, " is absent"], "")
    RankOnWrongHost { node_rank: r, expected_host: e, observed_host: o } =>
      join(["rank ", to_string(r), " expected on ", e as String, " observed on ", o as String], "")
    RankImageDigestDiffers { node_rank: r, desired: de, observed: o } =>
      join(["rank ", to_string(r), " image ", o as String, " is not the planned ", de as String], "")
    RankModelPathDiffers { node_rank: r, desired: de, observed: o } =>
      join(["rank ", to_string(r), " model path ", o as String, " is not the planned ", de as String], "")
    RankArgvDiffers { node_rank: r, first_difference_position: p, desired_word_count: dw, observed_word_count: ow } =>
      join(["rank ", to_string(r), " argv differs first at word ", to_string(p), " (planned ", to_string(dw), " words, observed ", to_string(ow), ")"], "")
    RankFabricInterfaceDiffers { node_rank: r, desired: de, observed: o } =>
      join(["rank ", to_string(r), " fabric interface ", o as String, " is not the planned ", de as String], "")
    DeploymentNotServing { detail: t } => join(["the deployment is not serving: ", t as String], "")
    EndpointAliasDiffers { desired: de, observed: o } =>
      join(["the endpoint serves ", o as String, " rather than the planned ", de as String], "")
    DuplicateObservedRank { node_rank: r, observations: n } =>
      join(["rank ", to_string(r), " was observed ", to_string(n), " times and a rank is one process"], "")
    UnexpectedObservedRank { node_rank: r } =>
      join(["rank ", to_string(r), " is running and the plan names no such rank"], "")
    RankRealizationDiffers { deviation: d } => realization_deviation_text(d: d)
  }
}

fn deployment_unknowns_text(us: List<DeploymentUnknown>) -> String {
  join(map(us, u => deployment_unknown_text(u: u)), "; ")
}

fn deployment_deviations_text(ds: List<DeploymentDeviation>) -> String {
  join(map(ds, d => deployment_deviation_text(d: d)), "; ")
}
