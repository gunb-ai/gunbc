// ── THE BOUNDED EXPERIMENT'S ACTUATION, AS ONE EXECUTION CELL ────────────────────────────────────
//
// THE VERTICAL'S ACT LEG. THE ADMISSION IS THE WHOLE SAFETY ARGUMENT: this route refuses unless the
// caller holds a FitUnestablished verdict WITH NAMED OPEN OBLIGATIONS and the typed experiment plan
// whose targets cover exactly those obligations — a Proved verdict has no unknowns worth a wet run,
// a Refused verdict has nothing a measurement can rescue, and a plan that skips an open obligation
// mints a receipt set that cannot re-prove the arm. THE WET ENTRY EXISTS AND IS NOT RUN: the owner's
// go is the gate, not the entry's existence.
//
// THE LEGS ARE AN EXECUTION CELL, NOT A START-SCRIPT SEQUENCE (owner directive 2026-09-25,
// docs/plans/execution-cell-contract.md). The actuation runs the contract's phase order through the
// systemd/Docker realization (gunbc.spark.systemd_execution_cell, the contract in
// gunbc.spark.execution_cell): prior-generation inventory, quiescence, disposal, manager-state
// settlement, and readback run on every rank BEFORE any preparation, because the Sep-25 run-2
// receipts show a tripped start-rate counter and an orphan container blocking start admission
// downstream of every cleanup hook the new unit carries. Preparation then installs every rank's
// rendered unit and starts NOTHING; a preparation failure on any rank activates none. Activation is
// the cohort verb — four non-blocking starts the run-3 receipts demanded, so the ranks and head are
// alive together for the first time — and the readback phase then waits the profile pass on EVERY
// host: the head leg holds the cohort's memory-profile anchor, and one leg per rank host holds
// that host's own per-rank profile line, every leg bounded by the plan's one admitted duration
// shared across the cohort. Only after all four readbacks succeed do the deterministic stop legs
// run. A rank that fails after others started rolls the started ranks back before the route
// refuses; a rank that dies before printing its profile line fails its own host's readback leg and
// rolls the cohort back the same way. Success is one exact generation — the launch-profile hash
// every unit renders from — observed across all four ranks, and the observation IS the readback
// holding on every host's own profile line.
//
// THE TRUST BRACKET IS THE PAIR APPLY'S, unchanged: the same credential materialization, the same
// fleet known-hosts anchor, the same spark_pair_privileged_leg transport, because a third spelling
// of that bracket would be a third place a credential file can outlive its use. Only the leg
// vocabulary and the sequencing changed.
data spark_native_experiment_apply_receipt_path: String = "target/spark-native-experiment-apply-receipt.txt"

data spark_native_experiment_apply_attempt_raw: String = "spark-native-experiment-apply"

// THE MEMORY-PROFILE ANCHOR, spelled where the readback script and the parser can be
// compared: the head readback greps for the exact prefix extdeps.vllm.memory_profile parses
// ("Desired GPU memory utilization is ("), so a captured line is parseable by construction rather
// than by hope. The head is the rank whose log the cohort anchor waits on: rank 0 exports the
// endpoint and its profiling line is the one the receipt layer classifies.
data spark_native_experiment_profile_anchor: String = "Desired GPU memory utilization is ("

// THE RANK PROFILE ANCHOR: the per-rank worker line's stable prefix — the same prefix
// extdeps.vllm.log_lines cites for MemoryProfileSummary, and the line the 64K wet bundle quotes
// from gpu_worker.py:867. Every rank host prints its own in its own rank log on its own clock:
// the Sep-25 262144x6 run printed the head's anchor at 19:41:57 and ranks 1-3's lines tens of
// seconds later, after the stops had fired on the one-head readback — the gap that left the
// byte-wall subproof open on ranks 1-3 (gunbc commit 0fd1d463f5's message). The rank readback
// legs wait this prefix in each rank host's own log; the head leg keeps the cohort anchor above
// (the head unit's worker is rank 0, so the head's log carries its line too).
data spark_native_experiment_rank_profile_anchor: String = "Free memory on device"

// ── THE COHORT'S MEMBERS AND THE PER-PHASE LEGS ──────────────────────────────────────────────────

// ONE MEMBER PER RANK: the host, and the rendered bounded-experiment unit for it. The render is
// the cohort's one generation made concrete — every unit renders from the same launch profile, so
// the profile hash is the generation identity and it appears on every member by construction.
fn spark_experiment_member(host: HostIdentity, render: GlmNativeUnitRender) -> SystemdExecutionMember? {
  match render {
    GlmNativeUnitRenderRefused { unit_name: _, cause: _ } => none
    GlmNativeUnitRendered { unit_name: name, text: text } =>
      Present { value: SystemdExecutionMember {
        host: host,
        unit_name: name,
        container_name: glm_native_container_name,
        log_path: if (name as String) == (glm_native_head_unit_name as String) { glm_native_head_log_path } else { glm_native_rank_log_path },
        unit_text: text,
      } }
  }
}

// THE ROSTER, OR NOTHING. One member per (host, render); a render that refused anywhere refuses the
// whole actuation before it reaches for a credential, exactly as the pre-reshape route refused.
fn spark_experiment_members(hosts: List<HostIdentity>, renders: List<GlmNativeUnitRender>) -> List<SystemdExecutionMember>? {
  let pairs = zip_map(a: hosts, b: renders, f: fn(h, r) { spark_experiment_member(host: h, render: r) })
  if any(pairs, p => match p { Absent => true  Present { value: _ } => false }) {
    none
  } else {
    Present { value: flat_map(pairs, p => match p { Absent => [] as List<SystemdExecutionMember>  Present { value: v } => [v] }) }
  }
}

// AN ACTUATION, PLANNED FOR THE TRANSPORT. The realization renders the shell; the plan is what
// spark_pair_privileged_leg runs. The two carry the same host and unit, so the leg that runs is the
// leg the cell rendered, byte for byte.
fn spark_plan_of_actuation(a: ExecutionCellActuation<SystemdExecutionMember>) -> SparkPairHostApplyPlan {
  SparkPairHostApplyPlan {
    host: a.member.host,
    unit_name: a.member.unit_name,
    script: a.body,
  }
}

// A RUNTIME LEG OUTCOME, FOLDED BACK INTO THE CONTRACT'S RESULT. A leg that applied actuated its
// actuation; a leg that failed refuses with the phase's own variant, so the cohort verdicts that
// consume this fold see a located, per-phase refusal rather than a bare boolean. The cause carries
// a fixed nonempty prefix because the refusal carrier demands a located cause, never an empty one.
fn spark_refusal_for_phase(phase: ExecutionCellPhase, member: SystemdExecutionMember, detail: String) -> ExecutionCellRefusal<SystemdExecutionMember> {
  let cause = join(["leg failed: ", detail], "") as NonEmptyStr
  match phase {
    CellPhaseInventory => ExecutionCellInventoryRefused { member: member, cause: cause }
    CellPhaseQuiescence => ExecutionCellQuiescenceRefused { member: member, cause: cause }
    CellPhaseDisposal => ExecutionCellDisposalRefused { member: member, cause: cause }
    CellPhaseSettlement => ExecutionCellSettlementRefused { member: member, cause: cause }
    CellPhaseReadback => ExecutionCellReadbackRefused { member: member, cause: cause }
    CellPhasePreparation => ExecutionCellPreparationRefused { member: member, cause: cause }
    CellPhaseActivation => ExecutionCellActivationRefused { member: member, cause: cause }
    CellPhaseRollback => ExecutionCellRollbackRefused { member: member, cause: cause }
  }
}

fn spark_result_of_outcome(actuation: ExecutionCellActuation<SystemdExecutionMember>, outcome: SparkPairHostApplyOutcome) -> ExecutionCellPhaseResult<SystemdExecutionMember> {
  match outcome {
    SparkPairHostApplied { host: _, detail: _, standing: _ } => ExecutionCellActuated { actuation: actuation }
    SparkPairHostApplyFailed { host: _, cause: c } =>
      ExecutionCellPhaseRefused { refusal: spark_refusal_for_phase(phase: actuation.phase, member: actuation.member, detail: c) }
  }
}

// ── THE ADMISSION ────────────────────────────────────────────────────────────────────────────────

// ONE PROFILE-READBACK LEG: the member it observes — the host the leg runs on and whose log it
// greps — beside the plan the transport runs. Carrying the member beside the plan is what lets a
// failed leg's refusal name its host, exactly as a failed activation leg's refusal names the
// member that refused.
type SparkProfileReadbackLeg {
  member: SystemdExecutionMember
  plan: SparkPairHostApplyPlan
}

// THE PROFILE-READBACK VERDICT, the readback phase's analogue of the preparation and activation
// verdicts: every readback leg must hold — the head's cohort anchor AND each rank's own profile
// line — before the run converges. The first leg that fails halts the phase with a refusal located
// twice: the member names the host, and the variant names the phase — the head's anchor wait or a
// rank's own-profile wait. The route rolls the started cohort back on a halt exactly as a failed
// activation leg does.
type SparkProfileReadbackRefusal
  = SparkHeadProfileReadbackRefused { member: SystemdExecutionMember, cause: NonEmptyStr }
  | SparkRankProfileReadbackRefused { member: SystemdExecutionMember, cause: NonEmptyStr }

type SparkProfileReadbackVerdict
  = SparkProfileReadbacksConverged
  | SparkProfileReadbackHalted { refusal: SparkProfileReadbackRefusal }

// THE ADMITTED ARM, as an execution cell. Every leg the route will run is present, grouped by
// phase in contract order, so the dry entry renders the whole shape and the wet entry folds the
// runtime outcomes back through the cohort verdicts. The generation and the admitted seconds are
// carried so the route and the receipt name exactly what was converged and how long it had.
type ArmExperimentActuationAdmission
  = ArmExperimentActuationAdmitted {
      cohort: ExecutionCellCohort<SystemdExecutionMember>,
      prior_generation_actuations: List<ExecutionCellActuation<SystemdExecutionMember>>,
      preparation_actuations: List<ExecutionCellActuation<SystemdExecutionMember>>,
      activation_actuations: List<ExecutionCellActuation<SystemdExecutionMember>>,
      head_readback: SparkProfileReadbackLeg,
      rank_readbacks: List<SparkProfileReadbackLeg>,
      stop_legs: List<SparkPairHostApplyPlan>,
      admitted_seconds: Nat,
    }
  | ArmExperimentActuationRefused { cause: NonEmptyStr }

// THE ADMISSION, as the review's contract states it: the verdict must be FitUnestablished WITH
// named obligations (an empty obligation list means nothing is unknown, and a wet run would
// measure nothing); the plan must name THIS subject and target EXACTLY the subject's open
// components — every one, because the receipt set the run mints must be able to re-prove the arm,
// and a plan that skips an open obligation mints a set that cannot. Past that wall, the actuation
// is built as a cohort: the roster renders, the generation mints from the plan's launch profile,
// and the realization renders the phase-ordered legs.
fn arm_experiment_actuation_admission(
  checkpoint: ServingCheckpoint,
  runtime: ServingRuntime,
  topology: ServingTopology,
  verdict: ArmMemoryFitVerdict,
  plan: ArmMemoryExperimentPlan?,
) -> ArmExperimentActuationAdmission {
  match verdict {
    ArmMemoryFitProved { rank: _, phase: _, headroom_bytes: _ } =>
      ArmExperimentActuationRefused { cause: "the actuation requires a FitUnestablished verdict with named open obligations; this subject is PROVED, so there is nothing a wet experiment measures that the proof does not already establish" as NonEmptyStr }
    ArmMemoryFitRefused { rank: _, phase: _, demand_lower: _, supply_upper: _, cause: c } =>
      ArmExperimentActuationRefused { cause: join(["the actuation requires a FitUnestablished verdict with named open obligations; this subject is REFUSED (", c as String, "), and a shape that cannot fit has nothing a measurement can rescue"], "") as NonEmptyStr }
    ArmMemoryFitUnestablished { obligations: os } =>
      match length(os) == 0 {
        true => ArmExperimentActuationRefused { cause: "the verdict is Unestablished with NO named obligations, which names nothing to measure: an actuation without named unknowns is a service run wearing an experiment's name" as NonEmptyStr }
        false =>
          match plan {
            Absent => ArmExperimentActuationRefused { cause: "the actuation requires a typed experiment plan alongside the unestablished verdict: the plan is what makes the run the smallest measuring configuration rather than a service by another name" as NonEmptyStr }
            Present { value: plan } =>
              match plan.checkpoint == checkpoint && plan.runtime == runtime && plan.topology == topology {
                false => ArmExperimentActuationRefused { cause: "the experiment plan names a different checkpoint, runtime or topology than the actuation was asked to run: the plan and the actuation must be one subject" as NonEmptyStr }
                true =>
                  match arm_memory_fit_subject_for_launch(checkpoint: checkpoint, runtime: runtime, topology: topology, profile: plan.profile) {
                    ArmMemorySubjectRefused { cause: c } => ArmExperimentActuationRefused { cause: c }
                    ArmMemorySubjectReady { subject: subject } =>
                      let open = arm_memory_subject_open_components(subject: subject)
                      let missing = filter(open, c => !any(plan.targets, t => t == c))
                      match length(missing) > 0 {
                        true =>
                          ArmExperimentActuationRefused {
                            cause: join([
                              "the experiment plan does not target every open obligation: missing ",
                              join(map(missing, c => arm_memory_component_wire(c: c)), ", "),
                              ". The receipts one run mints must be able to re-prove this arm, and a plan that skips an open obligation mints a set that cannot",
                            ], "") as NonEmptyStr,
                          }
                        false =>
                          let hosts = glm_native_ranked_hosts()
                          let renders = glm_native_experiment_all_unit_renders()
                          match spark_experiment_members(hosts: hosts, renders: renders) {
                            Absent => ArmExperimentActuationRefused { cause: "an experiment unit did not render, so no host was touched: the actuation renders before it reaches for a credential" as NonEmptyStr }
                            Present { value: members } =>
                              let generation = execution_generation_of_intent(intent_key: serving_launch_profile_key(p: plan.profile))
                              match execution_cell_cohort_admit(members: members, generation: generation, member_key: systemd_member_key) {
                                ExecutionCellCohortRefused { cause: c } => ArmExperimentActuationRefused { cause: c }
                                ExecutionCellCohortAdmitted { cohort: cohort } =>
                                  spark_experiment_actuation_admit(cohort: cohort, plan: plan)
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

// THE LEGS, RENDERED THROUGH THE REALIZATION. The prior-generation phases run per member in
// contract order (inventory, quiescence, disposal, settlement, readback), then preparation per
// member, then the cohort's non-blocking activation per member — the list the order law checks.
// Every leg is rendered by the realization's own verb, so the legs the dry entry shows are the
// legs the realization inhabits, not a parallel spelling.
fn spark_experiment_actuation_admit(cohort: ExecutionCellCohort<SystemdExecutionMember>, plan: ArmMemoryExperimentPlan) -> ArmExperimentActuationAdmission {
  let realization = systemd_execution_realization()
  let identity = ExecutionOperationIdentity { attempt: spark_native_experiment_apply_attempt_raw, generation: cohort.generation }
  let ops = map(cohort.members, m => ExecutionCellOperation { member: m, identity: identity })
  let prior_generation_actuations = concat(
    spark_actuations_of(verb: realization.inventory, ops: ops),
    concat(
      spark_actuations_of(verb: realization.quiescence, ops: ops),
      concat(
        spark_actuations_of(verb: realization.disposal, ops: ops),
        concat(
          spark_actuations_of(verb: realization.settlement, ops: ops),
          spark_actuations_of(verb: realization.readback, ops: ops)))))
  let preparation_actuations = spark_actuations_of(verb: realization.prepare, ops: ops)
  let activation_actuations = spark_actuations_of(verb: realization.activate, ops: ops)
  match spark_head_readback_leg(cohort: cohort, admitted_seconds: plan.max_runtime_seconds) {
    Absent => ArmExperimentActuationRefused { cause: "the cohort admitted no head member, so no head readback leg could be planned: the convergence witness needs the head's log" as NonEmptyStr }
    Present { value: head_readback } =>
      ArmExperimentActuationAdmitted {
        cohort: cohort,
        prior_generation_actuations: prior_generation_actuations,
        preparation_actuations: preparation_actuations,
        activation_actuations: activation_actuations,
        head_readback: head_readback,
        rank_readbacks: spark_rank_readback_legs(cohort: cohort, admitted_seconds: plan.max_runtime_seconds),
        stop_legs: map(cohort.members, m => spark_stop_plan_of_member(member: m)),
        admitted_seconds: plan.max_runtime_seconds,
      }
  }
}

// APPLY ONE VERB TO EVERY MEMBER AND KEEP THE ACTUATIONS. The systemd realization's verbs render
// purely, so they actuate at plan time; the count checks in the witnesses are what catch the
// plan-time-unreachable refusal arm (a verb that refused would drop its actuation and the count
// would fall short of the roster).
fn spark_actuations_of(verb: fn(ExecutionCellOperation<SystemdExecutionMember>) -> ExecutionCellPhaseResult<SystemdExecutionMember>, ops: List<ExecutionCellOperation<SystemdExecutionMember>>) -> List<ExecutionCellActuation<SystemdExecutionMember>> {
  flat_map(ops, op => match verb(op) {
    ExecutionCellActuated { actuation: a } => [a]
    ExecutionCellPhaseRefused { refusal: _ } => [] as List<ExecutionCellActuation<SystemdExecutionMember>>
  })
}

// THE HEAD'S READBACK LEG: the cohort's convergence anchor, waited in the head's log. The head
// member is the one whose unit renders the head unit name; a cohort that admitted no head member
// refuses the actuation before any credential is reached for, exactly as a missing render does.
fn spark_head_readback_leg(cohort: ExecutionCellCohort<SystemdExecutionMember>, admitted_seconds: Nat) -> SparkProfileReadbackLeg? {
  match first(filter(cohort.members, m => (m.unit_name as String) == (glm_native_head_unit_name as String))) {
    Absent => none
    Present { value: head } =>
      Present { value: SparkProfileReadbackLeg {
        member: head,
        plan: SparkPairHostApplyPlan {
          host: head.host,
          unit_name: head.unit_name,
          script: systemd_profile_readback_script(member: head, profile_anchor: spark_native_experiment_profile_anchor, admitted_seconds: admitted_seconds),
        },
      } }
  }
}

// ONE READBACK LEG PER RANK HOST, in cohort order. Each leg greps THAT host's own rank log for
// the rank profile line — the line the rank's own worker prints — so a rank that dies before
// printing fails THIS host's leg, and the halt is located on that host by construction. Every leg
// renders through the realization's one readback script with the same admitted seconds: the plan's
// one duration is shared across the cohort, not minted per leg.
fn spark_rank_readback_legs(cohort: ExecutionCellCohort<SystemdExecutionMember>, admitted_seconds: Nat) -> List<SparkProfileReadbackLeg> {
  map(
    filter(cohort.members, m => (m.unit_name as String) != (glm_native_head_unit_name as String)),
    m => SparkProfileReadbackLeg {
      member: m,
      plan: SparkPairHostApplyPlan {
        host: m.host,
        unit_name: m.unit_name,
        script: systemd_profile_readback_script(member: m, profile_anchor: spark_native_experiment_rank_profile_anchor, admitted_seconds: admitted_seconds),
      },
    })
}

// THE READBACK PHASE VERDICT. The head leg's outcome folds first — the rank legs are only issued
// once the head's anchor has appeared, so a failed head leg halts the phase with nothing issued
// beside it — and the first failed rank outcome halts the phase located on the leg that minted
// it. The leg is recovered through the cohort's own key, the host: execution_cell_cohort_admit
// refuses duplicate member keys and systemd_member_key IS the host, so a failed outcome's host
// names exactly one admitted leg. (The leg-outcome pairing is deliberately NOT spelled zip_map:
// measured 2026-09-25, a generic function's result feeding first/filter poisons their downstream
// instantiation in the current interpreter — first returns the bare head instead of the optional
// it declares — while first and filter over map/filter-built lists behave as declared. The
// host join says the same thing the zip would, on the cohort key the admission already vouches.)
// A leg fails exactly as the activation legs fail: the remote script exits non-zero, the
// transport reports SparkPairHostApplyFailed, and this fold maps it onto the typed refusal. All
// outcomes applied is the only converged arm; the unresolvable-host arm is unreachable from the
// route, whose rank outcomes are minted by exactly these legs.
fn spark_profile_readback_verdict(head_leg: SparkProfileReadbackLeg, head_outcome: SparkPairHostApplyOutcome, rank_legs: List<SparkProfileReadbackLeg>, rank_outcomes: List<SparkPairHostApplyOutcome>) -> SparkProfileReadbackVerdict {
  match head_outcome {
    SparkPairHostApplyFailed { host: _, cause: c } =>
      SparkProfileReadbackHalted { refusal: SparkHeadProfileReadbackRefused { member: head_leg.member, cause: c as NonEmptyStr } }
    SparkPairHostApplied { host: _, detail: _, standing: _ } =>
      match first(filter(rank_outcomes, o => match o { SparkPairHostApplyFailed { host: _, cause: _ } => true  SparkPairHostApplied { host: _, detail: _, standing: _ } => false })) {
        Present { value: SparkPairHostApplyFailed { host: failed_host, cause: c } } =>
          match first(filter(rank_legs, l => host_identity_eq(a: l.member.host, b: failed_host))) {
            Present { value: l } =>
              SparkProfileReadbackHalted { refusal: SparkRankProfileReadbackRefused { member: l.member, cause: c as NonEmptyStr } }
            Absent => SparkProfileReadbacksConverged
          }
        Present { value: SparkPairHostApplied { host: _, detail: _, standing: _ } } => SparkProfileReadbacksConverged
        Absent => SparkProfileReadbacksConverged
      }
  }
}

// THE HALT, RENDERED WHERE THE RECEIPT CAN CARRY IT. On a halt the route has already rolled the
// started cohort back; this wire is the located one-liner the failure reason names beside the full
// outcome body — host from the member, phase from the variant.
fn spark_profile_readback_halt_wire(r: SparkProfileReadbackRefusal) -> String {
  match r {
    SparkHeadProfileReadbackRefused { member: m, cause: c } => join(["profile readback halted on head ", m.host as String, ": ", c as String, "\n"], "")
    SparkRankProfileReadbackRefused { member: m, cause: c } => join(["profile readback halted on rank ", m.host as String, ": ", c as String, "\n"], "")
  }
}

// THE DETERMINISTIC END, ONE STOP LEG PER MEMBER. `systemctl stop` runs the unit's ExecStop and
// ExecStopPost, so the experiment ends on every rank leaving no container holding pool bytes; the
// same plan is the rollback leg for a partially activated cohort's started members.
fn spark_stop_plan_of_member(member: SystemdExecutionMember) -> SparkPairHostApplyPlan {
  SparkPairHostApplyPlan {
    host: member.host,
    unit_name: member.unit_name,
    script: systemd_rollback_script(member: member),
  }
}

// ── THE ROUTE ────────────────────────────────────────────────────────────────────────────────────
//
// THE SEQUENCING THE RECEIPTS DEMAND, as one fold-friendly spine the wet entry drives with its
// privileged leg. Prior-generation legs must all apply before anything prepares; a preparation
// halt starts none; a partial activation rolls its started members back before the route refuses;
// a converged activation takes the readback phase — the head's anchor leg, then one per-rank
// profile leg, each issued only after the head's anchor has appeared — and then stops every rank
// however the measurement went: the stops are the deterministic end on convergence and the
// rollback on a readback halt, and they are the same legs because a converged cohort started
// every member. The full outcome list is returned so the receipt records every leg that ran, and
// the halt carries the located readback refusal when the phase ran and did not converge — absent
// everywhere else, because a phase that was never reached mints no verdict about it.
type SparkExperimentRouteResult {
  outcomes: List<SparkPairHostApplyOutcome>
  halt: SparkProfileReadbackRefusal?
}

fn spark_experiment_route(
  prior_generation_actuations: List<ExecutionCellActuation<SystemdExecutionMember>>,
  preparation_actuations: List<ExecutionCellActuation<SystemdExecutionMember>>,
  activation_actuations: List<ExecutionCellActuation<SystemdExecutionMember>>,
  head_readback: SparkProfileReadbackLeg,
  rank_readbacks: List<SparkProfileReadbackLeg>,
  stop_legs: List<SparkPairHostApplyPlan>,
  run_leg: fn(SparkPairHostApplyPlan) -> SparkPairHostApplyOutcome,
) -> SparkExperimentRouteResult {
  let prior_outcomes = map(prior_generation_actuations, a => run_leg(spark_plan_of_actuation(a: a)))
  if !spark_pair_apply_all_applied(outcomes: prior_outcomes) {
    SparkExperimentRouteResult { outcomes: prior_outcomes, halt: none }
  } else {
    let preparation_outcomes = map(preparation_actuations, a => run_leg(spark_plan_of_actuation(a: a)))
    match execution_cell_preparation_verdict(results: zip_map(a: preparation_actuations, b: preparation_outcomes, f: fn(a, o) { spark_result_of_outcome(actuation: a, outcome: o) })) {
      ExecutionCellPrepareHalted { prepared: _, refusal: _ } =>
        SparkExperimentRouteResult { outcomes: concat(prior_outcomes, preparation_outcomes), halt: none }
      ExecutionCellAllPrepared { actuations: _ } => {
        let activation_outcomes = map(activation_actuations, a => run_leg(spark_plan_of_actuation(a: a)))
        let activation = execution_cell_activation_verdict(results: zip_map(a: activation_actuations, b: activation_outcomes, f: fn(a, o) { spark_result_of_outcome(actuation: a, outcome: o) }))
        match activation {
          ExecutionCellConverged { started: _ } => {
            let head_outcome = run_leg(head_readback.plan)
            let rank_outcomes = match head_outcome {
              SparkPairHostApplied { host: _, detail: _, standing: _ } =>
                map(rank_readbacks, l => run_leg(l.plan))
              SparkPairHostApplyFailed { host: _, cause: _ } =>
                [] as List<SparkPairHostApplyOutcome>
            }
            let halt = match spark_profile_readback_verdict(head_leg: head_readback, head_outcome: head_outcome, rank_legs: rank_readbacks, rank_outcomes: rank_outcomes) {
              SparkProfileReadbacksConverged => none
              SparkProfileReadbackHalted { refusal: r } => Present { value: r }
            }
            let stop_outcomes = map(stop_legs, leg => run_leg(leg))
            SparkExperimentRouteResult {
              outcomes: concat(concat(prior_outcomes, preparation_outcomes), concat(activation_outcomes, concat([head_outcome], concat(rank_outcomes, stop_outcomes)))),
              halt: halt,
            }
          }
          ExecutionCellPartiallyActivated { started: _, refusal: _ } => {
            let rollback_outcomes = map(execution_cell_rollback_members(activation: activation), m => run_leg(spark_stop_plan_of_member(member: m)))
            SparkExperimentRouteResult { outcomes: concat(concat(prior_outcomes, preparation_outcomes), concat(activation_outcomes, rollback_outcomes)), halt: none }
          }
          ExecutionCellActivationRefusedBeforeStart { refusal: _ } =>
            SparkExperimentRouteResult { outcomes: concat(concat(prior_outcomes, preparation_outcomes), activation_outcomes), halt: none }
        }
      }
    }
  }
}

// ── THE DRY ENTRY ────────────────────────────────────────────────────────────────────────────────

fn spark_dry_actuation_line(a: ExecutionCellActuation<SystemdExecutionMember>) -> String {
  join([
    execution_cell_phase_wire(p: a.phase), " ", a.member.host as String, " ", a.member.unit_name as String, "\n",
    a.body, "\n",
  ], "")
}

// THE DRY ENTRY: renders the admission and its legs as text, touching nothing. This is what the
// operator reads before the go, and what the review reads as the actuation's shape: phases in
// contract order per host, the cohort activation shown as one concurrent step, the readback phase
// — the head's bounded anchor leg, then one bounded per-rank profile leg per rank host, every leg
// carrying the same shared bounded_seconds — and the deterministic stop.
fn spark_native_experiment_actuation_dry() -> String {
  match spark_native_experiment_default_actuation() {
    ArmExperimentActuationRefused { cause: c } => join(["REFUSED: ", c as String], "")
    ArmExperimentActuationAdmitted { cohort: cohort, prior_generation_actuations: prior, preparation_actuations: prep, activation_actuations: act, head_readback: head, rank_readbacks: ranks, stop_legs: stop, admitted_seconds: admitted } =>
      join([
        "EXECUTION CELL members=", to_string(length(cohort.members)), " generation=", serialize_content_hash(hash: cohort.generation.identity), "\n",
        join(map(prior, a => spark_dry_actuation_line(a: a)), ""),
        join(map(prep, a => spark_dry_actuation_line(a: a)), ""),
        "ACTIVATE COHORT concurrently (non-blocking starts; the readback phase follows)\n",
        join(map(act, a => spark_dry_actuation_line(a: a)), ""),
        "HEAD READBACK ", head.member.host as String, " ", head.plan.unit_name as String, " bounded_seconds=", to_string(admitted), "\n", head.plan.script, "\n",
        join(map(ranks, l => join(["RANK READBACK ", l.member.host as String, " ", l.plan.unit_name as String, " bounded_seconds=", to_string(admitted), "\n", l.plan.script, "\n"], "")), ""),
        "STOP (deterministic end on every rank)\n",
        join(map(stop, p => join(["STOP ", p.host as String, " ", p.unit_name as String, "\n", p.script, "\n"], "")), ""),
      ], "")
  }
}

// THE DEFAULT SUBJECT THE DRY ENTRY PRICES: the restoration intent's derived profile on the
// Group B tuple, planned as an experiment. The verdict and plan are computed here so the dry text
// is one spine; the wet entry below recomputes them rather than trusting a caller.
fn spark_native_experiment_default_actuation() -> ArmExperimentActuationAdmission {
  match group_b_restoration_executable() {
    Absent => ArmExperimentActuationRefused { cause: "the restoration intent refused, so no experiment subject exists" as NonEmptyStr }
    Present { value: executable } =>
      let profile = executable.profile
      match arm_memory_fit_subject_for_launch(checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10, topology: FourSparkTp4, profile: profile) {
        ArmMemorySubjectRefused { cause: c } => ArmExperimentActuationRefused { cause: c }
        ArmMemorySubjectReady { subject: subject } =>
          match arm_memory_fit_verdict(subject: subject) {
            ArmMemoryFitUnestablished { obligations: _ } =>
              match arm_memory_fit_experiment_plan(
                checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10, topology: FourSparkTp4,
                workload: subject.intent, policy_profile: profile, targets: arm_memory_subject_open_components(subject: subject)) {
                ArmMemoryExperimentAdmitted { plan: p } => arm_experiment_actuation_admission(
                  checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10, topology: FourSparkTp4,
                  verdict: arm_memory_fit_verdict(subject: subject), plan: Present { value: p })
                ArmMemoryExperimentRefused { cause: c } => ArmExperimentActuationRefused { cause: c }
              }
            other => arm_experiment_actuation_admission(
              checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10, topology: FourSparkTp4,
              verdict: other, plan: none)
          }
      }
  }
}

// ── THE WET ENTRY ────────────────────────────────────────────────────────────────────────────────
//
// THE WET ENTRY. Built, reviewed, and NOT RUN: the owner's go is the gate. The trust bracket is
// the pair apply's exactly — the same credential materialization, the same known-hosts anchor, the
// same privileged leg — and the sequencing inside is the execution-cell route: prior-generation
// legs, then all preparations, then the cohort's non-blocking activations with the per-rank
// readback phase, rolling the started ranks back on any failure before the receipt records the
// outcome.
fn spark_native_experiment_apply_wet() -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  match spark_native_experiment_default_actuation() {
    ArmExperimentActuationRefused { cause: c } => exit_failure(reason: c as String)
    ArmExperimentActuationAdmitted { cohort: _, prior_generation_actuations: prior, preparation_actuations: prep, activation_actuations: act, head_readback: head, rank_readbacks: ranks, stop_legs: stop, admitted_seconds: _ } =>
      match observe_executor_reach() {
        ExecutorReachUnknown { cause: c } => exit_failure(reason: join(["spark_native_experiment_apply: ", c], ""))
        ExecutorReachKnown { short_hostname: executor, path: path } =>
          match read_bootstrap_credential() {
            BootstrapCredentialNotMaterialized { cause: c } => exit_failure(reason: c as String)
            BootstrapCredentialReady { secret: administrator } =>
              match fleet_ssh_attempt_identity(raw: spark_native_experiment_apply_attempt_raw) {
                Absent => exit_failure(reason: "attempt identity is not a safe path segment")
                Present { value: attempt } => {
                  let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
                  match fleet_openssh_trust_policy_of(outcome: materialization) {
                    Absent => exit_failure(reason: join(["trust could not be established, so no leg ran: ", known_hosts_materialization_receipt(outcome: materialization)], ""))
                    Present { value: trust } =>
                      match with_materialized_ssh_key_file(
                        identity_file_name: "gunbc-spark-native-experiment-admin-password" as NonEmptyStr,
                        secret_bytes: administrator as Secret,
                        use: fn(file) {
                          let run_leg = fn(plan) { spark_pair_privileged_leg(trust: trust, path: path, plan: plan, admin_credential: administrator as Secret, admin_credential_file: file) }
                          spark_experiment_route(
                            prior_generation_actuations: prior,
                            preparation_actuations: prep,
                            activation_actuations: act,
                            head_readback: head,
                            rank_readbacks: ranks,
                            stop_legs: stop,
                            run_leg: run_leg)
                        },
                      ) {
                        MaterializedSshKeyFileBracketRefused { cause: c } => exit_failure(reason: c as String)
                        MaterializedSshKeyFileBracketCompleted { value: result } => {
                          let body = spark_pair_apply_receipt_body(at: probed_at_word(reading: now) as String, executor: executor, path: path, outcomes: result.outcomes)
                          let wr = Filesystem.Write(path: spark_native_experiment_apply_receipt_path, content: body)
                          let located = match result.halt {
                            Present { value: refusal } => spark_profile_readback_halt_wire(r: refusal)
                            Absent => ""
                          }
                          if !wr.success {
                            exit_failure(reason: join(["spark native experiment apply receipt write failed: ", wr.error], ""))
                          } else if spark_pair_apply_all_applied(outcomes: result.outcomes) {
                            ExitSuccess
                          } else {
                            exit_failure(reason: join(["spark native experiment apply did not converge:\n", body, located], ""))
                          }
                        }
                      }
                  }
                }
              }
          }
      }
  }
}
