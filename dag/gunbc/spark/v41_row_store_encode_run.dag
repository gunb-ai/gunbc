// ── THE ENCODE RUN: THE EIGHT STORES ON ONE MATERIALIZED SPARK, AND THEIR DIGESTS ─────────────
//
// The dispatched realization gunbc.spark.v41_row_store_encode declared as its frontier. On ONE Group A
// host that holds the verified shards (gunbc.spark.v41_checkpoint_materialize put them at
// v41_checkpoint_directory), for every store v41_store_encode_plan derives from the live spec:
//   - an OUT already present is a COMPLETE store (the program renames OUT.part to OUT only when done),
//     so it is not re-encoded;
//   - otherwise the admitted host program is run over the shard with the plan's operands;
//   - then sha256sum reads OUT, and the receipt carries one line per (layer, rank).
// THIS DOOR IS THE INSTRUMENT of gunbc.spark.v41_engram_row_store v41_published_store_readings: its
// receipt (v41_encode_run_receipt_path) is printed into the spark_v41_row_store_encode fleet-converge
// step's log on success, and on failure its body reaches the log through exit_failure; a Read row is
// transcribed from that run's log, citing the run id. It is not uploaded as an artifact; v41_identify_row_store then admits exactly the declared eight. All eight
// are encoded on the one host because the digests are host-independent; placing each rank's pair on
// its own host is staging, a later step (gunbc.spark.v41_engram_staging).

data v41_encode_run_attempt_raw: String = "v41-row-store-encode"
data v41_encode_run_receipt_path: String = "target/v41-row-store-encode-receipt.txt"

// ONE STORE'S OUTCOME, AS A CLOSED SUM (review 70572): present-and-read, encoded-and-read, encoded but
// the digest read failed, or the encode itself failed. No arm carries a digest it did not read.
type V41StoreRun
  = V41StorePresent { store: V41StoreEncodeArgs, digest: Sha256Digest, size: ByteSize }
  | V41StoreEncoded { store: V41StoreEncodeArgs, digest: Sha256Digest, size: ByteSize }
  | V41StoreSizeMismatch { store: V41StoreEncodeArgs, digest: Sha256Digest, observed: ByteSize, derived: ByteSize }
  | V41StoreSizeUnread { store: V41StoreEncodeArgs, digest: Sha256Digest, cause: NonEmptyStr }
  | V41StoreDigestUnread { store: V41StoreEncodeArgs, encoded: Bool, cause: NonEmptyStr }
  | V41StoreEncodeFailed { store: V41StoreEncodeArgs, cause: NonEmptyStr }
  | V41StorePresenceFailed { store: V41StoreEncodeArgs, cause: NonEmptyStr }

fn v41_store_of(r: V41StoreRun) -> V41StoreEncodeArgs {
  match r {
    V41StorePresent { store: a, digest: _, size: _ } => a
    V41StoreEncoded { store: a, digest: _, size: _ } => a
    V41StoreSizeMismatch { store: a, digest: _, observed: _, derived: _ } => a
    V41StoreSizeUnread { store: a, digest: _, cause: _ } => a
    V41StoreDigestUnread { store: a, encoded: _, cause: _ } => a
    V41StoreEncodeFailed { store: a, cause: _ } => a
    V41StorePresenceFailed { store: a, cause: _ } => a
  }
}

// ONLY A STORE WHOSE DIGEST WAS READ AND WHOSE SIZE MATCHES THE LAYOUT counts as digested.
fn v41_store_run_digest(r: V41StoreRun) -> Sha256Digest? {
  match r {
    V41StorePresent { store: _, digest: d, size: _ } => Present { value: d }
    V41StoreEncoded { store: _, digest: d, size: _ } => Present { value: d }
    _ => none
  }
}

type V41DigestRead
  = V41DigestReadOk { digest: Sha256Digest }
  | V41DigestReadFailed { cause: NonEmptyStr }

fn v41_store_digest(ctx: SparkMaterializeContext, out: NonEmptyStr) -> V41DigestRead {
  match spark_remote_run(ctx: ctx, argv: sha256sum_argv(path: out as String)) {
    RemoteUnreachable { cause: c } => V41DigestReadFailed { cause: join(["the sha256sum leg did not run: ", c], "") as NonEmptyStr }
    RemoteRan { exit_code: code, stdout: s, stderr: err } =>
      if code != 0 { V41DigestReadFailed { cause: join(["sha256sum exited ", to_string(code), ": ", trim(s: err)], "") as NonEmptyStr } } else {
        match sha256sum_line_digest(line: s) {
          Absent => V41DigestReadFailed { cause: join(["sha256sum answered no digest: ", s], "") as NonEmptyStr }
          Present { value: d } => match sha256_hex_digest(hex: d.hex as String) {
            Absent => V41DigestReadFailed { cause: "sha256sum answered a digest that is not lowercase sha256 hex" as NonEmptyStr }
            Present { value: h } => V41DigestReadOk { digest: h }
          }
        }
      }
  }
}

// PRESENCE IS THREE-VALUED (review 70586): `test -f` exits 0 for a regular file and 1 for none; any other
// exit, or a leg that did not run, is a check that FAILED -- never read as absent, because absent sends
// the store to be encoded and a failed check would then re-encode a complete store and misreport it.
type V41StorePresence
  = V41StoreFound
  | V41StoreAbsent
  | V41StorePresenceUnread { cause: NonEmptyStr }

fn v41_store_presence_of(exit_code: Int, stderr: String) -> V41StorePresence {
  if exit_code == 0 { V41StoreFound } else if exit_code == 1 { V41StoreAbsent } else {
    V41StorePresenceUnread { cause: join(["test -f exited ", to_string(exit_code), ": ", trim(s: stderr)], "") as NonEmptyStr }
  }
}

fn v41_store_present(ctx: SparkMaterializeContext, out: NonEmptyStr) -> V41StorePresence {
  match spark_remote_run(ctx: ctx, argv: ["test", "-f", out as String]) {
    RemoteUnreachable { cause: c } => V41StorePresenceUnread { cause: join(["the presence check did not run: ", c], "") as NonEmptyStr }
    RemoteRan { exit_code: code, stdout: _, stderr: err } => v41_store_presence_of(exit_code: code, stderr: err)
  }
}

// ONE STORE: encode if absent, then digest. A failed encode is its own arm and is not digested.
// THE SIZE A STORE MUST HAVE is the encode plan's (V41StoreEncodeArgs.expected_size, from
// gunbc.spark.v41_engram_row_store v41_store_size): the same formula the key checks, never re-derived here.
fn v41_store_expected_size(a: V41StoreEncodeArgs) -> ByteSize {
  a.expected_size
}

type V41SizeRead
  = V41SizeReadOk { size: ByteSize }
  | V41SizeReadFailed { cause: NonEmptyStr }

fn v41_store_size(ctx: SparkMaterializeContext, out: NonEmptyStr) -> V41SizeRead {
  match spark_remote_run(ctx: ctx, argv: ["stat", "-c", "%s", "--", out as String]) {
    RemoteUnreachable { cause: c } => V41SizeReadFailed { cause: join(["the stat leg did not run: ", c], "") as NonEmptyStr }
    RemoteRan { exit_code: code, stdout: o, stderr: err } =>
      if code != 0 { V41SizeReadFailed { cause: join(["stat exited ", to_string(code), ": ", trim(s: err)], "") as NonEmptyStr } } else {
        match parse_int(s: trim(s: o)) {
          Absent => V41SizeReadFailed { cause: join(["stat answered a size that is not a number: ", o], "") as NonEmptyStr }
          Present { value: n } => if n < 0 { V41SizeReadFailed { cause: "stat answered a negative size" as NonEmptyStr } } else { V41SizeReadOk { size: byte_size(count: n) } }
        }
      }
  }
}

// DIGEST, THEN SIZE, THEN THE LAYOUT CHECK (proud-deer-538, 2026-09-24): a store whose size is not the
// derived size is refused with both figures, never reported as digested.
fn v41_sized(a: V41StoreEncodeArgs, encoded: Bool, d: Sha256Digest, size: V41SizeRead) -> V41StoreRun {
  match size {
    V41SizeReadFailed { cause: c } => V41StoreSizeUnread { store: a, digest: d, cause: c }
    V41SizeReadOk { size: n } =>
      if byte_size_count(b: n) != byte_size_count(b: v41_store_expected_size(a: a)) {
        V41StoreSizeMismatch { store: a, digest: d, observed: n, derived: v41_store_expected_size(a: a) }
      } else if encoded { V41StoreEncoded { store: a, digest: d, size: n } } else { V41StorePresent { store: a, digest: d, size: n } }
  }
}

fn v41_digested(ctx: SparkMaterializeContext, a: V41StoreEncodeArgs, encoded: Bool, read: V41DigestRead) -> V41StoreRun {
  match read {
    V41DigestReadFailed { cause: c } => V41StoreDigestUnread { store: a, encoded: encoded, cause: c }
    V41DigestReadOk { digest: d } => v41_sized(a: a, encoded: encoded, d: d, size: v41_store_size(ctx: ctx, out: a.out))
  }
}

fn v41_run_store(ctx: SparkMaterializeContext, a: V41StoreEncodeArgs) -> V41StoreRun {
  match v41_store_present(ctx: ctx, out: a.out) {
    V41StorePresenceUnread { cause: c } => V41StorePresenceFailed { store: a, cause: c }
    V41StoreFound => v41_digested(ctx: ctx, a: a, encoded: false, read: v41_store_digest(ctx: ctx, out: a.out))
    V41StoreAbsent =>
      match spark_remote_run(ctx: ctx, argv: v41_store_encode_argv(shard_directory: v41_checkpoint_directory, a: a)) {
        RemoteUnreachable { cause: c } => V41StoreEncodeFailed { store: a, cause: join(["the encode leg did not run: ", c], "") as NonEmptyStr }
        RemoteRan { exit_code: code, stdout: _, stderr: err } =>
          if code != 0 {
            V41StoreEncodeFailed { store: a, cause: join(["the host program exited ", to_string(code), ": ", trim(s: err)], "") as NonEmptyStr }
          } else {
            v41_digested(ctx: ctx, a: a, encoded: true, read: v41_store_digest(ctx: ctx, out: a.out))
          }
      }
  }
}

fn v41_store_line(r: V41StoreRun) -> String {
  let a = v41_store_of(r: r)
  let head = join(["store ", v41_store_key(layer: a.layer, rank: a.rank)], "")
  let tail = join([" path=", a.out as String, "\n"], "")
  match r {
    V41StorePresent { store: _, digest: d, size: n } => join([head, " sha256=", d.hex as String, " size_bytes=", to_string(byte_size_count(b: n)), " present", tail], "")
    V41StoreEncoded { store: _, digest: d, size: n } => join([head, " sha256=", d.hex as String, " size_bytes=", to_string(byte_size_count(b: n)), " encoded", tail], "")
    V41StoreSizeMismatch { store: _, digest: d, observed: n, derived: e } => join([head, " SIZE-MISMATCH sha256=", d.hex as String, " size_bytes=", to_string(byte_size_count(b: n)), " derived_bytes=", to_string(byte_size_count(b: e)), " not keyed", tail], "")
    V41StoreSizeUnread { store: _, digest: d, cause: c } => join([head, " UNREAD size sha256=", d.hex as String, " the size read failed: ", c as String, tail], "")
    V41StoreDigestUnread { store: _, encoded: e, cause: c } => join([head, " UNREAD ", if e { "encoded" } else { "present" }, " but the digest read failed: ", c as String, tail], "")
    V41StoreEncodeFailed { store: _, cause: c } => join([head, " UNREAD encode failed: ", c as String, tail], "")
    V41StorePresenceFailed { store: _, cause: c } => join([head, " UNREAD presence check failed, nothing encoded: ", c as String, tail], "")
  }
}

type V41EncodeRun
  = V41EncodeRefusedBeforeRun { cause: NonEmptyStr }
  | V41EncodeRan { planned: List<V41StoreEncodeArgs>, stores: List<V41StoreRun> }

fn v41_encode_all(ctx: SparkMaterializeContext) -> V41EncodeRun {
  match v41_row_store_spec(population: map(deepseek_v4_1_flash_engram_sharded_entries, e => e.entry), partition: v41_candidate_partition, tables: deepseek_v4_1_flash_engram, head_sizes: v41_live_head_sizes(tables: deepseek_v4_1_flash_engram)) {
    V41RowStoreSpecRefused { defects: d } => V41EncodeRefusedBeforeRun { cause: join(["the row-store spec refused: ", join(map(d, x => x as String), "; ")], "") as NonEmptyStr }
    V41RowStoreSpecAdmitted { spec: spec } =>
      match v41_published_span_plan(partition: v41_candidate_partition, sharded: deepseek_v4_1_flash_engram_sharded_entries, shards: deepseek_v4_1_flash_engram_shard_files) {
        V41PublishedSpansUnplannable { defects: d } => V41EncodeRefusedBeforeRun { cause: join(["the span plan refused: ", join(map(d, x => x as String), "; ")], "") as NonEmptyStr }
        V41PublishedSpansPlanned { spans: spans } =>
          match v41_store_encode_plan(spec: spec, spans: spans) {
            V41StoreEncodeUnplannable { defects: d } => V41EncodeRefusedBeforeRun { cause: join(["the encode plan refused: ", join(map(d, x => x as String), "; ")], "") as NonEmptyStr }
            V41StoreEncodePlanned { stores: st } =>
              match spark_remote_run(ctx: ctx, argv: ["mkdir", "-p", v41_row_store_output_directory() as String]) {
                RemoteUnreachable { cause: c } => V41EncodeRefusedBeforeRun { cause: join(["the output directory could not be made: ", c], "") as NonEmptyStr }
                RemoteRan { exit_code: code, stdout: _, stderr: err } =>
                  if code != 0 { V41EncodeRefusedBeforeRun { cause: join(["mkdir of the output directory exited ", to_string(code), ": ", trim(s: err)], "") as NonEmptyStr } } else {
                    V41EncodeRan { planned: st, stores: map(st, a => v41_run_store(ctx: ctx, a: a)) }
                  }
              }
          }
      }
  }
}

// SUCCESS IS AN IDENTITY JOIN, NOT A COUNT (review 70572): every PLANNED (layer, rank) store has exactly
// one digested outcome, and no outcome names a store the plan does not.
fn v41_encode_succeeded(run: V41EncodeRun) -> Bool {
  match run {
    V41EncodeRefusedBeforeRun { cause: _ } => false
    V41EncodeRan { planned: p, stores: st } => {
      let digested = map(filter(st, r => match v41_store_run_digest(r: r) { Present { value: _ } => true  Absent => false }), r => v41_store_key(layer: v41_store_of(r: r).layer, rank: v41_store_of(r: r).rank))
      let planned = map(p, a => v41_store_key(layer: a.layer, rank: a.rank))
      let digested_index = v41_key_counts(keys: digested)
      let planned_index = v41_key_counts(keys: planned)
      length(planned) != 0
        && all(planned, k => v41_key_count(index: digested_index, key: k) == 1)
        && all(digested, d => v41_key_count(index: planned_index, key: d) == 1)
    }
  }
}

fn v41_encode_body(run: V41EncodeRun) -> String {
  match run {
    V41EncodeRefusedBeforeRun { cause: c } => join(["refused-before-run: ", c as String, "\n"], "")
    V41EncodeRan { planned: _, stores: st } => join(map(st, r => v41_store_line(r: r)), "")
  }
}

// THE FLEET-CONVERGE DOOR: `spark_v41_row_store_encode` with `target` naming ONE Group A Spark that holds
// the verified shards; the same admission as spark_v41_checkpoint_materialize.
fn v41_row_store_encode_ci_wet() -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  match spark_converge_target_selection(execute_apply: true) {
    SparkConvergeTargetRefused { reason: why } => exit_failure(reason: why)
    SparkConvergeTargetAllObserveOnly =>
      exit_failure(reason: "SPARK_CONVERGE_TARGET is unset: this mode encodes the V4.1 row stores on ONE host, so it refuses rather than choosing one")
    SparkConvergeTargetSingle { host: target_host } =>
      match admit_host_held_by_subject(raw: target_host, subject: PairServingUnitOn { group: FabricGroupA }) {
        Present { value: why } => exit_failure(reason: why)
        Absent =>
          match observe_executor_reach() {
            ExecutorReachUnknown { cause: c } => exit_failure(reason: join(["v41_row_store_encode_ci: ", c], ""))
            ExecutorReachKnown { short_hostname: executor, path: path } =>
              match read_bootstrap_credential() {
                BootstrapCredentialNotMaterialized { cause: c } => exit_failure(reason: c as String)
                BootstrapCredentialReady { secret: administrator } =>
                  match fleet_ssh_attempt_identity(raw: v41_encode_run_attempt_raw) {
                    Absent => exit_failure(reason: "attempt identity is not a safe path segment")
                    Present { value: attempt } => {
                      let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
                      match fleet_openssh_trust_policy_of(outcome: materialization) {
                        Absent => exit_failure(reason: join(["trust could not be established, so no leg ran: ", known_hosts_materialization_receipt(outcome: materialization)], ""))
                        Present { value: trust } =>
                          match with_materialized_ssh_key_file(
                            identity_file_name: "gunbc-v41-row-store-encode-admin-password" as NonEmptyStr,
                            secret_bytes: administrator as Secret,
                            use: fn(file) {
                              v41_encode_all(ctx: SparkMaterializeContext {
                                host: target_host,
                                trust: trust,
                                path: path,
                                admin_credential: administrator as Secret,
                                admin_credential_file: file,
                                executor: HostCli,
                              })
                            },
                          ) {
                            MaterializedSshKeyFileBracketRefused { cause: c } => exit_failure(reason: c as String)
                            MaterializedSshKeyFileBracketCompleted { value: run } => {
                              let body = join([
                                join(["v41 row store encode probed_at=", probed_at_word(reading: now) as String, " host=", target_host as String, " revision=", deepseek_v4_1_flash_revision as String, "\n"], ""),
                                v41_encode_body(run: run),
                                join(["executor=", executor, "\n"], ""),
                                known_hosts_materialization_receipt(outcome: materialization),
                              ], "")
                              let w = Filesystem.Write(path: v41_encode_run_receipt_path, content: body)
                              if !w.success {
                                exit_failure(reason: join(["v41 row store encode receipt write failed: ", w.error], ""))
                              } else if v41_encode_succeeded(run: run) {
                                ExitSuccess
                              } else {
                                exit_failure(reason: join(["not all eight row stores were encoded and read on ", target_host as String, ":\n", body], ""))
                              }
                            }
                          }
                      }
                    }
                  }
              }
          }
      }
  }
}
