module gunbc.spark.serving_cotenancy

import std.types { String, Bool, List, NonEmptyStr }
import std.measure { ByteSize, byte_size, byte_size_count }
import extdeps.memory.types { MemoryKind, Dram, Hbm, UnifiedShared }
import gunbc.spark.serving_release { ServingEngine, OllamaSingleHost, VllmTensorParallel }

// WHY A SECOND ENGINE ON ONE CELL IS THE WALL WORTH BUILDING.
//
// A Spark was wedged on 2026-09-03 and the accident was not the second engine's identity -- it was
// that TWO ENGINES SHARED ONE MEMORY POOL AND NEITHER COULD SEE THE OTHER. The incumbent held
// roughly 100 GB. The arriving engine probed free memory, its probe FAILED, it fell back to a stale
// reading of 116.5 GiB, and it proceeded to offload a 108 GiB model plus a KV cache on top of a live
// engine. Four minutes later the host was unreachable.
//
// THE TYPE SYSTEM HAD THE SAME BLINDNESS THE PROBE DID, which is the part worth fixing here.
// extdeps.memory.types already offers UnifiedShared as a MemoryKind, so the KIND was expressible --
// but GpuFacts carries its own MemoryFacts with its own capacity, independent of host memory, and
// NOTHING RELATES THE TWO. On a GB10 the accelerator reservation IS system memory, so the model
// could assert 128 GB of device memory and 128 GB of host memory and be internally consistent while
// describing a machine that does not exist. Double-counting was representable; sharing was not.
// That is why "116 GiB free" and "the incumbent holds 100 GB" could both be true in the model.
//
// So the carrier below is a POOL, not a pair of capacities. On a unified cell there is one number
// and every occupant draws from it.

type ServingCellMemory
  = UnifiedPool { capacity: ByteSize }
  | DisjointPools { host: ByteSize, device: ByteSize }

// WHAT A CELL IS ALREADY RUNNING. Absent is a real answer and is spelled as one rather than as an
// empty list or a zero reservation: "nothing is serving here" and "something is serving here and
// reserved nothing" have opposite admission consequences.
type ServingResidency
  = CellUnoccupied
  | CellOccupied { engine: ServingEngine, reserved: ByteSize }

// THE DECISION. Refusals are separated by CAUSE because their remedies differ and a single refusal
// symbol would have hidden exactly that: an occupied cell is a placement error the operator fixes by
// choosing another cell, while an oversized request on an empty cell is a sizing error fixed by
// changing the model or the window. Collapsing them would be the state-space conflation this repo
// keeps finding.
type ServingCoTenancyDecision
  = ServingAdmitted { remaining: ByteSize }
  | ServingRefusedCellOccupied { incumbent: ServingEngine, incumbent_reserved: ByteSize }
  | ServingRefusedPoolExhausted { pool: ByteSize, requested: ByteSize }

fn serving_cell_pool_capacity(memory: ServingCellMemory) -> ByteSize {
  match memory {
    UnifiedPool { capacity: c } => c
    DisjointPools { host: _, device: d } => d
  }
}

fn serving_pool_remainder(memory: ServingCellMemory, requested: ByteSize) -> ByteSize {
  byte_size(
    count: byte_size_count(b: serving_cell_pool_capacity(memory: memory)) -
      byte_size_count(b: requested),
  )
}

// THE FENCE ITSELF. Occupancy is checked BEFORE size, and the order is the whole point: on a
// unified cell an arriving engine's own view of free memory is not evidence, because the incumbent's
// reservation is invisible to it. Asking "does it fit" first is precisely the question the wedging
// engine asked and answered wrongly. Asking "is anyone here" first needs no probe at all.
fn serving_cotenancy_decision(
  memory: ServingCellMemory,
  residency: ServingResidency,
  requested: ByteSize,
) -> ServingCoTenancyDecision {
  match residency {
    CellOccupied { engine: e, reserved: r } =>
      ServingRefusedCellOccupied { incumbent: e, incumbent_reserved: r }
    CellUnoccupied =>
      if byte_size_count(b: requested) > byte_size_count(b: serving_cell_pool_capacity(memory: memory)) {
        ServingRefusedPoolExhausted {
          pool: serving_cell_pool_capacity(memory: memory),
          requested: requested,
        }
      } else {
        ServingAdmitted { remaining: serving_pool_remainder(memory: memory, requested: requested) }
      }
  }
}

fn serving_cotenancy_admits(decision: ServingCoTenancyDecision) -> Bool {
  match decision {
    ServingAdmitted { remaining: _ } => true
    ServingRefusedCellOccupied { incumbent: _, incumbent_reserved: _ } => false
    ServingRefusedPoolExhausted { pool: _, requested: _ } => false
  }
}

// The located text a refusal carries. It names the incumbent rather than only reporting a number,
// because the operator's next action is to find that process, and a byte count does not identify it.
fn serving_engine_label(engine: ServingEngine) -> String {
  match engine {
    OllamaSingleHost => "ollama (single host)"
    VllmTensorParallel { world_size: _ } => "vllm (tensor parallel)"
  }
}

fn serving_cotenancy_refusal_text(decision: ServingCoTenancyDecision) -> String {
  match decision {
    ServingAdmitted { remaining: _ } => ""
    ServingRefusedCellOccupied { incumbent: e, incumbent_reserved: r } =>
      join([
        "cell already hosts ", serving_engine_label(engine: e), " reserving ",
        to_string(value: byte_size_count(b: r)),
        " bytes of one shared pool; a second engine cannot observe that reservation",
      ], "")
    ServingRefusedPoolExhausted { pool: p, requested: q } =>
      join([
        "requested ", to_string(value: byte_size_count(b: q)),
        " bytes against a pool of ", to_string(value: byte_size_count(b: p)),
      ], "")
  }
}
