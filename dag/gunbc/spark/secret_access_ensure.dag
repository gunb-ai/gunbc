module gunbc.spark.secret_access_ensure

// WHY THIS EXISTS (operator ruling, 2026-08-20). The convergence principal could not read
// spark-administrator-password, and the remedy on offer was an operator hand-running a gcloud
// IAM grant. That was refused for the same reason hand-mutating a host was refused: "surely this
// is a missing dependency -- the way this stuff should work is via upserts/ensures via proper gcp
// modeling". A binding that a human applies once by hand is manual application NOT committed as
// source, and it decays with no census: nothing in the tree records that the grant is required,
// so nothing notices when it is absent, wrong, or removed. The desired access is a modeled fact
// and this module converges it.
//
// WHICH PRINCIPAL THIS ACTS AS, corrected after review found an overclaim. The FIRST binding still
// cannot be self-granted: principal_role_admits_operation gives the convergence principal
// SmSetIamPolicy => false as a hard ceiling, and no_principal_can_both_grant_and_read executes the
// property, because a principal that can grant and read can escalate itself to every secret in the
// project. This ensure therefore acts as FleetCloudGrantAdministratorPrincipal, the modeled control
// plane, whose admitted operations are exactly the two this module performs.
//
// AND THE MODEL DOES NOT REPRESENT THE IDENTITY THAT ACTUALLY RUNS IT. An earlier revision of this
// comment said a human gcloud identity "is exactly what the split contemplates". That was false and
// is the kind of false that matters: FleetCloudPrincipalKey enumerates exactly two arms, neither of
// which is an operator session, so no_principal_can_both_grant_and_read quantifies over a universe
// this actor is not in. The property is SILENT about the operator identity rather than endorsing
// it, and reporting silence as endorsement is rung inflation on the security claim.
//
// So the honest standing: the ROLE is modeled and its operation ceiling is executed below; the
// REALIZATION of that role is currently an operator gcloud session, and the binding between the two
// is convention, not structure. Nothing checks that the token GcloudPrintToken mints belongs to a
// principal entitled to the grant-administrator role -- GCP checks it, and answers 403 if not, which
// is a boundary refusal rather than a modeled guarantee. Next rung: enrol the grant administrator as
// a real federated identity, at which point the realization is named and this paragraph collapses.

// The role name comes from extdeps.cloud.gcp.iam role_secretmanager_secret_accessor, the existing
// authority for it. An earlier revision of this module declared its own constant holding the same
// literal -- a second name for one concept, in the module whose comment argued against exactly
// that. Caught in review; the local constant is deleted rather than kept beside the import.

// ── The member is RESOLVED, never spelled ────────────────────────────────────────────────────
// spark_bootstrap_cloud_principal_member() exists and returns a String, and using it here would
// be a defect: its CloudPrincipalUnallocated arm answers the PROSE "the run's WIF identity (no
// allocated member is recorded)", which is a fine thing to print in a report and a catastrophic
// thing to write into an IAM policy -- it would author a binding for a member that cannot exist,
// and setIamPolicy is a whole-policy replace, so the write would land beside the real bindings.
// So this module consumes the STANDING and refuses the unallocated arm. The refusal is the point:
// an ensure that cannot name its subject must not write a policy.
type SparkGrantMemberResolution
  = SparkGrantMemberResolved { member: String }
  | SparkGrantMemberUnresolved { cause: String }

fn spark_grant_member_resolution() -> SparkGrantMemberResolution {
  match fleet_cloud_principal_standing() {
    CloudPrincipalAllocated { principal: _, member: m, readback: _ } =>
      SparkGrantMemberResolved { member: m }
    CloudPrincipalReported { principal: _, reported_member: m, source: _ } =>
      SparkGrantMemberResolved { member: m }
    CloudPrincipalUnallocated { principal: _ } =>
      SparkGrantMemberUnresolved {
        cause: "no allocated member is recorded for the fleet cloud principal, so this ensure cannot name the subject it would grant; refusing rather than writing a policy naming a member that does not exist"
      }
  }
}

// ── Desired and owned are two facts, not one ─────────────────────────────────────────────────
// DESIRED is what must be present. OWNED is the population this model may REMOVE. They are
// deliberately the same single cell here, which is the conservative reading: a binding this model
// did not author is preserved even when its member is one we recognise, because it may exist for a
// reason this caller cannot see. Widening owned_universe is how an ensure starts deleting other
// people's access, so it grows only with a reason.
fn spark_secret_desired_cells(member: String) -> List<extdeps.cloud.gcp.iam.GcpIamBindingCell> {
  [extdeps.cloud.gcp.iam.GcpIamBindingCell { role: role_secretmanager_secret_accessor, member: member, condition: none }]
}

fn spark_secret_owned_universe(member: String) -> extdeps.cloud.gcp.iam.GcpIamOwnedCellUniverse {
  extdeps.cloud.gcp.iam.GcpIamOwnedCellUniverse { cells: spark_secret_desired_cells(member: member) }
}

fn spark_secret_target() -> extdeps.cloud.gcp.secret_ref.SecretRef {
  spark_administrator_password_secret_ref
}

// The readback is not ceremony. A whole-policy replace that returns 200 has not been shown to
// contain the cell it was written for: the request could have been reconciled against a policy
// that changed under it, and the response is the server's policy, not our intent. So the cell is
// looked for in what came back, and its absence is a failure with a located cause rather than a
// success that happens to be wrong.
fn spark_secret_grant_present(policy: extdeps.cloud.gcp.iam.GcpPolicy, member: String) -> Bool {
  gcp_cell_in(
    c: extdeps.cloud.gcp.iam.GcpIamBindingCell { role: role_secretmanager_secret_accessor, member: member, condition: none },
    xs: gcp_policy_cells(p: policy)
  )
}

// ── The ensure ───────────────────────────────────────────────────────────────────────────────
// THIS IS A func, NOT A pattern, AND THAT IS THE WHOLE POINT OF THE SHAPE. The `pattern`/`node`
// form cannot branch on a verdict: gunbc.assimilate.bmc_bootstrap_provision records that as a
// KNOWN BYPASS, where GcpPolicyAlreadyConverged is computed and DISCARDED because the call site
// cannot skip its own effect, so a converged policy is written anyway and the etag advances -- a
// re-run that changed nothing looks like it changed something. A func can match, can call the
// operation inside the arm, and can return early, so here the converged case performs NO WRITE at
// all. The no-op is structural rather than promised, which is why reconcile_gcp_policy's
// AlreadyConverged is consumed as its own arm rather than a delta that happens to be empty.
func spark_secret_access_ensure(token_source: gunbc.auth.access_token_source.AccessTokenSource) -> std.process.ProcessExit
  uses net: std.resources.Network
{
  match spark_grant_member_resolution() {
    SparkGrantMemberUnresolved { cause: c } => return exit_failure(reason: c)
    SparkGrantMemberResolved { member: member } =>
      match ensure_access_token(source: token_source) {
        AccessTokenUpsertRequired { plan: upsert_plan } =>
          return exit_failure(reason: access_token_upsert_required_reason(plan: upsert_plan))
        AccessTokenEnsureRefused { reason: reason } =>
          return exit_failure(reason: reason as String)
        AccessTokenReady { token: token } => {
          let target = spark_secret_target()
          observed = gcp.SecretManager.GetSecretIamPolicy(
            access_token: token,
            project_id: target.project,
            secret: target.secret
          )
          let observed_policy = extdeps.cloud.gcp.iam.GcpPolicy {
            bindings: observed.bindings,
            etag: observed.etag,
            version: observed.version
          }
          match reconcile_gcp_policy(
            observed: observed_policy,
            desired_owned: spark_secret_desired_cells(member: member),
            owned_universe: spark_secret_owned_universe(member: member)
          ) {
            GcpPolicyAlreadyConverged { policy: p } =>
              if spark_secret_grant_present(policy: p, member: member) {
                std.process.ExitSuccess
              } else {
                exit_failure(
                  reason: concat(
                    "spark secret access ensure: reconciliation reported the policy already converged, but the granted cell is absent from the policy it reported. Refusing rather than reporting a convergence this run cannot see, for member ",
                    member
                  )
                )
              }
            GcpPolicyDeltaRequired { policy: desired_policy, added: _, removed: _, preserved: _ } => {
              written = gcp.SecretManager.SetSecretIamPolicy(
                access_token: token,
                project_id: target.project,
                secret: target.secret,
                policy: desired_policy
              )
              let written_policy = extdeps.cloud.gcp.iam.GcpPolicy {
                bindings: written.bindings,
                etag: written.etag,
                version: written.version
              }
              if spark_secret_grant_present(policy: written_policy, member: member) {
                std.process.ExitSuccess
              } else {
                exit_failure(
                  reason: concat(
                    "spark secret access ensure: setIamPolicy returned 200 but the policy it returned does not carry the granted cell, so the write did not establish the access it was performed for, for member ",
                    member
                  )
                )
              }
            }
          }
        }
      }
  }
}

// The zero-argument entry, following the gunbc.tools.bmc_onboard convention: the parameterized
// func above carries the logic and takes its token source as an argument, and a named entry binds
// the one source this ensure is actually run with. GcloudPrintToken is the operator-workstation
// path, which is the correct binding here for a reason stated rather than assumed -- the control
// plane that may call setIamPolicy is deliberately NOT the workload, so this entry authenticates
// as the human running it and never as the convergence service account.
func spark_secret_access_converge() -> std.process.ProcessExit
  uses net: std.resources.Network
{
  spark_secret_access_ensure(token_source: gunbc.auth.access_token_source.GcloudPrintToken)
}

// The operation ceiling, stated so a witness executes it instead of a comment asserting it. These
// are the two operations this ensure performs, and the pair is the subject of both checks below.
fn spark_secret_access_ensure_operations() -> List<gunbc.spark.bootstrap_provision.SecretManagerOperation> {
  [gunbc.spark.bootstrap_provision.SmGetIamPolicy, gunbc.spark.bootstrap_provision.SmSetIamPolicy]
}

fn principal_admits_every_ensure_operation(principal: gunbc.spark.bootstrap_provision.FleetCloudPrincipalKey) -> Bool {
  fold(
    spark_secret_access_ensure_operations(),
    init: true,
    f: (acc, op) => acc && principal_role_admits_operation(principal: principal, op: op)
  )
}

fn principal_admits_any_ensure_operation(principal: gunbc.spark.bootstrap_provision.FleetCloudPrincipalKey) -> Bool {
  fold(
    spark_secret_access_ensure_operations(),
    init: false,
    f: (acc, op) => acc || principal_role_admits_operation(principal: principal, op: op)
  )
}

fn ensure_control_plane_principal() -> gunbc.spark.bootstrap_provision.FleetCloudPrincipalKey {
  gunbc.spark.bootstrap_provision.FleetCloudGrantAdministratorPrincipal { role: gunbc.spark.bootstrap_provision.FleetCloudGrantAdministrator {} }
}

fn ensure_workload_principal() -> gunbc.spark.bootstrap_provision.FleetCloudPrincipalKey {
  gunbc.spark.bootstrap_provision.FleetCloudConvergencePrincipal { role: gunbc.spark.bootstrap_provision.FleetCloudConvergence {} }
}

// THE TOKEN ARRIVES BY PATH, NEVER BY VALUE, and the reason is already written down one module over:
// gunbc.spark.grant_privileged_operation spark_grant_credential_path_env states that an environment
// variable holding a SECRET leaks into any diagnostic that dumps the environment, and that this
// repository's receipts do dump argv. A token is a bearer credential for the whole project, so it
// gets the same treatment as the administrator password: the environment carries a PATH, the file
// carries the bytes, and the value never reaches argv or a receipt.
//
// This realizes the OperatorSuppliedToken arm, which gunbc.auth.access_token_source already carries
// and describes as an explicit handler. It is what lets the ensure run somewhere gcloud does not
// exist -- a container, a CI runner -- rather than only on a workstation.
data spark_secret_access_token_path_env: std.types.NonEmptyStr = "GUNBC_GCP_ACCESS_TOKEN_FILE" as std.types.NonEmptyStr

type SuppliedTokenResolution
  = SuppliedTokenReady { token: std.types.Secret }
  | SuppliedTokenUnavailable { cause: std.types.NonEmptyStr }

// An empty token is refused rather than passed through. A blank bearer token is not an anonymous
// request, it is a malformed one, and sending it would turn a local authoring mistake into a 401
// from Google that reads like a permissions problem.
fn classify_supplied_token(success: Bool, error: String, content: String) -> SuppliedTokenResolution {
  if success == false {
    SuppliedTokenUnavailable {
      cause: join(["the access token file could not be read: ", error], "") as std.types.NonEmptyStr,
    }
  } else {
    let token = std.algebra.trim(s: content)
    if token == "" {
      SuppliedTokenUnavailable {
        cause: "the access token file is empty, which is never a usable bearer token" as std.types.NonEmptyStr,
      }
    } else {
      SuppliedTokenReady { token: token as std.types.Secret }
    }
  }
}

func read_supplied_access_token() -> SuppliedTokenResolution {
  match shell.Env.Get(name: spark_secret_access_token_path_env).value {
    Absent =>
      SuppliedTokenUnavailable {
        cause: join([
          "no ", spark_secret_access_token_path_env as String,
          " in the environment: this entry needs a path to a file holding an access token",
        ], "") as std.types.NonEmptyStr,
      }
    Present { value: raw } => {
      let path = std.algebra.trim(s: raw)
      if path == "" {
        SuppliedTokenUnavailable {
          cause: join([
            spark_secret_access_token_path_env as String, " is set but empty, which is not a path",
          ], "") as std.types.NonEmptyStr,
        }
      } else {
        let read = Filesystem.Read(path: path)
        classify_supplied_token(success: read.success, error: read.error, content: read.content)
      }
    }
  }
}

func spark_secret_access_converge_with_supplied_token() -> std.process.ProcessExit
  uses net: std.resources.Network
{
  match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause: c } => exit_failure(reason: c as String)
    SuppliedTokenReady { token: t } =>
      spark_secret_access_ensure(token_source: gunbc.auth.access_token_source.OperatorSuppliedToken { token: t })
  }
}
