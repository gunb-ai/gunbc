module gunbc.spark.secret_access_ensure

// WHY THIS EXISTS (operator ruling, 2026-08-20). The convergence principal could not read
// spark-administrator-password, and the remedy on offer was an operator hand-running a gcloud IAM
// grant. Refused for the same reason hand-mutating a host was refused: "surely this is a missing
// dependency -- the way this stuff should work is via upserts/ensures via proper gcp modeling". A
// binding a human applies once by hand is manual application NOT committed as source, decaying
// with no census: nothing in the tree records the grant is required, so nothing notices when it is
// absent, wrong, or removed. The desired access is a modeled fact and this module converges it.
//
// WHAT IS LEFT HERE IS THE SPARK BINDING, AND ONLY THAT. The reconciler moved to
// gunbc.auth.gcp_secret_access when the App key became a second caller: the module path used to
// name its first consumer rather than the fact it owned, and a fact's home is its layer (§3). This
// file now says one thing -- WHICH secret and WHICH role the spark lane wants -- and the ensure it
// calls is shared. The entries keep their names so nothing downstream is renamed by the move.
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.spark.credential_workflow { spark_administrator_password_secret_ref }
import gunbc.auth.gcp_secret_access {
  SecretAccessGrant, secret_accessor_grant, secret_access_ensure_for,
  read_supplied_access_token, SuppliedTokenReady, SuppliedTokenUnavailable,
}
import gunbc.auth.access_token_source {
  AccessTokenSource, GcloudPrintToken, OperatorSuppliedToken,
}
import std.resources { Network }
import std.process { ProcessExit, exit_failure }
import std.types { String }

fn spark_secret_target() -> SecretRef {
  spark_administrator_password_secret_ref
}

// The unconditioned accessor cell on the spark password, which is the whole of this lane's desired
// access. It is a SecretAccessGrant rather than a bare target because the ensure reconciles a cell
// -- role and condition included -- and naming only the secret would put the role back inside the
// reconciler as a fixed constant, where a request could not vary it.
fn spark_secret_access_grant() -> SecretAccessGrant {
  secret_accessor_grant(target: spark_secret_target())
}

func spark_secret_access_ensure(token_source: AccessTokenSource) -> ProcessExit
  uses net: Network
{
  secret_access_ensure_for(grant: spark_secret_access_grant(), token_source: token_source)
}

// The zero-argument entry, following the gunbc.tools.bmc_onboard convention: the parameterized
// func carries the logic and takes its token source as an argument; a named entry binds the one
// source this ensure is actually run with. GcloudPrintToken is the operator-workstation path, the
// correct binding for a stated reason -- the control plane that may call setIamPolicy is
// deliberately NOT the workload, so this entry authenticates as the human running it and never as
// the convergence service account.
func spark_secret_access_ensure(token_source: AccessTokenSource) -> ProcessExit
  uses net: Network
{
  secret_access_ensure_for(target: spark_secret_target(), token_source: token_source)
}

func spark_secret_access_converge() -> ProcessExit
  uses net: Network
{
  spark_secret_access_ensure(token_source: GcloudPrintToken)
}

func spark_secret_access_converge_with_supplied_token() -> ProcessExit
  uses net: Network
{
  match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause: c } => exit_failure(reason: c as String)
    SuppliedTokenReady { token: t } =>
      spark_secret_access_ensure(token_source: OperatorSuppliedToken { token: t })
  }
}
