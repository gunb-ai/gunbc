module gunbc.spark.serving_loaded_release


data spark_serving_loaded_release_note: String = "LOADED-RELEASE FINGERPRINT (SPARK-SERVE-BIND-0 item C). Independent of transport: the same derivation consumes wet SSH readback or fixture rows in witnesses. Loaded identity covers runtime closure + model manifest digest only — serving policy is desired state, never imported into observations. Runtime closure requires release-archive admission receipt digest (gunbc.spark.serving_runtime_receipt — archive verified, not install completed) AND /api/version agreement — never either alone."

data spark_serving_unit_probe_outcome_note: String = "Only SparkServingUnitAbsent licenses SparkServingAbsent. SSH failure, transport failure, unreadable user manager, systemctl failure, and inactive units must never collapse into absent — that is the empty-observation narrow (DESIGN failure-mode list)."

type SparkServingUnitProbeOutcome
  = SparkServingUnitActive
  | SparkServingUnitInactive
  | SparkServingUnitAbsent
  | SparkServingUnitObservationRefused { cause: std.types.NonEmptyStr }

type SparkServingReadback {
  host: product.placement_supply.HostIdentity
  unit_outcome: SparkServingUnitProbeOutcome
  runtime_version: gunbc.spark.serving_readback_parse.SparkServingReadbackField
  runtime_materialization_identity: gunbc.spark.serving_readback_parse.SparkServingReadbackField
  model_name: gunbc.spark.serving_readback_parse.SparkServingReadbackField
  model_tag: gunbc.spark.serving_readback_parse.SparkServingReadbackField
  model_manifest_digest: gunbc.spark.serving_readback_parse.SparkServingReadbackField
  nvidia_driver: gunbc.spark.serving_readback_parse.SparkServingReadbackField
  bind_address: gunbc.spark.serving_readback_parse.SparkServingReadbackField
  boot_provenance: gunbc.spark.serving_boot_provenance.SparkServingBootProvenance
  grants: gunbc.spark.managed_access_bootstrap.SparkGrantOutcome
}

fn spark_serving_loaded_model_artifact(
  name: String,
  tag: String,
  digest_wire: String,
) -> gunbc.model_artifact.ModelArtifact? {
  match ollama_model_digest_from_wire(
    ref: extdeps.ollama.api.OllamaModelRef { name: name as std.types.NonEmptyStr, tag: tag as std.types.NonEmptyStr },
    hex: digest_wire,
  ) {
    Absent => none
    Present { value: observed } =>
      Present {
        value: model_artifact_from_observed_digest(
          publisher: "ollama" as std.types.NonEmptyStr,
          observed: observed,
        ),
      }
  }
}

fn derive_loaded_spark_serving_release(readback: SparkServingReadback) -> gunbc.spark.serving_release.SparkServingRelease? {
  match readback.unit_outcome {
    SparkServingUnitInactive => none
    SparkServingUnitAbsent => none
    SparkServingUnitObservationRefused { cause: _ } => none
    SparkServingUnitActive =>
      match spark_serving_readback_field_present_value(field: readback.runtime_version) {
        Absent => none
        Present { value: ver } =>
          match spark_serving_readback_field_present_value(field: readback.runtime_materialization_identity) {
            Absent => none
            Present { value: receipt_identity } =>
              match spark_serving_admit_observed_runtime_identity(
                version: ver,
                receipt_identity: receipt_identity,
              ) {
                Absent => none
                Present { value: runtime_digest } =>
                  match spark_serving_readback_field_present_value(field: readback.model_name) {
                    Absent => none
                    Present { value: name } =>
                      match spark_serving_readback_field_present_value(field: readback.model_tag) {
                        Absent => none
                        Present { value: tag } =>
                          match spark_serving_readback_field_present_value(field: readback.model_manifest_digest) {
                            Absent => none
                            Present { value: digest_wire } =>
                              match spark_serving_loaded_model_artifact(
                                name: name,
                                tag: tag,
                                digest_wire: digest_wire,
                              ) {
                                Absent => none
                                Present { value: model } =>
                                  Present {
                                    value: gunbc.spark.serving_release.SparkServingRelease {
                                      runtime: gunbc.spark.serving_release.RuntimeArtifactIdentity {
                                        closure_digest: runtime_digest as std.types.NonEmptyStr,
                                      },
                                      model: model,
                                    }
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

// THE RUNTIME IDENTITY COMES OFF THE HOST BEING OBSERVED, and getting that wrong is what this
// function's existence records.
//
// WHAT WAS HERE. The identity was RECONSTRUCTED from two probes: the live /api/version wire and a
// `release_asset_digest_hex` read out of ollama-runtime-receipt.json. That receipt is written by
// gunbc.package_delivery on the EXECUTOR, as a record of which release archive the executor admitted
// -- a fact about srv1. The read-only observation probed it over SSH on the TARGET, where nothing
// writes it, so every observation of a correctly converged Spark refused with
// `cat: .../ollama-runtime-receipt.json: No such file or directory` while the converge path called
// the same host converged. Two readers, one path string, two machines, and the disagreement was
// visible for days as a state=refused nobody could act on.
//
// WHAT IT READS NOW. The installer writes a materialization receipt INTO the runtime root it just
// published, on the host it published it to, containing the materialization identity directly. That
// is the same receipt spark_serving_observe_runtime_materialization already reads on the converge
// path -- so the two readers now agree by construction rather than by coincidence, and the identity
// is taken rather than recomputed.
//
// THE CROSS-CHECK SURVIVES, in a directer form. The old reconstruction implicitly caught a replaced
// binary: a new version paired with an old asset digest matched no known release and the join
// answered Absent. That indirection is gone, so the check is now stated as itself -- the version the
// endpoint reports must be the version the required release declares. A receipt left behind by a
// materialization that no longer matches what is running refuses here rather than being believed.
fn spark_serving_admit_observed_runtime_identity(
  version: String,
  receipt_identity: String,
) -> String? {
  if !ollama_reported_version_matches_release(version: version, rel: ollama_required_release) {
    none
  } else if trim(s: receipt_identity) == "" {
    none
  } else {
    Present { value: trim(s: receipt_identity) }
  }
}

fn derive_loaded_spark_serving_release_identity(readback: SparkServingReadback) -> gunbc.spark.serving_release.SparkServingReleaseIdentity? {
  match derive_loaded_spark_serving_release(readback: readback) {
    Absent => none
    Present { value: spec } => Present { value: spark_serving_release_identity(spec: spec) }
  }
}

fn derive_spark_serving_observation(readback: SparkServingReadback) -> gunbc.spark.serving_release.SparkServingObservation {
  match readback.unit_outcome {
    SparkServingUnitAbsent =>
      gunbc.spark.serving_release.SparkServingAbsent { host: readback.host }
    SparkServingUnitInactive =>
      gunbc.spark.serving_release.SparkServingObservationRefused {
        host: readback.host,
        cause: "serving unit is present but inactive" as std.types.NonEmptyStr,
      }
    SparkServingUnitObservationRefused { cause: c } =>
      gunbc.spark.serving_release.SparkServingObservationRefused { host: readback.host, cause: c }
    SparkServingUnitActive =>
      match spark_serving_first_readback_refusal(fields: [
        readback.runtime_version,
        readback.runtime_materialization_identity,
        readback.model_name,
        readback.model_tag,
        readback.model_manifest_digest,
        readback.nvidia_driver,
      ]) {
        Present { value: cause } =>
          gunbc.spark.serving_release.SparkServingObservationRefused { host: readback.host, cause: cause }
        Absent =>
          match spark_serving_runtime_admission_refusal_cause(nvidia_driver: readback.nvidia_driver) {
            Present { value: admission_cause } =>
              gunbc.spark.serving_release.SparkServingObservationRefused { host: readback.host, cause: admission_cause }
            Absent =>
              match derive_loaded_spark_serving_release(readback: readback) {
                Absent =>
                  gunbc.spark.serving_release.SparkServingObservationRefused {
                    host: readback.host,
                    cause: "serving unit is active but loaded-release fingerprint could not be derived from independent readback" as std.types.NonEmptyStr,
                  }
                Present { value: loaded } =>
                  gunbc.spark.serving_release.SparkServingObserved { host: readback.host, loaded_release: loaded }
              }
          }
      }
  }
}
