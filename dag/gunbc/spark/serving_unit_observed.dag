module gunbc.spark.serving_unit_observed

import std.types { String, Bool, List, Int, NonEmptyStr, Port }
import std.measure {
  TokenCount, token_count, token_count_value,
  PositiveSlotCount, positive_slot_count, positive_slot_count_value,
  PositiveMeasureCount, positive_measure_count, positive_measure_count_value,
  TokensPerSecond, tokens_per_second, tokens_per_second_count,
  PositiveShardCount, positive_shard_count, positive_shard_count_value,
}
import std.content_hash { Sha256Digest, sha256_hex_digest }
import product.placement_supply { HostIdentity, host_identity_eq }
import extdeps.network.ipv4 { Ipv4Address, ipv4_address, render_ipv4_address, ipv4_address_eq }
import gunbc.fleet_intent_network { operator_host_srv7, operator_host_srv8 }
import gunbc.spark.fabric_link_desired { FabricLink, fabric_rail0, fabric_endpoint_on }

// A SERVING DEPLOYMENT THAT SPANS TWO HOSTS, WHICH THIS CORPUS HAD NO WAY TO SAY.
//
// Every serving structure in gunbc.spark is keyed on ONE HostIdentity: a release, an occurrence, a
// launch profile, a readiness probe, all per host. That shape carries an assumption it never states
// -- that a host is a serving unit -- and the assumption is FALSE for the deployment the operator
// specified. Two Sparks hold one model split by layer, and the operator's first sentence is the
// whole modeling problem: "the two hosts are ONE SERVING UNIT, not two endpoints."
//
// WHAT THIS MODULE IS AND IS NOT. It is an OBSERVATION. The specification's own provenance section
// classifies the running deployment as "an observed running deployment on the experimentation pair,
// input to convergence, NOT published desired state", and this module holds it at exactly that
// standing. Nothing here is projected into gunbc.spark.serving_desired, so nothing here can be
// actuated back onto .232/.233. Promoting it is a separate, declared act.
//
// WHAT IS NOT VERIFIED, carried because the spec carries it: reboot survival. Both units are
// `enabled` and were started through systemd, but neither host has been power-cycled. That is
// recorded as unobserved rather than assumed either way -- the fabric on the other pair was lost to
// exactly one power cycle, which is why gunbc.spark.fabric_link_desired exists.

// THE TWO ROLES ARE TWO TYPES, NOT ONE TYPE WITH A ROLE FIELD.
//
// A role enum beside a member makes "a deployment with two front doors" and "a deployment whose
// weights peer is marked front door" both writable, leaving a validator to catch them. Distinct
// types make them unconstructable: the deployment names one of each, so the invalid shapes have no
// constructor rather than a check. This is DESIGN's construction-over-validation at the cheapest
// place to buy it -- the moment the carrier is first authored.
//
// THE FRONT DOOR IS THE ONLY ADDRESSABLE END. It serves the OpenAI and Anthropic surfaces, owns the
// KV cache and the slot scheduler, and drives the weights peer.
//
// THE FIELD IS THE CONNECT ADDRESS, NOT THE LISTEN ADDRESS, AND THE DISTINCTION IS A MEANING FORK
// THIS MODULE ALREADY PAID FOR ONCE. The measured llama-server binds 0.0.0.0; 192.168.1.232 is the
// address a client dials. This carrier first named the field `bind_address` while
// serving_unit_client_endpoint handed that same value to clients -- operationally correct, and the
// name asserted the wrong fact, which is exactly the listen-versus-connect fork the ollama path
// learned earlier. A listen address is a fact about the process's socket and belongs with the
// runtime realization if it is ever needed; what a serving unit owes a caller is where to dial.
//
// It is an Ipv4Address rather than a NonEmptyStr because the fourth constructor condition below has
// to be able to ASK whether two endpoints are the same address, and a string cannot answer that
// without a second parser.
type ServingUnitFrontDoor sole_constructor {
  host: HostIdentity
  client_address: Ipv4Address
  port: Port
}

// THE WEIGHTS PEER HAS NO API AND MUST NEVER RECEIVE CLIENT TRAFFIC, and on this pair that is not a
// style rule -- it is constraint C1, whose violation is a host loss.
//
// MEASURED 2026-09-02, not taken from the handoff: the peer's host answers HTTP 200 on
// :11434/api/tags and OFFERS TWO MODELS, both about 86.7 GB. One of them is
// deepseek-v4-gguf:no-h3-stop -- WHICH IS EXACTLY THE MODEL THE SINGLE-HOST SERVING ROSTER SELECTS
// AS ITS DESIRED STATE. So the collision is not hypothetical and not merely "some load could arrive
// here": adding this host to that roster would plan a pull-and-load of an 86.7 GB model onto a
// machine with roughly 16 GiB free, and the two rosters would each be individually correct.
//
// The peer's host ALSO runs an unrelated ollama on :11434 which WILL accept work. With roughly 105
// of 121 GiB already committed to weights and swap DISABLED, a model load accepted there is an
// immediate OOM kill that takes the front door down with it, because the front door cannot serve
// without the layers this host holds. So the failure is not "a request went to the wrong port"; it
// is the loss of the whole serving unit.
//
// The peer is addressed on the FABRIC, never on the LAN, and the constructor below enforces it.
type ServingUnitWeightsPeer sole_constructor {
  host: HostIdentity
  fabric_address: Ipv4Address
  port: Port
}

fn serving_unit_front_door(host: HostIdentity, client_address: Ipv4Address, port: Port) -> ServingUnitFrontDoor {
  ServingUnitFrontDoor { host: host, client_address: client_address, port: port }
}

fn serving_unit_weights_peer(host: HostIdentity, fabric_address: Ipv4Address, port: Port) -> ServingUnitWeightsPeer {
  ServingUnitWeightsPeer { host: host, fabric_address: fabric_address, port: port }
}

fn serving_unit_slot_plan(per_slot_context: TokenCount, slots: PositiveSlotCount) -> ServingUnitSlotPlan {
  ServingUnitSlotPlan { per_slot_context: per_slot_context, slots: slots }
}

// PER-SLOT CONTEXT IS THE AUTHORED FACT AND THE TOTAL BUDGET IS DERIVED, WHICH IS THE WHOLE REPAIR
// FOR THE `-c` TRAP.
//
// llama.cpp's `-c` is the TOTAL KV budget across all slots and is divided by `--parallel`. The
// operator's table records what that costs when the two are authored independently:
//
//     -c 10485760  --parallel 10  ->  1,048,576 per slot   (intended)
//     -c 10485760  --parallel 16  ->    655,360 per slot   (silent shrink)
//     -c  6291456  --parallel 16  ->      2,048 per slot   (this bit us once)
//
// Every one of those is a WRITABLE state when `-c` and `--parallel` are two authored numbers, and
// nothing announces the shrink -- the server starts, serves, and answers with a context two orders
// of magnitude smaller than intended. Authoring the per-slot window instead and DERIVING `-c` makes
// all three unwritable: there is no pair to disagree, because there is no second number.
//
// THIS IS ALSO WHY THE ENGINE IS NAMED IN THIS MODULE'S TYPE AND NOT ASSUMED. gunbc.spark.
// serving_desired carries a measured note that slot count MULTIPLIES memory and does NOT divide
// context. That is true, and it is true OF OLLAMA, where the context length is a per-slot server
// default. The same sentence is false here. One row spanning both engines is a meaning fork whose
// realization is precisely the 2,048-per-slot line above.
type ServingUnitSlotPlan sole_constructor {
  per_slot_context: TokenCount
  slots: PositiveSlotCount
}

// The `-c` word the unit actually carries, derived from the pair above rather than authored beside
// them. A convergence check must NOT assert on this value: `/props` reports
// `default_generation_settings.n_ctx` as the ALREADY-DIVIDED per-slot figure, so the unit file's
// number and the served reality are different quantities, and comparing the wrong one is how the
// silent shrink stays invisible. This exists to RENDER the unit, and serving_unit_slot_plan_per_slot below
// is what a readback is compared against.
fn serving_unit_slot_plan_total_kv(plan: ServingUnitSlotPlan) -> TokenCount {
  token_count(
    count: token_count_value(t: plan.per_slot_context) * positive_slot_count_value(slots: plan.slots))
}

fn serving_unit_slot_plan_per_slot(plan: ServingUnitSlotPlan) -> TokenCount {
  plan.per_slot_context
}

// ONE SERVING UNIT, and the constructor is where "two hosts" stops being two of anything.
//
// Four conditions decide it, and each is a way the specified deployment could be described wrongly
// while every part looked individually fine:
//
//   - the two ends must be DIFFERENT HOSTS. A split across one machine is not a split; it is one
//     process talking to itself over a network address, and it would report healthy.
//   - the peer must be addressed ON THE FABRIC LINK the deployment names. This is the condition
//     with a measured price: the same deployment ran at 4.2 GB/min over the LAN and 144 GB/min over
//     RoCE -- 34x -- and NOTHING IN THE SERVED BEHAVIOUR DISTINGUISHES THEM except latency. A peer
//     addressed on the LAN is a working deployment that is silently thirty-four times slower, which
//     is the class of defect that gets diagnosed as "the model is slow".
//   - the fabric link must actually TOUCH BOTH HOSTS. A link between two other machines is not the
//     path these two speak over, and naming it would make the check above pass against the wrong
//     subject.
//   - the front door and the peer must not be the same PORT ON THE SAME ADDRESS, which is the
//     copy-paste of the endpoint block. This condition was CLAIMED here before it was enforced --
//     the annotation said four and the constructor implemented three -- which is the decoration
//     case: a stated invariant nothing checks reads as coverage. It is now decidable because the
//     front door carries an Ipv4Address rather than a string, and it has its own discriminating RED.
//
// A deployment that fails any of them has no constructor. It is not reported later.
type ServingUnit sole_constructor {
  alias: NonEmptyStr
  front_door: ServingUnitFrontDoor
  weights_peer: ServingUnitWeightsPeer
  fabric: FabricLink
  slot_plan: ServingUnitSlotPlan
}

fn serving_unit_construct(
  alias: NonEmptyStr,
  front_door: ServingUnitFrontDoor,
  weights_peer: ServingUnitWeightsPeer,
  fabric: FabricLink,
  slot_plan: ServingUnitSlotPlan,
) -> ServingUnit? {
  if host_identity_eq(a: front_door.host, b: weights_peer.host) {
    none
  } else if ipv4_address_eq(a: front_door.client_address, b: weights_peer.fabric_address)
    && front_door.port == weights_peer.port {
    none
  } else {
    match fabric_endpoint_on(link: fabric, host: weights_peer.host) {
      Absent => none
      Present { value: peer_end } =>
        match fabric_endpoint_on(link: fabric, host: front_door.host) {
          Absent => none
          Present { value: _ } =>
            if !ipv4_address_eq(a: peer_end.address, b: weights_peer.fabric_address) {
              none
            } else {
              Present { value: ServingUnit {
                alias: alias,
                front_door: front_door,
                weights_peer: weights_peer,
                fabric: fabric,
                slot_plan: slot_plan,
              } }
            }
        }
    }
  }
}

// THE ONE ADDRESS A CLIENT MAY HOLD. There is deliberately no sibling returning the weights peer as
// an endpoint: C1 is enforced by there being nothing to call, rather than by a rule saying not to.
fn serving_unit_client_endpoint(d: ServingUnit) -> String {
  join(["http://", render_ipv4_address(addr: d.front_door.client_address), ":",
    to_string(d.front_door.port)], "")
}

fn serving_unit_rpc_peer_wire(d: ServingUnit) -> String {
  join([render_ipv4_address(addr: d.weights_peer.fabric_address), ":", to_string(d.weights_peer.port)], "")
}

// A HOST THAT HOLDS WEIGHTS IS NOT A SERVING ENDPOINT, asked as a question a roster can answer.
//
// This is the checkable half of C1. The constructor above makes the peer unaddressable WITHIN a
// deployment; it cannot see a SEPARATE roster that also names that host as a single-host serving
// cell. That is the actual hazard on .233, which runs an unrelated ollama on :11434 alongside its
// weights role, and it is how the host would come to accept a load: not through this deployment,
// but through another one that never knew this one existed.
fn serving_unit_weights_peer_hosts(deployments: List<ServingUnit>) -> List<HostIdentity> {
  map(deployments, d => d.weights_peer.host)
}

fn serving_unit_host_is_weights_peer(
  deployments: List<ServingUnit>,
  host: HostIdentity,
) -> Bool {
  any(serving_unit_weights_peer_hosts(deployments: deployments), h => host_identity_eq(a: h, b: host))
}

// ================= THE OBSERVED DEPLOYMENT, 2026-09-02 18:23 UTC =================
//
// Read from the operator's handoff specification, which records what was measured live rather than
// what was intended: slots, per-slot context, route status codes and both hosts' memory at 18:23
// UTC, throughput between 18:11 and 18:19 UTC on an idle deployment.
//
// THE FABRIC ROW IS NOT RE-AUTHORED HERE. It is `fabric_rail0` from gunbc.spark.fabric_link_desired,
// whose endpoints were read back from the durable /etc/netplan/90-NM-*.yaml on both hosts. The
// specification's topology section names the same 192.168.100.0/24 link, so citing the existing row
// rather than restating its addresses is what keeps one fabric fact in one place -- and it means the
// constructor's fabric conditions above are checked against the measured fabric, not against a
// second copy of it authored to agree.
data serving_unit_observed_alias: NonEmptyStr = "deepseek-v4-flash:iq3s-split" as NonEmptyStr

// THE FRONT DOOR'S LAN ADDRESS IS CARRIED HERE AS AN OBSERVATION, AND DELIBERATELY NOT CITED FROM
// gunbc.fleet_intent_network, WHICH WOULD BE THE OBVIOUS §3 MOVE AND WOULD BE WRONG.
//
// That module holds .232/.233 in PROSE only -- there is no typed address row to cite, so nothing is
// being duplicated here. The reason there is no row is the part that matters: the module states that
// membership in its `endpoints` IS ENROLLMENT, so authoring an address row there PERFORMS the
// enrollment rather than describing it. srv7/srv8 are deliberately unenrolled, and enrolling a pair
// as a side effect of needing somewhere tidy to put an address is exactly the act-fusion that the
// admission of this pair is supposed to keep separable.
//
// So this field is an observation of where a measured front door answered, at a host that is not a
// fleet member. It confers no membership and must not be read as any.
//
// THE FABRIC IS THE OPPOSITE CASE AND IS HANDLED THE OPPOSITE WAY. Its addresses, interface names
// and MTU ARE owned -- by gunbc.spark.fabric_link_desired, merged -- so this module references that
// link BY IDENTITY and derives the peer's address from it. No fabric field is restated here.
data serving_unit_observed_front_door: ServingUnitFrontDoor = ServingUnitFrontDoor {
  host: operator_host_srv7,
  client_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 232),
  port: 30000,
}

data serving_unit_observed_slot_plan: ServingUnitSlotPlan = ServingUnitSlotPlan {
  per_slot_context: token_count(count: 1048576),
  slots: positive_slot_count(count: positive_measure_count(predecessor: 9)),
}

fn serving_unit_observed_weights_peer() -> ServingUnitWeightsPeer? {
  match fabric_rail0 {
    Absent => none
    Present { value: link } =>
      match fabric_endpoint_on(link: link, host: operator_host_srv8) {
        Absent => none
        Present { value: e } =>
          Present { value: ServingUnitWeightsPeer {
            host: operator_host_srv8,
            fabric_address: e.address,
            port: 50052,
          } }
      }
  }
}

// The observed deployment, or Absent when any condition that makes it ONE serving unit fails to
// hold. An Absent here is not a deployment with a problem to report later -- it never existed, so
// nothing downstream can plan from it.
fn serving_unit_observed() -> ServingUnit? {
  match fabric_rail0 {
    Absent => none
    Present { value: link } =>
      match serving_unit_observed_weights_peer() {
        Absent => none
        Present { value: peer } =>
          serving_unit_construct(
            alias: serving_unit_observed_alias,
            front_door: serving_unit_observed_front_door,
            weights_peer: peer,
            fabric: link,
            slot_plan: serving_unit_observed_slot_plan,
          )
      }
  }
}

fn serving_unit_observed_units() -> List<ServingUnit> {
  match serving_unit_observed() {
    Present { value: d } => [d]
    Absent => []
  }
}

// ================= WHAT THE UNIT WAS MEASURED TO DELIVER =================
//
// A BAND, NOT A NUMBER, AND THE REASON IS IN THE MEASUREMENT ITSELF. Ten slots produced 58.8
// aggregate decode tok/s on one run and 50.9 on a repeat of the same configuration. Encoding 58.8
// would be a censored estimator presented as a threshold: it takes the better arm of a two-sample
// spread and reports it as the property, and the repeat already falsifies that precision. So the
// observation carries both ends and nothing here is a floor.
//
// WHY THE UNIT IS NOT CONFIGURED AT ITS MEMORY CEILING, which is the fact that stops "more slots"
// from reading as "more throughput". Twelve slots FIT -- and were SLOWER, 57.3 against 58.8, while
// leaving the peer at 9 GiB free instead of 16. Ten is a tuned value chosen on measured throughput,
// not a capacity limit waiting to be filled, and raising it without re-measuring is how a
// configuration gets worse while looking more generous.
//
// AND SLOTS BUY CONCURRENCY, NOT SPEED. Single-stream decode is memory-bandwidth-bound at roughly
// 13-16 tok/s no matter how many slots exist; per-stream rate FALLS as concurrency rises (13.3 at
// one, 5.9 at ten). A reader who takes the aggregate figure as a per-session speed will size
// sessions wrongly, which is why both quantities are recorded rather than the headline one.
//
// HONEST LIMIT ON ALL OF IT: measured on short completions against a near-empty context. Real
// sessions at 90k+ decode slower, so these figures bound an idle deployment and are not a service
// level. Re-derive rather than quote: the producer is the operator's handoff measurement between
// 18:11 and 18:19 UTC on 2026-09-02, and a claim about delivered throughput needs its own
// instrument rather than this row.
type ServingUnitThroughputBand sole_constructor {
  slots: PositiveSlotCount
  aggregate_low: TokensPerSecond
  aggregate_high: TokensPerSecond
  per_stream: TokensPerSecond
}

fn serving_unit_throughput_band(
  slots: PositiveSlotCount,
  aggregate_low: TokensPerSecond,
  aggregate_high: TokensPerSecond,
  per_stream: TokensPerSecond,
) -> ServingUnitThroughputBand? {
  if tokens_per_second_count(r: aggregate_low) > tokens_per_second_count(r: aggregate_high) {
    none
  } else {
    Present { value: ServingUnitThroughputBand {
      slots: slots,
      aggregate_low: aggregate_low,
      aggregate_high: aggregate_high,
      per_stream: per_stream,
    } }
  }
}

// The band as measured at the selected slot count. Reported in whole tok/s because the spread
// between the two runs is roughly eight tok/s -- an order of magnitude larger than any fraction
// either run reported -- so a decimal here would carry precision the measurement does not have.
//
// THE ROUNDING IS DIRECTIONAL AND THAT IS THE PART THAT MATTERS, because a band is not a number and
// rounding it the wrong way changes what admission means. The low end rounds DOWN (50.9 -> 50) and
// the high end rounds UP (58.8 -> 59), so the recorded band is a SUPERSET of the measured one. Since
// serving_unit_throughput_meets compares a threshold against the LOW end, understating that end can
// only make the check stricter: it refuses where the true figure would have passed, never the
// reverse. Rounding the low end up would have been the fail-open direction and is what this note
// exists to prevent someone doing later for tidiness.
//
// THE PER-STREAM FIGURE ROUNDS DOWN FOR THE SAME REASON, 5.9 -> 5, AND IT FIRST SHIPPED AT 6. That
// was the fail-open direction on an axis nothing currently admits against, which is precisely when
// such a value is cheapest to fix and likeliest to be left: a later minimum-per-stream check would
// have inherited an overstatement with no note saying it was one. Nothing here is a floor, and a
// figure that could become one is rounded the direction a floor must be rounded.
fn serving_unit_observed_throughput() -> ServingUnitThroughputBand? {
  serving_unit_throughput_band(
    slots: serving_unit_observed_slot_plan.slots,
    aggregate_low: tokens_per_second(count: 50),
    aggregate_high: tokens_per_second(count: 59),
    per_stream: tokens_per_second(count: 5),
  )
}

// THE CLAIM A THRESHOLD MAY BE COMPARED AGAINST, and it reads the LOW end deliberately. An operator
// threshold set against the high end would be met by one of the two observed runs and missed by the
// other, so the unit would pass or fail on which run was quoted.
fn serving_unit_throughput_meets(
  band: ServingUnitThroughputBand,
  threshold: TokensPerSecond,
) -> Bool {
  tokens_per_second_count(r: band.aggregate_low) >= tokens_per_second_count(r: threshold)
}

// ================= THE ARTIFACT ON DISK AT THE PATHS THE UNIT NAMES =================
//
// ITS ON-DISK IDENTITY IS BOUND BY AN IN-PLACE MEASUREMENT OF THE BYTES.
//
// AND ON-DISK IDENTITY IS NOT EXECUTED-ARTIFACT IDENTITY. This section was first written as "the
// artifact the unit actually loaded", and that sentence does not follow from the measurement that
// backs it. Hashing four files establishes THESE PATHS CONTAIN THESE BYTES AT THE TIME OF THE READ.
// It does not establish that the llama-server process whose throughput and API surface were recorded
// loaded those bytes: the files can be replaced after a process has mapped them, the service can
// restart between the two readings, and nothing here observes an incarnation boundary that would
// rule either out. The two observations may straddle one.
//
// This is the same over-claim as the observation mixer removed below, in its other direction, so it
// gets the same treatment rather than a note asking readers to be careful. The join field is named
// `on_disk_artifact`, so no consumer can read it as the executed artifact without reading that it is
// not. WHAT WOULD CLOSE IT is an incarnation identity -- a process start or restart witness the
// artifact read and the performance read are both keyed to -- and that is the trigger. It cannot be
// had from the serving surface today: GET /v1/models returns this model with `"digest": ""`, an
// empty string rather than an absent field, so no probe against the API binds identity however it is
// written.
//
// This carrier first shipped with the identity UNOBSERVED, and that was honest at the time: the
// serving surface carries no digest -- GET /v1/models returns this model with `"digest": ""`, an
// empty string rather than an absent field, so no probe against the API can bind identity however it
// is written -- and the shard files were outside the convergence principal's reach. The operator
// then granted access, and the gap closed with a MEASUREMENT rather than a promotion of the prose.
//
// WHAT ESTABLISHES IT. The four shards were hashed in place on the front-door host with sha256sum,
// which is an observation of the bytes AT THOSE PATHS, and that measurement alone is what the chain
// below carries.
//
// AN EARLIER VERSION OF THIS NOTE CLAIMED TWO INDEPENDENT CORROBORATING SOURCES, and the model does
// not carry that. The registration payload written when the model was created does record its own
// four digests, and they do agree -- but agreement is a RELATION between two observations, and this
// module stores one canonical chain with no second reading and no relation to compare. Prose that
// claims evidence the structure cannot distinguish is exactly the inflation §4b names, so the
// sentence is withdrawn rather than left standing on a corroboration nothing here can check. The
// direct measurement is sufficient to bind these bytes; modelling the corroboration is a separate
// act, and it is not performed here.
//
// FOUR SHARDS, AND THE FIRST IS NOT THE MODEL. The front door reports shard 00001 as its model_path
// and that file is about five megabytes -- the index that names the rest. A reader who bound
// identity to "the model_path" would therefore have pinned the index and left roughly 108 GiB of
// weights unnamed, which is why identity here is the WHOLE ORDERED CLOSURE and not one path.
//
// UPSTREAM PROVENANCE, RECORDED BUT NOT VERIFIED HERE. The shards were fetched from the unsloth
// DeepSeek-V4-Flash-0731-GGUF repository on huggingface. That is where they CAME FROM; this module
// does not claim the upstream still serves these bytes, because that would be a fact about a remote
// registry nobody re-read. What is established is what this host holds.
// A DIGEST IS A TYPED CONTENT HASH AND ITS POSITION IN THE CHAIN IS PART OF IT.
//
// The bound arm first carried List<NonEmptyStr>, and at that width `["banana"]` bound a four-shard
// artifact: one string, wrong cardinality, no hash family, and no association with any particular
// shard -- while the predicate below is what a publication step consults. The name claimed exact
// identity and the carrier could not deliver it.
//
// Both halves are closed here. The digest is std.content_hash's Sha256Digest, so a value that is not
// 64 lower-hex characters has no constructor rather than being caught later; and the ordinal binds
// each digest to the shard it was read from, because a GGUF shard set is an ordered chain the loader
// follows from the index and the same four digests in a different order name a different artifact.
type ServingUnitShardDigest sole_constructor {
  ordinal: PositiveMeasureCount
  digest: Sha256Digest
}

fn serving_unit_shard_digest(ordinal: PositiveMeasureCount, hex: String) -> ServingUnitShardDigest? {
  match sha256_hex_digest(hex: hex) {
    Absent => none
    Present { value: d } =>
      Present { value: ServingUnitShardDigest { ordinal: ordinal, digest: d } }
  }
}

// EXACTNESS IS ESTABLISHED WHERE THE VALUE IS MINTED, NOT CHECKED AFTERWARDS.
//
// The bound arm previously carried a bare shard list and a SEPARATE predicate decided whether that
// list was exact. That leaves the inexact value writable and makes correctness depend on every
// consumer remembering to run the second rule -- validation standing exactly where construction was
// available. A one-shard closure for a four-shard artifact, and a 1,1,2,3 chain, must fail while the
// Bound value is being made, so that no inexact Bound value exists to be asked about.
type ServingUnitBoundArtifactIdentity sole_constructor {
  shards: List<ServingUnitShardDigest>
  shard_count: PositiveShardCount
}

// The only way to mint one. It refuses unless the chain is exactly 1..N in order at the declared
// count -- length alone is not enough, since 1,1,2,3 has the right cardinality and names a shard set
// that does not exist. The fold walks the expected ordinal forward and sinks to 0 on the first
// disagreement; 0 matches no ordinal, because an ordinal is a PositiveMeasureCount and cannot be
// zero, so the sink is absorbing and a later coincidence cannot restore it.
fn serving_unit_bound_artifact_identity(
  shards: List<ServingUnitShardDigest>,
  shard_count: PositiveShardCount,
) -> ServingUnitBoundArtifactIdentity? {
  if length(shards) != positive_shard_count_value(shards: shard_count) {
    none
  } else if fold(shards, init: 1, f: fn(next, s) {
      if positive_measure_count_value(count: s.ordinal) == next { next + 1 } else { 0 }
    }) != positive_shard_count_value(shards: shard_count) + 1 {
    none
  } else {
    Present { value: ServingUnitBoundArtifactIdentity {
      shards: shards, shard_count: shard_count } }
  }
}

type ServingUnitArtifactIdentity
  = ArtifactIdentityBound { identity: ServingUnitBoundArtifactIdentity }
  | ArtifactIdentityUnobserved { cause: NonEmptyStr }

type ServingUnitArtifact sole_constructor {
  primary_shard_path: NonEmptyStr
  shard_count: PositiveShardCount
  identity: ServingUnitArtifactIdentity
}

// THE ORDER IS PART OF THE FACT. These are shards 00001 through 00004 in sequence, because a GGUF
// shard set is an ordered chain the loader follows from the index; a closure holding the right four
// digests in the wrong order names a different artifact than the one that loaded.
// AND THE ARTIFACT REFUSES A COUNT ITS OWN IDENTITY CONTRADICTS. The bound identity was validated
// against a shard count; if the artifact then declares a different one, the record carries two
// answers to one question and the identity's guarantee is silently void. There is exactly one place
// that could happen, so it refuses here rather than being asked about later.
fn serving_unit_artifact(
  primary_shard_path: NonEmptyStr,
  shard_count: PositiveShardCount,
  identity: ServingUnitArtifactIdentity,
) -> ServingUnitArtifact? {
  match identity {
    ArtifactIdentityUnobserved { cause: _ } =>
      Present { value: ServingUnitArtifact {
        primary_shard_path: primary_shard_path,
        shard_count: shard_count,
        identity: identity,
      } }
    ArtifactIdentityBound { identity: bound } =>
      if positive_shard_count_value(shards: bound.shard_count)
        != positive_shard_count_value(shards: shard_count) {
        none
      } else {
        Present { value: ServingUnitArtifact {
          primary_shard_path: primary_shard_path,
          shard_count: shard_count,
          identity: identity,
        } }
      }
  }
}

// Shards 00001 through 00004, hashed in place on the front-door host. A hex string that does not
// parse yields no ShardDigest, so the identity below refuses rather than binding a short chain.
fn serving_unit_observed_shard_digests() -> List<ServingUnitShardDigest> {
  flat_map(
    [ serving_unit_shard_digest(
        ordinal: positive_measure_count(predecessor: 0),
        hex: "2baab0767d2630cb1633495ff6ccf10bdc5b83de7d66a0d3728a1a0f38e96220"),
      serving_unit_shard_digest(
        ordinal: positive_measure_count(predecessor: 1),
        hex: "3495d0e8218c5a526d66a4901114a7ee4c5e25f84fe1f4bc632b5cbfdac57ac7"),
      serving_unit_shard_digest(
        ordinal: positive_measure_count(predecessor: 2),
        hex: "57ad22e505204245020644de9143accfe3be91951efaa809bf59fa640ec278ea"),
      serving_unit_shard_digest(
        ordinal: positive_measure_count(predecessor: 3),
        hex: "87b2e7956b08954dd0d9ba71801f623fdcd1762f252ea3d18018798a1718bfc9") ],
    o => match o {
      Present { value: v } => [v]
      Absent => []
    })
}

data serving_unit_observed_shard_count: PositiveShardCount = positive_shard_count(count: positive_measure_count(predecessor: 3))

// THIS ROW GOES THROUGH THE CONSTRUCTOR RATHER THAN AROUND IT. A direct record literal is writable
// inside the defining module, and using one here would have bypassed both refusals above in the one
// place that actually mints production's artifact -- the constructor would then guard only fixtures.
fn serving_unit_observed_artifact() -> ServingUnitArtifact? {
  match serving_unit_bound_artifact_identity(
    shards: serving_unit_observed_shard_digests(),
    shard_count: serving_unit_observed_shard_count) {
    Absent => none
    Present { value: bound } =>
      serving_unit_artifact(
        primary_shard_path: "/home/briansrls/models/dsv4-iq3s/DeepSeek-V4-Flash-0731-UD-IQ3_S-00001-of-00004.gguf" as NonEmptyStr,
        shard_count: serving_unit_observed_shard_count,
        identity: ArtifactIdentityBound { identity: bound })
  }
}

// A UNIT WHOSE ARTIFACT IDENTITY IS UNBOUND MAY BE OBSERVED AND MAY NOT BE CONVERGED, and that is
// the whole reason to type the distinction. Convergence actuates bytes; a plan that cannot name
// which bytes it is asserting is asserting a path and hoping. This is the predicate a publication
// step consults, and it is now a TRIVIAL ELIMINATOR: every exactness condition was moved into
// serving_unit_bound_artifact_identity, so a Bound value is exact by construction and there is no
// second rule for a consumer to forget. It answers true for the observed artifact.
//
// READ WHAT IT SAYS AND NOT MORE: true here means THE PATHS HELD THESE BYTES WHEN THEY WERE READ. A
// converge step that needs "the process now serving loaded exactly these bytes" does not get that
// fact from this predicate, and there is no arm here that would supply it -- see the incarnation
// boundary above.
//
// DISPOSITION ON ELIMINATING THIS COPRODUCT BY MATCH RATHER THAN THROUGH A DERIVED PROJECTION.
// Review asked for this to consume a canonical fold or query surface instead of matching the two
// variants directly. Considered and declined, for three reasons that are checkable rather than
// stylistic.
//
// The precedent it invokes is gunbc.spark.cell_role, where a hand-rolled predicate matched a
// coproduct against ITSELF for equality while a canonical wire projection of the same variants
// already existed beside it. Deriving equality from that projection REMOVED a second enumeration.
// Here there is no such projection: ServingUnitArtifactIdentity has no canonical surface anywhere in
// the corpus, so routing through one means MINTING one -- creating a construct in order to satisfy a
// rule about not creating constructs, which is the re-invention §2 warns closes nothing.
//
// The two production matches on this type ask DIFFERENT questions, not one question twice.
// serving_unit_artifact asks the bound arm for its shard count in order to refuse a contradiction;
// this function asks which arm is present. Neither restates the other, so §5's "a check that
// re-states a constraint the model already carries" does not describe them.
//
// And the drift hazard the rule exists to prevent cannot occur here: `Match` over a closed variant
// set is one of the substrate's six behaviors, and exhaustive elimination of closed variants is part
// of the ordinary compiler floor DESIGN names. A third arm added to this type fails to compile at
// BOTH sites rather than silently defaulting at either, so there is nothing silent for a canonical
// surface to protect.
fn serving_unit_artifact_is_bound(a: ServingUnitArtifact) -> Bool {
  match a.identity {
    ArtifactIdentityBound { identity: _ } => true
    ArtifactIdentityUnobserved { cause: _ } => false
  }
}

// ================= WHAT THE FRONT DOOR ACTUALLY ANSWERS =================
//
// THIS IS NOT AN OLLAMA, AND A PROBE THAT ASSUMES IT IS READS A HEALTHY UNIT AS DEAD.
//
// Measured directly against the front door rather than taken from the handoff: /props answers with
// total_slots 10 and default_generation_settings.n_ctx 1048576, /v1/models answers with the split
// alias, and /api/tags answers 404. gunbc.spark.serving_terminal_health and
// gunbc.spark.serving_readback_parse both read ollama routes, so pointing today's readback at this
// unit would report every route missing and conclude the host is not serving.
//
// THE CONTEXT AUTHORITY IS /props AND THE FIGURE IT REPORTS IS ALREADY DIVIDED. That is what makes
// it the right thing to compare against and the unit file's `-c` the wrong thing: the two are
// different quantities, and the silent-shrink failure is invisible to anything that checks the
// second one.
type ServingUnitApiSurface = OpenAiCompatibleSurface | OllamaSurface

data serving_unit_observed_api_surface: ServingUnitApiSurface = OpenAiCompatibleSurface

fn serving_unit_context_authority_route(surface: ServingUnitApiSurface) -> NonEmptyStr {
  match surface {
    OpenAiCompatibleSurface => "/props" as NonEmptyStr
    OllamaSurface => "/api/show" as NonEmptyStr
  }
}

fn serving_unit_model_listing_route(surface: ServingUnitApiSurface) -> NonEmptyStr {
  match surface {
    OpenAiCompatibleSurface => "/v1/models" as NonEmptyStr
    OllamaSurface => "/api/tags" as NonEmptyStr
  }
}

// ================= ONE CONSTRUCTOR FOR ONE OBSERVED REALIZATION =================
//
// UNTIL THIS TYPE EXISTED, THE OBSERVATIONS WERE ADJACENCY RATHER THAN A JOINED FACT. The unit, its
// artifact, its API surface and its throughput band sat as four separate module-scope values, and
// with exactly one of each nothing went wrong -- which is the whole problem, because nothing
// structural said they described the same executed realization either.
//
// THERE IS DELIBERATELY NO GENERAL MIXER, AND THAT IS THE HONEST RUNG RATHER THAN THE TIDY ONE. A
// public serving_unit_observation(unit, artifact, api_surface, throughput) was written first and
// removed: whatever condition it checked, it still ADMITTED `unit A + artifact B + surface D +
// throughput C` drawn from different realizations, which is precisely the failure this type claims
// to close. A slot-count agreement does not fix that -- a band measured at ten slots on a DIFFERENT
// ENGINE satisfies it -- and a constructor that admits the state it names is worse than no
// constructor, because it will be cited as having closed the class.
//
// WHAT WOULD ACTUALLY CLOSE IT is a shared realization identity that the artifact, the API surface
// and the throughput band are each keyed to, so that joining observations of two realizations has
// no constructor. That is not authorable from one observation: with a single realization the
// identity has nothing to discriminate, so its RED would be unwritable and the key would be
// decoration. THE TRIGGER IS THEREFORE THE SECOND REALIZATION -- a re-measurement or a second unit
// -- at which point the identity becomes both constructible and mandatory.
//
// Until then only the module's own 2026-09-02 observation can be built, below, and no caller can
// assemble a different one. That is a narrower capability than a join, and it is the one the
// evidence supports.
//
// THE UNIT STAYS IMPLEMENTATION-NEUTRAL AND THIS TYPE IS WHERE THAT IS PAID FOR. No llama.cpp, no
// IQ3_S, no engine anywhere in ServingUnit: it is the stable structural subject -- a front door, a
// weights peer, a fabric and a slot plan -- while ServingUnitObservation is ONE MEASURED
// REALIZATION of that subject.
// THE ARTIFACT FIELD IS NAMED FOR WHAT IT IS. `on_disk_artifact` rather than `artifact`, because
// this record otherwise reads as four facts about one running process and one of them is a fact
// about a filesystem. The name is the only thing that travels to every consumer.
type ServingUnitObservation sole_constructor {
  unit: ServingUnit
  on_disk_artifact: ServingUnitArtifact
  api_surface: ServingUnitApiSurface
  throughput: ServingUnitThroughputBand
}

// The observation of 2026-09-02, or Absent when any part of it failed to construct. There is no arm
// that reports a partial observation: a join missing one of its arms is not a weaker observation of
// the same realization, it is a claim about a realization nobody fully measured.
fn serving_unit_observed_observation() -> ServingUnitObservation? {
  match serving_unit_observed() {
    Absent => none
    Present { value: u } =>
      match serving_unit_observed_throughput() {
        Absent => none
        Present { value: band } =>
          match serving_unit_observed_artifact() {
            Absent => none
            Present { value: art } =>
              Present { value: ServingUnitObservation {
                unit: u,
                on_disk_artifact: art,
                api_surface: serving_unit_observed_api_surface,
                throughput: band,
              } }
          }
      }
  }
}
