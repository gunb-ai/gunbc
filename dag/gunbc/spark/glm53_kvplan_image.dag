module gunbc.spark.glm53_kvplan_image

import std.types { String, List, NonEmptyStr }
import extdeps.docker.cli { docker_run_ephemeral_command }

import std.algebra { trim }
import std.optional { Present, Absent }

import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.exec.command { argv_words }
import extdeps.vllm.source_build { VllmContainerBuildRecipe, vllm_8d09804_sm121_recipe }
import gunbc.fleet_known_hosts_anchor { FleetSshExecutionContext, SshTarget }
import gunbc.spark.model_snapshot_materialize { SparkMaterializeContext, spark_remote_run, RemoteRan, RemoteUnreachable }
import gunbc.spark.vllm_runtime_image_build { VllmImageBuilt, VllmImageBuildRefused, converge_vllm_image_for_recipe, vllm_image_receipt_line, SparkBuildHostWork, converge_glm53_kvplan_image, glm53_kvplan_patch_path, glm53_kvplan_package_dir }
import gunbc.spark.group_image_produce { GroupImageProduction, ProducedImageHeld }
import gunbc.spark.vllm_runtime_image_build { VllmImageDistributionSubject }
import extdeps.container.oci.digest { OciSha256Digest }
import std.content_hash { Sha256Digest, Sha256DigestHex }
import product.host_identity { HostIdentity }
import gunbc.spark.runtime_architecture_registry_reading { registry_dump_architectures, registry_dump_count }

// ── THE GLM-5.3-FLASH IMAGE WITH THE KV ALLOCATION-PLAN EMISSION, PRODUCED ONCE (deforking cut 8c) ──
//
// WHY THIS EXISTS. The GLM arm's runtime row gunbc.spark.serving_arm glm53_derived_kvplan_v2_row was
// built by hand PER Group B host (docs/runbooks/glm-kv-allocation-plan-image-rebuild.md), so it has four
// content ids under one tag and no single identity a D0 grant or a staircase subject could name, and it
// is on no Group A host. This is that runbook's layer made a modeled build: the base recipe
// (extdeps.vllm.source_build vllm_8d09804_sm121_recipe) and its flashinfer derived stage
// (gunbc.spark.vllm_runtime_image_build converge_vllm_image_for_recipe) built on ONE Group A host, then
// the two Python files the v2 patch changes copied over the installed package in one more layer, then
// read back by digest and probed inside that digest. Its product is one content id; the staircase is
// keyed to it, so a Group A winner does not describe Group B's per-host images (ruling of
// valiant-crab-775, 2026-10-02).
//
// THE BUILD HALF (the pins, the prepare script, the Dockerfile, the adopt/build/readback convergence) lives
// in gunbc.spark.vllm_runtime_image_build beside the flashinfer derived stage, the home of every
// VllmImageIdentity mint (converge_glm53_kvplan_image). This module is the probe and the production.
//
// WHY A FILE LAYER AND NOT A PATCHED SOURCE BUILD, as the runbook argues: the patch touches only
// vllm/v1/engine/core.py and vllm/envs.py, pure Python with no compiled artifact, so the base build's
// compiled bytes are the patched source's compiled bytes.

// ── THE PROBE INSIDE THE PRODUCED DIGEST ──────────────────────────────────────────────────────
//
// ONE EPHEMERAL CONTAINER OF THE DIGEST (never the tag), no GPU, no checkpoint: the engine's version,
// where its package lives, whether the patched core carries the emission marker, where the Hub CLI is
// (the runtime row's hub_cli_path, which the checkpoint materialize runs inside this image), and the whole model
// registry (REGISTRY_COUNT, then one REGISTERED line per architecture -- the dump
// gunbc.spark.runtime_architecture_registry_reading's fold reads). The registry dump is what a
// runtime row's registry_reading is recorded from, citing the run.
data glm53_kvplan_probe_script: String = "import os, shutil, vllm\nprint('HF_CLI ' + (shutil.which('hf') or 'absent'))\nprint('VLLM_VERSION ' + vllm.__version__)\nprint('VLLM_PACKAGE_DIR ' + os.path.dirname(vllm.__file__))\nimport vllm.v1.engine.core as c\nprint('KVPLAN_MARKER ' + ('present' if getattr(c, 'KV_ALLOCATION_PLAN_LOG_MARKER', None) == 'KV_ALLOCATION_PLAN_JSON ' else 'absent'))\nfrom vllm.model_executor.models.registry import ModelRegistry\na = sorted(ModelRegistry.get_supported_archs())\nprint('REGISTRY_COUNT ' + str(len(a)))\nfor x in a:\n    print('REGISTERED ' + x)\n"

data glm53_kvplan_engine_version: String = "0.1.dev1+g8d09804c8"

fn glm53_kvplan_probe_argv(digest: NonEmptyStr) -> List<String> {
  argv_words(command: docker_run_ephemeral_command(image: digest, gpus_all: false, mounts: [], labels: [], memory_limit: Absent, entrypoint: "python3" as NonEmptyStr, argv: ["-c", glm53_kvplan_probe_script]))
}

fn probe_line_value(stdout: String, prefix: String) -> String? {
  first(flat_map(split(stdout, "\n"), l => {
    let t = trim(s: l)
    if starts_with(s: t, prefix: prefix) { [substring(s: t, start: length(prefix), end: length(t))] } else { [] as List<String> }
  }))
}

type Glm53KvplanProbe
  = Glm53KvplanProbeHeld { digest: NonEmptyStr, architectures: List<NonEmptyStr>, receipt: String }
  | Glm53KvplanProbeRefused { receipt: String }

// HELD ONLY WHEN EVERY ANSWER IS THE ONE THE BUILD OWES: the pinned engine version, the package where
// the layer copied the files, the marker present, and a registry whose REGISTERED lines number exactly
// its count. Anything else refuses and the receipt carries what was answered.
fn glm53_kvplan_probe(ctx: SparkMaterializeContext, digest: NonEmptyStr, r: VllmContainerBuildRecipe) -> Glm53KvplanProbe {
  match spark_remote_run(ctx: ctx, argv: glm53_kvplan_probe_argv(digest: digest)) {
    RemoteUnreachable { cause: c, reach: _ } => Glm53KvplanProbeRefused { receipt: join(["probe inside ", digest as String, " DID NOT RUN: ", c, "\n"], "") }
    RemoteRan { exit_code: code, stdout: out, stderr: err } => {
      let archs = registry_dump_architectures(stdout: out)
      let version = probe_line_value(stdout: out, prefix: "VLLM_VERSION ")
      let pkg = probe_line_value(stdout: out, prefix: "VLLM_PACKAGE_DIR ")
      let marker = probe_line_value(stdout: out, prefix: "KVPLAN_MARKER ")
      let count_ok = match registry_dump_count(stdout: out) { Present { value: n } => n > 0 && length(archs) == n  Absent => false }
      let defects = concat(concat(concat(concat(
        if code == 0 { [] as List<String> } else { [join(["the probe exited ", to_string(code), ": ", trim(s: err)], "")] },
        match version { Present { value: v } => if v == glm53_kvplan_engine_version { [] as List<String> } else { [join(["the engine reports ", v, ", not ", glm53_kvplan_engine_version], "")] }  Absent => ["the engine version was not printed"] }),
        match pkg { Present { value: d } => if d == (glm53_kvplan_package_dir(r: r) as String) { [] as List<String> } else { [join(["vLLM is installed at ", d, ", not where the layer copied the patched files (", glm53_kvplan_package_dir(r: r) as String, ")"], "")] }  Absent => ["the package directory was not printed"] }),
        match marker { Present { value: m } => if m == "present" { [] as List<String> } else { ["the patched core does not carry KV_ALLOCATION_PLAN_LOG_MARKER"] }  Absent => ["the marker line was not printed"] }),
        if count_ok { [] as List<String> } else { ["the registry dump's REGISTERED lines do not number its REGISTRY_COUNT"] })
      let head = join([
        "probe inside ", digest as String, ": version=", match version { Present { value: v } => v  Absent => "?" },
        " package=", match pkg { Present { value: d } => d  Absent => "?" },
        " marker=", match marker { Present { value: m } => m  Absent => "?" },
        " hf_cli=", match probe_line_value(stdout: out, prefix: "HF_CLI ") { Present { value: h } => h  Absent => "?" },
        " registry=", to_string(length(archs)), " architectures\n",
      ], "")
      if length(defects) == 0 {
        Glm53KvplanProbeHeld { digest: digest, architectures: archs, receipt: join([head, "registry dump (record as the runtime row's reading, citing this run):\n", join(map(archs, a => join(["  REGISTERED ", a as String, "\n"], "")), "")], "") }
      } else {
        Glm53KvplanProbeRefused { receipt: join([head, "probe REFUSED:\n", join(map(defects, d => join(["  - ", d, "\n"], "")), ""), "stdout:\n", out], "") }
      }
    }
  }
}

// ── THE PRODUCTION: BASE, FLASHINFER STAGE, KVPLAN LAYER, PROBE ─────────────────────────────────
//
// The patch bytes are read here, on the runner, from the corpus; the host verifies their digest before
// applying them. Converged only when every stage built or adopted AND the probe held.
fn glm53_kvplan_produce(target: SshTarget, context: FleetSshExecutionContext, ctx: SparkMaterializeContext) -> SparkBuildHostWork {
  let r = vllm_8d09804_sm121_recipe
  let read = Filesystem.Read(path: glm53_kvplan_patch_path as String)
  if !read.success {
    SparkBuildHostWork { receipt: join(["NOT PRODUCED: the patch could not be read from the corpus at ", glm53_kvplan_patch_path as String, ": ", read.error, "\n"], ""), converged: false }
  } else {
    let derived = converge_vllm_image_for_recipe(target: target, context: context, ctx: ctx, r: r)
    match derived {
      VllmImageBuildRefused { step: _, cause: _ } => SparkBuildHostWork { receipt: join(["base and flashinfer stage: ", vllm_image_receipt_line(b: derived)], ""), converged: false }
      VllmImageBuilt { identity: d, already_present: _ } => {
        let layer = converge_glm53_kvplan_image(target: target, context: context, ctx: ctx, derived: d, r: r, patch_text: read.content)
        let built = join(["base and flashinfer stage: ", vllm_image_receipt_line(b: derived), "kvplan layer: ", vllm_image_receipt_line(b: layer)], "")
        match layer {
          VllmImageBuildRefused { step: _, cause: _ } => SparkBuildHostWork { receipt: built, converged: false }
          VllmImageBuilt { identity: k, already_present: _ } =>
            match glm53_kvplan_probe(ctx: ctx, digest: k.local_config_digest, r: r) {
              Glm53KvplanProbeRefused { receipt: pr } => SparkBuildHostWork { receipt: join([built, pr], ""), converged: false }
              Glm53KvplanProbeHeld { digest: dg, architectures: _, receipt: pr } =>
                SparkBuildHostWork { receipt: join([built, "PRODUCED glm53 kvplan-v2 image tag=", k.tag as String, " config_digest=", dg as String, " on ", ctx.host as String, "\n", pr], ""), converged: true }
            }
        }
      }
    }
  }
}

// THE GLM IMAGE AS ONE PRODUCTION OF THE ONE ENTRY (gunbc.spark.group_image_produce).
fn glm53_kvplan_production() -> GroupImageProduction {
  GroupImageProduction {
    title: "glm53 kvplan-v2 runtime image produce" as NonEmptyStr,
    group: FabricGroupA,
    attempt_raw: "glm53-kvplan-image-produce",
    identity_file_name: "gunbc-glm53-kvplan-image-produce-admin-password" as NonEmptyStr,
    produce: fn(target, context, ctx) { glm53_kvplan_produce(target: target, context: context, ctx: ctx) },
  }
}

// THE PRODUCED IMAGE'S RECEIPT ROW. Absent until a production run through spark_runtime_image_produce
// has converged and its receipt (tag, configuration digest, host, run) is transcribed here, citing the
// run -- the same discipline as gunbc.spark.v41_runtime_image_converge v41_production_produced_image.
// Recorded from fleet-converge run 37100656092 (srv7, 2026-10-03): its PRODUCED line and the probe
// inside the configuration digest. The runtime row that names this identity is gunbc.spark.serving_arm
// glm53_kvplan_v2_group_a_row.
fn glm53_kvplan_produced_image_held() -> ProducedImageHeld? {
  Present { value: ProducedImageHeld {
    title: "glm53 kvplan-v2 runtime image" as NonEmptyStr,
    group: FabricGroupA,
    subject: VllmImageDistributionSubject {
      tag: "gunbc-vllm-glm53-gb10:kvplan-v2-50ba9aad263fea47" as NonEmptyStr,
      config: OciSha256Digest(Sha256Digest { hex: "6ef84cd49a68dbefd957bfca36f0ec458ed80f8194def41642e7b37b34ae76fb" as Sha256DigestHex }),
    },
    held_on: "srv7" as HostIdentity,
    receipt_run: "37100656092" as NonEmptyStr,
  } }
}

