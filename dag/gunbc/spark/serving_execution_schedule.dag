module gunbc.spark.serving_execution_schedule

import std.types { String, Bool, List, Int }
import v2.std.dependency { DependencyKind, DependencyRelation, BarrierBefore, ResourceDependsOn }
import v2.workflow.scheduler {
  SchedulerPlan,
  SchedulerPlanBlocked,
  SchedulerPlanComplete,
  SchedulerPlanRunnable,
  scheduler_plan_from_relations,
}
import gunbc.membership_reconcile {
  MembershipPlan,
  MemberAction,
  MemberAdded,
  MemberChanged,
  MemberRemoved,
  MemberRemovalRefused,
  MemberRosterDuplicateKeyRefused,
}
import gunbc.spark.serving_membership {
  SparkServingMember,
  SparkServingMemberAt,
  SparkServingResourceAddress,
  SparkServingRuntimeRootAddress,
  SparkServingUserUnitAddress,
  SparkServingUserUnitRegistrationAddress,
  SparkServingUserUnitEnablementAddress,
  SparkServingModelSlotAddress,
  SparkServingLingerAddress,
  spark_serving_resource_address_wire,
  spark_serving_resource_address_eq,
}

// THE ORDER A CONVERGENCE RUNS IN IS DERIVED, NOT AUTHORED.
//
// A membership diff answers WHICH resources disagree with the desired state. It says nothing about
// the order in which the remedies may run, because a set difference has no order -- the sequence the
// rows happen to arrive in is an artifact of how the two rosters were walked, not a fact about the
// resources. Executing that sequence as though it were a schedule is a state-space conflation on the
// plan itself: `these rows must change` and `these rows must change in this order` are different
// claims, and taking the first for the second is how a manager reload was issued against a unit file
// that had not been written yet.
//
// So the order is derived from resource facts. Each address declares what it REQUIRES to exist
// before its remedy can run and what its remedy ESTABLISHES; the prerequisite relation between two
// planned rows is then read off those two lists rather than stated by anyone. That is the §5 move
// from validation to construction -- there is no authored sequence left to get wrong, and a new
// address cannot be given a position in the order at all, only facts, from which its position
// follows.
data spark_serving_execution_schedule_authority_note: String = "Execution order for a Spark serving convergence is DERIVED from per-address requires/establishes resource facts and scheduled by the one v2.workflow.scheduler kernel bound to SparkServingMemberAt -- never authored, never the membership diff's row order, which is a set difference with no order. A required fact with no provider among the planned rows and no observed establishment REFUSES (SparkServingScheduleMissingProvider); two providers for one fact REFUSE (SparkServingScheduleAmbiguousProvider); a cycle REFUSES through the kernel's own SchedulerPlanBlocked arm rather than through a second cycle check authored here. Apply consumes SparkServingFrozenExecutionSchedule and nothing else: the carrier has one constructor, reachable only through spark_serving_freeze_execution_schedule, so a row list cannot be handed to actuation in the order it was diffed."

// WHAT A RESOURCE IS, AS A FACT ANOTHER RESOURCE CAN DEPEND ON.
//
// These are states of the host, not steps. `UnitKnownToManager` is what a manager reload leaves
// behind; enablement requires it, and requires it whether the reload happened in this run or in a
// previous one. Naming the state rather than the step is what lets an already-converged prerequisite
// satisfy a requirement without a row being planned for it.
type SparkServingResourceFact
  = RuntimeClosurePresent
  | UnitFilePresent
  | UnitKnownToManager
  | UnitEnabled
  | UnitActive
  | ModelPresentInSlot { slot: String }
  | LingerEnabledForAccount

fn spark_serving_resource_fact_wire(fact: SparkServingResourceFact) -> String {
  match fact {
    RuntimeClosurePresent => "runtime-closure-present"
    UnitFilePresent => "unit-file-present"
    UnitKnownToManager => "unit-known-to-manager"
    UnitEnabled => "unit-enabled"
    UnitActive => "unit-active"
    ModelPresentInSlot { slot: slot } => join(["model-present:", slot], "")
    LingerEnabledForAccount => "linger-enabled"
  }
}

fn spark_serving_resource_fact_eq(a: SparkServingResourceFact, b: SparkServingResourceFact) -> Bool {
  spark_serving_resource_fact_wire(fact: a) == spark_serving_resource_fact_wire(fact: b)
}

// WHAT EACH ADDRESS ESTABLISHES. Exactly one fact per address, which is not a coincidence to be
// relied on quietly: the address IS the resource, so an address establishing two facts would be two
// resources sharing one membership key and its drift would be unattributable.
fn spark_serving_address_establishes(address: SparkServingResourceAddress) -> SparkServingResourceFact {
  match address {
    SparkServingRuntimeRootAddress => RuntimeClosurePresent
    SparkServingUserUnitAddress => UnitFilePresent
    SparkServingUserUnitRegistrationAddress => UnitKnownToManager
    SparkServingUserUnitEnablementAddress => UnitEnabled
    SparkServingUserUnitActivityAddress => UnitActive
    SparkServingModelSlotAddress { slot: slot } => ModelPresentInSlot { slot: slot as String }
    SparkServingLingerAddress => LingerEnabledForAccount
  }
}

// WHAT EACH ADDRESS REQUIRES.
//
// The unit file names the runtime's executable path, so writing it before the closure exists writes
// a unit that cannot start. Registration is what makes the manager aware of the file, so it requires
// the file. Enablement acts on a unit the manager knows, so it requires registration's fact and NOT
// the file's -- transitivity through the fact graph is what carries the file requirement, and
// restating it here would be a second representation of one edge.
//
// The model pull talks to the serving API, so it requires the unit to be enabled -- this is the same
// fact `the_frozen_order_enables_the_unit_before_pulling_the_model` asserts, now stated once as a requirement
// instead of twice as an assertion and an authored position.
//
// Linger requires nothing. It is an account property, not a service one, and giving it a spurious
// prerequisite would serialize a step that can run at any time.
// A REQUIREMENT CARRIES ITS KIND, because two different things are being said.
//
// An ENDURING resource requirement describes valid resource state: a unit's enablement is not
// meaningful unless the manager knows the unit, whoever established that and whenever. A REALIZATION
// BARRIER describes one realization's forward procedure: a model store does not universally depend
// on a running server, but the CLI pull this vertical realizes talks to the serving API and so must
// follow the step that starts it. Collapsing them would be a state-space conflation, and it has a
// consequence rather than only a name: enduring requirements reverse under teardown and procedural
// barriers do not, so a teardown order derived from a fused kind would be wrong in exactly the half
// that was never a resource fact.
type SparkServingRequirement {
  fact: SparkServingResourceFact
  kind: DependencyKind
}

fn spark_serving_address_requires(address: SparkServingResourceAddress) -> List<SparkServingRequirement> {
  match address {
    SparkServingRuntimeRootAddress => []
    SparkServingUserUnitAddress =>
      [SparkServingRequirement { fact: RuntimeClosurePresent, kind: ResourceDependsOn }]
    SparkServingUserUnitRegistrationAddress =>
      [SparkServingRequirement { fact: UnitFilePresent, kind: ResourceDependsOn }]
    SparkServingUserUnitEnablementAddress =>
      [SparkServingRequirement { fact: UnitKnownToManager, kind: ResourceDependsOn }]
    SparkServingUserUnitActivityAddress =>
      [SparkServingRequirement { fact: UnitKnownToManager, kind: ResourceDependsOn }]
    SparkServingModelSlotAddress { slot: _ } =>
      [SparkServingRequirement { fact: UnitActive, kind: BarrierBefore }]
    SparkServingLingerAddress => []
  }
}

// TEARDOWN ORDER IS DECLARED, NOT DERIVED BY REVERSING THE INSTALL GRAPH.
//
// The refusal this replaces said teardown runs the prerequisite graph BACKWARD. That is the natural
// guess and it is wrong here, which is why the arm refused rather than being written speculatively --
// and the reason it is wrong is a fact the install graph never had to carry.
//
// Reverse the resource edges and you get: enablement and activity torn down first (both depend on
// registration), then registration, then the unit file. That order deletes nothing dangerous, and it
// still cannot be executed. `systemctl disable` reads the unit file's `[Install]` section to know
// which symlinks to remove, so the FILE MUST STILL EXIST WHEN DISABLE RUNS. Install never needed to
// say so -- writing the file always precedes enabling it, so the dependency was satisfied
// incidentally by the forward order and never had to be modeled. Under teardown it becomes
// load-bearing and there is nothing in the install relation to reverse into it.
//
// The registration edge is wrong in the reversed order for a second, independent reason. Its
// teardown remedy is `ReloadUserManagerAfterRemoval`, and the manager can only forget a unit once the
// file is gone -- so registration's teardown FOLLOWS the file's rather than preceding it. That is a
// procedural barrier in the teardown direction, and this module's own requirement vocabulary already
// says why it cannot be derived: barriers do not reverse.
//
// WHAT THE HOST FACTS ESTABLISH IS A PARTIAL ORDER, AND NOT ONE EDGE MORE.
//
//   activity   (stop)    ──┐
//                          ├──→ content (rm file) ──barrier──→ registration (daemon-reload)
//   enablement (disable) ──┘
//
// The chain `activity → enablement` that an earlier draft of this function declared is NOT grounded.
// `stop` and `disable` answer independent final-state obligations -- one makes the process inactive,
// the other stops the unit returning at boot -- and neither reads the other's result. Declaring a
// total chain therefore rejected `disable → stop → rm → reload`, which is equally safe. An authority
// edge nobody established is exactly the kind of arbitrary convention §1 says to remove: it would
// have constrained every future executor for no reason a host fact could be cited for.
//
// The kinds are not decoration. The two edges into content are enduring resource requirements -- the
// file must exist while those remedies run, whoever established it -- while content → registration is
// procedural: the reload is a step that must follow the deletion, not a resource state disable reads.
// The same distinction the install requirements already carry, and for the same reason.
type SparkServingTeardownRequirement {
  predecessor: SparkServingResourceAddress
  kind: DependencyKind
}

fn spark_serving_address_teardown_predecessors(
  address: SparkServingResourceAddress,
) -> List<SparkServingTeardownRequirement> {
  match address {
    SparkServingUserUnitActivityAddress => []
    SparkServingUserUnitEnablementAddress => []
    SparkServingUserUnitAddress => [
      SparkServingTeardownRequirement {
        predecessor: SparkServingUserUnitActivityAddress,
        kind: ResourceDependsOn,
      },
      SparkServingTeardownRequirement {
        predecessor: SparkServingUserUnitEnablementAddress,
        kind: ResourceDependsOn,
      },
    ]
    SparkServingUserUnitRegistrationAddress => [
      SparkServingTeardownRequirement {
        predecessor: SparkServingUserUnitAddress,
        kind: BarrierBefore,
      },
    ]
    SparkServingRuntimeRootAddress => []
    SparkServingModelSlotAddress { slot: _ } => []
    SparkServingLingerAddress => []
  }
}

// A PLANNED ROW REDUCED TO WHAT SCHEDULING NEEDS: its reconcile key, which is the subject the
// scheduler orders, and its address, which is what carries the facts.
type SparkServingScheduledRow {
  at: SparkServingMemberAt
  address: SparkServingResourceAddress
}

// THE DIRECTION A SCHEDULE CAN RUN IN HAS THREE ARMS, AND MIXED IS NOT ONE OF THEM.
//
// This is the narrowing that closes a fallback. An earlier draft carried one direction sum with a
// `Mixed` arm all the way to relation selection, where the mixed case answered the EMPTY relation on
// the stated grounds that the projection had already refused it. That reasoning is exactly the shape
// §5 names an absorbing fallback: correct only because of a caller arrangement, silent if the
// arrangement changes, and the silence would schedule a mixed plan in diff order -- the one thing the
// frozen carrier exists to prevent.
//
// So the unschedulable cases have no constructor past the projection. `SparkServingPlanDirection`
// classifies a plan and admits the bad cases so a refusal can name them; only
// `SparkServingSchedulableDirection` reaches relation selection, and it cannot spell them.
type SparkServingSchedulableDirection
  = SparkServingSchedulableInstalls
  | SparkServingSchedulableTeardown
  | SparkServingSchedulableEmpty

// THE DIRECTION IS CARRIED BESIDE THE ROWS, NOT RECOMPUTED FROM THE PLAN. Classifying once and
// passing the answer makes "the rows and the relation agree about which direction this is" a
// construction fact rather than two derivations a later edit could split.
type SparkServingScheduleRowProjection
  = SparkServingScheduleRowsProjected {
      rows: List<SparkServingScheduledRow>
      direction: SparkServingSchedulableDirection
    }
  | SparkServingScheduleRowsRefused { cause: String }

// A PLAN IS ALL INSTALL OR ALL TEARDOWN, AND A MIXED ONE STILL REFUSES.
//
// The arm this replaces refused every plan containing a removal, on the stated grounds that teardown
// order was not modeled. It now is, so that refusal would be a wall standing where a relation exists.
// What does NOT follow is that any plan can be scheduled: a plan carrying installs AND removals
// interleaves two orders whose composition nobody has modeled -- the forward chain and the teardown
// chain touch the same four addresses from opposite ends, and merging them is a third relation, not
// the union of two. That arm keeps refusing, for the reason the original refusal gave and which is
// still true of it.
//
// The partition is exhaustive over MemberAction, so a new action arm cannot silently land in either
// bucket.
type SparkServingPlanDirection
  = SparkServingPlanInstalls
  | SparkServingPlanTeardown
  | SparkServingPlanEmpty
  | SparkServingPlanMixed { install_count: Int, removal_count: Int }
  | SparkServingPlanCarriesRefusals { refusal_count: Int }

// WHAT AN ACTION IS, ASKED ONCE.
//
// The shape this replaces enumerated MemberAction three times -- once to filter removals, once for
// installs, once for refusals -- and walked the plan three times to do it. Three enumerations of one
// coproduct is three places to edit when a variant lands and only one of them fails to compile if
// the others are forgotten, which is the single-authority problem stated at the smallest possible
// scale. The classification happens here, in the one exhaustive match, and every population is
// derived from its answer.
type SparkServingActionClass
  = SparkServingActionInstalls
  | SparkServingActionRemoves
  | SparkServingActionRefuses

fn spark_serving_action_class(
  action: MemberAction<SparkServingMember, SparkServingMemberAt>,
) -> SparkServingActionClass {
  match action {
    MemberAdded { at: _, to: _ } => SparkServingActionInstalls
    MemberChanged { at: _, from: _, to: _ } => SparkServingActionInstalls
    MemberRemoved { at: _, from: _ } => SparkServingActionRemoves
    MemberRemovalRefused { from: _, cause: _ } => SparkServingActionRefuses
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => SparkServingActionRefuses
  }
}

// THE CENSUS IS ONE FOLD, so the three counts cannot describe different traversals of one plan.
type SparkServingActionCensus {
  installs: Int
  removals: Int
  refusals: Int
}

fn spark_serving_action_census(
  actions: List<MemberAction<SparkServingMember, SparkServingMemberAt>>,
) -> SparkServingActionCensus {
  fold(actions, init: SparkServingActionCensus { installs: 0, removals: 0, refusals: 0 }, f: fn(acc, a) {
    match spark_serving_action_class(action: a) {
      SparkServingActionInstalls =>
        SparkServingActionCensus { installs: acc.installs + 1, removals: acc.removals, refusals: acc.refusals }
      SparkServingActionRemoves =>
        SparkServingActionCensus { installs: acc.installs, removals: acc.removals + 1, refusals: acc.refusals }
      SparkServingActionRefuses =>
        SparkServingActionCensus { installs: acc.installs, removals: acc.removals, refusals: acc.refusals + 1 }
    }
  })
}

fn spark_serving_plan_direction(
  plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
) -> SparkServingPlanDirection {
  let census = spark_serving_action_census(actions: plan.actions)
  if census.refusals > 0 {
    SparkServingPlanCarriesRefusals { refusal_count: census.refusals }
  } else if census.removals > 0 && census.installs > 0 {
    SparkServingPlanMixed { install_count: census.installs, removal_count: census.removals }
  } else if census.removals > 0 {
    SparkServingPlanTeardown
  } else if census.installs > 0 {
    SparkServingPlanInstalls
  } else {
    SparkServingPlanEmpty
  }
}

// A REFUSAL IN THE PLAN IS NOT AN EMPTY PLAN, WHICH IS THE SECOND CONFLATION THIS CLOSES.
//
// `MemberRemovalRefused` and `MemberRosterDuplicateKeyRefused` are neither installs nor removals, so
// a plan consisting entirely of them classified as EMPTY and projected to zero rows -- and a frozen
// empty schedule for a nonempty plan of refusals is a schedule saying "nothing to do" about a plan
// that said "I could not answer". The row-count check downstream happens to catch it in today's
// artifact path; the scheduler that claims to be the ordering authority accepted it. It refuses here.
fn spark_serving_schedule_rows(
  plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
) -> SparkServingScheduleRowProjection {
  match spark_serving_plan_direction(plan: plan) {
    SparkServingPlanMixed { install_count: i, removal_count: r } =>
      SparkServingScheduleRowsRefused {
        cause: join([
          "spark serving execution schedule refused: ", to_string(i),
          " install row(s) and ", to_string(r),
          " removal row(s) in one plan, and the composition of the forward and teardown orders is not modeled",
        ], ""),
      }
    SparkServingPlanCarriesRefusals { refusal_count: n } =>
      SparkServingScheduleRowsRefused {
        cause: join([
          "spark serving execution schedule refused: the plan carries ", to_string(n),
          " refusal action(s), which are neither installs nor removals -- a plan whose reconcile could not answer has no execution order to freeze",
        ], ""),
      }
    SparkServingPlanEmpty =>
      SparkServingScheduleRowsProjected { rows: [], direction: SparkServingSchedulableEmpty }
    SparkServingPlanTeardown =>
      spark_serving_schedule_row_projection(plan: plan, direction: SparkServingSchedulableTeardown)
    SparkServingPlanInstalls =>
      spark_serving_schedule_row_projection(plan: plan, direction: SparkServingSchedulableInstalls)
  }
}

// A REMOVAL IS A SCHEDULABLE ROW, AND ITS ADDRESS COMES FROM THE MEMBER BEING REMOVED.
//
// The arm this replaces returned [] for MemberRemoved, which was consistent with the refusal above it
// -- no removal could reach here, so the arm was unreachable and its emptiness cost nothing. With
// teardown scheduled, an empty arm would silently drop every retirement row and hand actuation a
// shorter schedule than the plan it came from, which is the shape the plan projection's row-count
// check exists to catch. The address is `from`'s, because a removal's subject is the member that
// existed.
fn spark_serving_schedule_row_projection(
  plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
  direction: SparkServingSchedulableDirection,
) -> SparkServingScheduleRowProjection {
  SparkServingScheduleRowsProjected {
    direction: direction,
    rows: flat_map(plan.actions, a =>
      match a {
        MemberAdded { at: at, to: to } => [SparkServingScheduledRow { at: at, address: to.address }]
        MemberChanged { at: at, from: _, to: to } => [SparkServingScheduledRow { at: at, address: to.address }]
        MemberRemoved { at: at, from: from } => [SparkServingScheduledRow { at: at, address: from.address }]
        MemberRemovalRefused { from: _, cause: _ } => []
        MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => []
      }
    ),
  }
}

// FACTS THE HOST ALREADY ESTABLISHES. A desired address with no planned row is a resource the
// observation found already in its desired state, so its fact holds before this run starts. This is
// what keeps a partial plan from refusing: enabling a unit in a run that writes no unit file is
// correct exactly when the file is already there, and that is a fact about the observation rather
// than a hole in the schedule.
fn spark_serving_preestablished_facts(
  desired_addresses: List<SparkServingResourceAddress>,
  rows: List<SparkServingScheduledRow>,
) -> List<SparkServingResourceFact> {
  flat_map(desired_addresses, a =>
    if length(filter(rows, r => spark_serving_resource_address_wire(address: r.address) == spark_serving_resource_address_wire(address: a))) == 0 {
      [spark_serving_address_establishes(address: a)]
    } else {
      []
    }
  )
}

fn spark_serving_fact_providers(
  rows: List<SparkServingScheduledRow>,
  fact: SparkServingResourceFact,
) -> List<SparkServingScheduledRow> {
  filter(rows, r => spark_serving_resource_fact_eq(a: spark_serving_address_establishes(address: r.address), b: fact))
}

type SparkServingScheduleRelations
  = SparkServingScheduleRelationsDerived { relations: List<DependencyRelation<SparkServingMemberAt>> }
  | SparkServingScheduleMissingProvider { dependent: String, fact: String }
  | SparkServingScheduleAmbiguousProvider { dependent: String, fact: String, provider_count: Int }

// ONE REQUIREMENT, RESOLVED TO AT MOST ONE EDGE.
//
// Three outcomes and each is named. A requirement met by a planned row becomes a prerequisite edge.
// A requirement met by the observation becomes no edge, because there is nothing to wait for. A
// requirement met by neither is a hole in the plan -- the remedy would run against a host that cannot
// satisfy it -- and it refuses rather than scheduling the row anyway and letting the failure surface
// as an opaque non-zero exit at actuation time. Two providers refuse as well: the edge would be
// genuinely ambiguous, and picking either one is the fabricated plausible output §5 forbids.
fn spark_serving_requirement_edges(
  rows: List<SparkServingScheduledRow>,
  preestablished: List<SparkServingResourceFact>,
  row: SparkServingScheduledRow,
  requirement: SparkServingRequirement,
) -> SparkServingScheduleRelations {
  let fact = requirement.fact
  let providers = spark_serving_fact_providers(rows: rows, fact: fact)
  if length(providers) > 1 {
    SparkServingScheduleAmbiguousProvider {
      dependent: row.at,
      fact: spark_serving_resource_fact_wire(fact: fact),
      provider_count: length(providers),
    }
  } else if length(providers) == 1 {
    SparkServingScheduleRelationsDerived {
      relations: flat_map(providers, p => [
        DependencyRelation {
          prerequisite: p.at,
          dependent: row.at,
          kind: requirement.kind,
        },
      ]),
    }
  } else if length(filter(preestablished, f => spark_serving_resource_fact_eq(a: f, b: fact))) > 0 {
    SparkServingScheduleRelationsDerived { relations: [] }
  } else {
    SparkServingScheduleMissingProvider {
      dependent: row.at,
      fact: spark_serving_resource_fact_wire(fact: fact),
    }
  }
}

fn spark_serving_merge_relations(
  acc: SparkServingScheduleRelations,
  next: SparkServingScheduleRelations,
) -> SparkServingScheduleRelations {
  match acc {
    SparkServingScheduleMissingProvider { dependent: d, fact: f } =>
      SparkServingScheduleMissingProvider { dependent: d, fact: f }
    SparkServingScheduleAmbiguousProvider { dependent: d, fact: f, provider_count: n } =>
      SparkServingScheduleAmbiguousProvider { dependent: d, fact: f, provider_count: n }
    SparkServingScheduleRelationsDerived { relations: have } =>
      match next {
        SparkServingScheduleMissingProvider { dependent: d, fact: f } =>
          SparkServingScheduleMissingProvider { dependent: d, fact: f }
        SparkServingScheduleAmbiguousProvider { dependent: d, fact: f, provider_count: n } =>
          SparkServingScheduleAmbiguousProvider { dependent: d, fact: f, provider_count: n }
        SparkServingScheduleRelationsDerived { relations: more } =>
          SparkServingScheduleRelationsDerived { relations: concat(have, more) }
      }
  }
}

// THE TEARDOWN RELATION IS BUILT FROM ROWS, NOT FROM FACTS, AND THAT ASYMMETRY IS THE POINT.
//
// The install relation resolves each requirement to whichever row ESTABLISHES a fact, so a
// prerequisite already satisfied by the host produces no edge and a missing one refuses. Teardown has
// no such indirection: its edges are between the removals themselves, and a predecessor that is not
// in the plan is not a hole -- it is a resource this run is not retiring, so there is nothing to wait
// for. Retiring only the activity member is a legitimate plan with no edges at all.
//
// So a missing predecessor is silently no edge here, where a missing PROVIDER refuses over there, and
// the two are different questions rather than the same one answered inconsistently.
fn spark_serving_teardown_relations(
  rows: List<SparkServingScheduledRow>,
) -> List<DependencyRelation<SparkServingMemberAt>> {
  flat_map(rows, row =>
    flat_map(spark_serving_address_teardown_predecessors(address: row.address), requirement =>
      flat_map(
        filter(rows, r => spark_serving_resource_address_eq(a: r.address, b: requirement.predecessor)),
        p => [
          DependencyRelation {
            prerequisite: p.at,
            dependent: row.at,
            kind: requirement.kind,
          },
        ],
      )
    )
  )
}

fn spark_serving_schedule_relations(
  rows: List<SparkServingScheduledRow>,
  preestablished: List<SparkServingResourceFact>,
) -> SparkServingScheduleRelations {
  fold(rows, init: SparkServingScheduleRelationsDerived { relations: [] }, f: fn(acc, row) {
    fold(spark_serving_address_requires(address: row.address), init: acc, f: fn(inner, requirement) {
      spark_serving_merge_relations(
        acc: inner,
        next: spark_serving_requirement_edges(
          rows: rows,
          preestablished: preestablished,
          row: row,
          requirement: requirement,
        ),
      )
    })
  })
}

// THE CARRIER ACTUATION ACCEPTS, AND THE ONLY WAY TO BUILD ONE.
//
// `sole_constructor` is what makes this a construction wall rather than a convention. A row list in
// diff order has the same type as a row list in execution order, so any function taking
// `List<SparkServingMemberAt>` can be handed the wrong one and no check anywhere would notice --
// which is exactly what happened. This type cannot be built outside this module, and inside it the
// only path runs through the scheduler, so an unscheduled sequence is not a thing that can reach
// actuation and be rejected: it is a thing that cannot be expressed.
type SparkServingFrozenExecutionSchedule sole_constructor {
  ordered: List<SparkServingMemberAt>
}

type SparkServingScheduleVerdict
  = SparkServingScheduleFrozen { schedule: SparkServingFrozenExecutionSchedule }
  | SparkServingScheduleRefused { cause: String }

// THE CYCLE ARM IS THE KERNEL'S, NOT A SECOND ONE WRITTEN HERE.
//
// `SchedulerPlanComplete` is the only arm that yields a schedule: it is the kernel's statement that
// every subject was scheduled, which is precisely the acyclicity proof. Runnable and Blocked both
// mean subjects remain, and remaining subjects under a fixed point means a cycle -- so both refuse,
// and neither is distinguished by anything authored in this module. Writing a cycle check beside the
// kernel that already refuses on cycles would be the second representation §3 forbids.
// WHICH RELATION GOVERNS IS DECIDED BY THE DIRECTION THE PROJECTION ALREADY CARRIES.
//
// There is no arm here for a plan that cannot be scheduled, because the parameter type has no
// constructor for one. The earlier version took the wide direction and answered the empty relation
// for `Mixed`; this one cannot be handed `Mixed` at all.
fn spark_serving_relations_for_direction(
  direction: SparkServingSchedulableDirection,
  rows: List<SparkServingScheduledRow>,
  preestablished: List<SparkServingResourceFact>,
) -> SparkServingScheduleRelations {
  match direction {
    SparkServingSchedulableTeardown =>
      SparkServingScheduleRelationsDerived { relations: spark_serving_teardown_relations(rows: rows) }
    SparkServingSchedulableInstalls =>
      spark_serving_schedule_relations(rows: rows, preestablished: preestablished)
    SparkServingSchedulableEmpty =>
      spark_serving_schedule_relations(rows: rows, preestablished: preestablished)
  }
}

fn spark_serving_freeze_execution_schedule(
  plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
  desired_addresses: List<SparkServingResourceAddress>,
) -> SparkServingScheduleVerdict {
  match spark_serving_schedule_rows(plan: plan) {
    SparkServingScheduleRowsRefused { cause: why } => SparkServingScheduleRefused { cause: why }
    SparkServingScheduleRowsProjected { rows: rows, direction: direction } => {
      let preestablished = spark_serving_preestablished_facts(
        desired_addresses: desired_addresses,
        rows: rows,
      )
      match spark_serving_relations_for_direction(
        direction: direction,
        rows: rows,
        preestablished: preestablished,
      ) {
        SparkServingScheduleMissingProvider { dependent: d, fact: f } =>
          SparkServingScheduleRefused {
            cause: join([
              "spark serving execution schedule refused: row ", d,
              " requires fact ", f,
              " which no planned row establishes and the observation did not already establish",
            ], ""),
          }
        SparkServingScheduleAmbiguousProvider { dependent: d, fact: f, provider_count: n } =>
          SparkServingScheduleRefused {
            cause: join([
              "spark serving execution schedule refused: row ", d,
              " requires fact ", f,
              " established by ", to_string(n),
              " planned rows, so the prerequisite edge is ambiguous",
            ], ""),
          }
        SparkServingScheduleRelationsDerived { relations: relations } =>
          match scheduler_plan_from_relations(
            subjects: flat_map(rows, r => [r.at]),
            relations: relations,
            scheduled: [],
            eq: spark_serving_schedule_subject_eq,
          ) {
            SchedulerPlanComplete { layers: _, scheduled: scheduled } =>
              SparkServingScheduleFrozen {
                schedule: SparkServingFrozenExecutionSchedule { ordered: scheduled },
              }
            SchedulerPlanRunnable { frontier: _, scheduled: _, remaining: remaining, layers: _ } =>
              SparkServingScheduleRefused {
                cause: join([
                  "spark serving execution schedule refused: ", to_string(length(remaining)),
                  " row(s) unscheduled at the fixed point — the prerequisite graph is cyclic",
                ], ""),
              }
            SchedulerPlanBlocked { evidence: _, scheduled: _, remaining: remaining, layers: _ } =>
              SparkServingScheduleRefused {
                cause: join([
                  "spark serving execution schedule refused: no runnable frontier with ",
                  to_string(length(remaining)),
                  " row(s) remaining — the prerequisite graph is cyclic",
                ], ""),
              }
          }
      }
    }
  }
}

fn spark_serving_schedule_subject_eq(a: SparkServingMemberAt, b: SparkServingMemberAt) -> Bool {
  a == b
}

fn spark_serving_frozen_schedule_order(
  schedule: SparkServingFrozenExecutionSchedule,
) -> List<SparkServingMemberAt> {
  schedule.ordered
}

// ROWS THAT CANNOT BE HANDED OVER IN THE WRONG ORDER.
//
// Freezing the schedule made the ORDER derivable; it did not make the wrong order unusable. Emission
// folded the frozen order, so the list apply received was correct -- but a diff-ordered list and a
// schedule-ordered list are the same type, so the guarantee lived in the producer's current behaviour
// rather than in anything the consumer could check. That is the same shape as the defect this whole
// vertical exists to close: a value that is right today because of who built it, not because a wrong
// one is unrepresentable.
//
// ScheduledRows is sole_constructor and its only mint takes a frozen schedule. The caller supplies
// the rows FOR a subject and cannot supply their order -- the fold walks the schedule, so the order
// is the scheduler's by construction. A consumer holding a ScheduledRows is holding rows that were
// ordered by a graph, and there is no other way to have obtained one.
//
// It is generic in the row because the artifact carrying it is declared upstream of this module and
// naming that row type here would close an import cycle. The subject is this vertical's; the row is
// whatever the plan layer freezes.
type ScheduledRows<Row> sole_constructor {
  rows: List<Row>
}

fn scheduled_rows_from_frozen_schedule<Row>(
  schedule: SparkServingFrozenExecutionSchedule,
  rows_for: fn(SparkServingMemberAt) -> List<Row>,
) -> ScheduledRows<Row> {
  ScheduledRows {
    rows: flat_map(
      spark_serving_frozen_schedule_order(schedule: schedule),
      at => rows_for(at),
    ),
  }
}

// THE OBSERVED MEMBERS AND THE ROWS PLANNED FROM THEM ARE ONE AXIS PRODUCT.
//
// The full-host artifact took `observed_spark` (which feeds the observed baseline) and the scheduled
// rows as two independent parameters, so a caller could hand it members from one observation and a
// schedule planned from another. The baseline would then fingerprint a state the rows were never
// derived from -- and the baseline is precisely what apply re-checks to decide the plan still
// applies, so the disagreement would be invisible at exactly the moment it mattered.
//
// This is the same class as the two-host defect #9754 closed and the projection-provenance one
// beside it: a fact carried twice, joinable only by convention. Pairing them under one carrier that
// only the row producer mints means the members that fingerprinted the baseline are the members the
// schedule was planned from, structurally.
// It is generic in the row for the same reason ScheduledRows is: the row type is declared upstream
// in the plan layer, and naming it here would close an import cycle.
type SparkServingAxisProduct<Row> sole_constructor {
  observed_members: List<SparkServingMember>
  rows: ScheduledRows<Row>
}

fn spark_serving_axis_product<Row>(
  observed_members: List<SparkServingMember>,
  rows: ScheduledRows<Row>,
) -> SparkServingAxisProduct<Row> {
  SparkServingAxisProduct { observed_members: observed_members, rows: rows }
}

fn spark_serving_axis_product_observed_members<Row>(a: SparkServingAxisProduct<Row>) -> List<SparkServingMember> {
  a.observed_members
}

fn spark_serving_axis_product_rows<Row>(a: SparkServingAxisProduct<Row>) -> ScheduledRows<Row> {
  a.rows
}

// The empty axis: a host with no Spark observation at all. Distinct from an observed host that owes
// no writes, which arrives through the row producer with its members attached.
fn spark_serving_axis_product_unobserved<Row>() -> SparkServingAxisProduct<Row> {
  SparkServingAxisProduct { observed_members: [], rows: scheduled_rows_empty() }
}

fn scheduled_rows_list<Row>(scheduled: ScheduledRows<Row>) -> List<Row> {
  scheduled.rows
}

// THE EMPTY ONE, and why it is a mint rather than a hole in the wall.
//
// A host with no Spark rows to freeze still needs an artifact, and sole_constructor means the plan
// layer cannot write one. This supplies it. It is not a bypass: the wall exists to stop rows being
// handed over in an order nobody derived, and an empty list has no order to get wrong -- there is no
// sequence it could be the wrong one of. The mint takes no rows for exactly that reason, so it
// cannot be used to smuggle a populated list past the fold.
fn scheduled_rows_empty<Row>() -> ScheduledRows<Row> {
  ScheduledRows { rows: [] }
}
