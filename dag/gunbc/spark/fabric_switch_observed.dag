import extdeps.ethernet.link_mode { ieee_100gbase_cr2 }
import extdeps.transceiver.sff_8636 {
  transceiver_identifier_from_byte, sff8636_encoding_from_byte,
  sff8636_nominal_rate_from_byte140,
}
import product.cable_leg_observation {
  CableLegObservation, SecondaryObserved, cable_leg_observation,
  ExtendedRateObserved,
}
import product.cable_plant_assessment {
  CablePlant, cable_plant, CableLegReading, LegReadingTaken, LegNeverRead, CablePlantInspection,
  inspect_cable_plant,
}
import gunbc.fleet_intent_network {
  operator_host_srv5, operator_host_srv6, operator_host_srv7, operator_host_srv8,
  operator_host_srv9, operator_host_srv10, operator_host_srv11, operator_host_srv12,
}

// THE SWITCHED FABRIC AS OBSERVED FROM BOTH ENDS ON 2026-09-05. Every Spark carries ONE leg of an FS
// QDD-400G-4QPC015 breakout in its bottom cage; the switch's LLDP neighbour table names each Spark
// on its lane and each Spark's lldpctl names the switch (identity gunbc-fabric-switch) and the lane.
// That two-sided join is the positive cable receipt the direct pairs never had. Each row below is a
// transcription of that join, and the group projection at the bottom is derived from which 400G
// cage a lane belongs to, never asserted.
//
// TWO FACTS ABOUT THE SPARK END THAT THE MODEL MUST NOT SMOOTH OVER:
//   - the leg appears on the NIC's SECOND-FUNCTION ports (enp1s0f1np1 / enP2p1s0f1np1), not the
//     first-function ports the direct 200G cables used, because a two-lane leg occupies the upper
//     lanes of the 200G cage;
//   - BOTH second-function netdevs come up from the one leg, with distinct MACs the switch sees on
//     the same lane. Only one of them may carry the rail address.
//
// THE LEG LINKS AT 50G, THE CODING BLOCKER IS GONE, AND A SECOND BLOCKER IS NOW DEMONSTRATED. Until
// 2026-09-16 the legs were QSFP28-coded: extended specification compliance 0x0B ("100GBASE-CR4 or
// 25GBASE-CR CA-L") at byte 192, with byte 116 read as 00h, so nothing attested 100GBASE-CR2; the
// ConnectX-7 firmware derived "Supported Cable Speed 50G_2X" and refused 100G_2X with "Cable speed
// not enabled" (mstlink status opcode 16). That head closed by refusing to say the coding was the
// ONLY blocker. It was not, and the experiment the head called for is what settled it.
//
// THE RE-FLASH LANDED. The operator programmed every leg of both breakouts to the NVIDIA (ETH)
// coding on 2026-09-16 and each leg this repository read afterwards carries byte 192 = 0x40, with
// BOTH SFF-8636 checksums recomputing correctly over the read bytes -- CC_BASE at 191 over 128-190
// and CC_EXT at 223 over 192-222 -- so the programmer updated the checksum its own byte-192 write
// invalidated, and the coding is not merely present but self-consistent. Every ConnectX-7 queried
// afterwards derives "Supported Cable Speed 100G_2X, 50G_1X, 50G_2X, 25G, 10G, 1G" and reports
// status opcode 0, "No issue was observed". The refusal that stood here for eight days is retired
// by execution, which is what product.breakout_leg_programming's read obligation asked for.
//
// AND THE MODE STILL DOES NOT TRAIN, so the coding was necessary and not sufficient. One lane was
// driven through four switch/NIC combinations and the link came up in none of them: switch lane
// forced to 100G-baseCR2 with the NIC left in auto-negotiation (the NIC never retrains -- a forced
// lane offers no AN partner, so it holds the rate it already had); the lane forced with the NIC
// forced to 100G at every width; the lane forced with the NIC forced to exactly 100G_2X, the one
// mode the new coding attests; and that same pair with the lane's FEC moved from fec91 to auto. The
// last three all report mstlink status opcode 2, "Negotiation failure", with the physical state in
// Polling and no speed, width or FEC resolved. The lane was returned to 50G-baseCR2 / fec91 /
// autoneg-off and the link recovered, so the 50G path is undamaged by the attempt.
//
// WHAT THAT LEAVES OPEN IS NAMED, NOT GUESSED. A negotiation failure at 100G_2X on an assembly whose
// coding attests it is consistent with the copper's insertion loss, with the switch serdes' PAM4
// capability on a broken-out lane, and with an FEC the two ends cannot agree on -- and nothing read
// so far discriminates between them. So this block records the failure and does NOT name its cause;
// the operator holds the link-training investigation.
//
// WHAT BYTE 222 DOES AND DOES NOT ESTABLISH. It says 6Ah = 106, which at the specification's
// 250 MBd unit is a declared nominal 26,500 MBd. That is EEPROM METADATA: it is what the module
// declares about itself, and SFF-8636 places physical-layer behaviour outside its own scope, so no
// byte in it qualifies the copper electrically. Two earlier heads of this block got this wrong in
// two different directions -- first resting the conclusion on the byte, then resting it on the
// stability of the running 50G link. extdeps.ethernet.link_mode rules out the second in terms:
// operating in 50GBASE-CR2 does not certify 100GBASE-CR2, the modes differ in modulation, baud and
// insertion-loss budget, and the higher-rate path has never been demonstrated on this assembly.
//
// AND 26.5 GBd IS NOT THE MODE'S RATE. ieee_100gbase_cr2 carries 26.5625 GBd; byte 222 has 250 MBd
// resolution, so 106 is a quantized nominal consistent with the 50G PAM4 family and is not equal to
// the mode's figure. Reading it as an exact match would be a comparison the field cannot support
// without a modeled quantization relation, which does not exist yet.
//
// SO THE HONEST STANDING CLAIM: the coding does not attest the required mode and the NIC refuses it
// today. Recoding is the indicated next step and its outcome is an EXPERIMENT, not a foregone
// result -- write the coding, read it back off the same leg, observe 100G_2X actually enabled, and
// only then is anything established about the copper.

// THE EEPROM SIDE OF THIS ROW IS NOT SPELLED OUT HERE. It was: three fields carried the identifier,
// the compliance byte and the nominal rate as prose strings and a bare count, which is a second
// representation of what product.cable_leg_observation already models over the decoders in
// extdeps.transceiver.sff_8636 -- one fact in two places, and the stringly one cannot be asked a
// question. `0x0B (100GBASE-CR4 or 25GBASE-CR CA-L)` reads as an explanation and is not one: nothing
// could join it to a required link mode, so the conclusion below had to be reached by a human and
// written down beside it. The typed carrier answers the same question by execution.
//
// WHAT STAYS IS WHAT THE EEPROM DOES NOT SAY. The negotiated speed and the NIC's advertised set are
// observations of the LINK, read from the host, not bytes off the module -- a different subject
// with a different instrument, so they keep their own fields.
//
// AND THE RATE ETHTOOL PRINTED IS NOT RECORDED AT ALL, BECAUSE IT IS NOT A RATE. Byte 140 on this
// leg holds FFh, the SFF-8636 escape saying the real signalling rate lives in byte 222 in units of
// 250 MBd. `ethtool -m` printed "BR, nominal: 25500 Mb/s", and 25500 is exactly 255 x 100 -- the
// escape value multiplied out and rendered as though it were a measurement, which
// extdeps.transceiver.sff_8636 names by name as the fabrication this subject exists to catch.
//
// An earlier head of this change kept that number as a field and then RETYPED it to SymbolRate to
// satisfy a unit-modeling review. That made it worse: it moved a sentinel into the very type minted
// to make this conflation unwritable, where SymbolRate's corpus counts are baud (peers carry
// 25781250000). The number carries no information the model does not already hold -- it is byte 140
// being 255, which NominalRateEscaped says exactly and honestly -- so there is nothing to keep.
//
// THAT TRIGGER IS DISCHARGED, and the row below is what discharges it. It named a capability --
// byte 222 modeled in extdeps.transceiver.sff_8636 and carried as an observed field on
// CableLegObservation, so an escaped byte 140 resolves to a rate THIS REPOSITORY read -- and both
// halves now exist: the decoder is sff8636_nominal_rate_from_byte222 and the receipt is the
// extended_rate field. `ethtool -m <dev> raw on` was run against spark-a3ee and spark-ac79 on
// 2026-09-08 and both legs returned byte 222 = 6Ah, so this fleet's escaped rate resolves to
// 26.5 GBd and is no longer a declared gap. A leg whose byte 222 is still unread stays escaped, and
// cable_leg_unread_fields reports it -- the gap moved from this fleet to the general case, which is
// where it belongs.

// WHAT THE LINK REPORTS, which is a different subject from what the EEPROM says. The negotiated
// speed is read from the HOST, per fleet and not per module, so it stays here as linked_speed_gbps.
// The NIC's advertised MODE SET is also a host-read link fact, but it is NOT carried as a field here:
// it wants a typed List<LinkMode> with a cited instrument, and until a consumer needs it that is an
// unread field this module declines to hold (see the deletion note on fabric_leg_cable_observed).
// The per-module EEPROM bytes are receipts and live in fabric_leg_eeprom_observations, one row per
// acquisition -- an earlier head carried a `coding` field here as well, which made the same bytes
// answerable from two places.
type FabricLegCableObserved {
  vendor: NonEmptyStr
  part_number: NonEmptyStr
  linked_speed_gbps: Nat
}

// nic_supported_speeds WAS REMOVED HERE, not re-valued. It was a `String` leaf hiding named parts
// -- a set of link modes this module already imports as extdeps.ethernet.link_mode LinkMode rows
// (ieee_100gbase_cr2, ieee_50gbase_cr2, ...), plus the reading instrument and the observation date.
// Spelling those as "100G_2X, 50G_1X, ..." is the nicknaming DESIGN §3 forbids and the anemic leaf
// §2 forbids, and correcting its stale value only grew what it hid. Nothing read it (only
// linked_speed_gbps is consumed, by fabric_rail_desired and the witness), so it is deleted rather
// than enriched into a List<LinkMode> nothing would read. The NIC-supported-mode observation itself
// -- post-recode 100G_2X, read by mstlink -- lives in the actuation log and lands as a typed set,
// cited to its instrument (§6), when gap G12's event model gives it a consumer.
data fabric_leg_cable_observed: FabricLegCableObserved = FabricLegCableObserved {
  vendor: "FS" as NonEmptyStr,
  part_number: "QDD-400G-4QPC015" as NonEmptyStr,
  linked_speed_gbps: 50,
}

// THE LINK'S RATE AND THE MODE THE NIC WILL ACCEPT ARE NOW DIFFERENT FACTS, because the re-flash
// separated them: the NIC accepts 100G_2X and the link still runs at 50G. The row above carries only
// the rate; the accepted-mode set lands as a typed List<LinkMode> cited to mstlink when gap G12's
// event model gives it a consumer, rather than as the string this row used to carry.
//
// THE SWITCH'S OWN RATE FIELD IS NOT AN ADMISSIBLE READING OF EITHER. With the lane configured for
// 100G-baseCR2, RouterOS `/interface/ethernet/monitor` reported `rate: 100Gbps` and
// `status: link-ok` while the ConnectX-7 at the other end of that same lane was trained at 50G and
// reporting it. The field echoes the lane's CONFIGURATION, so consuming it as a measured rate
// produces exactly the fabricated plausible output DESIGN section 5 forbids -- and it would have
// reported this fabric converged at 100G all evening. The trained rate is read from the host, which
// is why both fields on this row are host-side. The same monitor's `eeprom-checksum: bad` is a
// switch-side artefact of reading a QSFP-DD module on a different offset basis than the host uses:
// the checksums verify over the host's dump.
type ForcedModeTrainingAttempt {
  lane_interface: NonEmptyStr
  switch_speed: NonEmptyStr
  switch_fec: NonEmptyStr
  nic_forced_modes: NonEmptyStr
  trained: Bool
  nic_status_opcode: Nat
  nic_recommendation: NonEmptyStr
}

// ONE ROW PER COMBINATION DRIVEN, so "we tried 100G and it failed" cannot stand in for which pairing
// failed. Each row is a receipt of a live attempt on 2026-09-16 against lane qsfp56-dd-2-1 (the
// spark-3336 leg), chosen so a failure cost one host rather than the group. `trained: false` with
// opcode 2 is the discriminating result; the first row is separate because it did not fail to
// train, it never attempted to -- a NIC in auto-negotiation opposite a forced lane keeps the rate it
// already holds, which is why the switch-side change alone looked like a no-op.
data fabric_forced_100g_attempts: List<ForcedModeTrainingAttempt> = [
  ForcedModeTrainingAttempt {
    lane_interface: "qsfp56-dd-2-1" as NonEmptyStr,
    switch_speed: "100G-baseCR2" as NonEmptyStr,
    switch_fec: "fec91" as NonEmptyStr,
    nic_forced_modes: "none, auto-negotiation left on" as NonEmptyStr,
    trained: false,
    nic_status_opcode: 0,
    nic_recommendation: "No issue was observed (the NIC held 50G_2X and never re-trained)" as NonEmptyStr,
  },
  ForcedModeTrainingAttempt {
    lane_interface: "qsfp56-dd-2-1" as NonEmptyStr,
    switch_speed: "100G-baseCR2" as NonEmptyStr,
    switch_fec: "fec91" as NonEmptyStr,
    nic_forced_modes: "100G_1X, 100G_2X, 100G_4X" as NonEmptyStr,
    trained: false,
    nic_status_opcode: 2,
    nic_recommendation: "Negotiation failure" as NonEmptyStr,
  },
  ForcedModeTrainingAttempt {
    lane_interface: "qsfp56-dd-2-1" as NonEmptyStr,
    switch_speed: "100G-baseCR2" as NonEmptyStr,
    switch_fec: "fec91" as NonEmptyStr,
    nic_forced_modes: "100G_2X" as NonEmptyStr,
    trained: false,
    nic_status_opcode: 2,
    nic_recommendation: "Negotiation failure" as NonEmptyStr,
  },
  ForcedModeTrainingAttempt {
    lane_interface: "qsfp56-dd-2-1" as NonEmptyStr,
    switch_speed: "100G-baseCR2" as NonEmptyStr,
    switch_fec: "auto" as NonEmptyStr,
    nic_forced_modes: "100G_2X" as NonEmptyStr,
    trained: false,
    nic_status_opcode: 2,
    nic_recommendation: "Negotiation failure" as NonEmptyStr,
  },
]

fn fabric_forced_100g_ever_trained() -> Bool {
  any(fabric_forced_100g_attempts, a => a.trained)
}

type FabricLaneObserved {
  cage: Nat
  lane: Nat
  host: HostIdentity
  spark_hostname: NonEmptyStr
  leg_netdev: NonEmptyStr
  leg_netdev_twin: NonEmptyStr
  leg_rdma_device: NonEmptyStr
}

// THE NETDEV NAMES THE LEG APPEARS ON, DECLARED ONCE. Every row below carried the same two
// spellings as literals -- eight copies of `enp1s0f1np1` and eight of `enP2p1s0f1np1` -- which is one
// concept authored sixteen times (DESIGN §2). The names are identical across the fleet because they
// are derived from the NIC's PCI position and function, which is the same on every Spark, so a
// per-row literal was never carrying per-row information.
//
// IT IS ALSO WHAT A PRIVILEGE GRANT NEEDS TO NAME. gunbc.spark.managed_access_bootstrap authorizes
// an EEPROM read on ONE device rather than on every interface the host has, and a Cmnd_Spec that
// spelled the device itself would be a seventeenth copy -- one that sudo would silently fail to
// match if the fleet's naming ever moved. The grant folds this row instead.
//
// THE TWIN IS A SEPARATE ROW AND NOT A DERIVATION. Both second-function netdevs come up from the one
// leg with distinct MACs; their names differ by PCI domain prefix rather than by any rule this
// repository could apply, so deriving one from the other would be inventing a naming law upstream
// does not publish.
data spark_fabric_leg_netdev: NonEmptyStr = "enp1s0f1np1" as NonEmptyStr
data spark_fabric_leg_netdev_twin: NonEmptyStr = "enP2p1s0f1np1" as NonEmptyStr

data fabric_lane_observations: List<FabricLaneObserved> = [
  FabricLaneObserved { cage: 1, lane: 1, host: operator_host_srv5, spark_hostname: "spark-a3ee" as NonEmptyStr, leg_netdev: spark_fabric_leg_netdev, leg_netdev_twin: spark_fabric_leg_netdev_twin, leg_rdma_device: "rocep1s0f1" as NonEmptyStr },
  FabricLaneObserved { cage: 1, lane: 3, host: operator_host_srv8, spark_hostname: "spark-ac79" as NonEmptyStr, leg_netdev: spark_fabric_leg_netdev, leg_netdev_twin: spark_fabric_leg_netdev_twin, leg_rdma_device: "rocep1s0f1" as NonEmptyStr },
  FabricLaneObserved { cage: 1, lane: 5, host: operator_host_srv7, spark_hostname: "spark-c2b1" as NonEmptyStr, leg_netdev: spark_fabric_leg_netdev, leg_netdev_twin: spark_fabric_leg_netdev_twin, leg_rdma_device: "rocep1s0f1" as NonEmptyStr },
  FabricLaneObserved { cage: 1, lane: 7, host: operator_host_srv6, spark_hostname: "spark-3bd5" as NonEmptyStr, leg_netdev: spark_fabric_leg_netdev, leg_netdev_twin: spark_fabric_leg_netdev_twin, leg_rdma_device: "rocep1s0f1" as NonEmptyStr },
  FabricLaneObserved { cage: 2, lane: 1, host: operator_host_srv10, spark_hostname: "spark-3336" as NonEmptyStr, leg_netdev: spark_fabric_leg_netdev, leg_netdev_twin: spark_fabric_leg_netdev_twin, leg_rdma_device: "rocep1s0f1" as NonEmptyStr },
  FabricLaneObserved { cage: 2, lane: 3, host: operator_host_srv12, spark_hostname: "spark-2196" as NonEmptyStr, leg_netdev: spark_fabric_leg_netdev, leg_netdev_twin: spark_fabric_leg_netdev_twin, leg_rdma_device: "rocep1s0f1" as NonEmptyStr },
  FabricLaneObserved { cage: 2, lane: 5, host: operator_host_srv9, spark_hostname: "spark-0c75" as NonEmptyStr, leg_netdev: spark_fabric_leg_netdev, leg_netdev_twin: spark_fabric_leg_netdev_twin, leg_rdma_device: "rocep1s0f1" as NonEmptyStr },
  FabricLaneObserved { cage: 2, lane: 7, host: operator_host_srv11, spark_hostname: "spark-b66c" as NonEmptyStr, leg_netdev: spark_fabric_leg_netdev, leg_netdev_twin: spark_fabric_leg_netdev_twin, leg_rdma_device: "rocep1s0f1" as NonEmptyStr },
]

fn fabric_lane_interface(o: FabricLaneObserved) -> NonEmptyStr {
  crs812_lane_interface(port: crs812_qsfp56_dd_ports, cage: o.cage, lane: o.lane)
}

fn fabric_lane_for_host(host: HostIdentity) -> FabricLaneObserved? {
  first(filter(fabric_lane_observations, o => host_identity_eq(a: o.host, b: host)))
}

// A GROUP IS THE SET OF HOSTS ON ONE 400G CAGE: four legs of one breakout share the cage, so the
// four hosts are one fabric-natural tensor-parallel group. Group A is cage 1, group B is cage 2.
type FabricGroup = FabricGroupA | FabricGroupB

fn fabric_group_cage(g: FabricGroup) -> Nat {
  match g {
    FabricGroupA => 1
    FabricGroupB => 2
  }
}

fn fabric_group_wire(g: FabricGroup) -> NonEmptyStr {
  match g {
    FabricGroupA => "group-a" as NonEmptyStr
    FabricGroupB => "group-b" as NonEmptyStr
  }
}

// The exact inverse of fabric_group_wire; a word naming no group is no group.
fn parse_fabric_group(wire: String) -> FabricGroup? {
  if wire == "group-a" { Present { value: FabricGroupA } }
  else if wire == "group-b" { Present { value: FabricGroupB } }
  else { none }
}

fn fabric_group_hosts(g: FabricGroup) -> List<HostIdentity> {
  map(filter(fabric_lane_observations, o => o.cage == fabric_group_cage(g: g)), o => o.host)
}

fn fabric_group_of_host(host: HostIdentity) -> FabricGroup? {
  match fabric_lane_for_host(host: host) {
    Absent => none
    Present { value: o } => if o.cage == 1 { Present { value: FabricGroupA } } else { Present { value: FabricGroupB } }
  }
}

// srv10 links and answers LLDP on this fabric; the earlier "no Mellanox devices" reading that made
// it the RMA candidate was wrong about the NIC. Whatever failed in its setup, it is not the fabric.
data srv10_fabric_link_observed: Bool = true

// ================= THE PLANT AS AN INSPECTION SUBJECT =================
//
// Every lane above carries one leg of the same breakout, and the plant is the lane roster joined to
// what was READ of each -- which is not the same for every lane, and the next block is why. It is
// DERIVED from the lane list rather than re-listed: a lane added above enters the plant with no
// second edit, which is the property a hand-copied roster loses on its first divergence, and a lane
// enters as unread until someone dumps it.
//
// The required mode is the rail's, not the cable's: 100GBASE-CR2 is what a two-lane leg must attest
// for this fabric to run at the speed it was bought for.
// TWO LEGS WERE READ, NOT EIGHT, AND EACH READ IS ITS OWN RECEIPT. The raw dump on 2026-09-08
// covered spark-a3ee and spark-ac79 -- two of eight endpoints, both in cage 1, at lanes 1 and 3.
//
// An earlier head mapped ALL EIGHT lanes to one measured coding, which is the absorbing fallback
// DESIGN section 5 forbids wearing the costume of a receipt: six unknown legs became LegReadingTaken
// and bypassed the refusal the plant exists to produce. The first repair fixed the count but kept
// ONE shared observation for BOTH measured legs, which is the same defect one order smaller. These
// are FIELD PROGRAMMABLE parts -- the entire reason this model exists -- so the representation must
// be able to say that spark-a3ee carries new coding while spark-ac79 still carries old. A shared row
// cannot say it: editing it moves both legs at once.
//
// So one row per acquisition, carrying the identity that makes it a receipt rather than a value: the
// host it was taken from, the module's own vendor serial, and the date code. Whether the two legs
// agree is DERIVED by comparing rows, never assumed by storing one -- and they now DISAGREE
// (spark-a3ee re-read post-recode to 0x40, spark-ac79 still at its last pre-recode 0x0B), which is
// exactly the divergence this per-row shape exists to keep representable.
//
// AND A READING'S CURRENT STANDING IS TYPED, NOT ASSUMED FROM THE FACT THAT A ROW EXISTS. A leg that
// was re-flashed after its last read has a KNOWN-INVALIDATED reading -- the mutation happened, so the
// stored coding is no longer the leg's current coding, and answering it as a live reading is silent
// wrongness on the plant path (§5). That is a different state from "never read", and it must not
// collapse into either "current" or "never looked". So each acquisition carries an
// EepromAcquisitionStanding: AcquisitionCurrent for a reading taken (or re-taken) after the last
// mutation, AcquisitionInvalidatedByReflash for a reading a later re-flash invalidated and which was
// not re-taken. The full append-only acquisition history is still G12; this is the minimum standing
// the LIVE plant needs so it never promotes an invalidated reading to a current one.
type EepromAcquisitionStanding
  = AcquisitionCurrent
  | AcquisitionInvalidatedByReflash { invalidating_event: NonEmptyStr }

// THE ACQUISITION DATE IS A FIELD BECAUSE A SUPERSEDED READING STAYS. `date_code` is the cable's
// manufacture date printed in its EEPROM; `observed_on` is when this repository read those bytes, and
// the two were conflated as long as a host had only one row. A leg reprogrammed between two reads has
// TWO true readings, and the only thing that orders them is when each was taken.
type FabricLegEepromObservation {
  host: NonEmptyStr
  vendor_serial: NonEmptyStr
  date_code: NonEmptyStr
  observed_on: NonEmptyStr
  coding: CableLegObservation
  acquisition: EepromAcquisitionStanding
}

// Each row states what ITS dump returned, written out rather than pointing at a shared value. All
// eight agree byte for byte today; that agreement is a DERIVABLE fact about eight receipts, and
// storing it as one row would make the agreement unfalsifiable and the divergence unrepresentable.
//
// EVERY LEG HAS A CURRENT ACQUISITION, AND ONE LEG ALSO HAS ITS SUPERSEDED ONE. spark-ac79 was read
// at 0x0B on 2026-09-10, reprogrammed, and re-read at 0x40 on 2026-09-16; both readings are rows, the
// earlier one typed AcquisitionInvalidatedByReflash and never promoted to the plant. That is the
// shape a re-flash has, and it is why the standing is a type rather than a deletion.
//
// ALL EIGHT LEGS ARE NOW READ, WHERE TWO WERE BEFORE, and the roster went from a partial plant that
// refused to a complete one. The rows are the post-re-flash acquisition of 2026-09-16: every leg
// returns byte 192 = 0x40 and both SFF-8636 checksums recompute over the read bytes, so the
// programmer's write is self-consistent on every leg and not merely on the ones that were spot
// checked. A second row for one host is NOT a second answer to what that leg codes today, because
// fabric_leg_reading selects the leg's AcquisitionCurrent row rather than its first: the 0x0B state
// exists on no leg in the plant AND remains readable as the observation the re-flash superseded.
//
// THE SERIALS WERE NOT UNIQUE ON THE FIRST READ, AND THAT IS WHY UNIQUENESS IS CHECKED RATHER THAN
// ASSUMED. The first post-re-flash pass read the cage-2 legs as S2630771509-3 and -4 -- serials the
// cage-1 legs also carried -- which cannot both be true of one leg. The programmer had written two
// legs with another assembly's serial; the operator re-flashed exactly those two and they now read
// S2630771508-3 and -4. So the plant resolves into one assembly per cage, legs 1 through 4, which is
// what a QSFP-DD breakout physically is. The receipt identity survived that defect precisely because
// it is per-acquisition: a shared row could not have represented two legs claiming one serial, and
// the witness that compares serials across rows is what makes the recurrence visible.
// ── THE REPROGRAMMING DATE IS DISPUTED IN THIS CORPUS, AND IT IS NOT SETTLED HERE ─────────────
//
// TWO SPELLINGS ARE CARRIED TODAY AND THEY ARE ONE DAY APART. gunbc.product.breakout_leg_programming
// -- the authority that OWNS the programming event -- and the rows below say the operator reprogrammed
// every leg on 2026-09-16; gunbc.spark.managed_access_bootstrap's annotation about the grants says
// 2026-09-17. One event cannot have two dates, so at least one of them is wrong, and this file is
// about to become the historical authority for the switch investigation -- which is exactly when
// silently picking the majority spelling would be the worst available move.
//
// THE LIKELIEST RECONCILIATION IS A TIME ZONE AND IT IS NOT ASSERTED AS THE ANSWER. These hosts report
// local time at UTC-4 -- the derived image's own Created reads 2026-09-17T14:55:06-04:00 -- so an
// evening event on the 16th local is the 17th in UTC, and two readers recording "the day it happened"
// off different clocks would produce exactly this pair. That is a HYPOTHESIS with a named
// discriminator, not a finding: what settles it is the programmer's own receipt with its offset, and
// nobody has read one into this corpus.
//
// SO THE DATE BELOW IS THE ACQUISITION'S, WHICH IS A DIFFERENT FACT. `observed_on` says when this
// repository read the bytes; the invalidating event names the reprogramming without re-spelling a
// date this file cannot ground. A row that carried both would be asserting the disputed one.

// ── THE PRE-REFLASH READING, RESTORED ────────────────────────────────────────────────────────
//
// THIS ROW WAS DELETED IN A MERGE AND THAT DELETION REWROTE HISTORY. main carried spark-ac79's last
// actual dump -- byte 192 = 0x0B, read 2026-09-10 -- typed AcquisitionInvalidatedByReflash because
// the leg had been reprogrammed since. The post-reflash acquisition below re-read that leg to 0x40,
// and the merge took the new rows OVER the old one instead of BESIDE it, so the plant's record went
// from "this leg coded 0x0B, then was reprogrammed, and now codes 0x40" to "this leg codes 0x40",
// with the eight days of refusal the 0x0B coding caused unattributable to anything in the corpus.
//
// A SUPERSEDING OBSERVATION DOES NOT MAKE ITS PREDECESSOR FALSE. Both readings are true of their own
// date, and the chain they form -- original coding observed (this row) -> host ends reprogrammed
// (the invalidating event named on it) -> post-recode coding observed (the eight rows below) ->
// forced 100G_2X attempts all fail to train (fabric_forced_100g_attempts) -> the lane restored to
// 50G (fabric_leg_cable_observed linked_speed_gbps) -- is the switch investigation's actual shape.
// Keeping only the latest row leaves a reader unable to say what changed or when.
//
// ITS SERIAL IS KEPT AS READ, INCLUDING THE DEFECT. This row says S2630771509-3, which the
// post-reflash pass established was another assembly's serial written by the programmer; the
// corrected leg reads S2630771508-3 below. Rewriting it here to the corrected value would erase the
// evidence that the programmer mis-wrote it, which is the same deletion at one field's grain.
//
// AND IT IS NOT PROMOTED TO THE PLANT. fabric_leg_reading selects the leg's current acquisition, so
// this row is history a reader can consult and never an answer about what the plant codes today.
data fabric_leg_eeprom_observations: List<FabricLegEepromObservation> = [
  FabricLegEepromObservation {
    host: "spark-ac79" as NonEmptyStr,
    vendor_serial: "S2630771509-3" as NonEmptyStr,
    date_code: "260728" as NonEmptyStr,
    observed_on: "2026-09-10" as NonEmptyStr,
    coding: cable_leg_observation(
      identifier: transceiver_identifier_from_byte(code: 17),
      primary_compliance_code: 11,
      secondary_compliance: SecondaryObserved { code: 0 },
      encoding: sff8636_encoding_from_byte(code: 8),
      nominal_rate: sff8636_nominal_rate_from_byte140(code: 255),
      extended_rate: ExtendedRateObserved { code: 106 }),
    acquisition: AcquisitionInvalidatedByReflash { invalidating_event: "the operator reprogrammed every leg of both breakouts to the NVIDIA (ETH) coding with an FS BOX V4, and this leg was re-read afterwards -- its current reading is the spark-ac79 row below. THE EVENT'S DATE IS DISPUTED IN THIS CORPUS: gunbc.product.breakout_leg_programming and the post-reflash rows here say 2026-09-16, gunbc.spark.managed_access_bootstrap says 2026-09-17, and these hosts run at UTC-4 so an evening event is one day later in UTC. It is deliberately not re-spelled on this row: the ordering this row depends on -- read, then reprogram, then re-read -- holds under either date, and the programmer's own receipt with its offset is what would settle which" as NonEmptyStr },
