fn fabric_leg_observation_for(o: FabricLaneObserved) -> List<FabricLegEepromObservation> {
  filter(fabric_leg_eeprom_observations, r => r.host == o.spark_hostname)
}

// MEMBERSHIP IS DERIVED FROM THE RECEIPTS, never from a parallel roster of which hosts were dumped.
// A second list would be a second answer to "was this leg read", and the two would disagree the
// first time a receipt was added without updating it.
// A LEG'S PLANT READING IS ITS CURRENT CODING OR NOTHING. An AcquisitionCurrent row is a live
// reading; an AcquisitionInvalidatedByReflash row is projected to LegNeverRead, because the leg's
// current coding is unknown after the re-flash and presenting the invalidated value as a live reading
// is the silent wrongness §5 forbids. The invalidated last-observation is not lost -- it stays on the
// eeprom row -- it is simply not promoted to the plant.
fn fabric_leg_reading_of_row(endpoint: NonEmptyStr, r: FabricLegEepromObservation) -> CableLegReading {
  match r.acquisition {
    AcquisitionCurrent => LegReadingTaken { endpoint: endpoint, observation: r.coding }
    AcquisitionInvalidatedByReflash { invalidating_event: _ } => LegNeverRead { endpoint: endpoint }
  }
}

// THE LEG'S CURRENT ACQUISITION, SELECTED BY STANDING RATHER THAN BY POSITION. A host now carries one
// row per acquisition, so `.first()` would have answered whichever reading happened to be written
// first -- a positional rule standing where a stated one was available, and one that would have
// promoted the superseded 0x0B reading the moment somebody sorted the list. The rule is the one the
// per-row projection already states: an invalidated acquisition is never promoted to the plant, so the
// plant reads the leg's AcquisitionCurrent row, and a leg with none reads as never read.
fn fabric_leg_current_acquisition(o: FabricLaneObserved) -> FabricLegEepromObservation? {
  filter(fabric_leg_observation_for(o: o), r => match r.acquisition {
    AcquisitionCurrent => true
    AcquisitionInvalidatedByReflash { invalidating_event: _ } => false
  }).first()
}

fn fabric_leg_reading(o: FabricLaneObserved) -> CableLegReading {
  match fabric_leg_current_acquisition(o: o) {
    Present { value: r } => fabric_leg_reading_of_row(endpoint: fabric_lane_interface(o: o), r: r)
    Absent => LegNeverRead { endpoint: fabric_lane_interface(o: o) }
  }
}

data fabric_cable_plant: CablePlant = cable_plant(
  plant: "spark fabric, CRS812 QSFP-DD breakout legs" as NonEmptyStr,
  required_mode: ieee_100gbase_cr2,
  readings: map(fabric_lane_observations, o => fabric_leg_reading(o: o)))

fn fabric_cable_plant_inspection() -> CablePlantInspection {
  inspect_cable_plant(subject: fabric_cable_plant)
}
