+# File-backed Engram storage for vLLM d2d649e674c75425d2d6975c87eb89fd4d55fff8.
+#
+# THIS IS A BACKING SWAP, NOT NEW PREFETCH MACHINERY. Upstream
+# vllm/models/deepseek_v4_1/nvidia/engram.py already has Engram._init_staging,
+# prepare_embeddings, _start_prefetch / _finish_prefetch / _ready_rows on a
+# dedicated cuda Stream, and ParallelEngramEmbedding._allocate_weights.
+# DPSharedEngramStorage mmaps /dev/shm and cudaHostRegister()s the entire
+# weight+scale allocation, then asserts tensor.is_pinned(). /dev/shm is tmpfs
+# and on a unified-memory host that is the same pool as the accelerator.
+#
+# This module keeps the staging buffer, the stream, and the prefetch protocol.
+# It changes where the rows come from: a rank-local file whose identity is
+# verified at open, mmap'd read-only without registering the whole table
+# with CUDA. Token-time gathers copy requested rows into the existing bounded
+# pinned staging buffer. A missing local path refuses; there is no NFS arm.
+#
+# Prefix and offsets are gunbc.spark.v41_engram_row_store: v41_store_bytes emits
+# v41_row_store_magic then weight||scale records; v41_row_address offsets follow;
+# the store's SHA-256 is over those prefixed bytes. Open checks expected.magic
+# (supplied from that symbol, not minted here) and whole-file digest against
+# rank_digest_hex. expected.record_bytes is v41_row_bytes of the admitted spec,
+# supplied likewise. encoding_digest / rank / format_revision are not on this
+# type until a modeled header carries them.
+#
+# The open and gather contracts are gunbc.spark.v41_engram_file_backed:
+# v41_open_residency_verdict (verification's page-cache residue is released and
+# read back as zero over the whole file, else open refuses; its two refusal
+# branches are the two raises in _verify_and_release, and the receipt's fields
+# are V41StoreOpenReceipt's) and v41_gather_rows (one batched gather
+# at record-aligned offsets, in request order; a misaligned offset refuses).
+#
+# The touch counter is gunbc.spark.v41_engram_file_backed v41_touched_pages /
+# V41FetchTouchReceipt: every successful fetch_rows marks the (file, page)
+# pages its rows' bytes [off, off + record) cover in a bit-packed bitmap over
+# this file's page count (one bit per page, ~1.5 MiB for a 47 GiB file at
+# 4 KiB), so a repeated offset counts once and a row straddling a page
+# boundary counts both pages. Only page indices are recorded, never row
+# contents. snapshot_touches(reset=...) is the observation; write_touch_receipt
+# is the per-rank file receipt a staircase step reads and resets.
+
+from __future__ import annotations
+
+import ctypes
+import ctypes.util
+import hashlib
+import mmap
+import json
+import os
+import signal
+import threading
+import time
+import warnings
+from dataclasses import dataclass
+from typing import Sequence, Tuple
+
+import numpy as np
+import torch
+
+
+class EngramRowStoreIdentityMismatch(RuntimeError):
+    pass
+
+
+class EngramLocalStoreMissing(RuntimeError):
+    pass
+
+
+class EngramFullTablePinned(RuntimeError):
+    pass
+
+
+class EngramPageCacheResident(RuntimeError):
+    pass
+
+
+class EngramRowOffsetMisaligned(RuntimeError):
+    pass
+
+
+class EngramRowStoreManifestInvalid(RuntimeError):
+    pass
+
+
+class EngramFileBackedRequiresOffload(RuntimeError):
+    pass
+
+
+class EngramCheckpointGeometryMismatch(RuntimeError):
+    pass
+
+
+@dataclass(frozen=True)
+class ExpectedRowStoreIdentity:
+    rank_digest_hex: str
+    magic: bytes
+    record_bytes: int
+
+
+@dataclass(frozen=True)
+class EngramStoreOpenReceipt:
+    """What open() observed: the verified range and its page-cache residency
+    before and after the release (gunbc.spark.v41_engram_file_backed
+    V41StoreOpenReceipt)."""
+
+    store_bytes: int
+    verified_bytes: int
+    resident_bytes_after_verify: int
+    resident_bytes_after_release: int
+
+
+@dataclass(frozen=True)
+class EngramFetchTouchObservation:
+    """fetch_rows' cumulative touches of this file since open or the last
+    reset (gunbc.spark.v41_engram_file_backed V41FetchTouchReceipt). Page
+    indices are file-relative: page = byte offset // page_bytes."""
+
+    path: str
+    page_bytes: int
+    page_count: int
+    distinct_pages_touched: int
+    fetch_rows_calls: int
+    rows_fetched: int
+    fetch_rows_us: int
+
+
+_libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
+_libc.mmap.restype = ctypes.c_void_p
+_libc.mmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_long]
+_libc.munmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
+_libc.mincore.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p]
+_MAP_FAILED = ctypes.c_void_p(-1).value
+_RESIDENCY_WINDOW = 1 << 30
+
+
+def resident_bytes(fd: int, size: int) -> int:
+    """Page-cache resident bytes of [0, size) of fd, by mincore over a
+    transient mapping that is never touched (so reading does not fault)."""
+    page = os.sysconf("SC_PAGE_SIZE")
+    resident_pages = 0
+    off = 0
+    while off < size:
+        length = min(_RESIDENCY_WINDOW, size - off)
+        addr = _libc.mmap(None, length, mmap.PROT_READ, mmap.MAP_SHARED, fd, off)
+        if addr in (None, _MAP_FAILED):
+            raise OSError(ctypes.get_errno(), "mmap for residency readback failed")
+        try:
+            pages = (length + page - 1) // page
+            vec = (ctypes.c_ubyte * pages)()
+            if _libc.mincore(addr, length, vec) != 0:
+                raise OSError(ctypes.get_errno(), "mincore failed")
+            resident_pages += sum(b & 1 for b in bytes(vec))
+        finally:
+            _libc.munmap(addr, length)
+        off += length
+    return min(resident_pages * page, size)
+
+
+def _sha256_fd(fd: int, magic_len: int) -> Tuple[str, bytes, int]:
+    h = hashlib.sha256()
+    head = b""
+    total = 0
+    with os.fdopen(os.dup(fd), "rb", closefd=True) as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b""):
+            if len(head) < magic_len:
+                head += chunk[: magic_len - len(head)]
+            h.update(chunk)
+            total += len(chunk)
+    return h.hexdigest(), head, total
+
+
+class FileBackedEngramStorage:
+    """Rank-local row store. The file is identity, not a path alias."""
+
+    def __init__(self, path: str, expected: ExpectedRowStoreIdentity):
+        if not os.path.isfile(path):
+            raise EngramLocalStoreMissing(
+                f"rank-local Engram row store missing at {path}; "
+                "token-time NFS fallback is refused"
+            )
+        self.path = os.path.abspath(path)
+        self.expected = expected
+        self._fd = os.open(self.path, os.O_RDONLY)
+        try:
+            self.receipt = self._verify_and_release()
+            self._mmap = mmap.mmap(self._fd, 0, access=mmap.ACCESS_READ)
+        except BaseException:
+            os.close(self._fd)
+            raise
+        with warnings.catch_warnings():
+            # The mmap is read-only; the table is only ever read through index.
+            warnings.simplefilter("ignore", UserWarning)
+            self._table = torch.frombuffer(self._mmap, dtype=torch.uint8)
+        self._span = torch.arange(expected.record_bytes, dtype=torch.int64)
+        self._header_ok = True
+        self._page_bytes = os.sysconf("SC_PAGE_SIZE")
+        self._page_count = (self._mmap.size() + self._page_bytes - 1) // self._page_bytes
+        # A record of R bytes covers at most ceil((R - 1) / P) + 1 pages.
+        self._page_span = np.arange(
+            (expected.record_bytes + self._page_bytes - 2) // self._page_bytes + 1, dtype=np.int64
+        )
+        self._touch_lock = threading.Lock()
+        self._touched = np.zeros((self._page_count + 7) // 8, dtype=np.uint8)
+        self._calls = 0
+        self._rows = 0
+        self._ns = 0
+
+    def _verify_and_release(self) -> EngramStoreOpenReceipt:
+        # Verification stays fail-closed and whole-file; only its cache residue goes.
+        store = os.fstat(self._fd).st_size
+        opened, head, verified = _sha256_fd(self._fd, len(self.expected.magic))
+        if verified != store:
+            raise EngramRowStoreIdentityMismatch(
+                f"verified {verified} of {store} store bytes; verification is over the whole file"
+            )
+        if opened != self.expected.rank_digest_hex:
+            raise EngramRowStoreIdentityMismatch(
+                f"opened {self.path} digest {opened}, expected rank digest "
+                f"{self.expected.rank_digest_hex}"
+            )
+        if head != self.expected.magic:
+            raise EngramRowStoreIdentityMismatch("row-store MAGIC mismatch")
+        after_verify = resident_bytes(self._fd, verified)
+        os.posix_fadvise(self._fd, 0, verified, os.POSIX_FADV_DONTNEED)
+        after_release = resident_bytes(self._fd, verified)
+        receipt = EngramStoreOpenReceipt(
+            store_bytes=store,
+            verified_bytes=verified,
+            resident_bytes_after_verify=after_verify,
+            resident_bytes_after_release=after_release,
+        )
+        if after_release != 0:
+            raise EngramPageCacheResident(
+                f"{self.path}: {after_release} of {verified} verified bytes remain "
+                f"page-cache resident after POSIX_FADV_DONTNEED; receipt {receipt}"
+            )
+        return receipt
+
+    def close(self) -> None:
+        del self._table
+        self._mmap.close()
+        os.close(self._fd)
+
+    def _check_dest(self, dest: torch.Tensor) -> None:
+        if dest.is_pinned() and dest.numel() * dest.element_size() >= self._mmap.size():
+            raise EngramFullTablePinned(
+                "staging destination covers the whole table; this runtime refuses "
+                "full-Engram pinned allocation"
+            )
+
+    def _record_index(self, offsets: list[int], nbytes: int) -> torch.Tensor:
+        record = self.expected.record_bytes
+        if nbytes != record:
+            raise EngramRowOffsetMisaligned(
+                f"fetch of {nbytes} bytes per row; the store's record is {record} bytes"
+            )
+        magic = len(self.expected.magic)
+        size = self._mmap.size()
+        for off in offsets:
+            if off < magic or (off - magic) % record != 0 or off + record > size:
+                raise EngramRowOffsetMisaligned(
+                    f"offset {off} is not magic + k * {record} inside a {size}-byte store"
+                )
+        return (torch.as_tensor(offsets, dtype=torch.int64).unsqueeze(1) + self._span).view(-1)
+
+    def fetch_rows(self, offsets: list[int], nbytes: int, dest: torch.Tensor) -> None:
+        """Copy selected rows, in request order, into an already-allocated
+        bounded staging tensor with one batched gather."""
+        start = time.perf_counter_ns()
+        self._check_dest(dest)
+        index = self._record_index(offsets, nbytes)
+        rows = dest.view(torch.uint8).view(dest.shape[0], -1)[: len(offsets), :nbytes]
+        if rows.is_contiguous():
+            torch.index_select(self._table, 0, index, out=rows.view(-1))
+        else:
+            rows.copy_(torch.index_select(self._table, 0, index).view(len(offsets), nbytes))
+        # Timed: validation and gather. Not timed: the counter's own bookkeeping.
+        elapsed = time.perf_counter_ns() - start
+        self._note_touches(offsets, nbytes, elapsed)
+
+    def _note_touches(self, offsets: Sequence[int], nbytes: int, elapsed_ns: int) -> None:
+        # O(rows * pages-per-record), vectorized; reads offsets only, never row bytes.
+        offs = np.asarray(offsets, dtype=np.int64)
+        first = offs // self._page_bytes
+        last = (offs + nbytes - 1) // self._page_bytes
+        pages = first[:, None] + self._page_span
+        pages = pages[pages <= last[:, None]]
+        bits = np.left_shift(1, pages & 7).astype(np.uint8)
+        with self._touch_lock:
+            # ufunc.at is unbuffered, so repeated pages OR into one bit.
+            np.bitwise_or.at(self._touched, pages >> 3, bits)
+            self._calls += 1
+            self._rows += len(offs)
+            self._ns += elapsed_ns
+
+    def snapshot_touches(self, reset: bool) -> EngramFetchTouchObservation:
+        """The cumulative observation; with reset, the next one starts empty,
+        atomically with respect to concurrent fetch_rows."""
+        with self._touch_lock:
+            obs = EngramFetchTouchObservation(
+                path=self.path,
+                page_bytes=self._page_bytes,
+                page_count=self._page_count,
+                distinct_pages_touched=int(np.unpackbits(self._touched).sum(dtype=np.int64)),
+                fetch_rows_calls=self._calls,
+                rows_fetched=self._rows,
+                fetch_rows_us=self._ns // 1000,
+            )
+            if reset:
+                self._touched.fill(0)
+                self._calls = 0
+                self._rows = 0
+                self._ns = 0
+        return obs
+
+    def _fetch_rows_per_row(self, offsets: list[int], nbytes: int, dest: torch.Tensor) -> None:
+        # The replaced per-row copy, kept ONLY as the differential oracle for
+        # measure_fetch_rows. It is never a fallback for fetch_rows.
+        self._check_dest(dest)
+        self._record_index(offsets, nbytes)
+        view = memoryview(self._mmap)
+        for i, off in enumerate(offsets):
+            dest[i].view(torch.uint8).view(-1)[:nbytes].copy_(
+                torch.frombuffer(view[off : off + nbytes], dtype=torch.uint8)
+            )
+
+
+def measure_fetch_rows(storage: FileBackedEngramStorage, rows: int, repeats: int, seed: int = 0) -> dict:
+    """THE INSTRUMENT: seconds per fetch_rows call of `rows` random records,
+    batched gather versus the per-row oracle, and whether their bytes agree."""
+    record = storage.expected.record_bytes
+    count = (storage._mmap.size() - len(storage.expected.magic)) // record
+    g = torch.Generator().manual_seed(seed)
+    local = torch.randint(0, count, (rows,), generator=g)
+    offsets = (len(storage.expected.magic) + local * record).tolist()
+    a = torch.zeros((rows, record), dtype=torch.uint8)
+    b = torch.zeros((rows, record), dtype=torch.uint8)
+    timings = {}
+    for name, fn, dest in (("batched", storage.fetch_rows, a), ("per_row", storage._fetch_rows_per_row, b)):
+        fn(offsets, record, dest)
+        start = time.perf_counter()
+        for _ in range(repeats):
+            fn(offsets, record, dest)
+        timings[name] = (time.perf_counter() - start) / repeats
+    return {"rows": rows, "repeats": repeats, "seconds_per_call": timings, "bytes_agree": bool(torch.equal(a, b))}
+
+
+def write_touch_receipt(
+    rank: int, storages: Sequence[FileBackedEngramStorage], path: str, reset: bool
+) -> dict:
+    """THE RANK'S TOUCH RECEIPT: one observation per rank-local file, written
+    atomically (temp + rename) so a reader never sees a partial step. Distinct
+    (file, page) pairs across files are the sum of the per-file counts."""
+    receipt = {
+        "rank": rank,
+        "files": [s.snapshot_touches(reset).__dict__ for s in storages],
+    }
+    tmp = f"{path}.tmp.{os.getpid()}"
+    with open(tmp, "w") as f:
+        json.dump(receipt, f)
+    os.replace(tmp, path)
+    return receipt
+
+
+def allocate_file_backed(
+    path: str,
+    expected: ExpectedRowStoreIdentity,
+    staging_rows: int,
+    row_bytes: int,
+    device: torch.device,
+) -> Tuple[FileBackedEngramStorage, torch.Tensor]:
+    storage = FileBackedEngramStorage(path, expected)
+    staging = torch.empty((staging_rows, row_bytes), dtype=torch.uint8, pin_memory=True)
+    if staging.numel() >= os.path.getsize(path):
+        raise EngramFullTablePinned(
+            "pinned staging is not smaller than the row store; refusing full-table pin"
+        )
+    return storage, staging
+
+
+# ── THE LAUNCH'S ROW-STORE MANIFEST ─────────────────────────────────────────────────────────────
+#
+# gunbc.spark.v41_engram_store_manifest derives this document from the row-store model: the magic and
+# record size of the encoding, and one entry per (layer, rank) naming the store's path and its
+# SHA-256. When the environment names a manifest, every Engram layer is file-backed and no upstream
+# DPShared/pinned table is constructed; a manifest that does not parse, repeats a (layer, rank), or
+# lacks the entry a rank needs refuses at model init.
+MANIFEST_ENV = "GUNBC_ENGRAM_ROW_STORE_MANIFEST"
+TOUCH_RECEIPT_DIR_ENV = "GUNBC_ENGRAM_TOUCH_RECEIPT_DIR"
+
+
+@dataclass(frozen=True)
+class RowStoreManifestEntry:
+    layer: int
+    rank: int
+    path: str
+    sha256: str
+
+
+@dataclass(frozen=True)
+class RowStoreManifest:
+    magic: bytes
+    record_bytes: int
+    weight_bytes: int
+    entries: Tuple[RowStoreManifestEntry, ...]
+
+
+def load_manifest(path: str) -> RowStoreManifest:
+    try:
+        with open(path) as f:
+            doc = json.load(f)
+        magic = bytes.fromhex(doc["magic_hex"])
+        record = int(doc["record_bytes"])
+        weight = int(doc["weight_bytes"])
+        entries = tuple(
+            RowStoreManifestEntry(int(e["layer"]), int(e["rank"]), str(e["path"]), str(e["sha256"]))
+            for e in doc["stores"]
+        )
+    except (OSError, ValueError, KeyError, TypeError) as exc:
+        raise EngramRowStoreManifestInvalid(f"{path}: {type(exc).__name__}: {exc}") from exc
+    if not magic or record <= 0 or not (0 < weight < record):
+        raise EngramRowStoreManifestInvalid(f"{path}: magic, record_bytes and weight_bytes must be non-empty and 0 < weight < record")
+    keys = [(e.layer, e.rank) for e in entries]
+    if len(set(keys)) != len(keys):
+        raise EngramRowStoreManifestInvalid(f"{path}: a (layer, rank) appears more than once")
+    return RowStoreManifest(magic, record, weight, entries)
+
+
+def manifest_from_env() -> "RowStoreManifest | None":
+    path = os.environ.get(MANIFEST_ENV)
+    return None if not path else load_manifest(path)
+
+
+def manifest_entry(m: RowStoreManifest, layer: int, rank: int) -> RowStoreManifestEntry:
+    for e in m.entries:
+        if e.layer == layer and e.rank == rank:
+            return e
+    raise EngramLocalStoreMissing(f"the row-store manifest names no store for layer {layer} rank {rank}; there is no fallback table")
+
+
+def expected_identity(m: RowStoreManifest, e: RowStoreManifestEntry) -> ExpectedRowStoreIdentity:
+    return ExpectedRowStoreIdentity(e.sha256, m.magic, m.record_bytes)
+
+
+# ── THE DESIGN-B LOOKUP ─────────────────────────────────────────────────────────────────────────
+#
+# Upstream's _engram_lookup_kernel, realized over a file-backed store: for T tokens and this rank's
+# LOCAL heads, a (token, head) row is OWNED when its head exists (head < TOTAL) and its hash id falls
+# in [vocab_start, vocab_end); an owned row is the store record at local = id - vocab_start, fp8
+# weight times the ue8m0 scale (its byte is the fp32 exponent field), cast to bf16; every other row is
+# zero. The ids come to the host, the owned records are gathered in one batched fetch_rows into pinned
+# staging, copied up, and dequantized with the kernel's own operations. The staging buffer is fenced
+# by an event, so the next gather cannot overwrite rows whose copy has not completed. Decision
+# evidence: gunbc fleet-converge run 36247421840 (design B, the CPU gather).
+class FileBackedLookup:
+    def __init__(self, storage: FileBackedEngramStorage, staging: torch.Tensor, weight_bytes: int, quant_block: int):
+        self.storage = storage
+        self.staging = staging
+        self.weight_bytes = weight_bytes
+        self.quant_block = quant_block
+        self._copied = None
+
+    def lookup(self, local_ids: torch.Tensor, vocab_start: int, vocab_end: int, out: torch.Tensor) -> None:
+        """local_ids: host int64 [T, LOCAL] with -1 for heads that do not exist; out: [T, LOCAL, dim]."""
+        record = self.storage.expected.record_bytes
+        dim = self.weight_bytes
+        flat = local_ids.reshape(-1)
+        owned = (flat >= vocab_start) & (flat < vocab_end)
+        n = int(owned.sum())
+        rows_out = out.view(-1, dim)
+        rows_out.zero_()
+        if n == 0:
+            return
+        if n > self.staging.shape[0]:
+            raise EngramFullTablePinned(f"{n} owned rows exceed the {self.staging.shape[0]}-row staging buffer")
+        if self._copied is not None:
+            self._copied.synchronize()
+        local = flat[owned] - vocab_start
+        offsets = (len(self.storage.expected.magic) + local * record).tolist()
+        self.storage.fetch_rows(offsets, record, self.staging)
+        rows = self.staging[:n].to(out.device, non_blocking=True)
+        if out.device.type == "cuda":
+            self._copied = torch.cuda.Event()
+            self._copied.record()
+        w = rows[:, :dim].view(torch.float8_e4m3fn).to(torch.float32)
+        s = (rows[:, dim:dim + dim // self.quant_block].to(torch.int32) << 23).view(torch.float32)
+        values = (w * s.repeat_interleave(self.quant_block, dim=1)).to(torch.bfloat16)
+        rows_out.index_copy_(0, owned.nonzero().squeeze(1).to(out.device), values)
+
+
+def check_checkpoint_geometry(loaded: torch.Tensor, is_scale: bool, dim: int, quant_block: int, vocab_end: int) -> None:
+    """The checkpoint still streams engram.embed.* past the file-backed params; its shape and dtype
+    must be the table the manifest's stores were encoded from, or the launch refuses."""
+    want_cols = dim // quant_block if is_scale else dim
+    ok_dtype = loaded.dtype in ((torch.float8_e8m0fnu, torch.uint8) if is_scale else (torch.float8_e4m3fn,))
+    if loaded.dim() != 2 or loaded.shape[1] != want_cols or loaded.shape[0] < vocab_end or not ok_dtype:
+        raise EngramCheckpointGeometryMismatch(
+            f"checkpoint engram {'scale' if is_scale else 'weight'} {tuple(loaded.shape)} {loaded.dtype} "
+            f"is not the table the row stores encode ({want_cols} columns, at least {vocab_end} rows)"
+        )
+
+
+# ── TOUCH RECEIPTS ON SIGUSR2 ───────────────────────────────────────────────────────────────────
+#
+# When the launch names a receipt directory, each worker writes rank<r>.json (write_touch_receipt,
+# temp + rename, snapshot-and-reset) on SIGUSR2. The handler runs only on the signal, and the lock it
+# takes is held for snapshot_touches' copy-and-reset, so fetch_rows' added work stays _note_touches.
+# A worker that cannot install the handler (not its main thread) writes rank<r>.unavailable, which the
+# measurement reads as TouchCounterUnavailable rather than as silence.
+_TOUCH_STORAGES = []
+_TOUCH_STATE = {"rank": None, "installed": False}
+
+
+def register_touch_storage(storage: FileBackedEngramStorage, rank: int) -> None:
+    _TOUCH_STORAGES.append(storage)
+    _TOUCH_STATE["rank"] = rank
+    directory = os.environ.get(TOUCH_RECEIPT_DIR_ENV)
+    if not directory or _TOUCH_STATE["installed"]:
+        return
+    if threading.current_thread() is not threading.main_thread():
+        with open(os.path.join(directory, f"rank{rank}.unavailable"), "w") as f:
+            f.write("SIGUSR2 handler could not be installed: model init did not run on the worker's main thread\n")
+        _TOUCH_STATE["installed"] = True
+        return
+
+    def on_signal(signum, frame):
+        write_touch_receipt(rank, list(_TOUCH_STORAGES), os.path.join(directory, f"rank{rank}.json"), reset=True)
+
+    signal.signal(signal.SIGUSR2, on_signal)
+    _TOUCH_STATE["installed"] = True
+
+
+# ── THE RED: A BYTE-IDENTICAL DIFFERENTIAL AGAINST UPSTREAM'S KERNEL ON REAL ROWS ──────────────────
+def differential(manifest_path: str, rows: int, tokens: int, seed: int) -> int:
+    """For every (layer, rank) the manifest names: sample `rows` real records, place them in a compact
+    upstream-layout table, and compare upstream _engram_lookup_kernel with FileBackedLookup over the
+    same hash ids (owned, below and above the rank's range, and absent heads). One line per store;
+    nonzero if any output differs in any bit."""
+    import triton
+    from vllm.models.deepseek_v4_1.common.engram import _engram_lookup_kernel
+
+    m = load_manifest(manifest_path)
+    dim = m.weight_bytes
+    block = dim // (m.record_bytes - m.weight_bytes)
+    # Heads 18..23 are the last TP4 rank's slice; a total of 22 leaves heads 22 and 23 absent, so the
+    # absent-head mask is exercised too.
+    local_heads, total_heads, head_start = 6, 22, 18
+    g = torch.Generator().manual_seed(seed)
+    failures = 0
+    for e in m.entries:
+        s = FileBackedEngramStorage(e.path, expected_identity(m, e))
+        try:
+            count = (s._mmap.size() - len(m.magic)) // m.record_bytes
+            chosen = torch.randint(0, count, (rows,), generator=g)
+            raw = torch.stack([torch.frombuffer(bytearray(s._mmap[len(m.magic) + int(k) * m.record_bytes:len(m.magic) + (int(k) + 1) * m.record_bytes]), dtype=torch.uint8) for k in chosen])
+            weight = raw[:, :dim].contiguous().view(torch.float8_e4m3fn).cuda()
+            scales = raw[:, dim:].contiguous().cuda()
+            vocab_start = 1000
+            pick = torch.randint(0, rows, (tokens, total_heads), generator=g)
+            kind = torch.randint(0, 10, (tokens, total_heads), generator=g)
+            compact_ids = torch.where(kind < 7, vocab_start + pick, torch.where(kind < 8, torch.full_like(pick, 3), torch.full_like(pick, vocab_start + rows + 5)))
+            real_ids = torch.where(kind < 7, 100000 + chosen[pick], torch.where(kind < 8, torch.full_like(pick, 3), torch.full_like(pick, 100000 + count + 5)))
+            upstream = torch.empty((tokens, local_heads, dim), dtype=torch.bfloat16, device="cuda")
+            n = tokens * local_heads
+            ids_dev = compact_ids.cuda()
+            _engram_lookup_kernel[(triton.cdiv(n, 16),)](weight, scales, ids_dev, upstream, vocab_start, vocab_start + rows, n, ids_dev.stride(0), ids_dev.stride(1), HEAD_START=head_start, LOCAL_HEADS=local_heads, TOTAL_HEADS=total_heads, DIM=dim, QUANT_BLOCK=block, BLOCK_R=16, GRID=triton.cdiv(n, 16))
+            staging = torch.empty((n, m.record_bytes), dtype=torch.uint8, pin_memory=True)
+            ours = torch.empty_like(upstream)
+            present = total_heads - head_start
+            local_ids = torch.full((tokens, local_heads), -1, dtype=torch.int64)
+            local_ids[:, :present] = real_ids[:, head_start:total_heads]
+            FileBackedLookup(s, staging, dim, block).lookup(local_ids, 100000, 100000 + count, ours)
+            torch.cuda.synchronize()
+            k = kind[:, head_start:total_heads]
+            same = bool(torch.equal(upstream.view(torch.int16), ours.view(torch.int16)))
+            print("DIFFERENTIAL", e.layer, e.rank, "rows_sampled", rows, "owned", int((k < 7).sum()), "unowned_below", int((k == 7).sum()), "out_of_range", int((k > 7).sum()), "absent_heads", tokens * (local_heads - present), "equal" if same else "DIFFERS")
+            failures += 0 if same else 1
+        finally:
+            s.close()
+    print("DIFFERENTIAL_DONE", "failures", failures)
+    return 0 if failures == 0 else 1
+
+
+def self_test(directory: str) -> int:
+    """THE SELF-TEST: a tiny synthetic rank file through the batched gather and
+    the touch counter, against independent expectations. One PASS/FAIL line per
+    check; nonzero on any failure. `directory` must not be tmpfs: open() refuses
+    when the verify read's page cache cannot be released."""
+    import hashlib as _h
+    import sys as _s
+    import tempfile
+
+    m = _s.modules[__name__]
+
+    page = os.sysconf("SC_PAGE_SIZE")
+    magic = b"GUNBCTST"
+    record = 1000
+    count = (3 * page) // record + 4
+    g = torch.Generator().manual_seed(7)
+    body = torch.randint(0, 256, (count * record,), dtype=torch.uint8, generator=g).numpy().tobytes()
+    data = magic + body
+
+    results = []
+
+    def check(name: str, ok: bool, detail: str = "") -> None:
+        results.append(ok)
+        print(f"{'PASS' if ok else 'FAIL'} {name}{': ' + detail if detail and not ok else ''}")
+
+    fd, path = tempfile.mkstemp(prefix="engram_selftest_", dir=directory)
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        s = m.FileBackedEngramStorage(
+            path, m.ExpectedRowStoreIdentity(_h.sha256(data).hexdigest(), magic, record)
+        )
+        try:
+            off = lambda k: len(magic) + k * record
+            pages_of = lambda o: set(range(o // page, (o + record - 1) // page + 1))
+
+            # 1. Bytes: batched gather equals the per-row oracle and the file itself.
+            ks = [3, 0, count - 1, 3, 5]
+            offs = [off(k) for k in ks]
+            b = torch.zeros((len(ks), record), dtype=torch.uint8)
+            c = torch.zeros((len(ks), record), dtype=torch.uint8)
+            s.fetch_rows(offs, record, b)
+            s._fetch_rows_per_row(offs, record, c)
+            want = torch.tensor(list(b"".join(data[o : o + record] for o in offs)), dtype=torch.uint8).view(len(ks), record)
+            check("batched gather bytes identical to per-row oracle", torch.equal(b, c) and torch.equal(b, want))
+
+            # 2. Duplicate offset within a batch counts once.
+            s.snapshot_touches(reset=True)
+            k1 = next(k for k in range(count) if len(pages_of(off(k))) == 1)
+            s.fetch_rows([off(k1)] * 4, record, torch.zeros((4, record), dtype=torch.uint8))
+            o2 = s.snapshot_touches(reset=True)
+            check("duplicate offset counts once", o2.distinct_pages_touched == 1 and o2.rows_fetched == 4 and o2.fetch_rows_calls == 1, str(o2))
+
+            # 3. A row spanning a page boundary counts both pages.
+            k2 = next(k for k in range(count) if len(pages_of(off(k))) == 2)
+            s.fetch_rows([off(k2)], record, torch.zeros((1, record), dtype=torch.uint8))
+            o3 = s.snapshot_touches(reset=True)
+            check("row spanning a page boundary counts both pages", o3.distinct_pages_touched == 2, str(o3))
+
+            # 4. Union across calls matches an independent set; then reset empties.
+            batches = [[off(k) for k in range(0, count, 3)], [off(k) for k in range(1, count, 2)]]
+            for bt in batches:
+                s.fetch_rows(bt, record, torch.zeros((len(bt), record), dtype=torch.uint8))
+            expect = set().union(*(pages_of(o) for bt in batches for o in bt))
+            o4 = s.snapshot_touches(reset=True)
+            o5 = s.snapshot_touches(reset=False)
+            check("distinct pages across calls match an independent set", o4.distinct_pages_touched == len(expect) and o4.fetch_rows_calls == 2 and o4.rows_fetched == sum(map(len, batches)), f"{o4} expected {len(expect)}")
+            check("snapshot(reset) resets", (o5.distinct_pages_touched, o5.fetch_rows_calls, o5.rows_fetched, o5.fetch_rows_us) == (0, 0, 0, 0), str(o5))
+
+            # 5. A refused (misaligned) fetch neither counts nor times.
+            try:
+                s.fetch_rows([off(1) + 1], record, torch.zeros((1, record), dtype=torch.uint8))
+                refused = False
+            except m.EngramRowOffsetMisaligned:
+                refused = True
+            o6 = s.snapshot_touches(reset=False)
+            check("misaligned fetch refuses and is not counted", refused and o6.fetch_rows_calls == 0 and o6.distinct_pages_touched == 0, str(o6))
+        finally:
+            s.close()
+    finally:
+        os.unlink(path)
+
+    # 6. The design-B lookup against an independent per-element reference: owned rows are the record's
+    #    fp8 times 2^(scale - 127) in bf16, unowned and absent-head rows are zero.
+    dim, block = 32, 16
+    rec = dim + dim // block
+    rows_n = 40
+    g2 = torch.Generator().manual_seed(9)
+    weights = (torch.randint(0, 256, (rows_n, dim), dtype=torch.uint8, generator=g2) & 0x77)
+    scale_b = torch.randint(118, 136, (rows_n, dim // block), dtype=torch.uint8, generator=g2)
+    body2 = torch.cat([weights, scale_b], dim=1).numpy().tobytes()
+    data2 = magic + body2
+    fd2, path2 = tempfile.mkstemp(prefix="engram_selftest_", dir=directory)
+    try:
+        with os.fdopen(fd2, "wb") as f:
+            f.write(data2)
+            f.flush()
+            os.fsync(f.fileno())
+        s2 = m.FileBackedEngramStorage(path2, m.ExpectedRowStoreIdentity(_h.sha256(data2).hexdigest(), magic, rec))
+        try:
+            start, end = 500, 500 + rows_n
+            ids = torch.tensor([[500, 539, 3, -1], [520, 540, 505, 499]], dtype=torch.int64)
+            out = torch.empty((2, 4, dim), dtype=torch.bfloat16)
+            staging = torch.empty((8, rec), dtype=torch.uint8)
+            m.FileBackedLookup(s2, staging, dim, block).lookup(ids, start, end, out)
+            def ref(i):
+                if i < start or i >= end:
+                    return torch.zeros(dim, dtype=torch.bfloat16)
+                k = i - start
+                w = weights[k].view(torch.float8_e4m3fn).float()
+                sc = torch.tensor([2.0 ** (int(b) - 127) for b in scale_b[k]]).repeat_interleave(block)
+                return (w * sc).to(torch.bfloat16)
+            want = torch.stack([torch.stack([ref(int(i)) for i in row]) for row in ids])
+            check("design-B lookup equals an independent per-element reference", torch.equal(out.view(torch.int16), want.view(torch.int16)))
+        finally:
+            s2.close()
+    finally:
+        os.unlink(path2)
+
+    # 7. The manifest refuses a repeated (layer, rank) and names a missing entry; the checkpoint
+    #    geometry check refuses a table that is not the encoded one.
+    mfd, mpath = tempfile.mkstemp(prefix="engram_manifest_", dir=directory)
+    try:
+        with os.fdopen(mfd, "w") as f:
+            json.dump({"magic_hex": magic.hex(), "record_bytes": 264, "weight_bytes": 256, "stores": [{"layer": 1, "rank": 0, "path": "/x", "sha256": "0" * 64}, {"layer": 1, "rank": 0, "path": "/y", "sha256": "1" * 64}]}, f)
+        try:
+            m.load_manifest(mpath)
+            repeated = False
+        except m.EngramRowStoreManifestInvalid:
+            repeated = True
+        with open(mpath, "w") as f:
+            json.dump({"magic_hex": magic.hex(), "record_bytes": 264, "weight_bytes": 256, "stores": [{"layer": 1, "rank": 0, "path": "/x", "sha256": "0" * 64}]}, f)
+        one = m.load_manifest(mpath)
+        try:
+            m.manifest_entry(one, 14, 0)
+            missing = False
+        except m.EngramLocalStoreMissing:
+            missing = True
+        check("manifest refuses a repeated store and a missing (layer, rank)", repeated and missing and m.manifest_entry(one, 1, 0).path == "/x")
+    finally:
+        os.unlink(mpath)
+    try:
+        m.check_checkpoint_geometry(torch.empty((100, 128), dtype=torch.float8_e4m3fn), False, 256, 32, 50)
+        geometry = False
+    except m.EngramCheckpointGeometryMismatch:
+        geometry = True
+    m.check_checkpoint_geometry(torch.empty((100, 256), dtype=torch.float8_e4m3fn), False, 256, 32, 50)
+    check("checkpoint geometry refuses a table the stores were not encoded from", geometry)
+
+    return 0 if all(results) else 1
+
+
+
+if __name__ == "__main__":
+    import argparse
+    import sys
+
+    if len(sys.argv) >= 2 and sys.argv[1] == "--self-test":
+        sys.exit(self_test(sys.argv[2] if len(sys.argv) > 2 else os.getcwd()))
+    if len(sys.argv) >= 2 and sys.argv[1] == "--differential":
+        dp = argparse.ArgumentParser(description="byte-identical differential against upstream _engram_lookup_kernel")
+        dp.add_argument("--differential", dest="manifest", required=True)
+        dp.add_argument("--rows", type=int, default=4096)
+        dp.add_argument("--tokens", type=int, default=2048)
+        dp.add_argument("--seed", type=int, default=5)
+        da = dp.parse_args()
+        sys.exit(differential(da.manifest, da.rows, da.tokens, da.seed))
+    p = argparse.ArgumentParser(description="measure fetch_rows over a rank-local Engram row store")
+    p.add_argument("--store", required=True)
+    p.add_argument("--rank-digest-hex", required=True)
+    p.add_argument("--magic-hex", required=True)
+    p.add_argument("--record-bytes", type=int, required=True)
+    p.add_argument("--rows", type=int, required=True)
+    p.add_argument("--repeats", type=int, default=100)
+    a = p.parse_args()
+    s = FileBackedEngramStorage(a.store, ExpectedRowStoreIdentity(a.rank_digest_hex, bytes.fromhex(a.magic_hex), a.record_bytes))
+    try:
+        print(json.dumps({"open_receipt": s.receipt.__dict__, "fetch_rows": measure_fetch_rows(s, a.rows, a.repeats)}))
+    finally:
+        s.close()
