--- a/cmake/external_projects/deepgemm.cmake
+++ b/cmake/external_projects/deepgemm.cmake
@@ -56,6 +56,24 @@
     )
   endif()
   message(STATUS "DeepGEMM is available at ${deepgemm_SOURCE_DIR}")
+
+  # SM120 FP8 paged-MQA logits at 32-state pages (vllm-project/DeepGEMM#14 host
+  # changes, ported to this pin): DeepSeek-V4.1 ratio-2 indexer layers take
+  # 32-state pages once the kernel page is 64 tokens on SM12x. Idempotent:
+  # an already-applied tree is left alone, anything else that does not apply
+  # stops the build.
+  set(_deepgemm_page32_patch "${CMAKE_CURRENT_LIST_DIR}/deepgemm_sm120_fp8_page32.patch")
+  execute_process(
+    COMMAND git -C "${deepgemm_SOURCE_DIR}" apply --reverse --check "${_deepgemm_page32_patch}"
+    RESULT_VARIABLE _deepgemm_page32_present OUTPUT_QUIET ERROR_QUIET)
+  if(NOT _deepgemm_page32_present EQUAL 0)
+    execute_process(
+      COMMAND git -C "${deepgemm_SOURCE_DIR}" apply "${_deepgemm_page32_patch}"
+      RESULT_VARIABLE _deepgemm_page32_applied)
+    if(NOT _deepgemm_page32_applied EQUAL 0)
+      message(FATAL_ERROR "DeepGEMM SM120 page32 patch did not apply to ${deepgemm_SOURCE_DIR}")
+    endif()
+  endif()
 endif()
 
