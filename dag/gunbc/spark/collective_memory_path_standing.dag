module gunbc.spark.collective_memory_path_standing

import std.types { Bool, String, NonEmptyStr, List }
import extdeps.nvidia.nccl {
  NcclGpuMemoryPath, NcclGpuDirectEnabled, NcclGpuDirectDisabled,
  NcclGpuMemoryPathReading, NcclMemoryPathAgreed, NcclMemoryPathDisagrees, NcclMemoryPathUnreadable, NcclMemoryPathAbsent,
}
import extdeps.nvidia.gpu_direct_rdma {
  GpuDirectRdmaCapability, GpuDirectRdmaDevicePrerequisiteMet, GpuDirectRdmaDeviceUnsupported,
  GpuDirectRdmaCapabilityUnread,
}

// ── A DISABLED GPUDIRECT PATH IS A DEFECT OR A SUPPORTED STATE, AND ONLY THE JOIN KNOWS WHICH ──
//
// THE OBSERVATION ALONE CANNOT DECIDE IT. `GPU Direct RDMA Disabled` is the same sentence on a
// platform that cannot do it and on a platform that can and was misconfigured, and the difference is
// the whole question a reader is asking. This fold is the join, and it exists because the absence of
// it cost a real investigation: an arm correctly serving over RoCE on a platform whose device
// reports no GPUDirect and no DMA-BUF support was diagnosed as an incomplete deployment, and two
// repairs were proposed -- a kernel module that cannot attach to this RDMA stack, and an image
// rebuild for a userspace symbol -- neither of which could have changed the outcome.
//
// THE UNREAD ARMS ARE NOT COURTESY. A missing capability read and a missing observation lead to
// opposite mistakes: without the capability, a supported state reads as a defect; without the
// observation, a defect reads as nothing at all. Neither collapses into the other, and neither
// collapses into the answer.
// THE STANDING IS AN OBSERVATION, AND WHETHER IT IS A DEFECT IS A SEPARATE, CALLER-OWNED QUESTION.
// An earlier revision named one arm MemoryPathBelowCapability and mapped it straight to a defect.
// That promoted a device PREREQUISITE -- "this device is not the obstacle" -- into a deployment
// REQUIREMENT: NCCL can lawfully leave GPUDirect disabled on a capable device because of topology,
// an explicit NCCL_NET_GDR_LEVEL, another missing prerequisite, or a product decision. So the join
// below reports what the two producers said, neutrally, and `memory_path_defect_standing` takes a
// DesiredCollectiveMemoryPath from the caller before it will call anything a defect (side-chat
// review of #11560, 2026-09-18; DESIGN section 3d, observation before policy).
//
// AND NCCL DISAGREEING WITH ITSELF IS ITS OWN FACT. The capture reading arrives whole, so "several
// HCA or plugin lines disagree" stays distinct from "no line was read" instead of being collapsed
// into one unread arm before it gets here.
type CollectiveMemoryPathStanding
  = MemoryPathDirectAsCapable
  | MemoryPathStagedAsPlatformRequires {
      platform: NonEmptyStr
      capability_receipt: NonEmptyStr
      observed_from: NonEmptyStr
    }
  | MemoryPathRuntimeDisabledWhereDevicePermits {
      capability_receipt: NonEmptyStr
      observed_from: NonEmptyStr
    }
  | MemoryPathProducersContradict {
      capability_receipt: NonEmptyStr
      observed_from: NonEmptyStr
    }
  | MemoryPathObservationDisagrees {
      causes: List<NonEmptyStr>
    }
  | MemoryPathStandingUnread {
      cause: NonEmptyStr
    }

fn collective_memory_path_standing(
  capability: GpuDirectRdmaCapability,
  observed: NcclGpuMemoryPathReading,
) -> CollectiveMemoryPathStanding {
  match observed {
    NcclMemoryPathAbsent =>
      MemoryPathStandingUnread { cause: "the capture carries no GPU Direct RDMA line, so the run's own memory path was not read" as NonEmptyStr }
    NcclMemoryPathUnreadable { causes: cs } =>
      MemoryPathStandingUnread { cause: join(["the capture carries GPU Direct RDMA line(s) this reader could not read: ", join(map(cs, c => c as String), "; ")], "") as NonEmptyStr }
    NcclMemoryPathDisagrees { causes: cs } => MemoryPathObservationDisagrees { causes: cs }
    NcclMemoryPathAgreed { path: path, readings: _ } =>
      match capability {
        GpuDirectRdmaCapabilityUnread { cause: c } =>
          MemoryPathStandingUnread { cause: join(["the platform capability is unread, so a staged path cannot be told from a supported one: ", c as String], "") as NonEmptyStr }
        GpuDirectRdmaDeviceUnsupported { platform: p, dma_buf: _, capability_receipt: r } =>
          match path {
            NcclGpuDirectDisabled { read_from: l } =>
              MemoryPathStagedAsPlatformRequires { platform: p, capability_receipt: r, observed_from: l }
            NcclGpuDirectEnabled { read_from: l } =>
              MemoryPathProducersContradict { capability_receipt: r, observed_from: l }
          }
        GpuDirectRdmaDevicePrerequisiteMet { dma_buf: _, capability_receipt: r } =>
          match path {
            NcclGpuDirectEnabled { read_from: _ } => MemoryPathDirectAsCapable {}
            NcclGpuDirectDisabled { read_from: l } =>
              MemoryPathRuntimeDisabledWhereDevicePermits { capability_receipt: r, observed_from: l }
          }
      }
  }
}

// ── WHAT THE DEPLOYMENT WANTED, WHICH IS THE CALLER'S TO SAY ──────────────────────────────────
//
// DirectRegistrationWhereDevicePermits: a device that can register GPU memory must be used that way,
// so a runtime that staged through host memory on such a device is a defect. HostStagingAccepted: the
// deployment accepts staging whatever the device can do. Neither affects a device that cannot
// register at all -- staging is then the platform's only supported state under either policy.
type DesiredCollectiveMemoryPath
  = DirectRegistrationWhereDevicePermits
  | HostStagingAccepted

// ── WHETHER A READER SHOULD ACT IS FOUR-VALUED, AND THE BOOLEAN THAT STOOD HERE FAILED OPEN ────
//
// THE DEFECT, RECORDED BECAUSE I BUILT IT INTO A MODULE WHOSE SUBJECT IS FAIL-CLOSED READING. The
// first revision answered `Bool`, and answered FALSE for MemoryPathStandingUnread -- so a caller
// writing `if !is_defect(s) { admit() }` admitted on evidence nobody read. Unread is not the
// absence of a defect; it is the absence of a reading, and the two differ exactly where it matters.
type MemoryPathDefectStanding
  = DefectEstablished { cause: NonEmptyStr }
  | NoDefectEstablished { because: NonEmptyStr }
  | DefectStandingUnread { cause: NonEmptyStr }
  | EvidenceContradicts { cause: NonEmptyStr }

fn memory_path_defect_standing(policy: DesiredCollectiveMemoryPath, s: CollectiveMemoryPathStanding) -> MemoryPathDefectStanding {
  match s {
    MemoryPathRuntimeDisabledWhereDevicePermits { capability_receipt: r, observed_from: l } =>
      match policy {
        DirectRegistrationWhereDevicePermits =>
          DefectEstablished { cause: join(["the deployment requires direct registration where the device permits it, the device reports the GPUDirect APIs, and this run staged through host memory. Capability: ", r as String, ". Observed: ", l as String], "") as NonEmptyStr }
        HostStagingAccepted =>
          NoDefectEstablished { because: "the device permits direct registration and the deployment accepts host staging" as NonEmptyStr }
      }
    MemoryPathDirectAsCapable =>
      NoDefectEstablished { because: "the run registered GPU memory directly" as NonEmptyStr }
    MemoryPathStagedAsPlatformRequires { platform: p, capability_receipt: _, observed_from: _ } =>
      NoDefectEstablished { because: join(["the platform reports no GPUDirect capability, so a non-direct path is its supported state: ", p as String], "") as NonEmptyStr }
    MemoryPathProducersContradict { capability_receipt: r, observed_from: l } =>
      EvidenceContradicts { cause: join([
        "the device reports no GPUDirect capability and the run announced a registered path anyway, so one of the two producers is wrong and no admission may rest on either. Capability: ",
        r as String, ". Observed: ", l as String,
      ], "") as NonEmptyStr }
    MemoryPathObservationDisagrees { causes: cs } =>
      EvidenceContradicts { cause: join(["the run's own GPU Direct RDMA lines disagree: ", join(map(cs, c => c as String), "; ")], "") as NonEmptyStr }
    MemoryPathStandingUnread { cause: c } => DefectStandingUnread { cause: c }
  }
}

fn memory_path_standing_text(s: CollectiveMemoryPathStanding) -> NonEmptyStr {
  match s {
    MemoryPathDirectAsCapable => "GPU memory is registered with the NIC directly" as NonEmptyStr
    MemoryPathStagedAsPlatformRequires { platform: p, capability_receipt: r, observed_from: l } =>
      join([
        "collective buffers stage through host memory because ", p as String,
        " does not support GPUDirect registration, which is the platform's supported state and not a deployment defect. Capability read: ", r as String,
        ". Observed: ", l as String,
      ], "") as NonEmptyStr
    MemoryPathRuntimeDisabledWhereDevicePermits { capability_receipt: r, observed_from: l } =>
      join([
        "the device reports the GPUDirect APIs and this run staged through host memory; whether that is a defect is the deployment policy's to say. Capability read: ", r as String,
        ". Observed: ", l as String,
      ], "") as NonEmptyStr
    MemoryPathProducersContradict { capability_receipt: r, observed_from: l } =>
      join(["two producers disagree and neither may be relied on: capability says ", r as String, ", the run announced ", l as String], "") as NonEmptyStr
    MemoryPathObservationDisagrees { causes: cs } =>
      join(["the run's own GPU Direct RDMA lines disagree: ", join(map(cs, c => c as String), "; ")], "") as NonEmptyStr
    MemoryPathStandingUnread { cause: c } => c
  }
}
