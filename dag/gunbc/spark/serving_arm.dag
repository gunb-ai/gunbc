  reasoning_projection: none,
  provenance: "every field of this row except the patch roster was read inside the produced digest by fleet-converge run 37100656092 (version, package dir, kvplan marker, hub CLI path, 378-name registry); the patch roster is the recipe's" as NonEmptyStr,
  claimed_defaults_revision: Present { value: Vllm8d09804 },
