// ── THE V4.1 FOUR-RANK LAUNCH ON GROUP A, AS ONE MORE CALL SITE OF THE ARM LAUNCHER ─────────────
//
// SINCE DEFORKING CUT 8a THIS MODULE IS THE V4.1 ARM'S INPUTS AND NOTHING ELSE. The plan, the units,
// the steps, the admission's shared conjuncts, the dry-run report, the wet entry and the transaction
// are gunbc.spark.group_arm_launch's -- the one launch path every arm on a fabric group takes. What
// stays here is V4.1's: the held production image and its registry reading, the Engram manifest, mounts,
// environment and staging, the SM120 self-test, the candidate's successor key and the one conjunct only
// V4.1 has (the produced image's specification key must be its candidate's).
//
// WHY THIS IS NOT A SECOND LAUNCHER. Group A's incumbent realization is the Ray pair
// (gunbc.spark.pair_serving_realization), and V4.1 cannot run on it: the V4.1 image is upstream vLLM
// d2d649e6's vllm-openai target, and neither that revision's requirements nor its Dockerfile installs
// Ray, so `ray start` has nothing to run. The launcher that fits already exists -- the mp-backend
// multi-node arm (gunbc.spark.serving_arm_launch plan_arm_launch_for: --nnodes, --node-rank,
// --master-addr over the fabric rail, headless followers), its unit renderer
// (gunbc.spark.native_serving_realization) and its transactional apply
// (gunbc.spark.native_serving_apply: preflight, preserve, head-first apply, per-rank readback, commit or
// rollback). This module names V4.1's tuple once, the way gunbc.spark.glm_group_b_launch names Group B's,
// and every V4.1 rendering projects from it. Ruled by proud-deer-538 on 2026-09-26 (DS4.1).
//
// WHAT IT RENDERS AND WHAT IT RUNS. The dry run plans, renders every host's unit and container line,
// the Engram staging and the apply's preflight and apply scripts for all four hosts, and reaches no host
// except the read of the authority log. The wet entry (the fleet mode spark_arm_group_launch with arm
// v41-group-a, gunbc.spark.arm_group_launch_dispatch) reads the held image, its registry and every host's occupancy, and only on
// v41_group_a_launch_admission stages the Engram manifest and runs the arm transaction. It is one serve
// at the capacity measurement's shape; the staircase that loads it is that measurement's wet runner
// (gunbc.spark.v41_capacity_measurement v41_wet_runner_frontier).

// ── WHAT THIS DEPLOYMENT IS CALLED, DISTINCT FROM EVERY OTHER ────────────────────────────────
//
// THE NAMES ARE NEW ON PURPOSE. Host occupancy is read by unit and container name, and Group A's hosts
// may still carry the V4 pair's gunbc-spark-pair container and units. Reusing any of those names would
// let a V4 unit still running read as this arm already installed -- the one mistake the admission below
// must never make, since a running V4 unit is occupancy to refuse on, never something to stop.
data v41_group_a_container_name: NonEmptyStr = "gunbc-v41-tp4" as NonEmptyStr

data v41_group_a_units: ArmUnitIdentity = ArmUnitIdentity {
  head_unit_name: "gunbc-v41-tp4-head.service" as NonEmptyStr,
  rank_unit_name: "gunbc-v41-tp4-rank.service" as NonEmptyStr,
  head_log_path: "/var/log/gunbc/v41-tp4-head.log" as NonEmptyStr,
  rank_log_path: "/var/log/gunbc/v41-tp4-rank.log" as NonEmptyStr,
  description: "gunbc DeepSeek V4.1 four-rank arm" as NonEmptyStr,
}

// THE SERVED NAME IS THIS LAUNCH'S, and the port is the route's: V4.1 succeeds V4 on the same serving
// subject (gunbc.spark.serving_subject PairServingUnitOn on Group A), and gunbc.serving.serving_enrollment
// reads Group A's port from gunbc.spark.pair_serving_realization spark_pair_serve_port. Serving on any
// other port would leave the enrolled route asking a door this launch never opens.
data v41_group_a_served_alias: NonEmptyStr = "deepseek-v4.1-flash" as NonEmptyStr

// THE RENDEZVOUS PORT IS torch.distributed's DEFAULT, 29500, chosen rather than inherited. Group A's
// incumbent rendezvous is Ray's GCS on 6379 (gunbc.spark.pair_serving_observed first_pair_ray_head), so
// the two do not collide on a host that still carries the pair.
//
// THE SHARED-MEMORY SIZE IS DOCKER'S OWN DEFAULT (64 MiB). With --ipc host the container's /dev/shm is
// the host's, so the figure is nearly inert, but a spec may not carry a number nobody chose: this one
// is the daemon's default rather than a figure borrowed from another arm's inspect.
data v41_group_a_master_port: Port = 29500

// ── THE ENGRAM FILE-BACKED PATH: TWO VARIABLES AND THREE MOUNTS ───────────────────────────────
//
// THE VARIABLE NAMES ARE THE OVERLAY'S. The file-backed Engram overlay (patches/d2d649e6,
// engram_file_backed.py, its MANIFEST_ENV and TOUCH_RECEIPT_DIR_ENV constants, landing with #12359)
// reads the row-store manifest from the FILE the first names -- load_manifest opens that path -- and
// writes one touch receipt per rank into the directory the second names when the staircase runner sends
// SIGUSR2 at a step boundary.
data v41_engram_manifest_env_name: NonEmptyStr = "GUNBC_ENGRAM_ROW_STORE_MANIFEST" as NonEmptyStr
data v41_engram_touch_receipt_env_name: NonEmptyStr = "GUNBC_ENGRAM_TOUCH_RECEIPT_DIR" as NonEmptyStr

// THE MANIFEST AND THE RECEIPTS EACH GET THEIR OWN HOST DIRECTORY, mounted at the same path inside, so
// a path the manifest names and a path the engine opens are one string. The manifest is read-only to
// the engine; the receipt directory is the one place it writes. The row stores are mounted read-only
// at their own path for the same reason: the manifest names them by the path the encode wrote them to.
data v41_engram_manifest_dir: NonEmptyStr = "/var/lib/gunbc/v41-engram-manifest" as NonEmptyStr
data v41_engram_touch_receipt_dir: NonEmptyStr = "/var/lib/gunbc/v41-engram-touch" as NonEmptyStr

fn v41_engram_manifest_path() -> NonEmptyStr {
  join([v41_engram_manifest_dir as String, "/row-store-manifest.json"], "") as NonEmptyStr
}

data v41_group_a_arm_container: ArmContainerIdentity = ArmContainerIdentity {
  container_name: v41_group_a_container_name,
  master_port: v41_group_a_master_port,
  shm_size: byte_size(count: 67108864),
  extra_mounts: [
    BindMount { host_path: v41_row_store_output_directory(), container_path: v41_row_store_output_directory(), readonly: true },
    BindMount { host_path: v41_engram_manifest_dir, container_path: v41_engram_manifest_dir, readonly: true },
    BindMount { host_path: v41_engram_touch_receipt_dir, container_path: v41_engram_touch_receipt_dir, readonly: false },
  ],
}

fn v41_group_a_deployment_env() -> List<DockerEnvAssignment> {
  [
    DockerEnvAssignment { name: v41_engram_manifest_env_name, value: v41_engram_manifest_path() as String },
    DockerEnvAssignment { name: v41_engram_touch_receipt_env_name, value: v41_engram_touch_receipt_dir as String },
  ]
}

// ── THE LAUNCH SHAPE IS THE MEASUREMENT'S ─────────────────────────────────────────────────────
//
// ONE SERVE FOR THE WHOLE STAIRCASE (clever-gull-48, 2026-09-26): a relaunch between steps would reset
// the page cache, the refault baselines and the KV pool the stop rules read across steps. So every
// engine figure this launch serves at -- the window, the admitted sequences (the staircase's largest
// step), the scheduler budget, the memory fraction and the prefix-caching request -- is read from the
// measurement's own authority, gunbc.spark.v41_capacity_measurement v41_measurement_launch_shape, and
// none is spelled here. The last three are that authority's declared measurement axes; the startup
// receipt records what the engine actually resolved, so a step the pool cannot hold refuses there.

// ── THE INPUTS A PLAN IS MADE OF, SUPPLIED RATHER THAN READ INSIDE ────────────────────────────
//
// EVERY INPUT THAT IS NOT A DECLARATION ON MAIN ARRIVES AS A VALUE: the image as it is HELD on the
// launch's hosts, its registry reading (both read at run time by the wet entry below) and the derived
// Engram row-store manifest. A witness supplies them; the live bindings read what exists and name what
// does not.
type V41GroupALaunchInputs {
  held: V41HeldRuntimeStanding
  registry_reading: ArchitectureRegistryReading?
  manifest: V41EngramStoreManifest
}

type V41GroupALaunchPlan
  = V41GroupALaunchPlanned {
      lines: List<ArmNodeLaunch>
      profile: ServingLaunchProfile
      specification_runtime_key: ContentHash
      manifest_text: String
      master_endpoint: NonEmptyStr
    }
  | V41GroupALaunchUnestablished { obligations: List<String> }
  | V41GroupALaunchRefused { causes: List<String> }

// ── THE IMAGE A LAUNCH RUNS IS HELD, NOT PRODUCED ─────────────────────────────────────────────
//
// A DIFFERENT STANDING FROM THE BUILD'S, ON PURPOSE. gunbc.spark.v41_runtime_realized
// V41RuntimeProduced is minted only by the build leg that produced the bytes (V41ProducedRuntimeImage
// is sole_constructor, and an image found under a tag refuses as AdoptedUnderExpectedTag), so a launch
// running hours later on four other hosts cannot hold one and must not fake one. What it CAN
// establish is the join of two facts: the production receipt row (gunbc.spark.v41_runtime_image_converge
// v41_production_produced_image -- the digest, the tree the build observed, the run that produced it)
// and a readback on EVERY launch host that the image's tag names exactly that digest there. The tag is
// derived from the receipt's observed tree by the same fold the distribution uses
// (v41_produced_image_subject), so a host holds the subject only if the distribution put it there.
// Three further checks are the admission's own: the receipt's tree is the candidate recipe's revision;
// the candidate's runtime artifact keys (v41_runtime_artifact_key, computed by the caller and handed
// in, since it reads the kernel wheels), which is the specification key the admission compares with
// the candidate below; and no host holds another image under the tag. A host
// that holds nothing under the tag is an OBLIGATION naming the distribution mode, not a refusal: the fix
// is to deliver, and nothing is wrong with the image.
type V41HeldRuntimeStanding
  = V41RuntimeHeldOnHosts { specification_runtime_key: ContentHash, image: V41ProducedImageHeld, subject: VllmImageDistributionSubject }
  | V41RuntimeHeldUnestablished { obligations: List<String> }
  | V41RuntimeHeldRefused { defects: List<String> }

fn v41_host_image_read(host: HostIdentity, reads: List<VllmImageTargetRead>) -> VllmImageTargetRead? {
  first(filter(reads, r => (r.host as String) == (host as String)))
}

fn v41_held_obligations(hosts: List<HostIdentity>, reads: List<VllmImageTargetRead>, subject: VllmImageDistributionSubject) -> List<String> {
  flat_map(hosts, h => match v41_host_image_read(host: h, reads: reads) {
    Absent => [join(["no image readback was taken on ", h as String, ", so whether it holds ", subject.tag as String, " is unknown"], "")]
    Present { value: r } => match r.state {
      VllmImageTargetHolds => [] as List<String>
      VllmImageTargetNeeds => [join([h as String, " holds nothing under ", subject.tag as String, "; deliver it with the distribution mode spark_runtime_image_distribute, runtime_image v41-dsv41-gb10 (gunbc.spark.runtime_image_produce_dispatch runtime_image_distribute_ci_wet)"], "")]
      VllmImageTargetRefused { step: _, cause: _ } => [] as List<String>
    }
  })
}

fn v41_held_defects(hosts: List<HostIdentity>, reads: List<VllmImageTargetRead>) -> List<String> {
  flat_map(hosts, h => match v41_host_image_read(host: h, reads: reads) {
    Absent => [] as List<String>
    Present { value: r } => match r.state {
      VllmImageTargetHolds => [] as List<String>
      VllmImageTargetNeeds => [] as List<String>
      VllmImageTargetRefused { step: st, cause: why } => [join([h as String, " refused the image readback at ", st as String, ": ", why], "")]
    }
  })
}

fn v41_admit_held_runtime(
  recipe: VllmContainerBuildRecipe,
  artifact: V41IdentityStanding,
  image: V41ProducedImageHeld,
  hosts: List<HostIdentity>,
  reads: List<VllmImageTargetRead>,
) -> V41HeldRuntimeStanding {
  let subject = v41_produced_image_subject(p: image)
  let defects = concat(
    if (image.observed.revision_head as String) == (recipe.source.full_revision as String) { [] as List<String> } else {
      [join(["the production receipt's image was built from a tree at ", image.observed.revision_head as String, ", and this candidate's recipe names ", recipe.source.full_revision as String], "")]
    },
    v41_held_defects(hosts: hosts, reads: reads))
  let obligations = v41_held_obligations(hosts: hosts, reads: reads, subject: subject)
  match artifact {
    V41IdentityRefused { defects: d } => V41RuntimeHeldRefused { defects: concat(map(d, x => x as String), defects) }
    V41IdentityUnestablished { obligations: o } =>
      if length(defects) != 0 { V41RuntimeHeldRefused { defects: defects } } else { V41RuntimeHeldUnestablished { obligations: concat(map(o, x => x as String), obligations) } }
    V41IdentityKeyed { key: spec } =>
      if length(defects) != 0 {
        V41RuntimeHeldRefused { defects: defects }
      } else if length(obligations) != 0 {
        V41RuntimeHeldUnestablished { obligations: obligations }
      } else {
        V41RuntimeHeldOnHosts { specification_runtime_key: spec, image: image, subject: subject }
      }
  }
}

// THE RUNTIME VARIANT IS THE HELD IMAGE'S IDENTITY: its configuration digest (the only id a
// never-pushed image has, and the one the distribution moves and the hosts read back), the source tree
// the build observed, and that tree's worktree diff -- the patch set as it was applied.
fn v41_serving_runtime(held: V41HeldRuntimeStanding, registry_reading: ArchitectureRegistryReading?) -> ServingRuntime? {
  match held {
    V41RuntimeHeldUnestablished { obligations: _ } => none
    V41RuntimeHeldRefused { defects: _ } => none
    V41RuntimeHeldOnHosts { specification_runtime_key: k, image: i, subject: sub } =>
      Present { value: GunbcDeepseekV41EngramProduced {
        artifact: runtime_artifact_identity(
          pin: PinnedByDigest { reference: render_oci_content_digest_wire(d: i.config) as NonEmptyStr },
          source: SourceRevisionEstablished { revision: i.observed.revision_head },
          patch_set: [join(["worktree-diff-sha256:", i.observed.worktree_diff_sha256.hex as String], "") as NonEmptyStr],
          provenance: join(["produced by fleet-converge run ", i.receipt_run as String, " on ", i.held_on as String, " under tag ", sub.tag as String, ", read back under that tag at this digest on every launch host, and admitted against the candidate's specification runtime key ", serialize_content_hash(hash: k) as String], "") as NonEmptyStr,
        ),
        registry_reading: registry_reading,
      } }
  }
}

fn v41_held_obligations_of(h: V41HeldRuntimeStanding) -> List<String> {
  match h {
    V41RuntimeHeldOnHosts { specification_runtime_key: _, image: _, subject: _ } => [] as List<String>
    V41RuntimeHeldUnestablished { obligations: o } => map(o, x => join(["the V4.1 image: ", x], ""))
    V41RuntimeHeldRefused { defects: _ } => [] as List<String>
  }
}

fn v41_held_defects_of(h: V41HeldRuntimeStanding) -> List<String> {
  match h {
    V41RuntimeHeldRefused { defects: d } => map(d, x => join(["the V4.1 image was refused: ", x], ""))
    V41RuntimeHeldOnHosts { specification_runtime_key: _, image: _, subject: _ } => [] as List<String>
    V41RuntimeHeldUnestablished { obligations: _ } => [] as List<String>
  }
}

// ── THE MANIFEST THE LAUNCH STAGES IS DERIVED, AS THE DIFFERENTIAL'S IS ──────────────────────
//
// The same derivation gunbc.spark.v41_engram_differential_run hands its overlay: the row-store spec
// over the live Engram population, then gunbc.spark.v41_engram_store_manifest over the published store
// readings. A refusal at either names its causes, and the plan carries them as refusals.
fn v41_group_a_manifest() -> V41EngramStoreManifest {
  match v41_row_store_spec(population: map(deepseek_v4_1_flash_engram_sharded_entries, e => e.entry), partition: v41_candidate_partition, tables: deepseek_v4_1_flash_engram, head_sizes: v41_live_head_sizes(tables: deepseek_v4_1_flash_engram)) {
    V41RowStoreSpecRefused { defects: d } => V41StoreManifestRefused { causes: map(d, x => join(["the row-store spec refused: ", x as String], "")) }
    V41RowStoreSpecAdmitted { spec: spec } => v41_engram_store_manifest(spec: spec, readings: v41_published_store_readings)
  }
}

fn v41_manifest_defects(m: V41EngramStoreManifest) -> List<String> {
  match m {
    V41StoreManifestDerived { text: _, stores: _ } => [] as List<String>
    V41StoreManifestRefused { causes: c } => map(c, x => join(["the Engram row-store manifest refused: ", x], ""))
  }
}

// THE INTENT IS ONE ROW, READ BY THE PLAN AND BY THE UNIT RENDER. V4.1 runs on Group A only as a bounded
// experiment; the plan is admitted under this intent and the units render under it -- one attempt, no
// restart, RuntimeMaxSec at the bound the wall derives from this launch -- so the engine that runs is
// the experiment the wall admitted, never a persistent service planned as one.
data v41_group_a_intent: ArmIntent = ArmBoundedExperiment

// THE LAUNCH PASSES THE SAME MEMORY WALL AS EVERY ARM (deforking cut 4): plan_arm_launch_under_memory_fit,
// not plan_arm_launch_for. The fit verdict is Unestablished for V4.1 today (its per-rank terms are open),
// so the bounded experiment is admitted only behind a typed experiment plan with a stop contract and a
// runtime bound derived from THIS launch's environment -- upstream's 600-second ready default, since the
// deployment sets none -- and its own sequence ceiling. Normal serving stays refused until the fit proves.
//
// THE PROFILE IS DERIVED THE WAY EVERY MODEL'S IS (deforking cut 3): the measurement shape's window,
// sequence population and batch become a cold intent; the envelope sits AT THE FLOOR, so the engine's
// ceiling equals the measured seat population exactly as before; the model's own choices are
// gunbc.spark.serving_arm deepseek_v41_launch_policy. Absent means the intent refused (a zero-seat or
// zero-batch shape), and the launch plan refuses with it rather than inventing a profile.
fn v41_group_a_profile(shape: V41MeasurementLaunchShape) -> ServingLaunchProfile? {
  match uniform_cold_seats(each: shape.max_model_len, seats: shape.max_num_seqs, max_batched_tokens: shape.max_num_batched_tokens) {
    ServingCapacityIntentRefused { cause: _ } => none
    ServingCapacityIntentAdmitted { intent: intent } => Present { value: profile_for_envelope(
      envelope: envelope_at_cold_floor(cold: intent),
      policy: deepseek_v41_launch_policy,
      decided_gpu_memory_basis_points: shape.gpu_memory_utilization,
      serve_port: spark_pair_serve_port,
      served_alias: v41_group_a_served_alias,
      prefix_caching: shape.prefix_caching,
    ) }
  }
}

// THE V4.1 ARM'S INPUTS TO THE ONE LAUNCH PATH (gunbc.spark.group_arm_launch, deforking cut 8a): its
// assignment on Group A with the held runtime, the measurement's profile, the Engram environment and
// mounts, and its own names. Everything else -- the memory wall, the units, the steps, the admission's
// shared conjuncts and the transaction -- is that module's.
data v41_group_a_purpose: NonEmptyStr = "the V4.1 Group A four-rank launch" as NonEmptyStr

fn v41_group_a_arm_inputs(runtime: ServingRuntime, launch_profile: ServingLaunchProfile) -> GroupArmLaunchInputs {
  GroupArmLaunchInputs {
    assignment: fabric_serving_assignment_for_launch(group: FabricGroupA, checkpoint: DeepseekV41FlashDba1be0a, runtime: runtime, topology: FourSparkTp4),
    profile: launch_profile,
    intent: v41_group_a_intent,
    deployment_env: v41_group_a_deployment_env(),
    container: v41_group_a_arm_container,
    units: v41_group_a_units,
    purpose: v41_group_a_purpose,
  }
}

// THE PLAN. A defect in any input refuses; otherwise every missing input is named at once, so one run
// reports the whole distance to a launchable plan rather than the first gap. Only a complete set of
// inputs reaches the one launch path, and its walls -- the arm admission (registry reading, fit), the
// compatibility roster and the bounded-experiment intent -- still decide. The V4.1 plan carries the two
// facts that are V4.1's beside the generic plan's: the specification runtime key the held image was
// admitted against, and the Engram manifest the pre-apply stages.
fn v41_group_a_launch_plan(inputs: V41GroupALaunchInputs) -> V41GroupALaunchPlan {
  let defects = concat(v41_held_defects_of(h: inputs.held), v41_manifest_defects(m: inputs.manifest))
  let obligations = v41_held_obligations_of(h: inputs.held)
  if length(defects) != 0 {
    V41GroupALaunchRefused { causes: defects }
  } else if length(obligations) != 0 {
    V41GroupALaunchUnestablished { obligations: obligations }
  } else {
    match inputs.held {
      V41RuntimeHeldUnestablished { obligations: _ } => V41GroupALaunchUnestablished { obligations: obligations }
      V41RuntimeHeldRefused { defects: _ } => V41GroupALaunchRefused { causes: defects }
      V41RuntimeHeldOnHosts { specification_runtime_key: key, image: _, subject: _ } =>
        match v41_serving_runtime(held: inputs.held, registry_reading: inputs.registry_reading) {
          Absent => V41GroupALaunchRefused { causes: ["unreachable: a held image always has a runtime identity"] }
          Present { value: runtime } =>
            match inputs.manifest {
              V41StoreManifestRefused { causes: c } => V41GroupALaunchRefused { causes: c }
              V41StoreManifestDerived { text: manifest, stores: _ } =>
                match v41_group_a_profile(shape: v41_measurement_launch_shape()) {
                  Absent => V41GroupALaunchRefused { causes: ["the V4.1 measurement shape's cold intent refused (zero seats or zero batched tokens), so no launch profile derives"] }
                  Present { value: launch_profile } =>
                    match group_arm_launch_plan(inputs: v41_group_a_arm_inputs(runtime: runtime, launch_profile: launch_profile)) {
                      GroupArmLaunchRefused { causes: c } => V41GroupALaunchRefused { causes: c }
                      GroupArmLaunchPlanned { lines: ls, profile: prof, master_endpoint: e } =>
                        V41GroupALaunchPlanned { lines: ls, profile: prof, specification_runtime_key: key, manifest_text: manifest, master_endpoint: e }
                    }
                }
            }
        }
    }
  }
}

// THE V4.1 PLAN AS THE ONE PATH'S PLAN: the same lines, profile and rendezvous, less the two V4.1 facts.
// An unestablished V4.1 plan is a refusal there, naming what it waits on.
fn v41_arm_plan(p: V41GroupALaunchPlan) -> GroupArmLaunchPlan {
  match p {
    V41GroupALaunchPlanned { lines: ls, profile: prof, specification_runtime_key: _, manifest_text: _, master_endpoint: e } =>
      GroupArmLaunchPlanned { lines: ls, profile: prof, master_endpoint: e }
    V41GroupALaunchUnestablished { obligations: o } => GroupArmLaunchRefused { causes: map(o, x => join(["the plan is not established: ", x], "")) }
    V41GroupALaunchRefused { causes: c } => GroupArmLaunchRefused { causes: c }
  }
}

// ── THE UNITS AND STEPS ARE THE ONE PATH'S, UNDER V4.1'S INTENT AND NAMES ───────────────────────

fn v41_group_a_unit_renders(p: V41GroupALaunchPlan) -> List<GlmNativeUnitRender> {
  group_arm_unit_renders(intent: v41_group_a_intent, units: v41_group_a_units, p: v41_arm_plan(p: p))
}

fn v41_group_a_steps(p: V41GroupALaunchPlan) -> SparkNativeArmSteps {
  group_arm_steps(intent: v41_group_a_intent, units: v41_group_a_units, p: v41_arm_plan(p: p))
}

// THE ENGRAM STAGING RUNS BEFORE THE APPLY'S PREFLIGHT, because the preflight refuses a container whose
// mount sources are missing (gunbc.spark.native_serving_apply spark_native_mount_source_checks), and the
// manifest and receipt directories exist only once this has run.
//
// IT IS MODELLED REMOTE STEPS, NOT A SHELL BODY (review 71644). Each step is a gunbc.remote_operation
// PlannedRemoteStep: the two directories are the mkdir argv extdeps.tools.mkdir renders, and the manifest
// is a gunbc.typed_remote_file_write sealed to the manifest directory, so it lands as readback-verified
// bytes rather than as text a printf wrote. Nothing is cleared from the receipt directory: the overlay
// writes each rank's receipt by temp file and rename (write_touch_receipt), so a receipt is always a whole
// document from one SIGUSR2, and the row stores' presence is already the preflight's mount-source check.
fn v41_engram_manifest_scope() -> FileTreeScope {
  FileTreeScope { root_path: v41_engram_manifest_dir }
}

fn v41_engram_staging_steps(manifest_text: String) -> List<PlannedRemoteStep>? {
  match typed_remote_file_write_seal(
    path: v41_engram_manifest_path() as FilePath,
    content: manifest_text,
    allowed_scope: v41_engram_manifest_scope(),
  ) {
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => none
    TypedRemoteFileWriteAdmitted { write: manifest } => Present {
      value: [
        PlannedRemoteStep {
          identity: "v41-engram-manifest-dir" as NonEmptyStr,
          operation: RemoteArgv { argv: argv_words(command: mkdir_parents_command_at(mkdir_binary: mkdir_path_resolved_program, path: v41_engram_manifest_dir as String)) },
        },
        PlannedRemoteStep {
          identity: "v41-engram-touch-receipt-dir" as NonEmptyStr,
          operation: RemoteArgv { argv: argv_words(command: mkdir_parents_command_at(mkdir_binary: mkdir_path_resolved_program, path: v41_engram_touch_receipt_dir as String)) },
        },
        PlannedRemoteStep {
          identity: "v41-engram-manifest" as NonEmptyStr,
          operation: RemoteFileBytes { write: manifest, mode: RemoteFileModeOwnerReadWriteWorldRead },
        },
      ],
    }
  }
}

fn v41_engram_staging_wire(manifest_text: String) -> String {
  match v41_engram_staging_steps(manifest_text: manifest_text) {
    Absent => "REFUSED: the manifest write could not be sealed to its directory"
    Present { value: steps } => join(map(steps, st => join([st.identity as String, ": ", remote_operation_label(operation: st.operation)], "")), "\n")
  }
}

// ── ADMISSION: THE ONE PATH'S CONJUNCTS, WITH V4.1'S SUCCESSOR AND ITS OWN ───────────────────
//
// gunbc.spark.group_arm_launch group_arm_launch_admission judges the authority, the successor, the
// subject's hold and every host's occupancy. What V4.1 supplies:
//   - ITS SUCCESSOR is its candidate's key (gunbc.spark.v41_runtime_candidate V41CandidateKeyed
//     candidate), which is what D0's grant names; an unkeyed or refused candidate has no successor.
//   - ONE CONJUNCT OF ITS OWN: the produced image was admitted against a specification runtime key, and
//     that key must be the candidate's runtime_artifact key -- so an image built from another tree
//     cannot ride an authorization granted to this one.
//   - NO DECLARED INCUMBENT. A V4 pair unit still running, any GPU compute process at all, or too little
//     available memory refuses -- and is never stopped by this launch.
fn v41_successor(candidate: V41CandidateStanding) -> ArmSuccessorStanding {
  match candidate {
    V41CandidateUnestablished { obligations: o } => ArmSuccessorUnkeyed { causes: map(o, x => join(["the V4.1 candidate is not keyed: ", x as String], "")) }
    V41CandidateRefused { defects: d } => ArmSuccessorUnkeyed { causes: map(d, x => join(["the V4.1 candidate is refused: ", x as String], "")) }
    V41CandidateKeyed { runtime_artifact: _, model_source: _, engram_realization: _, execution_profile: _, candidate: c, authorization_obligation: _ } => ArmSuccessorKeyed { key: c }
  }
}

fn v41_runtime_key_causes(plan: V41GroupALaunchPlan, candidate: V41CandidateStanding) -> List<String> {
  match plan {
    V41GroupALaunchPlanned { lines: _, profile: _, specification_runtime_key: spec, manifest_text: _, master_endpoint: _ } =>
      match candidate {
        V41CandidateKeyed { runtime_artifact: runtime_key, model_source: _, engram_realization: _, execution_profile: _, candidate: _, authorization_obligation: _ } =>
          if content_hash_equal(left: spec, right: runtime_key) { [] as List<String> } else {
            [join(["the produced image was admitted against runtime key ", serialize_content_hash(hash: spec) as String, ", not the candidate's ", serialize_content_hash(hash: runtime_key) as String], "")]
          }
        V41CandidateUnestablished { obligations: _ } => [] as List<String>
        V41CandidateRefused { defects: _ } => [] as List<String>
      }
    V41GroupALaunchUnestablished { obligations: _ } => [] as List<String>
    V41GroupALaunchRefused { causes: _ } => [] as List<String>
  }
}

fn v41_group_a_launch_admission(
  plan: V41GroupALaunchPlan,
  authority: PairServingGroupAuthority?,
  candidate: V41CandidateStanding,
  held: List<HostIdentity>,
  occupancy: List<GroupArmHostOccupancy>,
) -> GroupArmLaunchAdmission {
  group_arm_launch_admission(
    group: FabricGroupA, purpose: v41_group_a_purpose, plan: v41_arm_plan(p: plan),
    authority: authority, successor: v41_successor(candidate: candidate),
    arm_causes: v41_runtime_key_causes(plan: plan, candidate: candidate),
    held: held, occupancy: occupancy, incumbent: NoIncumbentDeclared,
    grant_row: StandingGrantRowNotOnMain { cause: "V4.1 launches only under a D0 suspension for its candidate, never under the standing grant" })
}

// THE ADMISSION AGAINST THE LIVE AUTHORITY LOG, read-only, shared by the dry run and the wet entry.
fn v41_group_a_launch_admission_live(plan: V41GroupALaunchPlan, occupancy: List<GroupArmHostOccupancy>) -> GroupArmLaunchAdmission {
  let candidate = v41_candidate().standing
  group_arm_launch_admission_live(
    group: FabricGroupA, purpose: v41_group_a_purpose, plan: v41_arm_plan(p: plan),
    successor: v41_successor(candidate: candidate),
    arm_causes: v41_runtime_key_causes(plan: plan, candidate: candidate),
    occupancy: occupancy, incumbent: NoIncumbentDeclared)
}

// ── THE DRY RUN ──────────────────────────────────────────────────────────────────────────────
//
// THE ONE PATH'S REPORT, WITH V4.1'S PRE-APPLY WORK PER HOST: its Engram staging. A plan that cannot be
// made reports every obligation it is waiting on.
fn v41_group_a_dry_run_report(plan: V41GroupALaunchPlan, admission: GroupArmLaunchAdmission) -> String {
  let pre = match plan {
    V41GroupALaunchPlanned { lines: _, profile: _, specification_runtime_key: _, manifest_text: manifest, master_endpoint: _ } =>
      [ArmPreApplyWire { label: "engram staging" as NonEmptyStr, text: v41_engram_staging_wire(manifest_text: manifest) }]
    V41GroupALaunchUnestablished { obligations: _ } => [] as List<ArmPreApplyWire>
    V41GroupALaunchRefused { causes: _ } => [] as List<ArmPreApplyWire>
  }
  group_arm_dry_run_report(title: "V4.1 Group A TP4 launch", intent: v41_group_a_intent, units: v41_group_a_units, plan: v41_arm_plan(p: plan), pre_apply: pre, incumbent: NoIncumbentDeclared, admission: admission)
}

// THE DRY RUN'S INPUTS. The manifest is handed in (the entry derives it with v41_group_a_manifest, as
// the wet entry does). The held image and its registry reading are read on the hosts, and the dry run
// reaches no host, so it names both as obligations rather than transcribing either.
fn v41_group_a_live_inputs(manifest: V41EngramStoreManifest) -> V41GroupALaunchInputs {
  V41GroupALaunchInputs {
    held: V41RuntimeHeldUnestablished { obligations: ["the image is read back on every Group A host only by the wet launch (gunbc.spark.arm_group_launch_dispatch arm_group_launch_ci_wet, arm v41-group-a); the dry run reaches no host"] },
    registry_reading: none,
    manifest: manifest,
  }
}

// THE DRY PLAN: the authority log read (read-only), every host rendered, the admission verdict. The
// held image and its registry reading are obligations here (v41_group_a_live_inputs), so the report
// names the whole distance to a launch.
fn v41_group_a_dry_plan() -> ArmDryPlan {
  let plan = v41_group_a_launch_plan(inputs: v41_group_a_live_inputs(manifest: v41_group_a_manifest()))
  let admission = v41_group_a_launch_admission_live(plan: plan, occupancy: group_arm_dry_run_occupancy(group: FabricGroupA))
  ArmDryPlan { report: v41_group_a_dry_run_report(plan: plan, admission: admission), admission: admission }
}

// ── THE WET LAUNCH ───────────────────────────────────────────────────────────────────────────
//
// THE REGISTRY READING IS TAKEN INSIDE THE HELD DIGEST, BY THE PROBE THE BUILD USES. The arm wall
// (gunbc.spark.serving_arm serving_arm_admits_under) admits a runtime only on a registry reading taken
// inside its own digest, and the production image has none on main. The build's capability probe
// (gunbc.spark.v41_runtime_image_probe v41_probe_image_in_place) already prints the whole registry
// (REGISTRY_COUNT, then one REGISTERED line per architecture) from inside the digest it is handed, so
// the wet entry runs that probe on a launch host and folds its output into the reading. The fold is
// complete or nothing: the probe's identity must join the receipt's digest
// (gunbc.spark.v41_runtime_image_converge v41_probe_identity_join), the count line must be present and
// positive, and the REGISTERED lines must number exactly that count; anything else is no reading, and
// the arm wall then refuses with its own cause.
fn v41_registry_reading_of(probe: V41ProbeOutcome, image: V41ProducedImageHeld, host: HostIdentity, observed_at: String) -> ArchitectureRegistryReading? {
  match v41_probe_identity_join(produced: image.config, o: probe) {
    V41ProbeDescribesAnotherImage { produced: _, observed: _ } => none
    V41ProbeIdentityUnreadable { observed: _ } => none
    V41ProbeIdentityNotRead { step: _, cause: _ } => none
    V41ProbeJoinedToProducedImage { digest: d } =>
      match probe {
        V41ProbeRefused { step: _, cause: _ } => none
        V41ProbeRead { reference: _, observed_config_id: _, stdout: out, readings: _ } => {
          let archs = registry_dump_architectures(stdout: out)
          match registry_dump_count(stdout: out) {
            Absent => none
            Present { value: n } =>
              if n <= 0 || length(archs) != n {
                none
              } else {
                Present { value: ArchitectureRegistryReading {
                  image_reference: d,
                  host: host as NonEmptyStr,
                  observed_at: observed_at as NonEmptyStr,
                  instrument: vllm_registry_instrument,
                  architectures: archs,
                } }
              }
          }
        }
      }
  }
}

fn v41_registry_line(probe: V41ProbeOutcome, image: V41ProducedImageHeld, reading: ArchitectureRegistryReading?) -> String {
  join([
    v41_probe_identity_line(j: v41_probe_identity_join(produced: image.config, o: probe)),
    match reading {
      Present { value: r } => join(["registry reading: ", to_string(length(r.architectures)), " architectures inside ", r.image_reference as String, " on ", r.host as String, "\n"], "")
      Absent => "registry reading: NONE (the probe did not join the receipt's digest, or its REGISTRY_COUNT and REGISTERED lines did not agree)\n"
    },
  ], "")
}

// THE OCCUPANCY NEED IS THE ONE PATH'S: the measurement's gpu-memory-utilization share of a GB10's
// unified pool (gunbc.spark.group_arm_launch group_arm_memory_need). A host with less available than that
// cannot start the rank; the Engram page cache lives in the share the engine leaves, which the arm wall
// already charges.
fn v41_group_a_memory_need() -> Kibibyte {
  group_arm_memory_need(gpu_memory_utilization: v41_measurement_launch_shape().gpu_memory_utilization)
}

fn v41_host_image_read_line(r: VllmImageTargetRead) -> String {
  join(["image readback host=", r.host as String, " ", match r.state {
    VllmImageTargetHolds => "HOLDS the receipt's digest under its tag"
    VllmImageTargetNeeds => "holds NOTHING under the tag"
    VllmImageTargetRefused { step: st, cause: why } => join(["REFUSED at ", st as String, ": ", why], "")
  }, "\n"], "")
}

fn v41_host_ssh_target(host: HostIdentity) -> SshTarget? {
  match spark_reach_endpoint(host: host, path: ReachManagementLan) {
    Absent => none
    Present { value: e } => Present { value: SshTarget { endpoint: e as NonEmptyStr, principal: spark_managed_executor_login as NonEmptyStr } }
  }
}

// THE ENGRAM STAGING ON EVERY HOST, IN ORDER, HALTING AT THE FIRST HOST THAT FAILS. It runs before the
// apply because the apply's preflight refuses a container whose mount sources are missing; a failed
// staging therefore stops the launch with no serving unit touched.
type V41StagingOutcome
  = V41StagedEverywhere { receipt: String }
  | V41StagingStopped { receipt: String }

fn v41_stage_engram_on(hosts: List<HostIdentity>, manifest_text: String, context: FleetSshExecutionContext) -> V41StagingOutcome {
  match v41_engram_staging_steps(manifest_text: manifest_text) {
    Absent => V41StagingStopped { receipt: "engram staging REFUSED: the manifest write could not be sealed to its directory; no host was staged\n" }
    Present { value: steps } =>
      fold(hosts, init: V41StagedEverywhere { receipt: "" }, f: fn(acc, h) {
        match acc {
          V41StagingStopped { receipt: _ } => acc
          V41StagedEverywhere { receipt: so_far } =>
            match v41_host_ssh_target(host: h) {
              Absent => V41StagingStopped { receipt: join([so_far, "engram staging host=", h as String, " REFUSED: no management-LAN endpoint\n"], "") }
              Present { value: target } => {
                let standings = run_remote_step_sequence(steps: steps, transport: FleetSsh { target: target, context: context })
                let line = join(["engram staging host=", h as String, "\n", remote_step_sequence_wire(standings: standings)], "")
                if remote_step_sequence_failed(standings: standings) {
                  V41StagingStopped { receipt: join([so_far, line], "") }
                } else {
                  V41StagedEverywhere { receipt: join([so_far, line], "") }
                }
              }
            }
        }
      })
  }
}

// THE SESSION: everything the launch reads, then -- only on admission -- the staging and the arm
// transaction (gunbc.spark.native_serving_apply spark_native_apply_transaction, the same preflight,
// preserve, head-first apply, readback and commit-or-rollback Group B's relaunch runs). Every read is
// in the receipt whatever the verdict, so a refused run reports the whole distance to a launch.
// ── THE SM120 DECODE-SHAPE GATE: THE KERNEL IS ASKED BEFORE A 1.5-HOUR LAUNCH IS ─────────────────
//
// Attempt 13 loaded a 328 GB arm for over an hour and then died in CUDA-graph capture on every rank,
// because FlashInfer's SM120 DSv4 decode kernel had no specialization for the shapes the launch put
// through it. Whether it has one is decidable in seconds, from the image and the rank's own arguments,
// before anything is staged. So each rank's host runs the image's
// vllm.models.deepseek_v4_1.nvidia.sm120_decode_shape_selftest (the overlay member
// gunbc.spark.v41_runtime_candidate v41_sm120_decode_selftest_patch_path) over EXACTLY that rank's
// engine argv -- the words its container will hand `vllm serve`, parsed by vLLM's own serve parser --
// with the checkpoint mounted where that argv names it. The self-test calls the kernel at every shape
// with 64 or fewer query tokens a rank of that launch reaches. Any refusal, unreachable host, or a run
// that does not end in SELFTEST PASS stops the launch before the Engram staging, with the self-test's
// own lines in the receipt. It mutates nothing: a --rm container, the checkpoint read-only.
data v41_sm120_selftest_module: String = "vllm.models.deepseek_v4_1.nvidia.sm120_decode_shape_selftest"

type V41Sm120HostGate {
  passed: Bool
  receipt: String
}

fn v41_sm120_selftest_argv(l: ArmNodeLaunch, model_path: String) -> List<String> {
  concat([
    "docker", "run", "--rm", "--gpus", "all", "--entrypoint", "python3",
    "-v", join([l.host_model_path as String, ":", model_path, ":ro"], ""),
    l.image_reference as String, "-m", v41_sm120_selftest_module,
  ], l.engine_argv)
}

// THE MODEL PATH IS THE ENGINE ARGV'S FIRST WORD, as `vllm serve` takes it (model_tag), and the gate
// mounts the checkpoint there so the self-test reads the config the rank will.
fn v41_engine_model_path(l: ArmNodeLaunch) -> String? {
  let firsts = map(filter(enumerate(l.engine_argv), p => p.first == 0), p => p.second)
  if length(firsts) == 1 { Present { value: join(firsts, "") } } else { none }
}

fn v41_sm120_host_gate(ctx: SparkMaterializeContext, l: ArmNodeLaunch) -> V41Sm120HostGate {
  let host = l.node.host as String
  match v41_engine_model_path(l: l) {
    Absent => V41Sm120HostGate { passed: false, receipt: join(["sm120 self-test ", host, ": REFUSED the rank's engine argv is empty, so it names no model path to run against\n"], "") }
    Present { value: model_path } =>
      match spark_remote_run(ctx: vllm_image_target_ctx(source_ctx: ctx, host: l.node.host), argv: v41_sm120_selftest_argv(l: l, model_path: model_path)) {
        RemoteUnreachable { cause: c, reach: _ } => V41Sm120HostGate { passed: false, receipt: join(["sm120 self-test ", host, ": DID NOT RUN ", c, "\n"], "") }
        RemoteRan { exit_code: code, stdout: out, stderr: err } => {
          let passed = code == 0 && trim(s: out).ends_with(suffix: "SELFTEST PASS")
          V41Sm120HostGate {
            passed: passed,
            receipt: join([
              "sm120 self-test ", host, ": exit=", to_string(code), if passed { " PASS" } else { " FAIL" }, "\n",
              out, if passed { "" } else { join(["stderr: ", trim(s: err), "\n"], "") },
            ], ""),
          }
        }
      }
  }
}

fn v41_sm120_gate(ctx: SparkMaterializeContext, p: V41GroupALaunchPlan) -> V41Sm120HostGate {
  match p {
    V41GroupALaunchPlanned { lines: ls, profile: _, specification_runtime_key: _, manifest_text: _, master_endpoint: _ } => {
      let gates = map(ls, l => v41_sm120_host_gate(ctx: ctx, l: l))
      V41Sm120HostGate {
        passed: length(ls) != 0 && all(gates, g => g.passed),
        receipt: join(map(gates, g => g.receipt), ""),
      }
    }
    V41GroupALaunchUnestablished { obligations: _ } => V41Sm120HostGate { passed: false, receipt: "sm120 self-test: not run, the plan is unestablished\n" }
    V41GroupALaunchRefused { causes: _ } => V41Sm120HostGate { passed: false, receipt: "sm120 self-test: not run, the plan was refused\n" }
  }
}

fn v41_group_a_launch_session(now_word: String, context: FleetSshExecutionContext, ctx: SparkMaterializeContext) -> SparkBuildHostWork {
  let hosts = fabric_group_hosts(g: FabricGroupA)
  let image = v41_production_produced_image
  let subject = v41_produced_image_subject(p: image)
  let reads = map(hosts, h => vllm_image_target_read(source_ctx: ctx, host: h, image: subject))
  let held = v41_admit_held_runtime(recipe: v41_candidate_recipe(), artifact: v41_runtime_artifact_key(i: v41_candidate_inputs.runtime, partition: v41_candidate_partition), image: image, hosts: hosts, reads: reads)
  let probe = match held {
    V41RuntimeHeldOnHosts { specification_runtime_key: _, image: _, subject: _ } =>
      v41_probe_image_in_place(ctx: ctx, reference: render_oci_content_digest_wire(d: image.config) as NonEmptyStr)
    V41RuntimeHeldUnestablished { obligations: _ } => V41ProbeRefused { step: "registry-probe" as NonEmptyStr, cause: "the image is not established on every launch host, so it was not probed" }
    V41RuntimeHeldRefused { defects: _ } => V41ProbeRefused { step: "registry-probe" as NonEmptyStr, cause: "the held image was refused, so it was not probed" }
  }
  let registry = v41_registry_reading_of(probe: probe, image: image, host: ctx.host, observed_at: now_word)
  let plan = v41_group_a_launch_plan(inputs: V41GroupALaunchInputs { held: held, registry_reading: registry, manifest: v41_group_a_manifest() })
  let occupancy = group_arm_read_occupancy(ctx: ctx, hosts: hosts, units: v41_group_a_units, incumbent: NoIncumbentDeclared, need: v41_group_a_memory_need())
  let admission = v41_group_a_launch_admission_live(plan: plan, occupancy: occupancy)
  let reads_receipt = join([
    join(["image receipt run=", image.receipt_run as String, " tag=", subject.tag as String, " config_digest=", render_oci_content_digest_wire(d: image.config), "\n"], ""),
    join(map(reads, r => v41_host_image_read_line(r: r)), ""),
    v41_registry_line(probe: probe, image: image, reading: registry),
    v41_group_a_dry_run_report(plan: plan, admission: admission),
  ], "")
  match admission {
    GroupArmLaunchAdmissionRefused { causes: _ } => SparkBuildHostWork { receipt: join([reads_receipt, "NOT LAUNCHED: admission refused; no host was staged and no serving unit was touched\n"], ""), converged: false }
    GroupArmLaunchAdmittedForAdoptionOnly { hosts: _ } => SparkBuildHostWork { receipt: join([reads_receipt, "NOT LAUNCHED: V4.1 declares no incumbent, so a dangling-transaction admission cannot arise here and is refused\n"], ""), converged: false }
    GroupArmLaunchAdmitted => {
      let work = group_arm_apply_admitted(
        intent: v41_group_a_intent, units: v41_group_a_units, plan: v41_arm_plan(p: plan), incumbent: NoIncumbentDeclared,
        context: context, ctx: ctx, now_word: now_word,
        pre_apply: fn(steps) { v41_pre_apply(ctx: ctx, context: context, plan: plan, steps: steps) })
      SparkBuildHostWork { receipt: join([reads_receipt, work.receipt], ""), converged: work.converged }
    }
  }
}

// V4.1'S PRE-APPLY, IN ITS ORDER: the SM120 decode-shape self-test on every rank's host, then the Engram
// staging on every host. Either stopping leaves every host exactly as it was -- no serving unit is
// touched before both pass.
fn v41_pre_apply(ctx: SparkMaterializeContext, context: FleetSshExecutionContext, plan: V41GroupALaunchPlan, steps: List<SparkNativeHostStep>) -> ArmPreApply {
  match plan {
    V41GroupALaunchUnestablished { obligations: _ } => ArmPreApplyStopped { receipt: "NOT LAUNCHED: unreachable, an admitted plan is planned\n" }
    V41GroupALaunchRefused { causes: _ } => ArmPreApplyStopped { receipt: "NOT LAUNCHED: unreachable, an admitted plan is planned\n" }
    V41GroupALaunchPlanned { lines: _, profile: _, specification_runtime_key: _, manifest_text: manifest, master_endpoint: _ } => {
      let gate = v41_sm120_gate(ctx: ctx, p: plan)
      if !gate.passed {
        ArmPreApplyStopped { receipt: join([gate.receipt, "the SM120 decode-shape self-test did not pass on every rank's host; no host was staged\n"], "") }
      } else {
        match v41_stage_engram_on(hosts: map(steps, st => st.host), manifest_text: manifest, context: context) {
          V41StagingStopped { receipt: r } => ArmPreApplyStopped { receipt: join([gate.receipt, r, "the Engram staging stopped\n"], "") }
          V41StagedEverywhere { receipt: r } => ArmPreApplyPassed { receipt: join([gate.receipt, r], "") }
        }
      }
    }
  }
}

data v41_group_a_launch_attempt_raw: String = "v41-group-a-launch"
// THE V4.1 ARM AS A WET SESSION OF THE ONE ENTRY (gunbc.spark.group_arm_launch group_arm_launch_wet).
// The hosts are Group A's, the image is the production receipt's and the shape is the measurement's, so
// nothing an operator types changes what it launches.
fn v41_group_a_wet_session() -> ArmWetSession {
  ArmWetSession {
    title: "v41 group A launch" as NonEmptyStr,
    group: FabricGroupA,
    attempt_raw: v41_group_a_launch_attempt_raw,
    identity_file_name: "gunbc-v41-group-a-launch-admin-password" as NonEmptyStr,
    session: fn(now_word, context, ctx) { v41_group_a_launch_session(now_word: now_word, context: context, ctx: ctx) },
  }
}
