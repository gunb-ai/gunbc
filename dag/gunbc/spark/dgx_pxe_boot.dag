module gunbc.spark.dgx_pxe_boot

import std.types { NonEmptyStr, String, List, Bool }
import std.decl_ref { DeclarationRef }
import std.human_intervention {
  HumanIntervention,
  HumanInterventionIdentity,
  DeviceOnce,
  NoDischargeSiteModeled,
}
import extdeps.uri { Uri }
import extdeps.provisioning.network_boot {
  NetworkBootChain,
  DhcpBootDirection,
  NativeDhcpBootOptions,
  ProxyDhcp,
}
import extdeps.systems.nvidia_dgx_spark_pxe {
  SparkPxeBootImageKind,
  FastOsRecoveryTarball,
  DgxOsIsoImage,
  TftpBootloader,
  TftpGrubConfig,
  TftpKernelImage,
  TftpInitrdImage,
  spark_pxe_bootloader_filename,
  spark_pxe_tftp_relative_path,
  spark_pxe_http_install_image_path,
  spark_fastos_unattended_kernel_cmdline,
  spark_dgx_os_unattended_kernel_cmdline,
  spark_pxe_client_boot_mode,
  SparkPxeSecureBootPrerequisite,
  SecureBootDisabledForPxe,
  BootloaderEnrolledForPxe,
}
import extdeps.os.ubuntu_kernel_nic_coverage {
  UbuntuKernelFlavour,
  Noble2404GaLinux68,
  Noble2404HweLinux617,
  r8169_claims_pci_device,
  PciVendorId,
  PciDeviceId,
}

type PxeNetworkObservation {
  dhcp_offers_bootloader: Bool
  tftp_grub_config_reachable: Bool
  tftp_kernel_initrd_reachable: Bool
  http_install_image_reachable: Bool
  client_has_ip_address: Bool
}

type PxeNetworkIsolation
  = IsolatedProvisioningSegment
  | DedicatedNicDirectCable
  | ProxyDhcpPxeOnly
  | AdmittedRouterDhcpChange

type PxeNetworkGap
  = DhcpBootfileNotOffered
  | TftpBootChainUnreachable
  | HttpInstallImageUnreachable
  | ClientAddressUnconfigured
  | DhcpAuthorityUnobserved
  | TftpEndpointUnobserved
  | HttpEndpointUnobserved
  | DhcpIsolationUnobserved

type PxeNetworkStanding
  = PxeNetworkReady {
      dhcp_authority: DeclarationRef,
      tftp_endpoint: DeclarationRef,
      http_endpoint: DeclarationRef,
      isolation: PxeNetworkIsolation,
    }
  | PxeNetworkGapped { gaps: List<PxeNetworkGap> }
  | PxeNetworkUnobserved

fn pxe_network_reachability_gaps(observation: PxeNetworkObservation) -> List<PxeNetworkGap> {
  concat(
    if observation.dhcp_offers_bootloader { [] } else { [DhcpBootfileNotOffered] },
    concat(
      if observation.tftp_grub_config_reachable && observation.tftp_kernel_initrd_reachable {
        []
      } else {
        [TftpBootChainUnreachable]
      },
      concat(
        if observation.http_install_image_reachable { [] } else { [HttpInstallImageUnreachable] },
        if observation.client_has_ip_address { [] } else { [ClientAddressUnconfigured] },
      ),
    ),
  )
}

fn pxe_network_authority_gaps(
  dhcp_authority: DeclarationRef?,
  tftp_endpoint: DeclarationRef?,
  http_endpoint: DeclarationRef?,
  isolation: PxeNetworkIsolation?,
) -> List<PxeNetworkGap> {
  concat(
    match dhcp_authority {
      Absent => [DhcpAuthorityUnobserved]
      Present { value: _ } => []
    },
    concat(
      match tftp_endpoint {
        Absent => [TftpEndpointUnobserved]
        Present { value: _ } => []
      },
      concat(
        match http_endpoint {
          Absent => [HttpEndpointUnobserved]
          Present { value: _ } => []
        },
        match isolation {
          Absent => [DhcpIsolationUnobserved]
          Present { value: _ } => []
        },
      ),
    ),
  )
}

type PxeNetworkPresentAuthorities {
  dhcp_authority: DeclarationRef,
  tftp_endpoint: DeclarationRef,
  http_endpoint: DeclarationRef,
  isolation: PxeNetworkIsolation,
}

fn pxe_network_present_authorities(
  dhcp_authority: DeclarationRef?,
  tftp_endpoint: DeclarationRef?,
  http_endpoint: DeclarationRef?,
  isolation: PxeNetworkIsolation?,
) -> PxeNetworkPresentAuthorities? {
  match dhcp_authority {
    Absent => Absent
    Present { value: dhcp } =>
      match tftp_endpoint {
        Absent => Absent
        Present { value: tftp } =>
          match http_endpoint {
            Absent => Absent
            Present { value: http } =>
              match isolation {
                Absent => Absent
                Present { value: iso } =>
                  Present {
                    value: PxeNetworkPresentAuthorities {
                      dhcp_authority: dhcp,
                      tftp_endpoint: tftp,
                      http_endpoint: http,
                      isolation: iso,
                    }
                  }
              }
          }
      }
  }
}

fn pxe_network_isolation_dhcp_direction(isolation: PxeNetworkIsolation) -> DhcpBootDirection {
  match isolation {
    ProxyDhcpPxeOnly => ProxyDhcp
    IsolatedProvisioningSegment => NativeDhcpBootOptions
    DedicatedNicDirectCable => NativeDhcpBootOptions
    AdmittedRouterDhcpChange => NativeDhcpBootOptions
  }
}

fn pxe_network_ready_standing(
  dhcp_authority: DeclarationRef,
  tftp_endpoint: DeclarationRef,
  http_endpoint: DeclarationRef,
  isolation: PxeNetworkIsolation,
) -> PxeNetworkStanding {
  PxeNetworkReady {
    dhcp_authority: dhcp_authority,
    tftp_endpoint: tftp_endpoint,
    http_endpoint: http_endpoint,
    isolation: isolation,
  }
}

fn pxe_network_all_gaps(
  observation: PxeNetworkObservation,
  dhcp_authority: DeclarationRef?,
  tftp_endpoint: DeclarationRef?,
  http_endpoint: DeclarationRef?,
  isolation: PxeNetworkIsolation?,
) -> List<PxeNetworkGap> {
  concat(
    pxe_network_reachability_gaps(observation: observation),
    pxe_network_authority_gaps(
      dhcp_authority: dhcp_authority,
      tftp_endpoint: tftp_endpoint,
      http_endpoint: http_endpoint,
      isolation: isolation,
    ),
  )
}

fn evaluate_pxe_network_standing(
  observation: PxeNetworkObservation?,
  dhcp_authority: DeclarationRef?,
  tftp_endpoint: DeclarationRef?,
  http_endpoint: DeclarationRef?,
  isolation: PxeNetworkIsolation?,
) -> PxeNetworkStanding {
  match observation {
    Absent => PxeNetworkUnobserved
    Present { value: o } => {
      let gaps = pxe_network_all_gaps(
        observation: o,
        dhcp_authority: dhcp_authority,
        tftp_endpoint: tftp_endpoint,
        http_endpoint: http_endpoint,
        isolation: isolation,
      )
      if list_length(items: gaps) != 0 {
        PxeNetworkGapped { gaps: gaps }
      } else {
        match pxe_network_present_authorities(
          dhcp_authority: dhcp_authority,
          tftp_endpoint: tftp_endpoint,
          http_endpoint: http_endpoint,
          isolation: isolation,
        ) {
          Present { value: auth } =>
            pxe_network_ready_standing(
              dhcp_authority: auth.dhcp_authority,
              tftp_endpoint: auth.tftp_endpoint,
              http_endpoint: auth.http_endpoint,
              isolation: auth.isolation,
            )
          Absent =>
            PxeNetworkGapped {
              gaps: pxe_network_authority_gaps(
                dhcp_authority: dhcp_authority,
                tftp_endpoint: tftp_endpoint,
                http_endpoint: http_endpoint,
                isolation: isolation,
              )
            }
        }
      }
    }
  }
}

type SparkUefiPxeConfiguration {
  secure_boot: SparkPxeSecureBootPrerequisite
  network_stack_enabled: Bool
  ipv4_pxe_support_enabled: Bool
  nic_pxe_boot_enabled: Bool
}

type SparkPxeFirmwareGap
  = SecureBootBlocksPxe
  | NetworkStackDisabled
  | PxeSupportDisabled
  | NicPxeBootDisabled

// THE ENROLLED BOOTLOADER FILENAME is carried from firmware enrollment through to the
// boot plan so that the DHCP bootfile offer and the TFTP path agree with what is
// enrolled in Secure Boot. When SecureBootDisabledForPxe, this is none and the standard
// per-image bootloader path applies.
type SparkPxeFirmwareStanding
  = SparkPxeFirmwareReady {
      enrolled_bootloader: NonEmptyStr?,
    }
  | SparkPxeFirmwareHumanInterventionRequired { intervention: HumanIntervention }

fn spark_pxe_firmware_enablement_intervention() -> HumanIntervention {
  HumanIntervention {
    identity: "spark-pxe-firmware-enablement" as HumanInterventionIdentity,
    frequency: DeviceOnce,
    subject: "UEFI network stack",
    instruction: concat(
      "At this unit's console, enroll the signed bootloader that your TFTP server serves ",
      "(spark-2196 used bootaa64.efi, not the documented grubnetaa64.efi.signed — see ",
      concat(
        "dag/gunbc/spark/pxe_rescue_observation.dag for the mismatch), ",
        "then enable PXE on the chosen interface under Network Stack Configuration. ",
        "SecureBoot need not be disabled if the bootloader is signed and enrolled.",
      ),
    ),
    completion_evidence: NoDischargeSiteModeled,
  }
}

fn spark_pxe_firmware_gaps(config: SparkUefiPxeConfiguration) -> List<SparkPxeFirmwareGap> {
  concat(
    match config.secure_boot {
      SecureBootDisabledForPxe => []
      BootloaderEnrolledForPxe { bootloader: _ } =>
        // A BOOTLOADER NAME EQUALITY CHECK WAS REMOVED HERE 2026-09-05 (spark-2196
        // PXE rescue receipts). The previous code required the bootloader field to
        // equal spark_pxe_bootloader_filename ("grubnetaa64.efi.signed") and refused
        // if it did not. spark-2196 booted successfully with "bootaa64.efi" — a signed
        // EFI bootloader at a different TFTP path — proving the constraint is THAT a
        // signed bootloader is enrolled, not WHICH filename. See
        // dag/gunbc/spark/pxe_rescue_observation.dag spark_2196_pxe_bootloader_filename_observed.
        []
    },
    concat(
      if config.network_stack_enabled { [] } else { [NetworkStackDisabled] },
      concat(
        if config.ipv4_pxe_support_enabled { [] } else { [PxeSupportDisabled] },
        if config.nic_pxe_boot_enabled { [] } else { [NicPxeBootDisabled] },
      ),
    ),
  )
}

fn evaluate_spark_pxe_firmware_standing(config: SparkUefiPxeConfiguration) -> SparkPxeFirmwareStanding {
  if list_length(items: spark_pxe_firmware_gaps(config: config)) != 0 {
    SparkPxeFirmwareHumanInterventionRequired {
      intervention: spark_pxe_firmware_enablement_intervention(),
    }
  } else {
    // Extract the enrolled bootloader name when SecureBoot has a bootloader enrolled.
    // When SecureBoot is disabled there is no enrolled bootloader to carry through.
    let enrolled_bootloader: NonEmptyStr? = match config.secure_boot {
      SecureBootDisabledForPxe => none
      BootloaderEnrolledForPxe { bootloader: b } => Present { value: b }
    }
    SparkPxeFirmwareReady {
      enrolled_bootloader: enrolled_bootloader,
    }
  }
}

type SparkUnattendedImageBoot {
  image_kind: SparkPxeBootImageKind
  network_chain: NetworkBootChain
  tftp_bootloader: NonEmptyStr
  tftp_grub_config: NonEmptyStr
  tftp_kernel: NonEmptyStr
  tftp_initrd: NonEmptyStr
  http_install_image: NonEmptyStr
  kernel_cmdline: String
}

fn spark_unattended_image_boot(
  image_kind: SparkPxeBootImageKind,
  tftp_root: Uri,
  http_image_root: Uri,
  isolation: PxeNetworkIsolation,
  enrolled_bootloader: NonEmptyStr?,
) -> SparkUnattendedImageBoot {
  SparkUnattendedImageBoot {
    image_kind: image_kind,
    network_chain: NetworkBootChain {
      boot_mode: spark_pxe_client_boot_mode(tftp_root: tftp_root),
      dhcp_direction: pxe_network_isolation_dhcp_direction(isolation: isolation),
      image_http_root: http_image_root,
    },
    tftp_bootloader: match enrolled_bootloader {
      Present { value: b } => b
      Absent => spark_pxe_tftp_relative_path(p: TftpBootloader, image: image_kind)
    },
    tftp_grub_config: spark_pxe_tftp_relative_path(p: TftpGrubConfig, image: image_kind),
    tftp_kernel: spark_pxe_tftp_relative_path(p: TftpKernelImage, image: image_kind),
    tftp_initrd: spark_pxe_tftp_relative_path(p: TftpInitrdImage, image: image_kind),
    http_install_image: spark_pxe_http_install_image_path(image: image_kind),
    kernel_cmdline: match image_kind {
      FastOsRecoveryTarball => spark_fastos_unattended_kernel_cmdline(http_image_root: http_image_root)
      DgxOsIsoImage => spark_dgx_os_unattended_kernel_cmdline(http_image_root: http_image_root)
    },
  }
}

type SparkUnattendedPxeBootAdmissionOutcome
  = SparkUnattendedPxeBootAdmitted { boot: SparkUnattendedImageBoot }
  | SparkUnattendedPxeBootRefused { reason: SparkUnattendedPxeBootRefusalReason }

type SparkUnattendedPxeBootRefusalReason
  = UnattendedPxeBootNetworkStandingIncomplete { gaps: List<PxeNetworkGap> }
  | UnattendedPxeBootFirmwareHumanInterventionRequired { intervention: HumanIntervention }
  | NetworkObservationAbsent
  | FirmwareConfigurationAbsent
  | TargetNicIdentityAbsent
  // THE TARGET UNIT'S NIC IDENTITY IS UNKNOWN, so the kernel coverage check
  // (UnattendedPxeBootKernelDoesNotClaimNic) cannot be evaluated. The admission
  // must refuse rather than silently admit an image whose kernel may not claim
  // the NIC. See gunbc.spark.pxe_rescue_observation.dag Receipt 1 for the
  // spark-2196 NIC identity (10ec:8127).
  // A THIRD PARTY IMAGE WAS PREVIOUSLY REFUSED HERE VIA
  // UnattendedPxeBootImageKindNotNvidiaProvided. That arm was unreachable because
  // SparkPxeBootImageKind is a closed sum over FastOsRecoveryTarball | DgxOsIsoImage
  // — no value can inhabit a "generic-distro" constructor. The actual refusal path is
  // UnattendedPxeBootKernelDoesNotClaimNic below (the 6.8 GA kernel does not claim
  // 10ec:8127, see pxe_rescue_observation Receipt 1). Removed 2026-09-05 per
  // handoff correction from witty-seal-144; see pxe_rescue_observation Receipt 2 prose
  // for the corrected reasoning.
  | UnattendedPxeBootKernelDoesNotClaimNic {
      image_kind: SparkPxeBootImageKind,
      pci_vendor: PciVendorId,
      pci_device: PciDeviceId,
    }
  // THE BOOT IMAGE'S KERNEL DOES NOT CLAIM THE TARGET UNIT'S NIC. A PXE-booted
  // image loads and then has no network — presenting as a black screen that names
  // neither the driver nor the device ID. The kernel coverage facts are in
  // extdeps.os.ubuntu_kernel_nic_coverage; the spark-2196 NIC identity is in
  // gunbc.spark.pxe_rescue_observation.dag Receipt 1.

// KERNEL FLAVOUR MAPPING: which kernel flavour each SparkPxeBootImageKind carries.
// This is a gunbc-layer policy fact, not an upstream declaration, because the
// kernel version embedded in the image is a deployment choice rather than a
// hardware invariant. FastOsRecoveryTarball ships Ubuntu 6.8 GA; DgxOsIsoImage
// ships Ubuntu 6.17 HWE (as of base_os_7.0.0). These may change with image
// revisions without changing the SparkPxeBootImageKind enum.

fn spark_image_kernel_flavour(image_kind: SparkPxeBootImageKind) -> UbuntuKernelFlavour {
  match image_kind {
    FastOsRecoveryTarball => Noble2404GaLinux68
    DgxOsIsoImage => Noble2404HweLinux617
  }
}

fn admit_spark_unattended_pxe_boot(
  image_kind: SparkPxeBootImageKind,
  tftp_root: Uri,
  http_image_root: Uri,
  network_observation: PxeNetworkObservation?,
  dhcp_authority: DeclarationRef?,
  tftp_endpoint: DeclarationRef?,
  http_endpoint: DeclarationRef?,
  isolation: PxeNetworkIsolation?,
  firmware_config: SparkUefiPxeConfiguration?,
  target_nic: (PciVendorId, PciDeviceId)?,
) -> SparkUnattendedPxeBootAdmissionOutcome {
  // NIC COVERAGE CHECK: if the target unit's NIC identity is known, verify
  // the image's kernel can claim it. A false negative means the image will
  // boot but have no network (see pxe_rescue_observation Receipt 1).
  match target_nic {
    Present { value: (vendor, device) } =>
      if !r8169_claims_pci_device(
        flavour: spark_image_kernel_flavour(image_kind: image_kind),
        device: device,
      ) {
        return SparkUnattendedPxeBootRefused {
          reason: UnattendedPxeBootKernelDoesNotClaimNic {
            image_kind: image_kind,
            pci_vendor: vendor,
            pci_device: device,
          }
        }
      }
    Absent =>
      return SparkUnattendedPxeBootRefused {
        reason: TargetNicIdentityAbsent
      }
  }
  match network_observation {
    Absent =>
      SparkUnattendedPxeBootRefused {
        reason: NetworkObservationAbsent
      }
    Present { value: network_obs } =>
      match evaluate_pxe_network_standing(
        observation: Present { value: network_obs },
        dhcp_authority: dhcp_authority,
        tftp_endpoint: tftp_endpoint,
        http_endpoint: http_endpoint,
        isolation: isolation,
      ) {
        PxeNetworkUnobserved =>
          SparkUnattendedPxeBootRefused {
            reason: NetworkObservationAbsent
          }
        PxeNetworkGapped { gaps: network_gaps } =>
          SparkUnattendedPxeBootRefused {
            reason: UnattendedPxeBootNetworkStandingIncomplete { gaps: network_gaps }
          }
        PxeNetworkReady {
          dhcp_authority: _,
          tftp_endpoint: _,
          http_endpoint: _,
          isolation: network_isolation,
        } =>
          match firmware_config {
            Absent =>
              SparkUnattendedPxeBootRefused {
                reason: FirmwareConfigurationAbsent
              }
            Present { value: fw } =>
              match evaluate_spark_pxe_firmware_standing(config: fw) {
                SparkPxeFirmwareHumanInterventionRequired { intervention: i } =>
                  SparkUnattendedPxeBootRefused {
                    reason: UnattendedPxeBootFirmwareHumanInterventionRequired { intervention: i }
                  }
                SparkPxeFirmwareReady { enrolled_bootloader: enrolled } =>
                  SparkUnattendedPxeBootAdmitted {
                    boot: spark_unattended_image_boot(
                      image_kind: image_kind,
                      tftp_root: tftp_root,
                      http_image_root: http_image_root,
                      isolation: network_isolation,
                      enrolled_bootloader: enrolled,
                    )
                  }
              }
          }
      }
  }
}
