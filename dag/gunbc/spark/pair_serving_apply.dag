// THE FIRST APPLY OF THE RENDERED PAIR, OVER THE ADMINISTRATOR'S PASSWORD SESSION. Each host gets
// one privileged script made only of the realization's typed argv, quoted word by word: create the
// log and cache directories, pull the pinned image, copy the JIT cache out of the retiring
// container so the new engine does not spend minutes rebuilding it, recreate the container from the
// rendered spec, write the rendered unit, retire the hand-authored unit and the old container,
// and enable the new unit. The worker is applied before the head, so the head's first engine start
// finds its rank. Nothing here is decided: every line is a projection of a row in
// pair_serving_realization, and the receipt lists each host's steps with its outcome.
//
// THIS ENTRY IS THE PAIR'S FIRST CONVERGENCE, NOT ITS LAST FORM. The Ollama-shaped plan/apply loop
// in serving_converge_* still answers for the serving axis; folding this apply into the frozen-plan
// path is the cut that flips spark_serving_desired_engine, and until then this entry is the only
// actuator of the pair realization and is invoked by name, never by the fleet plan.

data spark_pair_apply_receipt_path: String = "target/spark-pair-apply-receipt.txt"
data spark_pair_apply_attempt_raw: String = "spark-pair-apply"

// The hand-authored units this apply retires, per role, as observed on the first pair.
data spark_pair_retired_head_unit: NonEmptyStr = "spark-vllm.service" as NonEmptyStr
data spark_pair_retired_worker_unit: NonEmptyStr = "spark-ray-worker.service" as NonEmptyStr

// A plain word is written as itself so the script reads as the unit's Exec line does; anything
// else is single-quoted.
fn script_word(w: String) -> String {
  if exec_word_is_plain(w: w) { w } else { shell_quote(arg: w) }
}

fn argv_line(cmd: ArgvCommand) -> String {
  join(map(concat([cmd.program as String], cmd.arguments), w => script_word(w: w)), " ")
}

fn unit_render_text(u: SparkPairUnitRender) -> String? {
  match u {
    SparkPairUnitRendered { unit_name: _, text: t } => Present { value: t }
    SparkPairUnitRenderRefused { unit_name: _, cause: _ } => none
  }
}

// ── MATERIALIZE THE WEIGHTS BEFORE THE ENGINE IS ASKED TO LOAD THEM ────────────────────────────
//
// WHY THIS STEP EXISTS AT ALL. Until now nothing in desired state put weights on a host: the
// container bind-mounts the operator's Hub cache read-only and assumes what is inside it, and
// group B's copy arrived by hand over the rail on 2026-09-05. gunbc.rung_drop
// spark_serving_local_artifact_not_reproducible has carried that gap since 2026-09-02.
//
// IT RUNS INSIDE THE CONTAINER, WHICH IS A MEASURED FACT AND NOT A STYLE CHOICE. There is no `hf` on
// any Spark host -- checked on all four members of the serving group -- while the container carries
// `/opt/env/bin/hf` with huggingface_hub 1.16.4, and it already mounts the cache the weights belong
// in. Installing a second copy of the CLI on the hosts to avoid `docker exec` would be a parallel
// authority for the same transport.
//
// IT IS ORDERED AHEAD OF THE UNIT WRITE AND THE RESTART, and `set -e` above makes that ordering
// load-bearing: a member whose weights did not land never gets its engine bounced, so a failed
// acquisition leaves the PREVIOUS engine running rather than restarting one onto a missing
// snapshot. That is the difference between a refused convergence and an outage.
//
// THE SEED FETCHES FROM UPSTREAM AND EVERY OTHER MEMBER PULLS FROM THE RAIL. The source list is the
// acquisition module's, in its order, so this script does not decide the transport -- it renders
// whatever that authority hands it, first source first, falling through on failure. The fallback is
// to a WORKING path (the radio) rather than to a widened answer, and the receipt names which source
// answered.
fn spark_pair_materialize_lines(sources: List<AcquisitionSource>, install_path: NonEmptyStr) -> String {
  let ctr = spark_pair_container_name as String
  join(concat(concat([
    "if [ -d ", shell_quote(arg: install_path as String), " ]; then echo weights-present; else\n",
  ],
    map(sources, src => join([
      "  if [ ! -d ", shell_quote(arg: install_path as String), " ]; then\n",
      "    echo materialize-attempt ", shell_quote(arg: src.identity as String), "\n",
      "    docker exec ", ctr, " ", src.locator as String, " || echo materialize-source-failed ", shell_quote(arg: src.identity as String), "\n",
      "  fi\n",
    ], ""))),
    [
    "  if [ ! -d ", shell_quote(arg: install_path as String), " ]; then echo materialize-refused; exit 1; fi\n",
    "fi\n",
  ]), "")
}

// A MEMBER'S ROLE IS ITS OWN, NOT ITS GROUP'S. The fleet seeds from ONE member across both groups
// (they share a single rail /24, measured), so this asks the acquisition authority what this host is
// rather than deciding from head-versus-worker. A host whose rail address is unresolved is handled
// there, by falling back to upstream rather than replicating from an address nobody resolved.
fn spark_pair_member_role(host: HostIdentity) -> ModelSnapshotRole {
  model_snapshot_role_for(member_rail: fabric_rail_address(host: host))
}

// A MEMBER WITH NO PINNED SNAPSHOT EMITS NO MATERIALIZE STEP AND THE PLAN REFUSES ELSEWHERE, rather
// than emitting a step that would compose a path out of a branch name.
fn spark_pair_materialize_for(role: ModelSnapshotRole) -> String {
  match model_snapshot_install_path(snapshot: glm_5_3_flash_snapshot) {
    Absent => ""
    Present { value: p } =>
      spark_pair_materialize_lines(
        sources: model_snapshot_sources_for(role: role, snapshot: glm_5_3_flash_snapshot, cache_root: spark_hub_cache_root),
        install_path: p,
      )
  }
}

// The privileged script for one host of the pair. THE RESTART IS CONDITIONAL: the unit is bounced
// only when its rendered text changed or it is not active, so re-applying a converged roster leaves
// a serving group's engine alone instead of paying its model load again.
fn spark_pair_host_apply_script(real: SparkPairHostRealization, role: ModelSnapshotRole, unit_name: NonEmptyStr, unit_text: String, retired_unit: NonEmptyStr) -> String {
  let ctr = spark_pair_container_name as String
  let old = first_pair_container_runtime.container_name as String
  let cache = spark_pair_jit_cache_host_dir as String
  join([
    "set -e\n",
    "install -d -m 755 /var/log/gunbc\n",
    "install -d -m 755 ", cache, "\n",
    "install -d -m 755 ", spark_pair_runtime_build_dir as String, "\n",
    "printf '%s' ", shell_quote(arg: gunbc_spark_pair_runtime_dockerfile()), " > ", spark_pair_runtime_build_dir as String, "/Dockerfile\n",
    "if docker container inspect ", old, " >/dev/null 2>&1; then docker cp ", old, ":/cache/huggingface/. ", cache, "/ 2>/dev/null || true; fi\n",
    spark_pair_materialize_for(role: role),
    "printf '%s' ", shell_quote(arg: unit_text), " > /etc/systemd/system/", unit_name as String, ".next\n",
    "if cmp -s /etc/systemd/system/", unit_name as String, ".next /etc/systemd/system/", unit_name as String, "; then changed=0; else changed=1; fi\n",
    "mv -f /etc/systemd/system/", unit_name as String, ".next /etc/systemd/system/", unit_name as String, "\n",
    "systemctl daemon-reload\n",
    "systemctl disable --now ", retired_unit as String, " >/dev/null 2>&1 || true\n",
    "if docker container inspect ", old, " >/dev/null 2>&1; then docker update --restart=no ", old, " >/dev/null; docker stop ", old, " >/dev/null 2>&1 || true; fi\n",
    "systemctl enable ", unit_name as String, " >/dev/null 2>&1\n",
    "if [ \"$changed\" = 1 ] || ! systemctl is-active --quiet ", unit_name as String, "; then systemctl restart ", unit_name as String, "; echo restarted; else echo unchanged; fi\n",
    "systemctl is-active ", unit_name as String, "\n",
  ], "")
}

type SparkPairHostApplyPlan {
  host: HostIdentity
  unit_name: NonEmptyStr
  script: String
}

type SparkPairApplyPlan
  = SparkPairApplyPlanned { workers: List<SparkPairHostApplyPlan>, head: SparkPairHostApplyPlan }
  | SparkPairApplyRefused { cause: String }

fn spark_pair_worker_plan(w: SparkPairHostRealization, role: ModelSnapshotRole) -> SparkPairHostApplyPlan? {
  match unit_render_text(u: w.unit) {
    Absent => none
    Present { value: text } => Present { value: SparkPairHostApplyPlan {
      host: w.host, unit_name: spark_pair_worker_unit_name,
      script: spark_pair_host_apply_script(real: w, role: role, unit_name: spark_pair_worker_unit_name, unit_text: text, retired_unit: spark_pair_retired_worker_unit),
    } }
  }
}

fn spark_pair_apply_plan(r: SparkPairRealization) -> SparkPairApplyPlan {
  match r {
    SparkPairRealizationRefused { group: _, cause: c } => SparkPairApplyRefused { cause: c as String }
    SparkPairRealized { group: _, head: h, workers: ws } =>
      match unit_render_text(u: h.unit) {
        Absent => SparkPairApplyRefused { cause: "the head unit did not render" }
        Present { value: head_text } => {
          let worker_plans = flat_map(ws, w => match spark_pair_worker_plan(w: w, role: spark_pair_member_role(host: w.host)) { Present { value: p } => [p]  Absent => [] as List<SparkPairHostApplyPlan> })
          if length(worker_plans) != length(ws) {
            SparkPairApplyRefused { cause: "a worker unit did not render" }
          } else {
            SparkPairApplyPlanned {
              workers: worker_plans,
              head: SparkPairHostApplyPlan {
                host: h.host, unit_name: spark_pair_head_unit_name,
                script: spark_pair_host_apply_script(real: h, role: spark_pair_member_role(host: h.host), unit_name: spark_pair_head_unit_name, unit_text: head_text, retired_unit: spark_pair_retired_head_unit),
              },
            }
          }
        }
      }
  }
}

// EVERY PROMOTED GROUP IS PLANNED, IN ROSTER ORDER. One refusal anywhere refuses the whole apply:
// a converge that brought up group A while silently skipping group B would report success for a
// desired state it did not reach.
fn spark_pair_apply_plans() -> List<SparkPairApplyPlan> {
  map(spark_pair_realizations(), r => spark_pair_apply_plan(r: r))
}

fn spark_pair_apply_plan_refusals(plans: List<SparkPairApplyPlan>) -> List<String> {
  flat_map(plans, p => match p {
    SparkPairApplyRefused { cause: c } => [c]
    SparkPairApplyPlanned { workers: _, head: _ } => [] as List<String>
  })
}

type SparkPairHostApplyOutcome
  = SparkPairHostApplied { host: HostIdentity, detail: String }
  | SparkPairHostApplyFailed { host: HostIdentity, cause: String }

fn spark_pair_host_apply_outcome_line(o: SparkPairHostApplyOutcome) -> String {
  match o {
    SparkPairHostApplied { host: h, detail: d } => join(["  ", h as String, "  applied  ", d], "")
    SparkPairHostApplyFailed { host: h, cause: c } => join(["  ", h as String, "  FAILED  ", c], "")
  }
}

fn spark_pair_host_applied(o: SparkPairHostApplyOutcome) -> Bool {
  match o {
    SparkPairHostApplied { host: _, detail: _ } => true
    SparkPairHostApplyFailed { host: _, cause: _ } => false
  }
}

fn spark_pair_apply_receipt_body(at: String, executor: String, path: SparkReachPath, outcomes: List<SparkPairHostApplyOutcome>) -> String {
  join([
    "spark pair serving apply at=", at, " executor=", executor, " reach=", spark_reach_path_wire(p: path), "\n",
    join(map(outcomes, o => join([spark_pair_host_apply_outcome_line(o: o), "\n"], "")), ""),
  ], "")
}

fn spark_pair_apply_all_applied(outcomes: List<SparkPairHostApplyOutcome>) -> Bool {
  all(outcomes, o => spark_pair_host_applied(o: o))
}

fn spark_pair_privileged_leg(trust: FleetOpenSshTrustPolicy, path: SparkReachPath, plan: SparkPairHostApplyPlan, admin_credential: Secret, admin_credential_file: NonEmptyStr) -> SparkPairHostApplyOutcome {
  match portable_remote_words(raws: ["sudo", "-S", "sh", "-s"]) {
    Absent => SparkPairHostApplyFailed { host: plan.host, cause: "the privileged invocation is not expressible as portable remote words" }
    Present { value: words } =>
      match spark_reach_endpoint(host: plan.host, path: path) {
        Absent => SparkPairHostApplyFailed { host: plan.host, cause: join(["no ", spark_reach_path_wire(p: path), " endpoint: the host has no fabric lane"], "") }
        Present { value: endpoint } => {
          let r = password_file_ssh_exec_portable_words_with_stdin(
            password_file: admin_credential_file,
            client_args: shape_fleet_ssh_password_exec_trusting(
              trust: trust,
              target: SshTarget {
                endpoint: endpoint as NonEmptyStr,
                principal: spark_operator_bootstrap_login as NonEmptyStr,
              },
              words: words,
            ),
            stdin_payload: join([admin_credential as String, "\n", plan.script, "\n"], ""),
          )
          if r.success {
            SparkPairHostApplied { host: plan.host, detail: join([spark_reach_path_wire(p: path), " ", trim(s: r.stdout)], "") }
          } else {
            SparkPairHostApplyFailed { host: plan.host, cause: join([spark_reach_path_wire(p: path), " exit=", to_string(r.exit_code), " stderr=", trim(s: r.stderr)], "") }
          }
        }
      }
  }
}

func spark_pair_serving_apply_wet() -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  let plans = spark_pair_apply_plans()
  let refusals = spark_pair_apply_plan_refusals(plans: plans)
  if length(plans) == 0 {
    exit_failure(reason: "spark_pair_serving_apply: no group is promoted to pair serving")
  } else if length(refusals) != 0 {
    exit_failure(reason: join(["spark_pair_serving_apply: a group realization refused: ", join(refusals, "; ")], ""))
  } else {
    match observe_executor_reach() {
      ExecutorReachUnknown { cause: c } => exit_failure(reason: join(["spark_pair_serving_apply: ", c], ""))
      ExecutorReachKnown { short_hostname: executor, path: path } =>
          match read_bootstrap_credential() {
            BootstrapCredentialNotMaterialized { cause: c } => exit_failure(reason: c as String)
            BootstrapCredentialReady { secret: administrator } =>
              match fleet_ssh_attempt_identity(raw: spark_pair_apply_attempt_raw) {
                Absent => exit_failure(reason: "attempt identity is not a safe path segment")
                Present { value: attempt } => {
                  let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
                  match fleet_openssh_trust_policy_of(outcome: materialization) {
                    Absent => exit_failure(reason: join(["trust could not be established, so no leg ran: ", known_hosts_materialization_receipt(outcome: materialization)], ""))
                    Present { value: trust } =>
                      match with_materialized_ssh_key_file(
                        identity_file_name: "gunbc-spark-pair-apply-admin-password" as NonEmptyStr,
                        secret_bytes: administrator as Secret,
                        use: fn(file) {
                          flat_map(plans, gp => match gp {
                            SparkPairApplyRefused { cause: _ } => [] as List<SparkPairHostApplyOutcome>
                            SparkPairApplyPlanned { workers: wps, head: hp } => {
                              let ws = map(wps, p => spark_pair_privileged_leg(trust: trust, path: path, plan: p, admin_credential: administrator as Secret, admin_credential_file: file))
                              let h = if spark_pair_apply_all_applied(outcomes: ws) {
                                spark_pair_privileged_leg(trust: trust, path: path, plan: hp, admin_credential: administrator as Secret, admin_credential_file: file)
                              } else {
                                SparkPairHostApplyFailed { host: hp.host, cause: "not attempted: a worker apply failed" }
                              }
                              concat(ws, [h])
                            }
                          })
                        },
                      ) {
                        MaterializedSshKeyFileBracketRefused { cause: c } => exit_failure(reason: c as String)
                        MaterializedSshKeyFileBracketCompleted { value: outcomes } => {
                          let body = spark_pair_apply_receipt_body(at: probed_at_word(reading: now) as String, executor: executor, path: path, outcomes: outcomes)
                          let wr = Filesystem.Write(path: spark_pair_apply_receipt_path, content: body)
                          if !wr.success {
                            exit_failure(reason: join(["spark pair apply receipt write failed: ", wr.error], ""))
                          } else if spark_pair_apply_all_applied(outcomes: outcomes) {
                            ExitSuccess
                          } else {
                            exit_failure(reason: join(["spark pair serving apply did not converge:\n", body], ""))
                          }
                        }
                      }
                  }
                }
              }
          }
    }
  }
}
