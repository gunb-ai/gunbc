module gunbc.spark.group_image_produce

import std.types { String, NonEmptyStr }
import std.measure { Second, second }
import product.placement_supply { HostIdentity, host_identity_eq }
import extdeps.container.oci.digest { render_oci_content_digest_wire }
import gunbc.spark.host_effect_quiescence { HostEffectResidueSpec }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import v2.std.optional { Present, Absent }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.clock_read { clock_now_probed_at, probed_at_word }
import gunbc.fleet_known_hosts_anchor { FleetSshExecutionContext, SshTarget }
import gunbc.fleet_multi_principal_probe { spark_converge_target_selection, SparkConvergeTargetSingle, SparkConvergeTargetAllObserveOnly, SparkConvergeTargetRefused }
import gunbc.spark.fabric_switch_observed { FabricGroup }
import gunbc.spark.serving_subject { PairServingUnitOn }
import gunbc.spark.host_occupancy_admission { admit_spark_host_unoccupied, spark_ctx_argv_run }
import gunbc.spark.host_commitment { HostEffectClaimLanded, HostEffectClaimNotLanded, admit_host_held_by_subject, claim_host_effect_live, release_host_effect_live }
import gunbc.spark.model_snapshot_materialize { SparkMaterializeContext }
import gunbc.spark.vllm_runtime_image_build { SparkBuildHostWork, with_spark_build_host, SparkBuildHostRefused, SparkBuildHostRan, VllmImageDistributionSubject, distribute_vllm_image, vllm_image_distribution_wire, vllm_image_distribution_succeeded, vllm_image_transfer_tar_path, vllm_build_host_effect_term, vllm_build_host_purpose, vllm_build_host_residue, vllm_build_host_memory_need }

// ── ONE ENTRY FOR PRODUCING A RUNTIME IMAGE ON A FABRIC GROUP'S HOST (deforking cut 8c) ─────────
//
// gunbc.spark.v41_runtime_image_converge v41_runtime_image_produce_ci_wet was this body with V4.1's build
// inlined, and the GLM kvplan image needs exactly the same entry: the session host named by
// SPARK_CONVERGE_TARGET (unset refuses -- a build occupies one host for hours), admitted because the
// group's serving subject HOLDS it (gunbc.spark.host_commitment admit_host_held_by_subject; the unplaced
// relation refuses every Group A host by design), the host-effect claim of a source build so two builds
// never share a box, the occupancy admission, the privileged session, and the receipt. What differs
// between images is only the work done inside the session, so that is the one parameter.
type GroupImageProduction {
  title: NonEmptyStr
  group: FabricGroup
  attempt_raw: String
  identity_file_name: NonEmptyStr
  produce: fn(SshTarget, FleetSshExecutionContext, SparkMaterializeContext) -> SparkBuildHostWork
}

fn group_image_produce_wet(p: GroupImageProduction, receipt_path: String) -> ProcessExit
{
  let now = clock_now_probed_at()
  match spark_converge_target_selection(execute_apply: true) {
    SparkConvergeTargetRefused { reason: why } => exit_failure(reason: why)
    SparkConvergeTargetAllObserveOnly =>
      exit_failure(reason: "SPARK_CONVERGE_TARGET is unset: producing an image occupies one host for hours, so it refuses rather than choosing one")
    SparkConvergeTargetSingle { host: build_host } =>
      match admit_host_held_by_subject(raw: build_host, subject: PairServingUnitOn { group: p.group }) {
        Present { value: why } => exit_failure(reason: why)
        Absent =>
          match claim_host_effect_live(host: build_host, term: vllm_build_host_effect_term, purpose: vllm_build_host_purpose, residue: vllm_build_host_residue()) {
            HostEffectClaimNotLanded { cause: why } => exit_failure(reason: why as String)
            HostEffectClaimLanded { handle: handle } =>
              release_host_effect_live(handle: Present { value: handle }, exit: {
                match with_spark_build_host(
                  host: build_host,
                  attempt_raw: p.attempt_raw,
                  identity_file_name: p.identity_file_name,
                  use: fn(target, context, ctx) {
                    match admit_spark_host_unoccupied(run: spark_ctx_argv_run(ctx: ctx), host: build_host, purpose: vllm_build_host_purpose, need: vllm_build_host_memory_need) {
                      Present { value: why } => SparkBuildHostWork { receipt: join(["refused-before-run: ", why, "\n"], ""), converged: false }
                      Absent => p.produce(target, context, ctx)
                    }
                  },
                ) {
                  SparkBuildHostRefused { cause: c } => exit_failure(reason: c)
                  SparkBuildHostRan { work: work, endpoint: endpoint, executor: executor, trust_receipt: trust_receipt } => {
                    let body = join([
                      join([p.title as String, " probed_at=", probed_at_word(reading: now) as String, " host=", build_host as String, " endpoint=", endpoint as String, " executor=", executor, "\n"], ""),
                      trust_receipt,
                      work.receipt,
                    ], "")
                    let w = Filesystem.Write(path: receipt_path, content: body)
                    if !w.success {
                      exit_failure(reason: join([p.title as String, " receipt write failed: ", w.error], ""))
                    } else if work.converged {
                      ExitSuccess
                    } else {
                      exit_failure(reason: join([p.title as String, " was not produced:\n", body], ""))
                    }
                  }
                }})
          }
      }
  }
}

// ── ONE ENTRY FOR DISTRIBUTING A PRODUCED IMAGE TO ANOTHER HOST OF ITS GROUP (deforking cut 8c) ──────
//
// gunbc.spark.v41_runtime_image_converge v41_runtime_image_distribute_ci_wet with V4.1's row inlined;
// generalized because every produced image moves the same way: the subject is the PRODUCTION RECEIPT
// (tag and configuration digest, the host that answered, the run that produced it), never a tag
// typed at dispatch; SPARK_CONVERGE_TARGET names the target; both hosts are admitted because the
// group's subject holds them and both are claimed, because both carry the effect; the transport is
// gunbc.spark.vllm_runtime_image_build distribute_vllm_image (save, rail pull, load, readback by
// digest).
type ProducedImageHeld {
  title: NonEmptyStr
  group: FabricGroup
  subject: VllmImageDistributionSubject
  held_on: HostIdentity
  receipt_run: NonEmptyStr
}

data image_distribution_host_purpose: NonEmptyStr = "a runtime image distribution, which saves or loads the produced image through a digest-named staging tar" as NonEmptyStr
data image_distribution_host_effect_term: Second = second(count: 7200)

fn image_distribution_residue(h: ProducedImageHeld) -> HostEffectResidueSpec {
  HostEffectResidueSpec { process_pattern: vllm_image_transfer_tar_path(config: h.subject.config), container: none }
}

fn with_image_distribution_claim(host: HostIdentity, h: ProducedImageHeld, run: fn() -> ProcessExit) -> ProcessExit {
  match claim_host_effect_live(host: host, term: image_distribution_host_effect_term, purpose: image_distribution_host_purpose, residue: image_distribution_residue(h: h)) {
    HostEffectClaimNotLanded { cause: why } => exit_failure(reason: why as String)
    HostEffectClaimLanded { handle: handle } => release_host_effect_live(handle: Present { value: handle }, exit: run())
  }
}

fn produced_image_distribute_to(target_host: HostIdentity, h: ProducedImageHeld, receipt_path: String) -> ProcessExit {
  let now = clock_now_probed_at()
  match with_spark_build_host(
    host: h.held_on,
    attempt_raw: "runtime-image-distribute",
    identity_file_name: "gunbc-runtime-image-distribute-admin-password" as NonEmptyStr,
    use: fn(target, context, ctx) {
      let dist = distribute_vllm_image(source_ctx: ctx, image: h.subject, targets: [target_host])
      SparkBuildHostWork { receipt: vllm_image_distribution_wire(dist: dist), converged: vllm_image_distribution_succeeded(dist: dist) }
    },
  ) {
    SparkBuildHostRefused { cause: c } => exit_failure(reason: c)
    SparkBuildHostRan { work: work, endpoint: endpoint, executor: executor, trust_receipt: trust_receipt } => {
      let body = join([
        join([h.title as String, " distribute probed_at=", probed_at_word(reading: now) as String, " source=", h.held_on as String, " endpoint=", endpoint as String, " target=", target_host as String, " executor=", executor, "\n"], ""),
        trust_receipt,
        join(["image tag=", h.subject.tag as String, " config_digest=", render_oci_content_digest_wire(d: h.subject.config), " receipt_run=", h.receipt_run as String, "\n"], ""),
        work.receipt,
      ], "")
      let w = Filesystem.Write(path: receipt_path, content: body)
      if !w.success {
        exit_failure(reason: join([h.title as String, " distribute receipt write failed: ", w.error], ""))
      } else if work.converged {
        ExitSuccess
      } else {
        exit_failure(reason: join([h.title as String, " was not verified on the target:\n", body], ""))
      }
    }
  }
}

fn produced_image_distribute_wet(h: ProducedImageHeld, receipt_path: String) -> ProcessExit
{
  match spark_converge_target_selection(execute_apply: true) {
    SparkConvergeTargetRefused { reason: why } => exit_failure(reason: why)
    SparkConvergeTargetAllObserveOnly =>
      exit_failure(reason: "SPARK_CONVERGE_TARGET is unset: distributing an image writes tens of gigabytes to the host it names, so it refuses rather than choosing one")
    SparkConvergeTargetSingle { host: target_host } =>
      match admit_host_held_by_subject(raw: h.held_on, subject: PairServingUnitOn { group: h.group }) {
        Present { value: why } => exit_failure(reason: why)
        Absent =>
          match admit_host_held_by_subject(raw: target_host, subject: PairServingUnitOn { group: h.group }) {
            Present { value: why } => exit_failure(reason: why)
            Absent =>
              with_image_distribution_claim(host: h.held_on, h: h, run: fn() {
                if host_identity_eq(a: target_host, b: h.held_on) {
                  produced_image_distribute_to(target_host: target_host, h: h, receipt_path: receipt_path)
                } else {
                  with_image_distribution_claim(host: target_host, h: h, run: fn() { produced_image_distribute_to(target_host: target_host, h: h, receipt_path: receipt_path) })
                }
              })
          }
      }
  }
}
