module gunbc.spark.oobe_screen_observation

import std.types { NonEmptyStr, Bool, List, HttpStatus }
import extdeps.uri { Uri, Http }
import extdeps.time.rfc3339 { Rfc3339Timestamp }
import extdeps.browser.chromium { ChromiumBuild, chromium_151_0_7922_34 }
import extdeps.automation.playwright {
  PlaywrightBuild,
  PlaywrightBrowserBinaryProvenance,
  PlaywrightManagedChromiumDownload,
  playwright_1_62_1,
}
import extdeps.systems.nvidia_dgx_spark_setup {
  OobeSetupField,
  OobeLanguage,
  OobeTimeZone,
  OobeKeyboardLayout,
  OobeTermsAndConditions,
  OobeUserAccount,
  OobeAnalytics,
  OobeWirelessNetwork,
  OobeHostnameAssignment,
  dgx_spark_oobe_offers_field,
}

// SPARK-OOBE-OBSERVE-0 (2026-09-02). WHAT THIS REPOSITORY ACTUALLY WATCHED THE FIRST-BOOT
// WIZARD DO, as opposed to what NVIDIA's documentation says it does.
//
// THE LAYER BOUNDARY IS THE WHOLE REASON THIS MODULE EXISTS SEPARATELY FROM
// extdeps.systems.nvidia_dgx_spark_setup. That module owns the vendor's DOCUMENTED setup
// surface and is cited to docs.nvidia.com. Everything here is a RECEIPT PRODUCED BY US by
// driving one physical unit, and DESIGN section 3 (external upstream decomposition) is
// explicit that observations produced by this repository are receipts in the observing
// layer, never facts authored into the observed upstream's module. Writing an observed
// screen into the extdeps module would make our measurement masquerade as vendor
// documentation, and the next reader could not tell which claims NVIDIA stands behind.
//
// THE OBSERVED SUBJECT IS ONE UNIT AT ONE MOMENT, and every row below is scoped to that.
// A second unit, a firmware revision, or a different regional image may present a
// different wizard; this module claims nothing about them.

// ------------------------------------------------------------------------------------------
// THE ELEMENT ADDRESS.
//
// The wizard is an NVIDIA design-system SPA and every control it renders carries a
// data-testid. That is the ADDRESS WE OBSERVED, so it is what this model names -- a CSS path
// or an nth-child index would be a second, positional naming scheme for something the
// document already names, and it decays the moment NVIDIA reflows the layout (the same
// objection DESIGN section 3's standing rule makes against file:line citations).
//
// TestIdAddress is NOT a claim that the testid is a stable NVIDIA contract. It is a claim
// about what we saw. If a future image renames these, the witness that reads this model goes
// red at the address, which is the loud failure we want, rather than a silent mis-click.
// ------------------------------------------------------------------------------------------

type TestId = NonEmptyStr where brand("TestId")
type PlaceholderText = NonEmptyStr where brand("PlaceholderText")
type FormFieldName = NonEmptyStr where brand("FormFieldName")
type ControlLabel = NonEmptyStr where brand("ControlLabel")

// ------------------------------------------------------------------------------------------
// THE CONTROLS ON A SCREEN.
//
// Decomposed rather than carried as one "control: String" leaf (DESIGN section 2, deep
// direction): a submit button, a combobox over a hidden field, and a bare hidden field are
// three different things to an automation that has to DRIVE them, and collapsing them into a
// tag name would push that distinction back onto the driver as a guess.
//
// HiddenBackingField is modeled because it is the thing that actually carries the answer.
// The screen-02 comboboxes are presentation over hidden inputs named language / timezone /
// locale; a driver that types into the visible box without the hidden field updating has
// filled in nothing, and that failure is silent. Naming both halves is what lets a witness
// assert the committed value rather than the typed one.
// ------------------------------------------------------------------------------------------

// THE ADDRESS IS NOT THE IDENTITY, and conflating them was a real defect in the first
// revision of this module. Every forward control on every screen carries the SAME observed
// data-testid, "nv-button": it is a component address issued by NVIDIA's design system, scoped
// by route and label, and it is emphatically not the identity of "Get Started" versus
// "Continue" versus "Accept". A model that treated the testid as the identity would name three
// different actions with one word -- the §3 meaning fork, where one spelling carries materially
// different obligations.
//
// So identity is declared here and the observed address is carried BESIDE it. An actuator
// resolves an identity to a route-scoped address; it never resolves a bare testid, because a
// bare testid does not distinguish the three.
//
// NOTHING HERE CLAIMS NVIDIA PUBLISHES A SELECTOR CONTRACT. These are addresses this repository
// OBSERVED on one image. If a later image renames them the model goes red at the address, which
// is the loud failure wanted, rather than a silent mis-click on whatever else answers.
// WHAT THE FORM ACTUALLY SUBMITS, and the finding that most changes what an actuator may do.
//
// The hidden fields were read directly on the live portal: language carries "25", timezone
// carries "593", and locale carries "en-US". The first two are OPAQUE VENDOR INDICES -- ordinal
// positions in NVIDIA's own list -- not identifiers. The wizard does not accept
// "America/New_York"; there is no field in which that string could be written.
//
// The consequence is structural and an earlier revision of this module implied the opposite. An
// actuator CANNOT set a zone by writing its identifier: it must drive the visible combobox by
// its displayed label and let the application compute the index. And because the index is an
// ordinal into a vendor-controlled list, it is not stable across images the way an IANA
// identifier is -- recording 593 as though it meant a zone would be recording a position as a
// name, which is the positional-citation failure §3 names, in data rather than in a comment.
//
// VendorOpaqueOrdinal therefore deliberately carries NO value. Nothing downstream should be
// able to read one and believe it has learned a zone.
type SubmittedValueRepresentation
  = VendorOpaqueOrdinal
  | Bcp47LanguageTagValue

type OobeControlIdentity
  = WelcomeGetStartedAction
  | SettingsContinueAction
  | EulaAcceptAction
  | AccountContinueAction

// THE ACCOUNT SCREEN MAKES THE ADDRESS-IS-NOT-IDENTITY POINT TWICE, and the second time is
// sharper than the first. Every forward control shares the testid "nv-button", which
// route-scoping resolves. But the account screen's THREE text inputs all share the testid
// "nv-text-input-element" ON ONE ROUTE, so route-scoping does not resolve them at all. The only
// observed discriminator is the form field NAME -- username, password, confirmPassword -- which
// is also the name the submitted form carries. An actuator that resolved "the text input" on
// this screen would fill whichever one the DOM happened to order first, and typing a password
// into the username box fails in the most expensive possible way: it succeeds, and the
// credential is stored in cleartext under a different field.
type EntrySecrecy
  = PlainTextEntry
  | MaskedSecretEntry

type FieldRequiredness
  = RequiredField
  | OptionalField

type OobeControl
  = AdvanceButton {
      identity: OobeControlIdentity,
      address: TestId,
      label: ControlLabel,
    }
  | SubmitButton {
      identity: OobeControlIdentity,
      address: TestId,
      label: ControlLabel,
    }
  | ComboBoxOverHiddenField {
      placeholder: PlaceholderText,
      backing_field: FormFieldName,
      submitted_representation: SubmittedValueRepresentation,
    }
  | HiddenBackingField {
      field: FormFieldName,
      submitted_representation: SubmittedValueRepresentation,
    }
  | TextEntryField {
      address: TestId,
      field: FormFieldName,
      placeholder: PlaceholderText,
      secrecy: EntrySecrecy,
      requiredness: FieldRequiredness,
    }

// ------------------------------------------------------------------------------------------
// THE ADVANCE GATE -- the finding that most justifies having driven a real device.
//
// A screen's forward control is not always live when the screen arrives. On the EULA screen
// the single Accept button is rendered disabled, and it becomes enabled only after the terms
// pane is scrolled to its end. We did not infer this from the markup: we measured the button
// disabled on arrival, scrolled the one scrollable container on the page, and measured it
// enabled afterwards.
//
// THIS IS MODELED AS A PRECONDITION ON THE SCREEN RATHER THAN AS A STEP IN THE DRIVER because
// it is a fact about the screen, not a preference of whoever automates it. A driver that
// clicks a disabled button observes nothing and moves nowhere, and Playwright's auto-waiting
// would sit on that button until it timed out -- a hang whose cause is nowhere in the log.
// Carrying the gate structurally means an author cannot write a screen transition that skips
// it; the constructor demands the container.
//
// THE ACCOUNT SCREEN CARRIES A THIRD GATE SHAPE, and it is the one an automation is most likely
// to mis-handle. Its Continue button is also disabled on arrival, but no scroll releases it:
// it becomes enabled only when the field values themselves validate. That is a gate whose
// precondition is the DATA, not a gesture, so it cannot be discharged by an action the driver
// takes -- only by values the driver supplies. A driver written against the scroll gate would
// scroll a page with nothing to scroll and then click a control that is still dead.
//
// The rules below were measured by supplying values and reading the control's enablement after
// each, not read off the markup. Each carries the exact message the screen rendered, because
// the message is the evidence: a rule with no observed message would be an inference about what
// the client checks.
type ObservedValidationMessage = NonEmptyStr where brand("ObservedValidationMessage")

type ObservedFieldValidationRule
  = FieldRequiredNonEmpty {
      field: FormFieldName,
      message: ObservedValidationMessage,
    }
  | FieldMinimumLength {
      field: FormFieldName,
      minimum: Int,
      message: ObservedValidationMessage,
    }
  | FieldMustEqual {
      field: FormFieldName,
      other: FormFieldName,
      message: ObservedValidationMessage,
    }

type OobeAdvanceGate
  = ForwardControlEnabledOnArrival
  | ForwardControlEnabledAfterScrollToEnd {
      scroll_container: TestId,
    }
  | ForwardControlEnabledWhenFieldsValidate {
      rules: List<ObservedFieldValidationRule>,
    }

// ------------------------------------------------------------------------------------------
// WHAT A SCREEN COMMITS.
//
// Separated from the screen's controls because "what you can type here" and "what leaves this
// machine changed when you press the button" are different questions, and only the second one
// decides whether re-running the workflow is safe. AcceptsLegalAgreement is its own arm and
// not a flavor of PersistsDeviceSetting deliberately: agreeing to a license on an operator's
// behalf is a legal act, it is the one step in this flow a machine should not take on its own
// initiative, and an automation that cannot SEE that distinction cannot be built to respect
// it.
// EFFECT NAMES WHAT WAS OBSERVED, NOT WHAT WAS PERSISTED. The first revision used
// PresentsOnlyNoCommit and PersistsDeviceSetting, and both outran the measurement: reaching the
// next route establishes that a submission was ACCEPTED and the app advanced, and it says
// nothing about whether the value survives a refresh, a reboot, or the end of the wizard --
// nor, for the "no commit" arm, that nothing at all was written.
//
// The measurement that settles this is now in hand and it cuts against the durable reading:
// after the agreement was accepted, navigating to the portal root STILL resolves to /welcome
// (initial_navigation_observation below). The wizard does not resume where it stopped, so at
// least that far, acceptance did not persist as resumable progress.
//
// AcceptsLegalAgreement survives as its own arm, and not because its durability is established
// either. It is distinct because the LEGAL BOUNDARY is what the automation must be able to see
// in order to refuse to cross it unauthorized -- a different question from what the device
// stored.
//
// CreatesDeviceAccount is a THIRD arm for the same reason AcceptsLegalAgreement is a second one,
// and not a flavour of SubmitsSelections. Advancing past the settings screen submits choices
// that can be made again; advancing past the account screen MINTS A CREDENTIAL on the device.
// It is the step after which the wizard is no longer a fresh unit, it consumes a secret the
// automation must have been authorized to use, and re-running it is not the same as running it
// once. An automation that cannot SEE that distinction cannot be built to require authorization
// before crossing it -- which is the whole reason the legal arm exists, applied to credentials.
type OobeScreenEffect
  = PresentsNoConfigurableField
  | SubmitsSelections { fields: List<OobeSetupField> }
  | AcceptsLegalAgreement
  | CreatesDeviceAccount { fields: List<OobeSetupField> }

type OobeScreenRoute = NonEmptyStr where brand("OobeScreenRoute")
type OobeScreenHeading = NonEmptyStr where brand("OobeScreenHeading")

// presented_subjects IS THE COVERAGE AUTHORITY, and it exists because the first revision of
// this module got the derivation wrong in a way the PR text then advertised as correct. That
// revision carried a hand-written match over every OobeSetupField beside the screen list, so
// appending a screen retired NOTHING: an author had to remember to edit a second table, and the
// claim that coverage was "derived, not asserted" was simply false. Two structures answering one
// question is the parallel authority §3 forbids, and the failure mode is silent -- both tables
// stay type-correct while they disagree.
//
// The subject a screen PRESENTS is deliberately not the same field as the effect of ADVANCING
// past it. The EULA screen presents the terms-and-conditions subject whether or not anyone
// accepts; the settings screen presents language and timezone and, separately, submits them.
// Folding the prefix over presented_subjects is now the only account of what has been observed.
type ObservedOobeScreen {
  route: OobeScreenRoute
  heading: OobeScreenHeading
  controls: List<OobeControl>
  advance_gate: OobeAdvanceGate
  effect: OobeScreenEffect
  presented_subjects: List<OobeSetupField>
}

// ------------------------------------------------------------------------------------------
// SCREEN 01 -- /welcome
//
// The landing screen. One button, nothing to fill, nothing committed. Modeled even though it
// carries no settings because the ROUTE SEQUENCE is itself the finding: the portal's root
// redirects to /welcome, so a driver that navigates to "/" and immediately looks for a
// language selector is one screen early. That off-by-one is exactly the kind of defect a
// guessed flow produces and a measured one cannot.
// ------------------------------------------------------------------------------------------
data oobe_screen_welcome: ObservedOobeScreen = ObservedOobeScreen {
  route: "/welcome" as OobeScreenRoute,
  heading: "Welcome To DGX Spark" as OobeScreenHeading,
  controls: [
    AdvanceButton {
      identity: WelcomeGetStartedAction,
      address: "nv-button" as TestId,
      label: "Get Started" as ControlLabel,
    },
  ],
  advance_gate: ForwardControlEnabledOnArrival,
  effect: PresentsNoConfigurableField,
  presented_subjects: [],
}

// ------------------------------------------------------------------------------------------
// SCREEN 02 -- /welcome/settings
//
// Language and timezone TOGETHER ON ONE SCREEN, which is the first place the observed flow
// departs from the shape the vendor page implies. dgx_spark_oobe_fields lists language,
// timezone and keyboard layout as separate prompted subjects in order; this screen prompts
// two of them at once and does not prompt keyboard layout at all up to the point we reached.
// That divergence is recorded structurally below (observed_screen_covers_field) rather than
// in prose, so a consumer asks the model rather than trusting a comment.
//
// THE THIRD HIDDEN FIELD IS NOT A THIRD PROMPT. The screen carries hidden inputs named
// language, timezone AND locale, but only two comboboxes, so locale is not operator-chosen. It
// is carried because a driver that hunts for a control will not find one and a model that
// omitted it would leave an unexplained field in the submitted form.
//
// AN EARLIER REVISION SAID locale WAS "evidently derived" FROM THE LANGUAGE CHOICE. That was an
// inference, and it is withdrawn: what is observed is that the field carries "en-US" while
// nothing was selected. Establishing derivation needs one language changed and the locale
// watched to move, which has not been done. The representation IS now established, which is the
// part that matters -- it is a BCP 47 language tag, not a POSIX locale, and the two are not
// interchangeable.
// ------------------------------------------------------------------------------------------
data oobe_screen_settings: ObservedOobeScreen = ObservedOobeScreen {
  route: "/welcome/settings" as OobeScreenRoute,
  heading: "Set Up Your NVIDIA DGX Spark" as OobeScreenHeading,
  controls: [
    ComboBoxOverHiddenField {
      placeholder: "US - English" as PlaceholderText,
      backing_field: "language" as FormFieldName,
      submitted_representation: VendorOpaqueOrdinal,
    },
    ComboBoxOverHiddenField {
      placeholder: "UTC" as PlaceholderText,
      backing_field: "timezone" as FormFieldName,
      submitted_representation: VendorOpaqueOrdinal,
    },
    HiddenBackingField {
      field: "locale" as FormFieldName,
      submitted_representation: Bcp47LanguageTagValue,
    },
    SubmitButton {
      identity: SettingsContinueAction,
      address: "nv-button" as TestId,
      label: "Continue" as ControlLabel,
    },
  ],
  advance_gate: ForwardControlEnabledOnArrival,
  effect: SubmitsSelections { fields: [OobeLanguage, OobeTimeZone] },
  presented_subjects: [OobeLanguage, OobeTimeZone],
}

// ------------------------------------------------------------------------------------------
// SCREEN 03 -- /welcome/eula
//
// NVIDIA's Terms Of Use, and the screen that carries the advance gate. The forward control is
// a single button labelled Accept, rendered disabled, inside a page whose only scrollable
// element is the terms pane at data-testid nv-modal-main. Scrolling that pane to its end
// enables the button.
//
// THE SCROLL TARGET IS NAMED, NOT DISCOVERED. The measurement that found it enumerated every
// element whose scrollHeight exceeded its clientHeight and found exactly one. A driver could
// repeat that search at run time, but then the automation's behavior would depend on a page
// property that a layout change can make ambiguous -- two scrollable panes and the heuristic
// silently picks the wrong one. Naming the container makes a layout change a loud address
// failure instead (DESIGN section 4: in a closed system a heuristic is never necessary).
//
// THE EFFECT ARM IS AcceptsLegalAgreement AND THAT IS LOAD-BEARING. This is the step this
// session declined to take without the operator's explicit instruction. The model exists so
// that refusal is expressible: a workflow can be asked whether any screen it is about to
// drive accepts an agreement, and answer without a human reading the screen.
// ------------------------------------------------------------------------------------------
data oobe_screen_eula: ObservedOobeScreen = ObservedOobeScreen {
  route: "/welcome/eula" as OobeScreenRoute,
  heading: "Terms Of Use" as OobeScreenHeading,
  controls: [
    AdvanceButton {
      identity: EulaAcceptAction,
      address: "nv-button" as TestId,
      label: "Accept" as ControlLabel,
    },
  ],
  advance_gate: ForwardControlEnabledAfterScrollToEnd {
    scroll_container: "nv-modal-main" as TestId,
  },
  effect: AcceptsLegalAgreement,
  presented_subjects: [OobeTermsAndConditions],
}

// ------------------------------------------------------------------------------------------
// SCREEN 04 -- /welcome/account
//
// The screen the earlier walk stopped in front of, now modeled. It is the credential boundary:
// three required inputs and a submit that creates a local account on the device.
//
// THE THREE INPUTS SHARE ONE ADDRESS. All three carry data-testid "nv-text-input-element", on
// one route, so the testid does not name any of them. The discriminator is the form field name,
// which is also what the submitted form carries, so the model addresses them by name and
// records the shared testid beside it rather than as the identity.
//
// THE SECRECY OF A FIELD IS OBSERVED, NOT ASSUMED FROM ITS LABEL. password and confirmPassword
// render as type=password; username renders as type=text. That distinction is what lets a
// workflow bind a secret-filling operation to exactly the fields that take a secret, and refuse
// to route a secret into a plaintext control -- the FillTextControl/FillSecretControl split, in
// the model rather than in the driver.
//
// WHAT THE VALIDATION ACTUALLY REQUIRES, and it is weaker than one would guess. The minimum
// password length is SIX. Twelve lowercase letters with no digit, symbol or capital is accepted;
// the only observed rejections are empty-required, under-six, and confirm-mismatch. Nothing here
// enforces a complexity policy, so any policy this fleet wants is OUR obligation upstream of the
// screen, not something the wizard will hold the line on.
//
// AND THE FINDING THAT MATTERS MOST: THE CLIENT ADMITS THE USERNAME "root". Supplied as the
// username with a valid password, the Continue control became ENABLED. That is a measured
// non-rejection, not an absence of evidence -- we asked and the screen said yes. A workflow that
// let an operator or a generator choose "root" here would be inviting a collision with uid 0 on
// a device whose wizard will not stop it. The refusal has to be ours, and it has to sit upstream
// of the fill, because by the time the control is enabled the client has already agreed.
// ------------------------------------------------------------------------------------------
data oobe_screen_account: ObservedOobeScreen = ObservedOobeScreen {
  route: "/welcome/account" as OobeScreenRoute,
  heading: "Set Up Your NVIDIA DGX Spark" as OobeScreenHeading,
  controls: [
    TextEntryField {
      address: "nv-text-input-element" as TestId,
      field: "username" as FormFieldName,
      placeholder: "Username" as PlaceholderText,
      secrecy: PlainTextEntry,
      requiredness: RequiredField,
    },
    TextEntryField {
      address: "nv-text-input-element" as TestId,
      field: "password" as FormFieldName,
      placeholder: "Password" as PlaceholderText,
      secrecy: MaskedSecretEntry,
      requiredness: RequiredField,
    },
    TextEntryField {
      address: "nv-text-input-element" as TestId,
      field: "confirmPassword" as FormFieldName,
      placeholder: "Confirm Password" as PlaceholderText,
      secrecy: MaskedSecretEntry,
      requiredness: RequiredField,
    },
    SubmitButton {
      identity: AccountContinueAction,
      address: "nv-button" as TestId,
      label: "Continue" as ControlLabel,
    },
  ],
  advance_gate: ForwardControlEnabledWhenFieldsValidate {
    rules: [
      FieldRequiredNonEmpty {
        field: "username" as FormFieldName,
        message: "This field is required" as ObservedValidationMessage,
      },
      FieldMinimumLength {
        field: "password" as FormFieldName,
        minimum: 6,
        message: "Password must be at least 6 characters long" as ObservedValidationMessage,
      },
      FieldMustEqual {
        field: "confirmPassword" as FormFieldName,
        other: "password" as FormFieldName,
        message: "Passwords do not match" as ObservedValidationMessage,
      },
    ],
  },
  effect: CreatesDeviceAccount { fields: [OobeUserAccount] },
  presented_subjects: [OobeUserAccount],
}

// ------------------------------------------------------------------------------------------
// WHAT THE CLIENT ADMITS AS A USERNAME.
//
// A SEPARATE ROW FROM THE VALIDATION RULES, because a rule is something the screen enforces and
// this is a record of what it declined to enforce. Folding "root was accepted" into the rule
// list would put a non-rule in a list of rules; keeping it here means a consumer asking "what
// does the client reject" gets the rules, and a consumer asking "what did we actually try" gets
// this.
//
// THE POPULATION IS TWO PROBES AND THIS ROW CLAIMS NOTHING BEYOND THEM. It does not say the
// client admits every username; it says these two were supplied and the forward control became
// enabled. The empty username is deliberately absent: it is refused, and it is already carried
// as FieldRequiredNonEmpty above -- and it could not be written here anyway, because the
// username type is NonEmptyStr and the invalid state has no constructor.
type ClientUsernameAdmission
  = ClientAdmittedUsername { username: NonEmptyStr }
  | ClientRefusedUsername {
      username: NonEmptyStr,
      message: ObservedValidationMessage,
    }

data observed_account_username_probes: List<ClientUsernameAdmission> = [
  ClientAdmittedUsername { username: "fleetadmin" },
  ClientAdmittedUsername { username: "root" },
]

// ------------------------------------------------------------------------------------------
// A ROUTE THAT RENDERS IS NOT A WIZARD THAT HAS PROGRESSED.
//
// /welcome/account was reached by navigating DIRECTLY to it, on a unit whose root still resolves
// to /welcome -- so the account screen rendered without its predecessor screens having been
// completed. The SPA does not gate its routes on progress.
//
// This is carried because it cuts both ways and both matter. It is why the screen above could be
// modeled without accepting a licence or creating an account: the observation cost nothing on the
// device. It is also a hazard for anything that infers state from location -- arriving at a route
// establishes that the route renders, and nothing about what the unit has been configured with.
// A workflow that treated "I am at /welcome/account" as "the EULA has been accepted" would be
// reading a client-side path as device state.
type ObservedRouteGating
  = RouteRequiresPredecessorCompletion
  | RouteRenderedWithoutPredecessorCompletion

type ObservedDirectRouteNavigation {
  requested_route: OobeScreenRoute
  resulting_route: OobeScreenRoute
  root_still_resolves_to: OobeScreenRoute
  gating: ObservedRouteGating
}

data account_route_direct_navigation: ObservedDirectRouteNavigation = ObservedDirectRouteNavigation {
  requested_route: "/welcome/account" as OobeScreenRoute,
  resulting_route: "/welcome/account" as OobeScreenRoute,
  root_still_resolves_to: "/welcome" as OobeScreenRoute,
  gating: RouteRenderedWithoutPredecessorCompletion,
}

// ------------------------------------------------------------------------------------------
// THE WALK, AND ITS HONEST END.
//
// THIS LIST IS A PREFIX OF THE WIZARD, NOT THE WIZARD. The walk stopped at the EULA because
// advancing past it means accepting a license on the operator's behalf. Every screen NVIDIA's
// page says comes later -- user account, analytics, wireless network -- is therefore
// UNOBSERVED BY US, and this module must not be read as saying they do not exist or that the
// flow ends here.
//
// The distinction is the one DESIGN section 4b keeps off the ladder: a screen we have not
// watched is outside the modeled guarantee, not a screen we have proven absent. Recording the
// prefix as if it were the population is the failure mode this repository already names
// (selection_view_read_as_population), and it would be especially cheap to commit here
// because the observed rows are real and the missing ones leave no trace.
// ------------------------------------------------------------------------------------------
// DERIVED FROM THE RUNS, and it has to be, now that there is more than one. The prefix used to be
// hand-listed here while the single run row cited IT -- one authority, read backwards, which was
// fine while one run produced every screen. A second run breaks that: a hand-listed union would
// let a screen be observed by no run, or a run to claim a screen it never watched, with both
// tables staying type-correct while they disagree. So the runs are the authority and the prefix
// is folded out of them (DESIGN section 3).
fn observed_oobe_screen_prefix() -> List<ObservedOobeScreen> {
  flat_map(oobe_observation_runs, run => run.screens)
}

// ------------------------------------------------------------------------------------------
// THE INITIAL NAVIGATION, which the first revision asserted in prose and never modeled.
//
// The PR text claimed "the root redirects to /welcome", and a list whose first element is
// /welcome does not establish that. Worse, the word was wrong in kind: the measurement says the
// root answers HTTP 200 with NO HTTP REDIRECT, and /welcome is reached by a CLIENT-SIDE route
// inside the SPA. An actuator that expected a 3xx, or that waited for a redirect chain, would
// wait forever on a page that already arrived.
//
// This is carried structurally because an actuator depends on it: it decides what "navigate to
// the portal" is allowed to assume about where it lands.
type InitialRouteResolution
  = ResolvedByHttpRedirect
  | ResolvedByClientSideRoute

type ObservedInitialNavigation {
  requested_path: OobeScreenRoute
  http_status: HttpStatus
  resolution: InitialRouteResolution
  resulting_route: OobeScreenRoute
}

data initial_navigation_observation: ObservedInitialNavigation = ObservedInitialNavigation {
  requested_path: "/" as OobeScreenRoute,
  http_status: 200,
  resolution: ResolvedByClientSideRoute,
  resulting_route: "/welcome" as OobeScreenRoute,
}

type OobeWalkTermination
  = WalkReachedFlowCompletion
  | WalkHaltedAwaitingOperatorAuthority { at_route: OobeScreenRoute }

data observed_walk_termination: OobeWalkTermination = WalkHaltedAwaitingOperatorAuthority {
  at_route: "/welcome/eula" as OobeScreenRoute,
}

// The second run halted one screen further on, and for a different reason than the first. Run 1
// stopped in front of a legal act. Run 2 reached the account screen WITHOUT performing one --
// the route renders directly -- and stopped in front of a credential act: filling the form is
// free, pressing Continue creates an account. Both are the same shape of refusal and they are
// separate rows because they are separate runs; a single termination would have to pick one.
data observed_account_walk_termination: OobeWalkTermination = WalkHaltedAwaitingOperatorAuthority {
  at_route: "/welcome/account" as OobeScreenRoute,
}

// ------------------------------------------------------------------------------------------
// DOCUMENTED VERSUS OBSERVED.
//
// The coverage half is now folded from the observed prefix (screen_presents_field), so the two
// structures that used to answer "was this field observed" have become one.
//
// Both halves are now modeled -- the vendor's prompted-field list in the extdeps module, and
// our prefix here -- so the divergence is DERIVABLE rather than asserted. This function is the
// join: it answers, for one field, whether the screens we actually watched prompted for it.
//
// It deliberately does NOT compare itself against dgx_spark_oobe_offers_field and report a
// verdict, because the two predicates answer different questions over different populations:
// the vendor's covers the whole wizard, ours covers a prefix that stops at the EULA. A
// difference between them is only evidence of vendor error where our walk was complete, and
// observed_walk_termination says it is not. Presenting the difference as a defect list would
// be the undecided fraction read as a denominator.
fn screen_presents_field(screen: ObservedOobeScreen, field: OobeSetupField) -> Bool {
  fold(
    screen.presented_subjects,
    init: false,
    f: (acc, presented) => acc || presented == field
  )
}

// DERIVED, and this time the word is true. The fold ranges over the observed prefix itself, so
// appending a screen with its presented_subjects retires that screen's pending fields with no
// second edit anywhere. The predicate this replaced was a hand-maintained match over every
// OobeSetupField; it is deleted rather than kept beside this one, because leaving both would
// preserve the exact fork the repair exists to remove.
fn observed_screen_covers_field(field: OobeSetupField) -> Bool {
  fold(
    observed_oobe_screen_prefix(),
    init: false,
    f: (acc, screen) => acc || screen_presents_field(screen: screen, field: field)
  )
}

// A field the vendor page says is prompted and our prefix has not reached. This is the
// COVERAGE OBLIGATION -- the list of things still to watch -- and it is computed from the two
// models rather than hand-listed, so finishing the walk retires rows here by construction.
fn field_is_pending_observation(field: OobeSetupField) -> Bool {
  dgx_spark_oobe_offers_field(field: field) && !observed_screen_covers_field(field: field)
}

// ------------------------------------------------------------------------------------------
// THE RECEIPT: what produced the rows above.
//
// A screen model with no provenance is an assertion. This records the browser that rendered
// the SPA, the unit whose access point served it, and when -- so a future reader can decide
// whether the observation still applies rather than assuming it does.
//
// THE ACCESS POINT IS NAMED AND THE CREDENTIAL IS NOT. The SSID is a per-unit vendor-derived
// label and is safe to record; the passphrase arrives on a printed sticker and is a per-unit
// secret, which is precisely why extdeps.systems.nvidia_dgx_spark_setup models the carrier as
// PrintedQuickStartGuideSticker and holds no password. No field here can carry one.
//
// THE RENDERING HOST IS NOT THE RADIO HOST, and the honest reason is narrower than the one
// this comment first gave. It said the Pi's memory was "far below what Chromium needs", which
// asserts a CAUSE that was never measured: the attempt on the Pi timed out at rc=124 with no
// stderr, on the portal AND on an example.com control, with roughly 550MB shown available at
// one sampled moment. No RSS, swap-pressure, PSI or OOM observation was taken, so memory is a
// hypothesis and not a finding, and nothing here establishes that a Pi 3B+ cannot run a
// browser.
//
// What the evidence DOES establish is target-independent: that attempted realization, on that
// host, failed regardless of what it was pointed at -- which is enough to select a different
// rendering host and nothing more. The topology below therefore records a host that was tried
// and a host that worked; it does not license a capability rule about the hardware.
//
// The half that IS established structurally is the portal: it is a client-rendered SPA, so a
// plain HTTP fetch cannot drive it and a browser is required somewhere.
// ------------------------------------------------------------------------------------------

type ObservedUnitAccessPointSsid = NonEmptyStr where brand("ObservedUnitAccessPointSsid")
type RadioRelayHost = NonEmptyStr where brand("RadioRelayHost")
type RenderingHost = NonEmptyStr where brand("RenderingHost")

type OobePortalObservationEnvironment {
  chromium_build: ChromiumBuild
  playwright_build: PlaywrightBuild
  browser_binary_provenance: PlaywrightBrowserBinaryProvenance
  rendering_host: RenderingHost
  radio_relay_host: RadioRelayHost
  unit_access_point: ObservedUnitAccessPointSsid
  portal_origin: Uri
}

// HOW THE RENDERER REACHED THE PORTAL, which run 1's environment could not say and run 2 forced
// into the open. The renderer, the radio relay and the origin the browser actually loaded are
// three facts, and run 2 has a fourth participant between them: the browser on srv4 loaded a
// LOOPBACK listener on its own host, forwarded through this session, forwarded again through the
// relay, to the unit. srv4 holds no key to the relay, so it cannot open that channel itself --
// measured, not assumed, and it is why a proxy locus exists at all rather than being an
// implementation detail of "srv4 reaches the unit".
//
// The browser origin is recorded separately from the unit origin because they are not the same
// string under forwarding, and same-origin behaviour is a property of what the browser loaded.
//
// PortalReachUnrecorded is for run 1 and is not a claim that it was direct. That run recorded
// the unit's address as the origin and did not record the mechanism, so the mechanism is
// unobserved -- the column DESIGN section 4b keeps off the ladder, declared rather than
// backfilled from what seems likely now.
type OobePortalReach
  = PortalReachUnrecorded
  | RendererThroughForwardedEndpoint {
      proxy_locus: NonEmptyStr,
      renderer_origin: Uri,
      unit_origin: Uri,
    }

type OobeScreenObservationRun {
  environment: OobePortalObservationEnvironment
  portal_reach: OobePortalReach
  observed_on: Rfc3339Timestamp
  screens: List<ObservedOobeScreen>
  termination: OobeWalkTermination
}

data dgx_spark_0c75_oobe_prefix_run: OobeScreenObservationRun = OobeScreenObservationRun {
  environment: OobePortalObservationEnvironment {
    chromium_build: chromium_151_0_7922_34,
    playwright_build: playwright_1_62_1,
    browser_binary_provenance: PlaywrightManagedChromiumDownload,
    rendering_host: "srv4" as RenderingHost,
    radio_relay_host: "pi1" as RadioRelayHost,
    unit_access_point: "spark-0c75" as ObservedUnitAccessPointSsid,
    portal_origin: Uri {
      scheme: Http,
      locator: "10.92.7.127",
    },
  },
  portal_reach: PortalReachUnrecorded,
  observed_on: "2026-09-02T02:39:00Z" as Rfc3339Timestamp,
  screens: [
    gunbc.spark.oobe_screen_observation.oobe_screen_welcome,
    gunbc.spark.oobe_screen_observation.oobe_screen_settings,
    gunbc.spark.oobe_screen_observation.oobe_screen_eula,
  ],
  termination: gunbc.spark.oobe_screen_observation.observed_walk_termination,
}

// RUN 2 -- the account screen, reached without crossing either boundary run 1 stopped at.
//
// Same unit, same relay, same renderer and the same pinned Playwright build; a different route to
// it, and a different halt. The renderer is srv4 again deliberately: srv1 carries browser binaries
// but no Playwright package, so it is not a qualified renderer, and re-observing under a different
// browser build would have made any selector difference ambiguous between "the image changed" and
// "we looked with a different tool".
data dgx_spark_0c75_oobe_account_run: OobeScreenObservationRun = OobeScreenObservationRun {
  environment: OobePortalObservationEnvironment {
    chromium_build: chromium_151_0_7922_34,
    playwright_build: playwright_1_62_1,
    browser_binary_provenance: PlaywrightManagedChromiumDownload,
    rendering_host: "srv4" as RenderingHost,
    radio_relay_host: "pi1" as RadioRelayHost,
    unit_access_point: "spark-0c75" as ObservedUnitAccessPointSsid,
    portal_origin: Uri {
      scheme: Http,
      locator: "127.0.0.1:18082",
    },
  },
  portal_reach: RendererThroughForwardedEndpoint {
    proxy_locus: "sleek-bear-442",
    renderer_origin: Uri {
      scheme: Http,
      locator: "127.0.0.1:18082",
    },
    unit_origin: Uri {
      scheme: Http,
      locator: "10.92.7.127",
    },
  },
  observed_on: "2026-09-03T02:42:20Z" as Rfc3339Timestamp,
  screens: [gunbc.spark.oobe_screen_observation.oobe_screen_account],
  termination: gunbc.spark.oobe_screen_observation.observed_account_walk_termination,
}

data oobe_observation_runs: List<OobeScreenObservationRun> = [
  gunbc.spark.oobe_screen_observation.dgx_spark_0c75_oobe_prefix_run,
  gunbc.spark.oobe_screen_observation.dgx_spark_0c75_oobe_account_run,
]
