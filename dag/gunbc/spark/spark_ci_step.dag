module gunbc.spark.spark_ci_step

import std.types { List, String }
import extdeps.cloud.gcp.secret_ref { secret_ref_access_url, secret_ref_version_resource }
import gunbc.auth.bearer_header_file { gunbc_ci_auth_header_file_write_command }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.ci.ci_retry { ci_retry_body_run }
import gunbc.ci.ci_run_step_target { GunbcRunStepTarget }
import gunbc.fleet.fleet_bootstrap_principal_session { fleet_bootstrap_credential_path_env }
import gunbc.spark.bootstrap_provision { spark_bootstrap_cloud_principal_member }
import gunbc.spark.credential_workflow { spark_administrator_credential_roster, spark_administrator_password_secret_ref_at_version }
import gunbc.spark.managed_access_apply { spark_apply_receipt_path }
import v2.std.orchestration { Do, PipelineStep }
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script, gunbc_run_step_script_with_prelude }

// THE SPARK RUN STEPS, moved out of gunbc.ci.ci_spec (gunbc.plans.closure_consolidation P2): the
// fleet-converge job's seven Spark modes -- grant install, bootstrap, serving apply, native serving
// apply, the runtime-image probe, the wireless-link converge and the exact-grant observe -- each one's
// run-step target, its emitted `run:` step, and the three mode-only preludes nothing else calls.
// Serving apply, native serving apply and the runtime-image probe are RETIRED: their dispatch modes
// survive only to refuse a bookmarked run, so they have no target and share one refuse script.
// Two of these targets' ENTRY modules sit under gunbc.fleet -- the exact-grant observe runs
// fleet_multi_principal_probe's spark probe and the wireless-link converge runs
// fleet_wireless_link_converge -- and they stay here anyway: a run step belongs to the mode it is
// dispatched as, and both are Spark modes of this job, not fleet-wide steps.

data gunbc_ci_spark_grant_install_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/spark/managed_grant_install.dag",
  function: "spark_grant_install_ci_wet",
}

data gunbc_ci_spark_bootstrap_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/spark/managed_access_apply.dag",
  function: "spark_managed_access_bootstrap_ci_wet",
}

// Spark serving apply / native apply / runtime-image probe are retired: all DGX Sparks are sold
// (gunbc.spark.dgx_procurement dgx_spark_disposed_units). Dispatch modes remain so a bookmark
// fails closed rather than no-op.
data spark_serving_retired_refuse_script: String = "echo 'refused: DGX Spark serving path retired; all units sold (gunbc.spark.dgx_procurement dgx_spark_disposed_units)' >&2\nexit 1\n"

// THE PRODUCTION. It verifies the candidate's kernel wheels, converges the patched source tree,
// builds the V4.1 image on the selected Spark, reads the produced digest back from inside itself
// and admits that digest against the candidate. It needs this job's prelude for the same reason the
// probe does -- docker's socket on a Spark is root-owned and the managed executor is in no docker
// group -- and it is the only step in this job that can occupy a host for hours.
// THE WIRELESS LINK CONVERGE. Root on a Spark is the administrator password leg, so it shares the
// probe's prelude; it changes the radio's power-save policy and the connection profile only.
// THE GRANT OBSERVE (gunbc.fleet.fleet_multi_principal_probe spark_exact_grant_probe_ci_wet). Read-only:
// it rides the job's fleet-key agent as gunbc-automation and the bootstrap principal on every procured
// Spark, needs no administrator credential, and installs nothing.
data gunbc_ci_spark_grants_observe_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/fleet/fleet_multi_principal_probe.dag",
  function: "spark_exact_grant_probe_ci_wet",
}

data gunbc_ci_spark_wireless_link_converge_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/fleet/fleet_wireless_link_converge.dag",
  function: "spark_wireless_link_converge_ci_wet",
}

// A3 in-run administrator-credential materialization, the same lifecycle as the fleet key one step
// above and deliberately not a variation on it: WIF token from the google_auth_action step by env,
// one PINNED secret version, a 0600 file under RUNNER_TEMP, and a trap armed BEFORE the credential
// touches disk so any failure removes it regardless of where set -e aborts.
//
// WHAT GOES TO GITHUB_ENV IS THE PATH, NEVER THE CREDENTIAL. An env var holding the password would
// be readable by every child process and printed by any diagnostic that dumps the environment — and
// this repository's own receipts print argv. A path discloses nothing to anyone who cannot already
// read the file.
//
// The URL is derived from the modeled SecretRef rather than spelled, so this step and the lease
// that authorizes it cannot name different versions. There is no fingerprint check as for the key:
// a password has no derivable public half, so the identity evidence is sudo's own accept-or-reject,
// which the privileged step classifies as its own outcome.
//
// THE HTTP STATUS IS CLASSIFIED, NOT COLLAPSED; the first cut got that wrong at the cost of a run.
// It piped `curl -sSf` straight into a decoder and checked the file size afterwards, so a 403
// surfaced as a JSON decode traceback followed by "produced no payload" — true of the file, false
// about the world. Unreadable and enrolled-but-blank have different remedies, and neither is
// discoverable from an empty file.
//
// A 403 DOES NOT ESTABLISH THAT THE SECRET EXISTS, and the second cut claimed it did ("an access
// grant and not a missing secret"). Secret Manager answers 403 both for a version that exists and
// is unreadable and for one that does not exist — it hides existence from principals who may not
// read it. gunbc.spark.bootstrap_provision records exactly this ambiguity about exactly this API,
// having read an empty testIamPermissions response as proof of denial rather than of nothing. So
// the refusal states the ambiguity and gives the remedy covering both arms, rather than picking the
// arm that fits the current guess.
//
// THE SPARK ADMINISTRATOR CREDENTIAL PRELUDE, folded into the ONE step that consumes it. The former
// two-step shape (a separate "materialize" step exporting a path via GITHUB_ENV, plus an
// always()-gated cleanup step) is gone: the five steps between them all carry mutually exclusive
// mode == '...' guards against this step's own mode == 'spark_grants' guard, so on the only path
// this credential is fetched nothing ran between fetch and consumption — the two-step shape was
// YAML-adjacent, not runtime-adjacent. One shell script now fetches, decodes, and hands the
// credential to the grant-install invocation within its own process tree: one trap (armed for the
// whole script, never disarmed, since nothing needs the file past this script's exit), one
// CRED_FILE, a shell-local export instead of GITHUB_ENV so the path never crosses a step boundary.
// THE ADMINISTRATOR PASSWORD VERSION FOLLOWS THE TARGET HOST. The prelude used to fetch one fixed
// version, which was right while every Spark shared one password and wrong the day the second batch
// arrived with another. The version is a fact of the host (gunbc.spark.credential_workflow
// spark_administrator_credential_roster), and SPARK_CONVERGE_TARGET is a run-time input, so the
// generated script carries one exact URL per enrolled host and refuses an unrosterd target before
// any fetch -- no shell variable is ever spliced into a modeled URL.
fn gunbc_ci_spark_administrator_credential_target_case() -> String {
  join([
    "case \"$\{SPARK_CONVERGE_TARGET:-}\" in ",
    join(map(spark_administrator_credential_roster, r => join([
      r.host as String, ") SM_URL=\"",
      secret_ref_access_url(ref: spark_administrator_password_secret_ref_at_version(version: r.version)),
      "\"; SM_RES=\"",
      secret_ref_version_resource(ref: spark_administrator_password_secret_ref_at_version(version: r.version)),
      "\" ;; ",
    ], "")), ""),
    "*) echo \"SparkAdministratorCredentialHostUnrostered: SPARK_CONVERGE_TARGET='$\{SPARK_CONVERGE_TARGET:-}' names no host in the administrator credential roster; contacting NO host\" >&2; exit 1 ;; esac",
  ], "")
}

fn gunbc_ci_spark_grant_install_credential_prelude() -> List<PipelineStep> {
  [
    Do { run: ci_retry_body_run(command: "set -euo pipefail") },
    Do { run: ci_retry_body_run(command: "umask 077") },
    Do { run: ci_retry_body_run(command: "CRED_FILE=\"$RUNNER_TEMP/spark-administrator-credential\"") },
    Do { run: ci_retry_body_run(command: "RESP_FILE=\"$RUNNER_TEMP/spark-administrator-response.json\"") },
    Do { run: ci_retry_body_run(command: "HDR_FILE=\"$RUNNER_TEMP/spark-administrator-auth-header\"") },
    Do { run: ci_retry_body_run(command: "trap 'rm -f \"$CRED_FILE\" \"$RESP_FILE\" \"$HDR_FILE\"' EXIT") },
    Do { run: ci_retry_body_run(command: gunbc_ci_auth_header_file_write_command()) },
    Do { run: ci_retry_body_run(command: gunbc_ci_spark_administrator_credential_target_case()) },
    Do {
      run: ci_retry_body_run(
        command: "HTTP_CODE=\"$(curl -sS -o \"$RESP_FILE\" -w '%\{http_code}' -H @\"$HDR_FILE\" \"$SM_URL\" || echo 000)\""
      )
    },
    Do {
      run: ci_retry_body_run(
        command: join([
          "if [ \"$HTTP_CODE\" = 403 ]; then echo \"SparkAdministratorCredentialUnreadable: ",
          "$SM_RES",
          " answered 403 to ", spark_bootstrap_cloud_principal_member(),
          ". Secret Manager returns 403 both when a version exists and is not readable AND when it does not exist, so this run cannot tell those apart -- REMEDY EITHER WAY: confirm the version exists and grant that principal roles/secretmanager.secretAccessor on it. Contacting NO host.\" >&2; exit 1; fi"
        ], "")
      )
    },
    Do {
      run: ci_retry_body_run(
        command: join([
          "if [ \"$HTTP_CODE\" = 404 ]; then echo \"SparkAdministratorCredentialAbsent: ",
          "$SM_RES",
          " answered 404; the modeled reference names a version Secret Manager does not hold. Contacting NO host.\" >&2; exit 1; fi"
        ], "")
      )
    },
    Do {
      run: ci_retry_body_run(
        command: join([
          "if [ \"$HTTP_CODE\" != 200 ]; then echo \"SparkAdministratorCredentialFetchFailed: HTTP $HTTP_CODE from ",
          "$SM_RES",
          "; contacting NO host.\" >&2; exit 1; fi"
        ], "")
      )
    },
    Do { run: ci_retry_body_run(command: "python3 -c 'import sys,json,base64; sys.stdout.buffer.write(base64.b64decode(json.load(open(sys.argv[1]))[\"payload\"][\"data\"]))' \"$RESP_FILE\" > \"$CRED_FILE\"") },
    Do { run: ci_retry_body_run(command: "rm -f \"$RESP_FILE\"") },
    Do { run: ci_retry_body_run(command: "chmod 600 \"$CRED_FILE\"") },
    Do {
      run: ci_retry_body_run(
        command: join([
          "if [ ! -s \"$CRED_FILE\" ]; then echo \"SparkAdministratorCredentialEmpty: ",
          "$SM_RES",
          " returned 200 with an empty payload, which is an enrolled-but-blank secret and never a blank password; contacting NO host\" >&2; exit 1; fi"
        ], "")
      )
    },
    Do {
      run: ci_retry_body_run(
        command: join(["export ", fleet_bootstrap_credential_path_env as String, "=\"$CRED_FILE\""], "")
      )
    },
    Do {
      run: ci_retry_body_run(
        command: join([
          "echo \"spark-admin-credential: materialized from ",
          "$SM_RES",
          " to a 0600 run-local file, consumed and removed within this one step\""
        ], "")
      )
    }
  ]
}

// The bootstrap shares the grant-install prelude: same fleet-key agent from the job, same per-target
// administrator credential materialized to the same file, so the two cannot drift on how a Spark
// is reached or authenticated.
fn gunbc_ci_spark_bootstrap_invoke() -> String {
  gunbc_run_step_script_with_prelude(
    prelude: gunbc_ci_spark_grant_install_credential_prelude(),
    source_roots: witness_layer_roots,
    entry: gunbc_ci_spark_bootstrap_target.entry,
    function: gunbc_ci_spark_bootstrap_target.function,
    claim_run: false,
    receipt_rel: spark_apply_receipt_path
  )
}

fn gunbc_ci_spark_runtime_image_probe_invoke() -> String {
  spark_serving_retired_refuse_script
}

fn gunbc_ci_spark_grants_observe_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_spark_grants_observe_target.entry,
    function: gunbc_ci_spark_grants_observe_target.function,
    claim_run: false,
    receipt_rel: "target/spark-exact-grant-probe-receipt.txt"
  )
}

fn gunbc_ci_spark_wireless_link_converge_invoke() -> String {
  gunbc_run_step_script_with_prelude(
    prelude: gunbc_ci_spark_grant_install_credential_prelude(),
    source_roots: witness_layer_roots,
    entry: gunbc_ci_spark_wireless_link_converge_target.entry,
    function: gunbc_ci_spark_wireless_link_converge_target.function,
    claim_run: false,
    receipt_rel: "target/spark-wireless-link-converge-receipt.txt"
  )
}

fn gunbc_ci_spark_grant_install_invoke() -> String {
  gunbc_run_step_script_with_prelude(
    prelude: gunbc_ci_spark_grant_install_credential_prelude(),
    source_roots: witness_layer_roots,
    entry: gunbc_ci_spark_grant_install_target.entry,
    function: gunbc_ci_spark_grant_install_target.function,
    claim_run: false,
    receipt_rel: "target/spark-grant-install-receipt.txt"
  )
}

fn gunbc_ci_spark_serving_apply_invoke() -> String {
  spark_serving_retired_refuse_script
}

fn gunbc_ci_spark_native_serving_apply_invoke() -> String {
  spark_serving_retired_refuse_script
}
