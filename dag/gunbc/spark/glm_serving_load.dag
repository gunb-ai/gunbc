module gunbc.spark.glm_serving_load

import std.types { NonEmptyStr, String }
import std.nat { Nat }
import std.measure { token_count }
import v2.std.optional { Present, Absent }
import std.process { ProcessExit, exit_failure }
import extdeps.vllm.bench_serve {
  VllmBenchServeRequest, SendAllImmediately, RandomDatasetSpec, OpenaiChat, vllm_bench_serve_request, vllm_bench_backend_route,
}
import extdeps.vllm.server { vllm_route_path }
import extdeps.vllm.engine_args { SpeculativeDecodingOff }
import extdeps.vllm.kv_layout { AdmissionCost, AdmissionCostUnestablished }
import gunbc.fleet_intent_network { srv9_host_lan_endpoint }
import gunbc.fleet_host_identity { operator_host_srv9 }
import gunbc.spark.serving_arm {
  glm53_native_fp8_row, runtime_artifact_wire, serving_runtime_row,
}
import gunbc.spark.fabric_serving_assignment { glm_group_b_serving_assignment }
import gunbc.spark.group_b_serving_capacity { group_b_restoration_profile, group_b_restoration_serve_port, group_b_restoration_served_alias }
import gunbc.spark.serving_arm_launch { glm_native_container_name, glm_native_weights_container_dir }
import gunbc.spark.model_snapshot_acquisition { snapshot_install_path, HubCachePlacement }
import gunbc.spark.serving_performance_subject {
  ServingPerformanceSubject, serving_subject_for_launch, serving_subject_standing, ServingPerformanceSubjectStanding,
}
import gunbc.spark.glm_group_b_relaunch_cli { with_group_b_access, rank_context }
import gunbc.spark.fabric_switch_observed { FabricGroupB }
import gunbc.spark.serving_load_probe {
  ClientRateQualificationFrontier, client_rate_qualification_frontier,
  ProtectedSubjectField, protected_subject_field,
}
import gunbc.spark.serving_load_runner { ServingLoadSubject, serving_load_run }
//
// GLM's serving-load facts and its binding of the shared runner (gunbc.spark.serving_load_runner):
// the live subject, protocol, admission standing and qualification frontier are GLM's numbers;
// the engineering that measures them is shared. Access is group B's bracket; the one step is the
// c=2 smoke protocol. A non-idle drain REFUSES the start; an idle start is
// WindowIsolationNotEstablished.
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/spark/glm_serving_load.dag --function glm_native_serving_load_wet

data glm_native_serving_load_receipt_path: String = "target/glm-native-serving-load-observation.txt"
data glm_native_serving_load_attempt_raw: String = "glm-native-serving-load"

data glm_native_qualification_frontier: ClientRateQualificationFrontier = client_rate_qualification_frontier(
  request_start_events: "per-request start events so ArrivalSkewObserved can be minted; SendAllImmediately stays ArrivalSkewUnread until that producer exists" as NonEmptyStr,
  reserved_window: "subject-bound LeaseGrant and ExclusionEstablished over ProtectedSubjectField; the follow-up PR needs the operator to grant an exclusive Group B window" as NonEmptyStr,
  interval_occupancy: "occupancy as a time-series over the client interval; BoundaryOccupancyReceipt is two scrapes and cannot count positively" as NonEmptyStr,
  serve_py_digest: "bind vllm_bench_serve_source_standing to the serve.py file or package digest inside the running image, or an explicit policy that admits TranscribedUncited" as NonEmptyStr,
)

// ── ADMISSION FOR THE SESSIONS THIS FLEET ACTUALLY SERVES ─────────────────────────────────────
//
// Real sessions sit at ~100k-130k tokens of context after compacting a 262k window. They idle
// between turns. Each turn is a separate request whose KV frees on completion while the prefix
// stays in the prefix cache. A 100k-prefix load protocol is not modeled here: it is the heaviest
// prefill this arm can construct, and it waits on the qualification window (exact lease and
// exclusion, idle drain, protected subject).
//
// THAT IS NOT AN ADMISSION CAPACITY. vLLM's printed token pool is floor(max_concurrency ×
// max_model_len) — the same fact twice — and GLM's hybrid KV (full / sliding-window / Mamba) does
// not scale linearly with sequence length. Dividing the pool by 100k–130k overestimates concurrent
// sessions. Live per-request cost is extdeps.vllm.kv_layout cold_admission_blocks; with an empty
// group roster that fold is AdmissionCostUnestablished, which is the honest state today.

data glm_native_workload_admission: AdmissionCost = AdmissionCostUnestablished {
  cause: "the live cache-group roster is unobserved, so cold_admission_blocks cannot establish per-request cost; a token-pool divided by request length is not an admission capacity" as NonEmptyStr
}

data glm_native_engine_tokenizer_path: NonEmptyStr = snapshot_install_path(
  placement: HubCachePlacement { cache_root: glm_native_weights_container_dir },
  repo: glm53_native_fp8_row.repo,
  revision: glm53_native_fp8_row.revision,
)

data glm_native_sweep_dataset: RandomDatasetSpec = RandomDatasetSpec {
  input_len: token_count(count: 256),
  output_len: token_count(count: 128),
  prefix_len: token_count(count: 0),
}

data glm_native_bench_seed: Nat = 20260918

// The loopback base URL both the bench client and the metrics scrape address, from the profile's port.
fn glm_native_serve_base_url() -> NonEmptyStr {
  join(["http://127.0.0.1:", to_string(group_b_restoration_serve_port)], "") as NonEmptyStr
}

// The live probe's protocol: 256-in/128-out, SendAllImmediately, c=2. SendAllImmediately is wiring,
// not a comparable rate protocol (arrival skew is unread). The derived rate counts completed output
// tokens; bench-serve's total token throughput also counts prefill and answers a different question.
data glm_native_smoke_protocol: VllmBenchServeRequest = vllm_bench_serve_request(
  backend: OpenaiChat,
  base_url: glm_native_serve_base_url(),
  model: group_b_restoration_served_alias,
  tokenizer: glm_native_engine_tokenizer_path,
  dataset: glm_native_sweep_dataset,
  num_prompts: 4,
  arrival: SendAllImmediately,
  max_concurrency: Present { value: 2 },
  ignore_eos: true,
  seed: glm_native_bench_seed,
)

// THE LIVE SUBJECT IS THE LAUNCH'S, DERIVED. It was a hand-built row reading glm_native_concurrent_profile
// -- sixteen sequences -- while the arm launches group_b_restoration_profile, so the subject described a
// configuration that never ran, and named the base derived runtime while the group serves KvplanV2.
// Now checkpoint, runtime and topology are the fabric assignment's (the planner's own input) and every
// launch axis is read off the executable profile the launch renders, through
// gunbc.spark.serving_performance_subject serving_subject_for_launch -- the same constructor the
// DeepSeek V4.1 subject uses. Absent means the capacity intent refused, so there is no launch to
// describe and the load run refuses with it.
fn glm_native_live_subject() -> ServingPerformanceSubject? {
  let a = glm_group_b_serving_assignment
  match group_b_restoration_profile() {
    Absent => none
    Present { value: p } =>
      match serving_runtime_row(r: a.runtime) {
        Absent => none
        Present { value: rrow } => Present { value: serving_subject_for_launch(
          checkpoint_revision: Present { value: glm53_native_fp8_row.revision },
          runtime: a.runtime,
          runtime_image_reference: runtime_artifact_wire(a: rrow.artifact),
          topology: a.topology,
          profile: p,
          collective_transport: none,
        ) }
      }
  }
}

fn glm_native_live_subject_standing() -> ServingPerformanceSubjectStanding? {
  match glm_native_live_subject() {
    Absent => none
    Present { value: subject } => Present { value: serving_subject_standing(
      subject: subject,
      believed: "the launch axes are the executable profile's as rendered; collective transport is unread on this incarnation" as NonEmptyStr,
      would_settle: "read the running launch's NCCL transport announcement on this incarnation" as NonEmptyStr,
    ) }
  }
}

fn glm_native_protected_subject() -> ProtectedSubjectField? {
  match glm_native_live_subject() {
    Absent => none
    Present { value: subject } => Present { value: protected_subject_field(
      subject: subject,
      served_alias: group_b_restoration_served_alias,
      route: vllm_route_path(r: vllm_bench_backend_route(b: glm_native_smoke_protocol.backend)),
    ) }
  }
}

fn glm_native_serving_load_subject() -> ServingLoadSubject? {
  match glm_native_live_subject_standing() {
    Absent => none
    Present { value: standing } => Present { value: ServingLoadSubject {
      host: operator_host_srv9,
      host_address: srv9_host_lan_endpoint.address,
      group: FabricGroupB,
      container: glm_native_container_name,
      base_url: glm_native_serve_base_url(),
      served_alias: group_b_restoration_served_alias,
      standing: standing,
      admission: glm_native_workload_admission,
      qualification_frontier: glm_native_qualification_frontier,
      principal: "group-B administrator" as NonEmptyStr,
      receipt_heading: "glm native serving-load wet" as NonEmptyStr,
      receipt_path: glm_native_serving_load_receipt_path,
    } }
  }
}

fn glm_native_serving_load_wet() -> ProcessExit
{
  with_group_b_access(use: fn(trust, path, administrator, file) {
    let ctx = rank_context(host: operator_host_srv9, trust: trust, path: path, administrator: administrator, credential_file: file)
    match glm_native_serving_load_subject() {
      Absent => exit_failure(reason: "the Group B restoration capacity intent refused, so no launched profile exists to measure")
      Present { value: subject } => serving_load_run(ctx: ctx, subject: subject, steps: [glm_native_smoke_protocol])
    }
  }, attempt_raw: glm_native_serving_load_attempt_raw, credential_file_name: "gunbc-glm-native-serving-load-admin-password" as NonEmptyStr)
}
