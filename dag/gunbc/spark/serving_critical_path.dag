module gunbc.spark.serving_critical_path

import std.types { Bool, String, Int, NonEmptyStr, List }
import std.nat { Nat }
import v2.std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.nvidia.com/dgx/dgx-spark/hardware.html" }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef { module_path: "gunbc.spark.serving_critical_path", decl_name: "PowerEnvelope", field: WholeDeclaration }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

// ── THE POWER ENVELOPES, NESTED, BECAUSE ADDING THEM IS THE FIRST MISTAKE ─────────────────────
//
// A 240W figure is the EXTERNAL POWER SUPPLY. The GB10 SoC TDP is 140W and covers the integrated
// CPU and GPU together; the GPU alone draws up to roughly 120W, and about 100W is available to the
// rest of the system. The 120W is NESTED INSIDE the 140W, not an additional allocation on top of it.
//
// This matters because the denominator decides the reading. nvidia-smi reports GPU power -- not
// wall, not CPU, not the ConnectX-7, not storage -- so an observed 36-44W is roughly 30-37% of the
// GPU ceiling. Low, but not the far more dramatic fraction a 240W denominator would suggest.
type PowerEnvelope {
  watts: Nat
  covers: NonEmptyStr
}

data spark_system_power_supply: PowerEnvelope = PowerEnvelope { watts: 240, covers: "external power supply for the whole unit" as NonEmptyStr }
data spark_soc_thermal_envelope: PowerEnvelope = PowerEnvelope { watts: 140, covers: "GB10 SoC TDP, integrated CPU and GPU together" as NonEmptyStr }
data spark_gpu_power_envelope: PowerEnvelope = PowerEnvelope { watts: 120, covers: "GPU alone, the denominator nvidia-smi power.draw belongs to; nested inside the 140W SoC envelope" as NonEmptyStr }
data spark_peripheral_power_envelope: PowerEnvelope = PowerEnvelope { watts: 100, covers: "other system components" as NonEmptyStr }

// ── WHAT THE TRACE OBSERVED, AS OBSERVATIONS ──────────────────────────────────────────────────
//
// Read-only sampling of all four group A ranks across one controlled cold prefill: nvidia-smi
// utilisation, power and SM clock plus the RoCE transmit counter every 250ms, ~840 samples per rank,
// launch invocation re-read before and after and unchanged.
//
//     rank    util-med  util<50%  power-med  power-max  sm-clock  roce
//     .225       96%       2%       36.6W      42.9W     2398MHz  232.7 GB  7.80 Gb/s
//     .226       96%       1%       36.1W      41.8W     2411MHz  235.8 GB  7.87 Gb/s
//     .232       96%       1%       36.1W      41.9W     2411MHz  235.4 GB  7.87 Gb/s
//     .233       96%       1%       37.8W      43.9W     2405MHz  233.6 GB  7.80 Gb/s
type CriticalPathObservation
  = GpuKernelBusyFraction { percent: Nat }
  | GpuReportedPowerDraw { median_watts: Nat, max_watts: Nat }
  | GpuClockObservation { median_mhz: Nat }
  | RoceByteRate { gigabits_per_second_tenths: Nat, link_gigabits: Nat }
  | RankCoarseSymmetry { power_spread_deciwatts: Nat, util_spread_percent: Nat }

data spark_group_a_cold_prefill_observations: List<CriticalPathObservation> = [
  GpuKernelBusyFraction { percent: 96 },
  GpuReportedPowerDraw { median_watts: 36, max_watts: 44 },
  GpuClockObservation { median_mhz: 2408 },
  RoceByteRate { gigabits_per_second_tenths: 78, link_gigabits: 50 },
  RankCoarseSymmetry { power_spread_deciwatts: 17, util_spread_percent: 0 },
]

// ── THE CONSTRUCTION RULES THAT MAKE LAST WEEK'S INFERENCE UNWRITABLE ─────────────────────────
//
// nvidia-smi utilisation is the percentage of the sample period during which one or more kernels
// were executing. It is not FLOPs, not Tensor Core throughput, not SM occupancy, not memory
// bandwidth, not issue bandwidth and not power. So it establishes that kernels were active and
// nothing about whether the GPU was used well.
//
// An earlier version of this module wrote that kernels are present and not computing, and excluded
// compute saturation because power did not rise with load. Both were wrong. The kernels ARE
// executing, and low whole-GPU power does not exclude saturation of a NARROW bottleneck: a kernel
// can fully occupy the unit that limits it while leaving most of the chip idle and the power draw
// modest. The two rules below make that inference unwritable rather than merely discouraged.
type SaturationClaim
  = GpuComputeSaturated
  | GpuComputeUnderutilised

type ClaimConstruction
  = ClaimConstructible { from: NonEmptyStr }
  | ClaimNotConstructible { because: NonEmptyStr }

fn busy_fraction_constructs(claim: SaturationClaim) -> ClaimConstruction {
  match claim {
    GpuComputeSaturated =>
      ClaimNotConstructible { because: "kernel busy fraction counts residency, not work: 96% means kernels were almost always executing and says nothing about FLOPs, occupancy, memory bandwidth or stalls" as NonEmptyStr }
    GpuComputeUnderutilised =>
      ClaimNotConstructible { because: "the same reading is equally consistent with a fully saturated narrow bottleneck; residency cannot distinguish a busy chip from a busy corner of one" as NonEmptyStr }
  }
}

fn power_below_ceiling_excludes_saturation() -> ClaimConstruction {
  ClaimNotConstructible {
    because: "36-44W against a ~120W GPU ceiling is low, but a kernel bound on one unit -- memory, issue, dependency latency, or a collective wait -- saturates that unit while the package draws modestly; the power reading bounds whole-chip utilisation and not the critical path" as NonEmptyStr
  }
}

// ── HOW PREFILL COST GROWS ACROSS TEN WINDOWS ON A SHARED ENGINE ──────────────────────────────
//
// The earlier cost model here was two handwritten numbers, 250ms fixed and 950 tok/s marginal, fitted
// by hand to six points. It is replaced by the samples themselves, because a handwritten rate cannot
// be falsified by adding a measurement and a derived one can.
//
// WHAT THE SAMPLES ARE BOUND TO MATTERS AS MUCH AS THEIR VALUES. A bare global list of rows is not a
// subject: a row taken from another launch, another runtime image, another scheduler budget or the
// other engine group could join it and silently move the fit. So the rows hang off one experiment
// carrying the launch, the provenance standing, the acquisition procedure and -- critically -- the
// standing of the EFFECTIVE scheduler configuration, which was never read back from the running
// engine and therefore is not known.
type EffectiveSchedulerConfigStanding
  = EffectiveSchedulerConfigRead { max_num_batched_tokens: Nat, source: NonEmptyStr }
  | EffectiveSchedulerConfigUnread { because: NonEmptyStr }

type ConcurrencyWitness {
  max_running: Nat
  max_waiting: Nat
}

// max_running COUNTS THE PROBE ITSELF. A window with max_running of 1 therefore had NO co-tenant, and
// an earlier version of this module read that field as though 1 meant one other request -- which made
// the claim that a co-tenant was present throughout the sweep false for the 1551-token window and
// unproven everywhere it was asserted from the field alone. The predicate below is the reading.
fn co_tenant_present(c: ConcurrencyWitness) -> Bool {
  c.max_running > 1 || c.max_waiting > 0
}

type PrefillScalingSample {
  sequence: Nat
  computed_tokens: Nat
  cached_tokens: Nat
  iteration_delta: Nat
  wall_micros: Nat
  concurrency: ConcurrencyWitness
}

// ── WHAT ADMISSION ACTUALLY ESTABLISHES, WHICH IS MUCH LESS THAN ISOLATION ────────────────────
//
// A zero cached-token delta establishes exactly one thing: no foreign prefix booking was accounted in
// this window. It does NOT establish that the probe ran alone. A co-tenant can contribute uncached
// prefill tokens that contaminate the computed-token delta, decode work that costs wall time while
// booking nothing, or scheduler and collective interference; and a request that stays active without
// completing a booking leaves no trace here at all. In the other direction the rule is too strict:
// a future probe with legitimate cache reuse of its own would be rejected as foreign.
//
// So the standing an admitted sample earns is NoForeignCachedBookingObserved, and the fit built from
// those samples is a SHARED-ENGINE DESCRIPTIVE FIT. ProbeWorkIsolated is a separate standing that
// nothing in this population attains, and it is what an isolated fit would require.
type SampleStanding
  = ProbeWorkIsolated
  | NoForeignCachedBookingObserved
  | ForeignCachedBookingObserved { cached_tokens: Nat }

fn sample_standing(s: PrefillScalingSample) -> SampleStanding {
  if s.cached_tokens > 0 {
    ForeignCachedBookingObserved { cached_tokens: s.cached_tokens }
  } else {
    NoForeignCachedBookingObserved
  }
}

// PROBE ISOLATION IS DECIDABLE FROM WHAT WAS RECORDED: the probe alone running, nothing waiting, and
// no foreign booking. Exactly ONE of the twelve windows satisfies it, the 1551-token one. That is not
// enough to fit anything -- a single point determines neither a slope nor an intercept -- so the fit
// stays a shared-engine description, and the isolated population is a sample of one rather than
// empty. The rerun's job is to make that population large enough to fit.
fn probe_isolation_admissible(s: PrefillScalingSample) -> Bool {
  s.cached_tokens == 0 && s.concurrency.max_running == 1 && s.concurrency.max_waiting == 0
}

type PrefillScalingExperiment {
  launch: NonEmptyStr
  acquisition: NonEmptyStr
  scheduler_config: EffectiveSchedulerConfigStanding
  ordered_samples: List<PrefillScalingSample>
}

// The sequence field records EXECUTION order, which is not the order the rows are written in. The
// sweep interleaved sizes so that drift and warm-up could not align with size; without the field that
// interleaving is a claim in prose that the model cannot distinguish from a sorted run on a drifting
// machine.
data spark_group_a_prefill_scaling_experiment: PrefillScalingExperiment = PrefillScalingExperiment {
  launch: "group A head 192.168.1.225, systemd invocation re-read before and after the sweep and unchanged" as NonEmptyStr,
  acquisition: "one chat completion per window with a 32-character random nonce and random six-letter words so nothing is served from cache, max_tokens 1; computed and cached token deltas read from the served counters either side, running and waiting polled every 300ms throughout" as NonEmptyStr,
  scheduler_config: EffectiveSchedulerConfigUnread {
    because: "max_num_batched_tokens was never read back from the running engine; 2048 is the value the fallback would select, which is a nominal expectation and not an observation, and extdeps.vllm.engine_args already rules that an omitted argument determines no effective value" as NonEmptyStr
  },
  ordered_samples: [
    PrefillScalingSample { sequence: 1, computed_tokens: 1491, cached_tokens: 249344, iteration_delta: 7, wall_micros: 1320000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 2, computed_tokens: 2062, cached_tokens: 0, iteration_delta: 6, wall_micros: 2370000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 3, computed_tokens: 516, cached_tokens: 0, iteration_delta: 4, wall_micros: 700000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 4, computed_tokens: 4117, cached_tokens: 0, iteration_delta: 6, wall_micros: 4550000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 5, computed_tokens: 1551, cached_tokens: 0, iteration_delta: 4, wall_micros: 1740000, concurrency: ConcurrencyWitness { max_running: 1, max_waiting: 0 } },
    PrefillScalingSample { sequence: 6, computed_tokens: 2769, cached_tokens: 249600, iteration_delta: 4, wall_micros: 3250000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 7, computed_tokens: 8191, cached_tokens: 0, iteration_delta: 9, wall_micros: 8790000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 8, computed_tokens: 1927, cached_tokens: 0, iteration_delta: 4, wall_micros: 2120000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 9, computed_tokens: 4119, cached_tokens: 0, iteration_delta: 7, wall_micros: 4580000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 10, computed_tokens: 3885, cached_tokens: 0, iteration_delta: 5, wall_micros: 4160000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 11, computed_tokens: 2052, cached_tokens: 0, iteration_delta: 6, wall_micros: 2340000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 12, computed_tokens: 518, cached_tokens: 0, iteration_delta: 5, wall_micros: 730000, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
  ],
}

// THE 290-SECOND POINT IS RETAINED RATHER THAN DELETED. It is inadmissible to any fit and it is the
// only direct evidence of how large a delay accompanied a co-tenant, so dropping it would discard the
// one observation that shows what that can look like. It is NOT a causal estimate of co-tenant cost:
// one event beside one co-tenant does not attribute the delay to the co-tenant.
type ScalingSampleExcludedFromFit {
  computed_tokens: Nat
  wall_micros: Nat
  cause: NonEmptyStr
}

data spark_group_a_co_tenant_outlier: ScalingSampleExcludedFromFit = ScalingSampleExcludedFromFit {
  computed_tokens: 4840,
  wall_micros: 290960000,
  cause: "a co-tenant was running; 290.96s against a described 5.3s, roughly 55x, while a larger 8191-token window at the same co-tenant count sat on the curve -- so this is an extreme event observed beside a co-tenant, not a measured co-tenant cost" as NonEmptyStr,
}

// ── THE DESCRIPTIVE FIT IS DERIVED FROM THE SAMPLES ───────────────────────────────────────────
//
// Ordinary least squares over the admitted samples, in microseconds so integers carry it. Nobody can
// edit the marginal rate here: it is a projection of the sample population, and adding a measurement
// that disagrees moves it. What it describes is ten windows on a shared engine under this workload
// family -- not isolated request cost.
fn admitted_scaling_samples() -> List<PrefillScalingSample> {
  filter(spark_group_a_prefill_scaling_experiment.ordered_samples, s =>
    match sample_standing(s: s) {
      ForeignCachedBookingObserved { cached_tokens: _ } => false
      NoForeignCachedBookingObserved => true
      ProbeWorkIsolated => true
    })
}

type AffineFit {
  intercept_micros: Int
  micros_per_thousand_tokens: Int
  sample_count: Nat
}

type PrefillScalingStanding
  = SharedEngineAffineDescription { fit: AffineFit }
  | ScalingUnderObserved { cause: NonEmptyStr }

fn prefill_scaling_standing() -> PrefillScalingStanding {
  let xs = admitted_scaling_samples()
  let n = length(xs)
  if n < 4 {
    ScalingUnderObserved { cause: "fewer than four admitted samples cannot separate a fixed term from a slope" as NonEmptyStr }
  } else {
    let sx = fold(xs, init: 0, f: (a, s) => a + s.computed_tokens)
    let sy = fold(xs, init: 0, f: (a, s) => a + s.wall_micros)
    let sxx = fold(xs, init: 0, f: (a, s) => a + (s.computed_tokens * s.computed_tokens))
    let sxy = fold(xs, init: 0, f: (a, s) => a + (s.computed_tokens * s.wall_micros))
    let denom = (n * sxx) - (sx * sx)
    if denom == 0 {
      ScalingUnderObserved { cause: "every admitted sample carries the same token count, so no slope is determined" as NonEmptyStr }
    } else {
      let slope_milli = (((n * sxy) - (sx * sy)) * 1000) / denom
      SharedEngineAffineDescription {
        fit: AffineFit {
          intercept_micros: (sy - ((slope_milli * sx) / 1000)) / n,
          micros_per_thousand_tokens: slope_milli,
          sample_count: n,
        },
      }
    }
  }
}

fn predicted_micros(fit: AffineFit, tokens: Nat) -> Int {
  fit.intercept_micros + ((fit.micros_per_thousand_tokens * tokens) / 1000)
}

fn abs_int(x: Int) -> Int {
  if x < 0 { 0 - x } else { x }
}

fn affine_worst_residual_micros(fit: AffineFit) -> Int {
  fold(admitted_scaling_samples(), init: 0, f: (worst, s) => {
    let e = abs_int(x: predicted_micros(fit: fit, tokens: s.computed_tokens) - s.wall_micros)
    if e > worst { e } else { worst }
  })
}

// ── WHY THE PER-STEP TERM IS NOT BOUNDED, AND THE COUNTEREXAMPLE THAT SETTLES IT ──────────────
//
// An earlier version of this module declared the per-step fixed cost bounded above by 95ms and not
// distinguishable from zero, reasoning that crossing 1927 to 2052 computed tokens cost about 88ms of
// unexplained time while the affine fit's worst residual was about 95ms. That reasoning is invalid,
// and the samples themselves refute it.
//
// A THREE-TERM FIT OVER THE SAME TEN ROWS, adding a step count, lands at roughly 54ms fixed per
// request, 1.003us per token and 126ms PER STEP -- with a worst residual near 42ms, less than half
// the affine fit's. So the same data admits a per-step term LARGER than the claimed upper bound while
// describing the measurements better. A model's residual error does not bound a term that model
// omitted; the omitted term is part of what produces the residual.
//
// The alternative's coefficients are declared rather than derived because it is a COUNTEREXAMPLE, not
// an authority: its job is to be worse-or-better than the affine fit on the same rows, and the
// comparison is computed. If the affine fit ever became the better description, the check goes red.
type StepAwareFitCandidate {
  intercept_micros: Int
  micros_per_thousand_tokens: Int
  micros_per_step: Int
  nominal_budget_tokens: Nat
}

data spark_group_a_step_aware_alternative: StepAwareFitCandidate = StepAwareFitCandidate {
  intercept_micros: 54300,
  micros_per_thousand_tokens: 1002544,
  micros_per_step: 126300,
  nominal_budget_tokens: 2048,
}

fn nominal_steps(tokens: Nat, budget: Nat) -> Nat {
  let b = if budget == 0 { budget + 1 } else { budget }
  ((tokens + b) - 1) / b
}

fn step_aware_predicted_micros(c: StepAwareFitCandidate, tokens: Nat) -> Int {
  c.intercept_micros
    + ((c.micros_per_thousand_tokens * tokens) / 1000)
    + (c.micros_per_step * nominal_steps(tokens: tokens, budget: c.nominal_budget_tokens))
}

fn step_aware_worst_residual_micros(c: StepAwareFitCandidate) -> Int {
  fold(admitted_scaling_samples(), init: 0, f: (worst, s) => {
    let e = abs_int(x: step_aware_predicted_micros(c: c, tokens: s.computed_tokens) - s.wall_micros)
    if e > worst { e } else { worst }
  })
}

// THE STANDING THAT SURVIVES. The excess exists and was measured; what it means does not follow from
// these observations, and the confounders are named rather than waved at.
type PerStepCostStanding
  = PerStepCostBounded { upper_micros: Nat }
  | NominalBoundaryEffectUnidentified { observed_excess_micros: Nat, confounded_by: List<NonEmptyStr> }

data spark_group_a_per_step_cost_standing: PerStepCostStanding = NominalBoundaryEffectUnidentified {
  observed_excess_micros: 88000,
  confounded_by: [
    "the per-request scheduler step count was never observed; engine-wide iteration deltas of 4 and 6 across the two windows are not per-request step allocations, and on a shared engine a decoder consumes part of the budget so even a sub-budget probe can span more than one step" as NonEmptyStr,
    "the effective max_num_batched_tokens was never read back, so 2048 is a nominal threshold rather than an observed boundary" as NonEmptyStr,
    "a three-term fit over the same rows admits a 126ms per-step term with a smaller worst residual, so the affine residual does not bound the omitted term" as NonEmptyStr,
    "nine of the ten admitted windows had a co-tenant running, so window-to-window variation is not attributable to the probe alone" as NonEmptyStr,
  ],
}

// ── THE BUDGET COUNTERFACTUAL IS WITHDRAWN, NOT WEAKENED ──────────────────────────────────────
//
// This module previously derived a budget trade from the fit and the withdrawn per-step bound. It was
// wrong three ways beyond its inputs. It counted steps as prompt/budget + 1, which overcounts exact
// multiples. Its zero-per-step-cost lower bound billed steps x budget rather than the actual prompt,
// so it charged for padding in the final partial step -- and consequently moved by 0.54s between a
// 512 and a 2048 budget while assuming per-step cost was zero, contradicting the very assumption the
// lower bound encodes. And an unmeasured per-step cost collapsed to 0, turning missing evidence into
// a free operation, which is the absorbing fallback this program exists to refuse.
//
// The deeper defect is that it existed at all while the partition may not calibrate. The refusal was
// ornamental: a prediction path took a raw fit and answered anyway. It is withdrawn, and what it
// would need is carried instead. The marginal rate is also not established as INVARIANT across chunk
// shapes -- kernel and collective efficiency can both change with chunk size -- so a per-budget
// counterfactual needs per-budget measurements, not an extrapolation of one slope.
type BudgetTradeStanding
  = BudgetTradeUnestablished { missing: List<NonEmptyStr> }

data spark_group_a_budget_trade: BudgetTradeStanding = BudgetTradeUnestablished {
  missing: [
    "the effective scheduler configuration, read back from the running engine" as NonEmptyStr,
    "per-request scheduler step allocation, rather than an engine-wide iteration delta" as NonEmptyStr,
    "samples with probe work isolated or per-request attributed" as NonEmptyStr,
    "marginal cost measured at each candidate budget, since invariance across chunk shapes is not established" as NonEmptyStr,
    "a per-step cost standing, which is currently unidentified rather than bounded" as NonEmptyStr,
  ],
}

// ── MECHANISM STANDINGS, AT THE GRAIN THE EVIDENCE ACTUALLY DECIDES ───────────────────────────
//
// The previous version carried one lumped collective-latency candidate and demoted it because cost
// scales with tokens. That was too strong, and the error is worth naming: a collective's payload is
// an activation buffer whose size grows with the scheduled token population, so a token-proportional
// critical path is exactly what per-token collective work ALSO looks like. Proportionality separates
// nothing.
//
// What it does NOT do, either, is weaken the token-independent term. That was the second version's
// error: it read an affine fit's residual as a bound on the term the affine fit omitted. With the
// counterexample above standing, every mechanism here is either unobserved at this grain or
// unresolved, and one is observed.
type CriticalPathMechanism
  = GrossRankStraggler
  | HostDispatchGaps
  | BulkInterconnectBandwidth
  | TokenIndependentStepLatency
  | TokenProportionalCompute
  | TokenProportionalCollectivePayload
  | CollectiveSynchronisationWait
  | MemoryOrKernelEfficiency
  | PowerOrThermalThrottle
  | CoTenantDelay

type MechanismStanding
  = NotObservedAtThisGrain { by: NonEmptyStr }
  | Observed { by: NonEmptyStr }
  | Unresolved { needs: NonEmptyStr }

fn cold_prefill_mechanism_standing(m: CriticalPathMechanism) -> MechanismStanding {
  match m {
    GrossRankStraggler =>
      NotObservedAtThisGrain { by: "median power within 1.7W and median utilisation within 0% across four ranks; a per-step rank timing could still show one rank extending the critical path" as NonEmptyStr }
    HostDispatchGaps =>
      NotObservedAtThisGrain { by: "kernels active in 98-99% of 250ms samples, so long gaps between kernels are unlikely; sub-sample gaps are invisible at this grain" as NonEmptyStr }
    BulkInterconnectBandwidth =>
      NotObservedAtThisGrain { by: "7.8 Gb/s sustained on a 50 Gb/s link, and about 9.8 Gb/s within a step; bulk saturation is not present, which does not speak to latency" as NonEmptyStr }
    TokenIndependentStepLatency =>
      Unresolved { needs: "per-request step allocation and the effective scheduler budget; the 88ms excess across a nominal boundary is not attributable to a step transition that was never observed, and a three-term fit over the same rows admits a 126ms per-step term while describing them better" as NonEmptyStr }
    TokenProportionalCompute =>
      Unresolved { needs: "compute-kernel span attribution; token proportionality alone does not distinguish model compute from collective payload, and package power does not either" as NonEmptyStr }
    TokenProportionalCollectivePayload =>
      Unresolved { needs: "collective-kernel span attribution; an all-reduce over an activation buffer grows with the scheduled token population exactly as compute does, so it fits the observed proportionality equally well" as NonEmptyStr }
    CollectiveSynchronisationWait =>
      Unresolved { needs: "per-rank critical-path timing; waiting on a peer is invisible to the aggregate fit, to kernel residency and to package power alike" as NonEmptyStr }
    MemoryOrKernelEfficiency =>
      Unresolved { needs: "achieved-throughput or occupancy counters; a marginal rate near 950 tok/s at a third of the power ceiling is what a memory-bound or dequantisation-heavy path looks like, and equally what per-token collective work looks like" as NonEmptyStr }
    PowerOrThermalThrottle =>
      Unresolved { needs: "throttle-reason and temperature observations, neither of which this trace captured" as NonEmptyStr }
    CoTenantDelay =>
      Observed { by: "a decode-alone window compared against decode running beside a prefill is the controlled comparison that showed the delay; the 290.96s outlier is a consistent extreme event but attributes nothing on its own, and its magnitude is not parameterised" as NonEmptyStr }
  }
}

// ── THE PARTITION REMAINS UNRESOLVED, AND MAY NOT CALIBRATE ───────────────────────────────────
type PartitionRequirement
  = ComputeVersusCollectiveKernelSpans
  | PerRankCriticalPathTiming
  | OccupancyOrAchievedThroughput
  | ThrottleAndMemoryStallEvidence
  | EffectiveSchedulerConfigReadback
  | PerRequestStepAllocation
  | IsolatedOrAttributedScalingSamples

type CriticalPathPartition
  = PartitionIncomplete { missing: List<PartitionRequirement> }
  | PartitionEstablished { critical: CriticalPathMechanism, evidence: NonEmptyStr }

data spark_group_a_cold_prefill_partition: CriticalPathPartition = PartitionIncomplete {
  missing: [
    ComputeVersusCollectiveKernelSpans,
    PerRankCriticalPathTiming,
    OccupancyOrAchievedThroughput,
    ThrottleAndMemoryStallEvidence,
    EffectiveSchedulerConfigReadback,
    PerRequestStepAllocation,
    IsolatedOrAttributedScalingSamples,
  ],
}

fn partition_may_calibrate(p: CriticalPathPartition) -> Bool {
  match p {
    PartitionEstablished { critical: _, evidence: _ } => true
    PartitionIncomplete { missing: _ } => false
  }
}

// ── THE LINK QUESTION, DERIVED FROM THE PARTITION RATHER THAN ANSWERED ────────────────────────
//
// This was previously a function that ignored its argument and returned false, so "a faster link
// cannot help" was written as the answer rather than read from the evidence -- it would have kept
// saying no even for a partition established on bulk bandwidth. What the trace supports is narrower
// and is now what the function says: bulk saturation was not observed, so no link purchase is
// justified by it, and a partition that did establish bulk bandwidth would change the verdict.
type LinkUpgradeStanding
  = LinkUpgradeJustified { by: NonEmptyStr }
  | LinkUpgradeUnsupportedByCurrentEvidence { by: NonEmptyStr }

fn link_upgrade_standing(p: CriticalPathPartition) -> LinkUpgradeStanding {
  match p {
    PartitionEstablished { critical: c, evidence: e } =>
      match c {
        BulkInterconnectBandwidth => LinkUpgradeJustified { by: e }
        _ => LinkUpgradeUnsupportedByCurrentEvidence { by: "the established critical path is not bulk transfer, so link speed is not the lever" as NonEmptyStr }
      }
    PartitionIncomplete { missing: _ } =>
      LinkUpgradeUnsupportedByCurrentEvidence {
        by: "bulk saturation was not observed at any grain measured -- 7.8 Gb/s sustained and about 9.8 Gb/s within a step, on a 50 Gb/s link -- so a 100G or 200G breakout is not justified by this trace; that is weaker than a proof of no benefit under every eventual partition" as NonEmptyStr
      }
  }
}
