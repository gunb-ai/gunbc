module gunbc.spark.serving_critical_path

import std.types { Bool, String, Int, NonEmptyStr, List }
import std.nat { Nat }
import v2.std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import gunbc.spark.vllm_serving_launch { VllmServingLaunch }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.nvidia.com/dgx/dgx-spark/hardware.html" }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef { module_path: "gunbc.spark.serving_critical_path", decl_name: "PowerEnvelope", field: WholeDeclaration }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

// ── THE POWER ENVELOPES, NESTED, BECAUSE ADDING THEM IS THE FIRST MISTAKE ─────────────────────
//
// A 240W figure is the EXTERNAL POWER SUPPLY. The GB10 SoC TDP is 140W and covers the integrated
// CPU and GPU together; the GPU alone draws up to roughly 120W, and about 100W is available to the
// rest of the system. The 120W is NESTED INSIDE the 140W, not an additional allocation on top of it.
//
// This matters because the denominator decides the reading. nvidia-smi reports GPU power -- not
// wall, not CPU, not the ConnectX-7, not storage -- so an observed 36-44W is roughly 30-37% of the
// GPU ceiling. Low, but not the far more dramatic fraction a 240W denominator would suggest.
type PowerEnvelope {
  watts: Nat
  covers: NonEmptyStr
}

data spark_system_power_supply: PowerEnvelope = PowerEnvelope { watts: 240, covers: "external power supply for the whole unit" as NonEmptyStr }
data spark_soc_thermal_envelope: PowerEnvelope = PowerEnvelope { watts: 140, covers: "GB10 SoC TDP, integrated CPU and GPU together" as NonEmptyStr }
data spark_gpu_power_envelope: PowerEnvelope = PowerEnvelope { watts: 120, covers: "GPU alone, the denominator nvidia-smi power.draw belongs to; nested inside the 140W SoC envelope" as NonEmptyStr }
data spark_peripheral_power_envelope: PowerEnvelope = PowerEnvelope { watts: 100, covers: "other system components" as NonEmptyStr }

// ── WHAT THE TRACE OBSERVED, AS OBSERVATIONS ──────────────────────────────────────────────────
//
// Read-only sampling of all four group A ranks across one controlled cold prefill: nvidia-smi
// utilisation, power and SM clock plus the RoCE transmit counter every 250ms, ~840 samples per rank,
// launch invocation re-read before and after and unchanged.
//
//     rank    util-med  util<50%  power-med  power-max  sm-clock  roce
//     .225       96%       2%       36.6W      42.9W     2398MHz  232.7 GB  7.80 Gb/s
//     .226       96%       1%       36.1W      41.8W     2411MHz  235.8 GB  7.87 Gb/s
//     .232       96%       1%       36.1W      41.9W     2411MHz  235.4 GB  7.87 Gb/s
//     .233       96%       1%       37.8W      43.9W     2405MHz  233.6 GB  7.80 Gb/s
type CriticalPathObservation
  = GpuKernelBusyFraction { percent: Nat }
  | GpuReportedPowerDraw { median_watts: Nat, max_watts: Nat }
  | GpuClockObservation { median_mhz: Nat }
  | RoceByteRate { gigabits_per_second_tenths: Nat, link_gigabits: Nat }
  | RankCoarseSymmetry { power_spread_deciwatts: Nat, util_spread_percent: Nat }

data spark_group_a_cold_prefill_observations: List<CriticalPathObservation> = [
  GpuKernelBusyFraction { percent: 96 },
  GpuReportedPowerDraw { median_watts: 36, max_watts: 44 },
  GpuClockObservation { median_mhz: 2408 },
  RoceByteRate { gigabits_per_second_tenths: 78, link_gigabits: 50 },
  RankCoarseSymmetry { power_spread_deciwatts: 17, util_spread_percent: 0 },
]

// ── THE CONSTRUCTION RULES THAT MAKE LAST WEEK'S INFERENCE UNWRITABLE ─────────────────────────
//
// nvidia-smi utilisation is the percentage of the sample period during which one or more kernels
// were executing. It is not FLOPs, not Tensor Core throughput, not SM occupancy, not memory
// bandwidth, not issue bandwidth and not power. So it establishes that kernels were active and
// nothing about whether the GPU was used well.
//
// An earlier version of this module wrote that kernels are present and not computing, and excluded
// compute saturation because power did not rise with load. Both were wrong. The kernels ARE
// executing, and low whole-GPU power does not exclude saturation of a NARROW bottleneck: a kernel
// can fully occupy the unit that limits it while leaving most of the chip idle and the power draw
// modest. The two rules below make that inference unwritable rather than merely discouraged.
type SaturationClaim
  = GpuComputeSaturated
  | GpuComputeUnderutilised

type ClaimConstruction
  = ClaimConstructible { from: NonEmptyStr }
  | ClaimNotConstructible { because: NonEmptyStr }

fn busy_fraction_constructs(claim: SaturationClaim) -> ClaimConstruction {
  match claim {
    GpuComputeSaturated =>
      ClaimNotConstructible { because: "kernel busy fraction counts residency, not work: 96% means kernels were almost always executing and says nothing about FLOPs, occupancy, memory bandwidth or stalls" as NonEmptyStr }
    GpuComputeUnderutilised =>
      ClaimNotConstructible { because: "the same reading is equally consistent with a fully saturated narrow bottleneck; residency cannot distinguish a busy chip from a busy corner of one" as NonEmptyStr }
  }
}

fn power_below_ceiling_excludes_saturation() -> ClaimConstruction {
  ClaimNotConstructible {
    because: "36-44W against a ~120W GPU ceiling is low, but a kernel bound on one unit -- memory, issue, dependency latency, or a collective wait -- saturates that unit while the package draws modestly; the power reading bounds whole-chip utilisation and not the critical path" as NonEmptyStr
  }
}

// ── THE EFFECTIVE BATCH BUDGET, READ BEHAVIOURALLY BECAUSE IT COULD NOT BE READ ANY OTHER WAY ──
//
// Two earlier versions of this module reasoned from a scheduler budget of 2048 tokens. It was never
// observed: no served metric carries it, the process environment is unreadable unprivileged, and
// 2048 is what the fallback WOULD select. The first version treated it as fact; the second correctly
// downgraded it to nominal. Both were wrong to reason from it at all, and it is now measured.
//
// THE INSTRUMENT IS THE ENGINE ITSELF. On an IDLE engine the engine-wide iteration counter is the
// per-request step count, because no other request increments it. So the budget is the token count
// at which one iteration becomes two -- an observation of the EFFECTIVE value, needing no config
// read, no privileged access and no restart.
//
//     computed tokens   iterations
//              4,126        1
//              5,969        1
//              8,117        1
//             12,023        1
//             20,082        1
//
// No chunking occurs anywhere below 20,082 computed tokens. The budget is therefore at least that,
// which is an order of magnitude above the 2048 that three separate conclusions rested on, and well
// above the 8192 that the larger-memory default would have selected.
type EffectiveBatchBudget
  = BatchBudgetAtLeast { tokens: Nat, by: NonEmptyStr }
  | BatchBudgetExact { tokens: Nat, source: NonEmptyStr }
  | BatchBudgetUnobserved { because: NonEmptyStr }

data spark_group_a_effective_batch_budget: EffectiveBatchBudget = BatchBudgetAtLeast {
  tokens: 20082,
  by: "on an idle engine, where the engine-wide iteration counter is the per-request step count, a single 20,082-computed-token request completed in one iteration; no chunking was observed at any size probed from 512 upward" as NonEmptyStr,
}

// ── HOW PREFILL COST GROWS, ON AN IDLE ENGINE, IN A SINGLE STEP THROUGHOUT ────────────────────
//
// The earlier cost model here was two handwritten numbers fitted by hand to six points. It is
// replaced by the samples, because a handwritten rate cannot be falsified by adding a measurement
// and a derived one can.
//
// THE STEP-BOUNDARY PREMISE IS GONE, NOT WEAKENED. An earlier version built an experiment around
// crossing 1,927 to 2,052 computed tokens, read a 0.088s excess as a per-step fixed cost, and
// claimed it bounded above by the fit's residual. A later version withdrew the bound by fitting a
// three-term model with a 126ms per-step term that described the same rows better. Both are void:
// every window in this population, from 512 to 20,082 computed tokens, ran in ONE step. There was
// never a boundary to cross, so the excess measured nothing and the three-term model regressed
// against a step count that does not exist. What remains is one fixed per-request term and one
// proportional term, and no per-step term is separable from the fixed one in this range at all.
type ConcurrencyWitness {
  max_running: Nat
  max_waiting: Nat
}

// max_running COUNTS THE PROBE. A window with max_running of 1 therefore had NO co-tenant, and an
// earlier version read that field as though 1 meant one other request.
fn co_tenant_present(c: ConcurrencyWitness) -> Bool {
  c.max_running > 1 || c.max_waiting > 0
}

// PRE-WINDOW CONCURRENCY IS THE ARM SELECTOR, and it is recorded separately from the maximum during
// the window because they answer different questions: whether the engine was quiet when the request
// ARRIVED, and whether anything joined while it ran.
type PrefillScalingSample {
  sequence: Nat
  computed_tokens: Nat
  cached_tokens: Nat
  iteration_delta: Nat
  wall_micros: Nat
  arrived_with: ConcurrencyWitness
  concurrency: ConcurrencyWitness
}

type SampleStanding
  = ProbeAloneAtObservedConcurrencyGrain
  | NoForeignCachedBookingObserved
  | ForeignCachedBookingObserved { cached_tokens: Nat }

fn sample_standing(s: PrefillScalingSample) -> SampleStanding {
  if s.cached_tokens > 0 {
    ForeignCachedBookingObserved { cached_tokens: s.cached_tokens }
  } else {
    if s.arrived_with.max_running == 0 && s.arrived_with.max_waiting == 0 {
      ProbeAloneAtObservedConcurrencyGrain
    } else {
      NoForeignCachedBookingObserved
    }
  }
}

type EffectiveSchedulerConfigStanding
  = EffectiveSchedulerConfigRead { max_num_batched_tokens: Nat, source: NonEmptyStr }
  | EffectiveSchedulerConfigUnread { because: NonEmptyStr }

// THE LAUNCH BINDING IS A STANDING, NOT A STRING. gunbc.spark.vllm_serving_launch exists precisely so
// two observations can be compared by identity rather than by co-location, but these sweeps re-read
// only the systemd invocation and never captured the unit and base-image digests a VllmServingLaunch
// requires. Fabricating them to satisfy the type would be worse than not binding.
type ExperimentLaunchBinding
  = ExperimentLaunchBound { launch: VllmServingLaunch }
  | ExperimentLaunchUnbound { observed_invocation: NonEmptyStr, missing: NonEmptyStr }

type PrefillScalingExperiment {
  launch: ExperimentLaunchBinding
  acquisition: NonEmptyStr
  scheduler_config: EffectiveSchedulerConfigStanding
  ordered_samples: List<PrefillScalingSample>
}

type ExperimentJoinability
  = JoinableByLaunch { launch: VllmServingLaunch }
  | NotJoinable { because: NonEmptyStr }

fn experiment_joinability(e: PrefillScalingExperiment) -> ExperimentJoinability {
  match e.launch {
    ExperimentLaunchBound { launch: l } => JoinableByLaunch { launch: l }
    ExperimentLaunchUnbound { observed_invocation: _, missing: m } => NotJoinable { because: m }
  }
}

// One sweep of interleaved repeated sizes, then a boundary probe walking upward. Sequence is
// EXECUTION order: interleaving asserted only in prose cannot be distinguished from a sorted run on
// a drifting machine. A co-tenant arrived at sequence 7 and stayed, which is what makes the
// idle/co-tenant contrast below a within-experiment comparison rather than a cross-day one.
data spark_group_a_prefill_scaling_experiment: PrefillScalingExperiment = PrefillScalingExperiment {
  launch: ExperimentLaunchUnbound {
    observed_invocation: "group A head 192.168.1.225, unit gunbc-spark-pair-head.service, health 200 before and after" as NonEmptyStr,
    missing: "the unit digest and the unit-pinned base image digest were not captured during these sweeps, so no VllmServingLaunch can be constructed and these samples may not be joined by launch identity to any other observation" as NonEmptyStr,
  },
  acquisition: "one chat completion per window with a 32-character random nonce and random six-letter words so nothing is served from cache, max_tokens 1; computed and cached token deltas and the iteration count read from the served counters either side; running and waiting read once before the request and polled every 200ms throughout" as NonEmptyStr,
  scheduler_config: EffectiveSchedulerConfigUnread {
    because: "max_num_batched_tokens is carried by no served metric and the process environment is unreadable unprivileged; the effective value is instead bounded behaviourally by spark_group_a_effective_batch_budget" as NonEmptyStr
  },
  ordered_samples: [
    PrefillScalingSample { sequence: 1, computed_tokens: 1910, cached_tokens: 0, iteration_delta: 1, wall_micros: 2050000, arrived_with: ConcurrencyWitness { max_running: 0, max_waiting: 0 }, concurrency: ConcurrencyWitness { max_running: 0, max_waiting: 0 } },
    PrefillScalingSample { sequence: 2, computed_tokens: 512, cached_tokens: 0, iteration_delta: 1, wall_micros: 649000, arrived_with: ConcurrencyWitness { max_running: 0, max_waiting: 0 }, concurrency: ConcurrencyWitness { max_running: 0, max_waiting: 0 } },
    PrefillScalingSample { sequence: 3, computed_tokens: 4072, cached_tokens: 0, iteration_delta: 1, wall_micros: 4288000, arrived_with: ConcurrencyWitness { max_running: 0, max_waiting: 0 }, concurrency: ConcurrencyWitness { max_running: 1, max_waiting: 0 } },
