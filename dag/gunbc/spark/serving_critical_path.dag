// THE 290-SECOND POINT IS RETAINED RATHER THAN DELETED. It is inadmissible to any fit and remains the
// only observation of a delay that large. It is NOT a causal estimate: one event beside one co-tenant
// attributes nothing, and the contrast below is what actually measures co-tenant cost.
type ScalingSampleExcludedFromFit {
  computed_tokens: Nat
  wall_micros: Nat
  cause: NonEmptyStr
}

data spark_group_a_co_tenant_outlier: ScalingSampleExcludedFromFit = ScalingSampleExcludedFromFit {
  computed_tokens: 4840,
  wall_micros: 290960000,
  cause: "a co-tenant was running; 290.96s against a described 5.1s, roughly 57x, while larger windows at the same co-tenant count sat on the curve -- an extreme event observed beside a co-tenant, far outside the +130ms that the controlled contrast attributes to co-tenancy, and unexplained" as NonEmptyStr,
}

// ── THE FIT IS DERIVED FROM THE SAMPLES, PER ARM ──────────────────────────────────────────────
//
// Ordinary least squares in microseconds. Nobody can edit the marginal rate: it is a projection of
// the sample population, and adding a measurement that disagrees moves it.
type FitArm
  = ArrivedIdle
  | ArrivedWithCoTenant

fn sample_in_arm(s: PrefillScalingSample, arm: FitArm) -> Bool {
  if s.cached_tokens > 0 {
    false
  } else {
    match arm {
      ArrivedIdle => s.arrived_with.max_running == 0 && s.arrived_with.max_waiting == 0
      ArrivedWithCoTenant => s.arrived_with.max_running > 0 || s.arrived_with.max_waiting > 0
    }
  }
}

fn arm_samples(arm: FitArm) -> List<PrefillScalingSample> {
  filter(spark_group_a_prefill_scaling_experiment.ordered_samples, s => sample_in_arm(s: s, arm: arm))
}

type AffineFit {
  intercept_micros: Int
  micros_per_thousand_tokens: Int
  sample_count: Nat
}

type PrefillScalingStanding
  = AffineDescription { fit: AffineFit }
  | ScalingUnderObserved { cause: NonEmptyStr }

fn arm_fit(arm: FitArm) -> PrefillScalingStanding {
  let xs = arm_samples(arm)
  let n = length(xs)
  if n < 4 {
    ScalingUnderObserved { cause: "fewer than four admitted samples cannot separate a fixed term from a slope" as NonEmptyStr }
  } else {
    let sx = fold(xs, init: 0, f: (a, s) => a + s.computed_tokens)
    let sy = fold(xs, init: 0, f: (a, s) => a + s.wall_micros)
    let sxx = fold(xs, init: 0, f: (a, s) => a + (s.computed_tokens * s.computed_tokens))
    let sxy = fold(xs, init: 0, f: (a, s) => a + (s.computed_tokens * s.wall_micros))
    let denom = (n * sxx) - (sx * sx)
    if denom == 0 {
      ScalingUnderObserved { cause: "every admitted sample carries the same token count, so no slope is determined" as NonEmptyStr }
    } else {
      let slope_milli = (((n * sxy) - (sx * sy)) * 1000) / denom
      AffineDescription {
        fit: AffineFit {
          intercept_micros: (sy - ((slope_milli * sx) / 1000)) / n,
          micros_per_thousand_tokens: slope_milli,
          sample_count: n,
        },
      }
    }
  }
}

fn predicted_micros(fit: AffineFit, tokens: Nat) -> Int {
  fit.intercept_micros + ((fit.micros_per_thousand_tokens * tokens) / 1000)
}

fn abs_int(x: Int) -> Int {
  if x < 0 { 0 - x } else { x }
}

fn arm_worst_residual_micros(arm: FitArm, fit: AffineFit) -> Int {
  fold(arm_samples(arm), init: 0, f: (worst, s) => {
    let e = abs_int(x: predicted_micros(fit: fit, tokens: s.computed_tokens) - s.wall_micros)
    if e > worst { e } else { worst }
  })
}

// ── WHAT A CO-TENANT COSTS, MEASURED RATHER THAN OBSERVED ─────────────────────────────────────
//
// Both arms come from ONE sweep minutes apart on one launch with one instrument. A co-tenant arrived
// at sequence 7 and stayed, so the contrast is within-experiment: the same sizes, interleaved, either
// side of a change in engine occupancy nobody arranged.
//
//     arm            n    fixed      marginal          worst residual
//     arrived idle   12   ~0.08s     ~1.055 ms/token   ~0.09s
//     co-tenant       9   ~0.26s     ~1.032 ms/token   ~0.30s
//
// THE MARGINAL RATE IS INVARIANT. Within half a percent, a co-tenant does not slow the per-token
// work at all. The entire cost of co-tenancy lands in the FIXED per-request term, which roughly
// triples. That is a scheduling and queueing cost, not an execution one.
//
// The consequence is the sharpest thing this investigation has produced, and it is a limit as much as
// a finding: admission and routing -- the layers we own outright -- can recover the fixed term and
// nothing else. At 158,000 tokens the proportional term alone is about 167 seconds, and no amount of
// isolating that work makes it smaller. Only the inner execution layers can.
type CoTenantCostDecomposition {
  fixed_micros_added: Int
  marginal_percent_change: Int
  at_observed_concurrency: Nat
}

fn co_tenant_cost() -> CoTenantCostDecomposition? {
  match arm_fit(ArrivedIdle) {
    ScalingUnderObserved { cause: _ } => none
    AffineDescription { fit: i } =>
      match arm_fit(ArrivedWithCoTenant) {
        ScalingUnderObserved { cause: _ } => none
        AffineDescription { fit: b } =>
          Present { value: CoTenantCostDecomposition {
            fixed_micros_added: b.intercept_micros - i.intercept_micros,
            marginal_percent_change: ((b.micros_per_thousand_tokens - i.micros_per_thousand_tokens) * 100) / i.micros_per_thousand_tokens,
            at_observed_concurrency: 2,
          } }
      }
  }
}

// ── THE PER-STEP QUESTION IS DISSOLVED IN RANGE, NOT ANSWERED ─────────────────────────────────
//
// Every idle window ran in one step, so there is no second step anywhere in the measured range from
// which a per-step term could be distinguished from the per-request term. This is not a bound and not
// an estimate; the question does not arise below the budget, and above it nothing has been measured.
type PerStepCostStanding
  = PerStepCostBounded { upper_micros: Nat }
  | PerStepCostNotSeparable { because: NonEmptyStr, range_ceiling_tokens: Nat }

data spark_group_a_per_step_cost_standing: PerStepCostStanding = PerStepCostNotSeparable {
  because: "every idle window from 512 to 20,082 computed tokens completed in exactly one engine iteration, so no per-step term is distinguishable from the fixed per-request term anywhere in the measured range" as NonEmptyStr,
  range_ceiling_tokens: 20082,
}

// ── THE BUDGET COUNTERFACTUAL STAYS WITHDRAWN, FOR A NEW REASON ───────────────────────────────
//
// This module previously derived a budget trade from the fit and a withdrawn per-step bound, with
// arithmetic that overcounted steps at exact multiples and billed padded tokens in the final partial
// step -- so its zero-per-step-cost lower bound moved by half a second purely from changing the
// budget, contradicting its own assumption.
//
// It stays withdrawn, and the measurement has replaced the reason. The engine does not chunk in the
// range anyone would configure it toward, so a smaller budget is not a knob that is currently doing
// anything; and the marginal rate has not been measured AT any other budget, so extrapolating one
// slope across chunk shapes remains unfounded. Kernel and collective efficiency both change with
// chunk size.
type BudgetTradeStanding
  = BudgetTradeUnestablished { missing: List<NonEmptyStr> }

data spark_group_a_budget_trade: BudgetTradeStanding = BudgetTradeUnestablished {
  missing: [
    "the marginal rate measured AT each candidate budget, since invariance across chunk shapes is not established and one slope cannot be extrapolated across them" as NonEmptyStr,
    "a launch that actually chunks in the range of interest, since the effective budget is at least 20,082 tokens and nothing below it is chunked" as NonEmptyStr,
    "per-rank kernel spans, without which a smaller chunk cannot be predicted to cost more or less per token" as NonEmptyStr,
  ],
}

// ── MECHANISM STANDINGS, AT THE GRAIN THE EVIDENCE ACTUALLY DECIDES ───────────────────────────
//
// The previous version carried one lumped collective-latency candidate and demoted it because cost
// scales with tokens. That was too strong, and the error is worth naming: a collective's payload is
// an activation buffer whose size grows with the scheduled token population, so a token-proportional
// critical path is exactly what per-token collective work ALSO looks like. Proportionality separates
// nothing.
//
// What it does NOT do, either, is weaken the token-independent term. That was the second version's
// error: it read an affine fit's residual as a bound on the term the affine fit omitted. With the
// counterexample above standing, every mechanism here is either unobserved at this grain or
// unresolved, and one is observed.
type CriticalPathMechanism
  = GrossRankStraggler
  | HostDispatchGaps
  | BulkInterconnectBandwidth
  | FixedPerRequestCost
  | TokenProportionalCompute
  | TokenProportionalCollectivePayload
  | CollectiveSynchronisationWait
  | MemoryOrKernelEfficiency
  | PowerOrThermalThrottle
  | CoTenantDelay

type MechanismStanding
  = NotObservedAtThisGrain { by: NonEmptyStr }
  | Observed { by: NonEmptyStr }
  | Unresolved { needs: NonEmptyStr }

fn cold_prefill_mechanism_standing(m: CriticalPathMechanism) -> MechanismStanding {
  match m {
    GrossRankStraggler =>
      NotObservedAtThisGrain { by: "median power within 1.7W and median utilisation within 0% across four ranks; a per-step rank timing could still show one rank extending the critical path" as NonEmptyStr }
    HostDispatchGaps =>
      NotObservedAtThisGrain { by: "kernels active in 98-99% of 250ms samples, so long gaps between kernels are unlikely; sub-sample gaps are invisible at this grain" as NonEmptyStr }
    BulkInterconnectBandwidth =>
      NotObservedAtThisGrain { by: "7.8 Gb/s sustained on a 50 Gb/s link, and about 9.8 Gb/s within a step; bulk saturation is not present, which does not speak to latency" as NonEmptyStr }
    FixedPerRequestCost =>
      Observed { by: "about 0.08s per request on an idle engine, rising to about 0.26s when a co-tenant is present; measured as the intercept of each arm's fit, and the only term co-tenancy moves. It is not a per-STEP cost: every idle window in range ran in one step, so the two are not separable here" as NonEmptyStr }
    TokenProportionalCompute =>
      Unresolved { needs: "compute-kernel span attribution; token proportionality alone does not distinguish model compute from collective payload, and package power does not either" as NonEmptyStr }
    TokenProportionalCollectivePayload =>
      Unresolved { needs: "collective-kernel span attribution; an all-reduce over an activation buffer grows with the scheduled token population exactly as compute does, so it fits the observed proportionality equally well" as NonEmptyStr }
    CollectiveSynchronisationWait =>
      Unresolved { needs: "per-rank critical-path timing; waiting on a peer is invisible to the aggregate fit, to kernel residency and to package power alike" as NonEmptyStr }
    MemoryOrKernelEfficiency =>
      Unresolved { needs: "achieved-throughput or occupancy counters; a marginal rate near 950 tok/s at a third of the power ceiling is what a memory-bound or dequantisation-heavy path looks like, and equally what per-token collective work looks like" as NonEmptyStr }
    PowerOrThermalThrottle =>
      Unresolved { needs: "throttle-reason and temperature observations, neither of which this trace captured" as NonEmptyStr }
    CoTenantDelay =>
      Observed { by: "a within-experiment contrast across one sweep, either side of a co-tenant arriving: the marginal rate moves by under half a percent while the fixed per-request term roughly triples, so co-tenancy costs about 0.13s of scheduling latency per request at this concurrency and nothing per token. The 290.96s outlier is far outside that and stays unexplained" as NonEmptyStr }
  }
}

// ── THE PARTITION REMAINS UNRESOLVED, AND MAY NOT CALIBRATE ───────────────────────────────────
type PartitionRequirement
  = ComputeVersusCollectiveKernelSpans
  | PerRankCriticalPathTiming
  | OccupancyOrAchievedThroughput
  | ThrottleAndMemoryStallEvidence
  | HigherConcurrencyCoTenantParameterisation
  | ChunkedRegimeMeasurement

type CriticalPathPartition
  = PartitionIncomplete { missing: List<PartitionRequirement> }
  | PartitionEstablished { critical: CriticalPathMechanism, evidence: NonEmptyStr }

data spark_group_a_cold_prefill_partition: CriticalPathPartition = PartitionIncomplete {
  missing: [
    ComputeVersusCollectiveKernelSpans,
    PerRankCriticalPathTiming,
    OccupancyOrAchievedThroughput,
    ThrottleAndMemoryStallEvidence,
    HigherConcurrencyCoTenantParameterisation,
    ChunkedRegimeMeasurement,
  ],
}

fn partition_may_calibrate(p: CriticalPathPartition) -> Bool {
  match p {
    PartitionEstablished { critical: _, evidence: _ } => true
    PartitionIncomplete { missing: _ } => false
  }
}

// ── THE LINK QUESTION, DERIVED FROM THE PARTITION RATHER THAN ANSWERED ────────────────────────
//
// This was previously a function that ignored its argument and returned false, so "a faster link
// cannot help" was written as the answer rather than read from the evidence -- it would have kept
// saying no even for a partition established on bulk bandwidth. What the trace supports is narrower
// and is now what the function says: bulk saturation was not observed, so no link purchase is
// justified by it, and a partition that did establish bulk bandwidth would change the verdict.
type LinkUpgradeStanding
  = LinkUpgradeJustified { by: NonEmptyStr }
  | LinkUpgradeUnsupportedByCurrentEvidence { by: NonEmptyStr }

fn link_upgrade_standing(p: CriticalPathPartition) -> LinkUpgradeStanding {
  match p {
    PartitionEstablished { critical: c, evidence: e } =>
      match c {
        BulkInterconnectBandwidth => LinkUpgradeJustified { by: e }
        _ => LinkUpgradeUnsupportedByCurrentEvidence { by: "the established critical path is not bulk transfer, so link speed is not the lever" as NonEmptyStr }
      }
    PartitionIncomplete { missing: _ } =>
      LinkUpgradeUnsupportedByCurrentEvidence {
        by: "bulk saturation was not observed at any grain measured -- 7.8 Gb/s sustained and about 9.8 Gb/s within a step, on a 50 Gb/s link -- so a 100G or 200G breakout is not justified by this trace; that is weaker than a proof of no benefit under every eventual partition" as NonEmptyStr
      }
  }
}
