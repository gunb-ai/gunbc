    PrefillScalingSample { sequence: 5, computed_tokens: 1046, cached_tokens: 0, iteration_delta: 1, wall_micros: 1176000, arrived_with: ConcurrencyWitness { max_running: 0, max_waiting: 0 }, concurrency: ConcurrencyWitness { max_running: 0, max_waiting: 0 } },
    PrefillScalingSample { sequence: 6, computed_tokens: 9154, cached_tokens: 233728, iteration_delta: 4, wall_micros: 10050000, arrived_with: ConcurrencyWitness { max_running: 0, max_waiting: 0 }, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
