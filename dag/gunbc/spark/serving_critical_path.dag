    PrefillScalingSample { sequence: 9, computed_tokens: 513, cached_tokens: 0, iteration_delta: 4, wall_micros: 710000, arrived_with: ConcurrencyWitness { max_running: 1, max_waiting: 0 }, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
    PrefillScalingSample { sequence: 10, computed_tokens: 2082, cached_tokens: 0, iteration_delta: 5, wall_micros: 2440000, arrived_with: ConcurrencyWitness { max_running: 1, max_waiting: 0 }, concurrency: ConcurrencyWitness { max_running: 2, max_waiting: 0 } },
