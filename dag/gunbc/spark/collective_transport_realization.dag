// ── WHAT IS ACTUALLY RUNNING, BEFORE ANYTHING IS CHANGED ──────────────────────────────────────
//
// THIS MODULE EXISTS BECAUSE AN INFERENCE FROM ACCEPTANCE WAS WRONG. On 2026-09-14 the four-rank GLM
// deployment was ACCEPTED by the readback, and acceptance refuses a socket rank and refuses an unread
// one -- so it appeared to establish that every rank was on the NCCL verbs backend. The first capture
// this module ran refuted that in one field: the containers carry NO /dev/infiniband node, no device
// mapping, no memlock policy and no added capability, which is the state in which verbs cannot be
// opened at all. The transport reading was a misparse of the IB plugin's own banner, and the fix lives
// in gunbc.spark.native_rank_observer beside the lines that caused it.
//
// WHAT A CREATION-STATE CAPTURE ANSWERS THAT A RUNTIME READING CANNOT. The engine log says which
// network NCCL chose; the daemon says what the container was given to choose from. A deployment can
// only be reproduced from the second, and the two disagreeing is exactly how a fallback survives a
// readback -- so the creation state is captured, retained, and compared separately.
//
// SO THE FIRST MOVE IS A READING AND NOT AN EDIT (operator ruling, 2026-09-14). This module captures
// the creation state the daemon kept -- devices, ulimits, capabilities, namespaces, environment,
// mounts, labels -- beside the transport each rank actually selected, bound to the exact endpoint
// process launch, so the realization can be reproduced deliberately rather than reconstructed from
// memory after it is gone.
//
// IT ANSWERS WHAT IS RUNNING AND DECIDES NOTHING ABOUT WHAT SHOULD RUN. The desired transport plan and
// the adoption verdict are separate work; this is their input.

// ── ONE RANK'S REALIZATION ────────────────────────────────────────────────────────────────────
//
// EVERY FIELD IS A SEPARATE READ AND A FAILED READ REFUSES THE WHOLE RANK. A realization missing one
// coordinate is not a smaller realization: it is a description of a container that cannot be compared
// against a plan, and reporting it beside the others would put an unread field where a measured one is
// expected.
type ObservedContainerRealization sole_constructor {
  host: HostIdentity
  node_rank: Nat
  container_id: NonEmptyStr
  image_id: NonEmptyStr
  created_at: NonEmptyStr
  started_at: NonEmptyStr
  network: DockerNamespaceMode
  ipc: DockerNamespaceMode
  devices: List<DockerDeviceMapping>
  device_cgroup_rules: List<String>
  device_requests: List<String>
  memlock_unlimited: Bool
  ulimits: List<DockerUlimitObservation>
  capabilities: List<String>
  environment: List<DockerEnvAssignment>
  mounts: List<DockerMount>
  labels: List<DockerLabel>
  infiniband_device_nodes: List<String>
  verbs_sysfs_devices: List<String>
  transport: NcclTransportObservation
  transport_lines: List<String>
  nccl_version: NonEmptyStr
  host_units_naming_the_container: List<String>
}

type ContainerRealizationRead
  = ContainerRealizationObserved { realization: ObservedContainerRealization }
  | ContainerRealizationUnread { host: HostIdentity, node_rank: Nat, cause: NonEmptyStr }

// ── THE READS ─────────────────────────────────────────────────────────────────────────────────
//
// A TEMPLATE PER FIELD RATHER THAN ONE WHOLE-DOCUMENT DECODE. `docker inspect` returns a document
// whose parse would be one failure for every field at once; a field at a time keeps each read's
// refusal about that field, and the JSON that is decoded is the small array or object the field is.
fn inspect_field_argv(container: NonEmptyStr, body: String) -> List<String> {
  ["docker", "inspect", "-f", go_template_action(body: body), container as String]
}

data realization_listed_marker: String = "GUNBC-REALIZATION-LISTED"
data realization_absent_marker: String = "GUNBC-REALIZATION-NONE"

// A LISTING THAT DID NOT RUN IS NOT AN EMPTY DIRECTORY, and inside a container the difference is the
// whole subject: no /dev/infiniband at all is exactly the state that sent NCCL to sockets, while a
// failed exec says nothing about the container. `&&` reaches the marker only from a successful list;
// a missing directory prints the absent marker through its own arm rather than through silence.
fn in_container_listing_argv(container: NonEmptyStr, directory: String) -> List<String> {
  ["docker", "exec", container as String, "sh", "-c", join([
    "if [ -d ", directory, " ]; then ls -1A ", directory, " && echo ", realization_listed_marker,
    "; else echo ", realization_absent_marker, "; fi",
  ], "")]
}

type InContainerListing
  = ListingPopulated { names: List<String> }
  | ListingDirectoryAbsent
  | ListingUnread { cause: NonEmptyStr }

fn in_container_listing_of(raw: String, directory: String) -> InContainerListing {
  if raw == realization_absent_marker {
    ListingDirectoryAbsent
  } else {
    let lines = split(s: raw, delimiter: "\n")
    match lines.last() {
      Absent => ListingUnread { cause: join(["the listing of ", directory, " printed nothing"], "") as NonEmptyStr }
      Present { value: tail } =>
        if tail != realization_listed_marker {
          ListingUnread { cause: join(["the listing of ", directory, " did not reach its completion marker"], "") as NonEmptyStr }
        } else {
          ListingPopulated { names: filter(lines.take(n: count(lines) - 1), name => name != "") }
        }
    }
  }
}

fn listing_names(l: InContainerListing) -> List<String> {
  match l {
    ListingPopulated { names: ns } => ns
    ListingDirectoryAbsent => []
    ListingUnread { cause: _ } => []
  }
}

fn listing_unread_cause(l: InContainerListing) -> NonEmptyStr? {
  match l {
    ListingUnread { cause: c } => Present { value: c }
    ListingPopulated { names: _ } => none
    ListingDirectoryAbsent => none
  }
}

// THE VERSION AND THE TRANSPORT COME FROM THE ENGINE'S OWN LOG, which is the only place either is a
// measurement rather than a request. The command captures into a variable so the grep's exit status
// never decides whether the read happened.
fn log_pattern_argv(container: NonEmptyStr, pattern: String) -> List<String> {
  ["sh", "-c", join([
    "L=$(docker logs ", container as String, " 2>&1 | grep -oE ", pattern, " | head -1)",
    "; if [ -z \"$L\" ]; then echo ", realization_absent_marker, "; else echo \"$L\"; fi",
  ], "")]
}

// DEDUPLICATED RATHER THAN CAPPED. A window over the first few matches can exclude the verdict line or
// a contradicting detail -- which is how a reader ends up certain about a deployment it only partly
// read -- so the distinct lines are taken whole and the classification refuses a contradiction rather
// than never seeing it.
fn log_lines_argv(container: NonEmptyStr, pattern: String) -> List<String> {
  ["sh", "-c", join([
    "L=$(docker logs ", container as String, " 2>&1 | grep -E ", pattern, " | sort -u)",
    "; if [ -z \"$L\" ]; then echo ", realization_absent_marker, "; else echo \"$L\"; fi",
  ], "")]
}

data nccl_version_pattern: String = "'NCCL version [^ ]+'"
data nccl_transport_pattern: String = "'NET/(IB|Socket) : Using [^ ]+'"

// THE RAW LINES ARE RETAINED BESIDE THE CLASSIFICATION, and the first capture is why. The observer
// reported `verbs over ;` for every rank -- an NcclIbTransport whose device token is a semicolon --
// while the same containers carry no /dev/infiniband node at all, which is the state in which verbs
// cannot be opened. A classification nobody can check against its own input is a reading of the
// reader; the evidence travels with the verdict so a misparse is visible rather than inherited.
data nccl_transport_lines_pattern: String = "'NET/(IB|Socket)|Using network'"

// THE UNIT ROSTER ON THE HOST, so an actuator that owns this container through systemd is named rather
// than guessed at. An empty answer is an answer: nothing on this host names the container.
fn host_units_argv(container: NonEmptyStr) -> List<String> {
  ["sh", "-c", join([
    "S=$(systemctl list-units --all --no-legend --plain 2>/dev/null | grep -i ", container as String, ")",
    "; if [ -z \"$S\" ]; then echo ", realization_absent_marker, "; else echo \"$S\"; fi",
  ], "")]
}

// THE ENVIRONMENT IS CAPTURED BY PREFIX AND THE REMAINDER IS COUNTED, which is a deliberate narrowing
// rather than an omission. A serving container's environment can carry an upstream access token, and a
// durable receipt that copied every assignment would move a credential into a file whose purpose is to
// be read later. The prefixes are the ones that decide collective transport and runtime behaviour; the
// count says how many assignments were left behind so a reader knows the capture is partial.
data captured_environment_prefixes: List<String> = ["NCCL_", "UCX_", "GLOO_", "VLLM_", "CUDA_", "TORCH_", "OMPI_", "LD_"]

fn environment_is_captured(e: DockerEnvAssignment) -> Bool {
  any(captured_environment_prefixes, p => starts_with(s: e.name as String, prefix: p))
}

func read_field(ctx: SparkRemoteExecutionContext, host: HostIdentity, container: NonEmptyStr, body: String) -> String?
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: inspect_field_argv(container: container, body: body))
  if !remote_run_succeeded(r: r) { none } else {
    let v = remote_run_stdout(r: r)
    if v == "" { none } else { Present { value: v } }
  }
}

func read_listing(ctx: SparkRemoteExecutionContext, host: HostIdentity, container: NonEmptyStr, directory: String) -> InContainerListing
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: in_container_listing_argv(container: container, directory: directory))
  if !remote_run_succeeded(r: r) {
    ListingUnread { cause: join(["the container could not be asked about ", directory, ": ", remote_run_text(r: r)], "") as NonEmptyStr }
  } else {
    in_container_listing_of(raw: remote_run_stdout(r: r), directory: directory)
  }
}

func read_log_pattern(ctx: SparkRemoteExecutionContext, host: HostIdentity, container: NonEmptyStr, pattern: String) -> String?
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: log_pattern_argv(container: container, pattern: pattern))
  if !remote_run_succeeded(r: r) { none } else {
    let v = remote_run_stdout(r: r)
    if v == realization_absent_marker { none } else { Present { value: v } }
  }
}

fn unread(host: HostIdentity, rank: Nat, what: String) -> ContainerRealizationRead {
  ContainerRealizationUnread {
    host: host, node_rank: rank,
    cause: join(["the container's ", what, " could not be read on ", host as String], "") as NonEmptyStr,
  }
}

// ── ONE RANK, READ WHOLE ──────────────────────────────────────────────────────────────────────
func observe_container_realization(ctx: SparkRemoteExecutionContext, line: ArmNodeLaunch, container: NonEmptyStr) -> ContainerRealizationRead
  uses net: Network
{
  let host = line.node.host
  let rank = line.node.node_rank
  match read_field(ctx: ctx, host: host, container: container, body: ".Id") {
    Absent => unread(host: host, rank: rank, what: "identity")
    Present { value: container_id } =>
      match read_field(ctx: ctx, host: host, container: container, body: ".Image") {
        Absent => unread(host: host, rank: rank, what: "image id")
        Present { value: image_id } =>
          match read_field(ctx: ctx, host: host, container: container, body: ".Created") {
            Absent => unread(host: host, rank: rank, what: "creation instant")
            Present { value: created_at } =>
              match read_field(ctx: ctx, host: host, container: container, body: ".State.StartedAt") {
                Absent => unread(host: host, rank: rank, what: "start instant")
                Present { value: started_at } =>
                  observe_container_namespaces(
                    ctx: ctx, line: line, container: container,
                    container_id: container_id as NonEmptyStr, image_id: image_id as NonEmptyStr,
                    created_at: created_at as NonEmptyStr, started_at: started_at as NonEmptyStr)
              }
          }
      }
  }
}

func observe_container_namespaces(
  ctx: SparkRemoteExecutionContext, line: ArmNodeLaunch, container: NonEmptyStr,
  container_id: NonEmptyStr, image_id: NonEmptyStr, created_at: NonEmptyStr, started_at: NonEmptyStr,
) -> ContainerRealizationRead
  uses net: Network
{
  let host = line.node.host
  let rank = line.node.node_rank
  match read_field(ctx: ctx, host: host, container: container, body: ".HostConfig.NetworkMode") {
    Absent => unread(host: host, rank: rank, what: "network mode")
    Present { value: network_wire } =>
      match docker_namespace_mode_of_wire(wire: network_wire) {
        Absent => ContainerRealizationUnread {
          host: host, node_rank: rank,
          cause: join(["the container's network mode is ", network_wire, ", which this model does not name"], "") as NonEmptyStr,
        }
        Present { value: network } =>
          match read_field(ctx: ctx, host: host, container: container, body: ".HostConfig.IpcMode") {
            Absent => unread(host: host, rank: rank, what: "ipc mode")
            Present { value: ipc_wire } =>
              match docker_namespace_mode_of_wire(wire: ipc_wire) {
                Absent => ContainerRealizationUnread {
                  host: host, node_rank: rank,
                  cause: join(["the container's ipc mode is ", ipc_wire, ", which this model does not name"], "") as NonEmptyStr,
                }
                Present { value: ipc } =>
                  observe_container_devices(
                    ctx: ctx, line: line, container: container, container_id: container_id, image_id: image_id,
                    created_at: created_at, started_at: started_at, network: network, ipc: ipc)
              }
          }
      }
  }
}

func observe_container_devices(
  ctx: SparkRemoteExecutionContext, line: ArmNodeLaunch, container: NonEmptyStr,
  container_id: NonEmptyStr, image_id: NonEmptyStr, created_at: NonEmptyStr, started_at: NonEmptyStr,
  network: DockerNamespaceMode, ipc: DockerNamespaceMode,
) -> ContainerRealizationRead
  uses net: Network
{
  let host = line.node.host
  let rank = line.node.node_rank
  match read_field(ctx: ctx, host: host, container: container, body: "json .HostConfig.Devices") {
    Absent => unread(host: host, rank: rank, what: "device population")
    Present { value: devices_json } =>
      match docker_devices_from_json(stdout: devices_json) {
        DockerDevicesUnreadable { cause: c } =>
          ContainerRealizationUnread { host: host, node_rank: rank, cause: join(["the device population did not decode: ", c], "") as NonEmptyStr }
        DockerDevicesObserved { devices: devices } =>
          match read_field(ctx: ctx, host: host, container: container, body: "json .HostConfig.Ulimits") {
            Absent => unread(host: host, rank: rank, what: "ulimit population")
            Present { value: ulimits_json } =>
              match docker_ulimits_from_json(stdout: ulimits_json) {
                DockerUlimitsUnreadable { cause: c } =>
                  ContainerRealizationUnread { host: host, node_rank: rank, cause: join(["the ulimit population did not decode: ", c], "") as NonEmptyStr }
                DockerUlimitsObserved { ulimits: ulimits } =>
                  observe_container_capabilities(
                    ctx: ctx, line: line, container: container, container_id: container_id, image_id: image_id,
                    created_at: created_at, started_at: started_at, network: network, ipc: ipc,
                    devices: devices, ulimits: ulimits)
              }
          }
      }
  }
}

func observe_container_capabilities(
  ctx: SparkRemoteExecutionContext, line: ArmNodeLaunch, container: NonEmptyStr,
  container_id: NonEmptyStr, image_id: NonEmptyStr, created_at: NonEmptyStr, started_at: NonEmptyStr,
  network: DockerNamespaceMode, ipc: DockerNamespaceMode,
  devices: List<DockerDeviceMapping>, ulimits: List<DockerUlimitObservation>,
) -> ContainerRealizationRead
  uses net: Network
{
  let host = line.node.host
  let rank = line.node.node_rank
  match read_string_list(ctx: ctx, host: host, container: container, body: "json .HostConfig.CapAdd") {
    Absent => unread(host: host, rank: rank, what: "added capability population")
    Present { value: capabilities } =>
      match read_string_list(ctx: ctx, host: host, container: container, body: "json .HostConfig.DeviceCgroupRules") {
        Absent => unread(host: host, rank: rank, what: "device cgroup rule population")
        Present { value: cgroup_rules } =>
          match read_string_list(ctx: ctx, host: host, container: container, body: "json .HostConfig.DeviceRequests") {
            Absent => unread(host: host, rank: rank, what: "device request population")
            Present { value: device_requests } =>
              match read_string_list(ctx: ctx, host: host, container: container, body: "json .Config.Env") {
                Absent => unread(host: host, rank: rank, what: "environment")
                Present { value: env_wire } =>
                  observe_container_surroundings(
                    ctx: ctx, line: line, container: container, container_id: container_id, image_id: image_id,
                    created_at: created_at, started_at: started_at, network: network, ipc: ipc,
                    devices: devices, ulimits: ulimits, capabilities: capabilities,
                    cgroup_rules: cgroup_rules, device_requests: device_requests,
                    environment: filter(docker_env_assignments_of_wire(values: env_wire), e => environment_is_captured(e: e)))
              }
          }
      }
  }
}

func read_string_list(ctx: SparkRemoteExecutionContext, host: HostIdentity, container: NonEmptyStr, body: String) -> List<String>?
  uses net: Network
{
  match read_field(ctx: ctx, host: host, container: container, body: body) {
    Absent => none
    Present { value: raw } =>
      match docker_string_list_from_json(stdout: raw) {
        DockerStringListUnreadable { cause: _ } => none
        DockerStringListObserved { values: xs } => Present { value: xs }
      }
  }
}

func observe_container_surroundings(
  ctx: SparkRemoteExecutionContext, line: ArmNodeLaunch, container: NonEmptyStr,
  container_id: NonEmptyStr, image_id: NonEmptyStr, created_at: NonEmptyStr, started_at: NonEmptyStr,
  network: DockerNamespaceMode, ipc: DockerNamespaceMode,
  devices: List<DockerDeviceMapping>, ulimits: List<DockerUlimitObservation>,
  capabilities: List<String>, cgroup_rules: List<String>, device_requests: List<String>,
  environment: List<DockerEnvAssignment>,
) -> ContainerRealizationRead
  uses net: Network
{
  let host = line.node.host
  let rank = line.node.node_rank
  match read_field(ctx: ctx, host: host, container: container, body: "json .Mounts") {
    Absent => unread(host: host, rank: rank, what: "mount population")
    Present { value: mounts_json } =>
      match docker_mounts_from_json(stdout: mounts_json) {
        DockerMountsUnreadable { cause: c } =>
          ContainerRealizationUnread { host: host, node_rank: rank, cause: join(["the mount population did not decode: ", c], "") as NonEmptyStr }
        DockerMountsObserved { mounts: mounts } =>
          match read_field(ctx: ctx, host: host, container: container, body: "json .Config.Labels") {
            Absent => unread(host: host, rank: rank, what: "label population")
            Present { value: labels_json } =>
              match docker_labels_from_json(stdout: labels_json) {
                DockerLabelsUnreadable { cause: c } =>
                  ContainerRealizationUnread { host: host, node_rank: rank, cause: join(["the label population did not decode: ", c], "") as NonEmptyStr }
                DockerLabelsObserved { labels: labels } => {
                  let devices_listing = read_listing(ctx: ctx, host: host, container: container, directory: "/dev/infiniband")
                  let sysfs_listing = read_listing(ctx: ctx, host: host, container: container, directory: "/sys/class/infiniband")
                  match listing_unread_cause(l: devices_listing) {
                    Present { value: c } => ContainerRealizationUnread { host: host, node_rank: rank, cause: c }
                    Absent =>
                      match listing_unread_cause(l: sysfs_listing) {
                        Present { value: c } => ContainerRealizationUnread { host: host, node_rank: rank, cause: c }
                        Absent => {
                          let transport_lines = match read_lines(ctx: ctx, host: host, container: container, pattern: nccl_transport_lines_pattern) {
                            Absent => []
                            Present { value: ls } => ls
                          }
                          let transport = if count(transport_lines) == 0 {
                            NcclTransportUnread { cause: "the engine log printed no NCCL transport line" as NonEmptyStr }
                          } else {
                            nccl_transport_of_lines(raw: join(transport_lines, "\n"))
                          }
                          let version = match read_log_pattern(ctx: ctx, host: host, container: container, pattern: nccl_version_pattern) {
                            Absent => "the engine log printed no NCCL version line" as NonEmptyStr
                            Present { value: v } => v as NonEmptyStr
                          }
                          let units = match read_units(ctx: ctx, host: host, container: container) {
                            Absent => []
                            Present { value: us } => us
                          }
                          ContainerRealizationObserved {
                            realization: ObservedContainerRealization {
                              host: host,
                              node_rank: rank,
                              container_id: container_id,
                              image_id: image_id,
                              created_at: created_at,
                              started_at: started_at,
                              network: network,
                              ipc: ipc,
                              devices: devices,
                              device_cgroup_rules: cgroup_rules,
                              device_requests: device_requests,
                              memlock_unlimited: docker_ulimits_memlock_unlimited(ulimits: ulimits),
                              ulimits: ulimits,
                              capabilities: capabilities,
                              environment: environment,
                              mounts: mounts,
                              labels: labels,
                              infiniband_device_nodes: listing_names(l: devices_listing),
                              verbs_sysfs_devices: listing_names(l: sysfs_listing),
                              transport: transport,
                              transport_lines: transport_lines,
                              nccl_version: version,
                              host_units_naming_the_container: units,
                            },
                          }
                        }
                      }
                  }
                }
              }
          }
      }
  }
}

func read_lines(ctx: SparkRemoteExecutionContext, host: HostIdentity, container: NonEmptyStr, pattern: String) -> List<String>?
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: log_lines_argv(container: container, pattern: pattern))
  if !remote_run_succeeded(r: r) { none } else {
    let raw = remote_run_stdout(r: r)
    if raw == realization_absent_marker {
      Present { value: [] }
    } else {
      Present { value: filter(split(s: raw, delimiter: "\n"), l => l != "") }
    }
  }
}

func read_units(ctx: SparkRemoteExecutionContext, host: HostIdentity, container: NonEmptyStr) -> List<String>?
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: host_units_argv(container: container))
  if !remote_run_succeeded(r: r) { none } else {
    let raw = remote_run_stdout(r: r)
    if raw == realization_absent_marker {
      Present { value: [] }
    } else {
      Present { value: filter(split(s: raw, delimiter: "\n"), l => l != "") }
    }
  }
}

// ── THE WHOLE DEPLOYMENT, BOUND TO THE LAUNCH IT DESCRIBES ────────────────────────────────────
//
// THE LAUNCH IS READ BEFORE AND AFTER, exactly as the incarnation transaction does: a capture that
// spanned a restart would describe containers from two different deployments and read as one.
type CollectiveTransportRealizationObservation sole_constructor {
  launch: VllmEndpointProcessLaunch
  attempt: NonEmptyStr
  ranks: List<ObservedContainerRealization>
}

type RealizationCaptureOutcome
  = RealizationCaptured { observation: CollectiveTransportRealizationObservation }
  | RealizationCaptureRefused { obligations: List<NonEmptyStr> }

fn realization_fold_obligation(r: ContainerRealizationRead) -> List<NonEmptyStr> {
  match r {
    ContainerRealizationObserved { realization: _ } => []
    ContainerRealizationUnread { host: h, node_rank: n, cause: c } =>
      [join(["rank ", to_string(n), " on ", h as String, ": ", c as String], "") as NonEmptyStr]
  }
}

fn realization_fold_observed(r: ContainerRealizationRead) -> List<ObservedContainerRealization> {
  match r {
    ContainerRealizationObserved { realization: o } => [o]
    ContainerRealizationUnread { host: _, node_rank: _, cause: _ } => []
  }
}

func capture_transport_realization(
  ctx: SparkRemoteExecutionContext, endpoint: ServingRouteEndpoint, plan: ArmLaunchPlan,
  container: NonEmptyStr, attempt: NonEmptyStr,
) -> RealizationCaptureOutcome
  uses net: Network
{
  match harness_observe_engine(endpoint: endpoint).launch {
    LaunchUnobserved { group: _, obligation: o } =>
      RealizationCaptureRefused { obligations: [join(["the launch could not be read before the capture: ", o as String], "") as NonEmptyStr] }
    LaunchObserved { launch: before, receipt: _ } => {
      let reads = map(plan_lines(plan: plan), l => observe_container_realization(ctx: ctx, line: l, container: container))
      let obligations = flat_map(reads, r => realization_fold_obligation(r: r))
      let observed = flat_map(reads, r => realization_fold_observed(r: r))
      match harness_observe_engine(endpoint: endpoint).launch {
        LaunchUnobserved { group: _, obligation: o } =>
          RealizationCaptureRefused { obligations: concat(obligations, [join(["the launch could not be re-read after the capture: ", o as String], "") as NonEmptyStr]) }
        LaunchObserved { launch: after, receipt: _ } =>
          if !vllm_endpoint_process_launch_is(launch: before, other: after) {
            RealizationCaptureRefused {
              obligations: concat(obligations, ["the endpoint's process was replaced during the capture, so these containers are not one deployment" as NonEmptyStr]),
            }
          } else if count(obligations) != 0 {
            RealizationCaptureRefused { obligations: obligations }
          } else if count(observed) == 0 {
            RealizationCaptureRefused { obligations: ["the plan names no rank, so nothing was captured" as NonEmptyStr] }
          } else {
            RealizationCaptured {
              observation: CollectiveTransportRealizationObservation { launch: after, attempt: attempt, ranks: observed },
            }
          }
      }
    }
  }
}

// ── THE RECEIPT ───────────────────────────────────────────────────────────────────────────────
fn device_text(d: DockerDeviceMapping) -> String {
  join([d.host_path as String, ":", d.container_path as String, ":", d.cgroup_permissions as String], "")
}

fn ulimit_text(u: DockerUlimitObservation) -> String {
  join([u.name as String, "=", to_string(u.soft), ":", to_string(u.hard)], "")
}

fn mount_text(m: DockerMount) -> String {
  match m {
    BindMount { host_path: h, container_path: c, readonly: ro } =>
      join(["bind ", h as String, "->", c as String, if ro { " ro" } else { " rw" }], "")
    VolumeMount { volume: v, container_path: c, readonly: ro } =>
      join(["volume ", v as String, "->", c as String, if ro { " ro" } else { " rw" }], "")
    TmpfsMount { container_path: c, size_bytes: n } =>
      join(["tmpfs ", c as String, " ", to_string(n)], "")
  }
}

fn environment_text(e: DockerEnvAssignment) -> String {
  join([e.name as String, "=", e.value], "")
}

fn label_text(l: DockerLabel) -> String {
  join([l.name as String, "=", l.value], "")
}

fn rank_realization_text(o: ObservedContainerRealization) -> String {
  join([
    "RANK ", to_string(o.node_rank), " on ", o.host as String, "\n",
    "  container      ", o.container_id as String, "\n",
    "  image          ", o.image_id as String, "\n",
    "  created        ", o.created_at as String, "\n",
    "  started        ", o.started_at as String, "\n",
    "  network/ipc    ", docker_namespace_mode_wire(m: o.network) as String, " / ", docker_namespace_mode_wire(m: o.ipc) as String, "\n",
    "  devices        ", if count(o.devices) == 0 { "(none)" } else { join(map(o.devices, d => device_text(d: d)), ", ") }, "\n",
    "  cgroup rules   ", if count(o.device_cgroup_rules) == 0 { "(none)" } else { join(o.device_cgroup_rules, ", ") }, "\n",
    "  device requests ", if count(o.device_requests) == 0 { "(none)" } else { join(o.device_requests, ", ") }, "\n",
    "  ulimits        ", if count(o.ulimits) == 0 { "(none)" } else { join(map(o.ulimits, u => ulimit_text(u: u)), ", ") },
    "  memlock unlimited=", if o.memlock_unlimited { "true" } else { "false" }, "\n",
    "  capabilities   ", if count(o.capabilities) == 0 { "(none)" } else { join(o.capabilities, ", ") }, "\n",
    "  mounts         ", if count(o.mounts) == 0 { "(none)" } else { join(map(o.mounts, m => mount_text(m: m)), ", ") }, "\n",
    "  labels         ", if count(o.labels) == 0 { "(none)" } else { join(map(o.labels, l => label_text(l: l)), ", ") }, "\n",
    "  /dev/infiniband ", if count(o.infiniband_device_nodes) == 0 { "(none)" } else { join(o.infiniband_device_nodes, ", ") }, "\n",
    "  sysfs verbs    ", if count(o.verbs_sysfs_devices) == 0 { "(none)" } else { join(o.verbs_sysfs_devices, ", ") }, "\n",
    "  transport      ", nccl_transport_text(t: o.transport), "\n",
    "  transport lines ", if count(o.transport_lines) == 0 { "(none)" } else { join(o.transport_lines, " || ") }, "\n",
    "  nccl version   ", o.nccl_version as String, "\n",
    "  host units     ", if count(o.host_units_naming_the_container) == 0 { "(none)" } else { join(o.host_units_naming_the_container, " | ") }, "\n",
    "  environment    ", if count(o.environment) == 0 { "(none captured)" } else { join(map(o.environment, e => environment_text(e: e)), ", ") }, "\n",
  ], "")
}

fn realization_receipt_text(o: CollectiveTransportRealizationObservation) -> String {
  join([
    "COLLECTIVE TRANSPORT REALIZATION OBSERVED\n",
    "  launch       ", vllm_endpoint_process_launch_key(launch: o.launch) as String, "\n",
    "  process_start ", o.launch.process_start_field as String, "\n",
    "  endpoint     ", o.launch.endpoint as String, "\n",
    "  attempt      ", o.attempt as String, "\n",
    "  ranks        ", to_string(count(o.ranks)), "\n",
    join(map(o.ranks, r => rank_realization_text(o: r)), ""),
  ], "")
}

data realization_receipt_path: String = "target/spark-collective-transport-realization.txt"

fn realization_envelope(basis_points: Nat) -> ResolvedDeviceMemoryEnvelope {
  ResolvedForAttempt {
    basis_points: basis_points,
    binding_node_rank: 0,
    policy: glm_native_device_memory_policy,
    attempt: "transport-realization-capture" as NonEmptyStr,
    standings: [],
  }
}

func observe_glm_transport_realization(ctx: SparkRemoteExecutionContext, attempt: NonEmptyStr) -> ProcessExit
  uses net: Network
{
  match serving_route(group: FabricGroupB) {
    ServingRouteUnresolved { group: _, obligation: o } => exit_failure(reason: join(["REALIZATION UNREAD: ", o as String], ""))
    ServingRouteResolved { endpoint: endpoint, ceiling: _ } =>
      match glm_native_tp4_nodes() {
        ArmNodeRosterRefused { cause: c } => exit_failure(reason: join(["REALIZATION UNREAD: ", c as String], ""))
        ArmNodesResolved { nodes: ns, master: _ } =>
          match ns.first() {
            Absent => exit_failure(reason: "REALIZATION UNREAD: the roster names no head rank")
            Present { value: head } =>
              match observe_rank_utilization_basis_points(ctx: ctx, node: head) {
                Absent => exit_failure(reason: "REALIZATION UNREAD: the running arm's memory fraction could not be read, so no plan names the rank population")
                Present { value: bp } =>
                  match capture_transport_realization(
                    ctx: ctx, endpoint: endpoint,
                    plan: glm_native_tp4_launch_plan(envelope: realization_envelope(basis_points: bp)),
                    container: glm_native_container_name, attempt: attempt,
                  ) {
                    RealizationCaptureRefused { obligations: os } =>
                      exit_failure(reason: join(["REALIZATION UNREAD: ", join(map(os, o => o as String), "; ")], ""))
                    RealizationCaptured { observation: observation } => {
                      let body = realization_receipt_text(o: observation)
                      let w = Filesystem.Write(path: realization_receipt_path, content: body)
                      if w.success { ExitSuccess } else { exit_failure(reason: join(["the receipt could not be written: ", body], "")) }
                    }
                  }
              }
          }
      }
  }
}

func glm_transport_realization_wet() -> ProcessExit
  uses net: Network
{
  match clock_now_probed_at() {
    Absent => exit_failure(reason: "the clock could not be read, so there is no attempt identity to bind this capture to")
    Present { value: now } =>
      match observe_executor_reach() {
        ExecutorReachUnknown { cause: c } => exit_failure(reason: join(["realization capture: ", c], ""))
        ExecutorReachKnown { short_hostname: _, path: path } =>
          match read_bootstrap_credential() {
            BootstrapCredentialNotMaterialized { cause: c } => exit_failure(reason: c as String)
            BootstrapCredentialReady { secret: administrator } =>
              match fleet_ssh_attempt_identity(raw: "transport-realization") {
                Absent => exit_failure(reason: "the attempt identity is not a safe path segment")
                Present { value: ssh_attempt } => {
                  let materialization = materialize_fleet_known_hosts_anchor(attempt: ssh_attempt)
                  match fleet_openssh_trust_policy_of(outcome: materialization) {
                    Absent => exit_failure(reason: join([
                      "trust could not be established, so no leg ran: ",
                      known_hosts_materialization_receipt(outcome: materialization),
                    ], ""))
                    Present { value: trust } =>
                      match with_materialized_ssh_key_file(
                        identity_file_name: "gunbc-transport-realization-admin-password" as NonEmptyStr,
                        secret_bytes: administrator as Secret,
                        use: fn(file) {
                          observe_glm_transport_realization(
                            ctx: SparkRemoteExecutionContext {
                              trust: trust,
                              reach_path: path,
                              administrator: administrator as Secret,
                              administrator_file: file,
                            },
                            attempt: join(["glm-transport-realization-", now as String], "") as NonEmptyStr,
                          )
                        },
                      ) {
                        MaterializedSshKeyFileBracketRefused { cause: c } => exit_failure(reason: c as String)
                        MaterializedSshKeyFileBracketCompleted { value: v } => v
                      }
                  }
                }
              }
          }
      }
  }
}
