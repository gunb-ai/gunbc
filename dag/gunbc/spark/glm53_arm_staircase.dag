// ── THE GLM-5.3-FLASH STAIRCASE ON GROUP A: THE ARM'S INPUTS, AND NOTHING ELSE ─────────────────
//
// WHAT THIS MODULE IS. One caller of gunbc.spark.group_arm_launch -- the deployment-independent launch
// transaction -- supplying what is GLM's and Group A's: the checkpoint per staircase, the cold floor, the
// ceiling per step, the scheduler gate above the floor, the unit and container names, and which
// recorded labels re-render to which step. It plans, renders and admits nothing itself. Operator-approved program, 2026-10-02 (relayed
// by snappy-bat-66; ruled by valiant-crab-775, deforking cut 8): Group A is a dev environment, every
// step is a bounded experiment, and nothing here promotes.

// ── THE STEPS ARE A CLOSED SET PER CHECKPOINT (ruling of valiant-crab-775, 2026-10-02) ────────────
//
// A step outside these has no spelling: the workflow input selecting a step is a closed choice over
// these variants, never a number typed at dispatch. Each step's ceiling is its own row below, and each
// derives its envelope through serving_capacity_intent scheduler_envelope -- so a ceiling above the cold
// floor exists only with the full-input gate on and the watermark stated, and one below it refuses.
// THE CEILING SWEEP (valiant-crab-775, approved 2026-10-04): 32, 64 and 128 are the same launch with a
// higher scheduler ceiling over the same cold floor and the same gpu_memory_utilization; their receipts
// are ENGINE CHARACTERIZATION, NON-QUALIFYING -- they measure what the ceiling costs (KV blocks, capture
// sizes, time to ready) and whether it launches at all, and nothing promotes from them.
type Glm53Fp8StaircaseStep = Fp8Seats8 | Fp8Seats12 | Fp8Seats16 | Fp8Seats24 | Fp8Seats32 | Fp8Seats64 | Fp8Seats128
type Glm53Nvfp4StaircaseStep = Nvfp4Seats8 | Nvfp4Seats16 | Nvfp4Seats24 | Nvfp4Seats32

type Glm53StaircaseStep
  = Glm53Fp8Step { step: Glm53Fp8StaircaseStep }
  | Glm53Nvfp4Step { step: Glm53Nvfp4StaircaseStep }

fn glm53_fp8_step_ceiling(s: Glm53Fp8StaircaseStep) -> Nat {
  match s {
    Fp8Seats8 => 8
    Fp8Seats12 => 12
    Fp8Seats16 => 16
    Fp8Seats24 => 24
    Fp8Seats32 => 32
    Fp8Seats64 => 64
    Fp8Seats128 => 128
  }
}

fn glm53_nvfp4_step_ceiling(s: Glm53Nvfp4StaircaseStep) -> Nat {
  match s {
    Nvfp4Seats8 => 8
    Nvfp4Seats16 => 16
    Nvfp4Seats24 => 24
    Nvfp4Seats32 => 32
  }
}

fn glm53_step_ceiling(s: Glm53StaircaseStep) -> Nat {
  match s {
    Glm53Fp8Step { step: f } => glm53_fp8_step_ceiling(s: f)
    Glm53Nvfp4Step { step: n } => glm53_nvfp4_step_ceiling(s: n)
  }
}

fn glm53_step_checkpoint(s: Glm53StaircaseStep) -> ServingCheckpoint {
  match s {
    Glm53Fp8Step { step: _ } => Glm53NativeFp8
    Glm53Nvfp4Step { step: _ } => Glm53FlashNvidiaNvfp4
  }
}

fn glm53_step_policy(s: Glm53StaircaseStep) -> ModelLaunchPolicy {
  match s {
    Glm53Fp8Step { step: _ } => glm53_native_launch_policy
    Glm53Nvfp4Step { step: _ } => glm53_flash_nvidia_nvfp4_launch_policy
  }
}

// THE WIRE IS THE WORKFLOW INPUT'S VOCABULARY, one word per variant, and the parse below is its exact
// inverse: an unknown word is no step.
fn glm53_step_wire(s: Glm53StaircaseStep) -> NonEmptyStr {
  match s {
    Glm53Fp8Step { step: Fp8Seats8 } => "fp8-8" as NonEmptyStr
    Glm53Fp8Step { step: Fp8Seats12 } => "fp8-12" as NonEmptyStr
    Glm53Fp8Step { step: Fp8Seats16 } => "fp8-16" as NonEmptyStr
    Glm53Fp8Step { step: Fp8Seats24 } => "fp8-24" as NonEmptyStr
    Glm53Fp8Step { step: Fp8Seats32 } => "fp8-32" as NonEmptyStr
    Glm53Fp8Step { step: Fp8Seats64 } => "fp8-64" as NonEmptyStr
    Glm53Fp8Step { step: Fp8Seats128 } => "fp8-128" as NonEmptyStr
    Glm53Nvfp4Step { step: Nvfp4Seats8 } => "nvfp4-8" as NonEmptyStr
    Glm53Nvfp4Step { step: Nvfp4Seats16 } => "nvfp4-16" as NonEmptyStr
    Glm53Nvfp4Step { step: Nvfp4Seats24 } => "nvfp4-24" as NonEmptyStr
    Glm53Nvfp4Step { step: Nvfp4Seats32 } => "nvfp4-32" as NonEmptyStr
  }
}

data glm53_staircase_steps: List<Glm53StaircaseStep> = [
  Glm53Fp8Step { step: Fp8Seats8 }, Glm53Fp8Step { step: Fp8Seats12 }, Glm53Fp8Step { step: Fp8Seats16 }, Glm53Fp8Step { step: Fp8Seats24 },
  Glm53Fp8Step { step: Fp8Seats32 }, Glm53Fp8Step { step: Fp8Seats64 }, Glm53Fp8Step { step: Fp8Seats128 },
  Glm53Nvfp4Step { step: Nvfp4Seats8 }, Glm53Nvfp4Step { step: Nvfp4Seats16 }, Glm53Nvfp4Step { step: Nvfp4Seats24 }, Glm53Nvfp4Step { step: Nvfp4Seats32 },
]

fn glm53_step_of_wire(word: String) -> Glm53StaircaseStep? {
  first(filter(glm53_staircase_steps, s => (glm53_step_wire(s: s) as String) == word))
}

// ── THE COLD GUARANTEE IS THE SAME AT EVERY STEP: 8 x 262144 ──────────────────────────────────
//
// THE FLOOR IS THE GLM ARM'S COLD SERVICE, IMPORTED, NOT RESTATED: its window, its eight cold seats and
// the batched ceiling it runs them under on GB10s are gunbc.spark.group_b_serving_capacity's rows
// (group_b_restoration_window_tokens, group_b_experiment_subject_seats,
// group_b_restoration_max_batched_tokens), so the floor cannot drift from the service it guarantees
// (review 74379). The staircase moves the CEILING, not the prefill shape, so a step's receipt differs from the
// last in one axis.

fn glm53_staircase_cold_intent() -> ServingCapacityIntent? {
  match uniform_cold_seats(each: token_count(count: group_b_restoration_window_tokens), seats: group_b_experiment_subject_seats, max_batched_tokens: token_count(count: group_b_restoration_max_batched_tokens)) {
    ServingCapacityIntentRefused { cause: _ } => none
    ServingCapacityIntentAdmitted { intent: i } => Present { value: i }
  }
}

// THE GATE ABOVE THE FLOOR IS STATED AT EVERY STEP, the floor step included, so the eight-seat step is
// the same engine configuration as the others less the ceiling, and a difference between two steps'
// receipts is the ceiling's. The full-input gate is ON: a best-effort seat is admitted only when the
// allocator finds its whole current sequence fits. The watermark is ZERO, stated: preemption is the
// admitted overflow behaviour for the seats above the floor (operator ruling 2026-10-02 relayed in
// gunbc.spark.serving_capacity_intent), so nothing is held back against it, and a declared zero is a
// value someone chose where an inherited default would be one nobody did.
data glm53_staircase_scheduler_admission: VllmSchedulerAdmissionRequest = VllmSchedulerAdmissionRequest {
  full_input_admission: FullInputAdmissionExplicit { enabled: true },
  kv_watermark: KvWatermarkExplicit { fraction: basis_point(count: 0) },
}

type Glm53StepEnvelope
  = Glm53StepEnvelopeAdmitted { envelope: SchedulerEnvelope }
  | Glm53StepEnvelopeRefused { cause: String }

fn glm53_step_envelope(s: Glm53StaircaseStep) -> Glm53StepEnvelope {
  match glm53_staircase_cold_intent() {
    Absent => Glm53StepEnvelopeRefused { cause: "the staircase's cold intent (8 x 262144) refused, so no step has a floor" }
    Present { value: cold } =>
      match scheduler_envelope(cold: cold, hard_max_num_seqs: glm53_step_ceiling(s: s), admission: glm53_staircase_scheduler_admission) {
        SchedulerEnvelopeRefused { cause: c } => Glm53StepEnvelopeRefused { cause: c as String }
        SchedulerEnvelopeAdmitted { envelope: e } => Glm53StepEnvelopeAdmitted { envelope: e }
      }
  }
}

// THE ROUTE'S PORT AND NAME ARE GROUP A'S ROUTE (gunbc.spark.pair_serving_realization
// spark_pair_serve_port, which gunbc.serving.serving_enrollment reads for Group A), so a step serves
// where Group A's clients already ask. The memory fraction is the GLM arm's decided figure on a GB10
// (gunbc.spark.group_b_serving_capacity group_b_restoration_utilization) -- the same hardware and
// engine, read rather than re-decided; the memory wall prices it per step. Prefix caching is on, as
// the GLM arm serves.
data glm53_staircase_served_alias: NonEmptyStr = "glm-5.3-flash" as NonEmptyStr
data glm53_staircase_prefix_caching: VllmPrefixCachingRequest = PrefixCachingExplicit { enabled: true }

fn glm53_step_profile(s: Glm53StaircaseStep) -> ServingLaunchProfile? {
  match glm53_step_envelope(s: s) {
    Glm53StepEnvelopeRefused { cause: _ } => none
    Glm53StepEnvelopeAdmitted { envelope: e } => Present { value: profile_for_envelope(
      envelope: e,
      policy: glm53_step_policy(s: s),
      decided_gpu_memory_basis_points: group_b_restoration_utilization,
      serve_port: spark_pair_serve_port,
      served_alias: glm53_staircase_served_alias,
      prefix_caching: glm53_staircase_prefix_caching,
    ) }
  }
}

// ── WHAT THIS DEPLOYMENT IS CALLED, DISTINCT FROM EVERY OTHER ────────────────────────────────
//
// Host occupancy is read by unit and container name, so the staircase's names are its own: a Group A
// host still running the pair, V4.1, or Group B's glm-native names reads as occupied by THAT, never as
// this arm already installed. The rendezvous port is the next after V4.1's 29500 and glm-native's
// 29501, so no two arms' rendezvous share one. The shared-memory size and the vLLM environment are the
// GLM arm's own on a GB10 (gunbc.serving_arm_launch glm_native_shm_size; gunbc.spark.glm_group_b_launch
// glm_group_b_deployment_env, the engine-ready timeout and the sparse-indexer logits guard every GLM
// launch on this hardware reads).
data glm53_staircase_units: ArmUnitIdentity = ArmUnitIdentity {
  head_unit_name: "gunbc-glm53-stair-head.service" as NonEmptyStr,
  rank_unit_name: "gunbc-glm53-stair-rank.service" as NonEmptyStr,
  head_log_path: glm53_staircase_head_log_path,
  rank_log_path: "/var/log/gunbc/glm53-stair-rank.log" as NonEmptyStr,
  description: "gunbc GLM-5.3-Flash Group A staircase arm" as NonEmptyStr,
}

data glm53_staircase_container: ArmContainerIdentity = ArmContainerIdentity {
  container_name: glm53_staircase_container_name,
  master_port: 29502,
  shm_size: glm_native_shm_size,
  extra_mounts: [],
}

// EVERY STEP IS A BOUNDED EXPERIMENT: the units render with one attempt and RuntimeMaxSec, and the memory
// wall admits an unproved fit only under this intent.
data glm53_staircase_intent: ArmIntent = ArmBoundedExperiment

// THE RUNTIME IS THE SAME KVPLAN-V2 BUILD THE GLM ARM RUNS ON GROUP B, PRODUCED ONCE FOR GROUP A
// (gunbc.spark.serving_arm glm53_kvplan_v2_group_a_row): one content id, moved by digest, so the step has
// a keyed successor. Group B's per-host row is a different artifact, and a receipt here does not promote it.
fn glm53_step_assignment(s: Glm53StaircaseStep) -> FabricServingAssignment {
  fabric_serving_assignment_for_launch(group: FabricGroupA, checkpoint: glm53_step_checkpoint(s: s), runtime: GunbcGlm53KvplanV2GroupAProduced, topology: FourSparkTp4)
}

// THE NVFP4 STEPS DECLARE ONE MORE VARIABLE THAN THE FP8 STEPS, and it is a fact of that arm, not a
// tuning preference: VLLM_FLASHINFER_AUTOTUNE_SKIP_OPS for the two trtllm fused_moe gemms. Without it the
// pinned runtime's leader-only sparse-MLA pre-tune seeds rank 0 with rank-keyed fused_moe tactics and the
// synchronized autotune deadlocks the other ranks (nvfp4-8, fleet-converge 37190290418: workers blocked
// 30 minutes, tuned alone 26, the head's barrier closed; extdeps.vllm.environment cites the source). COST,
// carried into every NVFP4 receipt: rank 0 runs its sparse-MLA-tuned fused_moe tactics while ranks 1-3 run
// the heuristic tactic -- the ranks are not kernel-identical and NVFP4 throughput is a LOWER BOUND.
// Operator-approved via valiant-crab-775, 2026-10-04, as the diagnostic configuration; not yet the standing one.
data glm53_nvfp4_autotune_skip_ops: List<String> = ["trtllm::fused_moe::gemm1", "trtllm::fused_moe::gemm2"]

fn glm53_step_deployment_env(s: Glm53StaircaseStep) -> List<DockerEnvAssignment> {
  match s {
    Glm53Fp8Step { step: _ } => glm_group_b_deployment_env()
    Glm53Nvfp4Step { step: _ } => concat(glm_group_b_deployment_env(), [DockerEnvAssignment {
      name: vllm_environment_variable_name(v: VllmFlashinferAutotuneSkipOps),
      value: join(glm53_nvfp4_autotune_skip_ops, ","),
    }])
  }
}

fn glm53_step_inputs(s: Glm53StaircaseStep) -> GroupArmLaunchInputs? {
  match glm53_step_profile(s: s) {
    Absent => none
    Present { value: p } => Present { value: GroupArmLaunchInputs {
      assignment: glm53_step_assignment(s: s),
      profile: p,
      intent: glm53_staircase_intent,
      deployment_env: glm53_step_deployment_env(s: s),
      container: glm53_staircase_container,
      units: glm53_staircase_units,
      purpose: join(["the GLM-5.3-Flash Group A staircase step ", glm53_step_wire(s: s) as String], "") as NonEmptyStr,
    } }
  }
}

// ── THE COMMITTED-STEP AUTHORITY ──────────────────────────────────────────────────────────────
//
// A STEP IS COMMITTED UNDER ITS OWN WIRE, and a recorded wire re-renders through this module's own step
// table, so a return to the last committed arm plans exactly that step. An unknown wire refuses: the
// staircase has no nearby step to guess. There is no declared incumbent any more: the arm's own units are
// the converge's subject (gunbc.spark.group_arm_launch), so the step before is what the converge observes
// and, if it deviates, stops with every rank.
fn glm53_step_steps(s: Glm53StaircaseStep) -> SparkNativeArmSteps {
  match glm53_step_inputs(s: s) {
    Absent => NativeArmStepsRefused { cause: glm53_step_unplanned_cause(s: s) as NonEmptyStr }
    Present { value: inputs } => group_arm_steps(intent: inputs.intent, units: inputs.units, p: group_arm_launch_plan(inputs: inputs))
  }
}

fn glm53_committed_render(label: NonEmptyStr) -> SparkNativeArmSteps {
  match glm53_step_of_wire(word: label as String) {
    Absent => NativeArmStepsRefused { cause: join(["the committed record names ", label as String, ", which is not a step of the GLM-5.3-Flash staircase"], "") as NonEmptyStr }
    Present { value: s } => glm53_step_steps(s: s)
  }
}

fn glm53_committed_authority(s: Glm53StaircaseStep) -> GroupArmCommittedAuthority {
  GroupArmCommittedAuthority { label: glm53_step_wire(s: s), render: fn(l) { glm53_committed_render(label: l) } }
}

// ── THE DRY PLAN AND THE WET SESSION ─────────────────────────────────────────────────────────────
//
// BOTH ARE THE ONE PATH'S, over this step's inputs. The dry plan reaches no host except the read of the
// authority log, and reports the step's plan, every host's unit, container line, observe, preflight,
// stop and apply, the admission verdict with every refusal named, and the successor key a D0
// suspension would have to name. The wet session reads every planned host's occupancy with this arm's
// own units as its subject, admits against the live authority, and only then runs the converge
// (gunbc.spark.group_arm_launch group_arm_apply_admitted). GLM has no pre-apply work of its own.
fn glm53_step_title(s: Glm53StaircaseStep) -> String {
  join(["GLM-5.3-Flash Group A staircase step ", glm53_step_wire(s: s) as String], "")
}

fn glm53_step_unplanned_cause(s: Glm53StaircaseStep) -> String {
  match glm53_step_envelope(s: s) {
    Glm53StepEnvelopeRefused { cause: c } => c
    Glm53StepEnvelopeAdmitted { envelope: _ } => "the step's profile did not derive"
  }
}

fn glm53_step_report(s: Glm53StaircaseStep, inputs: GroupArmLaunchInputs, plan: GroupArmLaunchPlan, admission: GroupArmLaunchAdmission) -> String {
  join([
    group_arm_dry_run_report(title: glm53_step_title(s: s), intent: inputs.intent, units: inputs.units, plan: plan, pre_apply: [], admission: admission),
    arm_successor_wire(s: group_arm_row_successor(inputs: inputs)),
  ], "")
}

fn glm53_step_dry_plan(s: Glm53StaircaseStep) -> ArmDryPlan {
  match glm53_step_inputs(s: s) {
    Absent => ArmDryPlan {
      report: join([glm53_step_title(s: s), " -- DRY RUN\nplan: REFUSED\n  - ", glm53_step_unplanned_cause(s: s), "\n"], ""),
      admission: GroupArmLaunchAdmissionRefused { causes: [glm53_step_unplanned_cause(s: s)] },
    }
    Present { value: inputs } => {
      let plan = group_arm_launch_plan(inputs: inputs)
      let admission = group_arm_launch_admission_live(group: FabricGroupA, purpose: inputs.purpose, units: inputs.units, plan: plan, successor: group_arm_row_successor(inputs: inputs), arm_causes: [], occupancy: group_arm_dry_run_occupancy(group: FabricGroupA))
      ArmDryPlan { report: glm53_step_report(s: s, inputs: inputs, plan: plan, admission: admission), admission: admission }
    }
  }
}

fn glm53_step_session(s: Glm53StaircaseStep, now_word: String, context: FleetSshExecutionContext, ctx: SparkMaterializeContext) -> SparkBuildHostWork {
  match glm53_step_inputs(s: s) {
    Absent => SparkBuildHostWork { receipt: join(["NOT LAUNCHED: ", glm53_step_unplanned_cause(s: s), "\n"], ""), converged: false }
    Present { value: inputs } => {
      let plan = group_arm_launch_plan(inputs: inputs)
      let hosts = group_arm_plan_hosts(p: plan)
      let occupancy = group_arm_read_occupancy(ctx: ctx, hosts: hosts, units: inputs.units, need: group_arm_memory_need(gpu_memory_utilization: inputs.profile.decided_gpu_memory_basis_points))
      let admission = group_arm_launch_admission_live(group: FabricGroupA, purpose: inputs.purpose, units: inputs.units, plan: plan, successor: group_arm_row_successor(inputs: inputs), arm_causes: [], occupancy: occupancy)
      let report = glm53_step_report(s: s, inputs: inputs, plan: plan, admission: admission)
      match admission {
        GroupArmLaunchAdmissionRefused { causes: _ } =>
          SparkBuildHostWork { receipt: join([report, "NOT LAUNCHED: admission refused; every serving unit is untouched\n"], ""), converged: false }
        GroupArmLaunchAdmitted => {
          let work = group_arm_apply_admitted(
            intent: inputs.intent, units: inputs.units, plan: plan, committed: glm53_committed_authority(s: s),
            context: context, ctx: ctx,
            pre_apply: fn(steps) { ArmPreApplyPassed { receipt: "" } })
          SparkBuildHostWork { receipt: join([report, work.receipt], ""), converged: work.converged }
        }
      }
    }
  }
}

fn glm53_step_wet_session(s: Glm53StaircaseStep) -> ArmWetSession {
  ArmWetSession {
    title: glm53_step_title(s: s) as NonEmptyStr,
    group: FabricGroupA,
    attempt_raw: join(["glm53-group-a-staircase-", glm53_step_wire(s: s) as String], ""),
    identity_file_name: "gunbc-glm53-group-a-staircase-admin-password" as NonEmptyStr,
    session: fn(now_word, context, ctx) { glm53_step_session(s: s, now_word: now_word, context: context, ctx: ctx) },
  }
}
