// ── THE GLM-5.3-FLASH STAIRCASE ON GROUP A: THE ARM'S INPUTS, AND NOTHING ELSE ─────────────────
//
// WHAT THIS MODULE IS. One caller of gunbc.spark.group_arm_launch -- the deployment-independent launch
// transaction -- supplying what is GLM's and Group A's: the checkpoint per staircase, the cold floor, the
// ceiling per step, the scheduler gate above the floor, the unit and container names, and the declared
// incumbent. It plans, renders and admits nothing itself. Operator-approved program, 2026-10-02 (relayed
// by snappy-bat-66; ruled by valiant-crab-775, deforking cut 8): Group A is a dev environment, every
// step is a bounded experiment, and nothing here promotes.

// ── WHAT THIS DEPLOYMENT IS CALLED, DISTINCT FROM EVERY OTHER ────────────────────────────────
//
// Host occupancy is read by unit and container name, so the staircase's names are its own: a Group A
// host still running the pair, V4.1, or Group B's glm-native names reads as occupied by THAT, never as
// this arm already installed. The rendezvous port is the next after V4.1's 29500 and glm-native's
// 29501, so no two arms' rendezvous share one. The shared-memory size and the vLLM environment are the
// GLM arm's own on a GB10 (gunbc.serving_arm_launch glm_native_shm_size; gunbc.spark.glm_group_b_launch
// glm_group_b_deployment_env, the engine-ready timeout and the sparse-indexer logits guard every GLM
// launch on this hardware reads).
data glm53_staircase_units: ArmUnitIdentity = ArmUnitIdentity {
  head_unit_name: "gunbc-glm53-stair-head.service" as NonEmptyStr,
  rank_unit_name: "gunbc-glm53-stair-rank.service" as NonEmptyStr,
  head_log_path: glm53_staircase_head_log_path,
  rank_log_path: "/var/log/gunbc/glm53-stair-rank.log" as NonEmptyStr,
  description: "gunbc GLM-5.3-Flash Group A staircase arm" as NonEmptyStr,
}

data glm53_staircase_container: ArmContainerIdentity = ArmContainerIdentity {
  container_name: glm53_staircase_container_name,
  master_port: 29502,
  shm_size: glm_native_shm_size,
  extra_mounts: [],
}

// EVERY STEP IS A BOUNDED EXPERIMENT -- one attempt, RuntimeMaxSec, an unproved fit admitted only under
// that intent -- EXCEPT nvfp4-8, which the operator ruled (2026-10-07, relayed by valiant-crab-775) may
// serve PERSISTENTLY for the operator's own qualification against GLM-5.3-Flash fp8 on Group B, without
// the promotion receipts that cannot be produced today. The ruling is minted over this step's exact
// realization key (gunbc.spark.serving_arm operator_qualification_ruling), so it admits no other step.

fn glm53_nvfp4_8_operator_qualification() -> OperatorQualificationRuling? {
  let step = Glm53Nvfp4Step { step: Nvfp4Seats8 }
  match glm53_step_profile(s: step) {
    Absent => none
    Present { value: p } => operator_qualification_ruling(
      ruled_by: "the operator" as NonEmptyStr, ruled_on: "2026-10-07" as NonEmptyStr, relayed_by: "valiant-crab-775" as NonEmptyStr,
      subject_label: join(["the GLM-5.3-Flash Group A staircase step ", glm53_step_wire(s: step) as String], "") as NonEmptyStr,
      checkpoint: glm53_step_checkpoint(s: step), runtime: GunbcGlm53KvplanV2GroupAProduced, topology: FourSparkTp4, group: FabricGroupA,
      profile: p, deployment_env: glm53_step_deployment_env(s: step))
  }
}

// A STEP WHOSE INTENT CANNOT BE STATED HAS NO INPUTS: nvfp4-8 with no ruling (an unkeyed subject) is not
// silently demoted to a bounded experiment.
fn glm53_step_intent(s: Glm53StaircaseStep) -> ArmIntent? {
  match s {
    Glm53Nvfp4Step { step: Nvfp4Seats8 } =>
      match glm53_nvfp4_8_operator_qualification() {
        Absent => none
        Present { value: r } => Present { value: ArmOperatorQualificationServing { ruling: r } }
      }
    Glm53Nvfp4Step { step: Nvfp4Seats16 } => Present { value: ArmBoundedExperiment }
    Glm53Nvfp4Step { step: Nvfp4Seats24 } => Present { value: ArmBoundedExperiment }
    Glm53Nvfp4Step { step: Nvfp4Seats32 } => Present { value: ArmBoundedExperiment }
    Glm53Fp8Step { step: _ } => Present { value: ArmBoundedExperiment }
  }
}

// THE RUNTIME IS THE SAME KVPLAN-V2 BUILD THE GLM ARM RUNS ON GROUP B, PRODUCED ONCE FOR GROUP A
// (gunbc.spark.serving_arm glm53_kvplan_v2_group_a_row): one content id, moved by digest, so the step has
// a keyed successor. Group B's per-host row is a different artifact, and a receipt here does not promote it.
fn glm53_step_assignment(s: Glm53StaircaseStep) -> FabricServingAssignment {
  fabric_serving_assignment_for_launch(group: FabricGroupA, checkpoint: glm53_step_checkpoint(s: s), runtime: GunbcGlm53KvplanV2GroupAProduced, topology: FourSparkTp4)
}

// THE NVFP4 STEPS DECLARE ONE MORE VARIABLE THAN THE FP8 STEPS, and it is a fact of that arm, not a
// tuning preference: VLLM_FLASHINFER_AUTOTUNE_SKIP_OPS for the two trtllm fused_moe gemms. Without it the
// pinned runtime's leader-only sparse-MLA pre-tune seeds rank 0 with rank-keyed fused_moe tactics and the
// synchronized autotune deadlocks the other ranks (nvfp4-8, fleet-converge 37190290418: workers blocked
// 30 minutes, tuned alone 26, the head's barrier closed; extdeps.vllm.environment cites the source). COST,
// carried into every NVFP4 receipt: rank 0 runs its sparse-MLA-tuned fused_moe tactics while ranks 1-3 run
// the heuristic tactic -- the ranks are not kernel-identical and NVFP4 throughput is a LOWER BOUND.
// Operator-approved via valiant-crab-775, 2026-10-04, as the diagnostic configuration; not yet the standing one.
data glm53_nvfp4_autotune_skip_ops: List<String> = ["trtllm::fused_moe::gemm1", "trtllm::fused_moe::gemm2"]

fn glm53_step_deployment_env(s: Glm53StaircaseStep) -> List<DockerEnvAssignment> {
  match s {
    Glm53Fp8Step { step: _ } => glm_group_b_deployment_env()
    Glm53Nvfp4Step { step: _ } => concat(glm_group_b_deployment_env(), [DockerEnvAssignment {
      name: vllm_environment_variable_name(v: VllmFlashinferAutotuneSkipOps),
      value: join(glm53_nvfp4_autotune_skip_ops, ","),
    }])
  }
}

fn glm53_step_inputs(s: Glm53StaircaseStep) -> GroupArmLaunchInputs? {
  match glm53_step_profile(s: s) {
    Absent => none
    Present { value: p } =>
  match glm53_step_intent(s: s) {
    Absent => none
    Present { value: i } => Present { value: GroupArmLaunchInputs {
      assignment: glm53_step_assignment(s: s),
      profile: p,
      intent: i,
      deployment_env: glm53_step_deployment_env(s: s),
      container: glm53_staircase_container,
      units: glm53_staircase_units,
      purpose: join(["the GLM-5.3-Flash Group A staircase step ", glm53_step_wire(s: s) as String], "") as NonEmptyStr,
    } }
  }
  }
}

// ── THE DECLARED INCUMBENT, PER STEP ──────────────────────────────────────────────────────────
//
// STEP N > 1 SUPERSEDES STEP N - 1, WHICH IS THIS ARM'S OWN TWO UNITS ON GROUP A's FOUR HOSTS
// (approved by valiant-crab-775, 2026-10-02). THE FIRST STEP SUPERSEDES NOTHING, AND THAT IS A READING,
// NOT AN ASSUMPTION: the serve snappy-bat-66 handed over on .225 could not be described by its launcher
// (archived), so Group A's occupancy was read instead -- fleet-converge run 37087495838 (mode
// spark_arm_group_observe, 2026-10-03) found no running container and no GPU compute process on any of
// srv5, srv6, srv7 or srv8, and no serving unit beyond the system's own. There is nothing to declare.
// If a serve appears before the first step runs, it is an undeclared occupant and the admission
// refuses on it, exactly as for any other.
type Glm53StepIncumbent
  = Glm53IncumbentResolved { incumbent: ArmDeclaredIncumbent }

type Glm53IncumbentChoice = SupersedePreviousStep | SupersedeNothing

fn glm53_previous_step_incumbent(lines_hosts: List<HostIdentity>) -> ArmDeclaredIncumbent {
  IncumbentDeclared {
    units: concat(
      map(filter(enumerate(lines_hosts), p => p.first == 0), p => ArmIncumbentUnit { host: p.second, unit_name: glm53_staircase_units.head_unit_name }),
      map(filter(enumerate(lines_hosts), p => p.first != 0), p => ArmIncumbentUnit { host: p.second, unit_name: glm53_staircase_units.rank_unit_name })),
    provenance: "the staircase's previous step: this arm's own head unit on rank zero's host and its rank unit on the others" as NonEmptyStr,
  }
}

fn glm53_step_incumbent(choice: Glm53IncumbentChoice, hosts: List<HostIdentity>) -> Glm53StepIncumbent {
  match choice {
    SupersedeNothing => Glm53IncumbentResolved { incumbent: NoIncumbentDeclared }
    SupersedePreviousStep => Glm53IncumbentResolved { incumbent: glm53_previous_step_incumbent(lines_hosts: hosts) }
  }
}

fn glm53_incumbent_choice_wire(c: Glm53IncumbentChoice) -> NonEmptyStr {
  match c {
    SupersedePreviousStep => "previous-step" as NonEmptyStr
    SupersedeNothing => "none" as NonEmptyStr
  }
}

data glm53_incumbent_choices: List<Glm53IncumbentChoice> = [SupersedePreviousStep, SupersedeNothing]

fn glm53_incumbent_choice_of_wire(word: String) -> Glm53IncumbentChoice? {
  first(filter(glm53_incumbent_choices, c => (glm53_incumbent_choice_wire(c: c) as String) == word))
}

// ── THE DRY PLAN AND THE WET SESSION ─────────────────────────────────────────────────────────────
//
// BOTH ARE THE ONE PATH'S, over this step's inputs. The dry plan reaches no host except the read of the
// authority log, and reports the step's plan, every host's unit, container line, preflight and apply,
// the declared incumbent, the admission verdict with every refusal named, and the successor key a D0
// suspension would have to name. The wet session reads every planned host's occupancy over the
// declared incumbent's units, admits against the live authority, and only then runs the incumbent
// bracket and the arm transaction (gunbc.spark.group_arm_launch group_arm_apply_admitted). GLM has no
// pre-apply work of its own.
fn glm53_step_title(s: Glm53StaircaseStep) -> String {
  join(["GLM-5.3-Flash Group A staircase step ", glm53_step_wire(s: s) as String], "")
}

fn glm53_step_unplanned_cause(s: Glm53StaircaseStep) -> String {
  match glm53_step_envelope(s: s) {
    Glm53StepEnvelopeRefused { cause: c } => c
    Glm53StepEnvelopeAdmitted { envelope: _ } => "the step's profile did not derive"
  }
}

fn glm53_step_report(s: Glm53StaircaseStep, inputs: GroupArmLaunchInputs, plan: GroupArmLaunchPlan, incumbent: ArmDeclaredIncumbent, admission: GroupArmLaunchAdmission) -> String {
  join([
    group_arm_dry_run_report(title: glm53_step_title(s: s), intent: inputs.intent, units: inputs.units, plan: plan, pre_apply: [], incumbent: incumbent, admission: admission),
    arm_successor_wire(s: group_arm_row_successor(inputs: inputs)),
  ], "")
}

fn glm53_step_dry_plan(s: Glm53StaircaseStep, choice: Glm53IncumbentChoice) -> ArmDryPlan {
  match glm53_step_inputs(s: s) {
    Absent => ArmDryPlan {
      report: join([glm53_step_title(s: s), " -- DRY RUN\nplan: REFUSED\n  - ", glm53_step_unplanned_cause(s: s), "\n"], ""),
      admission: GroupArmLaunchAdmissionRefused { causes: [glm53_step_unplanned_cause(s: s)] },
    }
    Present { value: inputs } => {
      let plan = group_arm_launch_plan(inputs: inputs)
      match glm53_step_incumbent(choice: choice, hosts: group_arm_plan_hosts(p: plan)) {
        Glm53IncumbentResolved { incumbent: incumbent } => {
          let admission = group_arm_launch_admission_live(group: FabricGroupA, purpose: inputs.purpose, plan: plan, successor: group_arm_row_successor(inputs: inputs), arm_causes: [], occupancy: group_arm_dry_run_occupancy(group: FabricGroupA), incumbent: incumbent)
          ArmDryPlan { report: glm53_step_report(s: s, inputs: inputs, plan: plan, incumbent: incumbent, admission: admission), admission: admission }
        }
      }
    }
  }
}

fn glm53_step_session(s: Glm53StaircaseStep, choice: Glm53IncumbentChoice, now_word: String, context: FleetSshExecutionContext, ctx: SparkMaterializeContext) -> SparkBuildHostWork {
  match glm53_step_inputs(s: s) {
    Absent => SparkBuildHostWork { receipt: join(["NOT LAUNCHED: ", glm53_step_unplanned_cause(s: s), "\n"], ""), converged: false }
    Present { value: inputs } => {
      let plan = group_arm_launch_plan(inputs: inputs)
      let hosts = group_arm_plan_hosts(p: plan)
      match glm53_step_incumbent(choice: choice, hosts: hosts) {
        Glm53IncumbentResolved { incumbent: incumbent } => {
          let occupancy = group_arm_read_occupancy(ctx: ctx, hosts: hosts, units: inputs.units, incumbent: incumbent, need: group_arm_memory_need(gpu_memory_utilization: inputs.profile.decided_gpu_memory_basis_points))
          let admission = group_arm_launch_admission_live(group: FabricGroupA, purpose: inputs.purpose, plan: plan, successor: group_arm_row_successor(inputs: inputs), arm_causes: [], occupancy: occupancy, incumbent: incumbent)
          let report = glm53_step_report(s: s, inputs: inputs, plan: plan, incumbent: incumbent, admission: admission)
          match admission {
            GroupArmLaunchAdmissionRefused { causes: _ } =>
              SparkBuildHostWork { receipt: join([report, "NOT LAUNCHED: admission refused; the incumbent and every serving unit are untouched\n"], ""), converged: false }
            GroupArmLaunchAdmittedForAdoptionOnly { hosts: _ } => {
              let work = group_arm_adopt_dangling(intent: inputs.intent, units: inputs.units, plan: plan, context: context, ctx: ctx, now_word: now_word)
              SparkBuildHostWork { receipt: join([report, work.receipt], ""), converged: work.converged }
            }
            GroupArmLaunchAdmitted => {
              let work = group_arm_apply_admitted(
                intent: inputs.intent, units: inputs.units, plan: plan, incumbent: incumbent,
                context: context, ctx: ctx, now_word: now_word,
                pre_apply: fn(steps) { ArmPreApplyPassed { receipt: "" } })
              SparkBuildHostWork { receipt: join([report, work.receipt], ""), converged: work.converged }
            }
          }
        }
      }
    }
  }
}

fn glm53_step_wet_session(s: Glm53StaircaseStep, choice: Glm53IncumbentChoice) -> ArmWetSession {
  ArmWetSession {
    title: glm53_step_title(s: s) as NonEmptyStr,
    group: FabricGroupA,
    attempt_raw: join(["glm53-group-a-staircase-", glm53_step_wire(s: s) as String], ""),
    identity_file_name: "gunbc-glm53-group-a-staircase-admin-password" as NonEmptyStr,
    session: fn(now_word, context, ctx) { glm53_step_session(s: s, choice: choice, now_word: now_word, context: context, ctx: ctx) },
  }
}
