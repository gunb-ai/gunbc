import std.nat { Nat }
import std.measure { token_count, basis_point }
import v2.std.optional { Present, Absent }
import gunbc.spark.vllm_runtime_image_build { SparkBuildHostWork }
import gunbc.spark.model_snapshot_materialize { SparkMaterializeContext }
import gunbc.fleet_known_hosts_anchor { FleetSshExecutionContext }
import extdeps.vllm.engine_args { VllmSchedulerAdmissionRequest, FullInputAdmissionExplicit, KvWatermarkExplicit, VllmPrefixCachingRequest, PrefixCachingExplicit }
import product.placement_supply { HostIdentity }
import gunbc.spark.fabric_switch_observed { FabricGroupA }
import gunbc.spark.fabric_serving_assignment { FabricServingAssignment, fabric_serving_assignment_for_launch }
import gunbc.spark.serving_arm { ArmIntent, ArmBoundedExperiment, ServingLaunchProfile, ModelLaunchPolicy, ServingCheckpoint, Glm53NativeFp8, Glm53FlashNvidiaNvfp4, GunbcGlm53KvplanV2GroupAProduced, FourSparkTp4, glm53_native_launch_policy, glm53_flash_nvidia_nvfp4_launch_policy }
import gunbc.spark.serving_capacity_intent { ServingCapacityIntent, ServingCapacityIntentAdmitted, ServingCapacityIntentRefused, uniform_cold_seats, SchedulerEnvelope, SchedulerEnvelopeAdmitted, SchedulerEnvelopeRefused, scheduler_envelope, profile_for_envelope }
import gunbc.spark.serving_arm_launch { ArmContainerIdentity, glm_native_shm_size, glm53_staircase_container_name }
import gunbc.spark.native_serving_realization { ArmUnitIdentity }
