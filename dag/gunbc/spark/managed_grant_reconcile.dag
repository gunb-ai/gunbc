module gunbc.spark.managed_grant_reconcile

import std.types { String, NonEmptyStr, List, Bool }
import std.algebra { trim }
import product.placement_supply { HostIdentity }
import gunbc.spark.managed_access_bootstrap {
  SparkManagedGrant,
  EnableLingerForOwnAccount,
  RebootThisHost,
  spark_managed_grant_population,
  spark_managed_grant_wire,
  spark_managed_grant_sudoers_command,
  spark_managed_executor_login,
  SparkGrantOutcome,
  GrantEnumerated,
  GrantAbsent,
  GrantProbeRefused,
}

// THE GAP BETWEEN DESIRED AND HELD PRIVILEGE, which until now nothing computed.
//
// The bootstrap plan derives grant installs, but it is only ever REPORTED -- there is no actuator --
// and it derives them only for a host whose managed account does not exist yet. So a host that was
// bootstrapped before a grant entered the population is grounded, under-granted, and silent about
// it: the gap surfaces as a bare `sudo: a password is required` at the moment some effect needs the
// privilege, which names neither the grant nor the remedy. That is what happened to the reboot leg
// on srv6, and it is the reason this module exists rather than a second hand-run sudoers edit.
//
// The reconcile is per (host, grant) because that is the grain at which the remedy differs. A
// host-grained "is provisioned" Bool would let one grant's presence answer another grant's question,
// which is the defect the reach observation record already names about itself one layer up.

type SparkManagedGrantStanding
  = GrantHeld { grant: SparkManagedGrant }
  | GrantNotHeld { grant: SparkManagedGrant }
  | GrantStandingUnobserved { grant: SparkManagedGrant, cause: NonEmptyStr }

// SUDO'S OWN DIAGNOSTIC IS THE DISCRIMINATOR, not the exit code. `sudo -n -l` exits non-zero both
// when the account holds no passwordless grant at all and when the probe could not ask -- and those
// have different remedies, so collapsing them would let an unreachable host read as a host needing
// grants installed. The password demand is sudo saying, successfully, that the answer is none.
fn spark_grant_listing_reports_no_passwordless_grant(detail: String) -> Bool {
  string_contains(detail, "a password is required")
}

fn spark_grant_listing_entry_commands(line: String) -> List<String> {
  match line.split(delimiter: "NOPASSWD: ").skip(n: 1).last() {
    Absent => []
    Present { value: rest } => map(rest.split(delimiter: ","), c => trim(c))
  }
}

fn spark_grant_listing_names_command(listing: String, command: String) -> Bool {
  any(flat_map(listing.split(delimiter: "\n"), l => spark_grant_listing_entry_commands(line: l)),
      c => c == command)
}

// A grant is HELD when a listing ENTRY names exactly the command the grant authorizes -- entry by
// entry, not substring over the whole blob.
//
// THE SUBSTRING JOIN THIS REPLACES WAS PREFIX-BLIND, and the failure it admits is the dangerous
// direction: it answers HELD for any installed command the desired one is a prefix of. Concretely,
// `/usr/bin/loginctl enable-linger` contains as a substring every narrower and every wider grant
// beginning with those bytes, so a sudoers entry authorizing MORE than the model desires reads as
// convergence, and a host over-granted relative to the population reports converged=true with
// nothing naming the excess. The grain at which sudo's answer is meaningful is one ENTRY; a
// substring test over the concatenation is a test at no grain at all.
//
// THE ENTRY IS PARSED AT SUDO'S OWN SEAM. `sudo -n -l` renders each authorization as
// `    (root) NOPASSWD: <command>`, so the command is exactly what follows the last `NOPASSWD: ` on
// its line, trimmed. Splitting on that marker rather than on whitespace keeps the parse anchored to
// a token sudo emits, not to a layout guess -- a command containing spaces stays one command.
//
// A LINE WITH NO MARKER YIELDS NO COMMAND, and that is a refusal to answer rather than a `false`
// dressed up as one: the banner lines, the `Matching Defaults entries` block and the blank
// separators are not entries, so they contribute nothing to the join instead of contributing a
// negative vote. The command string still comes from the same row the installer writes, so this
// remains a join against one authority -- now at the grain that authority actually uses.
//
// ONE ENTRY LINE MAY CARRY SEVERAL COMMANDS, so the marker split is not the last one. sudo renders
// a multi-command Cmnd_Spec comma-separated on a single line, and reading that line as ONE command
// would match neither of the two it names. MEASURED on both live hosts 2026-08-22, each grant is
// its own drop-in and therefore its own line -- so the comma case does not occur on srv5 or srv6
// today, and this split is written for the shape sudo may emit rather than only the shape these two
// hosts currently do. Splitting cannot make a wrong answer right-looking: if a command's own
// ARGUMENT ever contained a comma, the fragments match nothing, the grant reads not-held, and the
// installer reinstalls -- the same safe direction as not splitting at all, over a strictly larger
// set of listings read correctly.
//
// `NOPASSWD: ALL` READS NOT HELD, and that is correct rather than a defect, though it is surprising
// enough to be worth naming here before someone files it. `ALL` is a sudoers wildcard, not the
// command string any grant authorizes, so no equality holds and the reconcile reports the grant
// missing on a host that can in fact run it. The alternative -- teaching the join that `ALL`
// subsumes everything -- would make a blanket grant answer for every specific one, which is exactly
// the host-grained "is provisioned" Bool this module exists to avoid.
fn spark_managed_grant_standing_from_outcome(
  grant: SparkManagedGrant,
  outcome: SparkGrantOutcome,
) -> SparkManagedGrantStanding {
  match outcome {
    GrantEnumerated { listing: l } =>
      if spark_grant_listing_names_command(
           listing: l,
           command: spark_managed_grant_sudoers_command(grant: grant) as String,
         ) {
        GrantHeld { grant: grant }
      } else {
        GrantNotHeld { grant: grant }
      }
    GrantAbsent { detail: d } =>
      if spark_grant_listing_reports_no_passwordless_grant(detail: d) {
        GrantNotHeld { grant: grant }
      } else {
        GrantStandingUnobserved {
          grant: grant,
          cause: join(["sudo -n -l failed for a reason other than the password demand: ", d], "") as NonEmptyStr,
        }
      }
    GrantProbeRefused { cause: c } =>
      GrantStandingUnobserved {
        grant: grant,
        cause: join(["the grant probe leg never ran: ", c], "") as NonEmptyStr,
      }
  }
}

fn spark_managed_grant_standings(outcome: SparkGrantOutcome) -> List<SparkManagedGrantStanding> {
  map(spark_managed_grant_population, g =>
    spark_managed_grant_standing_from_outcome(grant: g, outcome: outcome))
}

// THE MISSING SET IS NOT THE COMPLEMENT OF THE HELD SET. An unobserved grant is absent from BOTH,
// because installing a grant we could not measure would be actuating on ignorance, and reporting it
// held would be worse. This is the one place the three-way split pays for itself.
fn spark_managed_grants_to_install(outcome: SparkGrantOutcome) -> List<SparkManagedGrant> {
  flat_map(spark_managed_grant_standings(outcome: outcome), s =>
    match s {
      GrantNotHeld { grant: g } => [g]
      GrantHeld { grant: _ } => []
      GrantStandingUnobserved { grant: _, cause: _ } => []
    })
}

fn spark_managed_grants_unobserved(outcome: SparkGrantOutcome) -> List<SparkManagedGrant> {
  flat_map(spark_managed_grant_standings(outcome: outcome), s =>
    match s {
      GrantStandingUnobserved { grant: g, cause: _ } => [g]
      GrantHeld { grant: _ } => []
      GrantNotHeld { grant: _ } => []
    })
}

// A host is grant-converged when every desired grant is HELD -- which an empty install list does not
// establish on its own, since an entirely unobserved host also produces one. Asking the question of
// the standings directly is what keeps ignorance out of the affirmative answer.
fn spark_managed_grants_converged(outcome: SparkGrantOutcome) -> Bool {
  fold(spark_managed_grant_standings(outcome: outcome), init: true, f: fn(acc, s) {
    acc && match s {
      GrantHeld { grant: _ } => true
      GrantNotHeld { grant: _ } => false
      GrantStandingUnobserved { grant: _, cause: _ } => false
    }
  })
}

// ── What gets written ──────────────────────────────────────────────────────────────────────────

// One drop-in file per grant, named for the grant. Per-grant files rather than one appended file
// because appending has no idempotent form: re-running would duplicate the line, and a reconcile
// whose second run differs from its first is not a reconcile.
fn spark_managed_grant_dropin_name(grant: SparkManagedGrant) -> NonEmptyStr {
  match grant {
    EnableLingerForOwnAccount { subject: _ } => "gunbc-enable-linger" as NonEmptyStr
    RebootThisHost => "gunbc-reboot" as NonEmptyStr
  }
}

fn spark_managed_grant_dropin_path(grant: SparkManagedGrant) -> NonEmptyStr {
  join(["/etc/sudoers.d/", spark_managed_grant_dropin_name(grant: grant) as String], "") as NonEmptyStr
}

// The sudoers line, narrow on every axis sudoers offers: this account, any host, run as root only,
// no password, and exactly one command. A wildcard on any of these would widen the grant past what
// the effect needs, and the population exists precisely so that widening is never the cheap move.
fn spark_managed_grant_sudoers_content(grant: SparkManagedGrant) -> String {
  join([
    spark_managed_executor_login, " ALL=(root) NOPASSWD: ",
    spark_managed_grant_sudoers_command(grant: grant) as String, "\n",
  ], "")
}

fn spark_managed_grant_standing_wire(standing: SparkManagedGrantStanding) -> String {
  match standing {
    GrantHeld { grant: g } =>
      join(["  grant=", spark_managed_grant_wire(grant: g) as String, " standing=held\n"], "")
    GrantNotHeld { grant: g } =>
      join([
        "  grant=", spark_managed_grant_wire(grant: g) as String,
        " standing=not-held install=", spark_managed_grant_dropin_path(grant: g) as String, "\n",
      ], "")
    GrantStandingUnobserved { grant: g, cause: c } =>
      join([
        "  grant=", spark_managed_grant_wire(grant: g) as String,
        " standing=unobserved cause=", c as String, "\n",
      ], "")
  }
}

fn spark_managed_grant_report(host: HostIdentity, outcome: SparkGrantOutcome) -> String {
  join(concat(
    [join([
      "grant-standing host=", host as String,
      " converged=", if spark_managed_grants_converged(outcome: outcome) { "true" } else { "false" }, "\n",
    ], "")],
    map(spark_managed_grant_standings(outcome: outcome), s =>
      spark_managed_grant_standing_wire(standing: s)),
  ), "")
}
