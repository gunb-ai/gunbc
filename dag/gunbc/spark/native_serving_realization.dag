import std.nat { Nat }
import std.measure { basis_point }
import v2.std.optional { Present, Absent }
import v2.std.algebra { zip_map }
import product.placement_supply { HostIdentity, host_identity_eq }
import extdeps.network.ipv4 { Ipv4Address, render_ipv4_address }
import extdeps.systemd.unit_file {
  SystemdUnitFile, ServiceUnitFile, Installable, SystemdServiceDirective,
  Description, After, Requires,
  ServiceType, SimpleMode, ExecStartPre, ExecStart, ExecStop, Restart, RestartSec, TimeoutStartSec, ServiceStandardOutput, ServiceStandardError, OutputAppendFile,
  WantedBy,
  serialize_systemd_unit_file,
}
import extdeps.huggingface.hub { hub_repo_cache_directory_name }
import extdeps.vllm.engine_args { vllm_basis_point_fraction_wire, vllm_prefix_caching_argv }
import extdeps.zhipu.glm_5_3_flash {
  glm_5_3_flash_vllm_tool_call_parser, glm_5_3_flash_vllm_reasoning_parser,
  glm_5_3_flash_vllm_engine_ready_timeout_seconds, glm_5_3_flash_gb10_sparse_indexer_max_logits_mb,
}
