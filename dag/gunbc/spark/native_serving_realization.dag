module gunbc.spark.native_serving_realization

import std.types { String, Bool, List, NonEmptyStr }
import std.nat { Nat }
import v2.std.optional { Present, Absent }
import v2.std.algebra { zip_map }
import product.placement_supply { HostIdentity }
import extdeps.network.ipv4 { Ipv4Address, render_ipv4_address }
import extdeps.systemd.unit_file {
  ServiceUnitFile, Installable,
  Description, After, Requires,
  ServiceType, SimpleMode, ExecStartPre, ExecStart, ExecStop, Restart, RestartSec, TimeoutStartSec, ServiceStandardOutput, ServiceStandardError, OutputAppendFile,
  WantedBy,
  serialize_systemd_unit_file,
}
import extdeps.docker.cli {
  DockerCreateSpec, DockerForegroundRunArgv, DockerForegroundRunRefused,
  docker_run_foreground_argv,
}
import gunbc.spark.serving_arm { ArmIntent, ArmBoundedExperiment, glm_native_concurrent_profile }
import gunbc.spark.serving_arm_launch {
  ArmLaunchPlanned, ArmLaunchRefused, ArmNodeLaunch, glm_native_master_port,
}
import gunbc.spark.glm_group_b_launch { glm_group_b_launch_plan }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }

// ── THE NATIVE FOUR-RANK ARM AS A DECLARED UNIT SET ────────────────────────────────────────────
//
// Group B's GLM arm ran from 2026-09-10 as a bare `docker run` written by the cutover transaction:
// no systemd unit, so the harness's launch-identity evidence (gunbc.spark.vllm_serving_launch
// LaunchedFromDeclaredUnit, a sha256 over the unit's fragment file) had no subject on srv9, and the
// serving route could never name which deployment answered. This module is the arm's declared unit
// set: one head unit on the group's serving head and one rank unit on each other host.
//
// ── THIS MODULE IS A REALIZATION HANDLER, NOT A LAUNCH AUTHORITY ───────────────────────────────
//
// WHAT IT RENDERS IS PROJECTED, NEVER ASSEMBLED. Every field of the container -- image, mounts,
// environment, devices, capabilities, memlock, shm size and the engine's own argv -- comes from the
// one Group-B launch specification at gunbc.spark.glm_group_b_launch, through extdeps.docker.cli's
// foreground verb. The only things this module decides are systemd's: which unit name a rank gets,
// where its log goes, and the directives that make a unit's lifetime equal the container's.
//
// WHAT THIS REPLACED, AND WHY IT WAS A DEFECT. Until 2026-09-18 this module hand-assembled its own
// `docker run` word list, so ONE Group-B launch had two authorities. They had already drifted, on
// three fields nobody could have been told about: the launch spec carried a --shm-size this unit did
// not spell, the two read VLLM_ENGINE_READY_TIMEOUT_S and VLLM_SPARSE_INDEXER_MAX_LOGITS_MB from
// different homes, and only this unit declared the usage-stats reporter off. A comparison needs a
// shared value to be against, and there was none -- which is why the drift was found by reading both
// renderers rather than by anything going red. The equality of the two projections is now claimed:
// dag/test/claim/spark/glm_group_b_launch_authority_witness_test.dag.
//
// THE IMAGE THIS NOW CARRIES IS THE DIGEST-PINNED ONE, WHICH IS A CHANGE TO WHAT THE UNITS SPELL.
// The hand-assembled line named gunbc.spark.serving_arm glm_native_engine_build_image -- the derived
// image's CONTENT-HASHED TAG. The launch specification names the runtime row's pin, which is the
// registry reading's digest reference for the same build. They resolve to the same image on these
// hosts, and the digest is the stronger identity because a tag can be repointed under a running
// fleet; taking the plan's value is what makes there be ONE answer rather than a matched pair.
//
// NO RAY, BECAUSE THE ARM HAS NONE. The pair-serving units spend three directives on a Ray session
// because the DeepSeek image's distributed executor is ray; this arm launches with
// `--distributed-executor-backend mp` over the hosts' own rail addresses, so a rank unit is one
// container lifecycle and one engine line and nothing else.
//
// THE INTENT IS THE BOUNDED EXPERIMENT, FOR THE SAME REASON THE DIRECT-DOCKER HANDLER'S IS. The
// profile these units carry has no execution receipt at 8567 basis points and sixteen sequences, and
// gunbc.spark.serving_arm_launch intent_refusal refuses a normal-serving plan that asserts one. A
// unit set rendered under a different intent than the transaction that relaunches the same arm would
// be two answers to whether this subject is measured, so both handlers declare the same thing.
data glm_native_render_intent: ArmIntent = ArmBoundedExperiment

data glm_native_head_unit_name: NonEmptyStr = "gunbc-glm-native-head.service" as NonEmptyStr
data glm_native_rank_unit_name: NonEmptyStr = "gunbc-glm-native-rank.service" as NonEmptyStr

// THE ENGINE'S PATH INSIDE THE IMAGE, measured 2026-09-16 from the live rank-0 process on srv9
// (`/usr/bin/python3 /usr/local/bin/vllm serve ...`). The pair image's is /opt/env/bin/vllm; the
// incarnation observer's pgrep leg matches on this path, so the two arms' patterns differ and each
// is carried by its own authority. It is NOT part of the launch specification, because the launch
// never spells it -- the image's entrypoint supplies it -- so it is an observation-side fact about
// the image and lives with the module the observers read.
data glm_native_engine_binary: NonEmptyStr = "/usr/local/bin/vllm" as NonEmptyStr

data glm_native_head_log_path: NonEmptyStr = "/var/log/gunbc/glm-native-head.log" as NonEmptyStr
data glm_native_rank_log_path: NonEmptyStr = "/var/log/gunbc/glm-native-rank.log" as NonEmptyStr

// ── THE ARM'S PLAN, READ ONCE ─────────────────────────────────────────────────────────────────
//
// EVERY DERIVED ROSTER BELOW READS THIS, so the hosts the units are rendered for, the hosts the
// apply touches and the hosts a participation reading ranks are one list by construction rather
// than three constructions that happen to agree.
fn glm_native_launch_lines() -> List<ArmNodeLaunch> {
  match glm_group_b_launch_plan(intent: glm_native_render_intent) {
    ArmLaunchRefused { cause: _ } => []
    ArmLaunchPlanned { lines: ls, master: _ } => ls
  }
}

// THE GROUP'S HOSTS IN RANK ORDER, taken from the plan's roster rather than rebuilt. An empty list
// is a plan that refused; every consumer already treats an empty roster as a refusal rather than as
// an arm of zero ranks.
fn glm_native_ranked_hosts() -> List<HostIdentity> {
  map(glm_native_launch_lines(), l => l.node.host)
}

// THE DECLARED MODEL PATH IN THE CONTAINER, read off the engine argv the launch actually renders.
// An earlier revision rebuilt the hub-cache path here from the snapshot pin, which is the same
// derivation the launch already performs -- and a second derivation of one path is what lets a
// readback compare the mount the engine got against a path nothing sent it.
fn glm_native_model_path_in_container() -> String? {
  match glm_native_launch_lines().first() {
    Absent => none
    Present { value: l } => l.engine_argv.first()
  }
}

// A systemd Exec line is argv joined by spaces; a word carrying whitespace or a quote would need
// systemd's own quoting, which this render does not model, so such a word is a refusal. This is the
// same law pair_serving_realization's exec_line states for the pair's units; the two renderers
// share no code because one renders ArgvCommand and this one a bare word list, and generalising the
// helper across both is owed to the consolidation with the pair route, not to this module.
fn glm_native_exec_word_is_plain(w: String) -> Bool {
  !(string_contains(s: w, pattern: " ") || string_contains(s: w, pattern: "\t") || string_contains(s: w, pattern: "\"") || string_contains(s: w, pattern: "'"))
}

fn glm_native_exec_line(words: List<String>) -> NonEmptyStr? {
  if count(words) > 0 && all(words, w => glm_native_exec_word_is_plain(w: w)) {
    Present { value: join(words, " ") as NonEmptyStr }
  } else {
    none
  }
}

type GlmNativeUnitRender
  = GlmNativeUnitRendered { unit_name: NonEmptyStr, text: String }
  | GlmNativeUnitRenderRefused { unit_name: NonEmptyStr, cause: NonEmptyStr }

// THE CONTAINER LINE IS THE SPEC'S FOREGROUND PROJECTION AND NOTHING ELSE. A refusal from
// extdeps.docker.cli is carried through rather than smoothed: the only way it fires is a spec asking
// for a docker-level restart policy, which under systemd means two supervisors, and silently
// dropping the field is the widen DESIGN section 5 forbids.
fn glm_native_unit_exec_words(spec: DockerCreateSpec) -> List<String>? {
  match docker_run_foreground_argv(spec: spec) {
    DockerForegroundRunRefused { cause: _ } => none
    DockerForegroundRunArgv { argv: a } => Present { value: a }
  }
}

fn glm_native_unit_refusal_cause(spec: DockerCreateSpec) -> NonEmptyStr {
  match docker_run_foreground_argv(spec: spec) {
    DockerForegroundRunRefused { cause: c } => c
    DockerForegroundRunArgv { argv: _ } => "the container line is not a plain argv: a rendered word carries whitespace or a quote, which this render does not model" as NonEmptyStr
  }
}

// ONE UNIT PER HOST, THE SAME LINE BUT FOR WHO IT IS. The head and the ranks differ in exactly the
// places the launch plan already differs them -- the node rank in the engine argv and the rail
// address the container publishes as VLLM_HOST_IP -- plus the two this module owns: the unit's name
// and its log path.
fn glm_native_host_unit_file(launch: ArmNodeLaunch) -> GlmNativeUnitRender {
  let is_head = launch.node.node_rank == 0
  let unit_name = if is_head { glm_native_head_unit_name } else { glm_native_rank_unit_name }
  match glm_native_unit_exec_words(spec: launch.container) {
    Absent => GlmNativeUnitRenderRefused { unit_name: unit_name, cause: glm_native_unit_refusal_cause(spec: launch.container) }
    Present { value: words } =>
      match glm_native_exec_line(words: words) {
        Absent => GlmNativeUnitRenderRefused { unit_name: unit_name, cause: "the container line is not a plain argv: a rendered word carries whitespace or a quote, which this render does not model" as NonEmptyStr }
        Present { value: run_line } =>
          GlmNativeUnitRendered {
            unit_name: unit_name,
            text: serialize_systemd_unit_file(file: ServiceUnitFile {
              unit: [
                Description { text: join(["gunbc GLM native four-rank arm, rank ", to_string(launch.node.node_rank), " (", glm_native_concurrent_profile.served_alias as String, ")"], "") as NonEmptyStr },
                After { target: "docker.service network-online.target" as NonEmptyStr },
                Requires { target: "docker.service" as NonEmptyStr },
              ],
              service: [
                ServiceType { mode: SimpleMode },
                ExecStartPre { command: join(["-/usr/bin/docker rm -f ", launch.container.name as String], "") as NonEmptyStr },
                ExecStart { command: run_line },
                ExecStop { command: join(["/usr/bin/docker stop ", launch.container.name as String], "") as NonEmptyStr },
                Restart { policy: "always" as NonEmptyStr },
                RestartSec { duration: "30" as NonEmptyStr },
                TimeoutStartSec { duration: "0" as NonEmptyStr },
                ServiceStandardOutput { stream: OutputAppendFile { path: if is_head { glm_native_head_log_path } else { glm_native_rank_log_path } } },
                ServiceStandardError { stream: OutputAppendFile { path: if is_head { glm_native_head_log_path } else { glm_native_rank_log_path } } },
              ],
              install: Installable { directives: [WantedBy { target: "multi-user.target" as NonEmptyStr }] },
            }),
          }
      }
  }
}

// THE HEAD UNIT IS THE ONE THE HARNESS DIGESTS. The incarnation observer reads the head's unit
// because the head is the rank that exports the endpoint; the rank units export nothing and are
// converged, never observed.
fn glm_native_head_unit_render() -> GlmNativeUnitRender {
  match glm_native_launch_lines().first() {
    Absent => GlmNativeUnitRenderRefused { unit_name: glm_native_head_unit_name, cause: glm_native_plan_refusal() }
    Present { value: l } => glm_native_host_unit_file(launch: l)
  }
}

fn glm_native_plan_refusal() -> NonEmptyStr {
  match glm_group_b_launch_plan(intent: glm_native_render_intent) {
    ArmLaunchRefused { cause: c } => c
    ArmLaunchPlanned { lines: _, master: _ } => "the arm plan resolved but carries no ranks" as NonEmptyStr
  }
}

// EVERY RANK'S UNIT, RENDERED FOR ITS OWN HOST.
fn glm_native_all_unit_renders() -> List<GlmNativeUnitRender> {
  match glm_native_launch_lines() {
    Empty => [GlmNativeUnitRenderRefused { unit_name: glm_native_head_unit_name, cause: glm_native_plan_refusal() }]
    Cons { head: _, tail: _ } => map(glm_native_launch_lines(), l => glm_native_host_unit_file(launch: l))
  }
}

// THE WET RENDER THE CONVERGENCE RUNS. The unit texts are pure; this entry writes each to a
// host-keyed scratch path so an actuation can install them, failing closed on any leg.
fn glm_native_units_render_wet() -> ProcessExit {
  let renders = glm_native_all_unit_renders()
  let hosts = glm_native_ranked_hosts()
  let writes = zip_map(a: renders, b: hosts, f: fn(r, h) {
    match r {
      GlmNativeUnitRenderRefused { unit_name: _, cause: c } =>
        join(["REFUSED ", c as String], "")
      GlmNativeUnitRendered { unit_name: name, text: text } => {
        let w = Filesystem.Write(path: join(["/tmp/", name as String, ".", h as String], ""), content: text)
        if w.success { "ok" } else { join(["WRITE-FAILED ", w.error], "") }
      }
    }
  })
  if all(writes, w => w == "ok") && count(renders) == count(hosts) && count(hosts) > 0 {
    ExitSuccess
  } else {
    exit_failure(reason: join(["glm_native_units_render_wet: ", join(writes, "; ")], ""))
  }
}

// THE WET RENDER THE CONVERGENCE RUNS. The unit text is pure; this entry writes it to a scratch
// path so an actuation can install it on the head host, failing closed on either leg.
fn glm_native_head_unit_render_wet() -> ProcessExit {
  match glm_native_head_unit_render() {
    GlmNativeUnitRenderRefused { unit_name: _, cause: c } =>
      exit_failure(reason: join(["glm_native_head_unit_render_wet: ", c as String], ""))
    GlmNativeUnitRendered { unit_name: name, text: text } => {
      let w = Filesystem.Write(path: join(["/tmp/", name as String], ""), content: text)
      if w.success {
        ExitSuccess
      } else {
        exit_failure(reason: join(["glm_native_head_unit_render_wet: scratch write failed: ", w.error], ""))
      }
    }
  }
}

// THE RENDEZVOUS THIS ARM'S RANKS ARE POINTED AT, derived from the same plan that renders
// --master-addr and --master-port. Deriving the pair (address, port) from anything else would fork
// the launch authority: an observer filtering on an endpoint the launch did not name would answer
// about a store nobody was sent to.
fn glm_native_rendezvous_endpoint(master: Ipv4Address, port: Nat) -> NonEmptyStr {
  join([render_ipv4_address(addr: master) as String, ":", to_string(port)], "") as NonEmptyStr
}

fn glm_native_master_endpoint() -> NonEmptyStr? {
  match glm_group_b_launch_plan(intent: glm_native_render_intent) {
    ArmLaunchRefused { cause: _ } => none
    ArmLaunchPlanned { lines: _, master: m } =>
      Present { value: glm_native_rendezvous_endpoint(master: m, port: glm_native_master_port) }
  }
}
