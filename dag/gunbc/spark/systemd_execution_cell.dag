module gunbc.spark.systemd_execution_cell

import std.types { Bool, String, NonEmptyStr, List, Port }
import std.nat { Nat, nat_range_inclusive }
import product.placement_supply { HostIdentity }
import extdeps.exec.command { shell_quote }
import gunbc.spark.execution_cell {
  ExecutionCellPhase, CellPhaseInventory, CellPhaseQuiescence, CellPhaseDisposal, CellPhaseSettlement,
  CellPhaseReadback, CellPhasePreparation, CellPhaseActivation, CellPhaseRollback,
  ExecutionCellActuation, ExecutionCellOperation, ExecutionCellPhaseResult,
  ExecutionCellActuated, ExecutionCellPhaseRefused,
  ExecutionCellRealization,
  ExecutionCellRefusal,
  ExecutionCellInventoryRefused, ExecutionCellQuiescenceRefused, ExecutionCellDisposalRefused,
  ExecutionCellSettlementRefused, ExecutionCellReadbackRefused, ExecutionCellPreparationRefused,
  ExecutionCellActivationRefused, ExecutionCellRollbackRefused,
}

// ── THE systemd/Docker REALIZATION OF THE EXECUTION-CELL VERBS ───────────────────────────────────
//
// THE CONTRACT NAMES PHASES; THIS MODULE IS ONE REALIZATION OF THEM. gunbc.spark.execution_cell is
// realization-neutral — it names what a realization must supply and never how a substrate does it.
// This module supplies the eight verbs for the current Group B substrate (systemd units over docker
// containers), rendering one privileged shell actuation per member per phase. Firecracker is the
// next realization, for disposable harness workers; it will inhabit the same record with different
// bodies, and the host controller — not the substrate — still owns identity, CAS, conservation,
// disposal and readback.
//
// THE TWO RECEIPTS THE SCRIPTS EMBODY. Run 2 died because a tripped start-rate counter and an orphan
// container blocked start admission before the unit's own ExecStartPre could clean them — so here
// settlement (systemctl reset-failed) and disposal (docker rm -f) are MODELED LEGS that run ahead
// of preparation, never hooks downstream of start. Run 3 died because each leg blocked on its own
// wait loop and the four ranks were never alive together — so here activation is a NON-BLOCKING
// start and the bounded waits live in the profile-readback legs the bracket issues after all four
// starts. THE 262144x6 RUN (2026-09-25) then showed one collective wait on the head's log was not
// enough: the ranks print their own profile lines on their own clocks, tens of seconds after the
// head's on the big allocation, and the stops fired in the gap — so the readback is ONE LEG PER
// HOST (see the readback section below).

// A MEMBER OF THE systemd/Docker CELL: one host, the unit it converges, the container the unit
// supervises, the log the engine appends, and the rendered unit text preparation installs. The
// unit_text is the member's render of the cohort's one generation; carrying it here is what lets
// the prepare verb install exactly the rendered intent, byte for byte.
type SystemdExecutionMember {
  host: HostIdentity
  unit_name: NonEmptyStr
  container_name: NonEmptyStr
  log_path: NonEmptyStr
  unit_text: String
}

// THE MEMBER KEY the cohort admission and the convergence fold match members through: one host
// converges at most one unit of an arm, so the host names the slot.
fn systemd_member_key(m: SystemdExecutionMember) -> String {
  m.host as String
}

// ── THE RESIDUE CLASSES AND THE PHASE THAT REPAIRS EACH ──────────────────────────────────────────
//
// WHAT THE PRIOR GENERATION LEAVES BEHIND, read off one member by the inventory phase. Three
// classes cover the two receipts: a FAILED unit and a TRIPPED start-rate counter both block systemd
// start admission and sit downstream of any cleanup hook the new unit carries (the run-2 lesson —
// settlement must be a modeled leg, not an operator's manual reset-failed); an ORPHAN container
// holds pool bytes the arm needs back (the Sep-23 residue). The repair mapping is the typed half of
// the planted-residue proof: a planted failed unit routes to settlement, a planted orphan container
// routes to disposal, and both precede preparation.
type SystemdResidueClass
  = SystemdResidueUnitFailed
  | SystemdResidueStartRateTripped
  | SystemdResidueOrphanContainer

fn systemd_residue_repair_phase(r: SystemdResidueClass) -> ExecutionCellPhase {
  match r {
    SystemdResidueUnitFailed => CellPhaseSettlement
    SystemdResidueStartRateTripped => CellPhaseSettlement
    SystemdResidueOrphanContainer => CellPhaseDisposal
  }
}

fn systemd_residue_class_wire(r: SystemdResidueClass) -> String {
  match r {
    SystemdResidueUnitFailed => "unit-failed"
    SystemdResidueStartRateTripped => "start-rate-tripped"
    SystemdResidueOrphanContainer => "orphan-container"
  }
}

// ── THE PHASE SCRIPTS ────────────────────────────────────────────────────────────────────────────
//
// INVENTORY READS THE PRIOR GENERATION; IT DOES NOT JUDGE IT. Every probe is `|| true` because the
// census must succeed over whatever is there — nothing at all included — and its value is the
// printed state, which the receipt records for the planted-residue proof. The failed/active/unit and
// container lines are the exact fields the settlement and disposal legs then repair.
fn systemd_inventory_script(member: SystemdExecutionMember) -> String {
  let unit = member.unit_name as String
  let container = member.container_name as String
  join([
    "set -e\n",
    "echo \"inventory unit=", unit, "\"\n",
    "systemctl list-unit-files 'gunbc-glm-native-*' 2>/dev/null || true\n",
    "echo \"active-state ", unit, ": $(systemctl is-active ", unit, " 2>/dev/null || echo unknown)\"\n",
    "systemctl show ", unit, " -p Id -p ActiveState -p SubState -p Result -p NFailed -p StartLimitBurst -p StartLimitIntervalUSec 2>/dev/null || true\n",
    "echo \"inventory container=", container, "\"\n",
    "docker ps -a --filter name=", container, " --format '{{.Names}} {{.Status}}' 2>/dev/null || true\n",
    "echo inventory-complete\n",
  ], "")
}

// QUIESCENCE STOPS WHAT IS THERE; ABSENCE IS NOT AN ERROR. A unit already gone stops as a no-op, so
// the prior generation is withdrawn before disposal and settlement touch it.
fn systemd_quiescence_script(member: SystemdExecutionMember) -> String {
  join([
    "set -e\n",
    "systemctl stop ", member.unit_name as String, " 2>/dev/null || true\n",
    "echo quiesced ", member.unit_name as String, "\n",
  ], "")
}

// DISPOSAL REMOVES THE ORPHAN CONTAINER; the `|| true` idiom is load-bearing, not lenient — an
// absent container is the success state, and a container docker genuinely cannot remove surfaces at
// the readback leg, which refuses instead of admitting a slot that still holds pool bytes.
fn systemd_disposal_script(member: SystemdExecutionMember) -> String {
  join([
    "set -e\n",
    "docker rm -f ", member.container_name as String, " >/dev/null 2>&1 || true\n",
    "echo disposed ", member.container_name as String, "\n",
  ], "")
}

// SETTLEMENT CLEARS THE MANAGER STATE THAT BLOCKS ADMISSION. systemctl reset-failed drops the
// failed state AND the start-rate counter the crash era left behind; it is idempotent, so it runs
// unconditionally ahead of preparation rather than conditionally on what inventory happened to
// find. THIS IS THE RUN-2 LEG: it is modeled here, in the route, never an operator action taken
// between runs.
fn systemd_settlement_script(member: SystemdExecutionMember) -> String {
  join([
    "set -e\n",
    "systemctl reset-failed ", member.unit_name as String, " 2>/dev/null || true\n",
    "echo settled ", member.unit_name as String, "\n",
  ], "")
}

// READBACK REFUSES UNLESS THE SLOT IS ACTUALLY FREE. Unlike the cleanup legs, this check is strict
// under `set -e`: an active unit, a unit still failed after settlement, or a container still present
// after disposal each exit non-zero, and the bracket reads that as the typed refusal that stops the
// cohort before any preparation. Settlement-then-readback is the fail-closed pair: settlement
// attempts the repair, readback verifies it.
fn systemd_readback_script(member: SystemdExecutionMember) -> String {
  let unit = member.unit_name as String
  let container = member.container_name as String
  join([
    "set -e\n",
    "if systemctl is-active ", unit, " >/dev/null 2>&1; then echo \"readback: ", unit, " still active\"; exit 1; fi\n",
    "if systemctl is-failed ", unit, " >/dev/null 2>&1; then echo \"readback: ", unit, " still failed after settlement\"; exit 1; fi\n",
    "if docker container inspect ", container, " >/dev/null 2>&1; then echo \"readback: orphan container ", container, " still present after disposal\"; exit 1; fi\n",
    "echo \"readback: slot free ", unit, "\"\n",
  ], "")
}

// PREPARATION INSTALLS THE RENDERED INTENT AND DOES NOT START IT. Write, compare, move, reload,
// truncate the log so the anchor grep can only match this epoch — and stop. No systemctl start, no
// enable: the experiment unit carries no [Install] section and starting it is activation's verb,
// downstream of every member's preparation.
fn systemd_prepare_script(member: SystemdExecutionMember) -> String {
  let unit = member.unit_name as String
  join([
    "set -e\n",
    "install -d -m 755 /var/log/gunbc\n",
    "printf '%s' ", shell_quote(arg: member.unit_text), " > /etc/systemd/system/", unit, ".next\n",
    "if cmp -s /etc/systemd/system/", unit, ".next /etc/systemd/system/", unit, "; then changed=0; else changed=1; fi\n",
    "mv -f /etc/systemd/system/", unit, ".next /etc/systemd/system/", unit, "\n",
    "systemctl daemon-reload\n",
    ": > ", member.log_path as String, "\n",
    "echo prepared ", unit, " changed=$changed\n",
  ], "")
}

// ACTIVATION IS A NON-BLOCKING START — the run-3 repair. systemctl start admits the unit and
// returns while the engine loads; there is deliberately no wait loop here, so the bracket can issue
// the four starts sequentially and still have all four ranks alive together, with the bounded
// waits living in the per-host profile-readback legs the bracket issues after all four starts.
// Failure to admit the start exits non-zero under `set -e`, which is what makes a partial
// activation observable and rollbackable.
fn systemd_activate_script(member: SystemdExecutionMember) -> String {
  join([
    "set -e\n",
    "systemctl start ", member.unit_name as String, "\n",
    "echo started ", member.unit_name as String, "\n",
  ], "")
}

// ROLLBACK STOPS A STARTED MEMBER. `systemctl stop` runs the unit's ExecStop (docker stop) and
// ExecStopPost (docker rm -f), so a rolled-back member leaves no container holding pool bytes; a
// member that never started stops as a no-op.
fn systemd_rollback_script(member: SystemdExecutionMember) -> String {
  join([
    "set -e\n",
    "systemctl stop ", member.unit_name as String, " 2>/dev/null || true\n",
    "systemctl is-active ", member.unit_name as String, " || echo stopped ", member.unit_name as String, "\n",
  ], "")
}

// ── THE VERBS, WRAPPED INTO THE CONTRACT'S REALIZATION RECORD ────────────────────────────────────

fn systemd_inventory_verb(op: ExecutionCellOperation<SystemdExecutionMember>) -> ExecutionCellPhaseResult<SystemdExecutionMember> {
  ExecutionCellActuated { actuation: ExecutionCellActuation { member: op.member, phase: CellPhaseInventory, body: systemd_inventory_script(member: op.member) } }
}

fn systemd_quiescence_verb(op: ExecutionCellOperation<SystemdExecutionMember>) -> ExecutionCellPhaseResult<SystemdExecutionMember> {
  ExecutionCellActuated { actuation: ExecutionCellActuation { member: op.member, phase: CellPhaseQuiescence, body: systemd_quiescence_script(member: op.member) } }
}

fn systemd_disposal_verb(op: ExecutionCellOperation<SystemdExecutionMember>) -> ExecutionCellPhaseResult<SystemdExecutionMember> {
  ExecutionCellActuated { actuation: ExecutionCellActuation { member: op.member, phase: CellPhaseDisposal, body: systemd_disposal_script(member: op.member) } }
}

fn systemd_settlement_verb(op: ExecutionCellOperation<SystemdExecutionMember>) -> ExecutionCellPhaseResult<SystemdExecutionMember> {
  ExecutionCellActuated { actuation: ExecutionCellActuation { member: op.member, phase: CellPhaseSettlement, body: systemd_settlement_script(member: op.member) } }
}

fn systemd_readback_verb(op: ExecutionCellOperation<SystemdExecutionMember>) -> ExecutionCellPhaseResult<SystemdExecutionMember> {
  ExecutionCellActuated { actuation: ExecutionCellActuation { member: op.member, phase: CellPhaseReadback, body: systemd_readback_script(member: op.member) } }
}

fn systemd_prepare_verb(op: ExecutionCellOperation<SystemdExecutionMember>) -> ExecutionCellPhaseResult<SystemdExecutionMember> {
  ExecutionCellActuated { actuation: ExecutionCellActuation { member: op.member, phase: CellPhasePreparation, body: systemd_prepare_script(member: op.member) } }
}

fn systemd_activate_verb(op: ExecutionCellOperation<SystemdExecutionMember>) -> ExecutionCellPhaseResult<SystemdExecutionMember> {
  ExecutionCellActuated { actuation: ExecutionCellActuation { member: op.member, phase: CellPhaseActivation, body: systemd_activate_script(member: op.member) } }
}

fn systemd_rollback_verb(op: ExecutionCellOperation<SystemdExecutionMember>) -> ExecutionCellPhaseResult<SystemdExecutionMember> {
  ExecutionCellActuated { actuation: ExecutionCellActuation { member: op.member, phase: CellPhaseRollback, body: systemd_rollback_script(member: op.member) } }
}

// THE REALIZATION RECORD. Every verb is always constructible for this substrate — systemd has an
// answer for each phase — so the record builds wholesale; a substrate that could not settle could
// not construct it, which is the contract's point.
fn systemd_execution_realization() -> ExecutionCellRealization<SystemdExecutionMember> {
  ExecutionCellRealization {
    inventory: fn(op) { systemd_inventory_verb(op: op) },
    quiescence: fn(op) { systemd_quiescence_verb(op: op) },
    disposal: fn(op) { systemd_disposal_verb(op: op) },
    settlement: fn(op) { systemd_settlement_verb(op: op) },
    readback: fn(op) { systemd_readback_verb(op: op) },
    prepare: fn(op) { systemd_prepare_verb(op: op) },
    activate: fn(op) { systemd_activate_verb(op: op) },
    rollback: fn(op) { systemd_rollback_verb(op: op) },
  }
}

// ── THE PROFILE READBACK: ONE LEG PER HOST, EVERY LEG BOUNDED BY THE ONE ADMITTED DURATION ────────
//
// THE CONVERGENCE WITNESS, per rank — the Sep-25 repair of the run-3 collective wait. The head leg
// greps the head's log for the cohort's memory-profile anchor, the same prefix
// extdeps.vllm.memory_profile parses, so a captured line is parseable by construction. The head's
// anchor is the cohort's rendezvous — the head cannot profile without its ranks at the store — but
// on the 262144x6 run it was NOT the ranks' own evidence: the head printed its profile line at
// 19:41:57 and the rank workers on srv10/11/12 printed their own per-rank profile lines ("Free
// memory on device", gpu_worker.py:867) in their own rank logs TENS OF SECONDS LATER, after the
// stop legs had already fired. Each rank's byte-wall reading lives in that rank's log and prints
// on that rank's own clock (on the earlier 64K run all four printed within the same second, which
// is why the one-head wait accidentally sufficed there). So the readback phase is ONE LEG PER
// HOST: the head leg waits the cohort anchor in the head's log, and one leg per rank host waits
// that host's own profile line in that host's own rank log. Only after every leg holds may the
// stop legs run.
//
// THE BUDGET IS THE PLAN'S ONE ADMITTED DURATION, SHARED — never minted per leg. Every leg — head
// and ranks alike — derives its poll-iteration backstop from the same admitted_seconds with the
// same arithmetic, because the plan admits exactly one experiment duration and every rank unit
// carries the same RuntimeMaxSec (gunbc.spark.native_serving_realization): the engines stop
// together, and the four waits observe ONE bounded run. A leg's actual consumption is never its
// backstop: each iteration breaks the moment its anchor appears, and exits the moment its unit
// goes inactive, so a dead engine's leg returns within one poll and the sequential legs' waits
// telescope against the engines' one shared lifetime. Charging the plan's duration once per leg
// would count a single run four times.
//
// A RANK THAT DIES BEFORE PRINTING fails its own host's leg: the inactivity exit fires, the leg
// exits non-zero, and the bracket's verdict fold (gunbc.spark.native_experiment_apply
// spark_profile_readback_verdict) locates the refusal on that host. The anchor and the log path
// are parameters, so the head leg and the rank legs are one script inhabited twice, not two
// spellings that can drift.
fn systemd_profile_readback_script(member: SystemdExecutionMember, profile_anchor: String, admitted_seconds: Nat) -> String {
  let iterations = nat_range_inclusive(lo: 1, hi: (admitted_seconds + 4) / 5)
  let unit = member.unit_name as String
  join([
    "set -e\n",
    "for i in ", join(map(iterations, n => to_string(n)), " "), "; do if grep -q \"", profile_anchor, "\" ", member.log_path as String, " 2>/dev/null; then echo profile-line-seen; break; fi; if ! systemctl is-active ", unit, " >/dev/null 2>&1; then echo unit-inactive-before-profile; exit 1; fi; sleep 5; done\n",
    "grep \"", profile_anchor, "\" ", member.log_path as String, " | tail -1\n",
    "systemctl is-active ", unit, "\n",
  ], "")
}

// ── THE FRAGMENTATION-CHURN WORKLOAD SCRIPTS, ONE RENDERER PER LEG ───────────────────────────────
//
// THE EXECUTION CELL HAS NO WORKLOAD PHASE: the contract's eight phases end at activation and its
// readback observes launch evidence, not serving behaviour. The fragmentation-churn experiment the
// bracket plans when a plan targets ArmFragmentationAllowance (gunbc.spark.native_experiment_apply
// spark_experiment_workload_phase) is the one consumer that must DRIVE the engine between the
// profile readbacks and the deterministic stop, so its scripts — the readiness gate, the prefill
// seats, the churn driver, the sampler — render here beside the profile
// readback, as this substrate's answer for "run a bounded workload on the head host and read the
// allocator while it runs". They travel over the same privileged leg as every other script the
// realization renders (sudo sh -s on the host), so their substrate assumptions are only what every
// Group B host already carries: curl, awk, nvidia-smi, and the engine's OpenAI-compatible endpoint
// on the loopback (--network host publishes 0.0.0.0:serve_port).
//
// THE THREE LEGS, AND WHY THREE. (a) the cold full-window prefill seats mint the pool state the
// churn questions; (b) the churn driver issues bounded mixed-length requests for the plan's window;
// (c) the allocator sampler reads the gap instruments at the runbook cadence while the churn runs
// beside it and folds the peak-over-window the receipt mints from. The transport runs legs
// sequentially, so "sample while churning" is spelled (b) launching the bounded driver detached and
// (c) sampling in the foreground over the churn window plus the driver's own request-tail backstop,
// reaping the driver through its exit file — never two transport legs that would have to overlap.

// THE WORKLOAD STATE, on the head host's own disk: one directory per member, named from the
// container the unit supervises. The legs are separate privileged sessions, so the prefill's
// calibrated per-block token yield, the driver's pid and exit file, the warm reference reading and
// the sampler's series travel as files in this directory. It is deliberately left in place after
// the run: it is the raw material the receipt layer folds, and the stop contract removes the
// container, never host evidence.
fn systemd_workload_state_dir(member: SystemdExecutionMember) -> String {
  join(["/var/tmp/", member.container_name as String, "-workload"], "")
}

// THE PROMPT MATERIAL, and why it defeats the prefix cache this profile turns ON. Every generated
// block carries its coordinates in a fixed-width marker — (seat, block) for the prefills, (client,
// request, block) for the churn — so no two blocks anywhere in the workload are byte-identical: two
// seats share nothing from the first token, and no churn request can fold against an earlier one.
// The body is a fixed sixteen-word line so the per-block token yield is stable across the run, and
// the marker varies inside the block rather than at its edge, so block-boundary token merges land
// on carried counts, not on the requested size. The engine's own usage.prompt_tokens is the
// authority for what a seat cost — the prefill_batch_sweep idiom, which carried the returned count
// rather than the requested one.
data systemd_workload_block_body: NonEmptyStr = "alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa quebec" as NonEmptyStr

// (a) THE COLD FULL-WINDOW PREFILL SEATS, one concurrent request per seat of the plan's workload.
// A single calibration request derives the per-block token yield against THIS engine and tokenizer —
// no tokenizer table is modeled or trusted, and the yield the run itself measures is the only
// spelling that cannot drift from the served model. Each seat prompt is then generated at
// blocks = seat window / yield, so every seat lands within one block of the full window, and all
// seats fire concurrently with max_tokens 1 (the seats are prefill work; generation is beside the
// point). A seat whose request fails, or whose carried prompt_tokens shows the engine refused the
// window, fails the leg under set -e with the seat's stderr preserved in the state directory and
// the seat line already printed, so the refusal is located by seat. The leg closes by recording the
// warm process_mib reference the sampler folds the gap against — taken with every seat complete and
// no request in flight, it is the experiment's accounted baseline.
fn systemd_workload_prefill_script(member: SystemdExecutionMember, serve_port: Port, served_alias: NonEmptyStr, seat_count: Nat, seat_tokens: Nat) -> String {
  let state = systemd_workload_state_dir(member: member)
  let body = systemd_workload_block_body as String
  join([
    "set -e\n",
    "state=", state, "\n",
    "install -d -m 755 \"$state\"\n",
    "base=http://127.0.0.1:", to_string(serve_port), "\n",
    "served_alias=", served_alias as String, "\n",
    "body=\"", body, "\"\n",
    "curl -fsS -m 10 \"$base/v1/models\" >/dev/null\n",
    "awk -v alias=\"$served_alias\" -v body=\"$body\" 'BEGIN { printf \"{\\\"model\\\":\\\"%s\\\",\\\"prompt\\\":\\\"s00b00001 %s s00b00002 %s s00b00003 %s s00b00004 %s\\\",\\\"max_tokens\\\":1,\\\"temperature\\\":0}\", alias, body, body, body, body }' > \"$state/probe.json\"\n",
    "probe_resp=$(curl -fsS -m 120 \"$base/v1/completions\" -H 'Content-Type: application/json' -d @\"$state/probe.json\")\n",
    "probe_tokens=$(printf '%s' \"$probe_resp\" | grep -o '\"prompt_tokens\":[0-9][0-9]*' | head -1 | cut -d: -f2)\n",
    "case \"$probe_tokens\" in ''|*[!0-9]*) echo \"prefill-calibration-unreadable: no usage.prompt_tokens in the probe response\"; exit 20 ;; esac\n",
    "yield=$(( probe_tokens / 4 ))\n",
    "if [ \"$yield\" -lt 8 ]; then echo \"prefill-calibration-implausible: per-block yield $yield below 8 tokens\"; exit 21; fi\n",
    "printf '%s' \"$yield\" > \"$state/block_tokens\"\n",
    "blocks=$(( ", to_string(seat_tokens), " / yield ))\n",
    "seat_pids=\"\"\n",
    "seat=1\n",
    "while [ \"$seat\" -le ", to_string(seat_count), " ]; do\n",
    "  awk -v alias=\"$served_alias\" -v body=\"$body\" -v seat=\"$seat\" -v n=\"$blocks\" 'BEGIN { printf \"{\\\"model\\\":\\\"%s\\\",\\\"prompt\\\":\\\"\", alias; b = 1; while (b <= n) { printf \"s%02db%05d %s \", seat, b, body; b = b + 1 } printf \"\\\",\\\"max_tokens\\\":1,\\\"temperature\\\":0}\" }' > \"$state/seat_$seat.json\"\n",
    "  ( curl -fsS -m 1800 \"$base/v1/completions\" -H 'Content-Type: application/json' -d @\"$state/seat_$seat.json\" > \"$state/seat_$seat.resp\" 2> \"$state/seat_$seat.err\"; echo $? > \"$state/seat_$seat.rc\" ) &\n",
    "  seat_pids=\"$seat_pids $!\"\n",
    "  seat=$(( seat + 1 ))\ndone\n",
    "for pid in $seat_pids; do wait \"$pid\"; done\n",
    "seat=1\n",
    "failed=0\n",
    "while [ \"$seat\" -le ", to_string(seat_count), " ]; do\n",
    "  rc=$(cat \"$state/seat_$seat.rc\")\n",
    "  if [ \"$rc\" != \"0\" ]; then echo \"seat $seat prefill-failed rc=$rc\"; failed=1; seat=$(( seat + 1 )); continue; fi\n",
    "  seat_tokens_realized=$(grep -o '\"prompt_tokens\":[0-9][0-9]*' \"$state/seat_$seat.resp\" | head -1 | cut -d: -f2)\n",
    "  case \"$seat_tokens_realized\" in ''|*[!0-9]*) echo \"seat $seat prompt-tokens-unreadable\"; failed=1 ;; *) echo \"seat $seat prompt_tokens=$seat_tokens_realized\" ;; esac\n",
    "  seat=$(( seat + 1 ))\ndone\n",
    "if [ \"$failed\" != \"0\" ]; then exit 22; fi\n",
    "warm=$(nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader,nounits | awk -F', ' '{ v = $2 + 0; if (v > m) m = v } END { printf \"%d\", m }')\n",
    "if [ \"$warm\" -le 0 ]; then echo \"warm-reference-unreadable: nvidia-smi reports no compute process after the prefills\"; exit 23; fi\n",
    "printf '%s' \"$warm\" > \"$state/warm_mib\"\n",
    "echo \"prefill-seats-complete seats=", to_string(seat_count), " window_tokens=", to_string(seat_tokens), " yield=$yield blocks=$blocks warm_mib=$warm\"\n",
  ], "")
}

// (b-i) THE CHURN DRIVER ITSELF, rendered as a standalone script the launcher installs and starts
// detached. Bounded BOTH ways, never unbounded: the loop stops at the window's end timestamp and at
// the per-client request count, whichever it hits first. Lengths are mixed inside the plan's
// 8K-to-full-window band by drawing block counts from awk's rand() — POSIX sh carries no $RANDOM,
// and awk's rand() is the seeded portable draw the fleet's shell already carries. Every request is
// max_tokens 1 (the churn allocates and frees prefill windows; it does not decode) and carries its
// (client, request, block) coordinates, so no request can be served from the prefix cache another
// request populated. The driver writes its exit file as its LAST act — "done fail=0" only when
// every client finished inside both bounds with every request answered — and the sampler reaps it
// through that file, so a driver that is killed without writing refuses located instead of reading
// as a quiet success.
fn systemd_workload_churn_driver_script(serve_port: Port, served_alias: NonEmptyStr, state_dir: String, body: String, clients: Nat, low_tokens: Nat, high_tokens: Nat, requests_per_client: Nat, window_seconds: Nat, request_timeout_seconds: Nat) -> String {
  join([
    "# churn driver, rendered by gunbc.spark.systemd_execution_cell; bounded by design\n",
    "state=", state_dir, "\n",
    "base=http://127.0.0.1:", to_string(serve_port), "\n",
    "served_alias=", served_alias as String, "\n",
    "body=\"", body, "\"\n",
    "yield=$(cat \"$state/block_tokens\")\n",
    "case \"$yield\" in ''|*[!0-9]*) echo \"churn-driver: block_tokens missing or unreadable in $state\"; exit 30 ;; esac\n",
    "end=$(( $(date +%s) + ", to_string(window_seconds), " ))\n",
    "low_blocks=$(( ", to_string(low_tokens), " / yield ))\n",
    "span_blocks=$(( (", to_string(high_tokens), " - ", to_string(low_tokens), ") / yield ))\n",
    "client_pids=\"\"\n",
    "client=1\n",
    "while [ \"$client\" -le ", to_string(clients), " ]; do\n",
    "  (\n",
    "    n=0\n",
    "    while [ \"$(date +%s)\" -lt \"$end\" ] && [ \"$n\" -lt ", to_string(requests_per_client), " ]; do\n",
    "      n=$(( n + 1 ))\n",
    "      blocks=$(( low_blocks + $(awk -v span=\"$span_blocks\" 'BEGIN { srand(); printf \"%d\", int(rand() * (span + 1)) }') ))\n",
    "      awk -v alias=\"$served_alias\" -v body=\"$body\" -v client=\"$client\" -v req=\"$n\" -v nb=\"$blocks\" 'BEGIN { printf \"{\\\"model\\\":\\\"%s\\\",\\\"prompt\\\":\\\"\", alias; b = 1; while (b <= nb) { printf \"c%02dr%05db%05d %s \", client, req, b, body; b = b + 1 } printf \"\\\",\\\"max_tokens\\\":1,\\\"temperature\\\":0}\" }' > \"$state/churn_\"$client\"_\"$n\".json\"\n",
    "      curl -fsS -m ", to_string(request_timeout_seconds), " \"$base/v1/completions\" -H 'Content-Type: application/json' -d @\"$state/churn_\"$client\"_\"$n\".json\" -o /dev/null || exit 31\n",
    "    done\n",
    "  ) &\n",
    "  client_pids=\"$client_pids $!\"\n",
    "  client=$(( client + 1 ))\ndone\n",
    "driver_failed=0\n",
    "for pid in $client_pids; do wait \"$pid\" || driver_failed=1; done\n",
    "printf 'done fail=%s\n' \"$driver_failed\" > \"$state/churn_driver.exit\"\n",
    "exit \"$driver_failed\"\n",
  ], "")
}

// (b-ii) THE CHURN LAUNCHER LEG. Writes the rendered driver into the state directory, starts it
// detached with nohup so it survives this leg's session ending, records its pid for the record, and
// exits — the leg's contract is "the bounded driver is running with the rendered bounds", and the
// sampler leg reaps it through the exit file. Detached is not unbounded: the driver renders the
// same window end and request count the launcher banner names, so even a sampler that never runs
// leaves a driver that stops by construction, and the worst case the receipt can show is a bounded
// driver whose window expired, never an unbounded process.
fn systemd_workload_churn_launch_script(member: SystemdExecutionMember, serve_port: Port, served_alias: NonEmptyStr, clients: Nat, low_tokens: Nat, high_tokens: Nat, requests_per_client: Nat, window_seconds: Nat, request_timeout_seconds: Nat) -> String {
  let state = systemd_workload_state_dir(member: member)
  let body = systemd_workload_block_body as String
  join([
    "set -e\n",
    "state=", state, "\n",
    "install -d -m 755 \"$state\"\n",
    "cat > \"$state/churn_driver.sh\" <<'GUNBC_CHURN_DRIVER_EOF'\n",
    systemd_workload_churn_driver_script(serve_port: serve_port, served_alias: served_alias, state_dir: state, body: body, clients: clients, low_tokens: low_tokens, high_tokens: high_tokens, requests_per_client: requests_per_client, window_seconds: window_seconds, request_timeout_seconds: request_timeout_seconds),
    "GUNBC_CHURN_DRIVER_EOF\n",
    "nohup sh \"$state/churn_driver.sh\" > \"$state/churn_driver.log\" 2>&1 &\n",
    "printf '%s' $! > \"$state/churn_driver.pid\"\n",
    "echo \"churn-driver-launched pid=$(cat \"$state/churn_driver.pid\") window_seconds=", to_string(window_seconds), " clients=", to_string(clients), " requests_per_client=", to_string(requests_per_client), " band_tokens=", to_string(low_tokens), "-", to_string(high_tokens), "\"\n",
  ], "")
}

// (0) THE ENDPOINT-READINESS GATE, run as the workload phase's first leg. THE RECEIPT THAT SENT IT
// HERE: the first churn run failed its prefill leg with "Failed to connect to 127.0.0.1 port 30000"
// — the profile lines the readback anchors wait on print during engine init, BEFORE the API server
// binds, so readback convergence establishes the engine's memory evidence and nothing about the
// front door. The gate polls GET /v1/models — the liveness read gunbc.serving.engine_progress
// names — until the endpoint answers. THE BOUND IS THE PLAN'S ONE ADMITTED DURATION, shared not
// re-minted: the iterations render from the same admitted_seconds with the same (seconds + 4) / 5
// arithmetic and the same five-second sleep the profile readbacks use, so the cohort is charged one
// experiment duration across every bounded wait in the cell and a budget move moves every bound
// together. A unit that goes inactive mid-wait exits within one poll (the engines' RuntimeMaxSec
// expiry is exactly that death); an endpoint still silent at the bound refuses located with the
// budget named. The gate is readiness, not a failure classifier — every later refusal arm is
// unchanged.
fn systemd_workload_readiness_script(member: SystemdExecutionMember, serve_port: Port, admitted_seconds: Nat) -> String {
  let iterations = nat_range_inclusive(lo: 1, hi: (admitted_seconds + 4) / 5)
  let unit = member.unit_name as String
  join([
    "set -e\n",
    "base=http://127.0.0.1:", to_string(serve_port), "\n",
    "ready=0\n",
    "for i in ", join(map(iterations, n => to_string(n)), " "), "; do if curl -fsS -m 10 \"$base/v1/models\" >/dev/null 2>&1; then ready=1; break; fi; if ! systemctl is-active ", unit, " >/dev/null 2>&1; then echo unit-inactive-before-endpoint-ready; exit 51; fi; sleep 5; done\n",
    "if [ \"$ready\" != \"1\" ]; then echo \"endpoint-not-ready-after-", to_string(admitted_seconds), "s\"; exit 50; fi\n",
    "echo \"endpoint-ready bounded_seconds=", to_string(admitted_seconds), "\"\n",
  ], "")
}

// (c) THE ALLOCATOR SAMPLER LEG. Reads the gap instruments at the runbook cadence while the churn
// driver runs beside it, then folds the peak-over-window the receipt mints from. WHAT A SAMPLE
// READS, named because the v2 KV-allocation-plan emission is startup-only: the ALLOCATED side is
// nvidia-smi's per-process used_memory for the largest compute process — the pool carve is fixed
// after startup and the weights are resident, so process growth across the window beyond the warm
// reference is the allocator holding bytes the engine cannot account for; the ACCOUNTING side is
// vllm:kv_cache_usage_perc from the loopback /metrics, carried per sample as the engine's own block
// accounting (extdeps.vllm.metrics names what that gauge does and refuses — it counts every block
// that is not FREE, cached prefixes included, so it is the accounting series, never the gap
// itself). Liveness is the front door /v1/models, the same read gunbc.serving.engine_progress
// names. The sampler stops when the driver's exit file appears — covering the window plus any
// in-flight request tail, bounded by window + request timeout + one cadence — and each tick also
// checks the driver's recorded pid, so a driver that died without writing its exit file (a launch
// skew, a missing calibration) refuses located within one cadence instead of riding out the
// backstop. Then it refuses located on a driver that reported failure or outlived the backstop, and
// only then prints the peak line: warm reference, peak, gap, sample count, window.
fn systemd_workload_sampling_script(member: SystemdExecutionMember, serve_port: Port, window_seconds: Nat, cadence_seconds: Nat, request_timeout_seconds: Nat) -> String {
  let state = systemd_workload_state_dir(member: member)
  join([
    "set -e\n",
    "state=", state, "\n",
    "base=http://127.0.0.1:", to_string(serve_port), "\n",
    ": > \"$state/samples.tsv\"\n",
    "warm=$(cat \"$state/warm_mib\" 2>/dev/null || true)\n",
    "case \"$warm\" in ''|*[!0-9]*) echo \"allocator-sampling: warm_mib reference missing; run the prefill leg first\"; exit 40 ;; esac\n",
    "backstop=$(( $(date +%s) + ", to_string(window_seconds), " + ", to_string(request_timeout_seconds), " + ", to_string(cadence_seconds), " ))\n",
    "peak=0\n",
    "ticks=0\n",
    "while true; do\n",
    "  if [ -f \"$state/churn_driver.exit\" ]; then break; fi\n",
    "  if [ \"$(date +%s)\" -ge \"$backstop\" ]; then echo \"churn-driver-tail-backstop-reached\"; exit 41; fi\n",
    "  driver_pid=$(cat \"$state/churn_driver.pid\" 2>/dev/null || true)\n",
    "  if [ -n \"$driver_pid\" ] && ! kill -0 \"$driver_pid\" 2>/dev/null; then echo \"churn-driver-died-without-exit pid=$driver_pid\"; exit 45; fi\n",
    "  if ! curl -fsS -m 10 \"$base/v1/models\" >/dev/null 2>&1; then echo \"endpoint-unreachable-at-tick ticks=$ticks\"; exit 42; fi\n",
    "  used=$(nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader,nounits | awk -F', ' '{ v = $2 + 0; if (v > m) m = v } END { printf \"%d\", m }')\n",
    "  case \"$used\" in ''|*[!0-9]*|0) echo \"engine-process-unreadable-at-tick ticks=$ticks\"; exit 43 ;; esac\n",
    "  usage=$(curl -fsS -m 10 \"$base/metrics\" | grep -m1 '^vllm:kv_cache_usage_perc' | awk '{ print $NF }' || true)\n",
    "  if [ -z \"$usage\" ]; then usage=unread; fi\n",
    "  printf 'allocator-sample t=%s process_mib=%s kv_cache_usage_perc=%s\n' \"$(date +%s)\" \"$used\" \"$usage\" >> \"$state/samples.tsv\"\n",
    "  if [ \"$used\" -gt \"$peak\" ]; then peak=$used; fi\n",
    "  ticks=$(( ticks + 1 ))\n",
    "  sleep ", to_string(cadence_seconds), "\n",
    "done\n",
    "if ! grep -q '^done fail=0$' \"$state/churn_driver.exit\"; then echo \"churn-driver-failed: $(cat \"$state/churn_driver.exit\")\"; exit 44; fi\n",
    "gap=$(( peak - warm ))\n",
    "echo \"allocator-gap-peak warm_mib=$warm peak_mib=$peak gap_mib=$gap samples=$ticks window_seconds=", to_string(window_seconds), " cadence_seconds=", to_string(cadence_seconds), "\"\n",
  ], "")
}
