module gunbc.spark.v41_source_patch_converge_wet

import std.types { String, NonEmptyStr }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import v2.std.optional { Present, Absent }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.vllm.source_build { vllm_clone_url }
import gunbc.clock_read { clock_now_probed_at, probed_at_word }
import gunbc.fleet_known_hosts_anchor {
  FleetSshExecutionContext, SshTarget,
  fleet_ssh_attempt_identity,
  materialize_fleet_known_hosts_anchor, known_hosts_materialization_receipt,
  fleet_ssh_execution_context_of,
}
import gunbc.fleet_ssh_credential_verify {
  FleetSshCredentialVerified, FleetSshCredentialIdentityMismatch, FleetSshCredentialDerivationRefused,
  fleet_ssh_credential_verification_refusal_reason,
}
import gunbc.fleet_multi_principal_probe { probe_agent_credential_verification }
import gunbc.spark.host_commitment { SparkHostAdmitted, SparkHostRefused, admit_unplaced_host_live, release_host_effect_live }
import gunbc.spark.managed_access_bootstrap { spark_managed_executor_login }
import gunbc.spark.fabric_reach { ReachManagementLan, spark_reach_endpoint, spark_reach_path_wire }
import gunbc.spark.v41_runtime_candidate {
  V41PatchesObserved, V41PatchesAbsentByObservation, V41PatchesUnestablished,
  v41_storage_backed_patch_population, v41_candidate_recipe,
}
import gunbc.spark.vllm_runtime_image_build {
  vllm_build_host_purpose, vllm_source_dir, vllm_build_root, vllm_build_host_residue,
}
import gunbc.spark.v41_source_patch_converge {
  converge_vllm_source_with_patches,
  v41_patched_source_receipt_line, v41_patched_source_converged,
}

// OPERATOR CLI DOOR FOR THE APPLY SEAM. Vanilla vllm_source_acquire_wet still converges an
// unpatched checkout at the fallback recipe. This entry supplies the candidate's DigestFile'd P
// into converge_vllm_source_with_patches — the fold does not choose P. Same invocation shape as
// vllm_source_acquire_wet: gunbc run --entry this file --function v41_patched_source_acquire_wet
// --arg host=<identity>. Do not hand-apply on srv1.
//
// converge_vllm_runtime_image_with_patches is NOT this door. Its consumer is a declared frontier
// on that fold (patched sibling of vllm_runtime_image_build_ci_wet). Wiring it here would put a
// hours-long docker build behind a source-acquire that exists to exercise git apply.

data v41_patched_source_acquire_attempt_raw: String = "v41-patched-source-acquire"
data v41_patched_source_acquire_receipt_path: String = "target/v41-patched-source-acquire-receipt.txt"

fn v41_patched_source_acquire_wet(host: String) -> ProcessExit
  uses net: Network
{
  match v41_storage_backed_patch_population() {
    V41PatchesAbsentByObservation => exit_failure(reason: "the storage-backed patch population is absent by observation")
    V41PatchesUnestablished { obligation: o } => exit_failure(reason: o as String)
    V41PatchesObserved { patches: ps, partition: _ } => {
      let now = clock_now_probed_at()
      match admit_unplaced_host_live(term: vllm_build_host_effect_term, raw: host, purpose: vllm_build_host_purpose, residue: vllm_build_host_residue()) {
        SparkHostRefused { cause: why } => exit_failure(reason: why as String)
        SparkHostAdmitted { host: build_host, claim: claim } =>
          release_host_effect_live(handle: claim, exit: {
          match fleet_ssh_attempt_identity(raw: v41_patched_source_acquire_attempt_raw) {
            Absent => exit_failure(reason: "attempt identity is not a safe path segment")
            Present { value: attempt } =>
              match probe_agent_credential_verification(attempt: attempt) {
                FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed } =>
                  exit_failure(reason: fleet_ssh_credential_verification_refusal_reason(verification: FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed }))
                FleetSshCredentialDerivationRefused { cause: cause } =>
                  exit_failure(reason: fleet_ssh_credential_verification_refusal_reason(verification: FleetSshCredentialDerivationRefused { cause: cause }))
                FleetSshCredentialVerified { binding: binding } => {
                  let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
                  match fleet_ssh_execution_context_of(outcome: materialization, credential: binding) {
                    Absent => exit_failure(reason: join(["trust could not be established, so no leg ran: ", known_hosts_materialization_receipt(outcome: materialization)], ""))
                    Present { value: context } =>
                      match spark_reach_endpoint(host: build_host, path: ReachManagementLan) {
                        Absent => exit_failure(reason: join(["no ", spark_reach_path_wire(p: ReachManagementLan), " endpoint for ", build_host as String], ""))
                        Present { value: endpoint } => {
                          let target = SshTarget { endpoint: endpoint as NonEmptyStr, principal: spark_managed_executor_login as NonEmptyStr }
                          let r = v41_candidate_recipe()
                          let converged = converge_vllm_source_with_patches(target: target, context: context, r: r, patches: ps)
                          let body = join([
                            join(["v41 patched source acquire probed_at=", probed_at_word(reading: now) as String, " host=", build_host as String, " endpoint=", endpoint, " principal=", spark_managed_executor_login, "\n"], ""),
                            join(["root=", vllm_build_root() as String, " source=", vllm_source_dir() as String, " clone_url=", vllm_clone_url(source: r.source), "\n"], ""),
                            known_hosts_materialization_receipt(outcome: materialization),
                            v41_patched_source_receipt_line(c: converged),
                          ], "")
                          let w = Filesystem.Write(path: v41_patched_source_acquire_receipt_path, content: body)
                          if !w.success {
                            exit_failure(reason: join(["v41 patched source acquire receipt write failed: ", w.error], ""))
                          } else if v41_patched_source_converged(c: converged) {
                            ExitSuccess
                          } else {
                            exit_failure(reason: join(["the patched source did not converge:\n", body], ""))
                          }
                        }
                      }
                  }
                }
              }
          }})
      }
    }
  }
}
