module gunbc.spark.spark_gpu_direct_capability

import std.types { Bool, String, NonEmptyStr, List }
import extdeps.nvidia.cuda_driver {
  CudaQueryOutcome, CudaQuerySucceeded,
  CudaDeviceAttribute, GpuDirectRdmaSupportedAttribute, DmaBufSupportedAttribute,
  cuda_device_attribute_argv,
}
import extdeps.nvidia.gpu_direct_rdma {
  GpuDirectRdmaCapability, gpu_direct_rdma_capability, gpu_direct_rdma_capability_wire,
}

// ── WHAT THE GB10 DEVICES ANSWERED, AND WHEN ───────────────────────────────────────────────────
//
// THESE ARE READINGS, NOT POLICY. The values below were returned by `cuDeviceGetAttribute` on
// spark-0c75 inside the serving container on 2026-09-18, with the driver reporting
// `580.173.02`. They are carried as OUTCOMES rather than as booleans so the CUresult stays visible:
// both queries SUCCEEDED and both answered zero, which is a reading about the platform and not a
// failure of the probe -- the distinction that decides whether a disabled GPUDirect path is a
// supported state or a broken one.
//
// THE PRODUCER IS NAMED RATHER THAN THE NUMBERS TRANSCRIBED as prose: `cuda_device_attribute_argv`
// renders the exact argv that re-derives each of these, so a reader who doubts a row runs the row's
// own producer. What is stored here is the ANSWER at a stated time on a stated host, which is what a
// receipt is; what is not stored is any derived claim about what the answer implies.
data spark_gb10_platform: NonEmptyStr = "NVIDIA GB10 Grace Blackwell (DGX Spark), unified LPDDR5X" as NonEmptyStr

data spark_gb10_capability_read_provenance: NonEmptyStr = "cuDeviceGetAttribute on device 0 inside glm-native-tp4 on spark-0c75 (192.168.1.236), NVRM 580.173.02, read 2026-09-18; both queries returned CUresult 0" as NonEmptyStr

data spark_gb10_peer_memory_outcome: CudaQueryOutcome = CudaQuerySucceeded { value: 0 }
data spark_gb10_dma_buf_outcome: CudaQueryOutcome = CudaQuerySucceeded { value: 0 }

data spark_gb10_gpu_direct_capability: GpuDirectRdmaCapability = gpu_direct_rdma_capability(
  platform: spark_gb10_platform,
  peer_memory: spark_gb10_peer_memory_outcome,
  dma_buf: spark_gb10_dma_buf_outcome,
)

// THE ARGV THAT RE-DERIVES EACH READING, so the citation is a producer rather than a sentence.
fn spark_gpu_direct_capability_argv(a: CudaDeviceAttribute) -> List<String> {
  cuda_device_attribute_argv(a: a)
}

fn spark_gb10_capability_wire() -> NonEmptyStr {
  gpu_direct_rdma_capability_wire(c: spark_gb10_gpu_direct_capability)
}
