module gunbc.spark.serving_runtime_receipt


data spark_serving_runtime_archive_admission_receipt_provenance_note: String = "RELEASE-ARCHIVE ADMISSION PROVENANCE — not running-process attestation and not proof of completed runtime install. Records which cited release-asset row the invoking executor admitted via DownloadToFile + SHA-256 verify. Extraction, executable placement, systemd enable, model pull, and per-host delivery are separate #8225 follow-on; this receipt must not be read as claiming they happened. Out-of-band binary replacement leaves the receipt stale while /api/version may still answer — wet observation joins receipt digest with the independently probed version wire via ollama_runtime_materialization_identity_for_observed_release."

data spark_serving_runtime_archive_admission_receipt_note: String = "Executor-local release-archive admission receipt. gunbc.package_delivery.materialize_spark_serving_ollama_runtime_bundle writes via write_spark_serving_runtime_archive_admission_receipt after digest admission; wet observation reads spark_serving_runtime_receipt_wire_path via spark_serving_runtime_receipt_probe_words over SSH and still requires independent /api/version agreement — never re-derives the cited release-asset digest from desired state alone. Missing or unreadable receipt on an active unit refuses rather than collapsing to SparkServingReadbackAbsent."

type SparkServingRuntimeArchiveAdmissionReceipt {
  release_asset_digest_hex: std.types.NonEmptyStr
}

data spark_serving_executor_home: FilePath = "/home/gunbc-automation" as FilePath

data spark_serving_runtime_receipt_rel: String = ".local/share/gunbc/spark-serving/ollama-runtime-receipt.json"

data spark_serving_runtime_receipt_release_asset_digest_member: String = "release_asset_digest_hex"

data spark_serving_runtime_receipt_path_note: String = "Receipt path is fleet-constant under gunbc-automation on every Spark host (/home/gunbc-automation/.local/share/gunbc/spark-serving/ollama-runtime-receipt.json). Wet SSH probe selects which machine to read; the path string does not vary because srv5 and srv6 share the same executor home layout. The receipt record carries only the admitted release-asset digest — not which host was probed or which host ran the writer. Unit basename is gunbc.spark.serving_unit_identity spark_serving_unit_name."

fn spark_serving_runtime_receipt_wire_path() -> FilePath {
  spark_serving_runtime_receipt_path()
}

fn spark_serving_runtime_receipt_path() -> FilePath {
  concat(
    spark_serving_executor_home as String,
    concat("/", spark_serving_runtime_receipt_rel),
  ) as FilePath
}

fn spark_serving_runtime_receipt_probe_words() -> std.types.List<String> {
  ["cat", spark_serving_runtime_receipt_wire_path() as String]
}

fn spark_serving_parse_runtime_receipt_json(stdout: String) -> gunbc.spark.serving_readback_parse.SparkServingReadbackField {
  match parse_json(s: stdout) {
    Absent =>
      gunbc.spark.serving_readback_parse.SparkServingReadbackRefused {
        cause: "ollama runtime archive admission receipt is not parseable JSON" as std.types.NonEmptyStr,
      }
    Present { value: doc } =>
      spark_serving_readback_field_from_member_lookup(
        lookup: json_object_unique_member(
          v: doc,
          key: spark_serving_runtime_receipt_release_asset_digest_member,
        ),
        member: spark_serving_runtime_receipt_release_asset_digest_member,
      )
  }
}

// THE MATERIALIZATION RECEIPT READ, which is a different receipt on a different machine from the
// archive-admission one above and must not be confused with it.
//
// The archive-admission receipt records which release archive THE EXECUTOR admitted -- a fact about
// srv1, written by gunbc.package_delivery through the local filesystem. The materialization receipt
// is written INTO the runtime root on the host the closure was published to, and names that closure's
// identity. Observing a Spark host asks the second question, and for a while it asked it by reading
// the first receipt's path over SSH on a machine where nothing writes it: every observation of a
// correctly converged host refused with a No-such-file, while the converge path called the same host
// converged.
//
// Bare content, not JSON: the installer writes the identity digest and nothing else, so a parse step
// here would be inventing structure the writer does not produce.
fn spark_serving_materialization_receipt_field_from_probe(
  probe: extdeps.ssh.session.SshSessionExecResult?,
) -> gunbc.spark.serving_readback_parse.SparkServingReadbackField {
  match probe {
    Absent =>
      gunbc.spark.serving_readback_parse.SparkServingReadbackRefused {
        cause: "runtime materialization receipt probe leg did not run" as std.types.NonEmptyStr,
      }
    Present { value: r } =>
      if r.success {
        if trim(s: r.stdout) == "" {
          gunbc.spark.serving_readback_parse.SparkServingReadbackRefused {
            cause: "runtime materialization receipt is empty, so the published closure names no identity" as std.types.NonEmptyStr,
          }
        } else {
          gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: trim(s: r.stdout) }
        }
      } else {
        gunbc.spark.serving_readback_parse.SparkServingReadbackRefused {
          cause: join([
            "runtime materialization receipt probe failed exit=", to_string(r.exit_code),
            " stderr=", r.stderr,
          ], "") as std.types.NonEmptyStr,
        }
      }
  }
}

fn spark_serving_runtime_receipt_field_from_probe(
  probe: extdeps.ssh.session.SshSessionExecResult?,
) -> gunbc.spark.serving_readback_parse.SparkServingReadbackField {
  match probe {
    Absent =>
      gunbc.spark.serving_readback_parse.SparkServingReadbackRefused {
        cause: "runtime archive admission receipt probe leg did not run" as std.types.NonEmptyStr,
      }
    Present { value: r } =>
      if r.success {
        spark_serving_parse_runtime_receipt_json(stdout: r.stdout)
      } else {
        gunbc.spark.serving_readback_parse.SparkServingReadbackRefused {
          cause: join([
            "runtime archive admission receipt probe failed exit=", to_string(r.exit_code),
            " stderr=", r.stderr,
          ], "") as std.types.NonEmptyStr,
        }
      }
  }
}

fn spark_serving_runtime_receipt_parent_path() -> FilePath {
  concat(
    spark_serving_executor_home as String,
    "/.local/share/gunbc/spark-serving",
  ) as FilePath
}

fn ensure_spark_serving_runtime_receipt_parent_dir() -> Bool {
  shell.Mkdir.Parents(path: spark_serving_runtime_receipt_parent_path()).success
}

fn spark_serving_runtime_archive_admission_receipt_json(
  receipt: SparkServingRuntimeArchiveAdmissionReceipt,
) -> String {
  serialize_json(v: JsonObject {
    members: [
      extdeps.languages.json.emit.JsonKeyValue {
        key: spark_serving_runtime_receipt_release_asset_digest_member,
        value: JsonString { value: receipt.release_asset_digest_hex as String },
      },
    ],
  })
}

fn write_spark_serving_runtime_archive_admission_receipt_at_path(
  path: FilePath,
  receipt: SparkServingRuntimeArchiveAdmissionReceipt,
) -> Bool {
  Filesystem.Write(
    path: path as String,
    content: spark_serving_runtime_archive_admission_receipt_json(receipt: receipt),
  ).success
}

fn write_spark_serving_runtime_archive_admission_receipt(
  receipt: SparkServingRuntimeArchiveAdmissionReceipt,
) -> Bool {
  if ensure_spark_serving_runtime_receipt_parent_dir() == false {
    false
  } else {
    write_spark_serving_runtime_archive_admission_receipt_at_path(
      path: spark_serving_runtime_receipt_wire_path(),
      receipt: receipt,
    )
  }
}

fn read_spark_serving_runtime_archive_admission_receipt_bytes_at_path(path: FilePath) -> String? {
  let read = Filesystem.Read(path: path as String)
  if read.success == false {
    none
  } else {
    let trimmed = (read.content as String).trim()
    if trimmed == "" {
      none
    } else {
      Present { value: trimmed }
    }
  }
}

fn read_spark_serving_runtime_archive_admission_receipt_bytes() -> String? {
  read_spark_serving_runtime_archive_admission_receipt_bytes_at_path(
    path: spark_serving_runtime_receipt_wire_path(),
  )
}
