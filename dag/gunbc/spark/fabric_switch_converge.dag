module gunbc.spark.fabric_switch_converge

import std.types { Bool, List, NonEmptyStr }
import std.nat { Nat }
import extdeps.mikrotik.crs812 { Crs812LaneSpeed, Crs812FecMode }
import gunbc.world_converge {
  WorldObservation, WorldObserved, WorldUnobservable,
  WorldDifference, WorldInAgreement, WorldDiverged,
  WorldActuation, WorldActuationRefused,
  WorldConvergenceHandler,
  WorldConvergenceResult,
  world_converge,
}
import gunbc.spark.fabric_switch_desired {
  DesiredSpeedUndecidedCause,
  Crs812SwitchIntent, SwitchIntent, SwitchIntentUndecided,
  Crs812LaneIntent, LaneCarriesLeg, LaneOwnedByItsPair,
  fabric_switch_intent,
}

// THE SWITCH AS A CONVERGENCE SUBJECT, WHICH IS A DIFFERENT SUBJECT FROM THE CABLE PLANT.
//
// `product.cable_plant_converge` answers whether the CABLES can carry the required mode.
// This module answers whether the SWITCH is configured the way the cable plant's answer says it
// must be. They are two subjects, so they are two bindings of the one `gunbc.world_converge`
// authority rather than one widened handler -- adding the switch adds a binding here and does not
// touch the convergence authority, which is the property that authority was shaped for.
//
// THE DESIRED SIDE IS DERIVED AND CAN REFUSE. `fabric_switch_intent()` is undecided whenever the
// cable plant is, so this module's observe stage inherits that refusal rather than re-deciding it.
// One cable fault therefore reports in exactly one place and propagates; it is never re-diagnosed
// by a second matcher that could disagree with the first.

// WHAT THE SWITCH ACTUALLY REPORTS, AND THE ADMISSION THAT NOBODY HAS ASKED IT YET.
//
// No RouterOS reading exists in this repository today: the fleet's lane configuration has never
// been captured. DESIGN section 3 rules that a missing observation is a coverage obligation
// DOWNSTREAM, never an `Unobserved` property authored into the upstream module -- so
// `extdeps.mikrotik.crs812` carries no such field, and the gap surfaces here, as a reading that is
// structurally absent rather than defaulted. `LaneNeverRead` is not a placeholder to be deleted when
// the capture lands; it is the permanent arm for a lane the collector could not reach, and the
// capture merely stops it from being the only arm the fleet produces.
type Crs812LaneReading
  = LaneNeverRead { interface: NonEmptyStr }
  | LaneReadingTaken {
      interface: NonEmptyStr
      speed: Crs812LaneSpeed
      fec: Crs812FecMode
      enabled: Bool
    }

type Crs812ConvergenceSubject sole_constructor {
  switch: NonEmptyStr
  intent: Crs812SwitchIntent
  readings: List<Crs812LaneReading>
}

fn crs812_convergence_subject(
  switch: NonEmptyStr,
  intent: Crs812SwitchIntent,
  readings: List<Crs812LaneReading>,
) -> Crs812ConvergenceSubject {
  Crs812ConvergenceSubject { switch: switch, intent: intent, readings: readings }
}

type ObservedLane sole_constructor {
  interface: NonEmptyStr
  speed: Crs812LaneSpeed
  fec: Crs812FecMode
  enabled: Bool
}

type Crs812SwitchObserved sole_constructor {
  lanes: List<ObservedLane>
}

// ONE DIVERGENCE ROW PER LANE, AND THE CAUSE IS A CLOSED VOCABULARY. A lane can disagree with its
// intent in exactly the ways the intent can constrain it, so a free-text explanation would be a
// second, unjoinable naming of a fact the intent type already carries.
type LaneDivergenceCause
  = LaneSpeedDisagrees { desired: Crs812LaneSpeed, reported: Crs812LaneSpeed }
  | LaneFecDisagrees { desired: Crs812FecMode, reported: Crs812FecMode }
  | LaneShouldCarryLegButIsDisabled
  | LaneShouldBeOwnedByItsPairButIsEnabled
  | LaneIsNotInTheIntent

type Crs812LaneDivergence sole_constructor {
  interface: NonEmptyStr
  cause: LaneDivergenceCause
}

type Crs812SwitchRefusal
  = SwitchIntentUndecidedHere { cause: DesiredSpeedUndecidedCause }
  | SwitchLaneNeverRead { interface: NonEmptyStr }
  | SwitchHoldsNoLanes { switch: NonEmptyStr }
  | SwitchCannotBeActuatedHere { divergences: List<Crs812LaneDivergence> }

type Crs812SwitchReceipt sole_constructor {
  lanes_read: Nat
}

// ================= THE ONE COMPARISON =================
//
// Every equality this module needs is asked of one exhaustive fold per closed vocabulary, so a new
// lane speed or FEC mode is one row and every comparison re-decides at once. The alternative --
// comparing at each call site -- is the non-fold residue DESIGN section 6 names, and on a coproduct
// whose arms are added by an upstream vendor it is the shape that silently keeps answering `false`
// for a mode nobody taught it about.
fn crs812_lane_speed_eq(a: Crs812LaneSpeed, b: Crs812LaneSpeed) -> Bool {
  crs812_lane_speed_ordinal(s: a) == crs812_lane_speed_ordinal(s: b)
}

fn crs812_lane_speed_ordinal(s: Crs812LaneSpeed) -> Nat {
  match s {
    Lane50GCr2 => 0
    Lane100GCr2 => 1
    Lane100GCr4 => 2
    Lane200GCr4 => 3
    Lane400GCr8 => 4
  }
}

fn crs812_fec_mode_eq(a: Crs812FecMode, b: Crs812FecMode) -> Bool {
  crs812_fec_mode_ordinal(f: a) == crs812_fec_mode_ordinal(f: b)
}

fn crs812_fec_mode_ordinal(f: Crs812FecMode) -> Nat {
  match f {
    FecAuto => 0
    FecOff => 1
    Fec74 => 2
    Fec91 => 3
  }
}

fn lane_intent_interface(i: Crs812LaneIntent) -> NonEmptyStr {
  match i {
    LaneCarriesLeg { interface: n, speed: s, fec: f } => n
    LaneOwnedByItsPair { interface: n } => n
  }
}

fn intent_for_lane(intent: Crs812SwitchIntent, interface: NonEmptyStr) -> Crs812LaneIntent? {
  match intent {
    SwitchIntentUndecided { cause: c } => Absent
    SwitchIntent {
      identity: id, board_name: b, management_interface: m, bridge: br, lanes: ls,
    } => filter(ls, i => lane_intent_interface(i: i) == interface).first()
  }
}

// A LANE THE INTENT DOES NOT NAME IS A DIVERGENCE, NOT A LANE TO SKIP. Dropping it would narrow the
// compared population to the lanes that already agree by construction, which is the absorbing
// fallback DESIGN section 5 forbids: the switch would converge more easily the more of it went
// unmodelled.
fn lane_divergences(intent: Crs812SwitchIntent, lane: ObservedLane) -> List<Crs812LaneDivergence> {
  match intent_for_lane(intent: intent, interface: lane.interface) {
    Absent => [Crs812LaneDivergence { interface: lane.interface, cause: LaneIsNotInTheIntent }]
    Present { value: i } =>
      match i {
        LaneOwnedByItsPair { interface: n } =>
          if lane.enabled {
            [Crs812LaneDivergence {
              interface: n, cause: LaneShouldBeOwnedByItsPairButIsEnabled,
            }]
          } else { [] }
        LaneCarriesLeg { interface: n, speed: s, fec: f } =>
          if lane.enabled {
            flat_map([
              if crs812_lane_speed_eq(a: s, b: lane.speed) { [] } else {
                [Crs812LaneDivergence {
                  interface: n, cause: LaneSpeedDisagrees { desired: s, reported: lane.speed },
                }]
              },
              if crs812_fec_mode_eq(a: f, b: lane.fec) { [] } else {
                [Crs812LaneDivergence {
                  interface: n, cause: LaneFecDisagrees { desired: f, reported: lane.fec },
                }]
              },
            ], d => d)
          } else {
            [Crs812LaneDivergence { interface: n, cause: LaneShouldCarryLegButIsDisabled }]
          }
      }
  }
}

fn switch_unread_interfaces(subject: Crs812ConvergenceSubject) -> List<NonEmptyStr> {
  flat_map(subject.readings, r =>
    match r {
      LaneNeverRead { interface: n } => [n]
      LaneReadingTaken { interface: n, speed: s, fec: f, enabled: e } => []
    })
}

fn switch_read_lanes(subject: Crs812ConvergenceSubject) -> List<ObservedLane> {
  flat_map(subject.readings, r =>
    match r {
      LaneReadingTaken { interface: n, speed: s, fec: f, enabled: e } =>
        [ObservedLane { interface: n, speed: s, fec: f, enabled: e }]
      LaneNeverRead { interface: n } => []
    })
}

// ================= THE FOUR HANDLER STAGES =================
//
// UNDECIDED INTENT FIRST, THEN UNREAD, THEN EMPTY -- in that order, because each later question is
// meaningless without the earlier one. Comparing readings against an undecided intent would produce
// divergences whose desired side does not exist, and reporting on the lanes that happened to answer
// makes an uncaptured switch indistinguishable from a correctly configured one.
fn world_observe_fabric_switch(
  subject: Crs812ConvergenceSubject,
  context: Bool,
) -> WorldObservation<Crs812SwitchObserved, Crs812SwitchRefusal> {
  match subject.intent {
    SwitchIntentUndecided { cause: c } => WorldUnobservable { cause: SwitchIntentUndecidedHere { cause: c } }
    SwitchIntent {
      identity: id, board_name: b, management_interface: m, bridge: br, lanes: ls,
    } =>
      match switch_unread_interfaces(subject: subject).first() {
        Present { value: n } => WorldUnobservable { cause: SwitchLaneNeverRead { interface: n } }
        Absent => {
          let lanes = switch_read_lanes(subject: subject)
          match lanes.first() {
            Absent => WorldUnobservable { cause: SwitchHoldsNoLanes { switch: subject.switch } }
            Present { value: l } => WorldObserved { value: Crs812SwitchObserved { lanes: lanes } }
          }
        }
      }
  }
}

fn switch_divergences(
  subject: Crs812ConvergenceSubject,
  observed: Crs812SwitchObserved,
) -> List<Crs812LaneDivergence> {
  flat_map(observed.lanes, l => lane_divergences(intent: subject.intent, lane: l))
}

fn world_fabric_switch_differences(
  subject: Crs812ConvergenceSubject,
  context: Bool,
  observed: Crs812SwitchObserved,
) -> WorldDifference<Crs812LaneDivergence> {
  let divergences = switch_divergences(subject: subject, observed: observed)
  match divergences.first() {
    Absent => WorldInAgreement
    Present { value: d } => WorldDiverged { differences: divergences }
  }
}

// ACTUATION REFUSES HERE, AND THE REFUSAL IS THE POINT. Writing a RouterOS lane configuration is an
// effect on a device this repository has no modelled transport to, so an apply stage that returned a
// receipt would be fabricating the one thing convergence exists to prove. The refusal carries the
// full divergence list, so the operator gets the exact edit rather than a bare failure -- and when a
// transport is modelled, THIS is the arm that gains it, with no consumer changing shape.
fn world_fabric_switch_apply(
  subject: Crs812ConvergenceSubject,
  context: Bool,
  observed: Crs812SwitchObserved,
  differences: List<Crs812LaneDivergence>,
) -> WorldActuation<Crs812SwitchReceipt, Crs812SwitchRefusal> {
  WorldActuationRefused { cause: SwitchCannotBeActuatedHere { divergences: differences } }
}

fn world_fabric_switch_unchanged_receipt(
  subject: Crs812ConvergenceSubject,
  context: Bool,
  observed: Crs812SwitchObserved,
) -> Crs812SwitchReceipt {
  Crs812SwitchReceipt { lanes_read: list_length(items: observed.lanes) }
}

type Crs812SwitchConvergenceHandler = WorldConvergenceHandler<Crs812ConvergenceSubject, Bool, Crs812SwitchObserved, Crs812LaneDivergence, Crs812SwitchReceipt, Crs812SwitchRefusal>

data fabric_switch_convergence_handler: Crs812SwitchConvergenceHandler = WorldConvergenceHandler {
  observe: world_observe_fabric_switch,
  differences: world_fabric_switch_differences,
  apply: world_fabric_switch_apply,
  unchanged_receipt: world_fabric_switch_unchanged_receipt,
}

type Crs812SwitchConvergence = WorldConvergenceResult<Crs812ConvergenceSubject, Crs812SwitchObserved, Crs812SwitchReceipt, Crs812SwitchRefusal>

fn converge_fabric_switch(subject: Crs812ConvergenceSubject) -> Crs812SwitchConvergence {
  world_converge(subject: subject, context: true, handler: fabric_switch_convergence_handler)
}

// ================= THE FLEET'S OWN SWITCH =================
//
// The readings are `LaneNeverRead` for every lane the intent names, because that is the true state:
// no RouterOS capture exists. So this entry point refuses at the observe stage today, and it refuses
// with the ONE fact that is missing -- the interface nobody read -- rather than reporting a switch
// that trivially agrees because nothing was compared. It becomes a real comparison the moment a
// capture lands, with no shape change anywhere.
fn fabric_switch_intent_interfaces() -> List<NonEmptyStr> {
  match fabric_switch_intent() {
    SwitchIntentUndecided { cause: c } => []
    SwitchIntent {
      identity: id, board_name: b, management_interface: m, bridge: br, lanes: ls,
    } => map(ls, i => lane_intent_interface(i: i))
  }
}

fn fabric_switch_subject() -> Crs812ConvergenceSubject {
  crs812_convergence_subject(
    switch: "gunbc-fabric-switch" as NonEmptyStr,
    intent: fabric_switch_intent(),
    readings: map(fabric_switch_intent_interfaces(), n => LaneNeverRead { interface: n }),
  )
}

fn fabric_switch_convergence() -> Crs812SwitchConvergence {
  converge_fabric_switch(subject: fabric_switch_subject())
}
