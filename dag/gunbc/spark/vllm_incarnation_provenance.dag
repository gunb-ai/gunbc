// ── ONE OBSERVATION TRANSACTION, AND IT IS THE ONLY ROUTE TO AN INCARNATION ────────────────────
//
// WHAT THE PREVIOUS SHAPE CLAIMED AND DID NOT HOLD (exact-head review, 2026-09-14). The seal admitted
// one caller, bind_incarnation, and bind_incarnation was an ordinary function over five independent
// arguments -- a launch, an acceptance, a rank count, a source resolution and a runtime resolution. So
// the forgery the seal was added to stop had moved one call up: this repository's own witnesses bound
// incarnations out of a fixture launch, a caller-supplied `ranks_required: 4` and a source resolution
// whose rung named "probe/repo". And the one route that did observe the world minted its checkpoint
// coordinate from two string literals: the per-rank verifier this module carried had no caller at all,
// so the live receipt reading `rung=revision-addressed upstream verification` was produced without any
// verification running.
//
// SO THE JOINS LIVE IN ONE FUNCTION AND THE WORLD IS ITS ONLY PARAMETER. observe_native_incarnation
// asks every question itself, at loci it derives -- which launch, which plan, which hosts, which
// snapshot, which directory -- and a port supplies only the answers. A fixture can make the world say
// anything, but it cannot skip a question, pair an answer with a question it was not asked, or supply
// the rank population, the checkpoint subject or the directory the members are read from. bind_incarnation
// is reachable only through it: the seal admits bind_incarnation, and each later step of the transaction
// admits only the step before it, back to this function.
//
// THE PORT IS THE REALIZATION SEAM DESIGN SECTION 2 DESCRIBES, NOT A TEST HOOK. Production binds it to
// remote readings (native_incarnation_port); a witness binds it to an authored world. Both run the
// identical transaction, which is what makes a positive control a control over the production path.

// ── WHICH READING OF THE LAUNCH IS BEING ASKED FOR ────────────────────────────────────────────
//
// THE PHASE IS AN ARGUMENT SO A RESTART DURING THE WINDOW IS AUTHORABLE. Production ignores it -- it
// reads the world each time it is asked -- but a closure that took no argument would answer both
// readings identically, and the red that proves the before/after comparison runs could not be written.
type IncarnationObservationPhase
  = BeforeAssessment
  | AfterAssessment

// ── THE READINGS A PORT RETURNS, EACH ONE ABLE TO SAY IT DID NOT READ ─────────────────────────
//
// A DIRECTORY IS LISTED OR IT IS UNREAD, AND NOTHING IN BETWEEN BECOMES AN EMPTY LISTING. The shell
// readers this replaces counted with `ls DIR | grep | wc -l`: a pipeline's status is its LAST stage's, so
// a directory that did not exist printed "0" and exited zero, and a missing snapshot read as a snapshot
// with no model-side code and no template. That is unread rendered as absent -- the collapse the
// coordinate type in gunbc.serving.incarnation_provenance exists to prevent, arriving through a pipe.
type DirectoryPopulationReading
  = DirectoryListed { names: List<String> }
  | DirectoryUnread { cause: NonEmptyStr }

// A PATH IS DIGESTED, IS NOT THERE, OR COULD NOT BE READ -- three answers with three remedies.
type PathDigestReading
  = PathDigestObserved { hash: ContentHash }
  | PathNotPresent
  | PathDigestUnread { cause: NonEmptyStr }

type FileTextReading
  = FileTextRead { text: String }
  | FileTextUnread { cause: NonEmptyStr }

type NativeIncarnationPort {
  endpoint_launch: fn(IncarnationObservationPhase) -> VllmEndpointProcessLaunchObservation
  running_basis_points: fn(ArmNode) -> Nat?
  population: fn(ArmLaunchPlan) -> NativeDeploymentObserved
  checkpoint_verification: fn(HostIdentity, ModelSnapshotDesired) -> AcquisitionObservation
  directory_population: fn(HostIdentity, NonEmptyStr) -> DirectoryPopulationReading
  path_digest: fn(HostIdentity, NonEmptyStr) -> PathDigestReading
  file_text: fn(HostIdentity, NonEmptyStr) -> FileTextReading
  runtime_image: fn(HostIdentity) -> ServingCoordinateReading
}

// ── THE RECEIPT NAMES THIS OBSERVATION, NOT THE CLASS OF PRODUCER THAT TOOK IT ────────────────
//
// IT WAS A CONSTANT, "gunbc.spark.vllm_incarnation_provenance", so two incarnations observed a day apart
// carried one receipt, and nothing in a sealed closure could say which reading established it. The
// attempt is the instant the transaction started (minted by the wet entry, refused when the clock is
// unreadable) and the launch is the one the transaction bound.
//
// THE RENDERING IS INJECTIVE BECAUSE ITS ONLY FREE FIELD IS NOT LAST. The producer is a constant prefix
// and the launch key is a fixed-width structural digest at the end, so an attempt of any content is
// recovered by stripping both -- no separator inside the attempt can move a boundary.
data vllm_incarnation_producer: NonEmptyStr = "gunbc.spark.vllm_incarnation_provenance" as NonEmptyStr

fn incarnation_receipt(attempt: NonEmptyStr, launch: VllmEndpointProcessLaunch) -> ObservationReceiptRef {
  join([
    vllm_incarnation_producer as String, "/", attempt as String, "/",
    vllm_endpoint_process_launch_key(launch: launch) as String,
  ], "") as ObservationReceiptRef
}

// ── THE PRODUCTION READERS, EACH DECIDING READ-OR-NOT FROM ITS OWN EXIT STATUS ────────────────
//
// THE LISTING ENDS IN A MARKER THAT ONLY A SUCCESSFUL `ls` CAN REACH. `&&` short-circuits, so a listing
// that failed prints no marker and exits nonzero; a listing that succeeded prints every name and then
// the marker. The reader accepts the names only when the marker is the last line.
data directory_listed_marker: String = "GUNBC-DIRECTORY-LISTED"

fn directory_population_argv(dir: NonEmptyStr) -> List<String> {
  ["sh", "-c", join(["ls -1A -- ", shell_quote(arg: dir as String), " && echo ", directory_listed_marker], "")]
}

fn directory_population_of(raw: String) -> DirectoryPopulationReading {
  let lines = split(s: raw, delimiter: "\n")
  match lines.last() {
    Absent => DirectoryUnread { cause: "the listing printed nothing, not even its completion marker" as NonEmptyStr }
    Present { value: tail } =>
      if tail != directory_listed_marker {
        DirectoryUnread { cause: "the listing did not reach its completion marker" as NonEmptyStr }
      } else {
        DirectoryListed { names: filter(lines.take(n: count(lines) - 1), name => name != "") }
      }
  }
}

func observe_directory_population(ctx: SparkRemoteExecutionContext, host: HostIdentity, dir: NonEmptyStr) -> DirectoryPopulationReading
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: directory_population_argv(dir: dir))
  if !remote_run_succeeded(r: r) {
    DirectoryUnread { cause: join(["the directory ", dir as String, " could not be listed: ", remote_run_text(r: r)], "") as NonEmptyStr }
  } else {
    directory_population_of(raw: remote_run_stdout(r: r))
  }
}

// sha256sum IS THE MEMBER'S OWN CONTENT IDENTITY AND IS NOT THE MANIFEST REFERENCE. The reference is a
// structural identity over the canonical axis material; these digests are what make the members
// verifiable, and they are cryptographic where the reference is not. The command is not a pipeline:
// `sha256sum` alone decides the status, and the hex is cut from its output afterwards.
data path_not_present_wire: String = "ABSENT"

fn path_digest_argv(path: NonEmptyStr) -> List<String> {
  ["sh", "-c", join([
    "P=", shell_quote(arg: path as String),
    "; if [ -e \"$P\" ]; then sha256sum -b -- \"$P\"; else echo ", path_not_present_wire, "; fi",
  ], "")]
}

fn path_digest_of(raw: String, path: NonEmptyStr) -> PathDigestReading {
  if raw == path_not_present_wire {
    PathNotPresent
  } else {
    match split(s: raw, delimiter: " ").first() {
      Absent => PathDigestUnread { cause: join(["the path ", path as String, " answered nothing"], "") as NonEmptyStr }
      Present { value: hex } =>
        match sha256_hex_digest(hex: hex) {
          Present { value: d } => PathDigestObserved { hash: Sha256Hash(d) }
          Absent => PathDigestUnread {
            cause: join(["the path ", path as String, " answered neither a sha256 digest nor ", path_not_present_wire], "") as NonEmptyStr,
          }
        }
    }
  }
}

func observe_path_digest(ctx: SparkRemoteExecutionContext, host: HostIdentity, path: NonEmptyStr) -> PathDigestReading
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: path_digest_argv(path: path))
  if !remote_run_succeeded(r: r) {
    PathDigestUnread { cause: join(["the path ", path as String, " could not be read: ", remote_run_text(r: r)], "") as NonEmptyStr }
  } else {
    path_digest_of(raw: remote_run_stdout(r: r), path: path)
  }
}

func observe_file_text(ctx: SparkRemoteExecutionContext, host: HostIdentity, path: NonEmptyStr) -> FileTextReading
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: ["cat", "--", path as String])
  if !remote_run_succeeded(r: r) {
    FileTextUnread { cause: join(["the file ", path as String, " could not be read: ", remote_run_text(r: r)], "") as NonEmptyStr }
  } else {
    FileTextRead { text: remote_run_stdout(r: r) }
  }
}

// THE IMAGE CONTENT ID IS THE RUNTIME'S IDENTITY AND IT IS ALREADY A SHA-256. A first-party built image
// has NO registry digest -- measured on this fleet: docker inspect of the derived runtime returns
// RepoDigests [] because it was built locally and loaded from an archive -- so its own Id is the only
// content identity it has.
fn runtime_image_id_argv(container: NonEmptyStr) -> List<String> {
  ["docker", "inspect", "-f", go_template_action(body: ".Image"), container as String]
}

fn strip_sha256_prefix(raw: String) -> String {
  if starts_with(s: raw, prefix: "sha256:") { substring(s: raw, start: 7, end: string_length(s: raw)) } else { raw }
}

func observe_runtime_image(ctx: SparkRemoteExecutionContext, host: HostIdentity, container: NonEmptyStr) -> ServingCoordinateReading
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: runtime_image_id_argv(container: container))
  if !remote_run_succeeded(r: r) {
    CoordinateUnestablished {
      obligation: join(["the running container's image id could not be read on ", host as String], "") as NonEmptyStr,
    }
  } else {
    match sha256_hex_digest(hex: strip_sha256_prefix(raw: remote_run_stdout(r: r))) {
      Present { value: d } => CoordinateObserved { hash: Sha256Hash(d) }
      Absent => CoordinateUnestablished {
        obligation: "the running container reported an image id that is not a sha256 digest" as NonEmptyStr,
      }
    }
  }
}

// ── A MEMBER'S COORDINATE, DECIDED FROM THE LISTING AND THE DIGEST TOGETHER ───────────────────
//
// ABSENCE IS READ FROM A SUCCESSFUL LISTING, NEVER FROM A DIGEST READ. A name the listing did not carry
// is AbsentByObservation; a name it did carry is digested, and a digest read that then finds nothing is
// a CONTRADICTION between two readings of one directory -- which is unestablished, not absent.
data snapshot_member_model_config: NonEmptyStr = "config.json" as NonEmptyStr
data snapshot_member_tokenizer: NonEmptyStr = "tokenizer.json" as NonEmptyStr
data snapshot_member_tokenizer_config: NonEmptyStr = "tokenizer_config.json" as NonEmptyStr
data snapshot_member_special_tokens: NonEmptyStr = "special_tokens_map.json" as NonEmptyStr
data snapshot_member_generation_defaults: NonEmptyStr = "generation_config.json" as NonEmptyStr
data snapshot_member_processor_config: NonEmptyStr = "processor_config.json" as NonEmptyStr

fn member_path(dir: NonEmptyStr, member: String) -> NonEmptyStr {
  join([dir as String, "/", member], "") as NonEmptyStr
}

fn listing_names(listing: DirectoryPopulationReading) -> List<String> {
  match listing {
    DirectoryListed { names: ns } => ns
    DirectoryUnread { cause: _ } => []
  }
}

fn listing_carries(listing: DirectoryPopulationReading, name: String) -> Bool {
  any(listing_names(listing: listing), n => n == name)
}

fn member_coordinate(port: NativeIncarnationPort, host: HostIdentity, dir: NonEmptyStr, listing: DirectoryPopulationReading, member: NonEmptyStr) -> ServingCoordinateReading {
  match listing {
    DirectoryUnread { cause: c } => CoordinateUnestablished { obligation: c }
    DirectoryListed { names: _ } =>
      if !listing_carries(listing: listing, name: member as String) {
        CoordinateAbsentByObservation
      } else {
        let digest = port.path_digest
        match digest(host, member_path(dir: dir, member: member as String)) {
          PathDigestObserved { hash: h } => CoordinateObserved { hash: h }
          PathDigestUnread { cause: c } => CoordinateUnestablished { obligation: c }
          PathNotPresent => CoordinateUnestablished {
            obligation: join(["the listing carried ", member as String, " and the digest read then found no such path"], "") as NonEmptyStr,
          }
        }
      }
  }
}

// ── MODEL-SIDE CODE IS A POPULATION, NOT A FILE ───────────────────────────────────────────────
//
// ZERO PYTHON FILES IS A MEASUREMENT AND ANY OTHER NUMBER MUST REACH IDENTITY -- which at this rung it
// cannot, because a count is not a content identity. So a non-zero population refuses rather than hashing
// a number, and the trigger is the same per-file enumeration the checkpoint rung waits on.
fn model_side_code_coordinate(listing: DirectoryPopulationReading) -> ServingCoordinateReading {
  match listing {
    DirectoryUnread { cause: c } => CoordinateUnestablished { obligation: c }
    DirectoryListed { names: ns } => {
      let code = filter(ns, n => ends_with(s: n, suffix: ".py"))
      if count(code) == 0 {
        CoordinateAbsentByObservation
      } else {
        CoordinateUnestablished {
          obligation: join([
            "the repository ships ", to_string(count(code)),
            " model-side python files and this rung cannot identify their content; the trigger is per-file enumeration",
          ], "") as NonEmptyStr,
        }
      }
    }
  }
}

// ── THE CHECKPOINT COORDINATE, MINTED ONLY BY THE RANK FOLD ───────────────────────────────────
//
// THE VALUE IS DERIVED FROM THE REPOSITORY AND THE IMMUTABLE REVISION, and the rung beside it says so:
// this is NOT a per-file content manifest. What licenses it is the verification -- `hf cache verify
// --fail-on-missing-files`, which checks every file of the revision against the Hub's own checksums --
// having passed on every planned rank. checkpoint_coordinate_from_ranks is the one place that decides it.
//
// THE MATERIAL IS HASHED FIELD BY FIELD. A delimiter between two NonEmptyStr fields frames them only if
// the type excludes the delimiter, and these types do not; hashing each field on its own and combining
// the fixed-width digests leaves no boundary in any string for a field's content to move.
fn checkpoint_revision_coordinate(repo: NonEmptyStr, revision: NonEmptyStr) -> ServingCoordinateReading {
  CoordinateObserved {
    hash: as_content_hash_structural(structural: content_hash_combine_structural(
      left: content_hash_tagged_structural(tag: "repo" as NonEmptyStr, payload: content_hash_atom(value: repo)),
      right: content_hash_tagged_structural(tag: "revision" as NonEmptyStr, payload: content_hash_atom(value: revision)),
    )),
  }
}

// EACH ARM OF THE OBSERVATION HAS ITS OWN REMEDY AND ONLY Verified LICENSES A COORDINATE. A rank
// contributes its complaint or nothing; the coordinate is minted once, after every rank has none.
fn rank_checkpoint_obligation(host: HostIdentity, observation: AcquisitionObservation) -> List<NonEmptyStr> {
  match observation {
    AcquisitionVerified => []
    AcquisitionAbsent => [join(["the checkpoint is not installed on ", host as String], "") as NonEmptyStr]
    AcquisitionDigestMismatch => [join(["verification refused the installed checkpoint on ", host as String], "") as NonEmptyStr]
    AcquisitionProbeFailed { reason: r } =>
      [join(["the checkpoint could not be verified on ", host as String, ": ", r as String], "") as NonEmptyStr]
  }
}

// THE POPULATION IS THE PLAN'S, AND ONE DISSENTER REFUSES THE COORDINATE. The deployment readback
// proves each rank runs the same model PATH; only a verification on each rank proves the path holds the
// same BYTES, so a rank whose snapshot was half-transferred satisfies every check the readback performs.
fn checkpoint_coordinate_from_ranks(port: NativeIncarnationPort, plan: ArmLaunchPlan, crow: ServingCheckpointRow) -> ServingCoordinateReading {
  let lines = plan_lines(plan: plan)
  if count(lines) == 0 {
    CoordinateUnestablished { obligation: "the plan names no rank, so the checkpoint was verified nowhere" as NonEmptyStr }
  } else {
    let snapshot = serving_checkpoint_snapshot(row: crow, identity: crow.repo.path)
    let verify = port.checkpoint_verification
    let obligations = flat_map(lines, l => rank_checkpoint_obligation(host: l.node.host, observation: verify(l.node.host, snapshot)))
    if count(obligations) != 0 {
      CoordinateUnestablished { obligation: join(map(obligations, o => o as String), "; ") as NonEmptyStr }
    } else {
      checkpoint_revision_coordinate(repo: crow.repo.path, revision: crow.revision)
    }
  }
}

fn checkpoint_rung(crow: ServingCheckpointRow) -> ServingSourceEvidenceRung {
  RevisionAddressedUpstreamVerification { authority: crow.repo.path, revision: crow.revision }
}

// ── WHICH TEMPLATE THE LAUNCH ACTUALLY USES ───────────────────────────────────────────────────
//
// IDENTITY IS THE SELECTED TEMPLATE'S CONTENT AND ORIGIN IS EVIDENCE BESIDE IT. What this observer can
// guarantee is that NO template the engine could load escapes identity: every upstream template locus is
// either a template-shaped file in the snapshot, which is counted here, or an inline key inside
// tokenizer_config.json or processor_config.json, each its own coordinate (transformers CHAT_TEMPLATE_FILE,
// CHAT_TEMPLATE_DIR and LEGACY_PROCESSOR_CHAT_TEMPLATE_FILE, read at 5.17.0; the version inside the
// runtime image is not established, which is why the match is a superset rather than that exact roster).
//
// WHAT IT DOES NOT GUARANTEE, STATED RATHER THAN IMPLIED: OVER-DISTINCTION. Identical template bytes moved
// from chat_template.jinja into tokenizer_config.json change the source reference, because one axis goes
// absent while another changes digest. Two launches computing the same thing may therefore be two Works.
// That is the conservative direction -- no two different computations can share one Work -- and the
// annotation previously claimed the opposite property, that origin never enters identity.
//
// A LAUNCH OVERRIDE REFUSES UNTIL ITS INTERPRETATION IS MODELLED. vLLM's --chat-template takes a file path
// OR a single-line template and decides which by attempting to open it, and a path it names is a CONTAINER
// path; hashing either reading here would be a guess about a selection the engine made. No plan in this
// repository passes the flag, so the refusal costs nothing today and names its trigger.
type ChatTemplateOrigin
  = TemplateFromRepositoryFile { name: NonEmptyStr }
  | TemplateInheritedFromConfiguration { tokenizer_config: Bool, processor_config: Bool }
  | TemplateSelectionAmbiguous { candidates: List<String> }
  | TemplateLaunchOverrideUnmodelled { value: NonEmptyStr }
  | TemplateOriginUnestablished { cause: NonEmptyStr }

data chat_template_flag: String = "--chat-template"
data chat_template_flag_assigned: String = "--chat-template="

// THE OVERRIDE IS FOUND IN THE ACCEPTED PLAN'S ARGV, BOTH SPELLINGS, EXACTLY. The readback has already
// proved every rank runs these words, so this reads a fact the deployment was shown to carry rather than
// re-reading a container through `tr ',' | grep -A1`, which could not tell `--chat-template /p` from
// `--chat-template=/p` and took the NEXT flag as the value of the second.
type ChatTemplateOverride
  = OverrideNotRequested
  | OverrideRequested { value: NonEmptyStr }
  | OverrideMalformed { cause: NonEmptyStr }

fn value_after_word(argv: List<String>, word: String) -> String? {
  match argv.first() {
    Absent => none
    Present { value: head } =>
      if head == word {
        argv.skip(n: 1).first()
      } else {
        value_after_word(argv: argv.skip(n: 1), word: word)
      }
  }
}

fn chat_template_override_in(argv: List<String>) -> ChatTemplateOverride {
  let spaced = filter(argv, w => w == chat_template_flag)
  let assigned = filter(argv, w => starts_with(s: w, prefix: chat_template_flag_assigned))
  if count(spaced) + count(assigned) == 0 {
    OverrideNotRequested
  } else if count(spaced) + count(assigned) > 1 {
    OverrideMalformed { cause: "the launch names --chat-template more than once" as NonEmptyStr }
  } else if count(assigned) == 1 {
    match assigned.first() {
      Absent => OverrideMalformed { cause: "the assigned --chat-template word vanished between two readings of one list" as NonEmptyStr }
      Present { value: w } => {
        let v = substring(s: w, start: string_length(s: chat_template_flag_assigned), end: string_length(s: w))
        if v == "" { OverrideMalformed { cause: "--chat-template= carries no value" as NonEmptyStr } } else { OverrideRequested { value: v as NonEmptyStr } }
      }
    }
  } else {
    match value_after_word(argv: argv, word: chat_template_flag) {
      Absent => OverrideMalformed { cause: "--chat-template is the last word and carries no value" as NonEmptyStr }
      Present { value: v } =>
        if v == "" { OverrideMalformed { cause: "--chat-template carries an empty value" as NonEmptyStr } } else { OverrideRequested { value: v as NonEmptyStr } }
    }
  }
}

// A CASE-FOLDED SUBSTRING TEST OVER ASCII, because the observer it replaces matched `grep -i template` and
// std carries no case fold; minting a general one here would be a string authority in a serving module.
fn ascii_folded_code_point(cp: Int) -> Int {
  if cp >= 65 && cp <= 90 { cp + 32 } else { cp }
}

fn folded_match_at(name: String, needle: String, at: Int, k: Int) -> Bool {
  if k >= string_length(s: needle) {
    true
  } else if ascii_folded_code_point(cp: code_point(substring(s: name, start: at + k, end: at + k + 1)))
      == code_point(substring(s: needle, start: k, end: k + 1)) {
    folded_match_at(name: name, needle: needle, at: at, k: k + 1)
  } else {
    false
  }
}

fn folded_contains_from(name: String, needle: String, at: Int) -> Bool {
  if at + string_length(s: needle) > string_length(s: name) {
    false
  } else if folded_match_at(name: name, needle: needle, at: at, k: 0) {
    true
  } else {
    folded_contains_from(name: name, needle: needle, at: at + 1)
  }
}

fn template_shaped(name: String) -> Bool {
  folded_contains_from(name: name, needle: "template", at: 0)
}

// AN INLINE KEY IS READ AS JSON STRUCTURE, NOT GREPPED AS TEXT. `grep -c '"chat_template"'` counted the
// string anywhere in the file, and `|| echo 0` then emitted a second line; a parsed member lookup answers
// exactly whether the top-level object carries the key, and a duplicated key refuses rather than choosing.
type InlineTemplateReading
  = InlineTemplatePresent
  | InlineTemplateAbsent
  | InlineTemplateUnread { cause: NonEmptyStr }

fn inline_template_in(port: NativeIncarnationPort, host: HostIdentity, dir: NonEmptyStr, listing: DirectoryPopulationReading, member: NonEmptyStr) -> InlineTemplateReading {
  if !listing_carries(listing: listing, name: member as String) {
    InlineTemplateAbsent
  } else {
    let read = port.file_text
    match read(host, member_path(dir: dir, member: member as String)) {
      FileTextUnread { cause: c } => InlineTemplateUnread { cause: c }
      FileTextRead { text: t } =>
        match parse_json_document(s: t) {
          JsonDocumentUnreadable { gap: g } =>
            InlineTemplateUnread { cause: join([member as String, " is ", json_document_gap_text(gap: g)], "") as NonEmptyStr }
          JsonDocumentParsed { value: doc } =>
            match json_object_unique_member(v: doc, key: "chat_template") {
              JsonMemberFound { value: _ } => InlineTemplatePresent
              JsonMemberAbsent => InlineTemplateAbsent
              JsonMemberDuplicated { count: n } =>
                InlineTemplateUnread { cause: join([member as String, " carries chat_template ", to_string(n), " times"], "") as NonEmptyStr }
              JsonMemberNotAnObject =>
                InlineTemplateUnread { cause: join([member as String, " is not a JSON object"], "") as NonEmptyStr }
            }
        }
    }
  }
}

fn inline_template_is_present(r: InlineTemplateReading) -> Bool {
  match r {
    InlineTemplatePresent => true
    InlineTemplateAbsent => false
    InlineTemplateUnread { cause: _ } => false
  }
}

fn inline_template_unread_cause(r: InlineTemplateReading) -> NonEmptyStr? {
  match r {
    InlineTemplateUnread { cause: c } => Present { value: c }
    InlineTemplatePresent => none
    InlineTemplateAbsent => none
  }
}

fn chat_template_origin(port: NativeIncarnationPort, host: HostIdentity, dir: NonEmptyStr, listing: DirectoryPopulationReading, argv: List<String>) -> ChatTemplateOrigin {
  match chat_template_override_in(argv: argv) {
    OverrideMalformed { cause: c } => TemplateOriginUnestablished { cause: c }
    OverrideRequested { value: v } => TemplateLaunchOverrideUnmodelled { value: v }
    OverrideNotRequested =>
      match listing {
        DirectoryUnread { cause: c } => TemplateOriginUnestablished { cause: c }
        DirectoryListed { names: ns } => {
          let candidates = filter(ns, n => template_shaped(name: n))
          if count(candidates) > 1 {
            TemplateSelectionAmbiguous { candidates: candidates }
          } else {
            match candidates.first() {
              Present { value: name } => TemplateFromRepositoryFile { name: name as NonEmptyStr }
              Absent => {
                let tokenizer = inline_template_in(port: port, host: host, dir: dir, listing: listing, member: snapshot_member_tokenizer_config)
                let processor = inline_template_in(port: port, host: host, dir: dir, listing: listing, member: snapshot_member_processor_config)
                match inline_template_unread_cause(r: tokenizer) {
                  Present { value: c } => TemplateOriginUnestablished { cause: c }
                  Absent =>
                    match inline_template_unread_cause(r: processor) {
                      Present { value: c } => TemplateOriginUnestablished { cause: c }
                      Absent =>
                        if !inline_template_is_present(r: tokenizer) && !inline_template_is_present(r: processor) {
                          TemplateOriginUnestablished {
                            cause: "no template was found in the launch line, the snapshot or either configuration file" as NonEmptyStr,
                          }
                        } else {
                          TemplateInheritedFromConfiguration {
                            tokenizer_config: inline_template_is_present(r: tokenizer),
                            processor_config: inline_template_is_present(r: processor),
                          }
                        }
                    }
                }
              }
            }
          }
        }
      }
  }
}

fn chat_template_origin_wire(origin: ChatTemplateOrigin) -> NonEmptyStr {
  match origin {
    TemplateFromRepositoryFile { name: n } =>
      join(["the repository's own template file: ", n as String], "") as NonEmptyStr
    TemplateInheritedFromConfiguration { tokenizer_config: t, processor_config: p } =>
      join([
        "inherited from configuration whose digests are their own coordinates (tokenizer_config: ",
        if t { "present" } else { "absent" }, ", processor_config: ", if p { "present" } else { "absent" }, ")",
      ], "") as NonEmptyStr
    TemplateSelectionAmbiguous { candidates: cs } =>
      join([to_string(count(cs)), " template-shaped files and nothing selecting between them: ", join(cs, ", ")], "") as NonEmptyStr
    TemplateLaunchOverrideUnmodelled { value: v } =>
      join(["the launch overrides the template with ", v as String, " and whether vLLM read that as a path or as a template is not modelled"], "") as NonEmptyStr
    TemplateOriginUnestablished { cause: c } => c
  }
}

// THE COORDINATE FOLLOWS THE SELECTION. An inherited template is AbsentByObservation on this axis and is
// covered by the configuration coordinates that contain it; every other non-file origin refuses, so no
// manifest is built over a template nobody identified.
fn chat_template_coordinate(port: NativeIncarnationPort, host: HostIdentity, dir: NonEmptyStr, listing: DirectoryPopulationReading, origin: ChatTemplateOrigin) -> ServingCoordinateReading {
  match origin {
    TemplateFromRepositoryFile { name: n } => member_coordinate(port: port, host: host, dir: dir, listing: listing, member: n)
    TemplateInheritedFromConfiguration { tokenizer_config: _, processor_config: _ } => CoordinateAbsentByObservation
    TemplateSelectionAmbiguous { candidates: _ } =>
      CoordinateUnestablished { obligation: join(["the effective chat template is ambiguous: ", chat_template_origin_wire(origin: origin) as String], "") as NonEmptyStr }
    TemplateLaunchOverrideUnmodelled { value: _ } => CoordinateUnestablished { obligation: chat_template_origin_wire(origin: origin) }
    TemplateOriginUnestablished { cause: c } => CoordinateUnestablished { obligation: c }
  }
}

// ── THE SEMANTIC RUNTIME CONFIGURATION, AS A CLOSED PROJECTION OVER THE ACCEPTED LAUNCH ────────
//
// THE ROSTER IS CLOSED AND EACH MEMBER IS CLASSIFIED DELIBERATELY. Hashing the whole argv would sweep in
// the endpoint, the master address, the node rank and the memory fraction -- realization facts that must
// NOT change a semantic identity. What is in: the KV cache dtype (a numeric policy), the tool-call and
// reasoning parsers (they change what a reply IS), auto tool choice, and the tensor-parallel degree, which
// changes reduction order and therefore numerics. What is out: max-model-len and the scheduler bounds
// (capability limits), the memory fraction, and prefix caching, which gunbc.serving.turn_demand rules an
// internal subcomputation of one step.
type SemanticRuntimeFlag
  = KvCacheDtypeFlag
  | ToolCallParserFlag
  | ReasoningParserFlag
  | AutoToolChoiceFlag
  | TensorParallelFlag

fn semantic_runtime_flags() -> List<SemanticRuntimeFlag> {
  [KvCacheDtypeFlag, ToolCallParserFlag, ReasoningParserFlag, AutoToolChoiceFlag, TensorParallelFlag]
}

fn semantic_runtime_flag_wire(f: SemanticRuntimeFlag) -> NonEmptyStr {
  match f {
    KvCacheDtypeFlag => "--kv-cache-dtype" as NonEmptyStr
    ToolCallParserFlag => "--tool-call-parser" as NonEmptyStr
    ReasoningParserFlag => "--reasoning-parser" as NonEmptyStr
    AutoToolChoiceFlag => "--enable-auto-tool-choice" as NonEmptyStr
    TensorParallelFlag => "--tensor-parallel-size" as NonEmptyStr
  }
}

// A VALUELESS FLAG IS PRESENT OR ABSENT AND A VALUED FLAG CARRIES ITS OPERAND. Rendering both as the
// same kind of string would make "--enable-auto-tool-choice" indistinguishable from a flag whose value
// happened to be the empty string.
fn semantic_runtime_flag_takes_value(f: SemanticRuntimeFlag) -> Bool {
  match f {
    AutoToolChoiceFlag => false
    KvCacheDtypeFlag => true
    ToolCallParserFlag => true
    ReasoningParserFlag => true
    TensorParallelFlag => true
  }
}

fn semantic_runtime_flag_hash(argv: List<String>, f: SemanticRuntimeFlag) -> ContentHash {
  let name = semantic_runtime_flag_wire(f: f)
  let value = if semantic_runtime_flag_takes_value(f: f) {
    match value_after_word(argv: argv, word: name as String) { Absent => "unset" Present { value: v } => join(["value:", v], "") }
  } else {
    if any(argv, w => w == (name as String)) { "present" } else { "absent" }
  }
  as_content_hash_structural(structural: content_hash_tagged_structural(tag: name, payload: content_hash_atom(value: value as NonEmptyStr)))
}

// THE COORDINATE IS READ FROM THE ACCEPTED PLAN'S ENGINE ARGV, which the readback has already compared
// against every rank. The flags are combined as fixed-width digests, so no flag value can move a boundary.
fn semantic_runtime_coordinate_of(argv: List<String>) -> ServingCoordinateReading {
  CoordinateObserved {
    hash: content_hash_of_value(value: join(
      map(semantic_runtime_flags(), f => serialize_content_hash(hash: semantic_runtime_flag_hash(argv: argv, f: f)) as String),
      ",") as NonEmptyStr),
  }
}

fn semantic_runtime_configuration(plan: ArmLaunchPlan) -> ServingCoordinateReading {
  match plan_lines(plan: plan).first() {
    Absent => CoordinateUnestablished {
      obligation: "the accepted plan names no line, so no runtime configuration could be projected" as NonEmptyStr,
    }
    Present { value: l } => semantic_runtime_coordinate_of(argv: l.engine_argv)
  }
}

// ── BINDING THE CLOSURE TO THE EXACT LAUNCH THAT REALIZES IT ───────────────────────────────────
//
// WORK IDENTITY MUST NOT CONTAIN THE LAUNCH AND OFFER IDENTITY MUST. Restarting the same bytes is the same
// semantic Work and a different offer, so the launch sits BESIDE the execution closure: the closure answers
// "what would this compute", the launch answers "which process is currently answering".
//
// THE LAUNCH IS THE ENDPOINT-PROCESS LAUNCH THE HARNESS NAMES, AND IT WAS NOT. This producer filled
// VllmEndpointProcessLaunch.process_start_field with docker's .State.StartedAt, while
// gunbc.harness.harness_backend fills the same field with the exporter's process_start_time_seconds --
// measured on the serving endpoint 2026-09-14 as `1.78928202645e+09`. Two measurands in one field can
// never compare equal, so no provenance this producer made could ever have applied to a launch the harness
// observed, and a product-root lookup over them would have been green in fixtures and unreachable in
// production. The port now answers with the harness's own observation of the route's endpoint.
type VllmIncarnationEvidence sole_constructor {
  ranks_agreed: Nat
  ranks_required: Nat
  image_digest: NonEmptyStr
  model_path: NonEmptyStr
  snapshot_directory: NonEmptyStr
  template_origin: NonEmptyStr
}

type VllmServingIncarnationProvenance sole_constructor {
  launch: VllmEndpointProcessLaunch
  execution: ServingTurnExecutionClosure
  evidence: VllmIncarnationEvidence
}

type VllmIncarnationOutcome
  = IncarnationBound { provenance: VllmServingIncarnationProvenance }
  | IncarnationUnestablished { obligations: List<NonEmptyStr> }

// THE DEPLOYMENT MUST HAVE BEEN ACCEPTED OVER THE PLAN'S WHOLE POPULATION. The required count is the
// plan's line count, never a caller's number: a receipt that says three ranks agreed is a receipt about
// three ranks.
fn incarnation_deployment_obligations(acceptance: DeploymentAcceptance, ranks_required: Nat) -> List<NonEmptyStr> {
  match acceptance {
    DeploymentRejected { deviations: ds } =>
      [join(["the deployment DIVERGED from the plan: ", deployment_deviations_text(ds: ds)], "") as NonEmptyStr]
    DeploymentUnverified { unknowns: us } =>
      [join(["the deployment readback could not establish every fact it must assert: ", deployment_unknowns_text(us: us)], "") as NonEmptyStr]
    DeploymentUnverifiable { cause: c } =>
      [join(["the deployment could not be assessed at all: ", c as String], "") as NonEmptyStr]
    DeploymentAccepted { receipt: r } =>
      if r.ranks_agreed == ranks_required { [] } else {
        [join([
          "the deployment was accepted over ", to_string(r.ranks_agreed),
          " ranks and this topology requires ", to_string(ranks_required),
        ], "") as NonEmptyStr]
      }
  }
}

// OBSERVED IN THE SAME TRANSACTION IS NOT THE SAME AS JOINED. The acceptance carries the image every rank
// is running; the runtime manifest carries an image read separately. Storing both and comparing neither
// would admit a provenance whose two halves describe different images. Both render "sha256:<hex>".
fn runtime_image_agreement(receipt_image: NonEmptyStr, runtime: ServingRuntimeResolution) -> List<NonEmptyStr> {
  match runtime {
    RuntimeManifestUnestablished { obligations: _ } => []
    RuntimeManifestResolved { manifest: m } =>
      match serving_runtime_coordinate(m: m, axis: RuntimeImageAxis) {
        CoordinateAbsent => [
          "the accepted deployment names an image and the runtime closure observed none" as NonEmptyStr,
        ]
        CoordinateContent { hash: h } =>
          if (serialize_content_hash(hash: h) as String) == (receipt_image as String) { [] } else {
            [join([
              "the accepted deployment runs image ", receipt_image as String,
              " and the runtime closure was observed from ", serialize_content_hash(hash: h) as String,
            ], "") as NonEmptyStr]
          }
      }
  }
}

fn acceptance_image_obligations(acceptance: DeploymentAcceptance, runtime: ServingRuntimeResolution) -> List<NonEmptyStr> {
  match acceptance {
    DeploymentRejected { deviations: _ } => []
    DeploymentUnverified { unknowns: _ } => []
    DeploymentUnverifiable { cause: _ } => []
    DeploymentAccepted { receipt: r } => runtime_image_agreement(receipt_image: r.image_digest, runtime: runtime)
  }
}

fn bind_incarnation(
  launch: VllmEndpointProcessLaunch,
  acceptance: DeploymentAcceptance,
  plan: ArmLaunchPlan,
  source: ServingSourceResolution,
  runtime: ServingRuntimeResolution,
  receipt: ObservationReceiptRef,
  snapshot_directory: NonEmptyStr,
  template_origin: NonEmptyStr,
) -> VllmIncarnationOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.spark.vllm_incarnation_provenance", decl_name: "observe_accepted_incarnation"),
  ]
  = {
  let ranks_required = count(plan_lines(plan: plan))
  let deployment_obligations = concat(
    incarnation_deployment_obligations(acceptance: acceptance, ranks_required: ranks_required),
    acceptance_image_obligations(acceptance: acceptance, runtime: runtime))
  match seal_serving_execution_closure(source: source, runtime: runtime, receipt: receipt) {
    ExecutionClosureUnestablished { obligations: os } =>
      IncarnationUnestablished { obligations: concat(deployment_obligations, os) }
    ExecutionClosureResolved { closure: c } =>
      if count(deployment_obligations) != 0 {
        IncarnationUnestablished { obligations: deployment_obligations }
      } else {
        match acceptance {
          DeploymentRejected { deviations: _ } => IncarnationUnestablished { obligations: deployment_obligations }
          DeploymentUnverified { unknowns: _ } => IncarnationUnestablished { obligations: deployment_obligations }
          DeploymentUnverifiable { cause: _ } => IncarnationUnestablished { obligations: deployment_obligations }
          DeploymentAccepted { receipt: r } =>
            IncarnationBound {
              provenance: VllmServingIncarnationProvenance {
                launch: launch,
                execution: c,
                evidence: VllmIncarnationEvidence {
                  ranks_agreed: r.ranks_agreed,
                  ranks_required: ranks_required,
                  image_digest: r.image_digest,
                  model_path: r.model_path,
                  snapshot_directory: snapshot_directory,
                  template_origin: template_origin,
                },
              },
            }
        }
      }
  }
}

// ── THE TRANSACTION ───────────────────────────────────────────────────────────────────────────
//
// THE PLAN IS BUILT AT THE FRACTION THE ARM IS ACTUALLY CARRYING. The memory fraction is resolved per
// attempt from observed device supply, so a comparison plan built at any fixed fraction reads a converged
// deployment as divergent. This is the same recovery gunbc.spark.native_cutover_wet performs.
fn incarnation_envelope(basis_points: Nat) -> ResolvedDeviceMemoryEnvelope {
  ResolvedForAttempt {
    basis_points: basis_points,
    binding_node_rank: 0,
    policy: glm_native_device_memory_policy,
    attempt: "incarnation-provenance" as NonEmptyStr,
    standings: [],
  }
}

data native_incarnation_subject: NonEmptyStr = "the native four-rank deployment an incarnation is observed over" as NonEmptyStr

fn unestablished(reason: String) -> VllmIncarnationOutcome {
  IncarnationUnestablished { obligations: [reason as NonEmptyStr] }
}

// THE SNAPSHOT IS THE ONE THE PLAN'S CHECKPOINT ROW DENOTES, and so is the directory the members are read
// from. The model path every rank was proven to run and the directory verified on every rank are two
// projections of that one row -- which is what makes "the acceptance's model path corresponds to the source
// manifest" a construction here rather than a comparison whose red no input could author.
fn observe_native_incarnation(port: NativeIncarnationPort, attempt: NonEmptyStr) -> VllmIncarnationOutcome {
  let endpoint_launch = port.endpoint_launch
  match endpoint_launch(BeforeAssessment) {
    LaunchUnobserved { group: _, obligation: o } =>
      unestablished(reason: join(["the launch the endpoint is answering for could not be read before the assessment: ", o as String], ""))
    LaunchObserved { launch: launch_before, receipt: _ } =>
      match glm_native_tp4_nodes() {
        ArmNodeRosterRefused { cause: c } => unestablished(reason: c as String)
        ArmNodesResolved { nodes: ns, master: _ } =>
          match ns.first() {
            Absent => unestablished(reason: "the roster names no head rank")
            Present { value: head_node } => {
              let running_basis_points = port.running_basis_points
              match running_basis_points(head_node) {
                Absent => unestablished(reason: "the running arm's memory fraction could not be read, so no plan can be built at the fraction it carries")
                Present { value: bp } =>
                  match glm_native_tp4_checkpoint_row() {
                    Absent => unestablished(reason: "the selection that renders this plan names no checkpoint row")
                    Present { value: crow } =>
                      observe_native_incarnation_over(
                        port: port, attempt: attempt, launch_before: launch_before, crow: crow,
                        plan: glm_native_tp4_launch_plan(envelope: incarnation_envelope(basis_points: bp)),
                      )
                  }
              }
            }
          }
      }
  }
}

// THE SECOND HALF TAKES THE LAUNCH, THE ROW AND THE PLAN AS ARGUMENTS, SO IT IS ADMITTED TO THE FIRST HALF
// ALONE. Callable from anywhere, it would accept a plan and a checkpoint row nobody derived -- the forgery
// this split must not reopen -- which is why bind_incarnation names this function and this function names
// observe_native_incarnation.
fn observe_native_incarnation_over(
  port: NativeIncarnationPort,
  attempt: NonEmptyStr,
  launch_before: VllmEndpointProcessLaunch,
  crow: ServingCheckpointRow,
  plan: ArmLaunchPlan,
) -> VllmIncarnationOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.spark.vllm_incarnation_provenance", decl_name: "observe_native_incarnation"),
  ]
  = {
  let population = port.population
  let acceptance = accept_deployment(inspection: inspect_native_deployment(
    subject: native_incarnation_subject, plan: plan, reading: population(plan)))
  match acceptance {
    DeploymentAccepted { receipt: _ } => observe_accepted_incarnation(port: port, attempt: attempt, launch_before: launch_before, crow: crow, plan: plan, acceptance: acceptance)
    DeploymentRejected { deviations: _ } =>
      IncarnationUnestablished { obligations: incarnation_deployment_obligations(acceptance: acceptance, ranks_required: count(plan_lines(plan: plan))) }
    DeploymentUnverified { unknowns: _ } =>
      IncarnationUnestablished { obligations: incarnation_deployment_obligations(acceptance: acceptance, ranks_required: count(plan_lines(plan: plan))) }
    DeploymentUnverifiable { cause: _ } =>
      IncarnationUnestablished { obligations: incarnation_deployment_obligations(acceptance: acceptance, ranks_required: count(plan_lines(plan: plan))) }
  }
}

// NOTHING ABOUT THE SOURCE IS READ FOR A DEPLOYMENT THAT WAS NOT ACCEPTED. The checkpoint verification is
// `hf cache verify` over the whole revision on every planned rank -- on this arm, 306 GiB hashed four
// times on hosts that are serving -- and a diverged or unverified deployment has already refused the
// incarnation completely. Collecting source obligations about a deployment that is not the planned one
// would spend that cost to report facts about the wrong subject.
fn observe_accepted_incarnation(
  port: NativeIncarnationPort,
  attempt: NonEmptyStr,
  launch_before: VllmEndpointProcessLaunch,
  crow: ServingCheckpointRow,
  plan: ArmLaunchPlan,
  acceptance: DeploymentAcceptance,
) -> VllmIncarnationOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.spark.vllm_incarnation_provenance", decl_name: "observe_native_incarnation_over"),
  ]
  = {
  match plan_lines(plan: plan).first() {
    Absent => unestablished(reason: "the plan names no line, so there is no head rank to read the source on")
    Present { value: head_line } => {
      let dir = snapshot_install_path(placement: crow.placement, repo: crow.repo, revision: crow.revision)
      let head = head_line.node.host
      let directory_population = port.directory_population
      let listing = directory_population(head, dir)
      let origin = chat_template_origin(port: port, host: head, dir: dir, listing: listing, argv: head_line.engine_argv)
      let source = resolve_serving_source(
        checkpoint: checkpoint_coordinate_from_ranks(port: port, plan: plan, crow: crow),
        model_config: member_coordinate(port: port, host: head, dir: dir, listing: listing, member: snapshot_member_model_config),
        tokenizer: member_coordinate(port: port, host: head, dir: dir, listing: listing, member: snapshot_member_tokenizer),
        tokenizer_config: member_coordinate(port: port, host: head, dir: dir, listing: listing, member: snapshot_member_tokenizer_config),
        special_tokens: member_coordinate(port: port, host: head, dir: dir, listing: listing, member: snapshot_member_special_tokens),
        chat_template: chat_template_coordinate(port: port, host: head, dir: dir, listing: listing, origin: origin),
        model_side_code: model_side_code_coordinate(listing: listing),
        generation_defaults: member_coordinate(port: port, host: head, dir: dir, listing: listing, member: snapshot_member_generation_defaults),
        processor_config: member_coordinate(port: port, host: head, dir: dir, listing: listing, member: snapshot_member_processor_config),
        rung: checkpoint_rung(crow: crow),
      )
      let runtime_image = port.runtime_image
      let runtime = resolve_serving_runtime(
        runtime_image: runtime_image(head),
        runtime_extensions: CoordinateAbsentByObservation,
        runtime_configuration: semantic_runtime_configuration(plan: plan),
      )
      let endpoint_launch = port.endpoint_launch
      match endpoint_launch(AfterAssessment) {
        LaunchUnobserved { group: _, obligation: o } =>
          unestablished(reason: join(["the launch could not be re-read after the assessment, so nothing establishes that the process assessed is the process still answering: ", o as String], ""))
        LaunchObserved { launch: launch_after, receipt: _ } =>
          if !vllm_endpoint_process_launch_is(launch: launch_before, other: launch_after) {
            unestablished(reason: "the endpoint's process was replaced during the observation, so the acceptance describes a process that is no longer answering")
          } else {
            bind_incarnation(
              launch: launch_after,
              acceptance: acceptance,
              plan: plan,
              source: source,
              runtime: runtime,
              receipt: incarnation_receipt(attempt: attempt, launch: launch_after),
              snapshot_directory: dir,
              template_origin: chat_template_origin_wire(origin: origin),
            )
          }
      }
    }
  }
}

// ── PROVENANCE FOR ONE LAUNCH MAY NEVER BIND ANOTHER ───────────────────────────────────────────
//
// THE COMPARISON IS FIELD BY FIELD, on the launch's own structural equality, so a restart, a different
// endpoint or a different group is a different launch by construction.
fn incarnation_applies_to(p: VllmServingIncarnationProvenance, launch: VllmEndpointProcessLaunch) -> Bool {
  vllm_endpoint_process_launch_is(launch: p.launch, other: launch)
}

// ── A LOOKUP THAT RESOLVES AMBIGUITY BY LIST ORDER IS NOT A LOOKUP ────────────────────────────
//
// TWO PROVENANCE ROWS FOR ONE LAUNCH IS A CONTRADICTION, NOT A CHOICE. Absence and contradiction are
// different answers with different remedies: one says nobody observed this launch, the other says two
// observations of it do not agree.
type IncarnationLookup
  = IncarnationFound { provenance: VllmServingIncarnationProvenance }
  | IncarnationMissing
  | IncarnationAmbiguous { matches: Nat }

fn incarnation_for_launch(
  candidates: List<VllmServingIncarnationProvenance>, launch: VllmEndpointProcessLaunch,
) -> IncarnationLookup {
  let matches = filter(candidates, p => incarnation_applies_to(p: p, launch: launch))
  if count(matches) > 1 {
    IncarnationAmbiguous { matches: count(matches) }
  } else {
    match matches.first() {
      Absent => IncarnationMissing
      Present { value: p } => IncarnationFound { provenance: p }
    }
  }
}

// ── THE PRODUCTION PORT ───────────────────────────────────────────────────────────────────────
//
// THE CONTEXT IS REBUILT PER HOST because SparkMaterializeContext names the host it acts on, while
// SparkRemoteExecutionContext carries the trust and credential that reach any of them. The executor runs the
// Hub CLI inside the runtime image the plan launches, at the path measured in that image.
fn materialize_context_for(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, executor: SnapshotAcquisitionExecutor,
) -> SparkMaterializeContext {
  SparkMaterializeContext {
    host: host,
    trust: ctx.trust,
    path: ctx.reach_path,
    admin_credential: ctx.administrator,
    admin_credential_file: ctx.administrator_file,
    executor: executor,
  }
}

fn verify_snapshot_on(ctx: SparkRemoteExecutionContext, host: HostIdentity, snapshot: ModelSnapshotDesired, executor: SnapshotAcquisitionExecutor) -> AcquisitionObservation {
  match model_snapshot_subject(snapshot: snapshot, cache_root: spark_hub_cache_root) {
    Absent => AcquisitionProbeFailed { reason: "the snapshot carries no pinned revision, so there is no subject to verify" as NonEmptyStr }
    Present { value: subject } =>
      spark_snapshot_observe(
        ctx: materialize_context_for(ctx: ctx, host: host, executor: executor),
        verify: model_snapshot_verify_argv(snapshot: snapshot),
        subject: subject,
      )
  }
}

fn native_incarnation_port(
  ctx: SparkRemoteExecutionContext,
  endpoint: ServingRouteEndpoint,
  executor: SnapshotAcquisitionExecutor,
) -> NativeIncarnationPort {
  NativeIncarnationPort {
    endpoint_launch: fn(phase) { harness_observe_engine(endpoint: endpoint).launch },
    running_basis_points: fn(node) { observe_rank_utilization_basis_points(ctx: ctx, node: node) },
    population: fn(plan) { observe_native_population(ctx: ctx, plan: plan) },
    checkpoint_verification: fn(host, snapshot) { verify_snapshot_on(ctx: ctx, host: host, snapshot: snapshot, executor: executor) },
    directory_population: fn(host, dir) { observe_directory_population(ctx: ctx, host: host, dir: dir) },
    path_digest: fn(host, path) { observe_path_digest(ctx: ctx, host: host, path: path) },
    file_text: fn(host, path) { observe_file_text(ctx: ctx, host: host, path: path) },
    runtime_image: fn(host) { observe_runtime_image(ctx: ctx, host: host, container: glm_native_container_name) },
  }
}

// ── THE WET ENTRY ─────────────────────────────────────────────────────────────────────────────
//
// A SUCCESSFUL OBSERVATION LEAVES THROUGH THE SUCCESS ARM AND WRITES ITS RECEIPT; a refusal names every
// obligation. The attempt is the instant the transaction started, and an unreadable clock refuses rather
// than falling back to a fixed word that every clock-blind run would share.
data incarnation_receipt_path: String = "target/spark-incarnation-provenance-receipt.txt"

fn native_incarnation_attempt(now: NonEmptyStr?) -> NonEmptyStr? {
  match now {
    Absent => none
    Present { value: ts } => Present { value: join(["glm-native-incarnation-", ts as String], "") as NonEmptyStr }
  }
}

fn incarnation_receipt_text(p: VllmServingIncarnationProvenance) -> String {
  join([
    "INCARNATION OBSERVED -- launch=", vllm_endpoint_process_launch_key(launch: p.launch) as String,
    " process_start=", p.launch.process_start_field as String,
    " source=", serving_execution_source_ref(c: p.execution) as String,
    " runtime=", serving_execution_runtime_ref(c: p.execution) as String,
    " ranks=", to_string(p.evidence.ranks_agreed), "/", to_string(p.evidence.ranks_required),
    " snapshot=", p.evidence.snapshot_directory as String,
    " template=", p.evidence.template_origin as String,
    " rung=", serving_source_rung_wire(rung: p.execution.source.rung) as String,
    " receipt=", p.execution.receipt as String,
  ], "")
}

func observe_glm_incarnation(ctx: SparkRemoteExecutionContext, attempt: NonEmptyStr) -> ProcessExit
  uses net: Network
{
  match serving_route(group: FabricGroupB) {
    ServingRouteUnresolved { group: _, obligation: o } => exit_failure(reason: join(["INCARNATION UNESTABLISHED: ", o as String], ""))
    ServingRouteResolved { endpoint: endpoint, ceiling: _ } =>
      match glm_native_tp4_checkpoint_row() {
        Absent => exit_failure(reason: "INCARNATION UNESTABLISHED: the selection names no checkpoint row")
        Present { value: crow } =>
          match glm_native_tp4_runtime_row() {
            Absent => exit_failure(reason: "INCARNATION UNESTABLISHED: the selection names no runtime row, so there is no image to run the Hub CLI in")
            Present { value: rrow } =>
              match observe_native_incarnation(
                port: native_incarnation_port(ctx: ctx, endpoint: endpoint, executor: snapshot_executor_in_runtime(checkpoint: crow, runtime: rrow)),
                attempt: attempt,
              ) {
                IncarnationUnestablished { obligations: os } =>
                  exit_failure(reason: join(["INCARNATION UNESTABLISHED: ", join(map(os, o => o as String), "; ")], ""))
                IncarnationBound { provenance: p } => {
                  let body = incarnation_receipt_text(p: p)
                  let w = Filesystem.Write(path: incarnation_receipt_path, content: body)
                  if w.success { ExitSuccess } else { exit_failure(reason: join(["the receipt could not be written: ", body], "")) }
                }
              }
          }
      }
  }
}

func glm_incarnation_provenance_wet() -> ProcessExit
  uses net: Network
{
  match native_incarnation_attempt(now: clock_now_probed_at()) {
    Absent => exit_failure(reason: "incarnation probe: the clock could not be read, so there is no attempt identity to bind a receipt to")
    Present { value: attempt } =>
      match observe_executor_reach() {
        ExecutorReachUnknown { cause: c } => exit_failure(reason: join(["incarnation probe: ", c], ""))
        ExecutorReachKnown { short_hostname: _, path: path } =>
          match read_bootstrap_credential() {
            BootstrapCredentialNotMaterialized { cause: c } => exit_failure(reason: c as String)
            BootstrapCredentialReady { secret: administrator } =>
              match fleet_ssh_attempt_identity(raw: "incarnation-provenance") {
                Absent => exit_failure(reason: "the attempt identity is not a safe path segment")
                Present { value: ssh_attempt } => {
                  let materialization = materialize_fleet_known_hosts_anchor(attempt: ssh_attempt)
                  match fleet_openssh_trust_policy_of(outcome: materialization) {
                    Absent => exit_failure(reason: join([
                      "trust could not be established, so no leg ran: ",
                      known_hosts_materialization_receipt(outcome: materialization),
                    ], ""))
                    Present { value: trust } =>
                      match with_materialized_ssh_key_file(
                        identity_file_name: "gunbc-incarnation-provenance-admin-password" as NonEmptyStr,
                        secret_bytes: administrator as Secret,
                        use: fn(file) {
                          observe_glm_incarnation(
                            ctx: SparkRemoteExecutionContext {
                              trust: trust,
                              reach_path: path,
                              administrator: administrator as Secret,
                              administrator_file: file,
                            },
                            attempt: attempt,
                          )
                        },
                      ) {
                        MaterializedSshKeyFileBracketRefused { cause: c } => exit_failure(reason: c as String)
                        MaterializedSshKeyFileBracketCompleted { value: v } => v
                      }
                  }
                }
              }
          }
      }
  }
}
