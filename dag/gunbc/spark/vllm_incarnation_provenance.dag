// THE RECEIPT NAMES THE PRODUCER THAT TOOK THE READINGS, so a closure carries the identity of the
// observation that built it rather than one supplied by whoever later consumes it.
data vllm_incarnation_receipt: ObservationReceiptRef = "gunbc.spark.vllm_incarnation_provenance" as ObservationReceiptRef

// ── READING ONE MEMBER OF A MOUNTED SNAPSHOT, THREE-VALUED AT THE SOURCE ───────────────────────
//
// THE COMMAND DISTINGUISHES THE THREE ANSWERS ITSELF RATHER THAN LEAVING THEM TO BE INFERRED FROM AN
// EMPTY STRING. A file that is not there prints ABSENT; a file that is there prints its digest; a
// read that could not happen prints neither and the exec itself fails. Collapsing the first and third
// into "no output" is how "we did not look" becomes "there was nothing", which the coordinate type
// exists to keep apart -- so the distinction is made where the observation happens, not afterwards.
//
// sha256sum IS THE MEMBER'S OWN CONTENT IDENTITY AND IS NOT THE MANIFEST REFERENCE. The reference is
// a structural identity over the canonical axis material; these digests are what make the members
// verifiable, and they are cryptographic where the reference is not.
// THE LOCUS IS A WHOLE PATH, NOT A SNAPSHOT-RELATIVE NAME. A launch may select a template that is not
// inside the snapshot at all -- the annotation on the origin type says so -- and the previous reader
// prepended the snapshot directory unconditionally, so an absolute override would have been hashed at
// a path that does not exist and reported ABSENT. Callers that do want a snapshot member join the two
// themselves, which keeps the joining visible rather than implied by a parameter name.
fn path_digest_argv(path: NonEmptyStr) -> List<String> {
  ["sh", "-c", join([
    "P=", path as String,
    "; if [ -e \"$P\" ]; then sha256sum -b \"$P\" | cut -c1-64; else echo ABSENT; fi",
  ], "")]
}

fn snapshot_member_path(snapshot_dir: NonEmptyStr, member: NonEmptyStr) -> NonEmptyStr {
  join([snapshot_dir as String, "/", member as String], "") as NonEmptyStr
}

data snapshot_member_absent_wire: String = "ABSENT"

// A DIGEST THAT DOES NOT PARSE IS UNESTABLISHED, NOT ABSENT. std.content_hash sha256_hex_digest
// refuses a malformed hex rather than answering, and that refusal is carried through here: a truncated
// read, a permission error that printed to stdout, or a tool that changed its output format all land
// in the arm that says nobody established the value -- never in the arm that says there was nothing.
fn snapshot_member_reading(raw: String, member: NonEmptyStr) -> ServingCoordinateReading {
  if raw == snapshot_member_absent_wire {
    CoordinateAbsentByObservation
  } else {
    match sha256_hex_digest(hex: raw) {
      Present { value: d } => CoordinateObserved { hash: Sha256Hash(d) }
      Absent => CoordinateUnestablished {
        obligation: join([
          "the member ", member as String, " at the mounted snapshot answered neither a sha256 digest nor ABSENT",
        ], "") as NonEmptyStr,
      }
    }
  }
}

func observe_snapshot_member(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, snapshot_dir: NonEmptyStr, member: NonEmptyStr,
) -> ServingCoordinateReading
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: path_digest_argv(path: snapshot_member_path(snapshot_dir: snapshot_dir, member: member)))
  if !remote_run_succeeded(r: r) {
    CoordinateUnestablished {
      obligation: join([
        "the member ", member as String, " could not be read on ", host as String, ": ", remote_run_text(r: r),
      ], "") as NonEmptyStr,
    }
  } else {
    snapshot_member_reading(raw: remote_run_stdout(r: r), member: member)
  }
}


// THE OVERRIDE IS READ AT ITS OWN PATH. This exists so observe_effective_chat_template can hash a
// template the launch named wherever it lives, rather than forcing every reading through the snapshot.
func observe_path_digest(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, path: NonEmptyStr,
) -> ServingCoordinateReading
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: path_digest_argv(path: path))
  if !remote_run_succeeded(r: r) {
    CoordinateUnestablished {
      obligation: join(["the path ", path as String, " could not be read on ", host as String], "") as NonEmptyStr,
    }
  } else {
    snapshot_member_reading(raw: remote_run_stdout(r: r), member: path)
  }
}

data snapshot_member_model_config: NonEmptyStr = "config.json" as NonEmptyStr
data snapshot_member_tokenizer: NonEmptyStr = "tokenizer.json" as NonEmptyStr
data snapshot_member_tokenizer_config: NonEmptyStr = "tokenizer_config.json" as NonEmptyStr
data snapshot_member_special_tokens: NonEmptyStr = "special_tokens_map.json" as NonEmptyStr
data snapshot_member_chat_template: NonEmptyStr = "chat_template.jinja" as NonEmptyStr
data snapshot_member_generation_defaults: NonEmptyStr = "generation_config.json" as NonEmptyStr
data snapshot_member_processor_config: NonEmptyStr = "processor_config.json" as NonEmptyStr

// ── MODEL-SIDE CODE IS A POPULATION, NOT A FILE ────────────────────────────────────────────────
//
// A REPOSITORY EITHER SHIPS PYTHON THE ENGINE MAY IMPORT OR IT DOES NOT, and which files those are is
// not knowable from a fixed name. So this counts them and reads the count: zero is a measurement that
// the repository ships none, and any other number must reach identity -- which at this rung it cannot
// do faithfully, because a count is not a content identity. The reading therefore refuses rather than
// hashing a number, and the trigger is the same per-file enumeration the checkpoint rung waits on.
fn snapshot_model_side_code_argv(snapshot_dir: NonEmptyStr) -> List<String> {
  ["sh", "-c", join([
    "ls ", snapshot_dir as String, "/*.py 2>/dev/null | wc -l",
  ], "")]
}

func observe_model_side_code(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, snapshot_dir: NonEmptyStr,
) -> ServingCoordinateReading
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: snapshot_model_side_code_argv(snapshot_dir: snapshot_dir))
  if !remote_run_succeeded(r: r) {
    CoordinateUnestablished {
      obligation: join(["the model-side code population could not be counted on ", host as String], "") as NonEmptyStr,
    }
  } else {
    if remote_run_stdout(r: r) == "0" {
      CoordinateAbsentByObservation
    } else {
      CoordinateUnestablished {
        obligation: join([
          "the repository ships ", remote_run_stdout(r: r),
          " model-side python files and this rung cannot identify their content; the trigger is per-file enumeration",
        ], "") as NonEmptyStr,
      }
    }
  }
}

// ── THE CHECKPOINT COORDINATE AT THE REVISION RUNG ─────────────────────────────────────────────
//
// THE VALUE IS DERIVED FROM THE REPOSITORY AND THE IMMUTABLE REVISION, and the rung beside it says so.
// This is NOT a per-file content manifest and must never be cited as one: what it identifies is which
// upstream revision was materialised, verified by the Hub client's own per-file integrity check at
// acquisition time rather than by a manifest retained here. gunbc.spark.model_snapshot_acquisition
// declares that weakening and names the tree API that would close it.
// THE MATERIAL IS FRAMED, BECAUSE "@" BETWEEN TWO FREE STRINGS IS THE COLLISION THIS BRANCH JUST
// FIXED ONE COMMIT EARLIER FOR LAUNCH IDENTITY. repo "a@b" with revision "c" and repo "a" with
// revision "b@c" join identically, so two different upstream subjects would share one checkpoint
// coordinate -- the same defect, reintroduced in the same stack, three declarations away from its
// own annotation. Field tags and a record separator make it injective over this domain.
fn checkpoint_revision_material(repo: NonEmptyStr, revision: NonEmptyStr) -> NonEmptyStr {
  join([
    join(["repo", "\u{1f}", repo as String], ""),
    join(["revision", "\u{1f}", revision as String], ""),
  ], "\u{1e}") as NonEmptyStr
}

fn checkpoint_revision_reading(repo: NonEmptyStr, revision: NonEmptyStr) -> ServingCoordinateReading {
  CoordinateObserved {
    hash: content_hash_of_value(value: checkpoint_revision_material(repo: repo, revision: revision)),
  }
}

fn checkpoint_revision_rung(repo: NonEmptyStr, revision: NonEmptyStr) -> ServingSourceEvidenceRung {
  RevisionAddressedUpstreamVerification { authority: repo, revision: revision }
}

func observe_serving_source(
  ctx: SparkRemoteExecutionContext, host: HostIdentity,
  snapshot_dir: NonEmptyStr, repo: NonEmptyStr, revision: NonEmptyStr, container: NonEmptyStr,
) -> ServingSourceResolution
  uses net: Network
{
  resolve_serving_source(
    checkpoint: checkpoint_revision_reading(repo: repo, revision: revision),
    model_config: observe_snapshot_member(ctx: ctx, host: host, snapshot_dir: snapshot_dir, member: snapshot_member_model_config),
    tokenizer: observe_snapshot_member(ctx: ctx, host: host, snapshot_dir: snapshot_dir, member: snapshot_member_tokenizer),
    tokenizer_config: observe_snapshot_member(ctx: ctx, host: host, snapshot_dir: snapshot_dir, member: snapshot_member_tokenizer_config),
    special_tokens: observe_snapshot_member(ctx: ctx, host: host, snapshot_dir: snapshot_dir, member: snapshot_member_special_tokens),
    chat_template: observe_effective_chat_template(
      ctx: ctx, host: host, snapshot_dir: snapshot_dir,
      origin: observe_chat_template_origin(ctx: ctx, host: host, snapshot_dir: snapshot_dir, container: container)),
    model_side_code: observe_model_side_code(ctx: ctx, host: host, snapshot_dir: snapshot_dir),
    generation_defaults: observe_snapshot_member(ctx: ctx, host: host, snapshot_dir: snapshot_dir, member: snapshot_member_generation_defaults),
    processor_config: observe_snapshot_member(ctx: ctx, host: host, snapshot_dir: snapshot_dir, member: snapshot_member_processor_config),
    rung: checkpoint_revision_rung(repo: repo, revision: revision),
  )
}

// ── THE RUNTIME CLOSURE ────────────────────────────────────────────────────────────────────────
//
// THE IMAGE CONTENT ID IS THE RUNTIME'S IDENTITY AND IT IS ALREADY A SHA-256. A first-party built
// image has NO registry digest -- measured on this fleet: docker inspect of the derived runtime
// returns RepoDigests [] because it was built locally and loaded from an archive -- so the only
// content identity it has is its own Id, which is exactly what this reads.
//
// THE EXTENSION POPULATION IS ABSENT HERE AND THAT IS A MEASUREMENT ABOUT THIS ARM. Its three
// FlashInfer wheels were installed INTO the derived image at build time, so they are inside the image
// content id rather than beside it; an arm that installed wheels at container start would read a real
// population here. Absent means "no runtime artifact outside the image", not "no extensions".
fn runtime_image_id_argv(container: NonEmptyStr) -> List<String> {
  ["sh", "-c", join([
    "docker inspect -f '", go_template_action(body: ".Image"), "' ", container as String, " | sed 's/^sha256://'",
  ], "")]
}

func observe_runtime_image(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, container: NonEmptyStr,
) -> ServingCoordinateReading
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: runtime_image_id_argv(container: container))
  if !remote_run_succeeded(r: r) {
    CoordinateUnestablished {
      obligation: join(["the running container's image id could not be read on ", host as String], "") as NonEmptyStr,
    }
  } else {
    match sha256_hex_digest(hex: remote_run_stdout(r: r)) {
      Present { value: d } => CoordinateObserved { hash: Sha256Hash(d) }
      Absent => CoordinateUnestablished {
        obligation: "the running container reported an image id that is not a sha256 digest" as NonEmptyStr,
      }
    }
  }
}

func observe_serving_runtime(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, container: NonEmptyStr,
) -> ServingRuntimeResolution
  uses net: Network
{
  resolve_serving_runtime(
    runtime_image: observe_runtime_image(ctx: ctx, host: host, container: container),
    runtime_extensions: CoordinateAbsentByObservation,
    runtime_configuration: CoordinateAbsentByObservation,
  )
}


// ── EXECUTING THE OBSERVATION AGAINST A RUNNING INCARNATION ────────────────────────────────────
//
// THIS ENTRY EXISTS SO THE PRODUCER IS PROVEN BY EXECUTION RATHER THAN BY COMPILING. Every coordinate
// above is a remote read, and a module full of readings that nobody has run is the specification
// -without-execution DESIGN section 5 names: it typechecks, the symbols resolve, and not one digest
// has been taken. What this prints is the pair of references a turn's Work identity would be built
// from, or the obligations that stopped them being built.
data glm_native_snapshot_dir: NonEmptyStr = "/home/briansrls/.cache/huggingface/hub/models--zai-org--GLM-5.3-Flash/snapshots/eb9eb208eb0d988989d07a6a12d0fdeb5f52574a" as NonEmptyStr

data glm_native_repo: NonEmptyStr = "zai-org/GLM-5.3-Flash" as NonEmptyStr
data glm_native_revision: NonEmptyStr = "eb9eb208eb0d988989d07a6a12d0fdeb5f52574a" as NonEmptyStr
data glm_native_container: NonEmptyStr = "glm-native-tp4" as NonEmptyStr
// THE HOST IS NAMED BY THE FLEET ROSTER, NOT SPELLED HERE. A first cut wrote the machine's own
// hostname as a literal and every leg refused: "No ED25519 host key is known for spark-0c75 and you
// have requested strict checking". The trust anchor keys on the fleet's identity for that host, and
// a second spelling of a host is the DESIGN section 3 nickname -- which here does not merely
// duplicate a name, it addresses a machine the trust policy cannot vouch for.
data glm_native_provenance_host: HostIdentity = operator_host_srv9

// ── A SUCCESSFUL OBSERVATION MUST NOT LEAVE THROUGH THE FAILURE ARM ───────────────────────────
//
// THIS ENTRY REPORTED EVERY RESULT AS exit_failure, INCLUDING THE ONES THAT WORKED. It was written to
// print the derived references, and exit_failure was the arm that printed -- so every live receipt this
// producer has produced so far arrived through a terminal that says the run failed, and a reader
// consulting the exit status would have concluded the opposite of what happened. It is the same
// asymmetry gunbc.spark.native_cutover_wet carried, where only refusals spoke.
//
// THE RECEIPT IS WRITTEN RATHER THAN PRINTED for the same reason it is there: a provenance producer
// whose output exists only in a log line cannot be consumed by anything.
data incarnation_receipt_path: String = "target/spark-incarnation-provenance-receipt.txt"

func observe_glm_incarnation(ctx: SparkRemoteExecutionContext) -> ProcessExit
  uses net: Network
{
  let source = observe_serving_source(
    ctx: ctx, host: glm_native_provenance_host,
    snapshot_dir: glm_native_snapshot_dir, repo: glm_native_repo, revision: glm_native_revision,
    container: glm_native_container,
  )
  let runtime = observe_serving_runtime(
    ctx: ctx, host: glm_native_provenance_host, container: glm_native_container,
  )
  match seal_serving_execution_closure(source: source, runtime: runtime, receipt: vllm_incarnation_receipt) {
    ExecutionClosureUnestablished { obligations: os } =>
      exit_failure(reason: join([
        "INCARNATION UNESTABLISHED: ", join(map(os, o => o as String), "; "),
      ], ""))
    ExecutionClosureResolved { closure: c } => {
      let body = join([
        "INCARNATION OBSERVED -- source=", serving_execution_source_ref(c: c) as String,
        " runtime=", serving_execution_runtime_ref(c: c) as String,
        " rung=", serving_source_rung_wire(rung: c.source.rung) as String,
      ], "")
      let w = Filesystem.Write(path: incarnation_receipt_path, content: body)
      if w.success { ExitSuccess } else { exit_failure(reason: body) }
    }
  }
}

func glm_incarnation_provenance_wet() -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  match observe_executor_reach() {
    ExecutorReachUnknown { cause: c } => exit_failure(reason: join(["incarnation probe: ", c], ""))
    ExecutorReachKnown { short_hostname: _, path: path } =>
      match read_bootstrap_credential() {
        BootstrapCredentialNotMaterialized { cause: c } => exit_failure(reason: c as String)
        BootstrapCredentialReady { secret: administrator } =>
          match fleet_ssh_attempt_identity(raw: "incarnation-provenance") {
            Absent => exit_failure(reason: "the attempt identity is not a safe path segment")
            Present { value: attempt } => {
              let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
              match fleet_openssh_trust_policy_of(outcome: materialization) {
                Absent => exit_failure(reason: join([
                  "trust could not be established, so no leg ran: ",
                  known_hosts_materialization_receipt(outcome: materialization),
                ], ""))
                Present { value: trust } =>
                  match with_materialized_ssh_key_file(
                    identity_file_name: "gunbc-incarnation-provenance-admin-password" as NonEmptyStr,
                    secret_bytes: administrator as Secret,
                    use: fn(file) {
                      observe_glm_incarnation(
                        ctx: SparkRemoteExecutionContext {
                          trust: trust,
                          reach_path: path,
                          administrator: administrator as Secret,
                          administrator_file: file,
                        },
                      )
                    },
                  ) {
                    MaterializedSshKeyFileBracketRefused { cause: c } => exit_failure(reason: c as String)
                    MaterializedSshKeyFileBracketCompleted { value: v } => v
                  }
              }
            }
          }
      }
  }
}


// ── BINDING THE CLOSURE TO THE EXACT LAUNCH THAT REALIZES IT ───────────────────────────────────
//
// A SOURCE AND A RUNTIME ARE NOT YET AN INCARNATION. What makes them one is evidence that THIS running
// launch was configured from THOSE closures, and gunbc.spark.vllm_endpoint_process_launch is explicit
// that its own carrier establishes only the API process lifetime -- not the engine core, not the rank
// population, not the runtime image, not the loaded model. So the launch identity is joined here to a
// privileged observation rather than trusted to speak for those facts itself.
//
// WORK IDENTITY MUST NOT CONTAIN THE LAUNCH AND OFFER IDENTITY MUST. Restarting the same bytes is the
// same semantic Work and a different offer, so the launch sits BESIDE the execution closure in this
// receipt rather than inside the manifests: the closure answers "what would this compute", the launch
// answers "which process is currently answering", and a consumer needs both to know that a particular
// endpoint may be asked for a particular Work.
type VllmIncarnationEvidence sole_constructor {
  ranks_agreed: Nat
  ranks_required: Nat
  image_digest: NonEmptyStr
  model_path: NonEmptyStr
}

type VllmServingIncarnationProvenance sole_constructor {
  launch: VllmEndpointProcessLaunch
  execution: ServingTurnExecutionClosure
  evidence: VllmIncarnationEvidence
}

type VllmIncarnationOutcome
  = IncarnationBound { provenance: VllmServingIncarnationProvenance }
  | IncarnationUnestablished { obligations: List<NonEmptyStr> }

// THE DEPLOYMENT MUST HAVE BEEN ACCEPTED, AND A PARTIAL POPULATION IS NOT AN ACCEPTANCE. The readback
// already compares every rank's image, engine arguments, checkpoint revision, host and bound fabric
// interface and refuses on any divergence, so this consumes that verdict rather than restating the
// comparison -- and it additionally requires the agreed population to be the REQUIRED one, because a
// receipt that says three ranks agreed is a receipt about three ranks.
fn incarnation_deployment_obligations(acceptance: DeploymentAcceptance, ranks_required: Nat) -> List<NonEmptyStr> {
  match acceptance {
    DeploymentRejected { deviations: ds } =>
      [join(["the deployment DIVERGED from the plan: ", deployment_deviations_text(ds: ds)], "") as NonEmptyStr]
    DeploymentUnverified { unknowns: us } =>
      [join(["the deployment readback could not establish every fact it must assert: ", deployment_unknowns_text(us: us)], "") as NonEmptyStr]
    DeploymentUnverifiable { cause: c } =>
      [join(["the deployment could not be assessed at all: ", c as String], "") as NonEmptyStr]
    DeploymentAccepted { receipt: r } =>
      if r.ranks_agreed == ranks_required { [] } else {
        [join([
          "the deployment was accepted over ", to_string(r.ranks_agreed),
          " ranks and this topology requires ", to_string(ranks_required),
        ], "") as NonEmptyStr]
      }
  }
}

fn bind_incarnation(
  launch: VllmEndpointProcessLaunch,
  acceptance: DeploymentAcceptance,
  ranks_required: Nat,
  source: ServingSourceResolution,
  runtime: ServingRuntimeResolution,
) -> VllmIncarnationOutcome {
  let deployment_obligations = incarnation_deployment_obligations(acceptance: acceptance, ranks_required: ranks_required)
  match seal_serving_execution_closure(source: source, runtime: runtime, receipt: vllm_incarnation_receipt) {
    ExecutionClosureUnestablished { obligations: os } =>
      IncarnationUnestablished { obligations: concat(deployment_obligations, os) }
    ExecutionClosureResolved { closure: c } =>
      if count(deployment_obligations) != 0 {
        IncarnationUnestablished { obligations: deployment_obligations }
      } else {
        match acceptance {
          DeploymentRejected { deviations: _ } => IncarnationUnestablished { obligations: deployment_obligations }
          DeploymentUnverified { unknowns: _ } => IncarnationUnestablished { obligations: deployment_obligations }
          DeploymentUnverifiable { cause: _ } => IncarnationUnestablished { obligations: deployment_obligations }
          DeploymentAccepted { receipt: r } =>
            IncarnationBound {
              provenance: VllmServingIncarnationProvenance {
                launch: launch,
                execution: c,
                evidence: VllmIncarnationEvidence {
                  ranks_agreed: r.ranks_agreed,
                  ranks_required: ranks_required,
                  image_digest: r.image_digest,
                  model_path: r.model_path,
                },
              },
            }
        }
      }
  }
}

// ── PROVENANCE FOR ONE LAUNCH MAY NEVER BIND ANOTHER ───────────────────────────────────────────
//
// TWO GROUPS ANSWERING THE SAME ALIAS IS THE CASE THIS FORBIDS. A receipt established against group A's
// launch says nothing about what group B loaded, and admitting it because both advertise one model name
// would let a turn be placed on an engine nobody observed. The comparison is on the launch's own offer
// key, which gunbc.spark.vllm_endpoint_process_launch already folds from every field of the carrier --
// so a restart, a different endpoint or a different group is a different launch by construction.
// THE COMPARISON IS FIELD BY FIELD BECAUSE THE OFFER KEY IS NOT INJECTIVE. That key renders
// group@endpoint@process_start_field over two UNCONSTRAINED NonEmptyStr fields, so an endpoint of
// "a@b" with a start field of "c" and an endpoint of "a" with a start field of "b@c" serialise
// identically -- and comparing keys would then report two different launches as one, which is exactly
// the confusion this predicate exists to prevent. Fixture values rarely contain "@", so a key
// comparison can stay green while being wrong; the structural comparison cannot.
fn incarnation_applies_to(p: VllmServingIncarnationProvenance, launch: VllmEndpointProcessLaunch) -> Bool {
  vllm_endpoint_process_launch_is(launch: p.launch, other: launch)
}

// ── A LOOKUP THAT RESOLVES AMBIGUITY BY LIST ORDER IS NOT A LOOKUP ────────────────────────────
//
// TWO PROVENANCE ROWS FOR ONE LAUNCH IS A CONTRADICTION, NOT A CHOICE. The previous body filtered and
// took the first, so two rows disagreeing about source or runtime would silently elect whichever the
// caller happened to hold first -- and the disagreement is exactly the condition under which a turn
// must not be placed at all. Absence and contradiction are different answers with different remedies:
// one says nobody observed this launch, the other says two observations of it do not agree.
type IncarnationLookup
  = IncarnationFound { provenance: VllmServingIncarnationProvenance }
  | IncarnationMissing
  | IncarnationAmbiguous { matches: Nat }

fn incarnation_for_launch(
  candidates: List<VllmServingIncarnationProvenance>, launch: VllmEndpointProcessLaunch,
) -> IncarnationLookup {
  let matches = filter(candidates, p => incarnation_applies_to(p: p, launch: launch))
  if count(matches) > 1 {
    IncarnationAmbiguous { matches: count(matches) }
  } else {
    match matches.first() {
      Absent => IncarnationMissing
      Present { value: p } => IncarnationFound { provenance: p }
    }
  }
}


// ── WHICH TEMPLATE THE LAUNCH ACTUALLY USES, NOT EVERY TEMPLATE-SHAPED FILE PRESENT ────────────
//
// HASHING chat_template.jinja BECAUSE IT IS THERE IS NOT THE SAME QUESTION. A snapshot may carry a
// template the launch never selects, a launch may override it on the command line, and a tokenizer
// configuration may carry one inline -- and the source identity must name the one that SHAPED THE
// REQUEST. The previous observation read the repository file unconditionally, which happens to be
// right on this deployment and would be silently wrong on the next.
//
// IDENTITY IS THE SELECTED TEMPLATE'S CONTENT AND ORIGIN IS EVIDENCE BESIDE IT. Two launches whose
// effective templates are byte-identical compute the same thing whichever path the bytes came from,
// so origin must not enter the coordinate; what origin answers is how a reader would reproduce the
// selection, which is a different question from what the engine did.
//
// AMBIGUITY REFUSES RATHER THAN PICKING. More than one template-shaped file with nothing selecting
// between them is a question this observer cannot answer, and answering it by convention -- first
// alphabetically, or the one matching a known name -- would be a fabricated plausible output.
type ChatTemplateOrigin
  = TemplateFromLaunchOverride { path: NonEmptyStr }
  | TemplateFromRepositoryFile { path: NonEmptyStr }
  | TemplateInheritedFromTokenizerConfig
  | TemplateSelectionAmbiguous { candidates: Nat }
  | TemplateOriginUnestablished { cause: NonEmptyStr }

fn chat_template_origin_wire(origin: ChatTemplateOrigin) -> NonEmptyStr {
  match origin {
    TemplateFromLaunchOverride { path: p } =>
      join(["selected by the launch line: ", p as String], "") as NonEmptyStr
    TemplateFromRepositoryFile { path: p } =>
      join(["the repository's own template file: ", p as String], "") as NonEmptyStr
    TemplateInheritedFromTokenizerConfig =>
      "inherited from the tokenizer configuration, whose digest is its own coordinate" as NonEmptyStr
    TemplateSelectionAmbiguous { candidates: n } =>
      join([to_string(n), " template-shaped files and nothing selecting between them"], "") as NonEmptyStr
    TemplateOriginUnestablished { cause: c } => c
  }
}

// THE LAUNCH LINE IS READ FIRST BECAUSE IT WINS. An override names a path that need not be inside the
// snapshot at all, so the selection is decided before anything looks at the repository population.
fn launch_chat_template_override_argv(container: NonEmptyStr) -> List<String> {
  ["sh", "-c", join([
    "docker inspect -f '", go_template_action(body: "json .Config.Cmd"), "' ", container as String,
    " | tr ',' '\\n' | grep -A1 -- '--chat-template' | tail -1 | tr -d '\"[] '",
  ], "")]
}

// A COUNT OF ZERO IS AN ANSWER, AND grep EXITS NONZERO WHEN IT FINDS NOTHING. Measured: `ls | grep -ci
// template` over a directory with no match prints "0" and exits 1, which this observer read as "the
// population could not be counted" -- so the zero arm below, and the whole inherited-template branch it
// guards, were UNREACHABLE. A production path that cannot be entered is the same defect class as a test
// that cannot go red, and it was introduced by an idiom that looks like it reports a number.
//
// `|| true` IS NOT THE FIX EITHER, because it would also swallow a real failure to list the directory.
// The listing and the counting are separated: ls decides whether the read happened, wc -l counts, and
// grep's exit status is never consulted.
fn snapshot_template_candidates_argv(snapshot_dir: NonEmptyStr) -> List<String> {
  ["sh", "-c", join([
    "ls ", snapshot_dir as String, " | grep -i template | wc -l",
  ], "")]
}

// grep -c ALREADY PRINTS ZERO, so the `|| echo 0` this used to carry emitted a SECOND line: measured
// output was "0\n0", which equals neither "0" nor anything else the caller tested, and a no-match could
// therefore be read as an inline template. The redirection stays for the missing-file case and the
// count is taken once.
fn tokenizer_config_carries_template_argv(snapshot_dir: NonEmptyStr) -> List<String> {
  ["sh", "-c", join([
    "grep -c '\"chat_template\"' ", snapshot_dir as String, "/tokenizer_config.json 2>/dev/null | head -1",
  ], "")]
}


// ONE TEMPLATE-SHAPED FILE IS NOT THE SAME AS THAT FILE BEING THE ONE WE NAME. The previous selection
// counted names containing "template" and, on a count of one, returned the fixed path
// chat_template.jinja -- so a repository carrying only foo_template.json selected a file that is not
// there, and the coordinate would have read ABSENT for a model that does have a template. The name is
// read rather than assumed.
fn snapshot_template_name_argv(snapshot_dir: NonEmptyStr) -> List<String> {
  ["sh", "-c", join([
    "ls ", snapshot_dir as String, " | grep -i template | head -1",
  ], "")]
}

func observe_named_template(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, snapshot_dir: NonEmptyStr,
) -> NonEmptyStr?
  uses net: Network
{
  let r = spark_exec(ctx: ctx, host: host, argv: snapshot_template_name_argv(snapshot_dir: snapshot_dir))
  if !remote_run_succeeded(r: r) { none }
  else {
    if remote_run_stdout(r: r) == "" { none } else { Present { value: remote_run_stdout(r: r) as NonEmptyStr } }
  }
}

func observe_chat_template_origin(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, snapshot_dir: NonEmptyStr, container: NonEmptyStr,
) -> ChatTemplateOrigin
  uses net: Network
{
  let override = spark_exec(ctx: ctx, host: host, argv: launch_chat_template_override_argv(container: container))
  if !remote_run_succeeded(r: override) {
    TemplateOriginUnestablished { cause: "the launch line could not be read for a chat-template override" as NonEmptyStr }
  } else {
    if remote_run_stdout(r: override) != "" {
      TemplateFromLaunchOverride { path: remote_run_stdout(r: override) as NonEmptyStr }
    } else {
      let candidates = spark_exec(ctx: ctx, host: host, argv: snapshot_template_candidates_argv(snapshot_dir: snapshot_dir))
      if !remote_run_succeeded(r: candidates) {
        TemplateOriginUnestablished { cause: "the snapshot's template population could not be counted" as NonEmptyStr }
      } else {
        if remote_run_stdout(r: candidates) == "1" {
          match observe_named_template(ctx: ctx, host: host, snapshot_dir: snapshot_dir) {
            Absent => TemplateOriginUnestablished {
              cause: "one template-shaped file was counted and its name could not be read" as NonEmptyStr,
            }
            Present { value: name } => TemplateFromRepositoryFile { path: snapshot_member_path(snapshot_dir: snapshot_dir, member: name) }
          }
        } else {
          if remote_run_stdout(r: candidates) == "0" {
            let inherited = spark_exec(ctx: ctx, host: host, argv: tokenizer_config_carries_template_argv(snapshot_dir: snapshot_dir))
            if !remote_run_succeeded(r: inherited) {
              TemplateOriginUnestablished { cause: "the tokenizer configuration could not be read for an inline template" as NonEmptyStr }
            } else {
              if remote_run_stdout(r: inherited) == "0" {
                TemplateOriginUnestablished { cause: "no template was found in the launch line, the repository or the tokenizer configuration" as NonEmptyStr }
              } else {
                TemplateInheritedFromTokenizerConfig
              }
            }
          } else {
            TemplateSelectionAmbiguous { candidates: 2 }
          }
        }
      }
    }
  }
}

// THE COORDINATE FOLLOWS THE SELECTION. An inherited template is AbsentByObservation on this axis and
// is covered by the tokenizer-configuration coordinate that actually contains it -- the same shape the
// special-token axis takes in this layout -- while an ambiguous or unestablished selection refuses, so
// no manifest is built over a template nobody identified.
func observe_effective_chat_template(
  ctx: SparkRemoteExecutionContext, host: HostIdentity, snapshot_dir: NonEmptyStr, origin: ChatTemplateOrigin,
) -> ServingCoordinateReading
  uses net: Network
{
  match origin {
    TemplateFromLaunchOverride { path: p } => observe_path_digest(ctx: ctx, host: host, path: p)
    TemplateFromRepositoryFile { path: p } => observe_path_digest(ctx: ctx, host: host, path: p)
    TemplateInheritedFromTokenizerConfig => CoordinateAbsentByObservation
    TemplateSelectionAmbiguous { candidates: n } =>
      CoordinateUnestablished {
        obligation: join([
          "the effective chat template is ambiguous: ",
          chat_template_origin_wire(origin: TemplateSelectionAmbiguous { candidates: n }) as String,
        ], "") as NonEmptyStr,
      }
    TemplateOriginUnestablished { cause: c } => CoordinateUnestablished { obligation: c }
  }
}
