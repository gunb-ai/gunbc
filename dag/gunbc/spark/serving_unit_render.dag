module gunbc.spark.serving_unit_render

import std.types { String, NonEmptyStr, FilePath }
import std.measure { token_count_value, positive_slot_count_value }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.content_hash { serialize_content_hash, content_hash_of_value }
import std.bytes { bytes_octets, utf8_encode_bytes }
import std.encoding { base64_encode, Standard }
import extdeps.systemd.unit_file {
  SystemdUnitFile,
  ServiceUnitFile,
  Installable,
  Description,
  After,
  ServiceType,
  ExecStart,
  Restart,
  Environment,
  WorkingDirectory,
  WantedBy,
  serialize_systemd_unit_file,
}
import extdeps.ollama.server_env {
  ollama_host_env_assignment,
  ollama_models_env_assignment,
  ollama_context_length_env_assignment, ollama_num_parallel_env_assignment,
}
import gunbc.spark.serving_install_paths {
  SparkServingUserUnitSpec,
  spark_serving_user_unit_spec,
  spark_serving_required_runtime_root,
  spark_serving_required_runtime_executable_path,
  spark_serving_models_root,
}
import gunbc.spark.serving_desired {
  spark_serving_desired_bind_host_port,
  spark_serving_desired_default_context,
  spark_serving_desired_serving_slots,
}

// THE ONE PLACE A SPARK SERVING UNIT BECOMES BYTES.
//
// `SparkServingUserUnitSpec` is deliberately typed fields and NOT systemd INI syntax -- its own
// authority note says so. That left a gap rather than a decision: nothing could turn the spec into a
// file, so `WriteUserUnitFile` had no bytes to deliver and the unit member had nothing to be
// observed against. The missing piece was never gunbc's to invent, because spelling `[Service]` and
// `ExecStart=` here would have made this module a second systemd authority (§3). It belongs to
// `extdeps.systemd.unit_file`, which is cited to systemd.unit(5) and systemd.service(5); this module
// only maps gunbc's typed fields onto it.
//
// The mapping is total and takes no decisions of its own: every directive below is a spec field or a
// path derived from the install-paths authority. There is no arm that can omit a directive or supply
// a default, so a spec change cannot silently fail to reach the file.

// THE EXECUTABLE PATH IS THE INSTALL-PATHS AUTHORITY'S, NOT A LITERAL SPELLED HERE.
//
// This used to join the runtime root with the literal "/bin/ollama" -- a second statement of
// `executable_relative_path`, which the cited release row already carries and which the observation
// probe reads. Two spellings of one fact, and the one that would drift silently: a release whose
// layout put the binary elsewhere would be observed at the right path, materialized to the right
// path, and then started from the wrong one, with nothing comparing the two.
fn spark_serving_exec_start_command(spec: SparkServingUserUnitSpec) -> NonEmptyStr {
  join([
    spark_serving_required_runtime_executable_path() as String,
    " ",
    spec.exec_subcommand as String,
  ], "") as NonEmptyStr
}

// THE DEFINITION IDENTITY CARRIED BY THE INVOCATION IT STARTS.
//
// systemd's loaded unit and the file on disk can both advance while an already-running process
// keeps the environment and command line from its earlier start.  The process therefore carries
// the identity of the typed definition that created it.  This is derived before rendering (and so
// is not a self-hash of a file containing its own hash), while still covering every typed unit-spec
// field.  A later observer reads this value from /proc/<MainPID>/environ; it never substitutes the
// file's current identity for the invocation's.
// THE CURRENT RUNG IS A COMPILE-TIME TRIPWIRE, NOT STRUCTURAL IMPOSSIBILITY.
//
// content_hash_of_value currently accepts only NonEmptyStr, so the typed spec must be projected to
// one canonical string wire. The total SparkServingUserUnitSpec reconstruction below makes adding a
// field fail compilation here and prompts an identity-domain decision; every serialized projection
// then reads from that reconstructed value. It remains mechanically possible for an author to add
// the field to the reconstruction but omit it from the join, so this converts a silent omission into
// a prompted one rather than making omission unwritable. String fields are base64-framed and field
// names fixed, so delimiters inside a field cannot make distinct covered specs collide.
//
// DISSOLVES WHEN the content-hash primitive accepts structured values and SparkServingUserUnitSpec
// can be hashed directly. That capability, not a record-fold artifact, makes every present and future
// field enter the domain by construction. This wire is intentionally NOT rendered unit-file content:
// those bytes contain the resulting identity and therefore cannot be their own hash domain.
fn spark_serving_user_unit_spec_identity_wire(spec: SparkServingUserUnitSpec) -> NonEmptyStr {
  let identity_spec = SparkServingUserUnitSpec {
    description: spec.description,
    after: spec.after,
    service_type: spec.service_type,
    bind_host_port: spec.bind_host_port,
    models_root_rel: spec.models_root_rel,
    runtime_root_rel: spec.runtime_root_rel,
    exec_subcommand: spec.exec_subcommand,
    restart: spec.restart,
    wanted_by: spec.wanted_by,
    default_context: spec.default_context,
    serving_slots: spec.serving_slots,
  }
  join([
    "description=", base64_encode(octets: bytes_octets(b: utf8_encode_bytes(s: identity_spec.description as String)), variant: Standard), "\n",
    "after=", base64_encode(octets: bytes_octets(b: utf8_encode_bytes(s: identity_spec.after as String)), variant: Standard), "\n",
    "service_type=", base64_encode(octets: bytes_octets(b: utf8_encode_bytes(s: identity_spec.service_type as String)), variant: Standard), "\n",
    "bind_host_port=", base64_encode(octets: bytes_octets(b: utf8_encode_bytes(s: identity_spec.bind_host_port as String)), variant: Standard), "\n",
    "models_root_rel=", base64_encode(octets: bytes_octets(b: utf8_encode_bytes(s: identity_spec.models_root_rel)), variant: Standard), "\n",
    "runtime_root_rel=", base64_encode(octets: bytes_octets(b: utf8_encode_bytes(s: identity_spec.runtime_root_rel)), variant: Standard), "\n",
    "exec_subcommand=", base64_encode(octets: bytes_octets(b: utf8_encode_bytes(s: identity_spec.exec_subcommand as String)), variant: Standard), "\n",
    "restart=", base64_encode(octets: bytes_octets(b: utf8_encode_bytes(s: identity_spec.restart as String)), variant: Standard), "\n",
    "wanted_by=", base64_encode(octets: bytes_octets(b: utf8_encode_bytes(s: identity_spec.wanted_by as String)), variant: Standard), "\n",
    "default_context=", to_string(token_count_value(t: identity_spec.default_context)), "\n",
    "serving_slots=", to_string(positive_slot_count_value(slots: identity_spec.serving_slots)), "\n",
  ], "") as NonEmptyStr
}

data spark_serving_user_unit_spec_identity_wire_dissolution_trigger: DissolutionCondition = unbound_dissolution(
  description: "dissolve-on: spark_serving_user_unit_spec_identity_wire -- canonical string projection and total-record tripwire remain because content_hash_of_value accepts only NonEmptyStr. DISSOLVES WHEN the content-hash primitive accepts structured values and hashes SparkServingUserUnitSpec directly, placing every present and future field in the definition-identity domain by construction." as NonEmptyStr,
)

fn spark_serving_user_unit_definition_identity(spec: SparkServingUserUnitSpec) -> NonEmptyStr {
  serialize_content_hash(
    hash: content_hash_of_value(value: spark_serving_user_unit_spec_identity_wire(spec: spec)),
  ) as NonEmptyStr
}

data spark_serving_definition_identity_environment_name: NonEmptyStr = "GUNBC_SPARK_SERVING_DEFINITION_IDENTITY" as NonEmptyStr

fn spark_serving_definition_identity_environment_assignment(
  spec: SparkServingUserUnitSpec,
) -> NonEmptyStr {
  join([
    spark_serving_definition_identity_environment_name as String,
    "=",
    spark_serving_user_unit_definition_identity(spec: spec) as String,
  ], "") as NonEmptyStr
}

// The runtime and model roots come from the install-paths authority rather than from the spec's
// relative strings, so the unit and the installer cannot disagree about where the runtime lives.
fn spark_serving_user_unit_file(spec: SparkServingUserUnitSpec) -> SystemdUnitFile {
  ServiceUnitFile {
    unit: [
      Description { text: spec.description },
      After { target: spec.after },
    ],
    service: [
      ServiceType { mode: spec.service_type },
      Environment { assignment: ollama_host_env_assignment(bind: spec.bind_host_port) },
      Environment {
        assignment: ollama_models_env_assignment(root: spark_serving_models_root() as NonEmptyStr),
      },
      Environment {
        assignment: ollama_context_length_env_assignment(default_context: spec.default_context),
      },
      Environment {
        assignment: ollama_num_parallel_env_assignment(slots: spec.serving_slots),
      },
      Environment { assignment: spark_serving_definition_identity_environment_assignment(spec: spec) },
      WorkingDirectory { path: spark_serving_required_runtime_root() as NonEmptyStr },
      ExecStart { command: spark_serving_exec_start_command(spec: spec) },
      Restart { policy: spec.restart },
    ],
    install: Installable { directives: [WantedBy { target: spec.wanted_by }] },
  }
}

// THE DELIVERED BYTES, and the value an observed unit file is compared against. One function, so the
// write side and the observe side cannot drift into two renderings of one spec -- which would make
// every host report a permanent MemberChanged against itself.
fn spark_serving_user_unit_text(spec: SparkServingUserUnitSpec) -> String {
  serialize_systemd_unit_file(file: spark_serving_user_unit_file(spec: spec))
}

fn spark_serving_desired_user_unit_text() -> String {
  spark_serving_user_unit_text(
    spec: spark_serving_user_unit_spec(
      bind_host_port: spark_serving_desired_bind_host_port() as NonEmptyStr,
      default_context: spark_serving_desired_default_context(),
      serving_slots: spark_serving_desired_serving_slots(),
    ),
  )
}

fn spark_serving_desired_user_unit_definition_identity() -> NonEmptyStr {
  spark_serving_user_unit_definition_identity(
    spec: spark_serving_user_unit_spec(
      bind_host_port: spark_serving_desired_bind_host_port() as NonEmptyStr,
      default_context: spark_serving_desired_default_context(),
      serving_slots: spark_serving_desired_serving_slots(),
    ),
  )
}

// ONE IDENTITY FOR UNIT CONTENT, used by the desired side and the observed side alike.
//
// The member's state IS the file's content, so its identity must be a function of bytes and nothing
// else. An earlier classifier returned the DESIRED spec's digest when bytes matched and a hash of
// the observed bytes when they did not -- two different identity domains, so the same bytes on disk
// changed identity whenever desired state changed, and the equality arm silently imported the answer
// it was supposed to be establishing.
//
// Taking the identity over `String` rather than `NonEmptyStr` is deliberate: an empty file is a real
// observation and ordinary drift, not an impossible state, and casting `""` to `NonEmptyStr` to
// force it through a hash would be a lie about what was read.
// THE IDENTITY IS TAKEN OVER THE BASE64 WIRE FORM OF THE BYTES, on both sides.
//
// Not because base64 is meaningful here, but because the observation channel trims trailing
// whitespace and therefore cannot deliver raw bytes. Encoding both sides identically keeps this an
// identity of the file's content -- the same function of the same bytes -- while making it survive
// a transport that would otherwise silently shorten it. The alternative was to make the observed
// state a verdict relative to desired, which would have put the identity in a different domain
// whenever desired state changed; this keeps one domain.
fn spark_serving_user_unit_content_identity(wire_base64: String) -> NonEmptyStr {
  serialize_content_hash(
    hash: content_hash_of_value(
      value: join(["unit-content:", wire_base64], "") as NonEmptyStr,
    ),
  ) as NonEmptyStr
}

// The desired side's wire form, encoded here so the two sides cannot drift into different encodings
// of one spec -- the same reason spark_serving_user_unit_text is one function.
fn spark_serving_user_unit_content_wire(text: String) -> String {
  base64_encode(
    octets: bytes_octets(b: utf8_encode_bytes(s: text)),
    variant: Standard,
  )
}

fn spark_serving_desired_user_unit_content_identity() -> NonEmptyStr {
  spark_serving_user_unit_content_identity(
    wire_base64: spark_serving_user_unit_content_wire(text: spark_serving_desired_user_unit_text()),
  )
}
