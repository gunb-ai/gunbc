data spark_credential_workflow_note: String = "SECRETREF-WIRE-0: credentials resolve inside the workflow from typed SecretRef rows and gunbc.auth.secret_ref_credential.fetch_secret_ref_credential (wire decoding imported from extdeps.cloud.gcp.secret_manager). Wet entry points name attempt identity and host only — never plaintext administrator passwords or fleet key paths on argv. The spark-administrator-password SecretRef (versions/1) is ON the serving-install critical path: gunbc-automation's sole NOPASSWD grant is EnableLingerForOwnAccount (UserUnitRealization), while SystemUnitRealization still needs the escalating effects its install closure declares, derived by gunbc.spark.serving_realization realization_escalated_commands rather than enumerated here — a copied list is a second authority for a fact the model owns, and this one drifted the moment an effect was split — widening sudoers is itself a privileged effect that requires the administrator credential this lane resolves."

data spark_credential_access_token_frontier_note: String = "AUTH FRONTIER (2026-08-13). HOST SCOPE: GcloudPrintToken is wired for operator-workstation wet runs — local gunbc run and dashboard dispatch on srv1-class hosts where an interactive gcloud user session may exist. It is NOT valid on GHA self-hosted runner slots: those hosts do not carry gcloud, and binding this fetch path there fails at runtime rather than degrading to hand-rolled token fetch. CI fleet-key materialization on runners remains gunbc_ci_fleet_key_agent_script (google_auth_action env) until gunbc.github_actions_wif exists on origin/main as the single federation authority. Operator-token routes are refuted upstream (ACCESS_TOKEN_TYPE_UNSUPPORTED). WIF FRONTIER (present state, not a schedule): gunbc.github_actions_wif is absent from origin/main (measured 2026-08-13); federation rows exist only on origin/session/pi-reach-0, PR #7971 CLOSED 2026-08-07 without merge — dead work, not in flight. Revival onto a live branch versus fresh authoring remains an operator decision; this module does not copy those rows as a private duplicate. Wet resolution refuses when gcloud cannot mint a token on a workstation host."

data spark_administrator_password_secret_ref: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "spark-administrator-password" as NonEmptyStr,
  version: "1",
  hash_state: HashPending,
}

data fleet_automation_ssh_privkey_rotation_consumer_id: ConsumerId = "fleet-automation-ssh-key" as ConsumerId

data spark_administrator_password_rotation_consumer_id: ConsumerId = "spark-administrator-password" as ConsumerId

fn consumer_evidence_from_secret_fetch(
  consumer: ConsumerId,
  fetch: SecretCredentialFetch,
) -> ConsumerVersionEvidence? {
  match fetch {
    SecretCredentialReady { credential: _, resolved_version: resolved } =>
      Present {
        value: ResolvedVersionObserved {
          consumer: consumer,
          resolved: resolved,
        },
      }
    SecretCredentialResolvedVersionMismatch { requested: _, resolved: _ } => Absent
    SecretCredentialAccessUpsertRequired { plan: _ } => Absent
    SecretCredentialFetchRefused { reason: _ } => Absent
    SecretCredentialWireDecodeRefused { identity_cause: _, payload_cause: _ } => Absent
  }
}

func observe_spark_credential_consumer_evidence(
  token_source: AccessTokenSource,
) -> List<ConsumerVersionEvidence>
  uses net: Network
{
  let privkey_fetch = fetch_secret_ref_credential(
    secret_ref: fleet_automation_ssh_privkey_secret,
    token_source: token_source,
  )
  let admin_fetch = fetch_secret_ref_credential(
    secret_ref: spark_administrator_password_secret_ref,
    token_source: token_source,
  )
  let privkey_evidence = consumer_evidence_from_secret_fetch(
    consumer: fleet_automation_ssh_privkey_rotation_consumer_id,
    fetch: privkey_fetch,
  )
  let admin_evidence = consumer_evidence_from_secret_fetch(
    consumer: spark_administrator_password_rotation_consumer_id,
    fetch: admin_fetch,
  )
  match privkey_evidence {
    Present { value: privkey_row } =>
      match admin_evidence {
        Present { value: admin_row } => [privkey_row, admin_row]
        Absent => [privkey_row]
      }
    Absent =>
      match admin_evidence {
        Present { value: admin_row } => [admin_row]
        Absent => []
      }
  }
}

fn fleet_ssh_privkey_identity_file_name(attempt: FleetSshAttemptIdentity) -> NonEmptyStr {
  join([
    "gunbc-fleet-ssh-attempt-", attempt as String,
    "-privkey",
  ], "") as NonEmptyStr
}

// The materialized file is verified to hold the declared fleet key BEFORE the body runs. On mismatch
// or derivation refusal the body is never entered, so a wrong secret version is a located refusal
// that contacts no host, rather than an authentication failure discovered against a real machine.
// This is the route that previously asserted the correspondence instead of observing it.
func run_with_materialized_fleet_ssh_binding(
  attempt_raw: String,
  token_source: AccessTokenSource,
  body: fn(FleetSshCredentialBinding) -> ProcessExit,
) -> ProcessExit
  uses net: Network
{
  match fleet_ssh_attempt_identity(raw: attempt_raw) {
    Absent =>
      exit_failure(reason: "attempt identity is not a safe path segment")
    Present { value: attempt } => {
      let identity_file_name = fleet_ssh_privkey_identity_file_name(attempt: attempt)
      match fetch_secret_ref_credential(
        secret_ref: fleet_automation_ssh_privkey_secret,
        token_source: token_source,
      ) {
        SecretCredentialResolvedVersionMismatch { requested: requested, resolved: resolved } =>
          exit_failure(reason: concat(concat(
            "the ssh key fetch asked for ", requested),
            concat(" and the service answered about ", resolved)))
        SecretCredentialReady { credential: privkey, resolved_version: _ } =>
          match with_materialized_ssh_key_file(
            identity_file_name: identity_file_name,
            secret_bytes: privkey,
            use: fn(identity_file) {
              match verify_fleet_ssh_credential(
                identity_file: identity_file,
                expected_key: fleet_automation_ssh_key,
              ) {
                FleetSshCredentialVerified { binding: binding } => body(binding)
                FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed } =>
                  exit_failure(
                    reason: fleet_ssh_credential_verification_refusal_reason(
                      verification: FleetSshCredentialIdentityMismatch {
                        expected_line: expected,
                        observed_line: observed,
                      },
                    ),
                  )
                FleetSshCredentialDerivationRefused { cause: cause } =>
                  exit_failure(
                    reason: fleet_ssh_credential_verification_refusal_reason(
                      verification: FleetSshCredentialDerivationRefused { cause: cause },
                    ),
                  )
              }
            },
          ) {
            MaterializedSshKeyFileBracketCompleted { value: exit } => exit
            MaterializedSshKeyFileBracketRefused { cause: cause } =>
              exit_failure(reason: cause as String)
          }
        SecretCredentialAccessUpsertRequired { plan: plan } =>
          exit_failure(reason: access_token_upsert_required_reason(plan: plan) as String)
        SecretCredentialFetchRefused { reason: reason } =>
          exit_failure(reason: reason as String)
        SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
          exit_failure(
            reason: secret_credential_wire_decode_refusal_reason(
              identity_cause: identity_cause,
              payload_cause: payload_cause,
            ) as String,
          )
      }
    }
  }
}

type SparkAdministratorCredentialResolution
  = SparkAdministratorCredentialResolved { credential: Secret }
  | SparkAdministratorCredentialRefused { reason: NonEmptyStr }

fn sm_resolved_version_identity_refusal_label(cause: SmResolvedVersionIdentityRefusal) -> String {
  match cause {
    SmResolvedVersionIdentityEmpty => "resolved version identity empty"
    SmResolvedVersionIdentityMalformed => "resolved version identity malformed"
  }
}

fn sm_access_version_payload_refusal_label(cause: SmAccessVersionPayloadRefusal) -> String {
  match cause {
    SmAccessVersionPayloadEmpty => "access version payload empty"
    SmAccessVersionPayloadInvalidBase64 => "access version payload invalid base64"
  }
}

fn secret_credential_wire_decode_refusal_reason(
  identity_cause: SmResolvedVersionIdentityRefusal?,
  payload_cause: SmAccessVersionPayloadRefusal?,
) -> NonEmptyStr {
  match identity_cause {
    Present { value: identity_refusal } =>
      match payload_cause {
        Present { value: payload_refusal } =>
          concat(
            concat(
              sm_resolved_version_identity_refusal_label(cause: identity_refusal),
              "; ",
            ),
            sm_access_version_payload_refusal_label(cause: payload_refusal),
          ) as NonEmptyStr
        Absent =>
          sm_resolved_version_identity_refusal_label(cause: identity_refusal) as NonEmptyStr
      }
    Absent =>
      match payload_cause {
        Present { value: payload_refusal } =>
          sm_access_version_payload_refusal_label(cause: payload_refusal) as NonEmptyStr
        Absent => "secret manager access version wire decode refused without typed cause" as NonEmptyStr
      }
  }
}

fn secret_credential_fetch_refusal_reason(fetch: SecretCredentialFetch) -> NonEmptyStr {
  match fetch {
    SecretCredentialAccessUpsertRequired { plan: plan } =>
      access_token_upsert_required_reason(plan: plan) as NonEmptyStr
    SecretCredentialFetchRefused { reason: reason } => reason
    SecretCredentialResolvedVersionMismatch { requested: requested, resolved: resolved } =>
      concat(concat("the fetch asked for ", requested), concat(" and the service answered about ", resolved)) as NonEmptyStr
    SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      secret_credential_wire_decode_refusal_reason(
        identity_cause: identity_cause,
        payload_cause: payload_cause,
      )
    SecretCredentialReady { credential: _, resolved_version: _ } =>
      "secret credential fetch reported ready while mapping refusal" as NonEmptyStr
  }
}

func resolve_spark_administrator_credential(
  host: HostIdentity,
  token_source: AccessTokenSource,
) -> SparkAdministratorCredentialResolution
  uses net: Network
{
  match spark_administrator_password_secret_ref_for(host: host) {
    SparkAdministratorCredentialHostNotEnrolled { host: h } =>
      SparkAdministratorCredentialRefused { reason: join(["SparkAdministratorCredentialHostNotEnrolled: ", h as String, " holds no administrator credential version in the roster"], "") as NonEmptyStr }
    SparkAdministratorCredentialRefFound { ref: ref } =>
      match fetch_secret_ref_credential(
        secret_ref: ref,
        token_source: token_source,
      ) {
        SecretCredentialReady { credential: credential, resolved_version: _ } =>
          SparkAdministratorCredentialResolved { credential: credential }
        SecretCredentialResolvedVersionMismatch { requested: requested, resolved: resolved } =>
          SparkAdministratorCredentialRefused {
            reason: concat(concat("the administrator credential fetch asked for ", requested),
              concat(" and the service answered about ", resolved)) as NonEmptyStr,
          }
        SecretCredentialAccessUpsertRequired { plan: plan } =>
          SparkAdministratorCredentialRefused {
            reason: access_token_upsert_required_reason(plan: plan) as NonEmptyStr,
          }
        SecretCredentialFetchRefused { reason: reason } =>
          SparkAdministratorCredentialRefused { reason: reason }
        SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
          SparkAdministratorCredentialRefused {
            reason: secret_credential_wire_decode_refusal_reason(
              identity_cause: identity_cause,
              payload_cause: payload_cause,
            ),
          }
      }
  }
}

// THE ADMINISTRATOR CREDENTIAL IS A FACT OF THE HOST, RESOLVED THROUGH A ROSTER. When the second and
// third Spark batches arrived (2026-09-05) the modeled pin was one SecretRef at version 1, and nothing
// said which hosts it was for; a bootstrap against a host set up with a different password would have
// fetched the wrong secret and refused at sudo, where the cause reads as a host-side authentication
// failure rather than the model's pin. Measured on 2026-09-05: every one of the seven units
// authenticates and sudoes with the version-1 credential, so the roster maps all seven to version 1
// today -- but the roster is per host, its membership is an identity join with the procurement
// roster (witnessed), and a host outside it refuses before any fetch. A future batch with its own
// password is one more version and one roster edit, not a second SecretRef.
type SparkAdministratorCredentialVersion {
  host: HostIdentity
  version: String
}

data spark_administrator_credential_enrolled_version: String = "1"


data spark_administrator_credential_roster: List<SparkAdministratorCredentialVersion> = [
  SparkAdministratorCredentialVersion { host: operator_host_srv5, version: spark_administrator_credential_enrolled_version },
  SparkAdministratorCredentialVersion { host: operator_host_srv6, version: spark_administrator_credential_enrolled_version },
  SparkAdministratorCredentialVersion { host: operator_host_srv7, version: spark_administrator_credential_enrolled_version },
  SparkAdministratorCredentialVersion { host: operator_host_srv8, version: spark_administrator_credential_enrolled_version },
  SparkAdministratorCredentialVersion { host: operator_host_srv9, version: spark_administrator_credential_enrolled_version },
  SparkAdministratorCredentialVersion { host: operator_host_srv10, version: spark_administrator_credential_enrolled_version },
  SparkAdministratorCredentialVersion { host: operator_host_srv11, version: spark_administrator_credential_enrolled_version },
  SparkAdministratorCredentialVersion { host: operator_host_srv12, version: spark_administrator_credential_enrolled_version },
]

type SparkAdministratorCredentialLookup
  = SparkAdministratorCredentialRefFound { ref: SecretRef }
  | SparkAdministratorCredentialHostNotEnrolled { host: HostIdentity }

fn spark_administrator_password_secret_ref_at_version(version: String) -> SecretRef {
  SecretRef {
    project: fleet_secrets_gcp_project,
    secret: "spark-administrator-password" as NonEmptyStr,
    version: version,
    hash_state: HashPending,
  }
}

fn spark_administrator_password_secret_ref_for(host: HostIdentity) -> SparkAdministratorCredentialLookup {
  let rows = filter(spark_administrator_credential_roster, r => (r.host as String) == (host as String))
  match first(rows) {
    Present { value: row } => SparkAdministratorCredentialRefFound { ref: spark_administrator_password_secret_ref_at_version(version: row.version) }
    Absent => SparkAdministratorCredentialHostNotEnrolled { host: host }
  }
}

fn spark_administrator_credential_roster_hosts() -> List<HostIdentity> {
  map(spark_administrator_credential_roster, r => r.host)
}
