module gunbc.spark.credential_workflow


data spark_credential_workflow_note: String = "SECRETREF-WIRE-0: credentials resolve inside the workflow from typed SecretRef rows and gunbc.auth.secret_ref_credential.fetch_secret_ref_credential (wire decoding imported from extdeps.cloud.gcp.secret_manager). Wet entry points name attempt identity and host only — never plaintext administrator passwords or fleet key paths on argv. The spark-administrator-password SecretRef (versions/1) is ON the serving-install critical path: gunbc-automation's sole NOPASSWD grant is EnableLingerForOwnAccount (UserUnitRealization), while SystemUnitRealization still needs WriteSystemUnitFile, ReloadSystemManager, EnableSystemUnit, and InstallRuntimePackage — widening sudoers is itself a privileged effect that requires the administrator credential this lane resolves."

data spark_credential_access_token_frontier_note: String = "AUTH FRONTIER (2026-08-13). HOST SCOPE: GcloudPrintToken is wired for operator-workstation wet runs — local gunbc run and dashboard dispatch on srv1-class hosts where an interactive gcloud user session may exist. It is NOT valid on GHA self-hosted runner slots: those hosts do not carry gcloud, and binding this fetch path there fails at runtime rather than degrading to hand-rolled token fetch. CI fleet-key materialization on runners remains gunbc_ci_fleet_key_agent_script (google_auth_action env) until gunbc.github_actions_wif exists on origin/main as the single federation authority. Operator-token routes are refuted upstream (ACCESS_TOKEN_TYPE_UNSUPPORTED). WIF FRONTIER (present state, not a schedule): gunbc.github_actions_wif is absent from origin/main (measured 2026-08-13); federation rows exist only on origin/session/pi-reach-0, PR #7971 CLOSED 2026-08-07 without merge — dead work, not in flight. Revival onto a live branch versus fresh authoring remains an operator decision; this module does not copy those rows as a private duplicate. Wet resolution refuses when gcloud cannot mint a token on a workstation host."

data spark_administrator_password_secret_ref: extdeps.cloud.gcp.secret_ref.SecretRef = extdeps.cloud.gcp.secret_ref.SecretRef {
  project: gunbc.fleet_secrets_config.fleet_secrets_gcp_project,
  secret: "spark-administrator-password" as std.types.NonEmptyStr,
  version: "1",
  hash_state: extdeps.cloud.gcp.secret_ref.HashPending,
}

data fleet_automation_ssh_privkey_rotation_consumer_id: gunbc.auth.secret_rotation.ConsumerId = "fleet-automation-ssh-key" as gunbc.auth.secret_rotation.ConsumerId

data spark_administrator_password_rotation_consumer_id: gunbc.auth.secret_rotation.ConsumerId = "spark-administrator-password" as gunbc.auth.secret_rotation.ConsumerId

fn consumer_evidence_from_secret_fetch(
  consumer: gunbc.auth.secret_rotation.ConsumerId,
  fetch: gunbc.auth.secret_ref_credential.SecretCredentialFetch,
) -> gunbc.auth.secret_rotation.ConsumerVersionEvidence? {
  match fetch {
    SecretCredentialReady { credential: _, resolved_version: resolved } =>
      Present {
        value: gunbc.auth.secret_rotation.ResolvedVersionObserved {
          consumer: consumer,
          resolved: resolved,
        },
      }
    SecretCredentialAccessUpsertRequired { plan: _ } => Absent
    SecretCredentialFetchRefused { reason: _ } => Absent
    SecretCredentialWireDecodeRefused { identity_cause: _, payload_cause: _ } => Absent
  }
}

func observe_spark_credential_consumer_evidence(
  token_source: gunbc.auth.access_token_source.AccessTokenSource,
) -> List<gunbc.auth.secret_rotation.ConsumerVersionEvidence>
  uses net: std.resources.Network
{
  let privkey_fetch = gunbc.auth.secret_ref_credential.fetch_secret_ref_credential(
    secret_ref: gunbc.fleet_ssh_access.fleet_automation_ssh_privkey_secret,
    token_source: token_source,
  )
  let admin_fetch = gunbc.auth.secret_ref_credential.fetch_secret_ref_credential(
    secret_ref: spark_administrator_password_secret_ref,
    token_source: token_source,
  )
  let privkey_evidence = consumer_evidence_from_secret_fetch(
    consumer: fleet_automation_ssh_privkey_rotation_consumer_id,
    fetch: privkey_fetch,
  )
  let admin_evidence = consumer_evidence_from_secret_fetch(
    consumer: spark_administrator_password_rotation_consumer_id,
    fetch: admin_fetch,
  )
  match privkey_evidence {
    Present { value: privkey_row } =>
      match admin_evidence {
        Present { value: admin_row } => [privkey_row, admin_row]
        Absent => [privkey_row]
      }
    Absent =>
      match admin_evidence {
        Present { value: admin_row } => [admin_row]
        Absent => []
      }
  }
}

fn fleet_ssh_privkey_identity_file_name(attempt: gunbc.fleet_known_hosts_anchor.FleetSshAttemptIdentity) -> std.types.NonEmptyStr {
  join([
    "gunbc-fleet-ssh-attempt-", attempt as String,
    "-privkey",
  ], "") as std.types.NonEmptyStr
}

// The materialized file is verified to hold the declared fleet key BEFORE the body runs. On mismatch
// or derivation refusal the body is never entered, so a wrong secret version is a located refusal
// that contacts no host, rather than an authentication failure discovered against a real machine.
// This is the route that previously asserted the correspondence instead of observing it.
func run_with_materialized_fleet_ssh_binding(
  attempt_raw: String,
  token_source: gunbc.auth.access_token_source.AccessTokenSource,
  body: fn(gunbc.fleet_known_hosts_anchor.FleetSshCredentialBinding) -> std.process.ProcessExit,
) -> std.process.ProcessExit
  uses net: std.resources.Network
{
  match gunbc.fleet_known_hosts_anchor.fleet_ssh_attempt_identity(raw: attempt_raw) {
    Absent =>
      std.process.exit_failure(reason: "attempt identity is not a safe path segment")
    Present { value: attempt } => {
      let identity_file_name = fleet_ssh_privkey_identity_file_name(attempt: attempt)
      match gunbc.auth.secret_ref_credential.fetch_secret_ref_credential(
        secret_ref: gunbc.fleet_ssh_access.fleet_automation_ssh_privkey_secret,
        token_source: token_source,
      ) {
        SecretCredentialReady { credential: privkey, resolved_version: _ } =>
          match gunbc.auth.materialized_secret.with_materialized_ssh_key_file(
            identity_file_name: identity_file_name,
            secret_bytes: privkey,
            use: fn(identity_file) {
              match gunbc.fleet_ssh_credential_verify.verify_fleet_ssh_credential(
                identity_file: identity_file,
                expected_key: gunbc.fleet_ssh_access.fleet_automation_ssh_key,
              ) {
                FleetSshCredentialVerified { binding: binding } => body(binding)
                FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed } =>
                  std.process.exit_failure(
                    reason: gunbc.fleet_ssh_credential_verify.fleet_ssh_credential_verification_refusal_reason(
                      verification: gunbc.fleet_ssh_credential_verify.FleetSshCredentialIdentityMismatch {
                        expected_line: expected,
                        observed_line: observed,
                      },
                    ),
                  )
                FleetSshCredentialDerivationRefused { cause: cause } =>
                  std.process.exit_failure(
                    reason: gunbc.fleet_ssh_credential_verify.fleet_ssh_credential_verification_refusal_reason(
                      verification: gunbc.fleet_ssh_credential_verify.FleetSshCredentialDerivationRefused { cause: cause },
                    ),
                  )
              }
            },
          ) {
            MaterializedSshKeyFileBracketCompleted { value: exit } => exit
            MaterializedSshKeyFileBracketRefused { cause: cause } =>
              std.process.exit_failure(reason: cause as String)
          }
        SecretCredentialAccessUpsertRequired { plan: plan } =>
          std.process.exit_failure(reason: gunbc.auth.access_token_source.access_token_upsert_required_reason(plan: plan) as String)
        SecretCredentialFetchRefused { reason: reason } =>
          std.process.exit_failure(reason: reason as String)
        SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
          std.process.exit_failure(
            reason: secret_credential_wire_decode_refusal_reason(
              identity_cause: identity_cause,
              payload_cause: payload_cause,
            ) as String,
          )
      }
    }
  }
}

type SparkAdministratorCredentialResolution
  = SparkAdministratorCredentialResolved { credential: std.types.Secret }
  | SparkAdministratorCredentialRefused { reason: std.types.NonEmptyStr }

fn sm_resolved_version_identity_refusal_label(cause: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentityRefusal) -> String {
  match cause {
    SmResolvedVersionIdentityEmpty => "resolved version identity empty"
    SmResolvedVersionIdentityMalformed => "resolved version identity malformed"
  }
}

fn sm_access_version_payload_refusal_label(cause: extdeps.cloud.gcp.secret_manager.SmAccessVersionPayloadRefusal) -> String {
  match cause {
    SmAccessVersionPayloadEmpty => "access version payload empty"
    SmAccessVersionPayloadInvalidBase64 => "access version payload invalid base64"
  }
}

fn secret_credential_wire_decode_refusal_reason(
  identity_cause: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentityRefusal?,
  payload_cause: extdeps.cloud.gcp.secret_manager.SmAccessVersionPayloadRefusal?,
) -> std.types.NonEmptyStr {
  match identity_cause {
    Present { value: identity_refusal } =>
      match payload_cause {
        Present { value: payload_refusal } =>
          concat(
            concat(
              sm_resolved_version_identity_refusal_label(cause: identity_refusal),
              "; ",
            ),
            sm_access_version_payload_refusal_label(cause: payload_refusal),
          ) as std.types.NonEmptyStr
        Absent =>
          sm_resolved_version_identity_refusal_label(cause: identity_refusal) as std.types.NonEmptyStr
      }
    Absent =>
      match payload_cause {
        Present { value: payload_refusal } =>
          sm_access_version_payload_refusal_label(cause: payload_refusal) as std.types.NonEmptyStr
        Absent => "secret manager access version wire decode refused without typed cause" as std.types.NonEmptyStr
      }
  }
}

fn secret_credential_fetch_refusal_reason(fetch: gunbc.auth.secret_ref_credential.SecretCredentialFetch) -> std.types.NonEmptyStr {
  match fetch {
    SecretCredentialAccessUpsertRequired { plan: plan } =>
      gunbc.auth.access_token_source.access_token_upsert_required_reason(plan: plan) as std.types.NonEmptyStr
    SecretCredentialFetchRefused { reason: reason } => reason
    SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      secret_credential_wire_decode_refusal_reason(
        identity_cause: identity_cause,
        payload_cause: payload_cause,
      )
    SecretCredentialReady { credential: _, resolved_version: _ } =>
      "secret credential fetch reported ready while mapping refusal" as std.types.NonEmptyStr
  }
}

func resolve_spark_administrator_credential(
  token_source: gunbc.auth.access_token_source.AccessTokenSource,
) -> gunbc.spark_credential_workflow.SparkAdministratorCredentialResolution
  uses net: std.resources.Network
{
  match gunbc.auth.secret_ref_credential.fetch_secret_ref_credential(
    secret_ref: spark_administrator_password_secret_ref,
    token_source: token_source,
  ) {
    SecretCredentialReady { credential: credential, resolved_version: _ } =>
      SparkAdministratorCredentialResolved { credential: credential }
    SecretCredentialAccessUpsertRequired { plan: plan } =>
      SparkAdministratorCredentialRefused {
        reason: gunbc.auth.access_token_source.access_token_upsert_required_reason(plan: plan) as std.types.NonEmptyStr,
      }
    SecretCredentialFetchRefused { reason: reason } =>
      SparkAdministratorCredentialRefused { reason: reason }
    SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      SparkAdministratorCredentialRefused {
        reason: secret_credential_wire_decode_refusal_reason(
          identity_cause: identity_cause,
          payload_cause: payload_cause,
        ),
      }
  }
}
