module gunbc.spark.fabric_link_desired

import std.types { String, Bool, List, Int, NonEmptyStr }
import std.measure { ByteSize, byte_size, byte_size_count }
import product.placement_supply { HostIdentity, host_identity_eq }
import extdeps.network.ipv4 {
  Ipv4Address, ipv4_address, render_ipv4_address, render_ipv4_cidr,
  PrefixLength, ipv4_same_network, ipv4_address_eq,
}
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6, operator_host_srv7, operator_host_srv8 }

// THE DESIRED STATE OF THE SPARK FABRIC, AND WHY IT IS DESIRED STATE RATHER THAN A RUNBOOK.
//
// This module exists because of a measured loss, not a preference. The 200 Gb/s RoCE addressing on
// srv5/srv6 was applied at RUNTIME -- `ip` and `nmcli` calls made by hand -- verified working at
// MTU 9000 with a clean 8972-byte jumbo ping, reported as configured, and then destroyed entirely by
// one power cycle. Nothing was on disk to survive it.
//
// The mechanism is specific and is the whole reason the file path below is the subject. These hosts
// run netplan with `renderer: NetworkManager`, and NetworkManager had the fabric NICs as "connected
// (externally)" -- observed, not managed. An `nmcli` write is intercepted by the netplan-NM
// integration and lands a keyfile in /run/NetworkManager/system-connections/, which is TMPFS. The
// durable artifact is the GENERATED /etc/netplan/90-NM-<uuid>.yaml, and only that. So a convergence
// that actuates `nmcli` converges a host into a state that does not survive its next boot, while
// reporting success -- the runtime-observation-read-as-durable-state failure, at the layer that
// makes every serving fact above it unreachable after a reboot.
//
// A RAIL IS THE SUBJECT, NOT AN INTERFACE, and the two ends of one rail must name the SAME
// interface. This is the NVIDIA connect-two-sparks convention and it is load-bearing rather than
// cosmetic: NCCL selects a rail by matching interface to subnet, so the pairing that works for `ping`
// is not the pairing that works for collective traffic.
//
// INTERFACE EQUALITY IS A WITHIN-LINK COMPATIBILITY LAW, NOT AN IDENTITY. This sentence used to say
// the rail's identity WAS the interface name, which was true only while one pair was modeled. Both
// pairs run the same NIC spellings on all four machines, so an interface name selects a link only by
// accident of there being one candidate. Fleet link identity is PAIR PLUS RAIL.
//
// AND PAIR-PLUS-RAIL IS A TYPE, NOT A SPELLING -- the correction this module most needed. An earlier
// head said that same sentence and then carried the identity in a caller-authored `name:
// NonEmptyStr`, with a witness asserting the four literals were pairwise distinct. That is validation
// standing exactly where construction was available, and DESIGN section 5 names the tell: it can be
// satisfied by editing the declaration while the realization still lies. `FabricLinkIdentity { pair,
// rail }` is closed over both axes, so a duplicate is a repeated value of a finite type rather than a
// repeated string, and `spark_fabric_link` answers with a typed lookup that cannot silently serve the
// first of two. The rendered "srv5-srv6-rail0" is DERIVED from the identity, never its authority.
//
// The consequence is for consumers rather than for this file: anything binding to a rail -- the vLLM
// or Ray adapter selecting the srv6 front door, for instance -- must resolve the link THROUGH
// `spark_fabric_link(identity:)` and take its endpoint on that host via `fabric_endpoint_on`. That
// names an operation that exists; the previous head said "resolve the named link" while the module
// contained no resolving operation at all, which is a sentence asserting an enforcement no operation
// can produce. Not by interface name, not by position in the roster, and not by the
// literal address. An observed `VLLM_HOST_IP` equal to that endpoint's address is corroboration that
// the binding is right; it is never the authority that selects it.
//
// This module first shipped the opposite rule, on a peer session's report that the names were
// CROSSED between hosts, and both of us then read it back off the durable files and found they are
// not: enp1s0f0np0 carries 192.168.100.x on both, enP2p1s0f0np0 carries 192.168.101.x on both. The
// crossed configuration had been applied by hand, passed a jumbo ping, and was wrong anyway -- which
// is exactly why the same-name rule is a CONSTRUCTOR condition here and not a comment. A rail whose
// two ends name different interfaces cannot be built.
//
// The two rails are two RoCE devices -- rocep1s0f0 and roceP2p1s0f0, both reported Up by
// ibdev2netdev on both hosts, with their f1 siblings Down. WHAT IS NOT ESTABLISHED, and is recorded
// here rather than assumed either way: whether those are two physical cables or two logical views of
// one QSFP port. A jumbo ping on each rail passes in both cases, so the reachability evidence cannot
// distinguish them. It does not affect addressing, which is what this module owns; it does bound any
// future claim about aggregate fabric bandwidth, and such a claim needs its own instrument.
// THE TWO IDENTITY AXES, CLOSED. A pair is two machines cabled to each other; a rail is which of the
// two RoCE devices carries the link. Both are closed because the fleet is: a third pair is a row
// added here, and adding it makes every match over these types fail to compile until the new case is
// answered -- the census DESIGN section 5 asks for, rather than a default arm that absorbs it.
type SparkFabricPair = Srv5Srv6 | Srv7Srv8

type SparkFabricRail = Rail0 | Rail1

// AND THE IDENTITY IS THEIR PRODUCT. Two links are the same link exactly when both axes agree, which
// is decided by construction rather than asserted over spellings.
type FabricLinkIdentity sole_constructor {
  pair: SparkFabricPair
  rail: SparkFabricRail
}

fn fabric_link_identity(pair: SparkFabricPair, rail: SparkFabricRail) -> FabricLinkIdentity {
  FabricLinkIdentity { pair: pair, rail: rail }
}

fn spark_fabric_pair_eq(a: SparkFabricPair, b: SparkFabricPair) -> Bool {
  match a {
    Srv5Srv6 => match b { Srv5Srv6 => true, Srv7Srv8 => false }
    Srv7Srv8 => match b { Srv5Srv6 => false, Srv7Srv8 => true }
  }
}

fn spark_fabric_rail_eq(a: SparkFabricRail, b: SparkFabricRail) -> Bool {
  match a {
    Rail0 => match b { Rail0 => true, Rail1 => false }
    Rail1 => match b { Rail0 => false, Rail1 => true }
  }
}

fn fabric_link_identity_eq(a: FabricLinkIdentity, b: FabricLinkIdentity) -> Bool {
  spark_fabric_pair_eq(a: a.pair, b: b.pair) && spark_fabric_rail_eq(a: a.rail, b: b.rail)
}

// THE HOSTS A PAIR NAMES, which is what makes the identity more than a label: the constructor refuses
// a link whose endpoints do not inhabit the pair its identity claims, so `Srv5Srv6` plus `Rail0`
// cannot be made to wrap srv7/srv8 endpoints.
fn spark_fabric_pair_hosts(pair: SparkFabricPair) -> List<HostIdentity> {
  match pair {
    Srv5Srv6 => [operator_host_srv5, operator_host_srv6]
    Srv7Srv8 => [operator_host_srv7, operator_host_srv8]
  }
}

// A RENDERING, DERIVED. The netplan and NM surfaces want a string; that string is a projection of the
// identity and is read back by nothing here.
fn render_spark_fabric_pair(pair: SparkFabricPair) -> String {
  match pair { Srv5Srv6 => "srv5-srv6", Srv7Srv8 => "srv7-srv8" }
}

fn render_spark_fabric_rail(rail: SparkFabricRail) -> String {
  match rail { Rail0 => "rail0", Rail1 => "rail1" }
}

fn render_fabric_link_identity(identity: FabricLinkIdentity) -> String {
  render_spark_fabric_pair(pair: identity.pair) + "-" + render_spark_fabric_rail(rail: identity.rail)
}

type FabricEndpoint sole_constructor {
  host: HostIdentity
  interface: NonEmptyStr
  address: Ipv4Address
  prefix: PrefixLength
  mtu: ByteSize
}

// A RAIL THAT COULD NOT CARRY COLLECTIVE TRAFFIC HAS NO CONSTRUCTOR. Five conditions decide it, and
// every one of them was a real way to get this wrong by hand on these two hosts:
//
//   - the endpoints must be on DIFFERENT HOSTS. A rail from a host to itself is a typo that reads as
//     a configured fabric.
//   - they must name the SAME INTERFACE. Crossing them survives a ping and breaks rail selection,
//     which is the failure that is expensive precisely because it tests green.
//   - they must share a NETWORK at the declared prefix. Two ends on unrelated subnets are up,
//     carrier-present and unreachable, which gets diagnosed as a cabling fault.
//   - they must be DIFFERENT ADDRESSES. Identical ends is the copy-paste error.
//   - they must agree on MTU. A 9000/1500 mismatch does not fail until a jumbo frame meets the small
//     end and is silently dropped -- no error anywhere, just collectives that stall.
//
// The prefix must also be one `ipv4_same_network` can answer for; an unanswerable prefix refuses
// rather than being assumed to match, because "I could not check" is not "it is fine".
type FabricLink sole_constructor {
  identity: FabricLinkIdentity
  endpoint_a: FabricEndpoint
  endpoint_b: FabricEndpoint
}

// A SIXTH CONDITION, AND IT IS THE ONE THAT MAKES THE IDENTITY LOAD-BEARING RATHER THAN DECORATIVE:
// the endpoints must inhabit the pair the identity names. Without it `Srv5Srv6` plus `Rail0` could
// wrap srv7/srv8 endpoints, and the identity would be a label the constructor never checked -- a
// field carried and never examined, which is the exact class the sibling failure-mode row names.
fn fabric_endpoints_inhabit_pair(
  pair: SparkFabricPair,
  endpoint_a: FabricEndpoint,
  endpoint_b: FabricEndpoint,
) -> Bool {
  any(spark_fabric_pair_hosts(pair: pair), h => host_identity_eq(a: h, b: endpoint_a.host))
    && any(spark_fabric_pair_hosts(pair: pair), h => host_identity_eq(a: h, b: endpoint_b.host))
}

fn fabric_link(
  identity: FabricLinkIdentity,
  endpoint_a: FabricEndpoint,
  endpoint_b: FabricEndpoint,
) -> FabricLink? {
  if host_identity_eq(a: endpoint_a.host, b: endpoint_b.host) {
    none
  } else if !fabric_endpoints_inhabit_pair(
      pair: identity.pair, endpoint_a: endpoint_a, endpoint_b: endpoint_b) {
    none
  } else if (endpoint_a.interface as String) != (endpoint_b.interface as String) {
    none
  } else if ipv4_address_eq(a: endpoint_a.address, b: endpoint_b.address) {
    none
  } else if endpoint_a.prefix != endpoint_b.prefix {
    none
  } else if byte_size_count(b: endpoint_a.mtu) != byte_size_count(b: endpoint_b.mtu) {
    none
  } else {
    match ipv4_same_network(
      a: endpoint_a.address, b: endpoint_b.address, prefix: endpoint_a.prefix) {
      Absent => none
      Present { value: shared } =>
        if shared {
          Present { value: FabricLink {
            identity: identity, endpoint_a: endpoint_a, endpoint_b: endpoint_b } }
        } else {
          none
        }
    }
  }
}

fn fabric_endpoint(
  host: HostIdentity,
  interface: NonEmptyStr,
  address: Ipv4Address,
  prefix: PrefixLength,
  mtu: ByteSize,
) -> FabricEndpoint {
  FabricEndpoint {
    host: host, interface: interface, address: address, prefix: prefix, mtu: mtu }
}

// The endpoint this host owns on this link, or Absent when the link does not touch it. A host that
// is not an end of the link gets no configuration from it -- never a defaulted one.
fn fabric_endpoint_on(link: FabricLink, host: HostIdentity) -> FabricEndpoint? {
  if host_identity_eq(a: link.endpoint_a.host, b: host) {
    Present { value: link.endpoint_a }
  } else if host_identity_eq(a: link.endpoint_b.host, b: host) {
    Present { value: link.endpoint_b }
  } else {
    none
  }
}

// THE LOOKUP, AND WHY IT HAS THREE ARMS RATHER THAN RETURNING AN OPTION.
//
// A `FabricLink?` would collapse two materially different answers into `none` -- "the fleet declares
// no such rail" and "the fleet declares it twice" -- and, worse, the obvious implementation of an
// option-returning lookup takes the FIRST match, which serves one of two duplicates and reports
// success. That is the absorbing fallback DESIGN section 5 forbids: the failure arm widens into a
// plausible answer instead of refusing, and the duplicate that caused it is never surfaced.
//
// So duplication is its own arm and carries its count. This is also what replaces the previous head's
// distinctness WITNESS: uniqueness is now decided where the link is resolved, on every call, rather
// than asserted once over four literals by a test.
type SparkFabricLinkLookup
  = FoundExactlyOne { link: FabricLink }
  | FabricLinkMissing { identity: FabricLinkIdentity }
  | FabricLinkIdentityDuplicated { identity: FabricLinkIdentity, count: Int }

// THE POPULATION IS PART OF THE AUTHORITY, NOT AN ARGUMENT TO IT.
//
// This decision was briefly split into a `spark_fabric_link_from(matches:, identity:)` kernel that
// this function called with the filtered roster. That helper took the population as a PARAMETER and
// trusted it, so a caller supplying a one-element list got `FoundExactlyOne` back without the link
// ever being compared to the requested identity -- `matches: [srv7-srv8 rail0], identity: Srv5Srv6 +
// Rail0` returned the srv7/srv8 link as an exact match.
//
// Adding an equality check inside it would have closed that one mismatch and left the real hole
// open: any caller could still hand in a population of its own choosing and mint the SAME
// `FoundExactlyOne` carrier the canonical fleet lookup returns. The carrier's meaning is "the fleet
// declares exactly one such rail", and that is a claim about `spark_fabric_links()` -- not about
// whatever list the caller had to hand. A parameter that can be varied cannot be the subject the
// answer is about.
//
// The split existed for no reason except that a list PATTERN did not parse and I reached for a
// helper instead of `let`. That is the workaround tell in DESIGN section 5: the obstacle was the
// substrate, the detour was around it, and what it silently bought was a public bypass of the
// module's own authority. `let` was available the whole time.
//
// If an arbitrary-population kernel is ever wanted, it must return a visibly non-canonical
// assessment type. It may not mint this one.
fn spark_fabric_link(identity: FabricLinkIdentity) -> SparkFabricLinkLookup {
  let matches = filter(spark_fabric_links(), l =>
    fabric_link_identity_eq(a: l.identity, b: identity))
  if length(matches) == 1 {
    match matches.first() {
      Present { value: only } => FoundExactlyOne { link: only }
      Absent => FabricLinkMissing { identity: identity }
    }
  } else if length(matches) == 0 {
    FabricLinkMissing { identity: identity }
  } else {
    FabricLinkIdentityDuplicated { identity: identity, count: length(matches) }
  }
}

// AND THE ENDPOINT A HOST OWNS ON A NAMED RAIL, which is the operation the consumer sentence at the
// top of this module actually points at. It threads the lookup's refusals rather than flattening
// them, so an adapter that asks for a rail the fleet does not declare gets a located cause and not a
// missing address it might treat as "not configured yet".
type SparkFabricEndpointAnswer
  = FabricEndpointFound { endpoint: FabricEndpoint }
  | FabricEndpointHostNotOnLink { identity: FabricLinkIdentity, host: HostIdentity }
  | FabricEndpointLinkUnresolved { lookup: SparkFabricLinkLookup }

fn spark_fabric_endpoint(
  identity: FabricLinkIdentity,
  host: HostIdentity,
) -> SparkFabricEndpointAnswer {
  match spark_fabric_link(identity: identity) {
    FoundExactlyOne { link: link } =>
      match fabric_endpoint_on(link: link, host: host) {
        Present { value: e } => FabricEndpointFound { endpoint: e }
        Absent => FabricEndpointHostNotOnLink { identity: identity, host: host }
      }
    other => FabricEndpointLinkUnresolved { lookup: other }
  }
}

// ================= THE MEASURED FABRIC =================
//
// Read back from the durable /etc/netplan/90-NM-*.yaml on BOTH hosts on 2026-09-02 and cross-checked
// against `ip -br -4 addr` and `ibdev2netdev` on each -- not authored from intent, and not taken on
// report. The first version of these rows was authored from a peer session's summary and had the
// subnets crossed and the prefix wrong; re-derive from the files rather than trusting this block.
//
// The addressing follows the NVIDIA connect-two-sparks playbook: rail0 on 192.168.100.0/24, rail1 on
// 192.168.101.0/24, same interface name at both ends of each rail, MTU 9000, IPv6 disabled. The NM
// profile names on the hosts are cx7-rail0 and cx7-rail1.
data fabric_prefix: PrefixLength = 24
// AN MTU IS A BYTE COUNT, so it carries std.measure's ByteSize rather than a bare Int. The scale is
// exactly what a 9000-vs-1500 mismatch turns on, and a bare number leaves it to the reader -- the
// same defect PrefixLength above exists to close for the network half of this record.
data fabric_mtu_bytes: ByteSize = byte_size(count: 9000)

// THE LINK NAME IS FLEET-UNIQUE; THE NM PROFILE ID IS NOT, AND THEY ARE NOT THE SAME FACT.
//
// Both Spark pairs carry NetworkManager profiles literally named `cx7-rail0` and `cx7-rail1` -- the
// connect-two-sparks convention is followed on all four machines, so the spelling recurs. Within one
// host that is legitimate reuse in a distinct scope; across the fleet it is one name for two
// materially different links, which is the meaning-fork §3 forbids.
//
// This was not caught by reading: the witness asserting link names are pairwise distinct went RED
// when the first-pair rows were authored with the on-host spelling. The names below are therefore
// qualified by the pair, and the srv7/srv8 rows were renamed for the same reason rather than left
// as the unqualified spelling that happened to be unique while it was the only pair modeled. No
// consumer reads a link name -- the distinctness witness is its only reader -- so the rename costs
// nothing today and stops the collision being resolved later by whoever hits it second.
//
// The on-host profile id is a per-host actuation detail. When an actuator needs it, it belongs on the
// ENDPOINT beside the interface, not on the link: it is a fact about how one machine spells its own
// configuration, and the two ends are free to disagree about it in a way they may never disagree
// about interface, network or MTU.
data fabric_rail0: FabricLink? = fabric_link(
  identity: fabric_link_identity(pair: Srv7Srv8, rail: Rail0),
  endpoint_a: fabric_endpoint(
    host: operator_host_srv7,
    interface: "enp1s0f0np0" as NonEmptyStr,
    address: ipv4_address(octet1: 192, octet2: 168, octet3: 100, octet4: 10),
    prefix: fabric_prefix, mtu: fabric_mtu_bytes),
  endpoint_b: fabric_endpoint(
    host: operator_host_srv8,
    interface: "enp1s0f0np0" as NonEmptyStr,
    address: ipv4_address(octet1: 192, octet2: 168, octet3: 100, octet4: 11),
    prefix: fabric_prefix, mtu: fabric_mtu_bytes))

data fabric_rail1: FabricLink? = fabric_link(
  identity: fabric_link_identity(pair: Srv7Srv8, rail: Rail1),
  endpoint_a: fabric_endpoint(
    host: operator_host_srv7,
    interface: "enP2p1s0f0np0" as NonEmptyStr,
    address: ipv4_address(octet1: 192, octet2: 168, octet3: 101, octet4: 10),
    prefix: fabric_prefix, mtu: fabric_mtu_bytes),
  endpoint_b: fabric_endpoint(
    host: operator_host_srv8,
    interface: "enP2p1s0f0np0" as NonEmptyStr,
    address: ipv4_address(octet1: 192, octet2: 168, octet3: 101, octet4: 11),
    prefix: fabric_prefix, mtu: fabric_mtu_bytes))

// ================= THE FIRST PAIR (srv5/srv6) =================
//
// Read back on 2026-09-03 from BOTH hosts, the same way and for the same reason as the block above:
// `nmcli -f NAME,DEVICE,FILENAME connection show --active` for the profile and its backing file,
// `nmcli connection show <profile>` for method, addresses, MTU and IPv6, `ip -br -4 addr` for what is
// actually up, and `ibdev2netdev` for the RoCE mapping. Not authored from the launch script that used
// these addresses, and not from any transcript.
//
// DURABILITY WAS THE WHOLE QUESTION HERE, because this is the pair whose hand-applied fabric was
// destroyed by one power cycle. The active profiles are backed by files under
// /run/NetworkManager/system-connections/, which is TMPFS and is exactly the signature of that
// incident -- but it is NOT the same state, and reading it as such would have been the wrong
// conclusion drawn from the right alarm. Each runtime keyfile's UUID corresponds to an
// /etc/netplan/90-NM-<uuid>.yaml that exists on the host: f5304147 and 6598390e on srv6, 03d8c676 and
// f5801522 on srv5, each 486-488 bytes and dated 2026-09-02, distinct from the 716-byte install-time
// wifi profile from 2026-08-08. That is the normal netplan-to-NetworkManager direction -- the durable
// yaml is the source and the /run keyfile is generated from it. In the incident there was no /etc
// counterpart at all, which is what made it runtime-only.
//
// WHAT IS NOT ESTABLISHED: the yaml files are root-only and `sudo` needs a password on a tty, so
// their CONTENT was not read. Durability rests on the uuid correspondence and the timestamps, not on
// having seen the addresses in the durable file. The remaining doubt is settled by one reboot, which
// nobody has authorized and this module does not require -- the honest ceiling is that the durable
// artifact EXISTS for each rail, not that its content was verified to match the running address.
//
// The subnets differ from the second pair -- 102/103 rather than 100/101 -- and the interface names
// are the same on both hosts, which is the rail rule the constructor enforces. Jumbo reachability was
// measured in BOTH directions on BOTH rails at 8972 bytes with DF set, which is what makes MTU 9000
// an observation here rather than a declaration.
data first_pair_fabric_rail0: FabricLink? = fabric_link(
  identity: fabric_link_identity(pair: Srv5Srv6, rail: Rail0),
  endpoint_a: fabric_endpoint(
    host: operator_host_srv6,
    interface: "enp1s0f0np0" as NonEmptyStr,
    address: ipv4_address(octet1: 192, octet2: 168, octet3: 102, octet4: 10),
    prefix: fabric_prefix, mtu: fabric_mtu_bytes),
  endpoint_b: fabric_endpoint(
    host: operator_host_srv5,
    interface: "enp1s0f0np0" as NonEmptyStr,
    address: ipv4_address(octet1: 192, octet2: 168, octet3: 102, octet4: 11),
    prefix: fabric_prefix, mtu: fabric_mtu_bytes))

data first_pair_fabric_rail1: FabricLink? = fabric_link(
  identity: fabric_link_identity(pair: Srv5Srv6, rail: Rail1),
  endpoint_a: fabric_endpoint(
    host: operator_host_srv6,
    interface: "enP2p1s0f0np0" as NonEmptyStr,
    address: ipv4_address(octet1: 192, octet2: 168, octet3: 103, octet4: 10),
    prefix: fabric_prefix, mtu: fabric_mtu_bytes),
  endpoint_b: fabric_endpoint(
    host: operator_host_srv5,
    interface: "enP2p1s0f0np0" as NonEmptyStr,
    address: ipv4_address(octet1: 192, octet2: 168, octet3: 103, octet4: 11),
    prefix: fabric_prefix, mtu: fabric_mtu_bytes))

// The roster is the PRESENT links only. A link whose constructor refused is not a link with a
// problem to be reported later -- it never existed, so nothing downstream can plan from it.
fn spark_fabric_links() -> List<FabricLink> {
  flat_map([fabric_rail0, fabric_rail1, first_pair_fabric_rail0, first_pair_fabric_rail1], l =>
    match l {
      Present { value: v } => [v]
      Absent => []
    })
}

fn spark_fabric_endpoints_on(host: HostIdentity) -> List<FabricEndpoint> {
  flat_map(spark_fabric_links(), l =>
    match fabric_endpoint_on(link: l, host: host) {
      Present { value: e } => [e]
      Absent => []
    })
}
