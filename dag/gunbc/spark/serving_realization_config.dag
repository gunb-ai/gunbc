module gunbc.spark.serving_realization_config

import std.types { String, Bool, Int, List, NonEmptyStr, Timestamp }
import std.measure { TokenCount, PositiveSlotCount, ByteSize }
import product.placement_supply { HostIdentity }
import gunbc.spark.serving_release {
  ServingEngine, OllamaSingleHost, VllmTensorParallel, SparkServingReleaseIdentity,
}

// A SERVING CONFIGURATION IS A FACT ABOUT ONE REALIZATION, NOT ABOUT THE FLEET.
//
// Until this module, the cell's context window and slot count were two fleet-global rows measured
// on one cell against one build -- spark-a3ee, the IQ2_XXS release, one resident session -- and
// applied to every realization the cell loads. The per-slot memory price is a property of the
// REALIZATION: a build with a compressed cache pays little per slot and one without pays far more,
// and the 2026-09-03 wedge was a 108 GiB IQ3 model inheriting a KV allocation sized for an 86.7 GB
// IQ2 one. The rung drop that recorded this named its own restoration trigger: no realization may be
// served at a configuration it has not been observed at, AND the fleet-global default must stop
// conferring admission automatically. This module is both halves.
//
// THE KEY CARRIES THE ENGINE. A release identity names runtime and model bytes; it does not say
// whether they are served by one ollama process or a tensor-parallel group, and those have different
// memory shapes on the same bytes. An observation taken under one engine is not evidence for the
// other, so an admission keyed on release alone would let a vLLM launch inherit an ollama reading.
type ServingRealizationKey {
  release_identity: SparkServingReleaseIdentity
  engine: ServingEngine
}

type ServingRealizationConfig {
  default_context: TokenCount
  serving_slots: PositiveSlotCount
}

// AN OBSERVATION CANNOT BE AUTHORED WITHOUT ITS EVIDENCE. sole_constructor: the row exists only
// with the residency the instrument actually read -- what the runner held in memory and what window
// it reported -- on a named cell at a named time. A config with no reading beside it has no
// representation here, which is what makes the empty table below an honest statement rather than a
// placeholder.
type ServingConfigObservation sole_constructor {
  key: ServingRealizationKey
  config: ServingRealizationConfig
  resident_vram: ByteSize
  resident_context: TokenCount
  cell: HostIdentity
  observed_at: Timestamp
}

fn serving_config_observation(
  key: ServingRealizationKey,
  config: ServingRealizationConfig,
  resident_vram: ByteSize,
  resident_context: TokenCount,
  cell: HostIdentity,
  observed_at: Timestamp,
) -> ServingConfigObservation {
  ServingConfigObservation {
    key: key, config: config, resident_vram: resident_vram, resident_context: resident_context,
    cell: cell, observed_at: observed_at,
  }
}

// THE TABLE IS EMPTY, AND THE EMPTINESS IS THE FINDING. The one cell this fleet ever measured was
// read by gunbc.spark.serving_observe spark_serving_observe_ci_wet and cited in prose; the figures
// were never stored as a row, and the resolution carrier holds model-identity attestations, not
// residency. Seeding a row from a number recalled from a log would be the fabricated-plausible-
// output failure applied to the exact fact this module exists to make honest. So every realization
// refuses until an observation is recorded through the instrument -- including the live vLLM
// tensor-parallel pair, which has never been measured at all. Convergence stopping there is the
// line stopping on a deficit, which is what a line is for. Operator ruling, 2026-09-04: land it
// with the line stopped.
data spark_serving_config_observations: List<ServingConfigObservation> = []

type ServingConfigAdmission
  = ConfigAdmitted { config: ServingRealizationConfig, observation: ServingConfigObservation }
  | ConfigRefusedUnobserved { key: ServingRealizationKey }

fn serving_engine_eq(a: ServingEngine, b: ServingEngine) -> Bool {
  match a {
    OllamaSingleHost => match b { OllamaSingleHost => true  VllmTensorParallel { world_size: _ } => false }
    VllmTensorParallel { world_size: n } =>
      match b { OllamaSingleHost => false  VllmTensorParallel { world_size: m } => n == m }
  }
}

fn serving_realization_key_eq(a: ServingRealizationKey, b: ServingRealizationKey) -> Bool {
  (a.release_identity.digest.digest as String) == (b.release_identity.digest.digest as String)
    && serving_engine_eq(a: a.engine, b: b.engine)
}

// NO DEFAULT ARM. A key with no observation is refused, and the refusal carries the key so the
// operator's next action -- take the reading for THIS realization -- is named rather than implied.
// This is the second half of the trigger: inheritance is what made an unmeasured model's admission
// silent, and the only way to end it is for the lookup to have no arm that answers without a row.
fn serving_config_admission(key: ServingRealizationKey) -> ServingConfigAdmission {
  match (spark_serving_config_observations |> filter(o => serving_realization_key_eq(a: o.key, b: key))).first() {
    Absent => ConfigRefusedUnobserved { key: key }
    Present { value: o } => ConfigAdmitted { config: o.config, observation: o }
  }
}

fn serving_engine_label(e: ServingEngine) -> String {
  match e {
    OllamaSingleHost => "ollama single-host"
    VllmTensorParallel { world_size: n } => join(["vllm tensor-parallel world_size=", to_string(value: n)], "")
  }
}

fn serving_config_refusal_text(key: ServingRealizationKey) -> NonEmptyStr {
  join([
    "no runner-memory observation exists for release ", key.release_identity.digest.digest as String,
    " under ", serving_engine_label(e: key.engine),
    "; a realization is not served at a configuration it has not been observed at -- record one with",
    " spark_serving_observe_ci_wet before this fleet can converge",
  ], "") as NonEmptyStr
}
