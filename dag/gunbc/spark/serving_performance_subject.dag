module gunbc.spark.serving_performance_subject

import std.types { Bool, String, NonEmptyStr, List }
import std.optional { Present, Absent }
import std.nat { Nat }
import std.measure { TokenCount, token_count, token_count_value, Watt, watt_count }
import std.content_hash { ContentHash, content_hash_of_value, serialize_content_hash }
import extdeps.vllm.engine_args {
  VllmKvCacheDtypeRequest, vllm_kv_cache_dtype_wire, VllmSpeculativePolicy, vllm_speculative_policy_wire, SpeculativeDecodingOff,
  VllmIndexerKvDtypeRequest, vllm_indexer_kv_dtype_key, VllmSchedulerAdmissionRequest, vllm_scheduler_admission_key,
}
import extdeps.nvidia.nccl { NcclRealizedTransport, nccl_realized_transport_wire }
import extdeps.docker.create_spec { DockerEnvAssignment }
import extdeps.storage.types { PcieLink, pcie_generation_wire }
import extdeps.gpu.types { GpuModelCatalogRow, gpu_catalog_row_eq }
import extdeps.ninfer.ninfer_serve {
  NinferKvDtype, NinferSpeculation, ninfer_kv_dtype_wire, ninfer_speculation_wire,
}
import gunbc.spark.serving_arm {
  ServingCheckpoint, ServingRuntime, ServingTopology,
  serving_checkpoint_wire, serving_runtime_wire, serving_topology_wire,
  ServingLaunchProfile, serving_checkpoint_row, serving_topology_rank_count, serving_launch_profile_key, serving_deployment_env_key,
  QuantizationSpelledOnArgv, QuantizationResolvedFromCheckpointConfig,
}

// ── A PERFORMANCE MEASUREMENT NAMES THE PROFILE IT WAS TAKEN AGAINST, OR IT IS NOT A MEASUREMENT ─
//
// WHY THIS TYPE EXISTS, AND WHO ASKED FOR IT. Two modules carry every serving performance number
// this repository has -- retired gunbc.spark.prefill_batch_sweep (deleted #13779) and retired gunbc.spark.tensor_parallel_comparison (deleted #13779)
// -- and BOTH open with the same paragraph: every coefficient expires with the model artifact it was
// taken against, "these rows do not yet carry that subject structurally, and that is a known gap
// rather than an oversight", and the type "belongs with the serving-observation substrate rather
// than beside these measurements, so it is named here as an obligation and deliberately not coined".
// This module is that obligation discharged. It is coined once, here, because coining it twice is
// the fork both modules declined to make.
//
// WHAT THE GAP COSTS WHEN IT IS LEFT OPEN. The rows in those two modules describe
// deepseek-ai/DeepSeek-V4-Flash on the pinned DeepSeek-era image at TP=4 and TP=2 on group A. The
// live question this fleet is now asking is about GLM-5.3-Flash on a community SM121 image at TP=4
// on group B. Every axis differs. With the subject in prose, the only thing standing between a
// decision about GLM and a coefficient measured on DeepSeek is a reader who happens to scroll to
// the top of the file; with the subject in the type, the join refuses and names the axis.
//
// THIS IS THE SAME LAW retired gunbc.spark.vllm_serving_launch (deleted #13779) STATES ONE LEVEL UP, and both modules cite
// it by name. There, three KV readings from one unrendered unit were three incarnations and joining
// them on host and group concluded the fleet's capacity was unstable. Here, two rates from two
// profiles are two subjects, and joining them on "the Sparks" concludes something about hardware
// that is a fact about a checkpoint. A launch identity fences a restart; a profile identity fences
// a model swap. Neither substitutes for the other, and a measurement needs both.
//
// WHAT IS AN AXIS AND WHAT IS NOT. An axis is a property whose change makes a prior number
// inapplicable. A Spark *hostname* is NOT one: the tensor-parallel comparison placed its two TP=2
// launches on different Spark pairs and they agreed to the last bit of logprob, so those boxes are
// interchangeable within a profile and keying on hostnames would refuse joins that are sound.
// CROSS-HOST EQUIVALENCE BASIS (P2): two subjects may join across hosts only when their
// ServingAcceleratorAxis agrees. AcceleratorSparkGb10 is the named Spark-GB10 basis; AcceleratorUnread
// is unknown and does not join a cited realization or GB10. The
// launch is not an axis either -- that is what VllmServingLaunch fences, and a subject that carried it
// could never join two launches of one profile, which is exactly what a repeated arm is.
//
// ENGINE REQUESTS ARE A COPRODUCT. vLLM KV / speculative / indexer / scheduler live inside
// `EngineVllm`. NInfer carries its own request on `EngineNinfer`. A NInfer subject cannot also
// carry a vLLM kv_cache_dtype field. Those four roster axes are not-applicable on NInfer, not
// unread: treating them as unknown made two identical NInfer subjects Incomparable and blocked
// SubjectEstablished.
//
// ACCELERATOR STANDING IS A COPRODUCT TOO. `AcceleratorUnread` is unknown. `AcceleratorSparkGb10`
// is the named Spark-GB10 join basis (two of those still join). `AcceleratorCited` is a catalog
// realization. Overloading `none` as GB10 made a NInfer subject with unread hardware join another
// unread NInfer as the same machine.
// THE EXACT REVISION AND IMAGE REFERENCE ARE FIELDS, NOT DERIVED FROM THE ENUM. An earlier revision
// of this record carried only `checkpoint` and `runtime`, and compared them by their static variant
// wires -- so a REPIN of the image behind `GunbcSparkrunVllmDs4Gb10` kept comparing SameSubject.
// gunbc.spark.serving_arm already refuses that exact move one level up: `runtime_reading_is_current`
// exists because a reading taken inside one digest is not evidence about another. A subject weaker
// than the module it borrows from is not a fence.
type ServingPerformanceSubject sole_constructor {
  checkpoint: ServingCheckpoint
  checkpoint_revision: NonEmptyStr?
  runtime: ServingRuntime
  runtime_image_reference: NonEmptyStr
  topology: ServingTopology?
  rank_population: Nat?
  context_ceiling: TokenCount?
  max_num_batched_tokens: TokenCount
  max_num_seqs: Nat?
  collective_transport: NcclRealizedTransport?
  launch_profile_key: String?
  deployment_env_key: String?
  engine: ServingEngineRequest
  accelerator: ServingAcceleratorAxis
}

// GAP-INTOLERANT BOUNDARY: serving_subject_for_launch still derives Spark vLLM launches from
// ServingLaunchProfile (memory fraction, prefix caching, Engram, modality, both KV dtypes stay in
// launch_profile_key). P2 does not shadow a second subject type.
type ServingEngineRequest
  = EngineVllm {
      kv_cache_dtype: VllmKvCacheDtypeRequest?
      speculative: VllmSpeculativePolicy?
      indexer_kv_dtype: VllmIndexerKvDtypeRequest?
      scheduler_admission: VllmSchedulerAdmissionRequest?
    }
  | EngineNinfer {
      kv_dtype: NinferKvDtype?
      speculation: NinferSpeculation?
      max_concurrency: Nat?
      kv_capacity_auto: Bool?
    }

type ServingAcceleratorAxis
  = AcceleratorUnread
  | AcceleratorSparkGb10
  | AcceleratorCited { realization: ServingAcceleratorRealization }

data serving_accelerator_spark_gb10_wire: NonEmptyStr = "spark-gb10" as NonEmptyStr

type ServingHostLink
  = HostLinkUnread
  | HostLinkNegotiated { link: PcieLink }

type ServingAcceleratorRealization {
  sku: GpuModelCatalogRow
  count: Nat
  host_link: ServingHostLink
  applied_power_limit: Watt?
}

// THE FACTORY IS THE ONLY WAY TO BUILD ONE, which is what `sole_constructor` buys and is the same
// shape retired gunbc.spark.vllm_serving_launch (deleted #13779) uses for VllmServingLaunch. A subject assembled field by
// field in a consumer is a subject whose axis list that consumer decided; assembled here, adding an
// axis breaks every construction site at once rather than leaving the old ones quietly short one
// field.
fn serving_performance_subject(
  checkpoint: ServingCheckpoint,
  checkpoint_revision: NonEmptyStr?,
  runtime: ServingRuntime,
  runtime_image_reference: NonEmptyStr,
  topology: ServingTopology?,
  rank_population: Nat?,
  context_ceiling: TokenCount?,
  max_num_batched_tokens: TokenCount,
  max_num_seqs: Nat?,
  collective_transport: NcclRealizedTransport?,
  launch_profile_key: String?,
  deployment_env_key: String?,
  engine: ServingEngineRequest,
  accelerator: ServingAcceleratorAxis,
) -> ServingPerformanceSubject {
  ServingPerformanceSubject {
    checkpoint: checkpoint,
    checkpoint_revision: checkpoint_revision,
    runtime: runtime,
    runtime_image_reference: runtime_image_reference,
    topology: topology,
    rank_population: rank_population,
    context_ceiling: context_ceiling,
    max_num_batched_tokens: max_num_batched_tokens,
    max_num_seqs: max_num_seqs,
    collective_transport: collective_transport,
    launch_profile_key: launch_profile_key,
    deployment_env_key: deployment_env_key,
    engine: engine,
    accelerator: accelerator,
  }
}

fn serving_engine_vllm(
  kv_cache_dtype: VllmKvCacheDtypeRequest?,
  speculative: VllmSpeculativePolicy?,
  indexer_kv_dtype: VllmIndexerKvDtypeRequest?,
  scheduler_admission: VllmSchedulerAdmissionRequest?,
) -> ServingEngineRequest {
  EngineVllm {
    kv_cache_dtype: kv_cache_dtype,
    speculative: speculative,
    indexer_kv_dtype: indexer_kv_dtype,
    scheduler_admission: scheduler_admission,
  }
}

fn serving_engine_ninfer(
  kv_dtype: NinferKvDtype?,
  speculation: NinferSpeculation?,
  max_concurrency: Nat?,
  kv_capacity_auto: Bool?,
) -> ServingEngineRequest {
  EngineNinfer {
    kv_dtype: kv_dtype,
    speculation: speculation,
    max_concurrency: max_concurrency,
    kv_capacity_auto: kv_capacity_auto,
  }
}

// ── THE SUBJECT OF A LAUNCH IS DERIVED FROM THE PROFILE THAT LAUNCHED ───────────────────────────
//
// THE TWO HAND-BUILT LIVE SUBJECTS THIS REPLACES each filled the axes from a different source -- the
// GLM one from an authored concurrent profile that was not the one running, the V4.1 one from its
// measurement shape -- so a subject could describe a configuration that never ran. Here every launch
// axis is read off the executable profile the launch rendered, the rank population off the topology,
// and the weight quantization off the checkpoint row (see AxisWeightQuantization). What a launch does
// not decide -- the realized transport, the speculative policy observed -- is supplied by the caller
// as a reading, and absent means unread, never a default.
//
// THE WHOLE PROFILE IS PART OF THE IDENTITY (review on #12976): the launch-profile axis carries
// gunbc.spark.serving_arm serving_launch_profile_key -- cold floor, ceiling, memory fraction, prefix
// caching, Engram, modality, scheduler controls and both KV dtypes -- so two launches differing in any of
// them are two subjects, while the named axes stay for diagnostics. SPECULATION IS PART OF THE LAUNCH:
// the profile renders no speculative configuration (retired gunbc.spark.serving_arm_launch (deleted #13779) arm_engine_argv), so a
// launch's speculation is off, known, not unread. Only the realized collective transport is a reading.
fn serving_subject_for_launch(
  checkpoint_revision: NonEmptyStr?,
  runtime: ServingRuntime,
  runtime_image_reference: NonEmptyStr,
  topology: ServingTopology,
  profile: ServingLaunchProfile,
  deployment_env: List<DockerEnvAssignment>,
  collective_transport: NcclRealizedTransport?,
) -> ServingPerformanceSubject {
  serving_performance_subject(
    checkpoint: profile.checkpoint,
    checkpoint_revision: checkpoint_revision,
    runtime: runtime,
    runtime_image_reference: runtime_image_reference,
    topology: Present { value: topology },
    rank_population: Present { value: serving_topology_rank_count(t: topology) },
    context_ceiling: Present { value: profile.max_model_len },
    max_num_batched_tokens: profile.max_num_batched_tokens,
    max_num_seqs: Present { value: profile.max_num_seqs },
    collective_transport: collective_transport,
    launch_profile_key: Present { value: serving_launch_profile_key(p: profile) },
    deployment_env_key: Present { value: serving_deployment_env_key(env: deployment_env) },
    engine: serving_engine_vllm(
      kv_cache_dtype: Present { value: profile.kv_cache_dtype },
      speculative: Present { value: SpeculativeDecodingOff },
      indexer_kv_dtype: Present { value: profile.indexer_kv_dtype },
      scheduler_admission: Present { value: profile.scheduler_admission },
    ),
    accelerator: AcceleratorSparkGb10,
  )
}

// THE WEIGHT QUANTIZATION IS AN AXIS BUT NOT A FIELD: it is a fact about the checkpoint row
// (gunbc.spark.serving_arm ServingCheckpointRow quantization), so storing it beside the checkpoint
// would be a second authority that could disagree with the first. It is compared as its own axis, so
// two subjects that differ in it say so by name; a checkpoint with no row reads as unread.
fn subject_weight_quantization(s: ServingPerformanceSubject) -> NonEmptyStr? {
  match serving_checkpoint_row(c: s.checkpoint) {
    Absent => none
    Present { value: row } =>
      match row.quantization {
        QuantizationSpelledOnArgv { wire: w } => Present { value: w }
        QuantizationResolvedFromCheckpointConfig { wire: w, because: _ } => Present { value: w }
      }
  }
}

// ── THE AXES ARE ENUMERATED SO THE REFUSAL CAN NAME ONE ────────────────────────────────────────
//
// WHY A COPRODUCT AND NOT A LIST OF STRING COMPARISONS INLINE. The refusal has to NAME the axis that
// differs -- a join that answers only "different" sends a reader back to diffing two records by eye,
// which is the work this type exists to do.
//
// WHAT THIS DOES NOT BUY, stated because an earlier version of this paragraph claimed it did: adding
// a FIELD to ServingPerformanceSubject without adding an arm here does NOT fail to compile. The
// exhaustive match in `serving_subject_axis_value` is over ServingSubjectAxis, not over the record's
// fields, so the two can drift apart silently and the comparison simply ignores the new field.
//
// RUNG (DESIGN 4b): field-to-axis coverage is MITIGATION -- the witness asserts the roster is not
// degenerate, and review is what actually catches a missing arm. The attainable ceiling is
// structural: a record whose fields ARE its axes has no spelling for the mismatch. TRIGGER: a way to
// enumerate a record's fields as a value, at which point the roster is DERIVED from the record and
// this whole coproduct dissolves rather than being maintained beside it.
type ServingSubjectAxis
  = AxisCheckpoint
  | AxisCheckpointRevision
  | AxisRuntime
  | AxisRuntimeImageReference
  | AxisTopology
  | AxisRankPopulation
  | AxisContextCeiling
  | AxisBatchBudget
  | AxisMaxNumSeqs
  | AxisKvCacheDtype
  | AxisSpeculativePolicy
  | AxisCollectiveTransport
  | AxisWeightQuantization
  | AxisIndexerKvDtype
  | AxisSchedulerAdmission
  | AxisLaunchProfile
  | AxisDeploymentEnv
  | AxisEngine
  | AxisAccelerator

fn serving_subject_axis_wire(a: ServingSubjectAxis) -> NonEmptyStr {
  match a {
    AxisCheckpoint => "checkpoint" as NonEmptyStr
    AxisCheckpointRevision => "checkpoint revision" as NonEmptyStr
    AxisRuntime => "runtime" as NonEmptyStr
    AxisRuntimeImageReference => "runtime image reference" as NonEmptyStr
    AxisTopology => "topology" as NonEmptyStr
    AxisRankPopulation => "rank population" as NonEmptyStr
    AxisContextCeiling => "context ceiling" as NonEmptyStr
    AxisBatchBudget => "max_num_batched_tokens" as NonEmptyStr
    AxisMaxNumSeqs => "max_num_seqs" as NonEmptyStr
    AxisKvCacheDtype => "kv cache dtype" as NonEmptyStr
    AxisSpeculativePolicy => "speculative policy" as NonEmptyStr
    AxisCollectiveTransport => "collective transport" as NonEmptyStr
    AxisWeightQuantization => "weight quantization" as NonEmptyStr
    AxisIndexerKvDtype => "indexer kv dtype" as NonEmptyStr
    AxisSchedulerAdmission => "scheduler admission" as NonEmptyStr
    AxisLaunchProfile => "launch profile" as NonEmptyStr
    AxisDeploymentEnv => "deployment env" as NonEmptyStr
    AxisEngine => "engine" as NonEmptyStr
    AxisAccelerator => "accelerator" as NonEmptyStr
  }
}

type ServingSubjectAxisReading
  = AxisNotApplicable
  | AxisUnread
  | AxisRead { value: NonEmptyStr }

type VllmRequestAxisReadings {
  kv_cache_dtype: ServingSubjectAxisReading
  speculative: ServingSubjectAxisReading
  indexer_kv_dtype: ServingSubjectAxisReading
  scheduler_admission: ServingSubjectAxisReading
}

fn axis_optional_reading(v: NonEmptyStr?) -> ServingSubjectAxisReading {
  match v {
    Absent => AxisUnread
    Present { value: x } => AxisRead { value: x }
  }
}

fn axis_optional_nat_reading(v: Nat?) -> ServingSubjectAxisReading {
  match v {
    Absent => AxisUnread
    Present { value: n } => AxisRead { value: to_string(n) as NonEmptyStr }
  }
}

fn axis_optional_string_reading(v: String?) -> ServingSubjectAxisReading {
  match v {
    Absent => AxisUnread
    Present { value: k } => AxisRead { value: k as NonEmptyStr }
  }
}

fn vllm_request_axis_readings(e: ServingEngineRequest) -> VllmRequestAxisReadings {
  match e {
    EngineNinfer { kv_dtype: _, speculation: _, max_concurrency: _, kv_capacity_auto: _ } =>
      VllmRequestAxisReadings {
        kv_cache_dtype: AxisNotApplicable,
        speculative: AxisNotApplicable,
        indexer_kv_dtype: AxisNotApplicable,
        scheduler_admission: AxisNotApplicable,
      }
    EngineVllm { kv_cache_dtype: kv, speculative: sp, indexer_kv_dtype: ix, scheduler_admission: ad } =>
      VllmRequestAxisReadings {
        kv_cache_dtype: match kv {
          Absent => AxisUnread
          Present { value: d } => AxisRead { value: vllm_kv_cache_dtype_wire(request: d) }
        },
        speculative: match sp {
          Absent => AxisUnread
          Present { value: p } => AxisRead { value: vllm_speculative_policy_wire(p: p) }
        },
        indexer_kv_dtype: match ix {
          Absent => AxisUnread
          Present { value: d } => AxisRead { value: vllm_indexer_kv_dtype_key(r: d) as NonEmptyStr }
        },
        scheduler_admission: match ad {
          Absent => AxisUnread
          Present { value: a } => AxisRead { value: vllm_scheduler_admission_key(r: a) as NonEmptyStr }
        },
      }
  }
}

fn engine_axis_reading(e: ServingEngineRequest) -> ServingSubjectAxisReading {
  match e {
    EngineVllm { kv_cache_dtype: _, speculative: _, indexer_kv_dtype: _, scheduler_admission: _ } =>
      AxisRead { value: serving_engine_request_wire(e: e) }
    EngineNinfer { kv_dtype: kv, speculation: sp, max_concurrency: c, kv_capacity_auto: auto } =>
      match kv {
        Absent => AxisUnread
        Present { value: _ } => match sp {
          Absent => AxisUnread
          Present { value: _ } => match c {
            Absent => AxisUnread
            Present { value: _ } => match auto {
              Absent => AxisUnread
              Present { value: _ } => AxisRead { value: serving_engine_request_wire(e: e) }
            }
          }
        }
      }
  }
}

fn accelerator_axis_reading(a: ServingAcceleratorAxis) -> ServingSubjectAxisReading {
  match a {
    AcceleratorUnread => AxisUnread
    AcceleratorSparkGb10 => AxisRead { value: serving_accelerator_spark_gb10_wire }
    AcceleratorCited { realization: r } =>
      match r.host_link {
        HostLinkUnread => AxisUnread
        HostLinkNegotiated { link: _ } =>
          match r.applied_power_limit {
            Absent => AxisUnread
            Present { value: _ } => AxisRead { value: serving_accelerator_realization_wire(a: r) }
          }
      }
  }
}

// EVERY AXIS PROJECTS THROUGH ONE THREE-WAY READING. Not-applicable vs unread vs a value is decided
// once (the four vLLM request axes from one match on ServingEngineRequest). The renderer, the
// unknown-check and the not-applicable check all consume that reading; they do not restate the engine
// rule. Comparison stays over the rendered projection for ordinary axes.
fn serving_subject_axis_reading(s: ServingPerformanceSubject, a: ServingSubjectAxis) -> ServingSubjectAxisReading {
  let vllm = vllm_request_axis_readings(e: s.engine)
  match a {
    AxisCheckpoint => AxisRead { value: serving_checkpoint_wire(c: s.checkpoint) }
    AxisCheckpointRevision => axis_optional_reading(v: s.checkpoint_revision)
    AxisRuntime => AxisRead { value: serving_runtime_wire(r: s.runtime) }
    AxisRuntimeImageReference => AxisRead { value: s.runtime_image_reference }
    AxisTopology =>
      match s.topology {
        Absent => AxisUnread
        Present { value: t } => AxisRead { value: serving_topology_wire(t: t) }
      }
    AxisRankPopulation => axis_optional_nat_reading(v: s.rank_population)
    AxisContextCeiling =>
      match s.context_ceiling {
        Absent => AxisUnread
        Present { value: c } => AxisRead { value: to_string(token_count_value(t: c)) as NonEmptyStr }
      }
    AxisBatchBudget => AxisRead { value: to_string(token_count_value(t: s.max_num_batched_tokens)) as NonEmptyStr }
    AxisMaxNumSeqs => axis_optional_nat_reading(v: s.max_num_seqs)
    AxisKvCacheDtype => vllm.kv_cache_dtype
    AxisSpeculativePolicy => vllm.speculative
    AxisCollectiveTransport =>
      match s.collective_transport {
        Absent => AxisUnread
        Present { value: tr } => AxisRead { value: nccl_realized_transport_wire(t: tr) }
      }
    AxisWeightQuantization => axis_optional_reading(v: subject_weight_quantization(s: s))
    AxisIndexerKvDtype => vllm.indexer_kv_dtype
    AxisSchedulerAdmission => vllm.scheduler_admission
    AxisLaunchProfile => axis_optional_string_reading(v: s.launch_profile_key)
    AxisDeploymentEnv => axis_optional_string_reading(v: s.deployment_env_key)
    AxisEngine => engine_axis_reading(e: s.engine)
    AxisAccelerator => accelerator_axis_reading(a: s.accelerator)
  }
}

fn serving_subject_axis_value(s: ServingPerformanceSubject, a: ServingSubjectAxis) -> NonEmptyStr {
  match serving_subject_axis_reading(s: s, a: a) {
    AxisNotApplicable => axis_value_not_applicable_marker
    AxisUnread => axis_value_unread_marker
    AxisRead { value: v } => v
  }
}

fn serving_engine_request_wire(e: ServingEngineRequest) -> NonEmptyStr {
  match e {
    EngineVllm { kv_cache_dtype: _, speculative: _, indexer_kv_dtype: _, scheduler_admission: _ } =>
      "engine-vllm" as NonEmptyStr
    EngineNinfer { kv_dtype: kv, speculation: sp, max_concurrency: c, kv_capacity_auto: auto } =>
      join([
        "engine-ninfer|kv=",
        match kv {
          Absent => "<unread>"
          Present { value: d } => ninfer_kv_dtype_wire(d: d) as String
        },
        "|spec=",
        match sp {
          Absent => "<unread>"
          Present { value: s } => ninfer_speculation_wire(s: s) as String
        },
        "|conc=",
        match c {
          Absent => "<unread>"
          Present { value: n } => to_string(n)
        },
        "|auto=",
        match auto {
          Absent => "<unread>"
          Present { value: b } => if b { "1" } else { "0" }
        },
      ], "") as NonEmptyStr
  }
}

fn serving_host_link_wire(h: ServingHostLink) -> String {
  match h {
    HostLinkUnread => "link-unread"
    HostLinkNegotiated { link: l } => join(["link-", pcie_generation_wire(g: l.generation), "x", to_string(l.lane_count)], "")
  }
}

fn serving_accelerator_realization_wire(a: ServingAcceleratorRealization) -> NonEmptyStr {
  join([
    a.sku.vendor.legal_name as String,
    "|", a.sku.model as String,
    "|n=", to_string(a.count),
    "|", serving_host_link_wire(h: a.host_link),
    "|w=",
    match a.applied_power_limit {
      Absent => "<unread>"
      Present { value: w } => to_string(watt_count(w: w))
    },
  ], "") as NonEmptyStr
}

fn serving_accelerator_realization(
  sku: GpuModelCatalogRow,
  count: Nat,
  host_link: ServingHostLink,
  applied_power_limit: Watt?,
) -> ServingAcceleratorRealization {
  ServingAcceleratorRealization {
    sku: sku,
    count: count,
    host_link: host_link,
    applied_power_limit: applied_power_limit,
  }
}

// THE ROSTER IS THE POPULATION THE JOIN FOLDS, and it is declared once so a consumer cannot join on
// a subset of the axes by passing a shorter list.
data serving_subject_axes: List<ServingSubjectAxis> = [
  AxisCheckpoint,
  AxisCheckpointRevision,
  AxisRuntime,
  AxisRuntimeImageReference,
  AxisTopology,
  AxisRankPopulation,
  AxisContextCeiling,
  AxisBatchBudget,
  AxisMaxNumSeqs,
  AxisKvCacheDtype,
  AxisSpeculativePolicy,
  AxisCollectiveTransport,
  AxisWeightQuantization,
  AxisIndexerKvDtype,
  AxisSchedulerAdmission,
  AxisLaunchProfile,
  AxisDeploymentEnv,
  AxisEngine,
  AxisAccelerator,
]

fn serving_subject_axis_agrees(left: ServingPerformanceSubject, right: ServingPerformanceSubject, a: ServingSubjectAxis) -> Bool {
  (serving_subject_axis_value(s: left, a: a) as String)
    == (serving_subject_axis_value(s: right, a: a) as String)
}

fn serving_subject_differing_axes(left: ServingPerformanceSubject, right: ServingPerformanceSubject) -> List<ServingSubjectAxis> {
  filter(serving_subject_axes, a => !serving_subject_axis_agrees(left: left, right: right, a: a))
}

// MEMBERSHIP IS ASKED OF THE LIST, NOT OF ITS RENDERING. The delta arms carry
// List<ServingSubjectAxis> rather than a joined wire because the parts are modelled axes in this
// module and flattening them to a String is DESIGN section 2's anemic leaf -- "a String leaf hiding
// named parts". The cost showed up immediately in this change's own witness, which could only ask
// `(u as String).contains("collective transport")`: a stringly read of a closed variant set that
// keeps passing if an axis wire spelling ever changes. `serving_subject_axes_wire` stays, for
// PRESENTATION only.
fn serving_subject_axis_list_contains(axes: List<ServingSubjectAxis>, a: ServingSubjectAxis) -> Bool {
  length(filter(axes, x => (serving_subject_axis_wire(a: x) as String) == (serving_subject_axis_wire(a: a) as String))) > 0
}

fn serving_subject_axes_wire(axes: List<ServingSubjectAxis>) -> String {
  join(map(axes, a => serving_subject_axis_wire(a: a) as String), ", ")
}

// THE MARKERS ARE FOR RENDERING AND ARE NEVER COMPARED. `serving_subject_known_differing_axes`
// excludes every axis that is unknown OR not-applicable on either side before a string comparison
// can decide agreement, so neither `<unread>` nor `<not-applicable>` can mint a known difference
// the way the old `<transport-unread>` sentinel could. They exist only so a rendered subject line
// shows which axes were never read, or do not apply to this engine.
data axis_value_unread_marker: NonEmptyStr = "<unread>" as NonEmptyStr
data axis_value_not_applicable_marker: NonEmptyStr = "<not-applicable>" as NonEmptyStr

// ── AN AXIS CAN BE UNKNOWN, AND AN UNKNOWN AXIS MUST NOT ERASE A KNOWN MISMATCH ───────────────
//
// Two axes carry their own "nobody looked" arm: the collective transport and the speculative
// policy. An earlier revision of this module let either one short-circuit the whole join to
// Incomparable BEFORE comparing anything, and that was wrong in the expensive direction: two
// subjects on DIFFERENT CHECKPOINTS whose transport nobody read came back "I cannot tell", when the
// checkpoint difference alone already settles that the measurement does not transfer. Destroying an
// established counterexample because a different axis is unknown is the absorbing fallback pointed
// at the answer instead of the ignorance.
//
// SO KNOWN DIFFERENCES ARE COMPUTED FIRST AND WIN. Incomparable is reserved for the case where every
// axis anyone READ agrees and something material was never read -- which is the only situation where
// the answer genuinely turns on the missing evidence.
fn subject_unknown_axes(s: ServingPerformanceSubject) -> List<ServingSubjectAxis> {
  filter(serving_subject_axes, a => subject_axis_is_unknown(s: s, a: a))
}

fn subject_axis_is_unknown(s: ServingPerformanceSubject, a: ServingSubjectAxis) -> Bool {
  match serving_subject_axis_reading(s: s, a: a) {
    AxisUnread => true
    AxisNotApplicable => false
    AxisRead { value: _ } => false
  }
}

fn either_side_unknown_axes(left: ServingPerformanceSubject, right: ServingPerformanceSubject) -> List<ServingSubjectAxis> {
  filter(serving_subject_axes, a => subject_axis_is_unknown(s: left, a: a) || subject_axis_is_unknown(s: right, a: a))
}

// BOTH SIDES READ A T, AND THE Ts DISAGREE. Absent is unread nested evidence, not a mismatch.
// Compared by inhabitance equality of T; a wire is a renderer and is not this question.
fn both_read_unequal<T>(left: Optional<T>, right: Optional<T>) -> Bool {
  match left {
    Absent => false
    Present { value: a } =>
      match right {
        Absent => false
        Present { value: b } => a != b
      }
  }
}

fn engine_known_parts_differ(left: ServingEngineRequest, right: ServingEngineRequest) -> Bool {
  match left {
    EngineVllm { kv_cache_dtype: _, speculative: _, indexer_kv_dtype: _, scheduler_admission: _ } =>
      match right {
        EngineVllm { kv_cache_dtype: _, speculative: _, indexer_kv_dtype: _, scheduler_admission: _ } => false
        EngineNinfer { kv_dtype: _, speculation: _, max_concurrency: _, kv_capacity_auto: _ } => true
      }
    EngineNinfer { kv_dtype: kv, speculation: sp, max_concurrency: c, kv_capacity_auto: auto } =>
      match right {
        EngineVllm { kv_cache_dtype: _, speculative: _, indexer_kv_dtype: _, scheduler_admission: _ } => true
        EngineNinfer { kv_dtype: kv2, speculation: sp2, max_concurrency: c2, kv_capacity_auto: auto2 } =>
          both_read_unequal(left: kv, right: kv2)
            || both_read_unequal(left: sp, right: sp2)
            || both_read_unequal(left: c, right: c2)
            || both_read_unequal(left: auto, right: auto2)
      }
  }
}

fn host_link_known_parts_differ(left: ServingHostLink, right: ServingHostLink) -> Bool {
  match left {
    HostLinkUnread => false
    HostLinkNegotiated { link: a } =>
      match right {
        HostLinkUnread => false
        HostLinkNegotiated { link: b } =>
          a.generation != b.generation || a.lane_count != b.lane_count
      }
  }
}

fn accelerator_known_parts_differ(left: ServingAcceleratorAxis, right: ServingAcceleratorAxis) -> Bool {
  match left {
    AcceleratorUnread => false
    AcceleratorSparkGb10 =>
      match right {
        AcceleratorUnread => false
        AcceleratorSparkGb10 => false
        AcceleratorCited { realization: _ } => true
      }
    AcceleratorCited { realization: a } =>
      match right {
        AcceleratorUnread => false
        AcceleratorSparkGb10 => true
        AcceleratorCited { realization: b } =>
          !gpu_catalog_row_eq(a: a.sku, b: b.sku)
            || a.count != b.count
            || host_link_known_parts_differ(left: a.host_link, right: b.host_link)
            || both_read_unequal(left: a.applied_power_limit, right: b.applied_power_limit)
      }
  }
}

fn subject_axis_is_not_applicable(s: ServingPerformanceSubject, a: ServingSubjectAxis) -> Bool {
  match serving_subject_axis_reading(s: s, a: a) {
    AxisNotApplicable => true
    AxisUnread => false
    AxisRead { value: _ } => false
  }
}

fn ordinary_axis_known_parts_differ(left: ServingPerformanceSubject, right: ServingPerformanceSubject, a: ServingSubjectAxis) -> Bool {
  !serving_subject_axis_agrees(left: left, right: right, a: a)
    && !subject_axis_is_unknown(s: left, a: a)
    && !subject_axis_is_unknown(s: right, a: a)
    && !subject_axis_is_not_applicable(s: left, a: a)
    && !subject_axis_is_not_applicable(s: right, a: a)
}

fn subject_axis_known_parts_differ(left: ServingPerformanceSubject, right: ServingPerformanceSubject, a: ServingSubjectAxis) -> Bool {
  match a {
    AxisEngine => engine_known_parts_differ(left: left.engine, right: right.engine)
    AxisAccelerator => accelerator_known_parts_differ(left: left.accelerator, right: right.accelerator)
    AxisCollectiveTransport => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisSpeculativePolicy => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisCheckpoint => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisCheckpointRevision => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisRuntime => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisRuntimeImageReference => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisTopology => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisRankPopulation => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisContextCeiling => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisBatchBudget => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisMaxNumSeqs => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisKvCacheDtype => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisWeightQuantization => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisIndexerKvDtype => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisSchedulerAdmission => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisLaunchProfile => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
    AxisDeploymentEnv => ordinary_axis_known_parts_differ(left: left, right: right, a: a)
  }
}

// A KNOWN DIFFERENCE IS ONE THE READ PORTIONS ALREADY SETTLE. Nested unread on EngineNinfer or
// AcceleratorCited must not drop a variant-tag or SKU mismatch: those were read. Unread vs unread
// sentinels still do not count as a difference (review 78844).
fn serving_subject_known_differing_axes(left: ServingPerformanceSubject, right: ServingPerformanceSubject) -> List<ServingSubjectAxis> {
  filter(serving_subject_axes, a => subject_axis_known_parts_differ(left: left, right: right, a: a))
}

type ServingSubjectJoin
  = SameSubject
  | DifferentSubject { axes: List<ServingSubjectAxis>, left: NonEmptyStr, right: NonEmptyStr }
  | SubjectIncomparable { because: NonEmptyStr }

fn serving_subject_reads(measurement_subject: ServingPerformanceSubject, decision_subject: ServingPerformanceSubject) -> ServingSubjectJoin {
  let known = serving_subject_known_differing_axes(left: measurement_subject, right: decision_subject)
  if length(known) > 0 {
    DifferentSubject {
      axes: known,
      left: serving_performance_subject_wire(s: measurement_subject),
      right: serving_performance_subject_wire(s: decision_subject),
    }
  } else {
    let unknown = either_side_unknown_axes(left: measurement_subject, right: decision_subject)
    if length(unknown) > 0 {
      SubjectIncomparable { because: join([
        "every axis both sides read agrees, and these were never read on at least one side: ",
        serving_subject_axes_wire(axes: unknown),
        ". NCCL falls back to Socket silently and a draft model consumes the same batch budget, so an unread axis is an unknown one and not an agreeing one",
      ], "") as NonEmptyStr }
    } else {
      SameSubject
    }
  }
}

fn serving_performance_subject_wire(s: ServingPerformanceSubject) -> NonEmptyStr {
  join(map(serving_subject_axes, a => serving_subject_axis_value(s: s, a: a) as String), "/") as NonEmptyStr
}

// ── ESTABLISHED MEANS EVERY AXIS WAS READ, AND THE CONSTRUCTOR IS WHAT ENFORCES IT ────────────
//
// WHY THERE ARE TWO ARMS AND NOT THREE, and this is the correction that mattered most in this lane.
// The standing used to have a `SubjectUnestablished { missing, believed, would_settle }` arm that
// carried NO SUBJECT, and the batch-sweep arms -- where most of the fleet's numbers live -- were in
// it. So `standing_subject` answered Absent for them, every join came back "incomparable, subject
// unestablished", and a DeepSeek batch measurement read against a GLM decision never reported the
// CHECKPOINT difference that is the whole point of this type. The module's header claimed the
// subject was now carried structurally; for the primary population it was not.
//
// THE DEFECT WAS UNDER-ASSERTION, WHICH DESIGN SECTION 4d NAMES AS ITS OWN FAILURE: "Do assert what
// you are confident in. Under-asserting is not humility. A fact you decline to state is a wall that
// does not exist." Those arms' checkpoint, revision, runtime, image, budget and KV dtype are all
// stated by the module. Exactly ONE axis was never read -- the tensor-parallel degree -- and
// collapsing to a prose-only Unestablished threw six known axes away to represent one unknown one.
//
// SO EVERY AXIS IS OPTIONAL AND ABSENCE IS UNIFORM. A subject can always be built from what IS
// known; the constructor reads the absences off it and answers Partial, carrying the subject so the
// known axes still fence. There is no longer a state in which a measurement has no subject at all,
// which is why the third arm is gone rather than merely unused.
type ServingPerformanceSubjectStanding
  = SubjectEstablished { subject: ServingPerformanceSubject }
  | SubjectPartial {
      subject: ServingPerformanceSubject,
      unknown_axes: List<ServingSubjectAxis>,
      believed: NonEmptyStr,
      would_settle: NonEmptyStr,
    }

// THE ONLY SANCTIONED WAY TO BUILD A STANDING. It cannot answer Established for a subject with an
// absent axis, because it reads the absences off the subject itself rather than taking the caller's
// word -- so it cannot ANSWER Established for such a subject. That is the sanctioned route being
// closed, not the arm being unspellable: `SubjectEstablished { subject: s }` remains writable by a
// consumer that bypasses this function, which makes the guarantee mechanically preventable rather
// than structural. The ceiling is a module-private Established arm; the trigger is module-private
// coproduct constructors, which `sole_constructor` already gives records.
//
// THE BELIEF AND THE REMEDY RIDE WITH THE PARTIAL because they are facts about THIS row's gap: what
// the author thinks the missing axis probably is, typed as the bet DESIGN section 4d requires rather
// than promoted into the subject, and the one action that would close it.
fn serving_subject_standing(
  subject: ServingPerformanceSubject,
  believed: NonEmptyStr,
  would_settle: NonEmptyStr,
) -> ServingPerformanceSubjectStanding {
  let unknown = subject_unknown_axes(s: subject)
  if length(unknown) == 0 {
    SubjectEstablished { subject: subject }
  } else {
    SubjectPartial {
      subject: subject,
      unknown_axes: unknown,
      believed: believed,
      would_settle: would_settle,
    }
  }
}

fn standing_subject(st: ServingPerformanceSubjectStanding) -> ServingPerformanceSubject {
  match st {
    SubjectEstablished { subject: sub } => sub
    SubjectPartial { subject: sub, unknown_axes: _, believed: _, would_settle: _ } => sub
  }
}

// A STANDING ALWAYS HAS A SUBJECT NOW, so the join is the subject comparison and nothing else. The
// two-step dance the three-arm shape needed -- resolve the standing, then compare -- is gone with
// the arm that made it necessary.
fn serving_subject_standing_reads(
  measurement: ServingPerformanceSubjectStanding,
  decision: ServingPerformanceSubjectStanding,
) -> ServingSubjectJoin {
  serving_subject_reads(
    measurement_subject: standing_subject(st: measurement),
    decision_subject: standing_subject(st: decision))
}

// ── AN AXIS DELTA IS NOT A COMPARABILITY VERDICT, AND THE NAME NOW SAYS SO ─────────────────────
//
// THIS OPERATION WAS CALLED `controlled_comparison` AND THAT NAME CLAIMED SOMETHING IT CANNOT SEE.
// It consumes two subject records and nothing else: no measurements, no workload protocol, no prompt
// or output shape, no concurrency pattern, no launch identity, no instrument, no raw carrier, no
// observation time. What it establishes is exactly "one of the modelled subject axes differs" --
// which is necessary for a controlled cut and nowhere near sufficient. Two observations taken with
// different prompts, different producers, or on different launch incarnations still produce a
// one-axis delta if their subject records differ in one field.
//
// SO IT IS NAMED FOR WHAT IT COMPUTES. A real ServingPerformanceComparison -- shared declared
// protocol, exact producers and carriers, realized launch bindings, preserved-invariant evidence --
// is a different type that does not exist yet, and calling this one by that name would have let a
// reader believe the missing half was already built.
// A ONE-AXIS DELTA REQUIRES THAT EVERY AXIS WAS READ, which an earlier version of this type did not
// require and is the reason the fourth arm exists. `AxisDeltaOnOneAxis` was returned as soon as
// exactly one KNOWN axis differed, without ever consulting the unread ones -- so a pair differing on
// one axis with five axes nobody looked at reported as a clean one-axis cut. That is the overclaim
// this module exists to prevent, sitting in the operation whose only job is to say whether an
// experiment isolated a variable.
type SubjectAxisDelta
  = AxisDeltaOnOneAxis { axis: ServingSubjectAxis }
  | AxisDeltaOnOneAxisWithUnreadAxes { axis: ServingSubjectAxis, unread: List<ServingSubjectAxis> }
  | AxisDeltaNone
  | AxisDeltaOnManyAxes { axes: List<ServingSubjectAxis> }
  | AxisDeltaUndecidable { because: NonEmptyStr }

fn serving_subject_axis_delta(
  left: ServingPerformanceSubjectStanding,
  right: ServingPerformanceSubjectStanding,
) -> SubjectAxisDelta {
  let ls = standing_subject(st: left)
  let rs = standing_subject(st: right)
  let known = serving_subject_known_differing_axes(left: ls, right: rs)
  let unread = either_side_unknown_axes(left: ls, right: rs)
  if length(known) == 1 {
    match known.first() {
      Absent => AxisDeltaUndecidable { because: "unreachable: a one-element list has a first element" as NonEmptyStr }
      Present { value: only } =>
        if length(unread) == 0 {
          AxisDeltaOnOneAxis { axis: only }
        } else {
          AxisDeltaOnOneAxisWithUnreadAxes { axis: only, unread: unread }
        }
    }
  } else if length(known) > 1 {
    AxisDeltaOnManyAxes { axes: known }
  } else {
    if length(unread) > 0 {
      AxisDeltaUndecidable { because: join([
        "no axis both sides read differs, and these were never read on at least one side: ",
        serving_subject_axes_wire(axes: unread),
      ], "") as NonEmptyStr }
    } else {
      AxisDeltaNone
    }
  }
}

// ── THE SUBJECT'S IDENTITY KEY, FOR RECEIPTS THAT MUST NAME EXACTLY ONE SUBJECT ─────────────────
//
// THE KEY RELATION (DESIGN 3b keys/hashing; review 74175). Relation: "this receipt is evidence about this
// serving subject". Scope: promotion evidence (gunbc.spark.serving_promotion). Preimage: every axis of
// serving_subject_axes, in roster order, each written as its name and its value, EACH LENGTH-PREFIXED
// ("<len>:<text>"), so no axis value can forge a separator and two different subjects cannot share a
// preimage. Equality: exact equality of that preimage -- not of the digest -- so a hash collision cannot
// merge two subjects. The digest is std.content_hash content_hash_of_value over the preimage, carried for
// display and indexing only. An unread axis is part of the preimage as unread, so a receipt taken with an
// axis unread does not stand for a subject that has it read.
//
// NESTED KNOWN PARTS ARE IN THE PREIMAGE. Join treats a present NInfer kv_dtype (or a cited SKU) as
// known even when a sibling field is unread. The standing reading still collapses that axis to
// AxisUnread so Incomparable/Partial stay honest. The key must not use that collapse: it embeds
// serving_engine_request_wire / serving_accelerator_realization_wire, which already spell the nested
// present and unread fragments. Two Partials that differ on a nested known part therefore cannot share
// a ServingSubjectKey.
type ServingSubjectKey sole_constructor {
  preimage: NonEmptyStr
  digest: ContentHash
}

fn length_prefixed(text: String) -> String {
  join([to_string(string_length(s: text)), ":", text], "")
}

fn serving_subject_key_axis_fragment(s: ServingPerformanceSubject, a: ServingSubjectAxis) -> NonEmptyStr {
  match a {
    AxisEngine => serving_engine_request_wire(e: s.engine)
    AxisAccelerator =>
      match s.accelerator {
        AcceleratorUnread => axis_value_unread_marker
        AcceleratorSparkGb10 => serving_accelerator_spark_gb10_wire
        AcceleratorCited { realization: r } => serving_accelerator_realization_wire(a: r)
      }
    AxisCheckpoint => serving_subject_axis_value(s: s, a: a)
    AxisCheckpointRevision => serving_subject_axis_value(s: s, a: a)
    AxisRuntime => serving_subject_axis_value(s: s, a: a)
    AxisRuntimeImageReference => serving_subject_axis_value(s: s, a: a)
    AxisTopology => serving_subject_axis_value(s: s, a: a)
    AxisRankPopulation => serving_subject_axis_value(s: s, a: a)
    AxisContextCeiling => serving_subject_axis_value(s: s, a: a)
    AxisBatchBudget => serving_subject_axis_value(s: s, a: a)
    AxisMaxNumSeqs => serving_subject_axis_value(s: s, a: a)
    AxisKvCacheDtype => serving_subject_axis_value(s: s, a: a)
    AxisSpeculativePolicy => serving_subject_axis_value(s: s, a: a)
    AxisCollectiveTransport => serving_subject_axis_value(s: s, a: a)
    AxisWeightQuantization => serving_subject_axis_value(s: s, a: a)
    AxisIndexerKvDtype => serving_subject_axis_value(s: s, a: a)
    AxisSchedulerAdmission => serving_subject_axis_value(s: s, a: a)
    AxisLaunchProfile => serving_subject_axis_value(s: s, a: a)
    AxisDeploymentEnv => serving_subject_axis_value(s: s, a: a)
  }
}

fn serving_subject_key(s: ServingPerformanceSubject) -> ServingSubjectKey {
  let pre = join(map(serving_subject_axes, a => join([
    length_prefixed(text: serving_subject_axis_wire(a: a) as String),
    length_prefixed(text: serving_subject_key_axis_fragment(s: s, a: a) as String),
  ], "")), "") as NonEmptyStr
  ServingSubjectKey { preimage: pre, digest: content_hash_of_value(value: pre) }
}

fn serving_subject_key_equal(a: ServingSubjectKey, b: ServingSubjectKey) -> Bool {
  (a.preimage as String) == (b.preimage as String)
}

fn serving_subject_key_display(k: ServingSubjectKey) -> NonEmptyStr {
  serialize_content_hash(hash: k.digest)
}
