module gunbc.spark.serving_admission_fence

import std.types { Bool, Int, List, NonEmptyStr, String }
import product.placement_supply { HostIdentity, host_identity_eq }
import gunbc.remote_operation { PlannedRemoteStep, RemoteArgv }
import gunbc.fleet_known_hosts_anchor { portable_remote_words, portable_remote_words_strings }
import extdeps.systemd.systemctl { systemctl_user_restart_argv }
import gunbc.spark.serving_realization {
  ServingReactivationEffect,
  RestartSystemUnitForChangedDefinition,
  RestartUserUnitForChangedDefinition,
  serving_reactivation_effect_wire,
  SparkServingReactivationVerdict,
  ReactivationRequired,
  ReactivationNotRequired,
  ReactivationNotApplicable,
  ReactivationUndecidable,
  SparkServingRunningDefinition,
  RunningDefinitionObserved,
  RunningDefinitionUnstamped,
  RunningDefinitionNotRunning,
  RunningDefinitionUnobserved,
}
import gunbc.spark.serving_observe {
  SparkServingInvocationIdentity,
  InvocationIdentityObserved,
  InvocationIdentityNotRunning,
  InvocationIdentityUnobserved,
}
import gunbc.spark.serving_unit_identity { spark_serving_unit_name }

// THE FENCE AND THE DRAIN ARE ONE PROTOCOL, WHICH IS THE WHOLE REASON THIS MODULE EXISTS.
//
// A bare `active == 0` reading is insufficient, and the insufficiency is not a matter of degree: a
// turn may enter the service in the instant between the count and the act, so a reader that observes
// zero and then restarts has proven nothing about the moment it acted. The only reading that decides
// the question is one taken while admission is already refused -- so the refusal is not a step BEFORE
// the drain, it is the condition UNDER WHICH the drain's zero means anything.
//
// This module therefore never exposes a lease count as an answer. The drain's success arm is an
// EVIDENCE VALUE that carries the fence it was measured under, and the reactivation plan cannot be
// constructed from anything else. A caller holding a count and a wish has no route to a plan.
//
// THREE IDENTITIES, NOT ONE, and this module keeps them apart at the type level because the
// 2026-09-02 ruling found them conflated:
//
//   - the SERVICE LOCUS is stable across restarts and answers WHICH service is fenced;
//   - the SERVICE INVOCATION identity changes on every activation and answers WHETHER THIS IS STILL
//     THE PROCESS GENERATION OBSERVED BEFORE;
//   - the RUNNING DEFINITION identity is stable for equal restart-relevant specs and answers WHICH
//     DEFINITION produced this invocation.
//
// The fence is keyed by the LOCUS. An earlier wording scoped the refusal to the pre-restart
// incarnation, and that fails exactly when it matters: if the backend restarts unexpectedly
// mid-drain, an incarnation-scoped fence stops refusing admissions at the moment an unvalidated new
// incarnation appears. The pre-invocation is a compare-and-swap condition and an evidence anchor,
// never the scope of the refusal.
//
// WHAT THIS MODULE DOES NOT DO, STATED HERE SO NO READER INFERS IT. It executes nothing. Every
// function is a pure adjudication over values a caller supplies, and the arms that would end in a
// live restart -- a drained fence, a minted plan, a confirmed readback -- are REACHABLE BUT
// UNEXERCISED AGAINST ANY HOST. Their fixtures execute in
// test.claim.spark_serving_admission_fence_witness_test; no Spark has ever been restarted through
// them. The capability that changes that is named at spark_serving_guarded_bound_reactivation: a
// complete active-turn population observed at the locus, which no authority in this repository
// produces today, and without which the guarded producer refuses.
type ServingServiceLocus {
  host: HostIdentity
  unit_slot: NonEmptyStr
}

fn spark_serving_locus(host: HostIdentity) -> ServingServiceLocus {
  ServingServiceLocus { host: host, unit_slot: spark_serving_unit_name as NonEmptyStr }
}

fn serving_locus_eq(a: ServingServiceLocus, b: ServingServiceLocus) -> Bool {
  host_identity_eq(a: a.host, b: b.host) && (a.unit_slot as String) == (b.unit_slot as String)
}

fn serving_locus_label(locus: ServingServiceLocus) -> String {
  join([locus.host as String, "/", locus.unit_slot as String], "")
}

// ADMISSION HAS THREE STATES AND THE THIRD IS NOT A DEGENERATE OPEN.
//
// `AdmissionUnbound` is a locus whose serving pair has never been validated -- nothing has read an
// invocation and a definition together and admitted them. Rendering that as Open would grant turns
// against a backend nobody has checked, which is the fail-open this protocol closes at the far end;
// rendering it as Draining would claim a maintenance that nobody holds. It is a third state, it
// refuses, and it is where a locus starts.
//
// `AdmissionOpen` carries the PAIR it was reopened against, not merely a flag. Step 8 of the
// protocol requires every later admission to recheck that the observed pair still equals the
// admitted one, and a state that did not carry the pair could not express that check.
type ServingAdmissionState
  = AdmissionUnbound { locus: ServingServiceLocus }
  | AdmissionOpen {
      locus: ServingServiceLocus,
      admitted_invocation: NonEmptyStr,
      admitted_definition: NonEmptyStr,
    }
  | AdmissionDraining {
      locus: ServingServiceLocus,
      maintenance: NonEmptyStr,
      expected_invocation: NonEmptyStr,
    }

fn serving_admission_state_locus(state: ServingAdmissionState) -> ServingServiceLocus {
  match state {
    AdmissionUnbound { locus: l } => l
    AdmissionOpen { locus: l, admitted_invocation: _, admitted_definition: _ } => l
    AdmissionDraining { locus: l, maintenance: _, expected_invocation: _ } => l
  }
}

// A LEASE BINDS THE INVOCATION IT IS USING, WHICH IS WHAT MAKES AN UNEXPECTED REPLACEMENT
// ATTRIBUTABLE.
//
// The fence refuses at the locus, so the locus is what stops NEW work. It is not what settles work
// already running: if the backend is replaced mid-drain, the turns that must be settled as
// interrupted are exactly those bound to the invocation that went away, and a lease population that
// recorded only the locus could not name them. `sole_constructor` keeps the binding honest -- a lease
// is minted by admission or not at all, so no caller can author a lease claiming an invocation it
// was never admitted against.
type ServingTurnLease sole_constructor {
  locus: ServingServiceLocus
  turn_id: NonEmptyStr
  bound_invocation: NonEmptyStr
}

type ServingTurnAdmission
  = TurnAdmitted { lease: ServingTurnLease }
  | TurnAdmissionRefused { cause: NonEmptyStr }

// STEP 3 AND STEP 8 OF THE PROTOCOL ARE THE SAME FUNCTION, and writing them as one is what keeps
// them from disagreeing.
//
// Draining refuses WHATEVER INVOCATION IS PRESENT -- the argument is not even consulted on that arm,
// which is the locus-keyed fence stated as code rather than as a comment. Open refuses unless the
// observed pair equals the admitted pair, so an out-of-band restart refuses immediately rather than
// silently granting a turn against a backend nobody validated.
fn spark_serving_admit_turn(
  state: ServingAdmissionState,
  locus: ServingServiceLocus,
  turn_id: NonEmptyStr,
  observed_invocation: SparkServingInvocationIdentity,
  observed_definition: SparkServingRunningDefinition,
) -> ServingTurnAdmission {
  if !serving_locus_eq(a: serving_admission_state_locus(state: state), b: locus) {
    TurnAdmissionRefused {
      cause: join([
        "spark_serving_admit_turn: the admission state is for ",
        serving_locus_label(locus: serving_admission_state_locus(state: state)),
        " and the turn asks for ",
        serving_locus_label(locus: locus),
      ], "") as NonEmptyStr,
    }
  } else {
    match state {
      AdmissionUnbound { locus: _ } =>
        TurnAdmissionRefused {
          cause: "spark_serving_admit_turn: no validated serving pair has been admitted at this locus, so there is nothing to admit a turn against" as NonEmptyStr,
        }
      AdmissionDraining { locus: _, maintenance: m, expected_invocation: _ } =>
        TurnAdmissionRefused {
          cause: join([
            "spark_serving_admit_turn: the locus is draining for maintenance ",
            m as String,
            " — every admission refuses here, whatever invocation is present",
          ], "") as NonEmptyStr,
        }
      AdmissionOpen { locus: _, admitted_invocation: j, admitted_definition: d } =>
        spark_serving_admit_against_pair(
          locus: locus,
          turn_id: turn_id,
          admitted_invocation: j,
          admitted_definition: d,
          observed_invocation: observed_invocation,
          observed_definition: observed_definition,
        )
    }
  }
}

// THE PAIR RECHECK, SEPARATED SO THE OPEN ARM ABOVE READS AS ONE DECISION.
//
// Both halves must be POSITIVELY observed. An unobserved invocation is not "probably the same one":
// it is the absence of the reading that would decide, and admitting a turn on it would spend
// ignorance as agreement.
fn spark_serving_admit_against_pair(
  locus: ServingServiceLocus,
  turn_id: NonEmptyStr,
  admitted_invocation: NonEmptyStr,
  admitted_definition: NonEmptyStr,
  observed_invocation: SparkServingInvocationIdentity,
  observed_definition: SparkServingRunningDefinition,
) -> ServingTurnAdmission {
  match observed_invocation {
    InvocationIdentityNotRunning =>
      TurnAdmissionRefused {
        cause: "spark_serving_admit_turn: the unit is not running, so the admitted invocation is gone" as NonEmptyStr,
      }
    InvocationIdentityUnobserved { cause: why } =>
      TurnAdmissionRefused {
        cause: join([
          "spark_serving_admit_turn: the running invocation was not observed — ",
          why as String,
        ], "") as NonEmptyStr,
      }
    InvocationIdentityObserved { invocation_identity: j } =>
      if (j as String) != (admitted_invocation as String) {
        TurnAdmissionRefused {
          cause: "spark_serving_admit_turn: the observed invocation is not the admitted one — the backend was replaced out of band and has not been validated" as NonEmptyStr,
        }
      } else {
        match observed_definition {
          RunningDefinitionObserved { definition_identity: d } =>
            if (d as String) == (admitted_definition as String) {
              TurnAdmitted {
                lease: ServingTurnLease {
                  locus: locus,
                  turn_id: turn_id,
                  bound_invocation: j,
                },
              }
            } else {
              TurnAdmissionRefused {
                cause: "spark_serving_admit_turn: the observed running definition is not the admitted one" as NonEmptyStr,
              }
            }
          RunningDefinitionUnstamped =>
            TurnAdmissionRefused {
              cause: "spark_serving_admit_turn: the running process carries no definition identity, so the admitted pair cannot be rechecked" as NonEmptyStr,
            }
          RunningDefinitionNotRunning =>
            TurnAdmissionRefused {
              cause: "spark_serving_admit_turn: the unit is not running, so it holds no definition to recheck" as NonEmptyStr,
            }
          RunningDefinitionUnobserved { cause: why } =>
            TurnAdmissionRefused {
              cause: join([
                "spark_serving_admit_turn: the running definition was not observed — ",
                why as String,
              ], "") as NonEmptyStr,
            }
        }
      }
  }
}

// THE GUARANTEE GRAIN IS AN INPUT, NOT AN ASSUMPTION, and it is the one that decides whether an
// automated destructive restart may happen at all.
//
// A census of DCH turn leases proves quiescence for DCH-managed clients only. To claim the SERVICE
// is quiescent, one of the first three arms must hold. Otherwise external occupancy is outside the
// modeled guarantee, and the plan is explicit about what follows: the automated destructive restart
// must REFUSE, or the guarantee must be stated narrowly as DCH-managed-turn continuity. It may not
// be stated broadly and held narrowly, so the broad claim has no constructor here that does not name
// its ground.
// THREE OF THESE FOUR ARMS HAVE NO PRODUCER, AND THE ONLY PRODUCTION CALLER MINTS THE FOURTH.
//
// AllClientsRouteThroughLeaseAuthority, ExclusiveAccessHeldForWindow and CompleteActiveRequestObservation
// are constructible -- the witness fixtures construct them, which is what makes the drained arm
// reachable at all -- and NOTHING in this repository mints one, because no authority observes a lease
// population at a serving locus. The production caller,
// gunbc.spark.serving_converge_slice_wet spark_serving_reactivation_standing_for, reaches this type
// only through spark_serving_unfenced_production_drain, which mints the fourth arm.
//
// This is written at the arms rather than in a summary because their EXISTENCE is what a reader would
// otherwise spend as coverage: a grain vocabulary that names three ways to establish service
// quiescence reads as three established ways, when what is established is that none of them has a
// producer and the destructive restart therefore refuses every time. An arm with no producer refuses
// nothing.
type ServingOccupancyGrain
  = AllClientsRouteThroughLeaseAuthority
  | ExclusiveAccessHeldForWindow
  | CompleteActiveRequestObservation
  | ExternalOccupancyOutsideModeledGuarantee { cause: NonEmptyStr }

fn serving_occupancy_grain_wire(grain: ServingOccupancyGrain) -> String {
  match grain {
    AllClientsRouteThroughLeaseAuthority => "all-clients-route-through-lease-authority"
    ExclusiveAccessHeldForWindow => "exclusive-access-held-for-window"
    CompleteActiveRequestObservation => "complete-active-request-observation"
    ExternalOccupancyOutsideModeledGuarantee { cause: _ } => "external-occupancy-outside-modeled-guarantee"
  }
}

// THE FENCE IS THE COMPARE-AND-SWAP, AND IT CARRIES EVERYTHING THE PROTOCOL LATER COMPARES AGAINST.
//
// `sole_constructor` is doing load-bearing work here rather than decorating: the fence is the only
// route to a drain evidence value, which is the only route to a reactivation plan, so a module that
// could author a fence could restart a host on facts it made up. Outside this module the literal is
// refused by the compiler.
type ServingDrainFence sole_constructor {
  locus: ServingServiceLocus
  maintenance: NonEmptyStr
  pre_invocation: NonEmptyStr
  pre_definition: NonEmptyStr
  desired_definition: NonEmptyStr
}

type ServingFenceTransition
  = FenceHeld { fence: ServingDrainFence }
  | FenceTransitionRefused { cause: NonEmptyStr }

// STEP 2: MOVE OPEN TO DRAINING, KEYED BY LOCUS AND MAINTENANCE, WITH J0 AS THE EXPECTED
// PRE-INVOCATION.
//
// The expected pre-invocation is what makes this a compare-and-swap rather than an assignment. A
// caller that observed the pre-state, went away, and came back to a service that has since been
// replaced does not get the fence: its `J0` no longer matches what admission was opened against, and
// its whole pre-state -- definition included -- is about a process that is gone.
//
// Draining refuses a second fence even for the same maintenance identity. Idempotent re-entry is a
// real question and this module does not answer it; answering it by accident, with a fence handed
// out twice, would let two maintenances each believe they hold the locus.
fn spark_serving_begin_drain(
  state: ServingAdmissionState,
  locus: ServingServiceLocus,
  maintenance: NonEmptyStr,
  expected_invocation: NonEmptyStr,
  expected_definition: NonEmptyStr,
  desired_definition: NonEmptyStr,
) -> ServingFenceTransition {
  if !serving_locus_eq(a: serving_admission_state_locus(state: state), b: locus) {
    FenceTransitionRefused {
      cause: join([
        "spark_serving_begin_drain: the admission state is for ",
        serving_locus_label(locus: serving_admission_state_locus(state: state)),
        " and the drain asks for ",
        serving_locus_label(locus: locus),
      ], "") as NonEmptyStr,
    }
  } else {
    match state {
      AdmissionUnbound { locus: _ } =>
        FenceTransitionRefused {
          cause: "spark_serving_begin_drain: the locus has no admitted pair, so there is no pre-invocation to compare and swap against" as NonEmptyStr,
        }
      AdmissionDraining { locus: _, maintenance: m, expected_invocation: _ } =>
        FenceTransitionRefused {
          cause: join([
            "spark_serving_begin_drain: the locus is already draining for maintenance ",
            m as String,
          ], "") as NonEmptyStr,
        }
      AdmissionOpen { locus: _, admitted_invocation: j, admitted_definition: d } =>
        if (j as String) != (expected_invocation as String) {
          FenceTransitionRefused {
            cause: "spark_serving_begin_drain: the admitted invocation is not the observed pre-invocation — the pre-state is about a process that has since been replaced" as NonEmptyStr,
          }
        } else if (d as String) != (expected_definition as String) {
          FenceTransitionRefused {
            cause: "spark_serving_begin_drain: the admitted definition is not the observed pre-definition — the pre-state was not read against this admission" as NonEmptyStr,
          }
        } else {
          FenceHeld {
            fence: ServingDrainFence {
              locus: locus,
              maintenance: maintenance,
              pre_invocation: j,
              pre_definition: d,
              desired_definition: desired_definition,
            },
          }
        }
    }
  }
}

// THE STATE UNDER THE FENCE IS DERIVED FROM THE FENCE, so "held" and "refusing admissions" cannot
// come apart. There is no second write for a caller to forget.
fn spark_serving_state_under_fence(fence: ServingDrainFence) -> ServingAdmissionState {
  AdmissionDraining {
    locus: fence.locus,
    maintenance: fence.maintenance,
    expected_invocation: fence.pre_invocation,
  }
}

// THE DRAIN'S SUCCESS ARM IS EVIDENCE, NOT A BOOLEAN, and it carries the fence it was measured
// under. That is the one-protocol point in the type system: a zero read outside a held fence has no
// constructor into this value, so no later step can consume it as though it did.
type ServingDrainedEvidence sole_constructor {
  fence: ServingDrainFence
  revalidated_invocation: NonEmptyStr
  occupancy: ServingOccupancyGrain
}

type ServingDrainVerdict
  = DrainedToZero { evidence: ServingDrainedEvidence }
  | DrainIncomplete { remaining: Int, cause: NonEmptyStr }
  | DrainInvalidated { cause: NonEmptyStr, settlements: List<ServingTurnSettlement> }
  | DrainOccupancyUnmodeled { cause: NonEmptyStr }

// A TURN THAT WAS RUNNING AGAINST A REPLACED INVOCATION IS INTERRUPTED, AND SAYING SO IS THE POINT
// OF BINDING THE INVOCATION INTO THE LEASE.
//
// The settlement is not a repair. It is the typed statement that this turn's backend went away
// under it, produced against the RIGHT turns rather than against every turn at the locus, which is
// what a locus-only lease population would have forced.
type ServingTurnSettlement
  = TurnInterrupted { turn_id: NonEmptyStr, cause: NonEmptyStr }
  | TurnUnaffected { turn_id: NonEmptyStr }

fn spark_serving_settle_leases_against_invocation(
  leases: List<ServingTurnLease>,
  observed_invocation: NonEmptyStr,
) -> List<ServingTurnSettlement> {
  map(leases, l =>
    if (l.bound_invocation as String) == (observed_invocation as String) {
      TurnUnaffected { turn_id: l.turn_id }
    } else {
      TurnInterrupted {
        turn_id: l.turn_id,
        cause: "the invocation this turn was admitted against was replaced while the locus was draining" as NonEmptyStr,
      }
    })
}

// ITS CONTENT IS UNWITNESSED, AND THAT IS A DIFFERENT STATEMENT FROM ITS ARM BEING UNTESTED. The
// unit-stopped arm of the drain IS exercised in
// test.claim.spark_serving_admission_fence_witness_test, but only with an EMPTY lease population, so
// what execution has established is that a stopped unit invalidates the drain -- not that the
// settlements this function produces are the right ones. The claim that would establish the latter
// needs a stopped unit and a non-empty population in one fixture, and no such claim is authored yet.
//
// A UNIT THAT STOPPED UNDER THE FENCE INTERRUPTS EVERY TURN AT THE LOCUS, and the comparison that
// settles the replacement case is deliberately absent here: there is no successor invocation to
// compare against, so every admitted turn lost its backend and saying otherwise would need an
// invocation nobody observed.
fn spark_serving_settle_all_leases_interrupted(
  leases: List<ServingTurnLease>,
  cause: NonEmptyStr,
) -> List<ServingTurnSettlement> {
  map(leases, l => TurnInterrupted { turn_id: l.turn_id, cause: cause })
}

fn spark_serving_leases_at_locus(
  leases: List<ServingTurnLease>,
  locus: ServingServiceLocus,
) -> List<ServingTurnLease> {
  filter(leases, l => serving_locus_eq(a: l.locus, b: locus))
}

// STEPS 4 AND 5, ADJUDICATED TOGETHER BECAUSE THEY ARE ONE READING.
//
// The population is filtered by LOCUS, not by invocation: a lease bound to some other invocation at
// this locus is still occupancy, and skipping it would drain to a zero that is only zero for the
// generation we happened to ask about.
//
// The revalidation is the second half of the same reading. Zero leases and an unchanged invocation
// are jointly the claim "nothing is running here and it is still the thing we observed"; either one
// alone is satisfiable by a service that was replaced mid-drain, whose new process trivially has no
// leases because nobody admitted any against it.
//
// The occupancy grain is checked FIRST and refuses hardest, because every other reading in this
// function is a census of DCH-managed turns. Under an unmodeled external population that census is
// true and irrelevant, and reporting DrainedToZero from it would be the guarantee stated broadly and
// held narrowly.
fn spark_serving_adjudicate_drain(
  fence: ServingDrainFence,
  occupancy: ServingOccupancyGrain,
  leases: List<ServingTurnLease>,
  revalidated_invocation: SparkServingInvocationIdentity,
) -> ServingDrainVerdict {
  match occupancy {
    ExternalOccupancyOutsideModeledGuarantee { cause: why } =>
      DrainOccupancyUnmodeled {
        cause: join([
          "spark_serving_adjudicate_drain: service quiescence is outside the modeled guarantee — ",
          why as String,
          " — a lease census proves quiescence for managed turns only, so the destructive restart refuses",
        ], "") as NonEmptyStr,
      }
    AllClientsRouteThroughLeaseAuthority =>
      spark_serving_adjudicate_drained_population(
        fence: fence,
        occupancy: occupancy,
        leases: leases,
        revalidated_invocation: revalidated_invocation,
      )
    ExclusiveAccessHeldForWindow =>
      spark_serving_adjudicate_drained_population(
        fence: fence,
        occupancy: occupancy,
        leases: leases,
        revalidated_invocation: revalidated_invocation,
      )
    CompleteActiveRequestObservation =>
      spark_serving_adjudicate_drained_population(
        fence: fence,
        occupancy: occupancy,
        leases: leases,
        revalidated_invocation: revalidated_invocation,
      )
  }
}

// THE POPULATION HALF, REACHED ONLY ONCE THE GRAIN ADMITS THE CENSUS AS AN ANSWER ABOUT THE SERVICE.
//
// THE REVALIDATION IS ADJUDICATED BEFORE THE COUNT, AND THE ORDER IS LOAD-BEARING RATHER THAN
// STYLISTIC. Counting first and revalidating second makes the invalidated arm reachable only with an
// EMPTY population -- zero is what got us past the count -- so its settlements would be empty by
// construction, a list that is correct for every input it can receive and answers nothing. Asking
// the identity question first is also the truer reading of step 5: the zero and the invocation are
// one observation, and if the process was replaced then the leases still held at this locus are
// exactly the turns whose backend went away, which is what there is to settle.
fn spark_serving_adjudicate_drained_population(
  fence: ServingDrainFence,
  occupancy: ServingOccupancyGrain,
  leases: List<ServingTurnLease>,
  revalidated_invocation: SparkServingInvocationIdentity,
) -> ServingDrainVerdict {
  let held = spark_serving_leases_at_locus(leases: leases, locus: fence.locus)
  match revalidated_invocation {
    InvocationIdentityUnobserved { cause: why } =>
      DrainInvalidated {
        cause: join([
          "spark_serving_adjudicate_drain: the invocation could not be revalidated under the fence — ",
          why as String,
        ], "") as NonEmptyStr,
        settlements: [],
      }
    InvocationIdentityNotRunning =>
      DrainInvalidated {
        cause: "spark_serving_adjudicate_drain: the fenced unit is no longer running, so the pre-invocation cannot be revalidated" as NonEmptyStr,
        settlements: spark_serving_settle_all_leases_interrupted(
          leases: held,
          cause: "the fenced unit stopped while the locus was draining" as NonEmptyStr,
        ),
      }
    InvocationIdentityObserved { invocation_identity: j } =>
      if (j as String) != (fence.pre_invocation as String) {
        DrainInvalidated {
          cause: "spark_serving_adjudicate_drain: the invocation changed under the fence — the drain did not succeed and the protocol restarts from a fresh pre-state" as NonEmptyStr,
          settlements: spark_serving_settle_leases_against_invocation(
            leases: held,
            observed_invocation: j,
          ),
        }
      } else if length(held) > 0 {
        DrainIncomplete {
          remaining: length(held),
          cause: "spark_serving_adjudicate_drain: turns are still active at the fenced locus" as NonEmptyStr,
        }
      } else {
        DrainedToZero {
          evidence: ServingDrainedEvidence {
            fence: fence,
            revalidated_invocation: j,
            occupancy: occupancy,
          },
        }
      }
  }
}

// THE BOUND PLAN: A RESTART THAT CANNOT BE SEPARATED FROM WHAT ADMITTED IT.
//
// Everything the protocol compares against later reaches through `drained` -- the locus, the
// pre-invocation J0, the pre-definition D0 and the desired D*. There is no second copy for a caller
// to supply differently, which is what makes the readback's `J1 != J0` a comparison against the
// invocation the drain actually revalidated rather than against a number somebody passed in.
type BoundReactivationPlan sole_constructor {
  drained: ServingDrainedEvidence
  effect: ServingReactivationEffect
}

// THE STEPS ARE DERIVED, NOT STORED, AND THAT IS A DELIBERATE DEPARTURE FROM THE PLAN'S SKETCH.
//
// docs/plans/dedicated-coding-harness-plan.md settles the shape as
// `PlannedBoundReactivationExecution { plan, steps }` with the steps DERIVED from the bound plan.
// Storing a derived list beside the thing it derives from is the very defect the exclusion in
// gunbc.spark.serving_realization SparkServingExecutablePlannedEffect holds shut: `effect` and
// `first_step` as independent fields is what makes a restart's LABEL authorable beside commands that
// do not restart anything. A stored `steps` field would rebuild that at one remove.
//
// So this record carries the plan alone and the steps are a function OF it. The pairing of a restart
// with unrelated commands is not refused here; it has no constructor at all.
type PlannedBoundReactivationExecution sole_constructor {
  plan: BoundReactivationPlan
}

// THE ARGV FOR A RESTART, WHICH IS THE ONLY PLACE IN THIS MODULE THAT NAMES A COMMAND.
//
// The system-unit arm has no realization in this slice, exactly as every other system-scope effect
// in gunbc.spark.serving_converge_realize refuses: the Sparks are on the user-unit path and a
// system-scope restart would need a privilege route nobody has modeled. It answers with no steps,
// and the guarded producer below turns that into a refusal rather than into an execution with an
// empty step list.
fn spark_serving_reactivation_steps_for_effect(
  effect: ServingReactivationEffect,
) -> List<PlannedRemoteStep> {
  match effect {
    RestartUserUnitForChangedDefinition =>
      spark_serving_admitted_restart_step(
        identity: "restart-user-unit-for-changed-definition" as NonEmptyStr,
        raws: systemctl_user_restart_argv(unit: spark_serving_unit_name as NonEmptyStr),
      )
    RestartSystemUnitForChangedDefinition => []
  }
}

// THE WORDS COME FROM THE SYSTEMCTL AUTHORITY AND THE STEP COMES FROM THE SAME PORTABILITY ADMISSION
// EVERY OTHER SPARK ARGV GOES THROUGH.
//
// Both halves of that were authored by hand in the first cut of this module, and both were forks.
// The words duplicated extdeps.systemd.systemctl -- which owns every other user-scope argv this slice
// emits -- so a change to how a unit is addressed would have moved five call sites and missed this
// one. And minting the PlannedRemoteStep directly bypassed portable_remote_words, the admission that
// gunbc.spark.serving_converge_realize puts every install and retirement argv through, so a restart
// would have been the ONE remote command in the slice free to carry a word no remote invocation can
// safely transport.
//
// A word that does not admit yields NO STEP, and the guarded producer turns an empty step list into a
// refusal rather than an execution that runs nothing -- so the refusal arm is the same one the
// unrealizable system-unit effect reaches, and it is exercised by the same claim.
fn spark_serving_admitted_restart_step(
  identity: NonEmptyStr,
  raws: List<String>,
) -> List<PlannedRemoteStep> {
  match portable_remote_words(raws: raws) {
    Absent => []
    Present { value: words } =>
      [
        PlannedRemoteStep {
          identity: identity,
          operation: RemoteArgv { argv: portable_remote_words_strings(words: words) },
        },
      ]
  }
}

fn spark_serving_bound_reactivation_steps(
  execution: PlannedBoundReactivationExecution,
) -> List<PlannedRemoteStep> {
  spark_serving_reactivation_steps_for_effect(effect: execution.plan.effect)
}

type SparkServingBoundReactivationPlanning
  = BoundReactivationPlanned { execution: PlannedBoundReactivationExecution }
  | BoundReactivationNotRequired
  | BoundReactivationRefused { cause: NonEmptyStr }

// THE GUARDED PRODUCER. THE ONLY ROUTE FROM A REMEDY VERDICT TO AN EXECUTABLE RESTART.
//
// Two independent facts must both hold, and neither is derivable from the other: the running
// definition must establish that a restart is the remedy, and the drain must have reached zero under
// a held fence. A caller holding one of them gets a typed refusal naming which half it is missing.
//
// REACHABLE, AND UNEXERCISED AGAINST ANY HOST. The Planned arm is reachable -- its fixtures execute
// in test.claim.spark_serving_admission_fence_witness_test -- and no Spark has ever been restarted
// through it. Two capabilities stand between this and a live receipt, and neither is a matter of
// wiring:
//
//   1. A COMPLETE ACTIVE-TURN POPULATION AT THE LOCUS. No authority in this repository observes one,
//      so the production caller in gunbc.spark.serving_converge_slice_wet supplies
//      ExternalOccupancyOutsideModeledGuarantee and this function refuses. That is not a placeholder
//      to be relaxed: until a lease authority exists, the census that would prove quiescence does not
//      exist either, and the refusal is the honest answer.
//   2. SSH TO srv5/srv6 UNDER AN OPERATOR CREDENTIAL DECISION, without which no fence can be held
//      against a real service at all.
//
// Neither DCH-0r-a's nor DCH-0r-b's declared standing is retired by this function. Their triggers
// name the live capability, and landing a guarded producer moves toward it while establishing none of
// it.
fn spark_serving_guarded_bound_reactivation(
  remedy: SparkServingReactivationVerdict,
  drain: ServingDrainVerdict,
) -> SparkServingBoundReactivationPlanning {
  match remedy {
    ReactivationNotRequired => BoundReactivationNotRequired
    ReactivationNotApplicable { cause: why } =>
      BoundReactivationRefused {
        cause: join([
          "spark_serving_guarded_bound_reactivation: no restart is planned — ",
          why as String,
        ], "") as NonEmptyStr,
      }
    ReactivationUndecidable { cause: why } =>
      BoundReactivationRefused {
        cause: join([
          "spark_serving_guarded_bound_reactivation: the remedy is undecidable, which refuses — ",
          why as String,
        ], "") as NonEmptyStr,
      }
    ReactivationRequired { effect: e } =>
      spark_serving_bind_reactivation_to_drain(effect: e, drain: drain)
  }
}

// THE SECOND HALF, SEPARATED SO THE DRAIN'S FOUR ANSWERS ARE ELIMINATED IN ONE PLACE.
fn spark_serving_bind_reactivation_to_drain(
  effect: ServingReactivationEffect,
  drain: ServingDrainVerdict,
) -> SparkServingBoundReactivationPlanning {
  match drain {
    DrainOccupancyUnmodeled { cause: why } =>
      BoundReactivationRefused { cause: why }
    DrainIncomplete { remaining: n, cause: why } =>
      BoundReactivationRefused {
        cause: join([
          why as String,
          " — ", to_string(n), " turn(s) still hold the locus",
        ], "") as NonEmptyStr,
      }
    DrainInvalidated { cause: why, settlements: _ } =>
      BoundReactivationRefused { cause: why }
    DrainedToZero { evidence: ev } =>
      if length(spark_serving_reactivation_steps_for_effect(effect: effect)) == 0 {
        BoundReactivationRefused {
          cause: join([
            "spark_serving_guarded_bound_reactivation: ",
            serving_reactivation_effect_wire(effect: effect),
            " has no modeled remote realization in this slice",
          ], "") as NonEmptyStr,
        }
      } else {
        BoundReactivationPlanned {
          execution: PlannedBoundReactivationExecution {
            plan: BoundReactivationPlan { drained: ev, effect: effect },
          },
        }
      }
  }
}

fn spark_serving_bound_reactivation_planning_wire(
  planning: SparkServingBoundReactivationPlanning,
) -> String {
  match planning {
    BoundReactivationNotRequired => "reactivation-not-required"
    BoundReactivationRefused { cause: why } =>
      join(["reactivation-refused ", why as String], "")
    BoundReactivationPlanned { execution: x } =>
      join([
        "reactivation-planned ",
        serving_reactivation_effect_wire(effect: x.plan.effect),
        " at ",
        serving_locus_label(locus: x.plan.drained.fence.locus),
      ], "")
  }
}

// POST-RESTART HEALTH BELONGS TO AN INVOCATION OR IT ANSWERS FOR NOTHING.
//
// A health reading taken against whatever is listening now is not evidence about the process the
// restart produced: on a service that failed and was restarted again by the supervisor, both
// readings succeed and neither is about the same process. So the healthy arm names the invocation it
// was taken against, and the readback requires that name to equal J1.
type ServingPostRestartHealth
  = PostRestartHealthy { invocation: NonEmptyStr }
  | PostRestartUnhealthy { cause: NonEmptyStr }
  | PostRestartHealthUnobserved { cause: NonEmptyStr }

// AN EMPTY REPLAN IS A CONDITION OF THE RECEIPT, NOT A DECORATION ON IT.
//
// The plan is explicit that an exit status of zero from the invoking program establishes only that
// the program reported completion. Service convergence is established by the resource's own observer
// and by a replan that finds nothing left to do, so the readback takes the replan standing as an
// input and refuses when rows remain.
type ServingReplanStanding
  = ReplanEmpty
  | ReplanNonEmpty { rows: Int }
  | ReplanUnobserved { cause: NonEmptyStr }

// ReactivationConfirmed HAS NEVER BEEN REACHED FROM AN OBSERVATION. Every green it has is a fixture
// readback in test.claim.spark_serving_admission_fence_witness_test, whose post-restart invocation,
// definition, registration, health and replan are all authored. No restart has been executed, so no
// value of this type has ever described a real process; the arm is the shape a confirmation must
// have, and it is not evidence that one has occurred.
type ServingReactivationReadback
  = ReactivationConfirmed { reopened: ServingAdmissionState }
  | ReactivationReadbackRefused { cause: NonEmptyStr }

// STEP 7 AND STEP 8: THE TWO-IDENTITY READBACK AND THE VALIDATED REOPENING.
//
// FIVE CONJUNCTS, ALL REQUIRED, and each one closes a different way of reporting a restart that did
// not happen:
//
//   J1 != J0                          -- the process was actually replaced. Without it, a restart
//                                        that silently did nothing reads as success, because D1 == D*
//                                        was already true of the process that was there before.
//   D1 == D*                          -- the new process was started from the definition we wanted.
//   registered == D*                  -- the definition on the host is the one desired, so the NEXT
//                                        activation will also be right. Without it, a host that
//                                        happened to start correctly from bytes since replaced reads
//                                        as converged.
//   health belongs to J1              -- the thing that is healthy is the thing that was started.
//   replan is empty                   -- convergence is established by observation, not by exit zero.
//
// The reopening is derived from the readback that admitted it: the pair bound into AdmissionOpen is
// (J1, D1) as READ, never as desired. A reopening bound to the desired pair would admit turns against
// a backend whose agreement with the desired state was assumed rather than observed.
fn spark_serving_reactivation_readback(
  execution: PlannedBoundReactivationExecution,
  post_invocation: SparkServingInvocationIdentity,
  post_definition: SparkServingRunningDefinition,
  registered_definition: NonEmptyStr,
  health: ServingPostRestartHealth,
  replan: ServingReplanStanding,
) -> ServingReactivationReadback {
  let fence = execution.plan.drained.fence
  match post_invocation {
    InvocationIdentityNotRunning =>
      ReactivationReadbackRefused {
        cause: "spark_serving_reactivation_readback: the unit is not running after the restart" as NonEmptyStr,
      }
    InvocationIdentityUnobserved { cause: why } =>
      ReactivationReadbackRefused {
        cause: join([
          "spark_serving_reactivation_readback: the post-restart invocation was not observed — ",
          why as String,
        ], "") as NonEmptyStr,
      }
    InvocationIdentityObserved { invocation_identity: j1 } =>
      if (j1 as String) == (fence.pre_invocation as String) {
        ReactivationReadbackRefused {
          cause: "spark_serving_reactivation_readback: the invocation is unchanged, so the process the drain fenced was never replaced" as NonEmptyStr,
        }
      } else if (registered_definition as String) != (fence.desired_definition as String) {
        ReactivationReadbackRefused {
          cause: "spark_serving_reactivation_readback: the definition registered on the host is not the desired one, so the next activation would be wrong again" as NonEmptyStr,
        }
      } else {
        spark_serving_readback_definition_half(
          fence: fence,
          post_invocation: j1,
          post_definition: post_definition,
          health: health,
          replan: replan,
        )
      }
  }
}

// THE REMAINING THREE CONJUNCTS. Split out for the same reason the admission recheck is: one
// function per decision keeps the refusal causes attributable to the conjunct that failed.
fn spark_serving_readback_definition_half(
  fence: ServingDrainFence,
  post_invocation: NonEmptyStr,
  post_definition: SparkServingRunningDefinition,
  health: ServingPostRestartHealth,
  replan: ServingReplanStanding,
) -> ServingReactivationReadback {
  match post_definition {
    RunningDefinitionNotRunning =>
      ReactivationReadbackRefused {
        cause: "spark_serving_reactivation_readback: the restarted unit reports no running definition because it is not running" as NonEmptyStr,
      }
    RunningDefinitionUnstamped =>
      ReactivationReadbackRefused {
        cause: "spark_serving_reactivation_readback: the restarted process carries no definition identity, so it cannot be established as started from the desired definition" as NonEmptyStr,
      }
    RunningDefinitionUnobserved { cause: why } =>
      ReactivationReadbackRefused {
        cause: join([
          "spark_serving_reactivation_readback: the post-restart definition was not observed — ",
          why as String,
        ], "") as NonEmptyStr,
      }
    RunningDefinitionObserved { definition_identity: d1 } =>
      if (d1 as String) != (fence.desired_definition as String) {
        ReactivationReadbackRefused {
          cause: "spark_serving_reactivation_readback: the restarted process was started from a definition that is not the desired one" as NonEmptyStr,
        }
      } else {
        spark_serving_readback_health_half(
          fence: fence,
          post_invocation: post_invocation,
          post_definition: d1,
          health: health,
          replan: replan,
        )
      }
  }
}

fn spark_serving_readback_health_half(
  fence: ServingDrainFence,
  post_invocation: NonEmptyStr,
  post_definition: NonEmptyStr,
  health: ServingPostRestartHealth,
  replan: ServingReplanStanding,
) -> ServingReactivationReadback {
  match health {
    PostRestartHealthUnobserved { cause: why } =>
      ReactivationReadbackRefused {
        cause: join([
          "spark_serving_reactivation_readback: post-restart health was not observed — ",
          why as String,
        ], "") as NonEmptyStr,
      }
    PostRestartUnhealthy { cause: why } =>
      ReactivationReadbackRefused {
        cause: join([
          "spark_serving_reactivation_readback: the restarted service is not healthy — ",
          why as String,
        ], "") as NonEmptyStr,
      }
    PostRestartHealthy { invocation: hj } =>
      if (hj as String) != (post_invocation as String) {
        ReactivationReadbackRefused {
          cause: "spark_serving_reactivation_readback: the health reading belongs to a different invocation than the one the restart produced" as NonEmptyStr,
        }
      } else {
        match replan {
          ReplanUnobserved { cause: why } =>
            ReactivationReadbackRefused {
              cause: join([
                "spark_serving_reactivation_readback: the replan was not observed, and exit zero is not convergence — ",
                why as String,
              ], "") as NonEmptyStr,
            }
          ReplanNonEmpty { rows: n } =>
            ReactivationReadbackRefused {
              cause: join([
                "spark_serving_reactivation_readback: the replan is not empty — ",
                to_string(n),
                " row(s) remain, so the service has not converged",
              ], "") as NonEmptyStr,
            }
          ReplanEmpty =>
            ReactivationConfirmed {
              reopened: AdmissionOpen {
                locus: fence.locus,
                admitted_invocation: post_invocation,
                admitted_definition: post_definition,
              },
            }
        }
      }
  }
}

// WHAT PRODUCTION CAN HONESTLY SUPPLY TODAY, STATED AS A VALUE RATHER THAN AS PROSE.
//
// Two authorities the protocol needs do not exist in this repository: nothing persists a locus
// admission state, so there is no `Open` to compare and swap against, and nothing observes the
// complete active-turn population at a serving locus, so no census could speak for the service even
// if a fence could be held. The production caller in gunbc.spark.serving_converge_slice_wet therefore
// reaches the guarded producer through THIS function, which answers with the drain verdict that is
// true of the tree as it stands: the occupancy grain is unmodeled and the destructive restart
// refuses.
//
// It is not a stub and it does not widen. It is the DrainOccupancyUnmodeled arm reached with its own
// cause, so the receipt for every host says which capability is missing rather than falling silent
// or fabricating a quiescent reading.
//
// THE TRIGGER THAT RETIRES IT is a lease authority that admits every turn at a serving locus and can
// enumerate the population held there, joined to a persisted admission state the fence can swap. A
// probe that counts requests is not it: a count taken outside a held fence is the reading this whole
// module exists to refuse.
fn spark_serving_unfenced_production_drain(locus: ServingServiceLocus) -> ServingDrainVerdict {
  DrainOccupancyUnmodeled {
    cause: join([
      "spark_serving_unfenced_production_drain: no admission-state authority and no active-turn population exist for ",
      serving_locus_label(locus: locus),
      " — the fence cannot be held and a lease census could not speak for the service, so the destructive restart refuses",
    ], "") as NonEmptyStr,
  }
}
