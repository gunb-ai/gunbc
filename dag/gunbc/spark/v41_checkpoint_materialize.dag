// ── THE PUBLISHED V4.1 FILES ON ONE SPARK, AS PER-FILE DIGEST-KEYED SUBJECTS ───────────────────
//
// WHAT THIS IS. gunbc.spark.model_snapshot_acquisition named the stronger form of a snapshot
// acquisition and left it unbuilt: once a per-file digest manifest exists, "each shard becomes its
// own ContentDigestSha256 subject over the same combinator and nothing here changes shape". The V4.1
// manifest is that manifest -- extdeps.deepseek.deepseek_v4_1_flash admits 48 shards against the
// index's shard set, plus the index file itself, plus the tokenizer population, every row carrying the
// publisher's sha256 and size. So this module adds no acquisition algorithm: each admitted row is one
// subject, gunbc.artifact_acquisition acquire_artifact is the fold, and the handler slots are bound to
// one Spark through gunbc.spark.model_snapshot_materialize's remote leg and transfer supervision.
//
// THE POPULATION IS THE ADMISSION, NEVER THE RAW ROWS. A refused manifest or tokenizer population is a
// refusal here, before any host is contacted -- the same standing the candidate keys by, so the files
// that land are exactly the files the model_source axis names.
//
// OBSERVE, THEN DECIDE, THEN FETCH. The operator does not know what srv5..srv8 hold, so the run
// observes EVERY row first (presence, then sha256 over the bytes on disk). Only then does it act:
//   - any installed file whose digest disagrees with its row refuses the WHOLE run before a byte is
//     fetched, and nothing is removed -- a wrong file at that path is a fact to investigate, which is
//     acquire_artifact's own InstalledCopyFailsItsKey rule applied to the population;
//   - the bytes still missing are summed from the rows and compared against the free space the
//     install root's filesystem reports; short refuses before fetching, naming both figures;
//   - files already present with the right digest are receipts, not fetches (noop).
// A fetch stages to `<path>.part`, verifies the staged bytes against the row, and only then renames
// into place. A staged file that fails its digest is the only thing ever deleted, and it was never
// a right file.
//
// TRANSPORT. One source per file: the Hub's `/resolve/<revision>/<path>` (extdeps.huggingface.hub
// hub_resolve_url) at the pinned revision, fetched with curl on the host. The fetch-once-then-rail
// replicate shape gunbc.spark.model_snapshot_acquisition argues for is a second ordered source on the
// same subject (rail peer first, Hub behind it); it is not built here because the rail arm in
// gunbc.spark.model_snapshot_materialize spark_materialize_member is itself unrealized, and the brief
// for this lane names the Hub route. With per-file digests a rail source is as safe as the Hub one,
// so adding it later changes a source list and nothing else.

data v41_checkpoint_subject_identity_prefix: NonEmptyStr = "deepseek-v4.1-flash:" as NonEmptyStr
data v41_checkpoint_hub_source_identity: NonEmptyStr = "huggingface-hub-resolve" as NonEmptyStr
data v41_checkpoint_materialize_attempt_raw: String = "v41-checkpoint-materialize"
data v41_checkpoint_materialize_receipt_path: String = "target/v41-checkpoint-materialize-receipt.txt"
data v41_checkpoint_staging_suffix: NonEmptyStr = ".part" as NonEmptyStr

// THE CLAIM'S BOUND AND PURPOSE. 510 GB over a Spark's radio is hours; twelve hours is the term past
// which an unreleased claim reads OVERDUE (it still fences until released).
data v41_checkpoint_host_purpose: NonEmptyStr = "materializing the published DeepSeek V4.1 Flash files (510 GB), which occupies the host's uplink for hours" as NonEmptyStr
data v41_checkpoint_host_effect_term: Second = second(count: 43200)

// ── THE ADMITTED POPULATION ────────────────────────────────────────────────────────────────────

type V41CheckpointPopulation
  = V41CheckpointPopulationAdmitted { files: List<DeepseekV41PublishedFile>, install_root: NonEmptyStr }
  | V41CheckpointPopulationRefused { defects: List<NonEmptyStr> }

// Shards, the index and the tokenizer files, from the two admissions, into the one install root the
// snapshot row's placement derives.
fn v41_checkpoint_population() -> V41CheckpointPopulation {
  match deepseek_v4_1_flash_snapshot {
    ModelSnapshotUnpinned { identity: _, repo: _, cause: c } => V41CheckpointPopulationRefused { defects: [c] }
    ModelSnapshotPinned { identity: _, repo: r, revision: rev, placement: pl, revision_provenance: _ } =>
      match deepseek_v4_1_flash_weight_manifest_standing() {
        WeightManifestRefused { defects: d } => V41CheckpointPopulationRefused { defects: d }
        WeightManifestAdmitted { files: shards, index: index, canonical_text: _ } =>
          match deepseek_v4_1_flash_tokenizer_standing() {
            TokenizerPopulationRefused { defects: d } => V41CheckpointPopulationRefused { defects: d }
            TokenizerPopulationAdmitted { files: tok, canonical_text: _ } =>
              V41CheckpointPopulationAdmitted {
                files: concat(concat(shards, [index]), tok),
                install_root: snapshot_install_path(placement: pl, repo: r, revision: rev),
              }
          }
      }
  }
}

fn v41_population_bytes(files: List<DeepseekV41PublishedFile>) -> Nat {
  fold(files, init: 0, f: (acc, r) => acc + byte_size_count(b: r.file_bytes))
}

// ── ONE ROW AS ONE SUBJECT ─────────────────────────────────────────────────────────────────────

fn v41_install_path(root: NonEmptyStr, file: DeepseekV41PublishedFile) -> NonEmptyStr {
  join([root as String, "/", file.path as String], "") as NonEmptyStr
}

// The parent of the install path: the root for a top-level file, `<root>/encoding` for the encoder.
fn v41_parent_directory(root: NonEmptyStr, file: DeepseekV41PublishedFile) -> NonEmptyStr {
  let segments = split(s: file.path as String, delimiter: "/")
  if length(segments) <= 1 {
    root
  } else {
    join([root as String, "/", join(segments |> take(n: length(segments) - 1), "/")], "") as NonEmptyStr
  }
}

fn v41_staging_path(root: NonEmptyStr, file: DeepseekV41PublishedFile) -> NonEmptyStr {
  join([v41_install_path(root: root, file: file) as String, v41_checkpoint_staging_suffix as String], "") as NonEmptyStr
}

// THE FETCH ARGV. `--fail` so an HTTP error is a non-zero exit and never an error page written as
// the file; `--location` because /resolve/ redirects to the content store; retries for the radio.
fn v41_fetch_argv(file: DeepseekV41PublishedFile, staging: NonEmptyStr) -> List<String> {
  [
    "curl", "--fail", "--location", "--silent", "--show-error",
    "--retry", "5", "--retry-delay", "10", "--continue-at", "-",
    "--output", staging as String,
    hub_resolve_url(repo: deepseek_v4_1_flash_hub_repo, revision: deepseek_v4_1_flash_revision, path_in_repo: file.path) as String,
  ]
}

fn v41_checkpoint_subject(root: NonEmptyStr, file: DeepseekV41PublishedFile) -> AcquisitionSubject {
  let staging = v41_staging_path(root: root, file: file)
  AcquisitionSubject {
    identity: join([v41_checkpoint_subject_identity_prefix as String, file.path as String], "") as NonEmptyStr,
    key: ContentDigestSha256 { hex: file.sha256.hex as NonEmptyStr },
    install_path: v41_install_path(root: root, file: file),
    staging_path: Present { value: staging },
    parent_directory: v41_parent_directory(root: root, file: file),
    sources: [AcquisitionSource {
      identity: v41_checkpoint_hub_source_identity,
      locator: SourceArgv { argv: v41_fetch_argv(file: file, staging: staging) },
    }],
  }
}

// ── READING A DIGEST ON THE HOST ───────────────────────────────────────────────────────────────
//
// THREE ANSWERS AND NOT TWO: the digest the bytes have, the file not being there, or the instrument
// not answering. The last is never read as either of the first two.
type V41RemoteDigest
  = V41RemoteDigestRead { hex: String }
  | V41RemoteFileAbsent
  | V41RemoteDigestUnread { reason: NonEmptyStr }

fn v41_remote_sha256(ctx: SparkMaterializeContext, path: NonEmptyStr) -> V41RemoteDigest {
  match spark_remote_run(ctx: ctx, argv: ["test", "-f", path as String]) {
    RemoteUnreachable { cause: c } => V41RemoteDigestUnread { reason: c as NonEmptyStr }
    RemoteRan { exit_code: present, stdout: _, stderr: _ } =>
      if present != 0 {
        V41RemoteFileAbsent
      } else {
        match spark_remote_run(ctx: ctx, argv: ["sha256sum", "--", path as String]) {
          RemoteUnreachable { cause: c } => V41RemoteDigestUnread { reason: c as NonEmptyStr }
          RemoteRan { exit_code: code, stdout: out, stderr: err } =>
            if code != 0 {
              V41RemoteDigestUnread { reason: join(["sha256sum exited ", to_string(code), ": ", err], "") as NonEmptyStr }
            } else {
              match split(s: out, delimiter: " ").first() {
                Absent => V41RemoteDigestUnread { reason: "sha256sum answered nothing" as NonEmptyStr }
                Present { value: hex } =>
                  if length(chars(hex)) == 64 {
                    V41RemoteDigestRead { hex: hex }
                  } else {
                    V41RemoteDigestUnread { reason: join(["sha256sum answered a word that is not a sha256 digest: ", hex], "") as NonEmptyStr }
                  }
              }
            }
        }
      }
  }
}

fn v41_observe(ctx: SparkMaterializeContext, subject: AcquisitionSubject) -> AcquisitionObservation {
  match v41_remote_sha256(ctx: ctx, path: subject.install_path) {
    V41RemoteFileAbsent => AcquisitionAbsent
    V41RemoteDigestUnread { reason: r } => AcquisitionProbeFailed { reason: r }
    V41RemoteDigestRead { hex: h } =>
      if h == (acquisition_key_wire(key: subject.key) as String) { AcquisitionVerified } else { AcquisitionDigestMismatch }
  }
}

fn v41_ensure_parent(ctx: SparkMaterializeContext, subject: AcquisitionSubject) -> Bool {
  match spark_remote_run(ctx: ctx, argv: ["mkdir", "-p", subject.parent_directory as String]) {
    RemoteUnreachable { cause: _ } => false
    RemoteRan { exit_code: e, stdout: _, stderr: _ } => e == 0
  }
}

// ── ONE ATTEMPT: SUPERVISED TRANSFER, VERIFY THE STAGED BYTES, PUBLISH ─────────────────────────

fn v41_staging_of(subject: AcquisitionSubject) -> NonEmptyStr {
  match subject.staging_path {
    Present { value: s } => s
    Absent => join([subject.install_path as String, v41_checkpoint_staging_suffix as String], "") as NonEmptyStr
  }
}

fn v41_attempt(ctx: SparkMaterializeContext, subject: AcquisitionSubject, origin: AcquisitionSource) -> AcquisitionAttempt {
  match origin.locator {
    SourceUrl { url: u } => AttemptRejected { detail: join(["this handler executes an argv on the host and was handed a URL locator: ", u as String], "") as NonEmptyStr }
    SourceArgv { argv: a } =>
      match spark_transfer_state(ctx: ctx, subject: subject) {
        TransferStateUnreadable { cause: _ } => AttemptUnreachable
        TransferRunning => v41_after_transfer(ctx: ctx, subject: subject, origin: origin)
        TransferExitedClean => if spark_transfer_clear(ctx: ctx, subject: subject) { v41_start(ctx: ctx, subject: subject, origin: origin, argv: a) } else { AttemptUnreachable }
        TransferExitedFailed { status: _ } => if spark_transfer_clear(ctx: ctx, subject: subject) { v41_start(ctx: ctx, subject: subject, origin: origin, argv: a) } else { AttemptUnreachable }
        TransferAbsent => v41_start(ctx: ctx, subject: subject, origin: origin, argv: a)
      }
  }
}

fn v41_start(ctx: SparkMaterializeContext, subject: AcquisitionSubject, origin: AcquisitionSource, argv: List<String>) -> AcquisitionAttempt {
  match spark_transfer_start_argv(ctx: ctx, subject: subject, argv: argv) {
    TransferStartUnreachable { cause: _ } => AttemptUnreachable
    TransferStartRejected { detail: d } => AttemptRejected { detail: d }
    TransferStarted => v41_after_transfer(ctx: ctx, subject: subject, origin: origin)
  }
}

fn v41_after_transfer(ctx: SparkMaterializeContext, subject: AcquisitionSubject, origin: AcquisitionSource) -> AcquisitionAttempt {
  match spark_transfer_supervise(ctx: ctx, subject: subject, remaining: spark_transfer_poll_budget) {
    SupervisionLost { cause: _ } => AttemptUnreachable
    SupervisedStillRunning { polls: n } =>
      AttemptTerminal { outcome: AcquisitionRefused { cause: VerifyMechanismFailed {
        identity: subject.identity, source: origin.identity,
        reason: join(["the transfer is STILL RUNNING after ", to_string(n), " polls and was not killed; re-run to reattach"], "") as NonEmptyStr,
      } } }
    SupervisedExitFailed { status: st } =>
      AttemptRejected { detail: join(["the fetch unit exited with status ", st], "") as NonEmptyStr }
    SupervisedTransferUnitAbsent => v41_verify_and_publish(ctx: ctx, subject: subject, origin: origin)
    SupervisedExitClean => v41_verify_and_publish(ctx: ctx, subject: subject, origin: origin)
  }
}

// THE STAGED BYTES ARE CHECKED AGAINST THE ROW BEFORE THEY ARE KEPT. A mismatch deletes the staged
// file (it was never right) and answers AttemptFailedKey, so the fold reports "reached and wrong"
// rather than "unreachable". A digest that could not be read is a verify-mechanism refusal, never a
// mismatch.
fn v41_verify_and_publish(ctx: SparkMaterializeContext, subject: AcquisitionSubject, origin: AcquisitionSource) -> AcquisitionAttempt {
  let staging = v41_staging_of(subject: subject)
  match v41_remote_sha256(ctx: ctx, path: staging) {
    V41RemoteFileAbsent =>
      AttemptTerminal { outcome: AcquisitionRefused { cause: VerifyMechanismFailed { identity: subject.identity, source: origin.identity, reason: join(["the fetch exited cleanly and left no staged file at ", staging as String], "") as NonEmptyStr } } }
    V41RemoteDigestUnread { reason: r } =>
      AttemptTerminal { outcome: AcquisitionRefused { cause: VerifyMechanismFailed { identity: subject.identity, source: origin.identity, reason: r } } }
    V41RemoteDigestRead { hex: h } =>
      if h != (acquisition_key_wire(key: subject.key) as String) {
        let removed = spark_remote_run(ctx: ctx, argv: ["rm", "-f", "--", staging as String])
        AttemptFailedKey
      } else {
        match spark_remote_run(ctx: ctx, argv: ["mv", "-n", "--", staging as String, subject.install_path as String]) {
          RemoteUnreachable { cause: _ } => AttemptTerminal { outcome: AcquisitionRefused { cause: PublishFailed { identity: subject.identity, source: origin.identity, install_path: subject.install_path } } }
          RemoteRan { exit_code: e, stdout: _, stderr: _ } =>
            if e == 0 {
              AttemptTerminal { outcome: AcquisitionFetched { identity: subject.identity, install_path: subject.install_path, source: origin } }
            } else {
              AttemptTerminal { outcome: AcquisitionRefused { cause: PublishFailed { identity: subject.identity, source: origin.identity, install_path: subject.install_path } } }
            }
        }
      }
  }
}

fn v41_checkpoint_handler(ctx: SparkMaterializeContext) -> AcquisitionHandler {
  AcquisitionHandler {
    observe: fn(subject) { v41_observe(ctx: ctx, subject: subject) },
    ensure_parent: fn(subject) { v41_ensure_parent(ctx: ctx, subject: subject) },
    attempt: fn(subject, origin) { v41_attempt(ctx: ctx, subject: subject, origin: origin) },
  }
}

// ── THE POPULATION PLAN: OBSERVE ALL, THEN DECIDE ──────────────────────────────────────────────

type V41FileObservation sole_constructor {
  file: DeepseekV41PublishedFile
  subject: AcquisitionSubject
  observation: AcquisitionObservation
}

type V41CheckpointPlan
  = V41PlanFetch { present: List<V41FileObservation>, missing: List<V41FileObservation>, missing_bytes: Nat, available_bytes: Nat }
  | V41PlanRefused { reason: String, observed: List<V41FileObservation> }

fn v41_is_absent(o: V41FileObservation) -> Bool {
  match o.observation { AcquisitionAbsent => true  _ => false }
}

fn v41_is_verified(o: V41FileObservation) -> Bool {
  match o.observation { AcquisitionVerified => true  _ => false }
}

fn v41_is_mismatch(o: V41FileObservation) -> Bool {
  match o.observation { AcquisitionDigestMismatch => true  _ => false }
}

fn v41_probe_failures(obs: List<V41FileObservation>) -> List<String> {
  fold(obs, init: [] as List<String>, f: (acc, o) => match o.observation {
    AcquisitionProbeFailed { reason: r } => concat(acc, [join([o.file.path as String, ": ", r as String], "")])
    _ => acc
  })
}

// FREE BYTES ON THE INSTALL ROOT'S FILESYSTEM. The root may not exist yet, so the nearest existing
// ancestor is asked: `df` resolves the filesystem of the path it is given, and the parents are made
// before the read so the answer is about the filesystem the files will land on.
type V41FreeSpace
  = V41FreeSpaceRead { bytes: Nat }
  | V41FreeSpaceUnread { reason: String }

fn v41_free_bytes(ctx: SparkMaterializeContext, root: NonEmptyStr) -> V41FreeSpace {
  match spark_remote_run(ctx: ctx, argv: ["mkdir", "-p", root as String]) {
    RemoteUnreachable { cause: c } => V41FreeSpaceUnread { reason: c }
    RemoteRan { exit_code: e, stdout: _, stderr: err } =>
      if e != 0 {
        V41FreeSpaceUnread { reason: join(["the install root could not be created: ", err], "") }
      } else {
        match spark_remote_run(ctx: ctx, argv: ["df", "--output=avail", "-B1", root as String]) {
          RemoteUnreachable { cause: c } => V41FreeSpaceUnread { reason: c }
          RemoteRan { exit_code: code, stdout: out, stderr: err2 } =>
            if code != 0 {
              V41FreeSpaceUnread { reason: join(["df exited ", to_string(code), ": ", err2], "") }
            } else {
              match split(s: out, delimiter: "\n") |> skip(n: 1) |> first() {
                Absent => V41FreeSpaceUnread { reason: join(["df answered no value line: ", out], "") }
                Present { value: line } =>
                  match parse_int(s: trim(s: line)) {
                    Absent => V41FreeSpaceUnread { reason: join(["df's value line is not a number: ", line], "") }
                    Present { value: n } => if n < 0 { V41FreeSpaceUnread { reason: "df answered a negative figure" } } else { V41FreeSpaceRead { bytes: n } }
                  }
              }
            }
        }
      }
  }
}

// THE DECISION, PURE OVER THE OBSERVATIONS AND THE FREE-SPACE READING, so a witness exercises every
// arm by supplying them. Mismatch dominates: a wrong file is investigated before anything is added.
fn v41_checkpoint_decide(observed: List<V41FileObservation>, free: V41FreeSpace) -> V41CheckpointPlan {
  let mismatched = filter(observed, o => v41_is_mismatch(o: o))
  let unread = v41_probe_failures(obs: observed)
  let missing = filter(observed, o => v41_is_absent(o: o))
  let need = fold(missing, init: 0, f: (acc, o) => acc + byte_size_count(b: o.file.file_bytes))
  if length(mismatched) != 0 {
    V41PlanRefused { reason: join(["installed files disagree with their manifest rows and are left in place for investigation; nothing was fetched: ", join(map(mismatched, o => o.subject.install_path as String), ", ")], ""), observed: observed }
  } else if length(unread) != 0 {
    V41PlanRefused { reason: join(["some installed files could not be read, so the population is unobserved and nothing was fetched: ", join(unread, "; ")], ""), observed: observed }
  } else if need == 0 {
    V41PlanFetch { present: filter(observed, o => v41_is_verified(o: o)), missing: missing, missing_bytes: 0, available_bytes: 0 }
  } else {
    match free {
      V41FreeSpaceUnread { reason: r } => V41PlanRefused { reason: join(["the free space on the install root could not be read, so the ", to_string(need), " missing bytes were not fetched: ", r], ""), observed: observed }
      V41FreeSpaceRead { bytes: avail } =>
        if avail < need {
          V41PlanRefused { reason: join(["the install root's filesystem has ", to_string(avail), " bytes free and the missing files need ", to_string(need), "; nothing was fetched"], ""), observed: observed }
        } else {
          V41PlanFetch { present: filter(observed, o => v41_is_verified(o: o)), missing: missing, missing_bytes: need, available_bytes: avail }
        }
    }
  }
}

// ── RECEIPTS ───────────────────────────────────────────────────────────────────────────────────

fn v41_observation_word(o: AcquisitionObservation) -> String {
  match o {
    AcquisitionAbsent => "absent"
    AcquisitionVerified => "verified"
    AcquisitionDigestMismatch => "digest-mismatch"
    AcquisitionProbeFailed { reason: _ } => "unread"
  }
}

fn v41_outcome_line(file: DeepseekV41PublishedFile, outcome: AcquisitionOutcome) -> String {
  let head = join(["file ", file.path as String, " sha256=", file.sha256.hex as String, " bytes=", to_string(byte_size_count(b: file.file_bytes))], "")
  match outcome {
    AcquisitionAlreadyPresent { identity: _, install_path: p } => join([head, " outcome=noop-verified path=", p as String, "\n"], "")
    AcquisitionFetched { identity: _, install_path: p, source: s } => join([head, " outcome=fetched-verified source=", s.identity as String, " path=", p as String, "\n"], "")
    AcquisitionRefused { cause: c } => join([head, " outcome=refused cause=", acquisition_refusal_text(cause: c), "\n"], "")
  }
}

fn v41_observed_line(o: V41FileObservation) -> String {
  join(["file ", o.file.path as String, " sha256=", o.file.sha256.hex as String, " bytes=", to_string(byte_size_count(b: o.file.file_bytes)), " observed=", v41_observation_word(o: o.observation), "\n"], "")
}

// ── THE RUN ON ONE HOST ────────────────────────────────────────────────────────────────────────

type V41CheckpointRun sole_constructor {
  receipt: String
  converged: Bool
}

fn v41_materialize_on(ctx: SparkMaterializeContext, files: List<DeepseekV41PublishedFile>, root: NonEmptyStr) -> V41CheckpointRun {
  let handler = v41_checkpoint_handler(ctx: ctx)
  let observed = map(files, f => {
    let s = v41_checkpoint_subject(root: root, file: f)
    V41FileObservation { file: f, subject: s, observation: v41_observe(ctx: ctx, subject: s) }
  })
  let requirement = join(["population files=", to_string(length(files)), " bytes=", to_string(v41_population_bytes(files: files)), " root=", root as String, "\n"], "")
  let free = if any(observed, o => v41_is_absent(o: o)) { v41_free_bytes(ctx: ctx, root: root) } else { V41FreeSpaceRead { bytes: 0 } }
  match v41_checkpoint_decide(observed: observed, free: free) {
    V41PlanRefused { reason: why, observed: obs } =>
      V41CheckpointRun { receipt: join([requirement, join(map(obs, o => v41_observed_line(o: o)), ""), "refused ", why, "\n"], ""), converged: false }
    V41PlanFetch { present: present, missing: missing, missing_bytes: need, available_bytes: avail } => {
      let kept = map(present, o => v41_outcome_line(file: o.file, outcome: AcquisitionAlreadyPresent { identity: o.subject.identity, install_path: o.subject.install_path }))
      let fetched = map(missing, o => {
        let outcome = acquire_artifact(subject: o.subject, handler: handler)
        V41CheckpointRun { receipt: v41_outcome_line(file: o.file, outcome: outcome), converged: acquisition_succeeded(outcome: outcome) }
      })
      V41CheckpointRun {
        receipt: join([
          requirement,
          join(["missing bytes=", to_string(need), " free bytes=", to_string(avail), "\n"], ""),
          join(kept, ""),
          join(map(fetched, r => r.receipt), ""),
        ], ""),
        converged: all(fetched, r => r.converged),
      }
    }
  }
}

// WHAT A CRASHED RUN LEAVES: a curl still writing a staged file under the install root.
fn v41_checkpoint_residue(root: NonEmptyStr) -> HostEffectResidueSpec {
  HostEffectResidueSpec { process_pattern: root, container: none }
}

// THE FLEET-CONVERGE DOOR: `spark_v41_checkpoint_materialize` with `target` naming ONE Spark. It
// refuses rather than choosing a host, because a run occupies that host's uplink for hours.
fn v41_checkpoint_materialize_ci_wet() -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  match v41_checkpoint_population() {
    V41CheckpointPopulationRefused { defects: d } => exit_failure(reason: join(["the V4.1 file population is not admitted, so no host was contacted: ", join(map(d, x => x as String), "; ")], ""))
    V41CheckpointPopulationAdmitted { files: files, install_root: root } =>
      match spark_converge_target_selection(execute_apply: true) {
        SparkConvergeTargetRefused { reason: why } => exit_failure(reason: why)
        SparkConvergeTargetAllObserveOnly =>
          exit_failure(reason: "SPARK_CONVERGE_TARGET is unset: materializing 510 GB occupies one host for hours, so it refuses rather than choosing one")
        SparkConvergeTargetSingle { host: host } =>
          match admit_unplaced_host_live(term: v41_checkpoint_host_effect_term, raw: host as String, purpose: v41_checkpoint_host_purpose, residue: v41_checkpoint_residue(root: root)) {
            SparkHostRefused { cause: why } => exit_failure(reason: why as String)
            SparkHostAdmitted { host: _, claim: claim } =>
              release_host_effect_live(handle: claim, exit: {
                match with_spark_build_host(
                  host: host,
                  attempt_raw: v41_checkpoint_materialize_attempt_raw,
                  identity_file_name: "gunbc-v41-checkpoint-materialize-admin-password" as NonEmptyStr,
                  use: fn(target, context, ctx) {
                    let run = v41_materialize_on(ctx: ctx, files: files, root: root)
                    SparkBuildHostWork { receipt: run.receipt, converged: run.converged }
                  },
                ) {
                  SparkBuildHostRefused { cause: c } => exit_failure(reason: c)
                  SparkBuildHostRan { work: work, endpoint: endpoint, executor: executor, trust_receipt: trust_receipt } => {
                    let body = join([
                      join(["v41 checkpoint materialize probed_at=", probed_at_word(reading: now) as String, " host=", host as String, " endpoint=", endpoint as String, " executor=", executor, " revision=", deepseek_v4_1_flash_revision as String, "\n"], ""),
                      trust_receipt,
                      work.receipt,
                    ], "")
                    let w = Filesystem.Write(path: v41_checkpoint_materialize_receipt_path, content: body)
                    if !w.success {
                      exit_failure(reason: join(["v41 checkpoint materialize receipt write failed: ", w.error], ""))
                    } else if work.converged {
                      ExitSuccess
                    } else {
                      exit_failure(reason: join(["the V4.1 published files did not converge:\n", body], ""))
                    }
                  }
                }
              })
          }
      }
  }
}
