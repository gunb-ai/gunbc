module gunbc.spark.serving_load_probe_cli

import std.types { NonEmptyStr, String }
import std.process { ProcessExit }
import gunbc.fleet_intent_network { operator_host_srv9, srv9_host_lan_endpoint }
import gunbc.spark.serving_arm_launch { glm_native_container_name }
import gunbc.spark.glm_group_b_relaunch_cli { with_group_b_access, rank_context }
import gunbc.spark.fabric_switch_observed { FabricGroupB }
import gunbc.spark.serving_arm { glm_native_concurrent_profile }
import gunbc.spark.serving_load_probe {
  glm_native_serve_base_url,
  glm_native_live_subject_standing,
  glm_native_smoke_protocol,
}
import gunbc.spark.serving_load_runner { ServingLoadSubject, serving_load_run }
//
// GLM's binding of the shared serving-load runner (gunbc.spark.serving_load_runner): its subject,
// its access bracket (group B) and its one step, the c=2 smoke protocol. A non-idle drain REFUSES
// the start; an idle start is WindowIsolationNotEstablished. Qualification is a declared frontier
// (request start events, reserved-window lease/exclusion, interval occupancy, serve.py digest).
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/spark/serving_load_probe_cli.dag --function glm_native_serving_load_wet

data glm_native_serving_load_receipt_path: String = "target/glm-native-serving-load-observation.txt"
data glm_native_serving_load_attempt_raw: String = "glm-native-serving-load"

fn glm_native_serving_load_subject() -> ServingLoadSubject {
  ServingLoadSubject {
    host: operator_host_srv9,
    host_address: srv9_host_lan_endpoint.address,
    group: FabricGroupB,
    container: glm_native_container_name,
    base_url: glm_native_serve_base_url(),
    served_alias: glm_native_concurrent_profile.served_alias,
    standing: glm_native_live_subject_standing(),
    principal: "group-B administrator" as NonEmptyStr,
    receipt_heading: "glm native serving-load wet" as NonEmptyStr,
    receipt_path: glm_native_serving_load_receipt_path,
  }
}

fn glm_native_serving_load_wet() -> ProcessExit
{
  with_group_b_access(use: fn(trust, path, administrator, file) {
    let ctx = rank_context(host: operator_host_srv9, trust: trust, path: path, administrator: administrator, credential_file: file)
    serving_load_run(ctx: ctx, subject: glm_native_serving_load_subject(), steps: [glm_native_smoke_protocol])
  }, attempt_raw: glm_native_serving_load_attempt_raw, credential_file_name: "gunbc-glm-native-serving-load-admin-password" as NonEmptyStr)
}
