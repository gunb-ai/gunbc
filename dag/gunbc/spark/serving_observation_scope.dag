module gunbc.spark.serving_observation_scope

import std.types { Bool, Int, List, NonEmptyStr }
import product.placement_supply { HostIdentity, host_identity_eq }
import gunbc.spark.dgx_procurement { dgx_spark_reserved_identities }

data spark_serving_observation_scope_note: NonEmptyStr = "SPARK-PAIR-0 P0-C. WHICH PHYSICAL SPARK UNITS MUST BE INSPECTED is a different fact from which of them should serve, and this module owns the first one. It exists because fusing them was a live defect: the serving observer enumerated spark_serving_desired_hosts, which was correct only while desired named every Spark, and became wrong the moment desired grew a role scope." as NonEmptyStr

// THE OBSERVATION DENOMINATOR IS PHYSICAL, NOT ROLE-DERIVED, AND THAT IS THE WHOLE POINT.
//
// The defect this replaces: the observer walked the DESIRED serving roster. Retirement is planned from
// members that are observed and NOT desired, so scoping observation by desired makes the retirement
// population unobservable by construction -- observed minus desired is empty for every host, always.
// srv6 ran a live, enabled serving unit and the observer never probed it. Measured, not reasoned:
// fleet-converge run 33296910990 reported observed_hosts=1.
//
// THE ZERO-BYTE PLAN WIRE IN RUN 33297525985 IS A DIFFERENT DEFECT AND IS NOT EVIDENCE FOR THIS ONE.
// It was tempting to chain them -- narrowed observation, therefore no removals, therefore an empty
// plan -- and that chain is false in the live dataflow: fleet_converge_plan_cli passes
// observed_spark: [] and fleet_converge_plan_artifact sets spark_serving_typed_actions to
// scheduled_rows_empty() unconditionally, so the live planner reads NO Spark observer and would have
// emitted an empty wire whatever this module answered. The two defects are independent, they are
// repaired separately, and welding them into one story would have made a fix here look like a fix
// there.
//
// The obvious repair -- union the two ROLE rosters -- is rejected here, and rejecting it is the reason
// this module exists rather than a one-line edit. Both role projections answer through
// a unique role and deliberately dropped the ambiguous and absent arms, so their
// concatenation silently omits a host whose role assignment is broken. But an absent or contradictory
// ROLE says nothing about whether a serving PROCESS is running on the metal; a broken assignment is
// precisely when stale serving state most needs to stay visible. That repair would have fixed today's
// srv6 and preserved the class one input away.
//
// So the scope reads the procurement authority, which derives the enrolled Spark identities from the
// router bindings and knows nothing about roles. Roles then decide what may be DONE to a host; they do
// not decide whether it is LOOKED AT.
fn spark_serving_observation_scope() -> List<HostIdentity> {
  dgx_spark_reserved_identities()
}

// ENROLLMENT IS ONE FACT, SO IT IS CLASSIFIED ONCE AND READ TWICE.
//
// The plan CLI and the apply CLI each need to know whether the subject is an enrolled Spark that
// nobody observed, and each of them first grew its own `host_in(spark_serving_observation_scope())`
// test. Two derivations of one fact is the §3 violation in miniature: they agree today and there is
// nothing that makes them agree tomorrow, so narrowing the scope in one place would silently leave
// the other actuating. This is the single authority; the two CLIs map its arms onto their own
// dispositions and neither re-derives the predicate.
//
// It is a coproduct rather than a Bool because the arms are read for different reasons and a bare
// Bool would need a comment to say which way round it points. Each arm carries the host so the
// disposition it becomes can name the subject without a second lookup.
//
// THE ENROLLED ARM IS NAMED FOR WHAT THIS PRODUCER KNOWS, WHICH IS ENROLLMENT AND NOTHING ELSE.
// It was briefly called SparkServingHostEnrolledUnobserved, which folded a second fact into the
// name: whether a transaction exists is decided later, by a consumer that has one or does not.
// Once the observer is wired, that name would have said "unobserved" about a host just observed --
// a nickname for a disposition, minted by something that cannot see it.
type SparkServingEnrollment
  = SparkServingHostEnrolled { host: HostIdentity }
  | SparkServingHostNotEnrolled { host: HostIdentity }

fn spark_serving_enrollment(host: HostIdentity) -> SparkServingEnrollment {
  if host_in(hosts: spark_serving_observation_scope(), host: host) {
    SparkServingHostEnrolled { host: host }
  } else {
    SparkServingHostNotEnrolled { host: host }
  }
}

fn host_in(hosts: List<HostIdentity>, host: HostIdentity) -> Bool {
  length(filter(hosts, h => host_identity_eq(a: h, b: host))) > 0
}

fn host_multiplicity(hosts: List<HostIdentity>, host: HostIdentity) -> Int {
  length(filter(hosts, h => host_identity_eq(a: h, b: host)))
}

// COVERAGE IS AN IDENTITY JOIN, WHICH IS WHY IT REPLACES THE CARDINALITY GUARD RATHER THAN JOINING IT.
//
// The observer already refused an EMPTY observation list, on the stated ground that an empty list is
// ignorance rather than a clean fleet. That guard is true and was useless here: the roster held {srv5},
// which is not empty, so nothing fired while the one host that mattered was missing. A count cannot
// distinguish "every expected host answered" from "some other host answered instead".
//
// Keeping both the count guard and this join would be two authorities for one question, so this is
// built to REPLACE it: a covered observation is one where the observed keys are exactly the expected
// keys, each exactly once. THAT REPLACEMENT HAS NOW HAPPENED (P0-C2):
// spark_serving_observation_report_from_observations takes the expected scope, derives the observed
// keys from each row's readback.host, and constructs a produced report only on SparkObservationCovered
// -- and the count guard it replaced is deleted rather than retained beside it, because two
// authorities for one question means the weaker one keeps answering first. Missing, foreign and
// duplicated are carried SEPARATELY because they are different
// defects with different causes -- a missing host is an unprobed machine, a foreign host is a scope
// disagreement, a duplicate is a roster that counted one machine twice.
type SparkObservationCoverage
  = SparkObservationCovered
  | SparkObservationIncomplete {
      missing: List<HostIdentity>
      foreign: List<HostIdentity>
      duplicated: List<HostIdentity>
    }

fn spark_observation_missing(
  expected: List<HostIdentity>,
  observed: List<HostIdentity>,
) -> List<HostIdentity> {
  filter(expected, e => !host_in(hosts: observed, host: e))
}

fn spark_observation_foreign(
  expected: List<HostIdentity>,
  observed: List<HostIdentity>,
) -> List<HostIdentity> {
  filter(observed, o => !host_in(hosts: expected, host: o))
}

fn spark_observation_duplicated(observed: List<HostIdentity>) -> List<HostIdentity> {
  filter(observed, o => host_multiplicity(hosts: observed, host: o) > 1)
}

fn spark_observation_coverage(
  expected: List<HostIdentity>,
  observed: List<HostIdentity>,
) -> SparkObservationCoverage {
  let missing = spark_observation_missing(expected: expected, observed: observed)
  let foreign = spark_observation_foreign(expected: expected, observed: observed)
  let duplicated = spark_observation_duplicated(observed: observed)
  if length(missing) == 0 && length(foreign) == 0 && length(duplicated) == 0 {
    SparkObservationCovered
  } else {
    SparkObservationIncomplete {
      missing: missing,
      foreign: foreign,
      duplicated: duplicated,
    }
  }
}
