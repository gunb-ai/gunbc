// ── ONE ENTRY FOR MATERIALIZING A SERVING CHECKPOINT ON A HOST OF ITS GROUP (deforking cut 8c) ──────
//
// THE PATH IS THE EXISTING SNAPSHOT ONE, NOT A COPY OF V4.1's. gunbc.spark.model_snapshot_materialize
// spark_materialize_member already acquires a pinned snapshot -- observe and adopt what verifies, else
// fetch from the Hub, then verify -- and the GLM canary converges through it. The GLM checkpoints are Hub
// snapshots in the Hub cache (their rows' placement), so they take that path: the snapshot is derived
// from the checkpoint's own row, never spelled again. gunbc.spark.v41_checkpoint_materialize stays V4.1's
// (a per-file population with span reads the snapshot path does not model) and is frozen as a consumer of
// its own shape: its migration onto this entry is a named follow-up, triggered by the snapshot path
// carrying per-file populations.
//
// ONE SEED, THE REST RAIL REPLICAS. The checkpoint's seed host is a modeled fact
// (gunbc.spark.arm_group_launch_dispatch glm53_checkpoint_seed_host): only the seed fetches from the Hub;
// every other Group A host replicates the seed's verified snapshot over the fabric rail
// (gunbc.spark.snapshot_rail_replica replicate_snapshot_over_rail) or refuses with the seed's exact verify
// cause -- there is no Hub fallback (checkpoint_materialize_work below). A host whose own snapshot already
// verifies adopts it and moves nothing.
//
// THE HUB CLI RUNS INSIDE A RUNTIME IMAGE, because no Spark has it on the host (the executor's own
// record). WHICH image is the caller's: any produced image whose receipt is recorded (its tag and its
// configuration digest), because downloading a checkpoint needs only the CLI, not the serving runtime the
// checkpoint will later run under. So the FP8 download may run inside the V4.1 image Group A already holds
// while the GLM image is still being built.
//
// THE IMAGE IS NEVER PULLED AND ITS CLI PATH IS NEVER SPELLED. Before any acquisition the host is asked
// for the image under the recorded tag and its Id must be the recorded configuration digest -- an absent
// or different image refuses, so `docker run` never reaches a registry; then the image itself is asked
// where its Hub CLI is (`command -v hf` inside it), and only an absolute path it answers is used.
type CheckpointMaterialization {
  title: NonEmptyStr
  group: FabricGroup
  checkpoint: ServingCheckpoint
  image: VllmImageDistributionSubject
  seed: HostIdentity
}

type HeldImageExecutor
  = HeldImageExecutorRead { executor: SnapshotAcquisitionExecutor, receipt: String }
  | HeldImageExecutorRefused { cause: String }

fn snapshot_placement_of(snapshot: ModelSnapshotDesired) -> SnapshotPlacement {
  match snapshot {
    ModelSnapshotPinned { identity: _, repo: _, revision: _, placement: pl, revision_provenance: _ } => pl
    ModelSnapshotUnpinned { identity: _, repo: _, cause: _ } => HubCachePlacement { cache_root: spark_hub_cache_root }
  }
}

fn checkpoint_host_path(c: ServingCheckpoint) -> NonEmptyStr? {
  match serving_checkpoint_row(c: c) {
    Absent => none
    Present { value: row } =>
      match row.placement {
        LocalDirectoryPlacement { host_path: p } => Present { value: p }
        HubCachePlacement { cache_root: root } => Present { value: root }
      }
  }
}

fn held_image_hub_cli_executor(ctx: SparkMaterializeContext, image: VllmImageDistributionSubject, placement: SnapshotPlacement) -> HeldImageExecutor {
  let want = render_oci_content_digest_wire(d: image.config)
  match spark_remote_run(ctx: ctx, argv: ["docker", "image", "inspect", image.tag as String]) {
    RemoteUnreachable { cause: c, reach: _ } => HeldImageExecutorRefused { cause: join(["the image inspect leg did not run: ", c], "") }
    RemoteRan { exit_code: code, stdout: out, stderr: err } =>
      if code != 0 && docker_image_inspect_names_no_such_image(stderr: err) {
        HeldImageExecutorRefused { cause: join(["the executor image ", image.tag as String, " is not held on ", ctx.host as String, " (", err, "); it is never pulled"], "") }
      } else if code != 0 {
        HeldImageExecutorRefused { cause: join(["the executor image could not be read on ", ctx.host as String, ", so whether it is held is unknown (docker image inspect exited ", to_string(code), ": ", err, ")"], "") }
      } else {
        match docker_image_inspect_id_from_stdout(stdout: out) {
          DockerImageInspectIdUnreadable { cause: c } => HeldImageExecutorRefused { cause: join(["the executor image's Id is unreadable: ", c], "") }
          DockerImageInspectId { id: id } =>
            if (id as String) != want {
              HeldImageExecutorRefused { cause: join(["the image under ", image.tag as String, " on ", ctx.host as String, " is ", id as String, ", not the recorded ", want], "") }
            } else {
              match spark_remote_run(ctx: ctx, argv: ["docker", "run", "--rm", "--pull", "never", "--entrypoint", "sh", image.tag as String, "-c", "command -v hf"]) {
                RemoteUnreachable { cause: c, reach: _ } => HeldImageExecutorRefused { cause: join(["the CLI read leg did not run: ", c], "") }
                RemoteRan { exit_code: c2, stdout: raw_path, stderr: e2 } => {
                  let path = remote_stdout_as_one_word(stdout: raw_path)
                  if c2 != 0 || !starts_with(s: path, prefix: "/") || string_contains(s: path, pattern: "\n") {
                    HeldImageExecutorRefused { cause: join(["the image ", want, " answered no Hub CLI path (exit ", to_string(c2), ", stdout `", path, "`, stderr `", e2, "`)"], "") }
                  } else {
                    match containerized_hub_cli_for(image: image.tag, cli_path: path as NonEmptyStr, placement: placement, container_path: "/out" as NonEmptyStr) {
                      ContainerizedHubCliRefused { cause: why } => HeldImageExecutorRefused { cause: why as String }
                      ContainerizedHubCliBuilt { executor: e } => HeldImageExecutorRead {
                        executor: e,
                        receipt: join(["executor image ", image.tag as String, " held as ", want, "; its Hub CLI read inside it at ", path, "\n"], ""),
                      }
                    }
                  }
                }
              }
            }
        }
      }
  }
}

fn checkpoint_snapshot(c: ServingCheckpoint) -> ModelSnapshotDesired? {
  match serving_checkpoint_row(c: c) {
    Absent => none
    Present { value: row } => Present { value: ModelSnapshotPinned {
      identity: serving_checkpoint_wire(c: c),
      repo: row.repo,
      revision: row.revision,
      placement: row.placement,
      revision_provenance: row.provenance,
    } }
  }
}

fn with_executor_ctx(ctx: SparkMaterializeContext, executor: SnapshotAcquisitionExecutor) -> SparkMaterializeContext {
  SparkMaterializeContext {
    host: ctx.host,
    trust: ctx.trust,
    path: ctx.path,
    admin_credential: ctx.admin_credential,
    admin_credential_file: ctx.admin_credential_file,
    executor: executor,
  }
}

fn acquisition_outcome_line(o: AcquisitionOutcome) -> String {
  match o {
    AcquisitionAlreadyPresent { identity: i, install_path: p } => join(["ALREADY PRESENT and verified: ", i as String, " at ", p as String, "\n"], "")
    AcquisitionFetched { identity: i, install_path: p, source: s } => join(["FETCHED and verified: ", i as String, " at ", p as String, " from ", s.identity as String, "\n"], "")
    AcquisitionRefused { cause: c } => join(["REFUSED: ", acquisition_refusal_text(cause: c), "\n"], "")
  }
}

fn acquisition_converged(o: AcquisitionOutcome) -> Bool {
  match o {
    AcquisitionAlreadyPresent { identity: _, install_path: _ } => true
    AcquisitionFetched { identity: _, install_path: _, source: _ } => true
    AcquisitionRefused { cause: _ } => false
  }
}

// ── THE PEER IS ASKED BEFORE THE HUB (rulings of valiant-crab-775, 2026-10-03) ──────────────────────
//
// A checkpoint is fetched from the Hub ONCE in the group; every other host replicates it from a peer over
// the fabric rail (gunbc.spark.snapshot_rail_replica, which moves each file as a fabric_blob_peer blob named
// by the sha256 the Hub cache already keys it by). A peer is an admissible source exactly when its OWN
// `hf cache verify` of this snapshot passes, read on the peer inside the same recorded image -- the image
// distribution's digest-readback rule, for a checkpoint. The candidates are the group's other hosts in
// roster order; with no admissible peer the target is the group's seed and fetches from the Hub as before.
// A Hub transfer still running on the target for this snapshot is superseded by the replica and stopped
// through its own cancel path (gunbc.spark.model_snapshot_materialize spark_transfer_cancel). The target's
// result is admitted by the same verify the Hub path ends with.
// THE VERIFY, READ AS THE INSTRUMENT ANSWERED, with its own words kept for the receipt. Three readings and no
// fourth: it passed; it RAN and rejected the snapshot (absent or incomplete here, "not held yet"); or nothing
// was learned (the leg did not run, the instrument never executed, it contradicted itself). Only the last is
// a refusal of the run; the middle one is the ordinary state of a host that has yet to acquire.
fn checkpoint_verify_with(ctx: SparkMaterializeContext, image: VllmImageDistributionSubject, host_path: NonEmptyStr, snapshot: ModelSnapshotDesired) -> CheckpointVerifyReading {
  match held_image_hub_cli_executor(ctx: ctx, image: image, placement: snapshot_placement_of(snapshot: snapshot)) {
    HeldImageExecutorRefused { cause: c } => CheckpointVerifyUnread { cause: c }
    HeldImageExecutorRead { executor: e, receipt: _ } =>
      match spark_remote_run(ctx: with_executor_ctx(ctx: ctx, executor: e), argv: executor_wrap(executor: e, argv: model_snapshot_completion_check_argv(snapshot: snapshot))) {
        RemoteUnreachable { cause: c, reach: _ } => CheckpointVerifyUnread { cause: join(["the verify leg did not run: ", c], "") }
        RemoteRan { exit_code: code, stdout: out, stderr: err } =>
          match read_instrument(exit_code: code, stdout: out) {
            InstrumentVerified => CheckpointVerified
            InstrumentRejectedTheSubject => CheckpointVerifyFailed { cause: join(["hf cache verify exited ", to_string(code), ": ", trim(s: err), " ", trim(s: out)], "") }
            InstrumentDidNotRun => CheckpointVerifyUnread { cause: join(["the verify instrument never executed (exit ", to_string(code), "): ", trim(s: err)], "") }
            InstrumentContradictedItself { detail: d } => CheckpointVerifyUnread { cause: join(["the verify contradicted itself: ", d, " (exit ", to_string(code), "): ", trim(s: err)], "") }
          }
      }
  }
}

type CheckpointVerifyReading
  = CheckpointVerified
  | CheckpointVerifyFailed { cause: String }
  | CheckpointVerifyUnread { cause: String }

// EACH NESTED HOST SESSION HAS ITS OWN CREDENTIAL FILE. A session's bracket writes its password file and
// WIPES it when the session ends; a nested peer session that reused the outer target session's file name
// wiped the target's credential mid-run, so every later target leg failed at `sudo` (run 37145004207). The
// readback and serve sessions name their own files.
// A CANDIDATE PEER'S OWN VERIFY, AS A CAUSE: none when it verified, else why not (kept for the receipt, so a
// fall-through to the Hub names each peer's reason rather than only that none qualified).
fn checkpoint_peer_cause(m: CheckpointMaterialization, candidate: HostIdentity, host_path: NonEmptyStr, snapshot: ModelSnapshotDesired) -> String? {
  match with_spark_build_host(
    host: candidate,
    attempt_raw: "checkpoint-peer-readback",
    identity_file_name: "gunbc-checkpoint-peer-readback-admin-password" as NonEmptyStr,
    use: fn(t, c, sctx) {
      match checkpoint_verify_with(ctx: sctx, image: m.image, host_path: host_path, snapshot: snapshot) {
        CheckpointVerified => SparkBuildHostWork { receipt: "verified", converged: true }
        CheckpointVerifyFailed { cause: x } => SparkBuildHostWork { receipt: join(["its verify rejected the snapshot: ", x], ""), converged: false }
        CheckpointVerifyUnread { cause: x } => SparkBuildHostWork { receipt: join(["its verify could not be read: ", x], ""), converged: false }
      }
    },
  ) {
    SparkBuildHostRefused { cause: x } => Present { value: join([candidate as String, " could not be reached: ", x], "") }
    SparkBuildHostRan { work: w, endpoint: _, executor: _, trust_receipt: _ } => if w.converged { none } else { Present { value: join([candidate as String, ": ", w.receipt], "") } }
  }
}

fn cancel_line(c: SparkTransferCancel) -> String {
  match c {
    TransferCancelledNothingRunning => ""
    TransferCancelled => "the Hub transfer still running on this host was superseded by the rail replica and stopped through its unit\n"
    TransferCancelRefused { cause: x } => join(["the Hub transfer on this host could not be stopped: ", x, "\n"], "")
  }
}

fn checkpoint_replicate_from(m: CheckpointMaterialization, peer: HostIdentity, tctx: SparkMaterializeContext, host_path: NonEmptyStr, snapshot: ModelSnapshotDesired) -> SparkBuildHostWork {
  let cancel = match model_snapshot_subject_for(role: SnapshotSeed, snapshot: snapshot, cache_root: spark_hub_cache_root) {
    Absent => TransferCancelledNothingRunning
    Present { value: subject } => spark_transfer_cancel(ctx: tctx, subject: subject)
  }
  match cancel {
    TransferCancelRefused { cause: x } => SparkBuildHostWork { receipt: join(["REFUSED: ", cancel_line(c: cancel)], ""), converged: false }
    TransferCancelled => checkpoint_replicate_after_cancel(m: m, peer: peer, tctx: tctx, host_path: host_path, snapshot: snapshot, note: cancel_line(c: cancel))
    TransferCancelledNothingRunning => checkpoint_replicate_after_cancel(m: m, peer: peer, tctx: tctx, host_path: host_path, snapshot: snapshot, note: "")
  }
}

fn checkpoint_replicate_after_cancel(m: CheckpointMaterialization, peer: HostIdentity, tctx: SparkMaterializeContext, host_path: NonEmptyStr, snapshot: ModelSnapshotDesired, note: String) -> SparkBuildHostWork {
  match with_spark_build_host(
    host: peer,
    attempt_raw: "checkpoint-peer-serve",
    identity_file_name: "gunbc-checkpoint-peer-serve-admin-password" as NonEmptyStr,
    use: fn(t, c, sctx) {
      match replicate_snapshot_over_rail(source: sctx, target: tctx, snapshot: snapshot) {
        SnapshotReplicaRefused { step: st, cause: x } => SparkBuildHostWork { receipt: join([note, "REFUSED at ", st as String, ": ", x, "\n"], ""), converged: false }
        SnapshotReplicated { files: n, receipt: r } =>
          match checkpoint_verify_with(ctx: tctx, image: m.image, host_path: host_path, snapshot: snapshot) {
            CheckpointVerified => SparkBuildHostWork { receipt: join([note, r, "REPLICATED and verified: ", to_string(n), " files from ", peer as String, " over the rail; hf cache verify passed on the target\n"], ""), converged: true }
            CheckpointVerifyFailed { cause: x } => SparkBuildHostWork { receipt: join([note, r, "REFUSED: the replica arrived but its verify did not pass: ", x, "\n"], ""), converged: false }
            CheckpointVerifyUnread { cause: x } => SparkBuildHostWork { receipt: join([note, r, "REFUSED: the replica's verify could not be read: ", x, "\n"], ""), converged: false }
          }
      }
    },
  ) {
    SparkBuildHostRefused { cause: x } => SparkBuildHostWork { receipt: join([note, "REFUSED: the peer ", peer as String, " could not be reached to serve: ", x, "\n"], ""), converged: false }
    SparkBuildHostRan { work: w, endpoint: _, executor: _, trust_receipt: _ } => w
  }
}

// ── THE ROLE IS EXPLICIT AND NOTHING FALLS BACK (operator ruling, 2026-10-03: "eliminate all fallbacks") ───────
//
// A checkpoint's seed host is a modeled fact (m.seed). The seed host fetches from the Hub; every other host is a
// rail replica of the seed and of nothing else. A replica whose seed does not verify REFUSES with the seed's
// exact cause -- it never fetches from the Hub instead. An own-verify that learned nothing refuses with what it
// captured. Only an own-verify that RAN and rejected (the snapshot is not held yet) proceeds, to the action the
// host's explicit role names.
fn checkpoint_materialize_work(m: CheckpointMaterialization, ctx: SparkMaterializeContext) -> SparkBuildHostWork {
  match checkpoint_snapshot(c: m.checkpoint) {
    Absent => SparkBuildHostWork { receipt: "REFUSED: the checkpoint has no row, so no snapshot subject exists to acquire\n", converged: false }
    Present { value: snapshot } =>
      match checkpoint_host_path(c: m.checkpoint) {
        Absent => SparkBuildHostWork { receipt: "REFUSED: the checkpoint has no row, so no host path exists to mount\n", converged: false }
        Present { value: host_path } =>
          match checkpoint_verify_with(ctx: ctx, image: m.image, host_path: host_path, snapshot: snapshot) {
            CheckpointVerified => SparkBuildHostWork { receipt: "ALREADY PRESENT and verified on this host; nothing moved\n", converged: true }
            CheckpointVerifyUnread { cause: c } => SparkBuildHostWork { receipt: join(["REFUSED: this host's own verify learned nothing: ", c, "\n"], ""), converged: false }
            CheckpointVerifyFailed { cause: c } => {
              let note = join(["this host does not hold the snapshot yet (", c, ")\n"], "")
              if host_identity_eq(a: ctx.host, b: m.seed) {
                let w = checkpoint_seed_from_hub(m: m, ctx: ctx, host_path: host_path, snapshot: snapshot)
                SparkBuildHostWork { receipt: join([note, "role: SEED (", m.seed as String, " is this checkpoint's seed host), so it fetches from the Hub\n", w.receipt], ""), converged: w.converged }
              } else {
                match checkpoint_peer_cause(m: m, candidate: m.seed, host_path: host_path, snapshot: snapshot) {
                  Present { value: why } => SparkBuildHostWork { receipt: join([note, "role: REPLICA of seed ", m.seed as String, "\nREFUSED: the seed is not an admissible source, and a replica never fetches from the Hub instead: ", why, "\n"], ""), converged: false }
                  Absent => {
                    let w = checkpoint_replicate_from(m: m, peer: m.seed, tctx: ctx, host_path: host_path, snapshot: snapshot)
                    SparkBuildHostWork { receipt: join([note, "role: REPLICA of seed ", m.seed as String, " (its own verify passed)\n", w.receipt], ""), converged: w.converged }
                  }
                }
              }
            }
          }
      }
  }
}

// THE BYTES ARE ON THE HOST, NOT WHERE THE CLI HAPPENED TO PUT THEM (valiant-crab-775, 2026-10-03). A verify
// run in the same container as the fetch can agree with a fetch that never reached the host (both used the
// container's default cache), so after a converged acquisition the HOST's repo directory is measured by
// `du` and must hold at least 95% of the checkpoint's recorded weight (the row's weight_gib, which is
// rounded); anything less refuses, naming both figures.
fn checkpoint_landed_on_host(ctx: SparkMaterializeContext, m: CheckpointMaterialization, snapshot: ModelSnapshotDesired) -> String? {
  match serving_checkpoint_row(c: m.checkpoint) {
    Absent => Present { value: "the checkpoint has no row, so its expected size is unknown" }
    Present { value: row } =>
      match snapshot_hub_paths(snapshot: snapshot) {
        Absent => none
        Present { value: paths } =>
          match spark_remote_run(ctx: ctx, argv: hub_dereferenced_bytes_argv(path: paths.repo_dir)) {
            RemoteUnreachable { cause: c, reach: _ } => Present { value: join(["the host's checkpoint size could not be read: ", c], "") }
            RemoteRan { exit_code: code, stdout: out, stderr: err } =>
              if code != 0 { Present { value: join(["du exited ", to_string(code), ": ", err], "") } } else {
                match first(split(s: out, delimiter: "\t")) {
                  Absent => Present { value: "du printed no size" }
                  Present { value: word } =>
                    match parse_int(s: trim(s: word)) {
                      Absent => Present { value: join(["du printed `", word, "`, not a size"], "") }
                      Present { value: bytes } => {
                        let floor = (gibibyte_count(g: row.weight_gib) as Int) * 1020054732
                        if bytes < floor { Present { value: join(["the host path ", paths.repo_dir as String, " holds ", to_string(bytes), " bytes, under the ", to_string(floor), " a landed checkpoint of ", to_string(gibibyte_count(g: row.weight_gib) as Int), " GiB holds; the fetch did not land on the host"], "") } }
                        else { none }
                      }
                    }
                }
              }
          }
      }
  }
}

// EVERY RESTART OF THE TRANSFER UNIT IS COUNTED AND REPORTED (operator ruling, 2026-10-03): Restart=on-failure
// survives a radio drop, and its cost is that a failure is retried rather than surfaced, so the receipt states
// systemd's own restart count for the unit; an unread count is said to be unread, never zero.
fn transfer_restarts_line(ctx: SparkMaterializeContext, snapshot: ModelSnapshotDesired) -> String {
  match model_snapshot_subject_for(role: SnapshotSeed, snapshot: snapshot, cache_root: spark_hub_cache_root) {
    Absent => "transfer unit restarts: UNREAD (no subject)\n"
    Present { value: subject } =>
      match spark_remote_run(ctx: ctx, argv: ["systemctl", "show", spark_transfer_unit_for(subject: subject) as String, "--property=NRestarts", "--value"]) {
        RemoteUnreachable { cause: c, reach: _ } => join(["transfer unit restarts: UNREAD (", c, ")\n"], "")
        RemoteRan { exit_code: code, stdout: out, stderr: err } =>
          if code != 0 { join(["transfer unit restarts: UNREAD (exit ", to_string(code), ": ", trim(s: err), ")\n"], "") }
          else { join(["transfer unit restarts: ", remote_stdout_as_one_word(stdout: out), " (each a failure retried by Restart=on-failure)\n"], "") }
      }
  }
}

// THE SEED: no group host verifies this snapshot yet, so this host fetches it from the Hub.
fn checkpoint_seed_from_hub(m: CheckpointMaterialization, ctx: SparkMaterializeContext, host_path: NonEmptyStr, snapshot: ModelSnapshotDesired) -> SparkBuildHostWork {
  match held_image_hub_cli_executor(ctx: ctx, image: m.image, placement: snapshot_placement_of(snapshot: snapshot)) {
    HeldImageExecutorRefused { cause: c } => SparkBuildHostWork { receipt: join(["REFUSED: ", c, "\n"], ""), converged: false }
    HeldImageExecutorRead { executor: executor, receipt: r } =>
      match spark_materialize_member(ctx: with_executor_ctx(ctx: ctx, executor: executor), role: SnapshotSeed, snapshot: snapshot) {
        SparkMaterializeRefused { host: _, cause: c } => SparkBuildHostWork { receipt: join([r, "REFUSED: ", c as String, "\n"], ""), converged: false }
        SparkMaterializeUnpinned { host: _ } => SparkBuildHostWork { receipt: join([r, "REFUSED: the snapshot carries no pinned revision\n"], ""), converged: false }
        SparkMaterialized { host: _, outcome: o } =>
          if !acquisition_converged(o: o) {
            SparkBuildHostWork { receipt: join([r, transfer_restarts_line(ctx: ctx, snapshot: snapshot), acquisition_outcome_line(o: o)], ""), converged: false }
          } else {
            match checkpoint_landed_on_host(ctx: ctx, m: m, snapshot: snapshot) {
              Present { value: why } => SparkBuildHostWork { receipt: join([r, acquisition_outcome_line(o: o), "REFUSED: ", why, "\n"], ""), converged: false }
              Absent => SparkBuildHostWork { receipt: join([r, transfer_restarts_line(ctx: ctx, snapshot: snapshot), acquisition_outcome_line(o: o)], ""), converged: true }
            }
          }
      }
  }
}

// THE ENTRY. SPARK_CONVERGE_TARGET names the host, which must be one the group's serving subject holds;
// unset refuses rather than fanning out, because this writes up to hundreds of gigabytes to the host.
fn checkpoint_materialize_wet(m: CheckpointMaterialization, receipt_path: String) -> ProcessExit
{
  let now = clock_now_probed_at()
  match spark_converge_target_selection(execute_apply: true) {
    SparkConvergeTargetRefused { reason: why } => exit_failure(reason: why)
    SparkConvergeTargetAllObserveOnly =>
      exit_failure(reason: "SPARK_CONVERGE_TARGET is unset: materializing a checkpoint writes hundreds of gigabytes to the host it names, so it refuses rather than choosing one")
    SparkConvergeTargetSingle { host: host } =>
      match admit_host_held_by_subject(raw: host, subject: PairServingUnitOn { group: m.group }) {
        Present { value: why } => exit_failure(reason: why)
        Absent =>
          match with_spark_build_host(
            host: host,
            attempt_raw: "checkpoint-materialize",
            identity_file_name: "gunbc-checkpoint-materialize-admin-password" as NonEmptyStr,
            use: fn(target, context, ctx) { checkpoint_materialize_work(m: m, ctx: ctx) },
          ) {
            SparkBuildHostRefused { cause: c } => exit_failure(reason: c)
            SparkBuildHostRan { work: work, endpoint: endpoint, executor: executor, trust_receipt: trust_receipt } => {
              let body = join([
                join([m.title as String, " probed_at=", probed_at_word(reading: now) as String, " host=", host as String, " endpoint=", endpoint as String, " executor=", executor, " checkpoint=", serving_checkpoint_wire(c: m.checkpoint) as String, "\n"], ""),
                trust_receipt,
                work.receipt,
              ], "")
              let w = Filesystem.Write(path: receipt_path, content: body)
              if !w.success {
                exit_failure(reason: join([m.title as String, " receipt write failed: ", w.error], ""))
              } else if work.converged {
                ExitSuccess
              } else {
                exit_failure(reason: join([m.title as String, " did not converge:\n", body], ""))
              }
            }
          }
      }
  }
}
