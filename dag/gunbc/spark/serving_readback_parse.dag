module gunbc.spark.serving_readback_parse

data spark_serving_readback_parse_note: String = "Grammar-owned readback decoders for ollama /api/version and /api/tags. parse_json plus json_object_unique_member are the single authority — never string_contains and never substitute the desired version or a placeholder digest."

type SparkServingReadbackField
  = SparkServingReadbackAbsent
  | SparkServingReadbackPresent { value: String }
  | SparkServingReadbackRefused { cause: NonEmptyStr }

fn spark_serving_json_member_string(lookup: JsonMemberLookup) -> String? {
  match lookup {
    JsonMemberFound { value: v } =>
      match v {
        JsonString { value: s } => Present { value: s }
        JsonNull => none
        JsonBool { value: _ } => none
        JsonNumber { lexeme: _ } => none
        JsonArray { elements: _ } => none
        JsonObject { members: _ } => none
      }
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

fn spark_serving_readback_field_from_member_lookup(
  lookup: JsonMemberLookup,
  member: String,
) -> SparkServingReadbackField {
  match lookup {
    JsonMemberFound { value: v } =>
      match spark_serving_json_member_string(lookup: JsonMemberFound { value: v }) {
        Present { value: s } => SparkServingReadbackPresent { value: s }
        Absent =>
          SparkServingReadbackRefused {
            cause: join(["ollama response member ", member, " is not a JSON string"], "") as NonEmptyStr,
          }
      }
    JsonMemberAbsent =>
      SparkServingReadbackRefused {
        cause: join(["ollama response member ", member, " is absent"], "") as NonEmptyStr,
      }
    JsonMemberDuplicated { count: n } =>
      SparkServingReadbackRefused {
        cause: join([
          "ollama response member ", member, " is duplicated (count=", to_string(n), ")",
        ], "") as NonEmptyStr,
      }
    JsonMemberNotAnObject =>
      SparkServingReadbackRefused {
        cause: "ollama response body is not a JSON object" as NonEmptyStr,
      }
  }
}

fn spark_serving_parse_version_json(stdout: String) -> SparkServingReadbackField {
  match parse_json(s: stdout) {
    Absent =>
      SparkServingReadbackRefused {
        cause: "ollama /api/version body is not parseable JSON" as NonEmptyStr,
      }
    Present { value: doc } =>
      spark_serving_readback_field_from_member_lookup(
        lookup: json_object_unique_member(v: doc, key: "version"),
        member: "version",
      )
  }
}

// /api/generate DECODES HERE TOO, for the reason the note above gives: this module is where an
// ollama response body becomes typed fields, and a second decoder living beside a consumer would be
// the string_contains path the note forbids, reintroduced one module over.
//
// `done` IS A BOOLEAN ON THE WIRE, so it needs its own reader. Passing it through the string reader
// would find a non-string and report the member refused, which would render a perfectly complete
// response as undecodable -- a refusal caused by the reader rather than by the response.
fn spark_serving_json_member_bool(lookup: JsonMemberLookup) -> SparkServingReadbackField {
  match lookup {
    JsonMemberFound { value: v } =>
      match v {
        JsonBool { value: b } =>
          SparkServingReadbackPresent { value: if b { "true" } else { "false" } }
        JsonString { value: _ } =>
          SparkServingReadbackRefused {
            cause: "ollama response member done is a string, not a boolean" as NonEmptyStr,
          }
        JsonNull =>
          SparkServingReadbackRefused {
            cause: "ollama response member done is null" as NonEmptyStr,
          }
        JsonNumber { lexeme: _ } =>
          SparkServingReadbackRefused {
            cause: "ollama response member done is a number, not a boolean" as NonEmptyStr,
          }
        JsonArray { elements: _ } =>
          SparkServingReadbackRefused {
            cause: "ollama response member done is an array, not a boolean" as NonEmptyStr,
          }
        JsonObject { members: _ } =>
          SparkServingReadbackRefused {
            cause: "ollama response member done is an object, not a boolean" as NonEmptyStr,
          }
      }
    JsonMemberAbsent =>
      SparkServingReadbackRefused {
        cause: "ollama /api/generate response carried no done member, so completion was not stated" as NonEmptyStr,
      }
    JsonMemberDuplicated { count: n } =>
      SparkServingReadbackRefused {
        cause: join([
          "ollama /api/generate response member done is duplicated (count=", to_string(n), ")",
        ], "") as NonEmptyStr,
      }
    JsonMemberNotAnObject =>
      SparkServingReadbackRefused {
        cause: "ollama /api/generate response body is not a JSON object" as NonEmptyStr,
      }
  }
}

fn spark_serving_parse_generate_member(stdout: String, member: String) -> SparkServingReadbackField {
  match parse_json(s: stdout) {
    Absent =>
      SparkServingReadbackRefused {
        cause: "ollama /api/generate body is not parseable JSON" as NonEmptyStr,
      }
    Present { value: doc } =>
      spark_serving_readback_field_from_member_lookup(
        lookup: json_object_unique_member(v: doc, key: member),
        member: member,
      )
  }
}

fn spark_serving_parse_generate_done(stdout: String) -> SparkServingReadbackField {
  match parse_json(s: stdout) {
    Absent =>
      SparkServingReadbackRefused {
        cause: "ollama /api/generate body is not parseable JSON" as NonEmptyStr,
      }
    Present { value: doc } =>
      spark_serving_json_member_bool(lookup: json_object_unique_member(v: doc, key: "done"))
  }
}

type SparkServingTagsModelSearch
  = SparkServingTagsModelSearchOk { repository: String, digest: String }
  | SparkServingTagsModelSearchRefused { cause: NonEmptyStr }

fn spark_serving_model_wire_matches(want_wire: String, observed: String) -> Bool {
  observed == want_wire
}

fn spark_serving_model_object_matches_ref(obj: JsonValue, want_wire: String) -> Bool {
  match obj {
    JsonObject { members: _ } =>
      let name = spark_serving_json_member_string(
        lookup: json_object_unique_member(v: obj, key: "name"),
      )
      let model = spark_serving_json_member_string(
        lookup: json_object_unique_member(v: obj, key: "model"),
      )
      match name {
        Present { value: n } => if spark_serving_model_wire_matches(want_wire: want_wire, observed: n) { true } else {
          match model {
            Present { value: m } => spark_serving_model_wire_matches(want_wire: want_wire, observed: m)
            Absent => false
          }
        }
        Absent =>
          match model {
            Present { value: m } => spark_serving_model_wire_matches(want_wire: want_wire, observed: m)
            Absent => false
          }
      }
    JsonNull => false
    JsonBool { value: _ } => false
    JsonNumber { lexeme: _ } => false
    JsonString { value: _ } => false
    JsonArray { elements: _ } => false
  }
}

fn spark_serving_model_object_digest(obj: JsonValue) -> SparkServingReadbackField {
  spark_serving_readback_field_from_member_lookup(
    lookup: json_object_unique_member(v: obj, key: "digest"),
    member: "digest",
  )
}

type SparkServingTagsModelFold
  = SparkServingTagsModelFoldEmpty
  | SparkServingTagsModelFoldOne { repository: String, digest: String }
  | SparkServingTagsModelFoldMany { count: Int }
  | SparkServingTagsModelFoldRefused { cause: NonEmptyStr }

fn spark_serving_tags_model_fold_not_object_refused() -> SparkServingTagsModelFold {
  SparkServingTagsModelFoldRefused {
    cause: "ollama /api/tags models entry matching desired ref is not a JSON object" as NonEmptyStr,
  }
}

fn spark_serving_tags_model_fold_from_matched_object(element: JsonValue) -> SparkServingTagsModelFold {
  match spark_serving_model_object_digest(obj: element) {
    SparkServingReadbackPresent { value: digest } =>
      SparkServingTagsModelFoldOne {
        repository: spark_serving_desired_model_ref.name as String,
        digest: digest,
      }
    SparkServingReadbackRefused { cause: c } =>
      SparkServingTagsModelFoldRefused { cause: c }
    SparkServingReadbackAbsent =>
      SparkServingTagsModelFoldRefused {
        cause: "matched ollama /api/tags model entry has no digest member" as NonEmptyStr,
      }
  }
}

fn spark_serving_tags_model_fold_step(
  state: SparkServingTagsModelFold,
  element: JsonValue,
  want_wire: String,
) -> SparkServingTagsModelFold {
  match state {
    SparkServingTagsModelFoldRefused { cause: c } => SparkServingTagsModelFoldRefused { cause: c }
    SparkServingTagsModelFoldMany { count: n } =>
      if spark_serving_model_object_matches_ref(obj: element, want_wire: want_wire) {
        SparkServingTagsModelFoldMany { count: n + 1 }
      } else {
        SparkServingTagsModelFoldMany { count: n }
      }
    SparkServingTagsModelFoldOne { repository: _, digest: _ } =>
      if spark_serving_model_object_matches_ref(obj: element, want_wire: want_wire) {
        SparkServingTagsModelFoldMany { count: 2 }
      } else {
        state
      }
    SparkServingTagsModelFoldEmpty =>
      if spark_serving_model_object_matches_ref(obj: element, want_wire: want_wire) {
        match element {
          JsonObject { members: _ } =>
            spark_serving_tags_model_fold_from_matched_object(element: element)
          JsonNull => spark_serving_tags_model_fold_not_object_refused()
          JsonBool { value: _ } => spark_serving_tags_model_fold_not_object_refused()
          JsonNumber { lexeme: _ } => spark_serving_tags_model_fold_not_object_refused()
          JsonString { value: _ } => spark_serving_tags_model_fold_not_object_refused()
          JsonArray { elements: _ } => spark_serving_tags_model_fold_not_object_refused()
        }
      } else {
        SparkServingTagsModelFoldEmpty
      }
  }
}

fn spark_serving_tags_model_search(elements: List<JsonValue>, want_wire: String) -> SparkServingTagsModelSearch {
  let folded = fold(
    elements,
    init: SparkServingTagsModelFoldEmpty,
    f: (state, el) => spark_serving_tags_model_fold_step(state: state, element: el, want_wire: want_wire),
  )
  match folded {
    SparkServingTagsModelFoldEmpty =>
      SparkServingTagsModelSearchRefused {
        cause: join(["ollama /api/tags lists no model matching ", want_wire], "") as NonEmptyStr,
      }
    SparkServingTagsModelFoldOne { repository: repo, digest: digest } =>
      SparkServingTagsModelSearchOk { repository: repo, digest: digest }
    SparkServingTagsModelFoldMany { count: n } =>
      SparkServingTagsModelSearchRefused {
        cause: join([
          "ollama /api/tags lists ", to_string(n), " models matching ", want_wire,
        ], "") as NonEmptyStr,
      }
    SparkServingTagsModelFoldRefused { cause: c } =>
      SparkServingTagsModelSearchRefused { cause: c }
  }
}

type SparkServingTagsReadbackFields {
  model_name: SparkServingReadbackField
  model_tag: SparkServingReadbackField
  model_manifest_digest: SparkServingReadbackField
}

fn spark_serving_parse_tags_json(stdout: String) -> SparkServingTagsReadbackFields {
  let want_wire = ollama_model_ref_wire(ref: spark_serving_desired_model_ref)
  match parse_json(s: stdout) {
    Absent =>
      SparkServingTagsReadbackFields {
        model_name: SparkServingReadbackRefused {
          cause: "ollama /api/tags body is not parseable JSON" as NonEmptyStr,
        },
        model_tag: SparkServingReadbackRefused {
          cause: "ollama /api/tags body is not parseable JSON" as NonEmptyStr,
        },
        model_manifest_digest: SparkServingReadbackRefused {
          cause: "ollama /api/tags body is not parseable JSON" as NonEmptyStr,
        },
      }
    Present { value: doc } =>
      match json_object_unique_member(v: doc, key: "models") {
        JsonMemberFound { value: v } =>
          match v {
            JsonArray { elements: els } =>
              match spark_serving_tags_model_search(elements: els, want_wire: want_wire) {
                SparkServingTagsModelSearchOk { repository: repo, digest: digest } =>
                  SparkServingTagsReadbackFields {
                    model_name: SparkServingReadbackPresent { value: spark_serving_desired_model_ref.name as String },
                    model_tag: SparkServingReadbackPresent { value: spark_serving_desired_model_ref.tag as String },
                    model_manifest_digest: SparkServingReadbackPresent { value: digest },
                  }
                SparkServingTagsModelSearchRefused { cause: c } =>
                  SparkServingTagsReadbackFields {
                    model_name: SparkServingReadbackRefused { cause: c },
                    model_tag: SparkServingReadbackRefused { cause: c },
                    model_manifest_digest: SparkServingReadbackRefused { cause: c },
                  }
              }
            _ =>
              SparkServingTagsReadbackFields {
                model_name: SparkServingReadbackRefused {
                  cause: "ollama /api/tags member models is not a JSON array" as NonEmptyStr,
                },
                model_tag: SparkServingReadbackRefused {
                  cause: "ollama /api/tags member models is not a JSON array" as NonEmptyStr,
                },
                model_manifest_digest: SparkServingReadbackRefused {
                  cause: "ollama /api/tags member models is not a JSON array" as NonEmptyStr,
                },
              }
          }
        JsonMemberAbsent =>
          SparkServingTagsReadbackFields {
            model_name: SparkServingReadbackRefused {
              cause: "ollama /api/tags member models is absent" as NonEmptyStr,
            },
            model_tag: SparkServingReadbackRefused {
              cause: "ollama /api/tags member models is absent" as NonEmptyStr,
            },
            model_manifest_digest: SparkServingReadbackRefused {
              cause: "ollama /api/tags member models is absent" as NonEmptyStr,
            },
          }
        JsonMemberDuplicated { count: n } =>
          SparkServingTagsReadbackFields {
            model_name: SparkServingReadbackRefused {
              cause: join([
                "ollama /api/tags member models is duplicated (count=", to_string(n), ")",
              ], "") as NonEmptyStr,
            },
            model_tag: SparkServingReadbackRefused {
              cause: join([
                "ollama /api/tags member models is duplicated (count=", to_string(n), ")",
              ], "") as NonEmptyStr,
            },
            model_manifest_digest: SparkServingReadbackRefused {
              cause: join([
                "ollama /api/tags member models is duplicated (count=", to_string(n), ")",
              ], "") as NonEmptyStr,
            },
          }
        JsonMemberNotAnObject =>
          SparkServingTagsReadbackFields {
            model_name: SparkServingReadbackRefused {
              cause: "ollama /api/tags body is not a JSON object" as NonEmptyStr,
            },
            model_tag: SparkServingReadbackRefused {
              cause: "ollama /api/tags body is not a JSON object" as NonEmptyStr,
            },
            model_manifest_digest: SparkServingReadbackRefused {
              cause: "ollama /api/tags body is not a JSON object" as NonEmptyStr,
            },
          }
      }
  }
}

fn spark_serving_readback_field_present_value(field: SparkServingReadbackField) -> String? {
  match field {
    SparkServingReadbackPresent { value: v } => Present { value: v }
    SparkServingReadbackAbsent => none
    SparkServingReadbackRefused { cause: _ } => none
  }
}

fn spark_serving_readback_field_refusal_cause(field: SparkServingReadbackField) -> NonEmptyStr? {
  match field {
    SparkServingReadbackRefused { cause: c } => Present { value: c }
    SparkServingReadbackAbsent => none
    SparkServingReadbackPresent { value: _ } => none
  }
}

fn spark_serving_readback_field_label(field: SparkServingReadbackField) -> String {
  match field {
    SparkServingReadbackAbsent => "absent"
    SparkServingReadbackPresent { value: v } => v
    SparkServingReadbackRefused { cause: _ } => "refused"
  }
}

fn spark_serving_first_readback_refusal(
  fields: List<SparkServingReadbackField>,
) -> NonEmptyStr? {
  fold(
    fields,
    init: none,
    f: (found, field) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match spark_serving_readback_field_refusal_cause(field: field) {
            Present { value: c } => Present { value: c }
            Absent => none
          }
      },
  )
}

// ── /api/ps residency readback ───────────────────────────────────────────────────────────────────
//
// AN EMPTY RESIDENT SET IS NOT "ON CPU". Ollama unloads a model after keep_alive, so an idle host
// legitimately reports zero resident models -- which says where nothing is, not where anything ran.
// The three outcomes below are kept apart for exactly the reason the health captures are: collapsing
// "not resident" into "resident outside VRAM" would fabricate a placement claim from an absence, and
// a fabricated placement is worse than a fabricated silence because it is actionable.
//
// The VRAM figure is carried as the number's LEXEME rather than decoded to an Int. The only question
// asked of it is whether it is zero, decoding would invent a conversion nobody needs, and the lexeme
// is what upstream actually sent.
fn spark_serving_ps_model_name(entry: JsonValue) -> String? {
  spark_serving_json_member_string(lookup: json_object_unique_member(v: entry, key: "name"))
}

fn spark_serving_ps_entry_vram_lexeme(entry: JsonValue) -> String? {
  match json_object_unique_member(v: entry, key: "size_vram") {
    JsonMemberFound { value: v } =>
      match v {
        JsonNumber { lexeme: l } => Present { value: l as String }
        JsonString { value: _ } => none
        JsonNull => none
        JsonBool { value: _ } => none
        JsonArray { elements: _ } => none
        JsonObject { members: _ } => none
      }
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

// The search is a FOLD, matching spark_serving_tags_model_search rather than hand-rolling a
// recursion beside it -- and the fold gives duplicate detection for free. Two entries naming the
// same model is not a case to pick a winner from: it is a response we cannot read, so it refuses.
type SparkServingPsVramFold
  = SparkServingPsVramFoldEmpty
  | SparkServingPsVramFoldOne { lexeme: String }
  | SparkServingPsVramFoldMany { count: Int }
  | SparkServingPsVramFoldUndecodable

fn spark_serving_ps_vram_fold_step(
  state: SparkServingPsVramFold,
  element: JsonValue,
  model: String,
) -> SparkServingPsVramFold {
  match spark_serving_ps_model_name(entry: element) {
    Absent => state
    Present { value: n } =>
      if n == model {
        match spark_serving_ps_entry_vram_lexeme(entry: element) {
          Absent => SparkServingPsVramFoldUndecodable
          Present { value: lex } =>
            match state {
              SparkServingPsVramFoldEmpty => SparkServingPsVramFoldOne { lexeme: lex }
              SparkServingPsVramFoldOne { lexeme: _ } => SparkServingPsVramFoldMany { count: 2 }
              SparkServingPsVramFoldMany { count: c } => SparkServingPsVramFoldMany { count: c + 1 }
              SparkServingPsVramFoldUndecodable => SparkServingPsVramFoldUndecodable
            }
        }
      } else {
        state
      }
  }
}

fn spark_serving_ps_find_vram(entries: List<JsonValue>, model: String) -> SparkServingReadbackField {
  let folded = fold(
    entries,
    init: SparkServingPsVramFoldEmpty,
    f: (state, el) => spark_serving_ps_vram_fold_step(state: state, element: el, model: model),
  )
  match folded {
    SparkServingPsVramFoldEmpty => SparkServingReadbackAbsent
    SparkServingPsVramFoldOne { lexeme: lex } => SparkServingReadbackPresent { value: lex }
    SparkServingPsVramFoldMany { count: n } =>
      SparkServingReadbackRefused {
        cause: join([
          "ollama /api/ps lists ", to_string(n), " resident entries for the served model",
        ], "") as NonEmptyStr,
      }
    SparkServingPsVramFoldUndecodable =>
      SparkServingReadbackRefused {
        cause: "ollama /api/ps entry for the served model carries no decodable size_vram number" as NonEmptyStr,
      }
  }
}

fn spark_serving_parse_ps_vram_for_model(stdout: String, model: String) -> SparkServingReadbackField {
  match parse_json(s: stdout) {
    Absent =>
      SparkServingReadbackRefused {
        cause: "ollama /api/ps body is not parseable JSON" as NonEmptyStr,
      }
    Present { value: doc } =>
      match json_object_unique_member(v: doc, key: "models") {
        JsonMemberFound { value: v } =>
          match v {
            JsonArray { elements: entries } =>
              spark_serving_ps_find_vram(entries: entries, model: model)
            JsonString { value: _ } => SparkServingReadbackRefused { cause: "ollama /api/ps models member is not an array" as NonEmptyStr }
            JsonNumber { lexeme: _ } => SparkServingReadbackRefused { cause: "ollama /api/ps models member is not an array" as NonEmptyStr }
            JsonNull => SparkServingReadbackRefused { cause: "ollama /api/ps models member is not an array" as NonEmptyStr }
            JsonBool { value: _ } => SparkServingReadbackRefused { cause: "ollama /api/ps models member is not an array" as NonEmptyStr }
            JsonObject { members: _ } => SparkServingReadbackRefused { cause: "ollama /api/ps models member is not an array" as NonEmptyStr }
          }
        JsonMemberAbsent =>
          SparkServingReadbackRefused {
            cause: "ollama /api/ps response carries no models member, so residency was not stated" as NonEmptyStr,
          }
        JsonMemberDuplicated { count: _ } =>
          SparkServingReadbackRefused { cause: "ollama /api/ps models member is duplicated" as NonEmptyStr }
        JsonMemberNotAnObject =>
          SparkServingReadbackRefused { cause: "ollama /api/ps body is not a JSON object" as NonEmptyStr }
      }
  }
}
