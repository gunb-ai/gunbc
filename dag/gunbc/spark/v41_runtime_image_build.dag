// THE IMAGE THAT DOES NOT EXIST YET, BUILT AS A MATERIALIZATION RATHER THAN RUN AS A SCRIPT.
//
// WHAT THIS LANE IS FOR. gunbc.spark.serving_runtime_capability_probe measured every published GB10
// container image against the five capabilities DeepSeek V4.1 needs and found none that registers
// DeepseekV41ForCausalLM on sm_121. Its conclusion was not "no image works" but a BUILD OBLIGATION:
// the only source known to contain the V4.1 path is vLLM at 07b75534651a0dd584c6f3be75d8c62fb8426397,
// and the way to settle what that source yields on compute capability 12.1 is to build it and ask the
// same questions inside the result. This module is that build.
//
// WHY IT IS NOT A SHELL SCRIPT SOMEBODY RAN. A `docker build` invocation typed into a terminal
// produces an image whose provenance is a memory: which base, which arch list, which revision. The
// DESIGN §6 tell for that is out-of-band actuation, and its cost here is concrete rather than
// stylistic -- the whole product of this lane is a DIGEST whose inputs someone else must be able to
// re-derive, and an image whose arch list nobody recorded is an image nobody can rebuild or refute.
// So the inputs are declarations, the identity of the build is a content hash OVER those
// declarations, and the invocation is derived from them through the same ArgvCommand wall every
// other tool invocation in this repository passes.
//
// THE TRANSPORT IS THE ONE THAT ALREADY EXISTS. Every leg runs through
// gunbc.typed_argv_exec typed_argv_exec_over_fleet_ssh: a portable-word-sealed argv over an
// SSH leg whose known-hosts anchor was materialized and read back and whose credential was verified
// against the declared fleet key before any host was contacted. No sudo appears anywhere in this
// module, and that is a measured fact rather than an oversight -- the build reaches docker through
// the operator's docker group membership, so a privileged leg would be asking for authority the work
// does not need.

// ── WHERE ─────────────────────────────────────────────────────────────────────────────────────
//
// ONE HOST, NAMED BY ITS FLEET IDENTITY, AND THE VENDOR LABEL IS NOT THAT IDENTITY.
//
// THIS ROW SPELLED `spark-a3ee` AND THE MODEL REFUSED IT, WHICH IS THE POINT WORTH RECORDING. That is
// the unit's vendor label, derived from an ethernet MAC tail; the fleet identity of the same box is
// srv5, bound by gunbc.spark.dgx_procurement srv5_router_binding. Only the identity resolves:
// fleet_probe_endpoint_for folds the router bindings, which are keyed by identity, so a label
// produced a target with no enrolled host key and the first ssh leg refused -- typed, located, before
// anything was touched. The brief this lane was given named the box by its label in one sentence and
// the serving pair by its identity in another, and nothing in prose joins the two; the model did.
//
// IT IS ALSO WHERE THE SERVING PAIR RUNS, and that is stated here rather than left to be discovered.
// srv5 and srv6 are the Spark serving pair. The build writes only under its own root, creates no
// long-lived container, and the probe is a read-only `docker run --rm` -- but a source build is not a
// free tenant, and whether this lane should hold that host at all is an operator question, not an
// authorship one. 🟡 dissolve-on: re-homed to a non-serving Spark (srv7 carries spark-c2b1) once the
// artifact does not have to stay where it was built; the build is content-keyed, so the tag is
// unchanged by the move and only the local config digest, which is a per-host artifact, is not.
data v41_build_host: HostIdentity = operator_host_srv5
data v41_build_root: NonEmptyStr = "/home/briansrls/gunbc-v41-build" as NonEmptyStr
data v41_source_dir: NonEmptyStr = "/home/briansrls/gunbc-v41-build/src" as NonEmptyStr
data v41_source_remote_name: NonEmptyStr = "origin" as NonEmptyStr
data v41_image_repository: NonEmptyStr = "gunbc-vllm-dsv41-gb10" as NonEmptyStr

// ── WHAT IS BUILT ─────────────────────────────────────────────────────────────────────────────
//
// THE FLEET RECIPE IS UPSTREAM'S OWN aarch64 RELEASE RECIPE WITH ONE FIELD CHANGED, and it is written
// that way -- reading each unchanged field off that row rather than re-spelling it -- so the single
// divergence is visible as a divergence. That field is the arch list: upstream's arm64 release builds
// 8.0 through 12.0, and GB10 is 12.1, which is why no published image can carry sm_121 kernels
// however recent its vLLM is.
//
// The parallelism fields are the other difference and they are deliberately NOT part of the build
// identity below; see the key.
data v41_gb10_torch_cuda_arch_list: NonEmptyStr = "12.1" as NonEmptyStr

// MEASURED, NOT CHOSEN BY FEEL. The build host carries 20 cores and, with the serving pair's engine
// resident, about 13 GiB of free RAM; upstream's own GH200 note records ~15 GiB at max_jobs=66, and
// the memory a build holds scales with how many compilations are in flight. Six jobs of two nvcc
// threads is what fits beside a resident engine rather than beside nothing.
data v41_build_max_jobs: NonEmptyStr = "6" as NonEmptyStr
data v41_build_nvcc_threads: NonEmptyStr = "2" as NonEmptyStr

fn v41_gb10_recipe() -> VllmContainerBuildRecipe {
  vllm_recipe_targeting(
    base: vllm_07b75534_aarch64_release_recipe,
    torch_cuda_arch_list: v41_gb10_torch_cuda_arch_list,
    max_jobs: v41_build_max_jobs,
    nvcc_threads: v41_build_nvcc_threads,
  )
}

fn v41_recipe_arch_is_buildable() -> Bool {
  vllm_cuda_arch_supported(arch: v41_gb10_torch_cuda_arch_list)
}

// ── THE IDENTITY OF THE BUILD ─────────────────────────────────────────────────────────────────
//
// A CONTENT KEY OVER THE INPUTS, AND THE TAG IS THAT KEY. The image this lane produces is a
// materialization: given the same source revision, the same bases, the same toolchain pins and the
// same arch list, it is the same artifact, and given a different one it is a different artifact that
// must not be able to wear the same name. So the tag is DERIVED from the key rather than chosen, and
// a reader who wants to know whether two images were built from the same inputs compares two strings
// instead of reading two build logs.
//
// WHAT IS DELIBERATELY NOT IN THE KEY. max_jobs and nvcc_threads are how much of the host the build
// was allowed to use, not what it produced; folding them in would mint a fresh identity every time
// the machine's spare capacity changed, and each fresh identity is a cache miss and a rebuild of
// something already built. That is the redundancy DESIGN §2 prices, bought for nothing: the compiler
// output does not depend on how many compilers ran at once.
data v41_build_key_domain: NonEmptyStr = "gunbc.spark.v41_runtime_image_build" as NonEmptyStr

fn v41_build_key_atoms(r: VllmContainerBuildRecipe) -> List<NonEmptyStr> {
  [
    r.source.repository,
    r.source.full_revision,
    r.dockerfile_path,
    r.build_target,
    r.cuda_version,
    r.build_base_image,
    r.final_base_image,
    r.python_version,
    r.torch_version,
    r.flashinfer_version,
    r.torch_cuda_arch_list,
  ]
}

fn v41_build_key_structural(r: VllmContainerBuildRecipe) -> Fnv1a64Structural {
  fold(
    v41_build_key_atoms(r: r),
    init: content_hash_atom(value: v41_build_key_domain),
    f: (acc, a) => content_hash_combine_structural(left: acc, right: content_hash_atom(value: a)),
  )
}

fn v41_build_key(r: VllmContainerBuildRecipe) -> ContentHash {
  content_hash_tagged(tag: v41_build_key_domain, payload: v41_build_key_structural(r: r))
}

fn v41_image_tag(r: VllmContainerBuildRecipe) -> NonEmptyStr {
  join([v41_image_repository as String, ":", serialize_content_hash(hash: v41_build_key(r: r)) as String], "") as NonEmptyStr
}

// ── THE INVOCATION ────────────────────────────────────────────────────────────────────────────
//
// THE BUILD ARGUMENTS ARE THE ONES UPSTREAM'S Dockerfile PUBLISHES, spelled exactly as its ARGs
// spell them. FINAL_BASE_IMAGE is not passed and that is deliberate: its ARG default is
// nvidia/cuda:${CUDA_VERSION}-base-ubuntu24.04, so passing CUDA_VERSION already determines it, and
// the recipe row records the value it resolves to. RUN_WHEEL_CHECK disables only upstream's PyPI
// publication-size guard, which is a rule about what may be uploaded to PyPI and has nothing to say
// about an image nobody publishes.
fn v41_build_args(r: VllmContainerBuildRecipe) -> List<DockerBuildArg> {
  [
    DockerBuildArg { name: "CUDA_VERSION" as NonEmptyStr, value: r.cuda_version as String },
    DockerBuildArg { name: "BUILD_BASE_IMAGE" as NonEmptyStr, value: r.build_base_image as String },
    DockerBuildArg { name: "torch_cuda_arch_list" as NonEmptyStr, value: r.torch_cuda_arch_list as String },
    DockerBuildArg { name: "max_jobs" as NonEmptyStr, value: r.max_jobs as String },
    DockerBuildArg { name: "nvcc_threads" as NonEmptyStr, value: r.nvcc_threads as String },
    DockerBuildArg { name: "RUN_WHEEL_CHECK" as NonEmptyStr, value: "false" },
  ]
}

fn v41_dockerfile_path(r: VllmContainerBuildRecipe) -> NonEmptyStr {
  join([v41_source_dir as String, "/", r.dockerfile_path as String], "") as NonEmptyStr
}

fn v41_build_spec(r: VllmContainerBuildRecipe) -> DockerBuildSpec {
  DockerBuildSpec {
    tag: v41_image_tag(r: r),
    context_dir: v41_source_dir as FilePath,
    dockerfile: v41_dockerfile_path(r: r),
    target: r.build_target,
    platform: "linux/arm64" as NonEmptyStr,
    build_args: v41_build_args(r: r),
  }
}

// ── THE LEGS ──────────────────────────────────────────────────────────────────────────────────

type V41LegOutcome
  = V41LegRan { stdout: String }
  | V41LegFailed { step: NonEmptyStr, cause: String }

fn v41_leg(target: SshTarget, context: FleetSshExecutionContext, step: NonEmptyStr, command: ArgvCommand) -> V41LegOutcome {
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: argv_words(command: command)) {
    TypedArgvExecRefused { reason: why } => V41LegFailed { step: step, cause: why }
    TypedArgvExecConverged { result: r } =>
      if r.success {
        V41LegRan { stdout: trim(s: r.stdout) }
      } else {
        V41LegFailed { step: step, cause: join(["exit=", to_string(r.exit_code), " stderr=", trim(s: r.stderr)], "") }
      }
  }
}

// SOURCE MATERIALIZATION IS CONVERGENT, AND THE READBACK COMES FIRST. A tree already sitting at the
// requested commit needs nothing done to it, and a clone into an existing directory is an error
// rather than a no-op -- so the question "is HEAD already this revision" is asked before anything is
// created. It is also the only honest completion test: a source directory that EXISTS says nothing
// about which commit is checked out in it.
type V41SourceState
  = V41SourceAtRevision { revision: NonEmptyStr, already_present: Bool }
  | V41SourceRefused { step: NonEmptyStr, cause: String }

fn v41_source_head(target: SshTarget, context: FleetSshExecutionContext) -> String? {
  match v41_leg(target: target, context: context, step: "source-head" as NonEmptyStr, command: git_rev_parse_head_command(repository_dir: v41_source_dir as String)) {
    V41LegFailed { step: _, cause: _ } => none
    V41LegRan { stdout: head } => Present { value: head }
  }
}

fn v41_materialize_source_steps(r: VllmContainerBuildRecipe) -> List<ArgvCommand> {
  [
    mkdir_parents_command_at(mkdir_binary: mkdir_path_resolved_program, path: v41_build_root as String),
    git_clone_shallow_command(repository: r.source.repository as String, destination: v41_source_dir as String),
    git_fetch_shallow_revision_command(repository_dir: v41_source_dir as String, remote: v41_source_remote_name as String, revision: r.source.full_revision as String),
    git_checkout_revision_command(repository_dir: v41_source_dir as String, revision: r.source.full_revision as String),
  ]
}

fn v41_run_steps(target: SshTarget, context: FleetSshExecutionContext, step: NonEmptyStr, commands: List<ArgvCommand>) -> V41LegOutcome? {
  fold(commands, init: none, f: (acc, c) =>
    match acc {
      Present { value: failure } => Present { value: failure }
      Absent =>
        match v41_leg(target: target, context: context, step: step, command: c) {
          V41LegRan { stdout: _ } => none
          V41LegFailed { step: s, cause: why } => Present { value: V41LegFailed { step: s, cause: why } }
        }
    })
}

func converge_v41_source(target: SshTarget, context: FleetSshExecutionContext, r: VllmContainerBuildRecipe) -> V41SourceState
  uses net: Network
{
  match v41_source_head(target: target, context: context) {
    Present { value: head } =>
      if head == (r.source.full_revision as String) {
        V41SourceAtRevision { revision: r.source.full_revision, already_present: true }
      } else {
        V41SourceRefused {
          step: "source-head" as NonEmptyStr,
          cause: join(["the source tree at ", v41_source_dir as String, " is checked out at ", head, " and this build wants ", r.source.full_revision as String, "; it is not moved from under a build that may be reading it"], ""),
        }
      }
    Absent =>
      match v41_run_steps(target: target, context: context, step: "source-materialize" as NonEmptyStr, commands: v41_materialize_source_steps(r: r)) {
        Present { value: failure } =>
          match failure {
            V41LegFailed { step: s, cause: why } => V41SourceRefused { step: s, cause: why }
            V41LegRan { stdout: _ } => V41SourceRefused { step: "source-materialize" as NonEmptyStr, cause: "unreachable: a successful leg is never recorded as a failure" }
          }
        Absent =>
          match v41_source_head(target: target, context: context) {
            Absent => V41SourceRefused { step: "source-readback" as NonEmptyStr, cause: "the tree was materialized and HEAD still could not be read" }
            Present { value: head } =>
              if head == (r.source.full_revision as String) {
                V41SourceAtRevision { revision: r.source.full_revision, already_present: false }
              } else {
                V41SourceRefused { step: "source-readback" as NonEmptyStr, cause: join(["checkout reported success and HEAD reads ", head], "") }
              }
          }
      }
  }
}

// ── THE IMAGE ─────────────────────────────────────────────────────────────────────────────────
//
// THE IDENTITY READ BACK IS THE IMAGE CONFIG DIGEST, NOT A REGISTRY DIGEST, and the difference is
// stated rather than glossed. A registry digest is the digest of a manifest a registry accepted, and
// this image is deliberately not pushed anywhere; what `docker image inspect --format {{.Id}}`
// returns is the sha256 of the image configuration, which is a content identity of the built image on
// this host and is what a `docker run` can be pinned to here. Calling it a registry digest would
// claim a publication that did not happen.
type V41ImageIdentity sole_constructor {
  tag: NonEmptyStr
  local_config_digest: NonEmptyStr
  built_from: VllmSourceRevision
  build_key: ContentHash
}

type V41ImageBuild
  = V41ImageBuilt { identity: V41ImageIdentity, already_present: Bool }
  | V41ImageBuildRefused { step: NonEmptyStr, cause: String }

func converge_v41_image(target: SshTarget, context: FleetSshExecutionContext, r: VllmContainerBuildRecipe) -> V41ImageBuild
  uses net: Network
{
  let tag = v41_image_tag(r: r)
  match v41_leg(target: target, context: context, step: "image-digest" as NonEmptyStr, command: docker_image_digest_command(image: tag)) {
    V41LegFailed { step: st, cause: why } =>
      V41ImageBuildRefused { step: st, cause: join(["the image query did not run, so nothing is known about whether the tag exists: ", why], "") }
    V41LegRan { stdout: digest } =>
      if digest != "" {
        V41ImageBuilt {
          identity: V41ImageIdentity { tag: tag, local_config_digest: digest as NonEmptyStr, built_from: r.source, build_key: v41_build_key(r: r) },
          already_present: true,
        }
      } else {
        match v41_leg(target: target, context: context, step: "image-build" as NonEmptyStr, command: docker_build_spec_command(spec: v41_build_spec(r: r))) {
          V41LegFailed { step: st, cause: why } => V41ImageBuildRefused { step: st, cause: why }
          V41LegRan { stdout: _ } =>
            match v41_leg(target: target, context: context, step: "image-readback" as NonEmptyStr, command: docker_image_digest_command(image: tag)) {
              V41LegFailed { step: st, cause: why } => V41ImageBuildRefused { step: st, cause: join(["the build reported success and the readback did not run: ", why], "") }
              V41LegRan { stdout: readback } =>
                if readback == "" {
                  V41ImageBuildRefused { step: "image-readback" as NonEmptyStr, cause: "the build reported success and no image carries the tag it was asked to write" }
                } else {
                  V41ImageBuilt {
                    identity: V41ImageIdentity { tag: tag, local_config_digest: readback as NonEmptyStr, built_from: r.source, build_key: v41_build_key(r: r) },
                    already_present: false,
                  }
                }
            }
        }
      }
  }
}

// ── THE ENTRY ─────────────────────────────────────────────────────────────────────────────────

data v41_build_attempt_raw: String = "v41-runtime-image-build"
data v41_build_receipt_path: String = "target/v41-runtime-image-build-receipt.txt"

fn v41_image_line(b: V41ImageBuild) -> String {
  match b {
    V41ImageBuilt { identity: i, already_present: p } =>
      join([
        "image tag=", i.tag as String,
        " local_config_digest=", i.local_config_digest as String,
        " build_key=", serialize_content_hash(hash: i.build_key) as String,
        " source=", i.built_from.full_revision as String,
        " already_present=", if p { "true" } else { "false" }, "\n",
      ], "")
    V41ImageBuildRefused { step: st, cause: why } =>
      join(["image REFUSED step=", st as String, " cause=", why, "\n"], "")
  }
}

fn v41_build_succeeded(b: V41ImageBuild) -> Bool {
  match b {
    V41ImageBuilt { identity: _, already_present: _ } => true
    V41ImageBuildRefused { step: _, cause: _ } => false
  }
}

func converge_v41_runtime_image(target: SshTarget, context: FleetSshExecutionContext) -> V41ImageBuild
  uses net: Network
{
  let r = v41_gb10_recipe()
  if !v41_recipe_arch_is_buildable() {
    V41ImageBuildRefused {
      step: "arch-admission" as NonEmptyStr,
      cause: join([v41_gb10_torch_cuda_arch_list as String, " is not in vLLM's CUDA_SUPPORTED_ARCHS at the pinned revision, so the build would reject it"], ""),
    }
  } else {
    match converge_v41_source(target: target, context: context, r: r) {
      V41SourceRefused { step: st, cause: why } => V41ImageBuildRefused { step: st, cause: why }
      V41SourceAtRevision { revision: _, already_present: _ } => converge_v41_image(target: target, context: context, r: r)
    }
  }
}

// THE BUILD IS ITS OWN ENTRY POINT, SEPARATE FROM THE PROBE, for the reason the canary's cutover is
// separate from its convergence: this one can occupy most of a host's spare capacity for hours, and
// an entry that did both would put that cost behind every attempt to re-read a capability.
func v41_runtime_image_build_wet() -> ProcessExit
  uses net: Network
{
  let now = clock_now_probed_at()
  match fleet_ssh_attempt_identity(raw: v41_build_attempt_raw) {
    Absent => exit_failure(reason: "attempt identity is not a safe path segment")
    Present { value: attempt } =>
      match probe_agent_credential_verification(attempt: attempt) {
        FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed } =>
          exit_failure(reason: fleet_ssh_credential_verification_refusal_reason(verification: FleetSshCredentialIdentityMismatch { expected_line: expected, observed_line: observed }))
        FleetSshCredentialDerivationRefused { cause: cause } =>
          exit_failure(reason: fleet_ssh_credential_verification_refusal_reason(verification: FleetSshCredentialDerivationRefused { cause: cause }))
        FleetSshCredentialVerified { binding: binding } => {
          let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
          match fleet_ssh_execution_context_of(outcome: materialization, credential: binding) {
            Absent => exit_failure(reason: join(["trust could not be established, so no leg ran: ", known_hosts_materialization_receipt(outcome: materialization)], ""))
            Present { value: context } =>
              match spark_reach_endpoint(host: v41_build_host, path: ReachManagementLan) {
                Absent => exit_failure(reason: join(["no ", spark_reach_path_wire(p: ReachManagementLan), " endpoint for ", v41_build_host as String], ""))
                Present { value: endpoint } => {
                  let target = SshTarget { endpoint: endpoint as NonEmptyStr, principal: spark_operator_bootstrap_login as NonEmptyStr }
                  let build = converge_v41_runtime_image(target: target, context: context)
                  let body = join([
                    join(["v41 runtime image build probed_at=", probed_at_word(reading: now) as String, " host=", v41_build_host as String, " endpoint=", endpoint, "\n"], ""),
                    known_hosts_materialization_receipt(outcome: materialization),
                    join(["credential ", fleet_ssh_credential_locus_label(binding: binding), " public_material_identity=", serialize_content_hash(hash: fleet_ssh_credential_identity(binding: binding)) as String, "\n"], ""),
                    join(["recipe arch_list=", v41_gb10_torch_cuda_arch_list as String, " cuda=", v41_gb10_recipe().cuda_version as String, " base=", v41_gb10_recipe().build_base_image as String, "\n"], ""),
                    v41_image_line(b: build),
                  ], "")
                  let w = Filesystem.Write(path: v41_build_receipt_path, content: body)
                  if !w.success {
                    exit_failure(reason: join(["v41 runtime image build receipt write failed: ", w.error], ""))
                  } else if v41_build_succeeded(b: build) {
                    ExitSuccess
                  } else {
                    exit_failure(reason: join(["v41 runtime image build did not converge:\n", body], ""))
                  }
                }
              }
          }
        }
      }
  }
}
