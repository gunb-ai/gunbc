module gunbc.spark.provisioning

import std.types { NonEmptyStr, String, Bool, List, Int }
import std.algebra { Ordering, Less, Equal, Greater }
import std.human_intervention {
  HumanIntervention,
  HumanInterventionIdentity,
  HumanInterventionFrequency,
  ProvisioningHumanBurden,
  FleetOnce,
  DeviceOnce,
  EveryProvision,
  BreakGlassOnly,
  human_intervention_count_at,
  compare_routine_human_burden,
  NoDischargeSiteModeled,
}
import product.placement_supply { HostIdentity }
import extdeps.access.posix { PosixUser }
import extdeps.network.ipv4 { Ipv4Address }
import extdeps.systems.nvidia_dgx_spark_setup {
  InitialUpdateDisposition,
  InitialUpdateBehaviorUnobserved,
  InitialUpdateAppliedDuringSetup,
  InitialUpdateDeferredToOperator,
  DgxSparkPxeInstallParameters,
  OobeSetupField,
  OobeLanguage,
  OobeTimeZone,
  OobeTermsAndConditions,
  OobeUserAccount,
  OobeAnalytics,
  dgx_spark_oobe_offers_field,
}
import gunbc.fleet_posix_accounts { fleet_posix_operator_user }
import gunbc.spark.bootstrap_credential {
  SparkFactoryBootstrap,
  SparkProvisioningCredentials,
  BootstrapCredentialStanding,
  BootstrapCredentialsMaterialized,
  BootstrapCredentialsNotMaterialized,
  spark_credentials_standing,
}

// SPARK-PROVISION-0. ONE provisioning INTERFACE for the DGX Spark units, with TWO
// realizations of it. The interface is what a provisioning intent MEANS; the strategy is
// how that meaning is discharged on a given device. Model-only: nothing here executes,
// observes, or touches hardware.
//
// NOT MODELED HERE, deliberately: the hostname. An OS hostname is presentation, it is not
// load-bearing for receiving, deployment or enrollment, and its convergence happens later
// through the ordinary apply path — so blocking a provision on it would invent a
// dependency the world does not have (operator ruling, 2026-08-07).

type PxeEnvironmentIdentity = NonEmptyStr where brand("PxeEnvironmentIdentity")

type InstallationImageIdentity = NonEmptyStr where brand("InstallationImageIdentity")

type SparkAutoinstallSpec {
  parameters: DgxSparkPxeInstallParameters
}

// PxeAutoinstall is DECLARED here and its standings are not. Whether a given network can
// serve the boot chain, and whether a given unit's firmware will take it, are observations
// this session has not made — they belong to SPARK-PXE-0, and authoring them here from
// nothing would be fabrication dressed as coverage.
type SparkProvisioningStrategy
  = FactoryOobe { bootstrap: SparkFactoryBootstrap }
  | PxeAutoinstall {
      environment: PxeEnvironmentIdentity,
      image: InstallationImageIdentity,
      install_spec: SparkAutoinstallSpec
    }

type TelemetryDisposition
  = TelemetryEnabled
  | TelemetryDeclined

type LicenseAcceptance {
  terms_identity: NonEmptyStr
  accepted_by: NonEmptyStr
}

type SparkNetworkPlacement {
  address: Ipv4Address
}

type SparkProvisioningIntent {
  host: HostIdentity
  administrator: PosixUser
  credentials: SparkProvisioningCredentials
  locale: NonEmptyStr
  timezone: NonEmptyStr
  telemetry: TelemetryDisposition
  network: SparkNetworkPlacement
  license: LicenseAcceptance
  strategy: SparkProvisioningStrategy
}

// The intent's configuration subjects must be settleable by the wizard the strategy uses.
// This is what gives the cited OOBE field list a consumer: a subject the wizard does not
// offer cannot be discharged inside the portal, and the model should say so structurally
// rather than discovering it at the keyboard.
fn spark_intent_oobe_subjects() -> List<OobeSetupField> {
  [OobeLanguage, OobeTimeZone, OobeTermsAndConditions, OobeUserAccount, OobeAnalytics]
}

fn spark_oobe_covers_intent_subjects() -> Bool {
  fold(
    spark_intent_oobe_subjects(),
    init: true,
    f: (acc, subject) => acc && dgx_spark_oobe_offers_field(field: subject)
  )
}

// ------------------------------------------------------------------------------------
// Standings the environment supplies. Nothing below is authored per unit.
// ------------------------------------------------------------------------------------

// Whether a machine can drive the bootstrap association at all. This is the seam onto
// BOOTSTRAP-REACH-0's pluggable reach provider; no transport, vendor or device is named
// here, because which machine relays is that lane's fact and not this one's. Unknown is a
// real third state and is never collapsed into either answer — "no controller exists" and
// "nobody has looked" have different remedies.
//
// dissolve-on: BOOTSTRAP-REACH-0 lands the provider; BootstrapControllerReady gains its
// provider payload and BootstrapControllerUnknown retires.
type BootstrapControllerStanding
  = BootstrapControllerReady
  | BootstrapControllerAbsent
  | BootstrapControllerUnknown

// The PXE side of the same question, owned by SPARK-PXE-0. Declared so strategy selection
// can consume it; Unknown is the only value this lane may assert today.
type PxePrerequisiteStanding
  = PxePrerequisitesReady
  | PxePrerequisitesAbsent
  | PxePrerequisitesUnknown

// Credential materialization is deliberately NOT a field here: it is derived from the
// intent's own credential standings (spark_credentials_standing), so there is one authority
// for "are the secrets usable" rather than an environment row that can disagree with the
// carrier it describes.
type SparkProvisioningEnvironment {
  controller: BootstrapControllerStanding
  pxe: PxePrerequisiteStanding
}

// THE ACTUAL WORLD, 2026-08-07, and every arm is Unknown on purpose. No bootstrap
// controller has been established; no path from any workflow to Secret Manager exists, so
// no credential can be materialized; and the PXE prerequisites belong to a lane that has
// not run. Every consumer of this row therefore gets an undecidable answer, which is the
// honest one — a concrete human-step count for the factory lane today would be theater.
data spark_current_environment: SparkProvisioningEnvironment = SparkProvisioningEnvironment {
  controller: BootstrapControllerUnknown,
  pxe: PxePrerequisitesUnknown,
}

// ------------------------------------------------------------------------------------
// Observation. Completion is constructible ONLY from these.
// ------------------------------------------------------------------------------------

type AccountObservation
  = AccountObserved { name: NonEmptyStr }
  | AccountNotObserved

type ReachObservation
  = LanReachObserved { address: Ipv4Address }
  | LanReachNotObserved

type SetupSurfaceStanding
  = SetupSurfaceCompleted
  | SetupSurfaceIncomplete
  | SetupSurfaceUnobserved

type PostSetupObservation {
  account: AccountObservation
  lan_reach: ReachObservation
  setup_surface: SetupSurfaceStanding
  software: InitialUpdateDisposition
}

// ------------------------------------------------------------------------------------
// Outcome. Four arms, and the whole point of the module is that they stay four.
// ------------------------------------------------------------------------------------

type SparkProvisioningPhase
  = PhaseBootstrapAccess
  | PhaseOperatorConfiguration
  | PhaseNetworkJoin
  | PhaseInitialSoftwareImage
  | PhasePostSetupAccess

type SparkProvisioningInterruptionCause
  = ExpectedRebootInProgress
  | InitialSoftwareImageInstalling
  | PrerequisiteNotYetReached { prerequisite: NonEmptyStr }
  | BootstrapNetworkHandoffInProgress
  | PostSetupObservationIncomplete { missing: NonEmptyStr }

type SparkProvisioningRefusalCause
  = InstallerRejectedField { field: NonEmptyStr }
  | BootstrapCredentialRejected
  | SensitiveInputAdmissionRefused
  | StrategyUnsupportedOnDevice { detail: NonEmptyStr }

// THE RECEIPT IS BUILT FROM OBSERVATION, NEVER FROM INTENT. An earlier revision carried a
// spark_receipt_from_intent that recast the requested state as the achieved one — the
// fabricated-plausible-output class in its purest form, since a provision that never ran
// produced a receipt indistinguishable from one that did. That function is DELETED rather
// than guarded: leaving it callable would relocate the defect instead of closing it, and
// the receipt now has no constructor that does not carry a device observation.
//
// initial_update likewise comes from the device, not from the extdeps documented row: what
// the vendor pages say about first-boot updates is a fact about the DOCS, and copying it
// into a receipt would claim an observation nobody made.
type SparkProvisioningReceipt {
  host: HostIdentity
  administrator: PosixUser
  strategy_used: SparkProvisioningStrategy
  account: AccountObservation
  lan_reach: ReachObservation
  initial_update: InitialUpdateDisposition
}

// Collapsing any pair of these is the state-space conflation DESIGN's failure-mode list
// names, and each collapse has its own harm. Interrupted-as-Refused aborts a working
// install at its documented reboot. Refused-as-Interrupted retries forever against a
// device that already said no. HumanInterventionRequired-as-Refused reads a step nobody
// has performed yet as the device rejecting it. HumanInterventionRequired-as-Interrupted
// waits for a transition that cannot occur without a person who has not been asked.
type SparkProvisioningOutcome
  = SparkProvisioned { receipt: SparkProvisioningReceipt }
  | SparkProvisioningInterrupted {
      phase: SparkProvisioningPhase,
      cause: SparkProvisioningInterruptionCause
    }
  | SparkProvisioningHumanInterventionRequired { intervention: HumanIntervention }
  | SparkProvisioningRefused {
      phase: SparkProvisioningPhase,
      cause: SparkProvisioningRefusalCause
    }

type SparkProvisioningProgress
  = ProgressPostSetupObserved { observation: PostSetupObservation }
  | ProgressAwaitingDocumentedReboot
  | ProgressInstallingSoftwareImage
  | ProgressBootstrapHandoffPending
  | ProgressPrerequisiteNotYetReached { prerequisite: NonEmptyStr }
  | ProgressAwaitingHuman { intervention: HumanIntervention }
  | ProgressDeviceRejectedField { field: NonEmptyStr }
  | ProgressBootstrapCredentialRejected
  | ProgressStrategyUnsupported { detail: NonEmptyStr }
  | ProgressSensitiveInputRefused

// An incomplete observation is an INTERRUPTION, not a refusal and not a success: nothing
// rejected anything, and the provision simply has not been seen to finish. The missing
// element is named so the gap is countable rather than a silent not-yet.
fn post_setup_observation_gap(observation: PostSetupObservation) -> NonEmptyStr? {
  match observation.account {
    AccountNotObserved => Present { value: "administrator account not observed on the device" }
    AccountObserved { name: _ } => match observation.lan_reach {
      LanReachNotObserved => Present { value: "device not observed reachable on the LAN" }
      LanReachObserved { address: _ } => match observation.setup_surface {
        SetupSurfaceUnobserved => Present { value: "post-OOBE setup surface not observed" }
        SetupSurfaceIncomplete => Present { value: "post-OOBE setup surface observed incomplete" }
        SetupSurfaceCompleted => match observation.software {
          InitialUpdateBehaviorUnobserved =>
            Present { value: "initial software baseline not observed on the device" }
          InitialUpdateAppliedDuringSetup => Absent
          InitialUpdateDeferredToOperator => Absent
        }
      }
    }
  }
}

fn classify_spark_progress(
  intent: SparkProvisioningIntent,
  phase: SparkProvisioningPhase,
  progress: SparkProvisioningProgress
) -> SparkProvisioningOutcome {
  match progress {
    ProgressPostSetupObserved { observation: observation } =>
      match post_setup_observation_gap(observation: observation) {
        Present { value: missing } =>
          SparkProvisioningInterrupted {
            phase: PhasePostSetupAccess,
            cause: PostSetupObservationIncomplete { missing: missing }
          }
        Absent =>
          SparkProvisioned {
            receipt: SparkProvisioningReceipt {
              host: intent.host,
              administrator: intent.administrator,
              strategy_used: intent.strategy,
              account: observation.account,
              lan_reach: observation.lan_reach,
              initial_update: observation.software,
            }
          }
      }
    ProgressAwaitingDocumentedReboot =>
      SparkProvisioningInterrupted { phase: phase, cause: ExpectedRebootInProgress }
    ProgressInstallingSoftwareImage =>
      SparkProvisioningInterrupted { phase: phase, cause: InitialSoftwareImageInstalling }
    ProgressBootstrapHandoffPending =>
      SparkProvisioningInterrupted { phase: phase, cause: BootstrapNetworkHandoffInProgress }
    ProgressPrerequisiteNotYetReached { prerequisite: p } =>
      SparkProvisioningInterrupted {
        phase: phase,
        cause: PrerequisiteNotYetReached { prerequisite: p }
      }
    ProgressAwaitingHuman { intervention: i } =>
      SparkProvisioningHumanInterventionRequired { intervention: i }
    ProgressDeviceRejectedField { field: f } =>
      SparkProvisioningRefused { phase: phase, cause: InstallerRejectedField { field: f } }
    ProgressBootstrapCredentialRejected =>
      SparkProvisioningRefused { phase: phase, cause: BootstrapCredentialRejected }
    ProgressStrategyUnsupported { detail: d } =>
      SparkProvisioningRefused {
        phase: phase,
        cause: StrategyUnsupportedOnDevice { detail: d }
      }
    ProgressSensitiveInputRefused =>
      SparkProvisioningRefused { phase: phase, cause: SensitiveInputAdmissionRefused }
  }
}

// ------------------------------------------------------------------------------------
// Human burden. DERIVED from environment standing, never authored.
// ------------------------------------------------------------------------------------

fn spark_intervention(
  identity: NonEmptyStr,
  frequency: HumanInterventionFrequency,
  subject: NonEmptyStr,
  instruction: NonEmptyStr
) -> HumanIntervention {
  HumanIntervention {
    identity: identity as HumanInterventionIdentity,
    frequency: frequency,
    subject: subject,
    instruction: instruction,
    completion_evidence: NoDischargeSiteModeled,
  }
}

// A burden is not a property of a strategy — it is a property of a strategy MEETING an
// environment. Associating with a Wi-Fi hotspot and filling a captive portal are machine
// capabilities: given a controller that can reach the bootstrap network and credentials
// already materialized, the human OOBE burden is EMPTY. An earlier revision authored
// hotspot association as an irreducible DeviceOnce human step, which priced a capability
// the fleet either has or can acquire as though it were a law of physics, and made
// FactoryOobe permanently look more expensive than it is.
//
// Sticker capture is likewise absent: the units' bootstrap credentials were supplied at
// receiving. Completed work is not remaining work, and carrying it as a pending
// intervention would inflate every burden comparison that consumes this.
type HumanBurdenDerivation
  = BurdenDerived { burden: ProvisioningHumanBurden }
  | BurdenUndecidable { cause: NonEmptyStr }

fn factory_oobe_human_burden(
  env: SparkProvisioningEnvironment,
  credentials: SparkProvisioningCredentials
) -> HumanBurdenDerivation {
  match env.controller {
    BootstrapControllerUnknown =>
      BurdenUndecidable {
        cause: "bootstrap controller standing unknown: whether a machine can drive the OOBE association has not been established, and guessing either way prices a burden that may not exist."
      }
    BootstrapControllerReady => match spark_credentials_standing(c: credentials) {
      BootstrapCredentialsMaterialized =>
        BurdenDerived { burden: ProvisioningHumanBurden { interventions: [] } }
      BootstrapCredentialsNotMaterialized =>
        BurdenDerived {
          burden: ProvisioningHumanBurden {
            interventions: [spark_credential_materialization_intervention()]
          }
        }
    }
    BootstrapControllerAbsent =>
      BurdenDerived {
        burden: ProvisioningHumanBurden {
          interventions: [spark_manual_oobe_intervention()]
        }
      }
  }
}

fn spark_credential_materialization_intervention() -> HumanIntervention {
  spark_intervention(
    identity: "spark-bootstrap-credential-materialization",
    frequency: DeviceOnce,
    subject: "bootstrap credential materialization",
    instruction: "Make this unit's already-supplied bootstrap password available to the controller as a materialized secret. The credential exists; only its binding to the controller is outstanding."
  )
}

fn spark_manual_oobe_intervention() -> HumanIntervention {
  spark_intervention(
    identity: "spark-oobe-manual-association",
    frequency: EveryProvision,
    subject: "bootstrap network association and portal completion",
    instruction: "No controller can reach this unit's bootstrap network, so a person associates with the hotspot and completes the captive portal by hand. This is the cost of the missing controller, not of the strategy."
  )
}

fn pxe_autoinstall_human_burden(env: SparkProvisioningEnvironment) -> HumanBurdenDerivation {
  match env.pxe {
    PxePrerequisitesUnknown =>
      BurdenUndecidable {
        cause: "PXE prerequisite standing unknown: neither the boot environment nor this unit's firmware posture has been observed. Owed to SPARK-PXE-0."
      }
    PxePrerequisitesReady =>
      BurdenDerived {
        burden: ProvisioningHumanBurden {
          interventions: [spark_pxe_recovery_intervention()]
        }
      }
    PxePrerequisitesAbsent =>
      BurdenDerived {
        burden: ProvisioningHumanBurden {
          interventions: [
            spark_pxe_environment_intervention(),
            spark_pxe_firmware_intervention(),
            spark_pxe_recovery_intervention(),
          ]
        }
      }
  }
}

fn spark_pxe_environment_intervention() -> HumanIntervention {
  spark_intervention(
    identity: "spark-pxe-boot-environment",
    frequency: FleetOnce,
    subject: "network boot environment",
    instruction: "Stand up the TFTP, HTTP and DHCP services the DGX Spark PXE chain requires. Paid once for the fleet, not once per unit."
  )
}

fn spark_pxe_firmware_intervention() -> HumanIntervention {
  spark_intervention(
    identity: "spark-pxe-firmware-enablement",
    frequency: DeviceOnce,
    subject: "UEFI network stack",
    instruction: "At this unit's console, either disable secure boot or enroll grubnetaa64.efi.signed, then enable PXE on the chosen interface under Network Stack Configuration."
  )
}

fn spark_pxe_recovery_intervention() -> HumanIntervention {
  spark_intervention(
    identity: "spark-recovery-media-reinstall",
    frequency: BreakGlassOnly,
    subject: "recovery",
    instruction: "Emergency only: reinstall from the FastOS recovery archive. Never scheduled, never part of a routine provision."
  )
}

fn spark_strategy_human_burden(
  strategy: SparkProvisioningStrategy,
  env: SparkProvisioningEnvironment,
  credentials: SparkProvisioningCredentials
) -> HumanBurdenDerivation {
  match strategy {
    FactoryOobe { bootstrap: _ } =>
      factory_oobe_human_burden(env: env, credentials: credentials)
    PxeAutoinstall { environment: _, image: _, install_spec: _ } =>
      pxe_autoinstall_human_burden(env: env)
  }
}

// ------------------------------------------------------------------------------------
// Strategy selection, against a real environment.
// ------------------------------------------------------------------------------------

// Selection minimizes routine burden lexicographically (EveryProvision, then DeviceOnce,
// then FleetOnce) and never prices BreakGlassOnly — see std.human_intervention. It cannot
// be answered from static costs: whether a relay exists, whether the PXE network exists,
// and whether firmware is ready all move the answer, so an environment is required and an
// undecidable standing REFUSES rather than defaulting to whichever strategy happens to
// look cheap while the world is unknown.
type SparkStrategySelection
  = StrategySelected { strategy: SparkProvisioningStrategy }
  | StrategySelectionUndecidable { cause: NonEmptyStr }

fn select_spark_strategy(
  a: SparkProvisioningStrategy,
  b: SparkProvisioningStrategy,
  env: SparkProvisioningEnvironment,
  credentials: SparkProvisioningCredentials
) -> SparkStrategySelection {
  match spark_strategy_human_burden(strategy: a, env: env, credentials: credentials) {
    BurdenUndecidable { cause: cause_a } => StrategySelectionUndecidable { cause: cause_a }
    BurdenDerived { burden: burden_a } =>
      match spark_strategy_human_burden(strategy: b, env: env, credentials: credentials) {
        BurdenUndecidable { cause: cause_b } => StrategySelectionUndecidable { cause: cause_b }
        BurdenDerived { burden: burden_b } =>
          match compare_routine_human_burden(a: burden_a, b: burden_b) {
            Less => StrategySelected { strategy: a }
            Equal => StrategySelected { strategy: a }
            Greater => StrategySelected { strategy: b }
          }
      }
  }
}

// ------------------------------------------------------------------------------------
// Intent construction.
// ------------------------------------------------------------------------------------

data spark_license_acceptance: LicenseAcceptance = LicenseAcceptance {
  terms_identity: "NVIDIA DGX Spark first-boot terms and conditions",
  accepted_by: fleet_posix_operator_user.name,
}

// The per-unit intent rows are deliberately NOT authored yet, and that is the correct
// state rather than a deficiency. They need the two credential secret names, which do not
// exist: no path from any workflow to Secret Manager has been established, and the
// secrets themselves have not been created. Reconstructing those names from a rendered
// host identity is precisely what the credential module forbids, so the constructor waits
// for real values instead of accepting invented ones.
fn spark_provisioning_intent(
  host: HostIdentity,
  credentials: SparkProvisioningCredentials,
  address: Ipv4Address,
  strategy: SparkProvisioningStrategy
) -> SparkProvisioningIntent {
  SparkProvisioningIntent {
    host: host,
    administrator: fleet_posix_operator_user,
    credentials: credentials,
    locale: "en_US.UTF-8",
    timezone: "America/New_York",
    telemetry: TelemetryDeclined,
    network: SparkNetworkPlacement { address: address },
    license: spark_license_acceptance,
    strategy: strategy,
  }
}
