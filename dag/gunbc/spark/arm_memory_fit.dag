// ── WHAT THIS MODULE IS ─────────────────────────────────────────────────────────────────────────
//
// THE VERDICT IS THREE-ARMED AND THERE IS NO FOURTH. ArmMemoryFitProved / ArmMemoryFitRefused /
// ArmMemoryFitUnestablished are the only constructors, and a launch is admitted for normal serving
// only on the first. Refused means even the MOST FAVORABLE reading of supply against the least the
// arm mandatorily needs cannot fit; Unestablished means a named component has no defensible bound
// and the intervals do not decide. BOTH stop a normal-serving launch -- they name different
// repairs, and "run it and see" is not a verdict arm.
//
// THE PROOF IS COMPOSITIONAL, PER RANK, PER PHASE, OVER INTERVALS, and its subject is SEALED:
// a consumer cannot assemble a subject by hand and hand it to the verdict fold. The mints are the
// only constructors, and they enforce three things construction must guarantee, so no validation
// downstream can be skipped by building the wrong shape (review blockers one and three):
//
//   1. THE INTENT/PROFILE JOIN. The executable profile the engine will run is DERIVED from the
//      capacity intent (gunbc.spark.serving_capacity_intent profile_for_intent), and the mint
//      refuses any subject whose profile is not that derivation. A proof about four 64K seats
//      cannot stand beside a sixteen-sequence 262K executable: the engine config the proof prices
//      and the engine config the launch renders are one value by construction. The launch wall
//      prices the profile's maximum admitted behavior (every admitted sequence at the full
//      window); a smaller recorded intent lowers demand only when a request-admission authority
//      exists to enforce it, and none is modeled yet -- that is the honest direction until one is.
//   2. CONSERVATION. A rank's demand is a COMPLETE RECORD -- one named bound per mechanism,
//      checkpoint residency through fragmentation allowance -- and the supply side is a complete
//      record of its two deductions. A missing KV term or a duplicated component has no spelling;
//      a rank roster with a duplicated or absent rank index is refused at the mint.
//   3. PROVENANCE. A measured bound's receipt must name the checkpoint, runtime and topology it
//      was measured on; a receipt carried onto a changed checkpoint or runtime is refused. The
//      checkpoint term itself is never even-split by assumption: per-rank placement bounds are OPEN
//      until a CheckpointRankResidencyBound measurement mints them, and the aggregate impossibility
//      argument ("at least one rank cannot hold its mandatory share") is carried separately so the
//      proof never fabricates WHICH rank.
//
// PHASES KEEP TRANSIENTS IN THEIR PHASE, and the engine's decided envelope is a second supply
// wall on the engine-admitted phases. AN UNMODELED POOL IS UNESTABLISHED, NOT REFUSED: "we have
// no pool reading" names an obligation; it is not evidence the arm cannot fit.

// ── THE PHASES ───────────────────────────────────────────────────────────────────────────────────
//
// model_load        the checkpoint bytes land on the rank.
// loader_transform  the loader's padding, repacking and temporary copies on top of the resident
//                   checkpoint; a TRANSIENT that ends when loading completes.
// profiling         the engine's memory profiling pass: weights resident, activation and collective
//                   workspaces at their measured peaks, no serving KV yet.
// graph_capture     CUDA graph capture: the capture workspace plus what persists after it.
// idle_serving      the steady state with the minted KV pool resident and nothing in flight.
// peak_serving      idle plus the activation/workspace peak and the fragmentation allowance the
//                   allocator exhibits under churn.
// restart_overlap   the successor engine's load across a restart. The pair's restart admission
//                   (gunbc.spark.pair_serving_capacity_floor restart_admission) requires the old
//                   engine to be withdrawn, drained and STOPPED before the new one starts, so two
//                   device-resident weight sets never coexist; the phase carries the successor's
//                   load profile -- checkpoint, loader transient, runtime fixed -- and exists so a
//                   consumer modeling a coarser protocol (overlap without quiescence) widens the
//                   terms HERE rather than silently.
type ArmMemoryFitPhase
  = ArmPhaseModelLoad
  | ArmPhaseLoaderTransform
  | ArmPhaseProfiling
  | ArmPhaseGraphCapture
  | ArmPhaseIdleServing
  | ArmPhasePeakServing
  | ArmPhaseRestartOverlap

fn arm_memory_fit_phase_wire(p: ArmMemoryFitPhase) -> String {
  match p {
    ArmPhaseModelLoad => "model-load"
    ArmPhaseLoaderTransform => "loader-transform"
    ArmPhaseProfiling => "profiling"
    ArmPhaseGraphCapture => "graph-capture"
    ArmPhaseIdleServing => "idle-serving"
    ArmPhasePeakServing => "peak-serving"
    ArmPhaseRestartOverlap => "restart-overlap"
  }
}

data arm_memory_fit_phases: List<ArmMemoryFitPhase> = [
  ArmPhaseModelLoad,
  ArmPhaseLoaderTransform,
  ArmPhaseProfiling,
  ArmPhaseGraphCapture,
  ArmPhaseIdleServing,
  ArmPhasePeakServing,
  ArmPhaseRestartOverlap,
]

// ── THE NAMED COMPONENTS, ONE TERM EACH ──────────────────────────────────────────────────────────
//
// THE CENSUS IS CLOSED, and the rank record below carries exactly one bound per variant -- an
// exhaustive match over this coproduct is what keeps the sum from silently losing a term.
type ArmMemoryComponent
  = ArmCheckpointResidency
  | ArmLoaderTransform
  | ArmRuntimeFixed
  | ArmCollectiveWorkspace
  | ArmActivationWorkspace
  | ArmGraphCapture
  | ArmKvCache
  | ArmFragmentationAllowance

fn arm_memory_component_wire(c: ArmMemoryComponent) -> String {
  match c {
    ArmCheckpointResidency => "checkpoint-residency"
    ArmLoaderTransform => "loader-transform"
    ArmRuntimeFixed => "runtime-fixed"
    ArmCollectiveWorkspace => "collective-workspace"
    ArmActivationWorkspace => "activation-workspace"
    ArmGraphCapture => "graph-capture"
    ArmKvCache => "kv-cache"
    ArmFragmentationAllowance => "fragmentation-allowance"
  }
}

// ── THE PHASE RESIDENCY TABLE ────────────────────────────────────────────────────────────────────
//
// WHICH COMPONENTS HOLD RESIDENT IN WHICH PHASE is one exhaustive function over both coproducts,
// so a new component answers the phase question in the same commit that adds it and the demand
// folds cannot quietly charge a component everywhere.
fn component_resident_in_phase(c: ArmMemoryComponent, p: ArmMemoryFitPhase) -> Bool {
  match c {
    ArmCheckpointResidency => true
    ArmLoaderTransform =>
      match p {
        ArmPhaseModelLoad => false
        ArmPhaseLoaderTransform => true
        ArmPhaseProfiling => false
        ArmPhaseGraphCapture => false
        ArmPhaseIdleServing => false
        ArmPhasePeakServing => false
        ArmPhaseRestartOverlap => true
      }
    ArmRuntimeFixed => true
    ArmCollectiveWorkspace =>
      match p {
        ArmPhaseModelLoad => false
        ArmPhaseLoaderTransform => false
        ArmPhaseProfiling => true
        ArmPhaseGraphCapture => true
        ArmPhaseIdleServing => true
        ArmPhasePeakServing => true
        ArmPhaseRestartOverlap => false
      }
    ArmActivationWorkspace =>
      match p {
        ArmPhaseModelLoad => false
        ArmPhaseLoaderTransform => false
        ArmPhaseProfiling => true
        ArmPhaseGraphCapture => true
        ArmPhaseIdleServing => false
        ArmPhasePeakServing => true
        ArmPhaseRestartOverlap => false
      }
    ArmGraphCapture =>
      match p {
        ArmPhaseModelLoad => false
        ArmPhaseLoaderTransform => false
        ArmPhaseProfiling => false
        ArmPhaseGraphCapture => true
        ArmPhaseIdleServing => true
        ArmPhasePeakServing => true
        ArmPhaseRestartOverlap => false
      }
    ArmKvCache =>
      match p {
        ArmPhaseModelLoad => false
        ArmPhaseLoaderTransform => false
        ArmPhaseProfiling => false
        ArmPhaseGraphCapture => true
        ArmPhaseIdleServing => true
        ArmPhasePeakServing => true
        ArmPhaseRestartOverlap => false
      }
    ArmFragmentationAllowance =>
      match p {
        ArmPhaseModelLoad => false
        ArmPhaseLoaderTransform => false
        ArmPhaseProfiling => false
        ArmPhaseGraphCapture => false
        ArmPhaseIdleServing => false
        ArmPhasePeakServing => true
        ArmPhaseRestartOverlap => false
      }
  }
}

// THE ENVELOPE CONSTRAINS ONLY THE ENGINE-ADMITTED PHASES. The envelope is the engine's own
// allocator ceiling: requested at startup, binding from profiling onward. The load phases precede
// that admission -- the loader's host-side staging (the checkpoint is file-backed in the same
// pool) is pool-resident but NOT envelope-resident -- so load-phase demand is bounded by the pool
// wall alone.
fn envelope_constrains_phase(p: ArmMemoryFitPhase) -> Bool {
  match p {
    ArmPhaseModelLoad => false
    ArmPhaseLoaderTransform => false
    ArmPhaseProfiling => true
    ArmPhaseGraphCapture => true
    ArmPhaseIdleServing => true
    ArmPhasePeakServing => true
    ArmPhaseRestartOverlap => false
  }
}

// ── THE BOUND VOCABULARY ─────────────────────────────────────────────────────────────────────────
//
// A TERM CARRIES WHAT IS DEFENSIBLE AND NOTHING MORE. Exact is a genuinely exact derivation -- the
// KV byte figure is workload x layout arithmetic, not an estimate -- and an observation against it
// must EQUAL it, in either direction of mismatch the derivation was derived from the wrong
// subject. Interval is a DERIVED pair of endpoints with a refusing mint. Ceiling is an UPPER ONLY:
// a component-scoped measurement bounds the term above and contributes nothing to a demand lower
// bound. Open is NEITHER: the named obligation states what measurement would bound it. A zero is
// not the Open arm in a wig.
type ArmComponentBound
  = ComponentBoundExact { bytes: ByteSize, how: NonEmptyStr }
  | ComponentBoundInterval { lower: ByteSize, upper: ByteSize, how: NonEmptyStr }
  | ComponentBoundCeiling { bytes: ByteSize, receipt: NonEmptyStr }
  | ComponentBoundOpen { obligation: NonEmptyStr }

fn bound_is_open(b: ArmComponentBound) -> Bool {
  match b {
    ComponentBoundOpen { obligation: _ } => true
    ComponentBoundExact { bytes: _, how: _ } => false
    ComponentBoundInterval { lower: _, upper: _, how: _ } => false
    ComponentBoundCeiling { bytes: _, receipt: _ } => false
  }
}

fn bound_upper_opt(b: ArmComponentBound) -> ByteSize? {
  match b {
    ComponentBoundExact { bytes: b, how: _ } => Present { value: b }
    ComponentBoundInterval { lower: _, upper: u, how: _ } => Present { value: u }
    ComponentBoundCeiling { bytes: b, receipt: _ } => Present { value: b }
    ComponentBoundOpen { obligation: _ } => none
  }
}

fn bound_lower(b: ArmComponentBound) -> ByteSize {
  match b {
    ComponentBoundExact { bytes: b, how: _ } => b
    ComponentBoundInterval { lower: l, upper: _, how: _ } => l
    ComponentBoundCeiling { bytes: _, receipt: _ } => byte_size(count: 0)
    ComponentBoundOpen { obligation: _ } => byte_size(count: 0)
  }
}

type ArmComponentBoundMint
  = ArmComponentBoundReady { bound: ArmComponentBound }
  | ArmComponentBoundRefused { cause: NonEmptyStr }

// THE MINT FOR DERIVED INTERVALS, with std.interval's law: a reversed pair is refused, typed and
// located, never silently swapped.
fn component_bound_interval(lower: ByteSize, upper: ByteSize, how: NonEmptyStr) -> ArmComponentBoundMint {
  if measure_le(a: lower, b: upper) {
    ArmComponentBoundReady { bound: ComponentBoundInterval { lower: lower, upper: upper, how: how } }
  } else {
    ArmComponentBoundRefused { cause: "component bound endpoints reversed: the derived lower exceeds the derived upper, so the derivation is wrong somewhere above this mint" as NonEmptyStr }
  }
}

// ── CONSERVATION: THE RANK RECORD AND THE DEDUCTIONS RECORD ──────────────────────────────────────
//
// A RANK'S DEMAND IS A COMPLETE RECORD, one named bound per mechanism. The review blocker this
// closes: a terms-LIST subject with the right NUMBER of rows could omit the KV term (or duplicate
// one) and the fold would price the hole as a zero, minting a FitProved that never priced the
// cache. A record has no omit-or-duplicate spelling; the phase folds read the fields by name.
type ArmRankDemand {
  rank: Nat
  checkpoint_residency: ArmComponentBound
  loader_transform: ArmComponentBound
  runtime_fixed: ArmComponentBound
  collective_workspace: ArmComponentBound
  activation_workspace: ArmComponentBound
  graph_capture: ArmComponentBound
  kv_cache: ArmComponentBound
  fragmentation_allowance: ArmComponentBound
}

// THE FIELD ACCESSOR, exhaustive over the component coproduct: the folds below ask for a
// component's bound through this function, so a component added to the census forces the record to
// grow in the same commit and the record cannot be read at the wrong field.
fn rank_component_bound(rd: ArmRankDemand, c: ArmMemoryComponent) -> ArmComponentBound {
  match c {
    ArmCheckpointResidency => rd.checkpoint_residency
    ArmLoaderTransform => rd.loader_transform
    ArmRuntimeFixed => rd.runtime_fixed
    ArmCollectiveWorkspace => rd.collective_workspace
    ArmActivationWorkspace => rd.activation_workspace
    ArmGraphCapture => rd.graph_capture
    ArmKvCache => rd.kv_cache
    ArmFragmentationAllowance => rd.fragmentation_allowance
  }
}

data arm_memory_components: List<ArmMemoryComponent> = [
  ArmCheckpointResidency,
  ArmLoaderTransform,
  ArmRuntimeFixed,
  ArmCollectiveWorkspace,
  ArmActivationWorkspace,
  ArmGraphCapture,
  ArmKvCache,
  ArmFragmentationAllowance,
]

// THE SUPPLY DEDUCTIONS ARE A COMPLETE RECORD TOO: the host/OS/control-plane reserve and the
// foreign residency of the unified pool, each bounded above or carried open. There are exactly
// two, for the same reason the rank record is complete -- an omitted deduction is a supply the
// proof silently claims.
type ArmSupplyDeductions {
  host_os_control_reserve: ArmComponentBound
  foreign_residency: ArmComponentBound
}

// ── THE POOL ─────────────────────────────────────────────────────────────────────────────────────
//
// THE POOL IS AN INTERVAL, NOT A CONSTANT: the GB10 figure this fleet carries was read rounded
// (gunbc.spark.serving_arm gb10_unified_pool_gib), so the honest carrier is a span whose width is
// the reporter's rounding unit. AN UNMODELED POOL IS THE UNBOUNDED ARM, and the verdict fold
// treats it as UNESTABLISHED -- an obligation naming the missing reading -- never as a refusal:
// "not modeled" is not "impossible".
type ArmPoolBound
  = ArmPoolBounded { span: OrderedClosedInterval<ByteSize>, how: NonEmptyStr }
  | ArmPoolUnbounded { obligation: NonEmptyStr }

// ── THE PROOF SUBJECT, SEALED ────────────────────────────────────────────────────────────────────
//
// EVERYTHING THE VERDICT IS ABOUT IS A FIELD, and the seal keeps it that way: the two mints below
// are the only constructors. `profile` is ALWAYS the intent's derivation (join enforced at mint);
// `ranks` is minted one row per topology rank; `checkpoint_total` is the derived aggregate the
// per-rank placement argument uses; `intent` is the priced workload. A receipt is one producer of
// a bound, not a structural prerequisite: measured rank records enter through the second mint,
// whose provenance checks bind them to this exact identity.
type ArmMemoryFitSubject sole_constructor {
  checkpoint: ServingCheckpoint
  runtime: ServingRuntime
  topology: ServingTopology
  intent: ServingCapacityIntent
  profile: ServingLaunchProfile
  ranks: List<ArmRankDemand>
  checkpoint_total: OrderedClosedInterval<ByteSize>
  pool: ArmPoolBound
  deductions: ArmSupplyDeductions
}

type ArmMemorySubjectMint
  = ArmMemorySubjectReady { subject: ArmMemoryFitSubject }
  | ArmMemorySubjectRefused { cause: NonEmptyStr }

// THE VERIFIED JOIN: the executable profile must be the intent's derivation. The launch wall
// reaches the intent as the profile's maximum admitted behavior (intent_for_launch_profile:
// every admitted sequence at the full window, cold); a future request-admission authority may
// record a smaller authored intent, and then this same check is the wall that keeps the launch
// honest. Policy fields (utilization, KV dtype, port, alias, prefix caching) travel with the
// requested profile and are not part of the join.
fn profile_joins_intent(intent: ServingCapacityIntent, p: ServingLaunchProfile) -> Bool {
  token_count_value(t: p.max_model_len) == token_count_value(t: intent_max_single_sequence_tokens(i: intent))
    && p.max_num_seqs == intent_max_active_sequences(i: intent)
    && token_count_value(t: p.max_num_batched_tokens) == token_count_value(t: intent.max_batched_tokens)
}

// RANK ROSTER VALIDATION, refusing what a count-only check would miss: the right NUMBER of rows
// with a duplicated index, or an absent one, is refused. Exactly one row per rank index 0..n-1.
fn rank_index_count(ranks: List<ArmRankDemand>, index: Nat) -> Nat {
  count(filter(ranks, r => r.rank == index))
}

fn rank_roster_valid(ranks: List<ArmRankDemand>, rank_count: Nat) -> Bool {
  count(ranks) == rank_count
    && all(nat_range_inclusive(lo: 1, hi: rank_count), i => rank_index_count(ranks: ranks, index: i - 1) == 1)
}

fn rank_roster_refusal(ranks: List<ArmRankDemand>, rank_count: Nat) -> NonEmptyStr {
  if count(ranks) != rank_count {
    join([
      "the rank roster carries ", to_string(count(ranks)),
      " row(s) against a topology of ", to_string(rank_count),
      " rank(s): a tensor-parallel degree is a property of the arm, so the roster must be exactly one row per rank",
    ], "") as NonEmptyStr
  } else {
    join([
      "the rank roster does not hold exactly one row per rank index 0..", to_string(rank_count - 1),
      ": a duplicated or absent rank index means the demand population does not describe this arm",
    ], "") as NonEmptyStr
  }
}

// PROVENANCE: a non-open bound must name the identity it was derived or measured on, so a receipt
// minted for one checkpoint, runtime or topology cannot be carried onto another. The check is a
// containment test on the receipt/how text -- the typed identity ride-along lands with the
// receipt-roster join (the dissolution frontier below), and until then the wires are spelled.
fn bound_names_identity(b: ArmComponentBound, ckpt: ServingCheckpoint, rt: ServingRuntime, tp: ServingTopology) -> Bool {
  let ckpt_wire = serving_checkpoint_wire(c: ckpt) as String
  let rt_wire = serving_runtime_wire(r: rt) as String
  let tp_wire = serving_topology_wire(t: tp) as String
  match b {
    ComponentBoundExact { bytes: _, how: h } =>
      string_contains(s: h as String, pattern: ckpt_wire)
        && string_contains(s: h as String, pattern: tp_wire)
    ComponentBoundInterval { lower: _, upper: _, how: h } =>
      string_contains(s: h as String, pattern: ckpt_wire)
        && string_contains(s: h as String, pattern: tp_wire)
    ComponentBoundCeiling { bytes: _, receipt: r } =>
      string_contains(s: r as String, pattern: ckpt_wire)
        && string_contains(s: r as String, pattern: rt_wire)
        && string_contains(s: r as String, pattern: tp_wire)
    ComponentBoundOpen { obligation: _ } => true
  }
}

fn roster_names_identity(ranks: List<ArmRankDemand>, ckpt: ServingCheckpoint, rt: ServingRuntime, tp: ServingTopology) -> Bool {
  all(ranks, r =>
    all(arm_memory_components, c => bound_names_identity(b: rank_component_bound(rd: r, c: c), ckpt: ckpt, rt: rt, tp: tp)))
}

// THE DERIVED CHECKPOINT AGGREGATE. The checkpoint row's ceil-GiB figure bounds the TRUE total
// bytes in ((g-1) GiB, g GiB]; an even per-rank split is NOT assumed anywhere -- per-rank
// placement is open until measured -- and this aggregate is what the pigeonhole impossibility
// argument and the rank-sum conservation law read.
fn checkpoint_total_span(crow_weight_gib: Gibibyte) -> ArmComponentBoundMint {
  let g = gibibyte_count(g: crow_weight_gib)
  if g == 0 {
    ArmComponentBoundRefused { cause: "the checkpoint row carries a zero weight figure, so the total residency interval cannot be derived from it" as NonEmptyStr }
  } else {
    component_bound_interval(
      lower: byte_size(count: byte_size_count(b: gibibyte_to_byte_size(g: gibibyte(count: g - 1))) + 1),
      upper: gibibyte_to_byte_size(g: gibibyte(count: g)),
      how: "the checkpoint row's ceil-GiB figure: the manifest bytes lie in ((g-1) GiB, g GiB]; the placement of those bytes across ranks is NOT derived here" as NonEmptyStr)
  }
}

fn open_demand_obligation(component: ArmMemoryComponent, receipt_kind: NonEmptyStr) -> NonEmptyStr {
  join([
    "no component-scoped receipt of kind ", receipt_kind,
    " exists for this checkpoint x loader/runtime x topology x rank; a bounded experiment on this subject is what mints one",
  ], "") as NonEmptyStr
}

fn open_checkpoint_placement_obligation() -> NonEmptyStr {
  "per-rank checkpoint placement is unread: an even tensor-parallel split is an assumption, not a measurement, and the true per-rank residency follows from the loader's placement decisions; a CheckpointRankResidencyBound measurement per rank bounds it" as NonEmptyStr
}

// ONE OPEN RANK ROW: every mechanism carried open, the checkpoint with the placement obligation.
fn open_rank_demand(rank: Nat) -> ArmRankDemand {
  ArmRankDemand {
    rank: rank,
    checkpoint_residency: ComponentBoundOpen { obligation: open_checkpoint_placement_obligation() },
    loader_transform: ComponentBoundOpen { obligation: open_demand_obligation(component: ArmLoaderTransform, receipt_kind: "CheckpointRankResidencyBound" as NonEmptyStr) },
    runtime_fixed: ComponentBoundOpen { obligation: open_demand_obligation(component: ArmRuntimeFixed, receipt_kind: "RuntimeFixedAllocationBound" as NonEmptyStr) },
    collective_workspace: ComponentBoundOpen { obligation: open_demand_obligation(component: ArmCollectiveWorkspace, receipt_kind: "CollectiveWorkspaceBound" as NonEmptyStr) },
    activation_workspace: ComponentBoundOpen { obligation: open_demand_obligation(component: ArmActivationWorkspace, receipt_kind: "ActivationWorkspaceBound" as NonEmptyStr) },
    graph_capture: ComponentBoundOpen { obligation: open_demand_obligation(component: ArmGraphCapture, receipt_kind: "GraphCaptureBound" as NonEmptyStr) },
    kv_cache: ComponentBoundOpen { obligation: "required_kv_bytes derives from the workload intent over the group-aware resolved cache layout (extdeps.vllm.kv_layout), and the per-group metadata the layout prices is not vouched for by any emission this repository has read: the honest emission point is upstream vLLM's EngineCore.get_kv_cache_group_metadata (vllm/v1/engine/core.py at the pinned revision, modelled at extdeps.vllm.kv_group_metadata), which carries each group's kind, block size and window but NOT the layer counts and page bytes the layout needs -- that module's layout mint refuses construction from the emission alone, naming exactly the two absent fields, and no other authority this repository can cite vouches for them either. Until a capture vouches for them (a richer engine emission, or another cited authority beside the emission), every capture through gunbc.spark.vllm_kv_layout_observe lands KvLayoutUnreadable and this term stays open. Observed current_kv from a previous run is a readback and never a demand input" as NonEmptyStr },
    fragmentation_allowance: ComponentBoundOpen { obligation: open_demand_obligation(component: ArmFragmentationAllowance, receipt_kind: "AllocatorFragmentationBound" as NonEmptyStr) },
  }
}

// THE MINTS. The first builds the all-open subject the launch wall prices; the second admits
// rank records whose measured bounds name this exact identity. BOTH enforce the intent/profile
// join and the roster law; only the second takes measured rows, so an all-open subject with the
// right rank count but fabricated terms has no constructor at all.
fn arm_memory_fit_subject(
  checkpoint: ServingCheckpoint,
  runtime: ServingRuntime,
  topology: ServingTopology,
  intent: ServingCapacityIntent,
  requested_profile: ServingLaunchProfile,
  pool: ArmPoolBound,
  deductions: ArmSupplyDeductions,
) -> ArmMemorySubjectMint {
  if !profile_joins_intent(intent: intent, p: requested_profile) {
    ArmMemorySubjectRefused {
      cause: join([
        "the executable profile does not derive from the capacity intent: the engine would run max_model_len ", to_string(token_count_value(t: requested_profile.max_model_len)),
        " with ", to_string(requested_profile.max_num_seqs), " sequences and a ", to_string(token_count_value(t: requested_profile.max_num_batched_tokens)),
        "-token batch ceiling, which is not the intent's largest seat ", to_string(token_count_value(t: intent_max_single_sequence_tokens(i: intent))),
        " across ", to_string(intent_max_active_sequences(i: intent)), " seats with a ", to_string(token_count_value(t: intent.max_batched_tokens)),
        "-token batch ceiling. The proof and the engine config must be one value: derive the profile FROM the intent (gunbc.spark.serving_capacity_intent profile_for_intent), never price one workload beside another",
      ], "") as NonEmptyStr,
    }
  } else {
    match serving_checkpoint_row(c: checkpoint) {
      Absent => ArmMemorySubjectRefused { cause: "no checkpoint row: the checkpoint's bytes are unmodelled, so neither the aggregate nor any term derives" as NonEmptyStr }
      Present { value: crow } =>
        match checkpoint_total_span(crow_weight_gib: crow.weight_gib) {
          ArmComponentBoundRefused { cause: c } => ArmMemorySubjectRefused { cause: c }
          ArmComponentBoundReady { bound: b } =>
            match b {
              ComponentBoundInterval { lower: l, upper: u, how: _ } =>
                match closed_interval(low: l, high: u, le: measure_le) {
                  IntervalRefused { reason: r } => ArmMemorySubjectRefused { cause: r }
                  IntervalReady { interval: span } =>
                    ArmMemorySubjectReady { subject: ArmMemoryFitSubject {
                      checkpoint: checkpoint,
                      runtime: runtime,
                      topology: topology,
                      intent: intent,
                      profile: requested_profile,
                      ranks: map(nat_range_inclusive(lo: 1, hi: serving_topology_rank_count(t: topology)), i => open_rank_demand(rank: i - 1)),
                      checkpoint_total: span,
                      pool: pool,
                      deductions: deductions,
                    } }
                }
              _ => ArmMemorySubjectRefused { cause: "unreachable: checkpoint_total_span mints an interval or refuses" as NonEmptyStr }
            }
        }
    }
  }
}

fn arm_memory_fit_subject_with_rank_demands(
  checkpoint: ServingCheckpoint,
  runtime: ServingRuntime,
  topology: ServingTopology,
  intent: ServingCapacityIntent,
  requested_profile: ServingLaunchProfile,
  pool: ArmPoolBound,
  deductions: ArmSupplyDeductions,
  ranks: List<ArmRankDemand>,
) -> ArmMemorySubjectMint {
  let rank_count = serving_topology_rank_count(t: topology)
  if !profile_joins_intent(intent: intent, p: requested_profile) {
    ArmMemorySubjectRefused { cause: "the executable profile does not derive from the capacity intent (see arm_memory_fit_subject for the full cause shape): the join is enforced identically on every mint" as NonEmptyStr }
  } else if !rank_roster_valid(ranks: ranks, rank_count: rank_count) {
    ArmMemorySubjectRefused { cause: rank_roster_refusal(ranks: ranks, rank_count: rank_count) }
  } else if !roster_names_identity(ranks: ranks, ckpt: checkpoint, rt: runtime, tp: topology) {
    ArmMemorySubjectRefused { cause: "a measured bound's receipt or derivation does not name this checkpoint x runtime x topology: a receipt carried onto a changed checkpoint or runtime is evidence about a subject that is not this one, and is refused at the mint" as NonEmptyStr }
  } else {
    match serving_checkpoint_row(c: checkpoint) {
      Absent => ArmMemorySubjectRefused { cause: "no checkpoint row: the checkpoint's bytes are unmodelled, so neither the aggregate nor any term derives" as NonEmptyStr }
      Present { value: crow } =>
        match checkpoint_total_span(crow_weight_gib: crow.weight_gib) {
          ArmComponentBoundRefused { cause: c } => ArmMemorySubjectRefused { cause: c }
          ArmComponentBoundReady { bound: b } =>
            match b {
              ComponentBoundInterval { lower: l, upper: u, how: _ } =>
                match closed_interval(low: l, high: u, le: measure_le) {
                  IntervalRefused { reason: r } => ArmMemorySubjectRefused { cause: r }
                  IntervalReady { interval: span } =>
                    ArmMemorySubjectReady { subject: ArmMemoryFitSubject {
                      checkpoint: checkpoint,
                      runtime: runtime,
                      topology: topology,
                      intent: intent,
                      profile: requested_profile,
                      ranks: ranks,
                      checkpoint_total: span,
                      pool: pool,
                      deductions: deductions,
                    } }
                }
              _ => ArmMemorySubjectRefused { cause: "unreachable: checkpoint_total_span mints an interval or refuses" as NonEmptyStr }
            }
        }
    }
  }
}

// THE GB10 POOL AS THIS FLEET CURRENTLY READS IT: the rounded `free -g` figure carried by
// gunbc.spark.serving_arm, widened by its rounding unit. The obligation names the byte-exact
// producer (the engine prints the device total at every launch).
fn gb10_pool_bound() -> ArmPoolBound {
  let gib = gb10_unified_pool_gib
  let pool_lower = gibibyte_to_byte_size(g: gibibyte(count: gib))
  let pool_upper = byte_size(count: byte_size_count(b: gibibyte_to_byte_size(g: gibibyte(count: gib + 1))) - 1)
  match closed_interval(low: pool_lower, high: pool_upper, le: measure_le) {
    IntervalReady { interval: i } =>
      ArmPoolBounded {
        span: i,
        how: "gunbc.spark.serving_arm gb10_unified_pool_gib: a rounded `free -g` total read on one member on 2026-09-08; the true total lies within one rounding unit of the figure" as NonEmptyStr,
      }
    IntervalRefused { reason: r } =>
      ArmPoolUnbounded { obligation: join(["the rounded GB10 pool reading could not be turned into a span: ", r as String], "") as NonEmptyStr }
  }
}

// THE SUBJECT THE LAUNCH WALL PRICES: the profile's maximum admitted behavior as the intent
// (every admitted sequence at the full window, cold -- the largest workload the launch can be
// asked for, since no request-admission authority is modelled), the all-open rank roster, the
// rounded pool, both deductions open. Absent means unmodelled (no checkpoint row or no
// derivable intent), unreachable behind serving_arm_admits.
fn arm_memory_fit_subject_for_launch(
  checkpoint: ServingCheckpoint,
  runtime: ServingRuntime,
  topology: ServingTopology,
  profile: ServingLaunchProfile,
) -> ArmMemorySubjectMint {
  match intent_for_launch_profile(p: profile) {
    ServingCapacityIntentRefused { cause: c } => ArmMemorySubjectRefused { cause: c }
    ServingCapacityIntentAdmitted { intent: intent } =>
      arm_memory_fit_subject(
        checkpoint: checkpoint,
        runtime: runtime,
        topology: topology,
        intent: intent,
        requested_profile: profile,
        pool: gb10_pool_bound(),
        deductions: ArmSupplyDeductions {
          host_os_control_reserve: ComponentBoundOpen {
            obligation: "no measured upper bound exists for the host/OS/control-plane reserve of the unified pool; the GB10's pool is shared with the OS page cache, the control plane and any co-tenant consumers, and a host-class measurement would bound it" as NonEmptyStr,
          },
          foreign_residency: ComponentBoundOpen {
            obligation: "no inventory of protected non-arm residency exists for the serving hosts; the crash loop this proof exists to prevent was global pool pressure from consumers the admission did not count" as NonEmptyStr,
          },
        })
  }
}

// ── THE PER-PHASE DEMAND FOLD ────────────────────────────────────────────────────────────────────
//
// THE FOLD READS THE RECORD FIELDS BY NAME through the exhaustive accessor, so every component is
// charged in every phase query and none can disappear through a list projection. upper is ABSENT
// when any resident term is open; lower accumulates only what is defensible.
type ArmPhaseDemand {
  lower: ByteSize
  upper: ByteSize?
  open_components: List<ArmMemoryComponent>
  lower_components: List<ArmMemoryComponent>
}

fn demand_term_upper(bound: ArmComponentBound) -> ByteSize? {
  bound_upper_opt(b: bound)
}

fn demand_term_lower(bound: ArmComponentBound) -> ByteSize {
  bound_lower(b: bound)
}

fn demand_for_phase(rd: ArmRankDemand, phase: ArmMemoryFitPhase) -> ArmPhaseDemand {
  let resident_components = filter(arm_memory_components, c => component_resident_in_phase(c: c, p: phase))
  let lower = fold(resident_components, init: byte_size(count: 0), f: (acc, c) =>
    measure_add(a: acc, b: demand_term_lower(bound: rank_component_bound(rd: rd, c: c))))
  let lower_components = filter(resident_components, c => match rank_component_bound(rd: rd, c: c) {
    ComponentBoundExact { bytes: _, how: _ } => true
    ComponentBoundInterval { lower: _, upper: _, how: _ } => true
    ComponentBoundCeiling { bytes: _, receipt: _ } => false
    ComponentBoundOpen { obligation: _ } => false
  })
  let open_components = filter(resident_components, c => bound_is_open(b: rank_component_bound(rd: rd, c: c)))
  let upper = fold(resident_components, init: Present { value: byte_size(count: 0) }, f: (acc, c) =>
    match acc {
      Absent => none
      Present { value: n } =>
        match demand_term_upper(bound: rank_component_bound(rd: rd, c: c)) {
          Absent => none
          Present { value: b } => Present { value: measure_add(a: n, b: b) }
        }
    })
  ArmPhaseDemand { lower: lower, upper: upper, open_components: open_components, lower_components: lower_components }
}

// ── THE SUPPLY FOLDS ─────────────────────────────────────────────────────────────────────────────
//
// UPPER IS THE FAVORABLE READING, LOWER THE CONSERVATIVE ONE, and EITHER MAY BE UNKNOWN. The
// favorable reading (refusal test) takes the pool at its upper endpoint and deductions at their
// lowers; the conservative reading (proof test) takes the pool at its lower endpoint and the
// deductions at their uppers. An UNMODELED pool makes BOTH unknown -- and unknown supply refuses
// nothing, because "not modeled" is not "impossible".
fn deduction_list(d: ArmSupplyDeductions) -> List<ArmComponentBound> {
  [d.host_os_control_reserve, d.foreign_residency]
}

fn sum_deduction_lowers(deductions: ArmSupplyDeductions) -> ByteSize {
  fold(deduction_list(d: deductions), init: byte_size(count: 0), f: (acc, b) => measure_add(a: acc, b: bound_lower(b: b)))
}

fn sum_deduction_uppers(deductions: ArmSupplyDeductions) -> ByteSize? {
  fold(deduction_list(d: deductions), init: Present { value: byte_size(count: 0) }, f: (acc, b) =>
    match acc {
      Absent => none
      Present { value: n } =>
        match bound_upper_opt(b: b) {
          Absent => none
          Present { value: c } => Present { value: measure_add(a: n, b: c) }
        }
    })
}

fn subtract_saturating(minuend: ByteSize, subtrahend: ByteSize) -> ByteSize {
  if measure_le(a: subtrahend, b: minuend) {
    byte_size(count: byte_size_count(b: minuend) - byte_size_count(b: subtrahend))
  } else {
    byte_size(count: 0)
  }
}

fn supply_upper_opt(pool: ArmPoolBound, deductions: ArmSupplyDeductions) -> ByteSize? {
  match pool {
    ArmPoolBounded { span: s, how: _ } =>
      Present { value: subtract_saturating(minuend: interval_high(interval: s), subtrahend: sum_deduction_lowers(deductions: deductions)) }
    ArmPoolUnbounded { obligation: _ } => none
  }
}

fn supply_lower_opt(pool: ArmPoolBound, deductions: ArmSupplyDeductions) -> ByteSize? {
  match pool {
    ArmPoolUnbounded { obligation: _ } => none
    ArmPoolBounded { span: s, how: _ } =>
      match sum_deduction_uppers(deductions: deductions) {
        Absent => none
        Present { value: uppers } =>
          Present { value: subtract_saturating(minuend: interval_low(interval: s), subtrahend: uppers) }
      }
  }
}

// ── THE DECIDED ENVELOPE ─────────────────────────────────────────────────────────────────────────
//
// DERIVED FROM THE POOL SPAN, never stored beside it
// (extdeps.vllm.runtime_defaults vllm_requested_envelope_bytes owns the arithmetic). Unknown when
// the pool is unmodeled, and then it constrains nothing.
type ArmEnvelopeSpan {
  lower: ByteSize
  upper: ByteSize
}

fn decided_envelope_span(profile: ServingLaunchProfile, pool: ArmPoolBound) -> ArmEnvelopeSpan? {
  match pool {
    ArmPoolUnbounded { obligation: _ } => none
    ArmPoolBounded { span: s, how: _ } =>
      Present { value: ArmEnvelopeSpan {
        lower: vllm_requested_envelope_bytes(device_total: interval_low(interval: s), utilization: profile.decided_gpu_memory_basis_points),
        upper: vllm_requested_envelope_bytes(device_total: interval_high(interval: s), utilization: profile.decided_gpu_memory_basis_points),
      } }
  }
}

// ── THE VERDICT ──────────────────────────────────────────────────────────────────────────────────
//
// THE THREE ARMS. Proved carries the WORST rank and phase; Refused carries the rank, phase and
// both numbers with the cause naming the carrying terms; Unestablished carries the obligations.
type ArmMemoryFitVerdict
  = ArmMemoryFitProved { rank: Nat, phase: ArmMemoryFitPhase, headroom_bytes: ByteSize }
  | ArmMemoryFitRefused {
      rank: Nat,
      phase: ArmMemoryFitPhase,
      demand_lower: ByteSize,
      supply_upper: ByteSize,
      cause: NonEmptyStr,
    }
  | ArmMemoryFitUnestablished { obligations: List<NonEmptyStr> }

// THE AGGREGATE IMPOSSIBILITY ARGUMENT, carried separately from the per-rank scan so the proof
// never fabricates WHICH rank. Pigeonhole: some rank must hold at least
// ceil(checkpoint_total_lower / rank_count); if that minimum-possible maximum exceeds the most
// favorable supply, the shape is impossible no matter how the placement falls out. The refusal's
// rank field carries the rank COUNT, which is not a valid rank index -- the sentinel for "at
// least one rank, unnamed".
fn aggregate_checkpoint_refusal(subject: ArmMemoryFitSubject, supply_up: ByteSize?) -> ArmMemoryFitVerdict? {
  match supply_up {
    Absent => none
    Present { value: s } => {
      let rank_count = serving_topology_rank_count(t: subject.topology)
      let total_lower = interval_low(interval: subject.checkpoint_total)
      let pigeonhole_lower = byte_size(count: (byte_size_count(b: total_lower) + rank_count - 1) / rank_count)
      match byte_size_count(b: pigeonhole_lower) > byte_size_count(b: s) {
        true =>
          Present { value: ArmMemoryFitRefused {
            rank: rank_count,
            phase: ArmPhaseModelLoad,
            demand_lower: pigeonhole_lower,
            supply_upper: s,
            cause: join([
              "memory fit REFUSED before any per-rank reading: at least one rank must hold at least ",
              to_string(byte_size_count(b: pigeonhole_lower)),
              " bytes of this checkpoint (", to_string(byte_size_count(b: total_lower)),
              " bytes total across ", to_string(rank_count),
              " ranks, by pigeonhole), which exceeds the most favorable supply of ",
              to_string(byte_size_count(b: s)),
              " bytes even with every unbounded term priced at zero. No rank is named because placement is unread; the argument holds for EVERY placement",
            ], "") as NonEmptyStr,
          } }
        false => none
      }
    }
  }
}

// THE RANK-SUM CONSERVATION LAW: measured per-rank upper bounds must be able to hold the
// checkpoint aggregate between them. A roster whose ceiling receipts sum to less than the
// checkpoint's total bytes claims ranks that cannot hold the checkpoint however the receipts were
// minted -- a conservation violation, carried as an obligation when it does not itself refuse.
fn checkpoint_rank_sum(subject: ArmMemoryFitSubject) -> ByteSize? {
  fold(subject.ranks, init: Present { value: byte_size(count: 0) }, f: (acc, r) =>
    match acc {
      Absent => none
      Present { value: n } =>
        match bound_upper_opt(b: r.checkpoint_residency) {
          Absent => none
          Present { value: c } => Present { value: measure_add(a: n, b: c) }
        }
    })
}

fn checkpoint_sum_obligation(subject: ArmMemoryFitSubject) -> List<NonEmptyStr> {
  match checkpoint_rank_sum(subject: subject) {
    Absent => [] as List<NonEmptyStr>
    Present { value: sum } =>
      match measure_le(a: interval_high(interval: subject.checkpoint_total), b: sum) {
        true => [] as List<NonEmptyStr>
        false =>
          [join([
            "the per-rank checkpoint upper bounds sum to ", to_string(byte_size_count(b: sum)),
            " bytes, less than the checkpoint aggregate's upper endpoint of ", to_string(byte_size_count(b: interval_high(interval: subject.checkpoint_total))),
            " bytes: these ranks cannot hold the checkpoint between them, so the measured bounds and the checkpoint row do not describe one arm",
          ], "") as NonEmptyStr]
      }
  }
}

// A REFUSAL IS FOUND BEFORE ANYTHING ELSE, because it is the one verdict open terms cannot
// block. The pool wall and the envelope wall are checked independently; EITHER deciding against
// the mandatory demand refuses, and unknown supply skips its wall rather than reading absence as
// zero.
fn refusal_for_rank(
  rd: ArmRankDemand,
  supply_up: ByteSize?,
  envelope_up: ByteSize?,
  decided_bp: Nat,
) -> ArmMemoryFitVerdict? {
  fold(arm_memory_fit_phases, init: Absent, f: fn(acc, phase) {
    match acc {
      Present { value: _ } => acc
      Absent => {
        let demand = demand_for_phase(rd: rd, phase: phase)
        let pool_refusal = match supply_up {
          Absent => none
          Present { value: s } =>
            match byte_size_count(b: demand.lower) > byte_size_count(b: s) {
              true =>
                Present { value: ArmMemoryFitRefused {
                  rank: rd.rank,
                  phase: phase,
                  demand_lower: demand.lower,
                  supply_upper: s,
                  cause: join([
                    "memory fit REFUSED at rank ", to_string(rd.rank), " phase ", arm_memory_fit_phase_wire(p: phase),
                    ": the mandatory demand lower bound of ", to_string(byte_size_count(b: demand.lower)),
                    " bytes (carried by ", join(map(demand.lower_components, c => arm_memory_component_wire(c: c)), ", "),
                    ") exceeds the most favorable supply of ", to_string(byte_size_count(b: s)),
                    " bytes even before the unbounded terms are priced",
                  ], "") as NonEmptyStr,
                } }
              false => none
            }
        }
        match pool_refusal {
          Present { value: _ } => pool_refusal
          Absent =>
            match envelope_constrains_phase(p: phase) {
              false => none
              true =>
                match envelope_up {
                  Absent => none
                  Present { value: e } =>
                    match byte_size_count(b: demand.lower) > byte_size_count(b: e) {
                      true =>
                        Present { value: ArmMemoryFitRefused {
                          rank: rd.rank,
                          phase: phase,
                          demand_lower: demand.lower,
                          supply_upper: e,
                          cause: join([
                            "memory fit REFUSED at rank ", to_string(rd.rank), " phase ", arm_memory_fit_phase_wire(p: phase),
                            ": the mandatory demand lower bound of ", to_string(byte_size_count(b: demand.lower)),
                            " bytes exceeds the decided envelope's most generous reading of ", to_string(byte_size_count(b: e)),
                            " bytes (pool upper at ", to_string(decided_bp),
                            " basis points); the engine aborts when its own accounting passes the envelope, so the launch would not start",
                          ], "") as NonEmptyStr,
                        } }
                      false => none
                    }
                }
            }
        }
      }
    }
  })
}

fn refusal_scan(subject: ArmMemoryFitSubject, supply_up: ByteSize?, envelope_up: ByteSize?) -> ArmMemoryFitVerdict? {
  fold(subject.ranks, init: Absent, f: fn(acc, rb) {
    match acc {
      Present { value: _ } => acc
      Absent => refusal_for_rank(
        rd: rb,
        supply_up: supply_up,
        envelope_up: envelope_up,
        decided_bp: basis_point_count(bp: subject.profile.decided_gpu_memory_basis_points))
    }
  })
}

// CONSERVATION REFUSED IS THE SECOND REFUSAL: the decided envelope at its most generous reading
// plus the deductions at their least cannot fit the pool at its most generous reading.
fn conservation_refusal(subject: ArmMemoryFitSubject, envelope: ArmEnvelopeSpan?) -> ArmMemoryFitVerdict? {
  match subject.pool {
    ArmPoolUnbounded { obligation: _ } => none
    ArmPoolBounded { span: s, how: _ } =>
      match envelope {
        Absent => none
        Present { value: env } => {
          let mandatory = measure_add(a: env.upper, b: sum_deduction_lowers(deductions: subject.deductions))
          match byte_size_count(b: mandatory) > byte_size_count(b: interval_high(interval: s)) {
            true =>
              Present { value: ArmMemoryFitRefused {
                rank: 0,
                phase: ArmPhaseModelLoad,
                demand_lower: mandatory,
                supply_upper: interval_high(interval: s),
                cause: join([
                  "memory fit REFUSED at rank 0 phase ", arm_memory_fit_phase_wire(p: ArmPhaseModelLoad),
                  ": the decided envelope at its most generous reading (", to_string(byte_size_count(b: env.upper)),
                  " bytes) plus the mandatory foreign residency lower bounds exceeds the pool at its most generous reading (",
                  to_string(byte_size_count(b: interval_high(interval: s))),
                  " bytes): unified-pool conservation fails at every device size the rounded reading permits",
                ], "") as NonEmptyStr,
              } }
            false => none
          }
        }
      }
  }
}

// OPEN TERMS ARE NAMED, ONE OBLIGATION EACH, at the rank and component that carry them.
fn open_term_obligations(subject: ArmMemoryFitSubject) -> List<NonEmptyStr> {
  concat(
    flat_map(subject.ranks, rb =>
      flat_map(arm_memory_components, c =>
        match rank_component_bound(rd: rb, c: c) {
          ComponentBoundOpen { obligation: o } =>
            [join([
              "rank ", to_string(rb.rank), " ", arm_memory_component_wire(c: c),
              " has no defensible bound: ", o as String,
            ], "") as NonEmptyStr]
          ComponentBoundExact { bytes: _, how: _ } => [] as List<NonEmptyStr>
          ComponentBoundInterval { lower: _, upper: _, how: _ } => [] as List<NonEmptyStr>
          ComponentBoundCeiling { bytes: _, receipt: _ } => [] as List<NonEmptyStr>
        })),
    concat(
      match subject.deductions.host_os_control_reserve {
        ComponentBoundOpen { obligation: o } =>
          [join(["the supply deduction host-os-control-reserve has no defensible upper bound: ", o as String], "") as NonEmptyStr]
        ComponentBoundExact { bytes: _, how: _ } => [] as List<NonEmptyStr>
        ComponentBoundInterval { lower: _, upper: _, how: _ } => [] as List<NonEmptyStr>
        ComponentBoundCeiling { bytes: _, receipt: _ } => [] as List<NonEmptyStr>
      },
      match subject.deductions.foreign_residency {
        ComponentBoundOpen { obligation: o } =>
          [join(["the supply deduction foreign-residency has no defensible upper bound: ", o as String], "") as NonEmptyStr]
        ComponentBoundExact { bytes: _, how: _ } => [] as List<NonEmptyStr>
        ComponentBoundInterval { lower: _, upper: _, how: _ } => [] as List<NonEmptyStr>
        ComponentBoundCeiling { bytes: _, receipt: _ } => [] as List<NonEmptyStr>
      }))
}

// INDETERMINATE COMPARISONS ARE NAMED AS OBLIGATIONS TOO, with the conservation law for the
// checkpoint aggregate folded in.
fn ceiling_terms_resident_in_phase(rd: ArmRankDemand, phase: ArmMemoryFitPhase) -> List<ArmMemoryComponent> {
  filter(filter(arm_memory_components, c => component_resident_in_phase(c: c, p: phase)), c =>
    match rank_component_bound(rd: rd, c: c) {
      ComponentBoundCeiling { bytes: _, receipt: _ } => true
      ComponentBoundExact { bytes: _, how: _ } => false
      ComponentBoundInterval { lower: _, upper: _, how: _ } => false
      ComponentBoundOpen { obligation: _ } => false
    })
}

fn indeterminacy_obligations(
  subject: ArmMemoryFitSubject,
  supply_low: ByteSize?,
  envelope: ArmEnvelopeSpan?,
) -> List<NonEmptyStr> {
  let demand_obligations = flat_map(subject.ranks, rb =>
    flat_map(map(arm_memory_fit_phases, phase => {
      let demand = demand_for_phase(rd: rb, phase: phase)
      match demand.upper {
        Absent => [] as List<NonEmptyStr>
        Present { value: upper } => {
          let supply_excess = match supply_low {
            Absent => [] as List<NonEmptyStr>
            Present { value: low } =>
              match byte_size_count(b: upper) > byte_size_count(b: low) {
                true =>
                  [join([
                    "rank ", to_string(rb.rank), " phase ", arm_memory_fit_phase_wire(p: phase),
                    " does not decide: demand upper ", to_string(byte_size_count(b: upper)),
                    " bytes exceeds the conservative supply lower ", to_string(byte_size_count(b: low)),
                    " bytes; tighten ", join(map(ceiling_terms_resident_in_phase(rd: rb, phase: phase), c => arm_memory_component_wire(c: c)), ", "),
                    " or bound the supply deductions tighter",
                  ], "") as NonEmptyStr]
                false => [] as List<NonEmptyStr>
              }
          }
          let envelope_excess = match envelope {
            Absent => [] as List<NonEmptyStr>
            Present { value: env } =>
              match envelope_constrains_phase(p: phase) {
                false => [] as List<NonEmptyStr>
                true =>
                  match byte_size_count(b: upper) > byte_size_count(b: env.lower) {
                    true =>
                      [join([
                        "rank ", to_string(rb.rank), " phase ", arm_memory_fit_phase_wire(p: phase),
                        " does not decide against the decided envelope: demand upper ", to_string(byte_size_count(b: upper)),
                        " bytes exceeds the envelope at the pool's lower reading (", to_string(byte_size_count(b: env.lower)),
                        " bytes at ", to_string(basis_point_count(bp: subject.profile.decided_gpu_memory_basis_points)),
                        " basis points); a larger utilization decision or a byte-exact pool reading would settle it",
                      ], "") as NonEmptyStr]
                    false => [] as List<NonEmptyStr>
                  }
              }
          }
          concat(supply_excess, envelope_excess)
        }
      }
    }), xs => xs))
  let conservation_obligations = match subject.pool {
    ArmPoolUnbounded { obligation: _ } => [] as List<NonEmptyStr>
    ArmPoolBounded { span: s, how: _ } =>
      match envelope {
        Absent => [] as List<NonEmptyStr>
        Present { value: env } =>
          match sum_deduction_uppers(deductions: subject.deductions) {
            Absent => [] as List<NonEmptyStr>
            Present { value: uppers } => {
              let conservation_low = measure_add(a: env.lower, b: uppers)
              match byte_size_count(b: conservation_low) > byte_size_count(b: interval_low(interval: s)) {
                true =>
                  [join([
                    "unified-pool conservation does not decide: the decided envelope at the pool's lower reading (",
                    to_string(byte_size_count(b: env.lower)), " bytes) plus the bounded foreign residency uppers exceeds the pool's lower reading (",
                    to_string(byte_size_count(b: interval_low(interval: s))),
                    " bytes); the byte-exact pool producer decides whether the device this lands on is large enough",
                  ], "") as NonEmptyStr]
                false => [] as List<NonEmptyStr>
              }
            }
          }
      }
  }
  concat(demand_obligations, conservation_obligations)
}

// THE BINDING CEILING FOR ONE PHASE: the conservative supply everywhere, and the tighter of
// supply and decided envelope on the engine-admitted phases.
fn phase_binding(supply_low: ByteSize, envelope_lower: ByteSize, phase: ArmMemoryFitPhase) -> ByteSize {
  match envelope_constrains_phase(p: phase) {
    false => supply_low
    true =>
      match byte_size_count(b: supply_low) < byte_size_count(b: envelope_lower) {
        true => supply_low
        false => envelope_lower
      }
  }
}

fn proved_worst_corner(subject: ArmMemoryFitSubject, supply_low: ByteSize, envelope_lower: ByteSize) -> ArmMemoryFitVerdict? {
  fold(subject.ranks, init: Absent, f: fn(acc, rb) {
    fold(arm_memory_fit_phases, init: acc, f: fn(acc2, phase) {
      match acc2 {
        Present { value: prior } =>
          match prior {
            ArmMemoryFitProved { rank: _, phase: _, headroom_bytes: h } => {
              let demand = demand_for_phase(rd: rb, phase: phase)
              match demand.upper {
                Absent => acc2
                Present { value: upper } => {
                  let headroom = subtract_saturating(minuend: phase_binding(supply_low: supply_low, envelope_lower: envelope_lower, phase: phase), subtrahend: upper)
                  match byte_size_count(b: headroom) < byte_size_count(b: h) {
                    true => Present { value: ArmMemoryFitProved { rank: rb.rank, phase: phase, headroom_bytes: headroom } }
                    false => acc2
                  }
                }
              }
            }
            ArmMemoryFitRefused { rank: _, phase: _, demand_lower: _, supply_upper: _, cause: _ } => acc2
            ArmMemoryFitUnestablished { obligations: _ } => acc2
          }
        Absent => {
          let demand = demand_for_phase(rd: rb, phase: phase)
          match demand.upper {
            Absent => none
            Present { value: upper } =>
              Present { value: ArmMemoryFitProved {
                rank: rb.rank,
                phase: phase,
                headroom_bytes: subtract_saturating(minuend: phase_binding(supply_low: supply_low, envelope_lower: envelope_lower, phase: phase), subtrahend: upper),
              } }
          }
        }
      }
    })
  })
}

// ── THE VERDICT FOLD ─────────────────────────────────────────────────────────────────────────────
//
// THE ORDER IS THE SEMANTICS. (1) the aggregate impossibility argument, which never names a rank;
// (2) the per-rank refusal scan; (3) the conservation refusal; (4) the obligation pass -- open
// terms, the pool obligation when the pool is unmodeled, indeterminate comparisons, the rank-sum
// conservation law -- whose EMPTINESS is the definition of "every bound is defensible and
// decides"; (5) Proved, with the worst corner. Unknown supply and unknown envelope skip their
// walls: an unmodeled pool is an obligation, not a refusal.
fn arm_memory_fit_verdict(subject: ArmMemoryFitSubject) -> ArmMemoryFitVerdict {
  if !rank_roster_valid(ranks: subject.ranks, rank_count: serving_topology_rank_count(t: subject.topology)) {
    ArmMemoryFitUnestablished { obligations: [rank_roster_refusal(ranks: subject.ranks, rank_count: serving_topology_rank_count(t: subject.topology))] }
  } else {
    let supply_up = supply_upper_opt(pool: subject.pool, deductions: subject.deductions)
    let envelope = decided_envelope_span(profile: subject.profile, pool: subject.pool)
    let envelope_up = match envelope {
      Absent => none
      Present { value: e } => Present { value: e.upper }
    }
    match aggregate_checkpoint_refusal(subject: subject, supply_up: supply_up) {
      Present { value: v } => v
      Absent =>
        match refusal_scan(subject: subject, supply_up: supply_up, envelope_up: envelope_up) {
          Present { value: v } => v
          Absent =>
            match conservation_refusal(subject: subject, envelope: envelope) {
              Present { value: v } => v
              Absent => {
                let supply_low = supply_lower_opt(pool: subject.pool, deductions: subject.deductions)
                let pool_obligations = match subject.pool {
                  ArmPoolUnbounded { obligation: o } => [o]
                  ArmPoolBounded { span: _, how: _ } => [] as List<NonEmptyStr>
                }
                let obligations = concat(
                  open_term_obligations(subject: subject),
                  concat(
                    pool_obligations,
                    concat(
                      indeterminacy_obligations(subject: subject, supply_low: supply_low, envelope: envelope),
                      checkpoint_sum_obligation(subject: subject))))
                match length(obligations) > 0 {
                  true => ArmMemoryFitUnestablished { obligations: obligations }
                  false =>
                    match supply_low {
                      Absent =>
                        ArmMemoryFitUnestablished { obligations: ["unreachable: an empty obligation pass implies the conservative supply computed" as NonEmptyStr] }
                      Present { value: low } =>
                        match envelope {
                          Absent =>
                            ArmMemoryFitUnestablished { obligations: ["unreachable: an empty obligation pass implies the decided envelope computed" as NonEmptyStr] }
                          Present { value: env } =>
                            match proved_worst_corner(subject: subject, supply_low: low, envelope_lower: env.lower) {
                              Present { value: v } => v
                              Absent =>
                                ArmMemoryFitUnestablished { obligations: ["unreachable: a subject with ranks has at least one rank-phase pair" as NonEmptyStr] }
                            }
                        }
                    }
                }
              }
            }
        }
    }
  }
}

// THE TYPED OPEN-COMPONENT LISTING the experiment plan consumes: a component is open when ANY
// rank carries it open, read through the same exhaustive accessor the folds use.
fn arm_memory_subject_open_components(subject: ArmMemoryFitSubject) -> List<ArmMemoryComponent> {
  filter(arm_memory_components, c => any(subject.ranks, r => bound_is_open(b: rank_component_bound(rd: r, c: c))))
}

// ── THE MEASUREMENT CONTRACT ─────────────────────────────────────────────────────────────────────
//
// A MEASUREMENT IS NOT A BOUND. The review finding this closes: promoting one observed sample
// into a ceiling made "the process once used N bytes" into "the process will never exceed N
// bytes", which nothing about one sample establishes. THE CLASSIFICATION NAMES WHAT THE
// OBSERVATION ESTABLISHES: only MeasuredUpperBound and MeasuredInterval discharge an open
// obligation, and only when the measurement names the exact subject axes -- component, rank,
// phase, workload, lifetime -- and its protocol is a bounding protocol. A single sample is
// ObservationOnly; a measurement for a phase where the component is not resident, or for an
// empty workload, or that does not cover the serving lifetime it would bound, refuses.
type ArmMeasurementProtocol
  = ProtocolPeakOverRuns { runs: Nat }
  | ProtocolEngineReportedMaximum
  | ProtocolSingleSample

type ArmMeasurement {
  component: ArmMemoryComponent
  rank: Nat
  phase: ArmMemoryFitPhase
  workload: TokenCount
  covers_lifetime: Bool
  protocol: ArmMeasurementProtocol
  observed: ByteSize
  receipt: NonEmptyStr
}

type ArmMeasurementClass
  = MeasuredUpperBound { measurement: ArmMeasurement }
  | MeasuredInterval { lower: ByteSize, upper: ByteSize, measurement: ArmMeasurement }
  | ObservationOnly { measurement: ArmMeasurement, why: NonEmptyStr }
  | MeasurementRefused { cause: NonEmptyStr }

fn arm_classify_measurement(m: ArmMeasurement) -> ArmMeasurementClass {
  if !component_resident_in_phase(c: m.component, p: m.phase) {
    MeasurementRefused {
      cause: join([
        "the measurement names phase ", arm_memory_fit_phase_wire(p: m.phase),
        ", in which ", arm_memory_component_wire(c: m.component), " is not resident: an observation of an absent mechanism bounds nothing",
      ], "") as NonEmptyStr,
    }
  } else if token_count_value(t: m.workload) == 0 {
    MeasurementRefused { cause: "the measurement names an empty workload, so it establishes nothing about any admitted request" as NonEmptyStr }
  } else if !m.covers_lifetime {
    ObservationOnly {
      measurement: m,
      why: "the observation does not cover the lifetime it would bound: a point reading inside one run says nothing about peaks across the process's life" as NonEmptyStr,
    }
  } else {
    match m.protocol {
      ProtocolSingleSample =>
        ObservationOnly {
          measurement: m,
          why: "a single sample bounds nothing above: an upper bound needs a peak-over-runs protocol or the engine's own reported maximum" as NonEmptyStr,
        }
      ProtocolPeakOverRuns { runs: n } =>
        match n == 0 {
          true => MeasurementRefused { cause: "a peak over zero runs is not a protocol" as NonEmptyStr }
          false => MeasuredUpperBound { measurement: m }
        }
      ProtocolEngineReportedMaximum => MeasuredUpperBound { measurement: m }
    }
  }
}

// DISCHARGE IS THE ONLY ROUTE FROM OBSERVATION TO BOUND. ObservationOnly and MeasurementRefused
// return the current bound UNCHANGED -- an observation that does not establish a bound changes no
// bound, which is the whole point of the contract.
fn arm_apply_measurement(current: ArmComponentBound, class: ArmMeasurementClass) -> ArmComponentBound {
  match class {
    MeasuredUpperBound { measurement: m } => ComponentBoundCeiling { bytes: m.observed, receipt: m.receipt }
    MeasuredInterval { lower: l, upper: u, measurement: m } =>
      match component_bound_interval(lower: l, upper: u, how: join(["measured interval, receipt ", m.receipt as String], "") as NonEmptyStr) {
        ArmComponentBoundReady { bound: b } => b
        ArmComponentBoundRefused { cause: _ } => current
      }
    ObservationOnly { measurement: _, why: _ } => current
    MeasurementRefused { cause: _ } => current
  }
}

// READBACK AGAINST AN EXISTING PREDICTION. An observation OUTSIDE a predicted interval falsifies
// the model; INSIDE it is consistent -- a derived pair is a range claim, and the world landing
// within the range is the range being right, not the world being wrong. Against an Exact figure
// the observation must equal it; against a ceiling it must not exceed it; against an open term
// there is no prediction, so anything observed is consistent (and the measurement contract, not
// this fold, decides whether it may discharge).
type ArmObservationVerdict
  = ArmObservationConsistent { component: ArmMemoryComponent, predicted_bound: ArmComponentBound, observed: ByteSize, receipt: NonEmptyStr }
  | ArmMemoryModelFalsified { component: ArmMemoryComponent, predicted_bound: ArmComponentBound, observed: ByteSize, receipt: NonEmptyStr }

fn arm_readback_observation(component: ArmMemoryComponent, predicted: ArmComponentBound, observed: ByteSize, receipt: NonEmptyStr) -> ArmObservationVerdict {
  match predicted {
    ComponentBoundExact { bytes: b, how: _ } =>
      match byte_size_count(b: observed) == byte_size_count(b: b) {
        true => ArmObservationConsistent { component: component, predicted_bound: predicted, observed: observed, receipt: receipt }
        false => ArmMemoryModelFalsified { component: component, predicted_bound: predicted, observed: observed, receipt: receipt }
      }
    ComponentBoundInterval { lower: l, upper: u, how: _ } =>
      match measure_le(a: l, b: observed) && measure_le(a: observed, b: u) {
        true => ArmObservationConsistent { component: component, predicted_bound: predicted, observed: observed, receipt: receipt }
        false => ArmMemoryModelFalsified { component: component, predicted_bound: predicted, observed: observed, receipt: receipt }
      }
    ComponentBoundCeiling { bytes: b, receipt: _ } =>
      match measure_le(a: observed, b: b) {
        true => ArmObservationConsistent { component: component, predicted_bound: predicted, observed: observed, receipt: receipt }
        false => ArmMemoryModelFalsified { component: component, predicted_bound: predicted, observed: observed, receipt: receipt }
      }
    ComponentBoundOpen { obligation: _ } =>
      ArmObservationConsistent { component: component, predicted_bound: predicted, observed: observed, receipt: receipt }
  }
}

// ── THE EXPERIMENT CONTRACT ──────────────────────────────────────────────────────────────────────
//
// FitRefused refuses the experiment too -- a known-impossible shape measures nothing a service
// could use. FitUnestablished admits an experiment ONLY through a typed plan, and the plan is the
// smallest configuration that measures the named unknowns: the workload is the subject's own
// (the engine config priced and the engine config run are one, by the join), the envelope is no
// larger than the normal-serving decision, the runtime is finite, the receipts the run must mint
// are named, and the stop/cleanup contract plus the route-enrollment prohibition are carried as
// typed fields the realization renders.
type ArmAllRanksStopped
  = ArmEveryRankStopped { witness: NonEmptyStr }

type ArmRouteEnrollmentProhibited
  = ArmNoRouteEnrollment { witness: NonEmptyStr }

type ArmExperimentStopContract {
  timeout_preserves: NonEmptyStr
  cleanup: NonEmptyStr
  stops_every_rank: ArmAllRanksStopped
  route_enrollment: ArmRouteEnrollmentProhibited
}

type ArmMemoryExperimentPlan {
  checkpoint: ServingCheckpoint
  runtime: ServingRuntime
  topology: ServingTopology
  workload: ServingCapacityIntent
  profile: ServingLaunchProfile
  targets: List<ArmMemoryComponent>
  envelope_basis_points: BasisPoint
  max_runtime_seconds: Nat
  expected_receipts: List<NonEmptyStr>
  stop: ArmExperimentStopContract
}

type ArmMemoryExperimentAdmission
  = ArmMemoryExperimentAdmitted { plan: ArmMemoryExperimentPlan }
  | ArmMemoryExperimentRefused { cause: NonEmptyStr }

// THE ADMITTED MAXIMUM RUNTIME for one experiment rank unit. Bounded by the engine's own
// multi-node ready timeout: an engine that has not finished starting (including its profiling
// pass, where the memory terms this experiment exists to measure are minted) within the window
// its own base environment prescribes is not a slow measurement but a failed start.
fn arm_memory_experiment_runtime_seconds() -> Nat {
  glm_5_3_flash_vllm_engine_ready_timeout_seconds
}

fn experiment_receipt_kind(component: ArmMemoryComponent) -> NonEmptyStr {
  match component {
    ArmCheckpointResidency => "CheckpointRankResidencyBound" as NonEmptyStr
    ArmLoaderTransform => "CheckpointRankResidencyBound" as NonEmptyStr
    ArmRuntimeFixed => "RuntimeFixedAllocationBound" as NonEmptyStr
    ArmCollectiveWorkspace => "CollectiveWorkspaceBound" as NonEmptyStr
    ArmActivationWorkspace => "ActivationWorkspaceBound" as NonEmptyStr
    ArmGraphCapture => "GraphCaptureBound" as NonEmptyStr
    ArmKvCache => "KvLayoutReceipt" as NonEmptyStr
    ArmFragmentationAllowance => "AllocatorFragmentationBound" as NonEmptyStr
  }
}

// THE PLAN MINT. The workload joins the requested profile's policy fields into the derived
// executable (same join as the subject); targets must be open in the subject these identities
// mint -- an experiment targeting an already-bounded component measures nothing unknown; the
// envelope must not exceed the normal-serving decision -- conservative means no larger.
fn arm_memory_fit_experiment_plan(
  checkpoint: ServingCheckpoint,
  runtime: ServingRuntime,
  topology: ServingTopology,
  workload: ServingCapacityIntent,
  policy_profile: ServingLaunchProfile,
  targets: List<ArmMemoryComponent>,
) -> ArmMemoryExperimentAdmission {
  if !profile_joins_intent(intent: workload, p: policy_profile) {
    ArmMemoryExperimentRefused {
      cause: "the experiment's workload and its policy profile do not join: the experiment would run an engine config other than the one its plan prices" as NonEmptyStr,
    }
  } else if length(targets) == 0 {
    ArmMemoryExperimentRefused { cause: "the experiment names no open obligations as targets: an experiment exists to measure the unknown, and a plan with nothing to measure is a service wearing an experiment's name" as NonEmptyStr }
  } else {
    match arm_memory_fit_subject_for_launch(checkpoint: checkpoint, runtime: runtime, topology: topology, profile: policy_profile) {
      ArmMemorySubjectRefused { cause: c } => ArmMemoryExperimentRefused { cause: c }
      ArmMemorySubjectReady { subject: subject } => {
        let open_components = arm_memory_subject_open_components(subject: subject)
        let not_open = filter(targets, t => !any(open_components, o => o == t))
        match length(not_open) > 0 {
          true =>
            ArmMemoryExperimentRefused {
              cause: join([
                "the experiment targets ", join(map(not_open, c => arm_memory_component_wire(c: c)), ", "),
                ", which is not open for this subject: measuring an already-bounded component establishes nothing, and targeting it means the plan was written against a different arm",
              ], "") as NonEmptyStr,
            }
          false =>
            ArmMemoryExperimentAdmitted { plan: ArmMemoryExperimentPlan {
              checkpoint: checkpoint,
              runtime: runtime,
              topology: topology,
              workload: workload,
              profile: policy_profile,
              targets: targets,
              envelope_basis_points: policy_profile.decided_gpu_memory_basis_points,
              max_runtime_seconds: arm_memory_experiment_runtime_seconds(),
              expected_receipts: map(targets, t => experiment_receipt_kind(t)),
              stop: ArmExperimentStopContract {
                timeout_preserves: "on runtime expiry the engine container is stopped and the observer preserves the per-rank logs and records an unminted-receipt disposition against every expected receipt: a measurement that outlived its window establishes nothing" as NonEmptyStr,
                cleanup: "docker rm -f the experiment container after stop, on every rank, so a timed-out experiment leaves no engine holding pool bytes" as NonEmptyStr,
                stops_every_rank: ArmEveryRankStopped { witness: "every rank unit of the experiment carries the same admitted runtime bound" as NonEmptyStr },
                route_enrollment: ArmNoRouteEnrollment { witness: "the experiment unit renders no [Install] section, so no target enrolls the route" as NonEmptyStr },
              },
            } }
        }
      }
    }
  }
}

// ── THE LAUNCH GATE ──────────────────────────────────────────────────────────────────────────────
//
// INTENT DECIDES WHAT THE VERDICT MUST SHOW, and the experiment arm is verdict-aware. Normal
// serving requires FitProved, refused on either other arm with the obligations or numbers carried
// into the cause. A bounded experiment on FitRefused is refused too: a shape that cannot fit
// under any reading has nothing a measurement can rescue. A bounded experiment on
// FitUnestablished is admissible ONLY with a typed experiment plan -- the gate takes it as a
// parameter, and the wall builds it through the plan mint -- because the plan is what makes the
// experiment the smallest measuring configuration rather than an unbounded service wearing an
// experiment's name.
fn arm_memory_launch_gate(
  intent: ArmIntent,
  verdict: ArmMemoryFitVerdict,
  experiment: ArmMemoryExperimentPlan?,
) -> NonEmptyStr? {
  match intent {
    ArmNormalServing =>
      match verdict {
        ArmMemoryFitProved { rank: _, phase: _, headroom_bytes: _ } => none
        ArmMemoryFitRefused { rank: _, phase: _, demand_lower: _, supply_upper: _, cause: c } => Present { value: c }
        ArmMemoryFitUnestablished { obligations: os } =>
          Present { value: join([
            "normal serving requires a proved memory fit and this subject's fit is UNESTABLISHED: ",
            join(map(os, o => o as String), "; "),
          ], "") as NonEmptyStr }
      }
    ArmBoundedExperiment =>
      match verdict {
        ArmMemoryFitProved { rank: _, phase: _, headroom_bytes: _ } => none
        ArmMemoryFitRefused { rank: _, phase: _, demand_lower: _, supply_upper: _, cause: c } =>
          Present { value: join([
            "even a bounded experiment refuses: ", c as String,
            " -- a shape that cannot fit under its most favorable reading has nothing a measurement can rescue",
          ], "") as NonEmptyStr }
        ArmMemoryFitUnestablished { obligations: _ } =>
          match experiment {
            Present { value: _ } => none
            Absent =>
              Present { value: "an unestablished fit admits a bounded experiment only through a typed experiment plan -- one that names the open obligations it targets, runs at no larger an envelope than the normal-serving decision, carries a finite runtime and the receipts it must mint, and binds its stop/cleanup contract and route-enrollment prohibition; the full-serving configuration is not admissible on an unestablished fit by calling it an experiment" as NonEmptyStr }
          }
      }
  }
}

// ── THE RECEIPT JOIN ─────────────────────────────────────────────────────────────────────────────
//
// THE FRONTIER'S DISCHARGE, landed: a typed receipt roster on the fit subject. A receipt is a
// CLASSIFIED measurement bound to exactly one term of one rank; the measurement contract above
// governs what discharges -- MeasuredUpperBound and MeasuredInterval replace the open obligation
// they name, ObservationOnly and MeasurementRefused change nothing, because an observation that
// does not establish a bound changes no bound. ONE TERM PER RECEIPT, ONE RECEIPT PER TERM: a
// second receipt for an already-discharged term is refused (two measurements of one term need a
// peak-over-runs protocol at capture time, not a roster fold), and a receipt whose rank or
// component does not exist in this roster is refused rather than dropped -- a receipt that
// vanished in the join would be the count-only conservation defect this module exists to close,
// re-entering through the receipts door.
type ArmComponentReceipt {
  rank: Nat
  component: ArmMemoryComponent
  class: ArmMeasurementClass
}

fn receipt_measurement(class: ArmMeasurementClass) -> ArmMeasurement {
  match class {
    MeasuredUpperBound { measurement: m } => m
    MeasuredInterval { lower: _, upper: _, measurement: m } => m
    ObservationOnly { measurement: m, why: _ } => m
    MeasurementRefused { cause: _ } =>
      ArmMeasurement {
        component: ArmCheckpointResidency,
        rank: 0,
        phase: ArmPhaseModelLoad,
        workload: token_count(count: 0),
        covers_lifetime: false,
        protocol: ProtocolSingleSample,
        observed: byte_size(count: 0),
        receipt: "unreachable: a refused measurement carries no measurement and discharges nothing; the roster mint never reads this one" as NonEmptyStr,
      }
  }
}

// THE FIELD SETTER, exhaustive over the component coproduct -- the join's route back into the
// record, so a receipt can replace exactly the field it names and no other.
fn rank_with_component_bound(rd: ArmRankDemand, component: ArmMemoryComponent, bound: ArmComponentBound) -> ArmRankDemand {
  ArmRankDemand {
    rank: rd.rank,
    checkpoint_residency: if component == ArmCheckpointResidency { bound } else { rd.checkpoint_residency },
    loader_transform: if component == ArmLoaderTransform { bound } else { rd.loader_transform },
    runtime_fixed: if component == ArmRuntimeFixed { bound } else { rd.runtime_fixed },
    collective_workspace: if component == ArmCollectiveWorkspace { bound } else { rd.collective_workspace },
    activation_workspace: if component == ArmActivationWorkspace { bound } else { rd.activation_workspace },
    graph_capture: if component == ArmGraphCapture { bound } else { rd.graph_capture },
    kv_cache: if component == ArmKvCache { bound } else { rd.kv_cache },
    fragmentation_allowance: if component == ArmFragmentationAllowance { bound } else { rd.fragmentation_allowance },
  }
}

fn receipt_provenance_names_identity(r: ArmComponentReceipt, ckpt: ServingCheckpoint, rt: ServingRuntime, tp: ServingTopology) -> Bool {
  match r.class {
    MeasurementRefused { cause: _ } => true
    MeasuredUpperBound { measurement: _ } =>
      receipt_text_names_identity(class: r.class, ckpt: ckpt, rt: rt, tp: tp)
    MeasuredInterval { lower: _, upper: _, measurement: _ } =>
      receipt_text_names_identity(class: r.class, ckpt: ckpt, rt: rt, tp: tp)
    ObservationOnly { measurement: _, why: _ } =>
      receipt_text_names_identity(class: r.class, ckpt: ckpt, rt: rt, tp: tp)
  }
}

fn receipt_text_names_identity(class: ArmMeasurementClass, ckpt: ServingCheckpoint, rt: ServingRuntime, tp: ServingTopology) -> Bool {
  let m = receipt_measurement(class: class)
  string_contains(s: m.receipt as String, pattern: serving_checkpoint_wire(c: ckpt) as String)
    && string_contains(s: m.receipt as String, pattern: serving_runtime_wire(r: rt) as String)
    && string_contains(s: m.receipt as String, pattern: serving_topology_wire(t: tp) as String)
}

fn receipt_pair_count(receipts: List<ArmComponentReceipt>, rank: Nat, component: ArmMemoryComponent) -> Nat {
  count(filter(receipts, r => r.rank == rank && r.component == component))
}

fn roster_has_rank(ranks: List<ArmRankDemand>, rank: Nat) -> Bool {
  any(ranks, r => r.rank == rank)
}

fn apply_receipt_to_ranks(ranks: List<ArmRankDemand>, r: ArmComponentReceipt) -> List<ArmRankDemand> {
  map(ranks, rd =>
    if rd.rank == r.rank {
      rank_with_component_bound(rd: rd, component: r.component, bound: arm_apply_measurement(current: rank_component_bound(rd: rd, c: r.component), class: r.class))
    } else {
      rd
    })
}

// THE ROSTER MINT. Validates the join, the roster law, and provenance on every receipt, folds the
// receipts over the all-open rank records through the measurement contract, and returns the
// sealed subject the verdict fold prices. A roster of single-run observations returns a subject
// IDENTICAL in bounds to the all-open one -- the honest outcome of one experiment run, and the
// reason FitProved waits for protocoled measurements rather than for one wet afternoon.
fn arm_memory_fit_subject_with_receipts(
  checkpoint: ServingCheckpoint,
  runtime: ServingRuntime,
  topology: ServingTopology,
  intent: ServingCapacityIntent,
  requested_profile: ServingLaunchProfile,
  pool: ArmPoolBound,
  deductions: ArmSupplyDeductions,
  receipts: List<ArmComponentReceipt>,
) -> ArmMemorySubjectMint {
  let rank_count = serving_topology_rank_count(t: topology)
  let open_ranks = map(nat_range_inclusive(lo: 1, hi: rank_count), i => open_rank_demand(rank: i - 1))
  let rank_out_of_range = first(filter(receipts, r => !roster_has_rank(ranks: open_ranks, rank: r.rank)))
  let duplicate = first(filter(receipts, r => receipt_pair_count(receipts: receipts, rank: r.rank, component: r.component) > 1))
  let provenance_bad = first(filter(receipts, r => !receipt_provenance_names_identity(r: r, ckpt: checkpoint, rt: runtime, tp: topology)))
  match rank_out_of_range {
    Present { value: r } =>
      ArmMemorySubjectRefused {
        cause: join([
          "a receipt names rank ", to_string(r.rank), ", which this topology of ", to_string(rank_count),
          " rank(s) has no row for: a receipt that does not land on a rank is dropped by construction here, and construction refuses instead",
        ], "") as NonEmptyStr,
      }
    Absent =>
      match duplicate {
        Present { value: r } =>
          ArmMemorySubjectRefused {
            cause: join([
              "two receipts name rank ", to_string(r.rank), " ", arm_memory_component_wire(c: r.component),
              ": one term carries one bound; combining measurements of one term is the peak-over-runs protocol's job at capture time, not a second receipt in one roster",
            ], "") as NonEmptyStr,
          }
        Absent =>
          match provenance_bad {
            Present { value: r } =>
              ArmMemorySubjectRefused {
                cause: join([
                  "a receipt for rank ", to_string(r.rank), " ", arm_memory_component_wire(c: r.component),
                  " does not name this checkpoint x runtime x topology: a measurement carried onto another subject is evidence about a subject that is not this one",
                ], "") as NonEmptyStr,
              }
            Absent =>
              arm_memory_fit_subject_with_rank_demands(
                checkpoint: checkpoint,
                runtime: runtime,
                topology: topology,
                intent: intent,
                requested_profile: requested_profile,
                pool: pool,
                deductions: deductions,
                ranks: fold(receipts, init: open_ranks, f: fn(acc, r) { apply_receipt_to_ranks(ranks: acc, r: r) }))
          }
      }
  }
}

// ── THE UNIFIED PROOF SUBJECT (THE MoA DOCTRINE'S SEVEN AXES) ────────────────────────────────────
//
// EVERY TERM BINDS TO ONE EXACT SUBJECT, and the subject is the seven axes the owner directive
// names (docs/plans/moa-memory-modeling.md): model, runtime, topology, parallelism, allocator,
// workload, generation. The axes are not a string this module invents per call -- they are FIELDS,
// and the wire projection below is the single spelling of what each axis is derived from:
//
//   model       the checkpoint axis (which bytes, which loader).
//   runtime     the serving runtime axis (which engine build).
//   topology    the fleet topology axis (which rank population).
//   parallelism derived from the topology degree; pp/ep/dcp are NOT modeled on this arm and the
//               wire says so rather than inventing values for them.
//   allocator   the launch decision axis that sizes the carve: decided utilization basis points
//               and the KV cache dtype wire, both fields of the executable profile.
//   workload    the capacity intent the launch prices (seats x per-seat length, batch ceiling).
//   generation  the launch generation the receipt binds to, carried as a wire from the observing
//               layer (a generation is a cohort identity, gunbc.spark.execution_cell, not a fact
//               this module authors).
//
// THE RECEIPT-SUBJECT COMPATIBILITY LAW is the doctrine's admission rule: a receipt discharges a
// term only on subjects the term's scaling law is invariant across. A 64Kx1 receipt discharges
// only terms invariant to the move to 262Kx6; the workload-sensitive terms (per-token growth,
// phase transients) refuse across that move, and the workload-invariant ones (static residency,
// at equal seat count the per-sequence-fixed ones) may discharge. THE LAW IS A PROPERTY OF THE
// SCALING LAW, not of the receipt's prose: it is computed from the term's law below, and a receipt
// text claiming invariance it cannot show has no spelling here.
type MemoryProofSubject {
  checkpoint: ServingCheckpoint
  runtime: ServingRuntime
  topology: ServingTopology
  profile: ServingLaunchProfile
  intent: ServingCapacityIntent
  launch_generation: NonEmptyStr
}

type MemoryProofSubjectMint
  = MemoryProofSubjectReady { subject: MemoryProofSubject }
  | MemoryProofSubjectRefused { cause: NonEmptyStr }

// THE MINT. The workload axis must be the profile's own maximum admitted behavior (the same
// intent_for_launch_profile derivation the fit subject mint uses): a subject whose workload axis
// is a workload the executable cannot be asked for is a subject about another arm.
fn memory_proof_subject_for_launch(
  checkpoint: ServingCheckpoint,
  runtime: ServingRuntime,
  topology: ServingTopology,
  profile: ServingLaunchProfile,
  launch_generation: NonEmptyStr,
) -> MemoryProofSubjectMint {
  match intent_for_launch_profile(p: profile) {
    ServingCapacityIntentRefused { cause: c } =>
      MemoryProofSubjectRefused { cause: join(["the proof subject's workload axis does not derive from the executable profile: ", c as String], "") as NonEmptyStr }
    ServingCapacityIntentAdmitted { intent: intent } =>
      MemoryProofSubjectReady { subject: MemoryProofSubject {
        checkpoint: checkpoint,
        runtime: runtime,
        topology: topology,
        profile: profile,
        intent: intent,
        launch_generation: launch_generation,
      } }
  }
}

fn memory_proof_subject_workload_wire(s: MemoryProofSubject) -> String {
  join([
    to_string(intent_max_active_sequences(i: s.intent)), "x",
    to_string(token_count_value(t: intent_max_single_sequence_tokens(i: s.intent))),
    "-batch", to_string(token_count_value(t: s.intent.max_batched_tokens)),
  ], "")
}

// THE SEVEN-AXIS WIRE. One spelling, naming what is modeled and what is not; a consumer comparing
// two subjects compares the record, and the wire exists for receipts and obligations that must
// NAME their subject.
fn memory_proof_subject_wire(s: MemoryProofSubject) -> String {
  join([
    "model:", serving_checkpoint_wire(c: s.checkpoint) as String,
    " runtime:", serving_runtime_wire(r: s.runtime) as String,
    " topology:", serving_topology_wire(t: s.topology) as String,
    " parallelism:tp", to_string(serving_topology_rank_count(t: s.topology)), "/pp-unmodeled/ep-unmodeled/dcp-unmodeled",
    " allocator:hybrid-kv@", to_string(basis_point_count(bp: s.profile.decided_gpu_memory_basis_points)), "bp-", s.profile.kv_cache_dtype_wire as String,
    " workload:", memory_proof_subject_workload_wire(s: s),
    " generation:", s.launch_generation as String,
  ], "")
}

// CONFIG EQUALITY is the model/runtime/topology/allocator half of the subject: the axes a term's
// placement law is sensitive to. THE PARALLELISM AXIS IS TOPOLOGY-DERIVED, so a TP4 receipt on a
// TP2 subject fails here for every scaling law -- placement across a different degree is a
// different shape, which the measured 77.0-81.6 GiB per-rank spread already evidences. THE
// GENERATION AXIS IS DELIBERATELY NOT PART OF CONFIG: the 262Kx6 launch is a FUTURE GENERATION of
// this arm's configuration, and a discharge law that required generation equality would refuse
// every receipt in exactly the direction the doctrine permits -- a 64Kx1 receipt discharges the
// terms invariant to the move to 262Kx6, and invariance is a property of the configuration, not
// of which launch produced the reading. The generation wire names provenance; it does not gate
// discharge.
fn memory_proof_subject_config_equal(a: MemoryProofSubject, b: MemoryProofSubject) -> Bool {
  (serving_checkpoint_wire(c: a.checkpoint) as String) == (serving_checkpoint_wire(c: b.checkpoint) as String)
    && (serving_runtime_wire(r: a.runtime) as String) == (serving_runtime_wire(r: b.runtime) as String)
    && (serving_topology_wire(t: a.topology) as String) == (serving_topology_wire(t: b.topology) as String)
    && basis_point_count(bp: a.profile.decided_gpu_memory_basis_points) == basis_point_count(bp: b.profile.decided_gpu_memory_basis_points)
    && (a.profile.kv_cache_dtype_wire as String) == (b.profile.kv_cache_dtype_wire as String)
}

// WORKLOAD EQUALITY is seats, per-seat length and batch ceiling together: a larger seat population
// or a longer window is a different workload for every growth-sensitive term, and a different
// batch ceiling is a different activation peak.
fn memory_proof_subject_workload_equal(a: MemoryProofSubject, b: MemoryProofSubject) -> Bool {
  intent_max_active_sequences(i: a.intent) == intent_max_active_sequences(i: b.intent)
    && token_count_value(t: intent_max_single_sequence_tokens(i: a.intent)) == token_count_value(t: intent_max_single_sequence_tokens(i: b.intent))
    && token_count_value(t: a.intent.max_batched_tokens) == token_count_value(t: b.intent.max_batched_tokens)
}

fn memory_proof_subject_equal(a: MemoryProofSubject, b: MemoryProofSubject) -> Bool {
  memory_proof_subject_config_equal(a: a, b: b) && memory_proof_subject_workload_equal(a: a, b: b)
}

// ── THE MECHANISM-NAMED TERMS: WHAT ALLOCATES EACH BYTE, HOW IT SCALES ───────────────────────────
//
// THE MoA DECOMPOSITION IS THE AUTHORITY (docs/plans/moa-memory-modeling.md): every memory term
// names its mechanism -- which feature allocates the bytes (placement_law), how the quantity
// scales (scaling_law), which phase it exists in (phase), how long it lives (lifetime), what bound
// is admitted (bound), and the derivation or receipt that vouches for the bound. MEASUREMENTS
// SERVE ONLY THREE PURPOSES against these terms: validate a derived bound, fill a narrowly named
// underivable term, or falsify the model. A point sample never becomes a bound by being the
// largest seen once.
type MemoryScalingLaw
  = MemoryScalingStaticResidency
  | MemoryScalingPerSequenceFixed
  | MemoryScalingPerToken
  | MemoryScalingPerPooledToken { index_kpool: Nat }
  | MemoryScalingPhaseTransient
  | MemoryScalingChurnAllowance

fn memory_scaling_law_wire(l: MemoryScalingLaw) -> String {
  match l {
    MemoryScalingStaticResidency => "static-residency"
    MemoryScalingPerSequenceFixed => "per-sequence-fixed"
    MemoryScalingPerToken => "per-token"
    MemoryScalingPerPooledToken { index_kpool: k } => join(["per-pooled-token/", to_string(k)], "")
    MemoryScalingPhaseTransient => "phase-transient"
    MemoryScalingChurnAllowance => "churn-allowance"
  }
}

type MemoryPlacementLaw
  = MemoryPlacementCheckpointPlacement
  | MemoryPlacementRankResident
  | MemoryPlacementAllocatorCarve
  | MemoryPlacementPhaseWorkspace

fn memory_placement_law_wire(l: MemoryPlacementLaw) -> String {
  match l {
    MemoryPlacementCheckpointPlacement => "checkpoint-placement"
    MemoryPlacementRankResident => "rank-resident"
    MemoryPlacementAllocatorCarve => "allocator-carve"
    MemoryPlacementPhaseWorkspace => "phase-workspace"
  }
}

type MemoryLifetime
  = MemoryLifetimeProcess
  | MemoryLifetimeLaunch
  | MemoryLifetimeRequest
  | MemoryLifetimePhase

fn memory_lifetime_wire(l: MemoryLifetime) -> String {
  match l {
    MemoryLifetimeProcess => "process"
    MemoryLifetimeLaunch => "launch"
    MemoryLifetimeRequest => "request"
    MemoryLifetimePhase => "phase"
  }
}

// ONE MECHANISM-NAMED TERM. `bound` is the admitted bound for the quantity the term names (for a
// growth term, the per-unit cost the derivation names; for a static term, the whole quantity);
// `derivation` names the mechanism and the authority, and is where a measured bound's receipt or
// a derived bound's construction is spelled.
type MemoryTerm {
  component: ArmMemoryComponent
  placement_law: MemoryPlacementLaw
  scaling_law: MemoryScalingLaw
  phase: ArmMemoryFitPhase
  lifetime: MemoryLifetime
  bound: ArmComponentBound
  derivation: NonEmptyStr
}

// THE CENSUS AS MECHANISM-NAMED TERMS, one per component. THIS PROJECTION IS THE SINGLE AUTHORITY
// FOR WHICH SCALING LAW EACH COMPONENT CARRIES: the wet-receipt admission below binds receipts to
// terms, and a receipt claiming a law the census does not carry for that component is refused at
// the binding. The KV-cache term names the demand-side growth law; the carved-pool SUPPLY
// observation binds its own term (allocator-carve, static at a fixed allocator decision) beside
// it, and the two never share a spelling.
fn memory_terms_for_rank(rd: ArmRankDemand) -> List<MemoryTerm> {
  [
    MemoryTerm {
      component: ArmCheckpointResidency,
      placement_law: MemoryPlacementCheckpointPlacement,
      scaling_law: MemoryScalingStaticResidency,
      phase: ArmPhaseModelLoad,
      lifetime: MemoryLifetimeProcess,
      bound: rd.checkpoint_residency,
      derivation: "checkpoint manifest bytes placed by the loader's TP placement and transformation rules; the term is static across workload and its per-rank placement is NOT an even split unless a placement measurement says so" as NonEmptyStr,
    },
    MemoryTerm {
      component: ArmLoaderTransform,
      placement_law: MemoryPlacementPhaseWorkspace,
      scaling_law: MemoryScalingPhaseTransient,
      phase: ArmPhaseLoaderTransform,
      lifetime: MemoryLifetimePhase,
      bound: rd.loader_transform,
      derivation: "the loader's padding, repacking and temporary copies on top of the resident checkpoint; exists only inside its phase" as NonEmptyStr,
    },
    MemoryTerm {
      component: ArmRuntimeFixed,
      placement_law: MemoryPlacementRankResident,
      scaling_law: MemoryScalingStaticResidency,
      phase: ArmPhaseModelLoad,
      lifetime: MemoryLifetimeProcess,
      bound: rd.runtime_fixed,
      derivation: "runtime-fixed rank residency: allocator metadata, communication context and engine structures that exist from launch for the process life" as NonEmptyStr,
    },
    MemoryTerm {
      component: ArmCollectiveWorkspace,
      placement_law: MemoryPlacementRankResident,
      scaling_law: MemoryScalingStaticResidency,
      phase: ArmPhaseProfiling,
      lifetime: MemoryLifetimeLaunch,
      bound: rd.collective_workspace,
      derivation: "collective communication workspace: sized by the parallelism degree and dtype configuration, not by the request workload" as NonEmptyStr,
    },
    MemoryTerm {
      component: ArmActivationWorkspace,
      placement_law: MemoryPlacementPhaseWorkspace,
      scaling_law: MemoryScalingPhaseTransient,
      phase: ArmPhaseProfiling,
      lifetime: MemoryLifetimePhase,
      bound: rd.activation_workspace,
      derivation: "activation and per-batch workspaces at the profiled batch shape; a phase transient whose peak the engine profiles against the batch ceiling it will actually run" as NonEmptyStr,
    },
    MemoryTerm {
      component: ArmGraphCapture,
      placement_law: MemoryPlacementRankResident,
      scaling_law: MemoryScalingStaticResidency,
      phase: ArmPhaseGraphCapture,
      lifetime: MemoryLifetimeLaunch,
      bound: rd.graph_capture,
      derivation: "CUDA graph capture workspace and what persists after it; static across workload once captured" as NonEmptyStr,
    },
    MemoryTerm {
      component: ArmKvCache,
      placement_law: MemoryPlacementAllocatorCarve,
      scaling_law: MemoryScalingPerToken,
      phase: ArmPhaseIdleServing,
      lifetime: MemoryLifetimeLaunch,
      bound: rd.kv_cache,
      derivation: "the admitted-sequences demand over the resolved cache roster: fixed-per-sequence state, per-token sparse cache, per-pooled-token index, per-sequence tail, plus grouping and padding; the generic term names the per-token growth law and the exact roster fold below is the only admitted cost" as NonEmptyStr,
    },
    MemoryTerm {
      component: ArmFragmentationAllowance,
      placement_law: MemoryPlacementAllocatorCarve,
      scaling_law: MemoryScalingChurnAllowance,
      phase: ArmPhasePeakServing,
      lifetime: MemoryLifetimeLaunch,
      bound: rd.fragmentation_allowance,
      derivation: "allocator fragmentation under churn: an allowance term, bounded only by a conservative construction or a churn-protocol measurement" as NonEmptyStr,
    },
  ]
}

// THE RECEIPT-SUBJECT COMPATIBILITY LAW, computed from the scaling law. Static residency survives
// a workload move (weights do not grow with the window); per-sequence-fixed survives only at equal
// seat count (KDA state doubles when the seat population doubles); every workload-sensitive law
// requires the full workload. ALL LAWS require config equality: a receipt carried across a
// checkpoint, runtime, topology, allocator decision or generation is evidence about a subject that
// is not this one.
fn memory_scaling_law_discharges_on(law: MemoryScalingLaw, measured_on: MemoryProofSubject, target: MemoryProofSubject) -> Bool {
  match law {
    MemoryScalingStaticResidency =>
      memory_proof_subject_config_equal(a: measured_on, b: target)
    MemoryScalingPerSequenceFixed =>
      memory_proof_subject_config_equal(a: measured_on, b: target)
        && intent_max_active_sequences(i: measured_on.intent) == intent_max_active_sequences(i: target.intent)
    MemoryScalingPerToken => memory_proof_subject_equal(a: measured_on, b: target)
    MemoryScalingPerPooledToken { index_kpool: _ } => memory_proof_subject_equal(a: measured_on, b: target)
    MemoryScalingPhaseTransient => memory_proof_subject_equal(a: measured_on, b: target)
    MemoryScalingChurnAllowance => memory_proof_subject_equal(a: measured_on, b: target)
  }
}

// ── THE MEASUREMENT-STANDING VOCABULARY ──────────────────────────────────────────────────────────
//
// THE STANDINGS NAME WHAT AN OBSERVATION ESTABLISHES, and nothing more. DerivedExact is a genuine
// derivation; DerivedConservativeInterval is a derived pair whose lower is the conservative
// contribution; MeasuredUpperBound is a bound from a bounding protocol (peak-over-runs or the
// engine's own reported maximum); ObservedInterval and ObservationOnly preserve readings without
// bounding them -- a reading at a stated reporter precision is an interval, a point sample is a
// point, and neither discharges an open term by itself; CompositeObservation is a profile term
// that does not separate its mechanisms (weights+nontorch is the instance); GraphAttribution
// Unestablished is a NEGATIVE resident-demand reading whose interval the profiler cannot attribute
// -- it is preserved raw and admitted as lower bound 0, upper open, NEVER a credit; ModelFalsified
// is an observation outside its predicted interval, which breaks the bound rather than tightening
// it. THE CREDIT LAW BELOW IS THE WHOLE POINT: weaker evidence cannot improve admission, so only
// the three bounding standings contribute anything to supply or headroom.
type ArmWetStanding
  = ArmWetDerivedExact { bytes: ByteSize, derivation: NonEmptyStr }
  | ArmWetDerivedConservativeInterval { lower: ByteSize, upper: ByteSize, derivation: NonEmptyStr }
  | ArmWetMeasuredUpperBound { bytes: ByteSize, receipt: NonEmptyStr }
  | ArmWetObservedInterval { lower: ByteSize, upper: ByteSize, receipt: NonEmptyStr }
  | ArmWetObservationOnly { bytes: ByteSize, receipt: NonEmptyStr, why: NonEmptyStr }
  | ArmWetCompositeObservation { bytes: ByteSize, receipt: NonEmptyStr, why: NonEmptyStr }
  | ArmWetGraphAttributionUnestablished { raw_hundredths_gib: Int, receipt: NonEmptyStr }
  | ArmWetModelFalsified { component: ArmMemoryComponent, predicted: ArmComponentBound, observed_bytes: ByteSize, receipt: NonEmptyStr }

fn arm_wet_standing_wire(s: ArmWetStanding) -> String {
  match s {
    ArmWetDerivedExact { bytes: _, derivation: _ } => "DerivedExact"
    ArmWetDerivedConservativeInterval { lower: _, upper: _, derivation: _ } => "DerivedConservativeInterval"
    ArmWetMeasuredUpperBound { bytes: _, receipt: _ } => "MeasuredUpperBound"
    ArmWetObservedInterval { lower: _, upper: _, receipt: _ } => "ObservedInterval"
    ArmWetObservationOnly { bytes: _, receipt: _, why: _ } => "ObservationOnly"
    ArmWetCompositeObservation { bytes: _, receipt: _, why: _ } => "CompositeObservation"
    ArmWetGraphAttributionUnestablished { raw_hundredths_gib: _, receipt: _ } => "GraphAttributionUnestablished"
    ArmWetModelFalsified { component: _, predicted: _, observed_bytes: _, receipt: _ } => "ModelFalsified"
  }
}

// THE CREDIT A STANDING CONTRIBUTES TO SUPPLY OR HEADROOM. Bounding standings contribute their
// conservative content; every observation-class standing contributes ZERO -- preserving a reading
// is not bounding with it. The negative graph figure's raw value rides in its standing for the
// record, and its credit is exactly zero: a component observation that cannot be attributed can
// never improve headroom, which is the doctrine's weaker-evidence-cannot-improve-admission rule as
// one function.
fn arm_wet_standing_credit_bytes(s: ArmWetStanding) -> ByteSize {
  match s {
    ArmWetDerivedExact { bytes: b, derivation: _ } => b
    ArmWetDerivedConservativeInterval { lower: l, upper: _, derivation: _ } => l
    ArmWetMeasuredUpperBound { bytes: b, receipt: _ } => b
    ArmWetObservedInterval { lower: _, upper: _, receipt: _ } => byte_size(count: 0)
    ArmWetObservationOnly { bytes: _, receipt: _, why: _ } => byte_size(count: 0)
    ArmWetCompositeObservation { bytes: _, receipt: _, why: _ } => byte_size(count: 0)
    ArmWetGraphAttributionUnestablished { raw_hundredths_gib: _, receipt: _ } => byte_size(count: 0)
    ArmWetModelFalsified { component: _, predicted: _, observed_bytes: _, receipt: _ } => byte_size(count: 0)
  }
}

// A RECEIPT BINDING: one observed standing claimed against ONE mechanism-named term of one rank,
// with the subject it was measured on carried beside it. ONE BINDING ONE TERM: combining several
// readings of one term is the peak-over-runs protocol's job at capture time, not a fold here.
type ArmWetReceiptBinding {
  term: MemoryTerm
  rank: Nat
  standing: ArmWetStanding
  measured_on: MemoryProofSubject
  provenance: NonEmptyStr
}

type ArmWetBindingAdmission
  = ArmWetBindingAdmitted { binding: ArmWetReceiptBinding }
  | ArmWetBindingRefused { binding: ArmWetReceiptBinding, cause: NonEmptyStr }

// THE BINDING ADMISSION, two walls:
//   1. AN ATTRIBUTION REFUSAL TRAVELS ONLY WITH ITS MECHANISM. The negative graph figure binds to
//      graph-capture and nothing else.
//   2. THE RECEIPT-SUBJECT COMPATIBILITY LAW. The term's scaling law must be invariant across the
//      move from the receipt's subject to the target; a TP4 receipt applied to TP2, or a 64Kx1
//      activation reading applied to a 262Kx6 subject, refuses naming the axis.
// WHAT ADMISSION DOES NOT SETTLE: an admitted binding is evidence bound to the right subject and
// mechanism, not yet a bound. A composite observation is ADMITTED like any other reading (it
// transfers to any subject at an equal configuration -- weights do not move with the workload);
// what it can never do is DISCHARGE an open obligation, and that is the discharge wall below, a
// separate question answered by the standing's class, not by where the reading was taken.
fn arm_admit_wet_binding(binding: ArmWetReceiptBinding, target: MemoryProofSubject) -> ArmWetBindingAdmission {
  match binding.standing {
    ArmWetGraphAttributionUnestablished { raw_hundredths_gib: _, receipt: _ } =>
      if (binding.term.component == ArmGraphCapture) {
        arm_admit_wet_binding_subject_wall(binding: binding, target: target)
      } else {
        ArmWetBindingRefused {
          binding: binding,
          cause: "a negative component observation is an attribution refusal and travels only with its own mechanism: it binds to graph-capture and refuses every other term, because an unattributable interval cannot be placed on a mechanism it was not read from" as NonEmptyStr,
        }
      }
    _ => arm_admit_wet_binding_subject_wall(binding: binding, target: target)
  }
}

// THE DISCHARGE WALL: may this standing replace an open obligation of the term it binds to? ONLY
// THE BOUNDING STANDINGS DISCHARGE. weights+nontorch is the standing this wall exists for: a
// COMPOSITE observation of rank residency does not separate checkpoint tensors from runtime-fixed,
// allocator, communication or other non-Torch allocations, so it is admitted as evidence but can
// never discharge the checkpoint-placement obligation -- no matter how large, how precise, or how
// faithfully transferred from another generation of the same configuration. The doctrine's rule is
// weaker-evidence-cannot-improve-admission, and the negative graph figure's zero credit above is
// the same rule at the headroom side: an observation that cannot attribute its own interval can
// neither bound a term nor improve a verdict.
fn arm_wet_standing_discharges_open(standing: ArmWetStanding, open: ArmComponentBound) -> Bool {
  match open {
    ComponentBoundOpen { obligation: _ } =>
      match standing {
        ArmWetDerivedExact { bytes: _, derivation: _ } => true
        ArmWetDerivedConservativeInterval { lower: _, upper: _, derivation: _ } => true
        ArmWetMeasuredUpperBound { bytes: _, receipt: _ } => true
        ArmWetObservedInterval { lower: _, upper: _, receipt: _ } => false
        ArmWetObservationOnly { bytes: _, receipt: _, why: _ } => false
        ArmWetCompositeObservation { bytes: _, receipt: _, why: _ } => false
        ArmWetGraphAttributionUnestablished { raw_hundredths_gib: _, receipt: _ } => false
        ArmWetModelFalsified { component: _, predicted: _, observed_bytes: _, receipt: _ } => false
      }
    ComponentBoundExact { bytes: _, how: _ } => false
    ComponentBoundInterval { lower: _, upper: _, how: _ } => false
    ComponentBoundCeiling { bytes: _, receipt: _ } => false
  }
}

fn arm_admit_wet_binding_subject_wall(binding: ArmWetReceiptBinding, target: MemoryProofSubject) -> ArmWetBindingAdmission {
  match memory_scaling_law_discharges_on(law: binding.term.scaling_law, measured_on: binding.measured_on, target: target) {
    false =>
      ArmWetBindingRefused {
        binding: binding,
        cause: join([
          "the receipt was measured on ", memory_proof_subject_wire(s: binding.measured_on),
          " and the term carries the scaling law ", memory_scaling_law_wire(l: binding.term.scaling_law),
          ", which is not invariant to the move to the target subject ", memory_proof_subject_wire(s: target),
          ": a receipt discharges only terms invariant across that move (the MoA compatibility law), and this term is workload- or placement-sensitive across it",
        ], "") as NonEmptyStr,
      }
    true => ArmWetBindingAdmitted { binding: binding }
  }
}

// ── THE CACHE SUBPROOF ───────────────────────────────────────────────────────────────────────────
//
// THE RESULT VOCABULARY SPLITS (docs/plans/moa-memory-modeling.md): the cache subclaim decides
// separately from the whole arm, because the cache is the one component whose six-seat cost at
// 262144 was on its way to FitProved by dividing the printed token figure. THAT MOVE IS WITHDRAWN
// and this subproof replaces it: six seats at 262144 is a CacheCapacityCandidate until the exact
// group roster folds directly against every rank's allocator evidence. THE PROOF IS THE DIRECT
// FOLD and nothing else:
//
//     seats x cold_admission_blocks(roster, 262144) <= allocator_blocks on EVERY rank
//
// THE SHARED-POOL BYTE CORRECTION (docs/plans/shared-pool-byte-correction.md, owner directive
// 2026-09-26) makes the block wall the capacity authority and demotes bytes to a conservation
// check on the pool's construction: the old second clause (seats x per-group page bytes <=
// admitted arena) priced the group spec's pages as if they were the shared pool's block cost and
// underpriced the request ~106x — group-spec page bytes are the LOGICAL group charge, and the
// physical pool block (vLLM's _get_kv_cache_bytes_per_block; one backing tensor, groups
// overlaying it, a block ID owned by one group at a time) is a different, larger figure that only
// the allocation plan's v2 emission carries. So NO fold here compares demand bytes against an
// arena: the byte-level controls are pool-CONSTRUCTION controls (PoolConstructionProved — the
// carve conserves, fits every rank's arena, and the arena slack is under one block modulo named
// reservations/rounding), a demand's only byte spelling is block_equivalent_bytes (blocks x the
// physical pool block size), and a v1 (blocks-only) plan proves at the block wall with no byte
// conservation claimed. cold_admission_blocks/bytes (extdeps.vllm.kv_layout) charge each group
// its own growth law — KDA state fixed per sequence, sparse MLA per token, KPool per pooled
// token, the sparse-indexer tail per sequence, and the grouping/padding is the per-group
// ceil-to-block charge, inside the fold rather than beside it. THE ROSTER BINDS THE EXACT MODEL:
// a roster with a different KDA count, a different pool interval, or a missing tail group is a
// different capacity, and a proof at one roster says nothing at another. THE TOKEN DIVISION IS
// NOT A PROOF: the printed "GPU KV cache size: N tokens" is a full-context-equivalent
// projection, and the floor of it divided by the context is carried as a candidate sizing hint
// with no path into any verdict.
//
// THE VERDICT SHAPE IS THE CORRECTION'S: Proved carries the evidence-bound limiting rank, the
// seat population, the length, the per-seat block cost, the used and reserved block counts, the
// hard ceiling, and — only when the plan carries the v2 pool figures — the demand spelled as
// block_equivalent_bytes. Any byte figure anywhere in this vocabulary is named
// block_equivalent_bytes, never demand bytes, ordinary memory demand, or physical headroom.
type CacheFitVerdict
  = CacheFitProved {
      limiting_rank: Nat
      seats: Nat
      length: TokenCount
      blocks_per_seat: AllocatorBlockCount
      blocks_used: AllocatorBlockCount
      blocks_reserved: AllocatorBlockCount
      hard_ceiling: Nat
      block_equivalent_bytes: ByteSize?
    }
  | CacheFitRefused {
      limiting_rank: Nat
      seats: Nat
      length: TokenCount
      blocks_per_seat: AllocatorBlockCount
      blocks_used: AllocatorBlockCount
      supply_allocator_blocks: AllocatorBlockCount
      cause: NonEmptyStr
    }
  | CacheFitUnestablished { obligations: List<NonEmptyStr> }

// THE PER-RANK SUPPLY THE FOLD DECIDES AGAINST: the observed allocator inventory and the observed
// admitted-KV-arena carve, both observations of the SAME launch the demand names (the wet-admission
// layer below is where that binding is enforced; a bare fold trusts its caller, and the only
// callers are that layer and claims supplying the binding themselves).
type ArmRankCacheSupply {
  rank: Nat
  allocator_blocks: AllocatorBlockCount
  admitted_kv_arena_bytes: ByteSize
}

// THE ROSTER'S REQUIRED SHAPES FOR THIS MODEL, one obligation per missing member. The roster must
// carry: the KDA state group for exactly the model's recurrent layer count; the sparse-MLA group
// for exactly the sparse layer count; the KPool group at exactly the model's index_kpool; and the
// sparse-indexer tail as a per-sequence state distinct from the KDA group. A roster missing any of
// them prices a different cache than the engine allocates, and the fold says which rather than
// charging the omission as zero.
fn cache_roster_obligations(layout: ResolvedKvLayout, shape: Glm53FlashHybridShape) -> List<NonEmptyStr> {
  if !glm_5_3_flash_hybrid_shape_consistent(shape) {
    ["the model's hybrid shape is inconsistent (the recurrent and sparse layer counts do not sum to the layer count, or a growth divisor is zero): the roster requirement it prices cannot be derived from it" as NonEmptyStr]
  } else if (layout.established_at_revision.repository as String) != (vllm_source_revision_read.repository as String)
    || (layout.established_at_revision.full_revision as String) != (vllm_source_revision_read.full_revision as String) {
    [join([
      "the roster was established at ", layout.established_at_revision.repository as String, "@", layout.established_at_revision.full_revision as String,
      " but the capacity arithmetic is modelled against ", vllm_source_revision_read.repository as String, "@", vllm_source_revision_read.full_revision as String,
      ": a roster from another revision is a different engine's shape and this proof binds the exact roster",
    ], "") as NonEmptyStr]
  } else {
    let kda_ok = any(layout.groups, g => match g.kind {
      MambaState => attention_layer_count_value(c: g.layer_count) == shape.kda_linear_attention_layers
      _ => false
    })
    let sparse_ok = any(layout.groups, g => match g.kind {
      FullAttention => attention_layer_count_value(c: g.layer_count) == shape.sparse_attention_layers
      _ => false
    })
    let kpool_ok = any(layout.groups, g => match g.kind {
      KPoolIndex { pool_every: p } => token_count_value(t: p) == shape.index_kpool
      _ => false
    })
    let kpool_other = first(filter(layout.groups, g => match g.kind {
      KPoolIndex { pool_every: p } => token_count_value(t: p) != shape.index_kpool
      _ => false
    }))
    let mamba_count = count(filter(layout.groups, g => match g.kind { MambaState => true  _ => false }))
    concat(
      match kda_ok {
        true => [] as List<NonEmptyStr>
        false => [join(["missing KDA state group: the model's ", to_string(shape.kda_linear_attention_layers), " recurrent layers require a mamba-shaped group of exactly that layer count, and the roster carries none"], "") as NonEmptyStr]
      },
      concat(
        match sparse_ok {
          true => [] as List<NonEmptyStr>
          false => [join(["missing sparse-MLA group: the model's ", to_string(shape.sparse_attention_layers), " sparse-attention layers require a full-growth group of exactly that layer count, and the roster carries none"], "") as NonEmptyStr]
        },
        concat(
          match kpool_ok {
            true => [] as List<NonEmptyStr>
            false =>
              match kpool_other {
                Present { value: _ } => [join(["the roster's KPool group is priced at a pool interval other than the model's index_kpool ", to_string(shape.index_kpool), ": a different pool interval is a different capacity, and this proof binds the exact roster"], "") as NonEmptyStr]
                Absent => [join(["missing KPool index group: the sparse layers keep a compressed index growing once per index_kpool ", to_string(shape.index_kpool), " tokens, and the roster carries no KPool group at that interval"], "") as NonEmptyStr]
              }
          },
          match mamba_count >= 2 {
            true => [] as List<NonEmptyStr>
            false => ["missing sparse-indexer tail group: the sparse-attention layers carry a small per-request tail state, fixed per sequence, distinct from the KDA recurrent state -- a roster with only the KDA state group prices a different cache than the engine allocates" as NonEmptyStr]
          })))
  }
}

// THE SUPPLY-SIDE OBLIGATIONS: exactly one supply row per topology rank, and no zero readings (a
// zero observation bounds nothing; it is an obligation, not a free supply).
fn cache_supply_obligations(supplies: List<ArmRankCacheSupply>, rank_count: Nat) -> List<NonEmptyStr> {
  concat(
    match count(supplies) == rank_count {
      true => [] as List<NonEmptyStr>
      false => [join(["per-rank allocator inventory and KV-arena observations exist for ", to_string(count(supplies)), " of ", to_string(rank_count), " ranks: the byte wall decides on EVERY rank, and a missing rank is an unnamed obligation, never a generous reading"], "") as NonEmptyStr]
    },
    map(filter(supplies, s => allocator_block_count_value(c: s.allocator_blocks) == 0 || byte_size_count(b: s.admitted_kv_arena_bytes) == 0), s =>
      join(["rank ", to_string(s.rank), " carries a zero allocator inventory or KV-arena observation: a zero reading bounds nothing and the supply side stays open on that rank"], "") as NonEmptyStr))
}

// THE DIRECT (LAYOUT) FOLD. Order: roster obligations, then supply obligations, then the per-rank
// BLOCK decision (ranks in roster order, first refusal carries). The layout has no pool-byte
// figures — byte conservation is the allocation plan's construction vocabulary, never this fold's
// — so a Proved here is blocks-only: block_equivalent_bytes rides Absent, blocks_reserved is zero
// (the reserve policy is the plan fold's vocabulary), and the limiting rank is the first supply
// rank, because the layout fold holds no per-rank evidence that separates a uniform-inventory
// tie. A refusal that fires only because the roster padded a missing group as zero is impossible
// by construction, because the obligations above already refused.
fn cache_fit_verdict(
  layout: ResolvedKvLayout,
  shape: Glm53FlashHybridShape,
  seats: Nat,
  at: TokenCount,
  supplies: List<ArmRankCacheSupply>,
  rank_count: Nat,
) -> CacheFitVerdict {
  let roster_obligations = cache_roster_obligations(layout: layout, shape: shape)
  let supply_obligations = cache_supply_obligations(supplies: supplies, rank_count: rank_count)
  let obligations = concat(roster_obligations, supply_obligations)
  match length(obligations) > 0 {
    true => CacheFitUnestablished { obligations: obligations }
    false =>
      match cold_admission_blocks(layout: layout, sequence_budget: at) {
        AdmissionCostUnestablished { cause: c } => CacheFitUnestablished { obligations: [c] }
        AdmissionCostBlocks { blocks: per_seat_blocks } =>
          let demand_blocks = allocator_block_count(count: allocator_block_count_value(c: per_seat_blocks) * seats)
          match cache_fit_rank_scan(
            supplies: supplies,
            blocks_per_seat: per_seat_blocks,
            demand_blocks: demand_blocks,
            seats: seats,
            length: at,
          ) {
            Present { value: refused } => refused
            Absent => cache_fit_proved_corner(supplies: supplies, blocks_per_seat: per_seat_blocks, demand_blocks: demand_blocks, seats: seats, length: at)
          }
      }
  }
}

// ONE REFUSAL OR NONE: the first rank whose inventory cannot hold the block demand — the block
// wall is the only capacity wall, so the scan is a single comparison per rank. (The byte wall the
// scan used to run was the withdrawn move: it compared the sum of group-spec page bytes against
// arenas, and that sum is not the shared pool's block cost.)
fn cache_fit_rank_scan(
  supplies: List<ArmRankCacheSupply>,
  blocks_per_seat: AllocatorBlockCount,
  demand_blocks: AllocatorBlockCount,
  seats: Nat,
  length: TokenCount,
) -> CacheFitVerdict? {
  first(map(filter(supplies, s =>
      allocator_block_count_value(c: demand_blocks) > allocator_block_count_value(c: s.allocator_blocks)), s =>
    CacheFitRefused {
      limiting_rank: s.rank,
      seats: seats,
      length: length,
      blocks_per_seat: blocks_per_seat,
      blocks_used: demand_blocks,
      supply_allocator_blocks: s.allocator_blocks,
      cause: join([
        "cache capacity REFUSED at rank ", to_string(s.rank), ": ", to_string(seats), " seats at ",
        to_string(token_count_value(t: length)), " tokens require ", to_string(allocator_block_count_value(c: demand_blocks)),
        " allocator blocks by the exact roster fold, which exceeds the rank's inventory of ",
        to_string(allocator_block_count_value(c: s.allocator_blocks)), " blocks",
      ], "") as NonEmptyStr,
    }))
}

// THE PROVED CORNER, reached only when no rank refused. The worst (least) BLOCK headroom across
// the ranks names the limiting rank; under a uniform engine-derived inventory the tie is real
// (the engine already applied the min across ranks when it computed the inventory) and the first
// supply rank is named, said so rather than hidden.
fn cache_fit_proved_corner(supplies: List<ArmRankCacheSupply>, blocks_per_seat: AllocatorBlockCount, demand_blocks: AllocatorBlockCount, seats: Nat, length: TokenCount) -> CacheFitVerdict {
  let headrooms = map(supplies, s => ArmRankCacheSupply {
    rank: s.rank,
    allocator_blocks: allocator_block_count(count: allocator_block_count_value(c: s.allocator_blocks) - allocator_block_count_value(c: demand_blocks)),
    admitted_kv_arena_bytes: s.admitted_kv_arena_bytes,
  })
  let worst = fold(headrooms, init: first(headrooms), f: (acc, s) => match acc {
    Absent => Present { value: s }
    Present { value: a } =>
      match allocator_block_count_value(c: s.allocator_blocks) < allocator_block_count_value(c: a.allocator_blocks) {
        true => Present { value: s }
        false => acc
      }
  })
  match worst {
    Absent => CacheFitUnestablished { obligations: ["unreachable: a supply roster that passed the count wall has a first rank" as NonEmptyStr] }
    Present { value: w } => CacheFitProved {
      limiting_rank: w.rank,
      seats: seats,
      length: length,
      blocks_per_seat: blocks_per_seat,
      blocks_used: demand_blocks,
      blocks_reserved: allocator_block_count(count: 0),
      hard_ceiling: (allocator_block_count_value(c: w.allocator_blocks) + allocator_block_count_value(c: demand_blocks)) / allocator_block_count_value(c: blocks_per_seat),
      block_equivalent_bytes: none,
    }
  }
}

// ── THE PLAN ROSTER FOLD: THE ALLOCATION PLAN IS THE EXACT GROUP ROSTER ──────────────────────────
//
// THE DIRECT FOLD'S PLAN-SHAPED SIBLING. The fold above prices a ResolvedKvLayout whose groups are
// per-mechanism rows charged by the growth taxonomy — the roster the doctrine required while no
// engine vouched for its figures. THE ALLOCATION PLAN IS THAT ROSTER, READ OFF THE ENGINE: the
// patched emission's groups ARE the allocator's units, and blocks_at_requested_length IS the
// engine's own per-group charge at the requested length — the exact arithmetic of
// get_max_concurrency_for_kv_cache_config, which the plan control reproduces against the printed
// line before any consumer may cite the plan. So this fold does NOT re-derive blocks from kind
// and block size (that is the layout projection's job, and on the plan's allocation grouping it
// would double-count: group-0 rosters both the indexer.k_cache and the attn entries of each
// sparse layer, and the mamba groups are charged per group, not per layer identity). IT PRICES
// THE PLAN'S OWN VOUCHED FIGURES: per-seat blocks are the sum of blocks_at_requested_length — one
// shared-pool block per figure, because a block ID owned by any group consumes one block of the
// engine's single backing tensor. The group rows' group_spec_page_size_bytes are the LOGICAL
// per-group page charge (blocks_at x spec page = max_memory_usage_bytes, the charge that
// reproduces the printed capacity); they are NEVER summed into a byte demand — that sum was the
// withdrawn 125,010,432-byte figure, ~106x under the block-equivalent spelling. The exact-model
// bind is the roster census below, computed from the plan's own layer identities: a roster with
// a different KDA population, a different sparse coverage, or a missing tail prices a different
// cache, exactly as the layout fold refuses the foreign roster.
//
// THE FOLD PRICES AT THE PLAN'S OWN REQUESTED LENGTH and nowhere else: blocks_at_requested_length
// is vouched at that length alone. A consumer pricing another length uses the plan's growth
// re-derivation (extdeps.vllm.kv_layout plan_admission_blocks_at_length), a different (weaker)
// claim, and does not reach this verdict vocabulary.
//
// THE CORRECTED DEMAND, per the shared-pool byte correction: the block wall decides capacity
// (blocks_used <= inventory on every rank); the ONLY byte figure the verdict carries is
// block_equivalent_bytes = blocks_used x physical_pool_bytes_per_block, present only when the
// plan carries the v2 pool fields, and named so it is never read as ordinary memory demand or
// physical headroom. A v1 plan proves with block_equivalent_bytes Absent — blocks proven, no byte
// conservation claimed. The limiting rank and the reserve policy are EVIDENCE INPUTS: the
// bundle's observations name the rank that set the engine's min-across-ranks inventory (the
// engine applied that min when it computed allocator_blocks, uniform across the ranks), and the
// policy names how many blocks stand reserved behind the proven seats.

// THE CENSUS, from the plan's own layer identities. The GLM-5.3-Flash allocation grouping rosters
// each recurrent layer once across the mamba groups; each sparse layer twice in the mla_attention
// group (its indexer.k_cache and its attn entries) plus once in the sliding-window tail group
// (its tail_cache entry). The suffixes are the emission's own spelling (the patched engine emits
// list(group.layer_names)), and the counts bind the model: 34 KDA entries, 11 k_cache + 11 attn
// entries, 11 tail entries — 67 identities over the 45 hidden layers, the engine's own
// grouping_padding note.
fn cache_plan_mamba_entries(plan: ResolvedKvAllocationPlan) -> Nat {
  fold(plan.groups, init: 0, f: (acc, g) => match g.kind {
    MambaState => acc + length(g.layer_identities)
    _ => acc
  })
}

fn cache_plan_windowed_entries(plan: ResolvedKvAllocationPlan) -> Nat {
  fold(plan.groups, init: 0, f: (acc, g) => match g.kind {
    SlidingWindowAttention { window: _ } => acc + length(g.layer_identities)
    _ => acc
  })
}

fn cache_plan_full_attention_identities_with(plan: ResolvedKvAllocationPlan, suffix: String) -> Nat {
  fold(plan.groups, init: 0, f: (acc, g) => match g.kind {
    FullAttention => acc + length(filter(g.layer_identities, id => string_contains(s: id as String, pattern: suffix)))
    _ => acc
  })
}

fn cache_plan_roster_obligations(plan: ResolvedKvAllocationPlan, shape: Glm53FlashHybridShape) -> List<NonEmptyStr> {
  if !glm_5_3_flash_hybrid_shape_consistent(shape) {
    ["the model's hybrid shape is inconsistent (the recurrent and sparse layer counts do not sum to the layer count, or a growth divisor is zero): the roster requirement it prices cannot be derived from it" as NonEmptyStr]
  } else if (plan.runtime.repository as String) != (vllm_source_revision_read.repository as String)
    || (plan.runtime.full_revision as String) != (vllm_source_revision_read.full_revision as String) {
    [join([
      "the allocation plan was read at ", plan.runtime.repository as String, "@", plan.runtime.full_revision as String,
      " but the capacity arithmetic is modelled against ", vllm_source_revision_read.repository as String, "@", vllm_source_revision_read.full_revision as String,
      ": a plan from another revision is a different engine's roster and this proof binds the exact one",
    ], "") as NonEmptyStr]
  } else {
    let kda_entries = cache_plan_mamba_entries(plan: plan)
    let kcache_entries = cache_plan_full_attention_identities_with(plan: plan, suffix: ".indexer.k_cache")
    let attn_entries = cache_plan_full_attention_identities_with(plan: plan, suffix: ".self_attn.attn")
    let tail_entries = cache_plan_windowed_entries(plan: plan)
    concat(
      match kda_entries == shape.kda_linear_attention_layers {
        true => [] as List<NonEmptyStr>
        false => [join([
          "the roster's mamba groups roster ", to_string(kda_entries),
          " recurrent-layer entries against the model's ", to_string(shape.kda_linear_attention_layers),
          " KDA layers: a different recurrent population is a different capacity, and this proof binds the exact roster",
        ], "") as NonEmptyStr]
      },
      concat(
        match kcache_entries == shape.sparse_attention_layers && attn_entries == shape.sparse_attention_layers {
          true => [] as List<NonEmptyStr>
          false => [join([
            "the roster's mla_attention group rosters ", to_string(kcache_entries), " indexer.k_cache and ", to_string(attn_entries),
            " attn entries against the model's ", to_string(shape.sparse_attention_layers),
            " sparse layers: the sparse coverage does not match the model, and a proof at one roster says nothing at another",
          ], "") as NonEmptyStr]
        },
        match tail_entries == shape.sparse_attention_layers {
          true => [] as List<NonEmptyStr>
          false => [join([
            "the roster's sliding-window tail group rosters ", to_string(tail_entries),
            " tail_cache entries against the model's ", to_string(shape.sparse_attention_layers),
            " sparse layers: the sparse-indexer tail is one state per sparse layer, and a roster missing or multiplying it prices a different cache than the engine allocates",
          ], "") as NonEmptyStr]
        }))
  }
}

// THE RESERVE POLICY, the doctrine's explicit split of hard ceiling from guaranteed service
// (docs/plans/shared-pool-byte-correction.md): the hard ceiling is a property of the inventory
// alone (floor(inventory / blocks_per_seat)); how many of those seats are GUARANTEED full-context
// service is a policy decision, not a cache fact. NoOperationalReserve guarantees to the wall;
// ReserveBlocks holds an explicit block count back; ReserveFullLengthSeats holds back whole seats
// (the first production candidate, one seat, selects 7 of the 8 ceiling seats at 123 blocks per
// seat over the 1035-block inventory); ReserveBasisPoints holds back a share of the inventory.
type CacheReservePolicy
  = NoOperationalReserve
  | ReserveBlocks { blocks: AllocatorBlockCount }
  | ReserveFullLengthSeats { seats: Nat }
  | ReserveBasisPoints { basis_points: Nat }

// THE POLICY'S BLOCK RESERVE, evaluated against the plan's per-seat cost. Basis points ride Nat
// (0..=10000); a policy spelling outside that range is the malformed question the frontier fold's
// walls refuse, not something this projection clamps.
fn cache_reserve_blocks(policy: CacheReservePolicy, blocks_per_seat: AllocatorBlockCount, inventory: AllocatorBlockCount) -> AllocatorBlockCount {
  match policy {
    NoOperationalReserve => allocator_block_count(count: 0)
    ReserveBlocks { blocks: b } => b
    ReserveFullLengthSeats { seats: s } => allocator_block_count(count: s * allocator_block_count_value(c: blocks_per_seat))
    ReserveBasisPoints { basis_points: bp } => allocator_block_count(count: allocator_block_count_value(c: inventory) * bp / 10000)
  }
}

// THE PLAN FOLD. Order mirrors the layout fold: roster obligations, then supply obligations, then
// the malformed-question wall (zero seats names no admission), then the per-rank BLOCK decision —
// ranks in roster order, first refusal carries. The demand is the plan's own per-seat block
// figure times the seat count, and the only byte figure minted is block_equivalent_bytes from
// the v2 pool carve. PROVED carries the evidence-bound limiting rank, the policy's block reserve,
// the hard ceiling, and the demand's block-equivalent spelling; the reserve is a standing, not a
// refusal gate — the block wall alone decides capacity, and the reserve says how much of the
// inventory stands behind the proven seats (a reserve at or above the inventory simply leaves no
// guaranteed seats in the frontier fold's spelling). The length the verdict carries is the plan's
// requested length, the only length the plan vouches.
fn cache_fit_verdict_from_plan(
  plan: ResolvedKvAllocationPlan,
  shape: Glm53FlashHybridShape,
  seats: Nat,
  supplies: List<ArmRankCacheSupply>,
  rank_count: Nat,
  limiting_rank: Nat,
  reserve_policy: CacheReservePolicy,
) -> CacheFitVerdict {
  let roster_obligations = cache_plan_roster_obligations(plan: plan, shape: shape)
  let supply_obligations = cache_supply_obligations(supplies: supplies, rank_count: rank_count)
  let rank_obligations = match limiting_rank < rank_count {
    true => [] as List<NonEmptyStr>
    false => [join([
      "the named limiting rank ", to_string(limiting_rank), " is outside the ", to_string(rank_count),
      "-rank topology: the rank the evidence binds as limiting is part of the supply side, and a limiting rank the roster does not contain names no rank",
    ], "") as NonEmptyStr]
  }
  let obligations = concat(concat(roster_obligations, supply_obligations), rank_obligations)
  match length(obligations) > 0 {
    true => CacheFitUnestablished { obligations: obligations }
    false =>
      match seats == 0 {
        true => CacheFitUnestablished { obligations: ["zero seats name no admission: the cache question is how many full-length sequences the arm admits, and a seat population of zero prices nothing" as NonEmptyStr] }
        false => {
          let per_seat_blocks = fold(plan.groups, init: 0, f: (acc, g) => acc + allocator_block_count_value(c: g.blocks_at_requested_length))
          match per_seat_blocks == 0 {
            true => CacheFitUnestablished { obligations: ["the plan's groups sum to no blocks for a full-context request, so no admission cost can be priced from them" as NonEmptyStr] }
            false => {
              let per_seat = allocator_block_count(count: per_seat_blocks)
              let inventory = plan.allocator_blocks
              let demand_blocks = allocator_block_count(count: per_seat_blocks * seats)
              let block_equivalent = match kv_allocator_carve_from_plan(plan: plan) {
                Present { value: carve } =>
                  Present { value: request_block_equivalent_bytes(
                    demand: KvAdmissionDemand { population_blocks: demand_blocks },
                    carve: carve,
                  ) }
                Absent => none
              }
              match cache_fit_rank_scan(
                supplies: supplies,
                blocks_per_seat: per_seat,
                demand_blocks: demand_blocks,
                seats: seats,
                length: plan.requested_length,
              ) {
                Present { value: refused } => refused
                Absent => CacheFitProved {
                  limiting_rank: limiting_rank,
                  seats: seats,
                  length: plan.requested_length,
                  blocks_per_seat: per_seat,
                  blocks_used: demand_blocks,
                  blocks_reserved: cache_reserve_blocks(policy: reserve_policy, blocks_per_seat: per_seat, inventory: inventory),
                  hard_ceiling: allocator_block_count_value(c: inventory) / per_seat_blocks,
                  block_equivalent_bytes: block_equivalent,
                }
              }
            }
          }
        }
      }
  }
}

// ── THE REQUEST-COST AND ADMISSION VERDICTS: THE DOCTRINE'S THREE-PART BYTE/ BLOCK SPLIT ────────
//
// PoolConstructionProved (extdeps.vllm.kv_layout pool_construction_verdict) verifies the pool's
// CONSTRUCTION in bytes; RequestBlockCostProved and CacheAdmissionProved are the two block-side
// companions this module owns: the exact roster's per-request cost, and the promised population
// against the usable inventory. Together they spell the correction's rule — bytes verify pool
// construction, blocks mint capacity, and the two never stand in for each other.
type RequestBlockCostVerdict
  = RequestBlockCostProved { group_roster: List<KvAllocationPlanGroup>, blocks_per_request: AllocatorBlockCount }
  | RequestBlockCostRefused { cause: NonEmptyStr }

// THE EXACT ROSTER'S PER-REQUEST COST: the group rows the engine vouched for, and the sum of
// their blocks_at_requested_length — the KvAdmissionDemand of one full-context request. An empty
// roster prices no request (the census obligations refuse foreign rosters upstream in the fold).
fn request_block_cost(plan: ResolvedKvAllocationPlan) -> RequestBlockCostVerdict {
  let blocks = fold(plan.groups, init: 0, f: (acc, g) => acc + allocator_block_count_value(c: g.blocks_at_requested_length))
  match blocks == 0 {
    true => RequestBlockCostRefused { cause: "the plan's groups sum to no blocks for a full-context request, so no request block cost can be priced from them" as NonEmptyStr }
    false => RequestBlockCostProved {
      group_roster: plan.groups,
      blocks_per_request: allocator_block_count(count: blocks),
    }
  }
}

type CacheAdmissionVerdict
  = CacheAdmissionProved { request_blocks: AllocatorBlockCount, usable_allocator_blocks: AllocatorBlockCount }
  | CacheAdmissionRefused { request_blocks: AllocatorBlockCount, usable_allocator_blocks: AllocatorBlockCount, cause: NonEmptyStr }

// THE POPULATION AGAINST THE USABLE INVENTORY: usable = inventory − the policy's reserve
// (saturating — a reserve at or above the inventory leaves zero usable blocks, and the admission
// refuses there rather than wrapping). This is the per-question form of the frontier fold's rung
// decision, for callers that ask about one population rather than the whole ladder.
fn cache_admission_verdict(population_blocks: AllocatorBlockCount, inventory: AllocatorBlockCount, reserve_blocks: AllocatorBlockCount) -> CacheAdmissionVerdict {
  let usable = match allocator_block_count_value(c: reserve_blocks) >= allocator_block_count_value(c: inventory) {
    true => allocator_block_count(count: 0)
    false => allocator_block_count(count: allocator_block_count_value(c: inventory) - allocator_block_count_value(c: reserve_blocks))
  }
  match allocator_block_count_value(c: population_blocks) <= allocator_block_count_value(c: usable) {
    true => CacheAdmissionProved { request_blocks: population_blocks, usable_allocator_blocks: usable }
    false =>
      CacheAdmissionRefused {
        request_blocks: population_blocks,
        usable_allocator_blocks: usable,
        cause: join([
          "cache admission REFUSED: the promised population requires ", to_string(allocator_block_count_value(c: population_blocks)),
          " shared-pool blocks, which exceeds the usable inventory of ", to_string(allocator_block_count_value(c: usable)),
          " blocks after the reserve policy holds ", to_string(allocator_block_count_value(c: reserve_blocks)), " back",
        ], "") as NonEmptyStr,
      }
  }
}

// ── THE POOL-CONSTRUCTION CONTROLS PER RANK, AND THE CONSERVATION RED ────────────────────────────
//
// THE TWO REMAINING CONSTRUCTION CONTROLS the doctrine lists beside the mint-level conservation
// (allocated_pool_bytes == allocator_blocks x physical_pool_bytes_per_block, which the plan mint's
// conservation wall checks): allocated_pool_bytes <= EVERY rank's admitted KV arena, and the arena
// slack under one physical block — MODULO NAMED RESERVATIONS/ROUNDING, which the caller spells as
// an explicit byte allowance with its reason (the block override, the null-block reservation, the
// profile reporter's rounding unit), because an unnamed fudge factor would be a license to mint
// anything. A reading that is not THIS pool's arena fails the second control loudly: today's
// per-rank profile figures are the workers' pre-clamp local pool projections, not the min-clamped
// 1035-block allocation's arena, so claiming construction against them refuses rather than
// agreeing by accident.
fn pool_construction_per_rank(carve: KvAllocatorCarve, supplies: List<ArmRankCacheSupply>, allowance_bytes: ByteSize, allowance_reason: NonEmptyStr) -> PoolConstructionVerdict {
  match pool_construction_rank_scan(carve: carve, supplies: supplies, allowance_bytes: allowance_bytes, allowance_reason: allowance_reason) {
    Present { value: refused } => refused
    Absent =>
      PoolConstructionProved {
        physical_pool_block_bytes: carve.physical_pool_bytes_per_block,
        allocator_blocks: carve.allocator_blocks,
        allocated_pool_bytes: carve.allocated_pool_bytes,
      }
  }
}

fn pool_construction_rank_scan(carve: KvAllocatorCarve, supplies: List<ArmRankCacheSupply>, allowance_bytes: ByteSize, allowance_reason: NonEmptyStr) -> PoolConstructionVerdict? {
  first(map(filter(supplies, s =>
      byte_size_count(b: s.admitted_kv_arena_bytes) == 0
        || byte_size_count(b: carve.allocated_pool_bytes) > byte_size_count(b: s.admitted_kv_arena_bytes) + byte_size_count(b: allowance_bytes)
        || byte_size_count(b: s.admitted_kv_arena_bytes) >= byte_size_count(b: carve.allocated_pool_bytes) + byte_size_count(b: carve.physical_pool_bytes_per_block) + byte_size_count(b: allowance_bytes)), s =>
    match byte_size_count(b: s.admitted_kv_arena_bytes) == 0 {
      true =>
        PoolConstructionRefused {
          cause: join([
            "pool construction REFUSED at rank ", to_string(s.rank), ": the rank's arena observation is zero, and a zero reading bounds nothing — construction cannot be verified there",
          ], "") as NonEmptyStr,
        }
      false =>
        match byte_size_count(b: carve.allocated_pool_bytes) > byte_size_count(b: s.admitted_kv_arena_bytes) + byte_size_count(b: allowance_bytes) {
          true =>
            PoolConstructionRefused {
              cause: join([
                "pool construction REFUSED at rank ", to_string(s.rank), ": the allocated pool of ", to_string(byte_size_count(b: carve.allocated_pool_bytes)),
                " bytes exceeds the rank's admitted KV arena of ", to_string(byte_size_count(b: s.admitted_kv_arena_bytes)),
                " bytes even after the named allowance of ", to_string(byte_size_count(b: allowance_bytes)),
                " bytes (", allowance_reason as String, ")",
              ], "") as NonEmptyStr,
            }
          false =>
            PoolConstructionRefused {
              cause: join([
                "pool construction REFUSED at rank ", to_string(s.rank), ": the arena exceeds the allocated pool by ",
                to_string(byte_size_count(b: s.admitted_kv_arena_bytes) - byte_size_count(b: carve.allocated_pool_bytes)),
                " bytes, more than one physical pool block (", to_string(byte_size_count(b: carve.physical_pool_bytes_per_block)),
                " bytes) beyond the named allowance of ", to_string(byte_size_count(b: allowance_bytes)),
                " bytes (", allowance_reason as String,
                "): the reading is not the admitted arena of THIS pool",
              ], "") as NonEmptyStr,
            }
        }
    }))
}

// ── THE SLACK STANDING: THE CONSTRUCTION CONTROL'S TWO HALVES, REPORTED SEPARATELY ───────────────
//
// pool_construction_per_rank above mints ONE verdict and refuses when either half fails — the
// doctrine's conservation sentence as a single gate. THE 2026-09-26 V2 EVIDENCE PASSES ONE HALF
// AND FAILS THE OTHER, and a two-arm vocabulary cannot say that honestly: the allocated pool
// (13,766,049,792 bytes over 1012 blocks of 13,602,816) is admitted at EVERY rank's arena — the
// <= half PASSES on all four ranks — while the limiting rank's arena exceeds the pool by ~3.81 GB,
// ~280 physical blocks, where the doctrine's tight-construction shape asks for under one block. A
// single Refused would falsely read as "the pool does not fit"; a single Proved is exactly the
// papering-over the arena-slack control exists to refuse. So this fold reports the two halves
// apart: WHICH RANK LIMITS (the least arena slack, the same min-across-ranks spirit the engine's
// inventory decision embodies), the slack in bytes and in physical pool blocks, and — when the
// slack exceeds one physical block plus the caller's NAMED allowance — an Unestablished arm
// carrying the slack figure and the caller-named CANDIDATE mechanism (a candidate, never an
// established one: the day a mechanism is pinned against the engine source, the caller names it as
// an allowance with its reason and the tight half closes that way instead). THE EXISTING CONTROL
// IS NOT WEAKENED BY THIS FOLD: it still refuses the same evidence, and the suite pins both
// answers side by side.
type PoolConstructionSlackStanding
  = PoolConstructionSlackProved {
      physical_pool_block_bytes: ByteSize
      allocator_blocks: AllocatorBlockCount
      allocated_pool_bytes: ByteSize
      limiting_rank: Nat
      limiting_rank_arena_bytes: ByteSize
      slack_bytes: ByteSize
    }
  | PoolConstructionSlackUnestablished {
      physical_pool_block_bytes: ByteSize
      allocator_blocks: AllocatorBlockCount
      allocated_pool_bytes: ByteSize
      limiting_rank: Nat
      limiting_rank_arena_bytes: ByteSize
      slack_bytes: ByteSize
      slack_physical_pool_blocks: Nat
      candidate_mechanism: NonEmptyStr
      obligation: NonEmptyStr
    }
  | PoolConstructionSlackRefused { cause: NonEmptyStr }

fn pool_construction_slack_standing(carve: KvAllocatorCarve, supplies: List<ArmRankCacheSupply>, allowance_bytes: ByteSize, allowance_reason: NonEmptyStr, candidate_mechanism: NonEmptyStr) -> PoolConstructionSlackStanding {
  match pool_construction_slack_refusal_scan(carve: carve, supplies: supplies, allowance_bytes: allowance_bytes, allowance_reason: allowance_reason) {
    Present { value: refused } => refused
    Absent =>
      match pool_construction_min_slack_supply(carve: carve, supplies: supplies) {
        Absent =>
          PoolConstructionSlackRefused { cause: "unreachable: a supply roster that passed the fit scan has a first rank" as NonEmptyStr }
        Present { value: worst } =>
          let slack = subtract_saturating(minuend: worst.admitted_kv_arena_bytes, subtrahend: carve.allocated_pool_bytes)
          match byte_size_count(b: slack) < byte_size_count(b: carve.physical_pool_bytes_per_block) + byte_size_count(b: allowance_bytes) {
            true =>
              PoolConstructionSlackProved {
                physical_pool_block_bytes: carve.physical_pool_bytes_per_block,
                allocator_blocks: carve.allocator_blocks,
                allocated_pool_bytes: carve.allocated_pool_bytes,
                limiting_rank: worst.rank,
                limiting_rank_arena_bytes: worst.admitted_kv_arena_bytes,
                slack_bytes: slack,
              }
            false =>
              PoolConstructionSlackUnestablished {
                physical_pool_block_bytes: carve.physical_pool_bytes_per_block,
                allocator_blocks: carve.allocator_blocks,
                allocated_pool_bytes: carve.allocated_pool_bytes,
                limiting_rank: worst.rank,
                limiting_rank_arena_bytes: worst.admitted_kv_arena_bytes,
                slack_bytes: slack,
                slack_physical_pool_blocks: byte_size_count(b: slack) / byte_size_count(b: carve.physical_pool_bytes_per_block),
                candidate_mechanism: candidate_mechanism,
                obligation: join([
                  "the fit half is PROVED -- the allocated pool of ", to_string(byte_size_count(b: carve.allocated_pool_bytes)),
                  " bytes is admitted at every rank's admitted KV arena -- but the tight-construction half is UNESTABLISHED: the limiting rank's arena exceeds the allocated pool by ",
                  to_string(byte_size_count(b: slack)), " bytes (", to_string(byte_size_count(b: slack) / byte_size_count(b: carve.physical_pool_bytes_per_block)),
                  " physical pool blocks of ", to_string(byte_size_count(b: carve.physical_pool_bytes_per_block)),
                  " bytes), far more than one physical block plus the named allowance of ", to_string(byte_size_count(b: allowance_bytes)),
                  " bytes (", allowance_reason as String,
                  "): name the mechanism that admits the slack -- candidate, NOT established: ", candidate_mechanism as String,
                  " -- or derive a bound for it; until one lands, no consumer may read this pool as exactly filling its limiting rank's arena",
                ], "") as NonEmptyStr,
              }
          }
      }
  }
}

// THE FIT HALF'S REFUSAL SCAN, the existing control's two causes carried verbatim: a zero arena
// bounds nothing, and an allocated pool above the arena plus the named allowance does not fit —
// the <= half failed, and no slack question arises.
fn pool_construction_slack_refusal_scan(carve: KvAllocatorCarve, supplies: List<ArmRankCacheSupply>, allowance_bytes: ByteSize, allowance_reason: NonEmptyStr) -> PoolConstructionSlackStanding? {
  first(map(filter(supplies, s =>
      byte_size_count(b: s.admitted_kv_arena_bytes) == 0
        || byte_size_count(b: carve.allocated_pool_bytes) > byte_size_count(b: s.admitted_kv_arena_bytes) + byte_size_count(b: allowance_bytes)), s =>
    match byte_size_count(b: s.admitted_kv_arena_bytes) == 0 {
      true =>
        PoolConstructionSlackRefused {
          cause: join([
            "pool construction REFUSED at rank ", to_string(s.rank), ": the rank's arena observation is zero, and a zero reading bounds nothing -- construction cannot be verified there",
          ], "") as NonEmptyStr,
        }
      false =>
        PoolConstructionSlackRefused {
          cause: join([
            "pool construction REFUSED at rank ", to_string(s.rank), ": the allocated pool of ", to_string(byte_size_count(b: carve.allocated_pool_bytes)),
            " bytes exceeds the rank's admitted KV arena of ", to_string(byte_size_count(b: s.admitted_kv_arena_bytes)),
            " bytes even after the named allowance of ", to_string(byte_size_count(b: allowance_bytes)),
            " bytes (", allowance_reason as String, "): the fit half fails at this rank",
          ], "") as NonEmptyStr,
        }
    }))
}

// THE LIMITING RANK OF THE SLACK QUESTION: the supply row whose arena leaves the least over the
// allocated pool — the tightest reading, the rank whose arena the pool most nearly fills. Saturating
// subtraction keeps the comparison total even where a named allowance let a slightly-smaller arena
// through the fit scan.
fn pool_construction_slack_of(carve: KvAllocatorCarve, s: ArmRankCacheSupply) -> ByteSize {
  subtract_saturating(minuend: s.admitted_kv_arena_bytes, subtrahend: carve.allocated_pool_bytes)
}

fn pool_construction_min_slack_supply(carve: KvAllocatorCarve, supplies: List<ArmRankCacheSupply>) -> ArmRankCacheSupply? {
  fold(supplies, init: first(supplies), f: (acc, s) => match acc {
    Absent => Present { value: s }
    Present { value: a } =>
      match byte_size_count(b: pool_construction_slack_of(carve: carve, s: s)) < byte_size_count(b: pool_construction_slack_of(carve: carve, s: a)) {
        true => Present { value: s }
        false => acc
      }
  })
}

// THE VERDICT BESIDE THE CONSTRUCTION STANDING: a capacity question that prices this plan against
// these arenas takes home both facts in one join — the cache verdict the block wall mints, and the
// pool-construction standing the byte conservation reports — so a Proved cache beside an
// Unestablished tight-construction travels as exactly that, never as a silently completed
// construction.
type CacheFitWithPoolConstruction {
  cache_verdict: CacheFitVerdict
  pool_construction: PoolConstructionSlackStanding
}

fn cache_fit_with_pool_construction(
  plan: ResolvedKvAllocationPlan,
  shape: Glm53FlashHybridShape,
  seats: Nat,
  supplies: List<ArmRankCacheSupply>,
  rank_count: Nat,
  limiting_rank: Nat,
  reserve_policy: CacheReservePolicy,
  carve: KvAllocatorCarve,
  allowance_bytes: ByteSize,
  allowance_reason: NonEmptyStr,
  candidate_mechanism: NonEmptyStr,
) -> CacheFitWithPoolConstruction {
  CacheFitWithPoolConstruction {
    cache_verdict: cache_fit_verdict_from_plan(
      plan: plan, shape: shape, seats: seats, supplies: supplies,
      rank_count: rank_count, limiting_rank: limiting_rank, reserve_policy: reserve_policy),
    pool_construction: pool_construction_slack_standing(
      carve: carve, supplies: supplies, allowance_bytes: allowance_bytes,
      allowance_reason: allowance_reason, candidate_mechanism: candidate_mechanism),
  }
}


// THE CONSERVATION RED: ONE CLAIM, CHECKED AGAINST THE POOL IT CLAIMS TO SIT IN. The block wall
// owns capacity; this control owns the byte claims a consumer tries to attach to a block
// population. The exact byte spelling of a block population against this pool is
// block_equivalent_bytes = request_blocks x physical_pool_bytes_per_block; a claim below it is
// underpricing the shared pool (reading group-spec page bytes as pool block bytes — the withdrawn
// move), and a claim below one percent of the SAME pool's allocated bytes is the doctrine's RED
// sentence verbatim: N blocks of a pool cannot occupy less than 1% of that pool, because
// allocated_pool_bytes is exactly allocator_blocks x physical_pool_bytes_per_block and N blocks
// is at least N / allocator_blocks of the product. The withdrawn 125,010,432-byte figure for the
// 262144x6 population (738 blocks) is the pinned failing case: it must mint Refused here, never
// anything a capacity question could read as proved.
type SharedPoolByteClaimVerdict
  = SharedPoolByteClaimConsistent { request_blocks: AllocatorBlockCount, block_equivalent_bytes: ByteSize }
  | SharedPoolByteClaimRefused { cause: NonEmptyStr }

fn shared_pool_byte_claim_red(plan: ResolvedKvAllocationPlan, request_blocks: AllocatorBlockCount, claimed_block_equivalent_bytes: ByteSize) -> SharedPoolByteClaimVerdict {
  match kv_allocator_carve_from_plan(plan: plan) {
    Absent =>
      SharedPoolByteClaimRefused {
        cause: "the plan carries no physical_pool_bytes_per_block or allocated_pool_bytes (the v1 emission vintage), so no byte claim is checkable against its pool: the v1 vintage proves blocks only, and a byte figure beside it rides unpriced" as NonEmptyStr,
      }
    Present { value: carve } => {
      let exact = request_block_equivalent_bytes(demand: KvAdmissionDemand { population_blocks: request_blocks }, carve: carve)
      match byte_size_count(b: claimed_block_equivalent_bytes) == byte_size_count(b: exact) {
        true => SharedPoolByteClaimConsistent { request_blocks: request_blocks, block_equivalent_bytes: exact }
        false =>
          match byte_size_count(b: claimed_block_equivalent_bytes) < byte_size_count(b: exact) {
            true =>
              match byte_size_count(b: claimed_block_equivalent_bytes) * 100 < byte_size_count(b: carve.allocated_pool_bytes) {
                true =>
                  SharedPoolByteClaimRefused {
                    cause: join([
                      "shared-pool byte claim REFUSED: ", to_string(allocator_block_count_value(c: request_blocks)),
                      " blocks cannot occupy less than 1% of the same pool — the pool allocates ",
                      to_string(byte_size_count(b: carve.allocated_pool_bytes)), " bytes (", to_string(allocator_block_count_value(c: carve.allocator_blocks)),
                      " blocks x ", to_string(byte_size_count(b: carve.physical_pool_bytes_per_block)),
                      " bytes), so the block-equivalent spelling of the population is ", to_string(byte_size_count(b: exact)),
                      " bytes, while the claim reads ", to_string(byte_size_count(b: claimed_block_equivalent_bytes)),
                      " bytes: the claim prices group-spec page bytes as pool block bytes, the withdrawn ~106x underpricing, and it can never mint anything a capacity question reads as proved",
                    ], "") as NonEmptyStr,
                  }
                false =>
                  SharedPoolByteClaimRefused {
                    cause: join([
                      "shared-pool byte claim REFUSED: the claim reads ", to_string(byte_size_count(b: claimed_block_equivalent_bytes)),
                      " bytes for ", to_string(allocator_block_count_value(c: request_blocks)),
                      " blocks, under the block-equivalent figure of ", to_string(byte_size_count(b: exact)),
                      " bytes (blocks x the physical pool block size): a demand's byte spelling must price the shared pool's block, not the group spec's page",
                    ], "") as NonEmptyStr,
                  }
              }
            false =>
              SharedPoolByteClaimRefused {
                cause: join([
                  "shared-pool byte claim REFUSED: the claim reads ", to_string(byte_size_count(b: claimed_block_equivalent_bytes)),
                  " bytes for ", to_string(allocator_block_count_value(c: request_blocks)),
                  " blocks, over the block-equivalent figure of ", to_string(byte_size_count(b: exact)),
                  " bytes (blocks x the physical pool block size): an inflated byte figure beside a block population is not evidence of more capacity",
                ], "") as NonEmptyStr,
              }
          }
      }
    }
  }
}


// THE WITHDRAWN MOVE, CARRIED AS A NAMED CANDIDATE. floor(printed_pool_tokens / context) is how the
// six-seat figure arrived; it is a full-context-equivalent projection divided by a context, not a
// fold over the roster, and NO function consumes this candidate into any verdict -- the only way
// to hold it is as what it is. The standing string says so wherever the candidate travels.
type CacheCapacityCandidate {
  printed_pool_tokens: TokenCount
  division_length: TokenCount
  seats_by_division: Nat
  standing: NonEmptyStr
}

fn cache_capacity_candidate(printed_pool_tokens: TokenCount, division_length: TokenCount) -> CacheCapacityCandidate? {
  match token_count_value(t: division_length) == 0 {
    true => none
    false =>
      Present { value: CacheCapacityCandidate {
        printed_pool_tokens: printed_pool_tokens,
        division_length: division_length,
        seats_by_division: token_count_value(t: printed_pool_tokens) / token_count_value(t: division_length),
        standing: "CacheCapacityCandidate: floor of the printed full-context-equivalent token figure divided by a context length -- a sizing hint, never a proof; the cache subproof decides only by the direct roster fold" as NonEmptyStr,
      } }
  }
}

// ── THE WHOLE-ARM STANDING ───────────────────────────────────────────────────────────────────────
//
// THE WHOLE VERDICT IS THE CONJUNCTION OF SUBPROOFS (docs/plans/moa-memory-modeling.md):
// StaticResidencyFit, CacheCapacityFit, PrefillTransientFit, DecodeTransientFit, LoadTransientFit,
// SupplyReserveFit. FitProved only when every applicable rank x phase proves. The standing below
// carries the arm verdict and the cache subproof verdict side by side and names every open
// obligation with its subproof, which is the honest current state: a proved cache with an open
// prefill transient is CacheFitProved beside ArmMemoryFitUnestablished, never a whole-arm fit.
fn cache_verdict_obligations(v: CacheFitVerdict) -> List<NonEmptyStr> {
  match v {
    CacheFitProved { limiting_rank: _, seats: _, length: _, blocks_per_seat: _, blocks_used: _, blocks_reserved: _, hard_ceiling: _, block_equivalent_bytes: _ } => [] as List<NonEmptyStr>
    CacheFitRefused { limiting_rank: _, seats: _, length: _, blocks_per_seat: _, blocks_used: _, supply_allocator_blocks: _, cause: c } => [c]
    CacheFitUnestablished { obligations: os } => os
  }
}

fn arm_verdict_obligations(v: ArmMemoryFitVerdict) -> List<NonEmptyStr> {
  match v {
    ArmMemoryFitProved { rank: _, phase: _, headroom_bytes: _ } => [] as List<NonEmptyStr>
    ArmMemoryFitRefused { rank: _, phase: _, demand_lower: _, supply_upper: _, cause: c } => [c]
    ArmMemoryFitUnestablished { obligations: os } => os
  }
}

// THE SPARSE-INDEXER PREFILL BUFFER, as a CANDIDATE: the owner directive cites the upstream formula
// (40 index entries per model token, 132 bytes per entry -- the 128-dim FP8 vector plus its scale,
// ~1.29 GiB per applicable rank at 262144 tokens). THE CITATION IS NOT YET THE PINNED SOURCE: the
// formula awaits being read in the deployed engine revision (vllm@8d09804c8) before it discharges
// anything, and until then the prefill transient term is open with this candidate carried beside
// the obligation. WHICH RANKS the buffer lands on (the sparse layers' TP shard) is part of what
// the pinned-source read owes.
fn sparse_indexer_prefill_buffer_candidate(length: TokenCount) -> ByteSize {
  byte_size(count: 40 * 132 * token_count_value(t: length))
}

fn arm_prefill_transient_obligation(length: TokenCount) -> NonEmptyStr {
  join([
    "prefill-transient-fit is unestablished at ", to_string(token_count_value(t: length)),
    " tokens: the sparse-indexer prefill buffer (owner-directive formula 40 entries per model token x 132 bytes = ",
    to_string(byte_size_count(b: sparse_indexer_prefill_buffer_candidate(length: length))),
    " bytes per applicable rank) is cited from docs/plans/moa-memory-modeling.md and awaits citation against the pinned runtime source (vllm@8d09804c8) before it bounds anything; the applicable-rank population is open with it",
  ], "") as NonEmptyStr
}

type ArmMemoryWholeStanding {
  cache_verdict: CacheFitVerdict
  arm_verdict: ArmMemoryFitVerdict
  open_obligations: List<NonEmptyStr>
}

// THE STANDING ASSEMBLY: both verdicts, and the open obligations named with their subproof --
// cache obligations as they stand, arm obligations as they stand, and the prefill transient
// obligation the arm verdict does not yet price (it names the subproof the directive adds to the
// conjunction).
fn arm_memory_fit_whole_standing(cache: CacheFitVerdict, arm: ArmMemoryFitVerdict, subject_length: TokenCount) -> ArmMemoryWholeStanding {
  ArmMemoryWholeStanding {
    cache_verdict: cache,
    arm_verdict: arm,
    open_obligations: concat(
      map(cache_verdict_obligations(v: cache), o => join(["cache-capacity-fit: ", o as String], "") as NonEmptyStr),
      concat(
        map(arm_verdict_obligations(v: arm), o => join(["arm-memory-fit: ", o as String], "") as NonEmptyStr),
        [arm_prefill_transient_obligation(length: subject_length)])),
  }
}

data arm_memory_fit_receipt_join_frontier: DissolutionCondition = unbound_dissolution(description: "DISCHARGED 2026-09-24: the typed receipt join (ArmComponentReceipt, arm_memory_fit_subject_with_receipts) replaced the wire-containment provenance check with a construction-level join -- receipts name their term by (rank, component) and the measurement contract governs discharge. WHAT REMAINS: the receipt TEXT still carries the identity wires for provenance; the typed identity ride-along (a receipt record carrying checkpoint/runtime/topology as fields, compared by equality) is the remaining rung, landed when the bounded-experiment observer's capture leg mints receipts from live captures instead of witness fixtures. THE MoA RUNG (owner directive 2026-09-25): MemoryProofSubject and the MemoryTerm census bind every term to the seven-axis subject, and the wet-receipt admission (arm_admit_wet_binding) enforces the receipt-subject compatibility law -- the typed identity ride-along lands with the same observer work, at which point the measured_on wires become subject equality rather than containment." as NonEmptyStr)

// ── THE CACHE FRONTIER: ONE FOLD, THE WHOLE SEAT LADDER ──────────────────────────────────────────
//
// THE FRONTIER IS THE DELIVERABLE'S SHAPE, not only a verdict (docs/plans/shared-pool-byte-
// correction.md): one fold evaluates the seat ladder at the plan's requested length and returns
// every rung — the doctrine's table, computed. Rungs prove at the BLOCK WALL against the raw
// inventory (a rung is a capacity fact), while the reserve policy selects the GUARANTEED seat
// count below the ceiling (a service standing): hard ceiling = floor(inventory / blocks_per_seat)
// is a property of the inventory alone; guaranteed seats = the most seats the inventory admits
// with the policy's reserve held back. Eight of 1035/123 is therefore provable at the wall AND not
// guaranteed under ReserveFullLengthSeats{1} at once — the ceiling is burst/cache-only capacity,
// and no rung's proof is a promise of persistent service (the whole-arm standing keeps that gate).
type CacheFrontierRung
  = CacheFrontierRungProved { seats: Nat, blocks_used: AllocatorBlockCount, blocks_left: AllocatorBlockCount }
  | CacheFrontierRungRefused { seats: Nat, blocks_used: AllocatorBlockCount, cause: NonEmptyStr }

type CacheFrontierVerdict
  = CacheFrontier {
      limiting_rank: Nat
      length: TokenCount
      blocks_per_seat: AllocatorBlockCount
      inventory: AllocatorBlockCount
      hard_ceiling: Nat
      reserve_policy: CacheReservePolicy
      blocks_reserved: AllocatorBlockCount
      guaranteed_seats: Nat
      rungs: List<CacheFrontierRung>
      block_equivalent_bytes_per_seat: ByteSize?
    }
  | CacheFrontierUnestablished { obligations: List<NonEmptyStr> }

// THE LADDER'S RUNGS: the ceiling's two seats below through the first seat above it — the
// doctrine's table row count, derived from the inventory alone (clipped at one seat for tiny
// inventories, where the ladder degenerates rather than pricing negative seats).
fn cache_frontier_rung_seats(hard_ceiling: Nat) -> List<Nat> {
  let lo = match hard_ceiling > 2 {
    true => hard_ceiling - 2
    false => 1
  }
  nat_range_inclusive(lo: lo, hi: hard_ceiling + 1)
}

fn cache_frontier_from_plan(
  plan: ResolvedKvAllocationPlan,
  shape: Glm53FlashHybridShape,
  supplies: List<ArmRankCacheSupply>,
  rank_count: Nat,
  limiting_rank: Nat,
  reserve_policy: CacheReservePolicy,
) -> CacheFrontierVerdict {
  let roster_obligations = cache_plan_roster_obligations(plan: plan, shape: shape)
  let supply_obligations = cache_supply_obligations(supplies: supplies, rank_count: rank_count)
  let rank_obligations = match limiting_rank < rank_count {
    true => [] as List<NonEmptyStr>
    false => [join([
      "the named limiting rank ", to_string(limiting_rank), " is outside the ", to_string(rank_count),
      "-rank topology: the rank the evidence binds as limiting is part of the supply side, and a limiting rank the roster does not contain names no rank",
    ], "") as NonEmptyStr]
  }
  let obligations = concat(concat(roster_obligations, supply_obligations), rank_obligations)
  match length(obligations) > 0 {
    true => CacheFrontierUnestablished { obligations: obligations }
    false => {
      let per_seat_blocks = fold(plan.groups, init: 0, f: (acc, g) => acc + allocator_block_count_value(c: g.blocks_at_requested_length))
      match per_seat_blocks == 0 {
        true => CacheFrontierUnestablished { obligations: ["the plan's groups sum to no blocks for a full-context request, so the seat ladder prices no rungs" as NonEmptyStr] }
        false => {
          let per_seat = allocator_block_count(count: per_seat_blocks)
          let inventory = plan.allocator_blocks
          let hard_ceiling = allocator_block_count_value(c: inventory) / per_seat_blocks
          let reserve = cache_reserve_blocks(policy: reserve_policy, blocks_per_seat: per_seat, inventory: inventory)
          let guaranteed = match allocator_block_count_value(c: reserve) >= allocator_block_count_value(c: inventory) {
            true => 0
            false => (allocator_block_count_value(c: inventory) - allocator_block_count_value(c: reserve)) / per_seat_blocks
          }
          CacheFrontier {
            limiting_rank: limiting_rank,
            length: plan.requested_length,
            blocks_per_seat: per_seat,
            inventory: inventory,
            hard_ceiling: hard_ceiling,
            reserve_policy: reserve_policy,
            blocks_reserved: reserve,
            guaranteed_seats: guaranteed,
            rungs: map(cache_frontier_rung_seats(hard_ceiling: hard_ceiling), s => {
              let used = per_seat_blocks * s
              match used <= allocator_block_count_value(c: inventory) {
                true => CacheFrontierRungProved {
                  seats: s,
                  blocks_used: allocator_block_count(count: used),
                  blocks_left: allocator_block_count(count: allocator_block_count_value(c: inventory) - used),
                }
                false =>
                  CacheFrontierRungRefused {
                    seats: s,
                    blocks_used: allocator_block_count(count: used),
                    cause: join([
                      "cache frontier rung REFUSED at ", to_string(s), " seats: the population requires ",
                      to_string(used), " shared-pool blocks, which exceeds the inventory of ",
                      to_string(allocator_block_count_value(c: inventory)), " blocks — the block wall is the capacity authority, and the first seat past the ceiling has no spelling",
                    ], "") as NonEmptyStr,
                  }
              }
            }),
            block_equivalent_bytes_per_seat: match kv_allocator_carve_from_plan(plan: plan) {
              Present { value: carve } =>
                Present { value: request_block_equivalent_bytes(
                  demand: KvAdmissionDemand { population_blocks: per_seat },
                  carve: carve,
                ) }
              Absent => none
            },
          }
        }
      }
    }
  }
}
