module gunbc.spark.serving_desired


data spark_serving_desired_hosts: std.types.List<product.placement_supply.HostIdentity> = [
  operator_host_srv5,
  operator_host_srv6,
]

data spark_serving_desired_note: String = "OPERATOR DECLARATION (2026-08-12): LAN boundary, ollama runtime, gpt-oss:20b model, executor-owned serving process under gunbc-automation. Runtime closure identity derives from extdeps.ollama.binary_release cited digest — materialization binds through gunbc.package_delivery (#8225), not a parallel install path. Model identity is the manifest digest from /api/tags, not the serving label."

data spark_serving_configuration_digest_note: String = "ServingConfigurationIdentity.configuration_digest is derived by spark_serving_configuration_identity from typed policy fields — never authored as a parallel literal."

data spark_serving_desired_runtime: gunbc.spark.serving_release.SparkServingRuntimeKind = gunbc.spark.serving_release.OllamaRuntime {}

data spark_serving_desired_bind_listen: gunbc.spark.serving_release.SparkServingBindListen = gunbc.spark.serving_release.SparkServingBindListen {
  host: "0.0.0.0" as std.types.NonEmptyStr,
  port: ollama_default_port,
}

fn spark_serving_desired_bind_host_port() -> String {
  spark_serving_bind_listen_wire(bind: spark_serving_desired_bind_listen)
}

// A LISTEN ADDRESS IS NOT A CONNECT ADDRESS, and the two were one string.
//
// The unit binds `0.0.0.0` because the endpoint is meant to be reachable across the LAN. Nothing
// CONNECTS to `0.0.0.0`: it names "every local interface" to a listener, and a probe that dialled it
// would be relying on a kernel convenience that says nothing about whether the intended interface is
// serving. The on-host readiness probe therefore dials loopback on the same port -- same service,
// stated as the address a client actually uses -- and the port is taken from the one bind row so the
// two cannot drift into naming different services.
data spark_serving_local_probe_host: std.types.NonEmptyStr = "127.0.0.1" as std.types.NonEmptyStr

fn spark_serving_local_probe_host_port() -> String {
  join([spark_serving_local_probe_host as String, ":", to_string(spark_serving_desired_bind_listen.port)], "")
}

// The path comes from `extdeps.ollama.api` `ollama_endpoint_path`, not from a literal here. Writing
// "/api/version" would be a second spelling of a fact the cited endpoint model already owns, and the
// two would drift silently the first time upstream moved it.
fn spark_serving_local_endpoint_url(endpoint: extdeps.ollama.api.OllamaEndpoint) -> String {
  join(["http://", spark_serving_local_probe_host_port(), ollama_endpoint_path(endpoint: endpoint)], "")
}

fn spark_serving_local_api_version_url() -> String {
  spark_serving_local_endpoint_url(endpoint: extdeps.ollama.api.ApiVersion)
}

data spark_serving_desired_endpoint_intent: gunbc.spark.serving_realization.ServingEndpointIntent = UnauthenticatedEndpoint

data spark_serving_desired_model_ref: extdeps.ollama.api.OllamaModelRef = ollama_gpt_oss_20b_model_ref

// DESIRED MODEL IDENTITY IS A RESOLUTION, NOT A LITERAL.
//
// What this row used to be: a Sha256Digest typed in here, wrapped in an OllamaModelDigest, and handed
// to model_artifact_from_observed_digest -- a door whose authority says the digest came off an
// endpoint. Nothing had observed it. The literal was 49124fc2c62223..., correct when authored on
// 2026-08-12 and wrong from the moment upstream republished the tag.
//
// WHAT THE REPUBLISH DID, since the failure was read as host drift for a week. On 2026-08-19 the
// registry, srv6's manifest file, and srv6's /api/tags all answered 17052f91a42e97... The pin
// disagreed with all three, so the model member reconciled as drift on every pass and planned a pull
// forever -- and the pull could not have fixed it, because MaterializeModelArtifact runs
// `ollama pull gpt-oss:20b` and fetches whatever the tag names NOW. A digest pin behind a
// tag-addressed remedy is unenforceable by construction.
//
// THE RE-SELECTION IS AN OPERATOR DECISION AND IT WAS TAKEN (2026-08-19): desired state now names the
// identity the reference currently resolves to. That is not "follow latest at apply" -- execution
// still names one exact identity and never consults upstream to find it. It is an authored change of
// desired state whose result happens already to exist on srv6, so reconciliation should plan zero
// model action rather than a pull.
//
// The evidence, the superseded 2026-08-12 identity, and the resolution timestamp live in
// gunbc.ollama_model_resolution, whose carrier cannot be constructed without its evidence. This
// module consumes that resolution; it no longer manufactures an identity of its own.

type SparkServingDesiredAdmission
  = SparkServingDesiredAdmitted { serving_release: gunbc.spark.serving_release.SparkServingRelease }
  | SparkServingDesiredRefused { cause: std.types.NonEmptyStr }

fn spark_serving_desired_model_artifact() -> gunbc.model_artifact.ModelArtifact {
  model_artifact_from_resolution(
    publisher: "ollama" as std.types.NonEmptyStr,
    resolution: gpt_oss_20b_resolution(),
  )
}

fn spark_serving_desired_release_admission() -> SparkServingDesiredAdmission {
  match ollama_runtime_model_compatibility_verdict(
    binary_release: ollama_required_release,
    platform: OllamaNvidiaGb10Spark,
    architecture: OllamaLinuxArm64,
    model: spark_serving_desired_model_ref,
  ) {
    extdeps.ollama.capability.OllamaPlatformSupportApplicable =>
      SparkServingDesiredAdmitted {
        serving_release: gunbc.spark.serving_release.SparkServingRelease {
          runtime: gunbc.spark.serving_release.RuntimeArtifactIdentity {
            closure_digest: ollama_runtime_materialization_identity_for_required_release().digest as std.types.NonEmptyStr,
          },
          model: spark_serving_desired_model_artifact(),
        },
      }
    extdeps.ollama.capability.OllamaPlatformSupportUnmet { cause: c } =>
      SparkServingDesiredRefused { cause: c }
    extdeps.ollama.capability.OllamaPlatformSupportUnobserved { cause: c } =>
      SparkServingDesiredRefused { cause: c }
    extdeps.ollama.capability.OllamaPlatformSupportUncatalogued { cause: c } =>
      SparkServingDesiredRefused { cause: c }
  }
}

data spark_serving_desired_admission: SparkServingDesiredAdmission = spark_serving_desired_release_admission()

type SparkServingFleetDesired
  = SparkServingFleetDesiredReady { occurrences: std.types.List<gunbc.spark.serving_release.SparkServingOccurrence> }
  | SparkServingFleetDesiredRefused { cause: std.types.NonEmptyStr }

fn spark_serving_occurrence(host: product.placement_supply.HostIdentity, serving_release: gunbc.spark.serving_release.SparkServingRelease) -> gunbc.spark.serving_release.SparkServingOccurrence {
  gunbc.spark.serving_release.SparkServingOccurrence {
    host: host,
    release_identity: spark_serving_release_identity(spec: serving_release),
    serving_policy: spark_serving_desired_serving_policy(),
  }
}

fn spark_serving_fleet_desired_from_admission() -> SparkServingFleetDesired {
  match spark_serving_desired_admission {
    SparkServingDesiredAdmitted { serving_release: r } =>
      SparkServingFleetDesiredReady {
        occurrences: map(
          spark_serving_desired_hosts,
          h => spark_serving_occurrence(host: h, serving_release: r),
        ),
      }
    SparkServingDesiredRefused { cause: c } =>
      SparkServingFleetDesiredRefused { cause: c }
  }
}

data spark_serving_fleet_desired: SparkServingFleetDesired = spark_serving_fleet_desired_from_admission()

fn spark_serving_desired_serving_policy() -> gunbc.spark.serving_release.SparkServingServingPolicy {
  gunbc.spark.serving_release.SparkServingServingPolicy {
    serving_configuration: spark_serving_configuration_identity(
      runtime: spark_serving_desired_runtime,
      model_ref: spark_serving_desired_model_ref,
      bind: spark_serving_desired_bind_listen,
      endpoint: spark_serving_desired_endpoint_intent,
    ),
    capacity: gunbc.spark.serving_release.InferenceCapacityPolicy {
      max_model_len: 8192,
      shared_memory_budget_bytes: byte_size(120000000000),
    },
  }
}

fn spark_serving_terminal_intent() -> gunbc.spark.serving_realization.SparkServingIntent {
  gunbc.spark.serving_realization.SparkServingIntent {
    lifecycle: SurvivesReboot,
    availability: RestartsOnFailure,
    authority: ManagedConvergenceOwned,
    service_identity: gunbc.spark.serving_realization.ExecutorOwnedIdentity,
    endpoint: spark_serving_desired_endpoint_intent,
    observability: IndependentlyObservable,
  }
}

fn spark_serving_automation_principal_login() -> std.types.NonEmptyStr {
  "gunbc-automation" as std.types.NonEmptyStr
}

fn spark_serving_automation_principal() -> NamedPrincipal {
  NamedPrincipal { login: spark_serving_automation_principal_login() }
}
