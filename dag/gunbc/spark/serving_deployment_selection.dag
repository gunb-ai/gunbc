  footprint: FootprintObservedOnFleet {
    bytes: 168683720987,
    how: "summed safetensors byte size read inside the serving container on a Spark, 2026-09-07" as NonEmptyStr,
  },
  weight_treatment: "the checkpoint as published, no requantisation" as NonEmptyStr,
}

