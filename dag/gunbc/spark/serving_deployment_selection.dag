module gunbc.spark.serving_deployment_selection

import std.types { Bool, Int, String, NonEmptyStr, List }
import std.nat { Nat }
import std.measure { TokenCount, token_count, token_count_value }
import v2.std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_ref, declaration_ref_eq }
import std.interval { degenerate_interval, OrderedClosedInterval }
import std.pareto { AxisGap, AxisReading, HigherIsBetter, LowerIsBetter, ParetoEntry, SelectionAxis }
import std.decision {
  HardConstraint, SelectionPolicy, UniqueSurvivorRequired, SelectionReceipt,
  SelectionEvidenceNeed, DecisionAssessment, DecisionSubject, DecisionVariable,
  DecisionConstraint, DecisionRegion, ContextParameter, ObjectiveTerm, ObjectiveMeasure,
  ChoiceDomain, VariesAlong, MonotoneIncreasing, ConstraintSatisfied, ParameterBound,
  PhysicalModelEstablished, CausalModelEstablished, VendorDocumentedCoupling,
  SelectedWithin, SelectionNeedsEvidence, SelectionNeedsPolicy,
  RealizationSelectionRefused, NoFeasibleRealization, CandidateFieldUnestablished,
  select_realization,
}
import extdeps.external_authority { CitedToAuthority, ExternalAuthority }
import extdeps.uri { Uri, Https }

// ── ONE MODEL IN, A RANKED SET OF WHOLE-FLEET DEPLOYMENT SHAPES OUT ───────────────────────────
//
// WHY THIS EXISTS. Every deployment question this fleet has asked -- how many ranks, what context
// ceiling, what memory fraction, whether to take a faster quantisation -- has been answered by
// someone reading a benchmark and editing a launch script. That process has no terminating
// condition: there is always another flag, and nothing records why the last value was chosen or
// what would change it. The result is endless tuning.
//
// THE REPLACEMENT IS A FUNCTION, NOT A BETTER BENCHMARK. Given an exact model artifact, a fleet
// snapshot, a workload demand, a quality policy and an evidence snapshot, it enumerates the whole
// field of deployment shapes, derives which are physically possible, attaches the evidence each
// axis actually has, and hands the choice to std.decision. Its answer changes when one of those
// inputs changes and at no other time.
//
// WHAT THIS MODULE IS NOT. It is not a selector. std.decision.select_realization owns choosing and
// std.pareto owns dominance; DESIGN section 3d is explicit that growing a second decision algebra
// beside them is the fork that law exists to prevent. This module is a candidate generator, a
// feasibility derivation and a projector -- it collapses domain-typed readings into the generic
// scalar exactly once and then calls the spine, following the precedent gunbc.product.build_selection
// set for build realizations.

// ── THE ARTIFACT IS A CONTEXT PARAMETER, AND ITS FOOTPRINT IS OBSERVED OR UNREAD ──────────────
//
// Weight footprint decides feasibility before any benchmark does, so it is the first thing that
// must be real. A published parameter count or a figure from a model card is a citation about a
// checkpoint, not a reading of the bytes this fleet will serve, and the difference has already
// cost this investigation once: the outgoing model's footprint was MEASURED at 168,683,720,987
// bytes and the whole topology feasibility argument rested on that reading rather than on a card.
//
// So an unread footprint yields no feasibility verdict at all. It does not default to "probably
// fits" and it does not default to refusing -- both would be answers, and the honest state is that
// the question has not been asked.
type ArtifactFootprint
  = FootprintMeasured { bytes: Nat, how: NonEmptyStr }
  | FootprintUnread { obligation: NonEmptyStr }

type ModelArtifact {
  identity: DeclarationRef
  label: NonEmptyStr
  footprint: ArtifactFootprint
  weight_treatment: NonEmptyStr
}

// The outgoing profile, footprint MEASURED on the serving host.
data artifact_deepseek_v4_flash_native: ModelArtifact = ModelArtifact {
  identity: DeclarationRef { module_path: "gunbc.spark.serving_deployment_selection", decl_name: "artifact_deepseek_v4_flash_native", field: WholeDeclaration },
  label: "deepseek-ai/DeepSeek-V4-Flash @ 60d8d707, native" as NonEmptyStr,
  footprint: FootprintMeasured {
    bytes: 168683720987,
    how: "du -sb of the hub repository on the serving host, 2026-09-07" as NonEmptyStr,
  },
  weight_treatment: "native checkpoint precision, no additional quantisation" as NonEmptyStr,
}

// The incoming profile. NOT YET READ, deliberately: a widely-quoted ~306 GiB figure exists and is
// not a reading of this fleet's bytes. Until someone measures it, every candidate built on this
// artifact is under-evidenced and the selector must say so rather than divide a rumour by four.
data artifact_glm_53_flash_native: ModelArtifact = ModelArtifact {
  identity: DeclarationRef { module_path: "gunbc.spark.serving_deployment_selection", decl_name: "artifact_glm_53_flash_native", field: WholeDeclaration },
  label: "zai-org/GLM-5.3-Flash, native" as NonEmptyStr,
  footprint: FootprintUnread {
    obligation: "measure the on-disk bytes of the exact snapshot this fleet will serve. A published ~306 GiB figure is a citation about a checkpoint and not a reading of these weights" as NonEmptyStr,
  },
  weight_treatment: "native checkpoint precision, no additional quantisation" as NonEmptyStr,
}

// A DIFFERENT WEIGHT ARTIFACT, PRESENT SO THE QUALITY WALL HAS SOMETHING TO REFUSE. A 2.05-bit
// build of the same model reportedly serves 64 tok/s on ONE host, against roughly 33 for a native
// build on four. It is faster on every throughput axis and it is a different set of weights.
data artifact_glm_53_flash_2bit: ModelArtifact = ModelArtifact {
  identity: DeclarationRef { module_path: "gunbc.spark.serving_deployment_selection", decl_name: "artifact_glm_53_flash_2bit", field: WholeDeclaration },
  label: "GLM-5.3-Flash, 2.05-bpw EXL3 requantisation" as NonEmptyStr,
  footprint: FootprintMeasured {
    bytes: 85230000000,
    how: "reported by the third-party deployment report; not read on this fleet" as NonEmptyStr,
  },
  weight_treatment: "requantised to 2.05 bits per weight, a different set of weights from the native checkpoint" as NonEmptyStr,
}

// ── THE FLEET AS A SNAPSHOT, NOT AS A CONSTANT ────────────────────────────────────────────────
type FleetSnapshot {
  host_count: Nat
  bytes_per_host: Nat
  how: NonEmptyStr
}

data spark_fleet_snapshot: FleetSnapshot = FleetSnapshot {
  host_count: 8,
  bytes_per_host: 130663231488,
  how: "torch.cuda.get_device_properties(0).total_memory read inside the serving container on a GB10, 2026-09-07; NVML refuses this query on unified memory and must not be used for it" as NonEmptyStr,
}

// ── THE DECISION VARIABLES, BOUNDED ───────────────────────────────────────────────────────────
//
// A dimension held constant here is a CONTEXT PARAMETER and not a forgotten one. The batch budget
// is fixed at 2048 and the executor at Ray, because no GLM evidence yet gives a reason to vary
// them; when it does, each becomes a decision variable and std.decision's completeness law then
// requires its relation to every funded objective term.
type SpeculativePolicy = SpeculationOff | SpeculationOn

fn speculative_policy_wire(s: SpeculativePolicy) -> NonEmptyStr {
  match s {
    SpeculationOff => "mtp-off" as NonEmptyStr
    SpeculationOn => "mtp-on" as NonEmptyStr
  }
}

// A REPLICA IS A WHOLE SERVING PROFILE. The candidate is the fleet-wide shape rather than a bare
// tensor-parallel degree, because "two independent four-rank replicas" and "one eight-rank replica"
// differ in aggregate throughput, failure blast radius and warm-conversation capacity, and a bare
// degree cannot express either of them.
type ReplicaProfile {
  tensor_parallel_degree: Nat
  max_model_len: TokenCount
  gpu_memory_utilisation_percent: Nat
  speculative: SpeculativePolicy
}

type DeploymentCandidate {
  identity: DeclarationRef
  label: NonEmptyStr
  artifact: ModelArtifact
  replica: ReplicaProfile
  replica_count: Nat
}

// ── FEASIBILITY IS DERIVED FROM THE ARTIFACT AND THE FLEET, BEFORE ANY BENCHMARK ──────────────
//
// This is the half of the decision that costs nothing to compute and settles most of it: weights
// that do not fit make every performance number irrelevant. The derivation is deliberately a LOWER
// BOUND on what a rank must hold -- it accounts for the sharded weights and nothing else, so
// replicated tensors, runtime allocations, graph and workspace memory all make the true figure
// larger. A candidate this fold admits may still fail at launch; a candidate it refuses cannot
// possibly succeed, which is the direction that makes a cheap bound useful.
type WeightFit
  = WeightsFitWithHeadroom { per_rank_bytes: Nat, usable_bytes: Nat, headroom_bytes: Nat }
  | WeightsExceedRank { per_rank_bytes: Nat, usable_bytes: Nat }
  | WeightFitUnderivable { because: NonEmptyStr }

fn usable_bytes_per_rank(fleet: FleetSnapshot, utilisation_percent: Nat) -> Nat {
  (fleet.bytes_per_host * utilisation_percent) / 100
}

fn weight_fit_of(c: DeploymentCandidate, fleet: FleetSnapshot) -> WeightFit {
  match c.artifact.footprint {
    FootprintUnread { obligation: o } => WeightFitUnderivable { because: o }
    FootprintMeasured { bytes: b, how: _ } =>
      if c.replica.tensor_parallel_degree == 0 {
        WeightFitUnderivable { because: "a zero tensor-parallel degree has no per-rank share" as NonEmptyStr }
      } else {
        if (b / c.replica.tensor_parallel_degree) <= usable_bytes_per_rank(fleet: fleet, utilisation_percent: c.replica.gpu_memory_utilisation_percent) {
          WeightsFitWithHeadroom {
            per_rank_bytes: b / c.replica.tensor_parallel_degree,
            usable_bytes: usable_bytes_per_rank(fleet: fleet, utilisation_percent: c.replica.gpu_memory_utilisation_percent),
            headroom_bytes: usable_bytes_per_rank(fleet: fleet, utilisation_percent: c.replica.gpu_memory_utilisation_percent) - (b / c.replica.tensor_parallel_degree),
          }
        } else {
          WeightsExceedRank {
            per_rank_bytes: b / c.replica.tensor_parallel_degree,
            usable_bytes: usable_bytes_per_rank(fleet: fleet, utilisation_percent: c.replica.gpu_memory_utilisation_percent),
          }
        }
      }
  }
}

// REPLICA COUNT AND BLAST RADIUS ARE DERIVED, never carried beside the replica list where they
// could disagree with it.
fn hosts_consumed(c: DeploymentCandidate) -> Nat {
  c.replica.tensor_parallel_degree * c.replica_count
}

fn fleet_fits(c: DeploymentCandidate, fleet: FleetSnapshot) -> Bool {
  hosts_consumed(c: c) <= fleet.host_count
}

// The share of serving capacity one host failure removes, in percent. One eight-rank replica loses
// everything; two four-rank replicas lose half.
fn blast_radius_percent(c: DeploymentCandidate) -> Nat {
  if c.replica_count == 0 { 100 } else { 100 / c.replica_count }
}

// ── QUALITY IS A GATE, NOT A WEIGHT ───────────────────────────────────────────────────────────
//
// The operator policy is that quality is not for sale: no amount of throughput compensates for a
// quality regression. That is expressible only as a hard constraint. A weighted score -- even one
// weighting quality heavily -- permits enough speed to buy a regression, and the exchange rate is
// invisible in the result.
//
// AND THE RULE IS EXACT-ARTIFACT, NOT A BOOLEAN CALLED "NO QUANTISATION". The intended native
// checkpoint may itself be an fp8 build, so "quantised" cannot carry the actual requirement. What
// the policy says is that a DIFFERENT SET OF WEIGHTS is not fungible with the selected one unless
// the operator changes the decision subject.
//
// THE THIRD ARM IS THE ONE THAT MATTERS MOST. Unread quality is not low quality. A candidate whose
// quality has never been evidenced must produce an evidence obligation, because scoring it zero
// silently rejects a possibly-good option and scoring it full silently admits an unknown one.
type QualityStanding
  = QualityAdmitted { evidence: NonEmptyStr }
  | QualityRefused { violated: NonEmptyStr }
  | QualityUnestablished { obligation: NonEmptyStr }

type QualityPolicy {
  identity: DeclarationRef
  required_artifact: DeclarationRef
  rationale: NonEmptyStr
}

data native_artifact_only: QualityPolicy = QualityPolicy {
  identity: DeclarationRef { module_path: "gunbc.spark.serving_deployment_selection", decl_name: "native_artifact_only", field: WholeDeclaration },
  required_artifact: DeclarationRef { module_path: "gunbc.spark.serving_deployment_selection", decl_name: "artifact_glm_53_flash_native", field: WholeDeclaration },
  rationale: "operator policy 2026-09-08: do not sacrifice quality. A requantised build is a different set of weights and is not admissible against this subject however fast it is; admitting it would require changing the decision subject, not out-ranking the constraint" as NonEmptyStr,
}

fn declaration_names_match(a: DeclarationRef, b: DeclarationRef) -> Bool {
  (a.module_path as String) == (b.module_path as String) && (a.decl_name as String) == (b.decl_name as String)
}

fn quality_standing_of(c: DeploymentCandidate, policy: QualityPolicy) -> QualityStanding {
  if !declaration_names_match(a: c.artifact.identity, b: policy.required_artifact) {
    QualityRefused {
      violated: join(["this candidate serves ", c.artifact.label as String, ", which is not the artifact the decision subject requires: ", c.artifact.weight_treatment as String], "") as NonEmptyStr,
    }
  } else {
    match c.replica.speculative {
      SpeculationOff =>
        QualityAdmitted { evidence: "the exact required artifact, served without a draft model, so the served distribution is the checkpoint's own" as NonEmptyStr }
      SpeculationOn =>
        QualityUnestablished {
          obligation: "speculative decoding is widely described as lossless because draft tokens are verified against the full model, but no output-equivalence or task-quality receipt exists for THIS profile. Establish or refuse it; do not assume it" as NonEmptyStr,
        }
    }
  }
}

// ── VALUE SATURATES AT DEMAND, WHICH IS HOW DIMINISHING RETURNS ENTER WITHOUT A GUESSED CURVE ─
//
// The machine can say what changed when a variable moved. It cannot say how much that change is
// worth. Rather than fitting an exponential because latency "feels" exponentially bad, the value
// projection clamps each axis at the declared requirement: once a candidate covers the demand,
// exceeding it earns nothing further, so a shape that buys unused headroom while losing capacity
// or isolation is dominated rather than merely scored lower.
//
// That produces the knee without anyone choosing a half-life, and the threshold that does exist is
// a DECLARED WORKLOAD FACT rather than a tuning constant.
type WorkloadDemand {
  identity: DeclarationRef
  required_context: TokenCount
  basis: NonEmptyStr
}

data glm_first_profile_demand: WorkloadDemand = WorkloadDemand {
  identity: DeclarationRef { module_path: "gunbc.spark.serving_deployment_selection", decl_name: "glm_first_profile_demand", field: WholeDeclaration },
  required_context: token_count(count: 300000),
  basis: "PLACEHOLDER pending a real context-demand distribution: a percentile over per-turn required context (retained context, new input, reserved output, tool-growth reserve), not a mean prompt length. Carried so the saturation is visible and revisable, not because 300,000 has been established" as NonEmptyStr,
}

fn useful_context(c: DeploymentCandidate, demand: WorkloadDemand) -> Nat {
  if token_count_value(t: c.replica.max_model_len) >= token_count_value(t: demand.required_context) {
    token_count_value(t: demand.required_context)
  } else {
    token_count_value(t: c.replica.max_model_len)
  }
}

fn covers_demand(c: DeploymentCandidate, demand: WorkloadDemand) -> Bool {
  token_count_value(t: c.replica.max_model_len) >= token_count_value(t: demand.required_context)
}

// ── THE FUNDED AXES, AND WHY EACH IS THE SHAPE IT IS ──────────────────────────────────────────
//
// Quality, weight fit and context coverage are funded as ORDINARY AXES carrying 1 or 0, and then
// bounded at 1 by a hard constraint. That is not a trick: the spine excludes a candidate whose
// reading is worse than its bound BEFORE dominance is computed, so a refused candidate is never
// ranked against anything. And a candidate with no reading on such an axis produces an evidence
// gap rather than a zero, which is precisely the distinction between "this fails" and "nobody
// looked" that the whole decision rests on.
data ax_quality: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_quality")
data ax_weight_fit: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_weight_fit")
data ax_context_covered: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_context_covered")
data ax_useful_context: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_useful_context")
data ax_independent_replicas: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_independent_replicas")
data ax_blast_radius: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_blast_radius")

data serving_selection_axes: List<SelectionAxis> = [
  SelectionAxis { identity: ax_quality, goal: HigherIsBetter },
  SelectionAxis { identity: ax_weight_fit, goal: HigherIsBetter },
  SelectionAxis { identity: ax_context_covered, goal: HigherIsBetter },
  SelectionAxis { identity: ax_useful_context, goal: HigherIsBetter },
  SelectionAxis { identity: ax_independent_replicas, goal: HigherIsBetter },
  SelectionAxis { identity: ax_blast_radius, goal: LowerIsBetter },
]

data id_constraint_authority: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_selection_constraints")

data serving_selection_constraints: List<HardConstraint> = [
  HardConstraint { identity: id_constraint_authority, axis: ax_quality, bound_micro: 1 },
  HardConstraint { identity: id_constraint_authority, axis: ax_weight_fit, bound_micro: 1 },
  HardConstraint { identity: id_constraint_authority, axis: ax_context_covered, bound_micro: 1 },
]

fn point(v: Int) -> OrderedClosedInterval<Int> { degenerate_interval(point: v) }

fn reading(axis: DeclarationRef, v: Int) -> AxisReading { AxisReading { axis: axis, interval_micro: point(v: v) } }

fn flag(b: Bool) -> Int { if b { 1 } else { 0 } }

// ── THE PROJECTOR: DOMAIN-TYPED FACTS COLLAPSE TO THE GENERIC SCALAR EXACTLY ONCE ─────────────
//
// Bytes, tokens, replica counts and percentages stay typed above this line and become plain
// integers only here, in one place, following the precedent gunbc.product.build_selection set. An
// unread fact becomes an AxisGap and never a zero, because a zero is a reading and would rank.
fn quality_reading_of(c: DeploymentCandidate, policy: QualityPolicy) -> AxisReading? {
  match quality_standing_of(c: c, policy: policy) {
    QualityAdmitted { evidence: _ } => Present { value: reading(axis: ax_quality, v: 1) }
    QualityRefused { violated: _ } => Present { value: reading(axis: ax_quality, v: 0) }
    QualityUnestablished { obligation: _ } => none
  }
}

fn weight_fit_reading_of(c: DeploymentCandidate, fleet: FleetSnapshot) -> AxisReading? {
  match weight_fit_of(c: c, fleet: fleet) {
    WeightsFitWithHeadroom { per_rank_bytes: _, usable_bytes: _, headroom_bytes: _ } =>
      Present { value: reading(axis: ax_weight_fit, v: flag(b: fleet_fits(c: c, fleet: fleet))) }
    WeightsExceedRank { per_rank_bytes: _, usable_bytes: _ } => Present { value: reading(axis: ax_weight_fit, v: 0) }
    WeightFitUnderivable { because: _ } => none
  }
}

fn candidate_gaps(c: DeploymentCandidate, fleet: FleetSnapshot, policy: QualityPolicy) -> List<AxisGap> {
  concat(
    match quality_standing_of(c: c, policy: policy) {
      QualityUnestablished { obligation: o } => [AxisGap { axis: ax_quality, cause: o }]
      QualityAdmitted { evidence: _ } => []
      QualityRefused { violated: _ } => []
    },
    match weight_fit_of(c: c, fleet: fleet) {
      WeightFitUnderivable { because: b } => [AxisGap { axis: ax_weight_fit, cause: b }]
      WeightsFitWithHeadroom { per_rank_bytes: _, usable_bytes: _, headroom_bytes: _ } => []
      WeightsExceedRank { per_rank_bytes: _, usable_bytes: _ } => []
    })
}

fn candidate_readings(c: DeploymentCandidate, fleet: FleetSnapshot, policy: QualityPolicy, demand: WorkloadDemand) -> List<AxisReading> {
  concat(
    concat(
      match quality_reading_of(c: c, policy: policy) {
        Present { value: r } => [r]
        Absent => []
      },
      match weight_fit_reading_of(c: c, fleet: fleet) {
        Present { value: r } => [r]
        Absent => []
      }),
    [
      reading(axis: ax_context_covered, v: flag(b: covers_demand(c: c, demand: demand))),
      reading(axis: ax_useful_context, v: useful_context(c: c, demand: demand)),
      reading(axis: ax_independent_replicas, v: c.replica_count),
      reading(axis: ax_blast_radius, v: blast_radius_percent(c: c)),
    ])
}

fn project_candidate(c: DeploymentCandidate, fleet: FleetSnapshot, policy: QualityPolicy, demand: WorkloadDemand) -> ParetoEntry {
  ParetoEntry {
    identity: c.identity,
    display_label: c.label,
    readings: candidate_readings(c: c, fleet: fleet, policy: policy, demand: demand),
    missing_inputs: candidate_gaps(c: c, fleet: fleet, policy: policy),
  }
}

// ── THE RESULT IS DOMAIN-TYPED, AND ONLY ONE ARM CAN LAUNCH ANYTHING ──────────────────────────
type ServingDeploymentSelection
  = ServingDeploymentSelected { candidate: DeclarationRef, receipt: SelectionReceipt }
  | ServingDeploymentNeedsEvidence { needs: List<SelectionEvidenceNeed> }
  | ServingDeploymentNeedsPolicy { survivors: List<DeclarationRef> }
  | NoFeasibleServingDeployment { causes: List<NonEmptyStr> }
  | ServingDeploymentSelectionRefused { defects: List<NonEmptyStr> }

fn select_serving_deployment(
  candidates: List<DeploymentCandidate>,
  fleet: FleetSnapshot,
  policy: QualityPolicy,
  demand: WorkloadDemand,
  assessment: DecisionAssessment,
) -> ServingDeploymentSelection {
  match select_realization(
    assessment: assessment,
    candidate_field_identity: id_candidate_field,
    field: map(candidates, c => project_candidate(c: c, fleet: fleet, policy: policy, demand: demand)),
    axes: serving_selection_axes,
    constraints: serving_selection_constraints,
    constraint_authority: id_constraint_authority,
    policy: UniqueSurvivorRequired { identity: id_selection_policy },
    evidence_snapshot: id_evidence_snapshot,
  ) {
    SelectedWithin { candidate: e, receipt: r } => ServingDeploymentSelected { candidate: e.identity, receipt: r }
    SelectionNeedsEvidence { needs: n } => ServingDeploymentNeedsEvidence { needs: n }
    SelectionNeedsPolicy { survivors: s } => ServingDeploymentNeedsPolicy { survivors: s }
    NoFeasibleRealization { causes: c } => NoFeasibleServingDeployment { causes: c }
    RealizationSelectionRefused { defects: d } => ServingDeploymentSelectionRefused { defects: d }
    CandidateFieldUnestablished { causes: c } => ServingDeploymentSelectionRefused { defects: c }
  }
}

data id_selection_policy: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "native_artifact_only")
data id_evidence_snapshot: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "spark_fleet_snapshot")

// ── ONLY A SELECTION MAY PRODUCE A LAUNCH ─────────────────────────────────────────────────────
//
// This is the consumption boundary and the reason the module is not modelling for its own sake. A
// launch profile is constructible from the selected arm and from nothing else, so an
// under-evidenced or refused decision cannot reach an engine by any route -- the obligations come
// back instead, naming what would change the answer.
type LaunchAdmission
  = LaunchAdmitted { candidate: DeclarationRef }
  | LaunchRefused { because: NonEmptyStr }

fn admit_launch(s: ServingDeploymentSelection) -> LaunchAdmission {
  match s {
    ServingDeploymentSelected { candidate: c, receipt: _ } => LaunchAdmitted { candidate: c }
    ServingDeploymentNeedsEvidence { needs: n } =>
      LaunchRefused { because: join(["the decision is under-evidenced: ", to_string(count(n)), " obligation(s) outstanding"], "") as NonEmptyStr }
    ServingDeploymentNeedsPolicy { survivors: s2 } =>
      LaunchRefused { because: join([to_string(count(s2)), " candidates are non-dominated and no policy separates them"], "") as NonEmptyStr }
    NoFeasibleServingDeployment { causes: _ } =>
      LaunchRefused { because: "no candidate satisfies the hard constraints" as NonEmptyStr }
    ServingDeploymentSelectionRefused { defects: _ } =>
      LaunchRefused { because: "the selection itself is defective and states so rather than choosing" as NonEmptyStr }
  }
}

// ── THE CANDIDATE FIELD IS COMPLETE OVER A DECLARED DOMAIN, AND THE DOMAIN IS NARROW ON PURPOSE
//
// Completeness is what stops an author obtaining a preferred winner by never adding the candidate
// that would beat it. So every combination of the declared variable values is present as a row --
// including the ones this fold will refuse, because a refusal that is visible is evidence and a
// combination that was never listed is not.
//
// THE DOMAIN IS DELIBERATELY SMALL FOR THIS FIRST SUBJECT. Context, memory fraction and speculative
// policy are held at one value each and carried as CONTEXT PARAMETERS below; widening any of them
// is a domain change that adds rows here and, by std.decision's completeness law, obliges a
// sensitivity relation to every funded term. That is the growth path, and it is deliberately not
// taken in the same change that introduces the machinery.
//
// TOPOLOGY IS THE ONE VARIABLE THAT VARIES, at every shape the eight-host fleet can express, plus
// the requantised artifact so the quality wall has a live subject rather than a hypothetical one.
data glm_ctx: TokenCount = token_count(count: 300000)
data glm_util: Nat = 82

fn glm_replica(tp: Nat) -> ReplicaProfile {
  ReplicaProfile {
    tensor_parallel_degree: tp,
    max_model_len: glm_ctx,
    gpu_memory_utilisation_percent: glm_util,
    speculative: SpeculationOff,
  }
}

fn candidate(name: String, label: NonEmptyStr, art: ModelArtifact, tp: Nat, replicas: Nat) -> DeploymentCandidate {
  DeploymentCandidate {
    identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: name),
    label: label,
    artifact: art,
    replica: glm_replica(tp: tp),
    replica_count: replicas,
  }
}

data glm_candidate_field: List<DeploymentCandidate> = [
  candidate(name: "glm_native_tp8_x1", label: "GLM native, one eight-rank replica" as NonEmptyStr, art: artifact_glm_53_flash_native, tp: 8, replicas: 1),
  candidate(name: "glm_native_tp4_x2", label: "GLM native, two four-rank replicas" as NonEmptyStr, art: artifact_glm_53_flash_native, tp: 4, replicas: 2),
  candidate(name: "glm_native_tp2_x4", label: "GLM native, four two-rank replicas" as NonEmptyStr, art: artifact_glm_53_flash_native, tp: 2, replicas: 4),
  candidate(name: "glm_native_tp1_x8", label: "GLM native, eight single-rank replicas" as NonEmptyStr, art: artifact_glm_53_flash_native, tp: 1, replicas: 8),
  candidate(name: "glm_2bit_tp8_x1", label: "GLM 2.05-bpw, one eight-rank replica" as NonEmptyStr, art: artifact_glm_53_flash_2bit, tp: 8, replicas: 1),
  candidate(name: "glm_2bit_tp4_x2", label: "GLM 2.05-bpw, two four-rank replicas" as NonEmptyStr, art: artifact_glm_53_flash_2bit, tp: 4, replicas: 2),
  candidate(name: "glm_2bit_tp2_x4", label: "GLM 2.05-bpw, four two-rank replicas" as NonEmptyStr, art: artifact_glm_53_flash_2bit, tp: 2, replicas: 4),
  candidate(name: "glm_2bit_tp1_x8", label: "GLM 2.05-bpw, eight single-rank replicas" as NonEmptyStr, art: artifact_glm_53_flash_2bit, tp: 1, replicas: 8),
]

// ── THE SUBJECT CLOSURE ───────────────────────────────────────────────────────────────────────
//
// std.decision refuses to select against an incomplete subject, so the assessment states the one
// varying variable, the funded term it moves, and the parameters held fixed. This is the smallest
// honest closure for the domain above; widening the domain widens this.
data id_subject: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_deployment_subject")
data id_var_topology: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "var_fleet_topology")
data id_term_isolation: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "term_failure_isolation")
data id_param_context: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "param_context_ceiling")
data id_constraint_cell: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_selection_constraints")
data id_physical_authority: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "spark_fleet_snapshot")
data id_coupling_receipt: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "weight_fit_of")

data id_candidate_field: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "glm_candidate_field")

// THE COUPLING IS A VENDOR FACT, NOT AN ARITHMETIC ONE. Blast radius moves with topology only
// because a tensor-parallel replica FAILS AS A UNIT across its ranks -- one rank lost takes the
// replica, which is upstream's documented behaviour and not something this repository decided. The
// division that turns that into a percentage is downstream of the fact; citing the division would
// be citing our own arithmetic back to ourselves.
data tensor_parallel_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "docs.vllm.ai/en/latest/serving/distributed_serving.html",
  },
}

data var_fleet_topology: DecisionVariable = DecisionVariable { identity: id_var_topology }

data term_failure_isolation: ObjectiveTerm = ObjectiveTerm {
  identity: id_term_isolation,
  ground: CitedToAuthority { authority: tensor_parallel_authority },
}

data param_context_ceiling: ContextParameter = ContextParameter { identity: id_param_context }
data constraint_cell: DecisionConstraint = DecisionConstraint { identity: id_constraint_cell }

data serving_topology_region: DecisionRegion = DecisionRegion {
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_topology_region"),
}

data serving_objective: ObjectiveMeasure = ObjectiveMeasure {
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_objective"),
  goal: HigherIsBetter,
  terms: [term_failure_isolation],
}

data serving_choice_domain: ChoiceDomain = ChoiceDomain {
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_choice_domain"),
  variables: [var_fleet_topology],
}

data serving_deployment_subject: DecisionSubject = DecisionSubject {
  identity: id_subject,
  question: "which whole-fleet deployment shape serves this exact artifact at the declared context" as NonEmptyStr,
  parameters: [param_context_ceiling],
  constraints: [constraint_cell],
  objective: serving_objective,
  choice_domain: serving_choice_domain,
}

// FEWER RANKS PER REPLICA IS MORE ISOLATION, over the region this domain spans and no further. The
// relation is stated as monotone because within eight hosts a smaller replica is strictly more of
// them; it is NOT a claim about topologies this fleet cannot express.
data serving_deployment_assessment: DecisionAssessment = DecisionAssessment {
  subject: serving_deployment_subject,
  sensitivities: [
    VariesAlong {
      term: id_term_isolation,
      variable: id_var_topology,
      region: serving_topology_region,
      relation: MonotoneIncreasing,
      coupling: CitedToAuthority { authority: tensor_parallel_authority },
    },
  ],
  constraints: [
    ConstraintSatisfied {
      constraint: id_constraint_cell,
      evidence: "quality, weight fit and context coverage are each bounded at one and excluded before dominance" as NonEmptyStr,
    },
  ],
  parameters: [
    ParameterBound {
      parameter: id_param_context,
      evidence: "every candidate is built at one declared context ceiling; widening it is a domain change" as NonEmptyStr,
    },
  ],
  selected_candidate: Absent,
  term_drops: [],
  physical_model: PhysicalModelEstablished { terms: [id_term_isolation] },
  causal_model: CausalModelEstablished {
    couplings: [
      VendorDocumentedCoupling {
        authority: tensor_parallel_authority,
        term: id_term_isolation,
        variable: id_var_topology,
        subject: id_subject,
      },
    ],
  },
}

// ── THE CONSUMER ──────────────────────────────────────────────────────────────────────────────
//
// This is the whole point of the module: one call that answers the deployment question for the
// artifact actually being stood up, and an admission that can only launch what that call selected.
fn glm_first_serving_selection() -> ServingDeploymentSelection {
  select_serving_deployment(
    candidates: glm_candidate_field,
    fleet: spark_fleet_snapshot,
    policy: native_artifact_only,
    demand: glm_first_profile_demand,
    assessment: serving_deployment_assessment,
  )
}

fn glm_first_launch_admission() -> LaunchAdmission {
  admit_launch(s: glm_first_serving_selection())
}
