// ── THE FLEET AS A SNAPSHOT ───────────────────────────────────────────────────────────────────
type FleetSnapshot {
  host_count: Nat
  bytes_per_host: Nat
  how: NonEmptyStr
}

data spark_fleet_snapshot: FleetSnapshot = FleetSnapshot {
  host_count: 8,
  bytes_per_host: 130663231488,
  how: "torch.cuda.get_device_properties(0).total_memory read inside the serving container on a GB10, 2026-09-07; NVML refuses this query on unified memory and must not be used for it" as NonEmptyStr,
}

// ── THE FIXED EXECUTION PARAMETERS, CARRIED ONCE SO A CANDIDATE CANNOT DISAGREE WITH THEM ─────
//
// THE PREVIOUS VERSION LET EVERY CANDIDATE CARRY ITS OWN CONTEXT CEILING, MEMORY FRACTION AND
// SPECULATIVE POLICY while the assessment declared those "fixed parameters" in prose. Nothing
// joined the two, so a field could hold one candidate at 300K and another at 400K, one at 82% and
// another at 150%, one with speculation off and one on, and the completeness join -- which keyed
// only on artifact and topology -- would still call that field complete.
//
// THE REPAIR IS CONSTRUCTION, NOT A CHECK. A candidate no longer carries those values at all; it
// carries the ONE variable this subject varies. The fixed values live here, once, on the domain. A
// candidate that disagrees with the declared context ceiling is not caught by a fold -- it cannot be
// written, because there is no field in which to write the disagreement. That is DESIGN's rung four
// rather than rung two, and it is why no witness row asserts a mismatch refuses: the state has no
// constructor, so such a row's red would be unauthorable and the check would be a decoration.
//
// WHAT REMAINS AUTHORABLE IS THE PARAMETER ITSELF being wrong, and that is checked below: a memory
// fraction above 100 percent would hand the lower-bound screen more usable memory than the host
// physically has, turning an impossible profile into a passing one.
type ExecutorProfile = ExecutorRayProfile | ExecutorMpProfile

// THE REQUESTED LAYOUT, AND `fp8` WAS NOT EXPRESSIBLE. The canary's launch asks for `--kv-cache-dtype
// fp8` and the engine RESOLVES that to fp8_ds_mla for an MLA model, reporting so on its own startup
// line. This type spells the REQUEST, so it needs the spelling the request actually uses: without it,
// describing the canary meant claiming it requested fp8_ds_mla, which is the resolved value rather
// than the argument, and two launches sending different arguments would have shared one identity.
type KvLayoutPolicy = KvAutoLayout | KvFp8Layout | KvFp8DsMlaLayout

type SpeculativePolicy = SpeculationOff | SpeculationOn

fn speculative_policy_wire(s: SpeculativePolicy) -> NonEmptyStr {
  match s {
    SpeculationOff => "mtp-off" as NonEmptyStr
    SpeculationOn => "mtp-on" as NonEmptyStr
  }
}

fn speculative_policy_eq(a: SpeculativePolicy, b: SpeculativePolicy) -> Bool {
  match a {
    SpeculationOff => match b { SpeculationOff => true, SpeculationOn => false }
    SpeculationOn => match b { SpeculationOff => false, SpeculationOn => true }
  }
}

fn executor_wire(e: ExecutorProfile) -> NonEmptyStr {
  match e {
    ExecutorRayProfile => "ray" as NonEmptyStr
    ExecutorMpProfile => "mp" as NonEmptyStr
  }
}

fn kv_layout_wire(k: KvLayoutPolicy) -> NonEmptyStr {
  match k {
    KvAutoLayout => "auto" as NonEmptyStr
    KvFp8Layout => "fp8" as NonEmptyStr
    KvFp8DsMlaLayout => "fp8_ds_mla" as NonEmptyStr
  }
}

type RuntimeRevision sole_constructor {
  image: NonEmptyStr
  vllm_revision: NonEmptyStr
}

fn runtime_revision(image: NonEmptyStr, vllm_revision: NonEmptyStr) -> RuntimeRevision {
  RuntimeRevision { image: image, vllm_revision: vllm_revision }
}

fn runtime_revision_key(r: RuntimeRevision) -> String {
  join([r.image as String, "@", r.vllm_revision as String], "")
}

type ServingDecisionParameters sole_constructor {
  max_model_len: TokenCount
  memory_request: VllmMemoryRequest
  max_num_batched_tokens: TokenCount
  max_num_seqs: Nat
  executor: ExecutorProfile
  kv_layout: KvLayoutPolicy
  speculative: SpeculativePolicy
  enable_prefix_caching: Bool
  runtime: RuntimeRevision
}

fn serving_decision_parameters(
  max_model_len: TokenCount,
  memory_request: VllmMemoryRequest,
  max_num_batched_tokens: TokenCount,
  max_num_seqs: Nat,
  executor: ExecutorProfile,
  kv_layout: KvLayoutPolicy,
  speculative: SpeculativePolicy,
  enable_prefix_caching: Bool,
  runtime: RuntimeRevision,
) -> ServingDecisionParameters {
  ServingDecisionParameters {
    max_model_len: max_model_len,
    memory_request: memory_request,
    max_num_batched_tokens: max_num_batched_tokens,
    max_num_seqs: max_num_seqs,
    executor: executor,
    kv_layout: kv_layout,
    speculative: speculative,
    enable_prefix_caching: enable_prefix_caching,
    runtime: runtime,
  }
}

fn runtime_revision_eq(a: RuntimeRevision, b: RuntimeRevision) -> Bool {
  (a.image as String) == (b.image as String) && (a.vllm_revision as String) == (b.vllm_revision as String)
}

fn executor_profile_eq(a: ExecutorProfile, b: ExecutorProfile) -> Bool {
  match a {
    ExecutorRayProfile => match b { ExecutorRayProfile => true, ExecutorMpProfile => false }
    ExecutorMpProfile => match b { ExecutorRayProfile => false, ExecutorMpProfile => true }
  }
}

fn kv_layout_eq(a: KvLayoutPolicy, b: KvLayoutPolicy) -> Bool {
  match a {
    KvAutoLayout => match b { KvAutoLayout => true, KvFp8Layout => false, KvFp8DsMlaLayout => false }
    KvFp8Layout => match b { KvAutoLayout => false, KvFp8Layout => true, KvFp8DsMlaLayout => false }
    KvFp8DsMlaLayout => match b { KvAutoLayout => false, KvFp8Layout => false, KvFp8DsMlaLayout => true }
  }
}

// ── PARAMETER EQUALITY IS FIELD-WISE, AND THAT IS WHAT REMOVES THE COLLISION ───────────────────
//
// IDENTITY USED TO BE A RENDERED STRING AND THE COLLISION WAS IN THE EQUALITY RELATION ITSELF, not
// merely in a label. `parameters_key` joined the fields with `|` and `runtime_revision_key` joined an
// image to a revision with `@`, and `execution_profile_eq` compared those renderings -- so
// image "a@b" with revision "c" and image "a" with revision "b@c" were THE SAME PROFILE, and a
// quality receipt acquired under one would have admitted the other. No delimiter choice fixes this:
// any separator can appear inside a field, and escaping it is a second encoding to get wrong.
//
// Comparing field by field has no such failure mode, because nothing is concatenated. The collision
// is not caught -- it has no constructor, which is rung four rather than a wall to maintain.
// FIELD-WISE ON THE OPTIONALS TOO, for the reason the block above gives: `vllm_memory_request_key`
// renders a request for prose, and comparing renderings is exactly the concatenation identity that
// admitted one profile's quality receipt for another.
fn memory_request_eq(a: VllmMemoryRequest, b: VllmMemoryRequest) -> Bool {
  optional_nat_eq(a: requested_utilisation_basis_points(r: a), b: requested_utilisation_basis_points(r: b))
    && optional_nat_eq(a: requested_kv_cache_bytes(r: a), b: requested_kv_cache_bytes(r: b))
}

fn requested_kv_cache_bytes(r: VllmMemoryRequest) -> Nat? {
  match r.kv_cache_bytes {
    Absent => none
    Present { value: bytes } => Present { value: byte_size_count(b: bytes) }
  }
}

fn optional_nat_eq(a: Nat?, b: Nat?) -> Bool {
  match a {
    Absent => match b { Absent => true, Present { value: _ } => false }
    Present { value: x } => match b { Absent => false, Present { value: y } => x == y }
  }
}

fn parameters_eq(a: ServingDecisionParameters, b: ServingDecisionParameters) -> Bool {
  token_count_value(t: a.max_model_len) == token_count_value(t: b.max_model_len)
    && memory_request_eq(a: a.memory_request, b: b.memory_request)
    && token_count_value(t: a.max_num_batched_tokens) == token_count_value(t: b.max_num_batched_tokens)
    && a.max_num_seqs == b.max_num_seqs
    && executor_profile_eq(a: a.executor, b: b.executor)
    && kv_layout_eq(a: a.kv_layout, b: b.kv_layout)
    && speculative_policy_eq(a: a.speculative, b: b.speculative)
    && a.enable_prefix_caching == b.enable_prefix_caching
    && runtime_revision_eq(a: a.runtime, b: b.runtime)
}

// THE RENDERED FORMS SURVIVE FOR PROSE AND FOR NOTHING ELSE. A receipt's evidence sentence and a
// systemd unit name want a readable string; identity does not, and the two uses are kept apart so a
// display helper can never become a comparison again.
fn parameters_render(p: ServingDecisionParameters) -> String {
  join([
    "ctx", to_string(token_count_value(t: p.max_model_len)),
    "|util", vllm_memory_request_key(r: p.memory_request),
    "|batch", to_string(token_count_value(t: p.max_num_batched_tokens)),
    "|seqs", to_string(p.max_num_seqs),
    "|", executor_wire(e: p.executor) as String,
    "|", kv_layout_wire(k: p.kv_layout) as String,
    "|", speculative_policy_wire(s: p.speculative) as String,
    "|prefix", if p.enable_prefix_caching { "on" } else { "off" },
    "|", runtime_revision_key(r: p.runtime),
  ], "")
}

// A memory fraction above the whole device is not a bold setting, it is an arithmetic error that
// makes the feasibility screen generous in the one direction it must never be generous.
//
// THE RANGE CHECK IS NOT RESTATED HERE ANY MORE. This module carried its own >100 and ==0 tests
// against an integral percent while extdeps.vllm.runtime_defaults carried the same rule against the
// request the engine actually receives -- two validators for one upstream constraint, free to drift,
// and the local one could not even see a request that OMITS the fraction. The upstream rule has one
// home and this screen consumes it.
fn parameters_defect(p: ServingDecisionParameters) -> NonEmptyStr? {
  vllm_memory_request_defect(request: p.memory_request)
}

// ── EVERY PARAMETER SAYS WHAT KIND OF FACT IT IS ──────────────────────────────────────────────
//
// "DERIVE EVERY VALUE" CANNOT MEAN "MEASURE EVERY VALUE", because some values are legitimately
// chosen: an experimental context window is an operator's decision and no instrument will ever
// produce it. What it must mean is that no bare number sits in the model without saying which kind of
// fact it is -- so a decision cannot be mistaken for a measurement, which is the specific confusion
// that let a 300,000-token figure I authored read as a working window for most of a day.
//
// A PROVENANCE CARRIES NO VALUE, and the first draft of this got that wrong. It was a parametric
// ValueStanding<T> holding the value alongside its origin, which fails twice: four of the nine
// parameters are not numbers at all -- executor, KV layout, speculative policy, runtime -- so one type
// argument could not cover the record; and restating a value beside the record that already holds it
// makes the provenance a SECOND AUTHORITY for the same number, free to disagree with it. A provenance
// therefore CITES its field and says only how the value came to be held.
//
// SEQ CAPACITY ALREADY HAD THIS SHAPE FOR ONE VALUE. gunbc.spark.pair_serving_desired declares
// SeqCapacityByOperatorPolicy | SeqCapacityMeasured | SeqCapacityUnmeasured, which is this coproduct
// specialised to max_num_seqs. This is the general form, and it stays HERE rather than in std until a
// second module consumes it: section 6 models just-in-time, and a std declaration with one consumer is
// inventory.
type ParameterProvenance
  = ParameterObserved { instrument: NonEmptyStr }
  | ParameterDerived { derived_from: NonEmptyStr }
  | ParameterDecided { decider: NonEmptyStr, purpose: NonEmptyStr }
  | ParameterSelected { receipt: DeclarationRef }
  | ParameterUnestablished { obligation: NonEmptyStr }

fn provenance_kind(prov: ParameterProvenance) -> NonEmptyStr {
  match prov {
    ParameterObserved { instrument: _ } => "observed" as NonEmptyStr
    ParameterDerived { derived_from: _ } => "derived" as NonEmptyStr
    ParameterDecided { decider: _, purpose: _ } => "decided" as NonEmptyStr
    ParameterSelected { receipt: _ } => "selected" as NonEmptyStr
    ParameterUnestablished { obligation: _ } => "unestablished" as NonEmptyStr
  }
}

fn provenance_obligation(prov: ParameterProvenance) -> NonEmptyStr? {
  match prov {
    ParameterUnestablished { obligation: o } => Present { value: o }
    ParameterObserved { instrument: _ } => none
    ParameterDerived { derived_from: _ } => none
    ParameterDecided { decider: _, purpose: _ } => none
    ParameterSelected { receipt: _ } => none
  }
}

// PROVENANCE IS DELIBERATELY ABSENT FROM THE PROFILE DIGEST, and that is a correctness choice rather
// than an omission. The digest identifies WHAT THE ENGINE RAN, so a quality receipt acquired under a
// decided 262,144 window still answers for the same engine behaviour once that window is later derived
// from a workload population. Folding provenance into the digest would invalidate every receipt the
// moment a value's standing IMPROVED, which is exactly backwards.
type ParameterStandingRow sole_constructor {
  parameter: NonEmptyStr
  provenance: ParameterProvenance
}

fn parameter_row(parameter: NonEmptyStr, provenance: ParameterProvenance) -> ParameterStandingRow {
  ParameterStandingRow { parameter: parameter, provenance: provenance }
}

// ── THE CANDIDATE CARRIES ONLY WHAT VARIES ────────────────────────────────────────────────────
type TopologyShape sole_constructor {
  tensor_parallel_degree: Nat
  replica_count: Nat
}

fn topology_shape(tensor_parallel_degree: Nat, replica_count: Nat) -> TopologyShape {
  TopologyShape { tensor_parallel_degree: tensor_parallel_degree, replica_count: replica_count }
}

fn topology_shape_eq(a: TopologyShape, b: TopologyShape) -> Bool {
  a.tensor_parallel_degree == b.tensor_parallel_degree && a.replica_count == b.replica_count
}

type DeploymentCandidate sole_constructor {
  identity: DeclarationRef
  label: NonEmptyStr
  artifact: ModelArtifact
  topology: TopologyShape
}

fn deployment_candidate(identity: DeclarationRef, label: NonEmptyStr, artifact: ModelArtifact, topology: TopologyShape) -> DeploymentCandidate {
  DeploymentCandidate { identity: identity, label: label, artifact: artifact, topology: topology }
}

// ── THE EXACT EXECUTION PROFILE: THE SUBJECT OF EVERY PIECE OF EVIDENCE ───────────────────────
//
// THE PREVIOUS SUBJECT WAS (artifact, degree, speculative policy) AND THAT WAS STILL TOO COARSE. A
// receipt acquired at 128K context on runtime revision A would have satisfied a candidate at 400K on
// revision B with a different executor and KV layout -- none of which is safely transportable. A
// quality or feasibility observation belongs to the exact thing that was run.
//
// The profile is DERIVED from a candidate and the declared parameters rather than authored, so no
// caller can describe a profile that no candidate expresses.
type ServingExecutionProfile sole_constructor {
  artifact: DeclarationRef
  tensor_parallel_degree: Nat
  parameters: ServingDecisionParameters
}

fn execution_profile_of(c: DeploymentCandidate, p: ServingDecisionParameters) -> ServingExecutionProfile {
  ServingExecutionProfile {
    artifact: c.artifact.identity,
    tensor_parallel_degree: c.topology.tensor_parallel_degree,
    parameters: p,
  }
}

fn execution_profile_eq(a: ServingExecutionProfile, b: ServingExecutionProfile) -> Bool {
  declaration_ref_eq(a: a.artifact, b: b.artifact)
    && a.tensor_parallel_degree == b.tensor_parallel_degree
    && parameters_eq(a: a.parameters, b: b.parameters)
}

fn execution_profile_render(p: ServingExecutionProfile) -> String {
  join([declaration_ref_display_key(ref: p.artifact), "|tp", to_string(p.tensor_parallel_degree), "|", parameters_render(p: p.parameters)], "")
}

// ── QUALITY: A REPORT IS ORDINARY DATA, A VERDICT IS NOT ──────────────────────────────────────
//
// THIS IS THE DEFECT THE SECOND REVIEW CAUGHT AND IT WAS THE SAME MISTAKE AS THE FIRST, ONE LAYER
// UP. The previous version sealed the launch mint by exporting no builder for the selected result --
// and in the same change exported `serving_quality_receipt`, a public function taking a subject, an
// arbitrary authority name and a prose note, returning an admitted quality receipt. Any caller could
// mint "quality is fine" for any profile and satisfy the hard quality axis without an evaluation
// having run. The record literal was sealed; the semantic constructor was public.
//
// So the two things are separated. A REPORT is observations -- freely constructible, because writing
// down what a run produced is not a claim that it passed. A VERDICT is the comparison of a report
// against a requirement, and its passing arm carries a payload with NO exported builder, so it can
// only come from `assess_quality`. A caller may say what was measured; only the evaluator may say
// whether that meets the bar.
//
// AND A FAILURE IS NOW REPRESENTABLE. Previously a same-artifact profile that FAILED a quality test
// collapsed into the same state as one never tested: `QualityRefused` fired only on artifact
// mismatch. A tested-and-bad profile is a decided negative and must not read as an open question.
type ServingQualityReport sole_constructor {
  subject: ServingExecutionProfile
  suite: DeclarationRef
  reference_profile: ServingExecutionProfile
  max_selected_token_divergence_millinats: Nat
  task_score_delta_hundredths: Int
  how: NonEmptyStr
}

fn serving_quality_report(
  subject: ServingExecutionProfile,
  suite: DeclarationRef,
  reference_profile: ServingExecutionProfile,
  max_selected_token_divergence_millinats: Nat,
  task_score_delta_hundredths: Int,
  how: NonEmptyStr,
) -> ServingQualityReport {
  ServingQualityReport {
    subject: subject,
    suite: suite,
    reference_profile: reference_profile,
    max_selected_token_divergence_millinats: max_selected_token_divergence_millinats,
    task_score_delta_hundredths: task_score_delta_hundredths,
    how: how,
  }
}

// THE REQUIREMENT IS THE FALSIFIABLE BAR. Without thresholds a "quality assessment" is a sentence;
// with them, a report either clears them or does not, and the module computes which.
type QualityRequirement sole_constructor {
  identity: DeclarationRef
  required_artifact: DeclarationRef
  max_divergence_millinats: Nat
  min_task_score_delta_hundredths: Int
  rationale: NonEmptyStr
}

fn quality_requirement(
  identity: DeclarationRef,
  required_artifact: DeclarationRef,
  max_divergence_millinats: Nat,
  min_task_score_delta_hundredths: Int,
  rationale: NonEmptyStr,
) -> QualityRequirement {
  QualityRequirement {
    identity: identity,
    required_artifact: required_artifact,
    max_divergence_millinats: max_divergence_millinats,
    min_task_score_delta_hundredths: min_task_score_delta_hundredths,
    rationale: rationale,
  }
}

// NO BUILDER IS EXPORTED FOR THIS TYPE. It is the payload of the passing arm, so `QualityPassed`
// cannot be constructed outside this module however the coproduct is spelled -- the seal is on the
// thing the arm must carry, not on the arm's name.
type QualityVerdict sole_constructor {
  subject: ServingExecutionProfile
  requirement: DeclarationRef
  suite: DeclarationRef
  divergence_millinats: Nat
  task_score_delta_hundredths: Int
}

type ServingQualityAssessment
  = QualityPassed { verdict: QualityVerdict }
  | QualityFailed { subject: ServingExecutionProfile, requirement: DeclarationRef, violations: List<NonEmptyStr> }
  | QualityUnobserved { subject: ServingExecutionProfile, obligations: List<NonEmptyStr> }

// THE ONLY PRODUCER OF A PASSING VERDICT, and it is a comparison rather than an assertion.
fn assess_quality(report: ServingQualityReport, requirement: QualityRequirement) -> ServingQualityAssessment {
  if !declaration_ref_eq(a: report.subject.artifact, b: requirement.required_artifact) {
    QualityFailed {
      subject: report.subject,
      requirement: requirement.identity,
      violations: ["the report's subject is not the artifact this requirement is about, so it answers a different question" as NonEmptyStr],
    }
  } else {
    if report.max_selected_token_divergence_millinats <= requirement.max_divergence_millinats
      && report.task_score_delta_hundredths >= requirement.min_task_score_delta_hundredths {
      QualityPassed {
        verdict: QualityVerdict {
          subject: report.subject,
          requirement: requirement.identity,
          suite: report.suite,
          divergence_millinats: report.max_selected_token_divergence_millinats,
          task_score_delta_hundredths: report.task_score_delta_hundredths,
        },
      }
    } else {
      QualityFailed {
        subject: report.subject,
        requirement: requirement.identity,
        violations: concat(
          if report.max_selected_token_divergence_millinats > requirement.max_divergence_millinats {
            [join([
              "selected-token divergence of ", to_string(report.max_selected_token_divergence_millinats),
              " millinats exceeds the permitted ", to_string(requirement.max_divergence_millinats),
            ], "") as NonEmptyStr]
          } else { [] },
          if report.task_score_delta_hundredths < requirement.min_task_score_delta_hundredths {
            [join([
              "task score moved by ", to_string(report.task_score_delta_hundredths),
              " hundredths against a floor of ", to_string(requirement.min_task_score_delta_hundredths),
            ], "") as NonEmptyStr]
          } else { [] }),
      }
    }
  }
}

fn quality_assessment_subject(a: ServingQualityAssessment) -> ServingExecutionProfile {
  match a {
    QualityPassed { verdict: v } => v.subject
    QualityFailed { subject: s, requirement: _, violations: _ } => s
    QualityUnobserved { subject: s, obligations: _ } => s
  }
}

// ── RUNTIME FEASIBILITY, KEYED ON THE SAME EXACT PROFILE ──────────────────────────────────────
//
// A receipt proving "this loaded at 128K on runtime A" must not authorize 400K on runtime B, which
// is why this shares the execution-profile subject rather than carrying a looser one of its own.
// Its passing payload is likewise unexported.
type RuntimeFeasibilityWitness sole_constructor {
  subject: ServingExecutionProfile
  receipt: DeclarationRef
  admitted_context: TokenCount
  admitted_sequences: Nat
}

type RuntimeFeasibility
  = RuntimeFeasibilityEstablished { witness: RuntimeFeasibilityWitness }
  | RuntimeFeasibilityUnestablished { subject: ServingExecutionProfile, obligation: NonEmptyStr }

fn runtime_feasibility_subject(r: RuntimeFeasibility) -> ServingExecutionProfile {
  match r {
    RuntimeFeasibilityEstablished { witness: w } => w.subject
    RuntimeFeasibilityUnestablished { subject: s, obligation: _ } => s
  }
}

// ── WORKLOAD DEMAND IS ESTABLISHED OR IT IS A SCENARIO ────────────────────────────────────────
//
// THE PREVIOUS VERSION CARRIED 300,000 TOKENS AS AN ORDINARY VALUE with prose calling it a
// placeholder, and `covers_demand` then consumed it as a hard fact. A scenario number that settles a
// deployment is worse than no number, because the conclusion inherits a confidence the input never
// had. An unestablished demand must itself produce an obligation rather than waiting for some other
// evidence to be missing first.
type ContextReservePolicy sole_constructor {
  retained_context: TokenCount
  reserved_output: TokenCount
  tool_growth_reserve: TokenCount
}

fn context_reserve_policy(retained_context: TokenCount, reserved_output: TokenCount, tool_growth_reserve: TokenCount) -> ContextReservePolicy {
  ContextReservePolicy { retained_context: retained_context, reserved_output: reserved_output, tool_growth_reserve: tool_growth_reserve }
}

type WorkloadDemandStanding
  = WorkloadDemandEstablished {
      identity: DeclarationRef
      required_context: TokenCount
      population: DeclarationRef
      reserve: ContextReservePolicy
    }
  | WorkloadDemandUnestablished {
      identity: DeclarationRef
      scenario_value: TokenCount
      obligation: NonEmptyStr
    }

fn demand_context(d: WorkloadDemandStanding) -> TokenCount {
  match d {
    WorkloadDemandEstablished { identity: _, required_context: c, population: _, reserve: _ } => c
    WorkloadDemandUnestablished { identity: _, scenario_value: v, obligation: _ } => v
  }
}

fn demand_identity(d: WorkloadDemandStanding) -> DeclarationRef {
  match d {
    WorkloadDemandEstablished { identity: i, required_context: _, population: _, reserve: _ } => i
    WorkloadDemandUnestablished { identity: i, scenario_value: _, obligation: _ } => i
  }
}

fn demand_key(d: WorkloadDemandStanding) -> String {
  match d {
    WorkloadDemandEstablished { identity: i, required_context: c, population: _, reserve: _ } =>
      join(["est|", declaration_ref_display_key(ref: i), "|", to_string(token_count_value(t: c))], "")
    WorkloadDemandUnestablished { identity: i, scenario_value: v, obligation: _ } =>
      join(["unest|", declaration_ref_display_key(ref: i), "|", to_string(token_count_value(t: v))], "")
  }
}

// ── THE LOWER BOUND DISPROVES; IT CANNOT ESTABLISH ────────────────────────────────────────────
type WeightFit
  = WeightsNotRuledOutByLowerBound { per_rank_bytes: Nat, usable_bytes: Nat, slack_bytes: Nat }
  | WeightsImpossibleByLowerBound { per_rank_bytes: Nat, usable_bytes: Nat }
  | WeightFitUnderivable { because: NonEmptyStr }

// THE SCREEN TAKES BASIS POINTS BECAUSE THE REQUEST DOES. It divided by 100 against an integral
// percent, which could not represent the fractions this fleet's engines actually receive; the
// arithmetic is identical, at the precision the request carries.
fn usable_bytes_per_rank(fleet: FleetSnapshot, utilisation_basis_points: Nat) -> Nat {
  (fleet.bytes_per_host * utilisation_basis_points) / 10000
}

// AN OMITTED FRACTION HAS NO EFFECTIVE VALUE UNTIL IT IS RESOLVED AGAINST A REVISION, so this screen
// cannot run on it. Substituting a fraction here -- the revision's default, or the other route's 82%
// -- would make the lower bound generous in exactly the direction DESIGN section 5 forbids, and it
// would do so silently, on the one screen whose whole job is to rule impossible weights out. The
// canary's launch omits the fraction, so this is a reachable state rather than a defensive arm.
fn requested_utilisation_basis_points(r: VllmMemoryRequest) -> Nat? {
  match r.utilization {
    Absent => none
    Present { value: bp } => Present { value: basis_point_count(bp: bp) }
  }
}

fn weight_fit_against_envelope(fleet: FleetSnapshot, per_rank: Nat, basis_points: Nat) -> WeightFit {
  let usable = usable_bytes_per_rank(fleet: fleet, utilisation_basis_points: basis_points)
  if per_rank <= usable {
    WeightsNotRuledOutByLowerBound {
      per_rank_bytes: per_rank,
      usable_bytes: usable,
      slack_bytes: usable - per_rank,
    }
  } else {
    WeightsImpossibleByLowerBound { per_rank_bytes: per_rank, usable_bytes: usable }
  }
}

// CEILING, NOT FLOOR, and it refuses zero ranks itself rather than trusting its callers to guard.
// An exported helper whose contract depends on a guard somewhere else is a guard that will be
// forgotten at the next call site.
fn per_rank_bytes_ceiling(total: Nat, ranks: Nat) -> Nat? {
  if ranks == 0 { none } else { Present { value: (total + (ranks - 1)) / ranks } }
}

// ONE ARITHMETIC FOR EVERY PROVENANCE THAT CARRIES BYTES. The two arms that have a size run the same
// bound; only whether a size EXISTS differs between them, and that difference belongs in the match
// above rather than in two copies of the division.
fn weight_fit_from_bytes(bytes: Nat, c: DeploymentCandidate, fleet: FleetSnapshot, p: ServingDecisionParameters) -> WeightFit {
  match per_rank_bytes_ceiling(total: bytes, ranks: c.topology.tensor_parallel_degree) {
    Absent => WeightFitUnderivable { because: "a zero tensor-parallel degree has no per-rank share" as NonEmptyStr }
    Present { value: per_rank } =>
      match requested_utilisation_basis_points(r: p.memory_request) {
        Absent => WeightFitUnderivable {
          because: "this launch omits --gpu-memory-utilization, so its memory envelope is whatever its runtime revision defaults to; a lower-bound screen cannot run until that omission is resolved against the revision, and assuming a fraction here would make the screen generous in the one direction it must not be" as NonEmptyStr,
        }
        Present { value: bp } => weight_fit_against_envelope(fleet: fleet, per_rank: per_rank, basis_points: bp)
      }
  }
}

fn weight_fit_of(c: DeploymentCandidate, fleet: FleetSnapshot, p: ServingDecisionParameters) -> WeightFit {
  match c.artifact.footprint {
    FootprintUnread { obligation: o } => WeightFitUnderivable { because: o }
    FootprintReportedExternally { bytes: _, source: src } =>
      WeightFitUnderivable {
        because: join(["the only footprint for this artifact is a third-party report and not read on this fleet, so it cannot support a verdict here: ", src as String], "") as NonEmptyStr,
      }
    FootprintDeclaredByUpstreamAtRevision { bytes: b, revision: _, instrument: _ } =>
      weight_fit_from_bytes(bytes: b, c: c, fleet: fleet, p: p)
    FootprintObservedOnFleet { bytes: b, how: _ } =>
      weight_fit_from_bytes(bytes: b, c: c, fleet: fleet, p: p)
  }
}

fn hosts_consumed(c: DeploymentCandidate) -> Nat {
  c.topology.tensor_parallel_degree * c.topology.replica_count
}

// A DEGENERATE SHAPE IS NOT A CHEAP ONE. Zero replicas or zero ranks consume no hosts and would
// otherwise satisfy a fleet-fit test by serving nothing at all, then win every capacity axis they
// never had to pay for.
fn fleet_fits(c: DeploymentCandidate, fleet: FleetSnapshot) -> Bool {
  c.topology.replica_count > 0
    && c.topology.tensor_parallel_degree > 0
    && hosts_consumed(c: c) <= fleet.host_count
}

// THE SHARE OF EQUAL-CAPACITY REPLICAS LOST WHEN ONE REPLICA IS LOST -- not a physical blast radius,
// which would need rank-to-host partitions and declared failure domains this module does not carry.
fn replica_capacity_share_lost_percent(c: DeploymentCandidate) -> Nat {
  if c.topology.replica_count == 0 { 100 } else { 100 / c.topology.replica_count }
}

fn useful_context(p: ServingDecisionParameters, demand: WorkloadDemandStanding) -> Nat {
  if token_count_value(t: p.max_model_len) >= token_count_value(t: demand_context(d: demand)) {
    token_count_value(t: demand_context(d: demand))
  } else {
    token_count_value(t: p.max_model_len)
  }
}

fn covers_demand(p: ServingDecisionParameters, demand: WorkloadDemandStanding) -> Bool {
  token_count_value(t: p.max_model_len) >= token_count_value(t: demand_context(d: demand))
}

// ── EVERY DIMENSION CARRIES A DISPOSITION, AND "NOT VALUED" IS ONE OF THEM ────────────────────
//
// AN EARLIER ROSTER HAD TWO STATES -- funded, or unfunded and therefore an evidence obligation -- and
// that binary is wrong in a way that keeps the tuning alive. A dimension the operator DELIBERATELY
// DOES NOT VALUE would sit in the unfunded set forever, asking for measurements nobody intends to
// take, and the decision would never settle. Worse, redundancy was FUNDED: independent replica count
// and the capacity share lost to one replica failing were both ranked axes, so this module preferred
// four two-rank replicas over two four-rank ones for a reason the operator rejects outright.
//
// OPERATOR RULING (2026-09-09): REDUNDANCY HAS ZERO DECISION VALUE FOR THIS DEPLOYMENT. Not a low
// weight and not an outstanding obligation -- zero. Replica count, capacity share lost after a
// failure, physical failure-domain count and survival of one Spark failing must neither enter Pareto
// nor produce an evidence gap.
//
// SO REPLICA COUNT SURVIVES ONLY AS A DIAGNOSTIC. Two four-rank replicas may still be the better
// shape, but NOT because one survives a failure -- because two scheduler queues, two KV pools and two
// concurrent cold prefills may produce better measured service. That advantage must be earned through
// the outcomes it produces, not awarded for the count that might produce them. Rewarding the count
// directly is how a proxy becomes the objective.
type AxisDisposition
  = AxisHardConstraint
  | AxisFundedObjective
  | AxisObservedDiagnostic
  | AxisExcludedByOperatorPolicy { reason: NonEmptyStr }

type ServingAxis sole_constructor {
  identity: DeclarationRef
  goal: AxisGoal
  disposition: AxisDisposition
}

fn serving_axis(identity: DeclarationRef, goal: AxisGoal, disposition: AxisDisposition) -> ServingAxis {
  ServingAxis { identity: identity, goal: goal, disposition: disposition }
}

data ax_quality: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_quality")
data ax_weight_fit: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_weight_fit")
data ax_runtime_feasible: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_runtime_feasible")
data ax_context_covered: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_context_covered")
data ax_workload_established: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_workload_established")
data ax_memory_stability: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_memory_stability")
data ax_useful_context: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_useful_context")
data ax_accepted_task_goodput: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_accepted_task_goodput")
data ax_time_to_first_token: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_time_to_first_token")
data ax_inter_token_latency: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_inter_token_latency")
data ax_cotenant_impact: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_cotenant_impact")
data ax_queued_request_time: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_queued_request_time")
data ax_warm_conversation_capacity: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_warm_conversation_capacity")
data ax_independent_replicas: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_independent_replicas")
data ax_replica_capacity_share_lost: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_replica_capacity_share_lost")
data ax_physical_failure_domains: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_physical_failure_domains")
data ax_operating_power: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_operating_power")
data ax_operational_complexity: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "ax_operational_complexity")

data redundancy_exclusion_reason: NonEmptyStr = "operator ruling 2026-09-09: redundancy is not funded for this deployment. Excluded rather than weighted low, and excluded rather than left unfunded -- an unfunded dimension keeps asking for evidence, and evidence nobody intends to use is how a decision never settles" as NonEmptyStr

data serving_axis_roster: List<ServingAxis> = [
  serving_axis(identity: ax_quality, goal: HigherIsBetter, disposition: AxisHardConstraint),
  serving_axis(identity: ax_weight_fit, goal: HigherIsBetter, disposition: AxisHardConstraint),
  serving_axis(identity: ax_runtime_feasible, goal: HigherIsBetter, disposition: AxisHardConstraint),
  serving_axis(identity: ax_context_covered, goal: HigherIsBetter, disposition: AxisHardConstraint),
  serving_axis(identity: ax_workload_established, goal: HigherIsBetter, disposition: AxisHardConstraint),
  serving_axis(identity: ax_memory_stability, goal: HigherIsBetter, disposition: AxisHardConstraint),
  serving_axis(identity: ax_useful_context, goal: HigherIsBetter, disposition: AxisFundedObjective),
  serving_axis(identity: ax_accepted_task_goodput, goal: HigherIsBetter, disposition: AxisFundedObjective),
  serving_axis(identity: ax_time_to_first_token, goal: LowerIsBetter, disposition: AxisFundedObjective),
  serving_axis(identity: ax_inter_token_latency, goal: LowerIsBetter, disposition: AxisFundedObjective),
  serving_axis(identity: ax_cotenant_impact, goal: LowerIsBetter, disposition: AxisFundedObjective),
  serving_axis(identity: ax_queued_request_time, goal: LowerIsBetter, disposition: AxisFundedObjective),
  serving_axis(identity: ax_warm_conversation_capacity, goal: HigherIsBetter, disposition: AxisFundedObjective),
  serving_axis(identity: ax_independent_replicas, goal: HigherIsBetter, disposition: AxisObservedDiagnostic),
  serving_axis(identity: ax_replica_capacity_share_lost, goal: LowerIsBetter, disposition: AxisExcludedByOperatorPolicy { reason: redundancy_exclusion_reason }),
  serving_axis(identity: ax_physical_failure_domains, goal: HigherIsBetter, disposition: AxisExcludedByOperatorPolicy { reason: redundancy_exclusion_reason }),
  serving_axis(identity: ax_operating_power, goal: LowerIsBetter, disposition: AxisObservedDiagnostic),
  serving_axis(identity: ax_operational_complexity, goal: LowerIsBetter, disposition: AxisFundedObjective),
]

// POWER AND OPERATIONAL COMPLEXITY DISAPPEARED WHEN THIS ROSTER WAS RESTRUCTURED, and that was my
// defect rather than the operator's ruling: they excluded REDUNDANCY, not everything I happened to drop
// while rewriting. Both are restored with explicit dispositions.
//
// POWER IS A DIAGNOSTIC because nothing on this fleet meters it per deployment shape, and an axis that
// can never be read is an obligation nobody can discharge. OPERATIONAL COMPLEXITY IS FUNDED, because it
// is the whole reason this program exists: the operator is trying to own more of the stack with less
// hand-tuning, so a shape that is materially harder to operate is worse on a dimension they are
// actually paying for. It is unmeasured, which makes it an obligation rather than a free win for the
// simpler shape -- one eight-rank replica is not automatically simpler than two four-rank ones, and
// asserting that it is would be exactly the unearned ranking this roster exists to prevent.
data roster_restoration_note: NonEmptyStr = "power is a diagnostic because nothing meters it per shape; operational complexity is funded because reducing hand-tuning is the program's purpose, and it is unmeasured rather than assumed" as NonEmptyStr

fn axis_is_ranked(a: ServingAxis) -> Bool {
  match a.disposition {
    AxisHardConstraint => true
    AxisFundedObjective => true
    AxisObservedDiagnostic => false
    AxisExcludedByOperatorPolicy { reason: _ } => false
  }
}

fn axis_is_hard(a: ServingAxis) -> Bool {
  match a.disposition {
    AxisHardConstraint => true
    AxisFundedObjective => false
    AxisObservedDiagnostic => false
    AxisExcludedByOperatorPolicy { reason: _ } => false
  }
}

// ONLY RANKED AXES REACH THE SPINE. A diagnostic or an excluded dimension that appeared in `axes`
// would be compared, which is precisely what the ruling forbids -- and one appearing in a candidate's
// readings without being in `axes` is a projector contradiction the spine refuses. So both lists are
// derived from one roster rather than maintained beside it.
data serving_selection_axes: List<SelectionAxis> = map(
  filter(serving_axis_roster, a => axis_is_ranked(a: a)),
  a => SelectionAxis { identity: a.identity, goal: a.goal })

data id_constraint_authority: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_selection_constraints")

data serving_selection_constraints: List<HardConstraint> = map(
  filter(serving_axis_roster, a => axis_is_hard(a: a)),
  a => HardConstraint { identity: id_constraint_authority, axis: a.identity, bound_micro: 1 })

// THE MEASUREMENTS THAT DO NOT EXIST YET, and this list is now derived from the roster rather than
// authored beside it -- so an axis cannot be funded here and forgotten there. An EXCLUDED axis
// produces no obligation, which is the whole point of the disposition: the decision can settle without
// evidence for a dimension nobody values.
data unfunded_performance_axes: List<DeclarationRef> = [
  ax_operational_complexity,
  ax_memory_stability,
  ax_accepted_task_goodput,
  ax_time_to_first_token,
  ax_inter_token_latency,
  ax_cotenant_impact,
  ax_queued_request_time,
  ax_warm_conversation_capacity,
]

fn unfunded_axis_obligation(axis: DeclarationRef) -> NonEmptyStr {
  join([
    "no observation feeds ", declaration_ref_display_key(ref: axis),
    " for this exact execution profile, and this decision cannot be settled while a FUNDED dimension has no reading. Fleet-normalised: the comparison is all eight Sparks as one eight-rank replica against all eight as two four-rank replicas, not one replica against one",
  ], "") as NonEmptyStr
}

fn point(v: Int) -> OrderedClosedInterval<Int> { degenerate_interval(point: v) }

fn reading(axis: DeclarationRef, v: Int) -> AxisReading { AxisReading { axis: axis, interval_micro: point(v: v) } }

fn flag(b: Bool) -> Int { if b { 1 } else { 0 } }

// ── THE EVIDENCE SNAPSHOT IS A VALUE, NOT A NAME BESIDE ONE ───────────────────────────────────
//
// THE PREVIOUS VERSION PUT THE RUNTIME-FEASIBILITY POPULATION IN A MODULE GLOBAL and passed an
// `evidence_snapshot` DeclarationRef beside it, so adding a receipt changed the answer while the
// caller supplied an identical snapshot identity. Identities sat next to values without being joined
// to them, and the receipt then named authorities that did not describe what was computed.
//
// Here the evidence IS the snapshot. Its identity is DERIVED from its contents, so there is no second
// spelling to disagree with, and any change to the population changes the identity.
type ServingDeploymentEvidenceSnapshot sole_constructor {
  quality: List<ServingQualityAssessment>
  runtime_feasibility: List<RuntimeFeasibility>
  workload: WorkloadDemandStanding
  fleet: FleetSnapshot
  fleet_receipt: DeclarationRef
}

fn serving_evidence_snapshot(
  quality: List<ServingQualityAssessment>,
  runtime_feasibility: List<RuntimeFeasibility>,
  workload: WorkloadDemandStanding,
  fleet: FleetSnapshot,
  fleet_receipt: DeclarationRef,
) -> ServingDeploymentEvidenceSnapshot {
  ServingDeploymentEvidenceSnapshot {
    quality: quality,
    runtime_feasibility: runtime_feasibility,
    workload: workload,
    fleet: fleet,
    fleet_receipt: fleet_receipt,
  }
}

fn quality_assessment_key(a: ServingQualityAssessment) -> String {
  match a {
    QualityPassed { verdict: v } => join(["pass|", execution_profile_render(p: v.subject), "|", to_string(v.divergence_millinats)], "")
    QualityFailed { subject: s, requirement: _, violations: vs } => join(["fail|", execution_profile_render(p: s), "|", to_string(count(vs))], "")
    QualityUnobserved { subject: s, obligations: _ } => join(["unobs|", execution_profile_render(p: s)], "")
  }
}

fn runtime_feasibility_key(r: RuntimeFeasibility) -> String {
  match r {
    RuntimeFeasibilityEstablished { witness: w } =>
      join(["ok|", execution_profile_render(p: w.subject), "|", to_string(token_count_value(t: w.admitted_context))], "")
    RuntimeFeasibilityUnestablished { subject: s, obligation: _ } => join(["no|", execution_profile_render(p: s)], "")
  }
}

fn evidence_snapshot_key(e: ServingDeploymentEvidenceSnapshot) -> String {
  join([
    "q[", join(map(e.quality, a => quality_assessment_key(a: a)), ","), "]",
    "|r[", join(map(e.runtime_feasibility, r => runtime_feasibility_key(r: r)), ","), "]",
    "|w", demand_key(d: e.workload),
    "|f", to_string(e.fleet.host_count), "x", to_string(e.fleet.bytes_per_host),
  ], "")
}

// ── THE CHOICE DOMAIN, AND COMPLETENESS AS A STRUCTURAL JOIN ──────────────────────────────────
//
// The expected roster is DERIVED from the declared value populations, so a winner cannot be obtained
// by omitting the candidate that would have beaten it. Two repairs over the previous version: the
// combination key is a STRUCTURAL value with its own equality rather than a rendered string, and a
// duplicate in the DECLARED domain refuses -- previously two identical expected keys both matched the
// same single actual row, so a duplicated declaration passed unnoticed.
type CombinationKey sole_constructor {
  artifact: DeclarationRef
  topology: TopologyShape
}

fn combination_key_eq(a: CombinationKey, b: CombinationKey) -> Bool {
  declaration_ref_eq(a: a.artifact, b: b.artifact) && topology_shape_eq(a: a.topology, b: b.topology)
}

fn combination_key_render(k: CombinationKey) -> String {
  join([declaration_ref_display_key(ref: k.artifact), "|tp", to_string(k.topology.tensor_parallel_degree), "|x", to_string(k.topology.replica_count)], "")
}

type ServingDeploymentChoiceDomain sole_constructor {
  artifacts: List<ModelArtifact>
  topologies: List<TopologyShape>
  parameters: ServingDecisionParameters
}

fn serving_deployment_domain(artifacts: List<ModelArtifact>, topologies: List<TopologyShape>, parameters: ServingDecisionParameters) -> ServingDeploymentChoiceDomain {
  ServingDeploymentChoiceDomain { artifacts: artifacts, topologies: topologies, parameters: parameters }
}

fn expected_combinations(d: ServingDeploymentChoiceDomain) -> List<CombinationKey> {
  flat_map(d.artifacts, a => map(d.topologies, t => CombinationKey { artifact: a.identity, topology: t }))
}

fn candidate_combination(c: DeploymentCandidate) -> CombinationKey {
  CombinationKey { artifact: c.artifact.identity, topology: c.topology }
}

fn key_occurrences(keys: List<CombinationKey>, k: CombinationKey) -> Nat {
  fold(keys, init: 0, f: (acc, other) => if combination_key_eq(a: other, b: k) { acc + 1 } else { acc })
}

fn domain_key_render(d: ServingDeploymentChoiceDomain) -> String {
  join([
    join(map(expected_combinations(d: d), k => combination_key_render(k: k)), ","),
    "|", parameters_render(p: d.parameters),
  ], "")
}

type ServingDeploymentCandidateField sole_constructor {
  identity: DeclarationRef
  domain: ServingDeploymentChoiceDomain
  candidates: List<DeploymentCandidate>
}

fn serving_candidate_field(identity: DeclarationRef, domain: ServingDeploymentChoiceDomain, candidates: List<DeploymentCandidate>) -> ServingDeploymentCandidateField {
  ServingDeploymentCandidateField { identity: identity, domain: domain, candidates: candidates }
}

// THE FIELD'S REVISION IS DERIVED FROM ITS CONTENT, so a persisted receipt distinguishes the old
// field from the same declaration name carrying changed candidates.
fn candidate_field_revision(f: ServingDeploymentCandidateField) -> String {
  join([
    declaration_ref_display_key(ref: f.identity),
    "|dom", domain_key_render(d: f.domain),
    "|cand", join(map(f.candidates, c => combination_key_render(k: candidate_combination(c: c))), ","),
  ], "")
}

type ServingFieldStanding
  = ServingFieldEstablished
  | ServingFieldUnestablished { causes: List<NonEmptyStr> }

fn establish_serving_candidate_field(field: ServingDeploymentCandidateField) -> ServingFieldStanding {
  let expected = expected_combinations(d: field.domain)
  let actual = map(field.candidates, c => candidate_combination(c: c))
  let missing = filter(expected, k => key_occurrences(keys: actual, k: k) == 0)
  let extra = filter(actual, k => key_occurrences(keys: expected, k: k) == 0)
  let duplicated_actual = filter(expected, k => key_occurrences(keys: actual, k: k) > 1)
  let duplicated_declared = filter(expected, k => key_occurrences(keys: expected, k: k) > 1)
  let param_defect = match parameters_defect(p: field.domain.parameters) {
    Present { value: d } => [d]
    Absent => []
  }
  if count(missing) == 0 && count(extra) == 0 && count(duplicated_actual) == 0
    && count(duplicated_declared) == 0 && count(param_defect) == 0 {
    ServingFieldEstablished
  } else {
    ServingFieldUnestablished {
      causes: concat(
        concat(
          concat(
            map(missing, k => join(["the declared domain admits ", combination_key_render(k: k), " and the field does not contain it, so the field is not complete over its own domain"], "") as NonEmptyStr),
            map(extra, k => join(["the field carries ", combination_key_render(k: k), ", which the declared domain does not admit"], "") as NonEmptyStr)),
          concat(
            map(duplicated_actual, k => join(["the combination ", combination_key_render(k: k), " appears more than once among the candidates, so the population is ambiguous"], "") as NonEmptyStr),
            map(duplicated_declared, k => join(["the DECLARED domain produces ", combination_key_render(k: k), " more than once, so its expected population is ambiguous and a duplicate would be satisfied by a single candidate"], "") as NonEmptyStr))),
        param_defect),
    }
  }
}

// ── THE PROJECTOR ─────────────────────────────────────────────────────────────────────────────
//
// Domain-typed facts collapse to the generic scalar exactly once, here. An unread fact becomes an
// AxisGap and never a zero, because a zero is a reading and would rank.
fn quality_for(profile: ServingExecutionProfile, e: ServingDeploymentEvidenceSnapshot) -> ServingQualityAssessment {
  fold(e.quality, init: QualityUnobserved {
    subject: profile,
    obligations: ["no quality assessment in this evidence snapshot has this exact execution profile as its subject. The same weights at two tensor-parallel degrees are deterministically different models -- 2.2387 nats apart against a bit-identical within-topology envelope, per gunbc.spark.tensor_parallel_comparison -- so a receipt for another profile does not answer for this one" as NonEmptyStr],
  }, f: (acc, a) =>
    if execution_profile_eq(a: quality_assessment_subject(a: a), b: profile) { a } else { acc })
}

fn runtime_for(profile: ServingExecutionProfile, e: ServingDeploymentEvidenceSnapshot) -> RuntimeFeasibility {
  fold(e.runtime_feasibility, init: RuntimeFeasibilityUnestablished {
    subject: profile,
    obligation: "no runtime observation exists for this exact execution profile: that the model loads at this degree, that the allocator admits the requested context by block population rather than by a printed pool size, and that the required sequence population is admissible. A lower bound that does not rule the candidate out is not a demonstration that it runs" as NonEmptyStr,
  }, f: (acc, r) =>
    if execution_profile_eq(a: runtime_feasibility_subject(r: r), b: profile) { r } else { acc })
}

fn quality_reading(profile: ServingExecutionProfile, e: ServingDeploymentEvidenceSnapshot) -> AxisReading? {
  match quality_for(profile: profile, e: e) {
    QualityPassed { verdict: _ } => Present { value: reading(axis: ax_quality, v: 1) }
    QualityFailed { subject: _, requirement: _, violations: _ } => Present { value: reading(axis: ax_quality, v: 0) }
    QualityUnobserved { subject: _, obligations: _ } => none
  }
}

fn quality_gap(profile: ServingExecutionProfile, e: ServingDeploymentEvidenceSnapshot) -> List<AxisGap> {
  match quality_for(profile: profile, e: e) {
    QualityUnobserved { subject: _, obligations: os } => map(os, o => AxisGap { axis: ax_quality, cause: o })
    QualityPassed { verdict: _ } => []
    QualityFailed { subject: _, requirement: _, violations: _ } => []
  }
}

fn runtime_reading(profile: ServingExecutionProfile, e: ServingDeploymentEvidenceSnapshot) -> AxisReading? {
  match runtime_for(profile: profile, e: e) {
    RuntimeFeasibilityEstablished { witness: _ } => Present { value: reading(axis: ax_runtime_feasible, v: 1) }
    RuntimeFeasibilityUnestablished { subject: _, obligation: _ } => none
  }
}

fn runtime_gap(profile: ServingExecutionProfile, e: ServingDeploymentEvidenceSnapshot) -> List<AxisGap> {
  match runtime_for(profile: profile, e: e) {
    RuntimeFeasibilityUnestablished { subject: _, obligation: o } => [AxisGap { axis: ax_runtime_feasible, cause: o }]
    RuntimeFeasibilityEstablished { witness: _ } => []
  }
}

fn weight_fit_reading(c: DeploymentCandidate, e: ServingDeploymentEvidenceSnapshot, p: ServingDecisionParameters) -> AxisReading? {
  match weight_fit_of(c: c, fleet: e.fleet, p: p) {
    WeightsNotRuledOutByLowerBound { per_rank_bytes: _, usable_bytes: _, slack_bytes: _ } =>
      Present { value: reading(axis: ax_weight_fit, v: flag(b: fleet_fits(c: c, fleet: e.fleet))) }
    WeightsImpossibleByLowerBound { per_rank_bytes: _, usable_bytes: _ } => Present { value: reading(axis: ax_weight_fit, v: 0) }
    WeightFitUnderivable { because: _ } => none
  }
}

fn weight_fit_gap(c: DeploymentCandidate, e: ServingDeploymentEvidenceSnapshot, p: ServingDecisionParameters) -> List<AxisGap> {
  match weight_fit_of(c: c, fleet: e.fleet, p: p) {
    WeightFitUnderivable { because: b } => [AxisGap { axis: ax_weight_fit, cause: b }]
    WeightsNotRuledOutByLowerBound { per_rank_bytes: _, usable_bytes: _, slack_bytes: _ } => []
    WeightsImpossibleByLowerBound { per_rank_bytes: _, usable_bytes: _ } => []
  }
}

// AN UNESTABLISHED WORKLOAD IS ITS OWN GAP on its own hard-bounded axis, so a scenario number cannot
// settle a deployment by hiding behind whichever other evidence happens to be missing first.
fn workload_reading(e: ServingDeploymentEvidenceSnapshot) -> AxisReading? {
  match e.workload {
    WorkloadDemandEstablished { identity: _, required_context: _, population: _, reserve: _ } =>
      Present { value: reading(axis: ax_workload_established, v: 1) }
    WorkloadDemandUnestablished { identity: _, scenario_value: _, obligation: _ } => none
  }
}

fn workload_gap(e: ServingDeploymentEvidenceSnapshot) -> List<AxisGap> {
  match e.workload {
    WorkloadDemandUnestablished { identity: _, scenario_value: _, obligation: o } => [AxisGap { axis: ax_workload_established, cause: o }]
    WorkloadDemandEstablished { identity: _, required_context: _, population: _, reserve: _ } => []
  }
}

fn optional_reading(r: AxisReading?) -> List<AxisReading> {
  match r {
    Present { value: v } => [v]
    Absent => []
  }
}

fn candidate_readings(c: DeploymentCandidate, e: ServingDeploymentEvidenceSnapshot, p: ServingDecisionParameters) -> List<AxisReading> {
  concat(
    concat(
      concat(optional_reading(r: quality_reading(profile: execution_profile_of(c: c, p: p), e: e)),
             optional_reading(r: runtime_reading(profile: execution_profile_of(c: c, p: p), e: e))),
      concat(optional_reading(r: weight_fit_reading(c: c, e: e, p: p)),
             optional_reading(r: workload_reading(e: e)))),
    [
      reading(axis: ax_context_covered, v: flag(b: covers_demand(p: p, demand: e.workload))),
      reading(axis: ax_useful_context, v: useful_context(p: p, demand: e.workload)),
    ])
}

fn candidate_gaps(c: DeploymentCandidate, e: ServingDeploymentEvidenceSnapshot, p: ServingDecisionParameters) -> List<AxisGap> {
  concat(
    concat(
      concat(quality_gap(profile: execution_profile_of(c: c, p: p), e: e),
             runtime_gap(profile: execution_profile_of(c: c, p: p), e: e)),
      concat(weight_fit_gap(c: c, e: e, p: p), workload_gap(e: e))),
    map(unfunded_performance_axes, a => AxisGap { axis: a, cause: unfunded_axis_obligation(axis: a) }))
}

// THE DIAGNOSTICS ARE COMPUTED AND NOT RANKED. Replica count is still worth reading -- it is how a
// reader sees what shape a candidate is -- and it reaches no comparison. The excluded axes are not
// computed at all: a number nobody may use is not worth deriving.
fn candidate_diagnostics(c: DeploymentCandidate) -> List<AxisReading> {
  [reading(axis: ax_independent_replicas, v: c.topology.replica_count)]
}

fn project_candidate(c: DeploymentCandidate, e: ServingDeploymentEvidenceSnapshot, p: ServingDecisionParameters) -> ParetoEntry {
  ParetoEntry {
    identity: c.identity,
    display_label: c.label,
    readings: candidate_readings(c: c, e: e, p: p),
    missing_inputs: candidate_gaps(c: c, e: e, p: p),
  }
}

// ── THE DECISION INPUT: ONE VALUE, ONE DERIVED IDENTITY, NO SECOND SPELLING ────────────────────
//
// Every load-bearing input arrives as a VALUE and the snapshot identity is DERIVED from all of them,
// so there is nothing to disagree with. The previous version accepted `subject_identity`,
// `fleet_identity` and an independently authored `DecisionAssessment` beside the values they were
// supposed to describe, used none of them for the computation, and let a receipt name authorities
// that did not correspond to what was computed. The assessment is now derived here rather than
// accepted, which removes the last place two spellings could differ.
type ServingDeploymentDecisionInput sole_constructor {
  field: ServingDeploymentCandidateField
  evidence: ServingDeploymentEvidenceSnapshot
  quality_requirement: QualityRequirement
  selection_policy: DeclarationRef
}

fn serving_decision_input(
  field: ServingDeploymentCandidateField,
  evidence: ServingDeploymentEvidenceSnapshot,
  quality_requirement: QualityRequirement,
  selection_policy: DeclarationRef,
) -> ServingDeploymentDecisionInput {
  ServingDeploymentDecisionInput {
    field: field,
    evidence: evidence,
    quality_requirement: quality_requirement,
    selection_policy: selection_policy,
  }
}

// THE DECISION'S IDENTITY. Change the fleet, the demand, the quality requirement, the evidence
// population, the fixed parameters or the candidate roster and this string changes; change nothing
// and it does not. That is the property the receipt's named authorities could not carry.
fn decision_snapshot_key(input: ServingDeploymentDecisionInput) -> String {
  join([
    "field{", candidate_field_revision(f: input.field), "}",
    "|evidence{", evidence_snapshot_key(e: input.evidence), "}",
    "|requirement{", declaration_ref_display_key(ref: input.quality_requirement.identity),
    "|", to_string(input.quality_requirement.max_divergence_millinats),
    "|", to_string(input.quality_requirement.min_task_score_delta_hundredths), "}",
    "|policy{", declaration_ref_display_key(ref: input.selection_policy), "}",
  ], "")
}

// ── THE SUBJECT CLOSURE, DERIVED FROM THE INPUT ───────────────────────────────────────────────
data id_subject: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_deployment_subject")
data id_var_topology: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "var_fleet_topology")
data id_term_service: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "term_measured_service")
data id_param_execution: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "param_execution_parameters")
data id_region: DeclarationRef = decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_topology_region")

data var_fleet_topology: DecisionVariable = DecisionVariable { identity: id_var_topology }

// ── THE SUBJECT'S OBJECTIVE IS MEASURED SERVICE, NOT FAILURE ISOLATION ────────────────────────
//
// THE AXIS ROSTER EXCLUDED REDUNDANCY AND THE DECISION SUBJECT DID NOT, which meant every control I
// wrote for that exclusion could pass while the generic closure handed to std.decision still declared
// its one objective term to be `term_failure_isolation`, with the topology sensitivity, physical model
// and causal model all expressed in terms of it. The controls inspected axis identities, gaps,
// diagnostics and pending authorization; none inspected the DecisionSubject's term population, so the
// residue sat exactly where they could not see it. That is a lesson about the controls as much as the
// model: they tested the layer I had just edited.
//
// The term is now MEASURED SERVICE, whose sensitivity to topology is precisely what the experiment
// exists to establish. It is deliberately NOT cited to an external authority: upstream documents that a
// tensor-parallel replica fails as a unit, which grounded the old isolation term perfectly well and
// grounds nothing about goodput or latency. Whether four ranks or eight serve this workload better is a
// fact about THIS fleet and this model, so it carries a read obligation until this fleet answers it.
data term_measured_service: ObjectiveTerm = ObjectiveTerm {
  identity: id_term_service,
  ground: TranscribedUncited {
    read_obligation: "how measured service responds to tensor-parallel degree is unestablished for this model on this fleet. It is not an upstream fact: vendor documentation describes what tensor parallelism DOES, not which degree serves this workload better, and the outgoing model's numbers were taken on different weights at a different quantisation. The experiment arm exists to establish it" as NonEmptyStr,
  },
}

data param_execution_parameters: ContextParameter = ContextParameter { identity: id_param_execution }
data constraint_cell: DecisionConstraint = DecisionConstraint { identity: id_constraint_authority }
data serving_topology_region: DecisionRegion = DecisionRegion { identity: id_region }

data serving_objective: ObjectiveMeasure = ObjectiveMeasure {
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_objective"),
  goal: HigherIsBetter,
  terms: [term_measured_service],
}

data serving_choice_domain_cell: ChoiceDomain = ChoiceDomain {
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_choice_domain_cell"),
  variables: [var_fleet_topology],
}

data serving_deployment_subject: DecisionSubject = DecisionSubject {
  identity: id_subject,
  question: "which whole-fleet deployment shape serves this exact artifact best at the declared execution profile, measured over the funded service outcomes" as NonEmptyStr,
  parameters: [param_execution_parameters],
  constraints: [constraint_cell],
  objective: serving_objective,
  choice_domain: serving_choice_domain_cell,
}

// THE SENSITIVITY IS UNESTABLISHED RATHER THAN ASSERTED MONOTONE. The old row claimed measured service
// rises monotonically with the topology variable, which was really the isolation claim wearing a new
// name -- more replicas, more isolation, monotone. Nothing establishes that goodput or latency behaves
// monotonically in tensor-parallel degree, and there is good reason to think it does not: more ranks buy
// memory headroom and cost per-token synchronisation, which pull opposite ways. So the relation is an
// obligation, and the physical and causal models say so too rather than citing a vendor page that
// answers a different question.
fn assessment_for(input: ServingDeploymentDecisionInput) -> DecisionAssessment {
  DecisionAssessment {
    subject: serving_deployment_subject,
    sensitivities: [
      SensitivityUnestablished {
        term: id_term_service,
        variable: id_var_topology,
        obligation: "how measured service responds to tensor-parallel degree is unmeasured for this model on this fleet, and is not assumed monotone: more ranks buy memory headroom and cost per-token synchronisation, which pull in opposite directions" as NonEmptyStr,
      },
    ],
    constraints: [
      ConstraintSatisfied {
        constraint: id_constraint_authority,
        evidence: "quality, weight fit, runtime feasibility, context coverage, workload standing and memory stability are each bounded at one and excluded before dominance" as NonEmptyStr,
      },
    ],
    parameters: [
      ParameterBound {
        parameter: id_param_execution,
        evidence: join(["every candidate is built at exactly one declared execution profile and carries no field in which to disagree with it: ", parameters_render(p: input.field.domain.parameters)], "") as NonEmptyStr,
      },
    ],
    selected_candidate: Absent,
    term_drops: [],
    physical_model: PhysicalModelUnestablished {
      subject: id_subject,
      read_obligation: "the funded service outcomes have no physical model for this model on this fleet: no accepted-task goodput, time to first token, inter-token latency, co-tenant impact, queue time or warm-conversation capacity has been measured at any topology" as NonEmptyStr,
    },
    causal_model: CausalModelUnestablished {
      subject: id_subject,
      read_obligation: "no coupling between tensor-parallel degree and measured service has been observed on this fleet. The vendor's documented unit-failure behaviour grounded the retired isolation term and grounds nothing here" as NonEmptyStr,
    },
  }
}

// ── THE SEALED RESULT, AND IT IS A SHAPE RATHER THAN A LAUNCH ─────────────────────────────────
type SelectedServingDeployment sole_constructor {
  input: ServingDeploymentDecisionInput
  candidate: DeploymentCandidate
  receipt: SelectionReceipt
  snapshot_key: String
}

type ServingDeploymentSelection
  = ServingDeploymentSelected { selected: SelectedServingDeployment }
  | ServingDeploymentNeedsEvidence { needs: List<SelectionEvidenceNeed> }
  | ServingDeploymentNeedsPolicy { survivors: List<DeclarationRef> }
  | NoFeasibleServingDeployment { causes: List<NonEmptyStr> }
  | ServingDeploymentSelectionRefused { defects: List<NonEmptyStr> }

fn resolve_in_field(field: ServingDeploymentCandidateField, identity: DeclarationRef) -> DeploymentCandidate? {
  fold(field.candidates, init: none, f: (acc, k) =>
    match acc {
      Present { value: found } => Present { value: found }
      Absent => if declaration_ref_eq(a: k.identity, b: identity) { Present { value: k } } else { none }
    })
}

fn select_serving_deployment(input: ServingDeploymentDecisionInput) -> ServingDeploymentSelection {
  match establish_serving_candidate_field(field: input.field) {
    ServingFieldUnestablished { causes: c } => ServingDeploymentSelectionRefused { defects: c }
    ServingFieldEstablished =>
      match select_realization(
        assessment: assessment_for(input: input),
        candidate_field_identity: input.field.identity,
        field: map(input.field.candidates, c => project_candidate(c: c, e: input.evidence, p: input.field.domain.parameters)),
        axes: serving_selection_axes,
        constraints: serving_selection_constraints,
        constraint_authority: id_constraint_authority,
        policy: UniqueSurvivorRequired { identity: input.selection_policy },
        evidence_snapshot: input.evidence.fleet_receipt,
      ) {
        SelectedWithin { candidate: e, receipt: r } =>
          match resolve_in_field(field: input.field, identity: e.identity) {
            Absent => ServingDeploymentSelectionRefused {
              defects: ["the spine selected an identity that resolves to no candidate in the sealed field, which is a projector contradiction rather than a decision" as NonEmptyStr],
            }
            Present { value: chosen } => ServingDeploymentSelected {
              selected: SelectedServingDeployment {
                input: input,
                candidate: chosen,
                receipt: r,
                snapshot_key: decision_snapshot_key(input: input),
              },
            }
          }
        SelectionNeedsEvidence { needs: n } => ServingDeploymentNeedsEvidence { needs: n }
        SelectionNeedsPolicy { survivors: s } => ServingDeploymentNeedsPolicy { survivors: s }
        NoFeasibleRealization { causes: c } => NoFeasibleServingDeployment { causes: c }
        RealizationSelectionRefused { defects: d } => ServingDeploymentSelectionRefused { defects: d }
        CandidateFieldUnestablished { causes: c } => ServingDeploymentSelectionRefused { defects: c }
      }
  }
}

// ── THE OUTPUT IS A SHAPE AWAITING FABRIC PLACEMENT, NOT A LAUNCH ─────────────────────────────
//
// TWO EARLIER VERSIONS OVERSTATED THIS BOUNDARY. The first returned a single ReplicaProfile and
// called it a launch profile, which could not even express the multi-replica shape the decision
// turned on. The second returned a `ServingDeploymentPlan` with `LaunchAdmitted`, while its own
// rank indices were derived positionally from a host count and no failure-domain identity existed
// anywhere in the module. A plan that cannot say which host holds which rank is not a launch plan.
//
// So the result says what it is: a SHAPE, admitted for placement. The fabric cut binds these replica
// shapes to exact hosts, network groups, failure domains, endpoints and launch arguments, and only
// that relation may mint a launch. This keeps rank partitions deferred without understating it.
type ServingReplicaShape sole_constructor {
  tensor_parallel_degree: Nat
  replica_ordinal: Nat
}

type ServingDeploymentShape sole_constructor {
  artifact: DeclarationRef
  candidate: DeclarationRef
  parameters: ServingDecisionParameters
  replicas: List<ServingReplicaShape>
  hosts_required: Nat
  hosts_unassigned: Nat
  selected_by: SelectionReceipt
  snapshot_key: String
}

fn replica_shapes_loop(degree: Nat, remaining: Nat, acc: List<ServingReplicaShape>) -> List<ServingReplicaShape> {
  if remaining == 0 {
    acc
  } else {
    replica_shapes_loop(
      degree: degree,
      remaining: remaining - 1,
      acc: concat([ServingReplicaShape { tensor_parallel_degree: degree, replica_ordinal: remaining - 1 }], acc),
    )
  }
}

fn shape_of(selected: SelectedServingDeployment) -> ServingDeploymentShape {
  ServingDeploymentShape {
    artifact: selected.candidate.artifact.identity,
    candidate: selected.candidate.identity,
    parameters: selected.input.field.domain.parameters,
    replicas: replica_shapes_loop(degree: selected.candidate.topology.tensor_parallel_degree, remaining: selected.candidate.topology.replica_count, acc: []),
    hosts_required: hosts_consumed(c: selected.candidate),
    hosts_unassigned: selected.input.evidence.fleet.host_count - hosts_consumed(c: selected.candidate),
    selected_by: selected.receipt,
    snapshot_key: selected.snapshot_key,
  }
}

type ShapeAdmission
  = ShapeAdmittedForPlacement { shape: ServingDeploymentShape }
  | FabricPlacementRequired { because: NonEmptyStr }

// THE FIELD SIZE THE RECEIPT RECORDS. One identity means the decision was settled in advance and
// said so. It does NOT establish that the one candidate was the complete intended domain -- the
// completeness join answers that, and the two are deliberately separate questions.
fn compared_candidate_count(r: SelectionReceipt) -> Nat {
  match r.candidate_field_standing {
    CandidateFieldEstablished { identities: ids } => count(ids)
    CandidateFieldUnestablishedStanding { causes: _ } => 0
  }
}

fn admit_shape(s: ServingDeploymentSelection) -> ShapeAdmission {
  match s {
    ServingDeploymentSelected { selected: sel } => ShapeAdmittedForPlacement { shape: shape_of(selected: sel) }
    ServingDeploymentNeedsEvidence { needs: n } =>
      FabricPlacementRequired { because: join(["the decision is under-evidenced: ", to_string(count(n)), " obligation(s) outstanding"], "") as NonEmptyStr }
    ServingDeploymentNeedsPolicy { survivors: s2 } =>
      FabricPlacementRequired { because: join([to_string(count(s2)), " candidates are non-dominated and no policy separates them"], "") as NonEmptyStr }
    NoFeasibleServingDeployment { causes: _ } =>
      FabricPlacementRequired { because: "no candidate satisfies the hard constraints" as NonEmptyStr }
    ServingDeploymentSelectionRefused { defects: _ } =>
      FabricPlacementRequired { because: "the selection itself is defective and states so rather than choosing" as NonEmptyStr }
  }
}

// ── THE TWO PRODUCTION SUBJECTS, AND WHY BOTH RETURN OBLIGATIONS ──────────────────────────────
//
// Neither answers with a deployment shape, and that is the correct answer rather than a gap in the
// machinery. Each carries obligations on SEVERAL independent grounds, which matters: a single
// blocking axis would mean the whole question turned on one measurement, and filling it would let
// everything else stay invisible.
//
// Standing obligations for both: no quality assessment for any exact execution profile; no runtime
// feasibility observation for any profile; an UNESTABLISHED workload demand; and ten unfunded
// performance dimensions (stability, decode latency, TTFT, victim inter-token latency, prefill
// goodput, accepted-task goodput, warm-conversation capacity, physical failure domains, operating
// power, operational complexity). GLM additionally has no footprint read on this fleet.
//
// THAT IS THE FUNCTION ENDING THE TUNING RATHER THAN JOINING IT. The previous version funded five
// axes and would have answered the moment two of them filled; this one names every dimension that
// could change the decision, so the answer stays an obligation until they are measured. No weights
// are guessed and no axis is dropped to obtain a winner.
data spark_runtime: RuntimeRevision = runtime_revision(
  image: "the serving container image currently deployed on the Sparks" as NonEmptyStr,
  vllm_revision: "the vLLM revision pinned in that image" as NonEmptyStr,
)

data serving_parameter_standings: List<ParameterStandingRow> = [
  parameter_row(parameter: "max_model_len" as NonEmptyStr, provenance: ParameterDecided {
    decider: "operator, 2026-09-08" as NonEmptyStr,
    purpose: "an experimental serving window, matching what the GLM canary runs. NOT a workload derivation: to become a production window it must be SELECTED from context coverage, memory feasibility, quality and latency evidence. A previous revision carried 300,000, authored with nothing behind it" as NonEmptyStr }),
  parameter_row(parameter: "memory_request" as NonEmptyStr, provenance: ParameterDecided {
    decider: "operator, 2026-09-05" as NonEmptyStr,
    purpose: "a utilisation fraction observed safe for the outgoing DeepSeek profile, with no explicit KV-cache reservation beside it. Nothing derives it: the derived answer needs per-rank weight residency, static runtime allocation, graph and workspace allocation, the KV plan at the declared window and a host reserve -- artifact bytes over total memory is not that calculation" as NonEmptyStr }),
  parameter_row(parameter: "max_num_batched_tokens" as NonEmptyStr, provenance: ParameterDecided {
    decider: "operator, 2026-09-08" as NonEmptyStr,
    purpose: "pinned so the value is a choice rather than an inheritance from an absorbed NVML refusal. The trade behind it was measured on DeepSeek and GLM must reacquire it rather than inherit the number" as NonEmptyStr }),
  parameter_row(parameter: "max_num_seqs" as NonEmptyStr, provenance: ParameterDecided {
    decider: "operator policy carried from the DeepSeek profile" as NonEmptyStr,
    purpose: "a conservative interactive ceiling. DECIDED rather than observed FOR THIS SUBJECT: the number was measured in one DeepSeek launch scenario and is explicitly barred from travelling to another model, quantisation or KV layout, so for GLM it carries no measurement at all" as NonEmptyStr }),
  parameter_row(parameter: "enable_prefix_caching" as NonEmptyStr, provenance: ParameterObserved {
    instrument: "read from the live DeepSeek group's engine argv on spark-3bd5, 2026-09-08: --enable-prefix-caching is present" as NonEmptyStr }),
  parameter_row(parameter: "executor" as NonEmptyStr, provenance: ParameterObserved {
    instrument: "read from the same live argv: --distributed-executor-backend ray" as NonEmptyStr }),
  parameter_row(parameter: "kv_layout" as NonEmptyStr, provenance: ParameterUnestablished {
    obligation: "this row carries the DeepSeek MLA layout (fp8_ds_mla), correct for the artifact THAT route serves and NOT established for GLM. The GLM canary launches with plain --kv-cache-dtype fp8, and the internal format the backend then selects is a separate fact from the flag. A GLM profile needs its own read-back" as NonEmptyStr }),
  parameter_row(parameter: "speculative" as NonEmptyStr, provenance: ParameterDecided {
    decider: "operator, first-boot policy" as NonEmptyStr,
    purpose: "disabled to isolate the base model path. Its quality standing is separately unobserved, so admitting it needs a receipt rather than a default" as NonEmptyStr }),
  parameter_row(parameter: "runtime" as NonEmptyStr, provenance: ParameterUnestablished {
    obligation: "the image and vLLM revision are carried as descriptive strings rather than an exact digest, so two different images satisfy this row identically. An exact image digest read from the host is the missing observation, and it is load-bearing: a native-FP8 GLM arm needs a runtime proven to register that architecture, which the EXL3 image is not known to do" as NonEmptyStr }),
]

data serving_parameter_field_names: List<NonEmptyStr> = [
  "max_model_len" as NonEmptyStr,
  "memory_request" as NonEmptyStr,
  "max_num_batched_tokens" as NonEmptyStr,
  "max_num_seqs" as NonEmptyStr,
  "enable_prefix_caching" as NonEmptyStr,
  "executor" as NonEmptyStr,
  "kv_layout" as NonEmptyStr,
  "speculative" as NonEmptyStr,
  "runtime" as NonEmptyStr,
]

fn rows_for_field(field: NonEmptyStr) -> List<ParameterStandingRow> {
  filter(serving_parameter_standings, r => (r.parameter as String) == (field as String))
}

type ParameterStandingCompleteness
  = AllParametersHaveStanding { unestablished: List<NonEmptyStr> }
  | ParametersWithoutStanding { fields: List<NonEmptyStr> }
  | ParametersWithConflictingStandings { fields: List<NonEmptyStr> }

// EVERY FIELD MUST HAVE EXACTLY ONE ROW, joined against the field names rather than counted, because a
// count agrees with itself while naming no field. AND THE COMPLETE ARM STILL CARRIES THE UNESTABLISHED
// FIELDS: "every parameter has a standing" and "every parameter is established" are different claims,
// and conflating them would let a roster of nine obligations report as done.
fn parameter_standing_completeness() -> ParameterStandingCompleteness {
  let missing = filter(serving_parameter_field_names, f => count(rows_for_field(field: f)) == 0)
  let conflicting = filter(serving_parameter_field_names, f => count(rows_for_field(field: f)) > 1)
  if count(conflicting) > 0 {
    ParametersWithConflictingStandings { fields: conflicting }
  } else {
    if count(missing) > 0 {
      ParametersWithoutStanding { fields: missing }
    } else {
      AllParametersHaveStanding {
        unestablished: flat_map(serving_parameter_standings, r => match provenance_obligation(prov: r.provenance) {
          Present { value: _ } => [r.parameter]
          Absent => []
        }),
      }
    }
  }
}

data serving_parameters_current: ServingDecisionParameters = serving_decision_parameters(
  max_model_len: token_count(count: 262144),
  memory_request: VllmMemoryRequest {
    utilization: Present { value: basis_point(count: 8200) },
    kv_cache_bytes: none,
  },
  max_num_batched_tokens: token_count(count: 2048),
  max_num_seqs: 32,
  executor: ExecutorRayProfile,
  kv_layout: KvFp8DsMlaLayout,
  speculative: SpeculationOff,
  enable_prefix_caching: true,
  runtime: spark_runtime,
)

data eight_host_topologies: List<TopologyShape> = [
  topology_shape(tensor_parallel_degree: 8, replica_count: 1),
  topology_shape(tensor_parallel_degree: 4, replica_count: 2),
  topology_shape(tensor_parallel_degree: 2, replica_count: 4),
  topology_shape(tensor_parallel_degree: 1, replica_count: 8),
]

// THE WORKLOAD IS A SCENARIO AND SAYS SO. The window is 262,144 tokens by operator decision
// (2026-09-08) and matches what the GLM canary actually runs; an earlier revision of this row
// carried 300,000, which I had authored with nothing behind it. The window being decided does NOT
// make the DEMAND established: no per-turn context distribution exists, so this stays a scenario
// value where it cannot be mistaken for a requirement.
data serving_workload_standing: WorkloadDemandStanding = WorkloadDemandUnestablished {
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_workload_standing"),
  scenario_value: token_count(count: 262144),
  obligation: "no per-turn context distribution has been derived for this fleet's traffic: retained context, new input, reserved output and tool-growth reserve at a stated percentile. Until that exists this value is a scenario parameter and cannot settle a deployment" as NonEmptyStr,
}

data glm_quality_requirement: QualityRequirement = quality_requirement(
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "glm_quality_requirement"),
  required_artifact: DeclarationRef { module_path: "gunbc.spark.serving_deployment_selection", decl_name: "artifact_glm_53_flash_native", field: WholeDeclaration },
  max_divergence_millinats: 0,
  min_task_score_delta_hundredths: 0,
  rationale: "operator policy 2026-09-08: do not sacrifice quality. A requantised build is a DIFFERENT SET OF WEIGHTS and is not admissible against this subject however fast it is. The divergence bar is zero against the reference profile because no task-level tolerance has been established for this fleet, and a nonzero bar without one would be a guessed exchange rate" as NonEmptyStr,
)

data deepseek_quality_requirement: QualityRequirement = quality_requirement(
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "deepseek_quality_requirement"),
  required_artifact: DeclarationRef { module_path: "gunbc.spark.serving_deployment_selection", decl_name: "artifact_deepseek_v4_flash_native", field: WholeDeclaration },
  max_divergence_millinats: 0,
  min_task_score_delta_hundredths: 0,
  rationale: "the deployed checkpoint is the subject, and a requantisation is a different artifact rather than a cheaper way to serve this one. gunbc.spark.tensor_parallel_comparison measured 2238 millinats between tensor-parallel degrees on these weights against a bit-identical within-topology envelope, so a per-topology assessment is required and no degree inherits another's standing" as NonEmptyStr,
)

// NO QUALITY ASSESSMENTS AND NO RUNTIME RECEIPTS. The empty lists are the honest state, and they are
// what make both subjects answer with obligations.
data serving_evidence_current: ServingDeploymentEvidenceSnapshot = serving_evidence_snapshot(
  quality: [],
  runtime_feasibility: [],
  workload: serving_workload_standing,
  fleet: spark_fleet_snapshot,
  fleet_receipt: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "spark_fleet_snapshot"),
)

// ── THE REQUANTISED BUILD IS NOT A CANDIDATE, IT IS OUTSIDE THE SUBJECT ───────────────────────
//
// AN EARLIER DOMAIN ADMITTED BOTH ARTIFACTS AT EVERY TOPOLOGY, on the reading that the quality wall
// would refuse the requantised rows -- and it did. But that reading mistakes the operator policy. The
// policy is not "prefer native quality", which would make the 2.05-bpw build a candidate that loses;
// it is DO NOT USE REQUANTISED WEIGHTS, which makes it not a candidate at all. Those differ in what
// the model then owes: a losing candidate needs a quality assessment to lose ON, so the projector's
// QualityUnobserved default turned four excluded rows into four standing evidence obligations for
// measurements nobody will ever take. That is precisely the endless-tuning behaviour
// AxisExcludedByOperatorPolicy was introduced to remove, arriving one layer down through the
// candidate field instead of the axis roster.
//
// So the artifact is a FIXED PARAMETER of this subject and the domain admits exactly one. The
// requantised artifact row survives -- it is the incumbent canary, a measurement reference, and the
// rollback realization during cutover -- and it is reached by the witness rather than by the
// production field.
data glm_domain: ServingDeploymentChoiceDomain = serving_deployment_domain(
  artifacts: [artifact_glm_53_flash_native],
  topologies: eight_host_topologies,
  parameters: serving_parameters_current,
)

fn glm_candidate(name: String, label: NonEmptyStr, art: ModelArtifact, t: TopologyShape) -> DeploymentCandidate {
  deployment_candidate(
    identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: name),
    label: label,
    artifact: art,
    topology: t,
  )
}

data glm_native_tp8_x1: DeploymentCandidate = glm_candidate(name: "glm_native_tp8_x1", label: "GLM native, one eight-rank replica" as NonEmptyStr, art: artifact_glm_53_flash_native, t: topology_shape(tensor_parallel_degree: 8, replica_count: 1))
data glm_native_tp4_x2: DeploymentCandidate = glm_candidate(name: "glm_native_tp4_x2", label: "GLM native, two four-rank replicas" as NonEmptyStr, art: artifact_glm_53_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2))
data glm_native_tp2_x4: DeploymentCandidate = glm_candidate(name: "glm_native_tp2_x4", label: "GLM native, four two-rank replicas" as NonEmptyStr, art: artifact_glm_53_flash_native, t: topology_shape(tensor_parallel_degree: 2, replica_count: 4))
data glm_native_tp1_x8: DeploymentCandidate = glm_candidate(name: "glm_native_tp1_x8", label: "GLM native, eight single-rank replicas" as NonEmptyStr, art: artifact_glm_53_flash_native, t: topology_shape(tensor_parallel_degree: 1, replica_count: 8))

data glm_candidate_field: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "glm_candidate_field"),
  domain: glm_domain,
  candidates: [glm_native_tp8_x1, glm_native_tp4_x2, glm_native_tp2_x4, glm_native_tp1_x8],
)

// ── WHAT CONSUMES THIS MODULE TODAY, STATED PLAINLY ───────────────────────────────────────────
//
// NOTHING IN PRODUCTION DOES. The only importer is the witness, which exercises the fold over both
// declared subjects and every refusal path. That makes this module a DECLARED FRONTIER under DESIGN
// section 3c rather than a consumed authority, and a frontier is admissible only with its trigger
// stated beside it, so here it is.
//
// THE NAMED CONSUMER is gunbc.spark.pair_serving_desired, whose engine arguments are authored as
// literals today -- 82 percent, a context ceiling equal to the model's own limit, and a
// tensor-parallel degree taken from `length(hosts)`, which is not a choice but an accident of group
// membership. Those literals become a function of a selected shape.
//
// THE TRIGGER IS NOT "THIS MERGES". It is the FABRIC PLACEMENT RELATION: a binding from
// ServingDeploymentShape's replica ordinals to exact hosts, network groups, failure domains and
// endpoints. Until that exists there is nothing a convergence path could actuate from a shape, so
// wiring it would produce a second authority for the launch arguments rather than replacing the
// first -- and the review that ordered this deferral (item 17) was right to.
//
// FOUR WRAPPER FUNCTIONS WERE DELETED HERE RATHER THAN LEFT WAITING FOR THAT CONSUMER.
// glm_shape_admission and deepseek_shape_admission had NO caller anywhere, not even the witness --
// exactly section 6's experimental-residue tell, authored in advance of a consumer that does not
// exist. glm_serving_selection and deepseek_serving_selection were thin wrappers over the decision
// inputs below, which the witness can call directly. The fabric cut will know what shape it needs
// and can compose select_serving_deployment and admit_shape itself; guessing its entry points now is
// speculative inventory.
data glm_decision_input: ServingDeploymentDecisionInput = serving_decision_input(
  field: glm_candidate_field,
  evidence: serving_evidence_current,
  quality_requirement: glm_quality_requirement,
  selection_policy: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "glm_quality_requirement"),
)


// ── AN EXPERIMENT AND A SELECTED DEPLOYMENT ARE DIFFERENT PROPOSITIONS ────────────────────────
//
// THERE IS AN APPARENT CIRCULARITY IN EVERYTHING ABOVE: the selector needs measurements, the
// measurements need a running engine, and the engine is supposed to come from the selector. Read as
// one path it is unresolvable, and the temptation is to let the selector answer on thin evidence so
// something can launch -- which is exactly the failure two reviews of this module already caught.
//
// The resolution is that there are TWO paths to a running engine and they are not the same kind of
// thing. An EXPERIMENT is authorized by an operator for a bounded purpose and exists to acquire
// evidence. A PRODUCTION DEPLOYMENT is selected from that evidence. An experiment is therefore not a
// weakly-evidenced selection; it is a different act with a different warrant.
//
// THIS INHABITS std.scoped_authorization RATHER THAN COINING AN ADMISSION VOCABULARY. That module is
// the home DESIGN section 3b names for grants, and gunbc.srv3_os_install_actuate_workflow already
// inhabits it for a destructive BMC override. A second experiment-approval type beside it would be
// the fork section 3 forbids, and it would also lose what that module has already got right: single
// use is a STATE TRANSITION rather than a check, so two concurrent runs cannot both read one grant as
// unconsumed.
//
// NO GRANTED APPROVAL IS DECLARED IN THIS SOURCE. srv3's own annotation calls a source-declared grant
// the thing its lane exists to remove, carried only because no out-of-band channel exists yet. This
// module declines to add a second one: the request below is PENDING, which is the truthful state --
// nobody has approved a native four-rank launch. An operator grant arrives from outside the
// repository or the experiment does not run.
//
// AND THERE IS NO FUNCTION FROM AN EXPERIMENT ARM TO A DEPLOYMENT SHAPE. That is deliberate and it is
// why no witness row asserts the conversion refuses: the conversion has no constructor, so such a
// row's red would be unauthorable and the check would be a decoration. An experiment's receipts reach
// production by being ADDED TO THE EVIDENCE SNAPSHOT and letting the selector answer again, which is
// the only route between the two paths.
type ServingExperimentSubject sole_constructor {
  artifact: DeclarationRef
  topology: TopologyShape
  parameters: ServingDecisionParameters
}

fn serving_experiment_subject(artifact: DeclarationRef, topology: TopologyShape, parameters: ServingDecisionParameters) -> ServingExperimentSubject {
  ServingExperimentSubject { artifact: artifact, topology: topology, parameters: parameters }
}

fn experiment_subject_eq(a: ServingExperimentSubject, b: ServingExperimentSubject) -> Bool {
  declaration_ref_eq(a: a.artifact, b: b.artifact)
    && topology_shape_eq(a: a.topology, b: b.topology)
    && parameters_eq(a: a.parameters, b: b.parameters)
}

// THE ARM HAS NO EXPORTED BUILDER, for the same reason SelectedServingDeployment has none: possessing
// it IS the proof that an operator authorized this exact profile, and a caller able to construct one
// could authorize its own experiment.
type ServingExperimentArm sole_constructor {
  subject: ServingExperimentSubject
  artifact: ModelArtifact
  parameters: ServingDecisionParameters
  granted_by: NonEmptyStr
  expires_at: Timestamp
  purpose: NonEmptyStr
}

type ServingExperimentAdmission
  = ExperimentArmAdmitted { arm: ServingExperimentArm }
  | ExperimentAuthorizationRefused { cause: AuthorizationRefusalCause }
  | ExperimentPlanNotAuthorizable { obligations: List<NonEmptyStr> }
  | ExperimentAdmissionRefused { because: NonEmptyStr }

// THE ADMISSION CALLS std.scoped_authorization's DECISION PROCEDURE, and an earlier revision of this
// function did not -- which was the most dangerous thing in this module.
//
// It matched the ScopedAuthorization coproduct directly and, in the granted arm, compared only the
// grant's subject against the requested one. So it used the right VOCABULARY with none of the
// ENFORCEMENT: a grant with a matching subject would have admitted the experiment while EXPIRED, while
// issued for a different attempt, while carrying a different intent hash, while missing the required
// scope, while already completed, or while claimed by another attempt. Every one of those is a
// distinction `authorize` already draws and returns as a located, typed cause.
//
// That is the same failure as this module's earlier freely-mintable quality receipt, one layer up:
// borrowing an authority's type without its decision. The refusal cause is now carried through rather
// than flattened to prose, because escalation, scope, attempt and intent mismatches lead to four
// different operator actions -- ask for the grant, stop because something wanted access nobody
// approved, treat it as a replay, or re-request because the plan changed under an old grant.
//
// WHAT THIS FOLD STILL CANNOT DO IS CLAIM THE GRANT. Single use is a durable compare-and-set against a
// slot keyed by escalation id, which is an effect; a pure admission cannot perform it, and returning a
// "claimed" state from here would make the caller the arbiter of who won -- exactly the race the CAS
// exists to resolve. So the arm carries the claim as an OBLIGATION ON ITS HOLDER: whoever actuates it
// must claim before mutating anything and settle to CompletedBy or AbortedBy afterwards. That wet root
// does not exist yet, which is one reason this experiment is not actuable.
fn admit_serving_experiment(
  authorization: ScopedAuthorization<ServingExperimentSubject>,
  request: AuthorizationRequest<ServingExperimentSubject>,
  observed_at: Timestamp,
  artifact: ModelArtifact,
  topology: TopologyShape,
  parameters: ServingDecisionParameters,
) -> ServingExperimentAdmission {
  match launch_critical_obligations() {
    ExperimentPlanBlocked { obligations: os } => ExperimentPlanNotAuthorizable { obligations: os }
    ExperimentPlanAuthorizable =>
      match authorize(authorization: authorization, request: request, observed_at: observed_at) {
        AuthorizationRefused { cause: c } => ExperimentAuthorizationRefused { cause: c }
        AuthorizationPermitted { grant: g } => {
          let requested = serving_experiment_subject(artifact: artifact.identity, topology: topology, parameters: parameters)
          if !experiment_subject_eq(a: g.subject, b: requested) {
            ExperimentAdmissionRefused {
              because: join([
                "the grant approves a different experiment subject than the one being launched: approved ",
                declaration_ref_display_key(ref: g.subject.artifact), " at tp",
                to_string(g.subject.topology.tensor_parallel_degree), " x", to_string(g.subject.topology.replica_count),
                "; requested ", declaration_ref_display_key(ref: requested.artifact), " at tp",
                to_string(requested.topology.tensor_parallel_degree), " x", to_string(requested.topology.replica_count),
              ], "") as NonEmptyStr,
            }
          } else {
            ExperimentArmAdmitted {
              arm: ServingExperimentArm {
                subject: requested,
                artifact: artifact,
                parameters: parameters,
                granted_by: g.granted_by,
                expires_at: g.expires_at,
                purpose: g.purpose,
              },
            }
          }
        }
      }
  }
}

// ── A PLAN WITH AN UNESTABLISHED LAUNCH-CRITICAL FIELD IS NOT AUTHORIZABLE ─────────────────────
//
// THE PARAMETER STANDINGS WERE AN ISLAND, which is the section 3c failure this module has now
// committed twice. The roster could report that the KV layout and the runtime are unestablished for
// GLM while the admission cheerfully used those very values -- so the honest census existed beside the
// decision instead of governing it. A provenance nothing consumes is a description, not a wall.
//
// LAUNCH-CRITICAL IS NARROWER THAN UNESTABLISHED. A decided window and a decided sequence ceiling are
// fine for an experiment -- that is what an experiment is for. What cannot be decided-by-default is a
// field whose wrong value silently produces a DIFFERENT MODEL or a runtime that cannot load the
// artifact: the KV layout currently carries DeepSeek's MLA format against a GLM subject, and the
// runtime is a descriptive string where an exact image digest is needed.
data launch_critical_parameter_fields: List<NonEmptyStr> = [
  "kv_layout" as NonEmptyStr,
  "runtime" as NonEmptyStr,
]

type ExperimentPlanStanding
  = ExperimentPlanAuthorizable
  | ExperimentPlanBlocked { obligations: List<NonEmptyStr> }

fn launch_critical_obligations() -> ExperimentPlanStanding {
  let blocked = flat_map(launch_critical_parameter_fields, f =>
    flat_map(rows_for_field(field: f), r => match provenance_obligation(prov: r.provenance) {
      Present { value: o } => [join([f as String, ": ", o as String], "") as NonEmptyStr]
      Absent => []
    }))
  if count(blocked) == 0 { ExperimentPlanAuthorizable } else { ExperimentPlanBlocked { obligations: blocked } }
}

// ── THE NATIVE FOUR-RANK EVIDENCE ARM, REQUESTED AND NOT APPROVED ─────────────────────────────
//
// This is the experiment the remaining program needs: serve the native FP8 checkpoint on four ranks
// long enough to acquire the footprint, runtime-feasibility, quality and depth observations the
// selector is missing. Four ranks because the weight bound proves one and two cannot hold 305.8 GiB
// against 99.8 GiB usable per rank -- so this topology is not a preference, it is the minimum that
// can run at all.
//
// IT IS NOT THE SELECTED PRODUCTION DEPLOYMENT and must not become one by having been run. Its
// parameters are the current fixed set, whose standings say plainly that the window is decided, the
// sequence ceiling is decided, and the KV layout and runtime are not established for GLM at all.
data glm_native_tp4_experiment_topology: TopologyShape = topology_shape(tensor_parallel_degree: 4, replica_count: 1)

data glm_native_tp4_experiment_subject: ServingExperimentSubject = serving_experiment_subject(
  artifact: DeclarationRef { module_path: "gunbc.spark.serving_deployment_selection", decl_name: "artifact_glm_53_flash_native", field: WholeDeclaration },
  topology: glm_native_tp4_experiment_topology,
  parameters: serving_parameters_current,
)

data glm_native_tp4_experiment_scope: AuthorizationScope = AuthorizationScope {
  verb: Write,
  resource: NamespacePosition {
    tree: ServiceOpTree { service: "spark-serving" },
    path: ["spark-serving", "glm-5.3-flash", "native-fp8", "tp4"],
  },
  action: "spark-serving.experiment-arm.launch" as AuthorizedAction,
}

data glm_native_tp4_experiment_request: AuthorizationRequest<ServingExperimentSubject> = AuthorizationRequest {
  escalation_id: "glm-native-fp8-tp4-evidence-arm" as NonEmptyStr,
  scopes: [glm_native_tp4_experiment_scope],
  subject: glm_native_tp4_experiment_subject,
  purpose: "Serve the native FP8 GLM-5.3-Flash checkpoint on four ranks to acquire the footprint, runtime-feasibility, quality and representative-depth observations the serving selector currently lacks. This is an evidence arm, not a production deployment: it takes four Sparks, and on this fleet those are currently held by the DeepSeek group, so approving it displaces existing serving capacity." as NonEmptyStr,
  attempt: "glm-native-fp8-tp4-evidence-arm-attempt" as AttemptIdentity,
  intent_hash: content_hash_of_value(value: "glm-5.3-flash native fp8 at tensor-parallel 4, one replica, under the current fixed parameter set" as NonEmptyStr),
  destructive: true,
}

// PENDING, DELIBERATELY. Nobody has approved this, and a granted row authored here would be the
// standing credential srv3's lane exists to remove.
data glm_native_tp4_experiment_authorization: ScopedAuthorization<ServingExperimentSubject> = AuthorizationPending {
  request: glm_native_tp4_experiment_request,
}

data glm_native_tp4_experiment_observed_at: Timestamp = "2026-09-09T00:00:00Z"

fn glm_native_tp4_experiment_admission() -> ServingExperimentAdmission {
  admit_serving_experiment(
    authorization: glm_native_tp4_experiment_authorization,
    request: glm_native_tp4_experiment_request,
    observed_at: glm_native_tp4_experiment_observed_at,
    artifact: artifact_glm_53_flash_native,
    topology: glm_native_tp4_experiment_topology,
    parameters: serving_parameters_current,
  )
}

// ── THE DEEPSEEK ARM ──────────────────────────────────────────────────────────────────────────
//
// The convergence serving today authors its replica shape as literals: 82 percent, a context ceiling
// equal to the model's own limit, and a tensor-parallel degree taken from `length(hosts)` -- which is
// not a choice at all but an accident of how many hosts landed in a group.
//
// AN EARLIER VERSION OF THIS MODULE ANSWERED THIS QUESTION AND THE ANSWER WAS NOT EARNED. It selected
// four two-rank replicas over the deployed two four-rank replicas, on a field whose only
// discriminating axes were replica count and the capacity share one replica loss removes -- so the
// shape with the most replicas won both, by construction. It could not have concluded otherwise.
// Worse, it admitted quality on weight identity alone while this repository's own measurement shows
// the same weights at TP=2 and TP=4 are 2238 millinats apart on a deterministic forward pass.
// Recommending a topology change on a quality gate blind to topology is exactly backwards, and the
// recommendation is withdrawn rather than restated more carefully.
data deepseek_domain: ServingDeploymentChoiceDomain = serving_deployment_domain(
  artifacts: [artifact_deepseek_v4_flash_native],
  topologies: eight_host_topologies,
  parameters: serving_parameters_current,
)

fn deepseek_candidate(name: String, label: NonEmptyStr, t: TopologyShape) -> DeploymentCandidate {
  deployment_candidate(
    identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: name),
    label: label,
    artifact: artifact_deepseek_v4_flash_native,
    topology: t,
  )
}

data deepseek_tp8_x1: DeploymentCandidate = deepseek_candidate(name: "deepseek_tp8_x1", label: "DeepSeek, one eight-rank replica" as NonEmptyStr, t: topology_shape(tensor_parallel_degree: 8, replica_count: 1))
data deepseek_tp4_x2: DeploymentCandidate = deepseek_candidate(name: "deepseek_tp4_x2", label: "DeepSeek, two four-rank replicas (DEPLOYED TODAY)" as NonEmptyStr, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2))
data deepseek_tp2_x4: DeploymentCandidate = deepseek_candidate(name: "deepseek_tp2_x4", label: "DeepSeek, four two-rank replicas" as NonEmptyStr, t: topology_shape(tensor_parallel_degree: 2, replica_count: 4))
data deepseek_tp1_x8: DeploymentCandidate = deepseek_candidate(name: "deepseek_tp1_x8", label: "DeepSeek, eight single-rank replicas" as NonEmptyStr, t: topology_shape(tensor_parallel_degree: 1, replica_count: 8))

data deepseek_candidate_field: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "deepseek_candidate_field"),
  domain: deepseek_domain,
  candidates: [deepseek_tp8_x1, deepseek_tp4_x2, deepseek_tp2_x4, deepseek_tp1_x8],
)

data deepseek_decision_input: ServingDeploymentDecisionInput = serving_decision_input(
  field: deepseek_candidate_field,
  evidence: serving_evidence_current,
  quality_requirement: deepseek_quality_requirement,
  selection_policy: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "deepseek_quality_requirement"),
)
