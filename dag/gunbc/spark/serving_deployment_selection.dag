// ── THE DEEPSEEK ARM ──────────────────────────────────────────────────────────────────────────
//
// The convergence serving today authors its replica shape as literals: 82 percent, a context ceiling
// equal to the model's own limit, and a tensor-parallel degree taken from `length(hosts)` -- which is
// not a choice at all but an accident of how many hosts landed in a group.
//
// AN EARLIER VERSION OF THIS MODULE ANSWERED THIS QUESTION AND THE ANSWER WAS NOT EARNED. It selected
// four two-rank replicas over the deployed two four-rank replicas, on a field whose only
// discriminating axes were replica count and the capacity share one replica loss removes -- so the
// shape with the most replicas won both, by construction. It could not have concluded otherwise.
// Worse, it admitted quality on weight identity alone while this repository's own measurement shows
// the same weights at TP=2 and TP=4 are 2238 millinats apart on a deterministic forward pass.
// Recommending a topology change on a quality gate blind to topology is exactly backwards, and the
// recommendation is withdrawn rather than restated more carefully.
data deepseek_domain: ServingDeploymentChoiceDomain = serving_deployment_domain(
  artifacts: [artifact_deepseek_v4_flash_native],
  topologies: eight_host_topologies,
  parameters: serving_parameters_current,
)

fn deepseek_candidate(name: String, label: NonEmptyStr, t: TopologyShape) -> DeploymentCandidate {
  deployment_candidate(
    identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: name),
    label: label,
    artifact: artifact_deepseek_v4_flash_native,
    topology: t,
  )
}

data deepseek_tp8_x1: DeploymentCandidate = deepseek_candidate(name: "deepseek_tp8_x1", label: "DeepSeek, one eight-rank replica" as NonEmptyStr, t: topology_shape(tensor_parallel_degree: 8, replica_count: 1))
data deepseek_tp4_x2: DeploymentCandidate = deepseek_candidate(name: "deepseek_tp4_x2", label: "DeepSeek, two four-rank replicas (DEPLOYED TODAY)" as NonEmptyStr, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2))
data deepseek_tp2_x4: DeploymentCandidate = deepseek_candidate(name: "deepseek_tp2_x4", label: "DeepSeek, four two-rank replicas" as NonEmptyStr, t: topology_shape(tensor_parallel_degree: 2, replica_count: 4))
data deepseek_tp1_x8: DeploymentCandidate = deepseek_candidate(name: "deepseek_tp1_x8", label: "DeepSeek, eight single-rank replicas" as NonEmptyStr, t: topology_shape(tensor_parallel_degree: 1, replica_count: 8))

data deepseek_candidate_field: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "deepseek_candidate_field"),
  domain: deepseek_domain,
  candidates: [deepseek_tp8_x1, deepseek_tp4_x2, deepseek_tp2_x4, deepseek_tp1_x8],
)

data deepseek_decision_input: ServingDeploymentDecisionInput = serving_decision_input(
  field: deepseek_candidate_field,
  evidence: serving_evidence_current,
  quality_requirement: deepseek_quality_requirement,
  selection_policy: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "deepseek_quality_requirement"),
)


// ── WHAT CONSUMES THIS MODULE TODAY, STATED PLAINLY ───────────────────────────────────────────
//
// NOTHING IN PRODUCTION DOES. The only importer is the witness, which exercises the fold over both
// declared subjects and every refusal path. That makes this module a DECLARED FRONTIER under DESIGN
// section 3c rather than a consumed authority, and a frontier is admissible only with its trigger
// stated beside it, so here it is.
//
// THE NAMED CONSUMER is gunbc.spark.pair_serving_desired, whose engine arguments are authored as
// literals today -- 82 percent, a context ceiling equal to the model's own limit, and a
// tensor-parallel degree taken from `length(hosts)`, which is not a choice but an accident of group
// membership. Those literals become a function of a selected shape.
//
// THE TRIGGER IS NOT "THIS MERGES". It is the FABRIC PLACEMENT RELATION: a binding from
// ServingDeploymentShape's replica ordinals to exact hosts, network groups, failure domains and
// endpoints. Until that exists there is nothing a convergence path could actuate from a shape, so
// wiring it would produce a second authority for the launch arguments rather than replacing the
// first -- and the review that ordered this deferral (item 17) was right to.
//
// FOUR WRAPPER FUNCTIONS WERE DELETED HERE RATHER THAN LEFT WAITING FOR THAT CONSUMER.
// glm_shape_admission and deepseek_shape_admission had NO caller anywhere, not even the witness --
// exactly section 6's experimental-residue tell, authored in advance of a consumer that does not
// exist. glm_serving_selection and deepseek_serving_selection were thin wrappers over the decision
// inputs below, which the witness can call directly. The fabric cut will know what shape it needs
// and can compose select_serving_deployment and admit_shape itself; guessing its entry points now is
// speculative inventory.
