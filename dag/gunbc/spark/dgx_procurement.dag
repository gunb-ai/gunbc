module gunbc.spark.dgx_procurement


// SPARK-0 (2026-08-05). Three deliberately separate fact classes: (1) the vendor catalog (extdeps.systems.nvidia) -- what NVIDIA documents the product to be; (2) operator procurement intent (this module) -- that two units were ordered and that srv5/srv6 are RESERVED identities for them; (3) deployment observation -- physical binding evidence that must never be fabricated. A reserved identity is explicitly NOT enrollment: srv5/srv6 do not appear in gunbc.fleet_intent_network's endpoint list, gunbc.fleet_intent's ComputeHost list, or any phase matrix/compute offer.
// SPARK-LANE-A (2026-08-06) moved the identities to gunbc.fleet_intent_network, the single authority for a host's fleet identity (§3 -- SPARK-0 forked them privately here only because that file was mid-refactor at the time).
// SPARK-LANE-A revision (2026-08-07), operator review of #7952. Two identity defects and one staleness, repaired below and in gunbc.fleet_lifecycle_observation. The staleness: BOTH UNITS ARRIVED and hold Static, extdeps.dhcp.v4.Active CR1000A reservations, so the earlier "not yet arrived / no MAC exists / no address chosen" rows were false. Arrival is DERIVED from the observed reservation rows (dgx_spark_arrival_standing) rather than asserted in prose that can drift. SPARK-ALLOC-LAND-0 (2026-08-07): the slot allocation was delegated by the operator ("the 5, 6 decision is arbitrary - just make it yourself") and decided on ascending address order; it is recorded as an OperatorAllocation receipt, never as an observation.
type HardwareProcurementIntent {
  vendor_catalog: extdeps.systems.types.IntegratedComputeSystemCatalogRow
  unit_count: Int
  reserved_identities: std.types.List<product.placement_supply.HostIdentity>
  ordered_note: std.types.NonEmptyStr
}

// The two static reservations the operator authored on the CR1000A, transcribed verbatim from the router table they supplied (spark-a3ee 192.168.1.222 4C:BB:47:E8:A3:EE / spark-3bd5 192.168.1.223 4C:BB:47:E8:3B:D5; both MACs independently ARP-confirmed on the LAN). These are OBSERVED ROUTER FACTS and nothing more. The reservation labels are vendor-derived from the MAC tail -- they are the units' factory hotspot SSIDs -- which makes them display aliases of the box, NOT fleet identity: a label that the vendor generated cannot decide which fleet subject a machine serves, and reading one as if it could is the same presentation-as-identity error the collector-observation carrier below exists to prevent. So the join to a slot is never inferred from a label: it is the explicit OperatorAllocation recorded below.
data spark_a3ee_reservation: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow = extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow {
  mac_address: "4C:BB:47:E8:A3:EE" as extdeps.dhcp.v4.MacAddress,
  ipv4_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222),
  lease: extdeps.dhcp.v4.StaticDhcpReservation {
    reservation_label: "spark-a3ee" as std.types.NonEmptyStr,
    status: extdeps.dhcp.v4.Active,
  },
}

data spark_3bd5_reservation: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow = extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow {
  mac_address: "4C:BB:47:E8:3B:D5" as extdeps.dhcp.v4.MacAddress,
  ipv4_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 223),
  lease: extdeps.dhcp.v4.StaticDhcpReservation {
    reservation_label: "spark-3bd5" as std.types.NonEmptyStr,
    status: extdeps.dhcp.v4.Active,
  },
}

data observed_dgx_spark_router_reservations: std.types.List<extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow> = [
  spark_a3ee_reservation,
  spark_3bd5_reservation,
]

// SPARK-LANE-A. The router-side half of a slot: a DHCP static reservation is the act that turns "a slot we intend to use" into "an address the fleet can reach", and gunbc.fleet_intent_network's endpoint note recorded that this act had no carrier anywhere in the tree. It has one here. The reservation is NOT re-modeled: it is the cited extdeps.router.verizon_cr1000a Cr1000aDhcpLeaseRow, the same row gunbc.network_identity_subsumption consumes for srv3 -- minting a second mac/address pair beside it would be the §3 nickname failure.
//
// THE JOIN IS A DECISION, NOT AN OBSERVATION, and the carrier says so structurally rather than in
// prose: an assignment cannot be authored without naming the authority that made it. The two boxes
// are identical and nothing physical distinguishes them, so which one serves srv5 was not waiting
// in the world to be discovered -- it was a free choice, and the operator delegated it ("the 5, 6
// decision is arbitrary - just make it yourself"). Recording that as an observation would present a
// coin-flip as a measurement, and every later reader would treat it as recoverable evidence rather
// than a commitment someone made.
//
// A coproduct rather than a record with an Optional assignment, on modeling merit alone: an
// assigned slot structurally carries BOTH the reservation and the OperatorAllocation that joined
// them, in one variant -- there is no representable state where a reservation is attached with no
// authority behind it.
//
// The substrate report that used to sit here -- an inherited claim that two data rows of a record
// type carrying inhabited optional reservation fields exhaust memory during resolve -- is REFUTED
// by measurement, so it and its dissolution marker are gone rather than restated. What the
// measurement does NOT do is change the encoding: the coproduct stands on the modeling paragraph
// above, which never depended on the report, and that independence is why refuting it costs
// nothing here.
type OperatorAllocation {
  decided_by: std.types.NonEmptyStr
  decided_on: std.types.NonEmptyStr
  basis: std.types.NonEmptyStr
}

type DgxSparkRouterBinding
  = SlotUnassigned { identity: product.placement_supply.HostIdentity }
  | SlotAssigned {
      identity: product.placement_supply.HostIdentity,
      reservation: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow,
      allocation: OperatorAllocation,
    }

fn router_binding_identity(binding: DgxSparkRouterBinding) -> product.placement_supply.HostIdentity {
  match binding {
    SlotUnassigned { identity: i } => i
    SlotAssigned { identity: i, reservation: _, allocation: _ } => i
  }
}

data dgx_spark_router_binding_operator_allocation: OperatorAllocation = OperatorAllocation {
  decided_by: "bold-eagle-107 (operator-delegated: 'the 5, 6 decision is arbitrary - just make it yourself')",
  decided_on: "2026-08-07",
  basis: "Ascending address order: srv5 takes spark-a3ee (192.168.1.222) and srv6 takes spark-3bd5 (192.168.1.223). An arbitrary tie-break between two identical units, recorded so the choice is attributable rather than appearing to be a fact someone measured.",
}

data srv5_router_binding: DgxSparkRouterBinding = SlotAssigned {
  identity: operator_host_srv5,
  reservation: spark_a3ee_reservation,
  allocation: dgx_spark_router_binding_operator_allocation,
}

data srv6_router_binding: DgxSparkRouterBinding = SlotAssigned {
  identity: operator_host_srv6,
  reservation: spark_3bd5_reservation,
  allocation: dgx_spark_router_binding_operator_allocation,
}

data dgx_spark_router_bindings: std.types.List<DgxSparkRouterBinding> = [srv5_router_binding, srv6_router_binding]

// Arrival is DERIVED from the observed router rows, never stored beside them: a stored "arrived"
// flag is a second representation of what the reservation roster already says, and it is the copy
// that goes stale -- which is exactly how this module came to claim the units had not arrived while
// they were sitting on the LAN. Each row is a Static, extdeps.dhcp.v4.Active reservation the operator read off the
// CR1000A, which is presence evidence; the count against unit_count is the standing.
type DgxSparkArrivalStanding
  = AllOrderedUnitsObservedOnLan { observed_count: Int }
  | OrderedUnitsOutstanding { ordered_count: Int, observed_count: Int }

fn dgx_spark_arrival_standing() -> DgxSparkArrivalStanding {
  if count(observed_dgx_spark_router_reservations) == dgx_spark_procurement_intent.unit_count {
    AllOrderedUnitsObservedOnLan { observed_count: count(observed_dgx_spark_router_reservations) }
  } else {
    OrderedUnitsOutstanding {
      ordered_count: dgx_spark_procurement_intent.unit_count,
      observed_count: count(observed_dgx_spark_router_reservations),
    }
  }
}

// Derived, not spelled: the set of reserved identities IS the set of identities carrying a router binding row, so the two cannot disagree (§2 -- a second hand-written identity list would be the copy that drifts).
fn dgx_spark_reserved_identities() -> std.types.List<product.placement_supply.HostIdentity> {
  map(dgx_spark_router_bindings, b => router_binding_identity(binding: b))
}

data dgx_spark_procurement_intent: HardwareProcurementIntent = HardwareProcurementIntent {
  vendor_catalog: nvidia_dgx_spark_4tb_catalog,
  unit_count: 2,
  reserved_identities: dgx_spark_reserved_identities(),
  ordered_note: "2x NVIDIA DGX Spark ordered. Both units arrived and are live on the operator LAN, each holding a Static, Active CR1000A reservation (spark-a3ee 192.168.1.222 and spark-3bd5 192.168.1.223, MACs ARP-confirmed). Arrival is derived by dgx_spark_arrival_standing from those observed rows. srv5/srv6 slot assignment is recorded by dgx_spark_router_binding_operator_allocation, not inferred from router labels.",
}

type DgxSparkDeployment {
  identity: product.placement_supply.HostIdentity
  catalog: extdeps.systems.types.IntegratedComputeSystemCatalogRow
  observation: gunbc.fleet_lifecycle_observation.FleetLifecycleObservation
  router_reservation: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow
  envelope_host_presentation: gunbc.fleet_lifecycle_observation.EnvelopeHostPresentationEvidence
}

// The receipt is carried WHOLE rather than destructured into a fresh `receipt_exit_status: Int`.
// A re-declared int is a second authority for a fact `ProcessReceipt` already owns, and it can
// drift from that carrier silently; carrying the receipt also keeps its attempt hash, so the
// refusal names WHICH attempt disagreed. `reported_rc` stays an Int because it is the upstream
// envelope's own shape (extdeps.systems.nvidia_fleet_lifecycle `rc`), not a name we coined.
type DgxSparkAdmissionRefusalReason
  = DeploymentAdmissionNoEvidence { requested_identity: product.placement_supply.HostIdentity }
  | DeploymentAdmissionAmbiguousEvidence { requested_identity: product.placement_supply.HostIdentity, candidate_count: Int }
  | DeploymentAdmissionWrongTool { observed_tool: std.types.NonEmptyStr }
  | DeploymentAdmissionSubjectMismatch { dispatched_subject: product.placement_supply.HostIdentity, requested_identity: product.placement_supply.HostIdentity }
  | DeploymentAdmissionExecutionEvidenceDisagrees { receipt: gunbc.fleet_lifecycle_observation.ProcessReceipt, reported_rc: Int }
  | DeploymentAdmissionObservationNotOk { observed_status: extdeps.systems.nvidia_fleet_lifecycle.FleetLifecycleStatus, observed_rc: Int }
  | DeploymentAdmissionIdentityNotReserved { requested_identity: product.placement_supply.HostIdentity }
  | DeploymentAdmissionRouterBindingMismatch { binding_identity: product.placement_supply.HostIdentity, requested_identity: product.placement_supply.HostIdentity }
  | DeploymentAdmissionRouterBindingPending { requested_identity: product.placement_supply.HostIdentity }
  | DeploymentAdmissionEndpointBindingMismatch { requested_identity: product.placement_supply.HostIdentity }

type DgxSparkAdmissionOutcome
  = DgxSparkDeploymentAdmitted { deployment: DgxSparkDeployment }
  | DgxSparkDeploymentRefused { reason: DgxSparkAdmissionRefusalReason }

fn host_identity_is_reserved(identity: product.placement_supply.HostIdentity) -> Bool {
  fold(
    dgx_spark_reserved_identities(),
    init: false,
    f: (acc, reserved) => acc || reserved == identity,
  )
}

// A tool ran is not a tool succeeded. The cited envelope carries BOTH a status and an exit code and they are independent facts (a StatusWarning `Endpoint degraded` observation is documented as "tool ran successfully but returned warning or failure status due to device health signals"), so success is the conjunction, never either one alone.
fn envelope_reports_success(envelope: extdeps.systems.nvidia_fleet_lifecycle.FleetLifecycleEnvelope) -> Bool {
  match envelope.status {
    StatusOk => envelope.rc == 0
    StatusWarning => false
    StatusError => false
  }
}

// The whole admission decision as a first-refusal chain ending at the single construction site for
// DgxSparkDeploymentAdmitted, reachable only past every check -- there is no sibling arm that
// builds an admitted deployment, so adding a check cannot be bypassed by forgetting to re-order
// one. The reservation is destructured where it is needed, so "the binding is reserved" is not
// checked once and then trusted: the deployment is built FROM the reservation value, and an Absent
// reservation has no value to build from.
fn admit_selected_dgx_spark_observation(
  identity: product.placement_supply.HostIdentity,
  catalog: extdeps.systems.types.IntegratedComputeSystemCatalogRow,
  observation: gunbc.fleet_lifecycle_observation.FleetLifecycleObservation,
  router_binding: DgxSparkRouterBinding,
) -> DgxSparkAdmissionOutcome {
  if observation.envelope.tool != fleet_lifecycle_operation_tool_name(op: extdeps.systems.nvidia_fleet_lifecycle.DeviceIdentity) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionWrongTool { observed_tool: observation.envelope.tool }
    }
  } else {
    if observation.subject != identity {
      DgxSparkDeploymentRefused {
        reason: DeploymentAdmissionSubjectMismatch {
          dispatched_subject: observation.subject,
          requested_identity: identity,
        }
      }
    } else {
      if !execution_evidence_agrees(observation: observation) {
        DgxSparkDeploymentRefused {
          reason: DeploymentAdmissionExecutionEvidenceDisagrees {
            receipt: observation.execution_receipt,
            reported_rc: observation.envelope.rc,
          }
        }
      } else {
        if !envelope_reports_success(envelope: observation.envelope) {
          DgxSparkDeploymentRefused {
            reason: DeploymentAdmissionObservationNotOk {
              observed_status: observation.envelope.status,
              observed_rc: observation.envelope.rc,
            }
          }
        } else {
          if !host_identity_is_reserved(identity: identity) {
            DgxSparkDeploymentRefused {
              reason: DeploymentAdmissionIdentityNotReserved { requested_identity: identity }
            }
          } else {
            if router_binding_identity(binding: router_binding) != identity {
              DgxSparkDeploymentRefused {
                reason: DeploymentAdmissionRouterBindingMismatch {
                  binding_identity: router_binding_identity(binding: router_binding),
                  requested_identity: identity,
                }
              }
            } else {
              match router_binding {
                SlotUnassigned { identity: _ } =>
                  DgxSparkDeploymentRefused {
                    reason: DeploymentAdmissionRouterBindingPending { requested_identity: identity }
                  }
                SlotAssigned { identity: _, reservation: reservation, allocation: _ } =>
                  if observation.endpoint_binding.address != reservation.ipv4_address {
                    DgxSparkDeploymentRefused {
                      reason: DeploymentAdmissionEndpointBindingMismatch { requested_identity: identity }
                    }
                  } else {
                    DgxSparkDeploymentAdmitted {
                      deployment: DgxSparkDeployment {
                        identity: identity,
                        catalog: catalog,
                        observation: observation,
                        router_reservation: reservation,
                        envelope_host_presentation: envelope_host_presentation_evidence(observation: observation),
                      }
                    }
                  }
              }
            }
          }
        }
      }
    }
  }
}

// The construction wall: a DgxSparkDeployment cannot be admitted from catalog + procurement intent
// alone -- that refusal is the deliverable this file exists to prove. It takes the three-valued
// SELECTION rather than an Optional observation, so "several disagreeing observations" cannot be
// narrowed to a pick before the wall ever sees it (DEFECT 2); and it takes a
// FleetLifecycleObservation rather than a bare envelope, so the subject arrives from the
// dispatch and the vendor's host string is checked as diagnostic evidence on the admitted
// deployment, never as an admission gate (SPARK-ALLOC-LAND-0). Per review 49094 the causes are a
// closed coproduct, not free-text prose.
fn admit_dgx_spark_deployment(
  identity: product.placement_supply.HostIdentity,
  catalog: extdeps.systems.types.IntegratedComputeSystemCatalogRow,
  selection: gunbc.fleet_lifecycle_observation.ObservationSelection,
  router_binding: DgxSparkRouterBinding,
) -> DgxSparkAdmissionOutcome {
  match selection {
    ObservationMissing { subject: _ } =>
      DgxSparkDeploymentRefused {
        reason: DeploymentAdmissionNoEvidence { requested_identity: identity }
      }
    ObservationAmbiguous { subject: _, candidate_count: n } =>
      DgxSparkDeploymentRefused {
        reason: DeploymentAdmissionAmbiguousEvidence {
          requested_identity: identity,
          candidate_count: n,
        }
      }
    ObservationUnique { observation: o } =>
      admit_selected_dgx_spark_observation(
        identity: identity,
        catalog: catalog,
        observation: o,
        router_binding: router_binding,
      )
  }
}

// SPARK-LANE-A: the procurement-grain convergence read. Per-unit disposition is DERIVED by calling admit_dgx_spark_deployment, never by a second copy of its checks -- a forked convergence rule would let a unit read "converged" here while the wall refuses it (§2/§3).
type DgxSparkUnitDisposition
  = DgxSparkUnitDeployed { deployment: DgxSparkDeployment }
  | DgxSparkUnitPending { identity: product.placement_supply.HostIdentity, reason: DgxSparkAdmissionRefusalReason }

type DgxSparkProcurementConvergence
  = DgxSparkProcurementConverged { deployments: std.types.List<DgxSparkDeployment> }
  | DgxSparkProcurementPending { pending: std.types.List<DgxSparkUnitDisposition> }

// Two arms, not three: a unit is deployed or it is pending with a typed, located cause. There is deliberately no `Unknown` arm -- every reason a unit is not deployed is one of the closed DgxSparkAdmissionRefusalReason causes, so "we could not tell" cannot masquerade as a verdict (§5 state-space conflation). This is a diff-shaped read but NOT an instance of the gunbc.membership_reconcile spine: that spine reconciles a desired member set against an OBSERVED member set of the same type with teardown as the Removed arm, and here the two sides are different types (a reserved identity vs an admitted deployment) and there is no teardown -- you cannot retract a machine that was never present. Instantiating the spine would mean inventing an M that fits neither side, so the genericity would buy nothing and cost a fake member type.
fn dgx_spark_unit_disposition(
  binding: DgxSparkRouterBinding,
  observations: std.types.List<gunbc.fleet_lifecycle_observation.FleetLifecycleObservation>,
) -> DgxSparkUnitDisposition {
  match admit_dgx_spark_deployment(
    identity: router_binding_identity(binding: binding),
    catalog: dgx_spark_procurement_intent.vendor_catalog,
    selection: select_observation_for_subject(subject: router_binding_identity(binding: binding), observations: observations),
    router_binding: binding,
  ) {
    DgxSparkDeploymentAdmitted { deployment: d } => DgxSparkUnitDeployed { deployment: d }
    DgxSparkDeploymentRefused { reason: r } =>
      DgxSparkUnitPending { identity: router_binding_identity(binding: binding), reason: r }
  }
}

fn converge_dgx_spark_procurement(
  bindings: std.types.List<DgxSparkRouterBinding>,
  observations: std.types.List<gunbc.fleet_lifecycle_observation.FleetLifecycleObservation>,
) -> DgxSparkProcurementConvergence {
  let dispositions = map(bindings, b => dgx_spark_unit_disposition(binding: b, observations: observations))
  let pending = flat_map(dispositions, d =>
    match d {
      DgxSparkUnitPending { identity: i, reason: r } => [DgxSparkUnitPending { identity: i, reason: r }]
      DgxSparkUnitDeployed { deployment: _ } => []
    }
  )
  let deployments = flat_map(dispositions, d =>
    match d {
      DgxSparkUnitDeployed { deployment: dep } => [dep]
      DgxSparkUnitPending { identity: _, reason: _ } => []
    }
  )
  if count(pending) > 0 {
    DgxSparkProcurementPending { pending: pending }
  } else {
    DgxSparkProcurementConverged { deployments: deployments }
  }
}

// The LIVE read, as of 2026-08-07: the real binding roster against the real (empty) collector-observation population. The empty list is not a placeholder standing in for observations that exist -- no read transport for the fleet-lifecycle tools is bound anywhere in the tree (extdeps.systems.nvidia_fleet_lifecycle models the operation shape only), so zero observations is the true observed population even though both machines are now reachable on the LAN. This converges when each slot is assigned to one of the two reserved boxes AND a unique successful device_identity.py observation arrives from that box's reserved address.
fn dgx_spark_procurement_convergence() -> DgxSparkProcurementConvergence {
  converge_dgx_spark_procurement(bindings: dgx_spark_router_bindings, observations: [])
}

// SPARK-LANE-A (operator addition, 2026-08-07). PAIR ADMISSION: two envelopes that both claim to
// be the pair are not evidence of two machines. Per-unit admission is subject-grain and cannot see
// this class -- each unit's evidence can be individually impeccable while both observations came
// off the SAME physical box (one machine answering on two addresses, a mis-dispatch that reached
// the same host twice, a cloned image reporting a borrowed identity). Proving the pair therefore
// requires a fact per-unit admission never examines: a STABLE hardware identity, distinct across
// the two.
//
// It is fail-closed in three directions rather than one, because the ways this can fail to be
// established are genuinely different states and collapsing them would let the weakest pass:
// a unit whose hardware identity was never observed refuses (Absent is not "probably distinct" --
// and today, with no read transport bound and the per-tool payload unmodeled, this is the arm the
// live population would reach); two identities that are equal refuse; and two identities that are
// INCOMPARABLE -- a serial against a product UUID, two naming schemes for one machine -- refuse
// too, because their inequality proves nothing about whether the machines differ. Only positive
// evidence of distinctness admits.
type DgxSparkPairRefusalReason
  = PairUnitNotAdmitted { identity: product.placement_supply.HostIdentity, reason: DgxSparkAdmissionRefusalReason }
  | PairUnitCountWrong { admitted_count: Int }
  | PairSubjectsNotDistinct { identity: product.placement_supply.HostIdentity }
  | PairHardwareIdentityUnobserved { identity: product.placement_supply.HostIdentity }
  | PairHardwareIdentityNotDistinct { first: product.placement_supply.HostIdentity, second: product.placement_supply.HostIdentity }
  | PairHardwareIdentityIncomparable { first: product.placement_supply.HostIdentity, second: product.placement_supply.HostIdentity }

type DgxSparkPairAdmissionOutcome
  = DgxSparkPairAdmitted { first: DgxSparkDeployment, second: DgxSparkDeployment }
  | DgxSparkPairRefused { reason: DgxSparkPairRefusalReason }

fn admit_dgx_spark_pair_deployments(
  first: DgxSparkDeployment,
  second: DgxSparkDeployment,
) -> DgxSparkPairAdmissionOutcome {
  if first.identity == second.identity {
    DgxSparkPairRefused { reason: PairSubjectsNotDistinct { identity: first.identity } }
  } else {
    match first.observation.device_hardware_identity {
      Absent =>
        DgxSparkPairRefused { reason: PairHardwareIdentityUnobserved { identity: first.identity } }
      Present { value: first_hw } =>
        match second.observation.device_hardware_identity {
          Absent =>
            DgxSparkPairRefused { reason: PairHardwareIdentityUnobserved { identity: second.identity } }
          Present { value: second_hw } =>
            match compare_hardware_identity(left: first_hw, right: second_hw) {
              HardwareIdentitiesDistinct =>
                DgxSparkPairAdmitted { first: first, second: second }
              HardwareIdentitiesSame =>
                DgxSparkPairRefused {
                  reason: PairHardwareIdentityNotDistinct {
                    first: first.identity,
                    second: second.identity,
                  }
                }
              HardwareIdentitiesIncomparable =>
                DgxSparkPairRefused {
                  reason: PairHardwareIdentityIncomparable {
                    first: first.identity,
                    second: second.identity,
                  }
                }
            }
        }
    }
  }
}

// An explicit accumulator for pairing a converged list: "no unit seen yet", "one unit held", and
// "a verdict reached". Named rather than smuggled into the refusal type, so the fold cannot express
// a half-state that reads as a refusal reason nobody meant.
type DgxSparkPairFold
  = PairFoldEmpty
  | PairFoldFirst { first: DgxSparkDeployment }
  | PairFoldOutcome { outcome: DgxSparkPairAdmissionOutcome }

fn dgx_spark_pair_fold_step(acc: DgxSparkPairFold, next: DgxSparkDeployment) -> DgxSparkPairFold {
  match acc {
    PairFoldEmpty => PairFoldFirst { first: next }
    PairFoldFirst { first: held } =>
      PairFoldOutcome { outcome: admit_dgx_spark_pair_deployments(first: held, second: next) }
    PairFoldOutcome { outcome: o } => PairFoldOutcome { outcome: o }
  }
}

// The pair read over a convergence result. A convergence that is still Pending cannot yield a pair
// at all, and the first pending unit's own typed cause is carried out rather than replaced by a
// generic "not converged" -- the reason a pair cannot be admitted is the reason its unit could not
// be, and flattening that would throw away the located cause the whole chain exists to produce.
fn first_pending_pair_refusal(pending: std.types.List<DgxSparkUnitDisposition>) -> DgxSparkPairAdmissionOutcome {
  fold(
    pending,
    init: DgxSparkPairRefused { reason: PairUnitCountWrong { admitted_count: 0 } },
    f: (acc, d) =>
      match acc {
        DgxSparkPairRefused { reason: PairUnitCountWrong { admitted_count: _ } } =>
          match d {
            DgxSparkUnitPending { identity: i, reason: r } =>
              DgxSparkPairRefused { reason: PairUnitNotAdmitted { identity: i, reason: r } }
            DgxSparkUnitDeployed { deployment: _ } => acc
          }
        DgxSparkPairRefused { reason: _ } => acc
        DgxSparkPairAdmitted { first: _, second: _ } => acc
      }
  )
}

fn admit_dgx_spark_pair(convergence: DgxSparkProcurementConvergence) -> DgxSparkPairAdmissionOutcome {
  match convergence {
    DgxSparkProcurementPending { pending: p } => first_pending_pair_refusal(pending: p)
    DgxSparkProcurementConverged { deployments: ds } =>
      if count(ds) != 2 {
        DgxSparkPairRefused { reason: PairUnitCountWrong { admitted_count: count(ds) } }
      } else {
        match fold(ds, init: PairFoldEmpty, f: (acc, d) => dgx_spark_pair_fold_step(acc: acc, next: d)) {
          PairFoldOutcome { outcome: o } => o
          PairFoldFirst { first: _ } =>
            DgxSparkPairRefused { reason: PairUnitCountWrong { admitted_count: 1 } }
          PairFoldEmpty =>
            DgxSparkPairRefused { reason: PairUnitCountWrong { admitted_count: 0 } }
        }
      }
  }
}
