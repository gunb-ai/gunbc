module gunbc.spark.serving_durability

import std.types { String, NonEmptyStr, List, Bool }
import std.algebra { trim }
import product.placement_supply { HostIdentity }
import extdeps.ssh.session { SshSessionExecResult }

// THE DURABILITY RECEIPT, AND WHY IT IS NOT THE BOOT-PROVENANCE WINDOW.
//
// spark_serving_boot_provenance classifies a unit as boot-started when its ActiveEnterTimestamp is
// within a declared window of boot. That is a useful diagnostic and it is the WRONG terminal proof:
// a correctly enabled user service can legitimately enter active well after that window, because
// user-manager start and lingering are ordered by systemd against everything else the boot is
// doing. A slow boot would report a durable host as not durable, and the remedy for that reading is
// to widen the window -- which is fitting a constant to a host until the check means nothing.
//
// The controlled transaction below asks a question with a decidable answer instead: DID THIS HOST
// REBOOT, and is it converged AFTER it did. The kernel mints a fresh boot_id every boot, so a
// changed boot_id is not an inference from timing -- it is the machine stating that the boot the
// pre-reading belongs to has ended. Provenance stays as the diagnostic it is good at: explaining
// WHY a host that did reboot came back unconverged.
//
// THE POST-REBOOT PLAN MUST BE READ-ONLY, and this is the subtlest requirement in the whole vertical.
// If the converge that runs after the reboot is permitted to APPLY, it will start the unit, report
// success, and destroy the only evidence that distinguishes a host that survived the reboot from a
// host that was repaired after it. The remedial apply is not merely premature -- it consumes the
// measurement. So durability is judged on a plan that is derived and not executed, and only after
// that verdict may anything be repaired.

type BootIdentityReading
  = BootIdentityObserved { boot_id: NonEmptyStr }
  | BootIdentityUnobserved { cause: NonEmptyStr }

fn spark_serving_boot_id_probe_argv() -> List<String> {
  ["cat", "/proc/sys/kernel/random/boot_id"]
}

// A boot_id that came back empty is UNOBSERVED, not a boot_id of "". An empty string compares
// unequal to any real identifier, so admitting it would let a failed read manufacture the very
// "the boot changed" verdict this transaction exists to establish.
fn spark_serving_boot_identity_from_probe(probe: SshSessionExecResult?) -> BootIdentityReading {
  match probe {
    Absent => BootIdentityUnobserved { cause: "the boot-identity probe leg did not run" as NonEmptyStr }
    Present { value: r } =>
      if r.success == false {
        BootIdentityUnobserved {
          cause: join([
            "boot-identity probe failed exit=", to_string(r.exit_code), " stderr=", trim(s: r.stderr),
          ], "") as NonEmptyStr,
        }
      } else if trim(s: r.stdout) == "" {
        BootIdentityUnobserved {
          cause: "boot-identity probe succeeded but produced no identifier, which is a failed read and never a boot that has no identity" as NonEmptyStr,
        }
      } else {
        BootIdentityObserved { boot_id: trim(s: r.stdout) as NonEmptyStr }
      }
  }
}

// THE REBOOT TRANSITION, decided from two readings and nothing else. Both must be observed: a
// comparison against a reading we never obtained cannot establish anything in either direction, and
// calling that "the boot did not change" would be the empty-observation narrow -- reporting the
// host as un-rebooted precisely when we failed to look.
type RebootTransition
  = BootIdentityChanged { before: NonEmptyStr, after: NonEmptyStr }
  | BootIdentityUnchanged { boot_id: NonEmptyStr }
  | RebootTransitionUnobserved { cause: NonEmptyStr }

fn spark_serving_reboot_transition(
  before: BootIdentityReading,
  after: BootIdentityReading,
) -> RebootTransition {
  match before {
    BootIdentityUnobserved { cause: c } =>
      RebootTransitionUnobserved {
        cause: join(["the pre-reboot boot identity was never read: ", c as String], "") as NonEmptyStr,
      }
    BootIdentityObserved { boot_id: b } =>
      match after {
        BootIdentityUnobserved { cause: c } =>
          RebootTransitionUnobserved {
            cause: join(["the post-reboot boot identity was never read: ", c as String], "") as NonEmptyStr,
          }
        BootIdentityObserved { boot_id: a } =>
          if (a as String) == (b as String) {
            BootIdentityUnchanged { boot_id: a }
          } else {
            BootIdentityChanged { before: b, after: a }
          }
      }
  }
}

// THE FOUR TERMINAL VERDICTS, each naming a different world with a different next step. The two
// failures are deliberately not merged: a host that rebooted and came back needing work has an
// enablement defect to fix, while a host whose boot never changed has a reboot that did not happen
// -- and a run that reported those the same way would send someone to debug systemd units on a
// machine that simply never went down.
type SparkServingDurabilityVerdict
  = DurabilityProven { host: HostIdentity, before: NonEmptyStr, after: NonEmptyStr }
  | SurvivedRebootUnconverged { host: HostIdentity, pending_action_count: Int }
  | SurvivedRebootNotServing { host: HostIdentity, cause: NonEmptyStr }
  | RebootNotEstablished { host: HostIdentity, boot_id: NonEmptyStr }
  | DurabilityUnobserved { host: HostIdentity, cause: NonEmptyStr }

// THE THREE CONDITIONS ARE CONJUNCTIVE AND ORDERED, and the order is the argument. A changed boot
// identity says the reboot happened; a zero-action READ-ONLY plan says the declared state survived
// it; the generation canary says the thing that survived actually serves. Any one alone is a weaker
// claim that has already been mistaken for this one: a serving host that never rebooted, and an
// enabled unit that came back dead, both pass a check built on fewer than three.
fn spark_serving_durability_verdict(
  host: HostIdentity,
  transition: RebootTransition,
  pending_action_count: Int,
  serving_healthy: Bool,
  health_cause: NonEmptyStr,
) -> SparkServingDurabilityVerdict {
  match transition {
    RebootTransitionUnobserved { cause: c } => DurabilityUnobserved { host: host, cause: c }
    BootIdentityUnchanged { boot_id: b } => RebootNotEstablished { host: host, boot_id: b }
    BootIdentityChanged { before: bf, after: af } =>
      if pending_action_count > 0 {
        SurvivedRebootUnconverged { host: host, pending_action_count: pending_action_count }
      } else if serving_healthy == false {
        SurvivedRebootNotServing { host: host, cause: health_cause }
      } else {
        DurabilityProven { host: host, before: bf, after: af }
      }
  }
}

fn spark_serving_durability_is_proven(verdict: SparkServingDurabilityVerdict) -> Bool {
  match verdict {
    DurabilityProven { host: _, before: _, after: _ } => true
    SurvivedRebootUnconverged { host: _, pending_action_count: _ } => false
    SurvivedRebootNotServing { host: _, cause: _ } => false
    RebootNotEstablished { host: _, boot_id: _ } => false
    DurabilityUnobserved { host: _, cause: _ } => false
  }
}

fn spark_serving_durability_wire(verdict: SparkServingDurabilityVerdict) -> String {
  match verdict {
    DurabilityProven { host: h, before: bf, after: af } =>
      join([
        "durability host=", h as String, " PROVEN boot_id_before=", bf as String,
        " boot_id_after=", af as String,
        " -- the host rebooted, the read-only replan required nothing, and it served the planned model\n",
      ], "")
    SurvivedRebootUnconverged { host: h, pending_action_count: n } =>
      join([
        "durability host=", h as String, " FAILED the host rebooted but came back needing ",
        to_string(n), " action(s): the declared state did not survive the boot\n",
      ], "")
    SurvivedRebootNotServing { host: h, cause: c } =>
      join([
        "durability host=", h as String,
        " FAILED the host rebooted and needed no resource action, but did not serve: ", c as String, "\n",
      ], "")
    RebootNotEstablished { host: h, boot_id: b } =>
      join([
        "durability host=", h as String, " NOT-ESTABLISHED boot_id=", b as String,
        " is unchanged, so no reboot occurred and nothing about durability was tested\n",
      ], "")
    DurabilityUnobserved { host: h, cause: c } =>
      join(["durability host=", h as String, " UNOBSERVED ", c as String, "\n"], "")
  }
}
