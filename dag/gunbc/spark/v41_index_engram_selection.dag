module gunbc.spark.v41_index_engram_selection

import std.types { String, Bool, List, NonEmptyStr }
import std.nat { Nat }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.measure { ByteSize, byte_size, byte_size_count }
import std.content_hash { Sha256DigestHex }
import v2.std.optional { Present, Absent }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable }
import extdeps.shell
import extdeps.tools.sha256sum { Sha256FileDigest, Sha256FileDigestUnavailable, sha256sum_file_digest_via_shell }
import extdeps.safetensors.format {
  SafetensorsIndexMember, safetensors_index_member,
  SafetensorsPopulationStanding, safetensors_population_standing,
}
import extdeps.deepseek.deepseek_v4_1_flash {
  deepseek_v4_1_flash_published_file_row, deepseek_v4_1_flash_safetensors_index_path,
  deepseek_v4_1_flash_index_engram_selection_of, deepseek_v4_1_flash_engram_membership_closure_of,
  deepseek_v4_1_flash_safetensors_index_file, deepseek_v4_1_flash_index_tensor_count,
  deepseek_v4_1_flash_engram_shard_files, deepseek_v4_1_flash_engram_population_reading,
  deepseek_v4_1_flash_engram_population,
}

// ── THE .engram. SELECTION OVER THE PINNED V4.1 INDEX, AS THIS REPOSITORY'S OBSERVATION ────────
//
// WHY THIS IS HERE AND NOT IN extdeps. A selection someone ran over a file is an observation, and an
// observation is a receipt in the observing layer (DESIGN section 3), never a fact the upstream owns.
// extdeps.deepseek.deepseek_v4_1_flash owns the pin (the index file's sha256 and size, its name count)
// and the fold that decides whether a selection closes membership; this module owns the reading and
// the instrument that produces it.
//
// THE INSTRUMENT IS A TOKEN SCAN, AND THAT IS A STATED DIVERGENCE FROM extdeps.languages.json. The JSON
// authority's parse_json_document does not read a document of this size in the interpreter today. THAT
// CLAIM IS NOT TRANSCRIBED HERE AND MUST NOT BE (DESIGN section 6: name the instrument, never transcribe
// its output) -- it is re-derived by v41_index_parse_json_probe_wet below, over the same file, whoever
// asks. A figure copied into this comment would be unreachable from the thing that owns it, and it would
// be the ONLY way to tell whether the dissolution trigger had fired, which would make the trigger
// unobservable and this fork permanent in practice. The scan below
// reads ONE shape and refuses everything else: no backslash anywhere (so no quoted string can hide a
// quote), the quoted tokens opening exactly `metadata`, `total_size`, `weight_map`, and after them only
// name/shard pairs whose shard ends `.safetensors`. Within that shape the quoted tokens ARE the keys and
// values, so the selection is exact rather than heuristic.
//
// IT DISSOLVES INTO A FOLD OVER parse_json_document ONCE THAT PARSER READS A weight_map OF THIS SIZE,
// and that condition is OBSERVABLE rather than asserted: v41_index_parse_json_probe_wet runs
// parse_json_document over the same index and reports which arm it reached, so the trigger is a run
// anyone can make rather than a sentence anyone must believe.
//
// WHERE THE READING COMES FROM. The index is not in this repository, so a data row cannot read it at
// evaluation; the reading is the receipt of the enrolled route that reads it on a Spark (below). Its
// values are COMPARED against the pin by the extdeps fold, so a reading of any other file, or over
// fewer names, does not close membership.

data v41_index_engram_selector: NonEmptyStr = ".engram." as NonEmptyStr

type V41IndexScan
  = V41IndexScanned { name_count: Nat, members: List<SafetensorsIndexMember> }
  | V41IndexScanRefused { cause: NonEmptyStr }

fn v41_quoted_tokens(text: String) -> List<String> {
  map(filter(enumerate(split(s: text, delimiter: "\"")), p => p.first % 2 == 1), p => p.second)
}

// ONE TRAVERSAL WITH CONSTANT STATE: each token either opens a pair (it is a name) or closes the open one
// (it is that name's shard). The fold keeps only the open name, two counts and the SELECTED members, so
// it never copies an accumulator proportional to the index. A name left open at the end has no shard,
// which the scan refuses.
type V41PairScan {
  pending: String?
  names: Nat
  not_shards: Nat
  members: List<SafetensorsIndexMember>
}

fn v41_pair_step(acc: V41PairScan, t: String, selector: NonEmptyStr) -> V41PairScan {
  match acc.pending {
    Absent => V41PairScan { pending: Present { value: t }, names: acc.names, not_shards: acc.not_shards, members: acc.members }
    Present { value: k } => V41PairScan {
      pending: none,
      names: acc.names + 1,
      not_shards: if t.ends_with(".safetensors") { acc.not_shards } else { acc.not_shards + 1 },
      members: if k.contains(selector as String) { acc.members |> list_push(safetensors_index_member(name: k as NonEmptyStr, shard: t as NonEmptyStr)) } else { acc.members },
    }
  }
}

fn v41_pairs_of(tokens: List<String>, selector: NonEmptyStr) -> V41PairScan {
  fold(tokens, init: V41PairScan { pending: none, names: 0, not_shards: 0, members: [] as List<SafetensorsIndexMember> }, f: (acc, t) => v41_pair_step(acc: acc, t: t, selector: selector))
}


fn v41_scan_index_text(text: String, selector: NonEmptyStr) -> V41IndexScan {
  if text.contains("\\") {
    V41IndexScanRefused { cause: "the index text carries a backslash, so a quoted token may contain an escaped quote and the token scan cannot read it exactly" as NonEmptyStr }
  } else {
    let tokens = v41_quoted_tokens(text: text)
    let head = map(filter(enumerate(tokens), p => p.first < 3), p => p.second)
    if head != ["metadata", "total_size", "weight_map"] {
      V41IndexScanRefused { cause: join(["the index does not open with metadata, total_size, weight_map; it opens with ", join(head, ", ")], "") as NonEmptyStr }
    } else {
      let scan = v41_pairs_of(tokens: map(filter(enumerate(tokens), p => p.first >= 3), p => p.second), selector: selector)
      let unpaired = match scan.pending { Present { value: _ } => 1  Absent => 0 }
      if unpaired != 0 {
        V41IndexScanRefused { cause: "the weight_map ends on a name with no shard, so it is not the shape this scan reads" as NonEmptyStr }
      } else if scan.not_shards != 0 || scan.names == 0 {
        V41IndexScanRefused { cause: join(["the weight_map carries ", to_string(scan.not_shards), " entries whose value is not a .safetensors shard (or none at all), so it is not the shape this scan reads"], "") as NonEmptyStr }
      } else {
        V41IndexScanned { name_count: scan.names, members: scan.members }
      }
    }
  }
}

// ── A LOCAL DIAGNOSTIC OF THE SAME SCAN ────────────────────────────────────────────────────────
//
// Not a producer of the reading (see below). Run over a local copy of the index (fetched from hub_resolve_url at the pinned revision):
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/spark/v41_index_engram_selection.dag
//     --function v41_index_engram_selection_read_wet   (path in GUNBC_V41_INDEX_PATH)
// It writes target/v41-index-engram-selection-receipt.txt: the file's sha256 and size, the scan's name count and every selected member: the fields
// v41_index_engram_selection_reading carries.
data v41_index_path_env: String = "GUNBC_V41_INDEX_PATH"
data v41_index_selection_receipt_path: String = "target/v41-index-engram-selection-receipt.txt"

fn v41_index_engram_selection_read_wet() -> ProcessExit {
  let path = match shell.Env.Get(name: v41_index_path_env as NonEmptyStr).value { Present { value: v } => v  Absent => "" }
  if path == "" { exit_failure(reason: join([v41_index_path_env, " is unset: name the local copy of the index to read"], "")) } else {
    match sha256sum_file_digest_via_shell(path: path as NonEmptyStr) {
      Sha256FileDigestUnavailable { path: _, reason: r } => exit_failure(reason: join(["the index could not be digested: ", r], ""))
      Sha256FileDigest { digest: d } => {
        let read = Filesystem.Read(path: path)
        if !read.success { exit_failure(reason: join(["the index could not be read: ", read.error], "")) } else {
          match v41_scan_index_text(text: read.content, selector: v41_index_engram_selector) {
            V41IndexScanRefused { cause: c } => exit_failure(reason: c as String)
            V41IndexScanned { name_count: n, members: ms } => {
              let body = join(concat(
                [join(["index sha256=", d.hex as String, " bytes=", to_string(read.content.length()), " names=", to_string(n), " selector=", v41_index_engram_selector as String], "")],
                map(ms, m => join(["member ", m.name as String, " ", m.shard as String], ""))), "\n")
              let w = Filesystem.Write(path: v41_index_selection_receipt_path, content: join([body, "\n"], ""))
              if w.success { ExitSuccess } else { exit_failure(reason: join(["the receipt could not be written: ", w.error], "")) }
            }
          }
        }
      }
    }
  }
}

// ── THE PARSER PROBE: THE INSTRUMENT BEHIND THE DIVERGENCE ─────────────────────────────────────
//
// This is the producer that re-derives the claim the divergence above rests on, and the observation
// that retires it. Run it over the same local copy of the index:
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/spark/v41_index_engram_selection.dag
//     --function v41_index_parse_json_probe_wet   (path in GUNBC_V41_INDEX_PATH)
//
// It reports which arm extdeps.languages.json parse_json_document reaches over this document, and it
// is deliberately UNBOUNDED IN TIME: a run that does not return is itself the reading, which is the
// state the divergence rests on and the one a transcribed duration could only assert. When this exits
// zero with JsonDocumentParsed, the dissolution condition above has FIRED -- the scan is replaced by a
// fold over the parsed value, and this probe and the scan go together.
data v41_index_parse_probe_receipt_path: String = "target/v41-index-parse-json-probe-receipt.txt"

fn v41_index_parse_json_probe_wet() -> ProcessExit {
  let path = match shell.Env.Get(name: v41_index_path_env as NonEmptyStr).value { Present { value: v } => v  Absent => "" }
  if path == "" { exit_failure(reason: join([v41_index_path_env, " is unset: name the local copy of the index to parse"], "")) } else {
    let read = Filesystem.Read(path: path)
    if !read.success { exit_failure(reason: join(["the index could not be read: ", read.error], "")) } else {
      let verdict = match parse_json_document(s: read.content) {
        JsonDocumentParsed { value: _ } => "parsed: parse_json_document READ this document -- the dissolution condition on the token scan has fired"
        JsonDocumentUnreadable { gap: _ } => "unreadable: parse_json_document returned a gap over this document"
      }
      let body = join(["index bytes=", to_string(read.content.length()), " parse=", verdict], "")
      let w = Filesystem.Write(path: v41_index_parse_probe_receipt_path, content: join([body, "\n"], ""))
      if w.success { ExitSuccess } else { exit_failure(reason: join(["the receipt could not be written: ", w.error], "")) }
    }
  }
}

// ── THE READING ────────────────────────────────────────────────────────────────────────────────
//
// A READING IS A RECEIPT OF AN ENROLLED ROUTE, AND ONLY THAT. The route is the fleet-converge mode
// spark_v41_checkpoint_materialize: after the index verifies against its manifest row on the Spark, the
// mode reads the file back, digests it and runs v41_scan_index_text over its bytes, and its receipt
// carries the `index-selection` lines this row is transcribed from, with the host and run it names --
// the same standing as gunbc.spark.v41_engram_row_store v41_published_span_readings. A run of the scan
// anywhere else is a diagnostic and does not land here. Until a dispatched run's receipt is transcribed
// the reading is Unread, the observed population is the extdeps one scoped to the rows read, and the
// candidate's Engram axis stays unestablished.
type V41IndexEngramSelectionReading
  = V41IndexEngramSelectionRead {
      index_sha256_hex: Sha256DigestHex
      index_bytes: ByteSize
      name_count: Nat
      members: List<SafetensorsIndexMember>
      observed: NonEmptyStr
    }
  | V41IndexEngramSelectionUnread { obligation: NonEmptyStr }

data v41_index_engram_selection_reading: V41IndexEngramSelectionReading = V41IndexEngramSelectionUnread {
  obligation: "the .engram. selection over the full index has not been read by an enrolled route: spark_v41_checkpoint_materialize scans the verified index on the Spark, and its index-selection receipt lines are transcribed into gunbc.spark.v41_index_engram_selection v41_index_engram_selection_reading" as NonEmptyStr,
}

// THE ENGRAM POPULATION THIS REPOSITORY HAS OBSERVED. With no reading it is the extdeps population,
// scoped to the rows read; with one, the members are the reading's and the closure is the extdeps fold
// over the reading against the pin -- so a thirteenth selected name has no header entry and refuses.
fn v41_engram_population_observed_of(reading: V41IndexEngramSelectionReading) -> SafetensorsPopulationStanding {
  match reading {
    V41IndexEngramSelectionUnread { obligation: _ } => deepseek_v4_1_flash_engram_population
    V41IndexEngramSelectionRead { index_sha256_hex: h, index_bytes: b, name_count: n, members: ms, observed: _ } => {
      let selection = deepseek_v4_1_flash_index_engram_selection_of(
        index: deepseek_v4_1_flash_published_file_row(path: deepseek_v4_1_flash_safetensors_index_path, file_bytes: b, sha256_hex: h),
        name_count: n,
        selector: v41_index_engram_selector,
        members: ms,
      )
      safetensors_population_standing(
        members: ms,
        shards: deepseek_v4_1_flash_engram_shard_files,
        closure: deepseek_v4_1_flash_engram_membership_closure_of(selection: selection, index: deepseek_v4_1_flash_safetensors_index_file, index_count: deepseek_v4_1_flash_index_tensor_count),
        reading: deepseek_v4_1_flash_engram_population_reading,
      )
    }
  }
}

fn v41_engram_population_observed() -> SafetensorsPopulationStanding {
  v41_engram_population_observed_of(reading: v41_index_engram_selection_reading)
}
