  DockerDeviceMapping, DockerEnvAssignment, DockerLabel, DockerNamespaceMode,
  DockerDevicesObserved, DockerDevicesUnreadable, docker_devices_from_json,
  DockerUlimitObservation, DockerUlimitsObserved, DockerUlimitsUnreadable,
