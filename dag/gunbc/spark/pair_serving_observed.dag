// THE FIRST PAIR AS IT ACTUALLY RUNS, READ ON 2026-09-05 FROM THE HOSTS, NOT FROM THE DESIRED ROW.
// Head 192.168.1.225 (srv6, spark-3bd5) serves DeepSeek V4 Flash at tensor-parallel 2 with worker
// 192.168.1.226 (srv5, spark-a3ee), inside a docker container on each host. Everything below is an
// OBSERVATION with its source named: a process list, a unit list, the engine's own environ, the
// captured stdout, and the two launch scripts on disk. Nothing here is desired state; the render
// slice that turns gunbc.spark.pair_serving_desired into units consumes these rows as the
// realization facts it must reproduce or deliberately replace, and the drift rows at the bottom are
// the disagreements the observation itself surfaced.

type PairServingObservationProvenance {
  observed_on: NonEmptyStr
  observed_by: NonEmptyStr
  sources: List<NonEmptyStr>
}

data first_pair_observation_provenance: PairServingObservationProvenance = PairServingObservationProvenance {
  observed_on: "2026-09-05" as NonEmptyStr,
  observed_by: "operator lane witty-seal-144, relayed by the operator" as NonEmptyStr,
  sources: [
    "ps -eo user,args on 192.168.1.225 and 192.168.1.226" as NonEmptyStr,
    "systemctl list-units --all on both hosts" as NonEmptyStr,
    "/proc/<engine pid>/environ on 192.168.1.225" as NonEmptyStr,
    "docker exec dsv4 cat /root/prod_a.log on 192.168.1.225" as NonEmptyStr,
    "/usr/local/bin/spark-vllm-head.sh and /root/launch_prod_pair.sh on 192.168.1.225" as NonEmptyStr,
  ],
}

// THE RUNTIME IS A CONTAINER, NOT A HOST INSTALL, AND ITS CLOSURE IS REPRODUCIBLE. `which vllm`
// finds nothing on the host; the engine is /opt/env/bin/vllm inside container dsv4. The local tag
// dsv4-ray:local is a docker commit on top of a PUBLIC base image,
// aidendle94/sparkrun-vllm-ds4-gb10:production-ready (image id b2eb4e6ee5cc, 2026-05-31), whose
// history carries the whole build (overlay/vllm into site-packages, b12x pip install, CUDA env);
// the local layer is only `CMD sleep infinity` plus the JIT caches (207M under /cache) and the
// launch script, and it differs per host (377dd4d0b0f9 on srv6, 0256d9df625d on srv5, both
// committed 2026-09-03T04:53Z). So the runtime identity convergence should carry is the base
// image's registry digest plus a rendered container spec; the local commits are drift, not a
// build. The JIT caches live in the container's writable layer, so a recreated container rebuilds
// them on first start.
type ContainerRuntimeObserved {
  container_name: NonEmptyStr
  image_tag: NonEmptyStr
  base_image: NonEmptyStr
  base_image_id: NonEmptyStr
  local_image_id_srv6: NonEmptyStr
  local_image_id_srv5: NonEmptyStr
  vllm_self_reported_version: NonEmptyStr
  python_executable: NonEmptyStr
  weights_mount: NonEmptyStr
  jit_cache_root_in_container: NonEmptyStr
}

data first_pair_container_runtime: ContainerRuntimeObserved = ContainerRuntimeObserved {
  container_name: "dsv4" as NonEmptyStr,
  image_tag: "dsv4-ray:local" as NonEmptyStr,
  base_image: "aidendle94/sparkrun-vllm-ds4-gb10:production-ready" as NonEmptyStr,
  base_image_id: "b2eb4e6ee5cc" as NonEmptyStr,
  local_image_id_srv6: "sha256:377dd4d0b0f91c2436292d4c2d254358e4aebab28b282e1de6d34774a056b496" as NonEmptyStr,
  local_image_id_srv5: "sha256:0256d9df625d0ca3f1b6804a83adcc77be9aace35e66957a40973b5cf64a8b89" as NonEmptyStr,
  vllm_self_reported_version: "0.21.1rc1.dev339+g1967a5627bc3" as NonEmptyStr,
  python_executable: "/opt/env/bin/python3" as NonEmptyStr,
  weights_mount: "/weights" as NonEmptyStr,
  jit_cache_root_in_container: "/cache/huggingface" as NonEmptyStr,
}

