// The Ray head as spark-vllm-head.sh starts it inside the container. The node address is the
// head's endpoint on the first pair's rail 0 (gunbc.spark.fabric_link_desired first_pair_fabric_rail0,
// srv6 at 192.168.102.10); the worker joins that address. A zero monitor refresh is set and
// documented in the script as load-bearing: Ray's threshold monitor SIGKILLed rank 0 on a ~395 MB
// overshoot because on GB10 the device reservation is system memory.
type RayHeadObserved {
  node_ip: Ipv4Address
  gcs_port: Port
  num_cpus: Nat
  num_gpus: Nat
  object_store_memory_bytes: Nat
  memory_monitor_refresh: Millisecond
}

data first_pair_ray_head: RayHeadObserved = RayHeadObserved {
  node_ip: ipv4_address(octet1: 192, octet2: 168, octet3: 102, octet4: 10),
  gcs_port: 6379,
  num_cpus: 20,
  num_gpus: 1,
  object_store_memory_bytes: 38867934412,
  memory_monitor_refresh: millisecond(count: 0),
}

// The engine's live environment, from /proc/<pid>/environ, which is the CONTAINER'S baked
// environment (docker inspect .Config.Env): the launch script's exports reach only the shell that
// starts Ray, and the ranks inherit those through the raylet, while the API server is started by a
// second docker exec that inherits the container env. That env carries three values foreign to
// these hosts, baked at docker run on whatever machine first ran the image: NODE_IP=192.168.50.58,
// MN_IF_NAME=enP7s7 and TP_SOCKET_IFNAME=enP7s7 (enP7s7 is the no-carrier RJ45 port on both units).
type CollectiveTransportEnvObserved {
  vllm_host_ip: Ipv4Address
  nccl_net: NonEmptyStr
  nccl_ib_hca: NonEmptyStr
  nccl_ib_gid_index: Nat
  nccl_socket_ifname: NonEmptyStr
  gloo_socket_ifname: NonEmptyStr
  tp_socket_ifname: NonEmptyStr
  vllm_allow_long_max_model_len: Bool
  vllm_cache_root: NonEmptyStr
}

data first_pair_collective_env_live: CollectiveTransportEnvObserved = CollectiveTransportEnvObserved {
  vllm_host_ip: ipv4_address(octet1: 192, octet2: 168, octet3: 102, octet4: 10),
