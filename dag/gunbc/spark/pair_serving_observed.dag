// THE POOL, FROM THE ENGINE'S OWN STARTUP LINE. The earlier figure derived from num_gpu_blocks x
// block_size (343,088) was wrong on this MLA/fp8_ds_mla build, and kv_cache_usage_perc counts
// retained prefix-cache blocks, so it is not a saturation signal (96.5% with zero requests running).
// The concurrency limiter in practice is max-num-seqs, not the pool.
type KvPoolObserved {
  pool_tokens: Nat
  max_concurrency_at_max_model_len_wire: NonEmptyStr
  rank0_available_kv_wire: NonEmptyStr
  rank1_available_kv_wire: NonEmptyStr
  source_line: NonEmptyStr
}

data first_pair_kv_pool: KvPoolObserved = KvPoolObserved {
  pool_tokens: 4632182,
  max_concurrency_at_max_model_len_wire: "4.42x for 1,048,576 tokens per request" as NonEmptyStr,
  rank0_available_kv_wire: "24.04 GiB (Worker_TP0, 192.168.1.225)" as NonEmptyStr,
  rank1_available_kv_wire: "21.01 GiB (Worker_TP1, 192.168.1.226)" as NonEmptyStr,
  source_line: "[kv_cache_utils.py:1733] GPU KV cache size: 4,632,182 tokens" as NonEmptyStr,
}

// EACH GROUP'S OWN LAUNCH LINE, read from its head's captured stdout after the roster promoted it.
// A group's admission count is sized from its own pool; the first pair's pool above is history.
type GroupKvPoolObserved {
  group: FabricGroup
  pool_tokens: Nat
  max_concurrency_at_max_model_len_wire: NonEmptyStr
  probed_at: NonEmptyStr
  source_line: NonEmptyStr
}

data group_kv_pools_observed: List<GroupKvPoolObserved> = [
  GroupKvPoolObserved {
    group: FabricGroupA,
    pool_tokens: 11767856,
    max_concurrency_at_max_model_len_wire: "11.22x for 1,048,576 tokens per request" as NonEmptyStr,
    probed_at: "2026-09-05T20:44Z" as NonEmptyStr,
    source_line: "[kv_cache_utils.py:1733] GPU KV cache size: 11,767,856 tokens" as NonEmptyStr,
  },
  GroupKvPoolObserved {
    group: FabricGroupB,
    pool_tokens: 11952124,
    max_concurrency_at_max_model_len_wire: "11.40x for 1,048,576 tokens per request" as NonEmptyStr,
    probed_at: "2026-09-05T21:20:37Z" as NonEmptyStr,
    source_line: "[kv_cache_utils.py:1733] GPU KV cache size: 11,952,124 tokens" as NonEmptyStr,
  },
]

fn fabric_group_same(a: FabricGroup, b: FabricGroup) -> Bool {
  match a {
    FabricGroupA => match b { FabricGroupA => true  FabricGroupB => false }
    FabricGroupB => match b { FabricGroupA => false  FabricGroupB => true }
  }
}

fn group_kv_pool_observed(group: FabricGroup) -> GroupKvPoolObserved? {
  first(filter(group_kv_pools_observed, r => fabric_group_same(a: r.group, b: group)))
}

// ── WHAT A RANK ACTUALLY HAS FREE WHEN IDLE, WHICH IS NOT total_memory AND NOT A FRACTION OF IT ──
//
// THREE QUANTITIES THAT ARE ROUTINELY CONFLATED, and this module carries only the third. The DEVICE
// TOTAL is a hardware property and lives on gunbc.spark.serving_deployment_selection FleetSnapshot.
// A REQUESTED ENVELOPE is total x --gpu-memory-utilization and is a launch parameter, not a reading.
// IDLE FREE is what the runtime found unallocated on an idle rank, and it is smaller than the total
// by whatever the driver, the CUDA context and the container already hold -- an amount no fraction
// of the total predicts. A lower-bound feasibility screen wants THIS one, because it is the only one
// of the three that is an observation of the machine rather than a property or a request.
//
// THE PRECISION IS THE REPORTER'S AND THE ROW SAYS SO. The runtime prints one decimal of GiB, so the
// reading is 116.9 GiB and its true value lies within about 0.05 GiB of that. The byte figure below
// is DERIVED from the reported GiB by std.measure rather than transcribed as a product, so a reader
// who disputes the conversion can re-derive it; and any consumer comparing against it must be able
// to survive the 0.05 GiB uncertainty, which is a fact about the reading, not a caveat to be dropped
// once it is inconvenient. Rounding is GENEROUS here in the direction that matters: 116.9 is at most
// 0.05 GiB above the truth, so a shortfall larger than that is established rather than borderline.
// THE READING IS TWO ByteSize ENDPOINTS, NOT A SCALAR WITH A REMEMBERED SCALE (review 65713).
//
// A first cut stored `reported_free_gib_tenths: Nat` and left a function to interpret it -- a product-layer
// memory quantity whose unit lived in the field NAME and in one reader's head. std.measure owns byte
// quantities, so the carrier holds them, and the tenths-of-a-GiB arithmetic happens ONCE at the
// declaration where the reported figure is transcribed.
//
// AND THE UNCERTAINTY IS NUMERIC RATHER THAN PROSE, WHICH IS THE OTHER HALF OF THE SAME FINDING. The
// runtime prints one decimal of GiB, so the true value lies within about 0.05 GiB of the figure. That was
// carried in `precision_caveat` -- a sentence -- while every consumer compared against the point value as
// if it were exact. A screen built on it could therefore EXCLUDE a requirement that actually fits, which
// DESIGN section 4d names directly: do not over-generalize a prohibition, because the cost is the thing
// you never did and the failure looks like rigour. So the endpoints are fields, and a consumer that
// refuses must justify itself against the one that makes refusing hardest.
//
// The prose stays, because a reader still needs to know WHY there are two endpoints. It is no longer the
// only place the fact lives.
// THE UNCERTAINTY REGION IS ONE FACT AND IS CARRIED AS ONE. Two sibling `ByteSize` endpoints were a
// hand-written `{low, high}` record, which `std.interval` `OrderedClosedInterval` exists to forbid: a
// transposed pair is not a wide region, it denotes nothing, and the memory screen subtracts against it.
// The endpoints here are hand-typed hundredths, so nothing but the type stops a future row reversing
// them.
//
// THE FIELD HOLDS THE CONSTRUCTION RATHER THAN THE INTERVAL, which is a departure from the shape review
// 66511 prescribed and is forced rather than preferred. The only mint is `closed_interval`, which
// refuses a reversed pair and therefore returns `IntervalConstruction`; a data initializer has no arm
// in which to unwrap it, and every way of unwrapping it here -- swapping the endpoints, dropping the
// row, substituting a default -- is the absorbing fallback DESIGN section 5 forbids. Storing the
// construction keeps the refusal on the path to the consumer, which is what the wall is for.
//
// SO THIS CLASS DOES NOT INHERIT `OrderedClosedInterval`'s RUNG, and saying otherwise would be rung
// inflation (DESIGN section 4b). `OrderedClosedInterval` reaches rung four: reversed endpoints have no
// constructor. Here a reversed pair is still WRITABLE in the row -- `gib_hundredths_interval(low: 11695,
// high: 11685)` is an authorable row that compiles -- and refuses only when a consumer folds the
// construction. Measured against that boundary the class sits at rung one to two: the harm is contained
// by a typed refusal that reaches `candidate_component_budget` as an evidence obligation (one), and the
// witness roster below asserts every authored row mints successfully, so an authored transposition reds
// at witness time rather than at the first consumer (two) -- which depends on that claim executing and
// staying enrolled, and is therefore not three.
//
// CEILING: rung four, by a `std.interval` mint that can be checked at construction, so a reversed pair
// has no constructor at the row either. TRIGGER: that mint existing in `std.interval` -- the capability,
// not this module's adoption of it. It is deliberately not proposed here: `std.interval` is a
// load-bearing authority and widening its constructor surface is its own decision, not a side effect of
// repairing one observation row.
type GroupRankFreeMemoryObserved {
  group: FabricGroup
  reported_free_wire: NonEmptyStr
  free: IntervalConstruction<ByteSize>
  probed_at: NonEmptyStr
  instrument: NonEmptyStr
  precision_caveat: NonEmptyStr
}

data group_rank_free_memory_observed: List<GroupRankFreeMemoryObserved> = [
  GroupRankFreeMemoryObserved {
    group: FabricGroupA,
    reported_free_wire: "116.9 GiB free per rank with the engine idle" as NonEmptyStr,
    free: gib_hundredths_interval(low_hundredths: 11685, high_hundredths: 11695),
    probed_at: "2026-09-12" as NonEmptyStr,
    instrument: "the serving runtime's own memory-profiling line on an idle Group A rank during the V4.1 Flash rollout, read from the head's captured stdout; NVML refuses this query on unified memory and must not be substituted for it" as NonEmptyStr,
    precision_caveat: "the runtime reports one decimal of GiB, so the true free value lies within about 0.05 GiB of this figure; a verdict drawn against this bound must exceed that uncertainty to be established rather than borderline" as NonEmptyStr,
  },
]

// ONE TENTH OF A GIBIBYTE IS NOT A BYTE COUNT ANYONE SHOULD TYPE. The reported figure is tenths of
// GiB, so the byte value is a std.measure scaling of a Gibibyte measure and not a hand-multiplied
// literal -- the same reason this module records a source line rather than a retyped number.
// THE ENDPOINTS ARE HALF THE REPORTER'S LAST PRINTED DIGIT EITHER SIDE, WHICH IS WHY THE SCALE IS
// HUNDREDTHS AND NOT TENTHS. A runtime printing one decimal of GiB emits 116.9 for anything in
// [116.85, 116.95), so the bracket is 11685 and 11695 hundredths -- a span of 0.1 GiB, not 1.0. A first
// cut wrote 1164 and 1174 tenths, which is the same construction at the wrong scale and would have handed
// the memory screen a bound ten times too generous. The conversion is std.measure's, once, here.
fn gib_hundredths_to_bytes(hundredths: Nat) -> ByteSize {
  measure_scale_fraction_floor(
    m: gibibyte_to_byte_size(g: gibibyte(count: hundredths)),
    num: 1,
    den: 100)
}

// WHICH ENDPOINT A CONSUMER MAY USE IS NOT ITS CHOICE TO MAKE FREELY, so the two are named for what they
// are good for rather than offered as an undifferentiated pair. An IMPOSSIBILITY screen must use the
// upper endpoint: it may refuse only what does not fit even the most generous reading. Anything claiming
// that memory IS available must use the lower.
fn gib_hundredths_interval(low_hundredths: Nat, high_hundredths: Nat) -> IntervalConstruction<ByteSize> {
  closed_interval(
    low: gib_hundredths_to_bytes(hundredths: low_hundredths),
    high: gib_hundredths_to_bytes(hundredths: high_hundredths),
    le: measure_le)
}

// A REFUSED REGION IS NOT A MISSING ONE, and both are unusable here, so this answers `none` and the
// caller owes an obligation either way. Returning the generous endpoint of a region that denotes
// nothing is exactly the plausible number the interval authority exists to prevent.
fn group_rank_free_memory_upper(r: GroupRankFreeMemoryObserved) -> ByteSize? {
  match r.free {
    IntervalReady { interval: i } => Present { value: interval_high(interval: i) }
    IntervalRefused { reason: _ } => none
  }
}

fn group_rank_free_memory(group: FabricGroup) -> GroupRankFreeMemoryObserved? {
  first(filter(group_rank_free_memory_observed, r => fabric_group_same(a: r.group, b: group)))
}

// The head host of the first pair as observed: the unit and the serve process are on srv6, and the
// Ray node address is srv6's rail-0 endpoint.
data first_pair_observed_head: HostIdentity = operator_host_srv6

// DRIFT THE OBSERVATION SURFACED. Each row is a disagreement between two sources for one fact; the
// render slice must resolve each explicitly rather than pick a side by accident.
type PairServingObservedDrift {
  subject: NonEmptyStr
  first_source: NonEmptyStr
  second_source: NonEmptyStr
  consequence: NonEmptyStr
}

data first_pair_observed_drift: List<PairServingObservedDrift> = [
  PairServingObservedDrift {
    subject: "TP_SOCKET_IFNAME" as NonEmptyStr,
    first_source: "spark-vllm-head.sh exports enp1s0f0np0" as NonEmptyStr,
    second_source: "the live engine environ carries enP7s7" as NonEmptyStr,
    consequence: "the API server ran with the container's baked value while the ranks ran with the script's; the head script was patched on 2026-09-05 (backup spark-vllm-head.sh.bak-20260905) so the engine launch carries the same exports as the Ray start, and the running engine keeps the old value until its next restart" as NonEmptyStr,
  },
  PairServingObservedDrift {
    subject: "runtime image identity" as NonEmptyStr,
    first_source: "srv6 dsv4-ray:local is 377dd4d0b0f9" as NonEmptyStr,
    second_source: "srv5 dsv4-ray:local is 0256d9df625d" as NonEmptyStr,
    consequence: "one tag names two images; both are commits of the same public base b2eb4e6ee5cc, so convergence carries the base image and a rendered container spec, never the local tag" as NonEmptyStr,
  },
  PairServingObservedDrift {
    subject: "who owns the head engine" as NonEmptyStr,
    first_source: "spark-vllm.service is the declared bring-up and is inactive" as NonEmptyStr,
    second_source: "the engine was launched by nohup from launch_prod_pair.sh and has run 36 hours" as NonEmptyStr,
    consequence: "no supervisor restarts the engine on failure; the unit is not the authority for what runs" as NonEmptyStr,
  },
