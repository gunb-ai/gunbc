module gunbc.spark.pair_serving_observed

import std.types { String, Bool, List, NonEmptyStr, Port }
import std.nat { Nat }
import std.measure { Millisecond, millisecond, TokenCount, token_count }
import product.placement_supply { HostIdentity }
import extdeps.network.ipv4 { Ipv4Address, ipv4_address }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }
import gunbc.spark.fabric_link_desired { SparkFabricPair, Srv5Srv6 }

// THE FIRST PAIR AS IT ACTUALLY RUNS, READ ON 2026-09-05 FROM THE HOSTS, NOT FROM THE DESIRED ROW.
// Head 192.168.1.225 (srv6, spark-3bd5) serves DeepSeek V4 Flash at tensor-parallel 2 with worker
// 192.168.1.226 (srv5, spark-a3ee), inside a docker container on each host. Everything below is an
// OBSERVATION with its source named: a process list, a unit list, the engine's own environ, the
// captured stdout, and the two launch scripts on disk. Nothing here is desired state; the render
// slice that turns gunbc.spark.pair_serving_desired into units consumes these rows as the
// realization facts it must reproduce or deliberately replace, and the drift rows at the bottom are
// the disagreements the observation itself surfaced.

type PairServingObservationProvenance {
  observed_on: NonEmptyStr
  observed_by: NonEmptyStr
  sources: List<NonEmptyStr>
}

data first_pair_observation_provenance: PairServingObservationProvenance = PairServingObservationProvenance {
  observed_on: "2026-09-05" as NonEmptyStr,
  observed_by: "operator lane witty-seal-144, relayed by the operator" as NonEmptyStr,
  sources: [
    "ps -eo user,args on 192.168.1.225 and 192.168.1.226" as NonEmptyStr,
    "systemctl list-units --all on both hosts" as NonEmptyStr,
    "/proc/<engine pid>/environ on 192.168.1.225" as NonEmptyStr,
    "docker exec dsv4 cat /root/prod_a.log on 192.168.1.225" as NonEmptyStr,
    "/usr/local/bin/spark-vllm-head.sh and /root/launch_prod_pair.sh on 192.168.1.225" as NonEmptyStr,
  ],
}

// THE RUNTIME IS A LOCALLY BUILT CONTAINER IMAGE, NOT A HOST INSTALL. `which vllm` finds nothing on
// the host; the engine is /opt/env/bin/vllm inside container dsv4 from image dsv4-ray:local. A
// local tag is not a reproducible artifact identity: the image digest must be read back on the host
// before the render slice can carry a runtime identity, which is why this row holds the tag and the
// self-reported version and NOT a closure digest.
type ContainerRuntimeObserved {
  container_name: NonEmptyStr
  image_tag: NonEmptyStr
  vllm_self_reported_version: NonEmptyStr
  python_executable: NonEmptyStr
  weights_mount: NonEmptyStr
}

data first_pair_container_runtime: ContainerRuntimeObserved = ContainerRuntimeObserved {
  container_name: "dsv4" as NonEmptyStr,
  image_tag: "dsv4-ray:local" as NonEmptyStr,
  vllm_self_reported_version: "0.21.1rc1.dev339+g1967a5627bc3" as NonEmptyStr,
  python_executable: "/opt/env/bin/python3" as NonEmptyStr,
  weights_mount: "/weights" as NonEmptyStr,
}

// The model on disk, mounted into the container at the weights mount.
type ModelSnapshotObserved {
  hub_repository: NonEmptyStr
  snapshot_revision: NonEmptyStr
  host_path: NonEmptyStr
  size_on_disk: NonEmptyStr
}

data first_pair_model_snapshot: ModelSnapshotObserved = ModelSnapshotObserved {
  hub_repository: "deepseek-ai/DeepSeek-V4-Flash" as NonEmptyStr,
  snapshot_revision: "60d8d70770c6776ff598c94bb586a859a38244f1" as NonEmptyStr,
  host_path: "/home/briansrls/.cache/huggingface/hub/models--deepseek-ai--DeepSeek-V4-Flash/snapshots/60d8d70770c6776ff598c94bb586a859a38244f1" as NonEmptyStr,
  size_on_disk: "158G (du -sh)" as NonEmptyStr,
}

// The engine invocation as the process list shows it, field by field.
type VllmServeObserved {
  served_model_name: NonEmptyStr
  bind_host: NonEmptyStr
  port: Port
  tensor_parallel_size: Nat
  distributed_executor_backend: NonEmptyStr
  max_model_len: TokenCount
  max_num_seqs: Nat
  kv_cache_dtype: NonEmptyStr
  gpu_memory_utilization_wire: NonEmptyStr
  enable_prefix_caching: Bool
  enable_auto_tool_choice: Bool
  tool_call_parser: NonEmptyStr
}

data first_pair_vllm_serve: VllmServeObserved = VllmServeObserved {
  served_model_name: "deepseek-v4-flash:iq3s-split" as NonEmptyStr,
  bind_host: "0.0.0.0" as NonEmptyStr,
  port: 30000,
  tensor_parallel_size: 2,
  distributed_executor_backend: "ray" as NonEmptyStr,
  max_model_len: token_count(count: 1048576),
  max_num_seqs: 32,
  kv_cache_dtype: "fp8_ds_mla" as NonEmptyStr,
  gpu_memory_utilization_wire: "0.82" as NonEmptyStr,
  enable_prefix_caching: true,
  enable_auto_tool_choice: true,
  tool_call_parser: "deepseek_v4" as NonEmptyStr,
}

// The Ray head as spark-vllm-head.sh starts it inside the container. The node address is the
// head's endpoint on the first pair's rail 0 (gunbc.spark.fabric_link_desired first_pair_fabric_rail0,
// srv6 at 192.168.102.10); the worker joins that address. A zero monitor refresh is set and
// documented in the script as load-bearing: Ray's threshold monitor SIGKILLed rank 0 on a ~395 MB
// overshoot because on GB10 the device reservation is system memory.
type RayHeadObserved {
  node_ip: Ipv4Address
  gcs_port: Port
  num_cpus: Nat
  num_gpus: Nat
  object_store_memory_bytes: Nat
  memory_monitor_refresh: Millisecond
}

data first_pair_ray_head: RayHeadObserved = RayHeadObserved {
  node_ip: ipv4_address(octet1: 192, octet2: 168, octet3: 102, octet4: 10),
  gcs_port: 6379,
  num_cpus: 20,
  num_gpus: 1,
  object_store_memory_bytes: 38867934412,
  memory_monitor_refresh: millisecond(count: 0),
}

// The engine's live environment, from /proc/<pid>/environ: which interfaces each collective uses.
type CollectiveTransportEnvObserved {
  vllm_host_ip: Ipv4Address
  nccl_net: NonEmptyStr
  nccl_ib_hca: NonEmptyStr
  nccl_ib_gid_index: Nat
  nccl_socket_ifname: NonEmptyStr
  gloo_socket_ifname: NonEmptyStr
  tp_socket_ifname: NonEmptyStr
  vllm_allow_long_max_model_len: Bool
  vllm_cache_root: NonEmptyStr
}

data first_pair_collective_env_live: CollectiveTransportEnvObserved = CollectiveTransportEnvObserved {
  vllm_host_ip: ipv4_address(octet1: 192, octet2: 168, octet3: 102, octet4: 10),
  nccl_net: "IB" as NonEmptyStr,
  nccl_ib_hca: "rocep1s0f0,roceP2p1s0f0" as NonEmptyStr,
  nccl_ib_gid_index: 3,
  nccl_socket_ifname: "enp1s0f0np0,enP2p1s0f0np0" as NonEmptyStr,
  gloo_socket_ifname: "enp1s0f0np0" as NonEmptyStr,
  tp_socket_ifname: "enP7s7" as NonEmptyStr,
  vllm_allow_long_max_model_len: true,
  vllm_cache_root: "/cache/huggingface/vllm-cache" as NonEmptyStr,
}

// What the launch script exports for the same variable. The live engine disagrees (see drift).
data first_pair_script_tp_socket_ifname: NonEmptyStr = "enp1s0f0np0" as NonEmptyStr

// Units on each host and their observed activity. The head's unit is a boot-time bring-up that is
// inactive while the container it started 36 hours earlier keeps running; the engine itself was
// launched by nohup from launch_prod_pair.sh with stdout captured inside the container.
type UnitObserved {
  host: HostIdentity
  unit: NonEmptyStr
  scope: NonEmptyStr
  active_state: NonEmptyStr
  role: NonEmptyStr
}

data first_pair_units: List<UnitObserved> = [
  UnitObserved { host: operator_host_srv6, unit: "spark-vllm.service" as NonEmptyStr, scope: "system" as NonEmptyStr, active_state: "inactive (dead)" as NonEmptyStr, role: "boot-time bring-up of the head container; the container outlived it" as NonEmptyStr },
  UnitObserved { host: operator_host_srv5, unit: "spark-ray-worker.service" as NonEmptyStr, scope: "system" as NonEmptyStr, active_state: "active (running)" as NonEmptyStr, role: "runs /usr/local/bin/spark-ray-worker.sh: ray worker only, no vllm serve" as NonEmptyStr },
  UnitObserved { host: operator_host_srv5, unit: "gunbc-vllm.service" as NonEmptyStr, scope: "system" as NonEmptyStr, active_state: "inactive (dead)" as NonEmptyStr, role: "leftover of the abandoned earlier gunbc deployment, still in default.target.wants" as NonEmptyStr },
  UnitObserved { host: operator_host_srv5, unit: "gunbc-vllm-verify.service" as NonEmptyStr, scope: "system" as NonEmptyStr, active_state: "failed" as NonEmptyStr, role: "leftover of the abandoned earlier gunbc deployment, still in default.target.wants" as NonEmptyStr },
]

data first_pair_stdout_capture: NonEmptyStr = "/root/prod_a.log inside container dsv4 on 192.168.1.225 (nohup $LAUNCH > $LOG 2>&1)" as NonEmptyStr

// THE POOL, FROM THE ENGINE'S OWN STARTUP LINE. The earlier figure derived from num_gpu_blocks x
// block_size (343,088) was wrong on this MLA/fp8_ds_mla build, and kv_cache_usage_perc counts
// retained prefix-cache blocks, so it is not a saturation signal (96.5% with zero requests running).
// The concurrency limiter in practice is max-num-seqs, not the pool.
type KvPoolObserved {
  pool_tokens: Nat
  max_concurrency_at_max_model_len_wire: NonEmptyStr
  rank0_available_kv_wire: NonEmptyStr
  rank1_available_kv_wire: NonEmptyStr
  source_line: NonEmptyStr
}

data first_pair_kv_pool: KvPoolObserved = KvPoolObserved {
  pool_tokens: 4632182,
  max_concurrency_at_max_model_len_wire: "4.42x for 1,048,576 tokens per request" as NonEmptyStr,
  rank0_available_kv_wire: "24.04 GiB (Worker_TP0, 192.168.1.225)" as NonEmptyStr,
  rank1_available_kv_wire: "21.01 GiB (Worker_TP1, 192.168.1.226)" as NonEmptyStr,
  source_line: "[kv_cache_utils.py:1733] GPU KV cache size: 4,632,182 tokens" as NonEmptyStr,
}

// The head host of the first pair as observed: the unit and the serve process are on srv6, and the
// Ray node address is srv6's rail-0 endpoint.
data first_pair_observed_head: HostIdentity = operator_host_srv6
data first_pair_observed_pair: SparkFabricPair = Srv5Srv6

// DRIFT THE OBSERVATION SURFACED. Each row is a disagreement between two sources for one fact; the
// render slice must resolve each explicitly rather than pick a side by accident.
type PairServingObservedDrift {
  subject: NonEmptyStr
  first_source: NonEmptyStr
  second_source: NonEmptyStr
  consequence: NonEmptyStr
}

data first_pair_observed_drift: List<PairServingObservedDrift> = [
  PairServingObservedDrift {
    subject: "TP_SOCKET_IFNAME" as NonEmptyStr,
    first_source: "spark-vllm-head.sh exports enp1s0f0np0" as NonEmptyStr,
    second_source: "the live engine environ carries enP7s7" as NonEmptyStr,
    consequence: "the script's own comment says a wrong interface name kills Gloo at init_device; the next restart from the script may not come up" as NonEmptyStr,
  },
  PairServingObservedDrift {
    subject: "who owns the head engine" as NonEmptyStr,
    first_source: "spark-vllm.service is the declared bring-up and is inactive" as NonEmptyStr,
    second_source: "the engine was launched by nohup from launch_prod_pair.sh and has run 36 hours" as NonEmptyStr,
    consequence: "no supervisor restarts the engine on failure; the unit is not the authority for what runs" as NonEmptyStr,
  },
  PairServingObservedDrift {
    subject: "max_model_len" as NonEmptyStr,
    first_source: "the 2026-09-03 front-door readback reported 262144" as NonEmptyStr,
    second_source: "the running engine is launched with 1048576" as NonEmptyStr,
    consequence: "gunbc.spark.vllm_observed's readback is a superseded configuration, not the current one" as NonEmptyStr,
  },
]
