module gunbc.spark.pair_serving_observed

import std.types { String, Bool, List, NonEmptyStr, Port }
import std.nat { Nat }
import std.measure { Millisecond, millisecond, TokenCount, token_count }
import product.placement_supply { HostIdentity }
import extdeps.network.ipv4 { Ipv4Address, ipv4_address }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }
import gunbc.spark.fabric_link_desired { SparkFabricPair, Srv5Srv6 }
