  host_path: "/home/briansrls/.cache/huggingface/hub/models--deepseek-ai--DeepSeek-V4-Flash/snapshots/60d8d70770c6776ff598c94bb586a859a38244f1" as NonEmptyStr,
  size_on_disk: "158G (du -sh)" as NonEmptyStr,
