// THE JOIN BETWEEN AUTHORIZATION AND EXECUTION, which is the one thing this vertical was missing.
//
// SparkBootstrapAuthorization has always carried OperatorBootstrapCredentialRequired, and its own
// secret_purpose already says the credential is one-time, used through the modeled secret boundary,
// not retained, and not a serving requirement. A secret-materialization model, a privileged plan, an
// installer and a workflow all existed too. Nothing connected the authorization to the execution, so
// the installer emitted `sudo -n`, read the password demand, and rendered instructions for a human
// to reproduce the mutation by hand.
//
// The distinction that join encodes: the unavoidable external input is AUTHORIZATION, never
// MUTATION. Software cannot manufacture root authority from an account that lacks it, so someone
// supplies a credential once. Nobody should author host state by hand -- that asks an operator to
// reproduce a plan the process already froze, on a host it can already reach, and leaves the result
// unobserved by the thing that needed it.

// THE LEASE CONSUMES A STANDING, NOT A REFERENCE, and that is this module's own §3 correction. An
// earlier revision of this carrier built a SecretRef by concatenating a rendered HostIdentity --
// `spark-<host>-bootstrap-admin` -- which is precisely the defect the credential module's operator
// ruling of 2026-08-07 forbids: secret names are CARRIED, never DERIVED, because a computed name
// makes the secret namespace a function of how a host happens to be spelled today, and invites the
// reverse inference that a name can be reconstructed rather than looked up.
//
// Worse, a bare SecretRef asserts that a secret EXISTS, and nothing in this repository creates one.
// SparkCredentialStanding already models exactly this: `administrator_password` is either
// materialized with a carried ref or explicitly pending. So the lease takes the standing, and a
// pending administrator credential is an honest refusal rather than a reference to a secret nobody
// has authored.
//
// THE CARRIER ITSELF IS NOW std.scoped_authorization, AND IT IS A REQUEST RATHER THAN A GRANT.
// AuthorizationRequest<SparkBootstrapSubject> used to be declared here as its own type carrying host,
// bootstrap_principal, administrator, authorized_purpose and attempt_identity -- the third
// independent spelling of "a scoped operator authorization consumed by exactly one attempt" in this
// repository, beside gunbc.workflow_escalation's WorkflowApprovalState and std.temporal_effect's
// DurableApprovalGrant. It had independently reached attempt identity and purpose, and was missing
// expiry, any consumption state, and any ENFORCING scope: authorized_purpose was a sentence built
// by join(), and a rendered sentence cannot decide anything.
//
// It folds to AuthorizationRequest, not OperatorGrant, and the distinction is the honest part. This
// value is constructed by the RUN, not by an operator -- nothing here has been approved yet, so
// there is no granted_by to name and no expiry to carry. Calling it a grant would have manufactured
// consent that nobody gave. What the run states is what it NEEDS authorized; the grant is what comes
// back.
//
// The subject is owned here rather than in std, so the generic module never grows a row per lane.

type SparkBootstrapSubject {
  host: HostIdentity
  bootstrap_principal: NonEmptyStr
  administrator: SparkCredentialStanding
}

// THE ENFORCING HALF, which the lease never had. The privileged act being authorized is the
// installation of one sudoers drop-in on one host, so the scope names that position in the cited
// filesystem tree with verb Write -- not the secret, which is the MEANS, and not a sentence. A
// request against any other drop-in path fails the namespace prefix relation rather than passing
// because the prose happened to read plausibly.
fn spark_bootstrap_sudoers_scope(dropin_path: NonEmptyStr) -> AuthorizationScope {
  AuthorizationScope {
    verb: Write,
    resource: NamespacePosition {
      tree: FilesystemPathTree,
      path: ["etc", "sudoers.d", dropin_path as String],
    },
    action: "posix.sudoers.install" as AuthorizedAction,
  }
}

fn spark_bootstrap_credential_lease(
  host: HostIdentity,
  administrator: SparkCredentialStanding,
  grant: SparkManagedGrant,
  attempt_identity: NonEmptyStr,
) -> AuthorizationRequest<SparkBootstrapSubject> {
  AuthorizationRequest {
    escalation_id: "spark-bootstrap-sudoers-install" as NonEmptyStr,
    scopes: [
      spark_bootstrap_sudoers_scope(dropin_path: spark_managed_grant_wire(grant: grant)),
    ],
    subject: SparkBootstrapSubject {
      host: host,
      bootstrap_principal: fleet_bootstrap_principal_login(),
      administrator: administrator,
    },
    attempt: attempt_identity as AttemptIdentity,
    intent_hash: content_hash_of_value(
      value: spark_managed_grant_sudoers_command(grant: grant),
    ),
    destructive: true,
    purpose: join([
      "install the narrow sudoers grant '", spark_managed_grant_wire(grant: grant) as String,
      "' (", spark_managed_grant_sudoers_command(grant: grant) as String,
      ") on ", host as String,
      " -- one-time, through the modeled secret boundary, not retained",
    ], "") as NonEmptyStr,
  }
}

// THE REMOVAL, LEASE AND COMMAND TOGETHER. The lease's scope position, its intent hash and the argv
// path all derive from the one canonical retired drop-in (spark_retired_shared_inspect_dropin_name /
// _path), and the lease and the zero-field command are built and run in this one function, so no
// caller can pair the removal lease with another command or the removal with another lease.
fn spark_retired_dropin_removal_lease(
  host: HostIdentity,
  administrator: SparkCredentialStanding,
  attempt_identity: NonEmptyStr,
) -> AuthorizationRequest<SparkBootstrapSubject> {
  AuthorizationRequest {
    escalation_id: "spark-retired-sudoers-dropin-removal" as NonEmptyStr,
    scopes: [
      AuthorizationScope {
        verb: Write,
        resource: NamespacePosition { tree: FilesystemPathTree, path: ["etc", "sudoers.d", spark_retired_shared_inspect_dropin_name as String] },
        action: "posix.sudoers.remove" as AuthorizedAction,
      },
    ],
    subject: SparkBootstrapSubject {
      host: host,
      bootstrap_principal: fleet_bootstrap_principal_login(),
      administrator: administrator,
    },
    attempt: attempt_identity as AttemptIdentity,
    intent_hash: content_hash_of_value(value: spark_retired_shared_inspect_dropin_path() as String),
    destructive: true,
    purpose: join([
      "remove the retired shared sudoers drop-in ", spark_retired_shared_inspect_dropin_path() as String, " on ", host as String,
      " after every inspect grant was reinstalled under its own file on this run and read back held",
    ], "") as NonEmptyStr,
  }
}

// ── The no-lapse proof, sealed ─────────────────────────────────────────────────────────────────
//
// ONE PRIVILEGED LIFECYCLE, ONE MODULE (review of gunbc#13373). The canonical install sequence at the
// end of this module (spark_grant_install_execute: stage the grant's canonical content, visudo-validate
// it, install it, read the grantee's own sudo listing back for exactly that grant) and the removal it
// licenses live here together, so the receipt is sealed where the sequence runs.
//
// ConfirmedGrantInstall is minted ONLY by spark_grant_install_execute, ONLY on a confirmed readback,
// and carries the grant and the attempt -- not a destination path that any successful install command
// could have written. sole_constructor: no other module can fabricate one, and a raw install exit
// produces none.
type ConfirmedGrantInstall sole_constructor {
  host: HostIdentity
  grant: SparkManagedGrant
  attempt: NonEmptyStr
}

// THE ADMISSION, minted only here and only when THIS HOST, under THIS ATTEMPT, holds a confirmed
// install for EVERY modeled inspect grant (gunbc.spark.managed_grant_reconcile
// spark_modeled_inspect_grants -- derived here, never supplied by the caller). A grant that was not
// held, unread, or withheld by the admission wall is never installed, so it has no confirmed install
// and the removal is not admitted.
type RetiredDropinRemovalAdmission sole_constructor {
  host: HostIdentity
}

fn retired_dropin_removal_receipts_missing(host: HostIdentity, attempt: NonEmptyStr, confirmed: List<ConfirmedGrantInstall>) -> List<NonEmptyStr> {
  flat_map(spark_modeled_inspect_grants(), g => {
    let want = spark_managed_grant_dropin_name(grant: g) as String
    if any(confirmed, c => (c.host as String) == (host as String) && (c.attempt as String) == (attempt as String) && (spark_managed_grant_dropin_name(grant: c.grant) as String) == want) { [] } else { [spark_managed_grant_dropin_path(grant: g)] }
  })
}

// The confirmed installs a run's install steps carry. Only spark_grant_install_execute puts one there,
// so a step built from a raw successful install -- even one reporting a confirmed readback in its
// outcome -- contributes nothing.
fn spark_confirmed_installs_of(steps: List<SparkGrantInstallStep>) -> List<ConfirmedGrantInstall> {
  flat_map(steps, st => match st.confirmed {
    Present { value: c } => [c]
    Absent => []
  })
}

fn admit_retired_dropin_removal(host: HostIdentity, attempt: NonEmptyStr, confirmed: List<ConfirmedGrantInstall>) -> RetiredDropinRemovalAdmission? {
  if length(retired_dropin_removal_receipts_missing(host: host, attempt: attempt, confirmed: confirmed)) == 0 {
    Present { value: RetiredDropinRemovalAdmission { host: host } }
  } else {
    none
  }
}

// THE REMOVAL EFFECT CONSUMES THE ADMISSION: its host and its lease both derive from it, so no caller
// can run the removal without the no-lapse proof, on another host, or under an install lease.
fn run_retired_dropin_removal(
  context: FleetSshExecutionContext,
  admission: RetiredDropinRemovalAdmission,
  administrator: SparkCredentialStanding,
  attempt_identity: NonEmptyStr,
) -> PrivilegedStepOutcome
{
  run_privileged_step(
    context: context,
    host: admission.host,
    lease: spark_retired_dropin_removal_lease(host: admission.host, administrator: administrator, attempt_identity: attempt_identity),
    command: RemoveRetiredSharedInspectDropin { admission: admission },
  )
}

// WHERE THE CREDENTIAL LIVES, if anywhere. A pending standing has no resource to name, and saying so
// is the useful answer: the remedy for "no secret is enrolled" is to enrol one, which is different
// from the remedy for "the enrolled one was rejected".
fn lease_secret_resource(lease: AuthorizationRequest<SparkBootstrapSubject>) -> String? {
  match lease.subject.administrator {
    CredentialMaterializationPending => none
    CredentialMaterialized { ref: r } => Present { value: secret_ref_secret_resource(ref: r) }
  }
}

// THE ARGV A ROOT CREDENTIAL MAY CARRY, closed by construction. The alternative -- widening
// RemoteArgv into a generic { argv, stdin } carrier -- would reopen arbitrary script bodies through
// stdin under root, which is a far larger hole than the one being closed. So only the two commands
// this bootstrap needs have constructors, and a third cannot be passed through.
// RemoveRetiredSharedInspectDropin is the only removal this algebra admits. Its path is fixed
// (gunbc.spark.managed_grant_reconcile spark_retired_shared_inspect_dropin_path, the single source the
// removal lease derives from too), and it carries a SEALED admission: no caller can name the removal
// without a RetiredDropinRemovalAdmission, and only admit_retired_dropin_removal below mints one
// (review of gunbc#13373).
type AdmittedRootArgv
  = ValidateStagedSudoers { staged_path: NonEmptyStr }
  | InstallStagedSudoers { staged_path: NonEmptyStr, dropin_path: NonEmptyStr }
  | RemoveRetiredSharedInspectDropin { admission: RetiredDropinRemovalAdmission }

// THE PROMPT IS A SENTINEL, NOT EMPTY, and the empty one was a real defect rather than a style
// choice. This carried `-p ""` to suppress the prompt entirely; measured on srv6 (2026-08-20), the
// far-side portability wall REFUSED the whole argv, because portable_remote_word requires a
// non-empty word -- an empty argv word cannot survive a shell re-parse the near side does not
// control. The wall was right and this function was wrong, so the fix is here rather than a
// widening there.
//
// Dropping `-p` altogether would restore sudo's default "[sudo] password for <user>:", which is
// exactly the credential-prompt text the original suppression existed to keep out of a captured
// terminal. A fixed sentinel keeps that property, is portable under the allowlist, and is strictly
// better than empty on a second axis: sudo's default prompt is locale-dependent, so a deterministic
// prompt is the one thing here that stderr inspection can rely on.
//
// `sudo -S` reads the password from stdin; `--` terminates option parsing so a path can never be
// read as a flag. The credential is never a word here -- an argv-borne password lands in the process
// table, in any command log, and in this repository's own receipts, which print argv verbatim.
data spark_sudo_prompt_sentinel: String = "gunbc-sudo:"

fn admitted_root_argv_words(command: AdmittedRootArgv) -> List<String> {
  concat(
    ["sudo", "-S", "-p", spark_sudo_prompt_sentinel, "--"],
    match command {
      ValidateStagedSudoers { staged_path: p } => ["visudo", "-c", "-f", p as String]
      InstallStagedSudoers { staged_path: p, dropin_path: d } =>
        ["install", "-m", "0440", "-o", "root", "-g", "root", p as String, d as String]
      RemoveRetiredSharedInspectDropin { admission: _ } => ["rm", "-f", "--", spark_retired_shared_inspect_dropin_path() as String]
    },
  )
}

// TWO PHASES, TWO TYPES, so a plan cannot hold them the wrong way round. A record whose validate
// and install fields were BOTH AdmittedRootArgv fixes the ORDER of the fields while leaving the
// VALUES swappable -- SparkGrantInstallSteps { validate: InstallStagedSudoers, install:
// ValidateStagedSudoers } typechecks and installs an unvalidated sudoers file. Naming the fields
// was therefore not the wall it was claimed to be; giving each phase its own carrier is, because
// the swapped construction is now a type error rather than a witness finding.
type GrantSudoersValidation { staged_path: NonEmptyStr }
type GrantSudoersInstallation { staged_path: NonEmptyStr, dropin_path: NonEmptyStr }

fn grant_sudoers_validation_argv(command: GrantSudoersValidation) -> AdmittedRootArgv {
  ValidateStagedSudoers { staged_path: command.staged_path }
}

fn grant_sudoers_installation_argv(command: GrantSudoersInstallation) -> AdmittedRootArgv {
  InstallStagedSudoers { staged_path: command.staged_path, dropin_path: command.dropin_path }
}

fn admitted_root_argv_label(command: AdmittedRootArgv) -> String {
  match command {
    ValidateStagedSudoers { staged_path: _ } => "validate-staged-sudoers"
    InstallStagedSudoers { staged_path: _, dropin_path: _ } => "install-staged-sudoers"
    RemoveRetiredSharedInspectDropin { admission: _ } => "remove-retired-shared-inspect-dropin"
  }
}

// THE LAYERS THE OPERATION ACTUALLY PRODUCES, kept distinct because their remedies differ and one
// taxonomy would erase exactly the information that tells them apart. No credential enrolled is an
// enrolment problem; a credential sudo rejected is a wrong or stale version; a command that failed
// after sudo admitted it is a host problem. Collapsing these sends a reader to the wrong place.
type PrivilegedStepOutcome
  = CredentialNotEnrolled { lease: AuthorizationRequest<SparkBootstrapSubject> }
  | CredentialNotMaterialized { lease: AuthorizationRequest<SparkBootstrapSubject>, cause: String }
  | CredentialRejected { lease: AuthorizationRequest<SparkBootstrapSubject> }
  | PrivilegedCommandFailed { command: AdmittedRootArgv, exit_code: Int, stderr: String }
  | PrivilegedCommandSucceeded { command: AdmittedRootArgv }

fn privileged_step_succeeded(outcome: PrivilegedStepOutcome) -> Bool {
  match outcome {
    PrivilegedCommandSucceeded { command: _ } => true
    PrivilegedCommandFailed { command: _, exit_code: _, stderr: _ } => false
    CredentialRejected { lease: _ } => false
    CredentialNotEnrolled { lease: _ } => false
    CredentialNotMaterialized { lease: _, cause: _ } => false
  }
}

// SUDO'S OWN DIAGNOSTIC SEPARATES A WRONG PASSWORD FROM A FAILED COMMAND, not the exit code: sudo
// exits 1 for a rejected credential and a malformed sudoers file alike, so reading the code alone
// would report a bad password as a broken host.
fn sudo_rejected_the_credential(stderr: String) -> Bool {
  string_contains(stderr, "incorrect password attempt")
    || string_contains(stderr, "Sorry, try again")
    || string_contains(stderr, "a password is required")
}

// THE REJECTED ARM CARRIES NO STDERR, and that is deliberate rather than tidy. sudo's failure text
// is written while a credential was being handled, and a carrier that held it would put the decision
// of what is safe to print into a renderer -- one edit from disclosure. The FACT that sudo rejected
// it is the whole content of the finding; the bytes around that fact are not needed to act on it.
fn privileged_step_outcome_wire(outcome: PrivilegedStepOutcome) -> String {
  match outcome {
    CredentialNotEnrolled { lease: l } =>
      join([
        "    privileged-step CREDENTIAL-NOT-ENROLLED host=", l.subject.host as String,
        " principal=", l.subject.bootstrap_principal as String,
        " purpose=", l.purpose as String,
        " -- no administrator credential is materialized for this host, so the privileged step was",
        " never attempted; enrol one and the process applies the mutation itself\n",
      ], "")
    CredentialNotMaterialized { lease: l, cause: why } =>
      join([
        "    privileged-step CREDENTIAL-NOT-MATERIALIZED host=", l.subject.host as String,
        " principal=", l.subject.bootstrap_principal as String,
        match lease_secret_resource(lease: l) {
          Absent => ""
          Present { value: r } => join([" secret=", r], "")
        },
        " -- an administrator credential IS enrolled for this host, but this run never received its",
        " bytes, so the privileged step was never attempted: ", why,
        ". The remedy is this run's credential materialization, NOT enrolment\n",
      ], "")
    CredentialRejected { lease: l } =>
      join([
        "    privileged-step CREDENTIAL-REJECTED host=", l.subject.host as String,
        " principal=", l.subject.bootstrap_principal as String,
        match lease_secret_resource(lease: l) {
          Absent => ""
          Present { value: r } => join([" secret=", r], "")
        },
        " -- sudo did not accept the materialized credential; the enrolled version is wrong or stale\n",
      ], "")
    PrivilegedCommandFailed { command: cmd, exit_code: code, stderr: err } =>
      join([
        "    privileged-step FAILED ", admitted_root_argv_label(command: cmd),
        " exit=", to_string(code), " stderr=", err, "\n",
      ], "")
    PrivilegedCommandSucceeded { command: cmd } =>
      join(["    privileged-step ok ", admitted_root_argv_label(command: cmd), "\n"], "")
  }
}

// ── Materializing the credential at apply, and only there ───────────────────────────────────────

// THE RUN-LOCAL DELIVERY PATH, following the fleet key's own lifecycle rather than inventing a
// second one: a CI step authenticates by WIF, reads one exact secret version, writes it to a
// RUNNER_TEMP file at 0600, and wipes the file when the step ends. The .dag reads that path at the
// moment it needs it and never before.
//
// THE ENVIRONMENT-VARIABLE NAME MOVED, and the move is what made the transport repair expressible.
// It lived here as `spark_grant_credential_path_env`; the password session that actually consumes it
// lives in gunbc.fleet_bootstrap_principal_session, and a module that EXECUTES a password leg cannot
// import the module that merely named the file without closing an import cycle. So the declaration is
// now fleet_bootstrap_credential_path_env there, beside the session fact it serves, and this module
// reads it rather than owning it. The argument for a PATH rather than the secret is recorded at the
// new home; it is unchanged.

// WHICH SECRET THE STEP MUST MATERIALIZE, read off the lease rather than spelled a second time. The
// CI step that fetches the version and the code that consumes it are then one authority: a step
// fetching a different secret than the lease authorized is unwritable rather than merely unlikely.
fn lease_secret_version_resource(lease: AuthorizationRequest<SparkBootstrapSubject>) -> String? {
  match lease.subject.administrator {
    CredentialMaterializationPending => none
    CredentialMaterialized { ref: r } => Present { value: secret_ref_version_resource(ref: r) }
  }
}

// The URL the materializing step must fetch, derived rather than spelled, so the step and the lease
// cannot name different versions.
fn lease_secret_access_url(lease: AuthorizationRequest<SparkBootstrapSubject>) -> String? {
  match lease.subject.administrator {
    CredentialMaterializationPending => none
    CredentialMaterialized { ref: r } => Present { value: secret_ref_access_url(ref: r) }
  }
}

// The materialized credential, held only long enough to reach stdin. There is deliberately no
// renderer for this type and no arm of any receipt that takes one: a carrier that could be printed
// would put "is this safe to log" into whoever writes the next diagnostic.
type BootstrapCredentialMaterialization
  = BootstrapCredentialReady { secret: String }
  | BootstrapCredentialNotMaterialized { cause: NonEmptyStr }

// A PASSWORD IS BYTES. This read once called `trim` and handed the result to sudo, which corrupts
// any credential whose real bytes begin or end with a space; the damage then arrives disguised as
// sudo rejecting the password, sending a reader to re-enrol a Secret Manager version that was never
// wrong. Nothing is normalized here now: the payload is admitted exactly or it is refused.
//
// AN INTERMEDIATE REVISION REMOVED ONE TRAILING LF OR CRLF, on the stated premise that the
// materialization wrote it. That premise was false and the removal was a second silent corruption of
// the same class. gunbc.ci_spec gunbc_ci_spark_grant_install_credential_prelude base64-decodes
// Secret Manager's payload straight into the file and appends NOTHING, so a line break in that file is part of the enrolled
// secret -- and stripping it would authenticate with a different credential than the one enrolled,
// while reporting success. The producer is the authority on what the bytes are; this consumer does
// not get to reinterpret them.
//
// So any CR or LF ANYWHERE refuses. sudo -S reads the first line of stdin as the password, so a
// line-bearing secret cannot be delivered by this protocol at all: refusing names that fact, where
// stripping would hide it and passing it through would leak the remainder as input to the command
// running under root. run_privileged_step appends the single LF that terminates sudo's read, and
// that terminator is the ONLY line ending this lane ever introduces.
data credential_line_feed_code_point: Int = 10
data credential_carriage_return_code_point: Int = 13

fn credential_carries_line_break(code_points: List<Int>) -> Bool {
  any(code_points, cp =>
    cp == credential_line_feed_code_point || cp == credential_carriage_return_code_point
  )
}

// THE DECISION IS PURE AND THE EFFECT IS NOT, split so the arms are reachable by a witness at all.
// An empty file is a FAILED MATERIALIZATION, never a blank password: admitting it would send an
// empty first line to sudo, which sudo answers as a wrong password -- so a broken fetch would be
// reported as a bad credential, sending the reader to re-enrol a secret that was never the problem.
//
// A payload that is nonempty but entirely whitespace is ADMITTED, and that is deliberate. An earlier
// revision refused it as a failed materialization. That was this consumer overriding enrollment
// policy: two spaces are bytewise distinguishable from no payload, the fetch succeeded, and whether
// such a value may be an administrator password is a question for whatever writes the secret
// version. If it is wrong, sudo rejecting it as the wrong credential is the correct layer and the
// correct remedy; calling it a failed materialization would send the reader to the wrong subsystem.
// (That arm also carried its own overclaim -- it tested only space and tab while its diagnostic said
// "whitespace" -- which disappears with it.)
fn classify_credential_read(
  success: Bool,
  error: String,
  content: String,
) -> BootstrapCredentialMaterialization {
  if success == false {
    BootstrapCredentialNotMaterialized {
      cause: join(["the materialized credential file could not be read: ", error], "") as NonEmptyStr,
    }
  } else if content == "" {
    BootstrapCredentialNotMaterialized {
      cause: "the materialized credential file is empty, which is a failed materialization and never a blank password" as NonEmptyStr,
    }
  } else if credential_carries_line_break(code_points: chars(s: content)) {
    BootstrapCredentialNotMaterialized {
      cause: "the materialized credential carries a line break, and sudo -S reads only the first line of stdin as the password; this lane will not strip it, because the enrolled bytes are the credential and delivering a truncated one would authenticate as something other than what is enrolled" as NonEmptyStr,
    }
  } else {
    BootstrapCredentialReady { secret: content }
  }
}

// WHERE THE FILE IS reaches this function through the same resolution the password TRANSPORT uses,
// rather than a second copy of it. This body used to read the environment and validate the path
// itself, so after the transport repair there were two resolutions of one fact and they could
// disagree on what an untrimmed or empty value means -- the sudo credential and the sshpass file would
// then come from different places in the same leg. One resolver, two consumers.
fn read_bootstrap_credential() -> BootstrapCredentialMaterialization {
  match read_fleet_bootstrap_credential_path() {
    FleetBootstrapCredentialPathAbsent { cause: why } =>
      BootstrapCredentialNotMaterialized { cause: why }
    FleetBootstrapCredentialPathReady { path: path } => {
      let read = Filesystem.Read(path: path as String)
      classify_credential_read(success: read.success, error: read.error, content: read.content)
    }
  }
}

// ONE PRIVILEGED STEP, CREDENTIAL ON STDIN. The password reaches exactly one place -- the stdin of
// one ssh invocation whose argv is a closed constructor -- and the result is classified before
// anything is rendered, so no caller ever holds both the credential and a renderer.
//
// sudo consumes the first line of stdin as the password. The trailing newline is what terminates its
// read; without it sudo waits for one and the step hangs rather than failing, which is the failure
// mode with no diagnostic at all.
// THE SESSION IS DERIVED FROM THE PRINCIPAL, NOT CHOSEN HERE. This leg used to shape
// itself with shape_fleet_ssh_exec -- the KEY session -- while naming
// lease.subject.bootstrap_principal as the user, and the administrator password only
// ever reached sudo's stdin. So on any host where that principal holds no fleet key the
// leg refused at authentication with the credential untouched, which is every host this
// repository bootstrapped rather than hand-keyed: measured on srv9-srv12 on 2026-09-11.
// gunbc.fleet_bootstrap_principal_session now decides the session from the principal, so
// the password reaches the TRANSPORT as well as sudo.
// A leg that never opened is not a command that failed. The only way this arm is
// reached is a run holding no materialized credential path, which is the same
// condition CredentialNotMaterialized already names -- so it lands there with the
// session's own located cause rather than minting an exit code for an ssh that never
// ran.
// For the removal arm the host and lease are those of its admission, whatever the caller passed: the
// removal cannot be paired with an install lease or aimed at another host.
fn privileged_step_host(host: HostIdentity, command: AdmittedRootArgv) -> HostIdentity {
  match command {
    RemoveRetiredSharedInspectDropin { admission: a } => a.host
    ValidateStagedSudoers { staged_path: _ } => host
    InstallStagedSudoers { staged_path: _, dropin_path: _ } => host
  }
}

fn privileged_step_lease(
  lease: AuthorizationRequest<SparkBootstrapSubject>,
  command: AdmittedRootArgv,
) -> AuthorizationRequest<SparkBootstrapSubject> {
  match command {
    RemoveRetiredSharedInspectDropin { admission: a } =>
      spark_retired_dropin_removal_lease(host: a.host, administrator: lease.subject.administrator, attempt_identity: lease.attempt as NonEmptyStr)
    ValidateStagedSudoers { staged_path: _ } => lease
    InstallStagedSudoers { staged_path: _, dropin_path: _ } => lease
  }
}

fn run_privileged_step(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  lease: AuthorizationRequest<SparkBootstrapSubject>,
  command: AdmittedRootArgv,
) -> PrivilegedStepOutcome
{
  let effective_host = privileged_step_host(host: host, command: command)
  let effective_lease = privileged_step_lease(lease: lease, command: command)
  match effective_lease.subject.administrator {
    CredentialMaterializationPending => CredentialNotEnrolled { lease: effective_lease }
    CredentialMaterialized { ref: _ } =>
      match read_bootstrap_credential() {
        BootstrapCredentialNotMaterialized { cause: why } =>
          CredentialNotMaterialized { lease: effective_lease, cause: why }
        BootstrapCredentialReady { secret: secret } =>
          match portable_remote_words(raws: admitted_root_argv_words(command: command)) {
            Absent =>
              PrivilegedCommandFailed {
                command: command,
                exit_code: 0,
                stderr: "the admitted root argv is not portable under the far-side shell re-parse",
              }
            Present { value: words } =>
              match exec_as_fleet_principal_with_stdin(
                context: context,
                target: SshTarget {
                  endpoint: fleet_probe_endpoint_for(host: effective_host as String) as NonEmptyStr,
                  principal: effective_lease.subject.bootstrap_principal,
                },
                words: words,
                stdin_payload: join([secret, "\n"], ""),
                credential: BootstrapCredentialInRunEnvironment,
              ) {
                FleetPrincipalLegRefused { cause: why } =>
                  CredentialNotMaterialized { lease: effective_lease, cause: why as String }
                FleetPrincipalLegRan { session: _, result: result } =>
                  if result.success {
                    PrivilegedCommandSucceeded { command: command }
                  } else if sudo_rejected_the_credential(stderr: result.stderr) {
                    CredentialRejected { lease: effective_lease }
                  } else {
                    PrivilegedCommandFailed {
                      command: command,
                      exit_code: result.exit_code,
                      stderr: result.stderr,
                    }
                  }
              }
          }
      }
  }
}


// ── The canonical install sequence (moved from gunbc.spark.managed_grant_install, review of gunbc#13373) ──

// INSTALLING THE GRANT THE RECONCILE FOUND MISSING, which is the step that turns a receipt naming a
// gap into a process that closes it. Until this existed the only way a grant reached a host was an
// operator at a keyboard -- out-of-band actuation, manual application not committed as source, and
// the reason the reboot leg had no remedy but to ask a human.
//
// SUDOERS IS VALIDATED BEFORE IT IS INSTALLED, not after, and this ordering is the whole safety
// argument. A malformed drop-in file in /etc/sudoers.d does not fail that file alone: sudo refuses
// to parse the entire sudoers set and every privileged operation on the host stops, including the
// one that would repair it. So `visudo -c -f` runs against the STAGED copy, and the file reaches
// /etc/sudoers.d only after sudo itself has said it parses. A validation that ran afterwards would
// be reporting the damage rather than preventing it.
//
// The file lands via `install` rather than `mv` because sudo refuses to read a drop-in that is
// group- or world-writable, and ownership and mode are then facts of the command that placed it
// rather than of whatever umask the staging write happened to run under.

// THE ORDER IS THE RECORD'S SHAPE, and each phase carries its OWN type. An earlier cut froze the
// four phases as an ordered List<PlannedRemoteStep> and asserted, with a forward scan over step
// identities, that validation preceded installation -- a question about a list the executor did not
// run, since the credential cutover left it consuming only the staged write and building its own
// privileged commands. The scan dissolved with that list.
//
// Naming the phases as fields was then claimed to make the bad order unrepresentable. It did not,
// and the overclaim is recorded here rather than quietly corrected: with validate and install BOTH
// typed AdmittedRootArgv, a construction holding them the wrong way round typechecked and would
// have installed an unvalidated sudoers file. The fields fixed their own order while leaving the
// values swappable. Giving each phase a distinct carrier is the actual wall -- the swap is a type
// error now -- and the ordering witness stays as the control that the two carriers do not collapse
// back into one.
// THE UNPRIVILEGED PHASES CARRY THEIR OWN FACTS, not a pre-built step. An intermediate revision
// wrapped each in a distinct name around the SAME generic PlannedRemoteStep, which stopped a field
// swap and nothing else: StageGrantFile { step: cleanup_step } was still constructible, so the wrong
// operation could still be run in the stage position by rewrapping rather than by swapping. A
// nominal tag around an already-realized step is a label, not a wall. Each carrier now holds what
// only that phase can mean -- a typed write, or the two paths to remove -- and the PlannedRemoteStep
// is DERIVED at the execution boundary.
//
// RUNG, MEASURED RATHER THAN ASSUMED: this does NOT reach structural impossibility, and the reason
// is a checker behaviour rather than a modeling choice. Swapping the two phase FIELDS is refused --
// `expected Product(StageGrantFile), got Product(CleanupGrantStaging)`, located, nothing executed.
// But REWRAPPING is not: constructing StageGrantFile { write: <List<String>> } typechecks and runs,
// even though `write` is declared TypedRemoteFileWrite, a sole_constructor product of path and
// content. Measured 2026-08-20 by mutation, against a witness that forces the field through
// RemoteFileBytes { write: stage.write }. So named-product-against-named-product is enforced here
// and non-product-against-named-product is not, and a claim of "the wrong operation has no
// representation" would be inflation for the second case.
//
// Honest standing: phase ASSIGNMENT is structurally guaranteed against field swaps and
// mutation-verified against rewrapping. This is NOT a new error class and must not be named as one
// (§3 -- a second name for one concept). The corpus already carries the family: std.realization_schedule
// walk_finalization_note measured that return position and a data annotation are not checked at all
// while ARGUMENT position is checked and refuses correctly, and its own second correction is a
// record-field instance -- WalkPlan { finalization: NoWalkFinalization } typechecked because both
// arms inhabit one sum, repaired by PARAMETERIZING the carrier rather than by the checker; and the
// hollow-alias construction wall plan states the general form, that nominal-type discrimination is
// not enforced at these seams and the class is wrapper-payload conflation generally. What the
// measurement here ADDS to that family is one position not previously recorded: a record-literal
// FIELD holding a wholly unrelated non-product value -- neither a sibling arm of the declared sum
// nor a wrapper of its payload, so neither existing row covers it. Next-rung trigger is the family's,
// not a private one: field-position type enforcement in the v2 typechecker, at which point the rewrap
// mutation becomes a typecheck refusal and this note collapses to one line. Until then the local
// remedy is the one walk_finalization_note already proved -- carry the distinction in the type.
type StageGrantFile { write: TypedRemoteFileWrite }
type CleanupGrantStaging { staged_path: NonEmptyStr, inner_staging_path: NonEmptyStr }

fn stage_grant_file_step(grant: SparkManagedGrant, stage: StageGrantFile) -> PlannedRemoteStep {
  PlannedRemoteStep {
    identity: spark_grant_install_step_identity(grant: grant, phase: "stage"),
    operation: RemoteFileBytes { write: stage.write, mode: RemoteFileModeOwnerReadWrite },
  }
}

fn cleanup_grant_staging_argv(cleanup: CleanupGrantStaging) -> List<String> {
  ["rm", "-f", cleanup.staged_path as String, cleanup.inner_staging_path as String]
}

fn cleanup_grant_staging_step(
  grant: SparkManagedGrant,
  cleanup: CleanupGrantStaging,
) -> PlannedRemoteStep {
  PlannedRemoteStep {
    identity: spark_grant_install_step_identity(grant: grant, phase: "cleanup"),
    operation: RemoteArgv { argv: cleanup_grant_staging_argv(cleanup: cleanup) },
  }
}

type SparkGrantInstallPlan
  = SparkGrantInstallSteps {
      grant: SparkManagedGrant
      stage: StageGrantFile
      validate: GrantSudoersValidation
      install: GrantSudoersInstallation
      cleanup: CleanupGrantStaging
    }
  | SparkGrantInstallRefused { grant: SparkManagedGrant, cause: NonEmptyStr }

// STAGED IN THE INSTALLER'S OWN HOME, not the grantee's. The first cut of this took the executor
// home as a constant, so a run connecting as the operator tried to write into the automation
// account's directory and got Permission denied at the far side -- a failure that reads as a broken
// installer rather than as the wrong account being named. Whose home it is follows from who is doing
// the writing, which is exactly the fact the transport principal already carries.
fn spark_grant_staging_path(grant: SparkManagedGrant, principal: NonEmptyStr) -> FilePath {
  join([
    spark_managed_principal_home(login: principal) as String, "/.gunbc-staged-sudoers-",
    spark_managed_grant_dropin_name(grant: grant) as String,
  ], "") as FilePath
}

fn spark_grant_install_step_identity(grant: SparkManagedGrant, phase: String) -> NonEmptyStr {
  join([phase, "-", spark_managed_grant_dropin_name(grant: grant) as String], "") as NonEmptyStr
}

fn spark_grant_admit_argv(identity: NonEmptyStr, raws: List<String>) -> PlannedRemoteStep? {
  match portable_remote_words(raws: raws) {
    Absent => none
    Present { value: words } => Present {
      value: PlannedRemoteStep {
        identity: identity,
        operation: RemoteArgv { argv: portable_remote_words_strings(words: words) },
      },
    }
  }
}

fn spark_grant_install_plan(grant: SparkManagedGrant, principal: NonEmptyStr) -> SparkGrantInstallPlan {
  let staged = spark_grant_staging_path(grant: grant, principal: principal)
  match typed_remote_file_write_seal(
    path: staged,
    content: spark_managed_grant_sudoers_content(grant: grant),
    allowed_scope: FileTreeScope { root_path: spark_managed_principal_home(login: principal) },
  ) {
    TypedRemoteFileWriteAdmissionRefused { cause: why } =>
      SparkGrantInstallRefused { grant: grant, cause: why }
    TypedRemoteFileWriteAdmitted { write: w } => {
      let cleanup_phase = CleanupGrantStaging {
        staged_path: staged as NonEmptyStr,
        inner_staging_path: typed_remote_file_staging_path(write: w) as NonEmptyStr,
      }
      match spark_grant_admit_argv(
        identity: spark_grant_install_step_identity(grant: grant, phase: "cleanup"),
        raws: cleanup_grant_staging_argv(cleanup: cleanup_phase),
      ) {
        Absent =>
          SparkGrantInstallRefused {
            grant: grant,
            cause: "the staging cleanup argv is not portable under the far-side re-parse" as NonEmptyStr,
          }
        Present { value: _admitted } =>
          SparkGrantInstallSteps {
            grant: grant,
            stage: StageGrantFile { write: w },
            validate: GrantSudoersValidation { staged_path: staged as NonEmptyStr },
            install: GrantSudoersInstallation {
              staged_path: staged as NonEmptyStr,
              dropin_path: spark_managed_grant_dropin_path(grant: grant),
            },
            cleanup: cleanup_phase,
          }
      }
    }
  }
}

// THE PHASES THE EXECUTOR ACTUALLY RUNS, in the order it runs them, read off the same fields it
// consumes. This is a receipt projection and not a schedule: nothing downstream may reorder it,
// because there is nothing here to reorder.
fn spark_grant_install_operation_labels(plan: SparkGrantInstallPlan) -> List<String> {
  match plan {
    SparkGrantInstallRefused { grant: _, cause: _ } => []
    SparkGrantInstallSteps {
      grant: g2, stage: st, validate: v, install: i, cleanup: c,
    } =>
      [
        stage_grant_file_step(grant: g2, stage: st).identity as String,
        admitted_root_argv_label(command: grant_sudoers_validation_argv(command: v)),
        admitted_root_argv_label(command: grant_sudoers_installation_argv(command: i)),
        cleanup_grant_staging_step(grant: g2, cleanup: c).identity as String,
      ]
  }
}

// A SINGLE-STEP SEQUENCE REDUCED TO ITS STANDING. The sequencer answers in lists because it runs
// lists; cleanup is one step, and an empty result means it was never attempted rather than that it
// succeeded quietly -- so the identity-bearing unattempted arm is the init, never an empty list.
fn spark_grant_cleanup_standing(
  identity: NonEmptyStr,
  standings: List<RemoteStepStanding>,
) -> RemoteStepStanding {
  fold(standings, init: RemoteStepUnattempted { identity: identity }, f: fn(_, s) { s })
}

fn spark_grant_install_plan_wire(plan: SparkGrantInstallPlan) -> String {
  match plan {
    SparkGrantInstallRefused { grant: g, cause: c } =>
      join([
        "  grant-install grant=", spark_managed_grant_wire(grant: g) as String,
        " REFUSED cause=", c as String, "\n",
      ], "")
    SparkGrantInstallSteps { grant: g, stage: _, validate: _, install: _, cleanup: _ } =>
      join([
        "  grant-install grant=", spark_managed_grant_wire(grant: g) as String,
        " steps=", join(spark_grant_install_operation_labels(plan: plan), ","),
        "\n",
      ], "")
  }
}

// ── Actuation ───────────────────────────────────────────────────────────────────────────────────

// THE PRINCIPAL IS A PARAMETER OF THE PLAN, not a constant of this module, because installing a
// grant is exactly the operation the grantee cannot perform for itself. The automation account holds
// enable-linger and nothing else, so it can neither write /etc/sudoers.d nor run visudo; a bootstrap
// that assumed otherwise would fail with a password demand and no statement of who could have done
// it instead. Naming the transport principal makes "who installs privilege" a modeled fact rather
// than an assumption buried in a target constructor.
fn spark_grant_install_transport(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  principal: NonEmptyStr,
) -> HostEffectTransport {
  FleetSsh {
    target: SshTarget {
      endpoint: fleet_probe_endpoint_for(host: host as String) as NonEmptyStr,
      principal: principal,
    },
    context: context,
  }
}

// AWAITING A CREDENTIAL IS NOT A FLOOR, and calling it one was the error this arm is named for. An
// earlier revision called this BlockedOnRootOfTrust and rendered a sudoers recipe for a human to
// apply -- reasoning that privilege cannot be self-granted, therefore the mutation must be manual.
// The first half is true and the second does not follow: software cannot manufacture root authority,
// but the input that resolves that is AUTHORIZATION, not MUTATION. Supplying a credential once and
// hand-authoring host state are different acts, and only the first is unavoidable.
//
// The cost of the confusion was real: the process asked an operator to reproduce a plan it had
// already frozen, on a host it could already reach, and the result would then be unobserved by the
// thing that needed it. This arm now means exactly "no credential was supplied", and its remedy is
// the credential the authorization model has specified all along.
// AN INSTALL THAT REPORTED SUCCESS IS NOT A HOST THAT HOLDS THE GRANT, and the gap between those two
// sentences is where this whole vertical started: a sudoers line applied by hand converged nothing
// the process could see. `install` exiting zero says a file was placed; whether sudo now grants the
// command is a separate fact that only sudo can state, and it can disagree -- a drop-in with the
// wrong account name, a syntactically valid rule for a path that does not exist, or a sudoers set
// whose earlier entry takes precedence all place a file successfully and grant nothing.
//
// So the install re-reads the enumeration through the grantee's own principal and requires the grant
// to appear. Not attempted when nothing was installed, because a readback of an install that never
// ran would report the pre-existing state as the result.
type SparkGrantReadback
  = GrantReadbackConfirmed
  | GrantReadbackDisagreed { standing: NonEmptyStr }
  | GrantReadbackNotAttempted

type SparkGrantInstallOutcome
  = SparkGrantInstallAwaitingOperatorCredential {
      host: HostIdentity
      grant: SparkManagedGrant
      principal: NonEmptyStr
    }
  | SparkGrantInstallExecuted {
      host: HostIdentity
      grant: SparkManagedGrant
      standings: List<RemoteStepStanding>
      privileged: List<PrivilegedStepOutcome>
      readback: SparkGrantReadback
      cleanup: RemoteStepStanding
    }
  | SparkGrantInstallNotAttempted {
      host: HostIdentity
      grant: SparkManagedGrant
      cause: NonEmptyStr
    }

// THE SEQUENCE IS MIXED, AND DELIBERATELY NOT HOMOGENEOUS. Staging and cleanup are ordinary
// unprivileged operations; validation and installation are credential-bound. Running all four
// through one sequencer would have required a RemoteOperation that carries a credential, which is
// the generic { argv, stdin } carrier the ruling forbids -- it would reopen arbitrary script bodies
// through stdin under root. So the two privileged steps are their own operation with their own
// closed argv set, and the fold below halts across both kinds.
//
// The order is load-bearing and is now carried by the plan's SHAPE rather than asserted about it:
// validation runs against the STAGED copy before anything reaches /etc/sudoers.d, because a
// malformed drop-in there stops every privileged operation on the host including the one that would
// repair it. The staged file is removed after EVERY attempted staging -- including a failed one, and
// that is not pedantry: the staging step is itself a four-step typed convergence that writes
// <path>.gunbc-staging, modes it, renames it, then compares, so a refusal at mode or rename leaves
// the inner sibling behind and a refusal at compare leaves the final name. Cleanup therefore removes
// BOTH names, and an earlier cut that skipped cleanup whenever staging failed left exactly the files
// a failed staging is most likely to strand.
//
// Its standing is reported beside the install rather than folded into it: a failed rm leaves a 0600
// file in the installer's own home and is not a reason to call an installed grant uninstalled. Those
// are two facts and the receipt carries both, while the process exit requires both.
//
// RUNG, STATED HONESTLY: that cleanup runs after a FAILED staging is read off this function, not
// witnessed. spark_grant_install_execute needs a network transport, so no hermetic witness reaches
// the arm; what the witnesses do establish is that the cleanup command names BOTH staging paths.
// So the both-names half is mechanically preventable and the attempted-after-failure half sits at
// review diligence. Next-rung trigger: a transport seam a witness can drive with a refusing staging
// step, at which point the arm becomes executable evidence rather than a claim about this text.
// NO AUTHORIZATION, NO HOST MUTATION -- NOT EVEN A TRANSIENT ONE. The pending standing is answered
// before the first far-side operation, so the awaiting arm truthfully owes no cleanup: nothing was
// staged, so nothing can be stranded. An earlier cut staged first and then discarded the cleanup
// standing when it built that arm, while the cleanup predicate answered `true` for it
// unconditionally -- a receipt that could not show a cleanup failure it had already caused.
// ONE INSTALL'S OUTCOME AND, only when the WHOLE canonical sequence succeeded -- the grant's canonical
// content staged, visudo-validated, installed, and the grantee's own listing confirming exactly this
// grant -- the sealed ConfirmedGrantInstall this function mints for it, the only input the shared
// drop-in's removal admission accepts.
type SparkGrantInstallStep {
  outcome: SparkGrantInstallOutcome
  confirmed: ConfirmedGrantInstall?
}

fn spark_grant_install_execute(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  principal: NonEmptyStr,
  administrator: SparkCredentialStanding,
  grant: SparkManagedGrant,
) -> SparkGrantInstallStep
{
  let plan = spark_grant_install_plan(grant: grant, principal: principal)
  match plan {
    SparkGrantInstallRefused { grant: g, cause: c } =>
      SparkGrantInstallStep { outcome: SparkGrantInstallNotAttempted { host: host, grant: g, cause: c }, confirmed: none }
    SparkGrantInstallSteps {
      grant: g, stage: staged_step, validate: validate_cmd, install: install_cmd, cleanup: cleanup_step,
    } =>
      match administrator {
        CredentialMaterializationPending =>
          SparkGrantInstallStep {
            outcome: SparkGrantInstallAwaitingOperatorCredential { host: host, grant: g, principal: principal },
            confirmed: none,
          }
        CredentialMaterialized { ref: _ } => {
          let lease = spark_bootstrap_credential_lease(
            host: host,
            administrator: administrator,
            grant: g,
            attempt_identity: spark_grant_install_ci_attempt_raw as NonEmptyStr,
          )
          let transport = spark_grant_install_transport(context: context, host: host, principal: principal)
          let cleanup_planned = cleanup_grant_staging_step(grant: g, cleanup: cleanup_step)
          let staged = run_remote_step_sequence(
            steps: [stage_grant_file_step(grant: g, stage: staged_step)],
            transport: transport,
          )
          if remote_step_sequence_failed(standings: staged) {
            SparkGrantInstallStep {
              outcome: SparkGrantInstallExecuted {
                host: host, grant: g, standings: staged, privileged: [],
                readback: GrantReadbackNotAttempted,
                cleanup: spark_grant_cleanup_standing(
                  identity: cleanup_planned.identity,
                  standings: run_remote_step_sequence(steps: [cleanup_planned], transport: transport),
                ),
              },
              confirmed: none,
            }
          } else {
            {
              let validated = run_privileged_step(
                context: context, host: host, lease: lease,
                command: grant_sudoers_validation_argv(command: validate_cmd),
              )
              if privileged_step_succeeded(outcome: validated) == false {
                SparkGrantInstallStep {
                  outcome: spark_grant_install_from_privileged(
                    host: host, grant: g, principal: principal, staged: staged,
                    outcomes: [validated], readback: GrantReadbackNotAttempted,
                    cleanup: spark_grant_cleanup_standing(
                      identity: cleanup_planned.identity,
                      standings: run_remote_step_sequence(steps: [cleanup_planned], transport: transport),
                    ),
                  ),
                  confirmed: none,
                }
              } else {
                {
                  let installed = run_privileged_step(
                    context: context, host: host, lease: lease,
                    command: grant_sudoers_installation_argv(command: install_cmd),
                  )
                  let readback = if privileged_step_succeeded(outcome: installed) {
                    spark_grant_read_back(context: context, host: host, grant: g)
                  } else {
                    GrantReadbackNotAttempted
                  }
                  SparkGrantInstallStep {
                    outcome: spark_grant_install_from_privileged(
                      host: host, grant: g, principal: principal, staged: staged,
                      outcomes: [validated, installed], readback: readback,
                      cleanup: spark_grant_cleanup_standing(
                        identity: cleanup_planned.identity,
                        standings: run_remote_step_sequence(steps: [cleanup_planned], transport: transport),
                      ),
                    ),
                    confirmed: match readback {
                      GrantReadbackConfirmed =>
                        Present { value: ConfirmedGrantInstall { host: host, grant: g, attempt: spark_grant_install_ci_attempt_raw as NonEmptyStr } }
                      GrantReadbackDisagreed { standing: _ } => none
                      GrantReadbackNotAttempted => none
                    },
                  }
                }
              }
            }
          }
        }
      }
  }
}

// A CREDENTIAL THAT WAS NEVER ENROLLED IS NOT A FAILED INSTALL, and separating the two is what keeps
// "nobody has supplied authorization yet" from reading like "the installer is broken". Every other
// privileged failure stays an executed-and-failed install, because something was actually attempted.
//
// ONLY NotEnrolled TAKES THE AWAITING ARM. An earlier cut routed CredentialNotMaterialized here too,
// which rebuilt one layer up exactly the conflation the four-arm outcome exists to end: that arm
// carries neither the read cause nor the enrolled reference, so a missing environment variable, an
// unreadable file, an empty payload and a line-bearing payload all arrived at the reader as "no
// credential was supplied". They have different remedies and the first post-IAM run is precisely
// when telling them apart matters. NotMaterialized stays an EXECUTED install: staging and cleanup
// really did run against the host, and the privileged list carries its own located cause.
fn spark_grant_install_from_privileged(
  host: HostIdentity,
  grant: SparkManagedGrant,
  principal: NonEmptyStr,
  staged: List<RemoteStepStanding>,
  outcomes: List<PrivilegedStepOutcome>,
  readback: SparkGrantReadback,
  cleanup: RemoteStepStanding,
) -> SparkGrantInstallOutcome {
  if any(outcomes, o => match o {
    CredentialNotEnrolled { lease: _ } => true
    CredentialNotMaterialized { lease: _, cause: _ } => false
    CredentialRejected { lease: _ } => false
    PrivilegedCommandFailed { command: _, exit_code: _, stderr: _ } => false
    PrivilegedCommandSucceeded { command: _ } => false
  }) {
    SparkGrantInstallAwaitingOperatorCredential { host: host, grant: grant, principal: principal }
  } else {
    SparkGrantInstallExecuted {
      host: host, grant: grant, standings: staged, privileged: outcomes, readback: readback,
      cleanup: cleanup,
    }
  }
}

// THE READBACK IS THE GRANTEE'S OWN ENUMERATION, not the installer's. sudo answers "may THIS account
// run THIS command", and the account that matters is the one the serving lane will use -- asking as
// the installing principal would confirm a grant for the wrong subject entirely.
fn spark_grant_read_back(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  grant: SparkManagedGrant,
) -> SparkGrantReadback
{
  let outcome = spark_grant_probe_outcome(context: context, host: host)
  match spark_managed_grant_standing_from_outcome(grant: grant, outcome: outcome) {
    GrantHeld { grant: _ } => GrantReadbackConfirmed
    GrantNotHeld { grant: _ } =>
      GrantReadbackDisagreed {
        standing: "the install reported success and the grantee's own sudo enumeration does not name the command" as NonEmptyStr,
      }
    GrantStandingUnobserved { grant: _, cause: c } =>
      GrantReadbackDisagreed {
        standing: join(["the grant could not be re-observed after installing it: ", c as String], "") as NonEmptyStr,
      }
  }
}

// A SEQUENCE THAT HALTED IS NOT AN INSTALL. The phases are stage, validate, install and cleanup; a
// halt in the first three leaves the drop-in absent, and reporting that as installed would put a
// grant in the receipt that the host does not hold -- the exact confusion the reconcile exists to
// end. Cleanup is deliberately absent from this verdict: it runs after the fact that decides it, so
// consulting it would let a failed `rm` unsay a grant the host demonstrably holds.
// Convergence is re-established by the next observation, never by this exit code.
fn spark_grant_install_succeeded(outcome: SparkGrantInstallOutcome) -> Bool {
  match outcome {
    SparkGrantInstallAwaitingOperatorCredential { host: _, grant: _, principal: _ } => false
    SparkGrantInstallNotAttempted { host: _, grant: _, cause: _ } => false
    SparkGrantInstallExecuted { host: _, grant: _, standings: st, privileged: pr, readback: rb, cleanup: _ } =>
      remote_step_sequence_failed(standings: st) == false
        && pr.length() > 0
        && fold(pr, init: true, f: fn(acc, o) { acc && privileged_step_succeeded(outcome: o) })
        && match rb {
             GrantReadbackConfirmed => true
             GrantReadbackDisagreed { standing: _ } => false
             GrantReadbackNotAttempted => false
           }
  }
}

// WHAT THE PROCESS NEEDS, NOT WHAT A HUMAN SHOULD TYPE. This function used to render the sudoers
// line, its mode and its path as instructions to apply by hand -- and that was the defect, not the
// wording. The unavoidable external input at this seam is AUTHORIZATION; the MUTATION is the
// process's job, and telling an operator to reproduce a frozen plan by hand both asks them to do
// work convergence owns and leaves the result unobserved by the thing that needed it.
//
// So the remedy named here is the credential the authorization model has always specified:
// OperatorBootstrapCredentialRequired, whose own secret_purpose says one-time, through the modeled
// secret boundary, not retained, not a serving requirement. The operator answers "may this exact
// grant be installed on this host", and supplies a credential. They never author host state.
fn spark_grant_credential_requirement(host: HostIdentity, grant: SparkManagedGrant) -> String {
  let l = spark_bootstrap_credential_lease(
    host: host,
    administrator: CredentialMaterializationPending,
    grant: grant,
    attempt_identity: spark_grant_install_ci_attempt_raw as NonEmptyStr,
  )
  join([
    "REQUIRED: an administrator credential for ", l.subject.bootstrap_principal as String,
    " on ", l.subject.host as String,
    ", enrolled at ",
    match spark_administrator_password_secret_ref_for(host: host) {
      SparkAdministratorCredentialRefFound { ref: r } => secret_ref_version_resource(ref: r)
      SparkAdministratorCredentialHostNotEnrolled { host: h } => join(["NO ENROLLED SECRET for ", h as String, " in spark_administrator_credential_roster"], "")
    },
    " (that name is supplied, never derived; this line states WHICH secret the run needs, and never",
    " that any run holds it)",
    ". Authorized purpose: ", l.purpose as String,
    ". The credential is materialized only for this step, delivered over stdin, and never enters an",
    " argv, a plan artifact, a workflow input or this receipt. Supplying it is the whole of the",
    " external input -- the mutation itself stays inside convergence and is read back independently.",
  ], "")
}

fn spark_grant_install_outcome_wire(outcome: SparkGrantInstallOutcome) -> String {
  match outcome {
    SparkGrantInstallAwaitingOperatorCredential { host: h, grant: g, principal: p } =>
      join([
        "grant-install host=", h as String,
        " grant=", spark_managed_grant_wire(grant: g) as String,
        " AWAITING-OPERATOR-CREDENTIAL installer=", p as String,
        " -- no credential was supplied, so the privileged step could not be attempted\n    ",
        spark_grant_credential_requirement(host: h, grant: g), "\n",
      ], "")
    SparkGrantInstallNotAttempted { host: h, grant: g, cause: c } =>
      join([
        "grant-install host=", h as String,
        " grant=", spark_managed_grant_wire(grant: g) as String,
        " NOT-ATTEMPTED cause=", c as String, "\n",
      ], "")
    SparkGrantInstallExecuted { host: h, grant: g, standings: st, privileged: pr, readback: rb, cleanup: cl } =>
      join([
        "grant-install host=", h as String,
        " grant=", spark_managed_grant_wire(grant: g) as String,
        " steps=", remote_step_sequence_wire(standings: st),
        match spark_grant_install_first_failure_cause(standings: st) {
          Absent => ""
          Present { value: c } => join([" cause=", c], "")
        },
        "\n",
        join(map(pr, o => privileged_step_outcome_wire(outcome: o)), ""),
        match rb {
          GrantReadbackConfirmed => "    grant-readback CONFIRMED by the grantee's own sudo enumeration\n"
          GrantReadbackDisagreed { standing: why } =>
            join(["    grant-readback DISAGREED ", why as String, "\n"], "")
          GrantReadbackNotAttempted => "    grant-readback not attempted: nothing was installed\n"
        },
        "    staging-cleanup ", remote_step_standing_wire(standing: cl), "\n",
      ], "")
  }
}

fn spark_grant_install_first_failure_cause(standings: List<RemoteStepStanding>) -> String? {
  fold(standings, init: none, f: fn(acc, st) {
    match acc {
      Present { value: _ } => acc
      Absent => remote_step_failure_cause(standing: st)
    }
  })
}


data spark_grant_install_ci_attempt_raw: String = "spark-grant-install-ci"

// The grant reading, taken through the transport that will do the installing rather than a separate
// one: a standing measured as one principal and acted on as another is two facts wearing one name.
fn spark_grant_probe_outcome(
  context: FleetSshExecutionContext,
  host: HostIdentity,
) -> SparkGrantOutcome
{
  match run_typed_argv_transport(
    argv: ["sudo", "-n", "-l"],
    transport: spark_grant_install_transport(
      context: context,
      host: host,
      principal: spark_managed_executor_login as NonEmptyStr,
    ),
  ) {
    TypedArgvExecRefused { reason: why } => GrantProbeRefused { cause: why }
    TypedArgvExecConverged { result: r } =>
      if r.success {
        GrantEnumerated { listing: r.stdout }
      } else {
        GrantAbsent { detail: join(["exit=", to_string(r.exit_code), " stderr=", trim(s: r.stderr)], "") }
      }
  }
}

