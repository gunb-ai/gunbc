module gunbc.spark.prefill_batch_sweep

import std.types { Bool, String, NonEmptyStr, List }
import std.nat { Nat, nat_min }
import v2.std.optional { Present, Absent }
import std.measure { TokenCount, token_count, token_count_value }
import extdeps.vllm.batch_defaults { UpstreamBatchDefaultResolution, spark_gb10_batch_default_resolution }
import extdeps.vllm.engine_args { VllmKvCacheDtypeRequest, VllmSpeculativePolicy, SpeculativeDecodingOff }
import extdeps.deepseek.deepseek_v4 { deepseek_v4_context_length }
import extdeps.nvidia.nccl { NcclRealizedTransport }
import extdeps.docker.images.sparkrun_vllm_ds4_gb10 { sparkrun_vllm_ds4_gb10_pinned_reference }
import gunbc.spark.model_snapshot_acquisition { ModelSnapshotDesired, deepseek_v4_flash_snapshot, model_snapshot_revision }
import gunbc.spark.serving_arm { ServingCheckpoint, DeepseekV4FlashIq3sSplit, ServingRuntime, GunbcSparkrunVllmDs4Gb10, ServingTopology, SparkPairTp2 }
import gunbc.spark.serving_performance_subject {
  ServingPerformanceSubject, serving_performance_subject, serving_subject_standing,
  ServingPerformanceSubjectStanding, SubjectEstablished, SubjectPartial,
}

// ── THE SUBJECT OF EVERY ROW BELOW IS A RETIRING PROFILE ──────────────────────────────────────
//
// Every measurement in this module was taken against ONE model artifact --
// deepseek-ai/DeepSeek-V4-Flash at snapshot 60d8d70770c6776ff598c94bb586a859a38244f1, served by
// the vLLM revision extdeps.vllm.server names -- and that artifact is being replaced.
//
// SO EVERY COEFFICIENT HERE EXPIRES WITH IT. Not one of them may be read for another checkpoint:
// not the per-token or per-step terms, not the depth law, not the KV pool sizes, not the decode or
// stall figures, not the per-step FLOPs divisor. What survives a model change is the MECHANISM the
// numbers established, which is stated in prose beside each one; the numbers themselves are facts
// about a profile, not about the fleet.
//
// THAT SUBJECT IS NOW CARRIED STRUCTURALLY. The obligation this paragraph used to declare -- a type
// naming the model artifact, runtime, KV policy and topology, so a row from one profile cannot be
// joined to a decision about another -- is discharged at
// gunbc.spark.serving_performance_subject ServingPerformanceSubject, coined once for both
// measurement modules rather than twice. The rows below bind to it at the bottom of this file, and
// what the binding refuses is stated there rather than promised here.

// ── WHAT THE PREFILL BATCH BUDGET BUYS AND COSTS, MEASURED ACROSS FOUR LAUNCHES ───────────────
//
// THE EXPERIMENT. On 2026-09-07 the group A head was restarted four times behind a temporary
// systemd drop-in, each launch differing ONLY in `--max-num-batched-tokens` and each carrying
// `--enable-mfu-metrics` so the step population could be read. Group B was not touched and served
// throughout. Group A was restored to its authored unit afterwards, verified by the drop-in being
// absent, enable_mfu_metrics reading False, and the budget reading 2048 again.
//
// EVERY PROBE was a single `/v1/completions` with `max_tokens: 1` on an engine polled to zero
// running and zero waiting first, prefixed with a 32-character random nonce so nothing was served
// from the prefix cache, and the returned `usage.prompt_tokens` was carried rather than the
// requested size.
//
// WHY THE STEP POPULATION IS TRUSTWORTHY HERE AND WAS NOT BEFORE. The step count is read from
// `vllm:estimated_flops_per_gpu_total`, which advances once per ENGINE STEP in a fixed quantum --
// not from `vllm:iteration_tokens_total_count`, which advances once per output batch and therefore
// reads 1 for a prefill of any chunk count. Both were recorded on every probe, and the second read
// 1 on requests the first measured at 10 steps. See extdeps.vllm.metrics.

// ── MEASURED AND PREDICTED ARE DIFFERENT TYPES, NOT VARIANTS OF ONE ───────────────────────────
//
// This is the load-bearing shape of the module. A prediction and a measurement are not two
// confidence levels of one thing; consuming them through one type is how a modelled row becomes an
// observed one at the first `match` that treats the arms uniformly. There is deliberately no
// function that accepts either, and no list containing both. A consumer that wants the modelled
// 1024 row must name the predicted population explicitly and thereby say so.
type MeasuredBatchArm sole_constructor {
  subject: ServingPerformanceSubjectStanding
  max_num_batched_tokens: Nat
  probe_computed_tokens: TokenCount
  probe_wall_micros: Nat
  probe_steps: Nat
  co_tenant_decode_alone_micros: Nat
  co_tenant_decode_during_prefill_micros: Nat
  gpu_kv_cache_tokens: Nat
  binding: ArmLaunchBinding
}

type PredictedBatchArm sole_constructor {
  max_num_batched_tokens: Nat
  predicted_wall_micros_at_16400: Nat
  predicted_step_micros: Nat
  from_law: NonEmptyStr
}


// ── EVERY ARM CARRIES ITS OWN SUBJECT, BECAUSE THE SWEPT AXIS IS A SUBJECT AXIS ───────────────
//
// THE FIRST ATTEMPT AT THIS BINDING PUT ONE `spark_group_a_batch_arm_subject` BESIDE THE POPULATION
// AND THAT WAS INCOHERENT. `max_num_batched_tokens` IS one of the axes a subject is made of, and
// these arms differ on exactly that -- 2048, 8192, 16384 -- so one subject cannot describe three of
// them. A sidecar row also left the raw arms independently importable, which is the whole failure
// this type exists to close: a consumer could read a per-token rate without ever touching a subject.
//
// SO THE SUBJECT IS A FIELD OF THE ARM, derived from that arm's own budget, and there is no way to
// hold one of these numbers without the profile it was measured against coming with it. That is the
// shape gunbc.spark.vllm_kv_layout_observe already uses for launches: VllmKvLayoutReceipt carries
// its `launch` in EVERY arm, including the failure arms, precisely so a reading cannot be lifted off
// the incarnation that produced it.
//
// THE ARM CARRIES EVERY AXIS IT KNOWS AND LEAVES ABSENT ONLY WHAT NOBODY READ, which is a
// correction to how this binding first worked. It used to answer a subject-less standing on the
// strength of the one axis it was missing, so a DeepSeek batch measurement read against a GLM
// decision came back "incomparable, subject unestablished" and never named the CHECKPOINT -- the
// very fence this module's header claims is now structural. Six axes are stated by this module and
// were being thrown away to represent one that is not. DESIGN section 4d's third arm is the one that
// bites here: under-asserting is not humility, and a fact you decline to state is a wall that does
// not exist.
//
// THE KV CACHE LAYOUT IS ABSENT, AND A FIRST VERSION OF THIS BINDING WROTE THE WRONG ONE. I put
// `KvFp8` here, which is not merely ungrounded -- it is FALSE for this route. `fp8_ds_mla` is the
// cache layout of DeepSeek's Multi-head Latent Attention, and extdeps.vllm.engine_args warns in its
// own annotation that recording the REQUESTED `fp8` spelling as the served format records the
// argument sent rather than the behaviour got. gunbc.spark.pair_serving_desired carries a paragraph
// about a previous edit making exactly this mistake on exactly this route. I repeated it.
//
// AND THE REPAIR IS STILL ABSENCE RATHER THAN THE CORRECT-LOOKING VALUE, because nothing in this
// module read the layout for these launches either. `KvFp8DsMla` would be the right answer for the
// route and would still be a guess about the measurement -- and a wrong axis value is worse than an
// absent one: a correct DeepSeek decision would have REFUSED transfer against these rows, or a
// `KvFp8` decision would have falsely agreed with them.
//
// THE CONTEXT CEILING IS ABSENT ON THE ARMS FOR THE SAME REASON. The module names a
// 1,048,576-token context MODEL, which is a fact about the checkpoint and not a reading of what
// max_model_len these four launches were started with.
//
// THE SCHEDULER'S SEQUENCE LIMIT IS ABSENT TOO, and a first version of this binding wrote 32 there
// because that is what the fleet generally runs. Nothing in this module read it for these launches,
// so it was a fabricated default on a MANDATORY axis -- which is worse than one on an optional axis,
// because two subjects that both guessed it would have silently AGREED on that axis and the join
// would have named one fewer difference than it should. The axis is optional now, and the existing
// `spark_host_max_num_seqs` row is deliberately not cited: it is a desired launch parameter, not a
// reading of these launches, and binding it would be the provenance overclaim
// gunbc.recurring_failure_mode.a_constructor_asserts_a_provenance_its_value_does_not_have files.
//
// SO THE DEGREE, THE RANK COUNT AND THE SEQUENCE LIMIT ARE ABSENT AND EVERYTHING ELSE IS PRESENT. The standing comes out
// Partial, the known axes fence, and the belief about the degree rides beside it as a bet rather
// than inside the subject as a fact. When the invocation is read, this one function changes and all
// three arms become Established together.
fn batch_arm_subject(budget: TokenCount) -> ServingPerformanceSubjectStanding {
  serving_subject_standing(
    subject: serving_performance_subject(
      checkpoint: DeepseekV4FlashIq3sSplit,
      checkpoint_revision: model_snapshot_revision(snapshot: deepseek_v4_flash_snapshot),
      runtime: GunbcSparkrunVllmDs4Gb10,
      runtime_image_reference: sparkrun_vllm_ds4_gb10_pinned_reference(),
      topology: Absent,
      rank_population: Absent,
      context_ceiling: Absent,
      max_num_batched_tokens: budget,
      max_num_seqs: Absent,
      kv_cache_dtype: Absent,
      speculative: Present { value: SpeculativeDecodingOff },
      collective_transport: Absent
    ),
    believed: join(["FourSparkTp4: the sweep ran on the group A head whose production topology is TP=4, and the 2048 arm's ~1.076 ms per computed token agrees to about 1% with tensor_parallel_comparison's TP=4 arm (1.0662) against its TP=2 arm (0.9838). Budget on this arm: ", to_string(token_count_value(t: budget))], "") as NonEmptyStr,
    would_settle: join(["read --tensor-parallel-size off the recorded systemd invocation ",
                        arm_launch_invocation(b: arm_2048_binding) as String,
                        " for the 2048 control arm (arm_2048_binding), which is the one arm whose invocation was captured"], "") as NonEmptyStr,
  )
}

// ── WHAT WAS AND WAS NOT CAPTURED ABOUT EACH ARM'S LAUNCH ─────────────────────────────────────
//
// The systemd invocation was re-read for the CONTROL arm and not for the other three, which is a
// defect in the acquisition and is recorded rather than repaired by inference. What every arm does
// carry is the budget read back from the engine's own banner and the KV pool it reported, which
// discriminate the four launches from each other; what they do not carry is a fleet-unique launch
// identity, so these rows may not be joined by identity to observations taken outside this sweep.
type ArmLaunchBinding
  = ArmLaunchInvocationRead { invocation: NonEmptyStr, budget_read_back: Nat }
  | ArmLaunchDiscriminatedByReadback { budget_read_back: Nat, missing: NonEmptyStr }

// THE INVOCATION, PROJECTED, so a consumer that needs to name it in a remedy reads it here instead
// of re-spelling the id. The arm that has no invocation says so rather than answering an empty
// string: a remedy that names a blank invocation would send a reader looking for a unit that has no
// identity recorded at all.
fn arm_launch_invocation(b: ArmLaunchBinding) -> NonEmptyStr {
  match b {
    ArmLaunchInvocationRead { invocation: i, budget_read_back: _ } => i
    ArmLaunchDiscriminatedByReadback { budget_read_back: _, missing: m } => m
  }
}

data arm_2048_binding: ArmLaunchBinding = ArmLaunchInvocationRead {
  invocation: "794afae389e44952a9049452c0619620" as NonEmptyStr,
  budget_read_back: 2048,
}

data arm_8192_binding: ArmLaunchBinding = ArmLaunchDiscriminatedByReadback {
  budget_read_back: 8192,
  missing: "the systemd invocation was not re-read for this arm; the banner readback and the KV pool distinguish it from the other three arms but do not identify it fleet-wide" as NonEmptyStr,
}

data arm_16384_binding: ArmLaunchBinding = ArmLaunchDiscriminatedByReadback {
  budget_read_back: 16384,
  missing: "the systemd invocation was not re-read for this arm; the banner readback and the KV pool distinguish it from the other three arms but do not identify it fleet-wide" as NonEmptyStr,
}

