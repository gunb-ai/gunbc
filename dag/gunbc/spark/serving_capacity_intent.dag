module gunbc.spark.serving_capacity_intent

import std.types { NonEmptyStr, List, Port }
import std.nat { Nat, nat_range_inclusive }
import std.measure { TokenCount, token_count, token_count_value, BasisPoint }
import extdeps.vllm.engine_args {
  VllmServedModelNames,
  VllmPrefixCachingRequest, VllmKvCacheDtypeRequest, VllmEngramConfigRequest, VllmModalityRequest,
  VllmSchedulerAdmissionRequest, FullInputAdmissionOmitted, FullInputAdmissionExplicit,
  KvWatermarkOmitted, KvWatermarkExplicit, vllm_scheduler_admission_omitted, IndexerKvDtypeOmitted, vllm_scheduler_admission_defect,
}
import gunbc.spark.serving_arm { ServingLaunchProfile, serving_launch_profile, ModelLaunchPolicy }
import v2.std.algebra { length }

// ── THE SERVICE OBLIGATION IS A SEAT POPULATION, NOT A POOL SIZE ────────────────────────────────
//
// WHAT NOT TO DECLARE. "54 GiB of KV" and "three concurrent sessions" are one requirement said
// twice, and once both are written down they drift: a change to the sequence budget moves the
// second and leaves the first standing, and nothing detects that the pair no longer describes one
// intent. Exactly one is declared -- the operational one, because it is the one anybody can argue
// about -- and the bytes are DERIVED from it against the engine's own resolved layout.
//
// THIS MODULE GENERALIZES gunbc.spark.pair_serving_capacity_floor, in the direction the import
// graph allows: the floor's MinimumColdSessions is the uniform case of what this type carries --
// one cold sequence budget per seat, with the seat count explicit -- and the floor module owns
// the projection forward (minimum_cold_sessions_intent there), because the floor already sits
// below the harness seat authority and importing it here would close a cycle through the serving
// enrollment chain. The native arm consumes THIS type: its KV demand is derived from the seat
// population over the group-aware layout (extdeps.vllm.kv_layout cold_admission_bytes per
// budget), its max_model_len derives from the LARGEST seat budget, and its required concurrency
// from the seat population. Sizing a serving arm is answering "what service is owed" first; the
// memory fit is then a verdict ABOUT that answer, not a tuning loop around it.
//
// COLD, meaning no prefix-cache credit. A prospective cache hit is not capacity: it belongs to a
// prefix whose blocks another request may release at any moment, and reserving against it would be
// spending a discount that has not been granted. Every seat is charged its full budget.
type ServingCapacityIntent {
  cold_sequence_budgets: List<TokenCount>
  max_batched_tokens: TokenCount
}

// THE MINT REFUSES WHAT WOULD READ AS A SERVICE WITH NO SEATS, because the derived envelope
// projections below are folds over the seat population and an empty population would derive
// max_active_sequences 0, max_total_resident_tokens 0 -- a plausible zero standing in for "nobody
// asked for anything", which is the absorbing fallback a fit proof must not take.
type ServingCapacityIntentAdmission
  = ServingCapacityIntentAdmitted { intent: ServingCapacityIntent }
  | ServingCapacityIntentRefused { cause: NonEmptyStr }

fn serving_capacity_intent(
  cold_sequence_budgets: List<TokenCount>,
  max_batched_tokens: TokenCount,
) -> ServingCapacityIntentAdmission {
  if length(cold_sequence_budgets) == 0 {
    ServingCapacityIntentRefused { cause: "a capacity intent with no cold sequence budgets names no service: there is no seat population to derive concurrency or resident tokens from" as NonEmptyStr }
  } else if token_count_value(t: max_batched_tokens) == 0 {
    ServingCapacityIntentRefused { cause: "a zero batched-token ceiling names no admission shape: the scheduler cannot run even one token through the batch" as NonEmptyStr }
  } else {
    ServingCapacityIntentAdmitted { intent: ServingCapacityIntent {
      cold_sequence_budgets: cold_sequence_budgets,
      max_batched_tokens: max_batched_tokens,
    } }
  }
}

// THE UNIFORM SEAT POPULATION IS THE FLOOR MODULE'S SHAPE, carried here so a floor row projects
// into the native vocabulary without a second derivation: n seats of one budget m is the compact
// envelope {max_single m, max_total n*m, seats n}.
fn uniform_cold_seats(
  each: TokenCount,
  seats: Nat,
  max_batched_tokens: TokenCount,
) -> ServingCapacityIntentAdmission {
  if seats == 0 {
    ServingCapacityIntentRefused { cause: "a zero-seat population names no service" as NonEmptyStr }
  } else {
    serving_capacity_intent(
      cold_sequence_budgets: map(nat_range_inclusive(lo: 1, hi: seats), _ => each),
      max_batched_tokens: max_batched_tokens)
  }
}

// ── THE ENVELOPE PROJECTIONS, DERIVED FROM THE SEAT POPULATION ──────────────────────────────────
//
// WHY THESE ARE FUNCTIONS AND NOT FIELDS: the compact envelope {max_single_sequence_tokens,
// max_total_resident_tokens, max_active_sequences, max_batched_tokens} is one population read three
// ways, and storing the projections beside the population would be two authorities for each -- a
// seat edit that failed to update the envelope would leave a row that disagrees with itself, which
// is precisely the drift this module exists to remove.
fn intent_max_active_sequences(i: ServingCapacityIntent) -> Nat {
  length(i.cold_sequence_budgets)
}

fn intent_max_single_sequence_tokens(i: ServingCapacityIntent) -> TokenCount {
  fold(i.cold_sequence_budgets, init: token_count(count: 0), f: (acc, b) =>
    if token_count_value(t: b) > token_count_value(t: acc) { b } else { acc })
}

fn intent_max_total_resident_tokens(i: ServingCapacityIntent) -> TokenCount {
  fold(i.cold_sequence_budgets, init: token_count(count: 0), f: (acc, b) =>
    token_count(count: token_count_value(t: acc) + token_count_value(t: b)))
}

fn intent_batched_tokens(i: ServingCapacityIntent) -> TokenCount {
  i.max_batched_tokens
}

// ── THE COLD GUARANTEE IS NOT THE SEQUENCE CEILING ──────────────────────────────────────────────
//
// THE DEFECT THIS SPLITS (review of gunbc#12787 at 98e055777b, 2026-10-02). One number meant three
// things: the cold seats the service GUARANTEES, the engine's --max-num-seqs, and the route's
// admission ceiling. Kept at the cold floor it rejects cheap warm continuations (live on group B
// 2026-10-02: eight running, two held on `capacity`, 97.2% prefix-cache hits, zero preemptions);
// raised, it asserts cold full-window seats nobody proved. So the intent above keeps its meaning --
// how many FULLY COLD sequences are owed -- and the scheduler's opportunity is a separate field
// bounded BELOW by it: cold seats <= hard_max_num_seqs, never equality by construction.
//
// A SEQUENCE ABOVE THE FLOOR IS BEST-EFFORT, ADMITTED BY THE ENGINE'S OWN KV GATE, AND MAY BE
// PREEMPTED (operator ruling 2026-10-02: "represent additional seats as best-effort with permitted
// preemption rather than as guaranteed cold capacity"). The cold floor stays priced exactly as
// before. Each further sequence enters only when the engine's allocator, after its own prefix-cache
// lookup, finds the whole current sequence fits (extdeps.vllm.engine_args
// VllmFullInputAdmissionRequest); if running turns later outgrow the pool, the engine preempts and
// recomputes, which is the admitted overflow behaviour for this class and is never a guarantee
// breach. So the mint REQUIRES the gate and the watermark STATED the moment the ceiling exceeds the
// floor -- an inherited default is a value nobody declared and nothing reads back -- while a zero
// watermark is admissible, because preemption is permitted rather than reserved against.
//
// THE CLASS IS DERIVED, NOT STORED: how many seats are best-effort is the ceiling minus the floor,
// so a separate field naming it would be a second authority that could disagree with both.
//
// AT THE FLOOR NOTHING CHANGES. envelope_at_cold_floor reproduces the launch every existing row
// renders -- ceiling equal to the seats, no scheduler flag -- so this split is behaviour-preserving
// until a row asks for more.
type SchedulerEnvelope sole_constructor {
  cold: ServingCapacityIntent
  hard_max_num_seqs: Nat
  admission: VllmSchedulerAdmissionRequest
}

type SchedulerEnvelopeAdmission
  = SchedulerEnvelopeAdmitted { envelope: SchedulerEnvelope }
  | SchedulerEnvelopeRefused { cause: NonEmptyStr }

fn scheduler_envelope(
  cold: ServingCapacityIntent,
  hard_max_num_seqs: Nat,
  admission: VllmSchedulerAdmissionRequest,
) -> SchedulerEnvelopeAdmission {
  let floor = intent_max_active_sequences(i: cold)
  match vllm_scheduler_admission_defect(r: admission) {
   Present { value: why } => SchedulerEnvelopeRefused { cause: why }
   Absent =>
  if hard_max_num_seqs < floor {
    SchedulerEnvelopeRefused { cause: join([
      "a sequence ceiling of ", to_string(hard_max_num_seqs), " is below the ", to_string(floor),
      " cold seats the service guarantees: the engine could not seat its own floor",
    ], "") as NonEmptyStr }
  } else if hard_max_num_seqs == floor {
    SchedulerEnvelopeAdmitted { envelope: SchedulerEnvelope { cold: cold, hard_max_num_seqs: hard_max_num_seqs, admission: admission } }
  } else {
    match above_floor_admission_defect(admission: admission) {
      Present { value: why } => SchedulerEnvelopeRefused { cause: join([
        "a sequence ceiling of ", to_string(hard_max_num_seqs), " exceeds the ", to_string(floor),
        " cold seats, so the seats above the floor are best-effort and admitted only by the engine's KV gate, and ", why as String,
      ], "") as NonEmptyStr }
      Absent => SchedulerEnvelopeAdmitted { envelope: SchedulerEnvelope { cold: cold, hard_max_num_seqs: hard_max_num_seqs, admission: admission } }
    }
  }
  }
}

fn above_floor_admission_defect(admission: VllmSchedulerAdmissionRequest) -> NonEmptyStr? {
  match admission.full_input_admission {
    FullInputAdmissionOmitted =>
      Present { value: "full-input admission is not stated: the gate must be requested explicitly, never inherited" as NonEmptyStr }
    FullInputAdmissionExplicit { enabled: e } =>
      if !e {
        Present { value: "full-input admission is requested OFF, so the engine would check only the first chunk and could over-admit" as NonEmptyStr }
      } else {
        match admission.kv_watermark {
          KvWatermarkOmitted =>
            Present { value: "the KV watermark is not stated: zero is admissible under permitted preemption, but it must be declared, never inherited" as NonEmptyStr }
          KvWatermarkExplicit { fraction: _ } => none
        }
      }
  }
}

// THE FLOOR ENVELOPE: the shape every launch had before this split, stated as one. It is the SECOND mint of
// the sealed type, on purpose and total: at the floor (ceiling == cold seats, admission omitted) there is no
// gate to state, so scheduler_envelope's refusals cannot fire and a fallible mint would only add a dead arm.
// Every ceiling ABOVE the floor goes through scheduler_envelope, whose production consumer is the Group A
// seat staircase (gunbc.spark.glm53_arm_staircase, deforking cut 8a, #13040) -- a declared frontier whose
// trigger is that PR landing; this change keeps every production launch at the floor.
fn envelope_at_cold_floor(cold: ServingCapacityIntent) -> SchedulerEnvelope {
  SchedulerEnvelope {
    cold: cold,
    hard_max_num_seqs: intent_max_active_sequences(i: cold),
    admission: vllm_scheduler_admission_omitted,
  }
}

fn envelope_cold(e: SchedulerEnvelope) -> ServingCapacityIntent { e.cold }
fn envelope_hard_max_num_seqs(e: SchedulerEnvelope) -> Nat { e.hard_max_num_seqs }
fn envelope_admission(e: SchedulerEnvelope) -> VllmSchedulerAdmissionRequest { e.admission }

// THE TWO SERVICE CLASSES A CEILING CARRIES, derived: the guaranteed cold seats, and the best-effort
// seats above them whose overflow behaviour is preemption.
fn envelope_guaranteed_cold_seats(e: SchedulerEnvelope) -> Nat {
  intent_max_active_sequences(i: e.cold)
}

fn envelope_best_effort_seats(e: SchedulerEnvelope) -> Nat {
  e.hard_max_num_seqs - intent_max_active_sequences(i: e.cold)
}

fn envelope_above_floor(e: SchedulerEnvelope) -> Bool {
  envelope_best_effort_seats(e: e) > 0
}

// ── THE EXECUTABLE PROFILE IS DERIVED FROM THE ENVELOPE, NOT CHOSEN BESIDE IT ───────────────────
//
// THE REVIEW BLOCKER THIS CLOSES: a proof subject that carries an intent and a profile as two
// independent fields prices whatever workload a witness happens to put next to whatever profile
// it happens to hold -- the 4-seat x 64K FitProved row was proving a small service beside a
// sixteen-sequence 262K executable. THE ENGINE CONFIG THE PROOF PRICES AND THE ENGINE CONFIG THE
// LAUNCH RENDERS ARE ONE VALUE, derived here: max_model_len is the largest cold seat budget,
// max_num_seqs is the envelope's ceiling (equal to the cold seats at the floor envelope), and the
// batched ceiling is the cold intent's own. What the envelope does not decide --
// utilization, KV dtype, port, alias, prefix caching, Engram -- arrives as launch policy from the caller,
// and gunbc.spark.arm_memory_fit's subject mint REQUIRES the join: a subject assembled with a
// profile that is not the intent's derivation is refused at construction, so profile-and-intent
// disagreement is unwritable, not merely detectable after the fact.
//
// THE PROFILE CARRIES BOTH SERVICE CLASSES: max_num_seqs is the ceiling, guaranteed_cold_seqs the
// floor, and scheduler_admission the gate the seats between them depend on -- rendered into the argv
// by gunbc.spark.serving_arm_launch. READ BACK IS A DECLARED FRONTIER here: its consumer is the relaunch
// transaction's admission-controls axis (gunbc.spark.serving_relaunch_transaction, through
// extdeps.vllm.engine_args vllm_argv_scheduler_admission), which lands in deforking cut 7 (#12986); that
// landing is the trigger, and until it does no production path compares plan and container on these fields.
fn profile_for_envelope(
  envelope: SchedulerEnvelope,
  policy: ModelLaunchPolicy,
  decided_gpu_memory_basis_points: BasisPoint,
  serve_port: Port,
  served_names: VllmServedModelNames,
  prefix_caching: VllmPrefixCachingRequest,
) -> ServingLaunchProfile {
  serving_launch_profile(
    policy: policy,
    max_model_len: intent_max_single_sequence_tokens(i: envelope.cold),
    max_num_batched_tokens: envelope.cold.max_batched_tokens,
    max_num_seqs: envelope.hard_max_num_seqs,
    guaranteed_cold_seqs: intent_max_active_sequences(i: envelope.cold),
    decided_gpu_memory_basis_points: decided_gpu_memory_basis_points,
    serve_port: serve_port,
    served_names: served_names,
    prefix_caching: prefix_caching,
    scheduler_admission: envelope.admission,
  )
}

// ── THE WORKLOAD A LAUNCH PROFILE OWES, DERIVED THE SAME WAY ────────────────────────────────────
//
// THE COLD FLOOR IS PRICED AT THE FULL WINDOW; THE SEATS ABOVE IT ARE NOT. The launch wall charges
// every GUARANTEED sequence its full model length, cold -- the largest workload the guarantee can be
// asked for. Before the envelope split that was every admitted sequence, because the two counts were
// one field. The best-effort seats above the floor are admitted by the engine's own full-input KV
// gate on their actual incremental demand and may be preempted, so pricing them cold would refuse
// exactly the warm concurrency they exist for; what keeps them honest instead is that the profile
// must state the gate (the same law scheduler_envelope enforces, re-checked here because a profile
// can reach this wall without passing through an envelope). What a larger CEILING does to static
// memory -- graph capture, per-request state -- is not priced here at all: the memory-fit subject
// binds max_num_seqs into its workload identity, so a receipt measured at another ceiling never
// discharges a term at this one.
fn intent_for_launch_profile(p: ServingLaunchProfile) -> ServingCapacityIntentAdmission {
  if p.max_num_seqs == 0 {
    ServingCapacityIntentRefused { cause: "a launch profile admitting zero sequences derives no seat population: --max-num-seqs 0 is a launch that serves nothing" as NonEmptyStr }
  } else if p.guaranteed_cold_seqs > p.max_num_seqs {
    ServingCapacityIntentRefused { cause: join([
      "the profile guarantees ", to_string(p.guaranteed_cold_seqs), " cold sequences under a ceiling of ",
      to_string(p.max_num_seqs), ": the engine could not seat its own floor",
    ], "") as NonEmptyStr }
  } else if p.guaranteed_cold_seqs == 0 {
    ServingCapacityIntentRefused { cause: "a launch profile guaranteeing zero cold sequences names no service floor: every sequence would be best-effort and nothing would be priced" as NonEmptyStr }
  } else if p.guaranteed_cold_seqs < p.max_num_seqs {
    match above_floor_admission_defect(admission: p.scheduler_admission) {
      Present { value: why } => ServingCapacityIntentRefused { cause: join([
        "the profile's ceiling of ", to_string(p.max_num_seqs), " exceeds its ", to_string(p.guaranteed_cold_seqs),
        " guaranteed cold sequences, so the seats above the floor are best-effort and admitted only by the engine's KV gate, and ", why as String,
      ], "") as NonEmptyStr }
      Absent => serving_capacity_intent(
        cold_sequence_budgets: map(nat_range_inclusive(lo: 1, hi: p.guaranteed_cold_seqs), _ => p.max_model_len),
        max_batched_tokens: p.max_num_batched_tokens)
    }
  } else {
    serving_capacity_intent(
      cold_sequence_budgets: map(nat_range_inclusive(lo: 1, hi: p.guaranteed_cold_seqs), _ => p.max_model_len),
      max_batched_tokens: p.max_num_batched_tokens)
  }
}

// THE PROFILE MUST COVER THE SEATS IT SERVES, AND THE SEAT BUDGET MUST FIT THE PROFILE'S WINDOW.
// This is the explicit-policy check the concurrent profile row anticipated: a profile whose
// max_num_seqs is below the seat population cannot seat the service however much memory it has,
// and a seat whose budget exceeds max_model_len is a seat the engine cannot admit at full length.
type IntentProfileCoverage
  = IntentCoversProfile
  | IntentExceedsProfile { cause: NonEmptyStr }

fn intent_covers_profile(i: ServingCapacityIntent, p: ServingLaunchProfile) -> IntentProfileCoverage {
  if intent_max_active_sequences(i: i) > p.max_num_seqs {
    IntentExceedsProfile {
      cause: join([
        "the service owes ", to_string(intent_max_active_sequences(i: i)),
        " cold seats but the profile admits only ", to_string(p.max_num_seqs),
        " sequences: max_num_seqs is the admission cap and the seat population exceeds it",
      ], "") as NonEmptyStr,
    }
  } else if token_count_value(t: intent_max_single_sequence_tokens(i: i)) > token_count_value(t: p.max_model_len) {
    IntentExceedsProfile {
      cause: join([
        "the largest seat budget is ", to_string(token_count_value(t: intent_max_single_sequence_tokens(i: i))),
        " tokens against a profile whose max_model_len is ", to_string(token_count_value(t: p.max_model_len)),
        ": the engine cannot admit that seat at full length",
      ], "") as NonEmptyStr,
    }
  } else {
    IntentCoversProfile
  }
}
