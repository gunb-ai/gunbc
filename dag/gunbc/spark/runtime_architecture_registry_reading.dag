module gunbc.spark.runtime_architecture_registry_reading

import std.types { String, Bool, List, NonEmptyStr }
import extdeps.deepseek.deepseek_v4_1_flash { deepseek_v4_1_flash_architecture_class }

// WHICH ARCHITECTURES AN IMAGE ANSWERS FOR IS SOMETHING WE READ, NOT SOMETHING ITS PUBLISHER SAYS.
//
// The distinction is the whole reason this module exists rather than a field on the image rows.
// extdeps.docker.images.* carries what the publisher declares -- repository, digest, tag, the version
// the image reports about itself. The architecture registry is not in that set: nobody published it.
// It is the answer a call returned on a particular host, on a particular day, through a particular
// instrument, and if any of those three had been different the answer could have been too.
//
// AN EARLIER REVISION OF THIS CHANGE PUT THE LISTS IN THE IMAGE MODULES and it read as though the
// vendor had shipped them. That is the layer inversion DESIGN section 3 names directly: observations
// this repository produces are receipts in the observing layer, never facts backfilled onto the
// observed upstream. Keyed by digest, a reading can also be superseded by a later reading of the
// same digest without editing anything the publisher owns.
//
// THE OBSERVED DIGEST IS FROZEN INTO THE READING, AND THAT IS THE DIFFERENCE BETWEEN A RECEIPT AND A
// POINTER. An earlier revision of this module took each reading's image_reference from the image
// module's `*_pinned_reference()`, which reads as tidy -- one digest, one home -- and is wrong for a
// receipt: repinning the image module would have silently re-addressed every past reading to a digest
// nobody ran anything inside. The subject of an observation is whatever was observed, permanently,
// and a later desire to run something else does not reach back and change what was seen.
//
// THE DESIRED PIN IS STILL ONE FACT WITH ONE HOME -- it just is not this one. extdeps.docker.images
// owns what the fleet intends to run; this module owns what was read and when. They are joined at
// the point of use by `reading_applies_to`, and a repin makes that join FAIL rather than quietly
// succeed, which is the only behaviour that forces a new probe instead of inheriting an old answer.
//
// THE INSTRUMENT IS PART OF THE READING because it is what a re-reader has to repeat, and because
// two frameworks answer this question through different calls -- vLLM through its ModelRegistry,
// SGLang through its own -- so a reading that named only the answer would hide which question was
// asked.
type ArchitectureRegistryReading {
  image_reference: NonEmptyStr
  host: NonEmptyStr
  observed_at: NonEmptyStr
  instrument: NonEmptyStr
  architectures: List<NonEmptyStr>
}

// A READING APPLIES TO A DESIRED IMAGE ONLY IF IT WAS TAKEN INSIDE THAT EXACT DIGEST. There is no
// near-match arm and no repository-level fallback: two digests of one repository are two different
// images, and the whole reason this fleet pins by digest is that they answer differently.
fn reading_applies_to(r: ArchitectureRegistryReading, desired_reference: NonEmptyStr) -> Bool {
  let observed = r.image_reference as String
  let desired = desired_reference as String
  observed == desired
}

fn registry_reading_contains(r: ArchitectureRegistryReading, architecture: NonEmptyStr) -> Bool {
  fold(r.architectures, init: false, f: (acc, a) =>
    if acc { true } else { a as String == architecture as String })
}

// THE READING FOR ONE IMAGE, OR NOTHING. `none` is not "this image registers nothing": it is "no
// reading of this digest exists here", and a consumer that folded those together would turn an
// unasked question into a measured negative.
fn registry_reading_for(readings: List<ArchitectureRegistryReading>, image_reference: NonEmptyStr) -> ArchitectureRegistryReading? {
  fold(readings, init: none, f: (acc, r) =>
    if reading_applies_to(r: r, desired_reference: image_reference) { Present { value: r } } else { acc })
}

// ONE OBSERVATION, TWO COVERAGES. A get_supported_archs() dump and a single asked architecture are
// the same fact with different coverage. Two peer records made the second roster missable.
// registry_reading_contains remains dump-only: a miss on a dump is a measured negative.
type ArchitectureObservation
  = RegistryDump { reading: ArchitectureRegistryReading }
  | ArchitectureAsked {
      image_reference: NonEmptyStr
      host: NonEmptyStr
      observed_at: NonEmptyStr
      instrument: NonEmptyStr
      architecture: NonEmptyStr
      present: Bool
    }

fn architecture_observation_image_reference(o: ArchitectureObservation) -> NonEmptyStr {
  match o {
    RegistryDump { reading: r } => r.image_reference
    ArchitectureAsked {
      image_reference: r,
      host: _,
      observed_at: _,
      instrument: _,
      architecture: _,
      present: _,
    } => r
  }
}

fn architecture_observation_applies_to(o: ArchitectureObservation, desired_reference: NonEmptyStr) -> Bool {
  (architecture_observation_image_reference(o: o) as String) == (desired_reference as String)
}

fn architecture_observation_for(observations: List<ArchitectureObservation>, image_reference: NonEmptyStr) -> ArchitectureObservation? {
  fold(observations, init: none, f: (acc, o) =>
    if architecture_observation_applies_to(o: o, desired_reference: image_reference) { Present { value: o } } else { acc })
}

data vllm_registry_instrument: NonEmptyStr = "python3 -c: vllm.model_executor.models.registry.ModelRegistry.get_supported_archs(), executed by `docker run --gpus all` against the pinned digest" as NonEmptyStr
data sglang_registry_instrument: NonEmptyStr = "python3 -c: sglang.srt.models.registry.ModelRegistry keys, executed by `docker run --gpus all` against the pinned digest" as NonEmptyStr

data spark_a3ee_host: NonEmptyStr = "spark-a3ee (NVIDIA GB10, torch.cuda.get_device_capability(0) = (12, 1))" as NonEmptyStr
data srv9_gb10_host: NonEmptyStr = "srv9 (NVIDIA GB10, torch.cuda.get_device_capability(0) = (12, 1))" as NonEmptyStr


