module gunbc.spark.arm_convergence

import std.types { String, Bool, List, NonEmptyStr, Int }
import std.algebra { trim }
import v2.std.optional { Present, Absent }
import v2.std.algebra { zip_map }
import product.host_identity { HostIdentity }
import extdeps.exec.command { shell_quote }
import std.goal_assessment {
  GoalAssessment, GoalSatisfied, GoalDiverged, GoalIndeterminate, GoalAssessmentRefused,
  assess_by_deviations_and_unknowns,
}
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }

// ── ARM RECOVERY AS CONVERGENCE (docs/plans/arm-convergence-recovery-design.md) ───────────────
//
// WHAT THIS REPLACES. The native arm transaction used to keep per-host files beside each unit -- a
// fence, an incumbent backup, a had-no-unit marker, an unresolved-rollback marker -- and recovered by
// classifying those files against a hand-enumerated list of leftover kinds, refusing anything off the
// list. The kinds multiplied as hosts x stages x failure points, and on 2026-10-05 (fleet-converge run
// 37254736596) a state on no list -- three ranks rolled back and running, the head fence-only and
// stopped -- held Group A down until a human started it. The files were standing in for an
// OBSERVATION OF THE ARM, so this module observes the arm instead.
//
// THE LOOP. Observe every rank; assess against a desired arm (std.goal_assessment, remedy-free);
// decide (std.upsert_decision): satisfied is Noop, anything unknown is Refuse, any deviation is Apply
// with ONE plan shape -- the whole arm, stopped and started again head first. A mixed arm is just
// GoalDiverged, so no leftover kind exists to enumerate. Launch, rollback and recovery are the same
// loop with a different desired arm (the requested step, or the last committed arm).
//
// THE LESSON THE PLAN SHAPE ENCODES (valiant-crab-775, 2026-10-05): starting only the head at 03:27Z
// timed out at the rendezvous with 1 of 4 ranks joined, because the workers had failed at 02:48Z; the
// arm came back only when all four were started together. A per-host repair is wrong, so
// ArmConvergeApply carries the arm's whole desired roster and nothing that could name a subset.
//
// WRITERS ARE SERIALIZED BY THE JOB'S CONCURRENCY GROUP, keyed per arm group
// (gunbc.fleet_converge_workflow), not by any file here. Hand actuation is unserialized; it is
// caught only by the next observation, as a deviation or an unknown.

// ── ONE RANK OF THE DESIRED ARM ───────────────────────────────────────────────────────────────
type ArmRankDesired {
  host: HostIdentity
  unit_name: NonEmptyStr
  container_name: NonEmptyStr
  is_head: Bool
}

// ── THE COMMITTED-ARM RECORD ─────────────────────────────────────────────────────────────────
//
// Written on every rank by a commit and by nothing else: the committed step's label and the sha256
// of the unit file that rank was committed with. It replaces the per-host incumbent backups, and it
// is the only file recovery reads. A rollback re-renders the recorded step and refuses unless the
// re-render reproduces every recorded hash: a desired arm that cannot be reproduced is guessed, not
// desired.
data arm_committed_record_dir: String = "/var/lib/gunbc/arm-committed"

fn arm_committed_record_path(unit_name: NonEmptyStr) -> String {
  join([arm_committed_record_dir, "/", unit_name as String], "")
}

fn arm_unit_path(unit_name: NonEmptyStr) -> String {
  join(["/etc/systemd/system/", unit_name as String], "")
}

// THE FILES THE RETIRED LEFTOVER CLASSIFIER KEPT. Nothing reads them; the converge's stop step deletes
// them as one declared migration step, so a host still carrying them is reported, never consulted.
// Dissolution: delete this row and its removal once an observe of every arm host reads none.
data arm_retired_transaction_suffixes: List<String> = [".gunbc-transaction", ".gunbc-incumbent", ".gunbc-had-no-unit", ".gunbc-unresolved-rollback"]

// ── ONE FACT, READ THREE WAYS ─────────────────────────────────────────────────────────────────
//
// An established absence is a fact inside the observation, and an unread field is not an absence:
// collapsing the two would let a failed read pass for "no container", which is exactly how a stale
// rank would be read as stopped.
type ArmFact
  = FactRead { value: String }
  | FactAbsent
  | FactUnread { cause: String }

type ArmRankObserved {
  host: HostIdentity
  desired_unit_sha: ArmFact
  unit_sha: ArmFact
  active_state: ArmFact
  container: ArmFact
  committed: ArmFact
  retired_files: List<String>
}

type ArmRankObservation
  = ArmRankRead { observed: ArmRankObserved }
  | ArmRankUnread { host: HostIdentity, cause: String }

data arm_observe_complete_word: String = "arm-observe-complete"
data arm_fact_unread_prefix: String = "unread:"
data arm_retired_file_key: String = "retired_file="
data arm_observe_error_path: String = "/run/gunbc-arm-observe.err"

// ── THE PER-RANK OBSERVATION LEG ──────────────────────────────────────────────────────────────
//
// feature:remote-shell-body-emission — dissolve-on: the bounded remote operation sequence capability
// stated once above gunbc.spark.native_serving_apply spark_native_host_apply_script (an ordered list of
// typed steps against one host, each a modeled operation, so a script body becomes a projection of that
// sequence). This leg is the same class of string-assembled body as that module's stage scripts and is
// covered by that marker and that trigger, not admitted by its own; restating the condition here would
// be a second authority for it. Until it dissolves, every word the parser keys on is a named datum below
// (the key prefixes, the unread prefix, the completion word), so a script and its parser cannot drift
// on a spelling or an offset.
//
// It only reads. Each fact prints as key=value, key=absent, or key=unread:<cause>, and the leg ends
// with a completion word, so a leg cut off part way through reads as unread rather than as a host
// missing its later facts. The planned unit's hash is computed ON THE HOST with the same sha256sum
// that hashes the installed file, so the two are compared as like with like.
fn arm_rank_observe_script(unit_name: NonEmptyStr, container_name: NonEmptyStr, planned_unit_text: String) -> String {
  let u = arm_unit_path(unit_name: unit_name)
  let r = arm_committed_record_path(unit_name: unit_name)
  let ctr = shell_quote(arg: container_name as String)
  join([
    "echo \"desired_unit_sha=$(printf '%s' ", shell_quote(arg: planned_unit_text), " | sha256sum | cut -c1-64)\"\n",
    "if [ -f ", u, " ]; then if s=$(sha256sum < ", u, " | cut -c1-64) && [ -n \"$s\" ]; then echo \"unit_sha=$s\"; else echo 'unit_sha=", arm_fact_unread_prefix, "sha256sum of the unit file failed'; fi\n",
    "elif [ -e ", u, " ]; then echo 'unit_sha=", arm_fact_unread_prefix, "the unit path is not a regular file'\n",
    "else echo unit_sha=absent; fi\n",
    "if a=$(systemctl show -p ActiveState --value ", unit_name as String, " 2>&1); then echo \"active_state=$a\"; else echo \"active_state=", arm_fact_unread_prefix, "$(printf '%s' \"$a\" | tr '\\n' ' ' | cut -c1-200)\"; fi\n",
    "if c=$(docker container inspect --format '\{\{.Id}} \{\{.State.Running}} \{\{.RestartCount}}' ", ctr, " 2>", arm_observe_error_path, "); then echo \"container=$c\"\n",
    "elif grep -q 'No such container' ", arm_observe_error_path, "; then echo container=absent\n",
    "else echo \"container=", arm_fact_unread_prefix, "$(tr '\\n' ' ' < ", arm_observe_error_path, " | cut -c1-200)\"; fi\n",
    "if [ -f ", r, " ]; then echo \"committed=$(head -c 300 ", r, " | tr '\\n' ' ')\"\n",
    "elif [ -e ", r, " ]; then echo 'committed=", arm_fact_unread_prefix, "the record path is not a regular file'\n",
    "else echo committed=absent; fi\n",
    join(map(arm_retired_transaction_suffixes, sfx => join(["if [ -e ", u, sfx, " ]; then echo ", arm_retired_file_key, u, sfx, "; fi\n"], "")), ""),
    "echo ", arm_observe_complete_word, "\n",
  ], "")
}

fn arm_line_value(lines: List<String>, key: String) -> String? {
  first(flat_map(lines, l => if starts_with(s: l, prefix: join([key, "="], "")) { [trim(s: substring(s: l, start: length(key) + 1, end: length(l)))] } else { [] as List<String> }))
}

fn arm_fact_of(lines: List<String>, key: String) -> ArmFact {
  match arm_line_value(lines: lines, key: key) {
    Absent => FactUnread { cause: join(["the observation printed no ", key, " line"], "") }
    Present { value: v } =>
      if v == "absent" { FactAbsent }
      else if starts_with(s: v, prefix: arm_fact_unread_prefix) { FactUnread { cause: substring(s: v, start: length(arm_fact_unread_prefix), end: length(v)) } }
      else if v == "" { FactUnread { cause: join(["the observation printed an empty ", key], "") } }
      else { FactRead { value: v } }
  }
}

fn arm_rank_observation_of(host: HostIdentity, stdout: String) -> ArmRankObservation {
  let lines = map(split(s: stdout, delimiter: "\n"), l => trim(s: l))
  if !any(lines, l => l == arm_observe_complete_word) {
    ArmRankUnread { host: host, cause: "the observation leg did not print its completion word, so its facts are not a whole reading" }
  } else {
    ArmRankRead { observed: ArmRankObserved {
      host: host,
      desired_unit_sha: arm_fact_of(lines: lines, key: "desired_unit_sha"),
      unit_sha: arm_fact_of(lines: lines, key: "unit_sha"),
      active_state: arm_fact_of(lines: lines, key: "active_state"),
      container: arm_fact_of(lines: lines, key: "container"),
      committed: arm_fact_of(lines: lines, key: "committed"),
      retired_files: flat_map(lines, l => if starts_with(s: l, prefix: arm_retired_file_key) { [substring(s: l, start: length(arm_retired_file_key), end: length(l))] } else { [] as List<String> }),
    } }
  }
}

// ── THE ASSESSMENT ────────────────────────────────────────────────────────────────────────────
type ArmRankDeviation
  = RankUnitAbsent { host: HostIdentity }
  | RankUnitDiffers { host: HostIdentity }
  | RankUnitInactive { host: HostIdentity, state: String }
  | RankContainerAbsent { host: HostIdentity }
  | RankContainerNotRunning { host: HostIdentity, reading: String }
  | RankContainerRestarted { host: HostIdentity, reading: String }
  | RankNotVerified { host: HostIdentity, cause: String }
  | RankRetiredFilesPresent { host: HostIdentity, files: List<String> }

type ArmRankUnknown
  = RankFactUnread { host: HostIdentity, fact: NonEmptyStr, cause: String }
  | RankObservationUnread { host: HostIdentity, cause: String }

type ArmAssessRefusal
  = ArmRosterMismatch { desired: List<String>, observed: List<String> }

// The evidence a satisfied arm carries: the ranks it was read on. Structural satisfaction is not the
// whole goal -- the readback still owes the realized container, the transport and the front door -- so
// the transaction runs that readback before treating a structurally satisfied arm as satisfied.
type ArmRealizedRanks {
  hosts: List<HostIdentity>
}

fn arm_fact_unknowns(host: HostIdentity, fact: NonEmptyStr, f: ArmFact) -> List<ArmRankUnknown> {
  match f {
    FactUnread { cause: c } => [RankFactUnread { host: host, fact: fact, cause: c }]
    FactRead { value: _ } => [] as List<ArmRankUnknown>
    FactAbsent => [] as List<ArmRankUnknown>
  }
}

fn arm_rank_unknowns(o: ArmRankObservation) -> List<ArmRankUnknown> {
  match o {
    ArmRankUnread { host: h, cause: c } => [RankObservationUnread { host: h, cause: c }]
    ArmRankRead { observed: r } => concat(concat(concat(concat(
      arm_fact_unknowns(host: r.host, fact: "planned unit hash" as NonEmptyStr, f: r.desired_unit_sha),
      arm_fact_unknowns(host: r.host, fact: "unit file hash" as NonEmptyStr, f: r.unit_sha)),
      arm_fact_unknowns(host: r.host, fact: "unit active state" as NonEmptyStr, f: r.active_state)),
      arm_fact_unknowns(host: r.host, fact: "container" as NonEmptyStr, f: r.container)),
      [] as List<ArmRankUnknown>)
  }
}

fn arm_unit_deviations(r: ArmRankObserved) -> List<ArmRankDeviation> {
  match r.unit_sha {
    FactAbsent => [RankUnitAbsent { host: r.host }]
    FactUnread { cause: _ } => [] as List<ArmRankDeviation>
    FactRead { value: have } =>
      match r.desired_unit_sha {
        FactRead { value: want } => if have == want { [] as List<ArmRankDeviation> } else { [RankUnitDiffers { host: r.host }] }
        FactAbsent => [] as List<ArmRankDeviation>
        FactUnread { cause: _ } => [] as List<ArmRankDeviation>
      }
  }
}

fn arm_active_deviations(r: ArmRankObserved) -> List<ArmRankDeviation> {
  match r.active_state {
    FactRead { value: s } => if s == "active" { [] as List<ArmRankDeviation> } else { [RankUnitInactive { host: r.host, state: s }] }
    FactAbsent => [RankUnitInactive { host: r.host, state: "absent" }]
    FactUnread { cause: _ } => [] as List<ArmRankDeviation>
  }
}

// The container reads as "<id> <running> <restart count>". Running and never restarted is the only
// reading that can be this unit's one start; anything else is a deviation the whole-arm plan repairs.
fn arm_container_deviations(r: ArmRankObserved) -> List<ArmRankDeviation> {
  match r.container {
    FactAbsent => [RankContainerAbsent { host: r.host }]
    FactUnread { cause: _ } => [] as List<ArmRankDeviation>
    FactRead { value: v } => {
      let words = filter(split(s: v, delimiter: " "), w => w != "")
      if count(words) != 3 { [RankContainerNotRunning { host: r.host, reading: v }] }
      else {
        match words.get(1) {
          Absent => [RankContainerNotRunning { host: r.host, reading: v }]
          Present { value: running } =>
            if running != "true" { [RankContainerNotRunning { host: r.host, reading: v }] }
            else {
              match words.get(2) {
                Absent => [RankContainerNotRunning { host: r.host, reading: v }]
                Present { value: restarts } => if restarts == "0" { [] as List<ArmRankDeviation> } else { [RankContainerRestarted { host: r.host, reading: v }] }
              }
            }
        }
      }
    }
  }
}

fn arm_rank_deviations(o: ArmRankObservation) -> List<ArmRankDeviation> {
  match o {
    ArmRankUnread { host: _, cause: _ } => [] as List<ArmRankDeviation>
    ArmRankRead { observed: r } => concat(concat(concat(arm_unit_deviations(r: r), arm_active_deviations(r: r)), arm_container_deviations(r: r)),
      if count(r.retired_files) > 0 { [RankRetiredFilesPresent { host: r.host, files: r.retired_files }] } else { [] as List<ArmRankDeviation> })
  }
}

fn arm_observation_host(o: ArmRankObservation) -> HostIdentity {
  match o {
    ArmRankUnread { host: h, cause: _ } => h
    ArmRankRead { observed: r } => r.host
  }
}

// THE ROSTER IS AN IDENTITY JOIN, NOT A COUNT: every desired rank must have exactly one observation
// on its own host, in the desired order, or the comparison is not well formed and is refused.
fn arm_roster_agrees(desired: List<ArmRankDesired>, observed: List<ArmRankObservation>) -> Bool {
  count(desired) == count(observed) && count(desired) > 0
    && all(zip_map(a: desired, b: observed, f: fn(d, o) { (d.host as String) == (arm_observation_host(o: o) as String) }), x => x)
}

fn arm_structural_assessment(desired: List<ArmRankDesired>, observed: List<ArmRankObservation>) -> GoalAssessment<ArmRealizedRanks, ArmRankDeviation, ArmRankUnknown, ArmAssessRefusal> {
  if !arm_roster_agrees(desired: desired, observed: observed) {
    GoalAssessmentRefused { cause: ArmRosterMismatch {
      desired: map(desired, d => d.host as String),
      observed: map(observed, o => arm_observation_host(o: o) as String),
    } }
  } else {
    assess_by_deviations_and_unknowns(
      evidence: ArmRealizedRanks { hosts: map(desired, d => d.host) },
      deviations: flat_map(observed, o => arm_rank_deviations(o: o)),
      unknowns: flat_map(observed, o => arm_rank_unknowns(o: o)),
    )
  }
}

// THE READBACK REFINES A STRUCTURALLY SATISFIED ARM. A rank whose readback refused is a deviation, so
// an arm whose units and containers look right but whose ranks are not one verified epoch is
// GoalDiverged, and the plan restarts it whole.
type ArmRankReadbackRefusal {
  host: HostIdentity
  cause: String
}

fn arm_assessment_after_readback(
  structural: GoalAssessment<ArmRealizedRanks, ArmRankDeviation, ArmRankUnknown, ArmAssessRefusal>,
  refusals: List<ArmRankReadbackRefusal>,
) -> GoalAssessment<ArmRealizedRanks, ArmRankDeviation, ArmRankUnknown, ArmAssessRefusal> {
  match structural {
    GoalSatisfied { evidence: e } =>
      assess_by_deviations_and_unknowns(evidence: e, deviations: map(refusals, r => RankNotVerified { host: r.host, cause: r.cause }), unknowns: [] as List<ArmRankUnknown>)
    GoalDiverged { deviations: d } => GoalDiverged { deviations: d }
    GoalIndeterminate { known_deviations: k, unknowns: u } => GoalIndeterminate { known_deviations: k, unknowns: u }
    GoalAssessmentRefused { cause: c } => GoalAssessmentRefused { cause: c }
  }
}

// ── THE DECISION: THE SMALLEST ACTION SET PER DIVERGED COMPONENT ─────────────────────────────
//
// THE DESIRED ARM HAS COMPONENTS, AND EACH HAS ITS OWN REMEDY (valiant-crab-775, 2026-10-05). A rank's
// unit, its active state, its container and its verified epoch are one component -- the serving arm --
// and its only remedy is the WHOLE arm stopped and started again head first. The absence of the retired
// transaction files is another component, and its remedy is to remove them: no stop, no restart. A
// planner that knew only the first remedy would turn every non-unit divergence into a restart or a
// special case, so the plan carries one action per diverged component and nothing more.
//
// THE RESTART STILL HAS NO SUBSET. ArmRestart is the whole desired roster or nothing, and its sole
// constructor is the decision below -- so "start only the head" has no spelling. A whole-arm restart
// also removes the retired files (the stop step does), so the removals ride along with it.
fn arm_deviation_needs_restart(d: ArmRankDeviation) -> Bool {
  match d {
    RankRetiredFilesPresent { host: _, files: _ } => false
    RankUnitAbsent { host: _ } => true
    RankUnitDiffers { host: _ } => true
    RankUnitInactive { host: _, state: _ } => true
    RankContainerAbsent { host: _ } => true
    RankContainerNotRunning { host: _, reading: _ } => true
    RankContainerRestarted { host: _, reading: _ } => true
    RankNotVerified { host: _, cause: _ } => true
  }
}

type ArmRestart sole_constructor
  = ArmRestartWhole { ranks: List<ArmRankDesired> }
  | ArmNoRestart

type ArmRetiredRemoval {
  host: HostIdentity
  files: List<String>
}

type ArmConvergeApply sole_constructor {
  restart: ArmRestart
  removals: List<ArmRetiredRemoval>
}

fn arm_retired_removals(deviations: List<ArmRankDeviation>) -> List<ArmRetiredRemoval> {
  flat_map(deviations, d => match d {
    RankRetiredFilesPresent { host: h, files: f } => [ArmRetiredRemoval { host: h, files: f }]
    RankUnitAbsent { host: _ } => [] as List<ArmRetiredRemoval>
    RankUnitDiffers { host: _ } => [] as List<ArmRetiredRemoval>
    RankUnitInactive { host: _, state: _ } => [] as List<ArmRetiredRemoval>
    RankContainerAbsent { host: _ } => [] as List<ArmRetiredRemoval>
    RankContainerNotRunning { host: _, reading: _ } => [] as List<ArmRetiredRemoval>
    RankContainerRestarted { host: _, reading: _ } => [] as List<ArmRetiredRemoval>
    RankNotVerified { host: _, cause: _ } => [] as List<ArmRetiredRemoval>
  })
}

// AFTER_REMOVAL is true on the pass that re-observes the arm after a remove-only action. A retired file
// still read there was removed and read back present, so removing it again would loop: the decision
// refuses instead, naming the files.
fn arm_converge_decision(
  desired: List<ArmRankDesired>,
  assessment: GoalAssessment<ArmRealizedRanks, ArmRankDeviation, ArmRankUnknown, ArmAssessRefusal>,
  after_removal: Bool,
) -> UpsertDecision<ArmConvergeApply> {
  match assessment {
    GoalSatisfied { evidence: _ } => Noop
    GoalDiverged { deviations: ds } => {
      let all_ds = concat([ds.head], ds.tail)
      let removals = arm_retired_removals(deviations: all_ds)
      if any(all_ds, d => arm_deviation_needs_restart(d: d)) {
        Apply { plan: ArmConvergeApply { restart: ArmRestartWhole { ranks: desired }, removals: removals } }
      } else if after_removal {
        Refuse { reason: join(["retired transaction files were removed and read back present: ", join(map(removals, r => join([r.host as String, ":", join(r.files, ",")], "")), "; ")], "") as NonEmptyStr }
      } else {
        Apply { plan: ArmConvergeApply { restart: ArmNoRestart, removals: removals } }
      }
    }
    GoalIndeterminate { known_deviations: _, unknowns: u } =>
      Refuse { reason: join(["the arm's state is not established, and remediation over an unread rank is refused: ", join(map(concat([u.head], u.tail), x => arm_rank_unknown_text(u: x)), "; ")], "") as NonEmptyStr }
    GoalAssessmentRefused { cause: c } => Refuse { reason: arm_assess_refusal_text(r: c) as NonEmptyStr }
  }
}

fn arm_converge_apply_restart(p: ArmConvergeApply) -> ArmRestart {
  p.restart
}

fn arm_converge_apply_removals(p: ArmConvergeApply) -> List<ArmRetiredRemoval> {
  p.removals
}

fn arm_converge_apply_text(p: ArmConvergeApply) -> String {
  join([
    match p.restart {
      ArmRestartWhole { ranks: rs } => join(["the whole arm (", to_string(count(rs)), " ranks) is stopped and started again, head first"], "")
      ArmNoRestart => "no restart: every unit and container is left untouched"
    },
    if count(p.removals) > 0 { join(["; retired files removed on ", join(map(p.removals, r => r.host as String), ", ")], "") } else { "" },
  ], "")
}

// ── WHICH ARM WAS LAST COMMITTED ─────────────────────────────────────────────────────────────
//
// Every rank must carry a record, and every record must name the same step: a committed arm is one
// step on every rank. Anything else is not a committed arm a rollback may converge to.
type ArmCommittedReading
  = ArmCommitted { label: NonEmptyStr, unit_shas: List<String> }
  | ArmNotCommitted { cause: String }

fn arm_record_words(f: ArmFact) -> List<String>? {
  match f {
    FactRead { value: v } => {
      let words = filter(split(s: v, delimiter: " "), w => w != "")
      if count(words) == 2 { Present { value: words } } else { none }
    }
    FactAbsent => none
    FactUnread { cause: _ } => none
  }
}

fn arm_committed_reading(observed: List<ArmRankObservation>) -> ArmCommittedReading {
  let records = flat_map(observed, o => match o {
    ArmRankUnread { host: _, cause: _ } => [] as List<List<String>>
    ArmRankRead { observed: r } => match arm_record_words(f: r.committed) { Absent => [] as List<List<String>>  Present { value: w } => [w] }
  })
  if count(observed) == 0 || count(records) != count(observed) {
    ArmNotCommitted { cause: join(["a committed record was read on ", to_string(count(records)), " of ", to_string(count(observed)), " ranks; a committed arm carries one on every rank"], "") }
  } else {
    let labels = map(records, w => match w.first() { Present { value: l } => l, Absent => "" })
    match labels.first() {
      Absent => ArmNotCommitted { cause: "no committed record was read" }
      Present { value: l } =>
        if l == "" || any(labels, x => x != l) {
          ArmNotCommitted { cause: join(["the ranks' committed records name different steps (", join(labels, ", "), ")"], "") }
        } else {
          ArmCommitted { label: l as NonEmptyStr, unit_shas: map(records, w => match w.get(1) { Present { value: s } => s, Absent => "" }) }
        }
    }
  }
}

// A re-rendered committed step is the rollback's desired arm only if its planned unit hashes, read on
// the same hosts, are exactly the recorded ones.
fn arm_committed_reproduced(reading: ArmCommittedReading, rerendered: List<ArmRankObservation>) -> Bool {
  match reading {
    ArmNotCommitted { cause: _ } => false
    ArmCommitted { label: _, unit_shas: shas } =>
      count(shas) == count(rerendered) && all(zip_map(a: shas, b: rerendered, f: fn(s, o) {
        match o {
          ArmRankUnread { host: _, cause: _ } => false
          ArmRankRead { observed: r } => match r.desired_unit_sha { FactRead { value: v } => v == s  FactAbsent => false  FactUnread { cause: _ } => false }
        }
      }), x => x)
  }
}

fn arm_retired_files(observed: List<ArmRankObservation>) -> List<String> {
  flat_map(observed, o => match o {
    ArmRankUnread { host: _, cause: _ } => [] as List<String>
    ArmRankRead { observed: r } => map(r.retired_files, f => join([r.host as String, ":", f], ""))
  })
}

// ── RECEIPT TEXT ─────────────────────────────────────────────────────────────────────────────
fn arm_fact_text(f: ArmFact) -> String {
  match f {
    FactRead { value: v } => v
    FactAbsent => "absent"
    FactUnread { cause: c } => join(["UNREAD (", c, ")"], "")
  }
}

fn arm_rank_observation_line(o: ArmRankObservation) -> String {
  match o {
    ArmRankUnread { host: h, cause: c } => join(["  ", h as String, "  OBSERVATION UNREAD: ", c, "\n"], "")
    ArmRankRead { observed: r } => join([
      "  ", r.host as String,
      "  unit=", match r.unit_sha { FactRead { value: v } => match r.desired_unit_sha { FactRead { value: w } => if v == w { "as-planned" } else { "differs" }  FactAbsent => "unread-plan"  FactUnread { cause: _ } => "unread-plan" }  FactAbsent => "absent"  FactUnread { cause: c } => join(["UNREAD (", c, ")"], "") },
      "  active=", arm_fact_text(f: r.active_state),
      "  container=", arm_fact_text(f: r.container),
      "  committed=", arm_fact_text(f: r.committed),
      if count(r.retired_files) > 0 { join(["  retired-files=", to_string(count(r.retired_files))], "") } else { "" },
      "\n",
    ], "")
  }
}

fn arm_rank_deviation_text(d: ArmRankDeviation) -> String {
  match d {
    RankUnitAbsent { host: h } => join([h as String, ": no unit file"], "")
    RankUnitDiffers { host: h } => join([h as String, ": the unit file is not the desired arm's"], "")
    RankUnitInactive { host: h, state: s } => join([h as String, ": the unit is ", s], "")
    RankContainerAbsent { host: h } => join([h as String, ": no container"], "")
    RankContainerNotRunning { host: h, reading: r } => join([h as String, ": the container is not running (", r, ")"], "")
    RankContainerRestarted { host: h, reading: r } => join([h as String, ": the container has restarted (", r, ")"], "")
    RankNotVerified { host: h, cause: c } => join([h as String, ": the readback refused: ", c], "")
    RankRetiredFilesPresent { host: h, files: f } => join([h as String, ": retired transaction files present (", join(f, ", "), ")"], "")
  }
}

fn arm_rank_unknown_text(u: ArmRankUnknown) -> String {
  match u {
    RankFactUnread { host: h, fact: f, cause: c } => join([h as String, ": ", f as String, " unread (", c, ")"], "")
    RankObservationUnread { host: h, cause: c } => join([h as String, ": unread (", c, ")"], "")
  }
}

fn arm_assess_refusal_text(r: ArmAssessRefusal) -> String {
  match r {
    ArmRosterMismatch { desired: d, observed: o } =>
      join(["the observed ranks (", join(o, ", "), ") are not the desired arm's roster (", join(d, ", "), "), so the comparison is not well formed"], "")
  }
}

fn arm_assessment_text(a: GoalAssessment<ArmRealizedRanks, ArmRankDeviation, ArmRankUnknown, ArmAssessRefusal>) -> String {
  match a {
    GoalSatisfied { evidence: e } => join(["SATISFIED on ", join(map(e.hosts, h => h as String), ", ")], "")
    GoalDiverged { deviations: d } => join(["DIVERGED: ", join(map(concat([d.head], d.tail), x => arm_rank_deviation_text(d: x)), "; ")], "")
    GoalIndeterminate { known_deviations: k, unknowns: u } => join([
      "INDETERMINATE: ", join(map(concat([u.head], u.tail), x => arm_rank_unknown_text(u: x)), "; "),
      if count(k) > 0 { join(["; known deviations: ", join(map(k, x => arm_rank_deviation_text(d: x)), "; ")], "") } else { "" },
    ], "")
    GoalAssessmentRefused { cause: c } => join(["REFUSED: ", arm_assess_refusal_text(r: c)], "")
  }
}
