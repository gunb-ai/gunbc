// ── WHAT THIS MODULE IS FOR ──────────────────────────────────────────────────────────────────
//
// IT ANSWERS THE FITTING QUESTION FROM MODELLED FACTS, so a deployment decision that has not been
// made can read its projection off the corpus instead of off a person with a calculator. Given a
// checkpoint's manifest, a topology's rank count, one GB10's unified pool and a declared
// gpu_memory_utilization, it derives the weight bytes each rank must hold, the bytes the engine may
// use, whether the first fits inside the second, and what is left for KV. Beside that it derives the
// static execution-compatibility receipt -- does the runtime register the architecture, does it
// ship the quantization path, do the FP4 kernels run on this device -- from the readings the corpus
// already carries, and refuses by name where no reading exists.
//
// NOTHING HERE IS A LAUNCH RECEIPT. The strongest thing this module can say is that a tuple is
// STATICALLY plausible; gunbc.spark.serving_compatibility's ExecutionCompatible arm is earned only
// by an engine that loaded, served and answered, and no projection substitutes for it.
//
// THE ARITHMETIC IS EXACT AND ROUNDS IN THE REFUSING DIRECTION. Weights per rank round UP (a rank
// holding one byte more than an even share is still a rank that must hold it); usable bytes round
// DOWN (the engine's fraction of the pool is a floor, not a ceiling). A screen that rounded the
// other way could admit a tuple a byte-exact test refuses, which is the wrong error for a wall.

// ── THE WEIGHT-FIT PROJECTION ────────────────────────────────────────────────────────────────

type WeightFitVerdict
  = WeightsFitWithHeadroom { kv_headroom_per_rank: ByteSize }
  | WeightsExceedUsable { shortfall_per_rank: ByteSize }

type WeightFitProjection sole_constructor {
  weights: ByteSize
  ranks: Nat
  weights_per_rank: ByteSize
  pool_per_rank: ByteSize
  utilization: BasisPoint
  usable_per_rank: ByteSize
  verdict: WeightFitVerdict
}

fn ceil_div(n: Nat, d: Nat) -> Nat {
  if d == 0 { d } else { (n + (d - 1)) / d }
}

fn weights_per_rank_bytes(weights: ByteSize, ranks: Nat) -> ByteSize {
  byte_size(count: ceil_div(n: byte_size_count(b: weights), d: ranks))
}

fn usable_bytes(pool: ByteSize, utilization: BasisPoint) -> ByteSize {
  byte_size(count: (byte_size_count(b: pool) * basis_point_count(bp: utilization)) / basis_point_unity_count())
}

fn project_weight_fit(weights: ByteSize, ranks: Nat, pool_per_rank: ByteSize, utilization: BasisPoint) -> WeightFitProjection {
  let per_rank = weights_per_rank_bytes(weights: weights, ranks: ranks)
  let usable = usable_bytes(pool: pool_per_rank, utilization: utilization)
  let per_rank_count = byte_size_count(b: per_rank)
  let usable_count = byte_size_count(b: usable)
  WeightFitProjection {
    weights: weights,
    ranks: ranks,
    weights_per_rank: per_rank,
    pool_per_rank: pool_per_rank,
    utilization: utilization,
    usable_per_rank: usable,
    verdict: if usable_count >= per_rank_count {
      WeightsFitWithHeadroom { kv_headroom_per_rank: byte_size(count: usable_count - per_rank_count) }
    } else {
      WeightsExceedUsable { shortfall_per_rank: byte_size(count: per_rank_count - usable_count) }
    },
  }
}

// THE POOL IS THE SERVING-ARM AUTHORITY'S, AND THE UTILISATION IS THE LIVE ARM'S. gb10_unified_pool_gib
// was read off a live member; glm_native_initial_profile carries the 8400 basis points the serving
// Group B arm launched with. Reading both from their homes is what makes this projection comparable
// to that arm: the same pool, the same fraction, a different checkpoint and rank count.
fn gb10_pool_bytes() -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: gb10_unified_pool_gib))
}

fn project_on_gb10(manifest: GlmCheckpointManifest, topology: ServingTopology, utilization: BasisPoint) -> WeightFitProjection {
  project_weight_fit(
    weights: manifest.safetensors_bytes,
    ranks: serving_topology_rank_count(t: topology),
    pool_per_rank: gb10_pool_bytes(),
    utilization: utilization,
  )
}

fn live_arm_utilization() -> BasisPoint {
  glm_native_initial_profile.decided_gpu_memory_basis_points
}

// ── THE STATIC EXECUTION-COMPATIBILITY RECEIPT ───────────────────────────────────────────────
//
// THREE QUESTIONS, EACH ANSWERED FROM A READING OR REFUSED BY NAME. They are kept apart because
// each names a different remedy when it fails: an unregistered architecture needs a newer engine, a
// missing quantization path needs a build, FP4 kernels that do not run here need different hardware
// or a different checkpoint. A single Bool could not say which.
type StaticCompatibilityQuestion
  = ArchitectureRegisteredInRuntime
  | QuantizationMethodShippedByRuntime
  | Fp4WeightsSupportedOnDevice

fn static_question_label(q: StaticCompatibilityQuestion) -> String {
  match q {
    ArchitectureRegisteredInRuntime => "architecture registered in the runtime's model registry"
    QuantizationMethodShippedByRuntime => "quantization method shipped by the runtime"
    Fp4WeightsSupportedOnDevice => "fp4 weight kernels supported on this device"
  }
}

// ESTABLISHED, MEASURED-NEGATIVE AND NOT-ESTABLISHED ARE THREE ANSWERS. A reading that says no is
// evidence against the tuple; a reading that does not exist for this digest is not, and an arm that
// collapsed the two would turn an unprobed image into a refused one -- or, worse, a reported one
// into a probed one. Every NotEstablished arm names the one act that would establish it.
type StaticCompatibilityAnswer
  = Established { question: StaticCompatibilityQuestion, evidence: NonEmptyStr }
  | MeasuredNegative { question: StaticCompatibilityQuestion, evidence: NonEmptyStr }
  | NotEstablished { question: StaticCompatibilityQuestion, missing: NonEmptyStr }

fn answer_question(a: StaticCompatibilityAnswer) -> StaticCompatibilityQuestion {
  match a {
    Established { question: q, evidence: _ } => q
    MeasuredNegative { question: q, evidence: _ } => q
    NotEstablished { question: q, missing: _ } => q
  }
}

fn answer_is_established(a: StaticCompatibilityAnswer) -> Bool {
  match a {
    Established { question: _, evidence: _ } => true
    MeasuredNegative { question: _, evidence: _ } => false
    NotEstablished { question: _, missing: _ } => false
  }
}

fn answer_text(a: StaticCompatibilityAnswer) -> String {
  match a {
    Established { question: q, evidence: e } => join([static_question_label(q: q), ": ESTABLISHED -- ", e as String], "")
    MeasuredNegative { question: q, evidence: e } => join([static_question_label(q: q), ": MEASURED NEGATIVE -- ", e as String], "")
    NotEstablished { question: q, missing: m } => join([static_question_label(q: q), ": NOT ESTABLISHED -- ", m as String], "")
  }
}

// THE ARCHITECTURE QUESTION IS THE ADMISSION FOLD'S OWN CHECK, asked through the same two functions
// serving_arm_admits uses -- the reading must have been taken inside the digest this arm would
// launch, and it must contain the class. No second registry lookup is written here.
fn architecture_answer(rrow: ServingRuntimeRow, architecture: NonEmptyStr) -> StaticCompatibilityAnswer {
  if !runtime_reading_is_current(rrow: rrow) {
    NotEstablished {
      question: ArchitectureRegisteredInRuntime,
      missing: join([
        "no registry reading was taken inside ", runtime_artifact_wire(a: rrow.artifact) as String,
        "; one execution of the registry instrument inside that digest settles it",
      ], "") as NonEmptyStr,
    }
  } else if runtime_registers(rrow: rrow, architecture: architecture) {
    match rrow.registry_reading {
      Absent => NotEstablished { question: ArchitectureRegisteredInRuntime, missing: "unreachable: a current reading is present" as NonEmptyStr }
      Present { value: r } => Established {
        question: ArchitectureRegisteredInRuntime,
        evidence: join([
          architecture as String, " is among the ", to_string(length(r.architectures)),
          " architectures the registry answered inside ", r.image_reference as String,
          " on ", r.host as String, ", ", r.observed_at as String,
        ], "") as NonEmptyStr,
      }
    }
  } else {
    match rrow.registry_reading {
      Absent => NotEstablished { question: ArchitectureRegisteredInRuntime, missing: "unreachable: a current reading is present" as NonEmptyStr }
      Present { value: r } => MeasuredNegative {
        question: ArchitectureRegisteredInRuntime,
        evidence: join([
          architecture as String, " is not among the ", to_string(length(r.architectures)),
          " architectures the registry answered inside ", r.image_reference as String,
          " on ", r.observed_at as String,
        ], "") as NonEmptyStr,
      }
    }
  }
}

// ── THE RUNTIME-IMAGE REPORT, TYPED AS WHAT IT IS ─────────────────────────────────────────────
//
// THE GLM PERFORMANCE LANE PROBED THE IMAGE GROUP B SERVES, and what it established is carried
// here at exactly its strength. Instrument (run on the head, 2026-09-18):
//   docker run --rm --entrypoint python3 gunbc-vllm-glm53-gb10:derived-c99be081f219d123 -c "<script>"
// printing vllm.__version__, globbing vllm/model_executor/layers/quantization/*.py for modelopt.py,
// and testing ModelRegistry.get_supported_archs() for GlmMoeDsaForCausalLM. That establishes the
// ARCHITECTURE IS REGISTERED and a modelopt quantization MODULE IS PRESENT in the package. It does
// NOT establish that the NVFP4 W4A4 path has working kernels for this architecture on SM121, and no
// checkpoint was loaded -- that stronger claim is the Fp4WeightSupportedHere probe below, and this
// report never stands in for it.
//
// THE FIRST REVISION OF THIS ROW WAS KEYED BY THE TAG, AND THE EXACT-MATCH JOIN REFUSED IT -- WHICH
// CAUGHT SOMETHING REAL. `docker image inspect` on the head answered Id
// sha256:c7d63d15... for the tag, and the running container's .Image is that id. The serving-arm
// row this projection asks about (GunbcGlm53NopeDerivedGb10) pins sha256:41366caf..., which
// `docker images` shows is a DIFFERENT repository, gunbc-vllm-glm53-nope-gb10, built five days
// earlier. So the modelled runtime is the NoPE-derived image it was built as on 2026-09-13, and the
// image Group B serves today has no runtime row at all. A lenient join would have attached this
// report to the NoPE image and called the serving image covered; the refusal below says instead
// that the serving image is unmodelled, which is the fact a deployment decision needs.
//
// THE REPORT IS KEYED BY THE CONTENT ID THAT WAS PROBED, never by the tag it was reached through.
// THE PROBE THAT WOULD REPLACE THIS is a RuntimeCapabilityProbeRow in
// gunbc.spark.serving_runtime_capability_probe keyed by this content id, once that image has a
// runtime row of its own; this report dissolves into that row when one is taken.
type RuntimeImageReport {
  image_reference: NonEmptyStr
  reached_through_tag: NonEmptyStr
  vllm_version: NonEmptyStr
  architecture_registered: NonEmptyStr
  quant_method_module_present: NonEmptyStr
  instrument: NonEmptyStr
  reported_by: NonEmptyStr
}

data glm53_group_b_image_report: RuntimeImageReport = RuntimeImageReport {
  image_reference: "sha256:c7d63d153f991b9f1bd7e6419dcd1a5109746670747be90f4ff6da74f0e8fe84" as NonEmptyStr,
  reached_through_tag: "gunbc-vllm-glm53-gb10:derived-c99be081f219d123" as NonEmptyStr,
  vllm_version: "0.1.dev1+g8d09804c8" as NonEmptyStr,
  architecture_registered: "GlmMoeDsaForCausalLM" as NonEmptyStr,
  quant_method_module_present: glm_5_3_nvfp4_quantization.quant_method,
  instrument: "docker run --rm --entrypoint python3 <tag> -c: print vllm.__version__; glob vllm/model_executor/layers/quantization/*.py for modelopt.py and mxfp4.py; GlmMoeDsaForCausalLM in ModelRegistry.get_supported_archs()" as NonEmptyStr,
  reported_by: "the GLM performance lane (calm-bat-65) on the Group B head, 2026-09-18: Id read by `docker image inspect --format '\{\{.Id\}\}'` on the tag, RepoDigests empty (locally built, never pushed), Created 2026-09-17T14:55:06-04:00, and the running container's .Image is the same id; vllm 0.1.dev1+g8d09804c8; modelopt.py present; the architecture membership True. The package's modelopt module being present is NOT evidence that NVFP4 W4A4 kernels run for this architecture on SM121" as NonEmptyStr,
}

fn quantization_answer(rrow: ServingRuntimeRow, report: RuntimeImageReport, required_method: NonEmptyStr) -> StaticCompatibilityAnswer {
  let pin = runtime_artifact_wire(a: rrow.artifact)
  if (report.image_reference as String) != (pin as String) {
    NotEstablished {
      question: QuantizationMethodShippedByRuntime,
      missing: join([
        "the only observation of the ", required_method as String, " module was taken inside ",
        report.image_reference as String, " (reached through ", report.reached_through_tag as String,
        ") and this runtime row pins ", pin as String,
        "; they are different images, so the image that was probed has no runtime row and the runtime this projection asks about was not probed. ",
        "A runtime row for the probed image -- artifact identity, registry reading inside that digest, hub cli path -- is what makes the projection answer for the image that is actually serving",
      ], "") as NonEmptyStr,
    }
  } else if (report.quant_method_module_present as String) != (required_method as String) {
    NotEstablished {
      question: QuantizationMethodShippedByRuntime,
      missing: join([
        "the report answers for ", report.quant_method_module_present as String, " and the checkpoint needs ", required_method as String,
      ], "") as NonEmptyStr,
    }
  } else {
    Established { question: QuantizationMethodShippedByRuntime, evidence: join([
      "the ", required_method as String, " quantization module is present in the package inside ", report.image_reference as String,
      " (", report.instrument as String, "); this is module presence, not a kernel path -- the FP4-on-device question is asked separately",
    ], "") as NonEmptyStr }
  }
}

// THE FP4-ON-DEVICE QUESTION IS ASKED OF THE CAPABILITY PROBE ROSTER, keyed by the arm's own digest
// and this fleet's observed compute capability. That roster has a Present answer for a DIFFERENT
// image (the V4.1 published arm64 build, srv9, 2026-09-11) and no row for the GLM derived image, so
// today this answers NotEstablished -- which is the honest state: cutlass_scaled_mm_supports_fp4 has
// been called on a GB10 inside some image, not inside this one.
fn fp4_device_answer(rrow: ServingRuntimeRow, device: GpuComputeCapability) -> StaticCompatibilityAnswer {
  let pin = runtime_artifact_wire(a: rrow.artifact)
  match capability_outcome(rows: v41_sm121_capability_probe_rows(), image_reference: pin, capability: Fp4WeightSupportedHere, device: device) {
    OutcomeUnrecorded => NotEstablished {
      question: Fp4WeightsSupportedOnDevice,
      missing: join([
        "no ", runtime_kernel_capability_label(c: Fp4WeightSupportedHere), " probe row exists for ", pin as String,
        "; gunbc.spark.v41_runtime_image_probe executed inside that digest on a GB10 produces one",
      ], "") as NonEmptyStr,
    }
    OutcomeConflicted { distinct_answers: n } => NotEstablished {
      question: Fp4WeightsSupportedOnDevice,
      missing: join(["the probe roster holds ", to_string(n), " distinct answers for ", pin as String, "; re-probe rather than choose"], "") as NonEmptyStr,
    }
    OutcomeFound { outcome: o } => match o {
      KernelObservedPresent { symbol: s } => Established { question: Fp4WeightsSupportedOnDevice, evidence: s }
      KernelObservedAbsent { symbol: s } => MeasuredNegative { question: Fp4WeightsSupportedOnDevice, evidence: s }
      KernelProbeRefused { reason: r } => NotEstablished { question: Fp4WeightsSupportedOnDevice, missing: r }
      KernelProbeSymbolUngrounded { roster: _, defect: d } => NotEstablished { question: Fp4WeightsSupportedOnDevice, missing: d }
    }
  }
}

fn static_compatibility_answers(crow: ServingCheckpointRow, rrow: ServingRuntimeRow, report: RuntimeImageReport, required_method: NonEmptyStr) -> List<StaticCompatibilityAnswer> {
  [
    architecture_answer(rrow: rrow, architecture: crow.architecture),
    quantization_answer(rrow: rrow, report: report, required_method: required_method),
    fp4_device_answer(rrow: rrow, device: gb10_observed_compute_capability),
  ]
}

// ── THE DEPLOYMENT PROJECTION, ONE VALUE PER (CHECKPOINT, RUNTIME, TOPOLOGY, UTILISATION) ──────
//
// ADMITTED MEANS STATICALLY PLAUSIBLE AND NOTHING MORE: the weights fit with headroom AND every
// static question is Established. A single NotEstablished answer refuses -- the projection does not
// guess -- and the refusal carries every answer so a reader sees which fact is missing and which act
// supplies it, rather than re-deriving the list.
type DeploymentProjectionVerdict
  = ProjectionAdmitsStatically { fit: WeightFitProjection, answers: List<StaticCompatibilityAnswer> }
  | ProjectionRefused { cause: NonEmptyStr, fit: WeightFitProjection?, answers: List<StaticCompatibilityAnswer> }

type DeploymentProjection sole_constructor {
  checkpoint: ServingCheckpoint
  runtime: ServingRuntime
  topology: ServingTopology
  verdict: DeploymentProjectionVerdict
}

fn fit_refusal_text(p: WeightFitProjection) -> String? {
  match p.verdict {
    WeightsFitWithHeadroom { kv_headroom_per_rank: _ } => none
    WeightsExceedUsable { shortfall_per_rank: s } => Present { value: join([
      "the weights do not fit: ", to_string(byte_size_count(b: p.weights_per_rank)), " bytes per rank across ",
      to_string(p.ranks), " rank(s) against ", to_string(byte_size_count(b: p.usable_per_rank)),
      " usable bytes per rank (", to_string(byte_size_count(b: p.pool_per_rank)), " pool at ",
      to_string(basis_point_count(bp: p.utilization)), " basis points), short by ",
      to_string(byte_size_count(b: s)), " bytes per rank before any KV",
    ], "") }
  }
}

fn unestablished_text(answers: List<StaticCompatibilityAnswer>) -> String? {
  let failing = filter(answers, a => !answer_is_established(a: a))
  if length(failing) == 0 {
    none
  } else {
    Present { value: join(map(failing, a => answer_text(a: a)), "; ") }
  }
}

fn project_deployment(
  checkpoint: ServingCheckpoint,
  runtime: ServingRuntime,
  topology: ServingTopology,
  manifest: GlmCheckpointManifest,
  utilization: BasisPoint,
  report: RuntimeImageReport,
  required_method: NonEmptyStr,
) -> DeploymentProjection {
  let verdict = match serving_checkpoint_row(c: checkpoint) {
    Absent => ProjectionRefused { cause: "no checkpoint row: the checkpoint's architecture and footprint are unmodelled" as NonEmptyStr, fit: none, answers: [] }
    Present { value: crow } =>
      match serving_runtime_row(r: runtime) {
        Absent => ProjectionRefused { cause: "no runtime row: the image has no modelled identity to ask about" as NonEmptyStr, fit: none, answers: [] }
        Present { value: rrow } => {
          let fit = project_on_gb10(manifest: manifest, topology: topology, utilization: utilization)
          let answers = static_compatibility_answers(crow: crow, rrow: rrow, report: report, required_method: required_method)
          match fit_refusal_text(p: fit) {
            Present { value: t } => ProjectionRefused { cause: t as NonEmptyStr, fit: Present { value: fit }, answers: answers }
            Absent => match unestablished_text(answers: answers) {
              Present { value: t } => ProjectionRefused { cause: t as NonEmptyStr, fit: Present { value: fit }, answers: answers }
              Absent => ProjectionAdmitsStatically { fit: fit, answers: answers }
            }
          }
        }
      }
  }
  DeploymentProjection { checkpoint: checkpoint, runtime: runtime, topology: topology, verdict: verdict }
}

// ── THE RadixArk NVFP4 PROJECTIONS ON THE LIVE RUNTIME ───────────────────────────────────────
//
// THE TWO ROWS THE OPERATOR ASKED FOR, and one more that is the comparison baseline. Both NVFP4 rows
// use the derived NoPE runtime the Group B arm serves on, the live arm's utilisation and the
// redistribution's manifest; only the rank count differs.
fn radixark_nvfp4_projection(topology: ServingTopology) -> DeploymentProjection {
  project_deployment(
    checkpoint: Glm53RadixArkNvfp4Modelopt,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: topology,
    manifest: glm_5_3_nvfp4_manifest,
    utilization: live_arm_utilization(),
    report: glm53_group_b_image_report,
    required_method: glm_5_3_nvfp4_quantization.quant_method,
  )
}

fn radixark_nvfp4_tp4() -> DeploymentProjection {
  radixark_nvfp4_projection(topology: FourSparkTp4)
}

fn radixark_nvfp4_tp8() -> DeploymentProjection {
  radixark_nvfp4_projection(topology: EightSparkTp8)
}

// THE WEIGHT FIT ALONE, for the two rows and for the arm that is serving today. These are the numbers
// a reader compares: bytes per rank, usable bytes per rank, headroom.
fn radixark_nvfp4_fit(topology: ServingTopology) -> WeightFitProjection {
  project_on_gb10(manifest: glm_5_3_nvfp4_manifest, topology: topology, utilization: live_arm_utilization())
}

fn glm53_flash_native_live_arm_fit() -> WeightFitProjection {
  project_on_gb10(manifest: glm_5_3_flash_native_manifest, topology: FourSparkTp4, utilization: live_arm_utilization())
}

fn kv_headroom_per_rank(p: WeightFitProjection) -> ByteSize? {
  match p.verdict {
    WeightsFitWithHeadroom { kv_headroom_per_rank: h } => Present { value: h }
    WeightsExceedUsable { shortfall_per_rank: _ } => none
  }
}

// DOES THE PROJECTED ARM LEAVE MORE PER-RANK KV ROOM THAN THE LIVE ONE. Both sides through one fold,
// so the comparison cannot be premised on two different notions of headroom.
fn projection_leaves_more_kv_than_live_arm(topology: ServingTopology) -> Bool {
  match kv_headroom_per_rank(p: radixark_nvfp4_fit(topology: topology)) {
    Absent => false
    Present { value: projected } =>
      match kv_headroom_per_rank(p: glm53_flash_native_live_arm_fit()) {
        Absent => true
        Present { value: live } => byte_size_count(b: projected) > byte_size_count(b: live)
      }
  }
}

// ── EXPERT OFFLOAD IS REFUSED ON THIS HARDWARE, WITH THE REASON DERIVED ──────────────────────
//
// THE OBVIOUS WAY TO FIT A 465 GB MoE ON FEWER NODES IS TO KEEP THE EXPERTS SOMEWHERE LARGER AND
// STREAM THE EIGHT A TOKEN NEEDS. That works when the accelerator has a smaller pool than the host:
// the experts live in host DRAM and cross a bus. GB10 has no such pair. Its memory_kind is
// UnifiedShared -- the host RAM and the GPU pool are the same physical LPDDR5x -- so "offload to host"
// spills into the pool it was meant to relieve, and the next tier down is NVMe. The bytes that tier
// would have to deliver per decoded token are derived below: the experts one token visits across the
// stack, times one expert's on-disk bytes. Uncached, that is a per-token read no NVMe sustains at
// interactive rates, and the refusal carries the figure so nobody re-derives it.
//
// THE DECISION IS MADE ON THE CATALOG'S MEMORY KIND, NOT ON PROSE. A GPU whose memory is Dram or Hbm
// (a discrete part with a host behind it) is not refused here; the answer for it is NotProjected
// because this module models no bus.
type ExpertOffloadProjection
  = OffloadRefusedUnifiedMemory { device: NonEmptyStr, expert_bytes_per_token: ByteSize, expert_visits_per_token: Nat }
  | OffloadNotProjected { device: NonEmptyStr, memory_kind: String }

fn memory_kind_label(k: MemoryKind) -> String {
  match k {
    Dram => "dram"
    Hbm => "hbm"
    UnifiedShared => "unified-shared"
  }
}

fn expert_bytes_per_token(shape: GlmMoeDsaShape, expert_bytes: ByteSize) -> ByteSize {
  byte_size(count: glm_5_3_routed_expert_visits_per_token(s: shape) * byte_size_count(b: expert_bytes))
}

fn project_expert_offload(shape: GlmMoeDsaShape, expert_bytes: ByteSize) -> ExpertOffloadProjection {
  let device = nvidia_gb10_gpu_catalog.model
  match nvidia_gb10_gpu_catalog.memory.memory_kind {
    UnifiedShared => OffloadRefusedUnifiedMemory {
      device: device,
      expert_bytes_per_token: expert_bytes_per_token(shape: shape, expert_bytes: expert_bytes),
      expert_visits_per_token: glm_5_3_routed_expert_visits_per_token(s: shape),
    }
    Dram => OffloadNotProjected { device: device, memory_kind: memory_kind_label(k: Dram) }
    Hbm => OffloadNotProjected { device: device, memory_kind: memory_kind_label(k: Hbm) }
  }
}

fn radixark_nvfp4_expert_offload() -> ExpertOffloadProjection {
  project_expert_offload(shape: glm_5_3_shape, expert_bytes: nvfp4_representative_expert_bytes())
}

// ── THE READOUT, ONE TEXT PER PROJECTION FOR A PERSON ────────────────────────────────────────
fn fit_text(p: WeightFitProjection) -> String {
  join([
    to_string(p.ranks), " rank(s): ", to_string(byte_size_count(b: p.weights_per_rank)), " weight bytes per rank, ",
    to_string(byte_size_count(b: p.usable_per_rank)), " usable bytes per rank at ",
    to_string(basis_point_count(bp: p.utilization)), " basis points of ",
    to_string(byte_size_count(b: p.pool_per_rank)), " -- ",
    match p.verdict {
      WeightsFitWithHeadroom { kv_headroom_per_rank: h } => join(["FITS with ", to_string(byte_size_count(b: h)), " bytes per rank left for KV"], "")
      WeightsExceedUsable { shortfall_per_rank: s } => join(["DOES NOT FIT, short by ", to_string(byte_size_count(b: s)), " bytes per rank"], "")
    },
  ], "")
}

fn projection_text(p: DeploymentProjection) -> String {
  let head = join([
    serving_checkpoint_wire(c: p.checkpoint) as String, " on ", serving_runtime_wire(r: p.runtime) as String,
    " at ", serving_topology_wire(t: p.topology) as String, ": ",
  ], "")
  match p.verdict {
    ProjectionAdmitsStatically { fit: f, answers: a } => join([
      head, "ADMITTED STATICALLY (no launch has run). ", fit_text(p: f), ". ",
      join(map(a, x => answer_text(a: x)), "; "),
    ], "")
    ProjectionRefused { cause: c, fit: f, answers: _ } => join([
      head, "REFUSED: ", c as String, ". ",
      match f {
        Present { value: fp } => fit_text(p: fp)
        Absent => "no fit computed"
      },
    ], "")
  }
}

fn offload_text(o: ExpertOffloadProjection) -> String {
  match o {
    OffloadRefusedUnifiedMemory { device: d, expert_bytes_per_token: b, expert_visits_per_token: v } => join([
      "expert offload REFUSED on ", d as String, ": its memory is unified-shared, so there is no larger host tier to spill into and the next tier is NVMe; uncached that is ",
      to_string(v), " expert visits per token at ", to_string(byte_size_count(b: b)), " bytes per token",
    ], "")
    OffloadNotProjected { device: d, memory_kind: k } => join([
      "expert offload NOT PROJECTED on ", d as String, " (", k, "): this module models no host-to-device bus",
    ], "")
  }
}

fn radixark_nvfp4_gb10_readout() -> String {
  join([
    projection_text(p: radixark_nvfp4_tp4()),
    projection_text(p: radixark_nvfp4_tp8()),
    join(["live GLM-5.3-Flash arm for comparison: ", fit_text(p: glm53_flash_native_live_arm_fit())], ""),
    offload_text(o: radixark_nvfp4_expert_offload()),
  ], "\n")
}

// THE RUN ENTRY. `gunbc run --entry dag/gunbc/spark/serving_fit_projection.dag --function
// radixark_nvfp4_gb10_exit` is the instrument that re-derives every figure above; the exit is
// success only when the eight-rank projection admits statically, and the readout travels in the
// reason either way so a refusing run still says what it computed and which fact is missing.
fn projection_admits(p: DeploymentProjection) -> Bool {
  match p.verdict {
    ProjectionAdmitsStatically { fit: _, answers: _ } => true
    ProjectionRefused { cause: _, fit: _, answers: _ } => false
  }
}

fn radixark_nvfp4_gb10_exit() -> ProcessExit {
  let readout = radixark_nvfp4_gb10_readout()
  if projection_admits(p: radixark_nvfp4_tp8()) {
    ExitSuccess
  } else {
    exit_failure(reason: readout)
  }
}
