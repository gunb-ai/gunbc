// ── WHAT THIS MODULE IS FOR ──────────────────────────────────────────────────────────────────
//
// IT IS AN ARTIFACT SCREEN, NOT A FIT PROJECTION, AND THE NAME OF EVERY VALUE SAYS SO. Given a
// checkpoint's manifest, the bytes the loader must load under any mode, a topology's rank count, one
// GB10's unified pool and a declared gpu_memory_utilization, it derives two ideal even splits per
// rank and asks whether either exceeds the engine's budget. Only ONE of them can refuse: the
// GUARANTEED-LOADED PAYLOAD -- the routed experts, derived from the modelled expert layout, which
// every serving mode loads and no placement replicates -- is a lower bound on the largest rank under
// any placement, so a split of it that exceeds the budget refuses the topology structurally. The
// FULL-ARTIFACT split includes shard headers and the ~19.9 GB nextn/MTP population that loads only
// under speculative decoding, so it is a screen figure and not a lower bound: exceeding the budget on
// it is reported and leaves the standing at calibration required. Below both, the screen PASSES WITH
// PLACEMENT UNREAD, which is not a fit. Beside that it derives a static prerequisite receipt from the
// readings the corpus already carries, and defers by name where none exists.
//
// WHY THE IDEAL SPLIT CANNOT MINT A FIT. `safetensors_bytes / ranks` assumes every artifact byte is
// loaded (the ~19.9 GB nextn/MTP layer is loaded only when speculative decoding uses it), sharded
// evenly across tensor-parallel ranks (norms, routers, embeddings, scales and shared experts
// replicate; routed experts may follow an expert-parallel law instead), kept in its on-disk
// representation (NVFP4 kernels preprocess and pad), and free of transformed copies. None of those is
// established here. The first revision of this module minted "TP4 refuses, TP8 fits with 51 GB of KV
// headroom" from this division -- numbers seeded by the brief it was written under, so reproducing
// them was not evidence. What survives is the lower-bound refusal; the fit is a later PR's, backed by
// a per-tensor placement projection or a model-load memory receipt.
//
// WHY THE RESIDUAL IS NOT KV. `usable - ideal_weights_per_rank` is the budget left BEFORE the
// engine funds runtime and non-torch memory, activations, CUDA graphs, collective workspaces,
// allocator rounding and transformed weight copies. Only the engine's own memory profile --
// extdeps.vllm.memory_profile VllmMemoryProfileReading, admitted through
// gunbc.spark.vllm_memory_receipt -- mints available KV bytes, and no such reading exists for any
// candidate here. The residual is carried under its own name and compared to nothing.
//
// THE POOL INPUT IS A ROUNDED READING. gb10_unified_pool_gib is 121 GiB from `free -g` on a live
// member; the arithmetic below is exact over that rounded input, which is a different claim from
// byte-exact admission. An exact byte producer bound to the candidate host class is the read that
// would upgrade it.
//
// NOTHING HERE IS A LAUNCH RECEIPT OR A DEPLOYMENT VERDICT, and there is no admitting arm: with
// placement unread the strongest standing is CALIBRATION REQUIRED, naming what would establish it.
// gunbc.spark.serving_compatibility's ExecutionCompatible arm is earned only by an engine that
// loaded, served and answered, and a deployment admission also needs a qualified rank offer --
// eight compatible GB10 ranks in an admitted fabric group with the image and checkpoint in place --
// which EightSparkTp8 does not carry: it is a rank count.
//
// THE ARITHMETIC ROUNDS IN THE REFUSING DIRECTION. Weights per rank round UP; usable bytes round
// DOWN. A screen that rounded the other way could pass a tuple a byte-exact test refuses.

// ── THE IDEAL EVEN-SPLIT ARTIFACT SCREEN ────────────────────────────────────────────────────

type IdealEvenSplitVerdict
  = GuaranteedPayloadSplitExceedsUsable { shortfall_per_rank: ByteSize }
  | FullArtifactSplitExceedsUsable { shortfall_per_rank: ByteSize, guaranteed_payload_residual: ByteSize }
  | IdealSplitWithinBudgetPlacementUnread { pre_runtime_artifact_residual: ByteSize }

type IdealEvenSplitArtifactScreen sole_constructor {
  weights: ByteSize
  guaranteed_payload: ByteSize
  ranks: Nat
  ideal_weights_per_rank: ByteSize
  ideal_guaranteed_payload_per_rank: ByteSize
  pool_per_rank: ByteSize
  utilization: BasisPoint
  usable_per_rank: ByteSize
  verdict: IdealEvenSplitVerdict
}

// ZERO RANKS IS A REFUSAL, NOT A SHARE OF ZERO. A degenerate rank count has no per-rank figure, and
// answering 0 bytes per rank would admit any checkpoint on no hardware -- a fabricated fit from a
// fold whose whole job is to refuse. So the division is partial and the projection is optional.
fn ceil_div(n: Nat, d: Nat) -> Nat? {
  if d == 0 { none } else { Present { value: (n + (d - 1)) / d } }
}

fn weights_per_rank_bytes(weights: ByteSize, ranks: Nat) -> ByteSize? {
  match ceil_div(n: byte_size_count(b: weights), d: ranks) {
    Absent => none
    Present { value: c } => Present { value: byte_size(count: c) }
  }
}

fn usable_bytes(pool: ByteSize, utilization: BasisPoint) -> ByteSize {
  byte_size(count: (byte_size_count(b: pool) * basis_point_count(bp: utilization)) / basis_point_unity_count())
}

fn screen_ideal_even_split(weights: ByteSize, guaranteed_payload: ByteSize, ranks: Nat, pool_per_rank: ByteSize, utilization: BasisPoint) -> IdealEvenSplitArtifactScreen? {
  match weights_per_rank_bytes(weights: weights, ranks: ranks) {
    Absent => none
    Present { value: per_rank } =>
      match weights_per_rank_bytes(weights: guaranteed_payload, ranks: ranks) {
        Absent => none
        Present { value: guaranteed_per_rank } => {
          let usable = usable_bytes(pool: pool_per_rank, utilization: utilization)
          let per_rank_count = byte_size_count(b: per_rank)
          let guaranteed_count = byte_size_count(b: guaranteed_per_rank)
          let usable_count = byte_size_count(b: usable)
          Present { value: IdealEvenSplitArtifactScreen {
            weights: weights,
            guaranteed_payload: guaranteed_payload,
            ranks: ranks,
            ideal_weights_per_rank: per_rank,
            ideal_guaranteed_payload_per_rank: guaranteed_per_rank,
            pool_per_rank: pool_per_rank,
            utilization: utilization,
            usable_per_rank: usable,
            verdict: if guaranteed_count > usable_count {
              GuaranteedPayloadSplitExceedsUsable { shortfall_per_rank: byte_size(count: guaranteed_count - usable_count) }
            } else if per_rank_count > usable_count {
              FullArtifactSplitExceedsUsable { shortfall_per_rank: byte_size(count: per_rank_count - usable_count), guaranteed_payload_residual: byte_size(count: usable_count - guaranteed_count) }
            } else {
              IdealSplitWithinBudgetPlacementUnread { pre_runtime_artifact_residual: byte_size(count: usable_count - per_rank_count) }
            },
          } }
        }
      }
  }
}

// THE POOL IS THE SERVING-ARM AUTHORITY'S, AND THE UTILISATION IS THE LIVE ARM'S. gb10_unified_pool_gib
// was read off a live member; glm_native_initial_profile carries the 8400 basis points the serving
// Group B arm launched with. Reading both from their homes is what makes this projection comparable
// to that arm: the same pool, the same fraction, a different checkpoint and rank count.
fn gb10_pool_bytes() -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: gb10_unified_pool_gib))
}

fn screen_on_gb10(manifest: HubCheckpointManifest, guaranteed_payload: ByteSize, topology: ServingTopology, utilization: BasisPoint) -> IdealEvenSplitArtifactScreen? {
  screen_ideal_even_split(
    weights: manifest.safetensors_bytes,
    guaranteed_payload: guaranteed_payload,
    ranks: serving_topology_rank_count(t: topology),
    pool_per_rank: gb10_pool_bytes(),
    utilization: utilization,
  )
}

fn live_arm_utilization() -> BasisPoint {
  glm_native_initial_profile.decided_gpu_memory_basis_points
}

// ── THE STATIC EXECUTION-COMPATIBILITY RECEIPT ───────────────────────────────────────────────
//
// THREE PREREQUISITE QUESTIONS, EACH ANSWERED FROM A READING OR DEFERRED BY NAME, AND EACH NAMED AT
// ITS OWN STRENGTH. Registry membership is a registration prerequisite, not load compatibility.
// Module-file presence is a package prerequisite, not handler registration, config acceptance or a
// kernel path. The kernel question is the load-bearing one for this checkpoint -- only the routed
// experts are NVFP4, so the ModelOpt NVFP4 MoE selector for this shape and device decides, and the
// dense CUTLASS predicate the current probe calls is one candidate among several backends at this
// vLLM revision. They are kept apart because each names a different remedy, and nothing below
// renames a weaker answer as a stronger one.
type StaticCompatibilityQuestion
  = ArchitectureRegisteredInRuntime
  | QuantizationModuleFilePresentInRuntime
  | DenseCutlassFp4HelperSupport
  | Fp4MoeKernelPathEstablishedOnDevice

fn static_question_label(q: StaticCompatibilityQuestion) -> String {
  match q {
    ArchitectureRegisteredInRuntime => "architecture registered in the runtime's model registry (a registration prerequisite, not load compatibility)"
    QuantizationModuleFilePresentInRuntime => "quantization module file present in the runtime's package (a prerequisite, not handler registration or a kernel path)"
    DenseCutlassFp4HelperSupport => "dense CUTLASS fp4 helper (cutlass_scaled_mm_supports_fp4) answers for this device -- informational: it neither establishes nor refutes the routed-expert path"
    Fp4MoeKernelPathEstablishedOnDevice => "NVFP4 MoE kernel path established on this device for this checkpoint's routed experts"
  }
}

// ONLY DISPOSITIVE QUESTIONS CAN MAKE A MEASURED NEGATIVE AN INCOMPATIBILITY. The dense CUTLASS
// helper is one backend candidate among several for the linear path and is not on the MoE path at
// all, so its absence is carried as a reading about itself and never turned into a verdict about
// the tuple.
fn question_is_dispositive(q: StaticCompatibilityQuestion) -> Bool {
  match q {
    ArchitectureRegisteredInRuntime => true
    QuantizationModuleFilePresentInRuntime => true
    DenseCutlassFp4HelperSupport => false
    Fp4MoeKernelPathEstablishedOnDevice => true
  }
}

// ESTABLISHED, MEASURED-NEGATIVE AND NOT-ESTABLISHED ARE THREE ANSWERS. A reading that says no is
// evidence against the tuple; a reading that does not exist for this digest is not, and an arm that
// collapsed the two would turn an unprobed image into a refused one -- or, worse, a reported one
// into a probed one. Every NotEstablished arm names the one act that would establish it.
type StaticCompatibilityAnswer
  = Established { question: StaticCompatibilityQuestion, evidence: NonEmptyStr }
  | MeasuredNegative { question: StaticCompatibilityQuestion, evidence: NonEmptyStr }
  | NotEstablished { question: StaticCompatibilityQuestion, missing: NonEmptyStr }

fn answer_question(a: StaticCompatibilityAnswer) -> StaticCompatibilityQuestion {
  match a {
    Established { question: q, evidence: _ } => q
    MeasuredNegative { question: q, evidence: _ } => q
    NotEstablished { question: q, missing: _ } => q
  }
}

fn answer_is_established(a: StaticCompatibilityAnswer) -> Bool {
  match a {
    Established { question: _, evidence: _ } => true
    MeasuredNegative { question: _, evidence: _ } => false
    NotEstablished { question: _, missing: _ } => false
  }
}

fn answer_text(a: StaticCompatibilityAnswer) -> String {
  match a {
    Established { question: q, evidence: e } => join([static_question_label(q: q), ": ESTABLISHED -- ", e as String], "")
    MeasuredNegative { question: q, evidence: e } => join([static_question_label(q: q), ": MEASURED NEGATIVE -- ", e as String], "")
    NotEstablished { question: q, missing: m } => join([static_question_label(q: q), ": NOT ESTABLISHED -- ", m as String], "")
  }
}

// THE ARCHITECTURE QUESTION IS ASKED OF THE OBSERVATION ROSTER, keyed by the runtime row's own pin:
// a dump taken inside that digest answers through registry_reading_contains, an asked row answers
// for its one name, and an image nobody has asked is NotEstablished with the instrument named. This
// is the same roster serving_arm_admits reads through the row's registry_reading; the difference is
// that an asked row -- an image probed for one name only -- can answer here as well as a dump.
fn architecture_answer(rrow: ServingRuntimeRow, architecture: NonEmptyStr) -> StaticCompatibilityAnswer {
  let pin = runtime_artifact_wire(a: rrow.artifact)
  match architecture_asked_answer(observations: spark_architecture_observations, image_reference: pin, architecture: architecture) {
    ArchitectureUnasked => NotEstablished {
      question: ArchitectureRegisteredInRuntime,
      missing: join([
        "no reading inside ", pin as String, " has asked for ", architecture as String,
        "; one execution of the registry instrument inside that digest settles it",
      ], "") as NonEmptyStr,
    }
    ArchitectureConflicting { image_reference: i, architecture: a } => NotEstablished {
      question: ArchitectureRegisteredInRuntime,
      missing: join([
        "the observation roster holds conflicting answers for ", a as String, " inside ", i as String,
        "; re-read the registry inside that digest rather than choose",
      ], "") as NonEmptyStr,
    }
    ArchitectureAnswered { present: p, observed_at: d, host: h } =>
      if p {
        Established {
          question: ArchitectureRegisteredInRuntime,
          evidence: join([architecture as String, " is registered inside ", pin as String, " (", h as String, ", ", d as String, ")"], "") as NonEmptyStr,
        }
      } else {
        MeasuredNegative {
          question: ArchitectureRegisteredInRuntime,
          evidence: join([architecture as String, " is not registered inside ", pin as String, " (", h as String, ", ", d as String, ")"], "") as NonEmptyStr,
        }
      }
  }
}

// ── THE QUANTIZATION-MODULE QUESTION IS ASKED OF THE PROBE ROSTER, BY THE ARM'S OWN PIN ──────
//
// The first revision of this module carried the lane's reading as a report row here, keyed first by
// a tag and then by the content id. The exact-match join on the tag caught that the serving image
// had no runtime row at all (gunbc.spark.serving_arm glm53_derived_row now models it), and once the
// image had a row and a probe roster entry the report was a second home for facts the roster owns.
// So the question is asked the same way the FP4 one is: capability_outcome over the roster, keyed by
// the runtime row's pin, with an ungrounded or unrecorded outcome refusing by name. A rebuilt image
// with a new content id answers OutcomeUnrecorded rather than inheriting.
//
// MODULE PRESENCE IS THE WEAKER CLAIM AND ANSWERS ONLY ITS OWN QUESTION: whether the installed
// package carries the ModelOpt config module a "modelopt" checkpoint dispatches to. The kernel path
// is Fp4WeightSupportedHere below, and nothing lets this answer stand in for that one.
fn quantization_answer(rrow: ServingRuntimeRow, device: GpuComputeCapability, required_method: NonEmptyStr) -> StaticCompatibilityAnswer {
  let pin = runtime_artifact_wire(a: rrow.artifact)
  match capability_outcome(rows: v41_sm121_capability_probe_rows(), image_reference: pin, capability: ModeloptQuantizationModulePresent, device: device) {
    OutcomeUnrecorded => NotEstablished {
      question: QuantizationModuleFilePresentInRuntime,
      missing: join([
        "no ", runtime_kernel_capability_label(c: ModeloptQuantizationModulePresent), " probe row exists for ", pin as String,
        "; a glob of vllm/model_executor/layers/quantization/ inside that digest produces one",
      ], "") as NonEmptyStr,
    }
    OutcomeConflicted { distinct_answers: n } => NotEstablished {
      question: QuantizationModuleFilePresentInRuntime,
      missing: join(["the probe roster holds ", to_string(n), " distinct answers for ", pin as String, "; re-probe rather than choose"], "") as NonEmptyStr,
    }
    OutcomeFound { outcome: o } => match o {
      KernelObservedPresent { symbol: sym } => Established { question: QuantizationModuleFilePresentInRuntime, evidence: join([
        "the ", required_method as String, " quantization module file is present inside ", pin as String, ": ", sym as String,
        " -- file presence only; handler registration, config acceptance and the kernel path are not established by it",
      ], "") as NonEmptyStr }
      KernelObservedAbsent { symbol: sym } => MeasuredNegative { question: QuantizationModuleFilePresentInRuntime, evidence: sym }
      KernelProbeRefused { reason: r } => NotEstablished { question: QuantizationModuleFilePresentInRuntime, missing: r }
      KernelProbeSymbolUngrounded { roster: _, defect: d } => NotEstablished { question: QuantizationModuleFilePresentInRuntime, missing: d }
    }
  }
}

// THE FP4-ON-DEVICE QUESTION IS ASKED OF THE CAPABILITY PROBE ROSTER, keyed by the arm's own digest
// and this fleet's observed compute capability. For the serving image the roster's answer is
// KernelProbeSymbolUngrounded: the probe ran inside it on 2026-09-18 and its discriminator,
// torch.ops._C.cutlass_scaled_mm_supports_fp4, is not in that build's op namespace. So this answers
// NotEstablished with the DEFECT as the missing fact, and the standing below makes that CALIBRATION
// REQUIRED rather than a refusal: an ungrounded symbol is never read as a negative verdict, and the
// absent dense op is not the load-bearing path anyway. At this vLLM revision NVFP4 linear dispatch
// has several backends and NVFP4 MoE has its own multi-backend selector; since only the routed
// experts are NVFP4, the MoE selector for this shape on this device is the discriminator that
// decides, and a bounded load of one NVFP4 expert layer is the smallest smoke that answers it. This
// answer is never the sole thing standing between a tuple and admission: placement is unread too.
fn fp4_device_answer(rrow: ServingRuntimeRow, device: GpuComputeCapability) -> StaticCompatibilityAnswer {
  let pin = runtime_artifact_wire(a: rrow.artifact)
  match capability_outcome(rows: v41_sm121_capability_probe_rows(), image_reference: pin, capability: Fp4WeightSupportedHere, device: device) {
    OutcomeUnrecorded => NotEstablished {
      question: DenseCutlassFp4HelperSupport,
      missing: join([
        "no ", runtime_kernel_capability_label(c: Fp4WeightSupportedHere), " probe row exists for ", pin as String,
      ], "") as NonEmptyStr,
    }
    OutcomeConflicted { distinct_answers: n } => NotEstablished {
      question: DenseCutlassFp4HelperSupport,
      missing: join(["the probe roster holds ", to_string(n), " distinct answers for ", pin as String, "; re-probe rather than choose"], "") as NonEmptyStr,
    }
    OutcomeFound { outcome: o } => match o {
      KernelObservedPresent { symbol: s } => Established { question: DenseCutlassFp4HelperSupport, evidence: s }
      KernelObservedAbsent { symbol: s } => MeasuredNegative { question: DenseCutlassFp4HelperSupport, evidence: s }
      KernelProbeRefused { reason: r } => NotEstablished { question: DenseCutlassFp4HelperSupport, missing: r }
      KernelProbeSymbolUngrounded { roster: _, defect: d } => NotEstablished { question: DenseCutlassFp4HelperSupport, missing: d }
    }
  }
}

// THE MoE KERNEL PATH HAS NO PROBE IN THE ROSTER YET, so it is NotEstablished for every image by
// construction, naming the discriminator that would establish it. This is the load-bearing question
// for this checkpoint -- only the routed experts are NVFP4 -- and no reading about the dense helper
// answers it in either direction.
fn fp4_moe_path_answer(rrow: ServingRuntimeRow) -> StaticCompatibilityAnswer {
  let pin = runtime_artifact_wire(a: rrow.artifact)
  NotEstablished {
    question: Fp4MoeKernelPathEstablishedOnDevice,
    missing: join([
      "no reading inside ", pin as String,
      " has asked the ModelOpt NVFP4 MoE backend selector for this checkpoint's expert shape on a GB10, and no bounded load of one NVFP4 expert layer has run there; either is the discriminator, and the roster carries neither",
    ], "") as NonEmptyStr,
  }
}

fn static_compatibility_answers(crow: ServingCheckpointRow, rrow: ServingRuntimeRow, required_method: NonEmptyStr) -> List<StaticCompatibilityAnswer> {
  [
    architecture_answer(rrow: rrow, architecture: crow.architecture),
    quantization_answer(rrow: rrow, device: gb10_observed_compute_capability, required_method: required_method),
    fp4_device_answer(rrow: rrow, device: gb10_observed_compute_capability),
    fp4_moe_path_answer(rrow: rrow),
  ]
}

// ── THE STATIC FEASIBILITY STANDING, ONE VALUE PER (CHECKPOINT, RUNTIME, TOPOLOGY, UTILISATION) ─
//
// FOUR STANDINGS AND NO ADMITTING ONE, BECAUSE MISSING EVIDENCE IS NOT IMPOSSIBILITY AND AN UNREAD
// PLACEMENT IS NOT A FIT. A missing checkpoint or runtime row is MODELING REQUIRED -- the corpus has
// not described the subject -- which is different again from a refusal. The first revision folded every non-admission into one `ProjectionRefused`,
// which made "the ideal split already exceeds the budget" and "the probe's discriminator is absent
// from the build" the same answer; they are not. And it admitted a tuple whose placement nobody had
// read. So: a structural refusal when the ideal split already exceeds the budget (real placement can
// only add); a measured incompatibility when a reading answered no; otherwise calibration required,
// naming every unread fact -- placement and non-weight memory always among them -- so a reader sees
// which act supplies which. Each arm carries every answer.
type StaticFeasibilityStanding
  = FeasibilityModelingRequired { missing: NonEmptyStr }
  | FeasibilityRefusedStructurally { cause: NonEmptyStr, screen: IdealEvenSplitArtifactScreen?, answers: List<StaticCompatibilityAnswer> }
  | FeasibilityMeasuredIncompatible { cause: NonEmptyStr, screen: IdealEvenSplitArtifactScreen, answers: List<StaticCompatibilityAnswer> }
  | FeasibilityCalibrationRequired { missing: NonEmptyStr, screen: IdealEvenSplitArtifactScreen, answers: List<StaticCompatibilityAnswer> }

type StaticFeasibilityProjection sole_constructor {
  checkpoint: ServingCheckpoint
  runtime: ServingRuntime
  topology: ServingTopology
  standing: StaticFeasibilityStanding
}

data placement_unread_obligation: NonEmptyStr = "runtime placement and non-weight memory are unread: the ideal even split is a lower bound, and residency needs a per-tensor TP/EP placement projection over this checkpoint's component classes (routed experts, shared experts, attention, embeddings and lm_head, dense layers, norms and router gates, scales, the nextn layer) or a model-load memory receipt (extdeps.vllm.memory_profile through gunbc.spark.vllm_memory_receipt) on this runtime and topology; a deployment verdict further needs a qualified rank offer for the topology" as NonEmptyStr

fn screen_refusal_text(p: IdealEvenSplitArtifactScreen) -> String? {
  match p.verdict {
    IdealSplitWithinBudgetPlacementUnread { pre_runtime_artifact_residual: _ } => none
    FullArtifactSplitExceedsUsable { shortfall_per_rank: _, guaranteed_payload_residual: _ } => none
    GuaranteedPayloadSplitExceedsUsable { shortfall_per_rank: s } => Present { value: join([
      "the guaranteed-loaded payload's ideal even split already exceeds the budget: ", to_string(byte_size_count(b: p.ideal_guaranteed_payload_per_rank)), " routed-expert bytes per rank across ",
      to_string(p.ranks), " rank(s) against ", to_string(byte_size_count(b: p.usable_per_rank)),
      " usable bytes per rank (", to_string(byte_size_count(b: p.pool_per_rank)), " pool at ",
      to_string(basis_point_count(bp: p.utilization)), " basis points), short by ",
      to_string(byte_size_count(b: s)), " bytes per rank before any other population or non-weight allocation; real placement can only add",
    ], "") }
  }
}

// THE FULL-ARTIFACT SCREEN FIGURE, WHEN IT EXCEEDS THE BUDGET, IS REPORTED INTO THE CALIBRATION
// TEXT rather than deciding anything: it includes shard headers and populations a serving mode may
// not load, so it is a warning that placement must be read carefully, not a refusal.
fn screen_advisory_text(p: IdealEvenSplitArtifactScreen) -> String? {
  match p.verdict {
    IdealSplitWithinBudgetPlacementUnread { pre_runtime_artifact_residual: _ } => none
    GuaranteedPayloadSplitExceedsUsable { shortfall_per_rank: _ } => none
    FullArtifactSplitExceedsUsable { shortfall_per_rank: s, guaranteed_payload_residual: g } => Present { value: join([
      "the FULL-artifact even split (", to_string(byte_size_count(b: p.ideal_weights_per_rank)), " bytes per rank, headers and the optional nextn population included) exceeds the budget by ",
      to_string(byte_size_count(b: s)), " bytes per rank while the guaranteed payload's split leaves ", to_string(byte_size_count(b: g)),
      " bytes per rank -- non-dispositive: which optional populations this serving mode loads decides it",
    ], "") }
  }
}

fn answer_is_measured_negative(a: StaticCompatibilityAnswer) -> Bool {
  match a {
    Established { question: _, evidence: _ } => false
    MeasuredNegative { question: _, evidence: _ } => true
    NotEstablished { question: _, missing: _ } => false
  }
}

fn answer_is_dispositive_negative(a: StaticCompatibilityAnswer) -> Bool {
  answer_is_measured_negative(a: a) && question_is_dispositive(q: answer_question(a: a))
}

fn answers_text_where(answers: List<StaticCompatibilityAnswer>, f: fn(StaticCompatibilityAnswer) -> Bool) -> String? {
  let hits = filter(answers, a => f(a))
  if length(hits) == 0 {
    none
  } else {
    Present { value: join(map(hits, a => answer_text(a: a)), "; ") }
  }
}

// EVERYTHING UNREAD, IN ONE SENTENCE: the unestablished answers, then the placement obligation that
// is always outstanding while this module is a screen.
fn calibration_text(screen: IdealEvenSplitArtifactScreen, answers: List<StaticCompatibilityAnswer>) -> NonEmptyStr {
  let advisory = match screen_advisory_text(p: screen) {
    Absent => ""
    Present { value: t } => join([t, "; "], "")
  }
  match answers_text_where(answers: answers, f: a => !answer_is_established(a: a)) {
    Absent => join([advisory, placement_unread_obligation as String], "") as NonEmptyStr
    Present { value: t } => join([advisory, t, "; ", placement_unread_obligation as String], "") as NonEmptyStr
  }
}

fn project_static_feasibility(
  checkpoint: ServingCheckpoint,
  runtime: ServingRuntime,
  topology: ServingTopology,
  manifest: HubCheckpointManifest,
  guaranteed_payload: ByteSize,
  utilization: BasisPoint,
  required_method: NonEmptyStr,
) -> StaticFeasibilityProjection {
  let standing = match serving_checkpoint_row(c: checkpoint) {
    Absent => FeasibilityModelingRequired { missing: "no checkpoint row: the checkpoint's architecture and footprint are unmodelled" as NonEmptyStr }
    Present { value: crow } =>
      match serving_runtime_row(r: runtime) {
        Absent => FeasibilityModelingRequired { missing: "no runtime row: the image has no modelled identity to ask about" as NonEmptyStr }
        Present { value: rrow } =>
          match screen_on_gb10(manifest: manifest, guaranteed_payload: guaranteed_payload, topology: topology, utilization: utilization) {
            Absent => FeasibilityRefusedStructurally { cause: "the topology has no ranks, so there is no per-rank figure to screen" as NonEmptyStr, screen: none, answers: [] }
            Present { value: screen } => {
              let answers = static_compatibility_answers(crow: crow, rrow: rrow, required_method: required_method)
              match screen_refusal_text(p: screen) {
                Present { value: t } => FeasibilityRefusedStructurally { cause: t as NonEmptyStr, screen: Present { value: screen }, answers: answers }
                Absent => match answers_text_where(answers: answers, f: a => answer_is_dispositive_negative(a: a)) {
                  Present { value: t } => FeasibilityMeasuredIncompatible { cause: t as NonEmptyStr, screen: screen, answers: answers }
                  Absent => FeasibilityCalibrationRequired { missing: calibration_text(screen: screen, answers: answers), screen: screen, answers: answers }
                }
              }
            }
          }
      }
  }
  StaticFeasibilityProjection { checkpoint: checkpoint, runtime: runtime, topology: topology, standing: standing }
}

// ── THE RadixArk NVFP4 PROJECTIONS ON THE LIVE RUNTIME ───────────────────────────────────────
//
// THE TWO ROWS THE OPERATOR ASKED FOR, and one more that is the comparison baseline. Both NVFP4 rows
// use the runtime Group B serves on (the lane-built derived image, pinned by its config id), the
// live arm's utilisation and the redistribution's manifest; only the rank count differs.
// THE GUARANTEED-LOADED PAYLOAD FOR THIS CHECKPOINT IS ITS ROUTED EXPERTS, derived from the modelled
// expert layout: every serving mode loads them and no placement replicates them, so their even split
// is a lower bound on the largest rank. A shape whose MoE layer count cannot be derived has no such
// bound, and the projection is modeling-required rather than screened on a fabricated zero.
fn radixark_nvfp4_projection(topology: ServingTopology) -> StaticFeasibilityProjection {
  match nvfp4_routed_experts_total_bytes(s: glm_5_3_shape) {
    Absent => StaticFeasibilityProjection {
      checkpoint: Glm53RadixArkNvfp4Modelopt, runtime: GunbcGlm53DerivedGb10, topology: topology,
      standing: FeasibilityModelingRequired { missing: "the base shape yields no MoE layer count, so the guaranteed-loaded payload cannot be derived" as NonEmptyStr },
    }
    Present { value: routed } => project_static_feasibility(
      checkpoint: Glm53RadixArkNvfp4Modelopt,
      runtime: GunbcGlm53DerivedGb10,
      topology: topology,
      manifest: glm_5_3_nvfp4_manifest,
      guaranteed_payload: routed,
      utilization: live_arm_utilization(),
      required_method: glm_5_3_nvfp4_quantization.quant_method,
    )
  }
}

fn radixark_nvfp4_tp4() -> StaticFeasibilityProjection {
  radixark_nvfp4_projection(topology: FourSparkTp4)
}

fn radixark_nvfp4_tp8() -> StaticFeasibilityProjection {
  radixark_nvfp4_projection(topology: EightSparkTp8)
}

// THE SCREEN ALONE, for the two rows and for the arm that is serving today: ideal bytes per rank,
// usable bytes per rank, and the pre-runtime residual. The live arm's row is here so a reader can
// see the same screen applied to a tuple that is known to serve -- as a sanity check on the
// screen's inputs, NOT as a comparison of headroom: the screen says nothing about KV on either side.
fn radixark_nvfp4_screen(topology: ServingTopology) -> IdealEvenSplitArtifactScreen? {
  match nvfp4_routed_experts_total_bytes(s: glm_5_3_shape) {
    Absent => none
    Present { value: routed } => screen_on_gb10(manifest: glm_5_3_nvfp4_manifest, guaranteed_payload: routed, topology: topology, utilization: live_arm_utilization())
  }
}

// THE FLASH ARM HAS NO MODELLED EXPERT LAYOUT HERE, so its guaranteed payload is not derived; the
// screen takes the whole artifact for both figures, which for a sanity check on the pool and
// utilisation inputs is the conservative choice and is stated as such in the readout.
fn glm53_flash_native_live_arm_screen() -> IdealEvenSplitArtifactScreen? {
  screen_on_gb10(manifest: glm_5_3_flash_native_manifest, guaranteed_payload: glm_5_3_flash_native_manifest.safetensors_bytes, topology: FourSparkTp4, utilization: live_arm_utilization())
}

fn pre_runtime_artifact_residual(p: IdealEvenSplitArtifactScreen?) -> ByteSize? {
  match p {
    Absent => none
    Present { value: screen } => match screen.verdict {
      IdealSplitWithinBudgetPlacementUnread { pre_runtime_artifact_residual: r } => Present { value: r }
      FullArtifactSplitExceedsUsable { shortfall_per_rank: _, guaranteed_payload_residual: _ } => none
      GuaranteedPayloadSplitExceedsUsable { shortfall_per_rank: _ } => none
    }
  }
}

// ── HOST-MEMORY EXPERT OFFLOAD HAS NO DISTINCT TIER ON THIS HARDWARE ─────────────────────────
//
// THE OBVIOUS WAY TO FIT A 465 GB MoE ON FEWER NODES IS TO KEEP THE EXPERTS SOMEWHERE LARGER AND
// STREAM THE EIGHT A TOKEN NEEDS. The classic form keeps them in host DRAM behind a bus, which works
// when the accelerator's pool is smaller than the host's. GB10 has no such pair: its memory_kind is
// UnifiedShared -- the host RAM and the GPU pool are the same physical LPDDR5x -- so "offload to
// host" spills into the pool it was meant to relieve. THAT IS ALL THE MEMORY KIND PROVES. It does not
// prove that every expert-offload strategy is impossible: an NVMe-backed tier, a bounded hot-expert
// cache, expert-parallel placement across nodes or a remote tier are different mechanisms, and
// whether any is useful is a delivery-envelope question this module does not model. So the
// structural answer is narrow -- there is no distinct larger local DRAM tier -- and the other
// strategies are UNQUALIFIED, not refused.
//
// THE PER-TOKEN FIGURE IS AN UPPER BOUND, carried as one: the experts one token visits across the
// stack times one expert's on-disk bytes is what an uncached, all-miss tier would read per decoded
// token. A cache that hits lowers it; the bound is what a reader sizes such a cache against.
//
// THE DECISION IS MADE ON THE CATALOG'S MEMORY KIND, NOT ON PROSE. A GPU whose memory is Dram or Hbm
// (a discrete part with a host behind it) is not answered here; this module models no bus.
type ExpertOffloadProjection
  = NoDistinctHostDramTier { device: NonEmptyStr, uncached_expert_bytes_per_token_bound: ByteSize, expert_visits_per_token: Nat }
  | OffloadNotProjected { device: NonEmptyStr, memory_kind: String }
  | OffloadShapeUnprojectable { because: NonEmptyStr }

fn memory_kind_label(k: MemoryKind) -> String {
  match k {
    Dram => "dram"
    Hbm => "hbm"
    UnifiedShared => "unified-shared"
  }
}

fn project_expert_offload(shape: GlmMoeDsaShape, expert_bytes: ByteSize) -> ExpertOffloadProjection {
  let device = nvidia_gb10_gpu_catalog.model
  match glm_5_3_routed_expert_visits_per_token(s: shape) {
    Absent => OffloadShapeUnprojectable { because: "the shape's dense prefix is longer than its stack, so it has no MoE layer count and no expert visits per token" as NonEmptyStr }
    Present { value: visits } =>
      match nvidia_gb10_gpu_catalog.memory.memory_kind {
        UnifiedShared => NoDistinctHostDramTier {
          device: device,
          uncached_expert_bytes_per_token_bound: byte_size(count: visits * byte_size_count(b: expert_bytes)),
          expert_visits_per_token: visits,
        }
        Dram => OffloadNotProjected { device: device, memory_kind: memory_kind_label(k: Dram) }
        Hbm => OffloadNotProjected { device: device, memory_kind: memory_kind_label(k: Hbm) }
      }
  }
}

fn radixark_nvfp4_expert_offload() -> ExpertOffloadProjection {
  project_expert_offload(shape: glm_5_3_shape, expert_bytes: nvfp4_representative_expert_bytes())
}

// ── THE READOUT, ONE TEXT PER STANDING FOR A PERSON ──────────────────────────────────────────
fn screen_text(p: IdealEvenSplitArtifactScreen) -> String {
  join([
    to_string(p.ranks), " rank(s): ideal even split ", to_string(byte_size_count(b: p.ideal_weights_per_rank)), " full-artifact bytes per rank (guaranteed payload ",
    to_string(byte_size_count(b: p.ideal_guaranteed_payload_per_rank)), ") against ",
    to_string(byte_size_count(b: p.usable_per_rank)), " usable bytes per rank at ",
    to_string(basis_point_count(bp: p.utilization)), " basis points of a ",
    to_string(byte_size_count(b: p.pool_per_rank)), "-byte pool (rounded reading) -- ",
    match p.verdict {
      IdealSplitWithinBudgetPlacementUnread { pre_runtime_artifact_residual: r } => join(["within budget with a pre-runtime artifact residual of ", to_string(byte_size_count(b: r)), " bytes per rank; PLACEMENT UNREAD, not a fit, not KV"], "")
      FullArtifactSplitExceedsUsable { shortfall_per_rank: s, guaranteed_payload_residual: g } => join(["the full-artifact split exceeds the budget by ", to_string(byte_size_count(b: s)), " bytes per rank while the guaranteed payload leaves ", to_string(byte_size_count(b: g)), "; NON-DISPOSITIVE, placement unread"], "")
      GuaranteedPayloadSplitExceedsUsable { shortfall_per_rank: s } => join(["the guaranteed payload EXCEEDS the budget by ", to_string(byte_size_count(b: s)), " bytes per rank before any other population"], "")
    },
  ], "")
}

fn optional_screen_text(p: IdealEvenSplitArtifactScreen?) -> String {
  match p {
    Absent => "no per-rank figure: the topology has no ranks"
    Present { value: screen } => screen_text(p: screen)
  }
}

fn projection_text(p: StaticFeasibilityProjection) -> String {
  let head = join([
    serving_checkpoint_wire(c: p.checkpoint) as String, " on ", serving_runtime_wire(r: p.runtime) as String,
    " at ", serving_topology_wire(t: p.topology) as String, ": ",
  ], "")
  match p.standing {
    FeasibilityModelingRequired { missing: m } => join([head, "MODELING REQUIRED: ", m as String], "")
    FeasibilityRefusedStructurally { cause: c, screen: sc, answers: _ } => join([head, "REFUSED STRUCTURALLY: ", c as String, ". ", optional_screen_text(p: sc)], "")
    FeasibilityMeasuredIncompatible { cause: c, screen: sc, answers: _ } => join([head, "MEASURED INCOMPATIBLE: ", c as String, ". ", screen_text(p: sc)], "")
    FeasibilityCalibrationRequired { missing: m, screen: sc, answers: a } => join([
      head, "CALIBRATION REQUIRED -- ", m as String, ". ", screen_text(p: sc), ". Answers: ",
      join(map(a, x => answer_text(a: x)), "; "),
    ], "")
  }
}

fn offload_text(o: ExpertOffloadProjection) -> String {
  match o {
    NoDistinctHostDramTier { device: d, uncached_expert_bytes_per_token_bound: b, expert_visits_per_token: v } => join([
      "host-memory expert offload has NO DISTINCT TIER on ", d as String, " (unified-shared memory); other offload strategies are unqualified here, and an uncached all-miss tier would read at most ",
      to_string(v), " expert visits x one expert = ", to_string(byte_size_count(b: b)), " bytes per token",
    ], "")
    OffloadNotProjected { device: d, memory_kind: k } => join([
      "expert offload NOT PROJECTED on ", d as String, " (", k, "): this module models no host-to-device bus",
    ], "")
    OffloadShapeUnprojectable { because: b } => join(["expert offload UNPROJECTABLE: ", b as String], "")
  }
}

fn radixark_nvfp4_gb10_readout() -> String {
  join([
    projection_text(p: radixark_nvfp4_tp4()),
    projection_text(p: radixark_nvfp4_tp8()),
    join(["the same screen on the serving GLM-5.3-Flash arm, as an input sanity check only (guaranteed payload taken as the whole artifact): ", optional_screen_text(p: glm53_flash_native_live_arm_screen())], ""),
    offload_text(o: radixark_nvfp4_expert_offload()),
  ], "\n")
}

// THE RUN ENTRY. `gunbc run --entry dag/gunbc/spark/serving_fit_projection.dag --function
// radixark_nvfp4_gb10_exit` re-derives every figure above for BOTH rows. The exit is success only
// when neither row is refused structurally, measured incompatible or modeling-required --
// calibration required is the honest standing of a screen and is not a failure -- and the readout
// travels in the reason on failure.
fn standing_is_refusal(p: StaticFeasibilityProjection) -> Bool {
  match p.standing {
    FeasibilityModelingRequired { missing: _ } => true
    FeasibilityRefusedStructurally { cause: _, screen: _, answers: _ } => true
    FeasibilityMeasuredIncompatible { cause: _, screen: _, answers: _ } => true
    FeasibilityCalibrationRequired { missing: _, screen: _, answers: _ } => false
  }
}

fn radixark_nvfp4_gb10_exit() -> ProcessExit {
  let readout = radixark_nvfp4_gb10_readout()
  if standing_is_refusal(p: radixark_nvfp4_tp4()) || standing_is_refusal(p: radixark_nvfp4_tp8()) {
    exit_failure(reason: readout)
  } else {
    ExitSuccess
  }
}
