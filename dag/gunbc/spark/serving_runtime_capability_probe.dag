// ── THE CANDIDATE ROSTER IS THE DENOMINATOR ────────────────────────────────────────────────────
//
// A sweep that returns no admissible image is a claim about the candidates that were CONSIDERED, and
// the reader cannot check it unless the considered set is written down beside the result. So every
// candidate that was looked at appears here, whether or not a probe ran in it, and a candidate that
// was not probed carries the reason it was not. The reason is never "it would not have worked":
// that is the question the probe answers.
type RuntimeCandidateDisposition
  = CandidateProbed { image_reference: NonEmptyStr }
  | CandidateNotProbed { reason: NonEmptyStr }

type RuntimeCandidateRow {
  candidate: NonEmptyStr
  discovered_via: NonEmptyStr
  disposition: RuntimeCandidateDisposition
}

data v41_sm121_runtime_candidates: List<RuntimeCandidateRow> = [
  RuntimeCandidateRow {
    candidate: join([sparkrun_vllm_ds4_gb10_repository as String, ":", sparkrun_vllm_ds4_gb10_tag as String], "") as NonEmptyStr,
    discovered_via: "the image the Spark pair serves from today, pinned in extdeps.docker.images.sparkrun_vllm_ds4_gb10" as NonEmptyStr,
    disposition: CandidateProbed { image_reference: sparkrun_vllm_ds4_gb10_pinned_reference() },
  },
  RuntimeCandidateRow {
    candidate: gitcommit90_glm_53_one_spark_repository,
