// ── READING THE ROWS ───────────────────────────────────────────────────────────────────────────
//
// THE LOOKUP IS KEYED ON THE HARDWARE TOO, because a kernel question has no answer apart from the
// device it was asked on. An earlier revision matched on image and capability alone and took the
// LAST matching row, which is two defects wearing one shape: readings taken at different compute
// capabilities could combine into a single positive verdict, and two disagreeing readings of the
// same subject resolved silently by list order. Every row in this module happens to be sm_121 today,
// so neither would have shown up as a wrong answer -- it would have shown up the first time someone
// appended a GB200 reading, as a verdict that had quietly stopped being about one machine.
//
// AND DISAGREEMENT IS ITS OWN ANSWER. Two rows for one (image, capability, device) that say
// different things are not a value to pick between; they are a receipt set that has lost its
// single-valuedness, and the remedy is to re-probe rather than to choose. `OutcomeConflicted` is
// counted as unprobed by the folds below, never as missing and never as present.
type CapabilityOutcomeLookup
  = OutcomeFound { outcome: KernelProbeOutcome }
  | OutcomeUnrecorded
  | OutcomeConflicted { distinct_answers: Nat }

fn kernel_probe_outcome_label(o: KernelProbeOutcome) -> String {
  match o {
    KernelObservedPresent { symbol: _ } => "present"
    KernelObservedAbsent { symbol: _ } => "absent"
    KernelProbeRefused { reason: _ } => "refused"
    KernelProbeSymbolUngrounded { roster: _, defect: _ } => "symbol-ungrounded"
  }
}

// THE DEVICE KEY INCLUDES THE VENDOR, because a compute-capability number is meaningless without the
// vendor whose numbering scheme it belongs to. GpuComputeCapability carries the vendor precisely so
// that (12, 1) cannot be asked as though it were a universal coordinate: extdeps.gpu.types renders
// NVIDIA's as sm_121 and AMD's as gfx121, two unrelated devices that a major/minor comparison alone
// would have treated as one. Nothing in this module has an AMD row today, which is exactly why the
// omission was invisible and why the control below asks the question anyway.
fn same_device(a: GpuComputeCapability, b: GpuComputeCapability) -> Bool {
  a.vendor == b.vendor && a.major == b.major && a.minor == b.minor
}

fn probe_row_matches(r: RuntimeCapabilityProbeRow, image_reference: NonEmptyStr, capability: RuntimeKernelCapability, device: GpuComputeCapability) -> Bool {
  let same_image = r.image.image_reference as String == image_reference as String
  let same_capability = runtime_kernel_capability_label(c: r.capability) == runtime_kernel_capability_label(c: capability)
  let same_hardware = same_device(a: r.compute_capability, b: device)
  same_image && same_capability && same_hardware
}

fn matching_probe_rows(rows: List<RuntimeCapabilityProbeRow>, image_reference: NonEmptyStr, capability: RuntimeKernelCapability, device: GpuComputeCapability) -> List<RuntimeCapabilityProbeRow> {
  fold(rows, init: [], f: (acc, r) =>
    if probe_row_matches(r: r, image_reference: image_reference, capability: capability, device: device) {
      append(acc, r)
    } else { acc })
}

fn distinct_outcome_labels(rows: List<RuntimeCapabilityProbeRow>) -> List<String> {
  fold(rows, init: [], f: (acc, r) =>
    if any(acc, l => l == kernel_probe_outcome_label(o: r.outcome)) { acc }
    else { append(acc, kernel_probe_outcome_label(o: r.outcome)) })
}

fn capability_outcome(rows: List<RuntimeCapabilityProbeRow>, image_reference: NonEmptyStr, capability: RuntimeKernelCapability, device: GpuComputeCapability) -> CapabilityOutcomeLookup {
  let matched = matching_probe_rows(rows: rows, image_reference: image_reference, capability: capability, device: device)
  let answers = distinct_outcome_labels(rows: matched)
  if length(matched) == 0 {
    OutcomeUnrecorded
  } else if length(answers) != 1 {
    OutcomeConflicted { distinct_answers: length(answers) }
  } else {
    fold(matched, init: OutcomeUnrecorded, f: (acc, r) => OutcomeFound { outcome: r.outcome })
  }
}

// THE CAPABILITIES A RUNTIME MUST CARRY DEPEND ON WHAT YOU INTEND TO RUN, and an earlier revision
// of this module made every capability mandatory for everyone. That overstated the requirement in a specific
// way: DSpark is the speculative-decode path, and an image without it cannot speculate but can serve
// perfectly well without speculating. A requirement list that does not name the profile it belongs
// to converts a deployment CHOICE into a hardware VERDICT, and rules out images that would have
// served the thing actually wanted.
type V41ServingProfile
  = V41SpeculativeDecode
  | V41BaselineDecode

fn v41_serving_profile_label(p: V41ServingProfile) -> String {
  match p {
    V41SpeculativeDecode => "speculative-decode"
    V41BaselineDecode => "baseline-decode"
  }
}

// THE TWO REFINED QUESTIONS ARE REQUIRED BY BOTH PROFILES, AND THAT IS A TIGHTENING. Speculation is
// the only thing these profiles disagree about; the FP4 weight path running on THIS device, and the
// FlashInfer entry points the major-12 KV branch reaches through, are needed to decode at all. An
// image probed before those questions existed now reads UNPROBED for them rather than passing -- which
// is the correct answer to a question nobody put to it, and the reason the verdict keeps unprobed
// apart from missing.
fn v41_required_capabilities(profile: V41ServingProfile) -> List<RuntimeKernelCapability> {
  match profile {
    V41BaselineDecode => [ArchitectureRegistered, Fp4WeightKernels, Fp4WeightSupportedHere, MlaKvCacheLayoutAdmitted, FlashInferSparseMlaSm120Symbols, Csa2CompressorKernels]
    V41SpeculativeDecode => [ArchitectureRegistered, Fp4WeightKernels, Fp4WeightSupportedHere, MlaKvCacheLayoutAdmitted, FlashInferSparseMlaSm120Symbols, Csa2CompressorKernels, DSparkSpeculator]
  }
}

// WHAT A CLEAN SWEEP OF THESE QUESTIONS ESTABLISHES IS INVENTORY, NOT THAT THE ENGINE RUNS. Every
// probe here asks whether a symbol is registered or a module imports. That is a prerequisite check:
// it can rule an image OUT decisively, and it cannot rule one IN. An architecture in the registry
// with kernels on disk still has to load weights, allocate a KV cache at the requested context, and
// answer a request -- none of which this module observes. The positive arm is therefore named for
// what it establishes, and the step that would establish serving is stated beside it rather than
// implied by a friendlier word.
type V41RuntimeVerdict
  = V41RuntimePrerequisitesPresent { image_reference: NonEmptyStr, profile: NonEmptyStr, remaining: NonEmptyStr }
  | V41RuntimeMissing { image_reference: NonEmptyStr, missing: List<NonEmptyStr> }
  | V41RuntimeIncompletelyProbed { image_reference: NonEmptyStr, unprobed: List<NonEmptyStr> }

data v41_prerequisites_are_not_feasibility: NonEmptyStr = "every capability required by this profile reads present in this exact image on this exact compute capability. That is prerequisite inventory: it rules the image IN as a candidate and establishes nothing about serving. Executable feasibility is a separate observation -- the engine started with this checkpoint at a declared context and answered a request -- and it belongs to gunbc.spark.serving_deployment_selection RuntimeFeasibility, whose witness is a launch receipt rather than a symbol lookup" as NonEmptyStr

fn v41_missing_capabilities(rows: List<RuntimeCapabilityProbeRow>, image_reference: NonEmptyStr, device: GpuComputeCapability, profile: V41ServingProfile) -> List<NonEmptyStr> {
  fold(v41_required_capabilities(profile: profile), init: [], f: (acc, c) =>
    match capability_outcome(rows: rows, image_reference: image_reference, capability: c, device: device) {
      OutcomeFound { outcome: o } =>
        match o {
          KernelObservedPresent { symbol: _ } => acc
          KernelObservedAbsent { symbol: _ } => append(acc, runtime_kernel_capability_label(c: c) as NonEmptyStr)
          KernelProbeRefused { reason: _ } => acc
          KernelProbeSymbolUngrounded { roster: _, defect: _ } => acc
        }
      OutcomeUnrecorded => acc
      OutcomeConflicted { distinct_answers: _ } => acc
    })
}

fn v41_unprobed_capabilities(rows: List<RuntimeCapabilityProbeRow>, image_reference: NonEmptyStr, device: GpuComputeCapability, profile: V41ServingProfile) -> List<NonEmptyStr> {
  fold(v41_required_capabilities(profile: profile), init: [], f: (acc, c) =>
    match capability_outcome(rows: rows, image_reference: image_reference, capability: c, device: device) {
      OutcomeUnrecorded => append(acc, runtime_kernel_capability_label(c: c) as NonEmptyStr)
      OutcomeConflicted { distinct_answers: _ } => append(acc, runtime_kernel_capability_label(c: c) as NonEmptyStr)
      OutcomeFound { outcome: o } =>
        match o {
          KernelProbeRefused { reason: _ } => append(acc, runtime_kernel_capability_label(c: c) as NonEmptyStr)
          KernelProbeSymbolUngrounded { roster: _, defect: _ } => append(acc, runtime_kernel_capability_label(c: c) as NonEmptyStr)
          KernelObservedPresent { symbol: _ } => acc
          KernelObservedAbsent { symbol: _ } => acc
        }
    })
}

// MISSING IS REPORTED BEFORE UNPROBED because a measured absence rules the image out whatever else is
// unknown about it, while an incompletely probed image with nothing missing is a question still open.
fn v41_runtime_verdict(rows: List<RuntimeCapabilityProbeRow>, image_reference: NonEmptyStr, device: GpuComputeCapability, profile: V41ServingProfile) -> V41RuntimeVerdict {
  let missing = v41_missing_capabilities(rows: rows, image_reference: image_reference, device: device, profile: profile)
  let unprobed = v41_unprobed_capabilities(rows: rows, image_reference: image_reference, device: device, profile: profile)
  if length(missing) != 0 {
    V41RuntimeMissing { image_reference: image_reference, missing: missing }
  } else if length(unprobed) != 0 {
    V41RuntimeIncompletelyProbed { image_reference: image_reference, unprobed: unprobed }
  } else {
    V41RuntimePrerequisitesPresent {
      image_reference: image_reference,
      profile: v41_serving_profile_label(p: profile) as NonEmptyStr,
      remaining: v41_prerequisites_are_not_feasibility,
    }
  }
}

// THE STANDING OF THE SWEEP AS A WHOLE, so the answer a reader gets is "none of THE CANDIDATES THIS
// ROSTER CARRIES, for this profile, on this device" rather than "none", and the roster that produced
// that denominator is one declaration away. The denominator is named by shape rather than by count on
// purpose: a sentence carrying the number of candidates goes stale the next time one is added, and a
// stale denominator is how a sweep reports a clean result over half its subjects.
fn v41_images_with_prerequisites(rows: List<RuntimeCapabilityProbeRow>, candidates: List<RuntimeCandidateRow>, device: GpuComputeCapability, profile: V41ServingProfile) -> List<NonEmptyStr> {
  fold(candidates, init: [], f: (acc, c) =>
    match c.disposition {
      CandidateNotProbed { reason: _ } => acc
      CandidateProbed { image_reference: ref } =>
        match v41_runtime_verdict(rows: rows, image_reference: ref, device: device, profile: profile) {
          V41RuntimePrerequisitesPresent { image_reference: r, profile: _, remaining: _ } => append(acc, r)
          V41RuntimeMissing { image_reference: _, missing: _ } => acc
          V41RuntimeIncompletelyProbed { image_reference: _, unprobed: _ } => acc
        }
    })
}

// THE SGLANG CANDIDATE ANSWERS THE REGISTRY QUESTION AND REFUSES THE KERNEL ONES, which is the
// distinction the outcome type exists to carry. Its architecture registry is its own and was read
// the same way -- 247 entries, DeepseekV4ForCausalLM and even DeepseekV4ForCausalLMDSpark among
// them, DeepseekV41ForCausalLM not. The kernel probes are asked in vLLM's vocabulary and that
// vocabulary does not exist in this image, so they refuse rather than answer.
//
// AND CAPABILITIES ADDED AFTER THIS RUN ARE NOT AMONG THE REFUSALS. The rows below are the questions
// that were put to this image; a question the vocabulary gained later was never asked of it, and it
// reads UNRECORDED rather than refused -- a refusal is something a run did, and a run cannot have
// refused a question that did not exist when it happened. The lookup keeps the two apart, which is
// why nothing here needs a row saying "not asked".
data dgx_spark_sglang_probe: ProbedRuntimeImage = ProbedRuntimeImage {
  image_reference: xomoxcc_dgx_spark_sglang_registry_reading.image_reference,
  framework: "sglang" as NonEmptyStr,
  framework_version: xomoxcc_dgx_spark_sglang_framework_version,
}

