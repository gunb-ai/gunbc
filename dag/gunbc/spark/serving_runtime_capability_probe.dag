    disposition: CandidateNotProbed { reason: "no such image is published: this is a BUILD obligation rather than a probe target, and it is the only candidate identified so far whose source is known to contain the V4.1 code at all. Nothing here says the build would succeed on sm_121 -- the FlashInfer kernel requirements that branch names are exactly what a probe inside the built image would have to settle" as NonEmptyStr },
  },
]

// ── READING THE ROWS ───────────────────────────────────────────────────────────────────────────
//
// The fold answers for ONE image and ONE capability and returns the outcome the probe recorded, or
// nothing when no probe row exists for that pair. `none` is deliberately not an absence arm of
// KernelProbeOutcome: an unprobed pair is a fact about this roster, while KernelProbeRefused is a
// fact about an attempt that was made and failed, and only the second one says anything about the
// image.
fn probe_row_matches(r: RuntimeCapabilityProbeRow, image_reference: NonEmptyStr, capability: RuntimeKernelCapability) -> Bool {
  let same_image = r.image.image_reference as String == image_reference as String
  let same_capability = runtime_kernel_capability_label(c: r.capability) == runtime_kernel_capability_label(c: capability)
  same_image && same_capability
}

fn capability_outcome(rows: List<RuntimeCapabilityProbeRow>, image_reference: NonEmptyStr, capability: RuntimeKernelCapability) -> KernelProbeOutcome? {
  fold(rows, init: none, f: (acc, r) =>
    if probe_row_matches(r: r, image_reference: image_reference, capability: capability) {
      Present { value: r.outcome }
    } else { acc })
}

// THE CAPABILITIES DEEPSEEK V4.1 REQUIRES OF A RUNTIME, declared as a list so the verdict below is a
// join over it rather than a hand-written conjunction that silently stops checking when a new
// capability is modelled.
data v41_required_capabilities: List<RuntimeKernelCapability> = [
  ArchitectureRegistered,
  Fp4WeightKernels,
  Fp4KvCacheKernels,
  Csa2CompressorKernels,
  DSparkSpeculator,
]

// A VERDICT NAMES WHAT IS MISSING, AND SEPARATES MISSING FROM UNASKED. An image with one unprobed
// required capability is not admissible and is also not refused: it is incompletely probed, and the
// remedy is another probe rather than another image.
type V41RuntimeVerdict
  = V41RuntimeAdmissible { image_reference: NonEmptyStr }
  | V41RuntimeMissing { image_reference: NonEmptyStr, missing: List<NonEmptyStr> }
  | V41RuntimeIncompletelyProbed { image_reference: NonEmptyStr, unprobed: List<NonEmptyStr> }

fn v41_missing_capabilities(rows: List<RuntimeCapabilityProbeRow>, image_reference: NonEmptyStr) -> List<NonEmptyStr> {
  fold(v41_required_capabilities, init: [], f: (acc, c) =>
    match capability_outcome(rows: rows, image_reference: image_reference, capability: c) {
      Present { value: o } =>
        match o {
          KernelObservedPresent { symbol: _ } => acc
          KernelObservedAbsent { symbol: _ } => append(acc, runtime_kernel_capability_label(c: c) as NonEmptyStr)
          KernelProbeRefused { reason: _ } => acc
        }
      Absent => acc
    })
}

fn v41_unprobed_capabilities(rows: List<RuntimeCapabilityProbeRow>, image_reference: NonEmptyStr) -> List<NonEmptyStr> {
  fold(v41_required_capabilities, init: [], f: (acc, c) =>
    match capability_outcome(rows: rows, image_reference: image_reference, capability: c) {
      Absent => append(acc, runtime_kernel_capability_label(c: c) as NonEmptyStr)
      Present { value: o } =>
        match o {
          KernelProbeRefused { reason: _ } => append(acc, runtime_kernel_capability_label(c: c) as NonEmptyStr)
          KernelObservedPresent { symbol: _ } => acc
          KernelObservedAbsent { symbol: _ } => acc
        }
    })
}

// MISSING IS REPORTED BEFORE UNPROBED because a measured absence rules the image out whatever else is
// unknown about it, while an incompletely probed image with nothing missing is a question still open.
fn v41_runtime_verdict(rows: List<RuntimeCapabilityProbeRow>, image_reference: NonEmptyStr) -> V41RuntimeVerdict {
  if length(v41_missing_capabilities(rows: rows, image_reference: image_reference)) != 0 {
    V41RuntimeMissing { image_reference: image_reference, missing: v41_missing_capabilities(rows: rows, image_reference: image_reference) }
  } else if length(v41_unprobed_capabilities(rows: rows, image_reference: image_reference)) != 0 {
    V41RuntimeIncompletelyProbed { image_reference: image_reference, unprobed: v41_unprobed_capabilities(rows: rows, image_reference: image_reference) }
  } else {
    V41RuntimeAdmissible { image_reference: image_reference }
  }
}

// THE STANDING OF THE SWEEP AS A WHOLE, so the answer a reader gets is "none of THESE three" rather
// than "none", and the roster that produced that denominator is one declaration away.
fn v41_admissible_images(rows: List<RuntimeCapabilityProbeRow>, candidates: List<RuntimeCandidateRow>) -> List<NonEmptyStr> {
  fold(candidates, init: [], f: (acc, c) =>
    match c.disposition {
      CandidateNotProbed { reason: _ } => acc
      CandidateProbed { image_reference: ref } =>
        match v41_runtime_verdict(rows: rows, image_reference: ref) {
          V41RuntimeAdmissible { image_reference: r } => append(acc, r)
          V41RuntimeMissing { image_reference: _, missing: _ } => acc
          V41RuntimeIncompletelyProbed { image_reference: _, unprobed: _ } => acc
        }
    })
}

// THE SGLANG CANDIDATE ANSWERS ONE OF THE FIVE QUESTIONS AND REFUSES THE OTHER FOUR, which is the
// distinction the outcome type exists to carry. Its architecture registry is its own and was read
// the same way -- 247 entries, DeepseekV4ForCausalLM and even DeepseekV4ForCausalLMDSpark among
// them, DeepseekV41ForCausalLM not. The remaining four probes are asked in vLLM's vocabulary and
// that vocabulary does not exist in this image, so they refuse rather than answer.
data dgx_spark_sglang_probe: ProbedRuntimeImage = ProbedRuntimeImage {
  image_reference: xomoxcc_dgx_spark_sglang_pinned_reference(),
  framework: "sglang" as NonEmptyStr,
  framework_version: xomoxcc_dgx_spark_sglang_framework_version,
}

data v41_sm121_sglang_probe_rows: List<RuntimeCapabilityProbeRow> = [
  RuntimeCapabilityProbeRow {
    image: dgx_spark_sglang_probe,
    host: "spark-a3ee" as NonEmptyStr,
    compute_capability: gb10_observed_compute_capability,
    probed_at: "2026-09-11" as NonEmptyStr,
    capability: ArchitectureRegistered,
    outcome: architecture_registered_outcome(reading: xomoxcc_dgx_spark_sglang_registry_reading),
  },
  RuntimeCapabilityProbeRow {
    image: dgx_spark_sglang_probe,
    host: "spark-a3ee" as NonEmptyStr,
    compute_capability: gb10_observed_compute_capability,
    probed_at: "2026-09-11" as NonEmptyStr,
    capability: Fp4WeightKernels,
    outcome: KernelProbeRefused { reason: "the four kernel questions are asked by vLLM symbol -- torch operator names registered by vllm._C and modules under vllm.models.deepseek_v4_1 -- and this image is SGLang, which has neither. Reporting them absent would record a category error as evidence against the image. The SGLang symbols that answer the same four questions are not modelled yet; modelling them is what this refusal is asking for" as NonEmptyStr },
  },
  RuntimeCapabilityProbeRow {
    image: dgx_spark_sglang_probe,
    host: "spark-a3ee" as NonEmptyStr,
    compute_capability: gb10_observed_compute_capability,
    probed_at: "2026-09-11" as NonEmptyStr,
    capability: Fp4KvCacheKernels,
    outcome: KernelProbeRefused { reason: "the four kernel questions are asked by vLLM symbol -- torch operator names registered by vllm._C and modules under vllm.models.deepseek_v4_1 -- and this image is SGLang, which has neither. Reporting them absent would record a category error as evidence against the image. The SGLang symbols that answer the same four questions are not modelled yet; modelling them is what this refusal is asking for" as NonEmptyStr },
  },
  RuntimeCapabilityProbeRow {
    image: dgx_spark_sglang_probe,
    host: "spark-a3ee" as NonEmptyStr,
    compute_capability: gb10_observed_compute_capability,
    probed_at: "2026-09-11" as NonEmptyStr,
    capability: Csa2CompressorKernels,
    outcome: KernelProbeRefused { reason: "the four kernel questions are asked by vLLM symbol -- torch operator names registered by vllm._C and modules under vllm.models.deepseek_v4_1 -- and this image is SGLang, which has neither. Reporting them absent would record a category error as evidence against the image. The SGLang symbols that answer the same four questions are not modelled yet; modelling them is what this refusal is asking for" as NonEmptyStr },
  },
  RuntimeCapabilityProbeRow {
    image: dgx_spark_sglang_probe,
    host: "spark-a3ee" as NonEmptyStr,
    compute_capability: gb10_observed_compute_capability,
    probed_at: "2026-09-11" as NonEmptyStr,
    capability: DSparkSpeculator,
    outcome: KernelProbeRefused { reason: "the four kernel questions are asked by vLLM symbol -- torch operator names registered by vllm._C and modules under vllm.models.deepseek_v4_1 -- and this image is SGLang, which has neither. Reporting them absent would record a category error as evidence against the image. The SGLang symbols that answer the same four questions are not modelled yet; modelling them is what this refusal is asking for" as NonEmptyStr },
  },
]

// THE ONE ROSTER EVERY READER SHOULD CONSUME, so no consumer can pick up the vLLM receipts and miss
// the SGLang ones or the other way round.
fn v41_sm121_capability_probe_rows() -> List<RuntimeCapabilityProbeRow> {
  fold(v41_sm121_sglang_probe_rows, init: v41_sm121_vllm_probe_rows, f: (acc, r) => append(acc, r))
}

// ── THE BUILD OBLIGATION THIS SWEEP PRODUCED ───────────────────────────────────────────────────
//
// The sweep's result is not merely "no image works": it is a specification for the image that would.
// Every published candidate was measured against the five capabilities, and the only candidate whose
// SOURCE is known to contain the V4.1 path at all is a GB10 build of vLLM at
// 07b75534651a0dd584c6f3be75d8c62fb8426397. What that build must satisfy is exactly what the probe
// asked, so the obligation is stated in the probe's own symbols rather than in prose about "V4.1
// support" -- a build that satisfies a differently worded requirement has not been measured.
//
// AND THE OBLIGATION IS NOT A PREDICTION. Nothing here says the build succeeds on sm_121: the SM12
// branch in vllm/models/deepseek_v4_1/nvidia/model.py names FlashInfer kernel requirements, and
// whether those compile and load for compute capability 12.1 is decided by running this same probe
// inside the built image. The row below is what to ask it, not what it will answer.
type RuntimeBuildObligation {
  subject: NonEmptyStr
  source_revision: NonEmptyStr
  required: List<RuntimeKernelCapability>
  discharge: NonEmptyStr
}

data v41_sm121_build_obligation: RuntimeBuildObligation = RuntimeBuildObligation {
  subject: "a GB10 (sm_121) container image able to serve DeepSeek V4.1 Flash" as NonEmptyStr,
  source_revision: "vllm-project/vllm 07b75534651a0dd584c6f3be75d8c62fb8426397" as NonEmptyStr,
  required: v41_required_capabilities,
  discharge: "run the same five-capability probe inside the built image's exact digest on a GB10 and append its rows here. The build is discharged only when every required capability reads KernelObservedPresent for that digest at compute capability 12.1 -- a green build log is not a reading, and neither is the presence of vllm/models/deepseek_v4_1 in the source tree" as NonEmptyStr,
}

// WHAT EACH CAPABILITY MEANS IS THE SYMBOL THE PROBE ASKED FOR, carried beside the obligation so the
// lane that takes the build does not have to reconstruct the questions from the rows.
fn v41_capability_probe_symbol(c: RuntimeKernelCapability) -> NonEmptyStr {
  match c {
    ArchitectureRegistered => v41_probe_registry_symbol
    Fp4WeightKernels => "torch.ops.* : cutlass_scaled_fp4_mm and cutlass_scaled_mm_supports_fp4. scaled_fp4_quant alone is the quantiser, not the FP4 GEMM, and every image probed so far had exactly that partial surface" as NonEmptyStr
    Fp4KvCacheKernels => "torch.ops.* : nvfp4_ds_mla_cache, concat_and_cache_ds_mla_nvfp4, indexer_k_quant_and_cache_fp4; and the module vllm.models.deepseek_v4_1.common.ops.fused_compress_quant_cache, which is what the indexer K cache is written through when the indexer is MXFP4" as NonEmptyStr
    Csa2CompressorKernels => "the modules vllm.models.deepseek_v4_1.compressor and vllm.models.deepseek_v4_1.sparse_mla -- the compressed sparse attention path, whose compressor pools compress_ratio tokens into one KV latent" as NonEmptyStr
    DSparkSpeculator => "the modules vllm.models.deepseek_v4_1.nvidia.dspark and vllm.v1.worker.gpu.spec_decode.dspark" as NonEmptyStr
  }
}
