    image: v41_published_arm64_probe,
    host: "srv9" as NonEmptyStr,
    compute_capability: gb10_observed_compute_capability,
    probed_at: "2026-09-11T20:41:03Z" as NonEmptyStr,
    capability: Fp4WeightKernels,
