// THE ONE ROSTER EVERY READER SHOULD CONSUME, so no consumer can pick up the vLLM receipts and miss
// the SGLang ones, the source-built one, or any other -- a sweep whose denominator splits is a sweep
// that can report a clean result over half its subjects.
fn v41_sm121_capability_probe_rows() -> List<RuntimeCapabilityProbeRow> {
  fold(
    concat(concat(v41_sm121_sglang_probe_rows, v41_sm121_source_build_probe_rows), v41_sm121_published_image_probe_rows),
    init: v41_sm121_vllm_probe_rows,
    f: (acc, r) => append(acc, r),
  )
}

// ── THE BUILD OBLIGATION THIS SWEEP PRODUCED ───────────────────────────────────────────────────
//
// The sweep's result is not merely "no image works": it is a specification for the image that would.
// Every published candidate was measured against the capabilities this profile requires, and the only candidate whose
// SOURCE is known to contain the V4.1 path at all is a GB10 build of vLLM at
// 07b75534651a0dd584c6f3be75d8c62fb8426397. What that build must satisfy is exactly what the probe
// asked, so the obligation is stated in the probe's own symbols rather than in prose about "V4.1
// support" -- a build that satisfies a differently worded requirement has not been measured.
//
// AND THE OBLIGATION IS NOT A PREDICTION. Nothing here says the build succeeds on sm_121: the SM12
// branch in vllm/models/deepseek_v4_1/nvidia/model.py names FlashInfer kernel requirements, and
// whether those compile and load for compute capability 12.1 is decided by running this same probe
// inside the built image. The row below is what to ask it, not what it will answer.
type RuntimeBuildObligation {
  subject: NonEmptyStr
  source_revision: NonEmptyStr
  profile: V41ServingProfile
  device: GpuComputeCapability
  required: List<RuntimeKernelCapability>
  discharge: NonEmptyStr
}

data v41_sm121_build_obligation: RuntimeBuildObligation = RuntimeBuildObligation {
  subject: "a GB10 (sm_121) container image carrying the prerequisites DeepSeek V4.1 Flash needs, under the speculative-decode profile -- which is a narrower claim than `able to serve`, because nothing in this module observes an engine serving anything" as NonEmptyStr,
  source_revision: "vllm-project/vllm 07b75534651a0dd584c6f3be75d8c62fb8426397" as NonEmptyStr,
  profile: V41SpeculativeDecode,
  device: gb10_observed_compute_capability,
  required: v41_required_capabilities(profile: V41SpeculativeDecode),
  discharge: "run the same capability probe inside the built image's exact digest on a GB10 and append its rows here. The build's PREREQUISITE half is discharged only when every capability this profile requires reads KernelObservedPresent for that digest at compute capability 12.1 -- a green build log is not a reading, and neither is the presence of vllm/models/deepseek_v4_1 in the source tree. That half is inventory; the build is FIT for service only once an engine has started from this image with the V4.1 checkpoint at a declared context and answered a request, which is a RuntimeFeasibility receipt in gunbc.spark.serving_deployment_selection and is not observed here. THIS OBLIGATION IS NOT DISCHARGED, AND FOR TWO REASONS RATHER THAN ONE. extdeps.vllm.deepseek_v4_1_sm12 has landed, so the KV question is asked as the layout the backend admits rather than by ungrounded operator names, and the image built from that revision answered PRESENT to every kernel question that was PUT to it. The registry question came back ABSENT: the architecture this profile needs is not registered in it, and a build carrying the kernels and not the entry point is ruled out by the same list that would have ruled it in. The FP4 runtime predicate is the second reason and it is a different kind of gap -- the run FOUND cutlass_scaled_mm_supports_fp4 and never CALLED it, so that capability stands at KernelProbeRefused and its answer for this device is unknown. Discharge needs both settled: re-probe for the predicate, and an image whose registry answers for the architecture. Reading the absence as the only thing outstanding would leave a required capability unasked behind a discharge that named a different defect" as NonEmptyStr,
}

// WHAT EACH CAPABILITY MEANS IS THE SYMBOL THE PROBE ASKED FOR, carried beside the obligation so the
// lane that takes the build does not have to reconstruct the questions from the rows -- and carried
// as a TYPE rather than a string, because a capability can arrive before the upstream roster that
// names what to look for. A plain string field would force either a corrected spelling of our own or
// an empty value that reads as "no symbol needed"; neither is true of a question whose vocabulary is
// still being read from upstream.
//
// NO CAPABILITY IS IN THAT STATE TODAY, AND THE VARIANT STAYS. The one that was --
// MlaKvCacheLayoutAdmitted, while extdeps.vllm.deepseek_v4_1_sm12 was unlanded -- is grounded in that
// roster's own value now that it is on the tree. The frontier arm is not scaffolding that has served
// its purpose: it is what a capability added ahead of its roster must land as, and deleting it would
// make the next one land as a spelling instead.
type CapabilityProbeSymbol
  = ProbeSymbolGrounded { symbol: NonEmptyStr }
  | ProbeSymbolAwaitingRoster { roster: NonEmptyStr, trigger: NonEmptyStr }

fn v41_capability_probe_symbol(c: RuntimeKernelCapability) -> CapabilityProbeSymbol {
  match c {
    ArchitectureRegistered => ProbeSymbolGrounded { symbol: v41_probe_registry_symbol }
    Fp4WeightKernels => ProbeSymbolGrounded { symbol: "torch.ops.* : cutlass_scaled_fp4_mm and cutlass_scaled_mm_supports_fp4, both registered at the pinned upstream revision. scaled_fp4_quant alone is the quantiser, not the FP4 GEMM, and every image probed so far had exactly that partial surface" as NonEmptyStr }
    Fp4WeightSupportedHere => ProbeSymbolGrounded { symbol: "torch.ops._C.cutlass_scaled_mm_supports_fp4, CALLED with the compute capability the interpreter itself reported inside the image, and its return value read as the answer. The symbol's presence is the Fp4WeightKernels question; this one is what the runtime says about this device" as NonEmptyStr }
    MlaKvCacheLayoutAdmitted => ProbeSymbolGrounded { symbol: join(["the layout ", v41_sm12_kv_layout as String, ", as extdeps.vllm.deepseek_v4_1_sm12 reads it out of the pinned revision, asked of the backend itself: supports_combination is CALLED once per candidate dtype at the device capability the image reports, and returns none for an admitted combination. No operator name is looked up, because the operators that exist are present in any image with the compiled extension and decide nothing here"], "") as NonEmptyStr }
    FlashInferSparseMlaSm120Symbols => ProbeSymbolGrounded { symbol: join(["the FlashInfer sparse MLA SM120 decode entry points extdeps.vllm.deepseek_v4_1_sm12 v41_sm12_demand_symbols declares, each imported inside the image. They are what ", v41_sm12_attention_class as String, " requires on the major-12 arm, and they are asked separately from the layout so a missing package does not read as a rejected layout. The SCOPED question -- has_flashinfer_sparse_mla_sm120_config, which asks whether the dispatch table carries a specialization for this checkpoint's head count and top-k -- is not this capability, and upstream's own docstring says the unscoped one can pass where the scoped one refuses"], "") as NonEmptyStr }
    Csa2CompressorKernels => ProbeSymbolGrounded { symbol: "the modules vllm.models.deepseek_v4_1.compressor and vllm.models.deepseek_v4_1.sparse_mla -- the compressed sparse attention path, whose compressor pools compress_ratio tokens into one KV latent. Both paths exist in the upstream tree at the pinned revision" as NonEmptyStr }
    DSparkSpeculator => ProbeSymbolGrounded { symbol: "the modules vllm.models.deepseek_v4_1.nvidia.dspark and vllm.v1.worker.gpu.spec_decode.dspark, both present in the upstream tree at the pinned revision" as NonEmptyStr }
  }
}
