    capability: MlaKvCacheLayoutAdmitted,
    outcome: KernelProbeRefused { reason: "the kernel questions are asked by vLLM symbol -- torch operator names registered by vllm._C and modules under vllm.models.deepseek_v4_1 -- and this image is SGLang, which has neither. Reporting them absent would record a category error as evidence against the image. The SGLang symbols that answer the same questions are not modelled yet; modelling them is what this refusal is asking for" as NonEmptyStr },
  },
  RuntimeCapabilityProbeRow {
    image: dgx_spark_sglang_probe,
    host: "spark-a3ee" as NonEmptyStr,
    compute_capability: gb10_observed_compute_capability,
    probed_at: "2026-09-11" as NonEmptyStr,
    capability: Csa2CompressorKernels,
    outcome: KernelProbeRefused { reason: "the kernel questions are asked by vLLM symbol -- torch operator names registered by vllm._C and modules under vllm.models.deepseek_v4_1 -- and this image is SGLang, which has neither. Reporting them absent would record a category error as evidence against the image. The SGLang symbols that answer the same questions are not modelled yet; modelling them is what this refusal is asking for" as NonEmptyStr },
  },
  RuntimeCapabilityProbeRow {
    image: dgx_spark_sglang_probe,
    host: "spark-a3ee" as NonEmptyStr,
